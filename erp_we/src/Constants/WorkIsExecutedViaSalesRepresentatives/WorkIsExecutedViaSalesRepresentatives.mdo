  <name>WorkIsExecutedViaSalesRepresentatives</name>
  <synonym>
    <key>en</key>
    <value>Work is executed via sales representatives</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>کار از طریق نمایندگان فروش انجام می‌شود</value>
  </synonym>
