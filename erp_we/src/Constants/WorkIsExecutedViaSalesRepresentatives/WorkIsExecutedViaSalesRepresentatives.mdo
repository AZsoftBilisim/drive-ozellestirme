    <value>Il lavoro è in corso attraverso rappresentanti di vendita</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Jest prowadzona praca poprzez przedstawicieli handlowych</value>
  </synonym>
  <synonym>
