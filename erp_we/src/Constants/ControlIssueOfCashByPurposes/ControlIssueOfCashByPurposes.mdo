  </synonym>
  <synonym>
    <key>fa</key>
    <value>کنترل پرداخت وجه نقد بر اساس اهداف</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Monitorare l'emissione di un rapporto in termini degli obiettivi</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Kontroluj wydawanie pod raport w kontekście celów</value>
  </synonym>
  <synonym>
    <key>ru</key>
