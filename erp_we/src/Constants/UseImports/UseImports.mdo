<?xml version="1.0" encoding="UTF-8"?>
<mdclass:Constant xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="6948dbb8-ab93-4fa1-9eac-5d7cab36adc1">
  <producedTypes>
    <managerType typeId="5b96b54f-a15e-4d9f-846c-a4b9fde5e87a" valueTypeId="56a91e54-c39c-45d8-b7d8-73392b7e698c"/>
    <valueManagerType typeId="eeff6a7c-285c-4a64-a83c-39ce52faaf6c" valueTypeId="f4626084-6cea-4336-bcdc-4b5cc3adf054"/>
    <valueKeyType typeId="7ee4060c-df14-5d78-b084-61f7a9209f83" valueTypeId="3aaa4c3e-2c27-5f7c-b962-6a0fcf25861f"/>
