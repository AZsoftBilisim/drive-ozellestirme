<mdclass:Constant xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="1785ad43-28e9-4a9b-b255-176dc8e97aff">
  <producedTypes>
    <managerType typeId="676b4538-1574-4211-ae4b-6177d61a4694" valueTypeId="ffd6fceb-b9c7-4d6f-ba03-f81f0a246a11"/>
    <valueManagerType typeId="d9a46427-3abd-4bcb-8481-535efcfd211e" valueTypeId="11fc41fd-b55a-4794-ab08-c1eb67dfe07d"/>
    <valueKeyType typeId="412eaf8e-fa7c-5fbd-b1d1-57f973c82c11" valueTypeId="7a9a053a-3d83-5d2e-94f8-a16ff68faa6e"/>
