  <producedTypes>
    <managerType typeId="17cdbc0e-c084-45b7-81f3-65c82c4cb496" valueTypeId="d0fe6054-e896-441d-9a88-5487caa07fda"/>
    <valueManagerType typeId="3ef7aa5d-0f24-4bc2-a84e-d03e0ea08fdf" valueTypeId="1451714d-dbec-471b-9f48-2ae0f8a766b0"/>
    <valueKeyType typeId="297a7f7b-f1fe-561b-bd5d-0e61332e02b8" valueTypeId="459c5a1e-aa36-5a40-b720-90ce591b30f9"/>
