<mdclass:Constant xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="6fca5bf8-639f-4967-816e-83e2568f76c0">
  <producedTypes>
    <managerType typeId="3aae539e-c45e-4d73-b711-2166f73477bf" valueTypeId="6502a344-e5e5-49fd-b3c5-5e37ecda60de"/>
    <valueManagerType typeId="311a3100-97cc-4c01-b014-1a4863811341" valueTypeId="d1f66e5b-2272-4077-a8a4-d23b57da561f"/>
    <valueKeyType typeId="0a99c0c7-39ec-5214-b36b-45b1b2d6f7e0" valueTypeId="998f5030-46dc-5df0-a1ac-1c97a8401d27"/>
