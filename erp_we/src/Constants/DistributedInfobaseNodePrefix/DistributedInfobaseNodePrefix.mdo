  <name>DistributedInfobaseNodePrefix</name>
  <synonym>
    <key>en</key>
    <value>Infobase prefix</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>پیشوند پایگاه اطلاعات</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Prefisso base informativa</value>
  </synonym>
  <synonym>
