  <producedTypes>
    <managerType typeId="58e5fed7-0770-462c-8828-80ccfb29aafb" valueTypeId="ec6b05f7-bb05-46fe-b545-e50ec6e6e567"/>
    <valueManagerType typeId="128d05fa-21ee-4b98-be97-05b7917bfed8" valueTypeId="8142d8b3-0ee8-4b4c-a3bc-38ee33f6b840"/>
    <valueKeyType typeId="bca9a723-fb18-5b9a-9bb6-9011ebe35623" valueTypeId="6534aff8-fd43-511c-820c-9f8c2190830a"/>
