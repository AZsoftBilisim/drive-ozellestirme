  <name>UseApprovalOfRequestsForReturnOfGoodsFromCustomers</name>
  <synonym>
    <key>en</key>
    <value>Use approval of sales return requests</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>استفاده از تأیید درخواست‌های برگشت از فروش</value>
  </synonym>
