    <value>Utilizzare il concordamento delle richieste di reso merci dai clienti</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Używaj uzgodnienia wniosków na zwrot towarów od klientów</value>
  </synonym>
