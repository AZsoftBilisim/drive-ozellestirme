  <producedTypes>
    <managerType typeId="fce5e0a5-17b2-4f13-a98d-03aba08177fc" valueTypeId="fc31e652-e78b-43f5-8237-bba9e50ca248"/>
    <valueManagerType typeId="a9eed163-d67b-4493-b7c4-23e6cd259426" valueTypeId="de99e160-2f9f-4900-b90c-5d17b59a23ca"/>
    <valueKeyType typeId="48ae1bbc-504a-5637-8192-8c40009532dd" valueTypeId="5ef16e78-7096-5b87-9fd0-8a3a7c23cf2a"/>
