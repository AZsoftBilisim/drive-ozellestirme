  <name>UseNonConformanceCertificatesFollowingAcceptance</name>
  <synonym>
    <key>en</key>
    <value>Use discrepancy reports following receipts of goods from vendor</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>استفاده از گزارش‌های مغایرت پس از رسید کالا از تأمین‌کننده</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Utilizzare protocolli di differenze dopo le ricezione delle merci dal fornitore</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Używaj protokołów o odchyleniu po wpływach towarów od dostawcy</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Использовать акты расхождений после поступлений товаров от поставщика</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Tedarikçiden ürünleri aldıktan sonra tutarsızlık raporlarını kullan</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Sử dụng biên bản chênh lệch sau khi tiếp nhận hàng hóa từ nhà cung cấp</value>
  </synonym>
  <type>
    <types>Boolean</types>
  </type>
  <useStandardCommands>true</useStandardCommands>
  <toolTip>
