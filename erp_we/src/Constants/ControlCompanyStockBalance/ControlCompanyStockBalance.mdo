  <name>ControlCompanyStockBalance</name>
  <synonym>
    <key>en</key>
    <value>Control company stock balance</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>کنترل مانده موجودی شرکت</value>
  </synonym>
  <synonym>
