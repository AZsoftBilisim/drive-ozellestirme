<?xml version="1.0" encoding="UTF-8"?>
<mdclass:Constant xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="b8972df2-7d58-4338-bfe3-ca4a7fe13f68">
  <producedTypes>
    <managerType typeId="de4fe2df-c52a-4874-9edf-6cda21db5dec" valueTypeId="830de1d0-8f0f-4a06-89ed-92af9e23a800"/>
    <valueManagerType typeId="808b2968-5bf9-4bee-ad50-d01aad0648b8" valueTypeId="47980bdf-3fa3-4ad5-906b-8e80400395cc"/>
    <valueKeyType typeId="1365329e-6846-5176-8bfc-c6f2f3e90f08" valueTypeId="0ab98372-cf1f-5021-8ba2-4910e7584388"/>
