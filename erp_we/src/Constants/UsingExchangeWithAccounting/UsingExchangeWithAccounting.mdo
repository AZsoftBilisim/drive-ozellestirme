  <name>UsingExchangeWithAccounting</name>
  <synonym>
    <key>en</key>
    <value>Exchange with 1C:Enterprise Accounting is used</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>تبادل با 1C:Enterprise Accounting استفاده می‌شود</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Viene utilizzato lo scambio con la contabilità di impresa</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Jest używana wymiana danych z księgowością przedsiębiorstwa</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Используется обмен с бухгалтерией предприятия</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>İşletmenin muhasebe alt bölümü ile değişim kullanılmaktadır</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Sử dụng trao đổi với kế toán doanh nghiệp</value>
  </synonym>
