  <name>LimitAccessAtRecordLevel</name>
  <synonym>
    <key>en</key>
    <value>Restrict access at record level</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>محدودسازی دسترسی در سطح رکورد</value>
  </synonym>
