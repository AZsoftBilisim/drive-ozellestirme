  <name>UsePaymentRequests</name>
  <synonym>
    <key>en</key>
    <value>Use payment requests</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>استفاده از درخواست‌های پرداخت</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Usare le richieste di spesa</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Używaj wniosków o wydatkowanie środków pieniężnych</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Использовать заявки на расходование денежных средств</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Ödeme taleplerini kullan</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Sử dụng giấy đề nghị chi tiền</value>
  </synonym>
