<mdclass:Constant xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="c936e5e2-2452-48ad-a2a9-8312c6b10839">
  <producedTypes>
    <managerType typeId="bd0d3d82-dc1a-4958-b53f-cf2f713e3722" valueTypeId="4f4183c6-fc5d-4a58-a089-0df4a2a52c1a"/>
    <valueManagerType typeId="14d23f75-f5ea-46da-a118-a9f4bcfe0a85" valueTypeId="8f810b6f-bf86-4f98-93ff-b7d98d83dd0e"/>
    <valueKeyType typeId="0ef2f7c4-db92-42b7-9b6a-b700cec60429" valueTypeId="dc295bc2-278b-494c-abf1-1444d94765ff"/>
