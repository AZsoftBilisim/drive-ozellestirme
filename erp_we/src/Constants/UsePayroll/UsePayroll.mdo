<mdclass:Constant xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="73094e4f-c91e-4c8a-b697-408beb051352">
  <producedTypes>
    <managerType typeId="d6169955-881b-4831-8e86-22e2c19991fb" valueTypeId="4f16f159-489b-4cd3-a106-1576ba3a63ff"/>
    <valueManagerType typeId="ca21691b-e944-49d8-8a3d-39eae8cc54cd" valueTypeId="50d5b442-3239-42f7-907f-b1fdd5a95dd4"/>
    <valueKeyType typeId="97687207-96c0-51c4-8ae6-09d64d4a10cf" valueTypeId="73760787-dfa6-57b2-a6d4-4cac3e9d8581"/>
