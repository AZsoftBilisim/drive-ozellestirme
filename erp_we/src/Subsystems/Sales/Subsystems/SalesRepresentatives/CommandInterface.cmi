    <visibilityFragments>
      <command>Document.JobForSalesRepresentative.Command.JobPreparation</command>
      <visible>
        <common>true</common>
        <for>
          <value>true</value>
          <role>Role.FullAccess</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.AddEditJobsToSalesRepresentatives</role>
        </for>
      </visible>
    </visibilityFragments>
    <visibilityFragments>
      <command>Document.JobForSalesRepresentative.Command.JobsList</command>
      <visible>
        <common>true</common>
        <for>
          <value>true</value>
          <role>Role.AddEditJobsToSalesRepresentatives</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.FullAccess</role>
        </for>
      </visible>
    </visibilityFragments>
  </commandsVisibility>
  <commandsOrder>
    <orderFragments>
      <group>ActionsPanelReports</group>
      <commands>Report.AnalysisOfSalesRepresentativePerformance.StandardCommand.Open</commands>
      <commands>Report.TrendsOfSalesRepresentativePerformanceIndicators.StandardCommand.Open</commands>
