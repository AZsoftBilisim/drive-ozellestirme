  <name>SalesRepresentatives</name>
  <synonym>
    <key>en</key>
    <value>Sales representatives</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>نمایندگان فروش</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Rappresentanti commerciali</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Przedstawiciele handlowi</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Торговые представители</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Satış temsilcileri</value>
  </synonym>
  <synonym>
