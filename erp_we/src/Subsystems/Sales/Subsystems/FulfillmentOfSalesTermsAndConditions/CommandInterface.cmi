<?xml version="1.0" encoding="UTF-8"?>
<cmi:CommandInterface xmlns:cmi="http://g5.1c.ru/v8/dt/cmi">
  <commandsVisibility>
    <visibilityFragments>
      <command>Catalog.TermsOfSale.Command.StandardTermsOfSalesList</command>
      <visible>
        <for>
          <value>true</value>
          <role>Role.AddEditStandardTermsOfSalesWithCustomers</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.AddEditCustomerTermsOfSales</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.FullAccess</role>
        </for>
      </visible>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.PaymentSchedules.StandardCommand.OpenList</command>
      <visible>
        <for>
          <value>true</value>
          <role>Role.AddEditPaymentRules</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.FullAccess</role>
        </for>
      </visible>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.TermsOfSale.Command.CustomerTermsOfSalesList</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.TermsOfSale.Command.CreateNewCustomerTermsOfSales</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Report.FulfillmentOfRegularConditionsOfTermsOfSales.StandardCommand.Open</command>
      <visible/>
    </visibilityFragments>
  </commandsVisibility>
  <commandsPlacement>
    <placementFragments>
      <group>NavigationPanelImportant</group>
      <commands>Catalog.TermsOfSale.Command.StandardTermsOfSalesList</commands>
    </placementFragments>
  </commandsPlacement>
  <commandsOrder>
    <orderFragments>
      <group>NavigationPanelImportant</group>
      <commands>Catalog.TermsOfSale.Command.StandardTermsOfSalesList</commands>
    </orderFragments>
    <orderFragments>
      <group>NavigationPanelOrdinary</group>
      <commands>Catalog.PaymentSchedules.StandardCommand.OpenList</commands>
      <commands>Catalog.TermsOfSale.Command.CustomerTermsOfSalesList</commands>
    </orderFragments>
    <orderFragments>
      <group>ActionsPanelCreate</group>
      <commands>Catalog.TermsOfSale.Command.CreateStandardTermsOfSales</commands>
      <commands>Catalog.PaymentSchedules.StandardCommand.Create</commands>
      <commands>Catalog.TermsOfSale.Command.CreateNewCustomerTermsOfSales</commands>
