  <name>MarketingActivitiesAndProjects</name>
  <synonym>
    <key>en</key>
    <value>Marketing activities and projects</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>فعالیت‌ها و پروژه‌های بازاریابی</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Eventi di marketing e progetti</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Przedsięwzięcia marketingowe i projekty</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Маркетинговые мероприятия и проекты</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Pazarlama faaliyetleri ve projeler</value>
  </synonym>
