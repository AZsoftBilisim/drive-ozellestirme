<?xml version="1.0" encoding="UTF-8"?>
<cmi:CommandInterface xmlns:cmi="http://g5.1c.ru/v8/dt/cmi">
  <commandsVisibility>
    <visibilityFragments>
      <command>Catalog.Partners.Command.Counterparties</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.Partners.Command.Partners</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.Partners.Command.Vendors</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.Partners.Command.Competitors</command>
      <visible>
        <common>true</common>
        <for>
          <value>true</value>
          <role>Role.AddEditInformationAboutPartners</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.FullAccess</role>
        </for>
        <for>
          <value>true</value>
          <role>Role.ReadInformationAboutPartners</role>
        </for>
      </visible>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.Partners.Command.Customers</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>DataProcessor.VendorPriceLists.Command.VendorsPriceLists</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Catalog.Partners.Command.NewItem</command>
      <visible/>
    </visibilityFragments>
  </commandsVisibility>
  <commandsPlacement>
    <placementFragments>
      <group>NavigationPanelImportant</group>
      <commands>Catalog.Partners.Command.Competitors</commands>
    </placementFragments>
  </commandsPlacement>
  <commandsOrder>
    <orderFragments>
      <group>NavigationPanelImportant</group>
      <commands>Catalog.Partners.Command.Counterparties</commands>
      <commands>Catalog.Partners.Command.Partners</commands>
      <commands>Catalog.Partners.Command.Vendors</commands>
      <commands>Catalog.Partners.Command.Competitors</commands>
    </orderFragments>
    <orderFragments>
      <group>NavigationPanelOrdinary</group>
      <commands>Catalog.Partners.Command.Customers</commands>
      <commands>DataProcessor.VendorPriceLists.Command.CompetitorPricesPriceLists</commands>
      <commands>DataProcessor.VendorPriceLists.Command.VendorsPriceLists</commands>
    </orderFragments>
  </commandsOrder>
</cmi:CommandInterface>
