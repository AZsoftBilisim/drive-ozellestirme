<?xml version="1.0" encoding="UTF-8"?>
<cmi:CommandInterface xmlns:cmi="http://g5.1c.ru/v8/dt/cmi">
  <commandsVisibility>
    <visibilityFragments>
      <command>Constant.LocalInfobasePublishingURL.StandardCommand.Open</command>
      <visible/>
    </visibilityFragments>
    <visibilityFragments>
      <command>Report.BudgetingProcessmonitor.StandardCommand.Open</command>
      <visible>
        <for>
          <value>true</value>
          <role>Role.SystemAdministrator</role>
        </for>
      </visible>
    </visibilityFragments>
    <visibilityFragments>
      <command>DataProcessor.BudgetingModelExportImportWizard.Command.BudgetingModelExportWizard</command>
      <visible>
        <for>
          <role>Role.SystemAdministrator</role>
        </for>
      </visible>
    </visibilityFragments>
    <visibilityFragments>
      <command>DataProcessor.BudgetingModelExportImportWizard.Command.BudgetingModelImportWizard</command>
      <visible>
        <for>
          <role>Role.SystemAdministrator</role>
        </for>
      </visible>
    </visibilityFragments>
  </commandsVisibility>
  <commandsOrder>
    <orderFragments>
      <group>NavigationPanelOrdinary</group>
      <commands>Report.BudgetingProcessmonitor.Command.BudgetingProcessmonitor</commands>
      <commands>Document.BudgetingProcess.StandardCommand.OpenList</commands>
      <commands>Task.BudgetTask.Command.MyBudgetTasks</commands>
      <commands>DataProcessor.BudgetingModelExportImportWizard.Command.BudgetingModelExportWizard</commands>
      <commands>DataProcessor.BudgetingModelExportImportWizard.Command.BudgetingModelImportWizard</commands>
    </orderFragments>
  </commandsOrder>
</cmi:CommandInterface>
