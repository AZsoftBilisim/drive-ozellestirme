		<Condition id="111" uuid="67f1232f-bfb0-4215-82c7-d673784fece2">
			<Properties>
				<Name>ThereIsADeviationFromLogisticCondition</Name>
				<Title>
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Is there any deviation from the logistic conditions?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>آیا انحرافی از شرایط لجستیکی وجود دارد؟</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>C'è una variazione dalle condizioni logistiche?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Czy jest odchylenie od warunków logistycznych?</v8:content>
