				<Name>ThereIsADeviationFromPriceCondition</Name>
				<Title>
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Is there any deviation from the price conditions?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>آیا انحرافی از شرایط قیمتی وجود دارد؟</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
