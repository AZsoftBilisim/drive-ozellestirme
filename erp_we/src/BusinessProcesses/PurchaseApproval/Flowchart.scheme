		<Condition id="105" uuid="9fe0ccc3-5d16-4500-82aa-88bc3c801a11">
			<Properties>
				<Name>ThereIsADeviationFromFinancialCondition</Name>
				<Title>
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Is there any deviation from the financial conditions?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>آیا انحرافی از شرایط مالی وجود دارد؟</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>C'è una variazione dalle condizioni finanziarie?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Czy jest odchylenie od warunków finansowych?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Есть отклонение от финансовых условий?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Finansal şartlardan sapma var mı?</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Có sự sai lệch so với điều kiện tài chính?</v8:content>
					</v8:item>
				</Title>
