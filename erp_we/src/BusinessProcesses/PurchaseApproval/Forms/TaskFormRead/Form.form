  <attributes>
    <name>ApprovalProgress</name>
    <title>
      <key>en</key>
      <value>Approval progress</value>
    </title>
    <title>
      <key>fa</key>
      <value>پیشرفت تأیید</value>
    </title>
    <title>
      <key>it</key>
      <value>Corso di accordo</value>
    </title>
    <title>
      <key>pl</key>
      <value>Przebieg uzgodnienia</value>
    </title>
    <title>
      <key>ru</key>
      <value>Ход согласования</value>
    </title>
    <title>
      <key>tr</key>
      <value>Mutabakat ilerlemesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Quá trình thống nhất</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	PurchaseApprovalApprovalResults.RoutePoint         AS RoutePoint,
	PurchaseApprovalApprovalResults.Reviewer             AS Reviewer,
	PurchaseApprovalApprovalResults.ApprovalResult AS ApprovalResult,
	PurchaseApprovalApprovalResults.Comment           AS Comment,
	PurchaseApprovalApprovalResults.ApprovalDate      AS ApprovalDate,
	PurchaseApprovalApprovalResults.VersionNumber           AS VersionNumber
FROM
	BusinessProcess.PurchaseApproval.ApprovalResults AS PurchaseApprovalApprovalResults
WHERE
	PurchaseApprovalApprovalResults.Ref = &amp;BusinessProcess

ORDER BY
	ApprovalDate</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>RoutePoint</dataPath>
        <field>RoutePoint</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>VersionNumber</dataPath>
        <field>VersionNumber</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ApprovalDate</dataPath>
        <field>ApprovalDate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Reviewer</dataPath>
        <field>Reviewer</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ApprovalResult</dataPath>
