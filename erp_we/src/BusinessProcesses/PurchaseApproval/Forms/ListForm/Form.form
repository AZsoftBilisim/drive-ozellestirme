    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BusinessProcessPurchaseApproval.Ref,
	BusinessProcessPurchaseApproval.DeletionMark,
	BusinessProcessPurchaseApproval.Number,
	BusinessProcessPurchaseApproval.Date,
	BusinessProcessPurchaseApproval.Completed,
	BusinessProcessPurchaseApproval.HeadTask,
	BusinessProcessPurchaseApproval.Started,
	BusinessProcessPurchaseApproval.SubjectOf,
	BusinessProcessPurchaseApproval.Author,
	BusinessProcessPurchaseApproval.StartDate,
	BusinessProcessPurchaseApproval.CompletedOn,
	BusinessProcessPurchaseApproval.ApprovalDate,
	BusinessProcessPurchaseApproval.Description,
	BusinessProcessPurchaseApproval.Importance,
	BusinessProcessPurchaseApproval.ApprovalResult,
	CASE
		WHEN
			BusinessProcessPurchaseApproval.DeletionMark
			OR NOT BusinessProcessPurchaseApproval.Started
		THEN
			DATETIME(1,1,1)
		WHEN BusinessProcessPurchaseApproval.Started AND
			NOT BusinessProcessPurchaseApproval.Completed
			AND BusinessProcessPurchaseApproval.ApprovalDate &lt;> DATETIME(1,1,1)
		THEN
			BusinessProcessPurchaseApproval.ApprovalDate
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	CASE
		WHEN
			BusinessProcessPurchaseApproval.DeletionMark
			OR NOT BusinessProcessPurchaseApproval.Started
		THEN
			&amp;IsBlankString
		WHEN
			BusinessProcessPurchaseApproval.Started AND
			NOT BusinessProcessPurchaseApproval.Completed
		THEN
			&amp;OnApproval
		WHEN
			BusinessProcessPurchaseApproval.Completed AND
			BusinessProcessPurchaseApproval.ApprovalResult = VALUE(Enum.ApprovalResults.Approved)
		THEN
			&amp;Approved
		WHEN
			BusinessProcessPurchaseApproval.Completed AND
			BusinessProcessPurchaseApproval.ApprovalResult = VALUE(Enum.ApprovalResults.NotApproved)
		THEN
			&amp;NotApproved
	END AS State,
	CASE
		WHEN
			BusinessProcessPurchaseApproval.Started
			AND NOT BusinessProcessPurchaseApproval.Completed
			AND BusinessProcessPurchaseApproval.ApprovalDate &lt;> DATETIME(1,1,1)
			AND BusinessProcessPurchaseApproval.ApprovalDate &lt; &amp;UpdateDate
		THEN
			TRUE
		ELSE
			FALSE
	END AS Overdue
FROM
	BusinessProcess.PurchaseApproval AS BusinessProcessPurchaseApproval</queryText>
      <mainTable>BusinessProcess.PurchaseApproval</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
