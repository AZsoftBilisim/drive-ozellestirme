						<v8:lang>it</v8:lang>
						<v8:content>Concordare la domanda di reso delle merci dal cliente</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Uzgodnij zlecenie na zwrot towarów od klienta</v8:content>
