			<Properties>
				<Name>ApproveRequestForGoodsReturnFromTheCustomer</Name>
				<Title>
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Approve sales return request</v8:content>
					</v8:item>
					<v8:item>
