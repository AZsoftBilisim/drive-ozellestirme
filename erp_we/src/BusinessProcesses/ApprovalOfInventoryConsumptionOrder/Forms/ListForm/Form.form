  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ApprovalOfInventoryConsumptionOrder.Ref,
	ApprovalOfInventoryConsumptionOrder.DeletionMark,
	ApprovalOfInventoryConsumptionOrder.Number,
	ApprovalOfInventoryConsumptionOrder.Date,
	ApprovalOfInventoryConsumptionOrder.Completed,
	ApprovalOfInventoryConsumptionOrder.HeadTask,
	ApprovalOfInventoryConsumptionOrder.Started,
	ApprovalOfInventoryConsumptionOrder.SubjectOf,
	ApprovalOfInventoryConsumptionOrder.Author,
	ApprovalOfInventoryConsumptionOrder.StartDate,
	ApprovalOfInventoryConsumptionOrder.CompletedOn,
	ApprovalOfInventoryConsumptionOrder.ApprovalDate,
	ApprovalOfInventoryConsumptionOrder.Description,
	ApprovalOfInventoryConsumptionOrder.Importance,
	ApprovalOfInventoryConsumptionOrder.ApprovalResult,
	CASE
		WHEN
			ApprovalOfInventoryConsumptionOrder.DeletionMark
			OR NOT ApprovalOfInventoryConsumptionOrder.Started
		THEN
			&amp;IsBlankString
		WHEN
			ApprovalOfInventoryConsumptionOrder.Started AND
			NOT ApprovalOfInventoryConsumptionOrder.Completed
		THEN
			&amp;OnApproval
		WHEN
			ApprovalOfInventoryConsumptionOrder.Completed AND
			ApprovalOfInventoryConsumptionOrder.ApprovalResult = VALUE(Enum.ApprovalResults.Approved)
		THEN
			&amp;Approved
		WHEN
			ApprovalOfInventoryConsumptionOrder.Completed AND
			ApprovalOfInventoryConsumptionOrder.ApprovalResult = VALUE(Enum.ApprovalResults.NotApproved)
		THEN
			&amp;NotApproved
	END AS State,
	CASE
		WHEN
			NOT ApprovalOfInventoryConsumptionOrder.DeletionMark
			AND ApprovalOfInventoryConsumptionOrder.Started
			AND NOT ApprovalOfInventoryConsumptionOrder.Completed
			AND ApprovalOfInventoryConsumptionOrder.ApprovalDate &lt;> DATETIME(1,1,1)
			AND ApprovalOfInventoryConsumptionOrder.ApprovalDate &lt; &amp;UpdateDate
		THEN
			TRUE
		ELSE
			FALSE
	END AS Overdue
FROM
	BusinessProcess.ApprovalOfInventoryConsumptionOrder AS ApprovalOfInventoryConsumptionOrder</queryText>
