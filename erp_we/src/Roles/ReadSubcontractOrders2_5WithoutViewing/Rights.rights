	<object>
		<name>Catalog.SubcontractOrder2_5AttachedFiles</name>
		<right>
			<name>Read</name>
			<value>true</value>
			<restrictionByCondition>
				<condition>#IF &amp;RecordLevelAccessRestrictionIsUniversal #THEN
#ForObject("FileOwner")
#ELSE
#ByValuesExtended( "Catalog.SubcontractOrder2_5AttachedFiles","Read","",
"THE LEFT CONNECTION is A document.PROCESSING ORDER2_5 AS T1
BY T.File Owner = T1.Link

THE LEFT CONNECTION is A document.Processing order2_5.Output PRODUCTS AS T2
BY T.File Owner = T2.Link

THE LEFT CONNECTION is A document.Processing order2_5.By-products LIKE T3
BY T.File Owner = T3.Link",
"",
"Companies","T1.Organization","And",
"PartnerGroups","T1.Partner","And",
"Departments","T1.Department","And(",
"Departments,Warehouses","T2.Recipient","Or",
"Departments,Warehouses","T3.Recipient","Or",
"Condition","T2.Recipient Is NULL","And",
"Condition","T3.Recipient Is NULL",")",
"","","", "","","", "","","", "","","", "","","", "","","", "","","", "","","", "","","" )
#ENDIF</condition>
			</restrictionByCondition>
		</right>
	</object>
