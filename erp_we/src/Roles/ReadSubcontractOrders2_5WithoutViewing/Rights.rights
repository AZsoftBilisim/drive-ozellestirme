			<restrictionByCondition>
				<condition>#IF &amp;RecordLevelAccessRestrictionIsUniversal #THEN
#ForObject("")
#ELSE
#ByValuesExtended( "Document.SubcontractOrder2_5","Read","",
"THE LEFT CONNECTION is A document.Processing order2_5.Output products AS T1
BY T.Link = T1.Link
THE LEFT CONNECTION is A document.Processing order2_5.By-products AS T2
BY T.Link = T2.Link",
"",
"Companies","T.Organization","And",
"PartnerGroups","T.Partner","And",
"Departments","T.Department","And(",
"Departments,Warehouses","T1.Recipient","Or",
"Departments,Warehouses","T2.Recipient","Or",
"Condition","T1.Recipient Is NULL","And",
"Condition","T2.Recipient Is NULL",")",
"","","", "","","", "","","", "","","", "","","", "","","", "","","", "","","", "","","" )
#ENDIF</condition>
			</restrictionByCondition>
