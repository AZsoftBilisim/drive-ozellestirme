    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CCT.Ref,
	CCT.DataVersion,
	CCT.DeletionMark,
	CCT.Predefined,
	CCT.Parent,
	CCT.IsFolder,
	CCT.Description AS Description,
	CCT.ValueType,
	CCT.LongDesc,
	CCT.AssetLiability,
	CCT.AddlOrderingAttribute
FROM
	ChartOfCharacteristicTypes.AssetLiabilityItems AS CCT
WHERE
	CCT.AssetLiability &lt;> VALUE(Enum.KindsOfBalanceSheetStatementItems.EmptyRef)
	OR CCT.DataSource = &amp;OtherAssetsAndLiabilitiesRecords</queryText>
      <mainTable>ChartOfCharacteristicTypes.AssetLiabilityItems</mainTable>
