	ExpenseItems.AvailableTransactions,
	ExpenseItems.ControlDimensionFilling,
	ExpenseItems.OffsettingAccount,
	ExpenseItems.ClassifiedAsIndirectCostsByTaxAccounting,
	ExpenseItems.RestrictUsageInBusinessTransactions,
	ExpenseItems.LongDesc,
	ExpenseItems.CostAllocationRuleToProcuctCost,
	ExpenseItems.RecognizeAsSTSExpenses,
	ExpenseItems.EnteredInTaxAccounting,
	ExpenseItems.OtherExpenses,
	ExpenseItems.IntangibleAssetsAndRDExpenses,
	ExpenseItems.ExpensesOnConstructionObjects,
	ExpenseItems.ExpensesOnAssets,
	ExpenseItems.AddlOrderingAttribute,
	ExpenseItems.ProductCostElement,
	ExpenseItems.ExpensesOccur,
	ExpenseItems.ProductionCostType,
	ExpenseItems.RMOrderExpenses,
	ExpenseItems.CostAllocationRuleManag,
	ExpenseItems.CostAllocationRuleLocal,
	ExpenseItems.ResearchAndDevelopmentExpenses,
	ExpenseItems.RecognizedInAITExpenses,
	ExpenseItems.DescriptionLanguage1,
	ExpenseItems.DescriptionLanguage2,
	ExpenseItems.AdditionalAttributes.*,
	ExpenseItems.AvailableBusinessTransactions.*,
	ExpenseItems.Predefined,
	ExpenseItems.PredefinedDataName
FROM
	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems</queryText>
