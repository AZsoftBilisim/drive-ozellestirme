  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ExpenseItems.Ref,
	ExpenseItems.DataVersion,
	ExpenseItems.DeletionMark,
	ExpenseItems.Predefined,
	ExpenseItems.Parent,
	ExpenseItems.IsFolder,
	ExpenseItems.Code,
	ExpenseItems.Description AS Description,
	ExpenseItems.ValueType,
	ExpenseItems.DimensionOfExpensesOrderImplementation,
	ExpenseItems.CostAllocationOptionManag,
	ExpenseItems.CostAllocationOptionLocal,
	ExpenseItems.CostAllocationRuleToProcuctCost,
	ExpenseItems.CostAllocationRuleLocal,
	ExpenseItems.CostAllocationRuleManag,
	ExpenseItems.AddlOrderingAttribute,
	ExpenseItems.OtherExpenses,
	ExpenseItems.LoanAndDepositContracts,
	ExpenseItems.ActivityTypeForTaxAccountingOfCosts,
	ExpenseItems.OffsettingAccount,
	ExpenseItems.LongDesc,
	ExpenseItems.ExpensesOnAssets,
	ExpenseItems.RMOrderExpenses,
	ExpenseItems.RestrictUsageInBusinessTransactions
FROM
	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
WHERE
	(ExpenseItems.Ref &lt;> VALUE(ChartOfCharacteristicTypes.ExpenseItems.SaleCost) OR &amp;BusinessOperation = UNDEFINED)
	AND
		(&amp;WithoutRestrictionOfUse
		OR NOT ExpenseItems.RestrictUsageInBusinessTransactions
		OR ExpenseItems.IsFolder
		OR ExpenseItems.Ref IN (
			SELECT
				AvailableTransactions.Ref
			FROM
				ChartOfCharacteristicTypes.ExpenseItems.AvailableBusinessTransactions AS AvailableTransactions
			WHERE		
				AvailableTransactions.BusinessOperation = &amp;BusinessOperation
		)
	)
	AND ExpenseItems.CostAllocationOptionLocal &lt;> VALUE(Enum.CostAllocationOptions.OnOtherAssets)</queryText>
      <mainTable>ChartOfCharacteristicTypes.ExpenseItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>FinancialAccountingGroup</dataPath>
        <field>FinancialAccountingGroup</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
