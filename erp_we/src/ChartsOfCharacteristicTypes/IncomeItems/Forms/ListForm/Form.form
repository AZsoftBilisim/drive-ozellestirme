    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	IncomeItems.Ref,
	IncomeItems.DeletionMark,
	IncomeItems.Parent,
	IncomeItems.IsFolder,
	IncomeItems.Code,
	IncomeItems.Description AS Description,
	IncomeItems.ValueType,
	IncomeItems.AddlOrderingAttribute,
	IncomeItems.LineOfBusinessAllocationMethod,
	IncomeItems.OffsettingAccount,
	IncomeItems.LoanAndDepositContracts,
	IncomeItems.LongDesc,
	IncomeItems.FinancialAccountingGroup,
	IncomeItems.EnteredInTaxAccounting,
	IncomeItems.IncomeByAssets,
	IncomeItems.IntangibleAssetsAndRDIncome,
	IncomeItems.ControlDimensionFilling,
	IncomeItems.KindOfExpensesForOtherActivity,
	IncomeItems.ActivityTypeForTaxAccountingOfCosts,
	IncomeItems.DescriptionLanguage1,
	IncomeItems.DescriptionLanguage2,
	IncomeItems.AdditionalAttributes.*,
	IncomeItems.Predefined,
	IncomeItems.PredefinedDataName
FROM
	ChartOfCharacteristicTypes.IncomeItems AS IncomeItems</queryText>
      <mainTable>ChartOfCharacteristicTypes.IncomeItems</mainTable>
