            <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
              <choiceList>
                <presentation>
                  <key>en</key>
                  <value>Shared information record</value>
                </presentation>
                <presentation>
                  <key>fa</key>
                  <value>رکورد اطلاعاتی مشترک</value>
                </presentation>
                <presentation>
                  <key>it</key>
                  <value>Informazione generale</value>
                </presentation>
                <presentation>
                  <key>pl</key>
                  <value>Wspólna informacja</value>
                </presentation>
                <presentation>
                  <key>ru</key>
                  <value>Общее сведение</value>
                </presentation>
                <presentation>
                  <key>tr</key>
                  <value>Ortak bilgi</value>
                </presentation>
                <presentation>
                  <key>vi</key>
                  <value>Thông tin chung</value>
