      <items xsi:type="form:FormField">
        <name>IndependentInfoItemValues</name>
        <id>26</id>
        <title>
          <key>en</key>
          <value>Exclusive property with exclusive values</value>
        </title>
        <title>
          <key>fa</key>
          <value>خاصیت اختصاصی با مقادیر اختصاصی</value>
        </title>
        <title>
          <key>it</key>
          <value>Proprietà singola con l'elenco separato di valori</value>
