            <textColor xsi:type="core:ColorRef">
              <color>Style.NoteText</color>
            </textColor>
            <extInfo xsi:type="form:LabelDecorationExtInfo">
              <horizontalAlign>Left</horizontalAlign>
            </extInfo>
          </items>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
          <title>
            <key>en</key>
            <value>Shared information record type</value>
          </title>
          <title>
            <key>fa</key>
            <value>نوع رکورد اطلاعاتی مشترک</value>
          </title>
          <title>
            <key>it</key>
            <value>Tipo dell'informazione generale</value>
          </title>
          <title>
            <key>pl</key>
            <value>Widok wspólna informacja</value>
          </title>
