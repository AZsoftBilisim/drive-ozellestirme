  <attributes>
    <name>PropertiesSets</name>
    <title>
      <key>en</key>
      <value>Property sets</value>
    </title>
    <title>
      <key>fa</key>
      <value>مجموعه‌های خاصیت</value>
    </title>
    <title>
      <key>it</key>
      <value>Set di proprietà</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zestawy właściwości</value>
    </title>
    <title>
      <key>ru</key>
      <value>Наборы свойств</value>
    </title>
    <title>
      <key>tr</key>
      <value>Özellik setleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Tập hợp thuộc tính</value>
    </title>
    <id>21</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Sets.Ref AS Ref,
	Sets.DataVersion AS DataVersion,
	Sets.DeletionMark AS DeletionMark,
	Sets.Predefined AS Predefined,
	Sets.Parent AS Parent,
	Sets.IsFolder AS IsFolder,
	Sets.Description AS Description,
	Sets.Used AS Used,
	CASE
		WHEN Sets.IsFolder
			THEN Sets.Description
		WHEN &amp;PropertyKind1 = VALUE(Enum.PropertiesKinds.AdditionalInfo)
			THEN CASE
				WHEN Sets.InfoCount = &quot;&quot;
					THEN Sets.Description
				ELSE Sets.Description + &quot; (&quot; + Sets.InfoCount + &quot;)&quot;
			END
		WHEN &amp;PropertyKind1 = VALUE(Enum.PropertiesKinds.AdditionalAttributes)
		THEN CASE
			WHEN Sets.AttributesCount = &quot;&quot;
				THEN Sets.Description
			ELSE Sets.Description + &quot; (&quot; + Sets.AttributesCount + &quot;)&quot;
		END
		WHEN &amp;PropertyKind1 = VALUE(Enum.PropertiesKinds.Labels)
		THEN CASE
			WHEN Sets.LabelCount = &quot;&quot;
				THEN Sets.Description
			ELSE Sets.Description + &quot; (&quot; + Sets.LabelCount + &quot;)&quot;
		END
	END AS Presentation,
	CASE
		WHEN Sets.DeletionMark
			THEN 1
		ELSE 0
	END + CASE
		WHEN Sets.Predefined
			THEN 2
		ELSE 0
	END AS PictureNumber
FROM
	Catalog.AdditionalAttributesAndInfoSets AS Sets
WHERE
	CASE
		WHEN Sets.Parent = VALUE(Catalog.AdditionalAttributesAndInfoSets.EmptyRef)
			THEN Sets.Ref IN (&amp;Sets)
		ELSE Sets.Parent IN (&amp;Sets)
	END
	AND Sets.Used
	AND ISNULL(Sets.Parent.Used, TRUE)
	AND NOT Sets.Ref IN (&amp;SetsToExclude)
	AND NOT Sets.DeletionMark</queryText>
      <mainTable>Catalog.AdditionalAttributesAndInfoSets</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
