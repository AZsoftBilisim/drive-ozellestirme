              </extInfo>
            </extendedTooltip>
            <contextMenu>
              <name>AdditionalAttributeWarningTextContextMenu</name>
              <id>7</id>
              <autoFill>true</autoFill>
            </contextMenu>
            <type>Label</type>
            <autoMaxHeight>true</autoMaxHeight>
            <verticalStretch>true</verticalStretch>
            <skipOnInput>false</skipOnInput>
            <extInfo xsi:type="form:LabelDecorationExtInfo">
              <horizontalAlign>Left</horizontalAlign>
              <verticalAlign>Top</verticalAlign>
            </extInfo>
          </items>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
          <title>
            <key>en</key>
            <value>Additional attribute warning</value>
          </title>
          <title>
            <key>fa</key>
            <value>هشدار ویژگی تکمیلی</value>
          </title>
          <title>
            <key>it</key>
            <value>Avviso del requisito aggiuntivo</value>
          </title>
          <title>
            <key>pl</key>
            <value>Ostrzeżenie dodatkowego rekwizytu</value>
          </title>
          <title>
            <key>ru</key>
            <value>Предупреждение дополнительного реквизита</value>
