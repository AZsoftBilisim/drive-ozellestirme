	<dataSet xsi:type="DataSetQuery">
		<name>ComparisonOfDataSources</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>OriginalDataSource</dataPath>
			<field>OriginalDataSource</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Original data source</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>منبع داده اصلی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Sorgente dei dati iniziale</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Wyjściowe źródło danych</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Источник данных исходный</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Asıl verilerin kaynağı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Nguồn dữ liệu nguồn</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DataSource</dataPath>
			<field>DataSource</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Data source</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>منبع داده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Origine dei dati</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Źródło danych</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Источник данных</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Veri kaynağı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Nguồn dữ liệu</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>

// THERE ARE CLIPPING TAGS



SELECT
	BusinessTransactionsSettings.Ref AS DataSource,
	&amp;OriginalDataSource AS OriginalDataSource
FROM
	Enum.BusinessTransactions AS BusinessTransactionsSettings
WHERE
	BusinessTransactionsSettings.Ref = &amp;OriginalDataSource

UNION ALL

SELECT
	AssetLiabilityItems.Ref,
	&amp;OriginalDataSource
FROM
	ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
WHERE
	AssetLiabilityItems.Ref = &amp;OriginalDataSource

UNION ALL

SELECT
	&amp;OriginalDataSource,
	&amp;OriginalDataSource
WHERE
	(VALUETYPE(&amp;OriginalDataSource) = TYPE(STRING)
	OR VALUETYPE(&amp;OriginalDataSource) = TYPE(BOOLEAN))
	

UNION ALL

SELECT
	International.Ref,
	&amp;OriginalDataSource
FROM
	ChartOfAccounts.International AS International
WHERE
	CASE
			WHEN &amp;HierarchyIsRequired OR &amp;OriginalDataSource = VALUE(ChartOfAccounts.International.EmptyRef)
				THEN International.Ref IN HIERARCHY (&amp;OriginalDataSource)
			ELSE International.Ref = &amp;OriginalDataSource
		END

UNION ALL

SELECT
	// For off-balance sheet accounts
	VALUE(ChartOfAccounts.International.EmptyRef) AS DataSource,
	&amp;OriginalDataSource AS OriginalDataSource
WHERE
	&amp;OriginalDataSource = VALUE(ChartOfAccounts.International.EmptyRef)
</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>OriginalDataSources</sourceDataSet>
		<destinationDataSet>ComparisonOfDataSources</destinationDataSet>
		<sourceExpression>OriginalDataSource</sourceExpression>
		<destinationExpression>OriginalDataSource</destinationExpression>
		<parameter>OriginalDataSource</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<parameter>
		<name>OriginalDataSource</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Original data source</v8:content>
			</v8:item>
