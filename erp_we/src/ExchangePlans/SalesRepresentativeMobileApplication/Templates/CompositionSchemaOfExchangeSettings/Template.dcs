		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TypesOfPrices.Ref AS TypesOfPrices,
	Products.Ref AS Products,
	Companies.Ref AS Companies,
	Partners.Ref AS Partners,
	OrderCancellationReasons.Ref AS OrderCancellationReasons,
	CustomerTermsOfSales.Ref AS StandardTermsOfSalesWithCustomer,
	Warehouses.Ref AS Warehouses
FROM
	Catalog.Products AS Products,
	Catalog.ReasonsForSaleOrderCancellation AS OrderCancellationReasons,
	Catalog.TermsOfSale AS CustomerTermsOfSales,
	Catalog.Warehouses AS Warehouses,	
	Catalog.Partners AS Partners,
	Catalog.Companies AS Companies,
	Catalog.TypesOfPrices AS TypesOfPrices</query>
	</dataSet>
