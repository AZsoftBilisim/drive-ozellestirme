		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ProductChanges_.Ref AS OwnGoods
INTO ProductChanges_
FROM
	Catalog.Products.Changes AS ProductChanges_
WHERE
	VALUETYPE(ProductChanges_.Node) = TYPE(ExchangePlan.MobileApplicationSalesOrders)
	AND ProductChanges_.Node = &amp;Node
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ImageFiles.Ref AS ImageFile
INTO ImageFiles
FROM
	Catalog.ProductsAttachedFiles.Changes AS ImageFiles
WHERE
	VALUETYPE(ImageFiles.Node) = TYPE(ExchangePlan.MobileApplicationSalesOrders)
	AND ImageFiles.Node = &amp;Node
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomerAgreementsSales.Ref AS Terms,
	Companies.Ref AS Organization,
	CustomerAgreementsSales.PricesKind AS TypesOfAgreementPrices,
	CustomerAgreementsSales.PriceIncludesVAT AS PriceIncludesVAT
INTO TypesOfPricesFromModelAgreements
FROM
	Catalog.TermsOfSale AS CustomerAgreementsSales
		INNER JOIN Catalog.Companies AS Companies
		ON (CASE
				WHEN CustomerAgreementsSales.Organization = VALUE(Catalog.Companies.EmptyRef)
					THEN TRUE
				ELSE CustomerAgreementsSales.Organization = Companies.Ref
			END)
			AND (CASE
				WHEN &amp;ManagementCompanyNotUsed
					THEN NOT Companies.Predefined
				ELSE TRUE
			END)
WHERE
	(CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			OR CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent))
	AND CustomerAgreementsSales.Standard_
	AND CustomerAgreementsSales.Currency = &amp;Currency
	AND CustomerAgreementsSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
	AND CASE
			WHEN NOT CustomerAgreementsSales.ValidityStartDate = DATETIME(1, 1, 1)
				THEN NOT CustomerAgreementsSales.ValidityStartDate &gt; &amp;Period
			ELSE TRUE
		END
	AND CASE
			WHEN NOT CustomerAgreementsSales.ValidityEndDate = DATETIME(1, 1, 1)
				THEN NOT CustomerAgreementsSales.ValidityEndDate &lt; &amp;Period
			ELSE TRUE
		END

INDEX BY
	TypesOfAgreementPrices
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Companies.Ref AS Organization,
	IndividualAgreements.PricesKind AS TypesOfAgreementPrices,
	IndividualAgreements.PriceIncludesVAT AS PriceIncludesVAT
INTO TypesOfPricesFromIndividualAgreements
FROM
	Catalog.TermsOfSale AS IndividualAgreements
		INNER JOIN Catalog.Companies AS Companies
		ON (CASE
				WHEN IndividualAgreements.Organization = VALUE(Catalog.Companies.EmptyRef)
					THEN TRUE
				ELSE IndividualAgreements.Organization = Companies.Ref
			END)
			AND (CASE
				WHEN &amp;ManagementCompanyNotUsed
					THEN NOT Companies.Predefined
				ELSE TRUE
			END)
WHERE
	(IndividualAgreements.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			OR IndividualAgreements.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent))
	AND NOT IndividualAgreements.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
	AND NOT IndividualAgreements.Standard_
	AND IndividualAgreements.Currency = &amp;Currency
	AND IndividualAgreements.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
	AND CASE
			WHEN NOT IndividualAgreements.ValidityStartDate = DATETIME(1, 1, 1)
				THEN NOT IndividualAgreements.ValidityStartDate &gt; &amp;Period
			ELSE TRUE
		END
	AND CASE
			WHEN NOT IndividualAgreements.ValidityEndDate = DATETIME(1, 1, 1)
				THEN NOT IndividualAgreements.ValidityEndDate &lt; &amp;Period
			ELSE TRUE
		END

INDEX BY
	TypesOfAgreementPrices
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AvailableTypesOfPrices.PriceKind AS PriceKind
INTO AvailableTypesOfPrices
FROM
	(SELECT
		CatTypesOfPrices.Ref AS PriceKind
	FROM
		Catalog.TypesOfPrices AS CatTypesOfPrices
			INNER JOIN TypesOfPricesFromModelAgreements AS TypesOfPricesFromModelAgreements
			ON (CASE
					WHEN TypesOfPricesFromModelAgreements.TypesOfAgreementPrices = VALUE(Catalog.TypesOfPrices.EmptyRef)
						THEN TRUE
					ELSE TypesOfPricesFromModelAgreements.TypesOfAgreementPrices = CatTypesOfPrices.Ref
				END)
				AND (TypesOfPricesFromModelAgreements.PriceIncludesVAT = CatTypesOfPrices.PriceIncludesVAT)
	WHERE
		CatTypesOfPrices.UseWhileSellingToCustomers
		AND CatTypesOfPrices.PriceCurrency = &amp;Currency
	
	UNION ALL
	
	SELECT
		CatTypesOfPrices.Ref
	FROM
		Catalog.TypesOfPrices AS CatTypesOfPrices
			INNER JOIN TypesOfPricesFromIndividualAgreements AS TypesOfPricesFromIndividualAgreements
			ON (TypesOfPricesFromIndividualAgreements.TypesOfAgreementPrices = CatTypesOfPrices.Ref)
				AND (TypesOfPricesFromIndividualAgreements.PriceIncludesVAT = CatTypesOfPrices.PriceIncludesVAT)
	WHERE
		CatTypesOfPrices.UseWhileSellingToCustomers
		AND CatTypesOfPrices.PriceCurrency = &amp;Currency
	
	UNION ALL
	
	SELECT
		TypesOfPrices.Ref
	FROM
		Catalog.TypesOfPrices AS TypesOfPrices
	WHERE
		&amp;NotAgreementsAreUsed
		AND TypesOfPrices.UseWhileSellingToCustomers
		AND TypesOfPrices.PriceCurrency = &amp;Currency) AS AvailableTypesOfPrices
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductSegments.Ref AS ProductSegment
INTO AvailableProductSegments
FROM
	Catalog.ProductSegments AS ProductSegments
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductsWithCharacteristics.Products AS Products,
	ProductsWithCharacteristics.Characteristic AS Characteristic
INTO ProductsWithCharacteristics
FROM
	(SELECT DISTINCT
		Segments.Products AS Products,
		Segments.Characteristic AS Characteristic
	FROM
		InformationRegister.SegmentProducts AS Segments
	WHERE
		&amp;FilterByProductSegmentIsUsed
		AND Segments.Segment IN
				(SELECT
					AvailableProductSegments.ProductSegment
				FROM
					AvailableProductSegments)
	
	UNION ALL
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems))
				AND ItemsCharacteristics.Owner = Products.Ref
	
	UNION
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind))
				AND ItemsCharacteristics.Owner = Products.ProductKind
	
	UNION
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
				AND ItemsCharacteristics.Owner = Products.ItemVariantsOwner
	
	UNION
	
	SELECT
		Products.Ref,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	FROM
		Catalog.Products AS Products
	WHERE
		NOT &amp;FilterByProductSegmentIsUsed
		AND NOT Products.IsFolder) AS ProductsWithCharacteristics
WHERE
	NOT ProductsWithCharacteristics.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CAST("""" AS STRING(36)) AS PriceKind,
	CAST("""" AS STRING(36)) AS Products,
	CAST("""" AS STRING(36)) AS Package,
	CAST("""" AS STRING(36)) AS ProductKind,
	CAST("""" AS STRING(36)) AS ProductsParent,
	CAST("""" AS STRING(36)) AS PriceGroup,
	ItemsPrices.Products.Code + ItemsPrices.Products.Description + ItemsPrices.Products.SKU AS SearchString,
	CAST("""" AS STRING(36)) AS ProductsID,
	CAST("""" AS STRING(36)) AS VariantID,
	CAST("""" AS STRING(36)) AS PackagingsID,
	ItemsPrices.Products AS ProductsLink,
	ItemsPrices.Products.ProductKind AS ProductKindReference,
	ItemsPrices.Products.Parent AS ProductsParentReference,
	ItemsPrices.Products.PriceGroup AS PriceGroupReference,
	ItemsPrices.Products.UsePackages AS UsePackages,
	ItemsPrices.Products.UnitOfMeasure AS UnitOfMeasureLink,
	ItemsPrices.Characteristic AS CharacteristicReference,
	ItemsPrices.PriceKind AS PriceTypeReference,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN ItemsPrices.Price = 0
			THEN 0
		ELSE ItemsPrices.Price * CASE
				WHEN NOT ItemsPrices.Currency = &amp;Currency
					THEN CASE
							WHEN ISNULL(RatesCutCurrencyPrices.CourseDenominator, 0) &gt; 0
									AND ISNULL(RatesCutCurrencyPrices.CourseNumerator, 0) &gt; 0
									AND ISNULL(CrossSectionRatesDocumentCurrency.CourseDenominator, 0) &gt; 0
									AND ISNULL(CrossSectionRatesDocumentCurrency.CourseNumerator, 0) &gt; 0
								THEN RatesCutCurrencyPrices.CourseNumerator * CrossSectionRatesDocumentCurrency.CourseDenominator / (CrossSectionRatesDocumentCurrency.CourseNumerator * RatesCutCurrencyPrices.CourseDenominator)
							ELSE 0
						END
				ELSE 1
			END
	END AS Price,
	CASE
		WHEN ItemsPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN ItemsPrices.Products.UsePackages
						THEN ISNULL(ProductPackages.Ref, ItemsPrices.Products.UnitOfMeasure)
					ELSE ItemsPrices.Products.UnitOfMeasure
				END
		ELSE ItemsPrices.Package
	END AS PackagingRef,
	CASE
		WHEN ItemsPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN ItemsPrices.Products.UsePackages
						THEN ISNULL(ProductPackages.Owner, ItemsPrices.Products)
					ELSE ItemsPrices.Products
				END
		ELSE ItemsPrices.Package.Owner
	END AS PackagingOwnerReference,
	CASE
		WHEN &amp;UseCharacteristics
				AND (ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					OR ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					OR ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
			THEN TRUE
		ELSE FALSE
	END AS ItemVariantsAreUsed,
	CASE
		WHEN &amp;UseWeightCharacteristics
			THEN TRUE
		ELSE FALSE
	END AS UseWeight,
	CASE
		WHEN &amp;TransmitProductImages
			THEN TRUE
		ELSE FALSE
	END AS UsePictures,
	CASE
		WHEN &amp;TransmitProductImages
			THEN ItemsPrices.Products.PicturesFile
		ELSE VALUE(Catalog.ProductsAttachedFiles.EmptyRef)
	END AS ImageFileLink,
	CASE
		WHEN &amp;TransmitProductImages
				AND NOT ChangeImageFiles.ImageFile IS NULL
			THEN TRUE
		ELSE FALSE
	END AS ImageSubmissionIsRequired,
	CASE
		WHEN NOT ProductChanges_.OwnGoods IS NULL
			THEN TRUE
		ELSE FALSE
	END AS GoodsShipmentIsRequired
FROM
	InformationRegister.ItemsPrices.SliceLast(&amp;Period, ) AS ItemsPrices
		INNER JOIN AvailableTypesOfPrices AS AvailableTypesOfPrices
		ON (AvailableTypesOfPrices.PriceKind = ItemsPrices.PriceKind)
		INNER JOIN ProductsWithCharacteristics AS ProductsWithCharacteristics
		ON ItemsPrices.Products = ProductsWithCharacteristics.Products
			AND ItemsPrices.Characteristic = ProductsWithCharacteristics.Characteristic
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;Period, BaseCurrency = &amp;BaseCurrency) AS RatesCutCurrencyPrices
		ON (RatesCutCurrencyPrices.Currency = ItemsPrices.Currency)
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;Period, Currency = &amp;Currency AND BaseCurrency = &amp;BaseCurrency) AS CrossSectionRatesDocumentCurrency
		ON (TRUE)
		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		ON (ProductPackages.Owner = CASE
				WHEN ItemsPrices.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
					THEN ItemsPrices.Products
				WHEN NOT ItemsPrices.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.EmptyRef)
					THEN ItemsPrices.Products.PackagingGroup
				ELSE FALSE
			END)
			AND (ProductPackages.UnitOfMeasure = ItemsPrices.Products.UnitOfMeasure)
		LEFT JOIN ImageFiles AS ChangeImageFiles
		ON (&amp;TransmitProductImages)
			AND (ChangeImageFiles.ImageFile = ItemsPrices.Products.PicturesFile)
		LEFT JOIN ProductChanges_ AS ProductChanges_
		ON (ProductChanges_.OwnGoods = ItemsPrices.Products)
WHERE
	(NOT ItemsPrices.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
				AND CASE
					WHEN NOT &amp;HasChanges
						THEN TRUE
					ELSE ItemsPrices.Products IN (&amp;ProductsArray)
							AND ItemsPrices.Characteristic IN (&amp;ArrayOfCharacteristics)
							AND ItemsPrices.PriceKind IN (&amp;ArrayOfPriceTypes)
				END
			OR ItemsPrices.Products IN
				(SELECT
					ProductChanges_.OwnGoods
				FROM
					ProductChanges_))
;

////////////////////////////////////////////////////////////////////////////////
DROP ProductChanges_
;

////////////////////////////////////////////////////////////////////////////////
DROP ImageFiles
;

////////////////////////////////////////////////////////////////////////////////
DROP TypesOfPricesFromModelAgreements
;

////////////////////////////////////////////////////////////////////////////////
DROP TypesOfPricesFromIndividualAgreements
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableTypesOfPrices
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableProductSegments
;

////////////////////////////////////////////////////////////////////////////////
DROP ProductsWithCharacteristics</query>
