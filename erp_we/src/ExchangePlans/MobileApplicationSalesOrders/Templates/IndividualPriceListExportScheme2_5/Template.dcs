		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ProductChanges_.Ref AS OwnGoods
INTO ProductChanges_
FROM
	Catalog.Products.Changes AS ProductChanges_
WHERE
	VALUETYPE(ProductChanges_.Node) = TYPE(ExchangePlan.MobileApplicationSalesOrders)
	AND ProductChanges_.Node = &amp;Node
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ImageFiles.Ref AS ImageFile
INTO ImageFiles
FROM
	Catalog.ProductsAttachedFiles.Changes AS ImageFiles
WHERE
	VALUETYPE(ImageFiles.Node) = TYPE(ExchangePlan.MobileApplicationSalesOrders)
	AND ImageFiles.Node = &amp;Node
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomerAgreementsSales.Ref AS CustomerTermsOfSales,
	Companies.Ref AS Organization,
	CustomerAgreementsSales.PricesKind AS TypesOfPricesAgreementsWithClient,
	CustomerAgreementsSales.SpecialPriceType AS IndividualTypeOfPricesAgreementWithClient,
	CustomerAgreementsSales.ProductSegment AS CustomerAgreementProductSegment,
	CustomerAgreementsSales.PriceIncludesVAT AS PriceIncludesVAT
INTO SpecialTermsOfSales
FROM
	Catalog.TermsOfSale AS CustomerAgreementsSales
		INNER JOIN Catalog.Companies AS Companies
		ON (CASE
				WHEN CustomerAgreementsSales.Organization = VALUE(Catalog.Companies.EmptyRef)
					THEN TRUE
				ELSE CustomerAgreementsSales.Organization = Companies.Ref
			END)
			AND (CASE
				WHEN &amp;ManagementCompanyNotUsed
					THEN NOT Companies.Predefined
				ELSE TRUE
			END)
WHERE
	(CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			OR CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent))
	AND CustomerAgreementsSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
	AND CASE
			WHEN NOT CustomerAgreementsSales.ValidityStartDate = DATETIME(1, 1, 1)
				THEN NOT CustomerAgreementsSales.ValidityStartDate &gt; &amp;Period
			ELSE TRUE
		END
	AND CASE
			WHEN NOT CustomerAgreementsSales.ValidityEndDate = DATETIME(1, 1, 1)
				THEN NOT CustomerAgreementsSales.ValidityEndDate &lt; &amp;Period
			ELSE TRUE
		END
	AND CustomerAgreementsSales.Ref = &amp;CustomerTermsOfSales

INDEX BY
	TypesOfPricesAgreementsWithClient
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductSegments.Ref AS ProductSegment
INTO AvailableProductSegments
FROM
	Catalog.ProductSegments AS ProductSegments
		INNER JOIN SpecialTermsOfSales AS SpecialTermsOfSales
		ON (CASE
				WHEN SpecialTermsOfSales.CustomerAgreementProductSegment = VALUE(Catalog.ProductSegments.EmptyRef)
					THEN TRUE
				ELSE SpecialTermsOfSales.CustomerAgreementProductSegment = ProductSegments.Ref
			END)

INDEX BY
	ProductSegment
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ItemKinds.Ref AS ProductKind,
	ItemKinds.SettingsOfPriceKeyByItemVariant AS SettingsOfPriceKeyByItemVariant
INTO ItemKinds
FROM
	Catalog.ItemKinds AS ItemKinds
WHERE
	NOT ItemKinds.IsFolder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductsWithCharacteristics.Products AS Products,
	ProductsWithCharacteristics.Characteristic AS Characteristic,
	ProductsWithCharacteristics.PricingVariant AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage
INTO ProductsWithCharacteristics
FROM
	(SELECT DISTINCT
		Segments.Products AS Products,
		Segments.Characteristic AS Characteristic,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE Segments.Characteristic.ItemsCharacteristicForPricing
		END AS PricingVariant
	FROM
		InformationRegister.SegmentProducts AS Segments
			INNER JOIN ItemKinds AS ItemKinds
			ON Segments.Products.ProductKind = ItemKinds.ProductKind
	WHERE
		&amp;FilterByProductSegmentIsUsed
		AND Segments.Segment IN
				(SELECT
					AvailableProductSegments.ProductSegment
				FROM
					AvailableProductSegments)
	
	UNION ALL
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems))
				AND ItemsCharacteristics.Owner = Products.Ref
			INNER JOIN ItemKinds AS ItemKinds
			ON (Products.ProductKind = ItemKinds.ProductKind)
	
	UNION
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind))
				AND ItemsCharacteristics.Owner = Products.ProductKind
			INNER JOIN ItemKinds AS ItemKinds
			ON (Products.ProductKind = ItemKinds.ProductKind)
	
	UNION
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
				AND ItemsCharacteristics.Owner = Products.ItemVariantsOwner
			INNER JOIN ItemKinds AS ItemKinds
			ON (Products.ProductKind = ItemKinds.ProductKind)
	
	UNION
	
	SELECT
		Products.Ref,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef),
		VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	FROM
		Catalog.Products AS Products
	WHERE
		NOT &amp;FilterByProductSegmentIsUsed
		AND NOT Products.IsFolder) AS ProductsWithCharacteristics
WHERE
	NOT ProductsWithCharacteristics.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)

INDEX BY
	Products,
	Characteristic,
	PricingVariant
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SpecialTermsOfSales.CustomerTermsOfSales AS CustomerTermsOfSales,
	Prices.Products AS Products,
	ProductsWithCharacteristics.Characteristic AS Characteristic,
	Prices.PriceKind AS PriceKind,
	Prices.Currency AS Currency,
	Prices.Price AS Price,
	Prices.Package AS Package
INTO IndividualPricesGeneral
FROM
	InformationRegister.ItemsPrices25.SliceLast(
			&amp;Period,
			(Products, PricingVariant, PricingBatch, PricingPackage) IN
					(SELECT
						ProductsWithCharacteristics.Products,
						ProductsWithCharacteristics.PricingVariant,
						ProductsWithCharacteristics.PricingBatch,
						ProductsWithCharacteristics.PricingPackage
					FROM
						ProductsWithCharacteristics)
				AND PriceKind IN
					(SELECT DISTINCT
						SpecialTermsOfSales.IndividualTypeOfPricesAgreementWithClient
					FROM
						SpecialTermsOfSales AS SpecialTermsOfSales)) AS Prices
		INNER JOIN ProductsWithCharacteristics AS ProductsWithCharacteristics
		ON Prices.Products = ProductsWithCharacteristics.Products
			AND Prices.PricingVariant = ProductsWithCharacteristics.PricingVariant
		LEFT JOIN SpecialTermsOfSales AS SpecialTermsOfSales
		ON Prices.PriceKind = SpecialTermsOfSales.IndividualTypeOfPricesAgreementWithClient

INDEX BY
	Products,
	Characteristic,
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CAST("" AS STRING(36)) AS Products,
	CAST("" AS STRING(36)) AS PriceKind,
	CAST("" AS STRING(36)) AS Warehouse,
	CAST("" AS STRING(36)) AS Package,
	CAST("" AS STRING(36)) AS ProductKind,
	CAST("" AS STRING(36)) AS ProductsParent,
	CAST("" AS STRING(36)) AS PriceGroup,
	CAST("" AS STRING(36)) AS ProductsID,
	CAST("" AS STRING(36)) AS VariantID,
	CAST("" AS STRING(36)) AS PackagingsID,
	CAST("" AS STRING(36)) AS CustomerContract,
	IndividualPrices.Products.Code + IndividualPrices.Products.Description + IndividualPrices.Products.SKU AS SearchString,
	IndividualPrices.Products AS ProductsLink,
	IndividualPrices.Products.ProductKind AS ProductKindReference,
	IndividualPrices.Products.Parent AS ProductsParentReference,
	IndividualPrices.Products.PriceGroup AS PriceGroupReference,
	IndividualPrices.Products.UsePackages AS UsePackages,
	IndividualPrices.Products.UnitOfMeasure AS UnitOfMeasureLink,
	IndividualPrices.Characteristic AS CharacteristicReference,
	IndividualPrices.PriceKind AS PriceTypeReference,
	CASE
		WHEN IndividualPrices.Price = 0
			THEN 0
		ELSE IndividualPrices.Price * CASE
				WHEN NOT IndividualPrices.Currency = &amp;Currency
					THEN CASE
							WHEN ISNULL(RatesCutCurrencyPrices.CourseDenominator, 0) &gt; 0
									AND ISNULL(RatesCutCurrencyPrices.CourseNumerator, 0) &gt; 0
									AND ISNULL(CrossSectionRatesDocumentCurrency.CourseDenominator, 0) &gt; 0
									AND ISNULL(CrossSectionRatesDocumentCurrency.CourseNumerator, 0) &gt; 0
								THEN RatesCutCurrencyPrices.CourseNumerator * CrossSectionRatesDocumentCurrency.CourseDenominator / (CrossSectionRatesDocumentCurrency.CourseNumerator * RatesCutCurrencyPrices.CourseDenominator)
							ELSE 0
						END
				ELSE 1
			END
	END AS Price,
	CASE
		WHEN IndividualPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN IndividualPrices.Products.UsePackages
						THEN ISNULL(ProductPackages.Ref, IndividualPrices.Products.UnitOfMeasure)
					ELSE IndividualPrices.Products.UnitOfMeasure
				END
		ELSE IndividualPrices.Package
	END AS PackagingRef,
	CASE
		WHEN IndividualPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN IndividualPrices.Products.UsePackages
						THEN ISNULL(ProductPackages.Owner, IndividualPrices.Products)
					ELSE IndividualPrices.Products
				END
		ELSE IndividualPrices.Package.Owner
	END AS PackagingOwnerReference,
	CASE
		WHEN &amp;UseCharacteristics
				AND (IndividualPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					OR IndividualPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					OR IndividualPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
			THEN TRUE
		ELSE FALSE
	END AS ItemVariantsAreUsed,
	CASE
		WHEN &amp;UseWeightCharacteristics
			THEN TRUE
		ELSE FALSE
	END AS UseWeight,
	CASE
		WHEN &amp;TransmitProductImages
			THEN TRUE
		ELSE FALSE
	END AS UsePictures,
	CASE
		WHEN &amp;TransmitProductImages
			THEN IndividualPrices.Products.PicturesFile
		ELSE VALUE(Catalog.ProductsAttachedFiles.EmptyRef)
	END AS ImageFileLink,
	CASE
		WHEN &amp;TransmitProductImages
				AND NOT ChangeImageFiles.ImageFile IS NULL
			THEN TRUE
		ELSE FALSE
	END AS ImageSubmissionIsRequired,
	CASE
		WHEN NOT ProductChanges_.OwnGoods IS NULL
			THEN TRUE
		ELSE FALSE
	END AS GoodsShipmentIsRequired
FROM
	IndividualPricesGeneral AS IndividualPrices
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;Period, BaseCurrency = &amp;BaseCurrency) AS RatesCutCurrencyPrices
		ON (RatesCutCurrencyPrices.Currency = IndividualPrices.Currency)
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;Period, Currency = &amp;Currency AND BaseCurrency = &amp;BaseCurrency) AS CrossSectionRatesDocumentCurrency
		ON (TRUE)
		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		ON (ProductPackages.Owner = CASE
				WHEN IndividualPrices.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
					THEN IndividualPrices.Products
				WHEN NOT IndividualPrices.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.EmptyRef)
					THEN IndividualPrices.Products.PackagingGroup
				ELSE FALSE
			END)
			AND (ProductPackages.UnitOfMeasure = IndividualPrices.Products.UnitOfMeasure)
		LEFT JOIN ImageFiles AS ChangeImageFiles
		ON (&amp;TransmitProductImages)
			AND (ChangeImageFiles.ImageFile = IndividualPrices.Products.PicturesFile)
		LEFT JOIN ProductChanges_ AS ProductChanges_
		ON (ProductChanges_.OwnGoods = IndividualPrices.Products)
WHERE
	CASE
			WHEN IndividualPrices.CustomerTermsOfSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
				THEN IndividualPrices.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
			ELSE TRUE
		END
;

////////////////////////////////////////////////////////////////////////////////
DROP ProductChanges_
;

////////////////////////////////////////////////////////////////////////////////
DROP ImageFiles
;

////////////////////////////////////////////////////////////////////////////////
DROP SpecialTermsOfSales
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableProductSegments
;

////////////////////////////////////////////////////////////////////////////////
DROP ProductsWithCharacteristics
;

////////////////////////////////////////////////////////////////////////////////
DROP IndividualPricesGeneral</query>
	</dataSet>
