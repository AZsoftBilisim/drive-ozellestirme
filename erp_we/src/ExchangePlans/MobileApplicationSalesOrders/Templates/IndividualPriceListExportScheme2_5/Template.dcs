	<parameter>
		<name>Node</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Assembly</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مونتاژ</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
