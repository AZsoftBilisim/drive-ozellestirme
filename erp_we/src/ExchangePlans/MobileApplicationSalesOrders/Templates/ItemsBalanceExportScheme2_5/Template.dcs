		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatWarehouses.Ref AS Warehouse
INTO AvailableWarehouses
FROM
	Catalog.Warehouses AS CatWarehouses
WHERE
	NOT CatWarehouses.IsFolder

INDEX BY
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatTypesOfPrices.Ref AS PriceKind
INTO AvailableTypesOfPrices
FROM
	Catalog.TypesOfPrices AS CatTypesOfPrices
WHERE
	CatTypesOfPrices.UseWhileSellingToCustomers

INDEX BY
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductSegments.Ref AS ProductSegment
INTO AvailableProductSegments
FROM
	Catalog.ProductSegments AS ProductSegments

INDEX BY
	ProductSegment
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ItemKinds.Ref AS ProductKind,
	ItemKinds.SettingsOfPriceKeyByItemVariant AS SettingsOfPriceKeyByItemVariant
INTO ItemKinds
FROM
	Catalog.ItemKinds AS ItemKinds
WHERE
	NOT ItemKinds.IsFolder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductsWithCharacteristics.Products AS Products,
	ProductsWithCharacteristics.Characteristic AS Characteristic,
	ProductsWithCharacteristics.PricingVariant AS PricingVariant
INTO ProductsWithCharacteristics
FROM
	(SELECT DISTINCT
		Segments.Products AS Products,
		Segments.Characteristic AS Characteristic,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE Segments.Characteristic.ItemsCharacteristicForPricing
		END AS PricingVariant
	FROM
		InformationRegister.SegmentProducts AS Segments
			INNER JOIN ItemKinds AS ItemKinds
			ON Segments.Products.ProductKind = ItemKinds.ProductKind
	WHERE
		&amp;FilterByProductSegmentIsUsed
		AND Segments.Segment IN
				(SELECT
					AvailableProductSegments.ProductSegment
				FROM
					AvailableProductSegments)
	
	UNION ALL
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems))
				AND ItemsCharacteristics.Owner = Products.Ref
			INNER JOIN ItemKinds AS ItemKinds
			ON (Products.ProductKind = ItemKinds.ProductKind)
	
	UNION
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind))
				AND ItemsCharacteristics.Owner = Products.ProductKind
			INNER JOIN ItemKinds AS ItemKinds
			ON (Products.ProductKind = ItemKinds.ProductKind)
	
	UNION
	
	SELECT
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON (NOT &amp;FilterByProductSegmentIsUsed)
				AND (&amp;UseCharacteristics)
				AND (Products.ProductKind.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
				AND ItemsCharacteristics.Owner = Products.ItemVariantsOwner
			INNER JOIN ItemKinds AS ItemKinds
			ON (Products.ProductKind = ItemKinds.ProductKind)
	
	UNION
	
	SELECT
		Products.Ref,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef),
		VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	FROM
		Catalog.Products AS Products
	WHERE
		NOT &amp;FilterByProductSegmentIsUsed
		AND NOT Products.IsFolder) AS ProductsWithCharacteristics
WHERE
	NOT ProductsWithCharacteristics.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)

INDEX BY
	Products,
	Characteristic,
	PricingVariant
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ProductsWithCharacteristics.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.PricingVariant AS PricingVariant
INTO AvailableProductsWithCharacteristics
FROM
	InformationRegister.ItemsPrices25.SliceLast(
			&amp;Period,
			PriceKind IN
				(SELECT
					AvailableTypesOfPrices.PriceKind
				FROM
					AvailableTypesOfPrices)) AS ItemPricesCrossSectionOfTheLatest
		INNER JOIN ProductsWithCharacteristics AS ProductsWithCharacteristics
		ON (ProductsWithCharacteristics.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (ProductsWithCharacteristics.PricingVariant = ItemPricesCrossSectionOfTheLatest.PricingVariant)

INDEX BY
	Products,
	Characteristic,
	PricingVariant
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Purpose = VALUE(Catalog.Assignments.EmptyRef)
			AND Warehouse IN(
				SELECT
					AvailableWarehouses.Warehouse
				FROM
					AvailableWarehouses)) AS Inventories
;

///////////////////////////////////////////////////////
SELECT
	CAST(Calculation.Products AS Catalog.Products) AS Products,
	Calculation.Characteristic AS Characteristic,
	Calculation.Warehouse AS Warehouse,
	Calculation.QuantityForShipAction AS AvailableForInventoryAllocation
INTO FreeBalancesFromRegisters
FROM
	CalculationOfBalancesForSettingActions AS Calculation
WHERE
	Calculation.QuantityForShipAction &gt; 0
INDEX BY
	Products, Characteristic, Warehouse
;
////////////////////////////////////////////////////////////////////////////////
DROP InventoryAndDemandsBalance;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	FALSE AS Exported,
	WarehouseStockBalance.Products,
	CAST("""" AS STRING(36)) AS ref,
	WarehouseStockBalance.Characteristic,
	WarehouseStockBalance.Warehouse,
	CAST("""" AS STRING(36)) AS WarehouseRef,
	WarehouseStockBalance.AvailableForInventoryAllocation AS AvailableBalance,
	CASE
		WHEN WarehouseStockBalance.AvailableForInventoryAllocation &lt; 1
			THEN 0
		WHEN WarehouseStockBalance.AvailableForInventoryAllocation BETWEEN 1 AND ISNULL(ProductRestrictions.SafetyStockQuantity, 0) / 2
			THEN 1
		WHEN WarehouseStockBalance.AvailableForInventoryAllocation BETWEEN ISNULL(ProductRestrictions.SafetyStockQuantity, 0) / 2 + 0.001 AND ISNULL(ProductRestrictions.SafetyStockQuantity, 0)
			THEN 2
		WHEN WarehouseStockBalance.AvailableForInventoryAllocation BETWEEN ISNULL(ProductRestrictions.SafetyStockQuantity, 0) + 0.001 AND ISNULL(ProductRestrictions.MaximumInventoryAmount, 0)
			THEN 3
		WHEN WarehouseStockBalance.AvailableForInventoryAllocation BETWEEN ISNULL(ProductRestrictions.MaximumInventoryAmount, 0) + 0.001 AND 2 * ISNULL(ProductRestrictions.MaximumInventoryAmount, 0)
			THEN 4
		WHEN WarehouseStockBalance.AvailableForInventoryAllocation &gt; 2 * ISNULL(ProductRestrictions.MaximumInventoryAmount, 0)
			THEN 5
	END AS BalanceStatusIndex
FROM
	FreeBalancesFromRegisters AS WarehouseStockBalance
		INNER JOIN AvailableProductsWithCharacteristics AS ProductsWithCharacteristics
		ON (ProductsWithCharacteristics.Products = WarehouseStockBalance.Products)
			AND (ProductsWithCharacteristics.Characteristic = WarehouseStockBalance.Characteristic)
		LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
		ON &amp;SubstituteGoodsRestriction
WHERE
	WarehouseStockBalance.Products.ItemsType IN(
		VALUE(Enum.ItemsTypes.OwnGoods),
		VALUE(Enum.ItemsTypes.ReusablePackage))
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableWarehouses
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableTypesOfPrices
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableProductSegments
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailableProductsWithCharacteristics
;

////////////////////////////////////////////////////////////////////////////////
DROP ProductsWithCharacteristics
;

////////////////////////////////////////////////////////////////////////////////
DROP ItemKinds
</query>
