		<field xsi:type="DataSetFieldField">
			<dataPath>Organization</dataPath>
			<field>Organization</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CIKinds.Ref AS CIKind
INTO CIKinds
FROM
	Catalog.ContactInformationKinds AS CIKinds
WHERE
	NOT CIKinds.IsFolder
	AND NOT CIKinds.Ref = VALUE(Catalog.ContactInformationKinds.OtherInformationOfCompany)
	AND (CIKinds.Ref IN HIERARCHY (VALUE(Catalog.ContactInformationKinds.CatalogWarehouses))
			OR CIKinds.Ref IN HIERARCHY (VALUE(Catalog.ContactInformationKinds.CatalogPartners))
			OR CIKinds.Ref IN HIERARCHY (VALUE(Catalog.ContactInformationKinds.CatalogContactPersonsForPartners))
			OR CIKinds.Ref IN HIERARCHY (VALUE(Catalog.ContactInformationKinds.CatalogCompanies)))
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatCurrencies.Ref AS Currency
INTO Currencies
FROM
	Catalog.Currencies AS CatCurrencies
WHERE
	CatCurrencies.Ref = &amp;Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatTypesOfPrices.Ref AS PriceKind
INTO TypesOfPrices
FROM
	Catalog.TypesOfPrices AS CatTypesOfPrices
WHERE
	CatTypesOfPrices.UseWhileSellingToCustomers
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatWarehouses.Ref AS Warehouse
INTO Warehouses
FROM
	Catalog.Warehouses AS CatWarehouses
WHERE
	NOT CatWarehouses.IsFolder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatCompanies.Ref AS Organization
INTO Companies
FROM
	Catalog.Companies AS CatCompanies
WHERE
	CASE
			WHEN &amp;ManagementCompanyNotUsed
				THEN NOT CatCompanies.Predefined
			ELSE TRUE
		END
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CatCountries.Ref AS Country
INTO Countries
FROM
	Catalog.WorldCountries AS CatCountries
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatEd.Ref AS WeightUnit
INTO UnitsOfMeasurement
FROM
	Catalog.PackagesAndUnitsOfMeasure AS CatEd
WHERE
	CatEd.Ref = &amp;WeightUnit
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Catalogs.PriceTypeReference AS PriceTypeReference,
	Catalogs.Organization AS CompanyLink,
	Catalogs.Warehouse AS WarehouseReference,
	Catalogs.Currency AS CurrencyRef,
	Catalogs.Country AS CountryRef,
	Catalogs.CIKind AS CIKindReference,
	Catalogs.WeightUnit AS WeightUnitLink
INTO TemporaryCatalogues
FROM
	(SELECT
		CatTypesOfPrices.PriceKind AS PriceTypeReference,
		NULL AS Organization,
		NULL AS Warehouse,
		NULL AS Currency,
		NULL AS Country,
		NULL AS CIKind,
		NULL AS WeightUnit
	FROM
		TypesOfPrices AS CatTypesOfPrices
	
	UNION ALL
	
	SELECT
		NULL,
		CatCompanies.Organization,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL
	FROM
		Companies AS CatCompanies
	
	UNION ALL
	
	SELECT
		NULL,
		NULL,
		NULL,
		CatCurrencies.Currency,
		NULL,
		NULL,
		NULL
	FROM
		Currencies AS CatCurrencies
	
	UNION ALL
	
	SELECT
		NULL,
		NULL,
		CatWarehouses.Warehouse,
		NULL,
		NULL,
		NULL,
		NULL
	FROM
		Warehouses AS CatWarehouses
	
	UNION ALL
	
	SELECT
		NULL,
		NULL,
		NULL,
		NULL,
		CatCountries.Country,
		NULL,
		NULL
	FROM
		Countries AS CatCountries
	
	UNION ALL
	
	SELECT
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		CatCIKind.CIKind,
		NULL
	FROM
		CIKinds AS CatCIKind
	
	UNION ALL
	
	SELECT
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		CatUnitsOfMeasurement.WeightUnit
	FROM
		UnitsOfMeasurement AS CatUnitsOfMeasurement) AS Catalogs
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Catalogs.CurrencyRef AS CurrencyRef,
	Catalogs.CurrencyRef.DeletionMark AS CurrencyDeletionMark,
	Catalogs.CurrencyRef.Description AS CurrencyName,
	Catalogs.CurrencyRef.Code AS CurrencyCode,
	Catalogs.CompanyLink AS CompanyLink,
	Catalogs.CompanyLink.DeletionMark AS OrganizationDeletionMark,
	Catalogs.CompanyLink.Description AS CompanyName,
	Catalogs.CompanyLink.Prefix AS Company_Prefix,
	Catalogs.CompanyLink.TIN AS CompanyTIN,
	Catalogs.CompanyLink.CRTR AS CompanyCRTR,
	Catalogs.CompanyLink.LegalEntityIndividual AS CompanyLegalEntityIndividual,
	Catalogs.CompanyLink.DescriptionFull AS FullCompanyName,
	Catalogs.CompanyLink.SeriesAndNumber AS CompanyCertificateSeriesNumber,
	Catalogs.CompanyLink.SertificateDateOfIssue AS CompanyCertificateIssueDate,
	ISNULL(TaxationSystemSettings.TaxationSystem, &amp;IsBlankString) AS CompanyTaxationSystemReference,
	Catalogs.PriceTypeReference AS PriceTypeReference,
	Catalogs.PriceTypeReference.DeletionMark AS PriceKindDeletionMark,
	Catalogs.PriceTypeReference.Description AS PriceTypeName,
	Catalogs.PriceTypeReference.PriceCurrency AS PriceTypePriceCurrency,
	Catalogs.PriceTypeReference.PriceIncludesVAT AS PriceTypePriceIncludingVAT,
	Catalogs.WarehouseReference AS WarehouseReference,
	Catalogs.WarehouseReference.IsFolder AS WarehouseIsGroup,
	Catalogs.WarehouseReference.DeletionMark AS WarehouseDeletionMark,
	Catalogs.WarehouseReference.Description AS WarehouseName,
	Catalogs.WarehouseReference.Parent AS WarehouseParentReference,
	Catalogs.WarehouseReference.Parent.IsFolder AS WarehouseParentIsGroup,
	Catalogs.WarehouseReference.Parent.DeletionMark AS WarehouseParentDeletionMark,
	Catalogs.WarehouseReference.Parent.Description AS WarehouseParentName,
	Catalogs.CountryRef AS CountryRef,
	Catalogs.CountryRef.DeletionMark AS CountryDeletionMark,
	Catalogs.CountryRef.Description AS CountryName,
	Catalogs.CountryRef.Code AS CountryCode_,
	Catalogs.CountryRef.PredefinedDataName AS CountryPredefinedDataName,
	Catalogs.CountryRef.DescriptionFull AS CountryFullName,
	Catalogs.CountryRef.CodeAlpha2 AS CountryCodeAlpha2,
	Catalogs.CountryRef.CodeAlpha3 AS CountryCodeAlpha3,
	Catalogs.CIKindReference AS CIKindReference,
	Catalogs.CIKindReference.DeletionMark AS CIKindDeletionMark,
	Catalogs.CIKindReference.Parent AS CIKindParent,
	Catalogs.CIKindReference.IsFolder AS CIKindThisIsAGroup,
	Catalogs.CIKindReference.Description AS CIKindDescription,
	Catalogs.CIKindReference.Type AS CIKindType,
	Catalogs.CIKindReference.AddlOrderingAttribute AS CIKindAdditionalSortingAttribute,
	Catalogs.CIKindReference.EditingOption = "Dialog" AS ViewEditingOnlyInDialog,
	Catalogs.CIKindReference.CanChangeEditMethod AS CIKindYouCanChangeEditingMethod,
	Catalogs.CIKindReference.OnlyNationalAddress AS CIKindAddressOnlyRussia,
	Catalogs.CIKindReference.IncludeCountryInPresentation AS CIKindIncludeCountryInPresentation,
	Catalogs.CIKindReference.Mandatory AS CIKindMandatoryFilling,
	Catalogs.CIKindReference.CheckValidity AS CIKindCheckAccuracy,
	Catalogs.CIKindReference.HideObsoleteAddresses AS CIKindHideInvalidAddresses,
	"""" AS CIKindTooltip,
	Catalogs.CIKindReference.AllowMultipleValueInput AS CIKindAllowToEnterSeveralValues,
	Catalogs.CIKindReference.PredefinedDataName AS CIKindPredefinedDataName,
	Catalogs.WeightUnitLink AS WeightUnitLink,
	Catalogs.WeightUnitLink.DeletionMark AS WeightUnitDeletionMark,
	Catalogs.WeightUnitLink.Code AS WeightUnitCode,
	Catalogs.WeightUnitLink.Description AS WeightUnitName,
	Catalogs.WeightUnitLink.PredefinedDataName AS WeightUnitPredefinedDataName,
	Catalogs.WeightUnitLink.DescriptionFull AS WeightUnitFullName,
	Catalogs.WeightUnitLink.InternationalAbbreviation AS WeightUnitInternationalAbbreviation
FROM
	TemporaryCatalogues AS Catalogs
		LEFT JOIN Catalog.Companies AS CatCompanies
		ON CatCompanies.Ref = Catalogs.CompanyLink
		LEFT JOIN InformationRegister.TaxationSystemSettings.SliceLast(&amp;Period, ) AS TaxationSystemSettings
		ON (TaxationSystemSettings.Organization = CatCompanies.ParentCompany)
;

////////////////////////////////////////////////////////////////////////////////
DROP Currencies
;

////////////////////////////////////////////////////////////////////////////////
DROP TypesOfPrices
;

////////////////////////////////////////////////////////////////////////////////
DROP Companies
;

////////////////////////////////////////////////////////////////////////////////
DROP Warehouses
;

////////////////////////////////////////////////////////////////////////////////
DROP Countries
;

////////////////////////////////////////////////////////////////////////////////
DROP CIKinds
;

////////////////////////////////////////////////////////////////////////////////
DROP UnitsOfMeasurement
;

////////////////////////////////////////////////////////////////////////////////
DROP TemporaryCatalogues</query>
