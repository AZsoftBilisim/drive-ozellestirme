		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TypesOfPrices.Ref AS PriceKind,
	ProductSegments.Ref AS ProductSegment,
	CustomersTermsOfSales.Ref AS Terms,
	Companies.Ref AS Organization,
	PartnersSegments.Ref AS PartnersSegment,
	Warehouses.Ref AS Warehouse,
	FALSE AS UsePowerOfAttorneyToRegisterPayment,
	FALSE AS UseICOToRegisterPayment,
	FALSE AS UseWeightCharacteristics,
	FALSE AS TransmitProductImages,
	FALSE AS DoNotDisplayBalanceWhenSelecting,
	Users.Ref AS Supervisor_,
	CashAccounts.Ref AS CashAccount,
	CFItemsCash.Ref AS ArticleDDSCash,
	POSTerminals.Ref AS POSTerminal,
	ArticlesOfDDSAcquiring.Ref AS ArticleDDSAcquiring
FROM
	Catalog.ProductSegments AS ProductSegments,
	Catalog.TermsOfSale AS CustomersTermsOfSales,
	Catalog.Warehouses AS Warehouses,
	Catalog.PartnersSegments AS PartnersSegments,
	Catalog.Companies AS Companies,
	Catalog.TypesOfPrices AS TypesOfPrices,
	Catalog.Users AS Users,
	Catalog.CashAccounts AS CashAccounts,
	Catalog.CashFlowReportItems AS CFItemsCash,
	Catalog.POSTerminals AS POSTerminals,
	Catalog.CashFlowReportItems AS ArticlesOfDDSAcquiring</query>
	</dataSet>
