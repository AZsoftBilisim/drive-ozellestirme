		<field xsi:type="DataSetFieldField">
			<dataPath>ContractDeletionRequired</dataPath>
			<field>ContractDeletionRequired</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Delete contract</v8:content>
				</v8:item>
