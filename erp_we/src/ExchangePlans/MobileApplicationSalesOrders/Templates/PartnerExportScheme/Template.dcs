		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	MyPartnersChanges.Ref AS AvailablePartner
INTO PermittedPartners
FROM
	Catalog.Partners.Changes AS MyPartnersChanges
WHERE
	VALUETYPE(MyPartnersChanges.Node) = TYPE(ExchangePlan.MobileApplicationSalesOrders)
	AND MyPartnersChanges.Node = &amp;Node
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	PartnersSegments.Ref AS PartnersSegment
INTO AvailablePartnerSegments
FROM
	Catalog.PartnersSegments AS PartnersSegments

INDEX BY
	PartnersSegment
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SelectionPartners.Partner AS Partner,
	SelectionPartners.PartnerSegment AS PartnerSegment
INTO SelectionPartners
FROM
	(SELECT DISTINCT
		Segments.Partner AS Partner,
		Segments.Segment AS PartnerSegment
	FROM
		InformationRegister.SegmentPartners AS Segments
	WHERE
		&amp;FilterByPartnerSegmentIsUsed
		AND Segments.Segment IN
				(SELECT
					AvailablePartnerSegments.PartnersSegment
				FROM
					AvailablePartnerSegments)
	
	UNION ALL
	
	SELECT
		Partners.Ref,
		""
	FROM
		Catalog.Partners AS Partners
	WHERE
		NOT &amp;FilterByPartnerSegmentIsUsed) AS SelectionPartners
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	PartnersChanges.Ref AS PartnerForExport,
	SelectionPartners.PartnerSegment AS PartnerSegment,
	Counterparties.Ref AS Counterparty,
	CASE
		WHEN PermittedPartners.AvailablePartner IS NULL
			THEN TRUE
		WHEN PartnersChanges.Ref.LegalEntityIndividual IS NULL
			THEN TRUE
		ELSE FALSE
	END AS DeletionRequired1
INTO AvailablePartners
FROM
	Catalog.Partners.Changes AS PartnersChanges
		LEFT JOIN PermittedPartners AS PermittedPartners
		ON (PermittedPartners.AvailablePartner = PartnersChanges.Ref)
		INNER JOIN InformationRegister.PartnerHierarchy AS PartnerHierarchy
			INNER JOIN Catalog.Counterparties AS Counterparties
			ON PartnerHierarchy.Parent = Counterparties.Partner
		ON (PartnerHierarchy.Partner = PartnersChanges.Ref)
		INNER JOIN SelectionPartners AS SelectionPartners
		ON PartnersChanges.Ref = SelectionPartners.Partner
WHERE
	VALUETYPE(PartnersChanges.Node) = TYPE(ExchangePlan.MobileApplicationSalesOrders)
	AND PartnersChanges.Node = &amp;Node

INDEX BY
	PartnersChanges.Ref,
	Counterparties.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	MIN(SalesOrder.Partner) AS Partner,
	COUNT(DISTINCT SalesOrder.Warehouse) AS WarehouseOptions,
	MIN(SalesOrder.Warehouse) AS Warehouse,
	COUNT(DISTINCT SalesOrder.PaymentMethod) AS PaymentFormOptions,
	MIN(SalesOrder.PaymentMethod) AS PaymentMethod,
	COUNT(DISTINCT SalesOrder.DeliveryMethod) AS DeliveryMethodOptions,
	MIN(SalesOrder.DeliveryMethod) AS DeliveryMethod,
	MIN(SalesOrder.DeliveryTimeFrom) AS DeliveryTimeFrom,
	MAX(SalesOrder.DeliveryTimeTo) AS DeliveryTimeTo,
	COUNT(DISTINCT CAST(SalesOrder.AdditionalDeliveryInformation AS STRING(500))) AS OptionsForAdditionalInformation,
	MIN(CAST(SalesOrder.AdditionalDeliveryInformation AS STRING(500))) AS AdditionalDeliveryInformation
INTO SalesOrders
FROM
	Document.SalesOrder AS SalesOrder
		INNER JOIN AvailablePartners AS AvailablePartners
		ON (AvailablePartners.PartnerForExport = SalesOrder.Partner)
			AND (NOT AvailablePartners.DeletionRequired1)
WHERE
	SalesOrder.Status = VALUE(Enum.SalesOrderStatuses.Closed)
	AND SalesOrder.Date BETWEEN BEGINOFPERIOD(DATEADD(&amp;Period, MONTH, -2), MONTH) AND &amp;Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SalesOrder.Partner AS Partner,
	CASE
		WHEN SalesOrder.WarehouseOptions &gt; 1
			THEN &amp;IsBlankString
		ELSE SalesOrder.Warehouse
	END AS Warehouse,
	CASE
		WHEN SalesOrder.PaymentFormOptions &gt; 1
			THEN VALUE(Enum.PaymentForms.EmptyRef)
		ELSE SalesOrder.PaymentMethod
	END AS PaymentMethod,
	CASE
		WHEN SalesOrder.DeliveryMethodOptions &gt; 1
			THEN VALUE(Enum.TransportMethods.SelfPickup)
		ELSE SalesOrder.DeliveryMethod
	END AS DeliveryMethod,
	SalesOrder.DeliveryTimeFrom AS DeliveryTimeFrom,
	SalesOrder.DeliveryTimeTo AS DeliveryTimeTo,
	CASE
		WHEN SalesOrder.OptionsForAdditionalInformation &gt; 1
			THEN &amp;IsBlankString
		ELSE SalesOrder.AdditionalDeliveryInformation
	END AS AdditionalDeliveryInformation
INTO InformationByOrders
FROM
	SalesOrders AS SalesOrder

INDEX BY
	Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	SegmentPartners.Partner AS Partner
INTO PartnersShipmentIsProhibited
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
		INNER JOIN AvailablePartners AS AvailablePartners
		ON (AvailablePartners.PartnerForExport = SegmentPartners.Partner)
			AND (NOT AvailablePartners.DeletionRequired1)
WHERE
	SegmentPartners.Segment.SegmentIsUsedToProhibitShipment
	AND NOT SegmentPartners.Segment.IsFolder
	AND NOT SegmentPartners.Segment.DeletionMark

INDEX BY
	SegmentPartners.Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Partners.Ref AS PartnerLink,
	CAST("" AS STRING(36)) AS Ref,
	Partners.DeletionMark AS DeletionMark,
	Partners.Parent AS ParentReference,
	CAST("" AS STRING(36)) AS Parent,
	Partners.Code AS Code,
	Partners.Description AS Description,
	CAST("" AS STRING(36)) AS ERPCode,
	"" AS PartnerPriceType,
	ISNULL(InformationByOrders.DeliveryTimeTo, DATETIME(1, 1, 1)) AS DeliveryTimeTo,
	ISNULL(InformationByOrders.DeliveryTimeFrom, DATETIME(1, 1, 1)) AS DeliveryTimeFrom,
	ISNULL(InformationByOrders.AdditionalDeliveryInformation, CAST(Partners.Comment AS STRING(500))) AS AdditionalDeliveryInformation,
	Partners.DeletionMark
		OR CASE
			WHEN &amp;UseShipmentProhibition
				THEN CASE
						WHEN PartnersShipmentIsProhibited.Partner IS NULL
							THEN FALSE
						ELSE TRUE
					END
			ELSE FALSE
		END AS ShipmentIsProhibited,
	CASE
		WHEN Partners.DeletionMark
			THEN &amp;TextPartnerDeletionMark
		WHEN &amp;UseShipmentProhibition
			THEN CASE
					WHEN PartnersShipmentIsProhibited.Partner IS NULL
						THEN &amp;IsBlankString
					ELSE &amp;TextSegmentShipmentProhibited
				END
		ELSE &amp;IsBlankString
	END AS ReasonForAddingToStopList,
	CASE
		WHEN ISNULL(InformationByOrders.DeliveryMethod, VALUE(Enum.TransportMethods.SelfPickup)) = VALUE(Enum.TransportMethods.SelfPickup)
			THEN TRUE
		ELSE FALSE
	END AS SelfPickup,
	ISNULL(InformationByOrders.Warehouse, "") AS WarehouseReference,
	CAST("" AS STRING(36)) AS Warehouse,
	"" AS SearchString,
	ISNULL(InformationByOrders.PaymentMethod, &amp;IsBlankString) AS PaymentFormLink
INTO PartnerInformation_
FROM
	Catalog.Partners AS Partners
		INNER JOIN AvailablePartners AS AvailablePartners
		ON (AvailablePartners.PartnerForExport = Partners.Ref)
			AND (NOT AvailablePartners.DeletionRequired1)
		LEFT JOIN InformationByOrders AS InformationByOrders
		ON (InformationByOrders.Partner = Partners.Ref)
		LEFT JOIN PartnersShipmentIsProhibited AS PartnersShipmentIsProhibited
		ON (&amp;UseShipmentProhibition)
			AND (PartnersShipmentIsProhibited.Partner = Partners.Ref)
WHERE
	Partners.Client

INDEX BY
	PartnerLink
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TermsOfSaleGoods.Ref AS Ref,
	MAX(TermsOfSaleGoods.LineNumber) AS MaximumProductLineNumber
INTO AgreementsProducts
FROM
	Catalog.TermsOfSale.Goods AS TermsOfSaleGoods

GROUP BY
	TermsOfSaleGoods.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TermsOfSalePriceGroups.Ref AS Ref,
	MAX(TermsOfSalePriceGroups.LineNumber) AS MaximumRowNumberOfPriceGroups
INTO AgreementsPriceGroups
FROM
	Catalog.TermsOfSale.PriceGroups AS TermsOfSalePriceGroups

GROUP BY
	TermsOfSalePriceGroups.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Partners.PartnerForExport AS Partner,
	Partners.PartnerSegment AS Segment,
	Companies.Ref AS Organization,
	TypesOfPrices.Ref AS PriceKind,
	TypesOfPrices.DeletionMark AS PriceKindDeletionMark,
	TypesOfPrices.Description AS PriceTypeName,
	TypesOfPrices.PriceIncludesVAT AS PriceTypePriceIncludingVAT,
	CustomerAgreementsSales.Ref AS Terms,
	ISNULL(Contracts.Ref, VALUE(Catalog.CounterpartyContracts.EmptyRef)) AS Contract,
	ISNULL(Contracts.DeletionMark, TRUE) AS ContractDeletionMark,
	ISNULL(Contracts.Description, """") AS ContractName_,
	ISNULL(Contracts.Date, DATETIME(1, 1, 1)) AS ContractDate,
	ISNULL(Contracts.Number, """") AS ContractNumber_,
	ISNULL(CASE
			WHEN Contracts.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
				THEN TRUE
			ELSE FALSE
		END, FALSE) AS SettlementsUnderContract,
	Counterparties.Ref AS Counterparty,
	ComplianceWithSalesConditions_.SalesConditionID AS SalesConditionID,
	CustomerAgreementsSales.ContractsAreUsed AS ContractsAreUsed,
	CustomerAgreementsSales.DeletionMark AS DeletionMark,
	CustomerAgreementsSales.Description AS Description,
	CustomerAgreementsSales.Date AS Date,
	CASE
		WHEN CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
			THEN TRUE
		ELSE FALSE
	END AS Fee,
	CustomerAgreementsSales.Number AS Number,
	CustomerAgreementsSales.Warehouse AS Warehouse,
	CustomerAgreementsSales.Standard_ AS Standard_,
	CustomerAgreementsSales.ProductSegment AS ProductSegment,
	CASE
			WHEN CustomerAgreementsSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
				THEN TRUE
			ELSE FALSE
		END
		AND CASE
			WHEN CustomerAgreementsSales.ValidityStartDate = DATETIME(1, 1, 1)
					OR NOT CustomerAgreementsSales.ValidityStartDate &gt; &amp;Period
				THEN TRUE
			ELSE FALSE
		END
		AND CASE
			WHEN CustomerAgreementsSales.ValidityEndDate = DATETIME(1, 1, 1)
					OR NOT CustomerAgreementsSales.ValidityEndDate &lt; &amp;Period
				THEN TRUE
			ELSE FALSE
		END
		AND CustomerAgreementsSales.Approved
		AND CASE
			WHEN Contracts.Ref IS NULL
				THEN TRUE
			ELSE Contracts.Approved
		END
		AND CASE
			WHEN Contracts.Ref IS NULL
				THEN TRUE
			ELSE CASE
					WHEN NOT Contracts.DeletionMark
							AND Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
						THEN TRUE
					ELSE FALSE
				END
		END AS Valid,
	CASE
		WHEN ISNULL(AgreementGoods.MaximumProductLineNumber, 0) &gt; 0
			THEN TRUE
		ELSE CASE
				WHEN ISNULL(AgreementPriceGroups.MaximumRowNumberOfPriceGroups, 0) &gt; 0
					THEN TRUE
				ELSE FALSE
			END
	END AS ThereIsPriceSpecification,
	ISNULL(CustomersARAPAccountingBalance.SumBalance + CustomersARAPAccountingBalance.BeingShippedBalance, 0) AS DebtAmountUnderTheContract,
	CASE
		WHEN Contracts.Ref IS NULL
		THEN FALSE
		ELSE Contracts.Partner = Partners.PartnerForExport.Parent 
			AND NOT Contracts.ItIsAllowedToWorkWithSubsidiaryPartners
	END AS ContractDeletionRequired
	
INTO SalesTermsAndConditions
FROM
	Catalog.TermsOfSale AS CustomerAgreementsSales
		INNER JOIN AvailablePartners AS Partners
		ON (Partners.PartnerForExport.Client)
			AND (CASE
				WHEN CustomerAgreementsSales.Standard_
					THEN TRUE
				ELSE CustomerAgreementsSales.Partner = Partners.PartnerForExport
			END)
		INNER JOIN InformationRegister.SegmentPartners AS PartnersOfAgreement
		ON (PartnersOfAgreement.Partner = Partners.PartnerForExport)
			AND (CASE
				WHEN NOT CustomerAgreementsSales.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
					THEN CustomerAgreementsSales.PartnersSegment = PartnersOfAgreement.Segment
				ELSE TRUE
			END)
		INNER JOIN InformationRegister.PartnerHierarchy AS PartnerHierarchy
			INNER JOIN Catalog.Counterparties AS Counterparties
			ON PartnerHierarchy.Parent = Counterparties.Partner
		ON (PartnerHierarchy.Partner = Partners.PartnerForExport)
		INNER JOIN Catalog.Companies AS Companies
		ON (CASE
				WHEN CustomerAgreementsSales.Organization = VALUE(Catalog.Companies.EmptyRef)
					THEN TRUE
				ELSE CustomerAgreementsSales.Organization = Companies.Ref
			END)
			AND (CASE
				WHEN &amp;ManagementCompanyNotUsed
					THEN NOT Companies.Predefined
				ELSE TRUE
			END)
		INNER JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (CASE
				WHEN CustomerAgreementsSales.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
					THEN TRUE
				ELSE CustomerAgreementsSales.PricesKind = TypesOfPrices.Ref
			END)
			AND CustomerAgreementsSales.PriceIncludesVAT = TypesOfPrices.PriceIncludesVAT
		LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON (Contracts.Counterparty = Counterparties.Ref)
			AND (Contracts.Partner = Partners.PartnerForExport
				OR Contracts.Partner = Partners.PartnerForExport.Parent)
			AND (Contracts.Organization = Companies.Ref)
			AND CustomerAgreementsSales.Currency = Contracts.ARAPCurrency
			AND (CustomerAgreementsSales.ContractsAreUsed)
			AND CustomerAgreementsSales.BusinessOperation = Contracts.BusinessOperation
		LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(
				,
				AccountingDimensionByPartners IN
					(SELECT
						DimensionByPartners.DimensionKey AS DimensionKey
					FROM
						InformationRegister.AccountingDimensionByPartners AS DimensionByPartners)) AS CustomersARAPAccountingBalance
		ON (CustomersARAPAccountingBalance.AccountingDimensionByPartners.Contract = Contracts.Ref)
		LEFT JOIN InformationRegister.ComplianceOfSalesTermsAndConditionsOf1COrdersMobileApplication AS ComplianceWithSalesConditions_
		ON (ComplianceWithSalesConditions_.Organization = Companies.Ref)
			AND (ComplianceWithSalesConditions_.PriceKind = TypesOfPrices.Ref)
			AND (ComplianceWithSalesConditions_.Partner = Partners.PartnerForExport)
			AND (ComplianceWithSalesConditions_.Terms = CustomerAgreementsSales.Ref)
			AND (ComplianceWithSalesConditions_.Counterparty = ISNULL(Counterparties.Ref, VALUE(Catalog.Counterparties.EmptyRef)))
			AND (ComplianceWithSalesConditions_.Contract = ISNULL(Contracts.Ref, VALUE(Catalog.CounterpartyContracts.EmptyRef)))
		LEFT JOIN AgreementsProducts AS AgreementGoods
		ON (AgreementGoods.Ref = CustomerAgreementsSales.Ref)
		LEFT JOIN AgreementsPriceGroups AS AgreementPriceGroups
		ON (AgreementPriceGroups.Ref = CustomerAgreementsSales.Ref)
WHERE
	CustomerAgreementsSales.Currency = &amp;Currency
	AND &amp;PartnerSegmentsAreUsed
	AND TypesOfPrices.UseWhileSellingToCustomers
	AND (CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			OR CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent))
	AND CASE
			WHEN &amp;AgreementUsage = VALUE(Enum.UseTermsOfSales.OnlyStandardTermsOfSales)
				THEN CustomerAgreementsSales.Standard_
			ELSE CASE
					WHEN &amp;AgreementUsage = VALUE(Enum.UseTermsOfSales.OnlySpecialTermsOfSales)
						THEN NOT CustomerAgreementsSales.Standard_
					ELSE TRUE
				END
		END
	AND CASE
			WHEN CustomerAgreementsSales.ContractsAreUsed
				THEN Contracts.Ref IS NOT NULL 
			ELSE TRUE
		END

UNION ALL

SELECT
	Partners.PartnerForExport,
	Partners.PartnerSegment,
	Companies.Ref,
	TypesOfPrices.Ref,
	TypesOfPrices.DeletionMark,
	TypesOfPrices.Description,
	TypesOfPrices.PriceIncludesVAT,
	CustomerAgreementsSales.Ref,
	ISNULL(Contracts.Ref, VALUE(Catalog.CounterpartyContracts.EmptyRef)),
	ISNULL(Contracts.DeletionMark, TRUE),
	ISNULL(Contracts.Description, """"),
	ISNULL(Contracts.Date, DATETIME(1, 1, 1)),
	ISNULL(Contracts.Number, """"),
	ISNULL(CASE
			WHEN Contracts.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
				THEN TRUE
			ELSE FALSE
		END, FALSE),
	Counterparties.Ref,
	ComplianceWithSalesConditions_.SalesConditionID,
	CustomerAgreementsSales.ContractsAreUsed,
	CustomerAgreementsSales.DeletionMark,
	CustomerAgreementsSales.Description,
	CustomerAgreementsSales.Date,
	CASE
		WHEN CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
			THEN TRUE
		ELSE FALSE
	END,
	CustomerAgreementsSales.Number,
	CustomerAgreementsSales.Warehouse,
	CustomerAgreementsSales.Standard_,
	CustomerAgreementsSales.ProductSegment,
	CASE
			WHEN CustomerAgreementsSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
				THEN TRUE
			ELSE FALSE
		END
		AND CASE
			WHEN CustomerAgreementsSales.ValidityStartDate = DATETIME(1, 1, 1)
					OR NOT CustomerAgreementsSales.ValidityStartDate &gt; &amp;Period
				THEN TRUE
			ELSE FALSE
		END
		AND CASE
			WHEN CustomerAgreementsSales.ValidityEndDate = DATETIME(1, 1, 1)
					OR NOT CustomerAgreementsSales.ValidityEndDate &lt; &amp;Period
				THEN TRUE
			ELSE FALSE
		END
		AND CustomerAgreementsSales.Approved
		AND CASE
			WHEN Contracts.Ref IS NULL
				THEN TRUE
			ELSE Contracts.Approved
		END
		AND CASE
			WHEN Contracts.Ref IS NULL
				THEN TRUE
			ELSE CASE
					WHEN NOT Contracts.DeletionMark
							AND Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
						THEN TRUE
					ELSE FALSE
				END
		END,
	CASE
		WHEN ISNULL(AgreementGoods.MaximumProductLineNumber, 0) &gt; 0
			THEN TRUE
		ELSE CASE
				WHEN ISNULL(AgreementPriceGroups.MaximumRowNumberOfPriceGroups, 0) &gt; 0
					THEN TRUE
				ELSE FALSE
			END
	END,
	ISNULL(CustomersARAPAccountingBalance.SumBalance + CustomersARAPAccountingBalance.BeingShippedBalance, 0),
	CASE
		WHEN Contracts.Ref IS NULL
		THEN FALSE
		ELSE Contracts.Partner = Partners.PartnerForExport.Parent 
			AND NOT Contracts.ItIsAllowedToWorkWithSubsidiaryPartners
	END AS ContractDeletionRequired
	
FROM
	Catalog.TermsOfSale AS CustomerAgreementsSales
		INNER JOIN AvailablePartners AS Partners
		ON (Partners.PartnerForExport.Client)
			AND (CASE
				WHEN CustomerAgreementsSales.Standard_
					THEN TRUE
				ELSE CustomerAgreementsSales.Partner = Partners.PartnerForExport
			END)
		INNER JOIN InformationRegister.PartnerHierarchy AS PartnerHierarchy
			INNER JOIN Catalog.Counterparties AS Counterparties
			ON PartnerHierarchy.Parent = Counterparties.Partner
		ON (PartnerHierarchy.Partner = Partners.PartnerForExport)
		INNER JOIN Catalog.Companies AS Companies
		ON (CASE
				WHEN CustomerAgreementsSales.Organization = VALUE(Catalog.Companies.EmptyRef)
					THEN TRUE
				ELSE CustomerAgreementsSales.Organization = Companies.Ref
			END)
			AND (CASE
				WHEN &amp;ManagementCompanyNotUsed
					THEN NOT Companies.Predefined
				ELSE TRUE
			END)
		INNER JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (CASE
				WHEN CustomerAgreementsSales.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
					THEN TRUE
				ELSE CustomerAgreementsSales.PricesKind = TypesOfPrices.Ref
			END)
			AND CustomerAgreementsSales.PriceIncludesVAT = TypesOfPrices.PriceIncludesVAT
		LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON (Contracts.Counterparty = Counterparties.Ref)
			AND (Contracts.Partner = Partners.PartnerForExport
				OR Contracts.Partner = Partners.PartnerForExport.Parent)
			AND (Contracts.Organization = Companies.Ref)
			AND CustomerAgreementsSales.Currency = Contracts.ARAPCurrency
			AND (CustomerAgreementsSales.ContractsAreUsed)
			AND CustomerAgreementsSales.BusinessOperation = Contracts.BusinessOperation
		LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(
				,
				AccountingDimensionByPartners IN
					(SELECT
						DimensionByPartners.DimensionKey AS DimensionKey
					FROM
						InformationRegister.AccountingDimensionByPartners AS DimensionByPartners)) AS CustomersARAPAccountingBalance
		ON (CustomersARAPAccountingBalance.AccountingDimensionByPartners.Contract = Contracts.Ref)
		LEFT JOIN InformationRegister.ComplianceOfSalesTermsAndConditionsOf1COrdersMobileApplication AS ComplianceWithSalesConditions_
		ON (ComplianceWithSalesConditions_.Organization = Companies.Ref)
			AND (ComplianceWithSalesConditions_.PriceKind = TypesOfPrices.Ref)
			AND (ComplianceWithSalesConditions_.Partner = Partners.PartnerForExport)
			AND (ComplianceWithSalesConditions_.Terms = CustomerAgreementsSales.Ref)
			AND (ComplianceWithSalesConditions_.Counterparty = ISNULL(Counterparties.Ref, VALUE(Catalog.Counterparties.EmptyRef)))
			AND (ComplianceWithSalesConditions_.Contract = ISNULL(Contracts.Ref, VALUE(Catalog.CounterpartyContracts.EmptyRef)))
		LEFT JOIN AgreementsProducts AS AgreementGoods
		ON (AgreementGoods.Ref = CustomerAgreementsSales.Ref)
		LEFT JOIN AgreementsPriceGroups AS AgreementPriceGroups
		ON (AgreementPriceGroups.Ref = CustomerAgreementsSales.Ref)
WHERE
	CustomerAgreementsSales.Currency = &amp;Currency
	AND NOT &amp;PartnerSegmentsAreUsed
	AND TypesOfPrices.UseWhileSellingToCustomers
	AND (CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			OR CustomerAgreementsSales.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent))
	AND CASE
			WHEN &amp;AgreementUsage = VALUE(Enum.UseTermsOfSales.OnlyStandardTermsOfSales)
				THEN CustomerAgreementsSales.Standard_
			ELSE CASE
					WHEN &amp;AgreementUsage = VALUE(Enum.UseTermsOfSales.OnlySpecialTermsOfSales)
						THEN NOT CustomerAgreementsSales.Standard_
					ELSE TRUE
				END
		END
	AND CASE
			WHEN CustomerAgreementsSales.ContractsAreUsed
				THEN Contracts.Ref IS NOT NULL 
			ELSE TRUE
		END

UNION ALL

SELECT
	Partners.PartnerForExport,
	Partners.PartnerSegment,
	Companies.Ref,
	TypesOfPrices.Ref,
	TypesOfPrices.DeletionMark,
	TypesOfPrices.Description,
	TypesOfPrices.PriceIncludesVAT,
	VALUE(Catalog.TermsOfSale.EmptyRef),
	ISNULL(Contracts.Ref, VALUE(Catalog.CounterpartyContracts.EmptyRef)),
	ISNULL(Contracts.DeletionMark, TRUE),
	ISNULL(Contracts.Description, """"),
	ISNULL(Contracts.Date, DATETIME(1, 1, 1)),
	ISNULL(Contracts.Number, """"),
	ISNULL(CASE
			WHEN Contracts.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
				THEN TRUE
			ELSE FALSE
		END, FALSE),
	Counterparties.Ref,
	ComplianceWithSalesConditions_.SalesConditionID,
	&amp;ContractsAreUsed,
	FALSE,
	ISNULL(Contracts.Description, &amp;StandardContractName),
	DATETIME(1, 1, 1),
	CASE
		WHEN Contracts.Ref IS NULL
			THEN FALSE
		ELSE Contracts.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
	END,
	"""",
	VALUE(Catalog.Warehouses.EmptyRef),
	TRUE,
	VALUE(Catalog.ProductSegments.EmptyRef),
	TRUE,
	FALSE,
	ISNULL(CustomersARAPAccountingBalance.SumBalance + CustomersARAPAccountingBalance.BeingShippedBalance, 0),
	CASE
		WHEN Contracts.Ref IS NULL
		THEN FALSE
		ELSE Contracts.Partner = Partners.PartnerForExport.Parent 
			AND NOT Contracts.ItIsAllowedToWorkWithSubsidiaryPartners
	END AS ContractDeletionRequired
	
FROM
	AvailablePartners AS Partners
		INNER JOIN Catalog.Companies AS Companies
		ON (CASE
				WHEN &amp;ManagementCompanyNotUsed
					THEN NOT Companies.Predefined
				ELSE TRUE
			END)
		INNER JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TRUE)
		INNER JOIN InformationRegister.PartnerHierarchy AS PartnerHierarchy
			INNER JOIN Catalog.Counterparties AS Counterparties
			ON PartnerHierarchy.Parent = Counterparties.Partner
		ON (PartnerHierarchy.Partner = Partners.PartnerForExport)
		LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON (Contracts.Counterparty = Counterparties.Ref)
			AND (Contracts.Partner = Partners.PartnerForExport
				OR Contracts.Partner = Partners.PartnerForExport.Parent)
			AND (Contracts.Organization = Companies.Ref)
			AND (&amp;Currency = Contracts.ARAPCurrency)
			AND (&amp;ContractsAreUsed)
			AND (Contracts.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
				OR Contracts.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent))
		LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(
				,
				AccountingDimensionByPartners IN
					(SELECT
						DimensionByPartners.DimensionKey AS DimensionKey
					FROM
						InformationRegister.AccountingDimensionByPartners AS DimensionByPartners)) AS CustomersARAPAccountingBalance
		ON (CustomersARAPAccountingBalance.AccountingDimensionByPartners.Contract = Contracts.Ref)
		LEFT JOIN InformationRegister.ComplianceOfSalesTermsAndConditionsOf1COrdersMobileApplication AS ComplianceWithSalesConditions_
		ON (ComplianceWithSalesConditions_.Organization = Companies.Ref)
			AND (ComplianceWithSalesConditions_.PriceKind = TypesOfPrices.Ref)
			AND (ComplianceWithSalesConditions_.Partner = Partners.PartnerForExport)
			AND (ComplianceWithSalesConditions_.Terms = VALUE(Catalog.TermsOfSale.EmptyRef))
			AND (ComplianceWithSalesConditions_.Counterparty = ISNULL(Counterparties.Ref, VALUE(Catalog.Counterparties.EmptyRef)))
			AND (ComplianceWithSalesConditions_.Contract = ISNULL(Contracts.Ref, VALUE(Catalog.CounterpartyContracts.EmptyRef)))
WHERE
	&amp;AgreementUsage = VALUE(Enum.UseTermsOfSales.DontUse)
	AND Partners.PartnerForExport.Client
	AND TypesOfPrices.UseWhileSellingToCustomers
	AND CASE
			WHEN &amp;ContractsAreUsed
				THEN Contracts.Ref IS NOT NULL 
			ELSE TRUE
		END

INDEX BY
	Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	FALSE AS Exported,
	AvailablePartners.PartnerForExport AS PartnerForExport,
	AvailablePartners.Counterparty AS CounterpartyRef,
	AvailablePartners.Counterparty.DeletionMark AS CounterpartyDeletionMark,
	AvailablePartners.Counterparty.Description AS CounterpartyDescription,
	AvailablePartners.Counterparty.TIN AS CounterpartyTIN,
	AvailablePartners.Counterparty.CRTR AS CounterpartyCRTR,
	AvailablePartners.Counterparty.DescriptionFull AS CounterpartyFullName,
	AvailablePartners.Counterparty.LegalEntityIndividual AS CounterpartyLegEntInd,
	AvailablePartners.Counterparty.Partner AS CounterpartyPartner,
	PartnerInformation_.Ref AS PartnerREF,
	PartnerInformation_.DeletionMark AS PartnerDeletionMark,
	PartnerInformation_.ParentReference AS PartnerParentReference,
	PartnerInformation_.Parent AS PartnerParent,
	PartnerInformation_.Code AS PartnerCode,
	PartnerInformation_.Description AS PartnerDescription,
	PartnerInformation_.ERPCode AS PartnerERPCode,
	PartnerInformation_.PartnerPriceType AS PartnerPriceType,
	PartnerInformation_.DeliveryTimeTo AS PartnerDeliveryTimeTo,
	PartnerInformation_.DeliveryTimeFrom AS PartnerDeliveryTimeFrom,
	PartnerInformation_.AdditionalDeliveryInformation AS PartnerAdditionalInformationAboutDelivery,
	PartnerInformation_.ShipmentIsProhibited AS PartnerShipmentProhibited,
	PartnerInformation_.ReasonForAddingToStopList AS PartnerReasonForAddingToStopList,
	PartnerInformation_.SelfPickup AS PartnerPickup,
	PartnerInformation_.WarehouseReference AS PartnerWarehouseReference,
	PartnerInformation_.Warehouse AS PartnerWarehouse,
	PartnerInformation_.SearchString AS PartnerSearchBar,
	PartnerInformation_.PaymentFormLink AS PartnerPaymentMethodReference,
	CASE
		WHEN SalesTermsAndConditions.Partner IS NULL
			THEN &amp;UseAgreementsAndContracts
		WHEN PartnerInformation_.PartnerLink IS NULL
			THEN TRUE
		WHEN SalesTermsAndConditions.Counterparty.LegalEntityIndividual = VALUE(Enum.LegalEntityIndividual.LegalEntityNonResident)
			THEN TRUE
		ELSE AvailablePartners.DeletionRequired1
	END AS DeletionRequired1,
	CASE
		WHEN PartnerInformation_.PartnerLink IS NULL
			THEN TRUE
		ELSE FALSE
	END AS DeletePartner,
	SalesTermsAndConditions.Organization AS Organization,
	SalesTermsAndConditions.PriceKind AS PriceKind,
	SalesTermsAndConditions.PriceKindDeletionMark AS PriceKindDeletionMark,
	SalesTermsAndConditions.PriceTypeName AS PriceTypeName,
	SalesTermsAndConditions.PriceTypePriceIncludingVAT AS PriceTypePriceIncludingVAT,
	SalesTermsAndConditions.Terms AS Terms,
	SalesTermsAndConditions.Contract AS Contract,
	SalesTermsAndConditions.ContractDeletionMark AS ContractDeletionMark,
	SalesTermsAndConditions.ContractName_ AS ContractName_,
	SalesTermsAndConditions.ContractDate AS ContractDate,
	SalesTermsAndConditions.ContractNumber_ AS ContractNumber_,
	SalesTermsAndConditions.SalesConditionID AS SalesConditionID,
	SalesTermsAndConditions.ContractsAreUsed AS ContractsAreUsed,
	SalesTermsAndConditions.DeletionMark AS TermsDeletionMark,
	SalesTermsAndConditions.Description AS AgreementName,
	ISNULL(SalesTermsAndConditions.Terms.Date, DATETIME(1,1,1)) AS AgreementDate,
	SalesTermsAndConditions.Fee AS AgreementCommission,
	ISNULL(SalesTermsAndConditions.Terms.Number, """") AS AgreementNumber,
	SalesTermsAndConditions.Warehouse AS AgreementWarehouse,
	ISNULL(SalesTermsAndConditions.Terms.Standard_, FALSE) AS StandardAgreement,
	SalesTermsAndConditions.ProductSegment AS AgreementProductSegment,
	SalesTermsAndConditions.Valid AS AgreementIsValid,
	SalesTermsAndConditions.ThereIsPriceSpecification AS ThereIsPriceSpecification,
	SalesTermsAndConditions.DebtAmountUnderTheContract AS DebtAmountUnderTheContract,
	SalesTermsAndConditions.SettlementsUnderContract AS SettlementsUnderContract,
	SalesTermsAndConditions.ContractDeletionRequired
FROM
	AvailablePartners AS AvailablePartners
		LEFT JOIN SalesTermsAndConditions AS SalesTermsAndConditions
		ON (SalesTermsAndConditions.Partner = AvailablePartners.PartnerForExport)
			AND (SalesTermsAndConditions.Counterparty = AvailablePartners.Counterparty)
		LEFT JOIN PartnerInformation_ AS PartnerInformation_
		ON AvailablePartners.PartnerForExport = PartnerInformation_.PartnerLink
WHERE
	CASE
			WHEN &amp;AgreementUsage = VALUE(Enum.UseTermsOfSales.DontUse)
					AND &amp;ContractsAreUsed
				THEN ISNULL(SalesTermsAndConditions.Terms.Standard_, FALSE) = FALSE
			ELSE TRUE
		END

ORDER BY
	PartnerForExport
;

////////////////////////////////////////////////////////////////////////////////
DROP PermittedPartners
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailablePartners
;

////////////////////////////////////////////////////////////////////////////////
DROP AvailablePartnerSegments
;

////////////////////////////////////////////////////////////////////////////////
DROP SelectionPartners
;

////////////////////////////////////////////////////////////////////////////////
DROP SalesOrders
;

////////////////////////////////////////////////////////////////////////////////
DROP InformationByOrders
;

////////////////////////////////////////////////////////////////////////////////
DROP PartnerInformation_
;

////////////////////////////////////////////////////////////////////////////////
DROP AgreementsProducts
;

////////////////////////////////////////////////////////////////////////////////
DROP AgreementsPriceGroups
;

////////////////////////////////////////////////////////////////////////////////
DROP SalesTermsAndConditions</query>
