  <items xsi:type="form:FormField">
    <name>UsePushNotifications1</name>
    <id>43</id>
    <title>
      <key>en</key>
      <value>Push notifications</value>
    </title>
    <title>
      <key>fa</key>
      <value>اعلان‌های پوش</value>
    </title>
    <title>
      <key>it</key>
      <value>Notifiche Push</value>
    </title>
    <title>
      <key>pl</key>
      <value>Powiadomienia Push</value>
    </title>
    <title>
      <key>ru</key>
      <value>Push-уведомления</value>
    </title>
    <title>
      <key>tr</key>
      <value>Anlık bildirim</value>
    </title>
    <title>
      <key>vi</key>
      <value>Thông báo đẩy</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <dataPath xsi:type="form:DataPath">
      <segments>Object.PushNotificationOption</segments>
    </dataPath>
    <titleLocation>None</titleLocation>
    <toolTipRepresentation>ShowBottom</toolTipRepresentation>
    <handlers>
      <event>OnChange</event>
      <name>UsePushNotificationsOnChange</name>
    </handlers>
    <extendedTooltip>
      <name>UsePushNotifications1ExtendedTooltip</name>
      <id>45</id>
      <title>
        <key>en</key>
        <value>&lt;fontsize 8>&lt;color #000000>Services&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>of notification delivery &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>allow you to&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>send a notification&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> from sender to recipient&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(mobile application). These&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> services&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> include&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(APNs, &lt;/>&lt;/>&lt;fontsize 8>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>in English) and Google Cloud Messaging (GCM,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> in English).&lt;/>&lt;/></value>
      </title>
      <title>
        <key>fa</key>
        <value>&lt;fontsize 8>&lt;color #000000>سرویس‌های&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>تحویل اعلان &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>امکان&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>ارسال اعلان&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> از فرستنده به گیرنده&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(برنامه موبایل) را فراهم می‌کنند. این&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> سرویس‌ها&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> شامل&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(APNs، &lt;/>&lt;/>&lt;fontsize 8>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>،&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>به انگلیسی) و Google Cloud Messaging (GCM،&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>،&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> به انگلیسی) هستند.&lt;/>&lt;/></value>
      </title>
      <title>
        <key>ru</key>
        <value>&lt;fontsize 8>&lt;color #000000>Сервисы &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>доставки уведомлений &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>обеспечиваю&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>т передачу уведомления&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> от отправителя получателю&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(мобильному приложению). В качестве таких&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> сервисов&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> выступаю&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>т Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(APNs, &lt;/>&lt;/>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>&lt;fontsize 8>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>на английском языке) и Google Cloud Messaging (GCM,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>&lt;fontsize 8>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> на английском языке).&lt;/>&lt;/></value>
      </title>
      <title>
        <key>tr</key>
        <value>&lt;fontsize 8>&lt;color #000000>Bildirim&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>servisleri &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>bildirimin&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>gönderiden alıcıya&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> (mobil uygulamaya)&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>iletilmesini sağlar. &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(APNs, &lt;/>&lt;/>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>&lt;fontsize 8>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>İngilizce) ve Google Cloud Messaging (GCM,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>&lt;fontsize 8>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> İngilizce) bu servislerden bazılarıdır.&lt;/>&lt;/></value>
      </title>
      <title>
        <key>vi</key>
        <value>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>Dịch vụ&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>truyền thông báo &lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>đảm bảo&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> truyền thông báo&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> từ người gửi đến người nhận&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> &lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>(ứng dụng di động). Các dịch vụ&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> này&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> là&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>(APNs, &lt;/>&lt;/>&lt;fontsize 8>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>,&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> &lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>bằng tiếng Anh) và Google Cloud Messaging (GCM,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762>,&lt;/>&lt;/>&lt;fontsize 8>&lt;colorstyle 0:ce752ebb-d9ad-4208-98a8-79925d7bf762> bằng tiếng Anh).&lt;/>&lt;/></value>
      </title>
      <title>
        <key>it</key>
        <value>&lt;fontsize 8>&lt;color #000000>Services&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>of notification delivery &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>allow you to&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>send a notification&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> from sender to recipient&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(mobile application). These&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> services&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> include&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(APNs, &lt;/>&lt;/>&lt;fontsize 8>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>in English) and Google Cloud Messaging (GCM,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> in English).&lt;/>&lt;/></value>
      </title>
      <title>
        <key>pl</key>
        <value>&lt;fontsize 8>&lt;color #000000>Services&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>of notification delivery &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>allow you to&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>send a notification&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> from sender to recipient&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(mobile application). These&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> services&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> include&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> Apple Push Notification Service &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>(APNs, &lt;/>&lt;/>&lt;fontsize 8>&lt;link https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html>https://developer.apple.com/library/ios/documentation/NetworkingInternet/Conceptual/RemoteNotificationsPG/Chapters/ApplePushService.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>in English) and Google Cloud Messaging (GCM,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> &lt;/>&lt;/>&lt;fontsize 8>&lt;link http://developer.android.com/intl/ru/google/gcm/index.html>http://developer.android.com/intl/ru/google/gcm/index.html&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000>,&lt;/>&lt;/>&lt;fontsize 8>&lt;color #000000> in English).&lt;/>&lt;/></value>
      </title>
