    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DeliveryTurnoverOverridable.DateOfShipment AS DateOfShipment,
	DeliveryTurnoverOverridable.DeliveryMethod AS DeliveryMethod,
	DeliveryTurnoverOverridable.Sender AS Sender,
	DeliveryTurnoverOverridable.Recipient AS Recipient,
	DeliveryTurnoverOverridable.Carrier AS Carrier,
	DeliveryTurnoverOverridable.RecipientPoint AS RecipientPoint,
	DeliveryTurnoverOverridable.Recipient_Area AS Recipient_Area,
	DeliveryTurnoverOverridable.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnoverOverridable.DeliveryType AS DeliveryType,
	DeliveryTurnoverOverridable.Products AS Products,
	DeliveryTurnoverOverridable.Characteristic AS Characteristic,
	DeliveryTurnoverOverridable.Series AS Series,
	DeliveryTurnoverOverridable.Package AS Package,
	DeliveryTurnoverOverridable.Recipient AS FinalRecipient,
	DeliveryTurnoverOverridable.RecipientPoint AS FinalRecipientPoint,
	DeliveryTurnoverOverridable.Recipient_Area AS AreaOfFinalRecipient,
	DeliveryTurnoverOverridable.ToTripTurnover - DeliveryTurnoverOverridable.InTripTurnover AS Balance,
	0 AS Selected,
	0 AS Weight,
	0 AS VolumeM3,
	-1 AS PictureIndex,
	NULL AS Detailing,
	FALSE AS ThereAreDifferences_InDeliveryParameters,
	NULL AS OptionsForDeliveryParameters
{SELECT
	DateOfShipment,
	DeliveryMethod.*,
	Sender.*,
	Recipient.*,
	Carrier.*,
	RecipientPoint.*,
	Recipient_Area.*,
	ReferenceOrder.*,
	DeliveryType,
	Products.*,
	Characteristic.*,
	Series.*,
	Package.*,
	FinalRecipient.*,
	FinalRecipientPoint.*,
	AreaOfFinalRecipient.*,
	Balance,
	Selected,
	Weight,
	VolumeM3,
	PictureIndex,
	Detailing,
	ThereAreDifferences_InDeliveryParameters,
	OptionsForDeliveryParameters}
FROM
	AccumulationRegister.Delivery.Turnovers(, , , {(DateOfShipment), (DateOfShipment >= &amp;DateOfShipmentFrom), (DateOfShipment &lt;= &amp;DateOfShipmentBy), (Organization), (Carrier), (Arm), (Recipient), (DeliveryMethod), (DeliveryType), (RecipientPoint), (Recipient_Area), (ReferenceOrder), (Products), (Characteristic), (Series)}) AS DeliveryTurnoverOverridable</queryText>
      <mainTable>AccumulationRegister.Delivery.Turnovers</mainTable>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
