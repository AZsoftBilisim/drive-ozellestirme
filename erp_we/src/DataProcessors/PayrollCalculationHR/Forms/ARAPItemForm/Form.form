    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	EmploymentRecordSliceLast.Recorder AS Recorder,
	EmploymentRecordSliceLast.Employee AS Employee
INTO PersonnelChange
FROM
	InformationRegister.EmploymentRecord.SliceLast(&amp;BeginOfPeriod, ) AS EmploymentRecordSliceLast
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AccumulationRegisterDeductionsHR.Period AS Period,
	AccumulationRegisterDeductionsHR.Recorder AS Recorder,
	AccumulationRegisterDeductionsHR.LineNumber AS LineNumber,
	AccumulationRegisterDeductionsHR.Active AS Active,
	AccumulationRegisterDeductionsHR.Organization AS Organization,
	AccumulationRegisterDeductionsHR.Individual AS Individual,
	AccumulationRegisterDeductionsHR.Employee AS Employee,
	AccumulationRegisterDeductionsHR.Retention AS Retention,
	AccumulationRegisterDeductionsHR.Department AS Department,
	AccumulationRegisterDeductionsHR.Sum AS Sum,
	AccumulationRegisterDeductionsHR.ManualDeduction AS ManualDeduction,
	CASE
		WHEN AccumulationRegisterDeductionsHR.Recorder REFS Document.RegisterPayrollCalculation
			THEN PersonnelChange.Recorder
		ELSE AccumulationRegisterDeductionsHR.Recorder
	END AS Basis,
	FALSE AS HasErrors,
	AccumulationRegisterDeductionsHR.PeriodEnding AS PeriodEnding
FROM
	AccumulationRegister.DeductionsHR AS AccumulationRegisterDeductionsHR
		LEFT JOIN PersonnelChange AS PersonnelChange
		ON AccumulationRegisterDeductionsHR.Employee = PersonnelChange.Employee
WHERE
	AccumulationRegisterDeductionsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod</queryText>
      <mainTable>AccumulationRegister.DeductionsHR</mainTable>
