      <segments>Accruals.Sum</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	&amp;BeginOfPeriod AS Period,
	RegularAccrualsAndDeductionsHRSliceLast.Recorder AS Recorder,
	RegularAccrualsAndDeductionsHRSliceLast.Organization AS Organization,
	RegularAccrualsAndDeductionsHRSliceLast.Department AS Department,
	RegularAccrualsAndDeductionsHRSliceLast.AccrualDeduction AS AccrualDeduction,
	RegularAccrualsAndDeductionsHRSliceLast.Employee AS Employee
INTO PersonnelChange
FROM
	InformationRegister.RegularAccrualsAndDeductionsHR.SliceLast(&amp;BeginOfPeriod, Valid) AS RegularAccrualsAndDeductionsHRSliceLast

UNION ALL

SELECT
	RegularAccrualsAndDeductionsHR.Period,
	RegularAccrualsAndDeductionsHR.Recorder,
	RegularAccrualsAndDeductionsHR.Organization,
	RegularAccrualsAndDeductionsHR.Department,
	RegularAccrualsAndDeductionsHR.AccrualDeduction,
	RegularAccrualsAndDeductionsHR.Employee
FROM
	InformationRegister.RegularAccrualsAndDeductionsHR AS RegularAccrualsAndDeductionsHR
WHERE
	RegularAccrualsAndDeductionsHR.Valid
	AND CASE
			WHEN &amp;BeginOfPeriod >= RegularAccrualsAndDeductionsHR.Period
				THEN NOT RegularAccrualsAndDeductionsHR.Recorder REFS Document.HiringHR
			ELSE TRUE
		END
	AND RegularAccrualsAndDeductionsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AccumulationRegisterAccrualsHR.Period AS Period,
	AccumulationRegisterAccrualsHR.Recorder AS Recorder,
	AccumulationRegisterAccrualsHR.LineNumber AS LineNumber,
	AccumulationRegisterAccrualsHR.Active AS Active,
	AccumulationRegisterAccrualsHR.Organization AS Organization,
	AccumulationRegisterAccrualsHR.Individual AS Individual,
	AccumulationRegisterAccrualsHR.Employee AS Employee,
	AccumulationRegisterAccrualsHR.Accrual AS Accrual,
	AccumulationRegisterAccrualsHR.Department AS Department,
	AccumulationRegisterAccrualsHR.Sum AS Sum,
	CASE
		WHEN PayCodesHR.Ref &lt;> VALUE(Catalog.PayCodesHR.EmptyRef)
				AND PayCodesHR.UnitOfMeasure = VALUE(Enum.TimeMeasureUnits.DAY)
			THEN 0
		ELSE AccumulationRegisterAccrualsHR.HoursWorked
	END AS HoursWorked,
	CASE
		WHEN PayCodesHR.Ref &lt;> VALUE(Catalog.PayCodesHR.EmptyRef)
				AND PayCodesHR.UnitOfMeasure = VALUE(Enum.TimeMeasureUnits.HOUR)
			THEN 0
		ELSE AccumulationRegisterAccrualsHR.DaysWorked
	END AS DaysWorked,
	AccumulationRegisterAccrualsHR.Base AS Base,
	AccumulationRegisterAccrualsHR.NormalWorkdays AS NormalWorkdays,
	AccumulationRegisterAccrualsHR.NormOfHours AS NormOfHours,
	AccumulationRegisterAccrualsHR.ManualAccrual AS ManualAccrual,
	AccumulationRegisterAccrualsHR.RowID AS RowID,
	CASE
		WHEN AccumulationRegisterAccrualsHR.Recorder REFS Document.RegisterPayrollCalculation
			THEN PersonnelChange.Recorder
		ELSE AccumulationRegisterAccrualsHR.Recorder
	END AS Basis,
	FALSE AS HasErrors,
	AccumulationRegisterAccrualsHR.PayCode AS PayCode,
	AccumulationRegisterAccrualsHR.CalculationFormula AS CalculationFormula,
	AccumulationRegisterAccrualsHR.PeriodEnding AS PeriodEnding
FROM
	AccumulationRegister.AccrualsHR AS AccumulationRegisterAccrualsHR
		LEFT JOIN PersonnelChange AS PersonnelChange
		ON AccumulationRegisterAccrualsHR.Period = PersonnelChange.Period
			AND AccumulationRegisterAccrualsHR.Organization = PersonnelChange.Organization
			AND AccumulationRegisterAccrualsHR.Department = PersonnelChange.Department
			AND AccumulationRegisterAccrualsHR.Employee = PersonnelChange.Employee
			AND AccumulationRegisterAccrualsHR.Accrual = PersonnelChange.AccrualDeduction
		LEFT JOIN Catalog.PayCodesHR AS PayCodesHR
		ON AccumulationRegisterAccrualsHR.Accrual.PayCode = PayCodesHR.Ref
WHERE
	AccumulationRegisterAccrualsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	AccumulationRegisterAccrualsHR.PeriodEnding,
	AccumulationRegisterAccrualsHR.CalculationFormula,
	AccumulationRegisterAccrualsHR.Base,
	AccumulationRegisterAccrualsHR.ManualAccrual,
	AccumulationRegisterAccrualsHR.RowID,
	CASE
		WHEN AccumulationRegisterAccrualsHR.Recorder REFS Document.RegisterPayrollCalculation
			THEN PersonnelChange.Recorder
		ELSE AccumulationRegisterAccrualsHR.Recorder
	END,
	AccumulationRegisterAccrualsHR.PayCode,
	AccumulationRegisterAccrualsHR.Recorder,
	AccumulationRegisterAccrualsHR.Organization,
	AccumulationRegisterAccrualsHR.Department,
	AccumulationRegisterAccrualsHR.Employee,
	AccumulationRegisterAccrualsHR.Active,
	AccumulationRegisterAccrualsHR.Period,
	AccumulationRegisterAccrualsHR.Accrual,
	AccumulationRegisterAccrualsHR.Individual,
	AccumulationRegisterAccrualsHR.Sum,
	AccumulationRegisterAccrualsHR.LineNumber,
	CASE
		WHEN PayCodesHR.Ref &lt;> VALUE(Catalog.PayCodesHR.EmptyRef)
				AND PayCodesHR.UnitOfMeasure = VALUE(Enum.TimeMeasureUnits.DAY)
			THEN 0
		ELSE AccumulationRegisterAccrualsHR.HoursWorked
	END,
	CASE
		WHEN PayCodesHR.Ref &lt;> VALUE(Catalog.PayCodesHR.EmptyRef)
				AND PayCodesHR.UnitOfMeasure = VALUE(Enum.TimeMeasureUnits.HOUR)
			THEN 0
		ELSE AccumulationRegisterAccrualsHR.DaysWorked
	END,
	AccumulationRegisterAccrualsHR.NormalWorkdays,
	AccumulationRegisterAccrualsHR.NormOfHours</queryText>
      <mainTable>AccumulationRegister.AccrualsHR</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
