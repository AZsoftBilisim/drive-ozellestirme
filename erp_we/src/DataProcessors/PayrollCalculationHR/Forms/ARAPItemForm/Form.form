    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	AccumulationRegisterTaxesContributionsHR.Period AS Period,
	AccumulationRegisterTaxesContributionsHR.Recorder AS Recorder,
	AccumulationRegisterTaxesContributionsHR.Active AS Active,
	AccumulationRegisterTaxesContributionsHR.Organization AS Organization,
	AccumulationRegisterTaxesContributionsHR.Individual AS Individual,
	AccumulationRegisterTaxesContributionsHR.Employee AS Employee,
	AccumulationRegisterTaxesContributionsHR.TaxKind AS TaxKind,
	AccumulationRegisterTaxesContributionsHR.Department AS Department,
	SUM(AccumulationRegisterTaxesContributionsHR.Sum) AS Sum,
	SUM(AccumulationRegisterTaxesContributionsHR.Base) AS Base,
	SUM(AccumulationRegisterTaxesContributionsHR.Deduction) AS Deduction,
	AccumulationRegisterTaxesContributionsHR.DeductedFromEmployeeWages AS DeductedFromEmployeeWages,
	AccumulationRegisterTaxesContributionsHR.ManualTax AS ManualTax,
	CASE
		WHEN AccumulationRegisterTaxesContributionsHR.Recorder REFS Document.RegisterPayrollCalculation
			THEN VALUE(Document.TaxSettings.EmptyRef)
		ELSE AccumulationRegisterTaxesContributionsHR.Recorder
	END AS Basis,
	FALSE AS HasErrors,
	SUM(AccumulationRegisterTaxesContributionsHR.NonTaxableAmount) AS NonTaxableAmount
FROM
	AccumulationRegister.TaxesContributionsHR AS AccumulationRegisterTaxesContributionsHR
WHERE
	AccumulationRegisterTaxesContributionsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	AccumulationRegisterTaxesContributionsHR.DeductedFromEmployeeWages,
	AccumulationRegisterTaxesContributionsHR.ManualTax,
	AccumulationRegisterTaxesContributionsHR.Department,
	AccumulationRegisterTaxesContributionsHR.TaxKind,
	AccumulationRegisterTaxesContributionsHR.Employee,
	AccumulationRegisterTaxesContributionsHR.Individual,
	AccumulationRegisterTaxesContributionsHR.Organization,
	AccumulationRegisterTaxesContributionsHR.Active,
	AccumulationRegisterTaxesContributionsHR.Recorder,
	AccumulationRegisterTaxesContributionsHR.Period,
	CASE
		WHEN AccumulationRegisterTaxesContributionsHR.Recorder REFS Document.RegisterPayrollCalculation
			THEN VALUE(Document.TaxSettings.EmptyRef)
		ELSE AccumulationRegisterTaxesContributionsHR.Recorder
	END</queryText>
