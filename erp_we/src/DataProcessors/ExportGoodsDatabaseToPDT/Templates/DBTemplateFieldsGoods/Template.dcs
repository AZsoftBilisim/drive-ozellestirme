		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Products.Ref          AS Products,
	Products.ProductKind AS ProductKind,
	Products.PackagingGroup   AS PackagingGroup,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
INTO NomHar
FROM
	Catalog.Products AS Products
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
{
	WHERE Products.Ref.* AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup AS PackagingGroup,
	ItemsCharacteristics.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON Products.Ref = ItemsCharacteristics.Owner
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
{
	WHERE Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup AS PackagingGroup,
	ItemsCharacteristics.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON Products.ProductKind = ItemsCharacteristics.Owner
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
{
	WHERE Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup AS PackagingGroup,
	ItemsCharacteristics.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON Products.ItemVariantsOwner = ItemsCharacteristics.Owner
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
{
	WHERE Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NomHar.Products AS Products,
	NomHar.Characteristic AS Characteristic,
	NomHar.Package AS Package
INTO RawData
FROM
	NomHar AS NomHar

UNION ALL

SELECT
	NomHar.Products,
	NomHar.Characteristic,
	ProductPackages.Ref
FROM
	Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		INNER JOIN NomHar AS NomHar
		ON (ProductPackages.Owner = NomHar.Products
		OR ProductPackages.Owner = NomHar.PackagingGroup)

{
	WHERE NomHar.Products.* AS Products,
	NomHar.Characteristic.* AS Characteristic,
	ProductPackages.Ref.* AS Package
}

INDEX BY
	Products,
	Characteristic,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Barcodes.Products AS Products,
	Barcodes.Characteristic AS Characteristic,
	Barcodes.Package AS Package,
	MAX(Barcodes.Barcode) AS Barcode
INTO ItemsBarcodes
FROM
	InformationRegister.ItemsBarcodes AS Barcodes
WHERE
	(Barcodes.Products, Barcodes.Characteristic, Barcodes.Package) IN
			(SELECT
				RawData.Products,
				RawData.Characteristic,
				RawData.Package
			FROM
				RawData)
{WHERE
	Barcodes.Products.*,
	Barcodes.Characteristic.*,
	Barcodes.Package.*}

GROUP BY
	Barcodes.Products,
	Barcodes.Characteristic,
	Barcodes.Package

INDEX BY
	Products,
	Characteristic,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SourceDataLastRequest.Products AS Products,
	SourceDataLastRequest.Characteristic AS Characteristic,
	SourceDataLastRequest.Package AS Package,
	MAX(ItemsBarcodes.Barcode) AS Barcode,
	MAX(1) AS Count,
	MAX(ProductStockBalance.InStockBalance) AS WarehouseStockBalance,
	SegmentProducts.Segment AS Segment,
	ItemsPrices.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1) * ISNULL(&amp;QueryTextPackagingFactor2, 1) AS Price
{SELECT
	Products.*,
	Characteristic.*,
	Package.*,
	Barcode,
	Count,
	WarehouseStockBalance,
	Segment.*,
	Price}
FROM
	RawData AS SourceDataLastRequest
		
		{LEFT JOIN ItemsBarcodes AS ItemsBarcodes
		ON SourceDataLastRequest.Products = ItemsBarcodes.Products
			AND SourceDataLastRequest.Characteristic = ItemsBarcodes.Characteristic
			AND SourceDataLastRequest.Package = ItemsBarcodes.Package}
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON SourceDataLastRequest.Products = SegmentProducts.Products
			AND SourceDataLastRequest.Characteristic = SegmentProducts.Characteristic}
		{LEFT JOIN AccumulationRegister.ProductStock.Balance(, {(Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic}) AS ProductStockBalance
		ON SourceDataLastRequest.Products = ProductStockBalance.Products
			AND SourceDataLastRequest.Characteristic = ProductStockBalance.Characteristic
			AND (SourceDataLastRequest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef))}
			
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast({&amp;CurrentDate}, PriceKind = &amp;PriceKind {(Products).* AS Products, (Characteristic).* AS Characteristic}) AS ItemsPrices
		ON SourceDataLastRequest.Products = ItemsPrices.Products
			AND SourceDataLastRequest.Characteristic = ItemsPrices.Characteristic}
	
{WHERE
	SourceDataLastRequest.Products.* AS Products,
	SourceDataLastRequest.Characteristic.* AS Characteristic,
	SourceDataLastRequest.Package.* AS Package,
	ItemsBarcodes.Barcode AS Barcode,
	ProductStockBalance.InStockBalance AS WarehouseStockBalance,
	SegmentProducts.Segment.* AS Segment,
	Price}

WHERE
	NOT CASE
		WHEN SourceDataLastRequest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE WHEN SourceDataLastRequest.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight) THEN TRUE ELSE FALSE END
		ELSE CASE WHEN SourceDataLastRequest.Package.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight) THEN TRUE ELSE FALSE END
	END

GROUP BY
	SourceDataLastRequest.Products,
	SourceDataLastRequest.Characteristic,
	SourceDataLastRequest.Package,
	SegmentProducts.Segment,
	ItemsPrices.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1) * ISNULL(&amp;QueryTextPackagingFactor2, 1)

ORDER BY
	SourceDataLastRequest.Products.Description</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
