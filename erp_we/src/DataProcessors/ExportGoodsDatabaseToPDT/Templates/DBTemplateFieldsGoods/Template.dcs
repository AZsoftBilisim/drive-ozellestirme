						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Tylko z kodem kreskowym</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Только со штрихкодом</v8:content>
