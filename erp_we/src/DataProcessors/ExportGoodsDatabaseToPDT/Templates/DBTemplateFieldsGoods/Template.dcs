						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Sadece barkodla</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Chỉ có mã vạch</v8:content>
						</v8:item>
					</dcsset:presentation>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">WarehouseStockBalance</dcsset:left>
					<dcsset:comparisonType>Greater</dcsset:comparisonType>
