  <items xsi:type="form:Decoration">
    <name>WarningDecoration</name>
    <id>1</id>
    <title>
      <key>en</key>
      <value>Decoration warning</value>
    </title>
    <title>
      <key>fa</key>
      <value>هشدار نمایشی</value>
    </title>
    <title>
      <key>it</key>
      <value>Decorazione avviso</value>
    </title>
    <title>
      <key>pl</key>
      <value>Dekoracja ostrzeżenie</value>
    </title>
    <title>
      <key>ru</key>
      <value>Декорация предупреждение</value>
    </title>
    <title>
      <key>tr</key>
      <value>Uyarı dekorasyonu</value>
    </title>
    <title>
      <key>vi</key>
      <value>Trang trí cảnh báo</value>
    </title>
    <visible>true</visible>
