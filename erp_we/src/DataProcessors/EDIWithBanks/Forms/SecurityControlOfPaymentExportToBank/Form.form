      <items xsi:type="form:Decoration">
        <name>DecorationInstructionsFileChanged1</name>
        <id>16</id>
        <title>
          <key>en</key>
          <value>1. Delete the transactions imported to the bank application</value>
        </title>
        <title>
          <key>fa</key>
          <value>1. تراکنش‌های واردشده به برنامه بانک را حذف کنید</value>
