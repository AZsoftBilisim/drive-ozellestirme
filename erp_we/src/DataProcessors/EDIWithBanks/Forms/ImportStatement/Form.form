    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BankConfirmationAboutCashReceiptOnEmployeeAccount.Number AS Number,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.Date AS Date,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.Organization AS Organization,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.SourceDocument AS SourceDocument,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.BusinessOperation AS BusinessOperation,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.DocumentAmount AS DocumentAmount,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.Currency AS Currency,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.Ref AS Ref,
	BankConfirmationAboutCashReceiptOnEmployeeAccount.ImportErrors AS ImportErrors
FROM
	Document.BankConfirmationAboutCashReceiptOnEmployeeAccount AS BankConfirmationAboutCashReceiptOnEmployeeAccount
		INNER JOIN Document.BankAccountIssue AS BankAccountIssue
			LEFT JOIN InformationRegister.LastEDIWithBanks AS LastEDIWithBanks
			ON BankAccountIssue.BankAccount = LastEDIWithBanks.BankAccount
		ON BankConfirmationAboutCashReceiptOnEmployeeAccount.SourceDocument = BankAccountIssue.Ref
WHERE
	BankConfirmationAboutCashReceiptOnEmployeeAccount.HashOfFile &lt;> &quot;&quot;
	AND BankConfirmationAboutCashReceiptOnEmployeeAccount.Date BETWEEN LastEDIWithBanks.ImportStartDate AND LastEDIWithBanks.ImportEndDate</queryText>
      <mainTable>Document.BankConfirmationAboutCashReceiptOnEmployeeAccount</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
