#Region FormTableItemsEventHandlersFoundDuplicates

&AtClient
Procedure FoundDuplicatesOnActivateRow(Item)
	
	AttachIdleHandler("DuplicatesRowActivationDeferredHandler", 0.1, True);
	
EndProcedure

&AtClient
Procedure DuplicatesRowActivationDeferredHandler()
	RowID = Items.FoundDuplicates.CurrentRow;
	If RowID = Undefined Or RowID = CurrentRowID Then
		Return;
	EndIf;
	CurrentRowID = RowID;
	
	UpdateCandidateUsageInstances(RowID);
EndProcedure

&AtServer
Procedure UpdateCandidateUsageInstances(Val RowID)
	CurrentRow = FoundDuplicates.FindByID(RowID);
	
	If CurrentRow.GetParent() = Undefined Then
		// Group details.
		ProbableDuplicateUsageInstances.Clear();
		
		OriginalDescription = Undefined;
		MarkedForDeletionAndNotUsed = True;
		For Each Candidate In CurrentRow.GetItems() Do
			If Candidate.Main Then
				OriginalDescription = Candidate.Description;
			ElsIf Candidate.PictureNumber <> 4 Or Candidate.Count > 0 Then
				MarkedForDeletionAndNotUsed = False;
			EndIf;
		EndDo;
		
		LongDesc = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đối với phần tử ""%1"" đã tìm thấy phần tử bị đúp: %2';
				|ru = 'Для элемента ""%1"" найдено дублей: %2';
				|en = 'Found %2 duplicates for %1.'; fa = 'Found %2 duplicates for %1.';
				|it = 'Per l''elemento ""%1"" trovati doppi: %2';
				|pl = 'Dla elementu ""%1"" znaleziono duplikatów: %2';
				|tr = '""%2"" Öğesi için çiftler (%1) bulundu'"),
			OriginalDescription, CurrentRow.Count);
		If MarkedForDeletionAndNotUsed Then
			LongDesc = LongDesc + Chars.LF
				+ NStr("vi = 'Tuy nhiên, tất cả chúng được đánh dấu để xóa và không được sử dụng, vì vậy loại bỏ trùng lặp là không cần thiết.';
						|ru = 'Однако все они помечены на удаление и не используются, поэтому удаление дублей уже не требуется.';
						|en = 'All duplicates are marked for deletion and there are no references to them, so deleting duplicates is no longer required.'; fa = 'All duplicates are marked for deletion and there are no references to them, so deleting duplicates is no longer required.';
						|it = 'Tuttavia sono tutti contrassegnati da eliminare e non sono in uso, perciò non serve più eliminare i doppioni.';
						|pl = 'Jednak wszystkie oni są zaznaczone do usunięcia i nie są używane, ponieważ usunięcie duplikatów już nie jest wymagane.';
						|tr = 'Ancak bunların tümü silinmek üzere işaretlenmiştir ve kullanılmamaktadır, dolayısıyla kopyaların kaldırılması artık gerekli değildir.'");
		EndIf;
				
		Items.DetailsGroup1.Title = NStr("vi = 'Chi tiết:';
										|ru = 'Сведения:';
										|en = 'Information records:'; fa = 'Information records:';
										|it = 'Informazioni:';
										|pl = 'Information records:';
										|tr = 'Bilgi:'");
		Items.CurrentDuplicatesGroupDetails.Title = LongDesc;
		Items.UsageInstancesPages.CurrentPage = Items.GroupDetails;
		Return;
	EndIf;
	
	// Occurrence list.
	UsageTable = GetFromTempStorage(UsageInstancesAddress);
	Filter = New Structure("Ref", CurrentRow.Ref);
	
