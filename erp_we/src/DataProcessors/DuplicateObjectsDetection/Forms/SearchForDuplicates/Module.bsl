#Region WizardEvents

&AtClient
Procedure OnActivateWizardStep()
	
	CurrentPage = Items.WizardSteps.CurrentPage;
	
	If CurrentPage = Items.NoSearchPerformedStep Then
		
		Items.Header.Enabled = True;
		
		// Filter rule presentation.
		FilterRulesPresentation = String(PrefilterComposer.Settings.Filter);
		If IsBlankString(FilterRulesPresentation) Then
			FilterRulesPresentation = NStr("vi = 'Tất cả phần tử';
											|ru = 'Все элементы';
											|en = 'All items'; fa = 'همه اقلام';
											|it = 'Tutti gli elementi';
											|pl = 'Wszystkie elementy';
											|tr = 'Tüm öğeler'");
		EndIf;
		
		// Search rule presentation.
		Conjunction = " " + NStr("vi = 'VÀ';
								|ru = 'И';
								|en = 'AND'; fa = 'و';
								|it = 'E';
								|pl = 'ORAZ';
								|tr = 'AND'") + " ";
		RulesText = "";
		For Each Rule In SearchRules Do
			If Rule.Rule = "Equal" Then
				Comparison = Rule.AttributeRepresentation + " " + NStr("vi = 'trùng nhau';
																		|ru = 'совпадает';
																		|en = 'attributes are identical'; fa = 'attributes are identical';
																		|it = 'coincide';
																		|pl = 'pokrywa się';
																		|tr = 'uyumlu'");
			ElsIf Rule.Rule = "Like" Then
				Comparison = Rule.AttributeRepresentation + " " + NStr("vi = 'trùng theo các từ giống nhau';
																		|ru = 'совпадает по похожим словам';
																		|en = 'attributes are similar'; fa = 'attributes are similar';
																		|it = 'coincide per parole simili';
																		|pl = 'pokrywa się według podobnych wyrazów';
																		|tr = 'benzer kelimelere göre uyumlu'");
			Else
				Continue;
			EndIf;
			RulesText = ?(RulesText = "", "", RulesText + Conjunction) + Comparison;
		EndDo;
		If TakeAppliedRulesIntoAccount Then
			For Position = 1 To StrLineCount(AppliedRuleDetails) Do
				RuleRow = TrimAll(StrGetLine(AppliedRuleDetails, Position));
				If Not IsBlankString(RuleRow) Then
					RulesText = ?(RulesText = "", "", RulesText + Conjunction) + RuleRow;
				EndIf;
			EndDo;
		EndIf;
		If IsBlankString(RulesText) Then
			RulesText = NStr("vi = 'Chưa đặt quy tắc';
							|ru = 'Правила не заданы';
							|en = 'No rules set'; fa = 'No rules set';
							|it = 'Regole non impostate';
							|pl = 'Zasady nie są ustawione';
							|tr = 'Kural ayarlanmadı'");
		EndIf;
		
		If HideInsignificantDuplicates Then
			RulesRow = NStr("vi = 'không hiển thị những người được đánh dấu để xóa mà không có nơi sử dụng';
							|ru = 'не показывать помеченные на удаление без мест использования';
							|en = 'hide duplicates that are marked for deletion and never referred'; fa = 'hide duplicates that are marked for deletion and never referred';
							|it = 'Non mostrare contrassegnati per la cancellazione senza posti di utilizzo';
							|pl = 'nie pokazuj zaznaczonych do usunięcia bez miejsc używania';
							|tr = 'kullanım yerleri olmadan silinmek üzere işaretlileri göstermemek'");
			RulesText = ?(RulesText = "", "", RulesText + Conjunction) + RulesRow;
		EndIf;
		
		SearchRulesPresentation = RulesText;
		
		// Availability.
		Items.FilterRulesPresentation.Enabled = Not IsBlankString(DuplicatesSearchArea);
		Items.SearchRulesPresentation.Enabled = Not IsBlankString(DuplicatesSearchArea);
		
	ElsIf CurrentPage = Items.PerformSearchStep Then
		
		If Not IsTempStorageURL(CompositionSchemaAddress) Then
			Return; // Not initialized.
		EndIf;
		Items.Header.Enabled = False;
		WizardSettings.ShowDialogBeforeClose = True;
		FindAndDeleteDuplicatesClient();
		
	ElsIf CurrentPage = Items.MainItemSelectionStep Then
		
		Items.Header.Enabled = True;
		Items.RetrySearch.Visible = True;
		ExpandDuplicatesGroup();
		
	ElsIf CurrentPage = Items.DeletionStep Then
		
		Items.Header.Enabled = False;
		WizardSettings.ShowDialogBeforeClose = True;
		FindAndDeleteDuplicatesClient();
		
	ElsIf CurrentPage = Items.SuccessfulDeletionStep Then
		
		Items.Header.Enabled = False;
		
		If PossibleDuplicateSelected Then
			Items.WizardStepBack.Title = NStr("vi = 'Tìm kiếm mới';
												|ru = 'Новый поиск';
												|en = 'New search'; fa = 'New search';
												|it = 'Nuova ricerca';
												|pl = 'Nowe wyszukiwanie';
												|tr = 'Yeni arama'");
			Items.WizardStepBack.DefaultButton = True;
		Else
			Items.WizardStepBack.Title = NStr("vi = 'Lặp lại tìm kiếm';
												|ru = 'Повторить поиск';
												|en = 'Search again'; fa = 'جستجوی مجدد';
												|it = 'Ripeti ricerca';
												|pl = 'Powtórz wyszukiwanie';
												|tr = 'Aramayı tekrar dene'");
			Items.WizardStepBack.DefaultButton = False;
		EndIf;
		
	ElsIf CurrentPage = Items.UnsuccessfulReplacementsStep Then
		
		Items.Header.Enabled = False;
		
	ElsIf CurrentPage = Items.DuplicatesNotFoundStep Then
		
		Items.Header.Enabled = True;
		If IsBlankString(DuplicatesSearchErrorDescription) Then
			Message = NStr("vi = 'Không tìm thấy bản sao cho các tham số đã chỉ định.';
							|ru = 'Не обнаружено дублей по указанным параметрам.';
							|en = 'No duplicates found by the specified parameters.'; fa = 'No duplicates found by the specified parameters.';
							|it = 'Non rilevati doppi per parametri specificati.';
							|pl = 'Nie wykryto duplikatów określonych parametrów.';
							|tr = 'Belirtilen parametreler için kopya bulunamadı.'");
		Else	
			Message = DuplicatesSearchErrorDescription;
		EndIf;	
		Items.DuplicatesNotFound.StatePresentation.Text = Message + Chars.LF 
			+ NStr("vi = 'Thay đổi các điều kiện và nhấp vào Tìm bản sao';
					|ru = 'Измените условия и нажмите ""Найти дубли""';
					|en = 'Edit the criteria and select Find duplicates.'; fa = 'Edit the criteria and select Find duplicates.';
					|it = 'Modificare condizioni e premere ""Trova doppi""';
					|pl = 'Zmień warunki i kliknij „Znajdź duplikaty”';
					|tr = 'Koşulları değiştirin ve ""Kopyaları Bul"" tıklayın'");
		
	ElsIf CurrentPage = Items.ErrorOccurredStep Then
		
		Items.Header.Enabled = True;
		Items.DetailsRef.Visible = ValueIsFilled(Items.DetailsRef.ToolTip);
		
	EndIf;
	
EndProcedure

&AtClient
Procedure WizardStepNext()
	
	ClearMessages();
	CurrentPage = Items.WizardSteps.CurrentPage;
	
	Step = WizardSettings.CurrentStep;// See AddWizardStep
	HandlerNextCompletion = New CallbackDescription("WizardStepNextCompletion", ThisObject);
	If CurrentPage = Items.NoSearchPerformedStep Then
		
		If IsBlankString(DuplicatesSearchArea) Then
			ShowMessageBox(, NStr("vi = 'Hãy chọn vùng tìm kiếm phần tử trùng lặp';
									|ru = 'Выберите область поиска дублей';
									|en = 'Select a search location'; fa = 'Select a search location';
									|it = 'Selezionare area di ricerca dei duplicati';
									|pl = 'Wybierz obszar wyszukiwania duplikatów';
									|tr = 'Kopya aramak için alan seçin'"));
			Return;
		EndIf;
		
		If AppliedRuleDetails <> Undefined And TakeAppliedRulesIntoAccount Then
			AreSearchRulesSpecified = True;
		Else
			AreSearchRulesSpecified = False;
			For Each RulesRow In SearchRules Do
				If ValueIsFilled(RulesRow.Rule) Then
					AreSearchRulesSpecified = True;
					Break;
				EndIf;
			EndDo;
		EndIf;
		
		If Not AreSearchRulesSpecified Then
			ShowMessageBox(, NStr("vi = 'Hãy chỉ ra ít nhất một quy tắc tìm kiếm phần tử trùng lặp.';
									|ru = 'Укажите хотя бы одно правило поиска дублей.';
									|en = 'Specify at least one duplicate search rule.'; fa = 'Specify at least one duplicate search rule.';
									|it = 'Indicare almeno una regola di ricerca dei duplicati.';
									|pl = 'Wskaż co najmniej jedną regułę wyszukiwania duplikatów.';
									|tr = 'En az bir kopya arama kuralı belirtin.'"));
			Return;
		EndIf;
		
		RunCallback(HandlerNextCompletion, Step.IndexOf + 1);
		
	ElsIf CurrentPage = Items.MainItemSelectionStep Then
		
		Items.RetrySearch.Visible = False;
		If ValueIsFilled(Step.WhenYouClickNext) Then
		
			Handler = New CallbackDescription(Step.WhenYouClickNext, ThisObject, 
							New Structure("CompletionHandler", HandlerNextCompletion));
			RunCallback(Handler, Step.IndexOf + 1);
		Else
			
			RunCallback(HandlerNextCompletion, Step.IndexOf + 1);
		EndIf;
		
		
	ElsIf CurrentPage = Items.UnsuccessfulReplacementsStep Then
		
		RunCallback(HandlerNextCompletion, Items.DeletionStep);
		
	ElsIf CurrentPage = Items.DuplicatesNotFoundStep Then
		
		RunCallback(HandlerNextCompletion, Items.PerformSearchStep);
		
	Else
		
		RunCallback(HandlerNextCompletion, Step.IndexOf + 1);
		
	EndIf;
	
EndProcedure

&AtClient
Procedure WizardStepNextCompletion(Result, AdditionalParameters) Export

	If Result = Undefined Then
		Return;
	EndIf;
	GoToWizardStep1(Result);

EndProcedure

&AtClient
Procedure WizardStepBack()
	
	CurrentPage = Items.WizardSteps.CurrentPage;
	
	If CurrentPage = Items.SuccessfulDeletionStep Then
		
		If PossibleDuplicateSelected Then
			PickSelectedUsageInstances(PossibleDuplicateSelectedType);
			DuplicatesSearchAreaSelectionCompletion(PossibleDuplicateSelectedType, Undefined);
			WizardStepNext();
		Else
			GoToWizardStep1(Items.NoSearchPerformedStep);
		EndIf;
		
	Else
		
		Step = WizardSettings.CurrentStep;// See AddWizardStep
		GoToWizardStep1(Step.IndexOf - 1);
		
	EndIf;
	
EndProcedure

&AtClient
Procedure WizardStepCancel()
	
	CurrentPage = Items.WizardSteps.CurrentPage;
	
	If CurrentPage = Items.PerformSearchStep
		Or CurrentPage = Items.DeletionStep Then
		WizardSettings.ShowDialogBeforeClose = False;
	EndIf;
	
	If IsOpen() Then
		Close();
	EndIf;
	
EndProcedure

