&AtClient
Procedure OnOpen(Cancel)
	
	OnActivateWizardStep();
	ReportsToSend = New Map;
	
EndProcedure

&AtClient
Procedure BeforeClose(Cancel, Exit, WarningText, StandardProcessing)
	If Not WizardSettings.ShowDialogBeforeClose Then
		Return;
	EndIf;
	If Exit Then
		Return;
	EndIf;
	
	Cancel = True;
	CurrentPage = Items.WizardSteps.CurrentPage;
	If CurrentPage = Items.PerformSearchStep Then
		QueryText = NStr("vi = 'Ngừng tìm kiếm phần tử trùng lặp và đóng biểu mẫu?';
						|ru = 'Прервать поиск дублей и закрыть форму?';
						|en = 'Do you want to stop search and close the form?'; fa = 'Do you want to stop search and close the form?';
						|it = 'Interrompere la ricerca di doppi e chiudere il modulo?';
						|pl = 'Przerwać wyszukiwanie duplikatów i zamknąć formularz?';
						|tr = 'Çiftleri araması durdurulsun ve form kapatılsın mı?'");
	ElsIf CurrentPage = Items.DeletionStep Then
		QueryText = NStr("vi = 'Dừng xóa phần tử trùng lặp và đóng biểu mẫu?';
						|ru = 'Прервать удаление дублей и закрыть форму?';
						|en = 'Do you want to stop deletion and close the form?'; fa = 'Do you want to stop deletion and close the form?';
						|it = 'Interrompere la cancellazione di doppi e chiudere il modulo?';
						|pl = 'Przerwać usuwanie duplikatów i zamknąć formularz?';
						|tr = 'Çiftleri değiştirmeyi bırak ve formu kapat?'");
	EndIf;
	
	Buttons = New ValueList;
	Buttons.Add(DialogReturnCode.Abort, NStr("vi = 'Ngừng';
											|ru = 'Прервать';
											|en = 'Cancel operation'; fa = 'لغو عملیات';
											|it = 'Interrompere';
											|pl = 'Cancel operation';
											|tr = 'Durdur'"));
	Buttons.Add(DialogReturnCode.No,      NStr("vi = 'Không dừng';
												|ru = 'Не прерывать';
												|en = 'Continue operation'; fa = 'ادامه عملیات';
												|it = 'Non interrompere';
												|pl = 'Nie przerywać';
												|tr = 'İptal etmemek'"));
	
	Handler = New CallbackDescription("AfterConfirmCancelJob", ThisObject);
	ShowQueryBox(Handler, QueryText, Buttons, , DialogReturnCode.No);
EndProcedure

