		<field xsi:type="DataSetFieldField">
			<dataPath>Purpose</dataPath>
			<field>Purpose</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Products.Ref AS Products,
	Products.ProductCategory
INTO RawData
FROM
	Catalog.Products AS Products
WHERE
	NOT Products.IsFolder
{WHERE
	(Products.Ref IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductCategories.Ref AS ProductCategory
FROM
	Catalog.ProductCategories AS ProductCategories
		{LEFT JOIN RawData AS SourceDataLastRequest
			{LEFT JOIN AccumulationRegister.ProductStock.Balance(, {(Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic, (Products IN
					    (SELECT
					        SelectionByProductSegment.Products
					    FROM
					        SelectionByProductSegment
					    WHERE
					        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ProductStockBalance
			ON SourceDataLastRequest.Products = ProductStockBalance.Products}
			{LEFT JOIN InformationRegister.ProductRange.SliceLast(&amp;ProductRangeAsOfDate, ) AS ProductRange
			ON SourceDataLastRequest.Products = ProductRange.Products}
		ON ProductCategories.Ref = SourceDataLastRequest.ProductCategory}
WHERE
	NOT ProductCategories.IsFolder
{WHERE
	SourceDataLastRequest.Products.* AS Products,
	ProductStockBalance.InStockBalance AS WarehouseStockBalance,
	ProductRange.PlanningObject AS PlanningObject,
	ProductCategories.Owner.* AS ProductKind}

ORDER BY
	SourceDataLastRequest.Products.Description</query>
	</dataSet>
	<parameter>
