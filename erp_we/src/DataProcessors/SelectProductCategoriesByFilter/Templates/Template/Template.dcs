	</parameter>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
