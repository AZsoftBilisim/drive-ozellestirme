<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <title>
    <key>en</key>
    <value>Export data</value>
  </title>
  <title>
    <key>fa</key>
    <value>خروج اطلاعات داده</value>
  </title>
  <title>
    <key>it</key>
    <value>Caricamento dei dati</value>
  </title>
  <title>
    <key>pl</key>
    <value>Przesyłanie danych</value>
  </title>
  <title>
    <key>ru</key>
    <value>Выгрузка данных</value>
  </title>
  <title>
    <key>tr</key>
    <value>Veri dışa aktarma</value>
  </title>
  <title>
    <key>vi</key>
    <value>Kết xuất dữ liệu</value>
  </title>
  <items xsi:type="form:FormGroup">
    <name>Group1</name>
    <id>7</id>
    <items xsi:type="form:Decoration">
      <name>PictureDecoration</name>
      <id>4</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>PictureDecorationExtendedTooltip</name>
        <id>6</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>PictureDecorationContextMenu</name>
        <id>5</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:PictureDecorationExtInfo">
        <picture xsi:type="core:PictureRef">
          <picture>CommonPicture.TimeConsumingOperation48</picture>
        </picture>
        <fileDragMode>AsFileRef</fileDragMode>
      </extInfo>
    </items>
    <items xsi:type="form:Decoration">
      <name>LabelDecoration</name>
      <id>1</id>
      <title>
        <key>en</key>
        <value>Please wait, data export is in progress. Operations are temporarily unavailable</value>
      </title>
      <title>
        <key>fa</key>
        <value>لطفاً صبر کنید، خروج اطلاعات داده در حال انجام است. عملیات به‌طور موقت در دسترس نیستند</value>
      </title>
      <title>
        <key>it</key>
        <value>Attendere, upload dati in corso, lavoro temporaneamente bloccato</value>
      </title>
      <title>
        <key>pl</key>
        <value>Czekaj, trwa eksportowanie danych, praca jest czasowo niemożliwa</value>
      </title>
      <title>
        <key>ru</key>
        <value>Подождите, выполняется выгрузка данных, работа временно невозможна</value>
      </title>
      <title>
        <key>tr</key>
        <value>Bekleyin, veri dışa aktarımı gerçekleştiriliyor, geçici olarak iş yapılamıyor</value>
      </title>
      <title>
        <key>vi</key>
        <value>Vui lòng chờ, đang kết xuất dữ liệu, tạm thời không thể làm việc</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>LabelDecorationExtendedTooltip</name>
        <id>3</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>LabelDecorationContextMenu</name>
        <id>2</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </items>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>Group1ExtendedTooltip</name>
      <id>8</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <type>UsualGroup</type>
    <extInfo xsi:type="form:UsualGroupExtInfo">
      <group>AlwaysHorizontal</group>
      <showLeftMargin>true</showLeftMargin>
      <united>true</united>
      <throughAlign>Auto</throughAlign>
      <currentRowUse>Auto</currentRowUse>
    </extInfo>
  </items>
  <commandBarLocation>None</commandBarLocation>
  <autoCommandBar>
    <name>FormCommandBar</name>
    <id>-1</id>
    <horizontalAlign>Left</horizontalAlign>
    <autoFill>true</autoFill>
  </autoCommandBar>
  <handlers>
    <event>OnOpen</event>
    <name>OnOpen</name>
  </handlers>
  <handlers>
    <event>BeforeClose</event>
    <name>BeforeClose</name>
  </handlers>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>OnCreateAtServer</name>
  </handlers>
  <windowOpeningMode>LockWholeInterface</windowOpeningMode>
  <saveWindowSettings>true</saveWindowSettings>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>IsJobCompleted</name>
    <title>
      <key>en</key>
      <value>Job is completed</value>
    </title>
    <title>
      <key>fa</key>
      <value>کار تکمیل شد</value>
    </title>
    <title>
      <key>it</key>
      <value>Task concluso</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zadanie zakończono</value>
    </title>
    <title>
      <key>ru</key>
      <value>Задание завершено</value>
    </title>
    <title>
      <key>tr</key>
      <value>İş tamamlandı</value>
    </title>
    <title>
      <key>vi</key>
      <value>Đã hoàn tất nhiệm vụ</value>
    </title>
    <id>2</id>
    <valueType>
      <types>Boolean</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <parameters>
    <name>JobID</name>
    <valueType>
      <types>UUID</types>
    </valueType>
    <keyParameter>true</keyParameter>
  </parameters>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
