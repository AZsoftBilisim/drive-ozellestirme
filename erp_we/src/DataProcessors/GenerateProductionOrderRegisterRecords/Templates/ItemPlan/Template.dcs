		<dataSource>DataSource1</dataSource>
		<query>SELECT
	
	Receipt.Products        AS Products,
	Receipt.Characteristic      AS Characteristic,
	Receipt.Purpose          AS Purpose,
	
	Receipt.Warehouse AS DestinationWarehouse,
	Expense.Warehouse AS SourceWarehouse,

	Receipt.ProductionOrder AS ProductionOrder,
	Receipt.KeyProducts    AS KeyProducts,
	Expense.KeyProducts    AS KeyItemConsumption,
	Receipt.KeyLot          AS KeyLot,
	
	Expense.StructureAssignment AS StructureAssignment,
	
	ISNULL(ScheduleDates.Begin, DATETIME(1,1,1)) AS StartDate,
	ISNULL(ScheduleDates.Ending, DATETIME(1,1,1)) AS EndDate,

	SUM(Receipt.Scheduled) AS Required2,
	MAX(BatchSpecificationData.BillOfMaterials) AS BillOfMaterials
	
INTO Transfers
FROM

	InformationRegister.OrderStructure AS Receipt
	
		INNER JOIN InformationRegister.OrderStructure AS Expense
		ON Receipt.KeyLot = Expense.KeyLot
		 AND NOT Expense.AdditionalRecord
		 AND Expense.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
		
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
		ON Receipt.ProductionOrder = ScheduleDates.ProductionOrder
		 AND ScheduleDates.ScheduleStatus = 0
		 AND ScheduleDates.Stage= VALUE(Catalog.ProductionStages.EmptyRef)
		 AND Receipt.KeyLot = ScheduleDates.KeyLot
		
		LEFT JOIN InformationRegister.OrderStructure AS BatchSpecificationData
		ON (Receipt.Products = BatchSpecificationData.Products
			AND Receipt.Characteristic = BatchSpecificationData.Characteristic
			AND Receipt.ProductionOrder = BatchSpecificationData.ProductionOrder
			AND Receipt.ConnectionKeyTransfer = BatchSpecificationData.KeyProducts
			AND BatchSpecificationData.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
			AND NOT BatchSpecificationData.AdditionalRecord
			AND BatchSpecificationData.ToSupply &lt;&gt; 0)
	
WHERE
	Receipt.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Move)
	
{WHERE
	Receipt.Warehouse                                                 AS DestinationWarehouse,
	Expense.Warehouse                                                 AS SourceWarehouse,
	Receipt.ProductionOrder.LineOfBusiness.*         AS LineOfBusiness,
	Receipt.ProductionOrder.*                                 AS ProductionOrder,
	Receipt.Products.*                                        AS Products,
	Receipt.Characteristic.*                                      AS Characteristic,
	ISNULL(ScheduleDates.Begin, DATETIME(1,1,1))       AS StartDate,
	ISNULL(ScheduleDates.Ending, DATETIME(1,1,1)) AS EndDate,
	((BatchSpecificationData.Stage REFS Document.ProductionStage2_2
			AND CAST(BatchSpecificationData.Stage AS Document.ProductionStage2_2).ProductionLot &lt;&gt; VALUE(Catalog.ProductionLots.EmptyRef))) AS OnlyRunningBatches}
GROUP BY
	Receipt.Products,
	Receipt.Characteristic,
	Receipt.Warehouse,
	Receipt.Purpose,
	Receipt.ProductionOrder,
	Receipt.KeyLot,
	Receipt.KeyProducts,
	Expense.KeyProducts,
	Expense.Warehouse,
	Expense.StructureAssignment,
	ISNULL(ScheduleDates.Begin, DATETIME(1,1,1)),
	ISNULL(ScheduleDates.Ending, DATETIME(1,1,1))

HAVING
	SUM(Receipt.Scheduled) &gt; 0

INDEX BY SETS
(
	(KeyLot,
	Products,
	Characteristic,
	Purpose),
	(Products,
	Characteristic,
	SourceWarehouse,
	Purpose,
	ProductionOrder,
	KeyItemConsumption)
)
;

SELECT
	AvailabilityTable.KeyLot AS KeyLot,
	AvailabilityTable.Products AS Products,
	AvailabilityTable.Characteristic AS Characteristic,
	AvailabilityTable.Purpose AS Purpose,
	MAX(AvailabilityTable.DateOfReceipt) AS DateOfReceipt,
	SUM(AvailabilityTable.AllocatedFromAvailableInventory) AS AllocatedFromAvailableInventory,
	SUM(AvailabilityTable.AllocatedFromAvailableInventoryWithAssignment) AS AllocatedFromAvailableInventoryWithAssignment
INTO AvailabilityInformation
FROM
	(SELECT
		AvailabilityInformation.KeyLot AS KeyLot,
		AvailabilityInformation.Products AS Products,
		AvailabilityInformation.Characteristic AS Characteristic,
		AvailabilityInformation.Purpose AS Purpose,
		AvailabilityInformation.DateOfReceipt AS DateOfReceipt,
		CASE
			WHEN AvailabilityInformation.DateOfReceipt = DATETIME(1, 1, 1)
				AND AvailabilityInformation.ReceiptOrder &lt;&gt; UNDEFINED
				THEN 0
			WHEN AvailabilityInformation.DateOfReceipt &lt;= &amp;Period
				THEN AvailabilityInformation.AllocatedFromAvailableInventory
			ELSE 0
		END AS AllocatedFromAvailableInventory,
		CASE
			WHEN AvailabilityInformation.DateOfReceipt = DATETIME(1, 1, 1)
				AND AvailabilityInformation.ReceiptOrder &lt;&gt; UNDEFINED
				THEN 0
			WHEN AvailabilityInformation.DateOfReceipt &lt;= &amp;Period
				THEN AvailabilityInformation.AllocatedFromAvailableInventoryWithAssignment
			ELSE 0
		END AS AllocatedFromAvailableInventoryWithAssignment
	FROM
		InformationRegister.OrderStructure AS AvailabilityInformation
	WHERE
		AvailabilityInformation.KeyLot IN
				(SELECT
					DD.KeyLot
				FROM
					Transfers AS DD)
		AND AvailabilityInformation.DateOfReceipt &lt;= &amp;Period
		AND AvailabilityInformation.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
	
	UNION ALL
	
	SELECT
		Transfers.KeyLot,
		AvailabilityInformation.Products,
		AvailabilityInformation.Characteristic,
		AvailabilityInformation.Purpose,
		AvailabilityInformation.DateOfReceipt,
		CASE
			WHEN AvailabilityInformation.DateOfReceipt = DATETIME(1, 1, 1)
				AND AvailabilityInformation.ReceiptOrder &lt;&gt; UNDEFINED
				THEN 0
			WHEN AvailabilityInformation.DateOfReceipt &lt;= &amp;Period
				THEN AvailabilityInformation.AllocatedInFreeProductionLots
			ELSE 0
		END,
		CASE
			WHEN AvailabilityInformation.DateOfReceipt = DATETIME(1, 1, 1)
				AND AvailabilityInformation.ReceiptOrder &lt;&gt; UNDEFINED
				THEN 0
			WHEN AvailabilityInformation.DateOfReceipt &lt;= &amp;Period
				THEN AvailabilityInformation.AllocatedInAssignedProductionLots
			ELSE 0
		END
	FROM
		Transfers AS Transfers
			INNER JOIN InformationRegister.OrderStructure AS AvailabilityInformation
			ON (AvailabilityInformation.Products = Transfers.Products)
				AND (AvailabilityInformation.Characteristic = Transfers.Characteristic)
				AND (AvailabilityInformation.Warehouse = Transfers.SourceWarehouse)
				AND (AvailabilityInformation.Purpose = Transfers.Purpose)
				AND (AvailabilityInformation.ProductionOrder = Transfers.ProductionOrder)
				AND (AvailabilityInformation.KeyProducts = Transfers.KeyItemConsumption)
	WHERE
		AvailabilityInformation.DateOfReceipt &lt;= &amp;Period
		AND AvailabilityInformation.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct)) AS AvailabilityTable

GROUP BY
	AvailabilityTable.KeyLot,
	AvailabilityTable.Products,
	AvailabilityTable.Characteristic,
	AvailabilityTable.Purpose

HAVING
	(SUM(AvailabilityTable.AllocatedFromAvailableInventory) &gt; 0
		OR SUM(AvailabilityTable.AllocatedFromAvailableInventoryWithAssignment) &gt; 0)

INDEX BY
	KeyLot,
	Products,
	Characteristic,
	Purpose
;

SELECT
	
	Table.DestinationWarehouse           AS DestinationWarehouse,
	Table.SourceWarehouse          AS SourceWarehouse,

	Table.Products              AS Products,
	Table.Characteristic            AS Characteristic,
	Table.Purpose                AS Purpose,

	Table.ProductionOrder       AS ProductionOrder,

	Table.StartDate                AS StartDate,
	Table.EndDate             AS EndDate,
	
	Table.BillOfMaterials              AS BillOfMaterials,
	
	MAX(Table.DateOfReceipt) AS DateOfReceipt,
	SUM(Table.Available)           AS Available,
	SUM(Table.Required2)          AS Required2
	
{SELECT
	DestinationWarehouse.*,
	SourceWarehouse.*,
	Products.*,
	Characteristic.*,
	Purpose.*,
	ProductionOrder.*,
	StartDate,
	EndDate,
	BillOfMaterials.*,
	DateOfReceipt,
	Required2,
	Available}

FROM (
	
	SELECT
	
		Plan.Products        AS Products,
		Plan.Characteristic      AS Characteristic,

		Plan.Purpose          AS Purpose,

		Plan.DestinationWarehouse     AS DestinationWarehouse,
		Plan.SourceWarehouse    AS SourceWarehouse,

		Plan.ProductionOrder AS ProductionOrder,

		Plan.StartDate          AS StartDate,
		Plan.EndDate       AS EndDate,
		
		Plan.BillOfMaterials        AS BillOfMaterials,

		ISNULL(AvailabilityInformation.DateOfReceipt, DATETIME(1, 1, 1)) AS DateOfReceipt,
		ISNULL(AvailabilityInformation.AllocatedFromAvailableInventory, 0) AS Available,

		Plan.Required2 - ISNULL(AvailabilityInformation.AllocatedFromAvailableInventoryWithAssignment, 0) AS Required2 

	FROM
		Transfers AS Plan

		LEFT JOIN AvailabilityInformation AS AvailabilityInformation
		ON Plan.KeyLot          = AvailabilityInformation.KeyLot
		 AND Plan.Products        = AvailabilityInformation.Products
		 AND Plan.Characteristic      = AvailabilityInformation.Characteristic
		 AND Plan.Purpose          = AvailabilityInformation.Purpose
	
	WHERE
		Plan.Required2 - ISNULL(AvailabilityInformation.AllocatedFromAvailableInventoryWithAssignment, 0) &gt; 0
	
{WHERE
	Plan.Purpose.* AS Purpose}
	
	UNION ALL

	SELECT
	
		Plan.Products        AS Products,
		Plan.Characteristic      AS Characteristic,

		Plan.StructureAssignment AS Purpose,

		Plan.DestinationWarehouse     AS DestinationWarehouse,
		Plan.SourceWarehouse    AS SourceWarehouse,

		Plan.ProductionOrder AS ProductionOrder,

		Plan.StartDate          AS StartDate,
		Plan.EndDate       AS EndDate,
		
		Plan.BillOfMaterials        AS BillOfMaterials,

		AvailabilityInformation.DateOfReceipt                  AS DateOfReceipt,
		AvailabilityInformation.AllocatedFromAvailableInventoryWithAssignment AS Available,
		AvailabilityInformation.AllocatedFromAvailableInventoryWithAssignment AS Required2

	FROM
		Transfers AS Plan

		INNER JOIN AvailabilityInformation AS AvailabilityInformation
		ON Plan.KeyLot          = AvailabilityInformation.KeyLot
		 AND Plan.Products        = AvailabilityInformation.Products
		 AND Plan.Characteristic      = AvailabilityInformation.Characteristic
		 AND Plan.Purpose          = AvailabilityInformation.Purpose
		
	WHERE
		AvailabilityInformation.AllocatedFromAvailableInventoryWithAssignment &gt; 0
		
{WHERE
	Plan.StructureAssignment.* AS Purpose}
	
	) AS Table
	
GROUP BY
	Table.Products, Table.Characteristic, Table.Purpose, Table.ProductionOrder, Table.DestinationWarehouse, Table.SourceWarehouse, Table.BillOfMaterials, Table.StartDate, Table.EndDate	
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
