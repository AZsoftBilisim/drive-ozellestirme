		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RepairFacilities.Ref AS Asset,
	RepairFacilities.Class,
	RepairFacilities.Subclass,
	RepairFacilities.OperatingBusinessUnit,
	RepairFacilities.RMBusinessUnit,
	RepairFacilities.Status,
	RepairFacilities.Model,
	RepairFacilities.SerialNumber,
	RepairFacilities.Placement,
	RepairFacilities.Ref AS Owner
FROM
	Catalog.Assets AS RepairFacilities
WHERE
	RepairFacilities.Status IN (VALUE(Enum.AssetStatuses.InOperation))

UNION ALL

SELECT
	SubAssets.Ref,
	SubAssets.Class,
	SubAssets.Subclass,
	ISNULL(Assets.OperatingBusinessUnit, UNDEFINED),
	SubAssets.RMBusinessUnit,
	SubAssets.Status,
	SubAssets.Model,
	SubAssets.SerialNumber,
	SubAssets.Placement,
	SubAssets.Owner
FROM
	Catalog.SubAssets AS SubAssets
	LEFT JOIN Catalog.Assets AS Assets
		ON SubAssets.Owner = Assets.Ref
WHERE
	SubAssets.Owner &lt;&gt; VALUE(Catalog.Assets.EmptyRef)
	AND SubAssets.Status IN (VALUE(Enum.AssetStatuses.InOperation))
	AND Assets.Status = VALUE(Enum.AssetStatuses.InOperation)</query>
	</dataSet>
