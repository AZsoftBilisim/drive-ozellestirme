		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(RawData.Ref AS Document.PackingList) AS PackingList,
	RawData.Order AS Order,
	RawData.Barcode AS Barcode
INTO RawData
FROM
	RawDataOverridable AS RawData
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SourceDataLastRequest.PackingList AS PackingList,
	SourceDataLastRequest.PackingList.Basis AS Basis,
	SourceDataLastRequest.PackingList.Code AS Code,
	SourceDataLastRequest.PackingList.TotalNumberOfPackageItems AS Instances,
	SourceDataLastRequest.Barcode AS Barcode,
	SourceDataLastRequest.Order AS Order
{SELECT
	PackingList.*,
	Basis,
	Code,
	Barcode,
	Instances}
FROM
	RawData AS SourceDataLastRequest
{WHERE
	SourceDataLastRequest.PackingList.* AS PackingList,
	SourceDataLastRequest.PackingList.Basis AS Basis,
	SourceDataLastRequest.PackingList.Code AS Code,
	SourceDataLastRequest.Barcode AS Barcode}

ORDER BY
	SourceDataLastRequest.Order</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
