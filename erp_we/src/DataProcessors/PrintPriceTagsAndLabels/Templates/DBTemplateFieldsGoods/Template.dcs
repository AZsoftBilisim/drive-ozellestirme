							<v8:lang>tr</v8:lang>
							<v8:content>Sadece fiyatla</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Chỉ với đơn giá</v8:content>
						</v8:item>
					</dcsset:presentation>
