		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Products.Ref AS Products,
	Products.ProductKind AS ProductKind,
	Products.PackagingGroup AS PackagingGroup,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
INTO NomHar
FROM
	Catalog.Products AS Products
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
{WHERE
	Products.Ref.* AS Products,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	((Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup,
	ItemsCharacteristics.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON Products.Ref = ItemsCharacteristics.Owner
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
{WHERE
	Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup,
	ItemsCharacteristics.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON Products.ProductKind = ItemsCharacteristics.Owner
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
{WHERE
	Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup,
	ItemsCharacteristics.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON Products.ItemVariantsOwner = ItemsCharacteristics.Owner
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
{WHERE
	Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NomHar.Products AS Products,
	NomHar.Characteristic AS Characteristic,
	NomHar.Package AS Package,
	NomHar.PackagingGroup AS PackagingGroup,
	NomHar.Products AS OwnerOfProductPackaging
INTO NomHarForSourceData
FROM NomHar AS NomHar

UNION ALL

SELECT
	NomHar.Products AS Products,
	NomHar.Characteristic AS Characteristic,
	NomHar.Package AS Package,
	NomHar.PackagingGroup AS PackagingGroup,
	NomHar.PackagingGroup AS OwnerOfProductPackaging
FROM NomHar AS NomHar
WHERE NomHar.Products &lt;&gt; NomHar.PackagingGroup

INDEX BY
	OwnerOfProductPackaging
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NomHar.Products AS Products,
	NomHar.Characteristic AS Characteristic,
	NomHar.Package AS Package
INTO RawData
FROM
	NomHar AS NomHar

UNION ALL

SELECT
	NomHar.Products,
	NomHar.Characteristic,
	ProductPackages.Ref
FROM
	Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		INNER JOIN NomHarForSourceData AS NomHar
		ON ProductPackages.Owner = NomHar.OwnerOfProductPackaging

{WHERE
	NomHar.Products.* AS Products,
	NomHar.Characteristic.* AS Characteristic,
	ProductPackages.Ref.* AS Package}

INDEX BY
	Products,
	Characteristic,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RawData.Products AS Products,
	RawData.Products.UnitOfMeasure AS UnitOfMeasure,
	CASE WHEN RawData.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
		THEN RawData.Products
		ELSE RawData.Products.PackagingGroup
	END AS OwnerOfProductPackaging
INTO InitialDataForTableAreUnitPackages
FROM
	RawData AS RawData
WHERE
	RawData.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	
INDEX BY
	OwnerOfProductPackaging
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductPackages.Ref AS Package,
	RawData.Products AS Products,
	&amp;QueryTextPackagingFactor1 AS ZoomRatio,
	ProductPackages.UnitOfMeasure AS UnitOfMeasure,
	RawData.UnitOfMeasure AS UnitOfProductMeasurement_
INTO SinglePackages
FROM
	InitialDataForTableAreUnitPackages AS RawData
	INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
	ON
		RawData.OwnerOfProductPackaging = ProductPackages.Owner
		AND RawData.UnitOfMeasure = ProductPackages.UnitOfMeasure
WHERE
	(1 = &amp;QueryTextPackagingFactor1)
	AND (NOT ProductPackages.DeletionMark)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SUM(CASE
			WHEN SinglePackages.ZoomRatio = 1
					AND SinglePackages.UnitOfMeasure = SinglePackages.UnitOfProductMeasurement_
				THEN 1
			ELSE 0
		END) AS NumberOfSinglePackages,
	SinglePackages.Products
INTO OwnersUnitPackagingQuantity
FROM
	SinglePackages AS SinglePackages

GROUP BY
	SinglePackages.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN OwnersUnitPackagingQuantity.NumberOfSinglePackages = 1
			THEN SinglePackages.Package
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS Package,
	OwnersUnitPackagingQuantity.Products,
	CASE
		WHEN OwnersUnitPackagingQuantity.NumberOfSinglePackages &gt; 1
			THEN TRUE
		ELSE FALSE
	END AS NotOneSinglePackaging
INTO SinglePackagesOfProducts
FROM
	OwnersUnitPackagingQuantity AS OwnersUnitPackagingQuantity
		LEFT JOIN SinglePackages AS SinglePackages
		ON OwnersUnitPackagingQuantity.Products = SinglePackages.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	RawData.Products AS Products,
	RawData.Characteristic AS Characteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	RawData.Products.UnitOfMeasure AS UnitOfProductMeasurement_,
	CASE
		WHEN RawData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN RawData.Package.UnitOfMeasure
		ELSE CASE
				WHEN SinglePackagesOfProducts.Package IS NULL
					THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				ELSE SinglePackagesOfProducts.Package.UnitOfMeasure
			END
	END AS PackingUnit,
	CASE
		WHEN RawData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN RawData.Package
		ELSE CASE
				WHEN SinglePackagesOfProducts.Package IS NULL
					THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				ELSE SinglePackagesOfProducts.Package
			END
	END AS Package,
	CASE
		WHEN RawData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN &amp;QueryTextPackagingFactor3
		ELSE CASE
				WHEN SinglePackagesOfProducts.Package IS NULL
					THEN 0
				ELSE &amp;QueryTextPackagingFactor4
			END
	END AS ZoomRatio,
	ISNULL(SinglePackagesOfProducts.NotOneSinglePackaging, FALSE) AS NotOneSinglePackaging
INTO SourceDataExtended
FROM
	RawData AS RawData
		LEFT JOIN SinglePackagesOfProducts AS SinglePackagesOfProducts
		ON RawData.Products = SinglePackagesOfProducts.Products

GROUP BY
	RawData.Products,
	RawData.Characteristic,
	RawData.Products.UnitOfMeasure,
	CASE
		WHEN RawData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN RawData.Package.UnitOfMeasure
		ELSE CASE
				WHEN SinglePackagesOfProducts.Package IS NULL
					THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				ELSE SinglePackagesOfProducts.Package.UnitOfMeasure
			END
	END,
	CASE
		WHEN RawData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN RawData.Package
		ELSE CASE
				WHEN SinglePackagesOfProducts.Package IS NULL
					THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				ELSE SinglePackagesOfProducts.Package
			END
	END,
	ISNULL(SinglePackagesOfProducts.NotOneSinglePackaging, FALSE),
	CASE
		WHEN RawData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN &amp;QueryTextPackagingFactor3
		ELSE CASE
				WHEN SinglePackagesOfProducts.Package IS NULL
					THEN 0
				ELSE &amp;QueryTextPackagingFactor4
			END
	END

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SourceDataExtended.Products AS Products,
	SourceDataExtended.Characteristic AS Characteristic,
	ISNULL(Barcodes.Series, SourceDataExtended.Series) AS Series,
	SourceDataExtended.Package AS Package,
	ISNULL(Barcodes.Barcode, "") AS Barcode,
	CASE
		WHEN SourceDataExtended.Package = Barcodes.Package
			THEN 2
		ELSE 1
	END AS BarcodePriority
INTO Barcodes
FROM
	SourceDataExtended AS SourceDataExtended
		LEFT JOIN InformationRegister.ItemsBarcodes AS Barcodes
		ON SourceDataExtended.Products = Barcodes.Products
			AND SourceDataExtended.Characteristic = Barcodes.Characteristic
			AND (SourceDataExtended.Package = Barcodes.Package
				OR SourceDataExtended.ZoomRatio = 1
					AND SourceDataExtended.UnitOfProductMeasurement_ = SourceDataExtended.PackingUnit
					AND Barcodes.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Barcodes.Products,
	Barcodes.Characteristic,
	Barcodes.Series,
	Barcodes.Package,
	MAX(Barcodes.BarcodePriority) AS BarcodePriority
INTO TTBarcodePriority
FROM
	Barcodes AS Barcodes

GROUP BY
	Barcodes.Products,
	Barcodes.Series,
	Barcodes.Characteristic,
	Barcodes.Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Barcodes.Products AS Products,
	Barcodes.Characteristic AS Characteristic,
	Barcodes.Series AS Series,
	Barcodes.Package AS Package,
	MAX(Barcodes.Barcode) AS Barcode
INTO ItemsBarcodes
FROM
	Barcodes AS Barcodes
		INNER JOIN TTBarcodePriority AS TTBarcodePriority
		ON Barcodes.Products = TTBarcodePriority.Products
			AND Barcodes.Characteristic = TTBarcodePriority.Characteristic
			AND Barcodes.Series = TTBarcodePriority.Series
			AND Barcodes.Package = TTBarcodePriority.Package
			AND Barcodes.BarcodePriority = TTBarcodePriority.BarcodePriority
{WHERE
	Barcodes.Products.*,
	Barcodes.Characteristic.*,
	Barcodes.Series.*,
	Barcodes.Package.*}

GROUP BY
	Barcodes.Products,
	Barcodes.Characteristic,
	Barcodes.Series,
	Barcodes.Package

INDEX BY
	Products,
	Characteristic,
	Series,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	RawData.Products AS Products,
	RawData.Characteristic AS Characteristic,
	ISNULL(ItemsBarcodes.Series, RawData.Series) AS Series,
	RawData.UnitOfProductMeasurement_ AS UnitOfProductMeasurement_,
	RawData.PackingUnit AS PackingUnit,
	RawData.Package AS Package,
	RawData.ZoomRatio AS ZoomRatio,
	RawData.NotOneSinglePackaging AS NotOneSinglePackaging
INTO SourceDataExpandedWithBatches
FROM
	SourceDataExtended AS RawData
		LEFT JOIN ItemsBarcodes AS ItemsBarcodes
		ON RawData.Products = ItemsBarcodes.Products
			AND RawData.Characteristic = ItemsBarcodes.Characteristic
			AND RawData.Package = ItemsBarcodes.Package

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SourceDataLastRequest.Products AS Products,
	SourceDataLastRequest.Characteristic AS Characteristic,
	ItemsBarcodes.Series AS Series,
	CASE
		WHEN SourceDataLastRequest.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
				OR SourceDataLastRequest.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
				OR SourceDataLastRequest.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
			THEN TRUE
		ELSE FALSE
	END AS ItemVariantsAreUsed,
	
	SourceDataLastRequest.Package AS Package,
	CASE
		WHEN SourceDataLastRequest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN SourceDataLastRequest.Products.UnitOfMeasure
		ELSE SourceDataLastRequest.Package
	END AS PackagingUnitOfMeasure,
	CASE
		WHEN SourceDataLastRequest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN SourceDataLastRequest.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
						THEN TRUE
					ELSE FALSE
				END
		ELSE CASE
				WHEN SourceDataLastRequest.Package.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
					THEN TRUE
				ELSE FALSE
			END
	END AS SoldByWeight,
	ItemsBarcodes.Barcode AS Barcode,
	ItemsIDOfPeripheralsOffline.Code AS CodeOfConnectedEquipmentOffline,
	CASE WHEN &amp;RuleOfExportToScales THEN ItemsIDOfPeripheralsOffline.Code - &amp;MaximumCodeOfGoodsSoldByWeight
		ELSE ItemsIDOfPeripheralsOffline.Code
	END AS PLU,
	TypesOfPrices.Ref AS PriceKind,
	TypesOfPricesAdditionally.Ref AS PriceKindAdditional,
	Companies.Ref AS Organization,
	ItemPricesCrossSectionOfTheLatest.Price AS Price,
	ItemPricesCrossSectionOfTheLatest.Period AS LastPriceChangeDate,
	PricesOfProductRangeCutInAddition.Price AS PriceAdditionally,
	PricesOfProductRangeCutInAddition.Period AS LastPriceChangeDateAdditionally,
	1 AS Count,
	ProductStockBalance.InStockBalance AS WarehouseStockBalance,
	&amp;CurrentTime AS CurrentTime,
	Users.Ref AS CurrentUser,
	SourceDataLastRequest.NotOneSinglePackaging,
	CASE
		WHEN SourceDataLastRequest.NotOneSinglePackaging
			THEN SourceDataLastRequest.Products.UnitOfMeasure
		ELSE SourceDataLastRequest.Package.UnitOfMeasure
	END AS UnitOfMeasure,
	ISNULL(SourceDataLastRequest.Products.UsePackages, FALSE) AS UsePackages
{SELECT
	Products.*,
	Characteristic.*,
	Series.*,
	ItemVariantsAreUsed,
	Package.*,
	PackagingUnitOfMeasure,
	SoldByWeight,
	Barcode,
	CodeOfConnectedEquipmentOffline,
	PLU,
	PriceKind.*,
	PriceKindAdditional.*,
	Organization.*,
	Count,
	Price,
	PriceAdditionally,
	LastPriceChangeDate,
	LastPriceChangeDateAdditionally,
	WarehouseStockBalance,
	CurrentTime,
	CurrentUser.*}
FROM
	SourceDataExpandedWithBatches AS SourceDataLastRequest
		{LEFT JOIN ItemsBarcodes AS ItemsBarcodes
		ON SourceDataLastRequest.Products = ItemsBarcodes.Products
			AND SourceDataLastRequest.Characteristic = ItemsBarcodes.Characteristic
			AND SourceDataLastRequest.Series = ItemsBarcodes.Series
			AND SourceDataLastRequest.Package = ItemsBarcodes.Package}
		{LEFT JOIN InformationRegister.ItemsIDOfPeripheralsOffline AS ItemsIDOfPeripheralsOffline
		ON SourceDataLastRequest.Products = ItemsIDOfPeripheralsOffline.Products
			AND SourceDataLastRequest.Characteristic = ItemsIDOfPeripheralsOffline.Characteristic
			AND SourceDataLastRequest.Package = ItemsIDOfPeripheralsOffline.Package
			AND (&amp;ExchangeRule = ItemsIDOfPeripheralsOffline.ExchangeRule)}
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast(ENDOFPERIOD(&amp;Date, DAY), PriceKind = &amp;PriceKind {(Products).* AS Products, (Characteristic).* AS Characteristic}) AS ItemPricesCrossSectionOfTheLatest
		ON SourceDataLastRequest.Products = ItemPricesCrossSectionOfTheLatest.Products
			AND SourceDataLastRequest.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic}
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast(ENDOFPERIOD(&amp;DateAdditionally, DAY), PriceKind = &amp;PriceKindAdditional {(Products).* AS Products, (Characteristic).* AS Characteristic}) AS PricesOfProductRangeCutInAddition
		ON SourceDataLastRequest.Products = PricesOfProductRangeCutInAddition.Products
			AND SourceDataLastRequest.Characteristic = PricesOfProductRangeCutInAddition.Characteristic}
		{LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TypesOfPrices.Ref = &amp;PriceKind)}
		{LEFT JOIN Catalog.TypesOfPrices AS TypesOfPricesAdditionally
		ON (TypesOfPricesAdditionally.Ref = &amp;PriceKindAdditional)}
		{LEFT JOIN Catalog.Companies AS Companies
		ON (Companies.Ref = &amp;Organization)}
		{LEFT JOIN Catalog.Users AS Users
		ON (Users.Ref = &amp;CurrentUser)}
		{LEFT JOIN AccumulationRegister.ProductStock.Balance(
				,
				(Products, Characteristic, Series) IN
					(SELECT
						RawData.Products,
						RawData.Characteristic,
						RawData.Series
					FROM
						SourceDataExpandedWithBatches AS RawData) {(Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic, (Series).* AS Series}
		) AS ProductStockBalance
		ON SourceDataLastRequest.Products = ProductStockBalance.Products
			AND SourceDataLastRequest.Characteristic = ProductStockBalance.Characteristic
			AND SourceDataLastRequest.Series = ProductStockBalance.Series}
{WHERE
	SourceDataLastRequest.Products.* AS Products,
	SourceDataLastRequest.Characteristic.* AS Characteristic,
	SourceDataLastRequest.Series.* AS Series,
	SourceDataLastRequest.Package.* AS Package,
	ItemsBarcodes.Barcode AS Barcode,
	ItemsIDOfPeripheralsOffline.Code AS CodeOfConnectedEquipmentOffline,
	ItemPricesCrossSectionOfTheLatest.Price AS Price,
	ItemPricesCrossSectionOfTheLatest.Period AS LastPriceChangeDate,
	PricesOfProductRangeCutInAddition.Price AS PriceAdditionally,
	PricesOfProductRangeCutInAddition.Period AS LastPriceChangeDateAdditionally,
	ProductStockBalance.InStockBalance AS WarehouseStockBalance,
	(CASE
			WHEN SourceDataLastRequest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				THEN CASE
						WHEN SourceDataLastRequest.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
							THEN TRUE
						ELSE FALSE
					END
			ELSE CASE
					WHEN SourceDataLastRequest.Package.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
						THEN TRUE
					ELSE FALSE
				END
		END) AS SoldByWeight}

ORDER BY
	SourceDataLastRequest.Products.Description</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<parameter>
		<name>PriceKind</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
