  </attributes>
  <attributes>
    <name>TransportationJobsInProgress</name>
    <title>
      <key>en</key>
      <value>Itineraries in progress</value>
    </title>
    <title>
      <key>fa</key>
      <value>مسیرهای در جریان</value>
    </title>
    <title>
      <key>it</key>
      <value>Task di trasporto in lavorazione</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zadania przewozu w toku</value>
    </title>
    <title>
      <key>ru</key>
      <value>Задания на перевозку в работе</value>
    </title>
    <title>
      <key>tr</key>
      <value>İşlemde taşıma planları</value>
    </title>
    <title>
      <key>vi</key>
      <value>Nhiệm vụ vận chuyển đang làm việc</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>TransportationJobsInProgress.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>TransportationJobsInProgress.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	DocumentTransportationJob.Ref,
	DocumentTransportationJob.DeletionMark,
	DocumentTransportationJob.Number,
	DocumentTransportationJob.Date,
	DocumentTransportationJob.Posted,
	CAST(DocumentTransportationJob.AdditionalInformation AS STRING(1000)) AS AdditionalInformation,
	DocumentTransportationJob.Status,
	CAST(DocumentTransportationJob.Comment AS STRING(1000)) AS Comment,
	DocumentTransportationJob.EmployeeResponsible,
	DocumentTransportationJob.PlanTripStartTime,
	DocumentTransportationJob.PlanTripEndTime,
	DocumentTransportationJob.ActualTripStartTime,
	DocumentTransportationJob.ActualTripEndTime,
	DocumentTransportationJob.Vehicle_,
	DocumentTransportationJob.CourierShippingAgent,
	DocumentTransportationJob.Driver,
	DocumentTransportationJob.Warehouse,
	DocumentTransportationJob.Weight,
	DocumentTransportationJob.VolumeM3,
	DocumentTransportationJob.PointsNumber,
	DocumentTransportationJob.Priority,
	DocumentTransportationJob.Operation,
	CASE
		WHEN DocumentTransportationJob.JobIsPerformedBy = VALUE(Enum.TypesOfTransportationJobAssignees.OurTransportationService)
			THEN 1
		ELSE 0
	END AS ThisIsOurDelivery,
	DocumentTransportationJob.JobIsPerformedBy
FROM
	Document.TransportationJob AS DocumentTransportationJob
		LEFT JOIN Document.TransportationJob.Route AS TaskForTransportationRoute
		ON (TaskForTransportationRoute.Ref = DocumentTransportationJob.Ref)
{WHERE
	TaskForTransportationRoute.Zone.*}</queryText>
      <mainTable>Document.TransportationJob</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
