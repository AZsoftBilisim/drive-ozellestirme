  <attributes>
    <name>ListReferencesForRegistration</name>
    <title>
      <key>en</key>
      <value>List references for registration</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست مراجع برای ثبت</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco disposizioni da formalizzare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista zamówienia do rejestracji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список распоряжения на оформление</value>
    </title>
    <title>
      <key>tr</key>
      <value>Yürütülen siparişlerin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách thứ tự thực hiện</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseAdvancedFeaturesOfSalesOrder</functionalOptions>
    <functionalOptions>FunctionalOption.UseWarehouseManagemantSystemForGoodsIssue</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Contract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Department</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.ForeignCurrencyTransaction</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.InvoiceStatus</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.NoteState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	Table.ReferenceOrder AS ReferenceOrder
INTO CurrentOrders
FROM
	InformationRegister.ShipmentAndReturnReferencesToFulfill AS Table
WHERE
	VALUETYPE(Table.ReferenceOrder) = TYPE(Document.SaleAdjustment)
	AND CAST(Table.ReferenceOrder AS Document.SaleAdjustment).BusinessOperation IN
		(VALUE(Enum.BusinessTransactions.TransferOfTitleToGoods),
		VALUE(Enum.BusinessTransactions.SaleToCustomer))

INDEX
BY
	ReferenceOrder
;

SELECT ALLOWED
	Table.DocumentInflow AS DocumentInflow,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Warehouse AS Warehouse,
	0 AS ReceiptState,
	CASE
		WHEN NOT Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
				OR Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					AND Table.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt > &amp;CurrentDate
			THEN 4
		ELSE 0
	END AS StatusOfTheReceiptOrder,
	Table.ToRegisterInvoicesByReferenceBalance AS ToRegisterInvoices,
	Table.ToRegisterGoodsReceiptsBalance AS ToRegisterGoodsReceipts,
	Table.GoodsReceiptNotesToRegisterBalance AS GoodsReceiptNotesToRegister
INTO TueRegistrationDocumentsForBalances
FROM
	AccumulationRegister.GoodsToReceive.Balance(
			,
			DocumentInflow REFS Document.RequestForReturnOfGoodsFromCustomer
				OR DocumentInflow REFS Document.ReturnOfGoodsFromCustomer
				OR DocumentInflow REFS Document.ReceiptOfGoodsFromCustodian
					AND CAST(DocumentInflow AS Document.ReceiptOfGoodsFromCustodian).BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReturnFromCustodian),
																														VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent))
				OR DocumentInflow REFS Document.GoodsReceiptFromCustomer 
					AND CAST(DocumentInflow AS Document.ReceiptOfGoodsFromCustodian).BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsReceiptFromCustomer)
			
				{(Warehouse = &amp;Warehouse)}) AS Table
WHERE
	(Table.ToRegisterInvoicesByReferenceBalance > 0
			OR Table.ToRegisterGoodsReceiptsBalance > 0
			OR Table.GoodsReceiptNotesToRegisterBalance > 0)

UNION ALL

SELECT
	Table.ReferenceOrder AS DocumentInflow,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	CASE
		WHEN CAST(ReferenceOrder AS Document.SaleAdjustment).Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
			THEN VALUE(Catalog.Warehouses.EmptyRef)
		ELSE CAST(ReferenceOrder AS Document.SaleAdjustment).Warehouse
	END AS Warehouse,
	0 AS ReceiptState,
	0 AS StatusOfTheReceiptOrder,
	SUM(CASE
		WHEN Table.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ForReceiving)
			THEN Table.CountTurnover
		WHEN Table.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Accepted)
			THEN -Table.CountTurnover
		ELSE 0
	END) AS ToRegisterInvoices,
	0 AS ToRegisterGoodsReceipts,
	0 AS GoodsReceiptNotesToRegister
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(,,,
			ReferenceOrder IN
				(SELECT
					CurrentOrders.ReferenceOrder
				FROM
					CurrentOrders AS CurrentOrders)
			AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ForReceiving),
				VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Accepted))
			{(Warehouse = &amp;Warehouse)}) AS Table
GROUP BY
	Table.ReferenceOrder,
	Table.Products,
	Table.Characteristic

INDEX BY
	DocumentInflow,
	Products,
	Characteristic,
	Purpose,
	Warehouse
;

SELECT
	Table.DocumentInflow AS DocumentInflow,
	Table.Warehouse AS Warehouse,
	SUM(Table.ToRegisterInvoices) AS ToIssueInvoicesInTotal,
	SUM(Table.ToRegisterGoodsReceipts) AS ToProcessReceiptsForOrdersTotal,
	SUM(Table.GoodsReceiptNotesToRegister) AS ToExecuteOrdersInTotal
INTO TueRegistrationDocumentsTotalBalances
FROM
	TueRegistrationDocumentsForBalances AS Table

GROUP BY
	Table.DocumentInflow,
	Table.Warehouse

INDEX BY
	Table.DocumentInflow,
	Table.Warehouse
;

SELECT
	Table.DocumentInflow AS DocumentInflow,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Warehouse AS Warehouse,
	MAX(Table.ReceiptState) AS ReceiptState,
	MAX(Table.StatusOfTheReceiptOrder) AS StatusOfTheReceiptOrder,
	MAX(Table.ToRegisterInvoices) AS ToRegisterInvoices,
	MAX(Table.ToRegisterGoodsReceipts) AS ToRegisterGoodsReceipts,
	MAX(Table.GoodsReceiptNotesToRegister) AS GoodsReceiptNotesToRegister,
	ISNULL(TheTableRemainsJust.ToIssueInvoicesInTotal, 0) AS ToIssueInvoicesInTotal,
	ISNULL(TheTableRemainsJust.ToProcessReceiptsForOrdersTotal, 0) AS ToProcessReceiptsForOrdersTotal,
	ISNULL(TheTableRemainsJust.ToExecuteOrdersInTotal, 0) AS ToExecuteOrdersInTotal
INTO TueRegistrationDocuments
FROM
	(
	SELECT
		Table.DocumentInflow AS DocumentInflow,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Purpose AS Purpose,
		Table.Warehouse AS Warehouse,
		Table.ReceiptState AS ReceiptState,
		Table.StatusOfTheReceiptOrder AS StatusOfTheReceiptOrder,
		Table.ToRegisterInvoices AS ToRegisterInvoices,
		Table.ToRegisterGoodsReceipts AS ToRegisterGoodsReceipts,
		Table.GoodsReceiptNotesToRegister AS GoodsReceiptNotesToRegister
	FROM
		TueRegistrationDocumentsForBalances AS Table

	UNION ALL

	SELECT
		Table.DocumentInflow AS DocumentInflow,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Purpose AS Purpose,
		Table.Warehouse AS Warehouse,
		0 AS ReceiptState,
		CASE
			WHEN NOT Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
						AND Table.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt > &amp;CurrentDate
				THEN 4
			ELSE 0
		END AS StatusOfTheReceiptOrder,
		0 AS ToRegisterInvoices,
		0 AS ToRegisterGoodsReceipts,
		0 AS GoodsReceiptNotesToRegister
	FROM
		AccumulationRegister.GoodsToReceive AS Table
	WHERE
		Table.DocumentInflow IN
			(
			SELECT
				DocumentsTable.DocumentInflow
			FROM
				TueRegistrationDocumentsForBalances AS DocumentsTable
			)
	) AS Table
	LEFT JOIN TueRegistrationDocumentsTotalBalances AS TheTableRemainsJust
	ON Table.DocumentInflow = TheTableRemainsJust.DocumentInflow
	AND Table.Warehouse = TheTableRemainsJust.Warehouse

GROUP BY
	Table.DocumentInflow,
	Table.Products,
	Table.Characteristic,
	Table.Purpose,
	Table.Warehouse,
	ISNULL(TheTableRemainsJust.ToIssueInvoicesInTotal, 0),
	ISNULL(TheTableRemainsJust.ToProcessReceiptsForOrdersTotal, 0),
	ISNULL(TheTableRemainsJust.ToExecuteOrdersInTotal, 0)

INDEX BY
	Table.DocumentInflow,
	Table.Products,
	Table.Characteristic,
	Table.Purpose,
	Table.Warehouse

;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.DocumentInflow AS Ref,
	Table.Warehouse AS Warehouse,
	MAX(CASE
			WHEN Table.DocumentInflow REFS Document.ReturnOfGoodsFromCustomer
					OR Table.DocumentInflow REFS Document.ReceiptOfGoodsFromCustodian
					OR Table.DocumentInflow REFS Document.SaleAdjustment
				THEN 4
			WHEN Table.ToRegisterInvoices = 0
				THEN 0
			WHEN Table.ToRegisterInvoices > 0
					AND ISNULL(TheInvoicesTableIsRedefined.ToRegisterInvoicesByReference, 0) = 0
				THEN 1
			WHEN Table.ToRegisterInvoices > 0
					AND ISNULL(TheInvoicesTableIsRedefined.ToRegisterInvoicesByReference, 0) > 0
				THEN 2
			ELSE 0
		END) AS ReceiptState,
	MAX(CASE
			WHEN Table.DocumentInflow REFS Document.SaleAdjustment
				THEN 4
			WHEN NOT Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
						AND Table.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt > &amp;CurrentDate
				THEN 4
			WHEN ISNULL(TableOrdersOverridable.ToRegisterGoodsReceipts, 0) = 0
					AND Table.GoodsReceiptNotesToRegister = 0
				THEN 0
			WHEN Table.GoodsReceiptNotesToRegister > 0
					AND ISNULL(TableOrdersOverridable.ToRegisterGoodsReceipts, 0) = 0
				THEN 1
			WHEN Table.ToProcessReceiptsForOrdersTotal &lt;> 0
				THEN 3
			ELSE 0
		END) AS StatusOfTheReceiptOrder
INTO WDocumentsWithTheState
FROM
	TueRegistrationDocuments AS Table
		LEFT JOIN AccumulationRegister.GoodsToReceive AS TableOrdersOverridable
		ON Table.DocumentInflow = TableOrdersOverridable.DocumentInflow
			AND Table.Products = TableOrdersOverridable.Products
			AND Table.Characteristic = TableOrdersOverridable.Characteristic
			AND Table.Purpose = TableOrdersOverridable.Purpose
			AND Table.Warehouse = TableOrdersOverridable.Warehouse
			AND (TableOrdersOverridable.Active)
			AND (TableOrdersOverridable.RecordType = VALUE(AccumulationRecordType.Receipt))
			AND (TableOrdersOverridable.Recorder REFS Document.GoodsReceiptNote)
		LEFT JOIN AccumulationRegister.GoodsToReceive AS TheInvoicesTableIsRedefined
		ON Table.DocumentInflow = TheInvoicesTableIsRedefined.DocumentInflow
			AND Table.Products = TheInvoicesTableIsRedefined.Products
			AND Table.Characteristic = TheInvoicesTableIsRedefined.Characteristic
			AND Table.Purpose = TheInvoicesTableIsRedefined.Purpose
			AND Table.Warehouse = TheInvoicesTableIsRedefined.Warehouse
			AND (TheInvoicesTableIsRedefined.Active)
			AND (TheInvoicesTableIsRedefined.Recorder REFS Document.ReturnOfGoodsFromCustomer)

GROUP BY
	Table.DocumentInflow,
	Table.Warehouse

HAVING
	NOT(
	MAX(CASE
					WHEN Table.DocumentInflow REFS Document.ReturnOfGoodsFromCustomer
						OR Table.DocumentInflow REFS Document.ReceiptOfGoodsFromCustodian
						THEN 4
					WHEN Table.ToRegisterInvoices = 0
						THEN 0
					WHEN Table.ToRegisterInvoices > 0
							AND ISNULL(TheInvoicesTableIsRedefined.ToRegisterInvoicesByReference, 0) = 0
						THEN 1
					WHEN Table.ToRegisterInvoices > 0
							AND ISNULL(TheInvoicesTableIsRedefined.ToRegisterInvoicesByReference, 0) > 0
						THEN 2
					ELSE 0
				END) IN (0, 4)
			AND MAX(CASE
					WHEN NOT Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
							OR Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
								AND Table.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt > &amp;CurrentDate
						THEN 4
					WHEN ISNULL(TableOrdersOverridable.ToRegisterGoodsReceipts, 0) = 0
							AND Table.GoodsReceiptNotesToRegister = 0
						THEN 0
					WHEN Table.GoodsReceiptNotesToRegister > 0
							AND ISNULL(TableOrdersOverridable.ToRegisterGoodsReceipts, 0) = 0
						THEN 1
					WHEN Table.ToProcessReceiptsForOrdersTotal &lt;> 0
						THEN 3
					ELSE 0
				END) IN (0, 4))

INDEX BY
	Table.DocumentInflow,
	Table.Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Table.Ref AS Ref,
	Table.Warehouse AS Warehouse,
	Table.ReceiptState AS InvoiceStatus,
	Table.StatusOfTheReceiptOrder AS NoteState,
	Register3.IBDocumentDate AS Date,
	Register3.IBDocumentNumber AS Number,
	VALUETYPE(Table.Ref) AS TypeOfOrder_,
	Register3.Organization AS Organization,
	Register3.BusinessOperation AS BusinessOperation,
	Register3.Partner AS Partner,
	CAST(Register3.Counterparty.Key AS Catalog.Counterparties) AS Counterparty,
	Register3.Department AS Department,
	Register3.EmployeeResponsible AS EmployeeResponsible,
	Register3.Currency AS Currency,
	Register3.Sum AS Sum,
	Register3.Comment AS Comment,
	Register3.DeletionMark AS DeletionMark,
	CASE
		WHEN Register3.Ref REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Register3.Ref AS Document.RequestForReturnOfGoodsFromCustomer).Contract
		WHEN Register3.Ref REFS Document.ReturnOfGoodsFromCustomer
			THEN CAST(Register3.Ref AS Document.ReturnOfGoodsFromCustomer).Contract
		WHEN Register3.Ref REFS Document.ReceiptOfGoodsFromCustodian
			THEN CAST(Register3.Ref AS Document.ReceiptOfGoodsFromCustodian).Contract
	END AS Contract,
	CASE
		WHEN Register3.Ref REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Register3.Ref AS Document.RequestForReturnOfGoodsFromCustomer).Terms
		WHEN Register3.Ref REFS Document.ReturnOfGoodsFromCustomer
			THEN CAST(Register3.Ref AS Document.ReturnOfGoodsFromCustomer).Terms
		WHEN Register3.Ref REFS Document.ReceiptOfGoodsFromCustodian
			THEN CAST(Register3.Ref AS Document.ReceiptOfGoodsFromCustodian).Terms
	END AS Terms,
	CASE
		WHEN Register3.Ref REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Register3.Ref AS Document.RequestForReturnOfGoodsFromCustomer).ForeignCurrencyTransaction
		WHEN Register3.Ref REFS Document.ReturnOfGoodsFromCustomer
			THEN CAST(Register3.Ref AS Document.ReturnOfGoodsFromCustomer).ForeignCurrencyTransaction
		WHEN Register3.Ref REFS Document.ReceiptOfGoodsFromCustodian
			THEN FALSE
	END AS ForeignCurrencyTransaction
FROM
	WDocumentsWithTheState AS Table
		INNER JOIN InformationRegister.DocumentsRegistry AS Register3
		ON Table.Ref = Register3.Ref</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
