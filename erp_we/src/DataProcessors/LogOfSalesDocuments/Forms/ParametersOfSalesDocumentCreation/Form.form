            <value>Transfer of goods</value>
          </title>
          <title>
            <key>fa</key>
            <value>انتقال کالا</value>
          </title>
          <title>
            <key>it</key>
            <value>Trasferimento articoli</value>
          </title>
          <title>
            <key>pl</key>
            <value>Przeniesienie towarów</value>
          </title>
          <title>
            <key>ru</key>
            <value>Передачу товаров</value>
