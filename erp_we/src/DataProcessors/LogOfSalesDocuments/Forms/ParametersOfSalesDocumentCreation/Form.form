        <items xsi:type="form:FormField">
          <name>PrintSale</name>
          <id>45</id>
          <title>
            <key>en</key>
            <value>Sales</value>
          </title>
          <title>
            <key>fa</key>
            <value>فروش</value>
          </title>
          <title>
            <key>it</key>
            <value>Vendita</value>
