  <attributes>
    <name>ListForTransferOfOwnership</name>
    <title>
      <key>en</key>
      <value>List for transfer of title to goods</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست برای انتقال مالکیت کالا</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список к переходу права собственности</value>
    </title>
    <title>
      <key>tr</key>
      <value>Mülkiyet hakkı devri listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chuyển quyền sở hữu</value>
    </title>
    <title>
      <key>it</key>
      <value>List for transfer of title to goods</value>
    </title>
    <title>
      <key>pl</key>
      <value>List for transfer of title to goods</value>
    </title>
    <id>35</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListForTransferOfOwnership.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListForTransferOfOwnership.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListForTransferOfOwnership.ReferenceOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText> SELECT ALLOWED DISTINCT
	Table.ReferenceOrder AS ReferenceOrder,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Ref
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Ref
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).Ref
    END AS Ref,
	VALUETYPE(Table.ReferenceOrder) AS TypeOfOrder_,

	Table.Organization AS Organization,
	Table.Number AS Number,
	Table.DocumentAmount AS DocumentAmount,
	Table.Currency AS Currency,
	Table.BusinessOperation AS BusinessOperation,
	Table.Partner AS Partner,
	Table.Counterparty AS Counterparty,
	Table.Manager AS Manager,

	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Date
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Date
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).Date
	END AS DocumentDate,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).DeletionMark
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).DeletionMark
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).DeletionMark
	END AS DeletionMark,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Posted
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Posted
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).Posted
	END AS Posted,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Terms
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Terms
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).Terms
	END AS Terms,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Contract
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Contract
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).Contract
	END AS Contract,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).SalesOpportunity
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).SalesOpportunity
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).SalesOpportunity
	END AS SalesOpportunity,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).DocumentBasis
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).DocumentSalesOfGoodsAndServices
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).SalesOrder
	END AS DocumentBasis,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Priority
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Priority
	END AS Priority,
   	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).PaymentSchedule
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).PaymentSchedule
	END AS PaymentSchedule,

	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).CashAccount
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).CashAccount
	END AS CashAccount,
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).DeliveryMethod
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).DeliveryMethod
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).DeliveryMethod
	END AS DeliveryMethod,
	FALSE AS SplitInvoiceByWarehouses,
	FALSE AS CombineSalesByWarehouse,	
	CASE
		WHEN CASE
			WHEN Table.ReferenceOrder REFS Document.SalesOrder
				THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Priority
			WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
				THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Priority
		END IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN CASE
			WHEN Table.ReferenceOrder REFS Document.SalesOrder
				THEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Priority
			WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
				THEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Priority
		END IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	
	CASE
		WHEN Table.ReferenceOrder REFS Document.SalesOrder
			THEN
				CASE
					WHEN CAST(Table.ReferenceOrder AS Document.SalesOrder).Posted
						THEN 0
					WHEN CAST(Table.ReferenceOrder AS Document.SalesOrder).DeletionMark
						THEN 1
					ELSE 2
				END
		WHEN Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
			THEN
				CASE
					WHEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Posted
						THEN 0
					WHEN CAST(Table.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).DeletionMark
						THEN 1
					ELSE 2
				END
		WHEN Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer
			THEN
				CASE
					WHEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).Posted
						THEN 0
					WHEN CAST(Table.ReferenceOrder AS Document.GoodsShipmentToCustomer).DeletionMark
						THEN 1
					ELSE 2
				END
	END AS CustomPicture
FROM
	InformationRegister.ShipmentAndReturnReferencesToFulfill AS Table
WHERE
	(Table.ReferenceOrder REFS Document.SalesOrder
		OR Table.ReferenceOrder REFS Document.RequestForReturnOfGoodsFromCustomer
		OR Table.ReferenceOrder REFS Document.GoodsShipmentToCustomer)
	AND Table.StateOfGoodsToTransferOfTitleToGoods &lt;> VALUE(Enum.StateOfRegisteringDocumentsByReference.Decorated)
	AND (&amp;Organization = VALUE(Catalog.Companies.EmptyRef) OR Table.Organization = &amp;Organization)
	
</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
