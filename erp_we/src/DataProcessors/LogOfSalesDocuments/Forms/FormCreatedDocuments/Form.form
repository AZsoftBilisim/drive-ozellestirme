  <attributes>
    <name>ListCreatedDocuments</name>
    <title>
      <key>en</key>
      <value>List created documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد ایجادشده</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco dei documenti creati</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista utworzone dokumenty</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список созданные документы</value>
    </title>
    <title>
      <key>tr</key>
      <value>Oluşturulmuş belgelerin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Liệt kê các chứng từ đã tạo</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListCreatedDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DocumentsRegistry.Ref,
	DocumentsRegistry.Posted,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.DeletionMark,
	CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.Warehouses) AS Warehouse,
	DocumentsRegistry.Currency,
	DocumentsRegistry.Sum AS DocumentAmount,
	DocumentsRegistry.Organization,
	DocumentsRegistry.BusinessOperation AS Operation,
	VALUETYPE(DocumentsRegistry.Ref) AS ValueType,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		ELSE CASE
				WHEN DocumentsRegistry.DeletionMark
					THEN 1
				ELSE 2
			END
	END AS Picture
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
{WHERE
	DocumentsRegistry.RefType IN (&amp;ArrayOfIdentifiers)
}
WHERE
	NOT DocumentsRegistry.AdditionalRecord
{WHERE
	DocumentsRegistry.Ref.* AS Ref,
	CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.Warehouses) AS Warehouse,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.BusinessOperation AS Operation,
	DocumentsRegistry.Contract.* AS Contract,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
