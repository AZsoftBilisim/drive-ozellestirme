			<field>CalculationSeparator</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// !!! TAGS ARE USED !!!

SELECT ALLOWED
	SegmentProducts.Products AS Products,
	SegmentProducts.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS SegmentProducts
{WHERE
	SegmentProducts.Segment.* AS ProductSegment,
	SegmentProducts.Products.*,
	SegmentProducts.Characteristic.*}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN TableOfPlans.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN TableOfPlans.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN TableOfPlans.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN TableOfPlans.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN TableOfPlans.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN TableOfPlans.YearPeriod
		ELSE TableOfPlans.DayPeriod
	END AS DemandPeriodStart,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	TableOfPlans.Warehouse AS Warehouse,
	TableOfPlans.ToOrderTurnover AS QuantityInPlans,
	ISNULL(Approaches.OrderFulfillmentPeriod, 0) AS DaysBeforeOrdering,
	CASE
		WHEN ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
			THEN MainEnterpriseCalendar.Value
		ELSE ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef))
	END AS Calendar,
	TableOfPlans.AssigneeBusinessUnit AS AssigneeBusinessUnit,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(TableOfPlans.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(TableOfPlans.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(TableOfPlans.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(TableOfPlans.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(TableOfPlans.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(TableOfPlans.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(TableOfPlans.DayPeriod, DAY)
	END AS DemandPeriodEnd,
	TableOfPlans.ProductionDispatcherBusinessUnit,
	TableOfPlans.AssigneeBusinessUnit,
	ISNULL(Approaches.Ref, VALUE(Catalog.ProcurementStrategies.EmptyRef)) AS SupplyMethod
INTO TableOfPlans
FROM
	AccumulationRegister.MaterialConsumptionPlans.Turnovers(
			&amp;BeginOfPeriod {(&amp;BeginOfPeriod)},
			&amp;PeriodEnding {(&amp;PeriodEnding)},
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND (AssigneeBusinessUnit = &amp;AssigneeBusinessUnit
				OR NOT &amp;FilterDepartments)
				AND (NOT &amp;FilterByAssignment
				OR Purpose = &amp;Purpose) {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS TableOfPlans
		LEFT JOIN Catalog.ProcurementStrategies AS Approaches
		ON &amp;MainSupplyMethodSubstitution
			AND (Approaches.SupplyType = VALUE(Enum.SupplyTypes.Production))
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON TableOfPlans.Warehouse = Warehouses.Ref
		LEFT JOIN Catalog.SalesOperationsPlanningScenarios AS PlanningScenarios
		ON TableOfPlans.Scenario = PlanningScenarios.Ref,
	Constant.MainEnterpriseCalendar AS MainEnterpriseCalendar

INDEX BY
	Products,
	Characteristic,
	Purpose,
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.Calendar,
	CalendarSchedules.Year,
	MAX(CalendarSchedules.DaysCountInScheduleSinceBegOfYear) AS DaysCountInScheduleSinceBegOfYear
INTO ChartsNumberOfDaysInPastYear
FROM
	TableOfPlans AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS CalendarSchedules
		ON TableOfPlans.Calendar = CalendarSchedules.Calendar
			AND (YEAR(TableOfPlans.DemandPeriodStart) - 1 = CalendarSchedules.Year)
WHERE
	CalendarSchedules.Year &gt; 0

GROUP BY
	TableOfPlans.Calendar,
	CalendarSchedules.Year
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	TableOfPlans.Warehouse AS Warehouse,
	TableOfPlans.Calendar AS Calendar,
	SUM(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	TableOfPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	CASE
		WHEN ScheduleBuildDate.ScheduleDate IS NULL 
			THEN DATEADD(TableOfPlans.DemandPeriodStart, DAY, -TableOfPlans.DaysBeforeOrdering)
		ELSE ScheduleOrderDate.ScheduleDate
	END AS OrderDate,
	TableOfPlans.DemandPeriodStart,
	TableOfPlans.DemandPeriodEnd,
	TableOfPlans.SupplyMethod,
	TableOfPlans.AssigneeBusinessUnit
INTO TableOfPlans1
FROM
	TableOfPlans AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleBuildDate
		ON TableOfPlans.Calendar = ScheduleBuildDate.Calendar
			AND TableOfPlans.DemandPeriodStart = ScheduleBuildDate.ScheduleDate
			AND (YEAR(TableOfPlans.DemandPeriodStart) = ScheduleBuildDate.Year)
		LEFT JOIN ChartsNumberOfDaysInPastYear AS ChartsLastYear
		ON (YEAR(TableOfPlans.DemandPeriodStart) - 1 = ChartsLastYear.Year)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL 
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN TRUE
				ELSE FALSE
			END)
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleOrderDate
		ON TableOfPlans.Calendar = ScheduleOrderDate.Calendar
			AND (ScheduleOrderDate.DayAddedToSchedule)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL 
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN YEAR(TableOfPlans.DemandPeriodStart) - 1 = ScheduleOrderDate.Year
				ELSE YEAR(TableOfPlans.DemandPeriodStart) = ScheduleOrderDate.Year
			END)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL 
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN CASE
							WHEN ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.DaysBeforeOrdering - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) &lt;= 0
								THEN ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear = 1
							ELSE ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.DaysBeforeOrdering - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) = ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear
						END
				ELSE ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) - TableOfPlans.DaysBeforeOrdering = ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear
			END)
		LEFT JOIN Catalog.Warehouses AS Warehouses
			ON Warehouses.Ref = TableOfPlans.Warehouse
			
WHERE
	CASE
			WHEN &amp;OrderStartDate = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE CASE
					WHEN ScheduleBuildDate.ScheduleDate IS NULL 
						THEN DATEADD(TableOfPlans.DemandPeriodStart, DAY, -TableOfPlans.DaysBeforeOrdering)
					ELSE ScheduleOrderDate.ScheduleDate
				END &gt;= &amp;OrderStartDate
		END
	AND CASE
			WHEN &amp;OrderEndDate = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE CASE
					WHEN ScheduleBuildDate.ScheduleDate IS NULL 
						THEN DATEADD(TableOfPlans.DemandPeriodStart, DAY, -TableOfPlans.DaysBeforeOrdering)
					ELSE ScheduleOrderDate.ScheduleDate
				END &lt;= &amp;OrderEndDate
		END
	AND Warehouses.ShopFloorStockroom
	AND Warehouses.Department = TableOfPlans.AssigneeBusinessUnit

GROUP BY
	TableOfPlans.Products,
	TableOfPlans.Characteristic,
	TableOfPlans.Purpose,
	TableOfPlans.Warehouse,
	TableOfPlans.DaysBeforeOrdering,
	TableOfPlans.Calendar,
	TableOfPlans.DemandPeriodStart,
	TableOfPlans.DemandPeriodEnd,
	CASE
		WHEN ScheduleBuildDate.ScheduleDate IS NULL 
			THEN DATEADD(TableOfPlans.DemandPeriodStart, DAY, -TableOfPlans.DaysBeforeOrdering)
		ELSE ScheduleOrderDate.ScheduleDate
	END,
	TableOfPlans.SupplyMethod,
	TableOfPlans.AssigneeBusinessUnit

INDEX BY
	Products,
	Characteristic,
	Purpose,
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
DROP TableOfPlans
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfPlans.Calendar AS Calendar,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	ISNULL(CatMethod.SourceOfDemandSupply, VALUE(Catalog.Warehouses.EmptyRef)) AS SupplyWarehouse,
	ISNULL(CatMethod.SourceOfDemandSupply, VALUE(Catalog.Warehouses.EmptyRef)) AS Warehouse,
	MAX(CatProducts.SKU) AS SKU,
	MAX(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	ISNULL(SUM(Orders.Count), 0) AS QuantityInOrders,
	MAX(TableOfPlans.QuantityInPlans) - ISNULL(SUM(Orders.Count), 0) AS NumberOfPackages,
	MAX(TableOfPlans.QuantityInPlans) - ISNULL(SUM(Orders.Count), 0) AS Count,
	MAX(CASE
			WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
				THEN TRUE
			ELSE FALSE
		END) AS ItemVariantsAreUsed,
	MIN(TableOfPlans.DaysBeforeOrdering) AS DaysBeforeOrdering,
	TableOfPlans.OrderDate,
	TableOfPlans.DemandPeriodEnd,
	TableOfPlans.DemandPeriodStart,
	TableOfPlans.SupplyMethod,
	TableOfPlans.AssigneeBusinessUnit,
	TableOfPlans.Warehouse AS ShopFloorStockroom
{SELECT
	Products.*,
	Characteristic.*,
	Purpose.*,
	SKU,
	QuantityInPlans,
	QuantityInOrders,
	NumberOfPackages,
	Count,
	ItemVariantsAreUsed,
	DaysBeforeOrdering,
	SupplyWarehouse}
INTO SecuredPlans	
FROM
	TableOfPlans1 AS TableOfPlans
		INNER JOIN Catalog.Products AS CatProducts
		ON TableOfPlans.Products = CatProducts.Ref
		LEFT JOIN Document.OrderOfMaterialsForProduction.Goods AS Orders
		ON TableOfPlans.Products = Orders.Products
			AND TableOfPlans.Characteristic = Orders.Characteristic
			AND (CASE 
				WHEN NOT &amp;PlanningByAssignments
					THEN TRUE 
				ELSE TableOfPlans.Purpose = Orders.Purpose
			END)
			AND (Orders.Ref.Posted)
			AND (NOT Orders.Canceled)
			AND (CASE
				WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
					THEN TRUE
				ELSE TableOfPlans.Warehouse = Orders.Ref.ShopFloorStockroom
			END)
			AND (Orders.ShipmentStart BETWEEN TableOfPlans.DemandPeriodStart AND TableOfPlans.DemandPeriodEnd)
			AND (Orders.Ref.Department = TableOfPlans.AssigneeBusinessUnit)
		LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON &amp;MainSupplyMethodSubstitution
	
GROUP BY
	TableOfPlans.Calendar,
	TableOfPlans.Products,
	TableOfPlans.Characteristic,
	TableOfPlans.Purpose,
	ISNULL(CatMethod.SourceOfDemandSupply, VALUE(Catalog.Warehouses.EmptyRef)),
	TableOfPlans.OrderDate,
	TableOfPlans.DemandPeriodEnd,
	TableOfPlans.DemandPeriodStart,
	TableOfPlans.SupplyMethod,
	TableOfPlans.AssigneeBusinessUnit,
	TableOfPlans.Warehouse

{WHERE
	ISNULL(CatMethod.SourceOfDemandSupply, VALUE(Catalog.Warehouses.EmptyRef)) AS SupplyWarehouse}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlans.Calendar AS Calendar,
	SecuredPlans.Products AS Products,
	SecuredPlans.Characteristic AS Characteristic,
	SecuredPlans.Purpose AS Purpose,
	SecuredPlans.Warehouse AS Warehouse,
	SecuredPlans.SupplyWarehouse AS SupplyWarehouse,
	SecuredPlans.SKU AS SKU,
	SUM(SecuredPlans.QuantityInPlans) AS QuantityInPlans,
	SUM(SecuredPlans.QuantityInOrders) AS QuantityInOrders,
	SUM(SecuredPlans.NumberOfPackages) AS NumberOfPackages,
	SUM(SecuredPlans.Count) AS Count,
	SecuredPlans.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	SecuredPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	MAX(SecuredPlans.OrderDate) AS OrderDate,
	MAX(SecuredPlans.DemandPeriodEnd) AS DemandPeriodEnd,
	MAX(SecuredPlans.DemandPeriodStart) AS DemandPeriodStart,
	SecuredPlans.SupplyMethod AS SupplyMethod,
	SecuredPlans.AssigneeBusinessUnit AS AssigneeBusinessUnit,
	SecuredPlans.ShopFloorStockroom AS ShopFloorStockroom
FROM
	SecuredPlans AS SecuredPlans

GROUP BY
	SecuredPlans.Calendar,
	SecuredPlans.Products,
	SecuredPlans.Characteristic,
	SecuredPlans.Purpose,
	SecuredPlans.Warehouse,
	SecuredPlans.SupplyWarehouse,
	SecuredPlans.SKU,
	SecuredPlans.ItemVariantsAreUsed,
	SecuredPlans.DaysBeforeOrdering,
	SecuredPlans.SupplyMethod,
	SecuredPlans.AssigneeBusinessUnit,
	SecuredPlans.ShopFloorStockroom
	</query>
	</dataSet>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>PeriodEnding</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
