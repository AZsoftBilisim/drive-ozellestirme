            </contextMenu>
            <type>InputField</type>
            <editMode>EnterOnInput</editMode>
            <headerHorizontalAlign>Left</headerHorizontalAlign>
            <showInFooter>true</showInFooter>
            <extInfo xsi:type="form:InputFieldExtInfo">
              <autoMaxWidth>true</autoMaxWidth>
              <autoMaxHeight>true</autoMaxHeight>
              <wrap>true</wrap>
              <autoMarkIncomplete>true</autoMarkIncomplete>
              <chooseType>true</chooseType>
              <typeDomainEnabled>true</typeDomainEnabled>
              <textEdit>true</textEdit>
              <choiceForm>Catalog.BillsOfMaterials.Form.ChoiceFormByItems</choiceForm>
              <choiceParameterLinks>
                <name>ProductionStart</name>
                <datapath xsi:type="form:DataPath">
                  <segments>Items.SemiFinishedProductsAndMaterials.CurrentData.DemandDate</segments>
                </datapath>
              </choiceParameterLinks>
              <choiceParameterLinks>
                <name>LineOfBusiness</name>
                <datapath xsi:type="form:DataPath">
                  <segments>Items.SemiFinishedProductsAndMaterials.CurrentData.LineOfBusiness</segments>
                </datapath>
              </choiceParameterLinks>
              <choiceParameterLinks>
                <name>Products</name>
                <datapath xsi:type="form:DataPath">
                  <segments>Items.SemiFinishedProductsAndMaterials.CurrentData.Products</segments>
                </datapath>
              </choiceParameterLinks>
              <choiceParameterLinks>
                <name>Department</name>
                <datapath xsi:type="form:DataPath">
                  <segments>Items.SemiFinishedProductsAndMaterials.CurrentData.Department</segments>
                </datapath>
              </choiceParameterLinks>
              <choiceParameterLinks>
                <name>Characteristic</name>
                <datapath xsi:type="form:DataPath">
                  <segments>Items.SemiFinishedProductsAndMaterials.CurrentData.Characteristic</segments>
                </datapath>
              </choiceParameterLinks>
              <choiceParameters>
                <name>GetProductBOM</name>
                <value xsi:type="form:FormChoiceListDesTimeValue">
