    <attributes uuid="138910cf-e92d-4043-ba7c-b6000e0b5575">
      <name>QuantityOrderedInStorageUnits</name>
      <synonym>
        <key>en</key>
        <value>Quantity ordered (Stock UOM)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار سفارش‌داده‌شده (واحد انبار)</value>
      </synonym>
      <synonym>
        <key>it</key>
