  <attributes>
    <name>ListProductionDocuments</name>
    <title>
      <key>en</key>
      <value>List production documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد تولید</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco documenti di produzione</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista dokumenty produkcyjne</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документы производства</value>
    </title>
    <title>
      <key>tr</key>
      <value>Liste üretim belgeleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh mục chứng từ sản xuất</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProductionDocuments.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProductionDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DocumentsRegistryOverridable.Ref AS Ref,
	DocumentsRegistryOverridable.Posted AS Posted,
	DocumentsRegistryOverridable.DeletionMark AS DeletionMark,
	DocumentsRegistryOverridable.IBDocumentNumber AS Number,
	DocumentsRegistryOverridable.IBDocumentDate AS Date,
	DocumentsRegistryOverridable.Organization AS Organization,
	DocumentsRegistryOverridable.Department AS Department,
	CAST(DocumentsRegistryOverridable.StorageLocation.Key AS Catalog.Warehouses) AS Warehouse,
	DocumentsRegistryOverridable.EmployeeResponsible AS Manager,
	DocumentsRegistryOverridable.BusinessOperation AS BusinessOperation,
	EDStatesOverridable.StatusPresentation AS StatusPresentation,
	DocumentsRegistryOverridable.LineOfBusiness AS LineOfBusiness,
	DocumentsRegistryOverridable.Status AS Status,
	DocumentsRegistryOverridable.More AS More,
	DocumentsRegistryOverridable.Comment AS Comment,
	DocumentsRegistryOverridable.SourceDocumentNumber AS IncomingDocumentNumber,
	DocumentsRegistryOverridable.SourceDocumentDate AS IncomingDocumentDate,
	CASE
		WHEN DocumentsRegistryOverridable.Posted
			THEN 0
		WHEN DocumentsRegistryOverridable.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	DocumentsRegistryOverridable.AdditionalRecord AS AdditionalRecord,
	DocumentsRegistryOverridable.RefType AS RefType,
	&amp;CheckStatus AS CheckStatus,
	&amp;CheckingIndicator AS CheckingIndicator,
	VALUETYPE(DocumentsRegistryOverridable.Ref) AS ValueType,
	DocumentsRegistryOverridable.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistryOverridable.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistryOverridable.ReversedDocument
	END AS ReversedCorrectedDocument,
	DocumentsRegistryOverridable.RecordID AS RecordID
{WHERE
	DocumentsRegistryOverridable.Ref.* AS Ref,
	DocumentsRegistryOverridable.Organization.* AS Organization,
	DocumentsRegistryOverridable.IBDocumentDate AS Date,
	DocumentsRegistryOverridable.IBDocumentNumber AS Number,
	DocumentsRegistryOverridable.Status AS Status,
	DocumentsRegistryOverridable.RefType AS RefType,
	DocumentsRegistryOverridable.BusinessOperation AS BusinessOperation,
	DocumentsRegistryOverridable.Department.* AS Department,
	DocumentsRegistryOverridable.EmployeeResponsible.* AS Manager,
	DocumentsRegistryOverridable.More AS More,
	DocumentsRegistryOverridable.Comment AS Comment,
	DocumentsRegistryOverridable.Posted AS Posted,
	DocumentsRegistryOverridable.DeletionMark AS DeletionMark,
	(DocumentsRegistryOverridable.IBDocumentDate >= &amp;BeginOfPeriod
	AND DocumentsRegistryOverridable.IBDocumentDate &lt;= &amp;EndOfPeriod)}
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistryOverridable
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON (EDStatesOverridable.ObjectReference = DocumentsRegistryOverridable.Ref)}</queryText>
