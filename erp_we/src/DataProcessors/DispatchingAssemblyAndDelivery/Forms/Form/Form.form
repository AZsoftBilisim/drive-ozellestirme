      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentReferenceOrder.Ref AS Ref,
	DocumentReferenceOrder.DeletionMark AS DeletionMark,
	DocumentReferenceOrder.Number AS Number,
	DocumentReferenceOrder.Date AS Date,
	DocumentReferenceOrder.Posted AS Posted,
	DocumentReferenceOrder.DateOfShipment AS DateOfShipment,
	DocumentReferenceOrder.DateOfShipment AS EventDate,
	DocumentReferenceOrder.Warehouse AS Warehouse,
	DocumentReferenceOrder.Terms AS Terms,
	DocumentReferenceOrder.Partner AS Partner,
	DocumentReferenceOrder.Picker AS Picker,
	DocumentReferenceOrder.Courier AS Courier,
	AssemblyAndDeliveryStatuses.Status AS Status,
	AssemblyAndDeliveryStatuses.AssemblyDate AS AssemblyDate,
	AssemblyAndDeliveryStatuses.DeliveryDate AS DeliveryDate,
	AssemblyAndDeliveryStatuses.CancellationReason AS CancellationReason,
	AssemblyAndDeliveryStatuses.CourierComment AS CourierComment,
	AssemblyAndDeliveryStatuses.PickerComment AS PickerComment,
	AssemblyAndDeliveryStatuses.NumberOfRowsInOrder AS NumberOfRowsInOrder,
	AssemblyAndDeliveryStatuses.NumberOfRowsAssembled AS NumberOfRowsAssembled,
	DocumentReferenceOrder.DeliveryTimeFrom AS DeliveryTimeFrom,
	DocumentReferenceOrder.DeliveryTimeTo AS DeliveryTimeTo,
	DocumentReferenceOrder.DeliveryZone AS DeliveryZone,
	DocumentReferenceOrder.Posted
		AND DocumentReferenceOrder.DateOfShipment &lt;> DATETIME(1, 1, 1)
		AND &amp;UpdateDate > DocumentReferenceOrder.DateOfShipment AS Overdue
FROM
	Document.SalesOrder AS DocumentReferenceOrder
		LEFT JOIN InformationRegister.AssemblyAndDeliveryStatuses AS AssemblyAndDeliveryStatuses
		ON DocumentReferenceOrder.Ref = AssemblyAndDeliveryStatuses.ReferenceOrder
WHERE
	AssemblyAndDeliveryStatuses.Status &lt;> VALUE(Enum.AssemblyAndDeliveryStatuses.EmptyRef)</queryText>
      <mainTable>Document.SalesOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
