    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	PersonsOverridable.Ref AS Ref
FROM
	InformationRegister.StoreEmployees AS StoreEmployeesOverridable
		LEFT JOIN Catalog.Persons AS PersonsOverridable
		ON StoreEmployeesOverridable.Employee = PersonsOverridable.Ref
WHERE
	StoreEmployeesOverridable.Warehouse IN HIERARCHY(&amp;Warehouse)
	AND StoreEmployeesOverridable.Courier

GROUP BY
	PersonsOverridable.Ref</queryText>
      <mainTable>Catalog.Persons</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
