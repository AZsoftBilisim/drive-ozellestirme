  <name>MobileApplicationManager</name>
  <synonym>
    <key>en</key>
    <value>Mobile application manager</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>مدیر برنامه موبایل</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Manager delle applicazioni per dispositivi mobili</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Menedżer aplikacji mobilnych</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Менеджер мобильных приложений</value>
  </synonym>
  <synonym>
