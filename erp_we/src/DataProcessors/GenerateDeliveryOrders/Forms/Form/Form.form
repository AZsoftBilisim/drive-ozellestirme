  <attributes>
    <name>ListOfDeliveryOrders</name>
    <title>
      <key>en</key>
      <value>Delivery orders</value>
    </title>
    <title>
      <key>fa</key>
      <value>سفارش‌های تحویل</value>
    </title>
    <title>
      <key>it</key>
      <value>Ordini in consegna</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zamówienia na dostawę</value>
    </title>
    <title>
      <key>ru</key>
      <value>Заказы на доставку</value>
    </title>
    <title>
      <key>tr</key>
      <value>Teslimat emirleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Delivery orders</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDeliveryOrders.DeliveryMethod</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDeliveryOrders.DeliveryToCarrier</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDeliveryOrders.Детализация</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDeliveryOrders.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentDeliveryOrder.Ref AS Ref,
	DocumentDeliveryOrder.Number AS Number,
	DocumentDeliveryOrder.Date AS Date,
	DocumentDeliveryOrder.Organization AS Organization,
	DocumentDeliveryOrder.DateOfShipment AS DateOfShipment,
	DocumentDeliveryOrder.DeliveryMethod AS DeliveryMethod,
	CASE
		WHEN DocumentDeliveryOrder.DeliveryMethod = VALUE(Enum.TransportMethods25.ByCarrier)
			THEN DocumentDeliveryOrder.Carrier
		ELSE VALUE(Catalog.Partners.EmptyRef)
	END AS Carrier,
	DocumentDeliveryOrder.Sender AS Sender,
	CASE
		WHEN DocumentDeliveryOrder.DeliveryToCarrier
			THEN DocumentDeliveryOrder.Carrier
		ELSE DocumentDeliveryOrder.Recipient
	END AS Recipient,
	CASE
		WHEN DocumentDeliveryOrder.DeliveryToCarrier
			THEN DocumentDeliveryOrder.CarrierDeliveryPoint
		ELSE DocumentDeliveryOrder.DeliveryPointRecipient
	END AS DeliveryPoint,
	CASE
		WHEN DocumentDeliveryOrder.DeliveryToCarrier
			THEN DocumentDeliveryOrder.CarrierSDeliveryArea
		ELSE DocumentDeliveryOrder.DeliveryZone
	END AS DeliveryZone,
	DocumentDeliveryOrder.DeliveryToCarrier AS DeliveryToCarrier,
	DocumentDeliveryOrder.Recipient AS FinalRecipient,
	DocumentDeliveryOrder.DeliveryPointRecipient AS FinalRecipientPoint
{SELECT
	Number,
	Date,
	Organization.*,
	DateOfShipment,
	DeliveryMethod.*,
	Carrier.*,
	Sender.*,
	Recipient.*,
	DeliveryPoint.*,
	DeliveryZone.*,
	DeliveryToCarrier,
	FinalRecipient.*,
	FinalRecipientPoint.*}
FROM
	Document.DeliveryOrder AS DocumentDeliveryOrder
WHERE
	DocumentDeliveryOrder.Sender = &amp;InitialSender
	AND DocumentDeliveryOrder.Recipient = &amp;FinalRecipient
	AND DocumentDeliveryOrder.DateOfShipment >= &amp;DateOfShipmentFrom
{WHERE
	DocumentDeliveryOrder.Ref.*,
	DocumentDeliveryOrder.Number,
	DocumentDeliveryOrder.Date,
	DocumentDeliveryOrder.Organization.*,
	(DocumentDeliveryOrder.Organization = &amp;Organization),
	DocumentDeliveryOrder.DateOfShipment,
	DocumentDeliveryOrder.DeliveryMethod.*,
	DocumentDeliveryOrder.Carrier.*,
	DocumentDeliveryOrder.Sender.*,
	(CASE
			WHEN DocumentDeliveryOrder.DeliveryToCarrier
				THEN DocumentDeliveryOrder.Carrier
			ELSE DocumentDeliveryOrder.Recipient
		END).* AS Recipient,
	(CASE
			WHEN DocumentDeliveryOrder.DeliveryToCarrier
				THEN DocumentDeliveryOrder.CarrierDeliveryPoint
			ELSE DocumentDeliveryOrder.DeliveryPointRecipient
		END).* AS DeliveryPoint,
	(CASE
			WHEN DocumentDeliveryOrder.DeliveryToCarrier
				THEN DocumentDeliveryOrder.CarrierSDeliveryArea
			ELSE DocumentDeliveryOrder.DeliveryZone
		END).* AS DeliveryZone,
	DocumentDeliveryOrder.DeliveryToCarrier,
	DocumentDeliveryOrder.Recipient.* AS FinalRecipient,
	DocumentDeliveryOrder.DeliveryPointRecipient.* AS FinalRecipientPoint}</queryText>
      <mainTable>Document.DeliveryOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
