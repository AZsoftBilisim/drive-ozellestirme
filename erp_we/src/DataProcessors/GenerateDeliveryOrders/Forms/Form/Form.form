    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListByItem.Recipient</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListByItem.RecipientPoint</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListByItem.Recipient_Area</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListByItem.ReferenceOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListByItem.Series</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnover.RowCode AS RowCode
INTO TTBalancesOnEndArm
FROM
	AccumulationRegister.Delivery.Turnovers(
			,
			,
			,
			Recipient = &amp;FinalRecipient {(Organization = &amp;Organization), (ReferenceOrder).* AS ReferenceOrder, (DeliveryType) AS DeliveryType, (DateOfShipment >= &amp;DateOfShipmentFrom), (DateOfShipment &lt;= &amp;DateOfShipmentBy)}) AS DeliveryTurnover
		INNER JOIN AccumulationRegister.Delivery AS DeliveryFinalLeverage
		ON DeliveryTurnover.ReferenceOrder = DeliveryFinalLeverage.ReferenceOrder
			AND DeliveryTurnover.RowCode = DeliveryFinalLeverage.RowCode
			AND DeliveryTurnover.Arm = DeliveryFinalLeverage.Arm
			AND DeliveryTurnover.Sender = DeliveryFinalLeverage.Sender
			AND DeliveryTurnover.SenderPoint = DeliveryFinalLeverage.SenderPoint
			AND DeliveryTurnover.Sender_Area = DeliveryFinalLeverage.Sender_Area
			AND DeliveryTurnover.Recipient = DeliveryFinalLeverage.Recipient
			AND DeliveryTurnover.RecipientPoint = DeliveryFinalLeverage.RecipientPoint
			AND DeliveryTurnover.Recipient_Area = DeliveryFinalLeverage.Recipient_Area
			AND DeliveryTurnover.DateOfShipment = DeliveryFinalLeverage.DateOfShipment
			AND DeliveryTurnover.DeliveryMethod = DeliveryFinalLeverage.DeliveryMethod
			AND DeliveryTurnover.Carrier = DeliveryFinalLeverage.Carrier
			AND DeliveryFinalLeverage.ThisIsFinalArm
			AND DeliveryFinalLeverage.ReversedPlan = UNDEFINED
			AND DeliveryFinalLeverage.ToDeliver > 0
WHERE
	DeliveryTurnover.ToDeliverTurnover - DeliveryTurnover.ToTripTurnover > 0

INDEX BY
	ReferenceOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryTurnover.DateOfShipment AS DateOfShipment,
	DeliveryTurnover.DeliveryMethod AS DeliveryMethod,
	DeliveryTurnover.Sender AS Sender,
	DeliveryTurnover.Recipient AS Recipient,
	DeliveryTurnover.RecipientPoint AS RecipientPoint,
	DeliveryTurnover.Recipient_Area AS Recipient_Area,
	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnover.DeliveryType AS DeliveryType,
	DeliveryTurnover.Products AS Products,
	DeliveryTurnover.Characteristic AS Characteristic,
	DeliveryTurnover.Series AS Series,
	DeliveryTurnover.Carrier AS Carrier,
	DeliveryTurnover.Products.UnitOfMeasure AS ProductsUnitOfMeasure,
	DeliveryTurnover.ToDeliverTurnover - DeliveryTurnover.ToTripTurnover AS Count,
	0 AS Selected,
	(DeliveryTurnover.ToDeliverTurnover - DeliveryTurnover.ToTripTurnover) * &amp;ExpressionPackagingUnitWeight AS Weight,
	(DeliveryTurnover.ToDeliverTurnover - DeliveryTurnover.ToTripTurnover) * &amp;ExpressionPackagingUnitVolume AS VolumeM3,
	0 AS State,
	NULL AS Detailing
{SELECT
	DateOfShipment,
	DeliveryMethod.*,
	Sender.*,
	Recipient.*,
	RecipientPoint.*,
	Recipient_Area.*,
	ReferenceOrder.*,
	DeliveryType,
	Products.*,
	Characteristic.*,
	Series.*,
	Carrier.*,
	ProductsUnitOfMeasure.*,
	Count,
	Selected,
	Weight,
	VolumeM3,
	State,
	Detailing}
FROM
	AccumulationRegister.Delivery.Turnovers(
			,
			,
			,
			Arm = 1
				AND Sender = &amp;InitialSender
				AND (ReferenceOrder, RowCode) IN
					(SELECT
						BalancesOnFinalArm.ReferenceOrder,
						BalancesOnFinalArm.RowCode
					FROM
						TTBalancesOnEndArm AS BalancesOnFinalArm) {(DateOfShipment >= &amp;DateOfShipmentFrom), (DateOfShipment &lt;= &amp;DateOfShipmentBy), (Carrier).* AS Carrier, (DateOfShipment) AS DateOfShipment, (Recipient).* AS Recipient, (Recipient_Area).* AS Recipient_Area, (RecipientPoint).* AS RecipientPoint, (DeliveryType) AS DeliveryType, (DeliveryMethod) AS DeliveryMethod, (ReferenceOrder).* AS ReferenceOrder, (Products).* AS Products, (Characteristic).*, (Series).*}) AS DeliveryTurnover
WHERE
	DeliveryTurnover.ToDeliverTurnover - DeliveryTurnover.ToTripTurnover > 0</queryText>
      <mainTable>AccumulationRegister.Delivery.Turnovers</mainTable>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
