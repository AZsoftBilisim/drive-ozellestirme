    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.CoveredPeriodOption</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.SupplyType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.ThereIsASettingForFormat</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.ThereIsASettingForWarehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.ThereIsFormat</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>WarehousesList.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CatWarehouses.IsFolder       AS IsFolder,
	CatWarehouses.Ref          AS Warehouse,
	ISNULL(CatApproaches.Ref, VALUE(Catalog.ProcurementStrategies.EmptyRef))        AS SupplyMethod,
	
	ISNULL(CatFormats.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) AS StoreFormat,
	ISNULL(CatApproaches.SourceOfDemandSupply, UNDEFINED) AS SupplySource,
	ISNULL(CatApproaches.OrderFulfillmentPeriod, 0)            AS DeliveryPeriodDays,
	ISNULL(CatApproaches.CoveredPeriod, 0)            AS CoveredPeriod,
	ISNULL(CatApproaches.CoveredPeriodOption, VALUE(Enum.CoveredPeriodOptions.EmptyRef)) AS CoveredPeriodOption,
	
	ISNULL(CatApproaches.SupplyType, VALUE(Enum.SupplyTypes.EmptyRef)) AS SupplyType,
	
	ISNULL(PackingTable.OrderPackage, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS OrderPackage,
	
	NOT CatFormats.StoreFormat IS NULL  AS ThereIsFormat,
	NOT &amp;Products = VALUE(Catalog.Products.EmptyRef) AS ThereAreGoods,
	NOT SetupForTheItem.ProcurementStrategy IS NULL  AS ThereIsSettingForGoods,
	NOT SettingUpForAWarehouse.ProcurementStrategy IS NULL AS ThereIsASettingForWarehouse,
	NOT SettingForTheFormat.ProcurementStrategy IS NULL AS ThereIsASettingForFormat
	
FROM
	Catalog.Warehouses AS CatWarehouses
	
		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(, ) AS CatFormats
		ON (CatFormats.Warehouse = CatWarehouses.Ref)
			AND (NOT CatFormats.StoreFormat = VALUE(Catalog.StoreFormats.EmptyRef))
			
		LEFT JOIN InformationRegister.GoodsProcurementStrategy AS SetupForTheItem
		ON &amp;Products &lt;> VALUE(Catalog.Products.EmptyRef)
			AND (SetupForTheItem.Products = &amp;Products)
			AND (SetupForTheItem.Characteristic = &amp;Characteristic)
			AND (SetupForTheItem.Warehouse = CatWarehouses.Ref)
			AND (SetupForTheItem.AddlOrderingAttribute = 1)
			
		LEFT JOIN InformationRegister.SupplySchemes AS SettingUpForAWarehouse
		ON (SettingUpForAWarehouse.Warehouse = CatWarehouses.Ref)
			AND (SettingUpForAWarehouse.SupplyScheme = &amp;SupplyScheme)
			
		LEFT JOIN InformationRegister.SupplySchemes AS SettingForTheFormat
		ON (SettingForTheFormat.Warehouse = CatFormats.StoreFormat)
			AND (SettingForTheFormat.SupplyScheme = &amp;SupplyScheme)
			
		LEFT JOIN Catalog.ProcurementStrategies AS CatApproaches
		ON (CatApproaches.Ref = ISNULL(SetupForTheItem.ProcurementStrategy, ISNULL(SettingUpForAWarehouse.ProcurementStrategy, SettingForTheFormat.ProcurementStrategy)))
		
		LEFT JOIN InformationRegister.ProductRestrictions AS PackingTable
		ON &amp;Products &lt;> VALUE(Catalog.Products.EmptyRef)
			AND (PackingTable.Products = &amp;Products)
			AND (PackingTable.Characteristic = &amp;Characteristic)
			AND (PackingTable.Warehouse = CatWarehouses.Ref)</queryText>
      <mainTable>Catalog.Warehouses</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
