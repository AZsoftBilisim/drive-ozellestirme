    <title>
      <key>ru</key>
      <value>Список способов обеспечения склада</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ambar tedarik stratejileri listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Một danh sách các cách để cung cấp một kho</value>
    </title>
    <id>41</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.Characteristic</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.CoveredPeriodOption</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.PackagesAreUsed</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.SupplyMethod</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.SupplyScheme</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfWarehouseSupplyMethods.ThisIsAPersonalSetting</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CatProducts.Ref AS Products,
	CatProducts.UseVariants &lt;> VALUE(Enum.ItemVariantsUsageOptions.DontUse) AS ItemVariantsAreUsed,
	CatProducts.UsePackages AS PackagesAreUsed,
	CatProducts.SupplyScheme AS SupplyScheme,

	ISNULL(CatItemsCharacteristicsIndividual.Ref,
		ISNULL(CatItemsCharacteristicsCommonForKind.Ref,
			ISNULL(CatItemsCharacteristicsCommonWithDifferentItemsKind.Ref,
				VALUE(Catalog.ItemsCharacteristics.EmptyRef)))) AS Characteristic,

	CatMethod.Ref AS SupplyMethod,
	CatMethod.SourceOfDemandSupply AS SupplySource,
	CatMethod.SupplyType AS SupplyType,
	CatMethod.OrderFulfillmentPeriod AS DeliveryPeriodDays,
	CatMethod.CoveredPeriod AS CoveredPeriod,
	CatMethod.CoveredPeriodOption AS CoveredPeriodOption,
	
	NOT TableOptionsForProvidingGoods.ProcurementStrategy IS NULL AS ThisIsAPersonalSetting,
	CASE
		WHEN TableOptionsForProvidingGoods.ProcurementStrategy IS NULL
			THEN &amp;SourceSchema
		ELSE &amp;SourceMethod
	END AS SettingSource,
	
	ISNULL(ProductRestrictions.OrderPackage, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS OrderPackage
FROM
	Catalog.Products AS CatProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatItemsCharacteristicsIndividual
		ON CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
			AND CatItemsCharacteristicsIndividual.Owner = CatProducts.Ref
		
		LEFT JOIN Catalog.ItemsCharacteristics AS CatItemsCharacteristicsCommonForKind
		ON CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
			AND CatItemsCharacteristicsCommonForKind.Owner = CatProducts.ProductKind
		
		LEFT JOIN Catalog.ItemsCharacteristics AS CatItemsCharacteristicsCommonWithDifferentItemsKind
		ON CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
			AND CatItemsCharacteristicsCommonWithDifferentItemsKind.Owner = CatProducts.ItemVariantsOwner
		
		LEFT JOIN InformationRegister.GoodsProcurementStrategy AS TableOptionsForProvidingGoods
		ON (TableOptionsForProvidingGoods.Products = CatProducts.Ref)
			AND (TableOptionsForProvidingGoods.Warehouse = &amp;Warehouse)
			AND (TableOptionsForProvidingGoods.AddlOrderingAttribute = 1)
			AND TableOptionsForProvidingGoods.Characteristic
				= ISNULL(CatItemsCharacteristicsIndividual.Ref,
					ISNULL(CatItemsCharacteristicsCommonForKind.Ref,
						ISNULL(CatItemsCharacteristicsCommonWithDifferentItemsKind.Ref,
							VALUE(Catalog.ItemsCharacteristics.EmptyRef))))
		
		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(, Warehouse = &amp;Warehouse) AS CatFormats
		ON (TRUE)
		LEFT JOIN InformationRegister.SupplySchemes AS TableOfWarehouseSupportSchemes
		ON TableOfWarehouseSupportSchemes.SupplyScheme = CatProducts.SupplyScheme
			AND TableOfWarehouseSupportSchemes.Warehouse = &amp;Warehouse
			AND TableOptionsForProvidingGoods.Products IS NULL
		LEFT JOIN InformationRegister.SupplySchemes AS TableOfTheFormatSupportScheme
		ON TableOfTheFormatSupportScheme.SupplyScheme = CatProducts.SupplyScheme
			AND TableOfTheFormatSupportScheme.Warehouse = CatFormats.StoreFormat
			AND TableOfWarehouseSupportSchemes.SupplyScheme IS NULL
			AND TableOptionsForProvidingGoods.Products IS NULL
		LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON CatMethod.Ref
			= ISNULL(TableOptionsForProvidingGoods.ProcurementStrategy,
				ISNULL(TableOfWarehouseSupportSchemes.ProcurementStrategy,
					ISNULL(TableOfTheFormatSupportScheme.ProcurementStrategy,
					VALUE(Catalog.ProcurementStrategies.EmptyRef))))
		
		LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
		ON CatProducts.Ref = ProductRestrictions.Products
			AND &amp;Warehouse = ProductRestrictions.Warehouse
			AND ProductRestrictions.Characteristic
				= ISNULL(CatItemsCharacteristicsIndividual.Ref,
					ISNULL(CatItemsCharacteristicsCommonForKind.Ref,
						ISNULL(CatItemsCharacteristicsCommonWithDifferentItemsKind.Ref,
							VALUE(Catalog.ItemsCharacteristics.EmptyRef))))
WHERE
	NOT CatProducts.IsFolder
	AND CatProducts.ItemsType IN(
		VALUE(Enum.ItemsTypes.OwnGoods),
		VALUE(Enum.ItemsTypes.ReusablePackage))
{WHERE
	&amp;OnlySuppliedProducts = CatMethod.Ref &lt;> VALUE(Catalog.ProcurementStrategies.EmptyRef)}</queryText>
