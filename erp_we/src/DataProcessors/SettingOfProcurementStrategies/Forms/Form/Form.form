    <name>ListOfWarehouseSupplyMethods</name>
    <title>
      <key>en</key>
      <value>List of warehouse procurement strategy</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست راهبرد تدارکات انبار</value>
    </title>
    <title>
      <key>it</key>
