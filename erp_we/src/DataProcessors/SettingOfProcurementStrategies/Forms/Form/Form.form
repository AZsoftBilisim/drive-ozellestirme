    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBusinessStructureOverridable.Ref AS Ref,
	CatalogBusinessStructureOverridable.Description AS Description,
	CatalogBusinessStructureOverridable.ProductionBusinessUnit AS ProductionBusinessUnit,
	CatalogBusinessStructureOverridable.DeletionMark AS DeletionMark,
	CatalogBusinessStructureOverridable.Parent AS Parent,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	0 AS ChangeWarehouse
FROM
	Catalog.BusinessStructure AS CatalogBusinessStructureOverridable</queryText>
      <mainTable>Catalog.BusinessStructure</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
