            <presentation>
              <key>fa</key>
              <value>درج کد الگوریتم در محل فراخوانی</value>
            </presentation>
            <presentation>
              <key>it</key>
              <value>Sostituisci il codice di algoritmi alla posizione di chiamata</value>
            </presentation>
            <presentation>
              <key>pl</key>
              <value>Wstawiaj kod algorytmów wg miejsca wywołania</value>
