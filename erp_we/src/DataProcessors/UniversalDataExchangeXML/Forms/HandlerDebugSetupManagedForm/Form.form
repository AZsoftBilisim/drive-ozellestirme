            </presentation>
            <presentation>
              <key>ru</key>
              <value>Вызывать алгоритмы как процедуры</value>
            </presentation>
            <presentation>
              <key>tr</key>
              <value>Proses olarak çağrı algoritmaları</value>
            </presentation>
            <presentation>
              <key>vi</key>
              <value>Gọi ra thuật toán như là thủ tục</value>
            </presentation>
            <value xsi:type="core:NumberValue">
              <value>1</value>
