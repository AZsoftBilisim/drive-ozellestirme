		<field xsi:type="DataSetFieldField">
			<dataPath>ShipmentOrder</dataPath>
			<field>ShipmentOrder</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>RequestShipmentOn</dataPath>
			<field>RequestShipmentOn</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TableFormats.Warehouse          AS Warehouse,
	TableFormats.StoreFormat AS StoreFormat
INTO TTWarehouseFormats
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(,
	{Warehouse.* AS Warehouse}) AS TableFormats
WHERE
	TableFormats.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
INDEX BY
	Warehouse
;

SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, WEEK, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, TENDAYS, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, MONTH, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, QUARTER, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, HALFYEAR, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(CASE WHEN Demands.RequestShipmentOn = DATETIME(1, 1, 1, 0, 0, 0) 
										THEN Documents.IBDocumentDate 
									ELSE Demands.RequestShipmentOn 
								END, DAY, -&amp;PeriodOffset)
	END AS Period,
	Demands.Warehouse AS Warehouse,
	Demands.Products AS Products,
	Demands.Characteristic AS Characteristic,
	Demands.Purpose AS Purpose,
	Demands.Count AS Count
FROM
	(SELECT
			Demands.Products AS Products,
			Demands.Characteristic AS Characteristic,
			Demands.Warehouse AS Warehouse,
			Demands.Purpose AS Purpose,
			Demands.ShipmentOrder AS ShipmentOrder,
			Demands.RequestShipmentOn AS RequestShipmentOn,
			Demands.Count AS Count
		FROM
			InformationRegister.InventoryAllocation AS Demands
		WHERE
			Demands.InventoryState = VALUE(Enum.InventoryStates.NotProvided)
				AND Demands.DemandCharacteristic IN(
					VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
					VALUE(Enum.DemandCharacteristics.SnoozeReservation),
					VALUE(Enum.DemandCharacteristics.ToSupply))
				AND VALUETYPE(Demands.ShipmentOrder) IN(
					TYPE(Document.ProductionOrder2_2),
					TYPE(Document.ProductionStage2_2))
	{WHERE
		Demands.Products.*   AS Products,
		Demands.Characteristic.* AS Characteristic,
		Demands.Purpose.*     AS Purpose}
	{WHERE
	(Demands.Products, Demands.Characteristic) IN(
		SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			&amp;FilterByProductSegmentIsUsed = TRUE)}
	
	UNION ALL
	
	SELECT
		Goods.Products        AS Products,
		Goods.Characteristic      AS Characteristic,
		Goods.Warehouse               AS Warehouse,
		Goods.Purpose          AS Purpose,
		Goods.ProductionOrder AS ShipmentOrder,
		MIN(ISNULL(ScheduleDates.Begin, Goods.ProductionOrder.EarliestStartDate)) AS RequestShipmentOn,
		
		SUM(Goods.ToSupply - Goods.Replaced - Goods.AllocatedFromAvailableInventoryWithAssignment - Goods.AllocatedInAssignedProductionLots) AS Count
	FROM
		InformationRegister.OrderStructure AS Goods
		
			LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
			ON Goods.ProductionOrder = ScheduleDates.ProductionOrder
			 AND ScheduleDates.ScheduleStatus = 0
			 AND Goods.Stage = ScheduleDates.Stage
			 AND Goods.KeyLot = ScheduleDates.KeyLot
			
	WHERE
		Goods.LineKind NOT IN (
			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
			VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))

	{WHERE
		Goods.Products.*        AS Products,
		Goods.Characteristic.*      AS Characteristic,
		Goods.Purpose.*          AS Purpose}
		
	{WHERE (Goods.Products, Goods.Characteristic) IN(
		SELECT
			FilterTable.Products   AS Products,
			FilterTable.Characteristic AS Characteristic
		FROM
			SelectionByProductSegment AS FilterTable
		WHERE
			&amp;FilterByProductSegmentIsUsed)}
		
	GROUP BY
		Goods.Products,
		Goods.Characteristic,
		Goods.Warehouse,
		Goods.Purpose,
		Goods.ProductionOrder,
		Goods.KeyProducts
		
	HAVING
		SUM(Goods.ToSupply - Goods.Replaced - Goods.AllocatedFromAvailableInventoryWithAssignment - Goods.AllocatedInAssignedProductionLots) &gt; 0
		
	UNION ALL
	
	SELECT
		
		Goods.Products                          AS Products,
		Goods.Characteristic                        AS Characteristic,
		Goods.Warehouse                                 AS Warehouse,
		Goods.StructureAssignment                   AS Purpose,
		Goods.ProductionOrder                   AS ShipmentOrder,
		MIN(ISNULL(ScheduleDates.Begin, Goods.ProductionOrder.EarliestStartDate)) AS RequestShipmentOn,
		
		SUM(Goods.AllocatedFromAvailableInventoryWithAssignment + Goods.AllocatedInAssignedProductionLots) AS Count
		
	FROM
		InformationRegister.OrderStructure AS Goods
		
			LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
			ON Goods.ProductionOrder = ScheduleDates.ProductionOrder
			 AND ScheduleDates.ScheduleStatus = 0
			 AND Goods.Stage = ScheduleDates.Stage
			 AND Goods.KeyLot = ScheduleDates.KeyLot
		
	WHERE
		Goods.LineKind NOT IN (
			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts))
		
	{WHERE
		Goods.Products.*        AS Products,
		Goods.Characteristic.*      AS Characteristic,
		Goods.StructureAssignment.* AS Purpose}
		
	{WHERE (Goods.Products, Goods.Characteristic) IN(
		SELECT
			FilterTable.Products   AS Products,
			FilterTable.Characteristic AS Characteristic
		FROM
			SelectionByProductSegment AS FilterTable
		WHERE
			&amp;FilterByProductSegmentIsUsed)}
		
	GROUP BY
		Goods.Products,
		Goods.Characteristic,
		Goods.Warehouse,
		Goods.StructureAssignment,
		Goods.ProductionOrder,
		Goods.KeyProducts
		
	HAVING
		SUM(Goods.AllocatedFromAvailableInventoryWithAssignment + Goods.AllocatedInAssignedProductionLots) &gt; 0
		
		) AS Demands
		
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCRevenue
		ON (ABCRevenue.ClassificationSection = Demands.Warehouse)
			AND (ABCRevenue.Products = Demands.Products)
			AND (ABCRevenue.Characteristic = Demands.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCGrossProfit
		ON (ABCGrossProfit.ClassificationSection = Demands.Warehouse)
			AND (ABCGrossProfit.Products = Demands.Products)
			AND (ABCGrossProfit.Characteristic = Demands.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCCount
		ON (ABCCount.ClassificationSection = Demands.Warehouse)
			AND (ABCCount.Products = Demands.Products)
			AND (ABCCount.Characteristic = Demands.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZRevenue
		ON (XYZRevenue.ClassificationSection = Demands.Warehouse)
			AND (XYZRevenue.Products = Demands.Products)
			AND (XYZRevenue.Characteristic = Demands.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZGrossProfit
		ON (XYZGrossProfit.ClassificationSection = Demands.Warehouse)
			AND (XYZGrossProfit.Products = Demands.Products)
			AND (XYZGrossProfit.Characteristic = Demands.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZCount
		ON (XYZCount.ClassificationSection = Demands.Warehouse)
			AND (XYZCount.Products = Demands.Products)
			AND (XYZCount.Characteristic = Demands.Characteristic)}
		{LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast({(&amp;ProductRangeAsOfDate)}, {(Warehouse) AS Warehouse}) AS HistoryOfChangesToStoreFormatsCrossSection
		ON Demands.Warehouse = HistoryOfChangesToStoreFormatsCrossSection.Warehouse
		LEFT JOIN InformationRegister.ProductRange.SliceLast({(&amp;ProductRangeAsOfDate)}, ) AS ProductRangeSliceLast
		ON (ISNULL(Demands.Products, VALUE(Catalog.Products.EmptyRef)) = ProductRangeSliceLast.Products)
			AND (ISNULL(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = ProductRangeSliceLast.PlanningObject
				OR Demands.Warehouse = ProductRangeSliceLast.PlanningObject)}
		
		{LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON &amp;SecuringProductionOrdersSubstitutingMainMethodOfSecuring}
		
		{LEFT JOIN InformationRegister.DocumentsRegistry AS Documents
		ON Demands.ShipmentOrder = Documents.Ref}
{WHERE
	(CAST(ISNULL(ABCRevenue.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCRevenue,
	(CAST(ISNULL(ABCGrossProfit.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCGrossProfit,
	(CAST(ISNULL(ABCCount.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCCount,
	(CAST(ISNULL(XYZRevenue.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZRevenue,
	(CAST(ISNULL(XYZGrossProfit.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZGrossProfit,
	(CAST(ISNULL(XYZCount.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZCount,
	ProductRangeSliceLast.ProductRangeRole,
	ProductRangeSliceLast.PurchasesAreAllowed,
	ProductRangeSliceLast.SalesAreAllowed,
	ProductRangeSliceLast.PriceKind.*,
	ProductRangeSliceLast.ItemsCollection.* AS AssortmentCollectionOfProducts,
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat.* AS AssortmentStoreFormat,
	HistoryOfChangesToStoreFormatsCrossSection.ControlProductRange,
	CatMethod.Ref.* AS MainDemandFulfillmentMethod}</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case 
	When &amp;PeriodOffsetIsUsed 
		Then Case 
				When &amp;Periodicity = Value(Enum.Periodicity.Week) 
					Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) 
				When &amp;Periodicity = Value(Enum.Periodicity.TenDays) 
					Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) 
				When &amp;Periodicity = Value(Enum.Periodicity.Month) 
					Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) 
				When &amp;Periodicity = Value(Enum.Periodicity.Quarter) 
					Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) 
				When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) 
					Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) 
				When &amp;Periodicity = Value(Enum.Periodicity.Year) 
					Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) 
			Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) 
		End 
	Else &amp;BeginOfPeriod 
End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End Else &amp;EndOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
