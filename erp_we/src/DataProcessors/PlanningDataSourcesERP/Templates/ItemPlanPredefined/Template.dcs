					<v8:lang>ru</v8:lang>
					<v8:content>XYZКоличество</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>XYZMiktar</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số lượng XYZ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Release date</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تاریخ انتشار</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Data di produzione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Data wydania</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата выпуска</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Çıkış tarihi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Ngày xuất xưởng</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ClassificationSection</dataPath>
			<field>ClassificationSection</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ClassificationParameterType</dataPath>
			<field>ClassificationParameterType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ClassificationType</dataPath>
			<field>ClassificationType</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), WEEK, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), TENDAYS, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), MONTH, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), QUARTER, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), HALFYEAR, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), DAY, -&amp;PeriodOffset)
	END AS Period,
	Plan.BillOfMaterials                                AS BillOfMaterials,
	Plan.ProductionOrder.LineOfBusiness AS LineOfBusiness,
	Plan.ProductionOrder.Department           AS ProductionDispatcherBusinessUnit,
	Plan.Products                                AS Products,
	Plan.Characteristic                              AS Characteristic,
	Plan.Warehouse                                       AS Warehouse,
	Plan.Purpose                                  AS Purpose,
	ISNULL(Schedule.Begin, DATETIME(1,1,1))        AS StartDate2,
	SUM(Plan.Scheduled)                        AS Count
	
{SELECT
	Products.*,
	Characteristic.*,
	Warehouse.*,
	Purpose.*,
	BillOfMaterials.*}

FROM
	InformationRegister.OrderStructure AS Plan
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	ON Plan.ProductionOrder = Schedule.ProductionOrder
	 AND Schedule.ScheduleStatus = 0
	 AND Schedule.Stage = VALUE(Catalog.ProductionStages.EmptyRef)
	 AND Plan.KeyLot = Schedule.KeyLot
	
	{LEFT JOIN InformationRegister.OrderStructure AS Consumption
	ON Plan.Products = Consumption.Products
		AND Plan.Characteristic = Consumption.Characteristic
		AND Plan.Warehouse = Consumption.Warehouse
		AND Plan.Purpose = Consumption.Purpose
		AND Plan.ProductionOrder = Consumption.ProductionOrder
		AND Plan.KeyProducts = Consumption.KeyProducts
		AND Consumption.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
		AND NOT Consumption.AdditionalRecord
	
	LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCRevenue
		ON (ABCRevenue.ClassificationSection = Plan.Warehouse)
			AND (ABCRevenue.Products = Plan.Products)
			AND (ABCRevenue.Characteristic = Plan.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCGrossProfit
		ON (ABCGrossProfit.ClassificationSection = Plan.Warehouse)
			AND (ABCGrossProfit.Products = Plan.Products)
			AND (ABCGrossProfit.Characteristic = Plan.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCCount
		ON (ABCCount.ClassificationSection = Plan.Warehouse)
			AND (ABCCount.Products = Plan.Products)
			AND (ABCCount.Characteristic = Plan.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZRevenue
		ON (XYZRevenue.ClassificationSection = Plan.Warehouse)
			AND (XYZRevenue.Products = Plan.Products)
			AND (XYZRevenue.Characteristic = Plan.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZGrossProfit
		ON (XYZGrossProfit.ClassificationSection = Plan.Warehouse)
			AND (XYZGrossProfit.Products = Plan.Products)
			AND (XYZGrossProfit.Characteristic = Plan.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZCount
		ON (XYZCount.ClassificationSection = Plan.Warehouse)
			AND (XYZCount.Products = Plan.Products)
			AND (XYZCount.Characteristic = Plan.Characteristic)}
WHERE
	Plan.LineKind IN (
		VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
		VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct))
	AND ISNULL(Schedule.Ending, DATETIME(1,1,1)) IS NOT NULL
{WHERE
	Plan.Products.*                                        AS Products,
	Plan.Characteristic.*                                      AS Characteristic,
	CAST(Plan.Warehouse AS Catalog.Warehouses).*               AS Warehouse,
	CAST(Plan.Warehouse AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit,
	Plan.Purpose.*                                          AS Purpose,
	Plan.ProductionOrder.Organization.*                     AS Organization,
	Plan.ProductionOrder.Department.*                   AS ProductionDispatcherBusinessUnit,
	Plan.ProductionOrder.LineOfBusiness.*         AS LineOfBusiness,
	Plan.ProductionOrder.*                                 AS ProductionOrder,
	Plan.BillOfMaterials.*                                        AS BillOfMaterials,
	Plan.BillOfMaterials.ResponsibleBusinessUnit.*             AS ResponsibleBusinessUnit,
	ISNULL(Schedule.Begin, DATETIME(1,1,1))                  AS StartDate2,
	ISNULL(Schedule.Ending, DATETIME(1,1,1))               AS Period,
	Consumption.Department                                  AS ConsumerStageSubdivision,
	(Plan.Products, Plan.Characteristic) IN(
		SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			&amp;FilterByProductSegmentIsUsed = TRUE)}
{WHERE
	(CAST(ISNULL(ABCRevenue.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCRevenue,
	(CAST(ISNULL(ABCGrossProfit.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCGrossProfit,
	(CAST(ISNULL(ABCCount.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCCount,
	(CAST(ISNULL(XYZRevenue.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZRevenue,
	(CAST(ISNULL(XYZGrossProfit.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZGrossProfit,
	(CAST(ISNULL(XYZCount.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZCount}
	
GROUP BY
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), WEEK, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), TENDAYS, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), MONTH, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), QUARTER, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), HALFYEAR, -&amp;PeriodOffset)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(ISNULL(Schedule.Ending, DATETIME(1,1,1)), DAY, -&amp;PeriodOffset)
	END,
	Plan.BillOfMaterials,
	Plan.ProductionOrder.Organization,
	Plan.ProductionOrder.Partner,
	Plan.ProductionOrder.Contract,
	Plan.ProductionOrder.LineOfBusiness,
	Plan.ProductionOrder.Department,
	Plan.ProductionOrder.OrderForActivity,
	Plan.ProductionOrder.BusinessOperation,
	Plan.Products,
	Plan.Characteristic,
	Plan.Warehouse,
	Plan.Purpose,
	Plan.ProductionOrder,
	Plan.KeyProducts,
	Plan.KeyLot,
	ISNULL(Schedule.Begin, DATETIME(1,1,1))

HAVING
	SUM(Plan.Scheduled) &lt;&gt; 0
</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
