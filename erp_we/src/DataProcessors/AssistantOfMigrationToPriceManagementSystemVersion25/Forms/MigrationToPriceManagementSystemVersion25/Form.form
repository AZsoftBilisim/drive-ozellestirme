        <items xsi:type="form:Decoration">
          <name>DecorationInformationHomePage1</name>
          <id>744</id>
          <title>
            <key>en</key>
            <value>1. Set migration date.
</value>
          </title>
          <title>
            <key>fa</key>
            <value>1. تاریخ مهاجرت را تعیین کنید.
</value>
          </title>
          <title>
            <key>it</key>
            <value>1. Impostare data di passaggio. 
</value>
          </title>
          <title>
            <key>pl</key>
            <value>1. Ustaw datę przejścia.
</value>
          </title>
          <title>
            <key>ru</key>
            <value>1. Установить дату перехода.
</value>
          </title>
          <title>
            <key>tr</key>
