      <items xsi:type="form:Decoration">
        <name>DecorationResult25</name>
        <id>467</id>
        <title>
          <key>en</key>
          <value>&lt;fontsize 10>&lt;color #333333>&lt;b>Migrate&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>to&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>pricing&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>version&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> 11&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>.5&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>has been performed!&lt;/>&lt;/>&lt;/>

&lt;fontsize 10>&lt;color #333333>&lt;b>The&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>following&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>operations&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>were performed:&lt;/>&lt;/>&lt;/>
&lt;fontsize 10>&lt;color #333333>1.&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>Generated&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>individual&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>price lists&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>for&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>agreements&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>with&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>customers.&lt;/>&lt;/>
&lt;fontsize 10>&lt;color #333333>2.&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>New&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>pricing&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>breakdowns&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>created.&lt;/>&lt;/>
&lt;fontsize 10>&lt;color #333333>3.&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>Prices&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>have been set&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>for the&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>selected&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>price&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>types.&lt;/>&lt;/>
</value>
        </title>
        <title>
          <key>fa</key>
          <value>&lt;fontsize 10>&lt;color #333333>&lt;b>مهاجرت&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>به&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>قیمت‌گذاری&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>نسخه&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> 11&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>.5&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>انجام شد!&lt;/>&lt;/>&lt;/>

&lt;fontsize 10>&lt;color #333333>&lt;b>عملیات&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>زیر&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>انجام&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>شد:&lt;/>&lt;/>&lt;/>
&lt;fontsize 10>&lt;color #333333>1.&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>لیست‌های قیمت&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>اختصاصی&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>برای&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>توافق‌نامه‌ها&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>با&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>مشتریان&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>ایجاد شد.&lt;/>&lt;/>
&lt;fontsize 10>&lt;color #333333>2.&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>تفکیک‌های&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>جدید&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>قیمت‌گذاری&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>ایجاد شد.&lt;/>&lt;/>
&lt;fontsize 10>&lt;color #333333>3.&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>قیمت‌ها&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>برای&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>انواع&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>قیمت&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>انتخاب‌شده&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>تعیین شد.&lt;/>&lt;/>
</value>
        </title>
        <title>
          <key>it</key>
          <value>&lt;fontsize 10>&lt;color #333333>&lt;b>Passaggio&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>all'&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>elaborazione di prezzo&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>versione&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> 11&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>.5&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>effetuato!&lt;/>&lt;/>&lt;/>

&lt;fontsize 10>&lt;color #333333>&lt;b>Sono state&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>eseguite&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>le seguenti&lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b> &lt;/>&lt;/>&lt;/>&lt;fontsize 10>&lt;color #333333>&lt;b>operazioni:&lt;/>&lt;/>&lt;/>
