      <items xsi:type="form:Decoration">
        <name>DecorationInformationForStartingAnAutomaticTransitionTitle</name>
        <id>544</id>
        <title>
          <key>en</key>
          <value>&lt;b>To&lt;/>&lt;b> &lt;/>&lt;b>migrate&lt;/>&lt;b> &lt;/>&lt;b>to&lt;/>&lt;b> &lt;/>&lt;b>pricing&lt;/>&lt;b> version&lt;/>&lt;b> 11&lt;/>&lt;b>.5&lt;/>&lt;b> &lt;/>&lt;b>in&lt;/>&lt;b> &lt;/>&lt;b>automatic&lt;/>&lt;b> &lt;/>&lt;b>mode&lt;/>&lt;b> &lt;/>&lt;b>the&lt;/>&lt;b> &lt;/>&lt;b>following&lt;/>&lt;b> &lt;/>&lt;b>operations&lt;/>&lt;b> &lt;/>&lt;b>will be performed&lt;/>&lt;b>:&lt;/>
</value>
        </title>
        <title>
          <key>fa</key>
          <value>&lt;b>برای&lt;/>&lt;b> &lt;/>&lt;b>مهاجرت&lt;/>&lt;b> &lt;/>&lt;b>به&lt;/>&lt;b> &lt;/>&lt;b>قیمت‌گذاری&lt;/>&lt;b> نسخه&lt;/>&lt;b> 11&lt;/>&lt;b>.5&lt;/>&lt;b> &lt;/>&lt;b>به&lt;/>&lt;b> &lt;/>&lt;b>صورت&lt;/>&lt;b> &lt;/>&lt;b>خودکار&lt;/>&lt;b> &lt;/>&lt;b>عملیات&lt;/>&lt;b> &lt;/>&lt;b>زیر&lt;/>&lt;b> &lt;/>&lt;b>انجام&lt;/>&lt;b> &lt;/>&lt;b>خواهد شد&lt;/>&lt;b>:&lt;/>
</value>
        </title>
        <title>
          <key>it</key>
          <value>&lt;b>Per&lt;/>&lt;b> &lt;/>&lt;b>passare&lt;/>&lt;b> &lt;/>&lt;b>all'&lt;/>&lt;b> &lt;/>&lt;b>elaborazione di prezzo&lt;/>&lt;b> versione&lt;/>&lt;b> 11&lt;/>&lt;b>.5&lt;/>&lt;b> &lt;/>&lt;b>saranno&lt;/>&lt;b> &lt;/>&lt;b>eseguite&lt;/>&lt;b> &lt;/>&lt;b>in&lt;/>&lt;b> &lt;/>&lt;b>modalità automatica&lt;/>&lt;b> &lt;/>&lt;b>le&lt;/>&lt;b> &lt;/>&lt;b>seguenti&lt;/>&lt;b> &lt;/>&lt;b>operazioni&lt;/>&lt;b>:&lt;/>
</value>
        </title>
        <title>
          <key>pl</key>
