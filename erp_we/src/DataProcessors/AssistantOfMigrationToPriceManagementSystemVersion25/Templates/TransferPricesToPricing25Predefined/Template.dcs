		<field xsi:type="DataSetFieldField">
			<dataPath>PriceKind</dataPath>
			<field>PriceKind</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Price type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع قیمت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipo di prezzo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Rodzaj ceny</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид цены</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Fiyat türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Dạng giá</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Package AS Package,
	ItemsPrices.Currency AS Currency,
	ItemsPrices.Price AS Price
{SELECT
	Products,
	Characteristic.*,
	Package.*,
	Currency.*}
FROM
	InformationRegister.ItemsPrices.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, PriceKind = &amp;PriceKind) AS ItemsPrices
WHERE
	ItemsPrices.Price &lt;&gt; 0</query>
	</dataSet>
