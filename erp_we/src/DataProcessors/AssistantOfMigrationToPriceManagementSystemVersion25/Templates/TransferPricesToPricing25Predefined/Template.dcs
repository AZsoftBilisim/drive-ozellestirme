			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	ItemKinds.Ref AS ProductKind,
	ItemKinds.SettingsOfPriceKeyByItemVariant AS SettingsOfPriceKeyByItemVariant,
	ItemKinds.SettingsOfPriceKeyByBatch AS SettingsOfPriceKeyByBatch,
	ItemKinds.SettingsOfPriceKeyByPackage AS SettingsOfPriceKeyByPackage,
	CASE
		WHEN ItemKinds.BatchOwner = VALUE(Catalog.ItemKinds.EmptyRef)
			THEN ItemKinds.Ref
		ELSE ItemKinds.BatchOwner
	END AS BatchOwner
INTO ItemKinds
FROM
	Catalog.ItemKinds AS ItemKinds
{WHERE
	ItemKinds.Ref.* AS ProductKind}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemKinds.ProductKind AS ProductKind,
	Products.Ref AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef) AS PricingVariant
INTO RawData
FROM
	Catalog.Products AS Products
		INNER JOIN ItemKinds AS ItemKinds
		ON Products.ProductKind = ItemKinds.ProductKind
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)

UNION ALL

SELECT
	ItemKinds.ProductKind,
	Products.Ref,
	ItemsCharacteristics.Ref,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
	END
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics
		INNER JOIN Catalog.Products AS Products
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
		ON (Products.Ref = ItemsCharacteristics.Owner)
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)

UNION ALL

SELECT
	ItemKinds.ProductKind,
	Products.Ref,
	ItemsCharacteristics.Ref,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
	END
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics
		INNER JOIN Catalog.Products AS Products
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
		ON (Products.ProductKind = ItemsCharacteristics.Owner)
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)

UNION ALL

SELECT
	ItemKinds.ProductKind,
	Products.Ref,
	ItemsCharacteristics.Ref,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
	END
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics
		INNER JOIN Catalog.Products AS Products
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
		ON (Products.ItemVariantsOwner = ItemsCharacteristics.Owner)
WHERE
	Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)

INDEX BY
	Products,
	Characteristic,
	PricingVariant
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	RawData.Products AS Products
INTO RawDataForPackaging
FROM
	RawData AS RawData
		INNER JOIN ItemKinds AS ItemKinds
		ON RawData.ProductKind = ItemKinds.ProductKind
WHERE
	ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.Use)

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RawData.ProductKind AS ProductKind,
	RawData.Products AS Products,
	RawData.Characteristic AS Characteristic,
	RawData.PricingVariant AS PricingVariant,
	ItemsBatches.Series AS Series,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE ItemsBatches.PricingBatch
	END AS PricingBatch,
	CASE
		WHEN Packages.Package IS NULL
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		ELSE Packages.Package
	END AS PricingPackage,
	CASE
		WHEN Packages.Package IS NULL
				OR Packages.Package = RawData.Products.UnitOfMeasure
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		ELSE Packages.Package
	END AS TsoPackagingForCommunication,
	Packages.PackingProcedure AS PackingProcedure
FROM
	RawData AS RawData
		INNER JOIN ItemKinds AS ItemKinds
		ON RawData.ProductKind = ItemKinds.ProductKind
		LEFT JOIN (SELECT
			NestedQuery.Products AS Products,
			NestedQuery.Package AS Package,
			NestedQuery.DeletionMark AS DeletionMark,
			NestedQuery.Description AS PackagePresentation,
			MAX(NestedQuery.ItIsUnitOfStorage) AS ItIsUnitOfStorage,
			MAX(NestedQuery.Order) AS PackingProcedure
		FROM
			(SELECT
				RawDataForPackaging.Products.Ref AS Products,
				RawDataForPackaging.Products.UnitOfMeasure AS Package,
				RawDataForPackaging.Products.UnitOfMeasure.DeletionMark AS DeletionMark,
				RawDataForPackaging.Products.UnitOfMeasure.Description AS Description,
				TRUE AS ItIsUnitOfStorage,
				1 AS Order
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
					ON RawDataForPackaging.Products = CatProducts.Ref
			
			UNION ALL
			
			SELECT
				CatProducts.Ref,
				CatPackages.Ref,
				CatPackages.DeletionMark,
				CatPackages.Description,
				FALSE,
				1
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatPackages
						ON (CASE
								WHEN CatProducts.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
									THEN CatPackages.Owner = CatProducts.Ref
								WHEN CatProducts.PackagingGroup &lt;&gt; VALUE(Catalog.PackagingGroups.EmptyRef)
									THEN CatPackages.Owner = CatProducts.PackagingGroup
								ELSE FALSE
							END)
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				NOT CatPackages.DeletionMark
				AND CatPackages.PackageType &lt;&gt; VALUE(Enum.TypesOfItemsPackages.CargoItem)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				3
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (CatProducts.WeightUse)
							AND (CatProducts.YouCanSpecifyWeightInDocuments)
							AND (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				4
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (CatProducts.VolumeUse)
							AND (CatProducts.VolumeCanBeSpecifiedInDocuments)
							AND (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.VolumeM3))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.VolumeM3)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				5
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (CatProducts.LengthUse)
							AND (CatProducts.YouCanSpecifyLengthInDocuments)
							AND (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Length))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Length)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				6
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (CatProducts.AreaUse)
							AND (CatProducts.AreaCanBeSpecifiedInDocuments)
							AND (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				7
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Capacity))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Capacity)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				8
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Energy))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Energy)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				9
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.ElectricCharge))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.ElectricCharge)
			
			UNION ALL
			
			SELECT
				RawDataForPackaging.Products.Ref,
				ProductPackages.Ref,
				ProductPackages.DeletionMark,
				ProductPackages.Description,
				FALSE,
				10
			FROM
				RawDataForPackaging AS RawDataForPackaging
					LEFT JOIN Catalog.Products AS CatProducts
						INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
						ON (ProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Time))
					ON RawDataForPackaging.Products = CatProducts.Ref
			WHERE
				CatProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Time)) AS NestedQuery
		
		GROUP BY
			NestedQuery.DeletionMark,
			NestedQuery.Description,
			NestedQuery.Products,
			NestedQuery.Package) AS Packages
		ON (ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.Use))
			AND RawData.Products = Packages.Products
		LEFT JOIN (SELECT
			ItemKinds.ProductKind AS ProductKind,
			VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
			ItemsBatchesForPricing.Ref AS PricingBatch
		FROM
			ItemKinds AS ItemKinds
				LEFT JOIN Catalog.ItemsBatchesForPricing AS ItemsBatchesForPricing
				ON (ItemsBatchesForPricing.Predefined)
		WHERE
			ItemKinds.SettingsOfPriceKeyByBatch &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)) AS ItemsBatches
		ON (ItemKinds.ProductKind = ItemsBatches.ProductKind)
{WHERE
	ItemsBatches.Series.*}</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Query</sourceDataSet>
		<destinationDataSet>DataSet1</destinationDataSet>
		<sourceExpression>Products</sourceExpression>
		<destinationExpression>Products</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Query</sourceDataSet>
		<destinationDataSet>DataSet1</destinationDataSet>
		<sourceExpression>Characteristic</sourceExpression>
		<destinationExpression>Characteristic</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Query</sourceDataSet>
		<destinationDataSet>DataSet1</destinationDataSet>
		<sourceExpression>Package</sourceExpression>
		<destinationExpression>TsoPackagingForCommunication</destinationExpression>
	</dataSetLink>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Max(Price)</expression>
	</totalField>
	<parameter>
		<name>DocumentDate</name>
