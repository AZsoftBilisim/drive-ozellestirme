  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>List</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BeingEditedBy</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.CurrentVersionAuthor</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.StoreVersions</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.UsesAdditionalInfo</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	FilesOverridable.BeingEditedBy,
	FilesOverridable.PictureIndex,
	FilesOverridable.Description,
	FilesOverridable.LongDesc,
	FilesOverridable.Ref,
	FilesOverridable.StoreVersions,
	FilesOverridable.FileOwner,
	FilesOverridable.Size / 1024 AS CurrentVersionSize,
	FilesOverridable.Author AS CurrentVersionAuthor,
	TRUE AS UsesAdditionalInfo
FROM
	Catalog.Files AS FilesOverridable
WHERE
	FilesOverridable.BeingEditedBy = &amp;BeingEditedBy</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
