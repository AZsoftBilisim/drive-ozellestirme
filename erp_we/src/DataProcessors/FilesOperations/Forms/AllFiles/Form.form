  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BeingEditedBy</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.CurrentUserEditsFile</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsPictureNumberArchive</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.StoreVersions</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	FilesInfo.BeingEditedBy AS BeingEditedBy,
	FilesInfo.Size / 1024 AS Size,
	FilesInfo.Author AS Author,
	FilesInfo.CreationDate AS CreationDate,
	CASE
		WHEN FilesInfo.DeletionMark
			THEN FilesInfo.PictureIndex + 1
		ELSE FilesInfo.PictureIndex
	END AS PictureIndex,
	FilesInfo.Description AS Description,
	FilesInfo.LongDesc AS LongDesc,
	FilesInfo.File AS Ref,
	FilesInfo.DeletionMark AS DeletionMark,
	CASE
		WHEN FilesInfo.BeingEditedBy = &amp;CurrentUser
			THEN TRUE
		ELSE FALSE
	END AS CurrentUserEditsFile,
	FilesInfo.FileOwner AS FileOwner,
	FilesInfo.Extension AS Extension,
	FilesInfo.StoreVersions AS StoreVersions,
	FilesInfo.SignedEncryptedPictureNumber AS SignedEncryptedPictureNumber,
	FilesInfo.IsInternal AS IsInternal,
	CASE
		WHEN ISNULL(CASE
					WHEN FilesInfo.File REFS Catalog.Files
						THEN FilesToConnect.CurrentVersion.ArchivingDate
					ELSE FilesInfo.ArchivingDate
				END, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
			THEN -1
		ELSE 0
	END AS IsPictureNumberArchive
FROM
	InformationRegister.FilesInfo AS FilesInfo
		LEFT JOIN Catalog.Files AS FilesToConnect
		ON (FilesInfo.File = FilesToConnect.Ref)
WHERE
	NOT FilesInfo.File IS NULL</queryText>
      <mainTable>InformationRegister.FilesInfo</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
