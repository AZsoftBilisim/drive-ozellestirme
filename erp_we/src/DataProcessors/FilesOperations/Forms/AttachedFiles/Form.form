        <id>295</id>
        <title>
          <key>en</key>
          <value>Cloud service picture decoration</value>
        </title>
        <title>
          <key>fa</key>
          <value>تصویر تزئینی سرویس ابری</value>
        </title>
        <title>
          <key>it</key>
          <value>Immagine decorativa del servizio cloud storage</value>
        </title>
        <title>
