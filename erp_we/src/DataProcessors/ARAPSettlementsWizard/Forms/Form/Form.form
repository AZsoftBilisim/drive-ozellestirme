    <name>PickUpGiftCertificate</name>
    <title>
      <key>en</key>
      <value>Select/offset gift card</value>
    </title>
    <title>
      <key>fa</key>
      <value>انتخاب/تهاتر کارت هدیه</value>
    </title>
    <title>
      <key>it</key>
      <value>Selezionare/Riscattare buono regalo</value>
    </title>
