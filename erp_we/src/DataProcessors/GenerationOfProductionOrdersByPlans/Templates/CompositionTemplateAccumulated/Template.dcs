		<field xsi:type="DataSetFieldField">
			<dataPath>ThisIsASemiFinishedProduct</dataPath>
			<field>ThisIsASemiFinishedProduct</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanProfile</dataPath>
			<field>PlanProfile</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DateOfOrderReleaseAndProductionIssue</dataPath>
			<field>DateOfOrderReleaseAndProductionIssue</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ProductionProcessType</dataPath>
			<field>ProductionProcessType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CalculationSeparator</dataPath>
			<field>CalculationSeparator</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(ProductionPlansTurnovers.DayPeriod, DAY)
	END AS DateOfProduction,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ProductionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ProductionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ProductionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ProductionPlansTurnovers.YearPeriod
		ELSE ProductionPlansTurnovers.DayPeriod
	END AS ProductionIssuePeriodStart,
	MIN(ProductionPlansTurnovers.DateOfOrderReleaseAndProductionIssue) AS OrderDate,
	ProductionPlansTurnovers.Products AS Products,
	ProductionPlansTurnovers.Characteristic AS Characteristic,
	ProductionPlansTurnovers.Purpose AS Purpose,
	SUM(ProductionPlansTurnovers.ToOrderTurnover) AS QuantityInPlans,
	ProductionPlansTurnovers.Department AS Department,
	ProductionPlansTurnovers.BillOfMaterials AS BillOfMaterials,
	ProductionStages.Department AS DivisionOfProduction,
	CAST(ResourceSpecificationsOutputProducts.NumberOfPackages * ISNULL(&amp;QueryTextPackagingFactor, 1) AS NUMBER(15,3)) AS ProductsQuantityInBOM,
	ISNULL(StandardProductionDuration.PlannedProductionDurationDays, 0) AS DaysBeforeOrdering
INTO TableOfPlans
FROM
	AccumulationRegister.ProductionPlans.Turnovers(
			&amp;BeginOfPeriod {(&amp;BeginOfPeriod)},
			&amp;PeriodEnding {(&amp;PeriodEnding)},
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND (NOT &amp;FilterByAssignment
					OR Purpose = &amp;Purpose)
				AND (&amp;OrderPeriodStart = DATETIME(1, 1, 1)
					OR (DateOfOrderReleaseAndProductionIssue &gt;= &amp;OrderPeriodStart
						OR DateOfOrderReleaseAndProductionIssue = DATETIME(1, 1, 1)))
				AND (&amp;OrderPeriodEnd = DATETIME(1, 1, 1)
					OR DateOfOrderReleaseAndProductionIssue &lt;= &amp;OrderPeriodEnd) {(Products).* AS Products, (Characteristic).* AS Characteristic, (BillOfMaterials).* AS BillOfMaterials, ((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment AS SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ProductionPlansTurnovers
		LEFT JOIN Catalog.ProductionStages AS ProductionStages
		ON ProductionPlansTurnovers.BillOfMaterials = ProductionStages.Owner
			AND (ProductionStages.NextStageNo = 0)
			AND (NOT ProductionStages.DeletionMark)
		LEFT JOIN Catalog.BillsOfMaterials.ManufacturedProducts AS ResourceSpecificationsOutputProducts
		ON ProductionPlansTurnovers.BillOfMaterials = ResourceSpecificationsOutputProducts.Ref
			AND (ProductionPlansTurnovers.Products = ResourceSpecificationsOutputProducts.Products
				OR ResourceSpecificationsOutputProducts.Products = VALUE(Catalog.Products.EmptyRef)
			AND ResourceSpecificationsOutputProducts.ProductKind = ProductionPlansTurnovers.Products.ProductKind)
			AND (ResourceSpecificationsOutputProducts.Characteristic IN (ProductionPlansTurnovers.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)))
		LEFT JOIN InformationRegister.StandardProductionDuration AS StandardProductionDuration
		ON ProductionPlansTurnovers.BillOfMaterials = StandardProductionDuration.BillOfMaterials

GROUP BY
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(ProductionPlansTurnovers.DayPeriod, DAY)
	END,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ProductionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ProductionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ProductionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ProductionPlansTurnovers.YearPeriod
		ELSE ProductionPlansTurnovers.DayPeriod
	END,
	ProductionPlansTurnovers.Products,
	ProductionPlansTurnovers.Characteristic,
	ProductionPlansTurnovers.Purpose,
	ProductionPlansTurnovers.BillOfMaterials,
	ProductionPlansTurnovers.Department,
	ProductionStages.Department,
	CAST(ResourceSpecificationsOutputProducts.NumberOfPackages * ISNULL(&amp;QueryTextPackagingFactor, 1) AS NUMBER(15,3)),
	ISNULL(StandardProductionDuration.PlannedProductionDurationDays, 0)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	MAX(CatProducts.Code) AS Code,
	MAX(CatProducts.SKU) AS SKU,
	TableOfPlans.ProductionIssuePeriodStart AS ProductionIssuePeriodStart,
	MAX(TableOfPlans.DateOfProduction) AS DateOfProduction,
	MAX(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	CASE
		WHEN TRUE
			THEN 0
	END AS QuantityInOrders,
	MAX(TableOfPlans.QuantityInPlans) 
	- CASE
		WHEN TRUE
			THEN 0
	END AS NumberOfPackages,
	MAX(TableOfPlans.QuantityInPlans)
	- CASE
		WHEN TRUE
			THEN 0
	END AS Count,
	MAX(CASE
			WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
				THEN TRUE
			ELSE FALSE
		END) AS ItemVariantsAreUsed,
	MIN(TableOfPlans.OrderDate) AS OrderDate,
	MIN(TableOfPlans.DaysBeforeOrdering) AS DaysBeforeOrdering,
	TableOfPlans.BillOfMaterials AS BillOfMaterials,
	TableOfPlans.Department AS ProductionDispatcherBusinessUnit,
	CASE
		WHEN TableOfPlans.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS EditBusinessUnit,
	TableOfPlans.ProductsQuantityInBOM AS ProductsQuantityInBOM
INTO SecuredPlans
{SELECT
	Products.*,
	Characteristic.*,
	Purpose.*,
	NumberOfPackages,
	Count,
	SKU,
	ProductionIssuePeriodStart,
	DateOfProduction,
	QuantityInPlans,
	QuantityInOrders,
	ItemVariantsAreUsed,
	OrderDate,
	DaysBeforeOrdering,
	Code,
	BillOfMaterials.*}
FROM
	TableOfPlans AS TableOfPlans
		INNER JOIN Catalog.Products AS CatProducts
		ON TableOfPlans.Products = CatProducts.Ref

GROUP BY
	TableOfPlans.ProductionIssuePeriodStart,
	TableOfPlans.Products,
	TableOfPlans.Characteristic,
	TableOfPlans.Purpose,
	TableOfPlans.BillOfMaterials,
	TableOfPlans.Department,
	TableOfPlans.ProductsQuantityInBOM
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlans.Products AS Products,
	SecuredPlans.Characteristic AS Characteristic,
	SecuredPlans.Purpose AS Purpose,
	SecuredPlans.Code AS Code,
	SecuredPlans.SKU AS SKU,
	SecuredPlans.ProductionIssuePeriodStart AS ProductionIssuePeriodStart,
	SecuredPlans.DateOfProduction AS DateOfProduction,
	SecuredPlans.QuantityInOrders AS QuantityInOrders,
	SecuredPlans.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	SecuredPlans.OrderDate AS OrderDate,
	SecuredPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	SecuredPlans.BillOfMaterials AS BillOfMaterials,
	SecuredPlans.QuantityInPlans AS QuantityInPlans,
	SecuredPlans.NumberOfPackages AS NumberOfPackages,
	SecuredPlans.Count AS Count,
	SecuredPlans.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	SecuredPlans.EditBusinessUnit AS EditBusinessUnit,
	SecuredPlans.ProductsQuantityInBOM AS ProductsQuantityInBOM
INTO SecuredPlansWithDeductionForOtherUnits
FROM
	SecuredPlans AS SecuredPlans

UNION ALL

SELECT
	SecuredPlans.Products,
	SecuredPlans.Characteristic,
	SecuredPlans.Purpose,
	SecuredPlans.Code,
	SecuredPlans.SKU,
	SecuredPlans.ProductionIssuePeriodStart,
	SecuredPlans.DateOfProduction,
	-SecuredPlans.QuantityInOrders,
	SecuredPlans.ItemVariantsAreUsed,
	SecuredPlans.OrderDate,
	SecuredPlans.DaysBeforeOrdering,
	SecuredPlans.BillOfMaterials,
	0,
	SecuredPlans.QuantityInOrders,
	SecuredPlans.QuantityInOrders,
	VALUE(Catalog.BusinessStructure.EmptyRef),
	TRUE,
	SecuredPlans.ProductsQuantityInBOM
FROM
	SecuredPlans AS SecuredPlans
WHERE
	SecuredPlans.ProductionDispatcherBusinessUnit &lt;&gt; VALUE(Catalog.BusinessStructure.EmptyRef)
	AND SecuredPlans.QuantityInOrders &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SecuredPlansWithDeductionForOtherUnits.Products AS Products,
	SecuredPlansWithDeductionForOtherUnits.Characteristic AS Characteristic,
	SecuredPlansWithDeductionForOtherUnits.Purpose AS Purpose,
	SecuredPlansWithDeductionForOtherUnits.Purpose.LineOfBusiness AS LineOfBusiness,
	SecuredPlansWithDeductionForOtherUnits.Code AS Code,
	SecuredPlansWithDeductionForOtherUnits.SKU AS SKU,
	MAX(SecuredPlansWithDeductionForOtherUnits.ProductionIssuePeriodStart) AS ProductionIssuePeriodStart,
	MAX(SecuredPlansWithDeductionForOtherUnits.DateOfProduction) AS DateOfProduction,
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInOrders) AS QuantityInOrders,
	SecuredPlansWithDeductionForOtherUnits.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	MAX(SecuredPlansWithDeductionForOtherUnits.OrderDate) AS OrderDate,
	SecuredPlansWithDeductionForOtherUnits.DaysBeforeOrdering AS DaysBeforeOrdering,
	SecuredPlansWithDeductionForOtherUnits.BillOfMaterials AS BillOfMaterials,
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInPlans) AS QuantityInPlans,
	SUM(SecuredPlansWithDeductionForOtherUnits.NumberOfPackages) AS NumberOfPackages,
	SUM(SecuredPlansWithDeductionForOtherUnits.Count) AS Count,
	SecuredPlansWithDeductionForOtherUnits.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	SecuredPlansWithDeductionForOtherUnits.EditBusinessUnit AS EditBusinessUnit,
	SecuredPlansWithDeductionForOtherUnits.ProductsQuantityInBOM AS ProductsQuantityInBOM
FROM
	SecuredPlansWithDeductionForOtherUnits AS SecuredPlansWithDeductionForOtherUnits

GROUP BY
	SecuredPlansWithDeductionForOtherUnits.Code,
	SecuredPlansWithDeductionForOtherUnits.SKU,
	SecuredPlansWithDeductionForOtherUnits.Products,
	SecuredPlansWithDeductionForOtherUnits.Characteristic,
	SecuredPlansWithDeductionForOtherUnits.Purpose,
	SecuredPlansWithDeductionForOtherUnits.Purpose.LineOfBusiness,
	SecuredPlansWithDeductionForOtherUnits.ItemVariantsAreUsed,
	SecuredPlansWithDeductionForOtherUnits.DaysBeforeOrdering,
	SecuredPlansWithDeductionForOtherUnits.ProductionDispatcherBusinessUnit,
	SecuredPlansWithDeductionForOtherUnits.BillOfMaterials,
	SecuredPlansWithDeductionForOtherUnits.EditBusinessUnit,
	SecuredPlansWithDeductionForOtherUnits.ProductsQuantityInBOM

HAVING
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInPlans) &gt; 0

ORDER BY
	SecuredPlansWithDeductionForOtherUnits.Products,
	SecuredPlansWithDeductionForOtherUnits.Characteristic,
	SecuredPlansWithDeductionForOtherUnits.Purpose</query>
	</dataSet>
