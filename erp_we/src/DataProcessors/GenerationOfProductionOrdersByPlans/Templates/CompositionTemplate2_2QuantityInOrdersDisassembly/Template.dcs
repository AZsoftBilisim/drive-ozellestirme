		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(ProductionPlansTurnovers.DayPeriod, DAY)
	END AS OrderPeriodEnd,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ProductionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ProductionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ProductionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ProductionPlansTurnovers.YearPeriod
		ELSE ProductionPlansTurnovers.DayPeriod
	END AS OrderDate,
	ProductionPlansTurnovers.Products AS Products,
	ProductionPlansTurnovers.Characteristic AS Characteristic,
	ProductionPlansTurnovers.Purpose AS Purpose,
	SUM(ProductionPlansTurnovers.ToOrderTurnover) AS QuantityInPlans,
	ProductionPlansTurnovers.Department AS Department,
	ProductionPlansTurnovers.BillOfMaterials AS BillOfMaterials,
	ProductionStages.Department AS ProductLaunchDivision,
	MAX(CAST(BillsOfMaterials.MainProductNumberOfPackages * ISNULL(&amp;QueryTextPackagingFactor, 1) AS NUMBER(15,3))) AS ProductsQuantityInBOM,
	CASE
		WHEN BudgetingScenarios.DemandForMaterials = VALUE(Enum.MaterialCalculationMethods.MinimumConsumption)
			THEN ISNULL(StandardProductionDuration.PlannedProductionDurationDays, 0)
		ELSE ISNULL(StandardProductionDuration.MaximumProductionDurationDays, 0)
	END AS DaysBeforeOrdering
INTO TableOfPlans
FROM
	AccumulationRegister.ProductionPlans.Turnovers(
			&amp;OrderPeriodStart {(&amp;OrderPeriodStart)},
			&amp;OrderPeriodEnd {(&amp;OrderPeriodEnd)},
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND ProductionProcessType = &amp;ProductionProcessType
				AND Products = &amp;Products
				AND Characteristic = &amp;Characteristic
				AND (NOT &amp;FilterDepartments
					OR Department = &amp;Department)
				AND Purpose = &amp;Purpose
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR (DateOfOrderReleaseAndProductionIssue &gt;= &amp;BeginOfPeriod
						OR DateOfOrderReleaseAndProductionIssue = DATETIME(1, 1, 1)))
				AND (&amp;PeriodEnding = DATETIME(1, 1, 1)
					OR DateOfOrderReleaseAndProductionIssue &lt;= &amp;PeriodEnding) {(Products).* AS Products, (Characteristic).* AS Characteristic, (BillOfMaterials).* AS BillOfMaterials, ((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment AS SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ProductionPlansTurnovers
		LEFT JOIN Catalog.ProductionStages AS ProductionStages
		ON ProductionPlansTurnovers.BillOfMaterials = ProductionStages.Owner
			AND (ProductionStages.StageNumber = 1)
			AND (NOT ProductionStages.DeletionMark)
		LEFT JOIN Catalog.BillsOfMaterials AS BillsOfMaterials
		ON ProductionPlansTurnovers.BillOfMaterials = BillsOfMaterials.Ref
		LEFT JOIN InformationRegister.StandardProductionDuration AS StandardProductionDuration
		ON ProductionPlansTurnovers.BillOfMaterials = StandardProductionDuration.BillOfMaterials
		LEFT JOIN Catalog.SalesOperationsPlanningScenarios AS BudgetingScenarios
		ON (BudgetingScenarios.Ref = &amp;Scenario)

GROUP BY
	ProductionPlansTurnovers.Products,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(ProductionPlansTurnovers.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(ProductionPlansTurnovers.DayPeriod, DAY)
	END,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ProductionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ProductionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ProductionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ProductionPlansTurnovers.YearPeriod
		ELSE ProductionPlansTurnovers.DayPeriod
	END,
	ProductionPlansTurnovers.Characteristic,
	ProductionPlansTurnovers.Purpose,
	ProductionPlansTurnovers.Department,
	ProductionPlansTurnovers.BillOfMaterials,
	ProductionStages.Department,
	CASE
		WHEN BudgetingScenarios.DemandForMaterials = VALUE(Enum.MaterialCalculationMethods.MinimumConsumption)
			THEN ISNULL(StandardProductionDuration.PlannedProductionDurationDays, 0)
		ELSE ISNULL(StandardProductionDuration.MaximumProductionDurationDays, 0)
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, YEAR)
		ELSE BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, DAY)
	END AS EarliestStartDate,
	ProductionOrder2_2ManufacturedProduct.Products AS Products,
	ProductionOrder2_2ManufacturedProduct.Characteristic AS Characteristic,
	CASE
		WHEN &amp;PlanningByAssignments
			THEN ProductionOrder2_2.AssignmentProducts
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	CASE
		WHEN &amp;GenerateOrdersByUpToDateBillsOfMaterials
			THEN VALUE(Catalog.BillsOfMaterials.EmptyRef)
		ELSE ProductionOrder2_2ManufacturedProduct.BillOfMaterials
	END AS BillOfMaterials,
	SUM(ProductionOrder2_2ManufacturedProduct.Count) AS Count,
	ProductionOrder2_2.Department AS Department,
	ProductionOrder2_2.Ref AS ProductionOrder
INTO Orders
FROM
	Document.ProductionOrder2_2.ManufacturedProduct AS ProductionOrder2_2ManufacturedProduct
		{LEFT JOIN SelectionByProductSegment AS SelectionByProductSegment
		ON ProductionOrder2_2ManufacturedProduct.Products = SelectionByProductSegment.Products
			AND ProductionOrder2_2ManufacturedProduct.Characteristic = SelectionByProductSegment.Characteristic}
		LEFT JOIN Document.ProductionOrder2_2 AS ProductionOrder2_2
		ON ProductionOrder2_2ManufacturedProduct.Ref = ProductionOrder2_2.Ref
WHERE
	ProductionOrder2_2ManufacturedProduct.Ref.Posted
	AND NOT ProductionOrder2_2ManufacturedProduct.Canceled
	AND CASE
			WHEN &amp;Department = VALUE(Catalog.BusinessStructure.EmptyRef)
				THEN TRUE
			ELSE ProductionOrder2_2ManufacturedProduct.Ref.Department = &amp;Department
					OR NOT &amp;FilterDepartments
		END
	AND ProductionOrder2_2ManufacturedProduct.Ref.Status &lt;&gt; VALUE(Enum.ProductionOrderStatuses2_2.BeingGenerated)
	AND (NOT &amp;FilterByAssignment
			OR ProductionOrder2_2.AssignmentProducts = &amp;Purpose)
	AND CASE
			WHEN &amp;OrderPeriodStart = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE ProductionOrder2_2.EarliestStartDate &gt;= &amp;OrderPeriodStart
		END
	AND CASE
			WHEN &amp;OrderPeriodEnd = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE ProductionOrder2_2.EarliestStartDate &lt;= &amp;OrderPeriodEnd
		END
{WHERE
	(SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
	ProductionOrder2_2ManufacturedProduct.BillOfMaterials.*,
	ProductionOrder2_2ManufacturedProduct.Products.*,
	ProductionOrder2_2ManufacturedProduct.Characteristic.*}

GROUP BY
	ProductionOrder2_2ManufacturedProduct.Products,
	ProductionOrder2_2ManufacturedProduct.Characteristic,
	CASE
		WHEN &amp;PlanningByAssignments
			THEN ProductionOrder2_2.AssignmentProducts
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	CASE
		WHEN &amp;GenerateOrdersByUpToDateBillsOfMaterials
			THEN VALUE(Catalog.BillsOfMaterials.EmptyRef)
		ELSE ProductionOrder2_2ManufacturedProduct.BillOfMaterials
	END,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, YEAR)
		ELSE BEGINOFPERIOD(ProductionOrder2_2.EarliestStartDate, DAY)
	END,
	ProductionOrder2_2.Department,
	ProductionOrder2_2.Ref


INDEX BY
	EarliestStartDate,
	Products,
	Characteristic,
	Purpose,
	BillOfMaterials
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	MAX(CatProducts.Code) AS Code,
	MAX(CatProducts.SKU) AS SKU,
	TableOfPlans.OrderDate AS OrderDate,
	TableOfPlans.OrderPeriodEnd AS OrderPeriodEnd,
	MAX(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	CASE
		WHEN &amp;GenerateOrdersByUpToDateBillsOfMaterials
			THEN ISNULL(MAX(Orders.Count), 0)
		ELSE ISNULL(SUM(Orders.Count), 0)
	END AS QuantityInOrders,
	MAX(TableOfPlans.QuantityInPlans) - CASE
													WHEN &amp;GenerateOrdersByUpToDateBillsOfMaterials
														THEN ISNULL(MAX(Orders.Count), 0)
													ELSE ISNULL(SUM(Orders.Count), 0)
												END AS NumberOfPackages,
	MAX(TableOfPlans.QuantityInPlans) - CASE
													WHEN &amp;GenerateOrdersByUpToDateBillsOfMaterials
														THEN ISNULL(MAX(Orders.Count), 0)
													ELSE ISNULL(SUM(Orders.Count), 0)
												END AS Count,
	MAX(CASE
			WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
				THEN TRUE
			ELSE FALSE
		END) AS ItemVariantsAreUsed,
	MIN(TableOfPlans.DaysBeforeOrdering) AS DaysBeforeOrdering,
	TableOfPlans.BillOfMaterials AS BillOfMaterials,
	ISNULL(ProductionSupplySchemes.Warehouse, VALUE(Catalog.Warehouses.EmptyRef)) AS Warehouse,
	TableOfPlans.Department AS ProductionDispatcherBusinessUnit,
	CASE
		WHEN TableOfPlans.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS EditBusinessUnit,
	TableOfPlans.ProductsQuantityInBOM AS ProductsQuantityInBOM,
	Orders.ProductionOrder AS ProductionOrder
INTO SecuredPlans
{SELECT
	Products.*,
	Characteristic.*,
	Purpose.*,
	NumberOfPackages,
	Count,
	SKU,
	OrderPeriodEnd,
	QuantityInPlans,
	QuantityInOrders,
	ItemVariantsAreUsed,
	OrderDate,
	DaysBeforeOrdering,
	Code,
	BillOfMaterials.*}
FROM
	TableOfPlans AS TableOfPlans
		INNER JOIN Catalog.Products AS CatProducts
		ON TableOfPlans.Products = CatProducts.Ref
		LEFT JOIN Orders AS Orders
		ON TableOfPlans.OrderDate = Orders.EarliestStartDate
			AND TableOfPlans.Products = Orders.Products
			AND TableOfPlans.Characteristic = Orders.Characteristic
			AND TableOfPlans.Purpose = Orders.Purpose
			AND (CASE
				WHEN TableOfPlans.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef) OR &amp;GenerateOrdersByUpToDateBillsOfMaterials
					THEN TRUE
				ELSE TableOfPlans.BillOfMaterials = Orders.BillOfMaterials
			END)
			AND (CASE
				WHEN TableOfPlans.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
					THEN TRUE
				ELSE TableOfPlans.Department = Orders.Department
			END)
		LEFT JOIN InformationRegister.ProductionSupplySchemes AS ProductionSupplySchemes
		ON TableOfPlans.Products.SupplyScheme = ProductionSupplySchemes.SupplyScheme
			AND TableOfPlans.ProductLaunchDivision = ProductionSupplySchemes.Department

GROUP BY
	TableOfPlans.Department,
	TableOfPlans.Products,
	TableOfPlans.Characteristic,
	TableOfPlans.Purpose,
	TableOfPlans.BillOfMaterials,
	TableOfPlans.OrderDate,
	TableOfPlans.OrderPeriodEnd,
	ISNULL(ProductionSupplySchemes.Warehouse, VALUE(Catalog.Warehouses.EmptyRef)),
	TableOfPlans.ProductsQuantityInBOM,
	Orders.ProductionOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlans.Products AS Products,
	SecuredPlans.Characteristic AS Characteristic,
	SecuredPlans.Purpose AS Purpose,
	SecuredPlans.Code AS Code,
	SecuredPlans.SKU AS SKU,
	SecuredPlans.OrderPeriodEnd AS OrderPeriodEnd,
	SecuredPlans.QuantityInPlans AS QuantityInPlans,
	SecuredPlans.QuantityInOrders AS QuantityInOrders,
	SecuredPlans.NumberOfPackages AS NumberOfPackages,
	SecuredPlans.Count AS Count,
	SecuredPlans.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	SecuredPlans.OrderDate AS OrderDate,
	SecuredPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	SecuredPlans.BillOfMaterials AS BillOfMaterials,
	SecuredPlans.Warehouse AS Warehouse,
	SecuredPlans.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	SecuredPlans.EditBusinessUnit AS EditBusinessUnit,
	SecuredPlans.ProductsQuantityInBOM AS ProductsQuantityInBOM,
	SecuredPlans.ProductionOrder AS ProductionOrder
INTO SecuredPlansWithDeductionForOtherUnits
FROM
	SecuredPlans AS SecuredPlans

UNION ALL

SELECT
	SecuredPlans.Products,
	SecuredPlans.Characteristic,
	SecuredPlans.Purpose,
	SecuredPlans.Code,
	SecuredPlans.SKU,
	SecuredPlans.OrderPeriodEnd,
	0,
	-SecuredPlans.QuantityInOrders,
	SecuredPlans.QuantityInOrders,
	SecuredPlans.QuantityInOrders,
	SecuredPlans.ItemVariantsAreUsed,
	SecuredPlans.OrderDate,
	SecuredPlans.DaysBeforeOrdering,
	SecuredPlans.BillOfMaterials,
	SecuredPlans.Warehouse,
	VALUE(Catalog.BusinessStructure.EmptyRef),
	TRUE,
	SecuredPlans.ProductsQuantityInBOM,
	SecuredPlans.ProductionOrder
FROM
	SecuredPlans AS SecuredPlans
WHERE
	SecuredPlans.ProductionDispatcherBusinessUnit &lt;&gt; VALUE(Catalog.BusinessStructure.EmptyRef)
	AND SecuredPlans.QuantityInOrders &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SecuredPlansWithDeductionForOtherUnits.ProductionDispatcherBusinessUnit AS Department,
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInOrders) AS Count,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder AS Document,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder.PointInTime AS PointInTime,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder.Date AS DocumentDate,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder.Number AS DocumentNumber
FROM
	SecuredPlansWithDeductionForOtherUnits AS SecuredPlansWithDeductionForOtherUnits

GROUP BY
	SecuredPlansWithDeductionForOtherUnits.ProductionDispatcherBusinessUnit,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder.PointInTime,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder.Date,
	SecuredPlansWithDeductionForOtherUnits.ProductionOrder.Number

HAVING
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInOrders) &gt; 0</query>
	</dataSet>
