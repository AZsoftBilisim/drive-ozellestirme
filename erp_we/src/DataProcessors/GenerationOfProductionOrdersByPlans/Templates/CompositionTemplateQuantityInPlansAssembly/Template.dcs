		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SUM(ProductionPlansTurnovers.ToOrderTurnover) AS Count,
	ProductionPlansTurnovers.ProductionPlan AS Document,
	ProductionPlansTurnovers.ProductionPlan.PointInTime AS PointInTime,
	ProductionPlansTurnovers.ProductionPlan.Date AS DocumentDate,
	ProductionPlansTurnovers.ProductionPlan.Number AS DocumentNumber
FROM
	AccumulationRegister.ProductionPlans.Turnovers(
			&amp;BeginOfPeriod {(&amp;BeginOfPeriod)},
			&amp;PeriodEnding {(&amp;PeriodEnding)},
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND (ProductionProcessType = &amp;ProductionProcessType
					OR NOT &amp;UseProductionManagement2_2)
				AND Products = &amp;Products
				AND Characteristic = &amp;Characteristic
				AND Department = &amp;Department
				AND Purpose = &amp;Purpose
				AND (&amp;OrderPeriodStart = DATETIME(1, 1, 1)
					OR (DateOfOrderReleaseAndProductionIssue &gt;= &amp;OrderPeriodStart
						OR DateOfOrderReleaseAndProductionIssue = DATETIME(1, 1, 1)))
				AND (&amp;OrderPeriodEnd = DATETIME(1, 1, 1)
					OR DateOfOrderReleaseAndProductionIssue &lt;= &amp;OrderPeriodEnd) {(Products).* AS Products, (Characteristic).* AS Characteristic, (BillOfMaterials).* AS BillOfMaterials, ((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment AS SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ProductionPlansTurnovers

GROUP BY
	ProductionPlansTurnovers.ProductionPlan</query>
	</dataSet>
