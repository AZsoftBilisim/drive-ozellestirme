				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Chỉ mục hình ảnh</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CatalogBudgetProfiles.Ref AS Ref,
	CatalogBudgetProfiles.DeletionMark AS DeletionMark,
	CatalogBudgetProfiles.Owner AS Owner,
	CatalogBudgetProfiles.Parent AS Parent,
	CatalogBudgetProfiles.IsFolder AS IsFolder,
	CatalogBudgetProfiles.Description AS Description,
	CatalogBudgetProfiles.Comment AS Comment,
	CatalogBudgetProfiles.UseToEnterPlan AS UseToEnterPlan,
	CatalogBudgetProfiles.Periodicity AS Periodicity,
	CatalogBudgetProfiles.PlanningMethod AS PlanningMethod,
	CatalogBudgetProfiles.LocationOptionOfActualDataOffset AS LocationOptionOfActualDataOffset,
	CatalogBudgetProfiles.NumberOfPeriodsOfRollingBudget AS NumberOfPeriodsOfRollingBudget,
	CatalogBudgetProfiles.ActualDataLimitOffset AS ActualDataLimitOffset,
	CatalogBudgetProfiles.ActualDataLimitTimeFence AS ActualDataLimitTimeFence,
	CatalogBudgetProfiles.Predefined AS Predefined,
	CatalogBudgetProfiles.PredefinedDataName AS PredefinedDataName,
	FALSE AS Flag,
	NOT CatalogBudgetProfiles.IsFolder AS PictureIndex
{SELECT
	Ref.*,
	DeletionMark,
	Owner.*,
	Parent.*,
	IsFolder,
	Description,
	Comment,
	UseToEnterPlan,
	Periodicity.*,
	PlanningMethod.*,
	LocationOptionOfActualDataOffset.*,
	NumberOfPeriodsOfRollingBudget,
	ActualDataLimitOffset,
	ActualDataLimitTimeFence.*,
	Predefined,
	PredefinedDataName}
FROM
	Catalog.BudgetProfiles AS CatalogBudgetProfiles
WHERE
	CatalogBudgetProfiles.Owner = &amp;Owner
	AND NOT CatalogBudgetProfiles.IsFolder
	AND NOT CatalogBudgetProfiles.DeletionMark
{WHERE
	CatalogBudgetProfiles.Ref.*,
	CatalogBudgetProfiles.DeletionMark,
	CatalogBudgetProfiles.Owner.*,
	CatalogBudgetProfiles.Parent.*,
	CatalogBudgetProfiles.IsFolder,
	CatalogBudgetProfiles.Description,
	CatalogBudgetProfiles.Comment,
	CatalogBudgetProfiles.UseToEnterPlan,
	CatalogBudgetProfiles.Periodicity.*,
	CatalogBudgetProfiles.PlanningMethod.*,
	CatalogBudgetProfiles.LocationOptionOfActualDataOffset.*,
	CatalogBudgetProfiles.NumberOfPeriodsOfRollingBudget,
	CatalogBudgetProfiles.ActualDataLimitOffset,
	CatalogBudgetProfiles.ActualDataLimitTimeFence.*,
	CatalogBudgetProfiles.Predefined,
	CatalogBudgetProfiles.PredefinedDataName}</query>
	</dataSet>
