		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;BeginOfPeriod AS Period,
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;BeginOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	ExchangeRates.Period &gt; &amp;BeginOfPeriod
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND ExchangeRates.BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(TurnoversAndTurnovers.PlanningPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(TurnoversAndTurnovers.PlanningPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(TurnoversAndTurnovers.PlanningPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(TurnoversAndTurnovers.PlanningPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(TurnoversAndTurnovers.PlanningPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(TurnoversAndTurnovers.PlanningPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(TurnoversAndTurnovers.PlanningPeriod, DAY, -&amp;PeriodOffset)
	END AS Period,
	CASE TYPE(Catalog.Partners)
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension1)
			THEN TurnoversAndTurnovers.Dimension1
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension2)
			THEN TurnoversAndTurnovers.Dimension2
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension3)
			THEN TurnoversAndTurnovers.Dimension3
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension4)
			THEN TurnoversAndTurnovers.Dimension4
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension5)
			THEN TurnoversAndTurnovers.Dimension5
		ELSE VALUE(Catalog.Products.EmptyRef)
	END AS Partner,
	CASE TYPE(Catalog.Warehouses)
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension1)
			THEN TurnoversAndTurnovers.Dimension1
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension2)
			THEN TurnoversAndTurnovers.Dimension2
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension3)
			THEN TurnoversAndTurnovers.Dimension3
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension4)
			THEN TurnoversAndTurnovers.Dimension4
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension5)
			THEN TurnoversAndTurnovers.Dimension5
		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	END AS Warehouse,
	CASE TYPE(Catalog.Products)
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension1)
			THEN TurnoversAndTurnovers.Dimension1
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension2)
			THEN TurnoversAndTurnovers.Dimension2
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension3)
			THEN TurnoversAndTurnovers.Dimension3
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension4)
			THEN TurnoversAndTurnovers.Dimension4
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension5)
			THEN TurnoversAndTurnovers.Dimension5
		ELSE VALUE(Catalog.Products.EmptyRef)
	END AS Products,
	CASE TYPE(Catalog.ProductCategories)
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension1)
			THEN TurnoversAndTurnovers.Dimension1
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension2)
			THEN TurnoversAndTurnovers.Dimension2
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension3)
			THEN TurnoversAndTurnovers.Dimension3
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension4)
			THEN TurnoversAndTurnovers.Dimension4
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension5)
			THEN TurnoversAndTurnovers.Dimension5
		ELSE VALUE(Catalog.Products.EmptyRef)
	END AS ProductCategory,
	TurnoversAndTurnovers.CountTurnover AS Count,
	CASE
		WHEN TurnoversAndTurnovers.CountTurnover = 0
			THEN 0
		ELSE TurnoversAndTurnovers.ScenarioAmountTurnover / TurnoversAndTurnovers.CountTurnover
	END AS Price,
	TurnoversAndTurnovers.Currency AS Currency,
	CASE TYPE(Catalog.LinesOfBusiness)
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension1)
			THEN TurnoversAndTurnovers.Dimension1
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension2)
			THEN TurnoversAndTurnovers.Dimension2
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension3)
			THEN TurnoversAndTurnovers.Dimension3
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension4)
			THEN TurnoversAndTurnovers.Dimension4
		WHEN VALUETYPE(TurnoversAndTurnovers.Dimension5)
			THEN TurnoversAndTurnovers.Dimension5
		ELSE VALUE(Catalog.Products.EmptyRef)
	END AS LineOfBusiness
INTO BudgetTurnovers
FROM
	AccumulationRegister.BudgetTurnovers.Turnovers({(&amp;PeriodStartFilterIsNotUsed)}, {(&amp;PeriodEndFilterIsNotUsed)}, Auto, BudgetFlowItem = &amp;BudgetFlowItem {(PlanningPeriod &gt;= &amp;BeginOfPeriod), (PlanningPeriod &lt;= &amp;EndOfPeriod)}) AS TurnoversAndTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN LinesOfBusiness.CostAccounting
			THEN LinesOfBusiness.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	BudgetTurnovers.Period AS Period,
	BudgetTurnovers.Partner AS Partner,
	BudgetTurnovers.Warehouse AS Warehouse,
	BudgetTurnovers.Products AS Products,
	BudgetTurnovers.ProductCategory AS ProductCategory,
	BudgetTurnovers.Count AS Count,
	BudgetTurnovers.Price * CASE
					WHEN BudgetTurnovers.Currency &lt;&gt; &amp;ScenarioCurrency
						THEN CASE
							WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
							AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
							AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
							AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
								THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
							ELSE 0
						END
					ELSE 1
				END AS Price,
	BudgetTurnovers.LineOfBusiness AS LineOfBusiness
FROM
	BudgetTurnovers AS BudgetTurnovers
		LEFT JOIN Catalog.LinesOfBusiness AS LinesOfBusiness
		ON BudgetTurnovers.LineOfBusiness = LinesOfBusiness.Ref
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (BudgetTurnovers.Currency &lt;&gt; &amp;ScenarioCurrency)
			AND (ManSExchangeRates.Currency = BudgetTurnovers.Currency)
			AND BEGINOFPERIOD(BudgetTurnovers.Period, DAY) = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (BudgetTurnovers.Currency &lt;&gt; &amp;ScenarioCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND BEGINOFPERIOD(BudgetTurnovers.Period, DAY) = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (BudgetTurnovers.Currency &lt;&gt; &amp;ScenarioCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = BudgetTurnovers.Currency)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;BeginOfPeriod)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (BudgetTurnovers.Currency &lt;&gt; &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Avg(Price)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End Else &amp;BeginOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End Else &amp;EndOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
