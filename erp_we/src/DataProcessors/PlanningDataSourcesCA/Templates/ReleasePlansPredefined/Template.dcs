			<dataPath>ProductBOM</dataPath>
			<field>ProductBOM</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ItemVariant</dataPath>
			<field>ItemVariant</field>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameterLinks</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameterLinks">
						<dcscor:item>
							<dcscor:choiceParameter>Products</dcscor:choiceParameter>
							<dcscor:value>ProductsItems</dcscor:value>
							<dcscor:mode xmlns:d8p1="http://v8.1c.ru/8.1/data/enterprise" xsi:type="d8p1:LinkedValueChangeMode">Clear</dcscor:mode>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ProductionDate</dataPath>
			<field>ProductionDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanProfile</dataPath>
			<field>PlanProfile</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CalculationSeparator</dataPath>
			<field>CalculationSeparator</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(ReleasePlansProducts_Turnovers.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(ReleasePlansProducts_Turnovers.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(ReleasePlansProducts_Turnovers.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(ReleasePlansProducts_Turnovers.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(ReleasePlansProducts_Turnovers.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(ReleasePlansProducts_Turnovers.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(ReleasePlansProducts_Turnovers.DayPeriod, DAY, -&amp;PeriodOffset)
	END AS Period,
	ReleasePlansProducts_Turnovers.Products AS Products,
	ReleasePlansProducts_Turnovers.Characteristic AS Characteristic,
	ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit AS Department,
	ReleasePlansProducts_Turnovers.CountTurnover AS Count,
	ReleasePlansProducts_Turnovers.Purpose AS Purpose
FROM
	AccumulationRegister.ReleasePlansProducts_.Turnovers(, , Auto, {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        &amp;FilterByProductSegmentIsUsed = TRUE))}) AS ReleasePlansProducts_Turnovers
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCRevenue
		ON (ABCRevenue.ClassificationSection = ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit)
			AND (ABCRevenue.Products = ReleasePlansProducts_Turnovers.Products)
			AND (ABCRevenue.Characteristic = ReleasePlansProducts_Turnovers.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCGrossProfit
		ON (ABCGrossProfit.ClassificationSection = ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit)
			AND (ABCGrossProfit.Products = ReleasePlansProducts_Turnovers.Products)
			AND (ABCGrossProfit.Characteristic = ReleasePlansProducts_Turnovers.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCCount
		ON (ABCCount.ClassificationSection = ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit)
			AND (ABCCount.Products = ReleasePlansProducts_Turnovers.Products)
			AND (ABCCount.Characteristic = ReleasePlansProducts_Turnovers.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZRevenue
		ON (XYZRevenue.ClassificationSection = ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit)
			AND (XYZRevenue.Products = ReleasePlansProducts_Turnovers.Products)
			AND (XYZRevenue.Characteristic = ReleasePlansProducts_Turnovers.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZGrossProfit
		ON (XYZGrossProfit.ClassificationSection = ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit)
			AND (XYZGrossProfit.Products = ReleasePlansProducts_Turnovers.Products)
			AND (XYZGrossProfit.Characteristic = ReleasePlansProducts_Turnovers.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZCount
		ON (XYZCount.ClassificationSection = ReleasePlansProducts_Turnovers.ProductionDispatcherBusinessUnit)
			AND (XYZCount.Products = ReleasePlansProducts_Turnovers.Products)
			AND (XYZCount.Characteristic = ReleasePlansProducts_Turnovers.Characteristic)}
		
{WHERE
	(CAST(ISNULL(ABCRevenue.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCRevenue,
	(CAST(ISNULL(ABCGrossProfit.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCGrossProfit,
	(CAST(ISNULL(ABCCount.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCCount,
	(CAST(ISNULL(XYZRevenue.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZRevenue,
	(CAST(ISNULL(XYZGrossProfit.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZGrossProfit,
	(CAST(ISNULL(XYZCount.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZCount}</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End Else &amp;BeginOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End Else &amp;EndOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
