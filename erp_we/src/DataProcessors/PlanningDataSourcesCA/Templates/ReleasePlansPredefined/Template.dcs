	<parameter>
		<name>ChangeToTheSeasonalIndex</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Apply seasonal index</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اعمال شاخص فصلی</v8:content>
			</v8:item>
