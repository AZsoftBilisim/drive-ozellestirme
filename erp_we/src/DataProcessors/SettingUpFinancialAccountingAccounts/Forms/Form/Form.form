    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	SettingsOfFinancialAccountingAccountsByObject.ChartOfAccounts,
	SettingsOfFinancialAccountingAccountsByObject.PostingGenerationSetting,
	SettingsOfFinancialAccountingAccountsByObject.SettingType,
	SettingsOfFinancialAccountingAccountsByObject.AccountingObject,
	SettingsOfFinancialAccountingAccountsByObject.SettingObject1,
	SettingsOfFinancialAccountingAccountsByObject.Organization,
	SettingsOfFinancialAccountingAccountsByObject.PlaceOfRegistration,
	SettingsOfFinancialAccountingAccountsByObject.GLAccount,
	SettingsOfFinancialAccountingAccountsByObject.LedgerAccountLongTerm
FROM
	InformationRegister.SettingsOfFinancialAccountingAccountsByObject AS SettingsOfFinancialAccountingAccountsByObject
WHERE
	SettingsOfFinancialAccountingAccountsByObject.SettingType = VALUE(Enum.TypesOfPostingsSettingsInFinancialAccounting.ExceptionForTheAccountingObject)</queryText>
