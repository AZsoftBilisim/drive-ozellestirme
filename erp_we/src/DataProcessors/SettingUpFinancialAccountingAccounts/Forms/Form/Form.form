    </title>
    <title>
      <key>vi</key>
      <value>Thiết lập hiển thị đối ứng</value>
    </title>
    <id>56</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CorrespondenceReflectionSettings.ItIsNotReflectedInTheAccounts</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CorrespondenceReflectionSettings.LongTermCr</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CorrespondenceReflectionSettings.LongTermDr</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE
		WHEN CorrespondenceReflectionSettings.AccountingObjectDr = &amp;CurrentAccountingObject
			AND CorrespondenceReflectionSettings.AccountingObjectCr = &amp;CurrentAccountingObject
			THEN &amp;AlignDrCr
		WHEN CorrespondenceReflectionSettings.AccountingObjectDr = &amp;CurrentAccountingObject
			THEN &amp;AlignDr
		WHEN CorrespondenceReflectionSettings.AccountingObjectCr = &amp;CurrentAccountingObject
			THEN &amp;AlignCr
	END AS Align,
	CorrespondenceReflectionSettings.AccountingObjectDr,
	CorrespondenceReflectionSettings.AccountingObjectCr,
	CorrespondenceReflectionSettings.LongTermDr,
	CorrespondenceReflectionSettings.LongTermCr,
	CorrespondenceReflectionSettings.ApplicationProcedure,
	CorrespondenceReflectionSettings.LedgerAccountIsDeterminedByAccountingObjectSetupDr,
	CorrespondenceReflectionSettings.LedgerAccountIsDeterminedByAccountingObjectSetupCr,
	CorrespondenceReflectionSettings.GLAccountDr,
	CorrespondenceReflectionSettings.GLAccountCr,
	CorrespondenceReflectionSettings.LongDesc,
	CorrespondenceReflectionSettings.ApplySubsequentSettings,
	CorrespondenceReflectionSettings.ItIsNotReflectedInTheAccounts,
	CorrespondenceReflectionSettings.ThereIsAdditionalSelectionDr,
	CorrespondenceReflectionSettings.ThereIsAdditionalSelectionCr,
	&quot;               &quot; AS PresentationDueDateDr,
	&quot;               &quot; AS PresentationDueDateCr
FROM
	InformationRegister.SettingsForReflectingCorrespondenceInFinancialAccounting AS CorrespondenceReflectionSettings
WHERE
	(CorrespondenceReflectionSettings.AccountingObjectCr = &amp;CurrentAccountingObject
		OR CorrespondenceReflectionSettings.AccountingObjectDr = &amp;CurrentAccountingObject
		OR &amp;SharedList)
	AND (NOT (CorrespondenceReflectionSettings.LongTermDr OR CorrespondenceReflectionSettings.LongTermCr)
		OR CorrespondenceReflectionSettings.PostingGenerationSetting.DivisionIntoShortTermLongTermAssetsAndLiabilities)</queryText>
      <mainTable>InformationRegister.SettingsForReflectingCorrespondenceInFinancialAccounting</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
