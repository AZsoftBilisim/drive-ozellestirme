	International.Reclass, 
	International.ExcludeFromExchangeDifferenceCalculationInFunctionalCurrency, 
	International.ExtDimensionTypes.*, 
	International.PredefinedDataName,
	TRUE IN (
		SELECT TOP 1
			TRUE
		FROM
			InformationRegister.SettingsOfFinancialAccountingAccountsByObject AS Settings
		WHERE
			Settings.GLAccount = International.Ref
			AND Settings.PostingGenerationSetting = &amp;PostingGenerationSetting
		)
	OR TRUE IN (
		SELECT TOP 1
			TRUE
		FROM
			InformationRegister.SettingsForReflectingCorrespondenceInFinancialAccounting AS Settings
		WHERE
			Settings.PostingGenerationSetting = &amp;PostingGenerationSetting
			AND (Settings.GLAccountDr = International.Ref OR Settings.GLAccountCr = International.Ref)
			AND (NOT (Settings.LongTermCr OR Settings.LongTermDr)
				OR Settings.PostingGenerationSetting.DivisionIntoShortTermLongTermAssetsAndLiabilities)
	) AS HasSettings
FROM
	ChartOfAccounts.International AS International</queryText>
      <mainTable>ChartOfAccounts.International</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
