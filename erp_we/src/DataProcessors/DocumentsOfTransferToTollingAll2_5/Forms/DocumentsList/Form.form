  <attributes>
    <name>ListProcessingDocuments</name>
    <title>
      <key>en</key>
      <value>List processing documents </value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد پردازش</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco documenti lavorazioni</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista dokumenty przetworzenia</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документы переработки</value>
    </title>
    <title>
      <key>tr</key>
      <value>İşleme belgeleri listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ gia công</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProcessingDocuments.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProcessingDocuments.OverallState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProcessingDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProcessingDocuments.SourceDocumentOriginalState</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentsRegistryOverridable.Ref AS Ref,
	DocumentsRegistryOverridable.Posted AS Posted,
	DocumentsRegistryOverridable.DeletionMark AS DeletionMark,
	DocumentsRegistryOverridable.IBDocumentNumber AS Number,
	DocumentsRegistryOverridable.IBDocumentDate AS Date,
	DocumentsRegistryOverridable.Sum AS DocumentAmount,
	DocumentsRegistryOverridable.Currency AS Currency,
	DocumentsRegistryOverridable.Organization AS Organization,
	DocumentsRegistryOverridable.Department AS Department,
	DocumentsRegistryOverridable.StorageLocation AS StorageLocation,
	CAST(DocumentsRegistryOverridable.StorageLocation.Key AS Catalog.Warehouses) AS Warehouse,
	DocumentsRegistryOverridable.EmployeeResponsible AS Manager,
	DocumentsRegistryOverridable.Author AS Author,
	DocumentsRegistryOverridable.Partner AS Partner,
	CAST(DocumentsRegistryOverridable.Counterparty.Key AS Catalog.Counterparties) AS Counterparty,
	DocumentsRegistryOverridable.Counterparty AS CounterpartyKey,
	DocumentsRegistryOverridable.Contract AS Contract,
	DocumentsRegistryOverridable.BusinessOperation AS BusinessOperation,
	DocumentsRegistryOverridable.Status AS Status,
	DocumentsRegistryOverridable.More AS More,
	DocumentsRegistryOverridable.Comment AS Comment,
	DocumentsRegistryOverridable.SourceDocumentNumber AS IncomingDocumentNumber,
	DocumentsRegistryOverridable.SourceDocumentDate AS IncomingDocumentDate,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrorsOverridable.Document IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties,
	CASE
		WHEN DocumentsRegistryOverridable.Posted
			THEN 0
		WHEN DocumentsRegistryOverridable.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	DocumentsRegistryOverridable.AdditionalRecord AS AdditionalRecord,
	DocumentsRegistryOverridable.RefType AS RefType,
	&amp;CheckStatus AS CheckStatus,
	&amp;CheckingIndicator AS CheckingIndicator,
	VALUETYPE(DocumentsRegistryOverridable.Ref) AS ValueType,
	DocumentsRegistryOverridable.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistryOverridable.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistryOverridable.ReversedDocument
	END AS ReversedCorrectedDocument,
	NULL AS SourceDocumentOriginalState,
	TRUE AS OverallState,
	0 AS StateOriginalReceived,
	DocumentsRegistryOverridable.RecordID AS RecordID,
	EDStatesOverridable.StatusPresentation AS StatusPresentation
{WHERE
	DocumentsRegistryOverridable.Ref.* AS Ref,
	DocumentsRegistryOverridable.StorageLocation.* AS StorageLocation,
	CAST(DocumentsRegistryOverridable.StorageLocation.Key AS Catalog.Warehouses).* AS Warehouse,
	DocumentsRegistryOverridable.Organization.* AS Organization,
	DocumentsRegistryOverridable.IBDocumentDate AS Date,
	DocumentsRegistryOverridable.IBDocumentNumber AS Number,
	DocumentsRegistryOverridable.Status AS Status,
	DocumentsRegistryOverridable.RefType AS RefType,
	DocumentsRegistryOverridable.BusinessOperation AS BusinessOperation,
	CAST(DocumentsRegistryOverridable.Counterparty.Key AS Catalog.Counterparties).* AS Counterparty,
	DocumentsRegistryOverridable.Department.* AS Department,
	DocumentsRegistryOverridable.EmployeeResponsible.* AS Manager,
	DocumentsRegistryOverridable.Author.* AS Author,
	DocumentsRegistryOverridable.More AS More,
	DocumentsRegistryOverridable.Comment AS Comment,
	DocumentsRegistryOverridable.Posted AS Posted,
	DocumentsRegistryOverridable.DeletionMark AS DeletionMark,
	(DocumentsRegistryOverridable.IBDocumentDate >= &amp;BeginOfPeriod
	AND DocumentsRegistryOverridable.IBDocumentDate &lt;= &amp;EndOfPeriod)}
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistryOverridable
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON EDStatesOverridable.ObjectReference = DocumentsRegistryOverridable.Ref
		LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS
			DocumentsWithCounterpartyCheckErrorsOverridable
		ON DocumentsRegistryOverridable.Ref = DocumentsWithCounterpartyCheckErrorsOverridable.Document
		AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
