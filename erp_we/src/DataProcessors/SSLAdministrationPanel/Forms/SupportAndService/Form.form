        <items xsi:type="form:FormField">
          <name>UpdateViaCopy</name>
          <id>2249</id>
          <title>
            <key>en</key>
            <value>Update via copy</value>
          </title>
          <title>
            <key>fa</key>
            <value>به‌روزرسانی از طریق کپی</value>
          </title>
          <title>
            <key>it</key>
            <value>Aggiornamento tramite copia</value>
          </title>
          <title>
            <key>pl</key>
            <value>Aktualizacja za pomocą kopii</value>
          </title>
          <title>
            <key>ru</key>
            <value>Обновление через копию</value>
          </title>
          <title>
            <key>tr</key>
            <value>Kopya üzerinden güncelleme</value>
          </title>
          <title>
            <key>vi</key>
            <value>Cập nhật qua bản sao</value>
          </title>
