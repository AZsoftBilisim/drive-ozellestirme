  <attributes>
    <name>CertificateList</name>
    <title>
      <key>en</key>
      <value>Certificate list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست گواهی‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco atti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista protokołów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список актов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Tutanak listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách biên bản</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CertificateList.DefaultPicture</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CertificateList.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CertificateList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InternalDocumentDataOverridable.Ref AS Ref,
	InternalDocumentDataOverridable.StorageLocation AS StorageLocation,
	CAST(InternalDocumentDataOverridable.StorageLocation.Key AS Catalog.Warehouses) AS Warehouse,
	InternalDocumentDataOverridable.Organization AS Organization,
	InternalDocumentDataOverridable.Department AS Department,
	InternalDocumentDataOverridable.IBDocumentDate AS Date,
	InternalDocumentDataOverridable.IBDocumentNumber AS Number,
	InternalDocumentDataOverridable.Status AS Status,
	InternalDocumentDataOverridable.BusinessOperation AS BusinessOperation,
	InternalDocumentDataOverridable.EmployeeResponsible AS EmployeeResponsible,
	InternalDocumentDataOverridable.More AS More,
	InternalDocumentDataOverridable.Comment AS Comment,
	InternalDocumentDataOverridable.Posted AS Posted,
	InternalDocumentDataOverridable.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	EDStatesOverridable.StatusPresentation AS StatusPresentation,
	CASE
		WHEN NOT InternalDocumentDataOverridable.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE InternalDocumentDataOverridable.ReversedDocument
	END AS ReversedCorrectedDocument,
	InternalDocumentDataOverridable.DeletionMark AS DeletionMark,
	&amp;CheckStatus AS CheckStatus,
	&amp;CheckingIndicator AS CheckingIndicator,
	VALUETYPE(InternalDocumentDataOverridable.Ref) AS Type,
	CASE
		WHEN InternalDocumentDataOverridable.Posted
			THEN 0
		WHEN InternalDocumentDataOverridable.DeletionMark
			THEN 1
		ELSE 2
	END AS Picture,
	InternalDocumentDataOverridable.RefType AS RefType,
	InternalDocumentDataOverridable.RecordID AS RecordID
{WHERE
	InternalDocumentDataOverridable.Ref.* AS Ref,
	InternalDocumentDataOverridable.StorageLocation.* AS StorageLocation,
	CAST(InternalDocumentDataOverridable.StorageLocation.Key AS Catalog.Warehouses).* AS Warehouse,
	InternalDocumentDataOverridable.Organization.* AS Organization,
	InternalDocumentDataOverridable.IBDocumentDate AS Date,
	InternalDocumentDataOverridable.IBDocumentNumber AS Number,
	InternalDocumentDataOverridable.Status AS Status,
	InternalDocumentDataOverridable.BusinessOperation AS BusinessOperation,
	InternalDocumentDataOverridable.Department.* AS Department,
	InternalDocumentDataOverridable.EmployeeResponsible.* AS EmployeeResponsible,
	InternalDocumentDataOverridable.More AS More,
	InternalDocumentDataOverridable.Comment AS Comment,
	InternalDocumentDataOverridable.Posted AS Posted,
	InternalDocumentDataOverridable.DeletionMark AS DeletionMark,
	(InternalDocumentDataOverridable.IBDocumentDate >= &amp;BeginOfPeriod
	AND InternalDocumentDataOverridable.IBDocumentDate &lt;= &amp;EndOfPeriod)}
FROM
	InformationRegister.DocumentsRegistry AS InternalDocumentDataOverridable
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON EDStatesOverridable.ObjectReference = InternalDocumentDataOverridable.Ref}
	</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
