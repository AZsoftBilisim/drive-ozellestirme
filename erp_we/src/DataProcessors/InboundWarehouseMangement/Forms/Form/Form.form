  <attributes>
    <name>ProductPoolPlacement</name>
    <title>
      <key>en</key>
      <value>Items to put away</value>
    </title>
    <title>
      <key>fa</key>
      <value>اقلام برای جای‌گذاری</value>
    </title>
    <title>
      <key>it</key>
      <value>Pool articoli da collocare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Pula produktów rozmieszczenie</value>
    </title>
    <title>
      <key>ru</key>
      <value>Пул номенклатуры размещение</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ürün gamı havuzu yerleştirme</value>
    </title>
    <title>
      <key>vi</key>
      <value>Nhóm sản phẩm sắp xếp</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseBinLocationWarehousing</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.Characteristic</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.ErrorInPackaging</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.ErrorInTheStorageArea</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.ItemError</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.Package</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.Purpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.Series</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.WarehouseGroupOfPackages</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductPoolPlacement.WarehouseGroupOfProducts</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	NestedQuery.Products,
	NestedQuery.WarehouseGroupOfProducts,
	NestedQuery.Characteristic,
	NestedQuery.Package,
	NestedQuery.WarehouseGroupOfPackages,
	NestedQuery.Place,
	NestedQuery.TakePlaces,
	NestedQuery.ErrorInPackaging,
	NestedQuery.ErrorInTheStorageArea,
	NestedQuery.ItemError,
	NestedQuery.Series,
	NestedQuery.Purpose,
	NestedQuery.Products AS Ref
FROM
	(SELECT
		GoodsInStorageBinsBalance.Products AS Products,
		GoodsInStorageBinsBalance.Products.WarehouseGroup AS WarehouseGroupOfProducts,
		GoodsInStorageBinsBalance.Characteristic AS Characteristic,
		CASE
			WHEN GoodsInStorageBinsBalance.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
				THEN CASE
						WHEN GoodsInStorageBinsBalance.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
							THEN GoodsInStorageBinsBalance.Products.UnitOfMeasure
						ELSE GoodsInStorageBinsBalance.Package
					END
			ELSE GoodsInStorageBinsBalance.Products.UnitOfMeasure
		END AS Package,
		CASE
			WHEN GoodsInStorageBinsBalance.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
				THEN ISNULL(GoodsInStorageBinsBalance.Package.WarehouseGroup,VALUE(Catalog.WarehousePackageGroups.EmptyRef))
			ELSE VALUE(Catalog.WarehousePackageGroups.EmptyRef)
		END AS WarehouseGroupOfPackages,
		GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance AS Place,
		GoodsInStorageBinsBalance.ForPickingBalance AS TakePlaces,
		CASE
			WHEN GoodsInStorageBinsBalance.Package &lt;> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
						AND NOT GoodsInStorageBinsBalance.Package.Dimensionless
						AND (GoodsInStorageBinsBalance.Package.Height = 0
							OR GoodsInStorageBinsBalance.Package.Width = 0
							OR GoodsInStorageBinsBalance.Package.Depth = 0
							OR GoodsInStorageBinsBalance.Package.VolumeM3 = 0
								AND ISNULL(GoodsInStorageBinsBalance.Products.WarehouseGroup.LimitByVolume, TRUE))
					OR GoodsInStorageBinsBalance.Package.Weight = 0
						AND ISNULL(GoodsInStorageBinsBalance.Products.WarehouseGroup.LimitByWeight, TRUE)
				THEN TRUE
			ELSE FALSE
		END AS ErrorInPackaging,
		CASE
			WHEN GoodsInStorageBinsBalance.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				THEN ISNULL(GoodsInStorageBinsBalance.Products.WarehouseGroup.LimitByWeight, TRUE)
									AND NOT GoodsInStorageBinsBalance.Products.WeightUse
						OR ISNULL(GoodsInStorageBinsBalance.Products.WarehouseGroup.LimitByVolume, TRUE)
									AND NOT GoodsInStorageBinsBalance.Products.VolumeUse
				ELSE FALSE
		END AS ItemError,
		CASE
			WHEN GoodsPlacementRules.StorageArea IS NULL 
				THEN TRUE
			ELSE FALSE
		END AS ErrorInTheStorageArea,
		GoodsInStorageBinsBalance.Series AS Series,
		GoodsInStorageBinsBalance.Purpose AS Purpose
	FROM
		AccumulationRegister.GoodsInStorageBins.Balance(, Cell = &amp;ReceivingArea) AS GoodsInStorageBinsBalance
			LEFT JOIN InformationRegister.GoodsPlacementRules AS GoodsPlacementRules
			ON GoodsInStorageBinsBalance.Products.WarehouseGroup = GoodsPlacementRules.WarehouseGroupOfProducts
				AND (CASE
					WHEN GoodsInStorageBinsBalance.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
						THEN ISNULL(GoodsInStorageBinsBalance.Package.WarehouseGroup,VALUE(Catalog.WarehousePackageGroups.EmptyRef))
					ELSE VALUE(Catalog.WarehousePackageGroups.EmptyRef)
				END = GoodsPlacementRules.WarehouseGroupOfPackages)
				AND GoodsInStorageBinsBalance.Cell.Owner = GoodsPlacementRules.Warehouse
				AND GoodsInStorageBinsBalance.Cell.Premise = GoodsPlacementRules.Premise) AS NestedQuery</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
