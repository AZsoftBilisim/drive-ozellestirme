  <attributes>
    <name>DocumentsList</name>
    <title>
      <key>en</key>
      <value>Document list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco di documenti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista dokumentów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Belge listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.FromOutside</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.OverallState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.PictureField</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.RefType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.SourceDocument</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.SourceDocumentOriginalState</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ISNULL(OriginalsStates.OverallState, UNDEFINED) AS OverallState,
	ISNULL(OriginalsStates.ChangeAuthor, &quot;&quot;) AS ChangeAuthor,
	ISNULL(OriginalsStates.LastChangeDate, DATETIME(1, 1, 1)) AS LastChangeDate,
	DocumentsRegistry.IBDocumentDate AS IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber AS IBDocumentNumber,
	DocumentsRegistry.Organization AS Organization,
	CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties) AS Counterparty,
	DocumentsRegistry.SourceDocumentDate AS SourceDocumentDate,
	DocumentsRegistry.SourceDocumentNumber AS SourceDocumentNumber,
	DocumentsRegistry.Ref AS Ref,
	CASE
		WHEN ISNULL(OriginalsStates.OverallState, TRUE)
			THEN VALUETYPE(DocumentsRegistry.Ref)
		ELSE &quot;&quot;
	END AS DocumentKind,
	DocumentsRegistry.RefType AS RefType,
	CASE
		WHEN ISNULL(OriginalsStates.OverallState, TRUE)
			THEN 0
		WHEN ISNULL(OriginalsStates.OverallState, UNDEFINED) = FALSE
		AND ISNULL(OriginalsStates.ExternalForm, FALSE) = TRUE
			THEN 2
		ELSE 1
	END AS PictureField,
	ISNULL(OriginalsStates.SourceDocument, &quot;&quot;) AS SourceDocument,
	DocumentsRegistry.Partner AS Partner,
	ISNULL(OriginalsStates.ExternalForm, FALSE) AS FromOutside,
	DocumentsRegistry.Sum AS Sum,
	DocumentsRegistry.Currency AS Currency,
	DocumentsRegistry.Counterparty.TIN AS CounterpartyTIN,
	ISNULL(OriginalsStates.State, VALUE(Catalog.SourceDocumentsOriginalsStates.EmptyRef)) AS
		SourceDocumentOriginalState,
	0 AS IndentField1,
	CASE
		WHEN ISNULL(OriginalsStates.State,
			UNDEFINED) = VALUE(Catalog.SourceDocumentsOriginalsStates.OriginalReceived)
			THEN 1
		ELSE 0
	END AS StateOriginalReceived,
	ISNULL(OriginalsStates.SourceDocumentPresentation, &quot;&quot;) AS SourceDocumentPresentation
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
		LEFT JOIN InformationRegister.SourceDocumentsOriginalsStates AS OriginalsStates
		ON DocumentsRegistry.Ref = OriginalsStates.Owner
WHERE
	DocumentsRegistry.Posted
	AND NOT DocumentsRegistry.AdditionalRecord
{WHERE
	DocumentsRegistry.IBDocumentDate >= &amp;BeginOfPeriod
	AND DocumentsRegistry.IBDocumentDate &lt;= &amp;EndOfPeriod}

UNION ALL

SELECT
	ISNULL(OriginalsStates.OverallState, UNDEFINED) AS OverallState,
	ISNULL(OriginalsStates.ChangeAuthor, &quot;&quot;) AS ChangeAuthor,
	ISNULL(OriginalsStates.LastChangeDate, DATETIME(1, 1, 1)) AS LastChangeDate,
	CounterpartyContracts.Date AS IBDocumentDate,
	CounterpartyContracts.Number AS IBDocumentNumber,
	CounterpartyContracts.Organization AS Organization,
	CounterpartyContracts.Counterparty AS Counterparty,
	CounterpartyContracts.ValidityStartDate AS SourceDocumentDate,
	NULL AS SourceDocumentNumber,
	CounterpartyContracts.Ref AS Ref,
	CASE
		WHEN ISNULL(OriginalsStates.OverallState, TRUE)
			THEN &amp;TextContractWithCounterparty + &quot;, &quot; + CounterpartyContracts.Description
		ELSE &quot;&quot;
	END AS DocumentKind,
	IDsTable.Ref AS RefType,
	CASE
		WHEN ISNULL(OriginalsStates.OverallState, TRUE)
			THEN 0
		WHEN ISNULL(OriginalsStates.OverallState, UNDEFINED) = FALSE
		AND ISNULL(OriginalsStates.ExternalForm, FALSE) = TRUE
			THEN 2
		ELSE 1
	END AS PictureField,
	ISNULL(OriginalsStates.SourceDocument, &quot;&quot;) AS SourceDocument,
	CounterpartyContracts.Partner AS Partner,
	ISNULL(OriginalsStates.ExternalForm, FALSE) AS FromOutside,
	CounterpartyContracts.Sum AS Sum,
	CounterpartyContracts.ARAPCurrency AS Currency,
	CounterpartyContracts.Counterparty.TIN AS CounterpartyTIN,
	ISNULL(OriginalsStates.State, VALUE(Catalog.SourceDocumentsOriginalsStates.EmptyRef)) AS
		SourceDocumentOriginalState,
	0 AS IndentField1,
	CASE
		WHEN ISNULL(OriginalsStates.State,
			UNDEFINED) = VALUE(Catalog.SourceDocumentsOriginalsStates.OriginalReceived)
			THEN 1
		ELSE 0
	END AS StateOriginalReceived,
	ISNULL(OriginalsStates.SourceDocumentPresentation, &quot;&quot;) AS SourceDocumentPresentation
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts
		LEFT JOIN InformationRegister.SourceDocumentsOriginalsStates AS OriginalsStates
		ON CounterpartyContracts.Ref = OriginalsStates.Owner
		INNER JOIN Catalog.MetadataObjectIDs AS IDsTable
		ON IDsTable.FullName = &amp;CounterpartyContractsCatalogName</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
