		<field xsi:type="DataSetFieldField">
			<dataPath>Enabled</dataPath>
			<field>Enabled</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Availability</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دسترس‌پذیری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Accessibilità</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Dostępność</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Доступность</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kullanılabilirlik</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Có sẵn</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	StandardTransactionsOfFinancialAccounting.Ref AS StandartOperation,
	VALUE(Catalog.FinancialAccountingChartsOfAccounts.EmptyRef) AS ChartOfAccounts,
	FALSE AS Check,
	FALSE AS Enabled
FROM
	Catalog.StandardTransactionsOfFinancialAccounting AS StandardTransactionsOfFinancialAccounting
WHERE
	NOT StandardTransactionsOfFinancialAccounting.IsFolder</query>
	</dataSet>
	<calculatedField>
		<dataPath>PictureIndex</dataPath>
		<expression>Case
When StandartOperation.IsFolder And Not StandartOperation.DeletionMark Then 0
When StandartOperation.IsFolder And StandartOperation.DeletionMark Then 1
When Not StandartOperation.DeletionMark Then 3
When StandartOperation.DeletionMark Then 4
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Picture index</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>ایندکس تصویر</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Indice dell'immagine</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Indeks obrazku</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Индекс картинки</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Resim dizini</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chỉ mục hình ảnh</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Main</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اصلی</v8:content>
			</v8:item>
			<v8:item>
