		<field xsi:type="DataSetFieldField">
			<dataPath>ChartOfAccounts</dataPath>
			<field>ChartOfAccounts</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Chart of accounts</v8:content>
				</v8:item>
				<v8:item>
