      <name>WaitingForResponseTimeConsumingOperationDecorationExtendedTooltip</name>
      <id>249</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
