  <items xsi:type="form:Decoration">
    <name>WaitingForResponseTimeConsumingOperationDecoration</name>
    <id>247</id>
    <title>
      <key>en</key>
      <value>Decoration Awaiting response long-running operation</value>
    </title>
    <title>
      <key>fa</key>
      <value>تزئین انتظار پاسخ عملیات طولانی</value>
    </title>
    <title>
      <key>it</key>
      <value>Decorazione attesa di risposta operazione lunga</value>
    </title>
    <title>
      <key>pl</key>
      <value>Dekoracja oczekiwanie na odpowiedź operacja długotrwała</value>
    </title>
    <title>
      <key>ru</key>
      <value>Декорация ожидание ответа длительная операция</value>
    </title>
    <title>
      <key>tr</key>
      <value>Cevap bekleme dekorasyonu uzun süreli işlem</value>
    </title>
    <title>
      <key>vi</key>
      <value>Trang trí đợi phản hồi, thao tác kéo dài</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
