  <attributes>
    <name>ActualDataQueryRulesByBudgetBalanceItems</name>
    <title>
      <key>en</key>
      <value>Actual data receipt rules by the budget balance items</value>
    </title>
    <title>
      <key>fa</key>
      <value>قواعد دریافت داده‌های واقعی بر اساس اقلام مانده بودجه</value>
    </title>
    <title>
      <key>it</key>
      <value>Regole di recezione del saldo iniziale in base agli indici dei bilanci</value>
    </title>
    <title>
      <key>pl</key>
      <value>Reguły otrzymania danych faktycznych wg wskaźników budżetowych</value>
    </title>
    <title>
      <key>ru</key>
      <value>Правила получения факта по показателям бюджетов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Bütçe dengesi kalemlerine göre olgu alma kuralları</value>
    </title>
    <title>
      <key>vi</key>
      <value>Quy tắc nhận dữ liệu thực tế theo chỉ tiêu ngân sách</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ActualDataQueryRulesByBudgetBalanceItems.DataSourceSection</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ActualDataQueryRulesByBudgetBalanceItems.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ActualDataQueryRulesByBudgetBalanceItems.ThisIsItemOfAssetsLiabilities</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ActualDataQueryRulesByBudgetBalanceItems.ThisIsItemOfManagementBalanceSheet</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogActualDataQueryRulesByBudgetBalanceItems.Ref,
	CatalogActualDataQueryRulesByBudgetBalanceItems.DeletionMark,
	CatalogActualDataQueryRulesByBudgetBalanceItems.Description,
	CatalogActualDataQueryRulesByBudgetBalanceItems.TotalType,
	CatalogActualDataQueryRulesByBudgetBalanceItems.SettingsComposer,
	CatalogActualDataQueryRulesByBudgetBalanceItems.FilterPresentation,
	CatalogActualDataQueryRulesByBudgetBalanceItems.DataSourceScheme,
	CatalogActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem,
	CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource,
	CatalogActualDataQueryRulesByBudgetBalanceItems.DataSourceSection,
	CatalogActualDataQueryRulesByBudgetBalanceItems.Predefined,
	CatalogActualDataQueryRulesByBudgetBalanceItems.PredefinedDataName,
	CASE
		WHEN Indicators.IndicatorType = VALUE(Enum.BudgetBalanceItemType.Estimated_)
			THEN TRUE
		ELSE FALSE
	END AS ThisIsACalculated,
	CAST(CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).DataSource AS DataSourceDataSource,
	CAST(CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource AS DataSourceNameOfBudgetDataSource,
	CAST(CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).Predefined AS DataSourceIsPredefined
FROM
	Catalog.ActualDataQueryRulesByBudgetBalanceItems AS CatalogActualDataQueryRulesByBudgetBalanceItems
		LEFT JOIN Catalog.BudgetBalanceItems AS Indicators
		ON (Indicators.Ref = CatalogActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem)
WHERE
       NOT &amp;DisabledConfigurationRulesAreHidden
       OR CatalogActualDataQueryRulesByBudgetBalanceItems.DataSourceSection &lt;> VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
       OR CAST(CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).Predefined = FALSE
       OR (&amp;SettingUpRulesForAssetLiabilityItems AND CAST(CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).DataSource &lt;> &quot;&quot;)
       OR (NOT &amp;SettingUpRulesForAssetLiabilityItems AND CAST(CatalogActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource &lt;> &quot;&quot;)</queryText>
      <mainTable>Catalog.ActualDataQueryRulesByBudgetBalanceItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
