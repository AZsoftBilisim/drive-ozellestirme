       ActualDataQueryRulesByBudgetFlowItems.FillInAnalyticsWithSpecifiedValue5, 
       ActualDataQueryRulesByBudgetFlowItems.FillInAnalyticsWithSpecifiedValue6, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionValue1, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionValue2, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionValue3, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionValue4, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionValue5, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionValue6, 
       ActualDataQueryRulesByBudgetFlowItems.CachingOfRuleResults, 
       ActualDataQueryRulesByBudgetFlowItems.ValidFrom, 
       ActualDataQueryRulesByBudgetFlowItems.ValidTo, 
       ActualDataQueryRulesByBudgetFlowItems.DisableRule, 
       ActualDataQueryRulesByBudgetFlowItems.BudgetFlowItem, 
       ActualDataQueryRulesByBudgetFlowItems.DataSource, 
       ActualDataQueryRulesByBudgetFlowItems.TransactionAmountSource, 
       ActualDataQueryRulesByBudgetFlowItems.CorDataSource, 
       ActualDataQueryRulesByBudgetFlowItems.DataSourceSection, 
       ActualDataQueryRulesByBudgetFlowItems.RuleType, 
       ActualDataQueryRulesByBudgetFlowItems.ZoomRatio, 
       ActualDataQueryRulesByBudgetFlowItems.SettingsHash, 
       ActualDataQueryRulesByBudgetFlowItems.HashOfDataCompositionSchema, 
       ActualDataQueryRulesByBudgetFlowItems.Comment, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionPopulationExpression1HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionPopulationExpression2HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionPopulationExpression3HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionPopulationExpression4HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionPopulationExpression5HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetFlowItems.DimensionPopulationExpression6HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetFlowItems.FinancialAccountingChartOfAccounts, 
       ActualDataQueryRulesByBudgetFlowItems.Predefined, 
       ActualDataQueryRulesByBudgetFlowItems.PredefinedDataName
 FROM 
       Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRulesByBudgetFlowItems
WHERE
       NOT &amp;DisabledConfigurationRulesAreHidden
       OR ActualDataQueryRulesByBudgetFlowItems.DataSourceSection &lt;> VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
       OR ActualDataQueryRulesByBudgetFlowItems.RuleType &lt;> VALUE(Enum.ActualBudgetingDataQueryRuleType.ActualData)
       OR (&amp;SettingUpRulesForAssetLiabilityItems AND ActualDataQueryRulesByBudgetFlowItems.DataSource REFS ChartOfCharacteristicTypes.AssetLiabilityItems)
       OR (NOT &amp;SettingUpRulesForAssetLiabilityItems AND ActualDataQueryRulesByBudgetFlowItems.DataSource REFS Catalog.BusinessTransactionsSettings)</queryText>
