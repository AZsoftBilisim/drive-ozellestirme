  <attributes>
    <name>BusinessTransactions</name>
    <title>
      <key>en</key>
      <value>Business transactions</value>
    </title>
    <title>
      <key>fa</key>
      <value>عملیات تجاری</value>
    </title>
    <title>
      <key>it</key>
      <value>Operazioni economiche</value>
    </title>
    <title>
      <key>pl</key>
      <value>Operacje gospodarcze</value>
    </title>
    <title>
      <key>ru</key>
      <value>Хозяйственные операции</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ticari işlemler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Giao dịch kinh tế</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BusinessTransactions.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BusinessTransactions.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BusinessTransactionsSettings.Ref AS Ref,
	BusinessTransactionsSettings.Description AS Description,
	BusinessTransactionsSettings.IsFolder AS IsFolder,
	BusinessTransactionsSettings.UseInBudgeting AS UseInBudgeting,
	MAX(CASE
			WHEN ActualDataQueryRulesByBudgetFlowItems.DataSource IS NULL
				THEN FALSE
			ELSE TRUE
		END) AS ThereAreFactReceiptRules
FROM
	Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
		LEFT JOIN Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRulesByBudgetFlowItems
		ON (ActualDataQueryRulesByBudgetFlowItems.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting))
			AND BusinessTransactionsSettings.Ref = ActualDataQueryRulesByBudgetFlowItems.DataSource

GROUP BY
	BusinessTransactionsSettings.Ref,
	BusinessTransactionsSettings.Description,
	BusinessTransactionsSettings.IsFolder,
	BusinessTransactionsSettings.UseInBudgeting</queryText>
      <mainTable>Catalog.BusinessTransactionsSettings</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>AssetLiabilityItems</name>
    <title>
      <key>en</key>
