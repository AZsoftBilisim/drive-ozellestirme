    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BudgetBalanceItems.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BudgetBalanceItems.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBudgetBalanceItems.Ref AS Ref,
	CatalogBudgetBalanceItems.DeletionMark AS DeletionMark,
	CatalogBudgetBalanceItems.Parent AS Parent,
	CatalogBudgetBalanceItems.IsFolder AS IsFolder,
	CatalogBudgetBalanceItems.Code AS Code,
	CatalogBudgetBalanceItems.Description AS Description,
	MAX(CASE
		WHEN ActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem IS NULL
			THEN FALSE
		WHEN ActualDataQueryRulesByBudgetBalanceItems.DataSourceSection &lt;> VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
			THEN TRUE
		WHEN AssetLiabilityItems.Ref IS NULL
			THEN FALSE
		WHEN NOT AssetLiabilityItems.Predefined
			THEN TRUE
		WHEN &amp;SetUpRulesForObtainingActualDataByAssetAndLiabilityItems
			THEN AssetLiabilityItems.DataSource &lt;> &quot;&quot;
		ELSE AssetLiabilityItems.NameOfBudgetDataSource &lt;> &quot;&quot;
	END) AS ThereAreFactReceiptRules
FROM
	Catalog.BudgetBalanceItems AS CatalogBudgetBalanceItems
		LEFT JOIN Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRulesByBudgetBalanceItems
		ON CatalogBudgetBalanceItems.Ref = ActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem
		LEFT JOIN ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
		ON ActualDataQueryRulesByBudgetBalanceItems.DataSource = AssetLiabilityItems.Ref

GROUP BY
	CatalogBudgetBalanceItems.Ref,
	CatalogBudgetBalanceItems.DeletionMark,
	CatalogBudgetBalanceItems.Parent,
	CatalogBudgetBalanceItems.IsFolder,
	CatalogBudgetBalanceItems.Code,
	CatalogBudgetBalanceItems.Description</queryText>
