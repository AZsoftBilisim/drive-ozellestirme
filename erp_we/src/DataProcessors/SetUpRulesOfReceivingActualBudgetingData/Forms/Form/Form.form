    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BudgetFlowItems.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BudgetFlowItems.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBudgetFlowItems.Ref AS Ref,
	CatalogBudgetFlowItems.DeletionMark AS DeletionMark,
	CatalogBudgetFlowItems.Parent AS Parent,
	CatalogBudgetFlowItems.IsFolder AS IsFolder,
	CatalogBudgetFlowItems.Code AS Code,
	CatalogBudgetFlowItems.Description AS Description,
	MAX(CASE
		WHEN ActualDataQueryRulesByBudgetFlowItems.BudgetFlowItem IS NULL
			THEN FALSE
		WHEN ActualDataQueryRulesByBudgetFlowItems.DataSourceSection &lt;> VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
			THEN TRUE
		WHEN ActualDataQueryRulesByBudgetFlowItems.RuleType &lt;> VALUE(Enum.ActualBudgetingDataQueryRuleType.ActualData)
			THEN TRUE
		WHEN &amp;SetUpRulesForObtainingActualDataByAssetAndLiabilityItems
			THEN VALUETYPE(ActualDataQueryRulesByBudgetFlowItems.DataSource) = TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
		ELSE VALUETYPE(ActualDataQueryRulesByBudgetFlowItems.DataSource) = TYPE(Catalog.BusinessTransactionsSettings)
	END) AS ThereAreFactReceiptRules
FROM
	Catalog.BudgetFlowItems AS CatalogBudgetFlowItems
		LEFT JOIN Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRulesByBudgetFlowItems
		ON CatalogBudgetFlowItems.Ref = ActualDataQueryRulesByBudgetFlowItems.BudgetFlowItem

GROUP BY
	CatalogBudgetFlowItems.Ref,
	CatalogBudgetFlowItems.DeletionMark,
	CatalogBudgetFlowItems.Parent,
	CatalogBudgetFlowItems.IsFolder,
	CatalogBudgetFlowItems.Code,
	CatalogBudgetFlowItems.Description</queryText>
