    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>AssetLiabilityItems.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>AssetLiabilityItems.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	AssetLiabilityItems.Ref AS Ref,
	AssetLiabilityItems.Description AS Description,
	AssetLiabilityItems.IsFolder AS IsFolder,
	MAX(CASE
		WHEN ActualDataQueryRulesByBudgetFlowItems.DataSource IS NULL
			AND ActualDataQueryRulesByBudgetBalanceItems.DataSource IS NULL
			THEN FALSE
		WHEN ActualDataQueryRulesByBudgetBalanceItems.DataSource IS NULL
			THEN TRUE
		WHEN NOT AssetLiabilityItems.Predefined
			THEN TRUE
		WHEN &amp;SetUpRulesForObtainingActualDataByAssetAndLiabilityItems
			THEN AssetLiabilityItems.DataSource &lt;> &quot;&quot;
		ELSE AssetLiabilityItems.NameOfBudgetDataSource &lt;> &quot;&quot;
	END) AS ThereAreFactReceiptRules
FROM
	ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
		LEFT JOIN Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRulesByBudgetFlowItems
		ON (ActualDataQueryRulesByBudgetFlowItems.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting))
			AND ActualDataQueryRulesByBudgetFlowItems.RuleType = VALUE(Enum.ActualBudgetingDataQueryRuleType.ActualData)
			AND AssetLiabilityItems.Ref = ActualDataQueryRulesByBudgetFlowItems.DataSource
			AND &amp;SetUpRulesForObtainingActualDataByAssetAndLiabilityItems
		LEFT JOIN Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRulesByBudgetBalanceItems
		ON (ActualDataQueryRulesByBudgetBalanceItems.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting))
			AND AssetLiabilityItems.Ref = ActualDataQueryRulesByBudgetBalanceItems.DataSource

GROUP BY
	AssetLiabilityItems.Ref,
	AssetLiabilityItems.Description,
	AssetLiabilityItems.IsFolder</queryText>
      <mainTable>ChartOfCharacteristicTypes.AssetLiabilityItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
