      <value>Do rejestracji (prace)</value>
    </title>
    <title>
      <key>ru</key>
      <value>К оформлению (работы)</value>
    </title>
    <title>
      <key>tr</key>
      <value>Düzenlenecek (işler)</value>
    </title>
    <title>
      <key>vi</key>
      <value>Cần lập (làm việc)</value>
    </title>
    <id>15</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.ConfigurationIsRequired</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.CostGenerationModel</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.Department</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.ItemsType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.LineOfBusiness</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.Purpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.RecordCostsByADocument</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.SpecificationRule</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterWorks.ТипИзделия</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	Works.Organization AS Organization,
	Works.Department AS Department,
	Works.Products AS Products,
	VALUE(Enum.ItemsTypes.Work_5) AS ItemsType,
	Works.Characteristic AS Characteristic,
	Works.Purpose AS Purpose,
	Works.Purpose.LineOfBusiness AS LineOfBusiness,
	CostGenerationModels.CostGenerationModel,
	ISNULL(CASE
			WHEN CostGenerationModels.FullModelName = &quot;&quot;
				THEN &amp;TextSettingsNotSet
			ELSE CostGenerationModels.FullModelName
		END, &amp;TextSettingsNotSet) AS Setting,
	CASE
		WHEN CostGenerationModels.AllocatedAccordingToRule = VALUE(Catalog.CostAllocationRules.EmptyRef)
			THEN CostGenerationModels.BillOfMaterials
		ELSE CostGenerationModels.AllocatedAccordingToRule
	END AS SpecificationRule,
	ISNULL(CostGenerationModels.ConfigurationIsRequired, TRUE) AS ConfigurationIsRequired,
	ISNULL(CostGenerationModels.RecordCostsByADocument, FALSE) AS RecordCostsByADocument,
	// We get the volume of consumption of work in the Cur period, not provided with output.
	CASE
		WHEN Works.CountOpeningBalance > 0
			THEN Works.CountExpense - Works.CountReceipt - Works.CountOpeningBalance
		ELSE Works.CountExpense - Works.CountReceipt
	END AS ToRegister
FROM
	AccumulationRegister.MaterialsAndWorksInProduction.BalanceAndTurnovers(
		{&amp;StartDate},
		{&amp;EndDate},,,
		Products IN (SELECT
							CatProducts.Ref
						FROM
							Catalog.Products AS CatProducts
						WHERE
							CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5))) AS Works
	LEFT JOIN InformationRegister.CostGenerationModels AS CostGenerationModels
		ON Works.Department = CostGenerationModels.Department
		AND Works.Products = CostGenerationModels.Products
		AND Works.Characteristic = CostGenerationModels.Characteristic
WHERE
	Works.CountClosingBalance &lt; 0
	AND NOT CASE
			WHEN Works.CountOpeningBalance > 0
				THEN Works.CountExpense - Works.CountReceipt - Works.CountOpeningBalance
			ELSE Works.CountExpense - Works.CountReceipt
		END = 0</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
