      <segments>ProductsForRegistration.Purpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductsForRegistration.RecordCostsByADocument</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ProductsForRegistration.SpecificationRule</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CompanyGoods.Organization AS Organization,
	CatWarehouses.Department AS Department,
	CatWarehouses.Ref AS Storeroom,
	DimensionKeys.Products AS Products,
	CatProducts.ItemsType,
	DimensionKeys.Characteristic AS Characteristic,
	DimensionKeys.Purpose AS Purpose,
	DimensionKeys.Purpose.LineOfBusiness AS LineOfBusiness,
	DimensionKeys.Series AS Series,
	CostGenerationModels.CostGenerationModel,
	ISNULL(CASE
			WHEN CostGenerationModels.FullModelName = &quot;&quot;
				THEN &amp;TextSettingsNotSet
			ELSE CostGenerationModels.FullModelName
		END, &amp;TextSettingsNotSet) AS Setting,
	CASE
		WHEN CostGenerationModels.AllocatedAccordingToRule = VALUE(Catalog.CostAllocationRules.EmptyRef)
			THEN CostGenerationModels.BillOfMaterials
		ELSE CostGenerationModels.AllocatedAccordingToRule
	END AS SpecificationRule,
	ISNULL(CostGenerationModels.ConfigurationIsRequired, TRUE) AS ConfigurationIsRequired,
	ISNULL(CostGenerationModels.RecordCostsByADocument, FALSE) AS RecordCostsByADocument,
	// We get the volume of products transferred in the Cur period that are not provided with output.
	CASE
		WHEN CompanyGoods.CountOpeningBalance > 0
			THEN CompanyGoods.CountExpense - CompanyGoods.CountReceipt - CompanyGoods.CountOpeningBalance
		ELSE CompanyGoods.CountExpense - CompanyGoods.CountReceipt
	END AS ToRegister
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(
		{&amp;StartDate},
		{&amp;EndDate}) AS CompanyGoods
	
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionKeys
		ON (DimensionKeys.Ref = CompanyGoods.ItemsLocationAttributes)
	LEFT JOIN Catalog.Products AS CatProducts
		ON (DimensionKeys.Products = CatProducts.Ref)
	LEFT JOIN Catalog.Warehouses AS CatWarehouses
		ON (DimensionKeys.StorageLocation = CatWarehouses.Ref)
	LEFT JOIN InformationRegister.CostGenerationModels AS CostGenerationModels
		ON (CatWarehouses.Department = CostGenerationModels.Department)
		AND (DimensionKeys.Products = CostGenerationModels.Products)
		AND (DimensionKeys.Characteristic = CostGenerationModels.Characteristic)
WHERE
	CompanyGoods.CountClosingBalance &lt; 0
	AND NOT CASE
			WHEN CompanyGoods.CountOpeningBalance > 0
				THEN CompanyGoods.CountExpense - CompanyGoods.CountReceipt - CompanyGoods.CountOpeningBalance
			ELSE CompanyGoods.CountExpense - CompanyGoods.CountReceipt
		END = 0
	AND CatWarehouses.ShopFloorStockroom
	AND ISNULL(CatWarehouses.Department.ProductionBusinessUnit, FALSE)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
