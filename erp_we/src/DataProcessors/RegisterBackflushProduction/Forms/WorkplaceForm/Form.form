  <attributes>
    <name>ToRegisterWorks</name>
    <title>
      <key>en</key>
      <value>To register (works)</value>
    </title>
    <title>
      <key>fa</key>
      <value>برای ثبت (کارها)</value>
    </title>
    <title>
