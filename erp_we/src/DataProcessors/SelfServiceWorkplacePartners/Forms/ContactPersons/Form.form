    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogContactPersonsForPartners.Ref,
	CatalogContactPersonsForPartners.DeletionMark,
	CatalogContactPersonsForPartners.Predefined,
	CatalogContactPersonsForPartners.Owner,
	CatalogContactPersonsForPartners.Description,
	CatalogContactPersonsForPartners.RelationRegistrationDate,
	CatalogContactPersonsForPartners.RelationEndDate,
	CatalogContactPersonsForPartners.Author,
	CatalogContactPersonsForPartners.Comment,
	CatalogContactPersonsForPartners.JobTitleOnBusinessCard
FROM
	Catalog.ContactPersonsForPartners AS CatalogContactPersonsForPartners
WHERE
	NOT CatalogContactPersonsForPartners.DeletionMark
	AND (CatalogContactPersonsForPartners.RelationEndDate &lt; &amp;CurrentDate
			OR CatalogContactPersonsForPartners.RelationEndDate = DATETIME(1, 1, 1))</queryText>
      <mainTable>Catalog.ContactPersonsForPartners</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
