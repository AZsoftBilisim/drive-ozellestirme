    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CatalogTermsOfSale.Ref,
	CatalogTermsOfSale.Number,
	CatalogTermsOfSale.Description,
	CatalogTermsOfSale.Currency,
	CatalogTermsOfSale.ValidityStartDate,
	CatalogTermsOfSale.ValidityEndDate,
	CatalogTermsOfSale.Standard_,
	CatalogTermsOfSale.PriceIncludesVAT,
	CatalogTermsOfSale.Warehouse,
	CatalogTermsOfSale.PaymentMethod,
	CatalogTermsOfSale.PaymentSchedule,
	CatalogTermsOfSale.Manager,
	CatalogTermsOfSale.Counterparty,
	CatalogTermsOfSale.Organization,
	&amp;Partner,
	CASE
		WHEN Warehouses.IsFolder IS NULL 
			THEN FALSE
		ELSE CASE
				WHEN Warehouses.IsFolder
					THEN TRUE
				ELSE FALSE
			END
	END AS ThisIsWarehouseGroup,
	CatalogTermsOfSale.ContractsAreUsed,
	CatalogTermsOfSale.BusinessOperation,
	CatalogTermsOfSale.ARAPObjectSettings,
	CatalogTermsOfSale.ProductSegment,
	CatalogTermsOfSale.PlanningScenario AS Scenario,
	CatalogTermsOfSale.PlanProfile,
	CatalogTermsOfSale.ReturnReusablePackage AS ToReturnReusablePackage,
	CatalogTermsOfSale.ReusablePackageReturnCycleLength AS ReusablePackageReturnCycleLength,
	CatalogTermsOfSale.PackageDepositIsRequired AS PackageDepositIsRequired,
	PlanningScenarios.Periodicity AS Periodicity,
	PlanningScenarios.CreateSalesPlanByAmount AS PlanByAmount
FROM
	Catalog.TermsOfSale AS CatalogTermsOfSale
		LEFT JOIN Catalog.PaymentSchedules AS PaymentSchedules
		ON CatalogTermsOfSale.PaymentSchedule = PaymentSchedules.Ref
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON CatalogTermsOfSale.Warehouse = Warehouses.Ref
		LEFT JOIN Catalog.SalesOperationsPlanningScenarios AS PlanningScenarios
		ON CatalogTermsOfSale.PlanningScenario = PlanningScenarios.Ref
WHERE
	CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
	AND (CatalogTermsOfSale.Partner = &amp;Partner
			OR CatalogTermsOfSale.PartnersSegment IN
				(SELECT
					SegmentPartners.Segment
				FROM
					InformationRegister.SegmentPartners AS SegmentPartners
				WHERE
					SegmentPartners.Partner = &amp;Partner)
			OR CatalogTermsOfSale.Standard_
				AND CatalogTermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef))
	AND (CatalogTermsOfSale.ValidityStartDate = DATETIME(1, 1, 1)
			OR &amp;CurrentDate >= CatalogTermsOfSale.ValidityStartDate)
	AND (CatalogTermsOfSale.ValidityEndDate = DATETIME(1, 1, 1)
			OR &amp;CurrentDate &lt;= CatalogTermsOfSale.ValidityEndDate)
	AND NOT CatalogTermsOfSale.DeletionMark
	AND CatalogTermsOfSale.AvailableToExternalUsers
	AND CASE
			WHEN &amp;OnlyStandard = TRUE
					AND &amp;OnlyPersonal = FALSE
					AND CatalogTermsOfSale.Standard_
				THEN TRUE
			WHEN &amp;OnlyPersonal = TRUE
					AND NOT &amp;OnlyStandard = TRUE
					AND NOT CatalogTermsOfSale.Standard_
				THEN TRUE
			WHEN &amp;OnlyStandard = FALSE
					AND &amp;OnlyPersonal = FALSE
				THEN TRUE
			ELSE FALSE
		END
	AND CASE
			WHEN &amp;ThePlanningDetailsAreSpecified
				THEN CatalogTermsOfSale.PlanningScenario &lt;> VALUE(Catalog.SalesOperationsPlanningScenarios.EmptyRef)
						AND CatalogTermsOfSale.PlanProfile &lt;> VALUE(Catalog.PlanProfiles.EmptyRef)
			ELSE TRUE
		END</queryText>
      <mainTable>Catalog.TermsOfSale</mainTable>
