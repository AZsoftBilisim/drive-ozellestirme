      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomerCommercialInvoice.Ref,
	CustomerCommercialInvoice.Number,
	CustomerCommercialInvoice.Date,
	CustomerCommercialInvoice.Counterparty AS Counterparty,
	CustomerCommercialInvoice.Organization,
	CustomerCommercialInvoice.DocumentAmount,
	CustomerCommercialInvoice.Currency,
	CustomerCommercialInvoice.PaymentMethod,
	CustomerCommercialInvoice.DocumentBasis AS DocumentBasis,
	CustomerCommercialInvoice.ContactPerson
FROM
	Document.CustomerCommercialInvoice AS CustomerCommercialInvoice
		LEFT JOIN Document.SalesOrder AS SalesOrder
			INNER JOIN Catalog.TermsOfSale AS AgreementsWithCustomersOrders
			ON SalesOrder.Terms = AgreementsWithCustomersOrders.Ref
		ON CustomerCommercialInvoice.DocumentBasis = SalesOrder.Ref
		LEFT JOIN Document.CustomerInvoiceServices AS CustomerInvoiceServices
			INNER JOIN Catalog.TermsOfSale AS AgreementsWithClientsActs
			ON CustomerInvoiceServices.Terms = AgreementsWithClientsActs.Ref
		ON CustomerCommercialInvoice.DocumentBasis = CustomerInvoiceServices.Ref
		LEFT JOIN Document.RequestForReturnOfGoodsFromCustomer AS RequestForReturnOfGoodsFromCustomer
			INNER JOIN Catalog.TermsOfSale AS AgreementsWithClientsApplications
			ON RequestForReturnOfGoodsFromCustomer.Terms = AgreementsWithClientsApplications.Ref
		ON CustomerCommercialInvoice.DocumentBasis = RequestForReturnOfGoodsFromCustomer.Ref
		LEFT JOIN Document.ConsignmentReportFromCustomer AS ConsignmentReportFromCustomer
			INNER JOIN Catalog.TermsOfSale AS AgreementsWithClientsReports
			ON ConsignmentReportFromCustomer.Terms = AgreementsWithClientsReports.Ref
		ON CustomerCommercialInvoice.DocumentBasis = ConsignmentReportFromCustomer.Ref
		LEFT JOIN Document.CustomerInvoice AS CustomerInvoice
			INNER JOIN Catalog.TermsOfSale AS AgreementsWithImplementationClients
			ON CustomerInvoice.Terms = AgreementsWithImplementationClients.Ref
		ON CustomerCommercialInvoice.DocumentBasis = CustomerInvoice.Ref
WHERE
	CustomerCommercialInvoice.Partner = &amp;Partner
	AND CustomerCommercialInvoice.Posted
	AND NOT CustomerCommercialInvoice.Canceled_
	AND CASE
			WHEN CustomerCommercialInvoice.DocumentBasis REFS Document.SalesOrder
				THEN AgreementsWithCustomersOrders.AvailableToExternalUsers
			WHEN CustomerCommercialInvoice.DocumentBasis REFS Document.CustomerInvoiceServices
				THEN AgreementsWithClientsActs.AvailableToExternalUsers
			WHEN CustomerCommercialInvoice.DocumentBasis REFS Document.RequestForReturnOfGoodsFromCustomer
				THEN AgreementsWithClientsApplications.AvailableToExternalUsers
			WHEN CustomerCommercialInvoice.DocumentBasis REFS Document.ConsignmentReportFromCustomer
				THEN AgreementsWithClientsReports.AvailableToExternalUsers
			WHEN CustomerCommercialInvoice.DocumentBasis REFS Document.CustomerInvoice
				THEN AgreementsWithImplementationClients.AvailableToExternalUsers
		END</queryText>
      <mainTable>Document.CustomerCommercialInvoice</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
