    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	Counterparties.Ref,
	Counterparties.Description,
	Counterparties.DescriptionFull,
	Counterparties.LegalEntityIndividual,
	Counterparties.TIN,
	Counterparties.CRTR,
	Counterparties.NCBOCode
FROM
	Catalog.Counterparties AS Counterparties
WHERE
	(NOT Counterparties.DeletionMark)
	AND Counterparties.Partner = &amp;Partner</queryText>
      <mainTable>Catalog.Counterparties</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
