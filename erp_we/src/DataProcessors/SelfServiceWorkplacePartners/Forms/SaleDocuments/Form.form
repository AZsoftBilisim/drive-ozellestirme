    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Date</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.DefaultPicture</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.DocumentAmount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Number</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomerInvoice.Ref,
	CustomerInvoice.Number,
	CustomerInvoice.Date,
	CustomerInvoice.Counterparty,
	CustomerInvoice.Organization,
	CustomerInvoice.DocumentAmount,
	CustomerInvoice.Currency,
	CustomerInvoice.Status,
	CustomerInvoice.ContactPerson,
	CustomerInvoice.BusinessOperation
FROM
	Document.CustomerInvoice AS CustomerInvoice
		INNER JOIN Catalog.TermsOfSale AS TermsOfSale
		ON CustomerInvoice.Terms = TermsOfSale.Ref
WHERE
	CustomerInvoice.Posted
	AND NOT CustomerInvoice.DeletionMark
	AND CustomerInvoice.Partner = &amp;Partner
	AND TermsOfSale.AvailableToExternalUsers</queryText>
      <mainTable>Document.CustomerInvoice</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
