    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CompanyGoods.Organization AS Organization,
	CompanyGoods.ItemsLocationAttributes.Partner AS Partner,
	CompanyGoods.ItemsLocationAttributes.Contract AS Contract,
	CompanyGoods.ItemsLocationAttributes.Counterparty AS Counterparty,
	CounterpartyContracts.ConductARAPAccountingThroughEndCustomers AS ConductARAPAccountingThroughEndCustomers,
	CounterpartyContracts.ARAPObjectSettings AS ARAPObjectSettings
		FROM
	AccumulationRegister.CompanyGoods.Balance(
			,
			ItemsLocationAttributes.StorageLocation &lt;> VALUE(Catalog.Partners.OurEnterprise)
				AND ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)) AS CompanyGoods
	LEFT JOIN
		Catalog.CounterpartyContracts AS CounterpartyContracts
		ON CompanyGoods.ItemsLocationAttributes.Contract = CounterpartyContracts.Ref
WHERE CompanyGoods.CountBalance > 0
	AND CounterpartyContracts.ConsignmentSales25
	
GROUP BY
	CompanyGoods.Organization,
	CompanyGoods.ItemsLocationAttributes.Partner,
	CompanyGoods.ItemsLocationAttributes.Contract,
	CompanyGoods.ItemsLocationAttributes.Counterparty,
	CounterpartyContracts.ConductARAPAccountingThroughEndCustomers,
	CounterpartyContracts.ARAPObjectSettings</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
