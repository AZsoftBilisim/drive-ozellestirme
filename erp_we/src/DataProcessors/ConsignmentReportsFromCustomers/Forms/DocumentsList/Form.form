  <attributes>
    <name>GoodsTransferred</name>
    <title>
      <key>en</key>
      <value>Goods transferred</value>
    </title>
    <title>
      <key>fa</key>
      <value>کالاهای منتقل‌شده</value>
    </title>
    <title>
      <key>it</key>
      <value>Merci consegnate</value>
    </title>
    <title>
      <key>pl</key>
      <value>Towary przekazane</value>
    </title>
    <title>
      <key>ru</key>
      <value>Товары переданные</value>
    </title>
    <title>
      <key>tr</key>
      <value>Transfer edilen ürünler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Hàng hóa xuất</value>
    </title>
    <id>9</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsTransferred.Consignee</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsTransferred.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsTransferred.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	GoodsTransferred.Organization,
	GoodsTransferred.ItemsLocationAttributes.StorageLocation AS Consignee,
	GoodsTransferred.Terms,
	SUM(
		CASE WHEN ISNULL(GoodsTransferredBalance.CountBalance, 0) > 0 AND GoodsTransferred.CountBalance > 0 THEN
			CASE WHEN ISNULL(GoodsTransferredBalance.CountBalance, 0) &lt; GoodsTransferred.CountBalance THEN
				ISNULL(GoodsTransferredBalance.CountBalance, 0)
			ELSE
				GoodsTransferred.CountBalance
			END
		ELSE
			0
		END
	) AS CountBalance,
	SUM(
		CASE WHEN ISNULL(GoodsTransferredBalance.CountBalance, 0) &lt; 0 AND GoodsTransferred.CountBalance &lt; 0 THEN
			CASE WHEN ISNULL(-GoodsTransferredBalance.CountBalance, 0) &lt; (-GoodsTransferred.CountBalance) THEN
				ISNULL(-GoodsTransferredBalance.CountBalance, 0)
			ELSE
				- GoodsTransferred.CountBalance
			END
		ELSE
			0
		END
	) AS TheAmountOfTheRefund_3
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.Balance(&amp;Boundary,
														ItemsLocationAttributes.StorageLocation &lt;> VALUE(Catalog.Partners.OurEnterprise)
														AND ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS GoodsTransferred
		LEFT JOIN AccumulationRegister.GoodsTransferredToCommissionAgent.Balance(,
																			ItemsLocationAttributes.StorageLocation &lt;> VALUE(Catalog.Partners.OurEnterprise)
																			AND ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS GoodsTransferredBalance
		ON GoodsTransferred.Organization = GoodsTransferredBalance.Organization
			AND GoodsTransferred.ItemsLocationAttributes = GoodsTransferredBalance.ItemsLocationAttributes
			AND GoodsTransferred.Terms = GoodsTransferredBalance.Terms
	
GROUP BY
	GoodsTransferred.Organization,
	GoodsTransferred.ItemsLocationAttributes.StorageLocation,
	GoodsTransferred.Terms</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
