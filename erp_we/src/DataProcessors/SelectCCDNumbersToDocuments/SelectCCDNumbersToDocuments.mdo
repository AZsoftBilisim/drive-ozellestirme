  <attributes uuid="5163a75a-4cc9-426a-bfe5-10fb6b0941b9">
    <name>UnitOfMeasure</name>
    <synonym>
      <key>en</key>
      <value>Unit of measure</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>واحد اندازه‌گیری</value>
