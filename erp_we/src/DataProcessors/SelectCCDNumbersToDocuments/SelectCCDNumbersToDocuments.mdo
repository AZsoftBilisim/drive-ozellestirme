    <synonym>
      <key>ru</key>
      <value>Единица измерения</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ölçü birimi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Đơn vị tính</value>
