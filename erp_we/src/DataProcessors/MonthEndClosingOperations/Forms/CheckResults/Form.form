  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BeginOfPeriod</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.CheckedPeriod</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ContextUsedToPerformCheck</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Issue1</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Object</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.SpecifyContextOfFulfillment</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThereIsARecordOfTheObjectRegister</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThisIsACompositeObject</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThisIsAnAdditionalEntry</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Validation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.VerificationDescription</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Issues.Validation,
	Issues.Organization,
	Issues.CheckedPeriod AS CheckedPeriod,
	BEGINOFPERIOD(Issues.CheckedPeriod, MONTH) AS BeginOfPeriod,
	Issues.Issue1,
	CASE WHEN Objects.Object IS NULL
		THEN FALSE
		ELSE TRUE
	END AS ThereIsARecordOfTheObjectRegister,
	Objects.Object,
	ISNULL(Objects.ThisIsACompositeObject, FALSE) AS ThisIsACompositeObject,
	CAST(
		CASE WHEN Objects.Presentation IS NULL OR (CAST(Objects.Presentation AS STRING(1024))) = &quot;&quot;
			THEN Issues.Presentation
			ELSE Objects.Presentation
		END AS STRING(1024)) AS Presentation,
	Issues.Importance.Order AS ImportanceIndex,
	&amp;ReadMoreText AS MoreDetails,
	Checks.AccountingChecksContext AS ContextUsedToPerformCheck,
	Checks.Id AS Id,
	Checks.AccountingCheckContextClarification AS SpecifyContextOfFulfillment,
	Checks.Comment AS VerificationDescription,
	CASE WHEN NOT Objects.Object IS NULL AND Objects.Object = UNDEFINED AND NOT Objects.ThisIsACompositeObject
		THEN TRUE
		ELSE FALSE
	END AS ThisIsAnAdditionalEntry
FROM
	InformationRegister.SystemStatusIssues AS Issues
	LEFT JOIN InformationRegister.ObjectsOfSystemStatusIssues AS Objects
		ON Objects.Issue1 = Issues.Issue1
			AND Objects.Validation = Issues.Validation
			AND Objects.Organization = Issues.Organization
			AND Objects.CheckedPeriod = Issues.CheckedPeriod
		LEFT JOIN Catalog.AccountingCheckRules AS Checks
		ON Issues.Validation = Checks.Ref
WHERE
	Issues.Validation = &amp;Validation
	AND Issues.Organization IN (&amp;CompanyArray)
	AND Issues.CheckedPeriod BETWEEN &amp;CheckedPeriod AND ENDOFPERIOD(&amp;CheckedPeriod, MONTH)
	AND (CAST(Issues.Presentation AS STRING(1000)) = CAST(&amp;IssueText AS STRING(1000))
		OR Issues.Presentation LIKE &amp;IssueText)
	AND (&amp;AccountingChecksContext = UNDEFINED
		OR Checks.AccountingChecksContext = &amp;AccountingChecksContext)</queryText>
      <mainTable>InformationRegister.ObjectsOfSystemStatusIssues</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
