<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:Decoration">
    <name>TimeConsumingOperationDecoration</name>
    <id>3</id>
    <title>
      <key>en</key>
      <value>Long-running operation</value>
    </title>
    <title>
      <key>fa</key>
      <value>عملیات طولانی‌مدت</value>
    </title>
    <title>
      <key>it</key>
      <value>Operazione di lunga durata</value>
    </title>
    <title>
      <key>pl</key>
      <value>Operacja długotrwała</value>
    </title>
    <title>
      <key>ru</key>
      <value>Длительная операция</value>
    </title>
    <title>
      <key>tr</key>
      <value>Uzun süreli işlem</value>
    </title>
    <title>
      <key>vi</key>
      <value>Giao dịch kéo dài</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>TimeConsumingOperationDecorationExtendedTooltip</name>
      <id>10</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>TimeConsumingOperationDecorationContextMenu</name>
      <id>4</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <width>7</width>
    <autoMaxWidth>true</autoMaxWidth>
    <height>3</height>
    <autoMaxHeight>true</autoMaxHeight>
    <horizontalStretch>false</horizontalStretch>
    <verticalStretch>false</verticalStretch>
    <extInfo xsi:type="form:PictureDecorationExtInfo">
      <picture xsi:type="core:PictureRef">
        <picture>CommonPicture.TimeConsumingOperation48</picture>
      </picture>
    </extInfo>
  </items>
  <items xsi:type="form:Decoration">
    <name>TimeConsumingOperationNoteTextDecoration</name>
    <id>1</id>
    <title>
      <key>en</key>
      <value>Please wait…</value>
    </title>
    <title>
      <key>fa</key>
      <value>لطفاً صبر کنید…</value>
    </title>
    <title>
      <key>it</key>
      <value>Attendere prego...</value>
    </title>
    <title>
      <key>pl</key>
      <value>Proszę czekać...</value>
    </title>
    <title>
      <key>ru</key>
      <value>Пожалуйста, подождите...</value>
    </title>
    <title>
      <key>tr</key>
      <value>Lütfen bekleyin...</value>
    </title>
    <title>
      <key>vi</key>
      <value>Xin vui lòng đợi...</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>TimeConsumingOperationNoteTextDecorationExtendedTooltip</name>
      <id>11</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>TimeConsumingOperationNoteTextDecorationContextMenu</name>
      <id>2</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <width>30</width>
    <autoMaxWidth>true</autoMaxWidth>
    <height>3</height>
    <autoMaxHeight>true</autoMaxHeight>
    <horizontalStretch>true</horizontalStretch>
    <verticalStretch>false</verticalStretch>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
      <verticalAlign>Center</verticalAlign>
    </extInfo>
  </items>
  <commandBarLocation>Bottom</commandBarLocation>
  <autoCommandBar>
    <name>FormCommandBar</name>
    <id>-1</id>
    <horizontalAlign>Right</horizontalAlign>
  </autoCommandBar>
  <handlers>
    <event>BeforeClose</event>
    <name>BeforeClose</name>
  </handlers>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>OnCreateAtServer</name>
  </handlers>
  <excludedCommands>Close</excludedCommands>
  <windowOpeningMode>LockOwnerWindow</windowOpeningMode>
  <saveWindowSettings>true</saveWindowSettings>
  <autoUrl>true</autoUrl>
  <autoFillCheck>true</autoFillCheck>
  <enabled>true</enabled>
  <attributes>
    <name>OperationAborted</name>
    <title>
      <key>en</key>
      <value>Operation interrupted</value>
    </title>
    <title>
      <key>fa</key>
      <value>عملیات متوقف شد</value>
    </title>
    <title>
      <key>it</key>
      <value>Operazione interrotta</value>
    </title>
    <title>
      <key>pl</key>
      <value>Przerwano operację</value>
    </title>
    <title>
      <key>ru</key>
      <value>Операция прервана</value>
    </title>
    <title>
      <key>tr</key>
      <value>İşlem durduruldu</value>
    </title>
    <title>
      <key>vi</key>
      <value>Hoạt động bị hủy bỏ</value>
    </title>
    <id>1</id>
    <valueType>
      <types>Boolean</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>AbortAllowed</name>
    <title>
      <key>en</key>
      <value>Interrupting allowed</value>
    </title>
    <title>
      <key>fa</key>
      <value>توقف مجاز است</value>
    </title>
    <title>
      <key>it</key>
      <value>Interruzione autorizzata</value>
    </title>
    <title>
      <key>pl</key>
      <value>Przerywanie jest dozwolone</value>
    </title>
    <title>
      <key>ru</key>
      <value>Прерывание разрешено</value>
    </title>
    <title>
      <key>tr</key>
      <value>Durdurulmaya izin verildi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Cho phép gián đoạn</value>
    </title>
    <id>2</id>
    <valueType>
      <types>Boolean</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
