<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:FormGroup">
    <name>GroupUse1CCustomerOrders</name>
    <id>1</id>
    <items xsi:type="form:FormField">
      <name>Use1COrdersMobileApplication</name>
      <id>3</id>
      <title>
        <key>en</key>
        <value>Allow data synchronization with 1C:Orders mobile application</value>
      </title>
      <title>
        <key>fa</key>
        <value>اجازه همگام‌سازی داده با برنامه موبایل 1C:Orders</value>
      </title>
      <title>
        <key>it</key>
        <value>Permettere la sincronizzazione dei dati con l'applicazione mobile &quot;1C:Orders&quot;</value>
      </title>
      <title>
        <key>pl</key>
        <value>Zezwolić na synchronizację danych z aplikacją mobilną &quot;1C:Orders&quot;</value>
      </title>
      <title>
        <key>ru</key>
        <value>Разрешить синхронизацию данных с мобильным приложением &quot;1С:Заказы&quot;</value>
      </title>
      <title>
        <key>tr</key>
        <value>&quot;1C:Orders&quot; mobil uygulamasıyla veri senkronizasyonuna izin ver</value>
      </title>
      <title>
        <key>vi</key>
        <value>Cho phép đồng bộ dữ liệu với ứng dụng di động &quot;1C:Đơn hàng&quot;</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>ConstantsSet.Use1COrdersMobileApplication</segments>
      </dataPath>
      <titleLocation>Right</titleLocation>
      <handlers>
        <event>OnChange</event>
        <name>Use1COrdersMobileApplicationOnChange</name>
      </handlers>
      <extendedTooltip>
        <name>Use1COrdersMobileApplicationExtendedTooltip</name>
        <id>5</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>Use1COrdersMobileApplicationContextMenu</name>
        <id>4</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>CheckBoxField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:CheckBoxFieldExtInfo"/>
    </items>
    <items xsi:type="form:Button">
      <name>OpenListOfDevicesWith1COrdersMobileApp</name>
      <id>6</id>
