Procedure OpenSettingsForPushNotificationsIn1COrdersMobileApp(Command)
	OpenForm("ExchangePlan.MobileApplicationSalesOrders.Form.MainNodeForm",, ThisObject,,,,,FormWindowOpeningMode.Independent);
