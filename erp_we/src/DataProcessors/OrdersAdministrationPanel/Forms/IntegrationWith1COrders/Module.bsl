&AtClient
Procedure OpenSettingsForSynchronizingDetailsOf1CObjectsOrders(Command)
	OpenForm("ExchangePlan.MobileApplicationSalesOrders.Form.ExchangeAttributeSetupForm",, ThisObject);
EndProcedure

