	<settingsVariant>
		<dcsset:name>ReconciliationState</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Reconciliation state</v8:content>
