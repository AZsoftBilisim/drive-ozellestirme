  <attributes>
    <name>List</name>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED DISTINCT
	DocumentsRegistry.RefType AS RefType,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Partner AS Partner,
	DocumentsRegistry.Counterparty AS KeyCounterparty,
	DocumentsRegistry.StorageLocation AS StorageLocation,
	RegistryKey.Key AS Counterparty,
	DocumentsRegistry.Department AS Department,
	DocumentsRegistry.IBDocumentDate AS IBDocumentDate,
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.RecordSeparator AS RecordSeparator,
	DocumentsRegistry.IBDocumentNumber AS IBDocumentNumber,
	DocumentsRegistry.Status AS Status,
	DocumentsRegistry.EmployeeResponsible AS EmployeeResponsible,
	DocumentsRegistry.Author AS Author,
	DocumentsRegistry.AdditionalRecord AS AdditionalRecord,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.SourceDocumentDate AS SourceDocumentDate,
	DocumentsRegistry.SourceDocumentNumber AS SourceDocumentNumber,
	DocumentsRegistry.SourceDocumentName AS SourceDocumentName,
	DocumentsRegistry.Sum AS Sum,
	DocumentsRegistry.Currency AS Currency,
	DocumentsRegistry.Contract AS Contract,
	DocumentsRegistry.LineOfBusiness AS LineOfBusiness,
	DocumentsRegistry.RecordingInAccountingDate AS RecordingInAccountingDate,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	DocumentsRegistry.CorrectedDocument AS CorrectedDocument,
	DocumentsRegistry.ReversedDocument AS ReversedDocument,
	CASE
		WHEN DocumentsRegistry.DeletionMark
			THEN 3
		WHEN NOT DocumentsRegistry.Posted
			THEN 0
		ELSE 1
	END AS RowPicture,
	DocumentsRegistry.Priority AS Priority,
	DocumentsRegistry.RecordID AS RecordID,
	EDStatesOverridable.EDIState AS StateOfEdVersion,
	EDStatesOverridable.StatusPresentation AS StatusPresentation
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
	INNER JOIN Catalog.DocumentRegistryKeys AS RegistryKey
	ON DocumentsRegistry.Counterparty = RegistryKey.Ref
	
	LEFT JOIN AccumulationRegister.CustomersARAPAccounting AS CustomersARAPAccounting
	ON DocumentsRegistry.Ref = CustomersARAPAccounting.Recorder
	
	LEFT JOIN AccumulationRegister.VendorsARAPAccounting AS VendorsARAPAccounting
	ON DocumentsRegistry.Ref = VendorsARAPAccounting.Recorder
	
	LEFT JOIN AccumulationRegister.FinancialInstrumentsARAP AS FinancialInstrumentsARAP
	ON DocumentsRegistry.Ref = FinancialInstrumentsARAP.Recorder
		
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON DocumentsRegistry.Ref = EDStatesOverridable.ObjectReference}
	WHERE
		(CustomersARAPAccounting.Recorder IS NOT NULL
			OR VendorsARAPAccounting.Recorder IS NOT NULL
			OR FinancialInstrumentsARAP.Recorder IS NOT NULL)</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
