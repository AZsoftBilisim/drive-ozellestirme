        <key>pl</key>
        <value>Status wskazania serii nadawca</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Статус указания серий отправитель</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Parti belirtme durumu gönderici</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Trạng thái chỉ ra sê-ri nơi gửi</value>
      </synonym>
