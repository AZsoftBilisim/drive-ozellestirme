		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	CatalogPartners.Ref AS Partner,
	PollPurpose.Ref AS Survey,
	PollPurpose.FreeSurvey AS FreeSurvey,
	PollPurpose.RespondentsType AS RespondentsType
INTO PartnerSurveys
FROM
	Catalog.Partners AS CatalogPartners,
	Document.PollPurpose AS PollPurpose
{WHERE
	PollPurpose.Ref.* AS SurveyPurpose}
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Partners.Ref AS Partner,
	Partners.BusinessRegion,
	Partners.Client,
	Partners.Vendor,
	Partners.Competitor,
	Partners.OtherRelations,
	Partners.ServedBySalesRepresentatives,
	Partners.Carrier,
	Partners.LegalEntityIndividual,
	Partners.Gender,
	Partners.BirthDate
FROM
	Catalog.Partners AS Partners
		{LEFT JOIN PartnerSurveys AS PartnerSurveys
		ON (PartnerSurveys.Partner = Partners.Ref)
		LEFT JOIN Document.PollPurpose.Respondents AS PollPurposeRespondents
		ON (CASE
				WHEN PartnerSurveys.RespondentsType = VALUE(Catalog.ContactPersonsForPartners.EmptyRef)
					THEN PollPurposeRespondents.Respondent.Owner
				ELSE PollPurposeRespondents.Respondent
			END = PartnerSurveys.Partner)
			AND (PollPurposeRespondents.Ref = PartnerSurveys.Survey)}
		{LEFT JOIN InformationRegister.SegmentPartners AS SegmentPartners
		ON (SegmentPartners.Partner = Partners.Ref)}
WHERE
(NOT PartnerSurveys.FreeSurvey
				AND PollPurposeRespondents.Respondent IS NOT NULL 
			OR PartnerSurveys.FreeSurvey)
{WHERE 
	Partners.Ref.*,
	Partners.BusinessRegion.*,
	Partners.Client,
	Partners.Vendor,
	Partners.Competitor,
	Partners.OtherRelations,
	Partners.ServedBySalesRepresentatives,
	Partners.Carrier,
	Partners.LegalEntityIndividual,
	Partners.Gender,
	Partners.BirthDate,
	SegmentPartners.Segment AS CustomerSegment}</query>
	</dataSet>
