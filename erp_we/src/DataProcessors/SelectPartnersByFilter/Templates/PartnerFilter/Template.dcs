		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Partners.Ref AS Partner,
	Partners.BusinessRegion,
	Partners.Client,
	Partners.Vendor,
	Partners.Competitor,
	Partners.OtherRelations,
	Partners.ServedBySalesRepresentatives,
	Partners.Carrier,
	Partners.LegalEntityIndividual,
	Partners.Gender,
	Partners.BirthDate
FROM
	Catalog.Partners AS Partners
		{LEFT JOIN InformationRegister.SegmentPartners AS SegmentPartners
		ON (SegmentPartners.Partner = Partners.Ref)}
{WHERE
	Partners.Ref.*,
	Partners.BusinessRegion.*,
	Partners.Client,
	Partners.Vendor,
	Partners.Competitor,
	Partners.OtherRelations,
	Partners.ServedBySalesRepresentatives,
	Partners.Carrier,
	Partners.LegalEntityIndividual,
	Partners.Gender,
	Partners.BirthDate,
	SegmentPartners.Segment AS CustomerSegment}</query>
	</dataSet>
