    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDetailed.ShowDocumentTime</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	FixedAssetsDocuments.FixedAsset,
	FixedAssetsDocuments.Ref,
	FixedAssetsDocuments.Organization,
	FixedAssetsDocuments.Date AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	FixedAssetsDocuments.BusinessOperation,
	FixedAssetsDocuments.Department,
	DocumentsRegistry.EmployeeResponsible,
	DocumentsRegistry.More,
	DocumentsRegistry.Comment,
	FixedAssetsDocuments.Posted,
	DocumentsRegistry.DeletionMark,
	CASE
		WHEN FixedAssetsDocuments.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	FixedAssetsDocuments.AdditionalRecord,
	DocumentsRegistry.AdditionalRecord AS AdditionalEntryRegistry,
	ISNULL(FixedAssetsDocuments.RecordInManAccounting, FALSE) AS RecordInManAccounting,
	ISNULL(FixedAssetsDocuments.RecordInLocalAccounting, FALSE) AS RecordInLocalAccounting,
	FixedAssetsDocuments.RefType,
	VALUETYPE(FixedAssetsDocuments.Ref) AS TheTypeOfReferenceDocument,
	CASE
		WHEN FixedAssetsDocuments.RecordInManAccounting
				AND DocumentsRegistry.Posted
			THEN 1
		WHEN FixedAssetsDocuments.RecordInManAccounting
				AND NOT DocumentsRegistry.Posted
			THEN 2
		ELSE 0
	END AS ToReflectInTheAccountPicture,
	CASE
		WHEN FixedAssetsDocuments.RecordInLocalAccounting
				AND FixedAssetsDocuments.Posted
			THEN 1
		WHEN FixedAssetsDocuments.RecordInLocalAccounting
				AND NOT FixedAssetsDocuments.Posted
			THEN 2
		ELSE 0
	END AS ReflectTheImageInTheReglAccount,
	CASE
		WHEN FixedAssetsDocuments.RecordInTA
				AND FixedAssetsDocuments.Posted
			THEN 1
		WHEN FixedAssetsDocuments.RecordInTA
				AND NOT FixedAssetsDocuments.Posted
			THEN 2
		ELSE 0
	END AS ReflectImageInside,
	CASE
		WHEN FixedAssetsDocuments.Date &lt; &amp;AccountingStartDate
				AND (FixedAssetsDocuments.Ref REFS Document.EntryOfCapitalAssetsBalance2_4
					OR FixedAssetsDocuments.Ref REFS Document.ChangeFixedAssetFinancialDetails2_4)
			THEN 1
		ELSE 0
	END AS CreatedToUpgradeToVersion24,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles,
	&amp;ShowDocumentTime AS ShowDocumentTime,
	FixedAssetsDocuments.FixedAssetsEvent,
	FixedAssetsDocuments.CorrectionPeriodStart AS CorrectionPeriodStart,
	FixedAssetsDocuments.CorrectionPeriodEnd AS CorrectionPeriodEnd
	
FROM
	InformationRegister.FixedAssetsDocuments AS FixedAssetsDocuments
	
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON (DocumentsRegistry.Ref = FixedAssetsDocuments.Ref)
			AND (NOT DocumentsRegistry.AdditionalRecord)
			
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON FixedAssetsDocuments.Ref = FilesExist.ObjectWithFiles
WHERE
	FixedAssetsDocuments.FixedAsset REFS Catalog.Assets
	
{WHERE
	FixedAssetsDocuments.FixedAsset.* AS FixedAsset,
	FixedAssetsDocuments.Ref.* AS Ref,
	FixedAssetsDocuments.Organization.* AS Organization,
	FixedAssetsDocuments.Date AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	FixedAssetsDocuments.BusinessOperation AS BusinessOperation,
	FixedAssetsDocuments.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	FixedAssetsDocuments.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	(FixedAssetsDocuments.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod)
}</queryText>
      <mainTable>InformationRegister.FixedAssetsDocuments</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
