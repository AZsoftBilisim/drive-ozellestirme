				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Price</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قیمت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Prezzo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Cena</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Цена</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Fiyat</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đơn giá</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CurrencyRatesCut.Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor, 1) * CASE
		WHEN &amp;Currency &lt;&gt; ItemPricesCrossSectionOfTheLatest.Currency
			THEN CASE
					WHEN ISNULL(ExchangeRatePrices.CourseDenominator, 0) &gt; 0
							AND ISNULL(ExchangeRatePrices.CourseNumerator, 0) &gt; 0
							AND ISNULL(CurrencyExchangeRate.CourseDenominator, 0) &gt; 0
							AND ISNULL(CurrencyExchangeRate.CourseNumerator, 0) &gt; 0
						THEN ExchangeRatePrices.CourseNumerator * CurrencyExchangeRate.CourseDenominator / (CurrencyExchangeRate.CourseNumerator * ExchangeRatePrices.CourseDenominator)
					ELSE 0
				END
		ELSE 1
	END AS Price
FROM
	InformationRegister.ItemsPrices.SliceLast(, {(PriceKind) AS PriceKind } {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        &amp;FilterByProductSegmentIsUsed = TRUE))}) AS ItemPricesCrossSectionOfTheLatest
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCRevenue
		ON (ABCRevenue.ClassificationSection = &amp;ClassificationSection)
			AND (ABCRevenue.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (ABCRevenue.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCGrossProfit
		ON (ABCGrossProfit.ClassificationSection = &amp;ClassificationSection)
			AND (ABCGrossProfit.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (ABCGrossProfit.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCCount
		ON (ABCCount.ClassificationSection = &amp;ClassificationSection)
			AND (ABCCount.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (ABCCount.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZRevenue
		ON (XYZRevenue.ClassificationSection = &amp;ClassificationSection)
			AND (XYZRevenue.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (XYZRevenue.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZGrossProfit
		ON (XYZGrossProfit.ClassificationSection = &amp;ClassificationSection)
			AND (XYZGrossProfit.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (XYZGrossProfit.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZCount
		ON (XYZCount.ClassificationSection = &amp;ClassificationSection)
			AND (XYZCount.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (XYZCount.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)}
		LEFT JOIN ExchangeRates AS ExchangeRatePrices
		ON ItemPricesCrossSectionOfTheLatest.Currency = ExchangeRatePrices.Currency
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON (CurrencyExchangeRate.Currency = &amp;Currency)
{WHERE
	(CAST(ISNULL(ABCRevenue.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCRevenue,
	(CAST(ISNULL(ABCGrossProfit.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCGrossProfit,
	(CAST(ISNULL(ABCCount.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCCount,
	(CAST(ISNULL(XYZRevenue.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZRevenue,
	(CAST(ISNULL(XYZGrossProfit.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZGrossProfit,
	(CAST(ISNULL(XYZCount.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZCount}</query>
	</dataSet>
