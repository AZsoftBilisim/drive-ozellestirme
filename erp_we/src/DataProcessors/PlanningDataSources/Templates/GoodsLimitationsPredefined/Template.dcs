			<dataPath>ClassificationType</dataPath>
			<field>ClassificationType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanningObject</dataPath>
			<field>PlanningObject</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ClassificationParameterType</dataPath>
			<field>ClassificationParameterType</field>
		</field>
		<field xsi:type="DataSetFieldFolder">
			<dataPath>ProductRange</dataPath>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Product range</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>سبد محصولات</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Assortimento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Asortyment</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ассортимент</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Ürün gamı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Danh điểm hàng hóa</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TableFormats.Warehouse          AS Warehouse,
	TableFormats.StoreFormat AS StoreFormat
INTO TTWarehouseFormats
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(,
	{Warehouse.* AS Warehouse}) AS TableFormats
WHERE
	TableFormats.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
INDEX BY
	Warehouse
;

SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;OffsetPeriodStart AS Period,
	ProductRestrictions.Warehouse AS Warehouse,
	ProductRestrictions.Products AS Products,
	ProductRestrictions.Characteristic AS Characteristic,
	ProductRestrictions.Products.ProductCategory AS ProductCategory,
	CASE &amp;TypeOfStock
		WHEN "SafetyStockQuantity"
			THEN ProductRestrictions.SafetyStockQuantity
		WHEN "MinimumInventoryQuantity"
			THEN ProductRestrictions.MinimumInventoryQuantity
		WHEN "MaximumInventoryAmount"
			THEN ProductRestrictions.MaximumInventoryAmount
		WHEN "ConsumptionRate"
			THEN ProductRestrictions.ConsumptionRate
		ELSE ProductRestrictions.SafetyStockQuantity
	END AS Count
FROM
	InformationRegister.ProductRestrictions AS ProductRestrictions
		{LEFT JOIN SelectionByProductSegment AS SelectionByProductSegment
		ON ProductRestrictions.Products = SelectionByProductSegment.Products
			AND ProductRestrictions.Characteristic = SelectionByProductSegment.Characteristic}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCRevenue
		ON (ABCRevenue.ClassificationSection = ProductRestrictions.Warehouse)
			AND (ABCRevenue.Products = ProductRestrictions.Products)
			AND (ABCRevenue.Characteristic = ProductRestrictions.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCGrossProfit
		ON (ABCGrossProfit.ClassificationSection = ProductRestrictions.Warehouse)
			AND (ABCGrossProfit.Products = ProductRestrictions.Products)
			AND (ABCGrossProfit.Characteristic = ProductRestrictions.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCCount
		ON (ABCCount.ClassificationSection = ProductRestrictions.Warehouse)
			AND (ABCCount.Products = ProductRestrictions.Products)
			AND (ABCCount.Characteristic = ProductRestrictions.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZRevenue
		ON (XYZRevenue.ClassificationSection = ProductRestrictions.Warehouse)
			AND (XYZRevenue.Products = ProductRestrictions.Products)
			AND (XYZRevenue.Characteristic = ProductRestrictions.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZGrossProfit
		ON (XYZGrossProfit.ClassificationSection = ProductRestrictions.Warehouse)
			AND (XYZGrossProfit.Products = ProductRestrictions.Products)
			AND (XYZGrossProfit.Characteristic = ProductRestrictions.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZCount
		ON (XYZCount.ClassificationSection = ProductRestrictions.Warehouse)
			AND (XYZCount.Products = ProductRestrictions.Products)
			AND (XYZCount.Characteristic = ProductRestrictions.Characteristic)}
		{LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast({(&amp;ProductRangeAsOfDate)}, {(Warehouse) AS Warehouse}) AS HistoryOfChangesToStoreFormatsCrossSection
		ON ProductRestrictions.Warehouse = HistoryOfChangesToStoreFormatsCrossSection.Warehouse
		LEFT JOIN InformationRegister.ProductRange.SliceLast({(&amp;ProductRangeAsOfDate)}, ) AS ProductRangeSliceLast
		ON (ISNULL(ProductRestrictions.Products, VALUE(Catalog.Products.EmptyRef)) = ProductRangeSliceLast.Products)
			AND (ISNULL(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = ProductRangeSliceLast.PlanningObject
				OR ProductRestrictions.Warehouse = ProductRangeSliceLast.PlanningObject)}
		
		{LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON &amp;ProductRestrictionsSubstitutionOfMainMethodOfProvision}
		
{WHERE
	(SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
	(CAST(ISNULL(ABCRevenue.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCRevenue,
	(CAST(ISNULL(ABCGrossProfit.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCGrossProfit,
	(CAST(ISNULL(ABCCount.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCCount,
	(CAST(ISNULL(XYZRevenue.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZRevenue,
	(CAST(ISNULL(XYZGrossProfit.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZGrossProfit,
	(CAST(ISNULL(XYZCount.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZCount,
	ProductRangeSliceLast.ProductRangeRole,
	ProductRangeSliceLast.PurchasesAreAllowed,
	ProductRangeSliceLast.SalesAreAllowed,
	ProductRangeSliceLast.PriceKind.*,
	ProductRangeSliceLast.ItemsCollection.* AS AssortmentCollectionOfProducts,
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat.* AS AssortmentStoreFormat,
	HistoryOfChangesToStoreFormatsCrossSection.ControlProductRange,
	CatMethod.Ref.* AS MainDemandFulfillmentMethod}</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
