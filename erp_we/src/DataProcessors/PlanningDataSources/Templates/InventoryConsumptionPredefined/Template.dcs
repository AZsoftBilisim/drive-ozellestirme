			<field>ControlledLotReference</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// !!! TAGS ARE USED !!!

SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(GoodsInWarehousesTurnover.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(GoodsInWarehousesTurnover.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(GoodsInWarehousesTurnover.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(GoodsInWarehousesTurnover.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(GoodsInWarehousesTurnover.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(GoodsInWarehousesTurnover.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(GoodsInWarehousesTurnover.DayPeriod, DAY, -&amp;PeriodOffset)
	END AS Period,
	CASE
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
			THEN ISNULL(CAST(GoodsInWarehousesTurnover.Recorder AS Document.InventoryConsumption).Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
			THEN ISNULL(CAST(CAST(GoodsInWarehousesTurnover.Recorder AS Document.GoodsIssueNote).Recipient AS Catalog.BusinessStructure), VALUE(Catalog.BusinessStructure.EmptyRef))


		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END AS InternalConsumptionDepartment,
	GoodsInWarehousesTurnover.Warehouse AS Warehouse,
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Characteristic AS Characteristic,
	GoodsInWarehousesTurnover.Products.ProductCategory AS ProductCategory,
	-SUM(GoodsInWarehousesTurnover.InStockTurnover) AS Count,
	GoodsInWarehousesTurnover.Purpose AS Purpose
FROM//MaterialsAndWorksInProduction
	AccumulationRegister.ProductStock.Turnovers(, , Auto, {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        &amp;FilterByProductSegmentIsUsed = TRUE))}) AS GoodsInWarehousesTurnover
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCRevenue
		ON (ABCRevenue.ClassificationSection = GoodsInWarehousesTurnover.Warehouse)
			AND (ABCRevenue.Products = GoodsInWarehousesTurnover.Products)
			AND (ABCRevenue.Characteristic = GoodsInWarehousesTurnover.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCGrossProfit
		ON (ABCGrossProfit.ClassificationSection = GoodsInWarehousesTurnover.Warehouse)
			AND (ABCGrossProfit.Products = GoodsInWarehousesTurnover.Products)
			AND (ABCGrossProfit.Characteristic = GoodsInWarehousesTurnover.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCCount
		ON (ABCCount.ClassificationSection = GoodsInWarehousesTurnover.Warehouse)
			AND (ABCCount.Products = GoodsInWarehousesTurnover.Products)
			AND (ABCCount.Characteristic = GoodsInWarehousesTurnover.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZRevenue
		ON (XYZRevenue.ClassificationSection = GoodsInWarehousesTurnover.Warehouse)
			AND (XYZRevenue.Products = GoodsInWarehousesTurnover.Products)
			AND (XYZRevenue.Characteristic = GoodsInWarehousesTurnover.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.GrossProfit)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZGrossProfit
		ON (XYZGrossProfit.ClassificationSection = GoodsInWarehousesTurnover.Warehouse)
			AND (XYZGrossProfit.Products = GoodsInWarehousesTurnover.Products)
			AND (XYZGrossProfit.Characteristic = GoodsInWarehousesTurnover.Characteristic)}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Count)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZCount
		ON (XYZCount.ClassificationSection = GoodsInWarehousesTurnover.Warehouse)
			AND (XYZCount.Products = GoodsInWarehousesTurnover.Products)
			AND (XYZCount.Characteristic = GoodsInWarehousesTurnover.Characteristic)}
WHERE
	GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
	OR GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
	AND CAST(GoodsInWarehousesTurnover.Recorder AS Document.GoodsIssueNote).WarehouseOperation = VALUE(Enum.WarehouseTransactions.ShipmentForInternalNeeds)


{WHERE
	(CAST(ISNULL(ABCRevenue.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCRevenue,
	(CAST(ISNULL(ABCGrossProfit.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCGrossProfit,
	(CAST(ISNULL(ABCCount.Class, VALUE(Enum.ABCClassification.NotClassified)) AS Enum.ABCClassification)) AS ABCCount,
	(CAST(ISNULL(XYZRevenue.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZRevenue,
	(CAST(ISNULL(XYZGrossProfit.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZGrossProfit,
	(CAST(ISNULL(XYZCount.Class, VALUE(Enum.XYZClassification.NotClassified)) AS Enum.XYZClassification)) AS XYZCount}

GROUP BY
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(GoodsInWarehousesTurnover.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(GoodsInWarehousesTurnover.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(GoodsInWarehousesTurnover.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(GoodsInWarehousesTurnover.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(GoodsInWarehousesTurnover.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(GoodsInWarehousesTurnover.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(GoodsInWarehousesTurnover.DayPeriod, DAY, -&amp;PeriodOffset)
	END,
	CASE
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
			THEN ISNULL(CAST(GoodsInWarehousesTurnover.Recorder AS Document.InventoryConsumption).Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
			THEN ISNULL(CAST(CAST(GoodsInWarehousesTurnover.Recorder AS Document.GoodsIssueNote).Recipient AS Catalog.BusinessStructure), VALUE(Catalog.BusinessStructure.EmptyRef))


		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END,
	GoodsInWarehousesTurnover.Warehouse,
	GoodsInWarehousesTurnover.Products,
	GoodsInWarehousesTurnover.Characteristic,
	GoodsInWarehousesTurnover.Purpose,
	GoodsInWarehousesTurnover.Products.ProductCategory
	
UNION ALL

SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(MaterialsAndWorksInProductionTurnovers.DayPeriod, DAY, -&amp;PeriodOffset)
	END AS Period,
	ISNULL(MaterialsAndWorksInProductionTurnovers.Department, VALUE(Catalog.BusinessStructure.EmptyRef)) AS InternalConsumptionDepartment,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	MaterialsAndWorksInProductionTurnovers.Products AS Products,
	MaterialsAndWorksInProductionTurnovers.Characteristic AS Characteristic,
	MaterialsAndWorksInProductionTurnovers.Products.ProductCategory AS ProductCategory,
	-SUM(MaterialsAndWorksInProductionTurnovers.CountTurnover) AS Count,
	MaterialsAndWorksInProductionTurnovers.Purpose AS Purpose
FROM
	AccumulationRegister.MaterialsAndWorksInProduction.Turnovers(, , Auto, {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        &amp;FilterByProductSegmentIsUsed = TRUE))}) AS MaterialsAndWorksInProductionTurnovers
WHERE
	MaterialsAndWorksInProductionTurnovers.Recorder REFS Document.InventoryConsumption


	AND MaterialsAndWorksInProductionTurnovers.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
GROUP BY
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(MaterialsAndWorksInProductionTurnovers.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(MaterialsAndWorksInProductionTurnovers.DayPeriod, DAY, -&amp;PeriodOffset)
	END,
	ISNULL(MaterialsAndWorksInProductionTurnovers.Department, VALUE(Catalog.BusinessStructure.EmptyRef)),
	MaterialsAndWorksInProductionTurnovers.Products,
	MaterialsAndWorksInProductionTurnovers.Characteristic,
	MaterialsAndWorksInProductionTurnovers.Purpose,
	MaterialsAndWorksInProductionTurnovers.Products.ProductCategory</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(IsNull(Count, 0))</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End Else &amp;BeginOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End Else &amp;EndOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
