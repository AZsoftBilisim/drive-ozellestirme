		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TableFormats.Warehouse          AS Warehouse,
	TableFormats.StoreFormat AS StoreFormat
INTO TTWarehouseFormats
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(,
	{Warehouse.* AS Warehouse}) AS TableFormats
WHERE
	TableFormats.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
INDEX BY
	Warehouse
;

SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(AssemblyPlansDisassemblyRevolutions.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(AssemblyPlansDisassemblyRevolutions.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(AssemblyPlansDisassemblyRevolutions.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(AssemblyPlansDisassemblyRevolutions.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(AssemblyPlansDisassemblyRevolutions.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(AssemblyPlansDisassemblyRevolutions.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(AssemblyPlansDisassemblyRevolutions.DayPeriod, DAY, -&amp;PeriodOffset)
	END AS Period,
	CAST(AssemblyPlansDisassemblyRevolutions.Warehouse AS Catalog.Warehouses) AS Warehouse,
	AssemblyPlansDisassemblyRevolutions.Products AS Products,
	AssemblyPlansDisassemblyRevolutions.Characteristic AS Characteristic,
	AssemblyPlansDisassemblyRevolutions.Products.ProductCategory AS ProductCategory,
	AssemblyPlansDisassemblyRevolutions.ProductKit AS ProductKit,
	AssemblyPlansDisassemblyRevolutions.CountTurnover AS Count,
	AssemblyPlansDisassemblyRevolutions.Purpose AS Purpose
FROM
	AccumulationRegister.AssemblyDisassemblyPlans.Turnovers(, , Auto, BusinessOperation = &amp;BusinessOperation {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS AssemblyPlansDisassemblyRevolutions
		{LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast({(&amp;ProductRangeAsOfDate)}, {(Warehouse) AS Warehouse}) AS HistoryOfChangesToStoreFormatsCrossSection
		ON AssemblyPlansDisassemblyRevolutions.Warehouse = HistoryOfChangesToStoreFormatsCrossSection.Warehouse
		LEFT JOIN InformationRegister.ProductRange.SliceLast({(&amp;ProductRangeAsOfDate)}, ) AS ProductRangeSliceLast
		ON (ISNULL(AssemblyPlansDisassemblyRevolutions.Products, VALUE(Catalog.Products.EmptyRef)) = ProductRangeSliceLast.Products)
			AND (ISNULL(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = ProductRangeSliceLast.PlanningObject
				OR AssemblyPlansDisassemblyRevolutions.Warehouse = ProductRangeSliceLast.PlanningObject)}
		
		{LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON &amp;AssemblyPlansDisassemblyKitsSubstitutionOfMainMethodOfProvision}
		
{WHERE
	ProductRangeSliceLast.ProductRangeRole,
	ProductRangeSliceLast.PurchasesAreAllowed,
	ProductRangeSliceLast.SalesAreAllowed,
	ProductRangeSliceLast.PriceKind.*,
	ProductRangeSliceLast.ItemsCollection.* AS AssortmentCollectionOfProducts,
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat.* AS AssortmentStoreFormat,
	HistoryOfChangesToStoreFormatsCrossSection.ControlProductRange,
	CatMethod.Ref.* AS MainDemandFulfillmentMethod}</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End Else &amp;BeginOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End Else &amp;EndOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
