		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TableFormats.Warehouse          AS Warehouse,
	TableFormats.StoreFormat AS StoreFormat
INTO TTWarehouseFormats
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(,
	{Warehouse.* AS Warehouse}) AS TableFormats
WHERE
	TableFormats.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
INDEX BY
	Warehouse
;

SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(SalesPlansByCategoryTurnover_.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(SalesPlansByCategoryTurnover_.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(SalesPlansByCategoryTurnover_.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(SalesPlansByCategoryTurnover_.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(SalesPlansByCategoryTurnover_.DayPeriod, DAY, -&amp;PeriodOffset)
	END AS Period,
	SalesPlansByCategoryTurnover_.ProductCategory,
	SalesPlansByCategoryTurnover_.SalesRank,
	SalesPlansByCategoryTurnover_.Warehouse AS Warehouse,
	CatProducts.Ref AS Products,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END AS Characteristic,
	SUM(SalesPlansByCategoryTurnover_.CountTurnover) AS Count,
	SalesPlansByCategoryTurnover_.Purpose AS Purpose
FROM
	AccumulationRegister.SalesPlansByCategories.Turnovers(, , Auto, StoreFormat = VALUE(Catalog.StoreFormats.EmptyRef) {(Warehouse) AS Warehouse}) AS SalesPlansByCategoryTurnover_
		{INNER JOIN Catalog.Products AS CatProducts
			LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
			ON (CASE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
							AND CatProducts.Ref = ItemsCharacteristics.Owner
						THEN TRUE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
							AND CatProducts.ProductKind = ItemsCharacteristics.Owner
						THEN TRUE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
							AND CatProducts.ItemVariantsOwner = ItemsCharacteristics.Owner
						THEN TRUE
					ELSE FALSE
				END)
		ON SalesPlansByCategoryTurnover_.ProductCategory = CatProducts.ProductCategory
		 AND SalesPlansByCategoryTurnover_.SalesRank = CatProducts.SalesRank}
		{LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast({(&amp;ProductRangeAsOfDate)}, {(Warehouse) AS Warehouse}) AS HistoryOfChangesToStoreFormatsCrossSection
		ON SalesPlansByCategoryTurnover_.Warehouse = HistoryOfChangesToStoreFormatsCrossSection.Warehouse
		LEFT JOIN InformationRegister.ProductRange.SliceLast({(&amp;ProductRangeAsOfDate)}, ) AS ProductRangeSliceLast
		ON (ISNULL(CatProducts.Ref, VALUE(Catalog.Products.EmptyRef)) = ProductRangeSliceLast.Products)
			AND (ISNULL(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = ProductRangeSliceLast.PlanningObject
				OR SalesPlansByCategoryTurnover_.Warehouse = ProductRangeSliceLast.PlanningObject)}
		
		{LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON &amp;SalesForecastsByCategoriesSubstituteTheMainFulfillmentMethodSalesForecast}
		
{WHERE
	ProductRangeSliceLast.ProductRangeRole,
	ProductRangeSliceLast.PurchasesAreAllowed,
	ProductRangeSliceLast.SalesAreAllowed,
	ProductRangeSliceLast.PriceKind.*,
	ProductRangeSliceLast.ItemsCollection.* AS AssortmentCollectionOfProducts,
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat.* AS AssortmentStoreFormat,
	HistoryOfChangesToStoreFormatsCrossSection.ControlProductRange,
	CatMethod.Ref.* AS MainDemandFulfillmentMethod}

GROUP BY
	SalesPlansByCategoryTurnover_.Warehouse,
	SalesPlansByCategoryTurnover_.ProductCategory,
	SalesPlansByCategoryTurnover_.SalesRank,
	CatProducts.Ref,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(SalesPlansByCategoryTurnover_.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(SalesPlansByCategoryTurnover_.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(SalesPlansByCategoryTurnover_.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(SalesPlansByCategoryTurnover_.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(SalesPlansByCategoryTurnover_.DayPeriod, DAY, -&amp;PeriodOffset)
	END,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END,
	SalesPlansByCategoryTurnover_.Purpose

UNION ALL

SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(SalesPlansByCategoryTurnover_.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(SalesPlansByCategoryTurnover_.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(SalesPlansByCategoryTurnover_.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(SalesPlansByCategoryTurnover_.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(SalesPlansByCategoryTurnover_.DayPeriod, DAY, -&amp;PeriodOffset)
	END,
	SalesPlansByCategoryTurnover_.ProductCategory,
	SalesPlansByCategoryTurnover_.SalesRank,
	ISNULL(HistoryOfChangesToStoreFormatsCrossSection.Warehouse, VALUE(Catalog.Warehouses.EmptyRef)),
	CatProducts.Ref,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END,
	SUM(SalesPlansByCategoryTurnover_.CountTurnover),
	SalesPlansByCategoryTurnover_.Purpose
FROM
	AccumulationRegister.SalesPlansByCategories.Turnovers(
			,
			,
			Auto,
			StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
				AND Warehouse = VALUE(Catalog.Warehouses.EmptyRef) {(StoreFormat) AS StoreFormat, (Warehouse) AS PlanWarehouse}) AS SalesPlansByCategoryTurnover_
		{INNER JOIN Catalog.Products AS CatProducts
			LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
			ON (CASE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
							AND CatProducts.Ref = ItemsCharacteristics.Owner
						THEN TRUE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
							AND CatProducts.ProductKind = ItemsCharacteristics.Owner
						THEN TRUE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
							AND CatProducts.ItemVariantsOwner = ItemsCharacteristics.Owner
						THEN TRUE
					ELSE FALSE
				END)
		ON SalesPlansByCategoryTurnover_.ProductCategory = CatProducts.ProductCategory
		 AND SalesPlansByCategoryTurnover_.SalesRank = CatProducts.SalesRank}
		{LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast({(&amp;ProductRangeAsOfDate)}, {(Warehouse) AS Warehouse}) AS HistoryOfChangesToStoreFormatsCrossSection
		ON SalesPlansByCategoryTurnover_.StoreFormat = HistoryOfChangesToStoreFormatsCrossSection.StoreFormat}
		{LEFT JOIN InformationRegister.ProductRange.SliceLast({(&amp;ProductRangeAsOfDate)}, ) AS ProductRangeSliceLast
		ON (ISNULL(CatProducts.Ref, VALUE(Catalog.Products.EmptyRef)) = ProductRangeSliceLast.Products)
			AND SalesPlansByCategoryTurnover_.StoreFormat = ProductRangeSliceLast.PlanningObject}
		
		{LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON &amp;SalesForecastsByCategoriesSubstituteTheMainFulfillmentMethodFormats}
		
{WHERE
	ProductRangeSliceLast.ProductRangeRole,
	ProductRangeSliceLast.PurchasesAreAllowed,
	ProductRangeSliceLast.SalesAreAllowed,
	ProductRangeSliceLast.PriceKind.*,
	ProductRangeSliceLast.ItemsCollection.* AS AssortmentCollectionOfProducts,
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat.* AS AssortmentStoreFormat,
	HistoryOfChangesToStoreFormatsCrossSection.ControlProductRange,
	CatMethod.Ref.* AS MainDemandFulfillmentMethod}

GROUP BY
	SalesPlansByCategoryTurnover_.ProductCategory,
	SalesPlansByCategoryTurnover_.SalesRank,
	CatProducts.Ref,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(SalesPlansByCategoryTurnover_.WeekPeriod, WEEK, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(SalesPlansByCategoryTurnover_.TenDaysPeriod, TENDAYS, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(SalesPlansByCategoryTurnover_.MonthPeriod, MONTH, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(SalesPlansByCategoryTurnover_.QuarterPeriod, QUARTER, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.HalfYearPeriod, HALFYEAR, -&amp;PeriodOffset)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(SalesPlansByCategoryTurnover_.YearPeriod, YEAR, -&amp;PeriodOffset)
		ELSE DATEADD(SalesPlansByCategoryTurnover_.DayPeriod, DAY, -&amp;PeriodOffset)
	END,
	ISNULL(HistoryOfChangesToStoreFormatsCrossSection.Warehouse, VALUE(Catalog.Warehouses.EmptyRef)),
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END,
	SalesPlansByCategoryTurnover_.Purpose</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When &amp;Periodicity = Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End Else &amp;BeginOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;PeriodOffsetIsUsed Then Case When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End Else &amp;EndOfPeriod End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>Periodicity</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
