  <attributes>
    <name>ListOfContractsForReceiptOfServices</name>
    <title>
      <key>en</key>
      <value>List of service receipt contracts</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست قراردادهای دریافت خدمات</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список договоров поступления услуг</value>
    </title>
    <title>
      <key>tr</key>
      <value>Hizmet teslim alım sözleşmeleri listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách hợp đồng tiếp nhận dịch vụ</value>
    </title>
    <title>
      <key>it</key>
      <value>List of service receipt contracts</value>
    </title>
    <title>
      <key>pl</key>
      <value>List of service receipt contracts</value>
    </title>
    <id>8</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsForReceiptOfServices.PurchaseOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CounterpartyContracts.Ref AS Ref,
	CounterpartyContracts.Organization AS Organization,
	CounterpartyContracts.Counterparty AS Counterparty,
	CounterpartyContracts.Partner AS Partner,
	CounterpartyContracts.Department AS Department
INTO TTContractsOfCounterparties
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts
WHERE
	NOT CounterpartyContracts.DeletionMark
	AND (CounterpartyContracts.ContractType = VALUE(Enum.ContractTypes.WithVendor)
	OR CounterpartyContracts.ContractType = VALUE(Enum.ContractTypes.PurchaseEAEU))
	AND CounterpartyContracts.BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromSupplier),
		VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit),
		VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt),
		VALUE(Enum.BusinessTransactions.ImportFromEAEU),
		VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit),
		VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery))
	AND CounterpartyContracts.MonthlyReceiptOfServices
	AND CounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)

INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CounterpartyContracts.Organization AS Organization,
	CounterpartyContracts.Counterparty AS Counterparty,
	CounterpartyContracts.Partner AS Partner,
	CounterpartyContracts.Ref AS Contract,
	CounterpartyContracts.Department AS Department,
	PurchaseOrder.Date AS Date,
	PurchaseOrder.Number AS Number,
	PurchaseOrder.Currency AS Currency,
	MAX(PurchaseOrder.DocumentAmount) AS DocumentAmount,
	PurchaseOrder.Ref AS PurchaseOrder
FROM
	TTContractsOfCounterparties AS CounterpartyContracts
		LEFT JOIN Document.ReceiptOfServicesToBusinessUnit AS ReceiptOfServicesToBusinessUnit
		ON ReceiptOfServicesToBusinessUnit.Contract = CounterpartyContracts.Ref
		AND ReceiptOfServicesToBusinessUnit.Posted
		AND ReceiptOfServicesToBusinessUnit.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
		AND ReceiptOfServicesToBusinessUnit.BusinessOperation IN
		(VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery),
			VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery))
		LEFT JOIN Document.PurchaseOrder AS PurchaseOrder
			INNER JOIN Document.PurchaseOrder.Goods AS PurchaseOrderGoods
			ON PurchaseOrder.Ref = PurchaseOrderGoods.Ref
			AND PurchaseOrderGoods.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OperationService),
				VALUE(Enum.ItemsTypes.Work_5))
		ON CounterpartyContracts.Ref = PurchaseOrder.Contract
		AND PurchaseOrder.Posted
		AND CASE
			WHEN &amp;UsePurchaseOrderStatuses
				THEN PurchaseOrder.Status = VALUE(Enum.PurchaseOrderStatuses.Confirmed_)
			ELSE TRUE
		END
		AND PurchaseOrder.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
		AND PurchaseOrder.BusinessOperation IN
		(VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt),
			VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery))
WHERE
	ReceiptOfServicesToBusinessUnit.Ref IS NULL
{WHERE
	CounterpartyContracts.Ref.* AS Contract,
	CounterpartyContracts.Department.* AS Department,
	CounterpartyContracts.Organization.*,
	CounterpartyContracts.Counterparty.*,
	CounterpartyContracts.Partner.*}
GROUP BY
	PurchaseOrder.Ref,
	CounterpartyContracts.Ref,
	CounterpartyContracts.Organization,
	CounterpartyContracts.Counterparty,
	CounterpartyContracts.Partner,
	CounterpartyContracts.Department,
	PurchaseOrder.Date,
	PurchaseOrder.Number,
	PurchaseOrder.Currency</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
