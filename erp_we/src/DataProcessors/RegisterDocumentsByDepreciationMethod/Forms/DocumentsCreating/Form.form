  <attributes>
    <name>ListOfDocumentsToBeCancelled</name>
    <title>
      <key>en</key>
      <value>List of documents to reverse</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد برای برگشت</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документов к сторнированию</value>
    </title>
    <title>
      <key>tr</key>
      <value>İptal edilecek belgeler listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ cần đảo ngược</value>
    </title>
    <title>
      <key>it</key>
      <value>List of documents to reverse</value>
    </title>
    <title>
      <key>pl</key>
      <value>List of documents to reverse</value>
    </title>
    <id>9</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDocumentsToBeCancelled.Inpayment</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDocumentsToBeCancelled.Purchase</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDocumentsToBeCancelled.PurchaseOrderToPurchasePurchaseSupplier</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDocumentsToBeCancelled.ReversingEntry</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDocumentsToBeCancelled.State</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DocumentCorrectionsSliceLast.CorrectedDocument AS CorrectedDocument
INTO TTCorrectionsOfDocuments
FROM
	InformationRegister.DocumentCorrections.SliceLast(&amp;EndOfPeriod, CorrectedDocument
		REFS Document.ReceiptOfServicesToBusinessUnit
	AND NOT DocumentToCorrectIsReversed) AS DocumentCorrectionsSliceLast
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ReceiptOfServicesToBusinessUnit.Ref AS Ref,
	ReceiptOfServicesToBusinessUnit.Organization AS Organization,
	ReceiptOfServicesToBusinessUnit.Counterparty AS Counterparty,
	ReceiptOfServicesToBusinessUnit.Contract AS Contract,
	ReceiptOfServicesToBusinessUnit.ReferenceOrder AS ReferenceOrder,
	ReceiptOfServicesToBusinessUnit.Department AS Department,
	ReceiptOfServicesToBusinessUnit.Author AS EmployeeResponsible,
	ReceiptOfServicesToBusinessUnit.DocumentAmount AS DocumentAmount,
	ReceiptOfServicesToBusinessUnit.Currency AS Currency,
	ReceiptOfServicesToBusinessUnit.Date AS Date,
	ReceiptOfServicesToBusinessUnit.Number AS Number,
	ReceiptOfServicesToBusinessUnit.PointInTime AS PointInTime,
	ISNULL(ReversingEntry.Ref, VALUE(Document.ReversingEntry.EmptyRef)) AS ReversingEntry,
	ReversingEntry.Number AS StornoNumber,
	ReversingEntry.Date AS StornoDate,
	ReversingEntry.ReplacementDocument AS StornoReplacementDocument
INTO TTListOfReceipts
FROM
	Document.ReceiptOfServicesToBusinessUnit AS ReceiptOfServicesToBusinessUnit
		LEFT JOIN TTCorrectionsOfDocuments AS TTCorrectionsOfDocuments
		ON ReceiptOfServicesToBusinessUnit.Ref = TTCorrectionsOfDocuments.CorrectedDocument
		LEFT JOIN Document.ReversingEntry AS ReversingEntry
		ON ReceiptOfServicesToBusinessUnit.Ref = ReversingEntry.ReversedDocument
		AND ReversingEntry.Posted
		AND ReversingEntry.Date >= &amp;BeginOfPeriod
		INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON ReceiptOfServicesToBusinessUnit.Contract = CounterpartyContracts.Ref
WHERE
	ReceiptOfServicesToBusinessUnit.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND ReceiptOfServicesToBusinessUnit.Posted
	AND
		(ReceiptOfServicesToBusinessUnit.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)
	OR
		ReceiptOfServicesToBusinessUnit.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery))
	AND
		CounterpartyContracts.OptionForRegisteringServiceReceiptDocuments = VALUE(Enum.OptionsForRegisteringServiceDocuments.ReceiptOfServicesIsReversed)
	AND TTCorrectionsOfDocuments.CorrectedDocument IS NULL

INDEX BY SETS
(
	(Contract,
	ReferenceOrder),
	(ReversingEntry)
)
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	TTListOfReceipts.Contract AS Contract
INTO TTRevenueContracts
FROM
	TTListOfReceipts AS TTListOfReceipts

INDEX BY
	Contract
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PurchaseOfGoodsServicesGoods.Ref AS Ref,
	VendorInvoice.Contract AS Contract,
	VendorInvoice.PurchaseOrder AS PurchaseOrder,
	VendorInvoice.Number AS Number,
	VendorInvoice.Date AS Date,
	VendorInvoice.Currency AS Currency,
	MAX(VendorInvoice.DocumentAmount) AS DocumentAmount,
	VendorInvoice.PointInTime AS PointInTime
INTO TTPurchasesOfGoodsAndServices
FROM
	Document.VendorInvoice.Goods AS PurchaseOfGoodsServicesGoods
		INNER JOIN Document.VendorInvoice AS VendorInvoice
			INNER JOIN TTRevenueContracts AS TTRevenueContracts
			ON VendorInvoice.Contract = TTRevenueContracts.Contract
		ON PurchaseOfGoodsServicesGoods.Ref = VendorInvoice.Ref
WHERE
	VendorInvoice.Posted
	AND VendorInvoice.Date BETWEEN &amp;BeginningOfVocationalSchoolPeriod AND &amp;EndOfVocationalTrainingPeriod
	AND VendorInvoice.BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromSupplier),
		VALUE(Enum.BusinessTransactions.ImportFromEAEU))
	AND PurchaseOfGoodsServicesGoods.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OperationService),
		VALUE(Enum.ItemsTypes.Work_5))
GROUP BY
	PurchaseOfGoodsServicesGoods.Ref,
	VendorInvoice.Contract,
	VendorInvoice.PurchaseOrder,
	VendorInvoice.Number,
	VendorInvoice.Date,
	VendorInvoice.Currency,
	VendorInvoice.PointInTime

INDEX BY
	Contract,
	PurchaseOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTListOfReceipts.Ref AS Inpayment,
	TTListOfReceipts.Contract AS Contract,
	TTListOfReceipts.ReferenceOrder AS ReferenceOrder,
	COUNT(DISTINCT TTPurchasesOfGoodsAndServices.Ref) AS NumberOfAcquisitions
INTO TTNumberOfAcquisitions
FROM
	TTListOfReceipts AS TTListOfReceipts
		LEFT JOIN TTPurchasesOfGoodsAndServices AS TTPurchasesOfGoodsAndServices
		ON TTListOfReceipts.Contract = TTPurchasesOfGoodsAndServices.Contract
		AND TTListOfReceipts.ReferenceOrder = TTPurchasesOfGoodsAndServices.PurchaseOrder
WHERE
	TTListOfReceipts.PointInTime &lt; TTPurchasesOfGoodsAndServices.PointInTime
	AND TTListOfReceipts.ReferenceOrder REFS Document.PurchaseOrder
	AND TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
GROUP BY
	TTListOfReceipts.ReferenceOrder,
	TTListOfReceipts.Ref,
	TTListOfReceipts.Contract
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTListOfReceipts.Organization AS Organization,
	TTListOfReceipts.Counterparty AS Counterparty,
	TTListOfReceipts.Contract AS Contract,
	TTListOfReceipts.Ref AS Inpayment,
	TTListOfReceipts.DocumentAmount AS OrderReceiptAmount,
	TTPurchasesOfGoodsAndServices.Ref AS Purchase,
	ISNULL(TTPurchasesOfGoodsAndServices.DocumentAmount, 0) AS Purchase_Amount,
	TTListOfReceipts.ReversingEntry AS ReversingEntry,
	TTListOfReceipts.Department AS Department,
	TTListOfReceipts.EmployeeResponsible AS EmployeeResponsible,
	CASE
		WHEN TTPurchasesOfGoodsAndServices.Ref IS NULL
		AND TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
			THEN 1
		WHEN TTPurchasesOfGoodsAndServices.Ref IS NOT NULL
		AND TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
			THEN 2
		WHEN TTPurchasesOfGoodsAndServices.Ref IS NOT NULL
		AND NOT TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
			THEN 3
	END AS State,
	TTListOfReceipts.Currency AS CurrencyOfReceipt,
	TTPurchasesOfGoodsAndServices.Currency AS PurchaseCurrency,
	TTListOfReceipts.Date AS DateOfReceipt,
	TTListOfReceipts.Number AS NumberOfReceipt,
	TTPurchasesOfGoodsAndServices.Number AS PurchaseNumber,
	TTPurchasesOfGoodsAndServices.Date AS PurchaseDate,
	TTListOfReceipts.StornoNumber AS NumberStorno,
	TTListOfReceipts.StornoDate AS ReversingEntryDate,
	CASE
		WHEN
			CounterpartyContracts.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
			THEN TTListOfReceipts.ReferenceOrder
		ELSE VALUE(Document.PurchaseOrder.EmptyRef)
	END AS PurchaseOrderToPurchasePurchaseSupplier
FROM
	TTListOfReceipts AS TTListOfReceipts
		LEFT JOIN TTNumberOfAcquisitions AS TTNumberOfAcquisitions
		ON TTListOfReceipts.Ref = TTNumberOfAcquisitions.Inpayment
		LEFT JOIN TTPurchasesOfGoodsAndServices AS TTPurchasesOfGoodsAndServices
		ON ISNULL(TTNumberOfAcquisitions.NumberOfAcquisitions, 0) = 1
		AND TTListOfReceipts.Contract = TTPurchasesOfGoodsAndServices.Contract
		AND TTListOfReceipts.ReferenceOrder = TTPurchasesOfGoodsAndServices.PurchaseOrder
		AND TTListOfReceipts.PointInTime &lt; TTPurchasesOfGoodsAndServices.PointInTime
		INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON TTListOfReceipts.Contract = CounterpartyContracts.Ref
WHERE
	TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)

UNION ALL

SELECT
	TTListOfReceipts.Organization,
	TTListOfReceipts.Counterparty,
	TTListOfReceipts.Contract,
	TTListOfReceipts.Ref,
	TTListOfReceipts.DocumentAmount,
	TTPurchasesOfGoodsAndServices.Ref,
	ISNULL(TTPurchasesOfGoodsAndServices.DocumentAmount, 0),
	TTListOfReceipts.ReversingEntry,
	TTListOfReceipts.Department,
	TTListOfReceipts.EmployeeResponsible,
	CASE
		WHEN TTPurchasesOfGoodsAndServices.Ref IS NULL
		AND TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
			THEN 1
		WHEN TTPurchasesOfGoodsAndServices.Ref IS NOT NULL
		AND TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
			THEN 2
		WHEN TTPurchasesOfGoodsAndServices.Ref IS NOT NULL
		AND NOT TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)
			THEN 3
	END,
	TTListOfReceipts.Currency,
	TTPurchasesOfGoodsAndServices.Currency,
	TTListOfReceipts.Date,
	TTListOfReceipts.Number,
	TTPurchasesOfGoodsAndServices.Number,
	TTPurchasesOfGoodsAndServices.Date,
	TTListOfReceipts.StornoNumber,
	TTListOfReceipts.StornoDate,
	VALUE(Document.PurchaseOrder.EmptyRef)
FROM
	TTListOfReceipts AS TTListOfReceipts
		LEFT JOIN TTPurchasesOfGoodsAndServices AS TTPurchasesOfGoodsAndServices
		ON TTListOfReceipts.StornoReplacementDocument = TTPurchasesOfGoodsAndServices.Ref
		AND TTListOfReceipts.PointInTime &lt; TTPurchasesOfGoodsAndServices.PointInTime
WHERE
	NOT TTListOfReceipts.ReversingEntry = VALUE(Document.ReversingEntry.EmptyRef)</queryText>
