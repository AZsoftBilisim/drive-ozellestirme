    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	0 AS PictureIndex,
	CatalogProducts.DeletionMark AS DeletionMark,
	CatalogProducts.Ref AS Ref,
	CatalogProducts.Ref AS Products,
	CatalogProducts.SKU,
	CatalogProducts.Code,
	CatalogProducts.Description AS Description,
	CatalogProducts.ProductKind AS ProductKind,
	CatalogProducts.ItemsType AS ItemsType,
	CatalogProducts.UseVariants AS UseVariants,
	CatalogProducts.IsFolder AS IsFolder,
	CatalogProducts.Parent AS Parent,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	0 AS Price,
	0 AS MaximumFeaturePrice,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	CatalogProducts.UnitOfMeasure,
	0 AS InStockBalance,
	0 AS Available,
	FALSE AS ItemVariantsAreUsed,
	FALSE AS ThisIsAProduct,
	FALSE AS IsService,
	UNDEFINED AS ItemVariantsOwner,
	CatalogProducts.Quality AS Quality
FROM
	Catalog.Products AS CatalogProducts</queryText>
      <mainTable>Catalog.Products</mainTable>
