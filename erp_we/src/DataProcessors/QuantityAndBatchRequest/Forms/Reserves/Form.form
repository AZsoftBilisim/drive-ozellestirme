    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE WHEN InventoryAllocation.DemandCharacteristic = VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse) THEN
				VALUE(Enum.SupplyOptions.FromWarehouse)
			WHEN InventoryAllocation.DemandCharacteristic = VALUE(Enum.DemandCharacteristics.ReserveAsReceived) THEN
				VALUE(Enum.SupplyOptions.ReserveAsReceived)
		END AS Action,
	InventoryAllocation.ShipmentOrder AS OrderDocument,
	InventoryAllocation.RequestShipmentOn AS DateOfShipment,
	InventoryAllocation.Count / &amp;PackagingFactor AS Count,
	Register3.Priority AS Priority
FROM
	InformationRegister.InventoryAllocation AS InventoryAllocation
		
		LEFT JOIN InformationRegister.DocumentsRegistry AS Register3
		ON Register3.Ref = InventoryAllocation.ShipmentOrder
			AND NOT Register3.AdditionalRecord
WHERE
	InventoryAllocation.Products = &amp;Products
		AND InventoryAllocation.Characteristic = &amp;Characteristic
		AND InventoryAllocation.Warehouse = &amp;Warehouse
		AND InventoryAllocation.Purpose = &amp;Purpose
		AND (InventoryAllocation.ReceiptOrder = UNDEFINED
				AND &amp;ControlledLotReference = VALUE(Catalog.ControlledLots.EmptyRef)
			OR InventoryAllocation.ReceiptOrder = &amp;ControlledLotReference)
		AND NOT InventoryAllocation.ShipmentOrder IN(&amp;ShippingOrders)
		AND InventoryAllocation.DemandCharacteristic IN(
			VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
			VALUE(Enum.DemandCharacteristics.ReserveAsReceived))
		AND InventoryAllocation.InventoryState IN(
			VALUE(Enum.InventoryStates.InStock),
			VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
			VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking))</queryText>
      <mainTable>InformationRegister.InventoryAllocation</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
