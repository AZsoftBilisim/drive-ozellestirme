      <segments>ToRegisterForAPeriod.TransferForActivity_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegisterForAPeriod.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	FinalBalances.ItemsLocationAttributes AS ItemsLocationAttributes,
	FinalBalances.SellerInventoryOwnerAttribute         AS SellerInventoryOwnerAttribute,
	FinalBalances.CCDNumber                   AS CCDNumber,
	FinalBalances.CountBalance          AS CountBalance,
	FinalBalances.ReturnedBalance          AS ReturnedBalance,
	FinalBalances.CompanyOwner        AS CompanyOwner
INTO FinalBalances
FROM
	AccumulationRegister.CompanyGoodsForTransfer.Balance() AS FinalBalances
WHERE
	FinalBalances.CountBalance > 0
	OR FinalBalances.ReturnedBalance > 0
INDEX BY
	ItemsLocationAttributes,
	SellerInventoryOwnerAttribute,
	CCDNumber
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ForThePeriod.MonthPeriod                           AS MonthPeriod,
	ForThePeriod.SellerInventoryOwnerAttribute.VATTaxation AS TransferForActivity_,
	ForThePeriod.CompanyOwner                   AS CompanyOwner,
	ForThePeriod.ItemsLocationAttributes            AS ItemsLocationAttributes,
	ForThePeriod.SellerInventoryOwnerAttribute                    AS SellerInventoryOwnerAttribute,
	ForThePeriod.CCDNumber                              AS CCDNumber,
	ForThePeriod.CountTurnover                      AS CountTurnover,
	ForThePeriod.ReturnedTurnover                      AS ReturnedTurnover
INTO ForThePeriod
FROM
	AccumulationRegister.CompanyGoodsForTransfer.BalanceAndTurnovers(&amp;InitialBorder, &amp;ConBorder, Auto) AS ForThePeriod
WHERE
	ForThePeriod.CountTurnover > 0
	OR ForThePeriod.ReturnedTurnover &lt;> 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ForThePeriod.MonthPeriod                           AS Month,
	CASE
		WHEN InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN VALUE(Enum.BusinessTransactions.TransferOfGoodsToCommissionAgentInAnotherCompany)
		ELSE VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	END                                          AS BusinessOperation,
	ForThePeriod.SellerInventoryOwnerAttribute.VATTaxation AS TransferForActivity_,
	CatWarehouses.Ref                               AS Warehouse,
	ForThePeriod.CompanyOwner                   AS Sender,
	InventoryOwnerAttribute.Organization                         AS Recipient,
	InventoryOwnerAttribute.InventoryType                          AS InventoryType,
	DefaultValues.Contract                    AS Contract,
	DefaultValues.PriceKind                    AS PriceKind,
	DefaultValues.Currency                     AS ARAPCurrency
FROM
	ForThePeriod AS ForThePeriod
		INNER JOIN FinalBalances AS FinalBalances
		ON ForThePeriod.CompanyOwner = FinalBalances.CompanyOwner
			AND ForThePeriod.ItemsLocationAttributes = FinalBalances.ItemsLocationAttributes
			AND ForThePeriod.SellerInventoryOwnerAttribute = FinalBalances.SellerInventoryOwnerAttribute
			AND ForThePeriod.CCDNumber = FinalBalances.CCDNumber
	
		INNER JOIN Catalog.InventoryKinds AS InventoryOwnerAttribute
		ON ForThePeriod.SellerInventoryOwnerAttribute = InventoryOwnerAttribute.Ref
	
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
		ON Dimension.Ref = ForThePeriod.ItemsLocationAttributes
	
		INNER JOIN Catalog.Warehouses AS CatWarehouses
		ON Dimension.StorageLocation = CatWarehouses.Ref
	
		INNER JOIN InformationRegister.CustomizeCustomerInvoiceIntercompany AS DefaultValues
		ON ForThePeriod.CompanyOwner = DefaultValues.CompanyOwner
			AND InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = DefaultValues.InventoryType
			AND InventoryOwnerAttribute.Organization = DefaultValues.CompanyCustomer
	
WHERE
	(&amp;Recipient IN (VALUE(Catalog.Companies.EmptyRef), InventoryOwnerAttribute.Organization)
		OR &amp;Sender IN (VALUE(Catalog.Companies.EmptyRef), ForThePeriod.CompanyOwner))
	AND ForThePeriod.CountTurnover &lt;> 0
	
UNION ALL
	
SELECT DISTINCT
	ForThePeriod.MonthPeriod                           AS Month,
	CASE
		WHEN InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN VALUE(Enum.BusinessTransactions.IntercompanyCommissionReturn)
		ELSE VALUE(Enum.BusinessTransactions.IntercompanyGoodsReturn)
	END                                          AS BusinessOperation,
	ForThePeriod.SellerInventoryOwnerAttribute.VATTaxation AS TransferForActivity_,
	CatWarehouses.Ref                               AS Warehouse,
	InventoryOwnerAttribute.Organization                         AS Sender,
	ForThePeriod.CompanyOwner                   AS Recipient,
	InventoryOwnerAttribute.InventoryType                          AS InventoryType,
	DefaultValues.Contract                    AS Contract,
	DefaultValues.PriceKind                    AS PriceKind,
	DefaultValues.Currency                     AS ARAPCurrency
FROM
	ForThePeriod AS ForThePeriod
		INNER JOIN FinalBalances AS FinalBalances
		ON ForThePeriod.CompanyOwner = FinalBalances.CompanyOwner
			AND ForThePeriod.ItemsLocationAttributes = FinalBalances.ItemsLocationAttributes
			AND ForThePeriod.SellerInventoryOwnerAttribute = FinalBalances.SellerInventoryOwnerAttribute
			AND ForThePeriod.CCDNumber = FinalBalances.CCDNumber
	
		INNER JOIN Catalog.InventoryKinds AS InventoryOwnerAttribute
		ON ForThePeriod.SellerInventoryOwnerAttribute = InventoryOwnerAttribute.Ref
	
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
		ON Dimension.Ref = ForThePeriod.ItemsLocationAttributes
	
		INNER JOIN Catalog.Warehouses AS CatWarehouses
		ON Dimension.StorageLocation = CatWarehouses.Ref
	
		INNER JOIN InformationRegister.CustomizeCustomerInvoiceIntercompany AS DefaultValues
		ON ForThePeriod.CompanyOwner = DefaultValues.CompanyOwner
			AND InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = DefaultValues.InventoryType
			AND InventoryOwnerAttribute.Organization = DefaultValues.CompanyCustomer
	
WHERE
	(&amp;Sender IN (VALUE(Catalog.Companies.EmptyRef), InventoryOwnerAttribute.Organization)
		OR &amp;Recipient IN (VALUE(Catalog.Companies.EmptyRef), ForThePeriod.CompanyOwner))
	AND ForThePeriod.ReturnedTurnover &lt;> 0
</queryText>
