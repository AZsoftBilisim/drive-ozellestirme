      <value>Scan according to the scheme</value>
    </title>
    <title>
      <key>fa</key>
      <value>اسکن طبق طرح</value>
    </title>
    <title>
      <key>it</key>
      <value>Scansione secondo schema</value>
    </title>
    <title>
      <key>pl</key>
      <value>Skanuj wg schematu</value>
    </title>
    <title>
      <key>ru</key>
      <value>Сканировать по схеме</value>
    </title>
    <title>
      <key>tr</key>
      <value>Şemaya göre tarama</value>
    </title>
    <title>
      <key>vi</key>
      <value>Quét theo mẫu</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
