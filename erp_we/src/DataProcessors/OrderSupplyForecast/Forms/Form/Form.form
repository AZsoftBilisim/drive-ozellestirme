    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	VALUE(Enum.InventoryAllocationStates.EmptyRef) AS State,
	OrderStateOverridable.Products AS Products,
	OrderStateOverridable.Characteristic AS Characteristic,
	OrderStateOverridable.Warehouse AS Warehouse,
	OrderStateOverridable.Purpose AS Purpose,
	OrderStateOverridable.DemandCharacteristic AS DemandCharacteristic,
	OrderStateOverridable.InventoryState AS InventoryState,
	OrderStateOverridable.RequestShipmentOn AS RequestShipmentOn,
	OrderStateOverridable.ReceiptOrder AS ReceiptOrder,
	0 AS Count,
	CASE
		WHEN TRUE
			THEN CAST(&quot;&quot; AS STRING(20))
		ELSE OrderStateOverridable.ShipmentOrder
	END AS ShipmentOrder,
	VALUE(Catalog.Partners.EmptyRef) AS Client,
	VALUE(Catalog.Users.EmptyRef) AS Manager,
	FALSE AS ControlQualityOfReceivedGoods,
	OrderStateOverridable.Products.ItemsType AS ItemsType,
	OrderStateOverridable.Products.UnitOfMeasure AS UnitOfMeasure,
	FALSE AS WithAssignment,
	VALUE(Enum.SupplyOptions.EmptyRef) AS Action,
	DATETIME(1, 1, 1) AS DateOfReceipt,
	DATETIME(1, 1, 1) AS QualityControl,
	CAST(&quot;&quot; AS STRING(150)) AS TheWayToEnsureProductName,
	VALUE(Catalog.ProcurementStrategies.EmptyRef) AS SupplyMethod,
	TRUE AS TheShipmentDateIsExecutable,
	FALSE AS YouCanShipFromAvailableBalance,
	FALSE AS CanBeShippedFromAvailability
{SELECT
	State.* AS State,
	Products.* AS Products,
	Characteristic.* AS Characteristic,
	Warehouse.* AS Warehouse,
	Purpose.* AS Purpose,
	DemandCharacteristic.* AS DemandCharacteristic,
	InventoryState.* AS InventoryState,
	RequestShipmentOn AS RequestShipmentOn,
	ReceiptOrder.* AS ReceiptOrder,
	Count AS Count,
	ShipmentOrder.* AS ShipmentOrder,
	Client.* AS Client,
	Manager.* AS Manager,
	ControlQualityOfReceivedGoods AS ControlQualityOfReceivedGoods,
	ItemsType.* AS ItemsType,
	UnitOfMeasure.* AS UnitOfMeasure,
	WithAssignment AS WithAssignment,
	Action.* AS Action,
	DateOfReceipt AS DateOfReceipt,
	QualityControl AS QualityControl,
	TheWayToEnsureProductName AS TheWayToEnsureProductName,
	SupplyMethod.* AS SupplyMethod,
	TheShipmentDateIsExecutable AS TheShipmentDateIsExecutable,
	YouCanShipFromAvailableBalance AS YouCanShipFromAvailableBalance,
	CanBeShippedFromAvailability AS CanBeShippedFromAvailability}
FROM
	InformationRegister.InventoryAllocation AS OrderStateOverridable

{WHERE
	VALUE(Enum.InventoryAllocationStates.EmptyRef)AS State,
	OrderStateOverridable.Products.* AS Products,
	OrderStateOverridable.Characteristic.* AS Characteristic,
	OrderStateOverridable.Warehouse.* AS Warehouse,
	OrderStateOverridable.Purpose.* AS Purpose,
	OrderStateOverridable.DemandCharacteristic AS DemandCharacteristic,
	OrderStateOverridable.InventoryState AS InventoryState,
	OrderStateOverridable.RequestShipmentOn AS RequestShipmentOn,
	OrderStateOverridable.ReceiptOrder.* AS ReceiptOrder,
	0 AS Count,
	OrderStateOverridable.ShipmentOrder.* AS ShipmentOrder,
	CAST(VALUE(Catalog.Partners.EmptyRef) AS Catalog.Partners).* AS Client,
	CAST(VALUE(Catalog.Users.EmptyRef) AS Catalog.Users).* AS Manager,
	OrderStateOverridable.Products.ItemsType AS ItemsType,
	OrderStateOverridable.Products.UnitOfMeasure.* AS UnitOfMeasure,
	FALSE AS WithAssignment,
	VALUE(Enum.SupplyOptions.EmptyRef)AS Action,
	DATETIME(1, 1, 1) AS DateOfReceipt,
	DATETIME(1, 1, 1) AS QualityControl}</queryText>
      <mainTable>InformationRegister.InventoryAllocation</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
