    <items xsi:type="form:FormGroup">
      <name>PageRegisterShiftError24Hours</name>
      <id>280</id>
      <items xsi:type="form:Decoration">
        <name>DecorationCashChangeError24Hours</name>
        <id>285</id>
        <title>
          <key>en</key>
          <value>&lt;b>&lt;colorstyle -16>Warning!&lt;/>&lt;/>&lt;b>&lt;/>POS shift is open for more than 24 hours on the selected equipment, and the current user does not have rights to open / close shift-end.</value>
        </title>
        <title>
          <key>fa</key>
          <value>&lt;b>&lt;colorstyle -16>هشدار!&lt;/>&lt;/>&lt;b>&lt;/>شیفت POS روی تجهیزات انتخاب‌شده بیش از 24 ساعت باز است و کاربر جاری حق باز/بسته کردن پایان شیفت را ندارد.</value>
        </title>
        <title>
          <key>it</key>
          <value>&lt;b> &lt;colorstyle -16>Attenzione! &lt;/> &lt;/> &lt;b> &lt;/> Il turno di cassa sul terminale selezionato è aperto da più di 24 ore e l'utente corrente non possiede i diritti di apertura/chiusura del turno di cassa.</value>
        </title>
        <title>
          <key>pl</key>
          <value>&lt;b>&lt;colorstyle -16>Uwaga!&lt;/>&lt;/>&lt;b> &lt;/>Zmiana kasowa na wybranym sprzęcie jest otwarta ponad 24 godziny i bieżący użytkownik nie ma uprawnień do otwarcia/zamknięcia zmiany kasowej.</value>
        </title>
        <title>
          <key>ru</key>
          <value>&lt;b>&lt;colorstyle -16>Внимание!&lt;/>&lt;/>&lt;b> &lt;/>Кассовая смена на выбранном оборудовании открыта более 24 часов и у текущего пользователя нет прав на открытие/закрытие кассовой смены.</value>
        </title>
        <title>
          <key>tr</key>
          <value>&lt;b>&lt;colorstyle -16>Dikkat!&lt;/>&lt;/>&lt;b> &lt;/>Seçilen ekipmandaki POS vardiyası 24 saatten uzun süredir açık ve mevcut kullanıcının POS vardiyasını açma/kapatma yetkisi yoktur.</value>
        </title>
        <title>
          <key>vi</key>
          <value>&lt;b>&lt;colorstyle -16>Chú ý!&lt;/>&lt;/>&lt;b>&lt;/>Phiên thu ngân trên thiết bị được chọn đã mở quá 24 giờ và người sử dụng hiện tại không có quyền mở/đóng phiên thu ngân.</value>
        </title>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <extendedTooltip>
          <name>DecorationCashChangeError24HoursExtendedTooltip</name>
          <id>287</id>
          <type>Label</type>
          <autoMaxWidth>true</autoMaxWidth>
          <autoMaxHeight>true</autoMaxHeight>
          <extInfo xsi:type="form:LabelDecorationExtInfo">
            <horizontalAlign>Left</horizontalAlign>
          </extInfo>
        </extendedTooltip>
        <contextMenu>
          <name>DecorationCashChangeError24HoursContextMenu</name>
          <id>286</id>
          <autoFill>true</autoFill>
        </contextMenu>
        <formatted>true</formatted>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo"/>
      </items>
      <visible>true</visible>
