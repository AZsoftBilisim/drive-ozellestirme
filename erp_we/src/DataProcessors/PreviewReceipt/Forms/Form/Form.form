    <items xsi:type="form:FormGroup">
      <name>PageRegisterShiftIsClosed</name>
      <id>278</id>
      <items xsi:type="form:Decoration">
        <name>DecorationCashRegisterShiftIsClosed</name>
        <id>282</id>
        <title>
          <key>en</key>
          <value>&lt;b>&lt;colorstyle -16>Warning&lt;/>&lt;/>&lt;b>&lt;colorstyle -16>&lt;/>&lt;/>&lt;b>&lt;/>POS shift is closed on the selected equipment, and the current user does not have rights to open the POS shift.</value>
        </title>
        <title>
          <key>fa</key>
          <value>&lt;b>&lt;colorstyle -16>هشدار&lt;/>&lt;/>&lt;b>&lt;colorstyle -16>&lt;/>&lt;/>&lt;b>&lt;/>شیفت POS روی تجهیزات انتخاب‌شده بسته است و کاربر جاری حق باز کردن شیفت POS را ندارد.</value>
        </title>
        <title>
          <key>it</key>
          <value>&lt;b> &lt;colorstyle -16>Attenzione&lt;/> &lt;/> &lt;b> &lt;colorstyle -16>! &lt;/> &lt;/> &lt;b> &lt;/> Il turno di cassa sul terminale selezionato è chiuso e l'utente corrente non possiede i diritti per aprire il turno di cassa.</value>
        </title>
        <title>
          <key>pl</key>
          <value>&lt;b>&lt;colorstyle -16>Uwaga&lt;/>&lt;/>&lt;b>&lt;colorstyle -16>!&lt;/>&lt;/>&lt;b> &lt;/>Zmiana kasowa na wybranym sprzęcie jest zamknięta i bieżący użytkownik nie ma uprawnień do otwarcia zmiany kasowej.</value>
        </title>
        <title>
          <key>ru</key>
          <value>&lt;b>&lt;colorstyle -16>Внимание&lt;/>&lt;/>&lt;b>&lt;colorstyle -16>!&lt;/>&lt;/>&lt;b> &lt;/>Кассовая смена на выбранном оборудовании закрыта и у текущего пользователя нет прав на открытие кассовой смены.</value>
        </title>
        <title>
          <key>tr</key>
          <value>&lt;b>&lt;colorstyle -16>Dikkat&lt;/>&lt;/>&lt;b>&lt;colorstyle -16>!&lt;/>&lt;/>&lt;b> &lt;/>Seçilen ekipmandaki POS vardiyası kapalıdır ve mevcut kullanıcının POS vardiyası açma yetkisi yoktur.</value>
        </title>
        <title>
          <key>vi</key>
          <value>&lt;b>&lt;colorstyle -16>Chú ý&lt;/>&lt;/>&lt;b>&lt;colorstyle -16>!&lt;/>&lt;/>&lt;b> &lt;/>Đã đóng phiên thu ngân trên thiết bị được chọn và người sử dụng hiện tại không có quyền mở phiên thu ngân.</value>
        </title>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <extendedTooltip>
          <name>DecorationCashRegisterShiftIsClosedExtendedTooltip</name>
          <id>284</id>
          <type>Label</type>
          <autoMaxWidth>true</autoMaxWidth>
          <autoMaxHeight>true</autoMaxHeight>
          <extInfo xsi:type="form:LabelDecorationExtInfo">
            <horizontalAlign>Left</horizontalAlign>
          </extInfo>
        </extendedTooltip>
        <contextMenu>
          <name>DecorationCashRegisterShiftIsClosedContextMenu</name>
          <id>283</id>
          <autoFill>true</autoFill>
        </contextMenu>
        <formatted>true</formatted>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo"/>
      </items>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <title>
        <key>en</key>
        <value>Page POS shift is closed.</value>
      </title>
      <title>
        <key>fa</key>
        <value>صفحه شیفت POS بسته است.</value>
      </title>
      <title>
        <key>it</key>
        <value>Pagina turno di cassa chiuso</value>
      </title>
      <title>
