                  <items xsi:type="form:Decoration">
                    <name>DecorationDocumentsOfASingleReceipt</name>
                    <id>271</id>
                    <title>
                      <key>en</key>
                      <value>Single</value>
                    </title>
                    <title>
                      <key>fa</key>
                      <value>واحد</value>
                    </title>
                    <title>
                      <key>it</key>
                      <value>Unico</value>
                    </title>
                    <title>
                      <key>pl</key>
                      <value>Jednolity</value>
                    </title>
                    <title>
                      <key>ru</key>
                      <value>Единый</value>
                    </title>
                    <title>
                      <key>tr</key>
                      <value>Tek</value>
                    </title>
                    <title>
                      <key>vi</key>
                      <value>Duy nhất</value>
