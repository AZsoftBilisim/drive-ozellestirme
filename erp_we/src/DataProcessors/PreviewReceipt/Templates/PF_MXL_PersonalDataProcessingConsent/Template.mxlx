	<rowsItem>
		<index>19</index>
		<row>
			<c>
				<i>1</i>
				<c>
					<f>10</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content> Law No. 152-FZ "On Personal Data" dated July 27, 2006, in order to:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>فدرال شماره 152-FZ "درباره داده‌های شخصی" مورخ 27 ژوئیه 2006، به منظور:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content> della legge federale N 152-LF del 27.07.2006 "Sul trattamento di dati personali", allo scopo di:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content> federalnej z dnia 27.07.2006 r nr 152-FZ "O danych osobowych", w celu:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content> закона от 27.07.2006 N 152-ФЗ "О персональных данных", в целях:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content> 27.07.2006 tarihli ve 152-FZ sayılı "Kişisel Verilerin Korunması" amaçları doğrultusunda:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content> luật ngày 27 tháng 7 năm 2006 N 152-ФЗ "Dữ liệu cá nhân", để:</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
		<index>20</index>
		<row>
			<c>
				<i>1</i>
				<c>
					<f>10</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>- provide legal compliance and other regulatory legal acts;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>- رعایت قوانین و سایر مقررات قانونی؛</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>- garantire l'applicazione di legge e altri atti normativi;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>- zapewnienia przestrzegania ustaw i innych regulacyjnych aktów prawnych;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>- обеспечения соблюдения законов и иных нормативных правовых актов;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>- Yasalara ve diğer düzenleyici yasal işlemlere uygunluğun sağlanmasına;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>- đảm bảo tuân thủ pháp luật và các Biên bản pháp lý điều chỉnh khác;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
		<index>21</index>
		<row>
			<c>
				<i>1</i>
				<c>
					<f>10</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>- calculate and pay taxes, fees and contributions required by the legislation of the Russian Federation;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>- محاسبه و پرداخت مالیات‌ها، عوارض و مشارکت‌های الزامی طبق قوانین فدراسیون روسیه؛</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>- calcolo e pagamento di tasse, commissioni e contributi previsti dalla legislazione della Federazione Russa;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>- obliczania i spłaty przewidzianych przez ustawodawstwo FR podatków, opłat i składek;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>- исчисления и уплаты предусмотренных законодательством РФ налогов, сборов и взносов;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>- Rusya Federasyonu mevzuatı tarafından öngörülen vergi, harç ve katkı paylarının hesaplanmasına ve ödenmesine;</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>- tính toán và thanh toán các loại thuế, phí và đóng góp theo quy định của pháp luật Liên bang Nga;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
		<index>22</index>
		<row>
			<c>
				<i>1</i>
				<c>
					<f>10</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>- provide information records to third parties for submission to public authorities.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>- ارائه سوابق اطلاعاتی به اشخاص ثالث برای ارسال به مراجع دولتی.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>- trasferimento di dati a terzi per la trasmissione di dati a organi governativi.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>- przekazania danych osobom trzecim w celu przekazania danych do organów państwowych.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>- предоставления сведений третьим лицам для передачи данных в государственные органы.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>- Verilerin devlet makamlarına aktarılması için üçüncü taraflara bilgi sağlanmasına.</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>- cung cấp thông tin cho các bên thứ ba để truyền dữ liệu cho các cơ quan chính phủ.</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
