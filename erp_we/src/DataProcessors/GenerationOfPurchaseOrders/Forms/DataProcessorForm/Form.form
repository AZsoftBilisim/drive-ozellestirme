    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDocuments.NotOnSchedule</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentPurchaseOrder.Ref AS Ref,
	DocumentPurchaseOrder.DeletionMark AS DeletionMark,
	DocumentPurchaseOrder.Number AS Number,
	DocumentPurchaseOrder.Date AS Date,
	DocumentPurchaseOrder.Posted AS Posted,
	DocumentPurchaseOrder.Partner AS Partner,
	DocumentPurchaseOrder.Counterparty AS Counterparty,
	DocumentPurchaseOrder.Organization AS Organization,
	DocumentPurchaseOrder.Terms AS Terms,
	DocumentPurchaseOrder.Contract AS Contract,
	DocumentPurchaseOrder.ARAPObjectSettings AS ARAPObjectSettings,
	DocumentPurchaseOrder.Warehouse AS Warehouse,
	DocumentPurchaseOrder.Currency AS Currency,
	DocumentPurchaseOrder.Manager AS Manager,
	DocumentPurchaseOrder.Status AS Status,
	DocumentPurchaseOrder.DocumentAmount AS DocumentAmount,
	DocumentPurchaseOrder.ReturnablePackagingAmount AS ReturnablePackagingAmount,
	DocumentPurchaseOrder.Priority AS Priority,
	DocumentPurchaseOrder.AdditionalInformation AS AdditionalInformation,
	DocumentPurchaseOrder.RequestedDeliveryDate AS RequestedDeliveryDate,
	DocumentPurchaseOrder.DateOfFirstReceipt AS DateOfFirstReceipt,
	DocumentPurchaseOrder.PrepaymentAmountBeforeReceipt AS PrepaymentAmountBeforeReceipt,
	DocumentPurchaseOrder.AmountAdvanceBeforeConfirmation AS AmountAdvanceBeforeConfirmation,
	DocumentPurchaseOrder.BusinessOperation AS BusinessOperation,
	DocumentPurchaseOrder.Comment AS Comment,
	DocumentPurchaseOrder.VendorReferenceNumber AS VendorReferenceNumber,
	DocumentPurchaseOrder.VendorReferenceDate AS VendorReferenceDate,
	CASE
		WHEN (NOT DocumentPurchaseOrder.Posted)
			THEN VALUE(Enum.PurchaseOrderStates.EmptyRef)
		ELSE
			ISNULL(PurchaseOrderStates.State, VALUE(Enum.PurchaseOrderStates.Closed)) 
	END AS State,
	CASE
		WHEN (NOT DocumentPurchaseOrder.Posted)
			THEN FALSE
		WHEN (DocumentPurchaseOrder.Status = VALUE(Enum.PurchaseOrderStatuses.Closed) AND &amp;UseStatuses)
			THEN FALSE
		WHEN PurchaseOrderStates.EventDate &lt;> DATETIME(1, 1, 1)
				AND &amp;UpdateDate > PurchaseOrderStates.EventDate 
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CASE
		WHEN DocumentPurchaseOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentPurchaseOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	ISNULL(PurchaseOrderStates.PayAmount,0) AS PayAmount,
	ISNULL(PurchaseOrderStates.PayPercentage,0) AS PayPercentage,
	ISNULL(PurchaseOrderStates.OrderReceiptAmount,0) AS OrderReceiptAmount,
	ISNULL(PurchaseOrderStates.PercentageOfOrderReceipt,0) AS PercentageOfOrderReceipt,
	CASE
		WHEN ISNULL(PurchaseOrderStates.AmountOfDebt,0) > 0 
			THEN ISNULL(PurchaseOrderStates.AmountOfDebt,0)
		ELSE 0
	END AS DebtOfSupplier,
	CASE
		WHEN ISNULL(PurchaseOrderStates.AmountOfDebt,0) &lt; 0 
			THEN ISNULL(PurchaseOrderStates.AmountOfDebt,0)
		ELSE 0
	END AS AccountsPayableOfCompany,
	ISNULL(PurchaseOrderStates.DebtPercentage,0) AS DebtPercentage,
	ISNULL(PurchaseOrderStates.EventDate, DATETIME(1, 1, 1)) AS EventDate,
	CASE WHEN DocumentPurchaseOrder.Posted AND DocumentPurchaseOrder.Status IN(
		VALUE(Enum.PurchaseOrderStatuses.Confirmed_),
		VALUE(Enum.PurchaseOrderStatuses.Closed)) THEN 0
			ELSE 1
		END NotOnSchedule
FROM
	Document.PurchaseOrder AS DocumentPurchaseOrder
		LEFT JOIN InformationRegister.PurchaseOrderStates AS PurchaseOrderStates
		ON (PurchaseOrderStates.OrderDocument = DocumentPurchaseOrder.Ref)
WHERE
	DocumentPurchaseOrder.Ref IN (&amp;CreatedDocuments)</queryText>
      <mainTable>Document.PurchaseOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
