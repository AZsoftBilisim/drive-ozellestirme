    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.PurchaseAmount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.SumBalance</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.overspending</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Cash.Organization        AS Organization,
	Cash.AdvanceHolder    AS AdvanceHolder,
	Cash.Department      AS Department,
	Cash.IssuancePurpose         AS IssuancePurpose,
	Cash.Currency             AS Currency,
	CASE
		WHEN Cash.SumBalance > 0 THEN
			Cash.SumBalance
	END AS SumBalance,
	CASE
		WHEN Cash.ToReportBalance > 0 THEN
			Cash.ToReportBalance
	END AS AmountOverdue,
	CASE
		WHEN Cash.SumBalance &lt; 0 THEN
			-Cash.SumBalance
	END AS overspending,
	Cash.PurchaseAmountBalance AS PurchaseAmount
	
FROM
	AccumulationRegister.AdvanceHolderCash.Balance(&amp;CurrentDate, ) AS Cash

WHERE
	Cash.SumBalance &lt;> 0
	OR Cash.ToReportBalance > 0
	OR Cash.PurchaseAmountBalance > 0
</queryText>
      <mainTable>AccumulationRegister.AdvanceHolderCash.Balance</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
