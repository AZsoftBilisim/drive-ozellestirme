      <value>Chứng từ theo cơ sở</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsByBasis.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InternalDocumentData.Ref,
	InternalDocumentData.Organization,
	InternalDocumentData.Department,
	InternalDocumentData.Status,
	InternalDocumentData.BusinessOperation,
	InternalDocumentData.EmployeeResponsible,
	InternalDocumentData.More,
	InternalDocumentData.Comment,
	InternalDocumentData.Posted,
	InternalDocumentData.DeletionMark,
	VALUETYPE(InternalDocumentData.Ref) AS Type,
	CASE
		WHEN InternalDocumentData.Posted
			THEN 0
		WHEN InternalDocumentData.DeletionMark
			THEN 1
		ELSE 2
	END AS Picture,
	CAST(InternalDocumentData.StorageLocation.Key AS Catalog.Warehouses) AS Warehouse,
	InternalDocumentData.IBDocumentDate AS Date,
	InternalDocumentData.IBDocumentNumber AS Number
FROM
	InformationRegister.DocumentsRegistry AS InternalDocumentData
WHERE
	(InternalDocumentData.Ref REFS Document.InventorySurplusRecognition
			OR InternalDocumentData.Ref REFS Document.WriteOffOfGoodsShortages
			OR InternalDocumentData.Ref REFS Document.GoodsDamage
			OR InternalDocumentData.Ref REFS Document.GoodsMisgrading
			OR InternalDocumentData.Ref REFS Document.PhysicalCountReport)</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
