            <items xsi:type="form:Decoration">
              <name>ExplanationNoRowsForSelection</name>
              <id>822</id>
              <title>
                <key>en</key>
                <value>There are no lines with the same items in the lists of stock surplus and shortage recognition, that is why the line filter is not available.</value>
              </title>
              <title>
                <key>fa</key>
