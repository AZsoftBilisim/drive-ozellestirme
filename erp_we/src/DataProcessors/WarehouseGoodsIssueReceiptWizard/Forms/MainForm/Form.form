          <id>381</id>
          <title>
            <key>en</key>
            <value>Select the lines to reclass stock</value>
          </title>
          <title>
            <key>fa</key>
            <value>سطرها را برای تغییر طبقه موجودی انتخاب کنید</value>
          </title>
          <title>
            <key>it</key>
            <value>Selezione delle stringhe per riclassificazione</value>
          </title>
          <title>
            <key>pl</key>
            <value>Filtr wierszy do zaliczenia przeklasyfikowania</value>
          </title>
          <title>
            <key>ru</key>
            <value>Отбор строк для зачета по пересортице</value>
          </title>
          <title>
            <key>tr</key>
            <value>Yeniden sınıflandırmaya göre mahsubu için satır filtresi</value>
          </title>
          <title>
            <key>vi</key>
            <value>Lọc dòng để đối trừ sau khi chuyển tồn</value>
