  <attributes>
    <name>GoodsForRegistration</name>
    <title>
      <key>en</key>
      <value>Goods for registration</value>
    </title>
    <title>
      <key>fa</key>
      <value>کالاها برای ثبت</value>
    </title>
    <title>
      <key>it</key>
      <value>Merci da formalizzare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Towary do rejestracji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Товары к оформлению</value>
    </title>
    <title>
      <key>tr</key>
      <value>Malların düzenlenmesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Hàng hóa cần lập chứng từ</value>
    </title>
    <id>10</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.Consignor</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.Contract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.CountBalance</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.DocumentSales</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.QuantityConsumedBalance</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.ReturnAmount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.RevenueAmount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>GoodsForRegistration.VATTaxation</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Data_For_Registration.Currency AS Currency,
	Data_For_Registration.Organization AS Organization,
	Data_For_Registration.Consignor AS Consignor,
	Data_For_Registration.Counterparty AS Counterparty,
	Data_For_Registration.Terms AS Terms,
	Data_For_Registration.Contract AS Contract,
	Data_For_Registration.VATTaxation AS VATTaxation,
	SUM(Data_For_Registration.RevenueAmount) AS RevenueAmount,
	SUM(Data_For_Registration.ReturnAmount) AS ReturnAmount,
	SUM(Data_For_Registration.CountBalance) AS CountBalance,
	SUM(Data_For_Registration.QuantityConsumedBalance) AS QuantityConsumedBalance,
	Data_For_Registration.BusinessOperation AS BusinessOperation,
	Data_For_Registration.DocumentSales AS DocumentSales,
	CASE
		WHEN Data_For_Registration.DocumentSales &lt;> VALUE(Document.CustomerInvoice.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS SplitReportByDocuments,
	CASE
		WHEN Data_For_Registration.DocumentSales &lt;> VALUE(Document.CustomerInvoice.EmptyRef)
		AND EDStates.StatusPresentation IS NULL
			THEN &amp;StateNotStarted
		ELSE EDStates.StatusPresentation
	END AS StatusPresentation
FROM
	(SELECT
		ToRegister.Currency AS Currency,
		ToRegister.Organization AS Organization,
		ToRegister.Consignor AS Consignor,
		ToRegister.Counterparty AS Counterparty,
		ToRegister.Terms AS Terms,
		MAX(ToRegister.Contract) AS Contract,
		ToRegister.VATTaxation AS VATTaxation,
		SUM(ToRegister.RevenueAmount) AS RevenueAmount,
		SUM(ToRegister.ReturnAmount) AS ReturnAmount,
		SUM(ToRegister.CountBalance) AS CountBalance,
		SUM(ToRegister.QuantityConsumed) AS QuantityConsumedBalance,
		ToRegister.BusinessOperation AS BusinessOperation,
		ToRegister.DocumentSales AS DocumentSales
	FROM
		(SELECT
			GoodsForRegistration.Currency AS Currency,
			InventoryKinds.Organization AS Organization,
			InventoryKinds.GoodsOwner AS Consignor,
			InventoryKinds.Counterparty AS Counterparty,
			InventoryKinds.Terms AS Terms,
			InventoryKinds.Contract AS Contract,
			InventoryKinds.VATTaxation AS VATTaxation,
			InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType AS TypeOfInventoryOfTheCommitee,
			CASE
				WHEN GoodsForRegistration.RevenueAmountClosingBalance > 0
					THEN GoodsForRegistration.RevenueAmountClosingBalance
				ELSE 0
			END AS RevenueAmount,
			CASE
				WHEN GoodsForRegistration.RevenueAmountClosingBalance &lt; 0
					THEN -GoodsForRegistration.RevenueAmountClosingBalance
				ELSE 0
			END AS ReturnAmount,
			CASE
				WHEN GoodsForRegistration.CountClosingBalance &lt; 0
					THEN -GoodsForRegistration.CountClosingBalance
				ELSE 0
			END AS CountBalance,
			0 AS QuantityConsumed,
			&amp;AccountSalesToConsignor AS BusinessOperation,
			GoodsForRegistration.DocumentSales AS DocumentSales
		FROM
			AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.BalanceAndTurnovers(&amp;InitialBorder, &amp;ConBorder, Auto, , ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS
				GoodsForRegistration
			INNER JOIN Catalog.InventoryKinds AS InventoryKinds
				ON InventoryKinds.Ref = GoodsForRegistration.InventoryOwnerAttribute
			INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
				ON CounterpartyContracts.Ref = InventoryKinds.Contract
		WHERE
			InventoryKinds.GoodsOwner REFS Catalog.Partners
			AND InventoryKinds.Contract REFS Catalog.CounterpartyContracts
			AND (GoodsForRegistration.CountClosingBalance &lt;> 0
					OR GoodsForRegistration.RevenueAmountClosingBalance &lt;> 0)
			AND (GoodsForRegistration.CountReceipt &lt;> 0
					OR GoodsForRegistration.CountExpense &lt;> 0
					OR GoodsForRegistration.RevenueAmountReceipt &lt;> 0
					OR GoodsForRegistration.RevenueAmountExpense &lt;> 0)
		
		UNION ALL

		SELECT
			GoodsForRegistration.Currency AS Currency,
			InventoryKinds.Organization AS Organization,
			InventoryKinds.GoodsOwner AS Consignor,
			InventoryKinds.Counterparty AS Counterparty,
			InventoryKinds.Terms AS Terms,
			InventoryKinds.Contract AS Contract,
			InventoryKinds.VATTaxation AS VATTaxation,
			InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType AS TypeOfInventoryOfTheCommitee,
			CASE
				WHEN GoodsForRegistration.RevenueAmountClosingBalance > 0
					THEN GoodsForRegistration.RevenueAmountClosingBalance
				ELSE 0
			END AS RevenueAmount,
			CASE
				WHEN GoodsForRegistration.RevenueAmountClosingBalance &lt; 0
					THEN -GoodsForRegistration.RevenueAmountClosingBalance
				ELSE 0
			END AS ReturnAmount,
			CASE
				WHEN GoodsForRegistration.CountClosingBalance &lt; 0
					THEN -GoodsForRegistration.CountClosingBalance
				ELSE 0
			END AS CountBalance,
			0 AS QuantityConsumed,
			&amp;AccountSalesToConsignor AS BusinessOperation,
			GoodsForRegistration.DocumentSales AS DocumentSales
		FROM
			AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.BalanceAndTurnovers(&amp;InitialBorder, &amp;ConBorder, Auto, , ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS
				GoodsForRegistration
			INNER JOIN Catalog.InventoryKinds AS InventoryKinds
				ON InventoryKinds.Ref = GoodsForRegistration.InventoryOwnerAttribute
		WHERE
			InventoryKinds.GoodsOwner REFS Catalog.Partners
			AND NOT InventoryKinds.Contract REFS Catalog.CounterpartyContracts
			AND (GoodsForRegistration.CountClosingBalance &lt;> 0
					OR GoodsForRegistration.RevenueAmountClosingBalance &lt;> 0)
			AND (GoodsForRegistration.CountReceipt &lt;> 0
					OR GoodsForRegistration.CountExpense &lt;> 0
					OR GoodsForRegistration.RevenueAmountReceipt &lt;> 0
					OR GoodsForRegistration.RevenueAmountExpense &lt;> 0)
		
		UNION ALL
		
		SELECT
			GoodsForRegistration.Currency,
			InventoryKinds.Organization,
			InventoryKinds.GoodsOwner,
			InventoryKinds.Counterparty,
			InventoryKinds.Terms,
			InventoryKinds.Contract,
			InventoryKinds.VATTaxation,
			InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType,
			0,
			0,
			0,
			CASE
				WHEN GoodsForRegistration.QuantityConsumedClosingBalance &lt; 0
					THEN -GoodsForRegistration.QuantityConsumedClosingBalance
				ELSE GoodsForRegistration.QuantityConsumedClosingBalance
			END,
			&amp;PurchaseInvoiceConsignmentStockLost,
			GoodsForRegistration.DocumentSales
		FROM
			AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.BalanceAndTurnovers(&amp;InitialBorder, &amp;ConBorder, Auto, , ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS
				GoodsForRegistration
			INNER JOIN Catalog.InventoryKinds AS InventoryKinds
				ON InventoryKinds.Ref = GoodsForRegistration.InventoryOwnerAttribute
			INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
				ON CounterpartyContracts.Ref = InventoryKinds.Contract
		WHERE
			InventoryKinds.GoodsOwner REFS Catalog.Partners
			AND InventoryKinds.Contract REFS Catalog.CounterpartyContracts
			AND (GoodsForRegistration.QuantityConsumedClosingBalance &lt;> 0
					OR GoodsForRegistration.RevenueAmountClosingBalance &lt;> 0)
			AND (GoodsForRegistration.QuantityConsumedReceipt &lt;> 0
					OR GoodsForRegistration.QuantityConsumedExpense &lt;> 0
					OR GoodsForRegistration.RevenueAmountReceipt &lt;> 0
					OR GoodsForRegistration.RevenueAmountExpense &lt;> 0)
		
		UNION ALL
		
		SELECT
			GoodsForRegistration.Currency,
			InventoryKinds.Organization,
			InventoryKinds.GoodsOwner,
			InventoryKinds.Counterparty,
			InventoryKinds.Terms,
			InventoryKinds.Contract,
			InventoryKinds.VATTaxation,
			InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType,
			0,
			0,
			0,
			CASE
				WHEN GoodsForRegistration.QuantityConsumedClosingBalance &lt; 0
					THEN -GoodsForRegistration.QuantityConsumedClosingBalance
				ELSE GoodsForRegistration.QuantityConsumedClosingBalance
			END,
			&amp;PurchaseInvoiceConsignmentStockLost,
			GoodsForRegistration.DocumentSales
		FROM
			AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.BalanceAndTurnovers(&amp;InitialBorder, &amp;ConBorder, Auto, , ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS
				GoodsForRegistration
			INNER JOIN Catalog.InventoryKinds AS InventoryKinds
				ON InventoryKinds.Ref = GoodsForRegistration.InventoryOwnerAttribute
		WHERE
			InventoryKinds.GoodsOwner REFS Catalog.Partners
			AND NOT InventoryKinds.Contract REFS Catalog.CounterpartyContracts
			AND (GoodsForRegistration.QuantityConsumedClosingBalance &lt;> 0
					OR GoodsForRegistration.RevenueAmountClosingBalance &lt;> 0)
			AND (GoodsForRegistration.QuantityConsumedReceipt &lt;> 0
					OR GoodsForRegistration.QuantityConsumedExpense &lt;> 0
					OR GoodsForRegistration.RevenueAmountReceipt &lt;> 0
					OR GoodsForRegistration.RevenueAmountExpense &lt;> 0)
		
		UNION ALL

		SELECT
			ServicesForRegistration.Currency,
			ServicesForRegistration.Organization,
			ServicesForRegistration.ItemsLocationAttributes.StorageLocation,
			UNDEFINED,
			ServicesForRegistration.Terms,
			UNDEFINED,
			UNDEFINED,
			VALUE(Enum.InventoryTypes.EmptyRef),
			CASE
				WHEN ServicesForRegistration.RevenueAmountClosingBalance > 0
					THEN ServicesForRegistration.RevenueAmountClosingBalance
				ELSE 0
			END,
			CASE
				WHEN ServicesForRegistration.RevenueAmountClosingBalance &lt; 0
					THEN -ServicesForRegistration.RevenueAmountClosingBalance
				ELSE 0
			END,
			CASE
				WHEN ServicesForRegistration.CountClosingBalance > 0
					THEN ServicesForRegistration.CountTurnover
				ELSE 0
			END,
			0,
			&amp;AccountSalesToConsignor,
			ServicesForRegistration.DocumentSales
		FROM
			AccumulationRegister.ServicesForRegistrationOfReportsToPrincipal.BalanceAndTurnovers(&amp;InitialBorder, &amp;ConBorder, Auto, ,
				ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)) AS ServicesForRegistration
		WHERE
			(ServicesForRegistration.CountClosingBalance &lt;> 0
					OR ServicesForRegistration.RevenueAmountClosingBalance &lt;> 0)
			AND (ServicesForRegistration.CountReceipt &lt;> 0
					OR ServicesForRegistration.CountExpense &lt;> 0
					OR ServicesForRegistration.RevenueAmountReceipt &lt;> 0
					OR ServicesForRegistration.RevenueAmountExpense &lt;> 0)) AS ToRegister
	
	GROUP BY
		ToRegister.Currency,
		ToRegister.Organization,
		ToRegister.Consignor,
		ToRegister.Counterparty,
		ToRegister.Terms,
		ToRegister.Contract,
		ToRegister.VATTaxation,
		ToRegister.BusinessOperation,
		ToRegister.DocumentSales) AS Data_For_Registration
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON Data_For_Registration.DocumentSales = EDStates.ObjectReference
GROUP BY
	Data_For_Registration.Currency,
	Data_For_Registration.Organization,
	Data_For_Registration.Consignor,
	Data_For_Registration.Counterparty,
	Data_For_Registration.Terms,
	Data_For_Registration.Contract,
	Data_For_Registration.VATTaxation,
	Data_For_Registration.BusinessOperation,
	Data_For_Registration.DocumentSales,
	EDStates.StatusPresentation,
	CASE
		WHEN Data_For_Registration.DocumentSales &lt;> VALUE(Document.CustomerInvoice.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END,
	CASE
		WHEN Data_For_Registration.DocumentSales &lt;> VALUE(Document.CustomerInvoice.EmptyRef)
				AND EDStates.StatusPresentation IS NULL
			THEN &amp;StateNotStarted
		ELSE EDStates.StatusPresentation
	END

HAVING
	(SUM(Data_For_Registration.CountBalance) &lt;> 0
		OR SUM(Data_For_Registration.RevenueAmount) &lt;> 0
		OR SUM(Data_For_Registration.QuantityConsumedBalance) &lt;> 0
		OR SUM(Data_For_Registration.ReturnAmount) &lt;> 0)</queryText>
