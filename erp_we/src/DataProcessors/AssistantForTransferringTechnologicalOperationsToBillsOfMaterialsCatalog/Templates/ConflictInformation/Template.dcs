				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số lượng / Thời gian</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<presentationExpression>Case When Not ValueIsFilled(QuantityCalculationAlgorithm)
	Then Count
	Else QuantityCalculationAlgorithm
End</presentationExpression>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>HorizontalAlign</dcscor:parameter>
					<dcscor:value xsi:type="v8ui:HorizontalAlign">Right</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>QuantityCalculationAlgorithm</dataPath>
			<field>QuantityCalculationAlgorithm</field>
