    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RouteSheets.Ref,
	RouteSheets.DeletionMark,
	RouteSheets.Code,
	RouteSheets.Description,
	RouteSheets.Status,
	RouteSheets.ValidOnDate,
	RouteSheets.ValidToDate,
	RouteSheets.ForFinishedProductsKind,
	RouteSheets.Department,
	RouteSheets.EmployeeResponsible,
	RouteSheets.LongDesc
FROM
	Catalog.RouteSheets AS RouteSheets
WHERE
	TRUE
	AND &amp;TextSelectionOfRouteMaps</queryText>
      <mainTable>Catalog.RouteSheets</mainTable>
