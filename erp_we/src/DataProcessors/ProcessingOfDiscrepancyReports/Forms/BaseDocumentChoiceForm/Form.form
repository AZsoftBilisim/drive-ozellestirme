      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
        <choiceList>
          <presentation>
            <key>en</key>
            <value>Leave discrepancies</value>
          </presentation>
          <presentation>
            <key>fa</key>
            <value>حفظ مغایرت‌ها</value>
          </presentation>
          <presentation>
            <key>it</key>
            <value>Mantenere le discrepanze</value>
