  <items xsi:type="form:FormGroup">
    <name>RunMode</name>
    <id>5</id>
    <items xsi:type="form:FormGroup">
      <name>ApplicationVersionUpdate</name>
      <id>6</id>
      <items xsi:type="form:Decoration">
        <name>NewConfigurationVersionMessageText</name>
        <id>1</id>
        <title>
          <key>en</key>
          <value>Updating to version %1.</value>
        </title>
        <title>
          <key>fa</key>
          <value>در حال به‌روزرسانی به نسخه %1.</value>
        </title>
        <title>
          <key>it</key>
          <value>Aggiornamento della versione %1 è in corso</value>
        </title>
        <title>
          <key>pl</key>
          <value>Trwa aktualizacja do wersji%1</value>
        </title>
        <title>
          <key>ru</key>
          <value>Выполняется обновление на версию %1</value>
        </title>
        <title>
          <key>tr</key>
          <value>%1 sürümüne güncelleniyor.</value>
        </title>
        <title>
          <key>vi</key>
          <value>Đang cập nhật sang phiên bản %1</value>
        </title>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <extendedTooltip>
          <name>NewConfigurationVersionMessageTextExtendedTooltip</name>
          <id>14</id>
          <type>Label</type>
          <autoMaxWidth>true</autoMaxWidth>
          <autoMaxHeight>true</autoMaxHeight>
          <extInfo xsi:type="form:LabelDecorationExtInfo">
