        <name>CleanUpDeleteable</name>
        <id>47</id>
        <title>
          <key>en</key>
          <value>Clear data to be deleted</value>
        </title>
        <title>
          <key>fa</key>
          <value>پاک کردن داده‌های قابل حذف</value>
        </title>
        <title>
          <key>ru</key>
          <value>Чистить удаляемые</value>
        </title>
        <title>
          <key>tr</key>
          <value>Silinenleri temizle</value>
        </title>
        <title>
          <key>vi</key>
          <value>Xóa sạch</value>
        </title>
        <title>
          <key>it</key>
          <value>Clear data to be deleted</value>
        </title>
        <title>
