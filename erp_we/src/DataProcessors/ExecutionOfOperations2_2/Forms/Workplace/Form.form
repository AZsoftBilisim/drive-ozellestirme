    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	QueueOverridable.ReferenceOrder AS ReferenceOrder,
	QueueOverridable.Stage AS Stage,
	QueueOverridable.Operation AS Operation,
	QueueOverridable.OperationID AS OperationID,
	QueueOverridable.ProductionOperation AS ProductionOperation,
	QueueOverridable.ProductionOperation.Number AS ProductionOperationNumber,
	QueueOverridable.ProductionOperation.Status AS RoutesOperationStatus,
	QueueOverridable.ProductionOperation.BasedOnMasterData AS RoutingOperationOnBasisOfNSI,
	QueueOverridable.ProductionOperation.OperationAsOutputReference AS RoutesOperationAsOrderOfProduction,
	QueueOverridable.ProductionOperation &lt;> VALUE(Document.ProductionOperation2_2.EmptyRef) AS RoutesOperationIsAssigned,
	QueueOverridable.State AS State,
	QueueOverridable.Performer AS Performer,
	QueueOverridable.ShiftTask AS ShiftTask,
	QueueOverridable.ShiftTask.Date AS ShiftTaskDate,
	FALSE AS Skippable,
	FALSE AS Repeatable,
	0 AS CountPlan,
	0 AS QuantityInOperation,
	0 AS QuantityIsReady,
	0 AS DefectiveGoodsCount,
	0 AS FollowUp,
	0 AS QuantityUnderRevision,
	0 AS ExecutionIsAllowed,
	0 AS PendingPredecessorCompletion,
	0 AS PreviousOnesStarted,
	FALSE AS RepetitionIsRequired,
	QueueOverridable.TimeTotal AS RunTime,
	QueueOverridable.TimeUnitsOfMeasure AS TimeUnitsOfMeasure,
	QueueOverridable.OperationNumber AS OperationNumber,
	QueueOverridable.NextOperation AS NextOperation,
	&quot;&quot;&quot;&quot; AS NameOfTheOperation,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS UnitOfMeasure,
	VALUE(Catalog.WorkCenterTypes.EmptyRef) AS WorkCenterType,
	VALUE(Catalog.WorkCenters.EmptyRef) AS WorkCenter,
	VALUE(Catalog.ProductionSites.EmptyRef) AS ProductionArea,
	VALUE(Catalog.SetupOptions.EmptyRef) AS SetupSettings,
	&amp;PresentationStage AS PresentationStage,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic
FROM
	InformationRegister.QueueOfProductionOperations AS QueueOverridable
WHERE
	NOT QueueOverridable.InArchive
	AND NOT QueueOverridable.Stage.Organization IS NULL</queryText>
      <mainTable>InformationRegister.QueueOfProductionOperations</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
