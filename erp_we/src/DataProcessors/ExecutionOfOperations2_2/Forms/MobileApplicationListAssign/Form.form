    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.ProductionOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.ReferenceOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.SetupSettings</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.Skippable</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.Stage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.State</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.WaitingForCreation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.WorkCenter</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.WorkCenterType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationAssignment1.YouCanStartNow</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	QueueOverridable.ReferenceOrder AS ReferenceOrder,
	QueueOverridable.Stage AS Stage,
	QueueOverridable.Department AS Department,
	QueueOverridable.Operation AS Operation,
	QueueOverridable.OperationID AS OperationID,
	QueueOverridable.Stage AS PresentationStage,
	OperationsOverridable.UnitOfMeasure AS UnitOfMeasure,
	OperationsOverridable.WorkCenter AS WorkCenterType,
	OperationsOverridable.WorkCenter AS WorkCenter,
	OperationsOverridable.SetupSettings AS SetupSettings,
	QueueOverridable.TimeUnitsOfMeasure AS TimeUnitsOfMeasure,
	OperationsOverridable.Skippable AS Skippable,
	0 AS WaitingForCreation,
	0 AS ExecutionTimeWaitingForCreation,
	0 AS ExecutionIsAllowed,
	DATETIME(1, 1, 1) AS StartDate,
	FALSE AS YouCanStartNow,
	QueueOverridable.Order AS Order,
	QueueOverridable.OperationNumber AS OperationNumber,
	QueueOverridable.NextOperation AS NextOperation,
	OperationsOverridable.LongDesc AS LongDesc,
	ScheduleOverridable.Begin AS StageStart,
	ScheduleOverridable.NextStageStart AS NextStageStart,
	&quot;&quot; AS Description,
	VALUE(Enum.OperationStates.EmptyRef) AS State,
	VALUE(Document.ProductionOperation2_2.EmptyRef) AS ProductionOperation,
	VALUE(Catalog.ProductionSites.EmptyRef) AS ProductionArea,
	UNDEFINED AS Performer
FROM
	InformationRegister.QueueOfProductionOperations AS QueueOverridable
		LEFT JOIN Catalog.ManufacturingOperations AS OperationsOverridable
		ON QueueOverridable.Operation = OperationsOverridable.Ref
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOverridable
		ON QueueOverridable.ReferenceOrder = ScheduleOverridable.ProductionOrder
			AND QueueOverridable.Stage = ScheduleOverridable.Stage
			AND (ScheduleOverridable.ScheduleStatus = &amp;StatusWorkingSchedule)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
