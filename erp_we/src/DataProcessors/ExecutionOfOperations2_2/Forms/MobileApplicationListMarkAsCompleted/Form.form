    </title>
    <title>
      <key>vi</key>
      <value>Giao dịch</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentOperation.Ref AS Ref,
	DocumentOperation.Number AS Number,
	DocumentOperation.Date AS Date,
	DocumentOperation.Stage AS Stage,
	DocumentOperation.Operation AS Operation,
	DocumentOperation.OperationID AS OperationID,
	DocumentOperation.Status AS Status,
	DocumentOperation.Department AS Department,
	DocumentOperation.Performer AS Performer,
	CASE
		WHEN DocumentOperation.WorkCenter REFS Catalog.WorkCenterTypes
			THEN DocumentOperation.WorkCenter
		ELSE
			DocumentOperation.WorkCenter.WorkCenterType
	END AS WorkCenterType,
	CASE
		WHEN DocumentOperation.WorkCenter REFS Catalog.WorkCenters
			THEN DocumentOperation.WorkCenter
		ELSE
			VALUE(Catalog.WorkCenters.EmptyRef)
	END AS WorkCenter,
	DocumentOperation.Count - DocumentOperation.CountCanceled AS Count,
	DocumentOperation.CountReal AS CountReal,
	DocumentOperation.RunTime AS RunTime,
	DocumentOperation.ExecutionTimeUnitOfMeasure AS ExecutionTimeUnitOfMeasure,
	DocumentOperation.LotNumber AS LotNumber,
	DocumentOperation.ShiftTask AS ShiftTask,
	CAST(&quot;&quot; AS STRING(100)) AS ShiftTaskPresentation,
	DocumentOperation.Description AS Description,
	CASE
		WHEN Queue.ExecutionIsAllowed > 0 OR Queue.Running > 0
			THEN TRUE
		ELSE FALSE
	END AS YouCanStartNow
FROM
	Document.ProductionOperation2_2 AS DocumentOperation
		INNER JOIN InformationRegister.QueueOfProductionOperations AS Queue
		ON DocumentOperation.OperationID = Queue.OperationID
			AND DocumentOperation.Stage = Queue.Stage
			AND DocumentOperation.Department = Queue.Department
			AND DocumentOperation.Ref = Queue.ProductionOperation
WHERE
	DocumentOperation.Posted
	AND DocumentOperation.Status IN (VALUE(Enum.ProductionOperationStatuses.CreatedOn_),
								VALUE(Enum.ProductionOperationStatuses.Running))</queryText>
      <mainTable>Document.ProductionOperation2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
