    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Operations.Ref AS Ref,
	Operations.Number AS Number,
	Operations.Date AS Date,
	Operations.Status AS Status,
	Operations.Operation AS Operation,
	Operations.Description AS OperationName_,
	Operations.ProductionArea AS ProductionArea,
	Operations.Performer AS Performer,
	Operations.ShiftTask AS ShiftTask,
	Operations.Stage.ProductionLot.MainProductProducts   AS Products,
	Operations.Stage.ProductionLot.MainProductCharacteristic AS Characteristic,
	CASE
		WHEN Operations.WorkCenter REFS Catalog.WorkCenterTypes
			THEN Operations.WorkCenter
		ELSE
			Operations.WorkCenter.WorkCenterType
	END                                                          AS WorkCenterType,
	CASE
		WHEN Operations.WorkCenter REFS Catalog.WorkCenters
			THEN Operations.WorkCenter
		ELSE
			VALUE(Catalog.WorkCenters.EmptyRef)
	END                                                          AS WorkCenter,
	Operations.FollowUp AS FollowUp,
	Operations.QuantityUnderRevision AS QuantityUnderRevision,
	Operations.DefectiveGoodsCount AS DefectiveGoodsCount,
	Operations.ControlAgain AS ControlAgain,
	Operations.BasedOnMasterData AS BasedOnMasterData,
	Operations.OperationAsOutputReference AS OperationAsOutputReference,
	Operations.Stage AS Stage
FROM
	Document.ProductionOperation2_2 AS Operations
WHERE
	Operations.Posted
	AND Operations.FollowUp > 0</queryText>
      <mainTable>Document.ProductionOperation2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
