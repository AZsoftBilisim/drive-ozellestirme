          </toolTip>
          <toolTip>
            <key>vi</key>
            <value>Biểu mẫu sẽ chạy bất kể tham số khởi chạy đã được khai báo chưa</value>
          </toolTip>
          <toolTipRepresentation>Button</toolTipRepresentation>
