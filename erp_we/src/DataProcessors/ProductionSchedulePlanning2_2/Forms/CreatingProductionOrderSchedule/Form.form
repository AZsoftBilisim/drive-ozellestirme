    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>StagesAreDynamic.CanBeScheduled</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>StagesAreDynamic.ChartDateImageIndex</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>StagesAreDynamic.KeyLot</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>StagesAreDynamic.Stage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>StagesAreDynamic.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ScheduleOverridable.ProductionOrder AS ProductionOrder,
	ScheduleOverridable.Stage AS Stage,
	CASE
		WHEN ScheduleOverridable.Stage REFS Catalog.ProductionStages
			THEN CAST(ScheduleOverridable.Stage AS Catalog.ProductionStages).Description
		ELSE &amp;PresentationStage
	END AS PresentationStage,
	CASE
		WHEN ScheduleOverridable.Stage REFS Document.ProductionStage2_2
			THEN CAST(ScheduleOverridable.Stage AS Document.ProductionStage2_2).Status
		ELSE &amp;StatusIsWaitingToBeGenerated
	END AS StatusPresentation,
	CASE
		WHEN ScheduleOverridable.Stage REFS Document.ProductionStage2_2
			THEN CAST(ScheduleOverridable.Stage AS Document.ProductionStage2_2).Status
		ELSE VALUE(Enum.StatusesOfProductionStages2_2.EmptyRef)
	END AS Status,
	CASE
		WHEN ScheduleOverridable.Stage REFS Document.ProductionStage2_2
			THEN NOT CAST(ScheduleOverridable.Stage AS Document.ProductionStage2_2).StagePlacementInProductionSchedule
				AND CAST(ScheduleOverridable.Stage AS Document.ProductionStage2_2).Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated),
					VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
					VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion))
		ELSE TRUE
	END AS CanBeScheduled,
	ScheduleOverridable.KeyLot,
	ScheduleOverridable.Begin AS Begin,
	ScheduleOverridable.Ending AS Ending,
	ScheduleOverridable.Department AS Department,
	ScheduleOverridable.BillOfMaterials AS BillOfMaterials,
	CASE
		WHEN ScheduleOverridable.BillOfMaterials.MainProductProducts = VALUE(Catalog.Products.EmptyRef)
			THEN ScheduleOverridable.BillOfMaterials.MainProductProductKind
		ELSE ScheduleOverridable.BillOfMaterials.MainProductProducts
	END AS Products,
	ScheduleOverridable.BillOfMaterials.MainProductCharacteristic AS Characteristic,
	CASE
		WHEN ScheduleOverridable.BillOfMaterials.MainProductPackage = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN ScheduleOverridable.BillOfMaterials.MainProductProducts.UnitOfMeasure
		ELSE ScheduleOverridable.BillOfMaterials.MainProductPackage
	END AS Package,
	ScheduleOverridable.BillOfMaterials.MainProductNumberOfPackages * ScheduleOverridable.QuantityOfBatches AS Count,
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.OrderStructureCalculationJobsProductionSchedule AS JobsForCalculatingOverridable
		WHERE
			ScheduleOverridable.Stage REFS Document.ProductionStage2_2
			AND JobsForCalculatingOverridable.ProductionOrder = ScheduleOverridable.ProductionOrder
			AND JobsForCalculatingOverridable.ProductionStage = ScheduleOverridable.Stage
		
		UNION ALL
		
		SELECT TOP 1
			TRUE
		FROM
			InformationRegister.OrderStructureCalculationJobsProductionSchedule AS JobsForCalculatingOverridable
		WHERE
			ScheduleOverridable.Stage REFS Catalog.ProductionStages
			AND JobsForCalculatingOverridable.ProductionOrder = ScheduleOverridable.ProductionOrder
			AND JobsForCalculatingOverridable.KeyLot = ScheduleOverridable.KeyLot
			AND JobsForCalculatingOverridable.ProductionStage = ScheduleOverridable.Stage) AS RequiresPlanning,
	CASE
		WHEN ScheduleOverridable.Stage REFS Document.ProductionStage2_2
			AND CAST(ScheduleOverridable.Stage AS Document.ProductionStage2_2).StagePlacementInProductionSchedule
			THEN 1
		ELSE -1
	END AS ChartDateImageIndex,
	ScheduleOverridable.Order AS Order
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOverridable
WHERE
	ScheduleOverridable.ProductionOrder = &amp;ReferenceOrder
	AND ScheduleOverridable.ScheduleStatus = &amp;ScheduleStatus
	AND ScheduleOverridable.Stage &lt;> VALUE(Catalog.ProductionStages.EmptyRef)</queryText>
      <mainTable>InformationRegister.ScheduleOfProductionStages2_2</mainTable>
