    <id>31</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Stages.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	StagesOverridable.Ref AS Ref,
	StagesOverridable.Department AS Department,
	&amp;PresentationStage AS PresentationStage,

	ProductionScheduleOverridable.Begin AS Begin,
	ProductionScheduleOverridable.Ending AS Ending,
	
	CASE
		WHEN StagesOverridable.StagePlacementInProductionSchedule
			THEN 1
		ELSE -1
	END AS StartDateImageIndex,
	
	CASE
		WHEN StagesOverridable.StagePlacementInProductionSchedule
			THEN 1
		ELSE -1
	END AS EndDateImageIndex,

	ProductionScheduleOverridable.ItLimitsProductionDate AS DelaysTheOrder,
	
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.JobsToProductionScheduleCalculation AS JobsOverridable
		WHERE
			JobsOverridable.ReferenceOrder = StagesOverridable.ReferenceOrder
			AND JobsOverridable.ProductionStage = StagesOverridable.Ref) AS RequiresPlanning
FROM
	Document.ProductionStage2_2 AS StagesOverridable
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionScheduleOverridable
		ON StagesOverridable.Ref = ProductionScheduleOverridable.Stage
			AND (ProductionScheduleOverridable.ScheduleStatus = &amp;ScheduleStatus)
WHERE
	StagesOverridable.ReferenceOrder = &amp;ReferenceOrder
	AND StagesOverridable.Status IN(&amp;StageStatuses_2)
	AND StagesOverridable.Posted = TRUE</queryText>
      <mainTable>Document.ProductionStage2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
