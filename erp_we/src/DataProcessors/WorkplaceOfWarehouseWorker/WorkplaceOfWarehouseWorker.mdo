      <name>PrecisionOfBatchShelfLifeIndication</name>
      <synonym>
        <key>en</key>
        <value>Precision of batch shelf life specification</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>دقت تعیین ماندگاری بچ</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>La precisione dell'indicazione della scadenza della serie</value>
      </synonym>
      <synonym>
        <key>pl</key>
        <value>Dokładność wskazania terminu ważności serii</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Точность указания срока годности серии</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Partinin son kullanma tarihinin belirtilme duyarlılığı</value>
      </synonym>
      <synonym>
        <key>vi</key>
