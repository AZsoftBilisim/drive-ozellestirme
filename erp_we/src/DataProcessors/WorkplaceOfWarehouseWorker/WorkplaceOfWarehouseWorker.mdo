    <attributes uuid="fa429d4a-e9b6-4e7d-af2f-f262531aa2f9">
      <name>SpecifyNumberWhenRegisteringBatch</name>
      <synonym>
        <key>en</key>
        <value>Specify number when registering batch</value>
      </synonym>
      <synonym>
