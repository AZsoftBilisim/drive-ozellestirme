    <attributes uuid="bb7c470e-6143-4d0d-857f-e01b51051814">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity (Stock UOM)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار (واحد انبار)</value>
