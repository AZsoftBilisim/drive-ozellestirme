  <attributes>
    <name>SupplierPrices</name>
    <title>
      <key>en</key>
      <value>Vendor prices</value>
    </title>
    <title>
      <key>fa</key>
      <value>قیمت‌های تأمین‌کننده</value>
    </title>
    <title>
      <key>it</key>
      <value>Prezzi dei fornitori</value>
    </title>
    <title>
      <key>pl</key>
      <value>Cenniki dostawców</value>
    </title>
    <title>
      <key>ru</key>
      <value>Цены поставщиков</value>
    </title>
    <title>
      <key>tr</key>
      <value>Tedarikçi fiyatları</value>
    </title>
    <title>
      <key>vi</key>
      <value>Đơn giá nhà cung cấp</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	PricesOverridable.Partner AS Partner,
	PricesOverridable.VendorPriceKind AS PriceKind,
	PricesOverridable.Package AS Package,
	PricesOverridable.Price AS Price,
	PricesOverridable.Currency AS Currency,
	ISNULL(PricesOverridable.Price * PriceCurrencyOverridable.Rate * PriceCurrencyOverridable.Repetition, 0) / ISNULL(&amp;QueryTextPackagingFactor, 1) * &amp;PriceConversionFactor * CASE
		WHEN NOT PricesOverridable.VendorPriceKind.PriceIncludesVAT
			THEN &amp;VATRate_2
		ELSE 1
	END AS PriceManAccounting,
	DeliveryStatisticsOverridable.TotalDeliveries AS TotalDeliveries,
	DeliveryStatisticsOverridable.LastDelivery AS LastDelivery,
	PricesOverridable.Period AS Registered1,
	PurchaseConditionsSliceLast.OrderPackage AS OrderPackage,
	PurchaseConditionsSliceLast.MinimumDeliveryLot AS MinimumDeliveryLot,
	ISNULL(&amp;QueryTextPackagingFactor, 1) AS PackagingFactor
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast(
			&amp;PriceDate_,
			Products = &amp;Products
				AND Characteristic = &amp;Characteristic
				AND Partner.Vendor) AS PricesOverridable
		LEFT JOIN InformationRegister.ExchangeRates.SliceLast(&amp;PriceDate_, ) AS PriceCurrencyOverridable
		ON PricesOverridable.Currency = PriceCurrencyOverridable.Currency
		LEFT JOIN (SELECT
			InpaymentOverridable.Partner AS Partner,
			TabPartOverridable.VendorPriceKind AS PriceKind,
			MAX(InpaymentOverridable.Date) AS LastDelivery,
			COUNT(DISTINCT InpaymentOverridable.Ref) AS TotalDeliveries
		FROM
			Document.VendorInvoice AS InpaymentOverridable
				INNER JOIN Document.VendorInvoice.Goods AS TabPartOverridable
				ON InpaymentOverridable.Ref = TabPartOverridable.Ref
					AND (TabPartOverridable.Products = &amp;Products)
					AND (TabPartOverridable.Characteristic = &amp;Characteristic)
					AND (TabPartOverridable.Warehouse = &amp;Warehouse)
		WHERE
			InpaymentOverridable.Posted
		
		GROUP BY
			InpaymentOverridable.Partner,
			TabPartOverridable.VendorPriceKind) AS DeliveryStatisticsOverridable
		ON PricesOverridable.Partner = DeliveryStatisticsOverridable.Partner
			AND PricesOverridable.VendorPriceKind = DeliveryStatisticsOverridable.PriceKind
		LEFT JOIN InformationRegister.PurchaseConditions.SliceLast(
				&amp;PriceDate_,
				Products = &amp;Products
					AND Characteristic = &amp;Characteristic) AS PurchaseConditionsSliceLast
		ON PricesOverridable.Products = PurchaseConditionsSliceLast.Products
			AND PricesOverridable.Characteristic = PurchaseConditionsSliceLast.Characteristic
			AND PricesOverridable.VendorPriceKind = PurchaseConditionsSliceLast.VendorPriceKind</queryText>
      <mainTable>InformationRegister.ItemsPricesOfVendor.SliceLast</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
