		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentProducts.Products AS Products,
	SegmentProducts.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS SegmentProducts
{WHERE
	SegmentProducts.Segment.* AS ProductSegment,
	SegmentProducts.Products.*,
	SegmentProducts.Characteristic.*}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(PurchasePlansTurnovers.DayPeriod, DAY)
	END AS ReceiptPeriodEnd,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN PurchasePlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasePlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN PurchasePlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasePlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasePlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN PurchasePlansTurnovers.YearPeriod
		ELSE PurchasePlansTurnovers.DayPeriod
	END AS DateOfReceipt,
	PurchasePlansTurnovers.PurchasePlan AS PurchasePlan,
	PurchasePlansTurnovers.OrderDate AS OrderDate,
	PurchasePlansTurnovers.Department AS Department,
	CASE
		WHEN PurchasePlansTurnovers.Partner = VALUE(Catalog.Partners.EmptyRef)
			THEN ISNULL(CAST(Approaches.SourceOfDemandSupply AS Catalog.Partners), VALUE(Catalog.Partners.EmptyRef))
		ELSE PurchasePlansTurnovers.Partner
	END AS Partner,
	CASE
		WHEN PurchasePlansTurnovers.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
			THEN ISNULL(Approaches.Terms, VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))
		ELSE PurchasePlansTurnovers.Terms
	END AS Terms,
	PurchasePlansTurnovers.Partner AS PartnerPlan,
	PurchasePlansTurnovers.Terms AS AgreementPlan,
	PurchasePlansTurnovers.Products AS Products,
	PurchasePlansTurnovers.Characteristic AS Characteristic,
	PurchasePlansTurnovers.Purpose AS Purpose,
	PurchasePlansTurnovers.Warehouse AS Warehouse,
	SUM(PurchasePlansTurnovers.ToOrderTurnover) AS QuantityInPlans,
	CASE
		WHEN PurchasePlansTurnovers.ToOrderTurnover = 0
			THEN 0
		ELSE CAST(PurchasePlansTurnovers.SumTurnover / PurchasePlansTurnovers.ToOrderTurnover AS NUMBER(31,2))
	END AS PricePlan,
	ISNULL(Approaches.OrderFulfillmentPeriod, 0) AS DaysBeforeOrdering,
	CASE
		WHEN ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
			THEN MainEnterpriseCalendar.Value
		ELSE ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef))
	END AS Calendar
INTO TableOfPlans
FROM
	AccumulationRegister.PurchasePlans.Turnovers(
			&amp;BeginOfPeriod,
			&amp;PeriodEnding,
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND Products = &amp;Products
				AND Characteristic = &amp;Characteristic
				AND Purpose = &amp;Purpose
				AND Partner = &amp;Partner
				AND Warehouse = &amp;Warehouse
				AND Terms = &amp;Terms {(Department = &amp;Department), (Products).* AS Products, (Partner).* AS SupplierInPlan, (Terms).* AS AgreementInPlan, (Warehouse).* AS WarehouseInPlan, ((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS PurchasePlansTurnovers
		LEFT JOIN Catalog.ProcurementStrategies AS Approaches
		ON &amp;MainSupplyMethodSubstitution
			AND (Approaches.SupplyType = VALUE(Enum.SupplyTypes.Purchase))
			AND (CASE
				WHEN PurchasePlansTurnovers.Partner = VALUE(Catalog.Partners.EmptyRef)
					THEN TRUE
				WHEN PurchasePlansTurnovers.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
					THEN PurchasePlansTurnovers.Partner = Approaches.SourceOfDemandSupply
				ELSE PurchasePlansTurnovers.Partner = Approaches.SourceOfDemandSupply
						AND PurchasePlansTurnovers.Terms = Approaches.Terms
			END)
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON PurchasePlansTurnovers.Warehouse = Warehouses.Ref,
	Constant.MainEnterpriseCalendar AS MainEnterpriseCalendar

GROUP BY
	CASE
		WHEN PurchasePlansTurnovers.ToOrderTurnover = 0
			THEN 0
		ELSE CAST(PurchasePlansTurnovers.SumTurnover / PurchasePlansTurnovers.ToOrderTurnover AS NUMBER(31,2))
	END,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(PurchasePlansTurnovers.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(PurchasePlansTurnovers.DayPeriod, DAY)
	END,
	PurchasePlansTurnovers.OrderDate,
	CASE
		WHEN PurchasePlansTurnovers.Partner = VALUE(Catalog.Partners.EmptyRef)
			THEN ISNULL(CAST(Approaches.SourceOfDemandSupply AS Catalog.Partners), VALUE(Catalog.Partners.EmptyRef))
		ELSE PurchasePlansTurnovers.Partner
	END,
	PurchasePlansTurnovers.Terms,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN PurchasePlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasePlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN PurchasePlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasePlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasePlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN PurchasePlansTurnovers.YearPeriod
		ELSE PurchasePlansTurnovers.DayPeriod
	END,
	CASE
		WHEN PurchasePlansTurnovers.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
			THEN ISNULL(Approaches.Terms, VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))
		ELSE PurchasePlansTurnovers.Terms
	END,
	PurchasePlansTurnovers.PurchasePlan,
	PurchasePlansTurnovers.Department,
	PurchasePlansTurnovers.Products,
	PurchasePlansTurnovers.Characteristic,
	PurchasePlansTurnovers.Purpose,
	PurchasePlansTurnovers.Warehouse,
	PurchasePlansTurnovers.Partner,
	CASE
		WHEN ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
			THEN MainEnterpriseCalendar.Value
		ELSE ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef))
	END,
	ISNULL(Approaches.OrderFulfillmentPeriod, 0)

INDEX BY
	Products,
	Characteristic,
	DateOfReceipt,
	Purpose,
	Warehouse,
	PartnerPlan,
	AgreementPlan,
	Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	VALUE(Document.PurchaseRequest.EmptyRef) AS PurchaseRequest,
	DATETIME(1, 1, 1) AS DateOfReceipt,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef) AS Terms,
	0 AS Count
INTO PurchaseRequestsBalance
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.PurchasePlan AS PurchasePlan,
	TableOfPlans.ReceiptPeriodEnd AS ReceiptPeriodEnd,
	TableOfPlans.DateOfReceipt AS DateOfReceipt,
	TableOfPlans.OrderDate AS OrderDate,
	TableOfPlans.Department AS Department,
	TableOfPlans.Partner AS Partner,
	TableOfPlans.Terms AS Terms,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	TableOfPlans.Warehouse AS Warehouse,
	MAX(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	TableOfPlans.PricePlan AS PricePlan,
	MAX(TableOfPlans.DaysBeforeOrdering) AS DaysBeforeOrdering,
	TableOfPlans.Calendar AS Calendar,
	SUM(TableOfPlans.QuantityInOrders) AS QuantityInOrders,
	TableOfPlans.PurchaseOrder AS PurchaseOrder
INTO TablePlansOrders
FROM
	(SELECT
		TableOfPlans.PurchasePlan AS PurchasePlan,
		TableOfPlans.ReceiptPeriodEnd AS ReceiptPeriodEnd,
		TableOfPlans.DateOfReceipt AS DateOfReceipt,
		TableOfPlans.OrderDate AS OrderDate,
		TableOfPlans.Department AS Department,
		TableOfPlans.Partner AS Partner,
		TableOfPlans.Terms AS Terms,
		TableOfPlans.Products AS Products,
		TableOfPlans.Characteristic AS Characteristic,
		TableOfPlans.Purpose AS Purpose,
		TableOfPlans.Warehouse AS Warehouse,
		TableOfPlans.QuantityInPlans AS QuantityInPlans,
		TableOfPlans.PricePlan AS PricePlan,
		TableOfPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
		TableOfPlans.Calendar AS Calendar,
		ISNULL(PurchaseOrderGoods.Count, 0) AS QuantityInOrders,
		PurchaseOrderGoods.Ref AS PurchaseOrder
	FROM
		TableOfPlans AS TableOfPlans
			LEFT JOIN Document.PurchaseOrder.Goods AS PurchaseOrderGoods
			ON (PurchaseOrderGoods.DateOfReceipt BETWEEN TableOfPlans.DateOfReceipt AND TableOfPlans.ReceiptPeriodEnd)
				AND TableOfPlans.Products = PurchaseOrderGoods.Products
				AND (PurchaseOrderGoods.Ref.Posted)
				AND (NOT PurchaseOrderGoods.Canceled)
				AND TableOfPlans.Characteristic = PurchaseOrderGoods.Characteristic
				AND (CASE
					WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.Warehouse = PurchaseOrderGoods.Warehouse
				END)
				AND (CASE
					WHEN NOT &amp;PlanningByAssignments
						THEN TRUE
					ELSE TableOfPlans.Purpose = PurchaseOrderGoods.Purpose
				END)
				AND (CASE
					WHEN TableOfPlans.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.Department = PurchaseOrderGoods.Ref.Department
				END)
				AND (CASE
					WHEN TableOfPlans.PartnerPlan = VALUE(Catalog.Partners.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.PartnerPlan = PurchaseOrderGoods.Ref.Partner
				END)
				AND (CASE
					WHEN TableOfPlans.AgreementPlan = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.Terms = PurchaseOrderGoods.Ref.Terms
				END)
	
	UNION ALL
	
	SELECT
		TableOfPlans.PurchasePlan AS PurchasePlan,
		TableOfPlans.ReceiptPeriodEnd,
		TableOfPlans.DateOfReceipt,
		TableOfPlans.OrderDate,
		TableOfPlans.Department,
		TableOfPlans.Partner,
		TableOfPlans.Terms,
		TableOfPlans.Products,
		TableOfPlans.Characteristic,
		TableOfPlans.Purpose,
		TableOfPlans.Warehouse,
		TableOfPlans.QuantityInPlans,
		TableOfPlans.PricePlan,
		TableOfPlans.DaysBeforeOrdering,
		TableOfPlans.Calendar,
		ISNULL(PurchaseRequestsBalance.Count, 0),
		PurchaseRequestsBalance.PurchaseRequest
	FROM
		TableOfPlans AS TableOfPlans
			LEFT JOIN PurchaseRequestsBalance AS PurchaseRequestsBalance
			ON (PurchaseRequestsBalance.DateOfReceipt BETWEEN TableOfPlans.DateOfReceipt AND TableOfPlans.ReceiptPeriodEnd)
				AND TableOfPlans.Products = PurchaseRequestsBalance.Products
				AND TableOfPlans.Characteristic = PurchaseRequestsBalance.Characteristic
				AND (CASE
					WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.Warehouse = PurchaseRequestsBalance.Warehouse
				END)
				AND (CASE
					WHEN NOT &amp;PlanningByAssignments
						THEN TRUE
					ELSE TableOfPlans.Purpose = PurchaseRequestsBalance.Purpose
				END)
				AND (CASE
					WHEN TableOfPlans.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.Department = PurchaseRequestsBalance.Department
				END)
				AND (CASE
					WHEN TableOfPlans.PartnerPlan = VALUE(Catalog.Partners.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.PartnerPlan = PurchaseRequestsBalance.Partner
				END)
				AND (CASE
					WHEN TableOfPlans.AgreementPlan = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
						THEN TRUE
					ELSE TableOfPlans.Terms = PurchaseRequestsBalance.Terms
				END)) AS TableOfPlans

GROUP BY
	TableOfPlans.PurchasePlan,
	TableOfPlans.Calendar,
	TableOfPlans.ReceiptPeriodEnd,
	TableOfPlans.DateOfReceipt,
	TableOfPlans.Characteristic,
	TableOfPlans.Warehouse,
	TableOfPlans.Terms,
	TableOfPlans.Department,
	TableOfPlans.OrderDate,
	TableOfPlans.Partner,
	TableOfPlans.Purpose,
	TableOfPlans.Products,
	TableOfPlans.PricePlan,
	TableOfPlans.PurchaseOrder
;

////////////////////////////////////////////////////////////////////////////////
DROP TableOfPlans
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfPlans.Partner AS Partner,
	MAX(TermsOfPurchaseFromVendors.Ref) AS Terms
INTO DefaultConventions
FROM
	TablePlansOrders AS TableOfPlans
		INNER JOIN Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
		ON TableOfPlans.Partner = TermsOfPurchaseFromVendors.Partner
			AND (NOT TermsOfPurchaseFromVendors.DeletionMark)
			AND (TermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid))
WHERE
	TableOfPlans.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
	AND TableOfPlans.Partner &lt;&gt; VALUE(Catalog.Partners.EmptyRef)

GROUP BY
	TableOfPlans.Partner

HAVING
	SUM(1) = 1

INDEX BY
	Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.Calendar AS Calendar,
	CalendarSchedules.Year AS Year,
	MAX(CalendarSchedules.DaysCountInScheduleSinceBegOfYear) AS DaysCountInScheduleSinceBegOfYear
INTO ChartsNumberOfDaysInPastYear
FROM
	TablePlansOrders AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS CalendarSchedules
		ON TableOfPlans.Calendar = CalendarSchedules.Calendar
			AND (YEAR(TableOfPlans.DateOfReceipt) - 1 = CalendarSchedules.Year)
WHERE
	CalendarSchedules.Year &gt; 0

GROUP BY
	TableOfPlans.Calendar,
	CalendarSchedules.Year

INDEX BY
	Calendar,
	Year,
	DaysCountInScheduleSinceBegOfYear
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MAX(TableOfPlans.ReceiptPeriodEnd) AS ReceiptPeriodEnd,
	MAX(TableOfPlans.DateOfReceipt) AS DateOfReceipt,
	TableOfPlans.PurchasePlan AS PurchasePlan,
	TableOfPlans.Department AS Department,
	TableOfPlans.Partner AS Partner,
	CASE
		WHEN TableOfPlans.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
			THEN ISNULL(DefaultConventions.Terms, VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))
		ELSE TableOfPlans.Terms
	END AS Terms,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	TableOfPlans.Warehouse AS Warehouse,
	SUM(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	TableOfPlans.PricePlan AS PricePlan,
	SUM(TableOfPlans.QuantityInOrders) AS QuantityInOrders,
	MAX(CASE
			WHEN TableOfPlans.OrderDate IS NULL
				THEN DATEADD(TableOfPlans.DateOfReceipt, DAY, -TableOfPlans.DaysBeforeOrdering)
			ELSE TableOfPlans.OrderDate
		END) AS OrderDate,
	TableOfPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	TableOfPlans.PurchaseOrder AS PurchaseOrder
INTO TableOfPlansWithOrderDates
FROM
	TablePlansOrders AS TableOfPlans
		LEFT JOIN DefaultConventions AS DefaultConventions
		ON TableOfPlans.Partner = DefaultConventions.Partner
			AND (TableOfPlans.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleDateOfReceipt
		ON TableOfPlans.Calendar = ScheduleDateOfReceipt.Calendar
			AND (YEAR(TableOfPlans.DateOfReceipt) = ScheduleDateOfReceipt.Year)
			AND TableOfPlans.DateOfReceipt = ScheduleDateOfReceipt.ScheduleDate
		LEFT JOIN ChartsNumberOfDaysInPastYear AS ChartsLastYear
		ON TableOfPlans.Calendar = ChartsLastYear.Calendar
			AND (YEAR(TableOfPlans.DateOfReceipt) - 1 = ChartsLastYear.Year)
			AND (CASE
				WHEN NOT ScheduleDateOfReceipt.ScheduleDate IS NULL
						AND (ISNULL(ScheduleDateOfReceipt.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleDateOfReceipt.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN TRUE
				ELSE FALSE
			END)
WHERE
	CASE
			WHEN &amp;OrderStartDate = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE TableOfPlans.OrderDate &gt;= &amp;OrderStartDate
		END
	AND CASE
			WHEN &amp;OrderEndDate = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE TableOfPlans.OrderDate &lt;= &amp;OrderEndDate
		END
{WHERE
	TableOfPlans.Partner.* AS Vendor,
	TableOfPlans.Warehouse.* AS Warehouse}

GROUP BY
	TableOfPlans.PurchasePlan,
	TableOfPlans.PricePlan,
	TableOfPlans.DaysBeforeOrdering,
	TableOfPlans.Warehouse,
	TableOfPlans.Purpose,
	TableOfPlans.Characteristic,
	TableOfPlans.Products,
	CASE
		WHEN TableOfPlans.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
			THEN ISNULL(DefaultConventions.Terms, VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))
		ELSE TableOfPlans.Terms
	END,
	TableOfPlans.Partner,
	TableOfPlans.Department,
	TableOfPlans.PurchaseOrder

INDEX BY
	Terms,
	Products,
	Characteristic,
	Purpose
;

////////////////////////////////////////////////////////////////////////////////
DROP TablePlansOrders
;

////////////////////////////////////////////////////////////////////////////////
DROP DefaultConventions
;

////////////////////////////////////////////////////////////////////////////////
DROP ChartsNumberOfDaysInPastYear
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfPlans.Department AS Department,
	TableOfPlans.Partner AS Partner,
	TableOfPlans.Terms AS Terms,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	CASE
		WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
			THEN ISNULL(TermsOfPurchaseFromVendors.Warehouse, VALUE(Catalog.Warehouses.EmptyRef))
		ELSE TableOfPlans.Warehouse
	END AS Warehouse,
	CatProducts.Code AS Code,
	CatProducts.SKU AS SKU,
	TableOfPlans.DateOfReceipt AS DateOfReceipt,
	TableOfPlans.ReceiptPeriodEnd AS ReceiptPeriodEnd,
	TableOfPlans.QuantityInPlans AS QuantityInPlans,
	TableOfPlans.QuantityInOrders AS QuantityInOrders,
	TableOfPlans.QuantityInPlans - TableOfPlans.QuantityInOrders AS NumberOfPackages,
	TableOfPlans.QuantityInPlans - TableOfPlans.QuantityInOrders AS Count,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
				OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
				OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
			THEN TRUE
		ELSE FALSE
	END AS ItemVariantsAreUsed,
	TableOfPlans.OrderDate AS OrderDate,
	TableOfPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	&amp;QueryTextItemWeight AS Weight,
	&amp;QueryTextItemWeight * (TableOfPlans.QuantityInPlans - TableOfPlans.QuantityInOrders) AS TotalWeight,
	CatProducts.ItemsType AS ItemsType,
	ISNULL(TermsOfPurchaseFromVendors.Currency, CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Currency) AS Currency,
	ISNULL(PurchasePlans.Organization, TermsOfPurchaseFromVendors.Organization) AS Organization,
	CASE
		WHEN TableOfPlans.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS EditBusinessUnit,
	TableOfPlans.PurchaseOrder AS PurchaseOrder
INTO SecuredPlans
{SELECT
	Products.*,
	Characteristic.*,
	Purpose.*,
	SKU,
	DateOfReceipt,
	ReceiptPeriodEnd,
	QuantityInPlans,
	QuantityInOrders,
	NumberOfPackages,
	ItemVariantsAreUsed,
	Partner.*,
	Terms.*,
	OrderDate,
	DaysBeforeOrdering,
	Weight,
	TotalWeight,
	Warehouse.*,
	ItemsType.*,
	Department.*}
FROM
	TableOfPlansWithOrderDates AS TableOfPlans
		INNER JOIN Catalog.Products AS CatProducts
		ON TableOfPlans.Products = CatProducts.Ref
		LEFT JOIN Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors	
		ON TableOfPlans.Terms = TermsOfPurchaseFromVendors.Ref
		LEFT JOIN Document.PurchasePlan AS PurchasePlans
		ON TableOfPlans.PurchasePlan = PurchasePlans.Ref
{WHERE
	CatProducts.ItemsType.*,
	TableOfPlans.Terms.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlans.Department AS Department,
	SecuredPlans.Partner AS Partner,
	SecuredPlans.Terms AS Terms,
	SecuredPlans.Products AS Products,
	SecuredPlans.Characteristic AS Characteristic,
	SecuredPlans.Purpose AS Purpose,
	SecuredPlans.Warehouse AS Warehouse,
	SecuredPlans.Code AS Code,
	SecuredPlans.SKU AS SKU,
	SecuredPlans.DateOfReceipt AS DateOfReceipt,
	SecuredPlans.ReceiptPeriodEnd AS ReceiptPeriodEnd,
	SecuredPlans.QuantityInPlans AS QuantityInPlans,
	SecuredPlans.QuantityInOrders AS QuantityInOrders,
	SecuredPlans.NumberOfPackages AS NumberOfPackages,
	SecuredPlans.Count AS Count,
	SecuredPlans.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	SecuredPlans.OrderDate AS OrderDate,
	SecuredPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	SecuredPlans.Weight AS Weight,
	SecuredPlans.TotalWeight AS TotalWeight,
	SecuredPlans.ItemsType AS ItemsType,
	SecuredPlans.Currency AS Currency,
	SecuredPlans.Organization AS Organization,
	SecuredPlans.EditBusinessUnit AS EditBusinessUnit,
	SecuredPlans.PurchaseOrder AS PurchaseOrder
INTO SecuredPlansWithDeductionForOtherUnits
FROM
	SecuredPlans AS SecuredPlans

UNION ALL

SELECT
	VALUE(Catalog.BusinessStructure.EmptyRef),
	SecuredPlans.Partner,
	SecuredPlans.Terms,
	SecuredPlans.Products,
	SecuredPlans.Characteristic,
	SecuredPlans.Purpose,
	SecuredPlans.Warehouse,
	SecuredPlans.Code,
	SecuredPlans.SKU,
	SecuredPlans.DateOfReceipt,
	SecuredPlans.ReceiptPeriodEnd,
	0,
	-SecuredPlans.QuantityInOrders,
	SecuredPlans.QuantityInOrders,
	SecuredPlans.QuantityInOrders,
	SecuredPlans.ItemVariantsAreUsed,
	SecuredPlans.OrderDate,
	SecuredPlans.DaysBeforeOrdering,
	SecuredPlans.Weight,
	SecuredPlans.TotalWeight,
	SecuredPlans.ItemsType,
	SecuredPlans.Currency,
	SecuredPlans.Organization,
	TRUE,
	SecuredPlans.PurchaseOrder
FROM
	SecuredPlans AS SecuredPlans
WHERE
	SecuredPlans.Department &lt;&gt; VALUE(Catalog.BusinessStructure.EmptyRef)
	AND SecuredPlans.QuantityInOrders &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlansWithDeductionForOtherUnits.Department AS Department,
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInOrders) AS Count,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder AS Document,
	VALUETYPE(SecuredPlansWithDeductionForOtherUnits.PurchaseOrder) AS DocumentType,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.PointInTime AS PointInTime,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Date AS DocumentDate,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Number AS DocumentNumber,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Partner AS Partner,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Terms AS Terms
FROM
	SecuredPlansWithDeductionForOtherUnits AS SecuredPlansWithDeductionForOtherUnits,
	ReplacementTextForUsingIntermediateGroupingFields AS TextForUsingIntermediateDimensionFields

GROUP BY
	SecuredPlansWithDeductionForOtherUnits.Department,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.PointInTime,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Date,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Number,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Partner,
	SecuredPlansWithDeductionForOtherUnits.PurchaseOrder.Terms

HAVING
	SUM(SecuredPlansWithDeductionForOtherUnits.QuantityInOrders) &gt; 0</query>
	</dataSet>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
