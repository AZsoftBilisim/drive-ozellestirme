            <key>en</key>
            <value>Revalue currency</value>
          </title>
          <title>
            <key>fa</key>
            <value>تجدید ارزیابی ارز</value>
          </title>
          <title>
            <key>it</key>
            <value>Rivalutazione fondi valutari</value>
          </title>
          <title>
            <key>pl</key>
            <value>Przeliczaj wartość środków walutowych</value>
          </title>
          <title>
            <key>ru</key>
            <value>Переоценивать валютные средства</value>
          </title>
          <title>
            <key>tr</key>
            <value>Döviz kaynaklarını yeniden değerlendir</value>
          </title>
          <title>
            <key>vi</key>
            <value>Đánh giá lại các khoản có gốc ngoại tệ</value>
          </title>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
          <dataPath xsi:type="form:DataPath">
