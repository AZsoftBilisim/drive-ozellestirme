            <title>
              <key>ru</key>
              <value>Договоры кредитов и депозитов</value>
            </title>
            <title>
              <key>tr</key>
              <value>Kredi ve mevduat sözleşmeleri</value>
            </title>
            <title>
              <key>vi</key>
              <value>Hợp đồng tín dụng và tiền gửi</value>
            </title>
            <visible>true</visible>
            <enabled>true</enabled>
