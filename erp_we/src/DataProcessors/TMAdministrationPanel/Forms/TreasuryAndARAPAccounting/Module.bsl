&AtClient
Procedure NewCalculationArchitectureEnablingNotification(Result, AdditionalParameters) Export
	
	If Result = Undefined Then
		Return;
	EndIf;
	
	If Result.Status = "Error" Then
		ModeOfDistributionOfARAPAccountsIsOnline = False;
		StandardSubsystemsClient.OutputErrorInfo(Result.ErrorInfo);
		Return;
	EndIf;
	
	If Result.Status = "Canceled" Then
		ModeOfDistributionOfARAPAccountsIsOnline = False;
	EndIf;
	
	If Result.Status = "Completed2" Then
		DistributionCompleted();
	EndIf;
	
EndProcedure

&AtClient
Procedure DistributionCompleted()
	
	Result = FillCalculationRegistersOnServer();
	
	IdleParameters = TimeConsumingOperationsClient.IdleParameters(ThisObject);
	CallbackOnCompletion = New CallbackDescription("CheckCompletionOfNotificationTask", ThisObject);
	
	TimeConsumingOperationsClient.WaitCompletion(Result, CallbackOnCompletion, IdleParameters);
	
EndProcedure

&AtClient
Procedure CheckCompletionOfNotificationTask(Result, AdditionalParameters) Export
	
	If Result = Undefined Then
		Return;
	EndIf;
	
	If Result.Status = "Error" Then
		
		ConstantsSet.NewOnlineARAPAccounting = False;
		ModeOfDistributionOfARAPAccountsIsOnline = False;
		SetAvailability();
		StandardSubsystemsClient.OutputErrorInfo(Result.ErrorInfo);
		Return;
		
	EndIf;
	
	If Result.Status = "Completed2" Then
		ConstantsSet.NewOnlineARAPAccounting = ModeOfDistributionOfARAPAccountsIsOnline;
		SaveAttributeValue("ConstantsSet.NewOnlineARAPAccounting");
		SetAvailability();
	EndIf;
	
EndProcedure

