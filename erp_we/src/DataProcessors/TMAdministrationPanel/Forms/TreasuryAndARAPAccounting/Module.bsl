&AtClientAtServerNoContext
Function ValueForSelectingLimitUsageOption(ConstantsSet)
	
	Value = "";
	If ConstantsSet.UseCashFlowLimits Then
		Value = "LimitsDocument";
	ElsIf ConstantsSet.UseBudgetingCashFlowLimits Then
		If ConstantsSet.ControllingLimitsBasedOnBudgetingData2_4 Then
			Value = "Limits_Budgeting2_4";
		Else
			Value = "Limits_Budgeting";
		EndIf;
	EndIf;
	
	Return Value;
EndFunction

// Looking for organizations that include discounting of accounts payable
// 
// Returns:
//  Array of CatalogRef.Companies - found organizations
&AtServerNoContext
Function OrganizationsThatUseDiscounting()
	
	Result = New Array;
	
	Query = New Query;
	Query.Text = "
	|SELECT DISTINCT
	|	FinancialAccountingPolicySliceLast.Organization
	|FROM
	|	InformationRegister.FinancialAccountingPolicy.SliceLast AS FinancialAccountingPolicySliceLast
	|WHERE
	|	FinancialAccountingPolicySliceLast.AccountingForDiscountedAccountsPayableToVendors";
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		Result.Add(Selection.Organization);
	EndDo;
	
	Return Result;
	
EndFunction

// Checks for the presence of the document Debt adjustment with the flag This is a deduction
// 
// Returns:
//  Boolean - True, if such documents are in the database
&AtServer
Function ThereIsAccrualOfDebtByAdjustment()
	
	Query = New Query;
	Query.Text = 
	"SELECT TOP 1
	|	ARAPAdjustment.Ref
	|FROM
	|	Document.ARAPAdjustment AS ARAPAdjustment
	|WHERE
	|	ARAPAdjustment.ThisIsAccrual";
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		Return True;
	EndIf;
	
	Return False;
	
EndFunction

