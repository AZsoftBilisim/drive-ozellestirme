	EndIf;
	If DataPathAttribute = "ConstantsSet.UseSeveralDebtClassifications" Or DataPathAttribute = "" Then
		
		If ConstantsSet.UseSeveralDebtClassifications Then
			Items.GroupClassificationOfDebtsLaw.CurrentPage = Items.TheGroupClassificationOfDebtTheRightSeveralOptions;
		Else
			Items.GroupClassificationOfDebtsLaw.CurrentPage = Items.GroupDebtClassificationRightOneOption;
		EndIf;

	EndIf;
	
	DataExchangeTMERP.SetAvailabilityOfInformationBaseNodeSettings(ThisObject);
