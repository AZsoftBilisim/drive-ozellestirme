#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
		If DataPathAttribute = "UseCashPaymentJournal" Then
			ConstantName = "UseCashPaymentJournal";
			ConstantsSet.UseCashPaymentJournal = Boolean(UseCashPaymentJournal);
		EndIf;
		
		If DataPathAttribute = "RevalueCurrencyByDays" Then
			ConstantName = "RevalueCurrencyByDays";
			ConstantsSet.RevalueCurrencyByDays = Boolean(RevalueCurrencyByDays);
		EndIf;
		
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisObject.Read();
		EndIf;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UsePaymentRequests" Then
		UseCashPaymentJournal = Number(ConstantsSet.UseCashPaymentJournal);
	EndIf;
	
	If DataPathAttribute = "TheOptionOfUsingLimits" Then
		If TheOptionOfUsingLimits = "" Then
			ConstantManager = Constants["UseCashFlowLimits"];
			ConstantManager.Set(False);
			ConstantManager = Constants["UseCashFlowLimitsByCompanies"];
			ConstantManager.Set(False);
			ConstantManager = Constants["UseCashFlowLimitsByBusinessUnit"];
			ConstantManager.Set(False);
			ConstantManager = Constants["ControlExcessOfCashFlowLimits"];
			ConstantManager.Set(False);
			ConstantManager = Constants["UseBudgetingCashFlowLimits"];
			ConstantManager.Set(False);
			ConstantManager = Constants["ControllingLimitsBasedOnBudgetingData2_4"];
			ConstantManager.Set(False);
		ElsIf TheOptionOfUsingLimits = "LimitsDocument" Then 
			ConstantManager = Constants["UseCashFlowLimits"];
			ConstantManager.Set(True);
			ConstantManager = Constants["ControlExcessOfCashFlowLimits"];
			ConstantManager.Set(True);
			ConstantManager = Constants["UseBudgetingCashFlowLimits"];
			ConstantManager.Set(False);
			ConstantManager = Constants["ControllingLimitsBasedOnBudgetingData2_4"];
			ConstantManager.Set(False);
		ElsIf TheOptionOfUsingLimits = "Limits_Budgeting"
			Or TheOptionOfUsingLimits = "Limits_Budgeting2_4" Then 
			ConstantManager = Constants["UseCashFlowLimits"];
			ConstantManager.Set(False);
			ConstantManager = Constants["UseCashFlowLimitsByCompanies"];
			ConstantManager.Set(False);
			ConstantManager = Constants["UseCashFlowLimitsByBusinessUnit"];
			ConstantManager.Set(False);
			ConstantManager = Constants["ControlExcessOfCashFlowLimits"];
			ConstantManager.Set(False);
			ConstantManager = Constants["UseBudgetingCashFlowLimits"];
			ConstantManager.Set(True);
			ConstantManager = Constants["ControllingLimitsBasedOnBudgetingData2_4"];
			If TheOptionOfUsingLimits = "Limits_Budgeting" And ConstantManager.Get() Then
				ConstantName = "ControllingLimitsBasedOnBudgetingData2_4";
			ElsIf TheOptionOfUsingLimits = "Limits_Budgeting2_4" And Not ConstantManager.Get() Then
				ConstantName = "ControllingLimitsBasedOnBudgetingData2_4";
			EndIf;
			ConstantManager.Set(TheOptionOfUsingLimits = "Limits_Budgeting2_4");
		EndIf;
		ThisObject.Read();
	EndIf;
	
	SystemSettingsLocalization.SaveValueOfProps_ProductSettings(ConstantName, ConstantValue, ThisObject);
	
	Return ConstantName
	
EndFunction

