&AtClient
Procedure Attachable_OnChangeAttribute(Item, ShouldRefreshInterface = True, ExternalUpdate = False)
	
	If Not ExternalUpdate Then
		SystemSettingsClientLocalization.WhenChangingBankingDetails_Treasury(
			Item,
			ThisObject);
	EndIf;
	
	ConstantName = OnChangeAttributeServer(Item.Name);
	
	If ConstantName = "ControllingLimitsBasedOnBudgetingData2_4" Then
		
		AdditionalParameters = New Structure(?(TheOptionOfUsingLimits = "Limits_Budgeting", "ControllingLimitsBasedOnBudgetingData2_5", "ControllingLimitsBasedOnBudgetingData2_4"));
		ConstantName = "";
		Result = SetOptionToControlLimitsBasedOnBudgetingData(UUID, AdditionalParameters);
		
		If Result.Status = "Running" Then
		
			ParametersFormOfLongTermOperationOfOperation = FormParametersOfOperation();
			ParametersFormOfLongTermOperationOfOperation.ResultAddress = Result.ResultAddress;
			ParametersFormOfLongTermOperationOfOperation.JobID = Result.JobID;
			
			ClosingNotification1 = New CallbackDescription("OptionForControllingBudgetingLimitsHasBeenSet", ThisObject);
			
			OpenForm("CommonForm.TimeConsumingOperation", ParametersFormOfLongTermOperationOfOperation, ThisObject, , , , ClosingNotification1);
			
		Else
			
			OptionForControllingBudgetingLimitsHasBeenSet(Result, Undefined);
			
		EndIf;
		
	EndIf;
	
	If ShouldRefreshInterface Then
		RefreshInterface = True;
		AttachIdleHandler("RefreshApplicationInterface", 2, True);
	EndIf;
	
	If ConstantName <> "" Then
		Notify("Write_ConstantsSet", New Structure, ConstantName);
	ElsIf Item.Name = "TheOptionOfUsingLimits" Then
		Notify("OptionForUsingBDDLimitsHasBeenChanged");
	EndIf;
	
EndProcedure

