			And InfobaseUpdate.ObjectProcessed("VendorsARAPAccounting").Processed
			And InfobaseUpdate.ObjectProcessed("CustomersARAPAccountingByDocuments").Processed
			And InfobaseUpdate.ObjectProcessed("VendorsARAPAccountingByDocuments").Processed;
			
