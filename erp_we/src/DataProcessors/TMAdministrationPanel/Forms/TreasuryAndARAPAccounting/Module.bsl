									|en = 'Cannot switch to offline AR/AP accounting as the discounting of payables in companies is enabled:'; fa = 'Cannot switch to offline AR/AP accounting as the discounting of payables in companies is enabled:';
									|it = 'Il passaggio ai Conti reciproci offline non è disponibile, poiché è attivato lo sconto dei conti passivi nelle aziende:';
									|pl = 'Przejście na rozliczenia wzajemne offline jest niemożliwe, ponieważ jest włączone dyskontowanie zobowiązań w firmach:';
									|tr = 'İş yerlerinde borç hesaplarının iskonto edilmesi etkinleştirildiğinden, çevrimdışı alacak/borç muhasebesine geçiş mümkün değildir:'");
				CommentText1 = CommentText1 + " " + StrConcat(OrganizationsThatUseDiscounting.UnloadValues(), ", ") + ".";
			EndIf;
			
			If ThereIsAccrualOfDebt Then
				TurningOffNewArchitectureIsAvailable = False;
			EndIf;
			
		EndIf;
		
		EnablingNewArchitectureIsAvailable = UpdatedCalculationRegisters And TasksForTransferringCalculations.Count() = 0;
		Items.NewOnlineARAPAccounting.Enabled = EnablingNewArchitectureIsAvailable And TurningOffNewArchitectureIsAvailable;
		Items.CommentOnUseOfDiscounting.Title = CommentText1;
		Items.GroupCommentOnUseOfDiscounting.Visible = ThereIsDiscounting;
		Items.GroupCommentOnUseOfAccrualsInAdjustments.Visible = ThereIsAccrualOfDebt;
		
		CommentText1 = NStr("vi = 'Chưa kết thúc cập nhật hoãn lại biểu ghi hạch toán công nợ.';
							|ru = 'Не закончено отложенное обновление регистров взаиморасчетов.';
							|en = 'Deferred updating of settlements registers is not completed.'; fa = 'Deferred updating of settlements registers is not completed.';
							|it = 'L''aggiornamento rinviato dei registri di pagamenti reciproci non è completato.';
							|pl = 'Nie zakończono odroczonej aktualizacji rejestrów rozliczeń wzajemnych.';
							|tr = 'Alacak/borç muhasebesi kayıtlarının ertelenmiş güncellemesi tamamlanmadı.'");
		If TasksForTransferringCalculations.Count() > 0 Then
			CommentText1 = NStr("vi = 'Đang chuyển dữ liệu hạch toán công nợ sang cấu trúc mới.';
								|ru = 'Выполняется перенос данных взаиморасчетов на новую архитектуру.';
								|en = 'AR/AP data transfer to new architecture in progress.'; fa = 'AR/AP data transfer to new architecture in progress.';
								|it = 'È il corso il trasferimento dei dati di regolamenti reciproci alla nuova architettura.';
								|pl = 'Trwa przenoszenie danych rozliczeń wzajemnych na nową architekturę.';
								|tr = 'Alacak/borç muhasebesi verileri yeni şekle taşınıyor.'");
		EndIf;
		Items.CommentOnTheTransitionToTheNewArchitecture.Title = CommentText1;
		Items.GroupCommentMigrationToNewArchitecture.Visible = Not EnablingNewArchitectureIsAvailable;
		
		Items.GroupTransitionToNewArchitecture.Visible = Not ConstantsSet.NewOnlineARAPAccounting;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.InternationalBankAccountDetails" Or DataPathAttribute = "" Then
		Items.GroupPaymentsInForeignCurrency.Enabled = ConstantsSet.InternationalBankAccountDetails;
	EndIf;
		
	Items.OffsetOrderOfPaymentsAndInvoices.Enabled = ModeOfDistributionOfARAPAccountsIsOnline;
	If DataPathAttribute = "PrintingModeOfExpenseReport" Or DataPathAttribute = "" Then
