								|pl = 'By budgeting data 2.5';
								|tr = 'Bütçeleme verilerine göre 2.5'");
	Else
		ValuePresentation = NStr("vi = 'Theo dữ liệu quản lý ngân sách';
								|ru = 'По данным бюджетирования';
								|en = 'By budgeting data'; fa = 'By budgeting data';
								|it = 'Per dati del budgeting';
								|pl = 'Zgodnie z budżetowaniem';
								|tr = 'Bütçe verilerine göre'");
	EndIf;
	ListItem = ChoiceList.FindByValue(SelectionValue);
	If UseBudgeting And ListItem = Undefined Then
		ChoiceList.Add(SelectionValue, ValuePresentation);
	ElsIf Not UseBudgeting And Not ListItem = Undefined Then
		ChoiceList.Delete(ListItem);
	ElsIf Not ListItem = Undefined Then
		ListItem.Presentation = ValuePresentation;
	EndIf;
	
	SelectionValue = "Limits_Budgeting2_4";
	ListItem = ChoiceList.FindByValue(SelectionValue);
	ValuePresentation = NStr("vi = 'Theo dữ liệu lập ngân sách 2.4';
							|ru = 'По данным бюджетирования 2.4';
							|en = 'By budgeting data 2.4'; fa = 'By budgeting data 2.4';
							|it = 'By budgeting data 2.4';
							|pl = 'By budgeting data 2.4';
							|tr = 'Bütçeleme verilerine göre 2.4'");
	If Use2_4BudgetingLimits And ListItem = Undefined Then
		ChoiceList.Add(SelectionValue, ValuePresentation);
	ElsIf Not Use2_4BudgetingLimits And Not ListItem = Undefined Then
		ChoiceList.Delete(ListItem);
	EndIf;
EndProcedure

