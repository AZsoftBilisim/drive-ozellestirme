&AtServer
Function OfflineSettlementsWereUsed()
	
	Query = New Query;
	Query.Text = "
	|SELECT TOP 1
	|1 AS Field
	|FROM AccumulationRegister.CustomersARAPAccountingByDocuments AS CustomersARAPAccountingByDocuments
	|
	|UNION ALL
	|
	|SELECT TOP 1
	|1 AS Field
	|FROM AccumulationRegister.VendorsARAPAccountingByDocuments AS VendorsARAPAccountingByDocuments
	|
	|UNION ALL
	|
	|SELECT TOP 1
	|1 AS Field
	|FROM InformationRegister.JobsForAllocatingCustomersARAP AS JobsForAllocatingCustomersARAP
	|
	|UNION ALL
	|
	|SELECT TOP 1
	|1 AS Field
	|FROM InformationRegister.JobsForAllocatingVendorsARAP AS JobsForAllocatingVendorsARAP";
	Result = Query.Execute();
	
	Return Not Result.IsEmpty();
	
EndFunction

