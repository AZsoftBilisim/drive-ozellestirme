&AtClient
Procedure NewCalculationArchitectureInclusionCompletion(QuestionResult, AdditionalParameters) Export
	If QuestionResult = DialogReturnCode.Yes Then
		Result = StartDistributionWithBackgroundJob();
		
		IdleParameters = TimeConsumingOperationsClient.IdleParameters(ThisObject);
		CallbackOnCompletion = New CallbackDescription("NewCalculationArchitectureEnablingNotification", ThisObject);
		
		TimeConsumingOperationsClient.WaitCompletion(Result, CallbackOnCompletion, IdleParameters);

	Else
		ModeOfDistributionOfARAPAccountsIsOnline = False;
	EndIf;
EndProcedure

&AtClient
Procedure ControlIssueOfCashByPurposesCompletion(QuestionResult, AdditionalParameters) Export
	
	If QuestionResult = DialogReturnCode.Yes Then
		Result = StartCleaningUpCashDeliveryGoalsForBackgroundTaskReport();
		
		IdleParameters = TimeConsumingOperationsClient.IdleParameters(ThisObject);
		CallbackOnCompletion = New CallbackDescription("MonitorIssuanceOfReportByGoalsNotification", ThisObject);
		
		TimeConsumingOperationsClient.WaitCompletion(Result, CallbackOnCompletion, IdleParameters);

	Else
		ConstantsSet.ControlIssueOfCashByPurposes = True;
		SaveAttributeValue("ConstantsSet.ControlIssueOfCashByPurposes");
	EndIf;
	
EndProcedure

&AtClient
Procedure MonitorIssuanceOfReportByGoalsNotification(Result, AdditionalParameters) Export
	
	If Result = Undefined Then
		Return;
	EndIf;
	
	If Result.Status = "Error" Then
		ConstantsSet.ControlIssueOfCashByPurposes = True;
		SaveAttributeValue("ConstantsSet.ControlIssueOfCashByPurposes");
		StandardSubsystemsClient.OutputErrorInfo(Result.ErrorInfo);
		Return;
	EndIf;
	
	If Result.Status = "Canceled" Then
		ConstantsSet.ControlIssueOfCashByPurposes = False;
		SaveAttributeValue("ConstantsSet.ControlIssueOfCashByPurposes");
	EndIf;
	
	If Result.Status = "Completed2" Then
		ConstantsSet.ControlIssueOfCashByPurposes = False;
		SaveAttributeValue("ConstantsSet.ControlIssueOfCashByPurposes");
	EndIf;
	
EndProcedure

&AtServer
Function StartCleaningUpCashDeliveryGoalsForBackgroundTaskReport()
	
	ExportProcedureParameters = New Structure;
	ExecutionParameters = TimeConsumingOperations.BackgroundExecutionParameters(UUID);
	ExecutionParameters.BackgroundJobDescription =NStr("vi = 'Thực hiện xóa mục đích chi tiền tạm ứng';
														|ru = 'Выполняется очистка целей выдачи ДС под отчет';
														|en = 'Clearing purposes of issuing cash to advance holders'; fa = 'Clearing purposes of issuing cash to advance holders';
														|it = 'Выполняется очистка целей выдачи ДС под отчет';
														|pl = 'Clearing purposes of issuing cash to advance holders';
														|tr = 'Rapor vasıtasıyla nakit düzenlenme hedefleri netleştiriliyor'");
	
	Result = TimeConsumingOperations.ExecuteInBackground(
		"AccumulationRegisters.AdvanceHolderCash.ClearPurposeOfIssuingFundsToAccountable",
		ExportProcedureParameters,
		ExecutionParameters);
	
	Return Result;
	
EndFunction

