		Items.UseMultipleCashAccounts.Enabled = Not ConstantsSet.UseMultipleCompanies;
		
		If TheOptionOfUsingLimits = "" Then
			Items.GroupUseLimitsOnCashFlowByOrganization.Visible = False;
			Items.GroupUseCashFlowLimitsByBusinessUnit.Visible = False;
			Items.TheGroupControlsTheExcessOfCashFlowLimits.Visible = False;
