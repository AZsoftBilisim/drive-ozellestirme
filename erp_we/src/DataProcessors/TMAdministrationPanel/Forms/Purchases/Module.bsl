		Items.GroupReviewToUseTheEventOfUnbilledDeliveries.Visible = 
			Not ValueOfConstantBatchAccountingVersion22;
		Items.CommentUseUninvoicedDeliveries.Visible =
			Not ValueOfConstantBatchAccountingVersion22;
		Items.CommentUseNonInvoicedDeliveriesByInventoryType.Visible =
			ValueOfConstantBatchAccountingVersion22;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseCustodyDuringPurchase"
		Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseCustodyDuringPurchase;
		
		Items.ActsOfDiscrepanciesAfterAcceptanceForAcceptanceOfGoodsForStorage.Visible = ConstantValue;
		UsingAgencyProcurement = Constants.ProvideAgentServicesOnPurchaseToPrincipals.Get();
		Items.UseCustodyDuringPurchase.Enabled = Not UsingAgencyProcurement;
		Items.GroupCommentUseSafekeeping.Visible = UsingAgencyProcurement;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseNonConformanceCertificatesFollowingAcceptance"
		Or DataPathAttribute = "" Then
	
		ConstantValue = ConstantsSet.UseNonConformanceCertificatesFollowingAcceptance;
	
		Items.ReportsOfDiscrepanciesAfterAcceptanceOfRefunds.Enabled = ConstantValue;
		Items.ActsOfDiscrepanciesAfterAcceptanceForAcceptanceOfGoodsForStorage.Enabled = ConstantValue;
		Items.ReportsOfDiscrepanciesAfterAcceptanceByReceipts.Enabled = ConstantValue;
		Items.ActsOfDiscrepanciesAfterAcceptanceOnReceiptOfGoodsFromCustodian.Enabled = ConstantValue;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseVendorRebates"
	 Or DataPathAttribute = "ConstantsSet.DisplayFullNamesOfVendorRebates"
	 Or DataPathAttribute = "ConstantsSet.UseApprovalOfVendorRebateWriteOffs"
	 Or DataPathAttribute = "" Then
		
		#Region Availability_UseSuppliersRebates
		AvailabilityOfInclusionOfRebates = True;
		AvailabilityOfDisablingRebates = True;
		InclusionElements = New Array; // Array of String
		InclusionElements.Add(Items.GroupUseVendorSRebatesWarningInclusion.Name);
		
		If Not ConstantsSet.UsePartnersAndCounterparties Then
			
			AvailabilityOfInclusionOfRebates = False;
			InclusionElements.Add(Items.CommentUseVendorRebatesIndependentPartners.Name);
			
		EndIf;
		
		Items.UseVendorRebates.Enabled =
			(AvailabilityOfInclusionOfRebates
			 And AvailabilityOfDisablingRebates);
		
		TMCommonUseClientServer.SetPropertyOfFormElements(
			Items,
			InclusionElements,
			"Visible",
			Not AvailabilityOfInclusionOfRebates);
		#EndRegion
		
		#Region Availability_DisplayFullNamesOfRebatesOfSuppliers
		Items.DisplayFullNamesOfVendorRebates.Enabled =
			(AvailabilityOfInclusionOfRebates
			 And ConstantsSet.UseVendorRebates);
		#EndRegion
		
		#Region Availability_UseCoordinationOfDebitsRebatesOfSuppliers
		Items.UseApprovalOfVendorRebateWriteOffs.Enabled =
			(AvailabilityOfInclusionOfRebates
			 And ConstantsSet.UseVendorRebates);
		#EndRegion
		
	EndIf;
	
	If DataPathAttribute = "" Then
	
		ConstantValue = Constants.UseTransferToCustodyWithRightOfSale.Get();
		
		Items.ActsOfDiscrepanciesAfterAcceptanceOnReceiptOfGoodsFromCustodian.Visible = ConstantValue;
		
	EndIf;
	
	DataExchangeTMERP.SetAvailabilityOfInformationBaseNodeSettings(ThisForm);
	WarningOnEditRepresentation(DataPathAttribute);
	
	SystemSettingsLocalization.SetAvailability_Purchases(DataPathAttribute, ThisForm);
	
EndProcedure

&AtServer
Procedure WarningOnEditRepresentation(DataPathAttribute)
	
	StructureOfConstants = New Structure(
		"UsePurchaseOrderStatuses,
		|UseWarehousesInTabularSectionsOfPurchaseDocuments,
		|UseTermsOfPurchases");
	
	StructureOfConstants.Insert("UseCustodyDuringPurchase");
	
	SystemSettingsLocalization.DisplayingWarningWhenEditing_Purchases(StructureOfConstants);
	
	For Each KeyAndValue In StructureOfConstants Do
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items[KeyAndValue.Key],
			ConstantsSet[KeyAndValue.Key]);
	EndDo;
	
EndProcedure

