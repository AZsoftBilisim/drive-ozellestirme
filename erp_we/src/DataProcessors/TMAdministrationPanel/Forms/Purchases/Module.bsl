#Region ServerCall

&AtServer
Function OnChangeAttributeServer(TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	
	ConstantName = SaveAttributeValue(DataPathAttribute, New Structure);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

#EndRegion

#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute, Result)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
		If DataPathAttribute = "EnableVersioningOfPurchaseDocuments" Then
			ConstantsSet.UseObjectsVersioning = True;
			ConstantName = "UseObjectsVersioning";
		EndIf;

	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisForm.Read();
		EndIf;
		
	EndIf;
	
	If DataPathAttribute = "EnableVersioningOfPurchaseDocuments" Then
		
		ObjectsForVersioning = New Map;
		
		If ConstantsSet.UsePurchaseOrders Then
			ObjectsForVersioning.Insert("Document.PurchaseOrder", "VersionizeOnPost");
		EndIf;
		
		Result.Insert("VersioningIsEnabled",
			TMCommonUse.EnableObjectsVersioning(ObjectsForVersioning));
		SetAvailabilityOfVersioningPurchaseDocuments();
	EndIf;
		
	Return ConstantName
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	If DataPathAttribute = "ConstantsSet.UsePurchaseOrders" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UsePurchaseOrders;
		ThereAreExchangesWithFormationOfContractsForOrders =
			Constants.UseDataSynchronization.Get() And DataExchangeTMERP.ThereAreExchangesWithFormationOfContractsForOrders();
		
		Items.UseReceiptForMultipleOrders.Enabled 				= ConstantValue And Not ThereAreExchangesWithFormationOfContractsForOrders;
		Items.DoNotClosePurchaseOrdersBeforeAllGoodsAreReceived.Enabled 			= ConstantValue And ConstantsSet.UsePurchaseOrderStatuses;
		Items.DoNotClosePurchaseOrdersWithoutCompletePayment.Enabled				= ConstantValue And ConstantsSet.UsePurchaseOrderStatuses;
		Items.UsePurchaseOrderApproval.Enabled 				= ConstantValue And ConstantsSet.UsePurchaseOrderStatuses;
		Items.GroupCommentUseReceiptUnderSeveralOrders.Visible 	= ThereAreExchangesWithFormationOfContractsForOrders;
		Items.UsePurchaseOrderStatuses.Enabled                      = ConstantValue;
		Items.CommentGroupUsesStatusesOfOrdersToSuppliers.Visible       = Not ConstantValue;
		Items.UseReasonsForPurchaseOrderCancellations.Enabled                = ConstantValue;
		Items.CommentGroupToControlClosing.Visible                      = ConstantValue And Not ConstantsSet.UsePurchaseOrderStatuses;
				Items.GroupCommentManagementOfApprovalOfProcurementDocuments.Visible = ConstantValue And Not ConstantsSet.UsePurchaseOrderStatuses;
		Items.UsePurchaseRequests.Enabled                                = ConstantValue;
		Items.CommentGroupUsePurchaseRequests.Visible                 = Not ConstantValue;
		
		SetAvailabilityOfVersioningPurchaseDocuments();
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UsePurchaseOrderApproval" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UsePurchaseOrderApproval;
		
		Items.AssignThoseResponsibleForApprovingTheLogisticsConditionsOfThePurchaseDocuments.Enabled = ConstantValue;
		Items.AssignThoseResponsibleForApprovingTheFinancialTermsOfThePurchaseDocuments.Enabled    = ConstantValue;
		Items.AssignThoseResponsibleForApprovingThePriceConditionsOfPurchaseDocuments.Enabled       = ConstantValue;
		Items.AssignThoseResponsibleForApprovingCommercialTermsAndConditionsOfPurchaseDocuments.Enabled  = ConstantValue;
		
		SetAvailabilityOfVersioningPurchaseDocuments();
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UsePurchaseOrderStatuses" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UsePurchaseOrderStatuses;
		
		Items.UsePurchaseOrderApproval.Enabled                 = ConstantsSet.UsePurchaseOrders And ConstantValue;
		Items.DoNotClosePurchaseOrdersBeforeAllGoodsAreReceived.Enabled          = ConstantValue;
		Items.DoNotClosePurchaseOrdersWithoutCompletePayment.Enabled                = ConstantValue;
		Items.CommentGroupToControlClosing.Visible                      = ConstantsSet.UsePurchaseOrders And Not ConstantValue;
		Items.GroupCommentManagementOfApprovalOfProcurementDocuments.Visible    = ConstantsSet.UsePurchaseOrders And Not ConstantValue;
			
		SetAvailabilityOfVersioningPurchaseDocuments();
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseObjectsVersioning" Or DataPathAttribute = "" Then
		SetAvailabilityOfVersioningPurchaseDocuments();
	EndIf;

	If DataPathAttribute = "ConstantsSet.UseWarehousesInTabularSectionsOfPurchaseDocuments" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseSeveralWarehouses;
		
		Items.UseWarehousesInTabularSectionsOfPurchaseDocuments.Enabled = ConstantValue;
		Items.TheGroupCommentsUseWarehousesInTheTablePartOfPurchaseDocuments.Visible = Not ConstantValue;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseContractsWithVendors" Or DataPathAttribute = "" Then
		
		ValueOfResponseStorageConstant 				= ConstantsSet.UseCustodyDuringPurchase;
		ValueOfConstantGoodsInTransitFromSuppliers 	= ConstantsSet.UseGoodsInTransitFromVendors;
		ValueOfConstantOutstandingDeliveries 	= ConstantsSet.UseUninvoicedDeliveries;
		ValueOfConstantCurrencyPayments            = ConstantsSet.UseCurrencyPayments;
		ValueOfTransferToRecyclingConstant       = ConstantsSet.UseProductionByThirdParty2_5;
		ContractsWithSuppliersEditingAvailable = Not ValueOfResponseStorageConstant
													And Not ValueOfConstantGoodsInTransitFromSuppliers
													And Not ValueOfConstantOutstandingDeliveries
													And Not ValueOfConstantCurrencyPayments;
		ContractsWithSuppliersEditingAvailable = ContractsWithSuppliersEditingAvailable
													  And Not ValueOfTransferToRecyclingConstant;
		Items.UseContractsWithVendors.Enabled = ContractsWithSuppliersEditingAvailable;
		Items.TheSupplierAgreementsGroupCannotBeDisabled.Visible = Not ContractsWithSuppliersEditingAvailable;
		
		CommentText1 = NStr("vi = 'Không thể vô hiệu hóa hợp đồng với nhà cung cấp, bởi vì:';
							|ru = 'Невозможно отключение договоров с поставщиками, так как:';
							|en = 'Cannot disable contracts with vendors as:'; fa = 'غیرفعال‌سازی قراردادهای با تأمین‌کنندگان امکان‌پذیر نیست زیرا:';
							|it = 'Невозможно отключение договоров с поставщиками, так как:';
							|pl = 'Wyłączenie umów z dostawcami nie jest możliwe, ponieważ:';
							|tr = 'Sağlayıcılar ile olan sözleşmeleri devre dışı bırakmak mümkün değildir çünkü:'");
		
		CommentText1 = CommentText1
			+ ?(ValueOfResponseStorageConstant,
			Chars.LF + NStr("vi = '- đã bật tùy chọn ""Nhận bảo quản có quyền bán""';
							|ru = '— включена опция ""Приемка на ответственное хранение с правом продажи""';
							|en = '— VMI procurement is enabled'; fa = '— VMI procurement is enabled';
							|it = '— включена опция ""Приемка на ответственное хранение с правом продажи""';
							|pl = '- jest włączona opcja ""Przyjęcie do depozytu z prawem sprzedaży""';
							|tr = '— ""Satış yetkisi ile VMI tedariği"" seçeneği etkinleştirildi'"),
			"");
		
		CommentText1 = CommentText1
			+ ?(ValueOfConstantOutstandingDeliveries,
			Chars.LF + NStr("vi = '- đã bật tùy chọn ""Giao hàng không có hóa đơn""';
							|ru = '— включена опция ""Неотфактурованные поставки""';
							|en = '— the ""Goods received not invoiced"" option is enabled'; fa = '— the ""Goods received not invoiced"" option is enabled';
							|it = '— включена опция ""Неотфактурованные поставки""';
							|pl = '- jest włączona opcja ""Dostawy niezafakturowane""';
							|tr = '— ""Faturasız teslimat"" seçeneği etkinleştirildi'"),
			"");
		
		CommentText1 = CommentText1
			+ ?(ValueOfConstantGoodsInTransitFromSuppliers,
			Chars.LF + NStr("vi = '- đã bật tùy chọn ""Hàng đi đường""';
							|ru = '— включена опция ""Товары в пути""';
							|en = '— the ""Goods in transit"" option is enabled'; fa = '— the ""Goods in transit"" option is enabled';
							|it = '— включена опция ""Товары в пути""';
							|pl = '- jest włączona opcja ""Towary w drodze""';
							|tr = '— ""Transit mallar"" seçeneği etkinleştirildi'"),
