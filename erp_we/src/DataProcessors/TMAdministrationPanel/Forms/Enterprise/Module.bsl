		EndIf;
		
		Items.CommentUseCurrencies.Title = TrimAll(RestrictionText);
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseMultipleCurrencies, ConstantsSet.UseMultipleCurrencies);
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseTheDownloadOfECBExchangeRates" 
		Or Not ValueIsFilled(DataPathAttribute) Then

			Items.UseTheDownloadOfECBExchangeRates.Enabled = DownloadingECBExchangeRates;
			Items.TheGroupCanUseTheDownloadOfECBExchangeRates.Visible = Not DownloadingECBExchangeRates;
			
			Items.UseTheDownloadOfECBExchangeRates.ExtendedTooltip.Title =
			NStr("vi = 'Tỷ giá hối đoái được kết nhập từ Website Ngân hàng trung ương Châu Âu. Tiền tệ cơ sở là Euro (EUR).';
				|ru = 'Курсы валют загружаются с сайта Европейского Центрального Банка. Базовая валюта - Евро (EUR).';
				|en = 'Exchange rates are imported from the European Central Bank website. The base currency is euro (EUR).'; fa = 'Exchange rates are imported from the European Central Bank website. The base currency is euro (EUR).';
				|it = 'I tassi di cambio della valute vengono scaricati dal sito della Banca Centrale Europea. Valuta di riferimento - Euro (EUR).';
				|pl = 'Kursy walut są pobierane ze strony Europejskiego Banku Centralnego. Podstawowa waluta - Euro (EUR).';
				|tr = 'Döviz kurları Avrupa Merkez Bankası''nın internet sitesinden indirilmektedir. Temel para birimi - Euro (EUR).'");
			
			RestrictionText = "";
			If Not DownloadingECBExchangeRates Then
				RestrictionText = RestrictionText + NStr("vi = 'Có thể kết nhập, nếu trong danh mục ""Tiền tệ"" hiển thị tiền tệ Euro (EUR).';
														|ru = 'Загрузка доступна, если в справочнике ""Валюты"" заведена валюта Евро (EUR).';
														|en = 'Import is available if Euro (EUR) currency is created in the ""Currencies"" catalog.'; fa = 'Import is available if Euro (EUR) currency is created in the ""Currencies"" catalog.';
														|it = 'È possibile eseguire il download nel caso in cui nel catalogo ""Valute"" sia inserita la valuta Euro (EUR).';
														|pl = 'Pobieranie jest dostępne, jeśli jest do katalogu ""Waluty"" jest wprowadzona waluta Euro (EUR).';
														|tr = 'Euro (EUR) para birimi ""Para Birimleri"" kataloğuna girilirse indirilebilir.'");
			EndIf;
			
			Items.CommentUseTheDownloadOfECBExchangeRates.Title = TrimAll(RestrictionText);
			
