&AtServer
Procedure WarningOnEditRepresentation(DataPathAttribute)
	
	StructureOfConstants = New Structure();
	
	SystemSettingsLocalization.DisplayingWarningWhenEditing_Enterprise(StructureOfConstants);
	
	For Each KeyAndValue In StructureOfConstants Do
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items[KeyAndValue.Key],
			ConstantsSet[KeyAndValue.Key]);
	EndDo;
	
EndProcedure

&AtServer
Procedure UpdateCachedData()
	DownloadingECBExchangeRates = ValueIsFilled(Catalogs.Currencies.FindByCode("978"));;
	NumberOfCurrencies = Catalogs.Currencies.NumberOfCurrencies();
