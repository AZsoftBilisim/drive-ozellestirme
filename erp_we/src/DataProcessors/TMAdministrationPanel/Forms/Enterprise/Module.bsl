#Region ServerCall

&AtServer
Function OnChangeAttributeServer(TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	
	ConstantName = SaveAttributeValue(DataPathAttribute);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

#EndRegion

#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		If DataPathAttribute = "PresentationOfIncomingDocuments" Then
			ConstantName = "PresentationOfIncomingDocuments";
			ConstantsSet.PresentationOfIncomingDocuments = PresentationOfIncomingDocuments;
		EndIf;
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisForm.Read();
		EndIf;
		
	EndIf;
	
	SystemSettingsLocalization.SavePropsValue_Enterprise(ConstantName, ConstantValue, ThisForm);
	
	Return ConstantName
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	If DataPathAttribute = "ConstantsSet.ManagementAccountingCurrency" Or DataPathAttribute = "" Then
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.ManagementAccountingCurrency, ValueIsFilled(ConstantsSet.ManagementAccountingCurrency));
			
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.DefaultBaseCurrency" Or DataPathAttribute = "" Then
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.DefaultBaseCurrency, ValueIsFilled(ConstantsSet.DefaultBaseCurrency));
			
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.MainCountry" Or DataPathAttribute = "" Then
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.MainCountry, ValueIsFilled(ConstantsSet.MainCountry));
			
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseMultipleCurrencies" Or DataPathAttribute = "Catalog.Currencies"
	Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseMultipleCurrencies;
		
		If ConstantValue Then
			
			Items.CurrencyPageGroup.CurrentPage = Items.GroupOpenCurrencies;
			
		Else

			If NumberOfCurrencies = 1 Then
				Items.CurrencyPageGroup.CurrentPage = Items.CurrencyParametersGroup;
			ElsIf NumberOfCurrencies = 0 Then
				Items.CurrencyPageGroup.CurrentPage = Items.CreateCurrencyGroup;
			ElsIf NumberOfCurrencies > 1 Then
				Items.CurrencyPageGroup.CurrentPage = Items.GroupOpenCurrencies;
			EndIf;
			
		EndIf;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseMultipleCurrencies, ConstantValue);
		
		Items.ManagementAccountingCurrency.Enabled = ConstantValue
			Or Not ValueIsFilled(ConstantsSet.ManagementAccountingCurrency);
		Items.DefaultBaseCurrency.Enabled = ConstantValue
			Or Not ValueIsFilled(ConstantsSet.DefaultBaseCurrency);
		
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseMultipleCompanies" Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseMultipleCompanies;
		
		If ConstantValue Then
			Items.TheGroupPageIsToUseMultipleOrganizations.CurrentPage = Items.AGroupOfSeveralOrganizations;
		Else
			Items.TheGroupPageIsToUseMultipleOrganizations.CurrentPage = Items.GroupOneOrganization;
		EndIf;
		
		Items.UseManagementCompany.Enabled = ConstantValue;
		Items.MultiCountryAccounting.Enabled = ConstantValue;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseMultipleCompanies, ValueIsFilled(ConstantValue));
			
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseBusinessUnits" 
	 Or DataPathAttribute = "ConstantsSet.UseProductionByThirdParty2_5"
	 Or DataPathAttribute = "ConstantsSet.UseNonCurrentAssets2_2"
	 Or DataPathAttribute = "ConstantsSet.UseNonCurrentAssets2_4"
	 Or DataPathAttribute = "" Then
	 
	 	Disabled = 
		    ConstantsSet.UseBusinessUnits
			And (ConstantsSet.UseProduction
				Or ConstantsSet.UseProductionByThirdParty2_5
				Or ConstantsSet.UseNonCurrentAssets2_2
				Or ConstantsSet.UseNonCurrentAssets2_4
				Or ConstantsSet.UsePayroll
				Or False);
				
		Items.UseBusinessUnits.Enabled = Not Disabled;
		Items.GroupCommentUseDepartments.Visible = Disabled;
			
		// Description of the reasons for restrictions on the choice of modes.
		RestrictionText = "";
		If ConstantsSet.UseProductionByThirdParty2_5
			Or False Then
			RestrictionText = RestrictionText + "
			|- " + NStr("vi = 'sử dụng đặt gia công bên ngoài';
						|ru = 'используется переработка на стороне';
						|en = 'External subcontracting is used'; fa = 'External subcontracting is used';
						|it = 'viene utilizzata l''elaborazione esterna';
						|pl = 'stosowany jest przetwórstwo na stronie';
						|tr = 'fason üretim kullanılıyor'")
		EndIf;
		If ConstantsSet.UseProduction Then
			RestrictionText = RestrictionText + "
			|- " + NStr("vi = 'sử dụng sản xuất ';
						|ru = 'используется производство';
						|en = 'Manufacturing is used'; fa = 'تولید استفاده می‌شود';
						|it = 'viene utilizzata la produzione';
						|pl = 'używa się produkcja';
						|tr = 'üretim kullanılıyor'")
		EndIf;
		If ConstantsSet.UseNonCurrentAssets2_2
			Or ConstantsSet.UseNonCurrentAssets2_4 Then
			RestrictionText = RestrictionText + "
			|- " + NStr("vi = 'sử dụng kế toán tài sản dài hạn';
						|ru = 'используется учет внеоборотных активов';
						|en = 'Fixed asset accounting is used'; fa = 'Fixed asset accounting is used';
						|it = 'viene utilizzata la contabilità di attivi non circolanti';
						|pl = 'używa się ewidencja trwałych aktywów';
						|tr = 'duran varlıklar kullanılıyor'")
		EndIf;
		
		If ConstantsSet.UsePayroll Then
			RestrictionText = RestrictionText + "
			|- " + NStr("vi = 'sử dụng kế toán tiền lương và nhân sự';
						|ru = 'используется учет зарплаты и кадров';
						|en = 'Payroll accounting and HR recordkeeping is used'; fa = 'Payroll accounting and HR recordkeeping is used';
						|it = 'используется учет зарплаты и кадров';
						|pl = 'Payroll accounting and HR recordkeeping is used';
						|tr = 'bordro ve personel muhasebesi kullanılıyor'")
		EndIf;
		If ValueIsFilled(RestrictionText) Then
			RestrictionText = NStr("vi = 'Không thể tắt sử dụng bộ phận:';
									|ru = 'Невозможно отключение подразделений:';
									|en = 'Cannot disable business units:'; fa = 'Cannot disable business units:';
									|it = 'Impossibile disabilitare i reparti:';
									|pl = 'Niemożliwe jest wyłączenie działów:';
									|tr = 'Departmanlar devre dışı bırakılamıyor:'")
				+ RestrictionText;
		EndIf;
		
		If Items.GroupCommentUseDepartments.Visible Then
			Items.CommentUseDepartments.Title = TrimAll(RestrictionText);
		EndIf;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(Items.UseBusinessUnits, ConstantsSet.UseBusinessUnits);
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseMultipleCurrencies"
		Or Not ValueIsFilled(DataPathAttribute) Then
		
		ElementAvailability = Not ConstantsSet.UseCurrencyPayments;
		
		Items.UseMultipleCurrencies.Enabled = ElementAvailability;
		Items.CommentGroupUseCurrencies.Visible = Not ElementAvailability;
		
		RestrictionText = "";
		If Not ElementAvailability Then
			RestrictionText = RestrictionText + "
				|- " + NStr("vi = 'sử dụng thanh toán bằng ngoại tệ và kiểm soát ngoại tệ';
							|ru = 'используются платежи в валюте и валютный контроль';
							|en = 'Payments in currency and foreign exchange control are used'; fa = 'Payments in currency and foreign exchange control are used';
							|it = 'vengono utilizzati pagamenti in valuta estera e controllo valutario';
							|pl = 'są używane płatności w walucie i kontrola walutowa';
							|tr = 'döviz cinsinden ödemeler ve döviz kontrolü kullanılmaktadır'");
		EndIf;
		
		If ValueIsFilled(RestrictionText) Then
			RestrictionText = NStr("vi = 'Không thể vô hiệu hóa việc sử dụng nhiều loại tiền:';
									|ru = 'Невозможно отключение нескольких валют:';
									|en = 'Cannot disable several currencies:'; fa = 'Cannot disable several currencies:';
