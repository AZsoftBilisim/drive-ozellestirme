            <id>2464</id>
            <title>
              <key>en</key>
              <value>Display batches in print forms</value>
            </title>
            <title>
              <key>fa</key>
              <value>نمایش بچ‌ها در فرم‌های چاپی</value>
            </title>
            <title>
              <key>it</key>
              <value>Portare le serie in versione stampata</value>
            </title>
            <title>
              <key>pl</key>
              <value>Wyświetlaj serie w formularzach wydruku</value>
            </title>
            <title>
              <key>ru</key>
              <value>Выводить серии в печатных формах</value>
            </title>
            <title>
              <key>tr</key>
              <value>Partileri yazdırma formlarında çıkar</value>
            </title>
            <title>
              <key>vi</key>
              <value>Hiển thị sê-ri ở dạng có thể in được</value>
            </title>
            <visible>true</visible>
            <enabled>true</enabled>
            <userVisible>
              <common>true</common>
            </userVisible>
