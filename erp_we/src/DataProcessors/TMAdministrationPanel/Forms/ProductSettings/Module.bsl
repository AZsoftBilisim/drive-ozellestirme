#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			Read();
		EndIf;
		
		If ConstantName = "AllowableDeviationOfMeasuringGoodsShipmentAndReceiving" Then
			
			Constants.UseAllowableDeviationOfMeasuringGoodsShipmentReceiving.Set(ConstantValue > 0);
			If ConstantValue = 0 Then
				Constants.UseAutomaticClosingOfMeasuringGoodsOrderRows.Set(False);
				ConstantsSet.UseAutomaticClosingOfMeasuringGoodsOrderRows = False;
			EndIf;
			
		EndIf;
		
		If ConstantName = "UseNonUniqueItemBarcodes" Then
			
			If Catalogs.ItemKinds.ThereAreSetBarcodeUniquenessSettings(ConstantValue) Then
				ExecutionParameters = TimeConsumingOperations.BackgroundExecutionParameters(UUID);
				ExecutionParameters.RunInBackground = True;
				ExecutionParameters.WaitCompletion = 0;
				
				CalculationResult2 = TimeConsumingOperations.ExecuteProcedure(
									ExecutionParameters,
									"Catalogs.ItemKinds.SetDefaultBarcodeUniquenessSettings",
									ConstantValue);
				
				If CalculationResult2.Status = "Running" Then
					ResultOfUpdatingBarcodeUniquenessSettings = CalculationResult2;
				ElsIf CalculationResult2.Status = "Completed2" Then
					ResultOfUpdatingBarcodeUniquenessSettings = Undefined;
				EndIf;
			EndIf;
			
		EndIf;
		
	EndIf;
	
	SystemSettingsLocalization.SaveValueOfProps_ProductSettings(ConstantName, ConstantValue, ThisObject);
	
	Return ConstantName;
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	If DataPathAttribute = "ConstantsSet.UseItemPackages" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseItemPackages;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseItemPackages, ConstantValue);
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseItemVariants" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseItemVariants;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseItemVariants, ConstantValue);
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseItemsBatch" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseItemsBatch;
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseItemsBatch, ConstantsSet.UseItemsBatch);
		
		UseWarehouseManagementSystem = Constants.UseWarehouseManagementSystem.Get();
		Items.GroupCommentSeriesInAdvancedWarehouse.Visible = ConstantValue And Not UseWarehouseManagementSystem;
		
		Items.ThePanelToDisplayASeriesOfPrintedFormsOfIndent.Enabled = ConstantValue;
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseGoodsQuality" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseGoodsQuality;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseGoodsQuality, ConstantValue);
		Items.UseSummaryAccountingOfLowQualityGoods.Enabled = ConstantValue;
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseItemsSoldTogether" Or DataPathAttribute = "" Then
		Items.OpenSettingsOfProductsSoldTogether.Enabled = ConstantsSet.UseItemsSoldTogether;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseQualityCertificates" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseQualityCertificates;  
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseSets" 
		Or DataPathAttribute = "ConstantsSet.UseMultipleKindsOfProducts"
		Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseSets;
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseSets, ConstantValue);
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseMultipleKindsOfProducts" 
		Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseMultipleKindsOfProducts;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseMultipleKindsOfProducts, ConstantValue);
			
		Items.UseSets.Enabled = ConstantValue;
		Items.GroupCommentUseSeveralKinds.Visible =
			    ConstantsSet.UseProduction
			Or ConstantsSet.UseProductionByThirdParty2_5;
			
		Items.UseMultipleKindsOfProducts.Enabled =
			  Not ConstantsSet.UseProduction
			And Not ConstantsSet.UseProductionByThirdParty2_5;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving"
		Or DataPathAttribute = "" Then
		ConstantValue = Constants.UseAllowableDeviationOfMeasuringGoodsShipmentReceiving.Get();
		Items.UseAutomaticClosingOfMeasuringGoodsOrderRows.Enabled = ConstantValue;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseProductSegments" 
		Or DataPathAttribute = "" Then
		
		Items.ConfigureSegmentCleaning.Enabled = ConstantsSet.UseProductSegments;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseInformativeItemPrices" 
		Or DataPathAttribute = "" Then
		
		Items.GroupToUseInformativeOfTheItemPrice.Visible = False;
	
		
	EndIf;
	
	If Users.IsFullUser(, True) Then
		
		Items.UseFullTextSearchWhenSelectingGoods.Enabled = (ConstantsSet.UseFullTextSearch = 1);
		Items.CommentGroupUseFullTextSearchWhenSelectingProducts.Visible = Not Items.UseFullTextSearchWhenSelectingGoods.Enabled;
		
	Else
		
		Items.UseFullTextSearchWhenSelectingGoods.Visible = False;
		Items.CommentGroupUseFullTextSearchWhenSelectingProducts.Visible = False;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseExcisableGoods" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseExcisableGoods;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseExcises, ConstantValue);
		
	EndIf;
	
	DataExchangeTMERP.SetAvailabilityOfInformationBaseNodeSettings(ThisObject);
	
	SystemSettingsLocalization.SetAvailability_ProductSettings(DataPathAttribute, ThisObject);
	
	WarningOnEditRepresentation(DataPathAttribute);
	
EndProcedure

&AtServer
Procedure WarningOnEditRepresentation(DataPathAttribute)
	
	StructureOfConstants = New Structure("UseNonUniqueItemBarcodes");
	
	SystemSettingsLocalization.DisplayingWarningWhenEditing_ProductSettings(StructureOfConstants);
	
	For Each KeyAndValue In StructureOfConstants Do
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items[KeyAndValue.Key],
			ConstantsSet[KeyAndValue.Key]);
	EndDo;
	
EndProcedure

