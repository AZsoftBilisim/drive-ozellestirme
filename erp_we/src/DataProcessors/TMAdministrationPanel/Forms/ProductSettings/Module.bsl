&AtClient
Procedure ScheduledJobsHyperlinkClick(BankingDetailsPrefix)
	
	PropsNameID	= "";
	NameOfPropsSchedule		= "";
	
	If BankingDetailsPrefix = "SegmentClearance" Then
		PropsNameID	= "SegmentClearanceID";
		NameOfPropsSchedule		= "CleaningOfSegmentsOfTheSchedule";
	ElsIf BankingDetailsPrefix = "FillingInProductInformationPrices" Then
		PropsNameID	= "FillingInTheInformativePricesOfTheItemID";
		NameOfPropsSchedule		= "FillingInTheInformativePricesOfTheScheduleItem";
	Else
		Return;
	EndIf;
	
	ExecutionParameters = New Structure;
	ExecutionParameters.Insert("Id", ThisObject[PropsNameID]);
	ExecutionParameters.Insert("NameOfPropsSchedule", NameOfPropsSchedule);
	
	RoutineTasksChangeSchedule(ExecutionParameters);
	
EndProcedure

&AtClient
Procedure RoutineTasksChangeSchedule(ExecutionParameters)
	Handler = New CallbackDescription("ScheduledJobsAfterChangeSchedule", ThisObject, ExecutionParameters);
	Dialog = New ScheduledJobDialog(ThisObject[ExecutionParameters.NameOfPropsSchedule]);
	Dialog.Show(Handler);
EndProcedure

// Parameters:
// 	Schedule - JobSchedule
// 	ExecutionParameters - Structure:
//		* PropsNameUsage - String
//		* NameOfPropsSchedule - String
//		* Id - String
&AtClient
Procedure ScheduledJobsAfterChangeSchedule(Schedule, ExecutionParameters) Export
	
	If Schedule = Undefined Then
		If ExecutionParameters.Property("PropsNameUsage") Then
			ThisObject[ExecutionParameters.PropsNameUsage] = False;
		EndIf;
		Return;
	EndIf;
	
	ThisObject[ExecutionParameters.NameOfPropsSchedule] = Schedule;
	
	Changes = New Structure("Schedule", Schedule);
	If ExecutionParameters.Property("PropsNameUsage") Then
		ThisObject[ExecutionParameters.PropsNameUsage] = True;
		Changes.Insert("Use", True);
	EndIf;
	ScheduledJobsSave(ExecutionParameters.Id, Changes, ExecutionParameters.NameOfPropsSchedule);
	
EndProcedure

&AtServer
Procedure ScheduledJobsSave(Var_UUID, Changes, DataPathAttribute)
	ScheduledJob = ScheduledJobsServer.Job(Var_UUID);
	FillPropertyValues(ScheduledJob, Changes);
	ScheduledJob.Write();
	
	If DataPathAttribute <> Undefined Then
		SetAvailability(DataPathAttribute);
	EndIf;
EndProcedure

&AtServer
Function ScheduledJobsFindPredefinedItem(PredefinedItemName)
	PredefinedMetadata = Metadata.ScheduledJobs.Find(PredefinedItemName);
	If PredefinedMetadata = Undefined Then
		Return Undefined;
	Else
		Return ScheduledJobsServer.Job(PredefinedMetadata);
	EndIf;
EndFunction

