&AtClient
Procedure AttachableLongRunningNotificationHandlerOfOperation(ResultOfOperation, NameOfOfOperationResult)
	
	If ResultOfOperation <> Undefined Then
		NotificationParameters		= New Structure("NameOfOfOperationResult", NameOfOfOperationResult);
		CallbackOnCompletion	= New CallbackDescription("HandlerForLongRunningNotificationOfOperation",
															ThisObject,
															NotificationParameters);
		IdleParameters		= TimeConsumingOperationsClient.IdleParameters(ThisObject);
		
		TimeConsumingOperationsClient.WaitCompletion(ResultOfOperation, CallbackOnCompletion, IdleParameters);
	EndIf;
	
EndProcedure

&AtClient
Procedure HandlerForLongRunningNotificationOfOperation(Result, AdditionalParameters) Export
	
	If Result = Undefined Then
		Return;
	EndIf;
	
	If Result.Status = "Completed2" Then
		NameOfOfOperationResult		= AdditionalParameters.NameOfOfOperationResult;
		ResultOfOperation	= ThisObject[NameOfOfOperationResult];
		
		If ResultOfOperation = Undefined Then
			Return;
		EndIf;
		
		If NameOfOfOperationResult = "ResultOfUpdatingBarcodeUniquenessSettings" Then
			ResultOfOperation = Undefined;
		EndIf;
	EndIf;
	
EndProcedure

