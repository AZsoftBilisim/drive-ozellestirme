          <id>1756</id>
          <title>
            <key>en</key>
            <value>Customer segments</value>
          </title>
          <title>
            <key>fa</key>
            <value>بخش‌های مشتری</value>
          </title>
          <title>
            <key>it</key>
            <value>I segmenti dei clienti</value>
          </title>
          <title>
            <key>pl</key>
            <value>Segmenty klientów</value>
          </title>
          <title>
