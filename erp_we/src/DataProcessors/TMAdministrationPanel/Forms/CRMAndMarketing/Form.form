          <id>2448</id>
          <title>
            <key>en</key>
            <value>Retail formats</value>
          </title>
          <title>
            <key>fa</key>
            <value>قالب‌های خرده‌فروشی</value>
          </title>
          <title>
            <key>it</key>
            <value>Formati dei negozi</value>
          </title>
          <title>
            <key>pl</key>
            <value>Formaty sklepów</value>
          </title>
          <title>
