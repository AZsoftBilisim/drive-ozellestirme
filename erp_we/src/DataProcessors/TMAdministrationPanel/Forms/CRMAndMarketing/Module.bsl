#Region OtherItems

&AtServer
Procedure SetAvailabilityOfProductPriceVersioning()
	
	Items.EnableVersioningOfItemPriceSettings.Enabled =
		ConstantsSet.UseApprovalOfItemPrices
		And (Not ConstantsSet.UseObjectsVersioning
			Or Not TMCommonUse.UseObjectVersioning("Document.PriceSetup"));

EndProcedure

&AtServerNoContext
Function ThereAreInconsistentPriceSettings()
	
	SetPrivilegedMode(True);
	
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	PriceSetup.Ref
	|FROM
	|	Document.PriceSetup AS PriceSetup
	|WHERE
	|	PriceSetup.Status = VALUE(Enum.ProductPricingStatuses.NotApproved)";
	
	Return Not Query.Execute().IsEmpty();
	
EndFunction

&AtServerNoContext
Procedure SaveGeoMapToConstant(InternalCircuit, SchemaParameters)
	
	If InternalCircuit Then
		Name1 = ""; NameOfTemplate = "";
		If SchemaParameters.Property("Name1", Name1)
			And SchemaParameters.Property("NameOfTemplate", NameOfTemplate) Then
			GeoMapTemplate = GetCommonTemplate(NameOfTemplate);
			GeoDiagram = New GeographicalSchema;
			GeoDiagram.Put(GeoMapTemplate);
			SchemaStorageStructure = New Structure("Name1, GeoDiagram");
			SchemaStorageStructure.Insert("Name1", Name1);
			SchemaStorageStructure.Insert("GeoDiagram", GeoDiagram);
			Constants.GeographicDiagramForReports.Set(New ValueStorage(SchemaStorageStructure));
		Else
			Constants.GeographicDiagramForReports.Set(Undefined);
		EndIf;
	Else
		Name1 = ""; FullFileName = "";
		If SchemaParameters.Property("Name1", Name1)
			And SchemaParameters.Property("FullFileName", FullFileName) Then
				GeoDiagram = New GeographicalSchema;
				GeoDiagram.Read(FullFileName);
				SchemaStorageStructure = New Structure("Name1, GeoDiagram");
				SchemaStorageStructure.Insert("Name1", Name1);
				SchemaStorageStructure.Insert("GeoDiagram", GeoDiagram);
				Constants.GeographicDiagramForReports.Set(New ValueStorage(SchemaStorageStructure));
		Else
			Constants.GeographicDiagramForReports.Set(Undefined);
		EndIf;
	EndIf;
	
EndProcedure
&AtClientAtServerNoContext
Procedure AdjustPricingVersion(LineToChange)
	If TypeOf(LineToChange) = Type("FormattedString") Then
		AdjustPricingVersionOnServer(LineToChange);
	Else
		LineToChange = StrReplace(LineToChange, "11.", "2.");
	EndIf;
EndProcedure

&AtServerNoContext
Procedure AdjustPricingVersionOnServer(LineToChange)
	NextLineToChange = ValueToStringInternal(LineToChange);
	NextLineToChange = StrReplace(NextLineToChange, "11.", "2.");
	LineToChange = ValueFromStringInternal(NextLineToChange);
EndProcedure
