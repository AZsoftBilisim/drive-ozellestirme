#Region ServerCall

&AtServer
Function OnChangeAttributeServer(Val TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	
	ConstantName = SaveAttributeValue(DataPathAttribute, New Structure);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

#EndRegion

#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute, Result)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
		If DataPathAttribute = "EnableVersioningOfItemPriceSettings" Then
			ConstantsSet.UseObjectsVersioning = True;
			ConstantName = "UseObjectsVersioning";
		EndIf;
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisForm.Read();
		EndIf;
		
	EndIf;
	
	If ConstantName = "UseProductCategories"
		And Not ConstantsSet[ConstantName]
		And Constants.UseSalesPlansByCategories.Get() Then
		
		Constants.UseSalesPlansByCategories.Set(False);
		
	EndIf;
	
	If DataPathAttribute = "EnableVersioningOfItemPriceSettings" Then
		
		ObjectsForVersioning = New Map;
		ObjectsForVersioning.Insert("Document.PriceSetup", "VersionizeOnWrite");
		
		Result.Insert("VersioningIsEnabled",
			TMCommonUse.EnableObjectsVersioning(ObjectsForVersioning));
	
	EndIf;
		
	Return ConstantName;
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	// StandardSubsystems.Users
	If DataPathAttribute = "" Then
		Items.InfobasePublicationURL.Enabled = ConstantsSet.UseExternalUsers;
	EndIf;
	// End StandardSubsystems.Users
	
	If DataPathAttribute = "ConstantsSet.UseBusinessRegions" Or DataPathAttribute = "" Then
		
		Items.NameOfTheGeographicalMapForReports.Enabled = ConstantsSet.UseBusinessRegions;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseDiscountsMarkupsInSales" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseDiscountsMarkupsInSales;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseDiscountsMarkupsInSales, ConstantValue);
		
		Items.UseLoyaltyCards.Enabled   = ConstantValue;
		Items.UseBonusPrograms.Enabled = ConstantValue;
		
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseDiscountAdjustmentsInSales" Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseDiscountAdjustmentsInSales;
		
		ThereAreAgreementsWithCustomers = Constants.ToUseTermsOfSales.Get();
		
		Items.UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales.Enabled   = ConstantValue;
		Items.UseLimitsForDiscountAdjustmentsInSalesByUsers.Enabled = ConstantValue;
		Items.GroupUseRestrictionsOnManualDiscountsInSalesByAgreement.Visible = ThereAreAgreementsWithCustomers;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseDiscountAdjustmentsInSales, ConstantValue);
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales" Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales, ConstantValue);
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseLimitsForDiscountAdjustmentsInSalesByUsers" Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseLimitsForDiscountAdjustmentsInSalesByUsers;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseLimitsForDiscountAdjustmentsInSalesByUsers, ConstantValue);
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseApprovalOfItemPrices" Or DataPathAttribute = "" Then
		Items.AssignPersonsResponsibleForApprovalOfProductPrices.Enabled = ConstantsSet.UseApprovalOfItemPrices;
		SetAvailabilityOfProductPriceVersioning();
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseProductRange" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseProductRange;
		Items.UseCollectionManagement.Enabled = ConstantValue;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseObjectsVersioning" Or DataPathAttribute = "" Then
		SetAvailabilityOfProductPriceVersioning();
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseSeveralPriceTypes" Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseSeveralPriceTypes;
		If ConstantValue Then
			Items.TheGroupPageIsToUseMultipleTypesOfPrices.CurrentPage = Items.TheGroupPageIsToUseMultipleTypesOfPrices.ChildItems.GroupSeveralTypesOfPrices;
		Else
			Items.TheGroupPageIsToUseMultipleTypesOfPrices.CurrentPage = Items.TheGroupPageIsToUseMultipleTypesOfPrices.ChildItems.GroupOneTypeOfPrices;
		EndIf;

		Items.PricingSettingsGroup.Enabled = ConstantValue;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseSeveralPriceTypes, ConstantValue);
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseLoyaltyPrograms" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseLoyaltyPrograms;
		
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items.UseBonusPrograms, ConstantValue);
			
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UsePartnersSegments" Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UsePartnersSegments;
		UseShipmentProhibition = Constants.UseShipmentProhibition.Get();
		
		Items.GroupCommentPartnerSegments.Visible = ConstantValue And UseShipmentProhibition;
		Items.UsePartnersSegments.Enabled = Not UseShipmentProhibition;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UsePartnersSegments" 
		Or DataPathAttribute = "" Then
		
		Items.ConfigureSegmentCleaning.Enabled = ConstantsSet.UsePartnersSegments;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseSalesOpportunitiesToCustomer" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseSalesOpportunitiesToCustomer;
		
		Items.UseOpportunityManagement.Enabled	= ConstantValue;
		
		SetAvailability("ConstantsSet.UseOpportunityManagement");
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseOpportunityManagement"
		 Or DataPathAttribute = "ConstantsSet.UseSalesOpportunitiesToCustomer"
		 Or DataPathAttribute = "" Then
		Items.GroupCommentTypicalSale.Visible = 
			(ConstantsSet.UseOpportunityManagement And Not ConstantsSet.UseBusinessProcessesAndTasks);
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UsePriceManagementSystem25" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UsePriceManagementSystem25;
		
		If ConstantValue Then
			Items.PricingVersionSettingsGroup.Visible = False;
		Else
			Items.DecorationUsingPricingVersion25Completed.Visible = False;
			TransitionState = SettingPricesServer.StateOfTransitionToPricingVersion2_5();
			If TransitionState.State = Enums.JobsStates.Scheduled 
				Or TransitionState.State = Enums.JobsStates.Running Then
				Items.DecorationUsingPricingVersion25InProgress.Visible = True;
				Items.DecorationUsingPricingVersion25IsAvailable.Visible  = False;
				Items.OpenAssistantForSwitchingToNewPricing.Title = NStr("vi = 'Kiểm tra trạng thái chuyển đổi hiện tại';
																		|ru = 'Проверить текущее состояние перехода';
																		|en = 'Current migration state check'; fa = 'Current migration state check';
																		|it = 'Verificare lo stato corrente della transazione';
																		|pl = 'Sprawdź bieżący status przejścia';
																		|tr = 'Geçişin mevcut durumunu kontrol et'");
			Else	
				Items.DecorationUsingPricingVersion25InProgress.Visible = False;
				Items.DecorationUsingPricingVersion25IsAvailable.Visible  = True;
				Items.OpenAssistantForSwitchingToNewPricing.Title = NStr("vi = 'Bắt đầu chuyển đổi';
																		|ru = 'Начать переход';
																		|en = 'Start migration'; fa = 'شروع مهاجرت';
																		|it = 'Avviare transizione';
																		|pl = 'Zacznij przejście';
																		|tr = 'Transferi başlat'");
			EndIf;
		EndIf;
		
		PriceManagementSystemServerCall.SetPropertiesOfSceneryInformingAboutRemovalOfPricingVersion20(Items, False);
		AdjustPricingVersion(Items.DecorationUsingPricingVersion25IsAvailable.Title);
		AdjustPricingVersion(Items.DecorationUsingPricingVersion25InProgress.Title);
		AdjustPricingVersion(Items.DecorationUsingPricingVersion25Completed.Title);
		AdjustPricingVersion(Items.OpenAssistantForSwitchingToNewPricing.Title);
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseCustomerRebates"
	 Or DataPathAttribute = "ConstantsSet.DisplayFullNamesOfCustomerRebates"
	 Or DataPathAttribute = "ConstantsSet.UseApprovalOfCustomerRebatesWriteOffs"
	 Or DataPathAttribute = "ConstantsSet.UsePartnersAndCounterparties"
	 Or DataPathAttribute = "" Then
		
		#Region Enabled_UseCustomerRebates
		AvailabilityOfInclusionOfRebates = True;
		InclusionElements = New Array; // Array of String
		InclusionElements.Add(Items.GroupToUseCustomerRebatesWarningActivation.Name);
		
		If Not ConstantsSet.UsePartnersAndCounterparties Then
			
			AvailabilityOfInclusionOfRebates = False;
			InclusionElements.Add(Items.CommentUseCustomerRebatesIndependentPartners.Name);
			
		EndIf;
				
		Items.UseCustomerRebates.Enabled = AvailabilityOfInclusionOfRebates;
		
		TMCommonUseClientServer.SetPropertyOfFormElements(
			Items,
			InclusionElements,
			"Visible",
			Not AvailabilityOfInclusionOfRebates);
		#EndRegion
		
		#Region Availability_DisplayFullNamesOfRebatesForCustomers
		Items.DisplayFullNamesOfCustomerRebates.Enabled =
			(AvailabilityOfInclusionOfRebates
			 And ConstantsSet.UseCustomerRebates);
		#EndRegion
		
		#Region Enabled_UseApprovalOfCustomerRebatesWriteOffs
		Items.UseApprovalOfCustomerRebatesWriteOffs.Enabled =
			(AvailabilityOfInclusionOfRebates
			 And ConstantsSet.UseCustomerRebates);
		#EndRegion
		
		#Region Enabled_UsePartnersAndCounterparties
		AvailabilityPartnersCounterparties = True;
		NamesOfHiddenElements = New Array; // Array of String
		NamesOfHiddenElements.Add(Items.GroupUsePartnersAndCounterpartiesWarningShutdown.Name);
		
		If ConstantsSet.UseCustomerRebates Then
			
			AvailabilityPartnersCounterparties = False;
			NamesOfHiddenElements.Add(Items.CommentUsePartnersAndCounterpartiesCustomerRebates.Name);
			
		EndIf;
		
		Items.UsePartnersAndCounterparties.Enabled = AvailabilityPartnersCounterparties;
		
		TMCommonUseClientServer.SetPropertyOfFormElements(
			Items,
			NamesOfHiddenElements,
			"Visible",
			Not AvailabilityPartnersCounterparties);
		#EndRegion
		
	EndIf;
	
	DataExchangeTMERP.SetAvailabilityOfInformationBaseNodeSettings(ThisForm);
	
	WarningOnEditRepresentation(DataPathAttribute);
	
EndProcedure

&AtServer
Procedure WarningOnEditRepresentation(DataPathAttribute)
	
	StructureOfConstants = New Structure;
	StructureOfConstants.Insert("UsePartnersAndCounterparties");
	StructureOfConstants.Insert("UseCustomerRebates");
	StructureOfConstants.Insert("UseApprovalOfCustomerRebatesWriteOffs");
	
	For Each KeyAndValue In StructureOfConstants Do
		TMCommonUseClientServer.WarningOnEditRepresentation(
			Items[KeyAndValue.Key],
			ConstantsSet[KeyAndValue.Key]);
	EndDo;
	
EndProcedure

