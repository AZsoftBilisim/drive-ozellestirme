&AtServer
Function OnChangeAttributeServer(TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	
	ConstantName = SaveAttributeValue(DataPathAttribute);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

#EndRegion

#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		
		ConstantManager 		 = Constants[ConstantName];
		ConstantValue 		 = ConstantsSet[ConstantName];
		ConstantPastValue = ConstantManager.Get();
		
		If ConstantPastValue <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisForm.Read();
		EndIf;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.KeepRecordsOfInventoryCostByAssignments"
	 Or DataPathAttribute = "ConstantsSet.CostAccountingByAssignmentValidFrom" Then
	 
	    // If there are movements in the IB, then we will set the inclusion date for the current month; if there are no movements, then let the date remain empty.
		If ConstantsSet.KeepRecordsOfInventoryCostByAssignments
		 And Not ValueIsFilled(ConstantsSet.CostAccountingByAssignmentValidFrom)
		 And ValueIsFilled(CostRecordPeriod) Then
			ConstantsSet.CostAccountingByAssignmentValidFrom = BegOfMonth(CurrentSessionDate());
			SaveAttributeValue("ConstantsSet.CostAccountingByAssignmentValidFrom");
			
		ElsIf Not ConstantsSet.KeepRecordsOfInventoryCostByAssignments
		 And ValueIsFilled(ConstantsSet.CostAccountingByAssignmentValidFrom) Then
			ConstantsSet.CostAccountingByAssignmentValidFrom = Date(1,1,1);
			SaveAttributeValue("ConstantsSet.CostAccountingByAssignmentValidFrom");
		EndIf;
		BatchAccountingServer.PlanCostRecalculationWhenChangingCostAccountingForPurposes();
	EndIf;
	If DataPathAttribute = "TheOptionOfUsingLimits" Then
		If TheOptionOfUsingLimits = "" Then
			Constants.UseIEBLimitsOnPurchases.Set(False);
			Constants.UseIEBLimitsOnConsumption.Set(False);
		ElsIf TheOptionOfUsingLimits = "BudgetingLimits_WhenPurchasing" Then 
			Constants.UseIEBLimitsOnPurchases.Set(True);
			Constants.UseIEBLimitsOnConsumption.Set(False);
		ElsIf TheOptionOfUsingLimits = "BudgetingLimits_ForConsumption" Then 
			Constants.UseIEBLimitsOnPurchases.Set(False);
			Constants.UseIEBLimitsOnConsumption.Set(True);
		EndIf;
		Read();
	EndIf;
	SystemSettingsLocalization.Save_FinancialResult_AttributeValue(ConstantName, ConstantValue, ThisForm);
	
	Return ConstantName;
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	BatchAccountingVersion22 = CalculationOfCostCached.BatchAccountingVersion22();
	
	UseLocal = False;
	UseLocal = ConstantsSet.UseLocal;
	Items.GroupCommentUsingReglAccounting.Visible = UseLocal And ConstantsSet.UseAccountingOfOtherIncomeExpensesInLocalAccounting;
	Items.GroupFillingInAssetsLiabilities.Visible = ConstantsSet.UseBalanceSheetStatement And Not ConstantsSet.AssetLiabilityRecordsArePopulated;
	
	Items.TheGroupAccountsForTheCostOfGoodsByDestinationHorizontally.Enabled = ConstantsSet.UseOrderSupplyWithAssignment;
	Items.TooltipByAssignments.Visible = Not ConstantsSet.UseOrderSupplyWithAssignment; 
	
	UseMFPs = False;
	UseMFPs = ConstantsSet.UseFinancialAccounting;
	Items.GroupCommentIFAUse.Visible = UseMFPs;
	Items.GroupFinancialResultDetails.Enabled = Not UseMFPs;
	
	If DataPathAttribute = "ConstantsSet.UseAccountingOfOtherIncomeExpenses" Or DataPathAttribute = "" Then
		Items.GenerateFinancialResult.Enabled = ConstantsSet.UseAccountingOfOtherIncomeExpenses;
		Items.UseAccountingOfOtherIncomeExpensesInLocalAccounting.Enabled = ConstantsSet.UseAccountingOfOtherIncomeExpenses
			And (Not UseLocal Or Not ConstantsSet.UseAccountingOfOtherIncomeExpensesInLocalAccounting);
		Items.GenerateFutureExpenseCommitments.Enabled = ConstantsSet.UseAccountingOfOtherIncomeExpenses
			And BatchAccountingVersion22;
		Items.GroupMakesProvisionsForFutureExpenses.Visible = Not ConstantsSet.UseAccountingOfOtherIncomeExpenses
			Or Not BatchAccountingVersion22;	
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.UseAccountingOfOtherIncomeExpensesInLocalAccounting" Or DataPathAttribute = "" Then
		Items.UseAccountingOfOtherIncomeExpenses.Enabled = Not ConstantsSet.UseAccountingOfOtherIncomeExpenses
			Or Not (UseLocal And ConstantsSet.UseAccountingOfOtherIncomeExpensesInLocalAccounting);
	EndIf;	
	
	// The availability of the details depends on the version of the batch accounting.
	If DataPathAttribute = "ConstantsSet.UseCostAccounting"
	 Or DataPathAttribute = "ConstantsSet.CostAccountingStartDate"
	 Or DataPathAttribute = "ConstantsSet.UseSalesOpportunitiesToCustomer"
	 Or DataPathAttribute = "ConstantsSet.UseBusinessUnits"
	 Or DataPathAttribute = "" Then
		
		If ConstantsSet.UseCostAccounting
		 And DataPathAttribute = "ConstantsSet.UseCostAccounting"
		 And Not ValueIsFilled(ConstantsSet.CostAccountingStartDate)
		 And ValueIsFilled(CostRecordPeriod) Then
			ConstantsSet.CostAccountingStartDate = BegOfMonth(CurrentSessionDate());
			SaveAttributeValue("ConstantsSet.CostAccountingStartDate");
			
		ElsIf Not ConstantsSet.UseCostAccounting
		 And DataPathAttribute = "ConstantsSet.UseCostAccounting"
		 And ValueIsFilled(ConstantsSet.CostAccountingStartDate) Then
			ConstantsSet.CostAccountingStartDate = Date(1,1,1);
			SaveAttributeValue("ConstantsSet.CostAccountingStartDate");
		EndIf;
		
		Items.CostAccountingStartDate.Enabled = ConstantsSet.UseCostAccounting;
		Items.GroupCommentUseCostAccounting.Visible = False;
		
		Items.ClearUnusedRegisteredRecordsInCostRegisters.Visible =
			DataProcessors.ClearingPostingsWithDisabledCostAccounting.ThereAreUnusedRegisteredRecordsOnCostRegisters();
		
		Items.GroupAllocationOfAdditionalExpenses.Enabled = ConstantsSet.UseCostAccounting;
		Items.AGroupOfSeparateAccountingOfCosts.Enabled = ConstantsSet.UseCostAccounting;
				
		Items.AllocationOfAdditionalExpensesByDisposedGoods.Enabled = BatchAccountingVersion22;
		
		Items.DecorationCommentGenerateInventoryKindsByTransactions.Visible = Not ConstantsSet.UseSalesOpportunitiesToCustomer;	
		Items.DecorationFormTypesOfStocksForTransactions.Visible = Not ConstantsSet.UseSalesOpportunitiesToCustomer;
		Items.GenerateInventoryOwnerAttributesBySalesOpportunities.Enabled = ConstantsSet.UseSalesOpportunitiesToCustomer
			And BatchAccountingVersion22;
			
		Items.DecorationCommentByDepartmentsManagers.Visible = Not ConstantsSet.UseBusinessUnits;
		Items.DecorationByDivisionsManagers.Visible = Not ConstantsSet.UseBusinessUnits;
		Items.GenerateInventoryOwnerAttributesByBusinessUnitsAndManagers.Enabled = ConstantsSet.UseBusinessUnits
			And BatchAccountingVersion22;
		Items.AccualInventoryImpairmentProvision.Enabled = BatchAccountingVersion22;
		Items.GroupMakesProvisionsForImpairmentOfInventories.Visible = Not BatchAccountingVersion22;	
	EndIf;
		
	If DataPathAttribute = "ConstantsSet.KeepRecordsOfInventoryCostByAssignments"
	 Or DataPathAttribute = "" Then
		Items.CostAccountingByAssignmentValidFrom.Enabled = ConstantsSet.KeepRecordsOfInventoryCostByAssignments;
	EndIf;
	
	If DataPathAttribute = "" Then
		
		ConstantValue = False;
		ConstantValue = Constants.AnalyticalAccountingByProductsGroups.Get();
		Items.GroupFinancialResultTheRight.Enabled = Not ConstantValue;
		Items.GroupReviewToUseTheGroupSAnalyticalAccounting.Visible = ConstantValue;
		UpdateLabelOfDisableItemBalanceMonitoringButton(SessionParameters.PostWithoutControlOfCompanyStockBalance);
		
		TurningOffLineOfBusinessIsNotAvailable = False;
		TurningOffLineOfBusinessIsNotAvailable = ProductDataManagementCached.TypeOfDestinationParameterIsUsed(
					Enums.TypesOfBOMAssignmentParameters.LineOfBusiness, False)
				And Constants.GenerateFinancialResult.Get();
		Items.GroupFinancialResultLeft.Enabled = Not TurningOffLineOfBusinessIsNotAvailable;
		Items.GroupCommentUseFinancialResult.Visible = TurningOffLineOfBusinessIsNotAvailable;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseTargetValueMonitoring" Or DataPathAttribute = "" Then
		
		Items.RestoreSuppliedIndicatorModel.Enabled = ConstantsSet.UseTargetValueMonitoring;
		
	EndIf;
	
	If DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseMultipleCompanies;
		Items.UseCustomerInvoiceIntercompany.Enabled = ConstantValue;
	EndIf;
	If DataPathAttribute = "ConstantsSet.UseProductionManagement2_2"
		Or DataPathAttribute = "ConstantsSet.UseMultipleCompanies"
		Or DataPathAttribute = "" Then
		Items.UseInternalSubcontracting.Enabled =
			ConstantsSet.UseMultipleCompanies
			And ConstantsSet.UseProductionManagement2_2;
	EndIf;
	If DataPathAttribute = "ConstantsSet.UseCustomerInvoiceIntercompany"
		Or DataPathAttribute = "ConstantsSet.UseInternalSubcontracting"
		Or DataPathAttribute = "" Then
		
		MultipleCompanies = ConstantsSet.UseMultipleCompanies;
		TransfersBetweenOrganizations = ConstantsSet.UseCustomerInvoiceIntercompany;
		
		Items.UseIntercompanyContracts.Enabled =
			MultipleCompanies
				And (TransfersBetweenOrganizations
					Or ConstantsSet.UseInternalSubcontracting
					Or False);
		
	EndIf;
	
	If DataPathAttribute = "" Then
		
		NewOnlineARAPAccounting = Constants.NewOnlineARAPAccounting.Get();
		Items.UseDocumentCorrection.Enabled = 
			NewOnlineARAPAccounting;
		
		Items.GroupCommentUseCorrectionOfDocumentsMutualSettlements.Visible = Not NewOnlineARAPAccounting;
	EndIf;
	
	If DataPathAttribute = "" Then

		Items.GroupAccountingForCostObjects.Visible = False
			Or ConstantsSet.ComplexAutomation 
			Or ConstantsSet.EnterpriseManagement
		;

	EndIf;
	If DataPathAttribute = "ConstantsSet.UseFinancialDocumentVerification"
		Or DataPathAttribute = "" Then
		
		Items.GroupDocumentVerificationOption.Enabled = ConstantsSet.UseFinancialDocumentVerification;
		
	EndIf;
	
	If DataPathAttribute = "TheOptionOfUsingLimits"
		Or DataPathAttribute = "" Then
		Items.TheOptionOfUsingLimits.Enabled = Not GetFunctionalOption("ControllingLimitsBasedOnBudgetingData2_4");
		AddTextToExtendedHintForUsingLimits();
	EndIf;
	DataExchangeTMERP.SetAvailabilityOfInformationBaseNodeSettings(ThisForm);
	
	SystemSettingsLocalization.SetAvailability_FinancialResult(DataPathAttribute, ThisForm);
	
	WarningOnEditRepresentation(DataPathAttribute);
	
EndProcedure

