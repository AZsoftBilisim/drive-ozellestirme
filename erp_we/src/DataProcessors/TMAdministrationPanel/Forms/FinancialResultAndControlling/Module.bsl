&AtServer
Procedure SetListOfOptionsForUsingLimits()
	ChoiceList = Items.TheOptionOfUsingLimits.ChoiceList;
	
	SelectionValue = "";
	If ChoiceList.FindByValue(SelectionValue) = Undefined Then
		ValuePresentation = NStr("vi = 'Không sử dụng';
								|ru = 'Не используются';
								|en = 'Not used'; fa = 'استفاده نمی‌شود';
								|it = 'Non vengono utilizzati';
								|pl = 'Nie używa się';
								|tr = 'Kullanılmıyor'");
		ChoiceList.Add(SelectionValue, ValuePresentation);
	EndIf;
	
	UseBudgeting = GetFunctionalOption("UseBudgeting");
	
	SelectionValue = "BudgetingLimits_WhenPurchasing";
	ValuePresentation = NStr("vi = 'Theo dữ liệu lập ngân sách (khi mua hàng)';
							|ru = 'По данным бюджетирования (при закупке)';
							|en = 'By budgeting data (at purchase)'; fa = 'By budgeting data (at purchase)';
							|it = 'By budgeting data (at purchase)';
							|pl = 'By budgeting data (at purchase)';
							|tr = 'Bütçeleme verilerine göre (satın alma esaslı)'");
	ListItem = ChoiceList.FindByValue(SelectionValue);
	OptionForUsingLimitsIsAvailable = UseBudgeting
		And GetFunctionalOption("UsePurchaseRequests");
	If OptionForUsingLimitsIsAvailable And ListItem = Undefined Then
		ChoiceList.Add(SelectionValue, ValuePresentation);
	ElsIf Not OptionForUsingLimitsIsAvailable And Not ListItem = Undefined Then
		ChoiceList.Delete(ListItem);
	EndIf;
	
	SelectionValue = "BudgetingLimits_ForConsumption";
	ValuePresentation = NStr("vi = 'Theo dữ liệu lập ngân sách (khi sử dụng hạn mức)';
							|ru = 'По данным бюджетирования (при потреблении)';
							|en = 'By budgeting data (at consumption)'; fa = 'By budgeting data (at consumption)';
							|it = 'By budgeting data (at consumption)';
							|pl = 'By budgeting data (at consumption)';
							|tr = 'Bütçeleme verilene göre (tüketim esaslı)'");
	ListItem = ChoiceList.FindByValue(SelectionValue);
	OptionForUsingLimitsIsAvailable = UseBudgeting
		And GetFunctionalOption("UseProvisionRequests");
	If OptionForUsingLimitsIsAvailable And ListItem = Undefined Then
		ChoiceList.Add(SelectionValue, ValuePresentation);
	ElsIf Not OptionForUsingLimitsIsAvailable And Not ListItem = Undefined Then
		ChoiceList.Delete(ListItem);
	EndIf;
	
EndProcedure

