&AtClientAtServerNoContext
Function ValueForSelectingLimitUsageOption(ConstantsSet)
	
	Value = "";
	If ConstantsSet.UseIEBLimitsOnPurchases Then
		Value = "BudgetingLimits_WhenPurchasing";
	ElsIf ConstantsSet.UseIEBLimitsOnConsumption Then
		Value = "BudgetingLimits_ForConsumption";
	EndIf;
	
	Return Value;
EndFunction

