&AtServer
Procedure OnCreateAtServer(Cancel, StandardProcessing)
	
	If Parameters.Property("AutoTest_2") Then
		Return;
	EndIf;
	
	// Values of form details
	CompositionOfSetOfConstantsOfForm    = TMCommonUse.GetStructureOfSetOfConstants(ConstantsSet);
	ExternalParentConstants = SystemSettingsCached.GetStructureOfParentConstants(CompositionOfSetOfConstantsOfForm);
	WorkMode 				 = New Structure;
	
	ExternalParentConstants.Insert("UseBusinessUnits");
	ExternalParentConstants.Insert("UseSalesOpportunitiesToCustomer");
	ExternalParentConstants.Insert("UseMultipleCompanies");
	ExternalParentConstants.Insert("UseFinancialAccounting");
	ExternalParentConstants.Insert("UseFixedAssetDocumentsFinancialAccounting");
	ExternalParentConstants.Insert("UseProductionManagement2_2");
	WorkMode.Insert("CompositionOfSetOfConstantsOfForm",    New FixedStructure(CompositionOfSetOfConstantsOfForm));
	WorkMode.Insert("ExternalParentConstants", New FixedStructure(ExternalParentConstants));
	WorkMode.Insert("ScheduleSettingIsPossible",  Not Common.DataSeparationEnabled() And Users.IsFullUser(, True));
	
	Items.GroupControlOfIncomeExpenseLimits.Visible = False;
	Items.GroupControlOfIncomeExpenseLimits.Visible = GetFunctionalOption("UseBudgeting");
	SetListOfOptionsForUsingLimits();
	TheOptionOfUsingLimits = ValueForSelectingLimitUsageOption(ConstantsSet);
	
	DocumentVerificationOption = ?(ConstantsSet.AllowModificationOfAuditedFinancialDocuments, 1, 0);
	WorkMode = New FixedStructure(WorkMode);
	
	CostRecordPeriod = BatchAccountingServer.PeriodOfFirstRegisteredRecordsOfRegisterCost();	
		
	// Updating the state of the elements
	SetAvailability();
	
	SystemSettingsLocalization.WhenCreatedOnServer_FinancialResult(ThisForm);
	
	Items.FinancialDocumentVerificationGroup.Visible = ConstantsSet.ComplexAutomation
														Or ConstantsSet.EnterpriseManagement; 
	
EndProcedure

