					|ru = 'Поддержка новых операций прекращена с версии 2.5.26.
					|Данную настройку рекомендуется предварительно включить вместе с техническим специалистом на копии базы и выполнить сверку фактических данных с данными исходной базы.';
					|en = 'No longer supports new business transactions from version 2.5.26.
					|We recommend that you first enable this setting together with a technician in a database backup and reconcile the actual data with the source database data.'; fa = 'No longer supports new business transactions from version 2.5.26.
					|We recommend that you first enable this setting together with a technician in a database backup and reconcile the actual data with the source database data.';
					|it = 'No longer supports new business transactions from version 2.5.26.
					|We recommend that you first enable this setting together with a technician in a database backup and reconcile the actual data with the source database data.';
					|pl = 'No longer supports new business transactions from version 2.5.26.
					|We recommend that you first enable this setting together with a technician in a database backup and reconcile the actual data with the source database data.';
					|tr = '2.5.26 sürümünden itibaren yeni işlemlerin desteği sonlandırılmıştır. 
					| Bu ayarı öncelikle teknik uzman eşliğinde bir veritabanı kopyasında açmanız ve gerçek verileri kaynak veritabanıyla karşılaştırmanız önerilir.'");
			EndIf;
		EndIf;
	EndIf;
	If DataPathAttribute = "ConstantsSet.UseProductCategories" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseProductCategories;
		Items.UseSalesPlansByCategories.Enabled = ConstantValue;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseSalesPlans" 
		Or DataPathAttribute = "ConstantsSet.UseAssemblyDisassemblyPlanning" 
		Or DataPathAttribute = "ConstantsSet.UseProductionPlanning" 
		Or DataPathAttribute = "ParallelizeProductionPlansCalculation" 
		Or DataPathAttribute = "ConstantsSet.UsePurchasePlanning" 
		Or DataPathAttribute = "ConstantsSet.UsePlanningOfInventoryConsumption"
		Or DataPathAttribute = "" Then
		ValueOfConstants = ConstantsSet.UseSalesPlans
			Or ConstantsSet.UseAssemblyDisassemblyPlanning
			Or ConstantsSet.UseProductionPlanning
			Or ConstantsSet.UsePurchasePlanning
			Or ConstantsSet.UsePlanningOfInventoryConsumption;
