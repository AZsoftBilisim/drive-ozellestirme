&AtServerNoContext
Function GetParametersOfRoutineTaskConfigurationForm()
	
	Filter = New Structure();
	Filter.Insert("Metadata", "GenerateNotificationsForBudgetTasks");
	Jobs = ScheduledJobsServer.FindJobs(Filter);
	
	ScheduledJobUUID = Undefined;
	If Jobs.Count() > 0 Then
		ScheduledJobUUID = Jobs[0].UUID;		
	EndIf;     
	
	FormParameters = New Structure("Action, Id","Change",ScheduledJobUUID);
	Return FormParameters;
	
EndFunction

&AtServer
Function ReadProductionPlanCalculationSettings()
	
	ParameterValues = CalculationOfProductionPlan.CommonSettings();
	
	ParallelizeProductionPlansCalculation   = ParameterValues.VectorizeCalculation;
	NumberOfProductionPlanCalculationThreads = ParameterValues.ThreadsCount;
	
EndFunction

&AtServer
Procedure RecordProductionPlanCalculationSettings()
	
	ParameterValues = New Structure("VectorizeCalculation,ThreadsCount");
	
	ParameterValues.VectorizeCalculation = ParallelizeProductionPlansCalculation;
	ParameterValues.ThreadsCount      = NumberOfProductionPlanCalculationThreads;
	
	CalculationOfProductionPlan.RecordProductionPlanCalculationSettings(ParameterValues);
	
EndProcedure

&AtServer
Procedure SetStandardSettingsForCalculatingProductionPlan(Initialize = False)
	
	CalculationOfProductionPlan.SetStandardSettingsForCalculatingProductionPlan(Initialize);
	
	ReadProductionPlanCalculationSettings();
	
EndProcedure

