&AtServerNoContext
Function ChangeOptionForSettingUpRulesForGettingFact(UUID, SetupParameters)
	
	BackgroundJobParameters = TimeConsumingOperations.BackgroundExecutionParameters(UUID);
	BackgroundJobParameters.BackgroundJobDescription = NStr("vi = 'Thay đổi phương án tùy chỉnh quy tắc nhận dữ liệu thực tế';
															|ru = 'Изменение варианта настройки правил получения фактических данных';
															|en = 'Change the setup option of actual data receipt rules'; fa = 'Change the setup option of actual data receipt rules';
															|it = 'Изменение варианта настройки правил получения фактических данных';
															|pl = 'Change the setup option of actual data receipt rules';
															|tr = 'Gerçek veri alımına yönelik kural ayarı seçeneğinin değiştirilmesi'");
	BackgroundJobParameters.BackgroundJobKey = "ChangingOptionForSettingUpRulesForGettingFact";
	BackgroundJobParameters.WaitCompletion = 1;
	
	If SetupParameters.SettingName = "SettingUpRulesForObtainingFactsFromCorrespondingRegisters" Then
		ProcedureName = "Catalogs.ActualDataQueryRulesByBudgetFlowItems.ChangeOptionForSettingUpRulesForGettingFact";
	ElsIf SetupParameters.SettingName = "SetUpRulesForObtainingActualDataByAssetAndLiabilityItems" Then
		ProcedureName = "Catalogs.ActualDataQueryRulesByBudgetBalanceItems.ChangeSettingsForFactReceiptRules";
	EndIf;
	
	StartupParameters = New Structure(SetupParameters.SettingName, SetupParameters.SettingValue);
	
	BackgroundJobResult = TimeConsumingOperations.ExecuteInBackground(
		ProcedureName, 
		StartupParameters, 
		BackgroundJobParameters);
	
	Return BackgroundJobResult;

EndFunction
&AtServer
Function OnChangeAttributeServer(TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	If DataPathAttribute = "SetUpRulesForObtainingActualDataByAssetAndLiabilityItems" Then
		ConstantsSet.SetUpRulesForObtainingActualDataByAssetAndLiabilityItems = Boolean(SetUpRulesForObtainingActualDataByAssetAndLiabilityItems);
		DataPathAttribute = "ConstantsSet.SetUpRulesForObtainingActualDataByAssetAndLiabilityItems";
	ElsIf DataPathAttribute = "OptionForSettingUpRulesForGettingFacts" Then
		ConstantsSet.SettingUpRulesForObtainingFactsFromCorrespondingRegisters = (OptionForSettingUpRulesForGettingFacts = 1);
		DataPathAttribute = "ConstantsSet.SettingUpRulesForObtainingFactsFromCorrespondingRegisters";
	EndIf;
	ConstantName = SaveAttributeValue(DataPathAttribute, New Structure);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

&AtServer
Function SaveAttributeValue(DataPathAttribute, Result)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisForm.Read();
		EndIf;
		
	EndIf;
	If DataPathAttribute = "ParallelizeProductionPlansCalculation"
		Or DataPathAttribute = "NumberOfProductionPlanCalculationThreads" Then
		RecordProductionPlanCalculationSettings();
	EndIf;
	Return ConstantName;
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	FileIB = Common.FileInfobase();
	If DataPathAttribute = "ConstantsSet.UseBudgeting" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseBudgeting;
		Items.UseBudgetProcess.Enabled = ConstantValue;
		Items.UseNotificationsForBudgetingTasks.Enabled = 
			?(Not ConstantValue, False, ConstantsSet.UseBudgetProcess);
		Items.SetUpTheScheduleOfBudgetTaskNotifications.Enabled = 
			?(Not ConstantValue, False, ConstantsSet.UseNotificationsForBudgetingTasks);
		Items.LocalInfobasePublishingURL.Enabled =
			?(Not ConstantValue, False, ConstantsSet.UseNotificationsForBudgetingTasks);
		Items.UpdateStoredActualBudgetingDataWhenPostingDocuments.Enabled = ConstantValue;
		Items.UpdateStoredActualBudgetingDataWhenGeneratingReports.Enabled = ConstantValue;
		Items.GroupSettingUpRulesForGettingFacts.Enabled = ConstantValue;
	EndIf;
	If DataPathAttribute = "ConstantsSet.UseBudgetProcess" Or DataPathAttribute = "" Then
		Items.UseNotificationsForBudgetingTasks.Enabled = ConstantsSet.UseBudgetProcess;
		Items.GroupNotificationSettings.Enabled = ConstantsSet.UseBudgetProcess;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseNotificationsForBudgetingTasks" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseNotificationsForBudgetingTasks;
