&AtServer
Procedure OnCreateAtServer(Cancel, StandardProcessing)
	
	If Parameters.Property("AutoTest_2") Then
		Return;
	EndIf;
	
	// Values of form details
	CompositionOfSetOfConstantsOfForm    = TMCommonUse.GetStructureOfSetOfConstants(ConstantsSet);
	ExternalParentConstants = SystemSettingsCached.GetStructureOfParentConstants(CompositionOfSetOfConstantsOfForm);
	WorkMode = New Structure;
	
	ExternalParentConstants.Insert("UseProduction");
	ExternalParentConstants.Insert("UseProductCategories");
	ExternalParentConstants.Insert("UseAssemblyDisassembly");
	
	WorkMode.Insert("CompositionOfSetOfConstantsOfForm",    New FixedStructure(CompositionOfSetOfConstantsOfForm));
	WorkMode.Insert("ExternalParentConstants", New FixedStructure(ExternalParentConstants));
	
	WorkMode = New FixedStructure(WorkMode);
	
	If GetFunctionalOption("EnterpriseManagement")
		And GetFunctionalOption("NotCPM")
		Or GetFunctionalOption("ComplexAutomation") Then
		Items.SectionDetails.Title = NStr("vi = 'Tùy chỉnh tham số hoạch định ngân sách và lập kế hoạch.';
											|ru = 'Настройка параметров бюджетирования и планирования.';
											|en = 'Set up budgeting and planning parameters.'; fa = 'Set up budgeting and planning parameters.';
											|it = 'Impostazione dei parametri per budgettizzazione e pianificazione.';
											|pl = 'Konfigurowanie ustawień budżetowania i planowania.';
											|tr = 'Bütçeleme ve planlama parametrelerini ayarla.'");
	Else
		Items.SectionDetails.Title = NStr("vi = 'Tùy chỉnh tham số lập kế hoạch.';
											|ru = 'Настройка параметров планирования.';
											|en = 'Set up planning parameters.'; fa = 'Set up planning parameters.';
											|it = 'Impostazione dei parametri di pianificazione.';
											|pl = 'Konfigurowanie ustawień planowania.';
											|tr = 'Planlama parametresi ayarları'");
		
		Items.BudgetingSettingsGroup.Visible = False;
		Items.UsePlanningGroup.ShowTitle = False;
	EndIf;
	If Not GetFunctionalOption("EnterpriseManagement") Then
		Items.UseProductionPlanning.ToolTip =
			NStr("vi = 'Tính năng quản lý kế hoạch sản xuất theo kỳ.';
				|ru = 'Возможность ведения планов производства по периодам.';
				|en = 'Keep production plans by periods.'; fa = 'Keep production plans by periods.';
				|it = 'La possibilità di gestione dei piani di produzione per periodi.';
				|pl = 'Możliwość sporządzenia planów produkcji za okresy.';
				|tr = 'Dönemlere göre üretim planlarını yönetebilme.'");
	EndIf;
	ReadProductionPlanCalculationSettings();
	If GetFunctionalOption("SaaSOperations") Then
		Items.LocalInfobasePublishingURL.Visible = False;
	EndIf;
	
	// Updating the state of the elements
	SetAvailability();
	
EndProcedure

&AtClient
Procedure OnClose(Exit)
	If Exit Then
		Return;
	EndIf;
	RefreshApplicationInterface();
EndProcedure

&AtClient
// The alert handler of the form.
//
// Parameters:
//	Eventname - String - only the event record_setconstant generated by the administration panels is processed.
//	The parameter - Structure - contains the names of constants subordinate to the changed constant that "caused" the alert.
//	Source - String - the name of the changed constant that "caused" the alert.
//
Procedure NotificationProcessing(EventName, Parameter, Source)
	
	If EventName <> "Write_ConstantsSet" Then
		Return; // such events are not processed
	EndIf;
	
	// If it is a changed constant located in a different form and affecting the values of the constants of this form,
	// then we will read the values of the constants and update the elements of this form.
	If WorkMode.ExternalParentConstants.Property(Source)
	 Or (TypeOf(Parameter) = Type("Structure")
	 		And TMCommonUseClientServer.GetSharedKeysOfStructures(
	 			Parameter, WorkMode.ExternalParentConstants).Count() > 0) Then
		
		ThisForm.Read();
		SetAvailability();
		
	EndIf;
	
EndProcedure

