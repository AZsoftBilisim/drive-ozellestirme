&AtClient
Procedure Attachable_OnChangeAttribute(Item, ShouldRefreshInterface = True)
	
	ConstantName = OnChangeAttributeServer(Item.Name);
	
	If ShouldRefreshInterface Then
		RefreshInterface = True;
		AttachIdleHandler("RefreshApplicationInterface", 2, True);
	EndIf;
	
	If ConstantName <> "" Then
		Notify("Write_ConstantsSet", New Structure, ConstantName);
	EndIf;
	
EndProcedure

&AtClient
Procedure RefreshApplicationInterface()
	
	If RefreshInterface = True Then
		RefreshInterface = False;
		CommonClient.RefreshApplicationInterface();
	EndIf;
	
EndProcedure
&AtClient
Function FormParametersOfOperation()
	
	TimeConsumingOperationParameters = New Structure;
	TimeConsumingOperationParameters.Insert("JobID");
	TimeConsumingOperationParameters.Insert("ResultAddress");
	TimeConsumingOperationParameters.Insert("OutputIdleWindow", True);
	TimeConsumingOperationParameters.Insert("OutputProgressBar", True);
	TimeConsumingOperationParameters.Insert("OutputMessages", True);
	
	Return TimeConsumingOperationParameters;
	
EndFunction

&AtClient
Procedure ProcessingChangesToFactReceiptRulesSettingOption(QuestionResult, AdditionalParameters) Export
	
	If QuestionResult = DialogReturnCode.Yes Then
		
		Attachable_OnChangeAttribute(AdditionalParameters.FormItem, False);
		
		If AdditionalParameters.DataPath = "OptionForSettingUpRulesForGettingFacts" Then
			SettingName = "SettingUpRulesForObtainingFactsFromCorrespondingRegisters";
		ElsIf AdditionalParameters.DataPath = "SetUpRulesForObtainingActualDataByAssetAndLiabilityItems" Then
			SettingName = "SetUpRulesForObtainingActualDataByAssetAndLiabilityItems";
		EndIf;
		
		SetupParameters = New Structure(
			"SettingName,SettingValue",
			SettingName, ConstantsSet[SettingName]);
			
		Result = ChangeOptionForSettingUpRulesForGettingFact(UUID, SetupParameters);
		
		If Result.Status = "Running" Then
		
			ParametersFormOfLongTermOperationOfOperation = FormParametersOfOperation();
			ParametersFormOfLongTermOperationOfOperation.ResultAddress = Result.ResultAddress;
			ParametersFormOfLongTermOperationOfOperation.JobID = Result.JobID;
			
			ClosingNotification1 = New CallbackDescription("ChangeInFactReceiptRulesConfigurationOptionHasBeenCompleted", ThisObject, AdditionalParameters);
			
			OpenForm("CommonForm.TimeConsumingOperation", ParametersFormOfLongTermOperationOfOperation, ThisObject, , , , ClosingNotification1);
			
		Else
			
			ChangeInFactReceiptRulesConfigurationOptionHasBeenCompleted(Result, AdditionalParameters);
			
		EndIf;
		
	Else
		
		If AdditionalParameters.DataPath = "OptionForSettingUpRulesForGettingFacts" Then
			OptionForSettingUpRulesForGettingFacts = ?(OptionForSettingUpRulesForGettingFacts = 1, 2, 1);
		ElsIf AdditionalParameters.DataPath = "SetUpRulesForObtainingActualDataByAssetAndLiabilityItems" Then
			SetUpRulesForObtainingActualDataByAssetAndLiabilityItems = ?(SetUpRulesForObtainingActualDataByAssetAndLiabilityItems = 1, 0, 1);
		EndIf;
		
		Attachable_OnChangeAttribute(AdditionalParameters.FormItem, False);
		
	EndIf;
	
EndProcedure

&AtClient
Procedure ChangeInFactReceiptRulesConfigurationOptionHasBeenCompleted(Result, AdditionalParameters) Export
	
	If TypeOf(Result) = Type("Structure") Then
		
		If ValueIsFilled(Result.ResultAddress) 
			And Not Result.Status = "Error" Then
			
			ExecutionResult = GetFromTempStorage(Result.ResultAddress);
			
			If AdditionalParameters.DataPath = "OptionForSettingUpRulesForGettingFacts" Then
