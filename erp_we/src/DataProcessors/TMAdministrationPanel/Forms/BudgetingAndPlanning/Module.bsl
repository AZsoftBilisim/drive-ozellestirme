			Items.OutdatedSettingsForGettingFactRules.ToolTip =
				NStr("vi = 'Phương án đã lỗi thời. Nguồn dữ liệu là các biểu ghi phát sinh phân tích và các khuôn mẫu của sơ đồ dàn dựng dữ liệu. Việc hỗ trợ các thao tác mới đã bị ngừng từ phiên bản 2.5.12';
					|ru = 'Устаревший вариант. Источниками данных являются аналитические оборотные регистры и макеты схемы компоновки данных. Поддержка новых операций прекращена с версии 2.5.12';
					|en = 'Outdated version. The data sources are analytical turnover registers and data composition schema templates. No longer supports new business transactions since version 2.5.12'; fa = 'نسخه قدیمی. منابع داده، رجیسترهای گردش تحلیلی و الگوهای طرح ترکیب داده هستند. از نسخه 2.5.12 دیگر از معاملات تجاری جدید پشتیبانی نمی‌کند';
					|it = 'Outdated version. The data sources are analytical turnover registers and data composition schema templates. No longer supports new business transactions since version 2.5.12';
					|pl = 'Outdated version. The data sources are analytical turnover registers and data composition schema templates. No longer supports new business transactions since version 2.5.12';
					|tr = 'Eski seçenek. Veri kaynakları analitik ciro kayıtları ve veri oluşturma şeması taslaklarıdır. Yeni işlemlerin desteği 2.5.12 sürümünden itibaren sonlandırılmıştır.'");
		EndIf;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.SettingUpRulesForObtainingFactsFromCorrespondingRegisters"
		Or DataPathAttribute = "" Then
