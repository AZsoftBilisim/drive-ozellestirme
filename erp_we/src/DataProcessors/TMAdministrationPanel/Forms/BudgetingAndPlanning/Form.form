      <items xsi:type="form:FormField">
        <name>UseSalesPlans</name>
        <id>5</id>
        <title>
          <key>en</key>
          <value>Sales forecasts</value>
        </title>
        <title>
          <key>fa</key>
          <value>پیش‌بینی‌های فروش</value>
        </title>
        <title>
          <key>it</key>
          <value>Piani delle vendite</value>
        </title>
        <title>
          <key>pl</key>
          <value>Plany sprzedaży</value>
        </title>
        <title>
          <key>ru</key>
          <value>Планы продаж</value>
        </title>
        <title>
          <key>tr</key>
          <value>Satış tahminleri</value>
        </title>
        <title>
          <key>vi</key>
          <value>Kế hoạch bán hàng</value>
