        <extendedTooltip>
          <name>UseCustomerContractsExtendedTooltip</name>
          <id>2650</id>
          <title>
            <key>en</key>
            <value>Register contracts with customers and AR/AP by contracts.</value>
          </title>
          <title>
            <key>fa</key>
            <value>ثبت قراردادهای با مشتریان و دریافتنی/پرداختنی بر اساس قراردادها.</value>
          </title>
          <title>
            <key>it</key>
