              <common>true</common>
            </userVisible>
            <title>
              <key>en</key>
              <value>Comment goods cost for assessing sales profitability 1</value>
            </title>
            <title>
              <key>fa</key>
              <value>توضیح بهای تمام‌شده کالا برای ارزیابی سودآوری فروش 1</value>
            </title>
            <title>
              <key>it</key>
              <value>Commento costo delle merci al momento di valutazione della redditività della vendita 1</value>
            </title>
            <title>
              <key>pl</key>
              <value>Komentarz cena towarów przy ocenie rentowności sprzedaży 1</value>
            </title>
