        </toolTip>
        <toolTip>
          <key>tr</key>
          <value>Gümrük ödemelerini hesaplamak için aynı prosedüre sahip ürünleri bölümlere göre gruplandır.</value>
        </toolTip>
        <toolTip>
          <key>vi</key>
