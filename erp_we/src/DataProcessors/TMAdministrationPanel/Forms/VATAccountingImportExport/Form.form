        </toolTip>
        <toolTip>
          <key>pl</key>
          <value>Grupuj wg rozdziałów wiersze pozycji o jednakowym trybie rozliczenia płatności celnych.</value>
        </toolTip>
        <toolTip>
          <key>ru</key>
