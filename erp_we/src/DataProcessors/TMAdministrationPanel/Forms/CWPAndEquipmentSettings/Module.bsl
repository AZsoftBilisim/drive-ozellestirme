#Region Client

&AtClient
Procedure Attachable_OnChangeAttribute(Item, ShouldRefreshInterface = True)
	
	ConstantName = OnChangeAttributeServer(Item.Name);
	
	If ShouldRefreshInterface Then
		RefreshInterface = True;
		AttachIdleHandler("RefreshApplicationInterface", 2, True);
	EndIf;
	
	If ConstantName <> "" Then
		Notify("Write_ConstantsSet", New Structure, ConstantName);
	EndIf;
	
EndProcedure

&AtClient
Procedure RefreshApplicationInterface()
	
	If RefreshInterface = True Then
		RefreshInterface = False;
		CommonClient.RefreshApplicationInterface();
	EndIf;
	
EndProcedure

&AtClient
Procedure EnableInternetUserSupportCompletion(Result, AdditionalParameters) Export
	
	Items.DecorationAddInsUpdateNotRunning.Visible =
		(Not CommonCELInternalServerCall.AuthenticationDataOfOnlineSupportUserFilled()
		And ConstantsSet.AddInsUpdateOption = 1);
	
EndProcedure

&AtClient
Procedure AddInsFileAfterFileChoice(SelectedFiles, AdditionalParameters) Export
	
	If SelectedFiles = Undefined Then
		Return;
	EndIf;
	
	If SelectedFiles.Count() = 0 Then
		Return;
	EndIf;
	
	ConstantsSet.AddInsFile = SelectedFiles[0];
	OnChangeAttributeServer(Items.AddInsFile.Name);
	
EndProcedure

