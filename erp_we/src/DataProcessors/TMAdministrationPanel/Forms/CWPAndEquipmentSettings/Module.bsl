#Region ServerCall

&AtServer
Function OnChangeAttributeServer(TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	
	ConstantName = SaveAttributeValue(DataPathAttribute);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

#EndRegion

#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			Read();
		EndIf;
		
	EndIf;
	
	Return ConstantName;
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	If DataPathAttribute = "ConstantsSet.UsePeripherals" Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UsePeripherals;
		
		Items.UseExchangeWithOfflinePeripherals.Enabled = ConstantValue And Constants.UseRetailSales.Get();
		Items.OpenPeripherals.Enabled 					= ConstantValue;
		Items.OpenTemplatesOfMagneticStripeCards.Enabled 						= ConstantValue;
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseExchangeWithOfflinePeripherals" Or DataPathAttribute = "" Then
		Items.OpenTheRulesOfExchangeWithThePeripherals.Enabled = ConstantsSet.UseExchangeWithOfflinePeripherals;
		Items.OpenOfflineEquipment.Enabled                      = ConstantsSet.UseExchangeWithOfflinePeripherals;
	EndIf;
	
	DataExchangeTMERP.SetAvailabilityOfInformationBaseNodeSettings(ThisObject);
	
EndProcedure

&AtServerNoContext
Function CurrentCWPSettings()
	
	Query = New Query;
	Query.Text = 
	"SELECT TOP 1
	|	CWPSettings.Ref
	|FROM
	|	Catalog.CWPSettings AS CWPSettings
	|WHERE
	|	CWPSettings.Workplace = &Workplace";

	Query.SetParameter("Workplace", EquipmentManagerServerCall.GetClientSWorkplace());

	Result = Query.Execute();
	Selection = Result.Select();

	If Selection.Next() Then
	
		Return Selection.Ref;
		
	Else
		
		Return Catalogs.CWPSettings.EmptyRef();
		
	EndIf;
	
EndFunction

&AtServer
Procedure FillInDescriptionOfCustomRoutineTasks()
	
	SetPrivilegedMode(True);
	
	DescriptionOfCustomScheduledTasks = New Structure;
	
	DescriptionOfCustomScheduledTasks.Insert("ClearHistoryOfFiscalTransactions", 
					New Structure("NameOfRoutineTaskMetadata, MetadataForCheckingAccessRightsForChanges",
									Metadata.ScheduledJobs.ClearHistoryOfFiscalTransactions.Name, New ValueList));
									
	DescriptionOfCustomScheduledTasks.Insert("ClearHistoryOfPaymentTransactions", 
					New Structure("NameOfRoutineTaskMetadata, MetadataForCheckingAccessRightsForChanges",
									Metadata.ScheduledJobs.ClearHistoryOfPaymentTransactions.Name, New ValueList));
	
	DescriptionOfCustomScheduledTasks.Insert("ClearHistoryOfOperationsWithPeripherals", 
					New Structure("NameOfRoutineTaskMetadata, MetadataForCheckingAccessRightsForChanges",
									Metadata.ScheduledJobs.ClearHistoryOfOperationsWithPeripherals.Name, New ValueList));
	
	RetailSalesLocalization.FillInDescriptionOfCustomRoutineTasks(DescriptionOfCustomScheduledTasks);
	
EndProcedure

