	<totalField>
		<dataPath>Group</dataPath>
		<expression>Case
When EvalExpression(1, "CurrencyTurnover") = 1 Then
	CurrencyTurnover
When EvalExpression(1, "ReceiptsAreNotDistributedInOneCurrency") = 1 Then
	ReceiptsAreNotDistributedInOneCurrency
When EvalExpression(1, "WriteOffsNotAllocatedInOneCurrency") = 1 Then
	WriteOffsNotAllocatedInOneCurrency
When EvalExpression(1, "ReceiptWriteOffInOneCurrency") = 1 Then
	ReceiptWriteOffInOneCurrency
When EvalExpression(1, "WriteOffsNotAllocated") = 1 Then
	WriteOffsNotAllocated
When EvalExpression(1, "RevenueNotDistributed") = 1 Then
	RevenueNotDistributed
When EvalExpression(1, "ReceiptIssue") = 1 Then
	ReceiptIssue
When EvalExpression(1, "BankAccountCashAccount") = 1 Then
	BankAccountCashAccount
When EvalExpression(1, "CashAccountBank") = 1 Then CashAccountBank
When EvalExpression(1, "CashType") = 1 Then CashType
When EvalExpression(1, "Organization") = 1 Then Organization
When EvalExpression(1, "CurrencyBalance") = 1 Then
	CurrencyBalance
When EvalExpression(1, "CurrencyBalanceInOneCurrency") = 1 Then
	CurrencyBalanceInOneCurrency
When EvalExpression(1, "InTotal") = 1 Then
	InTotal
End</expression>
	</totalField>
	<totalField>
		<dataPath>LineKind</dataPath>
		<expression>Case
When EvalExpression(1, "CurrencyTurnover") = 1 Then
	1
When EvalExpression(1, "ReceiptsAreNotDistributedInOneCurrency") = 1 Then
	3
When EvalExpression(1, "WriteOffsNotAllocatedInOneCurrency") = 1 Then
	3
When EvalExpression(1, "ReceiptWriteOffInOneCurrency") = 1 Then
	3
When EvalExpression(1, "WriteOffsNotAllocated") = 1 Then
	1
When EvalExpression(1, "RevenueNotDistributed") = 1 Then
	1
When EvalExpression(1, "ReceiptIssue") = 1 Then
	1
When EvalExpression(1, "BankAccountCashAccount") = 1 Then
	0
When EvalExpression(1, "CashAccountBank") = 1 Then
	4
When EvalExpression(1, "CashType") = 1 Then
	4
When EvalExpression(1, "Organization") = 1 Then
	4
When EvalExpression(1, "CurrencyBalance") = 1 Then
	0
When EvalExpression(1, "CurrencyBalanceInOneCurrency") = 1 Then
	2
When EvalExpression(1, "InTotal") = 1 Then
	2
End</expression>
	</totalField>
	<totalField>
		<dataPath>Turnover</dataPath>
		<expression>Sum(Turnover)</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverInOneCurrency</dataPath>
		<expression>Sum(TurnoverInOneCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>BalanceInASingleCurrency</dataPath>
		<expression>0</expression>
		<group>ReceiptWriteOffInOneCurrency</group>
		<group>ReceiptsAreNotDistributedInOneCurrency</group>
		<group>ReceiptsAllocatedInOneCurrency</group>
		<group>WriteOffsNotAllocatedInOneCurrency</group>
		<group>CashOutflowIsAllocatedInSingleCurrency</group>
		<group>ReceiptIssue</group>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Sum(Sum)</expression>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>0</expression>
		<group>ReceiptIssue</group>
		<group>ReceiptWriteOffInOneCurrency</group>
		<group>ReceiptsAreNotDistributedInOneCurrency</group>
		<group>ReceiptsAllocatedInOneCurrency</group>
		<group>WriteOffsNotAllocatedInOneCurrency</group>
		<group>CashOutflowIsAllocatedInSingleCurrency</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>IsNull(Sum(EvalExpressionWithGroupArray ("Max(Balance)", "BankAccountCashAccount")), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>BalanceInASingleCurrency</dataPath>
		<expression>IsNull(Sum(EvalExpressionWithGroupArray ("Max(BalanceInASingleCurrency)", "BankAccountCashAccount")), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>OrderValue</dataPath>
		<expression>IsNull(OrderValue, 99999)</expression>
	</totalField>
	<totalField>
		<dataPath>TotalsLine</dataPath>
		<expression>Case
When EvalExpression(1, "ReceiptsAreNotDistributedInOneCurrency") = 1 Then
	False
When EvalExpression(1, "WriteOffsNotAllocatedInOneCurrency") = 1 Then
	False
When EvalExpression(1, "ReceiptWriteOffInOneCurrency") = 1 Then
	False
When EvalExpression(1, "WriteOffsNotAllocated") = 1 Then
	False
When EvalExpression(1, "RevenueNotDistributed") = 1 Then
	False
When EvalExpression(1, "ReceiptIssue") = 1 Then
	False
When EvalExpression(1, "BankAccountCashAccount") = 1 Then
	False
When EvalExpression(1, "CurrencyBalanceInOneCurrency") = 1 Then
	False
When EvalExpression(1, "CurrencyBalance") = 1 Then
	False
When EvalExpression(1, "InTotal") = 1 Then
	True
Else
	False
End</expression>
	</totalField>
	<totalField>
		<dataPath>LineCurrency</dataPath>
		<expression>Case
When EvalExpression(1, "InTotal") = 1 Then
	&amp;TotalCurrency
Else
	Currency
End</expression>
	</totalField>
	<totalField>
		<dataPath>Overdue</dataPath>
		<expression>Sum(Overdue)</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueInOneCurrency</dataPath>
		<expression>Sum(OverdueInOneCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>UnallocatedLine</dataPath>
		<expression>Case
When EvalExpression(1, "ReceiptsAreNotDistributedInOneCurrency") = 1 Then
    True
When EvalExpression(1, "WriteOffsNotAllocatedInOneCurrency") = 1 Then
    True
When EvalExpression(1, "ReceiptWriteOffInOneCurrency") = 1 Then
    False
When EvalExpression(1, "WriteOffsNotAllocated") = 1 Then
    True
When EvalExpression(1, "RevenueNotDistributed") = 1 Then
    True
When EvalExpression(1, "ReceiptIssue") = 1 Then
    False
When EvalExpression(1, "BankAccountCashAccount") = 1 Then
    False
When EvalExpression(1, "CurrencyBalanceInOneCurrency") = 1 Then
    False
When EvalExpression(1, "CurrencyBalance") = 1 Then
    False
When EvalExpression(1, "InTotal") = 1 Then
    False
Else
    False
End</expression>
	</totalField>
	<totalField>
		<dataPath>StringIsDistributed</dataPath>
		<expression>Case
When EvalExpression(1, "ReceiptsAllocatedInOneCurrency") = 1 Then
    True
When EvalExpression(1, "CashOutflowIsAllocatedInSingleCurrency") = 1 Then
    True
When EvalExpression(1, "ReceiptsAreNotDistributedInOneCurrency") = 1 Then
    False
When EvalExpression(1, "WriteOffsNotAllocatedInOneCurrency") = 1 Then
    False
When EvalExpression(1, "ReceiptWriteOffInOneCurrency") = 1 Then
    False
When EvalExpression(1, "WriteOffsNotAllocated") = 1 Then
    False
When EvalExpression(1, "RevenueNotDistributed") = 1 Then
    False
When EvalExpression(1, "ReceiptIssue") = 1 Then
    False
When EvalExpression(1, "BankAccountCashAccount") = 1 Then
    False
When EvalExpression(1, "CurrencyBalanceInOneCurrency") = 1 Then
    False
When EvalExpression(1, "CurrencyBalance") = 1 Then
    False
When EvalExpression(1, "InTotal") = 1 Then
    False
Else
    False
End</expression>
	</totalField>
	<totalField>
		<dataPath>IrreducibleBalance</dataPath>
		<expression>0</expression>
	</totalField>
	<totalField>
		<dataPath>IrreducibleBalance</dataPath>
		<expression>IsNull(Sum(EvalExpressionWithGroupArray ("Max(IrreducibleBalance)", "BankAccountCashAccount")), 0)</expression>
		<group>CashAccountBank</group>
		<group>BankAccountCashAccount</group>
		<group>Organization</group>
		<group>CashType</group>
	</totalField>
	<totalField>
		<dataPath>CriticalBalance</dataPath>
		<expression>0</expression>
	</totalField>
	<totalField>
		<dataPath>CriticalBalance</dataPath>
		<expression>IsNull(Sum(EvalExpressionWithGroupArray ("Max(CriticalBalance)", "BankAccountCashAccount")), 0)</expression>
		<group>BankAccountCashAccount</group>
	</totalField>
	<totalField>
		<dataPath>BalanceErrorCriticalBalance</dataPath>
		<expression>Max(BalanceErrorCriticalBalance)</expression>
		<group>BankAccountCashAccount</group>
	</totalField>
	<totalField>
		<dataPath>BalanceAndIrreducibleBalance</dataPath>
		<expression>0</expression>
		<group>ReceiptIssue</group>
		<group>ReceiptWriteOffInOneCurrency</group>
		<group>ReceiptsAreNotDistributedInOneCurrency</group>
		<group>ReceiptsAllocatedInOneCurrency</group>
	</totalField>
	<totalField>
		<dataPath>BalanceAndIrreducibleBalance</dataPath>
		<expression>IsNull(Sum(EvalExpressionWithGroupArray ("Max(BalanceAndIrreducibleBalance)", "BankAccountCashAccount")), 0)</expression>
	</totalField>
