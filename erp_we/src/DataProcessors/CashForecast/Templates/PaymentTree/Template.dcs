				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Balance and minimum balance</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Balance and minimum balance</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionRateToOneCurrency

INTO ConversionRatesToOneCurrency
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;CurrentDate, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;CurrentDate, Currency = &amp;TotalCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
	
INDEX BY
	Currency
;

/////////////////////////////////////////////////
SELECT ALLOWED
	ExchangeRates.Currency AS Currency,
	ISNULL(ExchangeRates.CourseNumerator, 1) AS CourseNumerator,
	ISNULL(ExchangeRates.CourseDenominator, 1) AS CourseDenominator
	
INTO ConversionRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;CurrentDate, BaseCurrency = &amp;BaseCurrency) AS ExchangeRates
WHERE
	ExchangeRates.CourseDenominator &lt;&gt; 0
	AND ExchangeRates.CourseNumerator &lt;&gt; 0

INDEX BY
	Currency
;

/////////////////////////////////////////////////
SELECT ALLOWED
	BankAccounts.Ref AS BankAccountCashAccount,
	BankAccounts.CashCurrency AS CashCurrency,
	BankAccounts.SeparateSDOAccount AS SeparateSDOAccount,
	BankAccounts.IrreducibleBalance AS IrreducibleBalance,
	BankAccounts.CriticalBalance AS CriticalBalance,
	Companies.Ref AS Organization,
	BankAccounts.Bank AS CashAccountBank,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType

INTO BankAccountsCashAccounts
FROM
	Catalog.CompaniesBankAccounts AS BankAccounts
	
	INNER JOIN Catalog.Companies AS Companies
	ON BankAccounts.Owner = Companies.Ref
WHERE
	NOT BankAccounts.DeletionMark
	AND NOT BankAccounts.Closed
	
{WHERE
	Companies.Ref.* AS Organization,
	BankAccounts.Ref.* AS BankAccountCashAccount,
	BankAccounts.CashCurrency.* AS Currency}

UNION ALL

SELECT
	CashAccounts.Ref,
	CashAccounts.CashCurrency AS CashCurrency,
	FALSE,
	CashAccounts.IrreducibleBalance,
	CashAccounts.CriticalBalance,
	Companies.Ref,
	&amp;CashAccounts,
	VALUE(Enum.CashTypes.CashPayment)
FROM
	Catalog.CashAccounts AS CashAccounts
	
	INNER JOIN Catalog.Companies AS Companies
	ON CashAccounts.Owner = Companies.Ref
WHERE
	NOT CashAccounts.DeletionMark
	
{WHERE
	Companies.Ref.* AS Organization,
	CashAccounts.Ref.* AS BankAccountCashAccount,
	CashAccounts.CashCurrency.* AS Currency}

UNION ALL
	
SELECT
	UNDEFINED,
	NULL,
	NULL,
	0,
	0,
	NULL,
	NULL,
	NULL
	
INDEX BY
	BankAccountCashAccount
;

//////////////////////////////////////////
SELECT ALLOWED
	BankAccountCash.BankAccount AS BankAccountCashAccount,
	BankAccountCash.SumBalance - BankAccountCash.ToWriteOffBalance + BankAccountCash.ToReceive_Balance AS Balance

INTO CashBalances
FROM
	AccumulationRegister.BankAccountCash.Balance(
		{&amp;BorderBalanceDate},
		{(Organization).* AS Organization, (BankAccount).* AS BankAccountCashAccount, (BankAccount.Bank).* AS Bank}
		) AS BankAccountCash

UNION ALL

SELECT
	CashAccountBalance.CashAccount AS BankAccountCashAccount,
	CashAccountBalance.SumBalance AS Balance
FROM
	AccumulationRegister.CashAccountBalance.Balance(
		{&amp;BorderBalanceDate},
		{(Organization).* AS Organization, (CashAccount).* AS BankAccountCashAccount}
		) AS CashAccountBalance

INDEX BY
	BankAccountCashAccount
;

//////////////////////////////////////////
SELECT ALLOWED
	ScheduleOfPayments.BankAccountCashAccount,
	CASE
		WHEN ScheduleOfPayments.PaymentDate &lt; &amp;CurrentDate
		THEN DATEADD(&amp;CurrentDate, DAY, -1)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.YEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, YEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, YEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.HALFYEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, HALFYEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, HALFYEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.QUARTER)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, QUARTER)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, QUARTER)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.MONTH)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, MONTH)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, MONTH)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.TENDAYS)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, TENDAYS)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, TENDAYS)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.WEEK)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, WEEK)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, WEEK)
		ELSE ScheduleOfPayments.PaymentDate
	END AS PaymentDate,
	ScheduleOfPayments.ReceiptIssue,
	ScheduleOfPayments.Currency AS PaymentCurrency,
	ScheduleOfPayments.Organization AS Organization,
	SUM(ScheduleOfPayments.Sum) AS Sum,
	ScheduleOfPayments.PayerBeneficiary AS PayerBeneficiary,
	ScheduleOfPayments.PaymentObject AS PaymentObject,
	ScheduleOfPayments.AmountType AS AmountType,
	ScheduleOfPayments.PaymentDate AS OriginalPaymentDate,
	ScheduleOfPayments.Frozen AS Frozen,
	DATEDIFF(ScheduleOfPayments.PaymentDate, &amp;CurrentDate, DAY) AS DaysOverdue_3,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest)
			OR VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.CashTransferReferenceOrder)
		THEN FALSE
		WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
		THEN
			CASE
				WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
				THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).EnableCreatingCashIssueWithoutPaymentRequest
				WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
				THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).EnableCreatingCashIssueWithoutPaymentRequest
				ELSE FALSE
			END
		ELSE FALSE
	END AS ThereIsErrorApplicationWasNotCreated,
	(ScheduleOfPayments.PaymentDateOriginal &lt; ScheduleOfPayments.PaymentDate) AS ThereIsInitialPaymentDateLessThanRescheduledOne,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
		THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).CashCurrency = ScheduleOfPayments.Currency
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
		THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).CashCurrency = ScheduleOfPayments.Currency
		ELSE FALSE
	END AS ThereIsDifferenceBetweenPaymentCurrencyAndCashAccountAccount
	
INTO ScheduleOfPayments
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
	
WHERE
	ScheduleOfPayments.PaymentDate &lt;= &amp;EndingDate
	AND (ScheduleOfPayments.PlanningArea IN (&amp;PlanningAreas) OR &amp;DoNotFilterByPlanningAreas)
	AND ScheduleOfPayments.ScheduleRelevanceDate &gt;= &amp;CurrentDate
	AND NOT ScheduleOfPayments.Frozen
	AND ScheduleOfPayments.PaymentDate &gt;= &amp;StartDateForDisplayingOverduePayments
	
{WHERE
	ScheduleOfPayments.Organization.* AS Organization,
	ScheduleOfPayments.BankAccountCashAccount.* AS BankAccountCashAccount,
	ScheduleOfPayments.Currency.* AS Currency}
	
GROUP BY
	ScheduleOfPayments.BankAccountCashAccount,
	CASE
		WHEN ScheduleOfPayments.PaymentDate &lt; &amp;CurrentDate
		THEN DATEADD(&amp;CurrentDate, DAY, -1)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.YEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, YEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, YEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.HALFYEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, HALFYEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, HALFYEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.QUARTER)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, QUARTER)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, QUARTER)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.MONTH)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, MONTH)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, MONTH)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.TENDAYS)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, TENDAYS)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, TENDAYS)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.WEEK)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, WEEK)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, WEEK)
		ELSE ScheduleOfPayments.PaymentDate
	END,
	ScheduleOfPayments.ReceiptIssue,
	ScheduleOfPayments.Currency,
	ScheduleOfPayments.Organization,
	ScheduleOfPayments.PayerBeneficiary,
	ScheduleOfPayments.PaymentObject,
	ScheduleOfPayments.AmountType,
	ScheduleOfPayments.PaymentDate,
	ScheduleOfPayments.PaymentDateOriginal,
	ScheduleOfPayments.Frozen,
	DATEDIFF(ScheduleOfPayments.PaymentDate, &amp;CurrentDate, DAY)
	
UNION ALL

SELECT
	ScheduleOfPayments.BankAccountCashAccount,
	CASE
		WHEN ScheduleOfPayments.PaymentDate &lt; &amp;CurrentDate
		THEN DATEADD(&amp;CurrentDate, DAY, -1)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.YEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, YEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, YEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.HALFYEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, HALFYEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, HALFYEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.QUARTER)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, QUARTER)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, QUARTER)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.MONTH)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, MONTH)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, MONTH)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.TENDAYS)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, TENDAYS)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, TENDAYS)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.WEEK)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, WEEK)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, WEEK)
		ELSE ScheduleOfPayments.PaymentDate
	END AS PaymentDate,
	ScheduleOfPayments.ReceiptIssue,
	ScheduleOfPayments.Currency AS PaymentCurrency,
	ScheduleOfPayments.Organization,
	SUM(ScheduleOfPayments.Sum) AS Sum,
	ScheduleOfPayments.PayerBeneficiary,
	ScheduleOfPayments.PaymentObject,
	ScheduleOfPayments.AmountType,
	ScheduleOfPayments.PaymentDate,
	ScheduleOfPayments.Frozen,
	DATEDIFF(ScheduleOfPayments.PaymentDate, &amp;CurrentDate, DAY),
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest)
			OR VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.CashTransferReferenceOrder)
		THEN FALSE
		WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
		THEN
			CASE
				WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
				THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).EnableCreatingCashIssueWithoutPaymentRequest
				WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
				THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).EnableCreatingCashIssueWithoutPaymentRequest
				ELSE FALSE
			END
		ELSE FALSE
	END,
	(ScheduleOfPayments.PaymentDateOriginal &lt; ScheduleOfPayments.PaymentDate),
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
		THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).CashCurrency = ScheduleOfPayments.Currency
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
		THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).CashCurrency = ScheduleOfPayments.Currency
		ELSE FALSE
	END
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
	
WHERE
	ScheduleOfPayments.PaymentDate &lt;= &amp;EndingDate
	AND (ScheduleOfPayments.PlanningArea IN (&amp;PlanningAreas) OR &amp;DoNotFilterByPlanningAreas)
	AND ScheduleOfPayments.ScheduleRelevanceDate = DATETIME(1,1,1)
	AND NOT ScheduleOfPayments.Frozen
	AND ScheduleOfPayments.PaymentDate &gt;= &amp;StartDateForDisplayingOverduePayments
	
{WHERE
	ScheduleOfPayments.Organization.* AS Organization,
	ScheduleOfPayments.BankAccountCashAccount.* AS BankAccountCashAccount,
	ScheduleOfPayments.Currency.* AS Currency}
	
GROUP BY
	ScheduleOfPayments.BankAccountCashAccount,
	CASE
		WHEN ScheduleOfPayments.PaymentDate &lt; &amp;CurrentDate
		THEN DATEADD(&amp;CurrentDate, DAY, -1)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.YEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, YEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, YEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.HALFYEAR)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, HALFYEAR)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, HALFYEAR)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.QUARTER)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, QUARTER)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, QUARTER)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.MONTH)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, MONTH)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, MONTH)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.TENDAYS)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, TENDAYS)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, TENDAYS)
		WHEN &amp;LongTermPlanningTimeFence = VALUE(Enum.Periodicity.WEEK)
			AND ScheduleOfPayments.PaymentDate &gt; ENDOFPERIOD(&amp;EndDateOfPlanningByDay, WEEK)
		THEN BEGINOFPERIOD(ScheduleOfPayments.PaymentDate, WEEK)
		ELSE ScheduleOfPayments.PaymentDate
	END,
	ScheduleOfPayments.ReceiptIssue,
	ScheduleOfPayments.Currency,
	ScheduleOfPayments.Organization,
	ScheduleOfPayments.PayerBeneficiary,
	ScheduleOfPayments.PaymentObject,
	ScheduleOfPayments.AmountType,
	ScheduleOfPayments.PaymentDate,
	ScheduleOfPayments.PaymentDateOriginal,
	ScheduleOfPayments.Frozen,
	DATEDIFF(ScheduleOfPayments.PaymentDate, &amp;CurrentDate, DAY)
	
INDEX BY
	BankAccountCashAccount
;

//////////////////////////////////////////
SELECT
	BankAccountsCashAccounts.BankAccountCashAccount AS BankAccountCashAccount,
	BankAccountsCashAccounts.SeparateSDOAccount AS SeparateSDOAccount,
	ISNULL(CashBalances.Balance, 0) - BankAccountsCashAccounts.IrreducibleBalance AS Balance,
	ISNULL(CashBalances.Balance, 0) AS BalanceAndIrreducibleBalance,
	((ISNULL(CashBalances.Balance, 0) - BankAccountsCashAccounts.IrreducibleBalance)
		&lt; BankAccountsCashAccounts.CriticalBalance) AS BalanceErrorCriticalBalance,
	BankAccountsCashAccounts.IrreducibleBalance AS IrreducibleBalance,
	BankAccountsCashAccounts.CriticalBalance AS CriticalBalance,
	BankAccountsCashAccounts.CashAccountBank AS CashAccountBank,
	BankAccountsCashAccounts.CashType AS CashType,
	ISNULL(ScheduleOfPayments.PaymentDate, DATETIME(1,1,1)) AS PaymentDate,
	CashFlowTypes.Ref AS ReceiptIssue,
	ISNULL(BankAccountsCashAccounts.CashCurrency, ScheduleOfPayments.PaymentCurrency) AS Currency,
	ISNULL(BankAccountsCashAccounts.Organization, ScheduleOfPayments.Organization) AS Organization,
	ISNULL(CASE WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) THEN
		ScheduleOfPayments.Sum
	ELSE
		-ScheduleOfPayments.Sum
	END, 0) AS Sum,
	
	(ISNULL(CashBalances.Balance, 0) - BankAccountsCashAccounts.IrreducibleBalance) * ISNULL(ConversionRatesToOneCurrencyCash.ConversionRateToOneCurrency, 0) AS BalanceInASingleCurrency,
	ISNULL(CASE WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) THEN
		ScheduleOfPayments.Sum
	ELSE
		-ScheduleOfPayments.Sum
	END * ConversionRatesToOnePaymentCurrency.ConversionRateToOneCurrency, 0) AS TurnoverInOneCurrency,
	ISNULL(CASE WHEN ScheduleOfPayments.PaymentCurrency = BankAccountsCashAccounts.CashCurrency
		OR BankAccountsCashAccounts.CashCurrency IS NULL THEN
			CASE WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) THEN
				ScheduleOfPayments.Sum
			ELSE
				-ScheduleOfPayments.Sum
			END
		ELSE
			CASE WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) THEN
				ScheduleOfPayments.Sum
			ELSE
				-ScheduleOfPayments.Sum
			END * (ConversionRatesForPayments.CourseNumerator * CashConversionRates.CourseDenominator) / (CashConversionRates.CourseNumerator * ConversionRatesForPayments.CourseDenominator)
	END, 0) AS Turnover,
	ScheduleOfPayments.PayerBeneficiary AS PayerBeneficiary,
	ScheduleOfPayments.PaymentObject AS PaymentObject,
	ScheduleOfPayments.AmountType AS AmountType,
	ScheduleOfPayments.OriginalPaymentDate AS OriginalPaymentDate,
	ScheduleOfPayments.Frozen AS Frozen,
	ScheduleOfPayments.DaysOverdue_3,
	ISNULL(ScheduleOfPayments.ThereIsErrorApplicationWasNotCreated, FALSE) AS ThereIsErrorApplicationWasNotCreated,
	ISNULL(ScheduleOfPayments.ThereIsInitialPaymentDateLessThanRescheduledOne, FALSE) AS ThereIsInitialPaymentDateLessThanRescheduledOne,
	ISNULL(ScheduleOfPayments.ThereIsDifferenceBetweenPaymentCurrencyAndCashAccountAccount, FALSE) AS ThereIsDifferenceBetweenPaymentCurrencyAndCashAccountAccount
FROM
	BankAccountsCashAccounts
	
LEFT JOIN
	CashBalances
ON
	CashBalances.BankAccountCashAccount = BankAccountsCashAccounts.BankAccountCashAccount
	
LEFT JOIN
	Enum.CashFlowTypes AS CashFlowTypes
ON
	TRUE
	
LEFT JOIN
	ScheduleOfPayments
ON
	ScheduleOfPayments.BankAccountCashAccount = BankAccountsCashAccounts.BankAccountCashAccount
	AND ScheduleOfPayments.ReceiptIssue = CashFlowTypes.Ref
		
LEFT JOIN
	ConversionRatesToOneCurrency AS ConversionRatesToOnePaymentCurrency
ON
	ConversionRatesToOnePaymentCurrency.Currency = ScheduleOfPayments.PaymentCurrency
		
LEFT JOIN
	ConversionRates AS ConversionRatesForPayments
ON
	ConversionRatesForPayments.Currency = ScheduleOfPayments.PaymentCurrency
	
LEFT JOIN
	ConversionRatesToOneCurrency AS ConversionRatesToOneCurrencyCash
ON
	ConversionRatesToOneCurrencyCash.Currency = BankAccountsCashAccounts.CashCurrency
	
LEFT JOIN
	ConversionRates AS CashConversionRates
ON
	CashConversionRates.Currency = BankAccountsCashAccounts.CashCurrency
	
{WHERE
	BankAccountsCashAccounts.CashAccountBank AS Bank,
	BankAccountsCashAccounts.CashType AS CashType
}</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>OrderInCalendar</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>OrderValue</dataPath>
