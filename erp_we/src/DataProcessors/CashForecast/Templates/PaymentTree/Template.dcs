		<field xsi:type="DataSetFieldField">
			<dataPath>BalanceAndIrreducibleBalance</dataPath>
			<field>BalanceAndIrreducibleBalance</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Balance and minimum balance</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مانده و حداقل مانده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Остаток и неснижаемый остаток</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Bakiye ve asgari bakiye</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
