    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentsInTheCalendar.ThereIsErrorApplicationWasNotCreated</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentsInTheCalendar.ThereIsInitialPaymentDateLessThanRescheduledOne</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentsInTheCalendar.ТипСуммы</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ScheduleOfPayments.PaymentObject AS PaymentObject,
	ScheduleOfPayments.BankAccountCashAccount AS BankAccountCashAccount,
	ScheduleOfPayments.PaymentDate AS PaymentDate,
	ScheduleOfPayments.ReceiptIssue AS ReceiptIssue,
	ScheduleOfPayments.Currency AS Currency,
	CASE WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) THEN
		ScheduleOfPayments.Sum
	ELSE
		-ScheduleOfPayments.Sum
	END AS Sum,
	ScheduleOfPayments.CashFlowItem AS CashFlowItem,
	ScheduleOfPayments.BusinessOperation AS Operation,
	ScheduleOfPayments.Department AS Department,
	ScheduleOfPayments.LineOfBusiness AS LineOfBusiness,
	ScheduleOfPayments.Priority AS RequestPriority,
	ScheduleOfPayments.EmployeeResponsible AS EmployeeResponsible,
	ScheduleOfPayments.PaymentObjectType AS PaymentObjectType,
	VALUETYPE(ScheduleOfPayments.PaymentObject) AS TheObjectTypeOfPaymentName,
	ScheduleOfPayments.Number AS Number,
	ScheduleOfPayments.Date AS Date,
	ScheduleOfPayments.Organization AS Organization,
	ScheduleOfPayments.PayerBeneficiary AS PayerBeneficiary,
	ScheduleOfPayments.DocumentAmount AS DocumentAmount,
	ScheduleOfPayments.PaymentMethod AS PaymentMethod,
	ScheduleOfPayments.ScheduleRelevanceDate AS ScheduleRelevanceDate,
	ScheduleOfPayments.PlanningArea AS PlanningArea,
	ISNULL(CFItems.PaymentPriority, VALUE(Catalog.PaymentPriorities.EmptyRef)) AS CashFlowItemPriority,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest) THEN
			Request.PaymentPurposes
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PlannedCashReceipt) THEN
			ExpectedReceipt.PaymentPurposes
	END AS PaymentPurposes,
	Request.AmountPlanning AS AmountPlanning,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts) THEN
			CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).CashCurrency
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts) THEN
			CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).CashCurrency
		ELSE
			ScheduleOfPayments.Currency
	END AS PaymentCurrency,
	(ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)) AS IsWriteOff,
	ScheduleOfPayments.PaymentObject AS Ref,
	ScheduleOfPayments.Id IN (&amp;TaggedEntries) AS Check,
	ScheduleOfPayments.Id AS Id,
	ScheduleOfPayments.Status AS Status,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
		THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
		THEN VALUE(Enum.CashTypes.CashPayment)
	END CashType,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
		THEN CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).Bank
	END AS Bank,
	ScheduleOfPayments.Frozen AS Frozen,
	ScheduleOfPayments.OriginalBankAccountCashAccount AS OriginalBankAccountCashAccount,
	ScheduleOfPayments.PaymentDateOriginal AS PaymentDateOriginal,
	ScheduleOfPayments.InitialAmount_ AS InitialAmount_,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest)
			OR VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.CashTransferReferenceOrder)
		THEN FALSE
		WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
		THEN
			CASE
				WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
				THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).EnableCreatingCashIssueWithoutPaymentRequest
				WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
				THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).EnableCreatingCashIssueWithoutPaymentRequest
				ELSE FALSE
			END
		ELSE FALSE
	END AS ThereIsErrorApplicationWasNotCreated,
	(ScheduleOfPayments.PaymentDateOriginal &lt; ScheduleOfPayments.PaymentDate) AS ThereIsInitialPaymentDateLessThanRescheduledOne,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CompaniesBankAccounts)
		THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts).CashCurrency = ScheduleOfPayments.Currency
		WHEN VALUETYPE(ScheduleOfPayments.BankAccountCashAccount) = TYPE(Catalog.CashAccounts)
		THEN NOT CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts).CashCurrency = ScheduleOfPayments.Currency
		ELSE FALSE
	END AS ThereIsDifferenceBetweenPaymentCurrencyAndCashAccountAccount,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest)
		THEN Request.RequiredPaymentDate
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.ApplicationForBusinessTrip)
		THEN ApplicationForBusinessTrip.RequiredPaymentDate
		ELSE ScheduleOfPayments.PaymentDate
	END AS RequiredPaymentDate,
	(VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest)) AS IsARequest
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
	
	LEFT JOIN
		Document.PaymentRequest AS Request
	ON
		Request.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN
		Document.ApplicationForBusinessTrip AS ApplicationForBusinessTrip
	ON
		ApplicationForBusinessTrip.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN
		Document.CashTransferReferenceOrder AS ReferenceOrder
	ON
		ReferenceOrder.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN
		Document.PlannedCashReceipt AS ExpectedReceipt
	ON
		ExpectedReceipt.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN
		Catalog.CashFlowReportItems AS CFItems
	ON
		CFItems.Ref = ScheduleOfPayments.CashFlowItem

WHERE
	ScheduleOfPayments.PaymentDate >= &amp;StartDateForDisplayingOverduePayments

{WHERE
	ScheduleOfPayments.PlanningArea AS PlanningArea,
	CASE
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PaymentRequest) THEN
			Request.Status
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.CashTransferReferenceOrder) THEN
			ReferenceOrder.Status
		WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.ApplicationForBusinessTrip) THEN
			ApplicationForBusinessTrip.Status
		WHEN ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
		THEN VALUE(Enum.StatusesOfPaymentRequests.AmountDue)
	END AS RequestStatus_
}</queryText>
