      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.BankAccountCashAccount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Id</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.IsARequest</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.IsWriteOff</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.PayerBeneficiary</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.PaymentDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.PaymentObject</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.RequestStatus_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Sum</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.ПоступлениеСписание</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.ТипСуммы</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Request.Ref AS Ref,
	Request.Number AS Number,
	Request.Date AS Date,
	Request.Status AS RequestStatus_,
	Request.PaymentPriority AS RequestPriority,
	Request.PaymentPurposes AS PaymentPurposes,
	Request.DocumentAmount AS DocumentAmount,
	ScheduleOfPayments.Currency AS Currency,
	Request.RequiredPaymentDate AS RequiredPaymentDate,
	Request.BusinessOperation AS Operation,
	Request.Department AS Department,
	ScheduleOfPayments.PaymentObject AS PaymentObject,
	ScheduleOfPayments.PayerBeneficiary AS PayerBeneficiary,
	ScheduleOfPayments.Organization AS Organization,
	ScheduleOfPayments.BankAccountCashAccount AS BankAccountCashAccount,
	ScheduleOfPayments.PaymentDate AS PaymentDate,
	ScheduleOfPayments.Sum AS Sum,
	CASE
		WHEN ScheduleOfPayments.BankAccountCashAccount IN (
			VALUE(Catalog.CompaniesBankAccounts.EmptyRef),
			VALUE(Catalog.CashAccounts.EmptyRef),
			UNDEFINED)
		THEN ScheduleOfPayments.Sum
		ELSE 0
	END AS ForAllocation,
	ScheduleOfPayments.CashFlowItem AS CashFlowItem,
	ISNULL(CFItems.PaymentPriority, VALUE(Catalog.PaymentPriorities.EmptyRef)) AS CashFlowItemPriority,
	TRUE AS IsWriteOff,
	TRUE AS IsARequest,
	ScheduleOfPayments.Id IN (&amp;TaggedEntries) AS Check,
	ScheduleOfPayments.Id AS Id,
	ScheduleOfPayments.OriginalBankAccountCashAccount AS OriginalBankAccountCashAccount,
	ScheduleOfPayments.PaymentDateOriginal AS PaymentDateOriginal,
	ScheduleOfPayments.InitialAmount_ AS InitialAmount_,
	ScheduleOfPayments.Frozen AS Frozen,
	ScheduleOfPayments.Status AS Status
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments

LEFT JOIN
	Document.PaymentRequest AS Request
ON
	Request.Ref = ScheduleOfPayments.PaymentObject

LEFT JOIN
	Catalog.CashFlowReportItems AS CFItems
ON
	CFItems.Ref = ScheduleOfPayments.CashFlowItem

WHERE
	ScheduleOfPayments.PaymentObject REFS Document.PaymentRequest
	AND ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
	
{WHERE
	ScheduleOfPayments.PlanningArea AS PlanningArea,
	Request.Status AS RequestStatus_
}</queryText>
      <mainTable>InformationRegister.ScheduleOfPayments</mainTable>
