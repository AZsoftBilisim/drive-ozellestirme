  <attributes>
    <name>ListRDExpensesRecognition</name>
    <title>
      <key>en</key>
      <value>List R&amp;D expense recognition</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست شناسایی هزینه تحقیق و توسعه</value>
    </title>
    <title>
      <key>it</key>
