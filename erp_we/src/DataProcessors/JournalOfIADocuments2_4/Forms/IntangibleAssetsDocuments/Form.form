    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDetailed.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDetailed.RefType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDetailed.ShowDocumentTime</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	IntangibleAssetsDocuments.IntangibleAsset AS IntangibleAsset,
	IntangibleAssetsDocuments.Ref AS Ref,
	IntangibleAssetsDocuments.Organization AS Organization,
	IntangibleAssetsDocuments.Date AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	IntangibleAssetsDocuments.BusinessOperation AS BusinessOperation,
	IntangibleAssetsDocuments.Department AS Department,
	DocumentsRegistry.EmployeeResponsible AS EmployeeResponsible,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	IntangibleAssetsDocuments.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	CASE
		WHEN IntangibleAssetsDocuments.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	IntangibleAssetsDocuments.AdditionalRecord AS AdditionalRecord,
	IntangibleAssetsDocuments.RefType AS RefType,
	VALUETYPE(IntangibleAssetsDocuments.Ref) AS TheTypeOfReferenceDocument,
	CASE
		WHEN IntangibleAssetsDocuments.RecordInManAccounting
				AND IntangibleAssetsDocuments.Posted
			THEN 1
		WHEN IntangibleAssetsDocuments.RecordInManAccounting
				AND NOT IntangibleAssetsDocuments.Posted
			THEN 2
		ELSE 0
	END AS RecordInManAccounting,
	CASE
		WHEN IntangibleAssetsDocuments.RecordInLocalAccounting
				AND IntangibleAssetsDocuments.Posted
			THEN 1
		WHEN IntangibleAssetsDocuments.RecordInLocalAccounting
				AND NOT IntangibleAssetsDocuments.Posted
			THEN 2
		ELSE 0
	END AS RecordInLocalAccounting,
	CASE
		WHEN IntangibleAssetsDocuments.RecordInTA
				AND IntangibleAssetsDocuments.Posted
			THEN 1
		WHEN IntangibleAssetsDocuments.RecordInTA
				AND NOT IntangibleAssetsDocuments.Posted
			THEN 2
		ELSE 0
	END AS RecordInTA,
	CASE
		WHEN IntangibleAssetsDocuments.Date &lt; &amp;AccountingStartDate
				AND (IntangibleAssetsDocuments.Ref REFS Document.EntryOfCapitalAssetsBalance2_4
					OR IntangibleAssetsDocuments.Ref REFS Document.ChangeIntangibleAssetFinancialDetails2_4)
			THEN 1
		ELSE 0
	END AS CreatedToUpgradeToVersion24,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles,
	EDStatesOverridable.StatusPresentation AS StatusPresentation,
	&amp;ShowDocumentTime AS ShowDocumentTime
FROM
	InformationRegister.IntangibleAssetsDocuments AS IntangibleAssetsDocuments
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON (DocumentsRegistry.Ref = IntangibleAssetsDocuments.Ref)
			AND (NOT DocumentsRegistry.AdditionalRecord)
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON IntangibleAssetsDocuments.Ref = FilesExist.ObjectWithFiles
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON EDStatesOverridable.ObjectReference = IntangibleAssetsDocuments.Ref}
{WHERE
	IntangibleAssetsDocuments.IntangibleAsset.* AS FixedAsset,
	IntangibleAssetsDocuments.Ref.* AS Ref,
	IntangibleAssetsDocuments.Organization.* AS Organization,
	IntangibleAssetsDocuments.Date AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	IntangibleAssetsDocuments.BusinessOperation AS BusinessOperation,
	IntangibleAssetsDocuments.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	IntangibleAssetsDocuments.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	(IntangibleAssetsDocuments.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod)}</queryText>
      <mainTable>InformationRegister.IntangibleAssetsDocuments</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
