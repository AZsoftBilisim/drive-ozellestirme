  <attributes>
    <name>ListDepreciation</name>
    <title>
      <key>en</key>
      <value>List amortization</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست استهلاک دارایی نامشهود</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco ammortamento</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista amortyzacja</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список амортизация</value>
    </title>
    <title>
      <key>tr</key>
      <value>Amortisman listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách khấu hao</value>
    </title>
    <id>21</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDepreciation.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDepreciation.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentsRegistry.RefType AS RefType,
	VALUETYPE(DocumentsRegistry.Ref) AS TheTypeOfReferenceDocument,
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.Organization AS Organization,
	ISNULL(IntangibleAssetsAmortizationCharge.PackageNumber, 0) AS PackageNumber,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.EmployeeResponsible AS EmployeeResponsible,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.RecordID AS RecordID
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
		LEFT JOIN Document.IntangibleAssetsAmortizationCharge2_4 AS IntangibleAssetsAmortizationCharge
		ON (IntangibleAssetsAmortizationCharge.Ref = DocumentsRegistry.Ref)
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON DocumentsRegistry.Ref = FilesExist.ObjectWithFiles
WHERE
	(DocumentsRegistry.Ref IN
		(SELECT
			IntangibleAssetsAmortizationCharge.Recorder
		FROM
			AccumulationRegister.IntangibleAssetsAmortizationCharge AS IntangibleAssetsAmortizationCharge
		WHERE
			IntangibleAssetsAmortizationCharge.IntangibleAsset = &amp;IntangibleAsset

		UNION ALL

		SELECT
			IACost.Recorder
		FROM
			AccumulationRegister.IACost AS IACost
		WHERE
			IACost.IntangibleAsset = &amp;IntangibleAsset
			AND IACost.Recorder REFS Document.IntangibleAssetsAmortizationCharge2_4)
	OR &amp;WithoutSelectionForAnIntangibleAsset)
{WHERE
	DocumentsRegistry.Ref.* AS Ref,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	(DocumentsRegistry.IBDocumentDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod)}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
