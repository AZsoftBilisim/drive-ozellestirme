      <queryText>SELECT ALLOWED
	FALSE AS Overdue,
	TransferredPackageOverridable.DocumentTransfers_.ReusablePackagesReturnDate AS ReusablePackagesReturnDate,
	TransferredPackageOverridable.Products AS Products,
	TransferredPackageOverridable.Characteristic AS Characteristic,
	TransferredPackageOverridable.Partner AS Partner,
	TransferredPackageOverridable.DepositIsRequired AS DepositForPackageIsRequired,
	TransferredPackageOverridable.DocumentTransfers_ AS DocumentTransfers_,
	TransferredPackageOverridable.CountBalance AS CountBalance,
	TransferredPackageOverridable.QuantityByGBRNBalance AS QuantityByGBRNBalance,
	TransferredPackageOverridable.SumBalance AS SumBalance
FROM
	AccumulationRegister.TransferredReturnablePackaging.Balance AS TransferredPackageOverridable</queryText>
