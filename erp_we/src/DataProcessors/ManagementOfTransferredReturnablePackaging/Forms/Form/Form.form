    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentReturnablePackagingRedemptionByCustomer.Ref,
	DocumentReturnablePackagingRedemptionByCustomer.DeletionMark,
	DocumentReturnablePackagingRedemptionByCustomer.Number,
	DocumentReturnablePackagingRedemptionByCustomer.Date,
	DocumentReturnablePackagingRedemptionByCustomer.Posted,
	DocumentReturnablePackagingRedemptionByCustomer.CompanyBankAccount,
	DocumentReturnablePackagingRedemptionByCustomer.CounterpartyBankAccount,
	DocumentReturnablePackagingRedemptionByCustomer.ShipperBankAccount,
	DocumentReturnablePackagingRedemptionByCustomer.GoodsRecipientBankAccount,
	DocumentReturnablePackagingRedemptionByCustomer.CarrierBankAccount,
	DocumentReturnablePackagingRedemptionByCustomer.Currency,
	DocumentReturnablePackagingRedemptionByCustomer.ARAPCurrency,
	DocumentReturnablePackagingRedemptionByCustomer.Shipper,
	DocumentReturnablePackagingRedemptionByCustomer.GoodsRecipient,
	DocumentReturnablePackagingRedemptionByCustomer.PaymentDate,
	DocumentReturnablePackagingRedemptionByCustomer.LetterOfAuthorityIssuedBy,
	DocumentReturnablePackagingRedemptionByCustomer.PowerOfAttorneyDate,
	DocumentReturnablePackagingRedemptionByCustomer.PowerOfAttorneyPerson,
	DocumentReturnablePackagingRedemptionByCustomer.PowerOfAttorneyNumber,
	DocumentReturnablePackagingRedemptionByCustomer.Organization,
	DocumentReturnablePackagingRedemptionByCustomer.Counterparty,
	DocumentReturnablePackagingRedemptionByCustomer.Manager,
	DocumentReturnablePackagingRedemptionByCustomer.VATTaxation,
	DocumentReturnablePackagingRedemptionByCustomer.DocumentAmount,
	DocumentReturnablePackagingRedemptionByCustomer.Partner,
	DocumentReturnablePackagingRedemptionByCustomer.Carrier,
	DocumentReturnablePackagingRedemptionByCustomer.Department,
	DocumentReturnablePackagingRedemptionByCustomer.Terms,
	DocumentReturnablePackagingRedemptionByCustomer.AmountARAP,
	DocumentReturnablePackagingRedemptionByCustomer.Comment,
	DocumentReturnablePackagingRedemptionByCustomer.PaymentMethod,
	DocumentReturnablePackagingRedemptionByCustomer.PriceIncludesVAT,
	DocumentReturnablePackagingRedemptionByCustomer.CashAccount,
	DocumentReturnablePackagingRedemptionByCustomer.IssuiedBy,
	DocumentReturnablePackagingRedemptionByCustomer.IssuiedByJobTitle,
	DocumentReturnablePackagingRedemptionByCustomer.FinancialAccountingGroup,
	DocumentReturnablePackagingRedemptionByCustomer.Contract,
	DocumentReturnablePackagingRedemptionByCustomer.Basis,
	DocumentReturnablePackagingRedemptionByCustomer.Author,
	DocumentReturnablePackagingRedemptionByCustomer.ContactPerson,
	DocumentReturnablePackagingRedemptionByCustomer.ARAPObjectSettings,
	DocumentReturnablePackagingRedemptionByCustomer.SalesOpportunity,
	DocumentReturnablePackagingRedemptionByCustomer.Director,
	DocumentReturnablePackagingRedemptionByCustomer.ChiefAccountant,
	DocumentReturnablePackagingRedemptionByCustomer.InventoryOwnerAttributesAreSpecifiedManually,
	DocumentReturnablePackagingRedemptionByCustomer.DepositForPackageIsRequired,
	DocumentReturnablePackagingRedemptionByCustomer.ReferenceDocumentDateForPrintForms,
	DocumentReturnablePackagingRedemptionByCustomer.BaseDocumentNumber,
	DocumentReturnablePackagingRedemptionByCustomer.PaymentID,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
FROM
	Document.ReturnablePackagingRedemptionByCustomer AS DocumentReturnablePackagingRedemptionByCustomer
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentReturnablePackagingRedemptionByCustomer.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.ReturnablePackagingRedemptionByCustomer</mainTable>
