    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic,
	MAX(ItemPricesCrossSectionOfTheLatest.Price) AS Price,
	MAX(ItemPricesCrossSectionOfTheLatest.Package) AS Package,
	MAX(ItemPricesCrossSectionOfTheLatest.Currency) AS Currency
FROM
	InformationRegister.ItemsPrices.SliceLast(ENDOFPERIOD(&amp;Date, DAY), {Products.* AS Products, Characteristic.* AS Characteristic}) AS ItemPricesCrossSectionOfTheLatest

GROUP BY
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic</queryText>
      <mainTable>InformationRegister.ItemsPrices.SliceLast</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
