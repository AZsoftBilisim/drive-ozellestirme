    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.ItemVariantsAreUsed</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.ItemVariantsOwner</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.ItemsType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.PriceKind</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>FeatureList.SetPricingOption</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Ref,
	0 AS PictureIndex,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Enum.ItemsTypes.EmptyRef) AS ItemsType,
	VALUE(Catalog.ItemKinds.EmptyRef) AS ProductKind,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS UnitOfMeasure,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	&quot;&quot; AS Description,
	VALUE(Catalog.TypesOfPrices.EmptyRef) AS PriceKind,
	UNDEFINED AS ItemVariantsOwner,
	0 AS Price,
	0 AS InStockBalance,
	0 AS AvailableInBasicUnits,
	0 AS Available,
	0 AS AvailableInTheDirection,
	TRUE AS ItemVariantsAreUsed,
	FALSE AS DeletionMark,
	VALUE(Enum.SetPriceCalculationOptions.EmptyRef) AS SetPricingOption,
	FALSE AS ContainsGoods,
	FALSE AS ContainsServices
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics</queryText>
      <mainTable>Catalog.ItemsCharacteristics</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
