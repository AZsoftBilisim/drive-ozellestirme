  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>List</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CAST(&amp;Products AS Catalog.Products) AS Products,
	CAST(&amp;Characteristic AS Catalog.ItemsCharacteristics) AS Characteristic,
	CAST(&amp;Series AS Catalog.ItemsBatches) AS Series,
	CAST(&amp;Package AS Catalog.PackagesAndUnitsOfMeasure) AS Package
INTO GoodsTable
;
////////////////////////////////////////////////////////////////////////////////
 SELECT
	GoodsTable.Products AS Products,
	GoodsTable.Characteristic AS Characteristic,
	CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE GoodsTable.Characteristic.ItemsCharacteristicForPricing
	END AS PricingVariant,
	ISNULL(CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE GoodsTable.Series.ItemsBatchForPricing
	END, VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)) AS PricingBatch,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		ELSE GoodsTable.Package
	END AS PricingPackage
INTO FilterTable
FROM
	GoodsTable AS GoodsTable
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = GoodsTable.Products.ProductKind)

INDEX BY
	Products,
	PricingVariant,
	PricingBatch,
	PricingPackage
;
////////////////////////////////////////////////////////////////////////////////
 SELECT
	CatalogTypesOfPrices.Ref AS Ref,
	CASE
		WHEN NOT Partners.Ref IS NULL
			THEN Partners.Ref
		WHEN NOT TermsOfSale.Ref IS NULL
			THEN TermsOfSale.Ref
		WHEN NOT Warehouses.Ref IS NULL
			THEN Warehouses.Ref
		WHEN NOT StoreFormats.Ref IS NULL
			THEN StoreFormats.Ref
		ELSE VALUE(Catalog.Partners.EmptyRef)
	END AS ObjectForStoringSalesTermsAndConditions
INTO TableOfSelectionOfPriceTypes
FROM
	Catalog.TypesOfPrices AS CatalogTypesOfPrices
		LEFT JOIN Catalog.Partners AS Partners
		ON (CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForPartner))
		AND (Partners.PricesKind = CatalogTypesOfPrices.Ref
		OR Partners.SpecialPriceType = CatalogTypesOfPrices.Ref)
		LEFT JOIN Catalog.TermsOfSale AS TermsOfSale
		ON (CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForTermsOfSales))
		AND (CatalogTypesOfPrices.Ref = TermsOfSale.PricesKind
		OR CatalogTypesOfPrices.Ref = TermsOfSale.SpecialPriceType)
		LEFT JOIN Catalog.StoreFormats AS StoreFormats
		ON (CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForStoreFormat))
		AND (StoreFormats.RetailPriceType = CatalogTypesOfPrices.Ref
		OR StoreFormats.SpecialPriceType = CatalogTypesOfPrices.Ref)
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON (CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForWarehouse))
		AND (Warehouses.RetailPriceType = CatalogTypesOfPrices.Ref
		OR Warehouses.SpecialPriceType = CatalogTypesOfPrices.Ref)
{WHERE
	(CASE
		WHEN NOT Partners.Ref IS NULL
			THEN Partners.Ref
		WHEN NOT TermsOfSale.Ref IS NULL
			THEN TermsOfSale.Ref
		WHEN NOT Warehouses.Ref IS NULL
			THEN Warehouses.Ref
		WHEN NOT StoreFormats.Ref IS NULL
			THEN StoreFormats.Ref
		ELSE VALUE(Catalog.Partners.EmptyRef)
	END) AS ObjectForStoringSalesTermsAndConditions}
;
////////////////////////////////////////////////////////////////////////////////
 SELECT
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	FilterTable.Products AS Products,
	FilterTable.Characteristic AS Characteristic,
	MAX(ItemPricesCrossSectionOfTheLatest.Price) AS Price,
	MAX(ItemPricesCrossSectionOfTheLatest.Package) AS Package,
	MAX(ItemPricesCrossSectionOfTheLatest.Currency) AS Currency
FROM
	InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&amp;Date, DAY), (Products, PricingVariant,
		PricingBatch, PricingPackage) IN
		(SELECT
			T.Products,
			T.PricingVariant,
			T.PricingBatch,
			T.PricingPackage
		FROM
			FilterTable AS T)
	AND PriceKind IN
		(SELECT
			TypesOfPrices.Ref
		FROM
			TableOfSelectionOfPriceTypes AS TypesOfPrices)) AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN FilterTable AS FilterTable
		ON ItemPricesCrossSectionOfTheLatest.Products = FilterTable.Products
		AND ItemPricesCrossSectionOfTheLatest.PricingVariant = FilterTable.PricingVariant
		AND ItemPricesCrossSectionOfTheLatest.PricingBatch = FilterTable.PricingBatch
		AND ItemPricesCrossSectionOfTheLatest.PricingPackage = FilterTable.PricingPackage
GROUP BY
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	FilterTable.Products,
	FilterTable.Characteristic</queryText>
      <mainTable>InformationRegister.ItemsPrices25.SliceLast</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
