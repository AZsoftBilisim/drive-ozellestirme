						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Senza gruppi dell'articolo</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Bez grup nomenklatury</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
