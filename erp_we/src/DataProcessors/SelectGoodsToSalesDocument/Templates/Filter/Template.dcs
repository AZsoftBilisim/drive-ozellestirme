		<field xsi:type="DataSetFieldField">
			<dataPath>PriceKind</dataPath>
			<field>PriceKind</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>
// ATTENTION!
// THIS REQUEST IS USED ONLY TO GET DATA SELECTION AND LAYOUT SETTINGS

SELECT
	CatalogProducts.Ref   AS Products,
	CatalogCharacteristics.Ref AS Characteristic,
	
	ISNULL(ItemsPrices.Price, 0) AS Price,
	ItemsPrices.Package          AS Package,
	ItemsPrices.Currency            AS Currency,
	
	ISNULL(AllBalance.Count, 0) AS InStockBalance
FROM
	Catalog.Products AS CatalogProducts
		
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON TRUE
		
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast AS ItemsPrices
		ON (ItemsPrices.Products = CatalogProducts.Ref)}
		
		{LEFT JOIN InformationRegister.InventoryAllocation AS AllBalance
		ON (AllBalance.Products = CatalogProducts.Ref)}</query>
	</dataSet>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
