      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Department</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.DynamicStructure</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ItIsRequiredToPopulateByOperationsManually</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.OperationStatus</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.PendingSupply</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ProductionByThirdParty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ProductionProcessType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.State</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.SupplyState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.WorkPlanning</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	StagesOverridable.Ref,
	StagesOverridable.Date,
	StagesOverridable.Department,
	StagesOverridable.Status,
	StagesOverridable.Purpose,
	StagesOverridable.ProductionProcessType,
	StagesOverridable.ProductionByThirdParty,
	StagesOverridable.WorkPlanning,
	StagesOverridable.DynamicStructure,
	StagesOverridable.NumberOfPackagesPlan AS Products_,
	CASE
		WHEN StagesOverridable.PackagePlan = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN StagesOverridable.ProductionLot.MainProductProducts.UnitOfMeasure
		ELSE StagesOverridable.PackagePlan
	END AS ProductUnitOfMeasurement,
	&amp;PresentationStage AS PresentationStage,
	ScheduleOverridable.Begin AS Begin,
	ScheduleOverridable.Ending AS Ending,
	ScheduleOverridable.NextStageStart,
	CASE
		WHEN ISNULL(ScheduleOverridable.Ending, DATETIME(1, 1, 1)) &lt;> DATETIME(1, 1, 1)
				AND ENDOFPERIOD(ScheduleOverridable.Ending, DAY) &lt; &amp;CurrentDate
				AND StagesOverridable.Status &lt;> VALUE(Enum.StatusesOfProductionStages2_2.Completed)
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.JobsToProductionScheduleCalculation AS JobsOverridable
		WHERE
			NOT StagesOverridable.DynamicStructure
			AND JobsOverridable.ProductionStage = StagesOverridable.Ref
		
		UNION ALL
		
		SELECT TOP 1
			TRUE
		FROM
			InformationRegister.OrderStructureCalculationJobsProductionSchedule AS JobsOverridable
		WHERE
			StagesOverridable.DynamicStructure
			AND JobsOverridable.ProductionStage = StagesOverridable.Ref) AS CalculationIsRequired,
	ISNULL(ProductionStageStatesOverridable.RequiresOutputRegistration, FALSE) AS RegisterOutput,
	StagesOverridable.ItIsRequiredToPopulateByOperationsManually AS ItIsRequiredToPopulateByOperationsManually,
	ProductionStageStatesOverridable.OperationStatus AS OperationStatus,
	CASE
		WHEN StagesOverridable.ItIsRequiredToPopulateByOperationsManually
			THEN 3
		WHEN ProductionStageStatesOverridable.OperationStatus = VALUE(Enum.StatesOfProductionStageOperations.PendingOperationAssignment)
			THEN 0
		WHEN ProductionStageStatesOverridable.OperationStatus = VALUE(Enum.StatesOfProductionStageOperations.PendingCompletion)
			THEN 1
		WHEN ProductionStageStatesOverridable.OperationStatus = VALUE(Enum.StatesOfProductionStageOperations.Completed2)
			THEN 2
		ELSE -1
	END AS OperationStatusCode,
	CASE
		WHEN StagesOverridable.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
			THEN VALUE(Enum.ShopfloorLevelStagesStates.Completed)
		ELSE ProductionStageStatesOverridable.ShopfloorLevelStatus
	END AS State,
	CASE
		WHEN StagesOverridable.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
			THEN 5
		ELSE ProductionStageStatesOverridable.ShopfloorLevelStatusCode
	END AS StatusCode,
	ISNULL(ProductionStageStatesOverridable.SupplyState, UNDEFINED) AS SupplyState,
	ISNULL(ProductionStageStatesOverridable.SupplyState, UNDEFINED)
		= VALUE(Enum.SupplyStateOfProductionStage.PendingSupply) AS PendingSupply,
	ISNULL(StandardScheduleOfProductionStagesOverridable.DurationBeforeProductionIssue, StagesOverridable.DurationBeforeProductionIssue) AS DurationBeforeProductionIssue,
	StagesOverridable.ReferenceOrder.Priority.AddlOrderingAttribute AS OrderPriority_3,
	StagesOverridable.ReferenceOrder.Department.AddlOrderingAttribute AS DivisionPriority,
	StagesOverridable.ReferenceOrder.Queue AS OrderQueue
FROM
	Document.ProductionStage2_2 AS StagesOverridable
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOverridable
		ON StagesOverridable.ReferenceOrder = ScheduleOverridable.ProductionOrder
			AND StagesOverridable.Ref = ScheduleOverridable.Stage
			AND (ScheduleOverridable.ScheduleStatus = &amp;ScheduleStatus)
		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardScheduleOfProductionStagesOverridable
		ON StagesOverridable.Ref = StandardScheduleOfProductionStagesOverridable.ProductionStage
		LEFT JOIN InformationRegister.ProductionStageStates AS ProductionStageStatesOverridable
		ON StagesOverridable.Ref = ProductionStageStatesOverridable.Stage
WHERE
	StagesOverridable.Posted = TRUE
	AND NOT StagesOverridable.Status IN (VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated), VALUE(Enum.StatusesOfProductionStages2_2.Generated1))</queryText>
      <mainTable>Document.ProductionStage2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
