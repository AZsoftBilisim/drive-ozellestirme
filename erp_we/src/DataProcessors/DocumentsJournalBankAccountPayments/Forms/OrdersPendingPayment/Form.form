  <attributes>
    <name>OrdersPendingPayment</name>
    <title>
      <key>en</key>
      <value>Orders for payment</value>
    </title>
    <title>
      <key>fa</key>
      <value>سفارش‌های پرداخت</value>
    </title>
    <title>
