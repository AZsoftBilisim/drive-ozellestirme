  <attributes>
    <name>ListOfPayment</name>
    <title>
      <key>en</key>
      <value>Payment list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست پرداخت‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco pagamenti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista płatności</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список платежей</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ödeme listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách thanh toán</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfPayment.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfPayment.CounterpartyPresentation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfPayment.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfPayment.Posted</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfPayment.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>//Redefined in the module
 SELECT
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.Organization AS Organization,
	CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CompaniesBankAccounts) AS BankAccount,
	CASE
		WHEN DocumentsRegistry.RefType = &amp;IDOfTheObjectReceiptOfNonCashDS
		AND DocumentsRegistry.Ref REFS Document.ReversingEntry
			THEN DataOfReceiptsOfNonCashDSDIssuedByStorno.PaymentDocumentType
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDOfTheNonCashWriteOffOfDS
		AND DocumentsRegistry.Ref REFS Document.ReversingEntry
			THEN DataForDebitingNonCashDSDIssuedByTheStorno.PaymentDocumentType
		WHEN DocumentsRegistry.RefType = &amp;IDOfTheObjectReceiptOfNonCashDS
			THEN DataOnNonCashDSReceipts.PaymentDocumentType
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDOfTheNonCashWriteOffOfDS
			THEN TheseNonCashWriteOffOfDS.PaymentDocumentType
	END AS PaymentDocumentType,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	CASE
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Companies
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Companies)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Counterparties
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Persons
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Persons)
		ELSE UNDEFINED
	END AS Counterparty,
	DocumentsRegistry.Counterparty AS CounterpartyKey,
	DocumentsRegistry.Counterparty.Description AS CounterpartyPresentation,
	DocumentsRegistry.SourceDocumentDate AS IncomingDocumentDate,
	DocumentsRegistry.SourceDocumentNumber AS IncomingDocumentNumber,
	CASE DocumentsRegistry.RefType
		WHEN &amp;IDOfTheObjectReceiptOfNonCashDS
			THEN DocumentsRegistry.Sum
		WHEN &amp;IDOfTheRKOObject
			THEN DocumentsRegistry.Sum
		ELSE 0
	END AS OrderReceiptAmount,
	CASE DocumentsRegistry.RefType
		WHEN &amp;TheObjectIDOfTheNonCashWriteOffOfDS
			THEN DocumentsRegistry.Sum
		WHEN &amp;IDOfThePKOObject
			THEN DocumentsRegistry.Sum
		ELSE 0
	END AS DebitedAmount,
	DocumentsRegistry.Currency AS Currency,
	DocumentsRegistry.RecordingInAccountingDate &lt;> DATETIME(1, 1, 1) AS ProcessedByBank,
	DocumentsRegistry.RecordingInAccountingDate AS BankPostingDate,
	DocumentsRegistry.More AS PaymentPurposes,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.EmployeeResponsible AS EmployeeResponsible,
	DocumentsRegistry.Author AS Author,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistry.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistry.ReversedDocument
	END AS ReversedCorrectedDocument,
	VALUETYPE(DocumentsRegistry.Ref) AS Type,
	FALSE AS ThereAreErrorsInCheckingCounterparties,
	&amp;CheckStatus AS CheckStatus,
	&amp;CheckingIndicator AS CheckingIndicator,
	UNDEFINED AS State,
	1 AS ThePictureDirektBank,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	DocumentsRegistry.RecordID AS RecordID,
	DocumentsRegistry.RefType AS RefType
{WHERE
	DocumentsRegistry.Ref.* AS Ref,
	CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CompaniesBankAccounts).* AS BankAccount,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.RefType AS RefType,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Partner.* AS Partner,
	(CASE
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Companies
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Companies)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Counterparties
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Persons
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Persons)
		ELSE UNDEFINED
	END).* AS Counterparty,
	DocumentsRegistry.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.Author.* AS Author,
	DocumentsRegistry.More AS PaymentPurposes,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark}
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
		LEFT JOIN Document.BankAccountReceiptNote AS DataOnNonCashDSReceipts
		ON DataOnNonCashDSReceipts.Ref = DocumentsRegistry.Ref
		LEFT JOIN Document.BankAccountIssue AS TheseNonCashWriteOffOfDS
		ON TheseNonCashWriteOffOfDS.Ref = DocumentsRegistry.Ref
		LEFT JOIN Document.BankAccountReceiptNote AS DataOfReceiptsOfNonCashDSDIssuedByStorno
		ON DocumentsRegistry.ReversedDocument = DataOfReceiptsOfNonCashDSDIssuedByStorno.Ref
		LEFT JOIN Document.BankAccountIssue AS DataForDebitingNonCashDSDIssuedByTheStorno
		ON DocumentsRegistry.ReversedDocument = DataForDebitingNonCashDSDIssuedByTheStorno.Ref
WHERE
	DocumentsRegistry.RefType IN (&amp;IDOfTheObjectReceiptOfNonCashDS, &amp;TheObjectIDOfTheNonCashWriteOffOfDS, &amp;IDOfThePKOObject,
		&amp;IDOfTheRKOObject)
	AND VALUETYPE(DocumentsRegistry.StorageLocation.Key) = TYPE(Catalog.CompaniesBankAccounts)
	AND (DocumentsRegistry.RecordingInAccountingDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	OR &amp;EndOfPeriod = DATETIME(1, 1, 1)
	AND DocumentsRegistry.RecordingInAccountingDate >= &amp;BeginOfPeriod
	OR DocumentsRegistry.RecordingInAccountingDate = DATETIME(1, 1, 1))</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
