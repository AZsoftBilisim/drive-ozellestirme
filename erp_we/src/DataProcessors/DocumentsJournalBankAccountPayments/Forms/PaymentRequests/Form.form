  </attributes>
  <attributes>
    <name>PaymentRequests</name>
    <title>
      <key>en</key>
      <value>Requests for payment</value>
    </title>
    <title>
      <key>fa</key>
      <value>درخواست‌های پرداخت</value>
    </title>
    <title>
      <key>it</key>
      <value>Importo da pagare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wnioski do płatności</value>
    </title>
    <title>
      <key>ru</key>
      <value>Заявки к оплате</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ödeme talepleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Giấy đề nghị thanh toán</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UsePaymentRequests</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.CounterpartyPresentation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT TOP 1
	Priorities.Ref AS Priority
INTO MaximumPriority
FROM
	Catalog.PaymentPriorities AS Priorities
WHERE
	Priorities.AddlOrderingAttribute IN (
		SELECT
			MIN(Priorities.AddlOrderingAttribute)
		FROM
			Catalog.PaymentPriorities AS Priorities)
;

SELECT TOP 1
	Priorities.Ref AS Priority
INTO MinPriority
FROM
	Catalog.PaymentPriorities AS Priorities
WHERE
	Priorities.AddlOrderingAttribute IN (
		SELECT
			MAX(Priorities.AddlOrderingAttribute)
		FROM
			Catalog.PaymentPriorities AS Priorities)
;

SELECT
	ScheduleOfPayments.PaymentDate AS PaymentDate,
	ScheduleOfPayments.PayerBeneficiary AS Recipient,
	ScheduleOfPayments.PayerBeneficiary.Description AS CounterpartyPresentation,
	ScheduleOfPayments.Sum AS AmountToPay,
	ScheduleOfPayments.Currency AS Currency,
	
	ScheduleOfPayments.Number AS Number,
	ScheduleOfPayments.Date AS Date,
	ScheduleOfPayments.PaymentObjectType AS PaymentObjectType,
	ScheduleOfPayments.DocumentAmount AS DocumentAmount,
	ScheduleOfPayments.BankAccountCashAccount AS BankAccount,
	
	ScheduleOfPayments.BusinessOperation AS BusinessOperation,
	ScheduleOfPayments.CashFlowItem AS CashFlowItem,
	ScheduleOfPayments.Department AS Department,
	ScheduleOfPayments.LineOfBusiness AS LineOfBusiness,
	ScheduleOfPayments.EmployeeResponsible AS EmployeeResponsible,
	
	ScheduleOfPayments.Organization AS Organization,
	ScheduleOfPayments.ScheduleRelevanceDate AS ScheduleRelevanceDate,
	ScheduleOfPayments.PlanningArea AS PlanningArea,
	
	ScheduleOfPayments.PaymentObject AS Ref,
	
	CASE
		WHEN ScheduleOfPayments.Priority = MaximumPriority.Priority THEN
			0
		WHEN ScheduleOfPayments.Priority = MinPriority.Priority THEN
			2
		ELSE
			1
	END AS PictureOfPriority
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
	
	LEFT JOIN
		Document.PaymentRequest AS Request
	ON
		Request.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN
		Document.ApplicationForBusinessTrip AS ApplicationForBusinessTrip
	ON
		ApplicationForBusinessTrip.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN
		Document.CashTransferReferenceOrder AS ReferenceOrder
	ON
		ReferenceOrder.Ref = ScheduleOfPayments.PaymentObject
		
	LEFT JOIN MaximumPriority
	ON TRUE
	
	LEFT JOIN MinPriority
	ON TRUE
	
WHERE
	ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
	AND ScheduleOfPayments.PaymentDate &lt;= &amp;PaymentDate
	AND ScheduleOfPayments.PlanningArea IN (
		VALUE(Enum.PaymentPlanningAreas.CashPaymentRequests),
		VALUE(Enum.PaymentPlanningAreas.ReferencesForCashTransfer))
	AND (Request.Status = VALUE(Enum.StatusesOfPaymentRequests.AmountDue)
		OR ReferenceOrder.Status = VALUE(Enum.CashTransferOrderStatuses.AmountDue)
		OR ApplicationForBusinessTrip.Status = VALUE(Enum.EmployeeApplicationStatuses.AgreedUpon)
		)
	AND (ReferenceOrder.BusinessOperation IN (
		VALUE(Enum.BusinessTransactions.TransferCashToAnotherAccount),
		VALUE(Enum.BusinessTransactions.WithdrawalFromBankAccount))
		OR ReferenceOrder.Ref IS NULL)
	AND ScheduleOfPayments.PaymentMethod IN (
		VALUE(Enum.PaymentForms.BankAccountPayment),
		VALUE(Enum.PaymentForms.EmptyRef))</queryText>
      <mainTable>InformationRegister.ScheduleOfPayments</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
