#Region Private

#Region Client

&AtClient
Procedure Attachable_OnChangeAttribute(Item, ShouldRefreshInterface = True)
	
	ConstantName = OnChangeAttributeServer(Item.Name);
	
	If ShouldRefreshInterface Then
		RefreshInterface = True;
		AttachIdleHandler("RefreshApplicationInterface", 2, True);
	EndIf;
	
	If ConstantName <> "" Then
		Notify("Write_ConstantsSet", New Structure, ConstantName);
	EndIf;
	
EndProcedure

&AtClient
Procedure RefreshApplicationInterface()
	
	If RefreshInterface = True Then
		RefreshInterface = False;
		CommonClient.RefreshApplicationInterface();
	EndIf;
	
EndProcedure

#EndRegion

#Region ServerCall

&AtServer
Procedure OptionForConfiguringTransactionsServer()
	
	If OptionForSettingUpTransactionsBasedOnOperationalAccountingData = 1 Then
		ConstantsSet.SettingOfPostingByAccountingObjects = True;
		ConstantsSet.ConfigurePostingsForBusinessTransactions = False;
	Else
		ConstantsSet.SettingOfPostingByAccountingObjects = False;
		ConstantsSet.ConfigurePostingsForBusinessTransactions = True;
	EndIf;
	
	OnChangeAttributeServer(Items.SettingOfPostingByAccountingObjects.Name);
	OnChangeAttributeServer(Items.ConfigurePostingsForBusinessTransactions.Name);
	
EndProcedure

&AtServer
Function OnChangeAttributeServer(TagName)
	
	DataPathAttribute = Items[TagName].DataPath;
	
	ConstantName = SaveAttributeValue(DataPathAttribute);
	
	SetAvailability(DataPathAttribute);
	
	RefreshReusableValues();
	
	Return ConstantName;
	
EndFunction

#EndRegion

#Region Server

&AtServer
Function SaveAttributeValue(DataPathAttribute)
	
	// Storing the values of the details that are not directly related to the constants (in a one-to-one relationship).
	If DataPathAttribute = "" Then
		Return "";
	EndIf;
	
	// Definition of the constant name.
	ConstantName = "";
	If StrStartsWith(Lower(DataPathAttribute), Lower("ConstantsSet.")) Then
		// If the path to the data of the props is specified through the "Setconstant".
		NameParts = StrSplit(DataPathAttribute, ".");
		ConstantName = NameParts[1];
	Else
		// Defining the name and recording the value of the props in the corresponding constant from the "Setconstant".
		// It is used for those form details that are directly related to constants (in a one-to-one relationship).
	EndIf;
	
	// Saving the value of a constant.
	If ConstantName <> "" Then
		ConstantManager = Constants[ConstantName];
		ConstantValue = ConstantsSet[ConstantName];
		
		If ConstantManager.Get() <> ConstantValue Then
			ConstantManager.Set(ConstantValue);
		EndIf;
		
		If SystemSettingsCached.ThereAreSubordinateConstants(ConstantName, ConstantValue) Then
			ThisForm.Read();
		EndIf;
		
	EndIf;
	
	Return ConstantName
	
EndFunction

&AtServer
Procedure SetAvailability(DataPathAttribute = "")
	
	If DataPathAttribute = "ConstantsSet.UseFinancialAccounting"
		Or DataPathAttribute = "" Then
		ConstantValue = ConstantsSet.UseFinancialAccounting;
		Items.UseSeveralChartsOfAccountsInFinancialAccounting.Enabled = ConstantValue;
		Items.FinancialAccountingEntriesBasedOnOperationalAccountingData.Enabled = ConstantValue;
		Items.ImportAccountingModel.Enabled = ConstantValue;
		Items.ExportAccountingModelToFile.Enabled = ConstantValue;
		Items.SetUpPredefinedChartOfAccounts.Enabled = ConstantValue;
		
		ToSetPropertiesOfElementsYouNeedToConfigureAccountingCurrencies();
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseFinancialAccounting"
		Or DataPathAttribute = "ConstantsSet.FinancialAccountingEntriesBasedOnOperationalAccountingData"
		Or DataPathAttribute = "" Then
		
		BatchAccounting22 = CalculationOfCostCached.BatchAccountingVersion22();
		Production22 = Constants.UseProductionManagement2_2.Get();
		OnlineCalculations = Constants.NewOnlineARAPAccounting.Get();
		AccountingVNA24 = NonCurrentAssets.VNAManagementIsUsed()
			And NonCurrentAssets.VNAManagementIsUsed_2_4();
		
		ConstantValue = ConstantsSet.FinancialAccountingEntriesBasedOnOperationalAccountingData;
		
		Items.OptionForSettingUpTransactionsForAccountingObjects.Enabled = ConstantValue
			And BatchAccounting22 And Production22 And OnlineCalculations And AccountingVNA24;
		
		Items.GroupCommentSettingsForAccountingObjectsBatchAccounting.Visible = ConstantValue And Not BatchAccounting22;
		Items.GroupCommentSettingsForAccountingObjectsProduction.Visible = ConstantValue And Not Production22;
		Items.GroupCommentSettingsForAccountingObjectsSettlements.Visible = ConstantValue And Not OnlineCalculations;
		Items.GroupCommentSettingsForVNAAccountingObjects.Visible = ConstantValue And Not AccountingVNA24;
		
		If DataPathAttribute = "" Then
			Items.OptionForSettingUpTransactionsForBusinessOperations.Visible = True
				Or ThereArePostingTemplates() Or ConstantsSet.ConfigurePostingsForBusinessTransactions
				Or Not (BatchAccounting22 And Production22 And OnlineCalculations And AccountingVNA24);
		EndIf;
		
		If Items.OptionForSettingUpTransactionsForBusinessOperations.Visible Then
			Items.OptionForSettingUpTransactionsForBusinessOperations.Enabled = ConstantValue;
		EndIf;
		
	EndIf;
	
	If DataPathAttribute = "ConstantsSet.FinancialAccountingEntriesBasedOnOperationalAccountingData"
		Or DataPathAttribute = "ConstantsSet.ConfigurePostingsForBusinessTransactions"
		Or DataPathAttribute = "ConstantsSet.SettingOfPostingByAccountingObjects"
		Or DataPathAttribute = "" Then
		
		If ConstantsSet.ConfigurePostingsForBusinessTransactions Then
			OptionForSettingUpTransactionsBasedOnOperationalAccountingData = 2;
		Else
			OptionForSettingUpTransactionsBasedOnOperationalAccountingData = 1;
		EndIf;
		
	EndIf;
	
	
	If DataPathAttribute = "ConstantsSet.UseSeveralChartsOfAccountsInFinancialAccounting"
		Or DataPathAttribute = "" Then
		
		ConstantValue = ConstantsSet.UseSeveralChartsOfAccountsInFinancialAccounting;
		UsedVNA22 = NonCurrentAssets.VNAManagementIsUsed()
							And Not NonCurrentAssets.VNAManagementIsUsed_2_4();
		
		Items.ToOpenTheChartOfAccounts.Enabled = ConstantValue;
		
		RestrictionText = "";
		AvailabilityOfOption = True;
		If UsedVNA22 Then
			RestrictionText =  NStr("vi = 'Không thể phản ánh các giao dịch trên nhiều hệ thống tài khoản khi
									|sử dụng phương án ghi nhận tài sản dài hạn 2.2.';
									|ru = 'Отражение операций на нескольких плана счетов невозможно при
									|использовании варианта ведения учета внеоборотных активов 2.2.';
									|en = 'Recording of transaction on several charts of accounts is not available when 
									|using the fixed assets accounting option 2.2.'; fa = 'Recording of transaction on several charts of accounts is not available when 
									|using the fixed assets accounting option 2.2.';
									|it = 'Il riporto delle operazioni in alcuni piani dei conti non è possibile durante
									| l''utilizzo della variante di inserimento della contabilità degli attivi non correnti 2.2.';
									|pl = 'Odzwierciedlenie operacji na kilku planach kont niemożliwe jest w przypadku
									|używania wariantu prowadzenia ewidencji aktywów trwałych 2.2.';
									|tr = 'Duran varlıkların kayıtlarının tutulması seçeneği
									|kullanıldığında işlemlerin birden fazla hesap planına yansıması mümkün değildir. 2.2.'");
									
			AvailabilityOfOption = False;
		ElsIf Not ValueIsFilled(Catalogs.FinancialAccountingChartsOfAccounts.DefaultChartOfAccounts()) Then 
			RestrictionText = NStr("vi = 'Đã thêm nhiều hệ thống tài khoản kế toán quốc tế. Không thể tắt tùy chỉnh.';
									|ru = 'Добавлено несколько планов счетов международного учета. Отключение опции невозможно.';
									|en = 'Added several charts of accounts for financial accounting. This option cannot be disabled.'; fa = 'Added several charts of accounts for financial accounting. This option cannot be disabled.';
									|it = 'Sono stati aggiunti alcuni piani dei conti della contabilità internazionale. Impossibile disattivare le opzioni.';
									|pl = 'Dodano kilka planów kont ewidencji międzynarodowej. Odłączenie opcji jest niemożliwe.';
									|tr = 'Uluslararası muhasebe için çeşitli hesap planları eklendi. Seçenek devre dışı bırakılamaz.'");
			AvailabilityOfOption = False;
		EndIf;
		
		Items.UseSeveralChartsOfAccountsInFinancialAccounting.Enabled = AvailabilityOfOption;
		Items.TheGroupCanUseMultipleChartsOfAccountsInInternationalAccounting.Visible = Not AvailabilityOfOption;
		
		Items.CommentUseMultipleChartsOfAccountsInInternationalAccounting.Title = TrimAll(RestrictionText);
		
		If ConstantValue Then
			Items.PageGroupMultipleAccountPlans.CurrentPage = Items.AccountPlansHorizontalGroup;
		Else
			Items.PageGroupMultipleAccountPlans.CurrentPage = Items.GroupOneChartOfAccounts;
		EndIf;

	EndIf;
	
	If DataPathAttribute = "ConstantsSet.UseFinancialDocumentVerification" 
		Or DataPathAttribute = "" Then
		
		UseDocumentVerification = Constants.UseFinancialDocumentVerification.Get();
		
		Items.ReflectOnlyVerifiedDocumentsInInternationalAccounting.Enabled = UseDocumentVerification;
		Items.CommentGroupShouldReflectOnlyVerifiedDocumentsInAccounting.Visible = Not UseDocumentVerification;
		
	EndIf;
	
	SystemSettingsLocalization.EstablishAccessibility_InternationalFinancialAccounting(DataPathAttribute, ThisForm);
	
EndProcedure

&AtServer
Function ThereArePostingTemplates()
	
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	PostingTemplatesForFinancialAccounting.Ref AS Ref
	|FROM
	|	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplatesForFinancialAccounting
	|WHERE
	|	NOT PostingTemplatesForFinancialAccounting.DeletionMark";
	
	If Not Query.Execute().IsEmpty() Then
		Return True;
	EndIf;
	
	Return False;
	
EndFunction

&AtServer
Procedure ToSetPropertiesOfElementsYouNeedToConfigureAccountingCurrencies()
	
	YouNeedToSetUpAccountingCurrencies = False;
	
	If ConstantsSet.UseFinancialAccounting Then
		
		Query = New Query;
		Query.Text =
		"SELECT TOP 1
		|	TRUE
		|FROM
		|	Catalog.FinancialAccountingChartsOfAccounts AS Data
		|WHERE
		|	NOT Data.DeletionMark   	
		|	AND (Data.PresentationCurrency = VALUE(Catalog.Currencies.EmptyRef)
		|		OR Data.AccountingInFunctionalCurrency = VALUE(Enum.AccountingKindsInFunctionalCurrency.EmptyRef))
		|";
		YouNeedToSetUpAccountingCurrencies = Not Query.Execute().IsEmpty();
		
	EndIf;
	
	Items.PictureChartOfAccountsYouNeedToSetUpAccountingCurrencies.Visible = YouNeedToSetUpAccountingCurrencies;
	Items.PictureAccountPlansYouNeedToSetUpAccountingCurrencies.Visible = YouNeedToSetUpAccountingCurrencies;
	
	Items.ToOpenTheChartOfAccounts.TextColor = ?(YouNeedToSetUpAccountingCurrencies, StyleColors.OverdueDataColor, StyleColors.HyperlinkColor);
	Items.SetUpPredefinedChartOfAccounts.TextColor = ?(YouNeedToSetUpAccountingCurrencies, StyleColors.OverdueDataColor, StyleColors.HyperlinkColor);
	
EndProcedure

