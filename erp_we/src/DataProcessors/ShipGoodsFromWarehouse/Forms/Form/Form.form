    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentJournalGoodsReceiptIssue.Ref,
	DocumentJournalGoodsReceiptIssue.Date,
	DocumentJournalGoodsReceiptIssue.DeletionMark,
	DocumentJournalGoodsReceiptIssue.Number,
	DocumentJournalGoodsReceiptIssue.Posted,
	DocumentJournalGoodsReceiptIssue.Warehouse,
	DocumentJournalGoodsReceiptIssue.Status,
	DocumentJournalGoodsReceiptIssue.SenderWareroom,
	DocumentJournalGoodsReceiptIssue.ReceivingWareroom,
	DocumentJournalGoodsReceiptIssue.Priority,
	DocumentJournalGoodsReceiptIssue.DateOfShipment,
	DocumentJournalGoodsReceiptIssue.TransportationJob,
	DocumentJournalGoodsReceiptIssue.ShipmentUnderTransportationJob,
	DocumentJournalGoodsReceiptIssue.Comment,
	DocumentJournalGoodsReceiptIssue.RecipientSender,
	DocumentJournalGoodsReceiptIssue.DeliveryProcedure,
	EDStatesOverridable.StatusPresentation AS StatusPresentation,
	DocumentJournalGoodsReceiptIssue.Type
FROM
	DocumentJournal.GoodsReceiptIssue AS DocumentJournalGoodsReceiptIssue
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON (EDStatesOverridable.ObjectReference = DocumentJournalGoodsReceiptIssue.Ref)}</queryText>
