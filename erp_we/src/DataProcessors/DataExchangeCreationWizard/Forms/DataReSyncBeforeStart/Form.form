  <formCommands>
    <name>SyncAndContinue</name>
    <title>
      <key>en</key>
      <value>Synchronize and continue</value>
    </title>
    <title>
      <key>fa</key>
      <value>همگام‌سازی و ادامه</value>
    </title>
    <title>
      <key>it</key>
      <value>Sincronizzare e continuare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Synchronizuj i kontynuuj</value>
    </title>
    <title>
      <key>ru</key>
      <value>Синхронизировать и продолжить</value>
    </title>
    <title>
      <key>tr</key>
      <value>Senkronize et ve devam et</value>
    </title>
    <title>
      <key>vi</key>
      <value>Đồng bộ hóa và tiếp tục</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Receive a new message from the master node and continue application startup.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>دریافت پیام جدید از گره اصلی و ادامه راه‌اندازی برنامه.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Ottieni un nuovo messaggio dal nodo principale e continua l'avvio</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Pobierz nową wiadomość z węzła głównego i kontynuuj uruchomienie</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Получить новое сообщение из главного узла и продолжить запуск</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Ana düğümden yeni mesaj al ve uygulamayı başlatmaya devam et</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nhận thông báo mới từ nút chính và tiếp tục khởi động</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>SyncAndContinue</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
  </formCommands>
