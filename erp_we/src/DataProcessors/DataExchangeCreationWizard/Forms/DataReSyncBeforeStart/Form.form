      <key>it</key>
      <value>Completare il lavoro e di nuovo rivviare più tardi</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Zakończ robotę i powtórz uruchomienie później</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Завершить работу и повторить запуск позднее</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Kapat ve sonra yeniden başlat</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Kết thúc công việc và khởi động lại sau</value>
