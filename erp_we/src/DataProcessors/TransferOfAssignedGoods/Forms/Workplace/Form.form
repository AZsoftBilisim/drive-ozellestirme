  <attributes>
    <name>ListDocuments</name>
    <title>
      <key>en</key>
      <value>List documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco documenti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista dokumenty</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документы</value>
    </title>
    <title>
      <key>tr</key>
      <value>Belgeler listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ</value>
    </title>
    <id>14</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListDocuments.НеПоставленВГрафик</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE WHEN InventoryTransferOverridable.Posted THEN
				1
			WHEN InventoryTransferOverridable.DeletionMark THEN
				2
			ELSE
				0
		END                                                 AS RowPicture,
	InventoryTransferOverridable.Ref                 AS Ref,
	InventoryTransferOverridable.DeletionMark        AS DeletionMark,
	InventoryTransferOverridable.Number                  AS Number,
	InventoryTransferOverridable.Date                   AS Date,
	InventoryTransferOverridable.Posted               AS Posted,
	InventoryTransferOverridable.Organization            AS Organization,
	InventoryTransferOverridable.CompanyRecipient  AS CompanyRecipient,
	InventoryTransferOverridable.EmployeeResponsible          AS EmployeeResponsible,
	InventoryTransferOverridable.Department          AS Department,
	InventoryTransferOverridable.SourceWarehouse       AS SourceWarehouse,
	InventoryTransferOverridable.DestinationWarehouse        AS DestinationWarehouse,
	InventoryTransferOverridable.Status                 AS Status
FROM
	Document.InventoryTransfer AS InventoryTransferOverridable
WHERE
	InventoryTransferOverridable.Ref IN(&amp;Documents)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
