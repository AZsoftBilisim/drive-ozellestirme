    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
	RecordsWithExtDimensions.Period, 
	RecordsWithExtDimensions.Recorder, 
	RecordsWithExtDimensions.LineNumber, 
	RecordsWithExtDimensions.Active, 
	RecordsWithExtDimensions.Account, 
	RecordsWithExtDimensions.ExtDimension1, 
	RecordsWithExtDimensions.ExtDimensionType1, 
	RecordsWithExtDimensions.ExtDimension2, 
	RecordsWithExtDimensions.ExtDimensionType2, 
	RecordsWithExtDimensions.ExtDimension3, 
	RecordsWithExtDimensions.ExtDimensionType3, 
	RecordsWithExtDimensions.ChartOfAccounts, 
	RecordsWithExtDimensions.Organization, 
	RecordsWithExtDimensions.Department, 
	RecordsWithExtDimensions.Currency, 
	RecordsWithExtDimensions.LineOfBusiness, 
	RecordsWithExtDimensions.Sum, 
	RecordsWithExtDimensions.PresentationAmount, 
	RecordsWithExtDimensions.CurrencyAmount, 
	RecordsWithExtDimensions.Count, 
	RecordsWithExtDimensions.Content, 
	RecordsWithExtDimensions.PostingTemplate, 
	RecordsWithExtDimensions.PostingType, 
	RecordsWithExtDimensions.AccountCompliance, 
	RecordsWithExtDimensions.EqualityOfTurnoverTotals, 
	RecordsWithExtDimensions.ReversingEntry,
	RecordsWithExtDimensions.FinRecordID, 
	RecordsWithExtDimensions.BusinessTransactionSetting, 
	RecordsWithExtDimensions.PointInTime, 
	RecordsWithExtDimensions.RecordType,
	CASE WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Debit)
		THEN RecordsWithExtDimensions.Sum 
		ELSE 0
	END AS SumDr,
	CASE WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Credit)
		THEN RecordsWithExtDimensions.Sum 
		ELSE 0
	END AS SumCr,
	CASE WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Debit)
		THEN RecordsWithExtDimensions.PresentationAmount 
		ELSE 0
	END AS PresentationAmountDr,
	CASE WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Credit)
		THEN RecordsWithExtDimensions.PresentationAmount 
		ELSE 0
	END AS PresentationAmountCr,
	
	CASE
		WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Debit) AND RecordsWithExtDimensions.Active
			THEN 1
		WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Debit) AND NOT RecordsWithExtDimensions.Active
			THEN 3
		WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Credit) AND RecordsWithExtDimensions.Active
			THEN 2
		WHEN RecordsWithExtDimensions.RecordType = VALUE(AccountingRecordType.Credit) AND NOT RecordsWithExtDimensions.Active
			THEN 4
	END AS PictureIndex
FROM
	AccountingRegister.InternationalWithoutCorrespondence.RecordsWithExtDimensions AS RecordsWithExtDimensions</queryText>
      <mainTable>AccountingRegister.InternationalWithoutCorrespondence.RecordsWithExtDimensions</mainTable>
