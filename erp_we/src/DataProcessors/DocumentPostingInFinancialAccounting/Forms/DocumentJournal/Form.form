  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>List</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ChartOfAccounts</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Document</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DocumentPostingInFinancialAccounting.Recorder AS Document,
	VALUETYPE(DocumentPostingInFinancialAccounting.Recorder) AS DocumentType,
	DocumentPostingInFinancialAccounting.Period AS Date,
	DocumentPostingInFinancialAccounting.Organization AS Organization,
	DocumentPostingInFinancialAccounting.ChartOfAccounts AS ChartOfAccounts,
	DocumentPostingInFinancialAccounting.Status AS ReflectionStatus,
	CASE
		WHEN &amp;ThereIsLock
					AND StatusOfDocumentVerification.CheckStatus = VALUE(Enum.StatusOfFinancialDocumentVerification.ToReCheck)
			THEN VALUE(Enum.StatusOfFinancialDocumentVerification.NotVerified)
		ELSE ISNULL(StatusOfDocumentVerification.CheckStatus, VALUE(Enum.StatusOfFinancialDocumentVerification.EmptyRef))
	END AS CheckStatus,
	ISNULL(StatusOfDocumentVerification.WhoChecked, VALUE(Catalog.Users.EmptyRef)) AS AuthorOfDocumentVerification,
	ISNULL(StatusOfDocumentVerification.ChangedBy, VALUE(Catalog.Users.EmptyRef)) AS AuthorOfDocumentChange,
	ISNULL(StatusOfDocumentVerification.CheckDate, DATETIME(1, 1, 1)) AS DocumentVerificationDate,
	ISNULL(StatusOfDocumentVerification.ChangeDate, DATETIME(1, 1, 1)) AS DocumentChangingDate,
	ISNULL(DocumentsRegistry.IBDocumentNumber, &quot;&quot;) AS Number,
	ISNULL(DocumentsRegistry.Author, VALUE(Catalog.Users.EmptyRef)) AS Author,
	ISNULL(DocumentsRegistry.Contract, VALUE(Catalog.CounterpartyContracts.EmptyRef)) AS Contract,
	ISNULL(CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CashAccounts), VALUE(Catalog.CashAccounts.EmptyRef)) AS CashAccount,
	ISNULL(CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties), VALUE(Catalog.Counterparties.EmptyRef)) AS Counterparty,
	ISNULL(DocumentsRegistry.Partner, VALUE(Catalog.Partners.EmptyRef)) AS Partner,
	ISNULL(CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.Warehouses), VALUE(Catalog.Warehouses.EmptyRef)) AS Warehouse,
	ISNULL(DocumentsRegistry.BusinessOperation, VALUE(Enum.BusinessTransactions.EmptyRef)) AS BusinessOperation,
	ISNULL(DocumentsRegistry.Sum, 0) AS DocumentAmount,
	ISNULL(DocumentsRegistry.Currency, VALUE(Catalog.Currencies.EmptyRef)) AS Currency,
	DocumentPostingInFinancialAccounting.DateRecord AS DateRecord
FROM
	InformationRegister.DocumentPostingInFinancialAccounting AS DocumentPostingInFinancialAccounting
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON (DocumentPostingInFinancialAccounting.Period = DocumentsRegistry.IBDocumentDate)
			AND (DocumentPostingInFinancialAccounting.Recorder = DocumentsRegistry.Ref)
			AND (NOT DocumentsRegistry.AdditionalRecord)
		LEFT JOIN InformationRegister.StatusOfDocumentVerification AS StatusOfDocumentVerification
		ON (DocumentPostingInFinancialAccounting.Organization = StatusOfDocumentVerification.Organization)
			AND (DocumentPostingInFinancialAccounting.Recorder = StatusOfDocumentVerification.Document)
			AND VALUETYPE(DocumentPostingInFinancialAccounting.Recorder) IN (&amp;ListOfTypesToBeChecked)
{WHERE
	(DocumentPostingInFinancialAccounting.DateRecord >= &amp;BeginOfPeriod),
	(DocumentPostingInFinancialAccounting.DateRecord &lt;= &amp;EndOfPeriod),
	DocumentPostingInFinancialAccounting.Status AS ReflectionStatus,
	DocumentPostingInFinancialAccounting.Recorder.* AS Document,
	DocumentPostingInFinancialAccounting.Organization.*,
	DocumentPostingInFinancialAccounting.ChartOfAccounts.*,
	VALUETYPE(DocumentPostingInFinancialAccounting.Recorder) AS DocumentType}</queryText>
      <mainTable>InformationRegister.DocumentPostingInFinancialAccounting</mainTable>
