  <attributes>
    <name>ControlledInventoryList</name>
    <title>
      <key>en</key>
      <value>Controlled inventory list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست موجودی کنترل‌شده</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco di scorte supportate</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista podtrzymywanych zapasów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список поддерживаемых запасов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Desteklenen stokların listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách vật tư hỗ trợ</value>
    </title>
    <id>36</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.Characteristic</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.CoveredPeriodOption</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.Group</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.ItemVariantsAreUsed</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.ThisIsTheRecommendationMode</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ControlledInventoryList.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	ProductRestrictionsOverridable.GroupingProductRestrictions AS GroupingProductRestrictions,
	ProductRestrictionsOverridable.Products AS Products,
	ProductRestrictionsOverridable.Characteristic AS Characteristic,
	CatProducts.UnitOfMeasure AS UnitOfMeasure,
	ProductRestrictionsOverridable.Warehouse AS Warehouse,
	ISNULL(SettingUpAGrouping.InventoryReplenishmentMethod, ProductRestrictionsOverridable.InventoryReplenishmentMethod) AS InventoryLevelControl,
	ISNULL(SettingUpAGrouping.MinimumInventoryQuantity, ProductRestrictionsOverridable.MinimumInventoryQuantity) AS MinimumInventory,
	ISNULL(SettingUpAGrouping.MaximumInventoryAmount, ProductRestrictionsOverridable.MaximumInventoryAmount) AS MaximumInventory,
	ISNULL(SettingUpAGrouping.SafetyStockQuantity, ProductRestrictionsOverridable.SafetyStockQuantity) AS SafetyStock,
	ISNULL(SettingUpAGrouping.ConsumptionRate, ProductRestrictionsOverridable.ConsumptionRate) AS ConsumptionRate,
	ISNULL(SettingUpAGrouping.OrderFulfillmentWithinInventoryReplenishment, ProductRestrictionsOverridable.OrderFulfillmentWithinInventoryReplenishment) AS OrderFulfillment,
	ProductRestrictionsOverridable.AverageDailyConsumption AS AverageDailyConsumption,
	CASE
		WHEN ProductRestrictionsOverridable.AverageDailyConsumption > 0
			THEN ProductRestrictionsOverridable.AverageConsumptionVariance / ProductRestrictionsOverridable.AverageDailyConsumption * 100
		ELSE 0
	END AS DeviationOfConsumption,
	CASE
		WHEN ProductRestrictionsOverridable.AverageDailyConsumption > 0
				AND ProductRestrictionsOverridable.AverageConsumptionVariance &lt; 0.05 * ProductRestrictionsOverridable.AverageDailyConsumption
			THEN &amp;RecommendationToSupport
		ELSE &amp;RecommendationNotToSupport
	END AS Recommendation,
	CatMethod.Ref AS SupplyMethod,
	CatMethod.OrderFulfillmentPeriod AS DeliveryPeriodDays,
	CatMethod.CoveredPeriod AS CoveredPeriod,
	CatMethod.CoveredPeriodOption AS CoveredPeriodOption,
	CatMethod.SourceOfDemandSupply AS SupplySource,
	CatMethod.SupplyType AS SupplyType,
	CatProducts.SupplyScheme AS SupplyScheme,
	CatFormats.StoreFormat AS StoreFormat,
	ProductRestrictionsOverridable.ThisIsAGrouping AS IsFolder,
	CatProducts.UseVariants &lt;> VALUE(Enum.ItemVariantsUsageOptions.DontUse) AS ItemVariantsAreUsed,
	CASE
		WHEN ProductRestrictionsOverridable.ThisIsAGrouping
			THEN &amp;ViewMode
		WHEN ProductRestrictionsOverridable.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
				AND CatProducts.UseVariants &lt;> VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN 4
		ELSE 3
	END AS Picture,
	&amp;ThisIsTheRecommendationMode AS ThisIsTheRecommendationMode,
	TRUE AS TrueField
{SELECT
	GroupingProductRestrictions.*,
	Products.*,
	Characteristic.*,
	UnitOfMeasure.*,
	Warehouse.*,
	InventoryLevelControl,
	MinimumInventory,
	MaximumInventory,
	SafetyStock,
	ConsumptionRate,
	OrderFulfillment,
	AverageDailyConsumption,
	DeviationOfConsumption,
	Recommendation,
	DeliveryPeriodDays,
	CoveredPeriod,
	CoveredPeriodOption,
	SupplySource.*}
FROM
	InformationRegister.ProductRestrictions AS ProductRestrictionsOverridable
		LEFT JOIN Catalog.Products AS CatProducts
		ON ProductRestrictionsOverridable.Products = CatProducts.Ref
		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(, ) AS CatFormats
		ON (CatFormats.Warehouse = ProductRestrictionsOverridable.Warehouse)
		LEFT JOIN InformationRegister.GoodsProcurementStrategy AS TableOptionsForProvidingGoods
		ON (TableOptionsForProvidingGoods.Products = ProductRestrictionsOverridable.Products)
			AND (TableOptionsForProvidingGoods.Characteristic = ProductRestrictionsOverridable.Characteristic)
			AND (TableOptionsForProvidingGoods.Warehouse = ProductRestrictionsOverridable.Warehouse)
			AND (TableOptionsForProvidingGoods.AddlOrderingAttribute = 1)
		LEFT JOIN InformationRegister.SupplySchemes AS TableOfWarehouseSupportSchemes
		ON (TableOfWarehouseSupportSchemes.SupplyScheme = CatProducts.SupplyScheme)
			AND (TableOfWarehouseSupportSchemes.Warehouse = ProductRestrictionsOverridable.Warehouse)
			AND (TableOptionsForProvidingGoods.Products IS NULL)
		LEFT JOIN InformationRegister.SupplySchemes AS TableOfTheFormatSupportScheme
		ON (TableOfTheFormatSupportScheme.SupplyScheme = CatProducts.SupplyScheme)
			AND (TableOfTheFormatSupportScheme.Warehouse = CatFormats.StoreFormat)
			AND (TableOfWarehouseSupportSchemes.SupplyScheme IS NULL)
			AND (TableOptionsForProvidingGoods.Products IS NULL)
		LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		ON (ISNULL(TableOptionsForProvidingGoods.ProcurementStrategy, ISNULL(TableOfWarehouseSupportSchemes.ProcurementStrategy, ISNULL(TableOfTheFormatSupportScheme.ProcurementStrategy, VALUE(Catalog.ProcurementStrategies.EmptyRef)))) = CatMethod.Ref)
		LEFT JOIN InformationRegister.ProductRestrictions AS SettingUpAGrouping
		ON (SettingUpAGrouping.Products = VALUE(Catalog.Products.EmptyRef))
			AND (SettingUpAGrouping.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef))
			AND (SettingUpAGrouping.Warehouse = VALUE(Catalog.Warehouses.EmptyRef))
			AND (SettingUpAGrouping.GroupingProductRestrictions = ProductRestrictionsOverridable.GroupingProductRestrictions)
			AND (SettingUpAGrouping.ThisIsAValidParameter)
WHERE
	&amp;DisplayMode
	AND &amp;RecommendationMode
{WHERE
	(CatProducts.ProductCategory = &amp;ProductCategory
			OR ProductRestrictionsOverridable.ThisIsAGrouping),
	(CatFormats.StoreFormat = &amp;StoreFormat
			OR ProductRestrictionsOverridable.ThisIsAGrouping),
	((ProductRestrictionsOverridable.Products, ProductRestrictionsOverridable.Warehouse) IN
			(SELECT
				ChangingProductRange.Products AS Products,
				ISNULL(Formats.Warehouse, ProductRangeChange.PlanningObject) AS Warehouse
			FROM
				Document.ProductRangeChange AS ProductRangeChange
					LEFT JOIN Document.ProductRangeChange.Goods AS ChangingProductRange
					ON
						ChangingProductRange.Ref = ProductRangeChange.Ref
					LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast AS Formats
					ON
						Formats.StoreFormat = ProductRangeChange.PlanningObject
			WHERE
				ProductRangeChange.Ref = &amp;ProductRangeChangeDocument)),
	ProductRestrictionsOverridable.Products.* AS Products,
	ProductRestrictionsOverridable.Characteristic.* AS Characteristic,
	CatProducts.UnitOfMeasure.* AS UnitOfMeasure,
	ProductRestrictionsOverridable.Warehouse.* AS Warehouse,
	(ISNULL(SettingUpAGrouping.InventoryReplenishmentMethod, ProductRestrictionsOverridable.InventoryReplenishmentMethod)).* AS InventoryLevelControl,
	(ISNULL(SettingUpAGrouping.MinimumInventoryQuantity, ProductRestrictionsOverridable.MinimumInventoryQuantity)) AS MinimumInventory,
	(ISNULL(SettingUpAGrouping.MaximumInventoryAmount, ProductRestrictionsOverridable.MaximumInventoryAmount)) AS MaximumInventory,
	(ISNULL(SettingUpAGrouping.SafetyStockQuantity, ProductRestrictionsOverridable.SafetyStockQuantity)) AS SafetyStock,
	(ISNULL(SettingUpAGrouping.ConsumptionRate, ProductRestrictionsOverridable.ConsumptionRate)) AS ConsumptionRate,
	(ISNULL(SettingUpAGrouping.OrderFulfillmentWithinInventoryReplenishment, ProductRestrictionsOverridable.OrderFulfillmentWithinInventoryReplenishment)).* AS OrderFulfillment,
	ProductRestrictionsOverridable.AverageDailyConsumption AS AverageDailyConsumption,
	(CASE
			WHEN ProductRestrictionsOverridable.AverageDailyConsumption > 0
				THEN ProductRestrictionsOverridable.AverageConsumptionVariance / ProductRestrictionsOverridable.AverageDailyConsumption * 100
			ELSE 0
		END) AS DeviationOfConsumption,
	(CASE
			WHEN ProductRestrictionsOverridable.AverageDailyConsumption > 0
					AND ProductRestrictionsOverridable.AverageConsumptionVariance / ProductRestrictionsOverridable.AverageDailyConsumption &lt; 0.05
				THEN &amp;RecommendationToSupport
			ELSE &amp;RecommendationNotToSupport
		END) AS Recommendation,
	CatMethod.Ref.* AS SupplyMethod,
	CatMethod.OrderFulfillmentPeriod AS DeliveryPeriodDays,
	CatMethod.CoveredPeriod AS CoveredPeriod,
	CatMethod.CoveredPeriodOption AS CoveredPeriodOption,
	CatMethod.SourceOfDemandSupply.* AS SupplySource,
	CatMethod.SupplyType.* AS SupplyType,
	CatProducts.SupplyScheme.* AS SupplyScheme,
	CatFormats.StoreFormat.* AS StoreFormat,
	(CatProducts.UseVariants &lt;> VALUE(Enum.ItemVariantsUsageOptions.DontUse)) AS ItemVariantsAreUsed}</queryText>
      <mainTable>InformationRegister.ProductRestrictions</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
