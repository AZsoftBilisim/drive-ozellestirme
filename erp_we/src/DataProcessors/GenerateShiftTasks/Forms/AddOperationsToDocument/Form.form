    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RegisterOverridable.Department AS Department,
	RegisterOverridable.ShiftTask AS ShiftTask,
	RegisterOverridable.Stage AS Stage,
	RegisterOverridable.Operation AS Operation,
	RegisterOverridable.OperationID AS OperationID,
	RegisterOverridable.Performer AS Performer,
	ISNULL(RegisterOverridable.Operation.ProductionArea, VALUE(Catalog.ProductionSites.EmptyRef)) AS ProductionArea,
	RegisterOverridable.WorkCenter AS WorkCenter,
	RegisterOverridable.WorkCenterType AS WorkCenterType,
	RegisterOverridable.WorkCenterType.ParallelLoad AS ParallelLoad,
	ISNULL(RegisterOverridable.WorkCenter.WorkTimeFactor, 1) AS WorkTimeFactor,
	RegisterOverridable.AssignNotEarlierThan AS AssignNotEarlierThan,
	RegisterOverridable.Count AS Count,
	&amp;RunTime AS RunTime,
	RegisterOverridable.TimeUnitsOfMeasure AS ExecutionTimeUnitOfMeasure,
	RegisterOverridable.TimePerPiece AS TimePerPiece,
	RegisterOverridable.SetupTime AS SetupTime,
	RegisterOverridable.AssignmentIsAllowed AS AssignmentIsAllowed,
	RegisterOverridable.ToBeAssigned AS ToBeAssigned,
	RegisterOverridable.ReferenceOrder AS ReferenceOrder,
	RegisterOverridable.OperationNumber AS OperationNumber,
	RegisterOverridable.NextOperation AS NextOperation,
	RegisterOverridable.Stage.Stage AS BOMStage,
	RegisterOverridable.Stage.ProductionLot AS ProductionLot,
	ISNULL(RegisterOverridable.Operation.Count, 1) AS NumberOfPieces,
	ISNULL(RegisterOverridable.Operation.Description, QueueOverridable.ProductionOperation.Description) AS Description,
	ISNULL(RegisterOverridable.Operation.SetupSettings, QueueOverridable.ProductionOperation.SetupSettings) AS SetupSettings,
	RegisterOverridable.Stage.ProductionLot.MainProductProducts AS Products,
	RegisterOverridable.Stage.ProductionLot.MainProductCharacteristic AS Characteristic,
	ISNULL(WorkCentersOverridable.ProductionArea, VALUE(Catalog.ProductionSites.EmptyRef)) AS SectionOfWorkCenter,
	QueueOverridable.ProductionOperation AS ProductionOperation,
	QueueOverridable.JobTitle AS JobTitle,
	QueueOverridable.Digit AS Digit,
	&amp;PresentationStage AS PresentationStage
FROM
	InformationRegister.OperationsToCreateShiftTasks AS RegisterOverridable
		LEFT JOIN Catalog.WorkCenters AS WorkCentersOverridable
		ON RegisterOverridable.WorkCenter = WorkCentersOverridable.Ref
		LEFT JOIN InformationRegister.QueueOfProductionOperations AS QueueOverridable
		ON RegisterOverridable.Stage = QueueOverridable.Stage
		AND RegisterOverridable.Operation = QueueOverridable.Operation
		AND RegisterOverridable.OperationID = QueueOverridable.OperationID
		AND QueueOverridable.MainEntry_</queryText>
      <mainTable>InformationRegister.OperationsToCreateShiftTasks</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
