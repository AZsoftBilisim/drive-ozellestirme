    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Characteristic</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Digit</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.ExecutionTimeUnitOfMeasure</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.JobTitle</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Operation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.PresentationStage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.ReferenceOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.ShiftTask</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Stage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.WorkCenter</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.WorkCenterType</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RegisterOverridable.Department AS Department,
	RegisterOverridable.Stage AS Stage,
	RegisterOverridable.Stage.ProductionLot.MainProductProducts AS Products,
	RegisterOverridable.Stage.ProductionLot.MainProductCharacteristic AS Characteristic,
	RegisterOverridable.Operation AS Operation,
	ISNULL(RegisterOverridable.Operation.Description, QueueOverridable.ProductionOperation.Description) AS Description,
	RegisterOverridable.OperationID AS OperationID,
	RegisterOverridable.ShiftTask AS ShiftTask,
	RegisterOverridable.Performer AS Performer,
	RegisterOverridable.WorkCenter AS WorkCenter,
	RegisterOverridable.WorkCenterType AS WorkCenterType,
	RegisterOverridable.AssignNotEarlierThan AS AssignNotEarlierThan,
	RegisterOverridable.Count AS Count,
	&amp;RunTime AS RunTime,
	RegisterOverridable.TimeUnitsOfMeasure AS ExecutionTimeUnitOfMeasure,
	RegisterOverridable.AssignmentIsAllowed AS AssignmentIsAllowed,
	RegisterOverridable.ToBeAssigned AS ToBeAssigned,
	RegisterOverridable.AssignmentProcedureIsViolated AS AssignmentProcedureIsViolated,
	RegisterOverridable.ReferenceOrder AS ReferenceOrder,
	RegisterOverridable.OperationNumber AS OperationNumber,
	RegisterOverridable.NextOperation AS NextOperation,
	QueueOverridable.JobTitle AS JobTitle,
	QueueOverridable.Digit AS Digit,
	ScheduleOfProductionStages2_2.Begin AS StageStart,
	ScheduleOfProductionStages2_2.Ending AS StageEnd,
	&amp;PresentationStage AS PresentationStage
FROM
	InformationRegister.OperationsToCreateShiftTasks AS RegisterOverridable
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
	ON RegisterOverridable.ReferenceOrder = ScheduleOfProductionStages2_2.ProductionOrder
		AND RegisterOverridable.Stage = ScheduleOfProductionStages2_2.Stage
		AND ScheduleOfProductionStages2_2.ScheduleStatus = 0
	LEFT JOIN InformationRegister.QueueOfProductionOperations AS QueueOverridable
	ON RegisterOverridable.Stage = QueueOverridable.Stage
		AND RegisterOverridable.OperationID = QueueOverridable.OperationID
		AND (RegisterOverridable.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
		OR QueueOverridable.JobTitle &lt;> &amp;EmptyRef)
		AND QueueOverridable.MainEntry_
WHERE
	(NOT &amp;FilterByArea
			OR ISNULL(RegisterOverridable.Operation.ProductionArea, VALUE(Catalog.ProductionSites.EmptyRef)) &lt;> VALUE(Catalog.ProductionSites.EmptyRef)
				AND ISNULL(RegisterOverridable.Operation.ProductionArea, VALUE(Catalog.ProductionSites.EmptyRef)) = &amp;ProductionArea
			OR ISNULL(RegisterOverridable.Operation.ProductionArea, VALUE(Catalog.ProductionSites.EmptyRef)) = VALUE(Catalog.ProductionSites.EmptyRef)
				AND (RegisterOverridable.WorkCenterType = VALUE(Catalog.WorkCenterTypes.EmptyRef)
					OR RegisterOverridable.WorkCenter &lt;> VALUE(Catalog.WorkCenters.EmptyRef)
						AND TRUE IN
							(SELECT TOP 1
								TRUE
							FROM
								Catalog.WorkCenters AS WorkCentersOverridable
							WHERE
								WorkCentersOverridable.Ref = RegisterOverridable.WorkCenter
								AND WorkCentersOverridable.ProductionArea = &amp;ProductionArea)
					OR RegisterOverridable.WorkCenter = VALUE(Catalog.WorkCenters.EmptyRef)
						AND TRUE IN
							(SELECT TOP 1
								TRUE
							FROM
								Catalog.WorkCenters AS WorkCentersOverridable
							WHERE
								WorkCentersOverridable.WorkCenterType = RegisterOverridable.WorkCenterType
								AND WorkCentersOverridable.ProductionArea = &amp;ProductionArea)))
	AND (NOT &amp;TheProductionScheduleIsPlanned
			OR (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR ScheduleOfProductionStages2_2.Begin >= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &lt;= &amp;EndOfPeriod))</queryText>
      <mainTable>InformationRegister.OperationsToCreateShiftTasks</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Department</dataPath>
