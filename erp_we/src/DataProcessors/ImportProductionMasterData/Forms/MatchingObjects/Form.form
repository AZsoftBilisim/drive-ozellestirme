    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	MatchingObjectsOverridable.DataSource,
	MatchingObjectsOverridable.Id,
	VALUE(Catalog.Products.EmptyRef) AS MetadataObject,
	UNDEFINED AS ObjectReference,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	MatchingObjectsOverridable.ExternalSystemPresentation,
	MatchingObjectsOverridable.RecordDate,
	MatchingObjectsOverridable.Matched
FROM
	InformationRegister.ObjectMappingToImportMasterData AS MatchingObjectsOverridable</queryText>
