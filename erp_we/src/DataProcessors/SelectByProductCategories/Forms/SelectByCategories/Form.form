      <value>Danh sách mặt hàng</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.Brand</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.PriceKind</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.ProductCategory</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.ProductKind</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.ProductRangePhase</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.ProductRangeRole</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CatalogProducts.Ref AS Ref,
	CatalogProducts.Ref AS Products,
	CatalogProducts.ProductCategory AS ProductCategory,
	CatalogProducts.ProductKind AS ProductKind,
	ISNULL(CategoryPlan.Brand, VALUE(Catalog.Brands.EmptyRef)) AS Brand,
	ISNULL(ProductRange.ProductRangeRole, VALUE(Enum.ProductRangeRoles.EmptyRef)) AS ProductRangeRole,
	CASE
		WHEN ProductRange.Products IS NULL 
			THEN VALUE(Enum.ProductRangePhases.EmptyRef)
		WHEN ProductRange.SalesAreAllowed
				AND ProductRange.PurchasesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.PurchasesAndSalesArePermitted)
		WHEN ProductRange.SalesAreAllowed
				AND NOT ProductRange.PurchasesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.OnlySalesAreAllowed)
		WHEN ProductRange.PurchasesAreAllowed
				AND NOT ProductRange.SalesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.OnlyPurchasesAreAllowed)
		ELSE VALUE(Enum.ProductRangePhases.SalesAndPurchasesAreProhibited)
	END AS ProductRangePhase,
	ISNULL(ProductRange.PriceKind, &amp;PriceKind) AS PriceKind,
	ISNULL(ProductRange.SalesRank, CatalogProducts.SalesRank) AS SalesRank,
	CatalogProducts.IsFolder
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN InformationRegister.ProductRange.SliceLast(ENDOFPERIOD(&amp;OnDate, DAY), PlanningObject = &amp;PlanningObject) AS ProductRange
		ON CatalogProducts.Ref = ProductRange.Products
		LEFT JOIN InformationRegister.ProductMixQuotas.SliceLast(&amp;OnDate, PlanningObject = &amp;PlanningObject) AS CategoryPlan
		ON CatalogProducts.ProductCategory = CategoryPlan.ProductCategory
			AND CatalogProducts.Brand = CategoryPlan.Brand
			AND (CategoryPlan.Period IN
				(SELECT
					MAX(K.Period)
				FROM
					InformationRegister.ProductMixQuotas AS K
				WHERE
					K.Period &lt;= &amp;OnDate
					AND K.PlanningObject = &amp;PlanningObject))
WHERE
	NOT CatalogProducts.IsFolder
{WHERE
	CatalogProducts.ProductCategory AS FilterProductCategory,
	CatalogProducts.ProductKind AS FilterProductKind,
	CategoryPlan.Brand AS FilterBrand}</queryText>
      <mainTable>Catalog.Products</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
