          <id>372</id>
          <title>
            <key>en</key>
            <value>Correct lines with measured goods</value>
          </title>
          <title>
            <key>fa</key>
            <value>اصلاح سطرهای دارای کالاهای اندازه‌گیری‌شده</value>
          </title>
          <title>
            <key>it</key>
            <value>Correggere righe merci di misurazione</value>
          </title>
          <title>
            <key>pl</key>
            <value>Skoryguj wiersze towarów wymiarowych</value>
          </title>
          <title>
            <key>ru</key>
            <value>Скорректировать строки мерных товаров</value>
          </title>
          <title>
            <key>tr</key>
            <value>Ölçülebilen ürünlerin satırlarını düzelt</value>
          </title>
          <title>
            <key>vi</key>
            <value>Điều chỉnh các dòng sản phẩm đo</value>
          </title>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
