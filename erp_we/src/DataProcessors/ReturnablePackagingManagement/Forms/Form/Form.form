    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PackageReturnsDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentReturnOfGoodsToVendor.Ref,
	DocumentReturnOfGoodsToVendor.DeletionMark,
	DocumentReturnOfGoodsToVendor.Number,
	DocumentReturnOfGoodsToVendor.Date,
	DocumentReturnOfGoodsToVendor.Posted,
	DocumentReturnOfGoodsToVendor.Organization,
	DocumentReturnOfGoodsToVendor.Partner,
	DocumentReturnOfGoodsToVendor.Counterparty,
	DocumentReturnOfGoodsToVendor.Terms,
	DocumentReturnOfGoodsToVendor.DocumentInflow,
	DocumentReturnOfGoodsToVendor.Department,
	DocumentReturnOfGoodsToVendor.Currency,
	DocumentReturnOfGoodsToVendor.Warehouse,
	DocumentReturnOfGoodsToVendor.DocumentAmount,
	DocumentReturnOfGoodsToVendor.PriceIncludesVAT,
	DocumentReturnOfGoodsToVendor.Manager,
	DocumentReturnOfGoodsToVendor.Comment,
	DocumentReturnOfGoodsToVendor.VATTaxation,
	DocumentReturnOfGoodsToVendor.BusinessOperation,
	DocumentReturnOfGoodsToVendor.GoodsRecipient,
	DocumentReturnOfGoodsToVendor.Shipper,
	DocumentReturnOfGoodsToVendor.CompanyBankAccount,
	DocumentReturnOfGoodsToVendor.CounterpartyBankAccount,
	DocumentReturnOfGoodsToVendor.ShipperBankAccount,
	DocumentReturnOfGoodsToVendor.GoodsRecipientBankAccount,
	DocumentReturnOfGoodsToVendor.SalesOpportunity,
	DocumentReturnOfGoodsToVendor.Contract,
	DocumentReturnOfGoodsToVendor.Basis,
	DocumentReturnOfGoodsToVendor.FinancialAccountingGroup,
	DocumentReturnOfGoodsToVendor.ContactPerson,
	DocumentReturnOfGoodsToVendor.Director,
	DocumentReturnOfGoodsToVendor.ChiefAccountant,
	DocumentReturnOfGoodsToVendor.IssuiedBy,
	DocumentReturnOfGoodsToVendor.IssuiedByJobTitle,
	DocumentReturnOfGoodsToVendor.ReturnOfReceivedReusablePackages,
	DocumentReturnOfGoodsToVendor.ReusablePackageFillingStatus,
	DocumentReturnOfGoodsToVendor.InventoryOwnerAttributesAreSpecifiedManually,
	DocumentReturnOfGoodsToVendor.DepositForPackageIsRequired,
	DocumentReturnOfGoodsToVendor.CompensationMethod,
	DocumentReturnOfGoodsToVendor.ReferenceDocumentDateForPrintForms,
	DocumentReturnOfGoodsToVendor.BaseDocumentNumber,
	DocumentReturnOfGoodsToVendor.LetterOfAuthorityIssuedBy,
	DocumentReturnOfGoodsToVendor.PowerOfAttorneyDate,
	DocumentReturnOfGoodsToVendor.PowerOfAttorneyPerson,
	DocumentReturnOfGoodsToVendor.PowerOfAttorneyNumber,
	DocumentReturnOfGoodsToVendor.PaymentID,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
FROM
	Document.ReturnOfGoodsToVendor AS DocumentReturnOfGoodsToVendor
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentReturnOfGoodsToVendor.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.ReturnOfGoodsToVendor</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
