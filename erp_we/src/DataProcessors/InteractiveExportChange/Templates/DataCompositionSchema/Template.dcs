	<dataSetLink>
		<sourceDataSet>ChangeRecords</sourceDataSet>
		<destinationDataSet>NodeCompositionMetadataTable</destinationDataSet>
		<sourceExpression>RegistrationObjectType</sourceExpression>
		<destinationExpression>Type</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>NodeCompositionMetadataTable</sourceDataSet>
		<destinationDataSet>TotalItemsCount</destinationDataSet>
		<sourceExpression>Type</sourceExpression>
		<destinationExpression>Type</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>RegistrationAutomatically</dataPath>
		<expression>Case When RegistrationReason=&amp;RegistrationReasonAutomatically Then 1 Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Automatically</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>خودکار</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Automaticamente</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Automatycznie</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Автоматически</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Otomatik</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Tự động</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>RegistrationByRef</dataPath>
		<expression>Case When RegistrationReason=&amp;RegistrationReasonByRef Then 1 Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>By reference</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
