	<template>
		<name>Template6</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell/>
				<dcsat:tableCell/>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>* Additional objects may be included in the scope of send data to preserve data integrity</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>* ممکن است برای حفظ یکپارچگی داده، اشیای تکمیلی در محدوده داده‌های ارسالی گنجانده شوند</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>* Ulteriori oggetti possono essere inclusi nei dati da inviare per garantire l'integrità dei dati.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>* W skład wysyłanych danych mogą być włączone dodatkowe obiekty w celu zapewnienia integralności danych</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>* В состав отправляемых данных могут быть включены дополнительные объекты для обеспечения целостности данных</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>* Veri bütünlüğünü sağlamak için gönderilen verilere ek nesneler dahil edilebilir</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>* Trong thành phần dữ liệu gửi đi có thể có các đối tượng bổ sung để đảm bảo tính toàn vẹn dữ liệu</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
				</dcsat:tableCell>
				<dcsat:tableCell/>
			</dcsat:item>
		</template>
	</template>
