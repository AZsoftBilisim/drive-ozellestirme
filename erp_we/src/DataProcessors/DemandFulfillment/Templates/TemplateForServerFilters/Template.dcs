		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Warehouses.Ref                                            AS Warehouse,
	CAST(NULL AS Catalog.Warehouses)                     AS OrderShipmentWarehouse,
	CAST(NULL AS Catalog.BusinessStructure)       AS ReceivingBusinessUnit,
	CAST(NULL AS Catalog.Products)               AS Products,
	CatCharacteristic.Ref                                 AS Characteristic,
	CatPurpose.Ref                                     AS Purpose,
	CatLinesOfBusiness.Ref                        AS LineOfBusiness,
	CatDepartment.Ref                                  AS Department,
	CatSupplyMethods.Ref                             AS SupplyMethod,
	CatProductSegment.Ref                            AS ProductSegment,
	CAST(NULL AS Enum.SupplyTypes)          AS SupplyType,
	CAST(NULL AS NUMBER)                                 AS RowCode,
	CAST(NULL AS NUMBER)                                 AS DistributedInWarehouse,
	CAST(NULL AS NUMBER)                                 AS DistributedFromOrders,
	CAST(NULL AS NUMBER)                                 AS NotSupplied,
	CAST(NULL AS DATE)                                  AS DateOfShipment,
	CAST(NULL AS DATE)                                  AS OrderShipmentDate,
	CatPurpose.OrderDocument                                      AS OrderDocument,

	CatSupplyMethods.SourceOfDemandSupply    AS SupplySource,
	CatSupplyMethods.EmployeeResponsible                      AS Manager,

	&amp;FilterByProductSegmentIsUsed                 AS Parameter1,
	&amp;UseItemVariants                  AS Parameter2,
	&amp;FilterByOrdersIsUsed                              AS Parameter3
	FROM
		// Selection fields dependent on functional options.
		Catalog.ItemsCharacteristics     AS CatCharacteristic,
		Catalog.Warehouses                         AS Warehouses,
		Catalog.LinesOfBusiness        AS CatLinesOfBusiness,
		Catalog.Assignments                     AS CatPurpose,
		Catalog.BusinessStructure           AS CatDepartment,
		Catalog.ProductSegments           AS CatProductSegment,
		Catalog.ProcurementStrategies AS CatSupplyMethods

{SELECT
	Warehouse.*                 AS Warehouse,
	OrderShipmentWarehouse.*   AS OrderShipmentWarehouse,
	Products.*          AS Products,
	Characteristic.*        AS Characteristic,
	Purpose.*            AS Purpose,
	LineOfBusiness.* AS LineOfBusiness,
	Department.*         AS Department,
	ReceivingBusinessUnit.* AS ReceivingBusinessUnit,
	SupplyMethod.*     AS SupplyMethod,
	ProductSegment.*   AS ProductSegment,
	SupplyType          AS SupplyType,
	SupplySource.*   AS SupplySource,
	Manager.*              AS Manager,

	RowCode               AS RowCode,
	OrderDocument.*                 AS OrderDocument,
	DateOfShipment            AS DateOfShipment,
	OrderShipmentDate      AS OrderShipmentDate,
	DistributedInWarehouse    AS DistributedInWarehouse,
	DistributedFromOrders   AS DistributedFromOrders,
	NotSupplied            AS NotSupplied}
{WHERE
	Warehouses.Ref.*                                                AS Warehouse,
	CAST(NULL AS Catalog.BusinessStructure)             AS ReceivingBusinessUnit,
	CAST(NULL AS Catalog.Products).*                   AS Products,
	CatCharacteristic.Ref                                       AS Characteristic,
	CatPurpose.Ref.*                                         AS Purpose,
	CatLinesOfBusiness.Ref.*                            AS LineOfBusiness,
	CatDepartment.Ref                                        AS Department,
	CatSupplyMethods.Ref.*                                 AS SupplyMethod,
	CatProductSegment.Ref                                  AS ProductSegment,
	CAST(NULL AS Enum.SupplyTypes)                AS SupplyType,
	CatPurpose.OrderDocument.*                                          AS OrderDocument,

	CatSupplyMethods.SourceOfDemandSupply.*        AS SupplySource,
	CatSupplyMethods.EmployeeResponsible.*                          AS Manager

}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
