  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogProductPackages.Owner AS Owner,
	CatalogProductPackages.Parent,
	CatalogProductPackages.UnitOfMeasure,
	CatalogProductPackages.Numerator,
	CatalogProductPackages.Denominator,
	CatalogProductPackages.Ref AS Ref,
	CatalogProductPackages.DeletionMark AS DeletionMark,
	CatalogProductPackages.Description AS Description
FROM
	Catalog.PackagesAndUnitsOfMeasure AS CatalogProductPackages
WHERE
	CatalogProductPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		AND NOT CatalogProductPackages.DeletionMark

UNION

SELECT
	&amp;Owner AS Owner,
	NULL,
	UnitsOfMeasurement.Ref,
	1,
	1,
	UnitsOfMeasurement.Ref,
	UnitsOfMeasurement.DeletionMark,
	UnitsOfMeasurement.Description
FROM
	Catalog.PackagesAndUnitsOfMeasure AS UnitsOfMeasurement
WHERE
	UnitsOfMeasurement.Ref IN(&amp;UnitsOfMeasurement)
		AND NOT UnitsOfMeasurement.DeletionMark</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Denominator</dataPath>
        <field>Denominator</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Owner</dataPath>
        <field>Owner</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ref</dataPath>
        <field>Ref</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Parent</dataPath>
        <field>Parent</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Description</dataPath>
        <field>Description</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>UnitOfMeasure</dataPath>
        <field>UnitOfMeasure</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DeletionMark</dataPath>
        <field>DeletionMark</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Numerator</dataPath>
        <field>Numerator</field>
      </fields>
      <parameters>
        <name>Owner</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Owner</value>
            </content>
            <content>
              <key>fa</key>
              <value>مالک</value>
            </content>
            <content>
              <key>ru</key>
              <value>Владелец</value>
            </content>
            <content>
              <key>tr</key>
              <value>Sahip</value>
            </content>
            <content>
              <key>vi</key>
              <value>Đối tượng chủ</value>
            </content>
            <content>
              <key>it</key>
              <value>Owner</value>
            </content>
            <content>
              <key>pl</key>
              <value>Owner</value>
            </content>
          </localValue>
        </title>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
      </parameters>
      <parameters>
        <name>UnitsOfMeasurement</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Units of measure</value>
            </content>
            <content>
              <key>fa</key>
              <value>واحدهای اندازه‌گیری</value>
            </content>
            <content>
              <key>it</key>
              <value>Unità di misura</value>
            </content>
            <content>
              <key>pl</key>
              <value>Jednostki miary</value>
            </content>
            <content>
              <key>ru</key>
