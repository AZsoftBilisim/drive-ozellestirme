            </content>
          </localValue>
        </title>
        <valueType>
          <types>CatalogRef.PackagesAndUnitsOfMeasure</types>
        </valueType>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
        <valueListAllowed>true</valueListAllowed>
