    </title>
    <title>
      <key>vi</key>
      <value>Nhà cung cấp</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Vendors.Vendor</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	PartnersOverridable.Ref                            AS Vendor,
	VALUE(Catalog.VendorPriceTypes.EmptyRef)       AS PriceKind,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	VALUE(Catalog.Currencies.EmptyRef)                   AS Currency,
	DATETIME(1,1,1)                                           AS Registered1,
	0.00                                                       AS Price,
	0.00                                                       AS PriceManAccounting,
	DATETIME(1,1,1)                                           AS LastDelivery,
	0                                                          AS TotalDeliveries,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS OrderPackage,
	0                                                          AS MinimumDeliveryLot
	
FROM
	Catalog.Partners AS PartnersOverridable
WHERE
	PartnersOverridable.Vendor
	AND NOT PartnersOverridable.DeletionMark
</queryText>
      <mainTable>Catalog.Partners</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
