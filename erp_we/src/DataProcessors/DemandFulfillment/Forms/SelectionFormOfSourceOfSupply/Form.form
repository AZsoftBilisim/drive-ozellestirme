  <attributes>
    <name>Warehouses</name>
    <title>
      <key>en</key>
      <value>Warehouses</value>
    </title>
    <title>
      <key>fa</key>
      <value>انبارها</value>
    </title>
    <title>
      <key>it</key>
      <value>Magazzini</value>
    </title>
    <title>
      <key>pl</key>
      <value>Magazyny</value>
    </title>
    <title>
      <key>ru</key>
      <value>Склады</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ambarlar</value>
    </title>
    <title>
      <key>vi</key>
      <value>Kho bãi</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseSeveralWarehouses</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Warehouses.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatWarehouses.Ref AS Warehouse,
	ISNULL(WarehouseStockBalanceOverridable.InStockBalance
				- WarehouseStockBalanceOverridable.ReserveAtWarehouseBalance
				- WarehouseStockBalanceOverridable.ReserveAsReceivedBalance, 0) AS Available
FROM
	Catalog.Warehouses AS CatWarehouses
		LEFT JOIN AccumulationRegister.InventoryAndDemands.Balance(,
				Products = &amp;Products
					AND Characteristic = &amp;Characteristic
					AND Purpose = VALUE(Catalog.Assignments.EmptyRef)) AS WarehouseStockBalanceOverridable
		ON WarehouseStockBalanceOverridable.Warehouse = CatWarehouses.Ref
		 AND WarehouseStockBalanceOverridable.InStockBalance
			- WarehouseStockBalanceOverridable.ReserveAtWarehouseBalance
			- WarehouseStockBalanceOverridable.ReserveAsReceivedBalance > 0
WHERE
	NOT CatWarehouses.IsFolder
	AND NOT CatWarehouses.DeletionMark
	AND NOT CatWarehouses.Ref = &amp;Warehouse

</queryText>
      <mainTable>Catalog.Warehouses</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
