#Region GenerationOfOrders

// Creates orders in the information database based on the existing table of orders recorded by the user.
//
Procedure ToFormTheOrders(Parameters, ResultAddress) Export
	
	GeneratePurchaseRequests = Parameters.GeneratePurchaseRequests;
	
	DocumentsObjects = New Array();
	TextComment = NStr("vi = 'Được tạo tự động bằng bộ xử lý ""Đáp ứng nhu cầu"".';
						|ru = 'Сформирован автоматически обработкой ""Обеспечение потребностей"".';
						|en = 'Generated automatically using the ""Demand fulfillment"" data processor.'; fa = 'Generated automatically using the ""Demand fulfillment"" data processor.';
						|it = 'Generated automatically using the ""Demand fulfillment"" data processor.';
						|pl = 'Generated automatically using the ""Demand fulfillment"" data processor.';
						|tr = '""Talep karşılama""nın işlenmesiyle otomatik olarak oluşturuldu.'");
	TextCommentOfApplications = NStr("vi = 'Được tạo tự động bằng bộ xử lý ""Lập giấy đề nghị mua hàng theo nhu cầu""';
									|ru = 'Сформирована автоматически обработкой ""Формирование заявок на закупку по потребностям""';
									|en = 'Generated automatically using the ""Generate purchase requests by demand"" data processor.'; fa = 'Generated automatically using the ""Generate purchase requests by demand"" data processor.';
									|it = 'Generated automatically using the ""Generate purchase requests by demand"" data processor.';
									|pl = 'Generated automatically using the ""Generate purchase requests by demand"" data processor.';
									|tr = '""İhtiyaca göre satın alma talebi""nin işlenmesiyle otomatik olarak oluşturuldu'");
	
	Table = Parameters.TableOfNeeds; // ValueTable
	Table.Columns.Add("ThisIsRounding", New TypeDescription("Boolean"));
	Table.Columns.Add("PurposeOfRoundedString", New TypeDescription("CatalogRef.Assignments"));
	
	// Rounding makes sense only when the packaging of the item can be used
	If Parameters.UsePackages Then
		RoundUpBeforeCreatingOrders(Table);
	EndIf;
	
	Query = New Query();
	Query.SetParameter("ValueTable", Table);
	Query.SetParameter("BegOfDay", BegOfDay(CurrentSessionDate()));
	Query.SetParameter("MainCountry", SettingsValueClientServerCached.MainCountry());
	Query.SetParameter("GeneratePurchaseRequests", GeneratePurchaseRequests);
	Query.SetParameter("PurchaseObjective", Parameters.PurchaseObjective);
	
	QueryTexts = New ValueList();
	QueryTexts.Add(TemporaryTableFromTableToOrder(), "");
	QueryTexts.Add(TemporaryTableFillData(), "");
	QueryTexts.Add(TempTableKeysOfVATRateRegisters(), "");
	QueryTexts.Add(TempTableOfVATRates(), "");
	
	QueryTexts.Add(TableOfPurchaseRequestForRegistration(),     "PurchaseRequestTable");
	QueryTexts.Add(OrdersToSupplierForCheckoutTable(),    "OrdersToSupplierTable");
	QueryTexts.Add(TableOrdersToMoveToCheckout(), "MovingOrdersTable");
	QueryTexts.Add(TableAssemblyOrdersToCheckout(),      "TableAssemblyOrders");
	QueryTexts.Add(TableOrdersOfMaterialsInProduction(), "TableOrdersOfMaterialsInProduction");
	If GetFunctionalOption("UseProductionByThirdParty2_5") Then
		QueryTexts.Add(TableOrdersToProcessor2_5KProcessing(), "OrdersToProcessorTable");
	EndIf;
	QueryTexts.Add(TableProductionOrders2_2ByDesign(), "TableProductionOrders2_2");
	Query.SetParameter("ProductionManagement2_2", GetFunctionalOption("UseProductionManagement2_2"));
	
	SetPrivilegedMode(True);
	Tables = TMCommonUse.UploadResultsOfQuery(Query, QueryTexts, Undefined, True);
	SetPrivilegedMode(False);
	
	ApplicationKeyFields = 
	"Manager,
	|Performer,
	|Organization,
	|PurchaseObjective,
	|Department,
	|LineOfBusiness,
	|PriceIncludesVAT";
	
	ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.PurchaseRequestTable, ApplicationKeyFields);
	
	If UserRightsCached.ApprovePurchaseRequests() Then
		StatusOfPurchaseRequest = Enums.PurchaseRequestStatuses.OnExecution;
	Else
		StatusOfPurchaseRequest = Enums.PurchaseRequestStatuses.AwaitingApproval;
	EndIf;
	
	For Each Item In ArrayOfTables Do
		
		ApplicationKeyFields = "Warehouse";
		FillingData = Item.Key;
		TablesByWarehouse = SupplyServer.SplitTableByKeyValue(Item.Table, ApplicationKeyFields, "");
		
		If TablesByWarehouse.Count() = 2 //If there is only one application with products, then we add works to it.
			And Not ValueIsFilled(TablesByWarehouse[0].Table[0].Warehouse) Then
			
			CommonClientServer.SupplementTable(TablesByWarehouse[0].Table, TablesByWarehouse[1].Table);
			TablesByWarehouse.Delete(0);
			
		EndIf;
		
		For Each Item1 In TablesByWarehouse Do
			
			FillingData.Insert("Warehouse", Item1.Key.Warehouse);
			Item1.Table.Columns.ReceivingBusinessUnit.Name = "Department";
			
			FillingData.Insert("Comment", TextCommentOfApplications);
			FillingData.Insert("Goods", Item1.Table);
			Document = GetDocument(Documents.PurchaseRequest, FillingData, StatusOfPurchaseRequest);
			DocumentsObjects.Add(Document);
			
		EndDo;
		
	EndDo;
	
	OrderKeyFields = "LineOfBusiness, Terms, Partner, Organization, Department, Manager";
	ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.OrdersToSupplierTable, OrderKeyFields);
	
	For Each Item In ArrayOfTables Do
		
		OrderKeyFields = "Warehouse";
		FillingData = Item.Key;
		TablesByWarehouse = SupplyServer.SplitTableByKeyValue(Item.Table, OrderKeyFields, "");
		
		If TablesByWarehouse.Count() = 2 //If there is only one order with goods, then we add work to it.
			And Not ValueIsFilled(TablesByWarehouse[0].Table[0].Warehouse) Then
			
			CommonClientServer.SupplementTable(TablesByWarehouse[0].Table, TablesByWarehouse[1].Table);
			TablesByWarehouse.Delete(0);
			
		EndIf;
		
		For Each Item1 In TablesByWarehouse Do
			
			FillingData.Insert("Warehouse", Item1.Key.Warehouse);
			Item1.Table.Columns.ReceivingBusinessUnit.Name = "Department";
			
			FillingData.Insert("Comment", TextComment);
			FillingData.Insert("Goods", Item1.Table);
			Document = GetDocument(Documents.PurchaseOrder, FillingData, Enums.PurchaseOrderStatuses.Confirmed_);
			DocumentsObjects.Add(Document);
			
		EndDo;
		
	EndDo;
	
	OrderKeyFields = "SourceWarehouse, DestinationWarehouse, Organization, Department, LineOfBusiness";
	ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.MovingOrdersTable, OrderKeyFields);
	
	For Each Item In ArrayOfTables Do
		
		FillingData = Item.Key;
		FillingData.Insert("Goods", Item.Table);
		FillingData.Insert("Comment", TextComment);
		Document = GetDocument(Documents.TransferOrder, FillingData, Enums.InternalOrderStatuses.ForCompletion);
		DocumentsObjects.Add(Document);
		
	EndDo;
	
	OrderKeyFields = "Organization, Department, Warehouse, Products, Characteristic, Purpose, LineOfBusiness,
		|AssemblyDisassemblyStart, AssemblyDisassemblyEnd, AssemblyDisassemblyDurationDays, Count, NumberOfPackages";
	ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.TableAssemblyOrders, OrderKeyFields);
	
	For Each Item In ArrayOfTables Do
		
		FillingData = Item.Key;
		FillingData.Insert("BusinessOperation", Enums.BusinessTransactions.AssemblyFromComponents);
		FillingData.Insert("Comment", TextComment);
		Document = GetDocument(Documents.ByAssemblyDisassemblyOrder, FillingData, Enums.InternalOrderStatuses.ForCompletion);
		DocumentsObjects.Add(Document);
		
	EndDo;
	OrderKeyFields = "Warehouse, ShopFloorStockroom, Organization, Department, LineOfBusiness";
	ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.TableOrdersOfMaterialsInProduction, OrderKeyFields);
	
	For Each Item In ArrayOfTables Do
		
		FillingData = Item.Key;
		FillingData.Insert("Goods", Item.Table);
		FillingData.Insert("Comment", TextComment);
		Document = GetDocument(Documents.OrderOfMaterialsForProduction, FillingData, Enums.StatusesOfOrdersForMaterialsForProduction.ForCompletion);
		DocumentsObjects.Add(Document);
		
	EndDo;
	
	If CommonClientServer.HasAttributeOrObjectProperty(Tables, "OrdersToProcessorTable") Then
		
		OrderKeyFields = "LineOfBusiness, Terms, Partner, Organization, Department";
		ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.OrdersToProcessorTable, OrderKeyFields);
		
		For Each Item In ArrayOfTables Do
			
			OrderKeyFields = "Warehouse";
			FillingData = Item.Key;
			TablesByWarehouse = SupplyServer.SplitTableByKeyValue(Item.Table, OrderKeyFields, "");
			
			If TablesByWarehouse.Count() = 2 //If there is only one order with goods, then we add work to it.
				And Not ValueIsFilled(TablesByWarehouse[0].Table[0].Warehouse) Then
				
				CommonClientServer.SupplementTable(TablesByWarehouse[0].Table, TablesByWarehouse[1].Table);
				TablesByWarehouse.Delete(0);
				
			EndIf;
			
			For Each Item1 In TablesByWarehouse Do
				
				FillingData.Insert("Warehouse", Item1.Key.Warehouse);
				TableColumn2 = Item1.Table.Columns.ReceivingBusinessUnit; // 
				TableColumn2.Name = "Department";
				
				FillingData.Insert("Comment", TextComment);
				FillingData.Insert("Goods", Item1.Table);
				If GetFunctionalOption("UseProductionByThirdParty2_5") Then
					Document = GetDocument(Documents.SubcontractOrder2_5, FillingData, Enums.TollingOrderStatuses.ForFulfillment);
				EndIf;
				DocumentsObjects.Add(Document);
				
			EndDo;
			
		EndDo;
		
	EndIf;
	
	
	OrderKeyFields = "ProductionProcessType, UnderRepairProduct, UnderRepairVariant, UnderRepairBatch,
	|LineOfBusiness, Organization, Department, Partner, Contract, BusinessOperation"
		+ ?(GetFunctionalOption("DynamicStructureOfProductionOrders"), 
			"",
			",DemandDate");
	ArrayOfTables = SupplyServer.SplitTableByKeyValue(Tables.TableProductionOrders2_2, OrderKeyFields);
	
	For Each Item In ArrayOfTables Do
		
		FillingData = Item.Key;
		FillingData.Insert("Status", Enums.ProductionOrderStatuses2_2.ToProduce);
		Item.Table.Columns.ReceivingBusinessUnit.Name = "Department";
		FillingData.Insert("Goods", Item.Table);
		FillingData.Insert("Comment", TextComment);
		Document = GetDocument(Documents.ProductionOrder2_2, FillingData, Enums.ProductionOrderStatuses2_2.ToProduce);
		
		DocumentsObjects.Add(Document);
		
	EndDo;
	UsingStatuses = New Map();
	UseStatuses = GetFunctionalOption("UsePurchaseOrderStatuses");
	UsingStatuses.Insert(Type("DocumentRef.PurchaseOrder"),     UseStatuses);
	UseStatuses = GetFunctionalOption("UseStatusesOfAssemblyOrders");
	UsingStatuses.Insert(Type("DocumentRef.ByAssemblyDisassemblyOrder"),       UseStatuses);
	UseStatuses = GetFunctionalOption("UseStatusesOfTransferOrders");
	UsingStatuses.Insert(Type("DocumentRef.TransferOrder"),  UseStatuses);
	UsingStatuses.Insert(Type("DocumentRef.ProductionOrder2_2"), True);
	UsingStatuses.Insert(Type("DocumentRef.OrderOfMaterialsForProduction"), True);
	UsingStatuses.Insert(Type("DocumentRef.SubcontractOrder2_5"), True);
	// We put the result of the formation in the repository after recording each document in case of interruption of the task
	Result = New Structure("DocumentsTable,ListOfMessages", Parameters.DocumentsTable, New Array);
	ReportErrorInFillingInLimitAnalyst = False;
	For Each Document In DocumentsObjects Do
		
		If TypeOf(Document) = Type("DocumentObject.PurchaseRequest")
			And Documents.PurchaseRequest.MonitorBDRLimits(Document) Then
			// The document cannot be held if it is necessary to fill out the limit analysis.
			Error = True;
			ReportErrorInFillingInLimitAnalyst = True;
		Else
			Error = Not Document.CheckFilling();
		EndIf;
	
		If Not Error Then
			
			BeginTransaction();
			Try
				
				Document.Write(DocumentWriteMode.Posting);
				AddDocumentToResult(Document, Result, UsingStatuses);
				PutToTempStorage(Result, Parameters.OrderPlacementResultAddress);
				
				CommitTransaction();
			Except
				RollbackTransaction();
				
				If IsARequest(Document.Ref) Then
					LogEventName = NStr("vi = 'Lập giấy đề nghị: tạo chứng từ';
										|ru = 'Формирование заявок: создание документов';
										|en = 'Generate requests: create documents'; fa = 'Generate requests: create documents';
										|it = 'Generate requests: create documents';
										|pl = 'Generate requests: create documents';
										|tr = 'Talepleri oluşturma: belgelerin oluşturulması'", Common.DefaultLanguageCode());
				Else
					LogEventName = NStr("vi = 'Lập đơn hàng: tạo chứng từ';
										|ru = 'Формирование заказов: создание документов';
										|en = 'Order generation: document creation'; fa = 'Order generation: document creation';
										|it = 'Generazione ordini: creazione documenti';
										|pl = 'Tworzenie zamówień: tworzenie dokumentów';
										|tr = 'Siparişleri oluşturma: belge oluşturma'", Common.DefaultLanguageCode());
				EndIf;
				
				WriteLogEvent(LogEventName, EventLogLevel.Error,,, DetailErrorDescription(ErrorInfo()));
				Error = True;
				
			EndTry;
			
		EndIf;
		
		If Error Then
			
			BeginTransaction();
			Try
				
				Document.Write(DocumentWriteMode.Write);
				AddDocumentToResult(Document, Result, UsingStatuses);
				PutToTempStorage(Result, Parameters.OrderPlacementResultAddress);
				
				CommitTransaction();
			Except
				RollbackTransaction();
				
				If IsARequest(Document.Ref) Then
					LogEventName = NStr("vi = 'Lập giấy đề nghị: tạo chứng từ';
										|ru = 'Формирование заявок: создание документов';
										|en = 'Generate requests: create documents'; fa = 'Generate requests: create documents';
										|it = 'Generate requests: create documents';
										|pl = 'Generate requests: create documents';
										|tr = 'Talepleri oluşturma: belgelerin oluşturulması'", CommonClientServer.DefaultLanguageCode());
				Else
					LogEventName = NStr("vi = 'Lập đơn hàng: tạo chứng từ';
										|ru = 'Формирование заказов: создание документов';
										|en = 'Order generation: document creation'; fa = 'Order generation: document creation';
										|it = 'Generazione ordini: creazione documenti';
										|pl = 'Tworzenie zamówień: tworzenie dokumentów';
										|tr = 'Siparişleri oluşturma: belge oluşturma'", CommonClientServer.DefaultLanguageCode());
				EndIf;
				
				WriteLogEvent(LogEventName, EventLogLevel.Error,,, DetailErrorDescription(ErrorInfo()));
				
				Raise;
				
			EndTry;
			
		EndIf;
		
	EndDo;
	
	If ReportErrorInFillingInLimitAnalyst Then
		UserMessage = New UserMessage;
		UserMessage.Text = Documents.PurchaseRequest.ErrorTextOfBDRLimits();
		Result.ListOfMessages.Add(UserMessage);
		PutToTempStorage(Result, Parameters.OrderPlacementResultAddress);
	EndIf;
	
	ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
	
EndProcedure

Procedure DeleteOrders(Parameters, ResultAddress) Export
	
	BeginTransaction(); // In case of cancellation of the task
	Try
	
		ErrorList = TMCommonUse.SetMarkForDeletingDocuments(Parameters.RemovalLinks);
		
		PutToTempStorage(ErrorList, ResultAddress);
		
		CommitTransaction();
	
	Except
		RollbackTransaction();
		
		If ValueIsFilled(Parameters.RemovalLinks) And IsARequest(Parameters.RemovalLinks[0]) Then
			LogEventName = NStr("vi = 'Lập giấy đề nghị: đánh dấu xóa chứng từ';
								|ru = 'Формирование заявок: установка пометки удаления документов';
								|en = 'Generate requests: set document deletion mark'; fa = 'Generate requests: set document deletion mark';
								|it = 'Generate requests: set document deletion mark';
								|pl = 'Generate requests: set document deletion mark';
								|tr = 'Talepleri oluşturma: belgelerin silinmek üzere işaretlenmesi'", CommonClientServer.DefaultLanguageCode());
		Else
			LogEventName = NStr("vi = 'Lập đơn hàng: đánh dấu xóa chứng từ';
								|ru = 'Формирование заказов: установка пометки удаления документов';
								|en = 'Order generation: set document deletion mark'; fa = 'Order generation: set document deletion mark';
								|it = 'Generazione degli ordini: impostare il contrassegno di eliminazione dei documenti';
								|pl = 'Utworzenie zamówień: ustawienie zaznaczenia usunięcia dokumentów';
								|tr = 'Siparişleri oluşturma: belge silme işareti ayarlama'", CommonClientServer.DefaultLanguageCode());
		EndIf;
		WriteLogEvent(LogEventName, EventLogLevel.Error,,, DetailErrorDescription(ErrorInfo()));
		
		Raise;
	EndTry;
	
EndProcedure

Function TemporaryTableFromTableToOrder()

	QueryText =
		"SELECT
		|	Table.Products            AS Products,
		|	Table.Characteristic          AS Characteristic,
		|	Table.Warehouse                   AS Warehouse,
		|	Table.ReceivingBusinessUnit AS ReceivingBusinessUnit,
		|	Table.Purpose              AS Purpose,
		|	
		|	Table.OrderDocument                   AS OrderDocument,
		|	
		|	Table.SupplyType          AS SupplyType,
		|	Table.SupplySource     AS SupplySource,
		|	Table.Terms              AS Terms,
		|	Table.SupplyMethod       AS SupplyMethod,
		|	Table.Manager                AS Manager,
		|	Table.PriceKind                 AS PriceKind,
		|	Table.ShipmentDate            AS ShipmentDate,
		|	Table.ToOrder                 AS ToOrder,
		|	Table.ThisIsRounding           AS ThisIsRounding,
		|	Table.PurposeOfRoundedString AS PurposeOfRoundedString,
		|	Table.OrderPackage          AS Package
		|
		|INTO TTTableOfValues
		|FROM
		|	&ValueTable AS Table
		|
		|WHERE
		|	Table.ToOrder > 0
		|
		|INDEX BY
		|	SupplyMethod";

	Return QueryText;

EndFunction

Function TemporaryTableFillData()
	
	QueryText =
		"SELECT
		|	T.Products                               AS Products,
		|	T.Characteristic                             AS Characteristic,
		|	T.Warehouse                                      AS Warehouse,
		|	T.ReceivingBusinessUnit                    AS ReceivingBusinessUnit,
		|	T.Purpose                                 AS Purpose,
		|	
		|	CASE WHEN FALSE THEN
		|				UNDEFINED
		|			WHEN T.OrderDocument REFS Document.ProductionStage2_2 THEN
		|				T.OrderDocument
		|			ELSE
		|				UNDEFINED
		|		END                                    AS OrderDocument, // used for grouping when forming production orders

		|	CASE WHEN T.Purpose = VALUE(Catalog.Assignments.EmptyRef) THEN
		|				UNDEFINED
		|			WHEN MaterialProviderOrder2_5.Ref IS NOT NULL
		|				THEN MaterialProviderOrder2_5.Partner
		|		WHEN CAST(T.Purpose AS Catalog.Assignments).AssignmentType IN(
		|				VALUE(Enum.AssignmentTypes.Giveaway2_5),
		|				VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22))
		|			THEN CAST(T.Purpose AS Catalog.Assignments).Partner
		|			ELSE
		|				UNDEFINED
		|		END                                    AS MaterialProvider, // used for grouping when forming production orders

		|	CASE WHEN T.Purpose = VALUE(Catalog.Assignments.EmptyRef) THEN
		|				UNDEFINED
		|			WHEN MaterialProviderOrder2_5.Ref IS NOT NULL
		|				THEN MaterialProviderOrder2_5.Contract
		|		WHEN CAST(T.Purpose AS Catalog.Assignments).AssignmentType IN(
		|				VALUE(Enum.AssignmentTypes.Giveaway2_5),
		|				VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22))
		|			THEN CAST(T.Purpose AS Catalog.Assignments).Contract
		|			ELSE
		|				UNDEFINED
		|		END                                    AS Contract, // used for grouping when forming production orders

		|	CASE
		|		WHEN FALSE
		|			THEN UNDEFINED
		|		WHEN MaterialProviderOrder2_5.Ref IS NOT NULL
		|			THEN MaterialProviderOrder2_5.ProductionProcessType
		|		WHEN TRUE
		|			THEN VALUE(Enum.ProductionProcessTypes.Assembly)
		|			ELSE
		|				UNDEFINED
		|		END                                    AS ProductionProcessType, // used for grouping when forming production orders
		|
		|	CASE
		|		WHEN CAST(T.Purpose AS Catalog.Assignments).AssignmentType = VALUE(Enum.AssignmentTypes.Giveaway2_5)
		|			THEN VALUE(Enum.BusinessTransactions.TollManufacturing2_5)
		|		WHEN CAST(T.Purpose AS Catalog.Assignments).AssignmentType = VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22)
		|				AND IncludedDvaltsy2_5.Value
		|			THEN VALUE(Enum.BusinessTransactions.TollManufacturing2_5)
		|		ELSE
		|			VALUE(Enum.BusinessTransactions.OwnProduction)
		|	END AS BusinessOperation,
		// The Finished Product being Repaired
		|	ISNULL(MaterialProviderOrder2_5.UnderRepairProduct, UNDEFINED)   AS UnderRepairProduct,
		|	ISNULL(MaterialProviderOrder2_5.UnderRepairVariant, UNDEFINED) AS UnderRepairVariant,
		|	ISNULL(MaterialProviderOrder2_5.UnderRepairBatch, UNDEFINED)          AS UnderRepairBatch,
		|
		|	T.SupplyType                             AS SupplyType,
		|	T.SupplySource                        AS SupplySource,
		|	T.Terms                                 AS Terms,
		|	CASE
		|		WHEN T.Manager <> VALUE(Catalog.Users.EmptyRef)
		|			THEN T.Manager
		|		ELSE
		|			T.SupplyMethod.EmployeeResponsible
		|	END                                        AS EmployeeResponsible,
		|	ISNULL(
		|		CAST(
		|			CASE
		|				WHEN T.ThisIsRounding
		|					THEN T.PurposeOfRoundedString
		|				ELSE T.Purpose
		|			END AS Catalog.Assignments).LineOfBusiness,
		|		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
		|
		|	CASE
		|		WHEN
					// A production order for version 2.2 will be created, with the Contract field passed.
		|			T.SupplyType = VALUE(Enum.SupplyTypes.Production)
						// And the Contract field in the production order being created will be filled in.
		|				AND T.Purpose <> VALUE(Catalog.Assignments.EmptyRef)
		|				AND (NOT MaterialProviderOrder2_5.Ref IS NULL
		|					OR CAST(T.Purpose AS Catalog.Assignments).AssignmentType IN(
		|							VALUE(Enum.AssignmentTypes.Giveaway2_5),
		|							VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22))
		|)
		|			THEN
						// The company will be taken from the Contract.
		|				ISNULL(MaterialProviderOrder2_5.Contract.Organization,
		|						ISNULL(CAST(T.Purpose AS Catalog.Assignments).Contract.Organization,
		|							VALUE(Catalog.Companies.EmptyRef)))
		
				// Otherwise, the Company will be taken according to the general rules.
		|		WHEN ISNULL(T.SupplyMethod.Organization, VALUE(Catalog.Companies.EmptyRef))
		|					<> VALUE(Catalog.Companies.EmptyRef)
		|				THEN T.SupplyMethod.Organization
		|		WHEN ISNULL(T.SupplyMethod.Terms.Organization, VALUE(Catalog.Companies.EmptyRef))
		|					<> VALUE(Catalog.Companies.EmptyRef)
		|				THEN T.SupplyMethod.Terms.Organization
		|		ELSE
		|			ISNULL(T.Terms.Organization, VALUE(Catalog.Companies.EmptyRef))
		|	END AS Organization,
		|
		|	ISNULL(T.SupplyMethod.Department,
		|		VALUE(Catalog.BusinessStructure.EmptyRef)) AS Department,
		|
		|	ISNULL(T.SupplyMethod.ProductionDurationDays, 0)          AS ProductionDurationDays,
		|
		|	T.PriceKind                                    AS PriceKind,
		|	T.ShipmentDate                               AS ShipmentDate,
		|	T.ToOrder                                    AS Count,
		|	T.Package                                   AS Package
		|
		|INTO TTFillData
		|FROM
		|	TTTableOfValues AS T
		|		
		|		LEFT JOIN Constant.UseTollManufacturing2_5 AS IncludedDvaltsy2_5
		|		ON TRUE
		|		
		|		
		|		LEFT JOIN Document.MaterialProviderOrder2_5 AS MaterialProviderOrder2_5
		|		ON T.OrderDocument = MaterialProviderOrder2_5.Ref
		|		
		|INDEX BY
		|	Products, Organization";
		
	Return QueryText;
	
EndFunction

Function TableOfPurchaseRequestForRegistration()
	
	QueryText =
	"SELECT
	|	CASE
	|		WHEN T.SupplySource = UNDEFINED
	|			THEN VALUE(Catalog.Partners.EmptyRef)
	|		ELSE T.SupplySource
	|	END AS Partner,
	|	T.EmployeeResponsible AS Manager,
	|	T.EmployeeResponsible AS Performer,
	|	CASE
	|		WHEN &PurchaseObjective = VALUE(Enum.PurchaseObjectives.OwnNeeds)
	|			THEN T.LineOfBusiness
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	&PurchaseObjective AS PurchaseObjective,
	|	T.Terms AS Terms,
	|	T.Terms.PriceIncludesVAT AS PriceIncludesVAT,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.Warehouse AS Warehouse,
	|	T.Products AS Products,
	|	T.Characteristic AS Characteristic,
	|	MAX(VATRates.VATRate) AS VATRate,
	|	T.Purpose AS Purpose,
	|	T.ReceivingBusinessUnit AS ReceivingBusinessUnit,
	|	T.PriceKind AS VendorPriceKind,
	|	T.ShipmentDate AS RequestedDeliveryDate,
	|	SUM(T.Count / ISNULL(&QueryTextPackagingFactor, 1)) AS NumberOfPackages,
	|	SUM(T.Count) AS Count,
	|	T.Package AS Package
	|FROM
	|	TTFillData AS T
	|		LEFT JOIN VATRates AS VATRates
	|		ON T.Products = VATRates.Products
	|			AND T.Organization = VATRates.Organization
	|WHERE
	|	T.SupplyType = VALUE(Enum.SupplyTypes.Purchase)
	|	AND &GeneratePurchaseRequests
	|
	|GROUP BY
	|	T.LineOfBusiness,
	|	T.Terms.PriceIncludesVAT,
	|	T.EmployeeResponsible,
	|	T.Terms,
	|	T.SupplySource,
	|	T.Organization,
	|	T.Department,
	|	T.Warehouse,
	|	T.Products,
	|	T.Characteristic,
	|	T.Purpose,
	|	T.ShipmentDate,
	|	T.PriceKind,
	|	T.ReceivingBusinessUnit,
	|	T.Package,
	|	T.EmployeeResponsible
	|
	|ORDER BY
	|	Manager,
	|	Performer,
	|	Organization,
	|	PurchaseObjective,
	|	Department,
	|	LineOfBusiness,
	|	PriceIncludesVAT,
	|	Warehouse,
	|	Purpose,
	|	RequestedDeliveryDate,
	|	Products,
	|	Characteristic,
	|	ReceivingBusinessUnit";
	
	QueryText = StrReplace(
		QueryText,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"T.Package",
		"T.Products"));
		
	Return QueryText;
	
EndFunction

Function TempTableKeysOfVATRateRegisters()
	
	QueryText =
		"SELECT DISTINCT
		|	AllGoods.Products AS Products,
		|	AllGoods.Organization AS Organization,
		|	CAST(AllGoods.Organization AS Catalog.Companies).RegistrationCountry AS RegistrationCountry
		|INTO VATRateRegisterKeys
		|FROM
		|	TTFillData AS AllGoods
		|WHERE
		|	AllGoods.SupplyType IN(
		|		VALUE(Enum.SupplyTypes.ProductionByThirdParty),
		|		VALUE(Enum.SupplyTypes.Purchase))
		|INDEX BY
		|	Products,RegistrationCountry";
		
	Return QueryText;
	
EndFunction

Function TempTableOfVATRates()
	
	QueryText =
		"SELECT
		|	AllGoods.Products AS Products,
		|	AllGoods.Organization AS Organization,
		|	CASE
		|		WHEN NOT (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))) IS NULL
		|			THEN (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef))))
		|		WHEN NOT (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))) IS NULL
		|			THEN (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef))))
		|		ELSE 0
		|	END AS VATRate
		|INTO VATRates
		|FROM
		|	VATRateRegisterKeys AS AllGoods
		|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&BegOfDay) AS VATRatesForProductsOfCountryOfRegistration
		|		ON AllGoods.Products = VATRatesForProductsOfCountryOfRegistration.Products
		|		AND AllGoods.RegistrationCountry = VATRatesForProductsOfCountryOfRegistration.Country
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&BegOfDay) AS BasicVATRatesOfCountryOfRegistration
		|		ON AllGoods.RegistrationCountry = BasicVATRatesOfCountryOfRegistration.Country
		|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&BegOfDay, Country = &MainCountry OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS ProductsVATRates
		|		ON AllGoods.Products = ProductsVATRates.Products
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&BegOfDay, Country = &MainCountry) AS BasicVATRates
		|		ON TRUE
		|INDEX BY
		|	Products,Organization";
		
	Return QueryText;
	
EndFunction

Function OrdersToSupplierForCheckoutTable()
	QueryText =
		"SELECT
		|	CASE WHEN T.SupplySource = UNDEFINED THEN
		|				VALUE(Catalog.Partners.EmptyRef)
		|			ELSE
		|				T.SupplySource
		|		END                                 AS Partner,
		|	T.EmployeeResponsible AS Manager,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Terms AS Terms,
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.Warehouse AS Warehouse,
		|	T.Products AS Products,
		|	MAX(VATRates.VATRate) AS VATRate,
		|	T.Characteristic AS Characteristic,
		|	T.Purpose AS Purpose,
		|	T.ReceivingBusinessUnit AS ReceivingBusinessUnit,
		|	T.PriceKind AS VendorPriceKind,
		|	T.ShipmentDate AS DateOfReceipt,
		|	SUM(T.Count / ISNULL(&QueryTextPackagingFactor, 1)) AS NumberOfPackages,
		|	SUM(T.Count) AS Count,
		|	T.Package AS Package
		|FROM
		|	TTFillData AS T
		|		LEFT JOIN VATRates AS VATRates
		|		ON VATRates.Products = T.Products
		|		AND VATRates.Organization = T.Organization
		|WHERE
		|	T.SupplyType = VALUE(Enum.SupplyTypes.Purchase)
		|	AND NOT &GeneratePurchaseRequests
		|
		|GROUP BY
		|	T.LineOfBusiness,
		|	T.EmployeeResponsible,
