Function TimeTableProductionSchedule(NameOfTemporaryTableSelectionByNeed)
	
	QueryText =
		"SELECT
		|	RegisterRecords.Products AS Products,
		|	RegisterRecords.Characteristic AS Characteristic,
		|	RegisterRecords.Warehouse AS Warehouse,
		|	RegisterRecords.Purpose AS Purpose,
		|	SUM(RegisterRecords.Scheduled) AS Count
		|INTO ProductionSchedule
		|FROM
		|	TemporaryTableOfGoods_ AS Goods
		|
		|		INNER JOIN InformationRegister.OrderStructure AS RegisterRecords
		|		ON RegisterRecords.Products = Goods.Products
		|		 AND RegisterRecords.Characteristic = Goods.Characteristic
		|		 AND RegisterRecords.Warehouse = Goods.Warehouse
		|		 AND RegisterRecords.Purpose = Goods.Purpose
		|WHERE
		|	RegisterRecords.LineKind <> VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts)
		|
		|GROUP BY
		|	RegisterRecords.Products,
		|	RegisterRecords.Characteristic,
		|	RegisterRecords.Warehouse,
		|	RegisterRecords.Purpose
		|HAVING
		|	SUM(RegisterRecords.Scheduled) > 0
		|INDEX BY
		|	Products, Characteristic, Warehouse, Purpose
		|";
	
	QueryText = StrReplace(QueryText, "TemporaryTableOfGoods_", NameOfTemporaryTableSelectionByNeed);
	
	Return QueryText;
	
EndFunction

Function FindSelectionRecursively(ItemsCollection, SearchValue)
	
	For Each FilterElement In ItemsCollection Do
		
		If TypeOf(FilterElement) = Type("DataCompositionFilterItem") Then
			
			If Not FilterElement.Use Then
				Continue;
			EndIf;
			
			ArrayOfFieldNames = StrSplit(String(FilterElement.LeftValue), ".");
			If New DataCompositionField(ArrayOfFieldNames[0]) = SearchValue Then
				Return True;
			EndIf;
			
		Else
			
			Return FindSelectionRecursively(FilterElement.Items, SearchValue);
			
		EndIf;
		
	EndDo;
	
	Return False;
	
EndFunction

Function TemporaryTableSelectionBySegment()
	
	Return
		"SELECT ALLOWED
		|	SegmentProducts.Products    AS Products,
		|	SegmentProducts.Characteristic  AS Characteristic
		|INTO SegmentSelection
		|FROM
		|	InformationRegister.SegmentProducts AS SegmentProducts
		|		{WHERE
		|			SegmentProducts.Products.*    AS Products,
		|			SegmentProducts.Characteristic.*  AS Characteristic,
		|			SegmentProducts.Segment.*         AS ProductSegment}
		|WHERE
		|	&FilterByProductSegmentIsUsed
		|INDEX BY
		|	Products, Characteristic";
		
EndFunction

Function TemporaryTableSelectionByOrders()
	
	ArrayOfTexts = New Array;
	
	ArrayOfTexts.Add(
		"SELECT ALLOWED
		|	DocumentsRegistry.Ref AS OrderDocument
		|INTO FilterByOrders
		|FROM InformationRegister.DocumentsRegistry AS DocumentsRegistry
		|WHERE
		|	&FilterByOrdersIsUsed
		|{WHERE
		|	DocumentsRegistry.Ref.* AS OrderDocument,
		|	DocumentsRegistry.LineOfBusiness.* AS LineOfBusiness}");
	If AccessRight("Read", Metadata.Documents.ProductionStage2_2) Then
		ArrayOfTexts.Add(
			"SELECT
			|	ProductionStage2_2.Ref
			|FROM
			|	Document.ProductionStage2_2 AS ProductionStage2_2
			|WHERE
			|	&FilterByOrdersIsUsed
			|{WHERE
			|	ProductionStage2_2.ReferenceOrder.* AS OrderDocument,
			|	ProductionStage2_2.LineOfBusiness.* AS LineOfBusiness}
			|
			|UNION ALL
			|
			|SELECT
			|	ProductionStage2_2.Ref
			|FROM
			|	Document.ProductionStage2_2 AS ProductionStage2_2
			|WHERE
			|	&FilterByOrdersIsUsed
			|	AND ProductionStage2_2.ProductionByThirdParty
			|{WHERE
			|	ProductionStage2_2.SubcontractOrder.* AS OrderDocument,
			|	ProductionStage2_2.LineOfBusiness.* AS LineOfBusiness}");
	EndIf;
	
	If AccessRight("Read", Metadata.InformationRegisters.OrderStructure) Then
		ArrayOfTexts.Add(
			"SELECT DISTINCT
			|	OrderStructure.ProductionOrder
			|FROM
			|	InformationRegister.OrderStructure AS OrderStructure
			|WHERE
			|	&FilterByOrdersIsUsed
			|{WHERE
			|	OrderStructure.ProductionOrder.* AS OrderDocument,
			|	OrderStructure.ProductionOrder.LineOfBusiness.* AS LineOfBusiness}");
	EndIf;
	Return StrConcat(ArrayOfTexts, TMCommonUse.QuerySeparatorInJoin());

EndFunction

