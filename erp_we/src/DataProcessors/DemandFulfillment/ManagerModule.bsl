Function GetRequestWithDataLayoutSelections(AddressOfDataCompositionSchema, SettingsComposer, DataSetName)
	
	DataCompositionSchema = GetFromTempStorage(AddressOfDataCompositionSchema);
	
	SegmentsServer.EnableSelectionBySegmentOfVSPDProductRange(SettingsComposer);
	
	CompositionFilter = SettingsComposer.GetSettings().Filter;
	FilterByOrdersIsUsed = FindSelectionRecursively(CompositionFilter.Items, New DataCompositionField("OrderDocument"))
		Or FindSelectionRecursively(CompositionFilter.Items, New DataCompositionField("LineOfBusiness"));
	
	DataCompositionClientServer.SetParameter(SettingsComposer, "FilterByOrdersIsUsed", True, FilterByOrdersIsUsed);
	
	DataCompositionTemplateComposer = New DataCompositionTemplateComposer;
	DataCompositionTemplate = DataCompositionTemplateComposer.Execute(DataCompositionSchema,
		SettingsComposer.GetSettings(),,,, False);

	Query = New Query(DataCompositionTemplate.DataSets[DataSetName].Query);

	For Each LayoutParameter In DataCompositionTemplate.ParameterValues Do

		Query.SetParameter(LayoutParameter.Name, LayoutParameter.Value);

	EndDo;
	UseItemVariants = GetFunctionalOption("UseItemVariants");
	Query.SetParameter("UseItemVariants", UseItemVariants);
	Return Query;

EndFunction

Function TemporaryTableOfGoodsToMaintainStock()

	QueryText =
		"SELECT ALLOWED
		|	SegmentProducts.Products    AS Products,
		|	SegmentProducts.Characteristic  AS Characteristic
		|INTO SegmentSelection
		|FROM
		|	InformationRegister.SegmentProducts AS SegmentProducts
		|		{WHERE
		|			SegmentProducts.Products.*    AS Products,
		|			SegmentProducts.Characteristic.*  AS Characteristic,
		|			SegmentProducts.Segment.*         AS ProductSegment}
		|WHERE
		|	&FilterByProductSegmentIsUsed
		|INDEX BY
		|	Products,
		|	Characteristic
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + Catalogs.StoreFormats.QueryTextTTWarehouseFormats(False)
		+ InformationRegisters.ProductRestrictions.TemporaryTableGoodsOfSupportedStock()
		+ "SELECT ALLOWED
		|	T.Products                       AS Products,
		|	T.Characteristic                     AS Characteristic,
		|	T.Warehouse                              AS Warehouse,
		|	ISNULL(CatMethod.Ref, VALUE(Catalog.ProcurementStrategies.EmptyRef)) AS SupplyMethod
		|
		|INTO TTProducts_1
		|FROM
		|	TTGoodsOfSupportedStock AS T
		|
		|		LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|		ON &MainSupplyMethodSubstitution
		|
		//linker selections
		|{WHERE
		|	VALUE(Catalog.Assignments.EmptyRef)              AS Purpose,
		|	VALUE(Catalog.BusinessStructure.EmptyRef)    AS ReceivingBusinessUnit,
		|	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
		|	CAST(NULL AS Catalog.Assignments).OrderDocument.*          AS OrderDocument}
		|
		|{WHERE
		|	(ISNULL(CatMethod.Ref,
		|		VALUE(Catalog.ProcurementStrategies.EmptyRef))).*           AS SupplyMethod,
		|	ISNULL(CatMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|	CAST(
		|		CASE
		|			WHEN CatMethod.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|				CatMethod.Department
		|			ELSE
		|				ISNULL(T.Warehouse.Department,
		|					VALUE(Catalog.BusinessStructure.EmptyRef))
		|		END AS Catalog.BusinessStructure).*                                   AS Department,
		|	(ISNULL(CatMethod.SourceOfDemandSupply, UNDEFINED)).*              AS SupplySource,
		|	(ISNULL(CatMethod.EmployeeResponsible, UNDEFINED)).*                                AS Manager}
		|
		|INDEX BY
		|	Products, Characteristic, Warehouse,
		|	SupplyMethod
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		|DROP TTWarehouseFormats;
		|
		|////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	T.Products                       AS Products,
		|	T.Characteristic                     AS Characteristic,
		|	T.Warehouse                              AS Warehouse,
		|	T.SupplyMethod                  AS SupplyMethod
		|{SELECT
		|	Products.*      AS Products,
		|	Characteristic.*    AS Characteristic,
		|	Warehouse.*             AS Warehouse,
		|	SupplyMethod.* AS SupplyMethod}
		|FROM
		|	TTProducts_1 AS T";

	QueryText = InformationRegisters.SupplySchemes.SubstituteConnectionToGetSecurityMethod(
		QueryText, "MainSupplyMethodSubstitution");
	
	Return QueryText;

EndFunction

Function TemporaryTableOfSecurityMethods(GoodsOfSupportedStock, PurposeUseKey)
	
	QueryText =
		TemporaryTableSelectionByOrders()
		+ Common.QueryBatchSeparator()
		+ Catalogs.StoreFormats.QueryTextTTWarehouseFormats(False)
		// Selection of the segment nomenclature.
		+ "SELECT ALLOWED
		|	SegmentProducts.Products    AS Products,
		|	SegmentProducts.Characteristic  AS Characteristic
		|INTO SegmentSelection
		|FROM
		|	InformationRegister.SegmentProducts AS SegmentProducts
		|		{WHERE
		|			SegmentProducts.Products.*    AS Products,
		|			SegmentProducts.Characteristic.*  AS Characteristic,
		|			SegmentProducts.Segment.*         AS ProductSegment}
		|WHERE
		|	&FilterByProductSegmentIsUsed
		|INDEX BY
		|	Products, Characteristic
		|;
		|
		|//////////////////////////////////////////////////
		|
		|SELECT ALLOWED
		|	T.Products             AS Products,
		|	T.Characteristic           AS Characteristic,
		|	T.Warehouse                    AS Warehouse,
		|	T.Department            AS Department,
		|	T.Purpose               AS Purpose,
		|	T.SupplyMethod        AS SupplyMethod,
		|	SUM(T.Count)        AS Count
		|
		|INTO TTNeeds
		|FROM (
		|	SELECT
		|		T.Products             AS Products,
		|		T.Characteristic           AS Characteristic,
		|		CASE WHEN T.Warehouse REFS Catalog.Warehouses THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|			END                  AS Warehouse,
		|		CASE WHEN T.Warehouse REFS Catalog.BusinessStructure THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END                  AS Department,
		|		T.Purpose               AS Purpose,
		|		CatMethod.Ref           AS SupplyMethod,
		|		T.Count               AS Count
		|	FROM
		|		InformationRegister.InventoryAllocation AS T
		|	
		|			LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|			ON &MainSupplyMethodSubstitution
		|
		|	WHERE
		|		T.DemandCharacteristic IN(
		|			VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
		|			VALUE(Enum.DemandCharacteristics.SnoozeReservation),
		|			VALUE(Enum.DemandCharacteristics.ToSupply))
		|
		//linker selections
		|	{WHERE
		|		T.Products.*                                       AS Products,
		|		T.Characteristic.*                                     AS Characteristic,
		|		T.Purpose.*                                         AS Purpose,
		|		CAST(
		|			CASE
		|				WHEN T.Warehouse REFS Catalog.BusinessStructure
		|					THEN T.Warehouse
		|				ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit}
		|
		|	{WHERE T.ShipmentOrder IN(
		|		SELECT
		|			FilterTable.OrderDocument   AS OrderDocument
		|		FROM
		|			FilterByOrders AS FilterTable
		|		WHERE
		|			&FilterByOrdersIsUsed)}
		|
		|	{WHERE (T.Products, T.Characteristic) IN(
		|		SELECT
		|			FilterTable.Products   AS Products,
		|			FilterTable.Characteristic AS Characteristic
		|		FROM
		|			SegmentSelection AS FilterTable
		|		WHERE
		|			&FilterByProductSegmentIsUsed)}
		|
		|	UNION ALL
		|
		|	SELECT
		|		T.Products             AS Products,
		|		T.Characteristic           AS Characteristic,
		|		CASE WHEN T.Warehouse REFS Catalog.Warehouses THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|			END                  AS Warehouse,
		|		CASE WHEN T.Warehouse REFS Catalog.BusinessStructure THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END                  AS Department,
		|		T.Purpose               AS Purpose,
		|		CatMethod.Ref           AS SupplyMethod,
		|
		|		SUM(T.ToSupply - T.Replaced - T.AllocatedFromAvailableInventoryWithAssignment - T.AllocatedInAssignedProductionLots) AS Count
		|	FROM
		|		InformationRegister.OrderStructure AS T
		|
		|			LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|			ON &MainSupplyMethodSubstitution
		|
		|	WHERE
		|		T.LineKind NOT IN (
		|				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
		|				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
		|				VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))
		|
		|	{WHERE
		|		T.Products.*                                       AS Products,
		|		T.Characteristic.*                                     AS Characteristic,
		|		T.Purpose.*                                         AS Purpose,
		|		CAST(
		|			CASE
		|				WHEN T.Warehouse REFS Catalog.BusinessStructure
		|					THEN T.Warehouse
		|				ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit}
		|
		|	{WHERE T.ProductionOrder IN (
		|		SELECT
		|			FilterTable.OrderDocument AS OrderDocument
		|		FROM
		|			FilterByOrders AS FilterTable
		|		WHERE
		|			&FilterByOrdersIsUsed)}
		|
		|	{WHERE (T.Products, T.Characteristic) IN(
		|		SELECT
		|			FilterTable.Products   AS Products,
		|			FilterTable.Characteristic AS Characteristic
		|		FROM
		|			SegmentSelection AS FilterTable
		|		WHERE
		|			&FilterByProductSegmentIsUsed)}
		|
		|	GROUP BY
		|		T.Products,
		|		T.Characteristic,
		|		CASE WHEN T.Warehouse REFS Catalog.Warehouses THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|			END,
		|		CASE WHEN T.Warehouse REFS Catalog.BusinessStructure THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END,
		|		T.Purpose,
		|		CatMethod.Ref
		|
		|	HAVING
		|		SUM(T.ToSupply - T.Replaced - T.AllocatedFromAvailableInventoryWithAssignment - T.AllocatedInAssignedProductionLots) > 0
		|
		|	UNION ALL
		|
		|	SELECT
		|		T.Products             AS Products,
		|		T.Characteristic           AS Characteristic,
		|		CASE WHEN T.Warehouse REFS Catalog.Warehouses THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|			END                  AS Warehouse,
		|		CASE WHEN T.Warehouse REFS Catalog.BusinessStructure THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END                  AS Department,
		|		T.StructureAssignment      AS Purpose,
		|		CatMethod.Ref           AS SupplyMethod,
		|	
		|		SUM(T.AllocatedFromAvailableInventoryWithAssignment + T.AllocatedInAssignedProductionLots) AS Count
		|	FROM
		|		InformationRegister.OrderStructure AS T
		|
		|			LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|			ON &MainSupplyMethodSubstitution
		|
		|	WHERE
		|		T.LineKind NOT IN (
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))
		|
		|	{WHERE
		|		T.Products.*                                       AS Products,
		|		T.Characteristic.*                                     AS Characteristic,
		|		T.StructureAssignment.*                                AS Purpose,
		|		CAST(
		|			CASE
		|				WHEN T.Warehouse REFS Catalog.BusinessStructure
		|					THEN T.Warehouse
		|				ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit}
		|
		|	{WHERE T.ProductionOrder IN (
		|		SELECT
		|			FilterTable.OrderDocument AS OrderDocument
		|		FROM
		|			FilterByOrders AS FilterTable
		|		WHERE
		|			&FilterByOrdersIsUsed)}
		|
		|	{WHERE (T.Products, T.Characteristic) IN(
		|		SELECT
		|			FilterTable.Products   AS Products,
		|			FilterTable.Characteristic AS Characteristic
		|		FROM
		|			SegmentSelection AS FilterTable
		|		WHERE
		|			&FilterByProductSegmentIsUsed)}
		|
		|	GROUP BY
		|		T.Products,
		|		T.Characteristic,
		|		CASE WHEN T.Warehouse REFS Catalog.Warehouses THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|			END,
		|		CASE WHEN T.Warehouse REFS Catalog.BusinessStructure THEN
		|				T.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END,
		|		T.StructureAssignment,
		|		CatMethod.Ref
		|
		|	HAVING
		|		SUM(T.AllocatedFromAvailableInventoryWithAssignment + T.AllocatedInAssignedProductionLots) > 0
		|) AS T
		|
		|GROUP BY
		|	T.Products,
		|	T.Characteristic,
		|	T.Warehouse,
		|	T.Department,
		|	T.Purpose,
		|	T.SupplyMethod
		|
		|HAVING
		|	SUM(T.Count) > 0
		|
		|;
		|
		|////////////////////////////////////////////
		|"
		
		+ ?(Not GoodsOfSupportedStock, "", InformationRegisters.ProductRestrictions.TemporaryTableGoodsOfSupportedStock());
		
		Texts = New Array();
		Texts.Add(QueryText);
		Texts.Add("DROP TTWarehouseFormats");
		Texts.Add(Common.QueryBatchSeparator());
		QueryText = TempTableOfMovementWithinNetwork("TTNeeds", True);
		Texts.Add(QueryText);
		Texts.Add(Common.QueryBatchSeparator());
		
		QueryText = StrConcat(Texts);
		
		QueryText = QueryText +
		// Methods of securing goods from shipment orders with the option of securing "To secure" and "Reserve as received".
		"SELECT ALLOWED DISTINCT
		|	T.Products      AS Products,
		|	T.Characteristic    AS Characteristic,
		|	T.Warehouse             AS Warehouse,
		|	T.SupplyMethod AS SupplyMethod,
		|	T.Count        AS Count
		|INTO TTRemoteWarehousesWaysToSecure
		|FROM
		|	TTNeeds AS T
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Topology.Products   =  T.Products
		|		 AND Topology.Characteristic =  T.Characteristic
		|		 AND Topology.Warehouse          =  T.Warehouse
		|		 AND Topology.Center          =  T.Warehouse
		|WHERE
		|	Topology.Products IS NULL
		|;
		|
		|/////////////////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED DISTINCT
		|	Demands.Products AS Products,
		|	Demands.Characteristic AS Characteristic,
		|	CAST(Topology.Center AS Catalog.Warehouses) AS Warehouse
		|INTO TTDistributionCentersSupplyMethods
		|FROM
		|	TTNeeds AS Demands
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Topology.Products   =  Demands.Products
		|		 AND Topology.Characteristic =  Demands.Characteristic
		|		 AND Topology.Warehouse          =  Demands.Warehouse
		|		
		|		LEFT JOIN MovementsWithinNetwork AS OrdersWithinNetwork
		|		ON OrdersWithinNetwork.Products = Demands.Products
		|		 AND OrdersWithinNetwork.Characteristic = Demands.Characteristic
		|		 AND OrdersWithinNetwork.Purpose = Demands.Purpose
		|		 AND OrdersWithinNetwork.Warehouse = Topology.Center
		|		 AND OrdersWithinNetwork.OrderDocument = UNDEFINED
		|WHERE
		|	NOT Topology.Products IS NULL
		|GROUP BY
		|	Demands.Products,
		|	Demands.Characteristic,
		|	Demands.Purpose,
		|	Topology.Center
		|HAVING
		|	SUM(Demands.Count)
		|			- MAX(
		|				ISNULL(
		|					OrdersWithinNetwork.ReserveAsReceived
		|						+ OrdersWithinNetwork.SnoozeReservation
		|						+ OrdersWithinNetwork.ToSupply, 0)) > 0
		|;
		|
		|//////////////////////////////////////////////////
		|";
		
	UseProductRange = GetFunctionalOption("UseProductRange");
	TextWaysToEnsure = "";
	If Not UseProductRange Then
		
		TextWaysToEnsure =
			"SELECT ALLOWED DISTINCT
			|	T.SupplyMethod AS SupplyMethod
			|INTO SupplyMethods
			|FROM
			|	&QueryTextSet_ AS T
			|WHERE
			|	&AccessConditionBySecurityType
			|INDEX BY
			|	SupplyMethod
			|;
			|
			|//////////////////////////////
			|";
			
	Else
		Texts = New Array();
		Text =
			"SELECT ALLOWED DISTINCT
			|	T.Products AS Products,
			|	T.Warehouse AS Warehouse,
			|	T.SupplyMethod AS SupplyMethod
			|INTO TTProducts_1
			|FROM
			|	&QueryTextSet_ AS T
			|WHERE
			|	&AccessConditionBySecurityType
			|INDEX BY
			|	SupplyMethod
			|;
			|
			|///////////////////////////////////////
			|SELECT DISTINCT
			|	T.SupplyMethod AS Ref
			|INTO SupplyMethodsTemporary
			|FROM
			|	TTProducts_1 AS T
			|INDEX BY
			|	Ref";
		Texts.Add(Text);
		
		Text = ProvisionInDocumentsServer.TempTableYearsOfEnterpriseSchedule();
		Texts.Add(Text);
		
		Text =
			"SELECT
			|	Table.Ref AS Ref,
			|	CalculationOfDeliveryDateOverridable.PlannedDeliveryDate AS ShipmentDate
			|INTO NextCycleBySupplyMethods
			|FROM
			|	SupplyMethodsTemporary AS Table
			|		
			|		LEFT JOIN CalculationOfDeliveryDateOverridable ON TRUE
			|INDEX BY
			|	Ref";
		
		Substitutions = ProvisionInDocumentsServer.SubstitutionsOfPlannedDeliveryDate(
			"Table.Ref",
			"&CurrentDayStart");
		
		Text = StrReplace(Text, "CalculationOfDeliveryDateOverridable.PlannedDeliveryDate", Substitutions.Field);
		Text = StrReplace(Text, "LEFT JOIN CalculationOfDeliveryDateOverridable ON TRUE", Substitutions.Joins);
		Texts.Add(Text);
		
		Text = TemporaryTableBanningPurchasesByAssortment(UseProductRange, False);
		Texts.Add(Text);
		
		Texts.Add(
			"DROP YearsOfEnterpriseScheduleTemporary;
			|DROP YearsOfEnterpriseSchedule");
		
		Text =
			"SELECT DISTINCT
			|	T.SupplyMethod AS SupplyMethod
			|INTO SupplyMethods
			|FROM
			|	TTProducts_1 AS T
			|		LEFT JOIN NextCycleBySupplyMethods AS TableOfSecurityMethods
			|		ON T.SupplyMethod = TableOfSecurityMethods.Ref
			|		LEFT JOIN ProhibitionOfPurchasingByAssortment AS ProhibitionOfPurchasingByAssortment
			|		ON ProhibitionOfPurchasingByAssortment.Warehouse = T.Warehouse
			|		 AND ProhibitionOfPurchasingByAssortment.Products = T.Products
			|		 AND ProhibitionOfPurchasingByAssortment.PossibleDeliveryDate = ISNULL(TableOfSecurityMethods.ShipmentDate, &CurrentDayStart)
			|WHERE
			|	ProhibitionOfPurchasingByAssortment.Warehouse IS NULL";
		Texts.Add(Text);
		
		Text = StrConcat(Texts, Common.QueryBatchSeparator());
		TextWaysToEnsure = Text + Common.QueryBatchSeparator();
		
	EndIf;
	
	QueryText = QueryText + TextWaysToEnsure;
	
	DataSource = DataSourceForAssuranceMethods(GoodsOfSupportedStock);
	QueryText = StrReplace(QueryText, "&QueryTextSet_", StrTemplate("(%1)", DataSource));
	QueryText = InformationRegisters.SupplySchemes.SubstituteConnectionToGetSecurityMethod(
		QueryText, "MainSupplyMethodSubstitution");
	
	QueryText = QueryText +
		// A dummy query so that the DCS does not delete the necessary temporary tables, simplifying the query.
		"SELECT TOP 1
		|	T.SupplyMethod AS SupplyMethod
		|{SELECT
		|	SupplyMethod.* AS SupplyMethod}
		|FROM
		|	SupplyMethods AS T";
	
	AvailableTypesOfCollateral = AvailableTypesOfCollateral(PurposeUseKey);
	TextOfAccessConditionBySecurityType = ?(AvailableTypesOfCollateral = Undefined,
		"TRUE",
		"ISNULL(T.SupplyMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) IN (&AvailableTypesOfCollateral)");
	If Not GetFunctionalOption("UsePurchaseOrders")
			And (AvailableTypesOfCollateral = Undefined Or AvailableTypesOfCollateral.Count() > 0) Then
		TextOfAccessConditionBySecurityType = ?(AvailableTypesOfCollateral = Undefined,
			"TRUE",
			"(T.SupplyMethod.SupplyType IS NULL OR T.SupplyMethod.SupplyType IN(&AvailableTypesOfCollateral))");
	EndIf;
	TextOfAccessConditionBySecurityType = TextOfAccessConditionBySecurityType + "
		|";
	
	QueryText = StrReplace(QueryText, "&AccessConditionBySecurityType", TextOfAccessConditionBySecurityType);
	
	Return QueryText;

EndFunction

Function DataSourceForAssuranceMethods(GoodsOfSupportedStock)
	
	QueryTextSet_ = New Array();
	If GoodsOfSupportedStock Then
		QueryTextSet_.Add(
		"SELECT
		|		T.Products                   AS Products,
		|		T.Warehouse                          AS Warehouse,
		|		CatMethod.Ref                 AS SupplyMethod,
		|		0                                AS Count
		|	FROM
		// Methods of providing goods for which a stock is maintained.
		|		TTGoodsOfSupportedStock AS T
		|	
		|			LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|			ON &MainSupplyMethodSubstitution
		|	WHERE
		|		T.InventoryReplenishmentMethod <> VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)
		|		AND (&UseItemVariants
		|			OR T.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef))
		|	
		//linker selections
		|	{WHERE
		|		VALUE(Catalog.Assignments.EmptyRef)              AS Purpose,
		|		VALUE(Catalog.BusinessStructure.EmptyRef)    AS ReceivingBusinessUnit,
		|		VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
		|		UNDEFINED                                              AS OrderDocument}
		|	
		|	{WHERE
		|		T.Warehouse.*                                                                          AS Warehouse,
		|		(ISNULL(CatMethod.Ref,
		|			VALUE(Catalog.ProcurementStrategies.EmptyRef))).*           AS SupplyMethod,
		|		ISNULL(CatMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|		CAST(
		|			CASE
		|				WHEN CatMethod.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|					CatMethod.Department
		|				ELSE
		|					ISNULL(T.Warehouse.Department,
		|						VALUE(Catalog.BusinessStructure.EmptyRef))
		|			END AS Catalog.BusinessStructure).*                                   AS Department,
		|		(ISNULL(CatMethod.SourceOfDemandSupply, UNDEFINED)).*              AS SupplySource,
		|		(ISNULL(CatMethod.EmployeeResponsible, UNDEFINED)).*                                AS Manager}");
		
		EndIf;
	
	QueryTextSet_.Add(
		"SELECT
		|	T.Products                   AS Products,
		|	T.Warehouse                          AS Warehouse,
		|	T.SupplyMethod              AS SupplyMethod,
		|	T.Count                     AS Count
		|FROM
		|	TTRemoteWarehousesWaysToSecure AS T
		|{WHERE
		|	T.Warehouse.*                                                                                    AS Warehouse,
		|	(ISNULL(T.SupplyMethod,
		|		VALUE(Catalog.ProcurementStrategies.EmptyRef))).*                     AS SupplyMethod,
		|	ISNULL(T.SupplyMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|	CAST(
		|		CASE
		|			WHEN T.SupplyMethod.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|				T.SupplyMethod.Department
		|			ELSE
		|				ISNULL(T.Warehouse.Department,
		|					VALUE(Catalog.BusinessStructure.EmptyRef))
		|		END AS Catalog.BusinessStructure).*                                             AS Department,
		|	(ISNULL(T.SupplyMethod.SourceOfDemandSupply, UNDEFINED)).*              AS SupplySource,
		|	(ISNULL(T.SupplyMethod.EmployeeResponsible, UNDEFINED)).*                                AS Manager}
		|
		|UNION ALL
		|
		|SELECT
		|	T.Products                   AS Products,
		|	T.Warehouse                          AS Warehouse,
		|	CatMethod.Ref                 AS SupplyMethod,
		|	0                                AS Count
		|FROM
		|	TTDistributionCentersSupplyMethods AS T
		|		LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|		ON &MainSupplyMethodSubstitution
		|	{WHERE
		|		T.Warehouse.*                                                                                    AS Warehouse,
		|		(ISNULL(CatMethod.Ref,
		|			VALUE(Catalog.ProcurementStrategies.EmptyRef))).*           AS SupplyMethod,
		|		ISNULL(CatMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|		CAST(
		|			CASE
		|				WHEN CatMethod.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|					CatMethod.Department
		|				ELSE
		|					ISNULL(T.Warehouse.Department,
		|						VALUE(Catalog.BusinessStructure.EmptyRef))
		|			END AS Catalog.BusinessStructure).*                                   AS Department,
		|		(ISNULL(CatMethod.SourceOfDemandSupply, UNDEFINED)).*              AS SupplySource,
		|		(ISNULL(CatMethod.EmployeeResponsible, UNDEFINED)).*                                AS Manager}");
		
	QuerySetText = StrConcat(QueryTextSet_, TMCommonUse.QuerySeparatorInJoin());
	Return QuerySetText;
	
EndFunction

#Region FunctionalOptions

Function ConstantAffectsAvailabilityOfProcessing(ConstantName)
	
	For Each DescriptionOfSupplyTypeAvailability In DescriptionOfAvailabilityOfSupplyTypes() Do
		
		FunctionalOption = DescriptionOfSupplyTypeAvailability.FunctionalOption; // MetadataObjectFunctionalOption
		
		If FunctionalOption.Location.Name = ConstantName Then
			Return True;
		EndIf;
		
	EndDo;
	
	Return False;
	
EndFunction

// Updates constants:
// Use Extended support - False if order generation is not available.
//                                    - True if any orders are being formed, but orders to suppliers are disabled
// Use the formationapplication of needs - If extended support and purchase requests are enabled. 
// Disables everything if it is a basic version. 
Procedure UpdateValuesOfSubordinateConstants()
		
	AvailabilityOfUseDestinationKeys = AvailabilityOfUseDestinationKeys(False);
	
	#Region UseAdvancedDemandFulfillment
	
	AdvancedSupplyIsAvailable = AvailabilityOfUseDestinationKeys.Get(
		SupplyClientServer.KeyToPurposeOfUsingFormationOfOrdersAccordingToNeeds());
	
	AdvancedSupplyIsUsed = Constants.UseAdvancedDemandFulfillment.Get();
	
	If Not AdvancedSupplyIsAvailable
		And AdvancedSupplyIsUsed Then
		// All orders are disabled, or this is the basic version. 
		AdvancedSupplyIsUsed = False;
		Constants.UseAdvancedDemandFulfillment.Set(AdvancedSupplyIsUsed);
	ElsIf AdvancedSupplyIsAvailable
		And Not AdvancedSupplyIsUsed
		And Not Constants.UsePurchaseOrders.Get() Then
		// Without orders, only advanced software can be available to suppliers.
		AdvancedSupplyIsUsed = True;
		Constants.UseAdvancedDemandFulfillment.Set(AdvancedSupplyIsUsed);
	EndIf;
	
	#EndRegion
	
	#Region UseGeneratePurchaseRequestsByDemand
	
	FormationOfApplicationsIsAvailable = AdvancedSupplyIsUsed
		And AvailabilityOfUseDestinationKeys.Get(
			SupplyClientServer.KeyToPurposeOfUsingFormationOfApplicationsAccordingToNeeds());
	
	If FormationOfApplicationsIsAvailable <> Constants.UseGeneratePurchaseRequestsByDemand.Get() Then
		Constants.UseGeneratePurchaseRequestsByDemand.Set(FormationOfApplicationsIsAvailable);
	EndIf;
	
	#EndRegion
	
EndProcedure

// Checks the availability of usage destination keys based on functional options.
//
// Parameters:
//   UseCachedValues - Boolean - Use cached values of functional options.
//
// Returns:
//   Map of KeyAndValue:
//    * Key - String - The key for the purpose of using processing. 
//       For example, See SupplyClientServer.KeyToPurposeOfUsingFormationOfApplicationsAccordingToNeeds
//                      ().
//    * Value - Boolean - Availability of the usage destination key.
//
Function AvailabilityOfUseDestinationKeys(UseCachedValues)
	
	ReturnValue = New Map;
	IsBaseVersion = StandardSubsystemsServer.IsBaseConfigurationVersion();
	
	For Each DescriptionOfSupplyTypeAvailability In DescriptionOfAvailabilityOfSupplyTypes() Do
		
		PurposeUseKey = DescriptionOfSupplyTypeAvailability.PurposeUseKey;
		
		If ReturnValue[PurposeUseKey] = Undefined Then
			ReturnValue[PurposeUseKey] = False;
		EndIf;
		
		If IsBaseVersion Then
			Continue; // Processing is not available.
		EndIf;
			
		If ReturnValue[PurposeUseKey] Then
			Continue;
		EndIf;
		
		FunctionalOption = DescriptionOfSupplyTypeAvailability.FunctionalOption; // MetadataObjectFunctionalOption
		If UseCachedValues Then
			OptionIsEnabled = GetFunctionalOption(FunctionalOption.Name);
		Else
			StoringOptions = FunctionalOption.Location; // MetadataObjectConstant
			OptionIsEnabled = Constants[StoringOptions.Name].Get();
		EndIf;
		
		If Not OptionIsEnabled Then
			Continue;
		EndIf;
		
		ReturnValue[PurposeUseKey] = True;
		
	EndDo;
	
	Return ReturnValue;
	
EndFunction

#EndRegion

#Region AvailableTypesOfCollateral

// Returns an array of available types of supply needs, depending on access rights and functional options.
//
// Parameters:
//   PurposeUseKey - String - Key for the purpose of using processing
//    For example, See SupplyClientServer.KeyToPurposeOfUsingFormationOfApplicationsAccordingToNeeds
//                                          ().
//
// Returns:
//   Array of EnumRef.SupplyTypes, Undefined - An array of available types of collateral or Undefined if there are no restrictions.
Function AvailableTypesOfCollateral(PurposeUseKey) Export
	
	AvailabilityOfSupplyTypes = New Map;
	For Each SupplyType In Enums.SupplyTypes Do
		AvailabilityOfSupplyTypes.Insert(SupplyType, False);
	EndDo;
	
	For Each DescriptionOfSupplyTypeAvailability In DescriptionOfAvailabilityOfSupplyTypes() Do
		
		SupplyType = DescriptionOfSupplyTypeAvailability.SupplyType;
		
		If AvailabilityOfSupplyTypes[SupplyType] Then
			Continue; // Availability is determined by "Or". If it is already available, then there is no point in performing other checks.
		EndIf;
		
		If DescriptionOfSupplyTypeAvailability.PurposeUseKey <> PurposeUseKey Then
			Continue; // The availability determination is performed within the scope of the processing usage assignment key.
		EndIf;
		
		FunctionalOption = DescriptionOfSupplyTypeAvailability.FunctionalOption; // MetadataObjectFunctionalOption
		If Not GetFunctionalOption(FunctionalOption.Name) Then
			Continue;
		EndIf;
		
		If Not AccessRight("Insert", DescriptionOfSupplyTypeAvailability.AccessObject) Then
			Continue;
		EndIf;
		
		AvailabilityOfSupplyTypes[SupplyType] = True;
		
	EndDo;
	
	ThereAreLimitations = False;
	ReturnValue = New Array;
	
	For Each KeyAndValue In AvailabilityOfSupplyTypes Do
		
		If KeyAndValue.Value Then
			ReturnValue.Add(KeyAndValue.Key);
		Else
			ThereAreLimitations = True;
		EndIf;
		
	EndDo;
	
	If Not ThereAreLimitations Then
		ReturnValue = Undefined;
	EndIf;
	
	Return ReturnValue;
	
EndFunction

Function DescriptionOfAvailabilityOfSupplyTypes() 
	
	Return SupplyCached.DescriptionOfAvailabilityOfSupplyTypes();
	
EndFunction

#EndRegion

Function TemporaryTableOrderFillingDataForSupplier()
	
	Texts = New Array();
	
	FillInAccordingToStatistics = CommonSettingsStorage.Load(
		"DocumentSettings_", "FillInDocumentAttributesUsingStatisticalData");
	
	If FillInAccordingToStatistics = False Then
		QueryText =
		"SELECT
		|	VALUE(Catalog.Products.EmptyRef) AS Products,
		|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
		|	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
		|	VALUE(Catalog.Partners.EmptyRef) AS Partner,
		|	VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef) AS Terms,
		|	VALUE(Catalog.Currencies.EmptyRef) Currency,
		|	VALUE(Catalog.VendorPriceTypes.EmptyRef) AS VendorPriceKind
		|
		|INTO TTOrderFillingDataToSupplier
		|WHERE
		|	FALSE
		|INDEX BY
		|	Products, Characteristic, Warehouse";
	Else
		QueryText =
		// 1) The date of the last order for an item that requires filling in the collateral source.
		"SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|
		|	MAX(Goods.Ref.Date) AS LastOrderDate
		|
		|INTO TTLastOrderDate
		|FROM
		|	TTProducts_1 AS T
		|
		|		INNER JOIN Document.PurchaseOrder.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse          = Goods.Warehouse
		|WHERE
		|	(T.SupplyMethod IS NULL
		|	OR T.SupplyMethod = VALUE(Catalog.ProcurementStrategies.EmptyRef)
		|	OR (T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Purchase)
		|			AND T.SupplyMethod.SourceOfDemandSupply IN(UNDEFINED,
		|					VALUE(Catalog.Partners.EmptyRef),
		|					VALUE(Catalog.Warehouses.EmptyRef),
		|					VALUE(Catalog.BusinessStructure.EmptyRef))))
		|	AND Goods.Ref.Posted
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|
		|	MAX(Goods.Ref.Date) AS DateOfLastPurchaseRequest
		|
		|INTO TTIsDateOfLastPurchaseRequest
		|FROM
		|	TTProducts_1 AS T
		|
		|		LEFT JOIN Document.PurchaseRequest.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse          = Goods.Warehouse
		|		 AND Goods.Ref.Posted
		|WHERE
		|	(T.SupplyMethod IS NULL
		|	OR T.SupplyMethod = VALUE(Catalog.ProcurementStrategies.EmptyRef)
		|	OR (T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Purchase)
		|			AND T.SupplyMethod.SourceOfDemandSupply IN(UNDEFINED,
		|					VALUE(Catalog.Partners.EmptyRef),
		|					VALUE(Catalog.Warehouses.EmptyRef),
		|					VALUE(Catalog.BusinessStructure.EmptyRef))))
		|	AND &GeneratePurchaseRequests
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	T.DateOfLastPurchaseRequest AS DateOfLastPurchaseRequest,
		|	MAX(Goods.LineNumber) AS LineNumberOfLastPurchaseRequest
		|
		|INTO TTDateLineNumberOfLastPurchaseRequest
		|FROM
		|	TTIsDateOfLastPurchaseRequest AS T
		|
		|		LEFT JOIN Document.PurchaseRequest.Goods AS Goods
		|		ON T.Products= Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse = Goods.Warehouse
		|		 AND T.DateOfLastPurchaseRequest = Goods.Ref.Date
		|		 AND Goods.Ref.Posted
		|WHERE
		|	&GeneratePurchaseRequests
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse, T.DateOfLastPurchaseRequest
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// 2 Date of the penultimate order.
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	MAX(T.LastOrderDate)  AS LastOrderDate,
		|	MAX(CASE WHEN T.LastOrderDate = Goods.Ref.Date THEN
		|				NULL
		|			ELSE Goods.Ref.Date
		|		END)                        AS DateOfPenultimateOrder
		|	
		|INTO TTIsDateOfPenultimateOrder
		|FROM
		|	TTLastOrderDate AS T
		|		INNER JOIN Document.PurchaseOrder.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|WHERE
		|	Goods.Ref.Posted
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	T.DateOfLastPurchaseRequest AS DateOfLastPurchaseRequest,
		|	T.LineNumberOfLastPurchaseRequest AS LineNumberOfLastPurchaseRequest,
		|	MAX(CASE
		|		WHEN T.DateOfLastPurchaseRequest = Goods.Ref.Date
		|			AND T.LineNumberOfLastPurchaseRequest = Goods.LineNumber
		|			THEN NULL
		|		ELSE
		|			Goods.Ref.Date
		|		END)       AS DateOfPenultimatePurchaseRequest
		|	
		|INTO TTIsDateOfPenultimatePurchaseRequest
		|FROM
		|	TTDateLineNumberOfLastPurchaseRequest AS T
		|		LEFT JOIN Document.PurchaseRequest.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|		 AND Goods.Ref.Posted
		|WHERE
		|	&GeneratePurchaseRequests
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse, T.DateOfLastPurchaseRequest, T.LineNumberOfLastPurchaseRequest
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	T.DateOfLastPurchaseRequest AS DateOfLastPurchaseRequest,
		|	T.LineNumberOfLastPurchaseRequest AS LineNumberOfLastPurchaseRequest,
		|	T.DateOfPenultimatePurchaseRequest AS DateOfPenultimatePurchaseRequest,
		|	MAX(CASE
		|		WHEN T.DateOfLastPurchaseRequest = Goods.Ref.Date
		|			AND T.LineNumberOfLastPurchaseRequest = Goods.LineNumber
		|			THEN NULL
		|		ELSE
		|			Goods.LineNumber
		|		END)       AS LineNumberOfPenultimatePurchaseRequest
		|	
		|INTO TTDateLineNumberOfPenultimatePurchaseRequest
		|FROM
		|	TTIsDateOfPenultimatePurchaseRequest AS T
		|		LEFT JOIN Document.PurchaseRequest.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|		 AND T.DateOfPenultimatePurchaseRequest = Goods.Ref.Date
		|		 AND Goods.Ref.Posted
		|WHERE
		|	&GeneratePurchaseRequests
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse, T.DateOfLastPurchaseRequest, T.LineNumberOfLastPurchaseRequest, T.DateOfPenultimatePurchaseRequest
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// 3) The date of the third order.
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	MAX(T.LastOrderDate)     AS LastOrderDate,
		|	MAX(T.DateOfPenultimateOrder) AS DateOfPenultimateOrder,
		|	MAX(CASE WHEN Goods.Ref.Date IN (T.LastOrderDate, T.DateOfPenultimateOrder) THEN
		|				NULL
		|			ELSE Goods.Ref.Date
		|		END)                           AS ThirdOrderDate
		|	
		|INTO TTThirdOrderDate
		|FROM
		|	TTIsDateOfPenultimateOrder AS T
		|		INNER JOIN Document.PurchaseOrder.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|WHERE
		|	Goods.Ref.Posted
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	T.DateOfLastPurchaseRequest AS DateOfLastPurchaseRequest,
		|	T.LineNumberOfLastPurchaseRequest AS LineNumberOfLastPurchaseRequest,
		|	T.DateOfPenultimatePurchaseRequest AS DateOfPenultimatePurchaseRequest,
		|	T.LineNumberOfPenultimatePurchaseRequest AS LineNumberOfPenultimatePurchaseRequest,
		|	MAX(CASE
		|		WHEN Goods.Ref.Date = T.DateOfLastPurchaseRequest
		|			AND Goods.LineNumber = T.LineNumberOfLastPurchaseRequest
		|				OR Goods.Ref.Date = T.DateOfPenultimatePurchaseRequest
		|					AND Goods.LineNumber = T.LineNumberOfPenultimatePurchaseRequest
		|			THEN NULL
		|		ELSE
		|			Goods.Ref.Date
		|		END) AS DateOfThirdPurchaseRequest
		|	
		|INTO TTIsDateOfThirdPurchaseRequest
		|FROM
		|	TTDateLineNumberOfPenultimatePurchaseRequest AS T
		|		LEFT JOIN Document.PurchaseRequest.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|		 AND Goods.Ref.Posted
		|WHERE
		|	&GeneratePurchaseRequests
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse, T.DateOfLastPurchaseRequest, T.LineNumberOfLastPurchaseRequest, T.DateOfPenultimatePurchaseRequest, T.LineNumberOfPenultimatePurchaseRequest
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|	T.DateOfLastPurchaseRequest AS DateOfLastPurchaseRequest,
		|	T.LineNumberOfLastPurchaseRequest AS LineNumberOfLastPurchaseRequest,
		|	T.DateOfPenultimatePurchaseRequest AS DateOfPenultimatePurchaseRequest,
		|	T.LineNumberOfPenultimatePurchaseRequest AS LineNumberOfPenultimatePurchaseRequest,
		|	T.DateOfThirdPurchaseRequest AS DateOfThirdPurchaseRequest,
		|	MAX(CASE
		|		WHEN Goods.Ref.Date = T.DateOfLastPurchaseRequest
		|			AND Goods.LineNumber = T.LineNumberOfLastPurchaseRequest
		|				OR Goods.Ref.Date = T.DateOfPenultimatePurchaseRequest
		|					AND Goods.LineNumber = T.LineNumberOfPenultimatePurchaseRequest
		|			THEN NULL
		|		ELSE
		|			Goods.LineNumber
		|		END) AS LineNumberOfThirdPurchaseOrder
		|	
		|INTO TTDateLineNumberOfThirdPurchaseOrder
		|FROM
		|	TTIsDateOfThirdPurchaseRequest AS T
		|		LEFT JOIN Document.PurchaseRequest.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|		 AND T.DateOfThirdPurchaseRequest = Goods.Ref.Date
		|		 AND Goods.Ref.Posted
		|WHERE
		|	&GeneratePurchaseRequests
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse, T.DateOfLastPurchaseRequest, T.LineNumberOfLastPurchaseRequest, T.DateOfPenultimatePurchaseRequest, T.LineNumberOfPenultimatePurchaseRequest, T.DateOfThirdPurchaseRequest
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// 4) The last three orders by position.
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|
		|	MAX(CASE WHEN T.LastOrderDate = Goods.Ref.Date THEN
		|				Goods.Ref
		|			ELSE NULL
		|		END)                           AS OrderDocument1,
		|	MAX(CASE WHEN T.DateOfPenultimateOrder = Goods.Ref.Date THEN
		|				Goods.Ref
		|			ELSE NULL
		|		END)                           AS OrderDocument2,
		|	MAX(CASE WHEN T.ThirdOrderDate = Goods.Ref.Date THEN
		|				Goods.Ref
		|			ELSE NULL
		|		END)                           AS OrderDocument3
		|
		|INTO TTLastThreeOrders
		|FROM
		|	TTThirdOrderDate AS T
		|		INNER JOIN Document.PurchaseOrder.Goods AS Goods
		|		ON T.Products   = Goods.Products
		|		 AND T.Characteristic = Goods.Characteristic
		|		 AND T.Warehouse         = Goods.Warehouse
		|		 AND Goods.Ref.Date IN (T.LastOrderDate, T.DateOfPenultimateOrder, T.ThirdOrderDate)
		|WHERE
		|	Goods.Ref.Posted
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse
		|INDEX BY
		|	OrderDocument1, OrderDocument2, OrderDocument3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// 5) Data for filling in the source of collateral and the terms of purchase.
		|SELECT ALLOWED
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|
		|	CASE WHEN T.OrderDocument2.Partner IS NULL THEN
		|				T.OrderDocument1.Partner
		|			WHEN T.OrderDocument3.Partner IS NULL THEN
		|				CASE WHEN T.OrderDocument1.Partner = T.OrderDocument2.Partner THEN
		|							T.OrderDocument1.Partner
		|						ELSE VALUE(Catalog.Partners.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN T.OrderDocument1.Partner = T.OrderDocument2.Partner OR T.OrderDocument1.Partner = T.OrderDocument3.Partner THEN
		|							T.OrderDocument1.Partner
		|						WHEN T.OrderDocument2.Partner = T.OrderDocument3.Partner THEN
		|							T.OrderDocument2.Partner
		|						ELSE VALUE(Catalog.Partners.EmptyRef)
		|					END
		|		END       AS Partner,
		|
		|	CASE WHEN T.OrderDocument2.Partner IS NULL
		|					AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|				T.OrderDocument1.Terms
		|			WHEN T.OrderDocument3.Partner IS NULL THEN
		|				CASE WHEN T.OrderDocument1.Terms = T.OrderDocument2.Terms
		|							AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument1.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN (T.OrderDocument1.Terms = T.OrderDocument2.Terms OR T.OrderDocument1.Terms = T.OrderDocument3.Terms)
		|							AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument1.Terms
		|						WHEN T.OrderDocument2.Terms = T.OrderDocument3.Terms
		|							AND T.OrderDocument2.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument2.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|		END       AS Terms,
		|
		|	CAST(CASE WHEN T.OrderDocument2.Partner IS NULL
		|						AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|				T.OrderDocument1.Terms
		|			WHEN T.OrderDocument3.Partner IS NULL THEN
		|				CASE WHEN T.OrderDocument1.Terms = T.OrderDocument2.Terms
		|							AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument1.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN (T.OrderDocument1.Terms = T.OrderDocument2.Terms OR T.OrderDocument1.Terms = T.OrderDocument3.Terms)
		|							AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument1.Terms
		|						WHEN T.OrderDocument2.Terms = T.OrderDocument3.Terms
		|							AND T.OrderDocument2.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument2.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|		END AS Catalog.TermsOfPurchaseFromVendors).Currency AS Currency,
		|
		|	CAST(CASE WHEN T.OrderDocument2.Partner IS NULL
		|				AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|				T.OrderDocument1.Terms
		|			WHEN T.OrderDocument3.Partner IS NULL THEN
		|				CASE WHEN T.OrderDocument1.Terms = T.OrderDocument2.Terms
		|							AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument1.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN (T.OrderDocument1.Terms = T.OrderDocument2.Terms OR T.OrderDocument1.Terms = T.OrderDocument3.Terms)
		|							AND T.OrderDocument1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument1.Terms
		|						WHEN T.OrderDocument2.Terms = T.OrderDocument3.Terms
		|							AND T.OrderDocument2.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							T.OrderDocument2.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|		END AS Catalog.TermsOfPurchaseFromVendors).VendorPriceKind AS VendorPriceKind
		|
		|INTO TTPurchaseOrderFillingDataToSupplierWithoutGrouping
		|FROM
		|	TTLastThreeOrders AS T
		|
		|UNION ALL
		|
		|SELECT
		|	T.Products   AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse          AS Warehouse,
		|
		|	CASE WHEN ApplicationProducts2.Partner IS NULL THEN
		|				ApplicationProducts1.Partner
		|			WHEN ApplicationProducts3.Partner IS NULL THEN
		|				CASE WHEN ApplicationProducts1.Partner = ApplicationProducts2.Partner THEN
		|							ApplicationProducts1.Partner
		|						ELSE VALUE(Catalog.Partners.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN ApplicationProducts1.Partner = ApplicationProducts2.Partner OR ApplicationProducts1.Partner = ApplicationProducts3.Partner THEN
		|							ApplicationProducts1.Partner
		|						WHEN ApplicationProducts2.Partner = ApplicationProducts3.Partner THEN
		|							ApplicationProducts2.Partner
		|						ELSE VALUE(Catalog.Partners.EmptyRef)
		|					END
		|		END      AS Partner,
		|
		|	CASE WHEN ApplicationProducts2.Partner IS NULL
		|					AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|				ApplicationProducts1.Terms
		|			WHEN ApplicationProducts3.Partner IS NULL THEN
		|				CASE WHEN ApplicationProducts1.Terms = ApplicationProducts2.Terms
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts1.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN (ApplicationProducts1.Terms = ApplicationProducts2.Terms OR ApplicationProducts1.Terms = ApplicationProducts3.Terms)
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts1.Terms
		|						WHEN ApplicationProducts2.Terms = ApplicationProducts3.Terms
		|							AND ApplicationProducts2.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts2.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|		END       AS Terms,
		|
		|	CAST(CASE WHEN ApplicationProducts2.Partner IS NULL
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|				ApplicationProducts1.Terms
		|			WHEN ApplicationProducts3.Partner IS NULL THEN
		|				CASE WHEN ApplicationProducts1.Terms = ApplicationProducts2.Terms
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts1.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN (ApplicationProducts1.Terms = ApplicationProducts2.Terms OR ApplicationProducts1.Terms = ApplicationProducts3.Terms)
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts1.Terms
		|						WHEN ApplicationProducts2.Terms = ApplicationProducts3.Terms
		|							AND ApplicationProducts2.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts2.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|		END AS Catalog.TermsOfPurchaseFromVendors).Currency AS Currency,
		|
		|	CAST(CASE WHEN ApplicationProducts2.Partner IS NULL
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|				ApplicationProducts1.Terms
		|			WHEN ApplicationProducts3.Partner IS NULL THEN
		|				CASE WHEN ApplicationProducts1.Terms = ApplicationProducts2.Terms
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts1.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|			ELSE
		|				CASE WHEN (ApplicationProducts1.Terms = ApplicationProducts2.Terms OR ApplicationProducts1.Terms = ApplicationProducts3.Terms)
		|							AND ApplicationProducts1.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts1.Terms
		|						WHEN ApplicationProducts2.Terms = ApplicationProducts3.Terms
		|							AND ApplicationProducts2.Terms.Status <> VALUE(Enum.StatusesOfTermsOfPurchase.Closed) THEN
		|							ApplicationProducts2.Terms
		|						ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
		|					END
		|		END AS Catalog.TermsOfPurchaseFromVendors).VendorPriceKind AS VendorPriceKind
		|
		|FROM
		|	TTDateLineNumberOfThirdPurchaseOrder AS T
		|	LEFT JOIN Document.PurchaseRequest.Goods AS ApplicationProducts1
		|		ON T.DateOfLastPurchaseRequest = ApplicationProducts1.Ref.Date
		|		 AND T.LineNumberOfLastPurchaseRequest = ApplicationProducts1.LineNumber
		|		 AND T.Products = ApplicationProducts1.Products
		|		 AND T.Characteristic = ApplicationProducts1.Characteristic
		|		 AND T.Warehouse = ApplicationProducts1.Warehouse
		|	LEFT JOIN Document.PurchaseRequest.Goods AS ApplicationProducts2
		|		ON T.DateOfPenultimatePurchaseRequest = ApplicationProducts2.Ref.Date
		|		 AND T.LineNumberOfPenultimatePurchaseRequest = ApplicationProducts2.LineNumber
		|		 AND T.Products = ApplicationProducts2.Products
		|		 AND T.Characteristic = ApplicationProducts2.Characteristic
		|		 AND T.Warehouse = ApplicationProducts2.Warehouse
		|	LEFT JOIN Document.PurchaseRequest.Goods AS ApplicationProducts3
		|		ON T.DateOfThirdPurchaseRequest = ApplicationProducts3.Ref.Date
		|		 AND T.LineNumberOfThirdPurchaseOrder = ApplicationProducts3.LineNumber
		|		 AND T.Products = ApplicationProducts3.Products
		|		 AND T.Characteristic = ApplicationProducts3.Characteristic
		|		 AND T.Warehouse = ApplicationProducts3.Warehouse
		|WHERE
		|	&GeneratePurchaseRequests
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.Products AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse AS Warehouse,
		|	T.Partner AS Partner,
		|	T.Terms AS Terms,
		|	T.Currency AS Currency,
		|	T.VendorPriceKind AS VendorPriceKind,
		|	RECORDAUTONUMBER() AS LineNumber
		|INTO TTPurchaseOrderFillingDataToLineNumber
		|FROM
		|	TTPurchaseOrderFillingDataToSupplierWithoutGrouping AS T
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.Products AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse AS Warehouse,
		|	MAX(T.LineNumber) AS LineNumber
		|INTO TTPurchaseOrderFillingDataGrouped
		|FROM
		|	TTPurchaseOrderFillingDataToLineNumber AS T
		|GROUP BY
		|	T.Products, T.Characteristic, T.Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.Products AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.Warehouse AS Warehouse,
		|	T.Partner AS Partner,
		|	T.Terms AS Terms,
		|	T.Currency AS Currency,
		|	T.VendorPriceKind AS VendorPriceKind
		|INTO TTOrderFillingDataToSupplier
		|FROM
		|	TTPurchaseOrderFillingDataToLineNumber AS T
		|	INNER JOIN TTPurchaseOrderFillingDataGrouped AS DataWithMaxLineNumber
		|		ON T.Products = DataWithMaxLineNumber.Products
		|			AND T.Characteristic = DataWithMaxLineNumber.Characteristic
		|			AND T.Warehouse = DataWithMaxLineNumber.Warehouse
		|			AND T.LineNumber = DataWithMaxLineNumber.LineNumber
		|";
		
	EndIf;
		
		// 6) Terms of delivery
	Texts.Add(QueryText);
	QueryText =
		"SELECT
		|	PurchaseConditions.Products AS Products,
		|	PurchaseConditions.Characteristic AS Characteristic,
		|	PurchaseConditions.VendorPriceKind AS VendorPriceKind,
		|	PurchaseConditions.OrderPackage AS OrderPackage,
		|	PurchaseConditions.MinimumDeliveryLot AS MinimumDeliveryLot
		|INTO TTTermsOfPurchase
		|FROM
		|	InformationRegister.PurchaseConditions.SliceLast(
		|		ENDOFPERIOD(&BeginOfPeriod, DAY),
		|		(Products, Characteristic, VendorPriceKind)
		|			IN (
		|				SELECT
		|					FilterTable.Products                                      AS Products,
		|					FilterTable.Characteristic                                    AS Characteristic,
		|					CASE
		|						WHEN ISNULL(FilterTable.SupplyMethod.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|								<> VALUE(Catalog.VendorPriceTypes.EmptyRef)
		|							THEN FilterTable.SupplyMethod.VendorPriceKind
		|						ELSE ISNULL(FilterTable.SupplyMethod.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|					END AS VendorPriceKind
		|				FROM
		|					TTProducts_1 AS FilterTable)) AS PurchaseConditions
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	VendorPriceKind
		|;
		|////////////////////////////////////////////////////////////////////////////////
		// 7) Prices of the nomenclature.
		|SELECT
		|		SupplierPrices.Products                AS Products,
		|		SupplierPrices.Characteristic              AS Characteristic,
		|		SupplierPrices.Partner                     AS Partner,
		|		SupplierPrices.VendorPriceKind           AS VendorPriceKind,
		|		SupplierPrices.Price                        AS Price,
		|		SupplierPrices.Package                    AS Package,
		|		SupplierPrices.Currency                      AS Currency
		|INTO TTSupplierPrices
		|FROM
		|	InformationRegister.ItemsPricesOfVendor.SliceLast(
		|		ENDOFPERIOD(&BeginOfPeriod, DAY),
		|		(Products, Characteristic, Partner, VendorPriceKind)
		|			IN (
		|				SELECT
		|					FilterTable.Products                                      AS Products,
		|					FilterTable.Characteristic                                    AS Characteristic,
		|					FilterTable.SupplyMethod.SourceOfDemandSupply AS Partner,
		|					CASE
		|						WHEN ISNULL(FilterTable.SupplyMethod.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|								<> VALUE(Catalog.VendorPriceTypes.EmptyRef)
		|							THEN FilterTable.SupplyMethod.VendorPriceKind
		|						ELSE ISNULL(FilterTable.SupplyMethod.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|					END AS VendorPriceKind
		|				FROM
		|					TTProducts_1 AS FilterTable
		|
		|				UNION ALL
		|
		|				SELECT
		|					T.Products           AS Products,
		|					T.Characteristic         AS Characteristic,
		|					T.Partner                AS Partner,
		|					T.VendorPriceKind      AS VendorPriceKind
		|				FROM
		|					TTOrderFillingDataToSupplier AS T)
		|	) AS SupplierPrices
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	Partner,
		|	VendorPriceKind
		|
		|;
		|////////////////////////////////////////////////////////////////////////////////
		// 8) Prices + Terms of purchase.
		|SELECT
		|	TTSupplierPrices.Products AS Products,
		|	TTSupplierPrices.Characteristic AS Characteristic,
		|	TTSupplierPrices.Partner AS Partner,
		|	TTSupplierPrices.VendorPriceKind AS VendorPriceKind,
		|	TTSupplierPrices.Price AS Price,
		|	TTSupplierPrices.Package AS Package,
		|	TTSupplierPrices.Currency AS Currency,
		|	TTTermsOfPurchase.OrderPackage AS SupplierOrderPackaging,
		|	TTTermsOfPurchase.MinimumDeliveryLot AS MinimumDeliveryLot
		|INTO SupplierPrices
		|FROM
		|	TTSupplierPrices AS TTSupplierPrices
		|		LEFT JOIN TTTermsOfPurchase AS TTTermsOfPurchase
		|		ON TTSupplierPrices.Products = TTTermsOfPurchase.Products
		|			AND TTSupplierPrices.Characteristic = TTTermsOfPurchase.Characteristic
		|			AND TTSupplierPrices.VendorPriceKind = TTTermsOfPurchase.VendorPriceKind
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	Partner,
		|	VendorPriceKind
		|;
		|////////////////////////////////////////////////////////////////////////////////
		// 9) Exchange rates.
		|SELECT
		|		ExchangeRates.Currency                      AS Currency,
		|		CASE
		|			WHEN ExchangeRates.CourseDenominator = 0
		|				THEN 0
		|			ELSE ExchangeRates.CourseNumerator / ExchangeRates.CourseDenominator
		|		END AS ZoomRatio
		|INTO ExchangeRates
		|FROM
		|	InformationRegister.RelativeExchangeRates.SliceLast(ENDOFPERIOD(&BeginOfPeriod, DAY),
		|		BaseCurrency IN (SELECT
		|		DefaultBaseCurrency.Value AS Value
		|	FROM
		|		Constant.DefaultBaseCurrency AS DefaultBaseCurrency)) AS ExchangeRates
		|	
		|INDEX BY
		|	Currency";

	Texts.Add(QueryText);
	QueryText = StrConcat(Texts, Common.QueryBatchSeparator());
	Return QueryText;

EndFunction

Function TempTableOfMovementWithinNetwork(NameOfFilterTable, ThereAreAssignmentsInSelectionTable)
	
	QueryText =
		"SELECT ALLOWED
		|	Transfers.Products AS Products,
		|	Transfers.Characteristic AS Characteristic,
		|	Transfers.Warehouse AS Warehouse,
		|	Transfers.Purpose AS Purpose,
		|	Transfers.OrderDocument AS OrderDocument,
		|	Transfers.OrderedBalance AS Ordered,
		|	Transfers.Received_1Balance AS Received_1,
		|	Transfers.ReserveAtWarehouseBalance AS ReserveAtWarehouse,
		|	Transfers.ReserveAsReceivedBalance AS ReserveAsReceived,
		|	Transfers.SnoozeReservationBalance AS SnoozeReservation,
		|	Transfers.ToSupplyBalance AS ToSupply,
		|	Transfers.NotProvideBalance AS NotProvide,
		|	Transfers.LockedReceiptBalance AS LockedReceipt,
		|	Transfers.ToUnlockBalance AS ToUnlock,
		|	Transfers.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLocked,
		|	Transfers.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLocked
		|INTO AllMovements
		|FROM
		|	AccumulationRegister.InventoryAndDemands.Balance(,
		|			VALUETYPE(OrderDocument) IN(
		|				TYPE(Catalog.ControlledLots),
		|				TYPE(Document.OrderOfMaterialsForProduction),
		|				TYPE(Document.TransferOrder))
		|			AND (Products, Characteristic, Warehouse, Purpose) IN(
		|				SELECT
		|					FilterTable.Products AS Products,
		|					FilterTable.Characteristic AS Characteristic,
		|					FilterTable.Warehouse AS Warehouse,
		|					&ConditionsForSelectionOfAppointments AS Purpose
		|				FROM
		|					NameOfFilterTableOverridable AS FilterTable)) AS Transfers
		|INDEX BY
		|	OrderDocument
		|;
		|
		|/////////////////////////////////////////////////////////////
		|SELECT
		|	Orders.Products AS Products,
		|	Orders.Characteristic AS Characteristic,
		|	Orders.Purpose AS Purpose,
		|	Orders.Center AS Warehouse,
		|	CASE
		|		WHEN VALUETYPE(Orders.OrderDocument) = TYPE(Catalog.ControlledLots)
		|			THEN Orders.OrderDocument
		|		ELSE UNDEFINED
		|	END AS OrderDocument,
		|	
		|	0 AS InStock,
		|	0 AS LockedInStock,
		|	
		|	SUM(
		|		CASE
		|			WHEN 0 > Orders.Ordered
		|				THEN 0
		|			WHEN Orders.NotProvide > Orders.Ordered
		|				THEN Orders.Ordered
		|			ELSE Orders.NotProvide
		|		END) AS NotProvide,
		|	
		|	SUM(
		|		CASE
		|			WHEN 0 > Orders.Ordered - Orders.NotProvide
		|				THEN 0
		|			WHEN Orders.ToSupply > Orders.Ordered - Orders.NotProvide
		|				THEN Orders.Ordered - Orders.NotProvide
		|			ELSE Orders.ToSupply
		|		END) AS ToSupply,
		|	
		|	SUM(
		|		CASE
		|			WHEN 0 > Orders.Ordered - Orders.ToSupplyResult
		|				THEN 0
		|			WHEN Orders.SnoozeReservation > Orders.Ordered - Orders.ToSupplyResult
		|				THEN Orders.Ordered - Orders.ToSupplyResult
		|			ELSE Orders.SnoozeReservation
		|		END) AS SnoozeReservation,
		|	
		|	SUM(
		|		CASE
		|			WHEN 0 > Orders.Ordered - Orders.PostponeReservationTotal
		|				THEN 0
		|			WHEN Orders.ReserveAsReceived > Orders.Ordered - Orders.PostponeReservationTotal
		|				THEN Orders.Ordered - Orders.PostponeReservationTotal
		|			ELSE Orders.ReserveAsReceived
		|		END) AS ReserveAsReceived,
		|	
		|	SUM(
		|		CASE
		|			WHEN 0 > Orders.Ordered -Orders.ReserveAsTotalIsReceived
		|				THEN 0
		|			WHEN Orders.ReserveAtWarehouse > Orders.Ordered -Orders.ReserveAsTotalIsReceived
		|				THEN Orders.Ordered -Orders.ReserveAsTotalIsReceived
		|			ELSE Orders.ReserveAtWarehouse
		|		END) AS ReserveAtWarehouse,
		|	
		|	SUM(
		|		CASE
		|			WHEN
		|				0 > Orders.Ordered - Orders.ReserveInStockTotal
		|				THEN 0
		|			WHEN Orders.ReserveUponReceiptFromLocked > Orders.Ordered - Orders.ReserveInStockTotal
		|				THEN Orders.Ordered - Orders.ReserveInStockTotal
		|			ELSE Orders.ReserveUponReceiptFromLocked
		|		END) AS ReserveUponReceiptFromLocked,
		|	
		|	SUM(
		|		CASE
		|			WHEN 0 > Orders.Ordered - Orders.ReserveAsReceivedFromBlockedTotals
		|				THEN 0
		|			WHEN Orders.ReserveAtWarehouseFromLocked > Orders.Ordered - Orders.ReserveAsReceivedFromBlockedTotals
		|				THEN Orders.Ordered - Orders.ReserveAsReceivedFromBlockedTotals
		|			ELSE Orders.ReserveAtWarehouseFromLocked
		|		END) AS ReserveAtWarehouseFromLocked,
		|	
		|	SUM(
		|		CASE
		|			WHEN Orders.Ordered > Orders.ReserveInStockFromBlockedTotal
		|				THEN Orders.ReserveInStockFromBlockedTotal
		|			ELSE Orders.Ordered
		|		END) AS Ordered,
		|	
		|	SUM(
		|		CASE
		|			WHEN Orders.Received_1 > Orders.ReserveInStockFromBlockedTotal
		|				THEN Orders.ReserveInStockFromBlockedTotal
		|			ELSE Orders.Received_1
		|		END) AS Received_1,
		|	
		|	SUM(
		|		CASE
		|			WHEN Orders.LockedReceipt > Orders.ReserveInStockFromBlockedTotal
		|				THEN Orders.ReserveInStockFromBlockedTotal
		|			ELSE Orders.LockedReceipt
		|		END) AS LockedReceipt,
		|	
		|	SUM(
		|		CASE
		|			WHEN Orders.ToUnlock > Orders.ReserveInStockFromBlockedTotal
		|				THEN Orders.ReserveInStockFromBlockedTotal
		|			ELSE Orders.ToUnlock
		|		END) AS ToUnlock
		|INTO MovementsWithinNetwork
		|FROM(
		|	SELECT
		|		Transfers.Products AS Products,
		|		Transfers.Characteristic AS Characteristic,
		|		Transfers.Purpose AS Purpose,
		|		Transfers.OrderDocument AS OrderDocument,
		|		Topology.Center AS Center,
		|		SUM(Transfers.ReserveAtWarehouseFromLocked) AS ReserveAtWarehouseFromLocked,
		|		SUM(Transfers.ReserveUponReceiptFromLocked) AS ReserveUponReceiptFromLocked,
		|		SUM(Transfers.ReserveAtWarehouse) AS ReserveAtWarehouse,
		|		SUM(Transfers.ReserveAsReceived) AS ReserveAsReceived,
		|		SUM(Transfers.SnoozeReservation) AS SnoozeReservation,
		|		SUM(Transfers.ToSupply) AS ToSupply,
		|		SUM(Transfers.NotProvide) AS NotProvide,
		|		
		|		SUM(Transfers.Ordered) AS Ordered,
		|		SUM(Transfers.Received_1) AS Received_1,
		|		SUM(Transfers.LockedReceipt) AS LockedReceipt,
		|		SUM(Transfers.ToUnlock) AS ToUnlock,
		|		
		|		SUM(Transfers.ReserveAtWarehouseFromLocked
		|				+ Transfers.ReserveUponReceiptFromLocked
		|				+ Transfers.ReserveAtWarehouse
		|				+ Transfers.ReserveAsReceived
		|				+ Transfers.SnoozeReservation
		|				+ Transfers.ToSupply
		|				+ Transfers.NotProvide) AS ReserveInStockFromBlockedTotal,
		|		SUM(Transfers.ReserveUponReceiptFromLocked
		|				+ Transfers.ReserveAtWarehouse
		|				+ Transfers.ReserveAsReceived
		|				+ Transfers.SnoozeReservation
		|				+ Transfers.ToSupply
		|				+ Transfers.NotProvide) AS ReserveAsReceivedFromBlockedTotals,
		|		SUM(Transfers.ReserveAtWarehouse
		|				+ Transfers.ReserveAsReceived
		|				+ Transfers.SnoozeReservation
		|				+ Transfers.ToSupply
		|				+ Transfers.NotProvide) AS ReserveInStockTotal,
		|		SUM(Transfers.ReserveAsReceived
		|				+ Transfers.SnoozeReservation
		|				+ Transfers.ToSupply
		|				+ Transfers.NotProvide) AS ReserveAsTotalIsReceived,
		|		SUM(Transfers.SnoozeReservation
		|				+ Transfers.ToSupply
		|				+ Transfers.NotProvide) AS PostponeReservationTotal,
		|		SUM(Transfers.ToSupply + Transfers.NotProvide) AS ToSupplyResult
		|	FROM
		|		AllMovements AS Transfers
		|		
		|			INNER JOIN WarehouseTopology AS Topology
		|			ON Topology.Products   = Transfers.Products
		|			 AND Topology.Characteristic = Transfers.Characteristic
		|			 AND Topology.Warehouse          = Transfers.Warehouse
		|		
		|	GROUP BY
		|		Transfers.Products,
		|		Transfers.Characteristic,
		|		Transfers.Purpose,
		|		Transfers.OrderDocument,
		|		Topology.Center) AS Orders
		|GROUP BY
		|	Orders.Products,
		|	Orders.Characteristic,
		|	Orders.Purpose,
		|	Orders.Center,
		|	CASE
		|		WHEN VALUETYPE(Orders.OrderDocument) = TYPE(Catalog.ControlledLots)
		|			THEN Orders.OrderDocument
		|		ELSE UNDEFINED
		|	END
		|INDEX BY
		|	Products,Characteristic,Warehouse,Purpose
		|;
		|
		|/////////////////////////////////////////////
		|DROP AllMovements";
		
	Substitution = "VALUE(Catalog.Assignments.EmptyRef)";
	SubstitutionAssignment = "FilterTable.Purpose";
	TotalSubstitution = ?(ThereAreAssignmentsInSelectionTable, SubstitutionAssignment, Substitution);
	QueryText = StrReplace(QueryText, "&ConditionsForSelectionOfAppointments", TotalSubstitution);
	
	QueryText = StrReplace(QueryText, "NameOfFilterTableOverridable", NameOfFilterTable);
	Return QueryText;
	
EndFunction

Function TemporaryTableFreeBalances(ThereAreAssignmentsInSelectionTable)
	
	QueryText =
		"SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Inventories.Warehouse AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	Inventories.InStockBalance AS InStockBalance,
		|	Inventories.LockedInStockBalance AS LockedInStockBalance,
		|	Inventories.OrderedBalance AS OrderedBalance,
		|	Inventories.Received_1Balance AS Received_1Balance,
		|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
		|	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
		|	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
		|	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
		|	Inventories.ToSupplyBalance AS ToSupplyBalance,
		|	Inventories.NotProvideBalance AS NotProvideBalance
		|INTO InventoryAndDemandsBalance
		|FROM
		|	AccumulationRegister.InventoryAndDemands.Balance(,
		|		(Products, Characteristic, Warehouse, Purpose) IN(
		|			SELECT
		|				FilterTable.Products AS Products,
		|				FilterTable.Characteristic AS Characteristic,
		|				FilterTable.Warehouse AS Warehouse,
		|				&ConditionsForSelectionOfAppointments AS Purpose
		|			FROM
		|				VariousGoodsAndWarehouses AS FilterTable)) AS Inventories
		|INDEX BY
		|	Products, Characteristic, Warehouse, Purpose
		|;
		|
		|//////////////////////////////////////////////////////
		|SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Inventories.Warehouse AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	Inventories.OrderDocument AS OrderDocument,
		|	Inventories.LockedInStockBalance AS LockedInStockBalance,
		|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
		|	Inventories.ToUnlockBalance AS ToUnlockBalance,
		|	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
		|	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
		|	
		|INTO InventoryAndNeedsBalanceOfControlledLotsReference
		|FROM
		|	AccumulationRegister.InventoryAndDemands.Balance(,
		|		(Products, Characteristic, Warehouse, Purpose) IN(
		|			SELECT
		|				FilterTable.Products AS Products,
		|				FilterTable.Characteristic AS Characteristic,
		|				FilterTable.Warehouse AS Warehouse,
		|				&ConditionsForSelectionOfAppointments AS Purpose
		|			FROM
		|				VariousGoodsAndWarehouses AS FilterTable)) AS Inventories
		|INDEX BY
		|	Products, Characteristic, Warehouse, Purpose
		|
		|;
		|
		|///////////////////////////////////////////////////////////
		|SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Inventories.Warehouse AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	Inventories.InStockBalance AS InStockBalance,
		|	Inventories.LockedInStockBalance AS LockedInStockBalance,
		|	Inventories.OrderedBalance AS OrderedBalance,
		|	Inventories.Received_1Balance AS Received_1Balance,
		|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
		|	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
		|	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
		|	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
		|	Inventories.ToSupplyBalance AS ToSupplyBalance,
		|	Inventories.NotProvideBalance AS NotProvideBalance
		|INTO InventoryAndNeedsBalancesTakingIntoAccountTopology
		|FROM
		|	InventoryAndDemandsBalance AS Inventories
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Inventories.Products = Topology.Products
		|		 AND Inventories.Characteristic = Topology.Characteristic
		|		 AND Inventories.Warehouse = Topology.Warehouse
		|		 AND Inventories.Warehouse = Topology.Center
		|WHERE
		|	Topology.Products IS NULL
		|
		|UNION ALL
		|
		|SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Topology.Center AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	SUM(Inventories.InStockBalance) AS InStockBalance,
		|	SUM(Inventories.LockedInStockBalance) AS LockedInStockBalance,
		|	SUM(Inventories.OrderedBalance) AS OrderedBalance,
		|	SUM(Inventories.Received_1Balance) AS Received_1Balance,
		|	SUM(Inventories.LockedReceiptBalance) AS LockedReceiptBalance,
		|	SUM(Inventories.ReserveAtWarehouseBalance) AS ReserveAtWarehouseBalance,
		|	SUM(Inventories.ReserveAsReceivedBalance) AS ReserveAsReceivedBalance,
		|	SUM(Inventories.SnoozeReservationBalance) AS SnoozeReservationBalance,
		|	SUM(Inventories.ToSupplyBalance) AS ToSupplyBalance,
		|	SUM(Inventories.NotProvideBalance) AS NotProvideBalance
		|FROM
		|	InventoryAndDemandsBalance AS Inventories
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Inventories.Products = Topology.Products
		|		 AND Inventories.Characteristic = Topology.Characteristic
		|		 AND Inventories.Warehouse = Topology.Warehouse
		|WHERE
		|	NOT Topology.Products IS NULL
		|GROUP BY
		|	Inventories.Products,
		|	Inventories.Characteristic,
		|	Topology.Center,
		|	Inventories.Purpose
		|INDEX BY
		|	Products, Characteristic, Warehouse, Purpose
		|
		|;
		|/////////////////////////////////////////////////////
		|DROP InventoryAndDemandsBalance
		|
		|;
		|/////////////////////////////////////////////////////
		|SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Inventories.Warehouse AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	Inventories.OrderDocument AS OrderDocument,
		|	Inventories.LockedInStockBalance AS LockedInStockBalance,
		|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
		|	Inventories.ToUnlockBalance AS ToUnlockBalance,
		|	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
		|	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
		|INTO InventoryAndNeedsBalanceOfControlledLotsReferencesTakingIntoAccountTopology
		|FROM
		|	InventoryAndNeedsBalanceOfControlledLotsReference AS Inventories
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Inventories.Products = Topology.Products
		|		 AND Inventories.Characteristic = Topology.Characteristic
		|		 AND Inventories.Warehouse = Topology.Warehouse
		|		 AND Inventories.Warehouse = Topology.Center
		|WHERE
		|	Topology.Products IS NULL
		|
		|UNION ALL
		|
		|SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Topology.Center AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	Inventories.OrderDocument AS OrderDocument,
		|	SUM(Inventories.LockedInStockBalance) AS LockedInStockBalance,
		|	SUM(Inventories.LockedReceiptBalance) AS LockedReceiptBalance,
		|	SUM(Inventories.ToUnlockBalance) AS ToUnlockBalance,
		|	SUM(Inventories.ReserveAtWarehouseFromLockedBalance) AS ReserveAtWarehouseFromLockedBalance,
		|	SUM(Inventories.ReserveUponReceiptFromLockedBalance) AS ReserveUponReceiptFromLockedBalance
		|FROM
		|	InventoryAndNeedsBalanceOfControlledLotsReference AS Inventories
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Inventories.Products = Topology.Products
		|		 AND Inventories.Characteristic = Topology.Characteristic
		|		 AND Inventories.Warehouse = Topology.Warehouse
		|WHERE
		|	NOT Topology.Products IS NULL
		|GROUP BY
		|	Inventories.Products,
		|	Inventories.Characteristic,
		|	Topology.Center,
		|	Inventories.Purpose,
		|	Inventories.OrderDocument
		|INDEX BY
		|	Products, Characteristic, Warehouse, Purpose
		|;
		|
		|/////////////////////////////////////////////////////
		|DROP InventoryAndNeedsBalanceOfControlledLotsReference
		|;
		|
		|/////////////////////////////////////////////////////
		|SELECT
		|	Calculation.Products AS Products,
		|	Calculation.Characteristic AS Characteristic,
		|	Calculation.Warehouse AS Warehouse,
		|	Calculation.Purpose AS Purpose,
		|	
		|	Calculation.InStock AS InStock,
		|	Calculation.AvailableWithLock AS OnQualityControlInStock,
		|	
		|	Calculation.Expected_
		|		+ Calculation.ExpectedWithBlocking
		|		+ Calculation.AwaitingApproval AS Ordered,
		|	
		|	Calculation.Available_Surplus AS SurplusInStock,
		|	Calculation.AvailableWithLock_Surplus AS OnQualityControlSurplusInStock,
		|	
		|	Calculation.Expected_Surplus
		|			+ Calculation.ExpectedWithLock_Surplus
		|			+ Calculation.OnApproval_Surplus AS SurplusInOrders,
		|	
		|	Calculation.ToReserve_ AS ReserveAtWarehouse,
		|	
		|	Calculation.Available_Surplus
		|		+ Calculation.Available_ReserveAsNeeded
		|		+ Calculation.Available_Postpone
		|		+ Calculation.InStock_K
		|		+ Calculation.AvailableWithLock_Surplus
		|		+ Calculation.AvailableWithLock_ReserveAsNeeded
		|		+ Calculation.AvailableWithLock_Postpone
		|		+ Calculation.AvailableWithLock_CSupply
		|		+ Calculation.Expected_
		|		+ Calculation.ExpectedWithLock_Surplus
		|		+ Calculation.ExpectedWithLock_ReserveAsNeeded
		|		+ Calculation.PendingWithLock_Postpone
		|		+ Calculation.ExpectedWith_KLock
		|		+ Calculation.AwaitingApproval AS DistributeToOrders
		|INTO TTFreeBalances
		|FROM
		|	CalculationOfInventoryDistribution AS Calculation
		|
		|INDEX BY
		|	Warehouse, Products, Characteristic, Purpose
		|;
		|
		|/////////////////////////////////////////////////////
		|DROP InventoryAndNeedsBalancesTakingIntoAccountTopology
		|;
		|
		|/////////////////////////////////////////////////////
		|DROP InventoryAndNeedsBalanceOfControlledLotsReferencesTakingIntoAccountTopology";
		
	Substitution = "VALUE(Catalog.Assignments.EmptyRef)";
	SubstitutionAssignment = "FilterTable.Purpose";
	TotalSubstitution = ?(ThereAreAssignmentsInSelectionTable, SubstitutionAssignment, Substitution);
	QueryText = StrReplace(QueryText, "&ConditionsForSelectionOfAppointments", TotalSubstitution);
	
	TablesNames = ProvisionInDocumentsServer.NewTableNamesForInventoryAllocation();
	TablesNames.Balance = "InventoryAndNeedsBalancesTakingIntoAccountTopology"; // @query-part-1
	TablesNames.BalanceSheetsOfControlledLotREFERENCES = "InventoryAndNeedsBalanceOfControlledLotsReferencesTakingIntoAccountTopology"; // @query-part-1
	TablesNames.ReversingEntry = "MovementsWithinNetwork"; // @query-part-1
	TablesNames.Result = "CalculationOfInventoryDistribution"; // @query-part-1
	
	ProvisionInDocumentsServer.InventoryAllocation(QueryText, TablesNames);
	
	Return QueryText;
	
EndFunction

Function TemporaryTableBanningPurchasesByAssortment(UseProductRange, UseQualityControl)
	
	If Not UseProductRange Then
		
		Text =
			"SELECT TOP 0
			|	UNDEFINED AS Warehouse,
			|	UNDEFINED AS Products,
			|	UNDEFINED AS PossibleDeliveryDate
			|INTO ProhibitionOfPurchasingByAssortment";
			
	Else
		
		Text =
			"SELECT DISTINCT
			|	Goods.Warehouse AS Warehouse,
			|	Goods.Products AS Products,
			|	CASE
			|		WHEN TableOfSecurityMethods.DeliveryDateExcludingQualityControl <> DATETIME(1, 1, 1)
			|			THEN TableOfSecurityMethods.DeliveryDateExcludingQualityControl
			|		ELSE &CurrentDayStart
			|	END AS PossibleDeliveryDate
			|INTO WarehousesAndDeliveryDates
			|FROM
			|	TTProducts_1 AS Goods
			|		LEFT JOIN NextCycleBySupplyMethods AS TableOfSecurityMethods
			|		ON Goods.SupplyMethod = TableOfSecurityMethods.Ref
			|		AND &GoodsConnectionQualityControl
			|WHERE
			|	CAST(Goods.Warehouse AS Catalog.Warehouses).WarehouseStore = VALUE(Enum.TypesOfWarehouses.RetailStore)
			|INDEX BY
			|	Warehouse, PossibleDeliveryDate
			|;
			|
			|///////////////////////////////////////////////////////////////////
			|SELECT
			|	Table.Warehouse AS Warehouse,
			|	Table.Products AS Products,
			|	Table.PossibleDeliveryDate AS PossibleDeliveryDate
			|INTO ProhibitionOfPurchasingByAssortment
			|FROM
			|	WarehousesAndDeliveryDates AS Table
			|		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange AS SettingsHistory
			|		ON Table.Warehouse = SettingsHistory.Warehouse
			|			AND SettingsHistory.Period IN(
			|				SELECT
			|					MAX (History.Period) AS Period
			|				FROM
			|					InformationRegister.HistoryOfStoreFormatChange AS History
			|				WHERE
			|					History.Warehouse = SettingsHistory.Warehouse
			|					AND History.Period < Table.PossibleDeliveryDate)
			|		
			|		LEFT JOIN Constant.UseStoreFormats AS UseStoreFormats
			|		ON TRUE
			|		
			|		LEFT JOIN InformationRegister.ProductRange AS ProductRange
			|		ON ISNULL(SettingsHistory.ControlProductRange, FALSE)
			|		 AND ProductRange.Products = Table.Products
			|		 AND ProductRange.PlanningObject
			|			= CASE WHEN UseStoreFormats.Value THEN
			|						ISNULL(SettingsHistory.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef))
			|					ELSE
			|						Table.Warehouse
			|				END
			|		 AND ProductRange.PurchasesAreAllowed
			|		 AND ProductRange.Period IN(
			|			SELECT
			|					MAX (Assorted.Period) AS Period
			|				FROM
			|					InformationRegister.ProductRange AS Assorted
			|				WHERE
			|					Assorted.Products = ProductRange.Products
			|					AND Assorted.PlanningObject = ProductRange.PlanningObject
			|					AND Assorted.Period <= Table.PossibleDeliveryDate)
			|WHERE
			|		SettingsHistory.ControlProductRange
			|			AND ProductRange.Products IS NULL
			|INDEX BY
			|	Warehouse, Products, PossibleDeliveryDate";
		
		GoodsConnectionQualityControl = "TRUE";
		If UseQualityControl Then
			
			GoodsConnectionQualityControl =
			"(Goods.Products = TableOfSecurityMethods.Products
			|AND Goods.Warehouse = TableOfSecurityMethods.Warehouse)";
			Text = StrReplace(Text, "NextCycleBySupplyMethods", "NextCycleOnSupplyMethodsTakingIntoAccountQualityControl");
			
		Else
			
			Text = StrReplace(Text, "DeliveryDateExcludingQualityControl", "ShipmentDate");
			
		EndIf;
		Text = StrReplace(Text, "&GoodsConnectionQualityControl", GoodsConnectionQualityControl);
		
	EndIf;
	
	Return Text;
	
EndFunction

Procedure WriteDocument(DocumentObject, ErrorsMessages)

	ErrorsNotDetected = DocumentObject.CheckFilling();

	If Not ErrorsNotDetected Then

		DocumentObject.Write(DocumentWriteMode.Write);

	Else //there are no errors, we are conducting the document

		Try

			DocumentObject.Write(DocumentWriteMode.Posting);

		Except

			DocumentObject.Write(DocumentWriteMode.Write);
			EventGroupName = NStr("vi = 'đảm bảo nhu cầu';
									|ru = 'Обеспечение потребностей';
									|en = 'Demand fulfillment'; fa = 'تأمین تقاضا';
									|it = 'Approvvigionamento dei fabbisogni';
									|pl = 'Zaspokojenie zapotrzebowania';
									|tr = 'Talep karşılama'", Common.DefaultLanguageCode());
			If IsARequest(DocumentObject.Ref) Then
				NameOfEventInGroup = NStr("vi = 'Lập giấy đề nghị';
											|ru = 'Создание заявок';
											|en = 'Create requests'; fa = 'ایجاد درخواست‌ها';
											|it = 'Create requests';
											|pl = 'Create requests';
											|tr = 'Taleplerin oluşturulması'", Common.DefaultLanguageCode());
			Else
				NameOfEventInGroup = NStr("vi = 'Tạo đơn hàng';
											|ru = 'Создание заказов';
											|en = 'Create orders'; fa = 'ایجاد سفارش‌ها';
											|it = 'Creazione degli ordini';
											|pl = 'Tworzenie zamówień';
											|tr = 'Siparişlerin oluşturulması'", Common.DefaultLanguageCode());
			EndIf;
			LogEventName = EventGroupName + "." + NameOfEventInGroup;
