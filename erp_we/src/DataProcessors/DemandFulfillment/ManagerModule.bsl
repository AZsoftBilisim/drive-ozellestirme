// Fills in and conducts the document created by processing.
//
// Parameters:
//  ManagerOfDocuments - DocumentManager - a software object, the document Manager,
//  FillingData - Structure - Structure containing the values of the details and table parts for filling in the document,
//  Status - EnumRef.InternalOrderStatuses, EnumRef.PurchaseOrderStatuses - the status
//           to hold the document in.
//  ErrorsMessages - Structure - contains the resulting message "document recording error".
//
// Returns:
//   DocumentObject.PurchaseOrder     - Completed order created by processing.
//   Document object.OrderAsSembly - A completed order created by processing.
//   Document object.Orderposting - A completed order created by processing.
//   Document object.Custom Production - A completed order created by processing.
//   Document object.Purchase Order - Completed order created by processing.
//
Function FillInAndHoldDocument(ManagerOfDocuments, FillingData, Status, ErrorsMessages) Export

	DocumentObject = ManagerOfDocuments.CreateDocument();
	
	FillingData.Insert("Date", CurrentSessionDate());
	FillingData.Insert("Status", Status);

	DocumentObject.Fill(FillingData);

	WriteDocument(DocumentObject, ErrorsMessages);

	Return DocumentObject;

EndFunction

