// Extends the method "System setups.Synchronize the values of subordinate constants."
// Updates the values of the constants "Use Extended support" and "Use the formation of needs"
// if the constant that affects their value has been changed.
//
// Parameters:
//   ConstantName - String - The name of the constant that was changed.
//   ConstantValue - Arbitrary - The value of the changed constant.
//   Cancel - Boolean - Indicates that the constant entry failed.
Procedure SynchronizeValuesOfSubordinateConstants(ConstantName, ConstantValue, Cancel) Export
	
	If Not ConstantAffectsAvailabilityOfProcessing(ConstantName) Then
		Return;
	EndIf; 
	
	UpdateValuesOfSubordinateConstants();

EndProcedure

// According to the functional options, at least 1 document generated by processing is included.
// 
// Returns:
//  Boolean - The Formation Of Supporting Documents Is Used
Function FormationOfSupportingDocumentsIsUsed() Export

	ReturnValue = False;
	For Each KeyAndValue In AvailabilityOfUseDestinationKeys(True) Do
		
		If KeyAndValue.Value Then
			ReturnValue = True;
			Break;
		EndIf;
		
	EndDo;
	
	Return ReturnValue;

EndFunction

