// Calculates the minimum and maximum inventory for an item.
//
// Parameters:
//  OwnGoods - FormDataCollection - Contains parameters for calculating the need for goods while maintaining stock:
//   * StrategyOfProcurement - EnumRef.InventoryReplenishmentMethods -
//   * DeliveryPeriodDays - Number -
//   * AverageDailyConsumption - Number -
//   * SafetyStock - Number -
//   * CoveredPeriod - Number -
//   * MinimumInventory - Number - minimum margin assigned by the user (for the min-max method)
//   * MaximumInventory - Number - minimum margin assigned by the user (for the min-max method)
//
// Returns:
//  Structure - structure with fields:
//   * MinimumInventory - Number - Calculated minimum stock,
//   * MaximumInventory - Number - Calculated maximum margin.
//
Function MinimumAndMaximumStocks(OwnGoods) Export
	
	StatisticsMethod = PredefinedValue("Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics");
	MethodAccordingToNorm      = PredefinedValue("Enum.InventoryReplenishmentMethods.StockReplenishmentByStandard");
	
	If OwnGoods.StrategyOfProcurement = StatisticsMethod Or OwnGoods.StrategyOfProcurement = MethodAccordingToNorm Then
		
		DeliveryPeriodDays = OwnGoods.DeliveryPeriodDays;
		CoveredPeriod = OwnGoods.CoveredPeriod;
		
		MinimumInventory  = OwnGoods.AverageDailyConsumption * DeliveryPeriodDays;
		MaximumInventory = OwnGoods.AverageDailyConsumption * CoveredPeriod;
		
		If OwnGoods.UnitOfMeasureType = Enums.TypesOfMeasuredValues.NumberOfPieces Then
			
			If Int(MinimumInventory) <> MinimumInventory Then
				MinimumInventory = 1 + Int(MinimumInventory);
			EndIf;
			
			If Int(MaximumInventory) <> MaximumInventory Then
				MaximumInventory = 1 + Int(MaximumInventory);
			EndIf;
		
		EndIf;
		
		MinimumInventory  = MinimumInventory  + OwnGoods.SafetyStock;
		MaximumInventory = MaximumInventory + OwnGoods.SafetyStock;
		
	Else
		MinimumInventory  = OwnGoods.MinimumInventory;
		MaximumInventory = OwnGoods.MaximumInventory;
	EndIf;
	
	Return New Structure("MinimumInventory,MaximumInventory", MinimumInventory, MaximumInventory);
	
EndFunction

// Calculates the inventory level based on current inventory and inventory maintenance parameters set for the product.
//
// Parameters:
//  OwnGoods - FormDataCollection - Contains parameters for calculating the need for goods while maintaining stock:
//   * StrategyOfProcurement - EnumRef.InventoryReplenishmentMethods,
//   * MinimumInventory - Number,
//   * MaximumInventory - Number,
//   * OrdersPendingGoodsReceipt - Number,
//   * OnQualityControl - Number,
//   * Balance - Number,
//   * ConsumptionIsStable - Boolean
//
// Returns:
//  Structure - structure with fields:
//   * InventoryLevel - Number,
//   * MaximumInventoryLevel - Number,
//   * PictureChangeMethod - Number,
//   * OrderPointPicture - Boolean,
//   * ForOrderCancellationImage - Boolean
Function StockLevelAndPictureChangeMethod(OwnGoods) Export

	StatisticsMethod =
		OwnGoods.StrategyOfProcurement = PredefinedValue("Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics");

	InventoryLevel =
		?(OwnGoods.Balance - OwnGoods.MinimumInventory < 0,     1,      // critical
		?(OwnGoods.Balance - 2 * OwnGoods.MinimumInventory < 0, 2,      // close to critical
		?(OwnGoods.Balance < OwnGoods.MaximumInventory / 2,    4,      // less than half
		                                                  7)));

	MaximumInventoryLevel =
		?(OwnGoods.Balance > OwnGoods.MaximumInventory,      6,      // Surplus
		?(OwnGoods.Balance >= OwnGoods.MaximumInventory / 2, 5,      // more than half
		                                                7));

	OrderPointPicture   = OwnGoods.Balance - OwnGoods.MinimumInventory < 0;
	ForOrderCancellationImage =
		OwnGoods.OnQualityControl
			+ OwnGoods.OrdersPendingGoodsReceipt
			+ OwnGoods.Balance
			- OwnGoods.MinimumInventory > OwnGoods.MaximumInventory
		And OwnGoods.OrdersPendingGoodsReceipt > 0;

	PictureChangeMethod =
		?(OwnGoods.ConsumptionIsStable And Not StatisticsMethod,     0, // it is recommended to use statistics
		?(Not OwnGoods.ConsumptionIsStable And StatisticsMethod,     1, // it is recommended to use min-max
		?(OwnGoods.ConsumptionIsStable And StatisticsMethod,       -1, // the method corresponds to the recommendation
		?(Not OwnGoods.ConsumptionIsStable And Not StatisticsMethod, -1, // the method corresponds to the recommendation
		                                                                                         -2)))); // no recommendation

	Result = New Structure();
	Result.Insert("InventoryLevel", InventoryLevel);
	Result.Insert("MaximumInventoryLevel", MaximumInventoryLevel);
	Result.Insert("PictureChangeMethod", PictureChangeMethod);
	Result.Insert("OrderPointPicture", OrderPointPicture);
	Result.Insert("ForOrderCancellationImage", ForOrderCancellationImage);
	Return Result;

EndFunction

// Calculates the quantity to order to maintain inventory.
//
// Parameters:
//  OwnGoods - FormDataCollection - Contains parameters for calculating the need for goods while maintaining stock:
//   * Balance - Number -
//   * ReservesInStock - Number -
//   * OrdersPendingGoodsReceipt - Number -
//   * OnQualityControl - Number -
//   * MinimumInventory - Number -
//   * SafetyStock - Number -
//   * MaximumInventory - Number -
//
// Returns:
//  Structure - structure with fields:
//   * Mark - Boolean -
//   * ToOrder - Number -
//   * OrderDateHasArrived - Boolean -
//   * OrderPointHasArrived - Boolean -
//   * BeforeTheOrderPoint - Number -
//
Function QuantityToOrderToMaintainStock(OwnGoods) Export

	BeforeTheOrderPoint = OwnGoods.Balance - OwnGoods.MinimumInventory;
	
	ReplenishmentOfInsuranceStock = Min(OwnGoods.SafetyStock, Max(0, -BeforeTheOrderPoint));
	ToOrder =
		Max(0,
			OwnGoods.MaximumInventory
				- OwnGoods.SafetyStock
				- OwnGoods.OrdersPendingGoodsReceipt
				- OwnGoods.OnQualityControl
				- Max(0, BeforeTheOrderPoint)
				+ ReplenishmentOfInsuranceStock)
		+ Max(0,
			Min(OwnGoods.ReservesInStock, -OwnGoods.Balance));
	
	OrderDateHasArrived = OwnGoods.DemandConversionOption = 1;
	OrderPointHasArrived = BeforeTheOrderPoint <= 0;
	Mark = OwnGoods.DemandConversionOption <> 2 And (OrderDateHasArrived Or OrderPointHasArrived) And ToOrder > 0;
	
	Result = New Structure();
	Result.Insert("ToOrder",              ToOrder);
	Result.Insert("Mark",              Mark);
	Result.Insert("OrderDateHasArrived",  OrderDateHasArrived);
	Result.Insert("OrderPointHasArrived", OrderPointHasArrived);
	Result.Insert("BeforeTheOrderPoint",        BeforeTheOrderPoint);

	Return Result;

EndFunction

// Calculates the quantity to order to secure orders.
//
// Parameters:
//  OwnGoods - FormDataCollection - Contains parameters for calculating the need for a item/job to secure orders:
//   * Required2 - Number -
//   * ToReserve - Number -
//   * EstimatedDeliveryDate - Date -
//   * DeliveryDateByProcurementStrategy - Date -
//
// Returns:
//  Structure - structure with fields:
//   * Mark - Boolean -
//   * ToOrder - Number
//
Function QuantityToOrderToEnsureOrders(OwnGoods) Export
	
	ToOrder = OwnGoods.Required2 - OwnGoods.ToReserve;
	// The "Do not order today" option is not selected for the security method.
	Mark = OwnGoods.DemandConversionOption <> 2
			// There is something to order.
			And ToOrder > 0 
			// The delivery date is the nearest delivery date for the collateral method.
			And (OwnGoods.EstimatedDeliveryDate = OwnGoods.DeliveryDateByProcurementStrategy
			// The scheduled delivery schedule is not filled in, or the scheduled delivery date is in the past.
				Or OwnGoods.EstimatedDeliveryDate = '00010101'
			// The delivery date in step 2 has been cleared or the enterprise schedule has not been filled in.
				Or OwnGoods.DeliveryDateByProcurementStrategy = '00010101');
	
	Result = New Structure();
	Result.Insert("ToOrder", ToOrder);
	Result.Insert("Mark", Mark);
	
	Return Result;
	
EndFunction

