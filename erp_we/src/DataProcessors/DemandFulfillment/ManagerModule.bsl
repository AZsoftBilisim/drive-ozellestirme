Function TemporaryTableOfNeedsOfAllWarehousesByOrders()
	
	QueryText =
		Catalogs.StoreFormats.QueryTextTTWarehouseFormats(False) +
		"SELECT ALLOWED
		|	Goods.Products                                    AS Products,
		|	Goods.Characteristic                                  AS Characteristic,
		|	
		|	CASE WHEN Goods.Warehouse REFS Catalog.Warehouses THEN
		|				Goods.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|		END AS Warehouse,
		|	
		|	CASE WHEN Goods.Warehouse REFS Catalog.BusinessStructure THEN
		|				Goods.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|		END AS ReceivingBusinessUnit,
		|	
		|	Goods.Purpose                                      AS Purpose,
		|	Goods.ShipmentOrder                                 AS OrderDocument,
		|	Goods.RequestShipmentOn                            AS DateOfShipment,
		|	
		|	CASE
		|		WHEN Goods.InventoryState = VALUE(Enum.InventoryStates.NotProvided)
		|			THEN Goods.Count
		|		ELSE 0
		|	END AS NotSupplied,
		|	
		|	CASE
		|		WHEN Goods.InventoryState IN(
		|				VALUE(Enum.InventoryStates.InStock),
		|				VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
		|				VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
		|				VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
		|				VALUE(Enum.InventoryStates.PendingSupplyApproval))
		|			THEN Goods.Count
		|		ELSE 0
		|	END AS Allocated,
		|	
		|	Goods.InventoryState AS InventoryState,
		|	UNDEFINED                                           AS KeyLot,
		|	CatMethod.Ref                                       AS SupplyMethod
		|INTO NeedsOfAllWarehousesOnOrders
		|FROM
		|	InformationRegister.InventoryAllocation AS Goods
		|
		|		LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|		ON &MainSupplyMethodSubstitution
		|
		|WHERE
		|	Goods.DemandCharacteristic IN(
		|		VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
		|		VALUE(Enum.DemandCharacteristics.SnoozeReservation),
		|		VALUE(Enum.DemandCharacteristics.ToSupply))
		|
		//linker selections
		|{WHERE
		|	Goods.Products.*                             AS Products,
		|	Goods.Characteristic.*                           AS Characteristic,
		|	Goods.Purpose.*                               AS Purpose,
		|	CAST(
		|		CASE
		|			WHEN Goods.Warehouse REFS Catalog.BusinessStructure
		|				THEN Goods.Warehouse
		|			ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|		END AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit}
		|
		|{WHERE Goods.ShipmentOrder IN(
		|	SELECT
		|		FilterTable.OrderDocument AS OrderDocument
		|	FROM
		|		FilterByOrders AS FilterTable
		|	WHERE
		|		&FilterByOrdersIsUsed)}
		|
		|{WHERE (Goods.Products, Goods.Characteristic) IN(
		|	SELECT
		|		FilterTable.Products   AS Products,
		|		FilterTable.Characteristic AS Characteristic
		|	FROM
		|		SegmentSelection AS FilterTable
		|	WHERE
		|		&FilterByProductSegmentIsUsed)}
		// Production order requirements
		|
		|UNION ALL
		|
		|SELECT
		|	Goods.Products                                           AS Products,
		|	Goods.Characteristic                                         AS Characteristic,
		|	
		|	CASE WHEN Goods.Warehouse REFS Catalog.Warehouses THEN
		|				Goods.Warehouse
		|			ELSE
		|				VALUE(Catalog.Warehouses.EmptyRef)
		|		END AS Warehouse,
		|	
		|	CASE WHEN Goods.Warehouse REFS Catalog.BusinessStructure THEN
		|				Goods.Warehouse
		|			ELSE
		|				VALUE(Catalog.BusinessStructure.EmptyRef)
		|		END AS ReceivingBusinessUnit,
		|	
		|	Goods.Purpose                                               AS Purpose,
		|	Goods.ProductionOrder                                      AS OrderDocument,
		|	Goods.RequestShipmentOn                                     AS DateOfShipment,
		|	Goods.Count                                               AS NotSupplied,
		|	0                                                               AS Allocated,
		|	VALUE(Enum.InventoryStates.NotProvided)              AS InventoryState,
		|	Goods.KeyLot                                               AS KeyLot,
		|	Goods.SupplyMethod                                        AS SupplyMethod
		|FROM
		|	(SELECT
		|
		|		Goods.Products        AS Products,
		|		Goods.Characteristic      AS Characteristic,
		|		Goods.Warehouse               AS Warehouse,
		|		Goods.Purpose          AS Purpose,
		|		Goods.ProductionOrder AS ProductionOrder,
		|		Goods.KeyProducts    AS KeyProducts,
		|
		|		CatMethod.Ref AS SupplyMethod,
		|
		|		MIN(CASE
		|				WHEN Goods.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
		|					THEN Goods.KeyLot
		|			END) AS KeyLot,
		|		MIN(ISNULL(ScheduleDates.Begin, Goods.ProductionOrder.EarliestStartDate)) AS RequestShipmentOn,
		|
		|		SUM(Goods.ToSupply - Goods.Replaced - Goods.AllocatedFromAvailableInventoryWithAssignment - Goods.AllocatedInAssignedProductionLots) AS Count
		|
		|	FROM
		|		InformationRegister.OrderStructure AS Goods
		|
		|			LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|			ON &MainSupplyMethodSubstitution
		|
		|			LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
		|			ON Goods.ProductionOrder = ScheduleDates.ProductionOrder
		|			 AND ScheduleDates.ScheduleStatus = 0
		|			 AND Goods.Stage = ScheduleDates.Stage
		|			 AND Goods.KeyLot = ScheduleDates.KeyLot
		|
		|	WHERE
		|		Goods.LineKind NOT IN (
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))
		|
		|	{WHERE
		|		Goods.Products.*   AS Products,
		|		Goods.Characteristic.* AS Characteristic,
		|		Goods.Purpose.*     AS Purpose,
		|		CAST(
		|			CASE
		|				WHEN Goods.Warehouse REFS Catalog.BusinessStructure
		|					THEN Goods.Warehouse
		|				ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit}
		|
		|	{WHERE Goods.ProductionOrder IN (
		|		SELECT
		|			FilterTable.OrderDocument AS OrderDocument
		|		FROM
		|			FilterByOrders AS FilterTable
		|		WHERE
		|			&FilterByOrdersIsUsed)}
		|
		|	{WHERE (Goods.Products, Goods.Characteristic) IN(
		|		SELECT
		|			FilterTable.Products   AS Products,
		|			FilterTable.Characteristic AS Characteristic
		|		FROM
		|			SegmentSelection AS FilterTable
		|		WHERE
		|			&FilterByProductSegmentIsUsed)}
		|
		|	GROUP BY
		|		Goods.Products,
		|		Goods.Characteristic,
		|		Goods.Warehouse,
		|		Goods.Purpose,
		|		Goods.ProductionOrder,
		|		Goods.KeyProducts,
		|		CatMethod.Ref
		|
		|	HAVING
		|		SUM(Goods.ToSupply - Goods.Replaced - Goods.AllocatedFromAvailableInventoryWithAssignment - Goods.AllocatedInAssignedProductionLots) > 0
		|
		|	UNION ALL
		|
		|	SELECT
		|
		|		Goods.Products                          AS Products,
		|		Goods.Characteristic                        AS Characteristic,
		|		Goods.Warehouse                                 AS Warehouse,
		|		Goods.StructureAssignment                   AS Purpose,
		|		Goods.ProductionOrder                   AS ProductionOrder,
		|		Goods.KeyProducts                      AS KeyProducts,
		|
		|		CatMethod.Ref AS SupplyMethod,
		|
		|		MIN(CASE
		|				WHEN Goods.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
		|					THEN Goods.KeyLot
		|			END) AS KeyLot,
		|		MIN(ISNULL(ScheduleDates.Begin, Goods.ProductionOrder.EarliestStartDate)) AS RequestShipmentOn,
		|
		|		SUM(Goods.AllocatedFromAvailableInventoryWithAssignment + Goods.AllocatedInAssignedProductionLots) AS Count
		|
		|	FROM
		|		InformationRegister.OrderStructure AS Goods
		|
		|			LEFT JOIN Catalog.ProcurementStrategies AS CatMethod
		|			ON &MainSupplyMethodSubstitution
		|
		|			LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
		|			ON Goods.ProductionOrder = ScheduleDates.ProductionOrder
		|			 AND ScheduleDates.ScheduleStatus = 0
		|			 AND Goods.Stage = ScheduleDates.Stage
		|			 AND Goods.KeyLot = ScheduleDates.KeyLot
		|
		|	WHERE
		|		Goods.LineKind NOT IN (
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
		|			VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))
		|
		|	{WHERE
		|		Goods.Products.*                        AS Products,
		|		Goods.Characteristic.*                      AS Characteristic,
		|		Goods.StructureAssignment.*                 AS Purpose,
		|		CAST(
		|			CASE
		|				WHEN Goods.Warehouse REFS Catalog.BusinessStructure
		|					THEN Goods.Warehouse
		|				ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|			END AS Catalog.BusinessStructure).* AS ReceivingBusinessUnit}
		|
		|	{WHERE Goods.ProductionOrder IN (
		|		SELECT
		|			FilterTable.OrderDocument AS OrderDocument
		|		FROM
		|			FilterByOrders AS FilterTable
		|		WHERE
		|			&FilterByOrdersIsUsed)}
		|
		|	{WHERE (Goods.Products, Goods.Characteristic) IN(
		|		SELECT
		|			FilterTable.Products   AS Products,
		|			FilterTable.Characteristic AS Characteristic
		|		FROM
		|			SegmentSelection AS FilterTable
		|		WHERE
		|			&FilterByProductSegmentIsUsed)}
		|
		|	GROUP BY
		|		Goods.Products,
		|		Goods.Characteristic,
		|		Goods.Warehouse,
		|		Goods.StructureAssignment,
		|		Goods.ProductionOrder,
		|		Goods.KeyProducts,
		|		CatMethod.Ref
		|
		|	HAVING
		|		SUM(Goods.AllocatedFromAvailableInventoryWithAssignment + Goods.AllocatedInAssignedProductionLots) > 0
		|
		|) AS Goods
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		|DROP TTWarehouseFormats";
	
	QueryText = InformationRegisters.SupplySchemes.SubstituteConnectionToGetSecurityMethod(
		QueryText,
		"MainSupplyMethodSubstitution",
		"Goods.Products,Goods.Characteristic,CAST(Goods.Warehouse AS Catalog.Warehouses)");
	ProductionManagement.SubstitutionOfActualRegisterOfGraph(QueryText);
	Return QueryText;
	
EndFunction

Function TemporaryTableOfNeedsOfSelectedWarehouses()
	
	Text =
		// Regular warehouse
		"SELECT
		|	Goods.Products                       AS Products,
		|	Goods.Characteristic                     AS Characteristic,
		|	Goods.Warehouse                              AS Warehouse,
		|	Goods.Warehouse                              AS OrderShipmentWarehouse,
		|	Goods.ReceivingBusinessUnit            AS ReceivingBusinessUnit,
		|	Goods.Purpose                         AS Purpose,
		|	Goods.OrderDocument                              AS OrderDocument,
		|	Goods.DateOfShipment                       AS DateOfShipment,
		|	Goods.DateOfShipment                       AS OrderShipmentDate,
		|	Goods.NotSupplied                       AS NotSupplied,
		|	Goods.Allocated                       AS Allocated,
		|	Goods.InventoryState                    AS InventoryState,
		|	Goods.SupplyMethod                  AS SupplyMethod
		|FROM
		|	NeedsOfAllWarehousesOnOrders AS Goods
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Goods.Products   = Topology.Products
		|		 AND Goods.Characteristic = Topology.Characteristic
		|		 AND Goods.Warehouse          = Topology.Warehouse
		|		
		|		INNER JOIN SupplyMethodsForSelections AS TableOfWaysToProvideOverridden
		|		ON ISNULL(Goods.SupplyMethod, VALUE(Catalog.ProcurementStrategies.EmptyRef))
		|			= TableOfWaysToProvideOverridden.SupplyMethod
		|		 AND CASE WHEN Goods.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Move) THEN
		|					ISNULL(&FOMovementOrdersEnabled AND NOT Goods.Warehouse.ShopFloorStockroom
		|						OR &FOProduction2_2Enabled AND Goods.Warehouse.ShopFloorStockroom, FALSE)
		|				ELSE TRUE
		|			END
		|
		|WHERE
		|	Topology.Products IS NULL
		|
		|{WHERE
		|	Goods.Warehouse.*                                                                                    AS Warehouse,
		|	(ISNULL(Goods.SupplyMethod,
		|		VALUE(Catalog.ProcurementStrategies.EmptyRef))).*                          AS SupplyMethod,
		|	ISNULL(Goods.SupplyMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|	CAST(
		|		CASE
		|			WHEN Goods.SupplyMethod.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|				Goods.SupplyMethod.Department
		|			ELSE
		|				ISNULL(Goods.Warehouse.Department,
		|					VALUE(Catalog.BusinessStructure.EmptyRef))
		|		END AS Catalog.BusinessStructure).*                                                  AS Department,
		|	(ISNULL(Goods.SupplyMethod.SourceOfDemandSupply, UNDEFINED)).*              AS SupplySource,
		|	(ISNULL(Goods.SupplyMethod.EmployeeResponsible, UNDEFINED)).*                                AS Manager}
		|
		|UNION ALL
		|
		// Remote warehouse of the distribution network
		|SELECT
		|	AllGoods.Products                       AS Products,
		|	AllGoods.Characteristic                     AS Characteristic,
		|	AllGoods.Warehouse                              AS Warehouse,
		|	AllGoods.Warehouse                              AS OrderShipmentWarehouse,
		|	AllGoods.ReceivingBusinessUnit            AS ReceivingBusinessUnit,
		|	AllGoods.Purpose                         AS Purpose,
		|	AllGoods.OrderDocument                              AS OrderDocument,
		|	AllGoods.DateOfShipment                       AS DateOfShipment,
		|	AllGoods.DateOfShipment                       AS OrderShipmentDate,
		|	AllGoods.NotSupplied                       AS NotSupplied,
		|	AllGoods.Allocated                       AS Allocated,
		|	AllGoods.InventoryState                    AS InventoryState,
		|	AllGoods.SupplyMethod                  AS SupplyMethod
		|FROM
		|	NeedsOfAllWarehousesOnOrders AS AllGoods
		|		
		|		INNER JOIN SupplyMethodsForSelections AS TableOfWaysToProvideOverridden
		|		ON ISNULL(AllGoods.SupplyMethod, VALUE(Catalog.ProcurementStrategies.EmptyRef))
		|			= TableOfWaysToProvideOverridden.SupplyMethod
		|		 AND CASE WHEN AllGoods.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Move) THEN
		|					ISNULL(&FOMovementOrdersEnabled AND NOT AllGoods.Warehouse.ShopFloorStockroom
		|						OR &FOProduction2_2Enabled AND AllGoods.Warehouse.ShopFloorStockroom, FALSE)
		|				ELSE TRUE
		|			END
		|
		|WHERE
		|	TRUE IN(
		|		SELECT TOP 1
		|			TRUE AS ThereAreRecords
		|		FROM
		|			WarehouseTopology AS Topology
		|		WHERE
		|			Topology.Products = AllGoods.Products
		|			AND Topology.Characteristic = AllGoods.Characteristic
		|			AND Topology.Warehouse = AllGoods.Warehouse)
		// If the warehouse is a RC, then its needs as a remote warehouse of another network should not be taken into account.
		|	AND NOT TRUE IN(
		|		SELECT TOP 1
		|			TRUE AS ThereAreRecords
		|		FROM
		|			WarehouseTopology AS Topology
		|		WHERE
		|			Topology.Products = AllGoods.Products
		|			AND Topology.Characteristic = AllGoods.Characteristic
		|			AND Topology.Center = AllGoods.Warehouse)
		|
		|{WHERE
		|	AllGoods.Warehouse.*                                                                                 AS Warehouse,
		|	(ISNULL(AllGoods.SupplyMethod,
		|		VALUE(Catalog.ProcurementStrategies.EmptyRef))).*                          AS SupplyMethod,
		|	ISNULL(AllGoods.SupplyMethod.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|	CAST(
		|		CASE
		|			WHEN AllGoods.SupplyMethod.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|				AllGoods.SupplyMethod.Department
		|			ELSE
		|				ISNULL(AllGoods.Warehouse.Department,
		|					VALUE(Catalog.BusinessStructure.EmptyRef))
		|		END AS Catalog.BusinessStructure).*                                                  AS Department,
		|	(ISNULL(AllGoods.SupplyMethod.SourceOfDemandSupply, UNDEFINED)).*           AS SupplySource,
		|	(ISNULL(AllGoods.SupplyMethod.EmployeeResponsible, UNDEFINED)).*                             AS Manager}
		|
		|UNION ALL
		|
		// Distribution center of the distribution network
		|SELECT
		|	AllGoods.Products                                  AS Products,
		|	AllGoods.Characteristic                                AS Characteristic,
		|	Topology.Center                                         AS Warehouse,
		|	AllGoods.Warehouse                                         AS OrderShipmentWarehouse,
		|	AllGoods.ReceivingBusinessUnit                       AS ReceivingBusinessUnit,
		|	AllGoods.Purpose                                    AS Purpose,
		|	AllGoods.OrderDocument                                         AS OrderDocument,
		|	DATEADD(AllGoods.DateOfShipment, DAY,
		|		- ISNULL(CatWayToStoreNetwork.ProductionDurationDays, 0))AS DateOfShipment,
		|	AllGoods.DateOfShipment                                  AS OrderShipmentDate,
		|	AllGoods.NotSupplied                                  AS NotSupplied,
		|	AllGoods.Allocated                                  AS Allocated,
		|	AllGoods.InventoryState                               AS InventoryState,
		|	CatCenter.Ref                                   AS SupplyMethod
		|FROM
		|	NeedsOfAllWarehousesOnOrders AS AllGoods
		|
		|		LEFT JOIN Document.TransferOrder AS TransferOrders
		|		ON TransferOrders.Ref = AllGoods.OrderDocument
		|
		|		LEFT JOIN Document.OrderOfMaterialsForProduction AS OrdersForMaterials
		|		ON OrdersForMaterials.Ref = AllGoods.OrderDocument
		//
		|		LEFT JOIN InformationRegister.OrderStructure AS MovementSchedule
		|		ON AllGoods.KeyLot = MovementSchedule.KeyLot
		|		 AND MovementSchedule.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Move)
		|		 AND NOT MovementSchedule.AdditionalRecord
		|		
		|		LEFT JOIN WarehouseTopology AS Topology
		|		ON Topology.Products   =  AllGoods.Products
		|		 AND Topology.Characteristic =  AllGoods.Characteristic
		|		 AND Topology.Warehouse          =  AllGoods.Warehouse
		|		
		|		LEFT JOIN WarehouseTopology AS NetworkWarehouses
		|		ON NetworkWarehouses.Products   =  Topology.Products
		|		 AND NetworkWarehouses.Characteristic =  Topology.Characteristic
		|		 AND NetworkWarehouses.Center          =  Topology.Center
		|		 AND NetworkWarehouses.Warehouse = (
		|			CASE
		|				WHEN TransferOrders.DestinationWarehouse IS NOT NULL THEN TransferOrders.DestinationWarehouse
		|				WHEN OrdersForMaterials.ShopFloorStockroom IS NOT NULL THEN OrdersForMaterials.ShopFloorStockroom
		|				WHEN MovementSchedule.Warehouse IS NOT NULL THEN MovementSchedule.Warehouse
		|			END)
		|		
		|		LEFT JOIN Catalog.ProcurementStrategies AS CatWayToStoreNetwork
		|		ON &SubstitutionOfMainWayToEnsureSafetyOfNetwork
		|		
		|		LEFT JOIN Catalog.ProcurementStrategies AS CatCenter
		|		ON &SubstitutionOfMainWayToEnsureCenterOfNetwork
		|		
		|		INNER JOIN SupplyMethodsForSelections AS TableOfWaysToProvideOverridden
		|		ON ISNULL(CatCenter.Ref, VALUE(Catalog.ProcurementStrategies.EmptyRef))
		|			= TableOfWaysToProvideOverridden.SupplyMethod
		|		 AND CASE WHEN CatCenter.Ref.SupplyType = VALUE(Enum.SupplyTypes.Move) THEN
		|					ISNULL(&FOMovementOrdersEnabled AND NOT AllGoods.Warehouse.ShopFloorStockroom
		|						OR &FOProduction2_2Enabled AND AllGoods.Warehouse.ShopFloorStockroom, FALSE)
		|				ELSE TRUE
		|			END
		|WHERE
		|	NOT Topology.Products IS NULL
		|		AND NetworkWarehouses.Products IS NULL
		|
		|{WHERE
		|	Topology.Center.* AS Warehouse,
		|	(ISNULL(CatCenter.Ref,
		|		VALUE(Catalog.ProcurementStrategies.EmptyRef))).* AS SupplyMethod,
		|	ISNULL(CatCenter.SupplyType, VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|	CAST(
		|		CASE
		|			WHEN CatCenter.Department <> VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|				CatCenter.Department
		|			ELSE
		|				ISNULL(Topology.Center.Department,
		|					VALUE(Catalog.BusinessStructure.EmptyRef))
		|		END AS Catalog.BusinessStructure).* AS Department,
		|	(ISNULL(CatCenter.SourceOfDemandSupply, UNDEFINED)).* AS SupplySource,
		|	(ISNULL(CatCenter.EmployeeResponsible, UNDEFINED)).* AS Manager}";

	Substitution =
		"AllGoods.Products,
		|AllGoods.Characteristic,
		|AllGoods.Warehouse";
		
	Text = InformationRegisters.SupplySchemes.SubstituteConnectionToGetSecurityMethod(
		Text, "SubstitutionOfMainWayToEnsureSafetyOfNetwork", Substitution, "NetworkWarehouse");
	
	Substitution =
		"AllGoods.Products,
		|AllGoods.Characteristic,
		|Topology.Center";
		
	Text = InformationRegisters.SupplySchemes.SubstituteConnectionToGetSecurityMethod(
		Text, "SubstitutionOfMainWayToEnsureCenterOfNetwork", Substitution, "NetworkCenter");
	
	QueryText =
		"SELECT
		|	Goods.Products                       AS Products,
		|	Goods.Characteristic                     AS Characteristic,
		|	Goods.Warehouse                              AS Warehouse,
		|	Goods.OrderShipmentWarehouse                AS OrderShipmentWarehouse,
		|	Goods.ReceivingBusinessUnit            AS ReceivingBusinessUnit,
		|	Goods.Purpose                         AS Purpose,
		|	Goods.OrderDocument                              AS OrderDocument,
		|	Goods.DateOfShipment                       AS DateOfShipment,
		|	Goods.OrderShipmentDate                 AS OrderShipmentDate,
		|	SUM(Goods.NotSupplied)                AS NotSupplied,
		|	SUM(CASE
		|			WHEN Goods.InventoryState IN(
		|					VALUE(Enum.InventoryStates.InStock),
		|					VALUE(Enum.InventoryStates.AvailablePendingUnlocking))
		|				THEN Goods.Allocated
		|			ELSE 0
		|		END) AS DistributedInWarehouse,
		|	SUM(CASE
		|			WHEN Goods.InventoryState IN(
		|					VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
		|					VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
		|					VALUE(Enum.InventoryStates.PendingSupplyApproval))
		|				THEN Goods.Allocated
		|			ELSE 0
		|		END) AS DistributedFromOrders,
		|	ISNULL(Goods.SupplyMethod, VALUE(Catalog.ProcurementStrategies.EmptyRef)) AS SupplyMethod
		|INTO TTProducts_1
		|FROM
		|	TheTextOfASubqueryOverridable AS Goods
		|GROUP BY
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.Warehouse,
		|	Goods.OrderShipmentWarehouse,
		|	Goods.ReceivingBusinessUnit,
		|	Goods.Purpose,
		|	Goods.OrderDocument,
		|	Goods.DateOfShipment,
		|	Goods.OrderShipmentDate,
		|	Goods.SupplyMethod";
		
	Text = StrReplace(QueryText, "TheTextOfASubqueryOverridable", StrTemplate("(%1)", Text));
	Return Text;
	
EndFunction

Function FetchingFirstNeedsRecordByOrderForQueryLayout()
	
	Return
		"SELECT TOP 1
		|	Goods.Products            AS Products,
		|	Goods.Characteristic          AS Characteristic,
		|	Goods.Warehouse                   AS Warehouse,
		|	Goods.OrderShipmentWarehouse     AS OrderShipmentWarehouse,
		|	Goods.ReceivingBusinessUnit AS ReceivingBusinessUnit,
		|	Goods.Purpose              AS Purpose,
		|	Goods.OrderDocument                   AS OrderDocument,
		|	Goods.DateOfShipment            AS DateOfShipment,
		|	Goods.OrderShipmentDate      AS OrderShipmentDate,
		|
		|	Goods.NotSupplied            AS NotSupplied,
		|	Goods.DistributedInWarehouse    AS DistributedInWarehouse,
		|	Goods.DistributedFromOrders   AS DistributedFromOrders,
		|
		|	Goods.SupplyMethod AS SupplyMethod
		|{SELECT
		|	Products.*            AS Products,
		|	Characteristic.*          AS Characteristic,
		|	Warehouse.*                   AS Warehouse,
		|	OrderShipmentWarehouse.*     AS OrderShipmentWarehouse,
		|	ReceivingBusinessUnit.* AS ReceivingBusinessUnit,
		|	Purpose.*              AS Purpose,
		|	OrderDocument.*                   AS OrderDocument,
		|	DateOfShipment              AS DateOfShipment,
		|	OrderShipmentDate        AS OrderShipmentDate,
		|	NotSupplied              AS NotSupplied,
		|	DistributedInWarehouse      AS DistributedInWarehouse,
		|	DistributedFromOrders     AS DistributedFromOrders,
		|	SupplyMethod.*       AS SupplyMethod}
		|FROM
		|	TTProducts_1 AS Goods";
EndFunction

Function IsARequest(DocumentReference)
	
	Return TypeOf(DocumentReference) = Type("DocumentRef.PurchaseRequest");
	
EndFunction

