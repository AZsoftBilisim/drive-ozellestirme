Procedure TableOfSecurityMethods(Parameters, ResultAddress) Export
	
	If Parameters.SupplyMethod = Undefined Then
		DataCompositionSchema = DataProcessors.DemandFulfillment.GetTemplate("TemplateForServerFilters");
		DataCompositionSchema.DataSets.Set.Query = TemporaryTableOfSecurityMethods(
			Parameters.GoodsOfSupportedStock,
			Parameters.PurposeUseKey);
		AddressOfDataCompositionSchema = PutToTempStorage(DataCompositionSchema);
		
		SettingsSource = New DataCompositionAvailableSettingsSource(AddressOfDataCompositionSchema);
		SettingsComposer = New DataCompositionSettingsComposer();
		SettingsComposer.Initialize(SettingsSource);
		
		SettingsComposer.LoadSettings(Parameters.Settings);
		SettingsComposer.Refresh(DataCompositionSettingsRefreshMethod.CheckAvailability);
		
		Query = GetRequestWithDataLayoutSelections(AddressOfDataCompositionSchema, SettingsComposer, "Set");
		DeleteFromTempStorage(AddressOfDataCompositionSchema);
		BegOfDay = BegOfDay(CurrentSessionDate());
		Query.SetParameter("CurrentDayStart", BegOfDay);
		Query.SetParameter("AvailableTypesOfCollateral", 
			AvailableTypesOfCollateral(Parameters.PurposeUseKey));
		Query.SetParameter("FOMovementOrdersEnabled",
			GetFunctionalOption("UseTransferOrders"));
		Query.SetParameter("FOProduction2_2Enabled",
			GetFunctionalOption("UseProductionManagement2_2"));
		Query.SetParameter("OptimizeDistributionCenterInventory",
			Constants.OptimizeDistributionCenterInventory.Get());
		
		Query.TempTablesManager = New TempTablesManager();
		
		// Let's separate the part of the request that needs to be executed in a privileged manner
		DeletePosition = StrFind(Query.Text, "DROP TTWarehouseFormats");
		Position = StrFind(Query.Text, ";", SearchDirection.FromBegin, DeletePosition) + 1;
		RequestTextPrivileged = Mid(Query.Text, Position);
		Query.Text = Left(Query.Text, DeletePosition - 1);
		Query.Execute();
		
		Query.Text =
			"SELECT DISTINCT
			|	Table.Products AS Products,
			|	Table.Characteristic AS Characteristic
			|INTO DifferentProducts
			|FROM
			|	TTNeeds AS Table
			|WHERE
			|	&OptimizeDistributionCenterInventory
			|INDEX BY
			|	Products,Characteristic";
		Query.Execute();
		InformationRegisters.SupplySchemes.TemporaryTableWarehouseTopology(Query, "DifferentProducts");
	
		SetPrivilegedMode(True);
		Query.Text = RequestTextPrivileged;
		Query.Execute();
		SetPrivilegedMode(False);
		
	Else
		
		BegOfDay = BegOfDay(CurrentSessionDate());
		Query = New Query();
		Query.SetParameter("SupplyMethod", Parameters.SupplyMethod);
		Query.SetParameter("CurrentDayStart", BegOfDay);
		Query.TempTablesManager = New TempTablesManager();
		Query.Text = 
			"SELECT
			|	&SupplyMethod AS SupplyMethod
			|INTO SupplyMethods";
		Query.Execute();
		
	EndIf;
	ProvisionInDocumentsServer.TempTableNearestCycleBySupplyMethods(
		Query.TempTablesManager,
		"Catalog.ProcurementStrategies",
		"TableIsTemporary");
	
	Query.Text =
		"SELECT
		|	Table.Ref AS SupplyMethod,
		|	Table.DemandConversionOption AS DemandConversionOption,
		|	Table.ShipmentDate AS ShipmentDate,
		|	Table.BoundaryOfCoveredPeriod AS BoundaryOfCoveredPeriod,
		|	Table.GenerateOrdersOnSchedule AS GenerateOrdersOnSchedule,
		|	Table.DeliveryDateOnSchedule AS DeliveryDateOnSchedule,
		|	Table.CoveredPeriodBoundaryOnSchedule AS CoveredPeriodBoundaryOnSchedule,
		|	Table.DaysBeforePlannedOrder AS DaysBeforePlannedOrder,
		|	Table.PlannedOrderDate AS PlannedOrderDate,
		|	Table.GenerateOrdersByReorderPoint AS GenerateOrdersByReorderPoint,
		|	Table.DeliveryDateByReorderPoint AS DeliveryDateByReorderPoint,
		|	Table.CoveredPeriodBoundaryByReorderPoint AS CoveredPeriodBoundaryByReorderPoint,
		|	Table.DeliverySchedule AS DeliverySchedule,
		|	Table.CoveredPeriodOption AS CoveredPeriodOption,
		// Next are the fields for interactive user work in the second step.
		|	TRUE AS Mark,
		|	CAST(Table.Ref AS Catalog.ProcurementStrategies).Description AS Description,
		|	REFPRESENTATION(Table.Ref) AS SupplyMethodPresentation,
		|	CASE
		|		WHEN Table.Ref = VALUE(Catalog.ProcurementStrategies.EmptyRef)
		|			THEN 1
		|		ELSE 0
		|	END AS Order
		|FROM
		|	TableIsTemporary AS Table
		|ORDER BY
		|	Order, Description";
	Result = Query.Execute().Unload();
	Result.Columns.Add("DaysBeforeTheOrderAccordingToTheSchedule");
	
	For Each TableRow In Result Do
		
		If Not TableRow.GenerateOrdersOnSchedule Then
			TableRow.DaysBeforeTheOrderAccordingToTheSchedule = NStr("vi = '<chỉ để giao hàng theo lịch biểu>';
																	|ru = '<только для заказа по графику>';
																	|en = '<only for reorder schedule>'; fa = '<only for reorder schedule>';
																	|it = '<только для заказа по графику>';
																	|pl = '<only for reorder schedule>';
																	|tr = '<sadece program siparişi için>'");
		ElsIf Not ValueIsFilled(TableRow.PlannedOrderDate) Then
			If ValueIsFilled(TableRow.DeliverySchedule) Then
				TableRow.DaysBeforeTheOrderAccordingToTheSchedule = NStr("vi = '<chưa điền lịch biểu giao hàng>';
																		|ru = '<не заполнен график поставок>';
																		|en = '<delivery schedule is not filled in>'; fa = '<delivery schedule is not filled in>';
																		|it = '<не заполнен график поставок>';
																		|pl = '<nie wypełniony harmonogram dostaw>';
																		|tr = '<tedarik programı doldurulmadı>'");
			Else
				TableRow.DaysBeforeTheOrderAccordingToTheSchedule = NStr("vi = '<chưa điền lịch biểu làm việc của doanh nghiệp>';
																		|ru = '<не заполнен график работы предприятия>';
																		|en = '<enterprise schedule is not filled in>'; fa = '<enterprise schedule is not filled in>';
																		|it = '<не заполнен график работы предприятия>';
																		|pl = '<nie wypełniony harmonogram prac w przedsiębiorstwie>';
																		|tr = '<işletme çalışma takvimi doldurulmadı>'");
			EndIf;
		ElsIf TableRow.DaysBeforePlannedOrder >= 0 Then
			
			TableRow.DaysBeforeTheOrderAccordingToTheSchedule =
				StrTemplate(NStr("vi = '%1 ngày';
								|ru = '%1 дн';
								|en = '%1 days'; fa = '%1 days';
								|it = '%1 дн';
								|pl = '%1 dn';
								|tr = '%1 gün'"), TableRow.DaysBeforePlannedOrder);
		Else
			
			TableRow.DaysBeforeTheOrderAccordingToTheSchedule =
				StrTemplate(NStr("vi = 'đã quá hạn %1 ngày';
								|ru = 'просрочен на %1 дн';
								|en = '%1 days overdue'; fa = '%1 days overdue';
								|it = 'просрочен на %1 дн';
								|pl = 'zaległy na %1 dn';
								|tr = '%1 gün kadar vadesi geçmiş'"), - TableRow.DaysBeforePlannedOrder);
				
		EndIf;
		
	EndDo;
	
	PutToTempStorage(Result, ResultAddress);
	
EndProcedure

Procedure TableInventory(Parameters, ResultAddress) Export
	
	GeneratePurchaseRequests = Parameters.GeneratePurchaseRequests;
	
	Query = New Query();
	UseProductRange = False;
	
	If Parameters.FilterType = "FilterByValues" Then
		
		Query.TempTablesManager = New TempTablesManager();
		Query.SetParameter("Products",      Parameters.Filter.Products);
		Query.SetParameter("Characteristic",    Parameters.Filter.Characteristic);
		Query.SetParameter("Warehouse",             Parameters.Filter.Warehouse);
		Query.SetParameter("SupplyMethod", Parameters.Filter.SupplyMethod);
		Query.Text =
			"SELECT
			|	&Products      AS Products,
			|	&Characteristic    AS Characteristic,
			|	&Warehouse             AS Warehouse,
			|	CAST(&SupplyMethod AS Catalog.ProcurementStrategies) AS SupplyMethod
			|INTO TTProducts_1
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Approaches.SupplyMethod AS SupplyMethod
			|INTO SupplyMethods
			|FROM
			|	TTProducts_1 AS Approaches";
		Query.Execute();
		
		ProvisionInDocumentsServer.TempTableNearestCycleBySupplyMethods(Query.TempTablesManager);
		
	Else
		
		DataCompositionSchema = DataProcessors.DemandFulfillment.GetTemplate("TemplateForServerFilters");
		AddressOfDataCompositionSchema = PutToTempStorage(DataCompositionSchema);
		
		SettingsSource = New DataCompositionAvailableSettingsSource(AddressOfDataCompositionSchema);
		SettingsComposer = New DataCompositionSettingsComposer();
		SettingsComposer.Initialize(SettingsSource);
		SettingsComposer.LoadSettings(DataCompositionSchema.DefaultSettings);
		SettingsComposer.LoadUserSettings(Parameters.Filter);
		
		DataCompositionSchema.DataSets.Set.Query = TemporaryTableOfGoodsToMaintainStock();
		Query = GetRequestWithDataLayoutSelections(AddressOfDataCompositionSchema, SettingsComposer, "Set");
		DeleteFromTempStorage(AddressOfDataCompositionSchema);
		Query.TempTablesManager = New TempTablesManager();
		Query.Execute();
		
		Query.Text =
			"SELECT
			|	Table.SupplyMethod AS Ref,
			|	Table.ShipmentDate AS ShipmentDate,
			|	Table.BoundaryOfCoveredPeriod AS BoundaryOfCoveredPeriod,
			|	Table.DemandConversionOption AS DemandConversionOption
			|INTO NextCycleBySupplyMethods
			|FROM
			|	&TableOfSecurityMethods AS Table";
		
		Query.SetParameter("TableOfSecurityMethods", Parameters.TableOfSecurityMethods);
		Query.Execute();
		UseProductRange = GetFunctionalOption("UseProductRange");
		
	EndIf;
	
	SetPrivilegedMode(True);
	
	Query.SetParameter("CurrentDayStart", BegOfDay(CurrentSessionDate()));
	Query.SetParameter("MainEnterpriseCalendar", Constants.MainEnterpriseCalendar.Get());
	SupplyServer.SetParametersForStatisticsCalculationRequest(Query);
	SupplyServer.AddTemporaryTableOfConsumptionStatistics(Query, "TTProducts_1");
	
	QueriesTexts = New Array();
	QueriesTexts.Add(Catalogs.StoreFormats.QueryTextTTWarehouseFormats(False));
	QueriesTexts.Add(TimeTableDifferentProducts("TTProducts_1"));
	Query.Text = StrConcat(QueriesTexts);
	Query.Execute();
	InformationRegisters.SupplySchemes.TemporaryTableWarehouseTopology(Query, "DifferentProducts");
	
	UseQualityControl = GetFunctionalOption("UseGoodsQualityControl");
	
	QueriesTexts = New Array();
	
	If UseQualityControl Then
		
		QueriesTexts.Add(ProvisionInDocumentsServer.TempTableYearsOfEnterpriseSchedule());
		
		Text =
			"SELECT DISTINCT
			|	Goods.Products AS Products,
			|	Goods.Warehouse AS Warehouse,
			|	Table.Ref AS Ref,
			|	Table.ShipmentDate AS DeliveryDateExcludingQualityControl,
			|	CASE
			|		WHEN Table.ShipmentDate = DATETIME(1, 1, 1)
			|			THEN DATETIME(1, 1, 1)
			|		ELSE CalculationOfControlPeriodsOverridable.DateFound
			|	END AS ShipmentDate,
			|	Table.BoundaryOfCoveredPeriod AS BoundaryOfCoveredPeriod,
			|	Table.DemandConversionOption AS DemandConversionOption
			|INTO NextCycleOfSupplyMethodsIsStage1
			|FROM
			|	TTProducts_1 AS Goods
			|		INNER JOIN NextCycleBySupplyMethods AS Table
			|		ON Table.Ref = Goods.SupplyMethod
			|		LEFT JOIN CalculationOfControlPeriodsOverridable ON TRUE
			|INDEX BY
			|	Products, Warehouse";
			
			Substitutions = ProvisionInDocumentsServer.AddToDateAccordingToEnterpriseCalendar(
				"Table.ShipmentDate",
				"CASE
				|	WHEN Goods.Products.ControlQualityOfReceivedGoods
				|			AND CAST(Goods.Warehouse AS Catalog.Warehouses).ControlQualityOfReceivedGoods
				|		THEN Goods.Products.TermOfQualityControl
				|	ELSE 0
				|END");
			
			Text = StrReplace(Text, "CalculationOfControlPeriodsOverridable.DateFound", Substitutions.Field);
			Text = StrReplace(Text, "LEFT JOIN CalculationOfControlPeriodsOverridable ON TRUE", Substitutions.Joins);
			
		QueriesTexts.Add(Text);
		
		Text =
			"SELECT
			|	Table.Products AS Products,
			|	Table.Warehouse AS Warehouse,
			|	Table.Ref AS Ref,
			|	Table.DeliveryDateExcludingQualityControl AS DeliveryDateExcludingQualityControl,
			|	Table.ShipmentDate AS ShipmentDate,
			|	CASE
			|		WHEN Table.BoundaryOfCoveredPeriod = DATETIME(1, 1, 1)
			|			THEN DATETIME(1, 1, 1)
			|		ELSE CalculationOfControlPeriodsOverridable.DateFound 
			|	END AS BoundaryOfCoveredPeriod,
			|	Table.DemandConversionOption AS DemandConversionOption
			|INTO NextCycleOnSupplyMethodsTakingIntoAccountQualityControl
			|FROM
			|	NextCycleOfSupplyMethodsIsStage1 AS Table
			|		LEFT JOIN CalculationOfControlPeriodsOverridable ON TRUE
			|INDEX BY
			|	Ref, Products, Warehouse";
			
			Substitutions = ProvisionInDocumentsServer.AddToDateAccordingToEnterpriseCalendar(
				"Table.BoundaryOfCoveredPeriod",
				"CASE
				|	WHEN Table.Products.ControlQualityOfReceivedGoods
				|			AND CAST(Table.Warehouse AS Catalog.Warehouses).ControlQualityOfReceivedGoods
				|		THEN Table.Products.TermOfQualityControl
				|	ELSE 0
				|END");
			
			Text = StrReplace(Text, "CalculationOfControlPeriodsOverridable.DateFound", Substitutions.Field);
			Text = StrReplace(Text, "LEFT JOIN CalculationOfControlPeriodsOverridable ON TRUE", Substitutions.Joins);
			
		QueriesTexts.Add(Text);
		
	EndIf;
	
	Text =
		// Calendars where to look for the delivery date and the period provided.
		"SELECT DISTINCT
		|	Set.Calendar AS Calendar,
		|	Set.PeriodStartDate AS PeriodStartDate,
		|	Set.PeriodEndDate AS PeriodEndDate,
		|	Set.YearOfStartInterval AS YearOfStartInterval,
		|	Set.YearOfEndOfInterval AS YearOfEndOfInterval
		|INTO ToSearchForNumberOfDaysInInterval
		|FROM(
		|	SELECT
		|		CASE
		|			WHEN ISNULL(CAST(Goods.Warehouse AS Catalog.Warehouses).Calendar,
		|					VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
		|				THEN MainEnterpriseCalendar.Value
		|			ELSE CAST(Goods.Warehouse AS Catalog.Warehouses).Calendar
		|		END AS Calendar,
		|		&CurrentDayStart PeriodStartDate,
		|		Method.ShipmentDate PeriodEndDate,
		|		YEAR(&CurrentDayStart) AS YearOfStartInterval,
		|		YEAR(Method.ShipmentDate) AS YearOfEndOfInterval
		|FROM
		|	TTProducts_1 AS Goods
		|		LEFT JOIN NextCycleBySupplyMethods AS Method
		|		ON Method.Ref = Goods.SupplyMethod
		|		AND &GoodsConnectionQualityControl
		|		LEFT JOIN Constant.MainEnterpriseCalendar AS MainEnterpriseCalendar
		|		ON TRUE
		|WHERE
		// Calculation of warehouse working days, to calculate the minimum stock.
		|	Method.ShipmentDate > DATETIME(1, 1, 1)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		CASE
		|			WHEN ISNULL(CAST(Goods.Warehouse AS Catalog.Warehouses).Calendar,
		|					VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
		|				THEN MainEnterpriseCalendar.Value
		|			ELSE CAST(Goods.Warehouse AS Catalog.Warehouses).Calendar
		|		END AS Calendar,
		|		Method.ShipmentDate AS PeriodStartDate,
		|		Method.BoundaryOfCoveredPeriod AS PeriodEndDate,
		|		YEAR(Method.ShipmentDate) AS YearOfStartInterval,
		|		YEAR(Method.BoundaryOfCoveredPeriod) AS YearOfEndOfInterval
		|FROM
		|	TTProducts_1 AS Goods
		|		LEFT JOIN NextCycleBySupplyMethods AS Method
		|		ON Method.Ref = Goods.SupplyMethod
		|		AND &GoodsConnectionQualityControl
		|		LEFT JOIN Constant.MainEnterpriseCalendar AS MainEnterpriseCalendar
		|		ON TRUE
		|WHERE
		// Calculation of workdays of the warehouse, between the date of delivery and the border of the secured period
		|		Method.ShipmentDate > DATETIME(1, 1, 1)
		|			AND Method.BoundaryOfCoveredPeriod > DATETIME(1, 1, 1)) AS Set
		|INDEX BY
		|	Calendar, YearOfStartInterval, YearOfEndOfInterval";
		
	GoodsConnectionQualityControl = "TRUE";
	If UseQualityControl Then
		GoodsConnectionQualityControl =
		"(Method.Products = Goods.Products
		|AND Method.Warehouse = Goods.Warehouse)";
		Text = StrReplace(Text, "NextCycleBySupplyMethods", "NextCycleOnSupplyMethodsTakingIntoAccountQualityControl");
	EndIf;
	Text = StrReplace(Text, "&GoodsConnectionQualityControl", GoodsConnectionQualityControl);

	QueriesTexts.Add(Text);
	QueriesTexts.Add(ProvisionInDocumentsServer.TempTableResultsOfCalculationOfNumberOfDaysInInterval());
	QueriesTexts.Add(InformationRegisters.SupplySchemes.TemporaryTableOfVariousGoodsAndWarehouses("TTProducts_1", False));
	QueriesTexts.Add(TemporaryTableOrderFillingDataForSupplier());
	QueriesTexts.Add(TempTableOfMovementWithinNetwork("VariousGoodsAndWarehouses", False));
	QueriesTexts.Add(TemporaryTableFreeBalances(False));
	QueriesTexts.Add(TemporaryTableBanningPurchasesByAssortment(UseProductRange, UseQualityControl));
	
	Text =
		"SELECT
		|	T.Products                 AS Products,
		|	T.Characteristic               AS Characteristic,
		|	T.Warehouse                        AS Warehouse,
		|	T.Products.Description    AS NomenclatureName,
		|	T.Characteristic.Description  AS CharacteristicName,
		|	T.Warehouse.Description           AS WarehouseName,
		|
		|	CASE
		|		WHEN VALUE(Enum.OrderFulfillmentWithinInventoryReplenishment.SupplyFromStock) = ProductRestrictions.OrderFulfillmentWithinInventoryReplenishment
		|			THEN ISNULL(Balance.InStock, 0)
		|		ELSE ISNULL(Balance.SurplusInStock, 0)
		|	END AS Balance,
		|	
		|	CASE
		|		WHEN VALUE(Enum.OrderFulfillmentWithinInventoryReplenishment.SupplyFromStock) = ProductRestrictions.OrderFulfillmentWithinInventoryReplenishment
		|			THEN ISNULL(Balance.OnQualityControlInStock, 0)
		|		ELSE ISNULL(Balance.OnQualityControlSurplusInStock, 0)
		|	END AS OnQualityControl,
		|	
		|	CASE
		|		WHEN VALUE(Enum.OrderFulfillmentWithinInventoryReplenishment.SupplyFromStock) = ProductRestrictions.OrderFulfillmentWithinInventoryReplenishment
		|			THEN 0
		|		ELSE ISNULL(Balance.ReserveAtWarehouse, 0)
		|	END AS ReservesInStock,
		|	
		|	CASE
		|		WHEN VALUE(Enum.OrderFulfillmentWithinInventoryReplenishment.SupplyFromStock) = ProductRestrictions.OrderFulfillmentWithinInventoryReplenishment
		|			THEN ISNULL(Balance.Ordered, 0)
		|		ELSE ISNULL(Balance.SurplusInOrders, 0)
		|	END AS OrdersPendingGoodsReceipt,
		|
		// The item parameter
		|	&QueryTextItemWeight                        AS Weight,
		|	T.Products.UnitOfMeasure                     AS UnitOfMeasure,
		|	T.Products.UnitOfMeasure.MeasuredValueType AS UnitOfMeasureType,
		|	T.Products.Code                                  AS Code,
		|	T.Products.SKU                              AS SKU,
		|	T.Products.UsePackages                 AS UsePackages,
		|
		// Product restrictions
		|	ISNULL(ProductRestrictions.InventoryReplenishmentMethod,
		|		VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)) AS StrategyOfProcurement,
		|	ProductRestrictions.MinimumInventoryQuantity      AS MinimumInventory,
		|	ProductRestrictions.MaximumInventoryAmount     AS MaximumInventory,
		|	ProductRestrictions.SafetyStockQuantity        AS SafetyStock,
		|
		// Order packaging
		|	CatPackages.Ref                                   AS OrderPackage,
		|	
		|	ISNULL(CatPackages.Numerator, 1)                   AS PackageNumerator,
		|	ISNULL(CatPackages.Denominator, 1)                 AS PackageDenominator,
		|	
		// A way of ensuring
		|	T.SupplyMethod                                  AS SupplyMethod,
		|	ISNULL(T.SupplyMethod.SupplyType,
		|		VALUE(Enum.SupplyTypes.Purchase))  AS SupplyType,
		|	CASE
		|		WHEN &GeneratePurchaseRequests
		|			AND ISNULL(T.SupplyMethod.EmployeeResponsible,
		|				VALUE(Catalog.Users.EmptyRef)) = VALUE(Catalog.Users.EmptyRef)
		|			THEN &CurrentUser
		|		ELSE ISNULL(T.SupplyMethod.EmployeeResponsible,
		|				VALUE(Catalog.Users.EmptyRef))
		|	END                                                AS Manager,
		|	TableOfSecurityMethods.DemandConversionOption             AS DemandConversionOption,
		|	TableOfSecurityMethods.DeliveryDateExcludingQualityControl AS ShipmentDate,
		|	ISNULL(&FOMovementOrdersEnabled AND NOT T.Warehouse.ShopFloorStockroom
		|		OR &FOProduction2_2Enabled AND T.Warehouse.ShopFloorStockroom, FALSE) AS TransferIsAllowed,
		|
		// The period for calculating the minimum stock by the forecast method.
		|	CASE
		|		WHEN IntervalBeforeDeliveryDate.DaysCount IS NULL AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|			THEN DATEDIFF(&CurrentDayStart, TableOfSecurityMethods.ShipmentDate, DAY)
		|		ELSE ISNULL(IntervalBeforeDeliveryDate.DaysCount, 0)
		|	END AS DeliveryPeriodDays,
		|	
		|	ProductRestrictions.InventoryReplenishmentMethod IN(
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStandard),
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics))
		|		AND TableOfSecurityMethods.ShipmentDate = DATETIME(1, 1, 1) AS ErrorSettingIntervalToDeliveryDate,
		|	
		|	ProductRestrictions.InventoryReplenishmentMethod IN(
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStandard),
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics))
		|		AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|		AND IntervalBeforeDeliveryDate.DaysCount IS NULL AS ErrorInCalculatingIntervalBeforeDeliveryDate,
		|	
		// The period for calculating the maximum stock by the forecast method.
		|	CASE
		|		WHEN IntervalBetweenDeliveries.DaysCount IS NULL
		|				AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|				AND TableOfSecurityMethods.BoundaryOfCoveredPeriod > DATETIME(1, 1, 1)
		|			THEN DATEDIFF(TableOfSecurityMethods.ShipmentDate, TableOfSecurityMethods.BoundaryOfCoveredPeriod, DAY)
		|		ELSE ISNULL(IntervalBetweenDeliveries.DaysCount, 0)
		|	END AS CoveredPeriod,
		|	
		|	ProductRestrictions.InventoryReplenishmentMethod IN(
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStandard),
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics))
		|		AND IntervalBetweenDeliveries.DaysCount IS NULL
		|		AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|		AND TableOfSecurityMethods.BoundaryOfCoveredPeriod > DATETIME(1, 1, 1) AS ErrorInCalculatingIntervalBetweenDeliveries,
		|	
		|	ProductRestrictions.InventoryReplenishmentMethod IN(
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStandard),
		|			VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics))
		|		AND (TableOfSecurityMethods.ShipmentDate = DATETIME(1, 1, 1)
		|			OR TableOfSecurityMethods.BoundaryOfCoveredPeriod = DATETIME(1, 1, 1)) AS ErrorSettingIntervalBetweenDeliveries,
		// Consumption for calculating the minimum and maximum stock by the forecast method.
		|	CASE
		|		WHEN ProductRestrictions.InventoryReplenishmentMethod
		|				= VALUE(Enum.InventoryReplenishmentMethods.StockReplenishmentByStatistics)
		|			THEN ISNULL(StatisticsTable1.AverageDailyConsumption, 0)
		|		ELSE ProductRestrictions.ConsumptionRate
		|	END AS AverageDailyConsumption,
		|	
		|	ISNULL(StatisticsTable1.ConsumptionIsStable, FALSE) AS ConsumptionIsStable,
		|
		// Terms of purchase
		|	ISNULL(FillingData.VendorPriceKind,
		|		CASE
		|			WHEN ISNULL(T.SupplyMethod.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|					<> VALUE(Catalog.VendorPriceTypes.EmptyRef)
		|				THEN T.SupplyMethod.VendorPriceKind
		|				ELSE ISNULL(T.SupplyMethod.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|			END) AS PriceKind,
		|	ISNULL(FillingData.Currency, T.SupplyMethod.Terms.Currency)            AS AgreementCurrency,
		|
		|	CASE WHEN NOT ISNULL(FillingData.Terms.PriceIncludesVAT, T.SupplyMethod.Terms.PriceIncludesVAT) THEN
		|			(CASE
		|				WHEN NOT (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|					THEN (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|				WHEN NOT (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|					THEN (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|				ELSE 0
		|			END + 100) / 100
		|			ELSE 
		|				1
		|		END
		|	* SupplierPrices.Price
		|	* CASE
		|		WHEN ExchangeRateAgreementCurrency.ZoomRatio = 0
		|			THEN 0
		|		ELSE ExchangeRates.ZoomRatio / ExchangeRateAgreementCurrency.ZoomRatio
		|	END
		|	/ ISNULL(&QueryTextPackagingFactor, 1)                                          AS PriceInTheCurrencyOfAgreement,
		|
		|	CASE WHEN NOT ISNULL(FillingData.Terms.PriceIncludesVAT, T.SupplyMethod.Terms.PriceIncludesVAT) THEN
		|
		|			(CASE
		|				WHEN NOT (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|					THEN (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|				WHEN NOT (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|					THEN (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|				ELSE 0
		|			END + 100) / 100
		|			ELSE
		|				1
		|		END
		|	* SupplierPrices.Price * ExchangeRates.ZoomRatio / &CurrencyCoefficientOfManAccounting
		|	/ ISNULL(&QueryTextPackagingFactor, 1)                                AS PriceInTheCurrencyOfManagementAccounting,
		|
		|	CASE WHEN T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.AssemblyDisassembly) THEN
		|			TRUE
		|		ELSE
		|			CASE ISNULL(T.SupplyMethod.SourceOfDemandSupply, UNDEFINED)
		|					WHEN UNDEFINED THEN
		|						FALSE
		|					WHEN VALUE(Catalog.Warehouses.EmptyRef) THEN
		|						FALSE
		|					WHEN VALUE(Catalog.Partners.EmptyRef) THEN
		|						FALSE
		|					WHEN VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|						FALSE
		|					ELSE
		|						TRUE //the source of the provision is set in the method of providing the needs
		|				END
		|		END                                                                      AS SupplySourceViewOnly,
		|
		|	ISNULL(FillingData.Partner,
		|		T.SupplyMethod.SourceOfDemandSupply)        AS SupplySource,
		|	CASE WHEN T.SupplyMethod.Terms <> VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef) THEN
		|				T.SupplyMethod.Terms
		|			ELSE
		|				FillingData.Terms
		|		END                                                       AS Terms,
		|	SupplierPrices.SupplierOrderPackaging AS SupplierOrderPackaging,
		|	SupplierPrices.MinimumDeliveryLot AS MinimumDeliveryLot,
		|	CASE WHEN T.SupplyMethod.Terms <> VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef) THEN
		|				ISNULL(T.SupplyMethod.Terms.MinimumOrderAmount,0)
		|			ELSE
		|				ISNULL(FillingData.Terms.MinimumOrderAmount,0)
		|		END                                                       AS MinimumOrderAmount
		|FROM
		|	TTProducts_1 AS T
		|		
		|		LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
		|		ON &SubstituteGoodsRestriction
		|
		|		INNER JOIN NextCycleBySupplyMethods AS TableOfSecurityMethods
		|		ON T.SupplyMethod = TableOfSecurityMethods.Ref
		|		AND &GoodsConnectionQualityControl
		|
		|		LEFT JOIN ResultsOfCalculatingNumberOfDaysInInterval AS IntervalBeforeDeliveryDate
		|		ON IntervalBeforeDeliveryDate.Calendar =
		|			CASE
		|				WHEN ISNULL(CAST(T.Warehouse AS Catalog.Warehouses).Calendar,
		|						VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
		|					THEN &MainEnterpriseCalendar
		|				ELSE CAST(T.Warehouse AS Catalog.Warehouses).Calendar
		|			END
		|		 AND IntervalBeforeDeliveryDate.PeriodStartDate = &CurrentDayStart
		|		 AND IntervalBeforeDeliveryDate.PeriodEndDate = TableOfSecurityMethods.ShipmentDate
		|
		|		LEFT JOIN ResultsOfCalculatingNumberOfDaysInInterval AS IntervalBetweenDeliveries
		|		ON IntervalBetweenDeliveries.Calendar =
		|			CASE
		|				WHEN ISNULL(CAST(T.Warehouse AS Catalog.Warehouses).Calendar,
		|						VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
		|					THEN &MainEnterpriseCalendar
		|				ELSE CAST(T.Warehouse AS Catalog.Warehouses).Calendar
		|			END
		|		 AND IntervalBetweenDeliveries.PeriodStartDate = TableOfSecurityMethods.ShipmentDate
		|		 AND IntervalBetweenDeliveries.PeriodEndDate = TableOfSecurityMethods.BoundaryOfCoveredPeriod
		|
		|		LEFT JOIN TTFreeBalances AS Balance
		|		ON T.Products   = Balance.Products
		|		 AND T.Characteristic = Balance.Characteristic
		|		 AND T.Warehouse          = Balance.Warehouse
		|
		|		LEFT JOIN WarehouseTopology AS DistributionNetworkCenters
		|		ON DistributionNetworkCenters.Products = T.Products
		|		 AND DistributionNetworkCenters.Characteristic = T.Characteristic
		|		 AND DistributionNetworkCenters.Center = T.Warehouse
		|		 AND DistributionNetworkCenters.Warehouse = T.Warehouse
		|
		|		LEFT JOIN TTConsumptionStatistics AS StatisticsTable1
		|		ON T.Products   = StatisticsTable1.Products
		|		 AND T.Characteristic = StatisticsTable1.Characteristic
		|		 AND T.Warehouse          = StatisticsTable1.Warehouse
		|
		|		LEFT JOIN TTOrderFillingDataToSupplier AS FillingData
		|		ON T.Products    = FillingData.Products
		|		 AND T.Characteristic  = FillingData.Characteristic
		|		 AND T.Warehouse           = FillingData.Warehouse
		|		 AND ISNULL(T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Purchase), TRUE)
		|		 AND T.SupplyMethod.SourceOfDemandSupply.Ref IS NULL
		|		
		|		LEFT JOIN SupplierPrices AS SupplierPrices
		|		ON T.Products       = SupplierPrices.Products
		|			AND T.Characteristic  = SupplierPrices.Characteristic
		|			AND ISNULL(FillingData.VendorPriceKind,
		|				CASE
		|						WHEN ISNULL(T.SupplyMethod.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|								<> VALUE(Catalog.VendorPriceTypes.EmptyRef)
		|							THEN T.SupplyMethod.VendorPriceKind
		|						ELSE ISNULL(T.SupplyMethod.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|					END) = SupplierPrices.VendorPriceKind
		|
		|		LEFT JOIN ExchangeRates AS ExchangeRates
		|		ON SupplierPrices.Currency = ExchangeRates.Currency
		|
		|		LEFT JOIN ExchangeRates AS ExchangeRateAgreementCurrency
		|		ON ISNULL(FillingData.Currency, T.SupplyMethod.Terms.Currency) = ExchangeRateAgreementCurrency.Currency
		|
		|		LEFT JOIN InformationRegister.ProductRestrictions AS OrderPackaging
		|		ON &SubstitutionOfOrderPackaging
		|
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS CatPackages
		|		ON OrderPackaging.OrderPackage = CatPackages.Ref
		|
		|		LEFT JOIN ProhibitionOfPurchasingByAssortment AS ProhibitionOfPurchasingByAssortment
		|		ON ProhibitionOfPurchasingByAssortment.Warehouse = T.Warehouse
		|		 AND ProhibitionOfPurchasingByAssortment.Products = T.Products
		|		 AND ProhibitionOfPurchasingByAssortment.PossibleDeliveryDate = ISNULL(TableOfSecurityMethods.DeliveryDateExcludingQualityControl, &CurrentDayStart)
		|		
		|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&CurrentDayStart) AS VATRatesForProductsOfCountryOfRegistration
		|		ON T.Products = VATRatesForProductsOfCountryOfRegistration.Products
		|		 AND T.SupplyMethod.Organization.RegistrationCountry = VATRatesForProductsOfCountryOfRegistration.Country
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&CurrentDayStart) AS BasicVATRatesOfCountryOfRegistration
		|		ON T.SupplyMethod.Organization.RegistrationCountry = BasicVATRatesOfCountryOfRegistration.Country
		|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&CurrentDayStart, Country = &MainCountry OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS ProductsVATRates
		|		ON T.Products = ProductsVATRates.Products
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&CurrentDayStart, Country = &MainCountry) AS BasicVATRates
		|		ON (TRUE)
		|WHERE
		|	ProhibitionOfPurchasingByAssortment.Warehouse IS NULL
		|
		|ORDER BY
		|	NomenclatureName, CharacteristicName";
		
	GoodsConnectionQualityControl = "TRUE";
	If UseQualityControl Then
		GoodsConnectionQualityControl =
		"(T.Products = TableOfSecurityMethods.Products
		|AND T.Warehouse = TableOfSecurityMethods.Warehouse)";
		Text = StrReplace(Text, "NextCycleBySupplyMethods", "NextCycleOnSupplyMethodsTakingIntoAccountQualityControl");
	Else
		Text = StrReplace(Text, "DeliveryDateExcludingQualityControl", "ShipmentDate");
	EndIf;
	Text = StrReplace(Text, "&GoodsConnectionQualityControl", GoodsConnectionQualityControl);
	
	Text = InformationRegisters.ProductRestrictions.SubstituteConnection(Text,
		"SubstituteGoodsRestriction");
	Text = InformationRegisters.ProductRestrictions.SubstituteConnectionForOrderPackaging(Text,
		"SubstitutionOfOrderPackaging");
	Text = StrReplace(Text, "&QueryTextItemWeight",
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight(
			"T.Products.UnitOfMeasure",
			"T.Products"));
	
	Text = StrReplace(Text, "&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"SupplierPrices.Package",
			"SupplierPrices.Products"));
	
	QueriesTexts.Add(Text);
	
	Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	Query.SetParameter("UseItemVariants",
		GetFunctionalOption("UseItemVariants"));
	Query.SetParameter("FOMovementOrdersEnabled",
		GetFunctionalOption("UseTransferOrders"));
	Query.SetParameter("FOProduction2_2Enabled",
		GetFunctionalOption("UseProductionManagement2_2"));
	
	Query.SetParameter("CurrentDayStart", BegOfDay(CurrentSessionDate()));
	Query.SetParameter("MainCountry", SettingsValueClientServerCached.MainCountry());
	
	CurrencyExchangeRateManAccounting = ProcessingOfExchangeRatesTM.GetCurrencyRate(Constants.ManagementAccountingCurrency.Get(), BegOfDay(CurrentSessionDate()));
	CurrencyCoefficientOfManAccounting = CurrencyExchangeRateManAccounting.CourseNumerator / CurrencyExchangeRateManAccounting.CourseDenominator;
	Query.SetParameter("CurrencyCoefficientOfManAccounting", CurrencyCoefficientOfManAccounting);
	Query.SetParameter("BeginOfPeriod", BegOfDay(CurrentSessionDate()));
	Query.SetParameter("GeneratePurchaseRequests", GeneratePurchaseRequests);
	Query.SetParameter("CurrentUser", Users.CurrentUser());
	
	SetPrivilegedMode(True);
	Table = Query.Execute().Unload();
	PutToTempStorage(Table, ResultAddress);
	
EndProcedure

Procedure TableOfOrderRequirementsAndBalances(Parameters, ResultAddress) Export
	
	OptimizeDistributionCenterInventory = Constants.OptimizeDistributionCenterInventory.Get();
	
	UseProductRange = False;
	
	If Parameters.FilterType = "FilterByValues" Then
	
		Query = New Query();
		Query.TempTablesManager = New TempTablesManager();
		Query.Text =
			"SELECT
			|	&Products   AS Products,
			|	&Characteristic AS Characteristic,
			|	&Warehouse          AS Warehouse,
			|	&OrderShipmentDate      AS OrderShipmentDate,
			|	&OrderShipmentWarehouse     AS OrderShipmentWarehouse,
			|	&ReceivingBusinessUnit AS ReceivingBusinessUnit,
			|	CAST(&SupplyMethod AS Catalog.ProcurementStrategies) AS SupplyMethod,
			|	
			|	&Purpose     AS Purpose,
			|	&OrderDocument          AS OrderDocument,
			|	&DateOfShipment   AS DateOfShipment,
			|	0 AS NotSupplied,
			|	0 AS DistributedInWarehouse,
			|	0 AS DistributedFromOrders
			|INTO TTProducts_1
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Approaches.SupplyMethod AS SupplyMethod
			|INTO SupplyMethods
			|FROM
			|	TTProducts_1 AS Approaches
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	VALUE(Catalog.Products.EmptyRef)               AS Products,
			|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
			|	VALUE(Catalog.Warehouses.EmptyRef)                     AS Warehouse,
			|	VALUE(Catalog.Warehouses.EmptyRef)                     AS Center
			|INTO WarehouseTopology
			|WHERE
			|	FALSE
			|;
			|SELECT
			|	VALUE(Catalog.Products.EmptyRef)               AS Products,
			|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
			|	VALUE(Catalog.Warehouses.EmptyRef)                     AS Warehouse,
			|	VALUE(Catalog.Assignments.EmptyRef)                 AS Purpose
			|INTO GoodsAndWarehousesProcessed
			|WHERE
			|	FALSE";
		
		For Each Property In Parameters.Filter Do
			Query.SetParameter(Property.Key, Property.Value);
		EndDo;
		Query.Execute();
		
		ProvisionInDocumentsServer.TempTableNearestCycleBySupplyMethods(Query.TempTablesManager);
		
	Else
		
		TempTablesManager = New TempTablesManager();
		
		DataCompositionSchema = DataProcessors.DemandFulfillment.GetTemplate("TemplateForServerFilters");
		AddressOfDataCompositionSchema = PutToTempStorage(DataCompositionSchema);
		
		SettingsSource = New DataCompositionAvailableSettingsSource(AddressOfDataCompositionSchema);
		SettingsComposer = New DataCompositionSettingsComposer();
		SettingsComposer.Initialize(SettingsSource);
		SettingsComposer.LoadSettings(DataCompositionSchema.DefaultSettings);
		SettingsComposer.LoadUserSettings(Parameters.Filter);
		
		// Main query
		Texts = New Array();
		Texts.Add(TemporaryTableSelectionBySegment());
		Texts.Add(TemporaryTableSelectionByOrders());
		Texts.Add(TemporaryTableOfNeedsOfAllWarehousesByOrders());
		Texts.Add(
			"SELECT
			|	Table.SupplyMethod AS SupplyMethod
			|INTO SupplyMethodsForSelections
			|FROM
			|	&TableOfSecurityMethods AS Table");
		Texts.Add(TemporaryTableOfNeedsOfSelectedWarehouses());
		Texts.Add(FetchingFirstNeedsRecordByOrderForQueryLayout());
		Text = StrConcat(Texts, Common.QueryBatchSeparator());
		
		DataCompositionSchema.DataSets.Set.Query = Text;
		Query = GetRequestWithDataLayoutSelections(AddressOfDataCompositionSchema, SettingsComposer, "Set");
		DeleteFromTempStorage(AddressOfDataCompositionSchema);
		
		// Separate the part of the request that needs to be executed in a privileged manner.
		DeletePosition = StrFind(Query.Text, "DROP TTWarehouseFormats");
		Position = StrFind(Query.Text, ";", SearchDirection.FromBegin, DeletePosition) + 1;
		RequestTextPrivileged = Mid(Query.Text, Position);
		Query.Text = Left(Query.Text, DeletePosition - 1);
		Query.SetParameter("OptimizeDistributionCenterInventory", OptimizeDistributionCenterInventory);
		Query.SetParameter("FOMovementOrdersEnabled",
			GetFunctionalOption("UseTransferOrders"));
		Query.SetParameter("FOProduction2_2Enabled",
			GetFunctionalOption("UseProductionManagement2_2"));
		Query.SetParameter("TableOfSecurityMethods", Parameters.TableOfSecurityMethods);
		Query.SetParameter("TheProductionScheduleIsUsed",
			ProductionManagementCached.TheProductionScheduleIsUsed());
		Query.TempTablesManager = TempTablesManager;
		Query.Execute();
		
		// For the part of the query executed in privileged mode, you need a temp table of the warehouse topology.
		Query.Text = TimeTableDifferentProducts("NeedsOfAllWarehousesOnOrders");
		Query.Execute();
		InformationRegisters.SupplySchemes.TemporaryTableWarehouseTopology(Query, "DifferentProducts");
		
		SetPrivilegedMode(True);
		
		Query.Text = RequestTextPrivileged;
		Query.Execute();
		Query.Text =
			"SELECT
			|	Table.SupplyMethod AS Ref,
			|	Table.ShipmentDate AS ShipmentDate,
			|	Table.BoundaryOfCoveredPeriod AS BoundaryOfCoveredPeriod,
			|	Table.GenerateOrdersOnSchedule AS GenerateOrdersOnSchedule,
			|	Table.DeliveryDateOnSchedule AS DeliveryDateOnSchedule,
			|	Table.CoveredPeriodBoundaryOnSchedule AS CoveredPeriodBoundaryOnSchedule,
			|	Table.PlannedOrderDate AS PlannedOrderDate,
			|	Table.DaysBeforePlannedOrder AS DaysBeforePlannedOrder,
			|	Table.GenerateOrdersByReorderPoint AS GenerateOrdersByReorderPoint,
			|	Table.DeliveryDateByReorderPoint AS DeliveryDateByReorderPoint,
			|	Table.CoveredPeriodBoundaryByReorderPoint AS CoveredPeriodBoundaryByReorderPoint,
			|	Table.DeliverySchedule AS DeliverySchedule,
			|	Table.CoveredPeriodOption AS CoveredPeriodOption,
			|	Table.DemandConversionOption AS DemandConversionOption
			|INTO NextCycleBySupplyMethods
			|FROM
			|	&TableOfSecurityMethods AS Table
			|;
			|
			|///////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	Goods.Products AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	CASE
			|		WHEN CAST(Goods.Products AS Catalog.Products).ItemsType
			|				= VALUE(Enum.ItemsTypes.Work_5)
			|			THEN Goods.ReceivingBusinessUnit
			|		ELSE Goods.Warehouse
			|	END AS Warehouse,
			|	Goods.Purpose AS Purpose
			|INTO GoodsAndWarehousesProcessed
			|FROM
			|	TTProducts_1 AS Goods
			|INDEX BY
			|	Products, Characteristic, Warehouse, Purpose";
		Query.Execute();
		
		UseProductRange = GetFunctionalOption("UseProductRange");
		
	EndIf;
	
	BegOfDay = BegOfDay(CurrentSessionDate());
	Query.SetParameter("CurrentDayStart", BegOfDay);
	
	UseQualityControl = GetFunctionalOption("UseGoodsQualityControl");
	
	Texts = New Array();
	
	Text = ProvisionInDocumentsServer.TempTableYearsOfEnterpriseSchedule();
	Texts.Add(Text);
	
	If UseQualityControl Then
		
		Text =
			"SELECT
			|	*,
			|	CASE
			|		WHEN Goods.DateOfShipment = DATETIME(1, 1, 1)
			|			THEN DATETIME(1, 1, 1)
			|		WHEN CalculationOfControlPeriodsOverridable.DateFound = DATETIME(1, 1, 1)
			|			THEN NULL
			|		ELSE CalculationOfControlPeriodsOverridable.DateFound
			|	END AS DateOfShipmentMinusQualityControlPeriod
			|INTO TTGoodsSubjectToQualityControl
			|FROM
			|	TTProducts_1 AS Goods
			|		INNER JOIN NextCycleBySupplyMethods AS Table
			|		ON Table.Ref = Goods.SupplyMethod
			|		LEFT JOIN CalculationOfControlPeriodsOverridable ON TRUE";
			
		Substitutions = ProvisionInDocumentsServer.AddToDateAccordingToEnterpriseCalendar(
			"Goods.DateOfShipment",
			"CASE
			|	WHEN Goods.Products.ControlQualityOfReceivedGoods
			|			AND CAST(Goods.Warehouse AS Catalog.Warehouses).ControlQualityOfReceivedGoods
			|		THEN -Goods.Products.TermOfQualityControl
			|	ELSE 0
			|END");
		
		Text = StrReplace(Text, "CalculationOfControlPeriodsOverridable.DateFound", Substitutions.Field);
		Text = StrReplace(Text, "LEFT JOIN CalculationOfControlPeriodsOverridable ON TRUE", Substitutions.Joins);
		
		Texts.Add(Text);
		
	EndIf;
	
	Text =
		// Calendars where you need to search for the order date.
		"SELECT DISTINCT
		|	Goods.SupplyMethod,
		|	Goods.DateOfShipment AS DateOfShipment
		|INTO ShippingMethodsAndDates
		|FROM
		|	TTProducts_1 AS Goods
		|		
		|		INNER JOIN NextCycleBySupplyMethods AS TableOfSecurityMethods
		|		ON TableOfSecurityMethods.Ref = Goods.SupplyMethod
		|		
		|		INNER JOIN Constant.OptionOfOrderingDemandsByOrdersForSupply AS OrderingByDocumentDate
		|		ON OrderingByDocumentDate.Value = VALUE(Enum.OptionsOfOrderingDemandsByOrdersForSupply.PriorityAndShipmentDate)
		|WHERE
		|	Goods.DateOfShipment > TableOfSecurityMethods.ShipmentDate
		|		OR TableOfSecurityMethods.ShipmentDate = DATETIME(1, 1, 1)";
		
	If UseQualityControl Then
		
		Text = StrReplace(Text, "TTProducts_1", "TTGoodsSubjectToQualityControl");
		Text = StrReplace(Text, "Goods.DateOfShipment", "Goods.DateOfShipmentMinusQualityControlPeriod");
		
	EndIf;
	
	Texts.Add(Text);
	
	Text =
		"SELECT
		|	Table.SupplyMethod AS SupplyMethod,
		|	Table.DateOfShipment AS DateOfShipment,
		|	CalculationOfDeliveryDateByDateOfShipmentOverridable.PlannedDeliveryDate AS ShipmentDate
		|INTO Delivery_Dates
		|FROM
		|	ShippingMethodsAndDates AS Table
		|		
		|		LEFT JOIN CalculationOfDeliveryDateByDateOfShipmentOverridable ON TRUE
		|INDEX BY
		|	SupplyMethod";
	
	Substitutions = ProvisionInDocumentsServer.SubstitutionsOfDeliveryDateClosestToShipmentDate(
		"Table.SupplyMethod",
		"Table.DateOfShipment");
	
	Text = StrReplace(Text, "CalculationOfDeliveryDateByDateOfShipmentOverridable.PlannedDeliveryDate", Substitutions.Field);
	Text = StrReplace(Text, "LEFT JOIN CalculationOfDeliveryDateByDateOfShipmentOverridable ON TRUE", Substitutions.Joins);
	Texts.Add(Text);
	
	// If orders are formed only at the point of order, then the delivery date is any day,
	// then the delivery date = the date of shipment, but if the shipment is on a weekend, then the delivery date is the first working day before the date of shipment.
	// If the first working day before the shipment date on the left is less than the current one, then we put it on the first working day after it (on the right).
	Text =
		"SELECT
		|	Table.SupplyMethod AS SupplyMethod,
		|	Table.DateOfShipment AS DateOfShipment,
		|	CASE
		|		WHEN NOT CAST(Table.SupplyMethod AS Catalog.ProcurementStrategies).GenerateOrdersOnSchedule
		|				AND CompanySCalendarIsTemporary.Value <> VALUE(Catalog.Calendars.EmptyRef)
		|				AND CalculationOfAddingDateIsOverridable.DateFound >= &CurrentDayStart
		|			THEN CalculationOfAddingDateIsOverridable.DateFound
		|		ELSE Table.ShipmentDate
		|	END AS ShipmentDate,
		|	NOT CAST(Table.SupplyMethod AS Catalog.ProcurementStrategies).GenerateOrdersOnSchedule
		|		AND CompanySCalendarIsTemporary.Value <> VALUE(Catalog.Calendars.EmptyRef)
		|		AND CalculationOfAddingDateIsOverridable.DateFound < &CurrentDayStart
		|		AND CalculationOfAddingDateIsOverridable.DateFound > DATETIME(1, 1, 1) AS AddOneWorkday
		|INTO DeliveryDatesIncludingWorkdaysFirst
		|FROM
		|	Delivery_Dates AS Table
		|		
		|		LEFT JOIN Constant.MainEnterpriseCalendar AS CompanySCalendarIsTemporary
		|		ON TRUE
		|		
		|		LEFT JOIN CalculationOfAddingDateIsOverridable ON TRUE
		|INDEX BY
		|	SupplyMethod";
		
	Substitutions = ProvisionInDocumentsServer.AddToDateAccordingToEnterpriseCalendar(
		"Table.ShipmentDate", "0", True);
	
	Text = StrReplace(Text, "CalculationOfAddingDateIsOverridable.DateFound", Substitutions.Field);
	Text = StrReplace(Text, "LEFT JOIN CalculationOfAddingDateIsOverridable ON TRUE", Substitutions.Joins);
	Texts.Add(Text);
	
	Text =
		"SELECT
		|	Table.SupplyMethod AS SupplyMethod,
		|	Table.DateOfShipment AS DateOfShipment,
		|	CASE
		|		WHEN Table.AddOneWorkday
		|				AND CalculationOfAddingDateIsOverridable.DateFound > DATETIME(1, 1, 1)
		|			THEN CalculationOfAddingDateIsOverridable.DateFound
		|		ELSE Table.ShipmentDate
		|	END AS ShipmentDate
		|INTO DeliveryDatesIncludingWorkdays
		|FROM
		|	DeliveryDatesIncludingWorkdaysFirst AS Table
		|		
		|		LEFT JOIN CalculationOfAddingDateIsOverridable ON TRUE
		|INDEX BY
		|	SupplyMethod";
		
	Substitutions = ProvisionInDocumentsServer.AddToDateAccordingToEnterpriseCalendar(
		"Table.ShipmentDate", "1");
	
	Text = StrReplace(Text, "CalculationOfAddingDateIsOverridable.DateFound", Substitutions.Field);
	Text = StrReplace(Text, "LEFT JOIN CalculationOfAddingDateIsOverridable ON TRUE", Substitutions.Joins);
	Texts.Add(Text);
	
	Text =
		"SELECT
		|	Table.SupplyMethod AS SupplyMethod,
		|	Table.DateOfShipment AS DateOfShipment,
		|	Table.ShipmentDate AS ShipmentDate,
		|	CalculationOfAddingDateIsOverridable.DateFound AS OrderDate
		|INTO DeliveryDatesAndOrderDates
		|FROM
		|	DeliveryDatesIncludingWorkdays AS Table
		|		
		|		LEFT JOIN CalculationOfAddingDateIsOverridable ON TRUE
		|INDEX BY
		|	SupplyMethod, DateOfShipment";
		
	Substitutions = ProvisionInDocumentsServer.AddToDateAccordingToEnterpriseCalendar(
		"Table.ShipmentDate", "-Table.SupplyMethod.OrderFulfillmentPeriod");
	
	Text = StrReplace(Text, "CalculationOfAddingDateIsOverridable.DateFound", Substitutions.Field);
	Text = StrReplace(Text, "LEFT JOIN CalculationOfAddingDateIsOverridable ON TRUE", Substitutions.Joins);
	Texts.Add(Text);
	
	Query.Text = StrConcat(Texts, Common.QueryBatchSeparator());
	Query.Execute();
	
	QueriesTexts = New Array();
	
	QueriesTexts.Add(TemporaryTableOrderFillingDataForSupplier());
	QueriesTexts.Add(TemporaryTableBanningPurchasesByAssortment(UseProductRange, False));
	Text =
		"SELECT DISTINCT
		|	Table.Products AS Products,
		|	Table.Characteristic AS Characteristic,
		|	Table.Warehouse AS Warehouse
		|INTO WarehousesIncludedInDistributionNetworks
		|FROM
		|	WarehouseTopology AS Table
		|WHERE
		|	Table.Warehouse <> Table.Center
		|INDEX BY
		|	Products,Characteristic,Warehouse";
	
	QueriesTexts.Add(Text);
	
	Text =
		"SELECT
		|	T.Products                                   AS Products,
		|	T.Characteristic                                 AS Characteristic,
		|	T.Warehouse                                          AS Warehouse,
		|	NOT WarehousesIncludedInDistributionNetworks.Warehouse IS NULL AS SuppliedFromDistributionCenter,
		|	T.OrderShipmentWarehouse                            AS OrderShipmentWarehouse,
		|	T.OrderShipmentDate                             AS OrderShipmentDate,
		|	T.Products.Description                      AS NomenclatureName,
		|	T.Characteristic.Description                    AS CharacteristicName,
		|	T.Warehouse.Description                             AS WarehouseName,
		|	T.Purpose.Description                        AS PurposeName,
		|
		|	T.ReceivingBusinessUnit                        AS ReceivingBusinessUnit,
		|	T.Purpose                                     AS Purpose,
		|	T.OrderDocument                                          AS OrderDocument,
		|	ReportOrders.Priority                          AS Priority,
		|	ISNULL(ReportOrders.Priority.AddlOrderingAttribute,
		|		0)                                           AS PriorityOfOrderingProps,
		|	T.DateOfShipment                                   AS DateOfShipment,
		|	T.NotSupplied + T.DistributedInWarehouse + T.DistributedFromOrders AS Required2,
		|	CASE
		|		WHEN WarehouseTopologyThisIsCenter.Warehouse IS NULL
		|			THEN T.DistributedInWarehouse + T.DistributedFromOrders
		|		ELSE T.DistributedInWarehouse
		|	END AS ToReserve,
		|	
		|	CASE
		|		WHEN NOT OrderingByDocumentDate.Value IS NULL
		|			THEN UNDEFINED
		|		WHEN T.DateOfShipment > &EndOfCurrentDay
		|			THEN T.DateOfShipment
		|		WHEN &CheckingStageTakingIntoAccountOverridableRights
		|			THEN &DateOfProductionOrderTakingIntoAccountRightsOverridable
		|		WHEN TRUE
		|			THEN ReportOrders.IBDocumentDate
		|	END SortingOrder,
		|	CASE
		|		WHEN &CheckingStageTakingIntoAccountOverridableRights
		|			THEN &DateOfProductionOrderTakingIntoAccountRightsOverridable
		|		WHEN TRUE
		|			THEN ReportOrders.IBDocumentDate
		|	END AS IBDocumentDate,
		|	CASE
		|		WHEN T.DateOfShipment > &EndOfCurrentDay
		|			THEN T.DateOfShipment
		|		WHEN &CheckingStageTakingIntoAccountOverridableRights
		|			THEN &DateOfProductionOrderTakingIntoAccountRightsOverridable
		|		WHEN TRUE
		|			THEN ReportOrders.IBDocumentDate
		|	END AS OrderByShipmentDateAfterDocumentDate,
		|	CASE WHEN T.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		|		 AND ProductRestrictions.InventoryReplenishmentMethod <> VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)
		|		 AND ProductRestrictions.OrderFulfillmentWithinInventoryReplenishment = VALUE(Enum.OrderFulfillmentWithinInventoryReplenishment.SupplyRegardlessOfInventoryLevelControl) THEN
		|				TRUE
		|			ELSE
		|				FALSE
		|		END AS SupplyRegardlessOfStockLevel,
		|	
		// The item parameter
		|	&QueryTextItemWeight                        AS Weight,
		|	T.Products.UnitOfMeasure                     AS UnitOfMeasure,
		|	T.Products.UnitOfMeasure.MeasuredValueType AS UnitOfMeasureType,
		|	T.Products.Code                                  AS Code,
		|	T.Products.SKU                              AS SKU,
		|	T.Products.UsePackages                 AS UsePackages,
		|
		|	CASE WHEN T.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5) THEN
		|				TRUE
		|			ELSE
		|				FALSE
		|		END AS ThisIsWork,
		|
		// A way of ensuring
		|	ISNULL(T.SupplyMethod, VALUE(Catalog.ProcurementStrategies.EmptyRef)) AS SupplyMethod,
		|	ISNULL(T.SupplyMethod.SupplyType,
		|		VALUE(Enum.SupplyTypes.Purchase)) AS SupplyType,
		|	CASE
		|		WHEN &GeneratePurchaseRequests
		|			AND ISNULL(T.SupplyMethod.EmployeeResponsible,
		|				VALUE(Catalog.Users.EmptyRef)) = VALUE(Catalog.Users.EmptyRef)
		|			THEN &CurrentUser
		|		ELSE ISNULL(T.SupplyMethod.EmployeeResponsible,
		|				VALUE(Catalog.Users.EmptyRef))
		|	END AS Manager,
		|	TableOfSecurityMethods.DemandConversionOption AS DemandConversionOption,
		|	CASE
		|		WHEN NOT OrderingByDocumentDate.Value IS NULL
		|			THEN TableOfSecurityMethods.ShipmentDate
		|		WHEN &DateOfShipmentTakingIntoAccountQualityControlPeriod <= TableOfSecurityMethods.ShipmentDate
		|				AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|			THEN TableOfSecurityMethods.ShipmentDate
		|		WHEN NOT TableOfSecurityMethods.GenerateOrdersOnSchedule
		|			AND TableOfDeliveryDatesAndOrderDates.ShipmentDate = DATETIME(1, 1, 1)
		|			AND &DateOfShipmentTakingIntoAccountQualityControlPeriod = DATETIME(1, 1, 1)
		|				THEN &CurrentDayStart
		|		WHEN TableOfDeliveryDatesAndOrderDates.ShipmentDate < &CurrentDayStart
		|			THEN DATETIME(1, 1, 1)
		|		WHEN TableOfSecurityMethods.GenerateOrdersOnSchedule
		|				AND TableOfDeliveryDatesAndOrderDates.ShipmentDate < TableOfSecurityMethods.ShipmentDate
		|			THEN TableOfSecurityMethods.ShipmentDate
		|		ELSE TableOfDeliveryDatesAndOrderDates.ShipmentDate
		|	END AS ShipmentDate,
		|	CASE
		|		WHEN NOT OrderingByDocumentDate.Value IS NULL
		|			THEN TableOfSecurityMethods.ShipmentDate
		|		WHEN &DateOfShipmentTakingIntoAccountQualityControlPeriod <= TableOfSecurityMethods.ShipmentDate
		|				AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|			THEN TableOfSecurityMethods.ShipmentDate
		|		WHEN NOT TableOfSecurityMethods.GenerateOrdersOnSchedule
		|			AND TableOfDeliveryDatesAndOrderDates.ShipmentDate = DATETIME(1, 1, 1)
		|			AND &DateOfShipmentTakingIntoAccountQualityControlPeriod = DATETIME(1, 1, 1)
		|				THEN &CurrentDayStart
		|		WHEN TableOfDeliveryDatesAndOrderDates.ShipmentDate < &CurrentDayStart
		|			THEN DATETIME(1, 1, 1)
		|		WHEN TableOfSecurityMethods.GenerateOrdersOnSchedule
		|				AND TableOfDeliveryDatesAndOrderDates.ShipmentDate < TableOfSecurityMethods.ShipmentDate
		|			THEN TableOfSecurityMethods.ShipmentDate
		|		ELSE TableOfDeliveryDatesAndOrderDates.ShipmentDate
		|	END AS EstimatedDeliveryDate,
		|	TableOfSecurityMethods.ShipmentDate AS DeliveryDateByProcurementStrategy,
		|	CASE
		|		WHEN NOT OrderingByDocumentDate.Value IS NULL
		|				OR &DateOfShipmentTakingIntoAccountQualityControlPeriod <= TableOfSecurityMethods.ShipmentDate
		|					AND TableOfSecurityMethods.ShipmentDate > DATETIME(1, 1, 1)
		|				OR TableOfDeliveryDatesAndOrderDates.ShipmentDate < &CurrentDayStart
		|				OR TableOfDeliveryDatesAndOrderDates.OrderDate < &CurrentDayStart
		|			THEN &CurrentDayStart
		|		ELSE TableOfDeliveryDatesAndOrderDates.OrderDate
		|	END AS OrderDateNoLaterThan,
		|	
		|	ISNULL(&FOMovementOrdersEnabled AND NOT T.Warehouse.ShopFloorStockroom
		|		OR &FOProduction2_2Enabled AND T.Warehouse.ShopFloorStockroom, FALSE) AS TransferIsAllowed,
		|
		// Terms of purchase
		|	ISNULL(FillingData.VendorPriceKind,
		|		CASE
		|			WHEN ISNULL(T.SupplyMethod.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|					<> VALUE(Catalog.VendorPriceTypes.EmptyRef)
		|				THEN T.SupplyMethod.VendorPriceKind
		|			ELSE ISNULL(T.SupplyMethod.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|		END) AS PriceKind,
		|	ISNULL(FillingData.Currency, T.SupplyMethod.Terms.Currency)            AS AgreementCurrency,
		|
		|	CASE WHEN NOT ISNULL(FillingData.Terms.PriceIncludesVAT, T.SupplyMethod.Terms.PriceIncludesVAT) THEN
		|		(CASE
		|			WHEN NOT (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|				THEN (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|			WHEN NOT (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|				THEN (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|			ELSE 0
		|		END + 100) / 100
		|			ELSE
		|				1
		|		END
		|	* SupplierPrices.Price
		|		* CASE
		|			WHEN ExchangeRateAgreementCurrency.ZoomRatio =0
		|				THEN 0
		|			ELSE ExchangeRates.ZoomRatio / ExchangeRateAgreementCurrency.ZoomRatio
		|		END
		|	/ ISNULL(&QueryTextPackagingFactor, 1)                                          AS PriceInTheCurrencyOfAgreement,
		|
		|	CASE WHEN NOT ISNULL(FillingData.Terms.PriceIncludesVAT, T.SupplyMethod.Terms.PriceIncludesVAT) THEN
		|		(CASE
		|			WHEN NOT (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|				THEN (ISNULL(VATRatesForProductsOfCountryOfRegistration.VATRate, ISNULL(BasicVATRatesOfCountryOfRegistration.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|			WHEN NOT (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 IS NULL
		|				THEN (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
		|			ELSE 0
		|		END + 100) / 100
		|			ELSE
		|				1
		|		END
		|	* SupplierPrices.Price * ExchangeRates.ZoomRatio / &CurrencyCoefficientOfManAccounting
		|	/ ISNULL(&QueryTextPackagingFactor, 1)                                AS PriceInTheCurrencyOfManagementAccounting,
		|
		|	CASE WHEN T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.AssemblyDisassembly) THEN
		|			TRUE
		|		ELSE
		|			CASE ISNULL(T.SupplyMethod.SourceOfDemandSupply, UNDEFINED)
		|					WHEN UNDEFINED THEN
		|						FALSE
		|					WHEN VALUE(Catalog.Warehouses.EmptyRef) THEN
		|						FALSE
		|					WHEN VALUE(Catalog.Partners.EmptyRef) THEN
		|						FALSE
		|					WHEN VALUE(Catalog.BusinessStructure.EmptyRef) THEN
		|						FALSE
		|					ELSE
		|						TRUE //the source of the provision is set in the method of providing the needs
		|				END
		|		END                                                                      AS SupplySourceViewOnly,
		|	ISNULL(FillingData.Partner,
		|		T.SupplyMethod.SourceOfDemandSupply)        AS SupplySource,
		|	CASE WHEN T.SupplyMethod.Terms <> VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef) THEN
		|				T.SupplyMethod.Terms
		|			ELSE
		|				FillingData.Terms
		|		END                                                       AS Terms,
		|	CatPackages.Ref                                              AS OrderPackage,
		|	
		|	ISNULL(CatPackages.Numerator, 1)                   AS PackageNumerator,
		|	ISNULL(CatPackages.Denominator, 1)                 AS PackageDenominator,
		|	
		|	SupplierPrices.SupplierOrderPackaging AS SupplierOrderPackaging,
		|	SupplierPrices.MinimumDeliveryLot AS MinimumDeliveryLot,
		|	CASE WHEN T.SupplyMethod.Terms <> VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef) THEN
		|				ISNULL(T.SupplyMethod.Terms.MinimumOrderAmount,0)
		|			ELSE
		|				ISNULL(FillingData.Terms.MinimumOrderAmount,0)
		|		END                                                       AS MinimumOrderAmount
		|FROM
		|	TTProducts_1 AS T
		|		
		|		INNER JOIN NextCycleBySupplyMethods AS TableOfSecurityMethods
		|		ON T.SupplyMethod = TableOfSecurityMethods.Ref
		|		
		|		LEFT JOIN DeliveryDatesAndOrderDates AS TableOfDeliveryDatesAndOrderDates
		|		ON TableOfDeliveryDatesAndOrderDates.SupplyMethod = T.SupplyMethod
		|		 AND TableOfDeliveryDatesAndOrderDates.DateOfShipment = &DateOfShipmentTakingIntoAccountQualityControlPeriod
		|		
		|		LEFT JOIN WarehousesIncludedInDistributionNetworks AS WarehousesIncludedInDistributionNetworks
		|		ON WarehousesIncludedInDistributionNetworks.Products = T.Products
		|		 AND WarehousesIncludedInDistributionNetworks.Characteristic = T.Characteristic
		|		 AND WarehousesIncludedInDistributionNetworks.Warehouse = T.Warehouse
		|		
		|		LEFT JOIN WarehouseTopology AS WarehouseTopologyThisIsCenter
		|		ON WarehouseTopologyThisIsCenter.Products   = T.Products
		|		 AND WarehouseTopologyThisIsCenter.Characteristic = T.Characteristic
		|		 AND WarehouseTopologyThisIsCenter.Warehouse = T.Warehouse
		|		 AND WarehouseTopologyThisIsCenter.Center = T.Warehouse
		|		
		|		LEFT JOIN TTOrderFillingDataToSupplier AS FillingData
		|		ON T.Products    = FillingData.Products
		|		 AND T.Characteristic  = FillingData.Characteristic
		|		 AND T.Warehouse           = FillingData.Warehouse
		|		 AND ISNULL(T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Purchase), TRUE)
		|		 AND T.SupplyMethod.SourceOfDemandSupply.Ref IS NULL
		|		
		|		LEFT JOIN SupplierPrices AS SupplierPrices
		|		ON T.Products       = SupplierPrices.Products
		|			AND T.Characteristic  = SupplierPrices.Characteristic
		|			AND ISNULL(FillingData.VendorPriceKind,
		|				CASE
		|					WHEN ISNULL(T.SupplyMethod.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|							<> VALUE(Catalog.VendorPriceTypes.EmptyRef)
		|						THEN T.SupplyMethod.VendorPriceKind
		|					ELSE ISNULL(T.SupplyMethod.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
		|				END) = SupplierPrices.VendorPriceKind
		|
		|		LEFT JOIN ExchangeRates AS ExchangeRates
		|		ON SupplierPrices.Currency = ExchangeRates.Currency
		|
		|		LEFT JOIN ExchangeRates AS ExchangeRateAgreementCurrency
		|		ON ISNULL(FillingData.Currency, T.SupplyMethod.Terms.Currency) = ExchangeRateAgreementCurrency.Currency
		|
		|		LEFT JOIN Document.ProductionStage2_2 AS DocumentStage
		|		ON DocumentStage.Ref = T.OrderDocument
		|
		|		LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
		|		ON &SubstituteGoodsRestriction
		|
		|		LEFT JOIN InformationRegister.ProductRestrictions AS OrderPackaging
		|		ON &SubstitutionOfOrderPackaging
		|
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS CatPackages
		|		ON OrderPackaging.OrderPackage = CatPackages.Ref
		|
		|		LEFT JOIN InformationRegister.DocumentsRegistry AS ReportOrders
		|		ON ReportOrders.Ref = T.OrderDocument
		|		 AND NOT ReportOrders.AdditionalRecord
		|		
		|		LEFT JOIN Constant.OptionOfOrderingDemandsByOrdersForSupply AS OrderingByDocumentDate
		|		ON OrderingByDocumentDate.Value = VALUE(Enum.OptionsOfOrderingDemandsByOrdersForSupply.PriorityAndDocumentDate)
		|		
		|		LEFT JOIN ProhibitionOfPurchasingByAssortment AS ProhibitionOfPurchasingByAssortment
		|		ON ProhibitionOfPurchasingByAssortment.Warehouse = T.Warehouse
		|		 AND ProhibitionOfPurchasingByAssortment.Products = T.Products
		|		 AND ProhibitionOfPurchasingByAssortment.PossibleDeliveryDate = ISNULL(TableOfSecurityMethods.ShipmentDate, &CurrentDayStart)
		|		
		|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&CurrentDayStart) AS VATRatesForProductsOfCountryOfRegistration
		|		ON T.Products = VATRatesForProductsOfCountryOfRegistration.Products
		|		 AND T.SupplyMethod.Organization.RegistrationCountry = VATRatesForProductsOfCountryOfRegistration.Country
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&CurrentDayStart) AS BasicVATRatesOfCountryOfRegistration
		|		ON T.SupplyMethod.Organization.RegistrationCountry = BasicVATRatesOfCountryOfRegistration.Country
		|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&CurrentDayStart, Country = &MainCountry OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS ProductsVATRates
		|		ON T.Products = ProductsVATRates.Products
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&CurrentDayStart, Country = &MainCountry) AS BasicVATRates
		|		ON (TRUE)
		|		LEFT JOIN Document.ProductionOrder2_2 AS ProductionOrderForSorting
		|		ON ProductionOrderForSorting.Ref = T.OrderDocument
		|
		|WHERE
		|	CASE
		|		WHEN T.SupplyMethod.SupplyType = VALUE(Enum.SupplyTypes.Move)
		|			THEN
		|				ISNULL(&FOMovementOrdersEnabled AND NOT T.Warehouse.ShopFloorStockroom
		|							OR &FOProduction2_2Enabled AND T.Warehouse.ShopFloorStockroom, FALSE)
		|		ELSE TRUE
		|	END
		|		AND ProhibitionOfPurchasingByAssortment.Warehouse IS NULL
		|
		|ORDER BY
		|	NomenclatureName,
		|	CharacteristicName,
		|	WarehouseName,
		|	PurposeName,
		|	Products,
		|	Characteristic,
		|	Warehouse,
		|	Purpose,
		|	PriorityOfOrderingProps,
		|	CASE WHEN NOT VALUETYPE(T.OrderDocument) = TYPE(Document.ProductionOrder2_2) THEN
		|		0
		|	ELSE
		|		1
		|	END,
		|	CASE WHEN NOT VALUETYPE(T.OrderDocument) = TYPE(Document.ProductionOrder2_2) THEN
		|		0
		|	ELSE
		|		ProductionOrderForSorting.Department.AddlOrderingAttribute
		|	END,
		|	CASE WHEN NOT VALUETYPE(T.OrderDocument) = TYPE(Document.ProductionOrder2_2) THEN
		|		0
		|	ELSE
		|		ProductionOrderForSorting.Queue
		|	END,
		|	SortingOrder,
		|	IBDocumentDate,
		|	OrderByShipmentDateAfterDocumentDate,
		|	OrderDocument";
	
	If UseQualityControl Then
		
		Text = StrReplace(Text, "TTProducts_1", "TTGoodsSubjectToQualityControl");
		Text = StrReplace(Text, "&DateOfShipmentTakingIntoAccountQualityControlPeriod", "T.DateOfShipmentMinusQualityControlPeriod");
		
	Else
		
		Text = StrReplace(Text, "&DateOfShipmentTakingIntoAccountQualityControlPeriod", "T.DateOfShipment");
		
	EndIf;
	
	Text = InformationRegisters.ProductRestrictions.SubstituteConnection(Text,
		"SubstituteGoodsRestriction");
	Text = InformationRegisters.ProductRestrictions.SubstituteConnectionForOrderPackaging(Text,
		"SubstitutionOfOrderPackaging");
	Text = StrReplace(Text, "&QueryTextItemWeight",
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight(
			"T.Products.UnitOfMeasure",
			"T.Products"));
	
	Text = StrReplace(Text, "&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"SupplierPrices.Package",
			"SupplierPrices.Products"));
	
	CheckingTextStage = "FALSE";
	ProductionOrderDateText = "DATETIME(1, 1, 1)";
	If AccessRight("Read", Metadata.Documents.ProductionStage2_2)
			And AccessRight("Read", Metadata.Documents.ProductionOrder2_2)
			And Not Parameters.FilterType = "FilterByValues" Then
				
				CheckingTextStage = "VALUETYPE(T.OrderDocument) = TYPE(Document.ProductionStage2_2)";
				ProductionOrderDateText = "CAST(T.OrderDocument AS Document.ProductionStage2_2).ReferenceOrder.Date";
				
	EndIf;
	Text = StrReplace(Text, "&CheckingStageTakingIntoAccountOverridableRights", CheckingTextStage);
	Text = StrReplace(Text, "&DateOfProductionOrderTakingIntoAccountRightsOverridable", ProductionOrderDateText);
	
	QueriesTexts.Add(Text);
	Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	Query.SetParameter("BeginOfPeriod", BegOfDay);
	Query.SetParameter("MainCountry", SettingsValueClientServerCached.MainCountry());
	Query.SetParameter("EndOfCurrentDay", EndOfDay(CurrentSessionDate()));
	Query.SetParameter("GeneratePurchaseRequests", Parameters.GeneratePurchaseRequests);
	Query.SetParameter("CurrentUser", Users.CurrentUser());
	
	CurrencyExchangeRateManAccounting = ProcessingOfExchangeRatesTM.GetCurrencyRate(Constants.ManagementAccountingCurrency.Get(), BegOfDay);
	CurrencyCoefficientOfManAccounting = CurrencyExchangeRateManAccounting.CourseNumerator / CurrencyExchangeRateManAccounting.CourseDenominator;
	Query.SetParameter("CurrencyCoefficientOfManAccounting", CurrencyCoefficientOfManAccounting);
	Query.SetParameter("FOMovementOrdersEnabled",
		GetFunctionalOption("UseTransferOrders"));
	Query.SetParameter("FOProduction2_2Enabled",
		GetFunctionalOption("UseProductionManagement2_2"));
	
	QueryResult = Query.Execute();
	Table = QueryResult.Unload();
	
	If Parameters.FilterType = "FilterByValues" Then
		Table.Columns.Delete("SuppliedFromDistributionCenter");
	EndIf;
	
	If Parameters.FilterType <> "FilterByValues" Then
		
		Fields = "Products,Characteristic,Warehouse,ToOrder";
		TableInventory = Parameters.TableInventory.Copy(New Structure("Mark", True), Fields);
		Query.SetParameter("TableInventory", TableInventory);
	
		QueriesTexts = New Array();
		
		Text =
			"SELECT
			|	Inventories.Products   AS Products,
			|	Inventories.Characteristic AS Characteristic,
			|	Inventories.Warehouse          AS Warehouse,
			|	Inventories.ToOrder        AS ToOrder
			|INTO TTStocks
			|FROM
			|	&TableInventory AS Inventories
			|WHERE
			|	Inventories.ToOrder > 0";
			
		QueriesTexts.Add(Text);
		
		QueriesTexts.Add(InformationRegisters.SupplySchemes.TemporaryTableOfVariousGoodsAndWarehouses("GoodsAndWarehousesProcessed", True));
		QueriesTexts.Add(TempTableOfMovementWithinNetwork("VariousGoodsAndWarehouses", True));
		QueriesTexts.Add(TemporaryTableFreeBalances(True));
		
		QueriesTexts.Add(TimeTableProductionSchedule("GoodsAndWarehousesProcessed"));
		QueriesTexts.Add(TemporaryTableSemiFinishedProductsForCommissioning("GoodsAndWarehousesProcessed"));
		
		Text =
			"SELECT
			|	Goods.Products AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	
			|	CASE
			|		WHEN VALUETYPE(Goods.Warehouse) = TYPE(Catalog.Warehouses)
			|			THEN Goods.Warehouse
			|		ELSE VALUE(Catalog.Warehouses.EmptyRef)
			|	END AS Warehouse,
			|	
			|	CASE
			|		WHEN VALUETYPE(Goods.Warehouse) = TYPE(Catalog.BusinessStructure)
			|			THEN Goods.Warehouse
			|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
			|	END AS ReceivingBusinessUnit,
			|	
			|	Goods.Purpose AS Purpose,
			|	
			|	CASE
			|		WHEN SettingUpStockMaintenance.OrderFulfillmentWithinInventoryReplenishment IS NULL
			|				OR SettingUpStockMaintenance.OrderFulfillmentWithinInventoryReplenishment
			|					= VALUE(Enum.OrderFulfillmentWithinInventoryReplenishment.SupplyFromStock)
			|			THEN ISNULL(Inventories.ToOrder, 0)
			|		ELSE 0
			|	END
			|		+ ISNULL(ProductionSchedule.Count, 0)
			|		+ ISNULL(TurnoverOfSemiFinishedProducts.Count, 0)
			|		+ ISNULL(Balance.DistributeToOrders, 0) AS ToReserve
			|FROM
			|	GoodsAndWarehousesProcessed AS Goods
			|		
			|		LEFT JOIN TTFreeBalances AS Balance
			|		ON Balance.Products = Goods.Products
			|		 AND Balance.Characteristic = Goods.Characteristic
			|		 AND Balance.Warehouse = Goods.Warehouse
			|		 AND Balance.Purpose = Goods.Purpose
			|		
			|		LEFT JOIN TTStocks AS Inventories
			|		ON Inventories.Products = Goods.Products
			|		 AND Inventories.Characteristic = Goods.Characteristic
			|		 AND Inventories.Warehouse = Goods.Warehouse
			|		 AND Goods.Purpose = VALUE(Catalog.Assignments.EmptyRef)
			|		
			
			|		LEFT JOIN ProductionSchedule AS ProductionSchedule
			|		ON ProductionSchedule.Products = Goods.Products
			|		 AND ProductionSchedule.Characteristic = Goods.Characteristic
			|		 AND ProductionSchedule.Warehouse = Goods.Warehouse
			|		 AND ProductionSchedule.Purpose = Goods.Purpose
			|
			|		LEFT JOIN TurnoverOfSemiFinishedProducts AS TurnoverOfSemiFinishedProducts
			|		ON TurnoverOfSemiFinishedProducts.Products = Goods.Products
			|		 AND TurnoverOfSemiFinishedProducts.Characteristic = Goods.Characteristic
			|		 AND TurnoverOfSemiFinishedProducts.Warehouse = Goods.Warehouse
			|		 AND TurnoverOfSemiFinishedProducts.Purpose = Goods.Purpose
			
			|		
			|		LEFT JOIN InformationRegister.ProductRestrictions AS SettingUpStockMaintenance
			|		ON &SubstituteGoodsRestriction";
		QueriesTexts.Add(Text);
		
		Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
		Query.Text = InformationRegisters.ProductRestrictions.SubstituteConnection(Query.Text, "SubstituteGoodsRestriction", 
			"Goods.Products,Goods.Characteristic,Goods.Warehouse", "SettingUpStockMaintenance");
		
		QueryResult = Query.Execute();
		TableBalance = QueryResult.Unload();
		TableBalance.Indexes.Add("Products, Characteristic, Warehouse, ReceivingBusinessUnit, Purpose");
		
		TableOfBalancesInAllWarehouses = New ValueTable();
		TableOfBalancesInAllWarehouses.Columns.Add("Products");
		TableOfBalancesInAllWarehouses.Columns.Add("Characteristic");
		TableOfBalancesInAllWarehouses.Columns.Add("Purpose");
		TableOfBalancesInAllWarehouses.Columns.Add("ToReserve");
		
		If GetFunctionalOption("UseManageTransferOfGoodsAssigned")
				And Parameters.CalculationOfSeparateNeedsTakingIntoAccountBalancesInAllWarehouses Then
			
			SetPrivilegedMode(True);
			
			Texts = New Array();
			
			QueryText =
				"SELECT DISTINCT
				|	Filter.Products AS Products,
				|	Filter.Characteristic AS Characteristic,
				|	Filter.Purpose AS Purpose
				|INTO FilterOfProducts_
				|FROM
				|	VariousGoodsAndWarehouses AS Filter
				|WHERE
				|	Filter.Purpose <> VALUE(Catalog.Assignments.EmptyRef)
				|INDEX BY
				|	Products, Characteristic, Purpose
				|;
				|
				|//////////////////////////////////////////////////
				|SELECT
				|	Inventories.Products AS Products,
				|	Inventories.Characteristic AS Characteristic,
				|	UNDEFINED AS Warehouse,
				|	Inventories.Purpose AS Purpose,
				|	Inventories.InStockBalance AS InStockBalance,
				|	Inventories.LockedInStockBalance AS LockedInStockBalance,
				|	Inventories.OrderedBalance AS OrderedBalance,
				|	Inventories.Received_1Balance AS Received_1Balance,
				|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
				|	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
				|	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
				|	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
				|	Inventories.ToSupplyBalance AS ToSupplyBalance,
				|	Inventories.NotProvideBalance AS NotProvideBalance
				|INTO InventoryAndDemandsBalance
				|FROM
				|	AccumulationRegister.InventoryAndDemands.Balance(,
				|		(Products, Characteristic, Purpose) IN(
				|			SELECT
				|				Filter.Products AS Products,
				|				Filter.Characteristic AS Characteristic,
				|				Filter.Purpose AS Purpose
				|			FROM
				|				FilterOfProducts_ AS Filter)) AS Inventories
				|INDEX BY
				|	Products, Characteristic, Warehouse, Purpose
				|;
				|
				|//////////////////////////////////////////////////////
				|SELECT
				|	Inventories.Products AS Products,
				|	Inventories.Characteristic AS Characteristic,
				|	UNDEFINED AS Warehouse,
				|	Inventories.Purpose AS Purpose,
				|	Inventories.OrderDocument AS OrderDocument,
				|	Inventories.LockedInStockBalance AS LockedInStockBalance,
				|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
				|	Inventories.ToUnlockBalance AS ToUnlockBalance,
				|	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
				|	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
				|	
				|INTO InventoryAndNeedsBalanceOfControlledLotsReference
				|FROM
				|	AccumulationRegister.InventoryAndDemands.Balance(,
				|		(Products, Characteristic, Purpose) IN(
				|			SELECT
				|				Filter.Products AS Products,
				|				Filter.Characteristic AS Characteristic,
				|				Filter.Purpose AS Purpose
				|			FROM
				|				FilterOfProducts_ AS Filter)) AS Inventories
				|INDEX BY
				|	Products, Characteristic, Warehouse, Purpose
				|;
				|
				|//////////////////////////////////////////////////////
				|SELECT
				|	Calculation.Products AS Products,
				|	Calculation.Characteristic AS Characteristic,
				|	Calculation.Purpose AS Purpose,
				|	Calculation.Available_Surplus
				|		+ Calculation.Available_Reserve
				|		+ Calculation.Available_ReserveAsNeeded
				|		+ Calculation.Available_Postpone
				|		+ Calculation.InStock_K
				|		+ Calculation.AvailableWithLock_Surplus
				|		+ Calculation.AvailableWithLock_ReserveAsNeeded
				|		+ Calculation.AvailableWithLock_Postpone
				|		+ Calculation.AvailableWithLock_CSupply
				|		+ Calculation.Expected_
				|		+ Calculation.ExpectedWithLock_Surplus
				|		+ Calculation.ExpectedWithLock_ReserveAsNeeded
				|		+ Calculation.PendingWithLock_Postpone
				|		+ Calculation.ExpectedWith_KLock
				|		+ Calculation.AwaitingApproval AS Inventory,
				|	Calculation.ToReserve_
				|		+ Calculation.ToReserveAsNeeded
				|		+ Calculation.ToSupply AS Demand
				|INTO InventoryAndDemands
				|FROM
				|	CalculationOfInventoryDistribution AS Calculation
				|;
				|
				|////////////////////////////////////
				|DROP InventoryAndDemandsBalance
				|;
				|
				|////////////////////////////////////
				|DROP InventoryAndNeedsBalanceOfControlledLotsReference";
				
			TablesNames = ProvisionInDocumentsServer.NewTableNamesForInventoryAllocation();
			TablesNames.Balance = "InventoryAndDemandsBalance"; // @query-part-1
			TablesNames.BalanceSheetsOfControlledLotREFERENCES = "InventoryAndNeedsBalanceOfControlledLotsReference"; // @query-part-1
			TablesNames.Result = "CalculationOfInventoryDistribution"; // @query-part-1
			
			ProvisionInDocumentsServer.InventoryAllocation(QueryText, TablesNames);
			
			Texts.Add(QueryText);
			
			QueryText =
				"SELECT
				|	Inventories.Products AS Products,
				|	Inventories.Characteristic AS Characteristic,
				|	Inventories.Warehouse AS Warehouse,
				|	Inventories.Purpose AS Purpose,
				|	Inventories.InStockBalance AS InStockBalance,
				|	Inventories.LockedInStockBalance AS LockedInStockBalance,
				|	Inventories.OrderedBalance AS OrderedBalance,
				|	Inventories.Received_1Balance AS Received_1Balance,
				|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
				|	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
				|	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
				|	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
				|	Inventories.ToSupplyBalance AS ToSupplyBalance,
				|	Inventories.NotProvideBalance AS NotProvideBalance
				|INTO InventoryAndDemandsBalance
				|FROM
				|	AccumulationRegister.InventoryAndDemands.Balance(,
				|		(Products, Characteristic, Warehouse, Purpose) IN(
				|			SELECT
				|				Filter.Products AS Products,
				|				Filter.Characteristic AS Characteristic,
				|				Filter.Warehouse AS Warehouse,
				|				Filter.Purpose AS Purpose
				|			FROM
				|				VariousGoodsAndWarehouses AS Filter
				|			WHERE
				|				Filter.Purpose <> VALUE(Catalog.Assignments.EmptyRef))) AS Inventories
				|INDEX BY
				|	Products, Characteristic, Warehouse, Purpose
				|;
				|
				|//////////////////////////////////////////////////////
				|SELECT
				|	Inventories.Products AS Products,
				|	Inventories.Characteristic AS Characteristic,
				|	Inventories.Warehouse AS Warehouse,
				|	Inventories.Purpose AS Purpose,
				|	Inventories.OrderDocument AS OrderDocument,
				|	Inventories.LockedInStockBalance AS LockedInStockBalance,
				|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
				|	Inventories.ToUnlockBalance AS ToUnlockBalance,
				|	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
				|	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
				|	
				|INTO InventoryAndNeedsBalanceOfControlledLotsReference
				|FROM
				|	AccumulationRegister.InventoryAndDemands.Balance(,
				|		(Products, Characteristic, Warehouse, Purpose) IN(
				|			SELECT
				|				Filter.Products AS Products,
				|				Filter.Characteristic AS Characteristic,
				|				Filter.Warehouse AS Warehouse,
				|				Filter.Purpose AS Purpose
				|			FROM
				|				VariousGoodsAndWarehouses AS Filter
				|			WHERE
				|				Filter.Purpose <> VALUE(Catalog.Assignments.EmptyRef))) AS Inventories
				|INDEX BY
				|	Products, Characteristic, Warehouse, Purpose
				|;
				|
				|//////////////////////////////////////////////////////
				|SELECT
				|	Calculation.Products AS Products,
				|	Calculation.Characteristic AS Characteristic,
				|	Calculation.Warehouse AS Warehouse,
				|	Calculation.Purpose AS Purpose,
				|	Calculation.ToReserve_ AS ReserveAtWarehouse,
				|	Calculation.ToReserve_
				|		+ Calculation.ToReserveAsNeeded
				|		+ Calculation.ToSupply AS Demand
				|INTO NeedsThatHaveBeenProcessed
				|FROM
				|	CalculationOfInventoryDistribution AS Calculation
				|
				|INDEX BY
				|	Products, Characteristic, Purpose, Warehouse
				|;
				|
				|/////////////////////////////////////////////////////
				|DROP InventoryAndDemandsBalance
				|;
				|
				|/////////////////////////////////////////////////////
				|DROP InventoryAndNeedsBalanceOfControlledLotsReference";
				
			TablesNames = ProvisionInDocumentsServer.NewTableNamesForInventoryAllocation();
			TablesNames.Balance = "InventoryAndDemandsBalance"; // @query-part-1
			TablesNames.BalanceSheetsOfControlledLotREFERENCES = "InventoryAndNeedsBalanceOfControlledLotsReference"; // @query-part-1
			TablesNames.ReversingEntry = "MovementsWithinNetwork"; // @query-part-1
			TablesNames.Result = "CalculationOfInventoryDistribution"; // @query-part-1
			
			ProvisionInDocumentsServer.InventoryAllocation(QueryText, TablesNames);
			
			Texts.Add(QueryText);
			QueryText =
				"SELECT
				|	Set.Products AS Products,
				|	Set.Characteristic AS Characteristic,
				|	Set.Warehouse AS Warehouse,
				|	Set.Purpose AS Purpose,
				|	SUM(Set.Inventory) AS Inventory,
				|	SUM(Set.Demand) AS Demand
				|INTO InventoryAndNeedsAreDynamic
				|FROM(
				|	SELECT
				|		RegisterRecords.Products AS Products,
				|		RegisterRecords.Characteristic AS Characteristic,
				|		RegisterRecords.Warehouse AS Warehouse,
				|		RegisterRecords.Purpose AS Purpose,
				|		RegisterRecords.Scheduled AS Inventory,
				|		0 AS Demand
				|	FROM
				|		InformationRegister.OrderStructure AS RegisterRecords
				|	WHERE
				|		RegisterRecords.LineKind <> VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts)
				|			AND TRUE IN(
				|				SELECT TOP 1
				|					TRUE AS ThereAreRecords
				|				FROM
				|					VariousGoodsAndWarehouses AS Filter
				|				WHERE
				|					Filter.Products = RegisterRecords.Products
				|					AND Filter.Characteristic = RegisterRecords.Characteristic
				|					AND Filter.Purpose = RegisterRecords.Purpose)
				|	
				|	UNION ALL
				|	
				|	SELECT
				|		RegisterRecords.Products AS Products,
				|		RegisterRecords.Characteristic AS Characteristic,
				|		RegisterRecords.Warehouse AS Warehouse,
				|		RegisterRecords.Purpose AS Purpose,
				|		0 AS Inventory,
				|		RegisterRecords.ToSupply - RegisterRecords.Replaced - RegisterRecords.AllocatedFromAvailableInventoryWithAssignment - RegisterRecords.AllocatedInAssignedProductionLots AS Demand
				|	FROM
				|		InformationRegister.OrderStructure AS RegisterRecords
				|	WHERE
				|		RegisterRecords.LineKind NOT IN(
				|				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
				|				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
				|				VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))
				|			AND TRUE IN(
				|				SELECT TOP 1
				|					TRUE AS ThereAreRecords
				|				FROM
				|					VariousGoodsAndWarehouses AS Filter
				|				WHERE
				|					Filter.Products = RegisterRecords.Products
				|					AND Filter.Characteristic = RegisterRecords.Characteristic
				|					AND Filter.Purpose = RegisterRecords.Purpose)
				|	
				|	UNION ALL
				|	
				|	SELECT
				|		RegisterRecords.Products AS Products,
				|		RegisterRecords.Characteristic AS Characteristic,
				|		RegisterRecords.Warehouse AS Warehouse,
				|		RegisterRecords.StructureAssignment AS Purpose,
				|		0 AS Inventory,
				|		RegisterRecords.AllocatedFromAvailableInventoryWithAssignment + RegisterRecords.AllocatedInAssignedProductionLots AS Demand
				|	FROM
				|		InformationRegister.OrderStructure AS RegisterRecords
				|	WHERE
				|		RegisterRecords.LineKind NOT IN(
				|				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
				|				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
				|				VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly))
				|			AND TRUE IN(
				|				SELECT TOP 1
				|					TRUE AS ThereAreRecords
				|				FROM
				|					VariousGoodsAndWarehouses AS Filter
				|				WHERE
				|					Filter.Products = RegisterRecords.Products
				|					AND Filter.Characteristic = RegisterRecords.Characteristic
				|					AND Filter.Purpose = RegisterRecords.Purpose)) AS Set
				|GROUP BY
				|	Set.Products,
				|	Set.Characteristic,
				|	Set.Warehouse,
				|	Set.Purpose
				|HAVING
				|	SUM(Set.Inventory) > 0 OR SUM(Set.Demand) > 0
				|INDEX BY
				|	Products, Characteristic, Warehouse, Purpose";
			Texts.Add(QueryText);
			QueryText =
				"SELECT
				|	Set.Products AS Products,
				|	Set.Characteristic AS Characteristic,
				|	Set.Purpose AS Purpose,
				|	SUM(Set.Inventory) AS ToReserve
				|FROM(
				// Surplus.
				|	SELECT
				|		Inventories.Products AS Products,
				|		Inventories.Characteristic AS Characteristic,
				|		Inventories.Purpose AS Purpose,
				|		Inventories.Inventory - Inventories.Demand AS Inventory
				|	FROM
				|		InventoryAndDemands AS Inventories
				|	
				|	UNION ALL
				|
				// Storno of the needs of those who have been processed.
				|	SELECT
				|		Inventories.Products AS Products,
				|		Inventories.Characteristic AS Characteristic,
				|		Inventories.Purpose AS Purpose,
				|		Inventories.Demand
							// Needs, the warehouse of which has been processed and is provided, among other things, due to surplus,
							// but is considered to be provided automatically, since the need for processing itself is not displayed.
				|			- Inventories.ReserveAtWarehouse AS Inventory
				|	FROM
				|		NeedsThatHaveBeenProcessed AS Inventories
						// If a remote warehouse has been processed, but the distribution center has not been
						// processed, then such a need is not canceled in the Inventory for the surplus task,
						// since the inventory should be distributed to the center, which will not be displayed in processing
				|	WHERE
				|		NOT TRUE IN(
				|			SELECT TOP 1
				|				TRUE AS ThereAreRecords
				|			FROM
				|				WarehouseTopology AS Filter
				|					
				|					LEFT JOIN VariousGoodsAndWarehouses AS Centers
				|					ON Centers.Products = Filter.Products
				|					 AND Centers.Characteristic = Filter.Characteristic
				|					 AND Centers.Warehouse = Filter.Center
				|					 AND Centers.Purpose = Inventories.Purpose
				|			WHERE
				|				Filter.Products = Inventories.Products
				|					AND Filter.Characteristic = Inventories.Characteristic
				|					AND Filter.Warehouse = Inventories.Warehouse
				|					AND Filter.Center <> Inventories.Warehouse
				|					AND Centers.Warehouse IS NULL)
				|	
				
				|	UNION ALL
				|
				// Surplus dynamic order structure.
				|	SELECT
				|		Inventories.Products AS Products,
				|		Inventories.Characteristic AS Characteristic,
				|		Inventories.Purpose AS Purpose,
				|		Inventories.Inventory - Inventories.Demand AS Inventory
				|	FROM
				|		InventoryAndNeedsAreDynamic AS Inventories
				|		
				|	UNION ALL
				|	
				// Storno the needs of the dynamic structure caught in the processing.
				|	SELECT
				|		Inventories.Products AS Products,
				|		Inventories.Characteristic AS Characteristic,
				|		Inventories.Purpose AS Purpose,
				|		Inventories.Demand AS Inventory
				|	FROM
				|		InventoryAndNeedsAreDynamic AS Inventories
				|	WHERE
				|		TRUE IN(
				|			SELECT TOP 1
				|				TRUE AS ThereAreRecords
				|			FROM
				|				VariousGoodsAndWarehouses AS Filter
				|			WHERE
				|				Filter.Products = Inventories.Products
				|					AND Filter.Characteristic = Inventories.Characteristic
				|					AND Filter.Warehouse = Inventories.Warehouse
				|					AND Filter.Purpose = Inventories.Purpose)
						// If a remote warehouse has been processed, but the distribution center has not been
						// processed, then such a need is not canceled in the Inventory for the surplus task,
						// since the inventory should be distributed to the center, which will not be displayed in processing
				|		AND NOT TRUE IN(
				|			SELECT TOP 1
				|				TRUE AS ThereAreRecords
				|			FROM
				|				WarehouseTopology AS Filter
				|					
				|					LEFT JOIN VariousGoodsAndWarehouses AS Centers
				|					ON Centers.Products = Filter.Products
				|					 AND Centers.Characteristic = Filter.Characteristic
				|					 AND Centers.Warehouse = Filter.Center
				|					 AND Centers.Purpose = Inventories.Purpose
				|			WHERE
				|				Filter.Products = Inventories.Products
				|					AND Filter.Characteristic = Inventories.Characteristic
				|					AND Filter.Warehouse = Inventories.Warehouse
				|					AND Filter.Center <> Inventories.Warehouse
				|					AND Centers.Warehouse IS NULL)
				
				|) AS Set
				|GROUP BY
				|	Set.Products,
				|	Set.Characteristic,
				|	Set.Purpose
				|HAVING
				|	SUM(Set.Inventory) > 0";
			Texts.Add(QueryText);
			Query.Text = StrConcat(Texts, Common.QueryBatchSeparator());
			TableOfBalancesInAllWarehouses = Query.Execute().Unload();
			TableOfBalancesInAllWarehouses.Indexes.Add("Products, Characteristic, Purpose");
			
		EndIf;
		
		// Calculation of the quantity to be reserved from the current warehouse.
		Filter = New Structure("Products, Characteristic, Warehouse, Purpose, ReceivingBusinessUnit");
		SelectionOfRemainsOfAllWarehouses = New Structure("Products, Characteristic, Purpose");
		
		For Each OrdersLine In Table Do
			
			FillPropertyValues(Filter, OrdersLine);
			FillPropertyValues(SelectionOfRemainsOfAllWarehouses, OrdersLine);
			RemainderLines_ = TableBalance.FindRows(Filter);
			
			If RemainderLines_.Count() > 0 Then
				FoundRow = RemainderLines_[0];
				FoundRow.ToReserve = Max(0, FoundRow.ToReserve - OrdersLine.ToReserve);
			EndIf;
			
			If ValueIsFilled(OrdersLine.Purpose)
				And Not OrdersLine.ThisIsWork
				And Not OrdersLine.SuppliedFromDistributionCenter Then // true, only for a remote warehouse
				
				FoundRows = TableOfBalancesInAllWarehouses.FindRows(SelectionOfRemainsOfAllWarehouses);
				If FoundRows.Count() > 0 Then
					FoundRows[0].ToReserve = Max(0, FoundRows[0].ToReserve - OrdersLine.ToReserve);
				EndIf;
				
			EndIf;
			
		EndDo;
		
		For Each OrdersLine In Table Do
			
			FillPropertyValues(Filter, OrdersLine);
			FillPropertyValues(SelectionOfRemainsOfAllWarehouses, OrdersLine);
			RemainderLines_ = TableBalance.FindRows(Filter);
			
			ToReserve = 0;
			If RemainderLines_.Count() > 0 Then
				
				FoundRow = RemainderLines_[0];
				ToReserve = Max(0, Min(FoundRow.ToReserve, OrdersLine.Required2 - OrdersLine.ToReserve));
				OrdersLine.ToReserve = OrdersLine.ToReserve + ToReserve;
				FoundRow.ToReserve = FoundRow.ToReserve - ToReserve;
				
			EndIf;
			
			If ValueIsFilled(OrdersLine.Purpose)
				And Not OrdersLine.ThisIsWork
				And Not OrdersLine.SuppliedFromDistributionCenter Then
				
				FoundRows = TableOfBalancesInAllWarehouses.FindRows(SelectionOfRemainsOfAllWarehouses);
				If FoundRows.Count() > 0 Then
					ToReservationForProduct = Min(FoundRows[0].ToReserve, ToReserve);
					FoundRows[0].ToReserve = FoundRows[0].ToReserve - ToReservationForProduct;
				EndIf;
				
			EndIf;
			
		EndDo;
		
		// Additional supply of goods from other warehouses.
		For Each OrdersLine In Table Do
			
			If ValueIsFilled(OrdersLine.Purpose)
				
				And Not OrdersLine.ThisIsWork
				And Not OrdersLine.SuppliedFromDistributionCenter Then
				
				FillPropertyValues(SelectionOfRemainsOfAllWarehouses, OrdersLine);
				FoundRows = TableOfBalancesInAllWarehouses.FindRows(SelectionOfRemainsOfAllWarehouses);
				If FoundRows.Count() > 0 Then
					ToReserve = Max(0, Min(FoundRows[0].ToReserve, OrdersLine.Required2 - OrdersLine.ToReserve));
					FoundRows[0].ToReserve = FoundRows[0].ToReserve - ToReserve;
					OrdersLine.ToReserve = OrdersLine.ToReserve + ToReserve;
				EndIf;
				
			EndIf;
			
		EndDo;
		
	EndIf;
	
	PutToTempStorage(Table, ResultAddress);
	
EndProcedure

Procedure CreateOrderTree(Parameters, ResultAddress) Export
	
	OrderTree = Parameters.OrderTree;
	
	// Glue two tables into one and group
	NumberQualifiers = New NumberQualifiers(15, 3, AllowedSign.Nonnegative);
	
	DescriptionOfBoolean = New TypeDescription("Boolean");
	Parameters.Inventories.Columns.Add("ThisIsWork", DescriptionOfBoolean);
	

	CommonClientServer.SupplementTable(Parameters.OrdersPendingSupply, Parameters.Inventories);
	Parameters.Inventories.Indexes.Add("SupplyMethod, SupplySource, Terms, Warehouse");
	Parameters.Inventories.GroupBy("SupplyMethod, SupplySource, Terms, Warehouse, Products, SupplyType, Manager,
		|Characteristic, OrderPackage, PriceInTheCurrencyOfAgreement, Mark, UnitOfMeasure, AgreementCurrency, Weight, ThisIsWork,
		|MinimumOrderAmount, PriceKind, UnitOfMeasureType, SupplySourceViewOnly, TransferIsAllowed",
		"ToOrder, AgreementCurrencyAmount, Rounded, RecommendedToOrder");
	
	Parameters.Inventories.Columns.Add("Processed1", New TypeDescription("Boolean"));
	
	Cnt = 0;
	While Cnt < Parameters.Inventories.Count() Do
		
		LineStock = Parameters.Inventories[Cnt];
		
		If Not LineStock.Mark Or LineStock.Processed1 Then
			Cnt = Cnt + 1;
			Continue;
		EndIf;
		
		TheStructureOfTheSearch = New Structure("SupplySource, Terms, Warehouse, Manager");
		FillPropertyValues(TheStructureOfTheSearch, LineStock);
		
		FoundInventoryLines = Parameters.Inventories.FindRows(TheStructureOfTheSearch);
		
		OrderRow = OrderTree.Rows.Add();
		OrderRow.LevelInTheTree = 0;
		FillPropertyValues(OrderRow, LineStock,,"SupplyMethod, Products, Characteristic, UnitOfMeasure, OrderPackage, PriceInTheCurrencyOfAgreement");
		
		ToOrderTotal               = 0;
		NeedSummary           = 0;
		AmountCurrencyOfAgreementTotal = 0;
		WeightTotal                   = 0;
		TypesOfQuantitiesAreSame = True;
		MeasuredValueType = Undefined;
		
		For Each StockElement In FoundInventoryLines Do
			
			If StockElement.Mark Then
				
				If MeasuredValueType <> StockElement.UnitOfMeasureType And MeasuredValueType <> Undefined Then
					TypesOfQuantitiesAreSame = False;
				EndIf;
				MeasuredValueType = StockElement.UnitOfMeasureType;
				
				StringProducts_  = OrderRow.Rows.Add();
				StringProducts_.LevelInTheTree = 1;
				FillPropertyValues(StringProducts_, StockElement);
				StringProducts_.ToOrder               = Max(StockElement.Rounded, StockElement.ToOrder);
				StringProducts_.Demand           = StockElement.RecommendedToOrder;
				StringProducts_.Weight                   = StockElement.Weight * StringProducts_.ToOrder;
				StringProducts_.AgreementCurrencyAmount = StringProducts_.PriceInTheCurrencyOfAgreement * StringProducts_.ToOrder;
				
				ToOrderTotal               = ToOrderTotal + StringProducts_.ToOrder;
				NeedSummary           = NeedSummary + StringProducts_.Demand;
				AmountCurrencyOfAgreementTotal = AmountCurrencyOfAgreementTotal + StringProducts_.AgreementCurrencyAmount;
				WeightTotal                   = WeightTotal + StringProducts_.Weight;
				
				StockElement.Processed1 = True;
			EndIf;
			
		EndDo;
		
		OrderRow.ToOrder               = ?(TypesOfQuantitiesAreSame, ToOrderTotal, 0);
		OrderRow.Demand           = ?(TypesOfQuantitiesAreSame, NeedSummary, 0);
		OrderRow.AgreementCurrencyAmount = AmountCurrencyOfAgreementTotal;
		OrderRow.Weight                   = WeightTotal;
		If AmountCurrencyOfAgreementTotal < OrderRow.MinimumOrderAmount And AmountCurrencyOfAgreementTotal <> 0 Then
			OrderRow.Warning        = True;
		EndIf;
		
		Cnt = Cnt + 1;
	EndDo;
	
	PutToTempStorage(OrderTree, ResultAddress);
	
EndProcedure

