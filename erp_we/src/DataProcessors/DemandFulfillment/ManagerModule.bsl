Procedure RoundUpBeforeCreatingOrders(Table)
	
	Table.Sort("Products, Characteristic, Warehouse, ShipmentDate, Purpose DESC", New CompareValues());
	
	KeyFields = "Products, Characteristic, Warehouse";
	Var_Key = New Structure(KeyFields);
	
	Balance = 0;
	RoundedString = Undefined;
	For RowIndex = 0 To Table.Count() - 1 Do
		
		String = Table[RowIndex];
		
		If Not String.Mark 
			Or String.ToOrder = 0
			Or String.DoNotRoundBeforeCreatingOrder Then
			Continue;
		EndIf;
		
		KeyChanged = SupplyServer.KeyChanged(Var_Key, String);
		FillPropertyValues(Var_Key, String);
		
		If KeyChanged Then
			
			If Balance > 0 Then
				NewRow = Table.Add();
				FillPropertyValues(NewRow, RoundedString);
				NewRow.ToOrder = Balance;
				NewRow.Purpose = Catalogs.Assignments.EmptyRef();
				NewRow.ThisIsRounding = True;
				NewRow.PurposeOfRoundedString = RoundedString.Purpose;
			EndIf;
			
			Rounded = RoundOff(String.ToOrder, ?(String.PackageNumerator = 0 Or String.PackageDenominator = 0, 1, String.PackageNumerator / String.PackageDenominator),
				String.UnitOfMeasureType);
			
			Repetition = ?(String.PackageNumerator = 0 Or String.PackageDenominator = 0, 1, String.PackageNumerator / String.PackageDenominator);
			MinimumDeliveryLot = String.MinimumDeliveryLot * Repetition;
			
			Rounded = Max(MinimumDeliveryLot, Rounded);
			
			Balance = Rounded - String.ToOrder;
			RoundedString = String;
			
		Else
			
			If Balance >= String.ToOrder Then
				String.ShipmentDate = RoundedString.ShipmentDate;
				Balance = Balance - String.ToOrder;
			Else
				
				If Balance > 0 Then
					
					ToOrderForNewRoundedRow = String.ToOrder - Balance;
					
					// Partially attributed to the date of the rounded line, a new line
					NewRow = Table.Add();
					FillPropertyValues(NewRow, String);
					NewRow.ToOrder = Balance;
					NewRow.ShipmentDate = RoundedString.ShipmentDate;
					
					// We partially leave it on the date of the current line
					String.ToOrder = ToOrderForNewRoundedRow;
					
				EndIf;
				
				Rounded = RoundOff(String.ToOrder, ?(String.PackageNumerator = 0 Or String.PackageDenominator = 0, 1, String.PackageNumerator / String.PackageDenominator),
					String.UnitOfMeasureType);
				Balance = Rounded - String.ToOrder;
				RoundedString = String;
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
	If Balance > 0 Then
		NewRow = Table.Add();
		FillPropertyValues(NewRow, RoundedString);
		NewRow.ToOrder = Balance;
		NewRow.Purpose = Catalogs.Assignments.EmptyRef();
		NewRow.ThisIsRounding = True;
		NewRow.PurposeOfRoundedString = RoundedString.Purpose;
	EndIf;
	
EndProcedure

Function RoundOff(Count, Repetition, UnitOfMeasureType)
	
	If Repetition <> 1
		Or UnitOfMeasureType = PredefinedValue("Enum.TypesOfMeasuredValues.NumberOfPieces") Then
		If Count % Repetition <> 0 Then
			Balance = Int(Count / Repetition) + 1;
			Return Balance * Repetition;
		Else
			Return Count;
		EndIf;
	Else 
		Return Count;
	EndIf;
	
EndFunction

Function GetValuesForDocumentDetails(DocumentObject)

	AttributesValues = New Structure();
	
	AttributesValues.Insert("Document",            DocumentObject.Ref);
	AttributesValues.Insert("StandardPicture", ?(DocumentObject.Posted, 0, ?(DocumentObject.DeletionMark, 1, 2)));

	OrderNotConfirmed = ?(TypeOf(DocumentObject) <> Type("DocumentObject.PurchaseOrder")
		Or DocumentObject.Status = Enums.PurchaseOrderStatuses.Confirmed_
		Or DocumentObject.Status = Enums.PurchaseOrderStatuses.Closed, ?(DocumentObject.Posted, 0, 1), 1);

	ProductionOrderNotForProduction = 0;

	AttributesValues.Insert("NotOnSchedule",  OrderNotConfirmed);
	AttributesValues.Insert("NotScheduledForProduction", ProductionOrderNotForProduction);

	AttributesValues.Insert("Status",              DocumentObject.Status);
	AttributesValues.Insert("Organization",         DocumentObject.Organization);
	
	ShipmentDate = '00010101';
	TabSectionName = "";
	
	AttributesValues.Insert("NumberOfSupplySources", 1);
	
	If TypeOf(DocumentObject) = Type("DocumentObject.ByAssemblyDisassemblyOrder") Then
		
		AttributesValues.Insert("SupplySource", DocumentObject.Warehouse);
		AttributesValues.Insert("Manager",            DocumentObject.EmployeeResponsible);
		ShipmentDate = DocumentObject.AssemblyDisassemblyEnd;
		
	ElsIf TypeOf(DocumentObject) = Type("DocumentObject.TransferOrder") Then
		
		AttributesValues.Insert("SupplySource", DocumentObject.SourceWarehouse);
		AttributesValues.Insert("Manager",            DocumentObject.EmployeeResponsible);
		TabSectionName = "Goods";
		NameOfDeliveryDateProps = "ReceiptEnd";
		
	ElsIf TypeOf(DocumentObject) = Type("DocumentObject.PurchaseOrder") Then
		
		AttributesValues.Insert("SupplySource", DocumentObject.Partner);
		AttributesValues.Insert("Sum",               DocumentObject.DocumentAmount);
		AttributesValues.Insert("Currency",              DocumentObject.Currency);
		AttributesValues.Insert("Manager",            DocumentObject.Manager);
		TabSectionName = "Goods";
		NameOfDeliveryDateProps = "DateOfReceipt";
	ElsIf TypeOf(DocumentObject) = Type("DocumentObject.PurchaseRequest") Then
		
		PartnersOfPurchaseRequest = DocumentObject.Goods.Unload(, "Partner").UnloadColumn("Partner");
		PartnersOfPurchaseRequest = CommonClientServer.CollapseArray(PartnersOfPurchaseRequest);
		
		If PartnersOfPurchaseRequest.Count() = 1 And ValueIsFilled(PartnersOfPurchaseRequest[0]) Then 
			PartnerOfPurchaseRequest = PartnersOfPurchaseRequest[0];
		Else
			PartnerOfPurchaseRequest = Undefined;
		EndIf;
		
		AttributesValues.Insert("SupplySource", PartnerOfPurchaseRequest);
		AttributesValues.Insert("Sum",               DocumentObject.DocumentAmount);
		AttributesValues.Insert("Currency",              DocumentObject.Currency);
		AttributesValues.Insert("Manager",            DocumentObject.Manager);
		AttributesValues.Insert("NumberOfSupplySources", PartnersOfPurchaseRequest.Count());
		TabSectionName = "Goods";
		NameOfDeliveryDateProps = "RequestedDeliveryDate";
	ElsIf TypeOf(DocumentObject) = Type("DocumentObject.OrderOfMaterialsForProduction") Then
		
		AttributesValues.Insert("SupplySource", DocumentObject.Warehouse);
		AttributesValues.Insert("Manager",            DocumentObject.EmployeeResponsible);
		TabSectionName = "Goods";
		NameOfDeliveryDateProps = "ReceiptEnd";
		
	ElsIf TypeOf(DocumentObject) = Type("DocumentObject.SubcontractOrder2_5") Then
		
		AttributesValues.Insert("SupplySource", DocumentObject.Partner);
		AttributesValues.Insert("Sum",               DocumentObject.DocumentAmount);
		AttributesValues.Insert("Currency",              DocumentObject.Currency);
		AttributesValues.Insert("Manager",            DocumentObject.Manager);
		TabSectionName = "ManufacturedProducts";
		NameOfDeliveryDateProps = "DateOfReceipt";
		
	ElsIf TypeOf(DocumentObject) = Type("DocumentObject.ProductionOrder2_2") Then
		
		AttributesValues.Insert("SupplySource", DocumentObject.Department);
		AttributesValues.Insert("Manager",            DocumentObject.EmployeeResponsible);
		ShipmentDate = DocumentObject.DemandDate;
	EndIf;
	
	If TabSectionName <> "" Then
		
		For Each String In DocumentObject[TabSectionName] Do
			
			If ShipmentDate <> String[NameOfDeliveryDateProps] Then
				
				If ShipmentDate <> '00010101' Then
					
					// If there is more than one line in the document and different delivery dates, then we do not fill in the delivery date.
					ShipmentDate = '00010101';
					Break;
					
				EndIf;
				
				ShipmentDate = String[NameOfDeliveryDateProps];
				
			EndIf;
			
		EndDo;
		
	EndIf;
	AttributesValues.Insert("ShipmentDate", ShipmentDate);
	
	Return AttributesValues;
	
EndFunction

Function GetDocument(ManagerOfDocuments, FillingData, Status)
	
	DocumentObject = ManagerOfDocuments.CreateDocument();
	FillingData.Insert("Date", CurrentSessionDate());
	
	DocumentObject.Fill(FillingData);
	
	If Not ValueIsFilled(DocumentObject.Status)
		Or TypeOf(DocumentObject) = Type("DocumentObject.PurchaseRequest") Then
		DocumentObject.Status = Status;
	EndIf;
	
	Return DocumentObject;
	
EndFunction

Procedure AddDocumentToResult(Document, Result, UsingStatuses)
	
	NewRow = Result.DocumentsTable.Add();
	
	NewPropsValues = GetValuesForDocumentDetails(Document);
	FillPropertyValues(NewRow, NewPropsValues);
	NewRow.UsingStatuses = UsingStatuses[TypeOf(NewRow.Document)];
	
	Errors = GetUserMessages(True);
	For Each Error In Errors Do
		Error.DataKey = Document.Ref;
		Result.ListOfMessages.Add(Error);
	EndDo;
	
EndProcedure

