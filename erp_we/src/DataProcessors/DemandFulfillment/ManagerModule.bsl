		Fields.Insert("OrderDocument",        Metadata.DefinedTypes.ExpectedShipment.Type);
		Fields.Insert("DateOfShipment", TMCommonUse.GetDescriptionOfDateTypes(DateFractions.Date));

	EndIf;

	If StrFind(Sections_, "DetailsOfProvidingOrder") Then

		Fields.Insert("SupplyType",      New TypeDescription("EnumRef.SupplyTypes"));
