// It is intended for calculating statistics of product consumption in the warehouse.
//
// Parameters:
//  Parameters - Structure - structure with fields:
//     * NeedKey - Structure - structure with fields:
//        ** Products   - CatalogRef.Products               - nomenclature for calculating statistics
//        ** Characteristic - CatalogRef.ItemsCharacteristics - characteristics for calculating statistics
//        ** Warehouse          - CatalogRef.Warehouses                     - warehouse for calculating statistics.
//  ResultAddress - UUID, String - the address in the temporary storage.
//
// Returns:
//  Structure - A structure containing data on average daily consumption. Structure composition:
//    * AverageDailyConsumption - Number  - average daily consumption in item storage units
//    * AverageVariance        - Number  - COE of average daily consumption, calculated as a percentage
//    * ConsumptionIsStable     - Boolean - true if the variation is less than 5%, false otherwise
//    * DataOverPeriod           - StandardPeriod - the period for which statistics are calculated.
//
Function ConsumptionStatistics(Parameters, ResultAddress) Export
	
	Query = New Query();
	Query.TempTablesManager = New TempTablesManager;
	Query.Text =
		"SELECT
		|	&Products   AS Products,
		|	&Characteristic AS Characteristic,
		|	&Warehouse          AS Warehouse
		|INTO TTProducts_1";
	For Each Property In Parameters.NeedKey Do
		Query.SetParameter(Property.Key, Property.Value);
	EndDo;
	Query.Execute();
	
	SetPrivilegedMode(True);
	
	Query.SetParameter("CurrentDayStart", BegOfDay(CurrentSessionDate()));
	SupplyServer.SetParametersForStatisticsCalculationRequest(Query);
	SupplyServer.AddTemporaryTableOfConsumptionStatistics(Query, "TTProducts_1");
	
	SetPrivilegedMode(False);
	
	Query.Text =
		"SELECT
		|	Statistics.AverageDailyConsumption AS AverageDailyConsumption,
		|	Statistics.VarianceOfConsumption     AS VarianceOfConsumption,
		|	Statistics.ConsumptionIsStable     AS ConsumptionIsStable,
		|
		|	Statistics.Consumption          AS Consumption,
		|	Statistics.BeginningDateOfPeriod    AS BeginningDateOfPeriod,
		|	Statistics.EndingDateOfPeriod AS EndingDateOfPeriod
		|FROM
		|	TTConsumptionStatistics AS Statistics";
	
	Selection = Query.Execute().Select();
	
	Result = New Structure("AverageDailyConsumption, AverageVariance, ConsumptionIsStable, DataOverPeriod");
	If Selection.Next() Then
		Result.AverageDailyConsumption = Selection.AverageDailyConsumption;
		If ValueIsFilled(Selection.VarianceOfConsumption) And Selection.VarianceOfConsumption > 0 Then
			Result.AverageVariance    = Pow(Selection.VarianceOfConsumption, 0.5);
		EndIf;
		Result.ConsumptionIsStable     = Selection.ConsumptionIsStable;
		
		Result.DataOverPeriod = New StandardPeriod(Selection.BeginningDateOfPeriod, Selection.EndingDateOfPeriod);
	EndIf;
	
	PutToTempStorage(Result, ResultAddress);
	
EndFunction

