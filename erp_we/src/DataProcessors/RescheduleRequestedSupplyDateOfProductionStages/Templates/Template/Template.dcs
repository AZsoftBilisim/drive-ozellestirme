		<field xsi:type="DataSetFieldField">
			<dataPath>ProductionStage</dataPath>
			<field>ProductionStage</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Production stage</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مرحله تولید</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Fase di produzione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Etap produkcji</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Этап производства</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Üretim aşaması</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Công đoạn sản xuất</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Supply.Ref                                  AS ProductionStage,
	Supply.Products                            AS Products,
	Supply.Characteristic                          AS Characteristic,
	Supply.DateOfShipment                            AS DateOfShipment,
	BEGINOFPERIOD(ProductionSchedule.Begin, DAY) AS Begin,
	
	Supply.Count AS Count
	
FROM
	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS Supply
		INNER JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionSchedule
		ON Supply.Ref = ProductionSchedule.Stage
WHERE
	Supply.Ref.ReferenceOrder = &amp;ReferenceOrder
	AND Supply.Ref.Status IN(&amp;StageStatuses)
	AND Supply.Ref.Posted
	AND Supply.SupplyOption IN(&amp;SupplyOptions)
	AND ProductionSchedule.ProductionOrder = &amp;ReferenceOrder
	AND ProductionSchedule.ScheduleStatus = &amp;StatusWorkingSchedule
	AND Supply.DateOfShipment &lt;&gt; BEGINOFPERIOD(ProductionSchedule.Begin, DAY)
	AND NOT Supply.Canceled</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>StageStart</dataPath>
		<expression>Max(StageStart)</expression>
	</totalField>
