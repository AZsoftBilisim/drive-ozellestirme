		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RawData.Products AS Products,
	RawData.Characteristic AS Characteristic,
	RawData.Series AS Series,
	RawData.Lot AS Lot,
	RawData.Order AS Order,
	RawData.AssetID AS AssetID
INTO RawData
FROM
	(SELECT
		VALUE(Catalog.LotsOfInventoryInOperation.EmptyRef) AS Products,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		VALUE(Catalog.LotsOfInventoryInOperation.EmptyRef) AS Lot,
		"" AS AssetID,
		0 AS Order) AS RawData
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SourceDataLastRequest.Products AS Products,
	SourceDataLastRequest.Characteristic AS Characteristic,
	SourceDataLastRequest.Series AS Series,
	SourceDataLastRequest.Lot AS Lot,
	SourceDataLastRequest.AssetID AS AssetID,
	SourceDataLastRequest.Order AS Order
{SELECT
	Products.*,
	Characteristic.*,
	Series.*,
	Lot.*,
	AssetID}
FROM
	RawData AS SourceDataLastRequest
{WHERE
	SourceDataLastRequest.Products.* AS Products,
	SourceDataLastRequest.Characteristic.* AS Characteristic,
	SourceDataLastRequest.Series.* AS Series,
	SourceDataLastRequest.Lot.* AS Lot,
	SourceDataLastRequest.AssetID AS AssetID}

ORDER BY
	SourceDataLastRequest.Order</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
