<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:Decoration">
    <name>LabelDecoration</name>
    <id>1</id>
    <title>
      <key>en</key>
      <value>Now scan the barcode from the print form using a barcode scanner</value>
    </title>
    <title>
      <key>fa</key>
      <value>اکنون بارکد فرم چاپی را با بارکدخوان اسکن کنید</value>
    </title>
    <title>
      <key>it</key>
      <value>È possibile leggere un codice a barre con il lettore di codici a barre</value>
    </title>
    <title>
      <key>pl</key>
      <value>Przy pomocy skanera kodów kreskowych sczytaj kod kreskowy z wydrukowanego formularza</value>
    </title>
    <title>
      <key>ru</key>
      <value>С помощью сканера штрихкода считайте штрихкод с печатной формы</value>
    </title>
    <title>
      <key>tr</key>
      <value>Yazdırma formundan barkodu okumak için barkod tarayıcıyı kullanın</value>
    </title>
    <title>
      <key>vi</key>
      <value>Bằng máy quét mã vạch, hãy đọc mã vạch từ mẫu in</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>LabelDecorationExtendedTooltip</name>
      <id>5</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>LabelDecorationContextMenu</name>
      <id>2</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <textColor xsi:type="core:ColorRef">
      <color>Style.NoteText</color>
    </textColor>
    <font xsi:type="core:FontRef">
      <font>System.DefaultGUIFont</font>
      <bold>true</bold>
      <italic>false</italic>
      <underline>false</underline>
      <strikeout>false</strikeout>
    </font>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <commandBarLocation>Bottom</commandBarLocation>
  <autoCommandBar>
    <name>FormCommandBar</name>
    <id>-1</id>
    <items xsi:type="form:Button">
      <name>FormClose</name>
      <id>3</id>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <defaultItem>true</defaultItem>
      <extendedTooltip>
        <name>FormCloseExtendedTooltip</name>
        <id>4</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <commandName>Form.StandardCommand.Close</commandName>
      <representation>PictureAndText</representation>
      <defaultButton>true</defaultButton>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <placementArea>UserCmds</placementArea>
      <representationInContextMenu>Auto</representationInContextMenu>
    </items>
    <horizontalAlign>Right</horizontalAlign>
    <autoFill>true</autoFill>
  </autoCommandBar>
  <handlers>
    <event>NotificationProcessing</event>
    <name>NotificationProcessing</name>
  </handlers>
  <handlers>
    <event>OnOpen</event>
    <name>OnOpen</name>
  </handlers>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>OnCreateAtServer</name>
  </handlers>
  <handlers>
    <event>OnClose</event>
    <name>OnClose</name>
  </handlers>
  <excludedCommands>CustomizeForm</excludedCommands>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Object</name>
    <id>1</id>
    <valueType>
      <types>DataProcessorObject.SearchForObjectsByBarcode</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
  </attributes>
  <attributes>
    <name>UsePeripherals</name>
    <title>
      <key>en</key>
      <value>Use peripherals</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده از تجهیزات جانبی</value>
    </title>
    <title>
      <key>it</key>
      <value>Utilizzare apparecchiature da collegare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wykorzystuj urządzenia peryferyjne</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использовать подключаемое оборудование</value>
    </title>
    <title>
      <key>tr</key>
      <value>Bağlanabilir donanım kullan</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng thiết bị kết nối</value>
    </title>
    <id>2</id>
    <valueType>
      <types>Boolean</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>SupportedPeripheralTypes</name>
    <title>
      <key>en</key>
      <value>Supported peripheral types</value>
    </title>
    <title>
      <key>fa</key>
      <value>انواع تجهیزات جانبی پشتیبانی‌شده</value>
    </title>
    <title>
      <key>it</key>
      <value>Tipi di apparecchiature supportate collegate</value>
    </title>
    <title>
      <key>pl</key>
      <value>Obsługiwane typy urządzenia peryferyjnego</value>
    </title>
    <title>
      <key>ru</key>
      <value>Поддерживаемые типы подключаемого оборудования</value>
    </title>
    <title>
      <key>tr</key>
      <value>Desteklenen çevre birimi türleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Kiểu thiết bị kết nối được hỗ trợ</value>
    </title>
    <id>3</id>
    <valueType>
      <types>String</types>
      <stringQualifiers/>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:ObjectFormExtInfo"/>
</form:Form>
