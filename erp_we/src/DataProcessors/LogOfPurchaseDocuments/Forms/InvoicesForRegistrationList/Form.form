    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceivingReferences.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceivingReferences.TypeOfOrder_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceivingReferences.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	TableOverridable.DocumentInflow AS DocumentInflow,
	TableOverridable.Warehouse AS Warehouse,
	TableOverridable.BusinessOperation AS BusinessOperation,
	TableOverridable.Products AS Products,
	TableOverridable.Characteristic AS Characteristic,
	TableOverridable.Purpose AS Purpose,
	TableOverridable.Series AS Series
INTO TueRemainingItemsToBeReceived
FROM
	AccumulationRegister.GoodsToReceive.Balance(
			,
			DocumentInflow REFS Document.PurchaseOrder
				OR DocumentInflow REFS Document.VendorInvoice
				OR DocumentInflow REFS Catalog.CounterpartyContracts
				OR DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			{(Warehouse) AS Warehouse}
	) AS TableOverridable
WHERE
	TableOverridable.ToRegisterGoodsReceiptsBalance &lt;> 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	TTTableOverridable.DocumentInflow AS DocumentInflow,
	TTTableOverridable.Warehouse AS Warehouse,
	TTTableOverridable.BusinessOperation AS BusinessOperation
INTO TueReceiptDocuments
FROM
	(SELECT
		StockBalanceOverridable.DocumentInflow AS DocumentInflow,
		StockBalanceOverridable.Warehouse AS Warehouse,
		StockBalanceOverridable.BusinessOperation AS BusinessOperation,
		StockBalanceOverridable.Products AS Products,
		StockBalanceOverridable.Characteristic AS Characteristic,
		StockBalanceOverridable.Purpose AS Purpose,
		StockBalanceOverridable.Series AS Series
	FROM
		TueRemainingItemsToBeReceived AS StockBalanceOverridable
	) AS TTTableOverridable

INDEX BY
	DocumentInflow,
	Warehouse,
	BusinessOperation
;

SELECT ALLOWED
	GoodsToReceiveOverridable.DocumentInflow,
	GoodsToReceiveOverridable.Warehouse,
	GoodsToReceiveOverridable.BusinessOperation
INTO TueThereAreOrders_3
FROM
	AccumulationRegister.GoodsToReceive AS GoodsToReceiveOverridable
WHERE
	GoodsToReceiveOverridable.Active
	AND GoodsToReceiveOverridable.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND (GoodsToReceiveOverridable.DocumentInflow, GoodsToReceiveOverridable.Warehouse, GoodsToReceiveOverridable.BusinessOperation) IN 
		(SELECT
			TableOverridable.DocumentInflow AS DocumentInflow,
			TableOverridable.Warehouse AS Warehouse,
			TableOverridable.BusinessOperation AS BusinessOperation
		FROM
			TueReceiptDocuments AS TableOverridable
		)
GROUP BY
	GoodsToReceiveOverridable.DocumentInflow,
	GoodsToReceiveOverridable.Warehouse,
	GoodsToReceiveOverridable.BusinessOperation
HAVING
	SUM(GoodsToReceiveOverridable.ToRegisterGoodsReceipts) > 0

INDEX BY
	DocumentInflow,
	Warehouse,
	BusinessOperation
;

SELECT ALLOWED
	GoodsToReceiveOverridable.DocumentInflow,
	GoodsToReceiveOverridable.Warehouse,
	GoodsToReceiveOverridable.BusinessOperation
INTO TueThereAreReceipts
FROM
	AccumulationRegister.GoodsToReceive AS GoodsToReceiveOverridable
WHERE
	GoodsToReceiveOverridable.Active
	AND GoodsToReceiveOverridable.RecordType = VALUE(AccumulationRecordType.Expense)
	AND (GoodsToReceiveOverridable.DocumentInflow, GoodsToReceiveOverridable.Warehouse, GoodsToReceiveOverridable.BusinessOperation) IN 
		(SELECT
			TableOverridable.DocumentInflow AS DocumentInflow,
			TableOverridable.Warehouse AS Warehouse,
			TableOverridable.BusinessOperation AS BusinessOperation
		FROM
			TueReceiptDocuments AS TableOverridable
		)
GROUP BY
	GoodsToReceiveOverridable.DocumentInflow,
	GoodsToReceiveOverridable.Warehouse,
	GoodsToReceiveOverridable.BusinessOperation
HAVING
	SUM(GoodsToReceiveOverridable.ToRegisterGoodsReceipts) > 0

INDEX BY
	DocumentInflow,
	Warehouse,
	BusinessOperation
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOverridable.DocumentInflow AS DocumentInflow,
	TableOverridable.Warehouse AS Warehouse,
	TableOverridable.BusinessOperation AS BusinessOperation,
	MAX(CASE
			WHEN TableTTThereAreReceiptsOverridable.DocumentInflow IS NULL
				THEN 1
			WHEN TableHasOrdersOverridable.DocumentInflow IS NULL
				THEN 5
			ELSE 3
		END) AS NoteState
INTO TueOrderStatus
FROM
	TueRemainingItemsToBeReceived AS TableOverridable
		LEFT JOIN TueThereAreOrders_3 AS TableHasOrdersOverridable
		ON TableHasOrdersOverridable.DocumentInflow = TableOverridable.DocumentInflow
			AND TableHasOrdersOverridable.Warehouse = TableOverridable.Warehouse
			AND TableHasOrdersOverridable.BusinessOperation = TableOverridable.BusinessOperation
		LEFT JOIN TueThereAreReceipts AS TableTTThereAreReceiptsOverridable
		ON TableTTThereAreReceiptsOverridable.DocumentInflow = TableOverridable.DocumentInflow
			AND TableTTThereAreReceiptsOverridable.Warehouse = TableOverridable.Warehouse
			AND TableTTThereAreReceiptsOverridable.BusinessOperation = TableOverridable.BusinessOperation

GROUP BY
	TableOverridable.DocumentInflow,
	TableOverridable.Warehouse,
	TableOverridable.BusinessOperation

INDEX BY
	DocumentInflow
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Ref
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Ref
		ELSE DocumentsRegistryOverridable.Ref
	END AS Ref,
	VALUETYPE(TableOfOrdersOverridable.DocumentInflow.Ref) AS TypeOfOrder_,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Number
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Number
		ELSE DocumentsRegistryOverridable.IBDocumentNumber
	END AS Number,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Date
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Date
		ELSE DocumentsRegistryOverridable.IBDocumentDate
	END AS Date,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Partner
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Partner
		ELSE DocumentsRegistryOverridable.Partner
	END AS Partner,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Counterparty
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Counterparty
		ELSE CAST(DocumentsRegistryOverridable.Counterparty.Key AS Catalog.Counterparties)
	END AS Counterparty,
	TableOfOrdersOverridable.BusinessOperation AS BusinessOperation,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Organization
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Organization
		ELSE DocumentsRegistryOverridable.Organization
	END AS Organization,
	TableOfOrdersOverridable.Warehouse AS Warehouse,
	DocumentsRegistryOverridable.Sum AS DocumentAmount,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Currency
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).ARAPCurrency
		ELSE DocumentsRegistryOverridable.Currency
	END AS Currency,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Manager
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Manager
		ELSE DocumentsRegistryOverridable.EmployeeResponsible
	END AS Manager,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).DeletionMark
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).DeletionMark
		ELSE DocumentsRegistryOverridable.DeletionMark
	END AS DeletionMark,
	TableOfOrdersOverridable.NoteState AS NoteState,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN VALUE(Catalog.CounterpartyContracts.EmptyRef)
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).Ref
		ELSE DocumentsRegistryOverridable.Contract
	END AS Contract,
	CASE
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN VALUE(Enum.ARAPObjectSettings.EmptyRef)
		WHEN TableOfOrdersOverridable.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrdersOverridable.DocumentInflow AS Catalog.CounterpartyContracts).ARAPObjectSettings
		ELSE DocumentsRegistryOverridable.Ref.ARAPObjectSettings
	END AS ARAPObjectSettings
INTO TTTempTable
FROM
	TueOrderStatus AS TableOfOrdersOverridable
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistryOverridable
		ON TableOfOrdersOverridable.DocumentInflow = DocumentsRegistryOverridable.Ref
			AND NOT DocumentsRegistryOverridable.AdditionalRecord
WHERE
	NOT TableOfOrdersOverridable.DocumentInflow.Ref IS NULL
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTTempTable.Ref AS Ref,
	TTTempTable.TypeOfOrder_ AS TypeOfOrder_,
	TTTempTable.Number AS Number,
	TTTempTable.Date AS Date,
	TTTempTable.Partner AS Partner,
	TTTempTable.Counterparty AS Counterparty,
	TTTempTable.BusinessOperation AS BusinessOperation,
	TTTempTable.Organization AS Organization,
	TTTempTable.Warehouse AS Warehouse,
	TTTempTable.DocumentAmount AS DocumentAmount,
	TTTempTable.Currency AS Currency,
	TTTempTable.Manager AS Manager,
	TTTempTable.DeletionMark AS DeletionMark,
	TTTempTable.NoteState AS NoteState,
	TTTempTable.Contract AS Contract,
	TTTempTable.ARAPObjectSettings AS ARAPObjectSettings
FROM TTTempTable AS TTTempTable
</queryText>
