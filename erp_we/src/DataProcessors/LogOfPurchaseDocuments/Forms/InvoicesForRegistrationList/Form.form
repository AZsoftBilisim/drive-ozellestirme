  <attributes>
    <name>ListReferencesForRegistration</name>
    <title>
      <key>en</key>
      <value>List references for registration</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست مراجع برای ثبت</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco disposizioni da formalizzare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista zamówienia do rejestracji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список распоряжения на оформление</value>
    </title>
    <title>
      <key>tr</key>
      <value>Düzenlenen siparişlerin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách thứ tự thực hiện</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UsePurchaseOrders</functionalOptions>
    <functionalOptions>FunctionalOption.UseWarehouseManagemantSystemForGoodsReceipt</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Contract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.GoodsReceiptOption</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.PurchaseState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.TypeOfOrder_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	TableOverridable.PurchaseOrder AS PurchaseOrder
INTO WRemainsOnTheOrder
FROM
	AccumulationRegister.PurchaseOrders.Balance(, PurchaseOrder REFS Document.PurchaseOrder {(Warehouse) AS
		Warehouse}) AS TableOverridable
WHERE
	TableOverridable.ToRegisterBalance > 0
;

SELECT ALLOWED
	PurchaseOrdersOverridable.PurchaseOrder
INTO TueThereAreInvoices
FROM
	AccumulationRegister.PurchaseOrders AS PurchaseOrdersOverridable
WHERE
	PurchaseOrdersOverridable.Active
	AND PurchaseOrdersOverridable.RecordType = VALUE(AccumulationRecordType.Expense)
	AND PurchaseOrdersOverridable.PurchaseOrder IN
		(SELECT
			Table.PurchaseOrder
		FROM
			WRemainsOnTheOrder AS Table
		)
GROUP BY
	PurchaseOrdersOverridable.PurchaseOrder
HAVING
	SUM(PurchaseOrdersOverridable.ToRegister) > 0
INDEX BY
	PurchaseOrder
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	TableOverridable.PurchaseOrder AS Ref,
	MAX(CASE
		WHEN NOT TableThereAreInvoicesOverridable.PurchaseOrder IS NULL
			THEN 2
		ELSE 1
	END) AS InvoiceStatus
INTO WTheStateOfTheInvoice
FROM
	WRemainsOnTheOrder AS TableOverridable
		LEFT JOIN TueThereAreInvoices AS TableThereAreInvoicesOverridable
		ON (TableThereAreInvoicesOverridable.PurchaseOrder = TableOverridable.PurchaseOrder)
GROUP BY
	TableOverridable.PurchaseOrder

INDEX BY
	TableOverridable.PurchaseOrder
;
////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	PurchaseOrdersOverridable.Ref AS Ref,
	VALUETYPE(PurchaseOrdersOverridable.Ref) AS TypeOfOrder_,
	PurchaseOrdersOverridable.Date AS Date,
	PurchaseOrdersOverridable.Number AS Number,
	PurchaseOrdersOverridable.Partner AS Partner,
	PurchaseOrdersOverridable.Counterparty AS Counterparty,
	PurchaseOrdersOverridable.Organization AS Organization,
	PurchaseOrdersOverridable.Warehouse AS Warehouse,
	PurchaseOrdersOverridable.Terms AS Terms,
	PurchaseOrdersOverridable.Contract AS Contract,
	PurchaseOrdersOverridable.Currency AS Currency,
	PurchaseOrdersOverridable.Manager AS Manager,
	PurchaseOrdersOverridable.DocumentAmount AS DocumentAmount,
	PurchaseOrdersOverridable.Priority AS Priority,
	PurchaseOrdersOverridable.BusinessOperation AS BusinessOperation,
	PurchaseOrdersOverridable.GoodsReceiptOption AS GoodsReceiptOption,
	WTheStateOfTheInvoiceOverridable.InvoiceStatus AS PurchaseState,
	CASE
		WHEN PurchaseOrdersOverridable.Priority IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN PurchaseOrdersOverridable.Priority IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority
FROM
	Document.PurchaseOrder AS PurchaseOrdersOverridable
		INNER JOIN WTheStateOfTheInvoice AS WTheStateOfTheInvoiceOverridable
		ON (WTheStateOfTheInvoiceOverridable.Ref = PurchaseOrdersOverridable.Ref)</queryText>
      <mainTable>Document.PurchaseOrder</mainTable>
