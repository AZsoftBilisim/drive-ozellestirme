      <segments>ListReceiptReferences.PurchaseReceiptState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptReferences.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptReferences.ReferenceReceiptState</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptReferences.ThereAreProducts_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptReferences.ThereAreServices</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptReferences.TypeOfOrder_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptReferences.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	Table.DocumentInflow AS DocumentInflow,
	Table.Warehouse AS Warehouse,
	Table.BusinessOperation AS BusinessOperation,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	Table.ToRegisterReceiptsByReferenceBalance AS ToRegisterReceiptsByReferenceBalance,
	Table.Products.ItemsType IN (VALUE(Enum.ItemsTypes.Work_5), VALUE(Enum.ItemsTypes.OperationService)) AS ThereAreServices,
	NOT Table.Products.ItemsType IN (VALUE(Enum.ItemsTypes.Work_5), VALUE(Enum.ItemsTypes.OperationService)) AS ThereAreProducts_
INTO WBalancesToTheDesignOfTheRevenueByOrder
FROM
	AccumulationRegister.GoodsToReceive.Balance(
			,
			BusinessOperation IN (&amp;ListOfBusinessTransactions)
				AND (DocumentInflow REFS Document.PurchaseOrder
					OR DocumentInflow REFS Document.VendorInvoice
					OR DocumentInflow REFS Catalog.CounterpartyContracts
					OR DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors) {(Warehouse) AS Warehouse}) AS Table
WHERE
	Table.ToRegisterReceiptsByReferenceBalance &lt;> 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.DocumentInflow AS DocumentInflow,
	Table.Warehouse AS Warehouse,
	Table.BusinessOperation AS BusinessOperation,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	Table.ToRegisterReceiptsByInvoicesBalance AS ToRegisterReceiptsByInvoicesBalance
INTO WTheRemainsToTheRegistrationOfReceiptsOnInvoices
FROM
	AccumulationRegister.GoodsToReceive.Balance(
			,
			BusinessOperation IN (&amp;ListOfBusinessTransactions)
				AND (DocumentInflow REFS Document.PurchaseOrder
					OR DocumentInflow REFS Document.VendorInvoice
					OR DocumentInflow REFS Catalog.CounterpartyContracts
					OR DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors) {(Warehouse) AS Warehouse}) AS Table
WHERE
	Table.ToRegisterReceiptsByInvoicesBalance &lt;> 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.DocumentInflow AS DocumentInflow,
	Table.Warehouse AS Warehouse,
	Table.BusinessOperation AS BusinessOperation,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	FALSE AS FillInUsingInvoice,
	Table.ThereAreServices AS ThereAreServices,
	Table.ThereAreProducts_ AS ThereAreProducts_
INTO RequirementsForProcessingReceiptsByOrder
FROM
	WBalancesToTheDesignOfTheRevenueByOrder AS Table
WHERE
	Table.ToRegisterReceiptsByReferenceBalance > 0

UNION

SELECT
	Table.DocumentInflow,
	Table.Warehouse,
	Table.BusinessOperation,
	Table.Products,
	Table.Characteristic,
	Table.Purpose,
	Table.Series,
	TRUE,
	FALSE,
	FALSE
FROM
	WTheRemainsToTheRegistrationOfReceiptsOnInvoices AS Table
WHERE
	Table.ToRegisterReceiptsByInvoicesBalance > 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Table.DocumentInflow AS DocumentInflow,
	Table.Warehouse AS Warehouse,
	Table.Products AS Products,
	Table.BusinessOperation AS BusinessOperation,
	MAX(Table.ThereAreServices) AS ThereAreServices,
	MAX(Table.ThereAreProducts_) AS ThereAreProducts_
INTO TueReceiptDocuments
FROM
	WBalancesToTheDesignOfTheRevenueByOrder AS Table

GROUP BY
	Table.DocumentInflow,
	Table.BusinessOperation,
	Table.Warehouse,
	Table.Products

UNION

SELECT DISTINCT
	Table.DocumentInflow,
	Table.Warehouse,
	Table.Products,
	Table.BusinessOperation,
	FALSE,
	FALSE
FROM
	WTheRemainsToTheRegistrationOfReceiptsOnInvoices AS Table

INDEX BY
	DocumentInflow,
	Warehouse,
	Products,
	BusinessOperation
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Table.DocumentInflow AS DocumentInflow,
	Table.Warehouse AS Warehouse,
	Table.BusinessOperation AS BusinessOperation,
	MAX(Table.FillInUsingInvoice) AS FillInUsingInvoice,
	MAX(Table.ThereAreServices) AS ThereAreServices,
	MAX(Table.ThereAreProducts_) AS ThereAreProducts_
INTO WDispositionOfProceeds
FROM
	RequirementsForProcessingReceiptsByOrder AS Table

GROUP BY
	Table.DocumentInflow,
	Table.BusinessOperation,
	Table.Warehouse

INDEX BY
	DocumentInflow,
	Warehouse,
	BusinessOperation
	
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsToReceive.DocumentInflow AS DocumentInflow,
	GoodsToReceive.Warehouse AS Warehouse,
	GoodsToReceive.Products AS Products,
	GoodsToReceive.BusinessOperation AS BusinessOperation
INTO TueThereAreReceiptsOfGoods
FROM
	AccumulationRegister.GoodsToReceive AS GoodsToReceive
WHERE
	GoodsToReceive.Active
	AND GoodsToReceive.RecordType = VALUE(AccumulationRecordType.Expense)
	AND (GoodsToReceive.DocumentInflow, GoodsToReceive.Warehouse, GoodsToReceive.Products, GoodsToReceive.BusinessOperation) IN
			(SELECT
				Table.DocumentInflow AS DocumentInflow,
				Table.Warehouse AS Warehouse,
				Table.Products AS Products,
				Table.BusinessOperation AS BusinessOperation
			FROM
				TueReceiptDocuments AS Table)

GROUP BY
	GoodsToReceive.DocumentInflow,
	GoodsToReceive.Warehouse,
	GoodsToReceive.Products,
	GoodsToReceive.BusinessOperation

HAVING
	SUM(GoodsToReceive.ToRegisterReceiptsByReference) > 0

INDEX BY
	DocumentInflow,
	Warehouse,
	BusinessOperation
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsToReceive.DocumentInflow AS DocumentInflow,
	GoodsToReceive.Warehouse AS Warehouse,
	GoodsToReceive.BusinessOperation AS BusinessOperation
INTO TueThereAreInvoices
FROM
	AccumulationRegister.GoodsToReceive AS GoodsToReceive
WHERE
	GoodsToReceive.Active
	AND GoodsToReceive.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND (GoodsToReceive.DocumentInflow, GoodsToReceive.Warehouse, GoodsToReceive.BusinessOperation) IN
			(SELECT
				Table.DocumentInflow,
				Table.Warehouse,
				Table.BusinessOperation
			FROM
				TueReceiptDocuments AS Table)

GROUP BY
	GoodsToReceive.DocumentInflow,
	GoodsToReceive.Warehouse,
	GoodsToReceive.BusinessOperation

HAVING
	SUM(GoodsToReceive.ToRegisterReceiptsByInvoices) > 0

INDEX BY
	GoodsToReceive.DocumentInflow,
	GoodsToReceive.Warehouse,
	GoodsToReceive.BusinessOperation
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.DocumentInflow AS DocumentInflow,
	Table.BusinessOperation AS BusinessOperation,
	Table.Warehouse AS Warehouse,
	MAX(CASE
			WHEN TableThereAreReceiptsOfGoods.DocumentInflow IS NULL
				THEN 1
			ELSE 3
		END) AS ReceiptState,
	MAX(Table.ThereAreServices) AS ThereAreServices,
	MAX(Table.ThereAreProducts_) AS ThereAreProducts_
INTO VTStateIncome
FROM
	WBalancesToTheDesignOfTheRevenueByOrder AS Table
		LEFT JOIN TueThereAreReceiptsOfGoods AS TableThereAreReceiptsOfGoods
		ON (TableThereAreReceiptsOfGoods.DocumentInflow = Table.DocumentInflow)
			AND (TableThereAreReceiptsOfGoods.Warehouse = Table.Warehouse
				OR TableThereAreReceiptsOfGoods.Warehouse = VALUE(Catalog.Warehouses.EmptyRef))
			AND (TableThereAreReceiptsOfGoods.BusinessOperation = Table.BusinessOperation)

GROUP BY
	Table.DocumentInflow,
	Table.BusinessOperation,
	Table.Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.DocumentInflow AS DocumentInflow,
	Table.BusinessOperation AS BusinessOperation,
	Table.Warehouse AS Warehouse,
	MAX(CASE
			WHEN TableThereAreInvoices.DocumentInflow IS NULL
				THEN 1
			ELSE 3
		END) AS TueReceiptAcquisitionStatus,
	FALSE AS ThereAreServices,
	FALSE AS ThereAreProducts_
INTO TueInvoiceStatus
FROM
	WTheRemainsToTheRegistrationOfReceiptsOnInvoices AS Table
		LEFT JOIN TueThereAreInvoices AS TableThereAreInvoices
		ON (TableThereAreInvoices.DocumentInflow = Table.DocumentInflow)
			AND (TableThereAreInvoices.Warehouse = Table.Warehouse)
			AND (TableThereAreInvoices.BusinessOperation = Table.BusinessOperation)

GROUP BY
	Table.DocumentInflow,
	Table.BusinessOperation,
	Table.Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ISNULL(VTStateIncome.DocumentInflow, TueInvoiceStatus.DocumentInflow) AS DocumentInflow,
	ISNULL(TueInvoiceStatus.BusinessOperation, VTStateIncome.BusinessOperation) AS BusinessOperation,
	ISNULL(VTStateIncome.Warehouse, TueInvoiceStatus.Warehouse) AS Warehouse,
	MAX(CASE
			WHEN ISNULL(VTStateIncome.ReceiptState, 0) = 1
					AND TueInvoiceStatus.TueReceiptAcquisitionStatus IS NULL
				THEN 1
			ELSE ISNULL(TueInvoiceStatus.TueReceiptAcquisitionStatus, 0)
		END) AS StatusOfReceiptPurchaseAndNewOrders,
	MAX(ISNULL(VTStateIncome.ReceiptState, 0)) AS ReceiptState,
	MAX(ISNULL(VTStateIncome.ThereAreServices, TueInvoiceStatus.ThereAreServices)) AS ThereAreServices,
	MAX(ISNULL(VTStateIncome.ThereAreProducts_, TueInvoiceStatus.ThereAreProducts_)) AS ThereAreProducts_
INTO TueNewOrders
FROM
	VTStateIncome AS VTStateIncome
		FULL JOIN TueInvoiceStatus AS TueInvoiceStatus
		ON (VTStateIncome.DocumentInflow = TueInvoiceStatus.DocumentInflow)
			AND (VTStateIncome.Warehouse = TueInvoiceStatus.Warehouse)
			AND (VTStateIncome.BusinessOperation = TueInvoiceStatus.BusinessOperation)

GROUP BY
	ISNULL(VTStateIncome.DocumentInflow, TueInvoiceStatus.DocumentInflow),
	ISNULL(TueInvoiceStatus.BusinessOperation, VTStateIncome.BusinessOperation),
	ISNULL(VTStateIncome.Warehouse, TueInvoiceStatus.Warehouse)

INDEX BY
	DocumentInflow
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Ref
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Ref
		ELSE DocumentsRegistry.Ref
	END AS Ref,
	VALUETYPE(TableOfOrders.DocumentInflow.Ref) AS TypeOfOrder_,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Number
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Number
		ELSE DocumentsRegistry.IBDocumentNumber
	END AS Number,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Date
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Date
		ELSE DocumentsRegistry.IBDocumentDate
	END AS Date,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Partner
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Partner
		ELSE DocumentsRegistry.Partner
	END AS Partner,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Counterparty
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Counterparty
		ELSE CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)
	END AS Counterparty,
	TableOfOrders.BusinessOperation AS BusinessOperation,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Organization
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Organization
		ELSE DocumentsRegistry.Organization
	END AS Organization,
	TableOfOrders.Warehouse AS Warehouse,
	DocumentsRegistry.Sum AS DocumentAmount,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Currency
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).ARAPCurrency
		ELSE DocumentsRegistry.Currency
	END AS Currency,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Manager
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Manager
		ELSE DocumentsRegistry.EmployeeResponsible
	END AS Manager,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).DeletionMark
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).DeletionMark
		ELSE DocumentsRegistry.DeletionMark
	END AS DeletionMark,
	MAX(TableOfOrders.ReceiptState) AS GoodsReceiptState,
	MAX(TableOfOrders.StatusOfReceiptPurchaseAndNewOrders) AS PurchaseReceiptState,
	MAX(CASE
			WHEN DispositionOfProceeds.DocumentInflow IS NULL
				THEN 0
			ELSE 3
		END) AS ReferenceReceiptState,
	ISNULL(DispositionOfProceeds.FillInUsingInvoice, FALSE) AS FillInUsingInvoice,
	MAX(TableOfOrders.ThereAreServices) AS ThereAreServices,
	MAX(TableOfOrders.ThereAreProducts_) AS ThereAreProducts_
INTO TTTempTable
FROM
	TueNewOrders AS TableOfOrders
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON TableOfOrders.DocumentInflow = DocumentsRegistry.Ref
			AND (NOT DocumentsRegistry.AdditionalRecord)
		LEFT JOIN WDispositionOfProceeds AS DispositionOfProceeds
		ON TableOfOrders.DocumentInflow = DispositionOfProceeds.DocumentInflow
			AND TableOfOrders.BusinessOperation = DispositionOfProceeds.BusinessOperation
WHERE
	NOT TableOfOrders.DocumentInflow.Ref IS NULL

GROUP BY
	TableOfOrders.BusinessOperation,
	DocumentsRegistry.Sum,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Ref
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Ref
		ELSE DocumentsRegistry.Ref
	END,
	VALUETYPE(TableOfOrders.DocumentInflow.Ref),
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Number
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Number
		ELSE DocumentsRegistry.IBDocumentNumber
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Date
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Date
		ELSE DocumentsRegistry.IBDocumentDate
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Partner
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Partner
		ELSE DocumentsRegistry.Partner
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Counterparty
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Counterparty
		ELSE CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Organization
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Organization
		ELSE DocumentsRegistry.Organization
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Currency
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).ARAPCurrency
		ELSE DocumentsRegistry.Currency
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).Manager
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).Manager
		ELSE DocumentsRegistry.EmployeeResponsible
	END,
	CASE
		WHEN TableOfOrders.DocumentInflow REFS Catalog.TermsOfPurchaseFromVendors
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.TermsOfPurchaseFromVendors).DeletionMark
		WHEN TableOfOrders.DocumentInflow REFS Catalog.CounterpartyContracts
			THEN CAST(TableOfOrders.DocumentInflow AS Catalog.CounterpartyContracts).DeletionMark
		ELSE DocumentsRegistry.DeletionMark
	END,
	ISNULL(DispositionOfProceeds.FillInUsingInvoice, FALSE),
	TableOfOrders.Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTTempTable.Ref AS Ref,
	TTTempTable.TypeOfOrder_ AS TypeOfOrder_,
	TTTempTable.Number AS Number,
	TTTempTable.Date AS Date,
	TTTempTable.Partner AS Partner,
	TTTempTable.Counterparty AS Counterparty,
	TTTempTable.BusinessOperation AS BusinessOperation,
	TTTempTable.Organization AS Organization,
	TTTempTable.Warehouse AS Warehouse,
	TTTempTable.DocumentAmount AS DocumentAmount,
	TTTempTable.Currency AS Currency,
	TTTempTable.Manager AS Manager,
	TTTempTable.DeletionMark AS DeletionMark,
	TTTempTable.GoodsReceiptState AS GoodsReceiptState,
	TTTempTable.PurchaseReceiptState AS PurchaseReceiptState,
	TTTempTable.ReferenceReceiptState AS ReferenceReceiptState,
	TTTempTable.FillInUsingInvoice AS FillInUsingInvoice,
	TTTempTable.ThereAreServices AS ThereAreServices,
	TTTempTable.ThereAreProducts_ AS ThereAreProducts_
FROM TTTempTable AS TTTempTable</queryText>
