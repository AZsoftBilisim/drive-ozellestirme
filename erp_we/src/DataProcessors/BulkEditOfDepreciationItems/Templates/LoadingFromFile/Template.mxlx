					<f>8</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Fixed asset</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>دارایی ثابت</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Capitale fisso</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Środek trwały</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Основное средство</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Sabit kıymetler</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Tài sản cố định</v8:content>
						</v8:item>
					</tl>
					<note>
						<drawingType>Comment</drawingType>
						<id>0</id>
						<formatIndex>9</formatIndex>
						<text>
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Unique numeric or alphabetic designation of fixed assets
Type: Line (100 characters)
Example: Truck Mercedes Axor</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>نام‌گذاری یکتای عددی یا حرفی دارایی‌های ثابت
نوع: سطر (100 نویسه)
مثال: کامیون Mercedes Axor</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Designazione unica numerica o alfabetica del cespite
Tipo: Riga (100 caratteri)
Esempio: Camion Mercedes Axor</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Cyfrowe lub literowe oznaczenie unikalne ŚT
Typ: Wiersz (100 symboli)
Przykład: Ciężarówka Mercedes Axor</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Цифровое или буквенное уникальное обозначение ОС
Тип: Строка (100 симолов)
Пример: Грузовик Mercedes Axor</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Dijital veya alfabetik benzersiz sabit kıymet
 türü: Satır (100 karakter)
Örnek: Mercedes Axor Kamyonu</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Ký hiệu TSCĐ bằng số hoặc chữ đơn trị
Kiểu: Dòng (100 ký tự)
Ví dụ: Xe tải Mercedes Axor</v8:content>
							</v8:item>
						</text>
