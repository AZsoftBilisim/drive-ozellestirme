  <attributes uuid="7d2a37b1-a1a0-435a-846a-95e255655044">
    <name>ChangeInTransaction</name>
    <synonym>
      <key>en</key>
      <value>Edit in transaction</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>ویرایش در تراکنش</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Modifica in una transazione</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Zmieniaj w transakcji</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Изменять в транзакции</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>İşlemde değiştir</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Thay đổi trong giao tác</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>If edit in transaction fails, all changes are discarded.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>اگر ویرایش در تراکنش ناموفق باشد، همه تغییرات کنار گذاشته می‌شوند.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se non è possibile modificare gli elementi in una transazione, tutte le modifiche verranno annullate.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli nie możesz zmienić elementów w transakcji, wszystkie zmiany zostaną odrzucone.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>При невозможности изменения элементов в транзакции, все изменения будут отменены.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>İşlemde öğeler değiştirilemezse, tüm değişiklikler iptal edilir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Khi không thể thay đổi phần tử trong giao tác, sẽ hủy tất cả thay đổi.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
  </attributes>
  <attributes uuid="109db64c-00dc-490e-99a5-4430d9344e99">
    <name>InterruptOnError</name>
    <synonym>
      <key>en</key>
      <value>Abort on error</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>توقف در صورت خطا</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Interrompi in caso di errore</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Przerwij jeśli wystąpi błąd</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Прерывать при ошибке</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Hata oluşursa iptal et</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Dừng khi lỗi</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Notify when edit errors occur.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>اطلاع‌رسانی هنگام بروز خطاهای ویرایش.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Avvisa se si verificano errori durante la modifica degli elementi.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Ostrzegać, jeśli wystąpią błędy podczas zmiany elementów.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Предупреждать, если во время изменения элементов возникнут ошибки.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Öğeleri değiştirirken hata oluşursa uyar.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Cảnh báo, nếu khi thay đổi phần tử có xuất hiện lỗi.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
  </attributes>
