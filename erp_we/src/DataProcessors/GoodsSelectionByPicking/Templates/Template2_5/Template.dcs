				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	ItemKinds.Ref AS ProductKind,
	ItemKinds.SettingsOfPriceKeyByItemVariant AS SettingsOfPriceKeyByItemVariant,
	ItemKinds.SettingsOfPriceKeyByBatch AS SettingsOfPriceKeyByBatch,
	ItemKinds.SettingsOfPriceKeyByPackage AS SettingsOfPriceKeyByPackage,
	CASE
		WHEN ItemKinds.BatchOwner = VALUE(Catalog.ItemKinds.EmptyRef)
			THEN ItemKinds.Ref
		ELSE ItemKinds.BatchOwner
	END AS BatchOwner
INTO ItemKinds
FROM
	Catalog.ItemKinds AS ItemKinds
{WHERE
	ItemKinds.Ref.* AS ProductKind}
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ItemKinds.ProductKind AS ProductKind,
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE Segments.Characteristic.ItemsCharacteristicForPricing
	END AS PricingVariant,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
		INNER JOIN ItemKinds AS ItemKinds
		ON Segments.Products.ProductKind = ItemKinds.ProductKind
{WHERE
	ItemKinds.ProductKind.*,
	Segments.Segment.* AS ProductSegment,
	Segments.Products.ProductKind.* AS ProductKind,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic,
	Segments.Characteristic.ItemsCharacteristicForPricing.* AS PricingVariant}

INDEX BY
	Products,
	Characteristic,
	PricingVariant,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceTable.Products.ProductKind AS ProductKind,
	BalanceTable.Products AS Products,
	BalanceTable.Characteristic AS Characteristic,
	BalanceTable.Characteristic.ItemsCharacteristicForPricing AS PricingVariant,
	BalanceTable.Series AS Series,
	BalanceTable.Series.ItemsBatchForPricing AS PricingBatch,
	BalanceTable.InStockBalance AS InStockBalance
INTO SelectionTableByBalance
FROM
	AccumulationRegister.ProductStock.Balance({&amp;DateOfReceiptOfBalances}, {TRUE AS OnlyInStock} {(Warehouse).* AS Warehouse} {(Products).* AS
		Products} {(Characteristic).* AS Characteristic} {(Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
		{(Warehouse).* AS Warehouse} {(Products).* AS Products} {(Characteristic).* AS Characteristic} {NOT (Products,
		Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}) AS
		BalanceTable

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Subquery.ProductKind AS ProductKind,
	Subquery.Products AS Products,
	Subquery.Characteristic AS Characteristic,
	Subquery.PricingVariant AS PricingVariant,
	Subquery.Series AS Series,
	Subquery.PricingBatch AS PricingBatch,
	SUM(Subquery.InStockBalance) AS InStockBalance
INTO RawData
FROM
	(SELECT
		ItemKinds.ProductKind AS ProductKind,
		Products.Ref AS Products,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
		VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef) AS PricingVariant,
		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
		0 AS InStockBalance
	FROM
		Catalog.Products AS Products
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
	WHERE
		NOT Products.IsFolder
		AND
			Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
	{WHERE
		FALSE AS OnlyInStock,
		(Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
		NOT (Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}

	UNION ALL

	SELECT
		ItemKinds.ProductKind,
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END,
		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
		0 AS InStockBalance
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON Products.Ref = ItemsCharacteristics.Owner
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
	WHERE
		Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
	{WHERE
		FALSE AS OnlyInStock,
		(Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
		NOT (Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}

	UNION ALL

	SELECT
		ItemKinds.ProductKind,
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END,
		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
		0 AS InStockBalance
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON Products.ProductKind = ItemsCharacteristics.Owner
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
	WHERE
		Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
	{WHERE
		FALSE AS OnlyInStock,
		(Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
		NOT (Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}

	UNION ALL

	SELECT
		ItemKinds.ProductKind,
		Products.Ref,
		ItemsCharacteristics.Ref,
		CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsCharacteristics.ItemsCharacteristicForPricing
		END,
		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
		0 AS InStockBalance
	FROM
		Catalog.ItemsCharacteristics AS ItemsCharacteristics
			INNER JOIN Catalog.Products AS Products
			ON Products.ItemVariantsOwner = ItemsCharacteristics.Owner
			INNER JOIN ItemKinds AS ItemKinds
			ON Products.ProductKind = ItemKinds.ProductKind
	WHERE
		Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
	{WHERE
		FALSE AS OnlyInStock,
		(Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
		NOT (Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}

	UNION ALL

	SELECT
		SelectionTableByBalance.ProductKind AS ProductKind,
		SelectionTableByBalance.Products AS Products,
		SelectionTableByBalance.Characteristic AS Characteristic,
		CASE
			WHEN SelectionTableByBalance.ProductKind.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE SelectionTableByBalance.PricingVariant
		END AS PricingVariant,
		SelectionTableByBalance.Series AS Series,
		CASE
			WHEN SelectionTableByBalance.ProductKind.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
			ELSE SelectionTableByBalance.PricingBatch
		END AS PricingBatch,
		SelectionTableByBalance.InStockBalance AS InStockBalance
	FROM
		SelectionTableByBalance AS SelectionTableByBalance) AS Subquery
GROUP BY
	Subquery.ProductKind,
	Subquery.Products,
	Subquery.Characteristic,
	Subquery.PricingVariant,
	Subquery.Series,
	Subquery.PricingBatch

INDEX BY
	Products,
	Characteristic,
	PricingVariant,
	Series,
	PricingBatch
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	RawData.Products AS Products
INTO RawDataForPackaging
FROM
	RawData AS RawData
		INNER JOIN ItemKinds AS ItemKinds
		ON RawData.ProductKind = ItemKinds.ProductKind
WHERE
	ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.Use)

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.Products AS Products,
	NestedQuery.Package AS Package,
	NestedQuery.DeletionMark AS DeletionMark,
	NestedQuery.Description AS PackagePresentation,
	MAX(NestedQuery.ItIsUnitOfStorage) AS ItIsUnitOfStorage,
	MAX(NestedQuery.Order) AS PackingProcedure
INTO PackingTable_
FROM
	(SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		TRUE AS ItIsUnitOfStorage,
		1 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogProducts.UnitOfMeasure = CatalogPackages.Ref

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		1 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CASE
				WHEN CatalogProducts.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
					THEN CatalogPackages.Owner = CatalogProducts.Ref
				WHEN CatalogProducts.PackagingGroup &lt;&gt; VALUE(Catalog.PackagingGroups.EmptyRef)
					THEN CatalogPackages.Owner = CatalogProducts.PackagingGroup
				ELSE FALSE
			END
	WHERE
		NOT CatalogPackages.DeletionMark
		AND CatalogPackages.PackageType &lt;&gt; VALUE(Enum.TypesOfItemsPackages.CargoItem)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		3 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogProducts.WeightUse
			AND CatalogProducts.YouCanSpecifyWeightInDocuments
			AND CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		4 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogProducts.VolumeUse
			AND CatalogProducts.VolumeCanBeSpecifiedInDocuments
			AND CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.VolumeM3)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.VolumeM3)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		5 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogProducts.LengthUse
			AND CatalogProducts.YouCanSpecifyLengthInDocuments
			AND CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Length)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Length)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		6 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogProducts.AreaUse
			AND CatalogProducts.AreaCanBeSpecifiedInDocuments
			AND CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		7 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Capacity)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Capacity)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		8 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Energy)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Energy)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		9 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.ElectricCharge)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.ElectricCharge)

	UNION ALL

	SELECT
		CatalogProducts.Ref AS Products,
		CatalogPackages.Ref AS Package,
		CatalogPackages.DeletionMark AS DeletionMark,
		CatalogPackages.Description AS Description,
		FALSE AS ItIsUnitOfStorage,
		10 AS Order
	FROM
		RawDataForPackaging AS RawDataForPackaging
			INNER JOIN Catalog.Products AS CatalogProducts
			ON RawDataForPackaging.Products = CatalogProducts.Ref
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS CatalogPackages
			ON CatalogPackages.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Time)
	WHERE
		CatalogProducts.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Time)) AS
		NestedQuery
GROUP BY
	NestedQuery.Products,
	NestedQuery.Package,
	NestedQuery.DeletionMark,
	NestedQuery.Description

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemKinds.ProductKind AS ProductKind,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	ItemsBatchesForPricing.Ref AS PricingBatch
INTO TableOfNomenclatureSeries
FROM
	ItemKinds AS ItemKinds
		LEFT JOIN Catalog.ItemsBatchesForPricing AS ItemsBatchesForPricing
		ON ItemsBatchesForPricing.Predefined
{WHERE
	FALSE AS OnlyInStock}

UNION ALL

SELECT
	ItemKinds.ProductKind,
	CASE
		WHEN ItemsBatches.Ref IS NULL
			THEN VALUE(Catalog.ItemsBatches.EmptyRef)
		ELSE ItemsBatches.Ref
	END,
	CASE
		WHEN ItemsBatches.Ref IS NULL
		OR ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE ItemsBatches.ItemsBatchForPricing
	END
FROM
	ItemKinds AS ItemKinds
		LEFT JOIN Catalog.ItemsBatches AS ItemsBatches
		ON ItemKinds.BatchOwner = ItemsBatches.ProductKind
WHERE
	ItemKinds.SettingsOfPriceKeyByBatch &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
{WHERE
	FALSE AS OnlyInStock}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RawData.ProductKind AS ProductKind,
	RawData.Products AS Products,
	RawData.Characteristic AS Characteristic,
	RawData.PricingVariant AS PricingVariant,
	RawData.InStockBalance AS InStockBalance,
	ISNULL(TableOfNomenclatureSeries.Series, RawData.Series) AS Series,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE ISNULL(TableOfNomenclatureSeries.PricingBatch, RawData.PricingBatch)
	END AS PricingBatch,
	CASE
		WHEN PackingTable_.Package IS NULL
		OR PackingTable_.Package = RawData.Products.UnitOfMeasure
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		WHEN PackingTable_.Package IS NOT NULL
			THEN PackingTable_.Package
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS Package,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.Use)
			THEN CASE
				WHEN PackingTable_.Package IS NULL
					THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				ELSE PackingTable_.Package
			END
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS PricingPackage,
	PackingTable_.PackingProcedure AS PackingProcedure
INTO SourceDataSupplemented
FROM
	RawData AS RawData
		INNER JOIN ItemKinds AS ItemKinds
		ON RawData.ProductKind = ItemKinds.ProductKind
		{LEFT JOIN PackingTable_ AS PackingTable_
		ON ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.Use)
		AND RawData.Products = PackingTable_.Products}
		LEFT JOIN TableOfNomenclatureSeries AS TableOfNomenclatureSeries
		ON ItemKinds.ProductKind = TableOfNomenclatureSeries.ProductKind
{WHERE
	TableOfNomenclatureSeries.Series.*,
	(CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		WHEN PackingTable_.Package IS NOT NULL
			THEN PackingTable_.Package
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END).* AS PricingPackage}

INDEX BY
	ProductKind,
	Products,
	Characteristic,
	PricingVariant,
	Series,
	PricingBatch,
	Package,
	PricingPackage
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SourceDataLastRequest.ProductKind AS ProductKind,
	SourceDataLastRequest.Products AS Products,
	SourceDataLastRequest.Characteristic AS Characteristic,
	SourceDataLastRequest.PricingVariant AS PricingVariant,
	SourceDataLastRequest.Series AS Series,
	SourceDataLastRequest.PricingBatch AS PricingBatch,
	SourceDataLastRequest.Package AS Package,
	SourceDataLastRequest.PricingPackage AS PricingPackage,
	TRUE AS ArbitraryFilter,
	&amp;PlanProfile AS PlanProfile,
	MAX(1) AS Count,
	SUM(ISNULL(ISNULL(ProductStockBalance.InStockBalance, SourceDataLastRequest.InStockBalance),
		0)) AS Balance,
	ProductRange.PlanningObject AS PlanningObject,
	MAX(Prices.MarketingActivity) AS MarketingActivity,
	MAX(CASE
		WHEN Prices.Price IS NULL
		OR Prices.Price = 0
			THEN FALSE
		ELSE TRUE
	END) AS PriceIsSet,
	MAX(ProductRange.ProductRangeRole) AS ProductRangeRole,
	MAX(ProductRange.PurchasesAreAllowed) AS PurchasesAreAllowed,
	MAX(ProductRange.SalesAreAllowed) AS SalesAreAllowed,
	SourceDataLastRequest.PackingProcedure AS PackingProcedure
{SELECT
	ProductKind.*,
	Products.*,
	Characteristic.*,
	PricingVariant.*,
	Series.*,
	PricingBatch.*,
	PricingPackage.*,
	Count,
	Balance,
	MarketingActivity.*,
	PriceIsSet,
	PlanningObject,
	ProductRangeRole,
	PurchasesAreAllowed,
	SalesAreAllowed}
FROM
	SourceDataSupplemented AS SourceDataLastRequest
		{LEFT JOIN AccumulationRegister.ProductStock.Balance({&amp;DateOfReceiptOfBalances}, {(Warehouse).* AS Warehouse} {(Products).* AS
			Products} {(Characteristic).* AS Characteristic} {(Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			{(Warehouse).* AS Warehouse} {(Products).* AS Products} {(Characteristic).* AS Characteristic} {NOT
			(Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}) AS
			ProductStockBalance
		ON SourceDataLastRequest.Products = ProductStockBalance.Products
		AND SourceDataLastRequest.Characteristic = ProductStockBalance.Characteristic
		AND (SourceDataLastRequest.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		OR ProductStockBalance.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		OR SourceDataLastRequest.Series = ProductStockBalance.Series)}
		{LEFT JOIN InformationRegister.ProductRange.SliceLast(&amp;ProductRangeAsOfDate,) AS ProductRange
		ON SourceDataLastRequest.Products = ProductRange.Products}
		{LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(&amp;PricesAsOfDate, {(PriceKind).* AS PriceTypeRange}
			{(Products).* AS Products} {(PricingVariant).* AS PricingVariant} {(Products, PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			{(PriceKind).* AS PriceTypeRange} {(Products).* AS Products} {(PricingVariant).* AS PricingVariant}
			{NOT (Products, PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)}) AS
			Prices
		ON SourceDataLastRequest.Products = Prices.Products
		AND SourceDataLastRequest.PricingVariant = Prices.PricingVariant
		AND SourceDataLastRequest.PricingBatch = Prices.PricingBatch
		AND SourceDataLastRequest.PricingPackage = Prices.PricingPackage}
		{LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
		ON ProductKitConfigurations.Owner = SourceDataLastRequest.Products
		AND ProductKitConfigurations.Owner.ItemsType = VALUE(Enum.ItemsTypes.Set)
		AND ProductKitConfigurations.Characteristic = SourceDataLastRequest.Characteristic}
{WHERE
	SourceDataLastRequest.ProductKind.* AS ProductKind,
	SourceDataLastRequest.Characteristic.* AS Characteristic,
	SourceDataLastRequest.PricingVariant.*,
	SourceDataLastRequest.Series.*,
	SourceDataLastRequest.PricingBatch.*,
	SourceDataLastRequest.PricingPackage.*,
	ISNULL(ISNULL(ProductStockBalance.InStockBalance, SourceDataLastRequest.InStockBalance), 0) AS
		Balance,
	ISNULL(ProductKitConfigurations.SetPricingOption,
		VALUE(Enum.SetPriceCalculationOptions.EmptyRef)) AS SetPricingOption,
	ISNULL(Prices.MarketingActivity, VALUE(Catalog.MarketingActivities.EmptyRef)) AS
		MarketingActivity,
	ProductRange.PlanningObject AS PlanningObject,
	ProductRange.ItemsCollection AS ItemsCollection,
	ProductRange.SalesAreAllowed AS SalesAreAllowed,
	CASE
		WHEN Prices.Price IS NULL
		OR Prices.Price = 0
			THEN FALSE
		ELSE TRUE
	END AS PriceIsSet,
	Prices.Price AS Price,
	Prices.Price AS PriceFrom,
	Prices.Price AS PriceUpTo,
	SourceDataLastRequest.Products.KeepRecordsOfQualityCertificates = &amp;KeepRecordsOfQualityCertificates,
	Prices.MarketingActivity.*}
GROUP BY
	SourceDataLastRequest.ProductKind,
	SourceDataLastRequest.Products,
	SourceDataLastRequest.Characteristic,
	SourceDataLastRequest.PricingVariant,
	ProductRange.PlanningObject,
	SourceDataLastRequest.Series,
	SourceDataLastRequest.PricingBatch,
	SourceDataLastRequest.Package,
	SourceDataLastRequest.PricingPackage,
	SourceDataLastRequest.PackingProcedure</query>
	</dataSet>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>فیلتر بر اساس بخش قلم استفاده می‌شود</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Viene utilizzata la selezione per segmento degli articoli</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jest używany filtr wg segmentu wierszy pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Используется отбор по сегменту номенклатуры</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok segmentine göre filtre kullanılmaktadır</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sử dụng lọc theo phân khúc mặt hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>PlanProfile</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Plan profile</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پروفایل برنامه</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Tipo di piano</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
