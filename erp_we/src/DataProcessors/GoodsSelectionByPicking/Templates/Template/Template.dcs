	</parameter>
	<parameter>
		<name>KeepRecordsOfQualityCertificates</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Keep records of quality certificates</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
