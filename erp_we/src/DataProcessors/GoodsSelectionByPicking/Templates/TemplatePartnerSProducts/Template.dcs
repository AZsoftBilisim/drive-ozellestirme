		<field xsi:type="DataSetFieldField">
			<dataPath>Partner</dataPath>
			<field>Partner</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductCrossReferences.Ref         AS PartnerProducts,
	ProductCrossReferences.Products   AS Products,
	ProductCrossReferences.Products.ProductKind AS ProductKind,
	ProductCrossReferences.Characteristic AS Characteristic
INTO InitialDataProductOfPostashchikov
FROM
	Catalog.ProductCrossReferences AS ProductCrossReferences
WHERE
	NOT ProductCrossReferences.IsFolder
{WHERE
	((ProductCrossReferences.Products, ProductCrossReferences.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	NOT ((ProductCrossReferences.Products, ProductCrossReferences.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)),
	ProductCrossReferences.Owner = &amp;Vendor}

INDEX BY
	PartnerProducts,
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.PartnerProducts AS PartnerProducts,
	T.Products           AS Products,
	T.ProductKind        AS ProductKind,
	T.Characteristic         AS Characteristic
INTO RawData
FROM
	InitialDataProductOfPostashchikov AS T
WHERE
	T.Products &lt;&gt; VALUE(Catalog.Products.EmptyRef)
	AND T.Products.ItemsType &lt;&gt; VALUE(Enum.ItemsTypes.Set)

UNION ALL

SELECT
	VALUE(Catalog.ProductCrossReferences.EmptyRef) AS PartnerProducts,
	Products.Ref AS Products,
	Products.ProductKind AS ProductKind,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic
FROM
	Catalog.Products AS Products
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
	AND (Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) NOT IN (SELECT T.Products, T.Characteristic FROM InitialDataProductOfPostashchikov AS T)
	AND Products.ItemsType &lt;&gt; VALUE(Enum.ItemsTypes.Set)
{WHERE
	((Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	NOT ((Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}

UNION ALL

SELECT
	VALUE(Catalog.ProductCrossReferences.EmptyRef) AS PartnerProducts,
	Products.Ref,
	Products.ProductKind,
	ItemsCharacteristics.Ref
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics
		INNER JOIN Catalog.Products AS Products
		ON (Products.Ref = ItemsCharacteristics.Owner)
WHERE
	Products.UseVariants IN (VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems))
	AND (Products.Ref, ItemsCharacteristics.Ref) NOT IN (SELECT T.Products, T.Characteristic FROM InitialDataProductOfPostashchikov AS T)
	AND Products.ItemsType &lt;&gt; VALUE(Enum.ItemsTypes.Set)
{WHERE
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	NOT ((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}

UNION ALL

SELECT
	VALUE(Catalog.ProductCrossReferences.EmptyRef) AS PartnerProducts,
	Products.Ref,
	Products.ProductKind,
	ItemsCharacteristics.Ref
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics
		INNER JOIN Catalog.Products AS Products
		ON (Products.ProductKind = ItemsCharacteristics.Owner)
WHERE
	Products.UseVariants IN (VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind))
	AND (Products.Ref, ItemsCharacteristics.Ref) NOT IN (SELECT T.Products, T.Characteristic FROM InitialDataProductOfPostashchikov AS T)
	AND Products.ItemsType &lt;&gt; VALUE(Enum.ItemsTypes.Set)
{WHERE
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	NOT ((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}

UNION ALL

SELECT
	VALUE(Catalog.ProductCrossReferences.EmptyRef) AS PartnerProducts,
	Products.Ref,
	Products.ProductKind,
	ItemsCharacteristics.Ref
FROM
	Catalog.ItemsCharacteristics AS ItemsCharacteristics
		INNER JOIN Catalog.Products AS Products
		ON (Products.ItemVariantsOwner = ItemsCharacteristics.Owner)
WHERE
	Products.UseVariants IN (VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	AND (Products.Ref, ItemsCharacteristics.Ref) NOT IN (SELECT T.Products, T.Characteristic FROM InitialDataProductOfPostashchikov AS T)
	AND Products.ItemsType &lt;&gt; VALUE(Enum.ItemsTypes.Set)
{WHERE
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	NOT ((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}

INDEX BY
	PartnerProducts,
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SourceDataLastRequest.PartnerProducts AS PartnerProducts,
	SourceDataLastRequest.Products AS Products,
	SourceDataLastRequest.Characteristic AS Characteristic,
	MAX(1) AS Count,
	MAX(ProductStockBalance.InStockBalance) AS Balance,
	ProductRange.PlanningObject AS PlanningObject,
	MAX(ProductRange.ProductRangeRole) AS ProductRangeRole,
	MAX(ProductRange.PurchasesAreAllowed) AS PurchasesAreAllowed,
	MAX(ProductRange.SalesAreAllowed) AS SalesAreAllowed
{SELECT
	Products.*,
	Characteristic.*,
	Count,
	Balance,
	PlanningObject,
	ProductRangeRole,
	PurchasesAreAllowed,
	SalesAreAllowed}
FROM
	RawData AS SourceDataLastRequest
		{LEFT JOIN AccumulationRegister.ProductStock.Balance(, {(Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic, ((Products, Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}{(Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic, NOT ((Products, Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}) AS ProductStockBalance
		ON SourceDataLastRequest.Products = ProductStockBalance.Products
			AND SourceDataLastRequest.Characteristic = ProductStockBalance.Characteristic}
		{LEFT JOIN InformationRegister.ProductRange.SliceLast(&amp;ProductRangeAsOfDate, ) AS ProductRange
		ON SourceDataLastRequest.Products = ProductRange.Products}
		
		{LEFT JOIN InformationRegister.ItemsPricesOfVendor.SliceLast(&amp;PricesAsOfDate,
		{(VendorPriceKind).* AS PriceTypeRange, (Products).* AS Products, (Characteristic).* AS Characteristic, ((Products, Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
		{(VendorPriceKind).* AS PriceTypeRange, (Products).* AS Products, (Characteristic).* AS Characteristic, NOT ((Products, Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}
		) AS Prices
		ON SourceDataLastRequest.Products = Prices.Products
		 AND SourceDataLastRequest.Characteristic = Prices.Characteristic}
		
{WHERE
	SourceDataLastRequest.Products.* AS Products,
	SourceDataLastRequest.Characteristic.* AS Characteristic,
	ProductStockBalance.InStockBalance AS Balance,
	ProductRange.PlanningObject AS PlanningObject,
	ProductRange.ItemsCollection AS ItemsCollection,
	ProductRange.SalesAreAllowed AS SalesAreAllowed,
	Prices.Price AS Price,
	Prices.Price AS PriceFrom,
	Prices.Price AS PriceUpTo,
	(SourceDataLastRequest.Products.KeepRecordsOfQualityCertificates = &amp;KeepRecordsOfQualityCertificates)}

GROUP BY
	SourceDataLastRequest.PartnerProducts,
	SourceDataLastRequest.Products,
	SourceDataLastRequest.Characteristic,
	ProductRange.PlanningObject</query>
	</dataSet>
