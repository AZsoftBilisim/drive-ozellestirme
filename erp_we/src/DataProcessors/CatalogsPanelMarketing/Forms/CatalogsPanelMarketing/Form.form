  <formCommands>
    <name>OpenPriceGroups</name>
    <title>
      <key>en</key>
      <value>Price groups</value>
    </title>
    <title>
      <key>fa</key>
      <value>گروه‌های قیمت</value>
    </title>
    <title>
      <key>it</key>
      <value>Gruppi prezzi</value>
    </title>
    <title>
      <key>pl</key>
      <value>Grupy cenowe</value>
    </title>
    <title>
      <key>ru</key>
      <value>Ценовые группы</value>
    </title>
    <title>
      <key>tr</key>
      <value>Fiyat grupları</value>
