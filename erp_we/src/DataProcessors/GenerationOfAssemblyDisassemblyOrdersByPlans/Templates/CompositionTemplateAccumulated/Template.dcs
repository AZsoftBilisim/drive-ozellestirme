		<field xsi:type="DataSetFieldField">
			<dataPath>PlanProfile</dataPath>
			<field>PlanProfile</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentProducts.Products AS Products,
	SegmentProducts.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS SegmentProducts
{WHERE
	SegmentProducts.Segment.* AS ProductSegment,
	SegmentProducts.Products.*,
	SegmentProducts.Characteristic.*}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.DayPeriod, DAY)
	END AS AssemblyEndDate,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN AssemblyPlansDisassemblyRevolutions.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN AssemblyPlansDisassemblyRevolutions.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN AssemblyPlansDisassemblyRevolutions.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN AssemblyPlansDisassemblyRevolutions.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN AssemblyPlansDisassemblyRevolutions.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN AssemblyPlansDisassemblyRevolutions.YearPeriod
		ELSE AssemblyPlansDisassemblyRevolutions.DayPeriod
	END AS AssemblyPeriodStart,
	AssemblyPlansDisassemblyRevolutions.Products AS Products,
	AssemblyPlansDisassemblyRevolutions.Characteristic AS Characteristic,
	AssemblyPlansDisassemblyRevolutions.Purpose AS Purpose,
	AssemblyPlansDisassemblyRevolutions.Warehouse AS Warehouse,
	AssemblyPlansDisassemblyRevolutions.ProductKit AS ProductKit,
	AssemblyPlansDisassemblyRevolutions.BusinessOperation AS BusinessOperation,
	AssemblyPlansDisassemblyRevolutions.ToOrderTurnover AS QuantityInPlans,
	ISNULL(Approaches.OrderFulfillmentPeriod, AssemblyPlansDisassemblyRevolutions.ProductKit.AssemblyDisassemblyDurationDays) AS DaysBeforeOrdering,
	ISNULL(Approaches.ProductionDurationDays, AssemblyPlansDisassemblyRevolutions.ProductKit.AssemblyDisassemblyDurationDays) AS AssemblyDisassemblyDurationDays,
	CASE
		WHEN ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
			THEN MainEnterpriseCalendar.Value
		ELSE ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef))
	END AS Calendar,
	ISNULL(Approaches.Ref, VALUE(Catalog.ProcurementStrategies.EmptyRef)) AS SupplyMethod,
	ProductKitConfigurations.Count AS NumberOfKitsInProductKitConfiguration
INTO TableOfPlans
FROM
	AccumulationRegister.AssemblyDisassemblyPlans.Turnovers(
			&amp;BeginOfPeriod,
			&amp;PeriodEnding,
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND (Warehouse = &amp;Warehouse
					OR NOT &amp;FilterWarehouse)
				AND (NOT &amp;FilterByAssignment
					OR Purpose = &amp;Purpose) {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (BusinessOperation), (AssemblyDisassemblyPlan)}) AS AssemblyPlansDisassemblyRevolutions
		LEFT JOIN Catalog.ProcurementStrategies AS Approaches
		ON &amp;MainSupplyMethodSubstitution
			AND (Approaches.SupplyType = VALUE(Enum.SupplyTypes.AssemblyDisassembly))
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON AssemblyPlansDisassemblyRevolutions.Warehouse = Warehouses.Ref
		LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
		ON AssemblyPlansDisassemblyRevolutions.ProductKit = ProductKitConfigurations.Ref,
	Constant.MainEnterpriseCalendar AS MainEnterpriseCalendar

INDEX BY
	Products,
	Characteristic,
	Purpose,
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.Calendar AS Calendar,
	CalendarSchedules.Year AS Year,
	MAX(CalendarSchedules.DaysCountInScheduleSinceBegOfYear) AS DaysCountInScheduleSinceBegOfYear
INTO ChartsNumberOfDaysInPastYear
FROM
	TableOfPlans AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS CalendarSchedules
		ON TableOfPlans.Calendar = CalendarSchedules.Calendar
			AND (YEAR(TableOfPlans.AssemblyEndDate) - 1 = CalendarSchedules.Year)
WHERE
	CalendarSchedules.Year &gt; 0

GROUP BY
	TableOfPlans.Calendar,
	CalendarSchedules.Year
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.AssemblyEndDate AS AssemblyEndDate,
	TableOfPlans.AssemblyPeriodStart AS AssemblyPeriodStart,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	TableOfPlans.Warehouse AS Warehouse,
	TableOfPlans.ProductKit AS ProductKit,
	TableOfPlans.BusinessOperation AS BusinessOperation,
	TableOfPlans.Calendar AS Calendar,
	SUM(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	CASE
		WHEN ScheduleBuildDate.ScheduleDate IS NULL
			THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.DaysBeforeOrdering)
		ELSE ScheduleOrderDate.ScheduleDate
	END AS OrderDate,
	TableOfPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	TableOfPlans.AssemblyDisassemblyDurationDays AS AssemblyDisassemblyDurationDays,
	TableOfPlans.SupplyMethod AS SupplyMethod,
	CASE
		WHEN ScheduleBuildDate.ScheduleDate IS NULL
			THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.AssemblyDisassemblyDurationDays)
		ELSE ScheduleBuildEndDate.ScheduleDate
	END AS AssemblyStartDate,
	CASE
		WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS EditWarehouse,
	TableOfPlans.NumberOfKitsInProductKitConfiguration AS NumberOfKitsInProductKitConfiguration
INTO TableOfPlans1
FROM
	TableOfPlans AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleBuildDate
		ON TableOfPlans.Calendar = ScheduleBuildDate.Calendar
			AND TableOfPlans.AssemblyEndDate = ScheduleBuildDate.ScheduleDate
			AND (YEAR(TableOfPlans.AssemblyEndDate) = ScheduleBuildDate.Year)
		LEFT JOIN ChartsNumberOfDaysInPastYear AS ChartsLastYear
		ON (YEAR(TableOfPlans.AssemblyEndDate) - 1 = ChartsLastYear.Year)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN TRUE
				ELSE FALSE
			END)
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleOrderDate
		ON TableOfPlans.Calendar = ScheduleOrderDate.Calendar
			AND (ScheduleOrderDate.DayAddedToSchedule)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN YEAR(TableOfPlans.AssemblyEndDate) - 1 = ScheduleOrderDate.Year
				ELSE YEAR(TableOfPlans.AssemblyEndDate) = ScheduleOrderDate.Year
			END)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN CASE
							WHEN ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.DaysBeforeOrdering - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) &lt;= 0
								THEN ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear = 1
							ELSE ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.DaysBeforeOrdering - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) = ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear
						END
				ELSE ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) - TableOfPlans.DaysBeforeOrdering = ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear
			END)
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleBuildEndDate
		ON TableOfPlans.Calendar = ScheduleBuildEndDate.Calendar
			AND (ScheduleBuildEndDate.DayAddedToSchedule)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.AssemblyDisassemblyDurationDays
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN YEAR(TableOfPlans.AssemblyEndDate) - 1 = ScheduleBuildEndDate.Year
				ELSE YEAR(TableOfPlans.AssemblyEndDate) = ScheduleBuildEndDate.Year
			END)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.AssemblyDisassemblyDurationDays
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN CASE
							WHEN ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.AssemblyDisassemblyDurationDays - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) &lt;= 0
								THEN ScheduleBuildEndDate.DaysCountInScheduleSinceBegOfYear = 1
							ELSE ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.AssemblyDisassemblyDurationDays - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) = ScheduleBuildEndDate.DaysCountInScheduleSinceBegOfYear
						END
				ELSE ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) - TableOfPlans.AssemblyDisassemblyDurationDays = ScheduleBuildEndDate.DaysCountInScheduleSinceBegOfYear
			END)
WHERE
	CASE
			WHEN &amp;OrderPeriodStart = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE CASE
					WHEN ScheduleBuildDate.ScheduleDate IS NULL
						THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.DaysBeforeOrdering)
					ELSE ScheduleOrderDate.ScheduleDate
				END &gt;= &amp;OrderPeriodStart
		END
	AND CASE
			WHEN &amp;OrderPeriodEnd = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE CASE
					WHEN ScheduleBuildDate.ScheduleDate IS NULL
						THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.DaysBeforeOrdering)
					ELSE ScheduleOrderDate.ScheduleDate
				END &lt;= &amp;OrderPeriodEnd
		END
{WHERE
	TableOfPlans.Warehouse.* AS Warehouse}

GROUP BY
	TableOfPlans.AssemblyEndDate,
	TableOfPlans.AssemblyPeriodStart,
	TableOfPlans.Products,
	TableOfPlans.Characteristic,
	TableOfPlans.Purpose,
	TableOfPlans.Warehouse,
	TableOfPlans.ProductKit,
	TableOfPlans.BusinessOperation,
	TableOfPlans.DaysBeforeOrdering,
	TableOfPlans.AssemblyDisassemblyDurationDays,
	TableOfPlans.Calendar,
	TableOfPlans.SupplyMethod,
	CASE
		WHEN ScheduleBuildDate.ScheduleDate IS NULL
			THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.DaysBeforeOrdering)
		ELSE ScheduleOrderDate.ScheduleDate
	END,
	CASE
		WHEN ScheduleBuildDate.ScheduleDate IS NULL
			THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.AssemblyDisassemblyDurationDays)
		ELSE ScheduleBuildEndDate.ScheduleDate
	END,
	CASE
		WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END,
	TableOfPlans.NumberOfKitsInProductKitConfiguration

INDEX BY
	Products,
	Characteristic,
	Purpose,
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
DROP TableOfPlans
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfPlans.Calendar AS Calendar,
	TableOfPlans.Products AS Products,
	TableOfPlans.Characteristic AS Characteristic,
	TableOfPlans.Purpose AS Purpose,
	TableOfPlans.Warehouse AS Warehouse,
	TableOfPlans.ProductKit AS ProductKit,
	TableOfPlans.BusinessOperation AS BusinessOperation,
	MAX(CatProducts.SKU) AS SKU,
	TableOfPlans.AssemblyPeriodStart AS AssemblyPeriodStart,
	MAX(TableOfPlans.AssemblyEndDate) AS AssemblyEndDate,
	MAX(TableOfPlans.QuantityInPlans) AS QuantityInPlans,
	ISNULL(SUM(Orders.Count), 0) AS QuantityInOrders,
	MAX(TableOfPlans.QuantityInPlans) - ISNULL(SUM(Orders.Count), 0) AS NumberOfPackages,
	MAX(TableOfPlans.QuantityInPlans) - ISNULL(SUM(Orders.Count), 0) AS Count,
	MAX(CASE
			WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					OR CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
				THEN TRUE
			ELSE FALSE
		END) AS ItemVariantsAreUsed,
	MIN(TableOfPlans.OrderDate) AS OrderDate,
	MIN(TableOfPlans.DaysBeforeOrdering) AS DaysBeforeOrdering,
	MIN(TableOfPlans.AssemblyDisassemblyDurationDays) AS AssemblyDisassemblyDurationDays,
	CatProducts.ItemsType AS ItemsType,
	TableOfPlans.SupplyMethod AS SupplyMethod,
	TableOfPlans.AssemblyStartDate AS AssemblyStartDate,
	TableOfPlans.EditWarehouse AS EditWarehouse,
	TableOfPlans.NumberOfKitsInProductKitConfiguration AS NumberOfKitsInProductKitConfiguration
INTO SecuredPlans
{SELECT
	Products.*,
	Characteristic.*,
	Purpose.*,
	SKU,
	AssemblyPeriodStart,
	AssemblyEndDate,
	QuantityInPlans,
	QuantityInOrders,
	NumberOfPackages,
	Count,
	ItemVariantsAreUsed,
	OrderDate,
	DaysBeforeOrdering,
	AssemblyDisassemblyDurationDays,
	Warehouse.*,
	ProductKit,
	BusinessOperation}
FROM
	TableOfPlans1 AS TableOfPlans
		INNER JOIN Catalog.Products AS CatProducts
		ON TableOfPlans.Products = CatProducts.Ref
		LEFT JOIN Document.ByAssemblyDisassemblyOrder AS Orders
		ON TableOfPlans.BusinessOperation = Orders.BusinessOperation
			AND (Orders.Posted)
			AND TableOfPlans.Products = Orders.Products
			AND TableOfPlans.Characteristic = Orders.Characteristic
			AND (CASE
				WHEN NOT &amp;PlanningByAssignments
					THEN TRUE
				ELSE TableOfPlans.Purpose = Orders.Purpose
			END)
			AND TableOfPlans.ProductKit = Orders.ProductKit
			AND (CASE
				WHEN TableOfPlans.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
					THEN TRUE
				ELSE TableOfPlans.Warehouse = Orders.Warehouse
			END)
			AND (Orders.AssemblyDisassemblyEnd BETWEEN TableOfPlans.AssemblyPeriodStart AND TableOfPlans.AssemblyEndDate)
{WHERE
	CatProducts.ItemsType.*}

GROUP BY
	TableOfPlans.Calendar,
	TableOfPlans.AssemblyPeriodStart,
	TableOfPlans.Products,
	TableOfPlans.Characteristic,
	TableOfPlans.Purpose,
	CatProducts.ItemsType,
	TableOfPlans.Warehouse,
	TableOfPlans.ProductKit,
	TableOfPlans.BusinessOperation,
	TableOfPlans.SupplyMethod,
	TableOfPlans.AssemblyStartDate,
	TableOfPlans.EditWarehouse,
	TableOfPlans.NumberOfKitsInProductKitConfiguration
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlans.Calendar AS Calendar,
	SecuredPlans.Products AS Products,
	SecuredPlans.Characteristic AS Characteristic,
	SecuredPlans.Purpose AS Purpose,
	SecuredPlans.Warehouse AS Warehouse,
	SecuredPlans.ProductKit AS ProductKit,
	SecuredPlans.BusinessOperation AS BusinessOperation,
	SecuredPlans.SKU AS SKU,
	SecuredPlans.AssemblyPeriodStart AS AssemblyPeriodStart,
	SecuredPlans.AssemblyEndDate AS AssemblyEndDate,
	SecuredPlans.QuantityInPlans AS QuantityInPlans,
	SecuredPlans.QuantityInOrders AS QuantityInOrders,
	SecuredPlans.NumberOfPackages AS NumberOfPackages,
	SecuredPlans.Count AS Count,
	SecuredPlans.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	SecuredPlans.OrderDate AS OrderDate,
	SecuredPlans.DaysBeforeOrdering AS DaysBeforeOrdering,
	SecuredPlans.AssemblyDisassemblyDurationDays AS AssemblyDisassemblyDurationDays,
	SecuredPlans.ItemsType AS ItemsType,
	SecuredPlans.SupplyMethod AS SupplyMethod,
	SecuredPlans.AssemblyStartDate AS AssemblyStartDate,
	SecuredPlans.EditWarehouse AS EditWarehouse,
	SecuredPlans.NumberOfKitsInProductKitConfiguration AS NumberOfKitsInProductKitConfiguration
INTO SecuredPlansWithDeductionForOtherWarehouses
FROM
	SecuredPlans AS SecuredPlans

UNION ALL

SELECT
	SecuredPlans.Calendar,
	SecuredPlans.Products,
	SecuredPlans.Characteristic,
	SecuredPlans.Purpose,
	SecuredPlans.Warehouse,
	SecuredPlans.ProductKit,
	SecuredPlans.BusinessOperation,
	SecuredPlans.SKU,
	SecuredPlans.AssemblyPeriodStart,
	SecuredPlans.AssemblyEndDate,
	0,
	-SecuredPlans.QuantityInOrders,
	SecuredPlans.NumberOfPackages,
	SecuredPlans.Count,
	SecuredPlans.ItemVariantsAreUsed,
	SecuredPlans.OrderDate,
	SecuredPlans.DaysBeforeOrdering,
	SecuredPlans.AssemblyDisassemblyDurationDays,
	SecuredPlans.ItemsType,
	SecuredPlans.SupplyMethod,
	SecuredPlans.AssemblyStartDate,
	TRUE,
	SecuredPlans.NumberOfKitsInProductKitConfiguration
FROM
	SecuredPlans AS SecuredPlans
WHERE
	SecuredPlans.Warehouse &lt;&gt; VALUE(Catalog.Warehouses.EmptyRef)
	AND SecuredPlans.QuantityInOrders &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SecuredPlansWithDeductionForOtherWarehouses.Calendar AS Calendar,
	SecuredPlansWithDeductionForOtherWarehouses.Products AS Products,
	SecuredPlansWithDeductionForOtherWarehouses.Characteristic AS Characteristic,
	SecuredPlansWithDeductionForOtherWarehouses.Purpose AS Purpose,
	SecuredPlansWithDeductionForOtherWarehouses.Purpose.LineOfBusiness AS LineOfBusiness,
	SecuredPlansWithDeductionForOtherWarehouses.Warehouse AS Warehouse,
	SecuredPlansWithDeductionForOtherWarehouses.ProductKit AS ProductKit,
	SecuredPlansWithDeductionForOtherWarehouses.BusinessOperation AS BusinessOperation,
	SecuredPlansWithDeductionForOtherWarehouses.SKU AS SKU,
	MAX(SecuredPlansWithDeductionForOtherWarehouses.AssemblyPeriodStart) AS AssemblyPeriodStart,
	MAX(SecuredPlansWithDeductionForOtherWarehouses.AssemblyEndDate) AS AssemblyEndDate,
	SUM(SecuredPlansWithDeductionForOtherWarehouses.QuantityInPlans) AS QuantityInPlans,
	SUM(SecuredPlansWithDeductionForOtherWarehouses.QuantityInOrders) AS QuantityInOrders,
	SUM(SecuredPlansWithDeductionForOtherWarehouses.NumberOfPackages) AS NumberOfPackages,
	SUM(SecuredPlansWithDeductionForOtherWarehouses.Count) AS Count,
	SecuredPlansWithDeductionForOtherWarehouses.ItemVariantsAreUsed AS ItemVariantsAreUsed,
	MAX(SecuredPlansWithDeductionForOtherWarehouses.OrderDate) AS OrderDate,
	SecuredPlansWithDeductionForOtherWarehouses.DaysBeforeOrdering AS DaysBeforeOrdering,
	SecuredPlansWithDeductionForOtherWarehouses.AssemblyDisassemblyDurationDays AS AssemblyDisassemblyDurationDays,
	SecuredPlansWithDeductionForOtherWarehouses.ItemsType AS ItemsType,
	SecuredPlansWithDeductionForOtherWarehouses.SupplyMethod AS SupplyMethod,
	MAX(SecuredPlansWithDeductionForOtherWarehouses.AssemblyStartDate) AS AssemblyStartDate,
	SecuredPlansWithDeductionForOtherWarehouses.EditWarehouse AS EditWarehouse,
	SecuredPlansWithDeductionForOtherWarehouses.NumberOfKitsInProductKitConfiguration AS NumberOfKitsInProductKitConfiguration
FROM
	SecuredPlansWithDeductionForOtherWarehouses AS SecuredPlansWithDeductionForOtherWarehouses

GROUP BY
	SecuredPlansWithDeductionForOtherWarehouses.Calendar,
	SecuredPlansWithDeductionForOtherWarehouses.Products,
	SecuredPlansWithDeductionForOtherWarehouses.Characteristic,
	SecuredPlansWithDeductionForOtherWarehouses.Purpose,
	SecuredPlansWithDeductionForOtherWarehouses.ProductKit,
	SecuredPlansWithDeductionForOtherWarehouses.BusinessOperation,
	SecuredPlansWithDeductionForOtherWarehouses.EditWarehouse,
	SecuredPlansWithDeductionForOtherWarehouses.ItemVariantsAreUsed,
	SecuredPlansWithDeductionForOtherWarehouses.ItemsType,
	SecuredPlansWithDeductionForOtherWarehouses.SupplyMethod,
	SecuredPlansWithDeductionForOtherWarehouses.SKU,
	SecuredPlansWithDeductionForOtherWarehouses.Warehouse,
	SecuredPlansWithDeductionForOtherWarehouses.DaysBeforeOrdering,
	SecuredPlansWithDeductionForOtherWarehouses.AssemblyDisassemblyDurationDays,
	SecuredPlansWithDeductionForOtherWarehouses.NumberOfKitsInProductKitConfiguration,
	SecuredPlansWithDeductionForOtherWarehouses.Purpose.LineOfBusiness

HAVING
	SUM(SecuredPlansWithDeductionForOtherWarehouses.QuantityInPlans) &gt; 0

ORDER BY
	SecuredPlansWithDeductionForOtherWarehouses.Products,
	SecuredPlansWithDeductionForOtherWarehouses.Characteristic,
	SecuredPlansWithDeductionForOtherWarehouses.Purpose</query>
	</dataSet>
