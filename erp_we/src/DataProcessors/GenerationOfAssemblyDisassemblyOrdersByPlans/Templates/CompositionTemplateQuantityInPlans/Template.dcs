		<field xsi:type="DataSetFieldField">
			<dataPath>Purpose</dataPath>
			<field>Purpose</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentProducts.Products AS Products,
	SegmentProducts.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS SegmentProducts
{WHERE
	SegmentProducts.Segment.* AS ProductSegment,
	SegmentProducts.Products.*,
	SegmentProducts.Characteristic.*}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.DayPeriod, DAY)
	END AS AssemblyEndDate,
	CASE CAST(&amp;Scenario AS Catalog.SalesOperationsPlanningScenarios).Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN AssemblyPlansDisassemblyRevolutions.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN AssemblyPlansDisassemblyRevolutions.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN AssemblyPlansDisassemblyRevolutions.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN AssemblyPlansDisassemblyRevolutions.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN AssemblyPlansDisassemblyRevolutions.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN AssemblyPlansDisassemblyRevolutions.YearPeriod
		ELSE AssemblyPlansDisassemblyRevolutions.DayPeriod
	END AS AssemblyPeriodStart,
	AssemblyPlansDisassemblyRevolutions.Products AS Products,
	AssemblyPlansDisassemblyRevolutions.Characteristic AS Characteristic,
	AssemblyPlansDisassemblyRevolutions.Purpose AS Purpose,
	AssemblyPlansDisassemblyRevolutions.Warehouse AS Warehouse,
	AssemblyPlansDisassemblyRevolutions.ProductKit AS ProductKit,
	AssemblyPlansDisassemblyRevolutions.BusinessOperation AS BusinessOperation,
	AssemblyPlansDisassemblyRevolutions.ToOrderTurnover AS QuantityInPlans,
	ISNULL(Approaches.OrderFulfillmentPeriod, AssemblyPlansDisassemblyRevolutions.ProductKit.AssemblyDisassemblyDurationDays) AS DaysBeforeOrdering,
	ISNULL(Approaches.ProductionDurationDays, AssemblyPlansDisassemblyRevolutions.ProductKit.AssemblyDisassemblyDurationDays) AS AssemblyDisassemblyDurationDays,
	CASE
		WHEN ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef)) = VALUE(Catalog.Calendars.EmptyRef)
			THEN MainEnterpriseCalendar.Value
		ELSE ISNULL(Warehouses.Calendar, VALUE(Catalog.Calendars.EmptyRef))
	END AS Calendar,
	ISNULL(Approaches.Ref, VALUE(Catalog.ProcurementStrategies.EmptyRef)) AS SupplyMethod,
	ProductKitConfigurations.Count AS NumberOfKitsInProductKitConfiguration,
	AssemblyPlansDisassemblyRevolutions.AssemblyDisassemblyPlan AS AssemblyDisassemblyPlan
INTO TableOfPlans
FROM
	AccumulationRegister.AssemblyDisassemblyPlans.Turnovers(
			&amp;BeginOfPeriod,
			&amp;PeriodEnding,
			Auto,
			Scenario = &amp;Scenario
				AND Status = VALUE(Enum.PlanStatuses.Upholded)
				AND Products = &amp;Products
				AND Characteristic = &amp;Characteristic
				AND Purpose = &amp;Purpose
				AND ProductKit = &amp;ProductKit
				AND BusinessOperation = &amp;BusinessOperation
				AND Warehouse = &amp;Warehouse {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (BusinessOperation), (AssemblyDisassemblyPlan)}) AS AssemblyPlansDisassemblyRevolutions
		LEFT JOIN Catalog.ProcurementStrategies AS Approaches
		ON &amp;MainSupplyMethodSubstitution
			AND (Approaches.SupplyType = VALUE(Enum.SupplyTypes.AssemblyDisassembly))
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON AssemblyPlansDisassemblyRevolutions.Warehouse = Warehouses.Ref
		LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
		ON AssemblyPlansDisassemblyRevolutions.ProductKit = ProductKitConfigurations.Ref,
	Constant.MainEnterpriseCalendar AS MainEnterpriseCalendar

INDEX BY
	Products,
	Characteristic,
	Purpose,
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfPlans.Calendar AS Calendar,
	CalendarSchedules.Year AS Year,
	MAX(CalendarSchedules.DaysCountInScheduleSinceBegOfYear) AS DaysCountInScheduleSinceBegOfYear
INTO ChartsNumberOfDaysInPastYear
FROM
	TableOfPlans AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS CalendarSchedules
		ON TableOfPlans.Calendar = CalendarSchedules.Calendar
			AND (YEAR(TableOfPlans.AssemblyEndDate) - 1 = CalendarSchedules.Year)
WHERE
	CalendarSchedules.Year &gt; 0

GROUP BY
	TableOfPlans.Calendar,
	CalendarSchedules.Year
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SUM(TableOfPlans.QuantityInPlans) AS Count,
	TableOfPlans.AssemblyDisassemblyPlan AS Document,
	TableOfPlans.AssemblyDisassemblyPlan.PointInTime AS PointInTime,
	TableOfPlans.AssemblyDisassemblyPlan.Date AS DocumentDate,
	TableOfPlans.AssemblyDisassemblyPlan.Number AS DocumentNumber
FROM
	TableOfPlans AS TableOfPlans
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleBuildDate
		ON TableOfPlans.Calendar = ScheduleBuildDate.Calendar
			AND TableOfPlans.AssemblyEndDate = ScheduleBuildDate.ScheduleDate
			AND (YEAR(TableOfPlans.AssemblyEndDate) = ScheduleBuildDate.Year)
		LEFT JOIN ChartsNumberOfDaysInPastYear AS ChartsLastYear
		ON (YEAR(TableOfPlans.AssemblyEndDate) - 1 = ChartsLastYear.Year)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN TRUE
				ELSE FALSE
			END)
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleOrderDate
		ON TableOfPlans.Calendar = ScheduleOrderDate.Calendar
			AND (ScheduleOrderDate.DayAddedToSchedule)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN YEAR(TableOfPlans.AssemblyEndDate) - 1 = ScheduleOrderDate.Year
				ELSE YEAR(TableOfPlans.AssemblyEndDate) = ScheduleOrderDate.Year
			END)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.DaysBeforeOrdering
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN CASE
							WHEN ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.DaysBeforeOrdering - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) &lt;= 0
								THEN ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear = 1
							ELSE ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.DaysBeforeOrdering - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) = ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear
						END
				ELSE ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) - TableOfPlans.DaysBeforeOrdering = ScheduleOrderDate.DaysCountInScheduleSinceBegOfYear
			END)
		LEFT JOIN InformationRegister.CalendarSchedules AS ScheduleBuildEndDate
		ON TableOfPlans.Calendar = ScheduleBuildEndDate.Calendar
			AND (ScheduleBuildEndDate.DayAddedToSchedule)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.AssemblyDisassemblyDurationDays
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN YEAR(TableOfPlans.AssemblyEndDate) - 1 = ScheduleBuildEndDate.Year
				ELSE YEAR(TableOfPlans.AssemblyEndDate) = ScheduleBuildEndDate.Year
			END)
			AND (CASE
				WHEN NOT ScheduleBuildDate.ScheduleDate IS NULL
						AND (ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) &lt; TableOfPlans.AssemblyDisassemblyDurationDays
							OR ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) = 0)
					THEN CASE
							WHEN ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.AssemblyDisassemblyDurationDays - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) &lt;= 0
								THEN ScheduleBuildEndDate.DaysCountInScheduleSinceBegOfYear = 1
							ELSE ISNULL(ChartsLastYear.DaysCountInScheduleSinceBegOfYear, 0) - (TableOfPlans.AssemblyDisassemblyDurationDays - ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0)) = ScheduleBuildEndDate.DaysCountInScheduleSinceBegOfYear
						END
				ELSE ISNULL(ScheduleBuildDate.DaysCountInScheduleSinceBegOfYear, 0) - TableOfPlans.AssemblyDisassemblyDurationDays = ScheduleBuildEndDate.DaysCountInScheduleSinceBegOfYear
			END)
WHERE
	CASE
			WHEN &amp;OrderPeriodStart = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE CASE
					WHEN ScheduleBuildDate.ScheduleDate IS NULL
						THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.DaysBeforeOrdering)
					ELSE ScheduleOrderDate.ScheduleDate
				END &gt;= &amp;OrderPeriodStart
		END
	AND CASE
			WHEN &amp;OrderPeriodEnd = DATETIME(1, 1, 1)
				THEN TRUE
			ELSE CASE
					WHEN ScheduleBuildDate.ScheduleDate IS NULL
						THEN DATEADD(TableOfPlans.AssemblyEndDate, DAY, -TableOfPlans.DaysBeforeOrdering)
					ELSE ScheduleOrderDate.ScheduleDate
				END &lt;= &amp;OrderPeriodEnd
		END
{WHERE
	TableOfPlans.Warehouse.* AS Warehouse}

GROUP BY
	TableOfPlans.AssemblyDisassemblyPlan,
	TableOfPlans.AssemblyDisassemblyPlan.PointInTime,
	TableOfPlans.AssemblyDisassemblyPlan.Date,
	TableOfPlans.AssemblyDisassemblyPlan.Number</query>
	</dataSet>
	<parameter>
		<name>Department</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Business unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد تجاری</v8:content>
			</v8:item>
