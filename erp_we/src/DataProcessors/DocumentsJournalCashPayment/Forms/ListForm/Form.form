    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ScheduleOfPayments.PaymentDate AS PaymentDate,
	ScheduleOfPayments.PayerBeneficiary AS Payer,
	ScheduleOfPayments.PayerBeneficiary.Description AS CounterpartyPresentation,
	ScheduleOfPayments.Sum AS AmountToPay,
	ScheduleOfPayments.Currency AS Currency,
	
	ScheduleOfPayments.Number AS Number,
	ScheduleOfPayments.Date AS Date,
	ScheduleOfPayments.PaymentObjectType AS PaymentObjectType,
	ScheduleOfPayments.DocumentAmount AS DocumentAmount,
	CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CashAccounts) AS CashAccount,
	CAST(ScheduleOfPayments.BankAccountCashAccount AS Catalog.CompaniesBankAccounts) AS BankAccount,
	
	ScheduleOfPayments.BusinessOperation AS BusinessOperation,
	ScheduleOfPayments.CashFlowItem AS CashFlowItem,
	ScheduleOfPayments.Department AS Department,
	ScheduleOfPayments.LineOfBusiness AS LineOfBusiness,
	ScheduleOfPayments.EmployeeResponsible AS Responsible,
	
	ScheduleOfPayments.Organization AS Organization,
	ScheduleOfPayments.ScheduleRelevanceDate AS ScheduleRelevanceDate,
	ScheduleOfPayments.PaymentMethod AS PaymentMethod,
	ScheduleOfPayments.PlanningArea AS PlanningArea,
	
	ScheduleOfPayments.PaymentObject AS Ref
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
	
WHERE
	ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment)
	AND ScheduleOfPayments.PaymentDate &lt;= &amp;PaymentDate
	AND ScheduleOfPayments.PlanningArea IN (
		VALUE(Enum.PaymentPlanningAreas.CustomersARAPAccounting),
		VALUE(Enum.PaymentPlanningAreas.ReturnsFromVendors),
		VALUE(Enum.PaymentPlanningAreas.CashInTransit),
		VALUE(Enum.PaymentPlanningAreas.LoansOrBorrowingsReceived),
		VALUE(Enum.PaymentPlanningAreas.Deposits),
		VALUE(Enum.PaymentPlanningAreas.IssuedBorrowings)
		)
</queryText>
