      <value>Nakit ödeme günlüğü</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sổ thanh toán</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashPaymentJournal.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashPaymentJournal.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashPaymentJournal.Posted</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashPaymentJournal.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashPaymentJournal.Type</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.Posted AS Posted,
	VALUETYPE(DocumentsRegistry.Ref) AS Type,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Department AS Department,
	CASE
		WHEN DocumentsRegistry.RefType IN (&amp;IDOfTheObjectReceiptOfNonCashDS, &amp;IDOfThePKOObject)
			THEN DocumentsRegistry.Sum
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDTheTransactionWithTheCreditCard
		AND DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromCustomer)
			THEN DocumentsRegistry.Sum
		WHEN DocumentsRegistry.RefType = &amp;AnObjectIDIsAReflectionOfTheDiscrepanciesInCashCollection
		AND
			DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RecordSurplusDuringCashCollection)
			THEN DocumentsRegistry.Sum
		ELSE 0
	END AS OrderReceiptAmount,
	CASE
		WHEN DocumentsRegistry.RefType IN (&amp;TheObjectIDOfTheNonCashWriteOffOfDS, &amp;IDOfTheRKOObject)
			THEN DocumentsRegistry.Sum
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDTheTransactionWithTheCreditCard
		AND DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToCustomer)
			THEN DocumentsRegistry.Sum
		WHEN DocumentsRegistry.RefType = &amp;AnObjectIDIsAReflectionOfTheDiscrepanciesInCashCollection
		AND
			DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RecordShortageOnCashCollection)
			THEN DocumentsRegistry.Sum
		ELSE 0
	END AS DebitedAmount,
	DocumentsRegistry.Currency AS Currency,
	CASE
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Companies
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Companies)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Counterparties
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Persons
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Persons)
		ELSE UNDEFINED
	END AS RecipientPayer,
	DocumentsRegistry.Counterparty AS CounterpartyKey,
	CASE
		WHEN DocumentsRegistry.RefType = &amp;IDOfTheObjectReceiptOfNonCashDS
			THEN DataOnNonCashDSReceipts.PaymentDocumentType
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDOfTheNonCashWriteOffOfDS
			THEN TheseNonCashWriteOffOfDS.PaymentDocumentType
		ELSE UNDEFINED
	END AS PaymentDocumentType,
	CASE
		WHEN DocumentsRegistry.RefType = &amp;IDOfTheObjectReceiptOfNonCashDS
			THEN PRESENTATION(DataOnNonCashDSReceipts.PaymentDocumentType)
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDOfTheNonCashWriteOffOfDS
			THEN PRESENTATION(TheseNonCashWriteOffOfDS.PaymentDocumentType)
		ELSE PRESENTATION(VALUETYPE(DocumentsRegistry.Ref))
	END AS Document,
	CASE
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDOfTheReportOnOperationsOfTheAcquiring
			THEN &amp;BankAcquiringReport
		ELSE PRESENTATION(DocumentsRegistry.BusinessOperation)
	END AS Operation,
	EDStatesOverridable.StatusPresentation AS StatusPresentation,
	CASE
		WHEN DocumentsRegistry.StorageLocation.Key REFS Catalog.CompaniesBankAccounts
			THEN CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CompaniesBankAccounts)
		ELSE CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CashAccounts)
	END AS BankAccountCashAccount,
	CASE
		WHEN DocumentsRegistry.RefType IN (&amp;IDOfTheObjectReceiptOfNonCashDS, &amp;TheObjectIDOfTheNonCashWriteOffOfDS)
			THEN VALUE(Enum.PaymentForms.BankAccountPayment)
		WHEN DocumentsRegistry.RefType IN (&amp;IDOfThePKOObject, &amp;IDOfTheRKOObject,
			&amp;AnObjectIDIsAReflectionOfTheDiscrepanciesInCashCollection)
			THEN VALUE(Enum.PaymentForms.CashAccountPayment_)
		WHEN DocumentsRegistry.RefType IN (&amp;TheObjectIDTheTransactionWithTheCreditCard, &amp;TheObjectIDOfTheReportOnOperationsOfTheAcquiring)
			THEN VALUE(Enum.PaymentForms.PaymentCard)
		ELSE UNDEFINED
	END AS PaymentMethod,
	CASE
		WHEN DocumentsRegistry.RefType IN (&amp;IDOfTheObjectReceiptOfNonCashDS, &amp;TheObjectIDOfTheNonCashWriteOffOfDS)
			THEN DocumentsRegistry.RecordingInAccountingDate &lt;> DATETIME(1, 1, 1)
		WHEN DocumentsRegistry.RefType = &amp;TheObjectIDTheTransactionWithTheCreditCard
			THEN FALSE
		ELSE TRUE
	END AS ProcessedByBank,
	DocumentsRegistry.More AS TheBasisOfTheAppointment,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistry.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistry.ReversedDocument
	END AS ReversedCorrectedDocument,
	DocumentsRegistry.EmployeeResponsible AS EmployeeResponsible,
	DocumentsRegistry.Author AS Author,
	FALSE AS ThereAreErrorsInCheckingCounterparties,
	UNDEFINED AS TheStatusOfDirektBank,
	1 AS ThePictureDirektBank,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	DocumentsRegistry.RecordID AS RecordID,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.RefType AS RefType
{WHERE
	DocumentsRegistry.Ref.* AS Ref,
	(CASE
		WHEN DocumentsRegistry.StorageLocation.Key REFS Catalog.CompaniesBankAccounts
			THEN CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CompaniesBankAccounts)
		ELSE CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.CashAccounts)
	END).* AS BankAccountCashAccount,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.RefType AS RefType,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Partner.* AS Partner,
	(CASE
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Companies
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Companies)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Counterparties
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)
		WHEN DocumentsRegistry.Counterparty.Key REFS Catalog.Persons
			THEN CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Persons)
		ELSE UNDEFINED
	END).* AS RecipientPayer,
	DocumentsRegistry.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.Author.* AS Author,
	DocumentsRegistry.More AS TheBasisOfTheAppointment,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark}
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
		LEFT JOIN Document.BankAccountReceiptNote AS DataOnNonCashDSReceipts
		ON DataOnNonCashDSReceipts.Ref = DocumentsRegistry.Ref
		LEFT JOIN Document.BankAccountIssue AS TheseNonCashWriteOffOfDS
		ON TheseNonCashWriteOffOfDS.Ref = DocumentsRegistry.Ref
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStatesOverridable
		ON (EDStatesOverridable.ObjectReference = DocumentsRegistry.Ref)}
WHERE
	DocumentsRegistry.RefType IN (&amp;IDOfTheObjectReceiptOfNonCashDS, &amp;TheObjectIDOfTheNonCashWriteOffOfDS, &amp;IDOfThePKOObject,
		&amp;IDOfTheRKOObject, &amp;TheObjectIDOfTheReportOnOperationsOfTheAcquiring, &amp;TheObjectIDTheTransactionWithTheCreditCard,
		&amp;AnObjectIDIsAReflectionOfTheDiscrepanciesInCashCollection)
	AND NOT DocumentsRegistry.AdditionalRecord
	AND (DocumentsRegistry.RecordingInAccountingDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod)</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
