          <name>UseOperationExecutionControl</name>
          <id>721</id>
          <title>
            <key>en</key>
            <value>Operation execution control (quality control department)</value>
          </title>
          <title>
            <key>fa</key>
            <value>کنترل اجرای عملیات (واحد کنترل کیفیت)</value>
          </title>
          <title>
            <key>it</key>
            <value>Controllo di esecuzione delle operazioni (CEO)</value>
          </title>
          <title>
            <key>pl</key>
            <value>Kontrola wykonania operacji (Kontrola jakości)</value>
          </title>
          <title>
            <key>ru</key>
            <value>Контроль выполнения операций (ОТК)</value>
          </title>
          <title>
            <key>tr</key>
            <value>İşlem gerçekleştirme kontrolü (Teknik Kontrol Bölümü)</value>
          </title>
          <title>
            <key>vi</key>
            <value>Kiểm soát thực hiện giao dịch (OTK)</value>
          </title>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
