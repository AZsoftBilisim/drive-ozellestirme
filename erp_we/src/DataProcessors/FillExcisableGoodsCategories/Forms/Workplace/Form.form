    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.AutoConversionRatio</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.AutocompletionOfConversionRatio</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.CategoryUnit</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.ExcisableGoods</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.ItSFirmBet</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.UnitOfMeasure</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.VolumeUse</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ItemList.WeightUse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ProductsOverridable.Ref AS Ref,
	CategoriesOverridable.ExcisableGoodsCategory.UnitOfMeasure AS CategoryUnit,
	ProductsOverridable.UnitOfMeasure AS UnitOfMeasure,
	ProductsOverridable.IsFolder AS IsFolder,
	ISNULL(CategoriesOverridable.ExcisableGoods, FALSE) AS ExcisableGoods,
	CASE
		WHEN ProductsOverridable.IsFolder
			THEN VALUE(Catalog.ExcisableGoodsCategories.EmptyRef)
		ELSE ISNULL(CategoriesOverridable.ExcisableGoodsCategory,
			VALUE(Catalog.ExcisableGoodsCategories.EmptyRef))
	END AS ExcisableGoodsCategory,
	CategoriesOverridable.ConversionFactor_ AS ConversionFactor_,
	CASE
		WHEN ProductsOverridable.VolumeUse
			THEN ProductsOverridable.VolumeUnitOfMeasure
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS VolumeUnitOfMeasure,
	CASE
		WHEN ProductsOverridable.VolumeUse
			THEN ProductsOverridable.VolumeNumerator / ProductsOverridable.VolumeDenominator
		ELSE 0
	END AS VolumeFactor,
	CASE
		WHEN ProductsOverridable.WeightUse
			THEN ProductsOverridable.WeightUnitOfMeasure
		ELSE 0
	END AS WeightUnitOfMeasure,
	CASE
		WHEN ProductsOverridable.WeightUse
			THEN ProductsOverridable.WeightNumerator / ProductsOverridable.WeightDenominator
		ELSE 0
	END AS WeightRatio,
	ProductsOverridable.VolumeUse AS VolumeUse,
	ProductsOverridable.WeightUse AS WeightUse,
	FALSE AS ItSFirmBet,
	FALSE AS AutocompletionOfConversionRatio,
	&amp;QueryTextPackagingFactor AS AutoConversionRatio
FROM
	Catalog.Products AS ProductsOverridable
		LEFT JOIN InformationRegister.ExcisableGoodsCategories.SliceLast(&amp;Period, Country = &amp;Country {Products.*
			AS Ref}) AS CategoriesOverridable
		ON ProductsOverridable.Ref = CategoriesOverridable.Products</queryText>
      <mainTable>Catalog.Products</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
