    </title>
    <title>
      <key>vi</key>
      <value>Chi tiết sản phẩm</value>
    </title>
    <id>50</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CalculationOfPlanShortagesByStages.Products AS Products,
	CalculationOfPlanShortagesByStages.Characteristic AS Characteristic,
	CalculationOfPlanShortagesByStages.Purpose AS Purpose,
	CalculationOfPlanShortagesByStages.OpeningBalance AS OpeningBalance,
	-CalculationOfPlanShortagesByStages.Deficit AS ClosingBalance,
	CalculationOfPlanShortagesByStages.ToChange AS ToChange,
	CalculationOfPlanShortagesByStages.Receipt AS Receipt,
	CalculationOfPlanShortagesByStages.Expense + CalculationOfPlanShortagesByStages.ExpenseAdjustment AS Expense,
	CalculationOfPlanShortagesByStages.ExpenseAdjustment AS ExpenseAdjustment,
	CalculationOfPlanShortagesByStages.Deficit + CalculationOfPlanShortagesByStages.Receipt - CalculationOfPlanShortagesByStages.ExpenseAdjustment AS Demand
FROM
	InformationRegister.CalculationOfPlanShortagesByStages AS CalculationOfPlanShortagesByStages
WHERE
	CalculationOfPlanShortagesByStages.Scenario = &amp;Scenario
	AND CalculationOfPlanShortagesByStages.PlanProfile = &amp;PlanProfile
	AND CalculationOfPlanShortagesByStages.PlanningPeriod = &amp;PlanningPeriod
	AND (CalculationOfPlanShortagesByStages.Receipt &lt;> 0 AND NOT &amp;DemandAdjustment
			OR (CalculationOfPlanShortagesByStages.Expense &lt;> 0 
			AND (CalculationOfPlanShortagesByStages.PlanProfile.DemandPlanning
			OR &amp;PlanProfile = VALUE(Catalog.PlanProfiles.EmptyRef)))
			OR CalculationOfPlanShortagesByStages.ToChange &lt;> 0
			OR CalculationOfPlanShortagesByStages.ExpenseAdjustment &lt;> 0
			OR CalculationOfPlanShortagesByStages.DemandRangeIsSpecified
			OR (CalculationOfPlanShortagesByStages.OpeningBalance &lt;> 0
				AND &amp;ConsiderOpeningBalance))</queryText>
      <mainTable>InformationRegister.CalculationOfPlanShortagesByStages</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
