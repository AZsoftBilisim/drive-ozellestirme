        <title>
          <key>en</key>
          <value>Configure settings</value>
        </title>
        <title>
          <key>fa</key>
          <value>پیکربندی تنظیمات</value>
        </title>
        <title>
          <key>ru</key>
          <value>Задать настройки</value>
        </title>
        <title>
          <key>tr</key>
          <value>Ayarları yap</value>
        </title>
        <title>
          <key>vi</key>
          <value>Đặt tùy chỉnh</value>
        </title>
        <title>
          <key>it</key>
