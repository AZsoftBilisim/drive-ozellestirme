      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ThereIsASettingForDt</dataPath>
        <field>ThereIsASettingForDt</field>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>There is setting by Dr</value>
            </content>
            <content>
              <key>fa</key>
              <value>تنظیم بر اساس بدهکار وجود دارد</value>
            </content>
            <content>
              <key>ru</key>
              <value>Есть настройка по дт</value>
            </content>
            <content>
              <key>tr</key>
              <value>Borç ayarı mevcut</value>
            </content>
            <content>
              <key>vi</key>
              <value>Có tùy chỉnh theo Nợ</value>
            </content>
            <content>
              <key>it</key>
              <value>There is setting by Dr</value>
