  </attributes>
  <attributes>
    <name>BusinessTransactions</name>
    <title>
      <key>en</key>
      <value>Business transactions</value>
    </title>
    <title>
      <key>fa</key>
      <value>عملیات تجاری</value>
    </title>
    <title>
      <key>it</key>
      <value>Operazioni economiche</value>
    </title>
    <title>
      <key>pl</key>
      <value>Operacje gospodarcze</value>
    </title>
    <title>
      <key>ru</key>
      <value>Хозяйственные операции</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ticari işlemler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Giao dịch kinh tế</value>
    </title>
    <id>15</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BusinessTransactions.ConfigurationIsRequired</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BusinessTransactions.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BusinessTransactions.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BsnsTransactions.Ref AS Ref,
	BsnsTransactions.Description AS Description,
	BsnsTransactions.IsFolder AS IsFolder,
	BsnsTransactions.UseInFinancialAccounting AS UseInFinancialAccounting,
	CASE
		WHEN PostingTemplatesForFinancialAccounting.Operation IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereArePostingTemplates,
	
	CASE
		WHEN PostingTemplatesForFinancialAccounting.PostingTemplate IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereAreTemplatesForConfiguringTheFormationOfTransactions,
	
	CASE
		WHEN NonReflectedBusinessTransactions.Operation IS NOT NULL
			THEN TRUE
		ELSE FALSE
	END AS NotReflectedInTheTransactionGenerationSetup,
	CASE
		WHEN TRUE IN
			(SELECT TOP 1
				TRUE AS ConfigurationIsRequired
			FROM
				InformationRegister.FinancialAccountingPostingTemplatesThatRequireSetup AS ConfigurationIsRequired
			WHERE 
				ConfigurationIsRequired.ChartOfAccounts = &amp;ChartOfAccounts
				AND ConfigurationIsRequired.PostingGenerationSetting = &amp;PostingGenerationSetting
				AND ConfigurationIsRequired.BusinessOperation = BsnsTransactions.BusinessOperation)
			THEN TRUE
		ELSE FALSE
	END AS ConfigurationIsRequired
	
FROM
	Catalog.BusinessTransactionsSettings AS BsnsTransactions
	
	LEFT JOIN(
		SELECT
			MAX(ReflectionRules.PostingTemplate) AS PostingTemplate,
			PostingTemplates.Operation AS Operation
		FROM
			Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
			
			LEFT JOIN
				InformationRegister.RulesOfPostingsInFinancialAccounting AS ReflectionRules
			ON
				PostingTemplates.Ref = ReflectionRules.PostingTemplate
				AND ReflectionRules.PostingGenerationSetting = &amp;PostingGenerationSetting
		WHERE
			PostingTemplates.ChartOfAccounts = &amp;ChartOfAccounts
			
		GROUP BY
			PostingTemplates.Operation
		
		) AS PostingTemplatesForFinancialAccounting
	ON
		BsnsTransactions.Ref = PostingTemplatesForFinancialAccounting.Operation
	
	LEFT JOIN
		InformationRegister.BusinessTransactionsNotPostedInFinancialAccounting AS NonReflectedBusinessTransactions
	ON 
		NonReflectedBusinessTransactions.PostingGenerationSetting = &amp;PostingGenerationSetting
		AND BsnsTransactions.Ref = NonReflectedBusinessTransactions.Operation</queryText>
      <mainTable>Catalog.BusinessTransactionsSettings</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
