    </title>
    <title>
      <key>vi</key>
      <value>Tùy chỉnh tạo bút toán</value>
    </title>
    <id>4</id>
    <valueType>
      <types>CatalogRef.FinancialAccountingPostingGenerationSetting</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
