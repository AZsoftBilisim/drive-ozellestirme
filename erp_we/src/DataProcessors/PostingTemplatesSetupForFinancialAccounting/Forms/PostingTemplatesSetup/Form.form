    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	PostingTemplates.Ref,
	PostingTemplates.ChartOfAccounts,
	PostingTemplates.Parent,
	PostingTemplates.Description,
	PostingTemplates.Operation,
	PostingTemplates.DrAccountDefault,
	PostingTemplates.CrAccountDefault,
	PostingTemplates.ManualSpecificationOfEntry,
	PostingTemplates.SourceOfAmountInCurrencyDr,
	PostingTemplates.SourceOfAmountInCurrencyCr,
	PostingTemplates.BookAmountSource,
	CASE
		WHEN ReflectionRules.PostingTemplate IS NOT NULL 
			THEN TRUE
		ELSE FALSE
	END AS ValidTemplate,
	PostingTemplates.AdditionalFilterIsSet,
	PostingTemplates.FilterPresentation,
	PostingTemplates.PictureIndex,
	PostingTemplates.ThisIsTemplateGroup,
	PostingTemplates.AddlOrderingAttribute,
	PostingTemplates.Ignore,
	PostingTemplates.JointApplicationOption
FROM
	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
	LEFT JOIN
		InformationRegister.RulesOfPostingsInFinancialAccounting AS ReflectionRules
	ON
		(ReflectionRules.PostingGenerationSetting = &amp;PostingGenerationSetting)
		AND PostingTemplates.Ref = ReflectionRules.PostingTemplate</queryText>
