      <parameters>
        <name>PostingGenerationSetting</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Posting schema</value>
            </content>
            <content>
              <key>fa</key>
              <value>طرح ثبت</value>
            </content>
            <content>
              <key>it</key>
              <value>Impostazione di formazione delle transazioni</value>
            </content>
            <content>
              <key>pl</key>
              <value>Ustawienie formowania księgowań</value>
            </content>
            <content>
              <key>ru</key>
              <value>Настройка формирования проводок</value>
