  <attributes>
    <name>InternationalChartOfAccounts</name>
    <title>
      <key>en</key>
      <value>International chart of accounts </value>
    </title>
    <title>
      <key>fa</key>
      <value>سرفصل حساب‌های بین‌المللی</value>
    </title>
    <title>
      <key>it</key>
      <value>Piano internazionale dei conti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Plan kont międzynarodowy</value>
    </title>
    <title>
      <key>ru</key>
      <value>План счетов международный</value>
    </title>
    <title>
      <key>tr</key>
      <value>Uluslararası hesap planı</value>
    </title>
    <title>
      <key>vi</key>
      <value>hệ thống tài khoản quốc tế</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>InternationalChartOfAccounts.ChartOfAccounts</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>InternationalChartOfAccounts.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	International.Ref,
	International.ChartOfAccounts,
	International.Code,
	International.Description,
	CASE
		WHEN TransactionTemplatesForInternationalAccountingInADtAccount.Account IS NULL 
			AND TransactionTemplatesForInternationalAccountingInACTInvoice.Account IS NULL
			AND RulesForClarifyingAccountsInInternationalAccountingForDT.Account IS NULL 
			AND RulesForClarifyingAccountsInInternationalAccountingForCT.Account IS NULL
			THEN FALSE
		ELSE TRUE
	END AS UsedInTemplates_,
	CASE 
		WHEN TransactionTemplatesForInternationalAccountingInADtAccount.Account IS NULL
			AND RulesForClarifyingAccountsInInternationalAccountingForDT.Account IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereIsASettingForDt,
	CASE 
		WHEN TransactionTemplatesForInternationalAccountingInACTInvoice.Account IS NULL
			AND RulesForClarifyingAccountsInInternationalAccountingForCT.Account IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereIsACTScanSetup
	
FROM
	ChartOfAccounts.International AS International
	
	LEFT JOIN
		(SELECT DISTINCT
			PostingTemplates.DrAccountDefault AS Account
		FROM
			Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
		WHERE
			NOT PostingTemplates.DeletionMark) AS TransactionTemplatesForInternationalAccountingInADtAccount
	ON
		International.Ref = TransactionTemplatesForInternationalAccountingInADtAccount.Account
	
	LEFT JOIN
		(SELECT DISTINCT
			PostingTemplates.CrAccountDefault AS Account
		FROM
			Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
		WHERE
			NOT PostingTemplates.DeletionMark) AS TransactionTemplatesForInternationalAccountingInACTInvoice
	ON
		International.Ref = TransactionTemplatesForInternationalAccountingInACTInvoice.Account
	
	LEFT JOIN
		(SELECT DISTINCT
			RulesForClarifyingInvoices.GLAccount AS Account
		FROM
			InformationRegister.RulesOfSpecifyingAccountsFinancialAccounting AS RulesForClarifyingInvoices
		WHERE
			RulesForClarifyingInvoices.RecordType = VALUE(Enum.AccountingMovementKinds.Debit)) AS RulesForClarifyingAccountsInInternationalAccountingForDT
	ON
		International.Ref = RulesForClarifyingAccountsInInternationalAccountingForDT.Account
	
	LEFT JOIN
		(SELECT DISTINCT
			RulesForClarifyingInvoices.GLAccount AS Account
		FROM
			InformationRegister.RulesOfSpecifyingAccountsFinancialAccounting AS RulesForClarifyingInvoices
		WHERE
			RulesForClarifyingInvoices.RecordType = VALUE(Enum.AccountingMovementKinds.Credit)) AS RulesForClarifyingAccountsInInternationalAccountingForCT
	ON
		International.Ref = RulesForClarifyingAccountsInInternationalAccountingForCT.Account</queryText>
      <mainTable>ChartOfAccounts.International</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
