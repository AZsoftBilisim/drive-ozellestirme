      <segments>ExecutionOfOperations.Operation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.OperationID</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.PendingPredecessorCompletion</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.PresentationStage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.PreviousOnesStarted</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.ProductionArea</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.ReferenceOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.Running</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.Scheduled</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.Skipped3</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.Stage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.WaitingForCreation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.WorkCenter</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExecutionOfOperations.WorkCenterType</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	QueueOverridable.ReferenceOrder AS ReferenceOrder,
	ScheduleOverridable.Stage AS Stage,
	ScheduleOverridable.Operation AS Operation,
	ScheduleOverridable.LotNumber AS LotNumber,
	&amp;PresentationStage AS PresentationStage,
	QueueOverridable.Stage.BillOfMaterials AS BillOfMaterials,
	&amp;TechnologicalProcessPresentation AS TechnologicalProcessPresentation,
	ScheduleOverridable.LotQuantity AS Scheduled,
	CASE
		WHEN ScheduleOverridable.LotQuantity + ScheduleOverridable.RepetitionIsRequired > ScheduleOverridable.CreatedOn
			THEN ScheduleOverridable.LotQuantity + ScheduleOverridable.RepetitionIsRequired - ScheduleOverridable.CreatedOn
		ELSE 0
	END AS WaitingForCreation,
	ScheduleOverridable.PendingPredecessorCompletion AS PendingPredecessorCompletion,
	ScheduleOverridable.PreviousOnesStarted AS PreviousOnesStarted,
	ScheduleOverridable.ExecutionIsAllowed AS ExecutionIsAllowed,
	ScheduleOverridable.Running AS Running,
	ScheduleOverridable.Completed2 AS Completed2,
	ScheduleOverridable.Skipped3 AS Skipped3,
	ISNULL(QueueOverridable.Operation.Description, QueueOverridable.ProductionOperation.Description) AS NameOfTheOperation,
	ISNULL(QueueOverridable.Operation.UnitOfMeasure, QueueOverridable.ProductionOperation.UnitOfMeasure) AS UnitOfMeasure,
	QueueOverridable.Stage.ProductionLot.MainProductProducts AS Products,
	QueueOverridable.Stage.ProductionLot.MainProductCharacteristic AS Characteristic,
	ScheduleOverridable.WorkCenter AS WorkCenter,
	CASE 
		WHEN ISNULL(QueueOverridable.Operation.ProductionArea, QueueOverridable.ProductionOperation.ProductionArea) IS NOT NULL AND
				ISNULL(QueueOverridable.Operation.ProductionArea, QueueOverridable.ProductionOperation.ProductionArea) &lt;> VALUE(Catalog.ProductionSites.EmptyRef)
			THEN ISNULL(QueueOverridable.Operation.ProductionArea, QueueOverridable.ProductionOperation.ProductionArea)
		ELSE ScheduleOverridable.WorkCenter.ProductionArea
	END AS ProductionArea,
	ISNULL(QueueOverridable.Operation.SetupSettings, QueueOverridable.ProductionOperation.SetupSettings) AS SetupSettings,
	CASE
		WHEN QueueOverridable.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN ISNULL(QueueOverridable.ProductionOperation.Number, &quot;&quot;)
		ELSE &quot;&quot;
	END AS ProductionOperationNumber,
	CAST(ScheduleOverridable.IntervalDuration / CASE
			WHEN QueueOverridable.TimeUnitsOfMeasure = VALUE(Enum.TimeMeasureUnits.MINUTE)
				THEN 60
			WHEN QueueOverridable.TimeUnitsOfMeasure = VALUE(Enum.TimeMeasureUnits.HOUR)
				THEN 3600
			WHEN QueueOverridable.TimeUnitsOfMeasure = VALUE(Enum.TimeMeasureUnits.DAY)
				THEN 86400
			WHEN QueueOverridable.TimeUnitsOfMeasure = VALUE(Enum.TimeMeasureUnits.Days1)
				THEN 86400
			ELSE 1
		END AS NUMBER(10, 1)) AS RunTime,
	QueueOverridable.TimeUnitsOfMeasure AS ExecutionTimeUnitOfMeasure,
	ScheduleOverridable.LeftLimit AS Begin,
	ScheduleOverridable.RightBorder_ AS Ending,
	ScheduleOverridable.WorkCenter.WorkCenterType AS WorkCenterType,
	QueueOverridable.OperationID AS OperationID,
	QueueOverridable.OperationNumber AS OperationNumber,
	QueueOverridable.NextOperation AS NextOperation
FROM
	InformationRegister.PostOperativeSchedule2_2 AS ScheduleOverridable
		INNER JOIN InformationRegister.QueueOfProductionOperations AS QueueOverridable
		ON ScheduleOverridable.Stage = QueueOverridable.Stage
			AND ScheduleOverridable.Operation = QueueOverridable.Operation
			AND ScheduleOverridable.Department = QueueOverridable.Department
			AND ScheduleOverridable.OperationID = QueueOverridable.OperationID
			AND QueueOverridable.MainEntry_
		LEFT JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcessOverridable
		ON ScheduleOverridable.Stage = TechnicalProcessOverridable.Stage
WHERE
	NOT ScheduleOverridable.ThisIsOperationDeletion
	AND NOT ScheduleOverridable.Modeling
	AND NOT ScheduleOverridable.ThisIsChangeover
	AND NOT ScheduleOverridable.AdditionalRecord
	AND NOT ScheduleOverridable.Secondary
	AND NOT QueueOverridable.InArchive
	AND NOT ScheduleOverridable.DisableToCreateOperations</queryText>
      <mainTable>InformationRegister.PostOperativeSchedule2_2</mainTable>
