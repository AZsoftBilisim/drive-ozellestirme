    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	OperationsOverridable.Ref AS Ref,
	OperationsOverridable.Number AS Number,
	OperationsOverridable.Date AS Date,
	OperationsOverridable.Status AS Status,
	OperationsOverridable.Operation AS Operation,
	OperationsOverridable.Stage AS Stage,
	OperationsOverridable.Performer AS Performer,
	CASE
		WHEN OperationsOverridable.WorkCenter REFS Catalog.WorkCenterTypes
			THEN OperationsOverridable.WorkCenter
		ELSE
			OperationsOverridable.WorkCenter.WorkCenterType
	END AS WorkCenterType,
	CASE
		WHEN OperationsOverridable.WorkCenter REFS Catalog.WorkCenters
			THEN OperationsOverridable.WorkCenter
		ELSE
			VALUE(Catalog.WorkCenters.EmptyRef)
	END AS WorkCenter,
	OperationsOverridable.ProductionArea AS ProductionArea,
	OperationsOverridable.RepetitionIsRequired AS RepetitionIsRequired,
	OperationsOverridable.Skippable   AS Skippable,
	
	&amp;PresentationStage AS PresentationStage,
	
	OperationsOverridable.Count
		- OperationsOverridable.CountCanceled AS Count
	
FROM
	Document.ProductionOperation2_2 AS OperationsOverridable
</queryText>
