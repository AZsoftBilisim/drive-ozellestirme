		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS UnitOfMeasure,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
	0.000 AS IsLocked,
	0.000 AS AvailableInventory,
	DATETIME(1, 1, 1) AS ControlTerm,
	FALSE AS ThereAreControlLines,
	FALSE AS InTransitProcess
{SELECT
	Products AS Products,
	UnitOfMeasure AS UnitOfMeasure,
	Characteristic AS Characteristic,
	Warehouse AS Warehouse,
	Purpose AS Purpose,
	ControlledLotReference AS ControlledLotReference,
	Series AS Series,
	Premise AS Premise,
	IsLocked AS IsLocked,
	AvailableInventory AS AvailableInventory,
	ControlTerm AS ControlTerm,
	ThereAreControlLines AS ThereAreControlLines,
	InTransitProcess AS InTransitProcess}
{WHERE
	CAST(VALUE(Catalog.Products.EmptyRef) AS Catalog.Products).* AS Products,
	CAST(VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Catalog.ItemsCharacteristics).* AS Characteristic,
	CAST(VALUE(Catalog.Warehouses.EmptyRef) AS Catalog.Warehouses).* AS Warehouse,
	CAST(VALUE(Catalog.Assignments.EmptyRef) AS Catalog.Assignments).* AS Purpose,
	CAST(VALUE(Catalog.ControlledLots.EmptyRef) AS Catalog.ControlledLots).* AS ControlledLotReference,
	CAST(VALUE(Catalog.ItemsBatches.EmptyRef) AS Catalog.ItemsBatches).* AS Series,
	CAST(VALUE(Catalog.Warerooms.EmptyRef) AS Catalog.Warerooms).* AS Premise,
	DATETIME(1, 1, 1) AS ControlTerm,
	FALSE AS InTransitProcess}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
