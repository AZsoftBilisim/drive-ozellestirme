    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	FilterCriterionBudgetEntryFormTasks.Ref AS Ref,
	Task.Performer AS Performer,
	Task.BudgetingProcess AS BudgetingProcess,
	Task.BudgetingProcess.EmployeeResponsible AS TheProcessResponsible
FROM
	FilterCriterion.BudgetEntryFormTasks AS FilterCriterionBudgetEntryFormTasks
		LEFT JOIN Task.BudgetTask AS Task
		ON FilterCriterionBudgetEntryFormTasks.Ref = Task.Ref</queryText>
      <mainTable>FilterCriterion.BudgetEntryFormTasks</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
