  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentJournalARAPReconciliations.Ref AS Ref,
	DocumentJournalARAPReconciliations.Date AS Date,
	DocumentJournalARAPReconciliations.DeletionMark AS DeletionMark,
	DocumentJournalARAPReconciliations.Number AS Number,
	DocumentJournalARAPReconciliations.Posted AS Posted,
	DocumentJournalARAPReconciliations.Organization AS Organization,
	DocumentJournalARAPReconciliations.Counterparty AS Counterparty,
	DocumentJournalARAPReconciliations.Partner AS Partner,
	DocumentJournalARAPReconciliations.Contract AS Contract,
	DocumentJournalARAPReconciliations.Type AS Type,
	DocumentJournalARAPReconciliations.Status AS Status,
	DocumentJournalARAPReconciliations.ReconciliationState AS ReconciliationState,
	DocumentJournalARAPReconciliations.PaymentType_ AS PaymentType_,
	DocumentJournalARAPReconciliations.Manager AS Manager,
	DocumentJournalARAPReconciliations.BeginOfPeriod AS BeginOfPeriod,
	DocumentJournalARAPReconciliations.EndOfPeriod AS EndOfPeriod,
	DocumentJournalARAPReconciliations.Author AS Author,
	DocumentJournalARAPReconciliations.Currency AS Currency,
	DocumentJournalARAPReconciliations.Comment AS Comment,
	ISNULL(FilesExist.HasFiles, FALSE) AS HasFiles,
	EDStates.EDIState AS EDIState,
	EDStates.StatusPresentation AS StatusPresentation
FROM
	DocumentJournal.ARAPReconciliations AS DocumentJournalARAPReconciliations
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON DocumentJournalARAPReconciliations.Ref = FilesExist.ObjectWithFiles
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON DocumentJournalARAPReconciliations.Ref = EDStates.ObjectReference}
{WHERE
	(NOT TRUE IN
				(SELECT TOP 1
					TRUE
				FROM
					Document.ARAPReconciliation2_4.GroupingsFinancialInstruments AS FinTools
				WHERE
					DocumentJournalARAPReconciliations.Ref = FinTools.Ref
					AND FinTools.PaymentType_ IN (&amp;ProhibitedPaymentTypes)))}</queryText>
      <mainTable>DocumentJournal.ARAPReconciliations</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
