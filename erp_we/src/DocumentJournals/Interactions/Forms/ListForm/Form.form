  <attributes>
    <name>NavigationPanelSubjects</name>
    <title>
      <key>en</key>
      <value>Topics navigation panel</value>
    </title>
    <title>
      <key>fa</key>
      <value>پنل پیمایش موضوعات</value>
    </title>
    <title>
      <key>it</key>
      <value>Elementi barra di navigazione</value>
    </title>
    <title>
      <key>pl</key>
      <value>Przedmioty panel nawigacji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Предметы панель навигации</value>
    </title>
    <title>
      <key>tr</key>
      <value>Konular gezinti paneli</value>
    </title>
    <title>
      <key>vi</key>
      <value>Chủ đề thanh lệnh dẫn hướng</value>
    </title>
    <id>36</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>NavigationPanelSubjects.SubjectOf</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	InteractionsSubjectsStatesOverridable.SubjectOf AS SubjectOf,
	InteractionsSubjectsStatesOverridable.NotReviewedInteractionsCount AS NotReviewedInteractionsCount,
	InteractionsSubjectsStatesOverridable.Running AS Running,
	InteractionsSubjectsStatesOverridable.LastInteractionDate AS LastInteractionDate,
	VALUETYPE(InteractionsSubjectsStatesOverridable.SubjectOf) AS SubjectType
FROM
	InformationRegister.InteractionsSubjectsStates AS InteractionsSubjectsStatesOverridable
		INNER JOIN InformationRegister.InteractionsFolderSubjects AS InteractionsFolderSubjectsOverridable
			INNER JOIN DocumentJournal.Interactions AS InteractionsOverridable
			ON InteractionsFolderSubjectsOverridable.Interaction = InteractionsOverridable.Ref
		ON InteractionsSubjectsStatesOverridable.SubjectOf = InteractionsFolderSubjectsOverridable.SubjectOf
{WHERE
	InteractionsOverridable.EmployeeResponsible,
	InteractionsOverridable.Type,
	InteractionsOverridable.Importance,
	InteractionsOverridable.OutgoingEmailStatus,
	InteractionsOverridable.Account,
	InteractionsOverridable.Author,
	InteractionsOverridable.DeletionMark,
	InteractionsOverridable.Incoming,
	InteractionsFolderSubjectsOverridable.Reviewed,
	InteractionsFolderSubjectsOverridable.ReviewAfter}</queryText>
      <mainTable>InformationRegister.InteractionsSubjectsStates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>ContactsNavigationPanel</name>
    <title>
      <key>en</key>
