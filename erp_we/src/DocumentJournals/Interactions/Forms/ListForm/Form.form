    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE
		WHEN InteractionDocumentsLogOverridable.Ref REFS Document.Meeting
			THEN CASE
					WHEN InteractionDocumentsLogOverridable.DeletionMark
						THEN 10
					ELSE 0
				END
		WHEN InteractionDocumentsLogOverridable.Ref REFS Document.PlannedInteraction
			THEN CASE
					WHEN InteractionDocumentsLogOverridable.DeletionMark
						THEN 11
					ELSE 1
				END
		WHEN InteractionDocumentsLogOverridable.Ref REFS Document.PhoneCall
			THEN CASE
					WHEN InteractionDocumentsLogOverridable.DeletionMark
						THEN 12
					ELSE 2
				END
		WHEN InteractionDocumentsLogOverridable.Ref REFS Document.IncomingEmail
			THEN CASE
					WHEN InteractionDocumentsLogOverridable.DeletionMark
						THEN 13
					ELSE 3
				END
		WHEN InteractionDocumentsLogOverridable.Ref REFS Document.OutgoingEmail
			THEN CASE
					WHEN InteractionDocumentsLogOverridable.DeletionMark
						THEN 14
					ELSE CASE
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.OutgoingEmailStatuses.Draft)
								THEN 15
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.OutgoingEmailStatuses.Outgoing)
								THEN 16
							ELSE 4
						END
				END
		WHEN InteractionDocumentsLogOverridable.Ref REFS Document.SMSMessage
			THEN CASE
					WHEN InteractionDocumentsLogOverridable.DeletionMark
						THEN 22
					ELSE CASE
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.SMSDocumentStatuses.Draft)
								THEN 17
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.SMSDocumentStatuses.Outgoing)
								THEN 18
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.SMSDocumentStatuses.DeliveryInProgress)
								THEN 19
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.SMSDocumentStatuses.PartiallyDelivered)
								THEN 21
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.SMSDocumentStatuses.NotDelivered)
								THEN 23
							WHEN InteractionDocumentsLogOverridable.OutgoingEmailStatus = VALUE(Enum.SMSDocumentStatuses.Delivered)
								THEN 24
							ELSE 17
						END
				END
	END AS PictureNumber,
	InteractionDocumentsLogOverridable.Ref,
	InteractionDocumentsLogOverridable.Date,
	InteractionDocumentsLogOverridable.DeletionMark,
	InteractionDocumentsLogOverridable.Number,
	InteractionDocumentsLogOverridable.Author,
	InteractionDocumentsLogOverridable.Incoming,
	InteractionDocumentsLogOverridable.Subject,
	InteractionDocumentsLogOverridable.EmployeeResponsible AS EmployeeResponsible,
	ISNULL(InteractionsSubjectsOverridable.Reviewed, FALSE) AS Reviewed,
	ISNULL(InteractionsSubjectsOverridable.ReviewAfter, DATETIME(1,1,1)) AS ReviewAfter,
	InteractionDocumentsLogOverridable.Attendees,
	InteractionDocumentsLogOverridable.Type,
	InteractionDocumentsLogOverridable.OutgoingEmailStatus,
	CASE
		WHEN ISNULL(InteractionDocumentsLogOverridable.HasAttachments, FilesExistOverridable.HasFiles) IS NULL
			THEN FALSE
		WHEN ISNULL(InteractionDocumentsLogOverridable.HasAttachments, FilesExistOverridable.HasFiles)
			THEN TRUE
		ELSE FALSE
	END AS HasAttachments,
	ISNULL(InteractionsSubjectsOverridable.SubjectOf, UNDEFINED) AS SubjectOf,
	VALUETYPE(InteractionsSubjectsOverridable.SubjectOf) AS SubjectType,
	InteractionDocumentsLogOverridable.Account,
	ISNULL(InteractionsSubjectsOverridable.EmailMessageFolder, VALUE(Catalog.EmailMessageFolders.EmptyRef)) AS Folder,
	InteractionDocumentsLogOverridable.SentReceived AS SentReceived,
	CAST(InteractionDocumentsLogOverridable.Size / 1024 AS NUMBER(10, 2)) AS Size,
	InteractionDocumentsLogOverridable.Importance,
	CASE
		WHEN InteractionDocumentsLogOverridable.Importance = VALUE(Enum.InteractionImportanceOptions.High)
			THEN 2
		WHEN InteractionDocumentsLogOverridable.Importance = VALUE(Enum.InteractionImportanceOptions.Low)
			THEN 0
		ELSE 1
	END AS ImportancePictureNumber
FROM
	DocumentJournal.Interactions AS InteractionDocumentsLogOverridable
		LEFT JOIN InformationRegister.InteractionsFolderSubjects AS InteractionsSubjectsOverridable
		ON InteractionDocumentsLogOverridable.Ref = InteractionsSubjectsOverridable.Interaction
		LEFT JOIN InformationRegister.FilesExist AS FilesExistOverridable
		ON InteractionDocumentsLogOverridable.Ref = FilesExistOverridable.ObjectWithFiles
{WHERE
	InteractionDocumentsLogOverridable.Ref AS Search}</queryText>
      <mainTable>DocumentJournal.Interactions</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
