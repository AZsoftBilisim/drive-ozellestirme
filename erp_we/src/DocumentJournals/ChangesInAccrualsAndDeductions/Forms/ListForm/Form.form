    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentJournalChangesInAccrualsAndDeductions.Ref AS Ref,
	DocumentJournalChangesInAccrualsAndDeductions.Date AS Date,
	DocumentJournalChangesInAccrualsAndDeductions.DeletionMark AS DeletionMark,
	DocumentJournalChangesInAccrualsAndDeductions.Number AS Number,
	DocumentJournalChangesInAccrualsAndDeductions.Posted AS Posted,
	DocumentJournalChangesInAccrualsAndDeductions.Organization AS Organization,
	DocumentJournalChangesInAccrualsAndDeductions.Ref.Department AS Department,
	DocumentJournalChangesInAccrualsAndDeductions.Ref.Comment AS Comment,
	DocumentJournalChangesInAccrualsAndDeductions.Ref.EmployeeResponsible AS EmployeeResponsible,
	CASE
		WHEN VALUETYPE(DocumentJournalChangesInAccrualsAndDeductions.Ref) = TYPE(Document.EmployeeTransferHR)
			THEN DocumentJournalChangesInAccrualsAndDeductions.Ref.DateOfTransition
		ELSE DocumentJournalChangesInAccrualsAndDeductions.Ref.ChangeDate
	END AS ChangeDate,
	DocumentJournalChangesInAccrualsAndDeductions.Type AS Type
FROM
	DocumentJournal.ChangesInAccrualsAndDeductions AS DocumentJournalChangesInAccrualsAndDeductions
{WHERE
	(TRUE IN
			(SELECT TOP 1
				TRUE
			FROM
				InformationRegister.RegularAccrualsAndDeductionsHR AS RegularAccrualsAndDeductionsHR
			WHERE
				RegularAccrualsAndDeductionsHR.Employee = &amp;FilterEmployee
				AND DocumentJournalChangesInAccrualsAndDeductions.Ref = RegularAccrualsAndDeductionsHR.Recorder))}</queryText>
      <mainTable>DocumentJournal.ChangesInAccrualsAndDeductions</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
