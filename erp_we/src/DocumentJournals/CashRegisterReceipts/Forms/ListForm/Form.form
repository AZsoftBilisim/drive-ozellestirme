  <attributes>
    <name>CashRegisterReceipts</name>
    <title>
      <key>en</key>
      <value>Receipts</value>
    </title>
    <title>
      <key>fa</key>
      <value>دریافت‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Scontrini del registratore di cassa</value>
    </title>
    <title>
      <key>pl</key>
      <value>Paragony kasowe</value>
    </title>
    <title>
      <key>ru</key>
      <value>Чеки ККМ</value>
    </title>
    <title>
      <key>tr</key>
      <value>Yazar kasa çekleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Phiếu tính tiền</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisterReceipts.CashRegister</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisterReceipts.CashRegisterReceiptNumber</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisterReceipts.CashRegisterShift</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisterReceipts.DeferredReceiptCashRegistersRefund</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisterReceipts.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CashRegisterReceipts.Ref AS Ref,
	CashRegisterReceipts.Date AS Date,
	CashRegisterReceipts.DeletionMark AS DeletionMark,
	CashRegisterReceipts.Number AS Number,
	CashRegisterReceipts.Posted AS Posted,
	CashRegisterReceipts.Status AS Status,
	CASE
		WHEN CashRegisterReceipts.Ref REFS Document.CashRegisterReceipt
			THEN CASE
				WHEN CashRegisterReceipts.Status = VALUE(Enum.CashRegisterReceiptStatuses.DeferredWithoutReservation)
				OR CashRegisterReceipts.Status = VALUE(Enum.CashRegisterReceiptStatuses.DeferredWithReservation)
					THEN TRUE
				ELSE FALSE
			END
		ELSE CASE
			WHEN CashRegisterReceipts.Status = VALUE(Enum.CashRegisterReceiptStatuses.ReceiptIsIssued_)
				THEN FALSE
			ELSE TRUE
		END
	END AS Defer,
	CashRegisterReceipts.CashRegisterReceiptNumber AS CashRegisterReceiptNumber,
	CashRegisterReceipts.CashRegister AS CashRegister,
	CashRegisterReceipts.Organization AS Organization,
	CashRegisterReceipts.DocumentAmount AS DocumentAmount,
	CashRegisterReceipts.Currency AS Currency,
	CashRegisterReceipts.Archived AS Archived,
	CashRegisterReceipts.CashRegisterShift AS CashRegisterShift,
	CashRegisterReceipts.Type AS Type,
	VALUE(Document.CashRegisterReceiptReturn.EmptyRef) AS DeferredReceiptCashRegistersRefund
FROM
	DocumentJournal.CashRegisterReceipts AS CashRegisterReceipts</queryText>
      <mainTable>DocumentJournal.CashRegisterReceipts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
