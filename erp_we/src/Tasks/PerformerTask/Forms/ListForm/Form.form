  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.AcceptedForExecution</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessProcess</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.SubjectOf</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.SubjectString</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	TaskPerformerTask.Ref,
	TaskPerformerTask.DeletionMark,
	TaskPerformerTask.Number,
	TaskPerformerTask.Date,
	TaskPerformerTask.BusinessProcess,
	TaskPerformerTask.RoutePoint,
	TaskPerformerTask.Description,
	TaskPerformerTask.Executed,
	CASE
		WHEN TaskPerformerTask.Importance = VALUE(Enum.TaskImportanceOptions.Low)
			THEN 0
		WHEN TaskPerformerTask.Importance = VALUE(Enum.TaskImportanceOptions.High)
			THEN 2
		ELSE 1
	END AS ImportancePicture,
	TaskPerformerTask.Importance,
	TaskPerformerTask.CompletionDate,
	TaskPerformerTask.Author,
	TaskPerformerTask.LongDesc,
	TaskPerformerTask.TaskDueDate,
	TaskPerformerTask.ExecutionResult,
	TaskPerformerTask.SubjectString,
	TaskPerformerTask.SubjectOf,
	TaskPerformerTask.Performer,
	TaskPerformerTask.PerformerRole,
	TaskPerformerTask.MainAddressingObject,
	TaskPerformerTask.AdditionalAddressingObject,
	TaskPerformerTask.AcceptedForExecution,
	CASE
		WHEN TaskPerformerTask.BusinessProcessState = VALUE(Enum.BusinessProcessStates.Suspended)
			THEN TRUE
		ELSE FALSE
	END AS Stopped
FROM
	Task.PerformerTask AS TaskPerformerTask
WHERE
	(&amp;SelectedPerformer IS NULL 
			OR TaskPerformerTask.Performer = &amp;SelectedPerformer
			OR TRUE IN
				(SELECT
					TRUE
				FROM
					InformationRegister.TaskPerformers AS TaskPerformers
				WHERE
					TaskPerformerTask.PerformerRole = TaskPerformers.PerformerRole
					AND TaskPerformerTask.MainAddressingObject = TaskPerformers.MainAddressingObject
					AND TaskPerformerTask.AdditionalAddressingObject = TaskPerformers.AdditionalAddressingObject
					AND TaskPerformers.Performer = &amp;SelectedPerformer))</queryText>
      <mainTable>Task.PerformerTask</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
