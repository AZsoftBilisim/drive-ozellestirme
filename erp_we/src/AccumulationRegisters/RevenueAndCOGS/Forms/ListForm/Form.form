    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Revenue.Period,
	Revenue.Recorder,
	Revenue.LineNumber,
	Revenue.Active,
	Revenue.SalesOrder,
	Revenue.Department,
	Revenue.InventoryType,
	Revenue.InventoryOwnerAttribute,
	Revenue.Count,
	Revenue.RevenueAmount,
	Revenue.Cost,
	Revenue.AddExpensesForGoods,
	Revenue.AdditionalExpensesExcludingVAT,
	Revenue.BusinessOperation,
	Revenue.VATTaxation,
	Revenue.PointInTime,
	Revenue.Manager,
	Revenue.AccountingSection,
	Revenue.Lot,
	Revenue.LotVendorAttributes,
	KeysForLotVendorAttributes.Vendor,
	KeysForLotVendorAttributes.Counterparty AS SupplierCounterparty,
	Revenue.VATRate,
	Revenue.FinancialAccountingDimension,
	Revenue.VATActivityType,
	DimensionKeysOfAccountingByPartners.Organization,
	DimensionKeysOfAccountingByPartners.Partner,
	DimensionKeysOfAccountingByPartners.Counterparty,
	InventoryLocationAttributeKeys.Products,
	InventoryLocationAttributeKeys.Characteristic,
	InventoryLocationAttributeKeys.Series,
	InventoryLocationAttributeKeys.Purpose,
	Revenue.RevenueAmountExcludingVAT,
	Revenue.CostExcludingVAT,
	Revenue.LocalCost,
	Revenue.RevenueAmountExclVATLocal,
	Revenue.OffBalanceCost,
	Revenue.LaborCosts,
	Revenue.ItemizedFixedCostsIncludingVAT,
	Revenue.ItemizedVariableCostsIncludingVAT,
	Revenue.ItemizedFixedCostsExcludingVAT,
	Revenue.ItemizedVariableCostsExcludingVAT,
	Revenue.OffBalanceCostLocal,
	Revenue.AddExpensesLocal,
	Revenue.LaborCostsLocal,
	Revenue.ItemizedFixedCostsCompl,
	Revenue.ItemizedVariableCostsCompl,
	Revenue.CostMan,
	Revenue.AddExpensesMan,
	Revenue.LaborCostsMan,
	Revenue.ItemizedFixedCostsManag,
	Revenue.ItemizedVariableCostsManag,
	Revenue.SellingExpensesExcludingVAT,
	Revenue.SellingExpensesIncludingVAT,
	Revenue.SellingExpensesMan,
	Revenue.SellingExpensesLocal,
	Revenue.ProvisionForImpairmentLocal,
	Revenue.ProvisionForImpairmentMan,
	Revenue.PermanentDifference,
	Revenue.CostTD,
	(Revenue.LocalCost
		+ Revenue.AddExpensesLocal
		+ Revenue.LaborCostsLocal
		+ Revenue.ItemizedFixedCostsCompl
		+ Revenue.ItemizedVariableCostsCompl
		+ Revenue.ProvisionForImpairmentLocal
		- Revenue.PermanentDifference
		- Revenue.CostTD) AS CostInTaxAccounting,

	Revenue.Warehouse AS Warehouse,
	Revenue.Terms,
	Revenue.Contract,
	Revenue.RevenueAmountIncludingVATLocal,
	Revenue.ManualDiscount,
	Revenue.DiscountMarkupAmount,
	Revenue.ARAPCurrency,
	Revenue.AmountInARAPCurrency,
	Revenue.AmountExcludingVATInARAPCurrency,
	Revenue.DocumentCurrency,
	Revenue.AmountInDocumentCurrency,
	Revenue.AmountExcludingVATInDocumentCurrency,
	Revenue.CounterpartyLineOfBusiness,
	Revenue.ProductLineOfBusiness,
	Revenue.SourceOfProductFinancialAccountingGroup,
	Revenue.SourceOfARAPFinancialAccountingGroup,
	Revenue.DocumentRegisterRecords,
	Revenue.LotCalculation,
	Revenue.CalculationOfCost,
	Revenue.CalculationIsNotCompleted,
	Revenue.BusinessTransactionSetting,
	Revenue.FinRecordID,
	Revenue.DocumentCalculation,
	Revenue.MonthEndClosingMode,
	Revenue.ReversingEntry,
	Revenue.ExciseAmountInCurrencyLocal,
	Revenue.ExciseAmountInCurrencyMgmt,
	Revenue.AdjustmentPeriod_
FROM
	AccumulationRegister.RevenueAndCOGS AS Revenue
	LEFT JOIN Catalog.DimensionKeysOfAccountingByPartners AS DimensionKeysOfAccountingByPartners
		ON Revenue.AccountingDimensionByPartners = DimensionKeysOfAccountingByPartners.Ref
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
		ON Revenue.ItemsLocationAttributes = InventoryLocationAttributeKeys.Ref
	LEFT JOIN Catalog.KeysForLotVendorAttributes AS KeysForLotVendorAttributes
		ON KeysForLotVendorAttributes.Ref = Revenue.LotVendorAttributes</queryText>
      <mainTable>AccumulationRegister.RevenueAndCOGS</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
