    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CompanyGoods.Period AS Period,
	CompanyGoods.Recorder AS Recorder,
	CompanyGoods.LineNumber AS LineNumber,
	CompanyGoods.Active AS Active,
	CompanyGoods.RecordType AS RecordType,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	DimensionKeys.Products AS Products,
	DimensionKeys.Characteristic AS Characteristic,
	DimensionKeys.Purpose AS Purpose,
	DimensionKeys.Series AS Series,
	DimensionKeys.StorageLocation AS StorageLocation,
	CompanyGoods.Organization AS Organization,
	CompanyGoods.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.Count AS Count,
	CompanyGoods.QuantityByGBRN AS QuantityByGBRN,
	CompanyGoods.ToRegisterGoodsIssue AS ToRegisterGoodsIssue,
	CompanyGoods.ToRegisterGoodsIssueByProductBatchID AS ToRegisterGoodsIssueByProductBatchID,
	CompanyGoods.BusinessOperation AS BusinessOperation,
	CompanyGoods.VATTaxation AS VATTaxation,
	CompanyGoods.CorItemsLocationAttributes AS CorItemsLocationAttributes,
	CompanyGoods.CorInventoryOwnerAttribute AS CorInventoryOwnerAttribute,
	CompanyGoods.ShipmentCompany AS ShipmentCompany,
	CompanyGoods.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
	CompanyGoods.ExpenseItem AS ExpenseItem,
	CompanyGoods.DimensionOfExpenses AS DimensionOfExpenses,
	CompanyGoods.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	CompanyGoods.LotCalculation AS LotCalculation,
	CompanyGoods.Primary AS Primary,
	CompanyGoods.PointInTime AS PointInTime
FROM
	AccumulationRegister.CompanyGoods AS CompanyGoods
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionKeys
		ON CompanyGoods.ItemsLocationAttributes = DimensionKeys.Ref
</queryText>
      <mainTable>AccumulationRegister.CompanyGoods</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
