    </synonym>
    <synonym>
      <key>ru</key>
      <value>К поступлению от поставщика</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Teslim alınacak tedarikçiden</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cần tiếp nhận từ nhà cung cấp</value>
    </synonym>
    <type>
      <types>DefinedType.MonetaryAmountPositiveNegative</types>
