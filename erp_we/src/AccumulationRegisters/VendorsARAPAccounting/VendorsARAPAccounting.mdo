  <resources uuid="c315faa9-a989-48c0-b37d-28bd7abc88c5">
    <name>AmountDue</name>
    <synonym>
      <key>en</key>
      <value>Amount due to vendor</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>مبلغ قابل پرداخت به تأمین‌کننده</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Da pagare al fornitore</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Do płatności wobec dostawcy</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>К оплате поставщику</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Tedarikçiye ödenecek</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cần trả tiền cho nhà cung cấp</value>
