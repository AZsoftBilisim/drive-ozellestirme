  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>List</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.StageConsumer</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Назначение</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.НазначениеРедактирование</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Потребитель</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Table.Stage AS StageConsumer
FROM
	(
		SELECT
			Table.Stage AS Stage
		FROM
			AccumulationRegister.ProductionProcessSupply AS Table
		WHERE
			ReferenceOrder = &amp;ReferenceOrder
			
			AND Products = &amp;Products
			AND Characteristic = &amp;Characteristic
			
			AND Purpose = &amp;Purpose
			AND Stage &lt;> &amp;EmptyStageLink
			
			AND (Warehouse = &amp;Warehouse AND Department = &amp;Department OR NOT &amp;FilterByRecipient)
			
			AND Recorder &lt;> &amp;Recorder
				AND Active
			
		GROUP BY
			
			Table.Stage,
			Table.Purpose
		
		HAVING
			SUM(Table.Required2) > SUM(Table.Scheduled)
											 + SUM(Table.TransferredToProduction)
											 + SUM(Table.Produced)
											 + SUM(Table.Manufactured)
		
		UNION ALL
		
		SELECT
			Table.Stage AS Stage
		FROM
			AccumulationRegister.ProductionProcessSupply AS Table
		WHERE
			ReferenceOrder = &amp;ReferenceOrder
			
			AND Products = &amp;Products
			AND Characteristic = &amp;Characteristic
			
			AND Purpose = &amp;Purpose
			
			AND Stage &lt;> &amp;EmptyStageLink
			
			AND (Warehouse = &amp;Warehouse OR NOT &amp;FilterByRecipient)
			
			AND Recorder &lt;> &amp;Recorder
				AND Active
			
		GROUP BY
			
			Table.Stage
		
		HAVING
			SUM(Table.DisassemblyIsPlanned) > CASE
														WHEN SUM(Table.ReadyForDisassembly) > SUM(Table.DisassemblyIsRequired)
															THEN
																SUM(Table.ReadyForDisassembly)
														ELSE
															SUM(Table.DisassemblyIsRequired)
														END
		
		UNION ALL
		
		SELECT
			Table.Ref
		FROM
			Document.ProductionStage2_2 AS Table
		WHERE
			Table.Purpose = &amp;Purpose
		
	) AS Table

	GROUP BY
		
		Table.Stage</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>StageConsumer</dataPath>
        <field>StageConsumer</field>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Consumer stage</value>
            </content>
            <content>
              <key>fa</key>
              <value>مرحله مصرف‌کننده</value>
            </content>
            <content>
              <key>it</key>
              <value>Fase consumatore</value>
            </content>
            <content>
              <key>pl</key>
              <value>Etap konsument</value>
            </content>
            <content>
              <key>ru</key>
              <value>Этап потребитель</value>
            </content>
            <content>
              <key>tr</key>
              <value>Tüketici aşaması</value>
            </content>
            <content>
              <key>vi</key>
              <value>Công đoạn tiêu dùng</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Stage</dataPath>
        <field>Stage</field>
      </fields>
      <parameters>
        <name>Purpose</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Assignment</value>
            </content>
            <content>
              <key>fa</key>
              <value>تخصیص</value>
            </content>
            <content>
              <key>it</key>
              <value>Destinazione</value>
            </content>
