    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
	OtherExpensesOfUnfinishedProduction.Period, 
	OtherExpensesOfUnfinishedProduction.Recorder, 
	OtherExpensesOfUnfinishedProduction.LineNumber, 
	OtherExpensesOfUnfinishedProduction.Active, 
	OtherExpensesOfUnfinishedProduction.RecordType, 
	OtherExpensesOfUnfinishedProduction.ExpenseItem, 
	OtherExpensesOfUnfinishedProduction.Organization, 
	OtherExpensesOfUnfinishedProduction.Department, 
	OtherExpensesOfUnfinishedProduction.DimensionOfExpenses, 
	OtherExpensesOfUnfinishedProduction.LineOfBusiness, 
	OtherExpensesOfUnfinishedProduction.ProductionLot, 
	OtherExpensesOfUnfinishedProduction.ProductionOrder, 
	OtherExpensesOfUnfinishedProduction.RowCodeProducts, 
	OtherExpensesOfUnfinishedProduction.Stage, 
	OtherExpensesOfUnfinishedProduction.ProductCostElement, 
	OtherExpensesOfUnfinishedProduction.ProductsGroup, 
	OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots, 
	OtherExpensesOfUnfinishedProduction.Cost, 
	OtherExpensesOfUnfinishedProduction.CostExcludingVAT, 
	OtherExpensesOfUnfinishedProduction.LocalCost,
	OtherExpensesOfUnfinishedProduction.LocalCost
		- OtherExpensesOfUnfinishedProduction.PermanentDifference
		- OtherExpensesOfUnfinishedProduction.CostTD AS CostInTaxAccounting,
	OtherExpensesOfUnfinishedProduction.PermanentDifference, 
	OtherExpensesOfUnfinishedProduction.CostTD, 
	OtherExpensesOfUnfinishedProduction.CostShare, 
	OtherExpensesOfUnfinishedProduction.CostMan, 
	OtherExpensesOfUnfinishedProduction.CostOfPersonalIncomeTax, 
	OtherExpensesOfUnfinishedProduction.ManufacturedProduct, 
	OtherExpensesOfUnfinishedProduction.ItemVariant, 
	OtherExpensesOfUnfinishedProduction.ProductsQuantity, 
	OtherExpensesOfUnfinishedProduction.ProductsAccountingDimension, 
	OtherExpensesOfUnfinishedProduction.AccountingSection, 
	OtherExpensesOfUnfinishedProduction.InventoryOwnerAttribute, 
	OtherExpensesOfUnfinishedProduction.DocumentRegisterRecords, 
	OtherExpensesOfUnfinishedProduction.DocumentSource, 
	OtherExpensesOfUnfinishedProduction.DocumentOfProductionIssue, 
	OtherExpensesOfUnfinishedProduction.CalculationOfCost, 
	OtherExpensesOfUnfinishedProduction.LotCalculation, 
	OtherExpensesOfUnfinishedProduction.IndicatorOfAllocationToLot, 
	OtherExpensesOfUnfinishedProduction.IndicatorOfAllocationToLotExcludingVAT, 
	OtherExpensesOfUnfinishedProduction.IndicatorOfAllocationToLotCompl, 
	OtherExpensesOfUnfinishedProduction.IndicatorOfAllocationToLotManag, 
	OtherExpensesOfUnfinishedProduction.ReleaseLotDimension, 
	OtherExpensesOfUnfinishedProduction.LotVendorAttributesCorr, 
	OtherExpensesOfUnfinishedProduction.BusinessTransactionSetting, 
	OtherExpensesOfUnfinishedProduction.FinRecordID, 
	OtherExpensesOfUnfinishedProduction.ReversingEntry, 
	OtherExpensesOfUnfinishedProduction.PointInTime
 FROM 
	AccumulationRegister.OtherWorkInProgressExpenses AS OtherExpensesOfUnfinishedProduction</queryText>
      <mainTable>AccumulationRegister.OtherWorkInProgressExpenses</mainTable>
