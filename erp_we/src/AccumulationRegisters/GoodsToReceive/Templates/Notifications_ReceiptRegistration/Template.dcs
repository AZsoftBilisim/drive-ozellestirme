		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	GoodsToReceive.Recorder AS NotificationSource,
	GoodsToReceive.DocumentInflow AS NotificationContext,
	GoodsToReceive.DocumentInflow.Organization AS Organization,
	ISNULL(GoodsToReceive.DocumentInflow.Manager, GoodsToReceive.DocumentInflow.EmployeeResponsible) AS NotificationRecipient,
	GoodsToReceive.Period AS DateOfReceipt
FROM
	AccumulationRegister.GoodsToReceive AS GoodsToReceive
		LEFT JOIN TTCacheOfAttributes AS TTCacheOfAttributes
		ON (TTCacheOfAttributes.NotificationSource = GoodsToReceive.Recorder)
			AND (TTCacheOfAttributes.NotificationContext = GoodsToReceive.DocumentInflow)
			AND (TTCacheOfAttributes.DateOfReceipt = GoodsToReceive.Period)
WHERE
	GoodsToReceive.RecordType = VALUE(AccumulationRecordType.Expense)
	AND GoodsToReceive.ToRegisterReceiptsByInvoices &gt; 0
	AND GoodsToReceive.Recorder REFS Document.ReceiptOfGoodsToWarehouse
	AND NOT GoodsToReceive.ReversingEntry
	AND TTCacheOfAttributes.NotificationSource IS NULL</query>
	</dataSet>
