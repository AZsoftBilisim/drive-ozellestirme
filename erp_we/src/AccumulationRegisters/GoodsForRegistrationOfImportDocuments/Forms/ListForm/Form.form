    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Goods.Period,
	Goods.Recorder,
	Goods.LineNumber,
	Goods.Active,
	Goods.RecordType,
	Goods.Organization,
	Goods.Vendor,
	Goods.InventoryOwnerAttribute,
	Goods.DocumentInflow,
	Goods.ImportDocumentType,	
	Goods.Count,
	Goods.QuantityByGBRN,	
	Goods.Sum,
	Goods.CCDNumber,
	Goods.PointInTime,
	Dimension.Products,
	Dimension.Characteristic,
	Dimension.Series,
	Dimension.StorageLocation AS Warehouse
FROM
	AccumulationRegister.GoodsForRegistrationOfImportDocuments AS Goods
		LEFT JOIN
				Catalog.InventoryLocationAttributeKeys AS Dimension
			ON
				Goods.ItemsLocationAttributes = Dimension.Ref	
	</queryText>
      <mainTable>AccumulationRegister.GoodsForRegistrationOfImportDocuments</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
