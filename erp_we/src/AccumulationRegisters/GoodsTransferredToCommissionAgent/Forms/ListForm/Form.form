    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Goods.Period,
	Goods.Recorder,
	Goods.LineNumber,
	Dimension.Products,
	Dimension.Characteristic,
	Goods.Terms,
	Goods.Organization,
	Goods.InventoryOwnerAttribute,
	Goods.CCDNumber,
	Goods.Count,
	Goods.QuantityByGBRN,
	Goods.RevenueAmount,
	Goods.CommissionAmount,
	Goods.CorItemsLocationAttributes,
	Goods.DocumentSalesOfGoodsAndServices,
	Goods.BusinessOperation,
	Goods.VATTaxation,
	Goods.Products AS NomenclatureSequence,
	Goods.Characteristic AS CharacteristicSequence
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent AS Goods
		INNER JOIN
				Catalog.InventoryLocationAttributeKeys AS Dimension
			ON
				Goods.ItemsLocationAttributes = Dimension.Ref</queryText>
      <mainTable>AccumulationRegister.GoodsTransferredToCommissionAgent</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
