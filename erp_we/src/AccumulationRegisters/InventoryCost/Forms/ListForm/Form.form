    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InventoryCost.Period,
	InventoryCost.Recorder,
	InventoryCost.LineNumber,
	InventoryCost.Active,
	InventoryCost.RecordType,
	InventoryCost.ItemsLocationAttributes,
	InventoryCost.AccountingSection,
	InventoryCost.InventoryOwnerAttribute,
	InventoryCost.Organization,
	InventoryCost.Lot,
	InventoryCost.LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension,
	InventoryCost.VATActivityType,
	InventoryCost.Count,
	InventoryCost.Cost,
	InventoryCost.CostExcludingVAT,
	InventoryCost.OffBalanceCost,
	InventoryCost.AddExpensesForGoods,
	InventoryCost.AdditionalExpensesExcludingVAT,
	InventoryCost.LaborCosts,
	InventoryCost.ItemizedFixedCostsIncludingVAT,
	InventoryCost.ItemizedFixedCostsExcludingVAT,
	InventoryCost.ItemizedVariableCostsIncludingVAT,
	InventoryCost.ItemizedVariableCostsExcludingVAT,
	InventoryCost.LocalCost,
	InventoryCost.OffBalanceCostLocal,
	InventoryCost.PermanentDifference,
	InventoryCost.CostTD,
	InventoryCost.CostOfPersonalIncomeTax,
	InventoryCost.AddExpensesLocal,
	InventoryCost.LaborCostsLocal,
	InventoryCost.ItemizedFixedCostsCompl,
	InventoryCost.ItemizedVariableCostsCompl,
	InventoryCost.ProvisionForImpairmentLocal,
	
	(InventoryCost.LocalCost
		+ InventoryCost.AddExpensesLocal
		+ InventoryCost.LaborCostsLocal
		+ InventoryCost.ItemizedFixedCostsCompl
		+ InventoryCost.ItemizedVariableCostsCompl
		- InventoryCost.PermanentDifference
		- InventoryCost.CostTD) AS CostInTaxAccounting,
	
	InventoryCost.BusinessOperation,
	InventoryCost.CorItemsLocationAttributes,
	InventoryCost.CorAccountingSection,
	InventoryCost.CorInventoryOwnerAttribute,
	InventoryCost.CorCompany,
	InventoryCost.CorGrossInitialCostENT,
	InventoryCost.AccountingDimensionByPartners,
	InventoryCost.SalesOrder,
	InventoryCost.Department,
	InventoryCost.DimensionOfExpenses,
	InventoryCost.ExpenseItemOfWriteOff,
	InventoryCost.IncomeItem,
	InventoryCost.DimensionOfRevenue,
	InventoryCost.SalePeriod,
	InventoryCost.AssetAndLiabilityItem,
	InventoryCost.AssetsLiabilitiesDimension,
	InventoryCost.DocumentRegisterRecords,
	InventoryCost.RowID,
	InventoryCost.ProductsGroup,
	InventoryCost.LotCalculation,
	InventoryCost.CalculationIsNotCompleted,
	InventoryCost.CalculationOfCost,
	InventoryCost.CorLot,
	InventoryCost.LotVendorAttributesCorr,
	InventoryCost.CorControllingAttributes,
	InventoryCost.FinancialAccountingDimensionOfDocument,
	InventoryCost.CorVATActivityTypes,
	InventoryCost.DocumentVATActivityType,
	InventoryCost.VATActivityTypeShipments,
	InventoryCost.VATLocal,
	InventoryCost.VATManag,
	
	InventoryCost.CostMan,
	InventoryCost.AddExpensesMan,
	InventoryCost.LaborCostsMan,
	InventoryCost.ItemizedFixedCostsManag,
	InventoryCost.ItemizedVariableCostsManag,
	InventoryCost.ProvisionForImpairmentMan,
	
	InventoryCost.ProductCostElement,
	InventoryCost.EntryType,
	InventoryCost.DocumentSource,
	InventoryCost.CorLineOfBusiness,
	
	InventoryCost.BusinessTransactionSetting,
	InventoryCost.FinRecordID,
	InventoryCost.ReversingEntry,
	InventoryCost.GLAccountSettings,
	
	InventoryCost.CostAccountingTransaction,
	InventoryCost.DocumentCalculation,
	InventoryCost.MonthEndClosingMode,

	InventoryCost.ItemsLocationAttributes.Products AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	InventoryCost.ItemsLocationAttributes.Series AS Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation AS Warehouse,
	InventoryCost.ItemsLocationAttributes.Purpose AS Purpose,
	
	InventoryCost.CorItemsLocationAttributes.Products AS CorNomenclature,
	InventoryCost.CorItemsLocationAttributes.Characteristic AS CorCharacteristics,
	InventoryCost.CorItemsLocationAttributes.Series AS CorSeries,
	InventoryCost.CorItemsLocationAttributes.StorageLocation AS CorWarehouseCorCommissionAgentCorBusinessUnit,
	InventoryCost.CorItemsLocationAttributes.Purpose AS CorAssignment,
	
	InventoryCost.LotVendorAttributes.FinancialAccountingGroup AS FinancialAccountingGroup,
	InventoryCost.LotVendorAttributes.Vendor AS Vendor,
	InventoryCost.LotVendorAttributes.Counterparty AS SupplierCounterparty,
	InventoryCost.LotVendorAttributes.VATTaxation AS VATTaxation,
	InventoryCost.LotVendorAttributes.VATRate AS VATRate,
	InventoryCost.LotVendorAttributes.AssetTaxClass AS AssetTaxClass,
	
	InventoryCost.LotVendorAttributesCorr.FinancialAccountingGroup AS CorFinancialAccountingGroup,
	InventoryCost.LotVendorAttributesCorr.Vendor AS CorSupplier,
	InventoryCost.LotVendorAttributesCorr.Counterparty AS CorSupplierCounterparty,
	InventoryCost.LotVendorAttributesCorr.VATTaxation AS CorVATTaxation,
	InventoryCost.LotVendorAttributesCorr.VATRate AS CorVATRate,
	InventoryCost.LotVendorAttributesCorr.AssetTaxClass AS CorTypeOfValue,
	
	InventoryCost.AccountingDimensionByPartners.Partner AS Partner,
	InventoryCost.AccountingDimensionByPartners.Counterparty AS PartnerCounterparty,
	InventoryCost.AccountingDimensionByPartners.Contract AS Contract,
	InventoryCost.AccountingDimensionByPartners.LineOfBusiness AS LineOfBusiness,
	
	InventoryCost.CostDefiningMethod AS CostDefiningMethod,
	InventoryCost.CostCalculationDate AS CostCalculationDate,
	InventoryCost.VariancePeriod AS VariancePeriod
	
FROM
	AccumulationRegister.InventoryCost AS InventoryCost</queryText>
      <mainTable>AccumulationRegister.InventoryCost</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ItemizedFixedCostsIncludingVAT</dataPath>
        <field>ItemizedFixedCostsIncludingVAT</field>
