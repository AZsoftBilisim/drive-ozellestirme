  </explanation>
  <explanation>
    <key>it</key>
    <value>Registrazione del costo di produzione delle merci e registrazione delle spese distribuite sul costo della produzione delle merci.</value>
  </explanation>
  <explanation>
    <key>pl</key>
    <value>Ewidencja kosztów własnych towarów, i ewidencja rozchodów, przydzielonych do kosztów własnych towarów.</value>
  </explanation>
  <explanation>
    <key>ru</key>
