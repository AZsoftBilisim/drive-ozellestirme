			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CashToBePaid.Recorder AS NotificationSource,
	CashToBePaid.PaymentRequest AS NotificationContext,
	CashToBePaid.PaymentRequest.WhoStated AS NotificationRecipient,
	CashToBePaid.Recipient AS Recipient,
	CashToBePaid.Sum AS PaymentAmount,
	CashToBePaid.PaymentRequest.Currency AS Currency,
	CashToBePaid.Organization AS Organization,
	CashToBePaid.Period AS PaymentDate,
	CashToBePaid.Recorder AS DocumentPayments
FROM
	AccumulationRegister.CashToBePaid AS CashToBePaid
		LEFT JOIN TTCacheOfAttributes AS TTCacheOfAttributes
		ON (TTCacheOfAttributes.NotificationSource = CashToBePaid.Recorder)
			AND (TTCacheOfAttributes.NotificationContext = CashToBePaid.PaymentRequest)
			AND (TTCacheOfAttributes.PaymentAmount = CashToBePaid.Sum)
			AND (TTCacheOfAttributes.PaymentDate = CashToBePaid.Period)
WHERE
	CashToBePaid.RecordType = VALUE(AccumulationRecordType.Expense)
	AND CashToBePaid.Sum &gt; 0
	AND NOT CashToBePaid.Recorder REFS Document.RegisterAdjustment
	AND VALUETYPE(CashToBePaid.PaymentRequest)  IN (TYPE(Document.PaymentRequest), TYPE(Document.ApplicationForBusinessTrip)) 
	AND CashToBePaid.ReversingEntry = FALSE
	AND TTCacheOfAttributes.NotificationSource IS NULL</query>
	</dataSet>
