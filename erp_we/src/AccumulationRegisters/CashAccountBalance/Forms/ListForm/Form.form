    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Cash.Period,
	Cash.Recorder,
	Cash.LineNumber,
	Cash.Active,
	Cash.RecordType,
	Cash.Organization,
	Cash.CashAccount,
	Cash.Sum,
	Cash.SumMan,
	Cash.SumCompl,
	Cash.BusinessOperation,
	Cash.CashFlowItem,
	Cash.AccountingDimensionByPartners,
	Cash.ARAPObject,
	Cash.Department,
	Cash.PointInTime,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty
FROM
	AccumulationRegister.CashAccountBalance AS Cash
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON Cash.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey</queryText>
      <mainTable>AccumulationRegister.CashAccountBalance</mainTable>
