		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	ShipmentReferences.Recorder AS NotificationSource,
	ShipmentReferences.ReferenceOrder AS NotificationContext,
	ShipmentReferences.ReferenceOrder.Manager AS NotificationRecipient,
	ShipmentReferences.ReferenceOrder.Organization AS Organization,
	ShipmentReferences.Period AS DateOfShipment
FROM
	AccumulationRegister.ShipmentAndReturnReferences AS ShipmentReferences
		LEFT JOIN TTCacheOfAttributes AS TTCacheOfAttributes
		ON TTCacheOfAttributes.NotificationSource = ShipmentReferences.Recorder
		AND TTCacheOfAttributes.NotificationContext = ShipmentReferences.ReferenceOrder
		AND TTCacheOfAttributes.DateOfShipment = ShipmentReferences.Period
WHERE
	ShipmentReferences.Active
	AND Recorder REFS Document.CustomerInvoice
	AND ShipmentReferences.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
	AND ShipmentReferences.Count &gt; 0
	AND NOT ShipmentReferences.ReversingEntry
	AND ShipmentReferences.ReferenceOrder &lt;&gt; ShipmentReferences.Recorder
	AND TTCacheOfAttributes.NotificationSource IS NULL

UNION ALL

SELECT DISTINCT
	ShipmentReferences.Recorder AS NotificationSource,
	ShipmentReferences.ReferenceOrder AS NotificationContext,
	ShipmentReferences.ReferenceOrder.Manager AS NotificationRecipient,
	ShipmentReferences.ReferenceOrder.Organization AS Organization,
	ShipmentReferences.Period AS DateOfShipment
FROM
	AccumulationRegister.ShipmentAndReturnReferences AS ShipmentReferences
		LEFT JOIN TTCacheOfAttributes AS TTCacheOfAttributes
		ON TTCacheOfAttributes.NotificationSource = ShipmentReferences.Recorder
		AND TTCacheOfAttributes.NotificationContext = ShipmentReferences.ReferenceOrder
		AND TTCacheOfAttributes.DateOfShipment = ShipmentReferences.Period
WHERE
	ShipmentReferences.Active
	AND Recorder REFS Document.CustomerInvoiceServices
	AND ShipmentReferences.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
	AND ShipmentReferences.Count &gt; 0
	AND NOT ShipmentReferences.ReversingEntry
	AND ShipmentReferences.ReferenceOrder &lt;&gt; ShipmentReferences.Recorder
	AND TTCacheOfAttributes.NotificationSource IS NULL</query>
	</dataSet>
