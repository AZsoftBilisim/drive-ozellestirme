	Goods.ItemsLocationAttributes.StorageLocation AS Warehouse,
	Goods.Currency,
	Goods.CCDNumber,
	Goods.Count,
	Goods.RevenueAmount,
	Goods.RevenueAmountExclVATLocal,
	Goods.RevenueAmountMan,
	Goods.QuantityConsumed,
	Goods.QuantityToRegister,
	Goods.QuantityForRegistrationByProductBatchID,
	Goods.RevenueAmountToRegister,
	Goods.QuantityConsumedForIncoiceRegistration,
	Goods.QuantityIsWrittenOffForRegistrationByProductBatchID,
	Goods.BusinessOperation,
	Goods.CommissionAmount,
	Goods.DocumentSalesOfGoodsAndServices,
	Goods.TaxInvoiceDate,
	Goods.Customer,
	Goods.CorInventoryOwnerAttribute,
	Goods.Products AS NomenclatureSequence,
	Goods.Characteristic AS CharacteristicSequence,
	Goods.PointInTime,
	Goods.TaxInvoiceNumber,
	Goods.DocumentSales
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor AS Goods</queryText>
