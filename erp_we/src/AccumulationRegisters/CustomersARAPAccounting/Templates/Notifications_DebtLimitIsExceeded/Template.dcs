		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CounterpartyContracts.Ref AS NotificationContext,
	CounterpartyContracts.Manager AS NotificationRecipient,
	CounterpartyContracts.Organization AS Organization,
	CounterpartyContracts.AllowableAmountPayable AS AllowableAmountPayable,
	-(CounterpartyContracts.AllowableAmountPayable - CustomersARAPAccounting.SumBalance - CustomersARAPAccounting.BeingShippedBalance) AS ExcessAmount,
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,
	CustomersARAPAccounting.Currency AS Currency
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance(, ARAPObject.ARAPObjectType = VALUE(Enum.ARAPObjectTypes.Contract)) AS CustomersARAPAccounting
		INNER JOIN Catalog.ARAPObjects AS ARAPObjects
		ON CustomersARAPAccounting.ARAPObject = ARAPObjects.Ref
		INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON (CounterpartyContracts.Ref = ARAPObjects.Object)
WHERE
	CounterpartyContracts.LimitDebtAmount
	AND CounterpartyContracts.AllowableAmountPayable - CustomersARAPAccounting.SumBalance - CustomersARAPAccounting.BeingShippedBalance &lt; 0</query>
