    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomersARAPAccounting.Period,
	CustomersARAPAccounting.Recorder,
	CustomersARAPAccounting.LineNumber,
	CustomersARAPAccounting.Active,
	CustomersARAPAccounting.RecordType,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	CustomersARAPAccounting.ARAPObject,
	CustomersARAPAccounting.Currency,
	CustomersARAPAccounting.Sum,
	CustomersARAPAccounting.AmountDue,
	CustomersARAPAccounting.BeingPaid,
	CustomersARAPAccounting.ToShip,
	CustomersARAPAccounting.BeingShipped,
	CustomersARAPAccounting.BusinessOperation,
	CustomersARAPAccounting.BusinessTransactionSetting,
	CustomersARAPAccounting.PaymentMethod,
	CustomersARAPAccounting.ProformaInvoice,
	CustomersARAPAccounting.SaleByOrder,
	CustomersARAPAccounting.ExcludeDuringControl,
	CustomersARAPAccounting.RecorderDate,
	CustomersARAPAccounting.PaymentDate,
	CustomersARAPAccounting.SumCompl,
	CustomersARAPAccounting.PointInTime,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract,
	RegisterAccountingAnalyticsForPartners.LineOfBusiness,
	CustomersARAPAccounting.AllowableAmountPayable,
	CustomersARAPAccounting.SumMan,
	CustomersARAPAccounting.DepositForPackage,
	CustomersARAPAccounting.OperationProcedure,
	CustomersARAPAccounting.SettlementProcedureByPaymentDate,
	CustomersARAPAccounting.PaymentOption,
	CustomersARAPAccounting.ReversingEntry,
	CustomersARAPAccounting.SettlementTransaction,
	CustomersARAPAccounting.CorARAPObject,
	CustomersARAPAccounting.CorPartnerAccountingDimension,
	CustomersARAPAccounting.CalculationObjectReceiver,
	CustomersARAPAccounting.DestinationAccountingDimensionByPartners,
	CustomersARAPAccounting.AmountReceiver,
	CustomersARAPAccounting.ByDataOfSourceARAPObject,
	CustomersARAPAccounting.FinRecordID,
	CustomersARAPAccounting.RateARAPCurrencyNumerator,
	CustomersARAPAccounting.RateARAPCurrencyDenominator,
	CustomersARAPAccounting.ExchangeRateNumeratorOfManSCurrency,
	CustomersARAPAccounting.ExchangeRateDenominatorCurrencyMan
FROM
	AccumulationRegister.CustomersARAPAccounting AS CustomersARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey</queryText>
      <mainTable>AccumulationRegister.CustomersARAPAccounting</mainTable>
