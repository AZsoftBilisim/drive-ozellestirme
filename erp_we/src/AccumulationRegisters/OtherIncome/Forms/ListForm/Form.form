    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	AccumulationRegisterOtherIncome.Period AS Period,
	AccumulationRegisterOtherIncome.Recorder AS Recorder,
	AccumulationRegisterOtherIncome.LineNumber AS LineNumber,
	AccumulationRegisterOtherIncome.Active AS Active,
	AccumulationRegisterOtherIncome.Organization AS Organization,
	AccumulationRegisterOtherIncome.Department AS Department,
	AccumulationRegisterOtherIncome.LineOfBusiness AS LineOfBusiness,
	AccumulationRegisterOtherIncome.IncomeItem AS IncomeItem,
	AccumulationRegisterOtherIncome.DimensionOfRevenue AS DimensionOfRevenue,
	AccumulationRegisterOtherIncome.Sum AS Sum,
	AccumulationRegisterOtherIncome.SumCompl AS SumCompl,
	AccumulationRegisterOtherIncome.PermanentDifference AS PermanentDifference,
	AccumulationRegisterOtherIncome.CostTD AS CostTD,
	AccumulationRegisterOtherIncome.SumMan AS SumMan,
	AccumulationRegisterOtherIncome.SumCompl - AccumulationRegisterOtherIncome.PermanentDifference - AccumulationRegisterOtherIncome.CostTD AS AmountFA,
	AccumulationRegisterOtherIncome.BusinessOperation AS BusinessOperation,
	AccumulationRegisterOtherIncome.CalculationOfCost AS CalculationOfCost,
	AccumulationRegisterOtherIncome.LotCalculation AS LotCalculation,
	AccumulationRegisterOtherIncome.CorLineOfBusiness AS CorLineOfBusiness,
	AccumulationRegisterOtherIncome.BusinessTransactionSetting AS BusinessTransactionSetting,
	AccumulationRegisterOtherIncome.FinRecordID AS FinRecordID,
	AccumulationRegisterOtherIncome.RowID AS RowID,
	AccumulationRegisterOtherIncome.ReversingEntry AS ReversingEntry,
	AccumulationRegisterOtherIncome.DocumentCalculation AS DocumentCalculation,
	AccumulationRegisterOtherIncome.MonthEndClosingMode AS MonthEndClosingMode,
	AccumulationRegisterOtherIncome.SourceKind AS SourceKind,
	AccumulationRegisterOtherIncome.AdjustmentPeriod_ AS AdjustmentPeriod_,
	AccumulationRegisterOtherIncome.PointInTime AS PointInTime
FROM
	AccumulationRegister.OtherIncome AS AccumulationRegisterOtherIncome</queryText>
      <mainTable>AccumulationRegister.OtherIncome</mainTable>
