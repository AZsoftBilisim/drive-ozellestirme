							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>// The version is not yet known; called on every update</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>// نسخه هنوز مشخص نیست؛ در هر به‌روزرسانی فراخوانی می‌شود</v8:content>
							</v8:item>
