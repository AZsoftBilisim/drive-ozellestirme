									<v8:lang>it</v8:lang>
									<v8:content>//   Aggiornamento non operativo - selezioniamo tutto</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>pl</v8:lang>
									<v8:content>// Nie szybka aktualizacja - wybieramy wszystko</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>// Не оперативное обновление - выбираем все</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>tr</v8:lang>
									<v8:content>// Hızlı olmayan güncelleme - hepsini seç</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>vi</v8:lang>
									<v8:content>// Cập nhật không hiện thời - chọn tất cả </v8:content>
								</v8:item>
							</dcsset:presentation>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:FilterItemGroup">
							<dcsset:groupType>OrGroup</dcsset:groupType>
							<dcsset:item xsi:type="dcsset:FilterItemComparison">
								<dcsset:left xsi:type="dcscor:Field">ExecutionMode</dcsset:left>
								<dcsset:comparisonType>Equal</dcsset:comparisonType>
								<dcsset:right xsi:type="xs:string">Exclusively</dcsset:right>
								<dcsset:presentation xsi:type="v8:LocalStringType">
									<v8:item>
										<v8:lang>en</v8:lang>
										<v8:content>// When checking real-time update, include only items that require exclusive mode</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>fa</v8:lang>
										<v8:content>// هنگام بررسی به‌روزرسانی بلادرنگ، فقط اقلامی که به حالت انحصاری نیاز دارند گنجانده شوند</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>it</v8:lang>
										<v8:content>//   Alla verifica dell'operativo  -  solo per richiedenti modalità esclusiva</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>pl</v8:lang>
										<v8:content>// Podczas weryfikacji szybkiej - tylko wymagające trybu wyłączności</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>ru</v8:lang>
										<v8:content>// При проверке оперативного - только требующие монопольного режима</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>tr</v8:lang>
										<v8:content>// Hızlı güncelleme kontrolü esnasında - sadece özel modunu gerektiren</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>vi</v8:lang>
										<v8:content>// Khi kiểm tra hiện thời - chỉ cần chế độ độc quyền</v8:content>
									</v8:item>
								</dcsset:presentation>
							</dcsset:item>
							<dcsset:item xsi:type="dcsset:FilterItemGroup">
								<dcsset:groupType>AndGroup</dcsset:groupType>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">ExclusiveMode</dcsset:left>
									<dcsset:comparisonType>NotEqual</dcsset:comparisonType>
									<dcsset:right xsi:type="dcscor:Field">DataParameters.False</dcsset:right>
									<dcsset:presentation xsi:type="v8:LocalStringType">
										<v8:item>
											<v8:lang>en</v8:lang>
											<v8:content>// When checking real-time update, include only items that require exclusive mode</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>fa</v8:lang>
											<v8:content>// هنگام بررسی به‌روزرسانی بلادرنگ، فقط اقلامی که به حالت انحصاری نیاز دارند گنجانده شوند</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>it</v8:lang>
											<v8:content>//   Alla verifica dell'operativo  -  solo per richiedenti modalità esclusiva</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>pl</v8:lang>
											<v8:content>// Podczas weryfikacji szybkiej - tylko wymagające trybu wyłączności</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>ru</v8:lang>
											<v8:content>// При проверке оперативного - только требующие монопольного режима</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>tr</v8:lang>
											<v8:content>// Hızlı güncelleme kontrolü esnasında - sadece özel modunu gerektiren</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>vi</v8:lang>
											<v8:content>// Khi kiểm tra hiện thời - chỉ cần chế độ độc quyền</v8:content>
										</v8:item>
									</dcsset:presentation>
								</dcsset:item>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">ExecutionMode</dcsset:left>
									<dcsset:comparisonType>NotFilled</dcsset:comparisonType>
									<dcsset:presentation xsi:type="v8:LocalStringType">
										<v8:item>
											<v8:lang>en</v8:lang>
											<v8:content>// When checking real-time update, include only items that require exclusive mode</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>fa</v8:lang>
											<v8:content>// هنگام بررسی به‌روزرسانی بلادرنگ، فقط اقلامی که به حالت انحصاری نیاز دارند گنجانده شوند</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>it</v8:lang>
											<v8:content>//   Alla verifica dell'operativo  -  solo per richiedenti modalità esclusiva</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>pl</v8:lang>
											<v8:content>// Podczas weryfikacji szybkiej - tylko wymagające trybu wyłączności</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>ru</v8:lang>
											<v8:content>// При проверке оперативного - только требующие монопольного режима</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>tr</v8:lang>
											<v8:content>// Hızlı güncelleme kontrolü esnasında - sadece özel modunu gerektiren</v8:content>
										</v8:item>
										<v8:item>
											<v8:lang>vi</v8:lang>
											<v8:content>// Khi kiểm tra hiện thời - chỉ cần chế độ độc quyền</v8:content>
										</v8:item>
									</dcsset:presentation>
								</dcsset:item>
								<dcsset:presentation xsi:type="v8:LocalStringType">
									<v8:item>
										<v8:lang>en</v8:lang>
										<v8:content>// For backward compatibility</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>fa</v8:lang>
										<v8:content>// برای سازگاری با نسخه‌های قبلی</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>it</v8:lang>
										<v8:content>//  solo per retrocompatibilità</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>pl</v8:lang>
										<v8:content>// Dla kompatybilności wstecznej</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>ru</v8:lang>
										<v8:content>// Для обратной совместимости</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>tr</v8:lang>
										<v8:content>// Geriye dönük uyumluluk için</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>vi</v8:lang>
										<v8:content>// Dành cho tương thích ngược</v8:content>
									</v8:item>
								</dcsset:presentation>
							</dcsset:item>
						</dcsset:item>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:FilterItemGroup">
						<dcsset:groupType>AndGroup</dcsset:groupType>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">DataParameters.DeferredUpdate</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">ExecutionMode</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:string">Deferred</dcsset:right>
						</dcsset:item>
						<dcsset:presentation xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>// Select deferred handlers only</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>// انتخاب فقط رویدادگردان‌های معوق</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>//  Selezione solamento dei processori differiti</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>// Wybór tylko odłożónych procedur przetwarzania</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>// Выбор только отложенных обработчиков</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>// Sadece ertelenmiş işlemcilerin seçimi</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>// Chỉ chọn các hàm hoãn lại</v8:content>
							</v8:item>
						</dcsset:presentation>
					</dcsset:item>
					<dcsset:presentation xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>// Check real-time update</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>// بررسی به‌روزرسانی بلادرنگ</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>//  Verifica dell'aggiornamento operativo</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>// Weryfikacja szybkiej aktualizacji</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>// Проверка оперативного обновления</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>// Hızlı güncelleme kontrolü</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>// Kiểm tra cập nhật hiện thời</v8:content>
						</v8:item>
					</dcsset:presentation>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemGroup">
					<dcsset:groupType>OrGroup</dcsset:groupType>
					<dcsset:item xsi:type="dcsset:FilterItemGroup">
						<dcsset:groupType>AndGroup</dcsset:groupType>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">DataParameters.FirstExchangeInDIB</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:FilterItemGroup">
							<dcsset:groupType>OrGroup</dcsset:groupType>
							<dcsset:item xsi:type="dcsset:FilterItemComparison">
								<dcsset:left xsi:type="dcscor:Field">ExecuteInMasterNodeOnly</dcsset:left>
								<dcsset:comparisonType>Equal</dcsset:comparisonType>
								<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
							</dcsset:item>
							<dcsset:item xsi:type="dcsset:FilterItemComparison">
								<dcsset:left xsi:type="dcscor:Field">DataParameters.IsDIBWithFilter</dcsset:left>
								<dcsset:comparisonType>Equal</dcsset:comparisonType>
								<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
							</dcsset:item>
						</dcsset:item>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:FilterItemGroup">
						<dcsset:groupType>AndGroup</dcsset:groupType>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">DataParameters.FirstExchangeInDIB</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
						</dcsset:item>
					</dcsset:item>
					<dcsset:presentation xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>// The first exchange in a DIB</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>// اولین تبادل در DIB</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>// Primo scambio in RIF</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>// Pierwsza wymiana w RBI</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>// Первый обмен в РИБ</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>// Dağıtılmış infobase'te ilk değişim</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>// Trao đổi lần đầu trong cơ sở thông tin phân tán</v8:content>
						</v8:item>
					</dcsset:presentation>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>VersionGroup</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
				<dcsset:item xsi:type="dcsset:StructureItemGroup">
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Priority</dcsset:field>
							<dcsset:orderType>Desc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>VersionWeight</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>SerialNumber</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
					</dcsset:order>
					<dcsset:selection>
						<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
					</dcsset:selection>
				</dcsset:item>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>