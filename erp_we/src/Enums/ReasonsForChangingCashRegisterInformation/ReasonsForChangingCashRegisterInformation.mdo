  <enumValues uuid="633f985d-14ff-4252-9b8c-62327b197684">
    <name>DisablingARAPAccountingInInternetMode</name>
    <synonym>
      <key>en</key>
      <value>Take cash register from online settlements</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>خارج کردن صندوق فروش از تسویه‌های آنلاین</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Trasferimento del KKT nella modalità pagamento su Internet</value>
    </synonym>
