  <enumValues uuid="09e56293-a055-4f60-807d-0f9e2f7c2de6">
    <name>ChangeListOfTaxationSystemsUsedInCasesOfPayments</name>
    <synonym>
      <key>en</key>
      <value>Change the list of taxation systems used in the cases of payments</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تغییر فهرست نظام‌های مالیاتی مورد استفاده در پرداخت‌ها</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Modifica dei sistemi di tassazione applicate per i pagamenti</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Zmiany w wykazie systemów opodatkowania, wykorzystywanych przy realizacji obliczeń</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Изменение перечня систем налогообложения, применяемых при осуществлении расчетов</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Vergilendirme sistemi listelerinin değişimi, uzlaşmaların uygulanmalarında kullanılır</value>
