	<columns>
		<size>1</size>
		<columnsItem>
			<index>0</index>
			<column>
				<formatIndex>1</formatIndex>
			</column>
		</columnsItem>
	</columns>
	<rowsItem>
		<index>0</index>
		<row>
			<c>
				<c>
					<f>0</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Function "VARIANCE" returns a difference between the first argument and the sum of the following arguments: A [1] - (A [2] + ... + A [n])</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>تابع «VARIANCE» تفاضل آرگومان اول و مجموع آرگومان‌های بعدی را برمی‌گرداند: A [1] - (A [2] + ... + A [n])</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>La funzione "DEVIAZIONE" - restituisce la differenza tra il primo argomento e la somma degli argomenti successivi: A[1] - (A[2] + ... + A[n])</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Funkcja "ODCHYLENIE" - zwraca różnicę między pierwszym argumentem a sumą następujących argumentów: A[1] - (A[2]+ ... + A[n])</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Функция "ОТКЛОНЕНИЕ" - возвращает разницу между первым аргументом и суммой последующих аргументов: A[1] - (A[2] + ... + A[n])</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>"FARK" fonksiyonu, ilk değişken ve sonraki değişkenlerin toplamı arasındaki farka dönülebilmesini sağlar: A[1] - (A[2] + ... + A[n])</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Hàm "ОТКЛОНЕНИЕ" - trả về sự khác biệt giữa đối số đầu tiên và tổng của các đối số sau: A [1] - (A [2] + ... + A [n])</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
		<index>1</index>
		<row>
			<c>
				<c>
					<f>0</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Function "VARIANCEPERCENTAGE" returns amount variance percentage of the following sum from the first column: (A[2] + ... + A[n] - A[1]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>تابع «VARIANCEPERCENTAGE» درصد انحراف مبلغ مجموع بعدی از ستون اول را برمی‌گرداند: (A[2] + ... + A[n] - A[1]) / A[1] * 100 درصد</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>La funzione "PERCENTUALEDEVIAZIONE" - restituisce la deviazione percentuale della somma dei successivi dalla prima colonna: (A[2] + ... + A[n] - A[1]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Funkcja "PROCENT ODCHYLENIA" - zwraca procent odchylenia sumy kolejnej od pierwszej kolumny:  (A[2] + ... + A[n] - A[1]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Функция "ПРОЦЕНТОТКЛОНЕНИЯ" - возвращает процент отклонения суммы последующих от первой колонки: (A[2] + ... + A[n] - A[1]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>"YÜZDEFARK" fonksiyonu, ilk sütundan yüzde tutar farkına dönülebilmesini sağlar: (A[2] + ... + A[n] - A[1]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Hàm "ПРОЦЕНТОТКЛОНЕНИЯ" - trả về độ lệch phần trăm của tổng số sau từ cột đầu tiên: (A [2] + ... + A [n] - A [1]) / A [1] * 100%</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
		<index>2</index>
		<row>
			<c>
				<c>
					<f>0</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Function "EXECUTIONPERCENTAGE" returns a progress percentage of the following amount from the first column: (A[2] + ... + A[n]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>تابع «EXECUTIONPERCENTAGE» درصد پیشرفت مبلغ بعدی از ستون اول را برمی‌گرداند: (A[2] + ... + A[n]) / A[1] * 100 درصد</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>La funzione "PERCENTUALECOMPIMENTO" - restituisce la percentuale di compimento della somma dei successivi dalla prima colonna: (A[2] + ... + A[n]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Funkcja "PROCENT ODCHYLENIA" - zwraca procent wykonania sumy następującej po pierwszej kolumnie: (A[2] + ... + A[n]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Функция "ПРОЦЕНТВЫПОЛНЕНИЯ" - возвращает процент выполнения суммы последующих от первой колонки: (A[2] + ... + A[n]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>"UYGULANMAORANI" fonksiyonu, ilk sütundan yüzde tutar uygulanma işlemine dönülebilmesini sağlar: (A[2] + ... + A[n]) / A[1] * 100%</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Hàm "ПРОЦЕНТВЫПОЛНЕНИЯ" - trả về tỷ lệ phần trăm hoàn thành tổng của các mục sau từ cột đầu tiên: (A [2] + ... + A [n]) / A [1] * 100%</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<templateMode>true</templateMode>
