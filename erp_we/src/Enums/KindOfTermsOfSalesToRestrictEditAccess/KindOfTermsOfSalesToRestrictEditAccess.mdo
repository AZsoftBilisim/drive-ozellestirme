  <name>KindOfTermsOfSalesToRestrictEditAccess</name>
  <synonym>
    <key>en</key>
    <value>Kind of terms of sales (to restrict edit access)</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>نوع شرایط فروش (برای محدود کردن دسترسی ویرایش)</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Tipo di accordo con clienti (per limitare accesso alle modifiche)</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Rodzaj umowy z klentami (w celu ograniczenia uprawnień edycji)</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Вид соглашения с клиентами (для ограничение доступа на изменение)</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Satış koşulları türü (değişiklik erişiminin kısıtlanması için)</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Dạng thỏa thuận với khách hàng (để hạn chế truy cập thay đổi)</value>
  </synonym>
