  <enumValues uuid="3397ef23-61b6-4d41-9c81-5d406f66703f">
    <name>PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices</name>
    <synonym>
      <key>en</key>
      <value>Assigned for the kit and allocated to components proportionally to their cost</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تعیین‌شده برای کیت و تسهیم‌شده به اجزا به نسبت بهای آن‌ها</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Si imposta per set e viene ripartito per componenti in proporzione al loro costo</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Mianowany za zestaw i rozprowadzane wg komponentów proporcjonalnie do ich ceny</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Назначается за набор и распределяется по комплектующим пропорционально их цене</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Küme için atanır ve setler arasında fiyatlarına orantılı olarak dağıtılır</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Được chỉ định cho một bộ và phân bổ giữa các thành phần tỷ lệ với giá của chúng</value>
    </synonym>
  </enumValues>
  <enumValues uuid="299a1f71-e30b-4908-8487-03a62b1c6d26">
    <name>PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares</name>
    <synonym>
      <key>en</key>
      <value>Assigned for the kit and allocated to components proportionally to the cost shares</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تعیین‌شده برای کیت و تسهیم‌شده به اجزا به نسبت سهم‌های بها</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Si imposta per set e viene ripartito per componenti in proporzione alle quote di costo</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Mianowany za zestaw i rozprowadzane wg komponentów proporcjonalnie do udziałów kosztów</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Назначается за набор и распределяется по комплектующим пропорционально долям стоимости</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Küme için atanır ve setler arasında maliyet paylarıyla orantılı olarak dağıtılır</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Được chỉ định cho một bộ và phân bổ giữa các thành phần theo tỷ lệ chi phí cổ phần</value>
    </synonym>
  </enumValues>
</mdclass:Enum>
