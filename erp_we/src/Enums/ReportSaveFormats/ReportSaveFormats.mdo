  <name>ReportSaveFormats</name>
  <synonym>
    <key>en</key>
    <value>Report file formats</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>قالب‌های فایل گزارش</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Formati di salvataggio dei report</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Formaty zapisu raportów</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Форматы сохранения отчетов</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Rapor kaydetme formatları</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Định dạng lưu báo cáo</value>
  </synonym>
  <standardAttributes>
    <dataHistory>Use</dataHistory>
    <name>Order</name>
    <fillValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <minValue xsi:type="core:UndefinedValue"/>
