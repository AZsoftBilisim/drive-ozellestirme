      </handlers>
      <extendedTooltip>
        <name>SelectValueChangeQualityExtendedTooltip</name>
        <id>24</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
