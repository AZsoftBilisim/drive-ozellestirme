  <enumValues uuid="9b5167ec-c2a4-4c7b-a506-8cc1759a9692">
    <name>RecordSurplusAndLeaveInShippingArea</name>
    <synonym>
      <key>en</key>
      <value>(not used) Record surplus and leave in the outbound area</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>(استفاده‌نشده) ثبت مازاد و باقی گذاشتن در ناحیه خروجی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>(non utilizzato)Rilevare l'avanzo e lasciare nella zona di spedizione</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>(nie używa się) Odzwierciedlić nadwyżkę i pozostawić w obszarze wysyłki</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>(не используется)  Отразить излишек и оставить в зоне отгрузки</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>(kullanılmayan) Fazlalığı yansıt ve yükleme alanında bırak</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>(không sử dụng) Phản ánh hàng thừa và để lại khu vực giao hàng</value>
    </synonym>
  </enumValues>
