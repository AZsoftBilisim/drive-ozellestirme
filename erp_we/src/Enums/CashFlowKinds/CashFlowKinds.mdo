  <enumValues uuid="606d6e74-40d8-4f18-bd92-9d82661381ae">
    <name>RentPaymentsRoyaltiesLicensedPaymentsFeedbacksCommission</name>
    <synonym>
      <key>en</key>
      <value>Rental payments, royalty, license fees, fees, commission fees and other similar payments</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>پرداخت‌های اجاره، حق امتیاز، حق لیسانس، کارمزدها، حق‌العمل‌ها و سایر پرداخت‌های مشابه</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Canoni di locazioni, royalty, canoni di licenza,  onorari, commissioni, e altri pagamenti analoghi</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Płatności za wynajem, opłaty licencyjne, należności licencyjne, wynagrodzenia, wynagrodzenia prowizyjne oraz inne podobne płatności</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Арендные платежи, роялти, лицензионные платежи, гонорары, комиссионные и иные аналогичные платежи</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Kira ödemeleri, telif hakları, lisans ödemeleri, ücretler, komisyon vb. ödemeler</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Tiền thuê, tiền bản quyền, chi phí bản quyền, tiền hoa hồng và các khoản thanh toán tương tự khác</value>
    </synonym>
  </enumValues>
