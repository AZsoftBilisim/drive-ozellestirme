		<dataSource>DataSource1</dataSource>
		<query>SELECT
	EventQueueForNotificationsToCustomers.NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	QueueData.NotificationSource AS NotificationSource,
	QueueData.Subscriber AS Subscriber,
	ContactPersonsForPartners.Description AS LastFirstName,
	ContactPersonsForPartners.JobTitleOnBusinessCard,
	ContactPersonsForPartners.Gender,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN "SalutationMale"
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN "SalutationFemale"
		ELSE "SalutationGenderUnknown"
	END AS SupportRequest
FROM
	QueueData AS QueueData
		INNER JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON (ContactPersonsForPartners.Ref = QueueData.NotificationSource)</query>
	</dataSet>
