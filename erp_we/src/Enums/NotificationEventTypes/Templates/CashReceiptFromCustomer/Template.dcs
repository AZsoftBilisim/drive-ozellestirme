		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	EventQueueForNotificationsToCustomers.NotificationSource AS NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	QueueData.NotificationSource AS NotificationSource,
	QueueData.Subscriber AS Subscriber,
	CashAccountReceiptNoteARAPDetails.Partner AS Partner,
	CashAccountReceiptNoteARAPDetails.Ref.Organization AS Organization,
	CashAccountReceiptNoteARAPDetails.Ref.Counterparty AS Counterparty,
	CashAccountReceiptNoteARAPDetails.Sum AS Sum,
	CashAccountReceiptNoteARAPDetails.Ref.Currency AS Currency
INTO ReceiptOfPayment
FROM
	Document.CashAccountReceiptNote.ARAPDetails AS CashAccountReceiptNoteARAPDetails
		INNER JOIN QueueData AS QueueData
		ON (QueueData.NotificationSource = CashAccountReceiptNoteARAPDetails.Ref)
			AND (QueueData.Subscriber = CashAccountReceiptNoteARAPDetails.Partner)
			AND (CashAccountReceiptNoteARAPDetails.Ref.Posted)

UNION ALL

SELECT
	QueueData.NotificationSource,
	QueueData.Subscriber,
	BankAccountReceiptNoteARAPDetails.Partner,
	BankAccountReceiptNoteARAPDetails.Ref.Organization,
	BankAccountReceiptNoteARAPDetails.Ref.Counterparty,
	BankAccountReceiptNoteARAPDetails.Sum,
	BankAccountReceiptNoteARAPDetails.Ref.Currency
FROM
	Document.BankAccountReceiptNote.ARAPDetails AS BankAccountReceiptNoteARAPDetails
		INNER JOIN QueueData AS QueueData
		ON (QueueData.NotificationSource = BankAccountReceiptNoteARAPDetails.Ref)
			AND (QueueData.Subscriber = BankAccountReceiptNoteARAPDetails.Partner)
			AND (BankAccountReceiptNoteARAPDetails.Ref.Posted)

UNION ALL

SELECT
	QueueData.NotificationSource,
	QueueData.Subscriber,
	PaymentCardTransactionARAPDetails.Partner,
	PaymentCardTransactionARAPDetails.Ref.Organization,
	PaymentCardTransactionARAPDetails.Ref.Counterparty,
	PaymentCardTransactionARAPDetails.Sum,
	PaymentCardTransactionARAPDetails.Ref.Currency
FROM
	Document.PaymentCardTransaction.ARAPDetails AS PaymentCardTransactionARAPDetails
		INNER JOIN QueueData AS QueueData
		ON (QueueData.NotificationSource = PaymentCardTransactionARAPDetails.Ref)
			AND (QueueData.Subscriber = PaymentCardTransactionARAPDetails.Partner)
			AND (PaymentCardTransactionARAPDetails.Ref.Posted)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ReceiptOfPayment.NotificationSource AS NotificationSource,
	ReceiptOfPayment.Subscriber AS Subscriber,
	ReceiptOfPayment.Partner AS Partner,
	ReceiptOfPayment.Organization AS Organization,
	ReceiptOfPayment.Counterparty AS Counterparty,
	ReceiptOfPayment.Currency AS Currency,
	SUM(ReceiptOfPayment.Sum) AS Sum,
	SUM(ISNULL(CustomersARAPAccountingBalance.SumBalance, 0)) AS RemainingDebt
FROM
	ReceiptOfPayment AS ReceiptOfPayment
		{LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(
				,
				AccountingDimensionByPartners.Partner IN
					(SELECT
						QueueData.Subscriber
					FROM
						QueueData AS QueueData)) AS CustomersARAPAccountingBalance
		ON ReceiptOfPayment.Currency = CustomersARAPAccountingBalance.Currency
			AND ReceiptOfPayment.Partner = CustomersARAPAccountingBalance.AccountingDimensionByPartners.Partner}

GROUP BY
	ReceiptOfPayment.NotificationSource,
	ReceiptOfPayment.Subscriber,
	ReceiptOfPayment.Partner,
	ReceiptOfPayment.Organization,
	ReceiptOfPayment.Counterparty,
	ReceiptOfPayment.Currency</query>
	</dataSet>
