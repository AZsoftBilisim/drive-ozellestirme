			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ReferenceOrder</dataPath>
			<field>ReferenceOrder</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Factor</dataPath>
			<field>Factor</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(EventQueueForNotificationsToCustomers.NotificationSource AS Document.SalesOrder) AS NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber,
	EventQueueForNotificationsToCustomers.Period
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
	AND EventQueueForNotificationsToCustomers.EmailSendingRelevanceDate &gt; &amp;ProcessingDate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RegisterTable.ReferenceOrder AS ReferenceOrder,
	RegisterTable.RowCode AS RowCode,
	ISNULL(SUM(CASE
		WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
			THEN RegisterTable.CountTurnover
		ELSE 0
	END), 0) AS ForRegistrationQuantityTurnover,
	ISNULL(SUM(CASE
		WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
			THEN RegisterTable.CountTurnover
		ELSE 0
	END), 0) AS IssuedQuantityTurnover
INTO TT_ShipmentOrdersTurnoverExpanded
FROM AccumulationRegister.ShipmentAndReturnReferences.Turnovers(,,, ReferenceOrder IN
		(SELECT
				Table.NotificationSource AS SalesOrder
			FROM QueueData AS Table)
		AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister),
		VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1))) AS RegisterTable
GROUP BY
	RegisterTable.ReferenceOrder,
	RegisterTable.RowCode
HAVING
	ISNULL(SUM(CASE
		WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
			THEN RegisterTable.CountTurnover
		ELSE 0
	END), 0) &lt;&gt; 0
	OR ISNULL(SUM(CASE
		WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
			THEN RegisterTable.CountTurnover
		ELSE 0
	END), 0) &lt;&gt; 0
	
INDEX BY
	ReferenceOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	QueueData.NotificationSource,
	QueueData.Subscriber,
	RequirementsForRegistration__.Period
INTO ShippedOrders
FROM
	QueueData AS QueueData
		INNER JOIN TT_ShipmentOrdersTurnoverExpanded AS Filter
		ON QueueData.NotificationSource = Filter.ReferenceOrder
		INNER JOIN AccumulationRegister.ShipmentAndReturnReferences AS RequirementsForRegistration__
		ON Filter.ReferenceOrder = RequirementsForRegistration__.ReferenceOrder
		 AND Filter.RowCode    = RequirementsForRegistration__.RowCode
		 AND Filter.ForRegistrationQuantityTurnover - Filter.IssuedQuantityTurnover &gt; 0
		 AND RequirementsForRegistration__.Count &gt; 0
		 AND RequirementsForRegistration__.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
		 AND RequirementsForRegistration__.Active
		 AND RequirementsForRegistration__.Period = DATEADD(BEGINOFPERIOD(QueueData.Period, DAY), DAY, 1)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ShippedOrders.NotificationSource,
	ShippedOrders.Subscriber,
	ShippedOrders.Period AS DateOfShipment,
	ShippedOrders.NotificationSource.Number AS OrderNumber,
	ShippedOrders.NotificationSource.Date AS OrderDate,
	ShippedOrders.NotificationSource.Partner AS Partner,
	ShippedOrders.NotificationSource.Counterparty AS Counterparty,
	ShippedOrders.NotificationSource.Organization AS Organization,
	ShippedOrders.NotificationSource.Terms AS Terms,
	ShippedOrders.NotificationSource.Currency AS Currency,
	ShippedOrders.NotificationSource.DocumentAmount AS DocumentAmount,
	ShippedOrders.NotificationSource.Warehouse AS Warehouse,
	ShippedOrders.NotificationSource.DeliveryAddress AS DeliveryAddress,
	ShippedOrders.NotificationSource.NumberAccordingToCustomerData AS NumberAccordingToCustomerData,
	ShippedOrders.NotificationSource.DateAccordingToInformationFromCustomer AS DateAccordingToInformationFromCustomer,
	ShippedOrders.NotificationSource.Shipper AS Shipper,
	ShippedOrders.NotificationSource.GoodsRecipient AS GoodsRecipient,
	ShippedOrders.NotificationSource.Contract AS Contract,
	ShippedOrders.NotificationSource.CarrierPartner AS Carrier,
	ShippedOrders.NotificationSource.DeliveryTimeFrom AS DeliveryTimeFrom,
	ShippedOrders.NotificationSource.DeliveryTimeTo AS DeliveryTimeTo,
	ShippedOrders.NotificationSource.DeliveryAddressOfCarrier AS DeliveryAddressOfCarrier,
	ShippedOrders.NotificationSource.AdditionalDeliveryInformation AS AdditionalDeliveryInformation,
	ShippedOrders.NotificationSource.ContactPerson AS ContactPerson,
	ShippedOrders.Subscriber.DescriptionFull AS PartnerPublicName
FROM
	ShippedOrders AS ShippedOrders</query>
	</dataSet>
