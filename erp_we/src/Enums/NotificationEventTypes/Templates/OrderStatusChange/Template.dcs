		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	CAST(EventQueueForNotificationsToCustomers.NotificationSource AS Document.SalesOrder) AS NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	QueueData.NotificationSource,
	QueueData.Subscriber,
	ISNULL(SalesOrderStates.State, VALUE(Enum.SalesOrderStates.Closed)) AS State,
	SalesOrderStates.PayAmount,
	SalesOrderStates.PayPercentage,
	SalesOrderStates.AmountByShipment,
	SalesOrderStates.OrderShipmentPercentage,
	SalesOrder.Number,
	SalesOrder.Date,
	SalesOrder.Partner,
	SalesOrder.Counterparty,
	SalesOrder.Organization,
	SalesOrder.Terms,
	SalesOrder.Currency,
	SalesOrder.DocumentAmount,
	SalesOrder.Warehouse,
	SalesOrder.PriceIncludesVAT,
	SalesOrder.Manager,
	SalesOrder.AdditionalInformation,
	SalesOrder.BankAccount,
	SalesOrder.CounterpartyBankAccount,
	SalesOrder.AmountPrepaymentBeforeGoodsIssue,
	SalesOrder.AmountOfPrepaymentBeforeShipment,
	SalesOrder.DeliveryAddress,
	SalesOrder.NumberAccordingToCustomerData,
	SalesOrder.DateAccordingToInformationFromCustomer,
	SalesOrder.Shipper,
	SalesOrder.GoodsRecipient,
	SalesOrder.ShipperBankAccount,
	SalesOrder.GoodsRecipientBankAccount,
	SalesOrder.LoyaltyCard,
	SalesOrder.Contract,
	SalesOrder.Department,
	SalesOrder.DeliveryMethod,
	SalesOrder.CarrierPartner,
	SalesOrder.DeliveryAddressOfCarrier,
	SalesOrder.AdditionalDeliveryInformation,
	SalesOrder.ContactPerson
FROM
	QueueData AS QueueData
		INNER JOIN Document.SalesOrder AS SalesOrder
		ON QueueData.NotificationSource = SalesOrder.Ref
			AND QueueData.Subscriber = SalesOrder.Partner
			AND (SalesOrder.Posted)
		LEFT JOIN InformationRegister.SalesOrderStates AS SalesOrderStates
		ON QueueData.NotificationSource = SalesOrderStates.OrderDocument
</query>
	</dataSet>
