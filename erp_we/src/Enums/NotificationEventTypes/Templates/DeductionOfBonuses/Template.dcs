		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	EventQueueForNotificationsToCustomers.NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BonusPoints.Recorder,
	BonusPoints.Partner,
	SUM(BonusPoints.Accrued) AS NumberOfPoints,
	MIN(BonusPoints.Period) AS ValidityStartDate
INTO DebitedPoints
FROM
	AccumulationRegister.BonusPoints AS BonusPoints
		INNER JOIN QueueData AS QueueData
		ON BonusPoints.Recorder = QueueData.NotificationSource
			AND BonusPoints.Partner = QueueData.Subscriber
WHERE
	BonusPoints.Active
	AND BonusPoints.RecordType = VALUE(AccumulationRecordType.Expense)

GROUP BY
	BonusPoints.Recorder,
	BonusPoints.Partner

HAVING
	SUM(BonusPoints.Accrued) &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	QueueData.NotificationSource AS NotificationSource,
	QueueData.Subscriber AS Subscriber,
	DebitedPoints.NumberOfPoints AS RedeemedBonuses,
	DebitedPoints.ValidityStartDate AS ValidityStartDate,
	CASE
		WHEN DebitedPoints.Recorder REFS Document.CashRegisterReceipt
			THEN "Strokelinecap"
		WHEN DebitedPoints.Recorder REFS Document.CashRegisterReceiptReturn
				OR DebitedPoints.Recorder REFS Document.ReturnOfGoodsFromCustomer
			THEN "Stromovascular"
		WHEN DebitedPoints.Recorder REFS Document.RetailSalesReport
			THEN "Strokelinecap"
		WHEN DebitedPoints.Recorder REFS Document.AccrueAndDeductionOfBonusPoints
			THEN CASE
					WHEN DebitedPoints.Recorder.AccrualRule = VALUE(Document.AccrueAndDeductionOfBonusPoints.EmptyRef)
						THEN DebitedPoints.Recorder.AccrualRule
					ELSE "LineOther"
				END
		ELSE "LineOther"
	END AS OperationKind,
	CASE
		WHEN ISNULL(BonusPointsBalance.AccruedBalance, 0) - CASE WHEN ISNULL(BonusPointsBalance.ToWriteOffBalance, 0) &gt; 0 THEN ISNULL(BonusPointsBalance.ToWriteOffBalance, 0) ELSE 0 END &gt;= 0
			THEN ISNULL(BonusPointsBalance.AccruedBalance, 0) - CASE WHEN ISNULL(BonusPointsBalance.ToWriteOffBalance, 0) &gt; 0 THEN ISNULL(BonusPointsBalance.ToWriteOffBalance, 0) ELSE 0 END
		ELSE 0
	END AS PointsAvailableOnTheNotificationDate,
	QueueData.Subscriber.DescriptionFull AS PartnerPublicName
FROM
	DebitedPoints AS DebitedPoints
		INNER JOIN QueueData AS QueueData
			{LEFT JOIN AccumulationRegister.BonusPoints.Balance(
					&amp;CurrentDate,
					Partner IN
						(SELECT
							QueueData.Subscriber
						FROM
							QueueData AS QueueData)) AS BonusPointsBalance
			ON QueueData.Subscriber = BonusPointsBalance.Partner}
		ON DebitedPoints.Recorder = QueueData.NotificationSource
			AND DebitedPoints.Partner = QueueData.Subscriber</query>
	</dataSet>
	<parameter>
