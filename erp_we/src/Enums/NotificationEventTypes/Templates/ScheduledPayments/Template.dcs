		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.CustomerNotificationKinds</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
