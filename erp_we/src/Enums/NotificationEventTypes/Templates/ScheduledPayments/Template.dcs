			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Valuta della contabilità gestionale</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Waluta ewidencji zarządczej</v8:content>
			</v8:item>
