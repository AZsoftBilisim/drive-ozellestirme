		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	EventQueueForNotificationsToCustomers.NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
;


////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator AS CourseNumerator,
	CurrencyExchangeRate.CourseDenominator AS CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;CurrentDate)}, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CalculationData.Partner AS Partner,
	CalculationData.LocalAccountingCurrency AS LocalAccountingCurrency,
	SUM(CalculationData.LatePaymentsRegulatedAccounting) AS LatePaymentsRegulatedAccounting,
	SUM(CalculationData.OverduePaymentsManagementAccounting) AS OverduePaymentsManagementAccounting
INTO OverdueScheduledPayments
FROM (SELECT
		CustomersARAPAccountingBalance.AccountingDimensionByPartners.Partner AS Partner,
		CustomersARAPAccountingBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
		CustomersARAPAccountingBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesRegulatedAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesRegulatedAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS LatePaymentsRegulatedAccounting,
		CustomersARAPAccountingBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesManagementAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesManagementAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS OverduePaymentsManagementAccounting
	FROM AccumulationRegister.CustomersARAPAccounting.Balance(
			DATEADD(&amp;CurrentDate, DAY, 1),
			NOT &amp;NewOnlineARAPAccounting
			AND AccountingDimensionByPartners.Partner IN
				(SELECT
					QueueData.NotificationSource
				FROM
					QueueData AS QueueData)) AS CustomersARAPAccountingBalance
				{LEFT JOIN ExchangeRates AS ExchangeRates
				ON CustomersARAPAccountingBalance.Currency = ExchangeRates.Currency
				LEFT JOIN ExchangeRates AS ExchangeRatesManagementAccounting
				ON ExchangeRatesManagementAccounting.Currency = &amp;ManagementAccountingCurrency
				LEFT JOIN ExchangeRates AS ExchangeRatesRegulatedAccounting
				ON CustomersARAPAccountingBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency = ExchangeRatesRegulatedAccounting.Currency}
	
	UNION ALL
	
	SELECT
		CustomersARAPAccountingByDueDatesBalance.AccountingDimensionByPartners.Partner AS Partner,
		CustomersARAPAccountingByDueDatesBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
		CustomersARAPAccountingByDueDatesBalance.DebtLocalBalance AS LatePaymentsRegulatedAccounting,
		CustomersARAPAccountingByDueDatesBalance.ARAPManBalance AS OverduePaymentsManagementAccounting
	FROM AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(
			,
			PlannedRepaymentDate &lt; BEGINOFPERIOD(DATEADD(&amp;CurrentDate, DAY, 1), DAY)
			AND &amp;NewOnlineARAPAccounting
			AND AccountingDimensionByPartners.Partner IN
				(SELECT
					QueueData.NotificationSource
				FROM
					QueueData AS QueueData)) AS CustomersARAPAccountingByDueDatesBalance
	
	UNION ALL
	
	SELECT
		CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Partner AS Partner,
		CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
		CustomersARAPAccountingCashFlowPlanBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesRegulatedAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesRegulatedAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS LatePaymentsRegulatedAccounting,
		CustomersARAPAccountingCashFlowPlanBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesManagementAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesManagementAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS OverduePaymentsManagementAccounting
	FROM AccumulationRegister.CustomersARAPAccountingCashFlowPlan.Balance(
			,
			PlannedRepaymentDate &lt; BEGINOFPERIOD(DATEADD(&amp;CurrentDate, DAY, 1), DAY)
			AND &amp;NewOnlineARAPAccounting
			AND AccountingDimensionByPartners.Partner IN
				(SELECT
					QueueData.NotificationSource
				FROM
					QueueData AS QueueData)) AS CustomersARAPAccountingCashFlowPlanBalance
				{LEFT JOIN ExchangeRates AS ExchangeRates
				ON CustomersARAPAccountingCashFlowPlanBalance.Currency = ExchangeRates.Currency
				LEFT JOIN ExchangeRates AS ExchangeRatesManagementAccounting
				ON ExchangeRatesManagementAccounting.Currency = &amp;ManagementAccountingCurrency
				LEFT JOIN ExchangeRates AS ExchangeRatesRegulatedAccounting
				ON CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency = ExchangeRatesRegulatedAccounting.Currency}
	) AS CalculationData
GROUP BY
	CalculationData.Partner,
	CalculationData.LocalAccountingCurrency

HAVING
	SUM(CalculationData.LatePaymentsRegulatedAccounting) &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CalculationData.Partner AS Partner,
	CalculationData.LocalAccountingCurrency AS LocalAccountingCurrency,
	SUM(CalculationData.ScheduledPaymentsLocalAccounting) AS ScheduledPaymentsLocalAccounting,
	SUM(CalculationData.ScheduledPaymentsManagementAccounting) AS ScheduledPaymentsManagementAccounting
INTO ScheduledPayments
FROM (SELECT
		CustomersARAPAccountingBalance.AccountingDimensionByPartners.Partner AS Partner,
		CustomersARAPAccountingBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
		CustomersARAPAccountingBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesRegulatedAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesRegulatedAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS ScheduledPaymentsLocalAccounting,
		CustomersARAPAccountingBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesManagementAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesManagementAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS ScheduledPaymentsManagementAccounting
	FROM AccumulationRegister.CustomersARAPAccounting.Balance(
			DATEADD(&amp;CurrentDate, DAY, 2),
			NOT &amp;NewOnlineARAPAccounting
			AND AccountingDimensionByPartners.Partner IN
				(SELECT
					QueueData.NotificationSource
				FROM
					QueueData AS QueueData)) AS CustomersARAPAccountingBalance
				{LEFT JOIN ExchangeRates AS ExchangeRates
				ON CustomersARAPAccountingBalance.Currency = ExchangeRates.Currency
				LEFT JOIN ExchangeRates AS ExchangeRatesManagementAccounting
				ON ExchangeRatesManagementAccounting.Currency = &amp;ManagementAccountingCurrency
				LEFT JOIN ExchangeRates AS ExchangeRatesRegulatedAccounting
				ON CustomersARAPAccountingBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency = ExchangeRatesRegulatedAccounting.Currency}
	
	UNION ALL
	
	SELECT
		CustomersARAPAccountingByDueDatesBalance.AccountingDimensionByPartners.Partner AS Partner,
		CustomersARAPAccountingByDueDatesBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
		CustomersARAPAccountingByDueDatesBalance.DebtLocalBalance AS ScheduledPaymentsLocalAccounting,
		CustomersARAPAccountingByDueDatesBalance.ARAPManBalance AS ScheduledPaymentsManagementAccounting
	FROM AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(
			,
			PlannedRepaymentDate &lt; BEGINOFPERIOD(DATEADD(&amp;CurrentDate, DAY, 2), DAY)
			AND &amp;NewOnlineARAPAccounting
			AND AccountingDimensionByPartners.Partner IN
				(SELECT
					QueueData.NotificationSource
				FROM
					QueueData AS QueueData)) AS CustomersARAPAccountingByDueDatesBalance
	
	UNION ALL
	
	SELECT
		CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Partner AS Partner,
		CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
		CustomersARAPAccountingCashFlowPlanBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesRegulatedAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesRegulatedAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS ScheduledPaymentsLocalAccounting,
		CustomersARAPAccountingCashFlowPlanBalance.AmountDueBalance * ISNULL(ExchangeRates.CourseNumerator, 1) * ISNULL(ExchangeRatesManagementAccounting.CourseDenominator, 1) / (ISNULL(ExchangeRatesManagementAccounting.CourseNumerator, 1) * ISNULL(ExchangeRates.CourseDenominator, 1)) AS ScheduledPaymentsManagementAccounting
	FROM AccumulationRegister.CustomersARAPAccountingCashFlowPlan.Balance(
			,
			PlannedRepaymentDate &lt; BEGINOFPERIOD(DATEADD(&amp;CurrentDate, DAY, 2), DAY)
			AND &amp;NewOnlineARAPAccounting
			AND AccountingDimensionByPartners.Partner IN
				(SELECT
					QueueData.NotificationSource
				FROM
					QueueData AS QueueData)) AS CustomersARAPAccountingCashFlowPlanBalance
				{LEFT JOIN ExchangeRates AS ExchangeRates
				ON CustomersARAPAccountingCashFlowPlanBalance.Currency = ExchangeRates.Currency
				LEFT JOIN ExchangeRates AS ExchangeRatesManagementAccounting
				ON ExchangeRatesManagementAccounting.Currency = &amp;ManagementAccountingCurrency
				LEFT JOIN ExchangeRates AS ExchangeRatesRegulatedAccounting
				ON CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency = ExchangeRatesRegulatedAccounting.Currency}
	) AS CalculationData
GROUP BY
	CalculationData.Partner,
	CalculationData.LocalAccountingCurrency

HAVING
	SUM(CalculationData.ScheduledPaymentsLocalAccounting) &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	QueueData.NotificationSource,
	QueueData.Subscriber,
	CASE
		WHEN ScheduledPayments.LocalAccountingCurrency IS NULL
		AND OverdueScheduledPayments.LocalAccountingCurrency IS NULL
			THEN &amp;BaseCurrency
		ELSE ISNULL(ScheduledPayments.LocalAccountingCurrency,
			OverdueScheduledPayments.LocalAccountingCurrency)
	END AS LocalAccountingCurrency,
	&amp;ManagementAccountingCurrency AS CurrencyOfManagerialAccounting,
	ISNULL(ScheduledPayments.ScheduledPaymentsLocalAccounting, 0) AS PlannedPaymentsInTheComplianceAccountingCurrency,
	ISNULL(ScheduledPayments.ScheduledPaymentsManagementAccounting, 0) AS PlannedPaymentsInTheManagementAccountingCurrency,
	ISNULL(OverdueScheduledPayments.LatePaymentsRegulatedAccounting, 0) AS OverduePaymentsInTheComplianceAccountingCurrency,
	ISNULL(OverdueScheduledPayments.OverduePaymentsManagementAccounting, 0) AS OverduePaymentsInManagementAccountingCurrency,
	Partners.DescriptionFull AS PublicName,
	Partners.MainManager,
	Partners.BusinessRegion,
	BEGINOFPERIOD(DATEADD(&amp;CurrentDate, DAY, 1), DAY) AS PaymentDate
FROM
	QueueData AS QueueData
		INNER JOIN Catalog.Partners AS Partners
		ON QueueData.NotificationSource = Partners.Ref
		{LEFT JOIN ScheduledPayments AS ScheduledPayments
		ON QueueData.NotificationSource = ScheduledPayments.Partner
		LEFT JOIN OverdueScheduledPayments AS OverdueScheduledPayments
		ON QueueData.NotificationSource = OverdueScheduledPayments.Partner}
WHERE
	(ISNULL(ScheduledPayments.ScheduledPaymentsLocalAccounting, 0) &gt; 0
			OR ISNULL(ScheduledPayments.ScheduledPaymentsManagementAccounting, 0) &gt; 0)</query>
	</dataSet>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
