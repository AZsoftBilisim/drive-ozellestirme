		<dataSource>DataSource1</dataSource>
		<query>SELECT
	EventQueueForNotificationsToCustomers.NotificationSource,
	EventQueueForNotificationsToCustomers.Subscriber
INTO QueueData
FROM
	InformationRegister.EventQueueForNotificationsToCustomers AS EventQueueForNotificationsToCustomers
WHERE
	EventQueueForNotificationsToCustomers.NotificationKind = &amp;NotificationKind
	AND EventQueueForNotificationsToCustomers.Period &lt; &amp;ProcessingDate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	QueueData.NotificationSource,
	QueueData.Subscriber,
	CustomerCommercialInvoice.Number,
	CustomerCommercialInvoice.Date,
	CustomerCommercialInvoice.Organization,
	CustomerCommercialInvoice.DocumentAmount,
	CustomerCommercialInvoice.Currency,
	CustomerCommercialInvoice.DocumentBasis,
	CustomerCommercialInvoice.PaymentMethod,
	CustomerCommercialInvoice.BankAccount,
	CustomerCommercialInvoice.CashAccount,
	CASE
		WHEN CustomerCommercialInvoice.PartialPayment
			THEN "Strategetically"
		ELSE "StroyPolyBeton"
	END AS PartialPaymentOrFullPayment,
	CustomerCommercialInvoice.Partner,
	CustomerCommercialInvoice.PaymentPurposes,
	CustomerCommercialInvoice.Manager,
	CustomerCommercialInvoice.Counterparty,
	CustomerCommercialInvoice.Contract,
	CustomerCommercialInvoice.Partner.DescriptionFull AS PartnerPublicName,
	CustomerCommercialInvoice.ContactPerson.Description AS ContactPersonSFullName_
FROM
	QueueData AS QueueData
		INNER JOIN Document.CustomerCommercialInvoice AS CustomerCommercialInvoice
		ON QueueData.NotificationSource = CustomerCommercialInvoice.Ref
			AND (QueueData.Subscriber = CustomerCommercialInvoice.Partner
				AND CustomerCommercialInvoice.Posted
				AND NOT CustomerCommercialInvoice.Canceled_)</query>
	</dataSet>
