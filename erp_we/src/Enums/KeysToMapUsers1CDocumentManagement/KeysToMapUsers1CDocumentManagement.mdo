  <name>KeysToMapUsers1CDocumentManagement</name>
  <synonym>
    <key>en</key>
    <value>Keys to map users when authorizing in 1C:Document Management</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>کلیدهای نگاشت کاربران هنگام احراز هویت در 1C:Document Management</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Ключи для сопоставления пользователей при авторизации в 1С:Документооборот</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>1C:Document Management'te kimlik doğrulama sırasında kullanıcıları eşleştirme anahtarları</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Khóa để so sánh người sử dụng khi đăng nhập vào 1C:Document Management</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Keys to map users when authorizing in 1C:Document Management</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Keys to map users when authorizing in 1C:Document Management</value>
  </synonym>
