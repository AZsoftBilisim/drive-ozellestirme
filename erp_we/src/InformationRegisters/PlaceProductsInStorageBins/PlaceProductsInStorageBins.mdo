    <synonym>
      <key>it</key>
      <value>Cella principale</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Główna komórka</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Основная ячейка</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ana hücre</value>
