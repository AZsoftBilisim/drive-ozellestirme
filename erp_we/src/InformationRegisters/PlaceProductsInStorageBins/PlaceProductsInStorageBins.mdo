  <resources uuid="da8721e8-5411-482c-ace4-053ffbf58e63">
    <name>MainStorageBin</name>
    <synonym>
      <key>en</key>
      <value>Main storage bin</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>محل نگهداری اصلی</value>
