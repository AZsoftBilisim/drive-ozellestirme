  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRecords.NumberOfStatePicture - 1 AS PictureNumber,
	InformationRecords.User AS User,
	InformationRecords.UserMustChangePasswordOnAuthorization AS UserMustChangePasswordOnAuthorization,
	InformationRecords.UnlimitedValidityPeriod AS UnlimitedValidityPeriod,
	InformationRecords.ValidityPeriod AS ValidityPeriod,
	InformationRecords.InactivityPeriodBeforeDenyingAuthorization AS InactivityPeriodBeforeDenyingAuthorization,
	InformationRecords.AuthorizationAllowedDate AS AuthorizationAllowedDate,
	InformationRecords.LastActivityDate AS LastActivityDate,
	InformationRecords.AutomaticAuthorizationProhibitionDate AS AutomaticAuthorizationProhibitionDate,
	InformationRecords.DeletePasswordUsageStartDate AS DeletePasswordUsageStartDate,
	InformationRecords.LastUsedClient AS LastUsedClient,
	InformationRecords.NumberOfStatePicture AS NumberOfStatePicture,
	InformationRecords.CanSignIn AS CanSignIn,
	InformationRecords.IsAppLogonRestricted AS IsAppLogonRestricted,
	InformationRecords.HasNoRights AS HasNoRights,
	InformationRecords.HasInsufficientRightForLogon AS HasInsufficientRightForLogon,
	InformationRecords.Name AS Name,
	InformationRecords.Email AS Email,
	InformationRecords.StandardAuthentication AS StandardAuthentication,
	InformationRecords.CannotChangePassword AS CannotChangePassword,
	InformationRecords.CannotRecoveryPassword AS CannotRecoveryPassword,
	InformationRecords.ShowInList AS ShowInList,
	InformationRecords.OpenIDAuthentication AS OpenIDAuthentication,
	InformationRecords.OpenIDConnectAuthentication AS OpenIDConnectAuthentication,
	InformationRecords.AccessTokenAuthentication AS AccessTokenAuthentication,
	InformationRecords.OSAuthentication AS OSAuthentication,
	InformationRecords.OSUser AS OSUser,
	InformationRecords.Language AS Language,
	InformationRecords.UnsafeActionProtection AS UnsafeActionProtection
FROM
	InformationRegister.UsersInfo AS InformationRecords</queryText>
      <mainTable>InformationRegister.UsersInfo</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <formCommands>
    <name>EnableEditing</name>
    <title>
      <key>en</key>
      <value>Allow editing</value>
    </title>
    <title>
      <key>fa</key>
      <value>اجازه ویرایش</value>
    </title>
    <title>
      <key>it</key>
      <value>Abilitare possibilità di modifica</value>
    </title>
    <title>
      <key>pl</key>
      <value>Włącz możliwość edycji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Включить возможность редактирования</value>
    </title>
    <title>
      <key>tr</key>
      <value>Düzenlemeye izin ver</value>
    </title>
    <title>
      <key>vi</key>
      <value>Bật tính năng chỉnh sửa</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Allow editing for troubleshooting. Recommended for advanced users only.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>اجازه ویرایش برای عیب‌یابی. فقط برای کاربران پیشرفته توصیه می‌شود.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Abilitare possibilità di modifica solo allo scopo di ricerca dei malfunzionamenti (è necessaria la conoscenza approfondita del funzionamento del meccanismo)</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Włącz możliwość edycji tylko dla celów wyszukiwania niesprawności (wymagane jest pogłębione zrozumienie mechanizmu pracy)</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Включить возможность редактирования только для целей поиска неисправности (требуется углубленное понимание работы механизма)</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Hata giderme için düzenlemeye izin ver. Bu özellik sadece ileri seviye kullanıcılara yöneliktir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Bật tính năng chỉnh sửa chỉ nhằm tìm kiếm sự sai sót (cần hiểu sâu cách làm việc của cơ chế)</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>EnableEditing</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
  </formCommands>
