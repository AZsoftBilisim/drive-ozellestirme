  <resources uuid="ed98a7b2-ad31-401f-a65e-dfbcc8e5a4a8">
    <name>UserMustChangePasswordOnAuthorization</name>
    <synonym>
      <key>en</key>
      <value>Demand password change on next login</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>درخواست تغییر رمز عبور در ورود بعدی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Chiedere cambio della password all'accesso</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wymagaj zmiany hasła po zalogowaniu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Потребовать смену пароля при входе</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Oturum açma sırasında şifre değişikliği talep et</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Yêu cầu thay đổi mật khẩu khi đăng nhập</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Ask the user to change the password when they try to log in.

You can toggle this option in the user card.
When the user changes the password, this setting is cleared.
</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>هنگام تلاش کاربر برای ورود، از او خواسته شود رمز عبور را تغییر دهد.

می‌توانید این گزینه را در کارت کاربر تغییر دهید.
هنگامی که کاربر رمز عبور را تغییر دهد، این تنظیم پاک می‌شود.
</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Chiedere all'utente
di cambiare la password all'accesso.

 Viene impostato nella scheda utente. 
 Viene ripristinato dopo il cambio della password all'accesso.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Wymagaj od użytkownika 
 zmiany hasła przy zalogowaniu. 

 Jest ustawiane w karcie użytkownika. 
 Jest resetowane przy zmianie hasła przy zalogowaniu.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Потребовать от пользователя
сменить пароль при входе.

Устанавливается в карточке пользователя.
Сбрасывается при смене пароля при входе.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Kullanıcı giriş yaptığında
şifresini değiştirmelidir.

Bu seçeneği kullanıcı profilinde değiştirebilirsiniz.
Kullanıcı şifresini değiştirdiğinde bu ayar sıfırlanır.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Yêu cầu người sử dụng
thay đổi mật khẩu khi đăng nhập.

Đặt trong thẻ người sử dụng.
Xóa khi thay đổi mật khẩu khi đăng nhập.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
  <resources uuid="9a5e3d2c-ab69-4f9d-a56f-20bb5f0be1e2">
    <name>UnlimitedValidityPeriod</name>
    <synonym>
      <key>en</key>
      <value>Access never expires</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>دسترسی هرگز منقضی نمی‌شود</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Validità non è limitata</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Czas trwania nie jest ograniczony</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Срок действия не ограничен</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Geçerlilik dönemi sınırsız</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Thời hạn hiệu lực không hạn chế</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Overrides all restrictions based on expiration dates.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>همه محدودیت‌های مبتنی بر تاریخ انقضا را لغو می‌کند.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Annulla tutte le limitazioni di validità.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Anuluje wszystkie ograniczenia dotyczące terminu ważności.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Отменяет все ограничения по срокам действия.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Parola geçerlilik süresi dolmaz.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Hủy bỏ tất cả hạn chế theo thời hạn hiệu lực.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
