        <field>Period</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>IncomeTaxPayer</dataPath>
        <field>IncomeTaxPayer</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PTSIsApplied</dataPath>
        <field>PTSIsApplied</field>
      </fields>
