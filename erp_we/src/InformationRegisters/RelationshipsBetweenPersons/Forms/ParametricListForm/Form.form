    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE
		WHEN RelationshipsBetweenPersons.Person1 = &amp;Person
			THEN RelationshipsBetweenPersons.Person2
		ELSE RelationshipsBetweenPersons.Person1
	END AS Person,
	CASE
		WHEN RelationshipsBetweenPersons.Person1 = &amp;Person
			THEN RelationshipsBetweenPersons.RelationshipType.Description
		ELSE RelationshipsBetweenPersons.RelationshipType.ReverseName
	END AS RepresentationOfTheTypeOfCommunication,
	RelationshipsBetweenPersons.Author,
	RelationshipsBetweenPersons.Comment,
	RelationshipsBetweenPersons.Person1,
	RelationshipsBetweenPersons.Person2,
	RelationshipsBetweenPersons.RelationshipType AS RelationshipType
FROM
	InformationRegister.RelationshipsBetweenPersons AS RelationshipsBetweenPersons
WHERE
	(RelationshipsBetweenPersons.Person1 = &amp;Person
			OR RelationshipsBetweenPersons.Person2 = &amp;Person)</queryText>
      <mainTable>InformationRegister.RelationshipsBetweenPersons</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
