    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterInteroperationTransferParameters.Department,
	InformationRegisterInteroperationTransferParameters.WorkCenterTypeSource,
	InformationRegisterInteroperationTransferParameters.WorkCenterTypeDestination,
	InformationRegisterInteroperationTransferParameters.TransferTime,
	InformationRegisterInteroperationTransferParameters.TransferTimeUnitOfMeasure,
	CASE
		WHEN InformationRegisterInteroperationTransferParameters.WorkCenterTypeSource &lt;> VALUE(Catalog.WorkCenterTypes.EmptyRef)
				AND InformationRegisterInteroperationTransferParameters.WorkCenterTypeDestination &lt;> VALUE(Catalog.WorkCenterTypes.EmptyRef)
			THEN 1
		WHEN InformationRegisterInteroperationTransferParameters.WorkCenterTypeDestination &lt;> VALUE(Catalog.WorkCenterTypes.EmptyRef)
			THEN 2
		WHEN InformationRegisterInteroperationTransferParameters.WorkCenterTypeSource &lt;> VALUE(Catalog.WorkCenterTypes.EmptyRef)
			THEN 3
		ELSE 4
	END AS Priority
FROM
	InformationRegister.InteroperationTransferParameters AS InformationRegisterInteroperationTransferParameters</queryText>
      <mainTable>InformationRegister.InteroperationTransferParameters</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
