    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ItemsBarcodes.Barcode AS Barcode,
	ItemsBarcodes.Products AS Products,
	ItemsBarcodes.Characteristic AS Characteristic,
	ISNULL(ItemsBarcodes.Products.ProductKind.KeepAccountingByBatch, FALSE) AS SeriesAreUsed,
	ItemsBarcodes.Series AS Series,
	ISNULL(ItemsBarcodes.Products.UnitOfMeasure, UNDEFINED) AS UnitOfMeasure,
	ItemsBarcodes.Package AS Package
FROM
	InformationRegister.ItemsBarcodes AS ItemsBarcodes</queryText>
      <mainTable>InformationRegister.ItemsBarcodes</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
