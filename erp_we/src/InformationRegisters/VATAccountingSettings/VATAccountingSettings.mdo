  <resources uuid="6a9b7e20-decd-426e-85c1-afb13eb222b1">
    <name>RuleOfPrepaymentFilterToRegisterTaxInvoices</name>
    <synonym>
      <key>en</key>
      <value>Rule of advance payment filter to register tax invoices</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>قاعده فیلتر پیش‌پرداخت برای ثبت صورتحساب‌های مالیاتی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Regola di selezione di pagamenti anticipati per la registrazione delle fatture</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Zasady filtru zaliczek do rejestracji faktur</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Правило отбора авансов для регистрации счетов-фактур</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Vergi faturalarının kaydı için avans filtresi kuralı</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quy tắc lựa chọn trước để đăng ký hóa đơn</value>
    </synonym>
    <type>
      <types>EnumRef.ProcedureOfRegisteringTaxInvoicesForPrepayment</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Rule of advance payment filter received from customers for invoicing an advance payment.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>قاعده فیلتر پیش‌پرداخت دریافتی از مشتریان برای صدور فاکتور پیش‌پرداخت.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Regole di selezione degli anticipi dai clienti per la loro fatturazione.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Zasada filtru zaliczek otrzymanych od klientów, w celu wystawienia faktur VAT na zaliczkę.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Правило отбора авансов, полученных от клиентов, для выставления счетов-фактур на аванс.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Proforma fatura düzenlemek için müşterilerden alınan avans filtresi kuralı.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Quy tắc chọn các khoản tạm ứng nhận được từ khách hàng để lập hóa đơn tạm ứng.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
