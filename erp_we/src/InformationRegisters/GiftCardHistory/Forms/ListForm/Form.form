  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterGiftCardHistory.Period AS Period,
	InformationRegisterGiftCardHistory.Recorder AS Recorder,
	InformationRegisterGiftCardHistory.LineNumber AS LineNumber,
	InformationRegisterGiftCardHistory.Active AS Active,
	ISNULL(ActivatingGiftCertificates.Organization, VALUE(Catalog.Companies.EmptyRef)) AS Organization,
	InformationRegisterGiftCardHistory.GiftCertificate AS GiftCertificate,
	InformationRegisterGiftCardHistory.Status AS Status,
	ISNULL(GiftCertificatesBalanceAndTurnovers.SumClosingBalance, 0) AS Balance
FROM
	InformationRegister.GiftCardHistory AS InformationRegisterGiftCardHistory
		LEFT JOIN Catalog.GiftCertificateKinds AS GiftCertificateKinds
		ON (GiftCertificateKinds.Ref = InformationRegisterGiftCardHistory.GiftCertificate.Owner)
		LEFT JOIN InformationRegister.ActivatingGiftCertificates AS ActivatingGiftCertificates
		ON InformationRegisterGiftCardHistory.GiftCertificate = ActivatingGiftCertificates.GiftCertificate
		LEFT JOIN AccumulationRegister.GiftCertificates.BalanceAndTurnovers(, , Auto, , ) AS GiftCertificatesBalanceAndTurnovers
		ON InformationRegisterGiftCardHistory.GiftCertificate = GiftCertificatesBalanceAndTurnovers.GiftCertificate
			AND InformationRegisterGiftCardHistory.Period = GiftCertificatesBalanceAndTurnovers.SecondPeriod
			AND InformationRegisterGiftCardHistory.Recorder = GiftCertificatesBalanceAndTurnovers.Recorder</queryText>
      <mainTable>InformationRegister.GiftCardHistory</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
