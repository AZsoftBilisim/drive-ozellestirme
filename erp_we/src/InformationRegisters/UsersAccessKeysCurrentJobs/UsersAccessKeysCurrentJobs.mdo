  <resources uuid="cdc4312c-b1af-407c-bfc3-28db04915aa6">
    <name>Parameters</name>
    <synonym>
      <key>en</key>
      <value>Parameters</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>پارامترها</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Parametri</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Parametry</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Параметры</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Parametreler</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Tham số</value>
    </synonym>
    <type>
      <types>ValueStorage</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>The parameters of the job that starts or continues update.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>پارامترهای وظیفه‌ای که به‌روزرسانی را آغاز یا ادامه می‌دهد.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Parametri di task per l'inizio o il prolungamento dell'aggiornamento</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Ustawienia zadania, aby rozpocząć lub kontynuować aktualizację.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Параметры задания для начала или продолжения обновления.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Güncellemeyi başlatmak veya sürdürmek için görev seçenekleri.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Thông số nhiệm vụ để bắt đầu hoặc tiếp tục cập nhật.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
