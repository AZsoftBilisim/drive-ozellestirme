  <resources uuid="9bda4a0b-e8a7-4acf-9f07-4033b3a84ebc">
    <name>AllAllowed</name>
    <synonym>
      <key>en</key>
      <value>All allowed</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>همه مجاز</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Tutti consentiti</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wszystkie są dozwolone</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Все разрешены</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Hepsine izin verildi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cho phép tất cả</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>All unspecified values are allowed.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>همه مقادیر نامشخص مجاز هستند.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Tutti valori non riportati consentiti.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Wszystkie nie wskazane wartości są dozwolone.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Все не указанные значения разрешены.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Belirtilmeyen tüm değerlere izin verilir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Tất cả, không phải các giá trị đã chỉ ra được phép.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:BooleanValue"/>
    <indexing>Index</indexing>
  </resources>
  <attributes uuid="4ba2e55e-29bc-4fbe-83e8-8bfa36abfdab">
    <name>AllAllowedWithoutExceptions</name>
    <synonym>
      <key>en</key>
      <value>All allowed, no exceptions</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>همه مجاز، بدون استثنا</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Tutti consentiti senza eccezioni</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wszystkie dozwolone bez wyjątków</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Все разрешены без исключений</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>İstisnasız hepsine izin verildi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cho phép tất cả, không có ngoại lệ</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>No access values are specified in the access group.
By default, all access values are allowed.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>هیچ مقدار دسترسی در گروه دسترسی مشخص نشده است.
به‌طور پیش‌فرض، همه مقادیر دسترسی مجاز هستند.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Indica che non ci sono valori di accesso
 nel gruppo di accesso e per impostazione predefinita sono consentiti tutti.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Oznacza, że w grupie dostępu nie wskazano 
wartości dostępu, a domyślnie wszystkie są dozwolone.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Обозначает, что в группе доступа не указано
значений доступа, а по умолчанию все разрешены.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Erişim değerlerinin
 erişim grubunda belirtilmemiş olduğunu ve varsayılan olarak izin verildiğini belirtir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Có nghĩa là, trong nhóm truy cập chưa chỉ ra
giá trị truy cập, theo mặc định tất cả được phép.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <indexing>Index</indexing>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </attributes>
  <attributes uuid="93de88de-0069-4aa8-96b2-d5709e4def2f">
    <name>NoSettings</name>
    <synonym>
      <key>en</key>
      <value>No restrictions by access kind</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>بدون محدودیت بر اساس نوع دسترسی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Senza impostazione</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Bez ustawienia</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Без настройки</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ayarsız</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Không có tùy chỉnh</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>No access kind is specified in the profile or in the access group,
or the app does not apply restrictions by access kind.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>هیچ نوع دسترسی در پروفایل یا گروه دسترسی مشخص نشده است،
یا برنامه محدودیت بر اساس نوع دسترسی اعمال نمی‌کند.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Обозначает, что в профиле и группе доступа нет вида доступа или
ограничение по виду доступа не используется в приложении.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Profilde ve erişim grubunda 
erişim türü olmadığını veya programda erişim türü kısıtlamasının kullanılmadığını belirtir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Có nghĩa là, trong hồ sơ và nhóm truy cập không có dạng truy cập hoặc
không sử dụng hạn chế theo dạng truy cập trong ứng dụng.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>No access kind is specified in the profile or in the access group,
or the app does not apply restrictions by access kind.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>No access kind is specified in the profile or in the access group,
or the app does not apply restrictions by access kind.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <indexing>Index</indexing>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </attributes>
  <dimensions uuid="9f94fadf-ac9d-4e57-9fe4-41ce8cfbec6a">
    <name>AccessGroup</name>
    <synonym>
      <key>en</key>
      <value>Access group</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>گروه دسترسی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Gruppo d'accesso</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Grupa dostępu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Группа доступа</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Erişim grubu</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Nhóm truy cập</value>
    </synonym>
    <type>
      <types>CatalogRef.AccessGroups</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>An access group from the &quot;Access groups&quot; catalog
that contains access value records.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>یک گروه دسترسی از فهرست «گروه‌های دسترسی»
که رکوردهای مقدار دسترسی را در بر دارد.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Gruppo di accesso dalla directory del Gruppo di accesso,
 che contiene voci di valore di accesso.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Grupa dostępu z katalogu grupy dostępu, 
której należą wpisy o wartościach dostępu.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Группа доступа из справочника Группы доступа,
которой принадлежат записи о значениях доступа.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Erişim grupları kataloğundan erişim değeri 
kayıtlarının ait olduğu erişim grubu</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nhóm truy cập từ danh mục Nhóm truy cập
mà các bản ghi về giá trị truy cập trực thuộc.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fillChecking>ShowError</fillChecking>
    <denyIncompleteValues>true</denyIncompleteValues>
    <dataHistory>Use</dataHistory>
    <fillFromFillingValue>true</fillFromFillingValue>
    <fillValue xsi:type="core:ReferenceValue">
      <value>Catalog.AccessGroups.EmptyRef</value>
    </fillValue>
    <master>true</master>
    <mainFilter>true</mainFilter>
  </dimensions>
  <dimensions uuid="12d4ffc8-592e-42a7-b8c6-20bd58f6da90">
    <name>AccessValuesType</name>
    <synonym>
      <key>en</key>
      <value>Access value type</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>نوع مقدار دسترسی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Tipo di valori di accesso</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Typ wartości dostępu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Тип значений доступа</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Erişim değeri tipi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Kiểu giá trị truy cập</value>
    </synonym>
    <type>
      <types>DefinedType.AccessValue</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>An access value type (an empty reference of this type).
It is based on the access kind in the access group.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>یک نوع مقدار دسترسی (ارجاع خالی از این نوع).
بر اساس نوع دسترسی در گروه دسترسی است.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Tipo di valore di accesso (link vuoto),
che corrisponde al tipo di accesso nel gruppo di accesso.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Typ wartości dostępu (pusty odnośnik), 
 który odpowiada rodzajowi dostępu w grupie dostępu.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Тип значений доступа (пустая ссылка),
который соответствует виду доступа в группе доступа.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Erişim grubundaki erişim tipine 
uygun olan erişim değerleri tipleri (boş referans)</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Kiểu giá trị truy cập (tham chiếu trống)
mà tương ứng với dạng truy cập trong nhóm truy cập.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <dataHistory>Use</dataHistory>
    <fillFromFillingValue>true</fillFromFillingValue>
    <fillValue xsi:type="core:ReferenceValue"/>
    <master>true</master>
    <mainFilter>true</mainFilter>
  </dimensions>
