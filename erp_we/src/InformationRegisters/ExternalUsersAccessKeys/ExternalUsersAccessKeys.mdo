  <resources uuid="bcd727b5-4678-41e9-85d5-98d4157cdd77">
    <name>RightUpdate</name>
    <synonym>
      <key>en</key>
      <value>&quot;Update&quot; right</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حق «به‌روزرسانی»</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Diritto Modifica</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Prawo zmiana</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Право изменение</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Değişim yetkisi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quyền Thay đổi</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>To allow not only Read but also Update, select the check box.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برای اجازه نه‌تنها خواندن بلکه به‌روزرسانی، کادر را انتخاب کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se il segno è impostato, non è consentita solo la lettura, ma anche il cambiamento.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli cecha jest ustawiona, dozwolone jest nie tylko czytanie, ale także zmiana</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Если признак установлен, то разрешено не только чтение, но и изменение</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Onay kutusu seçilmişse sadece okumaya değil, düzenlemeye de izin verilir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nếu đã thiết lập dấu hiệu thì cho phép không chỉ đọc mà còn có thể thay đổi</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
  <resources uuid="38c6dd83-2a70-4c4a-9f29-3b2b54a15501">
    <name>AddRight</name>
    <synonym>
      <key>en</key>
      <value>&quot;Add&quot; right</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حق «افزودن»</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Diritto aggiungere</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Prawo dodawanie</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Право добавление</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ekleme yetkisi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quyền Thêm</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>To allow not only Read and Update but also Add, select the check box.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برای اجازه نه‌تنها خواندن و به‌روزرسانی بلکه افزودن، کادر را انتخاب کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se il segno è impostato, è consentita non solo la lettura e modifica, ma anche l'aggiunta</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli cecha jest ustawiona, dozwolone jest nie tylko czytanie i zmiana, ale także dodawanie</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Если признак установлен, то разрешено не только чтение и изменение, но и добавление</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Onay kutusu seçiliyse, sadece Okumaya ve Güncellemeye değil, Eklemeye de izin verilir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nếu đã thiết lập dấu hiệu thì cho phép không chỉ đọc và thay đổi mà còn có thể thêm</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
  <attributes uuid="f403fcb3-a4f8-479d-9fa1-85d458b9a4b5">
    <name>AreGroupSetRights</name>
    <synonym>
      <key>en</key>
      <value>The access rights apply to a group set</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حقوق دسترسی بر مجموعه گروه اعمال می‌شود</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Questi sono diritti di set del gruppo</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Są to prawa do zestawu grup</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Это права набора групп</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Bu gruplar kümesinin hakları</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Đây là quyền tập hợp nhóm</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>The access rights apply to an access group set
or an external user group set
 (not to an external user).</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>حقوق دسترسی بر مجموعه گروه دسترسی
یا مجموعه گروه کاربر خارجی اعمال می‌شود
 (نه بر کاربر خارجی).</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Questi sono diritti di set del gruppo di accesso o
gruppi di utenti esterni,
e non dell'utente esterno</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Są to prawa do wybierania grup dostępu lub
grup użytkowników zewnętrznych
, a nie użytkownika zewnętrznego</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Это права набора групп доступа или
групп внешних пользователей,
а не внешнего пользователя</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Bu erişim grupların kümesinin veya 
harici kullanıcı grupların hakları, 
harici kullanıcının hakları değil</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đây là quyền tập hợp nhóm truy cập hoặc
nhóm người sử dụng ngoài,
mà không phải người sử dụng ngoài</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <indexing>Index</indexing>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </attributes>
  <dimensions uuid="c56d3cfe-6ae1-4fe3-abdc-2d845049ddde">
    <name>ExternalUser</name>
    <synonym>
      <key>en</key>
      <value>External user</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>کاربر خارجی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Utente esterno</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Użytkownik zewnętrzny</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Внешний пользователь</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Harici kullanıcı</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Người dùng ngoài</value>
