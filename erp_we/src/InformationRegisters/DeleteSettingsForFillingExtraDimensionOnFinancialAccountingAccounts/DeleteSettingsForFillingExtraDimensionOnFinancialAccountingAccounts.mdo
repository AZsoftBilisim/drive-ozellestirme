  <name>DeleteSettingsForFillingExtraDimensionOnFinancialAccountingAccounts</name>
  <synonym>
    <key>en</key>
    <value>(not used) Settings of extra dimension population in financial accounting accounts</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>(استفاده نمی‌شود) تنظیمات تکمیل بُعد اضافی در حساب‌های حسابداری مالی</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>(не используется) Настройки заполнения субконто на счетах международного учета</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>(kullanılmayan) Uluslararsı muhasebe hesaplarında ekstra boyutun doldurulma ayarları</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>(không sử dụng) Tùy chỉnh điền khoản mục trên các tài khoản kế toán quốc tế</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>(not used) Settings of extra dimension population in financial accounting accounts</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>(not used) Settings of extra dimension population in financial accounting accounts</value>
  </synonym>
