    <value>Il calcolo del prezzo di costo (date di correzioni dei saldi)</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Kalkulacja wartości własnej (daty korekt pozostałości)</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Расчет себестоимости (даты корректировок остатков)</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Maliyet hesaplaması (bakiye düzeltmelerinin tarihleri)</value>
  </synonym>
  <synonym>
