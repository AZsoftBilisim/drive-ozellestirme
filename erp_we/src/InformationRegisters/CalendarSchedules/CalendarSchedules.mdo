  <resources uuid="71bc35e6-0fec-4e54-af2d-23d1357d1c3b">
    <name>DayAddedToSchedule</name>
    <synonym>
      <key>en</key>
      <value>Day included in schedule</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>روز در برنامه گنجانده شده است</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Il giorno è incluso nell'orario</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Dzień włączony do harmonogramu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>День включен в график</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Programa Dahil Olan Gün</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Ngày tính vào lịch biểu</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>True if the day is included in the schedule. Otherwise, false.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>اگر روز در برنامه گنجانده شده باشد True، در غیر این صورت False.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Vero se il giorno è incluso nel programma, altrimenti - falso </value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Prawda, jeżeli dzień jest włączony do harmonogramu, fałsz - w przeciwnym przypadku</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Истина, если день включается в график, ложь - в противном случае</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Tarih grafiğe dahil edildiğinde - True, aksi halde - false</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>True, nếu ngày nằm trong lịch biểu, false - trong trường hợp ngược lại</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:BooleanValue"/>
  </resources>
