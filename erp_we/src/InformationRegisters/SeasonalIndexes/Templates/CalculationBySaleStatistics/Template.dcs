		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CatProducts.ItemsGroup AS ItemsGroup,
	CASE
		WHEN RevenueAndCostOfSalesTurnover.Warehouse REFS Catalog.Warehouses
				AND NOT RevenueAndCostOfSalesTurnover.Warehouse.BusinessRegion.ItemsGroup = VALUE(Catalog.SeasonalGroupsOfBusinessRegions.EmptyRef)
			THEN RevenueAndCostOfSalesTurnover.Warehouse.BusinessRegion.ItemsGroup
		ELSE VALUE(Catalog.SeasonalGroupsOfBusinessRegions.OtherItems)
	END AS SeasonalGroupOfBusinessRegion,
	CASE
		WHEN &amp;CalculationOption = 1
			THEN SUM(RevenueAndCostOfSalesTurnover.RevenueAmountTurnover)
		ELSE SUM(RevenueAndCostOfSalesTurnover.CountTurnover)
	END AS Sales,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(&amp;BegOfYear, WEEK, WEEK(DATEADD(&amp;BegOfYear, DAY, DAYOFYEAR(RevenueAndCostOfSalesTurnover.DayPeriod) - 1)) - 1)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(&amp;BegOfYear, MONTH, MONTH(RevenueAndCostOfSalesTurnover.MonthPeriod) - 1)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(&amp;BegOfYear, QUARTER, QUARTER(RevenueAndCostOfSalesTurnover.QuarterPeriod) - 1)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(&amp;BegOfYear, YEAR, YEAR(RevenueAndCostOfSalesTurnover.YearPeriod) - 1)
		ELSE DATEADD(&amp;BegOfYear, DAY, DAYOFYEAR(RevenueAndCostOfSalesTurnover.DayPeriod) - 1)
	END AS Period,
	RevenueAndCostOfSalesTurnover.YearPeriod AS YearPeriod
INTO InitialSales
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(, , Auto, ) AS RevenueAndCostOfSalesTurnover
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS ProductAccountingAnalysts
		ON RevenueAndCostOfSalesTurnover.ItemsLocationAttributes = ProductAccountingAnalysts.Ref
		INNER JOIN Catalog.Products AS CatProducts
		ON ProductAccountingAnalysts.Products = CatProducts.Ref
			AND (CatProducts.ItemsGroup &lt;&gt; VALUE(Catalog.SeasonalGroups.EmptyRef))
{WHERE
	CatProducts.ItemsGroup.*,
	CatProducts.Ref.* AS Products}

GROUP BY
	CatProducts.ItemsGroup,
	CASE
		WHEN RevenueAndCostOfSalesTurnover.Warehouse REFS Catalog.Warehouses
				AND NOT RevenueAndCostOfSalesTurnover.Warehouse.BusinessRegion.ItemsGroup = VALUE(Catalog.SeasonalGroupsOfBusinessRegions.EmptyRef)
			THEN RevenueAndCostOfSalesTurnover.Warehouse.BusinessRegion.ItemsGroup
		ELSE VALUE(Catalog.SeasonalGroupsOfBusinessRegions.OtherItems)
	END,
	RevenueAndCostOfSalesTurnover.YearPeriod,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(&amp;BegOfYear, WEEK, WEEK(DATEADD(&amp;BegOfYear, DAY, DAYOFYEAR(RevenueAndCostOfSalesTurnover.DayPeriod) - 1)) - 1)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(&amp;BegOfYear, MONTH, MONTH(RevenueAndCostOfSalesTurnover.MonthPeriod) - 1)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(&amp;BegOfYear, QUARTER, QUARTER(RevenueAndCostOfSalesTurnover.QuarterPeriod) - 1)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(&amp;BegOfYear, YEAR, YEAR(RevenueAndCostOfSalesTurnover.YearPeriod) - 1)
		ELSE DATEADD(&amp;BegOfYear, DAY, DAYOFYEAR(RevenueAndCostOfSalesTurnover.DayPeriod) - 1)
	END

INDEX BY
	ItemsGroup,
	SeasonalGroupOfBusinessRegion,
	YearPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InitialSales.ItemsGroup AS ItemsGroup,
	InitialSales.SeasonalGroupOfBusinessRegion AS SeasonalGroupOfBusinessRegion,
	InitialSales.YearPeriod AS YearPeriod,
	SUM(InitialSales.Sales) / &amp;NumberOfPeriods AS Sales
INTO AverageSales
FROM
	InitialSales AS InitialSales

GROUP BY
	InitialSales.ItemsGroup,
	InitialSales.SeasonalGroupOfBusinessRegion,
	InitialSales.YearPeriod

INDEX BY
	ItemsGroup,
	SeasonalGroupOfBusinessRegion,
	YearPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InitialSales.ItemsGroup AS ItemsGroup,
	InitialSales.SeasonalGroupOfBusinessRegion AS SeasonalGroupOfBusinessRegion,
	SUM(CASE
			WHEN ISNULL(AverageSales.Sales, 0) = 0
				THEN 0
			ELSE InitialSales.Sales / AverageSales.Sales
		END) / &amp;NumberOfYears AS ZoomRatio,
	InitialSales.Period AS Period
FROM
	InitialSales AS InitialSales
		INNER JOIN AverageSales AS AverageSales
		ON InitialSales.ItemsGroup = AverageSales.ItemsGroup
			AND InitialSales.YearPeriod = AverageSales.YearPeriod

GROUP BY
	InitialSales.ItemsGroup,
	InitialSales.SeasonalGroupOfBusinessRegion,
	InitialSales.Period

ORDER BY
	ItemsGroup,
	SeasonalGroupOfBusinessRegion,
	Period</query>
	</dataSet>
