      <key>pl</key>
      <value>Maksymalny czas trwania produkcji (w dniach)</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Максимальная длительность производства (в днях)</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Maksimum üretim süresi (gün olarak)</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Thời gian sản xuất tối đa (tính theo ngày)</value>
