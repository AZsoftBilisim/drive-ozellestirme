      <key>fa</key>
      <value>L=en; BF='استهلاک بهای کاهش‌ارزش‌یافته و محاسبه تعدیل کاهش ارزش'; BT='استهلاک بهای کامل و برگشت تعدیل کاهش ارزش'</value>
    </format>
