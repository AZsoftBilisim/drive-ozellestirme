    </format>
    <format>
      <key>vi</key>
      <value>L=vi; BF='Tính khấu hao giá trị bị giảm và thêm điều chỉnh giảm giá'; BT='Tính khấu hao toàn bộ giá trị và đảo ngược điều chỉnh giảm giá'</value>
