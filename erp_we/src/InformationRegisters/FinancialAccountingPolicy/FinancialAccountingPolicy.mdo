      <key>pl</key>
      <value>L=pl; BF='Amortyzuj utraconą wartość i dolicz korektę utraty wartości'; BT='Amortyzuj pełną wartość i stornuj korektę utraty wartości'</value>
    </format>
    <format>
      <key>ru</key>
      <value>L=ru; BF='Амортизировать обесцененную стоимость и доначислять корректировку обесценения'; BT='Амортизировать полную стоимость и сторнировать корректировку обесценения'</value>
