  <attributes>
    <name>Goods</name>
    <title>
      <key>en</key>
      <value>Goods</value>
    </title>
    <title>
      <key>fa</key>
      <value>کالاها</value>
    </title>
    <title>
      <key>it</key>
      <value>Merci</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wiersze pozycji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Товары</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ürünler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Hàng hóa</value>
    </title>
    <id>8</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Goods.Characteristic</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Goods.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Warehouses.Products AS Products,
	Warehouses.Characteristic AS Characteristic,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Status, VALUE(Enum.DiscountValidityStatuses.NotValid)) AS Status,
	CASE
		WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Status IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS Use,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Period, DATETIME(1, 1, 1)) AS StartDate,
	CASE WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Period IS NULL THEN
		ISNULL(DATEADD(TheEffectOfDiscountsMarkupsASliceOfTheFirst.Period, DAY, -1), DATETIME(1, 1, 1)) 
	ELSE
		ISNULL(DATEADD(Table.Period, DAY, -1), DATETIME(1, 1, 1))
	END AS EndDate
FROM
	(SELECT DISTINCT T.Products, T.Characteristic FROM InformationRegister.ValidityOfDiscountsMarkupsByItems AS T WHERE T.Source = &amp;DiscountMarkup) AS Warehouses
		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkupsByItems.SliceLast(
				&amp;CurrentDate,
				Source = &amp;DiscountMarkup) AS TheEffectOfDiscountsMarkupsASliceOfTheLast
		ON (TheEffectOfDiscountsMarkupsASliceOfTheLast.Products = Warehouses.Products
			AND TheEffectOfDiscountsMarkupsASliceOfTheLast.Characteristic = Warehouses.Characteristic)
		LEFT JOIN (SELECT
			MIN(T.Period) AS Period,
			T.Products AS Products,
			T.Characteristic AS Characteristic
		FROM
			InformationRegister.ValidityOfDiscountsMarkupsByItems.SliceLast(
					&amp;CurrentDate,
					Source = &amp;DiscountMarkup) AS CrossSection
				LEFT JOIN InformationRegister.ValidityOfDiscountsMarkupsByItems AS T
				ON CrossSection.Products = T.Products
					AND (T.Characteristic = CrossSection.Characteristic)
					AND (T.Source = &amp;DiscountMarkup)
					AND (T.Period > CrossSection.Period)
					AND (T.Status &lt;> CrossSection.Status)
		
		GROUP BY
			T.Products, T.Characteristic) AS Table
		ON (Table.Characteristic = Warehouses.Characteristic
			AND Table.Products = Warehouses.Products)
		
		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkupsByItems.SliceFirst(
				&amp;CurrentDate,
				Source = &amp;DiscountMarkup) AS TheEffectOfDiscountsMarkupsASliceOfTheFirst
		ON (TheEffectOfDiscountsMarkupsASliceOfTheFirst.Products = Warehouses.Products
			AND TheEffectOfDiscountsMarkupsASliceOfTheFirst.Characteristic = Warehouses.Characteristic)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
