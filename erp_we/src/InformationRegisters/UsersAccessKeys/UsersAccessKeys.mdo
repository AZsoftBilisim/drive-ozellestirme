    <type>
      <types>CatalogRef.SetsOfAccessGroups</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>A user, a user group set
, or an access group set.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>یک کاربر، یک مجموعه گروه کاربری
، یا یک مجموعه گروه دسترسی.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Utente o set di gruppi di utenti
o set di gruppi di accesso a cui è consentita la chiave di accesso</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Użytkownik lub zestaw grup użytkowników
lub zestaw grup dostępu, któremu jest dozwolony klucz dostępu</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Пользователь или набор групп пользователей
или набор групп доступа, которому разрешен ключ доступа</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Kullanıcı veya kullanıcı grupların kümesi 
 veya erişim anahtarının izin verildiği erişim grupların kümesi</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Người sử dụng hoặc nhóm người sử dụng
hoặc tập hợp nhóm truy cập mà được phép khóa truy cập</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
    <mainFilter>true</mainFilter>
  </dimensions>
