  <resources uuid="9151fa13-6612-4c4c-a264-3fd669205de7">
    <name>RightUpdate</name>
    <synonym>
      <key>en</key>
      <value>&quot;Update&quot; right</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حق «به‌روزرسانی»</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Diritto Modifica</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Prawo zmiana</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Право изменение</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Değişim yetkisi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quyền Thay đổi</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>To allow not only Read but also Update, select the check box.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برای اجازه نه‌تنها خواندن بلکه به‌روزرسانی، کادر را انتخاب کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se il segno è impostato, non è consentita solo la lettura, ma anche il cambiamento.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli cecha jest ustawiona, dozwolone jest nie tylko czytanie, ale także zmiana</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Если признак установлен, то разрешено не только чтение, но и изменение</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Onay kutusu seçilmişse sadece okumaya değil, düzenlemeye de izin verilir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nếu đã thiết lập dấu hiệu thì không chỉ cho phép đọc mà còn có thể thay đổi</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
  <resources uuid="fee8fd9d-be7d-4560-9b96-819ffd497c88">
    <name>AddRight</name>
    <synonym>
      <key>en</key>
      <value>&quot;Add&quot; right</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حق «افزودن»</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Diritto aggiungere</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Prawo dodawanie</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Право добавление</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ekleme yetkisi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quyền Thêm</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>To allow not only Read and Update but also Add, select the check box.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برای اجازه نه‌تنها خواندن و به‌روزرسانی بلکه افزودن، کادر را انتخاب کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se il segno è impostato, è consentita non solo la lettura e modifica, ma anche l'aggiunta</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli cecha jest ustawiona, dozwolone jest nie tylko czytanie i zmiana, ale także dodawanie</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Если признак установлен, то разрешено не только чтение и изменение, но и добавление</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Onay kutusu seçiliyse, sadece Okumaya ve Güncellemeye değil, Eklemeye de izin verilir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nếu đã thiết lập dấu hiệu thì không chỉ cho phép đọc và thay đổi mà còn có thể thêm</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
  <attributes uuid="c86135b4-063c-4ca8-99e2-35c61026b43f">
    <name>AreGroupSetRights</name>
    <synonym>
      <key>en</key>
      <value>The access rights apply to a group set</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حقوق دسترسی بر مجموعه گروه اعمال می‌شود</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Questi sono diritti di set del gruppo</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Są to prawa do zestawu grup</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Это права набора групп</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Bu gruplar kümesinin hakları</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Đây là quyền tập hợp nhóm</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>The access rights apply to an access group set
or an external user group set (not to a user).</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>حقوق دسترسی بر مجموعه گروه دسترسی
یا مجموعه گروه کاربر خارجی اعمال می‌شود (نه بر کاربر).</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Queste sono i diritti di set di gruppi di accesso o
 gruppi di utenti, non utente</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Są to prawa do zestawu grup dostępu lub
grup użytkowników, a nie użytkownika</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Это права набора групп доступа или
групп пользователей, а не пользователя</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Bu erişim grupların kümesinin veya 
harici kullanıcı grupların hakları, kullanıcının hakları değil</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đây là quyền của tập hợp nhóm truy cập hoặc
nhóm người sử dụng mà không phải người sử dụng</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <indexing>Index</indexing>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </attributes>
  <dimensions uuid="186792a9-0a07-4b6d-a9a0-337221f6b009">
    <name>User</name>
    <synonym>
