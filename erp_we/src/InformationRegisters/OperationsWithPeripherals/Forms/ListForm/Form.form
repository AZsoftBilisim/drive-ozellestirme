    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterOperationsWithPeripherals.Equipment AS Equipment,
	InformationRegisterOperationsWithPeripherals.Date AS Date,
	InformationRegisterOperationsWithPeripherals.OperationNumber AS OperationNumber,
	InformationRegisterOperationsWithPeripherals.YearMonth AS YearMonth,
	InformationRegisterOperationsWithPeripherals.IncomingParameters AS IncomingParameters,
	InformationRegisterOperationsWithPeripherals.OutgoingParameters AS OutgoingParameters,
	InformationRegisterOperationsWithPeripherals.Result AS Result,
	InformationRegisterOperationsWithPeripherals.Timecode AS Timecode,
	InformationRegisterOperationsWithPeripherals.EntryType AS EntryType,
	InformationRegisterOperationsWithPeripherals.VersionAddIn AS VersionAddIn,
	InformationRegisterOperationsWithPeripherals.DriverVersion AS DriverVersion,
	InformationRegisterOperationsWithPeripherals.Operation AS Operation,
	InformationRegisterOperationsWithPeripherals.DeviceID_ AS DeviceID_,
	InformationRegisterOperationsWithPeripherals.RunTime / 1000 AS RunTime,
	InformationRegisterOperationsWithPeripherals.InterfaceRevision AS InterfaceRevision,
	InformationRegisterOperationsWithPeripherals.Millisecond AS Millisecond,
	InformationRegisterOperationsWithPeripherals.ErrorCode AS ErrorCode,
	InformationRegisterOperationsWithPeripherals.ErrorText AS ErrorText,
	InformationRegisterOperationsWithPeripherals.IncomingParametersString AS IncomingParametersString,
	InformationRegisterOperationsWithPeripherals.OutgoingParametersString AS OutgoingParametersString,
	InformationRegisterOperationsWithPeripherals.ErrorTextString AS ErrorTextString
FROM
	InformationRegister.OperationsWithPeripherals AS InformationRegisterOperationsWithPeripherals</queryText>
      <mainTable>InformationRegister.OperationsWithPeripherals</mainTable>
