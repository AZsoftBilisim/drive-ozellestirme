  <dimensions uuid="a0701ad3-572a-4806-91c0-6c5fff8dd350">
    <name>AccessOption</name>
    <synonym>
      <key>en</key>
      <value>Access option</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>گزینه دسترسی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Opzione di accesso</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wariant dostępu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Вариант доступа</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Erişim seçeneği</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Phương án truy cập</value>
    </synonym>
    <type>
      <types>Number</types>
      <numberQualifiers>
        <precision>4</precision>
        <nonNegative>true</nonNegative>
      </numberQualifiers>
    </type>
    <toolTip>
      <key>en</key>
      <value>Bit 0 is the access key for external users.
Bits 1-5 are the number of fields in the join.
Bits 6-9 are the field set in the join.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>بیت 0 کلید دسترسی برای کاربران خارجی است.
بیت‌های 1-5 تعداد فیلدها در اتصال هستند.
بیت‌های 6-9 مجموعه فیلدها در اتصال هستند.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Bit 0 - chiave di accesso per utenti esterni.
Bits 1-5 - numero di campi nella connessione.
Bits 6-9 - insieme di campi nella connessione.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Bit 0 -  klucz dostępu dla użytkowników zewnętrznych.
Bity 1-5 - ilość pól w połączeniu.
Bity 6-9 - zestaw pól w połączeniu.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Бит 0 -  ключ доступа для внешних пользователей.
Биты 1-5 - количество полей в соединении.
Биты 6-9 - набор полей в соединении.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Bit 0 - harici kullanıcılar için erişim anahtarı.
 Bit 1-5, bağlantıdaki alanların sayısıdır. 
Bit 6-9, bağlantıdaki alanlar kümesidir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Bit 0 -  khóa truy cập cho người dùng bên ngoài.
Bit 1-5 - số trường trong kết nối.
Bit 6-9 - tập hợp các trường trong một kết nối.</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
    <mainFilter>true</mainFilter>
  </dimensions>
  <dimensions uuid="c9f268d1-6d2a-47d5-9371-f951b95d24a6">
    <name>Field1</name>
