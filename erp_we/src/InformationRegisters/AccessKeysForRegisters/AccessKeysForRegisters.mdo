    <synonym>
      <key>vi</key>
      <value>Trường 1</value>
    </synonym>
    <type>
      <types>DefinedType.RegisterAccessKeysRegisterField</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>The field that affects the access restriction and matches the first register field.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>فیلدی که بر محدودیت دسترسی اثر می‌گذارد و با اولین فیلد رجیستر مطابقت دارد.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Il campo corrispondente al primo campo del registro da cui dipende la restrizione di accesso</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Pole odpowiadające pierwszemu polu rejestru, od którego zależne jest ograniczenie dostępu</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Поле, соответствующее первому полю регистра, от которого зависит ограничение доступа</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Erişim kısıtlamasının bağlı olduğu birinci kaydedici alanına uygun alan</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Trường mà tương ứng với trường thứ nhất của biểu ghi mà hạn chế truy cập sẽ phụ thuộc vào đó</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
    <mainFilter>true</mainFilter>
  </dimensions>
  <dimensions uuid="86b155be-d611-46b4-8275-bb19a2fa20ba">
    <name>Field2</name>
    <synonym>
      <key>en</key>
      <value>Field 2</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>فیلد 2</value>
