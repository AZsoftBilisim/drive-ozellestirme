  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RegisterData.Period,
	RegisterData.Contract,
	RegisterData.Percent,
	RegisterData.Fee,
	LoanAndDepositContracts.FeeType AS FeeType,
	RegisterData.ChangeAuthor,
	RegisterData.ChangeDate
FROM
	InformationRegister.InterestRateOfFinancialInstruments AS RegisterData
		LEFT JOIN Catalog.LoanAndDepositContracts AS LoanAndDepositContracts
		ON RegisterData.Contract = LoanAndDepositContracts.Ref</queryText>
      <mainTable>InformationRegister.InterestRateOfFinancialInstruments</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Period</dataPath>
        <field>Period</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>FeeType</dataPath>
        <field>FeeType</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Percent</dataPath>
        <field>Percent</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Contract</dataPath>
        <field>Contract</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Fee</dataPath>
        <field>Fee</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ChangeAuthor</dataPath>
        <field>ChangeAuthor</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ChangeDate</dataPath>
        <field>ChangeDate</field>
      </fields>
    </extInfo>
  </attributes>
