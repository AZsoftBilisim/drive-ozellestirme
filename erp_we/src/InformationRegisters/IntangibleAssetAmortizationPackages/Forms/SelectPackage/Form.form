    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	DepreciationPackages.PackageNumber
FROM
	InformationRegister.IntangibleAssetAmortizationPackages AS DepreciationPackages
WHERE
	DepreciationPackages.Organization = &amp;Organization</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PackageNumber</dataPath>
        <field>PackageNumber</field>
      </fields>
      <parameters>
        <name>Organization</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Company</value>
            </content>
            <content>
              <key>fa</key>
              <value>شرکت</value>
            </content>
            <content>
              <key>it</key>
              <value>Azienda</value>
            </content>
            <content>
              <key>pl</key>
              <value>Firma</value>
            </content>
            <content>
              <key>ru</key>
              <value>Организация</value>
            </content>
            <content>
              <key>tr</key>
              <value>İş yeri</value>
            </content>
            <content>
              <key>vi</key>
              <value>Doanh nghiệp</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>CatalogRef.Companies</types>
        </valueType>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
      </parameters>
    </extInfo>
