    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsNewObject</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.LongDesc</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MetadataObject</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ObjectWithIssue</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.OccurrenceDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThisApplicationVersion</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.UniqueKey</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.VersionFromOtherApplication</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.VersionFromOtherApplicationAccepted</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.WarningComment</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.WarningType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Пропущена</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterDataExchangeResultsOverridable.InfobaseNode AS InfobaseNode,
	InformationRegisterDataExchangeResultsOverridable.ObjectWithIssue AS ObjectWithIssue,
	InformationRegisterDataExchangeResultsOverridable.MetadataObject AS MetadataObject,
	InformationRegisterDataExchangeResultsOverridable.IssueType AS WarningType,
	CASE
		WHEN
			InformationRegisterDataExchangeResultsOverridable.IssueType = VALUE(Enum.DataExchangeIssuesTypes.UnpostedDocument)
			THEN &amp;UnpostedDocument
		WHEN
			InformationRegisterDataExchangeResultsOverridable.IssueType = VALUE(Enum.DataExchangeIssuesTypes.BlankAttributes)
			THEN &amp;EmptyAttributes
		WHEN
			InformationRegisterDataExchangeResultsOverridable.IssueType = VALUE(Enum.DataExchangeIssuesTypes.ConvertedObjectValidationError)
			THEN &amp;CheckBeforeSend
		WHEN
			InformationRegisterDataExchangeResultsOverridable.IssueType = VALUE(Enum.DataExchangeIssuesTypes.ApplicationAdministrativeError)
			OR InformationRegisterDataExchangeResultsOverridable.IssueType = VALUE(Enum.DataExchangeIssuesTypes.HandlersCodeExecutionErrorOnSendData)
			THEN &amp;TechnicalErrorSend
		WHEN
			InformationRegisterDataExchangeResultsOverridable.IssueType = VALUE(Enum.DataExchangeIssuesTypes.HandlersCodeExecutionErrorOnGetData)
			THEN &amp;TechnicalErrorGet
	END AS WarningTypePresentation,
	InformationRegisterDataExchangeResultsOverridable.OccurrenceDate AS OccurrenceDate,
	InformationRegisterDataExchangeResultsOverridable.Cause AS LongDesc,
	InformationRegisterDataExchangeResultsOverridable.UniqueKey AS UniqueKey,
	InformationRegisterDataExchangeResultsOverridable.IsSkipped AS HideWarning,
	CASE
		WHEN InformationRegisterDataExchangeResultsOverridable.Comment = &quot;&quot;
			THEN FALSE
		ELSE TRUE
	END AS HasComment,
	InformationRegisterDataExchangeResultsOverridable.Comment AS WarningComment,
	UNDEFINED AS VersionFromOtherApplication,
	UNDEFINED AS ThisApplicationVersion,
	UNDEFINED AS VersionFromOtherApplicationAccepted,
	UNDEFINED AS IsNewObject
FROM
	InformationRegister.DataExchangeResults AS InformationRegisterDataExchangeResultsOverridable</queryText>
      <mainTable>InformationRegister.DataExchangeResults</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
