  <attributes>
    <name>UnpostedDocuments</name>
    <title>
      <key>en</key>
      <value>Unposted documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>اسناد ثبت قطعی‌نشده</value>
    </title>
    <title>
      <key>it</key>
      <value>Documenti non inseriti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Niezaksięgowane dokumenty</value>
    </title>
    <title>
      <key>ru</key>
      <value>Непроведенные документы</value>
    </title>
    <title>
      <key>tr</key>
      <value>Gönderilmemiş belgeler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Chứng từ chưa kết chuyển</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.Cause</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.DocumentDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.DocumentNumber</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.InfobaseNode</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.IsSkipped</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.OccurrenceDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UnpostedDocuments.TypeAsString</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DataExchangeResults.ObjectWithIssue AS Ref,
	CASE
		WHEN DataExchangeResults.DeletionMark
			THEN 2
		ELSE 0
	END AS DeletionMark,
	DataExchangeResults.DocumentNumber AS DocumentNumber,
	DataExchangeResults.DocumentDate AS DocumentDate,
	DataExchangeResults.InfobaseNode,
	DataExchangeResults.OccurrenceDate,
	DataExchangeResults.Cause,
	DataExchangeResults.IsSkipped,
	VALUETYPE(DataExchangeResults.ObjectWithIssue) AS TypeAsString
FROM
