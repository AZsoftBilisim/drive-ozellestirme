  <name>DataExchangeRules</name>
  <synonym>
    <key>en</key>
    <value>Data exchange rules</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>قواعد تبادل داده</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Regole per lo scambio di dati</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Reguły wymiany danych</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Правила для обмена данными</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Veri değişimi kuralları</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Quy tắc để trao đổi dữ liệu</value>
  </synonym>
