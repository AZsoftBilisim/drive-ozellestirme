  <items xsi:type="form:FormGroup">
    <name>MessageToUserGroup</name>
    <id>7</id>
    <items xsi:type="form:Decoration">
      <name>MessagePicture</name>
      <id>9</id>
      <title>
        <key>en</key>
        <value>Message picture</value>
      </title>
      <title>
        <key>fa</key>
        <value>تصویر پیام</value>
      </title>
      <title>
        <key>it</key>
        <value>Immagine del messaggio</value>
      </title>
      <title>
        <key>pl</key>
        <value>Obraz wiadomości</value>
      </title>
      <title>
        <key>ru</key>
        <value>Картинка сообщения</value>
      </title>
      <title>
        <key>tr</key>
        <value>Mesaj resmi</value>
      </title>
      <title>
        <key>vi</key>
        <value>Hình vẽ thông báo</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>MessagePictureExtendedTooltip</name>
        <id>11</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
