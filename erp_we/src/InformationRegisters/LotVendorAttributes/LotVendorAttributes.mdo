    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Ürünün satın alındığı tedarikçi - carip hesap veya komisyon karşılığında ürünün teslim alındığı gönderici.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
