    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RulesForClarifyingInvoices.FinancialAccountingGroup,
	RulesForClarifyingInvoices.PostingTemplate,
	RulesForClarifyingInvoices.RecordType,
	RulesForClarifyingInvoices.GLAccount,
	CASE
		WHEN RulesForClarifyingInvoices.RecordType = VALUE(Enum.AccountingMovementKinds.Debit)
			THEN RulesForClarifyingInvoices.PostingTemplate.DrAccountDefault
		ELSE RulesForClarifyingInvoices.PostingTemplate.CrAccountDefault
	END AS DefaultAccount
FROM
	InformationRegister.RulesOfSpecifyingAccountsFinancialAccounting AS RulesForClarifyingInvoices</queryText>
      <mainTable>InformationRegister.RulesOfSpecifyingAccountsFinancialAccounting</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>FinancialAccountingGroup</dataPath>
        <field>FinancialAccountingGroup</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PostingTemplate</dataPath>
        <field>PostingTemplate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
