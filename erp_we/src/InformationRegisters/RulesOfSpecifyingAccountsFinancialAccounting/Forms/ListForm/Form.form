        <field>RecordType</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>GLAccount</dataPath>
        <field>GLAccount</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DefaultAccount</dataPath>
        <field>DefaultAccount</field>
        <title>
