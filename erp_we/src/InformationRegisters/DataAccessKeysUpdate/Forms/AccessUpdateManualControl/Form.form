      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <placementArea>UserCmds</placementArea>
      <representationInContextMenu>Auto</representationInContextMenu>
    </items>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <title>
      <key>en</key>
      <value>2. Update access to all list items</value>
    </title>
    <title>
      <key>fa</key>
      <value>2. به‌روزرسانی دسترسی به همه اقلام فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>2. L'aggiornamento dell'accesso a tutti gli elementi degli elenchi</value>
    </title>
    <title>
      <key>pl</key>
      <value>2. Aktualizowanie dostępu do wszystkich elementów listów</value>
    </title>
    <title>
      <key>ru</key>
      <value>2. Обновление доступа ко всем элементам списков</value>
    </title>
    <title>
      <key>tr</key>
      <value>2. Listelerin tüm öğelerine olan erişimi güncelleme</value>
    </title>
    <title>
      <key>vi</key>
      <value>2. Cập nhật truy cập đến tất cả phần tử của danh sách</value>
    </title>
    <extendedTooltip>
      <name>AccessUpdateScheduleGroupExtendedTooltip</name>
      <id>12</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <type>UsualGroup</type>
    <extInfo xsi:type="form:UsualGroupExtInfo">
      <group>Vertical</group>
      <representation>NormalSeparation</representation>
      <showLeftMargin>true</showLeftMargin>
