      <value>Zaktualizuj obiekt lub zaplanuj aktualizację dostępu do wskazanych list</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Обновить объект или запланировать обновление доступа к указанным спискам</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
