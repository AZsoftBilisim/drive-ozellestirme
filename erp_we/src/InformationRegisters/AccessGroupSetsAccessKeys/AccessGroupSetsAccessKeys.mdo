  <resources uuid="e39de1c5-b43b-4f71-aa32-c03b8afd6f65">
    <name>RightUpdate</name>
    <synonym>
      <key>en</key>
      <value>&quot;Update&quot; right</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حق «به‌روزرسانی»</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Diritto Modifica</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Prawo zmiana</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Право изменение</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Değişim yetkisi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quyền Thay đổi</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>To allow not only Read but also Update, select the check box.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برای اجازه نه‌تنها خواندن بلکه به‌روزرسانی، کادر را انتخاب کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se il segno è impostato, non è consentita solo la lettura, ma anche il cambiamento.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli cecha jest ustawiona, dozwolone jest nie tylko czytanie, ale także zmiana</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Если признак установлен, то разрешено не только чтение, но и изменение</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Onay kutusu seçilmişse sadece okumaya değil, düzenlemeye de izin verilir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nếu đã thiết lập dấu hiệu thì không chỉ cho phép đọc mà còn có thể thêm</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
  </resources>
  <resources uuid="d5b6aad4-b1bd-464b-aca0-f8455d6388b4">
    <name>AddRight</name>
    <synonym>
      <key>en</key>
      <value>&quot;Add&quot; right</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حق «افزودن»</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Diritto aggiungere</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Prawo dodawanie</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Право добавление</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ekleme yetkisi</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Quyền Thêm</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>To allow not only Read and Update but also Add, select the check box.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برای اجازه نه‌تنها خواندن و به‌روزرسانی بلکه افزودن، کادر را انتخاب کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Se il segno è impostato, è consentita non solo la lettura e modifica, ma anche l'aggiunta</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jeśli cecha jest ustawiona, dozwolone jest nie tylko czytanie i zmiana, ale także dodawanie</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Если признак установлен, то разрешено не только чтение и изменение, но и добавление</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Onay kutusu seçiliyse, sadece Okumaya ve Güncellemeye değil, Eklemeye de izin verilir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Nếu đã thiết lập dấu hiệu thì không chỉ cho phép đọc và thay đổi mà còn có thể thêm</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fullTextSearch>Use</fullTextSearch>
    <dataHistory>Use</dataHistory>
    <fillValue xsi:type="core:UndefinedValue"/>
