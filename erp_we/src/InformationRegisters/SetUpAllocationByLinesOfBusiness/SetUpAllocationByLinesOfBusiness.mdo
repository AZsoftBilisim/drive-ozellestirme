    <synonym>
      <key>pl</key>
      <value>Kierunek działalności / Sposób podziału</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Направление деятельности / Способ распределения</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>İş kolu / Dağıtım yöntemi</value>
    </synonym>
