    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RegisterData.InventoryOwnerAttribute,
	RegisterData.ItemsLocationAttributes.Products AS Products,
	RegisterData.ItemsLocationAttributes.Characteristic AS Characteristic,
	RegisterData.ItemsLocationAttributes.Series AS Series,
	RegisterData.ItemsLocationAttributes.StorageLocation AS Warehouse,
	RegisterData.CCDNumber,
	RegisterData.Terms,
	RegisterData.Organization,
	RegisterData.TransferDate
FROM
	InformationRegister.DatesOfConsignmentGoodsTransfer AS RegisterData</queryText>
      <mainTable>InformationRegister.DatesOfConsignmentGoodsTransfer</mainTable>
