    </synonym>
    <synonym>
      <key>fa</key>
      <value>برای کاربران خارجی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Per gli utenti esterni</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Dla użytkowników zewnętrznych</value>
