      <value>Đối với người sử dụng bên ngoài</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Update access keys for external users</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>به‌روزرسانی کلیدهای دسترسی برای کاربران خارجی</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Aggiorna le chiavi di accesso per gli utenti esterni</value>
    </toolTip>
