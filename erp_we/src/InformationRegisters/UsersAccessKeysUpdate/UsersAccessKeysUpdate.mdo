  <recordPresentation>
    <key>en</key>
    <value>User access keys update</value>
  </recordPresentation>
  <recordPresentation>
    <key>fa</key>
    <value>به‌روزرسانی کلیدهای دسترسی کاربر</value>
  </recordPresentation>
  <recordPresentation>
    <key>it</key>
