    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ForecastedExchangeRates.Period,
	ForecastedExchangeRates.Currency,
	ForecastedExchangeRates.CourseNumerator,
	ForecastedExchangeRates.CourseDenominator
FROM
	InformationRegister.ForecastedExchangeRatesOfScenarios AS ForecastedExchangeRates
WHERE
	ForecastedExchangeRates.Scenario = &amp;Scenario</queryText>
      <mainTable>InformationRegister.ForecastedExchangeRatesOfScenarios</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CourseNumerator</dataPath>
        <field>CourseNumerator</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Period</dataPath>
        <field>Period</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Currency</dataPath>
        <field>Currency</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Scenario</dataPath>
        <field>Scenario</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CourseDenominator</dataPath>
        <field>CourseDenominator</field>
      </fields>
      <parameters>
        <name>Scenario</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
