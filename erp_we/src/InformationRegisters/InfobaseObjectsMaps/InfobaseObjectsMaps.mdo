  <name>InfobaseObjectsMaps</name>
  <synonym>
    <key>en</key>
    <value>Mapping of infobase objects</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>نگاشت اشیای پایگاه اطلاعات</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Conformità di oggetti di database</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Zgodność obiektów baz informacyjnych</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Соответствия объектов информационных баз</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Infobase nesnelerinin eşleştirilmesi</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Tương ứng giữa các đối tượng trong cơ sở thông tin</value>
  </synonym>
