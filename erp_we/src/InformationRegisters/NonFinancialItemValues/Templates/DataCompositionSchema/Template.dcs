		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	&amp;Period AS Period,
	NonFinancialItemValues.Recorder,
	NonFinancialItemValues.NonFinancialItem,
	NonFinancialItemValues.Scenario,
	NonFinancialItemValues.Organization,
	NonFinancialItemValues.Department,
	NonFinancialItemValues.Dimension1,
	NonFinancialItemValues.Dimension2,
	NonFinancialItemValues.Dimension3,
	NonFinancialItemValues.Dimension4,
	NonFinancialItemValues.Dimension5,
	NonFinancialItemValues.Dimension6,
	NonFinancialItemValues.SubperiodNumber,
	NonFinancialItemValues.IndicatorValue,
	NonFinancialItemValues.Currency
FROM
	InformationRegister.NonFinancialItemValues.SliceLast(&amp;Period, {(NonFinancialItem).*, (Scenario).*, (Organization).*, (Department).*, (Dimension1).*, (Dimension2).*, (Dimension3).*, (Dimension4).*, (Dimension5).*, (Dimension6).*}) AS NonFinancialItemValues
WHERE
	(NonFinancialItemValues.EndDate = DATETIME(1, 1, 1)
			OR NonFinancialItemValues.EndDate &gt;= &amp;Period)</query>
	</dataSet>
