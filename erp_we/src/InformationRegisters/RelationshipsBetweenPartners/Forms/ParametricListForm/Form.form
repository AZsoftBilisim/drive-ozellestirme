    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE
		WHEN RelationshipsBetweenPartners.FirstPartner = &amp;Partner
			THEN RelationshipsBetweenPartners.SecondPartner
		ELSE RelationshipsBetweenPartners.FirstPartner
	END AS Partner,
	CASE
		WHEN RelationshipsBetweenPartners.FirstPartner = &amp;Partner
			THEN PartnerRelationshipTypes.Description
		ELSE PartnerRelationshipTypes.ReverseName
	END AS RepresentationOfTheTypeOfCommunication,
	RelationshipsBetweenPartners.Author,
	RelationshipsBetweenPartners.Comment,
	RelationshipsBetweenPartners.FirstPartner,
	RelationshipsBetweenPartners.SecondPartner,
	RelationshipsBetweenPartners.RelationshipType AS RelationshipType
FROM
	InformationRegister.RelationshipsBetweenPartners AS RelationshipsBetweenPartners
		INNER JOIN Catalog.PartnerRelationshipTypes AS PartnerRelationshipTypes
		ON RelationshipsBetweenPartners.RelationshipType = PartnerRelationshipTypes.Ref
WHERE
	(RelationshipsBetweenPartners.FirstPartner = &amp;Partner
			OR RelationshipsBetweenPartners.SecondPartner = &amp;Partner)</queryText>
      <mainTable>InformationRegister.RelationshipsBetweenPartners</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
