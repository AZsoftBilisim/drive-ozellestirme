        <field>Description</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Author</dataPath>
        <field>Author</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>RelationshipType</dataPath>
        <field>RelationshipType</field>
      </fields>
    </extInfo>
