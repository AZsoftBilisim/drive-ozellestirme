  <resources uuid="e39ff252-1fb2-4e81-b98d-433961fcde25">
    <name>DiscountRate</name>
    <synonym>
      <key>en</key>
      <value>Discounting rate, %</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>نرخ تنزیل، درصد</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Aliquota sconto, %</value>
