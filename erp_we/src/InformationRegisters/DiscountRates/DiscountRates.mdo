    <synonym>
      <key>pl</key>
      <value>Stawka dyskontowania, %</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Ставка дисконтирования, %</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>İskonto oranı, %</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Tỷ lệ tính chiết khấu, %</value>
