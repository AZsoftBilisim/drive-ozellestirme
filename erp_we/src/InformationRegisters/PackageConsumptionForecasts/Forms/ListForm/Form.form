  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.AssignedByUser</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MinimumProbabilityOfShipment</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.StandardStockQuantityRecommended</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ForecastsOverridable.Warehouse,
	ForecastsOverridable.Premise,
	ForecastsOverridable.Package,
	ForecastsOverridable.Products,
	ForecastsOverridable.Characteristic,
	ForecastsOverridable.Series,
	ForecastsOverridable.AverageDailyConsumption,
	ForecastsOverridable.RootMeanSquareVariance,
	ForecastsOverridable.ShipmentProbabilityWithinDay,
	CASE
		WHEN ForecastsOverridable.AssignedByUser
			THEN ForecastsOverridable.StandardStockLevel
		ELSE ForecastsOverridable.AverageDailyConsumption + ForecastsOverridable.RootMeanSquareVariance * CASE
				WHEN ForecastsOverridable.Class = VALUE(Enum.XYZClassification.XClass)
					THEN SettingsOverridable.ServiceLevelOfClassXPackages.Order * 0.2
				WHEN ForecastsOverridable.Class = VALUE(Enum.XYZClassification.YClass)
					THEN SettingsOverridable.ServiceLevelOfClassYPackages.Order * 0.2
				WHEN ForecastsOverridable.Class = VALUE(Enum.XYZClassification.ZClass)
					THEN SettingsOverridable.ServiceLevelOfClassZPackages.Order * 0.2
				ELSE 0
			END
	END AS StandardStockLevel,
	ForecastsOverridable.Class,
	SettingsOverridable.MinimumProbabilityOfShipment,
	ForecastsOverridable.AverageDailyConsumption + ForecastsOverridable.RootMeanSquareVariance * CASE
		WHEN ForecastsOverridable.Class = VALUE(Enum.XYZClassification.XClass)
			THEN SettingsOverridable.ServiceLevelOfClassXPackages.Order * 0.2
		WHEN ForecastsOverridable.Class = VALUE(Enum.XYZClassification.YClass)
			THEN SettingsOverridable.ServiceLevelOfClassYPackages.Order * 0.2
		WHEN ForecastsOverridable.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN SettingsOverridable.ServiceLevelOfClassZPackages.Order * 0.2
		ELSE 0
	END AS StandardStockQuantityRecommended,
	ForecastsOverridable.AssignedByUser,
	CASE
		WHEN ForecastsOverridable.ShipmentProbabilityWithinDay >= SettingsOverridable.MinimumProbabilityOfShipment
				OR ForecastsOverridable.AssignedByUser
			THEN TRUE
		ELSE FALSE
	END AS ParticipatesInTheRecharge,
	&amp;QueryTextPackagingFactor AS PackageFactor
FROM
	InformationRegister.PackageConsumptionForecasts AS ForecastsOverridable
		LEFT JOIN InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOverridable
		ON ForecastsOverridable.Warehouse = SettingsOverridable.Warehouse
			AND ForecastsOverridable.Premise = SettingsOverridable.Premise</queryText>
      <mainTable>InformationRegister.PackageConsumptionForecasts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
