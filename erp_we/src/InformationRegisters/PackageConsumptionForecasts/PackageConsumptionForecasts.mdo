    <value>Packaging unit consumption forecasts</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>پیش‌بینی‌های مصرف واحد بسته‌بندی</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Previsioni del consumo degli imballaggi</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Prognozy zużycia opakowań</value>
  </synonym>
  <synonym>
