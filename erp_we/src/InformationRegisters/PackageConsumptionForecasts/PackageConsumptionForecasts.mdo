    <value>Прогнозы расхода упаковок</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Paketleme ünitesi gider tahminleri</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Dự báo tiêu thụ bao bì</value>
  </synonym>
  <useStandardCommands>true</useStandardCommands>
