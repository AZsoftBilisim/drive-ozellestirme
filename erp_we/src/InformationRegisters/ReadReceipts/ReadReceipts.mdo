    </synonym>
    <synonym>
      <key>fa</key>
      <value>خوانده شده است</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>È richiesto l'invio</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wymagana jest wysyłka</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Требуется отправка</value>
    </synonym>
    <synonym>
