    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED DISTINCT
	StatusOfDocumentVerification.Document AS Document,
	VALUETYPE(StatusOfDocumentVerification.Document) AS DocumentType,
	StatusOfDocumentVerification.Period AS Date,
	StatusOfDocumentVerification.Organization AS Organization,
	StatusOfDocumentVerification.CheckStatus AS CheckStatus,
	StatusOfDocumentVerification.WhoChecked AS AuthorOfDocumentVerification,
	StatusOfDocumentVerification.ChangedBy AS AuthorOfDocumentChange,
	StatusOfDocumentVerification.CheckDate AS DocumentVerificationDate,
	StatusOfDocumentVerification.ChangeDate AS DocumentChangingDate,
	ISNULL(DocumentsRegistry.IBDocumentNumber, &quot;&quot;) AS Number
FROM
	InformationRegister.StatusOfDocumentVerification AS StatusOfDocumentVerification
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON StatusOfDocumentVerification.Document = DocumentsRegistry.Ref
			AND NOT DocumentsRegistry.AdditionalRecord
{WHERE
	(StatusOfDocumentVerification.Period >= &amp;BeginOfPeriod),
	(StatusOfDocumentVerification.Period &lt;= &amp;EndOfPeriod),
	StatusOfDocumentVerification.CheckStatus AS ReflectionStatus,
	StatusOfDocumentVerification.Document.* AS Document,
	StatusOfDocumentVerification.Organization.*,
	VALUETYPE(StatusOfDocumentVerification.Document) AS DocumentType}</queryText>
      <mainTable>InformationRegister.StatusOfDocumentVerification</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
