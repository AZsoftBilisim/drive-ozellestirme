                <value>Yes, I want to send and receive messages via System Email Client</value>
              </presentation>
              <value xsi:type="core:NumberValue">
                <value>1</value>
              </value>
            </choiceList>
            <choiceList>
              <presentation>
                <key>en</key>
                <value>No, I don't want to add this account to System Email Client</value>
              </presentation>
              <presentation>
                <key>fa</key>
                <value>خیر، نمی‌خواهم این حساب را به System Email Client اضافه کنم</value>
