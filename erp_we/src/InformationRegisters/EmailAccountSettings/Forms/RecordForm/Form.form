              <presentation>
                <key>vi</key>
                <value>Không sử dụng (chưa thực hiện nhận, lưu và gửi thư)</value>
              </presentation>
              <presentation>
                <key>pl</key>
                <value>No, I don't want to add this account to System Email Client</value>
              </presentation>
              <value xsi:type="core:NumberValue">
                <value>0</value>
