    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterEmployeeActivityRates.Period,
	InformationRegisterEmployeeActivityRates.WorkKind,
	InformationRegisterEmployeeActivityRates.LaborGrade,
	InformationRegisterEmployeeActivityRates.Rate_,
	CurrencyOfActivityKindRates.Value AS Currency
FROM
	InformationRegister.EmployeeActivityRates AS InformationRegisterEmployeeActivityRates,
	Constant.CurrencyOfActivityKindRates AS CurrencyOfActivityKindRates
WHERE
	NOT InformationRegisterEmployeeActivityRates.WorkKind.RateAccordingToPayScale</queryText>
      <mainTable>InformationRegister.EmployeeActivityRates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
