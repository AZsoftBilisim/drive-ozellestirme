    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ItemsPricesOfVendor.Period,
	ItemsPricesOfVendor.Recorder,
	ItemsPricesOfVendor.LineNumber,
	ItemsPricesOfVendor.Active,
	ItemsPricesOfVendor.Partner,
	ItemsPricesOfVendor.VendorPriceKind,
	ItemsPricesOfVendor.Products,
	ItemsPricesOfVendor.Characteristic,
	ItemsPricesOfVendor.Price,
	ItemsPricesOfVendor.Package,
	ItemsPricesOfVendor.Currency,
	ItemsPricesOfVendor.PartnerProducts,
	ItemsPricesOfVendor.PointInTime,
	PurchaseConditions.OrderPackage,
	PurchaseConditions.MinimumDeliveryLot
FROM
	InformationRegister.ItemsPricesOfVendor AS ItemsPricesOfVendor
		LEFT JOIN InformationRegister.PurchaseConditions AS PurchaseConditions
		ON ItemsPricesOfVendor.Recorder = PurchaseConditions.Recorder
		AND ItemsPricesOfVendor.Products = PurchaseConditions.Products
		AND ItemsPricesOfVendor.Characteristic = PurchaseConditions.Characteristic
		AND ItemsPricesOfVendor.VendorPriceKind = PurchaseConditions.VendorPriceKind</queryText>
      <mainTable>InformationRegister.ItemsPricesOfVendor</mainTable>
