  <name>ItemizeLotCostItemizedAndOtherCosts</name>
  <synonym>
    <key>en</key>
    <value>Itemize goods lot cost, itemized and other costs</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>تفکیک بهای لات کالا، هزینه‌های تفکیک‌شده و سایر هزینه‌ها</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Specificazione del prezzo di costo dei lotti di articoli, spese altre e dettagliate</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Szczegóły kosztów własnych partii towarów, koszty według pozycji i inne koszty</value>
