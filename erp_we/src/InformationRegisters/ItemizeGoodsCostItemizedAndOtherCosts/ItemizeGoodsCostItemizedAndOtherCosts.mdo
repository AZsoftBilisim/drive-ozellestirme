  <name>ItemizeGoodsCostItemizedAndOtherCosts</name>
  <synonym>
    <key>en</key>
    <value>Itemize goods lot cost, itemized and other costs (periodic)</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>تفکیک بهای لات کالا، هزینه‌های تفکیک‌شده و سایر هزینه‌ها (دوره‌ای)</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Specificazione del prezzo di costo dei lotti di articoli, spese altre e dettagliate (periodico)</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Szczegóły kosztu własnego partii towarów, koszty według pozycji i inne koszty (okresowy)</value>
  </synonym>
  <synonym>
