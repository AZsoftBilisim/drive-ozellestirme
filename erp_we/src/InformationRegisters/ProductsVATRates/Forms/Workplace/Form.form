    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogProducts.Ref AS Products,
	CatalogProducts.DeletionMark AS DeletionMark,
	CatalogProducts.Parent AS Parent,
	CatalogProducts.IsFolder AS IsFolder,
	CatalogProducts.Code AS Code,
	CatalogProducts.Description AS Description,
	CatalogProducts.UnitOfMeasure AS UnitOfMeasure,
	CatalogProducts.SKU AS SKU,
	CatalogProducts.ProductKind AS ProductKind,
	CatalogProducts.DescriptionFull AS DescriptionFull,
	CatalogProducts.Quality AS Quality,
	CatalogProducts.Brand AS Brand,
	CatalogProducts.FinancialAccountingGroup AS FinancialAccountingGroup,
	CatalogProducts.LongDesc AS LongDesc,
	ISNULL(ExcisableGoodsCategories.ExcisableGoods, FALSE) AS ExcisableGoods,
	CatalogProducts.Manufacturer AS Manufacturer,
	CASE
		WHEN CatalogProducts.IsFolder
			THEN VALUE(Catalog.VATRates.EmptyRef)
		ELSE ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))
	END AS VATRate,
	CatalogProducts.ItemsType AS ItemsType,
	CatalogProducts.ProductCategory AS ProductCategory
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&amp;Period, Country = &amp;Country) AS ProductsVATRates
		ON CatalogProducts.Ref = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&amp;Period, Country = &amp;Country) AS BasicVATRates
		ON (TRUE)
		LEFT JOIN InformationRegister.ExcisableGoodsCategories.SliceLast(&amp;Period, &amp;UseExcisableGoods AND Country = &amp;Country) AS ExcisableGoodsCategories
		ON CatalogProducts.Ref = ExcisableGoodsCategories.Products</queryText>
      <mainTable>Catalog.Products</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
