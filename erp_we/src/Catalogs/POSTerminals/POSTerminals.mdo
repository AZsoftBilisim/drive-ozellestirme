  <attributes uuid="96ecc904-af11-4c9b-83f6-a6ce98e2753d">
    <name>EnableCreatingCashIssueWithoutPaymentRequest</name>
    <synonym>
      <key>en</key>
      <value>Allow payments without specifying payment requests</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>اجازه پرداخت بدون تعیین درخواست پرداخت</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Consentire pagamenti senza indicazione di richieste per la spesa</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Zezwalaj na płatności bez określania wniosków do wydawania środków pieniężnych</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Разрешить платежи без указания заявок на расходование денежных средств</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Ödeme talebi belirtmeden ödemelere izin ver</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cho phép thanh toán mà không cần có giấy đề nghị thanh toán</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Allows refund to customer without the &quot;Payment request&quot; document</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>امکان بازپرداخت به مشتری بدون سند «درخواست پرداخت» را فراهم می‌کند</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Consente la restituzione di pagamento al cliente senza il documento &quot;Richiesta per la spesa&quot;</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Zezwalaj na zwrot płatności dla klientów bez dokumentu &quot;Wniosek o wydatkowanie środków pieniężnych&quot;</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Разрешает возврат оплаты клиенту без документа &quot;Заявка на расходование денежных средств&quot;</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>&quot;Ödeme talebi&quot; belgesi olmadan müşteriye ödeme iadesi yapılmasına izin verir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Cho phép trả lại tiền cho khách mà không cần &quot;Giấy đề nghị thanh toán&quot;</value>
    </toolTip>
