  <attributes uuid="de88afeb-0be5-46fe-8f7c-14bd2236035a">
    <name>CriteriaOfApplicationLimitationForSalesVolume</name>
    <synonym>
      <key>en</key>
      <value>Criteria of application limitation for sales volume</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>معیار محدودیت اعمال بر اساس حجم فروش</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Criterio di limitazione dell'utilizzo per le vendite cumulative</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Kryterium ograniczenia zastosowania za wolumen sprzedaży</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Критерий ограничения применения за объем продаж</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Satış hacmi için uygulama kısıtlamasının kriterleri</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Tiêu chí hạn chế áp dụng cho khối lượng bán hàng</value>
    </synonym>
