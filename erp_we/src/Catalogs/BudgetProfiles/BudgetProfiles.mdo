  <attributes uuid="55e5caa5-451e-495b-95b4-3c15460fa072">
    <name>SaveBudgetInTabularFormToBudgetEntryForm</name>
    <synonym>
      <key>en</key>
      <value>Save the budget in table in the Budget entry form</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>ذخیره بودجه در جدول در فرم ورود بودجه</value>
    </synonym>
