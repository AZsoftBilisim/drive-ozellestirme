		<field xsi:type="DataSetFieldField">
			<dataPath>Parent</dataPath>
			<field>Parent</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Parent</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>والد</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Genitore</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Rodzic</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Родитель</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Üst öğe</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Lớp trên</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;Parent AS Parent,
	Groups.Ref
FROM
	Catalog.FinancialReportItems AS Groups
WHERE
	Groups.Owner = &amp;BudgetProfile
	AND Groups.Parent IN HIERARCHY(&amp;Parent)
	AND (Groups.Parent.ItemKind &lt;&gt; &amp;BudgetFlowItem
			OR NOT Groups.Ref IN
					(SELECT
						Catalog.Operand
					FROM
						Catalog.FinancialReportItems.FormulaOperands AS Catalog
					WHERE
						Catalog.Ref = &amp;Parent))</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Groups</sourceDataSet>
		<destinationDataSet>SubordinateItems</destinationDataSet>
		<sourceExpression>Parent</sourceExpression>
		<destinationExpression>Parent</destinationExpression>
		<parameter>Parent</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
