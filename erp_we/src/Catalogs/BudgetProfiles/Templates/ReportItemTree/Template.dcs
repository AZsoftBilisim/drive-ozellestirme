	<calculatedField>
		<dataPath>PresentationIsForPrintingOnly</dataPath>
		<expression>Case FinancialReportingServer.ValueOfAdditionalProps(ReportItem, &amp;OnlyForPrinting, &amp;AttributeCache)
	When 1
		Then NStr("ru = 'Не выводится при заполнении бюджета'; vi = 'Không hiển thị khi điền ngân sách'; en = 'Not displayed while populating the budget'; it = 'Non dedotto durante la compilazione del budget'; pl = 'Nie jest pokazywany podczas wypełniania budżetu'; tr = 'Bütçenin doldurulması durumunda gösterme'")
	When 2
		Then NStr("ru = 'Выводится только при заполнении бюджета'; vi = 'Chỉ hiển thị khi điền ngân sách'; en = 'Displayed only when filling budget'; it = 'Выводится только при заполнении бюджета'; pl = 'Displayed only when filling budget'; tr = 'Sadece bütçe doldurulduğunda görüntülenir'")
	Else ""
End</expression>
		<title xsi:type="v8:LocalStringType">
