		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	FinancialReportItems.Ref AS ReportItem,
	FinancialReportItems.ItemKind AS ItemKind,
	FinancialReportItems.NameForPrinting AS Description,
	FinancialReportItems.Comment AS Comment,
	FinancialReportItems.ReverseSign AS ReverseSign,
	"" AS AddressOfItemStructure,
	FinancialReportItems.HasSettings,
	FinancialReportItems.Parent,
	"" AS ItemIndicatorDimensionType,
	FinancialReportItems.DimensionValue AS DimensionValue,
	ArticleDetails_1.Value AS ValueBudgetItem
FROM
	Catalog.FinancialReportItems AS FinancialReportItems
		LEFT JOIN Catalog.FinancialReportItems.ItemKindAttributes AS ArticleDetails_1
		ON (ArticleDetails_1.Ref = FinancialReportItems.Ref)
			AND (ArticleDetails_1.Attribute = &amp;AttributeBudgetItem)
WHERE
	FinancialReportItems.Owner = &amp;ReportKind
	AND FinancialReportItems.Parent IN(&amp;Parents)
	AND (&amp;DisplayComplexTableItems
			OR NOT FinancialReportItems.Ref IN
					(SELECT
						Catalog.Operand
					FROM
						Catalog.FinancialReportItems.FormulaOperands AS Catalog
					WHERE
						Catalog.Ref.Owner = &amp;ReportKind
		
					UNION ALL
		
					SELECT
						Catalog.Item
					FROM
						Catalog.FinancialReportItems.TableItems AS Catalog
					WHERE
						Catalog.Ref.Owner = &amp;ReportKind))

ORDER BY
	FinancialReportItems.Code</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>ReportItems</sourceDataSet>
		<destinationDataSet>ReportItems</destinationDataSet>
		<sourceExpression>ReportItem</sourceExpression>
		<destinationExpression>Parent</destinationExpression>
		<parameter>Parents</parameter>
		<parameterListAllowed>false</parameterListAllowed>
		<startExpression>Value(Catalog.FinancialReportItems.EmptyRef)</startExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>CustomPicture</dataPath>
		<expression>FinancialReportingCached.CustomPicture(ItemKind, 
	Case 
		When ItemKind = &amp;Rows And Parent.ItemKind = &amp;TableIndicatorsInRows 
			Then "Return" 
		When ItemKind = &amp;Columns And Parent.ItemKind = &amp;TableIndicatorsInColumns 
			Then "Return" 
		When ItemKind = &amp;BudgetFlowItem And ValueType(ValueBudgetItem) = Type("Catalog.BudgetBalanceItems")
			Then "SpecialPurpose" 
	End)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Custom picture</v8:content>
			</v8:item>
			<v8:item>
