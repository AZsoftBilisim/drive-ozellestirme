    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BudgetProfiles.Ref,
	BudgetProfiles.DataVersion,
	BudgetProfiles.DeletionMark,
	BudgetProfiles.Predefined,
	BudgetProfiles.Parent,
	BudgetProfiles.IsFolder,
	BudgetProfiles.Description,
	CASE
		WHEN BudgetProfiles.IsFolder
			THEN 2
		ELSE 1
	END AS CustomPicture,
	BudgetProfiles.Comment,
	BudgetProfiles.Owner,
	BudgetProfiles.UseToEnterPlan,
	BudgetProfiles.AccessGroup,
	CASE WHEN BudgetProfiles.HasPrivilegedAccess THEN 0 ELSE 1 END AS PrivilegedAccessImage
FROM
	Catalog.BudgetProfiles AS BudgetProfiles</queryText>
      <mainTable>Catalog.BudgetProfiles</mainTable>
