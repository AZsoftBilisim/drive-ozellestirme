  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BatchAccountingPolicies.Ref AS Ref,
	BatchAccountingPolicies.DeletionMark AS DeletionMark,
	BatchAccountingPolicies.Description AS Description,
	BatchAccountingPolicies.ForProduction AS ForProduction,
	BatchAccountingPolicies.ForWarehouse AS ForWarehouse,
	BatchAccountingPolicies.LongDesc AS LongDesc,
	BatchAccountingPolicies.PolicyType AS PolicyType,
	BatchAccountingPolicies.SpecifyDuringProduction AS SpecifyDuringProduction,
	BatchAccountingPolicies.SpecifyOnMaterialConsumption AS SpecifyOnMaterialConsumption,
	BatchAccountingPolicies.SpecifyByPickingResult AS SpecifyByPickingResult,
	BatchAccountingPolicies.SpecifyOnReturnToWarehouse AS SpecifyOnReturnToWarehouse,
	BatchAccountingPolicies.SpecifyOnReturnOfGoodsNotAcceptedByRecipient AS SpecifyOnReturnOfGoodsNotAcceptedByRecipient,
	BatchAccountingPolicies.SpecifyOnProductionIssueToBusinessUnit AS SpecifyOnProductionIssueToBusinessUnit,
	BatchAccountingPolicies.SpecifyWhenMovingMaterials AS SpecifyWhenMovingMaterials,
	BatchAccountingPolicies.SpecifyWhenMovingProducts AS SpecifyWhenMovingProducts,
	BatchAccountingPolicies.SpecifyOnGoodsMarkingForSPMS AS SpecifyOnGoodsMarkingForSPMS,
	BatchAccountingPolicies.SpecifyOnShipment AS SpecifyOnShipment,
	BatchAccountingPolicies.SpecifyOnRetailShipment AS SpecifyOnRetailShipment,
	BatchAccountingPolicies.SpecifyOnShipmentToCustomer AS SpecifyOnShipmentToCustomer,
	BatchAccountingPolicies.SpecifyWhenShippingKitsForDisassembly AS SpecifyWhenShippingKitsForDisassembly,
	BatchAccountingPolicies.SpecifyWhenShippingComponentsForAssembly AS SpecifyWhenShippingComponentsForAssembly,
	BatchAccountingPolicies.SpecifyOnShipmentForInternalNeeds AS SpecifyOnShipmentForInternalNeeds,
	BatchAccountingPolicies.SpecifyOnShipmentByReturnToVendor AS SpecifyOnShipmentByReturnToVendor,
	BatchAccountingPolicies.SpecifyOnShipmentByTransfer AS SpecifyOnShipmentByTransfer,
	BatchAccountingPolicies.SpecifyUponAllocatingCostsToProductionLots AS SpecifyUponAllocatingCostsToProductionLots,
	BatchAccountingPolicies.SpecifyWhenRecordingSurpluses AS SpecifyWhenRecordingSurpluses,
	BatchAccountingPolicies.SpecifyWhenRecordingShortages AS SpecifyWhenRecordingShortages,
	BatchAccountingPolicies.SpecifyUponTransferBetweenWarerooms AS SpecifyUponTransferBetweenWarerooms,
	BatchAccountingPolicies.SpecifyWhenRecountingInventory AS SpecifyWhenRecountingInventory,
	BatchAccountingPolicies.SpecifyWhenPlanningPicking AS SpecifyWhenPlanningPicking,
	BatchAccountingPolicies.SpecifyWhenPlanningShipment AS SpecifyWhenPlanningShipment,
	BatchAccountingPolicies.SpecifyWhenReceivingMaterials AS SpecifyWhenReceivingMaterials,
	BatchAccountingPolicies.SpecifyOnReceiving AS SpecifyOnReceiving,
	BatchAccountingPolicies.SpecifyWhenReceivingComponentsAfterDisassembly AS SpecifyWhenReceivingComponentsAfterDisassembly,
	BatchAccountingPolicies.SpecifyOnReceivingFromVendor AS SpecifyOnReceivingFromVendor,
	BatchAccountingPolicies.SpecifyOnReceivingByReturnFromCustomer AS SpecifyOnReceivingByReturnFromCustomer,
	BatchAccountingPolicies.SpecifyOnReceivingByTransfer AS SpecifyOnReceivingByTransfer,
	BatchAccountingPolicies.SpecifyOnReceivingByOtherRecordingAsReceived AS SpecifyOnReceivingByOtherRecordingAsReceived,
	BatchAccountingPolicies.SpecifyWhenReceivingProductsFromManufacturing AS SpecifyWhenReceivingProductsFromManufacturing,
	BatchAccountingPolicies.SpecifyWhenReceivingAssembledKits AS SpecifyWhenReceivingAssembledKits,
	BatchAccountingPolicies.BatchesAccountingInUninvoicedGoodsDeliveries AS BatchesAccountingInUninvoicedGoodsDeliveries,
	BatchAccountingPolicies.BatchesAccountingByFEFO AS BatchesAccountingByFEFO,
	BatchAccountingPolicies.BatchesAccountingOfGoodsInTransitFromVendor AS BatchesAccountingOfGoodsInTransitFromVendor,
