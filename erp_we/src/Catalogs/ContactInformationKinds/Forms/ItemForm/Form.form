      <items xsi:type="form:FormField">
        <name>AllowMultipleValueInput</name>
        <id>80</id>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <dataPath xsi:type="form:DataPath">
          <segments>Object.AllowMultipleValueInput</segments>
        </dataPath>
        <titleLocation>Right</titleLocation>
        <toolTip>
          <key>en</key>
          <value>Allow users to enter multiple values of the same contact information kind.</value>
        </toolTip>
        <toolTip>
          <key>fa</key>
          <value>اجازه دهید کاربران چند مقدار از یک نوع اطلاعات تماس وارد کنند.</value>
        </toolTip>
        <toolTip>
          <key>it</key>
          <value>Permetti l'inserimento di diversi valori dello stesso tipo</value>
        </toolTip>
        <toolTip>
          <key>pl</key>
          <value>Zezwól na wprowadzenie kilku wartości jednego rodzaju</value>
        </toolTip>
        <toolTip>
          <key>ru</key>
          <value>Разрешить ввод нескольких значений одного вида</value>
        </toolTip>
        <toolTip>
          <key>tr</key>
