    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>ClearAllIetmsCommand</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
  </formCommands>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
