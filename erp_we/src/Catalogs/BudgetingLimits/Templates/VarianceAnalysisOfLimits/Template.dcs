			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okresowość limitu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Периодичность лимита</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Limitin sıklığı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Tính định kỳ hạn mức</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:EnumRef.Periodicity</v8:Type>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>SumReal</dataPath>
		<expression>IsNull(Sum(SumReal), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>SumPlan</dataPath>
		<expression>IsNull(Sum(SumPlan), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>ExcessAmount</dataPath>
		<expression>Case 
 When IsNull(Sum(SumPlan), 0) &lt; IsNull(Sum(SumReal), 0)
  Then IsNull(Sum(SumReal), 0) - IsNull(Sum(SumPlan), 0)
 Else 0 
End</expression>
	</totalField>
	<totalField>
		<dataPath>PutIntoReportResult</dataPath>
		<expression>Case When Not &amp;FilterByRequest Then True Else Max(InTheInitialRequest) End</expression>
	</totalField>
