				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đối tượng phân tích6 kế hoạch</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:TypeSet xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:Characteristic.BudgetFlowItemDimensions</v8:TypeSet>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// Attention! THERE ARE COMMENTS CRITICAL TO THE WORK

SELECT
    &amp;BeginOfPeriod AS PeriodStartPlan,
    &amp;EndOfPeriod AS EndPeriodPlan,
    
    PlanTable_.BudgetFlowItem AS BudgetItemPlan,
    
    &amp;ByScenarios AS ByPlanScenarios,
    &amp;ByCompanies AS ByPlanCompanies,
    &amp;ByBusinessUnits AS ByPlanDepartments,
    
    &amp;DimensionKind1 AS DimensionKind1Plan,
    &amp;DimensionKind2 AS DimensionKind2Plan,
    &amp;DimensionKind3 AS DimensionKind3Plan,
    &amp;DimensionKind4 AS DimensionKind4Plan,
    &amp;DimensionKind5 AS DimensionKind5Plan,
    &amp;DimensionKind6 AS DimensionKind6Plan,
    
    // If a specific scenario is not set in the limit control rule, then data for all scenarios is used 
    CASE
        WHEN NOT &amp;ByScenarios
            THEN VALUE(Catalog.BudgetingScenarios.EmptyRef)
        ELSE PlanTable_.Scenario
    END AS ScenarioPlan,
    
    CASE
        WHEN NOT &amp;ByCompanies
            THEN VALUE(Catalog.Companies.EmptyRef)
        ELSE PlanTable_.Organization
    END AS CompanyPlan,
    
    CASE
        WHEN NOT &amp;ByBusinessUnits
            THEN VALUE(Catalog.BusinessStructure.EmptyRef)
        ELSE PlanTable_.Department
    END AS DepartmentPlan,
    
    CASE
        WHEN &amp;DimensionKind1 = UNDEFINED
            THEN UNDEFINED
        ELSE PlanTable_.Dimension1
    END AS Dimension1Plan,
    
    CASE
        WHEN &amp;DimensionKind2 = UNDEFINED
            THEN UNDEFINED
        ELSE PlanTable_.Dimension2
    END AS Dimension2Plan,
    
    CASE
        WHEN &amp;DimensionKind3 = UNDEFINED
            THEN UNDEFINED
        ELSE PlanTable_.Dimension3
    END AS Dimension3Plan,
    
    CASE
        WHEN &amp;DimensionKind4 = UNDEFINED
            THEN UNDEFINED
        ELSE PlanTable_.Dimension4
    END AS Dimension4Plan,
    
    CASE
        WHEN &amp;DimensionKind5 = UNDEFINED
            THEN UNDEFINED
        ELSE PlanTable_.Dimension5
    END AS Dimension5Plan,
    
    CASE
        WHEN &amp;DimensionKind6 = UNDEFINED
            THEN UNDEFINED
        ELSE PlanTable_.Dimension6
    END AS Dimension6Plan,
    
    PlanTable_.Currency AS CurrencyPlan,
    
    //LoggerFieldExpressionForDecryption
    
    PlanTable_.AmountInCurrencyTurnover AS SumPlan
    
{SELECT
    PeriodStartPlan,
    EndPeriodPlan,
    
    BudgetItemPlan,
    
    ByPlanScenarios,
    ByPlanCompanies,
    ByPlanDepartments,
    
    DimensionKind1Plan,
    DimensionKind2Plan,
    DimensionKind3Plan,
    DimensionKind4Plan,
    DimensionKind5Plan,
    DimensionKind6Plan,
    
    ScenarioPlan.*,
    CompanyPlan.*,
    DepartmentPlan.*,
    
    Dimension1Plan.*,
    Dimension2Plan.*,
    Dimension3Plan.*,
    Dimension4Plan.*,
    Dimension5Plan.*,
    Dimension6Plan.*,
    
    CurrencyPlan,
    
    //LoggerFieldForDecryption
    
    SumPlan}
FROM
    AccumulationRegister.BudgetTurnovers.Turnovers(
            {(&amp;DateEmpty)},
            {(&amp;DateEmpty)},
            //FrequencyLoggerForDecryption
            ,
            PlanningPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
                AND Status = &amp;Status
                AND BudgetFlowItem = &amp;BudgetFlowItem
                AND (Scenario = &amp;Scenario OR NOT &amp;ByScenarios)
            ) AS PlanTable_
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
