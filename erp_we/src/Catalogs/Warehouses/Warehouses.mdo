  <listPresentation>
    <key>en</key>
    <value>Warehouses and stores</value>
  </listPresentation>
  <listPresentation>
    <key>fa</key>
    <value>انبارها و فروشگاه‌ها</value>
  </listPresentation>
  <listPresentation>
    <key>it</key>
