  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       Warehouses.Ref, 
       Warehouses.DeletionMark, 
       Warehouses.Parent, 
       Warehouses.IsFolder, 
       Warehouses.Description, 
       Warehouses.SelectGroup, 
       Warehouses.UseBinLocationWarehousing, 
       Warehouses.UseBinLocationWarehousingForInformation, 
       Warehouses.UseWarehouseManagemantSystemForGoodsIssue, 
       Warehouses.UseWarehouseManagemantSystemForGoodsSurplusesShortages, 
       Warehouses.UseWarehouseManagemantSystemForGoodsReceipt, 
       Warehouses.UseItemsBatch, 
       Warehouses.UseWarerooms, 
       Warehouses.Calendar, 
       Warehouses.RealTimeStockControl, 
       Warehouses.CustomizeBinLocationWarehousing, 
       Warehouses.Department, 
       Warehouses.BusinessRegion, 
       Warehouses.RetailPriceType, 
       Warehouses.CurrentPositionOfTheResponsiblePerson, 
       Warehouses.CurrentEmployeeInChargeTypes, 
       Warehouses.WarehouseStore, 
       Warehouses.ServiceLevel, 
       Warehouses.AccountingPriceType, 
       Warehouses.StartShipmentOnceDeliveryOrderIsCreated, 
       Warehouses.WarehouseZoneUsage, 
       Warehouses.SourseOfInformationAboutPricesForPrinting, 
       Warehouses.UseGoodsIssueNoteStatuses, 
       Warehouses.UseGoodsReceiptNoteStatuses, 
       Warehouses.UseInventoryRecountStatuses, 
       Warehouses.StartDateOfWarehouseManagemantSystemForGoodsIssue, 
       Warehouses.StartDateOfWarehouseManagemantSystemForGoodsReceipt, 
       Warehouses.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages, 
       Warehouses.StartDateOfWareroomUse, 
       Warehouses.StartDateOfUsingWarehouseBinSystem, 
       Warehouses.UseCostAccountingByBatches, 
       Warehouses.AvailableStockControl, 
       Warehouses.CustodyWarehouse, 
       Warehouses.DepositoryKind, 
       Warehouses.Depository, 
       Warehouses.CustodyPeriod, 
       Warehouses.CustodyUntilCalledFor, 
       Warehouses.SpecialNotes, 
       Warehouses.GoodsStorageConditions, 
       Warehouses.ShopFloorStockroom, 
       Warehouses.StoreSupportsOrderAssembly, 
       Warehouses.StoreSupportsDeliveryByOwnCouriers, 
       Warehouses.MethodOfSalesCreatingWhenAssemblingOrders, 
       Warehouses.MethodOfFiscalizationUponDelivery, 
       Warehouses.AssemblyAndDeliveryIsDoneBySameEmployee, 
       Warehouses.CouriersCanAssignOrdersToThemselves, 
       Warehouses.PickersCanAssignJobsToThemselves, 
       Warehouses.StandardOrderDeliveryTime, 
       Warehouses.CouriersUsePOSTerminals, 
       Warehouses.CouriersUseAutonomousCREs, 
       Warehouses.OrderAssemblyStartDate, 
       Warehouses.StartDateOfDeliveryByOwnCouriers, 
       Warehouses.GroupingOfGoods, 
       Warehouses.SpecialPriceType, 
       Warehouses.ContactInformation.*, 
       Warehouses.AdditionalAttributes.*, 
       Warehouses.Predefined, 
       Warehouses.PredefinedDataName, 
       Warehouses.DescriptionLanguage1, 
       Warehouses.DescriptionLanguage2
 FROM 
       Catalog.Warehouses
 AS 
       Warehouses</queryText>
      <mainTable>Catalog.Warehouses</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
