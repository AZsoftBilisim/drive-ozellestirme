                      <presentation>
                        <key>en</key>
                        <value>Pick goods according to the delivery procedure</value>
                      </presentation>
                      <presentation>
                        <key>fa</key>
                        <value>برداشت کالا طبق رویه تحویل</value>
                      </presentation>
                      <presentation>
                        <key>it</key>
                        <value>Raccogliere le merci nell'ordine di consegna</value>
