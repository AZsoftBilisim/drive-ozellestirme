              </handlers>
              <extendedTooltip>
                <name>WarehouseTypeWholesaleExtendedTooltip</name>
                <id>216</id>
                <title>
                  <key>en</key>
                  <value>Enable this option to register wholesale operations.</value>
                </title>
                <title>
                  <key>fa</key>
                  <value>این گزینه را برای ثبت عملیات عمده‌فروشی فعال کنید.</value>
                </title>
                <title>
                  <key>it</key>
                  <value>È possibile formalizzare le operazioni delle vendite all'ingrosso.</value>
                </title>
                <title>
                  <key>pl</key>
                  <value>Jest możliwe sporządzenie operacji sprzedaży hurtowej.</value>
                </title>
                <title>
                  <key>ru</key>
                  <value>Возможно оформление операций оптовой продажи.</value>
                </title>
                <title>
                  <key>tr</key>
                  <value>Toptan satış işlemlerinin yapılması mümkündür.</value>
                </title>
                <title>
                  <key>vi</key>
                  <value>Có thể tạo giao dịch bán buôn.</value>
                </title>
                <type>Label</type>
                <autoMaxHeight>true</autoMaxHeight>
                <extInfo xsi:type="form:LabelDecorationExtInfo">
                  <horizontalAlign>Left</horizontalAlign>
                </extInfo>
              </extendedTooltip>
              <contextMenu>
                <name>WarehouseTypeWholesaleContextMenu</name>
                <id>20</id>
                <autoFill>true</autoFill>
              </contextMenu>
              <type>RadioButtonField</type>
              <editMode>Enter</editMode>
              <showInHeader>true</showInHeader>
              <headerHorizontalAlign>Left</headerHorizontalAlign>
              <showInFooter>true</showInFooter>
              <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
                <choiceList>
                  <presentation>
                    <key>en</key>
                    <value>Wholesale warehouse</value>
                  </presentation>
                  <presentation>
                    <key>fa</key>
                    <value>انبار عمده‌فروشی</value>
                  </presentation>
                  <presentation>
                    <key>it</key>
                    <value>Magazzino all'ingrosso</value>
                  </presentation>
                  <presentation>
                    <key>pl</key>
                    <value>Magazyn hurtowy</value>
                  </presentation>
                  <presentation>
                    <key>ru</key>
                    <value>Оптовый склад</value>
                  </presentation>
                  <presentation>
                    <key>tr</key>
                    <value>Toptancı ambarı</value>
                  </presentation>
                  <presentation>
                    <key>vi</key>
                    <value>Kho bán buôn</value>
                  </presentation>
