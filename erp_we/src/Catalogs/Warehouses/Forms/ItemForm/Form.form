              <items xsi:type="form:FormGroup">
                <name>DeliveryGroup</name>
                <id>148</id>
                <items xsi:type="form:FormField">
                  <name>ProcedureOfTransportationJobIndication1</name>
                  <id>370</id>
                  <visible>true</visible>
                  <enabled>true</enabled>
                  <userVisible>
                    <common>true</common>
                  </userVisible>
                  <dataPath xsi:type="form:DataPath">
                    <segments>ProcedureOfTransportationJobIndication</segments>
