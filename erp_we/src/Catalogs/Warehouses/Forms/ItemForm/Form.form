                      </presentation>
                      <presentation>
                        <key>vi</key>
                        <value>Tập hợp hàng hóa theo thứ tự giao hàng</value>
                      </presentation>
                      <value xsi:type="core:StringValue">
                        <value>AssembleGoodsAccordingToDeliveryProcedure</value>
                      </value>
                    </choiceList>
                  </extInfo>
