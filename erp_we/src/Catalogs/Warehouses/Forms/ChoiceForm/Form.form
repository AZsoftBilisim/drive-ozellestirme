  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.SelectGroup</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogWarehouses.Ref,
	CatalogWarehouses.DeletionMark,
	CatalogWarehouses.Predefined,
	CatalogWarehouses.Parent,
	CatalogWarehouses.IsFolder,
	CatalogWarehouses.Description,
	CatalogWarehouses.SelectGroup,
	CASE
		WHEN CatalogWarehouses.IsFolder
				AND NOT CatalogWarehouses.SelectGroup IN (&amp;SelectWarehouseGroup)
			THEN TRUE
		ELSE FALSE
	END AS ItIsForbiddenToChoose,
	CatalogWarehouses.UseBinLocationWarehousing,
	CatalogWarehouses.UseBinLocationWarehousingForInformation,
	CatalogWarehouses.UseWarehouseManagemantSystemForGoodsIssue,
	CatalogWarehouses.UseWarehouseManagemantSystemForGoodsSurplusesShortages,
	CatalogWarehouses.UseWarehouseManagemantSystemForGoodsReceipt,
	CatalogWarehouses.UseItemsBatch,
	CatalogWarehouses.UseWarerooms,
	CatalogWarehouses.Calendar,
	CatalogWarehouses.RealTimeStockControl,
	CatalogWarehouses.CustomizeBinLocationWarehousing,
	CatalogWarehouses.Department,
	CatalogWarehouses.RetailPriceType,
	CatalogWarehouses.CurrentPositionOfTheResponsiblePerson,
	CatalogWarehouses.CurrentEmployeeInChargeTypes,
	CatalogWarehouses.WarehouseStore,
	CatalogWarehouses.ServiceLevel,
	CatalogWarehouses.AccountingPriceType,
	CatalogWarehouses.StartShipmentOnceDeliveryOrderIsCreated,
	CatalogWarehouses.WarehouseZoneUsage,
	CatalogWarehouses.SourseOfInformationAboutPricesForPrinting,
	CatalogWarehouses.UseGoodsIssueNoteStatuses,
	CatalogWarehouses.UseGoodsReceiptNoteStatuses,
	CatalogWarehouses.StartDateOfWarehouseManagemantSystemForGoodsIssue,
	CatalogWarehouses.StartDateOfWarehouseManagemantSystemForGoodsReceipt,
	CatalogWarehouses.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages,
	CatalogWarehouses.StartDateOfWareroomUse,
	CatalogWarehouses.StartDateOfUsingWarehouseBinSystem,
	CatalogWarehouses.UseCostAccountingByBatches,
	CatalogWarehouses.AvailableStockControl,
	CatalogWarehouses.ShopFloorStockroom
FROM
	Catalog.Warehouses AS CatalogWarehouses</queryText>
