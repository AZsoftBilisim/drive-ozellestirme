      <items xsi:type="form:FormField">
        <name>Password</name>
        <id>47</id>
        <title>
          <key>en</key>
          <value>Password</value>
        </title>
        <title>
          <key>fa</key>
          <value>رمز عبور</value>
        </title>
        <title>
          <key>it</key>
          <value>Password</value>
        </title>
        <title>
          <key>pl</key>
          <value>Hasło</value>
        </title>
        <title>
          <key>ru</key>
          <value>Пароль</value>
        </title>
        <title>
          <key>tr</key>
          <value>Şifre</value>
        </title>
        <title>
          <key>vi</key>
          <value>Mật khẩu</value>
