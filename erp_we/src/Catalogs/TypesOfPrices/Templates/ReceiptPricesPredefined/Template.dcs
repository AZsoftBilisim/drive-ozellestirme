			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.PackagesAndUnitsOfMeasure</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PriceKind</dataPath>
			<field>PriceKind</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE ISNULL(Segments.Characteristic.ItemsCharacteristicForPricing,
			VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
	END AS PricingVariant,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON Segments.Products.ProductKind = ItemKinds.Ref
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	PricingVariant,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Documents.Ref AS Ref,
	Documents.PriceIncludesVAT AS PriceIncludesVAT,
	Documents.Currency AS Currency
INTO DocumentsForSelection
FROM
	Document.VendorInvoice AS Documents
WHERE
	NOT &amp;ThisIsGenerationFromBaseDocuments
	AND Documents.Posted
	AND Documents.Date &lt;= ENDOFPERIOD(&amp;DocumentDate, DAY)
	AND CASE
		WHEN &amp;AnalysisDepth &lt;&gt; 0
			THEN DATEDIFF(Documents.Date, &amp;DocumentDate, DAY) &lt;= &amp;AnalysisDepth
		ELSE TRUE
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PurchaseOfGoodsServicesGoods.Products AS Products,
	PurchaseOfGoodsServicesGoods.Characteristic AS Characteristic,
	PurchaseOfGoodsServicesGoods.Series AS Series,
	PurchaseOfGoodsServicesGoods.Package AS Package,
	MAX(PurchaseOfGoodsServicesGoods.Ref.Date) AS MaxDate
INTO TempTable_1
FROM
	Document.VendorInvoice.Goods AS PurchaseOfGoodsServicesGoods
		INNER JOIN DocumentsForSelection AS DocumentsForSelection
		ON PurchaseOfGoodsServicesGoods.Ref = DocumentsForSelection.Ref
WHERE
	&amp;PriceSelection = 4
{WHERE
	(PurchaseOfGoodsServicesGoods.Products, PurchaseOfGoodsServicesGoods.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
GROUP BY
	PurchaseOfGoodsServicesGoods.Characteristic,
	PurchaseOfGoodsServicesGoods.Products,
	PurchaseOfGoodsServicesGoods.Series,
	PurchaseOfGoodsServicesGoods.Package
INDEX BY
	Products,
	Characteristic,
	Series,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PurchaseOfGoodsServicesGoods.Products AS Products,
	PurchaseOfGoodsServicesGoods.Characteristic AS Characteristic,
	PurchaseOfGoodsServicesGoods.Series AS Series,
	PurchaseOfGoodsServicesGoods.Package AS Package,
	MAX(PurchaseOfGoodsServicesGoods.Ref) AS DocumentInflow
INTO TempTable_2
FROM
	Document.VendorInvoice.Goods AS PurchaseOfGoodsServicesGoods
		INNER JOIN TempTable_1 AS Table
		ON PurchaseOfGoodsServicesGoods.Products = Table.Products
		AND PurchaseOfGoodsServicesGoods.Characteristic = Table.Characteristic
		AND PurchaseOfGoodsServicesGoods.Ref.Date = Table.MaxDate
WHERE
	NOT &amp;ThisIsGenerationFromBaseDocuments
	AND &amp;PriceSelection = 4
	AND PurchaseOfGoodsServicesGoods.Ref.Posted
GROUP BY
	PurchaseOfGoodsServicesGoods.Characteristic,
	PurchaseOfGoodsServicesGoods.Products,
	PurchaseOfGoodsServicesGoods.Series,
	PurchaseOfGoodsServicesGoods.Package
INDEX BY
	Products,
	Characteristic,
	Series,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CAST(DocumentTable.Products AS Catalog.Products) AS Products,
	CAST(DocumentTable.PricingVariant AS Catalog.ItemsCharacteristicsForPricing) AS PricingVariant,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
		ELSE ISNULL(DocumentTable.PricingBatch, VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
	END AS PricingBatch,
	DocumentTable.PricingPackage AS PricingPackage,
	ISNULL(DocumentTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) AS VATRate,
	ISNULL(VATRates.Rate1, 0) AS Rate1
INTO DocumentDataTable
FROM
	ItemPriceSettingDataTable AS DocumentTable
	LEFT JOIN Catalog.ItemKinds AS ItemKinds
	ON CAST(DocumentTable.Products AS Catalog.Products).ProductKind = ItemKinds.Ref
	LEFT JOIN Catalog.VATRates AS VATRates
	ON DocumentTable.VATRate = VATRates.Ref
WHERE
	&amp;UseDocumentData
INDEX BY
	Products,
	PricingVariant,
	PricingBatch,
	PricingPackage
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DocumentGoods.Products AS Products,
	DocumentGoods.Characteristic AS Characteristic,
	DocumentGoods.Package AS Package,
	DocumentGoods.NumberOfPackages AS NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor2, 1) AS ZoomRatio,
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND DocumentTable.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentTable.PriceIncludesVAT
			THEN DocumentGoods.Sum / DocumentGoods.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentTable.PriceIncludesVAT
			THEN (DocumentGoods.Sum + DocumentGoods.VATAmount) / DocumentGoods.NumberOfPackages
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND DocumentTable.PriceIncludesVAT
			THEN (DocumentGoods.Sum - DocumentGoods.VATAmount) / DocumentGoods.NumberOfPackages
	END AS NUMBER(35, 6)) AS Price,
	DocumentTable.Currency AS Currency,
	DocumentGoods.Series AS Series
INTO PriceTable__Preliminary
FROM
	Document.VendorInvoice AS DocumentTable
		INNER JOIN Document.VendorInvoice.Goods AS DocumentGoods
		ON DocumentTable.Ref = DocumentGoods.Ref
		INNER JOIN TempTable_2 AS Table
		ON DocumentGoods.Products = Table.Products
		AND DocumentGoods.Characteristic = Table.Characteristic
		AND DocumentGoods.Ref = Table.DocumentInflow
		AND DocumentGoods.Series = Table.Series
		AND DocumentGoods.Package = Table.Package
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
WHERE
	NOT &amp;ThisIsGenerationFromBaseDocuments
	AND &amp;PriceSelection = 4
	AND DocumentTable.Posted
	AND DocumentGoods.NumberOfPackages &lt;&gt; 0
{WHERE
	(DocumentGoods.Products, DocumentGoods.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND DocumentsForSelection.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentsForSelection.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentsForSelection.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum + GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND DocumentsForSelection.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum - GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
	END AS NUMBER(35, 6)),
	DocumentsForSelection.Currency,
	GoodsDocumentInputBasedOn.Series
FROM
	Document.VendorInvoice.Goods AS GoodsDocumentInputBasedOn
		INNER JOIN DocumentsForSelection AS DocumentsForSelection
		ON GoodsDocumentInputBasedOn.Ref = DocumentsForSelection.Ref
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
WHERE
	NOT &amp;ThisIsGenerationFromBaseDocuments
	AND &amp;PriceSelection &lt;&gt; 4
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND DocumentTable.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentTable.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentTable.PriceIncludesVAT
			THEN CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) +
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							TypesOfPrices.VATRate.Rate1 / 100
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) +
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							DocumentDataTable.Rate1 / 100
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) +
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							ISNULL(ItemsPrices.VATRate.Rate1, 0) / 100
				ELSE (GoodsDocumentInputBasedOn.Sum + GoodsDocumentInputBasedOn.VATAmount) /
						GoodsDocumentInputBasedOn.NumberOfPackages
			END
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND DocumentTable.PriceIncludesVAT
			THEN CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) -
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							TypesOfPrices.VATRate.Rate1 / (100 + TypesOfPrices.VATRate.Rate1)
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) -
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							DocumentDataTable.Rate1 / (100 + DocumentDataTable.Rate1)
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) -
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							ISNULL(ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1), 0)
				ELSE (GoodsDocumentInputBasedOn.Sum - GoodsDocumentInputBasedOn.VATAmount) /
						GoodsDocumentInputBasedOn.NumberOfPackages
			END
	END AS NUMBER(35, 6)),
	DocumentTable.Currency,
	GoodsDocumentInputBasedOn.Series
FROM
	Document.VendorInvoice AS DocumentTable
		INNER JOIN Document.VendorInvoice.Goods AS GoodsDocumentInputBasedOn
		ON DocumentTable.Ref = GoodsDocumentInputBasedOn.Ref
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON GoodsDocumentInputBasedOn.Products.ProductKind = ItemKinds.Ref
		LEFT JOIN InformationRegister.ItemsPrices25.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			PriceKind = &amp;PriceKind {(Products, PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment AS SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}) AS ItemsPrices
		ON GoodsDocumentInputBasedOn.Products = ItemsPrices.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = ItemsPrices.PricingVariant
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		END = ItemsPrices.PricingBatch
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN GoodsDocumentInputBasedOn.Package
			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		END = ItemsPrices.Package
		LEFT JOIN DocumentDataTable AS DocumentDataTable
		ON GoodsDocumentInputBasedOn.Products = DocumentDataTable.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = DocumentDataTable.PricingVariant
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		END = DocumentDataTable.PricingBatch
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN GoodsDocumentInputBasedOn.Package
			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		END = DocumentDataTable.PricingPackage
WHERE
	&amp;ThisIsGenerationFromBaseDocuments
	AND DocumentTable.Ref = &amp;Basis
	AND DocumentTable.Posted
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND DocumentTable.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentTable.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentTable.PriceIncludesVAT
			THEN CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) +
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							TypesOfPrices.VATRate.Rate1 / 100
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) +
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							DocumentDataTable.Rate1 / 100
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) +
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							ISNULL(ItemsPrices.VATRate.Rate1, 0) / 100
				ELSE (GoodsDocumentInputBasedOn.Sum + GoodsDocumentInputBasedOn.VATAmount) /
						GoodsDocumentInputBasedOn.NumberOfPackages
			END
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND DocumentTable.PriceIncludesVAT
			THEN CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) -
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							TypesOfPrices.VATRate.Rate1 / (100 + TypesOfPrices.VATRate.Rate1)
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) -
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							DocumentDataTable.Rate1 / (100 + DocumentDataTable.Rate1)
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN (GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) -
						(GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages) *
							ISNULL(ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1), 0)
				ELSE (GoodsDocumentInputBasedOn.Sum - GoodsDocumentInputBasedOn.VATAmount) /
						GoodsDocumentInputBasedOn.NumberOfPackages
			END
	END AS NUMBER(35, 6)),
	DocumentTable.Currency,
	VALUE(Catalog.ItemsBatches.EmptyRef)
FROM
	Document.PurchaseOrder AS DocumentTable
		INNER JOIN Document.PurchaseOrder.Goods AS GoodsDocumentInputBasedOn
		ON DocumentTable.Ref = GoodsDocumentInputBasedOn.Ref
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON GoodsDocumentInputBasedOn.Products.ProductKind = ItemKinds.Ref
		LEFT JOIN InformationRegister.ItemsPrices25.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			PriceKind = &amp;PriceKind {(Products, PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment AS SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}) AS ItemsPrices
		ON GoodsDocumentInputBasedOn.Products = ItemsPrices.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = ItemsPrices.PricingVariant
		AND VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_) = ItemsPrices.PricingBatch
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN GoodsDocumentInputBasedOn.Package
			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		END = ItemsPrices.Package
		LEFT JOIN DocumentDataTable AS DocumentDataTable
		ON GoodsDocumentInputBasedOn.Products = DocumentDataTable.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = DocumentDataTable.PricingVariant
		AND VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_) = DocumentDataTable.PricingBatch
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN GoodsDocumentInputBasedOn.Package
			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		END = DocumentDataTable.PricingPackage
WHERE
	&amp;ThisIsGenerationFromBaseDocuments
	AND DocumentTable.Ref = &amp;Basis
	AND DocumentTable.Posted
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	DocumentGoods.ProductsRecordingAsReceived,
	DocumentGoods.CharacteristicRecordingAsReceived,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	DocumentGoods.Count,
	1,
	CAST(CASE
		WHEN NOT ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN DocumentGoods.Price
		WHEN ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN DocumentGoods.Price
		WHEN ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN DocumentGoods.Price - DocumentGoods.Price * CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN TypesOfPrices.VATRate.Rate1 / (100 + TypesOfPrices.VATRate.Rate1)
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN DocumentDataTable.Rate1 / (100 + DocumentDataTable.Rate1)
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN ISNULL(ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1), 0)
				ELSE (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
					VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / (100 + (ISNULL(ProductsVATRates.VATRate,
					ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1)
			END
		WHEN NOT ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN DocumentGoods.Price + DocumentGoods.Price * CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN TypesOfPrices.VATRate.Rate1 / 100
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN DocumentDataTable.Rate1 / 100
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN ISNULL(ItemsPrices.VATRate.Rate1, 0) / 100
				ELSE (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
					VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100
			END
	END AS NUMBER(35, 6)),
	Constants.Value,
	DocumentGoods.Series
FROM
	Document.GoodsDamage AS DocumentTable
		INNER JOIN Document.GoodsDamage.Goods AS DocumentGoods
		ON DocumentTable.Ref = DocumentGoods.Ref
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
		INNER JOIN Constant.ManagementAccountingCurrency AS Constants
		ON TRUE
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS ProductsVATRates
		ON DocumentGoods.Products = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS BasicVATRates
		ON TRUE
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON DocumentGoods.ProductsRecordingAsReceived.ProductKind = ItemKinds.Ref
		LEFT JOIN InformationRegister.ItemsPrices25.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			PriceKind = &amp;PriceKind {(Products, PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment AS SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}) AS ItemsPrices
		ON DocumentGoods.ProductsRecordingAsReceived = ItemsPrices.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(DocumentGoods.CharacteristicRecordingAsReceived.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = ItemsPrices.PricingVariant
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
			ELSE ISNULL(DocumentGoods.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		END = ItemsPrices.PricingBatch
		LEFT JOIN DocumentDataTable AS DocumentDataTable
		ON DocumentGoods.ProductsRecordingAsReceived = DocumentDataTable.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(DocumentGoods.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = DocumentDataTable.PricingVariant
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
			ELSE ISNULL(DocumentGoods.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		END = DocumentDataTable.PricingBatch
WHERE
	&amp;ThisIsGenerationFromBaseDocuments
	AND DocumentTable.Ref = &amp;Basis
	AND DocumentTable.Posted
	AND DocumentGoods.Count &lt;&gt; 0
{WHERE
	(DocumentGoods.ProductsRecordingAsReceived, DocumentGoods.CharacteristicRecordingAsReceived) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN NOT ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price
		WHEN ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price
		WHEN ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price - GoodsDocumentInputBasedOn.Price * CASE
				WHEN 
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN TypesOfPrices.VATRate.Rate1 / (100 + TypesOfPrices.VATRate.Rate1)

				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN DocumentDataTable.Rate1 / (100 + DocumentDataTable.Rate1)
				
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN ISNULL(ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1), 0)
					
				ELSE (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
					VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / (100 + (ISNULL(ProductsVATRates.VATRate,
					ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1)
			END
		WHEN NOT ISNULL(DocumentTable.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price + GoodsDocumentInputBasedOn.Price * CASE
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
					THEN TypesOfPrices.VATRate.Rate1 / 100
				WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					AND ISNULL(DocumentDataTable.VATRate, VALUE(Catalog.VATRates.EmptyRef)) &lt;&gt; VALUE(Catalog.VATRates.EmptyRef)
					THEN DocumentDataTable.Rate1 / 100
				WHEN
					TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
					THEN ISNULL(ItemsPrices.VATRate.Rate1 / 100, 0)
				ELSE (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
					VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100
			END
	END AS NUMBER(35, 6)),
	Constants.Value,
	GoodsDocumentInputBasedOn.Series
FROM
	Document.OtherGoodsRecordingAsReceived AS DocumentTable
		INNER JOIN Document.OtherGoodsRecordingAsReceived.Goods AS GoodsDocumentInputBasedOn
		ON DocumentTable.Ref = GoodsDocumentInputBasedOn.Ref
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
		INNER JOIN Constant.ManagementAccountingCurrency AS Constants
		ON TRUE
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS ProductsVATRates
		ON GoodsDocumentInputBasedOn.Products = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS BasicVATRates
		ON TRUE
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON GoodsDocumentInputBasedOn.Products.ProductKind = ItemKinds.Ref
		LEFT JOIN InformationRegister.ItemsPrices25.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			PriceKind = &amp;PriceKind {(Products, PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment AS SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}) AS ItemsPrices
		ON GoodsDocumentInputBasedOn.Products = ItemsPrices.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = ItemsPrices.PricingVariant
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		END = ItemsPrices.PricingBatch
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN GoodsDocumentInputBasedOn.Package
			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		END = ItemsPrices.Package
		LEFT JOIN DocumentDataTable AS DocumentDataTable
		ON GoodsDocumentInputBasedOn.Products = DocumentDataTable.Products
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Characteristic.ItemsCharacteristicForPricing,
				VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = DocumentDataTable.PricingVariant
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
			ELSE ISNULL(GoodsDocumentInputBasedOn.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		END = DocumentDataTable.PricingBatch
		AND CASE
			WHEN
				ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN GoodsDocumentInputBasedOn.Package
			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		END = DocumentDataTable.PricingPackage
WHERE
	&amp;ThisIsGenerationFromBaseDocuments
	AND DocumentTable.Ref = &amp;Basis
	AND DocumentTable.Posted
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	PriceTable__.Currency AS Currency,
	PriceTable__.Series AS Series,
	PriceTable__.Package AS Package,
	PriceTable__.ZoomRatio AS ZoomRatio,
	PriceTable__.NumberOfPackages AS NumberOfPackages,
	PriceTable__.Price AS Price,
	CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN PriceTable__.Characteristic.ItemsCharacteristicForPricing
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END AS PricingVariant,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN ISNULL(PriceTable__.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyRef))
		ELSE VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
	END AS TSOSeriesForCommunication,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN ISNULL(PriceTable__.Series.ItemsBatchForPricing,
				VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_))
		ELSE VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_)
	END AS PricingBatch,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN PriceTable__.Package
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS TsoPackagingForCommunication,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN CASE
				WHEN PriceTable__.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
					THEN PriceTable__.Products.UnitOfMeasure
				ELSE PriceTable__.Package
			END
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS PricingPackage
INTO PriceTable__
FROM
	PriceTable__Preliminary AS PriceTable__
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON PriceTable__.Products.ProductKind = ItemKinds.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Products AS Products,
	PriceTable__.PricingVariant AS PricingVariant,
	MAX(CAST(PriceTable__.Price / PriceTable__.ZoomRatio AS NUMBER(35, 6))) AS MaximumPricePerUnit,
	MIN(CAST(PriceTable__.Price / PriceTable__.ZoomRatio AS NUMBER(35, 6))) AS MinimumPricePerUnit,
	SUM(PriceTable__.Price * PriceTable__.NumberOfPackages) / SUM(PriceTable__.NumberOfPackages *
		PriceTable__.ZoomRatio) AS AveragePricePerUnit,
	PriceTable__.Currency AS Currency,
	PriceTable__.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	PriceTable__.TsoPackagingForCommunication AS TsoPackagingForCommunication
INTO MinMaxAveragePrices
FROM
	PriceTable__ AS PriceTable__
GROUP BY
	PriceTable__.Products,
	PriceTable__.PricingVariant,
	PriceTable__.Currency,
	PriceTable__.TSOSeriesForCommunication,
	PriceTable__.TsoPackagingForCommunication
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Products AS Products,
	PriceTable__.PricingVariant AS PricingVariant,
	MAX(PriceTable__.ZoomRatio) AS MaxCoefficient,
	MIN(PriceTable__.ZoomRatio) AS MinFactor,
	PriceTable__.TsoPackagingForCommunication AS TsoPackagingForCommunication,
	PriceTable__.TSOSeriesForCommunication AS TSOSeriesForCommunication
INTO MinMaxCoefficients
FROM
	PriceTable__ AS PriceTable__
GROUP BY
	PriceTable__.Products,
	PriceTable__.PricingVariant,
	PriceTable__.TSOSeriesForCommunication,
	PriceTable__.TsoPackagingForCommunication
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	PriceTable__.Series AS Series,
	PriceTable__.Package AS Package,
	PriceTable__.ZoomRatio AS ZoomRatio,
	CASE
		WHEN &amp;PriceSelection = 1
		OR &amp;PriceSelection = 4
			THEN CAST(Prices.MaximumPricePerUnit * PriceTable__.ZoomRatio AS NUMBER(31, 2))
		WHEN &amp;PriceSelection = 2
			THEN CAST(Prices.MinimumPricePerUnit * PriceTable__.ZoomRatio AS NUMBER(31, 2))
		WHEN &amp;PriceSelection = 3
			THEN CAST(Prices.AveragePricePerUnit * PriceTable__.ZoomRatio AS NUMBER(31, 2))
		ELSE 0
	END AS Price,
	PriceTable__.Currency AS Currency,
	PriceTable__.PricingVariant AS PricingVariant,
	PriceTable__.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	PriceTable__.TsoPackagingForCommunication AS TsoPackagingForCommunication,
	PriceTable__.PricingBatch AS PricingBatch,
	PriceTable__.PricingPackage AS PricingPackage
FROM
	PriceTable__ AS PriceTable__
		LEFT JOIN MinMaxAveragePrices AS Prices
		ON Prices.Products = PriceTable__.Products
		AND Prices.PricingVariant = PriceTable__.PricingVariant
		AND Prices.Currency = PriceTable__.Currency
		AND Prices.TSOSeriesForCommunication = PriceTable__.TSOSeriesForCommunication
		AND Prices.TsoPackagingForCommunication = PriceTable__.TsoPackagingForCommunication
		LEFT JOIN MinMaxCoefficients AS Coefficients
		ON Coefficients.Products = PriceTable__.Products
		AND Coefficients.PricingVariant = PriceTable__.PricingVariant
		AND Coefficients.TSOSeriesForCommunication = PriceTable__.TSOSeriesForCommunication
		AND Coefficients.TsoPackagingForCommunication = PriceTable__.TsoPackagingForCommunication
WHERE
	CASE
		WHEN &amp;ChoiceOfPackaging = 1
			THEN PriceTable__.ZoomRatio = Coefficients.MaxCoefficient
		WHEN &amp;ChoiceOfPackaging = 2
			THEN PriceTable__.ZoomRatio = Coefficients.MinFactor
		ELSE FALSE
	END</query>
	</dataSet>
