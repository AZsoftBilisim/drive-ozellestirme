		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Documents.Ref AS Ref
INTO DocumentsForSelection
FROM
	Document.VendorInvoice AS Documents
WHERE
	Documents.Date &lt;= ENDOFPERIOD(&amp;DocumentDate, DAY)
	AND CASE
		WHEN &amp;AnalysisDepth &lt;&gt; 0
			THEN DATEDIFF(Documents.Date, &amp;DocumentDate, DAY) &lt;= &amp;AnalysisDepth
		ELSE TRUE
	END
	AND Documents.Posted
	AND NOT &amp;ThisIsGenerationFromBaseDocuments
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PurchaseOfGoodsServicesGoods.Products AS Products,
	PurchaseOfGoodsServicesGoods.Characteristic AS Characteristic,
	MAX(PurchaseOfGoodsServicesGoods.Ref.Date) AS MaxDate
INTO TempTable_1
FROM
	Document.VendorInvoice.Goods AS PurchaseOfGoodsServicesGoods
		INNER JOIN DocumentsForSelection AS DocumentsForSelection
		ON PurchaseOfGoodsServicesGoods.Ref = DocumentsForSelection.Ref
WHERE
	&amp;PriceSelection = 4
{WHERE
	(PurchaseOfGoodsServicesGoods.Products, PurchaseOfGoodsServicesGoods.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
GROUP BY
	PurchaseOfGoodsServicesGoods.Characteristic,
	PurchaseOfGoodsServicesGoods.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PurchaseOfGoodsServicesGoods.Products AS Products,
	PurchaseOfGoodsServicesGoods.Characteristic AS Characteristic,
	MAX(PurchaseOfGoodsServicesGoods.Ref) AS DocumentInflow
INTO TempTable_2
FROM
	Document.VendorInvoice.Goods AS PurchaseOfGoodsServicesGoods
		INNER JOIN TempTable_1 AS Table
		ON PurchaseOfGoodsServicesGoods.Products = Table.Products
		AND PurchaseOfGoodsServicesGoods.Characteristic = Table.Characteristic
		AND PurchaseOfGoodsServicesGoods.Ref.Date = Table.MaxDate
WHERE
	NOT &amp;ThisIsGenerationFromBaseDocuments
	AND &amp;PriceSelection = 4
	AND PurchaseOfGoodsServicesGoods.Ref.Posted
GROUP BY
	PurchaseOfGoodsServicesGoods.Characteristic,
	PurchaseOfGoodsServicesGoods.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DocumentGoods.Products AS Products,
	DocumentGoods.Characteristic AS Characteristic,
	DocumentGoods.Package AS Package,
	DocumentGoods.NumberOfPackages AS NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor2, 1) AS ZoomRatio,
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND DocumentGoods.Ref.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentGoods.Ref.PriceIncludesVAT
			THEN DocumentGoods.Sum / DocumentGoods.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT DocumentGoods.Ref.PriceIncludesVAT
			THEN (DocumentGoods.Sum + DocumentGoods.VATAmount) / DocumentGoods.NumberOfPackages
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND DocumentGoods.Ref.PriceIncludesVAT
			THEN (DocumentGoods.Sum - DocumentGoods.VATAmount) / DocumentGoods.NumberOfPackages
	END AS NUMBER(35, 6)) AS Price,
	DocumentGoods.Ref.Currency AS Currency
INTO PriceTable__
FROM
	Document.VendorInvoice.Goods AS DocumentGoods
		INNER JOIN TempTable_2 AS Table
		ON DocumentGoods.Products = Table.Products
		AND DocumentGoods.Characteristic = Table.Characteristic
		AND DocumentGoods.Ref = Table.DocumentInflow
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
WHERE
	NOT &amp;ThisIsGenerationFromBaseDocuments
	AND &amp;PriceSelection = 4
	AND DocumentGoods.NumberOfPackages &lt;&gt; 0
	AND DocumentGoods.Ref.Posted
{WHERE
	(DocumentGoods.Products, DocumentGoods.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum + GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum - GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
	END AS NUMBER(35, 6)),
	GoodsDocumentInputBasedOn.Ref.Currency
FROM
	Document.VendorInvoice.Goods AS GoodsDocumentInputBasedOn
		INNER JOIN DocumentsForSelection AS DocumentsForSelection
		ON GoodsDocumentInputBasedOn.Ref = DocumentsForSelection.Ref
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
WHERE
	GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
	AND NOT &amp;ThisIsGenerationFromBaseDocuments
	AND &amp;PriceSelection &lt;&gt; 4
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum + GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum - GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
	END AS NUMBER(35, 6)),
	GoodsDocumentInputBasedOn.Ref.Currency
FROM
	Document.VendorInvoice.Goods AS GoodsDocumentInputBasedOn
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
WHERE
	GoodsDocumentInputBasedOn.Ref = &amp;Basis
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
	AND GoodsDocumentInputBasedOn.Ref.Posted
	AND &amp;ThisIsGenerationFromBaseDocuments
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN TypesOfPrices.PriceIncludesVAT
		AND GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
		OR NOT TypesOfPrices.PriceIncludesVAT
		AND NOT GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Sum / GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN TypesOfPrices.PriceIncludesVAT
		AND NOT GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum + GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
		WHEN NOT TypesOfPrices.PriceIncludesVAT
		AND GoodsDocumentInputBasedOn.Ref.PriceIncludesVAT
			THEN (GoodsDocumentInputBasedOn.Sum - GoodsDocumentInputBasedOn.VATAmount) /
				GoodsDocumentInputBasedOn.NumberOfPackages
	END AS NUMBER(35, 6)),
	GoodsDocumentInputBasedOn.Ref.Currency
FROM
	Document.PurchaseOrder.Goods AS GoodsDocumentInputBasedOn
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
WHERE
	GoodsDocumentInputBasedOn.Ref = &amp;Basis
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
	AND GoodsDocumentInputBasedOn.Ref.Posted
	AND &amp;ThisIsGenerationFromBaseDocuments
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.ProductsRecordingAsReceived,
	GoodsDocumentInputBasedOn.CharacteristicRecordingAsReceived,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	GoodsDocumentInputBasedOn.Count,
	1,
	CAST(CASE
		WHEN NOT ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price
		WHEN ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price
		WHEN ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price - GoodsDocumentInputBasedOn.Price *
				((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
				VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / (100 + (ISNULL(ProductsVATRates.VATRate,
				ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1))
		WHEN NOT ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price + GoodsDocumentInputBasedOn.Price *
				((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
				VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
	END AS NUMBER(35, 6)),
	Constants.Value
FROM
	Document.GoodsDamage.Goods AS GoodsDocumentInputBasedOn
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
		INNER JOIN Constant.ManagementAccountingCurrency AS Constants
		ON TRUE
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS ProductsVATRates
		ON GoodsDocumentInputBasedOn.Products = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS BasicVATRates
		ON TRUE
WHERE
	GoodsDocumentInputBasedOn.Ref = &amp;Basis
	AND GoodsDocumentInputBasedOn.Count &lt;&gt; 0
	AND GoodsDocumentInputBasedOn.Ref.Posted
	AND &amp;ThisIsGenerationFromBaseDocuments
{WHERE
	(GoodsDocumentInputBasedOn.ProductsRecordingAsReceived,
		GoodsDocumentInputBasedOn.CharacteristicRecordingAsReceived) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	GoodsDocumentInputBasedOn.Products,
	GoodsDocumentInputBasedOn.Characteristic,
	GoodsDocumentInputBasedOn.Package,
	GoodsDocumentInputBasedOn.NumberOfPackages,
	ISNULL(&amp;QueryTextPackagingFactor3, 1),
	CAST(CASE
		WHEN NOT ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price
		WHEN ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price
		WHEN ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND NOT TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price - GoodsDocumentInputBasedOn.Price *
				((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
				VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / (100 + (ISNULL(ProductsVATRates.VATRate,
				ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1))
		WHEN NOT ISNULL(GoodsDocumentInputBasedOn.Ref.PriceKind.PriceIncludesVAT, FALSE)
		AND TypesOfPrices.PriceIncludesVAT
			THEN GoodsDocumentInputBasedOn.Price + GoodsDocumentInputBasedOn.Price *
				((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
				VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
	END AS NUMBER(35, 6)),
	Constants.Value
FROM
	Document.OtherGoodsRecordingAsReceived.Goods AS GoodsDocumentInputBasedOn
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = &amp;PriceKind
		INNER JOIN Constant.ManagementAccountingCurrency AS Constants
		ON TRUE
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS ProductsVATRates
		ON GoodsDocumentInputBasedOn.Products = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({ENDOFPERIOD(&amp;DocumentDate, DAY)},
			Country = &amp;CountryOfVATRates) AS BasicVATRates
		ON TRUE
WHERE
	GoodsDocumentInputBasedOn.Ref = &amp;Basis
	AND GoodsDocumentInputBasedOn.NumberOfPackages &lt;&gt; 0
	AND GoodsDocumentInputBasedOn.Ref.Posted
	AND &amp;ThisIsGenerationFromBaseDocuments
{WHERE
	(GoodsDocumentInputBasedOn.Products, GoodsDocumentInputBasedOn.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	MAX(CAST(PriceTable__.Price / PriceTable__.ZoomRatio AS NUMBER(35, 6))) AS MaximumPricePerUnit,
	MIN(CAST(PriceTable__.Price / PriceTable__.ZoomRatio AS NUMBER(35, 6))) AS MinimumPricePerUnit,
	SUM(PriceTable__.Price * PriceTable__.NumberOfPackages) / SUM(PriceTable__.NumberOfPackages *
		PriceTable__.ZoomRatio) AS AveragePricePerUnit,
	PriceTable__.Currency AS Currency
INTO MinMaxAveragePrices
FROM
	PriceTable__ AS PriceTable__
GROUP BY
	PriceTable__.Products,
	PriceTable__.Characteristic,
	PriceTable__.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	MAX(PriceTable__.ZoomRatio) AS MaxCoefficient,
	MIN(PriceTable__.ZoomRatio) AS MinFactor
INTO MinMaxCoefficients
FROM
	PriceTable__ AS PriceTable__
GROUP BY
	PriceTable__.Products,
	PriceTable__.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	PriceTable__.Package AS Package,
	PriceTable__.ZoomRatio AS ZoomRatio,
	CASE
		WHEN &amp;PriceSelection = 1
		OR &amp;PriceSelection = 4
			THEN CAST(Prices.MaximumPricePerUnit * PriceTable__.ZoomRatio AS NUMBER(31, 2))
		WHEN &amp;PriceSelection = 2
			THEN CAST(Prices.MinimumPricePerUnit * PriceTable__.ZoomRatio AS NUMBER(31, 2))
		WHEN &amp;PriceSelection = 3
			THEN CAST(Prices.AveragePricePerUnit * PriceTable__.ZoomRatio AS NUMBER(31, 2))
		ELSE 0
	END AS Price,
	PriceTable__.Currency AS Currency
FROM
	PriceTable__ AS PriceTable__
		LEFT JOIN MinMaxAveragePrices AS Prices
		ON Prices.Products = PriceTable__.Products
		AND Prices.Characteristic = PriceTable__.Characteristic
		AND Prices.Currency = PriceTable__.Currency
		LEFT JOIN MinMaxCoefficients AS Coefficients
		ON Coefficients.Products = PriceTable__.Products
		AND Coefficients.Characteristic = PriceTable__.Characteristic
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON PriceTable__.Products.ProductKind = ItemKinds.Ref
WHERE
	CASE
		WHEN &amp;ChoiceOfPackaging = 1
			THEN PriceTable__.ZoomRatio = Coefficients.MaxCoefficient
		WHEN &amp;ChoiceOfPackaging = 2
			THEN PriceTable__.ZoomRatio = Coefficients.MinFactor
		ELSE FALSE
	END</query>
	</dataSet>
