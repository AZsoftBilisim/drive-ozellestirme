			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Testo di query coefficiente imballaggi2</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Tekst zapytania współczynnik opakowania 2</v8:content>
