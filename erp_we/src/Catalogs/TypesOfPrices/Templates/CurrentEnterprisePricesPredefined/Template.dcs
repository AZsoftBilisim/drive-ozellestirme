		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Package AS Package,
	ItemsPrices.Currency AS Currency,
	ItemsPrices.Price AS Price
{SELECT
	Products,
	Characteristic.*,
	Package.*,
	Currency.*}
FROM
	InformationRegister.ItemsPrices.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, PriceKind = &amp;PriceKind {((Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
			NOT ((Products, Characteristic) IN
			(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
			FROM
			SelectionByProductSegment
			WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed))}) AS ItemsPrices
WHERE
	ItemsPrices.Price &lt;&gt; 0</query>
	</dataSet>
