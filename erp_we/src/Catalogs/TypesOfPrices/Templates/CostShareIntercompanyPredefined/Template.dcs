		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Reserves.Recorder AS Recorder,
	Reserves.Organization AS CompanyOwner,
	Reserves.CorCompany AS CompanyCustomer,
	Reserves.ItemsLocationAttributes.Products AS Products,
	Reserves.ItemsLocationAttributes.Characteristic AS Characteristic,
	Reserves.ItemsLocationAttributes.StorageLocation AS Warehouse,
	SUM(Reserves.Count) AS Count
INTO ProvisionsForPeriod
FROM
	AccumulationRegister.CompanySafeStock AS Reserves
WHERE
	Reserves.Count &gt; 0
	AND Reserves.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND NOT &amp;FilterByProductSegmentIsUsed
	AND Reserves.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	Reserves.Recorder,
	Reserves.Organization,
	Reserves.CorCompany,
	Reserves.ItemsLocationAttributes.Products,
	Reserves.ItemsLocationAttributes.Characteristic,
	Reserves.ItemsLocationAttributes.StorageLocation

UNION ALL

SELECT
	Reserves.Recorder,
	Reserves.Organization,
	Reserves.CorCompany,
	Reserves.ItemsLocationAttributes.Products,
	Reserves.ItemsLocationAttributes.Characteristic,
	Reserves.ItemsLocationAttributes.StorageLocation,
	SUM(Reserves.Count)
FROM
	AccumulationRegister.CompanySafeStock AS Reserves
		INNER JOIN SelectionByProductSegment AS FilterBySegment
		ON (Reserves.ItemsLocationAttributes.Products = FilterBySegment.Products)
			AND (Reserves.ItemsLocationAttributes.Characteristic = FilterBySegment.Characteristic)
WHERE
	Reserves.Count &gt; 0
	AND Reserves.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND &amp;FilterByProductSegmentIsUsed
	AND Reserves.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	Reserves.Recorder,
	Reserves.Organization,
	Reserves.CorCompany,
	Reserves.ItemsLocationAttributes.Products,
	Reserves.ItemsLocationAttributes.Characteristic,
	Reserves.ItemsLocationAttributes.StorageLocation
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Reserves.CompanyOwner AS CompanyOwner,
	Reserves.CompanyCustomer AS CompanyCustomer,
	Reserves.Products AS Products,
	Reserves.Characteristic AS Characteristic,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN Reserves.Characteristic.ItemsCharacteristicForPricing
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_) AS PricingBatch,
	Reserves.Products.UnitOfMeasure AS PricingPackage,
	Reserves.Warehouse AS Warehouse,
	SUM(Reserves.Count) AS Count,
	SUM(Reserves.Count) * MAX(CASE
			WHEN ISNULL(TypesOfPrices.PriceIncludesVAT, FALSE)
				THEN Revenue.RevenueAmountTurnover
			ELSE Revenue.RevenueAmountExcludingVATTurnover
		END) / MAX(Revenue.CountTurnover) AS RevenueAmount
INTO Revenue
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto, {((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS Revenue
INNER JOIN
	ProvisionsForPeriod AS Reserves
ON
	Revenue.Recorder = Reserves.Recorder
	AND (Revenue.ItemsLocationAttributes.Products = Reserves.Products)
	AND (Revenue.ItemsLocationAttributes.Characteristic = Reserves.Characteristic)
	AND (Revenue.ItemsLocationAttributes.StorageLocation = Reserves.Warehouse)
LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TypesOfPrices.Ref = &amp;PriceKind)
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	Reserves.Products.ProductKind = ItemKinds.Ref
GROUP BY
	Reserves.CompanyOwner,
	Reserves.CompanyCustomer,
	Reserves.Products,
	Reserves.Characteristic,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN Reserves.Characteristic.ItemsCharacteristicForPricing
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_),
	Reserves.Warehouse
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS ZoomRatio,
	Revenue.Products AS Products,
	Revenue.Characteristic AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	Constants.ManagementAccountingCurrency AS Currency,
	CASE
		WHEN TypesOfPrices.PriceIncludesVAT
			THEN ISNULL(CostOfGoodsCut.Cost, 0) + ISNULL(CostOfGoodsCut.OffBalanceCost, 0)
			+ ISNULL(CostOfGoodsCut.AdditionalExpenseCost, 0) + ISNULL(CostOfGoodsCut.LaborCosts, 0)
			+ ISNULL(CostOfGoodsCut.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(CostOfGoodsCut.ItemizedVariableCostsIncludingVAT, 0)
		ELSE ISNULL(CostOfGoodsCut.CostExcludingVAT, 0) + ISNULL(CostOfGoodsCut.AdditionalExpensesCostExcludingVAT, 0)
			 + ISNULL(CostOfGoodsCut.LaborCosts, 0) + ISNULL(CostOfGoodsCut.ItemizedFixedCostsExcludingVAT, 0)
			 + ISNULL(CostOfGoodsCut.ItemizedVariableCostsExcludingVAT, 0)
			 + (CAST(ISNULL(CostOfGoodsCut.OffBalanceCost, 0) - ISNULL(CostOfGoodsCut.OffBalanceCost, 0)
			 	* (CASE
						WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
							THEN TypesOfPrices.VATRate.Rate1 / (100 + TypesOfPrices.VATRate.Rate1)
						WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
							THEN ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1)
						ELSE
                            (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
							 / (100 + (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1)
					END) AS NUMBER(31, 2)))
	END * (100 + &amp;Percent) / 100 AS Price
{SELECT
	ZoomRatio,
	Price,
	Products.*,
	Characteristic.*,
	Package.*,
	Currency.*}
FROM
	Revenue AS Revenue
		INNER JOIN InformationRegister.GoodsCost.SliceLast({(&amp;DocumentDate)}, {((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS CostOfGoodsCut
		ON Revenue.CompanyCustomer = CostOfGoodsCut.Organization
			AND Revenue.Products = CostOfGoodsCut.ItemsLocationAttributes.Products
			AND Revenue.Characteristic = CostOfGoodsCut.ItemsLocationAttributes.Characteristic
			AND Revenue.Warehouse = CostOfGoodsCut.ItemsLocationAttributes.StorageLocation
		INNER JOIN Constants AS Constants
		ON (TRUE)
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TypesOfPrices.Ref = &amp;PriceKind)
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;DocumentDate)}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
		ON Revenue.Products = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(&amp;DocumentDate)}, Country = &amp;CountryOfVATRates) AS BasicVATRates
		ON (TRUE)
LEFT JOIN
	InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
		PriceKind = &amp;PriceKind
		AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
		(SELECT
			TT.Products,
			TT.PricingVariant,
			TT.PricingBatch,
			TT.PricingPackage
		FROM
			Revenue AS TT)
) AS ItemsPrices
ON
	Revenue.Products = ItemsPrices.Products
	AND Revenue.PricingVariant = ItemsPrices.PricingVariant
	AND Revenue.PricingBatch = ItemsPrices.PricingBatch
	AND Revenue.PricingPackage = ItemsPrices.PricingPackage
{WHERE
	Revenue.Products.*,
	Revenue.Characteristic.*,
	Revenue.CompanyOwner.*,
	Revenue.CompanyCustomer.*,
	Revenue.Warehouse.*}</query>
	</dataSet>
