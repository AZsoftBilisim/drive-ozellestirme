		<field xsi:type="DataSetFieldField">
			<dataPath>ProductSegment</dataPath>
			<field>ProductSegment</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Inventory segment</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>بخش موجودی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Segmento degli articoli</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Segment nomenklatury</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сегмент номенклатуры</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Stok segmenti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Phân khúc mặt hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Products.Ref AS Products,
	Products.ProductKind AS ProductKind,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic
INTO TempTable
FROM
	Catalog.Products AS Products
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
{WHERE
	Products.Ref.* AS Products,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	((Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(NOT (Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed  = &amp;SelectionBasedOnNonProductSegmentIsUsed))}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	ItemsCharacteristics.Ref
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON (CASE
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN Products.Ref
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN Products.ProductKind
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN Products.ItemVariantsOwner
				ELSE UNDEFINED
			END = ItemsCharacteristics.Owner)
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants &lt;&gt; VALUE(Enum.ItemVariantsUsageOptions.DontUse)
{WHERE
	Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(NOT (Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed  = &amp;SelectionBasedOnNonProductSegmentIsUsed))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TempTable.Products,
	TempTable.ProductKind,
	TempTable.Characteristic
FROM
	TempTable AS TempTable
{WHERE
	TempTable.Products.*,
	TempTable.ProductKind.*,
	TempTable.Characteristic.*}</query>
	</dataSet>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>فیلتر بر اساس بخش قلم استفاده می‌شود</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Viene utilizzata la selezione per segmento degli articoli</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jest używany filtr wg segmentu wierszy pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Используется отбор по сегменту номенклатуры</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok segmentine göre filtre kullanılmaktadır</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sử dụng lọc theo phân khúc mặt hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>SelectionBasedOnNonProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter not by item segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>فیلتر خارج از بخش قلم استفاده می‌شود</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Utilizzato filtro per la nomenclatura non di segmento</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jest używany filtr wg nie segmentu wierszy pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Используется отбор по не сегменту номенклатуры</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok segmentine göre olmayan filtre kullanılmaktadır</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sử dụng bộ lọc không theo phân khúc mặt hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
