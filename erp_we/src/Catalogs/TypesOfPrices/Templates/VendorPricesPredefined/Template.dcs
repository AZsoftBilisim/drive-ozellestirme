		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
{SELECT
	Partner.*}
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemPricesCrossSectionOfTheLatest.Period AS Period,
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.Package AS Package,
	&amp;Currency AS Currency,
	1 AS ZoomRatio,
	(CAST(CASE
			WHEN TypesOfPrices.PriceIncludesVAT
						AND ItemPricesCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
					OR NOT TypesOfPrices.PriceIncludesVAT
						AND NOT ItemPricesCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
				THEN ItemPricesCrossSectionOfTheLatest.Price
			WHEN TypesOfPrices.PriceIncludesVAT
					AND NOT ItemPricesCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
				THEN ItemPricesCrossSectionOfTheLatest.Price + ItemPricesCrossSectionOfTheLatest.Price
						* ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
			WHEN NOT TypesOfPrices.PriceIncludesVAT
					AND ItemPricesCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
				THEN ItemPricesCrossSectionOfTheLatest.Price - ItemPricesCrossSectionOfTheLatest.Price
						* ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
							/ (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 + 100
						)
		END AS NUMBER(31, 2))) * CASE
		WHEN &amp;Currency &lt;&gt; ItemPricesCrossSectionOfTheLatest.Currency
			THEN CASE
					WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) &gt; 0
							AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) &gt; 0
							AND ISNULL(Currency_Rates.CourseDenominator, 0) &gt; 0
							AND ISNULL(Currency_Rates.CourseNumerator, 0) &gt; 0
						THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
					ELSE 0
				END
		ELSE 1
	END AS Price
INTO PricesOfSupplierNomenclatureCrossSectionOfTheLatest
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Partner.Vendor {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesPrices
		ON ItemPricesCrossSectionOfTheLatest.Currency = CurrencyRatesPrices.Currency
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Currency = &amp;Currency AND BaseCurrency = &amp;BaseCurrency) AS Currency_Rates
		ON (TRUE)
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TypesOfPrices.Ref = &amp;PriceKind)
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductsVATRates.Products
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
		ON (TRUE)
WHERE
	CASE
			WHEN &amp;AnalysisDepth &lt;&gt; 0
				THEN DATEDIFF(ItemPricesCrossSectionOfTheLatest.Period, &amp;DocumentDate, DAY) &lt;= &amp;AnalysisDepth
			ELSE TRUE
		END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic AS Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Package AS Package,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency AS Currency,
	MAX(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Period) AS Period
INTO SupplierProductPricesMaximumPeriods
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
WHERE
	&amp;OptionForGroupingPrices = 4

GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Package,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency AS Currency,
	1 AS ZoomRatio,
	AVG(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS PriceOfMedia,
	MAX(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS PriceMax,
	MIN(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS PriceMin,
	NULL AS Price
INTO PricesOfNomenclatureOfSuppliersOfMediaMinMax
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
WHERE
	&amp;OptionForGroupingPrices &lt;&gt; 4

GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency

UNION ALL

SELECT
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency,
	1,
	NULL,
	NULL,
	NULL,
	AVG(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1))
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
		INNER JOIN SupplierProductPricesMaximumPeriods AS SupplierProductPricesMaximumPeriods
		ON PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Period = SupplierProductPricesMaximumPeriods.Period
			AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products = SupplierProductPricesMaximumPeriods.Products
			AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic = SupplierProductPricesMaximumPeriods.Characteristic
			AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Package = SupplierProductPricesMaximumPeriods.Package
			AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency = SupplierProductPricesMaximumPeriods.Currency
WHERE
	&amp;OptionForGroupingPrices = 4

GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Products AS Products,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Characteristic AS Characteristic,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Package AS Package,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Currency AS Currency,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.ZoomRatio AS ZoomRatio,
	CASE
		WHEN &amp;OptionForGroupingPrices = 1
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.PriceMax
		WHEN &amp;OptionForGroupingPrices = 2
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.PriceMin
		WHEN &amp;OptionForGroupingPrices = 3
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.PriceOfMedia
		WHEN &amp;OptionForGroupingPrices = 4
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.Price
	END AS Price
FROM
	PricesOfNomenclatureOfSuppliersOfMediaMinMax AS PricesOfNomenclatureOfSuppliersOfMediaMinMax</query>
	</dataSet>
