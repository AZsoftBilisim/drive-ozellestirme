		<field xsi:type="DataSetFieldField">
			<dataPath>PriceKind</dataPath>
			<field>PriceKind</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
{SELECT
	Partner.*}
FROM
	InformationRegister.SegmentPartners AS Segments
WHERE
	&amp;FilterByPartnerSegmentIsUsed
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner
	
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemsPrices.Period AS Period,
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN ISNULL(ItemsPrices.Characteristic.ItemsCharacteristicForPricing,
							VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END AS PricingVariant,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN CASE
				WHEN ItemsPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
					THEN ItemsPrices.Products.UnitOfMeasure
				ELSE ItemsPrices.Package
			END
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS PricingPackage,
	ItemsPrices.Package AS Package,
	&amp;Currency AS Currency,
	CASE	
		WHEN &amp;Currency &lt;&gt; ItemsPrices.Currency
			THEN CASE
				WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) &gt; 0
						AND ISNULL(Currency_Rates.CourseDenominator, 0) &gt; 0
						AND ISNULL(Currency_Rates.CourseNumerator, 0) &gt; 0
					THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
				ELSE 0
			END
		ELSE 1
	END AS Currency_Rates,
	TypesOfPrices.PriceIncludesVAT AS PriceTypesPriceIncludesVAT,
	TypesOfPrices.OptionForSpecifyingVATRates AS OptionForSpecifyingVATRates,
	TypesOfPrices.VATRate.Rate1 AS Rate1,
	ItemsPrices.VendorPriceKind.PriceIncludesVAT AS PriceIncludesVAT,
	ItemsPrices.Price AS Price
INTO ItemsPricesOfVendor
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Partner.Vendor {((Products, Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
				FROM
			        SelectionByProductSegment
				WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
				FROM
			        SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
				) AS ItemsPrices
LEFT JOIN
	InformationRegister.RelativeExchangeRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesPrices
ON
	ItemsPrices.Currency = CurrencyRatesPrices.Currency
LEFT JOIN
	InformationRegister.RelativeExchangeRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Currency = &amp;Currency AND BaseCurrency = &amp;BaseCurrency) AS Currency_Rates
ON (TRUE)
LEFT JOIN
	Catalog.TypesOfPrices AS TypesOfPrices
ON
	TypesOfPrices.Ref = &amp;PriceKind
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	ItemsPrices.Products.ProductKind = ItemKinds.Ref
WHERE
	CASE
		WHEN &amp;AnalysisDepth &lt;&gt; 0
			THEN DATEDIFF(ItemsPrices.Period, &amp;DocumentDate, DAY) &lt;= &amp;AnalysisDepth
		ELSE TRUE
	END
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Period AS Period,
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	PriceTable__.PricingVariant AS PricingVariant,
	PriceTable__.PricingPackage AS PricingPackage,
	PriceTable__.Package AS Package,
	PriceTable__.Currency AS Currency,
	1 AS ZoomRatio,
	(CAST(CASE
			
			WHEN	PriceTable__.PriceTypesPriceIncludesVAT
					AND PriceTable__.PriceIncludesVAT
					OR NOT PriceTable__.PriceTypesPriceIncludesVAT
						AND NOT PriceTable__.PriceIncludesVAT
				THEN PriceTable__.Price
				
			WHEN	PriceTable__.PriceTypesPriceIncludesVAT
					AND NOT PriceTable__.PriceIncludesVAT
				THEN PriceTable__.Price + PriceTable__.Price
				* (CASE
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
							THEN PriceTable__.Rate1 / 100
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
							THEN ItemsPrices.VATRate.Rate1 / 100
						ELSE (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100
					END)
						
			WHEN	NOT PriceTable__.PriceTypesPriceIncludesVAT
					AND PriceTable__.PriceIncludesVAT
				THEN PriceTable__.Price - PriceTable__.Price
					* (CASE
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
							THEN PriceTable__.Rate1 / (100 + PriceTable__.Rate1)
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
							THEN ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1)
						ELSE
   							(ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
							 / (100 + (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1)
					END)
		END AS NUMBER(31, 2)))
		* PriceTable__.Currency_Rates AS Price	
INTO PricesOfSupplierProductsCutPreliminary
FROM
	ItemsPricesOfVendor AS PriceTable__
LEFT JOIN
	InformationRegister.ProductsVATRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
ON
	PriceTable__.Products = ProductsVATRates.Products
LEFT JOIN
	InformationRegister.BasicVATRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
ON (TRUE)
LEFT JOIN
	InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
		PriceKind = &amp;PriceKind
		AND (Products, PricingVariant, PricingPackage) IN
			(SELECT
				TT.Products,
				TT.PricingVariant,
				TT.PricingPackage
			FROM
				ItemsPricesOfVendor AS TT)
	) AS ItemsPrices
ON
	PriceTable__.Products = ItemsPrices.Products
	AND PriceTable__.PricingVariant = ItemsPrices.PricingVariant
	AND PriceTable__.PricingPackage = ItemsPrices.PricingPackage
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Period AS Period,
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	PriceTable__.Package AS Package,
	PriceTable__.Currency AS Currency,
	PriceTable__.ZoomRatio AS ZoomRatio,
	PriceTable__.Price AS Price,
	PriceTable__.PricingVariant AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_) AS PricingBatch,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS TSOSeriesForCommunication,
	PriceTable__.Products.UnitOfMeasure AS PricingPackage,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS TsoPackagingForCommunication
INTO PricesOfSupplierNomenclatureCrossSectionOfTheLatest
FROM
	PricesOfSupplierProductsCutPreliminary AS PriceTable__
	LEFT JOIN Catalog.ItemKinds AS ItemKinds
	ON PriceTable__.Products.ProductKind = ItemKinds.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemsPrices.Products AS Products,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.Package AS Package,
	ItemsPrices.Currency AS Currency,
	ItemsPrices.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	ItemsPrices.TsoPackagingForCommunication AS TsoPackagingForCommunication,
	MAX(ItemsPrices.Period) AS Period
INTO SupplierProductPricesMaximumPeriods
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS ItemsPrices
WHERE
	&amp;OptionForGroupingPrices = 4

GROUP BY
	ItemsPrices.Products,
	ItemsPrices.Package,
	ItemsPrices.PricingVariant,
	ItemsPrices.TSOSeriesForCommunication,
	ItemsPrices.TsoPackagingForCommunication,
	ItemsPrices.Currency
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic AS Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingVariant AS PricingVariant,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency AS Currency,
	1 AS ZoomRatio,
	AVG(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS PriceOfMedia,
	MAX(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS PriceMax,
	MIN(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS PriceMin,
	NULL AS Price,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingBatch AS PricingBatch,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TsoPackagingForCommunication AS TsoPackagingForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingPackage AS PricingPackage
	
INTO PricesOfNomenclatureOfSuppliersOfMediaMinMax
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
WHERE
	&amp;OptionForGroupingPrices &lt;&gt; 4

GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingVariant,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TSOSeriesForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingBatch,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TsoPackagingForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingPackage,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency

UNION ALL

SELECT
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingVariant,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency,
	1,
	NULL,
	NULL,
	NULL,
	AVG(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)),
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingBatch AS PricingBatch,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TsoPackagingForCommunication AS TsoPackagingForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingPackage AS PricingPackage
	
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
INNER JOIN
	SupplierProductPricesMaximumPeriods AS SupplierProductPricesMaximumPeriods
ON
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Period = SupplierProductPricesMaximumPeriods.Period
	AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products = SupplierProductPricesMaximumPeriods.Products
	AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingVariant = SupplierProductPricesMaximumPeriods.PricingVariant
	AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TsoPackagingForCommunication = SupplierProductPricesMaximumPeriods.TsoPackagingForCommunication
	AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TSOSeriesForCommunication = SupplierProductPricesMaximumPeriods.TSOSeriesForCommunication
	AND PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency = SupplierProductPricesMaximumPeriods.Currency
WHERE
	&amp;OptionForGroupingPrices = 4

GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingVariant,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TSOSeriesForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingBatch,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.TsoPackagingForCommunication,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PricingPackage,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Products AS Products,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Characteristic AS Characteristic,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.PricingVariant AS PricingVariant,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Package AS Package,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.Currency AS Currency,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.ZoomRatio AS ZoomRatio,
	CASE
		WHEN &amp;OptionForGroupingPrices = 1
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.PriceMax
		WHEN &amp;OptionForGroupingPrices = 2
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.PriceMin
		WHEN &amp;OptionForGroupingPrices = 3
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.PriceOfMedia
		WHEN &amp;OptionForGroupingPrices = 4
			THEN PricesOfNomenclatureOfSuppliersOfMediaMinMax.Price
	END AS Price,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.PricingBatch AS PricingBatch,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.TsoPackagingForCommunication AS TsoPackagingForCommunication,
	PricesOfNomenclatureOfSuppliersOfMediaMinMax.PricingPackage AS PricingPackage
FROM
	PricesOfNomenclatureOfSuppliersOfMediaMinMax AS PricesOfNomenclatureOfSuppliersOfMediaMinMax</query>
	</dataSet>
	<parameter>
		<name>DocumentDate</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Document date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تاریخ سند</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
