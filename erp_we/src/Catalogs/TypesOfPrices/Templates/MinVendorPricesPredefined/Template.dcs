		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
{SELECT
	Partner.*}
FROM
	InformationRegister.SegmentPartners AS Segments
WHERE
	&amp;FilterByPartnerSegmentIsUsed
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN ISNULL(ItemsPrices.Characteristic.ItemsCharacteristicForPricing,
							VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END AS PricingVariant,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN CASE
				WHEN ItemsPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
					THEN ItemsPrices.Products.UnitOfMeasure
				ELSE ItemsPrices.Package
			END
		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	END AS PricingPackage,
	ItemsPrices.Package AS Package,
	&amp;Currency AS Currency,
	CASE	
		WHEN &amp;Currency &lt;&gt; ItemsPrices.Currency
			THEN CASE
				WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) &gt; 0
						AND ISNULL(Currency_Rates.CourseDenominator, 0) &gt; 0
						AND ISNULL(Currency_Rates.CourseNumerator, 0) &gt; 0
					THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
				ELSE 0
			END
		ELSE 1
	END AS Currency_Rates,
	TypesOfPrices.PriceIncludesVAT AS PriceTypesPriceIncludesVAT,
	TypesOfPrices.OptionForSpecifyingVATRates AS OptionForSpecifyingVATRates,
	TypesOfPrices.VATRate.Rate1 AS Rate1,
	ItemsPrices.VendorPriceKind.PriceIncludesVAT AS PriceIncludesVAT,
	ItemsPrices.Price AS Price
INTO ItemsPricesOfVendor
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Partner.Vendor {((Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
			    SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Partner IN
			(SELECT
			    SelectionByPartnerSegment.Partner
			FROM
			    SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
			) AS ItemsPrices
LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, BaseCurrency IN (SELECT
				TT.Value AS Value
			FROM
				Constant.DefaultBaseCurrency AS TT)) AS CurrencyRatesPrices
ON
	ItemsPrices.Currency = CurrencyRatesPrices.Currency
LEFT JOIN
	InformationRegister.RelativeExchangeRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
		Currency = &amp;Currency
		AND BaseCurrency IN (
			SELECT
				TT.Value AS Value
			FROM
				Constant.DefaultBaseCurrency AS TT)
			) AS Currency_Rates
		ON (TRUE)
LEFT JOIN
	Catalog.TypesOfPrices AS TypesOfPrices
ON
	(TypesOfPrices.Ref = &amp;PriceKind)
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	ItemsPrices.Products.ProductKind = ItemKinds.Ref
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	PriceTable__.Products AS Products,
	PriceTable__.Characteristic AS Characteristic,
	PriceTable__.Package AS Package,
	PriceTable__.Currency AS Currency,
	1 AS ZoomRatio,
	(CAST(CASE
			WHEN	PriceTable__.PriceTypesPriceIncludesVAT
					AND PriceTable__.PriceIncludesVAT
					OR NOT PriceTable__.PriceTypesPriceIncludesVAT
						AND NOT PriceTable__.PriceIncludesVAT
				THEN PriceTable__.Price
				
			WHEN	PriceTable__.PriceTypesPriceIncludesVAT
					AND NOT PriceTable__.PriceIncludesVAT
				THEN PriceTable__.Price + PriceTable__.Price
				* (CASE
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
							THEN PriceTable__.Rate1 / 100
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
							THEN ItemsPrices.VATRate.Rate1 / 100
						ELSE (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100
					END)
			WHEN	NOT PriceTable__.PriceTypesPriceIncludesVAT
					AND PriceTable__.PriceIncludesVAT
				THEN PriceTable__.Price - PriceTable__.Price
					* (CASE
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
							THEN PriceTable__.Rate1 / (100 + PriceTable__.Rate1)
						WHEN PriceTable__.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
							THEN ItemsPrices.VATRate.Rate1 / (100 + ItemsPrices.VATRate.Rate1)
						ELSE
   							(ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1
							 / (100 + (ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1)
					END)
		END AS NUMBER(31, 2)))
		* PriceTable__.Currency_Rates AS Price	
INTO PricesOfSupplierNomenclatureCrossSectionOfTheLatest
FROM
	ItemsPricesOfVendor AS PriceTable__
LEFT JOIN
	InformationRegister.ProductsVATRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
ON
	PriceTable__.Products = ProductsVATRates.Products
LEFT JOIN
	InformationRegister.BasicVATRates.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
ON (TRUE)
LEFT JOIN
	InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
		PriceKind = &amp;PriceKind
		AND (Products, PricingVariant, PricingPackage) IN
			(SELECT
				TT.Products,
				TT.PricingVariant,
				TT.PricingPackage
			FROM
				ItemsPricesOfVendor AS TT)
	) AS ItemsPrices
ON
	PriceTable__.Products = ItemsPrices.Products
	AND PriceTable__.PricingVariant = ItemsPrices.PricingVariant
	AND PriceTable__.PricingPackage = ItemsPrices.PricingPackage
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency AS Currency,
	1 AS ZoomRatio,
	MIN(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor1, 1)) AS Price
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency</query>
	</dataSet>
