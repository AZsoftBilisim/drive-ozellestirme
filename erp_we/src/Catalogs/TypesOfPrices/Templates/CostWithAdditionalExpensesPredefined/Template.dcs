			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LotVendorAttributes</dataPath>
			<field>LotVendorAttributes</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
