		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Country</dataPath>
			<field>Country</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PricingVariant</dataPath>
			<field>PricingVariant</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PricingBatch</dataPath>
			<field>PricingBatch</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PricingPackage</dataPath>
			<field>PricingPackage</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PriceKind</dataPath>
			<field>PriceKind</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE ISNULL(Segments.Characteristic.ItemsCharacteristicForPricing,
							VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
	END AS PricingVariant,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	Segments.Products.ProductKind = ItemKinds.Ref
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DocumentData.Ref.Date, MONTH) AS MonthPeriod,
	DocumentData.Organization AS Organization,
	DocumentData.Ref.PreliminaryCalculation AS PreliminaryCalculation
INTO CostCalculations
FROM
	Document.InventoryCostCalculation.Companies AS DocumentData
WHERE
	DocumentData.Ref.Posted
	AND DocumentData.Ref.Date BETWEEN BEGINOFPERIOD(&amp;DocumentDate, MONTH) AND ENDOFPERIOD(&amp;DocumentDate, MONTH)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS ZoomRatio,
	CASE
		WHEN SUM(InventoryCost.Count) &gt; 0
			THEN CAST(SUM(InventoryCost.Cost) / SUM(InventoryCost.Count) AS NUMBER(31,2))
		ELSE 0
	END AS Price,
	InventoryCost.Products AS Products,
	InventoryCost.Characteristic AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	Constants.ManagementAccountingCurrency AS Currency
{SELECT
	ZoomRatio,
	Price,
	Products.*,
	Characteristic.*,
	Package.*,
	Currency.*}
FROM
	(SELECT
		DimensionKeys.Products AS Products,
		DimensionKeys.Characteristic AS Characteristic,
		SUM(CASE
				WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
					THEN CASE
							WHEN TypesOfPrices.PriceIncludesVAT
								THEN ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.AdditionalExpenseCost, 0)
								+ ISNULL(CostOfProducts.OffBalanceCost, 0) + ISNULL(CostOfProducts.LaborCosts, 0)
								+ ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
							
							ELSE ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0)
								+ ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) + ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
								+ (CAST(ISNULL(CostOfProducts.OffBalanceCost, 0) - ISNULL(CostOfProducts.OffBalanceCost, 0)
									* (CASE
											WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
												THEN TypesOfPrices.VATRate.Rate1 / 100
											WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
												THEN ItemsPrices.VATRate.Rate1 / 100
										ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
									END) AS NUMBER(31, 2)))
						END * InventoryCost.Count
				ELSE CASE
						WHEN TypesOfPrices.PriceIncludesVAT
							THEN InventoryCost.Cost + InventoryCost.AddExpensesForGoods
								+ InventoryCost.OffBalanceCost + InventoryCost.LaborCosts
								+ InventoryCost.ItemizedFixedCostsIncludingVAT + InventoryCost.ItemizedVariableCostsIncludingVAT
						ELSE InventoryCost.CostExcludingVAT + InventoryCost.AdditionalExpensesExcludingVAT + InventoryCost.LaborCosts
							+ InventoryCost.ItemizedFixedCostsExcludingVAT + InventoryCost.ItemizedVariableCostsExcludingVAT
							+ (CAST(InventoryCost.OffBalanceCost - InventoryCost.OffBalanceCost
							    * (CASE
										WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
											THEN TypesOfPrices.VATRate.Rate1 / 100
										WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
											THEN ItemsPrices.VATRate.Rate1 / 100
									ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
								END) AS NUMBER(31, 2)))
					END
			END) AS Cost,
		SUM(InventoryCost.Count) AS Count
	FROM
		AccumulationRegister.InventoryCost AS InventoryCost
			LEFT JOIN CostCalculations AS CostCalculations
			ON InventoryCost.Organization = CostCalculations.Organization
				AND (BEGINOFPERIOD(InventoryCost.Period, MONTH) = CostCalculations.MonthPeriod)
			LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
			ON InventoryCost.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
				AND InventoryCost.Organization = CostOfProducts.Organization
				AND InventoryCost.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
				AND (BEGINOFPERIOD(InventoryCost.Period, MONTH) = CostOfProducts.Period)
				AND (ISNULL(CostCalculations.PreliminaryCalculation, FALSE))
			LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
			ON (TypesOfPrices.Ref = &amp;PriceKind)
			LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
			ON InventoryCost.ItemsLocationAttributes.Products = ProductsVATRates.Products
			LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
			ON (TRUE)
	LEFT JOIN
		Catalog.InventoryLocationAttributeKeys AS DimensionKeys
	ON
		InventoryCost.ItemsLocationAttributes = DimensionKeys.Ref
	LEFT JOIN
		Catalog.ItemKinds AS ItemKinds
	ON
		DimensionKeys.Products.ProductKind = ItemKinds.Ref
	LEFT JOIN
		InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
			PriceKind = &amp;PriceKind
			{(Products, PricingVariant) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.PricingVariant
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			) AS ItemsPrices
	ON
		DimensionKeys.Products = ItemsPrices.Products
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(DimensionKeys.Characteristic.ItemsCharacteristicForPricing,
								VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = ItemsPrices.PricingVariant                                  
		AND DimensionKeys.Products.UnitOfMeasure = ItemsPrices.PricingPackage
	WHERE
		InventoryCost.Period BETWEEN BEGINOFPERIOD(&amp;DocumentDate, MONTH) AND ENDOFPERIOD(&amp;DocumentDate, DAY)
		AND InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
		AND (InventoryCost.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
			OR InventoryCost.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors)
			OR InventoryCost.ItemsLocationAttributes.Products.ProductKind.ItemsType =
				VALUE(Enum.ItemsTypes.Work_5)
				AND InventoryCost.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department))
		AND NOT InventoryCost.BusinessOperation IN (&amp;ExcludedBusinessTransactions)
	{WHERE
		((InventoryCost.ItemsLocationAttributes.Products, InventoryCost.ItemsLocationAttributes.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
	
	GROUP BY
		DimensionKeys.Products,
		DimensionKeys.Characteristic
	
	UNION ALL
	
	SELECT
		DimensionKeys.Products,
		DimensionKeys.Characteristic,
		SUM(CASE
				WHEN TypesOfPrices.PriceIncludesVAT
					THEN InventoryCost.CostBalance + InventoryCost.AddExpensesForGoodsBalance
						+ InventoryCost.OffBalanceCostBalance + InventoryCost.LaborCostsBalance
						+ InventoryCost.ItemizedFixedCostsIncludingVATBalance + InventoryCost.ItemizedVariableCostsIncludingVATBalance
				ELSE InventoryCost.CostExcludingVATBalance + InventoryCost.AdditionalExpensesExcludingVATBalance
					+ InventoryCost.LaborCostsBalance + InventoryCost.ItemizedFixedCostsExcludingVATBalance + InventoryCost.ItemizedVariableCostsExcludingVATBalance
					+ (CAST(InventoryCost.OffBalanceCostBalance - InventoryCost.OffBalanceCostBalance
						* (CASE
								WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
									THEN TypesOfPrices.VATRate.Rate1 / 100
								WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
									THEN ItemsPrices.VATRate.Rate1 / 100
							ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
						END) AS NUMBER(31, 2)))
			END),
		SUM(InventoryCost.CountBalance)
	FROM
		AccumulationRegister.InventoryCost.Balance(BEGINOFPERIOD(&amp;DocumentDate, MONTH), {((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS InventoryCost
			LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
			ON (TypesOfPrices.Ref = &amp;PriceKind)
			LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, MONTH))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
			ON InventoryCost.ItemsLocationAttributes.Products = ProductsVATRates.Products
			LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, MONTH))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
			ON (TRUE)
		LEFT JOIN
		Catalog.InventoryLocationAttributeKeys AS DimensionKeys
	ON
		InventoryCost.ItemsLocationAttributes = DimensionKeys.Ref
	LEFT JOIN
		Catalog.ItemKinds AS ItemKinds
	ON
		DimensionKeys.Products.ProductKind = ItemKinds.Ref
	LEFT JOIN
		InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
			PriceKind = &amp;PriceKind
			{(Products, PricingVariant) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.PricingVariant
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			) AS ItemsPrices
	ON
		DimensionKeys.Products = ItemsPrices.Products
		AND CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ISNULL(DimensionKeys.Characteristic.ItemsCharacteristicForPricing,
								VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		END = ItemsPrices.PricingVariant                                  
		AND DimensionKeys.Products.UnitOfMeasure = ItemsPrices.PricingPackage
    GROUP BY
		DimensionKeys.Products,
		DimensionKeys.Characteristic
	) AS InventoryCost
		LEFT JOIN Constants AS Constants
		ON (TRUE)

GROUP BY
	InventoryCost.Products,
	InventoryCost.Characteristic,
	Constants.ManagementAccountingCurrency</query>
	</dataSet>
	<parameter>
		<name>DocumentDate</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Document date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تاریخ سند</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Data del documento</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Data dokumentu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата документа</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Belge tarihi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Ngày chứng từ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>فیلتر بر اساس بخش قلم استفاده می‌شود</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Viene utilizzata la selezione per segmento degli articoli</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jest używany filtr wg segmentu wierszy pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Используется отбор по сегменту номенклатуры</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok segmentine göre filtre kullanılmaktadır</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sử dụng lọc theo phân khúc mặt hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okres</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
