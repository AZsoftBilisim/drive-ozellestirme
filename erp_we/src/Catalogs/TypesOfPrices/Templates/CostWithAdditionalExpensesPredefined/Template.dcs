		<field xsi:type="DataSetFieldField">
			<dataPath>FinancialAccountingDimension</dataPath>
			<field>FinancialAccountingDimension</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Financial accounting dimension</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>بُعد حسابداری مالی</v8:content>
				</v8:item>
				<v8:item>
