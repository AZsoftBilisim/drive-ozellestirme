				<order>true</order>
			</attributeUseRestriction>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.PackagesAndUnitsOfMeasure</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PriceKind</dataPath>
			<field>PriceKind</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE ISNULL(Segments.Characteristic.ItemsCharacteristicForPricing,
							VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
	END AS PricingVariant,

	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	Segments.Products.ProductKind = ItemKinds.Ref
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	BEGINOFPERIOD(DocumentData.Ref.Date, MONTH) AS MonthPeriod,
	DocumentData.Organization AS Organization,
	DocumentData.Ref.PreliminaryCalculation AS PreliminaryCalculation
INTO CostCalculations
FROM
	Document.InventoryCostCalculation.Companies AS DocumentData
WHERE
	DocumentData.Ref.Posted
	AND DocumentData.Ref.Date BETWEEN BEGINOFPERIOD(&amp;DocumentDate, MONTH) AND ENDOFPERIOD(&amp;DocumentDate, MONTH)
{WHERE
	DocumentData.Organization.* AS Organization}
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	InventoryCost.Period AS Period,
	InventoryCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCost.Organization AS Organization,
    InventoryCost.Count AS Count,
	InventoryCost.Cost AS Cost,
    InventoryCost.CostExcludingVAT AS CostExcludingVAT,
	InventoryCost.OffBalanceCost AS OffBalanceCost,
	InventoryCost.AddExpensesForGoods AS AddExpensesForGoods,
	InventoryCost.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
	InventoryCost.LaborCosts AS LaborCosts,
	InventoryCost.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	InventoryCost.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	InventoryCost.ItemizedFixedCostsExcludingVAT AS ItemizedFixedCostsExcludingVAT,
	InventoryCost.ItemizedVariableCostsExcludingVAT AS ItemizedVariableCostsExcludingVAT,
	DimensionKeys.Products AS Products,
	DimensionKeys.Characteristic AS Characteristic,
    DimensionKeys.StorageLocation AS Warehouse,
    CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN DimensionKeys.Characteristic.ItemsCharacteristicForPricing
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_) AS PricingBatch,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS TSOSeriesForCommunication,
	DimensionKeys.Products.UnitOfMeasure AS PricingPackage,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS TsoPackagingForCommunication
INTO TableCostOfGoods 
FROM
	AccumulationRegister.InventoryCost AS InventoryCost
LEFT JOIN
	Catalog.InventoryLocationAttributeKeys AS DimensionKeys
ON
	InventoryCost.ItemsLocationAttributes = DimensionKeys.Ref
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	DimensionKeys.Products.ProductKind = ItemKinds.Ref
WHERE
	InventoryCost.Period BETWEEN BEGINOFPERIOD(&amp;DocumentDate, MONTH) AND ENDOFPERIOD(&amp;DocumentDate, MONTH)
	AND InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND (DimensionKeys.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
		OR InventoryCost.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors))
	AND NOT InventoryCost.BusinessOperation IN (&amp;ExcludedBusinessTransactions)
{WHERE
	((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	InventoryCost.Organization.* AS Organization}
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	InventoryCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCost.Organization AS Organization,
    InventoryCost.CountBalance AS Count,
	InventoryCost.CostBalance AS Cost,
	InventoryCost.CostExcludingVATBalance AS CostExcludingVAT,
	InventoryCost.OffBalanceCostBalance AS OffBalanceCost,
	InventoryCost.AddExpensesForGoodsBalance AS AddExpensesForGoods,
	InventoryCost.AdditionalExpensesExcludingVATBalance AS AdditionalExpensesExcludingVAT,
	InventoryCost.LaborCostsBalance AS LaborCosts,
	InventoryCost.ItemizedFixedCostsIncludingVATBalance AS ItemizedFixedCostsIncludingVAT,
	InventoryCost.ItemizedVariableCostsIncludingVATBalance AS ItemizedVariableCostsIncludingVAT,
	InventoryCost.ItemizedFixedCostsExcludingVATBalance AS ItemizedFixedCostsExcludingVAT,
	InventoryCost.ItemizedVariableCostsExcludingVATBalance AS ItemizedVariableCostsExcludingVAT,
	DimensionKeys.Products AS Products,
	DimensionKeys.Characteristic AS Characteristic,
	DimensionKeys.StorageLocation AS Warehouse,
    CASE
		WHEN ItemKinds.SettingsOfPriceKeyByItemVariant &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN DimensionKeys.Characteristic.ItemsCharacteristicForPricing
		ELSE VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	END AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyBatch_) AS PricingBatch,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS TSOSeriesForCommunication,
	DimensionKeys.Products.UnitOfMeasure AS PricingPackage,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS TsoPackagingForCommunication
INTO TableCostOfGoodsBalance
FROM
	AccumulationRegister.InventoryCost.Balance(BEGINOFPERIOD(&amp;DocumentDate, MONTH),
		{((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
			(Organization).* AS Organization}
		) AS InventoryCost
LEFT JOIN
	Catalog.InventoryLocationAttributeKeys AS DimensionKeys
ON
	InventoryCost.ItemsLocationAttributes = DimensionKeys.Ref
LEFT JOIN
	Catalog.ItemKinds AS ItemKinds
ON
	DimensionKeys.Products.ProductKind = ItemKinds.Ref
;
////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	1 AS ZoomRatio,
	CASE
		WHEN SUM(InventoryCost.Count) &gt; 0
			THEN CAST(SUM(InventoryCost.Cost) / SUM(InventoryCost.Count) AS NUMBER(31, 2))
		ELSE 0
	END AS Price,
	InventoryCost.Products AS Products,
	InventoryCost.Characteristic AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	Constants.ManagementAccountingCurrency AS Currency,
	InventoryCost.Warehouse AS Warehouse,

	InventoryCost.PricingVariant AS PricingVariant,
	InventoryCost.PricingBatch AS PricingBatch,
	InventoryCost.TSOSeriesForCommunication AS TSOSeriesForCommunication,
	InventoryCost.PricingPackage AS PricingPackage,
	InventoryCost.TsoPackagingForCommunication AS TsoPackagingForCommunication
{SELECT
	ZoomRatio,
	Price,
	Products.*,
	Characteristic.*,
	Package.*,
	Currency.*,
	PricingVariant.*,
	TSOSeriesForCommunication.*,
	PricingBatch.*,
	TsoPackagingForCommunication.*,
	PricingPackage.*}
FROM
	(SELECT
		InventoryCost.Warehouse AS Warehouse,
		InventoryCost.Products AS Products,
		InventoryCost.Characteristic AS Characteristic,
		InventoryCost.PricingVariant AS PricingVariant,
		InventoryCost.PricingBatch AS PricingBatch,
		InventoryCost.TSOSeriesForCommunication AS TSOSeriesForCommunication,
		InventoryCost.PricingPackage AS PricingPackage,
		InventoryCost.TsoPackagingForCommunication AS TsoPackagingForCommunication,

		SUM(CASE
			WHEN &amp;OptionWithAdditionalCosts = 2
				THEN CASE
					WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
						THEN CASE
							WHEN TypesOfPrices.PriceIncludesVAT
								THEN ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.AdditionalExpenseCost, 0) +
									ISNULL(CostOfProducts.OffBalanceCost, 0) + ISNULL(CostOfProducts.LaborCosts, 0) +
									ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) +
									ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
							ELSE ISNULL(CostOfProducts.CostExcludingVAT, 0) +
								ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) + ISNULL(CostOfProducts.LaborCosts, 0)
								+ ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) +
								ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0) +
							
							(CAST(ISNULL(CostOfProducts.OffBalanceCost, 0) -
								ISNULL(CostOfProducts.OffBalanceCost, 0) * ((ISNULL(ProductsVATRates.VATRate,
								ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS
								NUMBER(35, 6)))
						END * InventoryCost.Count
					ELSE CASE
						WHEN TypesOfPrices.PriceIncludesVAT
							THEN InventoryCost.Cost + InventoryCost.AddExpensesForGoods +
								InventoryCost.OffBalanceCost + InventoryCost.LaborCosts +
								InventoryCost.ItemizedFixedCostsIncludingVAT + InventoryCost.ItemizedVariableCostsIncludingVAT
						ELSE InventoryCost.CostExcludingVAT + InventoryCost.AdditionalExpensesExcludingVAT +
							InventoryCost.LaborCosts + InventoryCost.ItemizedFixedCostsExcludingVAT +
							InventoryCost.ItemizedVariableCostsExcludingVAT +

						 (CAST(InventoryCost.OffBalanceCost -
							InventoryCost.OffBalanceCost * ((ISNULL(ProductsVATRates.VATRate,
							ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS
							NUMBER(35, 6)))
					END
				END
			ELSE CASE
				WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
					THEN CASE
						WHEN TypesOfPrices.PriceIncludesVAT
							THEN ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.OffBalanceCost, 0) +
								ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0)
								+ ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
						ELSE ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.LaborCosts, 0) +
							ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) +
							ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
							+ (CAST(ISNULL(CostOfProducts.OffBalanceCost, 0) - ISNULL(CostOfProducts.OffBalanceCost, 0)
								* (CASE
										WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
											THEN TypesOfPrices.VATRate.Rate1 / 100
										WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
											THEN ItemsPrices.VATRate.Rate1 / 100
									ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
								END) AS NUMBER(35, 6)))
					END * InventoryCost.Count
				ELSE CASE
					WHEN TypesOfPrices.PriceIncludesVAT
						THEN InventoryCost.Cost + InventoryCost.OffBalanceCost +
							InventoryCost.LaborCosts + InventoryCost.ItemizedFixedCostsIncludingVAT +
							InventoryCost.ItemizedVariableCostsIncludingVAT
					ELSE InventoryCost.CostExcludingVAT + InventoryCost.LaborCosts +
						InventoryCost.ItemizedFixedCostsExcludingVAT + InventoryCost.ItemizedVariableCostsExcludingVAT
						+ (CAST(InventoryCost.OffBalanceCost - InventoryCost.OffBalanceCost
							* (CASE
									WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
										THEN TypesOfPrices.VATRate.Rate1 / 100
									WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
										THEN ItemsPrices.VATRate.Rate1 / 100
								ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
							END) AS NUMBER(35, 6)))
				END
			END
		END) AS Cost,
		SUM(InventoryCost.Count) AS Count
	FROM
		TableCostOfGoods AS InventoryCost
	LEFT JOIN
		CostCalculations AS CostCalculations
	ON
		InventoryCost.Organization = CostCalculations.Organization
		AND (BEGINOFPERIOD(InventoryCost.Period, MONTH) = CostCalculations.MonthPeriod)
	LEFT JOIN
		InformationRegister.GoodsCost AS CostOfProducts
	ON
		InventoryCost.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
		AND InventoryCost.Organization = CostOfProducts.Organization
		AND InventoryCost.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
		AND (BEGINOFPERIOD(InventoryCost.Period, MONTH) = CostOfProducts.Period)
		AND (ISNULL(CostCalculations.PreliminaryCalculation, FALSE))
	LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TypesOfPrices.Ref = &amp;PriceKind)
	
	LEFT JOIN
		InformationRegister.ProductsVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
	ON
		InventoryCost.ItemsLocationAttributes.Products = ProductsVATRates.Products
	LEFT JOIN
		InformationRegister.BasicVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
	ON (TRUE)
	LEFT JOIN
		InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
			PriceKind = &amp;PriceKind
			AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
			(SELECT
				TT.Products,
				TT.PricingVariant,
				TT.PricingBatch,
				TT.PricingPackage
			FROM
				TableCostOfGoods AS TT)
	) AS ItemsPrices
	ON
		InventoryCost.Products = ItemsPrices.Products
		AND InventoryCost.PricingVariant = ItemsPrices.PricingVariant
		AND InventoryCost.PricingBatch = ItemsPrices.PricingBatch
		AND InventoryCost.PricingPackage = ItemsPrices.PricingPackage
	GROUP BY
		InventoryCost.Products,
		InventoryCost.Characteristic,
		InventoryCost.Warehouse,
		InventoryCost.PricingVariant,
		InventoryCost.PricingBatch,
		InventoryCost.TSOSeriesForCommunication,
		InventoryCost.PricingPackage,
		InventoryCost.TsoPackagingForCommunication

	UNION ALL

	SELECT
		InventoryCost.Warehouse,
		InventoryCost.Products,
		InventoryCost.Characteristic,
		InventoryCost.PricingVariant,
		InventoryCost.PricingBatch,
		InventoryCost.TSOSeriesForCommunication,
		InventoryCost.PricingPackage,
		InventoryCost.TsoPackagingForCommunication,

		SUM(CASE
			WHEN &amp;OptionWithAdditionalCosts = 2
				THEN CASE
					WHEN TypesOfPrices.PriceIncludesVAT
						THEN InventoryCost.Cost + InventoryCost.AddExpensesForGoods +
							InventoryCost.OffBalanceCost + InventoryCost.LaborCosts +
							InventoryCost.ItemizedFixedCostsIncludingVAT + InventoryCost.ItemizedVariableCostsIncludingVAT
					ELSE InventoryCost.CostExcludingVAT + InventoryCost.AdditionalExpensesExcludingVAT +
						InventoryCost.LaborCosts + InventoryCost.ItemizedFixedCostsExcludingVAT +
						InventoryCost.ItemizedVariableCostsExcludingVAT
						+ (CAST(InventoryCost.OffBalanceCost - InventoryCost.OffBalanceCost
							* (CASE
									WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
										THEN TypesOfPrices.VATRate.Rate1 / 100
									WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
										THEN ItemsPrices.VATRate.Rate1 / 100
								ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
							END) AS NUMBER(35, 6)))
				END
			ELSE CASE
				WHEN TypesOfPrices.PriceIncludesVAT
					THEN InventoryCost.Cost + InventoryCost.OffBalanceCost +
						InventoryCost.LaborCosts + InventoryCost.ItemizedFixedCostsIncludingVAT +
						InventoryCost.ItemizedVariableCostsIncludingVAT
				ELSE InventoryCost.CostExcludingVAT + InventoryCost.LaborCosts +
					InventoryCost.ItemizedFixedCostsExcludingVAT + InventoryCost.ItemizedVariableCostsExcludingVAT
					+ (CAST(InventoryCost.OffBalanceCost - InventoryCost.OffBalanceCost
						* (CASE
								WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
									THEN TypesOfPrices.VATRate.Rate1 / 100
								WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
									THEN ItemsPrices.VATRate.Rate1 / 100
							ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100)
						END) AS NUMBER(35, 6)))
			END
		END),
		SUM(InventoryCost.Count)
	FROM
		TableCostOfGoodsBalance AS InventoryCost
	LEFT JOIN
		Catalog.TypesOfPrices AS TypesOfPrices
	ON
		(TypesOfPrices.Ref = &amp;PriceKind)
	LEFT JOIN
		InformationRegister.ProductsVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS ProductsVATRates
	ON
		InventoryCost.Products = ProductsVATRates.Products
	LEFT JOIN
		InformationRegister.BasicVATRates.SliceLast({(BEGINOFPERIOD(&amp;DocumentDate, DAY))}, Country = &amp;CountryOfVATRates) AS BasicVATRates
	ON (TRUE)
	LEFT JOIN
		InformationRegister.ItemsPrices25.SliceLast({(ENDOFPERIOD(&amp;DocumentDate, DAY))},
			PriceKind = &amp;PriceKind
			AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
			(SELECT
				TT.Products,
				TT.PricingVariant,
				TT.PricingBatch,
				TT.PricingPackage
			FROM
				TableCostOfGoods AS TT)
		) AS ItemsPrices
	ON
		InventoryCost.Products = ItemsPrices.Products
		AND InventoryCost.PricingVariant = ItemsPrices.PricingVariant
		AND InventoryCost.PricingBatch = ItemsPrices.PricingBatch
		AND InventoryCost.PricingPackage = ItemsPrices.PricingPackage
	GROUP BY
		InventoryCost.Products,
		InventoryCost.Characteristic,
		InventoryCost.Warehouse,
		InventoryCost.PricingVariant,
		InventoryCost.PricingBatch,
		InventoryCost.TSOSeriesForCommunication,
		InventoryCost.PricingPackage,
		InventoryCost.TsoPackagingForCommunication

	) AS InventoryCost

LEFT JOIN Constants AS Constants
ON (TRUE)
GROUP BY
	InventoryCost.Products,
	InventoryCost.Characteristic,
	Constants.ManagementAccountingCurrency,
	InventoryCost.Warehouse,
	InventoryCost.PricingVariant,
	InventoryCost.PricingBatch,
	InventoryCost.TSOSeriesForCommunication,
	InventoryCost.PricingPackage,
	InventoryCost.TsoPackagingForCommunication</query>
	</dataSet>
