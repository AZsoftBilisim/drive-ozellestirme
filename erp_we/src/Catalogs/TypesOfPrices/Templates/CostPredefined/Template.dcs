		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DocumentData.Ref.Date, MONTH) AS MonthPeriod,
	DocumentData.Organization AS Organization,
	DocumentData.Ref.PreliminaryCalculation AS PreliminaryCalculation
INTO CostCalculations
FROM
	Document.InventoryCostCalculation.Companies AS DocumentData
WHERE
	DocumentData.Ref.Posted
	AND DocumentData.Ref.Date BETWEEN BEGINOFPERIOD(&amp;DocumentDate, MONTH) AND ENDOFPERIOD(&amp;DocumentDate, MONTH)
{WHERE
	DocumentData.Organization.* AS Organization}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS ZoomRatio,
	CASE
		WHEN SUM(InventoryCost.Count) &gt; 0
			THEN CAST(SUM(InventoryCost.Cost) / SUM(InventoryCost.Count) AS NUMBER(31, 2))
		ELSE 0
	END AS Price,
	InventoryCost.Products AS Products,
	InventoryCost.Characteristic AS Characteristic,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	Constants.ManagementAccountingCurrency AS Currency,
	InventoryCost.Warehouse AS Warehouse
{SELECT
	ZoomRatio,
	Price,
	Products.*,
	Characteristic.*,
	Package.*,
	Currency.*}
FROM
	(SELECT
		InventoryCost.ItemsLocationAttributes.StorageLocation AS Warehouse,
		InventoryCost.ItemsLocationAttributes.Products AS Products,
		InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
		SUM(CASE
			WHEN &amp;OptionWithAdditionalCosts = 2
				THEN CASE
					WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
						THEN CASE
							WHEN TypesOfPrices.PriceIncludesVAT
								THEN ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.AdditionalExpenseCost, 0) +
									ISNULL(CostOfProducts.OffBalanceCost, 0) + ISNULL(CostOfProducts.LaborCosts, 0) +
									ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) +
									ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
							ELSE ISNULL(CostOfProducts.CostExcludingVAT, 0) +
								ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) + ISNULL(CostOfProducts.LaborCosts, 0)
								+ ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) +
								ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0) +
								CAST(ISNULL(CostOfProducts.OffBalanceCost, 0) -
								ISNULL(CostOfProducts.OffBalanceCost, 0) * ((ISNULL(ProductsVATRates.VATRate,
								ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS
								NUMBER(35, 6))
						END * InventoryCost.Count
					ELSE CASE
						WHEN TypesOfPrices.PriceIncludesVAT
							THEN InventoryCost.Cost + InventoryCost.AddExpensesForGoods +
								InventoryCost.OffBalanceCost + InventoryCost.LaborCosts +
								InventoryCost.ItemizedFixedCostsIncludingVAT + InventoryCost.ItemizedVariableCostsIncludingVAT
						ELSE InventoryCost.CostExcludingVAT + InventoryCost.AdditionalExpensesExcludingVAT +
							InventoryCost.LaborCosts + InventoryCost.ItemizedFixedCostsExcludingVAT +
							InventoryCost.ItemizedVariableCostsExcludingVAT + CAST(InventoryCost.OffBalanceCost -
							InventoryCost.OffBalanceCost * ((ISNULL(ProductsVATRates.VATRate,
							ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS
							NUMBER(35, 6))
					END
				END
			ELSE CASE
				WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
					THEN CASE
						WHEN TypesOfPrices.PriceIncludesVAT
							THEN ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.OffBalanceCost, 0) +
								ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0)
								+ ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
						ELSE ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.LaborCosts, 0) +
							ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) +
							ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0) +
							CAST(ISNULL(CostOfProducts.OffBalanceCost, 0) -
							ISNULL(CostOfProducts.OffBalanceCost, 0) * ((ISNULL(ProductsVATRates.VATRate,
							ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS
							NUMBER(35, 6))
					END * InventoryCost.Count
				ELSE CASE
					WHEN TypesOfPrices.PriceIncludesVAT
						THEN InventoryCost.Cost + InventoryCost.OffBalanceCost +
							InventoryCost.LaborCosts + InventoryCost.ItemizedFixedCostsIncludingVAT +
							InventoryCost.ItemizedVariableCostsIncludingVAT
					ELSE InventoryCost.CostExcludingVAT + InventoryCost.LaborCosts +
						InventoryCost.ItemizedFixedCostsExcludingVAT + InventoryCost.ItemizedVariableCostsExcludingVAT +
						CAST(InventoryCost.OffBalanceCost - InventoryCost.OffBalanceCost *
						((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
						VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS NUMBER(35, 6))
				END
			END
		END) AS Cost,
		SUM(InventoryCost.Count) AS Count
	FROM
		AccumulationRegister.InventoryCost AS InventoryCost
			LEFT JOIN CostCalculations AS CostCalculations
			ON InventoryCost.Organization = CostCalculations.Organization
			AND BEGINOFPERIOD(InventoryCost.Period, MONTH) = CostCalculations.MonthPeriod
			LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
			ON InventoryCost.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
			AND InventoryCost.Organization = CostOfProducts.Organization
			AND InventoryCost.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
			AND BEGINOFPERIOD(InventoryCost.Period, MONTH) = CostOfProducts.Period
			AND ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
			LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
			ON TypesOfPrices.Ref = &amp;PriceKind
			LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({BEGINOFPERIOD(&amp;DocumentDate, DAY)},
				Country = &amp;CountryOfVATRates) AS ProductsVATRates
			ON InventoryCost.ItemsLocationAttributes.Products = ProductsVATRates.Products
			LEFT JOIN InformationRegister.BasicVATRates.SliceLast({BEGINOFPERIOD(&amp;DocumentDate, DAY)},
				Country = &amp;CountryOfVATRates) AS BasicVATRates
			ON TRUE
	WHERE
		InventoryCost.Period BETWEEN BEGINOFPERIOD(&amp;DocumentDate, MONTH) AND ENDOFPERIOD(&amp;DocumentDate, MONTH)
		AND InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
		AND (InventoryCost.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
			OR InventoryCost.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors)
			OR InventoryCost.ItemsLocationAttributes.Products.ProductKind.ItemsType =
				VALUE(Enum.ItemsTypes.Work_5)
				AND InventoryCost.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department))
		AND NOT InventoryCost.BusinessOperation IN (&amp;ExcludedBusinessTransactions)
	{WHERE
		(InventoryCost.ItemsLocationAttributes.Products,
			InventoryCost.ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
		InventoryCost.Organization.* AS Organization}
	GROUP BY
		InventoryCost.ItemsLocationAttributes.Products,
		InventoryCost.ItemsLocationAttributes.Characteristic,
		InventoryCost.ItemsLocationAttributes.StorageLocation

	UNION ALL

	SELECT
		InventoryCost.ItemsLocationAttributes.StorageLocation,
		InventoryCost.ItemsLocationAttributes.Products,
		InventoryCost.ItemsLocationAttributes.Characteristic,
		SUM(CASE
			WHEN &amp;OptionWithAdditionalCosts = 2
				THEN CASE
					WHEN TypesOfPrices.PriceIncludesVAT
						THEN InventoryCost.CostBalance + InventoryCost.AddExpensesForGoodsBalance +
							InventoryCost.OffBalanceCostBalance + InventoryCost.LaborCostsBalance +
							InventoryCost.ItemizedFixedCostsIncludingVATBalance + InventoryCost.ItemizedVariableCostsIncludingVATBalance
					ELSE InventoryCost.CostExcludingVATBalance + InventoryCost.AdditionalExpensesExcludingVATBalance +
						InventoryCost.LaborCostsBalance + InventoryCost.ItemizedFixedCostsExcludingVATBalance +
						InventoryCost.ItemizedVariableCostsExcludingVATBalance +
						CAST(InventoryCost.OffBalanceCostBalance - InventoryCost.OffBalanceCostBalance *
						((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
						VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS NUMBER(35, 6))
				END
			ELSE CASE
				WHEN TypesOfPrices.PriceIncludesVAT
					THEN InventoryCost.CostBalance + InventoryCost.OffBalanceCostBalance +
						InventoryCost.LaborCostsBalance + InventoryCost.ItemizedFixedCostsIncludingVATBalance +
						InventoryCost.ItemizedVariableCostsIncludingVATBalance
				ELSE InventoryCost.CostExcludingVATBalance + InventoryCost.LaborCostsBalance +
					InventoryCost.ItemizedFixedCostsExcludingVATBalance + InventoryCost.ItemizedVariableCostsExcludingVATBalance
					+ CAST(InventoryCost.OffBalanceCostBalance - InventoryCost.OffBalanceCostBalance
					* ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
					VALUE(Catalog.VATRates.EmptyRef)))).Rate1 / 100) AS NUMBER(35, 6))
			END
		END),
		SUM(InventoryCost.CountBalance)
	FROM
		AccumulationRegister.InventoryCost.Balance(BEGINOFPERIOD(&amp;DocumentDate, MONTH),
			{(ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
			(Organization).* AS Organization}) AS InventoryCost
			LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
			ON TypesOfPrices.Ref = &amp;PriceKind
			LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({BEGINOFPERIOD(&amp;DocumentDate, DAY)},
				Country = &amp;CountryOfVATRates) AS ProductsVATRates
			ON InventoryCost.ItemsLocationAttributes.Products = ProductsVATRates.Products
			LEFT JOIN InformationRegister.BasicVATRates.SliceLast({BEGINOFPERIOD(&amp;DocumentDate, DAY)},
				Country = &amp;CountryOfVATRates) AS BasicVATRates
			ON TRUE
	GROUP BY
		InventoryCost.ItemsLocationAttributes.Products,
		InventoryCost.ItemsLocationAttributes.Characteristic,
		InventoryCost.ItemsLocationAttributes.StorageLocation) AS InventoryCost
		LEFT JOIN Constants AS Constants
		ON TRUE
GROUP BY
	InventoryCost.Products,
	InventoryCost.Characteristic,
	Constants.ManagementAccountingCurrency,
	InventoryCost.Warehouse,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)</query>
	</dataSet>
