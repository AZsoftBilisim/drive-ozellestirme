    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogTypesOfPrices.Ref AS Ref,
	CatalogTypesOfPrices.DeletionMark AS DeletionMark,
	CatalogTypesOfPrices.Predefined AS Predefined,
	CatalogTypesOfPrices.Description AS Description,
	CatalogTypesOfPrices.PriceCurrency AS PriceCurrency,
	CatalogTypesOfPrices.PriceIncludesVAT AS PriceIncludesVAT,
	CatalogTypesOfPrices.UseWhileSellingToCustomers AS UseWhileSellingToCustomers,
	CatalogTypesOfPrices.UseForRetailSalesToCustomers AS UseForRetailSalesToCustomers,
	CatalogTypesOfPrices.PricingMethod AS PricingMethod,
	CatalogTypesOfPrices.RoundUp AS RoundUp,
	CatalogTypesOfPrices.AddlOrderingAttribute AS AddlOrderingAttribute,
	CatalogTypesOfPrices.Id AS Id,
	CatalogTypesOfPrices.Status AS Status,
	CatalogTypesOfPrices.Purpose AS Purpose,
	CASE
		WHEN CatalogTypesOfPrices.IsFolder
			THEN -1
		WHEN CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.Shared)
			THEN 0
		WHEN CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForWarehouse)
			THEN 1
		WHEN CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForStoreFormat)
			THEN 2
		WHEN CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForPartner)
			THEN 3
		WHEN CatalogTypesOfPrices.Purpose = VALUE(Enum.PriceTypesAssignment.SpecialForTermsOfSales)
			THEN 4
	END AS TheIndexOfTheImagePurpose,
	CatalogTypesOfPrices.AuxiliaryPrice AS AuxiliaryPrice,
	CASE
		WHEN CatalogTypesOfPrices.IsFolder
			THEN -1
		WHEN CatalogTypesOfPrices.AuxiliaryPrice
			THEN 0
		ELSE 1
	END AS ImageIndexAuxiliaryPrice,
	CASE
		WHEN CatalogTypesOfPrices.IsFolder
			THEN 3
		WHEN CatalogTypesOfPrices.PricingMethod = VALUE(Enum.PriceSettingMethods.Manually)
			THEN 0
		WHEN CatalogTypesOfPrices.PricingMethod = VALUE(Enum.PriceSettingMethods.FillInByInfobaseData)
			THEN 1
		WHEN
			CatalogTypesOfPrices.PricingMethod = VALUE(Enum.PriceSettingMethods.CalculateUsingFormulasOfOtherPriceTypes)
			THEN 2
		WHEN CatalogTypesOfPrices.PricingMethod = VALUE(Enum.PriceSettingMethods.AnotherPriceTypeMarkup)
			THEN 2
	END AS PictureIndex,
	CatalogTypesOfPrices.IsFolder AS IsFolder,
	CatalogTypesOfPrices.Parent AS Parent,
	0 AS NumberOfWarehouses,
	0 AS NumberOfWarehousesTotal,
	0 AS NumberOfAgreements,
	0 AS NumberOfAgreementsTotal,
	0 AS NumberOfStoreFormats,
	0 AS NumberOfStoreFormatsTotal,
	0 AS NumberOfPartners,
	0 AS NumberOfPartnersTotal
FROM
	Catalog.TypesOfPrices AS CatalogTypesOfPrices</queryText>
      <mainTable>Catalog.TypesOfPrices</mainTable>
