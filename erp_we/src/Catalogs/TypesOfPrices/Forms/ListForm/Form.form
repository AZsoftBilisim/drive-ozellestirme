  <attributes>
    <name>UseInStoreFormats</name>
    <title>
      <key>en</key>
      <value>Use in retail formats</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده در قالب‌های خرده‌فروشی</value>
    </title>
    <title>
      <key>it</key>
      <value>Utilizzo nei formati dei punti vendita</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wykorzystanie w formatach sklepów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использование в форматах магазинов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Mağaza formatlarında kullanım</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng trong khuôn dạng cửa hàng</value>
    </title>
    <id>13</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseStoreFormats</functionalOptions>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	StoreFormats.Ref AS StoreFormat,
	ISNULL(StoreFormatsActions.Status, VALUE(Enum.StatusesOfPriceTypeValidity.NotValid)) AS Status,
	StoreFormats.RetailPriceType,
	CASE WHEN StoreFormats.SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef) THEN FALSE ELSE TRUE END AS ThereIsAnIndividualTypeOfPrices
FROM
	Catalog.StoreFormats AS StoreFormats
		LEFT JOIN (SELECT
			StoreFormatsActions.Ref AS Ref,
			CASE
				WHEN StoreFormatsActions.RetailPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)
					AND StoreFormatsActions.SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)
					THEN VALUE(Enum.StatusesOfPriceTypeValidity.NotValid)
				ELSE VALUE(Enum.StatusesOfPriceTypeValidity.Valid)
			END AS Status
		FROM
			Catalog.StoreFormats AS StoreFormatsActions
		WHERE
			NOT StoreFormatsActions.IsFolder
			AND (StoreFormatsActions.RetailPriceType = &amp;PricesKind
				OR StoreFormatsActions.SpecialPriceType = &amp;PricesKind)) AS StoreFormatsActions
		ON (StoreFormats.Ref = StoreFormatsActions.Ref)
WHERE
	NOT StoreFormats.IsFolder</queryText>
      <mainTable>Catalog.StoreFormats</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
