  <attributes>
    <name>UseInPartners</name>
    <title>
      <key>en</key>
      <value>Use by partners</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده بر اساس شرکای تجاری</value>
    </title>
    <title>
      <key>it</key>
      <value>Utilizzo presso i partner</value>
    </title>
    <title>
      <key>pl</key>
      <value>Używanie w partnerach</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использование в партнерах</value>
    </title>
    <title>
      <key>tr</key>
      <value>İş ortaklarında kullanım</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng trong bạn hàng</value>
    </title>
    <id>15</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UsePartnersAndCounterparties</functionalOptions>
    <functionalOptions>FunctionalOption.UsePartnersAsCounterparties</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInPartners.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Partners.Ref AS Partner,
	ISNULL(ActionPartners.Status, VALUE(Enum.StatusesOfPriceTypeValidity.NotValid)) AS Status,
	Partners.PricesKind,
	CASE WHEN Partners.SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef) THEN FALSE ELSE TRUE END AS ThereIsAnIndividualTypeOfPrices
FROM
	Catalog.Partners AS Partners
		LEFT JOIN (SELECT
			ActionPartners.Ref AS Ref,
			CASE
				WHEN ActionPartners.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
					AND ActionPartners.SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)				
					THEN VALUE(Enum.StatusesOfPriceTypeValidity.NotValid)
				ELSE VALUE(Enum.StatusesOfPriceTypeValidity.Valid)
			END AS Status
		FROM
			Catalog.Partners AS ActionPartners
		WHERE
			ActionPartners.PricesKind = &amp;PricesKind
			OR ActionPartners.SpecialPriceType = &amp;PricesKind) AS ActionPartners
		ON (Partners.Ref = ActionPartners.Ref)</queryText>
      <mainTable>Catalog.Partners</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
