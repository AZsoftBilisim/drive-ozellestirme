  <attributes>
    <name>UseInWarehouses</name>
    <title>
      <key>en</key>
      <value>Use in warehouses</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده در انبارها</value>
    </title>
    <title>
      <key>it</key>
      <value>L'utilizzo nei magazzini</value>
    </title>
    <title>
      <key>pl</key>
      <value>Używanie w magazynach</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использование на складах</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ambarlarda kullanım</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng trong kho bãi</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseSeveralWarehouses</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInWarehouses.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInWarehouses.ДатаОкончания</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Warehouses.Ref AS Warehouse,
	ISNULL(ActionWarehouses.Status, VALUE(Enum.StatusesOfPriceTypeValidity.NotValid)) AS Status,
	Warehouses.AccountingPriceType,
	Warehouses.RetailPriceType,
	CASE WHEN Warehouses.SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef) THEN FALSE ELSE TRUE END AS ThereIsAnIndividualTypeOfPrices
FROM
	Catalog.Warehouses AS Warehouses
		LEFT JOIN (SELECT
			ActionWarehouses.Ref AS Ref,
			CASE
				WHEN ActionWarehouses.RetailPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)
				AND ActionWarehouses.AccountingPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)
				AND ActionWarehouses.SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)
					THEN VALUE(Enum.StatusesOfPriceTypeValidity.NotValid)
				ELSE VALUE(Enum.StatusesOfPriceTypeValidity.Valid)
			END AS Status
		FROM
			Catalog.Warehouses AS ActionWarehouses
		WHERE
			NOT ActionWarehouses.IsFolder
			AND (ActionWarehouses.AccountingPriceType = &amp;PricesKind
			OR ActionWarehouses.RetailPriceType = &amp;PricesKind
			OR ActionWarehouses.SpecialPriceType = &amp;PricesKind)) AS ActionWarehouses
		ON (Warehouses.Ref = ActionWarehouses.Ref)
WHERE
	NOT Warehouses.IsFolder</queryText>
      <mainTable>Catalog.Warehouses</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>StartShipmentOnceDeliveryOrderIsCreated</dataPath>
        <field>StartShipmentOnceDeliveryOrderIsCreated</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>UseItemsBatch</dataPath>
        <field>UseItemsBatch</field>
