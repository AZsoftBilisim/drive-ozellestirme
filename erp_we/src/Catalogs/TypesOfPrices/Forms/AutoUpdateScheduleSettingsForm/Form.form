    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	TypesOfPrices.Parent AS Parent,
	TypesOfPrices.IsFolder AS IsFolder,
	TypesOfPrices.Ref AS TheLinkToViewPrices,
	TypesOfPrices.Description AS Description,
	TypesOfPrices.PriceCurrency AS Currency,
	FALSE AS Selected,
	CASE
		WHEN TypesOfPrices.IsFolder
			THEN 0
		ELSE 2
	END AS Picture,
	TypesOfPrices.Status,
	TypesOfPrices.PricingMethod
FROM
	Catalog.TypesOfPrices AS TypesOfPrices</queryText>
      <mainTable>Catalog.TypesOfPrices</mainTable>
