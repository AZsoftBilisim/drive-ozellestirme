  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogTypesOfPrices.Ref AS Ref,
	CatalogTypesOfPrices.DeletionMark AS DeletionMark,
	CatalogTypesOfPrices.Parent AS Parent,
	CatalogTypesOfPrices.IsFolder AS IsFolder,
	CatalogTypesOfPrices.Description AS Description,
	CASE
		WHEN Partners.Ref IS NOT NULL
			THEN Partners.Ref
		WHEN TermsOfSale.Ref IS NOT NULL
			THEN TermsOfSale.Ref
		WHEN Warehouses.Ref IS NOT NULL
			THEN Warehouses.Ref
		WHEN StoreFormats.Ref IS NOT NULL
			THEN StoreFormats.Ref
		ELSE &amp;OwnerOfAnIndividualPriceType
	END AS OwnerOfAnIndividualPriceType
FROM
	Catalog.TypesOfPrices AS CatalogTypesOfPrices
		LEFT JOIN Catalog.Partners AS Partners
		ON Partners.SpecialPriceType = CatalogTypesOfPrices.Ref
		LEFT JOIN Catalog.TermsOfSale AS TermsOfSale
		ON CatalogTypesOfPrices.Ref = TermsOfSale.SpecialPriceType
		LEFT JOIN Catalog.StoreFormats AS StoreFormats
		ON StoreFormats.SpecialPriceType = CatalogTypesOfPrices.Ref
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON Warehouses.SpecialPriceType = CatalogTypesOfPrices.Ref</queryText>
      <mainTable>Catalog.TypesOfPrices</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
