      <key>tr</key>
      <value>Ona kutusu yapılandırılmış ise, yuvarlama aritmetik kurallara göre değil, her zaman yukarı doğru gerçekleşir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
