  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogItemsCharacteristics.Ref,
	CatalogItemsCharacteristics.DeletionMark,
	CatalogItemsCharacteristics.Owner,
	CatalogItemsCharacteristics.Description AS Description,
	CatalogItemsCharacteristics.DescriptionFull,
	CatalogItemsCharacteristics.Principal,
	CatalogItemsCharacteristics.Counterparty,
	CatalogItemsCharacteristics.AdditionalAttributes,
	CatalogItemsCharacteristics.Predefined,
	CatalogItemsCharacteristics.PredefinedDataName
FROM
	Catalog.ItemsCharacteristics AS CatalogItemsCharacteristics
		{LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
		ON ProductKitConfigurations.Owner = &amp;Products
		AND ProductKitConfigurations.Characteristic = CatalogItemsCharacteristics.Ref
		AND ProductKitConfigurations.Main}
{WHERE
	CASE WHEN ISNULL(ProductKitConfigurations.SetPricingOption, VALUE(Enum.SetPriceCalculationOptions.EmptyRef)) IN (&amp;SetPriceCalculationOptions) THEN
		TRUE
	ELSE
		FALSE
	END,
	ProductKitConfigurations.ContainsServices,
	ProductKitConfigurations.ContainsGoods}</queryText>
      <mainTable>Catalog.ItemsCharacteristics</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
