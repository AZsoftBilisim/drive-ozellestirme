    <toolTip>
      <key>it</key>
      <value>Disponibilità massima del centro operativo nell'intervallo di pianificazione</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Maksymalna dostępność jednego centrum pracy w interwale planowania</value>
