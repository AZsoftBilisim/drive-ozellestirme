  <attributes uuid="61bc7cfb-b543-4d95-9d4a-a385ef6a1477">
    <name>MaximumWorkCenterAvailability</name>
    <synonym>
      <key>en</key>
      <value>Maximum work center capacity</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>حداکثر ظرفیت مرکز کاری</value>
