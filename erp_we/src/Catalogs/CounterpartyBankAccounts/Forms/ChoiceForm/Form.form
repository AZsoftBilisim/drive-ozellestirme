  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BankAccountsOverridable.Owner AS Owner,
	BankAccountsOverridable.Description AS Description,
	BankAccountsOverridable.AccountNumber AS AccountNumber,
	CASE
		WHEN BankAccountsOverridable.ManualBankDetailsChange
			THEN BankAccountsOverridable.BankBIC
		ELSE BankClassifier.Code
	END AS BankBIC,
	CASE
		WHEN BankAccountsOverridable.ManualBankDetailsChange
			THEN BankAccountsOverridable.BankDescription
		ELSE BankClassifier.Description
	END AS BankDescription,
	CASE
		WHEN BankAccountsOverridable.ManualBankDetailsChange
			THEN BankAccountsOverridable.BankCity
		ELSE BankClassifier.City
	END AS BankCity,
	BankAccountsOverridable.CashCurrency AS CashCurrency,
	BankAccountsOverridable.Closed AS Closed,
	BankAccountsOverridable.Ref AS Ref
FROM
	Catalog.CounterpartyBankAccounts AS BankAccountsOverridable
		LEFT JOIN Catalog.BankClassifier AS BankClassifier
		ON BankAccountsOverridable.Bank = BankClassifier.Ref</queryText>
      <mainTable>Catalog.CounterpartyBankAccounts</mainTable>
