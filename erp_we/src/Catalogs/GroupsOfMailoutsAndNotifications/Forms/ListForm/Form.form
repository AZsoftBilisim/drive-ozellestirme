  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogGroupsOfMailoutsAndNotifications.Ref,
	CatalogGroupsOfMailoutsAndNotifications.Description,
	CASE
		WHEN CatalogGroupsOfMailoutsAndNotifications.DesignedForEmails
				AND CatalogGroupsOfMailoutsAndNotifications.DesignedForSMSMessage
			THEN &amp;ForEmailsAndSMS
		WHEN CatalogGroupsOfMailoutsAndNotifications.DesignedForEmails
			THEN &amp;ForEmails_2
		ELSE &amp;ForSMS
	END AS Purpose,
	CatalogGroupsOfMailoutsAndNotifications.Forced,
	CatalogGroupsOfMailoutsAndNotifications.MessageRetentionPeriod,
	CatalogGroupsOfMailoutsAndNotifications.LongDesc
FROM
	Catalog.GroupsOfMailoutsAndNotifications AS CatalogGroupsOfMailoutsAndNotifications
WHERE
	CASE
			WHEN &amp;UseOtherInteractions
				THEN TRUE
			ELSE CatalogGroupsOfMailoutsAndNotifications.DesignedForEmails
		END</queryText>
      <mainTable>Catalog.GroupsOfMailoutsAndNotifications</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
