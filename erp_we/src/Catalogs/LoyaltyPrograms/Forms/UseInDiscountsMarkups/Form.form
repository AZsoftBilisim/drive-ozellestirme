    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DiscountsMarkups.Ref AS DiscountMarkup,
	DiscountsMarkups.Predefined,
	DiscountsMarkups.DeletionMark,
	DiscountsMarkups.Description,
	DiscountsMarkups.LoyaltyProgram
FROM
	Catalog.DiscountsMarkups AS DiscountsMarkups
WHERE
	DiscountsMarkups.DiscountApplicationMethod = VALUE(Enum.DiscountMarkupApplicationMethods.GrantBonusPoints)</queryText>
      <mainTable>Catalog.DiscountsMarkups</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
