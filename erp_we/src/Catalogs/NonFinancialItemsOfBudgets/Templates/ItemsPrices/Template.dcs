		<field xsi:type="DataSetFieldField">
			<dataPath>Characteristic</dataPath>
			<field>Characteristic</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	&amp;Period AS Period,
	ItemPricesCrossSectionOfTheLatest.Recorder,
	ItemPricesCrossSectionOfTheLatest.Products,
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.Currency,
	ItemPricesCrossSectionOfTheLatest.Price AS IndicatorValue
FROM
	InformationRegister.ItemsPrices.SliceLast(&amp;Period, ) AS ItemPricesCrossSectionOfTheLatest</query>
	</dataSet>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
