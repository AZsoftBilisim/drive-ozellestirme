  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogNonFinancialItemsOfBudgets.Ref AS Ref,
	CatalogNonFinancialItemsOfBudgets.DeletionMark AS DeletionMark,
	CatalogNonFinancialItemsOfBudgets.Parent AS Parent,
	CatalogNonFinancialItemsOfBudgets.IsFolder AS IsFolder,
	CatalogNonFinancialItemsOfBudgets.Code AS Code,
	CatalogNonFinancialItemsOfBudgets.Description AS Description,
	CatalogNonFinancialItemsOfBudgets.Periodicity AS Periodicity,
	CatalogNonFinancialItemsOfBudgets.IndicatorKind AS IndicatorKind,
	CatalogNonFinancialItemsOfBudgets.DimensionKind1 AS DimensionKind1,
	CatalogNonFinancialItemsOfBudgets.DimensionKind2 AS DimensionKind2,
	CatalogNonFinancialItemsOfBudgets.DimensionKind3 AS DimensionKind3,
	CatalogNonFinancialItemsOfBudgets.DimensionKind4 AS DimensionKind4,
	CatalogNonFinancialItemsOfBudgets.DimensionKind5 AS DimensionKind5,
	CatalogNonFinancialItemsOfBudgets.DimensionKind6 AS DimensionKind6,
	MAX(CASE
			WHEN TemplateMetrics_.Factor IS NULL
				THEN FALSE
			ELSE TRUE
		END) AS TemplateAvailability
FROM
	Catalog.NonFinancialItemsOfBudgets AS CatalogNonFinancialItemsOfBudgets
		LEFT JOIN Catalog.NonFinancialItemProfiles.TemplateIndicators AS TemplateMetrics_
		ON CatalogNonFinancialItemsOfBudgets.Ref = TemplateMetrics_.Factor

GROUP BY
	CatalogNonFinancialItemsOfBudgets.Ref,
	CatalogNonFinancialItemsOfBudgets.DeletionMark,
	CatalogNonFinancialItemsOfBudgets.Parent,
	CatalogNonFinancialItemsOfBudgets.IsFolder,
	CatalogNonFinancialItemsOfBudgets.Code,
	CatalogNonFinancialItemsOfBudgets.Description,
	CatalogNonFinancialItemsOfBudgets.IndicatorKind,
	CatalogNonFinancialItemsOfBudgets.DimensionKind1,
	CatalogNonFinancialItemsOfBudgets.DimensionKind2,
	CatalogNonFinancialItemsOfBudgets.DimensionKind3,
	CatalogNonFinancialItemsOfBudgets.DimensionKind4,
	CatalogNonFinancialItemsOfBudgets.DimensionKind5,
	CatalogNonFinancialItemsOfBudgets.DimensionKind6</queryText>
      <mainTable>Catalog.NonFinancialItemsOfBudgets</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
