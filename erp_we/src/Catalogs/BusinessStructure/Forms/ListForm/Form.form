  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.AddlOrderingAttribute</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ProductionBusinessUnit</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       BusinessStructure.Ref, 
       BusinessStructure.DeletionMark, 
       BusinessStructure.Parent, 
       BusinessStructure.Code, 
       BusinessStructure.Description, 
       BusinessStructure.BusinessUnitManager, 
       BusinessStructure.OptionOfAssignedAccountingOfGoods, 
       BusinessStructure.Source, 
       BusinessStructure.CompliesWithLegalEntityStructure, 
       BusinessStructure.ProductionBusinessUnit, 
       BusinessStructure.WorkScheduleCalendar, 
       BusinessStructure.PlanningInterval, 
       BusinessStructure.PlanningIntervalStart, 
       BusinessStructure.PlanningIntervalEnd, 
       BusinessStructure.OperationSheetManagement, 
       BusinessStructure.AddlOrderingAttribute, 
       BusinessStructure.FillInAvailabilityForWorkCenterTimetableNumberOfIntervals, 
       BusinessStructure.FillInAvailabilityForWorkCenterTimetableReminderDays, 
       BusinessStructure.FillInAvailabilityForProductionScheduleIntervalQuantity, 
       BusinessStructure.OperationManagementMethod, 
       BusinessStructure.FillInAvailabilityForProductionScheduleReminderDays, 
       BusinessStructure.ProductionDispatcherBusinessUnit, 
       BusinessStructure.UseItemsBatch, 
       BusinessStructure.StandardTimeToRegisterOperationExecution, 
       BusinessStructure.StandardTimeToRegisterOperationExecutionUnit, 
       BusinessStructure.UseCostAccountingByBatches, 
       BusinessStructure.ProductionByOrders, 
       BusinessStructure.BackflushProduction_, 
       BusinessStructure.RecordingExpensesOnProcustCostIsUsed, 
       BusinessStructure.SemiFinishedProductsReceiptMethod, 
       BusinessStructure.UseOperationManagement, 
       BusinessStructure.UseMaterialsInOperations, 
       BusinessStructure.UseFinishedProductsInOperations, 
       BusinessStructure.UseManufacturingExecutionSystem, 
       BusinessStructure.OutputRegistrationFrequency, 
       BusinessStructure.UseLPR, 
       BusinessStructure.UseTariffRates, 
       BusinessStructure.UseHoursWorked, 
       BusinessStructure.UseTeamWorkOrders, 
       BusinessStructure.UsePersonalWorkOrders, 
       BusinessStructure.WorkScheduleSetupMethod, 
       BusinessStructure.UseShiftTasks, 
       BusinessStructure.UseProductionSites, 
       BusinessStructure.SourceCode, 
       BusinessStructure.Status, 
       BusinessStructure.ProductionScheduleExtensionFactor, 
       BusinessStructure.WorkSchedules.*, 
       BusinessStructure.AdditionalAttributes.*, 
       BusinessStructure.Predefined, 
       BusinessStructure.PredefinedDataName, 
       BusinessStructure.DescriptionLanguage1, 
       BusinessStructure.DescriptionLanguage2
 FROM 
       Catalog.BusinessStructure
 AS 
       BusinessStructure</queryText>
      <mainTable>Catalog.BusinessStructure</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
