    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ItemKinds.Ref AS ProductKind,
	WarehouseSeriesAccountingPolicies_.BatchAccountingPolicy
FROM
	Catalog.ItemKinds AS ItemKinds
		LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS WarehouseSeriesAccountingPolicies_
		ON ItemKinds.Ref = WarehouseSeriesAccountingPolicies_.Ref
			AND (WarehouseSeriesAccountingPolicies_.Warehouse = &amp;Department)
WHERE
	ItemKinds.KeepAccountingByBatch</queryText>
      <mainTable>Catalog.ItemKinds</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
