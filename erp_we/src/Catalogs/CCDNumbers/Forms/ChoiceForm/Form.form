    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Components.Ref AS Ref,
	Components.LineNumber AS LineNumber,
	Components.ProductBatchIDNumber AS ProductBatchIDNumber,
	Components.QuantityByGBRN AS QuantityByGBRN,
	Components.FEACNUnitOfMeasure AS UnitOfMeasure
FROM
	Catalog.CCDNumbers.TraceableComponents AS Components</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
