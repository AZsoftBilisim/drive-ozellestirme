  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.CCDNumberType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Code</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.NumberOfComponents_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.OriginCountry</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CCDNumbers.Ref AS Ref,
	CCDNumbers.DeletionMark AS DeletionMark,
	CCDNumbers.Code AS Code,
	CCDNumbers.OriginCountry AS OriginCountry,
	CCDNumbers.RegistrationNumber AS RegistrationNumber,
	CCDNumbers.ImportingCountryIsNotRF AS ImportingCountryIsNotRF,
	CCDNumbers.GoodsSequenceNumber AS GoodsSequenceNumber,
	CCDNumbers.CCDNumberType AS CCDNumberType,
	CCDNumbers.NumberOfComponents_ AS NumberOfComponents_,
	CCDNumbers.Predefined AS Predefined,
	CCDNumbers.PredefinedDataName AS PredefinedDataName,
	CASE
		WHEN NOT CCDNumbers.DeletionMark
			THEN CASE
					WHEN CCDNumbers.CCDNumberType = VALUE(Enum.CCDNumberTypes.CCDNumber)
						THEN 0
					WHEN CCDNumbers.CCDNumberType = VALUE(Enum.CCDNumberTypes.ProductBatchIDNumber)
						THEN 1
					ELSE 2
				END
		ELSE CASE
				WHEN CCDNumbers.CCDNumberType = VALUE(Enum.CCDNumberTypes.CCDNumber)
					THEN 3
				WHEN CCDNumbers.CCDNumberType = VALUE(Enum.CCDNumberTypes.ProductBatchIDNumber)
					THEN 4
				ELSE 5
			END
	END AS PictureIndex
FROM
	Catalog.CCDNumbers AS CCDNumbers</queryText>
      <mainTable>Catalog.CCDNumbers</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
