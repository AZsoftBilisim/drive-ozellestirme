    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogRulesForIntegrationWith1CDocumentManagement3.Ref,
	CatalogRulesForIntegrationWith1CDocumentManagement3.DeletionMark,
	CatalogRulesForIntegrationWith1CDocumentManagement3.ObjectTypeIS AS ObjectTypeIS,
	CatalogRulesForIntegrationWith1CDocumentManagement3.ObjectPresentationISWithKeyFields AS ObjectPresentationISWithKeyFields,
	CatalogRulesForIntegrationWith1CDocumentManagement3.RepresentationOfDMObjectWithKeyAttributes AS RepresentationOfDMObjectWithKeyAttributes,
	CatalogRulesForIntegrationWith1CDocumentManagement3.Comment AS Comment
FROM
	Catalog.RulesForIntegrationWith1CDocumentManagement3 AS CatalogRulesForIntegrationWith1CDocumentManagement3</queryText>
      <mainTable>Catalog.RulesForIntegrationWith1CDocumentManagement3</mainTable>
