		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentPartners.Partner
INTO SegmentContent
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
{WHERE
	SegmentPartners.Segment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
INTO ExchangeRatesWithdrawal
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(, BaseCurrency = &amp;BaseCurrency) AS ExchangeRates
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Calculations.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	SUM(Calculations.LocalBalanceIsAmountDueToBeTakenIntoAccount) AS LocalBalanceIsAmountDueToBeTakenIntoAccount,
	SUM(Calculations.ManSBalanceAmountDueForPayment) AS ManSBalanceAmountDueForPayment
INTO TTOverdueDebtWithdrawal
FROM
	(SELECT
		CustomersARAPAccountingByDueDatesBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		CustomersARAPAccountingByDueDatesBalance.DebtLocalBalance AS LocalBalanceIsAmountDueToBeTakenIntoAccount,
		CustomersARAPAccountingByDueDatesBalance.ARAPManBalance AS ManSBalanceAmountDueForPayment
	
	FROM
		AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(, {PlannedRepaymentDate &lt; BEGINOFPERIOD(&amp;CheckDate, DAY)}) AS CustomersARAPAccountingByDueDatesBalance
	WHERE
		&amp;NewOnlineARAPAccounting

	UNION ALL

	SELECT
		CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		CustomersARAPAccountingCashFlowPlanBalance.AmountDueBalance * ISNULL(Currency_Rates.CourseNumerator, 1) * ISNULL(LocalCurrencyRates.CourseDenominator, 1) / (ISNULL(LocalCurrencyRates.CourseNumerator, 1) * ISNULL(Currency_Rates.CourseDenominator, 1)) AS LocalBalanceIsAmountDueToBeTakenIntoAccount,
		CustomersARAPAccountingCashFlowPlanBalance.AmountDueBalance * ISNULL(Currency_Rates.CourseNumerator, 1) * ISNULL(ManSExchangeRates.CourseDenominator, 1) / (ISNULL(ManSExchangeRates.CourseNumerator, 1) * ISNULL(Currency_Rates.CourseDenominator, 1)) AS ManSBalanceAmountDueForPayment
	FROM
		AccumulationRegister.CustomersARAPAccountingCashFlowPlan.Balance(, {PlannedRepaymentDate &lt; BEGINOFPERIOD(&amp;CheckDate, DAY)}) AS CustomersARAPAccountingCashFlowPlanBalance
		LEFT JOIN ExchangeRatesWithdrawal AS Currency_Rates
		ON CustomersARAPAccountingCashFlowPlanBalance.Currency = Currency_Rates.Currency
		
		LEFT JOIN ExchangeRatesWithdrawal AS ManSExchangeRates
		ON ManSExchangeRates.Currency = &amp;ManagementAccountingCurrency
		
		LEFT JOIN ExchangeRatesWithdrawal AS LocalCurrencyRates
		ON CustomersARAPAccountingCashFlowPlanBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency = LocalCurrencyRates.Currency
	WHERE
		&amp;NewOnlineARAPAccounting

	UNION ALL

	SELECT
		CustomersARAPAccountingBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		CustomersARAPAccountingBalance.AmountDueBalance * ISNULL(Currency_Rates.CourseNumerator, 1) * ISNULL(LocalCurrencyRates.CourseDenominator, 1) / (ISNULL(LocalCurrencyRates.CourseNumerator, 1) * ISNULL(Currency_Rates.CourseDenominator, 1)) AS LocalBalanceIsAmountDueToBeTakenIntoAccount,
		CustomersARAPAccountingBalance.AmountDueBalance * ISNULL(Currency_Rates.CourseNumerator, 1) * ISNULL(ManSExchangeRates.CourseDenominator, 1) / (ISNULL(ManSExchangeRates.CourseNumerator, 1) * ISNULL(Currency_Rates.CourseDenominator, 1)) AS ManSBalanceAmountDueForPayment
	FROM
		AccumulationRegister.CustomersARAPAccounting.Balance({(&amp;CheckDate)}, ) AS CustomersARAPAccountingBalance
		LEFT JOIN ExchangeRatesWithdrawal AS Currency_Rates
		ON CustomersARAPAccountingBalance.Currency = Currency_Rates.Currency
		
		LEFT JOIN ExchangeRatesWithdrawal AS ManSExchangeRates
		ON ManSExchangeRates.Currency = &amp;ManagementAccountingCurrency
		
		LEFT JOIN ExchangeRatesWithdrawal AS LocalCurrencyRates
		ON CustomersARAPAccountingBalance.AccountingDimensionByPartners.Organization.LocalAccountingCurrency = LocalCurrencyRates.Currency
	WHERE
		NOT &amp;NewOnlineARAPAccounting
	) AS Calculations
 GROUP BY
 	Calculations.AccountingDimensionByPartners
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DimensionAccounting_1.Partner AS Partner,
	SUM(CASE
			WHEN ARAPOverdue.ManSBalanceAmountDueForPayment &gt; 0
				THEN ARAPOverdue.ManSBalanceAmountDueForPayment
			ELSE 0
		END) AS CustomerDebtOverdueInManSCurrency,
	SUM(CASE
			WHEN ARAPOverdue.LocalBalanceIsAmountDueToBeTakenIntoAccount &gt; 0
				THEN ARAPOverdue.LocalBalanceIsAmountDueToBeTakenIntoAccount
			ELSE 0
		END) AS CustomerDebtOverdueInLocalCurrency
INTO PartnerDebtWithdrawal
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance({(&amp;CurrentDate)}, ) AS Calculations
		INNER JOIN TTOverdueDebtWithdrawal AS ARAPOverdue
		ON (ARAPOverdue.AccountingDimensionByPartners = Calculations.AccountingDimensionByPartners)
		INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
		ON Calculations.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey
WHERE
	DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

GROUP BY
	DimensionAccounting_1.Partner
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	CustomersARAPAccountingBalance.AccountingDimensionByPartners.Partner AS Partner,
	CustomersARAPAccountingBalance.SumBalance AS SumBalance,
	CustomersARAPAccountingBalance.ARAPObject AS ARAPObject,
	CustomersARAPAccountingBalance.Currency AS Currency
INTO CalculationResiduesOutput
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance(
			,
			AccountingDimensionByPartners.Partner IN
				(SELECT
					SegmentContent.Partner
				FROM
					SegmentContent AS SegmentContent)) AS CustomersARAPAccountingBalance
	
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SegmentContent.Partner AS Partner,
	SUM(CASE
			WHEN ISNULL(CalculationResiduesOutput.SumBalance, 0) &lt; 0
				THEN -ISNULL(CalculationResiduesOutput.SumBalance, 0) * ISNULL(SettlementCurrencyRatesWithdrawal.CourseNumerator, 1) * ISNULL(CurrencyExchangeRatesManWithdrawal.CourseDenominator, 1) / (ISNULL(CurrencyExchangeRatesManWithdrawal.CourseNumerator, 1) * ISNULL(SettlementCurrencyRatesWithdrawal.CourseDenominator, 1))
			ELSE 0
		END) AS AccountsPayableOfCompany,
	SUM(CASE
			WHEN ISNULL(CalculationResiduesOutput.SumBalance, 0) &gt; 0
				THEN ISNULL(CalculationResiduesOutput.SumBalance, 0) * ISNULL(SettlementCurrencyRatesWithdrawal.CourseNumerator, 1) * ISNULL(CurrencyExchangeRatesManWithdrawal.CourseDenominator, 1) / (ISNULL(CurrencyExchangeRatesManWithdrawal.CourseNumerator, 1) * ISNULL(SettlementCurrencyRatesWithdrawal.CourseDenominator, 1))
			ELSE 0
		END) AS PartnerDebt_,
	MAX(ISNULL(PartnerDebtWithdrawal.CustomerDebtOverdueInManSCurrency, 0)) AS CustomerDebtOverdueInManSCurrency,
	MAX(ISNULL(PartnerDebtWithdrawal.CustomerDebtOverdueInLocalCurrency, 0)) AS CustomerDebtOverdueInLocalCurrency
INTO TTCalculations
FROM
	SegmentContent AS SegmentContent
	LEFT JOIN CalculationResiduesOutput AS CalculationResiduesOutput
	ON SegmentContent.Partner = CalculationResiduesOutput.Partner
	LEFT JOIN ExchangeRatesWithdrawal AS SettlementCurrencyRatesWithdrawal
	ON CalculationResiduesOutput.Currency = SettlementCurrencyRatesWithdrawal.Currency
	LEFT JOIN ExchangeRatesWithdrawal AS CurrencyExchangeRatesManWithdrawal
	ON CurrencyExchangeRatesManWithdrawal.Currency = &amp;ManagementAccountingCurrency
	LEFT JOIN PartnerDebtWithdrawal AS PartnerDebtWithdrawal
	ON CalculationResiduesOutput.Partner = PartnerDebtWithdrawal.Partner
	
GROUP BY
	SegmentContent.Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTCalculations.Partner AS Partner,
	TTCalculations.AccountsPayableOfCompany AS AccountsPayableOfCompany,
	TTCalculations.PartnerDebt_ AS PartnerDebt_,
	TTCalculations.CustomerDebtOverdueInManSCurrency AS CustomerDebtOverdueInManSCurrency,
	TTCalculations.CustomerDebtOverdueInLocalCurrency AS CustomerDebtOverdueInLocalCurrency
{SELECT
	Partner.* AS SegmentPartner,
	AccountsPayableOfCompany AS OurCurrentDebt,
	PartnerDebt_ AS CurPartnerDebt,
	CustomerDebtOverdueInManSCurrency,
	CustomerDebtOverdueInLocalCurrency}
FROM
	TTCalculations AS TTCalculations</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
