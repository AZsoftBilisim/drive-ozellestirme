		<field xsi:type="DataSetFieldField">
			<dataPath>CustomerDebtOverdueInManSCurrency</dataPath>
			<field>CustomerDebtOverdueInManSCurrency</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Planned overdue payments in management accounting currency</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>پرداخت‌های سررسیدگذشته برنامه‌ریزی‌شده به ارز حسابداری مدیریت</v8:content>
