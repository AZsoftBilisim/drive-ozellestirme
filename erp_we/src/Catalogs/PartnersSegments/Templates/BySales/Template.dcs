				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>RevenueTurnover</dataPath>
			<field>RevenueTurnover</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Revenue turnover</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>گردش درآمد</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Ricavo fatturato</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Zysk obrót</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Выручка оборот</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Gelir ciro</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Doanh thu phát sinh</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentPartners.Partner
INTO SegmentContent
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
{WHERE
	SegmentPartners.Segment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DimensionByPartners.Partner AS Partner,
	RevenueAndCost.RevenueAmountTurnover AS Revenue,
	RevenueAndCost.CostTurnover AS Cost_,
	CAST(RevenueAndCost.RevenueAmountTurnover - RevenueAndCost.AddExpensesForGoodsTurnover - RevenueAndCost.CostTurnover AS NUMBER(31,2)) AS GrossProfit,
	RevenueAndCost.AddExpensesForGoodsTurnover AS AddExpensesForGoods,
	RevenueAndCost.Recorder AS Recorder
{SELECT
	Partner.* AS SegmentPartner,
	Revenue AS RevenueTurnover,
	Cost_ AS Cost_Turnover,
	GrossProfit AS GrossProfitTurnover,
	AddExpensesForGoods AS AddExpensesForGoodsTurnover,
	Recorder AS DocumentRecorder}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;PeriodEnding)},
			Auto,
			AccountingDimensionByPartners.Partner IN
				(SELECT
					SegmentContent.Partner
				FROM
					SegmentContent AS SegmentContent) {(AccountingDimensionByPartners.Counterparty).* AS Counterparty, (AccountingDimensionByPartners.Organization).* AS Organization}) AS RevenueAndCost
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>GrossProfitTurnover</dataPath>
		<expression>Sum(GrossProfitTurnover)</expression>
	</totalField>
	<totalField>
		<dataPath>Cost_Turnover</dataPath>
		<expression>Sum(Cost_Turnover)</expression>
	</totalField>
	<totalField>
		<dataPath>AddExpensesForGoodsTurnover</dataPath>
		<expression>Sum(AddExpensesForGoodsTurnover)</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueTurnover</dataPath>
		<expression>Sum(RevenueTurnover)</expression>
	</totalField>
