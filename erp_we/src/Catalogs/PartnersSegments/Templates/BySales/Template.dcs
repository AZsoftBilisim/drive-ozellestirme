		<field xsi:type="DataSetFieldField">
			<dataPath>AddExpensesForGoods</dataPath>
			<field>AddExpensesForGoods</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Additional expense amount</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مبلغ هزینه تکمیلی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Importo delle spese aggiuntive</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Suma dod. kosztów</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма доп. расходов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Ek giderler tutarı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số tiền chi phí bổ sung</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	NestedQuery.Partner AS Partner,
	NestedQuery.Revenue,
	NestedQuery.Cost_,
	NestedQuery.GrossProfit,
	NestedQuery.AddExpensesForGoods
{SELECT
	Partner}
FROM
	(SELECT
		DimensionByPartners.Partner AS Partner,
		SUM(RevenueAndCost.RevenueAmountTurnover) AS Revenue,
		SUM(RevenueAndCost.CostTurnover) AS Cost_,
		SUM(CAST(RevenueAndCost.RevenueAmountTurnover - RevenueAndCost.AddExpensesForGoodsTurnover - RevenueAndCost.CostTurnover AS NUMBER(31,2))) AS GrossProfit,
		SUM(RevenueAndCost.AddExpensesForGoodsTurnover) AS AddExpensesForGoods
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;PeriodEnding)}, Period, ) AS RevenueAndCost
			LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
			ON RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	{WHERE
		DimensionByPartners.Partner.*,
		DimensionByPartners.Counterparty.*,
		DimensionByPartners.Organization.*}
	
	GROUP BY
		DimensionByPartners.Partner) AS NestedQuery
{WHERE
	NestedQuery.Revenue,
	NestedQuery.Cost_,
	NestedQuery.GrossProfit,
	NestedQuery.AddExpensesForGoods}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
