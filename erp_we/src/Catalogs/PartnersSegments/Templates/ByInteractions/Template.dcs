		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentPartners.Partner
INTO SegmentContent
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
{WHERE
	SegmentPartners.Segment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN Document.Contact REFS Catalog.Partners
			THEN Document.Contact
		ELSE Document.Contact.Owner
	END AS Contact,
	Document.Ref AS Ref,
	Document.Ref.Date AS Date,
	1 AS NumberOfInteractions
{SELECT
	Contact.* AS SegmentPartner,
	Ref.* AS InteractionsDocument,
	Date AS LastInteractionDate,
	NumberOfInteractions}
FROM
	Document.Meeting.Attendees AS Document
WHERE
	(Document.Contact REFS Catalog.Partners
			OR Document.Contact REFS Catalog.ContactPersonsForPartners)
	AND CASE
			WHEN Document.Contact REFS Catalog.Partners
				THEN Document.Contact IN
						(SELECT
							SegmentContent.Partner
						FROM
							SegmentContent AS SegmentContent)
			ELSE Document.Contact.Owner IN
					(SELECT
						SegmentContent.Partner
					FROM
						SegmentContent AS SegmentContent)
		END
{WHERE
	(Document.Ref.Date &gt;= &amp;StartDate),
	(Document.Ref.Date &lt;= &amp;EndDate)}

UNION ALL

SELECT
	CASE
		WHEN Document.SubscriberContact REFS Catalog.Partners
			THEN Document.SubscriberContact
		ELSE Document.SubscriberContact.Owner
	END,
	Document.Ref,
	Document.Date,
	1
FROM
	Document.PhoneCall AS Document
WHERE
	(Document.SubscriberContact REFS Catalog.Partners
			OR Document.SubscriberContact REFS Catalog.ContactPersonsForPartners)
	AND CASE
			WHEN Document.SubscriberContact REFS Catalog.Partners
				THEN Document.SubscriberContact IN
						(SELECT
							SegmentContent.Partner
						FROM
							SegmentContent AS SegmentContent)
			ELSE Document.SubscriberContact.Owner IN
					(SELECT
						SegmentContent.Partner
					FROM
						SegmentContent AS SegmentContent)
		END
{WHERE
	(Document.Date &gt;= &amp;StartDate),
	(Document.Date &lt;= &amp;EndDate)}

UNION ALL

SELECT
	CASE
		WHEN Document.SenderContact REFS Catalog.Partners
			THEN Document.SenderContact
		ELSE Document.SenderContact.Owner
	END,
	Document.Ref,
	Document.Ref.Date,
	1
FROM
	Document.IncomingEmail AS Document
WHERE
	(Document.SenderContact REFS Catalog.Partners
			OR Document.SenderContact REFS Catalog.ContactPersonsForPartners)
	AND CASE
			WHEN Document.SenderContact REFS Catalog.Partners
				THEN Document.SenderContact IN
						(SELECT
							SegmentContent.Partner
						FROM
							SegmentContent AS SegmentContent)
			ELSE Document.SenderContact.Owner IN
					(SELECT
						SegmentContent.Partner
					FROM
						SegmentContent AS SegmentContent)
		END
{WHERE
	(Document.Ref.Date &gt;= &amp;StartDate),
	(Document.Ref.Date &lt;= &amp;EndDate)}

UNION ALL

SELECT
	CASE
		WHEN Document.Contact REFS Catalog.Partners
			THEN Document.Contact
		ELSE Document.Contact.Owner
	END,
	Document.Ref,
	Document.Ref.Date,
	1
FROM
	Document.OutgoingEmail.EmailRecipients AS Document
WHERE
	(Document.Contact REFS Catalog.Partners
			OR Document.Contact REFS Catalog.ContactPersonsForPartners)
	AND CASE
			WHEN Document.Contact REFS Catalog.Partners
				THEN Document.Contact IN
						(SELECT
							SegmentContent.Partner
						FROM
							SegmentContent AS SegmentContent)
			ELSE Document.Contact.Owner IN
					(SELECT
						SegmentContent.Partner
					FROM
						SegmentContent AS SegmentContent)
		END
{WHERE
	(Document.Ref.Date &gt;= &amp;StartDate),
	(Document.Ref.Date &lt;= &amp;EndDate)}

UNION ALL

SELECT
	CASE
		WHEN Document.Contact REFS Catalog.Partners
			THEN Document.Contact
		ELSE Document.Contact.Owner
	END,
	Document.Ref,
	Document.Ref.Date,
	1
FROM
	Document.OutgoingEmail.CCRecipients AS Document
WHERE
	(Document.Contact REFS Catalog.Partners
			OR Document.Contact REFS Catalog.ContactPersonsForPartners)
	AND CASE
			WHEN Document.Contact REFS Catalog.Partners
				THEN Document.Contact IN
						(SELECT
							SegmentContent.Partner
						FROM
							SegmentContent AS SegmentContent)
			ELSE Document.Contact.Owner IN
					(SELECT
						SegmentContent.Partner
					FROM
						SegmentContent AS SegmentContent)
		END
{WHERE
	(Document.Ref.Date &gt;= &amp;StartDate),
	(Document.Ref.Date &lt;= &amp;EndDate)}

UNION ALL

SELECT DISTINCT
	CASE
		WHEN Document.Contact REFS Catalog.Partners
			THEN Document.Contact
		ELSE Document.Contact.Owner
	END,
	Document.Ref,
	Document.Ref.Date,
	1
FROM
	Document.OutgoingEmail.BccRecipients AS Document
WHERE
	(Document.Contact REFS Catalog.Partners
			OR Document.Contact REFS Catalog.ContactPersonsForPartners)
	AND CASE
			WHEN Document.Contact REFS Catalog.Partners
				THEN Document.Contact IN
						(SELECT
							SegmentContent.Partner
						FROM
							SegmentContent AS SegmentContent)
			ELSE Document.Contact.Owner IN
					(SELECT
						SegmentContent.Partner
					FROM
						SegmentContent AS SegmentContent)
		END
{WHERE
	(Document.Ref.Date &gt;= &amp;StartDate),
	(Document.Ref.Date &lt;= &amp;EndDate)}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>LastInteractionDate</dataPath>
		<expression>Max(LastInteractionDate)</expression>
		<group>SegmentPartner</group>
	</totalField>
	<totalField>
		<dataPath>NumberOfInteractions</dataPath>
		<expression>Sum(NumberOfInteractions)</expression>
		<group>SegmentPartner</group>
	</totalField>
	<parameter>
		<name>StartDate</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Start date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تاریخ شروع</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Data di inizio</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Data rozpoczęcia</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Başlangıç tarihi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Ngày bắt đầu</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Period.StartDate</expression>
		<availableAsField>false</availableAsField>
