		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	NestedQuery.Partner AS Partner
{SELECT
	Partner.*}
FROM
	(SELECT
		NestedQuery.Contact AS Partner,
		COUNT(DISTINCT NestedQuery.Ref) AS CountOfInteractions,
		MAX(NestedQuery.Date) AS LastInteractionDate
	FROM
		(SELECT
			CASE
				WHEN Document.Contact REFS Catalog.Partners
					THEN Document.Contact
				ELSE Document.Contact.Owner
			END AS Contact,
			Document.Ref AS Ref,
			Document.Ref.Date AS Date
		FROM
			Document.Meeting.Attendees AS Document
		WHERE
			(Document.Contact REFS Catalog.Partners
					OR Document.Contact REFS Catalog.ContactPersonsForPartners)
		{WHERE
			(Document.Ref.Date &gt;= &amp;StartDate),
			(Document.Ref.Date &lt;= &amp;EndDate)}
		
		UNION ALL
		
		SELECT
			CASE
				WHEN Document.SubscriberContact REFS Catalog.Partners
					THEN Document.SubscriberContact
				ELSE Document.SubscriberContact.Owner
			END,
			Document.Ref,
			Document.Date
		FROM
			Document.PhoneCall AS Document
		WHERE
			(Document.SubscriberContact REFS Catalog.Partners
					OR Document.SubscriberContact REFS Catalog.ContactPersonsForPartners)
		{WHERE
			(Document.Date &gt;= &amp;StartDate),
			(Document.Date &lt;= &amp;EndDate)}
		
		UNION ALL
		
		SELECT
			CASE
				WHEN Document.SenderContact REFS Catalog.Partners
					THEN Document.SenderContact
				ELSE Document.SenderContact.Owner
			END,
			Document.Ref,
			Document.Ref.Date
		FROM
			Document.IncomingEmail AS Document
		WHERE
			(Document.SenderContact REFS Catalog.Partners
					OR Document.SenderContact REFS Catalog.ContactPersonsForPartners)
		{WHERE
			(Document.Ref.Date &gt;= &amp;StartDate),
			(Document.Ref.Date &lt;= &amp;EndDate)}
		
		UNION ALL
		
		SELECT
			CASE
				WHEN Document.Contact REFS Catalog.Partners
					THEN Document.Contact
				ELSE Document.Contact.Owner
			END,
			Document.Ref,
			Document.Ref.Date
		FROM
			Document.OutgoingEmail.EmailRecipients AS Document
		WHERE
			(Document.Contact REFS Catalog.Partners
					OR Document.Contact REFS Catalog.ContactPersonsForPartners)
		{WHERE
			(Document.Ref.Date &gt;= &amp;StartDate),
			(Document.Ref.Date &lt;= &amp;EndDate)}
		
		UNION ALL
		
		SELECT
			CASE
				WHEN Document.Contact REFS Catalog.Partners
					THEN Document.Contact
				ELSE Document.Contact.Owner
			END,
			Document.Ref,
			Document.Ref.Date
		FROM
			Document.OutgoingEmail.CCRecipients AS Document
		WHERE
			(Document.Contact REFS Catalog.Partners
					OR Document.Contact REFS Catalog.ContactPersonsForPartners)
		{WHERE
			(Document.Ref.Date &gt;= &amp;StartDate),
			(Document.Ref.Date &lt;= &amp;EndDate)}
		
		UNION ALL
		
		SELECT DISTINCT
			CASE
				WHEN Document.Contact REFS Catalog.Partners
					THEN Document.Contact
				ELSE Document.Contact.Owner
			END,
			Document.Ref,
			Document.Ref.Date
		FROM
			Document.OutgoingEmail.BccRecipients AS Document
		WHERE
			(Document.Contact REFS Catalog.Partners
					OR Document.Contact REFS Catalog.ContactPersonsForPartners)
		{WHERE
			(Document.Ref.Date &gt;= &amp;StartDate),
			(Document.Ref.Date &lt;= &amp;EndDate)}) AS NestedQuery
	{WHERE
		NestedQuery.Contact.* AS Partner}
	
	GROUP BY
		NestedQuery.Contact) AS NestedQuery
{WHERE
	NestedQuery.CountOfInteractions,
	NestedQuery.LastInteractionDate}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
