		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RecordsIncomeExpensesOtherAssetsLiabilities.Recorder AS Recorder,
	RecordsIncomeExpensesOtherAssetsLiabilities.SecondPeriod AS SecondPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.DayPeriod AS DayPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.WeekPeriod AS WeekPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.TenDaysPeriod AS TenDaysPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.MonthPeriod AS MonthPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.QuarterPeriod AS QuarterPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.HalfYearPeriod AS HalfYearPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.YearPeriod AS YearPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.DayPeriod AS RatePeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.BusinessOperation AS BusinessOperation,
	RecordsIncomeExpensesOtherAssetsLiabilities.BusinessOperation AS DataSource,
	RecordsIncomeExpensesOtherAssetsLiabilities.Organization AS Organization,
	RecordsIncomeExpensesOtherAssetsLiabilities.Department AS Department,
	RecordsIncomeExpensesOtherAssetsLiabilities.LineOfBusiness AS LineOfBusiness,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorLineOfBusiness AS CorLineOfBusiness,
	RecordsIncomeExpensesOtherAssetsLiabilities.AssetRef AS AssetRef,
	RecordsIncomeExpensesOtherAssetsLiabilities.DimensionOfRevenue AS DimensionOfRevenue,
	RecordsIncomeExpensesOtherAssetsLiabilities.DimensionOfExpenses AS DimensionOfExpenses,
	RecordsIncomeExpensesOtherAssetsLiabilities.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.DebitBusinessUnit AS DebitBusinessUnit,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorItem AS CorItem,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorIncomeDimension AS CorIncomeDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorExpenditureDimension AS CorExpenditureDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorDimensionOfAssetsLiabilities AS CorDimensionOfAssetsLiabilities,
	RecordsIncomeExpensesOtherAssetsLiabilities.FinancialAccountingGroup AS FinancialAccountingGroup,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorFinancialAccountingGroup AS CorFinancialAccountingGroup,
	RecordsIncomeExpensesOtherAssetsLiabilities.Counterparty AS Counterparty,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorCounterparty AS CorCounterparty,
	RecordsIncomeExpensesOtherAssetsLiabilities.SumTurnover AS Sum,
	RecordsIncomeExpensesOtherAssetsLiabilities.SumManTurnover AS SumMan,
	RecordsIncomeExpensesOtherAssetsLiabilities.SumComplTurnover AS SumCompl
{SELECT
	Recorder.*,
	SecondPeriod,
	YearPeriod,
	HalfYearPeriod,
	QuarterPeriod,
	MonthPeriod,
	TenDaysPeriod,
	WeekPeriod,
	DayPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	CorLineOfBusiness.*,
	AssetRef.*,
	DimensionOfRevenue.*,
	DimensionOfExpenses.*,
	AssetsLiabilitiesDimension.*,
	DebitBusinessUnit.*,
	CorItem.*,
	CorIncomeDimension.*,
	CorExpenditureDimension.*,
	CorDimensionOfAssetsLiabilities.*,
	FinancialAccountingGroup.*,
	CorFinancialAccountingGroup.*,
	Counterparty.*,
	CorCounterparty.*,
	SumCompl,
	SumMan,
	Sum}
FROM
	AccumulationRegister.RecordsIncomeExpensesOtherAssetsLiabilities.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (BusinessOperation IN (&amp;BusinessOperation)), (BusinessOperation), (BusinessOperation) AS DataSource, (AssetRef).*, (DimensionOfRevenue).*, (DimensionOfExpenses).*, (AssetsLiabilitiesDimension).*, (CorItem).*, (CorIncomeDimension).*, (CorExpenditureDimension).*, (CorDimensionOfAssetsLiabilities).*, (Organization).*, (Department).*, (DebitBusinessUnit).*, (LineOfBusiness).*, (CorLineOfBusiness).*, (FinancialAccountingGroup).*, (CorFinancialAccountingGroup).*, (Counterparty).*, (CorCounterparty).*}) AS RecordsIncomeExpensesOtherAssetsLiabilities
{WHERE
	RecordsIncomeExpensesOtherAssetsLiabilities.Organization.* AS Organization,
	RecordsIncomeExpensesOtherAssetsLiabilities.Department.* AS Department,
	RecordsIncomeExpensesOtherAssetsLiabilities.LineOfBusiness.* AS LineOfBusiness,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorLineOfBusiness.* AS CorLineOfBusiness,
	RecordsIncomeExpensesOtherAssetsLiabilities.AssetRef.* AS AssetRef,
	RecordsIncomeExpensesOtherAssetsLiabilities.DimensionOfRevenue.* AS DimensionOfRevenue,
	RecordsIncomeExpensesOtherAssetsLiabilities.DimensionOfExpenses.* AS DimensionOfExpenses,
	RecordsIncomeExpensesOtherAssetsLiabilities.AssetsLiabilitiesDimension.* AS AssetsLiabilitiesDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.DebitBusinessUnit.* AS DebitBusinessUnit,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorItem.* AS CorItem,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorIncomeDimension.* AS CorIncomeDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorExpenditureDimension.* AS CorExpenditureDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorDimensionOfAssetsLiabilities.* AS CorDimensionOfAssetsLiabilities,
	RecordsIncomeExpensesOtherAssetsLiabilities.FinancialAccountingGroup.* AS FinancialAccountingGroup,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorFinancialAccountingGroup.* AS CorFinancialAccountingGroup,
	RecordsIncomeExpensesOtherAssetsLiabilities.Counterparty.* AS Counterparty,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorCounterparty.* AS CorCounterparty,
	
	RecordsIncomeExpensesOtherAssetsLiabilities.Recorder.*,
	RecordsIncomeExpensesOtherAssetsLiabilities.YearPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.HalfYearPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.QuarterPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.MonthPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.TenDaysPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.WeekPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.DayPeriod,
	RecordsIncomeExpensesOtherAssetsLiabilities.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
