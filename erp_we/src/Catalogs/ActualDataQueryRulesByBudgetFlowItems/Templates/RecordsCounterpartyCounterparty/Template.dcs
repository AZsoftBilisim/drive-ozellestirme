					<v8:content>منبع داده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Origine dei dati</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Źródło danych</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Источник данных</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Veri kaynağı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Nguồn dữ liệu</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SecondPeriod</dataPath>
			<field>SecondPeriod</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period, second</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره، ثانیه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo, secondo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres, sekunda</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период, секунда</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem, saniye</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ, giây</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RecordsCounterpartyCounterparty.Recorder AS Recorder,
	RecordsCounterpartyCounterparty.SecondPeriod AS SecondPeriod,
	RecordsCounterpartyCounterparty.DayPeriod AS DayPeriod,
	RecordsCounterpartyCounterparty.WeekPeriod AS WeekPeriod,
	RecordsCounterpartyCounterparty.TenDaysPeriod AS TenDaysPeriod,
	RecordsCounterpartyCounterparty.MonthPeriod AS MonthPeriod,
	RecordsCounterpartyCounterparty.QuarterPeriod AS QuarterPeriod,
	RecordsCounterpartyCounterparty.HalfYearPeriod AS HalfYearPeriod,
	RecordsCounterpartyCounterparty.YearPeriod AS YearPeriod,
	RecordsCounterpartyCounterparty.DayPeriod AS RatePeriod,
	RecordsCounterpartyCounterparty.BusinessOperation AS BusinessOperation,
	RecordsCounterpartyCounterparty.BusinessOperation AS DataSource,
	RecordsCounterpartyCounterparty.Organization AS Organization,
	RecordsCounterpartyCounterparty.Department AS Department,
	RecordsCounterpartyCounterparty.LineOfBusiness AS LineOfBusiness,
	RecordsCounterpartyCounterparty.CorLineOfBusiness AS CorLineOfBusiness,
	RecordsCounterpartyCounterparty.Partner AS Partner,
	RecordsCounterpartyCounterparty.CorPartner AS CorPartner,
	RecordsCounterpartyCounterparty.Counterparty AS Counterparty,
	RecordsCounterpartyCounterparty.CorCounterparty AS CorCounterparty,
	RecordsCounterpartyCounterparty.Contract AS Contract,
	RecordsCounterpartyCounterparty.CorContract AS CorContract,
	RecordsCounterpartyCounterparty.ARAPObject AS ARAPObject,
	RecordsCounterpartyCounterparty.CorARAPObject AS CorARAPObject,
	RecordsCounterpartyCounterparty.SumTurnover AS Sum,
	RecordsCounterpartyCounterparty.SumComplTurnover AS SumCompl,
	RecordsCounterpartyCounterparty.AmountExcludingVATTurnover AS AmountExcludingVAT,
	RecordsCounterpartyCounterparty.LocalAmountExcludingVATTurnover AS LocalAmountExcludingVAT
{SELECT
	Recorder.*,
	SecondPeriod,
	YearPeriod,
	HalfYearPeriod,
	QuarterPeriod,
	MonthPeriod,
	TenDaysPeriod,
	WeekPeriod,
	DayPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	CorLineOfBusiness.*,
	Partner.*,
	CorPartner.*,
	Counterparty.*,
	CorCounterparty.*,
	Contract.*,
	CorContract.*,
	ARAPObject.*,
	CorARAPObject.*,
	Sum,
	SumCompl,
	AmountExcludingVAT,
	LocalAmountExcludingVAT}
FROM
	AccumulationRegister.RecordsCounterpartyCounterparty.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
			{("DataSourceID") AS DataSourceID,
				(BusinessOperation IN (&amp;BusinessOperation)), (BusinessOperation),
				(BusinessOperation) AS DataSource,
				
				(Organization).*,
				(Department).*,
				(LineOfBusiness).*,
				(CorLineOfBusiness).*,
				(Partner).*,
				(CorPartner).*,
				(Counterparty).*,
				(CorCounterparty).*,
				(Contract).*,
				(CorContract).*,
				(ARAPObject).*,
				(CorARAPObject).*
			}
	) AS RecordsCounterpartyCounterparty
{WHERE
	// Fields for selection by add.details.
	RecordsCounterpartyCounterparty.Organization.* AS Organization,
	RecordsCounterpartyCounterparty.Department.* AS Department,
	RecordsCounterpartyCounterparty.LineOfBusiness.* AS LineOfBusiness,
	RecordsCounterpartyCounterparty.CorLineOfBusiness.* AS CorLineOfBusiness,
	RecordsCounterpartyCounterparty.Partner.* AS Partner,
	RecordsCounterpartyCounterparty.CorPartner.* AS CorPartner,
	RecordsCounterpartyCounterparty.Counterparty.* AS Counterparty,
	RecordsCounterpartyCounterparty.CorCounterparty.* AS CorCounterparty,
	RecordsCounterpartyCounterparty.Contract.* AS Contract,
	RecordsCounterpartyCounterparty.CorContract.* AS CorContract,
	RecordsCounterpartyCounterparty.ARAPObject.* AS ARAPObject,
	RecordsCounterpartyCounterparty.CorARAPObject.* AS CorARAPObject,
	
	// Fields for selection by period and for the formation of a stored fact.
	RecordsCounterpartyCounterparty.Recorder.*,
	RecordsCounterpartyCounterparty.YearPeriod,
	RecordsCounterpartyCounterparty.HalfYearPeriod,
	RecordsCounterpartyCounterparty.QuarterPeriod,
	RecordsCounterpartyCounterparty.MonthPeriod,
	RecordsCounterpartyCounterparty.TenDaysPeriod,
	RecordsCounterpartyCounterparty.WeekPeriod,
	RecordsCounterpartyCounterparty.DayPeriod,
	RecordsCounterpartyCounterparty.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
