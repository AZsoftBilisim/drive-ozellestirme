		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	HistoryOfStoreFormats.Warehouse AS Warehouse,
	HistoryOfStoreFormats.StoreFormat AS StoreFormat
INTO HistoryOfStoreFormats
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(&amp;BeginOfPeriod, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID}) AS HistoryOfStoreFormats
{WHERE
	HistoryOfStoreFormats.Warehouse.* AS Warehouse}

INDEX BY
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsLocationAttributes.DimensionKey AS DimensionKey,
	ItemsLocationAttributes.Products AS Products,
	ItemsLocationAttributes.Products.ItemsType AS ItemsType,
	ItemsLocationAttributes.Products.ProductKind AS ProductKind,
	ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
	ItemsLocationAttributes.Products.Brand AS Brand,
	ItemsLocationAttributes.Products.Manufacturer AS Manufacturer,
	ItemsLocationAttributes.Products.ItemsGroup AS ItemsGroup,
	ItemsLocationAttributes.Products.PriceGroup AS PriceGroup,
	ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	ItemsLocationAttributes.StorageLocation AS Warehouse,
	ISNULL(HistoryOfStoreFormats.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) AS StoreFormat
INTO ItemsLocationAttributes
FROM
	InformationRegister.ItemsLocationAttributes AS ItemsLocationAttributes
		LEFT JOIN HistoryOfStoreFormats AS HistoryOfStoreFormats
		ON ItemsLocationAttributes.StorageLocation = HistoryOfStoreFormats.Warehouse
{WHERE
	ItemsLocationAttributes.Products.* AS Products,
	ItemsLocationAttributes.Products.ItemsType.* AS ItemsType,
	ItemsLocationAttributes.Products.ProductKind.* AS ProductKind,
	ItemsLocationAttributes.Products.UnitOfMeasure.* AS UnitOfMeasure,
	ItemsLocationAttributes.Products.Brand.* AS Brand,
	ItemsLocationAttributes.Products.Manufacturer.* AS Manufacturer,
	ItemsLocationAttributes.Products.ItemsGroup.* AS ItemsGroup,
	ItemsLocationAttributes.Products.PriceGroup.* AS PriceGroup,
	ItemsLocationAttributes.Products.ProductCategory.* AS ProductCategory,
	ItemsLocationAttributes.StorageLocation.* AS Warehouse,
	(ISNULL(HistoryOfStoreFormats.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef))).* AS StoreFormat}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AccountingDimensionByPartners.DimensionKey AS DimensionKey,
	AccountingDimensionByPartners.Organization AS Organization,
	AccountingDimensionByPartners.Counterparty AS Counterparty,
	AccountingDimensionByPartners.Partner AS Partner
INTO AccountingDimensionByPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
{WHERE
	AccountingDimensionByPartners.Organization.* AS Organization,
	AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	AccountingDimensionByPartners.Partner.* AS Partner}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterData.Recorder AS Recorder,
	RegisterData.SecondPeriod AS SecondPeriod,
	RegisterData.DayPeriod AS DayPeriod,
	RegisterData.WeekPeriod AS WeekPeriod,
	RegisterData.TenDaysPeriod AS TenDaysPeriod,
	RegisterData.MonthPeriod AS MonthPeriod,
	RegisterData.QuarterPeriod AS QuarterPeriod,
	RegisterData.HalfYearPeriod AS HalfYearPeriod,
	RegisterData.YearPeriod AS YearPeriod,
	RegisterData.DayPeriod AS RatePeriod,
	PartnerAccountingAnalyticsKeys.Organization AS Organization,
	PartnerAccountingAnalyticsKeys.Counterparty AS Counterparty,
	PartnerAccountingAnalyticsKeys.Partner AS Partner,
	RegisterData.Department AS Department,
	RegisterData.Manager AS Manager,
	ProductAccountingAnalyticsKeys.Products AS Products,
	ProductAccountingAnalyticsKeys.ItemsType AS ItemsType,
	ProductAccountingAnalyticsKeys.ProductKind AS ProductKind,
	ProductAccountingAnalyticsKeys.UnitOfMeasure AS UnitOfMeasure,
	ProductAccountingAnalyticsKeys.Brand AS Brand,
	ProductAccountingAnalyticsKeys.Manufacturer AS Manufacturer,
	ProductAccountingAnalyticsKeys.ItemsGroup AS ItemsGroup,
	ProductAccountingAnalyticsKeys.PriceGroup AS PriceGroup,
	ProductAccountingAnalyticsKeys.ProductCategory AS ProductCategory,
	ProductAccountingAnalyticsKeys.Warehouse AS Warehouse,
	ProductAccountingAnalyticsKeys.StoreFormat AS StoreFormat,
	RegisterData.InventoryType AS InventoryType,
	RegisterData.Contract AS Contract,
	RegisterData.SalesOrder AS SalesOrder,
	RegisterData.CountTurnover AS Count,
	RegisterData.RevenueAmountTurnover AS RevenueAmount,
	RegisterData.RevenueAmountExcludingVATTurnover AS RevenueAmountExcludingVAT,
	RegisterData.RevenueAmountIncludingVATLocalTurnover AS RevenueAmountIncludingVATLocal,
	RegisterData.RevenueAmountExclVATLocalTurnover AS RevenueAmountExclVATLocal,
	RegisterData.RevenueAmountTurnover - RegisterData.RevenueAmountExcludingVATTurnover AS VATAmount,
	RegisterData.RevenueAmountIncludingVATLocalTurnover - RegisterData.RevenueAmountExclVATLocalTurnover AS VATAmountCompl,
	RegisterData.CostTurnover AS Cost,
	RegisterData.CostExcludingVATTurnover AS CostExcludingVAT,
	RegisterData.CostManTurnover AS CostMan,
	RegisterData.LocalCostTurnover AS LocalCost,
	RegisterData.CostExcludingVATTurnover + RegisterData.AdditionalExpensesExcludingVATTurnover + RegisterData.ItemizedFixedCostsExcludingVATTurnover + RegisterData.LaborCostsTurnover + RegisterData.ItemizedVariableCostsExcludingVATTurnover AS CostExcludingVAT_,
	CASE
		WHEN RegisterData.CostManTurnover + RegisterData.AddExpensesManTurnover + RegisterData.ItemizedFixedCostsManagTurnover + RegisterData.LaborCostsManTurnover + RegisterData.ItemizedVariableCostsManagTurnover = 0
			THEN RegisterData.CostTurnover + RegisterData.AddExpensesForGoodsTurnover + RegisterData.ItemizedFixedCostsIncludingVATTurnover + RegisterData.LaborCostsTurnover + RegisterData.ItemizedVariableCostsIncludingVATTurnover
		ELSE RegisterData.CostManTurnover + RegisterData.AddExpensesManTurnover + RegisterData.ItemizedFixedCostsManagTurnover + RegisterData.LaborCostsManTurnover + RegisterData.ItemizedVariableCostsManagTurnover
	END AS ManagementCost,
	RegisterData.LocalCostTurnover + RegisterData.AddExpensesLocalTurnover + RegisterData.ItemizedFixedCostsComplTurnover + RegisterData.LaborCostsLocalTurnover + RegisterData.ItemizedVariableCostsComplTurnover AS CostLocal,
	RegisterData.AddExpensesForGoodsTurnover AS AddExpensesForGoods,
	RegisterData.AdditionalExpensesExcludingVATTurnover AS AdditionalExpensesExcludingVAT,
	RegisterData.AddExpensesManTurnover AS AddExpensesMan,
	RegisterData.AddExpensesLocalTurnover AS AddExpensesLocal,
	RegisterData.AddExpensesForGoodsTurnover - RegisterData.AdditionalExpensesExcludingVATTurnover AS VATAmountOfAdditionalExpenses,
	RegisterData.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	RegisterData.ProductLineOfBusiness AS ProductLineOfBusiness,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.BusinessOperation AS DataSource
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	Organization.*,
	Counterparty.*,
	CounterpartyLineOfBusiness.*,
	Partner.*,
	Department.*,
	Manager.*,
	Products.*,
	ProductLineOfBusiness.*,
	ItemsType.*,
	ProductKind.*,
	UnitOfMeasure.*,
	Brand.*,
	Manufacturer.*,
	ItemsGroup.*,
	PriceGroup.*,
	ProductCategory.*,
	Warehouse.*,
	StoreFormat.*,
	InventoryType.*,
	Contract.*,
	SalesOrder.*,
	Count,
	RevenueAmount,
	RevenueAmountExcludingVAT,
	RevenueAmountIncludingVATLocal,
	RevenueAmountExclVATLocal,
	VATAmount,
	VATAmountCompl,
	Cost,
	CostExcludingVAT,
	CostMan,
	LocalCost,
	CostExcludingVAT_,
	ManagementCost,
	CostLocal,
	AddExpensesForGoods,
	AdditionalExpensesExcludingVAT,
	AddExpensesMan,
	AddExpensesLocal,
	VATAmountOfAdditionalExpenses}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(
			&amp;BeginOfPeriod,
			&amp;EndOfPeriod,
			Auto,
			ItemsLocationAttributes IN
					(SELECT
						ItemsLocationAttributes.DimensionKey
					FROM
						ItemsLocationAttributes)
				AND AccountingDimensionByPartners IN
					(SELECT
						AccountingDimensionByPartners.DimensionKey
					FROM
						AccountingDimensionByPartners)
				AND &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (BusinessOperation IN (&amp;BusinessOperation)), (BusinessOperation), (BusinessOperation) AS DataSource, (Manager).*, (InventoryType).*, (Contract).*, (SalesOrder).*, (Department).*, (CounterpartyLineOfBusiness).*, (ProductLineOfBusiness).*, (AccountingDimensionByPartners.Organization).* AS Organization, (AccountingDimensionByPartners.Counterparty).* AS Counterparty, (AccountingDimensionByPartners.Partner).* AS Partner, (ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Products.ItemsType).* AS ItemsType, (ItemsLocationAttributes.Products.ProductKind).* AS ProductKind, (ItemsLocationAttributes.Products.UnitOfMeasure).* AS UnitOfMeasure, (ItemsLocationAttributes.Products.Brand).* AS Brand, (ItemsLocationAttributes.Products.Manufacturer).* AS Manufacturer, (ItemsLocationAttributes.Products.ItemsGroup).* AS ItemsGroup, (ItemsLocationAttributes.Products.PriceGroup).* AS PriceGroup, (ItemsLocationAttributes.Products.ProductCategory).* AS ProductCategory, (ItemsLocationAttributes.StorageLocation).* AS Warehouse}) AS RegisterData
		{LEFT JOIN ItemsLocationAttributes AS ProductAccountingAnalyticsKeys
		ON RegisterData.ItemsLocationAttributes = ProductAccountingAnalyticsKeys.DimensionKey
		LEFT JOIN AccountingDimensionByPartners AS PartnerAccountingAnalyticsKeys
		ON RegisterData.AccountingDimensionByPartners = PartnerAccountingAnalyticsKeys.DimensionKey}
{WHERE
	RegisterData.Department.* AS Department,
	RegisterData.Manager.* AS Manager,
	RegisterData.Contract.* AS Contract,
	RegisterData.SalesOrder.* AS SalesOrder,
	RegisterData.CounterpartyLineOfBusiness.* AS CounterpartyLineOfBusiness,
	RegisterData.ProductLineOfBusiness.* AS ProductLineOfBusiness,
	
	RegisterData.Recorder.* AS Recorder,
	RegisterData.YearPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.MonthPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.WeekPeriod,
	RegisterData.DayPeriod,
	RegisterData.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
