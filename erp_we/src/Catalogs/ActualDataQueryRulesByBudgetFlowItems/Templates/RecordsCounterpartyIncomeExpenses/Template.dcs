		<field xsi:type="DataSetFieldField">
			<dataPath>SecondPeriod</dataPath>
			<field>SecondPeriod</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period, second</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره، ثانیه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo, secondo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres, sekunda</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период, секунда</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem, saniye</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ, giây</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RecordsCounterpartyIncomeExpenses.Recorder AS Recorder,
	RecordsCounterpartyIncomeExpenses.SecondPeriod AS SecondPeriod,
	RecordsCounterpartyIncomeExpenses.DayPeriod AS DayPeriod,
	RecordsCounterpartyIncomeExpenses.WeekPeriod AS WeekPeriod,
	RecordsCounterpartyIncomeExpenses.TenDaysPeriod AS TenDaysPeriod,
	RecordsCounterpartyIncomeExpenses.MonthPeriod AS MonthPeriod,
	RecordsCounterpartyIncomeExpenses.QuarterPeriod AS QuarterPeriod,
	RecordsCounterpartyIncomeExpenses.HalfYearPeriod AS HalfYearPeriod,
	RecordsCounterpartyIncomeExpenses.YearPeriod AS YearPeriod,
	RecordsCounterpartyIncomeExpenses.DayPeriod AS RatePeriod,
	RecordsCounterpartyIncomeExpenses.BusinessOperation AS BusinessOperation,
	RecordsCounterpartyIncomeExpenses.BusinessOperation AS DataSource,
	RecordsCounterpartyIncomeExpenses.Organization AS Organization,
	RecordsCounterpartyIncomeExpenses.Department AS Department,
	RecordsCounterpartyIncomeExpenses.Partner AS Partner,
	RecordsCounterpartyIncomeExpenses.Counterparty AS Counterparty,
	RecordsCounterpartyIncomeExpenses.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	RecordsCounterpartyIncomeExpenses.Contract AS Contract,
	RecordsCounterpartyIncomeExpenses.ARAPObject AS ARAPObject,
	RecordsCounterpartyIncomeExpenses.IncomeAndExpenseItem AS IncomeAndExpenseItem,
	RecordsCounterpartyIncomeExpenses.LineOfBusinessItems AS LineOfBusinessItems,
	RecordsCounterpartyIncomeExpenses.DimensionOfRevenue AS DimensionOfRevenue,
	RecordsCounterpartyIncomeExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	RecordsCounterpartyIncomeExpenses.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	RecordsCounterpartyIncomeExpenses.SumTurnover AS Sum,
	RecordsCounterpartyIncomeExpenses.AmountExcludingVATTurnover AS AmountExcludingVAT,
	RecordsCounterpartyIncomeExpenses.SumComplTurnover AS SumCompl,
	RecordsCounterpartyIncomeExpenses.LocalAmountExcludingVATTurnover AS LocalAmountExcludingVAT,
	RecordsCounterpartyIncomeExpenses.SumTurnover - RecordsCounterpartyIncomeExpenses.AmountExcludingVATTurnover AS VATAmount,
	RecordsCounterpartyIncomeExpenses.SumComplTurnover - RecordsCounterpartyIncomeExpenses.LocalAmountExcludingVATTurnover AS VATAmountCompl
{SELECT
	Recorder.*,
	SecondPeriod,
	YearPeriod,
	HalfYearPeriod,
	QuarterPeriod,
	MonthPeriod,
	TenDaysPeriod,
	WeekPeriod,
	DayPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	Organization.*,
	Department.*,
	Partner.*,
	Counterparty.*,
	CounterpartyLineOfBusiness.*,
	Contract.*,
	ARAPObject.*,
	IncomeAndExpenseItem.*,
	LineOfBusinessItems.*,
	DimensionOfRevenue.*,
	DimensionOfExpenses.*,
	AssetsLiabilitiesDimension.*,
	Sum,
	AmountExcludingVAT,
	SumCompl,
	LocalAmountExcludingVAT,
	VATAmount,
	VATAmountCompl}
FROM
	AccumulationRegister.RecordsCounterpartyIncomeExpenses.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (BusinessOperation IN (&amp;BusinessOperation)), (BusinessOperation), (BusinessOperation) AS DataSource, (Partner).*, (Counterparty).*, (Contract).*, (ARAPObject).*, (IncomeAndExpenseItem).*, (DimensionOfRevenue).*, (DimensionOfExpenses).*, (AssetsLiabilitiesDimension).*, (Organization).*, (Department).*, (CounterpartyLineOfBusiness).*, (LineOfBusinessItems).*}) AS RecordsCounterpartyIncomeExpenses
{WHERE
	// Fields for optimal selection by additional details (selection is imposed outside the fields of the virtual table in the WHERE section)
	RecordsCounterpartyIncomeExpenses.Organization.* AS Organization,
	RecordsCounterpartyIncomeExpenses.Department.* AS Department,
	RecordsCounterpartyIncomeExpenses.Partner.* AS Partner,
	RecordsCounterpartyIncomeExpenses.Counterparty.* AS Counterparty,
	RecordsCounterpartyIncomeExpenses.CounterpartyLineOfBusiness.* AS CounterpartyLineOfBusiness,
	RecordsCounterpartyIncomeExpenses.Contract.* AS Contract,
	RecordsCounterpartyIncomeExpenses.ARAPObject.* AS ARAPObject,
	RecordsCounterpartyIncomeExpenses.IncomeAndExpenseItem.* AS IncomeAndExpenseItem,
	RecordsCounterpartyIncomeExpenses.LineOfBusinessItems.* AS LineOfBusinessItems,
	RecordsCounterpartyIncomeExpenses.DimensionOfRevenue.* AS DimensionOfRevenue,
	RecordsCounterpartyIncomeExpenses.DimensionOfExpenses.* AS DimensionOfExpenses,
	RecordsCounterpartyIncomeExpenses.AssetsLiabilitiesDimension.* AS AssetsLiabilitiesDimension,
	
	RecordsCounterpartyIncomeExpenses.Recorder.*,
	RecordsCounterpartyIncomeExpenses.YearPeriod,
	RecordsCounterpartyIncomeExpenses.HalfYearPeriod,
	RecordsCounterpartyIncomeExpenses.QuarterPeriod,
	RecordsCounterpartyIncomeExpenses.MonthPeriod,
	RecordsCounterpartyIncomeExpenses.TenDaysPeriod,
	RecordsCounterpartyIncomeExpenses.WeekPeriod,
	RecordsCounterpartyIncomeExpenses.DayPeriod,
	RecordsCounterpartyIncomeExpenses.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
