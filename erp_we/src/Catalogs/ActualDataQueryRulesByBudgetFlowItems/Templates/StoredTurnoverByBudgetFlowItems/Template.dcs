		<field xsi:type="DataSetFieldField">
			<dataPath>SecondPeriod</dataPath>
			<field>SecondPeriod</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period, second</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره، ثانیه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo, secondo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres, sekunda</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период, секунда</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem, saniye</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ, giây</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	BudgetTurnovers.Recorder AS Recorder,
	BudgetTurnovers.SecondPeriod AS SecondPeriod,
	BudgetTurnovers.YearPeriod AS YearPeriod,
	BudgetTurnovers.HalfYearPeriod AS HalfYearPeriod,
	BudgetTurnovers.QuarterPeriod AS QuarterPeriod,
	BudgetTurnovers.MonthPeriod AS MonthPeriod,
	BudgetTurnovers.TenDaysPeriod AS TenDaysPeriod,
	BudgetTurnovers.WeekPeriod AS WeekPeriod,
	BudgetTurnovers.DayPeriod AS DayPeriod,
	BudgetTurnovers.BudgetFlowItem AS BudgetFlowItem,
	BudgetTurnovers.Rule AS Rule,
	BudgetTurnovers.Organization AS Organization,
	BudgetTurnovers.Department AS Department,
	&amp;AnalystSExpression1 AS Dimension1,
	&amp;AnalystSExpression2 AS Dimension2,
	&amp;AnalystSExpression3 AS Dimension3,
	&amp;AnalystSExpression4 AS Dimension4,
	&amp;AnalystSExpression5 AS Dimension5,
	&amp;AnalystSExpression6 AS Dimension6,
	BudgetTurnovers.Currency AS Currency,
	BudgetTurnovers.Currency AS StorageCurrency,
	BudgetTurnovers.CountTurnover AS Count,
	BudgetTurnovers.SumManTurnover AS SumMan,
	BudgetTurnovers.SumComplTurnover AS SumCompl,
	BudgetTurnovers.AmountInCurrencyTurnover AS AmountInCurrency
{SELECT
	Recorder.*,
	SecondPeriod,
	YearPeriod,
	HalfYearPeriod,
	QuarterPeriod,
	MonthPeriod,
	TenDaysPeriod,
	WeekPeriod,
	DayPeriod,
	BudgetFlowItem.*,
	Rule.*,
	Organization.*,
	Department.*,
	Dimension1.*,
	Dimension2.*,
	Dimension3.*,
	Dimension4.*,
	Dimension5.*,
	Dimension6.*,
	Currency.*,
	Currency.* AS StorageCurrency,
	Count,
	SumMan,
	SumCompl,
	AmountInCurrency}
FROM
	AccumulationRegister.ActualBudgetingData.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, {("DataSourceID") AS DataSourceID, (BudgetFlowItem).*, (Organization).*, (Department).*, (Dimension1).*, (Dimension2).*, (Dimension3).*, (Dimension4).*, (Dimension5).*, (Dimension6).*, (Currency).*}) AS BudgetTurnovers
{WHERE
	// Fields for optimal selection by additional details (selection is imposed outside the fields of the virtual table in the WHERE section)
	BudgetTurnovers.BudgetFlowItem.* AS BudgetFlowItem,
	BudgetTurnovers.Rule.* AS Rule,
	BudgetTurnovers.Organization.* AS Organization,
	BudgetTurnovers.Department.* AS Department,
	(&amp;AnalystSExpression1).* AS Dimension1,
	(&amp;AnalystSExpression2).* AS Dimension2,
	(&amp;AnalystSExpression3).* AS Dimension3,
	(&amp;AnalystSExpression4).* AS Dimension4,
	(&amp;AnalystSExpression5).* AS Dimension5,
	(&amp;AnalystSExpression6).* AS Dimension6,
	BudgetTurnovers.Currency.* AS Currency,
	BudgetTurnovers.Currency.* AS StorageCurrency,
	
	// The period and registrar fields
	BudgetTurnovers.Recorder.*,
	BudgetTurnovers.YearPeriod,
	BudgetTurnovers.HalfYearPeriod,
	BudgetTurnovers.QuarterPeriod,
	BudgetTurnovers.MonthPeriod,
	BudgetTurnovers.TenDaysPeriod,
	BudgetTurnovers.WeekPeriod,
	BudgetTurnovers.DayPeriod}</query>
	</dataSet>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
	</parameter>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
