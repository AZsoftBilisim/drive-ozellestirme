		</field>
		<dataSource>DataSource1</dataSource>
		<query>// Independence from the state of the functional option
SELECT ALLOWED
	VALUE(Catalog.FinancialAccountingChartsOfAccounts.EmptyRef) AS FinancialAccountingChartOfAccounts,
	VALUE(ChartOfAccounts.International.EmptyRef) AS Account,
	VALUE(ChartOfAccounts.International.EmptyRef) AS DataSource,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension1,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension2,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension3,
	VALUE(ChartOfAccounts.International.EmptyRef) AS BalancedAccount,
	VALUE(Catalog.Companies.EmptyRef) AS BalancedExtDimension1,
	VALUE(Catalog.Companies.EmptyRef) AS BalancedExtDimension2,
	VALUE(Catalog.Companies.EmptyRef) AS BalancedExtDimension3,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS DepartmentBalanced,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusinessBalanced,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	VALUE(Catalog.Currencies.EmptyRef) AS CurrencyBalanced,
	VALUE(Document.BankAccountReceiptNote.EmptyRef) AS Recorder,
	DATETIME(1,1,1) AS SecondPeriod,
	DATETIME(1,1,1) AS DayPeriod,
	DATETIME(1,1,1) AS WeekPeriod,
	DATETIME(1,1,1) AS TenDaysPeriod,
	DATETIME(1,1,1) AS MonthPeriod,
	DATETIME(1,1,1) AS QuarterPeriod,
	DATETIME(1,1,1) AS HalfYearPeriod,
	DATETIME(1,1,1) AS YearPeriod,
	DATETIME(1,1,1) AS RatePeriod,
	0 AS SumTurnover,
	0 AS SumTurnoverDr,
	0 AS SumTurnoverCr,
	0 AS AmountInCurrencyTurnover,
	0 AS AmountInCurrencyTurnoverDr,
	0 AS AmountInCurrencyTurnoverCr,
	0 AS CountTurnover,
	0 AS CountTurnoverDr,
	0 AS CountTurnoverCr
{SELECT
	FinancialAccountingChartOfAccounts.*,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	Account.*,
	DataSource,
	ExtDimension1.*,
	ExtDimension2.*,
	ExtDimension3.*,
	Currency.*,
	BalancedAccount.*,
	BalancedExtDimension1.*,
	BalancedExtDimension2.*,
	BalancedExtDimension3.*,
	DepartmentBalanced.*,
	LineOfBusinessBalanced.*,
	CurrencyBalanced.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	RatePeriod,
	SumTurnover,
	SumTurnoverDr,
	SumTurnoverCr,
	AmountInCurrencyTurnover,
	AmountInCurrencyTurnoverDr,
	AmountInCurrencyTurnoverCr,
	CountTurnover,
	CountTurnoverDr,
	CountTurnoverCr}
WHERE
	FALSE
{WHERE
	("DataSourceID") AS DataSourceID,
	VALUE(Catalog.FinancialAccountingChartsOfAccounts.EmptyRef) AS FinancialAccountingChartOfAccounts,
	VALUE(ChartOfAccounts.International.EmptyRef) AS Account,
	VALUE(ChartOfAccounts.International.EmptyRef) AS DataSource,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension1,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension2,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension3,
	VALUE(ChartOfAccounts.International.EmptyRef) AS BalancedAccount,
	VALUE(Catalog.Companies.EmptyRef) AS BalancedExtDimension1,
	VALUE(Catalog.Companies.EmptyRef) AS BalancedExtDimension2,
	VALUE(Catalog.Companies.EmptyRef) AS BalancedExtDimension3,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS DepartmentBalanced,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusinessBalanced,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	VALUE(Catalog.Currencies.EmptyRef) AS CurrencyBalanced,
	VALUE(Document.BankAccountReceiptNote.EmptyRef) AS Recorder,
	DATETIME(1,1,1) AS SecondPeriod,
	DATETIME(1,1,1) AS DayPeriod,
	DATETIME(1,1,1) AS WeekPeriod,
	DATETIME(1,1,1) AS TenDaysPeriod,
	DATETIME(1,1,1) AS MonthPeriod,
	DATETIME(1,1,1) AS QuarterPeriod,
	DATETIME(1,1,1) AS HalfYearPeriod,
	DATETIME(1,1,1) AS YearPeriod,
	DATETIME(1,1,1) AS RatePeriod}

UNION ALL

SELECT
	FinancialAccounting.ChartOfAccounts AS FinancialAccountingChartOfAccounts,
	FinancialAccounting.Account AS Account,
	FinancialAccounting.Account AS DataSource,
	FinancialAccounting.ExtDimension1 AS ExtDimension1,
	FinancialAccounting.ExtDimension2 AS ExtDimension2,
	FinancialAccounting.ExtDimension3 AS ExtDimension3,
	FinancialAccounting.BalancedAccount AS BalancedAccount,
	FinancialAccounting.BalancedExtDimension1 AS BalancedExtDimension1,
	FinancialAccounting.BalancedExtDimension2 AS BalancedExtDimension2,
	FinancialAccounting.BalancedExtDimension3 AS BalancedExtDimension3,
	FinancialAccounting.Organization AS Organization,
	FinancialAccounting.Department AS Department,
	FinancialAccounting.DepartmentBalanced AS DepartmentBalanced,
	FinancialAccounting.LineOfBusiness AS LineOfBusiness,
	FinancialAccounting.LineOfBusinessBalanced AS LineOfBusinessBalanced,
	FinancialAccounting.Currency AS Currency,
	FinancialAccounting.CurrencyBalanced AS CurrencyBalanced,
	FinancialAccounting.Recorder AS Recorder,
	FinancialAccounting.SecondPeriod AS SecondPeriod,
	FinancialAccounting.DayPeriod AS DayPeriod,
	FinancialAccounting.WeekPeriod AS WeekPeriod,
	FinancialAccounting.TenDaysPeriod AS TenDaysPeriod,
	FinancialAccounting.MonthPeriod AS MonthPeriod,
	FinancialAccounting.QuarterPeriod AS QuarterPeriod,
	FinancialAccounting.HalfYearPeriod AS HalfYearPeriod,
	FinancialAccounting.YearPeriod AS YearPeriod,
	FinancialAccounting.DayPeriod AS RatePeriod,
	FinancialAccounting.SumTurnover AS SumTurnover,
	FinancialAccounting.SumTurnoverDr AS SumTurnoverDr,
	FinancialAccounting.SumTurnoverCr AS SumTurnoverCr,
	FinancialAccounting.CurrencyAmountTurnover AS AmountInCurrencyTurnover,
	FinancialAccounting.CurrencyAmountTurnoverDr AS AmountInCurrencyTurnoverDr,
	FinancialAccounting.CurrencyAmountTurnoverCr AS AmountInCurrencyTurnoverCr,
	FinancialAccounting.CountTurnover AS CountTurnover,
	FinancialAccounting.CountTurnoverDr AS CountTurnoverDr,
	FinancialAccounting.CountTurnoverCr AS CountTurnoverCr
FROM
	AccountingRegister.International.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto,
		{(Account IN HIERARCHY (&amp;DataSource)), (Account) AS DataSource}, ,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
			{("DataSourceID") AS DataSourceID,
				(ChartOfAccounts.*) AS FinancialAccountingChartOfAccounts,
				(Currency).* AS Currency, (CurrencyBalanced).* AS CurrencyBalanced,
				(BalancedExtDimension1).* AS BalancedExtDimension1, (BalancedExtDimension2).* AS BalancedExtDimension2, (BalancedExtDimension3).* AS BalancedExtDimension3,
				(Organization).* AS Organization, (Department).* AS Department, (DepartmentBalanced).* AS DepartmentBalanced,
				(LineOfBusiness).* AS LineOfBusiness, (LineOfBusinessBalanced).* AS LineOfBusinessBalanced,
				(ExtDimension1).* AS ExtDimension1, (ExtDimension2).* AS ExtDimension2, (ExtDimension3).* AS ExtDimension3},
			{(BalancedAccount IN HIERARCHY (&amp;BalancedAccount)), (BalancedAccount)},
	) AS FinancialAccounting
{WHERE
	// Fields for optimal selection by additional details (selection is imposed outside the fields of the virtual table in the WHERE section)
	("DataSourceID") AS DataSourceID,
	FinancialAccounting.Account.* AS Account,
	FinancialAccounting.Account.* AS DataSource,
	FinancialAccounting.ExtDimension1.* AS ExtDimension1,
	FinancialAccounting.ExtDimension2.* AS ExtDimension2,
	FinancialAccounting.ExtDimension3.* AS ExtDimension3,
	FinancialAccounting.BalancedAccount.* AS BalancedAccount,
	FinancialAccounting.BalancedExtDimension1.* AS BalancedExtDimension1,
	FinancialAccounting.BalancedExtDimension2.* AS BalancedExtDimension2,
	FinancialAccounting.BalancedExtDimension3.* AS BalancedExtDimension3,
	FinancialAccounting.Organization.* AS Organization,
	FinancialAccounting.Department.* AS Department,
	FinancialAccounting.DepartmentBalanced.* AS DepartmentBalanced,
	FinancialAccounting.LineOfBusiness.* AS LineOfBusiness,
	FinancialAccounting.LineOfBusinessBalanced.* AS LineOfBusinessBalanced,
	FinancialAccounting.Currency.* AS Currency,
	FinancialAccounting.CurrencyBalanced.* AS CurrencyBalanced,
	
	// The period and registrar fields
	FinancialAccounting.Recorder.* AS Recorder,
	FinancialAccounting.SecondPeriod AS SecondPeriod,
	FinancialAccounting.DayPeriod AS DayPeriod,
	FinancialAccounting.WeekPeriod AS WeekPeriod,
	FinancialAccounting.TenDaysPeriod AS TenDaysPeriod,
	FinancialAccounting.MonthPeriod AS MonthPeriod,
	FinancialAccounting.QuarterPeriod AS QuarterPeriod,
	FinancialAccounting.HalfYearPeriod AS HalfYearPeriod,
	FinancialAccounting.YearPeriod AS YearPeriod,
	FinancialAccounting.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
