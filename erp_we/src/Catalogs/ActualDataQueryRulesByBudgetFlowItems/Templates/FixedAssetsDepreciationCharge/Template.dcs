		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:dateTime</v8:Type>
				<v8:DateQualifiers>
					<v8:DateFractions>DateTime</v8:DateFractions>
				</v8:DateQualifiers>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// Independence from the state of the functional option
SELECT ALLOWED
	DATETIME(1,1,1) AS Period,
	DATETIME(1,1,1) AS YearPeriod,
	DATETIME(1,1,1) AS HalfYearPeriod,
	DATETIME(1,1,1) AS QuarterPeriod,
	DATETIME(1,1,1) AS MonthPeriod,
	DATETIME(1,1,1) AS TenDaysPeriod,
	DATETIME(1,1,1) AS WeekPeriod,
	DATETIME(1,1,1) AS DayPeriod,
	DATETIME(1,1,1) AS RatePeriod,
	DATETIME(1,1,1) AS SecondPeriod,
	VALUE(Document.RegisterAdjustment.EmptyRef) AS Recorder,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS BusinessOperation,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS DataSource,
	VALUE(Catalog.Assets.EmptyRef) AS FixedAsset,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS FinancialAccountingGroup,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.Companies.EmptyRef) AS CorCompany,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS DebitBusinessUnit,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS CorFinancialAccountingGroup,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CorLineOfBusiness,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
	VALUE(Catalog.Companies.EmptyRef) AS CorExpenditureDimension,
	0 AS Depreciation,
	0 AS DepreciationLocal
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	FixedAsset.*,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	FinancialAccountingGroup.*,
	CorCompany.*,
	DebitBusinessUnit.*,
	CorLineOfBusiness.*,
	CorFinancialAccountingGroup.*,
	CorExpenseItem.*,
	CorExpenditureDimension.*,
	Depreciation,
	DepreciationLocal}
WHERE
	FALSE
{WHERE
	("DataSourceID") AS DataSourceID,
	DATETIME(1,1,1) AS Period,
	DATETIME(1,1,1) AS YearPeriod,
	DATETIME(1,1,1) AS HalfYearPeriod,
	DATETIME(1,1,1) AS QuarterPeriod,
	DATETIME(1,1,1) AS MonthPeriod,
	DATETIME(1,1,1) AS TenDaysPeriod,
	DATETIME(1,1,1) AS WeekPeriod,
	DATETIME(1,1,1) AS DayPeriod,
	DATETIME(1,1,1) AS RatePeriod,
	DATETIME(1,1,1) AS SecondPeriod,
	VALUE(Document.RegisterAdjustment.EmptyRef) AS Recorder,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS BusinessOperation,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS DataSource,
	VALUE(Catalog.Assets.EmptyRef) AS FixedAsset,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS FinancialAccountingGroup,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.Companies.EmptyRef) AS CorCompany,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS DebitBusinessUnit,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS CorFinancialAccountingGroup,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CorLineOfBusiness,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
	VALUE(Catalog.Companies.EmptyRef) AS CorExpenditureDimension}

UNION ALL

SELECT
	RegisterData.Period AS Period,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS RatePeriod,
	RegisterData.Period AS SecondPeriod,
	RegisterData.Recorder AS Recorder,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.BusinessOperation AS DataSource,
	RegisterData.FixedAsset AS FixedAsset,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.FinancialAccountingGroup AS FinancialAccountingGroup,
	RegisterData.LineOfBusiness AS LineOfBusiness,
	RegisterData.CorCompany AS CorCompany,
	RegisterData.DebitBusinessUnit AS DebitBusinessUnit,
	RegisterData.CorFinancialAccountingGroup AS CorFinancialAccountingGroup,
	RegisterData.CorLineOfBusiness AS CorLineOfBusiness,
	RegisterData.CorExpenseItem AS CorExpenseItem,
	RegisterData.CorExpenditureDimension AS CorExpenditureDimension,
	-RegisterData.Depreciation AS Depreciation,
	-(RegisterData.DepreciationLocal + RegisterData.FixedAssetDepreciationTargetFinancing) AS DepreciationLocal
FROM
	AccumulationRegister.FixedAssetsDepreciationCharge AS RegisterData
WHERE
	RegisterData.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND RegisterData.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.EmptyRef)
	AND RegisterData.Active
	AND &amp;SourcePrivilegedMode = &amp;PrivilegedMode
{WHERE
	("DataSourceID") AS DataSourceID,
	(RegisterData.BusinessOperation IN (&amp;BusinessOperation)),
	RegisterData.BusinessOperation,
	RegisterData.BusinessOperation AS DataSource,
	RegisterData.Recorder.*,
	(BEGINOFPERIOD(RegisterData.Period, DAY)) AS DayPeriod,
	(BEGINOFPERIOD(RegisterData.Period, WEEK)) AS WeekPeriod,
	(BEGINOFPERIOD(RegisterData.Period, TENDAYS)) AS TenDaysPeriod,
	(BEGINOFPERIOD(RegisterData.Period, MONTH)) AS MonthPeriod,
	(BEGINOFPERIOD(RegisterData.Period, QUARTER)) AS QuarterPeriod,
	(BEGINOFPERIOD(RegisterData.Period, HALFYEAR)) AS HalfYearPeriod,
	(BEGINOFPERIOD(RegisterData.Period, YEAR)) AS YearPeriod,
	(BEGINOFPERIOD(RegisterData.Period, DAY)) AS RatePeriod,
	RegisterData.FixedAsset.* AS FixedAsset,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.FinancialAccountingGroup.* AS FinancialAccountingGroup,
	RegisterData.LineOfBusiness.* AS LineOfBusiness,
	RegisterData.CorCompany.* AS CorCompany,
	RegisterData.DebitBusinessUnit.* AS DebitBusinessUnit,
	RegisterData.CorFinancialAccountingGroup.* AS CorFinancialAccountingGroup,
	RegisterData.CorLineOfBusiness.* AS CorLineOfBusiness,
	RegisterData.CorExpenseItem.*,
	RegisterData.CorExpenditureDimension.*}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
