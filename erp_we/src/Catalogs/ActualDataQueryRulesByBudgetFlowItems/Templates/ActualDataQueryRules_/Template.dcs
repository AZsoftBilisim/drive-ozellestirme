		<query>

// DON'T OVERFILL WITH THE CONSTRUCTOR - THERE ARE CLIPPING TAGS



// Calculation rules linking budget items and indicators
SELECT
	CAST(CalculationsRules.Source AS Catalog.BudgetFlowItems) AS BudgetFlowItem,
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems) AS BudgetBalanceItem,
	CalculationRulesDataCalculationSettings.ReverseSign AS Expense
INTO BudgetIndicatorLinks
FROM
	Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers AS CalculationsRules
		INNER JOIN Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers.DataCalculationSettings AS CalculationRulesDataCalculationSettings
		ON CalculationsRules.Ref = CalculationRulesDataCalculationSettings.Ref
WHERE
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems).IndicatorType = VALUE(Enum.BudgetBalanceItemType.Estimated_)
	AND NOT CalculationsRules.DeletionMark
	AND CalculationsRules.Status = VALUE(Enum.BudgetingRuleStatuses.Valid)
	AND CalculationRulesDataCalculationSettings.LineNumber = 1
{WHERE
	(CAST(CalculationsRules.Source AS Catalog.BudgetFlowItems)).* AS BudgetFlowItem,
	(CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems)).* AS BudgetBalanceItem}

INDEX BY
	BudgetFlowItem

;

////////////////////////////////////////////////////////////////////////////////
// Budget items for obtaining turnovers that affect indicators
SELECT DISTINCT
	BudgetFlowItems.Ref AS Ref,
	BudgetFlowItems.DimensionKind1 AS DimensionKind1,
	BudgetFlowItems.DimensionKind2 AS DimensionKind2,
	BudgetFlowItems.DimensionKind3 AS DimensionKind3,
	BudgetFlowItems.DimensionKind4 AS DimensionKind4,
	BudgetFlowItems.DimensionKind5 AS DimensionKind5,
	BudgetFlowItems.DimensionKind6 AS DimensionKind6,
	BudgetFlowItems.RecordByQuantity AS RecordByQuantity,
	BudgetFlowItems.QuantityDimensionAddress AS QuantityDimensionAddress,
	BudgetFlowItems.UnitOfMeasureIsDeterminedByDimension AS UnitOfMeasureIsDeterminedByDimension,
	BudgetFlowItems.UnitOfMeasure AS UnitOfMeasure,
	BudgetFlowItems.RecordByCurrency AS RecordByCurrency,
	BudgetFlowItems.CurrencyIsDeterminedByDimension AS CurrencyIsDeterminedByDimension,
	BudgetFlowItems.DimensionAddressCurrency AS DimensionAddressCurrency,
	BudgetFlowItems.DimensionCurrencies.CurrencyFilling AS CurrencyFilling,
	BudgetFlowItems.DimensionUnitsOfMeasurement.UnitOfMeasureFilling AS UnitOfMeasureFilling,
	BudgetIndicatorLinks.BudgetBalanceItem AS BudgetBalanceItem,
	TRUE AS BudgetItemForIndicatorCalculation,
	BudgetIndicatorLinks.Expense AS Expense
INTO BudgetFlowItems
FROM
	Catalog.BudgetFlowItems AS BudgetFlowItems
		INNER JOIN BudgetIndicatorLinks AS BudgetIndicatorLinks
		ON BudgetFlowItems.Ref = BudgetIndicatorLinks.BudgetFlowItem
{WHERE
	BudgetFlowItems.Ref.* AS BudgetFlowItem,
	BudgetIndicatorLinks.BudgetBalanceItem.* AS BudgetBalanceItem}

UNION ALL

// Budget items for obtaining turnover
SELECT DISTINCT
	BudgetFlowItems.Ref AS Ref,
	BudgetFlowItems.DimensionKind1 AS DimensionKind1,
	BudgetFlowItems.DimensionKind2 AS DimensionKind2,
	BudgetFlowItems.DimensionKind3 AS DimensionKind3,
	BudgetFlowItems.DimensionKind4 AS DimensionKind4,
	BudgetFlowItems.DimensionKind5 AS DimensionKind5,
	BudgetFlowItems.DimensionKind6 AS DimensionKind6,
	BudgetFlowItems.RecordByQuantity AS RecordByQuantity,
	BudgetFlowItems.QuantityDimensionAddress AS QuantityDimensionAddress,
	BudgetFlowItems.UnitOfMeasureIsDeterminedByDimension AS UnitOfMeasureIsDeterminedByDimension,
	BudgetFlowItems.UnitOfMeasure AS UnitOfMeasure,
	BudgetFlowItems.RecordByCurrency AS RecordByCurrency,
	BudgetFlowItems.CurrencyIsDeterminedByDimension AS CurrencyIsDeterminedByDimension,
	BudgetFlowItems.DimensionAddressCurrency AS DimensionAddressCurrency,
	BudgetFlowItems.DimensionCurrencies.CurrencyFilling AS CurrencyFilling,
	BudgetFlowItems.DimensionUnitsOfMeasurement.UnitOfMeasureFilling AS UnitOfMeasureFilling,
	VALUE(Catalog.BudgetBalanceItems.EmptyRef) AS BudgetBalanceItem,
	FALSE AS BudgetItemForIndicatorCalculation,
	FALSE AS Expense
FROM
	Catalog.BudgetFlowItems AS BudgetFlowItems
{WHERE
	BudgetFlowItems.Ref.* AS BudgetFlowItem,
	(VALUE(Catalog.BudgetBalanceItems.EmptyRef)).* AS BudgetBalanceItem}

INDEX BY
	BudgetFlowItems.Ref

;

////////////////////////////////////////////////////////////////////////////////
SELECT
	VALUE(Enum.ActualBudgetingDataQueryRuleType.ActualData) AS RuleType
INTO TypesOfRules
FROM
	Catalog.BudgetingScenarios AS BudgetingScenarios
WHERE
	BudgetingScenarios.Ref = VALUE(Catalog.BudgetingScenarios.ActualData)
{WHERE
	BudgetingScenarios.Ref.* AS Scenario}
	
UNION ALL

SELECT
	VALUE(Enum.ActualBudgetingDataQueryRuleType.BudgetFulfillment) AS RuleType
FROM
	Catalog.BudgetingScenarios AS BudgetingScenarios
WHERE
	BudgetingScenarios.Ref = VALUE(Catalog.BudgetingScenarios.BudgetFulfillment)
{WHERE
	BudgetingScenarios.Ref.* AS Scenario}
	
UNION ALL

SELECT DISTINCT
	VALUE(Enum.ActualBudgetingDataQueryRuleType.BudgetFulfillmentAndActualData) AS RuleType
FROM
	Catalog.BudgetingScenarios AS BudgetingScenarios
WHERE
	BudgetingScenarios.Ref IN (VALUE(Catalog.BudgetingScenarios.ActualData), VALUE(Catalog.BudgetingScenarios.BudgetFulfillment))
{WHERE
	BudgetingScenarios.Ref.* AS Scenario}

;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ActualDataQueryRules_.BudgetFlowItem AS BudgetFlowItem,
	ActualDataQueryRules_.DataSourceSection AS DataSourceSection,
	ActualDataQueryRules_.DataSource AS DataSource,
	CASE
		WHEN &amp;AccordingToCorrespondenceTable
			THEN CASE
				WHEN ActualDataQueryRules_.TransactionAmountSource IN (VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaid),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidWithinLimit),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidAboveLimit))
					THEN "CashFlowToPayment"
				ELSE ""
			END
		WHEN &amp;ByRegisterOfLimits
			AND ActualDataQueryRules_.RuleType = VALUE(Enum.ActualBudgetingDataQueryRuleType.BudgetFulfillment)
			THEN "CashFlowToPayment"
		ELSE CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).DataSource
	END AS NameOfTheDataSourceTemplate,
	CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).BusinessOperation AS BusinessOperation,
	ActualDataQueryRules_.TransactionAmountSource AS TransactionAmountSource,
	UNDEFINED AS BalancedAccount,
	CAST(ActualDataQueryRules_.CorDataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems) AS CorDataSource,
	ActualDataQueryRules_.SettingsComposer AS SettingsComposer,
	ActualDataQueryRules_.SettingsHash AS SettingsHash,
	ActualDataQueryRules_.HashOfDataCompositionSchema AS HashOfDataCompositionSchema,
	CASE
		WHEN &amp;AccordingToCorrespondenceTable
			THEN CASE
				WHEN ActualDataQueryRules_.TransactionAmountSource IN (VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaid),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidWithinLimit),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidAboveLimit))
					THEN "CashFlowToPayment"
				ELSE ""
			END
		WHEN &amp;ByRegisterOfLimits
			AND ActualDataQueryRules_.RuleType = VALUE(Enum.ActualBudgetingDataQueryRuleType.BudgetFulfillment)
			THEN "CashFlowToPayment"
		WHEN ActualDataQueryRules_.HashOfDataCompositionSchema &lt;&gt; ""
			THEN ActualDataQueryRules_.HashOfDataCompositionSchema
		WHEN VALUETYPE(ActualDataQueryRules_.DataSource) = TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
			THEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).PredefinedDataName
		ELSE CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).DataSource
	END AS DataSourceID,
	NULL AS Currency1,
	CASE
		WHEN VALUETYPE(ActualDataQueryRules_.DataSource) = TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
			THEN ActualDataQueryRules_.TotalType
		ELSE UNDEFINED
	END AS TotalType,
	ActualDataQueryRules_.TurnoverByExpenseDimension AS TurnoverByExpenseDimension,
	NULL AS DataSourceScheme,
	ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting AS AdvancedModeOfDimensionFillSetting,
	ActualDataQueryRules_.DimensionPopulationExpression1 AS DimensionPopulationExpression1,
	ActualDataQueryRules_.DimensionPopulationExpression2 AS DimensionPopulationExpression2,
	ActualDataQueryRules_.DimensionPopulationExpression3 AS DimensionPopulationExpression3,
	ActualDataQueryRules_.DimensionPopulationExpression4 AS DimensionPopulationExpression4,
	ActualDataQueryRules_.DimensionPopulationExpression5 AS DimensionPopulationExpression5,
	ActualDataQueryRules_.DimensionPopulationExpression6 AS DimensionPopulationExpression6,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1 AS FillInAnalyticsWithSpecifiedValue1,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2 AS FillInAnalyticsWithSpecifiedValue2,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3 AS FillInAnalyticsWithSpecifiedValue3,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4 AS FillInAnalyticsWithSpecifiedValue4,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5 AS FillInAnalyticsWithSpecifiedValue5,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6 AS FillInAnalyticsWithSpecifiedValue6,
	ActualDataQueryRules_.DimensionValue1 AS DimensionValue1,
	ActualDataQueryRules_.DimensionValue2 AS DimensionValue2,
	ActualDataQueryRules_.DimensionValue3 AS DimensionValue3,
	ActualDataQueryRules_.DimensionValue4 AS DimensionValue4,
	ActualDataQueryRules_.DimensionValue5 AS DimensionValue5,
	ActualDataQueryRules_.DimensionValue6 AS DimensionValue6,
	ActualDataQueryRules_.Ref AS Ref,
	ActualDataQueryRules_.RuleType AS RuleType,
	ActualDataQueryRules_.ZoomRatio AS ZoomRatio,
	ActualDataQueryRules_.ValidFrom AS ValidFrom,
	ActualDataQueryRules_.ValidTo AS ValidTo
INTO ActualDataQueryRules_
FROM
	Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRules_
		INNER JOIN BudgetFlowItems AS BudgetFlowItems
		ON ActualDataQueryRules_.BudgetFlowItem = BudgetFlowItems.Ref
		INNER JOIN TypesOfRules AS TypesOfRules
		ON ActualDataQueryRules_.RuleType = TypesOfRules.RuleType
WHERE
	NOT ActualDataQueryRules_.DeletionMark
	AND ActualDataQueryRules_.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
	AND TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
		WHERE
			&amp;ByItemsOfAssetsLiabilities
			AND ActualDataQueryRules_.RuleType = VALUE(Enum.ActualBudgetingDataQueryRuleType.ActualData)
			AND AssetLiabilityItems.Ref = ActualDataQueryRules_.DataSource
		UNION ALL
		SELECT TOP 1
			TRUE
		FROM
			Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
		WHERE
			(NOT &amp;ByItemsOfAssetsLiabilities
			OR ActualDataQueryRules_.RuleType &lt;&gt; VALUE(Enum.ActualBudgetingDataQueryRuleType.ActualData))
			AND BusinessTransactionsSettings.Ref = ActualDataQueryRules_.DataSource
		)
{WHERE
	ActualDataQueryRules_.Ref.* AS Rule,
	ActualDataQueryRules_.DataSource.*,
	ActualDataQueryRules_.DataSourceSection.*,
	ActualDataQueryRules_.CachingOfRuleResults,
	(CASE
		WHEN &amp;AccordingToCorrespondenceTable
			THEN CASE
				WHEN ActualDataQueryRules_.TransactionAmountSource IN (VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaid),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidWithinLimit),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidAboveLimit))
					THEN "CashFlowToPayment"
				ELSE ""
			END
		WHEN &amp;ByRegisterOfLimits
			AND ActualDataQueryRules_.RuleType = VALUE(Enum.ActualBudgetingDataQueryRuleType.BudgetFulfillment)
			THEN "CashFlowToPayment"
		ELSE CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).DataSource
	END) AS NameOfTheDataSourceTemplate,
	(CASE
		WHEN &amp;AccordingToCorrespondenceTable
			THEN CASE
				WHEN ActualDataQueryRules_.TransactionAmountSource IN (VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaid),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidWithinLimit),
					VALUE(Enum.IndicatorsOfAnalyticalRegisters.AmountToBePaidAboveLimit))
					THEN "CashFlowToPayment"
				ELSE ""
			END
		WHEN &amp;ByRegisterOfLimits
			AND ActualDataQueryRules_.RuleType = VALUE(Enum.ActualBudgetingDataQueryRuleType.BudgetFulfillment)
			THEN "CashFlowToPayment"
		WHEN ActualDataQueryRules_.HashOfDataCompositionSchema &lt;&gt; ""
			THEN ActualDataQueryRules_.HashOfDataCompositionSchema
		WHEN VALUETYPE(ActualDataQueryRules_.DataSource) = TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
			THEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).PredefinedDataName
		ELSE CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).DataSource
	END) AS DataSourceID,
	ActualDataQueryRules_.ValidFrom,
	ActualDataQueryRules_.ValidTo,
	ActualDataQueryRules_.RuleType.*}


UNION ALL

SELECT
	ActualDataQueryRules_.BudgetFlowItem,
	ActualDataQueryRules_.DataSourceSection,
	ActualDataQueryRules_.DataSource,
	"FinancialAccounting",
	NULL,
	NULL,
	ActualDataQueryRules_.CorDataSource,
	CAST(ActualDataQueryRules_.CorDataSource AS ChartOfAccounts.International),
	ActualDataQueryRules_.SettingsComposer,
	ActualDataQueryRules_.SettingsHash,
	ActualDataQueryRules_.HashOfDataCompositionSchema,
	CASE
		WHEN International.ChartOfAccounts.OptionForGeneratingTransactions = VALUE(Enum.EntryGenerationOptions.WithCorrespondence)
			THEN "FinancialAccountingWithCorrespondence"
		ELSE "FinancialAccountingWithoutCorrespondence"
	END,
	ActualDataQueryRules_.DataSource.Currency1,
	ActualDataQueryRules_.TotalType,
	NULL,
	NULL,
	ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting,
	ActualDataQueryRules_.DimensionPopulationExpression1,
	ActualDataQueryRules_.DimensionPopulationExpression2,
	ActualDataQueryRules_.DimensionPopulationExpression3,
	ActualDataQueryRules_.DimensionPopulationExpression4,
	ActualDataQueryRules_.DimensionPopulationExpression5,
	ActualDataQueryRules_.DimensionPopulationExpression6,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6,
	ActualDataQueryRules_.DimensionValue1,
	ActualDataQueryRules_.DimensionValue2,
	ActualDataQueryRules_.DimensionValue3,
	ActualDataQueryRules_.DimensionValue4,
	ActualDataQueryRules_.DimensionValue5,
	ActualDataQueryRules_.DimensionValue6,
	ActualDataQueryRules_.Ref,
	ActualDataQueryRules_.RuleType,
	ActualDataQueryRules_.ZoomRatio,
	ActualDataQueryRules_.ValidFrom,
	ActualDataQueryRules_.ValidTo
FROM
	Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRules_
		INNER JOIN BudgetFlowItems AS BudgetFlowItems
		ON ActualDataQueryRules_.BudgetFlowItem = BudgetFlowItems.Ref
		INNER JOIN TypesOfRules AS TypesOfRules
		ON ActualDataQueryRules_.RuleType = TypesOfRules.RuleType
		LEFT JOIN ChartOfAccounts.International AS International
		ON ActualDataQueryRules_.DataSource = International.Ref
WHERE
	NOT ActualDataQueryRules_.DeletionMark
	AND &amp;InternationalAccountingIsUsed
	AND ActualDataQueryRules_.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.FinancialAccounting)
{WHERE
	ActualDataQueryRules_.Ref.* AS Rule,
	ActualDataQueryRules_.DataSourceSection.*,
	ActualDataQueryRules_.DataSource.*,
	ActualDataQueryRules_.CachingOfRuleResults,
	("FinancialAccounting") AS NameOfTheDataSourceTemplate,
	CASE
		WHEN International.ChartOfAccounts.OptionForGeneratingTransactions = VALUE(Enum.EntryGenerationOptions.WithCorrespondence)
			THEN "FinancialAccountingWithCorrespondence"
		ELSE "FinancialAccountingWithoutCorrespondence"
	END AS DataSourceID,
	ActualDataQueryRules_.ValidFrom,
	ActualDataQueryRules_.ValidTo,
	ActualDataQueryRules_.RuleType.*}
UNION ALL

SELECT
	ActualDataQueryRules_.BudgetFlowItem,
	ActualDataQueryRules_.DataSourceSection,
	ActualDataQueryRules_.DataSource,
	"",
	NULL,
	NULL,
	UNDEFINED,
	UNDEFINED,
	ActualDataQueryRules_.SettingsComposer,
	ActualDataQueryRules_.SettingsHash,
	ActualDataQueryRules_.HashOfDataCompositionSchema,
	ActualDataQueryRules_.HashOfDataCompositionSchema,
	NULL,
	NULL,
	NULL,
	ActualDataQueryRules_.DataSourceScheme,
	ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting,
	ActualDataQueryRules_.DimensionPopulationExpression1,
	ActualDataQueryRules_.DimensionPopulationExpression2,
	ActualDataQueryRules_.DimensionPopulationExpression3,
	ActualDataQueryRules_.DimensionPopulationExpression4,
	ActualDataQueryRules_.DimensionPopulationExpression5,
	ActualDataQueryRules_.DimensionPopulationExpression6,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6,
	ActualDataQueryRules_.DimensionValue1,
	ActualDataQueryRules_.DimensionValue2,
	ActualDataQueryRules_.DimensionValue3,
	ActualDataQueryRules_.DimensionValue4,
	ActualDataQueryRules_.DimensionValue5,
	ActualDataQueryRules_.DimensionValue6,
	ActualDataQueryRules_.Ref,
	ActualDataQueryRules_.RuleType,
	ActualDataQueryRules_.ZoomRatio,
	ActualDataQueryRules_.ValidFrom,
	ActualDataQueryRules_.ValidTo
FROM
	Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRules_
		INNER JOIN BudgetFlowItems AS BudgetFlowItems
		ON ActualDataQueryRules_.BudgetFlowItem = BudgetFlowItems.Ref
		INNER JOIN TypesOfRules AS TypesOfRules
		ON ActualDataQueryRules_.RuleType = TypesOfRules.RuleType
WHERE
	NOT ActualDataQueryRules_.DeletionMark
	AND ActualDataQueryRules_.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.CustomQuery)
{WHERE
	ActualDataQueryRules_.Ref.* AS Rule,
	ActualDataQueryRules_.DataSourceSection.*,
	ActualDataQueryRules_.DataSource.*,
	ActualDataQueryRules_.CachingOfRuleResults,
	("") AS NameOfTheDataSourceTemplate,
	ActualDataQueryRules_.HashOfDataCompositionSchema AS DataSourceID,
	ActualDataQueryRules_.ValidFrom,
	ActualDataQueryRules_.ValidTo,
	ActualDataQueryRules_.RuleType.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ActualDataQueryRules_.BudgetFlowItem AS BudgetFlowItem,
	ActualDataQueryRules_.Ref AS Rule,
	BudgetFlowItems.DimensionKind1 AS DimensionKind1,
	BudgetFlowItems.DimensionKind2 AS DimensionKind2,
	BudgetFlowItems.DimensionKind3 AS DimensionKind3,
	BudgetFlowItems.DimensionKind4 AS DimensionKind4,
	BudgetFlowItems.DimensionKind5 AS DimensionKind5,
	BudgetFlowItems.DimensionKind6 AS DimensionKind6,
	CASE
		WHEN BudgetFlowItems.RecordByCurrency
			THEN CASE
					WHEN BudgetFlowItems.CurrencyIsDeterminedByDimension
						THEN "DeterminedByAnalytics"
					ELSE "DeterminedByDataSource"
				END
		ELSE "DeterminedByReportCurrency"
	END AS CurrencyFilling,
	CASE
		WHEN BudgetFlowItems.RecordByQuantity
			THEN CASE
					WHEN BudgetFlowItems.UnitOfMeasureIsDeterminedByDimension
						THEN "DeterminedByAnalytics"
					ELSE "FixedValue"
				END
		ELSE "DontFill"
	END AS UnitOfMeasureFilling,
	BudgetFlowItems.QuantityDimensionAddress AS DimensionAddressUnitOfMeasure,
	BudgetFlowItems.UnitOfMeasure AS UnitOfMeasure,
	BudgetFlowItems.DimensionAddressCurrency AS DimensionAddressCurrency,
	BudgetFlowItems.CurrencyFilling AS DimensionCurrencyField,
	BudgetFlowItems.UnitOfMeasureFilling AS FieldOfDimensionUnitOfMeasure,
	ActualDataQueryRules_.DataSourceSection AS DataSourceSection,
	CASE
		WHEN ActualDataQueryRules_.DataSource REFS Catalog.BusinessTransactionsSettings
			THEN ActualDataQueryRules_.BusinessOperation
		ELSE ActualDataQueryRules_.DataSource
	END AS DataSource,
	CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings) AS DataSourceXO,
	CASE
		WHEN ActualDataQueryRules_.DataSourceSection &lt;&gt; VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
			THEN VALUE(Enum.AccountingDataTypes.EmptyRef)
		WHEN VALUETYPE(ActualDataQueryRules_.DataSource) = TYPE(Catalog.BusinessTransactionsSettings)
			THEN CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).Receipt
		WHEN ActualDataQueryRules_.TotalType &lt;&gt; VALUE(Enum.TypesOfTotals.TurnoverCr)
			THEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).TypeOfAccountingData
		WHEN ActualDataQueryRules_.CorDataSource &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
			THEN CAST(ActualDataQueryRules_.CorDataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).TypeOfAccountingData
		ELSE VALUE(Enum.AccountingDataTypes.EmptyRef)
	END AS TypeOfAccountingDataReceipt,
	CASE
		WHEN ActualDataQueryRules_.DataSourceSection &lt;&gt; VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
			THEN VALUE(Enum.AccountingDataTypes.EmptyRef)
		WHEN VALUETYPE(ActualDataQueryRules_.DataSource) = TYPE(Catalog.BusinessTransactionsSettings)
			THEN CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).Expense
		WHEN ActualDataQueryRules_.TotalType = VALUE(Enum.TypesOfTotals.TurnoverCr)
			THEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).TypeOfAccountingData
		WHEN ActualDataQueryRules_.CorDataSource &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
			THEN CAST(ActualDataQueryRules_.CorDataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).TypeOfAccountingData
		ELSE VALUE(Enum.AccountingDataTypes.EmptyRef)
	END AS TypeOfAccountingDataExpense,
	ActualDataQueryRules_.NameOfTheDataSourceTemplate AS NameOfTheDataSourceTemplate,
	ActualDataQueryRules_.BusinessOperation AS BusinessOperation,
	ActualDataQueryRules_.TransactionAmountSource AS TransactionAmountSource,
	ActualDataQueryRules_.BalancedAccount AS BalancedAccount,
	ActualDataQueryRules_.CorDataSource AS CorDataSource,
	ActualDataQueryRules_.SettingsComposer AS SettingsComposer,
	ActualDataQueryRules_.SettingsHash AS SettingsHash,
	ActualDataQueryRules_.HashOfDataCompositionSchema AS HashOfDataCompositionSchema,
	ActualDataQueryRules_.DataSourceID AS DataSourceID,
	ActualDataQueryRules_.Currency1 AS SourceOfForeignExchange,
	ActualDataQueryRules_.TotalType AS TotalType,
	ActualDataQueryRules_.TurnoverByExpenseDimension AS TurnoverByExpenseDimension,
	ActualDataQueryRules_.DataSourceScheme AS DataSourceScheme,
	ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting AS AdvancedModeOfDimensionFillSetting,
	ActualDataQueryRules_.DimensionPopulationExpression1 AS DimensionPopulationExpression1,
	ActualDataQueryRules_.DimensionPopulationExpression2 AS DimensionPopulationExpression2,
	ActualDataQueryRules_.DimensionPopulationExpression3 AS DimensionPopulationExpression3,
	ActualDataQueryRules_.DimensionPopulationExpression4 AS DimensionPopulationExpression4,
	ActualDataQueryRules_.DimensionPopulationExpression5 AS DimensionPopulationExpression5,
	ActualDataQueryRules_.DimensionPopulationExpression6 AS DimensionPopulationExpression6,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1 AS FillInAnalyticsWithSpecifiedValue1,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2 AS FillInAnalyticsWithSpecifiedValue2,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3 AS FillInAnalyticsWithSpecifiedValue3,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4 AS FillInAnalyticsWithSpecifiedValue4,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5 AS FillInAnalyticsWithSpecifiedValue5,
	ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6 AS FillInAnalyticsWithSpecifiedValue6,
	ActualDataQueryRules_.DimensionValue1 AS DimensionValue1,
	ActualDataQueryRules_.DimensionValue2 AS DimensionValue2,
	ActualDataQueryRules_.DimensionValue3 AS DimensionValue3,
	ActualDataQueryRules_.DimensionValue4 AS DimensionValue4,
	ActualDataQueryRules_.DimensionValue5 AS DimensionValue5,
	ActualDataQueryRules_.DimensionValue6 AS DimensionValue6,
	ActualDataQueryRules_.RuleType AS RuleType,
	BudgetFlowItems.BudgetBalanceItem AS BudgetBalanceItem,
	ActualDataQueryRules_.ZoomRatio AS ZoomRatio,
	ActualDataQueryRules_.ValidFrom AS ValidFrom,
	ActualDataQueryRules_.ValidTo AS ValidTo,
	BudgetFlowItems.Expense AS Expense,
	BudgetFlowItems.BudgetItemForIndicatorCalculation AS BudgetItemForIndicatorCalculation,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionKind1
		ELSE UNDEFINED
	END AS RelationshipsBetweenBudgetIndicators_TypeOfAnalytics1,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionKind2
		ELSE UNDEFINED
	END AS RelationshipsBetweenBudgetIndicators_TypeOfAnalytics2,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionKind3
		ELSE UNDEFINED
	END AS RelationshipsBetweenBudgetIndicators_TypeOfAnalytics3,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionKind4
		ELSE UNDEFINED
	END AS RelationshipsBetweenBudgetIndicators_TypeOfAnalytics4,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionKind5
		ELSE UNDEFINED
	END AS RelationshipsBetweenBudgetIndicators_TypeOfAnalytics5,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionKind6
		ELSE UNDEFINED
	END AS RelationshipsBetweenBudgetIndicators_TypeOfAnalytics6,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.NumberOfUsedDimensions
		ELSE 0
	END AS LinksOfBudgetIndicatorsQuantityOfDimensionsUsed,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.CurrencyIsDeterminedByDimension
		ELSE FALSE
	END AS LinksOfBudgetIndicatorsCurrencyIsDefinedByDimension,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionAddressCurrency
		ELSE 0
	END AS LinksOfBudgetIndicatorsAddressOfDimensionCurrency,
	CASE
		WHEN BudgetFlowItems.BudgetItemForIndicatorCalculation
			AND BudgetFlowItems.BudgetBalanceItem.CurrencyIsDeterminedByDimension
			THEN BudgetFlowItems.BudgetBalanceItem.DimensionCurrencies.CurrencyFilling
		ELSE """"
	END AS LinksOfBudgetIndicatorsFieldOfCurrencyOfDimension
{SELECT
	BudgetFlowItem,
	BudgetBalanceItem,
	Rule.*,
	DimensionKind1,
	DimensionKind2,
	DimensionKind3,
	DimensionKind4,
	DimensionKind5,
	DimensionKind6,
	CurrencyFilling,
	DimensionAddressCurrency,
	DimensionCurrencyField,
	UnitOfMeasureFilling,
	DimensionAddressUnitOfMeasure,
	UnitOfMeasure,
	FieldOfDimensionUnitOfMeasure,
	DataSourceSection,
	DataSource,
	DataSourceXO,
	TypeOfAccountingDataReceipt,
	TypeOfAccountingDataExpense,
	NameOfTheDataSourceTemplate,
	BusinessOperation,
	TransactionAmountSource,
	BalancedAccount,
	CorDataSource,
	SettingsComposer,
	SettingsHash,
	HashOfDataCompositionSchema,
	DataSourceID,
	SourceOfForeignExchange,
	TotalType,
	TurnoverByExpenseDimension,
	DataSourceScheme,
	AdvancedModeOfDimensionFillSetting,
	DimensionPopulationExpression1,
	DimensionPopulationExpression2,
	DimensionPopulationExpression3,
	DimensionPopulationExpression4,
	DimensionPopulationExpression5,
	DimensionPopulationExpression6,
	FillInAnalyticsWithSpecifiedValue1,
	FillInAnalyticsWithSpecifiedValue2,
	FillInAnalyticsWithSpecifiedValue3,
	FillInAnalyticsWithSpecifiedValue4,
	FillInAnalyticsWithSpecifiedValue5,
	FillInAnalyticsWithSpecifiedValue6,
	DimensionValue1,
	DimensionValue2,
	DimensionValue3,
	DimensionValue4,
	DimensionValue5,
	DimensionValue6,
	RuleType,
	ZoomRatio,
	ValidFrom,
	ValidTo,
	Expense,
	BudgetItemForIndicatorCalculation,
	RelationshipsBetweenBudgetIndicators_TypeOfAnalytics1,
	RelationshipsBetweenBudgetIndicators_TypeOfAnalytics2,
	RelationshipsBetweenBudgetIndicators_TypeOfAnalytics3,
	RelationshipsBetweenBudgetIndicators_TypeOfAnalytics4,
	RelationshipsBetweenBudgetIndicators_TypeOfAnalytics5,
	RelationshipsBetweenBudgetIndicators_TypeOfAnalytics6,
	LinksOfBudgetIndicatorsQuantityOfDimensionsUsed,
	LinksOfBudgetIndicatorsCurrencyIsDefinedByDimension,
	LinksOfBudgetIndicatorsAddressOfDimensionCurrency,
	LinksOfBudgetIndicatorsFieldOfCurrencyOfDimension}
FROM
	ActualDataQueryRules_ AS ActualDataQueryRules_
		INNER JOIN BudgetFlowItems AS BudgetFlowItems
		ON ActualDataQueryRules_.BudgetFlowItem = BudgetFlowItems.Ref
WHERE
	CASE
			WHEN ActualDataQueryRules_.NameOfTheDataSourceTemplate = "CashFlowToPayment"
				THEN CAST(ActualDataQueryRules_.DataSource AS Catalog.BusinessTransactionsSettings).Expense = VALUE(Enum.AccountingDataTypes.Cash)
			ELSE TRUE
		END</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
