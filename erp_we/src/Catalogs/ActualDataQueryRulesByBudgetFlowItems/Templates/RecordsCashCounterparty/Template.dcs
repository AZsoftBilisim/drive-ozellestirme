		<field xsi:type="DataSetFieldField">
			<dataPath>SecondPeriod</dataPath>
			<field>SecondPeriod</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period, second</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره، ثانیه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo, secondo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres, sekunda</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период, секунда</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem, saniye</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ, giây</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RecordsCashCounterparty.Recorder AS Recorder,
	RecordsCashCounterparty.SecondPeriod AS SecondPeriod,
	RecordsCashCounterparty.DayPeriod AS DayPeriod,
	RecordsCashCounterparty.WeekPeriod AS WeekPeriod,
	RecordsCashCounterparty.TenDaysPeriod AS TenDaysPeriod,
	RecordsCashCounterparty.MonthPeriod AS MonthPeriod,
	RecordsCashCounterparty.QuarterPeriod AS QuarterPeriod,
	RecordsCashCounterparty.HalfYearPeriod AS HalfYearPeriod,
	RecordsCashCounterparty.YearPeriod AS YearPeriod,
	RecordsCashCounterparty.DayPeriod AS RatePeriod,
	RecordsCashCounterparty.BusinessOperation AS BusinessOperation,
	RecordsCashCounterparty.BusinessOperation AS DataSource,
	RecordsCashCounterparty.Organization AS Organization,
	RecordsCashCounterparty.Department AS Department,
	RecordsCashCounterparty.Cash AS Cash,
	RecordsCashCounterparty.LineOfBusinessCash AS LineOfBusinessCash,
	RecordsCashCounterparty.CashType AS CashType,
	RecordsCashCounterparty.CashFlowItem AS CashFlowItem,
	RecordsCashCounterparty.PaymentCurrency AS Currency,
	RecordsCashCounterparty.Partner AS Partner,
	RecordsCashCounterparty.Counterparty AS Counterparty,
	RecordsCashCounterparty.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	RecordsCashCounterparty.Contract AS Contract,
	RecordsCashCounterparty.ARAPObject AS ARAPObject,
	RecordsCashCounterparty.ARAPDocument AS ARAPDocument,
	RecordsCashCounterparty.PayAmountTurnover AS PayAmount,
	RecordsCashCounterparty.PaymentAmountLocalTurnover AS PaymentAmountLocal,
	RecordsCashCounterparty.PostpaymentAmountTurnover AS PostpaymentAmount,
	RecordsCashCounterparty.PostpaymentAmountLocalTurnover AS PostpaymentAmountLocal,
	RecordsCashCounterparty.PrepaymentAmountManTurnover AS PrepaymentAmountMan,
	RecordsCashCounterparty.PrepaymentAmountLocalTurnover AS PrepaymentAmountLocal,
	RecordsCashCounterparty.PaymentAmountPaymentCurrencyTurnover AS PaymentAmountPaymentCurrency,
	RecordsCashCounterparty.PaymentAmountInPaymentCurrencyTurnover AS PaymentAmountInPaymentCurrency,
	RecordsCashCounterparty.PrepaymentAmountTurnover AS PrepaymentAmount,
	RecordsCashCounterparty.VATAmountTurnover AS VATAmount,
	RecordsCashCounterparty.VATAmountComplTurnover AS VATAmountCompl,
	RecordsCashCounterparty.AmountVATCurrencyPaymentTurnover AS AmountVATCurrencyPayment,
	RecordsCashCounterparty.AmountToBePaidWithinLimitTurnover AS AmountToBePaidWithinLimit,
	RecordsCashCounterparty.AmountToBePaidAboveLimitTurnover AS AmountToBePaidAboveLimit,
	RecordsCashCounterparty.AmountToBePaidWithinLimitTurnover + RecordsCashCounterparty.AmountToBePaidAboveLimitTurnover AS AmountToBePaid
{SELECT
	Recorder.*,
	SecondPeriod,
	YearPeriod,
	HalfYearPeriod,
	QuarterPeriod,
	MonthPeriod,
	TenDaysPeriod,
	WeekPeriod,
	DayPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	Organization.*,
	Department.*,
	Cash.*,
	LineOfBusinessCash.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	Partner.*,
	Counterparty.*,
	CounterpartyLineOfBusiness.*,
	Contract.*,
	ARAPObject.*,
	ARAPDocument.*,
	PayAmount,
	PaymentAmountLocal,
	PostpaymentAmount,
	PostpaymentAmountLocal,
	PrepaymentAmountMan,
	PrepaymentAmountLocal,
	PaymentAmountPaymentCurrency,
	PaymentAmountInPaymentCurrency,
	PrepaymentAmount,
	VATAmount,
	VATAmountCompl,
	AmountVATCurrencyPayment,
	AmountToBePaidWithinLimit,
	AmountToBePaidAboveLimit,
	AmountToBePaid}
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto,  &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (BusinessOperation IN (&amp;BusinessOperation)), (BusinessOperation), (BusinessOperation) AS DataSource, (Cash).*, (CashType).*, (CashFlowItem).*, (PaymentCurrency).* AS Currency, (Counterparty).*, (Contract).*, (ARAPObject).*, (ARAPDocument).*, (Organization).*, (Department).*, (LineOfBusinessCash).*, (CounterpartyLineOfBusiness).*}) AS RecordsCashCounterparty
{WHERE
	RecordsCashCounterparty.Organization.* AS Organization,
	RecordsCashCounterparty.Department.* AS Department,
	RecordsCashCounterparty.Cash.* AS Cash,
	RecordsCashCounterparty.LineOfBusinessCash.* AS LineOfBusinessCash,
	RecordsCashCounterparty.CashFlowItem.* AS CashFlowItem,
	RecordsCashCounterparty.PaymentCurrency.* AS Currency,
	RecordsCashCounterparty.Partner.* AS Partner,
	RecordsCashCounterparty.Counterparty.* AS Counterparty,
	RecordsCashCounterparty.CounterpartyLineOfBusiness.* AS CounterpartyLineOfBusiness,
	RecordsCashCounterparty.Contract.* AS Contract,
	RecordsCashCounterparty.ARAPObject.* AS ARAPObject,
	RecordsCashCounterparty.ARAPDocument.* AS ARAPDocument,
	
	RecordsCashCounterparty.Recorder.*,
	RecordsCashCounterparty.YearPeriod,
	RecordsCashCounterparty.HalfYearPeriod,
	RecordsCashCounterparty.QuarterPeriod,
	RecordsCashCounterparty.MonthPeriod,
	RecordsCashCounterparty.TenDaysPeriod,
	RecordsCashCounterparty.WeekPeriod,
	RecordsCashCounterparty.DayPeriod,
	RecordsCashCounterparty.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
