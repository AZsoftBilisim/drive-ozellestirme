		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE
		WHEN DocumentsData.Source IN (VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem), VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem))
			THEN TRUE
		ELSE FALSE
	END AS SourceAsset,
	CASE
		WHEN DocumentsData.Recipient IN (VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem), VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem))
			THEN TRUE
		ELSE FALSE
	END AS RecipientAsset,
	DocumentsData.Date AS Date,
	DocumentsData.Currency AS Currency,
	DocumentsData.Source AS Source,
	DocumentsData.Recipient AS Recipient,
	DocumentsData.Increase AS Increase,
	DocumentsData.Organization AS Organization,
	DocumentsData.Ref AS Recorder
INTO DocumentsData
FROM
	Document.MovementOfOtherAssetsAndLiabilities AS DocumentsData
{WHERE
	DocumentsData.Ref.* AS Recorder}

INDEX BY
	Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN DATEDIFF(PostingData.DateRecord, DocumentsData.Date, DAY) = 0
				OR PostingData.DateRecord = DATETIME(1, 1, 1)
			THEN DocumentsData.Date
		ELSE PostingData.DateRecord
	END AS Period,
	DocumentsData.Recorder AS Recorder,
	DocumentsData.Organization AS Organization,
	PostingData.ReceivingBusinessUnit AS Department,
	PostingData.LineOfBusinessRecipient AS LineOfBusiness,
	CASE
		WHEN DocumentsData.Increase
			THEN VALUE(AccumulationRecordType.Receipt)
		ELSE VALUE(AccumulationRecordType.Expense)
	END AS RecordType,
	PostingData.LineNumber AS LineNumber,
	PostingData.ItemRecipient AS AssetRef,
	CASE
		WHEN DocumentsData.Recipient = VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem)
			THEN PostingData.ExpensesDimensionRecipient
		WHEN DocumentsData.Recipient = VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)
			THEN PostingData.IncomeDimensionRecipient
		ELSE PostingData.AssetsLiabilitiesDimensionRecipient
	END AS Dimension,
	PostingData.Sum AS Sum,
	DocumentsData.Currency AS Currency,
	CASE
		WHEN DocumentsData.Recipient = VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem)
			THEN "Expenses"
		WHEN DocumentsData.Recipient = VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)
			THEN "Income"
		ELSE "AssetsLiabilities"
	END AS RegisterType_,
	DocumentsData.Recipient AS ArticleType,
	FALSE AS WriteOff,
	&amp;IDOfUnusedFinRecord AS FinRecordID
INTO PostingData
FROM
	Document.MovementOfOtherAssetsAndLiabilities.PostingData AS PostingData
		INNER JOIN DocumentsData AS DocumentsData
		ON PostingData.Ref = DocumentsData.Recorder

UNION ALL

SELECT
	CASE
		WHEN DATEDIFF(PostingData.DateRecord, DocumentsData.Date, DAY) = 0
				OR PostingData.DateRecord = DATETIME(1, 1, 1)
			THEN DocumentsData.Date
		ELSE PostingData.DateRecord
	END,
	DocumentsData.Recorder,
	DocumentsData.Organization,
	PostingData.BusinessUnitSource,
	PostingData.LineOfBusinessSource,
	CASE
		WHEN DocumentsData.Increase
					AND DocumentsData.SourceAsset = DocumentsData.RecipientAsset
				OR NOT DocumentsData.Increase
					AND DocumentsData.SourceAsset &lt;&gt; DocumentsData.RecipientAsset
			THEN VALUE(AccumulationRecordType.Expense)
		ELSE VALUE(AccumulationRecordType.Receipt)
	END,
	PostingData.LineNumber,
	PostingData.SourceItem,
	CASE
		WHEN DocumentsData.Source = VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem)
			THEN PostingData.ExpensesDimensionSource
		WHEN DocumentsData.Source = VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)
			THEN PostingData.IncomeDimensionSource
		ELSE PostingData.AssetsLiabilitiesDimensionSource
	END,
	PostingData.Sum,
	DocumentsData.Currency,
	CASE
		WHEN DocumentsData.Source = VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem)
			THEN "Expenses"
		WHEN DocumentsData.Source = VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)
			THEN "Income"
		ELSE "AssetsLiabilities"
	END,
	DocumentsData.Source,
	TRUE,
	&amp;IDOfUnusedFinRecord
FROM
	Document.MovementOfOtherAssetsAndLiabilities.PostingData AS PostingData
		INNER JOIN DocumentsData AS DocumentsData
		ON PostingData.Ref = DocumentsData.Recorder

INDEX BY
	Recorder,
	LineNumber
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Source.Period AS Period,
	Source.Recorder AS Recorder,
	VALUE(Catalog.BusinessTransactionsSettings.FlowOfAssetsLiabilitiesDueToAssetsLiabilities) AS SettingUpBusinessTransaction,
	Source.Organization AS Organization,
	Source.Department AS DepartmentExpense,
	Source.LineOfBusiness AS LineOfBusinessExpense,
	UNDEFINED AS IncomeAndExpenseItemExpense,
	Source.AssetRef AS AssetAndLiabilityItemExpense,
	UNDEFINED AS DimensionOfRevenueExpense,
	UNDEFINED AS DimensionOfExpensesExpense,
	Source.Dimension AS AssetsLiabilitiesDimensionExpense,
	Recipient.Department AS DepartmentReceipt,
	Recipient.LineOfBusiness AS LineOfBusinessReceipt,
	UNDEFINED AS IncomeAndExpenseItemReceipt,
	Recipient.AssetRef AS AssetAndLiabilityItemReceipt,
	UNDEFINED AS DimensionOfRevenueReceipt,
	UNDEFINED AS DimensionOfExpensesReceipt,
	Recipient.Dimension AS AssetsLiabilitiesDimensionReceipt,
	Source.Currency AS Currency,
	Source.Sum AS Sum
{SELECT
	Period,
	Recorder,
	Organization.*,
	DepartmentExpense.*,
	LineOfBusinessExpense.*,
	IncomeAndExpenseItemExpense.*,
	AssetAndLiabilityItemExpense.*,
	DimensionOfRevenueExpense.*,
	DimensionOfExpensesExpense.*,
	AssetsLiabilitiesDimensionExpense.*,
	DepartmentReceipt.*,
	LineOfBusinessReceipt.*,
	IncomeAndExpenseItemReceipt,
	AssetAndLiabilityItemReceipt.*,
	DimensionOfRevenueReceipt,
	DimensionOfExpensesReceipt,
	AssetsLiabilitiesDimensionReceipt.*,
	Currency.*,
	Sum}
FROM
	PostingData AS Source
		INNER JOIN PostingData AS Recipient
		ON Source.Recorder = Recipient.Recorder
			AND Source.LineNumber = Recipient.LineNumber
			AND (Source.WriteOff)
			AND (NOT Recipient.WriteOff)
			AND (Source.ArticleType IN (VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem), VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem)))
			AND (Recipient.ArticleType IN (VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem), VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem)))
{WHERE
	Source.Period}

UNION ALL

SELECT
	Source.Period,
	Source.Recorder,
	VALUE(Catalog.BusinessTransactionsSettings.FlowOfIncomeDueToAssetsLiabilities),
	Source.Organization,
	Source.Department,
	Source.LineOfBusiness,
	Source.AssetRef,
	UNDEFINED,
	Source.Dimension,
	UNDEFINED,
	UNDEFINED,
	Recipient.Department,
	Recipient.LineOfBusiness,
	UNDEFINED,
	Recipient.AssetRef,
	UNDEFINED,
	UNDEFINED,
	Recipient.Dimension,
	Source.Currency,
	Source.Sum
FROM
	PostingData AS Source
		INNER JOIN PostingData AS Recipient
		ON Source.Recorder = Recipient.Recorder
			AND Source.LineNumber = Recipient.LineNumber
			AND (Source.WriteOff)
			AND (NOT Recipient.WriteOff)
			AND (Source.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem))
			AND (Recipient.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem))
{WHERE
	Source.Period}

UNION ALL

SELECT
	Source.Period,
	Source.Recorder,
	VALUE(Catalog.BusinessTransactionsSettings.WriteOffOtherExpenses),
	Source.Organization,
	Source.Department,
	Source.LineOfBusiness,
	Source.AssetRef,
	UNDEFINED,
	UNDEFINED,
	Source.Dimension,
	UNDEFINED,
	Recipient.Department,
	Recipient.LineOfBusiness,
	UNDEFINED,
	Recipient.AssetRef,
	UNDEFINED,
	UNDEFINED,
	Recipient.Dimension,
	Source.Currency,
	Source.Sum
FROM
	PostingData AS Source
		INNER JOIN PostingData AS Recipient
		ON Source.Recorder = Recipient.Recorder
			AND Source.LineNumber = Recipient.LineNumber
			AND (Source.WriteOff)
			AND (NOT Recipient.WriteOff)
			AND (Source.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem))
			AND (Recipient.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem))
{WHERE
	Source.Period}

UNION ALL

SELECT
	Source.Period,
	Source.Recorder,
	VALUE(Catalog.BusinessTransactionsSettings.WriteOffOtherIncome),
	Source.Organization,
	Source.Department,
	Source.LineOfBusiness,
	Source.AssetRef,
	UNDEFINED,
	Source.Dimension,
	UNDEFINED,
	UNDEFINED,
	Recipient.Department,
	Recipient.LineOfBusiness,
	UNDEFINED,
	Recipient.AssetRef,
	UNDEFINED,
	UNDEFINED,
	Recipient.Dimension,
	Source.Currency,
	Source.Sum
FROM
	PostingData AS Source
		INNER JOIN PostingData AS Recipient
		ON Source.Recorder = Recipient.Recorder
			AND Source.LineNumber = Recipient.LineNumber
			AND (Source.WriteOff)
			AND (NOT Recipient.WriteOff)
			AND (Source.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem))
			AND (Recipient.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem))
{WHERE
	Source.Period}

UNION ALL

SELECT
	Source.Period,
	Source.Recorder,
	VALUE(Catalog.BusinessTransactionsSettings.OtherExpensesLiabilities),
	Source.Organization,
	Source.Department,
	Source.LineOfBusiness,
	Source.AssetRef,
	UNDEFINED,
	UNDEFINED,
	Source.Dimension,
	UNDEFINED,
	Recipient.Department,
	Recipient.LineOfBusiness,
	UNDEFINED,
	Recipient.AssetRef,
	UNDEFINED,
	UNDEFINED,
	Recipient.Dimension,
	Source.Currency,
	Source.Sum
FROM
	PostingData AS Source
		INNER JOIN PostingData AS Recipient
		ON Source.Recorder = Recipient.Recorder
			AND Source.LineNumber = Recipient.LineNumber
			AND (Source.WriteOff)
			AND (NOT Recipient.WriteOff)
			AND (Source.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem))
			AND (Recipient.ArticleType = VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem))
{WHERE
	Source.Period}</query>
	</dataSet>
