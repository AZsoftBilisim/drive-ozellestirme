		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RecordsCashIncomeExpenses.Recorder AS Recorder,
	RecordsCashIncomeExpenses.SecondPeriod AS SecondPeriod,
	RecordsCashIncomeExpenses.DayPeriod AS DayPeriod,
	RecordsCashIncomeExpenses.WeekPeriod AS WeekPeriod,
	RecordsCashIncomeExpenses.TenDaysPeriod AS TenDaysPeriod,
	RecordsCashIncomeExpenses.MonthPeriod AS MonthPeriod,
	RecordsCashIncomeExpenses.QuarterPeriod AS QuarterPeriod,
	RecordsCashIncomeExpenses.HalfYearPeriod AS HalfYearPeriod,
	RecordsCashIncomeExpenses.YearPeriod AS YearPeriod,
	RecordsCashIncomeExpenses.DayPeriod AS RatePeriod,
	RecordsCashIncomeExpenses.BusinessOperation AS BusinessOperation,
	RecordsCashIncomeExpenses.BusinessOperation AS DataSource,
	RecordsCashIncomeExpenses.Organization AS Organization,
	RecordsCashIncomeExpenses.Department AS Department,
	RecordsCashIncomeExpenses.IncomeExpenseBusinessUnit AS IncomeExpenseBusinessUnit,
	RecordsCashIncomeExpenses.Cash AS Cash,
	RecordsCashIncomeExpenses.CashType AS CashType,
	RecordsCashIncomeExpenses.CashFlowItem AS CashFlowItem,
	RecordsCashIncomeExpenses.Currency AS Currency,
	RecordsCashIncomeExpenses.IncomeAndExpenseItem AS IncomeAndExpenseItem,
	RecordsCashIncomeExpenses.DimensionOfRevenue AS DimensionOfRevenue,
	RecordsCashIncomeExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	RecordsCashIncomeExpenses.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	RecordsCashIncomeExpenses.SumTurnover AS Sum,
	RecordsCashIncomeExpenses.SumComplTurnover AS SumCompl,
	RecordsCashIncomeExpenses.AmountInCurrencyTurnover AS AmountInCurrency,
	RecordsCashIncomeExpenses.VATAmountTurnover AS VATAmount,
	RecordsCashIncomeExpenses.VATAmountComplTurnover AS VATAmountCompl,
	RecordsCashIncomeExpenses.AmountVATCurrencyPaymentTurnover AS AmountVATCurrencyPayment,
	RecordsCashIncomeExpenses.AmountToBePaidWithinLimitTurnover AS AmountToBePaidWithinLimit,
	RecordsCashIncomeExpenses.AmountToBePaidAboveLimitTurnover AS AmountToBePaidAboveLimit,
	RecordsCashIncomeExpenses.AmountToBePaidWithinLimitTurnover + RecordsCashIncomeExpenses.AmountToBePaidAboveLimitTurnover AS AmountToBePaid,
	RecordsCashIncomeExpenses.LineOfBusinessCash AS LineOfBusinessCash,
	RecordsCashIncomeExpenses.LineOfBusinessItems AS LineOfBusinessItems,
	RecordsCashIncomeExpenses.SumTurnover - RecordsCashIncomeExpenses.VATAmountTurnover AS AmountExcludingVAT,
	RecordsCashIncomeExpenses.SumComplTurnover - RecordsCashIncomeExpenses.VATAmountComplTurnover AS LocalAmountExcludingVAT,
	RecordsCashIncomeExpenses.AmountInCurrencyTurnover - RecordsCashIncomeExpenses.AmountVATCurrencyPaymentTurnover AS AmountExcludingVATInPaymentCurrency
{SELECT
	Recorder.*,
	SecondPeriod,
	YearPeriod,
	HalfYearPeriod,
	QuarterPeriod,
	MonthPeriod,
	TenDaysPeriod,
	WeekPeriod,
	DayPeriod,
	RatePeriod,
	BusinessOperation.*,
	DataSource,
	Organization.*,
	Department.*,
	IncomeExpenseBusinessUnit.*,
	Cash.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	IncomeAndExpenseItem.*,
	DimensionOfRevenue.*,
	DimensionOfExpenses.*,
	AssetsLiabilitiesDimension.*,
	Sum,
	SumCompl,
	AmountInCurrency,
	VATAmount,
	VATAmountCompl,
	AmountVATCurrencyPayment,
	AmountToBePaidWithinLimit,
	AmountToBePaidAboveLimit,
	AmountToBePaid,
	LineOfBusinessCash.*,
	LineOfBusinessItems.*,
	AmountExcludingVAT,
	LocalAmountExcludingVAT,
	AmountExcludingVATInPaymentCurrency}
FROM
	AccumulationRegister.RecordsCashIncomeExpenses.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (BusinessOperation IN (&amp;BusinessOperation)), (BusinessOperation), (BusinessOperation) AS DataSource, (Cash).*, (CashType).*, (CashFlowItem).*, (Currency).*, (IncomeAndExpenseItem).*, (DimensionOfRevenue).*, (DimensionOfExpenses).*, (AssetsLiabilitiesDimension).*, (Organization).*, (Department).*, (IncomeExpenseBusinessUnit).*, (LineOfBusinessCash).*, (LineOfBusinessItems).*}) AS RecordsCashIncomeExpenses
{WHERE
	RecordsCashIncomeExpenses.Organization.* AS Organization,
	RecordsCashIncomeExpenses.Department.* AS Department,
	RecordsCashIncomeExpenses.IncomeExpenseBusinessUnit.* AS IncomeExpenseBusinessUnit,
	RecordsCashIncomeExpenses.Cash.* AS Cash,
	RecordsCashIncomeExpenses.CashFlowItem.* AS CashFlowItem,
	RecordsCashIncomeExpenses.Currency.* AS Currency,
	RecordsCashIncomeExpenses.IncomeAndExpenseItem.* AS IncomeAndExpenseItem,
	RecordsCashIncomeExpenses.DimensionOfRevenue.* AS DimensionOfRevenue,
	RecordsCashIncomeExpenses.DimensionOfExpenses.* AS DimensionOfExpenses,
	RecordsCashIncomeExpenses.AssetsLiabilitiesDimension.* AS AssetsLiabilitiesDimension,
	RecordsCashIncomeExpenses.LineOfBusinessCash.* AS LineOfBusinessCash,
	RecordsCashIncomeExpenses.LineOfBusinessItems.* AS LineOfBusinessItems,
	
	RecordsCashIncomeExpenses.Recorder.*,
	RecordsCashIncomeExpenses.YearPeriod,
	RecordsCashIncomeExpenses.HalfYearPeriod,
	RecordsCashIncomeExpenses.QuarterPeriod,
	RecordsCashIncomeExpenses.MonthPeriod,
	RecordsCashIncomeExpenses.TenDaysPeriod,
	RecordsCashIncomeExpenses.WeekPeriod,
	RecordsCashIncomeExpenses.DayPeriod,
	RecordsCashIncomeExpenses.DayPeriod AS RatePeriod}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<parameter>
		<name>BusinessOperation</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Business transaction</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>عملیات تجاری</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Operazione economica</v8:content>
			</v8:item>
			<v8:item>
