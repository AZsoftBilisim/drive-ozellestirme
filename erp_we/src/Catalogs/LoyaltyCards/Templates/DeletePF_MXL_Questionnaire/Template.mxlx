					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Rules for the use of loyalty card "[CardKind]"</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>قواعد استفاده از کارت وفاداری «[CardKind]»</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Termini di utilizzo della carta fedeltà "[CardKind]"</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Zasady korzystania z karty lojalnościowej «[CardKind]»</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Правила использования карты лояльности «[CardKind]»</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Sadakat kartı kullanım kuralları «[CardKind]»</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Quy tắc sử dụng thẻ khách hàng thân thiết «[CardKind]»</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
