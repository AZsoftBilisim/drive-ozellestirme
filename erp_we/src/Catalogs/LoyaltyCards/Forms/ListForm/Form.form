  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogLoyaltyCards.Ref,
	CatalogLoyaltyCards.DataVersion,
	CatalogLoyaltyCards.DeletionMark,
	CatalogLoyaltyCards.Predefined,
	CatalogLoyaltyCards.Owner,
	CatalogLoyaltyCards.Description,
	CatalogLoyaltyCards.Barcode,
	CatalogLoyaltyCards.MagneticCode,
	CatalogLoyaltyCards.Status,
	CatalogLoyaltyCards.Partner,
	CatalogLoyaltyCards.Counterparty,
	CatalogLoyaltyCards.Terms,
	
	CatalogLoyaltyCards.Owner.ValidityStartDate AS ValidityStartDate,
	CatalogLoyaltyCards.Owner.ValidityEndDate AS ValidityEndDate,
	
	CASE
		WHEN
			CatalogLoyaltyCards.Owner.DeletionMark
		THEN
			VALUE(Enum.LoyaltyCardStates.EmptyRef)
		// closed ////////////////////////////////////////////////////////////////
		WHEN
			CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Cancelled__)
		THEN
			VALUE(Enum.LoyaltyCardStates.Cancelled__)
		// IT WORKS ///////////////////////////////////////////////////////////////
		WHEN
			CatalogLoyaltyCards.Owner.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
		THEN
			VALUE(Enum.LoyaltyCardStates.Valid)
	END AS State,

	CASE
		WHEN
			CatalogLoyaltyCards.Owner.DeletionMark
		THEN
			FALSE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Valid)
			AND ((CatalogLoyaltyCards.Owner.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCards.Owner.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS ValidityPeriodExpired,
	
	CASE
		WHEN
			CatalogLoyaltyCards.Owner.DeletionMark
		THEN
			FALSE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Valid)
			AND ((CatalogLoyaltyCards.Owner.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCards.Owner.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS TheValidityPeriodHasNotCome,
	
	CASE
		WHEN
			CatalogLoyaltyCards.Owner.DeletionMark
		THEN
			DATETIME(1,1,1)
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Valid)
			AND CatalogLoyaltyCards.Owner.ValidityEndDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogLoyaltyCards.Owner.ValidityEndDate
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Valid)
			AND ((CatalogLoyaltyCards.Owner.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCards.Owner.ValidityStartDate > &amp;UpdateDate))
		THEN
			CatalogLoyaltyCards.Owner.ValidityStartDate
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	
	CASE
		WHEN
			CatalogLoyaltyCards.Owner.DeletionMark
		THEN
			FALSE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Valid)
			AND ((CatalogLoyaltyCards.Owner.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCards.Owner.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogLoyaltyCards.Status = VALUE(Enum.LoyaltyCardStatuses.Valid)
			AND ((CatalogLoyaltyCards.Owner.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCards.Owner.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS Overdue
	
FROM
	Catalog.LoyaltyCards AS CatalogLoyaltyCards</queryText>
