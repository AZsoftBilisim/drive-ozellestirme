    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	StatusAtBeginningOfPeriod.Employee AS Employee,
	MAX(StatusAtBeginningOfPeriod.Period) AS Period
INTO CurrentData_Grouped
FROM
	InformationRegister.EmploymentRecord.SliceLast(&amp;Period, Organization = &amp;Organization) AS StatusAtBeginningOfPeriod

GROUP BY
	StatusAtBeginningOfPeriod.Employee
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CurrentData_Grouped.Employee AS Employee,
	StatusAtBeginningOfPeriod.Department AS Department,
	StatusAtBeginningOfPeriod.JobTitle AS JobTitle,
	StatusAtBeginningOfPeriod.EmploymentKind AS EmploymentKind,
	CASE
		WHEN StatusAtBeginningOfPeriod.WorksInBusinessUnit
			THEN StatusAtBeginningOfPeriod.Period
		ELSE DATETIME(1, 1, 1)
	END AS DateOfAdmission,
	CASE
		WHEN NOT StatusAtBeginningOfPeriod.WorksInBusinessUnit
			THEN StatusAtBeginningOfPeriod.Period
		ELSE DATETIME(1, 1, 1)
	END AS DateOfDismissal,
	CASE
		WHEN StatusAtBeginningOfPeriod.WorksInBusinessUnit
			THEN TRUE
		ELSE FALSE
	END AS ItWorks
INTO UpToDateData
FROM
	CurrentData_Grouped AS CurrentData_Grouped
		INNER JOIN InformationRegister.EmploymentRecord.SliceLast(&amp;Period, Organization = &amp;Organization) AS StatusAtBeginningOfPeriod
		ON CurrentData_Grouped.Period = StatusAtBeginningOfPeriod.Period
			AND CurrentData_Grouped.Employee = StatusAtBeginningOfPeriod.Employee
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	EmployeesHR.Ref AS Ref,
	EmployeesHR.Description AS Description,
	EmployeesHR.Code AS Code,
	EmployeesHR.InArchive AS InArchive,
	EmployeesHR.ParentCompany AS Organization,
	EmployeesHR.Individual AS Individual,
	EmployeesHR.NameClarification AS NameClarification,
	EmployeesHR.DeletionMark AS DeletionMark,
	EmployeesHR.DataVersion AS DataVersion,
	CASE
		WHEN EmployeesHR.DeletionMark
			THEN 4
		ELSE 3
	END AS Pictogram,
	CASE
		WHEN EmployeesHR.HeadEmployee = VALUE(Catalog.EmployeesHR.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS IsHeadEmployee,
	ISNULL(UpToDateData.Department, VALUE(Catalog.BusinessStructure.EmptyRef)) AS Department,
	ISNULL(UpToDateData.JobTitle, VALUE(Catalog.JobTitles.EmptyRef)) AS JobTitle,
	ISNULL(UpToDateData.EmploymentKind, VALUE(Enum.EmploymentKindsPayrollAndHumanResources.EmptyRef)) AS EmploymentKind,
	ISNULL(UpToDateData.DateOfAdmission, DATETIME(1, 1, 1)) AS DateOfAdmission,
	ISNULL(UpToDateData.DateOfDismissal, DATETIME(1, 1, 1)) AS DateOfDismissal,
	ISNULL(UpToDateData.ItWorks, FALSE) AS ItWorks
FROM
	Catalog.EmployeesHR AS EmployeesHR
		LEFT JOIN UpToDateData AS UpToDateData
		ON EmployeesHR.Ref = UpToDateData.Employee</queryText>
      <mainTable>Catalog.EmployeesHR</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
