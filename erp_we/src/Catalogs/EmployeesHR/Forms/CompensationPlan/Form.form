  <attributes>
    <name>Accruals</name>
    <title>
      <key>en</key>
      <value>Accruals</value>
    </title>
    <title>
      <key>fa</key>
      <value>اقلام تعهدی</value>
    </title>
    <title>
      <key>ru</key>
      <value>Начисления</value>
    </title>
    <title>
      <key>tr</key>
      <value>Tahakkuklar</value>
    </title>
    <title>
      <key>vi</key>
      <value>Tính toán</value>
    </title>
    <title>
      <key>it</key>
      <value>Accruals</value>
    </title>
    <title>
      <key>pl</key>
      <value>Accruals</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Accruals.Recorder</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RegularAccrualsAndDeductionsHRSliceLast.AccrualDeduction AS Accrual,
	RegularAccrualsAndDeductionsHRSliceLast.Recorder AS Recorder,
	RegularAccrualsAndDeductionsHRSliceLast.Period AS Period,
	RegularAccrualsAndDeductionsHRSliceLast.Organization AS Organization,
	RegularAccrualsAndDeductionsHRSliceLast.Department AS Department,
	RegularAccrualsAndDeductionsHRSliceLast.BasicEarnings AS BasicEarnings,
	RegularAccrualsAndDeductionsHRSliceLast.Value AS Value,
	RegularAccrualsAndDeductionsHRSliceLast.Valid AS Valid
FROM
	InformationRegister.RegularAccrualsAndDeductionsHR.SliceLast(
			,
			Employee = &amp;Employee
				AND NOT AccrualDeduction.ItIsADeduction) AS RegularAccrualsAndDeductionsHRSliceLast
WHERE
	RegularAccrualsAndDeductionsHRSliceLast.Valid</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Accrual</dataPath>
        <field>Accrual</field>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Accrual</value>
            </content>
            <content>
              <key>fa</key>
              <value>محاسبه</value>
            </content>
