    </producedTypes>
    <name>DeleteAccessValueSets</name>
    <synonym>
      <key>en</key>
      <value>(not used) Access value sets</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>(استفاده نمی‌شود) مجموعه‌های مقدار دسترسی</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>(не используется) Наборы значений доступа</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>(Kullanılmıyor) Erişim değeri kümeleri</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>(không sử dụng) Tập hợp giá trị truy cập</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>(not used) Access value sets</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>(not used) Access value sets</value>
    </synonym>
    <standardAttributes>
      <dataHistory>Use</dataHistory>
      <name>LineNumber</name>
      <fillValue xsi:type="core:UndefinedValue"/>
