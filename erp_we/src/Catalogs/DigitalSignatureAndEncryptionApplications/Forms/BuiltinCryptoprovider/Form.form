    <value>Yerleşik kripto sağlayıcı</value>
  </title>
  <title>
    <key>vi</key>
    <value>Nhà cung cấp mã hóa hệ thống</value>
  </title>
  <items xsi:type="form:FormGroup">
    <name>ApplicationInfoGroup</name>
    <id>7</id>
    <items xsi:type="form:Decoration">
      <name>InformationDecoration</name>
      <id>4</id>
      <title>
        <key>en</key>
        <value>Decoration information</value>
      </title>
      <title>
        <key>fa</key>
        <value>اطلاعات تزئینی</value>
      </title>
      <title>
        <key>it</key>
        <value>Decorazione informazione</value>
      </title>
      <title>
        <key>pl</key>
        <value>Dekoracja informacja</value>
      </title>
      <title>
        <key>ru</key>
        <value>Декорация информация</value>
      </title>
      <title>
        <key>tr</key>
        <value>Tasarım bilgileri</value>
      </title>
      <title>
        <key>vi</key>
        <value>Trang trí thông tin</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>InformationDecorationExtendedTooltip</name>
        <id>6</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
