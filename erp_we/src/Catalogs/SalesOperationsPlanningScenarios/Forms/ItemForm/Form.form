      <value>Cấu trúc kế hoạch</value>
    </title>
    <id>31</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PlansStructure.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PlansStructure.РеквизитДопУпорядочивания</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogPlanProfiles.Ref AS Ref,
	CatalogPlanProfiles.DeletionMark AS DeletionMark,
	CatalogPlanProfiles.PlanType AS PlanType,
	CatalogPlanProfiles.IsFolder AS IsFolder,
	CatalogPlanProfiles.PlanningProcedure AS PlanningProcedure,
	CASE
		WHEN CatalogPlanProfiles.IsFolder
			THEN CASE
					WHEN CatalogPlanProfiles.DeletionMark
						THEN 6
					ELSE CASE
							WHEN CatalogPlanProfiles.DemandPlanning
								THEN 0
							ELSE 1
						END
				END
		ELSE CASE
				WHEN CatalogPlanProfiles.DeletionMark
					THEN 7
				ELSE CASE
						WHEN CatalogPlanProfiles.Parent = VALUE(Catalog.PlanProfiles.EmptyRef)
								AND &amp;PlanningProcessManagement
							THEN 8
						WHEN CatalogPlanProfiles.FillInByShortage
							THEN 3
						ELSE 2
					END
			END
	END AS PictureNumber,
	CASE
		WHEN NOT CatalogPlanProfiles.IsFolder AND CatalogPlanProfiles.Parent = VALUE(Catalog.PlanProfiles.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS PlanningGroupIsNotFilledIn
FROM
	Catalog.PlanProfiles AS CatalogPlanProfiles</queryText>
      <mainTable>Catalog.PlanProfiles</mainTable>
