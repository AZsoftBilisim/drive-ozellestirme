  <attributes uuid="00b6d3b4-ff5a-47d0-a171-042001b0494a">
    <name>Calendar</name>
    <synonym>
      <key>en</key>
      <value>Calendar</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تقویم</value>
    </synonym>
    <synonym>
      <key>it</key>
