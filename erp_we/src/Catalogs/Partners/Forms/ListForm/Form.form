  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BranchOffice</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Client</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MainCounterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Vendor</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogPartners.Ref,
	CatalogPartners.DeletionMark,
	CatalogPartners.Predefined,
	CatalogPartners.Parent,
	CatalogPartners.Code,
	CatalogPartners.Description,
	CatalogPartners.BusinessRegion,
	CatalogPartners.AccessGroup,
	CatalogPartners.RegistrationDate,
	CatalogPartners.Client,
	CatalogPartners.Comment,
	CatalogPartners.Competitor,
	CatalogPartners.DescriptionFull,
	CatalogPartners.MainManager,
	CatalogPartners.Vendor,
	CatalogPartners.Carrier,
	CatalogPartners.OtherRelations,
	CatalogPartners.AdditionalAttributes.(
		Ref,
		LineNumber,
		Property,
		Value,
		TextString),
	CatalogPartners.ContactInformation.(
		Ref,
		LineNumber,
		Type,
		Kind,
		Presentation,
		FieldValues,
		Country,
		State,
		City,
		EMAddress,
		ServerDomainName,
		PhoneNumber,
		PhoneNumberWithoutCodes),
	CounterpartiesOverridable.Ref AS Counterparty,
	CounterpartiesOverridable.LegalEntityIndividual,
	CASE
		WHEN CounterpartiesOverridable.BranchOffice
			THEN CounterpartiesOverridable.MainCounterparty
		ELSE VALUE(Catalog.Counterparties.EmptyRef)
	END AS MainCounterparty,
	CASE
		WHEN CounterpartiesOverridable.BranchOffice
			THEN &amp;RepresentationOfASeparateDivision
		ELSE PRESENTATION(CounterpartiesOverridable.LegalEntityIndividual)
	END AS CounterpartyKind,
	CounterpartiesOverridable.BranchOffice,
	CounterpartiesOverridable.TIN AS TIN,
	UNDEFINED AS CRTR,
	UNDEFINED AS NCBOCode,
	UNDEFINED AS CounterpartyCheckStatus,
	3 AS ImageNumberVerificationStatus,
	1 AS EDI
FROM
	Catalog.Partners AS CatalogPartners
		{INNER JOIN Catalog.Counterparties AS CounterpartiesOverridable
		ON CounterpartiesOverridable.Partner = CatalogPartners.Ref}
WHERE
	CASE
		WHEN
		NOT &amp;SelectionBySegmentIsSet
			THEN TRUE
		ELSE CatalogPartners.Ref IN (&amp;FilterBySegment)
	END
	AND CASE
		WHEN
		NOT &amp;FullTextSearchSelectionIsSet
			THEN TRUE
		ELSE CatalogPartners.Ref IN (&amp;FullTextSearchSelection)
	END</queryText>
      <mainTable>Catalog.Partners</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
