          <items xsi:type="form:FormField">
            <name>PricesKind</name>
            <id>295</id>
            <title>
              <key>en</key>
              <value>General price type</value>
            </title>
            <title>
              <key>fa</key>
              <value>نوع قیمت عمومی</value>
            </title>
            <title>
              <key>it</key>
              <value>Tipo di prezzo generale</value>
            </title>
            <title>
              <key>pl</key>
              <value>Ogólny rodzaj cen</value>
            </title>
            <title>
              <key>ru</key>
              <value>Общий вид цен</value>
            </title>
            <title>
              <key>tr</key>
              <value>Genel fiyat türü</value>
            </title>
            <title>
              <key>vi</key>
              <value>Dạng giá chung</value>
