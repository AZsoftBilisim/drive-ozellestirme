  <attributes uuid="7acd15ff-ddea-4c99-833f-4876af106860">
    <name>SpecialPriceType</name>
    <synonym>
      <key>en</key>
      <value>Special price type</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>نوع قیمت ویژه</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Tipo di prezzo individuale</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Indywidualny rodzaj ceny</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Индивидуальный вид цены</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Özelleştirilmiş fiyat türü</value>
    </synonym>
    <synonym>
