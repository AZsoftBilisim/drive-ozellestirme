				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>(nie używany) Obiekt rozliczeń</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>(не используется) Объект расчетов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>(kullanılmayan) Alacak/Borç nesnesi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>(không sử dụng) Đối tượng hạch toán</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED TOP 1
	Partners.BusinessRegion,
	Partners.DescriptionFull AS PublicName,
	Partners.AdditionalInformation,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.SumBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.SumBalance, 0)
		ELSE 0
	END AS PartnerDebt_,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.SumBalance, 0) &lt; 0
			THEN -ISNULL(CustomersARAPAccounting.SumBalance, 0)
		ELSE 0
	END AS AccountsPayableOfCompany,
	Counterparties.TIN,
	Counterparties.CRTR,
	Counterparties.NCBOCode,
	Counterparties.LegalEntityIndividual,
	Counterparties.CompanyIndividual
FROM
	Catalog.Partners AS Partners
		{LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(, AccountingDimensionByPartners.Partner = &amp;Partner) AS CustomersARAPAccounting
		ON Partners.Ref = CustomersARAPAccounting.AccountingDimensionByPartners.Partner}
		LEFT JOIN Catalog.Counterparties AS Counterparties
		ON Counterparties.Partner = Partners.Ref
WHERE
	Partners.Ref = &amp;Partners</query>
	</dataSet>
