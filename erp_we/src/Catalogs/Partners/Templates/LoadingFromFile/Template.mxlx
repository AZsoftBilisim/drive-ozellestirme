			<c>
				<c>
					<f>32</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Legal entity/Person</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>شخص حقوقی/شخص حقیقی</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Persona giuridica/persona fisica</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Osoba prawna / fizyczna</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Юр/Физлицо</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Tüzel/Gerçek kişi</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Pháp nhân/Cá nhân</v8:content>
						</v8:item>
					</tl>
					<d xsi:type="xs:string">Counterparties</d>
					<note>
						<drawingType>Comment</drawingType>
						<id>0</id>
						<formatIndex>33</formatIndex>
						<text>
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Counterparty may be a legal entity or a person, resident or non-resident.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>طرف حساب می‌تواند شخص حقوقی یا حقیقی، مقیم یا غیرمقیم باشد.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>La controparte può essere una persona giuridica o fisica, residente o non residente.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Kontrahentem może być osoba prawna lub fizyczna, rezydent lub nierezydent.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Контрагент может быть юридическим или физическим лицом, резидентом или нерезидентом.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Cari hesap, bir tüzel veya gerçek kişi, yerleşik veya yerleşik olmayan bir kişi olabilir.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Đối tác có thể là pháp nhân hoặc cá nhân, người thường trú hoặc tạm trú.</v8:content>
							</v8:item>
						</text>
