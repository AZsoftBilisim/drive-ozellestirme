		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Partners.Description AS PartnerName_,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	TermsOfSale.Description,
	TermsOfSale.Number,
	TermsOfSale.Date,
	TermsOfSale.Organization,
	TermsOfSale.Currency,
	TermsOfSale.PaymentSchedule,
	TermsOfSale.DocumentAmount,
	TermsOfSale.DeliveryPeriodDays,
	TermsOfSale.Warehouse,
	TermsOfSale.PricesKind,
	TermsOfSale.ValidityStartDate,
	TermsOfSale.ValidityEndDate,
	TermsOfSale.Frequent,
	TermsOfSale.Period,
	TermsOfSale.NumberOfPeriods,
	TermsOfSale.Manager,
	TermsOfSale.CommissionFeeCalculationMethod,
	TermsOfSale.RemunerationPercentage,
	TermsOfSale.KeepCommissionFee,
	TermsOfSale.PercentRateOfManualDiscount,
	TermsOfSale.MaximumPercentageForManualMarkup,
	TermsOfSale.PaymentMethod
FROM
	Catalog.TermsOfSale AS TermsOfSale
		{LEFT JOIN Catalog.Partners AS Partners
		ON TermsOfSale.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON TermsOfSale.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	TermsOfSale.Ref = &amp;TermsOfSale</query>
	</dataSet>
