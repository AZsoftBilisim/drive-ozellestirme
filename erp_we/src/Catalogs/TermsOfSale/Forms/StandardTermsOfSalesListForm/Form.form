  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.ToUseTermsOfSales</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogTermsOfSale.Ref                 AS Ref,
	CatalogTermsOfSale.DeletionMark        AS DeletionMark,
	CatalogTermsOfSale.Number                  AS Number,
	CatalogTermsOfSale.Date                   AS Date,
	CatalogTermsOfSale.Frequent             AS Frequent,
	CatalogTermsOfSale.PartnersSegment       AS PartnersSegment,
	CatalogTermsOfSale.Counterparty             AS Counterparty,
	CatalogTermsOfSale.Partner                AS Partner,
	CatalogTermsOfSale.Organization            AS Organization,
	CatalogTermsOfSale.Currency                 AS Currency,
	CatalogTermsOfSale.PaymentSchedule           AS PaymentSchedule,
	CatalogTermsOfSale.DocumentAmount         AS DocumentAmount,
	CatalogTermsOfSale.Standard_                AS Standard_,
	CatalogTermsOfSale.PricesKind                 AS PricesKind,
	CatalogTermsOfSale.Warehouse                  AS Warehouse,
	CatalogTermsOfSale.ProductSegment    AS ProductSegment,
	CatalogTermsOfSale.Status                 AS Status,
	CatalogTermsOfSale.ValidityStartDate     AS ValidityStartDate,
	CatalogTermsOfSale.ValidityEndDate  AS ValidityEndDate,
	CatalogTermsOfSale.Manager               AS Manager,
	CatalogTermsOfSale.BusinessOperation AS BusinessOperation,
	CatalogTermsOfSale.Description           AS Description,
	CatalogTermsOfSale.Comment            AS Comment,
	CASE
		WHEN
			CatalogTermsOfSale.DeletionMark
		THEN
			VALUE(Enum.StatesOfTermsOfSales.EmptyRef)
		// closed ////////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Closed)
		THEN
			VALUE(Enum.StatesOfTermsOfSales.Closed)
		// IT WORKS //////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
		THEN
			VALUE(Enum.StatesOfTermsOfSales.Valid)
		// APPROVAL IS EXPECTED /////////////////////////////////////////////////
		WHEN
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
		THEN
			VALUE(Enum.StatesOfTermsOfSales.PendingApproval)
	END AS State,
	CASE
		WHEN
			CatalogTermsOfSale.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate &lt; &amp;UpdateDate)
			OR (CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE 
			FALSE
	END AS ApprovalOverdue,
	CASE
		WHEN
			CatalogTermsOfSale.DeletionMark
		THEN
			FALSE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS ValidityPeriodExpired,
	CASE
		WHEN
			CatalogTermsOfSale.DeletionMark
		THEN
			FALSE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS TheValidityPeriodHasNotCome,
	CASE
		WHEN
			CatalogTermsOfSale.DeletionMark
		THEN
			DATETIME(1,1,1)
		// APPROVAL IS OVERDUE OR EXPIRED//////////////////////////
		WHEN (CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
			OR CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid))
			AND CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogTermsOfSale.ValidityEndDate
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
			AND CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogTermsOfSale.ValidityStartDate
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate > &amp;UpdateDate))
		THEN
			CatalogTermsOfSale.ValidityStartDate
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	CASE
		WHEN
			CatalogTermsOfSale.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate &lt; &amp;UpdateDate)
			OR (CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS Overdue
FROM
	Catalog.TermsOfSale AS CatalogTermsOfSale
WHERE
	CatalogTermsOfSale.Standard_</queryText>
      <mainTable>Catalog.TermsOfSale</mainTable>
