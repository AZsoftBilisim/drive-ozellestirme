    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogTermsOfSale.Ref                 AS Ref,
	CatalogTermsOfSale.DeletionMark        AS DeletionMark,
	CatalogTermsOfSale.Number                  AS Number,
	CatalogTermsOfSale.Date                   AS Date,
	CatalogTermsOfSale.Currency                 AS Currency,
	CatalogTermsOfSale.PaymentSchedule           AS PaymentSchedule,
	CatalogTermsOfSale.DocumentAmount         AS DocumentAmount,
	CatalogTermsOfSale.Standard_                AS Standard_,
	CatalogTermsOfSale.PricesKind                 AS PricesKind,
	CatalogTermsOfSale.Status                 AS Status,
	CatalogTermsOfSale.Frequent             AS Frequent,
	CatalogTermsOfSale.ProductSegment    AS ProductSegment,
	CatalogTermsOfSale.ValidityStartDate     AS ValidityStartDate,
	CatalogTermsOfSale.ValidityEndDate  AS ValidityEndDate,
	CatalogTermsOfSale.Manager               AS Manager,
	CatalogTermsOfSale.Description           AS Description,
	CatalogTermsOfSale.Comment            AS Comment,
	CatalogTermsOfSale.BusinessOperation  AS BusinessOperation,
	CatalogTermsOfSale.Organization            AS Organization,
	CatalogTermsOfSale.Counterparty             AS Counterparty,
	CAST(&amp;Partner AS Catalog.Partners)            AS PartnerSelection_,
	CASE
		WHEN
			CatalogTermsOfSale.Standard_
		THEN
			&amp;Standard_
		ELSE
			&amp;Individual_3
	END AS AgreementType,
	CASE
		// NOT AGREED ///////////////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
		THEN
			&amp;NotApproved
		// IT WORKS ///////////////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
		THEN
			&amp;Valid
		// CLOSED ///////////////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Closed)
		THEN
			&amp;Closed
	END AS State,
	CASE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate &lt; &amp;DocumentDate)
			OR (CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityEndDate &lt; &amp;DocumentDate))
		THEN
			TRUE
		ELSE 
			FALSE
	END AS ApprovalOverdue,
	CASE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityEndDate &lt; &amp;DocumentDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS ValidityPeriodExpired,
	CASE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			AND ((CatalogTermsOfSale.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfSale.ValidityStartDate > &amp;DocumentDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS TheValidityPeriodHasNotCome,
	CASE
		WHEN CatalogTermsOfSale.Standard_ AND
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
		THEN
			0
		WHEN NOT CatalogTermsOfSale.Standard_ AND
			CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
		THEN
			3
	END AS PictureStateValue,
	CatalogTermsOfSale.AvailableToExternalUsers,
	CatalogTermsOfSale.PartnersSegment,
	CatalogTermsOfSale.ContractsAreUsed AS ContractsAreUsed
FROM
	Catalog.TermsOfSale AS CatalogTermsOfSale
WHERE
	(&amp;AllowSelectionOfInvalid OR CatalogTermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)) AND
	NOT CatalogTermsOfSale.DeletionMark AND
	CASE
		WHEN &amp;OnlyStandard = TRUE AND &amp;OnlyPersonal = FALSE
		AND (CatalogTermsOfSale.Standard_
		AND (CatalogTermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		OR CatalogTermsOfSale.PartnersSegment IN
			(SELECT
				SegmentPartners.Segment
			FROM
				InformationRegister.SegmentPartners AS SegmentPartners
			WHERE
				SegmentPartners.Partner = &amp;Partner)))
		THEN
			TRUE
		
		WHEN &amp;OnlyPersonal = TRUE AND NOT &amp;OnlyStandard = TRUE
		AND (NOT CatalogTermsOfSale.Standard_
		AND (CatalogTermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		OR CatalogTermsOfSale.PartnersSegment IN
			(SELECT
				SegmentPartners.Segment
			FROM
				InformationRegister.SegmentPartners AS SegmentPartners
			WHERE
				SegmentPartners.Partner = &amp;Partner)))
		AND
		(&amp;Partner = VALUE(Catalog.Partners.EmptyRef) OR CatalogTermsOfSale.Partner = &amp;Partner)
		THEN
			TRUE

		WHEN &amp;OnlyStandard = FALSE AND &amp;OnlyPersonal = FALSE
		AND (CatalogTermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		OR CatalogTermsOfSale.PartnersSegment IN
			(SELECT
				SegmentPartners.Segment
			FROM
				InformationRegister.SegmentPartners AS SegmentPartners
			WHERE
				SegmentPartners.Partner = &amp;Partner)
		OR &amp;Partner = VALUE(Catalog.Partners.EmptyRef))
		AND
		(&amp;Partner = VALUE(Catalog.Partners.EmptyRef) OR CatalogTermsOfSale.Partner = VALUE(Catalog.Partners.EmptyRef) OR CatalogTermsOfSale.Partner = &amp;Partner)
		THEN
			TRUE
		ELSE
			FALSE
	END
	AND
	CASE
		WHEN &amp;OnlyUsedBySalesRepresentative = TRUE AND
			CatalogTermsOfSale.UsedInSalesRepresentativesWork
		THEN
			TRUE
		WHEN
			&amp;OnlyUsedBySalesRepresentative = FALSE
		THEN
			TRUE
		ELSE
			FALSE
	END</queryText>
      <mainTable>Catalog.TermsOfSale</mainTable>
