    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	MAX(EmploymentRecordSliceLast.Period) AS Period,
	EmploymentRecordSliceLast.Employee AS Employee,
	EmployeesHR.Individual AS Individual
INTO PersonnelData_Grouped
FROM
	InformationRegister.EmploymentRecord.SliceLast(&amp;Period, Organization = &amp;Organization) AS EmploymentRecordSliceLast
		INNER JOIN Catalog.EmployeesHR AS EmployeesHR
		ON EmploymentRecordSliceLast.Employee = EmployeesHR.Ref

GROUP BY
	EmploymentRecordSliceLast.Employee,
	EmployeesHR.Individual
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Persons.Ref AS Ref,
	Persons.DeletionMark AS DeletionMark,
	Persons.Parent AS Parent,
	Persons.IsFolder AS IsFolder,
	Persons.Code AS Code,
	Persons.Description AS Description,
	Persons.BirthDate AS BirthDate,
	Persons.NameClarification AS NameClarification,
	Persons.TIN AS TIN,
	EmploymentRecordSliceLast.Employee.Code AS EmployeeCode,
	EmploymentRecordSliceLast.Organization AS Organization,
	EmploymentRecordSliceLast.Department AS Department,
	EmploymentRecordSliceLast.JobTitle AS JobTitle,
	EmploymentRecordSliceLast.WorksInBusinessUnit AS ItWorks,
	EmploymentRecordSliceLast.Employee.InArchive AS InArchive
FROM
	Catalog.Persons AS Persons
		INNER JOIN PersonnelData_Grouped AS CurrentData_Grouped
			INNER JOIN InformationRegister.EmploymentRecord.SliceLast(&amp;Period, Organization = &amp;Organization) AS EmploymentRecordSliceLast
			ON CurrentData_Grouped.Employee = EmploymentRecordSliceLast.Employee
				AND CurrentData_Grouped.Period = EmploymentRecordSliceLast.Period
		ON Persons.Ref = CurrentData_Grouped.Individual
WHERE
	NOT Persons.DeletionMark</queryText>
