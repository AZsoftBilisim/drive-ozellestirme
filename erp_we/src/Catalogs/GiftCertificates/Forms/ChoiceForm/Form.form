  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.GiftCardAccounting25</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogGiftCertificates.Ref AS Ref,
	CatalogGiftCertificates.DataVersion AS DataVersion,
	CatalogGiftCertificates.DeletionMark AS DeletionMark,
	CatalogGiftCertificates.Predefined AS Predefined,
	CatalogGiftCertificates.Owner AS Owner,
	CatalogGiftCertificates.Code AS Code,
	CatalogGiftCertificates.Description AS Description,
	CatalogGiftCertificates.Barcode AS Barcode,
	CatalogGiftCertificates.MagneticCode AS MagneticCode,
	ISNULL(GiftCardHistorySliceLast.Status, VALUE(Enum.GiftCertificateStatuses.NotActivated)) AS StatusFromHistoryOfGiftCertificates,
	ISNULL(ActivatingGiftCertificates.Active, FALSE) AS ActivationStatus,
	CASE WHEN NOT GiftCertificateKinds.GiftCardAccounting25 THEN ISNULL(GiftCertificatesBalance.SumBalance, 0) 
	ELSE 
		CASE
			WHEN ISNULL(CustomersARAPAccountingBalance.SumBalance, 0) &lt; 0
				THEN -ISNULL(CustomersARAPAccountingBalance.SumBalance, 0)
			ELSE ISNULL(CustomersARAPAccountingBalance.SumBalance, 0)
		END
	END AS Balance,
	ISNULL(ActivatingGiftCertificates.Organization, CASE
			WHEN GiftCertificateKinds.GiftCardAccounting25
				THEN GiftCertificateKinds.Organization
			ELSE VALUE(Catalog.Companies.EmptyRef)
		END) AS Organization,
	GiftCertificateKinds.Currency AS Currency,
	GiftCertificateKinds.GiftCardAccounting25 AS GiftCardAccounting25
FROM
	Catalog.GiftCertificateKinds AS GiftCertificateKinds
		INNER JOIN Catalog.GiftCertificates AS CatalogGiftCertificates
		ON (CatalogGiftCertificates.Owner = GiftCertificateKinds.Ref)
		LEFT JOIN InformationRegister.ActivatingGiftCertificates AS ActivatingGiftCertificates
		ON (ActivatingGiftCertificates.GiftCertificate = CatalogGiftCertificates.Ref)
		LEFT JOIN InformationRegister.GiftCardHistory.SliceLast AS GiftCardHistorySliceLast
		ON (GiftCardHistorySliceLast.GiftCertificate = CatalogGiftCertificates.Ref)
		LEFT JOIN AccumulationRegister.GiftCertificates.Balance(, ) AS GiftCertificatesBalance
		ON (GiftCertificatesBalance.GiftCertificate = CatalogGiftCertificates.Ref)
		LEFT JOIN Catalog.ARAPObjects AS ARAPObjects
		ON (ARAPObjects.Object = CatalogGiftCertificates.Ref)
			AND NOT ARAPObjects.DeletionMark
		LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(, ) AS CustomersARAPAccountingBalance
		ON (ARAPObjects.Ref = CustomersARAPAccountingBalance.ARAPObject)		
{WHERE
	CatalogGiftCertificates.Owner AS Owner,
	GiftCertificateKinds.GiftCardAccounting25 AS GiftCardAccounting25,
	GiftCertificateKinds.Currency AS Currency,
	(ISNULL(GiftCardHistorySliceLast.Status, VALUE(Enum.GiftCertificateStatuses.NotActivated))) AS StatusFromHistoryOfGiftCertificates,
	ISNULL(ActivatingGiftCertificates.Active, FALSE) AS ActivationStatus,
	CatalogGiftCertificates.Barcode AS Barcode,
	CatalogGiftCertificates.MagneticCode AS MagneticCode,
	CASE WHEN NOT GiftCertificateKinds.GiftCardAccounting25 
		THEN ISNULL(GiftCertificatesBalance.SumBalance, 0) 
	ELSE 
		CASE
			WHEN ISNULL(CustomersARAPAccountingBalance.SumBalance, 0) &lt; 0
				THEN -ISNULL(CustomersARAPAccountingBalance.SumBalance, 0)
			ELSE ISNULL(CustomersARAPAccountingBalance.SumBalance, 0)
		END
	END AS Balance,
	ISNULL(ActivatingGiftCertificates.Organization, CASE
		WHEN GiftCertificateKinds.GiftCardAccounting25
			THEN GiftCertificateKinds.Organization
		ELSE VALUE(Catalog.Companies.EmptyRef)
	END)}</queryText>
