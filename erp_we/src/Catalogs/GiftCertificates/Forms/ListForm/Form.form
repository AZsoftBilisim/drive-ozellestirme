    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ValidityEndDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ValidityStartDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.СтатусИзИсторииПодарочныхСертификатов</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogGiftCertificates.Ref,
	CatalogGiftCertificates.DataVersion,
	CatalogGiftCertificates.DeletionMark,
	CatalogGiftCertificates.Predefined,
	CatalogGiftCertificates.Owner,
	CatalogGiftCertificates.Code,
	CatalogGiftCertificates.Description,
	CatalogGiftCertificates.Barcode,
	CatalogGiftCertificates.MagneticCode,
	ISNULL(ActivatingGiftCertificates.Active, FALSE) AS ActivationStatus,
	VALUE(Enum.GiftCertificateStatuses.EmptyRef) AS Status,
	0 AS Balance,
	CatalogGiftCertificates.Owner.Currency AS Currency,
	CatalogGiftCertificates.Owner.GiftCardAccounting25 AS GiftCardAccounting25,
	ISNULL(ActivatingGiftCertificates.Organization, CASE
			WHEN CatalogGiftCertificates.Owner.GiftCardAccounting25
				THEN CatalogGiftCertificates.Owner.Organization
			ELSE VALUE(Catalog.Companies.EmptyRef)
		END) AS Organization,
	ISNULL(ActivatingGiftCertificates.ValidityStartDate, DATETIME(1,1,1)) AS ValidityStartDate,
	ISNULL(ActivatingGiftCertificates.ValidityEndDate, DATETIME(1,1,1)) AS ValidityEndDate		
FROM
	Catalog.GiftCertificates AS CatalogGiftCertificates
	LEFT JOIN InformationRegister.ActivatingGiftCertificates AS ActivatingGiftCertificates
	ON (ActivatingGiftCertificates.GiftCertificate = CatalogGiftCertificates.Ref)</queryText>
      <mainTable>Catalog.GiftCertificates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
