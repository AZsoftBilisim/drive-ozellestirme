    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       LoanAndDepositContracts.Ref AS Ref, 
       LoanAndDepositContracts.DeletionMark AS DeletionMark, 
       LoanAndDepositContracts.Description AS Description, 
       LoanAndDepositContracts.ARAPCurrency AS ARAPCurrency, 
       LoanAndDepositContracts.Date AS Date, 
       ISNULL(ScheduleOption.DateOfFirstTranche, LoanAndDepositContracts.DateOfFirstTranche) AS DateOfFirstTranche, 
       ISNULL(ScheduleOption.LastPayment, LoanAndDepositContracts.LastPayment) AS LastPayment, 
       LoanAndDepositContracts.Comment AS Comment, 
       LoanAndDepositContracts.Counterparty AS Counterparty, 
       LoanAndDepositContracts.Number AS Number, 
       LoanAndDepositContracts.Organization AS Organization, 
       LoanAndDepositContracts.EmployeeResponsible AS EmployeeResponsible, 
       ISNULL(ScheduleOption.TermMonths, LoanAndDepositContracts.TermMonths) AS TermMonths, 
       LoanAndDepositContracts.Status AS Status, 
       LoanAndDepositContracts.ContractType AS ContractType, 
       LoanAndDepositContracts.PriorityType AS PriorityType, 
       LoanAndDepositContracts.ContractKind AS ContractKind
 FROM 
       Catalog.LoanAndDepositContracts
 AS 
       LoanAndDepositContracts
       LEFT JOIN Catalog.OptionsOfLoansAndDepositsSchedules AS ScheduleOption
		ON LoanAndDepositContracts.Ref = ScheduleOption.Owner
		AND NOT ScheduleOption.DeletionMark
		AND ScheduleOption.Used</queryText>
      <mainTable>Catalog.LoanAndDepositContracts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
