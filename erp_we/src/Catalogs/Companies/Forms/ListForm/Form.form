  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       Companies.Ref, 
       Companies.DeletionMark, 
       Companies.Description, 
       Companies.KindOfExchangeWithRegulatoryAuthorities, 
       Companies.MilitaryRegistrationAndEnlistmentOffice, 
       Companies.ParentCompany, 
       Companies.WorkScheduleCalendar, 
       Companies.CRTR, 
       Companies.TaxAuthorityCode, 
       Companies.SSFAdditionalCode, 
       Companies.CompanyHasBranchOffices, 
       Companies.TIN, 
       Companies.IndividualEntrepreneur, 
       Companies.ForeignCompanyOffice, 
       Companies.SubordinationCode, 
       Companies.IERegistrationNumberSFR, 
       Companies.RegistrationNumberInPensionFund, 
       Companies.RegistrationNumberInTCMIFPrivateEntrepreneur, 
       Companies.SSFRegistrationNumberPrivateEntrepreneur, 
       Companies.CodeInCountryOfResidence, 
       Companies.IDDescriptionInCountryOfResidence, 
       Companies.IFTSCodeOfReportingRecipient, 
       Companies.PensionFundAuthorityCode, 
       Companies.FSSSBodyCode, 
       Companies.RNCEB, 
       Companies.RegistrationDate, 
       Companies.RNCPSCode, 
       Companies.FTSSubordinationCode, 
       Companies.CompanyIsMajorTaxpayer, 
       Companies.NCBOCode, 
       Companies.DescriptionFull, 
       Companies.PensionFundLocalAuthorityName, 
       Companies.SSFLocalAuthorityName, 
       Companies.FullNameOfForeignCompany, 
       Companies.FullNameOfTaxAuthority, 
       Companies.ReportDataDirectoryForExchangeWithIFTS, 
       Companies.EmailApplicationDirectoryForExchangeWithIFTS, 
       Companies.ExchangeSubscriberCode, 
       Companies.AbbreviatedDescription, 
       Companies.OGRN, 
       Companies.RegisteringAuthorityDescription, 
       Companies.BranchOffice, 
       Companies.AllowanceByRegionalFactorIsAccruedInCompanyOrItsBusinessUnits, 
       Companies.NorthernAllowanceIsAccruedInCompanyOrItsBusinessUnits, 
       Companies.RegionalFactor, 
       Companies.Prefix, 
       Companies.SSFRegistrationNumber, 
       Companies.RegistrationWithTaxAuthority, 
       Companies.RegistrationNumberInSocialInsuranceFund, 
       Companies.PensionFundRegistrationNumber, 
       Companies.SertificateDateOfIssue, 
       Companies.DataInterchangeUserAccount, 
       Companies.BusinessActivityClassifierCode, 
       Companies.ActivityType, 
       Companies.RNCFI, 
       Companies.RegistrationNumberInTCMIF, 
       Companies.LegalForm, 
       Companies.OKFS, 
       Companies.RegionalFactorFederal, 
       Companies.SeriesAndNumber, 
       Companies.CountryOfPermanentLocation, 
       Companies.RegistrationCountryOfForeignCompany, 
       Companies.WorkScheduleOfEmployees, 
       Companies.OwnershipForm, 
       Companies.NumericCodeForTaxInvoices, 
       Companies.PercentRateOfNorthernAllowance, 
       Companies.LegalEntityIndividual, 
       Companies.BusinessActivityClassifierCode2, 
       Companies.Logo, 
       Companies.FacsimileStamp, 
       Companies.TransactionsUsingParentCompanyAreAllowed, 
       Companies.RegisteredInSpecialEconomicZone, 
       Companies.ActivityType2, 
       Companies.CompanyIndividual, 
       Companies.DescriptionInternational, 
       Companies.DoNotFillInBusinessUnitsInLaborActivityEvents, 
       Companies.LocalAccountingCurrency, 
       Companies.RegistrationCountry, 
       Companies.Status, 
       Companies.MajorTaxpayerKPP, 
       Companies.FullNameOfMajorTaxpayerTaxAuthority, 
       Companies.TaxAuthorityMajorTaxpayer, 
       Companies.PBPCode, 
       Companies.NSPKOrganizationKey, 
       Companies.DeleteNSPKCompanyKeyIsProcessed, 
       Companies.ContactInformation.*, 
       Companies.AdditionalAttributes.*, 
       Companies.NameHistory.*, 
       Companies.Predefined, 
       Companies.PredefinedDataName, 
       Companies.DescriptionLanguage1, 
       Companies.DescriptionLanguage2
 FROM 
       Catalog.Companies
 AS 
       Companies</queryText>
      <mainTable>Catalog.Companies</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
