              <value>Bằng số tiền hợp đồng</value>
            </presentation>
            <presentation>
              <key>pl</key>
              <value>Equal to contract amount</value>
            </presentation>
            <value xsi:type="core:ReferenceValue">
              <value>Enum.MethodsOfDeterminingLeasedAssetCost.EnumValue.ByContractAmount</value>
            </value>
          </choiceList>
