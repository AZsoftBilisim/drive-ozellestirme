            <choiceList>
              <value xsi:type="core:ReferenceValue">
                <value>Enum.OptionsOfPostingInNonCurrentAssetsAccounting.EnumValue.InLocalAccounting</value>
              </value>
            </choiceList>
          </extInfo>
