    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogLeaseContract.Ref,
	CatalogLeaseContract.DeletionMark,
	CatalogLeaseContract.Description,
	CatalogLeaseContract.BankAccount,
	CatalogLeaseContract.CounterpartyBankAccount,
	CatalogLeaseContract.ARAPCurrency,
	CatalogLeaseContract.Comment,
	CatalogLeaseContract.Organization,
	CatalogLeaseContract.Counterparty,
	CatalogLeaseContract.EmployeeResponsible,
	CatalogLeaseContract.Date,
	CatalogLeaseContract.Number,
	CatalogLeaseContract.Department,
	CatalogLeaseContract.LineOfBusiness,
	CatalogLeaseContract.ForeignCurrencyTransaction,
	CatalogLeaseContract.CashFlowItem,
	CatalogLeaseContract.AssetHolder,
	CatalogLeaseContract.ValidityStartDate,
	CatalogLeaseContract.ValidityEndDate,
	CatalogLeaseContract.Partner,
	CatalogLeaseContract.ContactPerson,
	CatalogLeaseContract.HasSecurityDeposit,
	CatalogLeaseContract.ThereIsBuyoutOfLeasedAssets,
	CatalogLeaseContract.Status,
	CatalogLeaseContract.Approved,
	CatalogLeaseContract.AdditionalAttributes,
	CatalogLeaseContract.Predefined,
	CatalogLeaseContract.PredefinedDataName,
	&amp;DefaultPartner AS DefaultPartner,
	CatalogLeaseContract.CashFlowItem,
	ISNULL(TermsOfLeaseContracts.State, UNDEFINED) AS State
FROM
	Catalog.LeaseContract AS CatalogLeaseContract
		{LEFT JOIN InformationRegister.TermsOfLeaseContracts.SliceLast({(&amp;Date)},
			{(Recorder &lt;> &amp;Recorder)}) AS TermsOfLeaseContracts
		ON TermsOfLeaseContracts.Contract = CatalogLeaseContract.Ref}</queryText>
      <mainTable>Catalog.LeaseContract</mainTable>
