  <excludedCommands>Retry</excludedCommands>
  <excludedCommands>SaveValues</excludedCommands>
  <excludedCommands>SetDeletionMark</excludedCommands>
  <excludedCommands>Yes</excludedCommands>
  <autoSaveDataInSettings>Use</autoSaveDataInSettings>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ContractType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThereIsBuyoutOfLeasedAssets</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	LeaseContract.Ref,
	LeaseContract.DataVersion,
	LeaseContract.DeletionMark,
	LeaseContract.Predefined,
	LeaseContract.Description,
	LeaseContract.Number,
	LeaseContract.Date,
	LeaseContract.Counterparty,
	LeaseContract.Partner,
	LeaseContract.Organization,
	LeaseContract.ARAPCurrency,
	LeaseContract.ForeignCurrencyTransaction,
	LeaseContract.ValidityStartDate,
	LeaseContract.ValidityEndDate,
	LeaseContract.EmployeeResponsible,
	LeaseContract.Comment,
	LeaseContract.BankAccount,
	LeaseContract.CounterpartyBankAccount,
	LeaseContract.ThereIsBuyoutOfLeasedAssets,
	LeaseContract.ContractType,
	&amp;DefaultPartner AS DefaultPartner,
	CASE
		WHEN
			LeaseContract.DeletionMark
		THEN
			VALUE(Enum.CounterpartyContractStates.EmptyRef)
		// unopened //////////////////////////////////////////////////////////////////
		WHEN
			LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Closed)
		THEN
			VALUE(Enum.CounterpartyContractStates.Closed)
		// IT WORKS ///////////////////////////////////////////////////////////////
		WHEN
			LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		THEN
			VALUE(Enum.CounterpartyContractStates.Valid)
		// APPROVAL IS EXPECTED //////////////////////////////////////////////////
		WHEN
			LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
		THEN
			VALUE(Enum.CounterpartyContractStates.PendingApproval)
	END AS State,
	CASE
		WHEN
			LeaseContract.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
			AND ((LeaseContract.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityStartDate &lt; &amp;UpdateDate)
			OR (LeaseContract.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE 
			FALSE
	END AS ApprovalOverdue,
	CASE
		WHEN
			LeaseContract.DeletionMark
		THEN
			FALSE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			AND ((LeaseContract.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS ValidityPeriodExpired,
	CASE
		WHEN
			LeaseContract.DeletionMark
		THEN
			FALSE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			AND ((LeaseContract.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS TheValidityPeriodHasNotCome,
	CASE
		WHEN
			LeaseContract.DeletionMark
		THEN
			DATETIME(1,1,1)
		// APPROVAL IS OVERDUE OR EXPIRED//////////////////////////
		WHEN (LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
			OR LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid))
			AND LeaseContract.ValidityEndDate &lt;> DATETIME(1,1,1)
		THEN
			LeaseContract.ValidityEndDate
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
			AND LeaseContract.ValidityStartDate &lt;> DATETIME(1,1,1)
		THEN
			LeaseContract.ValidityStartDate
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			AND ((LeaseContract.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityStartDate > &amp;UpdateDate))
		THEN
			LeaseContract.ValidityStartDate
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	CASE
		WHEN
			LeaseContract.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
			AND ((LeaseContract.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityStartDate &lt; &amp;UpdateDate)
			OR (LeaseContract.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			AND ((LeaseContract.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN LeaseContract.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			AND ((LeaseContract.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			LeaseContract.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS Overdue,
	LeaseContract.LineOfBusiness,
	LeaseContract.CashFlowItem
FROM
	Catalog.LeaseContract AS LeaseContract</queryText>
