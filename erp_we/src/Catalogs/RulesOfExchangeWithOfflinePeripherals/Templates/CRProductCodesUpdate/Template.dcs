		<field xsi:type="DataSetFieldField">
			<dataPath>PricingVariant</dataPath>
			<field>PricingVariant</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Variant pricing</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قیمت‌گذاری گونه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Caratteristica OS</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Charakterystyka TC</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Характеристика ЦО</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Fİ varyantı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đặc tính thiết lập giá</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Products.Ref AS Products,
	Products.ProductKind AS ProductKind,
	Products.PackagingGroup AS PackagingGroup,
	Products.UsePackages AS UsePackages,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef) AS PricingVariant,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package
INTO ProductAndCharacteristics
FROM
	Catalog.Products AS Products
WHERE
	NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
{WHERE
	Products.Ref.* AS Products,
	((Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	Products.PackagingGroup,
	Products.UsePackages AS UsePackages,
	ItemsCharacteristics.Ref,
	ItemsCharacteristics.ItemsCharacteristicForPricing.Ref,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON (CASE
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN Products.Ref
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN Products.ProductKind
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN Products.ItemVariantsOwner
			END = ItemsCharacteristics.Owner)
WHERE
	&amp;UseItemVariants
	AND Products.UseVariants IN (VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems), VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind), VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
{WHERE
	Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	((Products.Ref, ItemsCharacteristics.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductAndCharacteristics.Products AS Products,
	ProductAndCharacteristics.Characteristic AS Characteristic,
	ProductAndCharacteristics.PricingVariant AS PricingVariant,
	ProductAndCharacteristics.Package AS Package
INTO RawData
FROM
	ProductAndCharacteristics AS ProductAndCharacteristics

UNION ALL

SELECT
	ProductAndCharacteristics.Products,
	ProductAndCharacteristics.Characteristic,
	ProductAndCharacteristics.PricingVariant,
	ProductPackages.Ref
FROM
	Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		INNER JOIN ProductAndCharacteristics AS ProductAndCharacteristics
		ON (ProductPackages.Owner = ProductAndCharacteristics.Products)
WHERE
	&amp;UseItemPackages
{WHERE
	ProductAndCharacteristics.Products.* AS Products,
	ProductAndCharacteristics.Characteristic.* AS Characteristic,
	ProductAndCharacteristics.PricingVariant.* AS PricingVariant,
	ProductPackages.Ref.* AS Package}
	
UNION ALL

SELECT
	ProductAndCharacteristics.Products,
	ProductAndCharacteristics.Characteristic,
	ProductAndCharacteristics.PricingVariant,
	ProductPackages.Ref
FROM
	Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		INNER JOIN ProductAndCharacteristics AS ProductAndCharacteristics
		ON (ProductPackages.Owner = ProductAndCharacteristics.PackagingGroup)
WHERE 
	&amp;UseItemPackages
	AND ProductAndCharacteristics.UsePackages
{WHERE
	ProductAndCharacteristics.Products.* AS Products,
	ProductAndCharacteristics.Characteristic.* AS Characteristic,
	ProductAndCharacteristics.PricingVariant.* AS PricingVariant,
	ProductPackages.Ref.* AS Package}

INDEX BY
	Products,
	Characteristic,
	PricingVariant,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	SourceDataLastRequest.Products AS Products,
	SourceDataLastRequest.Characteristic AS Characteristic,
	SourceDataLastRequest.PricingVariant AS PricingVariant,
	SourceDataLastRequest.Package AS Package,
	ISNULL(ItemsIDOfPeripheralsOffline.Code, 0) AS Code,
	ISNULL(ItemsIDOfPeripheralsOffline.Used, FALSE) AS Used
INTO DataTable
{SELECT
	Products.*,
	Characteristic.*,
	PricingVariant.*,
	Code,
	Used,
	Package.*}
FROM
	RawData AS SourceDataLastRequest
		{LEFT JOIN InformationRegister.ItemsBarcodes AS ItemsBarcodes
		ON SourceDataLastRequest.Products = ItemsBarcodes.Products
			AND SourceDataLastRequest.Characteristic = ItemsBarcodes.Characteristic
			AND SourceDataLastRequest.Package = ItemsBarcodes.Package}
		{LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&amp;Date, DAY), PriceKind = &amp;PriceKind {(Products).* AS Products, (PricingVariant).* AS PricingVariant, ((Products, PricingVariant) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        RawData.PricingVariant
				    FROM
				        SelectionByProductSegment
				            LEFT JOIN RawData AS RawData
				            ON
				                SelectionByProductSegment.Products = RawData.Products
				                    AND SelectionByProductSegment.Characteristic = RawData.Characteristic
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ItemPricesCrossSectionOfTheLatest
		ON SourceDataLastRequest.Products = ItemPricesCrossSectionOfTheLatest.Products
			AND SourceDataLastRequest.PricingVariant = ItemPricesCrossSectionOfTheLatest.PricingVariant
			AND (VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) = ItemPricesCrossSectionOfTheLatest.PricingBatch)
			AND (VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) = ItemPricesCrossSectionOfTheLatest.PricingPackage)}
		{LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&amp;Date, DAY), PriceKind = &amp;SpecialPriceType {(Products).* AS Products, (PricingVariant).* AS PricingVariant, ((Products, PricingVariant) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        RawData.PricingVariant
				    FROM
				        SelectionByProductSegment
				            LEFT JOIN RawData AS RawData
				            ON
				                SelectionByProductSegment.Products = RawData.Products
				                    AND SelectionByProductSegment.Characteristic = RawData.Characteristic
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS IndividualPricesOfCrossSectionProductRange
		ON SourceDataLastRequest.Products = IndividualPricesOfCrossSectionProductRange.Products
			AND SourceDataLastRequest.PricingVariant = IndividualPricesOfCrossSectionProductRange.PricingVariant
			AND (VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) = IndividualPricesOfCrossSectionProductRange.PricingBatch)
			AND (VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) = IndividualPricesOfCrossSectionProductRange.PricingPackage)}
		{LEFT JOIN AccumulationRegister.ProductStock.Balance(, {(Products).* AS Products, (Characteristic).* AS Characteristic, (Warehouse).* AS Warehouse, ((Products, Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ProductStockBalance
		ON SourceDataLastRequest.Products = ProductStockBalance.Products
			AND SourceDataLastRequest.Characteristic = ProductStockBalance.Characteristic}
		{LEFT JOIN InformationRegister.ItemsIDOfPeripheralsOffline AS ItemsIDOfPeripheralsOffline
		ON SourceDataLastRequest.Products = ItemsIDOfPeripheralsOffline.Products
			AND SourceDataLastRequest.Characteristic = ItemsIDOfPeripheralsOffline.Characteristic
			AND SourceDataLastRequest.Package = ItemsIDOfPeripheralsOffline.Package
			AND (ItemsIDOfPeripheralsOffline.ExchangeRule = &amp;ExchangeRule)}
{WHERE
	SourceDataLastRequest.Products.* AS Products,
	SourceDataLastRequest.Characteristic.* AS Characteristic,
	SourceDataLastRequest.PricingVariant.* AS PricingVariant,
	SourceDataLastRequest.Package.* AS Package,
	ItemsBarcodes.Barcode AS Barcode,
	(CASE
			WHEN IndividualPricesOfCrossSectionProductRange.Price IS NULL
					OR IndividualPricesOfCrossSectionProductRange.Price = 0
				THEN ItemPricesCrossSectionOfTheLatest.Price
			ELSE IndividualPricesOfCrossSectionProductRange.Price
		END)*&amp;TemplateForSubstitutingCalculatedCoefficient AS Price,
	ProductStockBalance.InStockBalance AS WarehouseStockBalance,
	(NOT &amp;ExcludeZeroStockBalances
			OR &amp;ExcludeZeroStockBalances
				AND ProductStockBalance.InStockBalance &gt; 0)}
				
INDEX BY
	Products,
	Characteristic,
	Package
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TRUE AS MatchesFilter,
	DataTable.Products AS Products,
	DataTable.Characteristic AS Characteristic,
	DataTable.PricingVariant AS PricingVariant,
	DataTable.Package AS Package,
	DataTable.Code AS Code,
	DataTable.Used AS Used,
	CASE
		WHEN DataTable.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN DataTable.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
						THEN TRUE
					ELSE FALSE
				END
		ELSE CASE
				WHEN DataTable.Package.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
					THEN TRUE
				ELSE FALSE
			END
	END AS SoldByWeight
{SELECT
	MatchesFilter,
	Code,
	SoldByWeight,
	Used,
	Products.*,
	Characteristic.*,
	PricingVariant.*,
	Package.*}
FROM
	DataTable AS DataTable
WHERE
	(DataTable.Code = 0
			OR NOT DataTable.Used)

UNION ALL

SELECT
	FALSE,
	ItemsIDOfPeripheralsOffline.Products,
	ItemsIDOfPeripheralsOffline.Characteristic,
	DataTable.PricingVariant,
	ItemsIDOfPeripheralsOffline.Package,
	ItemsIDOfPeripheralsOffline.Code,
	ItemsIDOfPeripheralsOffline.Used,
	CASE
		WHEN ItemsIDOfPeripheralsOffline.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN ItemsIDOfPeripheralsOffline.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
						THEN TRUE
					ELSE FALSE
				END
		ELSE CASE
				WHEN ItemsIDOfPeripheralsOffline.Package.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Weight)
					THEN TRUE
				ELSE FALSE
			END
	END
FROM
	InformationRegister.ItemsIDOfPeripheralsOffline AS ItemsIDOfPeripheralsOffline
		LEFT JOIN DataTable AS DataTable
		ON ItemsIDOfPeripheralsOffline.Products = DataTable.Products
			AND ItemsIDOfPeripheralsOffline.Characteristic = DataTable.Characteristic
			AND ItemsIDOfPeripheralsOffline.Package = DataTable.Package
WHERE
	NOT (ItemsIDOfPeripheralsOffline.Products, ItemsIDOfPeripheralsOffline.Characteristic, ItemsIDOfPeripheralsOffline.Package) IN
				(SELECT
					T.Products,
					T.Characteristic,
					T.Package
				FROM
					DataTable AS T)
	AND ItemsIDOfPeripheralsOffline.Products &lt;&gt; VALUE(Catalog.Products.EmptyRef)
	AND ItemsIDOfPeripheralsOffline.ExchangeRule = &amp;ExchangeRule
	AND ItemsIDOfPeripheralsOffline.Used

ORDER BY
	Code</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
