    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	QualityCertificates.Ref,
	QualityCertificates.Status,
	QualityCertificates.StartDateOfValidityPeriod,
	QualityCertificates.ValidTo,
	QualityCertificates.Permanent,
	QualityCertificates.CertificateType,
	QualityCertificates.StatusOfRAC,
	QualityCertificates.UpdateDateOfRACStatus,
	CAST(QualityCertificates.RefToRACCertificate AS STRING(1000)) AS RefToRACCertificate,
	QualityCertificates.IsFolder,
	QualityCertificates.Ref AS QualityCertificate
{WHERE
	(QualityCertificateApplicationAreas.ProductKind = &amp;ItemTypeOnly),
	(QualityCertificateApplicationAreas.Products = &amp;Products
	OR QualityCertificateApplicationAreas.ProductKind = &amp;ProductKind
	AND QualityCertificateApplicationAreas.Products = VALUE(Catalog.Products.EmptyRef)),
	CASE
		WHEN Permanent
			THEN DATETIME(3999, 1, 1)
		ELSE ValidTo
	END AS ValidTo}
FROM
	Catalog.QualityCertificates AS QualityCertificates
		FULL JOIN InformationRegister.QualityCertificateApplicationAreas AS
			QualityCertificateApplicationAreas
		ON QualityCertificates.Ref = QualityCertificateApplicationAreas.QualityCertificate</queryText>
      <mainTable>Catalog.QualityCertificates</mainTable>
