      <segments>QualityCertificates.RefToRACCertificate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.ValidTo</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	QualityCertificateApplicationAreas.Products,
	QualityCertificateApplicationAreas.Characteristic,
	QualityCertificateApplicationAreas.Series,
	QualityCertificates.Ref,
	QualityCertificates.StartDateOfValidityPeriod AS StartDateOfValidityPeriod,
	QualityCertificates.ValidTo AS ValidTo,
	QualityCertificates.Permanent AS Permanent,
	QualityCertificates.CertificateType AS CertificateType,
	QualityCertificates.StatusOfRAC,
	CAST(QualityCertificates.RefToRACCertificate AS STRING(1000)) AS
		RefToRACCertificate,
	QualityCertificates.Status,
	QualityCertificates.DeletionMark,
	CASE
		WHEN QualityCertificates.DeletionMark
			THEN 4
		ELSE 3
	END AS PictureIndex,
	QualityCertificateApplicationAreas.QualityCertificate
FROM
	InformationRegister.QualityCertificateApplicationAreas AS QualityCertificateApplicationAreas
		INNER JOIN Catalog.QualityCertificates AS QualityCertificates
		ON QualityCertificateApplicationAreas.QualityCertificate = QualityCertificates.Ref
WHERE
	(QualityCertificateApplicationAreas.Products = &amp;Products
	OR QualityCertificateApplicationAreas.ProductKind = &amp;ProductKind
	AND QualityCertificateApplicationAreas.Products = VALUE(Catalog.Products.EmptyRef))</queryText>
      <mainTable>InformationRegister.QualityCertificateApplicationAreas</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
