  <attributes>
    <name>QualityCertificates</name>
    <title>
      <key>en</key>
      <value>Quality certificates</value>
    </title>
    <title>
      <key>fa</key>
      <value>گواهی‌های کیفیت</value>
    </title>
    <title>
      <key>it</key>
      <value>Certificati di articoli</value>
    </title>
