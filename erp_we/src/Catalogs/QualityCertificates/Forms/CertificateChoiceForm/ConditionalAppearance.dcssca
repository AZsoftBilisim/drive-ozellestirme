				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>&lt;permanent&gt;</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>&lt;دائمی&gt;</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
