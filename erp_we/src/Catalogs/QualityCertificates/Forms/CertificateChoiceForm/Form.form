      <segments>QualityCertificates.CertificateType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.Permanent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.RefToRACCertificate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>QualityCertificates.ValidTo</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	QualityCertificates.Ref,
	QualityCertificates.Status,
	QualityCertificates.StartDateOfValidityPeriod,
	QualityCertificates.ValidTo,
	QualityCertificates.Permanent,
	QualityCertificates.CertificateType,
	QualityCertificates.StatusOfRAC,
	CAST(QualityCertificates.RefToRACCertificate AS STRING(1000)) AS
		RefToRACCertificate,
	QualityCertificates.IsFolder,
	QualityCertificates.Ref AS QualityCertificate
FROM
	Catalog.QualityCertificates AS QualityCertificates
		LEFT JOIN InformationRegister.QualityCertificateApplicationAreas AS QualityCertificateApplicationAreas
		ON QualityCertificates.Ref = QualityCertificateApplicationAreas.QualityCertificate
WHERE
	(((QualityCertificates.IsFolder = TRUE)
	AND &amp;Products = VALUE(Catalog.Products.EmptyRef))
	OR (QualityCertificateApplicationAreas.Products = &amp;Products
	OR (QualityCertificateApplicationAreas.ProductKind = &amp;ProductKind
	AND QualityCertificateApplicationAreas.Products = VALUE(Catalog.Products.EmptyRef))
	OR &amp;ProductKind = VALUE(Catalog.ItemKinds.EmptyRef)))</queryText>
      <mainTable>Catalog.QualityCertificates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
