    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterQualityCertificateApplicationAreas.ProductKind,
	InformationRegisterQualityCertificateApplicationAreas.Products,
	InformationRegisterQualityCertificateApplicationAreas.Characteristic,
	InformationRegisterQualityCertificateApplicationAreas.Series,
	InformationRegisterQualityCertificateApplicationAreas.QualityCertificate,
	CASE
		WHEN InformationRegisterQualityCertificateApplicationAreas.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN FALSE
		ELSE TRUE
	END AS UseCharacteristics,
	InformationRegisterQualityCertificateApplicationAreas.ProductKind.KeepAccountingByBatch AS KeepAccountingByBatch
FROM
	InformationRegister.QualityCertificateApplicationAreas AS InformationRegisterQualityCertificateApplicationAreas</queryText>
      <mainTable>InformationRegister.QualityCertificateApplicationAreas</mainTable>
