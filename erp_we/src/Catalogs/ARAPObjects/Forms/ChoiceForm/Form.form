      <segments>PaymentBasisList.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentBasisList.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentBasisList.PaymentPurpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentBasisList.Sum</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>// The text of the request is assigned in the module of the form attached to the server
SELECT DISTINCT
	DocumentsRegistry.Ref AS PaymentPurpose,
	DocumentsRegistry.RefType AS BasisType,
	VALUE(Document.SalesOrder.EmptyRef) AS DocumentBasis,
	DocumentsRegistry.Partner AS Partner,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Counterparty AS Counterparty,
	DocumentsRegistry.Contract AS Contract,
	DocumentsRegistry.LineOfBusiness AS LineOfBusiness,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.SourceDocumentDate AS IncomingDocumentDate,
	DocumentsRegistry.SourceDocumentNumber AS IncomingDocumentNumber,
	DocumentsRegistry.SourceDocumentName AS SourceDocumentName,
	DocumentsRegistry.Sum AS Sum,
	DocumentsRegistry.Currency AS Currency
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON DocumentsRegistry.Contract = CounterpartyContracts.Ref
WHERE
	(DocumentsRegistry.Organization IN (&amp;Organization)
			OR NOT &amp;ThisIsParentOrganization
				AND DocumentsRegistry.Contract IN (&amp;CentralizedContracts)
				AND (DocumentsRegistry.Organization = &amp;ParentCompany
					OR ISNULL(CounterpartyContracts.TransferAndOffsetOfPaymentsBetweenBranchOfficesIsAllowed, FALSE))
			OR &amp;ThisIsParentOrganization
				AND DocumentsRegistry.Organization.ParentCompany IN (&amp;Organization)
				AND DocumentsRegistry.Organization.TransactionsUsingParentCompanyAreAllowed
			OR &amp;ByAllCompanies)
	AND (DocumentsRegistry.Partner IN (&amp;Partner)
		OR &amp;ForAllPartners)
	AND (DocumentsRegistry.Counterparty IN (&amp;Counterparty)
		OR &amp;ForAllCounterparties)
	AND VALUETYPE(DocumentsRegistry.Ref) IN(&amp;TypesOfBases_)
</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
