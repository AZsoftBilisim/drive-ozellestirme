    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>// The text of the request is assigned in the module of the form attached to the server
SELECT
	CounterpartyContracts.Ref AS PaymentPurpose,
	CounterpartyContracts.Ref AS Contract,
	ISNULL(ARAPObjects.PaymentType_, VALUE(Enum.PartnersARAPAccountingTypes.EmptyRef)) AS PaymentType_,
	UNDEFINED AS DocumentBasis,
	CounterpartyContracts.Partner,
	CounterpartyContracts.Organization,
	CounterpartyContracts.Counterparty,
	CounterpartyContracts.LineOfBusiness,
	CounterpartyContracts.Number,
	CounterpartyContracts.Date,
	CounterpartyContracts.Sum,
	CounterpartyContracts.PaymentID
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts
		LEFT JOIN Catalog.ARAPObjects AS ARAPObjects
		ON CounterpartyContracts.Ref = ARAPObjects.Object
WHERE
	(CounterpartyContracts.Organization IN (&amp;Organization)
			OR NOT &amp;ThisIsParentOrganization
				AND CounterpartyContracts.Ref IN (&amp;CentralizedContracts)
				AND (CounterpartyContracts.Organization = &amp;ParentCompany
					OR CounterpartyContracts.TransferAndOffsetOfPaymentsBetweenBranchOfficesIsAllowed)
			OR &amp;ThisIsParentOrganization
				AND CounterpartyContracts.Organization.ParentCompany IN (&amp;Organization)
				AND CounterpartyContracts.Organization.TransactionsUsingParentCompanyAreAllowed
			OR &amp;ByAllCompanies)
	AND (CounterpartyContracts.Partner IN (&amp;Partner)
		OR &amp;ForAllPartners)
	AND (CounterpartyContracts.Counterparty IN (&amp;Counterparty)
		OR &amp;ForAllCounterparties)
</queryText>
      <mainTable>Catalog.CounterpartyContracts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
