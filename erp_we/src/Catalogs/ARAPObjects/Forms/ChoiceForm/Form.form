    </title>
    <title>
      <key>pl</key>
      <value>Lista obiektów rozliczeń</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список объектов расчетов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Hesaplama nesnelerinin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách các đối tượng giải quyết</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.ARAPCurrency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.ARAPObject</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.AmountDue</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.BeingPaid</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.CentralizedContract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Contract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Date</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.FeeViaEndCustomers</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.ItIsAllowedToWorkWithSubsidiaryPartners</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.LineOfBusiness</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Number</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Object</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.PaymentID</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.PaymentPurpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.PaymentType_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.State</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.Sum</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>APARObjectList.SumBalance</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>//The request text is redefined in the form module

SELECT 
       ARAPObjects.Ref AS ARAPObject, 
       ARAPObjects.Ref AS Ref,
       ARAPObjects.DeletionMark, 
       ARAPObjects.Description, 
       ARAPObjects.Object, 
       ARAPObjects.Object AS PaymentPurpose,
       ARAPObjects.PaymentType_,
       ARAPObjects.ARAPObjectType,
       ARAPObjects.RefType, 
       ARAPObjects.FinancialAccountingGroup, 
       ARAPObjects.Manager, 
       ARAPObjects.Department, 
       ARAPObjects.PaymentID, 
       ARAPObjects.Number, 
       ARAPObjects.Date, 
       ARAPObjects.IncomingDocumentNumber, 
       ARAPObjects.IncomingDocumentDate, 
       ARAPObjects.SourceDocumentName, 
       ARAPObjects.Sum, 
       ARAPObjects.Currency, 
       ARAPObjects.State,
       ARAPObjects.Partner,
       ARAPObjects.Organization, 
       ARAPObjects.Counterparty, 
       ARAPObjects.Contract,
       ISNULL(Contracts.ItIsAllowedToWorkWithSubsidiaryPartners, FALSE) AS ItIsAllowedToWorkWithSubsidiaryPartners, 
       ISNULL(Contracts.CentralizedContract, FALSE) AS CentralizedContract, 
       ISNULL(Contracts.ContractWithCommissionAgent.ConductARAPAccountingThroughEndCustomers, FALSE) AS FeeViaEndCustomers,
       ARAPObjects.LineOfBusiness, 
       ARAPObjects.ForeignCurrencyTransaction, 
       ARAPObjects.ARAPCurrency,
       &amp;SelectAccountsReceivable AS SelectAccountsReceivable,
       ARAPObjects.OnlyBalance AS OnlyBalance,
       0 AS SumBalance,
       0 AS AmountDue,
       0 AS BeingPaid
 FROM 
       Catalog.ARAPObjects AS ARAPObjects
   			LEFT JOIN Catalog.CounterpartyContracts AS Contracts
				ON ARAPObjects.Contract = Contracts.Ref
WHERE
	NOT &amp;SelectingThePaymentBasis
	AND (ARAPObjects.Organization IN (&amp;Organization) 
		OR NOT &amp;ThisIsParentOrganization 
			AND ARAPObjects.Contract IN (&amp;CentralizedContracts)
			AND (ARAPObjects.Organization = &amp;ParentCompany
			OR Contracts.TransferAndOffsetOfPaymentsBetweenBranchOfficesIsAllowed)
		OR &amp;ThisIsParentOrganization
			AND ARAPObjects.Organization.ParentCompany IN (&amp;Organization)
			AND ARAPObjects.Organization.TransactionsUsingParentCompanyAreAllowed
		OR &amp;ByAllCompanies)
	AND (ARAPObjects.Partner IN (&amp;Partner)
		OR &amp;ForAllPartners)
	AND (ARAPObjects.Counterparty IN (&amp;Counterparty)
		OR &amp;ForAllCounterparties)
	AND ((Contracts.ContractType = VALUE(Enum.ContractTypes.WithConsignee) AND Contracts.ConsignmentSales25) OR NOT &amp;SelectObjectsOfSettlementsWithCommissionAgent)
	AND (Contracts.ContractWithCommissionAgent = &amp;ContractWithCommissionAgent AND Contracts.Counterparty = &amp;CustomerCounterparty AND Contracts.Partner = &amp;CustomerPartner OR NOT &amp;SelectObjectsOfSettlementsWithEndClient)
	AND NOT ARAPObjects.DeletionMark
	AND (NOT (ARAPObjects.Object REFS Catalog.GiftCertificates))
	AND ((ARAPObjects.ARAPObjectType &lt;> VALUE(Enum.ARAPObjectTypes.Invoice)
				OR ARAPObjects.Object REFS Document.SourceDocument
					AND NOT &amp;ChoosingAdvancePayment)
				AND (ARAPObjects.ARAPObjectType &lt;> VALUE(Enum.ARAPObjectTypes.PaymentReturn)
					OR (ARAPObjects.Object REFS Document.SourceDocument
						OR ARAPObjects.Object REFS Catalog.GiftCertificates)
						AND &amp;ChoosingAdvancePayment))</queryText>
      <mainTable>Catalog.ARAPObjects</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
