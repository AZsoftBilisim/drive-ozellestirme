  <attributes>
    <name>ListOfContractsBetweenOrganizations</name>
    <title>
      <key>en</key>
      <value>Intercompany contract list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست قراردادهای بین‌شرکتی</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список договоров между организациями</value>
    </title>
    <title>
      <key>tr</key>
      <value>Şirketler arası sözleşmelerin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách hợp đồng giữa các doanh nghiệp</value>
    </title>
    <title>
      <key>it</key>
      <value>Intercompany contract list</value>
    </title>
    <title>
      <key>pl</key>
      <value>Intercompany contract list</value>
    </title>
    <id>15</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.Contract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.Date</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.LineOfBusiness</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.Number</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.PaymentPurpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfContractsBetweenOrganizations.Sum</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>// The text of the request is assigned in the module of the form attached to the server
SELECT
	IntercompanyContracts.Ref AS PaymentPurpose,
	IntercompanyContracts.Ref AS Contract,
	SettlementObjectsRecipient.Ref AS ARAPObjectRecipient,
	IntercompanyContracts.Organization AS Organization, 
	VALUE(Catalog.Partners.OurEnterprise) AS Partner,
	IntercompanyContracts.CompanyRecipient AS Counterparty,
	IntercompanyContracts.LineOfBusiness,
	IntercompanyContracts.Number,
	IntercompanyContracts.Date,
	IntercompanyContracts.Sum,
	IntercompanyContracts.PaymentID
FROM
	Catalog.IntercompanyContracts AS IntercompanyContracts
		LEFT JOIN Catalog.ARAPObjects AS SettlementObjectsRecipient
		ON IntercompanyContracts.Ref = SettlementObjectsRecipient.Object
		AND IntercompanyContracts.CompanyRecipient = SettlementObjectsRecipient.Organization
		LEFT JOIN Catalog.ARAPObjects AS ARAPObjects
		ON IntercompanyContracts.Ref = ARAPObjects.Object
		AND IntercompanyContracts.Organization = ARAPObjects.Organization
WHERE
	IntercompanyContracts.Organization = &amp;Organization
	AND (IntercompanyContracts.CompanyRecipient IN (&amp;Counterparty)
		OR &amp;ForAllCounterparties)
</queryText>
      <mainTable>Catalog.IntercompanyContracts</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
