  <attributes>
    <name>APARObjectList</name>
    <title>
      <key>en</key>
      <value>AR/AP object list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست موضوعات دریافتنی/پرداختنی</value>
    </title>
    <title>
      <key>it</key>
