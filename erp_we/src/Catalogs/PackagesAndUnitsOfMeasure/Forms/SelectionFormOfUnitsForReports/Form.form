  <attributes>
    <name>PackagingList</name>
    <title>
      <key>en</key>
      <value>Packaging unit list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست واحدهای بسته‌بندی</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco di imballaggio</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista opakowań</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список упаковки</value>
    </title>
    <title>
      <key>tr</key>
      <value>Paketleme ünitesi listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách đòng gói</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PackagingList.Package</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PackagingList.UnitOfMeasure</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PackagingList.ZoomRatio</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	PackagesOverridable.UnitOfMeasure AS UnitOfMeasure,
	&amp;QueryTextPackagingFactor2 AS ZoomRatio,
	MAX(PackagesOverridable.Ref) AS Ref
INTO ProductPackages
FROM
	Catalog.PackagesAndUnitsOfMeasure AS PackagesOverridable
WHERE
	(PackagesOverridable.UnitOfMeasure, &amp;QueryTextPackagingFactor2) IN
			(SELECT
				ProductPackagesOverridable.UnitOfMeasure,
				MAX(&amp;QueryTextPackagingFactor1) AS ZoomRatio
			FROM
				Catalog.PackagesAndUnitsOfMeasure AS ProductPackagesOverridable
			WHERE
				ProductPackagesOverridable.Owner = &amp;Owner
				AND ProductPackagesOverridable.DeletionMark = FALSE
			GROUP BY
				ProductPackagesOverridable.UnitOfMeasure)
	AND PackagesOverridable.Owner = &amp;Owner
	AND PackagesOverridable.DeletionMark = FALSE

GROUP BY
	PackagesOverridable.UnitOfMeasure,
	&amp;QueryTextPackagingFactor2
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	UnitsOfMeasurementOverridable.Ref AS UnitOfMeasure,
	ProductPackagesOverridable.Ref AS Package,
	ISNULL(ProductPackagesOverridable.ZoomRatio, 9999999) AS ZoomRatio
FROM
	Catalog.PackagesAndUnitsOfMeasure AS UnitsOfMeasurementOverridable
		LEFT JOIN ProductPackages AS ProductPackagesOverridable
		ON (ProductPackagesOverridable.UnitOfMeasure = UnitsOfMeasurementOverridable.Ref)
WHERE
	UnitsOfMeasurementOverridable.DeletionMark = FALSE
	AND UnitsOfMeasurementOverridable.Owner = VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure)</queryText>
      <mainTable>Catalog.PackagesAndUnitsOfMeasure</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PredefinedDataName</dataPath>
        <field>PredefinedDataName</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ref</dataPath>
        <field>Ref</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Height</dataPath>
