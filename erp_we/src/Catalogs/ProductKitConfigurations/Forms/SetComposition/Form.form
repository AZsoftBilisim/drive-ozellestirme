  <formCommands>
    <name>InstallTheMainComponent</name>
    <title>
      <key>en</key>
      <value>Main component</value>
    </title>
    <title>
      <key>fa</key>
      <value>جزء اصلی</value>
    </title>
    <title>
      <key>it</key>
      <value>Componente principale</value>
    </title>
