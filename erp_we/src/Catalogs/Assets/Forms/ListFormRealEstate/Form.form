    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	&amp;BeginOfPeriod AS BeginOfPeriod,
	&amp;EndOfPeriod AS EndOfPeriod,
	&amp;DocumentDate AS DocumentDate,
	&amp;Date AS Date,
	&amp;ListOfFA AS ListOfFA,
	&amp;WithoutFASelection AS WithoutFASelection,
	&amp;Organization AS Organization
INTO QueryOptionsOverridable
WHERE
	FALSE
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FixedAssetsOverridable.Ref AS Ref,
	FixedAssetsOverridable.Description AS Description,
	FixedAssetsOverridable.IsFolder AS IsFolder,
	&quot;&quot; AS CadastralNumber,
	DATETIME(1, 1, 1) AS DateOfRegistration,
	DATETIME(1, 1, 1) AS DateOfDeRegistration
FROM
	Catalog.Assets AS FixedAssetsOverridable
		LEFT JOIN Catalog.Companies AS CompaniesOverridable
		ON (FALSE)
		LEFT JOIN QueryOptionsOverridable AS QueryOptionsOverridable
		ON (FALSE)
{WHERE
	FixedAssetsOverridable.Ref AS Ref,
	CompaniesOverridable.Ref AS Organization}</queryText>
      <mainTable>Catalog.Assets</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
