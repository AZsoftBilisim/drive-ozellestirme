    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	&amp;BeginOfPeriod AS BeginOfPeriod,
	&amp;EndOfPeriod AS EndOfPeriod,
	&amp;DocumentDate AS DocumentDate,
	&amp;Date AS Date,
	&amp;ListOfFA AS ListOfFA,
	&amp;WithoutFASelection AS WithoutFASelection,
	&amp;Organization AS Organization
INTO QueryOptionsOverridable
WHERE
	FALSE
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	CatalogFixedAssetsOverridable.Ref AS Ref,
	CatalogFixedAssetsOverridable.DeletionMark AS DeletionMark,
	CatalogFixedAssetsOverridable.Parent AS Parent,
	CatalogFixedAssetsOverridable.IsFolder AS IsFolder,
	CatalogFixedAssetsOverridable.Code AS Code,
	CatalogFixedAssetsOverridable.Description AS Description,
	CatalogFixedAssetsOverridable.DescriptionFull AS DescriptionFull,
	CatalogFixedAssetsOverridable.Manufacturer_ AS Manufacturer_,
	CatalogFixedAssetsOverridable.ManufaturerNumber AS ManufaturerNumber,
	CatalogFixedAssetsOverridable.PassportNumber AS PassportNumber,
	CatalogFixedAssetsOverridable.DateOfProduction AS DateOfProduction,
	CatalogFixedAssetsOverridable.CodeByRNCFA AS CodeByRNCFA,
	CatalogFixedAssetsOverridable.OSGroup AS OSGroup,
	CatalogFixedAssetsOverridable.CodeByUFADR AS CodeByUFADR,
	CatalogFixedAssetsOverridable.Comment AS Comment,
	CatalogFixedAssetsOverridable.Predefined AS Predefined,
	CatalogFixedAssetsOverridable.PredefinedDataName AS PredefinedDataName,
	DATETIME(1, 1, 1) AS Supplied_2,
	DATETIME(1, 1, 1) AS TakenOff,
	&quot;&quot; AS RegistrationMark

FROM
	Catalog.Assets AS CatalogFixedAssetsOverridable
		LEFT JOIN Catalog.Companies AS CompaniesOverridable
		ON (FALSE)
		LEFT JOIN QueryOptionsOverridable AS QueryOptionsOverridable
		ON (FALSE)
</queryText>
