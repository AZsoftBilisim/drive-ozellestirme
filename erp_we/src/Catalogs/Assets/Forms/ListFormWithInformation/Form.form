    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogAssetsOverridable.Ref,
	CatalogAssetsOverridable.DeletionMark,
	CatalogAssetsOverridable.Parent,
	CatalogAssetsOverridable.IsFolder,
	CatalogAssetsOverridable.Code,
	CatalogAssetsOverridable.OSType,
	CatalogAssetsOverridable.Description,
	CatalogAssetsOverridable.DescriptionFull,
	CatalogAssetsOverridable.Manufacturer_,
	CatalogAssetsOverridable.ManufaturerNumber,
	CatalogAssetsOverridable.PassportNumber,
	CatalogAssetsOverridable.DateOfProduction,
	CatalogAssetsOverridable.CodeByRNCFA AS CodeByRNCFA,
	CatalogAssetsOverridable.OSGroup AS OSGroup,
	UNDEFINED AS DepreciationGroup,
	CatalogAssetsOverridable.CodeByUFADR AS CodeByUFADR,
	CatalogAssetsOverridable.Comment,
	CatalogAssetsOverridable.Placement,
	CatalogAssetsOverridable.Model,
	CatalogAssetsOverridable.SerialNumber,
	&quot;&quot; AS LocationAddress,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Enum.FixedAssetsStates.NotRecognized_) AS State,
	VALUE(Enum.FixedAssetsStates.NotRecognized_) AS ReglStatus,
	VALUE(Enum.FixedAssetsStates.NotRecognized_) AS UPRStatus,
	CatalogAssetsOverridable.AssetID,
	DATETIME(1, 1, 1, 0, 0, 0) AS DateOfRegistrationOfTheRegl,
	DATETIME(1, 1, 1, 0, 0, 0) AS DateOfRegistrationOfTheUpr,
	VALUE(Catalog.Persons.EmptyRef) AS FinanciallyLiablePerson,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	0 AS HasFiles
FROM
	Catalog.Assets AS CatalogAssetsOverridable</queryText>
      <mainTable>Catalog.Assets</mainTable>
