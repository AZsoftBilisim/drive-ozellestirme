  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogAssets.Ref AS Ref,
	CatalogAssets.DeletionMark AS DeletionMark,
	CatalogAssets.Parent AS Parent,
	CatalogAssets.IsFolder AS IsFolder,
	CatalogAssets.Code AS Code,
	CatalogAssets.Description AS Description,
	CatalogAssets.FixedAssetsGroupFinancialAccounting AS FixedAssetsGroupFinancialAccounting,
	CatalogAssets.AssetID AS AssetID,
	CatalogAssets.DateOfProduction AS DateOfProduction,
	CatalogAssets.CodeByRNCFA AS CodeByRNCFA,
	CatalogAssets.CodeByUFADR AS CodeByUFADR,
	CatalogAssets.DateOfLastEdit AS DateOfLastEdit,
	CatalogAssets.ManufaturerNumber AS ManufaturerNumber,
	CatalogAssets.Manufacturer_ AS Manufacturer_,
	CatalogAssets.Class AS Class,
	CatalogAssets.Comment AS Comment,
	CatalogAssets.Model AS Model,
	CatalogAssets.DescriptionFull AS DescriptionFull,
	CatalogAssets.PassportNumber AS PassportNumber,
	CatalogAssets.HouseholdObject AS HouseholdObject,
	CatalogAssets.Subclass AS Subclass,
	CatalogAssets.Placement AS Placement,
	CatalogAssets.RMBusinessUnit AS RMBusinessUnit,
	CatalogAssets.SerialNumber AS SerialNumber,
	CatalogAssets.Status AS Status,
	CatalogAssets.ExpenseItem AS ExpenseItem,
	CatalogAssets.OperatingBusinessUnit AS OperatingBusinessUnit,
	CatalogAssets.PayrollExpensesPostingMethod AS PayrollExpensesPostingMethod,
	CatalogAssets.RegisteredInPlatonSystemRegistry AS RegisteredInPlatonSystemRegistry,
	CatalogAssets.Predefined AS Predefined,
	CatalogAssets.PredefinedDataName AS PredefinedDataName,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Catalog.Assets AS CatalogAssets
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON CatalogAssets.Ref = FilesExist.ObjectWithFiles</queryText>
      <mainTable>Catalog.Assets</mainTable>
