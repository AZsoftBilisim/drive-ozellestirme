        <field>AttributeOfAdditionalSortingHierarchical</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DataCompositionSchema</dataPath>
        <field>DataCompositionSchema</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
