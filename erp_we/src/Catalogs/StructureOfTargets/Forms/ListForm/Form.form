  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.AddlOrderingAttribute</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.AttributeOfAdditionalSortingHierarchical</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogStructureOfTargets.Ref,
	CatalogStructureOfTargets.DataVersion,
	CatalogStructureOfTargets.DeletionMark,
	CatalogStructureOfTargets.Predefined,
	CatalogStructureOfTargets.Parent,
	CatalogStructureOfTargets.Description,
	CatalogStructureOfTargets.TargetCategory,
	CatalogStructureOfTargets.MeasurableTarget,
	CatalogStructureOfTargets.TargetValue,
	CatalogStructureOfTargets.ShortNameOfTargetValue,
	CatalogStructureOfTargets.LongDesc,
	CatalogStructureOfTargets.CalculationFormula,
	CatalogStructureOfTargets.DataCompositionSchema,
	CatalogStructureOfTargets.StorageOfDataCompositionSchema,
	CatalogStructureOfTargets.StorageOfDataCompositionSettings,
	CatalogStructureOfTargets.Dimensions,
	CatalogStructureOfTargets.TargetTrend,
	CASE
		WHEN CatalogStructureOfTargets.MeasurableTarget
			THEN 2
		ELSE 0
	END + CASE
		WHEN CatalogStructureOfTargets.DeletionMark
			THEN 1
		ELSE 0
	END AS CustomPicture,
	CatalogStructureOfTargets.AddlOrderingAttribute,
	CatalogStructureOfTargets.AttributeOfAdditionalSortingHierarchical
FROM
	Catalog.StructureOfTargets AS CatalogStructureOfTargets</queryText>
      <mainTable>Catalog.StructureOfTargets</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Parent</dataPath>
