          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>TargetCategory</dataPath>
        <field>TargetCategory</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
