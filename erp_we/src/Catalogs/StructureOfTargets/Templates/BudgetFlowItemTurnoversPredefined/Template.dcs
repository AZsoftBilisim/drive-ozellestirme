		</field>
		<dataSource>DataSource1</dataSource>
		<query>// THERE ARE CLIPPING TAGS

SELECT
	1 AS CompatibleWithTMCut
INTO CompatibleWithTMCut
;

SELECT ALLOWED
	TurnoversAndTurnovers.BudgetFlowItem AS BudgetFlowItem,
	TurnoversAndTurnovers.Organization AS Organization,
	TurnoversAndTurnovers.Department AS Department,
	TurnoversAndTurnovers.Currency AS Currency,
	TurnoversAndTurnovers.Dimension1 AS Dimension1,
	TurnoversAndTurnovers.Dimension2 AS Dimension2,
	TurnoversAndTurnovers.Dimension3 AS Dimension3,
	TurnoversAndTurnovers.Dimension4 AS Dimension4,
	TurnoversAndTurnovers.Dimension5 AS Dimension5,
	TurnoversAndTurnovers.Dimension6 AS Dimension6,
	SUM(TurnoversAndTurnovers.CountTurnover) AS Count,
	SUM(TurnoversAndTurnovers.SumManTurnover) AS SumMan,
	SUM(TurnoversAndTurnovers.SumComplTurnover) AS SumCompl,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, DAY) AS DayPeriod,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(TurnoversAndTurnovers.PlanningPeriod, YEAR) AS YearPeriod
INTO PlanForBudgetItems
FROM
	AccumulationRegister.BudgetTurnovers.Turnovers(
			,
			,
			Auto,
			PlanningPeriod BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod
				AND Scenario = &amp;Scenario {(Organization).* AS Organization, (Department).* AS Department, (BudgetFlowItem).* AS BudgetFlowItem, (Dimension1) AS Dimension1, (Dimension2) AS Dimension2, (Dimension3) AS Dimension3, (Dimension4) AS Dimension4, (Dimension5) AS Dimension5, (Dimension6) AS Dimension6}) AS TurnoversAndTurnovers

GROUP BY
	TurnoversAndTurnovers.BudgetFlowItem,
	TurnoversAndTurnovers.Organization,
	TurnoversAndTurnovers.Department,
	TurnoversAndTurnovers.Currency,
	TurnoversAndTurnovers.Dimension1,
	TurnoversAndTurnovers.Dimension2,
	TurnoversAndTurnovers.Dimension3,
	TurnoversAndTurnovers.Dimension4,
	TurnoversAndTurnovers.Dimension5,
	TurnoversAndTurnovers.Dimension6,
	TurnoversAndTurnovers.PlanningPeriod

INDEX BY
	BudgetFlowItem
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ActualBudgetingDataTurnovers.BudgetFlowItem AS BudgetFlowItem,
	ActualBudgetingDataTurnovers.Organization AS Organization,
	ActualBudgetingDataTurnovers.Department AS Department,
	ActualBudgetingDataTurnovers.Currency AS Currency,
	ActualBudgetingDataTurnovers.Dimension1 AS Dimension1,
	ActualBudgetingDataTurnovers.Dimension2 AS Dimension2,
	ActualBudgetingDataTurnovers.Dimension3 AS Dimension3,
	ActualBudgetingDataTurnovers.Dimension4 AS Dimension4,
	ActualBudgetingDataTurnovers.Dimension5 AS Dimension5,
	ActualBudgetingDataTurnovers.Dimension6 AS Dimension6,
	SUM(ActualBudgetingDataTurnovers.CountTurnover) AS Count,
	SUM(ActualBudgetingDataTurnovers.SumManTurnover) AS SumMan,
	SUM(ActualBudgetingDataTurnovers.SumComplTurnover) AS SumCompl,
	ActualBudgetingDataTurnovers.DayPeriod AS DayPeriod,
	ActualBudgetingDataTurnovers.WeekPeriod AS WeekPeriod,
	ActualBudgetingDataTurnovers.TenDaysPeriod AS TenDaysPeriod,
	ActualBudgetingDataTurnovers.MonthPeriod AS MonthPeriod,
	ActualBudgetingDataTurnovers.QuarterPeriod AS QuarterPeriod,
	ActualBudgetingDataTurnovers.HalfYearPeriod AS HalfYearPeriod,
	ActualBudgetingDataTurnovers.YearPeriod AS YearPeriod
INTO FactOnBudgetItems
FROM
	AccumulationRegister.ActualBudgetingData.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, ) AS ActualBudgetingDataTurnovers

GROUP BY
	ActualBudgetingDataTurnovers.BudgetFlowItem,
	ActualBudgetingDataTurnovers.Organization,
	ActualBudgetingDataTurnovers.Department,
	ActualBudgetingDataTurnovers.Currency,
	ActualBudgetingDataTurnovers.Dimension1,
	ActualBudgetingDataTurnovers.Dimension2,
	ActualBudgetingDataTurnovers.Dimension3,
	ActualBudgetingDataTurnovers.Dimension4,
	ActualBudgetingDataTurnovers.Dimension5,
	ActualBudgetingDataTurnovers.Dimension6,
	ActualBudgetingDataTurnovers.DayPeriod,
	ActualBudgetingDataTurnovers.WeekPeriod,
	ActualBudgetingDataTurnovers.TenDaysPeriod,
	ActualBudgetingDataTurnovers.MonthPeriod,
	ActualBudgetingDataTurnovers.QuarterPeriod,
	ActualBudgetingDataTurnovers.HalfYearPeriod,
	ActualBudgetingDataTurnovers.YearPeriod

INDEX BY
	BudgetFlowItem
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.BudgetFlowItem AS BudgetFlowItem,
	NestedQuery.Organization AS Organization,
	NestedQuery.Department AS Department,
	NestedQuery.Currency AS Currency,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Contracts)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE UNDEFINED
	END AS Contract,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Counterparties)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Counterparties.EmptyRef)
	END AS Counterparty,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.LinesOfBusiness)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	END AS LineOfBusiness,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.BudgetingItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Products.EmptyRef)
	END AS Products,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Partners)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Partners.EmptyRef)
	END AS Partner,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Projects)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Projects.EmptyRef)
	END AS Project,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Warehouses)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	END AS Warehouse,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.AssetLiabilityItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	END AS AssetAndLiabilityItem,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.IncomeItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
	END AS IncomeItem,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.ExpenseItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	END AS ExpenseItem,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.CashFlowReportItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.CashFlowReportItems.EmptyRef)
	END AS CashFlowItem,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.ProductCategories)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.ProductCategories.EmptyRef)
	END AS ProductCategory,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Persons)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Persons.EmptyRef)
	END AS Individual,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.PriceGroups)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.PriceGroups.EmptyRef)
	END AS PriceGroup,
	SUM(NestedQuery.CountPlan) AS CountPlan,
	SUM(NestedQuery.AmountMngPlan) AS AmountMngPlan,
	SUM(NestedQuery.AmountLocalPlan) AS AmountLocalPlan,
	SUM(NestedQuery.CountReal) AS CountReal,
	SUM(NestedQuery.AmountMngFact) AS AmountMngFact,
	SUM(NestedQuery.AmountLocalFact) AS AmountLocalFact,
	NestedQuery.DayPeriod AS DayPeriod,
	NestedQuery.WeekPeriod AS WeekPeriod,
	NestedQuery.TenDaysPeriod AS TenDaysPeriod,
	NestedQuery.MonthPeriod AS MonthPeriod,
	NestedQuery.QuarterPeriod AS QuarterPeriod,
	NestedQuery.HalfYearPeriod AS HalfYearPeriod,
	NestedQuery.YearPeriod AS YearPeriod
FROM
	(SELECT
		PlanForBudgetItems.BudgetFlowItem AS BudgetFlowItem,
		PlanForBudgetItems.BudgetFlowItem.DimensionKind1 AS DimensionKind1,
		PlanForBudgetItems.BudgetFlowItem.DimensionKind2 AS DimensionKind2,
		PlanForBudgetItems.BudgetFlowItem.DimensionKind3 AS DimensionKind3,
		PlanForBudgetItems.BudgetFlowItem.DimensionKind4 AS DimensionKind4,
		PlanForBudgetItems.BudgetFlowItem.DimensionKind5 AS DimensionKind5,
		PlanForBudgetItems.BudgetFlowItem.DimensionKind6 AS DimensionKind6,
		PlanForBudgetItems.Organization AS Organization,
		PlanForBudgetItems.Department AS Department,
		PlanForBudgetItems.Currency AS Currency,
		PlanForBudgetItems.Dimension1 AS Dimension1,
		PlanForBudgetItems.Dimension2 AS Dimension2,
		PlanForBudgetItems.Dimension3 AS Dimension3,
		PlanForBudgetItems.Dimension4 AS Dimension4,
		PlanForBudgetItems.Dimension5 AS Dimension5,
		PlanForBudgetItems.Dimension6 AS Dimension6,
		PlanForBudgetItems.Count AS CountPlan,
		PlanForBudgetItems.SumMan AS AmountMngPlan,
		PlanForBudgetItems.SumCompl AS AmountLocalPlan,
		0 AS CountReal,
		0 AS AmountMngFact,
		0 AS AmountLocalFact,
		PlanForBudgetItems.DayPeriod AS DayPeriod,
		PlanForBudgetItems.WeekPeriod AS WeekPeriod,
		PlanForBudgetItems.TenDaysPeriod AS TenDaysPeriod,
		PlanForBudgetItems.MonthPeriod AS MonthPeriod,
		PlanForBudgetItems.QuarterPeriod AS QuarterPeriod,
		PlanForBudgetItems.HalfYearPeriod AS HalfYearPeriod,
		PlanForBudgetItems.YearPeriod AS YearPeriod
	FROM
		PlanForBudgetItems AS PlanForBudgetItems
	
	UNION ALL
	
	SELECT
		FactOnBudgetItems.BudgetFlowItem,
		FactOnBudgetItems.BudgetFlowItem.DimensionKind1,
		FactOnBudgetItems.BudgetFlowItem.DimensionKind2,
		FactOnBudgetItems.BudgetFlowItem.DimensionKind3,
		FactOnBudgetItems.BudgetFlowItem.DimensionKind4,
		FactOnBudgetItems.BudgetFlowItem.DimensionKind5,
		FactOnBudgetItems.BudgetFlowItem.DimensionKind6,
		FactOnBudgetItems.Organization,
		FactOnBudgetItems.Department,
		FactOnBudgetItems.Currency,
		FactOnBudgetItems.Dimension1,
		FactOnBudgetItems.Dimension2,
		FactOnBudgetItems.Dimension3,
		FactOnBudgetItems.Dimension4,
		FactOnBudgetItems.Dimension5,
		FactOnBudgetItems.Dimension6,
		0,
		0,
		0,
		FactOnBudgetItems.Count,
		FactOnBudgetItems.SumMan,
		FactOnBudgetItems.SumCompl,
		FactOnBudgetItems.DayPeriod,
		FactOnBudgetItems.WeekPeriod,
		FactOnBudgetItems.TenDaysPeriod,
		FactOnBudgetItems.MonthPeriod,
		FactOnBudgetItems.QuarterPeriod,
		FactOnBudgetItems.HalfYearPeriod,
		FactOnBudgetItems.YearPeriod
	FROM
		FactOnBudgetItems AS FactOnBudgetItems) AS NestedQuery

GROUP BY
	NestedQuery.BudgetFlowItem,
	NestedQuery.Organization,
	NestedQuery.Department,
	NestedQuery.Currency,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Contracts)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE UNDEFINED
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Counterparties)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Counterparties.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.LinesOfBusiness)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.BudgetingItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Products.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Partners)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Partners.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Projects)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Projects.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Warehouses)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.AssetLiabilityItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.IncomeItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.ExpenseItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.CashFlowReportItems)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.CashFlowReportItems.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.ProductCategories)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.ProductCategories.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.Persons)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.Persons.EmptyRef)
	END,
	CASE VALUE(ChartOfCharacteristicTypes.BudgetFlowItemDimensions.PriceGroups)
		WHEN NestedQuery.DimensionKind1
			THEN NestedQuery.Dimension1
		WHEN NestedQuery.DimensionKind2
			THEN NestedQuery.Dimension2
		WHEN NestedQuery.DimensionKind3
			THEN NestedQuery.Dimension3
		WHEN NestedQuery.DimensionKind4
			THEN NestedQuery.Dimension4
		WHEN NestedQuery.DimensionKind5
			THEN NestedQuery.Dimension5
		WHEN NestedQuery.DimensionKind6
			THEN NestedQuery.Dimension6
		ELSE VALUE(Catalog.PriceGroups.EmptyRef)
	END,
	NestedQuery.DayPeriod,
	NestedQuery.WeekPeriod,
	NestedQuery.TenDaysPeriod,
	NestedQuery.MonthPeriod,
	NestedQuery.QuarterPeriod,
	NestedQuery.HalfYearPeriod,
	NestedQuery.YearPeriod
	
</query>
