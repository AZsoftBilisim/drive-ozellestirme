		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.Manager AS Manager,
	SUM(Table.Revenue) * AVG(ISNULL(ExchangeRates.ConversionFactor_, 1)) AS Revenue,
	CASE
		WHEN Table.Partner = VALUE(Catalog.Partners.OurEnterprise)
			THEN TRUE
		ELSE FALSE
	END AS IntercompanySales,
	Table.Partner AS Partner,
	Table.Warehouse AS Warehouse,
	Table.DayPeriod,
	Table.WeekPeriod,
	Table.TenDaysPeriod,
	Table.MonthPeriod,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.YearPeriod,
	Table.Organization AS Organization,
	Table.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
{SELECT
	Organization.*,
	Manager.*,
	InventoryOwnerAttribute.*,
	Products.*,
	Characteristic.*,
	Partner.*}
FROM
	(SELECT
		&amp;ManagementAccountingCurrency AS Currency,
		Sales.ItemsLocationAttributes.Products AS Products,
		Sales.ItemsLocationAttributes.Characteristic AS Characteristic,
		Sales.AccountingDimensionByPartners.Organization AS Organization,
		Sales.AccountingDimensionByPartners.Organization AS Seller,
		Sales.AccountingDimensionByPartners.Partner AS Partner,
		Sales.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		CASE
			WHEN Sales.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN Sales.InventoryOwnerAttribute.GoodsOwner
			ELSE Sales.InventoryOwnerAttribute.GoodsOwner
		END AS Vendor,
		CAST(Sales.SalesOrder.Manager AS Catalog.Users) AS Manager,
		Sales.Department AS Department,
		Sales.ItemsLocationAttributes.StorageLocation AS Warehouse,
		CASE
			WHEN Sales.AccountingDimensionByPartners.Counterparty REFS Catalog.Counterparties
				THEN Sales.AccountingDimensionByPartners.Counterparty
			ELSE NULL
		END AS Counterparty,
		CASE
			WHEN Sales.AccountingDimensionByPartners.Counterparty REFS Catalog.Companies
				THEN Sales.AccountingDimensionByPartners.Counterparty
			ELSE NULL
		END AS Customer,
		Sales.RevenueAmountTurnover AS Revenue,
		Sales.DayPeriod AS DayPeriod,
		Sales.WeekPeriod AS WeekPeriod,
		Sales.TenDaysPeriod AS TenDaysPeriod,
		Sales.MonthPeriod AS MonthPeriod,
		Sales.QuarterPeriod AS QuarterPeriod,
		Sales.HalfYearPeriod AS HalfYearPeriod,
		Sales.YearPeriod AS YearPeriod
	{SELECT
		Department.*,
		Products.*,
		Characteristic.*,
		Warehouse.*,
		Organization.*,
		Seller.*,
		Partner.*,
		Counterparty.*,
		Customer.*,
		Vendor.*,
		Manager.*,
		InventoryOwnerAttribute.*}
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.RetailCustomer)) AS Sales
	WHERE
		(&amp;ShowSales_ = 1
					AND Sales.AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
				OR &amp;ShowSales_ = 2
					AND Sales.AccountingDimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
				OR &amp;ShowSales_ = 0)
	{WHERE
		Sales.ItemsLocationAttributes.Products.* AS Products,
		Sales.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		Sales.AccountingDimensionByPartners.Organization.* AS Organization,
		Sales.AccountingDimensionByPartners.Partner.* AS Partner,
		Sales.ItemsLocationAttributes.StorageLocation.* AS Warehouse,
		Sales.AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		(ISNULL(Sales.SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef))).* AS SalesOpportunity,
		(CAST(Sales.SalesOrder.Manager AS Catalog.Users)).* AS Manager}) AS Table
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON Table.Currency = ExchangeRates.Currency

GROUP BY
	Table.Partner,
	Table.Warehouse,
	Table.Manager,
	Table.DayPeriod,
	Table.WeekPeriod,
	Table.TenDaysPeriod,
	Table.MonthPeriod,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.YearPeriod,
	Table.Organization,
	Table.InventoryOwnerAttribute,
	Table.Products,
	Table.Characteristic</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>TargetValuesRanges</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>DataForAnalysis</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DayPeriod</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>AverageSaleAmount</dataPath>
