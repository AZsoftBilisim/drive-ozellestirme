		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	TargetValuesOfSliceAnalysisOptions.TargetValueKind,
	TargetValuesOfSliceAnalysisOptions.TargetValue_ * ISNULL(ExchangeRates.ConversionFactor_, 1) AS TargetValue_,
	TargetValuesOfSliceAnalysisOptions.MinimumTargetRange * ISNULL(ExchangeRates.ConversionFactor_, 1) AS MinimumTargetRange,
	TargetValuesOfSliceAnalysisOptions.MaximumTargetRange * ISNULL(ExchangeRates.ConversionFactor_, 1) AS MaximumTargetRange,
	TargetValuesOfSliceAnalysisOptions.KindOfVarianceFromTargetValue,
	TargetValuesOfSliceAnalysisOptions.NegativeBorderVariance * CASE
		WHEN TargetValuesOfSliceAnalysisOptions.KindOfVarianceFromTargetValue = VALUE(Enum.KindsOfVariancesFromTargetValues.Absolute)
			THEN ISNULL(ExchangeRates.ConversionFactor_, 1)
		ELSE 1
	END AS NegativeBorderVariance,
	TargetValuesOfSliceAnalysisOptions.PositiveBorderVariance * CASE
		WHEN TargetValuesOfSliceAnalysisOptions.KindOfVarianceFromTargetValue = VALUE(Enum.KindsOfVariancesFromTargetValues.Absolute)
			THEN ISNULL(ExchangeRates.ConversionFactor_, 1)
		ELSE 1
	END AS PositiveBorderVariance,
	TargetValuesOfSliceAnalysisOptions.AdjustedNegativeBorderVariance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS AdjustedNegativeBorderVariance,
	TargetValuesOfSliceAnalysisOptions.AdjustedPositiveBorderVariance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS AdjustedPositiveBorderVariance
FROM
	InformationRegister.AnalysisOptionTargetValues.SliceLast(&amp;DateOfCalculation, AnalysisOption = &amp;AnalysisOption) AS TargetValuesOfSliceAnalysisOptions
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON (&amp;ManagementAccountingCurrency = ExchangeRates.Currency)</query>
	</dataSet>
