		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	TargetValuesOfSliceAnalysisOptions.TargetValueKind,
	TargetValuesOfSliceAnalysisOptions.TargetValue_ AS TargetValue_,
	TargetValuesOfSliceAnalysisOptions.MinimumTargetRange AS MinimumTargetRange,
	TargetValuesOfSliceAnalysisOptions.MaximumTargetRange AS MaximumTargetRange,
	TargetValuesOfSliceAnalysisOptions.KindOfVarianceFromTargetValue,
	TargetValuesOfSliceAnalysisOptions.NegativeBorderVariance AS NegativeBorderVariance,
	TargetValuesOfSliceAnalysisOptions.PositiveBorderVariance AS PositiveBorderVariance,
	TargetValuesOfSliceAnalysisOptions.AdjustedNegativeBorderVariance AS AdjustedNegativeBorderVariance,
	TargetValuesOfSliceAnalysisOptions.AdjustedPositiveBorderVariance AS AdjustedPositiveBorderVariance
FROM
	InformationRegister.AnalysisOptionTargetValues.SliceLast(&amp;DateOfCalculation, AnalysisOption = &amp;AnalysisOption) AS TargetValuesOfSliceAnalysisOptions</query>
	</dataSet>
