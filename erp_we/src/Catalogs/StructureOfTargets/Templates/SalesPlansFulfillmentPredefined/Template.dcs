		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SalesPlansTurnovers.Partner AS Partner,
	SalesPlansTurnovers.Manager AS Manager,
	SalesPlansTurnovers.Department AS Department,
	SalesPlansTurnovers.Warehouse AS Warehouse,
	SalesPlansTurnovers.Products.Parent AS ProductGroup,
	SalesPlansTurnovers.Products.ProductCategory AS ProductCategory,
	SalesPlansTurnovers.Products.AnalyticalGroup AS AnalyticalGroup,
	SalesPlansTurnovers.Products AS Products,
	SalesPlansTurnovers.Characteristic AS Characteristic,
	SUM(SalesPlansTurnovers.CountTurnover) AS Count,
	SUM(SalesPlansTurnovers.SumTurnover) AS Sum,
	SalesPlansTurnovers.DayPeriod,
	SalesPlansTurnovers.WeekPeriod,
	SalesPlansTurnovers.TenDaysPeriod,
	SalesPlansTurnovers.MonthPeriod,
	SalesPlansTurnovers.QuarterPeriod,
	SalesPlansTurnovers.HalfYearPeriod,
	SalesPlansTurnovers.YearPeriod
INTO SalesPlan
FROM
	AccumulationRegister.SalesPlans.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, Scenario = &amp;Scenario {(Partner).* AS Partner, (Manager).* AS Manager, (Department).* AS Department, (Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic}) AS SalesPlansTurnovers

GROUP BY
	SalesPlansTurnovers.DayPeriod,
	SalesPlansTurnovers.WeekPeriod,
	SalesPlansTurnovers.TenDaysPeriod,
	SalesPlansTurnovers.MonthPeriod,
	SalesPlansTurnovers.QuarterPeriod,
	SalesPlansTurnovers.HalfYearPeriod,
	SalesPlansTurnovers.YearPeriod,
	SalesPlansTurnovers.Partner,
	SalesPlansTurnovers.Manager,
	SalesPlansTurnovers.Department,
	SalesPlansTurnovers.Warehouse,
	SalesPlansTurnovers.Products.Parent,
	SalesPlansTurnovers.Products.ProductCategory,
	SalesPlansTurnovers.Products,
	SalesPlansTurnovers.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;ProvidedPeriodStart AS Period,
	CurrencyRatesCut.Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;ProvidedPeriodStart, Currency IN (&amp;ManagementAccountingCurrency, &amp;ScenarioCurrency) AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
WHERE
	&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency
	AND ExchangeRates.Period &gt; &amp;ProvidedPeriodStart
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND ExchangeRates.Currency IN (&amp;ManagementAccountingCurrency, &amp;ScenarioCurrency)
	AND BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	CurrencyRatesCut.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Partner AS Partner,
	RevenueAndCostOfSalesTurnover.Manager AS Manager,
	RevenueAndCostOfSalesTurnover.Department AS Department,
	RevenueAndCostOfSalesTurnover.Warehouse AS Warehouse,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.Parent AS ProductGroup,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.AnalyticalGroup AS AnalyticalGroup,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products AS Products,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Characteristic AS Characteristic,
	SUM(RevenueAndCostOfSalesTurnover.CountTurnover) AS FactQuantity,
	SUM(CAST(RevenueAndCostOfSalesTurnover.RevenueAmountTurnover * CASE
				WHEN &amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency
					THEN CASE
							WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
									AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
									AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
									AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
								THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
							ELSE 0
						END
				ELSE 1
			END AS NUMBER(31, 2))) AS ActualAmount,
	RevenueAndCostOfSalesTurnover.DayPeriod,
	RevenueAndCostOfSalesTurnover.WeekPeriod,
	RevenueAndCostOfSalesTurnover.TenDaysPeriod,
	RevenueAndCostOfSalesTurnover.MonthPeriod,
	RevenueAndCostOfSalesTurnover.QuarterPeriod,
	RevenueAndCostOfSalesTurnover.HalfYearPeriod,
	RevenueAndCostOfSalesTurnover.YearPeriod
INTO Sales
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(
			&amp;ProvidedPeriodStart,
			&amp;EndOfPeriod,
			Auto,
			ItemsLocationAttributes IN
				(SELECT DISTINCT
					ItemsLocationAttributes.DimensionKey
				FROM
					SalesPlan AS SalesPlan
						INNER JOIN InformationRegister.ItemsLocationAttributes AS ItemsLocationAttributes
						ON
							SalesPlan.Products = ItemsLocationAttributes.Products
								AND SalesPlan.Characteristic = ItemsLocationAttributes.Characteristic) {(AccountingDimensionByPartners.Partner).* AS Partner, (Manager).* AS Manager, (Department).* AS Department, (Warehouse).* AS Warehouse, (ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic}) AS RevenueAndCostOfSalesTurnover
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (ManSExchangeRates.Currency = &amp;ManagementAccountingCurrency)
			AND RevenueAndCostOfSalesTurnover.DayPeriod = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND RevenueAndCostOfSalesTurnover.DayPeriod = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = &amp;ManagementAccountingCurrency)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;ProvidedPeriodStart)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;ProvidedPeriodStart)
{WHERE
	AccountingDimensionByPartners.Organization.* AS Organization,
	ItemsLocationAttributes.Products.* AS Products}

GROUP BY
	RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Partner,
	RevenueAndCostOfSalesTurnover.Manager,
	RevenueAndCostOfSalesTurnover.Department,
	RevenueAndCostOfSalesTurnover.Warehouse,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.Parent,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Characteristic,
	RevenueAndCostOfSalesTurnover.DayPeriod,
	RevenueAndCostOfSalesTurnover.WeekPeriod,
	RevenueAndCostOfSalesTurnover.TenDaysPeriod,
	RevenueAndCostOfSalesTurnover.MonthPeriod,
	RevenueAndCostOfSalesTurnover.QuarterPeriod,
	RevenueAndCostOfSalesTurnover.HalfYearPeriod,
	RevenueAndCostOfSalesTurnover.YearPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
INTO TTPlanProducts
FROM
	SalesPlan AS Table

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DayPeriod AS DayPeriod,
	NestedQuery.WeekPeriod AS WeekPeriod,
	NestedQuery.TenDaysPeriod AS TenDaysPeriod,
	NestedQuery.MonthPeriod AS MonthPeriod,
	NestedQuery.QuarterPeriod AS QuarterPeriod,
	NestedQuery.HalfYearPeriod AS HalfYearPeriod,
	NestedQuery.YearPeriod AS YearPeriod,
	NestedQuery.Partner AS Partner,
	NestedQuery.Manager AS Manager,
	NestedQuery.Department AS Department,
	NestedQuery.Warehouse AS Warehouse,
	NestedQuery.Products.Parent AS ProductGroup,
	NestedQuery.Products.ProductCategory AS ProductCategory,
	NestedQuery.AnalyticalGroup,
	NestedQuery.Products AS Products,
	NestedQuery.Characteristic AS Characteristic,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.PlanAmount) AS PlanAmount,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.ActualAmount) AS ActualAmount,
	MAX(NestedQuery.PartnerPlan) AS PartnerPlan,
	MAX(NestedQuery.PlanManager) AS PlanManager,
	MAX(NestedQuery.DepartmentPlan) AS DepartmentPlan,
	MAX(NestedQuery.WarehousePlan) AS WarehousePlan
INTO SalesPlanFact
FROM
	(SELECT
		SalesPlan.DayPeriod AS DayPeriod,
		SalesPlan.WeekPeriod AS WeekPeriod,
		SalesPlan.TenDaysPeriod AS TenDaysPeriod,
		SalesPlan.MonthPeriod AS MonthPeriod,
		SalesPlan.QuarterPeriod AS QuarterPeriod,
		SalesPlan.HalfYearPeriod AS HalfYearPeriod,
		SalesPlan.YearPeriod AS YearPeriod,
		SalesPlan.Partner AS Partner,
		SalesPlan.Manager AS Manager,
		SalesPlan.Department AS Department,
		SalesPlan.Warehouse AS Warehouse,
		SalesPlan.Products.Parent AS ProductGroup,
		SalesPlan.Products.ProductCategory AS ProductCategory,
		SalesPlan.AnalyticalGroup AS AnalyticalGroup,
		SalesPlan.Products AS Products,
		SalesPlan.Characteristic AS Characteristic,
		SalesPlan.Count AS PlanQuantity,
		SalesPlan.Sum AS PlanAmount,
		0 AS FactQuantity,
		0 AS ActualAmount,
		SalesPlan.Partner AS PartnerPlan,
		SalesPlan.Manager AS PlanManager,
		SalesPlan.Department AS DepartmentPlan,
		SalesPlan.Warehouse AS WarehousePlan
	FROM
		SalesPlan AS SalesPlan
	
	UNION ALL
	
	SELECT
		Sales.DayPeriod,
		Sales.WeekPeriod,
		Sales.TenDaysPeriod,
		Sales.MonthPeriod,
		Sales.QuarterPeriod,
		Sales.HalfYearPeriod,
		Sales.YearPeriod,
		Sales.Partner,
		Sales.Manager,
		Sales.Department,
		Sales.Warehouse,
		Sales.Products.Parent,
		Sales.Products.ProductCategory,
		Sales.AnalyticalGroup,
		Sales.Products,
		Sales.Characteristic,
		0,
		0,
		Sales.FactQuantity,
		Sales.ActualAmount,
		VALUE(Catalog.Partners.EmptyRef),
		VALUE(Catalog.Users.EmptyRef),
		VALUE(Catalog.BusinessStructure.EmptyRef),
		VALUE(Catalog.Warehouses.EmptyRef)
	FROM
		Sales AS Sales) AS NestedQuery

GROUP BY
	NestedQuery.DayPeriod,
	NestedQuery.WeekPeriod,
	NestedQuery.TenDaysPeriod,
	NestedQuery.MonthPeriod,
	NestedQuery.QuarterPeriod,
	NestedQuery.HalfYearPeriod,
	NestedQuery.YearPeriod,
	NestedQuery.Partner,
	NestedQuery.Manager,
	NestedQuery.Department,
	NestedQuery.Warehouse,
	NestedQuery.Products.Parent,
	NestedQuery.Products.ProductCategory,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.AnalyticalGroup
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SalesPlanFact.DayPeriod,
	SalesPlanFact.WeekPeriod,
	SalesPlanFact.TenDaysPeriod,
	SalesPlanFact.MonthPeriod,
	SalesPlanFact.QuarterPeriod,
	SalesPlanFact.HalfYearPeriod,
	SalesPlanFact.YearPeriod,
	CASE
		WHEN SalesPlanFact.PartnerPlan = VALUE(Catalog.Partners.EmptyRef)
			THEN VALUE(Catalog.Partners.EmptyRef)
		ELSE SalesPlanFact.Partner
	END AS Partner,
	CASE
		WHEN SalesPlanFact.PlanManager = VALUE(Catalog.Users.EmptyRef)
			THEN VALUE(Catalog.Users.EmptyRef)
		ELSE SalesPlanFact.Manager
	END AS Manager,
	CASE
		WHEN SalesPlanFact.DepartmentPlan = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		ELSE SalesPlanFact.Department
	END AS Department,
	CASE
		WHEN SalesPlanFact.WarehousePlan = VALUE(Catalog.Warehouses.EmptyRef)
			THEN VALUE(Catalog.Warehouses.EmptyRef)
		ELSE SalesPlanFact.Warehouse
	END AS Warehouse,
	SalesPlanFact.Products.Parent AS ProductGroup,
	SalesPlanFact.Products.ProductCategory AS ProductCategory,
	SalesPlanFact.AnalyticalGroup,
	SalesPlanFact.Products AS Products,
	SalesPlanFact.Characteristic AS Characteristic,
	SUM(SalesPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(SalesPlanFact.PlanAmount) AS PlanAmount,
	SUM(SalesPlanFact.FactQuantity) AS FactQuantity,
	SUM(SalesPlanFact.ActualAmount) AS ActualAmount
FROM
	SalesPlanFact AS SalesPlanFact

GROUP BY
	SalesPlanFact.DayPeriod,
	SalesPlanFact.WeekPeriod,
	SalesPlanFact.TenDaysPeriod,
	SalesPlanFact.MonthPeriod,
	SalesPlanFact.QuarterPeriod,
	SalesPlanFact.HalfYearPeriod,
	SalesPlanFact.YearPeriod,
	SalesPlanFact.Products.Parent,
	SalesPlanFact.Products.ProductCategory,
	SalesPlanFact.Products,
	SalesPlanFact.Characteristic,
	SalesPlanFact.AnalyticalGroup,
	CASE
		WHEN SalesPlanFact.PartnerPlan = VALUE(Catalog.Partners.EmptyRef)
			THEN VALUE(Catalog.Partners.EmptyRef)
		ELSE SalesPlanFact.Partner
	END,
	CASE
		WHEN SalesPlanFact.PlanManager = VALUE(Catalog.Users.EmptyRef)
			THEN VALUE(Catalog.Users.EmptyRef)
		ELSE SalesPlanFact.Manager
	END,
	CASE
		WHEN SalesPlanFact.DepartmentPlan = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		ELSE SalesPlanFact.Department
	END,
	CASE
		WHEN SalesPlanFact.WarehousePlan = VALUE(Catalog.Warehouses.EmptyRef)
			THEN VALUE(Catalog.Warehouses.EmptyRef)
		ELSE SalesPlanFact.Warehouse
	END</query>
	</dataSet>
