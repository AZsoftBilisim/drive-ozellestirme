			<field xsi:type="DataSetFieldField">
				<dataPath>ReceiptActual</dataPath>
				<field>ReceiptActual</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>WriteOffFact</dataPath>
				<field>WriteOffFact</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.BankAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.BankAccount AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.BankAccount.CashCurrency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
INTO Cash
FROM
	AccumulationRegister.BankAccountCash AS RegisterData
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.BankAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccount.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.BankAccount.CashCurrency.* AS Currency
	}

UNION ALL

SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.CashAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.CashAccount AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.CashAccount.CashCurrency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
FROM
	AccumulationRegister.CashAccountBalance AS RegisterData
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.CashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.CashAccount.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.CashAccount.CashCurrency.* AS Currency
	}

UNION ALL

SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Contract.Department AS Department,
	RegisterData.Contract.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.Contract AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAcquirerCash) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.Currency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
FROM
	AccumulationRegister.CashInTransit AS RegisterData
WHERE
	&amp;OutputDSVPaths
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Contract.Department.* AS Department,
	RegisterData.Contract.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.Contract.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.Currency.* AS Currency
	}

INDEX BY
	Recorder,
	BusinessTransactionSetting,
	FinRecordID
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,
	CustomersARAPAccounting.AccountingDimensionByPartners.Counterparty AS CorDimension,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	CustomersARAPAccounting.AccountingDimensionByPartners.Partner AS Partner,
	CustomersARAPAccounting.AccountingDimensionByPartners.Counterparty AS Counterparty,
	CustomersARAPAccounting.AccountingDimensionByPartners.Contract AS Contract,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	ARAPObject.*,
	ReceiptActual,
	WriteOffFact}
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.CustomersARAPAccountingByDueDates AS CustomersARAPAccounting
		ON Cash.Recorder = CustomersARAPAccounting.DocumentRecorder
		AND (Cash.BusinessTransactionSetting = CustomersARAPAccounting.BusinessTransactionSetting
			OR CustomersARAPAccounting.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.EmptyRef))		AND Cash.FinRecordID = CustomersARAPAccounting.FinRecordID
		AND Cash.Organization = CustomersARAPAccounting.AccountingDimensionByPartners.Organization
		AND Cash.ReversingEntry = CustomersARAPAccounting.ReversingEntry
{WHERE
	CustomersARAPAccounting.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	CustomersARAPAccounting.AccountingDimensionByPartners.Counterparty.* AS CorDimension,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness.* AS LineOfBusiness,
	CustomersARAPAccounting.AccountingDimensionByPartners.Partner.* AS Partner,
	CustomersARAPAccounting.AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	CustomersARAPAccounting.AccountingDimensionByPartners.Contract.* AS Contract,
	CustomersARAPAccounting.ARAPObject.* AS ARAPObject
	}

UNION ALL

SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,
	VendorsARAPAccounting.AccountingDimensionByPartners.Counterparty AS CorDimension,
	VendorsARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	VendorsARAPAccounting.AccountingDimensionByPartners.Partner AS Partner,
	VendorsARAPAccounting.AccountingDimensionByPartners.Counterparty AS Counterparty,
	VendorsARAPAccounting.AccountingDimensionByPartners.Contract AS Contract,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.VendorsARAPAccountingByDueDates AS VendorsARAPAccounting
		ON Cash.Recorder = VendorsARAPAccounting.DocumentRecorder
		AND (Cash.BusinessTransactionSetting = VendorsARAPAccounting.BusinessTransactionSetting
			OR VendorsARAPAccounting.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.EmptyRef))
		AND Cash.FinRecordID = VendorsARAPAccounting.FinRecordID
		AND Cash.Organization = VendorsARAPAccounting.AccountingDimensionByPartners.Organization
		AND Cash.ReversingEntry = VendorsARAPAccounting.ReversingEntry
{WHERE
	VendorsARAPAccounting.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	VendorsARAPAccounting.AccountingDimensionByPartners.Counterparty.* AS CorDimension,
	VendorsARAPAccounting.ARAPObject.LineOfBusiness.* AS LineOfBusiness,
	VendorsARAPAccounting.AccountingDimensionByPartners.Partner.* AS Partner,
	VendorsARAPAccounting.AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	VendorsARAPAccounting.AccountingDimensionByPartners.Contract.* AS Contract,
	VendorsARAPAccounting.ARAPObject.* AS ARAPObject
	}
	
UNION ALL

SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,
	FinancialInstrumentsARAP.AccountingDimensionByPartners.Counterparty AS CorDimension,
	FinancialInstrumentsARAP.Contract.LineOfBusiness AS LineOfBusiness,
	FinancialInstrumentsARAP.AccountingDimensionByPartners.Partner AS Partner,
	FinancialInstrumentsARAP.AccountingDimensionByPartners.Counterparty AS Counterparty,
	FinancialInstrumentsARAP.Contract AS Contract,
	FinancialInstrumentsARAP.Contract AS ARAPObject,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.FinancialInstrumentsARAP AS FinancialInstrumentsARAP
		ON Cash.Recorder = FinancialInstrumentsARAP.Recorder
		AND (Cash.BusinessTransactionSetting = FinancialInstrumentsARAP.BusinessTransactionSetting
			OR FinancialInstrumentsARAP.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.EmptyRef))
		AND Cash.FinRecordID = FinancialInstrumentsARAP.FinRecordID
		AND Cash.Organization = FinancialInstrumentsARAP.AccountingDimensionByPartners.Organization
		AND Cash.ReversingEntry = FinancialInstrumentsARAP.ReversingEntry
{WHERE
	FinancialInstrumentsARAP.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	FinancialInstrumentsARAP.AccountingDimensionByPartners.Counterparty.* AS CorDimension,
	FinancialInstrumentsARAP.Contract.LineOfBusiness.* AS LineOfBusiness,
	FinancialInstrumentsARAP.AccountingDimensionByPartners.Partner.* AS Partner,
	FinancialInstrumentsARAP.AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	FinancialInstrumentsARAP.Contract.* AS Contract,
	FinancialInstrumentsARAP.Contract.* AS ARAPObject
	}</query>
