			<field xsi:type="DataSetFieldField">
				<dataPath>AdvanceHolder</dataPath>
				<field>AdvanceHolder</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.BankAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.BankAccount AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.BankAccount.CashCurrency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
INTO Cash
FROM
	AccumulationRegister.BankAccountCash AS RegisterData
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.BankAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccount.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.BankAccount.CashCurrency.* AS Currency
	}

UNION ALL

SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.CashAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.CashAccount AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.CashAccount.CashCurrency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
FROM
	AccumulationRegister.CashAccountBalance AS RegisterData
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.CashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.CashAccount.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.CashAccount.CashCurrency.* AS Currency
	}

UNION ALL

SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Contract.Department AS Department,
	RegisterData.Contract.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.Contract AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAcquirerCash) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.Currency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
FROM
	AccumulationRegister.CashInTransit AS RegisterData
WHERE
	&amp;OutputDSVPaths
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Contract.Department.* AS Department,
	RegisterData.Contract.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.Contract.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.Currency.* AS Currency
	}

INDEX BY
	Recorder,
	BusinessTransactionSetting,
	FinRecordID
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,
	AdvanceHolderCash.AdvanceHolder AS CorDimension,
	AdvanceHolderCash.AdvanceHolder AS AdvanceHolder,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	AdvanceHolder.*,
	ReceiptActual,
	WriteOffFact}
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.AdvanceHolderCash AS AdvanceHolderCash
		ON Cash.Recorder = AdvanceHolderCash.Recorder
		AND (Cash.BusinessTransactionSetting = AdvanceHolderCash.BusinessTransactionSetting
			OR AdvanceHolderCash.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.EmptyRef))	
		AND Cash.FinRecordID = AdvanceHolderCash.FinRecordID
		AND Cash.Organization = AdvanceHolderCash.Organization
		AND Cash.ReversingEntry = AdvanceHolderCash.ReversingEntry
{WHERE
	AdvanceHolderCash.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	AdvanceHolderCash.AdvanceHolder.* AS CorDimension,
	AdvanceHolderCash.AdvanceHolder.* AS AdvanceHolder}</query>
			<autoFillFields>false</autoFillFields>
		</item>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>TargetValuesRanges</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>DataForAnalysis</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DayPeriod</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(TargetValue_),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(MaximumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(MinimumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(PositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(NegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedPositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedNegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then TargetValue_ Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MaximumTargetRange Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MinimumTargetRange Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PositiveBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then NegativeBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedPositiveBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedNegativeBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptPlan</dataPath>
		<expression>IsNull(Sum(ReceiptPlan),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>ReceiptActual</dataPath>
		<expression>IsNull(Sum(ReceiptActual),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>WriteOffPlan</dataPath>
		<expression>IsNull(Sum(WriteOffPlan),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>WriteOffFact</dataPath>
		<expression>IsNull(Sum(WriteOffFact),0)</expression>
		<group>Period</group>
	</totalField>
	<parameter>
