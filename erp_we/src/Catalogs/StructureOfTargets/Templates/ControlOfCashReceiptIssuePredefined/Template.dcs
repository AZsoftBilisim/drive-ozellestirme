					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Dimension of assets/liabilities</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>بُعد دارایی‌ها/بدهی‌ها</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Analitica di attivi e passivi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Analityka aktywów pasywów</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Аналитика активов пассивов</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Varlık yükümlülük boyutu</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đối tượng phân tích tài sản nguồn vốn</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.BankAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.BankAccount AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.BankAccount.CashCurrency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
INTO Cash
FROM
	AccumulationRegister.BankAccountCash AS RegisterData
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.BankAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccount.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.BankAccount.CashCurrency.* AS Currency
	}

UNION ALL

SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.CashAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.CashAccount AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.CashAccount.CashCurrency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
FROM
	AccumulationRegister.CashAccountBalance AS RegisterData
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Department.* AS Department,
	RegisterData.CashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.CashAccount.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.CashAccount.CashCurrency.* AS Currency
	}

UNION ALL

SELECT
	CASE
		WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN VALUE(Enum.CashFlowTypes.Inpayment)
		ELSE VALUE(Enum.CashFlowTypes.WriteOff)
	END AS MovementType,
	RegisterData.Recorder AS Recorder,
	RegisterData.Period AS Period,
	RegisterData.Period AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Contract.Department AS Department,
	RegisterData.Contract.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.Contract AS CashStorageLocation,
	VALUE(Enum.CashTypes.BankAcquirerCash) AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	RegisterData.Currency AS Currency,
	RegisterData.BusinessTransactionSetting AS BusinessTransactionSetting,
	RegisterData.FinRecordID AS FinRecordID,
	RegisterData.ReversingEntry AS ReversingEntry,
	CASE &amp;ReportData
		WHEN 2
			THEN RegisterData.Sum
		WHEN 3
			THEN RegisterData.SumCompl
	END AS PayAmount
FROM
	AccumulationRegister.CashInTransit AS RegisterData
WHERE
	&amp;OutputDSVPaths
{WHERE
	RegisterData.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	RegisterData.Recorder.*,
	BEGINOFPERIOD(RegisterData.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)  AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization.* AS Organization,
	RegisterData.Contract.Department.* AS Department,
	RegisterData.Contract.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.Contract.* AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment) AS CashType,
	RegisterData.CashFlowItem.* AS CashFlowItem,
	RegisterData.Currency.* AS Currency
	}

INDEX BY
	Recorder,
	BusinessTransactionSetting,
	FinRecordID
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,

	OtherIncome.IncomeItem AS CorDimension,
	OtherIncome.LineOfBusiness AS LineOfBusiness,
	OtherIncome.Department AS IncomeExpenseBusinessUnit,
	OtherIncome.IncomeItem AS IncomeAndExpenseItem,
	OtherIncome.DimensionOfRevenue AS DimensionOfIncomeExpense,
	UNDEFINED AS AssetsLiabilitiesDimension,
	
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	IncomeExpenseBusinessUnit.*,
	IncomeAndExpenseItem.*,
	DimensionOfIncomeExpense.*,
	AssetsLiabilitiesDimension,
	ReceiptActual,
	WriteOffFact}
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.OtherIncome AS OtherIncome
		ON Cash.Recorder = OtherIncome.Recorder
		AND Cash.BusinessTransactionSetting = OtherIncome.BusinessTransactionSetting
		AND Cash.FinRecordID = OtherIncome.FinRecordID
		AND Cash.Organization = OtherIncome.Organization
		AND Cash.ReversingEntry = OtherIncome.ReversingEntry
{WHERE
	OtherIncome.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	OtherIncome.IncomeItem.* AS CorDimension,
	OtherIncome.LineOfBusiness.* AS LineOfBusiness,
	OtherIncome.Department.* AS IncomeExpenseBusinessUnit,
	OtherIncome.IncomeItem.* AS IncomeAndExpenseItem,
	OtherIncome.DimensionOfRevenue.* AS DimensionOfIncomeExpense,
	UNDEFINED AS AssetsLiabilitiesDimension
	}

UNION ALL

SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,
	
	OtherExpenses.ExpenseItem AS CorDimension,
	OtherExpenses.LineOfBusiness AS LineOfBusiness,
	OtherExpenses.Department AS IncomeExpenseBusinessUnit,
	OtherExpenses.ExpenseItem AS IncomeAndExpenseItem,
	OtherExpenses.DimensionOfExpenses AS DimensionOfIncomeExpense,
	UNDEFINED AS AssetsLiabilitiesDimension,
	
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.OtherExpenses AS OtherExpenses
		ON Cash.Recorder = OtherExpenses.Recorder
		AND Cash.BusinessTransactionSetting = OtherExpenses.BusinessTransactionSetting
		AND Cash.FinRecordID = OtherExpenses.FinRecordID
		AND Cash.Organization = OtherExpenses.Organization
		AND Cash.ReversingEntry = OtherExpenses.ReversingEntry
{WHERE
	OtherExpenses.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	OtherExpenses.ExpenseItem.* AS CorDimension,
	OtherExpenses.LineOfBusiness.* AS LineOfBusiness,
	OtherExpenses.Department.* AS IncomeExpenseBusinessUnit,
	OtherExpenses.ExpenseItem.* AS IncomeAndExpenseItem,
	OtherExpenses.DimensionOfExpenses.* AS DimensionOfIncomeExpense,
	UNDEFINED AS AssetsLiabilitiesDimension
	}
	
UNION ALL

SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.BusinessOperation AS BusinessOperation,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.LineOfBusinessCash AS LineOfBusinessCash,
	Cash.CashStorageLocation AS CashStorageLocation,
	Cash.CashType AS CashType,
	Cash.CashFlowItem AS CashFlowItem,
	Cash.Currency AS Currency,
	
	OtherAssetsAndLiabilitiesRecords.AssetRef AS CorDimension,
	OtherAssetsAndLiabilitiesRecords.LineOfBusiness AS LineOfBusiness,
	OtherAssetsAndLiabilitiesRecords.Department AS IncomeExpenseBusinessUnit,
	OtherAssetsAndLiabilitiesRecords.AssetRef AS IncomeAndExpenseItem,
	UNDEFINED AS DimensionOfIncomeExpense,
	OtherAssetsAndLiabilitiesRecords.Dimension AS AssetsLiabilitiesDimension,
	
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN Cash.PayAmount
		ELSE 0
	END AS ReceiptActual,
	CASE
		WHEN MovementType = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN -Cash.PayAmount
	END AS WriteOffFact
FROM
	Cash AS Cash
		INNER JOIN AccumulationRegister.OtherAssetsAndLiabilitiesRecords AS OtherAssetsAndLiabilitiesRecords
		ON Cash.Recorder = OtherAssetsAndLiabilitiesRecords.Recorder
		AND Cash.BusinessTransactionSetting = OtherAssetsAndLiabilitiesRecords.BusinessTransactionSetting
		AND Cash.FinRecordID = OtherAssetsAndLiabilitiesRecords.FinRecordID
		AND Cash.Organization = OtherAssetsAndLiabilitiesRecords.Organization
		AND Cash.ReversingEntry = OtherAssetsAndLiabilitiesRecords.ReversingEntry
{WHERE
	OtherAssetsAndLiabilitiesRecords.Period BETWEEN &amp;ProvidedPeriodStart AND &amp;EndOfPeriod,
	OtherAssetsAndLiabilitiesRecords.AssetRef.* AS CorDimension,
	OtherAssetsAndLiabilitiesRecords.LineOfBusiness.* AS LineOfBusiness,
	OtherAssetsAndLiabilitiesRecords.Department.* AS IncomeExpenseBusinessUnit,
	OtherAssetsAndLiabilitiesRecords.AssetRef.* AS IncomeAndExpenseItem,
	UNDEFINED AS DimensionOfIncomeExpense,
	OtherAssetsAndLiabilitiesRecords.Dimension.* AS AssetsLiabilitiesDimension
	}</query>
			<autoFillFields>false</autoFillFields>
		</item>
