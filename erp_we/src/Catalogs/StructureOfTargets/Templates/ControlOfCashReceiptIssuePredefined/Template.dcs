			<field xsi:type="DataSetFieldField">
				<dataPath>BaseCurrency</dataPath>
				<field>BaseCurrency</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency,
	CurrencyExchangeRate.CourseNumerator,
	CurrencyExchangeRate.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;DateOfCalculation}, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
;

SELECT
	RegisterData.PaymentObject                        AS Recorder,
	
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, DAY) AS DayPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, YEAR) AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.BankAccountCashAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount                 AS CashStorageLocation,
	CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.InstantPayments) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_) THEN
			VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard) THEN
			VALUE(Enum.CashTypes.BankAcquirerCash)
	END AS CashType,
	
	RegisterData.CashFlowItem       AS CashFlowItem,
	RegisterData.Currency                              AS Currency,
	
	RegisterData.PayerBeneficiary                AS CorDimension,
	
	RegisterData.PaymentObject                        AS PaymentObject,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.PlanningArea                 AS PlanningArea,
	
	CASE
		WHEN RegisterData.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) AND &amp;ReportData = 2 THEN
			RegisterData.Sum * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(ManSExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1)))
		WHEN RegisterData.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) AND &amp;ReportData = 3 THEN
			RegisterData.Sum * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1)))
		ELSE
		0
	END AS ReceiptPlan,
	CASE
		WHEN RegisterData.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff) AND &amp;ReportData = 2 THEN
			-RegisterData.Sum * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(ManSExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1)))
		WHEN RegisterData.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment) AND &amp;ReportData = 3 THEN
			-RegisterData.Sum * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1)))
		ELSE
		0
	END AS WriteOffPlan,
	
	RegisterData.ReceiptIssue                 AS MovementType
	
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	PlanningArea.*,
	ReceiptPlan,
	WriteOffPlan
}
FROM
	InformationRegister.ScheduleOfPayments AS RegisterData
	
	LEFT JOIN
		ExchangeRates AS CurrencyExchangeRate
	ON
		CurrencyExchangeRate.Currency = RegisterData.Currency
	LEFT JOIN
		ExchangeRates AS ManSExchangeRate
	ON
		ManSExchangeRate.Currency = &amp;ManagementAccountingCurrency
	LEFT JOIN
		ExchangeRates AS LocalCurrencyExchangeRate
	ON
		LocalCurrencyExchangeRate.Currency = Organization.LocalAccountingCurrency
	
WHERE
	RegisterData.PaymentDate &lt;= &amp;EndOfPeriod
{WHERE
	RegisterData.BusinessOperation.*,
	RegisterData.Organization.*,
	RegisterData.Department.*,
	RegisterData.BankAccountCashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount.* AS CashStorageLocation,
	(CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_) THEN
			VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard) THEN
			VALUE(Enum.CashTypes.BankAcquirerCash)
	END).* AS CashType,
	RegisterData.CashFlowItem.*,
	RegisterData.Currency.*,
	RegisterData.LineOfBusiness.*,
	RegisterData.PayerBeneficiary.*,
	RegisterData.PayerBeneficiary.* AS CorDimension,
	RegisterData.PaymentObject.*,
	RegisterData.PlanningArea.*,
	RegisterData.PaymentObject AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, DAY) AS DayPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, YEAR)
}

UNION ALL

SELECT // DS on the way
	RegisterData.PaymentObject                        AS Recorder,
	
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, DAY) AS DayPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, YEAR) AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	UNDEFINED                                       AS LineOfBusinessCash,
	UNDEFINED                                       AS CashStorageLocation,
	CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_) THEN
			VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard) THEN
			VALUE(Enum.CashTypes.BankAcquirerCash)
	END AS CashType,
	
	RegisterData.CashFlowItem       AS CashFlowItem,
	RegisterData.Currency                              AS Currency,
	
	RegisterData.PayerBeneficiary                AS CorDimension,
	
	RegisterData.PaymentObject                        AS PaymentObject,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.PlanningArea                 AS PlanningArea,
	
	0 AS ReceiptPlan,
	CASE &amp;ReportData
		WHEN 2 THEN
			-RegisterData.Sum * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(ManSExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1)))
		WHEN 3 THEN
			-RegisterData.Sum * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1)))
		ELSE
		0
	END AS WriteOffPlan,
	
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType
	
FROM
	InformationRegister.ScheduleOfPayments AS RegisterData
	
	LEFT JOIN
		ExchangeRates AS CurrencyExchangeRate
	ON
		CurrencyExchangeRate.Currency = RegisterData.Currency
	LEFT JOIN
		ExchangeRates AS ManSExchangeRate
	ON
		ManSExchangeRate.Currency = &amp;ManagementAccountingCurrency
	LEFT JOIN
		ExchangeRates AS LocalCurrencyExchangeRate
	ON
		LocalCurrencyExchangeRate.Currency = Organization.LocalAccountingCurrency
		
	
WHERE
	RegisterData.PaymentDate &lt;= &amp;EndOfPeriod
	AND &amp;OutputDSVPaths
	AND RegisterData.AmountType IN (
		VALUE(Enum.CashTransferKinds.CashDepositToBank),
		VALUE(Enum.CashTransferKinds.CashTransferToOtherAccount),
		VALUE(Enum.CashTransferKinds.CashCollectionFromBank_),
		VALUE(Enum.CashTransferKinds.TransferToAnotherCashAccount),
		VALUE(Enum.CashTransferKinds.CashReceiptFromBankByAcquiring)
	)
{WHERE
	RegisterData.BusinessOperation.*,
	RegisterData.Organization.*,
	RegisterData.Department.*,
	RegisterData.BankAccountCashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount.* AS CashStorageLocation,
	(CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_) THEN
			VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard) THEN
			VALUE(Enum.CashTypes.BankAcquirerCash)
	END).* AS CashType,
	RegisterData.CashFlowItem.*,
	RegisterData.Currency.*,
	RegisterData.LineOfBusiness.*,
	RegisterData.PayerBeneficiary.*,
	RegisterData.PayerBeneficiary.* AS CorDimension,
	RegisterData.PaymentObject.*,
	RegisterData.PlanningArea.*,
	RegisterData.PaymentObject AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, DAY) AS DayPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, YEAR)
}

UNION ALL

SELECT // DS on the way conversion
	RegisterData.PaymentObject                        AS Recorder,
	
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, DAY) AS DayPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, YEAR) AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	UNDEFINED                                       AS LineOfBusinessCash,
	UNDEFINED                                       AS CashStorageLocation,
	CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_) THEN
			VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard) THEN
			VALUE(Enum.CashTypes.BankAcquirerCash)
	END AS CashType,
	
	RegisterData.CashFlowItem       AS CashFlowItem,
	RegisterData.CorrespondingCurency                           AS Currency,
	
	RegisterData.PayerBeneficiary                AS CorDimension,
	
	RegisterData.PaymentObject                        AS PaymentObject,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.PlanningArea                 AS PlanningArea,
	
	0 AS ReceiptPlan,
	CASE &amp;ReportData
		WHEN 2 THEN
			-RegisterData.DocumentAmount * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(ManSExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1)))
		WHEN 3 THEN
			-RegisterData.DocumentAmount * (ISNULL(CurrencyExchangeRate.CourseNumerator, 0) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 0) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1)))
		ELSE
		0
	END AS WriteOffPlan,
	
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType
	
FROM
	InformationRegister.ScheduleOfPayments AS RegisterData
	
	LEFT JOIN
		ExchangeRates AS CurrencyExchangeRate
	ON
		CurrencyExchangeRate.Currency = RegisterData.Currency
	LEFT JOIN
		ExchangeRates AS ManSExchangeRate
	ON
		ManSExchangeRate.Currency = &amp;ManagementAccountingCurrency
	LEFT JOIN
		ExchangeRates AS LocalCurrencyExchangeRate
	ON
		LocalCurrencyExchangeRate.Currency = Organization.LocalAccountingCurrency

	
WHERE
	RegisterData.PaymentDate &lt;= &amp;EndOfPeriod
	AND &amp;OutputDSVPaths
	AND RegisterData.AmountType IN (
		VALUE(Enum.CashTransferKinds.ForeignExchangeBuying),
		VALUE(Enum.CashTransferKinds.ForeignExchangeSelling)
	)
{WHERE
	RegisterData.BusinessOperation.*,
	RegisterData.Organization.*,
	RegisterData.Department.*,
	RegisterData.BankAccountCashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount.* AS CashStorageLocation,
	(CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment) THEN
			VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_) THEN
			VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard) THEN
			VALUE(Enum.CashTypes.BankAcquirerCash)
	END).* AS CashType,
	RegisterData.CashFlowItem.*,
	RegisterData.Currency.*,
	RegisterData.LineOfBusiness.*,
	RegisterData.PayerBeneficiary.*,
	RegisterData.PayerBeneficiary.* AS CorDimension,
	RegisterData.PaymentObject.*,
	RegisterData.PlanningArea.*,
	RegisterData.PaymentObject AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, DAY) AS DayPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(
		CASE WHEN RegisterData.PaymentDate &lt; &amp;DateOfCalculation THEN
			DATEADD(&amp;DateOfCalculation, DAY, -1)
		ELSE
			RegisterData.PaymentDate
		END, YEAR)
}</query>
		</item>
