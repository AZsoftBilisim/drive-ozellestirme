		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CustomersARAPAccounting.DateOfCalculation AS DateOfCalculation,
	CustomersARAPAccounting.Organization AS Organization,
	CustomersARAPAccounting.Partner AS Partner,
	CustomersARAPAccounting.Counterparty AS Counterparty,
	CustomersARAPAccounting.MainManager AS MainManager,
	CustomersARAPAccounting.ManagerForSettlementObject AS ManagerForSettlementObject,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,	
	CustomersARAPAccounting.AmountDueClosingBalance AS AmountDueClosingBalance,
	CustomersARAPAccounting.ToShipClosingBalance AS ToShipClosingBalance,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN 1
		ELSE 0
	END AS PaymentOverdue,
	CASE
		WHEN CustomersARAPAccounting.ToShipClosingBalance &lt; 0
			THEN 1
		ELSE 0
	END AS ShipmentOverdue,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
				AND CustomersARAPAccounting.ToShipClosingBalance &lt; 0
			THEN 1
		ELSE 0
	END AS PaymentAndShipmentOverdue,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
				OR CustomersARAPAccounting.ToShipClosingBalance &lt; 0
			THEN 1
		ELSE 0
	END AS OverdueTotal,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
				AND CustomersARAPAccounting.ToShipClosingBalance &lt; 0
			THEN "OverduePaymentAndShipment"
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN "PaymentOverdue_"
		WHEN CustomersARAPAccounting.ToShipClosingBalance &lt; 0
			THEN "OverdueShipment"
	END AS State
{SELECT
	DateOfCalculation,
	Organization.*,
	Partner.*,
	Counterparty.*,
	MainManager.*,
	ManagerForSettlementObject.*,
	ARAPObject,
	AmountDueClosingBalance,
	ToShipClosingBalance,
	PaymentOverdue,
	ShipmentOverdue,
	PaymentAndShipmentOverdue,
	OverdueTotal,
	State}
FROM
	(SELECT
		&amp;DateOfCalculation AS DateOfCalculation,
		DimensionAccounting_1.Organization AS Organization,
		DimensionAccounting_1.Partner AS Partner,
		DimensionAccounting_1.Counterparty AS Counterparty,
		DimensionAccounting_1.Partner.MainManager AS MainManager,
		CustomersARAPAccounting.ARAPObject.Manager AS ManagerForSettlementObject,
		CustomersARAPAccounting.ARAPObject AS ARAPObject, 
		SUM(CustomersARAPAccounting.AmountDueClosingBalance) AS AmountDueClosingBalance,
		SUM(CustomersARAPAccounting.ToShipClosingBalance) AS ToShipClosingBalance
	{SELECT
		DateOfCalculation,
		Organization.*,
		Partner.*,
		Counterparty.*,
		MainManager.*,
		ARAPObject,
		ManagerForSettlementObject.*}
	FROM
		AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(&amp;BeginOfPeriod {(&amp;ProvidedPeriodStart)}, &amp;DateOfCalculation {(&amp;DateOfCalculation)}, Auto, , 
				AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
				{(AccountingDimensionByPartners.Organization).* AS Organization,
					(AccountingDimensionByPartners.Partner).* AS Partner,
					(AccountingDimensionByPartners.Counterparty).* AS Counterparty,
					(AccountingDimensionByPartners.Partner.MainManager).* AS MainManager,
					(ARAPObject.Manager).* AS ManagerForSettlementObject,
					(Currency) AS ARAPCurrency
				}
		) AS CustomersARAPAccounting
			{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
			ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
	
	GROUP BY
		DimensionAccounting_1.Organization,
		DimensionAccounting_1.Partner,
		DimensionAccounting_1.Counterparty,
		DimensionAccounting_1.Partner.MainManager,
		CustomersARAPAccounting.ARAPObject.Manager,
		CustomersARAPAccounting.ARAPObject) AS CustomersARAPAccounting
WHERE
	(CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			OR CustomersARAPAccounting.ToShipClosingBalance &lt; 0)
{WHERE
	(CASE
			WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
				THEN 1
			ELSE 0
		END) AS PaymentOverdue,
	(CASE
			WHEN CustomersARAPAccounting.ToShipClosingBalance &lt; 0
				THEN 1
			ELSE 0
		END) AS ShipmentOverdue,
	(CASE
			WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
					AND CustomersARAPAccounting.ToShipClosingBalance &lt; 0
				THEN 1
			ELSE 0
		END) AS PaymentAndShipmentOverdue,
	(CASE
			WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
					OR CustomersARAPAccounting.ToShipClosingBalance &lt; 0
				THEN 1
			ELSE 0
		END) AS OverdueTotal,
	(CASE
			WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
					AND CustomersARAPAccounting.ToShipClosingBalance = 0
				THEN "PaymentOverdue_"
			WHEN CustomersARAPAccounting.AmountDueClosingBalance = 0
					AND CustomersARAPAccounting.ToShipClosingBalance &lt; 0
				THEN "OverdueShipment"
			WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
					AND CustomersARAPAccounting.ToShipClosingBalance &lt; 0
				THEN "OverduePaymentAndShipment"
		END) AS State}</query>
	</dataSet>
