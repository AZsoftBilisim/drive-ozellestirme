				<dataPath>Lot</dataPath>
				<field>Lot</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LotVendorAttributes</dataPath>
				<field>LotVendorAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>VATActivityType</dataPath>
				<field>VATActivityType</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>DeleteARAPObjectPurchaseOrder</dataPath>
				<field>DeleteARAPObjectPurchaseOrder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPObject</dataPath>
				<field>ARAPObject</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BaseCurrency</dataPath>
				<field>BaseCurrency</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Jobs.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	MIN(DATEADD(Jobs.Month, DAY, -1)) AS CurrentPeriod_,
	TRUE AS PaymentsAreIrrelevant
INTO Boundaries
FROM
	InformationRegister.JobsForAllocatingCustomersARAP AS Jobs
GROUP BY
	Jobs.AccountingDimensionByPartners
INDEX BY
	AccountingDimensionByPartners
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DimensionByPartners.Organization AS Organization,
	SUM(Sales.RevenueAmountTurnover) AS RevenueForThePeriod,
	&amp;DateOfCalculation
INTO RevenueCalculation
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, ) AS Sales
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON Sales.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
WHERE
	(&amp;ShowSales_ = 1
				AND DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 2
				AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 0)
{WHERE
	DimensionByPartners.Organization.* AS Organization,
	DimensionByPartners.Partner.* AS Partner}

GROUP BY
	DimensionByPartners.Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DebtCalculation.Organization AS Organization,
	DebtCalculation.Currency AS Currency,
	DebtCalculation.CustomerAccountsReceivable AS CustomerAccountsReceivable,
	DebtCalculation.DateOfCalculation AS DateOfCalculation,
	RevenueCalculation.RevenueForThePeriod AS RevenueForDZPeriod,
	DATEDIFF(&amp;ProvidedPeriodStart, ENDOFPERIOD(&amp;DateOfCalculation, DAY), DAY) AS NumberOfDaysOfDZCalculation
FROM
	(SELECT
		DimensionAccounting_1.Organization AS Organization,
		CASE
			WHEN &amp;SettlementCurrency = VALUE(Catalog.Currencies.EmptyRef)
				THEN CustomersARAPAccounting.Currency
			ELSE &amp;SettlementCurrency
		END AS Currency,
		SUM(CASE
				WHEN (NOT Boundaries.PaymentsAreIrrelevant IS NULL )
					THEN CASE
							WHEN CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
								THEN CAST(CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2))
							ELSE 0
						END
				ELSE CAST(CustomersARAPAccountingByDocuments.DebtClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2))
			END) AS CustomerAccountsReceivable,
		&amp;DateOfCalculation AS DateOfCalculation
	FROM
		AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CustomersARAPAccounting
			LEFT JOIN AccumulationRegister.CustomersARAPAccountingByDocuments.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CustomersARAPAccountingByDocuments
			ON CustomersARAPAccounting.AccountingDimensionByPartners = CustomersARAPAccountingByDocuments.AccountingDimensionByPartners
				AND CustomersARAPAccounting.ARAPObject = CustomersARAPAccountingByDocuments.SalesOrder
				AND CustomersARAPAccounting.Currency = CustomersARAPAccountingByDocuments.Currency
			{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
			ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
			LEFT JOIN Boundaries AS Boundaries
			ON CustomersARAPAccounting.AccountingDimensionByPartners = Boundaries.AccountingDimensionByPartners
			LEFT JOIN ExchangeRates AS ExchangeRates
			ON CustomersARAPAccounting.Currency = ExchangeRates.Currency
	WHERE
		DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	
	GROUP BY
		DimensionAccounting_1.Organization,
		CASE
			WHEN &amp;SettlementCurrency = VALUE(Catalog.Currencies.EmptyRef)
				THEN CustomersARAPAccounting.Currency
			ELSE &amp;SettlementCurrency
		END) AS DebtCalculation
		LEFT JOIN RevenueCalculation AS RevenueCalculation
		ON DebtCalculation.Organization = RevenueCalculation.Organization</query>
		</item>
