			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CASE
		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
			THEN "GoodsInStock"
		ELSE "GoodsTransferredToCommissionAgent"
	END AS Factor,
	CostAccounting_.Organization AS Organization,
	CostAccounting_.ItemsLocationAttributes.StorageLocation AS Warehouse,
	CostAccounting_.CostClosingBalance + CostAccounting_.AddExpensesForGoodsClosingBalance AS SumClosingBalance,
	CostAccounting_.ItemsLocationAttributes.Products AS Products,
	CostAccounting_.ItemsLocationAttributes.Characteristic AS Characteristic
INTO WorkingCapital
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CostAccounting_
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SUM(Table.Cost_) + SUM(Table.AddExpensesForGoods) AS CostExpense,
	Table.Organization AS Organization,
	Table.Warehouse AS Warehouse,
	Table.Products,
	Table.Characteristic
INTO CostOfGoodsSold
FROM
	(SELECT
		Sales.AccountingDimensionByPartners.Organization AS Organization,
		Sales.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		Sales.Department AS Department,
		Sales.ItemsLocationAttributes.StorageLocation AS Warehouse,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN Sales.RevenueAmountTurnover
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.Cost, 0) AS NUMBER(31,2))
			ELSE Sales.CostTurnover
		END AS Cost_,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) AS NUMBER(31,2))
			ELSE Sales.AddExpensesForGoodsTurnover
		END AS AddExpensesForGoods,
		Sales.DayPeriod AS DayPeriod,
		Sales.WeekPeriod AS WeekPeriod,
		Sales.TenDaysPeriod AS TenDaysPeriod,
		Sales.MonthPeriod AS MonthPeriod,
		Sales.QuarterPeriod AS QuarterPeriod,
		Sales.HalfYearPeriod AS HalfYearPeriod,
		Sales.YearPeriod AS YearPeriod,
		Sales.ItemsLocationAttributes.Products AS Products,
		Sales.ItemsLocationAttributes.Characteristic AS Characteristic
	{SELECT
		Department.*,
		Warehouse.*,
		Organization.*,
		InventoryOwnerAttribute.*,
		DayPeriod,
		WeekPeriod,
		TenDaysPeriod,
		MonthPeriod,
		QuarterPeriod,
		HalfYearPeriod,
		YearPeriod}
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, ) AS Sales
			{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
			ON Sales.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
				AND (Sales.AccountingDimensionByPartners.Organization = CostOfProducts.Organization)
				AND Sales.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
				AND (CostOfProducts.Period = BEGINOFPERIOD(Sales.MonthPeriod, MONTH))}
			LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculationOfCost
			ON (BEGINOFPERIOD(Sales.MonthPeriod, MONTH) = BEGINOFPERIOD(CalculationOfCost.Ref.Date, MONTH))
				AND (Sales.AccountingDimensionByPartners.Organization = CalculationOfCost.Organization)
				AND (CalculationOfCost.Ref.Posted)
	WHERE
		Sales.AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	{WHERE
		Sales.ItemsLocationAttributes.Products.* AS Products,
		Sales.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		Sales.AccountingDimensionByPartners.Organization.* AS Organization,
		Sales.ItemsLocationAttributes.StorageLocation.* AS Warehouse,
		Sales.Department.* AS Department,
		Sales.InventoryOwnerAttribute.* AS InventoryOwnerAttribute}) AS Table

GROUP BY
	Table.Organization,
	Table.Warehouse,
	Table.Products,
	Table.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DataForCalculation.Organization AS Organization,
	DataForCalculation.Warehouse AS Warehouse,
	SUM(DataForCalculation.CostClosingBalance) AS CostOfInventoryBalances,
	DataForCalculation.DateOfCalculation,
	SUM(DataForCalculation.CostExpense) AS CostOfGoodsSold,
	DATEDIFF(&amp;ProvidedPeriodStart, ENDOFPERIOD(&amp;DateOfCalculation, DAY), DAY) AS DaysInPeriodByStock
FROM
	(SELECT
		WorkingCapital.Organization AS Organization,
		WorkingCapital.Warehouse AS Warehouse,
		SUM(WorkingCapital.SumClosingBalance) AS CostClosingBalance,
		&amp;DateOfCalculation AS DateOfCalculation,
		0 AS CostExpense
	FROM
		WorkingCapital AS WorkingCapital
	
	GROUP BY
		WorkingCapital.Organization,
		WorkingCapital.Warehouse
	
	HAVING
		SUM(WorkingCapital.SumClosingBalance) &lt;&gt; 0
	
	UNION ALL
	
	SELECT
		CostOfGoodsSold.Organization,
		CostOfGoodsSold.Warehouse,
		0,
		&amp;DateOfCalculation,
		SUM(CostOfGoodsSold.CostExpense)
	FROM
		CostOfGoodsSold AS CostOfGoodsSold
	
	GROUP BY
		CostOfGoodsSold.Warehouse,
		CostOfGoodsSold.Organization) AS DataForCalculation

GROUP BY
	DataForCalculation.Organization,
	DataForCalculation.Warehouse,
	DataForCalculation.DateOfCalculation</query>
		</item>
