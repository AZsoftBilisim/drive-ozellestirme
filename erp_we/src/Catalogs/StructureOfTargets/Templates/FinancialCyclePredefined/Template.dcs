	<totalField>
		<dataPath>FinancialCycle</dataPath>
		<expression>(Case When IsNull(Sum(CostOfGoodsSold),0) = 0 Then
0
Else
Avg(DaysInPeriodByStock) * Case When EvalExpression("Sum(Case When IsNull(CostOfInventoryBalances,0) = 0 Then 0 Else 1 End)",,,"First", "Current") = 0 Then 0 Else (EvalExpression("IsNull(Sum(CostOfInventoryBalances),0)",,, "First", "Current") - 0.5 * EvalExpression("IsNull(Sum(CostOfInventoryBalances),0)",,, "First", "First", "Period Desc")
- 0.5 * EvalExpression("IsNull(Sum(CostOfInventoryBalances),0)",,, "Current", "Current"))/EvalExpression("Sum(Case When IsNull(CostOfInventoryBalances,0) = 0 Then 0 Else 1 End)",,,"First", "Current") End / IsNull(Sum(CostOfGoodsSold),0)
End 

+ Case When IsNull(Sum(RevenueForDZPeriod),0) = 0 Then
0
Else
Avg(NumberOfDaysOfDZCalculation) 
*
Case 
When EvalExpression("Sum(Case When IsNull(CustomerAccountsReceivable,0) = 0 Then 0 Else 1 End)",,,"First", "Current") = 0 
Then 0 
Else 
(EvalExpression("IsNull(Sum(CustomerAccountsReceivable),0)",,, "First", "Current") 
- 0.5 * EvalExpression("IsNull(Sum(CustomerAccountsReceivable),0)",,, "First", "First", "Period Desc")
- 0.5 * EvalExpression("IsNull(Sum(CustomerAccountsReceivable),0)",,, "Current", "Current")
)/ EvalExpression("Sum(Case When IsNull(CustomerAccountsReceivable,0) = 0 Then 0 Else 1 End)",,,"First", "Current") 
End / 
IsNull(Sum(RevenueForDZPeriod),0)
End

- Case When IsNull(Sum(RevenueForKZPeriod),0) = 0 Then
0
Else
Avg(NumberOfDaysOfKZCalculation) * IsNull(Sum(AccountsPayableOfCompany),0) / IsNull(Sum(RevenueForKZPeriod),0)
End)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>FinancialCycle</dataPath>
		<expression>TargetValueMonitoring.GetLastArrayValue(EvalExpressionWithGroupArray(
"Case When IsNull(Sum(CostOfGoodsSold),0) = 0 Then
0
Else
Avg(DaysInPeriodByStock) * 
Case When EvalExpression(""Sum(Case When IsNull(CostOfInventoryBalances,0) = 0 Then 0 Else 1 End)"",,,""First"", ""Current"") = 0 
Then 0 
Else 
(EvalExpression(""IsNull(Sum(CostOfInventoryBalances),0)"",,, ""First"", ""Current"") - 0.5 * EvalExpression(""IsNull(Sum(CostOfInventoryBalances),0)"",,, ""First"", ""First"", ""Period Desc"")
- 0.5 * EvalExpression(""IsNull(Sum(CostOfInventoryBalances),0)"",,, ""Current"", ""Current""))
/EvalExpression(""Sum(Case When IsNull(CostOfInventoryBalances,0) = 0 Then 0 Else 1 End)"",,,""First"", ""Current"") End / IsNull(Sum(CostOfGoodsSold),0)
End", "Period"))

+ 
TargetValueMonitoring.GetLastArrayValue(
EvalExpressionWithGroupArray(
"Case When IsNull(Sum(RevenueForDZPeriod),0) = 0 
Then 0
Else
Avg(NumberOfDaysOfDZCalculation) 
* 
Case 
When EvalExpression(""Sum(Case When IsNull(CustomerAccountsReceivable,0) = 0 Then 0 Else 1 End)"",,,""First"", ""Current"") = 0 
Then 0 
Else 
(EvalExpression(""IsNull(Sum(CustomerAccountsReceivable),0)"",,, ""First"", ""Current"") 
- 0.5 * EvalExpression(""IsNull(Sum(CustomerAccountsReceivable),0)"",,, ""First"", ""First"", ""Period Desc"")
- 0.5 * EvalExpression(""IsNull(Sum(CustomerAccountsReceivable),0)"",,, ""Current"", ""Current""))
/EvalExpression(""Sum(Case When IsNull(CustomerAccountsReceivable,0) = 0 Then 0 Else 1 End)"",,,""First"", ""Current"") End 
/ IsNull(Sum(RevenueForDZPeriod),0)
End", "Period"))

-
Case When IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then RevenueForKZPeriod Else 0 End),0) = 0 Then
0
Else
Max(NumberOfDaysOfKZCalculation) * 
IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AccountsPayableOfCompany Else 0 End),0) 
/ IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then RevenueForKZPeriod Else 0 End),0)
End</expression>
		<group>Organization</group>
	</totalField>
