			<field xsi:type="DataSetFieldField">
				<dataPath>DeletePurchaseOrder</dataPath>
				<field>DeletePurchaseOrder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BaseCurrency</dataPath>
				<field>BaseCurrency</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AccountingDimensionByPartners.DimensionKey,
	AccountingDimensionByPartners.Organization,
	AccountingDimensionByPartners.Partner
INTO DimensionAccounting_1
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	VendorsARAPAccountingBalanceAndTurnovers.Period AS Period,
	SUM(-VendorsARAPAccountingBalanceAndTurnovers.AmountDueClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1)) AS AmountDue,
	DimensionAccounting_1.Organization
INTO VendorsARAPAccounting
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(&amp;ProvidedPeriodStart, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Day, , ) AS VendorsARAPAccountingBalanceAndTurnovers
		LEFT JOIN DimensionAccounting_1 AS DimensionAccounting_1
		ON VendorsARAPAccountingBalanceAndTurnovers.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON VendorsARAPAccountingBalanceAndTurnovers.Currency = ExchangeRates.Currency

GROUP BY
	VendorsARAPAccountingBalanceAndTurnovers.Period,
	DimensionAccounting_1.Organization

INDEX BY
	Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SUM(RevenueAndCostOfSalesTurnover.RevenueAmountTurnover) AS RevenueAmountTurnover,
	DimensionAccounting_1.Organization
INTO RevenueCalculation
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, ) AS RevenueAndCostOfSalesTurnover
		LEFT JOIN DimensionAccounting_1 AS DimensionAccounting_1
		ON RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey
WHERE
	(&amp;ShowSales_ = 1
				AND DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 2
				AND DimensionAccounting_1.Partner = VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 0)

GROUP BY
	DimensionAccounting_1.Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	VendorsARAPAccounting.Organization,
	RevenueCalculation.RevenueAmountTurnover AS RevenueForKZPeriod,
	VendorsARAPAccounting.AmountDue AS AccountsPayableOfCompany,
	DATEDIFF(&amp;ProvidedPeriodStart, ENDOFPERIOD(&amp;DateOfCalculation, DAY), DAY) AS NumberOfDaysOfKZCalculation
FROM
	VendorsARAPAccounting AS VendorsARAPAccounting
		LEFT JOIN RevenueCalculation AS RevenueCalculation
		ON VendorsARAPAccounting.Organization = RevenueCalculation.Organization</query>
		</item>
