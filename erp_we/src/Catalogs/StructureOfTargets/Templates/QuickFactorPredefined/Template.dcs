		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;ManagementAccountingCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;DateOfCalculation AS DateOfCalculation,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	VendorsARAPAccounting.ARAPObject.Object AS PurchaseOrder,
	NULL AS SalesOrder,
	VendorsARAPAccounting.DayPeriod,
	VendorsARAPAccounting.WeekPeriod,
	VendorsARAPAccounting.TenDaysPeriod,
	VendorsARAPAccounting.MonthPeriod,
	VendorsARAPAccounting.QuarterPeriod,
	VendorsARAPAccounting.HalfYearPeriod,
	VendorsARAPAccounting.YearPeriod,
	DimensionAccounting_1.Organization AS Organization,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		ELSE 0
	END AS AccountsPayableOfCompanyClosingBalance,
	CASE
		WHEN VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		ELSE 0
	END AS AccountsPayableOfCompanyOpeningBalance,
	0 AS Cash_1OpeningBalance,
	0 AS Cash_1ClosingBalance,
	0 AS DZOpeningBalance,
	0 AS DZClosingBalance
{SELECT
	Organization.*,
	AccountsPayableOfCompanyClosingBalance,
	AccountsPayableOfCompanyOpeningBalance,
	DateOfCalculation}
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, ,
		{(AccountingDimensionByPartners.Organization).* AS Organization}
	) AS VendorsARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
		ON VendorsARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON VendorsARAPAccounting.Currency = ExchangeRates.Currency
WHERE
	DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	&amp;DateOfCalculation,
	NULL,
	NULL,
	NULL,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.Organization,
	0,
	0,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance,
	0,
	0
FROM
	AccumulationRegister.BankAccountCash.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , ) AS Cash
{WHERE
	Cash.Organization.*,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance}

UNION ALL

SELECT
	&amp;DateOfCalculation,
	NULL,
	NULL,
	NULL,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.Organization,
	0,
	0,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance,
	0,
	0
FROM
	AccumulationRegister.CashAccountBalance.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , ) AS Cash
{WHERE
	Cash.Organization.*,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance}

UNION ALL

SELECT
	&amp;DateOfCalculation,
	NULL,
	NULL,
	NULL,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.Organization,
	0,
	0,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance,
	0,
	0
FROM
	AccumulationRegister.CashInCashRegistersCR.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , ) AS Cash
{WHERE
	Cash.Organization.*,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance}

UNION ALL

SELECT
	&amp;DateOfCalculation,
	NULL,
	NULL,
	NULL,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.Organization,
	0,
	0,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance,
	0,
	0
FROM
	AccumulationRegister.AdvanceHolderCash.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , ) AS Cash
{WHERE
	Cash.Organization.*,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance}

UNION ALL

SELECT
	&amp;DateOfCalculation,
	CustomersARAPAccounting.ARAPObject,
	NULL,
	CustomersARAPAccounting.ARAPObject.Object,
	CustomersARAPAccounting.DayPeriod,
	CustomersARAPAccounting.WeekPeriod,
	CustomersARAPAccounting.TenDaysPeriod,
	CustomersARAPAccounting.MonthPeriod,
	CustomersARAPAccounting.QuarterPeriod,
	CustomersARAPAccounting.HalfYearPeriod,
	CustomersARAPAccounting.YearPeriod,
	DimensionAccounting_1.Organization,
	0,
	0,
	0,
	0,
	CASE
		WHEN CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		ELSE 0
	END,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		ELSE 0
	END
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, ,
		{(AccountingDimensionByPartners.Organization).* AS Organization}
	) AS CustomersARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
		ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON CustomersARAPAccounting.Currency = ExchangeRates.Currency
WHERE
	DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)</query>
	</dataSet>
