	<totalField>
		<dataPath>PlanAmount</dataPath>
		<expression>IsNull(Sum(PlanAmount),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>PlanAmount</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PlanAmount Else 0 End),0)</expression>
		<group>AnalyticalGroup</group>
		<group>Products</group>
		<group>Partner</group>
		<group>Department</group>
		<group>Warehouse</group>
		<group>ProductGroup</group>
		<group>ProductCategory</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>ActualAmount</dataPath>
		<expression>IsNull(Sum(ActualAmount),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>ActualAmount</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then ActualAmount Else 0 End),0)</expression>
		<group>AnalyticalGroup</group>
		<group>Products</group>
		<group>Partner</group>
		<group>Department</group>
		<group>Warehouse</group>
		<group>ProductGroup</group>
		<group>ProductCategory</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>PlanExecution</dataPath>
		<expression>Case When &amp;PlanFulfillmentEvaluation = 1 
Then 100 * (Case When Sum(PlanAmount) = 0 Then 0 Else Sum(ActualAmount) / Sum(PlanAmount) End)
Else 100 * (Case When Sum(PlanQuantity) = 0 Then 0 Else Sum(FactQuantity) / Sum(PlanQuantity) End)
End</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>PlanExecution</dataPath>
		<expression>Case When &amp;PlanFulfillmentEvaluation = 1 
Then 
100 * (Case 
		When IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PlanAmount Else 0 End),0) = 0 
		Then 0 
		Else IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then ActualAmount Else 0 End),0) / 
			IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PlanAmount Else 0 End),0) 
		End)
Else 
100 * (Case 
		When IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PlanQuantity Else 0 End),0) = 0 
		Then 0 
		Else IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then FactQuantity Else 0 End),0) / 
			IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PlanQuantity Else 0 End),0) 
		End)
End</expression>
		<group>AnalyticalGroup</group>
		<group>Products</group>
		<group>Partner</group>
		<group>Department</group>
		<group>Warehouse</group>
		<group>ProductGroup</group>
		<group>ProductCategory</group>
		<group>Characteristic</group>
	</totalField>
