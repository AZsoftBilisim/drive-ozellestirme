		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	PurchasePlansTurnovers.Partner AS Partner,
	PurchasePlansTurnovers.Department AS Department,
	PurchasePlansTurnovers.Warehouse AS Warehouse,
	PurchasePlansTurnovers.Products.Parent AS ProductGroup,
	PurchasePlansTurnovers.Products.ProductCategory AS ProductCategory,
	PurchasePlansTurnovers.Products.AnalyticalGroup AS AnalyticalGroup,
	PurchasePlansTurnovers.Products AS Products,
	PurchasePlansTurnovers.Characteristic AS Characteristic,
	SUM(PurchasePlansTurnovers.CountTurnover) AS Count,
	SUM(PurchasePlansTurnovers.SumTurnover) AS Sum,
	PurchasePlansTurnovers.DayPeriod,
	PurchasePlansTurnovers.WeekPeriod,
	PurchasePlansTurnovers.TenDaysPeriod,
	PurchasePlansTurnovers.MonthPeriod,
	PurchasePlansTurnovers.QuarterPeriod,
	PurchasePlansTurnovers.HalfYearPeriod,
	PurchasePlansTurnovers.YearPeriod
INTO PurchasePlan
FROM
	AccumulationRegister.PurchasePlans.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, Scenario = &amp;Scenario {(Partner).* AS Partner, (Department).* AS Department, (Warehouse).* AS Warehouse, (Products).* AS Products, (Characteristic).* AS Characteristic}) AS PurchasePlansTurnovers

GROUP BY
	PurchasePlansTurnovers.DayPeriod,
	PurchasePlansTurnovers.WeekPeriod,
	PurchasePlansTurnovers.TenDaysPeriod,
	PurchasePlansTurnovers.MonthPeriod,
	PurchasePlansTurnovers.QuarterPeriod,
	PurchasePlansTurnovers.HalfYearPeriod,
	PurchasePlansTurnovers.YearPeriod,
	PurchasePlansTurnovers.Partner,
	PurchasePlansTurnovers.Department,
	PurchasePlansTurnovers.Warehouse,
	PurchasePlansTurnovers.Products.Parent,
	PurchasePlansTurnovers.Products.ProductCategory,
	PurchasePlansTurnovers.Products,
	PurchasePlansTurnovers.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;ProvidedPeriodStart AS Period,
	CurrencyRatesCut.Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;ProvidedPeriodStart, Currency IN (&amp;ManagementAccountingCurrency, &amp;ScenarioCurrency) AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
WHERE
	&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency
	AND ExchangeRates.Period &gt; &amp;ProvidedPeriodStart
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND ExchangeRates.Currency IN (&amp;ManagementAccountingCurrency, &amp;ScenarioCurrency)
	AND BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	CurrencyRatesCut.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PurchasesTurnovers.Partner AS Partner,
	PurchasesTurnovers.Department AS Department,
	PurchasesTurnovers.Warehouse AS Warehouse,
	PurchasesTurnovers.ItemsLocationAttributes.Products.Parent AS ProductGroup,
	PurchasesTurnovers.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	PurchasesTurnovers.ItemsLocationAttributes.Products.AnalyticalGroup AS AnalyticalGroup,
	PurchasesTurnovers.ItemsLocationAttributes.Products AS Products,
	PurchasesTurnovers.ItemsLocationAttributes.Characteristic AS Characteristic,
	SUM(PurchasesTurnovers.CountTurnover) AS FactQuantity,
	SUM(CAST(PurchasesTurnovers.SumTurnover * CASE
				WHEN &amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency
					THEN CASE
							WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
									AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
									AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
									AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
								THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
							ELSE 0
						END
				ELSE 1
			END AS NUMBER(31, 2))) AS ActualAmount,
	PurchasesTurnovers.DayPeriod,
	PurchasesTurnovers.WeekPeriod,
	PurchasesTurnovers.TenDaysPeriod,
	PurchasesTurnovers.MonthPeriod,
	PurchasesTurnovers.QuarterPeriod,
	PurchasesTurnovers.HalfYearPeriod,
	PurchasesTurnovers.YearPeriod
INTO Purchases
FROM
	AccumulationRegister.Purchases.Turnovers(
			&amp;ProvidedPeriodStart,
			&amp;EndOfPeriod,
			Auto,
			ItemsLocationAttributes IN
				(SELECT DISTINCT
					ItemsLocationAttributes.DimensionKey
				FROM
					PurchasePlan AS PurchasePlan
						INNER JOIN InformationRegister.ItemsLocationAttributes AS ItemsLocationAttributes
						ON
							PurchasePlan.Products = ItemsLocationAttributes.Products
								AND PurchasePlan.Characteristic = ItemsLocationAttributes.Characteristic) {(Partner).* AS Partner, (Department).* AS Department, (Warehouse).* AS Warehouse, (ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic}) AS PurchasesTurnovers
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (ManSExchangeRates.Currency = &amp;ManagementAccountingCurrency)
			AND PurchasesTurnovers.DayPeriod = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND PurchasesTurnovers.DayPeriod = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = &amp;ManagementAccountingCurrency)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;ProvidedPeriodStart)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (&amp;ManagementAccountingCurrency &lt;&gt; &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;ProvidedPeriodStart)

GROUP BY
	PurchasesTurnovers.Partner,
	PurchasesTurnovers.Department,
	PurchasesTurnovers.Warehouse,
	PurchasesTurnovers.ItemsLocationAttributes.Products.Parent,
	PurchasesTurnovers.ItemsLocationAttributes.Products.ProductCategory,
	PurchasesTurnovers.ItemsLocationAttributes.Products,
	PurchasesTurnovers.ItemsLocationAttributes.Characteristic,
	PurchasesTurnovers.DayPeriod,
	PurchasesTurnovers.WeekPeriod,
	PurchasesTurnovers.TenDaysPeriod,
	PurchasesTurnovers.MonthPeriod,
	PurchasesTurnovers.QuarterPeriod,
	PurchasesTurnovers.HalfYearPeriod,
	PurchasesTurnovers.YearPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
INTO TTPlanProducts
FROM
	PurchasePlan AS Table

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DayPeriod AS DayPeriod,
	NestedQuery.WeekPeriod AS WeekPeriod,
	NestedQuery.TenDaysPeriod AS TenDaysPeriod,
	NestedQuery.MonthPeriod AS MonthPeriod,
	NestedQuery.QuarterPeriod AS QuarterPeriod,
	NestedQuery.HalfYearPeriod AS HalfYearPeriod,
	NestedQuery.YearPeriod AS YearPeriod,
	NestedQuery.Partner AS Partner,
	NestedQuery.Department AS Department,
	NestedQuery.Warehouse AS Warehouse,
	NestedQuery.Products.Parent AS ProductGroup,
	NestedQuery.Products.ProductCategory AS ProductCategory,
	NestedQuery.AnalyticalGroup,
	NestedQuery.Products AS Products,
	NestedQuery.Characteristic AS Characteristic,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.PlanAmount) AS PlanAmount,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.ActualAmount) AS ActualAmount,
	MAX(NestedQuery.PartnerPlan) AS PartnerPlan,
	MAX(NestedQuery.DepartmentPlan) AS DepartmentPlan,
	MAX(NestedQuery.WarehousePlan) AS WarehousePlan
INTO ProcurementPlanFact
FROM
	(SELECT
		PurchasePlan.DayPeriod AS DayPeriod,
		PurchasePlan.WeekPeriod AS WeekPeriod,
		PurchasePlan.TenDaysPeriod AS TenDaysPeriod,
		PurchasePlan.MonthPeriod AS MonthPeriod,
		PurchasePlan.QuarterPeriod AS QuarterPeriod,
		PurchasePlan.HalfYearPeriod AS HalfYearPeriod,
		PurchasePlan.YearPeriod AS YearPeriod,
		PurchasePlan.Partner AS Partner,
		PurchasePlan.Department AS Department,
		PurchasePlan.Warehouse AS Warehouse,
		PurchasePlan.Products.Parent AS ProductGroup,
		PurchasePlan.Products.ProductCategory AS ProductCategory,
		PurchasePlan.AnalyticalGroup AS AnalyticalGroup,
		PurchasePlan.Products AS Products,
		PurchasePlan.Characteristic AS Characteristic,
		PurchasePlan.Count AS PlanQuantity,
		PurchasePlan.Sum AS PlanAmount,
		0 AS FactQuantity,
		0 AS ActualAmount,
		PurchasePlan.Partner AS PartnerPlan,
		PurchasePlan.Department AS DepartmentPlan,
		PurchasePlan.Warehouse AS WarehousePlan
	FROM
		PurchasePlan AS PurchasePlan
	
	UNION ALL
	
	SELECT
		Purchases.DayPeriod,
		Purchases.WeekPeriod,
		Purchases.TenDaysPeriod,
		Purchases.MonthPeriod,
		Purchases.QuarterPeriod,
		Purchases.HalfYearPeriod,
		Purchases.YearPeriod,
		Purchases.Partner,
		Purchases.Department,
		Purchases.Warehouse,
		Purchases.Products.Parent,
		Purchases.Products.ProductCategory,
		Purchases.AnalyticalGroup,
		Purchases.Products,
		Purchases.Characteristic,
		0,
		0,
		Purchases.FactQuantity,
		Purchases.ActualAmount,
		VALUE(Catalog.Partners.EmptyRef),
		VALUE(Catalog.BusinessStructure.EmptyRef),
		VALUE(Catalog.Warehouses.EmptyRef)
	FROM
		Purchases AS Purchases) AS NestedQuery

GROUP BY
	NestedQuery.DayPeriod,
	NestedQuery.WeekPeriod,
	NestedQuery.TenDaysPeriod,
	NestedQuery.MonthPeriod,
	NestedQuery.QuarterPeriod,
	NestedQuery.HalfYearPeriod,
	NestedQuery.YearPeriod,
	NestedQuery.Partner,
	NestedQuery.Department,
	NestedQuery.Warehouse,
	NestedQuery.Products.Parent,
	NestedQuery.Products.ProductCategory,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.AnalyticalGroup
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProcurementPlanFact.DayPeriod,
	ProcurementPlanFact.WeekPeriod,
	ProcurementPlanFact.TenDaysPeriod,
	ProcurementPlanFact.MonthPeriod,
	ProcurementPlanFact.QuarterPeriod,
	ProcurementPlanFact.HalfYearPeriod,
	ProcurementPlanFact.YearPeriod,
	CASE
		WHEN ProcurementPlanFact.PartnerPlan = VALUE(Catalog.Partners.EmptyRef)
			THEN VALUE(Catalog.Partners.EmptyRef)
		ELSE ProcurementPlanFact.Partner
	END AS Partner,
	CASE
		WHEN ProcurementPlanFact.DepartmentPlan = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		ELSE ProcurementPlanFact.Department
	END AS Department,
	CASE
		WHEN ProcurementPlanFact.WarehousePlan = VALUE(Catalog.Warehouses.EmptyRef)
			THEN VALUE(Catalog.Warehouses.EmptyRef)
		ELSE ProcurementPlanFact.Warehouse
	END AS Warehouse,
	ProcurementPlanFact.Products.Parent AS ProductGroup,
	ProcurementPlanFact.Products.ProductCategory AS ProductCategory,
	ProcurementPlanFact.AnalyticalGroup,
	ProcurementPlanFact.Products AS Products,
	ProcurementPlanFact.Characteristic AS Characteristic,
	SUM(ProcurementPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(ProcurementPlanFact.PlanAmount) AS PlanAmount,
	SUM(ProcurementPlanFact.FactQuantity) AS FactQuantity,
	SUM(ProcurementPlanFact.ActualAmount) AS ActualAmount
FROM
	ProcurementPlanFact AS ProcurementPlanFact

GROUP BY
	ProcurementPlanFact.DayPeriod,
	ProcurementPlanFact.WeekPeriod,
	ProcurementPlanFact.TenDaysPeriod,
	ProcurementPlanFact.MonthPeriod,
	ProcurementPlanFact.QuarterPeriod,
	ProcurementPlanFact.HalfYearPeriod,
	ProcurementPlanFact.YearPeriod,
	ProcurementPlanFact.Products.Parent,
	ProcurementPlanFact.Products.ProductCategory,
	ProcurementPlanFact.Products,
	ProcurementPlanFact.Characteristic,
	ProcurementPlanFact.AnalyticalGroup,
	CASE
		WHEN ProcurementPlanFact.PartnerPlan = VALUE(Catalog.Partners.EmptyRef)
			THEN VALUE(Catalog.Partners.EmptyRef)
		ELSE ProcurementPlanFact.Partner
	END,
	CASE
		WHEN ProcurementPlanFact.DepartmentPlan = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		ELSE ProcurementPlanFact.Department
	END,
	CASE
		WHEN ProcurementPlanFact.WarehousePlan = VALUE(Catalog.Warehouses.EmptyRef)
			THEN VALUE(Catalog.Warehouses.EmptyRef)
		ELSE ProcurementPlanFact.Warehouse
	END</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>TargetValuesRanges</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>DataForAnalysis</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DayPeriod</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>PlanExecution</dataPath>
		<expression>Case When &amp;PlanFulfillmentEvaluation = 1 
Then
100 * (Case When PlanAmount = 0 
Then 0 Else ActualAmount / PlanAmount End) 
Else
100 * (Case When PlanQuantity = 0 
Then 0 Else FactQuantity / PlanQuantity End) 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Plan fulfillment, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اجرای برنامه، درصد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Esecuzione del piano, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wykonanie planu, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Исполнение плана, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Planın yürütülmesi, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Thực hiện kế hoạch, %</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
