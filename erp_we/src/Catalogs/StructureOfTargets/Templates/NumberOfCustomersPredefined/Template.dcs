		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ABCXYZCustomerClassificationSliceLast.Period,
	ABCXYZCustomerClassificationSliceLast.Class AS Class,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue,
	ABCXYZCustomerClassificationSliceLast.Partner
INTO ConductedXYZClassifications
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast({(&amp;DateOfCalculation)}, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.Period &gt;= &amp;ProvidedPeriodStart
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType
	AND ABCXYZCustomerClassificationSliceLast.ClassificationType = &amp;ClassificationType
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;DateOfCalculation AS DateOfCalculation,
	CASE
		WHEN ConductedXYZClassifications.Class IS NULL 
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.PotentialCustomer)
		WHEN ConductedXYZClassifications.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.OneTimeCustomer)
		WHEN ConductedXYZClassifications.Class = VALUE(Enum.XYZClassification.NotClassified)
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.LostCustomer)
		ELSE VALUE(Enum.PhasesOfRelationshipsWithCustomers.LoyalCustomer)
	END AS RelationshipStage,
	Partners.RegistrationDate,
	ConductedXYZClassifications.Period AS ClassificationPeriod,
	1 AS NumberOfPartners,
	ConductedXYZClassifications.Class,
	Partners.MainManager
FROM
	Catalog.Partners AS Partners
		LEFT JOIN ConductedXYZClassifications AS ConductedXYZClassifications
		ON Partners.Ref = ConductedXYZClassifications.Partner
			AND Partners.RegistrationDate &lt; ConductedXYZClassifications.Period
WHERE
	Partners.Client
	AND Partners.RegistrationDate &lt; &amp;DateOfCalculation</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>TargetValuesRanges</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>DataForAnalysis</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(TargetValue_),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(MaximumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(MinimumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(PositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(NegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedPositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedNegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then TargetValue_ Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MaximumTargetRange Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MinimumTargetRange Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PositiveBorderVariance Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then NegativeBorderVariance Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedPositiveBorderVariance Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedNegativeBorderVariance Else 0 End),0)</expression>
		<group>Class</group>
		<group>MainManager</group>
		<group>RelationshipStage</group>
	</totalField>
	<totalField>
		<dataPath>NumberOfPartners</dataPath>
