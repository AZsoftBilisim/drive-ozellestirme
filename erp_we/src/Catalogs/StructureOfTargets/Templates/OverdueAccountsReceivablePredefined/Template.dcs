		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>CustomerAccountsReceivable</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then CustomerAccountsReceivable Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then TargetValue_ Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MaximumTargetRange Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MinimumTargetRange Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PositiveBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then NegativeBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedPositiveBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedNegativeBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueCustomerDebt</dataPath>
		<expression>IsNull(Sum(OverdueCustomerDebt),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>OverdueCustomerDebt</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then OverdueCustomerDebt Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>CustomerDebtIsNotOverdue</dataPath>
		<expression>Case 
When IsNull(Sum(CustomerAccountsReceivable),0) &gt; IsNull(Sum(OverdueCustomerDebt),0) 
Then IsNull(Sum(CustomerAccountsReceivable),0) - IsNull(Sum(OverdueCustomerDebt),0)
Else 0
End</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>CustomerDebtIsNotOverdue</dataPath>
		<expression>Case 
When IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then CustomerAccountsReceivable Else 0 End),0) &gt; Case 
When IsNull(Sum(CustomerAccountsReceivable),0) &gt; IsNull(Sum(OverdueCustomerDebt),0) 
Then IsNull(Sum(CustomerAccountsReceivable),0) - IsNull(Sum(OverdueCustomerDebt),0)
Else 0
End 
Then IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then CustomerAccountsReceivable Else 0 End),0) - Case 
When IsNull(Sum(CustomerAccountsReceivable),0) &gt; IsNull(Sum(OverdueCustomerDebt),0) 
Then IsNull(Sum(CustomerAccountsReceivable),0) - IsNull(Sum(OverdueCustomerDebt),0)
Else 0
End
Else 0
End</expression>
	</totalField>
