		<field xsi:type="DataSetFieldField">
			<dataPath>ARAPObject</dataPath>
			<field>ARAPObject</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>AR/AP object</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>موضوع دریافتنی/پرداختنی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Oggetto di regolamenti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Obiekt rozliczeń</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Объект расчетов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Alacak/Borç nesnesi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đối tượng hạch toán</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, NOT &amp;NewOnlineARAPAccounting AND BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(
				&amp;EndOfPeriod,
				NOT &amp;NewOnlineARAPAccounting
					AND Currency = &amp;SettlementCurrency
					AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DimensionAccounting_1.Organization AS Organization,
	DimensionAccounting_1.Partner AS Partner,
	DimensionAccounting_1.Partner.MainManager AS MainManagerOfPartner,
	CustomersARAPAccounting.ARAPObject.Manager AS ManagerForSettlementObject,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
			THEN -(CAST(CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2)))
		ELSE 0
	END AS AccountsPayableOfCompany,
	CASE
		WHEN CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
			THEN -(CAST(CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2)))
		ELSE 0
	END AS OurInitialDebt,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		ELSE 0
	END AS CustomerAccountsReceivable,
	CASE
		WHEN CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		ELSE 0
	END AS CustomerSInitialDebt,
	&amp;DateOfCalculation AS DateOfCalculation,
	CASE
		WHEN CustomersARAPAccounting.SumOpeningBalance &gt; 0
				AND CustomersARAPAccounting.AmountDueOpeningBalance &gt; 0
			THEN CASE
					WHEN CustomersARAPAccounting.SumOpeningBalance &gt; CustomersARAPAccounting.AmountDueOpeningBalance
						THEN CustomersARAPAccounting.AmountDueOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1)
					ELSE CustomersARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1)
				END
		ELSE 0
	END AS OverdueCustomerDebtOpeningBalance,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0
				AND CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN CASE
					WHEN CustomersARAPAccounting.SumClosingBalance &gt; CustomersARAPAccounting.AmountDueClosingBalance
						THEN CustomersARAPAccounting.AmountDueClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1)
					ELSE CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1)
				END
		ELSE 0
	END AS OverdueCustomerDebtClosingBalance
{SELECT
	ARAPObject,
	Organization.*,
	Partner.*,
	MainManagerOfPartner.* AS MainManagerOfPartner,
	ManagerForSettlementObject.*,
	AccountsPayableOfCompany,
	OurInitialDebt,
	CustomerAccountsReceivable,
	CustomerSInitialDebt,
	DateOfCalculation,
	OverdueCustomerDebtOpeningBalance,
	OverdueCustomerDebtClosingBalance}
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , NOT &amp;NewOnlineARAPAccounting 
		{(AccountingDimensionByPartners.Organization).* AS Organization, 
			(AccountingDimensionByPartners.Partner).* AS Partner, 
			(AccountingDimensionByPartners.Partner.MainManager).* AS MainManagerOfPartner, 
			(ARAPObject.Manager).* AS ManagerForSettlementObject
		}
	) AS CustomersARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
		ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON CustomersARAPAccounting.Currency = ExchangeRates.Currency
WHERE
	DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	(CASE
			WHEN CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
				THEN -(CAST(CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2)))
			ELSE 0
		END) AS AccountsPayableOfCompany,
	(CASE
			WHEN CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
				THEN CAST(CustomersARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
			ELSE 0
		END) AS CustomerAccountsReceivable,
	(&amp;DateOfCalculation)}

UNION ALL

SELECT
	Dimension.Organization,
	Dimension.Partner,
	Dimension.Partner.MainManager,
	Register.ARAPObject.Manager,
	Register.ARAPObject,
	CASE
		WHEN &amp;PaymentData = 1
			THEN Register.PrepaymentManBalance
		WHEN &amp;PaymentData = 3
			THEN Register.PrepaymentLocalBalance
		ELSE Register.PrepaymentBalance
	END,
	0,
	CASE
		WHEN &amp;PaymentData = 1
			THEN Register.ARAPManBalance
		WHEN &amp;PaymentData = 3
			THEN Register.DebtLocalBalance
		ELSE Register.DebtBalance
	END,
	0,
	&amp;DateOfCalculation,
	0,
	CASE
		WHEN &amp;DateOfCalculation &gt; Register.PlannedRepaymentDate
			THEN 1
		ELSE 0
	END * CASE
		WHEN &amp;PaymentData = 1
			THEN Register.ARAPManBalance
		WHEN &amp;PaymentData = 3
			THEN Register.DebtLocalBalance
		ELSE Register.DebtBalance
	END
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(&amp;DateOfCalculation) AS Register
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
		ON Register.AccountingDimensionByPartners = Dimension.DimensionKey}
WHERE
	&amp;NewOnlineARAPAccounting
{WHERE
	(CASE
			WHEN &amp;PaymentData = 1
				THEN SUM(Register.PrepaymentManBalance)
			WHEN &amp;PaymentData = 3
				THEN SUM(Register.PrepaymentLocalBalance)
			ELSE SUM(Register.PrepaymentBalance)
		END) AS AccountsPayableOfCompany,
	(CASE
			WHEN &amp;PaymentData = 1
				THEN SUM(Register.ARAPManBalance)
			WHEN &amp;PaymentData = 3
				THEN SUM(Register.DebtLocalBalance)
			ELSE SUM(Register.DebtBalance)
		END) AS CustomerAccountsReceivable,
	(&amp;DateOfCalculation),
	Register.AccountingDimensionByPartners.Organization.* AS Organization,
	Register.AccountingDimensionByPartners.Partner.* AS Partner,
	Register.AccountingDimensionByPartners.Partner.MainManager.* AS MainManagerOfPartner,
	Register.ARAPObject.Manager.* AS ManagerForSettlementObject}
</query>
		<autoFillFields>false</autoFillFields>
