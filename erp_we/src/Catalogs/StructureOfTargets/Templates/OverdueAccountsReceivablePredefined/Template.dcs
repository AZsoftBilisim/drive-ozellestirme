	<calculatedField>
		<dataPath>CustomerDebtIsNotOverdue</dataPath>
		<expression>Case 
When CustomerAccountsReceivable &gt; OverdueCustomerDebt 
Then CustomerAccountsReceivable - OverdueCustomerDebt
Else 0
End</expression>
