		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	&amp;DateOfCalculation AS DateOfCalculation,
	"BankAccountPayments_" AS CashKind,
	Cash.Organization AS Organization,
	Cash.BankAccount AS StorageLocation,
	Cash.BankAccount.CashCurrency AS StorageCurrency,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	CASE
		WHEN &amp;PaymentData = 0
			THEN Cash.SumOpeningBalance
		WHEN &amp;PaymentData = 1
			THEN Cash.SumManOpeningBalance
		ELSE Cash.SumComplOpeningBalance
	END AS SumOpeningBalance,
	CASE
		WHEN &amp;PaymentData = 0
			THEN Cash.SumClosingBalance
		WHEN &amp;PaymentData = 1
			THEN Cash.SumManClosingBalance
		ELSE Cash.SumComplClosingBalance
	END AS SumClosingBalance,
	Cash.SumManOpeningBalance AS SumManOpeningBalance,
	Cash.SumManClosingBalance AS SumManClosingBalance,
	Cash.SumComplOpeningBalance AS SumComplOpeningBalance,
	Cash.SumComplClosingBalance AS SumComplClosingBalance
{SELECT
	CashKind,
	Organization.*,
	StorageLocation.* AS StorageLocation,
	StorageCurrency.* AS StorageCurrency,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SumOpeningBalance,
	SumClosingBalance,
	SumManOpeningBalance,
	SumManClosingBalance,
	SumComplOpeningBalance,
	SumComplClosingBalance}
FROM
	AccumulationRegister.BankAccountCash.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , ) AS Cash
{WHERE
	("BankAccountPayments_") AS CashKind,
	Cash.Organization.*,
	Cash.BankAccount.* AS StorageLocation,
	Cash.BankAccount.CashCurrency.* AS StorageCurrency,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	(CASE
			WHEN &amp;PaymentData = 0
				THEN Cash.SumOpeningBalance
			WHEN &amp;PaymentData = 1
				THEN Cash.SumManOpeningBalance
			ELSE Cash.SumComplOpeningBalance
		END) AS SumOpeningBalance,
	(CASE
			WHEN &amp;PaymentData = 0
				THEN Cash.SumClosingBalance
			WHEN &amp;PaymentData = 1
				THEN Cash.SumManClosingBalance
			ELSE Cash.SumComplClosingBalance
		END) AS SumClosingBalance,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance,
	Cash.SumComplOpeningBalance,
	Cash.SumComplClosingBalance}

UNION ALL

SELECT
	&amp;DateOfCalculation,
	"CashPayment",
	Cash.Organization,
	Cash.CashAccount,
	Cash.CashAccount.CashCurrency,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	CASE
		WHEN &amp;PaymentData = 0
			THEN Cash.SumOpeningBalance
		WHEN &amp;PaymentData = 1
			THEN Cash.SumManOpeningBalance
		ELSE Cash.SumComplOpeningBalance
	END,
	CASE
		WHEN &amp;PaymentData = 0
			THEN Cash.SumClosingBalance
		WHEN &amp;PaymentData = 1
			THEN Cash.SumManClosingBalance
		ELSE Cash.SumComplClosingBalance
	END,
	Cash.SumManOpeningBalance,
	Cash.SumManClosingBalance,
	Cash.SumComplOpeningBalance,
	Cash.SumComplClosingBalance
FROM
	AccumulationRegister.CashAccountBalance.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , ) AS Cash
{WHERE
	("CashPayment") AS CashKind,
	Cash.Organization.*,
