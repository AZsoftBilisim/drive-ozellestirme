			<field xsi:type="DataSetFieldField">
				<dataPath>AdditionalExpensesExcludingVAT</dataPath>
				<field>AdditionalExpensesExcludingVAT</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Additional expenses excluding VAT</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>هزینه‌های تکمیلی بدون مالیات بر ارزش افزوده</v8:content>
