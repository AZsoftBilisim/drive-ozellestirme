					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CASE
		WHEN &amp;PaymentData = 1
			THEN SUM(Table.Revenue) - SUM(Table.Cost_) - SUM(Table.AddExpensesForGoods)
		WHEN &amp;PaymentData = 3
			THEN SUM(Table.RevenueCompl) - SUM(Table.CostLocal)
		ELSE SUM(Table.RevenueExcludingVAT) - SUM(Table.CostExcludingVAT_) - SUM(Table.AdditionalExpensesExcludingVAT)
	END AS GrossProfit,
	Table.Organization AS Organization,
	Table.Department AS Department,
	Table.DayPeriod AS DayPeriod,
	Table.WeekPeriod AS WeekPeriod,
	Table.TenDaysPeriod AS TenDaysPeriod,
	Table.MonthPeriod AS MonthPeriod,
	Table.QuarterPeriod AS QuarterPeriod,
	Table.HalfYearPeriod AS HalfYearPeriod,
	Table.YearPeriod AS YearPeriod
{SELECT
	GrossProfit,
	Organization.*,
	Department.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod}
FROM
	(SELECT
		Sales.AccountingDimensionByPartners.Organization AS Organization,
		Sales.Department AS Department,
		Sales.RevenueAmountTurnover AS Revenue,
		Sales.RevenueAmountExclVATLocalTurnover AS RevenueCompl,
		Sales.RevenueAmountExcludingVATTurnover AS RevenueExcludingVAT,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN Sales.RevenueAmountTurnover
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.Cost, 0) AS NUMBER(31, 2))
			ELSE Sales.CostTurnover
		END AS Cost_,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN Sales.RevenueAmountExcludingVATTurnover
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.CostExcludingVAT, 0) AS NUMBER(31, 2))
			ELSE Sales.CostExcludingVATTurnover
		END AS CostExcludingVAT_,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN Sales.RevenueAmountExclVATLocalTurnover
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.LocalCost, 0) AS NUMBER(31, 2))
			ELSE Sales.LocalCostTurnover
		END AS CostLocal,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) AS NUMBER(31, 2))
			ELSE Sales.AddExpensesForGoodsTurnover
		END AS AddExpensesForGoods,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(Sales.CountTurnover * ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) AS NUMBER(31, 2))
			ELSE Sales.AdditionalExpensesExcludingVATTurnover
		END AS AdditionalExpensesExcludingVAT,
		Sales.DayPeriod AS DayPeriod,
		Sales.WeekPeriod AS WeekPeriod,
		Sales.TenDaysPeriod AS TenDaysPeriod,
		Sales.MonthPeriod AS MonthPeriod,
		Sales.QuarterPeriod AS QuarterPeriod,
		Sales.HalfYearPeriod AS HalfYearPeriod,
		Sales.YearPeriod AS YearPeriod
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, {(ISNULL(SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef))).* AS SalesOpportunity, (ISNULL(SalesOrder.SalesOpportunity.EmployeeResponsible, VALUE(Catalog.Users.EmptyRef))).* AS OpportunityManager, (CASE
				    WHEN Manager = VALUE(Catalog.Users.EmptyRef)
				        THEN ISNULL(SalesOrder.Manager, VALUE(Catalog.Users.EmptyRef))
				    ELSE Manager
				END).* AS Manager, (CASE
				    WHEN InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
				        THEN CASE
				                WHEN InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				                    THEN InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
				                ELSE InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
				            END
				    ELSE CASE
				            WHEN InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				                THEN InventoryOwnerAttribute.GoodsOwner
				            ELSE InventoryOwnerAttribute.GoodsOwner
				        END
				END).* AS Vendor, (InventoryOwnerAttribute.FinancialAccountingGroup).* AS FinancialAccountingGroup, (CASE
				    WHEN NOT SalesOrder.SalesOpportunity.SalesOpportunityKind IS NULL 
				        THEN SalesOrder.SalesOpportunity.SalesOpportunityKind.Description
				    WHEN SalesOrder REFS Document.SalesOrder
				            OR SalesOrder REFS Document.RequestForReturnOfGoodsFromCustomer
				        THEN &amp;LineSalesByOrders
				    ELSE &amp;LineSalesWithoutOrders
				END) AS SalesOpportunityKind}) AS Sales
			{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
			ON Sales.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
				AND (Sales.AccountingDimensionByPartners.Organization = CostOfProducts.Organization)
				AND Sales.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
				AND (CostOfProducts.Period = BEGINOFPERIOD(Sales.MonthPeriod, MONTH))
				AND (CostOfProducts.AccountingSection &lt;&gt; VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent))
				AND (CostOfProducts.AccountingSection &lt;&gt; VALUE(Enum.SectionsOfInventoryCostAccounting.MaterialsReceivedForProcessing))}
			{LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculationOfCost
			ON (BEGINOFPERIOD(Sales.MonthPeriod, MONTH) = BEGINOFPERIOD(CalculationOfCost.Ref.Date, MONTH))
				AND (Sales.AccountingDimensionByPartners.Organization = CalculationOfCost.Organization)
				AND (CalculationOfCost.Ref.Posted)}
	WHERE
		(&amp;ShowSales_ = 1
					AND Sales.AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
				OR &amp;ShowSales_ = 2
					AND Sales.AccountingDimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
				OR &amp;ShowSales_ = 0)) AS Table
{WHERE
	Table.Organization.*,
	Table.Department.*,
	Table.DayPeriod,
	Table.WeekPeriod,
	Table.TenDaysPeriod,
	Table.MonthPeriod,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.YearPeriod}

GROUP BY
	Table.Organization,
	Table.DayPeriod,
	Table.WeekPeriod,
	Table.TenDaysPeriod,
	Table.MonthPeriod,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.YearPeriod,
	Table.Department

HAVING
	(CASE
			WHEN &amp;PaymentData = 1
				THEN SUM(Table.Revenue)
			WHEN &amp;PaymentData = 3
				THEN SUM(Table.RevenueCompl)
			ELSE SUM(Table.RevenueExcludingVAT)
		END &lt;&gt; 0
		OR CASE
			WHEN &amp;PaymentData = 1
				THEN SUM(Table.Cost_)
			WHEN &amp;PaymentData = 3
				THEN SUM(Table.CostLocal)
			ELSE SUM(Table.CostExcludingVAT_)
		END &lt;&gt; 0
		OR CASE
			WHEN &amp;PaymentData = 1
				THEN SUM(Table.AddExpensesForGoods)
			WHEN &amp;PaymentData = 3
				THEN 0
			ELSE SUM(Table.AdditionalExpensesExcludingVAT)
		END &lt;&gt; 0
		OR CASE
			WHEN &amp;PaymentData = 1
				THEN SUM(Table.Revenue) - SUM(Table.Cost_) - SUM(Table.AddExpensesForGoods)
			WHEN &amp;PaymentData = 3
				THEN SUM(Table.RevenueCompl) - SUM(Table.CostLocal)
			ELSE SUM(Table.RevenueExcludingVAT) - SUM(Table.CostExcludingVAT_) - SUM(Table.AdditionalExpensesExcludingVAT)
		END &lt;&gt; 0)</query>
		</item>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>TargetValuesRanges</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
