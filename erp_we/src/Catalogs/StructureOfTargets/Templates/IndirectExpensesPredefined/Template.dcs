				<dataPath>WeekPeriod</dataPath>
				<field>WeekPeriod</field>
				<useRestriction>
					<field>true</field>
					<condition>true</condition>
					<group>true</group>
					<order>true</order>
				</useRestriction>
				<role>
					<dcscom:periodNumber>2</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>HalfYearPeriod</dataPath>
				<field>HalfYearPeriod</field>
				<useRestriction>
					<field>true</field>
					<condition>true</condition>
					<group>true</group>
					<order>true</order>
				</useRestriction>
				<role>
					<dcscom:periodNumber>6</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LineOfBusiness</dataPath>
				<field>LineOfBusiness</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BaseCurrency</dataPath>
				<field>BaseCurrency</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	&amp;DateOfCalculation,
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	OtherExpenses.Currency,
	OtherExpenses.Organization,
	OtherExpenses.Department,
	OtherExpenses.ExpenseItem,
	OtherExpenses.ExpenseAmount * ISNULL(ExchangeRates.ConversionFactor_, 1) AS ExpenseAmount,
	OtherExpenses.DateOfCalculation,
	OtherExpenses.DayPeriod,
	OtherExpenses.WeekPeriod,
	OtherExpenses.TenDaysPeriod,
	OtherExpenses.MonthPeriod,
	OtherExpenses.QuarterPeriod,
	OtherExpenses.HalfYearPeriod,
	OtherExpenses.YearPeriod
FROM
	(SELECT
		&amp;ManagementAccountingCurrency AS Currency,
		OtherExpenses.Organization AS Organization,
		OtherExpenses.Department AS Department,
		OtherExpenses.ExpenseItem AS ExpenseItem,
		OtherExpenses.SumReceipt AS ExpenseAmount,
		&amp;DateOfCalculation AS DateOfCalculation,
		OtherExpenses.DayPeriod AS DayPeriod,
		OtherExpenses.WeekPeriod AS WeekPeriod,
		OtherExpenses.TenDaysPeriod AS TenDaysPeriod,
		OtherExpenses.MonthPeriod AS MonthPeriod,
		OtherExpenses.QuarterPeriod AS QuarterPeriod,
		OtherExpenses.HalfYearPeriod AS HalfYearPeriod,
		OtherExpenses.YearPeriod AS YearPeriod
	FROM
		AccumulationRegister.OtherExpenses.Turnovers(&amp;ProvidedPeriodStart, {(&amp;EndOfPeriod)}, Auto,
			ExpenseItem.CostAllocationOptionManag IN (VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
																VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly))
			) AS OtherExpenses) AS OtherExpenses
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON OtherExpenses.Currency = ExchangeRates.Currency</query>
		</item>
