		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	&amp;DateOfCalculation AS DateOfCalculation,
	BEGINOFPERIOD(&amp;DateOfCalculation, DAY) AS DayPeriod,
	BEGINOFPERIOD(&amp;DateOfCalculation, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(&amp;DateOfCalculation, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(&amp;DateOfCalculation, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(&amp;DateOfCalculation, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(&amp;DateOfCalculation, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(&amp;DateOfCalculation, YEAR) AS YearPeriod,
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS Rate
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCalculation, Currency = &amp;ConvertibleCurrency AND BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCalculation, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>TargetValuesRanges</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PeriodsTable</sourceDataSet>
		<destinationDataSet>DataForAnalysis</destinationDataSet>
		<sourceExpression>Period</sourceExpression>
		<destinationExpression>DateOfCalculation</destinationExpression>
		<parameter>DateOfCalculation</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(TargetValue_),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(MaximumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(MinimumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(PositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(NegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedPositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedNegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then TargetValue_ Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MaximumTargetRange Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MinimumTargetRange Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PositiveBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then NegativeBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedPositiveBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedNegativeBorderVariance Else 0 End),0)</expression>
	</totalField>
	<totalField>
		<dataPath>Rate</dataPath>
		<expression>Sum(Rate)</expression>
	</totalField>
