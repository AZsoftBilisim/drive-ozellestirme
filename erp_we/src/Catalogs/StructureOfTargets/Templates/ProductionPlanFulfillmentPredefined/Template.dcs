		<field xsi:type="DataSetFieldField">
			<dataPath>ItemsLocationAttributes</dataPath>
			<field>ItemsLocationAttributes</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// THERE ARE CLIPPING TAGS

SELECT
	1 AS CompatibleWithTmarTenderloin
INTO CompatibleWithTmarTenderloin
;

SELECT ALLOWED
	ProductionPlansTurnovers.Department AS Department,
	ProductionPlansTurnovers.Products.Parent AS ProductGroup,
	ProductionPlansTurnovers.Products.ProductCategory AS ProductCategory,
	ProductionPlansTurnovers.Products.AnalyticalGroup AS AnalyticalGroup,
	ProductionPlansTurnovers.Products AS Products,
	ProductionPlansTurnovers.Characteristic AS Characteristic,
	SUM(ProductionPlansTurnovers.CountTurnover) AS Count,
	ProductionPlansTurnovers.DayPeriod,
	ProductionPlansTurnovers.WeekPeriod,
	ProductionPlansTurnovers.TenDaysPeriod,
	ProductionPlansTurnovers.MonthPeriod,
	ProductionPlansTurnovers.QuarterPeriod,
	ProductionPlansTurnovers.HalfYearPeriod,
	ProductionPlansTurnovers.YearPeriod
INTO ProductionPlan
FROM
	AccumulationRegister.ProductionPlans.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, Scenario = &amp;Scenario {(Department).* AS Department, (Products).* AS Products, (Characteristic).* AS Characteristic}) AS ProductionPlansTurnovers

GROUP BY
	ProductionPlansTurnovers.DayPeriod,
	ProductionPlansTurnovers.WeekPeriod,
	ProductionPlansTurnovers.TenDaysPeriod,
	ProductionPlansTurnovers.MonthPeriod,
	ProductionPlansTurnovers.QuarterPeriod,
	ProductionPlansTurnovers.HalfYearPeriod,
	ProductionPlansTurnovers.YearPeriod,
	ProductionPlansTurnovers.Department,
	ProductionPlansTurnovers.Products.Parent,
	ProductionPlansTurnovers.Products.ProductCategory,
	ProductionPlansTurnovers.Products,
	ProductionPlansTurnovers.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
	
	SELECT
	OutputTurnover_.DayPeriod AS DayPeriod,
	OutputTurnover_.WeekPeriod AS WeekPeriod,
	OutputTurnover_.TenDaysPeriod AS TenDaysPeriod,
	OutputTurnover_.MonthPeriod AS MonthPeriod,
	OutputTurnover_.QuarterPeriod AS QuarterPeriod,
	OutputTurnover_.HalfYearPeriod AS HalfYearPeriod,
	OutputTurnover_.YearPeriod AS YearPeriod,
	CASE
		WHEN OutputTurnover_.Recorder REFS Document.ProductionStage2_2
			THEN ISNULL(OutputTurnover_.Recorder.ReferenceOrder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN OutputTurnover_.Recorder REFS Document.BackflushProduction
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)

		WHEN TRUE 
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END AS Department,
	OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	OutputTurnover_.ItemsLocationAttributes.Products.Parent AS ProductGroup,
	OutputTurnover_.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	OutputTurnover_.ItemsLocationAttributes.Products.AnalyticalGroup AS AnalyticalGroup,
	OutputTurnover_.ItemsLocationAttributes.Characteristic AS Characteristic,
	SUM(OutputTurnover_.CountTurnover) AS FactQuantity
INTO Production
FROM
	AccumulationRegister.ProductsRelease.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			Auto,
			(ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				(SELECT DISTINCT
					ProductionPlan.Products,
					ProductionPlan.Characteristic
			FROM
					ProductionPlan AS ProductionPlan)
	) AS OutputTurnover_
	LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProduct
		ON ManufacturedProduct.Ref = OutputTurnover_.ReferenceOrder
		AND ManufacturedProduct.RowCode = OutputTurnover_.RowCode
	LEFT JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS SideAndIntermediateRelease
		ON SideAndIntermediateRelease.Ref = OutputTurnover_.ReferenceOrder
		AND SideAndIntermediateRelease.RowCode = OutputTurnover_.RowCode
GROUP BY
	CASE
		WHEN OutputTurnover_.Recorder REFS Document.ProductionStage2_2
			THEN ISNULL(OutputTurnover_.Recorder.ReferenceOrder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN OutputTurnover_.Recorder REFS Document.BackflushProduction
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)

		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END,
	OutputTurnover_.ItemsLocationAttributes.Products,
	OutputTurnover_.ItemsLocationAttributes.Characteristic,
	OutputTurnover_.ItemsLocationAttributes.Products.Parent,
	OutputTurnover_.ItemsLocationAttributes.Products.ProductCategory,
	OutputTurnover_.ItemsLocationAttributes.Products.AnalyticalGroup,
	OutputTurnover_.DayPeriod,
	OutputTurnover_.WeekPeriod,
	OutputTurnover_.TenDaysPeriod,
	OutputTurnover_.MonthPeriod,
	OutputTurnover_.QuarterPeriod,
	OutputTurnover_.HalfYearPeriod,
	OutputTurnover_.YearPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
INTO TTPlanProducts
FROM
	ProductionPlan AS Table

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.Department AS Department,
	NestedQuery.Products.Parent AS ProductGroup,
	NestedQuery.Products.ProductCategory AS ProductCategory,
	NestedQuery.AnalyticalGroup,
	NestedQuery.Products AS Products,
	NestedQuery.Characteristic AS Characteristic,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	NestedQuery.DayPeriod AS DayPeriod,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	NestedQuery.WeekPeriod AS WeekPeriod,
	NestedQuery.TenDaysPeriod AS TenDaysPeriod,
	NestedQuery.MonthPeriod AS MonthPeriod,
	NestedQuery.QuarterPeriod AS QuarterPeriod,
	NestedQuery.HalfYearPeriod AS HalfYearPeriod,
	NestedQuery.YearPeriod AS YearPeriod,
	MAX(NestedQuery.DepartmentPlan) AS DepartmentPlan
INTO ProductionPlanFact
FROM
	(SELECT
		ProductionPlan.Department AS Department,
		ProductionPlan.Products.Parent AS ProductGroup,
		ProductionPlan.Products.ProductCategory AS ProductCategory,
		ProductionPlan.AnalyticalGroup AS AnalyticalGroup,
		ProductionPlan.Products AS Products,
		ProductionPlan.Characteristic AS Characteristic,
		ProductionPlan.Count AS PlanQuantity,
		0 AS FactQuantity,
		ProductionPlan.DayPeriod AS DayPeriod,
		ProductionPlan.WeekPeriod AS WeekPeriod,
		ProductionPlan.TenDaysPeriod AS TenDaysPeriod,
		ProductionPlan.MonthPeriod AS MonthPeriod,
		ProductionPlan.QuarterPeriod AS QuarterPeriod,
		ProductionPlan.HalfYearPeriod AS HalfYearPeriod,
		ProductionPlan.YearPeriod AS YearPeriod,
		ProductionPlan.Department AS DepartmentPlan
	FROM
		ProductionPlan AS ProductionPlan
	
	UNION ALL
	
	SELECT
		Production.Department,
		Production.Products.Parent,
		Production.Products.ProductCategory,
		Production.AnalyticalGroup,
		Production.Products,
		Production.Characteristic,
		0,
		Production.FactQuantity,
		Production.DayPeriod,
		Production.WeekPeriod,
		Production.TenDaysPeriod,
		Production.MonthPeriod,
		Production.QuarterPeriod,
		Production.HalfYearPeriod,
		Production.YearPeriod,
		VALUE(Catalog.BusinessStructure.EmptyRef)
	FROM
		Production AS Production) AS NestedQuery

GROUP BY
	NestedQuery.DayPeriod,
	NestedQuery.WeekPeriod,
	NestedQuery.TenDaysPeriod,
	NestedQuery.MonthPeriod,
	NestedQuery.QuarterPeriod,
	NestedQuery.HalfYearPeriod,
	NestedQuery.YearPeriod,
	NestedQuery.Department,
	NestedQuery.Products.Parent,
	NestedQuery.Products.ProductCategory,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.AnalyticalGroup
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN ProductionPlanFact.DepartmentPlan = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		ELSE ProductionPlanFact.Department
	END AS Department,
	ProductionPlanFact.Products.Parent AS ProductGroup,
	ProductionPlanFact.Products.ProductCategory AS ProductCategory,
	ProductionPlanFact.AnalyticalGroup,
	ProductionPlanFact.Products AS Products,
	ProductionPlanFact.Characteristic AS Characteristic,
	SUM(ProductionPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(ProductionPlanFact.FactQuantity) AS FactQuantity,
	ProductionPlanFact.DayPeriod,
	ProductionPlanFact.WeekPeriod,
	ProductionPlanFact.TenDaysPeriod,
	ProductionPlanFact.MonthPeriod,
	ProductionPlanFact.QuarterPeriod,
	ProductionPlanFact.HalfYearPeriod,
	ProductionPlanFact.YearPeriod
FROM
	ProductionPlanFact AS ProductionPlanFact

GROUP BY
	ProductionPlanFact.DayPeriod,
	ProductionPlanFact.WeekPeriod,
	ProductionPlanFact.TenDaysPeriod,
	ProductionPlanFact.MonthPeriod,
	ProductionPlanFact.QuarterPeriod,
	ProductionPlanFact.HalfYearPeriod,
	ProductionPlanFact.YearPeriod,
	ProductionPlanFact.Products.Parent,
	ProductionPlanFact.Products.ProductCategory,
	ProductionPlanFact.Products,
	ProductionPlanFact.Characteristic,
	ProductionPlanFact.AnalyticalGroup,
	CASE
		WHEN ProductionPlanFact.DepartmentPlan = VALUE(Catalog.BusinessStructure.EmptyRef)
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		ELSE ProductionPlanFact.Department
	END
 </query>
