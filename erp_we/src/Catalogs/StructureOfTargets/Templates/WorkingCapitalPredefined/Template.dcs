				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DeleteARAPObjectPurchaseOrder</dataPath>
			<field>DeleteARAPObjectPurchaseOrder</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>(not used) AR/AP object</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>(استفاده نمی‌شود) موضوع دریافتنی/پرداختنی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>(non si usa) Oggetto di regolamenti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>(nie używany) Obiekt rozliczeń</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>(не используется) Объект расчетов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>(kullanılmayan) Alacak/Borç nesnesi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>(không sử dụng) Đối tượng ерфтр еoáт</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	"Assets_1" AS IndicatorType,
	CASE
		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
			THEN "GoodsInStock"
		ELSE "GoodsTransferredToCommissionAgent"
	END AS Factor,
	CostAccounting_.Organization AS Organization,
	&amp;ManagementAccountingCurrency AS Currency,
	NULL AS Partner,
	CostAccounting_.CostClosingBalance + CostAccounting_.AddExpensesForGoodsClosingBalance AS SumClosingBalance
INTO WorkingCapital
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CostAccounting_

UNION ALL

SELECT
	"Assets_1",
	"CashAccountBalance",
	Cash.Organization,
	Cash.CashAccount.CashCurrency,
	NULL,
	Cash.SumClosingBalance
FROM
	AccumulationRegister.CashAccountBalance.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS Cash

UNION ALL

SELECT
	"Assets_1",
	"BankAccountCash",
	Cash.Organization,
	Cash.BankAccount.CashCurrency,
	NULL,
	Cash.SumClosingBalance
FROM
	AccumulationRegister.BankAccountCash.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS Cash

UNION ALL

SELECT
	CASE
		WHEN Cash.SumClosingBalance &gt; 0
			THEN "Assets_1"
		ELSE "Commitments"
	END,
	"AdvanceHolderCash",
	Cash.Organization,
	Cash.Currency,
	NULL,
	Cash.SumClosingBalance
FROM
	AccumulationRegister.AdvanceHolderCash.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS Cash

UNION ALL

SELECT
	"Assets_1",
	"DeferredExpenses",
	OtherExpenses.Organization,
	&amp;ManagementAccountingCurrency,
	NULL,
	OtherExpenses.SumClosingBalance
FROM
	AccumulationRegister.OtherExpenses.BalanceAndTurnovers({(&amp;ProvidedPeriodStart)}, {(&amp;DateEmpty)}, Auto, RegisterRecords, ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)) AS OtherExpenses

UNION ALL

SELECT
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0
			THEN "Assets_1"
		ELSE "Commitments"
	END,
	"IntercompanyARAP",
	RegisterAccountingAnalyticsForPartners.Organization,
	CustomersARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	CustomersARAPAccounting.SumClosingBalance
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CustomersARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance &gt; 0
			THEN "Assets_1"
		ELSE "Commitments"
	END,
	"IntercompanyARAP",
	RegisterAccountingAnalyticsForPartners.Organization,
	VendorsARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	VendorsARAPAccounting.SumClosingBalance
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS VendorsARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	"Assets_1",
	"AccountsReceivable",
	RegisterAccountingAnalyticsForPartners.Organization,
	CustomersARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Partner,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0
				AND CustomersARAPAccounting.SumClosingBalance - CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN CustomersARAPAccounting.SumClosingBalance - CustomersARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CustomersARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	"Assets_1",
	"AccountsReceivableOverdue",
	RegisterAccountingAnalyticsForPartners.Organization,
	CustomersARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Partner,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN CASE
					WHEN CustomersARAPAccounting.SumClosingBalance &gt; CustomersARAPAccounting.AmountDueClosingBalance
						THEN CustomersARAPAccounting.AmountDueClosingBalance
					ELSE CustomersARAPAccounting.SumClosingBalance
				END
		ELSE 0
	END
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CustomersARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	"Commitments",
	"PrepaymentsFromCustomerLayout",
	RegisterAccountingAnalyticsForPartners.Organization,
	CustomersARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Partner,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance &lt; 0
			THEN CustomersARAPAccounting.SumClosingBalance
		ELSE 0
	END
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS CustomersARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	"Commitments",
	"AccountsPayable",
	RegisterAccountingAnalyticsForPartners.Organization,
	VendorsARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Partner,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance &lt; 0
				AND VendorsARAPAccounting.SumClosingBalance - VendorsARAPAccounting.AmountDueClosingBalance &lt; 0
			THEN VendorsARAPAccounting.SumClosingBalance - VendorsARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, , Auto, , ) AS VendorsARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	"Commitments",
	"The creditor's debt is overdue",
	RegisterAccountingAnalyticsForPartners.Organization,
	VendorsARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Partner,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &lt; 0
			THEN CASE
					WHEN -VendorsARAPAccounting.SumClosingBalance &gt; -VendorsARAPAccounting.AmountDueClosingBalance
						THEN VendorsARAPAccounting.AmountDueClosingBalance
					ELSE VendorsARAPAccounting.SumClosingBalance
				END
		ELSE 0
	END
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS VendorsARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)

UNION ALL

SELECT
	"Assets_1",
	"PrepaymentsToVendor_",
	RegisterAccountingAnalyticsForPartners.Organization,
	VendorsARAPAccounting.Currency,
	RegisterAccountingAnalyticsForPartners.Partner,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN VendorsARAPAccounting.SumClosingBalance
		ELSE 0
	END
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, ENDOFPERIOD(&amp;DateOfCalculation, DAY), Auto, , ) AS VendorsARAPAccounting
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	"AssetsLessLiabilities" AS AssetsLessLiabilities,
	WorkingCapital.IndicatorType AS IndicatorType,
	WorkingCapital.Factor AS Factor,
	WorkingCapital.Organization,
	WorkingCapital.Currency AS Currency,
	WorkingCapital.Partner AS Partner,
	CASE
		WHEN &amp;SettlementCurrency = VALUE(Catalog.Currencies.EmptyRef)
			THEN WorkingCapital.Currency
		ELSE &amp;SettlementCurrency
	END AS SettlementCurrency,
	SUM(WorkingCapital.SumClosingBalance) AS SumClosingBalance,
	SUM(WorkingCapital.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1)) AS AmountFinalBalanceInCurrency,
	&amp;DateOfCalculation
FROM
	WorkingCapital AS WorkingCapital
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON WorkingCapital.Currency = ExchangeRates.Currency
WHERE
	(NOT WorkingCapital.Currency IS NULL )

GROUP BY
	WorkingCapital.IndicatorType,
	WorkingCapital.Factor,
	WorkingCapital.Organization,
	WorkingCapital.Currency,
	WorkingCapital.Partner

HAVING
	SUM(WorkingCapital.SumClosingBalance) &lt;&gt; 0</query>
	</dataSet>
