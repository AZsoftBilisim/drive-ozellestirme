		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Purchases.Organization AS Organization,
	Purchases.Partner,
	Purchases.Partner.MainManager AS MainManagerOfPartner,
	Purchases.SumTurnover AS PurchasesForThePeriod,
	&amp;DateOfCalculation,
	&amp;SettlementCurrency
INTO CalculationOfPurchases
FROM
	AccumulationRegister.Purchases.Turnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromSupplier) {(Organization) AS Organization, (Partner) AS Partner, (Partner.MainManager) AS MainManagerOfPartner}) AS Purchases
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DimensionAccounting_1.Organization AS Organization,
	DimensionAccounting_1.Partner AS Partner,
	DimensionAccounting_1.Partner.MainManager AS MainManagerOfPartner,
	VendorsARAPAccounting.Currency AS ARAPCurrency,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
			THEN -(CAST(VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2)))
		ELSE 0
	END AS DebtOfSupplier,
	CASE
		WHEN VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
			THEN -(CAST(VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2)))
		ELSE 0
	END AS SupplierSInitialDebt,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2))
		ELSE 0
	END AS AccountsPayableOfCompany,
	CASE
		WHEN VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
			THEN CAST(VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2))
		ELSE 0
	END AS OurInitialDebt,
	CalculationOfPurchases.PurchasesForThePeriod AS PurchasesForThePeriod,
	&amp;DateOfCalculation AS DateOfCalculation,
	DATEDIFF(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, DAY) AS NumberOfDaysInCalculation,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	VendorsARAPAccounting.ARAPObject.Object AS PurchaseOrder
{SELECT
	Organization.*,
	Partner.*,
	MainManagerOfPartner.*,
	ARAPCurrency.*,
	DebtOfSupplier,
	SupplierSInitialDebt,
	AccountsPayableOfCompany,
	OurInitialDebt,
	PurchasesForThePeriod,
	DateOfCalculation,
	NumberOfDaysInCalculation,
	ARAPObject,
	PurchaseOrder.*}
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, , 
		{(AccountingDimensionByPartners.Organization).* AS Organization, 
			(AccountingDimensionByPartners.Partner).* AS Partner, 
			(AccountingDimensionByPartners.Partner.MainManager).* AS MainManagerOfPartner,
			(Currency) AS ARAPCurrency
		}
	) AS VendorsARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
		ON VendorsARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON VendorsARAPAccounting.Currency = ExchangeRates.Currency
		{LEFT JOIN CalculationOfPurchases AS CalculationOfPurchases
		ON VendorsARAPAccounting.AccountingDimensionByPartners.Organization = CalculationOfPurchases.Organization
			AND VendorsARAPAccounting.AccountingDimensionByPartners.Partner = CalculationOfPurchases.Partner
			AND VendorsARAPAccounting.AccountingDimensionByPartners.Partner.MainManager = CalculationOfPurchases.MainManagerOfPartner}
WHERE
	DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	(CASE
			WHEN VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
				THEN -(CAST(VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2)))
			ELSE 0
		END) AS DebtOfSupplier,
	(CASE
			WHEN VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &lt; 0
				THEN -(CAST(VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2)))
			ELSE 0
		END) AS SupplierSInitialDebt,
	(CASE
			WHEN VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
				THEN CAST(VendorsARAPAccounting.SumClosingBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2))
			ELSE 0
		END) AS AccountsPayableOfCompany,
	(CASE
			WHEN VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) &gt; 0
				THEN CAST(VendorsARAPAccounting.SumOpeningBalance * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31,2))
			ELSE 0
		END) AS OurInitialDebt,
	CalculationOfPurchases.PurchasesForThePeriod,
	(&amp;DateOfCalculation),
	(DATEDIFF(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, DAY)) AS NumberOfDaysInCalculation,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	VendorsARAPAccounting.ARAPObject.Object.* AS PurchaseOrder}</query>
	</dataSet>
