	<totalField>
		<dataPath>Sokz</dataPath>
		<expression>Case When IsNull(Sum(PurchasesForThePeriod),0) = 0 Then
0
Else
Avg(NumberOfDaysInCalculation) 
*
Case 
When EvalExpression("Count(Period)",,,"First", "Current") = 0 
Then 0 
Else 
(EvalExpression("IsNull(Sum(AccountsPayableOfCompany),0)",,, "First", "Current") 
- 0.5 * EvalExpression("IsNull(Sum(AccountsPayableOfCompany),0)",,, "Current", "Current")
- 0.5 * EvalExpression("IsNull(Sum(AccountsPayableOfCompany),0)",,, "First", "First")
)/ EvalExpression("Count(Period)",,,"First", "Current") 
End / 
IsNull(Sum(PurchasesForThePeriod),0)
End</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>Sokz</dataPath>
		<expression>TargetValueMonitoring.GetLastArrayValue(
EvalExpressionWithGroupArray(
"Case When IsNull(Sum(PurchasesForThePeriod),0) = 0 
Then 0
Else
Avg(NumberOfDaysInCalculation) 
* 
Case 
When EvalExpression(""Count(Period)"",,,""First"", ""Current"") = 0 
Then 0 
Else 
(EvalExpression(""IsNull(Sum(AccountsPayableOfCompany),0)"",,, ""First"", ""Current"") 
- 0.5 * EvalExpression(""IsNull(Sum(AccountsPayableOfCompany),0)"",,, ""Current"", ""Current"")
- 0.5 * EvalExpression(""IsNull(Sum(AccountsPayableOfCompany),0)"",,, ""First"", ""First""))
/EvalExpression(""Count(Period)"",,,""First"", ""Current"") End 
/ IsNull(Sum(PurchasesForThePeriod),0)
End", "Period"))</expression>
		<group>ARAPCurrency</group>
		<group>Organization</group>
		<group>MainManagerOfPartner</group>
		<group>Partner</group>
	</totalField>
