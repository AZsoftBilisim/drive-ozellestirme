		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VendorsARAPAccounting.DateOfCalculation AS DateOfCalculation,
	VendorsARAPAccounting.Organization AS Organization,
	VendorsARAPAccounting.Partner AS Partner,
	VendorsARAPAccounting.Counterparty AS Counterparty,
	VendorsARAPAccounting.MainManager AS MainManager,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	VendorsARAPAccounting.ManagerForSettlementObject AS ManagerForSettlementObject,
	VendorsARAPAccounting.PurchaseOrder AS PurchaseOrder,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN 1
		ELSE 0
	END AS PaymentOverdue,
	CASE
		WHEN VendorsARAPAccounting.ToReceiveClosingBalance &lt; 0
			THEN 1
		ELSE 0
	END AS ReceiptOverdue,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
				AND VendorsARAPAccounting.ToReceiveClosingBalance &lt; 0
			THEN 1
		ELSE 0
	END AS PaymentAndReceiptOverdue,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
				OR VendorsARAPAccounting.ToReceiveClosingBalance &lt; 0
			THEN 1
		ELSE 0
	END AS OverdueTotal,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
				AND VendorsARAPAccounting.ToReceiveClosingBalance &lt; 0
			THEN "OverduePaymentAndReceipt"
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN "PaymentOverdue_"
		WHEN VendorsARAPAccounting.ToReceiveClosingBalance &lt; 0
			THEN "OverdueReceipt_"
	END AS State
FROM
	(SELECT
		&amp;DateOfCalculation AS DateOfCalculation,
		DimensionAccounting_1.Organization AS Organization,
		DimensionAccounting_1.Partner AS Partner,
		DimensionAccounting_1.Counterparty AS Counterparty,
		DimensionAccounting_1.Partner.MainManager AS MainManager,
		VendorsARAPAccounting.ARAPObject AS ARAPObject,
		VendorsARAPAccounting.ARAPObject.Manager AS ManagerForSettlementObject,
		VendorsARAPAccounting.ARAPObject.Object AS PurchaseOrder,
		SUM(VendorsARAPAccounting.AmountDueClosingBalance) AS AmountDueClosingBalance,
		SUM(VendorsARAPAccounting.ToReceiveClosingBalance) AS ToReceiveClosingBalance
	FROM
		AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(&amp;BeginOfPeriod {(&amp;ProvidedPeriodStart)}, &amp;DateOfCalculation {(&amp;DateOfCalculation)}, Auto, , 
			AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
			{(AccountingDimensionByPartners.Organization).* AS Organization,
				(AccountingDimensionByPartners.Partner).* AS Partner,
				(AccountingDimensionByPartners.Counterparty).* AS Counterparty,
				(AccountingDimensionByPartners.Partner.MainManager).* AS MainManager,
				(ARAPObject.Manager).* AS ManagerForSettlementObject,
				(Currency) AS ARAPCurrency
			}
		) AS VendorsARAPAccounting
			{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
			ON VendorsARAPAccounting.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
	
	GROUP BY
		DimensionAccounting_1.Organization,
		DimensionAccounting_1.Partner,
		DimensionAccounting_1.Counterparty,
		DimensionAccounting_1.Partner.MainManager,
		VendorsARAPAccounting.ARAPObject) AS VendorsARAPAccounting
WHERE
	(VendorsARAPAccounting.AmountDueClosingBalance &lt; 0
			OR VendorsARAPAccounting.ToReceiveClosingBalance &gt; 0)</query>
	</dataSet>
