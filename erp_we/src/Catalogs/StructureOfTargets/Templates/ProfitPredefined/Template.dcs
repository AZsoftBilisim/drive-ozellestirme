	</dataSetLink>
	<calculatedField>
		<dataPath>ProfitLoss</dataPath>
		<expression>0</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Profit / loss</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>سود / زیان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Profitto/perdita</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Dochód / strata</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прибыль / убыток</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kar / zarar</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Lãi / lỗ</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(TargetValue_),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(MaximumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(MinimumTargetRange),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(PositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(NegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedPositiveBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(AdjustedNegativeBorderVariance),0)</expression>
		<group>Period</group>
	</totalField>
	<totalField>
		<dataPath>TargetValue_</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then TargetValue_ Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>MaximumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MaximumTargetRange Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>MinimumTargetRange</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then MinimumTargetRange Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>PositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then PositiveBorderVariance Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>NegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then NegativeBorderVariance Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedNegativeBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedPositiveBorderVariance Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>AdjustedPositiveBorderVariance</dataPath>
		<expression>IsNull(Sum(Case When Period = BeginOfPeriod(&amp;EndOfPeriod, "Day") Then AdjustedNegativeBorderVariance Else 0 End),0)</expression>
		<group>LineOfBusiness</group>
		<group>Organization</group>
		<group>Department</group>
		<group>Section</group>
		<group>AssetRef</group>
	</totalField>
	<totalField>
		<dataPath>ProfitLoss</dataPath>
		<expression>Sum(IsNull(IncomeAmount, 0))
- Sum(IsNull(ExpenseAmount, 0))</expression>
	</totalField>
	<totalField>
		<dataPath>IncomeAmount</dataPath>
		<expression>IsNull(Sum(IncomeAmount),0)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseAmount</dataPath>
		<expression>IsNull(Sum(ExpenseAmount),0)</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okres</v8:content>
			</v8:item>
			<v8:item>
