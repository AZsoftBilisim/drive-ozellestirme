				<dataPath>WeekPeriod</dataPath>
				<field>WeekPeriod</field>
				<role>
					<dcscom:periodNumber>2</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>DayPeriod</dataPath>
				<field>DayPeriod</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	"Income" AS Section,
	FinancialResults.Organization AS Organization,
	FinancialResults.Department AS Department,
	FinancialResults.LineOfBusiness AS LineOfBusiness,
	FinancialResults.IncomeItem AS AssetRef,
	FinancialResults.IncomeTurnover AS IncomeAmount,
	0 AS ExpenseAmount,
	FinancialResults.DayPeriod AS DayPeriod,
	FinancialResults.WeekPeriod AS WeekPeriod,
	FinancialResults.TenDaysPeriod AS TenDaysPeriod,
	FinancialResults.MonthPeriod AS MonthPeriod,
	FinancialResults.QuarterPeriod AS QuarterPeriod,
	FinancialResults.HalfYearPeriod AS HalfYearPeriod,
	FinancialResults.YearPeriod AS YearPeriod
{SELECT
	Section,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	AssetRef.*,
	IncomeAmount,
	ExpenseAmount,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod}
FROM
	AccumulationRegister.FinancialResults.Turnovers(&amp;ProvidedPeriodStart, &amp;EndOfPeriod, Auto, ) AS FinancialResults
{WHERE
	("Income") AS Section,
	FinancialResults.Organization.*,
	FinancialResults.Department.*,
	FinancialResults.LineOfBusiness.*,
	FinancialResults.IncomeItem.* AS AssetRef}</query>
		</item>
