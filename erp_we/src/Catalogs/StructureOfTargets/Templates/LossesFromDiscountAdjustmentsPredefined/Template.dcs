		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;ManagementAccountingCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SUM(Table.Revenue * ISNULL(ExchangeRates.ConversionFactor_, 1)) AS Revenue,
	Table.Manager AS Manager,
	Table.DayPeriod,
	Table.WeekPeriod,
	Table.TenDaysPeriod,
	Table.MonthPeriod,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.YearPeriod
INTO RevenueCalculation
FROM
	(SELECT
		&amp;ManagementAccountingCurrency AS Currency,
		CAST(Sales.SalesOrder.Manager AS Catalog.Users) AS Manager,
		Sales.RevenueAmountTurnover AS Revenue,
		Sales.DayPeriod AS DayPeriod,
		Sales.WeekPeriod AS WeekPeriod,
		Sales.TenDaysPeriod AS TenDaysPeriod,
		Sales.MonthPeriod AS MonthPeriod,
		Sales.QuarterPeriod AS QuarterPeriod,
		Sales.HalfYearPeriod AS HalfYearPeriod,
		Sales.YearPeriod AS YearPeriod
	{SELECT
		Manager.*}
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, ) AS Sales
			{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
			ON Sales.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
	WHERE
		DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	{WHERE
		(CAST(Sales.SalesOrder.Manager AS Catalog.Users)).* AS Manager}) AS Table
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON Table.Currency = ExchangeRates.Currency

GROUP BY
	Table.Manager,
	Table.DayPeriod,
	Table.WeekPeriod,
	Table.TenDaysPeriod,
	Table.MonthPeriod,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.YearPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;DateOfCalculation,
	NestedQuery.Manager AS Manager,
	NestedQuery.ManualDiscount,
	NestedQuery.Revenue,
	NestedQuery.DayPeriod,
	NestedQuery.WeekPeriod,
	NestedQuery.TenDaysPeriod,
	NestedQuery.MonthPeriod,
	NestedQuery.QuarterPeriod,
	NestedQuery.HalfYearPeriod,
	NestedQuery.YearPeriod
{SELECT
	Manager.*}
FROM
	(SELECT
		NestedQuery.Manager AS Manager,
		NestedQuery.ManualDiscount AS ManualDiscount,
		NestedQuery.DayPeriod AS DayPeriod,
		NestedQuery.WeekPeriod AS WeekPeriod,
		NestedQuery.TenDaysPeriod AS TenDaysPeriod,
		NestedQuery.MonthPeriod AS MonthPeriod,
		NestedQuery.QuarterPeriod AS QuarterPeriod,
		NestedQuery.HalfYearPeriod AS HalfYearPeriod,
		NestedQuery.YearPeriod AS YearPeriod,
		0 AS Revenue
	FROM
		(SELECT
			CAST(CustomerInvoice.Manager AS Catalog.Users) AS Manager,
			CustomerInvoice.Currency AS Currency,
			SUM(SalesOfGoodsServicesGoods.ManualDiscount * ISNULL(ExchangeRates.ConversionFactor_, 1)) AS ManualDiscount,
			BEGINOFPERIOD(CustomerInvoice.Date, DAY) AS DayPeriod,
			BEGINOFPERIOD(CustomerInvoice.Date, WEEK) AS WeekPeriod,
			BEGINOFPERIOD(CustomerInvoice.Date, TENDAYS) AS TenDaysPeriod,
			BEGINOFPERIOD(CustomerInvoice.Date, MONTH) AS MonthPeriod,
			BEGINOFPERIOD(CustomerInvoice.Date, QUARTER) AS QuarterPeriod,
			BEGINOFPERIOD(CustomerInvoice.Date, HALFYEAR) AS HalfYearPeriod,
			BEGINOFPERIOD(CustomerInvoice.Date, YEAR) AS YearPeriod
		{SELECT
			Manager.*}
		FROM
			Document.CustomerInvoice.Goods AS SalesOfGoodsServicesGoods
				LEFT JOIN Document.CustomerInvoice AS CustomerInvoice
					LEFT JOIN ExchangeRates AS ExchangeRates
					ON CustomerInvoice.Currency = ExchangeRates.Currency
				ON SalesOfGoodsServicesGoods.Ref = CustomerInvoice.Ref
		WHERE
			CustomerInvoice.Posted
			AND CustomerInvoice.Goods.ManualDiscount &lt;&gt; 0
			AND CustomerInvoice.Date BETWEEN &amp;ProvidedPeriodStart AND &amp;DateOfCalculation
		{WHERE
			(CAST(CustomerInvoice.Manager AS Catalog.Users)).* AS Manager}
		
		GROUP BY
			CustomerInvoice.Manager,
			CustomerInvoice.Currency,
			BEGINOFPERIOD(CustomerInvoice.Date, DAY),
			BEGINOFPERIOD(CustomerInvoice.Date, WEEK),
			BEGINOFPERIOD(CustomerInvoice.Date, TENDAYS),
			BEGINOFPERIOD(CustomerInvoice.Date, MONTH),
			BEGINOFPERIOD(CustomerInvoice.Date, QUARTER),
			BEGINOFPERIOD(CustomerInvoice.Date, HALFYEAR),
			BEGINOFPERIOD(CustomerInvoice.Date, YEAR)) AS NestedQuery
	
	GROUP BY
		NestedQuery.Manager,
		NestedQuery.ManualDiscount,
		NestedQuery.DayPeriod,
		NestedQuery.WeekPeriod,
		NestedQuery.TenDaysPeriod,
		NestedQuery.MonthPeriod,
		NestedQuery.QuarterPeriod,
		NestedQuery.HalfYearPeriod,
		NestedQuery.YearPeriod
	
	UNION ALL
	
	SELECT
		RevenueCalculation.Manager,
		0,
		RevenueCalculation.DayPeriod,
		RevenueCalculation.WeekPeriod,
		RevenueCalculation.TenDaysPeriod,
		RevenueCalculation.MonthPeriod,
		RevenueCalculation.QuarterPeriod,
		RevenueCalculation.HalfYearPeriod,
		RevenueCalculation.YearPeriod,
		RevenueCalculation.Revenue
	FROM
		RevenueCalculation AS RevenueCalculation) AS NestedQuery
{WHERE
	NestedQuery.Manager.*}

GROUP BY
	NestedQuery.Manager,
	NestedQuery.ManualDiscount,
	NestedQuery.Revenue,
	NestedQuery.DayPeriod,
	NestedQuery.WeekPeriod,
	NestedQuery.TenDaysPeriod,
	NestedQuery.MonthPeriod,
	NestedQuery.QuarterPeriod,
	NestedQuery.HalfYearPeriod,
	NestedQuery.YearPeriod</query>
	</dataSet>
