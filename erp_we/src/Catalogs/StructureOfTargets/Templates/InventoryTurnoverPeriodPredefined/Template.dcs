		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DimensionByPartners.Organization AS Organization,
	Sales.ItemsLocationAttributes,
	Sales.CostTurnover AS CostOfSaleForThePeriod,
	Sales.CostExcludingVATTurnover AS CostOfSaleForThePeriodExcludingVAT,
	&amp;DateOfCalculation,
	&amp;SettlementCurrency
INTO CalculationOfCostOfSales
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, Auto, {(AccountingDimensionByPartners.Organization) AS Organization, (AccountingDimensionByPartners.Partner) AS Partner, (AccountingDimensionByPartners.Partner.MainManager) AS MainManagerOfPartner}) AS Sales
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON Sales.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
WHERE
	(&amp;ShowSales_ = 1
				AND DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 2
				AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 0)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryCost.Organization AS Organization,
	InventoryCost.ItemsLocationAttributes.StorageLocation AS Warehouse,
	InventoryCost.ItemsLocationAttributes.Products.Parent AS ProductGroup,
	InventoryCost.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	InventoryCost.ItemsLocationAttributes.Products.AnalyticalGroup AS AnalyticalGroup,
	InventoryCost.ItemsLocationAttributes.Products AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	&amp;DateOfCalculation AS DateOfCalculation,
	(DATEDIFF(&amp;ProvidedPeriodStart, &amp;DateOfCalculation, DAY) + 1) AS NumberOfDaysInCalculation,
	InventoryCost.CostOpeningBalance AS CostOpeningBalance,
	InventoryCost.CostClosingBalance AS CostClosingBalance,
	InventoryCost.CostExcludingVATOpeningBalance AS CostExcludingVATOpeningBalance,
	InventoryCost.CostExcludingVATClosingBalance AS CostExcludingVATClosingBalance,
	CalculationOfCostOfSales.CostOfSaleForThePeriod AS CostOfSaleForThePeriod,
	CalculationOfCostOfSales.CostOfSaleForThePeriodExcludingVAT AS CostOfSaleForThePeriodExcludingVAT
{SELECT
	Organization.*,
	Warehouse.*,
	ProductGroup.*,
	ProductCategory.*,
	AnalyticalGroup.*,
	Products.*,
	Characteristic.*,
	DateOfCalculation,
	CostOpeningBalance,
	CostClosingBalance,
	CostExcludingVATOpeningBalance,
	CostExcludingVATClosingBalance,
	CostOfSaleForThePeriod,
	CostOfSaleForThePeriodExcludingVAT}
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(, &amp;DateOfCalculation, Auto, , {(Organization).* AS Organization, (AccountingSection).* AS AccountingSection, (ItemsLocationAttributes.StorageLocation).* AS Warehouse, (ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic}) AS InventoryCost
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON (&amp;ManagementAccountingCurrency = ExchangeRates.Currency)
		LEFT JOIN CalculationOfCostOfSales AS CalculationOfCostOfSales
		ON InventoryCost.Organization = CalculationOfCostOfSales.Organization
			AND InventoryCost.ItemsLocationAttributes = CalculationOfCostOfSales.ItemsLocationAttributes
{WHERE
	InventoryCost.ItemsLocationAttributes.Products.Parent.* AS ProductGroup,
	InventoryCost.ItemsLocationAttributes.Products.ProductCategory.* AS ProductCategory,
	InventoryCost.ItemsLocationAttributes.Products.AnalyticalGroup.* AS AnalyticalGroup,
	InventoryCost.CostOpeningBalance,
	InventoryCost.CostClosingBalance,
	InventoryCost.CostExcludingVATOpeningBalance,
	InventoryCost.CostExcludingVATClosingBalance,
	CalculationOfCostOfSales.CostOfSaleForThePeriod,
	CalculationOfCostOfSales.CostOfSaleForThePeriodExcludingVAT}</query>
	</dataSet>
