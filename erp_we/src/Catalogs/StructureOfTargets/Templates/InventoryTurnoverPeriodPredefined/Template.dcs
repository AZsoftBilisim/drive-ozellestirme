	<calculatedField>
		<dataPath>Pops</dataPath>
		<expression>0</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Inventory turnover period</v8:content>
			</v8:item>
