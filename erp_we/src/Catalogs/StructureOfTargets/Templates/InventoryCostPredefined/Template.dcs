		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;SettlementCurrency AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryCost.AccountingSection AS AccountingSection,
	InventoryCost.Organization AS Organization,
	InventoryCost.ItemsLocationAttributes.StorageLocation AS Warehouse,
	InventoryCost.ItemsLocationAttributes.Products.Parent AS ProductGroup,
	InventoryCost.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	InventoryCost.ItemsLocationAttributes.Products.AnalyticalGroup AS AnalyticalGroup,
	InventoryCost.ItemsLocationAttributes.Products AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	&amp;DateOfCalculation AS DateOfCalculation,
	InventoryCost.CostOpeningBalance AS CostOpeningBalance,
	InventoryCost.CostClosingBalance AS CostClosingBalance,
	InventoryCost.CostExcludingVATOpeningBalance AS CostExcludingVATOpeningBalance,
	InventoryCost.CostExcludingVATClosingBalance AS CostExcludingVATClosingBalance,
	InventoryCost.AddExpensesForGoodsOpeningBalance AS AddExpensesForGoodsOpeningBalance,
	InventoryCost.AddExpensesForGoodsClosingBalance AS AddExpensesForGoodsClosingBalance,
	InventoryCost.AdditionalExpensesExcludingVATOpeningBalance AS AdditionalExpensesExcludingVATOpeningBalance,
	InventoryCost.AdditionalExpensesExcludingVATClosingBalance AS AdditionalExpensesExcludingVATClosingBalance,
	InventoryCost.ItemizedFixedCostsIncludingVATOpeningBalance AS ItemizedFixedCostsIncludingVATOpeningBalance,
	InventoryCost.ItemizedFixedCostsIncludingVATClosingBalance AS ItemizedFixedCostsIncludingVATClosingBalance,
	InventoryCost.ItemizedFixedCostsExcludingVATOpeningBalance AS ItemizedFixedCostsExcludingVATOpeningBalance,
	InventoryCost.ItemizedFixedCostsExcludingVATClosingBalance AS ItemizedFixedCostsExcludingVATClosingBalance,
	InventoryCost.ItemizedVariableCostsIncludingVATOpeningBalance AS ItemizedVariableCostsIncludingVATOpeningBalance,
	InventoryCost.ItemizedVariableCostsIncludingVATClosingBalance AS ItemizedVariableCostsIncludingVATClosingBalance,
	InventoryCost.ItemizedVariableCostsExcludingVATOpeningBalance AS ItemizedVariableCostsExcludingVATOpeningBalance,
	InventoryCost.ItemizedVariableCostsExcludingVATClosingBalance AS ItemizedVariableCostsExcludingVATClosingBalance,
	InventoryCost.LaborCostsOpeningBalance AS LaborCostsOpeningBalance,
	InventoryCost.LaborCostsClosingBalance AS LaborCostsClosingBalance
{SELECT
	AccountingSection.*,
	Organization.*,
	Warehouse.*,
	ProductGroup.*,
	ProductCategory.*,
	Products.*,
	Characteristic.*,
	AnalyticalGroup.*,
	DateOfCalculation,
	CostOpeningBalance,
	CostClosingBalance,
	CostExcludingVATOpeningBalance,
	CostExcludingVATClosingBalance,
	AddExpensesForGoodsOpeningBalance,
	AddExpensesForGoodsClosingBalance,
	AdditionalExpensesExcludingVATOpeningBalance,
	AdditionalExpensesExcludingVATClosingBalance,
	ItemizedFixedCostsIncludingVATOpeningBalance,
	ItemizedFixedCostsIncludingVATClosingBalance,
	ItemizedFixedCostsExcludingVATOpeningBalance,
	ItemizedFixedCostsExcludingVATClosingBalance,
	ItemizedVariableCostsIncludingVATOpeningBalance,
	ItemizedVariableCostsIncludingVATClosingBalance,
	ItemizedVariableCostsExcludingVATOpeningBalance,
	ItemizedVariableCostsExcludingVATClosingBalance,
	LaborCostsOpeningBalance,
	LaborCostsClosingBalance}
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(, &amp;DateOfCalculation, Auto, , {(Organization).* AS Organization, (AccountingSection).* AS AccountingSection, (ItemsLocationAttributes.StorageLocation).* AS Warehouse, (ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic}) AS InventoryCost
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON (&amp;ManagementAccountingCurrency = ExchangeRates.Currency)
{WHERE
	InventoryCost.ItemsLocationAttributes.Products.Parent.* AS ProductGroup,
	InventoryCost.ItemsLocationAttributes.Products.ProductCategory.* AS ProductCategory,
	InventoryCost.ItemsLocationAttributes.Products.AnalyticalGroup.* AS AnalyticalGroup,
	InventoryCost.CostOpeningBalance,
	InventoryCost.CostClosingBalance,
	InventoryCost.CostExcludingVATOpeningBalance,
	InventoryCost.CostExcludingVATClosingBalance,
	InventoryCost.AddExpensesForGoodsOpeningBalance,
	InventoryCost.AddExpensesForGoodsClosingBalance,
	InventoryCost.AdditionalExpensesExcludingVATOpeningBalance,
	InventoryCost.AdditionalExpensesExcludingVATClosingBalance,
	InventoryCost.ItemizedFixedCostsIncludingVATOpeningBalance,
	InventoryCost.ItemizedFixedCostsIncludingVATClosingBalance,
	InventoryCost.ItemizedFixedCostsExcludingVATOpeningBalance,
	InventoryCost.ItemizedFixedCostsExcludingVATClosingBalance,
	InventoryCost.ItemizedVariableCostsIncludingVATOpeningBalance,
	InventoryCost.ItemizedVariableCostsIncludingVATClosingBalance,
	InventoryCost.ItemizedVariableCostsExcludingVATOpeningBalance,
	InventoryCost.ItemizedVariableCostsExcludingVATClosingBalance,
	InventoryCost.LaborCostsOpeningBalance,
	InventoryCost.LaborCostsClosingBalance}</query>
	</dataSet>
