    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InventoryLocationAttributeKeys.Ref AS Ref,
	InventoryLocationAttributeKeys.DeletionMark AS DeletionMark,
	InventoryLocationAttributeKeys.Description AS Description,
	InventoryLocationAttributeKeys.Products AS Products,
	InventoryLocationAttributeKeys.Characteristic AS Characteristic,
	InventoryLocationAttributeKeys.Series AS Series,
	InventoryLocationAttributeKeys.StorageLocation AS StorageLocation,
	InventoryLocationAttributeKeys.Purpose AS Purpose,
	InventoryLocationAttributeKeys.ProductCostElement AS ProductCostElement,
	InventoryLocationAttributeKeys.Predefined AS Predefined,
	InventoryLocationAttributeKeys.PredefinedDataName AS PredefinedDataName,
	CASE
		WHEN NOT InventoryLocationAttributeKeys.DeletionMark
				AND Dimension.DimensionKey IS NULL
			THEN TRUE
		ELSE FALSE
	END AS NoRecordInRegister,
	InventoryLocationAttributeKeys.StorageType AS StorageType,
	InventoryLocationAttributeKeys.WarehouseArea AS WarehouseArea,
	InventoryLocationAttributeKeys.Department AS Department,
	InventoryLocationAttributeKeys.Partner AS Partner,
	InventoryLocationAttributeKeys.Counterparty AS Counterparty,
	InventoryLocationAttributeKeys.Contract AS Contract,
	InventoryLocationAttributeKeys.Organization AS Organization
FROM
	Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS Dimension
		ON (Dimension.DimensionKey = InventoryLocationAttributeKeys.Ref)</queryText>
      <mainTable>Catalog.InventoryLocationAttributeKeys</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
