    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBudgetingSteps.Ref,
	CatalogBudgetingSteps.DeletionMark,
	CatalogBudgetingSteps.Owner,
	CatalogBudgetingSteps.Parent,
	CatalogBudgetingSteps.IsFolder,
	CatalogBudgetingSteps.Code,
	CatalogBudgetingSteps.Description,
	CatalogBudgetingSteps.LongDesc,
	CatalogBudgetingSteps.SchedulePresentation,
	CatalogBudgetingSteps.Action,
	CatalogBudgetingSteps.MonitoringReportSettings,
	CatalogBudgetingSteps.SettingOfAction,
	CatalogBudgetingSteps.ActionSettingPresentation,
	CatalogBudgetingSteps.EmployeeResponsible,
	CatalogBudgetingSteps.Duration,
	CatalogBudgetingSteps.DurationType,
	CatalogBudgetingSteps.DurationPresentation,
	CatalogBudgetingSteps.Periodicity,
	CatalogBudgetingSteps.StageExecutionProcedure,
	CatalogBudgetingSteps.TaskDetails1,
	CatalogBudgetingSteps.StartCondition,
	CatalogBudgetingSteps.DueDate,
	CatalogBudgetingSteps.TypePeriod,
	CatalogBudgetingSteps.NotRunning,
	CatalogBudgetingSteps.ExecuteAutomatically,
	CatalogBudgetingSteps.Predefined,
	CatalogBudgetingSteps.PredefinedDataName,
	CASE
		WHEN DeletionMark AND IsFolder THEN
			4
		WHEN DeletionMark THEN
			3
		WHEN CatalogBudgetingSteps.IsFolder
			THEN 1
		WHEN CatalogBudgetingSteps.Action = VALUE(Enum.TypesOfBudgetingStepActions.StepGroupRepetition)
			THEN 2
		ELSE 0
	END AS PictureIndex
FROM
	Catalog.BudgetingSteps AS CatalogBudgetingSteps</queryText>
      <mainTable>Catalog.BudgetingSteps</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
