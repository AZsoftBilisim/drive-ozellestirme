    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	LotsOfGoodsAndMaterials.Ref AS Ref
INTO LotsOfGoodsAndMaterials
FROM
	Catalog.LotsOfInventoryInOperation AS LotsOfGoodsAndMaterials
WHERE
	LotsOfGoodsAndMaterials.CompletionDate_ >= &amp;Period
	AND LotsOfGoodsAndMaterials.CompletionDate_ &lt;> DATETIME(1,1,1)
	AND NOT LotsOfGoodsAndMaterials.DeletionMark
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	GoodsTable.CompletionDate_ AS CompletionDate_
FROM
	(SELECT
		GoodsTable.Lot.CompletionDate_ AS CompletionDate_
	FROM
		Document.InventoryConsumption.Goods AS GoodsTable
	WHERE
		GoodsTable.Lot IN
			(SELECT
				LotsOfGoodsAndMaterials.Ref
			FROM
				LotsOfGoodsAndMaterials AS LotsOfGoodsAndMaterials)
		AND GoodsTable.Ref.Posted
		AND GoodsTable.Ref.Organization = &amp;Organization
		AND GoodsTable.Products = &amp;Products
		AND GoodsTable.Characteristic = &amp;Characteristic
		AND GoodsTable.Series = &amp;Series
		AND GoodsTable.Ref.LineOfBusiness = &amp;LineOfBusiness

	UNION ALL

	SELECT
		GoodsTable.Lot.CompletionDate_ AS CompletionDate_
	FROM
		Document.OBEntryInventoryInOperation.InventoryInOperation AS GoodsTable
	WHERE
		GoodsTable.Lot IN
			(SELECT
				LotsOfGoodsAndMaterials.Ref
			FROM
				LotsOfGoodsAndMaterials AS LotsOfGoodsAndMaterials)
		AND GoodsTable.Ref.Posted
		AND GoodsTable.Ref.Organization = &amp;Organization
		AND GoodsTable.Products = &amp;Products
		AND GoodsTable.Characteristic = &amp;Characteristic
		AND GoodsTable.Series = &amp;Series
		AND GoodsTable.LineOfBusiness = &amp;LineOfBusiness

	UNION ALL

	SELECT
		GoodsTable.Lot.CompletionDate_ AS CompletionDate_
	FROM
		Document.OBEntry.InventoryInOperation AS GoodsTable
	WHERE
		GoodsTable.Lot IN
			(SELECT
				LotsOfGoodsAndMaterials.Ref
			FROM
				LotsOfGoodsAndMaterials AS LotsOfGoodsAndMaterials)
		AND GoodsTable.Ref.Posted
		AND GoodsTable.Ref.Organization = &amp;Organization
		AND GoodsTable.Products = &amp;Products
		AND GoodsTable.Characteristic = &amp;Characteristic
		AND GoodsTable.Ref.LineOfBusiness = &amp;LineOfBusiness) AS GoodsTable</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
