    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.Persons.EmptyRef) AS Individual,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	VALUE(Catalog.LotsOfInventoryInOperation.EmptyRef) AS Lot,
	CAST(&quot;&quot; AS STRING(150)) AS LotPresentation,
	FALSE AS StocktakingRecord,
	FALSE AS AccountingForIndividuals,
	UNDEFINED AS MethodOfRepaymentOfCostOfAC,
	0 AS EstimatedRunningTime,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	CAST(&quot;&quot; AS STRING(100)) AS AssetID,
	VALUE(Catalog.CCDNumbers.EmptyRef) AS CCDNumber,
	0 AS Count,
	0 AS QuantityByGBRN</queryText>
