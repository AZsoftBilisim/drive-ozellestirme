    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogDataOverridable.Ref AS Ref,
	CatalogDataOverridable.DeletionMark AS DeletionMark,
	CatalogDataOverridable.Parent AS Parent,
	CatalogDataOverridable.IsFolder AS IsFolder,
	CatalogDataOverridable.Code AS Code,
	CatalogDataOverridable.Description AS Description,
	CatalogDataOverridable.IntangibleAssetsKind AS IntangibleAssetsKind,
	CatalogDataOverridable.KindOfAccountingObject AS KindOfAccountingObject,
	CatalogDataOverridable.DepreciationGroup AS DepreciationGroup,
	CatalogDataOverridable.DescriptionFull AS DescriptionFull,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Enum.IntangibleAssetsStates.EmptyRef) AS BUState,
	VALUE(Enum.IntangibleAssetsStates.EmptyRef) AS StateOfTheUU,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS FinancialAccountingGroup,
	0 AS UsefulLifeManagementAccounting,
	0 AS UsefulLifeAccounting,
	0 AS UsefulLifeTaxAccounting,
	UNDEFINED AS VATTaxation,
	DATETIME(1, 1, 1) AS DateOfRegistrationOfTheRegl,
	DATETIME(1, 1, 1) AS DateOfRegistrationOfTheUpr

FROM
	Catalog.IntangibleAssets AS CatalogDataOverridable
</queryText>
      <mainTable>Catalog.IntangibleAssets</mainTable>
