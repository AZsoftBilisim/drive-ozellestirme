	CatalogIntangibleAssetsOverridable.IntangibleAssetGroup,
	UNDEFINED AS DepreciationGroup,
	CatalogIntangibleAssetsOverridable.OtherInformation,
	CatalogIntangibleAssetsOverridable.KindOfAccountingObject,
	CatalogIntangibleAssetsOverridable.Predefined,
	CatalogIntangibleAssetsOverridable.PredefinedDataName,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Enum.IntangibleAssetsStates.EmptyRef) AS ReglStatus,
	VALUE(Enum.IntangibleAssetsStates.EmptyRef) AS UPRStatus,
	DATETIME(1, 1, 1, 0, 0, 0) AS DateOfRegistrationOfTheRegl,
	DATETIME(1, 1, 1, 0, 0, 0) AS DateOfRegistrationOfTheUpr,
	0 HasFiles
FROM
	Catalog.IntangibleAssets AS CatalogIntangibleAssetsOverridable</queryText>
