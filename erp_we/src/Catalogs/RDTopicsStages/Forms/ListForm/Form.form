    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RDTopicsStages.Ref,
	RDTopicsStages.DeletionMark,
	RDTopicsStages.Parent,
	RDTopicsStages.Code,
	RDTopicsStages.Description,
	RDTopicsStages.IncludedInListOfGovernmentOfRussianFederation,
	RDTopicsStages.PlannedWorksStartDate,
	RDTopicsStages.PlannedWorkCompletionDate,
	RDTopicsStages.Completed,
	RDTopicsStages.BusinessActivityClassifierCode2,
	RDTopicsStages.DescriptionFull,
	RDTopicsStages.Development,
	RDTopicsStages.AdditionalAttributes.*,
	RDTopicsStages.Predefined,
	RDTopicsStages.PredefinedDataName,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Catalog.RDTopicsStages AS RDTopicsStages
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON RDTopicsStages.Ref = FilesExist.ObjectWithFiles</queryText>
      <mainTable>Catalog.RDTopicsStages</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
