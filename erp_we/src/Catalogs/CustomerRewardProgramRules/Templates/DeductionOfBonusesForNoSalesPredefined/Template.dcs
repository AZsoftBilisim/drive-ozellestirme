		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
{SELECT
	Partner.*}
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Segments.Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Partner AS Partner,
	RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Organization AS Organization,
	RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Counterparty AS Counterparty,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products AS Products,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Characteristic AS Characteristic,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.StorageLocation AS Warehouse,
	RevenueAndCostOfSalesTurnover.Manager AS Manager,
	RevenueAndCostOfSalesTurnover.CountTurnover AS CountTurnover,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover AS RevenueAmountTurnover
INTO Sales
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(
			DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY, -&amp;NumberOfDaysWithoutSales),
			&amp;CurrentDate,
			Auto,
			{(ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
					(SELECT
						SelectionByProductSegment.Products,
						SelectionByProductSegment.Characteristic
					FROM
						SelectionByProductSegment
					WHERE
						SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
				,AccountingDimensionByPartners.Partner IN
					(SELECT
						SelectionByPartnerSegment.Partner
					FROM
						SelectionByPartnerSegment
					WHERE
						SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}) AS RevenueAndCostOfSalesTurnover
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BonusPointsBalance.Partner,
	BonusPointsBalance.AccruedBalance AS AccrualAmount
FROM
	AccumulationRegister.BonusPoints.Balance(&amp;CurrentDate,
		LoyaltyProgram = &amp;LoyaltyProgram
		AND (NOT Partner IN
			(SELECT
				Sales.Partner
			FROM
				Sales AS Sales))
		{(Partner IN
				(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS BonusPointsBalance</query>
	</dataSet>
