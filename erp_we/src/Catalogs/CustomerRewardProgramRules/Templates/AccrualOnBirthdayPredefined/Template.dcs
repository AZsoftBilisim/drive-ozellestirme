		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
{SELECT
	Partner.*}
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Segments.Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	AccrualAndDebitingOfBonusPointsBonusPoints.Partner AS Partner
INTO PreviousAccruals
FROM
	Document.AccrueAndDeductionOfBonusPoints.Accrual AS AccrualAndDebitingOfBonusPointsBonusPoints
WHERE
	AccrualAndDebitingOfBonusPointsBonusPoints.Ref.AccrualRule = &amp;AutomaticAccrual
	AND AccrualAndDebitingOfBonusPointsBonusPoints.Ref.Posted
	AND AccrualAndDebitingOfBonusPointsBonusPoints.Ref.Date BETWEEN CASE
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.DAY)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY, -&amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), WEEK, -&amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), MONTH, -&amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), QUARTER, -&amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), YEAR, -&amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), TENDAYS, -&amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), HALFYEAR, -&amp;NumberOfPeriods)
			ELSE BEGINOFPERIOD(&amp;CurrentDate, DAY)
		END AND DATEADD(CASE
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.DAY)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY, &amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), WEEK, &amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), MONTH, &amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), QUARTER, &amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), YEAR, &amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), TENDAYS, &amp;NumberOfPeriods)
			WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
				THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), HALFYEAR, &amp;NumberOfPeriods)
			ELSE DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY, 1)
		END, DAY, -1)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DATEADD(CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.DAY)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY, &amp;NumberOfPeriods)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), WEEK, &amp;NumberOfPeriods)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), MONTH, &amp;NumberOfPeriods)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), QUARTER, &amp;NumberOfPeriods)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), YEAR, &amp;NumberOfPeriods)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), TENDAYS, &amp;NumberOfPeriods)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), HALFYEAR, &amp;NumberOfPeriods)
		ELSE DATEADD(BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY, 1)
	END, DAY, -1) AS EndOfPeriod,
	BEGINOFPERIOD(&amp;CurrentDate, DAY) AS BeginOfPeriod,
	DATEADD(BEGINOFPERIOD(&amp;CurrentDate, YEAR), YEAR, 1) AS BeginningOfNextYear
INTO AccrualLimits

;
////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Partners.Ref AS Partner,
	&amp;AccrualAmount AS AccrualAmount
FROM
	Catalog.Partners AS Partners
	LEFT JOIN AccrualLimits AS AccrualLimits
	ON TRUE
		INNER JOIN Catalog.LoyaltyCards AS LoyaltyCards
		ON LoyaltyCards.Partner = Partners.Ref
		 AND LoyaltyCards.Owner.LoyaltyProgram = &amp;LoyaltyProgram
WHERE
	NOT Partners.Ref IN
				(SELECT
					PreviousAccruals.Partner
				FROM
					PreviousAccruals)
	AND (CASE WHEN DATEADD(Partners.BirthDate, YEAR, YEAR(&amp;CurrentDate) - YEAR(Partners.BirthDate)) &lt; AccrualLimits.BeginOfPeriod
				THEN DATEADD(Partners.BirthDate, YEAR, YEAR(&amp;CurrentDate) - YEAR(Partners.BirthDate) + 1)
				ELSE DATEADD(Partners.BirthDate, YEAR, YEAR(&amp;CurrentDate) - YEAR(Partners.BirthDate))
	   END) BETWEEN AccrualLimits.BeginOfPeriod AND AccrualLimits.EndOfPeriod
{WHERE
	(Partners.Ref IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
	</dataSet>
