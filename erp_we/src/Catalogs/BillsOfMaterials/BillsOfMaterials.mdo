    <name>AllowSelectionForSideOutletProducts</name>
    <synonym>
      <key>en</key>
      <value>Allow selecting BOM for by-products</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>اجازه انتخاب فهرست مواد برای محصولات فرعی</value>
    </synonym>
    <synonym>
