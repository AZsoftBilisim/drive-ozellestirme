    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CatalogBillsOfMaterialsOverridable.Ref AS Ref,
	CatalogBillsOfMaterialsOverridable.Code AS Code,
	CatalogBillsOfMaterialsOverridable.IsFolder AS IsFolder,
	CatalogBillsOfMaterialsOverridable.Parent AS Parent,
	CatalogBillsOfMaterialsOverridable.Description AS Description,
	CatalogBillsOfMaterialsOverridable.Status AS Status,
	CatalogBillsOfMaterialsOverridable.ProductionProcessType AS ProductionProcessType,
	CatalogBillsOfMaterialsOverridable.ValidOnDate AS ValidOnDate,
	CatalogBillsOfMaterialsOverridable.ValidToDate AS ValidToDate,
	CatalogBillsOfMaterialsOverridable.EmployeeResponsible AS EmployeeResponsible,
	CatalogBillsOfMaterialsOverridable.LongDesc AS LongDesc,
	VALUE(Catalog.Products.EmptyRef) AS MainProduct
FROM
	Catalog.BillsOfMaterials AS CatalogBillsOfMaterialsOverridable</queryText>
      <mainTable>Catalog.BillsOfMaterials</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
