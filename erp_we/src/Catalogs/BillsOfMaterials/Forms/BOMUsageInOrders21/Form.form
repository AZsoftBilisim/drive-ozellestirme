    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Use another bill of materials to manufacture the selected item (semi-finished product)</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>استفاده از فهرست مواد دیگری برای تولید قلم انتخاب‌شده (کالای نیمه‌ساخته)</value>
    </toolTip>
    <toolTip>
      <key>it</key>
