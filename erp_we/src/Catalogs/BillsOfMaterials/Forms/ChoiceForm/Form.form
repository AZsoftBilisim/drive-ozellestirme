	CatalogBillsOfMaterialsOverridable.EmployeeResponsible AS EmployeeResponsible,
	CatalogBillsOfMaterialsOverridable.LongDesc AS LongDesc,
	CatalogBillsOfMaterialsOverridable.MainProductProducts AS MainProduct
FROM
	Catalog.BillsOfMaterials AS CatalogBillsOfMaterialsOverridable</queryText>
