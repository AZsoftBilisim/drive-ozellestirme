  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.EconomicReleaseLot</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.LongDesc</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MainProduct</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MinimumReleaseLot</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ProductionProcessType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.QuantityPerBatch</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.UnitOfMeasurePresentation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Valid</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBillsOfMaterials.Ref AS Ref,
	CatalogBillsOfMaterials.Code AS Code,
	CatalogBillsOfMaterials.Description AS Description,
	CatalogBillsOfMaterials.ValidOnDate AS ValidOnDate,
	CatalogBillsOfMaterials.ValidToDate AS ValidToDate,
	CatalogBillsOfMaterials.LongDesc AS LongDesc,
	CatalogBillsOfMaterials.Status AS Status,
	CatalogBillsOfMaterials.ProductionProcessType AS ProductionProcessType,
	CASE
		WHEN CatalogBillsOfMaterials.Status = VALUE(Enum.BOMStatuses.Valid)
		AND (&amp;ProductionStart = DATETIME(1, 1, 1)
		OR CatalogBillsOfMaterials.ValidOnDate &lt;= &amp;ProductionStart)
		AND (CatalogBillsOfMaterials.ValidToDate = DATETIME(1, 1, 1)
		OR CatalogBillsOfMaterials.ValidToDate > &amp;ProductionStart)
			THEN TRUE
		ELSE FALSE
	END AS Valid,
	CASE
		WHEN CatalogBillsOfMaterials.AssignmentOption = VALUE(Enum.BillOfMaterialsAssignmentOptions.ProductKind)
			THEN CatalogBillsOfMaterials.MainProductProductKind
		ELSE CatalogBillsOfMaterials.MainProductProducts
	END AS MainProduct,
	CatalogBillsOfMaterials.MainProductCharacteristic AS MainProductCharacteristic,
	CASE
		WHEN CatalogBillsOfMaterials.UnderRepairProduct = VALUE(Catalog.Products.EmptyRef)
			THEN CatalogBillsOfMaterials.ItemKindOfProductUnderRM
		ELSE CatalogBillsOfMaterials.UnderRepairProduct
	END AS FinishedProductBeingRepaired,
	CatalogBillsOfMaterials.UnderRepairVariant AS UnderRepairVariant,
	(CatalogBillsOfMaterials.Ref = &amp;PrioritySpecification) AS PrioritySpecification,
	CatalogBillsOfMaterials.MinimumReleaseLot AS MinimumReleaseLot,
	CatalogBillsOfMaterials.EconomicReleaseLot AS EconomicReleaseLot,
	PRESENTATION(CatProducts.UnitOfMeasure) AS UnitOfMeasurePresentation,
	ISNULL(ProductsBOM.NumberOfPackagesPerStartingLotUnit, 0) * ISNULL(&amp;QueryTextPackagingFactor, 1) AS QuantityPerBatch
FROM
	Catalog.BillsOfMaterials AS CatalogBillsOfMaterials
	
	LEFT JOIN Catalog.Products AS CatProducts
	ON &amp;GetProductBOM AND CatProducts.Ref IN (&amp;Products)
	
	LEFT JOIN InformationRegister.ProductsBOM AS ProductsBOM
	ON 	CatalogBillsOfMaterials.Ref = ProductsBOM.BillOfMaterials
		AND ProductsBOM.ProductKind = &amp;ProductKind
		AND ProductsBOM.Products IN (&amp;Products, VALUE(Catalog.Products.EmptyRef))
		AND ProductsBOM.Characteristic IN (&amp;Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))
	
WHERE
	NOT CatalogBillsOfMaterials.DeletionMark
	AND CatalogBillsOfMaterials.Ref IN (&amp;BOMList)
	AND &amp;SelectionTextWorkCenterType</queryText>
      <mainTable>Catalog.BillsOfMaterials</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
