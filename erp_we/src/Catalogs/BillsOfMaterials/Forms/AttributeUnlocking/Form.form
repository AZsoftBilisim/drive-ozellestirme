  <formCommands>
    <name>EnableEdit</name>
    <title>
      <key>en</key>
      <value>Set status &quot;Under development&quot;</value>
    </title>
    <title>
      <key>fa</key>
      <value>تعیین وضعیت «در حال توسعه»</value>
    </title>
    <title>
      <key>it</key>
      <value>Imposta lo stato &quot;In elaborazione&quot;</value>
    </title>
    <title>
      <key>pl</key>
      <value>Ustaw status &quot;В разработке&quot;</value>
    </title>
    <title>
      <key>ru</key>
      <value>Установить статус &quot;В разработке&quot;</value>
    </title>
    <title>
      <key>tr</key>
      <value>&quot;Geliştirme aşamasında&quot; durumunu yapılandır</value>
    </title>
    <title>
      <key>vi</key>
      <value>Đặt trạng thái &quot;Đang phát triển&quot;</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Set status &quot;Under development&quot; and allow editing.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>تعیین وضعیت «در حال توسعه» و اجازه ویرایش.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Impostare lo stato &quot;In elaborazione&quot; e consentire la modifica.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Ustaw status &quot;В разработке&quot; i zezwól na edycję.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Установить статус &quot;В разработке&quot; и разрешить редактирование.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>&quot;Geliştirme aşamasında&quot; durumunu yapılandır ve düzenlemeye izin ver.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đặt trạng thái &quot;Đang phát triển&quot; và cho phép chỉnh sửa.</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
