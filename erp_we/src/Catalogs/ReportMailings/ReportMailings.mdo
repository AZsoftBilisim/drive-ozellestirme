    <synonym>
      <key>tr</key>
      <value>Port</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cổng</value>
    </synonym>
    <type>
      <types>Number</types>
      <numberQualifiers>
        <precision>5</precision>
        <nonNegative>true</nonNegative>
      </numberQualifiers>
    </type>
    <toolTip>
      <key>en</key>
      <value>Specify the FTP server port in the range between 0 and 65535.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>پورت سرور FTP را در بازه 0 تا 65535 مشخص کنید.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Porta del server FTP può essere specificata nel range compreso tra 0 e 65535.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Port serwera FTP może być zadany w zakresie od 0 do 65535.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Порт FTP сервера может быть задан в диапазоне от 0 до 65535.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Dosya Aktarma Protokolu sunucusu bağlantı noktası 0 ila 65535 arasında ayarlanabilir.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Có thể thiết lập cổng Server FTP trong khoảng từ 0 đến 65535.</value>
    </toolTip>
    <minValue xsi:type="core:StringValue">
      <value>0</value>
    </minValue>
    <maxValue xsi:type="core:StringValue">
      <value>65535</value>
    </maxValue>
    <fillFromFillingValue>true</fillFromFillingValue>
    <fillValue xsi:type="core:NumberValue">
      <value>21</value>
    </fillValue>
    <dataHistory>Use</dataHistory>
  </attributes>
