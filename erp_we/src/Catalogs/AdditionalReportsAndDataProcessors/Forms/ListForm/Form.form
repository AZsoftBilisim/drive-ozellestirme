  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.FileName</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsReport</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ObjectName</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Publication</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Table.Ref,
	Table.DeletionMark,
	Table.Description,
	Table.Version,
	Table.EmployeeResponsible,
	Table.Publication,
	Table.Kind,
	Table.ObjectName,
	Table.IsFolder,
	CASE
		WHEN Table.Kind IN (&amp;AddlReportsKinds)
			THEN TRUE
		ELSE FALSE
	END AS IsReport,
	Table.FileName
FROM
	Catalog.AdditionalReportsAndDataProcessors AS Table
WHERE
	CASE
			WHEN Table.IsFolder
				THEN TRUE
			WHEN &amp;PublicationFilter = UNDEFINED
				THEN TRUE
			WHEN &amp;PublicationFilter = 1
				THEN Table.Publication IN (&amp;AllPublicationsExceptDisabled)
			ELSE Table.Publication = &amp;PublicationFilter
		END
	AND CASE
			WHEN Table.IsFolder
				THEN TRUE
			WHEN &amp;KindFilter = UNDEFINED
				THEN TRUE
			WHEN &amp;KindFilter = 1
				THEN Table.Kind IN (&amp;AddlReportsKinds)
			WHEN &amp;KindFilter = 2
				THEN NOT Table.Kind IN (&amp;AddlReportsKinds)
			ELSE Table.Kind = &amp;KindFilter
		END</queryText>
      <mainTable>Catalog.AdditionalReportsAndDataProcessors</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
