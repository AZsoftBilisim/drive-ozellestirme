            <name>DecorationEnablingSecurityProfilesLabelExtendedTooltip</name>
            <id>308</id>
            <type>Label</type>
            <autoMaxWidth>true</autoMaxWidth>
            <autoMaxHeight>true</autoMaxHeight>
