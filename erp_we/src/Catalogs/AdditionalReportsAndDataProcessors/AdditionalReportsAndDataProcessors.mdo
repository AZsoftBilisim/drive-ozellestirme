  <attributes uuid="518dcd70-4ccf-4866-a94f-7ceec7dd2801">
    <name>UseOptionStorage</name>
    <synonym>
      <key>en</key>
      <value>Uses option storage</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>از محل ذخیره گزینه‌ها استفاده می‌کند</value>
    </synonym>
    <synonym>
      <key>it</key>
