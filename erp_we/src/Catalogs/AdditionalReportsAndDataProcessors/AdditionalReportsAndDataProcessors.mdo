      <value>Viene compilato automaticamente alla connessione del report/elaborazione aggiuntivi.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Wypełnia się automatycznie przy podłączeniu dodatkowego raportu/opracowania.</value>
    </toolTip>
    <toolTip>
