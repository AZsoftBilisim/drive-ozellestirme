    <showInFooter>true</showInFooter>
    <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
      <choiceList>
        <presentation>
          <key>en</key>
          <value>Not recorded on accounts</value>
        </presentation>
        <presentation>
          <key>fa</key>
