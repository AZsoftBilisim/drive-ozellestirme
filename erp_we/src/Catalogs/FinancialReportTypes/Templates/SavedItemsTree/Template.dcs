				<v8:lang>vi</v8:lang>
				<v8:content>Bảng chỉ số theo hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:EnumRef.FinancialReportItemKinds</v8:Type>
		</valueType>
		<value xsi:type="dcscor:DesignTimeValue">Enum.FinancialReportItemKinds.TableIndicatorsInRows</value>
		<useRestriction>true</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>TableIndicatorsInColumns</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Table budgeting items in columns</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اقلام بودجه‌بندی جدول در ستون‌ها</v8:content>
