		<dataSource>DataSource1</dataSource>
		<query>SELECT
	TablesChartsOfAccounts.Ref AS Ref
INTO UnavailableTypesOfFinancialStatements
FROM
	Catalog.FinancialReportTypes.ChartsOfAccounts AS TablesChartsOfAccounts
WHERE
	NOT TablesChartsOfAccounts.ChartOfAccounts IN (&amp;ChartsOfAccounts)

INDEX BY
	Ref
;

////////////////////////////
SELECT
	FinReportElements.Owner AS ReportKind,
	TRUE AS ThisIsReference,
	FinReportElements.ItemKind AS ItemKind,
	FinReportElements.Parent AS Parent,
	FinReportElements.Ref AS LinkedItem1,
	FinReportElements.Description AS Description,
	FinReportElements.NameForPrinting AS NameForPrinting,
	FinReportElements.Code AS Code,
	FinReportElements.HasSettings AS HasSettings,
	FinReportElements.ReverseSign AS ReverseSign,
	GLAccount_.Value AS GLAccount_,
	TotalType.Value AS TotalType,
	OpeningBalance.Value AS OpeningBalance,
	NonMonetaryItem.Value AS NonMonetaryItem,
	DisplayItemTitle.Value AS DisplayItemTitle,
	FALSE AS IsFolder,
	FALSE AS ThisIsAnExtraDimension
FROM
	Catalog.FinancialReportItems AS FinReportElements
	LEFT JOIN Catalog.FinancialReportItems.ItemKindAttributes AS GLAccount_
	ON FinReportElements.Ref = GLAccount_.Ref
		AND GLAccount_.Attribute = &amp;GLAccount_
	LEFT JOIN Catalog.FinancialReportItems.ItemKindAttributes AS TotalType
	ON FinReportElements.Ref = TotalType.Ref
		AND TotalType.Attribute = &amp;TotalType
	LEFT JOIN Catalog.FinancialReportItems.ItemKindAttributes AS OpeningBalance
	ON FinReportElements.Ref = OpeningBalance.Ref
		AND OpeningBalance.Attribute = &amp;OpeningBalance
	LEFT JOIN Catalog.FinancialReportItems.ItemKindAttributes AS NonMonetaryItem
	ON FinReportElements.Ref = NonMonetaryItem.Ref
		AND NonMonetaryItem.Attribute = &amp;NonMonetaryItem
	LEFT JOIN Catalog.FinancialReportItems.ItemKindAttributes AS DisplayItemTitle
	ON FinReportElements.Ref = DisplayItemTitle.Ref
		AND DisplayItemTitle.Attribute = &amp;DisplayItemTitle
WHERE
	VALUETYPE(FinReportElements.Owner) = TYPE(Catalog.FinancialReportTypes)
	AND FinReportElements.LinkedItem1 = VALUE(Catalog.FinancialReportItems.EmptyRef) 
	AND FinReportElements.DeletionMark = FALSE
	AND FinReportElements.ItemKind IN (&amp;AvailableItemKinds)
	AND (FinReportElements.Owner &lt;&gt; &amp;CurrentReport OR &amp;CurrentReport = UNDEFINED)
	AND NOT (FinReportElements.Owner IN
		(SELECT
			UnavailableTypesOfFinancialStatements.Ref
		FROM
			UnavailableTypesOfFinancialStatements AS UnavailableTypesOfFinancialStatements
		)
	)
	AND (&amp;DisplayComplexTableItems
			OR NOT FinReportElements.Ref IN
					(SELECT
						Catalog.Operand
					FROM
						Catalog.FinancialReportItems.FormulaOperands AS Catalog
					WHERE
						VALUETYPE(Catalog.Ref.Owner) = TYPE(Catalog.FinancialReportTypes)
		
					UNION ALL
		
					SELECT
						Catalog.Item
					FROM
						Catalog.FinancialReportItems.TableItems AS Catalog
					WHERE
						VALUETYPE(Catalog.Ref.Owner) = TYPE(Catalog.FinancialReportTypes)))</query>
	</dataSet>
	<calculatedField>
		<dataPath>CustomPicture</dataPath>
		<expression>FinancialReportingCached.CustomPicture
	(ItemKind,
	Case 
		When ItemKind = &amp;Rows And Parent.ItemKind = &amp;TableIndicatorsInRows Then "Return"
		When ItemKind = &amp;Columns And Parent.ItemKind = &amp;TableIndicatorsInColumns Then "Return"
		Else  FinancialReportingServer.ChartOfAccountsValueOfReportElement(LinkedItem1, &amp;CacheAccountPlansForReportElements)
	 End)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Custom picture</v8:content>
			</v8:item>
			<v8:item>
