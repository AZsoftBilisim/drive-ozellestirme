		<dataSource>DataSource1</dataSource>
		<query>SELECT
	FinReportElements.Parent,
	FinReportElements.ItemKind AS ItemKind,
	FinReportElements.Ref AS ReportItem,
	CASE
		WHEN FinReportElements.LinkedItem1 = VALUE(Catalog.FinancialReportItems.EmptyRef)
			THEN FinReportElements.Ref
		ELSE FinReportElements.LinkedItem1
	END AS ReportItemIsAnAssociatedItem,
	FinReportElements.NameForPrinting,
	FinReportElements.ReverseSign AS ReverseSign,
	FinReportElements.HasSettings AS HasSettings,
	FinReportElements.LinkedItem1 AS LinkedItem1,
	FinReportElements.Comment AS Comment,
	FinReportElements.AdditionalSelection AS AdditionalSelection,
	CASE
		WHEN FinReportElements.LinkedItem1 = VALUE(Catalog.FinancialReportItems.EmptyRef)
			THEN FALSE
		ELSE TRUE
	END AS ThisIsReference,
	FinReportElements.Code,
	"" AS AddressOfItemStructure,
	"" AS AccountIndicatorDimension,
	&amp;ReportKind AS ReportKind
FROM
	Catalog.FinancialReportItems AS FinReportElements
WHERE
	FinReportElements.Owner = &amp;ReportKind
	AND FinReportElements.DeletionMark = FALSE
	AND FinReportElements.Parent IN(&amp;Parents)
	AND (&amp;DisplayComplexTableItems
			OR NOT FinReportElements.Ref IN
					(SELECT
						Catalog.Operand
					FROM
						Catalog.FinancialReportItems.FormulaOperands AS Catalog
					WHERE
						Catalog.Ref.Owner = &amp;ReportKind
		
					UNION ALL
		
					SELECT
						Catalog.Item
					FROM
						Catalog.FinancialReportItems.TableItems AS Catalog
					WHERE
						Catalog.Ref.Owner = &amp;ReportKind))</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>LinksToElementsOfThisReport</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>LinkedItem1</dataPath>
			<field>LinkedItem1</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ItemRef</dataPath>
			<field>ItemRef</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Reference to the item</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>ارجاع به قلم</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Link sull'elemento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Odnośnik do elementu</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ссылка на элемент</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Öge referansı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tham chiếu đến phần tử</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 1
	ElementsOfOtherReports.Ref AS ItemRef,
	ElementsOfOtherReports.LinkedItem1 AS LinkedItem1
FROM
	Catalog.FinancialReportItems AS ElementsOfOtherReports
WHERE
	ElementsOfOtherReports.LinkedItem1 = &amp;LinkedItem1
	AND NOT ElementsOfOtherReports.DeletionMark
	AND NOT(ElementsOfOtherReports.ItemKind = VALUE(Enum.FinancialReportItemKinds.Columns)
				OR ElementsOfOtherReports.ItemKind = VALUE(Enum.FinancialReportItemKinds.Rows))</query>
	</dataSet>
