		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 1
	FinReportElements.Ref AS ReportItemByReference,
	FinReportElements.ReverseSign AS ReverseSignOfReference
FROM
	Catalog.FinancialReportItems AS FinReportElements
WHERE
	FinReportElements.Ref = &amp;LinkedItem1
	AND FinReportElements.DeletionMark = FALSE
	AND NOT(FinReportElements.ItemKind = VALUE(Enum.FinancialReportItemKinds.Columns)
				OR FinReportElements.ItemKind = VALUE(Enum.FinancialReportItemKinds.Rows))
	AND (
	&amp;DisplayComplexTableItems
		OR 
		NOT FinReportElements.Ref IN
				(SELECT
					Catalog.Operand
				FROM
					Catalog.FinancialReportItems.FormulaOperands AS Catalog
		
				UNION ALL
		
				SELECT
					Catalog.Item
				FROM
					Catalog.FinancialReportItems.TableItems AS Catalog)
	)</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>ReportItems</sourceDataSet>
		<destinationDataSet>ReportItems</destinationDataSet>
		<sourceExpression>ReportItem</sourceExpression>
		<destinationExpression>Parent</destinationExpression>
		<parameter>Parents</parameter>
		<parameterListAllowed>false</parameterListAllowed>
		<startExpression>Value(Catalog.FinancialReportItems.EmptyRef)</startExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>ReportItems</sourceDataSet>
		<destinationDataSet>LinksToElementsOfThisReport</destinationDataSet>
		<sourceExpression>ReportItem</sourceExpression>
		<destinationExpression>LinkedItem1</destinationExpression>
		<parameter>LinkedItem1</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>ReportItems</sourceDataSet>
		<destinationDataSet>ReferenceSourcesOfThisReport</destinationDataSet>
		<sourceExpression>LinkedItem1</sourceExpression>
		<destinationExpression>ReportItemByReference</destinationExpression>
		<parameter>LinkedItem1</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<calculatedField>
		<dataPath>CustomPicture</dataPath>
		<expression>FinancialReportingCached.CustomPicture
	(ItemKind,
	Case 
		When ItemKind = &amp;Rows And Parent.ItemKind = &amp;TableIndicatorsInRows Then "Return"
		When ItemKind = &amp;Columns And Parent.ItemKind = &amp;TableIndicatorsInColumns Then "Return"
		Else  FinancialReportingServer.ChartOfAccountsValueOfReportElement(ReportItemIsAnAssociatedItem, &amp;CacheAccountPlansForReportElements)
	 End)
+ Case When ThisIsReference Then 1 
When Not ItemRef Is NULL Then 2 
Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Custom picture</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تصویر سفارشی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Immagine personalizzata</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Obrazek niestandardowy</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Нестандартная картинка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Standart olmayan resim</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Hình ảnh tùy chỉnh</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>3</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ThereAreRefs</dataPath>
		<expression>Case When ItemRef Is NULL Then False Else True End</expression>
		<title xsi:type="v8:LocalStringType">
