#Region Private

Function ProcessingPortionSize()
	Return 10000;
EndFunction

Procedure DataProcessing_1_9_16(CatalogObject, CatalogRef)
	
	If CatalogObject = Undefined Then
		AttributesValues = Common.ObjectAttributesValues(CatalogRef, 
			"Description,
			|SKU,
			|ProductsAndServicesCode,
			|Barcode,
			|DescriptionHash,
			|ItemIDHash,
			|ItemCodeHash,
			|BarcodeHash,
			|IsFolder,
			|DeletionMark,
			|Invalid");
	Else
		AttributesValues = CatalogObject;
	EndIf;
	
	If AttributesValues.IsFolder
		Or AttributesValues.DeletionMark
		Or AttributesValues.Invalid Then
		Return;
	EndIf;
	
	Source_Keys = ProductCrossReferencesMappingInternal.HashesOfNaturalKeysOfNomenclature("", "", "", "");
	FillPropertyValues(Source_Keys, AttributesValues);
	NewKeys = ProductCrossReferencesMappingInternal.HashesOfNaturalKeysOfNomenclature(
		AttributesValues.Description,
		AttributesValues.SKU,
		AttributesValues.ProductsAndServicesCode,
		AttributesValues.Barcode);
	
	If Not Common.DataMatch(Source_Keys, NewKeys) Then
		If CatalogObject = Undefined Then
			CatalogObject = CatalogRef.GetObject();
		EndIf;
		FillPropertyValues(CatalogObject, NewKeys);
	EndIf;
	
EndProcedure

