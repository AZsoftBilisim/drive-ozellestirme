// See InfobaseUpdateSSL.OnAddUpdateHandlers
Procedure OnAddUpdateHandlers(Handlers) Export
	
	Handler = Handlers.Add();
	Handler.Version = "1.9.16.3";
	Handler.ExecutionMode = "Deferred";
	Handler.Procedure = "Catalogs.ProductCrossReferences.ProcessDataForMigrationToNewVersion";
	Handler.Id = New UUID("fb76cdda-86cd-40bb-8f06-1f0b3346c160");
	Handler.Multithreaded = True;
	Handler.UpdateDataFillingProcedure = 
		"Catalogs.ProductCrossReferences.RegisterDataToProcessForMigrationToNewVersion";
	Handler.DeferredProcessingQueue = 1;
	Handler.CheckProcedure = "InfobaseUpdate.DataUpdatedForNewApplicationVersion";
	Handler.ObjectsToRead = "Catalog.ProductCrossReferences";
	Handler.ObjectsToChange = "Catalog.ProductCrossReferences";
	Handler.ObjectsToLock = "";
	Handler.Comment = NStr("ru = 'Обновляются данные справочника номенклатура контрагентов:
	|* [1.9.16] заполняются хеши натуральных ключей.';
	|vi = 'Updating the Partner products catalog data:
	|* [1.9.16]Natural key hashes are filled.';
	|en = 'Updating the Partner products catalog data:
	|* [1.9.16]Natural key hashes are filled.'; fa = 'Updating the Partner products catalog data:
	|* [1.9.16]Natural key hashes are filled.';
	|it = 'Updating the Partner products catalog data:
	|* [1.9.16]Natural key hashes are filled.';
	|pl = 'Updating the Partner products catalog data:
	|* [1.9.16]Natural key hashes are filled.';
	|tr = 'Cari hesap öğeleri kataloğunun verileri güncelleniyor:
	|* [1.9.16] doğal anahtar hash''leri dolduruluyor.'");
	Handler.ExecutionPriorities = InfobaseUpdate.HandlerExecutionPriorities();
	
EndProcedure
	
// Registers data for the update handler
// 
// Parameters:
//  Parameters - See InfobaseUpdate.MainProcessingMarkParameters
//
Procedure RegisterDataToProcessForMigrationToNewVersion(Parameters) Export
	
	SelectionParameters = Parameters.SelectionParameters;
	SelectionParameters.FullNamesOfObjects = EmptyRef().Metadata().FullName();
	SelectionParameters.SelectionMethod = InfobaseUpdate.RefsSelectionMethod();
	
	PortionSize = ProcessingPortionSize();
	
	Query = New Query;
	Query.Text = 
	"SELECT TOP 10000
	|	ProductCrossReferences.Ref AS Ref
	|FROM
	|	Catalog.ProductCrossReferences AS ProductCrossReferences
	|WHERE
	|	ProductCrossReferences.Ref > &Cursor
	|	AND NOT ProductCrossReferences.IsFolder
	|	AND NOT ProductCrossReferences.DeletionMark
	|	AND NOT ProductCrossReferences.Invalid
	|
	|ORDER BY
	|	Ref";
	
	Query.Text = StrReplace(Query.Text, "10000", Format(PortionSize, "NG=0;"));
	
	Cursor = EmptyRef();
	
	While True Do
		
		Query.SetParameter("Cursor", Cursor);
		
		References = Query.Execute().Unload().UnloadColumn("Ref");
		RowsCount = References.Count();
		
		InfobaseUpdate.MarkForProcessing(Parameters, References);
		
		If RowsCount < PortionSize Then
			Break;
		Else
			Cursor = References[RowsCount - 1];
		EndIf;
		
	EndDo;
	
EndProcedure
	
// BAD update handler 1.9.16
//
// Performs the calculation of hashes of natural keys.
// 
// Parameters:
//  Parameters - See InfobaseUpdate.MainProcessingMarkParameters
//
Procedure ProcessDataForMigrationToNewVersion(Parameters) Export
	
	FullObjectName = EmptyRef().Metadata().FullName();
	UpdatedData = InfobaseUpdate.DataToUpdateInMultithreadHandler(Parameters);
	HasErrors = False;
	
	For Each Catalog In UpdatedData Do
		
		BeginTransaction();
		Try
			
			GeneralPurposeEDL.SetManagedLockOnLink(Catalog.Ref);
			
			CatalogObject = Undefined;
			DataProcessing_1_9_16(CatalogObject, Catalog.Ref);
			
			If CatalogObject = Undefined Then
				InfobaseUpdate.MarkProcessingCompletion(Catalog.Ref);
			Else
				InfobaseUpdate.WriteObject(CatalogObject);
			EndIf;
			
			CommitTransaction();
			
		Except
			
			RollbackTransaction();
			MessageText = StrTemplate(NStr("ru = 'Не удалось обработать объект: %1 по причине: %2';
											|vi = 'Cannot process the %1 object. Reason: %2';
											|en = 'Cannot process the %1 object. Reason: %2'; fa = 'Cannot process the %1 object. Reason: %2';
											|it = 'Cannot process the %1 object. Reason: %2';
											|pl = 'Cannot process the %1 object. Reason: %2';
											|tr = 'Nesne işlenemedi: %1, sebep: %2'"),
				Catalog.Ref,
				ErrorProcessing.DetailErrorDescription(ErrorInfo()));
			WriteLogEvent(InfobaseUpdate.EventLogEvent(),
				EventLogLevel.Error,
				Catalog.Ref.Metadata(),
				Catalog.Ref,
				MessageText);
			
			HasErrors = True;
			
		EndTry;
		
	EndDo;
	
	If HasErrors Then
		Raise NStr("ru = 'Не удалось обработать справочник ""Номенклатура контрагентов""';
					|vi = 'Cannot process the ""Partner products"" catalog';
					|en = 'Cannot process the ""Partner products"" catalog'; fa = 'Cannot process the ""Partner products"" catalog';
					|it = 'Cannot process the ""Partner products"" catalog';
					|pl = 'Cannot process the ""Partner products"" catalog';
					|tr = '""Cari hesap öğeleri"" kataloğu işlenemedi'");
	EndIf;
	
	Parameters.ProcessingCompleted = InfobaseUpdate.DataProcessingCompleted(Parameters.Queue, 
		FullObjectName);
	
EndProcedure

// End StandardSubsystems.IBVersionUpdate

// StandardSubsystems.DuplicateObjectsDetection

// Is called to determine the application parameters of the search takes.
//
// Parameters:
//
//  SearchParameters - Structure - Suggested search options. Contains fields:
//   * SearchRules - ValueTable - suggested comparison rules for objects, can be changed to set new options:
//     ** Attribute - String - name of the prop to compare.
//     ** Rule  - String - Comparison rule: "Equal" - comparison by equality, "Like" - similarity of strings,
//                                                    "" - empty string - do not compare.
//   * FilterComposer - DataCompositionSettingsComposer - Initialized by the linker for pre-selection.
//                                                               It can be changed, for example, to enhance selections.
//   * ComparisonRestrictions - Array - it is intended for filling in the description of application rules-restrictions, it must be supplemented with structures with fields:
//     ** Presentation      - String - Description of the rule-restrictions for the user.
//     ** AdditionalFields - String - A comma-separated list of additional details required for additional analysis.
// 
//   * ItemsCountToCompare - Number - The number of duplicate candidates passed by a single call to the handler.
//  AdditionalParameters - Arbitrary - The value passed when calling the General purpose programming interface.Nitidulidae.
//                                           When the user of the processing "of Piscinamanna" is equal to Undefined.
//
Procedure DuplicatesSearchParameters(SearchParameters, AdditionalParameters = Undefined) Export
	
	SearchRules = SearchParameters.SearchRules;
	For Each SearchRule In SearchRules Do
		If SearchRule.Attribute = "ItemOwner"
			Or SearchRule.Attribute = "Id" Then
			SearchRule.Rule = "Equal";
		Else
			SearchRule.Rule = "";
		EndIf;
	EndDo;
	
	ComposerSelectionSettings = SearchParameters.FilterComposer.Settings;
	
	CommonClientServer.SetFilterItem(
		ComposerSelectionSettings.Filter,
		"DeletionMark",
		True,
		DataCompositionComparisonType.Equal,,
		True);
		
	CommonClientServer.SetFilterItem(
		ComposerSelectionSettings.Filter,
		"Invalid",
		False,
		DataCompositionComparisonType.Equal,,
		True);
	
EndProcedure

// Called to determine duplicates based on application rules.
//
// Parameters:
//  CandidatesTable       - ValueTable - describes candidates for doubles. Contains columns:
//   * Ref1  - AnyRef - a reference to the first candidate element.
//   * Ref2  - AnyRef - a reference to the second candidate element.
//   * IsDuplicates - Boolean      - flag that the candidates are indeed duplicates. The default 
//                              value is False, and can be changed to True if the candidates are indeed duplicates.
//   * Fields1    - Structure   - contains the Code, Name, and additional fields of the first candidate
//                              specified in the Searchable Parameters.
//   * Fields2    - Structure   - contains the Code, Name, and additional fields of the second candidate
//                              specified in the Searchable Parameters.
//  AdditionalParameters - Arbitrary - the value passed when calling the program interface
//                                           General purpose.Find the subelements.When called by the user 
//                                           from the "Search for submenadables" processing, the value is Undefined.
//
Procedure OnSearchForDuplicates(CandidatesTable, AdditionalParameters = Undefined) Export
	
	For Each Variant In CandidatesTable Do
		If Variant.Fields1.ItemOwner = Variant.Fields2.ItemOwner And Variant.Fields1.Id = Variant.Fields2.Id Then
			Variant.IsDuplicates = True;
		EndIf;
	EndDo;
	
EndProcedure

// End StandardSubsystems.DuplicateObjectsDetection

