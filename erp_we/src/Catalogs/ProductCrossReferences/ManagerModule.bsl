// Returns the full name of the counterparty's item.
//
// Parameters:
//  Products   - String - name of the item.
//  Characteristic - String - name of the characteristic.
//  Package       - String - name of the package or unit of measurement.
//
// Returns:
//  String - the full name of the counterparty's nomenclature.
//
Function FullNameOfCounterpartyProducts(Val Products, Val Characteristic, Val Package) Export
	
	Return Products + ?(ValueIsFilled(Characteristic), " (" + Characteristic + ")", "")
		+ ?(ValueIsFilled(Package), ", " + Package, "");
	
EndFunction
	
// Returns the ID generated by the name of the counterparty's item data.
//
// Parameters:
//  Products   - String - name of the item.
//  Characteristic - String - name of the characteristic.
//  Package       - String - name of the package or unit of measurement.
//
// Returns:
//  String - id of the counterparty's item.
//
Function IDOfCounterpartyProductItemByName(Val Products, Val Characteristic, Val Package) Export
	
	Return ProductCrossReferencesMapping.ProductIDAccordingToProductData(
						Products, Characteristic, Package);
	
EndFunction

// Returns the ID of the counterparty's item.
//
// Parameters:
//  Products   - String - the identification of the item.
//  Characteristic - String - ID of the characteristic.
//  Package       - String - ID of the package or unit of measurement.
//
// Returns:
//  String - id of the counterparty's item.
//
Function IDOfCounterpartyProductItem(Val Products, Val Characteristic, Val Package) Export
	
	Return Products + "#" + Characteristic + "#" + Package;
	
EndFunction

