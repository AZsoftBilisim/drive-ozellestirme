  <attributes>
    <name>UsersList</name>
    <title>
      <key>en</key>
      <value>User list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست کاربران</value>
    </title>
    <title>
      <key>it</key>
      <value>Utenti dell'elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Użytkownicy lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Пользователи список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Kullanıcı listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Người sử dụng danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.CanChangePassword</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.Invalid</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Users.Ref AS Ref,
	Users.Prepared AS Prepared,
	Users.DeletionMark AS DeletionMark,
	Users.Invalid AS Invalid,
	Users.Description AS Description,
	Users.IsInternal AS IsInternal,
	Users.Comment AS Comment,
	-1 AS PictureNumber,
	CASE
		WHEN Users.IsInternal
			THEN FALSE
		WHEN Users.Invalid
			THEN FALSE
		WHEN Users.IBUserID = &amp;CurrentIBUserID
			THEN TRUE
		WHEN &amp;CanChangeOwnPasswordOnly
			THEN FALSE
		WHEN Users.IBUserID = &amp;BlankUUID
			THEN FALSE
		ELSE TRUE
	END AS CanChangePassword,
	Users.IBUserID AS IBUserID,
	UsersInfo.*
FROM
	Catalog.Users AS Users
		{LEFT JOIN InformationRegister.UsersInfo AS UsersInfo
		ON (UsersInfo.User = Users.Ref)}
WHERE
	CASE
			WHEN &amp;AllUsers
				THEN TRUE
			WHEN &amp;SelectHierarchy
				THEN TRUE IN
						(SELECT
							TRUE
						FROM
							InformationRegister.UserGroupCompositions AS UserGroupCompositions
						WHERE
							UserGroupCompositions.User = Users.Ref
							AND UserGroupCompositions.UsersGroup = &amp;UsersGroup)
			ELSE TRUE IN
					(SELECT
						TRUE
					FROM
						Catalog.UserGroups.Content AS UserGroupsComposition
					WHERE
						UserGroupsComposition.User = Users.Ref
						AND UserGroupsComposition.Ref = &amp;UsersGroup)
		END</queryText>
      <mainTable>Catalog.Users</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>UserGroups</name>
    <title>
      <key>en</key>
