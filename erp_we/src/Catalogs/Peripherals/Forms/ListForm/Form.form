  <attributes>
    <name>ListOfDevices</name>
    <title>
      <key>en</key>
      <value>Device list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست دستگاه‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco dispositivi</value>
    </title>
    <title>
      <key>pl</key>
      <value>LIsta urządzeń</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список устройств</value>
    </title>
    <title>
      <key>tr</key>
      <value>Cihaz listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách thiết bị</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDevices.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfDevices.КомпонентаПодключенияОборудования</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogPeripherals.Ref,
	CatalogPeripherals.DeletionMark,
	CatalogPeripherals.Description,
	CatalogPeripherals.DeviceIsInUse,
	CatalogPeripherals.AttachmentType,
	CatalogPeripherals.EquipmentType,
	CatalogPeripherals.HardwareDriver,
	CatalogPeripherals.Parameters,
	CatalogPeripherals.Workplace,
	CatalogPeripherals.Workplace.Code AS WorkplaceCode,
	CatalogPeripherals.Workplace.ComputerName AS ComputerName,
	CatalogPeripherals.ReinstallationIsRequired,
	CatalogPeripherals.AccessRestriction,
	CatalogPeripherals.Predefined,
	CatalogPeripherals.PredefinedDataName
FROM
	Catalog.Peripherals AS CatalogPeripherals</queryText>
      <mainTable>Catalog.Peripherals</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
