		<field xsi:type="DataSetFieldField">
			<dataPath>Characteristic</dataPath>
			<field>Characteristic</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Variant</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>گونه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Caratteristica</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Charakterystyka</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Характеристика</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Varyant</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đặc tính</v8:content>
				</v8:item>
			</title>
			<orderExpression>
				<dcscom:expression>Characteristic</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>true</dcscom:autoOrder>
			</orderExpression>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	NestedQuery.Products AS Products,
	NestedQuery.Characteristic AS Characteristic,
	NestedQuery.Count AS CountTurnover,
	NestedQuery.Revenue AS RevenueAmountTurnover,
	NestedQuery.Cost_ AS Cost_Turnover,
	NestedQuery.GrossProfit,
	NestedQuery.AddExpensesForGoods AS AddExpensesForGoodsTurnover
{SELECT
	Products.*,
	Characteristic.*}
FROM
	(SELECT
		RevenueAndCost.ItemsLocationAttributes.Products AS Products,
		RevenueAndCost.ItemsLocationAttributes.Characteristic AS Characteristic,
		SUM(RevenueAndCost.CountTurnover) AS Count,
		SUM(RevenueAndCost.RevenueAmountTurnover) AS Revenue,
		SUM(RevenueAndCost.CostTurnover) AS Cost_,
		SUM(CAST(RevenueAndCost.RevenueAmountTurnover - RevenueAndCost.AddExpensesForGoodsTurnover - RevenueAndCost.CostTurnover AS NUMBER(31,2))) AS GrossProfit,
		SUM(RevenueAndCost.AddExpensesForGoodsTurnover) AS AddExpensesForGoods
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;PeriodEnding)}, Auto, {(ItemsLocationAttributes.Products) AS Products, (ItemsLocationAttributes.Characteristic) AS Characteristic, (ItemsLocationAttributes.StorageLocation) AS Warehouse}) AS RevenueAndCost
	
	GROUP BY
		ItemsLocationAttributes.Products,
		ItemsLocationAttributes.Characteristic) AS NestedQuery
{WHERE
	NestedQuery.Count AS CountTurnover,
	NestedQuery.Revenue AS RevenueAmountTurnover,
	NestedQuery.Cost_ AS Cost_Turnover,
	NestedQuery.GrossProfit AS GrossProfit,
	NestedQuery.AddExpensesForGoods}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
