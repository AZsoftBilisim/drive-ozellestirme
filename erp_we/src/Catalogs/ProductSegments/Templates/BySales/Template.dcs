		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentProducts.Products AS Products,
	SegmentProducts.Characteristic AS Characteristic
INTO SegmentContent
FROM
	InformationRegister.SegmentProducts AS SegmentProducts
{WHERE
	SegmentProducts.Segment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RevenueAndCost.ItemsLocationAttributes.Products AS Products,
	RevenueAndCost.ItemsLocationAttributes.Characteristic AS ProductCharacteristic,
	RevenueAndCost.CountTurnover AS Count,
	RevenueAndCost.RevenueAmountTurnover AS Revenue,
	RevenueAndCost.CostTurnover AS Cost_,
	CAST(RevenueAndCost.RevenueAmountTurnover - RevenueAndCost.AddExpensesForGoodsTurnover - RevenueAndCost.CostTurnover AS NUMBER(31,2)) AS GrossProfit,
	RevenueAndCost.AddExpensesForGoodsTurnover AS AddExpensesForGoods,
	RevenueAndCost.ItemsLocationAttributes.StorageLocation AS Warehouse,
	RevenueAndCost.Recorder AS Recorder
{SELECT
	Products.* AS SegmentProducts,
	ProductCharacteristic.* AS SegmentCharacteristic,
	Count,
	Revenue,
	Cost_,
	GrossProfit,
	AddExpensesForGoods,
	Warehouse.* AS PartnerWarehouse_,
	Recorder.*}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;PeriodEnding)},
			Auto,
			ItemsLocationAttributes.Products IN
					(SELECT DISTINCT
						SegmentContent.Products
					FROM
						SegmentContent AS SegmentContent)
				AND ItemsLocationAttributes.Characteristic IN
					(SELECT DISTINCT
						SegmentContent.Characteristic
					FROM
						SegmentContent AS SegmentContent) {(ItemsLocationAttributes.StorageLocation) AS Warehouse}) AS RevenueAndCost</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>GrossProfit</dataPath>
		<expression>Sum(GrossProfit)</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>AddExpensesForGoods</dataPath>
		<expression>Sum(AddExpensesForGoods)</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Sum(Cost_)</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Revenue</dataPath>
		<expression>Sum(Revenue)</expression>
		<group>Overall</group>
	</totalField>
