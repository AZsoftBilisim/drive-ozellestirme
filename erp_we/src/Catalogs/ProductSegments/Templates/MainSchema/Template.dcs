		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentProducts.Products AS Products,
	SegmentProducts.Characteristic AS Characteristic
INTO SegmentContent
FROM
	InformationRegister.SegmentProducts AS SegmentProducts
{WHERE
	SegmentProducts.Segment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SegmentContent.Products AS Products,
	SegmentContent.Characteristic AS Characteristic
{SELECT
	Products.* AS SegmentProducts,
	Characteristic.* AS SegmentCharacteristic}
FROM
	SegmentContent AS SegmentContent</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<settingsVariant>
		<dcsset:name>SegmentGeneration</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Generate segment</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
