  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	VATRates.Ref AS Ref,
	VATRates.DeletionMark AS DeletionMark,
	VATRates.Description AS Description,
	VATRates.Country AS Country,
	VATRates.BeginOfPeriod AS BeginOfPeriod,
	VATRates.EndOfPeriod AS EndOfPeriod,
	VATRates.Main AS Main,
	VATRates.Rate1 AS Rate1
FROM
	Catalog.VATRates AS VATRates
WHERE
	VATRates.Ref IN
			(SELECT
				TypesOfTaxation.Ref
			FROM
				Catalog.VATRates.VATTaxationTypes AS TypesOfTaxation
			WHERE
				(TypesOfTaxation.VATTaxationType = &amp;VATTaxationType
					OR &amp;VATTaxationType = VALUE(Enum.VATTaxationTypes.EmptyRef)))
	AND (&amp;UpdateDate = DATETIME(1, 1, 1)
			OR VATRates.BeginOfPeriod &lt;= &amp;UpdateDate
				AND (VATRates.EndOfPeriod = DATETIME(1, 1, 1)
					OR ENDOFPERIOD(VATRates.EndOfPeriod, DAY) >= &amp;UpdateDate))</queryText>
      <mainTable>Catalog.VATRates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Country</dataPath>
        <field>Country</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>RelevantBaseRate</dataPath>
        <field>RelevantBaseRate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>VATTaxationTypes</dataPath>
        <field>VATTaxationTypes</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>RelevantCalculatedRate</dataPath>
        <field>RelevantCalculatedRate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PaymentVATRate</dataPath>
        <field>PaymentVATRate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PredefinedDataName</dataPath>
        <field>PredefinedDataName</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DescriptionLanguage2</dataPath>
        <field>DescriptionLanguage2</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CalculatedRate</dataPath>
        <field>CalculatedRate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DescriptionLanguage1</dataPath>
        <field>DescriptionLanguage1</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Predefined</dataPath>
        <field>Predefined</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ref</dataPath>
