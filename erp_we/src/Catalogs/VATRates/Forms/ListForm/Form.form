        <dataPath>EndOfPeriod</dataPath>
        <field>EndOfPeriod</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Main</dataPath>
        <field>Main</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Predefined</dataPath>
        <field>Predefined</field>
      </fields>
