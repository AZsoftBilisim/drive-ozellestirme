    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomerClaimsOverridable.Description,
	CASE
		WHEN CustomerClaimsOverridable.Status = VALUE(Enum.CustomerComplaintStatuses.Registered1)
				OR CustomerClaimsOverridable.Status = VALUE(Enum.CustomerComplaintStatuses.InProcessing)
			THEN PRESENTATION(CustomerClaimsOverridable.Status)
		ELSE &amp;Discussed
	END AS StatusPresentation,
	CustomerClaimsOverridable.Status,
	CustomerClaimsOverridable.ComplaintDescription,
	CustomerClaimsOverridable.ProcessingResult,
	CustomerClaimsOverridable.RegistrationDate,
	CustomerClaimsOverridable.EndDate,
	CustomerClaimsOverridable.Ref
FROM
	Catalog.Complaints AS CustomerClaimsOverridable
WHERE
	CustomerClaimsOverridable.Partner = &amp;Partner
	AND NOT CustomerClaimsOverridable.ThisIsClaimToVendor</queryText>
      <mainTable>Catalog.Complaints</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
