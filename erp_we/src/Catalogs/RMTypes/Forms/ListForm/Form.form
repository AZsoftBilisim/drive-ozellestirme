    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RMTypes.Ref,
	RMTypes.DeletionMark,
	RMTypes.Owner,
	RMTypes.Description,
	RMTypes.GeneralRMType,
	RMTypes.Duration,
	RMTypes.UnitOfMeasureOfDuration,
	RMTypes.PlanningFrequency,
	RMTypes.Lookahead,
	RMTypes.ConsiderWorkSchedule,
	RMTypes.Comment,
	RMTypes.Predefined,
	RMTypes.PredefinedDataName,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Catalog.RMTypes AS RMTypes
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON RMTypes.Ref = FilesExist.ObjectWithFiles</queryText>
      <mainTable>Catalog.RMTypes</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
