  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBudgetFlowItems.Ref,
	CatalogBudgetFlowItems.DeletionMark,
	CatalogBudgetFlowItems.Predefined,
	CatalogBudgetFlowItems.Parent,
	CatalogBudgetFlowItems.IsFolder,
	CatalogBudgetFlowItems.Code,
	CatalogBudgetFlowItems.Description,
	CatalogBudgetFlowItems.LongDesc,
	CatalogBudgetFlowItems.DimensionKind1,
	CatalogBudgetFlowItems.DimensionKind2,
	CatalogBudgetFlowItems.DimensionKind3,
	CatalogBudgetFlowItems.DimensionKind4,
	CatalogBudgetFlowItems.DimensionKind5,
	CatalogBudgetFlowItems.DimensionKind6,
	CatalogBudgetFlowItems.NumberOfUsedDimensions
FROM
	Catalog.BudgetFlowItems AS CatalogBudgetFlowItems
WHERE
	CatalogBudgetFlowItems.DimensionKind1 = &amp;Dimension
	OR CatalogBudgetFlowItems.DimensionKind2 = &amp;Dimension
	OR CatalogBudgetFlowItems.DimensionKind3 = &amp;Dimension
	OR CatalogBudgetFlowItems.DimensionKind4 = &amp;Dimension
	OR CatalogBudgetFlowItems.DimensionKind5 = &amp;Dimension
	OR CatalogBudgetFlowItems.DimensionKind6 = &amp;Dimension
</queryText>
      <mainTable>Catalog.BudgetFlowItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>UnitOfMeasureIsDeterminedByDimension</dataPath>
        <field>UnitOfMeasureIsDeterminedByDimension</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>QuantityDimensionAddress</dataPath>
        <field>QuantityDimensionAddress</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DimensionUnitsOfMeasurement</dataPath>
