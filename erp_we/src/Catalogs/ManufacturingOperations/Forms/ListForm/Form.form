      <queryText>SELECT
	CatalogManufacturingOperations.Ref,
	CatalogManufacturingOperations.DeletionMark,
	CatalogManufacturingOperations.Owner,
	CatalogManufacturingOperations.Description,
	CatalogManufacturingOperations.OperationNumber,
	CatalogManufacturingOperations.NextOperation,
	CASE
		WHEN CatalogManufacturingOperations.WorkCenter REFS Catalog.WorkCenters
			THEN CAST(CatalogManufacturingOperations.WorkCenter AS Catalog.WorkCenters).WorkCenterType
		ELSE CatalogManufacturingOperations.WorkCenter
	END AS WorkCenterType,
	CatalogManufacturingOperations.ContainsNestedRoute,
	CatalogManufacturingOperations.Count,
	CatalogManufacturingOperations.UnitOfMeasure,
	CatalogManufacturingOperations.TimePerPiece,
	CatalogManufacturingOperations.TimePerPieceUnitOfMeasure,
	CatalogManufacturingOperations.SetupTime,
	CatalogManufacturingOperations.SetupTimeUnitOfMeasure
	
FROM
	Catalog.ManufacturingOperations AS CatalogManufacturingOperations</queryText>
