    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.CriticalityQueue</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Overdue</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.RegistrationDate</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Table.Ref AS Ref,
	Table.DeletionMark AS DeletionMark,
	Table.Code AS Code,
	Table.Description AS Description,
	Table.RegistrationDate AS RegistrationDate,
	Table.RequiredClosingDate AS RequiredClosingDate,
	BEGINOFPERIOD(Table.RequiredClosingDate, DAY) AS EventDate,
	CASE
		WHEN ISNULL(Table.RequiredClosingDate, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
			THEN FALSE
		ELSE CASE
				WHEN ISNULL(Table.ClosingDate, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
					THEN CASE
							WHEN DATEDIFF(BEGINOFPERIOD(Table.RequiredClosingDate, DAY), BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY) > 0
								THEN TRUE
							ELSE FALSE
						END
				ELSE CASE
						WHEN DATEDIFF(Table.RequiredClosingDate, Table.ClosingDate, DAY) > 0
							THEN TRUE
						ELSE FALSE
					END
			END
	END AS Overdue,
	Table.ClosingDate AS ClosingDate,
	Table.Status AS Status,
	Table.IncidentKind AS IncidentKind,
	Table.LongDesc AS LongDesc,
	Table.Decision AS Decision,
	Table.Severity AS Severity,
	Table.Severity.AddlOrderingAttribute AS CriticalityQueue,
	Table.Basis AS Basis,
	Table.Author AS Author,
	Table.Department AS Department,
	Table.SolvedBy AS SolvedBy,
	Table.Performer AS Performer,
	Table.AssigneeBusinessUnit AS AssigneeBusinessUnit,
	Table.Duplicate1 AS Duplicate1
FROM
	Catalog.Incidents AS Table</queryText>
      <mainTable>Catalog.Incidents</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
