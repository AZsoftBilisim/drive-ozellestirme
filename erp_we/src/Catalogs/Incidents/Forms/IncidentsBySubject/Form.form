    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Incidents.Ref,
	Incidents.DeletionMark,
	Incidents.Code,
	Incidents.Description,
	Incidents.RegistrationDate,
	Incidents.RequiredClosingDate,
	Incidents.ClosingDate,
	Incidents.Status,
	Incidents.IncidentKind,
	Incidents.LongDesc,
	Incidents.Decision,
	Incidents.Severity,
	Incidents.Basis,
	Incidents.Author,
	Incidents.Department,
	Incidents.SolvedBy,
	Incidents.Performer,
	Incidents.AssigneeBusinessUnit,
	Incidents.Duplicate1,
	Incidents.Predefined,
	Incidents.PredefinedDataName
FROM
	Catalog.Incidents AS Incidents
WHERE
	Incidents.Basis = &amp;Basis
	AND (&amp;ShowClosed OR 
	Incidents.Status = VALUE(Enum.IncidentStatuses.Registered))
	AND (&amp;ShowDeleted
	OR NOT Incidents.DeletionMark)</queryText>
      <mainTable>Catalog.Incidents</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
