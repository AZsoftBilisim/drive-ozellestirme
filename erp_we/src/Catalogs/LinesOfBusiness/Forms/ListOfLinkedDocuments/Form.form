  <attributes>
    <name>DocumentsList</name>
    <title>
      <key>en</key>
      <value>Document list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco di documenti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista dokumentów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Belge listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.PictureIndex</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>DocumentsList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED DISTINCT
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS PictureIndex,
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.RefType AS DocumentType,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.Sum AS Sum,
	DocumentsRegistry.Currency AS Currency
{SELECT
	Ref.*,
	DocumentType.*,
	Organization.*,
	BusinessOperation.*,
	Date,
	Number,
	Sum,
	Currency.*}
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
{WHERE
	(DocumentsRegistry.LineOfBusiness = &amp;RefFilter),
	(DocumentsRegistry.IBDocumentDate >= &amp;StartDate),
	(DocumentsRegistry.IBDocumentDate &lt;= &amp;EndDate),
	DocumentsRegistry.Ref.*,
	DocumentsRegistry.RefType.*,
	DocumentsRegistry.Organization.*,
	DocumentsRegistry.BusinessOperation.*,
	DocumentsRegistry.IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber,
	DocumentsRegistry.Sum,
	DocumentsRegistry.Currency.*}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
