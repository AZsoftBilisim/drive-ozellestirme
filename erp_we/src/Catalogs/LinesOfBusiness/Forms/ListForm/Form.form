    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Directions.Ref,
	Directions.DeletionMark,
	Directions.Parent,
	Directions.IsFolder,
	Directions.Description,
	Directions.Status,
	Directions.StartDateOfActivity,
	Directions.EndDateOfActivity,
	Directions.CostAccounting,
	Directions.VendorARAP,
	Directions.IncomeAccounting,
	CASE
		WHEN Directions.CashAndBankAccountsSeparately THEN &amp;OnAccounts
		WHEN Directions.CashAndBankAccountsByCorrespondence THEN &amp;ByCorrespondence
		ELSE &quot;                                      &quot;
	END AS CashManagement,
	Directions.CashAndBankAccountsSeparately,
	Directions.CashAndBankAccountsByCorrespondence,
	Directions.FixedAndIntangibleAssetsAccounting,
	Directions.Comment,
	Directions.AdditionalAttributes,
	Directions.Predefined,
	Directions.PredefinedDataName
FROM
	Catalog.LinesOfBusiness AS Directions</queryText>
      <mainTable>Catalog.LinesOfBusiness</mainTable>
