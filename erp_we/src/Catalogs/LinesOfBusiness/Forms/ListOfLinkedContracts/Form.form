    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>//The request changes when the form is created
SELECT ALLOWED
	CounterpartyContracts.Ref AS Ref,
	CounterpartyContracts.ContractType AS ContractType,
	CASE
		WHEN CounterpartyContracts.DeletionMark
			THEN 4
		ELSE 3
	END AS PictureIndex,
	CounterpartyContracts.Approved AS Approved,
	CounterpartyContracts.Status AS Status,
	CounterpartyContracts.Organization AS Organization,
	CounterpartyContracts.Number AS Number,
	CounterpartyContracts.NameForPrinting AS NameForPrinting,
	CounterpartyContracts.ValidityStartDate AS ValidityStartDate,
	CounterpartyContracts.ValidityEndDate AS ValidityEndDate,
	CounterpartyContracts.ARAPCurrency AS ARAPCurrency
{SELECT
	Ref.* AS Ref,
	ContractType AS ContractType,
	PictureIndex AS PictureIndex,
	Approved AS Approved,
	Status AS Status,
	Organization.* AS Organization,
	Number AS Number,
	NameForPrinting AS NameForPrinting,
	ValidityStartDate AS ValidityStartDate,
	ValidityEndDate AS ValidityEndDate,
	ARAPCurrency AS ARAPCurrency
}
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts</queryText>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
