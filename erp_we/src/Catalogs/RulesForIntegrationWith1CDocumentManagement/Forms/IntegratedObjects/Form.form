    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Ref,
	DeletionMark,
	Description,
	ObjectPresentationDM,
	ObjectPresentationIS,
	Comment
FROM
	Catalog.RulesForIntegrationWith1CDocumentManagement
WHERE
	ObjectTypeIS = &amp;ObjectTypeIS</queryText>
