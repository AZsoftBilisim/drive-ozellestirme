    <synonym>
      <key>en</key>
      <value>Joint application group</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>گروه اعمال مشترک</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Gruppo dell'applicazione condivisa</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Группа совместного применения</value>
    </synonym>
