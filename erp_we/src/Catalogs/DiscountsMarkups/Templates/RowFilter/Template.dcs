		<field xsi:type="DataSetFieldField">
			<dataPath>GoodsAvailabilityForCustomer</dataPath>
			<field>GoodsAvailabilityForCustomer</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Goods availability for customer</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>در دسترس بودن کالا برای مشتری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Disponibilità della merce per il cliente</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Dostępność towaru dla klienta</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Доступность товара для клиента</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Müşteri için ürün mevcutluğu</v8:content>
