					<v8:lang>vi</v8:lang>
					<v8:content>Tính khả dụng của hàng hóa đối với khách hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Products.Ref AS Products,
	ItemsCharacteristics.Ref AS Characteristic,
	PackagesAndUnitsOfMeasure.Ref AS Package,
	ItemsBatches.Ref AS Series,
	TypesOfPrices.Ref AS PriceKind,
	Warehouses.Ref AS Warehouse,
	WEEKDAY(ItemsBatches.ValidUntil_) AS NumberOfDaysBeforeExpirationPeriod,
	0 AS ConnectionKey,
	0 AS PricePerPackaging,
	0 AS Sum,
	0 AS ManualDiscount,
	0 AS Count
INTO TemplateTable_
FROM
	Catalog.Products AS Products
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON (TRUE)
		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		ON (TRUE)
		LEFT JOIN Catalog.ItemsBatches AS ItemsBatches
		ON (TRUE)
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TRUE)
		LEFT JOIN Catalog.Warehouses AS Warehouses
		ON (TRUE)
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	T.Products,
	T.Characteristic,
	TRUE AS FilterByListedGoodsIsUsed
INTO SelectingProductsFromList
FROM
	InformationRegister.ValidityOfDiscountsMarkupsByItems.SliceLast(&amp;CurrentDate, Source = &amp;Source {Products.* AS Products, Characteristic.* AS Characteristic}) AS T
WHERE
	T.Status = VALUE(Enum.DiscountValidityStatuses.Valid)

INDEX BY
	T.Products,
	T.Characteristic,
	FilterByListedGoodsIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS SelectionBasedOnNonProductSegmentIsUsed
INTO SelectionByNonProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS NotProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	SelectionBasedOnNonProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.Products   AS Products,
	T.Characteristic AS Characteristic,
	SUM(T.Count) AS Count,
	SUM(T.Sum) AS Sum
INTO IdenticalProducts
FROM
	TemplateTable_ AS T
GROUP BY
	T.Products,
	T.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.Products AS Products,
	SUM(T.Count) AS Count,
	SUM(T.Sum) AS Sum
INTO IdenticalProductsWithoutRegardToCharacteristics
FROM
	TemplateTable_ AS T
GROUP BY
	T.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		(Products, Characteristic, Warehouse, Purpose) IN(
			SELECT
				Filter.Products AS Products,
				Filter.Characteristic AS Characteristic,
				Filter.Warehouse AS Warehouse,
				VALUE(Catalog.Assignments.EmptyRef) AS Purpose
			FROM
				TemplateTable_ AS Filter)) AS Inventories
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FilterByProductCategory.ConnectionKey AS ConnectionKey
{SELECT
	ConnectionKey}
FROM
	TemplateTable_ AS FilterByProductCategory
		
		{LEFT JOIN CalculationOfBalancesForSettingActions AS Calculation
		ON Calculation.Products = FilterByProductCategory.Products
		 AND Calculation.Characteristic = FilterByProductCategory.Characteristic
		 AND Calculation.Warehouse = FilterByProductCategory.Warehouse}
		
		{LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
			ON &amp;SubstituteGoodsRestriction}
		
		{LEFT JOIN IdenticalProducts
		ON IdenticalProducts.Products = FilterByProductCategory.Products
		AND IdenticalProducts.Characteristic = FilterByProductCategory.Characteristic}
		
		{LEFT JOIN IdenticalProductsWithoutRegardToCharacteristics
		ON IdenticalProductsWithoutRegardToCharacteristics.Products = FilterByProductCategory.Products}
		
		{LEFT JOIN AccumulationRegister.RevenueAndCOGS.Turnovers(
				,
				&amp;CurrentDate,
				Auto,
				AccountingDimensionByPartners IN
					(SELECT
						AccountingDimensionByPartners.DimensionKey
					FROM
						InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
					WHERE
						AccountingDimensionByPartners.Partner = &amp;Partner AND AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.RetailCustomer))) AS RevenueAndCostOfSalesTurnover
		
		ON RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products = FilterByProductCategory.Products
		AND RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Characteristic = FilterByProductCategory.Characteristic}

{WHERE
	// Selection by nomenclature
	FilterByProductCategory.Products.* AS Products,
	FilterByProductCategory.Characteristic.* AS Characteristic,
	FilterByProductCategory.Package.* AS Package,
	FilterByProductCategory.Series.* AS Series,
	FilterByProductCategory.NumberOfDaysBeforeExpirationPeriod AS NumberOfDaysBeforeExpirationPeriod,
	((FilterByProductCategory.Products, FilterByProductCategory.Characteristic) IN
		(SELECT
			SelectingProductsFromList.Products,
			SelectingProductsFromList.Characteristic
		FROM
			SelectingProductsFromList
		WHERE
			SelectingProductsFromList.FilterByListedGoodsIsUsed = &amp;FilterByListedGoodsIsUsed)),
	((FilterByProductCategory.Products, FilterByProductCategory.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(NOT (FilterByProductCategory.Products, FilterByProductCategory.Characteristic) IN
		(SELECT
			SelectionByNonProductSegment.Products,
			SelectionByNonProductSegment.Characteristic
		FROM
			SelectionByNonProductSegment
		WHERE
			SelectionByNonProductSegment.SelectionBasedOnNonProductSegmentIsUsed = &amp;SelectionBasedOnNonProductSegmentIsUsed)),
	// Additional selection
	FilterByProductCategory.PriceKind.* AS PriceKind,
	
	IdenticalProducts.Count AS Count,
	IdenticalProducts.Sum AS Sum,
	IdenticalProductsWithoutRegardToCharacteristics.Count AS QuantityWithoutCharacteristics,
	IdenticalProductsWithoutRegardToCharacteristics.Sum AS AmountWithoutCharacteristics,
	
	CASE WHEN RevenueAndCostOfSalesTurnover.CountTurnover &lt;&gt; 0 THEN
		FALSE
	ELSE
		TRUE
	END AS CustomerPurchasesGoodsForTheFirstTime,
	
	CASE WHEN VALUE(Catalog.TypesOfPrices.EmptyRef) = FilterByProductCategory.PriceKind THEN TRUE ELSE FALSE END AS ArbitraryPriceIsSet,
	CASE
		WHEN ISNULL(Calculation.QuantityForShipAction, 0) &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		WHEN ISNULL(Calculation.QuantityForShipAction, 0)
				&lt;= (ProductRestrictions.MinimumInventoryQuantity)
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
		WHEN ISNULL(Calculation.QuantityForShipAction, 0)
				&lt; (ProductRestrictions.SafetyStockQuantity + ProductRestrictions.MinimumInventoryQuantity)
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
		WHEN ISNULL(Calculation.QuantityForShipAction, 0)
				&lt; ProductRestrictions.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
		WHEN ISNULL(Calculation.QuantityForShipAction, 0)
				&gt;= ProductRestrictions.MaximumInventoryAmount 
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
		ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
	END AS GoodsAvailabilityForCustomer,
	1 IN (
		SELECT 1
		FROM
			Catalog.TermsOfSale.Goods AS T
		WHERE
			T.Ref = &amp;Terms
			AND T.Products = FilterByProductCategory.Products
			AND T.Characteristic = FilterByProductCategory.Characteristic
			AND T.PriceKind = FilterByProductCategory.PriceKind
			AND T.Price = FilterByProductCategory.PricePerPackaging
			) AS PriceIsSameAsPriceOfAgreement
}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
