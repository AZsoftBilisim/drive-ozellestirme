  <attributes>
    <name>UseInStandardAgreementsWithCustomers</name>
    <title>
      <key>en</key>
      <value>Use in standard terms of sales</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده در شرایط استاندارد فروش</value>
    </title>
    <title>
      <key>it</key>
      <value>L'utilizzo negli accordi tipo</value>
    </title>
    <title>
      <key>pl</key>
      <value>Używanie w typowych umowach</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использование в типовых соглашениях</value>
    </title>
    <title>
      <key>tr</key>
      <value>Standart anlaşmalarda kullanım</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng trong thỏa thuận chung</value>
    </title>
    <id>16</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseStandardTermsOfSalesWithCustomers</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInStandardAgreementsWithCustomers.EndDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInStandardAgreementsWithCustomers.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	TermsOfSale.Ref AS Terms,
	TermsOfSale.Ref.Status AS AgreementStatus,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Status, VALUE(Enum.DiscountValidityStatuses.NotValid)) AS Status,
	CASE WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Status IS NULL THEN
		FALSE
	ELSE
		TRUE
	END AS Use,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Period, DATETIME(1,1,1)) AS StartDate,
	CASE WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Period IS NULL THEN
		ISNULL(DATEADD(TheEffectOfDiscountsMarkupsASliceOfTheFirst.Period, DAY, -1), DATETIME(1, 1, 1)) 
	ELSE
		ISNULL(DATEADD(Table.Period, DAY, -1), DATETIME(1, 1, 1))
	END AS EndDate
FROM
	Catalog.TermsOfSale AS TermsOfSale
		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups.SliceLast(
				&amp;CurrentDate,
				DiscountMarkup = &amp;DiscountMarkup
					AND Source REFS Catalog.TermsOfSale) AS TheEffectOfDiscountsMarkupsASliceOfTheLast
		ON (TheEffectOfDiscountsMarkupsASliceOfTheLast.Source = TermsOfSale.Ref)
		LEFT JOIN (SELECT
			MIN(T.Period) AS Period,
			T.Source AS Source
		FROM
			InformationRegister.ValidityOfDiscountsMarkups.SliceLast(
					&amp;CurrentDate,
					DiscountMarkup = &amp;DiscountMarkup
						AND Source REFS Catalog.TermsOfSale) AS CrossSection
				LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups AS T
				ON CrossSection.Source = T.Source
					AND (T.DiscountMarkup = &amp;DiscountMarkup)
					AND (T.Period > CrossSection.Period)
					AND T.Status &lt;> CrossSection.Status
		GROUP BY
			T.Source) AS Table
		ON (Table.Source = TermsOfSale.Ref)

		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups.SliceFirst(
				&amp;CurrentDate,
				DiscountMarkup = &amp;DiscountMarkup
					AND Source REFS Catalog.TermsOfSale) AS TheEffectOfDiscountsMarkupsASliceOfTheFirst
		ON (TheEffectOfDiscountsMarkupsASliceOfTheFirst.Source = TermsOfSale.Ref)
WHERE
	TermsOfSale.Standard_</queryText>
      <mainTable>Catalog.TermsOfSale</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
