  <attributes>
    <name>UseInWarehouses</name>
    <title>
      <key>en</key>
      <value>Use in warehouses</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده در انبارها</value>
    </title>
    <title>
      <key>it</key>
      <value>L'utilizzo nei magazzini</value>
    </title>
    <title>
      <key>pl</key>
      <value>Używanie w magazynach</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использование на складах</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ambarlarda kullanım</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng trong kho bãi</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseSeveralWarehouses</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInWarehouses.EndDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInWarehouses.Use</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInWarehouses.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Warehouses.Ref AS Warehouse,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Status, VALUE(Enum.DiscountValidityStatuses.NotValid)) AS Status,
	CASE
		WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Status IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS Use,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Period, DATETIME(1, 1, 1)) AS StartDate,
	CASE WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Period IS NULL THEN
		ISNULL(DATEADD(TheEffectOfDiscountsMarkupsASliceOfTheFirst.Period, DAY, -1), DATETIME(1, 1, 1)) 
	ELSE
		ISNULL(DATEADD(Table.Period, DAY, -1), DATETIME(1, 1, 1))
	END AS EndDate
FROM
	Catalog.Warehouses AS Warehouses
		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups.SliceLast(
				&amp;CurrentDate,
				DiscountMarkup = &amp;DiscountMarkup
					AND Source REFS Catalog.Warehouses) AS TheEffectOfDiscountsMarkupsASliceOfTheLast
		ON (TheEffectOfDiscountsMarkupsASliceOfTheLast.Source = Warehouses.Ref)
		LEFT JOIN (SELECT
			MIN(T.Period) AS Period,
			T.Source AS Source
		FROM
			InformationRegister.ValidityOfDiscountsMarkups.SliceLast(
					&amp;CurrentDate,
					DiscountMarkup = &amp;DiscountMarkup
						AND Source REFS Catalog.Warehouses) AS CrossSection
				LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups AS T
				ON CrossSection.Source = T.Source
					AND (T.DiscountMarkup = &amp;DiscountMarkup)
					AND (T.Period > CrossSection.Period)
					AND (T.Status &lt;> CrossSection.Status)
		
		GROUP BY
			T.Source) AS Table
		ON (Table.Source = Warehouses.Ref)
		
		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups.SliceFirst(
				&amp;CurrentDate,
				DiscountMarkup = &amp;DiscountMarkup
					AND Source REFS Catalog.Warehouses) AS TheEffectOfDiscountsMarkupsASliceOfTheFirst
		ON (TheEffectOfDiscountsMarkupsASliceOfTheFirst.Source = Warehouses.Ref)
WHERE
	NOT Warehouses.IsFolder
</queryText>
      <mainTable>Catalog.Warehouses</mainTable>
