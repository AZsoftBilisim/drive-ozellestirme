  <attributes>
    <name>UseInLoyaltyCards</name>
    <title>
      <key>en</key>
      <value>Use in loyalty cards</value>
    </title>
    <title>
      <key>fa</key>
      <value>استفاده در کارت‌های وفاداری</value>
    </title>
    <title>
      <key>it</key>
      <value>Utilizzo nelle carte di fedeltà</value>
    </title>
    <title>
      <key>pl</key>
      <value>Używanie w kartach lojalnościowych</value>
    </title>
    <title>
      <key>ru</key>
      <value>Использование в картах лояльности</value>
    </title>
    <title>
      <key>tr</key>
      <value>Sadakat kartlarında kullanım</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sử dụng trong thẻ khách hàng thân thiết</value>
    </title>
    <id>6</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseLoyaltyCards</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInLoyaltyCards.EndDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UseInLoyaltyCards.LoyaltyCardKind</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	LoyaltyCardKinds.Ref AS LoyaltyCardKind,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Status, VALUE(Enum.DiscountValidityStatuses.NotValid)) AS Status,
	CASE WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Status IS NULL THEN
		FALSE
	ELSE
		TRUE
	END AS Use,
	ISNULL(TheEffectOfDiscountsMarkupsASliceOfTheLast.Period, DATETIME(1,1,1)) AS StartDate,
	CASE WHEN TheEffectOfDiscountsMarkupsASliceOfTheLast.Period IS NULL THEN
		ISNULL(DATEADD(TheEffectOfDiscountsMarkupsASliceOfTheFirst.Period, DAY, -1), DATETIME(1, 1, 1)) 
	ELSE
		ISNULL(DATEADD(Table.Period, DAY, -1), DATETIME(1, 1, 1))
	END AS EndDate
FROM
	Catalog.LoyaltyCardKinds AS LoyaltyCardKinds
		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups.SliceLast(
				&amp;CurrentDate,
				DiscountMarkup = &amp;DiscountMarkup
					AND Source REFS Catalog.LoyaltyCardKinds) AS TheEffectOfDiscountsMarkupsASliceOfTheLast
		ON (TheEffectOfDiscountsMarkupsASliceOfTheLast.Source = LoyaltyCardKinds.Ref)
		LEFT JOIN (SELECT
			MIN(T.Period) AS Period,
			T.Source AS Source
		FROM
			InformationRegister.ValidityOfDiscountsMarkups.SliceLast(
					&amp;CurrentDate,
					DiscountMarkup = &amp;DiscountMarkup
						AND Source REFS Catalog.LoyaltyCardKinds) AS CrossSection
				LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups AS T
				ON CrossSection.Source = T.Source
					AND (T.DiscountMarkup = &amp;DiscountMarkup)
					AND (T.Period > CrossSection.Period)
					AND T.Status &lt;> CrossSection.Status
		GROUP BY
			T.Source) AS Table
		ON (Table.Source = LoyaltyCardKinds.Ref)

		LEFT JOIN InformationRegister.ValidityOfDiscountsMarkups.SliceFirst(
				&amp;CurrentDate,
				DiscountMarkup = &amp;DiscountMarkup
					AND Source REFS Catalog.LoyaltyCardKinds) AS TheEffectOfDiscountsMarkupsASliceOfTheFirst
		ON (TheEffectOfDiscountsMarkupsASliceOfTheFirst.Source = LoyaltyCardKinds.Ref)

</queryText>
      <mainTable>Catalog.LoyaltyCardKinds</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
