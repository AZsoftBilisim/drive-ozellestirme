      <queryText>SELECT
	CatalogDiscountsMarkupsOverridable.Description AS Description,
	CatalogDiscountsMarkupsOverridable.IsFolder AS IsFolder,
	0 AS Picture,
	CatalogDiscountsMarkupsOverridable.AddlOrderingAttribute AS AddlOrderingAttribute,
	CatalogDiscountsMarkupsOverridable.Managed AS Managed,
	CatalogDiscountsMarkupsOverridable.DeletionMark AS DeletionMark,
	CatalogDiscountsMarkupsOverridable.Ref AS Ref,
	CatalogDiscountsMarkupsOverridable.Parent AS Parent,
	FALSE AS ValidInWarehouses,
	0 AS NumberOfWarehouses,
	FALSE AS ValidInStandardAgreements,
	0 AS NumberOfStandardAgreements,
	FALSE AS ValidInIndividualAgreements,
	0 AS NumberOfIndividualAgreements,
	FALSE AS ValidInLoyaltyCards,
	0 AS NumberOfTypesOfLoyaltyCards,
	VALUE(Enum.DiscountValidityStatuses.NotValid) AS Status,
	DATETIME(1, 1, 1) AS StartDate,
	DATETIME(1, 1, 1) AS EndDate
FROM
	Catalog.DiscountsMarkups AS CatalogDiscountsMarkupsOverridable</queryText>
