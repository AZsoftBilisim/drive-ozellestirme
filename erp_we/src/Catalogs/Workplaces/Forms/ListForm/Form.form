    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogWorkplaces.Ref,
	CatalogWorkplaces.DataVersion,
	CatalogWorkplaces.DeletionMark,
	CatalogWorkplaces.Predefined,
	CatalogWorkplaces.Code,
	CatalogWorkplaces.Description,
	CatalogWorkplaces.ComputerName,     
	CatalogWorkplaces.LocalDevice,
	CASE
		WHEN CatalogWorkplaces.Ref =  &amp;CurrentWorkplace THEN TRUE ELSE FALSE
	END AS CurrentBusinessUnit
FROM
	Catalog.Workplaces AS CatalogWorkplaces
</queryText>
      <mainTable>Catalog.Workplaces</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
