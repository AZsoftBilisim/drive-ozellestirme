    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       CashFlowReportItems.Ref, 
       CashFlowReportItems.DeletionMark, 
       CashFlowReportItems.Parent, 
       CashFlowReportItems.IsFolder, 
       CashFlowReportItems.Code, 
       CashFlowReportItems.Description AS Description, 
       CashFlowReportItems.OffsettingAccount, 
       CashFlowReportItems.LongDesc, 
       CashFlowReportItems.CashFlowKind, 
       CashFlowReportItems.AddlOrderingAttribute, 
       CashFlowReportItems.PaymentPriority, 
       CashFlowReportItems.DescriptionLanguage1, 
       CashFlowReportItems.DescriptionLanguage2, 
       CashFlowReportItems.BusinessTransactions.*, 
       CashFlowReportItems.AdditionalAttributes.*, 
       CashFlowReportItems.Predefined, 
       CashFlowReportItems.PredefinedDataName
 FROM 
       Catalog.CashFlowReportItems
 AS 
       CashFlowReportItems</queryText>
      <mainTable>Catalog.CashFlowReportItems</mainTable>
