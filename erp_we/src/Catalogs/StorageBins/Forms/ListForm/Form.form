      <queryText>SELECT
	CatalogStorageBins.Ref,
	CatalogStorageBins.DeletionMark,
	CatalogStorageBins.Predefined,
	CatalogStorageBins.Owner,
	CatalogStorageBins.Parent,
	CatalogStorageBins.IsFolder,
	CatalogStorageBins.Code,
