	CatalogStorageBins.Line,
	CatalogStorageBins.StorageArea,
	CatalogStorageBins.Position,
	CatalogStorageBins.TabIndex,
	CatalogStorageBins.WarehouseZone,
	CatalogStorageBins.Section3,
	CatalogStorageBins.Premise,
	CatalogStorageBins.Rack,
	CatalogStorageBins.StandardSize,
	CatalogStorageBins.StorageBinType,
	CatalogStorageBins.AvailabilityLevel,
	CatalogStorageBins.Tier,
	CatalogStorageBins.MaximumFillingRateByWeight,
	CatalogStorageBins.MaximumFillingRateByVolume
FROM
	Catalog.StorageBins AS CatalogStorageBins</queryText>
