  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Key</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogDocumentRegistryKeys.Ref,
	CatalogDocumentRegistryKeys.DeletionMark,
	CatalogDocumentRegistryKeys.Description,
	CatalogDocumentRegistryKeys.Key,
	CatalogDocumentRegistryKeys.TIN,
	CatalogDocumentRegistryKeys.Organization,
	CatalogDocumentRegistryKeys.Predefined,
	CatalogDocumentRegistryKeys.PredefinedDataName
FROM
	Catalog.DocumentRegistryKeys AS CatalogDocumentRegistryKeys
WHERE
	VALUETYPE(CatalogDocumentRegistryKeys.Key) = &amp;KeyValueType
	OR &amp;KeyValueType = VALUETYPE(UNDEFINED) </queryText>
      <mainTable>Catalog.DocumentRegistryKeys</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ref</dataPath>
        <field>Ref</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DeletionMark</dataPath>
        <field>DeletionMark</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Description</dataPath>
        <field>Description</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Organization</dataPath>
        <field>Organization</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Key</dataPath>
        <field>Key</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Predefined</dataPath>
        <field>Predefined</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>TIN</dataPath>
        <field>TIN</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PredefinedDataName</dataPath>
        <field>PredefinedDataName</field>
      </fields>
      <parameters>
        <name>KeyValueType</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Key value type</value>
            </content>
            <content>
              <key>fa</key>
              <value>نوع مقدار کلید</value>
            </content>
            <content>
              <key>ru</key>
              <value>Тип значения ключа</value>
            </content>
            <content>
              <key>tr</key>
              <value>Anahtar değer tipi</value>
            </content>
            <content>
              <key>vi</key>
              <value>Kiểu giá trị khóa</value>
            </content>
            <content>
              <key>it</key>
              <value>Key value type</value>
            </content>
            <content>
              <key>pl</key>
              <value>Key value type</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>Type</types>
        </valueType>
        <values xsi:type="core:TypeValue">
          <value>Undefined</value>
        </values>
        <useRestriction>true</useRestriction>
