    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogDocumentRegistryKeys.Ref,
	CatalogDocumentRegistryKeys.DeletionMark,
	CatalogDocumentRegistryKeys.Description,
	CatalogDocumentRegistryKeys.Key,
	CatalogDocumentRegistryKeys.TIN,
	CatalogDocumentRegistryKeys.Organization,
	CatalogDocumentRegistryKeys.Predefined,
	CatalogDocumentRegistryKeys.PredefinedDataName
FROM
	Catalog.DocumentRegistryKeys AS CatalogDocumentRegistryKeys
WHERE
	VALUETYPE(CatalogDocumentRegistryKeys.Key) = &amp;KeyValueType
	OR &amp;KeyValueType = VALUETYPE(UNDEFINED)</queryText>
      <mainTable>Catalog.DocumentRegistryKeys</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
