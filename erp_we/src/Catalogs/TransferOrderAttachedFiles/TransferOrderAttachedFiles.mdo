    </synonym>
    <synonym>
      <key>pl</key>
      <value>Przechowuj wersje</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Хранить версии</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Sürümleri sakla</value>
