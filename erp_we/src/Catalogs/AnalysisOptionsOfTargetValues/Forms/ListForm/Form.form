      <segments>AnalysisOptionsList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogAnalysisOptionsOfTargetValues.Ref,
	CatalogAnalysisOptionsOfTargetValues.DataVersion,
	CatalogAnalysisOptionsOfTargetValues.DeletionMark,
	CatalogAnalysisOptionsOfTargetValues.Predefined,
	CatalogAnalysisOptionsOfTargetValues.Owner,
	CatalogAnalysisOptionsOfTargetValues.Description,
	CatalogAnalysisOptionsOfTargetValues.KindOfCalculationRelevancePeriod,
	CatalogAnalysisOptionsOfTargetValues.DisplayAMarkerOfForecastPoints,
	CatalogAnalysisOptionsOfTargetValues.HighlightMaximumValueForComponentWiseComparison,
	CatalogAnalysisOptionsOfTargetValues.ForecastAnalysisDepth,
	CatalogAnalysisOptionsOfTargetValues.ForecastHorizon,
	CatalogAnalysisOptionsOfTargetValues.GradientForComponentWiseComparison,
	CatalogAnalysisOptionsOfTargetValues.AnalysisValue,
	CatalogAnalysisOptionsOfTargetValues.ValueMultiplier,
	CatalogAnalysisOptionsOfTargetValues.ValueCalculationMethod,
	CatalogAnalysisOptionsOfTargetValues.AnalysisObject,
	CatalogAnalysisOptionsOfTargetValues.EmployeeResponsible,
	CatalogAnalysisOptionsOfTargetValues.ShowLegend,
	CatalogAnalysisOptionsOfTargetValues.CalculationRelevancePeriod,
	CatalogAnalysisOptionsOfTargetValues.AnalysisPeriod,
	CatalogAnalysisOptionsOfTargetValues.IndicatorCalculationFrequency,
	CatalogAnalysisOptionsOfTargetValues.ComparisonPeriod,
	CatalogAnalysisOptionsOfTargetValues.CalculateForecast,
	CatalogAnalysisOptionsOfTargetValues.AddlOrderingAttribute,
	CatalogAnalysisOptionsOfTargetValues.AnalysisType,
	CatalogAnalysisOptionsOfTargetValues.ChartType,
	CatalogAnalysisOptionsOfTargetValues.OnlyColorOfMainBatch,
	CatalogAnalysisOptionsOfTargetValues.FractionalPartCalculationAccuracy,
	CatalogAnalysisOptionsOfTargetValues.DecorationSettingStorage,
	CatalogAnalysisOptionsOfTargetValues.StorageOfDataCompositionUserSettings,
	CatalogAnalysisOptionsOfTargetValues.AvailabilitySettings.(
		Ref,
		LineNumber,
		User,
		ViewOption
	),
	CatalogAnalysisOptionsOfTargetValues.ReportsToDrillDown.(
		Ref,
		LineNumber,
		ReportVariant
	),
	CASE
		WHEN TargetValuesOfSliceAnalysisOptions.AnalysisOption IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS TargetValuesAreSet
FROM
	Catalog.AnalysisOptionsOfTargetValues AS CatalogAnalysisOptionsOfTargetValues
		LEFT JOIN InformationRegister.AnalysisOptionTargetValues.SliceLast AS TargetValuesOfSliceAnalysisOptions
		ON TargetValuesOfSliceAnalysisOptions.AnalysisOption = CatalogAnalysisOptionsOfTargetValues.Ref</queryText>
      <mainTable>Catalog.AnalysisOptionsOfTargetValues</mainTable>
