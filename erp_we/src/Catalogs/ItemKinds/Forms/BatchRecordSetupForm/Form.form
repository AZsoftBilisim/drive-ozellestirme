  <attributes>
    <name>ConfigureBatchAccounting</name>
    <title>
      <key>en</key>
      <value>Configure batch accounting</value>
    </title>
    <title>
      <key>fa</key>
      <value>پیکربندی حسابداری بچ</value>
    </title>
    <title>
      <key>it</key>
      <value>Impostazioni di contabilità delle serie</value>
    </title>
    <title>
      <key>pl</key>
      <value>Ustawienia ewidencji serii</value>
    </title>
    <title>
      <key>ru</key>
      <value>Настройки учета серий</value>
    </title>
    <title>
      <key>tr</key>
      <value>Toplu muhasebe ayarları</value>
    </title>
    <title>
      <key>vi</key>
