            </content>
            <content>
              <key>vi</key>
              <value>Dạng mặt hàng</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>BatchAccountingPolicy</dataPath>
