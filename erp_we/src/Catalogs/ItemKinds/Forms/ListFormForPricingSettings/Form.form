  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.KeepAccountingByBatch</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.UseCharacteristics</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.UsePackages</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ItemKinds.Description AS Description,
	ItemKinds.Ref AS ProductKind,
	ItemKinds.IsFolder,
	ItemKinds.UseCharacteristics AS UseCharacteristics,
	ItemKinds.KeepAccountingByBatch AS KeepAccountingByBatch,
	TRUE AS UsePackages,
	CASE
		WHEN ItemKinds.IsFolder
		OR
		NOT ItemKinds.UseCharacteristics
			THEN 2
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN 1
		ELSE 0
	END AS SetCharacteristics,
	CASE
		WHEN ItemKinds.IsFolder
		OR
		NOT ItemKinds.KeepAccountingByBatch
			THEN 2
		WHEN
			ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN 1
		ELSE 0
	END AS InstallSeries,
	CASE
		WHEN ItemKinds.IsFolder
			THEN 2
		WHEN
			ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN 1
		ELSE 0
	END AS InstallPackages_2,
	CAST(&quot;&quot; AS STRING(200)) AS CharacteristicsDescription_2,
	CAST(&quot;&quot; AS STRING(200)) AS SeriesDescription,
	CAST(&quot;&quot; AS STRING(200)) AS PackagingDescription,
	ItemKinds.SettingsOfPriceKeyByItemVariant,
	ItemKinds.SettingsOfPriceKeyByBatch,
	ItemKinds.SettingsOfPriceKeyByPackage
FROM
	Catalog.ItemKinds AS ItemKinds
WHERE
	NOT ItemKinds.DeletionMark</queryText>
      <mainTable>Catalog.ItemKinds</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
