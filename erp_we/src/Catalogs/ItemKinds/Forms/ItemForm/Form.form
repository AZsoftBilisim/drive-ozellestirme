              <name>LabelBatchAccountingPolicy2ContextMenu</name>
              <id>1752</id>
              <autoFill>true</autoFill>
            </contextMenu>
            <type>Label</type>
            <maxWidth>14</maxWidth>
            <autoMaxHeight>true</autoMaxHeight>
