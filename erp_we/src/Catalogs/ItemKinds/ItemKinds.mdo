  <attributes uuid="7cefbc31-d0cf-4151-8cc8-eb482c9a6196">
    <name>SpecifyQuantityWhenRegisteringBatch</name>
    <synonym>
      <key>en</key>
      <value>Specify a quantity when registering batch</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تعیین مقدار هنگام ثبت بچ</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Indica la quantità durante la registrazione delle serie</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Podaj ilość przy rejestracji serii</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Указывать количество при регистрации серий</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Parti kaydı sırasında miktarı belirt</value>
    </synonym>
