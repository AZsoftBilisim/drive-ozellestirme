  <items xsi:type="form:Decoration">
    <name>DescriptionOfRequirementsForOperationOfTestMode</name>
    <id>27</id>
    <title>
      <key>en</key>
      <value>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>The OpenSSL&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>package&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>is used&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>when&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>issuing&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>private&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>and&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>public&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>keys&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>and &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>signing&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>requests&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> when&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>exchanging&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>with&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>the service.&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>
&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature>To&lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature> &lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature>generate&lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature> &lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature>a&lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature> &lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #1c55ae>&lt;link https://docs.saltedge.com/general/v5/#signature>key:&lt;/>&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 12>&lt;color #1c55ae>
&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>1.&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>Install&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>the OpenSSL&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>package&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>and&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>specify &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>the path&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> in &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>the environment&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> variables&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>.&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>
&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>2.&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>Generate&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>keys.&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>Specify&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>the path&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>to&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>the private&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>key&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>on&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>this&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333> &lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #333333>form.&lt;/>&lt;/>&lt;/>&lt;font Almarai, Arial, sans-serif>&lt;fontsize 10>&lt;color #3333