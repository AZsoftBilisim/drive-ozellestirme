		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	RegisterRecordsProductsIncomeExpenses.Department AS Department,
	RegisterRecordsProductsIncomeExpenses.ProductLineOfBusiness AS ProductLineOfBusiness,
	RegisterRecordsProductsIncomeExpenses.ItemsLocationAttributes.Products AS Products,
	RegisterRecordsProductsIncomeExpenses.ItemsLocationAttributes.Characteristic AS Characteristic,
	RegisterRecordsProductsIncomeExpenses.ItemsLocationAttributes.Series AS Series,
	RegisterRecordsProductsIncomeExpenses.ItemsLocationAttributes.Counterparty AS Custodian,
	RegisterRecordsProductsIncomeExpenses.Warehouse AS Warehouse,
	VALUETYPE(RegisterRecordsProductsIncomeExpenses.Warehouse) AS WarehouseStore,
	RegisterRecordsProductsIncomeExpenses.InventoryType AS InventoryType,
	RegisterRecordsProductsIncomeExpenses.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	RegisterRecordsProductsIncomeExpenses.LineOfBusinessItems AS LineOfBusinessItems,
	RegisterRecordsProductsIncomeExpenses.IncomeAndExpenseItem AS IncomeAndExpenseItem,
	RegisterRecordsProductsIncomeExpenses.DimensionOfRevenue AS DimensionOfRevenue,
	RegisterRecordsProductsIncomeExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	RegisterRecordsProductsIncomeExpenses.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	VALUETYPE(RegisterRecordsProductsIncomeExpenses.Recorder) AS DocumentType
FROM
