<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>RegisterStructure</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>AssetsLiabilitiesDimension</dataPath>
			<field>AssetsLiabilitiesDimension</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfRevenue</dataPath>
			<field>DimensionOfRevenue</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DebitBusinessUnit</dataPath>
			<field>DebitBusinessUnit</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorItem</dataPath>
			<field>CorItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorExpenditureDimension</dataPath>
			<field>CorExpenditureDimension</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AssetRef</dataPath>
			<field>AssetRef</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorIncomeDimension</dataPath>
			<field>CorIncomeDimension</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorLineOfBusiness</dataPath>
			<field>CorLineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfExpenses</dataPath>
			<field>DimensionOfExpenses</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorDimensionOfAssetsLiabilities</dataPath>
			<field>CorDimensionOfAssetsLiabilities</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentType</dataPath>
			<field>DocumentType</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Document type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع سند</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipo di documento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Typ dokumentu</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип документа</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Belge türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu văn bản</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusiness</dataPath>
			<field>LineOfBusiness</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	RecordsIncomeExpensesOtherAssetsLiabilities.Department AS Department,
	RecordsIncomeExpensesOtherAssetsLiabilities.LineOfBusiness AS LineOfBusiness,
	RecordsIncomeExpensesOtherAssetsLiabilities.AssetRef AS AssetRef,
	RecordsIncomeExpensesOtherAssetsLiabilities.DimensionOfRevenue AS DimensionOfRevenue,
	RecordsIncomeExpensesOtherAssetsLiabilities.DimensionOfExpenses AS DimensionOfExpenses,
	RecordsIncomeExpensesOtherAssetsLiabilities.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.DebitBusinessUnit AS DebitBusinessUnit,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorLineOfBusiness AS CorLineOfBusiness,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorItem AS CorItem,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorIncomeDimension AS CorIncomeDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorExpenditureDimension AS CorExpenditureDimension,
	RecordsIncomeExpensesOtherAssetsLiabilities.CorDimensionOfAssetsLiabilities AS CorDimensionOfAssetsLiabilities,
	VALUETYPE(RecordsIncomeExpensesOtherAssetsLiabilities.Recorder) AS DocumentType
FROM
	AccumulationRegister.RecordsIncomeExpensesOtherAssetsLiabilities AS RecordsIncomeExpensesOtherAssetsLiabilities</query>
	</dataSet>
