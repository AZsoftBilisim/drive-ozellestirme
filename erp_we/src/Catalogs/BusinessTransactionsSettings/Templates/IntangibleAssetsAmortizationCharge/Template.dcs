<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>RegisterStructure</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorCompany</dataPath>
			<field>CorCompany</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusiness</dataPath>
			<field>LineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorExpenditureDimension</dataPath>
			<field>CorExpenditureDimension</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>FinancialAccountingGroup</dataPath>
			<field>FinancialAccountingGroup</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DebitBusinessUnit</dataPath>
			<field>DebitBusinessUnit</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorExpenseItem</dataPath>
			<field>CorExpenseItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BusinessOperation</dataPath>
			<field>BusinessOperation</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Organization</dataPath>
			<field>Organization</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorLineOfBusiness</dataPath>
			<field>CorLineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorFinancialAccountingGroup</dataPath>
			<field>CorFinancialAccountingGroup</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentType</dataPath>
			<field>DocumentType</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Document type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع سند</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipo di documento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Typ dokumentu</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип документа</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Belge türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu văn bản</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IntangibleAsset</dataPath>
			<field>IntangibleAsset</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	1 AS CompatibleWithTMCut
INTO CompatibleWithTMCut
;

SELECT TOP 0
	RegisterData.IntangibleAsset AS IntangibleAsset,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.FinancialAccountingGroup AS FinancialAccountingGroup,
	RegisterData.LineOfBusiness AS LineOfBusiness,

	RegisterData.CorCompany AS CorCompany,
	RegisterData.DebitBusinessUnit AS DebitBusinessUnit,
	RegisterData.CorFinancialAccountingGroup AS CorFinancialAccountingGroup,
	RegisterData.CorLineOfBusiness AS CorLineOfBusiness,
	RegisterData.CorExpenseItem AS CorExpenseItem,
	RegisterData.CorExpenditureDimension AS CorExpenditureDimension,
	VALUETYPE(RegisterData.Recorder) AS DocumentType
FROM
	AccumulationRegister.IntangibleAssetsAmortizationCharge AS RegisterData
</query>
	</dataSet>
	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Main</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اصلی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Principale</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Podstawowej</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Основной</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ana</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chính</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows"/>
	</settingsVariant>
</DataCompositionSchema>