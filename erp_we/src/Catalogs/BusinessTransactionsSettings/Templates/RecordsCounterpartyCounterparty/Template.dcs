		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ARAPCurrency</dataPath>
			<field>ARAPCurrency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Partner</dataPath>
			<field>Partner</field>
		</field>
		<field xsi:type="DataSetFieldField">
