				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Belge türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu văn bản</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IncomeAndExpenseItem</dataPath>
			<field>IncomeAndExpenseItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfRevenue</dataPath>
			<field>DimensionOfRevenue</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Counterparty</dataPath>
			<field>Counterparty</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Partner</dataPath>
			<field>Partner</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfExpenses</dataPath>
			<field>DimensionOfExpenses</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Contract</dataPath>
			<field>Contract</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusinessItems</dataPath>
			<field>LineOfBusinessItems</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ARAPObject</dataPath>
			<field>ARAPObject</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CounterpartyLineOfBusiness</dataPath>
			<field>CounterpartyLineOfBusiness</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	RecordsCounterpartyIncomeExpenses.Department AS Department,
	RecordsCounterpartyIncomeExpenses.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	RecordsCounterpartyIncomeExpenses.Partner AS Partner,
	RecordsCounterpartyIncomeExpenses.Counterparty AS Counterparty,
	RecordsCounterpartyIncomeExpenses.Contract AS Contract,
	RecordsCounterpartyIncomeExpenses.ARAPObject AS ARAPObject,
	RecordsCounterpartyIncomeExpenses.LineOfBusinessItems AS LineOfBusinessItems,
	RecordsCounterpartyIncomeExpenses.IncomeAndExpenseItem AS IncomeAndExpenseItem,
	RecordsCounterpartyIncomeExpenses.DimensionOfRevenue AS DimensionOfRevenue,
	RecordsCounterpartyIncomeExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	RecordsCounterpartyIncomeExpenses.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	RecordsCounterpartyIncomeExpenses.Currency AS Currency,
	VALUETYPE(RecordsCounterpartyIncomeExpenses.Recorder) AS DocumentType
FROM
	AccumulationRegister.RecordsCounterpartyIncomeExpenses AS RecordsCounterpartyIncomeExpenses</query>
	</dataSet>
	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
