		<field xsi:type="DataSetFieldField">
			<dataPath>Terms</dataPath>
			<field>Terms</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	Purchases.Department AS Department,
	Purchases.ProductLineOfBusiness AS ProductLineOfBusiness,
	Purchases.ItemsLocationAttributes.Products AS Products,
	Purchases.ItemsLocationAttributes.Characteristic AS Characteristic,
	Purchases.ItemsLocationAttributes.Series AS Series,
	Purchases.Warehouse AS Warehouse,
	Purchases.InventoryType AS InventoryType,
	Purchases.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Purchases.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	Purchases.Partner AS Partner,
	Purchases.Counterparty AS Counterparty,
	Purchases.Contract AS Contract,
	Purchases.OrderDocument AS OrderDocument,
	Purchases.AdvanceHolder AS AdvanceHolder,
	Purchases.Terms AS Terms,
	VALUETYPE(Purchases.Recorder) AS DocumentType
FROM
	AccumulationRegister.Purchases AS Purchases</query>
	</dataSet>
