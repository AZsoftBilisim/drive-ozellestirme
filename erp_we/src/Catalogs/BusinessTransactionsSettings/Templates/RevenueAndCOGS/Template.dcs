		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	RevenueAndCOGS.AccountingDimensionByPartners.Organization AS Organization,
	RevenueAndCOGS.Department AS Department,
	RevenueAndCOGS.Warehouse AS Warehouse,
	RevenueAndCOGS.ItemsLocationAttributes.Products AS Products,
	RevenueAndCOGS.ItemsLocationAttributes.Characteristic AS Characteristic,
	RevenueAndCOGS.ItemsLocationAttributes.Series AS Series,
	RevenueAndCOGS.ItemsLocationAttributes.Counterparty AS Custodian,
	RevenueAndCOGS.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	RevenueAndCOGS.InventoryType AS InventoryType,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner AS Partner,
	RevenueAndCOGS.AccountingDimensionByPartners.Counterparty AS Counterparty,
	RevenueAndCOGS.Contract AS Contract,
	VALUETYPE(RevenueAndCOGS.Recorder) AS DocumentType,
	RevenueAndCOGS.SalesOrder AS SalesOrder,
	RevenueAndCOGS.Terms AS Terms,
	RevenueAndCOGS.SetAccountingDimension AS SetAccountingDimension,
	RevenueAndCOGS.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	RevenueAndCOGS.ProductLineOfBusiness AS ProductLineOfBusiness,
	RevenueAndCOGS.LotVendorAttributes.Vendor AS Vendor,
	RevenueAndCOGS.LotVendorAttributes.Counterparty AS VendorSCounterparty
FROM
	AccumulationRegister.RevenueAndCOGS AS RevenueAndCOGS</query>
