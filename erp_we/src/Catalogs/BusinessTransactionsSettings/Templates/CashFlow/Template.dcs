<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>RegisterStructure</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>PaymentType275FZ</dataPath>
			<field>PaymentType275FZ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorrespondingCurency</dataPath>
			<field>CorrespondingCurency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashType</dataPath>
			<field>CashType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ProductCostElement</dataPath>
			<field>ProductCostElement</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Cash</dataPath>
			<field>Cash</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashFlowItem</dataPath>
			<field>CashFlowItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorCashType</dataPath>
			<field>CorCashType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorLineOfBusiness</dataPath>
			<field>CorLineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CorCash</dataPath>
			<field>CorCash</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentType</dataPath>
			<field>DocumentType</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Document type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع سند</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipo di documento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Typ dokumentu</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип документа</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Belge türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu văn bản</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusiness</dataPath>
			<field>LineOfBusiness</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	CashFlow.Department AS Department,
	CashFlow.LineOfBusiness AS LineOfBusiness,
	CashFlow.Cash AS Cash,
	CashFlow.CashType AS CashType,
	CashFlow.CashFlowItem AS CashFlowItem,
	CashFlow.ProductCostElement AS ProductCostElement,
	CashFlow.PaymentType275FZ AS PaymentType275FZ,
	CashFlow.Currency AS Currency,
	CashFlow.CorCash AS CorCash,
	CashFlow.CorCashType AS CorCashType,
	CashFlow.CorLineOfBusiness AS CorLineOfBusiness,
	CashFlow.CorrespondingCurency AS CorrespondingCurency,
	VALUETYPE(CashFlow.Recorder) AS DocumentType
FROM
	AccumulationRegister.CashFlow AS CashFlow</query>
	</dataSet>
	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Main</v8:content>
			</v8:item>
