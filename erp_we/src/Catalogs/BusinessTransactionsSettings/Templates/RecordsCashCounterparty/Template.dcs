		<field xsi:type="DataSetFieldField">
			<dataPath>Contract</dataPath>
			<field>Contract</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ARAPObject</dataPath>
			<field>ARAPObject</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CounterpartyLineOfBusiness</dataPath>
			<field>CounterpartyLineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusinessCash</dataPath>
			<field>LineOfBusinessCash</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RecordsCashCounterparty.Department AS Department,
	RecordsCashCounterparty.LineOfBusinessCash AS LineOfBusinessCash,
	RecordsCashCounterparty.Cash AS Cash,
	RecordsCashCounterparty.CashType AS CashType,
	RecordsCashCounterparty.CashFlowItem AS CashFlowItem,
	RecordsCashCounterparty.PaymentCurrency AS PaymentCurrency,
	RecordsCashCounterparty.ProductCostElement AS ProductCostElement,
	RecordsCashCounterparty.PaymentType275FZ AS PaymentType275FZ,
	RecordsCashCounterparty.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	RecordsCashCounterparty.Partner AS Partner,
	RecordsCashCounterparty.Counterparty AS Counterparty,
	RecordsCashCounterparty.Contract AS Contract,
	RecordsCashCounterparty.ARAPCurrency AS ARAPCurrency,
	RecordsCashCounterparty.ARAPObject AS ARAPObject,
	RecordsCashCounterparty.VATRate AS VATRate,
	VALUETYPE(RecordsCashCounterparty.Recorder) AS DocumentType
FROM
	AccumulationRegister.RecordsCashCounterparty AS RecordsCashCounterparty</query>
	</dataSet>
