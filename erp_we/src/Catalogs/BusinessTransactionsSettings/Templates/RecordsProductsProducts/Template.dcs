		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	RecordsProductsProducts.Department AS Department,
	RecordsProductsProducts.LineOfBusiness AS LineOfBusiness,
	RecordsProductsProducts.ItemsLocationAttributes.Products AS Products,
	RecordsProductsProducts.ItemsLocationAttributes.Characteristic AS Characteristic,
	RecordsProductsProducts.ItemsLocationAttributes.Series AS Series,
	RecordsProductsProducts.ItemsLocationAttributes.Counterparty AS Custodian,
	RecordsProductsProducts.Warehouse AS Warehouse,
	VALUETYPE(RecordsProductsProducts.Warehouse) AS WarehouseStore,
	RecordsProductsProducts.InventoryType AS InventoryType,
	RecordsProductsProducts.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	RecordsProductsProducts.CorLineOfBusiness AS CorLineOfBusiness,
	RecordsProductsProducts.CorItemsLocationAttributes.Products AS CorNomenclature,
	RecordsProductsProducts.CorItemsLocationAttributes.Characteristic AS CorCharacteristics,
	RecordsProductsProducts.CorItemsLocationAttributes.Series AS CorSeries,
	RecordsProductsProducts.CorItemsLocationAttributes.Counterparty AS KorGuardian,
	RecordsProductsProducts.CorWarehouseCorCommissionAgentCorBusinessUnit AS CorWarehouseCorCommissionAgentCorBusinessUnit,
	VALUETYPE(RecordsProductsProducts.CorWarehouseCorCommissionAgentCorBusinessUnit) AS WarehouseCorType,
	RecordsProductsProducts.CorInventoryType AS CorInventoryType,
	RecordsProductsProducts.CorInventoryOwnerAttribute AS CorInventoryOwnerAttribute,
	RecordsProductsProducts.CorCompany AS CorCompany,
	VALUETYPE(RecordsProductsProducts.Recorder) AS DocumentType
FROM
	AccumulationRegister.RecordsProductsProducts AS RecordsProductsProducts</query>
	</dataSet>
