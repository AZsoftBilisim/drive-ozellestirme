			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusinessItems</dataPath>
			<field>LineOfBusinessItems</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusinessCash</dataPath>
			<field>LineOfBusinessCash</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 0
	RecordsCashIncomeExpenses.Department AS Department,
	RecordsCashIncomeExpenses.LineOfBusinessCash AS LineOfBusinessCash,
	RecordsCashIncomeExpenses.IncomeExpenseBusinessUnit AS IncomeExpenseBusinessUnit,
	RecordsCashIncomeExpenses.Cash AS Cash,
	RecordsCashIncomeExpenses.CashType AS CashType,
	RecordsCashIncomeExpenses.CashFlowItem AS CashFlowItem,
	RecordsCashIncomeExpenses.ProductCostElement AS ProductCostElement,
	RecordsCashIncomeExpenses.PaymentType275FZ AS PaymentType275FZ,
	RecordsCashIncomeExpenses.Currency AS Currency,
	RecordsCashIncomeExpenses.LineOfBusinessItems AS LineOfBusinessItems,
	RecordsCashIncomeExpenses.IncomeAndExpenseItem AS IncomeAndExpenseItem,
	RecordsCashIncomeExpenses.DimensionOfRevenue AS DimensionOfRevenue,
	RecordsCashIncomeExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	RecordsCashIncomeExpenses.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	RecordsCashIncomeExpenses.VATRate AS VATRate,
	VALUETYPE(RecordsCashIncomeExpenses.Recorder) AS DocumentType
FROM
	AccumulationRegister.RecordsCashIncomeExpenses AS RecordsCashIncomeExpenses</query>
	</dataSet>
