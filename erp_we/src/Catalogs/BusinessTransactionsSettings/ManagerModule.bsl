#Region Public
// Identifies indicators in the currency of the register.
// More detailed See FinancialAccountingServerCached.IndicatorsInCurrency.
//
// Parameters:
//  NameOfDataSource - String - Name of the source register.
//
// Returns:
//  Map - The key is the name of the indicator.
//                 Value - the structure of the properties of the indicator.
//
Function RegisterIndicators(NameOfDataSource) Export

	If IsBlankString(NameOfDataSource) Then
		Return Undefined;
	EndIf;

	Indicators = FinancialAccountingServerCached.Indicators(NameOfDataSource);
	
	Return Indicators;

EndFunction

// Replaces source registers in business transactions for settlements with customers/suppliers 
// , depending on the FO.Newarchitecture of calculations.
Procedure ReplaceSourcesOfSettlementsWithPartners() Export
	
	ReplacingSource = New Map;
	If GetFunctionalOption("NewOnlineARAPAccounting") Then
		ReplacingSource.Insert(Metadata.AccumulationRegisters.CustomersARAPAccountingByDocuments.Name,
								Metadata.AccumulationRegisters.CustomersARAPAccountingByDueDates.Name);
		
		ReplacingSource.Insert(Metadata.AccumulationRegisters.VendorsARAPAccountingByDocuments.Name,
								Metadata.AccumulationRegisters.VendorsARAPAccountingByDueDates.Name);
	Else
		ReplacingSource.Insert(Metadata.AccumulationRegisters.CustomersARAPAccountingByDueDates.Name,
								Metadata.AccumulationRegisters.CustomersARAPAccountingByDocuments.Name);
		
		ReplacingSource.Insert(Metadata.AccumulationRegisters.VendorsARAPAccountingByDueDates.Name,
								Metadata.AccumulationRegisters.VendorsARAPAccountingByDocuments.Name);
	EndIf;
	
	ReplacementSources = New Array;
	For Each Source In ReplacingSource Do
		ReplacementSources.Add(Source.Key);
		ReplacementSources.Add(Source.Value);
	EndDo;

	DefaultLanguageCode = Common.DefaultLanguageCode();
	SourcePresentation = New Map();
	SourcePresentation.Insert(Metadata.AccumulationRegisters.CustomersARAPAccountingByDocuments.Name,
									NStr("vi = 'Hạch toán với khách hàng theo chứng từ';
										|ru = 'Расчеты с клиентами по документам';
										|en = 'Customer AR/AP by documents'; fa = 'دریافتنی/پرداختنی مشتری بر اساس اسناد';
										|it = 'Contabilità con clienti sulla base dei documenti';
										|pl = 'Rozliczenia z klientami według dokumentów';
										|tr = 'Belgelere göre müşterilerle yapılan hesaplamalar'", DefaultLanguageCode));
	SourcePresentation.Insert(Metadata.AccumulationRegisters.VendorsARAPAccountingByDocuments.Name,
									NStr("vi = 'Hạch toán với nhà cung cấp theo chứng từ';
										|ru = 'Расчеты с поставщиками по документам';
										|en = 'Vendor AR/AP by documents'; fa = 'دریافتنی/پرداختنی تأمین‌کننده بر اساس اسناد';
										|it = 'Contabilità con fornitori in base dei documenti';
										|pl = 'Zobowiązania według dokumentów';
										|tr = 'Belgelere göre tedarikçi mutabakatı'", DefaultLanguageCode));
									
	SourcePresentation.Insert(Metadata.AccumulationRegisters.CustomersARAPAccountingByDueDates.Name,
									NStr("vi = 'Hạch toán với khách hàng theo thời hạn';
										|ru = 'Расчеты с клиентами по срокам';
										|en = 'Customer AR/AP by deadlines'; fa = 'دریافتنی/پرداختنی مشتری بر اساس سررسید';
										|it = 'Contabilità con clienti in base delle righe';
										|pl = 'Rozliczenia z klientami według terminów';
										|tr = 'Sürelere göre müşterilerle yapılan hesaplamalar'", DefaultLanguageCode));
	SourcePresentation.Insert(Metadata.AccumulationRegisters.VendorsARAPAccountingByDueDates.Name,
									NStr("vi = 'Hạch toán với nhà cung cấp theo thời hạn';
										|ru = 'Расчеты с поставщиками по срокам';
										|en = 'Vendor AR/AP by deadlines'; fa = 'دریافتنی/پرداختنی تأمین‌کننده بر اساس سررسید';
										|it = 'Contabilità con fornitori in base delle righe';
										|pl = 'Zobowiązania według terminów';
										|tr = 'Sürelere göre tedarikçi mutabakatı'", DefaultLanguageCode));
	
	Query = New Query(
	"SELECT
	|	Settings.Ref AS Ref
	|FROM
	|	Catalog.BusinessTransactionsSettings AS Settings
	|WHERE
	|	Settings.DataSource IN(&DataSource)");
	
	Query.SetParameter("DataSource", ReplacementSources);
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		SettingObject1 = Selection.Ref.GetObject();
		NewSource = ReplacingSource[SettingObject1.DataSource];
		If NewSource <> Undefined Then
			SettingObject1.DataSource = NewSource;
			SettingObject1.DataSourcePresentation = SourcePresentation[NewSource];
			InfobaseUpdate.WriteData(SettingObject1);
		EndIf;
	EndDo;
	
EndProcedure

// Performs the setting of the session. Called from the session module.
//
// Parameters:
//  ParameterName			 - String - name of the session parameter.
//  SpecifiedParameters	 - Array - all the established parameters of the session.
//
Procedure SetSessionParameters(ParameterName, SpecifiedParameters) Export
	
	SessionParameters.BusinessTransactionsWithAccessLimitationSettings = New FixedArray(New Array);
	
	If ParameterName = "BusinessTransactionsWithAccessLimitationSettings" Then
		Query = New Query();
		Query.Text = 
		"SELECT
		|	BusinessOperationsAvailableForAccessRestrictions.BusinessOperation AS Ref
		|FROM
		|	Catalog.BusinessTransactionsSettings AS BusinessOperationsAvailableForAccessRestrictions
		|WHERE
		|	BusinessOperationsAvailableForAccessRestrictions.DeletionMark = FALSE
		|	AND BusinessOperationsAvailableForAccessRestrictions.UseForAccessRestrictions = TRUE";
		
		OperationsForCheckingAccessRestrictions = Query.Execute().Unload().UnloadColumn("Ref");
		
		SessionParameters.BusinessTransactionsWithAccessLimitationSettings = New FixedArray(OperationsForCheckingAccessRestrictions);
		SpecifiedParameters.Add(ParameterName);
	EndIf;
	
EndProcedure

