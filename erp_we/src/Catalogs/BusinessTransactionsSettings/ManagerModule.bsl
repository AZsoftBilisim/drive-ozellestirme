#Region FillHandler
// Fills in the table part of the register Indicator by the passed register name.
// 
// Parameters:
// 	Item - CatalogObject.BusinessTransactionsSettings, Structure - a row in the value table that describes the predefined elements of the rectangle.
// 	                                                The structure of the column table row corresponds to the set of reference data.
// 	TabularSections - CatalogObject.BusinessTransactionsSettings, Structure - Contains a column of TS:
// 	* RegisterIndicators - ValueTable - 
// 	DataSource - String - Name of the register of the indicator data source.
//
Procedure AddSourceMetrics(Item, TabularSections, DataSource)
	
	RegisterIndicators = RegisterIndicators(DataSource);
	If RegisterIndicators <> Undefined Then
		Item.RegisterIndicators = TabularSections.RegisterIndicators.Copy();
		For Each Factor In RegisterIndicators Do
			NewRow = Item.RegisterIndicators.Add();
			NewRow.Factor = Factor.Key;
			NewRow.Use = True;
		EndDo;
		Item.RegisterIndicators.Sort("Factor");
	EndIf;
		
EndProcedure
Procedure FillPredefinedElementsWithDataFromCode()
	Languages = ConfigurationLanguages();
	ObjectMetadata = Metadata.Catalogs.BusinessTransactionsSettings;
	
	ObjectAttributesToLocalize = NamesOfLocatableObjectDetails(ObjectMetadata);
	PredefinedData = PredefinedObjectData(ObjectMetadata, ObjectAttributesToLocalize);
	
	MultilanguageStringsInAttributes = MultilanguageStringsInAttributes(ObjectMetadata);
	HierarchySupported =  PredefinedData.Columns.Find("IsFolder") <> Undefined;
	
	ModifiedDataSources = Undefined;
	If GetFunctionalOption("SettingUpRulesForObtainingFactsFromCorrespondingRegisters") Then
		RulesManager = Common.ObjectManagerByFullName("Catalog.ActualDataQueryRulesByBudgetFlowItems");
		ModifiedDataSources = RulesManager.DefineReplacementsForDataTypesAccountingForDataSources(True);
		RulesManager.ChangeWhetherDataSourcesAreUsedInBudgeting(ModifiedDataSources, True);
	ElsIf LimitsByBudgetingDataServer.RegisterOfBudgetingLimitsIsUsed() Then
		RulesManager = Common.ObjectManagerByFullName("Catalog.ActualDataQueryRulesByBudgetFlowItems");
		ModifiedDataSources = RulesManager.DefineReplacementsForDataTypesAccountingForDataSources(False, True);
	EndIf;
	TabularSections = New Array;
	TabularSections.Add("RegisterIndicators");
	TabularSections.Add("Documents");
	TabularSections.Add("FunctionalOptions");
	For Each ElementData In PredefinedData Do
		ItemRef1 = Catalogs.BusinessTransactionsSettings[ElementData.PredefinedDataName];
		ObjectElement = ItemRef1.GetObject();
		AttributesList = "Parent,PredefinedDataName,Description";
		If Not ObjectElement.IsFolder Then
			AttributesList = AttributesList + ",DataSource,DataSourcePresentation,Receipt,Expense,LongDesc,BusinessOperation,UseInBudgeting,UseInFinancialAccounting,UseForSelection,UseInDocumentRegistry,UseForAccessRestrictions";
		EndIf;
		FillPropertyValues(ObjectElement, ElementData, AttributesList);
		If Not ObjectElement.IsFolder Then
			For Each TSName In TabularSections Do
				ObjectElement[TSName].Load(ElementData[TSName]);
			EndDo;
		EndIf;
		If ObjectAttributesToLocalize.Count() > 0 Then
			If MultilanguageStringsInAttributes Then
				
				LanguageCode = Common.DefaultLanguageCode();
				If ValueIsFilled(LanguageCode) Then
					For Each NameOfAttributeToLocalize In ObjectAttributesToLocalize Do
						ObjectElement[NameOfAttributeToLocalize.Key] = ElementData[NameOfAttributeToLocalize.Key + "_" + LanguageCode];
					EndDo;
				EndIf;
				
				LanguageCode = NationalLanguageSupportServer.FirstAdditionalInfobaseLanguageCode();
				If ValueIsFilled(LanguageCode) Then
					For Each NameOfAttributeToLocalize In ObjectAttributesToLocalize Do
						ObjectElement[NameOfAttributeToLocalize.Key + "Language1"] = ElementData[NameOfAttributeToLocalize.Key + "_" + LanguageCode];
					EndDo;
				EndIf;
				
				LanguageCode = NationalLanguageSupportServer.SecondAdditionalInfobaseLanguageCode();
				If ValueIsFilled(LanguageCode) Then
					For Each NameOfAttributeToLocalize In ObjectAttributesToLocalize Do
						ObjectElement[NameOfAttributeToLocalize.Key + "Language2"] = ElementData[NameOfAttributeToLocalize.Key + "_" + LanguageCode];
					EndDo;
				EndIf;
				
			ElsIf Not (HierarchySupported And ObjectElement.IsFolder) Then
				
				For Each LanguageCode In Languages Do
					Presentations = ObjectElement.Presentations; // TabularSection - 
					NewPresentation = Presentations.Add();
					NewPresentation.LanguageCode = LanguageCode;
					For Each NameOfAttributeToLocalize In ObjectAttributesToLocalize Do
						Value = ElementData[NameOfAttributeToLocalize.Key + "_" + LanguageCode];
						NewPresentation[NameOfAttributeToLocalize.Key] = ?(ValueIsFilled(Value), Value, ElementData[NameOfAttributeToLocalize.Key]);
					EndDo;
				EndDo;
				
			EndIf;
		EndIf;
		If TypeOf(ModifiedDataSources) = Type("Map") Then
			DataSourceParameters = ModifiedDataSources.Get(ItemRef1);
			If TypeOf(DataSourceParameters) = Type("Structure") Then
				If DataSourceParameters.Property("UseInBudgeting") Then
					ObjectElement.UseInBudgeting = DataSourceParameters.UseInBudgeting;
				EndIf;
				If DataSourceParameters.Property("Receipt") Then
					ObjectElement.Receipt = ?(TypeOf(DataSourceParameters.Receipt) = Type("Structure"), DataSourceParameters.Receipt.New, DataSourceParameters.Receipt);
				EndIf;
				If DataSourceParameters.Property("Expense") Then
					ObjectElement.Expense = ?(TypeOf(DataSourceParameters.Expense) = Type("Structure"), DataSourceParameters.Expense.New, DataSourceParameters.Expense);
				EndIf;
			EndIf;
		EndIf;
		ObjectElement.DataExchange.Load = True;
		ObjectElement.Write();
	EndDo;
	
EndProcedure

// Returns pre-allocated object data
// 
// Parameters:
// 	ObjectMetadata - MetadataObjectCatalog - Metadata of the directory to fill in
//  AttributesToLocalize - Map, Undefined - Localizable banking details
// 
// Returns:
// 	ValueTable - Predefined object data
//
Function PredefinedObjectData(ObjectMetadata, AttributesToLocalize = Undefined) Export
	
	LanguagesCodes = ConfigurationLanguages();
	ObjectManager = Common.ObjectManagerByFullName(ObjectMetadata.FullName());
	If Not ValueIsFilled(AttributesToLocalize) Then
		AttributesToLocalize = NamesOfLocatableObjectDetails(ObjectMetadata);
	EndIf;
	PredefinedData = New ValueTable;
	TabularSections = New Structure;
	
	For Each Attribute In ObjectMetadata.StandardAttributes Do
		AddPredefinedDataTableColumn(PredefinedData, Attribute, AttributesToLocalize, LanguagesCodes);
	EndDo;
	
	For Each Attribute In ObjectMetadata.Attributes Do
		AddPredefinedDataTableColumn(PredefinedData, Attribute, AttributesToLocalize, LanguagesCodes);
	EndDo;
	
	For Each TabularSection In ObjectMetadata.TabularSections Do
		
		PredefinedData.Columns.Add(TabularSection.Name, New TypeDescription("ValueTable"));
		Table = New ValueTable;
		For Each Attribute In TabularSection.StandardAttributes Do
			AddPredefinedDataTableColumn(Table, Attribute, AttributesToLocalize, LanguagesCodes);
		EndDo;
		
		For Each Attribute In TabularSection.Attributes Do
			AddPredefinedDataTableColumn(Table, Attribute, AttributesToLocalize, LanguagesCodes);
		EndDo;
		TabularSections.Insert(TabularSection.Name, Table);
		
	EndDo;
	
	If PredefinedData.Columns.Find("PredefinedDataName") <> Undefined Then
		PredefinedData.Indexes.Add("PredefinedDataName");
	EndIf;
	
	ObjectManager.OnInitialItemsFilling(LanguagesCodes, PredefinedData, TabularSections);
	Return PredefinedData;
	
EndFunction

#Region NationalLanguageSupportServer

Function ConfigurationLanguages()
	
	Languages = New Array;
	For Each Language In Metadata.Languages Do
		Languages.Add(Language.LanguageCode);
	EndDo;
	Return Languages;

EndFunction

Function MultilanguageStringsInAttributes(MetadataObject) Export
	Return MetadataObject.TabularSections.Find("Presentations") = Undefined;
EndFunction

// Parameters:
// 	MetadataObject - MetadataObjectCatalog - LongDesc
// 	Prefix - String - LongDesc
// Returns:
// 	Map - LongDesc
Function NamesOfLocatableObjectDetails(MetadataObject, Prefix = "")
	
	ObjectAttributesList = New Map;
	If MultilanguageStringsInAttributes(MetadataObject) Then
	
		LanguageSuffixLength = StrLen("Language1");
		
		Query = New Query;
		Query.Text = 
		"SELECT ALLOWED TOP 0
		|	*
		|FROM
		|	&FullName";
		
		Query.Text = StrReplace(Query.Text, "&FullName", MetadataObject.FullName());
		QueryResult = Query.Execute();
		
		For Each Column In QueryResult.Columns Do
			If StrEndsWith(Column.Name, "Language1") Or StrEndsWith(Column.Name, "Language2") Then
				ObjectAttributesList.Insert(Prefix + Left(Column.Name, StrLen(Column.Name) - LanguageSuffixLength), True);
			EndIf;
		EndDo;
	Else
		
		Attributes = MetadataObject.TabularSections.Presentations.Attributes; // ValueTableColumnCollection - 
		For Each Attribute In Attributes Do
			If StrCompare(Attribute.Name, "LanguageCode") = 0 Then
				Continue;
			EndIf;
			ObjectAttributesList.Insert(Prefix + Attribute.Name, True);
		EndDo;
		
	EndIf;
	
	Return ObjectAttributesList;
	
EndFunction

Procedure AddPredefinedDataTableColumn(PredefinedData, Attribute, AttributesToLocalize, Languages)
	
	If AttributesToLocalize[Attribute.Name] = True Then
		PredefinedData.Columns.Add(Attribute.Name, Attribute.Type, AttributeToLocalizeFlag());
		For Each Language In Languages Do
			PredefinedData.Columns.Add(Attribute.Name + "_" + Language, Attribute.Type, AttributeToLocalizeFlag());
		EndDo;
	Else
		If IsAttributeToLocalize(Attribute) Then
			NameWithoutSuffix = NameWithoutSuffixLanguage(Attribute);
			AttributesToLocalize.Insert(NameWithoutSuffix, True);
			For Each Language In Languages Do
				PredefinedData.Columns.Add(NameWithoutSuffix + "_" + Language, Attribute.Type, AttributeToLocalizeFlag());
			EndDo;
		Else
			PredefinedData.Columns.Add(Attribute.Name, Attribute.Type);
		EndIf;
	EndIf;

EndProcedure

Function NameWithoutSuffixLanguage(Val Attribute)
	
	Return Left(Attribute.Name, StrLen(Attribute.Name) - StrLen("Language1"));

EndFunction

Function IsAttributeToLocalize(Attribute)
	Return StrEndsWith(Attribute.Name, "Language1") Or StrEndsWith(Attribute.Name, "Language2");
EndFunction

Function AttributeToLocalizeFlag()
	Return "ToLocalize";
EndFunction

