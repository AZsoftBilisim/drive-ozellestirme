    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	AccrualAndDeductionKinds.Ref AS Ref,
	AccrualAndDeductionKinds.DeletionMark AS DeletionMark,
	AccrualAndDeductionKinds.Code AS Code,
	AccrualAndDeductionKinds.Description AS Description,
	AccrualAndDeductionKinds.ItIsADeduction AS ItIsADeduction,
	AccrualAndDeductionKinds.AdditionalAttributes.(
		Ref AS Ref,
		LineNumber AS LineNumber,
		Property AS Property,
		Value AS Value,
		TextString AS TextString
	) AS AdditionalAttributes,
	AccrualAndDeductionKinds.Predefined AS Predefined,
	AccrualAndDeductionKinds.PredefinedDataName AS PredefinedDataName,
	AccrualAndDeductionKinds.DescriptionLanguage1 AS DescriptionLanguage1,
	AccrualAndDeductionKinds.DescriptionLanguage2 AS DescriptionLanguage2,
	AccrualAndDeductionKinds.AccrualMethod AS AccrualMethod,
	AccrualAndDeductionKinds.CalculationFormula AS CalculationFormula
FROM
	Catalog.AccrualAndDeductionKinds AS AccrualAndDeductionKinds</queryText>
      <mainTable>Catalog.AccrualAndDeductionKinds</mainTable>
