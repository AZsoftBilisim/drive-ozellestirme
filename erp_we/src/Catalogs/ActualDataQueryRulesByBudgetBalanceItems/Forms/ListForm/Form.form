    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThisIsItemOfManagementBalanceSheet</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       ActualDataQueryRulesByBudgetBalanceItems.Ref, 
       ActualDataQueryRulesByBudgetBalanceItems.DeletionMark, 
       ActualDataQueryRulesByBudgetBalanceItems.Description, 
       ActualDataQueryRulesByBudgetBalanceItems.TotalType, 
       ActualDataQueryRulesByBudgetBalanceItems.SettingsComposer, 
       ActualDataQueryRulesByBudgetBalanceItems.FilterPresentation, 
       ActualDataQueryRulesByBudgetBalanceItems.DataSourceScheme, 
       ActualDataQueryRulesByBudgetBalanceItems.AdvancedModeOfDimensionFillSetting, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression1, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression2, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression3, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression4, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression5, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression6, 
       ActualDataQueryRulesByBudgetBalanceItems.FillInAnalyticsWithSpecifiedValue1, 
       ActualDataQueryRulesByBudgetBalanceItems.FillInAnalyticsWithSpecifiedValue2, 
       ActualDataQueryRulesByBudgetBalanceItems.FillInAnalyticsWithSpecifiedValue3, 
       ActualDataQueryRulesByBudgetBalanceItems.FillInAnalyticsWithSpecifiedValue4, 
       ActualDataQueryRulesByBudgetBalanceItems.FillInAnalyticsWithSpecifiedValue5, 
       ActualDataQueryRulesByBudgetBalanceItems.FillInAnalyticsWithSpecifiedValue6, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionValue1, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionValue2, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionValue3, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionValue4, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionValue5, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionValue6, 
       ActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem, 
       ActualDataQueryRulesByBudgetBalanceItems.DataSource, 
       ActualDataQueryRulesByBudgetBalanceItems.DataSourceSection, 
       ActualDataQueryRulesByBudgetBalanceItems.RuleType, 
       ActualDataQueryRulesByBudgetBalanceItems.ZoomRatio, 
       ActualDataQueryRulesByBudgetBalanceItems.SettingsHash, 
       ActualDataQueryRulesByBudgetBalanceItems.HashOfDataCompositionSchema, 
       ActualDataQueryRulesByBudgetBalanceItems.Comment, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression1HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression2HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression3HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression4HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression5HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetBalanceItems.DimensionPopulationExpression6HistoryOfTransitionToNewFormulas, 
       ActualDataQueryRulesByBudgetBalanceItems.FinancialAccountingChartOfAccounts, 
       ActualDataQueryRulesByBudgetBalanceItems.Predefined, 
       ActualDataQueryRulesByBudgetBalanceItems.PredefinedDataName,
       CAST(ActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).DataSource AS DataSourceDataSource,
       CAST(ActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource AS DataSourceNameOfBudgetDataSource,
       CAST(ActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).Predefined AS DataSourceIsPredefined
 FROM 
       Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRulesByBudgetBalanceItems
WHERE
       NOT &amp;DisabledConfigurationRulesAreHidden
       OR ActualDataQueryRulesByBudgetBalanceItems.DataSourceSection &lt;> VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
       OR CAST(ActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).Predefined = FALSE
       OR (&amp;SettingUpRulesForAssetLiabilityItems AND CAST(ActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).DataSource &lt;> &quot;&quot;)
       OR (NOT &amp;SettingUpRulesForAssetLiabilityItems AND CAST(ActualDataQueryRulesByBudgetBalanceItems.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource &lt;> &quot;&quot;)</queryText>
      <mainTable>Catalog.ActualDataQueryRulesByBudgetBalanceItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ref</dataPath>
        <field>Ref</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DeletionMark</dataPath>
        <field>DeletionMark</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Description</dataPath>
        <field>Description</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>TotalType</dataPath>
        <field>TotalType</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>SettingsComposer</dataPath>
