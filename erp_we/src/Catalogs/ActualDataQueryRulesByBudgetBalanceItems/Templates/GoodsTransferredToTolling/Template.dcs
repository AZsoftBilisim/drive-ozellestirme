		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ItemsLocationAttributes.Ref AS DimensionKey,
	ItemsLocationAttributes.Products AS Products,
	ItemsLocationAttributes.Products.ItemsType AS ItemsType,
	ItemsLocationAttributes.Products.ProductKind AS ProductKind,
	ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
	ItemsLocationAttributes.Products.Brand AS Brand,
	ItemsLocationAttributes.Products.Manufacturer AS Manufacturer,
	ItemsLocationAttributes.Products.ItemsGroup AS ItemsGroup,
	ItemsLocationAttributes.Products.PriceGroup AS PriceGroup,
	ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	ItemsLocationAttributes.StorageLocation AS Toller,
	ItemsLocationAttributes.Purpose AS Purpose
INTO ItemsLocationAttributes
FROM
	Catalog.InventoryLocationAttributeKeys AS ItemsLocationAttributes
WHERE
	ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner)
{WHERE
	ItemsLocationAttributes.Products.* AS Products,
	ItemsLocationAttributes.Products.ItemsType AS ItemsType,
	ItemsLocationAttributes.Products.ProductKind.* AS ProductKind,
	ItemsLocationAttributes.Products.UnitOfMeasure.* AS UnitOfMeasure,
	ItemsLocationAttributes.Products.Brand.* AS Brand,
	ItemsLocationAttributes.Products.Manufacturer.* AS Manufacturer,
	ItemsLocationAttributes.Products.ItemsGroup.* AS ItemsGroup,
	ItemsLocationAttributes.Products.PriceGroup.* AS PriceGroup,
	ItemsLocationAttributes.Products.ProductCategory.* AS ProductCategory,
	ItemsLocationAttributes.StorageLocation.* AS Toller}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryCost.Organization AS Organization,
	InventoryCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCost.CountBalance AS Count,
	CASE
		WHEN InventoryCost.CostManBalance + InventoryCost.AddExpensesManBalance + InventoryCost.ItemizedFixedCostsManagBalance + InventoryCost.LaborCostsManBalance + InventoryCost.ItemizedVariableCostsManagBalance = 0
			THEN InventoryCost.CostBalance + InventoryCost.AddExpensesForGoodsBalance + InventoryCost.ItemizedFixedCostsIncludingVATBalance + InventoryCost.LaborCostsBalance + InventoryCost.ItemizedVariableCostsIncludingVATBalance
		ELSE InventoryCost.CostManBalance + InventoryCost.AddExpensesManBalance + InventoryCost.ItemizedFixedCostsManagBalance + InventoryCost.LaborCostsManBalance + InventoryCost.ItemizedVariableCostsManagBalance
	END AS SumMan,
	InventoryCost.LocalCostBalance + InventoryCost.AddExpensesLocalBalance + InventoryCost.ItemizedFixedCostsComplBalance + InventoryCost.LaborCostsLocalBalance + InventoryCost.ItemizedVariableCostsComplBalance AS SumCompl
INTO InventoryCost
FROM
	AccumulationRegister.InventoryCost.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND ItemsLocationAttributes IN
					(SELECT
						ItemsLocationAttributes.DimensionKey
					FROM
						ItemsLocationAttributes AS ItemsLocationAttributes)
				AND AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToToller) {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceGoodsTransferredToTolling)) AS DataSource}) AS InventoryCost

INDEX BY
	ItemsLocationAttributes,
	InventoryOwnerAttribute
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceGoodsTransferredToTolling) AS DataSource,
	InventoryCost.Organization AS Organization,
	ISNULL(Assignments.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	ProductAccountingAnalyticsKeys.Products AS Products,
	ProductAccountingAnalyticsKeys.ItemsType AS ItemsType,
	ProductAccountingAnalyticsKeys.ProductKind AS ProductKind,
	ProductAccountingAnalyticsKeys.UnitOfMeasure AS UnitOfMeasure,
	ProductAccountingAnalyticsKeys.Brand AS Brand,
	ProductAccountingAnalyticsKeys.Manufacturer AS Manufacturer,
	ProductAccountingAnalyticsKeys.ItemsGroup AS ItemsGroup,
	ProductAccountingAnalyticsKeys.PriceGroup AS PriceGroup,
	ProductAccountingAnalyticsKeys.ProductCategory AS ProductCategory,
	ProductAccountingAnalyticsKeys.Toller AS Toller,
	InventoryCost.Count AS Count,
	InventoryCost.SumMan AS SumMan,
	InventoryCost.SumCompl AS SumCompl
{SELECT
	DataSource,
	Organization,
	LineOfBusiness.*,
	Products,
	UnitOfMeasure,
	ProductKind,
	ItemsType,
	Brand,
	Manufacturer,
	ItemsGroup,
	PriceGroup,
	ProductCategory,
	Toller,
	Count,
	SumMan,
	SumCompl}
FROM
	InventoryCost AS InventoryCost
		INNER JOIN ItemsLocationAttributes AS ProductAccountingAnalyticsKeys
		ON InventoryCost.ItemsLocationAttributes = ProductAccountingAnalyticsKeys.DimensionKey
		LEFT JOIN Catalog.Assignments AS Assignments
		ON ProductAccountingAnalyticsKeys.Purpose = Assignments.Ref
		{INNER JOIN Catalog.InventoryKinds AS InventoryKinds
		ON InventoryCost.InventoryOwnerAttribute = InventoryKinds.Ref}
{WHERE
	InventoryKinds.Ref.* AS InventoryOwnerAttribute,
	InventoryCost.Organization.*,
	Assignments.LineOfBusiness.*}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
