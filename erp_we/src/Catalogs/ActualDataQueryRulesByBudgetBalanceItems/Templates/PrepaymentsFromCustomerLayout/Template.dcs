		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionKey</dataPath>
			<field>DimensionKey</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Dimension key</v8:content>
				</v8:item>
				<v8:item>
