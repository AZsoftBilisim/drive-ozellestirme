				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Khóa đối tượng phân tích</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:required>true</dcscom:required>
			</role>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.DimensionKeysOfAccountingByPartners</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AccountingDimensionByPartners.DimensionKey AS DimensionKey,
	AccountingDimensionByPartners.Organization AS Organization,
	AccountingDimensionByPartners.Partner AS Partner,
	AccountingDimensionByPartners.Counterparty AS Counterparty,
	AccountingDimensionByPartners.Contract AS Contract
INTO TTAccountingAnalyticsForPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
WHERE
	AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	AccountingDimensionByPartners.DimensionKey.* AS DimensionKey,
	AccountingDimensionByPartners.Partner.* AS Partner,
	AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	AccountingDimensionByPartners.Organization.* AS Organization}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomersARAPAccounting.AccountingDimensionByPartners AS DimensionKey,
	CustomersARAPAccounting.ARAPObject.Object AS SalesOrder,
	CustomersARAPAccounting.ARAPObject.Department AS Department,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	CustomersARAPAccounting.Currency,
	-CustomersARAPAccounting.SumBalance AS AmountInCurrency
INTO AdvancesFromCustomers
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingDimensionByPartners IN
					(SELECT
						TTAccountingAnalyticsForPartners.DimensionKey
					FROM
						TTAccountingAnalyticsForPartners AS TTAccountingAnalyticsForPartners)
			{("DataSourceID") AS DataSourceID,
				(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsFromCustomerLayout)) AS DataSource
			}) AS CustomersARAPAccounting
WHERE
	CustomersARAPAccounting.SumBalance &lt; 0

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GiftCertificates.GiftCertificate AS GiftCertificate,
	GiftCertificates.SumBalance AS SumBalance
INTO GiftCertificates
FROM
	AccumulationRegister.GiftCertificates.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode
		{("DataSourceID") AS DataSourceID,
			(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsFromCustomerLayout)) AS DataSource}
	) AS GiftCertificates

INDEX BY
	GiftCertificate
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsFromCustomerLayout) AS DataSource,
	AdvancesFromCustomers.DimensionKey AS DimensionKey,
	AdvancesFromCustomers.SalesOrder AS SalesOrder,
	AccountingDimensionByPartners.Organization AS Organization,
	AdvancesFromCustomers.Department AS Department,
	AccountingDimensionByPartners.Counterparty AS Counterparty,
	AccountingDimensionByPartners.Partner AS Partner,
	AccountingDimensionByPartners.Contract AS Contract,
	AdvancesFromCustomers.Currency AS Currency,
	AdvancesFromCustomers.AmountInCurrency AS AmountInCurrency,
	AdvancesFromCustomers.LineOfBusiness AS LineOfBusiness
{SELECT
	DataSource,
	DimensionKey,
	SalesOrder,
	Organization.*,
	Department.*,
	Partner.*,
	Counterparty.*,
	Contract,
	Currency.*,
	AmountInCurrency,
	LineOfBusiness.*}
FROM
	AdvancesFromCustomers AS AdvancesFromCustomers
		LEFT JOIN TTAccountingAnalyticsForPartners AS AccountingDimensionByPartners
		ON AdvancesFromCustomers.DimensionKey = AccountingDimensionByPartners.DimensionKey
{WHERE
	AdvancesFromCustomers.Currency.* AS Currency}
	
UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsFromCustomerLayout) AS DataSource,
	UNDEFINED AS DimensionKey,
	UNDEFINED AS SalesOrder,
	ISNULL(ActivatingGiftCertificates.Organization, VALUE(Catalog.Companies.EmptyRef)) AS Organization,
	CertificateImplementation.Recorder.Department AS Department,
	VALUE(Catalog.Counterparties.RetailCustomer) AS Counterparty,
	VALUE(Catalog.Partners.RetailCustomer) AS Partner,
	&amp;EmptyDimensionValue AS Contract,
	GiftCertificates.GiftCertificate.Owner.Currency AS Currency,
	GiftCertificates.SumBalance AS AmountInCurrency,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness
FROM
	GiftCertificates AS GiftCertificates
		LEFT JOIN InformationRegister.ActivatingGiftCertificates AS ActivatingGiftCertificates
		ON ActivatingGiftCertificates.GiftCertificate = GiftCertificates.GiftCertificate
		LEFT JOIN AccumulationRegister.GiftCertificates AS CertificateImplementation
		ON (CertificateImplementation.GiftCertificate = GiftCertificates.GiftCertificate)
			AND (CertificateImplementation.RecordType = VALUE(AccumulationRecordType.Receipt))
{WHERE
	GiftCertificates.GiftCertificate.Owner.Currency.* AS Currency,
	ActivatingGiftCertificates.Organization AS Organization,
	CertificateImplementation.Recorder.Department.* AS Department,
	(VALUE(Catalog.LinesOfBusiness.EmptyRef)).* AS LineOfBusiness}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
