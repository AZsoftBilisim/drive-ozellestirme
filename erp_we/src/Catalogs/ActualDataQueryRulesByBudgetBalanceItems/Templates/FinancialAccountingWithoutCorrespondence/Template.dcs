					<v8:content>Tài khoản</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:ChartOfAccountsRef.International</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// Independence from the state of the functional option
SELECT ALLOWED
	VALUE(Catalog.FinancialAccountingChartsOfAccounts.EmptyRef) AS FinancialAccountingChartOfAccounts,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(ChartOfAccounts.International.EmptyRef) AS Account,
	VALUE(ChartOfAccounts.International.EmptyRef) AS DataSource,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension1,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension2,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension3,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	0 AS BalanceAmount,
	0 AS BalanceAmountDr,
	0 AS BalanceAmountCr,
	0 AS AmountInTheBalanceCurrency,
	0 AS AmountInTheBalanceCurrencyDr,
	0 AS AmountInTheBalanceCurrencyCr,
	0 AS NumberOfBalance,
	0 AS NumberOfBalanceDr,
	0 AS NumberOfBalanceCr
{SELECT
	FinancialAccountingChartOfAccounts.*,
	DataSource,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	ExtDimension1.*,
	ExtDimension2.*,
	ExtDimension3.*,
	Currency.*,
	BalanceAmount,
	BalanceAmountDr,
	BalanceAmountCr,
	AmountInTheBalanceCurrency,
	AmountInTheBalanceCurrencyDr,
	AmountInTheBalanceCurrencyCr,
	NumberOfBalance,
	NumberOfBalanceDr,
	NumberOfBalanceCr}
WHERE
	FALSE
{WHERE
	VALUE(Catalog.FinancialAccountingChartsOfAccounts.EmptyRef) AS FinancialAccountingChartOfAccounts,
	("DataSourceID") AS DataSourceID,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(ChartOfAccounts.International.EmptyRef) AS DataSource,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension1,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension2,
	VALUE(Catalog.Companies.EmptyRef) AS ExtDimension3,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency}

UNION ALL

SELECT
	FinancialAccounting.ChartOfAccounts AS FinancialAccountingChartOfAccounts,
	FinancialAccounting.Organization AS Organization,
	FinancialAccounting.Department AS Department,
	FinancialAccounting.LineOfBusiness AS LineOfBusiness,
	FinancialAccounting.Account AS Account,
	FinancialAccounting.Account AS DataSource,
	FinancialAccounting.ExtDimension1 AS ExtDimension1,
	FinancialAccounting.ExtDimension2 AS ExtDimension2,
	FinancialAccounting.ExtDimension3 AS ExtDimension3,
	FinancialAccounting.Currency AS Currency,
	FinancialAccounting.SumBalance AS BalanceAmount,
	FinancialAccounting.SumBalanceDr AS BalanceAmountDr,
	FinancialAccounting.SumBalanceCr AS BalanceAmountCr,
	FinancialAccounting.CurrencyAmountBalance AS AmountInTheBalanceCurrency,
	FinancialAccounting.CurrencyAmountBalanceDr AS AmountInTheBalanceCurrencyDr,
	FinancialAccounting.CurrencyAmountBalanceCr AS AmountInTheBalanceCurrencyCr,
	FinancialAccounting.CountBalance AS NumberOfBalance,
	FinancialAccounting.CountBalanceDr AS NumberOfBalanceDr,
	FinancialAccounting.CountBalanceCr AS NumberOfBalanceCr
FROM
	AccountingRegister.InternationalWithoutCorrespondence.Balance(&amp;PeriodLimit,
		{Account IN HIERARCHY (&amp;DataSource), (Account) AS DataSource}, ,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
			{("DataSourceID") AS DataSourceID,
				ChartOfAccounts.* AS FinancialAccountingChartOfAccounts,
				(Organization).* AS Organization, (Department).* AS Department,
				(LineOfBusiness).* AS LineOfBusiness, (Currency).* AS Currency,
				(ExtDimension1).* AS ExtDimension1, (ExtDimension2).* AS ExtDimension2, (ExtDimension3).* AS ExtDimension3
			}
	) AS FinancialAccounting
{WHERE
	// Fields for optimal selection by additional details (selection is imposed outside the fields of the virtual table in the WHERE section)
	("DataSourceID") AS DataSourceID,
	FinancialAccounting.Organization.* AS Organization,
	FinancialAccounting.Department.* AS Department,
	FinancialAccounting.LineOfBusiness.* AS LineOfBusiness,
	FinancialAccounting.Account.* AS Account,
	FinancialAccounting.Account.* AS DataSource,
	FinancialAccounting.ExtDimension1.* AS ExtDimension1,
	FinancialAccounting.ExtDimension2.* AS ExtDimension2,
	FinancialAccounting.ExtDimension3.* AS ExtDimension3,
	FinancialAccounting.Currency.* AS Currency}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<parameter>
		<name>PeriodLimit</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period limit</v8:content>
			</v8:item>
