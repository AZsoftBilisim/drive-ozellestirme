		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceAdvanceHolderCash) AS DataSource,
	CashToBeWrittenOffFromAccountablePersonsBalances.Organization AS Organization,
	CashToBeWrittenOffFromAccountablePersonsBalances.AdvanceHolder AS AdvanceHolder,
	CashToBeWrittenOffFromAccountablePersonsBalances.Currency AS Currency,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	CashToBeWrittenOffFromAccountablePersonsBalances.SumBalance AS AmountInCurrency
{SELECT
	DataSource,
	Organization.*,
	AdvanceHolder.*,
	Currency.*,
	LineOfBusiness.*,
	AmountInCurrency}
FROM
	AccumulationRegister.AdvanceHolderCash.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceAdvanceHolderCash)) AS DataSource, (Organization).*, (AdvanceHolder).*, (Currency).*, (VALUE(Catalog.LinesOfBusiness.EmptyRef)).* AS LineOfBusiness}) AS CashToBeWrittenOffFromAccountablePersonsBalances</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
