		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceCashAccountBalance) AS DataSource,
	CashInCashRegistersCRBalance.Organization AS Organization,
	CashInCashRegistersCRBalance.CashRegister AS CashAccount,
	CashInCashRegistersCRBalance.CashRegister.CashCurrency AS Currency,
	CashInCashRegistersCRBalance.CashRegister.Department AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	CashInCashRegistersCRBalance.SumBalance AS AmountInCurrency,
	CashInCashRegistersCRBalance.SumManBalance AS SumMan,
	CashInCashRegistersCRBalance.SumComplBalance AS SumCompl
{SELECT
	DataSource,
	Organization.*,
	CashAccount.*,
	Currency.*,
	Department.*,
	LineOfBusiness.*,
	AmountInCurrency,
	SumMan,
	SumCompl}
FROM
	AccumulationRegister.CashInCashRegistersCR.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceCashAccountBalance)) AS DataSource, (Organization).* AS Organization, (CashRegister).* AS CashAccount, (CashRegister.CashCurrency).* AS Currency, (CashRegister.Department).* AS Department, (VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness}) AS CashInCashRegistersCRBalance

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceCashAccountBalance),
	CashAccountBalanceBalance.Organization,
	CashAccountBalanceBalance.CashAccount,
	CashAccountBalanceBalance.CashAccount.CashCurrency,
	CashAccountBalanceBalance.CashAccount.Department,
	CashAccountBalanceBalance.CashAccount.LineOfBusiness,
	CashAccountBalanceBalance.SumBalance,
	CashAccountBalanceBalance.SumManBalance,
	CashAccountBalanceBalance.SumComplBalance
FROM
	AccumulationRegister.CashAccountBalance.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceCashAccountBalance)) AS DataSource, (Organization).* AS Organization, (CashAccount).* AS CashAccount, (CashAccount.CashCurrency).* AS Currency, (CashAccount.Department).* AS Department, (CashAccount.LineOfBusiness).* AS LineOfBusiness}) AS CashAccountBalanceBalance</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
