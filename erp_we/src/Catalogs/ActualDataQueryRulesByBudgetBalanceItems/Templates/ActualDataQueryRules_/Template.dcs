		<dataSource>DataSource1</dataSource>
		<query>

// DON'T OVERFILL WITH THE CONSTRUCTOR - THERE ARE CLIPPING TAGS



SELECT
    ActualDataQueryRules_.BudgetBalanceItem AS BudgetBalanceItem,
    ActualDataQueryRules_.DataSourceSection AS DataSourceSection,
    ActualDataQueryRules_.DataSource AS DataSource,
    ISNULL(CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource, "") AS NameOfTheDataSourceTemplate,
    ActualDataQueryRules_.TransactionAmountSource AS TransactionAmountSource,
    ActualDataQueryRules_.SettingsComposer AS SettingsComposer,
    ActualDataQueryRules_.SettingsHash,
    ActualDataQueryRules_.HashOfDataCompositionSchema,
    CASE
    	WHEN ActualDataQueryRules_.HashOfDataCompositionSchema &lt;&gt; ""
    		THEN ActualDataQueryRules_.HashOfDataCompositionSchema
    	WHEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource &lt;&gt; ""
    		THEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource
    	ELSE CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).PredefinedDataName
    END AS DataSourceID,
    NULL AS Currency1,
    NULL AS TotalType,
    NULL AS DataSourceScheme,
    ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting,
    ActualDataQueryRules_.DimensionPopulationExpression1,
    ActualDataQueryRules_.DimensionPopulationExpression2,
    ActualDataQueryRules_.DimensionPopulationExpression3,
    ActualDataQueryRules_.DimensionPopulationExpression4,
    ActualDataQueryRules_.DimensionPopulationExpression5,
    ActualDataQueryRules_.DimensionPopulationExpression6,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6,
    ActualDataQueryRules_.DimensionValue1,
    ActualDataQueryRules_.DimensionValue2,
    ActualDataQueryRules_.DimensionValue3,
    ActualDataQueryRules_.DimensionValue4,
    ActualDataQueryRules_.DimensionValue5,
    ActualDataQueryRules_.DimensionValue6,
    ActualDataQueryRules_.Ref AS Rule,
    ActualDataQueryRules_.RuleType,
    ActualDataQueryRules_.ZoomRatio,
    -1 AS LimitationOfNumberOfExtDimension
INTO ActualDataQueryRules_
FROM
    Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRules_
WHERE
    NOT ActualDataQueryRules_.DeletionMark
    AND ActualDataQueryRules_.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.OperationalAccounting)
    AND TRUE IN
        (SELECT TOP 1
            TRUE
        FROM
            ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
        WHERE
            AssetLiabilityItems.Ref = ActualDataQueryRules_.DataSource
            AND (NOT AssetLiabilityItems.Predefined
                OR &amp;ByItemsOfAssetsLiabilities AND AssetLiabilityItems.DataSource &lt;&gt; ""
                OR NOT &amp;ByItemsOfAssetsLiabilities AND AssetLiabilityItems.NameOfBudgetDataSource &lt;&gt; "")
        )
{WHERE
    ActualDataQueryRules_.BudgetBalanceItem.*,
    ActualDataQueryRules_.DataSource.*,
    ActualDataQueryRules_.DataSourceSection.*,
    (CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource) AS NameOfTheDataSourceTemplate,
    CASE
    	WHEN ActualDataQueryRules_.HashOfDataCompositionSchema &lt;&gt; ""
    		THEN ActualDataQueryRules_.HashOfDataCompositionSchema
    	WHEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource &lt;&gt; ""
    		THEN CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).NameOfBudgetDataSource
    	ELSE CAST(ActualDataQueryRules_.DataSource AS ChartOfCharacteristicTypes.AssetLiabilityItems).PredefinedDataName
    END AS DataSourceID}


UNION ALL

SELECT
    ActualDataQueryRules_.BudgetBalanceItem,
    ActualDataQueryRules_.DataSourceSection,
    ActualDataQueryRules_.DataSource,
    "FinancialAccounting",
    NULL,
    ActualDataQueryRules_.SettingsComposer,
    ActualDataQueryRules_.SettingsHash,
    ActualDataQueryRules_.HashOfDataCompositionSchema,
    CASE
		WHEN International.ChartOfAccounts.OptionForGeneratingTransactions = VALUE(Enum.EntryGenerationOptions.WithCorrespondence)
			THEN "FinancialAccountingWithCorrespondence"
		ELSE "FinancialAccountingWithoutCorrespondence"
	END AS DataSourceID,
    International.Currency1,
    ActualDataQueryRules_.TotalType,
    NULL,
    ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting,
    ActualDataQueryRules_.DimensionPopulationExpression1,
    ActualDataQueryRules_.DimensionPopulationExpression2,
    ActualDataQueryRules_.DimensionPopulationExpression3,
    ActualDataQueryRules_.DimensionPopulationExpression4,
    ActualDataQueryRules_.DimensionPopulationExpression5,
    ActualDataQueryRules_.DimensionPopulationExpression6,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6,
    ActualDataQueryRules_.DimensionValue1,
    ActualDataQueryRules_.DimensionValue2,
    ActualDataQueryRules_.DimensionValue3,
    ActualDataQueryRules_.DimensionValue4,
    ActualDataQueryRules_.DimensionValue5,
    ActualDataQueryRules_.DimensionValue6,
    ActualDataQueryRules_.Ref,
    ActualDataQueryRules_.RuleType,
    ActualDataQueryRules_.ZoomRatio,
    CASE
        WHEN NOT ActualDataQueryRules_.TotalType IN (
            VALUE(Enum.TypesOfTotals.Balance_Dr),
            VALUE(Enum.TypesOfTotals.Balance_Cr))
            THEN -1
        WHEN NOT ExtDimensionTypes3.Ref IS NULL
            THEN 3
        WHEN NOT ExtDimensionTypes2.Ref IS NULL
            THEN 2
        WHEN NOT ExtDimensionTypes1.Ref IS NULL
            THEN 1
        ELSE -1
    END AS LimitationOfNumberOfExtDimension
FROM
    Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRules_
    LEFT JOIN ChartOfAccounts.International AS International
        ON ActualDataQueryRules_.DataSource = International.Ref
    LEFT JOIN ChartOfAccounts.International.ExtDimensionTypes AS ExtDimensionTypes1
        ON International.Type = VALUE(AccountType.ActivePassive)
        AND International.Ref = ExtDimensionTypes1.Ref
        AND ExtDimensionTypes1.LineNumber = 1
    LEFT JOIN ChartOfAccounts.International.ExtDimensionTypes AS ExtDimensionTypes2
        ON International.Type = VALUE(AccountType.ActivePassive)
        AND International.Ref = ExtDimensionTypes2.Ref
        AND ExtDimensionTypes2.LineNumber = 2
    LEFT JOIN ChartOfAccounts.International.ExtDimensionTypes AS ExtDimensionTypes3
        ON International.Type = VALUE(AccountType.ActivePassive)
        AND International.Ref = ExtDimensionTypes3.Ref
        AND ExtDimensionTypes3.LineNumber = 3
WHERE
    NOT ActualDataQueryRules_.DeletionMark
    AND &amp;InternationalAccountingIsUsed
    AND ActualDataQueryRules_.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.FinancialAccounting)
{WHERE
    ActualDataQueryRules_.DataSourceSection.*,
    ActualDataQueryRules_.DataSource.*,
    ActualDataQueryRules_.BudgetBalanceItem.*,
    ("FinancialAccounting") AS NameOfTheDataSourceTemplate,
    CASE
		WHEN International.ChartOfAccounts.OptionForGeneratingTransactions = VALUE(Enum.EntryGenerationOptions.WithCorrespondence)
			THEN "FinancialAccountingWithCorrespondence"
		ELSE "FinancialAccountingWithoutCorrespondence"
	END AS DataSourceID}

UNION ALL

SELECT
    ActualDataQueryRules_.BudgetBalanceItem,
    ActualDataQueryRules_.DataSourceSection,
    ActualDataQueryRules_.DataSource,
    "",
    NULL,
    ActualDataQueryRules_.SettingsComposer,
    ActualDataQueryRules_.SettingsHash,
    ActualDataQueryRules_.HashOfDataCompositionSchema,
    ActualDataQueryRules_.HashOfDataCompositionSchema AS DataSourceID,
    NULL,
    NULL,
    ActualDataQueryRules_.DataSourceScheme,
    ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting,
    ActualDataQueryRules_.DimensionPopulationExpression1,
    ActualDataQueryRules_.DimensionPopulationExpression2,
    ActualDataQueryRules_.DimensionPopulationExpression3,
    ActualDataQueryRules_.DimensionPopulationExpression4,
    ActualDataQueryRules_.DimensionPopulationExpression5,
    ActualDataQueryRules_.DimensionPopulationExpression6,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6,
    ActualDataQueryRules_.DimensionValue1,
    ActualDataQueryRules_.DimensionValue2,
    ActualDataQueryRules_.DimensionValue3,
    ActualDataQueryRules_.DimensionValue4,
    ActualDataQueryRules_.DimensionValue5,
    ActualDataQueryRules_.DimensionValue6,
    ActualDataQueryRules_.Ref,
    ActualDataQueryRules_.RuleType,
    ActualDataQueryRules_.ZoomRatio,
    -1 AS LimitationOfNumberOfExtDimension
FROM
    Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRules_
WHERE
    NOT ActualDataQueryRules_.DeletionMark
    AND ActualDataQueryRules_.DataSourceSection = VALUE(Enum.SectionsOfBudgetingDataSources.CustomQuery)
{WHERE
    ActualDataQueryRules_.BudgetBalanceItem.*,
    ActualDataQueryRules_.DataSource.*,
    ActualDataQueryRules_.DataSourceSection.*,
    ("") AS NameOfTheDataSourceTemplate,
    ActualDataQueryRules_.HashOfDataCompositionSchema AS DataSourceID}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
    ActualDataQueryRules_.BudgetBalanceItem AS BudgetBalanceItem,
    CASE
        WHEN BudgetBalanceItems.IndicatorType = VALUE(Enum.BudgetBalanceItemType.SpecialPurpose)
            THEN ActualDataQueryRules_.BudgetBalanceItem
        ELSE UNDEFINED
    END AS BudgetFlowItem,
    ActualDataQueryRules_.Rule AS Rule,
    BudgetBalanceItems.DimensionKind1 AS DimensionKind1,
    BudgetBalanceItems.DimensionKind2 AS DimensionKind2,
    BudgetBalanceItems.DimensionKind3 AS DimensionKind3,
    BudgetBalanceItems.DimensionKind4 AS DimensionKind4,
    BudgetBalanceItems.DimensionKind5 AS DimensionKind5,
    BudgetBalanceItems.DimensionKind6 AS DimensionKind6,
    CASE
        WHEN BudgetBalanceItems.RecordByCurrency
            THEN CASE
                    WHEN BudgetBalanceItems.CurrencyIsDeterminedByDimension
                        THEN "DeterminedByAnalytics"
                    ELSE "DeterminedByDataSource"
                END
        ELSE "DeterminedByReportCurrency"
    END AS CurrencyFilling,
    CASE
        WHEN BudgetBalanceItems.RecordByQuantity
            THEN CASE
                    WHEN BudgetBalanceItems.UnitOfMeasureIsDeterminedByDimension
                        THEN "DeterminedByAnalytics"
                    ELSE "FixedValue"
                END
        ELSE "DontFill"
    END AS UnitOfMeasureFilling,
    BudgetBalanceItems.UnitOfMeasure AS UnitOfMeasure,
    BudgetBalanceItems.QuantityDimensionAddress AS DimensionAddressUnitOfMeasure,
    BudgetBalanceItems.DimensionUnitsOfMeasurement.UnitOfMeasureFilling AS FieldOfDimensionUnitOfMeasure,
    BudgetBalanceItems.DimensionAddressCurrency AS DimensionAddressCurrency,
    BudgetBalanceItems.DimensionCurrencies.CurrencyFilling AS DimensionCurrencyField,
    ActualDataQueryRules_.DataSource AS DataSource,
    ActualDataQueryRules_.NameOfTheDataSourceTemplate AS NameOfTheDataSourceTemplate,
    ActualDataQueryRules_.TransactionAmountSource AS TransactionAmountSource,
    ActualDataQueryRules_.DataSourceID AS DataSourceID,
    ActualDataQueryRules_.DataSourceSection AS DataSourceSection,
    ActualDataQueryRules_.Currency1 AS SourceOfForeignExchange,
    ActualDataQueryRules_.TotalType AS TotalType,
    ActualDataQueryRules_.SettingsComposer AS SettingsComposer,
    ActualDataQueryRules_.DataSourceScheme AS DataSourceScheme,
    ActualDataQueryRules_.LimitationOfNumberOfExtDimension AS LimitationOfNumberOfExtDimension,
    ActualDataQueryRules_.AdvancedModeOfDimensionFillSetting AS AdvancedModeOfDimensionFillSetting,
    ActualDataQueryRules_.DimensionPopulationExpression1 AS DimensionPopulationExpression1,
    ActualDataQueryRules_.DimensionPopulationExpression2 AS DimensionPopulationExpression2,
    ActualDataQueryRules_.DimensionPopulationExpression3 AS DimensionPopulationExpression3,
    ActualDataQueryRules_.DimensionPopulationExpression4 AS DimensionPopulationExpression4,
    ActualDataQueryRules_.DimensionPopulationExpression5 AS DimensionPopulationExpression5,
    ActualDataQueryRules_.DimensionPopulationExpression6 AS DimensionPopulationExpression6,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue1 AS FillInAnalyticsWithSpecifiedValue1,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue2 AS FillInAnalyticsWithSpecifiedValue2,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue3 AS FillInAnalyticsWithSpecifiedValue3,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue4 AS FillInAnalyticsWithSpecifiedValue4,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue5 AS FillInAnalyticsWithSpecifiedValue5,
    ActualDataQueryRules_.FillInAnalyticsWithSpecifiedValue6 AS FillInAnalyticsWithSpecifiedValue6,
    ActualDataQueryRules_.DimensionValue1 AS DimensionValue1,
    ActualDataQueryRules_.DimensionValue2 AS DimensionValue2,
    ActualDataQueryRules_.DimensionValue3 AS DimensionValue3,
    ActualDataQueryRules_.DimensionValue4 AS DimensionValue4,
    ActualDataQueryRules_.DimensionValue5 AS DimensionValue5,
    ActualDataQueryRules_.DimensionValue6 AS DimensionValue6,
    ActualDataQueryRules_.RuleType AS RuleType,
    BudgetBalanceItems.IndicatorType AS IndicatorType,
    ActualDataQueryRules_.ZoomRatio AS ZoomRatio,
    ActualDataQueryRules_.SettingsHash AS SettingsHash,
    ActualDataQueryRules_.HashOfDataCompositionSchema AS HashOfDataCompositionSchema
{SELECT
    BudgetBalanceItem,
    BudgetFlowItem,
    Rule.*,
    DimensionKind1,
    DimensionKind2,
    DimensionKind3,
    DimensionKind4,
    DimensionKind5,
    DimensionKind6,
    CurrencyFilling,
    DimensionAddressCurrency,
    DimensionCurrencyField,
    UnitOfMeasureFilling,
    DimensionAddressUnitOfMeasure,
    UnitOfMeasure,
    FieldOfDimensionUnitOfMeasure,
    DataSourceSection,
    DataSource,
    NameOfTheDataSourceTemplate,
    TransactionAmountSource,
    DataSourceID,
    SourceOfForeignExchange,
    TotalType,
    SettingsComposer,
    SettingsHash,
    HashOfDataCompositionSchema,
    DataSourceScheme,
    LimitationOfNumberOfExtDimension,
    AdvancedModeOfDimensionFillSetting,
    DimensionPopulationExpression1,
    DimensionPopulationExpression2,
    DimensionPopulationExpression3,
    DimensionPopulationExpression4,
    DimensionPopulationExpression5,
    DimensionPopulationExpression6,
    FillInAnalyticsWithSpecifiedValue1,
    FillInAnalyticsWithSpecifiedValue2,
    FillInAnalyticsWithSpecifiedValue3,
    FillInAnalyticsWithSpecifiedValue4,
    FillInAnalyticsWithSpecifiedValue5,
    FillInAnalyticsWithSpecifiedValue6,
    DimensionValue1,
    DimensionValue2,
    DimensionValue3,
    DimensionValue4,
    DimensionValue5,
    DimensionValue6,
    RuleType,
    IndicatorType,
    ZoomRatio}
FROM
    ActualDataQueryRules_ AS ActualDataQueryRules_
        LEFT JOIN Catalog.BudgetBalanceItems AS BudgetBalanceItems
        ON ActualDataQueryRules_.BudgetBalanceItem = BudgetBalanceItems.Ref</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
