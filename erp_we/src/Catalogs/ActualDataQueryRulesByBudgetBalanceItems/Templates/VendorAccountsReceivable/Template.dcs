						<v8:content>منبع داده</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Origine dei dati</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Źródło danych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Источник данных</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Veri kaynağı</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Nguồn dữ liệu</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	AccountingDimensionByPartners.DimensionKey AS DimensionKey,
	AccountingDimensionByPartners.Partner AS Partner,
	AccountingDimensionByPartners.Counterparty AS Counterparty,
	AccountingDimensionByPartners.Organization AS Organization,
	AccountingDimensionByPartners.Contract AS Contract
INTO AccountingAnalyticsForPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
WHERE
	AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	AccountingDimensionByPartners.Partner.* AS Partner,
	AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	AccountingDimensionByPartners.Organization.* AS Organization,
	AccountingDimensionByPartners.Contract.* AS Contract}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceVendorAccountsReceivable) AS DataSource,
	VendorsARAPAccounting.AccountingDimensionByPartners AS ProductAccountingAttributes,
	ProductAccountingAttributes.Contract AS Contract,
	ProductAccountingAttributes.Counterparty AS Counterparty,
	VendorsARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	ProductAccountingAttributes.Organization AS Organization,
	ProductAccountingAttributes.Partner AS Partner,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.ARAPObject.Object AS PurchaseOrder,
	VendorsARAPAccounting.ARAPObject.Department AS Department,
	-VendorsARAPAccounting.SumBalance AS AmountInCurrency
{SELECT
	DataSource,
	ProductAccountingAttributes.*,
	Contract.*,
	Counterparty.*,
	LineOfBusiness.*,
	Organization.*,
	Partner.*,
	Currency.*,
	PurchaseOrder.*,
	Department.*,
	AmountInCurrency}
FROM
	AccumulationRegister.VendorsARAPAccounting.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
		{("DataSourceID") AS DataSourceID,
			(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceVendorAccountsReceivable)) AS DataSource,
			(Currency).* AS Currency,
			(ARAPObject.Object).* AS PurchaseOrder,
			(ARAPObject.Department).* AS Department,
			(AccountingDimensionByPartners.Partner).* AS Partner,
			(AccountingDimensionByPartners.Organization).* AS Organization,
			(AccountingDimensionByPartners.Counterparty).* AS Counterparty,
			(AccountingDimensionByPartners.Contract).* AS Contract,
			(ARAPObject.LineOfBusiness).* AS LineOfBusiness
		}) AS VendorsARAPAccounting
		INNER JOIN AccountingAnalyticsForPartners AS ProductAccountingAttributes
		ON VendorsARAPAccounting.AccountingDimensionByPartners = ProductAccountingAttributes.DimensionKey
WHERE
	VendorsARAPAccounting.SumBalance &lt; 0</query>
			<autoFillFields>false</autoFillFields>
		</item>
