			<field xsi:type="DataSetFieldField">
				<dataPath>DataSource</dataPath>
				<field>DataSource</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Data source</v8:content>
					</v8:item>
					<v8:item>
