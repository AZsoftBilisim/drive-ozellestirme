					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	InventoryKinds.Ref AS Ref,
	InventoryKinds.Organization AS Organization,
	InventoryKinds.Counterparty AS Counterparty,
	InventoryKinds.GoodsOwner AS Partner
INTO InventoryKinds
FROM
	Catalog.InventoryKinds AS InventoryKinds
{WHERE
	InventoryKinds.Organization.* AS Organization,
	InventoryKinds.Counterparty.* AS Counterparty,
	InventoryKinds.GoodsOwner.* AS Partner}

INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceVendorAccountsReceivable) AS DataSource,
	GoodsToBeRegisteredInReportsToConsignor.InventoryOwnerAttribute AS ProductAccountingAttributes,
	ProductAccountingAttributes.Counterparty AS Counterparty,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	ProductAccountingAttributes.Organization AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	ProductAccountingAttributes.Partner AS Partner,
	GoodsToBeRegisteredInReportsToConsignor.Currency AS Currency,
	GoodsToBeRegisteredInReportsToConsignor.RevenueAmountBalance AS AmountInCurrency
{SELECT
	DataSource,
	ProductAccountingAttributes.*,
	Organization.*,
	Department.*,
	Partner.*,
	Counterparty.*,
	LineOfBusiness.*,
	Currency.*,
	AmountInCurrency}
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode
			{("DataSourceID") AS DataSourceID,
				(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceVendorAccountsReceivable)) AS DataSource,
				(InventoryOwnerAttribute.Organization).* AS Organization,
				(InventoryOwnerAttribute.Counterparty).* AS Counterparty,
				(InventoryOwnerAttribute.GoodsOwner).* AS Partner,
				(VALUE(Catalog.BusinessStructure.EmptyRef)).* AS Department,
				(Currency).* AS Currency,
				(VALUE(Catalog.LinesOfBusiness.EmptyRef)).* AS LineOfBusiness
			}
	) AS GoodsToBeRegisteredInReportsToConsignor
		LEFT JOIN InventoryKinds AS ProductAccountingAttributes
		ON GoodsToBeRegisteredInReportsToConsignor.InventoryOwnerAttribute = ProductAccountingAttributes.Ref
WHERE
	GoodsToBeRegisteredInReportsToConsignor.RevenueAmountBalance &gt; 0</query>
			<autoFillFields>false</autoFillFields>
		</item>
	</dataSet>
