					<v8:lang>fa</v8:lang>
					<v8:content>ویژگی‌های مالک موجودی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipologia di scorte</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Rodzaj pozycji</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид запасов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Stok sahibinin öznitelikleri</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Dạng vật tư</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:required>true</dcscom:required>
			</role>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.InventoryKinds</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AccountingDimensionByPartners.DimensionKey AS DimensionKey,
	AccountingDimensionByPartners.Organization AS Organization,
	AccountingDimensionByPartners.Partner AS Partner,
	AccountingDimensionByPartners.Counterparty AS Counterparty,
	AccountingDimensionByPartners.Contract AS Contract
INTO AccountingDimensionByPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
WHERE
	AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	AccountingDimensionByPartners.Partner.* AS Partner,
	AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	AccountingDimensionByPartners.Organization.* AS Organization,
	AccountingDimensionByPartners.Contract.* AS Contract}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VendorsARAPAccounting.AccountingDimensionByPartners AS DimensionKey,
	VendorsARAPAccounting.ARAPObject.Object AS PurchaseOrder,
	VendorsARAPAccounting.ARAPObject.Department AS Department, 
	VendorsARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness, 
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.SumBalance AS AmountInCurrency
INTO VendorsARAPAccounting
FROM
	AccumulationRegister.VendorsARAPAccounting.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingDimensionByPartners IN
					(SELECT
						TTAccountingAnalyticsForPartners.DimensionKey
					FROM
						AccountingDimensionByPartners AS TTAccountingAnalyticsForPartners)
			{("DataSourceID") AS DataSourceID,
				(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsToVendor_)) AS DataSource
			}) AS VendorsARAPAccounting
WHERE
	VendorsARAPAccounting.SumBalance &gt; 0

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryKinds.Ref AS Ref,
	InventoryKinds.Organization AS Organization,
	InventoryKinds.Counterparty AS Counterparty,
	InventoryKinds.GoodsOwner AS Partner
INTO InventoryKinds
FROM
	Catalog.InventoryKinds AS InventoryKinds
{WHERE
	InventoryKinds.Organization.* AS Organization,
	InventoryKinds.Counterparty.* AS Counterparty,
	InventoryKinds.GoodsOwner.* AS Partner}

INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsToBeRegisteredInReportsToConsignor.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	GoodsToBeRegisteredInReportsToConsignor.Currency AS Currency,
	-GoodsToBeRegisteredInReportsToConsignor.RevenueAmountBalance AS AmountInCurrency
INTO GoodsToBeRegisteredInReportsToConsignor
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND InventoryOwnerAttribute IN
					(SELECT
						InventoryKinds.Ref
					FROM
						InventoryKinds AS InventoryKinds)
				{("DataSourceID") AS DataSourceID,
					(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsToVendor_)) AS DataSource
				}) AS GoodsToBeRegisteredInReportsToConsignor
WHERE
	GoodsToBeRegisteredInReportsToConsignor.RevenueAmountBalance &lt; 0

INDEX BY
	InventoryOwnerAttribute
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsToVendor_) AS DataSource,
	VendorsARAPAccounting.DimensionKey AS DimensionKey,
	VendorsARAPAccounting.PurchaseOrder AS PurchaseOrder,
	UNDEFINED AS InventoryOwnerAttribute,
	AccountingDimensionByPartners.Organization AS Organization,
	VendorsARAPAccounting.Department AS Department,
	AccountingDimensionByPartners.Partner AS Partner,
	AccountingDimensionByPartners.Counterparty AS Counterparty,
	AccountingDimensionByPartners.Contract AS Contract,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.AmountInCurrency AS AmountInCurrency,
	VendorsARAPAccounting.LineOfBusiness AS LineOfBusiness
{SELECT
	DataSource,
	DimensionKey,
	PurchaseOrder,
	InventoryOwnerAttribute,
	Organization.*,
	Department.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	Currency.*,
	AmountInCurrency,
	LineOfBusiness.*}
FROM
	VendorsARAPAccounting AS VendorsARAPAccounting
		LEFT JOIN AccountingDimensionByPartners AS AccountingDimensionByPartners
		ON VendorsARAPAccounting.DimensionKey = AccountingDimensionByPartners.DimensionKey
{WHERE
	VendorsARAPAccounting.Currency.* AS Currency,
	VendorsARAPAccounting.Department.* AS Department}

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalancePrepaymentsToVendor_),
	UNDEFINED AS DimensionKey,
	UNDEFINED AS PurchaseOrder,
	GoodsToBeRegisteredInReportsToConsignor.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryKinds.Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef),
	InventoryKinds.Partner,
	InventoryKinds.Counterparty,
	&amp;EmptyDimensionValue,
	GoodsToBeRegisteredInReportsToConsignor.Currency,
	GoodsToBeRegisteredInReportsToConsignor.AmountInCurrency,
	VALUE(Catalog.LinesOfBusiness.EmptyRef)
FROM
	GoodsToBeRegisteredInReportsToConsignor AS GoodsToBeRegisteredInReportsToConsignor
		LEFT JOIN InventoryKinds AS InventoryKinds
		ON GoodsToBeRegisteredInReportsToConsignor.InventoryOwnerAttribute = InventoryKinds.Ref
{WHERE
	GoodsToBeRegisteredInReportsToConsignor.Currency.* AS Currency,
	(VALUE(Catalog.LinesOfBusiness.EmptyRef)).* AS LinesOfBusiness}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
