					<v8:content>Tutar türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu số tiền</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.IssuedBorrowings) AS DataSource,
	SettlementsUnderCreditAndDepositContracts.Contract AS Contract,
	SettlementsUnderCreditAndDepositContracts.Contract.Organization AS Organization,
	SettlementsUnderCreditAndDepositContracts.Contract.BankAccount AS BankAccount,
	SettlementsUnderCreditAndDepositContracts.Contract.ARAPCurrency AS Currency,
	SettlementsUnderCreditAndDepositContracts.Contract.Counterparty AS Counterparty,
	SettlementsUnderCreditAndDepositContracts.Contract.LineOfBusiness AS LineOfBusiness,
	SettlementsUnderCreditAndDepositContracts.Contract.Partner AS Partner,
	SettlementsUnderCreditAndDepositContracts.Contract.Department AS Department,
	SettlementsUnderCreditAndDepositContracts.AmountType AS AmountType,
	SettlementsUnderCreditAndDepositContracts.SumBalance AS AmountInCurrency,
	SettlementsUnderCreditAndDepositContracts.SumManBalance AS SumMan,
	SettlementsUnderCreditAndDepositContracts.SumComplBalance AS SumCompl
{SELECT
	DataSource,
	Contract.*,
	Organization.*,
	BankAccount.*,
	Currency.*,
	Counterparty.*,
	LineOfBusiness.*,
	Partner.*,
	Department.*,
	AmountType.*,
	AmountInCurrency,
	SumMan,
	SumCompl}
FROM
	AccumulationRegister.FinancialInstrumentsARAP.Balance(&amp;PeriodLimit,
		&amp;SourcePrivilegedMode = &amp;PrivilegedMode
	AND Contract.ContractKind = VALUE(Enum.ContractKindsOfFinancialInstruments.IssuedBorrowing)
		{("DataSourceID") AS DataSourceID,
		(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.IssuedBorrowings)) AS DataSource, (Contract).* AS Contract,
		(Contract.Organization).* AS Organization, (Contract.Department).* AS Department, (Contract.Partner).* AS
		Partner, (Contract.Counterparty).* AS Counterparty, (Contract.BankAccount).* AS BankAccount,
		(Contract.ARAPCurrency).* AS Currency, (Contract.LineOfBusiness).* AS LineOfBusiness,
		AmountType.* AS AmountType}) AS SettlementsUnderCreditAndDepositContracts
WHERE
	SettlementsUnderCreditAndDepositContracts.SumBalance &gt; 0</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
