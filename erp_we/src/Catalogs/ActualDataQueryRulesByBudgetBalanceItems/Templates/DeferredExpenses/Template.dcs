		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ExpenseItems.Ref
INTO ExpenseItems
FROM
	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
WHERE
	ExpenseItems.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
{WHERE
	ExpenseItems.Ref.* AS ExpenseItem}

INDEX BY
	ExpenseItems.Ref
;

////////////////////////////////////////////////////////////////////////////////
// Independence from the state of the functional option
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceDeferredExpenses) AS DataSource,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	VALUE(Catalog.Companies.EmptyRef) AS DimensionOfExpenses,
	0 AS SumMan
{SELECT
	DataSource,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	ExpenseItem.*,
	DimensionOfExpenses.*,
	SumMan}
WHERE
	FALSE
{WHERE
	("DataSourceID") AS DataSourceID,
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceDeferredExpenses) AS DataSource,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	VALUE(Catalog.Companies.EmptyRef) AS DimensionOfExpenses}

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceDeferredExpenses) AS DataSource,
	DeferredExpenses.Organization AS Organization,
	DeferredExpenses.Department AS Department,
	DeferredExpenses.LineOfBusiness AS LineOfBusiness,
	DeferredExpenses.ExpenseItem AS ExpenseItem,
	DeferredExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	DeferredExpenses.SumBalance AS SumMan
FROM
	AccumulationRegister.OtherExpenses.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND ExpenseItem IN
					(SELECT
						ExpenseItems.Ref
					FROM
						ExpenseItems AS ExpenseItems)
			{("DataSourceID") AS DataSourceID,
				(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceDeferredExpenses)) AS DataSource,
				(DimensionOfExpenses).*, (LineOfBusiness).*, (Organization).*, (Department).*, (ExpenseItem).*
			}) AS DeferredExpenses
{WHERE
	DeferredExpenses.Organization.* AS Organization,
	DeferredExpenses.Department.* AS Department,
	DeferredExpenses.LineOfBusiness.* AS LineOfBusiness,
	DeferredExpenses.DimensionOfExpenses.* AS DimensionOfExpenses}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
