		<dataSource>DataSource1</dataSource>
		<query>// Independence from the state of the functional option
SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceIntangibleAssets) AS DataSource,
	VALUE(Catalog.IntangibleAssets.EmptyRef) AS IntangibleAsset,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS FinancialAccountingGroup,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	0 AS Sum,
	0 AS SumCompl
{SELECT
	DataSource,
	IntangibleAsset.*,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	FinancialAccountingGroup.*,
	Sum,
	SumCompl}
WHERE
	FALSE
{WHERE
	("DataSourceID") AS DataSourceID,
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceIntangibleAssets) AS DataSource,
	VALUE(Catalog.IntangibleAssets.EmptyRef) AS IntangibleAsset,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.NonCurrentAssetsAccountingGroups.EmptyRef) AS FinancialAccountingGroup,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness}

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceIntangibleAssets) AS DataSource,
	RegisterData.IntangibleAsset AS IntangibleAsset,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.FinancialAccountingGroup AS FinancialAccountingGroup,
	RegisterData.LineOfBusiness AS LineOfBusiness,
	RegisterData.CostBalance AS Sum,
	RegisterData.LocalCostBalance + RegisterData.CostTargetFinancingBalance AS SumCompl
FROM
	AccumulationRegister.IACost.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceIntangibleAssets)) AS DataSource, (Organization).*, (Department).* AS Department, (LineOfBusiness).* AS LineOfBusiness, (IntangibleAsset).* AS IntangibleAsset, (FinancialAccountingGroup).* AS FinancialAccountingGroup}) AS RegisterData

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceIntangibleAssets),
	RegisterData.IntangibleAsset,
	RegisterData.Organization,
	RegisterData.Department,
	RegisterData.FinancialAccountingGroup,
	RegisterData.LineOfBusiness,
	RegisterData.DepreciationBalance,
	RegisterData.DepreciationLocalBalance + RegisterData.FixedAssetDepreciationTargetFinancingBalance
FROM
	AccumulationRegister.IntangibleAssetsAmortizationCharge.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceIntangibleAssets)) AS DataSource, (Organization).*, (Department).* AS Department, (LineOfBusiness).* AS LineOfBusiness, (IntangibleAsset).* AS IntangibleAsset, (FinancialAccountingGroup).* AS FinancialAccountingGroup}) AS RegisterData
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
