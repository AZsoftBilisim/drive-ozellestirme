				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Nguồn dữ liệu</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AccountingDimensionByPartners.DimensionKey AS DimensionKey,
	AccountingDimensionByPartners.Organization AS Organization,
	CAST(AccountingDimensionByPartners.Counterparty AS Catalog.Companies) AS OwnCompany
INTO AccountingAnalyticsForPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
WHERE
	AccountingDimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnCompaniesARAP) AS DataSource,
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	AccountingAnalyticsForPartners.Organization AS Organization,
	AccountingAnalyticsForPartners.OwnCompany AS OwnCompany,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	CustomersARAPAccounting.ARAPObject.Object AS OrderDocument,
	CustomersARAPAccounting.ARAPObject.Department AS Department,
	CustomersARAPAccounting.Currency AS Currency,
	CustomersARAPAccounting.SumBalance AS AmountInCurrency
{SELECT
	DataSource,
	AccountingDimensionByPartners.*,
	Organization.*,
	OwnCompany.*,
	LineOfBusiness.*,
	OrderDocument.*,
	Department.*,
	Currency.*,
	AmountInCurrency}
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingDimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
			{("DataSourceID") AS DataSourceID,
				(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnCompaniesARAP)) AS DataSource,
				(AccountingDimensionByPartners).* AS AccountingDimensionByPartners,
				(AccountingDimensionByPartners.Organization).* AS Organization,
				(CAST(AccountingDimensionByPartners.Counterparty AS Catalog.Companies)).* AS OwnCompany,
				(ARAPObject.LineOfBusiness).* AS LineOfBusiness,
				(ARAPObject.Object).* AS OrderDocument,
				(ARAPObject.Department).* AS Department,
				(Currency).* AS Currency
			}) AS CustomersARAPAccounting
		LEFT JOIN AccountingAnalyticsForPartners AS AccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = AccountingAnalyticsForPartners.DimensionKey
WHERE
	CustomersARAPAccounting.SumBalance &gt; 0

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnCompaniesARAP),
	VendorsARAPAccounting.AccountingDimensionByPartners,
	AccountingAnalyticsForPartners.Organization,
	AccountingAnalyticsForPartners.OwnCompany,
	VendorsARAPAccounting.ARAPObject.LineOfBusiness,
	VendorsARAPAccounting.ARAPObject.Object,
	VendorsARAPAccounting.ARAPObject.Department,
	VendorsARAPAccounting.Currency,
	VendorsARAPAccounting.SumBalance
FROM
	AccumulationRegister.VendorsARAPAccounting.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingDimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
			{("DataSourceID") AS DataSourceID,
				(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnCompaniesARAP)) AS DataSource,
				(AccountingDimensionByPartners).* AS AccountingDimensionByPartners,
				(AccountingDimensionByPartners.Organization).* AS Organization,
				(CAST(AccountingDimensionByPartners.Counterparty AS Catalog.Companies)).* AS OwnCompany,
				(ARAPObject.LineOfBusiness).* AS LineOfBusiness,
				(ARAPObject.Object).* AS OrderDocument,
				(ARAPObject.Department).* AS Department,
				(Currency).* AS Currency
			}) AS VendorsARAPAccounting
		LEFT JOIN AccountingAnalyticsForPartners AS AccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = AccountingAnalyticsForPartners.DimensionKey
WHERE
	VendorsARAPAccounting.SumBalance &gt; 0</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
