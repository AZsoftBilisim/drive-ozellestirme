		<dataSource>DataSource1</dataSource>
		<query>

// DON'T OVERFILL WITH THE CONSTRUCTOR - THERE ARE CLIPPING TAGS


SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceWorkInProgress) AS DataSource,
	OtherWorkInProgressExpenses.Organization AS Organization,
	OtherWorkInProgressExpenses.Department AS Department,
	OtherWorkInProgressExpenses.CostBalance AS SumMan,
	CASE
		WHEN &amp;EnterpriseManagement = TRUE
				AND (FALSE

					OR FALSE)
			THEN ISNULL(OtherWorkInProgressExpenses.ProductionOrder.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef))
		ELSE UNDEFINED
	END AS LineOfBusiness
{SELECT
	DataSource,
	Organization.*,
	Department.*,
	SumMan,
	LineOfBusiness.*}
FROM
	AccumulationRegister.OtherWorkInProgressExpenses.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceWorkInProgress)) AS DataSource, (Organization).* AS Organization, (Department).* AS Department, (CASE
			    WHEN &amp;EnterpriseManagement = TRUE
			            AND (FALSE

			                OR FALSE)
			        THEN ISNULL(ProductionOrder.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef))
			    ELSE UNDEFINED
			END).* AS LineOfBusiness}) AS OtherWorkInProgressExpenses

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceWorkInProgress),
	InventoryCost.Organization,
	DimensionDepartments.Ref,
	CASE
		WHEN InventoryCost.CostManBalance + InventoryCost.AddExpensesManBalance + InventoryCost.ItemizedFixedCostsManagBalance + InventoryCost.LaborCostsManBalance + InventoryCost.ItemizedVariableCostsManagBalance = 0
			THEN InventoryCost.CostBalance + InventoryCost.AddExpensesForGoodsBalance + InventoryCost.ItemizedFixedCostsIncludingVATBalance + InventoryCost.LaborCostsBalance + InventoryCost.ItemizedVariableCostsIncludingVATBalance
		ELSE InventoryCost.CostManBalance + InventoryCost.AddExpensesManBalance + InventoryCost.ItemizedFixedCostsManagBalance + InventoryCost.LaborCostsManBalance + InventoryCost.ItemizedVariableCostsManagBalance
	END AS SumMan,
	Assignments.LineOfBusiness
FROM
	AccumulationRegister.InventoryCost.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts) {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceWorkInProgress)) AS DataSource, (Organization).* AS Organization}) AS InventoryCost
		LEFT JOIN Catalog.Assignments AS Assignments
		ON InventoryCost.ItemsLocationAttributes.Purpose = Assignments.Ref
		LEFT JOIN Catalog.BusinessStructure AS DimensionDepartments
		ON InventoryCost.FinancialAccountingDimension = DimensionDepartments.Ref
{WHERE
	Assignments.LineOfBusiness.* AS LineOfBusiness,
	DimensionDepartments.Ref.* AS Department}

UNION ALL

SELECT
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceWorkInProgress),
	WIPLaborCosts.Organization,
	WIPLaborCosts.Department,
	WIPLaborCosts.CostBalance,


		UNDEFINED


FROM
	AccumulationRegister.WIPLaborCosts.Balance(&amp;PeriodLimit, &amp;SourcePrivilegedMode = &amp;PrivilegedMode {("DataSourceID") AS DataSourceID, (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceWorkInProgress)) AS DataSource, (Organization).* AS Organization, (Department).* AS Department, 
		(


				UNDEFINED


		).* AS LineOfBusiness}) AS WIPLaborCosts</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
