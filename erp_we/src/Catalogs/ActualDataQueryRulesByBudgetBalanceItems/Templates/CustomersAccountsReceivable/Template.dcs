		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AccountingDimensionByPartners.DimensionKey,
	AccountingDimensionByPartners.Partner,
	AccountingDimensionByPartners.Counterparty,
	AccountingDimensionByPartners.Organization,
	AccountingDimensionByPartners.Contract
INTO AccountingAnalyticsForPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS AccountingDimensionByPartners
WHERE
	AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	AccountingDimensionByPartners.Partner.* AS Partner,
	AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	AccountingDimensionByPartners.Organization.* AS Organization,
	AccountingDimensionByPartners.Contract.* AS Contract}

INDEX BY
	DimensionKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceCustomersAccountsReceivable) AS DataSource,
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CustomersARAPAccounting.AccountingDimensionByPartners.Contract AS Contract,
	CustomersARAPAccounting.AccountingDimensionByPartners.Counterparty AS Counterparty,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	CustomersARAPAccounting.AccountingDimensionByPartners.Organization AS Organization,
	CustomersARAPAccounting.AccountingDimensionByPartners.Partner AS Partner,
	CustomersARAPAccounting.Currency AS Currency,
	CustomersARAPAccounting.ARAPObject.Object AS SalesOrder,
	CustomersARAPAccounting.ARAPObject.Department AS Department,
	CustomersARAPAccounting.SumBalance AS AmountInCurrency
{SELECT
	DataSource,
	AccountingDimensionByPartners.*,
	Contract.*,
	Counterparty.*,
	LineOfBusiness.*,
	Organization.*,
	Partner.*,
	Currency.*,
	SalesOrder.*,
	Department.*,
	AmountInCurrency}
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
				AND AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise) 
		{("DataSourceID") AS DataSourceID,
			(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceCustomersAccountsReceivable)) AS DataSource,
			(Currency).* AS Currency, (ARAPObject.Object).* AS SalesOrder,
			(ARAPObject.Department).* AS Department,
			(AccountingDimensionByPartners.Partner).* AS Partner,
			(AccountingDimensionByPartners.Organization).* AS Organization,
			(AccountingDimensionByPartners.Counterparty).* AS Counterparty,
			(AccountingDimensionByPartners.Contract).* AS Contract,
			(ARAPObject.LineOfBusiness).* AS LineOfBusiness
		}) AS CustomersARAPAccounting
		INNER JOIN AccountingAnalyticsForPartners AS AccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = AccountingAnalyticsForPartners.DimensionKey
WHERE
	CustomersARAPAccounting.SumBalance &gt; 0</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
