		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceDiscountingExpenses) AS DataSource,
	RegisterData.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	RegisterData.AccountingDimensionByPartners.Contract AS Contract,
	RegisterData.AccountingDimensionByPartners.Counterparty AS Counterparty,
	RegisterData.ARAPObject.LineOfBusiness AS LineOfBusiness,
	RegisterData.AccountingDimensionByPartners.Organization AS Organization,
	RegisterData.AccountingDimensionByPartners.Partner AS Partner,
	RegisterData.Currency AS Currency,
	RegisterData.ARAPObject.Object AS SalesOrder,
	RegisterData.ARAPObject.Department AS Department,
	RegisterData.ARAPDocument AS ARAPDocument,
	RegisterData.DiscountingAmountBalance AS AmountInCurrency,
	RegisterData.DiscountingAmountManBalance AS SumMan,
	RegisterData.DiscountingAmountComplBalance AS SumCompl
{SELECT
	DataSource,
	AccountingDimensionByPartners.*,
	Contract.*,
	Counterparty.*,
	LineOfBusiness.*,
	Organization.*,
	Partner.*,
	Currency.*,
	SalesOrder.*,
	Department.*,
	ARAPDocument.*,
	AmountInCurrency,
	SumMan,
	SumCompl}
FROM
	AccumulationRegister.DiscountInterestExpense.Balance(
			&amp;PeriodLimit,
			&amp;SourcePrivilegedMode = &amp;PrivilegedMode
		{("DataSourceID") AS DataSourceID,
			(VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceDiscountingExpenses)) AS DataSource,
			(Currency).* AS Currency,
			(ARAPObject.Object).* AS SalesOrder,
			(ARAPObject.Department).* AS Department,
			(ARAPDocument).* AS ARAPDocument,
			(AccountingDimensionByPartners.Partner).* AS Partner,
			(AccountingDimensionByPartners.Organization).* AS Organization,
			(AccountingDimensionByPartners.Counterparty).* AS Counterparty,
			(AccountingDimensionByPartners.Contract).* AS Contract,
			(ARAPObject.LineOfBusiness).* AS LineOfBusiness
		}) AS RegisterData
WHERE
	RegisterData.DiscountingAmountBalance &gt; 0</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
