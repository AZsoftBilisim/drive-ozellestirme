      <queryText>SELECT
	CatalogWorkCenterTypes.Ref AS Ref,
	CatalogWorkCenterTypes.Description AS Description,
	CatalogWorkCenterTypes.Department AS Department,
	COUNT(WorkCenters.Ref) AS NumberOfWorkCenters
FROM
	Catalog.WorkCenterTypes AS CatalogWorkCenterTypes
		LEFT JOIN Catalog.WorkCenters AS WorkCenters
		ON CatalogWorkCenterTypes.Ref = WorkCenters.WorkCenterType

GROUP BY
	CatalogWorkCenterTypes.Ref,
	CatalogWorkCenterTypes.Description,
	CatalogWorkCenterTypes.Department</queryText>
