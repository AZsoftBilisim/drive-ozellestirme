  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogDemoScenarios.Ref                    AS Ref,
	CatalogDemoScenarios.DeletionMark           AS DeletionMark,
	CatalogDemoScenarios.Parent                  AS Parent,
	CatalogDemoScenarios.IsFolder                 AS IsFolder,
	CatalogDemoScenarios.Code                       AS Code,
	CatalogDemoScenarios.Description              AS Description,
	CatalogDemoScenarios.FullCode                 AS FullCode,
	CatalogDemoScenarios.Status                    AS Status,
	CatalogDemoScenarios.Comment               AS Comment,
	CatalogDemoScenarios.GroupType                 AS GroupType,
	CatalogDemoScenarios.Predefined          AS Predefined,
	CatalogDemoScenarios.PredefinedDataName AS PredefinedDataName,
	CASE
		WHEN NOT CatalogDemoScenarios.IsFolder
			THEN CASE
					WHEN CatalogDemoScenarios.DeletionMark
						THEN 4
					ELSE 3
				END
		WHEN CatalogDemoScenarios.GroupType = 1 
			OR CatalogDemoScenarios.GroupType =  VALUE(Enum.TypesOfProcessDetailsGroups.Branching)
			THEN CASE
					WHEN CatalogDemoScenarios.DeletionMark
						THEN 20
					ELSE 19
				END
		ELSE CASE
				WHEN CatalogDemoScenarios.DeletionMark
					THEN 1
				ELSE 0
			END
	END AS PictureIndex
FROM
	Catalog.DemoScenarios AS CatalogDemoScenarios</queryText>
      <mainTable>Catalog.DemoScenarios</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
