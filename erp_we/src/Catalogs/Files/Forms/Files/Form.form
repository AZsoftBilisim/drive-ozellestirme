  <attributes>
    <name>Folders</name>
    <title>
      <key>en</key>
      <value>Folders</value>
    </title>
    <title>
      <key>fa</key>
      <value>پوشه‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Cartelle</value>
    </title>
    <title>
      <key>pl</key>
      <value>Foldery</value>
    </title>
    <title>
      <key>ru</key>
      <value>Папки</value>
    </title>
    <title>
      <key>tr</key>
      <value>Klasörler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Thư mục</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.Account</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.AccountService</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.FolderSynchronizationEnabled</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.Href</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.IsSynchronized</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.PictureIndex</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Folders.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	FilesFolders.Ref,
	FilesFolders.DeletionMark,
	FilesFolders.Predefined,
	FilesFolders.Parent,
	FilesFolders.Code,
	FilesFolders.Description,
	FilesFolders.LongDesc,
	FilesFolders.EmployeeResponsible,
	FilesFolders.CreationDate,
	FilesFolders.Presentation,
	CASE
		WHEN FilesSynchronizationWithCloudServiceStatuses.File = FilesFolders.Ref
			THEN 2
		WHEN FilesFolders.DeletionMark = TRUE
			THEN 1
		ELSE 0
	END AS PictureIndex,
	CASE
		WHEN FilesSynchronizationWithCloudServiceStatuses.File = FilesFolders.Ref
			THEN TRUE
		ELSE FALSE
	END AS FolderSynchronizationEnabled,
	FilesSynchronizationWithCloudServiceStatuses.Href,
	FilesSynchronizationWithCloudServiceStatuses.Account.Description,
	FilesSynchronizationWithCloudServiceStatuses.Account.Service,
	FilesSynchronizationWithCloudServiceStatuses.SynchronizationDateStart,
	FilesSynchronizationWithCloudServiceStatuses.Account AS Account,
	FilesSynchronizationWithCloudServiceStatuses.IsSynchronized
FROM
	Catalog.FilesFolders AS FilesFolders
		LEFT JOIN InformationRegister.FilesSynchronizationWithCloudServiceStatuses AS FilesSynchronizationWithCloudServiceStatuses
		ON FilesFolders.Ref = FilesSynchronizationWithCloudServiceStatuses.File</queryText>
      <mainTable>Catalog.FilesFolders</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
