      <value>Người sử dụng danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.ThereAreSpecificationsByPriceGroups</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	UserGroupsComposition.Ref AS UsersGroup
INTO TemporaryTableLimitingManualDiscountsForAUserGroup
FROM
	Catalog.Users AS Users
		INNER JOIN Catalog.UserGroups.Content AS UserGroupsComposition
		ON (UserGroupsComposition.User = Users.Ref)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TemporaryTableLimitingManualDiscountsForAUserGroup.UsersGroup AS UsersGroup,
	VALUE(Catalog.PriceGroups.EmptyRef) AS PriceGroup,
	SalesSettingsForUsers.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
	SalesSettingsForUsers.MaximumPercentageForManualMarkup AS MaximumPercentageForManualMarkup
INTO PercentagesOfDiscountsMarkupsByGroup
FROM
	TemporaryTableLimitingManualDiscountsForAUserGroup AS TemporaryTableLimitingManualDiscountsForAUserGroup
		INNER JOIN Catalog.SalesSettingsForUsers AS SalesSettingsForUsers
		ON TemporaryTableLimitingManualDiscountsForAUserGroup.UsersGroup = SalesSettingsForUsers.Owner
			AND (SalesSettingsForUsers.LimitDiscountAdjustments)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MIN(TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions.Priority) AS Priority,
	TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions.User AS User,
	TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions.PriceGroup AS PriceGroup
INTO MaxPriority
FROM
	(SELECT
		TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.User AS User,
		2 AS Priority,
		TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.PriceGroup AS PriceGroup,
		MAX(TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.PercentRateOfManualDiscount) AS PercentRateOfManualDiscount,
		MAX(TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.MaximumPercentageForManualMarkup) AS MaximumPercentageForManualMarkup
	FROM
		(SELECT
			GroupsAndUsers.User AS User,
			GroupsAndUsers.Ref AS UsersGroup,
			T.PriceGroup AS PriceGroup,
			T.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
			T.MaximumPercentageForManualMarkup AS MaximumPercentageForManualMarkup
		FROM
			Catalog.UserGroups.Content AS GroupsAndUsers
				INNER JOIN PercentagesOfDiscountsMarkupsByGroup AS T
				ON GroupsAndUsers.Ref = T.UsersGroup) AS TemporaryTableManualDiscountRestrictionsUserGroupRestrictions
	
	GROUP BY
		TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.User,
		TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.PriceGroup
	
	UNION ALL
	
	SELECT
		SalesSettingsForUsers.Owner,
		1,
		VALUE(Catalog.PriceGroups.EmptyRef),
		SalesSettingsForUsers.PercentRateOfManualDiscount,
		SalesSettingsForUsers.MaximumPercentageForManualMarkup
	FROM
		Catalog.SalesSettingsForUsers AS SalesSettingsForUsers
	WHERE
		SalesSettingsForUsers.Owner REFS Catalog.Users
		AND SalesSettingsForUsers.LimitDiscountAdjustments) AS TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions

GROUP BY
	TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions.User,
	TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions.PriceGroup
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.User AS User,
	2 AS Priority,
	TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.PriceGroup AS PriceGroup,
	MAX(TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.PercentRateOfManualDiscount) AS PercentRateOfManualDiscount,
	MAX(TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.MaximumPercentageForManualMarkup) AS MaximumPercentageForManualMarkup
INTO MaxDiscountMarginPercentage
FROM
	(SELECT
		GroupsAndUsers.User AS User,
		GroupsAndUsers.Ref AS UsersGroup,
		T.PriceGroup AS PriceGroup,
		T.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
		T.MaximumPercentageForManualMarkup AS MaximumPercentageForManualMarkup
	FROM
		Catalog.UserGroups.Content AS GroupsAndUsers
			INNER JOIN PercentagesOfDiscountsMarkupsByGroup AS T
			ON GroupsAndUsers.Ref = T.UsersGroup) AS TemporaryTableManualDiscountRestrictionsUserGroupRestrictions

GROUP BY
	TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.User,
	TemporaryTableManualDiscountRestrictionsUserGroupRestrictions.PriceGroup

UNION ALL

SELECT
	SalesSettingsForUsers.Owner,
	1,
	VALUE(Catalog.PriceGroups.EmptyRef),
	SalesSettingsForUsers.PercentRateOfManualDiscount,
	SalesSettingsForUsers.MaximumPercentageForManualMarkup
FROM
	Catalog.SalesSettingsForUsers AS SalesSettingsForUsers
WHERE
	SalesSettingsForUsers.Owner REFS Catalog.Users
	AND SalesSettingsForUsers.LimitDiscountAdjustments
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Restrictions.User AS User,
	Restrictions.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
	Restrictions.MaximumPercentageForManualMarkup AS MaximumPercentageForManualMarkup
INTO Restrictions
FROM
	MaxPriority AS T
		LEFT JOIN MaxDiscountMarginPercentage AS Restrictions
		ON (Restrictions.PriceGroup = T.PriceGroup)
			AND (Restrictions.User = T.User)
			AND (Restrictions.Priority = T.Priority)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Users.Ref AS Ref,
	Users.Invalid AS Invalid,
	Users.DeletionMark AS DeletionMark,
	Users.Predefined AS Predefined,
	Users.Description AS Description,
	CASE
		WHEN Users.DeletionMark
			THEN 0
		WHEN Users.IBUserID = &amp;BlankUUID
			THEN 4
		ELSE 1
	END AS PictureNumber,
	ISNULL(SalesSettingsForUsers.ThereAreSpecificationsByPriceGroups, 0) AS ThereAreSpecificationsByPriceGroups,
	ISNULL(Restrictions.PercentRateOfManualDiscount, 0) AS PercentRateOfManualDiscount,
	ISNULL(Restrictions.MaximumPercentageForManualMarkup, 0) AS MaximumPercentageForManualMarkup,
	SalesSettingsForUsers.CWP_Use AS CWP_Use
FROM
	Catalog.Users AS Users
		LEFT JOIN Restrictions AS Restrictions
		ON Users.Ref = Restrictions.User
		LEFT JOIN Catalog.SalesSettingsForUsers AS SalesSettingsForUsers
		ON (SalesSettingsForUsers.Owner = Users.Ref)
WHERE
	(&amp;SelectHierarchy
				AND TRUE IN
					(SELECT
						TRUE
					FROM
						InformationRegister.UserGroupCompositions AS UserGroupCompositions
					WHERE
						UserGroupCompositions.User = Users.Ref
						AND UserGroupCompositions.UsersGroup = &amp;UsersGroup)
			OR NOT &amp;SelectHierarchy
				AND TRUE IN
					(SELECT
						TRUE
					FROM
						Catalog.UserGroups.Content AS UserGroupsComposition
					WHERE
						UserGroupsComposition.User = Users.Ref
						AND UserGroupsComposition.Ref = &amp;UsersGroup))</queryText>
