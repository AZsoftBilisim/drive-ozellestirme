    <functionalOptions>FunctionalOption.UseUserGroups</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UserGroups.LimitDiscountAdjustments</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UserGroups.PictureNumber</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UserGroups.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UserGroups.ThereAreSpecificationsByPriceGroups</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogUserGroups.Ref AS Ref,
	CatalogUserGroups.DeletionMark AS DeletionMark,
	CatalogUserGroups.Predefined AS Predefined,
	CatalogUserGroups.Parent AS Parent,
	CatalogUserGroups.Description AS Description,
	CASE
		WHEN CatalogUserGroups.DeletionMark
			THEN 2
		ELSE 3
	END AS PictureNumber,
	ISNULL(SalesSettingsForUsers.ThereAreSpecificationsByPriceGroups, FALSE) AS ThereAreSpecificationsByPriceGroups,
	ISNULL(SalesSettingsForUsers.PercentRateOfManualDiscount, 0) AS PercentRateOfManualDiscount,
	ISNULL(SalesSettingsForUsers.MaximumPercentageForManualMarkup, 0) AS MaximumPercentageForManualMarkup,
	SalesSettingsForUsers.LimitDiscountAdjustments AS LimitDiscountAdjustments,
	SalesSettingsForUsers.CWP_Use AS CWP_Use
FROM
	Catalog.UserGroups AS CatalogUserGroups
		LEFT JOIN Catalog.SalesSettingsForUsers AS SalesSettingsForUsers
		ON (SalesSettingsForUsers.Owner = CatalogUserGroups.Ref)
</queryText>
