    <items xsi:type="form:FormGroup">
      <name>RedTriangleGroup</name>
      <id>35</id>
      <items xsi:type="form:Decoration">
        <name>DecorationRedTriangleImage</name>
        <id>37</id>
        <title>
          <key>en</key>
          <value>Decoration red triangle image</value>
        </title>
        <title>
          <key>fa</key>
          <value>تصویر تزئینی مثلث قرمز</value>
        </title>
        <title>
          <key>it</key>
          <value>Decorazione dell'immagine del triangolo rosso</value>
        </title>
        <title>
          <key>pl</key>
          <value>Dekoracja czerwony trójkąt obraz</value>
        </title>
        <title>
          <key>ru</key>
          <value>Декорация красный треугольник картинка</value>
        </title>
        <title>
          <key>tr</key>
          <value>Dekorasyon kırmızı üçgen resim</value>
        </title>
        <title>
          <key>vi</key>
          <value>Hình ảnh tam giác đỏ</value>
        </title>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <extendedTooltip>
          <name>DecorationRedTriangleImageExtendedTooltip</name>
          <id>39</id>
          <type>Label</type>
          <autoMaxWidth>true</autoMaxWidth>
          <autoMaxHeight>true</autoMaxHeight>
          <extInfo xsi:type="form:LabelDecorationExtInfo">
            <horizontalAlign>Left</horizontalAlign>
          </extInfo>
        </extendedTooltip>
        <contextMenu>
          <name>DecorationRedTriangleImageContextMenu</name>
          <id>38</id>
          <autoFill>true</autoFill>
        </contextMenu>
