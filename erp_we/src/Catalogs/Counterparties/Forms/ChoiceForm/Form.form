  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogCounterpartiesOverridable.Ref,
	CatalogCounterpartiesOverridable.DeletionMark,
	CatalogCounterpartiesOverridable.Predefined,
	CatalogCounterpartiesOverridable.Description,
	CatalogCounterpartiesOverridable.DescriptionFull,
	CatalogCounterpartiesOverridable.LegalEntityIndividual,
	CASE
		WHEN CatalogCounterpartiesOverridable.BranchOffice
			THEN CAST(&amp;RepresentationOfASeparateDivision AS STRING(100))
		ELSE CatalogCounterpartiesOverridable.LegalEntityIndividual
	END AS CounterpartyKind,
	CatalogCounterpartiesOverridable.BranchOffice,
	CatalogCounterpartiesOverridable.CompanyIndividual,
	CASE
		WHEN CatalogCounterpartiesOverridable.BranchOffice
			THEN CatalogCounterpartiesOverridable.MainCounterparty
		ELSE VALUE(Catalog.Counterparties.EmptyRef)
	END AS MainCounterparty,
	CatalogCounterpartiesOverridable.TIN AS TIN,
	UNDEFINED AS CRTR,
	UNDEFINED AS NCBOCode,
	CatalogCounterpartiesOverridable.Partner,
	CatalogCounterpartiesOverridable.Presentation,
	0 AS ThereAreCounterpartyCheckErrors,
	1 AS EDI

FROM
	Catalog.Counterparties AS CatalogCounterpartiesOverridable</queryText>
