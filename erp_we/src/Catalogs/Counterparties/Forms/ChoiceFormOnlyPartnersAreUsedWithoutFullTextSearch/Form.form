  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BranchOffice</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MainCounterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogCounterparties.Ref,
	CatalogPartners.Ref AS Partner,
	CatalogPartners.Predefined,
	CatalogPartners.Parent,
	CatalogPartners.Code,
	CatalogPartners.Description,
	CatalogPartners.BusinessRegion,
	CatalogPartners.AccessGroup,
	CatalogPartners.RegistrationDate,
	CatalogPartners.Client,
	CatalogPartners.Comment,
	CatalogPartners.Competitor,
	CatalogPartners.MainManager,
	CatalogPartners.Vendor,
	CatalogPartners.OtherRelations,
	CatalogCounterparties.TIN AS TIN,
	CatalogCounterparties.DescriptionFull AS DescriptionFull,
	CatalogCounterparties.LegalEntityIndividual,
	CASE
		WHEN ISNULL(CatalogCounterparties.BranchOffice, FALSE)
			THEN &amp;RepresentationOfASeparateDivision
		ELSE PRESENTATION(CatalogCounterparties.LegalEntityIndividual)
	END AS CounterpartyKind,
	CASE
		WHEN ISNULL(CatalogCounterparties.BranchOffice, FALSE)
			THEN CatalogCounterparties.MainCounterparty
		ELSE VALUE(Catalog.Counterparties.EmptyRef)
	END AS MainCounterparty,
	CatalogCounterparties.BranchOffice AS BranchOffice,
	UNDEFINED AS CRTR,
	UNDEFINED AS NCBOCode,
	UNDEFINED AS CounterpartyCheckStatus,
	0 AS ImageNumberVerificationStatus
FROM
	Catalog.Counterparties AS CatalogCounterparties
		INNER JOIN Catalog.Partners AS CatalogPartners
		ON CatalogCounterparties.Partner = CatalogPartners.Ref
WHERE
	CASE
		WHEN
		NOT &amp;SelectionBySegmentIsSet
			THEN TRUE
		ELSE CatalogPartners.Ref IN (&amp;FilterBySegment)
	END
	AND CASE
		WHEN
		NOT &amp;FullTextSearchSelectionIsSet
			THEN TRUE
		ELSE CatalogPartners.Ref IN (&amp;FullTextSearchSelection)
	END
{WHERE
	CatalogPartners.Ref AS ParameterizationOfThePartner}</queryText>
      <mainTable>Catalog.Counterparties</mainTable>
