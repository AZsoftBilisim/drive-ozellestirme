		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ISNULL(CustomersARAPAccountingBalance.AmountDueBalance, 0) AS RemainingAmountDueForPayment,
	Partners.Description AS PartnerName_,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	Counterparties.DescriptionFull AS AbbreviatedLegalEntityName,
	Counterparties.TIN,
	Counterparties.CRTR,
	Counterparties.NCBOCode,
	Counterparties.AdditionalInformation
FROM
	Catalog.Counterparties AS Counterparties
		{LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(, AccountingDimensionByPartners.Counterparty = &amp;Counterparties) AS CustomersARAPAccountingBalance
		ON Counterparties.Ref = CustomersARAPAccountingBalance.AccountingDimensionByPartners.Counterparty}
		{LEFT JOIN Catalog.Partners AS Partners
		ON Counterparties.Partner = Partners.Ref}
WHERE
	Counterparties.Ref = &amp;Counterparties</query>
	</dataSet>
