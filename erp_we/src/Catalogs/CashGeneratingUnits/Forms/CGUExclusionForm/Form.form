      <queryText>SELECT
	CGUCompositionSliceLast.NonCurrentAsset AS FixedAsset,
	CGUCompositionSliceLast.Organization AS Organization,
	CGUCompositionSliceLast.Period AS DateOfInclusionOfVEGDS,
	CGUCompositionSliceLast.NonCurrentAsset.Code AS Code,
	CGUCompositionSliceLast.NonCurrentAsset.AssetID AS AssetID,
	CGUCompositionSliceLast.NonCurrentAsset.ManufaturerNumber AS ManufaturerNumber,
	CGUCompositionSliceLast.NonCurrentAsset.Placement AS Placement,
	CGUCompositionSliceLast.NonCurrentAsset.OperatingBusinessUnit AS OperatingBusinessUnit,
	CGUCompositionSliceLast.NonCurrentAsset.SerialNumber AS SerialNumber
FROM
	InformationRegister.CGUComposition.SliceLast(, NonCurrentAsset REFS Catalog.Assets) AS
		CGUCompositionSliceLast
WHERE
	CGUCompositionSliceLast.CGU = &amp;CGU</queryText>
