            </content>
            <content>
              <key>ru</key>
              <value>Дата включения ВЕГДС</value>
            </content>
            <content>
              <key>tr</key>
              <value>NÜB'ye dahil edilme tarihi</value>
            </content>
            <content>
              <key>vi</key>
              <value>Ngày bật sử dụng đưa vào đơn vị tạo tiền</value>
            </content>
            <content>
              <key>it</key>
              <value>Date of including in cash-generating unit</value>
            </content>
            <content>
              <key>pl</key>
              <value>Date of including in cash-generating unit</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Organization</dataPath>
        <field>Organization</field>
      </fields>
