  <attributes>
    <name>CompositionOfAssets</name>
    <title>
      <key>en</key>
      <value>Assets scope</value>
    </title>
    <title>
      <key>fa</key>
      <value>محدوده دارایی‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Composizione attivi</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zestaw aktywów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Состав активов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Varlıkların bileşimi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Thành phần tài sản</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CGUCompositionSliceLast.NonCurrentAsset AS NonCurrentAsset,
	CGUCompositionSliceLast.Organization AS Organization,
	CGUCompositionSliceLast.Period AS DateOfInclusionOfVEGDS
FROM
	InformationRegister.CGUComposition.SliceLast(ENDOFPERIOD(&amp;Period, DAY), Organization IN (&amp;CompaniesList)) AS
		CGUCompositionSliceLast
WHERE
	CGUCompositionSliceLast.CGU = &amp;CGU
	AND CGUCompositionSliceLast.CGU &lt;> VALUE(Catalog.CashGeneratingUnits.EmptyRef)

ORDER BY
	CGUCompositionSliceLast.NonCurrentAsset.Description</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>NonCurrentAsset</dataPath>
        <field>NonCurrentAsset</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DateOfInclusionOfVEGDS</dataPath>
        <field>DateOfInclusionOfVEGDS</field>
        <title>
          <localValue>
