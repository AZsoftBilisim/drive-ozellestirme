  <attributes>
    <name>FA</name>
    <title>
      <key>en</key>
      <value>FA</value>
    </title>
    <title>
      <key>fa</key>
      <value>دارایی ثابت</value>
    </title>
    <title>
      <key>it</key>
      <value>Capitali fissi</value>
    </title>
    <title>
      <key>pl</key>
      <value>ŚT</value>
    </title>
    <title>
      <key>ru</key>
      <value>ОС</value>
    </title>
    <title>
      <key>tr</key>
      <value>SV</value>
    </title>
    <title>
      <key>vi</key>
      <value>TSCĐHH</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	CatalogAssets.Ref AS Ref,
	CatalogAssets.DeletionMark AS DeletionMark,
	CatalogAssets.Parent AS Parent,
	CatalogAssets.IsFolder AS IsFolder,
	CatalogAssets.Code AS Code,
	CatalogAssets.FixedAssetsGroupFinancialAccounting AS FixedAssetsGroupFinancialAccounting,
	CatalogAssets.AssetID AS AssetID,
	CatalogAssets.DateOfProduction AS DateOfProduction,
	CatalogAssets.CodeByRNCFA AS CodeByRNCFA,
	CatalogAssets.CodeByUFADR AS CodeByUFADR,
	CatalogAssets.DateOfLastEdit AS DateOfLastEdit,
	CatalogAssets.ManufaturerNumber AS ManufaturerNumber,
	CatalogAssets.Manufacturer_ AS Manufacturer_,
	CatalogAssets.Class AS Class,
	SUBSTRING(CatalogAssets.Comment, 1, 250) AS Comment,
	CatalogAssets.Model AS Model,
	CatalogAssets.DescriptionFull AS DescriptionFull,
	CatalogAssets.Subclass AS Subclass,
	CatalogAssets.Placement AS Placement,
	CatalogAssets.SerialNumber AS SerialNumber,
	CatalogAssets.Status AS Status,
	CatalogAssets.OperatingBusinessUnit AS OperatingBusinessUnit,
	FALocationSliceLast.Organization AS Organization,
	FALocationSliceLast.FixedAssetsLocation
FROM
	Catalog.Assets AS CatalogAssets
		LEFT JOIN InformationRegister.FALocation.SliceLast AS FALocationSliceLast
		ON CatalogAssets.Ref = FALocationSliceLast.FixedAsset
		LEFT JOIN InformationRegister.FixedAssetsAccountingProcedureManagementAccounting.SliceLast(, Organization IN (&amp;Organization)) AS
			FixedAssetsAccountingProcedureManagementAccountingSliceLast
		ON FixedAssetsAccountingProcedureManagementAccountingSliceLast.FixedAsset = CatalogAssets.Ref
		LEFT JOIN InformationRegister.AccountingProcedureForOSBU.SliceLast(, Organization IN (&amp;Organization)) AS
			AccountingProcedureForOSBUSliceLast
		ON AccountingProcedureForOSBUSliceLast.FixedAsset = CatalogAssets.Ref
WHERE
	FALocationSliceLast.Organization IN (&amp;Organization)
	AND (FixedAssetsAccountingProcedureManagementAccountingSliceLast.State IN (VALUE(Enum.FixedAssetsStates.InLease),
		VALUE(Enum.FixedAssetsStates.LeaseContractsSigned), VALUE(Enum.FixedAssetsStates.LeasedOut),
		VALUE(Enum.FixedAssetsStates.Recognized_))
		OR
		AccountingProcedureForOSBUSliceLast.BUState IN (VALUE(Enum.FixedAssetsStates.InLease),
														VALUE(Enum.FixedAssetsStates.LeaseContractsSigned), 
														VALUE(Enum.FixedAssetsStates.LeasedOut),
														VALUE(Enum.FixedAssetsStates.Recognized_))
	)
		</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
