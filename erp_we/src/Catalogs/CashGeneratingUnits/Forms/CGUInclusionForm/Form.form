  <attributes>
    <name>IA</name>
    <title>
      <key>en</key>
      <value>Intangible assets</value>
    </title>
    <title>
      <key>fa</key>
      <value>دارایی‌های نامشهود</value>
    </title>
    <title>
      <key>it</key>
      <value>Attivi immateriali</value>
    </title>
    <title>
      <key>pl</key>
      <value>Aktywa niematerialne</value>
    </title>
    <title>
      <key>ru</key>
      <value>НМА</value>
    </title>
    <title>
      <key>tr</key>
      <value>GMA</value>
    </title>
    <title>
      <key>vi</key>
      <value>TSCĐVH</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	IntangibleAssets.Code AS Code,
	IntangibleAssets.DeletionMark AS DeletionMark,
	IntangibleAssets.Parent AS Parent,
	IntangibleAssets.Ref AS Ref,
	IntangibleAssets.DescriptionFull AS DescriptionFull,
	IntangibleAssets.IntangibleAssetsKind AS IntangibleAssetsKind,
	IntangibleAssets.DepreciationGroup AS DepreciationGroup,
	SUBSTRING(IntangibleAssets.OtherInformation, 1, 250) AS OtherInformation,
	IntangibleAssets.KindOfAccountingObject AS KindOfAccountingObject,
	IntangibleAssets.IntangibleAssetGroup AS IntangibleAssetGroup,
	IntangibleAssets.RegistrationDocumentDescription AS RegistrationDocumentDescription,
	IntangibleAssets.RegistrationDocumentDate AS RegistrationDocumentDate,
	IntangibleAssets.RegistrationDocumentNumber AS RegistrationDocumentNumber,
	IntangibleAssets.BusinessActivityClassifierCode2 AS BusinessActivityClassifierCode2,
	IntangibleAssetsRegistrationPlaceSliceLast.Organization AS Organization,
	IntangibleAssetsRegistrationPlaceSliceLast.Department AS Department
FROM
	Catalog.IntangibleAssets AS IntangibleAssets
		LEFT JOIN InformationRegister.IntangibleAssetsRegistrationPlace.SliceLast AS IntangibleAssetsRegistrationPlaceSliceLast
		ON IntangibleAssetsRegistrationPlaceSliceLast.IntangibleAsset = IntangibleAssets.Ref
		LEFT JOIN InformationRegister.IntangibleAssetsAccountingProcedureManagementAccounting.SliceLast(, Organization IN (&amp;Organization)) AS
			IntangibleAssetsAccountingProcedureManagementAccountingSliceLast
		ON IntangibleAssetsAccountingProcedureManagementAccountingSliceLast.IntangibleAsset = IntangibleAssets.Ref
		LEFT JOIN InformationRegister.IABookkeepingProcedureBookkeepingAndTaxAccounting.SliceLast(, Organization IN (&amp;Organization)) AS
			IABookkeepingProcedureBookkeepingAndTaxAccountingSliceLast
		ON IABookkeepingProcedureBookkeepingAndTaxAccountingSliceLast.IntangibleAsset = IntangibleAssets.Ref
WHERE
	IntangibleAssetsRegistrationPlaceSliceLast.Organization IN (&amp;Organization)
	AND (IntangibleAssetsAccountingProcedureManagementAccountingSliceLast.State = VALUE(Enum.IntangibleAssetsStates.PostedInFinancialAccounting)
	OR IABookkeepingProcedureBookkeepingAndTaxAccountingSliceLast.BUState = VALUE(Enum.IntangibleAssetsStates.PostedInFinancialAccounting))</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
