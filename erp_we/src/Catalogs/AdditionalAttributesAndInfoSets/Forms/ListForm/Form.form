    </title>
    <title>
      <key>vi</key>
      <value>Tập hợp thuộc tính</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.AttributesCount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.InfoCount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.LabelCount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.PropertyKind</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PropertiesSets.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	SetsOverridable.Ref AS Ref,
	SetsOverridable.DataVersion AS DataVersion,
	SetsOverridable.DeletionMark AS DeletionMark,
	SetsOverridable.Predefined AS Predefined,
	SetsOverridable.Parent AS Parent,
	SetsOverridable.IsFolder AS IsFolder,
	SetsOverridable.Description AS Description,
	SetsOverridable.Used AS Used,
	CAST(&quot;&quot; AS STRING(150)) AS Presentation,
	&amp;PropertyKind AS PropertyKind,
	CASE
		WHEN SetsOverridable.DeletionMark
			THEN 1
		ELSE 0
	END + CASE
		WHEN SetsOverridable.Predefined
			THEN 2
		ELSE 0
	END AS PictureNumber,
	SetsOverridable.AttributesCount AS AttributesCount,
	SetsOverridable.InfoCount AS InfoCount,
	SetsOverridable.LabelCount AS LabelCount
FROM
	Catalog.AdditionalAttributesAndInfoSets AS SetsOverridable
WHERE
	CASE
		WHEN SetsOverridable.Parent = VALUE(Catalog.AdditionalAttributesAndInfoSets.EmptyRef)
			THEN SetsOverridable.Ref IN (&amp;Sets)
		ELSE SetsOverridable.Parent IN (&amp;Sets)
	END
	AND SetsOverridable.Used
	AND ISNULL(SetsOverridable.Parent.Used, TRUE)
	AND NOT SetsOverridable.DeletionMark</queryText>
      <mainTable>Catalog.AdditionalAttributesAndInfoSets</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
