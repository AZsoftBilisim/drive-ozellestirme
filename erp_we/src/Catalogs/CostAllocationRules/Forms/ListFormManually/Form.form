  <attributes>
    <name>ValuesToFillIn</name>
    <title>
      <key>en</key>
      <value>Values to fill</value>
    </title>
    <title>
      <key>fa</key>
      <value>مقادیر برای پرکردن</value>
    </title>
    <title>
      <key>it</key>
      <value>Valori da compilare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wartości do uzupełnienia</value>
    </title>
    <title>
      <key>ru</key>
      <value>Значения к заполнению</value>
    </title>
    <title>
      <key>tr</key>
      <value>Doldurulacak değerler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Giá trị cần điền</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ValuesToFillIn.Factor</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED DISTINCT
	ISNULL(ValuesOnChange.Period, &amp;BegOfMonth) AS Period,
	Departments.Ref AS Department,
	ISNULL(ValuesMonthly.Factor, ISNULL(ValuesOnChange.Factor, VALUE(Catalog.CostAllocationRules.EmptyRef))) AS Rule,
	ISNULL(ValuesMonthly.IndicatorValue, ISNULL(ValuesOnChange.IndicatorValue, 0)) AS Factor,
	CASE
		WHEN ISNULL(ValuesMonthly.IndicatorValue, ISNULL(ValuesOnChange.IndicatorValue, 0)) = 0
			THEN FALSE
		ELSE TRUE
	END AS NotEmptyValue,
	CAST(CASE
			WHEN ISNULL(MonthlyValuesForPastPeriods.IndicatorValue, 0) = 0
				THEN FALSE
			ELSE TRUE
		END AS BOOLEAN) AS ItWasIntroducedInTheLastPeriod,
	ISNULL(MonthlyValuesForPastPeriods.IndicatorValue, 0) AS TheValueOfThePreviousPeriod
FROM
	Catalog.BusinessStructure AS Departments
		LEFT JOIN InformationRegister.IndicatorValuesToAllocateCosts AS ValuesMonthly
		ON (ValuesMonthly.Department = Departments.Ref)
			AND (ValuesMonthly.Factor.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VariableEnteredManuallyOnMonthlyBasis))
			AND (BEGINOFPERIOD(ValuesMonthly.Period, MONTH) = &amp;BegOfMonth)
			AND (ValuesMonthly.Factor = &amp;Factor)
		LEFT JOIN InformationRegister.IndicatorValuesToAllocateCosts AS MonthlyValuesForPastPeriods
		ON (MonthlyValuesForPastPeriods.Department = Departments.Ref)
			AND (MonthlyValuesForPastPeriods.Factor.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VariableEnteredManuallyOnMonthlyBasis))
			AND (MonthlyValuesForPastPeriods.Factor = &amp;Factor)
			AND (BEGINOFPERIOD(MonthlyValuesForPastPeriods.Period, MONTH) = DATEADD(&amp;BegOfMonth, MONTH, -1))
		LEFT JOIN InformationRegister.IndicatorValuesToAllocateCosts.SliceLast(&amp;BegOfMonth, ) AS ValuesOnChange
		ON (ValuesOnChange.Department = Departments.Ref)
			AND (ValuesOnChange.Factor.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ConstantEnteredManuallyOnDemand))
			AND (ValuesOnChange.Factor = &amp;Factor)
WHERE
	Departments.ProductionBusinessUnit
	AND &amp;Factor &lt;> VALUE(Catalog.CostAllocationRules.EmptyRef)
	AND Departments.Status = VALUE(Enum.BusinessUnitCompanyStatuses.Valid)</queryText>
