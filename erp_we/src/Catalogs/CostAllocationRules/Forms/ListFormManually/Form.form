    <functionalOptions>FunctionalOption.UseAccountingByExpenseObjects</functionalOptions>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT ALLOWED
	ISNULL(ValuesOnChange.Period, &amp;BegOfMonth) AS Period,
	CAST(CostCenters.Ref AS Catalog.CostCenters) AS ConstCenter,
	ISNULL(ValuesMonthly.Factor, ISNULL(ValuesOnChange.Factor,
		VALUE(Catalog.CostAllocationRules.EmptyRef))) AS Rule,
	ISNULL(ValuesMonthly.IndicatorValue, ISNULL(ValuesOnChange.IndicatorValue, 0)) AS Factor,
	CASE
		WHEN ISNULL(ValuesMonthly.IndicatorValue, ISNULL(ValuesOnChange.IndicatorValue, 0)) = 0
			THEN FALSE
		ELSE TRUE
	END AS NotEmptyValue,
	CAST(CASE
		WHEN ISNULL(MonthlyValuesForPastPeriods.IndicatorValue, 0) = 0
			THEN FALSE
		ELSE TRUE
	END AS BOOLEAN) AS ItWasIntroducedInTheLastPeriod,
	ISNULL(MonthlyValuesForPastPeriods.IndicatorValue, 0) AS TheValueOfThePreviousPeriod
FROM
	Catalog.CostCenters AS CostCenters
		LEFT JOIN InformationRegister.IndicatorValuesForAllocatingExpensesBetweenExpenseObjects AS ValuesMonthly
		ON ValuesMonthly.ConstCenter = CostCenters.Ref
		AND
			ValuesMonthly.Factor.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VariableEnteredManuallyOnMonthlyBasis)
		AND BEGINOFPERIOD(ValuesMonthly.Period, MONTH) = &amp;BegOfMonth
		AND ValuesMonthly.Factor = &amp;Factor
		LEFT JOIN InformationRegister.IndicatorValuesForAllocatingExpensesBetweenExpenseObjects AS
			MonthlyValuesForPastPeriods
		ON MonthlyValuesForPastPeriods.ConstCenter = CostCenters.Ref
		AND
			MonthlyValuesForPastPeriods.Factor.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VariableEnteredManuallyOnMonthlyBasis)
		AND MonthlyValuesForPastPeriods.Factor = &amp;Factor
		AND BEGINOFPERIOD(MonthlyValuesForPastPeriods.Period, MONTH) = DATEADD(&amp;BegOfMonth, MONTH, -1)
		LEFT JOIN InformationRegister.IndicatorValuesForAllocatingExpensesBetweenExpenseObjects.SliceLast(&amp;BegOfMonth) AS
			ValuesOnChange
		ON ValuesOnChange.ConstCenter = CostCenters.Ref
		AND
			ValuesOnChange.Factor.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ConstantEnteredManuallyOnDemand)
		AND ValuesOnChange.Factor = &amp;Factor
WHERE
	NOT CostCenters.NotUsed
	AND &amp;Factor &lt;> VALUE(Catalog.CostAllocationRules.EmptyRef)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
