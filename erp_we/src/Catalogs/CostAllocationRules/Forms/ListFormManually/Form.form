    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	Indicators.Ref,
	Indicators.Description,
	Indicators.AssignRule,
	Indicators.AllocationBase AS IndicatorValue,
	Indicators.Predefined,
	Indicators.PredefinedDataName,
	CASE
		WHEN Indicators.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VariableEnteredManuallyOnMonthlyBasis)
			THEN 1
		ELSE CASE
			WHEN
				Indicators.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.AutofillOnMonthlyBasis)
				THEN 2
			ELSE 0
		END
	END AS IndicatorType
FROM
	Catalog.CostAllocationRules AS Indicators
WHERE
	NOT Indicators.DeletionMark
	AND Indicators.AllocationBase IN (VALUE(Enum.TypesOfCostAllocatingBase.ConstantEnteredManuallyOnDemand),
		VALUE(Enum.TypesOfCostAllocatingBase.VariableEnteredManuallyOnMonthlyBasis))</queryText>
