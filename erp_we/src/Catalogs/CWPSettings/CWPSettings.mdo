        <value>Automatyczne gromadzenie</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Автоматическая инкассация</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Otomatik nakit yatırma/çekme</value>
      </synonym>
      <synonym>
