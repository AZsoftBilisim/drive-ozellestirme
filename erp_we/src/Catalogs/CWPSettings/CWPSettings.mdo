    <attributes uuid="1e5832a6-c3d8-42d5-93af-d6aaaad69a3f">
      <name>AutomaticCashCollection</name>
      <synonym>
        <key>en</key>
        <value>Automatic cash deposit/withdrawal</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>واریز/برداشت خودکار وجه نقد</value>
      </synonym>
      <synonym>
        <key>it</key>
