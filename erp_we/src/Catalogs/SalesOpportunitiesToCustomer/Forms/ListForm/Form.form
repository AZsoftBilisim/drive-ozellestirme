    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogSalesOpportunitiesToCustomer.Ref,
	CatalogSalesOpportunitiesToCustomer.DeletionMark,
	CatalogSalesOpportunitiesToCustomer.Predefined,
	CatalogSalesOpportunitiesToCustomer.Code,
	CatalogSalesOpportunitiesToCustomer.Description,
	CatalogSalesOpportunitiesToCustomer.ProbabilityOfSuccessfulCompletion,
	CatalogSalesOpportunitiesToCustomer.SalesOpportunityKind,
	CatalogSalesOpportunitiesToCustomer.StartDate,
	CatalogSalesOpportunitiesToCustomer.EndDate,
	CatalogSalesOpportunitiesToCustomer.Closed_,
	CatalogSalesOpportunitiesToCustomer.EmployeeResponsible,
	CatalogSalesOpportunitiesToCustomer.Partner AS Client,
	CatalogSalesOpportunitiesToCustomer.CustomerTermsOfSales,
	CatalogSalesOpportunitiesToCustomer.PotentialSaleAmount,
	CatalogSalesOpportunitiesToCustomer.Comment,
	CatalogSalesOpportunitiesToCustomer.ReasonForLosingSalesOpportunity,
	CatalogSalesOpportunitiesToCustomer.Status,
	CatalogSalesOpportunitiesToCustomer.ManualControlEnabled,
	CatalogSalesOpportunitiesToCustomer.Presentation,
	CatalogSalesOpportunitiesToCustomer.EnabledGoodsAssignmentInSalesOpportunity,
	SourcesOfInitialRequests.ChannelOfInitialRequest,
	SourcesOfInitialRequests.SourceOfInitialRequest,
	StatisticsOfCustomerOpportunities.ProcessStep AS SaleProcessStage
FROM
	Catalog.SalesOpportunitiesToCustomer AS CatalogSalesOpportunitiesToCustomer
		LEFT JOIN InformationRegister.SourcesOfInitialRequests AS SourcesOfInitialRequests
		ON CatalogSalesOpportunitiesToCustomer.Ref = SourcesOfInitialRequests.SalesOpportunity
		LEFT JOIN (SELECT
			StatisticsOfCustomerOpportunities.SalesOpportunity AS SalesOpportunity,
			MAX(StatisticsOfCustomerOpportunities.ProcessStep.AddlOrderingAttribute) AS StageOfTheProcessOfPropsAndOrdering
		FROM
			InformationRegister.StatisticsOfCustomerOpportunities AS StatisticsOfCustomerOpportunities
		
		GROUP BY
			StatisticsOfCustomerOpportunities.SalesOpportunity) AS TheOrderOfTheStage
			LEFT JOIN InformationRegister.StatisticsOfCustomerOpportunities AS StatisticsOfCustomerOpportunities
			ON TheOrderOfTheStage.SalesOpportunity = StatisticsOfCustomerOpportunities.SalesOpportunity
				AND TheOrderOfTheStage.StageOfTheProcessOfPropsAndOrdering = StatisticsOfCustomerOpportunities.ProcessStep.AddlOrderingAttribute
		ON CatalogSalesOpportunitiesToCustomer.Ref = TheOrderOfTheStage.SalesOpportunity</queryText>
      <mainTable>Catalog.SalesOpportunitiesToCustomer</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
