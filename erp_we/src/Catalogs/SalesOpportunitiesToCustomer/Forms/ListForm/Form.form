    <functionalOptions>FunctionalOption.UseSalesOpportunitiesToCustomer</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Client</segments>
    </notDefaultUseAlwaysAttributes>
