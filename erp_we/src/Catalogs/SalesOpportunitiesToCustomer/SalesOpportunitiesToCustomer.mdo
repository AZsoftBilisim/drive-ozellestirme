      <rowType typeId="8953c329-d488-4bc3-93bb-4f64d91ef5cd" valueTypeId="2fef9a72-cb83-41f0-8ae7-26240ce4be04"/>
    </producedTypes>
    <name>AccessValuesSets</name>
    <synonym>
      <key>en</key>
      <value>Access value sets</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>مجموعه‌های مقدار دسترسی</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Set di valori di acceso</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Zestawy wartości dostępu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Наборы значений доступа</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Erişim değeri kümeleri</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Tập hợp giá trị truy cập</value>
    </synonym>
    <standardAttributes>
      <dataHistory>Use</dataHistory>
      <name>LineNumber</name>
      <fillValue xsi:type="core:UndefinedValue"/>
