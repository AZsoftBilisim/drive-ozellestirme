  <attributes uuid="0738ffb9-9667-4a49-8af0-d6c180ca4bbb">
    <name>SetRolesDirectly</name>
    <synonym>
      <key>en</key>
      <value>Set roles explicitly</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تعیین صریح نقش‌ها</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Impostare i ruoli direttamente</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Ustaw role bezpośrednio</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Установить роли непосредственно</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Rolleri doğrudan ayarla</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Thiết lập vai trò trực tiếp</value>
    </synonym>
    <comment>Used if the &quot;access Control&quot; subsystem is not built in&quot;</comment>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Set roles explicitly, without using the roles that are set for external user groups.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>تعیین صریح نقش‌ها، بدون استفاده از نقش‌های تعیین‌شده برای گروه‌های کاربران خارجی.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Impostare i ruoli direttamente, senza utilizzo dei ruoli impostati nei gruppi di utenti esterni</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Ustaw role bezpośrednio bez wykorzystania ról, podanych w grupach zewnętrznych użytkowników</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Установить роли непосредственно без использования ролей, заданных в группах внешних пользователей</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Dış kullanıcı gruplarında ayarlanan rolleri kullanmadan rolleri doğrudan ayarlayın</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Thiết lập vai trò trực tiếp không sử dụng vai trò đã chỉ ra trong nhóm người sử dụng ngoài</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fillValue xsi:type="core:UndefinedValue"/>
