    <toolTip>
      <key>en</key>
      <value>The user has been submitted for authorization.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>کاربر برای احراز مجوز ارسال شده است.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
