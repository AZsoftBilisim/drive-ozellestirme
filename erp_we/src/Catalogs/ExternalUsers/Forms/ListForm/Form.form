  <attributes>
    <name>ExternalUsersList</name>
    <title>
      <key>en</key>
      <value>External user list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست کاربران خارجی</value>
    </title>
    <title>
      <key>it</key>
      <value>Utenti esterni elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zewnętrzni użytkownicy lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Внешние пользователи список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Harici kullanıcı listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Người dùng ngoài danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExternalUsersList.CanChangePassword</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExternalUsersList.Invalid</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExternalUsersList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ExternalUsers.Ref AS Ref,
	ExternalUsers.Prepared AS Prepared,
	ExternalUsers.DeletionMark AS DeletionMark,
	ExternalUsers.Invalid AS Invalid,
	ExternalUsers.Predefined AS Predefined,
	ExternalUsers.Description AS Description,
	ExternalUsers.Comment AS Comment,
	VALUETYPE(ExternalUsers.AuthorizationObject) AS AuthorizationObjectType,
	-1 AS PictureNumber,
	CASE
		WHEN ExternalUsers.Invalid
			THEN FALSE
		WHEN ExternalUsers.IBUserID = &amp;CurrentIBUserID
			THEN TRUE
		WHEN &amp;CanChangeOwnPasswordOnly
			THEN FALSE
		WHEN ExternalUsers.IBUserID = &amp;BlankUUID
			THEN FALSE
		ELSE TRUE
	END AS CanChangePassword,
	ExternalUsers.IBUserID AS IBUserID,
	UsersInfo.*
FROM
	Catalog.ExternalUsers AS ExternalUsers
		{LEFT JOIN InformationRegister.UsersInfo AS UsersInfo
		ON (UsersInfo.User = ExternalUsers.Ref)}
WHERE
	CASE
			WHEN &amp;AllExternalUsers
				THEN TRUE
			WHEN &amp;SelectHierarchy
				THEN TRUE IN
						(SELECT
							TRUE
						FROM
							InformationRegister.UserGroupCompositions AS UserGroupCompositions
						WHERE
							UserGroupCompositions.User = ExternalUsers.Ref
							AND UserGroupCompositions.UsersGroup = &amp;ExternalUsersGroup)
			ELSE TRUE IN
					(SELECT
						TRUE
					FROM
						Catalog.ExternalUsersGroups.Content AS ExternalUsersGroupsContent
					WHERE
						ExternalUsersGroupsContent.ExternalUser = ExternalUsers.Ref
						AND ExternalUsersGroupsContent.Ref = &amp;ExternalUsersGroup)
		END</queryText>
      <mainTable>Catalog.ExternalUsers</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>ExternalUsersGroups</name>
    <title>
