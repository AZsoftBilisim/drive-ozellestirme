    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExternalUsersGroups.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ExternalUsersGroups.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ExternalUsersGroups.Ref,
	ExternalUsersGroups.DeletionMark,
	ExternalUsersGroups.Predefined,
	ExternalUsersGroups.Parent,
	ExternalUsersGroups.Description,
	CASE
		WHEN ExternalUsersGroups.DeletionMark
			THEN 8
		ELSE 9
	END AS PictureNumber,
	ExternalUsersGroups.AllAuthorizationObjects,
	ExternalUsersGroups.Comment
FROM
	Catalog.ExternalUsersGroups AS ExternalUsersGroups</queryText>
      <mainTable>Catalog.ExternalUsersGroups</mainTable>
