  <attributes uuid="2582a714-a6d6-4d37-b9a7-5e89e18b0f27">
    <name>OpenEndedQuestion</name>
    <synonym>
      <key>en</key>
      <value>Open-ended question. Requires detailed answer.</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>پرسش باز. نیاز به پاسخ تفصیلی دارد.</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Richiede una risposta aperta</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wymaga odpowiedzi otwartej</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Требует открытого ответа</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Açık bir yanı gerektirir</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Cần phản hồi mở</value>
    </synonym>
    <type>
      <types>Boolean</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Indicates whether the respondent can comment on this response option</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>نشان می‌دهد که آیا پاسخ‌دهنده می‌تواند درباره این گزینه پاسخ توضیح دهد</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Un segno che il rispondente sarà in grado di commentare questa opzione di risposta</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Cecha tego, że respondent będzie miał możliwość komentować dany wariant odpowiedzi</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Признак того, что респондент будет иметь возможность прокомментировать данный вариант ответа</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Yanıtlayanın bu yanıt seçeneği hakkında yorum yapma imkanına sahip olacağını belirtir</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Dấu hiệu cho thấy, người trả lời sẽ có thể bình luận phương án trả lời này</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
    <fillValue xsi:type="core:BooleanValue"/>
