        <field>Counterparty</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>VATTaxation</dataPath>
        <field>VATTaxation</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
