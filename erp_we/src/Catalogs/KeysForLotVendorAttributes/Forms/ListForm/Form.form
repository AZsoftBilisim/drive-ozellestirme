  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Keys.Ref,
	Keys.DeletionMark,
	Keys.Description,
	Keys.FinancialAccountingGroup,
	Keys.Vendor,
	Keys.Counterparty,
	Keys.VATTaxation,
	Keys.VATRate,
	Keys.AssetTaxClass,
	Keys.RowCode,
	Keys.Predefined,
	Keys.PredefinedDataName,
	(CASE
		WHEN NOT Keys.DeletionMark AND Dimension.DimensionKey IS NULL THEN TRUE
		ELSE FALSE END) AS NoRecordInRegister
FROM
	Catalog.KeysForLotVendorAttributes AS Keys
	LEFT JOIN InformationRegister.LotVendorAttributes AS Dimension
		ON Dimension.DimensionKey = Keys.Ref</queryText>
      <mainTable>Catalog.KeysForLotVendorAttributes</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DeleteVATRate</dataPath>
        <field>DeleteVATRate</field>
