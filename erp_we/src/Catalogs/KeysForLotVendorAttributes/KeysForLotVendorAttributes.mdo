  <attributes uuid="d403b9af-1ae3-4be5-b072-c4adb74e5af7">
    <name>Vendor</name>
    <synonym>
      <key>en</key>
      <value>Vendor</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>تأمین‌کننده</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Fornitore</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Dostawca</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Поставщик</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Tedarikçi</value>
