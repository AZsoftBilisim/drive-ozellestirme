    <toolTip>
      <key>en</key>
      <value>Supply source type that defines a procurement strategy</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>نوع منبع تأمین که راهبرد تدارکات را تعیین می‌کند</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Tipo di software che determina il metodo di approvvigionamento</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Typ zaopatrzenia, na podstawie którego jest ustalany sposób zaspokojenia potrzeb.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Тип обеспечения, определяющий способ обеспечения потребностей</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Tedarik stratejisi belirleyen tedarik tipi</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Kiểu đảm bảo xác định phương thức đảm bảo nhu cầu</value>
    </toolTip>
