  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.UseSpecifiedAgentServices</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogTermsOfPurchaseFromVendors.Ref                AS Ref,
	CatalogTermsOfPurchaseFromVendors.DeletionMark       AS DeletionMark,
	CatalogTermsOfPurchaseFromVendors.Number                 AS Number,
	CatalogTermsOfPurchaseFromVendors.Date                  AS Date,
	CatalogTermsOfPurchaseFromVendors.Description          AS Description,
	CatalogTermsOfPurchaseFromVendors.Counterparty            AS Counterparty,
	CatalogTermsOfPurchaseFromVendors.Partner               AS Partner,
	CatalogTermsOfPurchaseFromVendors.Organization           AS Organization,
	CatalogTermsOfPurchaseFromVendors.Currency                AS Currency,
	CatalogTermsOfPurchaseFromVendors.Comment           AS Comment,
	CatalogTermsOfPurchaseFromVendors.Manager              AS Manager,
	CatalogTermsOfPurchaseFromVendors.Status                AS Status,
	CatalogTermsOfPurchaseFromVendors.ValidityStartDate    AS ValidityStartDate,
	CatalogTermsOfPurchaseFromVendors.ValidityEndDate AS ValidityEndDate,
	CatalogTermsOfPurchaseFromVendors.UseSpecifiedAgentServices AS UseSpecifiedAgentServices,
	CatalogTermsOfPurchaseFromVendors.BusinessOperation AS BusinessOperation,
	CASE
		WHEN
			CatalogTermsOfPurchaseFromVendors.DeletionMark
		THEN
			VALUE(Enum.StatesOfTermsOfPurchases.EmptyRef)
		// closed //////////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Closed)
		THEN
			VALUE(Enum.StatesOfTermsOfPurchases.Closed)
		// IT WORKS ////////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
		THEN
			VALUE(Enum.StatesOfTermsOfPurchases.Valid)
		// APPROVAL IS EXPECTED ///////////////////////////////////////////////////
		WHEN
			CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.NotApproved)
		THEN
			VALUE(Enum.StatesOfTermsOfPurchases.PendingApproval)
	END AS State,
	CASE
		// NOT CARRIED OUT //////////////////////////////////////////////////////////////
		WHEN
			CatalogTermsOfPurchaseFromVendors.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.NotApproved)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt; &amp;UpdateDate)
			OR (CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE 
			FALSE
	END AS ApprovalOverdue,
	CASE
		WHEN
			CatalogTermsOfPurchaseFromVendors.DeletionMark
		THEN
			FALSE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS ValidityPeriodExpired,
	CASE
		WHEN
			CatalogTermsOfPurchaseFromVendors.DeletionMark
		THEN
			FALSE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS TheValidityPeriodHasNotCome,
	CASE
		WHEN
			CatalogTermsOfPurchaseFromVendors.DeletionMark
		THEN
			DATETIME(1,1,1)
		// APPROVAL IS OVERDUE OR EXPIRED//////////////////////////
		WHEN (CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.NotApproved)
			OR CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid))
			AND CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogTermsOfPurchaseFromVendors.ValidityEndDate
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.NotApproved)
			AND CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate > &amp;UpdateDate))
		THEN
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	CASE
		WHEN
			CatalogTermsOfPurchaseFromVendors.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.NotApproved)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt; &amp;UpdateDate)
			OR (CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogTermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			AND ((CatalogTermsOfPurchaseFromVendors.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogTermsOfPurchaseFromVendors.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
		END AS Overdue
FROM
	Catalog.TermsOfPurchaseFromVendors AS CatalogTermsOfPurchaseFromVendors
</queryText>
