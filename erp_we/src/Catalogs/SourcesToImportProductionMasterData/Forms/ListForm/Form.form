    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	SourcesToImportProductionMasterData.Ref,
	SourcesToImportProductionMasterData.DeletionMark,
	SourcesToImportProductionMasterData.Code,
	SourcesToImportProductionMasterData.Description,
	SourcesToImportProductionMasterData.ExchangeFormat,
	ISNULL(MasterDataImportSettings.EndDate, DATETIME(1, 1, 1)) AS ExecutionDate,
	ISNULL(MasterDataImportSettings.State, VALUE(Enum.ImportMasterDataStates.DoNotPerformed)) AS State,
	TRUE AS Used,
	&quot;&quot; AS StatePresentation,
	&quot;&quot; AS StatePresentationOfProblem,
	&quot;&quot; AS SchedulePresentation
FROM
	Catalog.SourcesToImportProductionMasterData AS SourcesToImportProductionMasterData
		LEFT JOIN InformationRegister.MasterDataImportSettings AS MasterDataImportSettings
		ON SourcesToImportProductionMasterData.Ref = MasterDataImportSettings.DataSource</queryText>
      <mainTable>Catalog.SourcesToImportProductionMasterData</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
