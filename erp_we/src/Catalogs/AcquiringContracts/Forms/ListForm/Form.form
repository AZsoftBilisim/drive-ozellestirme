      <segments>List.State</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogAcquiringContracts.Ref,
	CatalogAcquiringContracts.DeletionMark,
	CatalogAcquiringContracts.Code,
	CatalogAcquiringContracts.Description,
	CatalogAcquiringContracts.Number,
	CatalogAcquiringContracts.Date,
	CatalogAcquiringContracts.Status,
	CatalogAcquiringContracts.Approved,
	CatalogAcquiringContracts.Organization,
	CatalogAcquiringContracts.Department,
	CatalogAcquiringContracts.BankAccount,
	CatalogAcquiringContracts.EmployeeResponsible,
	CatalogAcquiringContracts.Partner,
	CatalogAcquiringContracts.Counterparty,
	CatalogAcquiringContracts.CounterpartyBankAccount,
	CatalogAcquiringContracts.ContactPerson,
	CatalogAcquiringContracts.POSTerminalsAreUsed,
	CatalogAcquiringContracts.DetailedTransactionReconciliation,
	CatalogAcquiringContracts.EnableCreatingCashIssueWithoutPaymentRequest,
	CatalogAcquiringContracts.PaymentPeriod,
	CatalogAcquiringContracts.FixedFeeRate,
	CatalogAcquiringContracts.CommissionRate,
	CatalogAcquiringContracts.CommissionPostingMethod,
	CatalogAcquiringContracts.FeeIsChargedOnRefund,
	CatalogAcquiringContracts.CashFlowItemCashReceipt,
	CatalogAcquiringContracts.CashFlowItemReturn,
	CatalogAcquiringContracts.CashFlowItemCommission,
	CatalogAcquiringContracts.LineOfBusiness,
	CatalogAcquiringContracts.ExpenseItem,
	CatalogAcquiringContracts.DimensionOfExpenses,
	CatalogAcquiringContracts.ExpensesBusinessUnit,
	CatalogAcquiringContracts.Comment,
	CatalogAcquiringContracts.AdditionalAttributes,
	CatalogAcquiringContracts.Predefined,
	CatalogAcquiringContracts.PredefinedDataName,
	&amp;DefaultPartner AS DefaultPartner,
	CASE
		WHEN
			CatalogAcquiringContracts.DeletionMark
		THEN
			VALUE(Enum.CounterpartyContractStates.EmptyRef)
		// unopened //////////////////////////////////////////////////////////////////
		WHEN
			CatalogAcquiringContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Closed)
		THEN
			VALUE(Enum.CounterpartyContractStates.Closed)
		// IT WORKS ///////////////////////////////////////////////////////////////
		WHEN
			CatalogAcquiringContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		THEN
			VALUE(Enum.CounterpartyContractStates.Valid)
		// APPROVAL IS EXPECTED //////////////////////////////////////////////////
		WHEN
			CatalogAcquiringContracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
		THEN
			VALUE(Enum.CounterpartyContractStates.PendingApproval)
	END AS State
FROM
	Catalog.AcquiringContracts AS CatalogAcquiringContracts</queryText>
      <mainTable>Catalog.AcquiringContracts</mainTable>
