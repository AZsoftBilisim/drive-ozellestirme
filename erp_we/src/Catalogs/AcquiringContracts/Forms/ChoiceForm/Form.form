    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogAcquiringContractsOverridable.Ref AS Ref,
	CatalogAcquiringContractsOverridable.DeletionMark AS DeletionMark,
	CatalogAcquiringContractsOverridable.Code AS Code,
	CatalogAcquiringContractsOverridable.Description AS Description,
	CatalogAcquiringContractsOverridable.Number AS Number,
	CatalogAcquiringContractsOverridable.Date AS Date,
	CatalogAcquiringContractsOverridable.Status AS Status,
	CatalogAcquiringContractsOverridable.Approved AS Approved,
	CatalogAcquiringContractsOverridable.Organization AS Organization,
	CatalogAcquiringContractsOverridable.Department AS Department,
	CatalogAcquiringContractsOverridable.BankAccount AS BankAccount,
	CatalogAcquiringContractsOverridable.EmployeeResponsible AS EmployeeResponsible,
	CatalogAcquiringContractsOverridable.Partner AS Partner,
	CatalogAcquiringContractsOverridable.Counterparty AS Counterparty,
	CatalogAcquiringContractsOverridable.CounterpartyBankAccount AS CounterpartyBankAccount,
	CatalogAcquiringContractsOverridable.ContactPerson AS ContactPerson,
	CatalogAcquiringContractsOverridable.POSTerminalsAreUsed AS POSTerminalsAreUsed,
	CatalogAcquiringContractsOverridable.DetailedTransactionReconciliation AS DetailedTransactionReconciliation,
	CatalogAcquiringContractsOverridable.EnableCreatingCashIssueWithoutPaymentRequest AS EnableCreatingCashIssueWithoutPaymentRequest,
	CatalogAcquiringContractsOverridable.PaymentPeriod AS PaymentPeriod,
	CatalogAcquiringContractsOverridable.FixedFeeRate AS FixedFeeRate,
	CatalogAcquiringContractsOverridable.CommissionRate AS CommissionRate,
	CatalogAcquiringContractsOverridable.CommissionPostingMethod AS CommissionPostingMethod,
	CatalogAcquiringContractsOverridable.FeeIsChargedOnRefund AS FeeIsChargedOnRefund,
	CatalogAcquiringContractsOverridable.CashFlowItemCashReceipt AS CashFlowItemCashReceipt,
	CatalogAcquiringContractsOverridable.CashFlowItemReturn AS CashFlowItemReturn,
	CatalogAcquiringContractsOverridable.CashFlowItemCommission AS CashFlowItemCommission,
	CatalogAcquiringContractsOverridable.LineOfBusiness AS LineOfBusiness,
	CatalogAcquiringContractsOverridable.ExpenseItem AS ExpenseItem,
	CatalogAcquiringContractsOverridable.DimensionOfExpenses AS DimensionOfExpenses,
	CatalogAcquiringContractsOverridable.ExpensesBusinessUnit AS ExpensesBusinessUnit,
	CatalogAcquiringContractsOverridable.Comment AS Comment,
	CatalogAcquiringContractsOverridable.MakingPaymentMethod AS MakingPaymentMethod,
	FALSE AS ThereIsIntegrationSetting
{SELECT
	ThereIsIntegrationSetting}
FROM
	Catalog.AcquiringContracts AS CatalogAcquiringContractsOverridable
{WHERE
	(FALSE) AS ThereIsIntegrationSetting}</queryText>
      <mainTable>Catalog.AcquiringContracts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
