		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Partner</dataPath>
			<field>Partner</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Partner</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>شریک تجاری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Partner</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Partner</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Партнер</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İş ortağı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Bạn hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ContactPersonsForPartners.Owner AS Partner,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,

	ContactPersonsForPartners.BirthDate AS ContactPersonDateOfBirth
FROM
	Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
WHERE 
	ContactPersonsForPartners.Ref = &amp;ContactPersonsForPartners</query>
	</dataSet>
