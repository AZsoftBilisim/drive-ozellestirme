	CatalogContactPersonsForPartners.RelationRegistrationDate,
	CatalogContactPersonsForPartners.RelationEndDate,
	CatalogContactPersonsForPartners.Author,
	CatalogContactPersonsForPartners.Comment,
	CatalogContactPersonsForPartners.Presentation,
	ContactPersonsOfPartnersRoleOfContactPerson.ContactRole,
	CatalogContactPersonsForPartners.Gender,
	CatalogContactPersonsForPartners.BirthDate
FROM
	Catalog.ContactPersonsForPartners AS CatalogContactPersonsForPartners
	LEFT JOIN Catalog.ContactPersonsForPartners.ContactPersonRoles AS ContactPersonsOfPartnersRoleOfContactPerson
	ON CatalogContactPersonsForPartners.Ref = ContactPersonsOfPartnersRoleOfContactPerson.Ref
		AND ContactPersonsOfPartnersRoleOfContactPerson.LineNumber = 1
</queryText>
