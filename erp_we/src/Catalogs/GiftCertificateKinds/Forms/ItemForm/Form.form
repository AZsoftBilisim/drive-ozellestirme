              <columnsCount>1</columnsCount>
              <choiceList>
                <presentation>
                  <key>en</key>
                  <value>Several times for payment with several receipts</value>
                </presentation>
                <presentation>
                  <key>fa</key>
                  <value>چند بار برای پرداخت با چند رسید</value>
                </presentation>
                <presentation>
                  <key>it</key>
                  <value>Più volte, per pagare da più controlli</value>
                </presentation>
                <presentation>
                  <key>pl</key>
                  <value>Kilka razy, do płatności z kilku paragonów</value>
                </presentation>
                <presentation>
                  <key>ru</key>
                  <value>Несколько раз, для оплаты из нескольких чеков</value>
                </presentation>
                <presentation>
                  <key>tr</key>
                  <value>Birkaç kez, birkaç fişin ödenmesi için</value>
                </presentation>
                <presentation>
                  <key>vi</key>
                  <value>Nhiều lần, để thanh toán nhiều phiếu tính tiền</value>
                </presentation>
                <value xsi:type="core:StringValue">
                  <value>AllowPartialPayment</value>
                </value>
              </choiceList>
              <choiceList>
                <presentation>
                  <key>en</key>
                  <value>Once for one receipt payment only</value>
                </presentation>
                <presentation>
                  <key>fa</key>
                  <value>یک بار فقط برای پرداخت یک رسید</value>
                </presentation>
                <presentation>
                  <key>it</key>
                  <value>Una volta, per il pagamento di un solo assegno</value>
                </presentation>
                <presentation>
                  <key>pl</key>
                  <value>Jednokrotnie, do płatności tylko jednego paragonu</value>
                </presentation>
                <presentation>
                  <key>ru</key>
                  <value>Однократно, для оплаты только одного чека</value>
                </presentation>
                <presentation>
                  <key>tr</key>
                  <value>Bir kez, sadece bir fişin ödenmesi için</value>
                </presentation>
                <presentation>
                  <key>vi</key>
                  <value>Một lần, để thanh toán chỉ một phiếu tính tiền</value>
                </presentation>
                <value xsi:type="core:StringValue">
                  <value>ProhibitPartialPayment</value>
                </value>
