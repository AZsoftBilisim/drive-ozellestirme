    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Operations.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogManufacturingOperations.Ref                   AS Ref,
	CatalogManufacturingOperations.DeletionMark          AS DeletionMark,
	CatalogManufacturingOperations.Owner                 AS Owner,
	CatalogManufacturingOperations.Description             AS Description,
	CatalogManufacturingOperations.OperationNumber            AS OperationNumber,
	CatalogManufacturingOperations.NextOperation   AS NextOperation,
	WorkCenterTypes.Ref                                  AS WorkCenterType,
	CatalogManufacturingOperations.ContainsNestedRoute AS ContainsNestedRoute,
	CatalogManufacturingOperations.Count               AS Count,
	CatalogManufacturingOperations.UnitOfMeasure         AS UnitOfMeasure,
	CASE
		WHEN WorkCenterTypes.ParallelLoad AND WorkCenterTypes.ImportOption = VALUE(Enum.WorkCenterLoadOptions.Synchronous)
			THEN CASE
				WHEN WorkCenterTypes.SetupSettingsAreUsed
					THEN SetupOptions.OperationTime
				ELSE WorkCenterTypes.OperationTime
			END
		ELSE CatalogManufacturingOperations.TimePerPiece
	END                                                      AS TimePerPiece,
	CASE
		WHEN WorkCenterTypes.ParallelLoad AND WorkCenterTypes.ImportOption = VALUE(Enum.WorkCenterLoadOptions.Synchronous)
			THEN CASE
				WHEN WorkCenterTypes.SetupSettingsAreUsed
					THEN SetupOptions.UnitOfMeasure
				ELSE WorkCenterTypes.UnitOfMeasure
			END
		ELSE CatalogManufacturingOperations.TimePerPieceUnitOfMeasure
	END                                                      AS TimePerPieceUnitOfMeasure,
	CatalogManufacturingOperations.SetupTime                  AS SetupTime,
	CatalogManufacturingOperations.SetupTimeUnitOfMeasure             AS SetupTimeUnitOfMeasure,
	
	CASE
		WHEN CatalogManufacturingOperations.Ref IN
				(SELECT
					TableAttachedFiles.FileOwner AS FileOwner
				FROM
					Catalog.ManufacturingOperationsAttachedFiles AS TableAttachedFiles
				WHERE
					NOT TableAttachedFiles.DeletionMark)
			THEN TRUE
		ELSE FALSE
	END AS IsAttachedFiles,
	
	CatalogManufacturingOperations.SetupSettings       AS SetupSettings,
	CatalogManufacturingOperations.Load             AS Load,
	WorkCenterTypes.UnitOfMeasureOfLoad            AS UnitOfMeasureOfLoad,
	WorkCenterTypes.ParallelLoad                AS ParallelLoad,
	CatalogManufacturingOperations.TransferLot   AS TransferLot
FROM
	Catalog.ManufacturingOperations AS CatalogManufacturingOperations

	LEFT JOIN Catalog.WorkCenterTypes AS WorkCenterTypes
	ON CASE
		WHEN CatalogManufacturingOperations.WorkCenter REFS Catalog.WorkCenterTypes
			THEN CAST(CatalogManufacturingOperations.WorkCenter AS Catalog.WorkCenterTypes) = WorkCenterTypes.Ref
		ELSE CAST(CatalogManufacturingOperations.WorkCenter AS Catalog.WorkCenters).WorkCenterType = WorkCenterTypes.Ref
	END
	
	LEFT JOIN Catalog.SetupOptions AS SetupOptions
	ON CatalogManufacturingOperations.SetupSettings = SetupOptions.Ref

</queryText>
      <mainTable>Catalog.ManufacturingOperations</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
