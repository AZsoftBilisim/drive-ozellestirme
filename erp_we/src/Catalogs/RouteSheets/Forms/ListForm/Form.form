      <queryText>SELECT

	CatalogRouteSheetsOverridable.Ref         AS Ref,
	CatalogRouteSheetsOverridable.Status         AS Status,

	CatalogRouteSheetsOverridable.Code            AS Code,
	CatalogRouteSheetsOverridable.Description   AS Description,

	CatalogRouteSheetsOverridable.ValidOnDate AS ValidOnDate,
	CatalogRouteSheetsOverridable.ValidToDate  AS ValidToDate,

	CatalogRouteSheetsOverridable.Department  AS Department,
	CatalogRouteSheetsOverridable.EmployeeResponsible  AS EmployeeResponsible,

	CatalogRouteSheetsOverridable.LongDesc       AS LongDesc
FROM
	Catalog.RouteSheets AS CatalogRouteSheetsOverridable
</queryText>
