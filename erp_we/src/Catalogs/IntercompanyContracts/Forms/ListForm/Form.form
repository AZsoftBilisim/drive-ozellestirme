        <field>ContractsWithCustomers</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>NameForPrinting</dataPath>
        <field>NameForPrinting</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>BankAccount</dataPath>
        <field>BankAccount</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>AdditionalAttributes</dataPath>
        <field>AdditionalAttributes</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>StateContactID</dataPath>
        <field>StateContactID</field>
