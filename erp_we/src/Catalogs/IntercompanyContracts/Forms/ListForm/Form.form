  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.PaymentsAsPer275FZ</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Contracts.Ref,
	Contracts.DataVersion,
	Contracts.DeletionMark,
	Contracts.Predefined,
	Contracts.Description,
	Contracts.Number,
	Contracts.Date,
	Contracts.Organization,
	Contracts.CompanyRecipient,
	Contracts.ContractType,
	Contracts.ARAPCurrency,
	Contracts.ForeignCurrencyTransaction,
	Contracts.Status,
	Contracts.ValidityStartDate,
	Contracts.ValidityEndDate,
	Contracts.Manager,
	Contracts.Comment,
	Contracts.BankAccount,
	Contracts.BankAccountOfBeneficiary,
	Contracts.PaymentsAsPer275FZ,
	CASE
		WHEN Contracts.DeletionMark
			THEN VALUE(Enum.CounterpartyContractStates.EmptyRef)
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Closed)
			THEN VALUE(Enum.CounterpartyContractStates.Closed)
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			THEN VALUE(Enum.CounterpartyContractStates.Valid)
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
			THEN VALUE(Enum.CounterpartyContractStates.PendingApproval)
	END AS State,
	CASE
		WHEN Contracts.DeletionMark
			THEN FALSE
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
				AND (Contracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
						AND Contracts.ValidityStartDate &lt; &amp;UpdateDate
					OR Contracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
						AND Contracts.ValidityEndDate &lt; &amp;UpdateDate)
			THEN TRUE
		ELSE FALSE
	END AS ApprovalOverdue,
	CASE
		WHEN Contracts.DeletionMark
			THEN FALSE
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
				AND (Contracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
					AND Contracts.ValidityEndDate &lt; &amp;UpdateDate)
			THEN TRUE
		ELSE FALSE
	END AS ValidityPeriodExpired,
	CASE
		WHEN Contracts.DeletionMark
			THEN FALSE
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
				AND (Contracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
					AND Contracts.ValidityStartDate > &amp;UpdateDate)
			THEN TRUE
		ELSE FALSE
	END AS TheValidityPeriodHasNotCome,
	CASE
		WHEN Contracts.DeletionMark
			THEN DATETIME(1, 1, 1)
		WHEN (Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
				OR Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid))
				AND Contracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
			THEN Contracts.ValidityEndDate
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
				AND Contracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
			THEN Contracts.ValidityStartDate
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
				AND (Contracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
					AND Contracts.ValidityStartDate > &amp;UpdateDate)
			THEN Contracts.ValidityStartDate
		ELSE DATETIME(1, 1, 1)
	END AS EventDate,
	CASE
		WHEN Contracts.DeletionMark
			THEN FALSE
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
				AND (Contracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
						AND Contracts.ValidityStartDate &lt; &amp;UpdateDate
					OR Contracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
						AND Contracts.ValidityEndDate &lt; &amp;UpdateDate)
			THEN TRUE
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
				AND (Contracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
					AND Contracts.ValidityEndDate &lt; &amp;UpdateDate)
			THEN TRUE
		WHEN Contracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
				AND (Contracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
					AND Contracts.ValidityStartDate > &amp;UpdateDate)
			THEN TRUE
		ELSE FALSE
	END AS Overdue
FROM
	Catalog.IntercompanyContracts AS Contracts</queryText>
      <mainTable>Catalog.IntercompanyContracts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>LineOfBusiness</dataPath>
        <field>LineOfBusiness</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Number</dataPath>
        <field>Number</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
