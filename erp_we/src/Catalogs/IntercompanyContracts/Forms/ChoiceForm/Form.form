    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Contracts.Ref,
	Contracts.DataVersion,
	Contracts.DeletionMark,
	Contracts.Predefined,
	Contracts.Description,
	Contracts.Number,
	Contracts.Date,
	Contracts.NameForPrinting,
	Contracts.CompanyRecipient,
	Contracts.Organization,
	Contracts.ARAPObjectSettings,
	Contracts.ContractType,
	Contracts.ARAPCurrency,
	Contracts.ForeignCurrencyTransaction,
	Contracts.BankAccount,
	Contracts.BankAccountOfBeneficiary,
	Contracts.Status,
	Contracts.Approved,
	Contracts.ValidityStartDate,
	Contracts.ValidityEndDate,
	Contracts.Manager,
	Contracts.Comment,
	Contracts.ContractWithSDOParticipant,
	Contracts.PaymentsAsPer275FZ,
	Contracts.StateContract,
	CASE
		WHEN Contracts.ContractType = VALUE(Enum.TypesOfIntercompanyContracts.PurchaseAndSale)
			THEN TRUE
		ELSE FALSE
	END AS SuitableForSelectionInTheCustomerSContract
FROM
	Catalog.IntercompanyContracts AS Contracts</queryText>
      <mainTable>Catalog.IntercompanyContracts</mainTable>
