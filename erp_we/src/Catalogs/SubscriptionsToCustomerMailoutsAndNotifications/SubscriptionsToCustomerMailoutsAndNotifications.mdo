  </attributes>
  <attributes uuid="c5ab5a8e-437c-4650-9a98-c2f772579fef">
    <name>PartnerContactDetailsKindForSMSMessage</name>
    <synonym>
      <key>en</key>
      <value>Customer's CI kind for SMS message</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>نوع اطلاعات تماس مشتری برای پیامک</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Tipo informazioni di contatto del cliente per SMS</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Rodzaj danych kontaktowych klienta do SMS</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Вид КИ клиента для SMS</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>SMS için müşteri iletişim bilgileri türü</value>
    </synonym>
