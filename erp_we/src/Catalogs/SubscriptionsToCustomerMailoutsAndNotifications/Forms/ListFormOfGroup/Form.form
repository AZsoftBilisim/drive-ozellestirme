    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	SubscriptionsToCustomerMailoutsAndNotifications.Ref AS Ref,
	SubscriptionsToCustomerMailoutsAndNotifications.Owner AS Partner,
	SubscriptionsToCustomerMailoutsAndNotifications.SendToCustomer AS SendToCustomer,
	SubscriptionsToCustomerMailoutsAndNotifications.SendToAContactPersonOfANotificationObject AS SendToAContactPersonOfANotificationObject,
	SubscriptionsToCustomerMailoutsAndNotifications.NumberOfAddresseesContactPersons AS NumberOfAddresseesContactPersons,
	SubscriptionsToCustomerMailoutsAndNotifications.SubscriptionIsValid AS SubscriptionIsValid
FROM
	Catalog.SubscriptionsToCustomerMailoutsAndNotifications AS SubscriptionsToCustomerMailoutsAndNotifications
WHERE
	NOT SubscriptionsToCustomerMailoutsAndNotifications.DeletionMark
	AND SubscriptionsToCustomerMailoutsAndNotifications.GroupOfMailoutsAndNotifications = &amp;GroupOfMailoutsAndNotifications</queryText>
      <mainTable>Catalog.SubscriptionsToCustomerMailoutsAndNotifications</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
