    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogConstructionObjects.Ref AS Ref,
	CatalogConstructionObjects.DeletionMark AS DeletionMark,
	CatalogConstructionObjects.Parent AS Parent,
	CatalogConstructionObjects.IsFolder AS IsFolder,
	CatalogConstructionObjects.Code AS Code,
	CatalogConstructionObjects.Description AS Description,
	CatalogConstructionObjects.Address AS Address,
	CatalogConstructionObjects.ConstructionMethod AS ConstructionMethod,
	CatalogConstructionObjects.ConstructionStatus AS ConstructionStatus,
	CatalogConstructionObjects.LongDesc AS LongDesc,
	CatalogConstructionObjects.Predefined AS Predefined,
	CatalogConstructionObjects.PredefinedDataName AS PredefinedDataName,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Catalog.ConstructionObjects AS CatalogConstructionObjects
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON CatalogConstructionObjects.Ref = FilesExist.ObjectWithFiles</queryText>
      <mainTable>Catalog.ConstructionObjects</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
