		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Balance.ItemsLocationAttributes AS ItemsLocationAttributes,
	ISNULL(Balance.ItemsLocationAttributes.Purpose.LineOfBusiness,
			VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	Balance.AccountingSection AS AccountingSection,
	Balance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Balance.InventoryOwnerAttribute.InventoryType AS InventoryType,
	Balance.Organization AS Organization,
	Balance.Lot AS Lot,
	Balance.LotVendorAttributes AS LotVendorAttributes,
	Balance.FinancialAccountingDimension AS FinancialAccountingDimension,
	Balance.VATActivityType AS VATActivityType,
	Balance.CountBalance AS CountBalance,
	0 AS CostLocal,
	0 AS ManagementCost,
	0 AS ProvisionForImpairmentLocalBalance,
	0 AS ProvisionForImpairmentManBalance
{SELECT
	ItemsLocationAttributes,
	LineOfBusiness,
	AccountingSection,
	InventoryOwnerAttribute,
	InventoryType,
	Organization,
	Lot,
	LotVendorAttributes,
	FinancialAccountingDimension,
	VATActivityType,
	CountBalance,
	CostLocal,
	ManagementCost,
	ProvisionForImpairmentLocalBalance,
	ProvisionForImpairmentManBalance}
{WHERE
	Balance.ItemsLocationAttributes.Products.* AS Products,
	Balance.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	Balance.ItemsLocationAttributes.Series.* AS Series,
	Balance.ItemsLocationAttributes.StorageLocation.* AS StorageLocation,
	Balance.ItemsLocationAttributes.Purpose.* AS Purpose,
	ISNULL(Balance.ItemsLocationAttributes.Purpose.LineOfBusiness,
			VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	Balance.AccountingSection.*,
	Balance.InventoryOwnerAttribute.*,
	Balance.Lot.*,
	Balance.VATActivityType.*}
INTO Balance
FROM
	AccumulationRegister.InventoryCost.Balance(&amp;Period,
	AccountingSection
		IN (VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock),
			VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent),
			VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts),
			VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToToller),
			VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsTransferredToPartners),
			VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit))
	AND Organization = &amp;Organization
	AND NOT InventoryOwnerAttribute = VALUE(Catalog.InventoryKinds.EmptyRef) 
	AND ((ItemsLocationAttributes.Products,
		ItemsLocationAttributes.Characteristic) IN
		(SELECT
			FilterTable.Products AS Products,
			FilterTable.Characteristic AS Characteristic
		FROM
			SelectionByProductSegment AS FilterTable
		WHERE
			FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
			OR NOT &amp;FilterByProductSegmentIsUsed)
		{(Organization)}) AS Balance
WHERE
	&amp;BatchAccountingVersion22
	AND &amp;ReportPeriod &gt;= &amp;DateOfMigrationToBatchAccounting22
INDEX BY ItemsLocationAttributes
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Keys.DimensionKey AS Ref,
	Keys.Products AS Products,
	Keys.Characteristic AS Characteristic,
	Keys.Series AS Series,
	Keys.StorageLocation AS StorageLocation,
	Keys.Purpose AS Purpose,
	CatProducts.UnitOfMeasure AS StorageUnit,
	CASE
		WHEN CatProducts.WeightUse AND CatProducts.YouCanSpecifyWeightInDocuments
				AND CatProducts.WeightUnitOfMeasure &lt;&gt; CatProducts.UnitOfMeasure 
				AND ISNULL(CatProducts.WeightNumerator, 0) &lt;&gt; 0
				AND ISNULL(CatProducts.WeightDenominator, 0) &lt;&gt; 0
			THEN CAST(CatProducts.WeightNumerator / CatProducts.WeightDenominator AS NUMBER(17, 7))
		ELSE 1
	END AS WeightToUnitRatio
INTO Keys
FROM
	Balance AS Balance
		INNER JOIN InformationRegister.ItemsLocationAttributes AS Keys
		ON (Keys.DimensionKey = Balance.ItemsLocationAttributes)
		INNER JOIN Catalog.Products AS CatProducts
		ON (Keys.Products = CatProducts.Ref)
			AND (CatProducts.ProductKind.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage)))

INDEX BY Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;Rule AS Rule,
	&amp;PriceKind AS PriceKind,
	&amp;LocalAccounting AS LocalAccounting,
	&amp;ReportPeriod AS Period,
	Balance.ItemsLocationAttributes AS ItemsLocationAttributes,
	Keys.StorageLocation AS Warehouse,
	Balance.AccountingSection AS AccountingSection,
	Balance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Balance.InventoryType AS InventoryType,
	Balance.Organization AS Organization,
	Balance.Lot AS Lot,
	Balance.LotVendorAttributes AS LotVendorAttributes,
	Balance.FinancialAccountingDimension AS FinancialAccountingDimension,
	Balance.VATActivityType AS VATActivityType,
	DimensionPartner_.DimensionKey AS AccountingDimensionByPartners,
	VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision) AS BusinessOperation,
	VALUE(Catalog.BusinessTransactionsSettings.AccrualOfInventoriesImpairmentProvision) AS BusinessTransactionSetting,
	TRUE AS CalculationOfCost,
	Balance.CountBalance AS CountBalance,
	Balance.CostLocal AS CostLocal,
	Balance.ManagementCost AS ManagementCost,
	0 AS NetSaleValueOfLocal,
	0 AS NetSellingValueOfMan,
	0 AS ProvisionForImpairmentLocal,
	0 AS ProvisionForImpairmentMan,
	0 AS ProvisionForImpairmentOfLocalRevenue,
	0 AS ProvisionForImpairmentOfManRevenue,
	FALSE AS PriceIsIndicated
{SELECT
	Rule,
	PriceKind,
	LocalAccounting,
	Period,
	ItemsLocationAttributes,
	Warehouse,
	AccountingSection,
	InventoryOwnerAttribute,
	InventoryType,
	Organization,
	Lot,
	LotVendorAttributes,
	FinancialAccountingDimension,
	VATActivityType,
	AccountingDimensionByPartners,
	BusinessOperation,
	CalculationOfCost,
	CountBalance,
	CostLocal,
	ManagementCost,
	NetSaleValueOfLocal,
	NetSellingValueOfMan,
	ProvisionForImpairmentLocal,
	ProvisionForImpairmentMan,
	ProvisionForImpairmentOfLocalRevenue,
	ProvisionForImpairmentOfManRevenue,
	PriceIsIndicated}
INTO CalculationOfReserves
FROM
	Balance AS Balance
		INNER JOIN Keys
		ON Balance.ItemsLocationAttributes = Keys.Ref
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionPartner_
		ON (DimensionPartner_.Partner = VALUE(Catalog.Partners.EmptyRef))
		AND (DimensionPartner_.Organization = Balance.Organization)
		AND (DimensionPartner_.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
		AND (DimensionPartner_.Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
		AND (DimensionPartner_.LineOfBusiness = Balance.LineOfBusiness)
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;Period, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRateManAccounting
		ON (CurrencyExchangeRateManAccounting.Currency = &amp;CurrencyOfManAccounting)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CalculationOfReserves.Period AS Period,
	CalculationOfReserves.Rule AS Rule,
	CalculationOfReserves.PriceKind AS PriceKind,
	CAST(CalculationOfReserves.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority AS Priority,
	TRUE AS LocalAccounting,
	CalculationOfReserves.ItemsLocationAttributes AS ItemsLocationAttributes,
	CalculationOfReserves.Warehouse AS Warehouse,
	CalculationOfReserves.AccountingSection AS AccountingSection,
	CalculationOfReserves.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CalculationOfReserves.InventoryType AS InventoryType,
	CalculationOfReserves.Organization AS Organization,
	CalculationOfReserves.Lot AS Lot,
	CalculationOfReserves.LotVendorAttributes AS LotVendorAttributes,
	CalculationOfReserves.FinancialAccountingDimension AS FinancialAccountingDimension,
	CalculationOfReserves.VATActivityType AS VATActivityType,
	CalculationOfReserves.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CalculationOfReserves.BusinessOperation AS BusinessOperation,
	CalculationOfReserves.BusinessTransactionSetting AS BusinessTransactionSetting,
	CalculationOfReserves.CalculationOfCost AS CalculationOfCost,
	0 AS CountBalance,
	0 AS CostLocal,
	0 AS ManagementCost,
	0 AS NetSaleValueOfLocal,
	0 AS NetSellingValueOfMan,
	CASE
		WHEN CalculationOfReserves.ProvisionForImpairmentLocal &lt;= 0
			THEN CalculationOfReserves.ProvisionForImpairmentLocal
		ELSE -CalculationOfReserves.ProvisionForImpairmentLocal
	END AS ProvisionForImpairmentLocal,
	0 AS ProvisionForImpairmentMan,
	CalculationOfReserves.ProvisionForImpairmentOfLocalRevenue AS ProvisionForImpairmentOfLocalRevenue,
	0 AS ProvisionForImpairmentOfManRevenue,
	CalculationOfReserves.PriceIsIndicated AS PriceIsIndicated,
	CASE
		WHEN CalculationOfReserves.ProvisionForImpairmentLocal &lt;= 0
			THEN VALUE(AccumulationRecordType.Receipt)
		ELSE VALUE(AccumulationRecordType.Expense)
	END AS RecordType
{WHERE
	CalculationOfReserves.Period,
	CalculationOfReserves.Rule.*,
	CalculationOfReserves.ItemsLocationAttributes.*,
	CalculationOfReserves.AccountingSection.*,
	CalculationOfReserves.InventoryOwnerAttribute.*,
	CalculationOfReserves.InventoryType.*,
	CalculationOfReserves.Organization.*,
	CalculationOfReserves.Lot.*,
	CalculationOfReserves.LotVendorAttributes.*,
	CalculationOfReserves.FinancialAccountingDimension.*,
	CalculationOfReserves.VATActivityType.*,
	CalculationOfReserves.AccountingDimensionByPartners.*,
	CalculationOfReserves.BusinessOperation.*}
{SELECT
	Period,
	Rule.*,
	PriceKind.*,
	Priority,
	LocalAccounting,
	ItemsLocationAttributes.*,
	Warehouse.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	InventoryType.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	AccountingDimensionByPartners.*,
	BusinessOperation.*,
	CountBalance,
	CostLocal,
	ManagementCost,
	NetSaleValueOfLocal,
	NetSellingValueOfMan,
	BusinessTransactionSetting,
	CalculationOfCost,
	ProvisionForImpairmentLocal,
	ProvisionForImpairmentMan,
	ProvisionForImpairmentOfLocalRevenue,
	ProvisionForImpairmentOfManRevenue,
	PriceIsIndicated,
	RecordType}
FROM
	CalculationOfReserves AS CalculationOfReserves
WHERE
	&amp;LocalAccounting
	AND CalculationOfReserves.CountBalance &gt; 0

UNION ALL

SELECT
	CalculationOfReserves.Period AS Period,
	CalculationOfReserves.Rule AS Rule,
	CalculationOfReserves.PriceKind AS PriceKind,
	CAST(CalculationOfReserves.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority AS Priority,
	FALSE AS LocalAccounting,
	CalculationOfReserves.ItemsLocationAttributes AS ItemsLocationAttributes,
	CalculationOfReserves.Warehouse AS Warehouse,
	CalculationOfReserves.AccountingSection AS AccountingSection,
	CalculationOfReserves.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CalculationOfReserves.InventoryType AS InventoryType,
	CalculationOfReserves.Organization AS Organization,
	CalculationOfReserves.Lot AS Lot,
	CalculationOfReserves.LotVendorAttributes AS LotVendorAttributes,
	CalculationOfReserves.FinancialAccountingDimension AS FinancialAccountingDimension,
	CalculationOfReserves.VATActivityType AS VATActivityType,
	CalculationOfReserves.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CalculationOfReserves.BusinessOperation AS BusinessOperation,
	CalculationOfReserves.BusinessTransactionSetting AS BusinessTransactionSetting,
	CalculationOfReserves.CalculationOfCost AS CalculationOfCost,
	0 AS CountBalance,
	0 AS CostLocal,
	0 AS ManagementCost,
	0 AS NetSaleValueOfLocal,
	0 AS NetSellingValueOfMan,
	0 AS ProvisionForImpairmentLocal,
	CASE
		WHEN CalculationOfReserves.ProvisionForImpairmentMan &lt;= 0
			THEN CalculationOfReserves.ProvisionForImpairmentMan
		ELSE -CalculationOfReserves.ProvisionForImpairmentMan
	END AS ProvisionForImpairmentMan,
	0 AS ProvisionForImpairmentOfLocalRevenue,
	CalculationOfReserves.ProvisionForImpairmentOfManRevenue AS ProvisionForImpairmentOfManRevenue,
	CalculationOfReserves.PriceIsIndicated AS PriceIsIndicated,
	CASE
		WHEN CalculationOfReserves.ProvisionForImpairmentMan &lt;= 0
			THEN VALUE(AccumulationRecordType.Receipt)
		ELSE VALUE(AccumulationRecordType.Expense)
	END AS RecordType
FROM
	CalculationOfReserves AS CalculationOfReserves
WHERE
	&amp;ManagementAccounting
	AND CalculationOfReserves.CountBalance &gt; 0
{WHERE
	CalculationOfReserves.Period,
	CalculationOfReserves.Rule.*,
	CalculationOfReserves.ItemsLocationAttributes.*,
	CalculationOfReserves.AccountingSection.*,
	CalculationOfReserves.InventoryOwnerAttribute.*,
	CalculationOfReserves.InventoryType.*,
	CalculationOfReserves.Organization.*,
	CalculationOfReserves.Lot.*,
	CalculationOfReserves.LotVendorAttributes.*,
	CalculationOfReserves.FinancialAccountingDimension.*,
	CalculationOfReserves.VATActivityType.*,
	CalculationOfReserves.AccountingDimensionByPartners.*,
	CalculationOfReserves.BusinessOperation.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CalculationOfReserves.Period AS Period,
	CalculationOfReserves.Rule AS Rule,
	CAST(CalculationOfReserves.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority AS Priority,
	CalculationOfReserves.PriceKind AS PriceKind,
	CalculationOfReserves.LocalAccounting AS LocalAccounting,
	CalculationOfReserves.ItemsLocationAttributes AS ItemsLocationAttributes,
	CalculationOfReserves.Warehouse AS Warehouse,
	CalculationOfReserves.AccountingSection AS AccountingSection,
	CalculationOfReserves.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CalculationOfReserves.InventoryType AS InventoryType,
	CalculationOfReserves.Organization AS Organization,
	CalculationOfReserves.Lot AS Lot,
	CalculationOfReserves.LotVendorAttributes AS LotVendorAttributes,
	CalculationOfReserves.FinancialAccountingDimension AS FinancialAccountingDimension,
	CalculationOfReserves.VATActivityType AS VATActivityType,
	CalculationOfReserves.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CalculationOfReserves.BusinessOperation AS BusinessOperation,
	CalculationOfReserves.BusinessTransactionSetting AS BusinessTransactionSetting,
	CalculationOfReserves.CalculationOfCost AS CalculationOfCost,
	CalculationOfReserves.CountBalance AS CountBalance,
	CalculationOfReserves.CostLocal AS CostLocal,
	CalculationOfReserves.ManagementCost AS ManagementCost,
	CalculationOfReserves.NetSaleValueOfLocal AS NetSaleValueOfLocal,
	CalculationOfReserves.NetSellingValueOfMan AS NetSellingValueOfMan,
	CalculationOfReserves.ProvisionForImpairmentLocal AS ProvisionForImpairmentLocal,
	CalculationOfReserves.ProvisionForImpairmentMan AS ProvisionForImpairmentMan,
	CalculationOfReserves.ProvisionForImpairmentOfLocalRevenue AS ProvisionForImpairmentOfLocalRevenue,
	CalculationOfReserves.ProvisionForImpairmentOfManRevenue AS ProvisionForImpairmentOfManRevenue,
	CalculationOfReserves.PriceIsIndicated AS PriceIsIndicated,
	VALUE(AccumulationRecordType.Receipt) AS RecordType
{SELECT
	Period,
	Rule.*,
	PriceKind.*,
	Priority,
	LocalAccounting,
	ItemsLocationAttributes.*,
	Warehouse.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	InventoryType.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	AccountingDimensionByPartners.*,
	BusinessOperation.*,
	CountBalance,
	CostLocal,
	ManagementCost,
	NetSaleValueOfLocal,
	NetSellingValueOfMan,
	BusinessTransactionSetting,
	CalculationOfCost,
	ProvisionForImpairmentLocal,
	ProvisionForImpairmentMan,
	ProvisionForImpairmentOfLocalRevenue,
	ProvisionForImpairmentOfManRevenue,
	PriceIsIndicated,
	RecordType}
FROM
	CalculationOfReserves AS CalculationOfReserves
{WHERE
	CalculationOfReserves.Rule,
	CAST(CalculationOfReserves.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority AS Priority,
	CalculationOfReserves.PriceKind,
	CalculationOfReserves.LocalAccounting,
	CalculationOfReserves.Period,
	CalculationOfReserves.ItemsLocationAttributes.*,
	CalculationOfReserves.AccountingSection.*,
	CalculationOfReserves.InventoryOwnerAttribute.*,
	CalculationOfReserves.InventoryType.*,
	CalculationOfReserves.Organization.*,
	CalculationOfReserves.Lot.*,
	CalculationOfReserves.LotVendorAttributes.*,
	CalculationOfReserves.FinancialAccountingDimension.*,
	CalculationOfReserves.VATActivityType.*,
	CalculationOfReserves.AccountingDimensionByPartners.*,
	CalculationOfReserves.BusinessOperation.*,
	CalculationOfReserves.CalculationOfCost,
	CalculationOfReserves.CountBalance,
	CalculationOfReserves.CostLocal,
	CalculationOfReserves.ManagementCost,
	CalculationOfReserves.NetSaleValueOfLocal,
	CalculationOfReserves.NetSellingValueOfMan,
	CalculationOfReserves.ProvisionForImpairmentLocal,
	CalculationOfReserves.ProvisionForImpairmentMan,
	CalculationOfReserves.ProvisionForImpairmentOfLocalRevenue,
	CalculationOfReserves.ProvisionForImpairmentOfManRevenue}
;

////////////////////////////////////////////////////////////////////////////////
DROP SelectionByProductSegment
;

////////////////////////////////////////////////////////////////////////////////
DROP CalculationOfReserves</query>
