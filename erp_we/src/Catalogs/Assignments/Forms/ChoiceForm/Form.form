	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	0 AS Count,
	0 AS Demand,
	0 AS Supplied,
	0 AS AvailableSender
	
FROM
	Catalog.Assignments AS AssignmentsOverridable</queryText>
