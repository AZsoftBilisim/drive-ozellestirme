		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	&amp;ReportItem AS Factor,
	&amp;StartDate AS StartDate,
	&amp;EndDate AS EndDate,
	&amp;ExtDimensionTurnoverType AS ExtDimensionType,
	&amp;ExtDimension1,
	&amp;ExtDimension2,
	&amp;ExtDimension3,
	&amp;Organization,
	&amp;Department,
	&amp;LineOfBusiness,
	ISNULL(RegisterTable.SumOpeningBalance, 0) * CASE
		WHEN &amp;ReverseSign = TRUE
			THEN -1
		ELSE 1
	END AS BalanceField,
	ISNULL(RegisterTable.SumClosingBalance, 0) * CASE
		WHEN &amp;ReverseSign = TRUE
			THEN -1
		ELSE 1
	END AS Value,
	&amp;RowCode AS RowCode,
	&amp;Note AS Note
FROM
	AccountingRegister.International.BalanceAndTurnovers(&amp;StartDate, &amp;EndDate, Auto,,, {(&amp;ExtDimensionTurnoverType)},
		{(Organization).* AS Organization} {(Department).* AS Department} {(LineOfBusiness).* AS
		LineOfBusiness} {(ExtDimension1).* AS ExtDimension1} {(ExtDimension2).* AS ExtDimension2} {(ExtDimension3).* AS
		ExtDimension3}) AS RegisterTable</query>
	</dataSet>
