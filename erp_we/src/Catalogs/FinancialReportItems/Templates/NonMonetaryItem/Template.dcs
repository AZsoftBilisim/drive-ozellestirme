		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;SlicePeriod AS SlicePeriod,
	&amp;ReportItem AS Factor,
	&amp;RowCode AS RowCode,
	&amp;Note AS Note,
	&amp;Organization,
	&amp;Department,
	ISNULL(RegisterTable.Value,0) AS Value
FROM
	InformationRegister.NonMonetaryItemsValues.SliceLast(
			&amp;SlicePeriod,
			Factor = &amp;Factor {(Organization).*, (Department).*}) AS RegisterTable</query>
	</dataSet>
