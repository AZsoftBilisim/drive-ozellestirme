    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Consente di trovare o riferirsi all'evento non in base al nome, ma in base al codice.</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Umożliwia znajdowanie lub odwoływanie się do zdarzenia nie przez nazwę, ale przez kod.</value>
