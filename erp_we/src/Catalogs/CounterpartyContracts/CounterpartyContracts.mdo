    <name>ApplicationDiscountingPeriod</name>
    <synonym>
      <key>en</key>
      <value>Discounting period</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>دوره تنزیل</value>
    </synonym>
    <synonym>
      <key>it</key>
