	CounterpartyContracts.ApplicationDiscountingPeriod AS ApplicationDiscountingPeriod,
	CounterpartyContracts.MarkedProductOutflowOption AS MarkedProductOutflowOption,
	CounterpartyContracts.ContractRateOption AS ContractRateOption,
	CounterpartyContracts.SplitReportByDocuments AS SplitReportByDocuments,
	CounterpartyContracts.ProcedureToRecordUninvoicedDeliveriesTA AS ProcedureToRecordUninvoicedDeliveriesTA,
	CounterpartyContracts.ForeignCounterpartyIncomeKind AS ForeignCounterpartyIncomeKind,
	CounterpartyContracts.ContractWithSelfEmployedPerson AS ContractWithSelfEmployedPerson,
	CounterpartyContracts.LeaseContracts AS LeaseContracts,
	CounterpartyContracts.OffsetOrderOfPaymentsAndInvoices AS OffsetOrderOfPaymentsAndInvoices,
	CounterpartyContracts.DoNotApply67FZRegulationWhenRevaluatingCustomerARAPOpenItems AS DoNotApply67FZRegulationWhenRevaluatingCustomerARAPOpenItems,
	CounterpartyContracts.ContractsWithCustomers.(
		Ref AS Ref,
		LineNumber AS LineNumber,
		ContractWithCustomer AS ContractWithCustomer,
		Percent AS Percent
	) AS ContractsWithCustomers,
	CounterpartyContracts.ReferenceDocuments.(
		Ref AS Ref,
		LineNumber AS LineNumber,
		DocumentKind AS DocumentKind,
		Number AS Number,
		Date AS Date,
		Sum AS Sum,
		File AS File
	) AS ReferenceDocuments,
	CounterpartyContracts.AdditionalAttributes.(
		Ref AS Ref,
		LineNumber AS LineNumber,
		Property AS Property,
		Value AS Value,
		TextString AS TextString
	) AS AdditionalAttributes,
	CounterpartyContracts.BranchOffices_.(
		Ref AS Ref,
		LineNumber AS LineNumber,
		Organization AS Organization
	) AS BranchOffices_
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts
		LEFT JOIN Catalog.Companies AS Companies
		ON CounterpartyContracts.Organization = Companies.Ref
		LEFT JOIN Catalog.Counterparties AS Counterparties
		ON CounterpartyContracts.Counterparty = Counterparties.Ref</query>
