	CounterpartyContracts.ProfitAmount AS ProfitAmount,
	CounterpartyContracts.AmountOfPrepaymentBeforeShipment AS AmountOfPrepaymentBeforeShipment,
	CounterpartyContracts.LineOfBusiness AS LineOfBusiness,
	CounterpartyContracts.VATRate AS VATRate,
	CounterpartyContracts.PurchaseRegistrationOption AS PurchaseRegistrationOption,
	CounterpartyContracts.PaymentOfExpensesAccordingToTariffsThatAreASubjectToStateRegulation AS PaymentOfExpensesAccordingToTariffsThatAreASubjectToStateRegulation,
	CounterpartyContracts.VATTaxation AS VATTaxation,
