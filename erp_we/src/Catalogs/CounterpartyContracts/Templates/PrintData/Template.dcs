	CounterpartyContracts.GroupOfFinancialARAPAccountingWithEndCustomer AS GroupOfFinancialARAPAccountingWithEndCustomer,
	CounterpartyContracts.ItIsAllowedToWorkWithSubsidiaryPartners AS ItIsAllowedToWorkWithSubsidiaryPartners,
