	CounterpartyContracts.Comment AS Comment,
	CounterpartyContracts.ValidityStartDate AS ValidityStartDate,
	CounterpartyContracts.ValidityEndDate AS ValidityEndDate,
	Companies.Ref AS Organization,
	Counterparties.Ref AS Counterparty,
	CounterpartyContracts.Manager AS Manager,
	CounterpartyContracts.NameForPrinting AS NameForPrinting,
	CounterpartyContracts.CompanyActsAsAVATTaxAgent AS CompanyActsAsAVATTaxAgent,
	CounterpartyContracts.AgencyAgreementKind AS AgencyAgreementKind,
	CounterpartyContracts.Date AS Date,
	CounterpartyContracts.Number AS Number,
	CounterpartyContracts.Partner AS Partner,
	CounterpartyContracts.Department AS Department,
	CounterpartyContracts.ARAPObjectSettings AS ARAPObjectSettings,
	CounterpartyContracts.Approved AS Approved,
	CounterpartyContracts.Status AS Status,
	CounterpartyContracts.BusinessOperation AS BusinessOperation,
	CounterpartyContracts.ContractType AS ContractType,
	CounterpartyContracts.LimitDebtAmount AS LimitDebtAmount,
