	CounterpartyContracts.GoodsReceiptOption AS GoodsReceiptOption,
	CounterpartyContracts.StateContactID AS StateContactID,
	CounterpartyContracts.DeliveryMethod AS DeliveryMethod,
	CounterpartyContracts.CarrierPartner AS CarrierPartner,
	CounterpartyContracts.DeliveryZone AS DeliveryZone,
	CounterpartyContracts.DeliveryTimeFrom AS DeliveryTimeFrom,
	CounterpartyContracts.DeliveryTimeTo AS DeliveryTimeTo,
	CounterpartyContracts.DeliveryAddress AS DeliveryAddress,
	CounterpartyContracts.DeliveryAddressFieldValues AS DeliveryAddressFieldValues,
	CounterpartyContracts.AdditionalDeliveryInformation AS AdditionalDeliveryInformation,
	CounterpartyContracts.DeliveryAddressOfCarrier AS DeliveryAddressOfCarrier,
	CounterpartyContracts.DeliveryAddressOfCarrierFieldValues AS DeliveryAddressOfCarrierFieldValues,
	CounterpartyContracts.DeliveryAddressForVendor AS DeliveryAddressForVendor,
