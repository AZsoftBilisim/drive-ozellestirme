		<field xsi:type="DataSetFieldField">
			<dataPath>ARAPObject</dataPath>
			<field>ARAPObject</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ISNULL(CustomersARAPAccountingBalance.AmountDueBalance, 0) AS RemainingAmountDueForPayment,
	CounterpartyContracts.BankAccount,
	CounterpartyContracts.ARAPCurrency,
	CounterpartyContracts.Organization,
	CounterpartyContracts.Counterparty,
	CounterpartyContracts.Manager,
	CounterpartyContracts.NameForPrinting AS Description,
	CounterpartyContracts.Number,
	CounterpartyContracts.Date,
	CounterpartyContracts.AllowableAmountPayable,
	Partners.Description AS PartnerName_,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	CounterpartyContracts.ValidityStartDate,
	CounterpartyContracts.ValidityEndDate
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts
		{LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(, ARAPObject IN (
			SELECT ARAPObjects.Ref 
			FROM Catalog.ARAPObjects AS ARAPObjects 
			WHERE ARAPObjects.Object = &amp;CounterpartyContracts
			AND NOT ARAPObjects.DeletionMark)
		 ) AS CustomersARAPAccountingBalance
		ON CounterpartyContracts.Ref = CustomersARAPAccountingBalance.ARAPObject.Object}
		{LEFT JOIN Catalog.Partners AS Partners
		ON CounterpartyContracts.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON CounterpartyContracts.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	CounterpartyContracts.Ref = &amp;CounterpartyContracts</query>
	</dataSet>
