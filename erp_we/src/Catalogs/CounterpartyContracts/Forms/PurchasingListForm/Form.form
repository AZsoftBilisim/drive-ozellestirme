      <segments>List.SourceDocumentOriginalState</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogCounterpartyContracts.Ref,
	CatalogCounterpartyContracts.DataVersion,
	CatalogCounterpartyContracts.DeletionMark,
	CatalogCounterpartyContracts.Predefined,
	CatalogCounterpartyContracts.Description,
	CatalogCounterpartyContracts.Number,
	CatalogCounterpartyContracts.Date,
	CatalogCounterpartyContracts.Partner,
	CatalogCounterpartyContracts.Counterparty,
	CatalogCounterpartyContracts.Organization,
	CatalogCounterpartyContracts.BusinessOperation,
	CatalogCounterpartyContracts.ContractType,
	CatalogCounterpartyContracts.ARAPCurrency,
	CatalogCounterpartyContracts.ForeignCurrencyTransaction,
	CatalogCounterpartyContracts.Status,
	CatalogCounterpartyContracts.ValidityStartDate,
	CatalogCounterpartyContracts.ValidityEndDate,
	CatalogCounterpartyContracts.Manager,
	CatalogCounterpartyContracts.Comment,
	CatalogCounterpartyContracts.BankAccount,
	CatalogCounterpartyContracts.CounterpartyBankAccount,
	CatalogCounterpartyContracts.PaymentsAsPer275FZ,
	&amp;DefaultPartner AS DefaultPartner,
	VALUE(Enum.BusinessTransactions.PurchaseFromSupplier) AS DefaultBusinessTransaction,
	CASE
	WHEN CatalogCounterpartyContracts.DeletionMark
			THEN VALUE(Enum.CounterpartyContractStates.EmptyRef)
			// unopened //////////////////////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Closed)
			THEN VALUE(Enum.CounterpartyContractStates.Closed)
			// IT WORKS ///////////////////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
			THEN VALUE(Enum.CounterpartyContractStates.Valid)
			// APPROVAL IS EXPECTED //////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
			THEN VALUE(Enum.CounterpartyContractStates.PendingApproval)
	END AS State,
	CASE
		WHEN CatalogCounterpartyContracts.DeletionMark
			THEN FALSE
			// APPROVAL IS OVERDUE //////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
		AND ((CatalogCounterpartyContracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityStartDate &lt; &amp;UpdateDate)
		OR (CatalogCounterpartyContracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityEndDate &lt; &amp;UpdateDate))
			THEN TRUE
		ELSE FALSE
	END AS ApprovalOverdue,
	CASE
			WHEN CatalogCounterpartyContracts.DeletionMark
			THEN FALSE
			// EXPIRED //////////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		AND ((CatalogCounterpartyContracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityEndDate &lt; &amp;UpdateDate))
			THEN TRUE
		ELSE FALSE
	END AS ValidityPeriodExpired,
	CASE
		WHEN CatalogCounterpartyContracts.DeletionMark
			THEN FALSE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
				AND (CatalogCounterpartyContracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
					AND CatalogCounterpartyContracts.ValidityStartDate > &amp;UpdateDate)
			THEN TRUE
		ELSE FALSE
	END AS TheValidityPeriodHasNotCome,
	CASE
		WHEN CatalogCounterpartyContracts.DeletionMark
			THEN DATETIME(1, 1, 1)
			// APPROVAL IS OVERDUE OR EXPIRED//////////////////////////
 WHEN
			(CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
		OR CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid))
		AND CatalogCounterpartyContracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
			THEN CatalogCounterpartyContracts.ValidityEndDate
			// APPROVAL IS OVERDUE //////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
		AND CatalogCounterpartyContracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
			THEN CatalogCounterpartyContracts.ValidityStartDate
			// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		AND ((CatalogCounterpartyContracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityStartDate > &amp;UpdateDate))
			THEN CatalogCounterpartyContracts.ValidityStartDate
		ELSE DATETIME(1, 1, 1)
	END AS EventDate,
	CASE
		WHEN CatalogCounterpartyContracts.DeletionMark
			THEN FALSE
			// APPROVAL IS OVERDUE //////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.NotApproved)
		AND ((CatalogCounterpartyContracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityStartDate &lt; &amp;UpdateDate)
		OR (CatalogCounterpartyContracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityEndDate &lt; &amp;UpdateDate))
			THEN TRUE
			// EXPIRED //////////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		AND ((CatalogCounterpartyContracts.ValidityEndDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityEndDate &lt; &amp;UpdateDate))
			THEN TRUE
			// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
 WHEN
			CatalogCounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		AND ((CatalogCounterpartyContracts.ValidityStartDate &lt;> DATETIME(1, 1, 1)
		AND CatalogCounterpartyContracts.ValidityStartDate > &amp;UpdateDate))
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CatalogCounterpartyContracts.FinancialAccountingGroup,
	CatalogCounterpartyContracts.LineOfBusiness,
	CatalogCounterpartyContracts.CashFlowItem,
	CatalogCounterpartyContracts.ContractSchedule,
	0 AS StateOriginalReceived,
	TRUE AS OverallState,
	NULL AS SourceDocumentOriginalState,
	StatesByEDIAccountingObjects.EDIState AS EDIState,
	StatesByEDIAccountingObjects.StatusPresentation AS StatusPresentation
FROM
	Catalog.CounterpartyContracts AS CatalogCounterpartyContracts
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS StatesByEDIAccountingObjects
		ON CatalogCounterpartyContracts.Ref = StatesByEDIAccountingObjects.ObjectReference
WHERE
CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromSupplier)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEU)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement)
	//++ Deprecated_Recycling 24
 OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductionByToller)
	//-- Outdated_Recycling 24
 OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductionByToller2_5)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductionAtProcessorInEAEUCountries2_5)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseByImport)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportGoodsInTransit)
	OR
		CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ReceivingForStorageWithRightOfSale)</queryText>
      <mainTable>Catalog.CounterpartyContracts</mainTable>
