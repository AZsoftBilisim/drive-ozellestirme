    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogCounterpartyContracts.Ref,
	CatalogCounterpartyContracts.DataVersion,
	CatalogCounterpartyContracts.DeletionMark,
	CatalogCounterpartyContracts.Predefined,
	CatalogCounterpartyContracts.Description,
	CatalogCounterpartyContracts.Number,
	CatalogCounterpartyContracts.Date,
	CatalogCounterpartyContracts.NameForPrinting,
	CatalogCounterpartyContracts.Partner,
	CatalogCounterpartyContracts.Counterparty,
	CatalogCounterpartyContracts.Organization,
	CatalogCounterpartyContracts.ARAPObjectSettings,
	CatalogCounterpartyContracts.ContractType,
	CatalogCounterpartyContracts.BusinessOperation,
	CatalogCounterpartyContracts.ARAPCurrency,
	CatalogCounterpartyContracts.ForeignCurrencyTransaction,
	CatalogCounterpartyContracts.BankAccount,
	CatalogCounterpartyContracts.CounterpartyBankAccount,
	CatalogCounterpartyContracts.Status,
	CatalogCounterpartyContracts.Approved,
	CatalogCounterpartyContracts.ValidityStartDate,
	CatalogCounterpartyContracts.ValidityEndDate,
	CatalogCounterpartyContracts.Manager,
	CatalogCounterpartyContracts.Comment,
	CatalogCounterpartyContracts.CompanyActsAsAVATTaxAgent,
	CatalogCounterpartyContracts.AdditionalAttributes.(
		Ref,
		LineNumber,
		Property,
		Value,
		TextString
	),
	&amp;DefaultPartner AS DefaultPartner,
	CatalogCounterpartyContracts.FinancialAccountingGroup,
	CatalogCounterpartyContracts.LineOfBusiness,
	CatalogCounterpartyContracts.CashFlowItem,
	CatalogCounterpartyContracts.ContractWithSDOParticipant,
	CatalogCounterpartyContracts.PaymentsAsPer275FZ,
	CatalogCounterpartyContracts.StateContract,
	CASE
		WHEN CatalogCounterpartyContracts.ContractType = VALUE(Enum.ContractTypes.WithCustomer)
				AND CatalogCounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			OR CatalogCounterpartyContracts.ContractType = VALUE(Enum.ContractTypes.ReceiptForTolling2_5)
			THEN TRUE
		ELSE FALSE
	END AS SuitableForSelectionInTheCustomerSContract
FROM
	Catalog.CounterpartyContracts AS CatalogCounterpartyContracts
{WHERE
	CatalogCounterpartyContracts.Organization IN (&amp;Organization)
		OR (CatalogCounterpartyContracts.BranchOffices_.Organization IN (&amp;Organization)
			AND NOT &amp;OBEntry)
		OR CatalogCounterpartyContracts.Organization.ParentCompany = &amp;Organization
			AND CatalogCounterpartyContracts.Organization.TransactionsUsingParentCompanyAreAllowed
			AND &amp;AllowSelectionOfBranchContracts AS FilterByCompany,
	&amp;Organization AS OrganizationOfSelection,
	CASE WHEN CatalogCounterpartyContracts.ItIsAllowedToWorkWithSubsidiaryPartners
		THEN CatalogCounterpartyContracts.Partner IN (&amp;PartnerList)
		ELSE CatalogCounterpartyContracts.Partner IN (&amp;DefaultPartner)
	END AS FilterByPartner,
	CatalogCounterpartyContracts.LineOfBusiness IN(&amp;LineOfBusiness)
}</queryText>
      <mainTable>Catalog.CounterpartyContracts</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
