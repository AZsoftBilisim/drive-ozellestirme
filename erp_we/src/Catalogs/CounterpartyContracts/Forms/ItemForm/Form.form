    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	VALUE(Catalog.Users.EmptyRef) AS Ref,
	FALSE AS DeletionMark,
	1 AS PictureIndex,
	CAST(&quot;&quot; AS STRING(150)) AS Description,
	CAST(&quot;&quot; AS STRING(10)) AS Extension,
	CAST(&quot;&quot; AS STRING(500)) AS LongDesc,
	VALUE(Catalog.Users.EmptyRef) AS Author,
	DATETIME(1, 1, 1, 0, 0, 0) AS CreationDate,
	VALUE(Catalog.Users.EmptyRef) AS WasEditedBy,
	DATETIME(1, 1, 1, 0, 0, 0) AS EditDate,
	DATETIME(1, 1, 1, 0, 0, 0) AS ChangeDate,
	0 AS Size,
	UNDEFINED AS EDSentReceived,
	FALSE AS SignedWithDS,
	FALSE AS Encrypted,
	-1 AS SignedEncryptedPictureNumber,
	FALSE AS FileBeingEdited,
	FALSE AS CurrentUserEditsFile,
	FALSE AS AnotherUserEditsFile,
	FALSE AS StoreVersions,
	FALSE AS IsFolder,
	FALSE AS IsInternal,
	&amp;FileOwner AS FileOwner,
	UNDEFINED AS BeingEditedBy,
	UNDEFINED AS EditedByUser
FROM
	Catalog.MetadataObjectIDs AS MetadataObjectIDsOverridable</queryText>
      <mainTable>Catalog.MetadataObjectIDs</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
