					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>You can specify weight in documents</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>می‌توانید وزن را در اسناد مشخص کنید</v8:content>
