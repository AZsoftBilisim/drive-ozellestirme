  <attributes>
    <name>ListProducts</name>
    <title>
      <key>en</key>
      <value>List products</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست محصولات</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco articoli</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista towary</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список номенклатура</value>
    </title>
    <title>
      <key>tr</key>
      <value>Öğe listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách mặt hàng</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.PictureIndex</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.ProductKind</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListProducts.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatProducts.Ref AS Ref,
	CatProducts.Code,
	CatProducts.DeletionMark AS DeletionMark,
	CatProducts.Description,
	CatProducts.SKU,
	CatProducts.ProductKind,
	CatProducts.UnitOfMeasure,
	CatProducts.VATRate,
	CatProducts.ItemsType,
	CatProducts.Parent,
	CASE
		WHEN CatProducts.ThereAreGoodsOfOtherQuality
			THEN 4 + CASE
					WHEN CatProducts.DeletionMark
						THEN 1
					ELSE 0
				END + CASE
					WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
						THEN 0
					ELSE 2
				END
		ELSE CASE
				WHEN CatProducts.DeletionMark
					THEN 1
				ELSE 0
			END + CASE
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
					THEN 0
				ELSE 2
			END
	END AS PictureIndex,
	ISNULL(ProductKitConfigurations.ContainsGoods, FALSE) AS ContainsGoods,
	ISNULL(ProductKitConfigurations.ContainsServices, FALSE) AS ContainsServices,
	CatProducts.AccountingFeature AS AccountingFeature,
	CatProducts.UseVariants AS UseVariants,
	CatProducts.Quality AS Quality,
	CatProducts.KeepRecordsOfQualityCertificates AS KeepRecordsOfQualityCertificates,
	CatProducts.ProductsMarkedForSPMS AS FurSkinProducts
FROM
	Catalog.Products AS CatProducts
		LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
		ON (ProductKitConfigurations.Owner = CatProducts.Ref)
			AND (ProductKitConfigurations.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef))
			AND (ProductKitConfigurations.Main)
WHERE
	NOT CatProducts.IsFolder
{WHERE
	CatProducts.Ref.*}

{WHERE
	(CatProducts.Ref IN
			(SELECT
				Segments.Products
			FROM
				InformationRegister.SegmentProducts AS Segments
			WHERE
				Segments.Segment = &amp;ProductSegment)),
	(CASE
			WHEN CASE
					WHEN CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Set)
						THEN ISNULL(ProductKitConfigurations.SetPricingOption, VALUE(Enum.SetPriceCalculationOptions.EmptyRef))
					ELSE VALUE(Enum.SetPriceCalculationOptions.EmptyRef)
				END IN (&amp;SetPriceCalculationOptions)
				THEN TRUE
			ELSE FALSE
		END)}</queryText>
      <mainTable>Catalog.Products</mainTable>
