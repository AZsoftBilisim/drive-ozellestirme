  <commands uuid="7df3a25d-f238-4765-82ae-25ae9eb282c8">
    <name>ExportApplicationToFile</name>
    <synonym>
      <key>en</key>
      <value>Export application to file</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>خروج برنامه به فایل</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Importare l'applicazione nel file</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wyślij aplikację do pliku</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Выгрузить приложение в файл</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Uygulamayı dosyaa yükle</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Kết xuất ứng dụng ra tệp</value>
    </synonym>
    <group>FormNavigationPanelSeeAlso</group>
    <commandParameterType>
      <types>CatalogRef.MobileApplicationsVersions</types>
    </commandParameterType>
    <representation>Auto</representation>
    <toolTip>
      <key>en</key>
      <value>Exports the mobile application to a file so that you can import it to another infobase</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>برنامه موبایل را به فایل خروجی می‌دهد تا بتوانید آن را به پایگاه اطلاعات دیگری وارد کنید</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Viene eseguita l'importazione dell'applicazione per dispositivi mobili nel file per un possibile download in un'altra base informativa</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Jest wykonywane wysłanie aplikacji mobilnej do pliku w celu zabezpieczenia możliwości pobierania do innej BI</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Выполняется выгрузка мобильного приложения в файл для возможности загрузки в другую ИБ</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Mobil uygulama, başka bir Infobase'e yüklenebilmesi için bir dosyaya yükleniyor</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đang tiến hành kết xuất ứng dụng di động ra tệp để có thể kết nhập ra CSTT khác</value>
    </toolTip>
  </commands>
