    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogLoyaltyCardKinds.Ref,
	CatalogLoyaltyCardKinds.DataVersion,
	CatalogLoyaltyCardKinds.DeletionMark,
	CatalogLoyaltyCardKinds.Predefined,
	CatalogLoyaltyCardKinds.Description,
	CatalogLoyaltyCardKinds.Status,
	CatalogLoyaltyCardKinds.ValidityStartDate,
	CatalogLoyaltyCardKinds.ValidityEndDate,
	CatalogLoyaltyCardKinds.Comment,
	CatalogLoyaltyCardKinds.Personalized,
	CatalogLoyaltyCardKinds.AllowAutoRegistrationAtFirstReading,
	CatalogLoyaltyCardKinds.CardType,
	CatalogLoyaltyCardKinds.Organization,
	
	CASE
		WHEN
			CatalogLoyaltyCardKinds.DeletionMark
		THEN
			VALUE(Enum.StatesOfLoyaltyCardKinds.EmptyRef)
		// closed ////////////////////////////////////////////////////////////////
		WHEN
			CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Closed)
		THEN
			VALUE(Enum.StatesOfLoyaltyCardKinds.Closed)
		// IT WORKS ///////////////////////////////////////////////////////////////
		WHEN
			CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
		THEN
			VALUE(Enum.StatesOfLoyaltyCardKinds.Valid)
		// APPROVAL IS EXPECTED //////////////////////////////////////////////////
		WHEN
			CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.NotValid)
		THEN
			VALUE(Enum.StatesOfLoyaltyCardKinds.PendingApproval)
	END AS State,

	CASE
		WHEN
			CatalogLoyaltyCardKinds.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.NotValid)
			AND ((CatalogLoyaltyCardKinds.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityStartDate &lt; &amp;UpdateDate)
			OR (CatalogLoyaltyCardKinds.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE 
			FALSE
	END AS ApprovalOverdue,
	
	CASE
		WHEN
			CatalogLoyaltyCardKinds.DeletionMark
		THEN
			FALSE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
			AND ((CatalogLoyaltyCardKinds.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS ValidityPeriodExpired,
	
	CASE
		WHEN
			CatalogLoyaltyCardKinds.DeletionMark
		THEN
			FALSE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
			AND ((CatalogLoyaltyCardKinds.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS TheValidityPeriodHasNotCome,
	
	CASE
		WHEN
			CatalogLoyaltyCardKinds.DeletionMark
		THEN
			DATETIME(1,1,1)
		// APPROVAL IS OVERDUE OR EXPIRED//////////////////////////
		WHEN (CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.NotValid)
			OR CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid))
			AND CatalogLoyaltyCardKinds.ValidityEndDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogLoyaltyCardKinds.ValidityEndDate
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.NotValid)
			AND CatalogLoyaltyCardKinds.ValidityStartDate &lt;> DATETIME(1,1,1)
		THEN
			CatalogLoyaltyCardKinds.ValidityStartDate
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
			AND ((CatalogLoyaltyCardKinds.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityStartDate > &amp;UpdateDate))
		THEN
			CatalogLoyaltyCardKinds.ValidityStartDate
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	
	CASE
		WHEN
			CatalogLoyaltyCardKinds.DeletionMark
		THEN
			FALSE
		// APPROVAL IS OVERDUE //////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.NotValid)
			AND ((CatalogLoyaltyCardKinds.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityStartDate &lt; &amp;UpdateDate)
			OR (CatalogLoyaltyCardKinds.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// EXPIRED //////////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
			AND ((CatalogLoyaltyCardKinds.ValidityEndDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityEndDate &lt; &amp;UpdateDate))
		THEN
			TRUE
		// THE EXPIRATION DATE HAS NOT COME ////////////////////////////////////////////////
		WHEN CatalogLoyaltyCardKinds.Status = VALUE(Enum.StatusesOfLoyaltyCardKinds.Valid)
			AND ((CatalogLoyaltyCardKinds.ValidityStartDate &lt;> DATETIME(1,1,1) AND
			CatalogLoyaltyCardKinds.ValidityStartDate > &amp;UpdateDate))
		THEN
			TRUE
		ELSE
			FALSE
	END AS Overdue

FROM
	Catalog.LoyaltyCardKinds AS CatalogLoyaltyCardKinds</queryText>
      <mainTable>Catalog.LoyaltyCardKinds</mainTable>
