                </extInfo>
              </extendedTooltip>
              <contextMenu>
                <name>FillInBOMByPeriodsContextMenu</name>
                <id>640</id>
                <autoFill>true</autoFill>
              </contextMenu>
              <type>RadioButtonField</type>
