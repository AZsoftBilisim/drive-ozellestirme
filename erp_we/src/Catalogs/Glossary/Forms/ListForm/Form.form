        <field>DescriptionLanguage2</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ConfigurationObjects</dataPath>
        <field>ConfigurationObjects</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>GlossaryDetails</dataPath>
        <field>GlossaryDetails</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Predefined</dataPath>
        <field>Predefined</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PredefinedDataName</dataPath>
        <field>PredefinedDataName</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ref</dataPath>
        <field>Ref</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DeletionMark</dataPath>
        <field>DeletionMark</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Code</dataPath>
        <field>Code</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Description</dataPath>
        <field>Description</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>GlossaryDescription</dataPath>
        <field>GlossaryDescription</field>
        <title>
          <localValue>
