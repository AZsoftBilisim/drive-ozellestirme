<mdclass:EventSubscription xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="7ce7aec1-fa24-4dd7-8754-8124e78521bf">
  <name>ProhibitUsageOfObjectsToDeleteInRecordSets</name>
  <synonym>
    <key>en</key>
    <value>Restrict usage of objects to delete in record sets</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>محدودسازی استفاده از اشیای در حال حذف در مجموعه‌های ثبت</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Proibire l'utilizzo degli oggetti cancellabili nei set di registrazioni</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Zabroń używanie usuwanych obiektów w zestawach wpisów</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Запретить использование удаляемых объектов в наборах записей</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Kayıt setlerinde silinen nesnelerin kullanımını yasakla</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Cấm sử dụng các đối tượng đã xóa trong tập bản ghi</value>
  </synonym>
  <source>
    <types>InformationRegisterRecordSet</types>
    <types>AccountingRegisterRecordSet</types>
    <types>AccumulationRegisterRecordSet</types>
  </source>
  <event>BeforeWrite</event>
  <handler>CommonModule.MarkedObjectsDeletionInternal.ProhibitUsageOfObjectsToDeleteInRecordSetsOnWrite</handler>
</mdclass:EventSubscription>
