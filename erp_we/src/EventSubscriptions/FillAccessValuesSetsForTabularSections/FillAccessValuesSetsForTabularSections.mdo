  <name>FillAccessValuesSetsForTabularSections</name>
  <synonym>
    <key>en</key>
    <value>Populate access value sets of tables</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>تکمیل مجموعه‌های مقدار دسترسی جدول‌ها</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Compilare i set di valori di accesso alle parti tabellari</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Wypełnij zestawy wartości dostępu sekcji tabelarycznych</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Заполнить наборы значений доступа табличных частей</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Tablolu parçaların erişim değeri setlerini doldur</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Điền tập hợp giá trị truy cập phần bảng</value>
  </synonym>
  <comment>The subscription is supplied by the access Control subsystem to populate the table part of the set of access Values for the metadata objects in which it was created for the #set of Values template to work</comment>
  <source>
    <types>DefinedType.OwnerLimitedByAccessValuesSetsObject</types>
  </source>
  <event>BeforeWrite</event>
  <handler>CommonModule.AccessManagementInternal.FillAccessValuesSetsForTabularSections</handler>
