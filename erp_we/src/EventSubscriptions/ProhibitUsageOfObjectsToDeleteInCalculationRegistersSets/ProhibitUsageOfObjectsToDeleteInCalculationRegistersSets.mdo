<mdclass:EventSubscription xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="8b115575-9d8b-42f8-9ec8-0825a4397c7f">
  <name>ProhibitUsageOfObjectsToDeleteInCalculationRegistersSets</name>
  <synonym>
    <key>en</key>
    <value>Restrict usage of objects to delete in calculation register sets</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>محدودسازی استفاده از اشیای در حال حذف در مجموعه‌های رجیستر محاسبه</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Proibire l'utilizzo degli oggetti cancellabili nei set dei registri di calcolo</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Zabroń używanie stosowanych obiektów w zestawach rejestrów obliczenia</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Запретить использование удаляемых объектов в наборах регистров расчета</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Hesaplama kayıtları setlerinde silinen nesnelerin kullanımını yasakla</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Cấm sử dụng các đối tượng đã xóa trong bộ thanh ghi tính toán</value>
  </synonym>
  <source>
    <types>CalculationRegisterRecordSet</types>
  </source>
  <event>BeforeWrite</event>
  <handler>CommonModule.MarkedObjectsDeletionInternal.ProhibitUsageOfObjectsToDeleteInCalculationRegistersSetsOnWrite</handler>
</mdclass:EventSubscription>
