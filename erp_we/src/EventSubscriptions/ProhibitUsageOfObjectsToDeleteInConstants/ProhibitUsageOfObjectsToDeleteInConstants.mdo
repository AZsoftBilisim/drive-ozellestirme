    <key>it</key>
    <value>Proibire utilizzo degli oggetti cancellabili nelle costanti</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Zabroń używanie usuwanych obiektów w stałych</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Запретить использование удаляемых объектов в константах</value>
