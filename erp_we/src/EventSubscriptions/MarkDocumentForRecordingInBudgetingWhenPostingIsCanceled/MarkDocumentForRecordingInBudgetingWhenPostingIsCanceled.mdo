  </synonym>
  <synonym>
    <key>pl</key>
    <value>Anuluj dokument do odzwierciedlenia w budżetowaniu przy anulowaniu zaksięgowania</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Отметить документ к отражению в бюджетировании при отмене проведения</value>
  </synonym>
  <synonym>
    <key>tr</key>
