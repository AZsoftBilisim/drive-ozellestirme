<mdclass:EventSubscription xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="12bd51ad-eb6a-4422-b36a-8f6327bb7bf3">
  <name>SetInfobasePrefixAndCashBookPrefixToDocumentNumber</name>
  <synonym>
    <key>en</key>
    <value>Set an infobase prefix and a cash book prefix to the document number</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>تعیین پیشوند پایگاه اطلاعات و پیشوند دفتر صندوق برای شماره سند</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Impostare il prefisso dell'infobase e del libro cassa al numero del documento</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Ustaw prefiks bazy informacyjnej i księgi kasowej do numeru dokumentu</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Установить префикс информационной базы и кассовой книги номеру документа</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Infobase ve kasa defterinin ön ekini belge numarasına yapılandır</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Đặt tiền tố cơ sở thông tin và sổ quỹ cho số chứng từ</value>
  </synonym>
  <source>
    <types>DocumentObject.CashVoucher</types>
    <types>DocumentObject.PhysicalCountOfCashAccounts</types>
    <types>DocumentObject.CashAccountReceiptNote</types>
  </source>
  <event>OnSetNewNumber</event>
  <handler>CommonModule.CashServer.SetInfobasePrefixAndCashBookPrefixToDocumentNumberOnSetNewNumber</handler>
</mdclass:EventSubscription>
