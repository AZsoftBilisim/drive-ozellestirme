		MessageText = NStr("vi = 'Cần chọn người cho thuê';
							|ru = 'Необходимо выбрать арендодателя';
							|en = 'Select a lessor'; fa = 'Select a lessor';
							|it = 'È necessario selezionare il locatore';
							|pl = 'Należy wybrać wynajemcę';
							|tr = 'Bir kiraya vereni seçmek gereklidir'");
