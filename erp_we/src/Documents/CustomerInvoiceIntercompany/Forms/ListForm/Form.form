  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomerInvoiceIntercompany.Ref,
	CustomerInvoiceIntercompany.DeletionMark,
	CustomerInvoiceIntercompany.Number,
	CustomerInvoiceIntercompany.Date,
	CustomerInvoiceIntercompany.Posted,
	CustomerInvoiceIntercompany.Currency,
	CustomerInvoiceIntercompany.Comment,
	CustomerInvoiceIntercompany.BusinessOperation,
	CustomerInvoiceIntercompany.Counterparty,
	CustomerInvoiceIntercompany.Organization,
	CustomerInvoiceIntercompany.PriceIncludesVAT,
	CustomerInvoiceIntercompany.Warehouse,
	CustomerInvoiceIntercompany.Shipper,
	CustomerInvoiceIntercompany.GoodsRecipient,
	CustomerInvoiceIntercompany.DeliveryAddress,
	CustomerInvoiceIntercompany.PowerOfAttorneyNumber,
	CustomerInvoiceIntercompany.PowerOfAttorneyDate,
	CustomerInvoiceIntercompany.LetterOfAuthorityIssuedBy,
	CustomerInvoiceIntercompany.PowerOfAttorneyPerson,
	CustomerInvoiceIntercompany.VATTaxation,
	CustomerInvoiceIntercompany.Department,
	CustomerInvoiceIntercompany.PaymentDate,
	CustomerInvoiceIntercompany.CompanyBankAccount,
	CustomerInvoiceIntercompany.RecipientCompanyBankAccount,
	CustomerInvoiceIntercompany.ShipperBankAccount,
	CustomerInvoiceIntercompany.GoodsRecipientBankAccount,
	CustomerInvoiceIntercompany.PriceKind,
	CustomerInvoiceIntercompany.PaymentMethod,
	CustomerInvoiceIntercompany.ARAPCurrency,
	CustomerInvoiceIntercompany.AmountARAP,
	CustomerInvoiceIntercompany.BeginOfPeriod,
	CustomerInvoiceIntercompany.EndOfPeriod,
	CustomerInvoiceIntercompany.CompanyRecipient,
	CustomerInvoiceIntercompany.ARAPAccountingViaSeparateCounterparty,
	CustomerInvoiceIntercompany.Partner,
	CustomerInvoiceIntercompany.DocumentAmount,
	CustomerInvoiceIntercompany.CounterpartyBankAccount,
	CustomerInvoiceIntercompany.IncomingDocumentNumber,
	CustomerInvoiceIntercompany.IncomingDocumentDate,
	CustomerInvoiceIntercompany.SpecifyCCDNumbers,
	CustomerInvoiceIntercompany.Manager,
	CustomerInvoiceIntercompany.FinancialAccountingGroup,
	CustomerInvoiceIntercompany.TransferForActivity_,
	CustomerInvoiceIntercompany.Contract,
	CustomerInvoiceIntercompany.Director,
	CustomerInvoiceIntercompany.ChiefAccountant,
	CustomerInvoiceIntercompany.InventoryOwnerAttributesAreSpecifiedManually,
	CustomerInvoiceIntercompany.ARAPObjectSettings,
	CustomerInvoiceIntercompany.Basis,
	CustomerInvoiceIntercompany.ReferenceDocumentDateForPrintForms,
	CustomerInvoiceIntercompany.BaseDocumentNumber,
	CustomerInvoiceIntercompany.SaleRegistrationOption,
	CustomerInvoiceIntercompany.PaymentID,
	CustomerInvoiceIntercompany.LineOfBusiness,
	CustomerInvoiceIntercompany.IssuiedBy,
	CustomerInvoiceIntercompany.IssuiedByJobTitle,
	CustomerInvoiceIntercompany.SalesContract,
	CustomerInvoiceIntercompany.PurchasingContract,
	CustomerInvoiceIntercompany.CourseNumerator,
	CustomerInvoiceIntercompany.CourseDenominator,
	CustomerInvoiceIntercompany.FinancialAccountingGroupOfRecipient,
	CustomerInvoiceIntercompany.Goods.*,
	CustomerInvoiceIntercompany.InventoryKinds.*,
	CustomerInvoiceIntercompany.ARAPDetailsWithCustomer.*,
	CustomerInvoiceIntercompany.ARAPDetailsWithVendor.*,
	CustomerInvoiceIntercompany.AdditionalAttributes.*,
	CustomerInvoiceIntercompany.PackageBarcodes.*,
	CustomerInvoiceIntercompany.PointInTime,
	CustomerInvoiceIntercompany.Author,
	//++ Localization
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
	//-- Localization
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.CustomerInvoiceIntercompany AS CustomerInvoiceIntercompany
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = CustomerInvoiceIntercompany.Ref)</queryText>
      <mainTable>Document.CustomerInvoiceIntercompany</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Shipper</dataPath>
        <field>Shipper</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Date</dataPath>
        <field>Date</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PaymentSchedule</dataPath>
        <field>PaymentSchedule</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>SalesContract</dataPath>
        <field>SalesContract</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>AdditionalAttributes.Property</dataPath>
