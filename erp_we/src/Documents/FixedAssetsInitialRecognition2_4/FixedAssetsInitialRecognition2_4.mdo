    <editFormat>
      <key>en</key>
      <value>BF=No; BT=Yes</value>
    </editFormat>
    <editFormat>
      <key>fa</key>
      <value>BF=خیر; BT=بله</value>
    </editFormat>
    <editFormat>
      <key>it</key>
      <value>BF=No; BT=Si</value>
    </editFormat>
    <editFormat>
      <key>pl</key>
      <value>BF=Nie; BT=Tak</value>
    </editFormat>
