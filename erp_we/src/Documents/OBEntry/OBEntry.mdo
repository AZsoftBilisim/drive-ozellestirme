  <attributes uuid="63c6d63b-ba4b-4a6b-bfdc-3056296a87d0">
    <name>OBEntry22</name>
    <synonym>
      <key>en</key>
      <value>Balance entry22</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>ورود مانده22</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Immissione del saldo22</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Wprowadzanie ostatków22</value>
