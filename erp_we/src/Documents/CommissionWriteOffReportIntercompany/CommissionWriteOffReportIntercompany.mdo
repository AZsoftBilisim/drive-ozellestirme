    <attributes uuid="86ceec53-18ba-406b-9347-2439f6ee8972">
      <name>NumberOfPackages</name>
      <synonym>
        <key>en</key>
        <value>Sold</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>فروخته‌شده</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Venduto</value>
      </synonym>
      <synonym>
        <key>pl</key>
        <value>Sprzedano</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Продано</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Satılmış</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Đã bán</value>
