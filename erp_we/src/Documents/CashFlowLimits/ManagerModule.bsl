#Region Posting

Function AdditionalDataSourcesForRegisteredRecords(RegisterName) Export

	DataSources = New Map;

	Return DataSources; 

EndFunction

Procedure FillInInitializationParameters(Query, DocumentRef)

	Query.SetParameter("Ref", DocumentRef);
	Query.SetParameter("UseExpenseLimitsForOrganizations",
		GetFunctionalOption("UseCashFlowLimitsByCompanies"));
	Query.SetParameter("UseExpenseLimitsByDivision", 
		GetFunctionalOption("UseCashFlowLimitsByBusinessUnit"));
	
EndProcedure

Function QueryTextCashFlowLimits(Query, QueryTexts, Registers)
	
	RegisterName = "CashFlowLimits";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	QueryText =
	"SELECT
	|	Limits.Ref.Period AS Period,
	|	CASE
	|		WHEN &UseExpenseLimitsForOrganizations
	|			THEN Limits.Ref.Organization
	|		ELSE VALUE(Catalog.Companies.EmptyRef)
	|	END AS Organization,
	|	CASE
	|		WHEN &UseExpenseLimitsByDivision
	|			THEN Limits.Ref.Department 
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	Limits.CashFlowItem AS CashFlowItem,
	|	Limits.Sum AS Limit
	|FROM
	|	Document.CashFlowLimits.Limits AS Limits
	|WHERE
	|	Limits.Ref = &Ref
	|	AND Limits.ThereIsLimit";
	
	QueryTexts.Add(QueryText, RegisterName);
	Return QueryText;
	
EndFunction

