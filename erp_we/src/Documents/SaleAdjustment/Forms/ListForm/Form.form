    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListSaleAdjustments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DocumentSaleAdjustment.Ref,
	DocumentSaleAdjustment.DataVersion,
	DocumentSaleAdjustment.DeletionMark,
	DocumentSaleAdjustment.Number,
	DocumentSaleAdjustment.Date,
	DocumentSaleAdjustment.Posted,
	DocumentSaleAdjustment.DocumentBasis,
	DocumentSaleAdjustment.Partner,
	DocumentSaleAdjustment.Counterparty,
	DocumentSaleAdjustment.Terms,
	DocumentSaleAdjustment.Organization,
	DocumentSaleAdjustment.Contract,
	DocumentSaleAdjustment.Warehouse,
	DocumentSaleAdjustment.Department,
	DocumentSaleAdjustment.SalesOpportunity,
	DocumentSaleAdjustment.Currency,
	DocumentSaleAdjustment.ARAPCurrency,
	DocumentSaleAdjustment.Manager,
	DocumentSaleAdjustment.DocumentAmount,
	DocumentSaleAdjustment.PaymentDate,
	DocumentSaleAdjustment.PaymentMethod,
	DocumentSaleAdjustment.PriceIncludesVAT,
	DocumentSaleAdjustment.VATTaxation,
	DocumentSaleAdjustment.SaleByOrders,
	DocumentSaleAdjustment.IncomeItem,
	DocumentSaleAdjustment.DimensionOfRevenue,
	DocumentSaleAdjustment.ExpenseItem,
	DocumentSaleAdjustment.DimensionOfExpenses,
	DocumentSaleAdjustment.Approved,
	DocumentSaleAdjustment.IssuiedBy,
	DocumentSaleAdjustment.IssuiedByJobTitle,
	DocumentSaleAdjustment.Basis,
	DocumentSaleAdjustment.GoodsRecipient,
	DocumentSaleAdjustment.Shipper,
	DocumentSaleAdjustment.CompanyBankAccount,
	DocumentSaleAdjustment.CounterpartyBankAccount,
	DocumentSaleAdjustment.ShipperBankAccount,
	DocumentSaleAdjustment.GoodsRecipientBankAccount,
	DocumentSaleAdjustment.DeliveryAddress,
	DocumentSaleAdjustment.PowerOfAttorneyNumber,
	DocumentSaleAdjustment.PowerOfAttorneyDate,
	DocumentSaleAdjustment.LetterOfAuthorityIssuedBy,
	DocumentSaleAdjustment.PowerOfAttorneyPerson,
	DocumentSaleAdjustment.Comment,
	DocumentSaleAdjustment.AdjustmentKind,
	DocumentSaleAdjustment.Author,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	//++ Localization
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
	//-- Localization
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
FROM
	Document.SaleAdjustment AS DocumentSaleAdjustment
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentSaleAdjustment.Ref)
		LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentSaleAdjustment.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.SaleAdjustment</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
