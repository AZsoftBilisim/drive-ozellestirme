					<v8:lang>vi</v8:lang>
					<v8:content>Số tài khoản ngân hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PaymentDate</dataPath>
			<field>PaymentDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnerName_</dataPath>
			<field>PartnerName_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Partner name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نام شریک</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Nome del partner</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Nazwa partnera</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование партнера</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İş ortağının adı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tên gọi bạn hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	SaleAdjustment.Number,
	SaleAdjustment.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	SaleAdjustment.Warehouse,
	SaleAdjustment.Manager,
	SaleAdjustment.Currency,
	SaleAdjustment.PaymentMethod,
	SaleAdjustment.DocumentAmount,
	SaleAdjustment.Contract,
	SaleAdjustment.DeliveryAddress,
	SaleAdjustment.Shipper,
	SaleAdjustment.GoodsRecipient,
	SaleAdjustment.CompanyBankAccount,
	SaleAdjustment.PaymentDate
FROM
	Document.SaleAdjustment AS SaleAdjustment
		{LEFT JOIN Catalog.Partners AS Partners
		ON SaleAdjustment.Partner = Partners.Ref}
WHERE
	SaleAdjustment.Ref = &amp;SaleAdjustment</query>
	</dataSet>
