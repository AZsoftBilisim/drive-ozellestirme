    <attributes uuid="200c8c77-18f6-4e82-9a24-c727e0524428">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
      <synonym>
