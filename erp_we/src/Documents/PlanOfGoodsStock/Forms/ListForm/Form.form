  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Plans.Ref AS Ref,
	Plans.DeletionMark AS DeletionMark,
	Plans.Number AS Number,
	Plans.Date AS Date,
	Plans.Posted AS Posted,
	Plans.Status AS Status,
	Plans.Comment AS Comment,
	Plans.Periodicity AS Periodicity,
	Plans.BeginOfPeriod AS BeginOfPeriod,
	Plans.PeriodEnding AS PeriodEnding,
	Plans.EmployeeResponsible AS EmployeeResponsible,
	PlansOfGoodsStock.RelevanceOfThePlan AS RelevanceOfThePlan,
	Plans.Scenario AS Scenario,
	Plans.CrossTable AS CrossTable,
	Plans.PlanProfile AS PlanProfile,
	Plans.Warehouse AS Warehouse
FROM
	(SELECT
		PlansOfGoodsStock.Ref AS Ref,
		MAX(CASE
				WHEN BEGINOFPERIOD(&amp;CurrentDate, DAY) BETWEEN BEGINOFPERIOD(PlansOfGoodsStock.BeginOfPeriod, DAY) AND ENDOFPERIOD(PlansOfGoodsStock.PeriodEnding, DAY)
					THEN 1
				WHEN BEGINOFPERIOD(PlansOfGoodsStock.BeginOfPeriod, DAY) > BEGINOFPERIOD(&amp;CurrentDate, DAY)
					THEN 2
				WHEN FutureBalancePlans.Scenario IS NULL
					THEN 1
				ELSE 0
			END) AS RelevanceOfThePlan
	FROM
		Document.PlanOfGoodsStock AS PlansOfGoodsStock
			LEFT JOIN Document.PlanOfGoodsStock AS FutureBalancePlans
			ON PlansOfGoodsStock.Scenario = FutureBalancePlans.Scenario
				AND PlansOfGoodsStock.Warehouse = FutureBalancePlans.Warehouse
				AND PlansOfGoodsStock.Purpose = FutureBalancePlans.Purpose
				AND PlansOfGoodsStock.BeginOfPeriod &lt; FutureBalancePlans.BeginOfPeriod
	
	GROUP BY
		PlansOfGoodsStock.Ref) AS PlansOfGoodsStock
		LEFT JOIN Document.PlanOfGoodsStock AS Plans
		ON PlansOfGoodsStock.Ref = Plans.Ref</queryText>
      <mainTable>Document.PlanOfGoodsStock</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
