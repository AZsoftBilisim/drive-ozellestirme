		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DATEADD(TurnoverBalancePlans.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset), &amp;PeriodString) AS Period,
	TurnoverBalancePlans.PlanOfGoodsStock AS Document,
	TurnoverBalancePlans.Products AS Products,
	TurnoverBalancePlans.Products.ProductCategory AS ProductCategory,
	TurnoverBalancePlans.Products.SalesRank AS SalesRank,
	TurnoverBalancePlans.Purpose AS Purpose,
	ISNULL(TurnoverBalancePlans.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	TurnoverBalancePlans.CountTurnover AS BalancePlansWithFilter,
	DocPlanOfGoodsStock.Number AS DocumentNumber,
	DocPlanOfGoodsStock.Date AS DocumentDate
INTO AllPlansRemain
FROM
	AccumulationRegister.PlansOfGoodsStock.Turnovers(
			{(&amp;BeginOfPeriodZero)},
			{(&amp;OffsetPeriodEnd)},
			Auto,
			Scenario = &amp;Scenario
				AND Status IN (&amp;ScenarioStatuses) {(PlanOfGoodsStock &lt;&gt; &amp;Ref), (Warehouse = &amp;FilterWarehouse), (Purpose = &amp;FilterPurpose), ((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        &amp;FilterByProductSegmentIsUsed = TRUE))}) AS TurnoverBalancePlans
		LEFT JOIN Document.PlanOfGoodsStock AS DocPlanOfGoodsStock
		ON TurnoverBalancePlans.PlanOfGoodsStock = DocPlanOfGoodsStock.Ref
{WHERE
	TurnoverBalancePlans.Products,
	(ISNULL(TurnoverBalancePlans.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS Characteristic}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MAX(AllPlansRemain.Period) AS Period
INTO CurrentPeriod_
FROM
	AllPlansRemain AS AllPlansRemain
WHERE
	AllPlansRemain.Period &lt;= &amp;ActivePeriodStart
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;ActivePeriodStart &gt; AllPlansRemain.Period
			THEN &amp;ActivePeriodStart
		ELSE AllPlansRemain.Period
	END AS Period,
	AllPlansRemain.Document AS Document,
	AllPlansRemain.Products AS Products,
	AllPlansRemain.ProductCategory AS ProductCategory,
	AllPlansRemain.SalesRank AS SalesRank,
	AllPlansRemain.Purpose AS Purpose,
	AllPlansRemain.Characteristic AS Characteristic,
	AllPlansRemain.BalancePlansWithFilter AS BalancePlansWithFilter,
	AllPlansRemain.DocumentNumber AS DocumentNumber,
	AllPlansRemain.DocumentDate AS DocumentDate
FROM
	AllPlansRemain AS AllPlansRemain
		INNER JOIN CurrentPeriod_ AS CurrentPeriod_
		ON AllPlansRemain.Period = CurrentPeriod_.Period
WHERE
	AllPlansRemain.Period &lt;= &amp;ActivePeriodStart

UNION ALL

SELECT
	AllPlansRemain.Period,
	AllPlansRemain.Document,
	AllPlansRemain.Products,
	AllPlansRemain.ProductCategory,
	AllPlansRemain.SalesRank,
	AllPlansRemain.Purpose,
	AllPlansRemain.Characteristic,
	AllPlansRemain.BalancePlansWithFilter,
	AllPlansRemain.DocumentNumber,
	AllPlansRemain.DocumentDate
FROM
	AllPlansRemain AS AllPlansRemain
WHERE
	AllPlansRemain.Period &gt; &amp;ActivePeriodStart</query>
	</dataSet>
	<totalField>
		<dataPath>BalancePlansWithFilter</dataPath>
		<expression>Sum(IsNull(BalancePlansWithFilter, 0))</expression>
	</totalField>
