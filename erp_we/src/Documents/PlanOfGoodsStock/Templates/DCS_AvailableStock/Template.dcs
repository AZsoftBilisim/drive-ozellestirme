		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE UNDEFINED
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Warehouse REFS Catalog.Warehouses
			AND Purpose = VALUE(Catalog.Assignments.EmptyRef)
			{(Products, Characteristic) IN(
				SELECT
					Filter.Products AS Products,
					Filter.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS Filter
				WHERE
					&amp;FilterByProductSegmentIsUsed = TRUE)}
			{Warehouse.* AS Warehouse}) AS Inventories
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CAST(Calculation.Products AS Catalog.Products) AS Products,
	Calculation.Characteristic AS Characteristic,
	SUM(Calculation.QuantityForShipAction) AS AvailableStock
INTO FreeBalancesAccordingToRegister
FROM
	CalculationOfBalancesForSettingActions AS Calculation
GROUP BY
	Calculation.Products,
	Calculation.Characteristic
HAVING
	SUM(Calculation.QuantityForShipAction) &gt; 0
INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;ActivePeriodStart AS Period,
	Inventories.Products AS Products,
	Inventories.Products.ProductCategory AS ProductCategory,
	Inventories.Products.SalesRank AS SalesRank,
	Inventories.Characteristic AS Characteristic,
	Inventories.AvailableStock AS AvailableStock
FROM
	FreeBalancesAccordingToRegister AS Inventories
WHERE
	Inventories.Products.ItemsType IN(
		VALUE(Enum.ItemsTypes.OwnGoods),
		VALUE(Enum.ItemsTypes.ReusablePackage))</query>
	</dataSet>
	<totalField>
		<dataPath>AvailableStock</dataPath>
		<expression>Sum(IsNull(AvailableStock, 0))</expression>
	</totalField>
