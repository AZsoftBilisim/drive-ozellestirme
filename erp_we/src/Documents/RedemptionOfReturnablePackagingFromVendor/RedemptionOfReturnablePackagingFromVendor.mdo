    <attributes uuid="d0566abc-3742-4fbf-b747-0689e9ba940b">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity (Stock UOM)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار (واحد انبار)</value>
