    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentVendorInvoiceServicesAndAssets.Ref,
	DocumentVendorInvoiceServicesAndAssets.DataVersion,
	DocumentVendorInvoiceServicesAndAssets.DeletionMark,
	DocumentVendorInvoiceServicesAndAssets.Number,
	DocumentVendorInvoiceServicesAndAssets.Date,
	DocumentVendorInvoiceServicesAndAssets.Posted,
	DocumentVendorInvoiceServicesAndAssets.Partner,
	DocumentVendorInvoiceServicesAndAssets.Terms,
	DocumentVendorInvoiceServicesAndAssets.Counterparty,
	DocumentVendorInvoiceServicesAndAssets.Organization,
	DocumentVendorInvoiceServicesAndAssets.Department,
	DocumentVendorInvoiceServicesAndAssets.Currency,
	DocumentVendorInvoiceServicesAndAssets.DocumentAmount,
	DocumentVendorInvoiceServicesAndAssets.Manager,
	DocumentVendorInvoiceServicesAndAssets.PriceIncludesVAT,
	DocumentVendorInvoiceServicesAndAssets.ARAPCurrency,
	DocumentVendorInvoiceServicesAndAssets.Comment,
	DocumentVendorInvoiceServicesAndAssets.PaymentDate,
	DocumentVendorInvoiceServicesAndAssets.PaymentMethod,
	DocumentVendorInvoiceServicesAndAssets.VATTaxation,
	DocumentVendorInvoiceServicesAndAssets.AmountARAP,
	DocumentVendorInvoiceServicesAndAssets.CompanyBankAccount,
	DocumentVendorInvoiceServicesAndAssets.IncomingDocumentNumber,
	DocumentVendorInvoiceServicesAndAssets.IncomingDocumentDate,
	DocumentVendorInvoiceServicesAndAssets.FinancialAccountingGroup,
	DocumentVendorInvoiceServicesAndAssets.BusinessOperation,
	DocumentVendorInvoiceServicesAndAssets.Author,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
FROM
	Document.VendorInvoiceServicesAndAssets AS DocumentVendorInvoiceServicesAndAssets
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentVendorInvoiceServicesAndAssets.Ref)
		LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentVendorInvoiceServicesAndAssets.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.VendorInvoiceServicesAndAssets</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
