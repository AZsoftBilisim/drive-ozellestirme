		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	NestedQuery.Warehouse AS Warehouse,
	MIN(NestedQuery.StoreFormat) AS StoreFormat
INTO TTWarehouses
FROM
	(SELECT
		HistoryOfChangesToStoreFormatsCrossSection.Warehouse AS Warehouse,
		HistoryOfChangesToStoreFormatsCrossSection.StoreFormat AS StoreFormat
	FROM
		InformationRegister.HistoryOfStoreFormatChange.SliceLast(&amp;EndOfPeriod, ) AS HistoryOfChangesToStoreFormatsCrossSection
	{WHERE
		(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat = &amp;FilterStoreFormat),
		(VALUE(Catalog.Warehouses.EmptyRef) = &amp;FilterWarehouse)}
	
	UNION ALL
	
	SELECT
		Warehouses.Ref,
		VALUE(Catalog.StoreFormats.EmptyRef)
	FROM
		Catalog.Warehouses AS Warehouses
	WHERE
		NOT Warehouses.IsFolder
	{WHERE
		(Warehouses.Ref = &amp;FilterWarehouse),
		(VALUE(Catalog.StoreFormats.EmptyRef) = &amp;FilterStoreFormat)}) AS NestedQuery

GROUP BY
	NestedQuery.Warehouse

INDEX BY
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	COUNT(DISTINCT TTWarehouses.Warehouse) AS ThereIsSelectionOfWarehouses
INTO RequestForSelectionByWarehouse
FROM
	TTWarehouses AS TTWarehouses
WHERE
	TTWarehouses.StoreFormat = VALUE(Catalog.StoreFormats.EmptyRef)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTWarehouses.StoreFormat,
	COUNT(DISTINCT TTWarehouses.Warehouse) AS ZoomRatio
INTO FormatCoefficients
FROM
	TTWarehouses AS TTWarehouses
		INNER JOIN RequestForSelectionByWarehouse AS RequestForSelectionByWarehouse
		ON (RequestForSelectionByWarehouse.ThereIsSelectionOfWarehouses = 0)
WHERE
	TTWarehouses.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)

GROUP BY
	TTWarehouses.StoreFormat

UNION ALL

SELECT
	VALUE(Catalog.StoreFormats.EmptyRef),
	1
;

////////////////////////////////////////////////////////////////////////////////
SELECT
		DATEADD(RevenueAndCostOfSalesTurnover.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset) AS Period,
		TTWarehouses.StoreFormat AS StoreFormat,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
		SUM(RevenueAndCostOfSalesTurnover.CountTurnover) AS SalesFactsByCategories,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.SalesRank AS SalesRank,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products AS Products,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Purpose AS Purpose
		INTO TTSalesFacts
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(
				,
				,
				Auto,
				Warehouse IN
					(SELECT
						TTWarehouses.Warehouse
					FROM
						TTWarehouses AS TTWarehouses) {(AccountingDimensionByPartners.Partner = &amp;FilterPartner), (Department = &amp;FilterSalesDivision), (ItemsLocationAttributes.Purpose = &amp;FilterPurpose), ((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS RevenueAndCostOfSalesTurnover
			INNER JOIN TTWarehouses AS TTWarehouses
			ON RevenueAndCostOfSalesTurnover.Warehouse = TTWarehouses.Warehouse
	
	GROUP BY
		DATEADD(RevenueAndCostOfSalesTurnover.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset),
		TTWarehouses.StoreFormat,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Purpose,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.SalesRank,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SalesFacts.Period,
	SalesFacts.ProductCategory,
	SalesFacts.Purpose,
	CASE
		WHEN &amp;UseCalculationBySalesSpeed
			THEN SUM(SalesFacts.SalesFactsByCategories / FormatCoefficients.ZoomRatio) / COUNT(DISTINCT SalesFacts.Products)
		ELSE SUM(SalesFacts.SalesFactsByCategories / FormatCoefficients.ZoomRatio)
	END AS FactOfSalesByCategories,
	ISNULL(ProductRangeSliceLast.SalesRank, SalesFacts.SalesRank) AS SalesRank
FROM
	TTSalesFacts AS SalesFacts
		INNER JOIN FormatCoefficients AS FormatCoefficients
		ON SalesFacts.StoreFormat = FormatCoefficients.StoreFormat
		{LEFT JOIN InformationRegister.ProductRange.SliceLast(&amp;BeginOfPeriod, {(PlanningObject = &amp;FilterStoreFormat)}) AS ProductRangeSliceLast
		ON SalesFacts.Products = ProductRangeSliceLast.Products
			AND SalesFacts.StoreFormat = ProductRangeSliceLast.PlanningObject}

GROUP BY
	SalesFacts.Period,
	SalesFacts.ProductCategory,
	SalesFacts.Purpose,
	ISNULL(ProductRangeSliceLast.SalesRank, SalesFacts.SalesRank)</query>
	</dataSet>
	<totalField>
		<dataPath>FactOfSalesByCategories</dataPath>
		<expression>Sum(IsNull(FactOfSalesByCategories, 0))</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okres</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
			</v8:item>
			<v8:item>
