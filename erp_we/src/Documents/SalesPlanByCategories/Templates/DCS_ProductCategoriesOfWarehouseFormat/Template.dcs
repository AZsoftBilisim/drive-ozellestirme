		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				ELSE FALSE
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	NestedQuery.Warehouse AS Warehouse
INTO Warehouses
FROM
	(SELECT
		HistoryOfChangesToStoreFormatsCrossSection.Warehouse AS Warehouse
	FROM
		InformationRegister.HistoryOfStoreFormatChange.SliceLast(, {(Warehouse = &amp;FilterWarehouse)}) AS HistoryOfChangesToStoreFormatsCrossSection
	{WHERE
		(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat = &amp;FilterStoreFormat)}
	
	UNION ALL
	
	SELECT
		Warehouses.Ref
	FROM
		Catalog.Warehouses AS Warehouses
	WHERE
		NOT Warehouses.IsFolder
	{WHERE
		(Warehouses.Ref = &amp;FilterWarehouse),
		(VALUE(Catalog.StoreFormats.EmptyRef) = &amp;FilterStoreFormat)}) AS NestedQuery

INDEX BY
	Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	RevenueAndCostOfSalesTurnover.CountTurnover AS ProductCategoriesOfWarehouseFormat,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Purpose AS Purpose,
	ISNULL(ProductRange.SalesRank, RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.SalesRank) AS SalesRank
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(
			,
			,
			Auto,
			Warehouse IN
				(SELECT
					Warehouses.Warehouse
				FROM
					Warehouses AS Warehouses) {((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        &amp;FilterByProductSegmentIsUsed = TRUE))}) AS RevenueAndCostOfSalesTurnover
		{LEFT JOIN InformationRegister.ProductRange.SliceLast(, {(PlanningObject = &amp;FilterWarehouse), (PlanningObject = &amp;FilterStoreFormat)}) AS ProductRange
		ON RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products = ProductRange.Products}
WHERE
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory &lt;&gt; VALUE(Catalog.ProductCategories.EmptyRef)</query>
	</dataSet>
	<totalField>
		<dataPath>ProductCategoriesOfWarehouseFormat</dataPath>
		<expression>Sum(ProductCategoriesOfWarehouseFormat)</expression>
	</totalField>
