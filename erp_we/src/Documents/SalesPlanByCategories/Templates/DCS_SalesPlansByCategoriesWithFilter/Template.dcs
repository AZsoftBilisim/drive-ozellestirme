		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanningObject</dataPath>
			<field>PlanningObject</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanProfile</dataPath>
			<field>PlanProfile</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				ELSE UNDEFINED
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CatProducts.ProductCategory AS ProductCategory,
	ProductRange.PlanningObject AS StoreFormat,
	ProductRange.Products AS Products,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END AS Characteristic
	INTO TTProductRequest
FROM
	InformationRegister.ProductRange.SliceLast(
			&amp;OffsetPeriodStart,
			PlanningObject IN
				(SELECT
					T.StoreFormat
				FROM
					AccumulationRegister.SalesPlansByCategories.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, Scenario = &amp;Scenario
						AND StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
						AND Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
						AND SalesPlanByCategories &lt;&gt; &amp;Ref) AS T) {(Products) AS Products}) AS ProductRange
		INNER JOIN Catalog.Products AS CatProducts
		ON (CatProducts.ProductCategory &lt;&gt; VALUE(Catalog.ProductCategories.EmptyRef))
			AND ProductRange.Products = CatProducts.Ref
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON CASE
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatProducts.Ref
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatProducts.ItemVariantsOwner
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatProducts.ProductKind
				ELSE UNDEFINED
			END = ItemsCharacteristics.Owner
{WHERE
	(CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END).* AS Characteristic}

INDEX BY
	ProductCategory,
	StoreFormat
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BEGINOFPERIOD(DATEADD(SalesPlansByCategoryTurnover.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset), &amp;PeriodString) AS Period,
	SalesPlansByCategoryTurnover.SalesPlanByCategories AS Document,
	SalesPlansByCategoryTurnover.ProductCategory,
	CatProducts.Ref AS Products,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END AS Characteristic,
	SalesPlansByCategoryTurnover.CountTurnover AS SalesPlansByCategoriesWithFilter,
	DocSalesPlan.Number AS DocumentNumber,
	DocSalesPlan.Date AS DocumentDate,
	SalesPlansByCategoryTurnover.Purpose AS Purpose
FROM
	AccumulationRegister.SalesPlansByCategories.Turnovers(
			,
			,
			Auto,
			Scenario = &amp;Scenario AND Status IN (&amp;ScenarioStatuses)
				AND StoreFormat = VALUE(Catalog.StoreFormats.EmptyRef)
				AND SalesPlanByCategories &lt;&gt; &amp;Ref {(StoreFormat = &amp;FilterStoreFormat), (Warehouse = &amp;FilterWarehouse), (Department = &amp;FilterSalesDivision), (Purpose = &amp;FilterPurpose)}) AS SalesPlansByCategoryTurnover
		{LEFT JOIN Document.SalesPlanByCategories AS DocSalesPlan
		ON SalesPlansByCategoryTurnover.SalesPlanByCategories = DocSalesPlan.Ref}
		{INNER JOIN Catalog.Products AS CatProducts
			ON SalesPlansByCategoryTurnover.ProductCategory = CatProducts.ProductCategory}
		{LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON CASE
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatProducts.Ref
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatProducts.ItemVariantsOwner
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatProducts.ProductKind
				ELSE UNDEFINED
			END = ItemsCharacteristics.Owner}

{WHERE
	CatProducts.Ref.* AS Products,
	(CASE
			WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			ELSE ItemsCharacteristics.Ref
		END).* AS Characteristic}

UNION

SELECT
	BEGINOFPERIOD(DATEADD(SalesPlansByCategoryTurnover.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset), &amp;PeriodString),
	SalesPlansByCategoryTurnover.SalesPlanByCategories,
	SalesPlansByCategoryTurnover.ProductCategory,
	RequestingProducts.Products,
	RequestingProducts.Characteristic,
	SalesPlansByCategoryTurnover.CountTurnover,
	DocSalesPlan.Number,
	DocSalesPlan.Date,
	SalesPlansByCategoryTurnover.Purpose
FROM
	AccumulationRegister.SalesPlansByCategories.Turnovers(
			,
			,
			Auto,
			Scenario = &amp;Scenario
				AND StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
				AND Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
				AND SalesPlanByCategories &lt;&gt; &amp;Ref {(StoreFormat = &amp;FilterStoreFormat), (Department = &amp;FilterSalesDivision), (Purpose = &amp;FilterPurpose)}) AS SalesPlansByCategoryTurnover
		{LEFT JOIN Document.SalesPlanByCategories AS DocSalesPlan
		ON SalesPlansByCategoryTurnover.SalesPlanByCategories = DocSalesPlan.Ref}
		{INNER JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(&amp;BeginOfPeriod, {(Warehouse = &amp;FilterWarehouse)}) AS HistoryOfChangesToStoreFormatsCrossSection
		ON SalesPlansByCategoryTurnover.StoreFormat = HistoryOfChangesToStoreFormatsCrossSection.StoreFormat}
		{INNER JOIN TTProductRequest AS RequestingProducts
		ON SalesPlansByCategoryTurnover.ProductCategory = RequestingProducts.ProductCategory
			AND SalesPlansByCategoryTurnover.StoreFormat = RequestingProducts.StoreFormat}
		INNER JOIN Constant.UseProductRange AS UseProductRange
		ON (UseProductRange.Value)
{WHERE
	(HistoryOfChangesToStoreFormatsCrossSection.Warehouse = &amp;FilterWarehouse)}

UNION ALL

SELECT
	BEGINOFPERIOD(DATEADD(SalesPlansByCategoryTurnover.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset), &amp;PeriodString),
	SalesPlansByCategoryTurnover.SalesPlanByCategories,
	SalesPlansByCategoryTurnover.ProductCategory,
	CatProducts.Ref AS Products,
	CASE
		WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		ELSE ItemsCharacteristics.Ref
	END AS Characteristic,
	SalesPlansByCategoryTurnover.CountTurnover,
	DocSalesPlan.Number,
	DocSalesPlan.Date,
	SalesPlansByCategoryTurnover.Purpose
FROM
	AccumulationRegister.SalesPlansByCategories.Turnovers(
			,
			,
			Auto,
			Scenario = &amp;Scenario
				AND StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
				AND Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
				AND SalesPlanByCategories &lt;&gt; &amp;Ref {(StoreFormat = &amp;FilterStoreFormat), (Department = &amp;FilterSalesDivision), (Purpose = &amp;FilterPurpose)}) AS SalesPlansByCategoryTurnover
		{LEFT JOIN Document.SalesPlanByCategories AS DocSalesPlan
		ON SalesPlansByCategoryTurnover.SalesPlanByCategories = DocSalesPlan.Ref}
		{INNER JOIN Catalog.Products AS CatProducts
		ON SalesPlansByCategoryTurnover.ProductCategory = CatProducts.ProductCategory}
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON CASE
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatProducts.Ref
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatProducts.ItemVariantsOwner
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatProducts.ProductKind
				ELSE UNDEFINED
			END = ItemsCharacteristics.Owner
		INNER JOIN Constant.UseProductRange AS UseProductRange
		ON (NOT UseProductRange.Value)
{WHERE
	CatProducts.Ref.* AS Products,
	(CASE
			WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			ELSE ItemsCharacteristics.Ref
		END).* AS Characteristic}</query>
	</dataSet>
	<totalField>
		<dataPath>SalesPlansByCategoriesWithFilter</dataPath>
		<expression>Sum(IsNull(SalesPlansByCategoriesWithFilter, 0)) </expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
