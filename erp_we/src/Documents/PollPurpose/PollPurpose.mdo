  <attributes uuid="1c93fcd3-53a1-403f-a30b-454fbc941d55">
    <name>AllowSavingQuestionnaireDraft</name>
    <synonym>
      <key>en</key>
      <value>Allow questionnaire drafts</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>اجازه پیش‌نویس پرسشنامه</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Possibilità di salvataggio preventivo</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Możliwość wstępnego zapisu</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Возможность предварительного сохранения</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Önceden kayıt imkanı</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Có thể lưu trước</value>
