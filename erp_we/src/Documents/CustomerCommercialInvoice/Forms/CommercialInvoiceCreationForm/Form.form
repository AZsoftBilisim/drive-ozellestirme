    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CustomerCommercialInvoice.Ref                       AS Ref,
	CustomerCommercialInvoice.DeletionMark              AS DeletionMark,
	CustomerCommercialInvoice.Number                        AS Number,
	CustomerCommercialInvoice.Date                         AS Date,
	CustomerCommercialInvoice.Posted                     AS Posted,
	CustomerCommercialInvoice.Organization                  AS Organization,
	CustomerCommercialInvoice.DocumentBasis.Partner    AS Partner,
	CustomerCommercialInvoice.DocumentBasis.Counterparty AS Counterparty,
	CustomerCommercialInvoice.Currency                       AS Currency,
	CustomerCommercialInvoice.DocumentBasis            AS DocumentBasis,
	CustomerCommercialInvoice.PaymentMethod                  AS PaymentMethod,
	CustomerCommercialInvoice.BankAccount               AS BankAccount,
	CustomerCommercialInvoice.CashAccount                        AS CashAccount,
	CustomerCommercialInvoice.AdditionalInformation     AS AdditionalInformation,
	CustomerCommercialInvoice.PartialPayment              AS PartialPayment,
	CustomerCommercialInvoice.Canceled_                  AS Canceled_,
	CustomerCommercialInvoice.DocumentAmount               AS DocumentAmount,
	CASE
		// Not carried out
		WHEN
			NOT CustomerCommercialInvoice.Posted
		THEN
			&quot;&quot;
		// Valid
		WHEN
			NOT CustomerCommercialInvoice.Canceled_
		THEN
			&quot;Issued&quot;
		// Canceled_
		WHEN
			CustomerCommercialInvoice.Canceled_
		THEN
			&quot;Canceled_&quot;

	END AS State
FROM
	Document.CustomerCommercialInvoice AS CustomerCommercialInvoice
</queryText>
      <mainTable>Document.CustomerCommercialInvoice</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
