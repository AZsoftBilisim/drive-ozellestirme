  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	CustomerCommercialInvoice.Ref                       AS Ref,
	CustomerCommercialInvoice.DeletionMark              AS DeletionMark,
	CustomerCommercialInvoice.Number                        AS Number,
	CustomerCommercialInvoice.Date                         AS Date,
	CustomerCommercialInvoice.Posted                     AS Posted,
	CustomerCommercialInvoice.Organization                  AS Organization,
	CustomerCommercialInvoice.Partner                      AS Partner,
	CustomerCommercialInvoice.Counterparty                   AS Counterparty,
	CustomerCommercialInvoice.Contract                      AS Contract,
	CustomerCommercialInvoice.DocumentBasis.SalesOpportunity     AS SalesOpportunity,
	CustomerCommercialInvoice.Currency                       AS Currency,
	CustomerCommercialInvoice.DocumentBasis            AS DocumentBasis,
	CustomerCommercialInvoice.PaymentMethod                  AS PaymentMethod,
	CustomerCommercialInvoice.BankAccount               AS BankAccount,
	CustomerCommercialInvoice.CashAccount                        AS CashAccount,
	CustomerCommercialInvoice.AdditionalInformation     AS AdditionalInformation,
	CustomerCommercialInvoice.PartialPayment              AS PartialPayment,
	CustomerCommercialInvoice.Canceled_                  AS Canceled_,
	CustomerCommercialInvoice.DocumentAmount               AS DocumentAmount,
	CustomerCommercialInvoice.Comment                  AS Comment,
	CustomerCommercialInvoice.Author                        AS Author,
	CASE
		// Not carried out
		WHEN
			NOT CustomerCommercialInvoice.Posted
		THEN
			VALUE(Enum.CustomerCommercialInvoiceStatuses.EmptyRef)
		// Issued
		WHEN
			NOT CustomerCommercialInvoice.Canceled_
		THEN
			VALUE(Enum.CustomerCommercialInvoiceStatuses.Issued)
		// Canceled_
		WHEN
			CustomerCommercialInvoice.Canceled_
		THEN
			VALUE(Enum.CustomerCommercialInvoiceStatuses.Canceled_)

	END AS State,
	EDStates.EDIState,
	EDStates.StatusPresentation

FROM
	Document.CustomerCommercialInvoice AS CustomerCommercialInvoice
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = CustomerCommercialInvoice.Ref)</queryText>
