  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Defer</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CashRegisterReceipts.Ref AS Ref,
	CashRegisterReceipts.DeletionMark AS DeletionMark,
	CashRegisterReceipts.Number AS Number,
	CashRegisterReceipts.Date AS Date,
	CashRegisterReceipts.Posted AS Posted,
	CashRegisterReceipts.Currency AS Currency,
	CashRegisterReceipts.CashRegister AS CashRegister,
	CashRegisterReceipts.Cashier AS Cashier,
	CashRegisterReceipts.Comment AS Comment,
	FiscalTransactions.CashRegisterReceiptNumber AS CashRegisterReceiptNumber,
	CashRegisterReceipts.Organization AS Organization,
	CashRegisterReceipts.ReceivedInCash AS ReceivedInCash,
	CashRegisterReceipts.Status AS Status,
	CashRegisterReceipts.DocumentAmount AS DocumentAmount,
	CASE
		WHEN CashRegisterReceipts.Status &lt;> VALUE(Enum.CashRegisterReceiptStatuses.ReceiptIsIssued_)
			THEN TRUE
		ELSE FALSE
	END AS Defer
FROM
	Document.GiftCertificateSale AS CashRegisterReceipts
		LEFT JOIN InformationRegister.FiscalTransactions AS FiscalTransactions
		ON CashRegisterReceipts.Ref = FiscalTransactions.DocumentBasis</queryText>
      <mainTable>Document.GiftCertificateSale</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>VATTaxation</dataPath>
        <field>VATTaxation</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CashRegisterShift</dataPath>
        <field>CashRegisterShift</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>GiftCertificates</dataPath>
        <field>GiftCertificates</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Organization</dataPath>
        <field>Organization</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CashRegisterReceiptNumber</dataPath>
