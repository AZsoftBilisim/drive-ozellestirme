            </content>
            <content>
              <key>it</key>
              <value>Stato di approvvigionamento</value>
            </content>
            <content>
              <key>pl</key>
              <value>Status zaopatrzenia</value>
            </content>
            <content>
              <key>ru</key>
              <value>Состояние обеспечения</value>
            </content>
            <content>
              <key>tr</key>
              <value>Tedarik durumu</value>
            </content>
            <content>
              <key>vi</key>
              <value>Trạng thái đảm bảo</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ProductionStart</dataPath>
        <field>ProductionStart</field>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Production start</value>
            </content>
            <content>
              <key>fa</key>
              <value>شروع تولید</value>
            </content>
            <content>
              <key>it</key>
              <value>Inizio della produzione</value>
            </content>
