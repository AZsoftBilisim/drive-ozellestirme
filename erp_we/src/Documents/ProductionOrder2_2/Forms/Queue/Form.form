    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Priority</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.PriorityQueue</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Queue</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	
	Table.Ref AS Ref,
	Table.Number AS Number,
	Table.Date AS Date,
	
	Table.Status AS Status,
	Table.Priority AS Priority,
	Table.Department AS Department,

	Table.EarliestStartDate AS ProductionStart,
	Table.DemandDate AS DemandDate,
	
	Table.DynamicStructure AS DynamicStructure,
	
	DATETIME(1,1,1) AS EventDate,
	FALSE AS Overdue,
	
	FALSE AS SupplyState,
	-1 AS StatusOfProductionStagesAndSchedule,
	-1 AS ProductReleaseStatus,
	
	-1 AS PriorityQueue,
	-1 AS DivisionQueue,
	-1 AS Queue,

	Table.EmployeeResponsible AS EmployeeResponsible,
	Table.Comment   AS Comment

FROM
	Document.ProductionOrder2_2 AS Table

		{LEFT JOIN InformationRegister.StatesOfProductionOrders AS StatesOfProductionOrders
		ON Table.Ref = StatesOfProductionOrders.OrderDocument}
			 
WHERE 
	Table.Status = VALUE(Enum.ProductionOrderStatuses2_2.ToProduce)
	AND Table.Posted</queryText>
      <mainTable>Document.ProductionOrder2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>AssignmentProducts</dataPath>
        <field>AssignmentProducts</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>SupplyState</dataPath>
        <field>SupplyState</field>
        <title>
          <localValue>
