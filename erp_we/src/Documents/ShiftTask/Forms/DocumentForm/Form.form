    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationsRegister.ExecutionTimeUnitOfMeasure</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationsRegister.Operation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationsRegister.PresentationStage</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationsRegister.ProductionOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OperationsRegister.Stage</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	OperationsOverridable.Department            AS Department,
	OperationsOverridable.Stage                     AS Stage,
	OperationsOverridable.Operation                 AS Operation,
	OperationsOverridable.OperationID    AS OperationID,
	OperationsOverridable.ShiftTask           AS ShiftTask,
	OperationsOverridable.Performer              AS Performer,
	ISNULL(OperationsOverridable.Operation.ProductionArea, VALUE(Catalog.ProductionSites.EmptyRef)) AS ProductionArea,
	OperationsOverridable.WorkCenter             AS WorkCenter,
	OperationsOverridable.WorkCenterType        AS WorkCenterType,
	OperationsOverridable.AssignNotEarlierThan         AS AssignNotEarlierThan,
	OperationsOverridable.Count               AS Count,
	QueueOverridable.ProductionOperation  AS ProductionOperation,
	ISNULL(OperationsOverridable.Operation.Description, QueueOverridable.ProductionOperation.Description) AS Description,
	ISNULL(OperationsOverridable.Operation.UnitOfMeasure, QueueOverridable.ProductionOperation.UnitOfMeasure) AS UnitOfMeasure,
	&amp;RunTime                                  AS RunTime,
	OperationsOverridable.TimeUnitsOfMeasure               AS ExecutionTimeUnitOfMeasure,
	OperationsOverridable.AssignmentProcedureIsViolated AS AssignmentProcedureIsViolated,
	OperationsOverridable.ReferenceOrder             AS ReferenceOrder,
	OperationsOverridable.OperationNumber            AS OperationNumber,
	OperationsOverridable.NextOperation   AS NextOperation,
	OperationsOverridable.Order                  AS Order,
	&amp;PresentationStage                               AS PresentationStage
FROM
	InformationRegister.OperationsToCreateShiftTasks AS OperationsOverridable
	LEFT JOIN InformationRegister.QueueOfProductionOperations AS QueueOverridable
	ON OperationsOverridable.Stage = QueueOverridable.Stage
	AND OperationsOverridable.OperationID = QueueOverridable.OperationID
	AND OperationsOverridable.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
	AND QueueOverridable.MainEntry_</queryText>
      <mainTable>InformationRegister.OperationsToCreateShiftTasks</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
