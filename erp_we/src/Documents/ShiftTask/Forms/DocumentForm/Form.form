    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	OperationsOverridable.Ref AS Ref,
	OperationsOverridable.DeletionMark AS DeletionMark,
	OperationsOverridable.Number AS Number,
	OperationsOverridable.Date AS Date,
	OperationsOverridable.Posted AS Posted,
	OperationsOverridable.Stage AS Stage,
	OperationsOverridable.Operation AS Operation,
	OperationsOverridable.OperationID AS OperationID,
	OperationsOverridable.Status AS Status,
	OperationsOverridable.Department AS Department,
	OperationsOverridable.Performer AS Performer,
	CASE
		WHEN OperationsOverridable.WorkCenter REFS Catalog.WorkCenterTypes
			THEN OperationsOverridable.WorkCenter
		ELSE
			OperationsOverridable.WorkCenter.WorkCenterType
	END AS WorkCenterType,
	CASE
		WHEN OperationsOverridable.WorkCenter REFS Catalog.WorkCenters
			THEN OperationsOverridable.WorkCenter
		ELSE
			VALUE(Catalog.WorkCenters.EmptyRef)
	END AS WorkCenter,
	OperationsOverridable.SetupSettings AS SetupSettings,
	OperationsOverridable.Count - OperationsOverridable.CountCanceled AS Count,
	OperationsOverridable.FollowUp  AS FollowUp,
	OperationsOverridable.QuantityUnderRevision AS QuantityUnderRevision,
	OperationsOverridable.DefectiveGoodsCount AS DefectiveGoodsCount,
	OperationsOverridable.CountReal AS CountReal,
	OperationsOverridable.RunTime AS RunTime,
	OperationsOverridable.ExecutionTimeUnitOfMeasure AS ExecutionTimeUnitOfMeasure,
	OperationsOverridable.EmployeeResponsible AS EmployeeResponsible,
	OperationsOverridable.Comment AS Comment,
	OperationsOverridable.ExecutionEnd AS ExecutionEnd,
	OperationsOverridable.StageOperationNumber AS StageOperationNumber,
	OperationsOverridable.LotNumber AS LotNumber,
	OperationsOverridable.BasedOnPlanning AS BasedOnPlanning,
	OperationsOverridable.BasedOnMasterData AS BasedOnMasterData,
	OperationsOverridable.ShiftTask AS ShiftTask,
	OperationsOverridable.Description AS Description,
	OperationsOverridable.RepetitionIsRequired AS RepetitionIsRequired,
	OperationsOverridable.Skippable AS Skippable,
	OperationsOverridable.Control AS Control,
	&amp;PresentationStage AS PresentationStage
FROM
	Document.ProductionOperation2_2 AS OperationsOverridable</queryText>
