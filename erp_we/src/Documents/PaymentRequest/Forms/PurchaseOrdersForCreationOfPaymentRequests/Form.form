  <attributes>
    <name>OrderList</name>
    <title>
      <key>en</key>
      <value>Order list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست سفارش‌ها</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco degli ordini</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista zamówień</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список заказов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Sipariş listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách đơn hàng</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>OrderList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentData.Ref,
	DocumentData.Date,
	DocumentData.Number,
	DocumentData.Currency,
	DocumentData.Partner,
	DocumentData.Counterparty,
	DocumentData.Organization,
	DocumentData.Manager,
	DocumentData.Priority,
	DocumentData.Status,
	DocumentData.DocumentAmount,
	CASE
		WHEN DocumentData.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentData.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	
	CASE
		WHEN DocumentData.Posted
			AND ISNULL(-VendorsARAPAccounting.AmountDueBalance, 0) - ISNULL(-VendorsARAPAccounting.BeingPaidBalance, 0) > 0
	THEN
		TRUE
	ELSE
		FALSE
	END YouNeedToCreateARequest,
	
	CASE
		WHEN ISNULL(-VendorsARAPAccounting.AmountDueBalance, 0) - ISNULL(-VendorsARAPAccounting.BeingPaidBalance, 0) > 0 THEN
			ISNULL(-VendorsARAPAccounting.AmountDueBalance, 0) - ISNULL(-VendorsARAPAccounting.BeingPaidBalance, 0)
		ELSE
			0
	END AS AmountOnRequest
	
FROM
	Document.PurchaseOrder AS DocumentData
	
	LEFT JOIN
		AccumulationRegister.VendorsARAPAccounting.Balance(&amp;PaymentDate,) AS VendorsARAPAccounting
	ON
		DocumentData.Ref = VendorsARAPAccounting.ARAPObject.Object
		
WHERE
	DocumentData.Posted
	AND DocumentData.ARAPObjectSettings IN (VALUE(Enum.ARAPObjectSettings.ByOrders),VALUE(Enum.ARAPObjectSettings.OrderForPrepaymentInvoiceForInvoice))
	</queryText>
      <mainTable>Document.PurchaseOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
