  <attributes>
    <name>List</name>
    <id>6</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Request.Ref,
	Request.DeletionMark,
	Request.Number,
	Request.Date,
	Request.Posted,
	Request.Organization AS Organization,
	Request.Status,
	Request.BusinessOperation,
	Request.DocumentAmount,
	Request.Currency,
	Request.PaymentDate,
	CASE
		WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
			THEN Request.AdvanceHolder
		ELSE Request.Counterparty
	END AS Recipient,
	CASE WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
		AND Request.Posted
		AND Request.Status &lt;> VALUE(Enum.StatusesOfPaymentRequests.IsRejected)
	THEN
		TRUE
	ELSE
		FALSE
	END AS RequestIsPaid,
	EDStates.EDIState,
	CAST(&amp;UsePaymentsToSelfEmployedPersons AS BOOLEAN) AS UsePaymentsToSelfEmployedPersons
FROM
	Document.PaymentRequest AS Request
		LEFT JOIN AccumulationRegister.CashToBePaid.Balance AS Cash
		ON (Cash.PaymentRequest = Request.Ref)
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = Request.Ref)</queryText>
      <mainTable>Document.PaymentRequest</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
