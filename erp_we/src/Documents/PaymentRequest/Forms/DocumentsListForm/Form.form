  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Closed_</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.MethodOfPaymentPaymentCard</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.PaymentMethodBankAccount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.PaymentMethodCash</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.PayrollTransaction</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Posted</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.RequestIsPaid</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Request.Ref AS Ref,
	Request.DeletionMark AS DeletionMark,
	Request.Number AS Number,
	Request.Date AS Date,
	Request.Posted AS Posted,
	Request.Organization AS Organization,
	Request.Status AS Status,
	CASE
		WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.SalaryPayment)
			THEN Request.PayrollTransaction
		ELSE Request.BusinessOperation
	END AS BusinessOperation,
	Request.PayrollTransaction AS PayrollTransaction,
	Request.DocumentAmount AS DocumentAmount,
	Request.Currency AS Currency,
	Request.BankAccount AS BankAccount,
	Request.CashAccount AS CashAccount,
	Request.RequiredPaymentDate AS PaymentDate,
	
	CASE WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder) THEN
		Request.AdvanceHolder
	WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.CashPaymentToAnotherCompany)
		OR Request.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToAnotherCompany)
		OR Request.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices)
	THEN
		Request.CompanyRecipient
	ELSE
		Request.Counterparty
	END AS Recipient,
	
	Request.Counterparty AS Counterparty,
	Request.Department AS Department,
	Request.WhoStated AS Applicant,
	Request.Presentation AS Presentation,
	Request.PaymentPriority AS PaymentPriority,
	Request.OverLimits AS OverLimits,
	Request.Author AS Author,
	CASE
		WHEN Request.PaymentPriority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.PaymentPriorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN Request.PaymentPriority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.PaymentPriorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	
	CASE WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
		AND Request.Posted
		AND Request.Status &lt;> VALUE(Enum.StatusesOfPaymentRequests.IsRejected)
	THEN
		TRUE
	ELSE
		FALSE
	END AS RequestIsPaid,
	
	CASE
		WHEN WhetherFilesAreAttached.HasFiles IS NULL THEN
			1
		WHEN WhetherFilesAreAttached.HasFiles THEN
			0
		ELSE
			1
	END AS HasFiles,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	Request.Closed_ AS Closed_,	
	Request.PaymentMethodCash AS PaymentMethodCash,
	Request.PaymentMethodBankAccount AS PaymentMethodBankAccount,
	Request.MethodOfPaymentPaymentCard AS MethodOfPaymentPaymentCard
FROM
	Document.PaymentRequest AS Request
	
	LEFT JOIN
		AccumulationRegister.CashToBePaid.Balance AS Cash
	ON 
		Cash.PaymentRequest = Request.Ref

	LEFT JOIN
		InformationRegister.FilesExist AS WhetherFilesAreAttached
	ON
		Request.Ref = WhetherFilesAreAttached.ObjectWithFiles
	
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
	ON (EDStates.ObjectReference = Request.Ref)	
</queryText>
      <mainTable>Document.PaymentRequest</mainTable>
