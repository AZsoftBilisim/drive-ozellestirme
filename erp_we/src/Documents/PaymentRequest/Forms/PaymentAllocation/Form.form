    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InformationRegisterScheduleOfPayments.PaymentObject,
	InformationRegisterScheduleOfPayments.BankAccountCashAccount,
	VALUETYPE(InformationRegisterScheduleOfPayments.BankAccountCashAccount) AS TypeOfPaymentLocation,
	InformationRegisterScheduleOfPayments.PaymentDate,
	InformationRegisterScheduleOfPayments.Currency,
	InformationRegisterScheduleOfPayments.Sum
FROM
	InformationRegister.ScheduleOfPayments AS InformationRegisterScheduleOfPayments</queryText>
      <mainTable>InformationRegister.ScheduleOfPayments</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
