  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Request.Ref,
	Request.DeletionMark,
	Request.Number,
	Request.Date,
	Request.Posted,
	Request.Organization AS Organization,
	Request.Status,
	Request.BusinessOperation,
	Request.DocumentAmount,
	Request.Currency,
	Request.BankAccount,
	Request.CashAccount,
	CASE WHEN Request.PaymentMethodOfPaymentRequest = VALUE(Enum.PaymentForms.EmptyRef) THEN
		&amp;TheStringFormOfPayment
	ELSE
		Request.PaymentMethodOfPaymentRequest
	END AS PaymentMethod,
	Request.PaymentDate AS PayDate,
	
	CASE WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder) THEN
		Request.AdvanceHolder
	WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.CashPaymentToAnotherCompany)
		OR Request.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToAnotherCompany)
		OR Request.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices)
	THEN
		Request.CompanyRecipient
	ELSE
		Request.Counterparty
	END AS Recipient,
	
	Request.Counterparty,
	Request.Department,
	Request.WhoStated AS Applicant,
	Request.Presentation,
	Request.PaymentPriority,
	Request.Author,
	CASE
		WHEN Request.PaymentPriority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.PaymentPriorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN Request.PaymentPriority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.PaymentPriorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	
	CASE WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
		AND Request.Posted
		AND Request.Status &lt;> VALUE(Enum.StatusesOfPaymentRequests.IsRejected)
	THEN
		TRUE
	ELSE
		FALSE
	END AS RequestIsPaid
FROM
	Document.PaymentRequest AS Request
	
	LEFT JOIN
		AccumulationRegister.CashToBePaid.Balance AS Cash
	ON
		Cash.PaymentRequest = Request.Ref</queryText>
      <mainTable>Document.PaymentRequest</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
