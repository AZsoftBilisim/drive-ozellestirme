  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RequestOverridable.Ref AS Ref,
	RequestOverridable.DeletionMark AS DeletionMark,
	RequestOverridable.Number AS Number,
	RequestOverridable.Date AS Date,
	RequestOverridable.Posted AS Posted,
	RequestOverridable.Organization AS Organization,
	RequestOverridable.Status AS Status,
	RequestOverridable.BusinessOperation AS BusinessOperation,
	RequestOverridable.PayrollTransaction AS PayrollTransaction,
	RequestOverridable.DocumentAmount AS DocumentAmount,
	RequestOverridable.Currency AS Currency,
	RequestOverridable.PaymentDate AS PaymentDate,
	
	CASE WHEN RequestOverridable.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder) THEN
		RequestOverridable.AdvanceHolder
	ELSE
		RequestOverridable.Counterparty
	END AS Recipient,

	RequestOverridable.Counterparty AS Counterparty,
	RequestOverridable.Department AS Department,
	RequestOverridable.WhoStated AS WhoStated,
	RequestOverridable.PaymentPriority AS PaymentPriority
FROM
	Document.PaymentRequest AS RequestOverridable</queryText>
      <mainTable>Document.PaymentRequest</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
