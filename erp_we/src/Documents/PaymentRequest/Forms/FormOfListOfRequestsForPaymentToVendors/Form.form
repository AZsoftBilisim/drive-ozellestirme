  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Request.Ref,
	Request.DeletionMark,
	Request.Number,
	Request.Date,
	Request.Posted,
	Request.Organization AS Organization,
	Request.Status,
	Request.BusinessOperation,
	Request.DocumentAmount,
	Request.Currency,
	Request.PaymentDate,
	Request.Author,
	CASE
		WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
			THEN Request.AdvanceHolder
		ELSE Request.Counterparty
	END AS Recipient,
	CASE
		WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
				AND Request.Posted
			THEN TRUE
		ELSE FALSE
	END AS RequestIsPaid,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.PaymentRequest AS Request
		LEFT JOIN AccumulationRegister.CashToBePaid.Balance AS Cash
		ON (Cash.PaymentRequest = Request.Ref)
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = Request.Ref)</queryText>
      <mainTable>Document.PaymentRequest</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PaymentMethodCash</dataPath>
        <field>PaymentMethodCash</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>MethodOfPaymentPaymentCard</dataPath>
        <field>MethodOfPaymentPaymentCard</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PaymentMethodBankAccount</dataPath>
        <field>PaymentMethodBankAccount</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Partner</dataPath>
        <field>Partner</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PaysheetDate</dataPath>
        <field>PaysheetDate</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>AdditionalAttributes</dataPath>
        <field>AdditionalAttributes</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>BankAccount</dataPath>
        <field>BankAccount</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Department</dataPath>
        <field>Department</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CashAccount</dataPath>
        <field>CashAccount</field>
