    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	GoodsToBeRegisteredInReportsToConsignorBalance.DocumentSales AS Ref,
	VALUETYPE(GoodsToBeRegisteredInReportsToConsignorBalance.DocumentSales) AS DocumentSales,
	GoodsToBeRegisteredInReportsToConsignorBalance.InventoryOwnerAttribute.GoodsOwner AS GoodsOwner,
	GoodsToBeRegisteredInReportsToConsignorBalance.InventoryOwnerAttribute.Terms AS Terms,
	GoodsToBeRegisteredInReportsToConsignorBalance.InventoryOwnerAttribute.Contract AS Contract,
	GoodsToBeRegisteredInReportsToConsignorBalance.RevenueAmountBalance AS RevenueAmount,
	CASE
		WHEN GoodsToBeRegisteredInReportsToConsignorBalance.DocumentSales &lt;> UNDEFINED
			AND EDStates.StatusPresentation IS NULL
		THEN &amp;StateNotStarted
	ELSE EDStates.StatusPresentation
	END AS StatusPresentation

FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.Balance(
			,
			InventoryOwnerAttribute.Contract = &amp;Contract
				AND InventoryOwnerAttribute.Terms = &amp;Terms) AS GoodsToBeRegisteredInReportsToConsignorBalance
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
	ON GoodsToBeRegisteredInReportsToConsignorBalance.DocumentSales = EDStates.ObjectReference
	
WHERE
	GoodsToBeRegisteredInReportsToConsignorBalance.CountBalance > 0
	AND NOT GoodsToBeRegisteredInReportsToConsignorBalance.DocumentSales = VALUE(Document.CustomerInvoice.EmptyRef)

UNION ALL

SELECT
	ServicesForRegistrationOfReportsToPrincipalBalance.DocumentSales,
	VALUETYPE(ServicesForRegistrationOfReportsToPrincipalBalance.DocumentSales),
	ServicesForRegistrationOfReportsToPrincipalBalance.ItemsLocationAttributes.StorageLocation,
	ServicesForRegistrationOfReportsToPrincipalBalance.Terms,
	ServicesForRegistrationOfReportsToPrincipalBalance.ItemsLocationAttributes.Contract,
	ServicesForRegistrationOfReportsToPrincipalBalance.RevenueAmountBalance,
	CASE
		WHEN ServicesForRegistrationOfReportsToPrincipalBalance.DocumentSales &lt;> UNDEFINED
			AND EDStates.StatusPresentation IS NULL
		THEN &amp;StateNotStarted
	ELSE EDStates.StatusPresentation
	END AS StatusPresentation

FROM
	AccumulationRegister.ServicesForRegistrationOfReportsToPrincipal.Balance(, Terms = &amp;Terms) AS ServicesForRegistrationOfReportsToPrincipalBalance
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON ServicesForRegistrationOfReportsToPrincipalBalance.DocumentSales = EDStates.ObjectReference
WHERE
	ServicesForRegistrationOfReportsToPrincipalBalance.CountBalance > 0
	AND NOT ServicesForRegistrationOfReportsToPrincipalBalance.DocumentSales = VALUE(Document.CustomerInvoice.EmptyRef)</queryText>
