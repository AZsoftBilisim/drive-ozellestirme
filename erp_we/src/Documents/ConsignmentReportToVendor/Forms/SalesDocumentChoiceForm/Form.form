    </title>
    <title>
      <key>tr</key>
      <value>Belge listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
