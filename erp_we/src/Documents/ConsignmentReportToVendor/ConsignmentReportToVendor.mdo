    <attributes uuid="e32c8c47-e413-43c2-9d82-fdc0878bb46e">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
