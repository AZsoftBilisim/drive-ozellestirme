      <parameters>
        <name>NonFinancialItem</name>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Non-financial item</value>
            </content>
            <content>
              <key>fa</key>
              <value>قلم غیرمالی</value>
            </content>
            <content>
              <key>it</key>
              <value>Indicatore non finanziario</value>
            </content>
            <content>
              <key>pl</key>
              <value>Wskaźnik niefinansowany</value>
            </content>
            <content>
              <key>ru</key>
              <value>Нефинансовый показатель</value>
            </content>
            <content>
