  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentSetValuesForNonFinancialItems.Ref,
	DocumentSetValuesForNonFinancialItems.DeletionMark,
	DocumentSetValuesForNonFinancialItems.Number,
	DocumentSetValuesForNonFinancialItems.Date,
	DocumentSetValuesForNonFinancialItems.Posted,
	DocumentSetValuesForNonFinancialItems.PeriodPresentation,
	DocumentSetValuesForNonFinancialItems.EmployeeResponsible,
	DocumentSetValuesForNonFinancialItems.Comment,
	DocumentSetValuesForNonFinancialItems.OperationKind,
	DocumentSetValuesForNonFinancialItems.InputTemplate,
	DocumentSetValuesForNonFinancialItems.PointInTime
FROM
	Document.SetValuesForNonFinancialItems AS DocumentSetValuesForNonFinancialItems
WHERE
	(DocumentSetValuesForNonFinancialItems.NonFinancialItem = &amp;NonFinancialItem
			OR DocumentSetValuesForNonFinancialItems.InputTemplate IN
				(SELECT DISTINCT
					Filter.Ref
				FROM
					Catalog.NonFinancialItemProfiles.TemplateIndicators AS Filter
				WHERE
					Filter.Factor = &amp;NonFinancialItem))</queryText>
      <mainTable>Document.SetValuesForNonFinancialItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
