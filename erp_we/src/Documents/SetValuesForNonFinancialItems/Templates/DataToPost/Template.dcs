			<field>SubperiodNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ValuePresence</dataPath>
			<field>ValuePresence</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Value presence</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>وجود مقدار</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Presenza di valore</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Wartość</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наличие значения</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Değerin geçerliliği</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Giá trị sẵn có</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Columns.DocumentRowNumber,
	Columns.Organization,
	Columns.Department,
	Columns.Scenario,
	Columns.Period,
	Columns.SubperiodNumber,
	Columns.Dimension1,
	Columns.Dimension2,
	Columns.Dimension3,
	Columns.Dimension4,
	Columns.Dimension5,
	Columns.Dimension6,
	Columns.NonFinancialItem,
	Columns.Value,
	Columns.Currency,
	TRUE AS ValuePresence
FROM
	Document.SetValuesForNonFinancialItems.DocumentColumns AS Columns
WHERE
	Columns.Ref = &amp;Ref</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Header</sourceDataSet>
		<destinationDataSet>Rows</destinationDataSet>
		<sourceExpression>True</sourceExpression>
		<destinationExpression>True</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Rows</sourceDataSet>
		<destinationDataSet>Columns</destinationDataSet>
		<sourceExpression>DocumentRowNumber</sourceExpression>
		<destinationExpression>DocumentRowNumber</destinationExpression>
	</dataSetLink>
	<calculatedField>
