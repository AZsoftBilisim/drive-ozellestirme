			<dataPath>AnalyticsLines5</dataPath>
			<field>Dimension5</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsLines6</dataPath>
			<field>Dimension6</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LinesNumberUnderPeriod</dataPath>
			<field>SubperiodNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentRowNumber</dataPath>
			<field>DocumentRowNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LinesOrganization</dataPath>
			<field>Organization</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>RowsPeriod</dataPath>
			<field>Period</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>UnitLines</dataPath>
			<field>Department</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>StringsScript</dataPath>
			<field>Scenario</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Rows.DocumentRowNumber,
	Rows.Organization,
	Rows.Department,
	Rows.Scenario,
	Rows.Period,
	Rows.SubperiodNumber,
	Rows.Dimension1,
	Rows.Dimension2,
	Rows.Dimension3,
	Rows.Dimension4,
	Rows.Dimension5,
	Rows.Dimension6
FROM
	Document.SetValuesForNonFinancialItems.DocumentRows AS Rows
WHERE
	Rows.Ref = &amp;Ref</query>
	</dataSet>
