		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>SubperiodNumber</dataPath>
		<expression>Case 
When ValueIsFilled(LinesNumberUnderPeriod) Then LinesNumberUnderPeriod
When ValueIsFilled(ColumnNumberUnderPeriod) Then ColumnNumberUnderPeriod
End</expression>
