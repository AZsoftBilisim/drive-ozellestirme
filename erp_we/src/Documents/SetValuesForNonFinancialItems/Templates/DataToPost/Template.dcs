<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Header</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsHeader_1</dataPath>
			<field>Dimension1</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsHeader_2</dataPath>
			<field>Dimension2</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsHeader_3</dataPath>
			<field>Dimension3</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsHeader_4</dataPath>
			<field>Dimension4</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsHeader_5</dataPath>
			<field>Dimension5</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsHeader_6</dataPath>
			<field>Dimension6</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BeginOfPeriod</dataPath>
			<field>BeginOfPeriod</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PeriodEnding</dataPath>
			<field>PeriodEnding</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>OrganizationHeader</dataPath>
			<field>Organization</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DivisionHeader</dataPath>
			<field>Department</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ScenarioHeader</dataPath>
			<field>Scenario</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PeriodType</dataPath>
			<field>PeriodType</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	SetValuesForNonFinancialItems.PeriodType,
	SetValuesForNonFinancialItems.BeginOfPeriod,
	SetValuesForNonFinancialItems.PeriodEnding,
	SetValuesForNonFinancialItems.Organization,
	SetValuesForNonFinancialItems.Department,
	SetValuesForNonFinancialItems.Scenario,
	SetValuesForNonFinancialItems.Dimension1,
	SetValuesForNonFinancialItems.Dimension2,
	SetValuesForNonFinancialItems.Dimension3,
	SetValuesForNonFinancialItems.Dimension4,
	SetValuesForNonFinancialItems.Dimension5,
	SetValuesForNonFinancialItems.Dimension6
FROM
	Document.SetValuesForNonFinancialItems AS SetValuesForNonFinancialItems
WHERE
	SetValuesForNonFinancialItems.Ref = &amp;Ref</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>Rows</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>AnalyticsLines1</dataPath>
			<field>Dimension1</field>
		</field>
		<field xsi:type="DataSetFieldField">
