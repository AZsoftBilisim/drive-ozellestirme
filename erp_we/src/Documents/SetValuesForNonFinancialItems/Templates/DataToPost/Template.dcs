	<calculatedField>
		<dataPath>Period</dataPath>
		<expression>Case 
When ValueIsFilled(RowsPeriod) Then RowsPeriod
When ValueIsFilled(ColumnsPeriod) Then ColumnsPeriod
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
