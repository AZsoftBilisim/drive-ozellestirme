		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Set.Products AS Products,
	Set.Characteristic AS Characteristic,
	Set.Warehouse AS Warehouse,
	Set.Purpose AS Purpose,
	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
	Set.Premise AS Premise,
	Set.Series AS Series
{SELECT
	Products AS Products,
	Characteristic AS Characteristic,
	Warehouse AS Warehouse,
	Purpose AS Purpose,
	Premise AS Premise,
	ControlledLotReference AS ControlledLotReference,
	Series AS Series}
FROM(
	SELECT
		ProductStock.Products AS Products,
		ProductStock.Characteristic AS Characteristic,
		ProductStock.Warehouse AS Warehouse,
		ProductStock.Purpose AS Purpose,
		ProductStock.ControlledLotReference AS ControlledLotReference,
		ProductStock.Premise AS Premise,
		ProductStock.Series AS Series,
		ProductStock.InStockBalance - ProductStock.ToShipBalance AS Count
	FROM
		AccumulationRegister.ProductStock.Balance(,
			ControlledLotReference = VALUE(Catalog.ControlledLots.EmptyRef)
			{
			ControlledLotReference.* AS ControlledLotReference,
			Products.* AS Products,
			Characteristic.* AS Characteristic,
			Warehouse.* AS Warehouse,
			Purpose.* AS Purpose,
			Series.* AS Series,
			Premise.* AS Premise
			}
			) AS ProductStock
	WHERE
		ProductStock.InStockBalance - ProductStock.ToShipBalance &lt;&gt; 0
	
UNION ALL
	
	SELECT
		ProductStock.Products AS Products,
		ProductStock.Characteristic AS Characteristic,
		ProductStock.Warehouse AS Warehouse,
		ProductStock.Purpose AS Purpose,
		ProductStock.ControlledLotReference AS ControlledLotReference,
		ProductStock.Premise AS Premise,
		ProductStock.Series AS Series,
		CASE
			WHEN ProductStock.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN - ProductStock.InStock + ProductStock.ToShip
			ELSE ProductStock.InStock - ProductStock.ToShip
		END AS Count
	FROM
		AccumulationRegister.ProductStock AS ProductStock
	WHERE
		ProductStock.Recorder = &amp;Recorder
		AND ProductStock.ControlledLotReference = VALUE(Catalog.ControlledLots.EmptyRef)
		AND ProductStock.Active
		{WHERE
			ProductStock.ControlledLotReference.* AS ControlledLotReference,
			ProductStock.Products.* AS Products,
			ProductStock.Characteristic.* AS Characteristic,
			ProductStock.Warehouse.* AS Warehouse,
			ProductStock.Purpose.* AS Purpose,
			ProductStock.Series.* AS Series,
			ProductStock.Premise.* AS Premise
			}
	) AS Set
GROUP BY
	Set.Products,
	Set.Characteristic,
	Set.Warehouse,
	Set.Purpose,
	Set.ControlledLotReference,
	Set.Premise,
	Set.Series
HAVING
	SUM(Set.Count) &gt; 0

</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
