      <queryText>SELECT
	RequestForGoodsQualityControlOverridable.Ref AS Ref,
	RequestForGoodsQualityControlOverridable.Number AS Number,
	RequestForGoodsQualityControlOverridable.Date AS Date,
	UNDEFINED AS State,
	RequestForGoodsQualityControlOverridable.Warehouse AS Warehouse,
	RequestForGoodsQualityControlOverridable.ReasonForGoodsLock AS ReasonForGoodsLock,
	RequestForGoodsQualityControlOverridable.ToScheduleGoodsUnlock AS ToScheduleGoodsUnlock,
	RequestForGoodsQualityControlOverridable.QualityConfirmationDate AS DueDate_2,
	RequestForGoodsQualityControlOverridable.ControlledLotReference AS ControlledLotReference,
	RequestForGoodsQualityControlOverridable.EmployeeResponsible AS EmployeeResponsible,
	RequestForGoodsQualityControlOverridable.Author AS Author,
	RequestForGoodsQualityControlOverridable.Comment AS Comment,
	CAST(&quot;&quot; AS STRING(10)) AS StudiesPerformed
FROM
	Document.RequestForGoodsQualityControl AS RequestForGoodsQualityControlOverridable</queryText>
