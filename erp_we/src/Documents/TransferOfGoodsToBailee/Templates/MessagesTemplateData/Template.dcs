		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TransferOfGoodsToBailee.Number,
	TransferOfGoodsToBailee.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	TransferOfGoodsToBailee.Warehouse,
	TransferOfGoodsToBailee.Manager,
	TransferOfGoodsToBailee.Currency,
	TransferOfGoodsToBailee.DocumentAmount,
	TransferOfGoodsToBailee.Contract,
	TransferOfGoodsToBailee.DeliveryAddress,
	TransferOfGoodsToBailee.Shipper,
	TransferOfGoodsToBailee.GoodsRecipient,
	TransferOfGoodsToBailee.DeliveryMethod,
	Carriers.DescriptionFull AS CarrierFullName,
	TransferOfGoodsToBailee.DeliveryAddressOfCarrier,
	TransferOfGoodsToBailee.AdditionalDeliveryInformation,
	TransferOfGoodsToBailee.CompanyBankAccount
FROM
	Document.TransferOfGoodsToBailee AS TransferOfGoodsToBailee
		{LEFT JOIN Catalog.Partners AS Partners
		ON TransferOfGoodsToBailee.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON TransferOfGoodsToBailee.ContactPerson = ContactPersonsForPartners.Ref
		LEFT JOIN Catalog.Partners AS Carriers
		ON TransferOfGoodsToBailee.CarrierPartner = Carriers.Ref}
WHERE
	TransferOfGoodsToBailee.Ref = &amp;TransferOfGoodsToBailee</query>
	</dataSet>
