    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentTransferOfGoodsToBailee.Ref,
	DocumentTransferOfGoodsToBailee.DeletionMark,
	DocumentTransferOfGoodsToBailee.Number,
	DocumentTransferOfGoodsToBailee.Date,
	DocumentTransferOfGoodsToBailee.Posted,
	DocumentTransferOfGoodsToBailee.SalesOrder,
	DocumentTransferOfGoodsToBailee.TransferByOrders,
	DocumentTransferOfGoodsToBailee.Partner,
	DocumentTransferOfGoodsToBailee.Counterparty,
	DocumentTransferOfGoodsToBailee.CounterpartyBankAccount,
	DocumentTransferOfGoodsToBailee.Terms,
	DocumentTransferOfGoodsToBailee.BusinessOperation,
	DocumentTransferOfGoodsToBailee.Organization,
	DocumentTransferOfGoodsToBailee.CompanyBankAccount,
	DocumentTransferOfGoodsToBailee.Contract,
	DocumentTransferOfGoodsToBailee.Warehouse,
	DocumentTransferOfGoodsToBailee.Currency,
	DocumentTransferOfGoodsToBailee.Comment,
	DocumentTransferOfGoodsToBailee.DeliveryMethod,
	DocumentTransferOfGoodsToBailee.CarrierPartner,
	DocumentTransferOfGoodsToBailee.DeliveryAddress,
	DocumentTransferOfGoodsToBailee.DeliveryAddressFieldValues,
	DocumentTransferOfGoodsToBailee.DeliveryAddressOfCarrier,
	DocumentTransferOfGoodsToBailee.DeliveryAddressOfCarrierFieldValues,
	DocumentTransferOfGoodsToBailee.DeliveryZone,
	DocumentTransferOfGoodsToBailee.DeliveryTimeFrom,
	DocumentTransferOfGoodsToBailee.DeliveryTimeTo,
	DocumentTransferOfGoodsToBailee.AdditionalDeliveryInformation,
	DocumentTransferOfGoodsToBailee.SpecialTransportationConditions,
	DocumentTransferOfGoodsToBailee.SpecialTransportationConditionsDescription,
	DocumentTransferOfGoodsToBailee.Manager,
	DocumentTransferOfGoodsToBailee.SalesOpportunity,
	DocumentTransferOfGoodsToBailee.ContactPerson,
	DocumentTransferOfGoodsToBailee.Department,
	DocumentTransferOfGoodsToBailee.LineOfBusiness,
	DocumentTransferOfGoodsToBailee.ToReturnReusablePackage,
	DocumentTransferOfGoodsToBailee.ReusablePackagesReturnDate,
	DocumentTransferOfGoodsToBailee.ReusablePackageFillingStatus,
	DocumentTransferOfGoodsToBailee.InventoryOwnerAttributesAreSpecifiedManually,
	DocumentTransferOfGoodsToBailee.SubsequentDeliveryByTransfer,
	DocumentTransferOfGoodsToBailee.DocumentAmount,
	DocumentTransferOfGoodsToBailee.Shipper,
	DocumentTransferOfGoodsToBailee.ShipperBankAccount,
	DocumentTransferOfGoodsToBailee.GoodsRecipient,
	DocumentTransferOfGoodsToBailee.GoodsRecipientBankAccount,
	DocumentTransferOfGoodsToBailee.Director,
	DocumentTransferOfGoodsToBailee.ChiefAccountant,
	DocumentTransferOfGoodsToBailee.IssuiedBy,
	DocumentTransferOfGoodsToBailee.IssuiedByJobTitle,
	DocumentTransferOfGoodsToBailee.Basis,
	DocumentTransferOfGoodsToBailee.ReferenceDocumentDateForPrintForms,
	DocumentTransferOfGoodsToBailee.BaseDocumentNumber,
	DocumentTransferOfGoodsToBailee.Author,
	DocumentTransferOfGoodsToBailee.LocalConversionRatio,
	DocumentTransferOfGoodsToBailee.LetterOfAuthorityIssuedBy,
	DocumentTransferOfGoodsToBailee.PowerOfAttorneyDate,
	DocumentTransferOfGoodsToBailee.PowerOfAttorneyPerson,
	DocumentTransferOfGoodsToBailee.PowerOfAttorneyNumber,
	DocumentTransferOfGoodsToBailee.DeliveryAddressValue,
	DocumentTransferOfGoodsToBailee.DeliveryAddressOfCarrierValue,
	DocumentTransferOfGoodsToBailee.Patch,
	DocumentTransferOfGoodsToBailee.ReversedDocument,
	DocumentTransferOfGoodsToBailee.CorrectedDocument,
	DocumentTransferOfGoodsToBailee.DocumentBasis,
	DocumentTransferOfGoodsToBailee.Goods,
	DocumentTransferOfGoodsToBailee.InventoryKinds,
	DocumentTransferOfGoodsToBailee.AdditionalAttributes,
	DocumentTransferOfGoodsToBailee.SetOfSeries,
	DocumentTransferOfGoodsToBailee.PackageBarcodes,
	DocumentTransferOfGoodsToBailee.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.TransferOfGoodsToBailee AS DocumentTransferOfGoodsToBailee
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentTransferOfGoodsToBailee.Ref)</queryText>
