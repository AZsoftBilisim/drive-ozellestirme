	</parameter>
	<parameter>
		<name>NewOnlineARAPAccounting</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Is new AR/AP configuration</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پیکربندی جدید دریافتنی/پرداختنی است</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Nuova architettura dei pagamenti reciproci</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Nowa architektura rozliczeń wzajemnych</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Новая архитектура взаиморасчетов</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
