					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">CompanyCounterparty</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
				</dcsset:item>
			</dcsset:filter>
