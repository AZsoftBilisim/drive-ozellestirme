  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentARAPReconciliation.Ref,
	DocumentARAPReconciliation.DeletionMark,
	DocumentARAPReconciliation.Number,
	DocumentARAPReconciliation.Date,
	DocumentARAPReconciliation.Posted,
	DocumentARAPReconciliation.Organization,
	DocumentARAPReconciliation.Counterparty,
	DocumentARAPReconciliation.Partner,
	DocumentARAPReconciliation.Contract,
	DocumentARAPReconciliation.BeginOfPeriod,
	DocumentARAPReconciliation.EndOfPeriod,
	DocumentARAPReconciliation.Status,
	DocumentARAPReconciliation.Manager,
	DocumentARAPReconciliation.Comment,
	DocumentARAPReconciliation.JobTitleOfCounterpartyExecutive,
	DocumentARAPReconciliation.FullNameOfCounterpartyExecutive,
	DocumentARAPReconciliation.DrillDownByOrders,
	DocumentARAPReconciliation.DrillDownByPartners,
	DocumentARAPReconciliation.DrillDownByContracts,
	DocumentARAPReconciliation.ContactPerson,
	DocumentARAPReconciliation.Director,
	DocumentARAPReconciliation.PaymentType_,
	DocumentARAPReconciliation.ThereAreDiscrepancies,
	DocumentARAPReconciliation.Filter_Settings,
	DocumentARAPReconciliation.ChiefAccountant,
	DocumentARAPReconciliation.EmployeeInCharge_,
	DocumentARAPReconciliation.SplitByARAPTypes,
	DocumentARAPReconciliation.SplitByPartners,
	DocumentARAPReconciliation.SplitByContracts,
	DocumentARAPReconciliation.CounterpartyData,
	DocumentARAPReconciliation.GroupingsARAP,
	DocumentARAPReconciliation.DetailedRecordsARAPAccounting,
	DocumentARAPReconciliation.GroupingsFinancialInstruments,
	DocumentARAPReconciliation.DetailedRecordsFinancialInstruments,
	DocumentARAPReconciliation.PointInTime
FROM
	Document.ARAPReconciliation2_4 AS DocumentARAPReconciliation
{WHERE
	NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_4.GroupingsFinancialInstruments AS FinTools
			WHERE
				DocumentARAPReconciliation.Ref = FinTools.Ref
				AND FinTools.PaymentType_ IN (&amp;ProhibitedPaymentTypes)
		)
	)
}</queryText>
      <mainTable>Document.ARAPReconciliation2_4</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CounterpartyCompanyManager</dataPath>
