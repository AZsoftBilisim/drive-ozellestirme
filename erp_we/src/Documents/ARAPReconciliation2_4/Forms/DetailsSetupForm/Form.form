  <items xsi:type="form:FormField">
    <name>DrillDownByOrders</name>
    <id>1</id>
    <title>
      <key>en</key>
      <value>Debt drill-down by AR/AP objects</value>
    </title>
    <title>
      <key>fa</key>
      <value>تفکیک بدهی بر اساس اشیای دریافتنی/پرداختنی</value>
    </title>
    <title>
      <key>it</key>
      <value>Deciframento dell'indebitamento per oggetti di calcoli</value>
    </title>
    <title>
      <key>pl</key>
      <value>Szczegóły zobowiązania według obiektów rozliczeń</value>
    </title>
    <title>
      <key>ru</key>
      <value>Расшифровка задолженности по объектам расчетов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Hesaplama öğesine göre borçların transkripti</value>
    </title>
    <title>
      <key>vi</key>
      <value>Diễn giải công nợ theo đối tượng hạch toán</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <dataPath xsi:type="form:DataPath">
      <segments>DrillDownByOrders</segments>
    </dataPath>
    <titleLocation>Right</titleLocation>
    <toolTip>
      <key>en</key>
      <value>Output the order (sales, receipt) debt details as an annex to the certificate</value>
    </toolTip>
    <toolTip>
