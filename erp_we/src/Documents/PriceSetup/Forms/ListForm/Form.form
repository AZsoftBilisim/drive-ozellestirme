  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentPriceSetup.Ref AS Ref,
	DocumentPriceSetup.Status AS Status,
	DocumentPriceSetup.Posted AS Posted,
	CASE
		WHEN DocumentPriceSetup.Posted
		AND DocumentPriceSetup.Status = VALUE(Enum.ProductPricingStatuses.Approved)
			THEN VALUE(Enum.ProductPricingStates.Valid)
		WHEN DocumentPriceSetup.Posted
		AND DocumentPriceSetup.Status = VALUE(Enum.ProductPricingStatuses.NotApproved)
			THEN VALUE(Enum.ProductPricingStates.PendingApproval)
		ELSE VALUE(Enum.ProductPricingStates.EmptyRef)
	END AS State,
	DocumentPriceSetup.Number AS Number,
	DocumentPriceSetup.Date AS Date,
	DATEDIFF(BEGINOFPERIOD(DocumentPriceSetup.Date, DAY), DocumentPriceSetup.Date,
		SECOND) + 1 AS RoomWithinADay,
	DocumentPriceSetup.EmployeeResponsible AS EmployeeResponsible,
	DocumentPriceSetup.Comment AS Comment,
	CASE
		WHEN NOT DocumentPriceSetup.Posted
			THEN DATETIME(1, 1, 1) // APPROVAL IS OVERDUE //////////////////////////////////////////////////
 WHEN
			DocumentPriceSetup.Status = VALUE(Enum.ProductPricingStatuses.NotApproved)
			THEN DocumentPriceSetup.Date
		ELSE DATETIME(1, 1, 1)
	END AS EventDate,
	CASE // NOT CARRIED OUT //////////////////////////////////////////////////////////////
 WHEN NOT
			DocumentPriceSetup.Posted
			THEN FALSE // APPROVAL IS OVERDUE //////////////////////////////////////////////////
 WHEN
			DocumentPriceSetup.Status = VALUE(Enum.ProductPricingStatuses.NotApproved)
		AND DocumentPriceSetup.Date &lt; &amp;UpdateDate
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CAST(&quot;&quot; AS STRING(500)) AS TypesOfPrices,
	DocumentPriceSetup.MarketingActivity
FROM
	Document.PriceSetup AS DocumentPriceSetup
		{LEFT JOIN Document.PriceSetup.TypesOfPrices AS PriceSetupTypesOfPrices
		ON PriceSetupTypesOfPrices.Ref = DocumentPriceSetup.Ref}
{WHERE
	PriceSetupTypesOfPrices.PriceKind AS PriceKind}</queryText>
      <mainTable>Document.PriceSetup</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
