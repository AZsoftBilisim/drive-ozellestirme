        <value>Cena zmieniona ręcznie</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Цена изменена вручную</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Fiyat manuel olarak değiştirildi</value>
      </synonym>
      <synonym>
