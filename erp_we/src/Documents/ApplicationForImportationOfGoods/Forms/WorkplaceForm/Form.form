  <attributes>
    <name>ListOrders</name>
    <title>
      <key>en</key>
      <value>References to register Applications for goods import</value>
    </title>
    <title>
      <key>fa</key>
      <value>مراجع برای ثبت درخواست‌های واردات کالا</value>
    </title>
    <title>
      <key>it</key>
      <value>Disposizioni di formalizzazione Dichiarazioni di importazione merci</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zlecenia do rejestracji Oświadczeń o imporcie towarów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Распоряжения на оформление Заявлений о ввозе товаров</value>
    </title>
    <title>
      <key>tr</key>
      <value>Malların İthalatı için taleplerin düzenlenmesine ilişkin emirler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Lệnh tạo Giấy đề nghị nhập hàng</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOrders.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentVendorInvoiceOverridable.Ref AS Ref,
	DocumentVendorInvoiceOverridable.Ref AS ReferenceOrder,
	CAST(DocumentVendorInvoiceOverridable.Number AS STRING(12)) AS Number,
	DocumentVendorInvoiceOverridable.Date AS Date,
	DocumentVendorInvoiceOverridable.Currency AS Currency,
	DocumentVendorInvoiceOverridable.Counterparty AS Counterparty,
	DocumentVendorInvoiceOverridable.DocumentAmount AS DocumentAmount,
	DocumentVendorInvoiceOverridable.Organization AS Organization
FROM
	Document.VendorInvoice AS DocumentVendorInvoiceOverridable
		INNER JOIN AccumulationRegister.GoodsForRegistrationOfApplicationForImportFromEEUCountries.Balance AS GoodsForRegistrationOfApplicationForImportFromEEUCountriesBalance
		ON DocumentVendorInvoiceOverridable.Ref = GoodsForRegistrationOfApplicationForImportFromEEUCountriesBalance.DocumentInflow

GROUP BY
	DocumentVendorInvoiceOverridable.Ref,
	DocumentVendorInvoiceOverridable.Date,
	DocumentVendorInvoiceOverridable.Currency,
	DocumentVendorInvoiceOverridable.Counterparty,
	DocumentVendorInvoiceOverridable.DocumentAmount,
	DocumentVendorInvoiceOverridable.Organization,
	CAST(DocumentVendorInvoiceOverridable.Number AS STRING(12))</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
