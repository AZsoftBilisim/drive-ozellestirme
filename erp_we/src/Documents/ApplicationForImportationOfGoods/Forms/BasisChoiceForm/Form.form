    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	GoodsForRegistrationOfImportDocumentsBalance.DocumentInflow AS DocumentInflow
INTO TTBalance
FROM
	AccumulationRegister.GoodsForRegistrationOfImportDocuments.Balance(
			,
			Organization = &amp;Organization
				AND ImportDocumentType = &amp;IdApplicationForImportOfGoods) AS GoodsForRegistrationOfImportDocumentsBalance
				
UNION

SELECT
	GoodsForRegistrationOfImportDocuments.DocumentInflow
FROM
	AccumulationRegister.GoodsForRegistrationOfImportDocuments AS GoodsForRegistrationOfImportDocuments
WHERE
	GoodsForRegistrationOfImportDocuments.Active
	AND GoodsForRegistrationOfImportDocuments.Recorder = &amp;Ref
	AND GoodsForRegistrationOfImportDocuments.ImportDocumentType = &amp;IdApplicationForImportOfGoods
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DocumentVendorInvoice.Ref AS Ref,
	DocumentVendorInvoice.Number AS Number,
	DocumentVendorInvoice.Date AS Date,
	DocumentVendorInvoice.Organization AS Organization,
	DocumentVendorInvoice.Warehouse AS Warehouse,
	DocumentVendorInvoice.Department AS Department,
	DocumentVendorInvoice.Counterparty AS Counterparty,
	DocumentVendorInvoice.DocumentAmount AS DocumentAmount,
	DocumentVendorInvoice.Currency AS Currency,
	CASE
		WHEN DocumentVendorInvoice.Ref IN (&amp;ArrayOfSelectedDocuments)
			THEN TRUE
		ELSE FALSE
	END AS DocumentHasAlreadyBeenSelected,
	DocumentVendorInvoice.IncomingDocumentNumber AS IncomingDocumentNumber,
	DocumentVendorInvoice.IncomingDocumentDate AS IncomingDocumentDate
FROM
	TTBalance AS TTBalance
		INNER JOIN Document.VendorInvoice AS DocumentVendorInvoice
		ON TTBalance.DocumentInflow = DocumentVendorInvoice.Ref
WHERE
	DocumentVendorInvoice.Organization = &amp;Organization
	AND DocumentVendorInvoice.Counterparty = &amp;Counterparty
	AND DocumentVendorInvoice.Contract = &amp;Contract
	
UNION

SELECT
	DocumentVendorInvoice.Ref,
	DocumentVendorInvoice.Number,
	DocumentVendorInvoice.Date,
	DocumentVendorInvoice.Organization,
	DocumentVendorInvoice.Warehouse,
	DocumentVendorInvoice.Department,
	DocumentVendorInvoice.Counterparty,
	DocumentVendorInvoice.DocumentAmount,
	DocumentVendorInvoice.Currency,
	CASE
		WHEN DocumentVendorInvoice.Ref IN (&amp;ArrayOfSelectedDocuments)
			THEN TRUE
		ELSE FALSE
	END,
	DocumentVendorInvoice.IncomingDocumentNumber,
	DocumentVendorInvoice.IncomingDocumentDate
FROM
	Document.VendorInvoice AS DocumentVendorInvoice
	
WHERE
	DocumentVendorInvoice.Ref IN (&amp;ArrayOfSelectedDocuments)
</queryText>
