  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentApplicationForImportationOfGoods.Ref AS Ref,
	DocumentApplicationForImportationOfGoods.DeletionMark AS DeletionMark,
	DocumentApplicationForImportationOfGoods.Number AS Number,
	DocumentApplicationForImportationOfGoods.Date AS Date,
	DocumentApplicationForImportationOfGoods.Posted AS Posted,
	DocumentApplicationForImportationOfGoods.Organization AS Organization,
	DocumentApplicationForImportationOfGoods.Counterparty AS Counterparty,
	DocumentApplicationForImportationOfGoods.Contract AS Contract,
	ISNULL(Companies.LocalAccountingCurrency, VALUE(Catalog.Currencies.EmptyRef)) AS DocumentCurrency,
	DocumentApplicationForImportationOfGoods.EmployeeResponsible AS EmployeeResponsible,
	CAST(DocumentApplicationForImportationOfGoods.Comment AS STRING(1000)) AS Comment,
	DocumentApplicationForImportationOfGoods.DocumentAmount AS DocumentAmount,
	DocumentApplicationForImportationOfGoods.PointInTime AS PointInTime,
	SUM(ApplicationForImportationOfGoodsGoods.TaxInvoicedPrice) AS TaxInvoicedPrice
FROM
	Document.ApplicationForImportationOfGoods.Goods AS ApplicationForImportationOfGoodsGoods
		INNER JOIN Document.ApplicationForImportationOfGoods AS DocumentApplicationForImportationOfGoods
		ON ApplicationForImportationOfGoodsGoods.Ref = DocumentApplicationForImportationOfGoods.Ref
		LEFT JOIN Catalog.Companies AS Companies
		ON (DocumentApplicationForImportationOfGoods.Organization = Companies.Ref)

GROUP BY
	DocumentApplicationForImportationOfGoods.Ref,
	DocumentApplicationForImportationOfGoods.DeletionMark,
	DocumentApplicationForImportationOfGoods.Number,
	DocumentApplicationForImportationOfGoods.Date,
	DocumentApplicationForImportationOfGoods.Posted,
	DocumentApplicationForImportationOfGoods.Organization,
	DocumentApplicationForImportationOfGoods.Counterparty,
	DocumentApplicationForImportationOfGoods.Contract,
	ISNULL(Companies.LocalAccountingCurrency, VALUE(Catalog.Currencies.EmptyRef)),
	DocumentApplicationForImportationOfGoods.EmployeeResponsible,
	DocumentApplicationForImportationOfGoods.DocumentAmount,
	DocumentApplicationForImportationOfGoods.PointInTime,
	CAST(DocumentApplicationForImportationOfGoods.Comment AS STRING(1000))</queryText>
      <mainTable>Document.ApplicationForImportationOfGoods</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>EmployeeInCharge_</dataPath>
        <field>EmployeeInCharge_</field>
