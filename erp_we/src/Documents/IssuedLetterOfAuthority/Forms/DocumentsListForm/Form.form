    </title>
    <title>
      <key>vi</key>
      <value>Danh sách giấy ủy quyền</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListLettersOfAuthority.PaymentsReceiptsFilter</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListLettersOfAuthority.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	DocumentLetterOfAuthority.Ref AS Ref,
	DocumentLetterOfAuthority.DeletionMark AS DeletionMark,
	DocumentLetterOfAuthority.Number AS Number,
	DocumentLetterOfAuthority.Date AS Date,
	DocumentLetterOfAuthority.Posted AS Posted,
	DocumentLetterOfAuthority.Organization AS Organization,
	DocumentLetterOfAuthority.BankAccount AS BankAccount,
	DocumentLetterOfAuthority.Partner AS Partner,
	DocumentLetterOfAuthority.Counterparty AS Counterparty,
	DocumentLetterOfAuthority.Person AS Person,
	DocumentLetterOfAuthority.JobTitle AS JobTitle,
	DocumentLetterOfAuthority.Comment AS Comment,
	DocumentLetterOfAuthority.DocumentBasis AS DocumentBasis,
	DocumentLetterOfAuthority.EmployeeResponsible AS EmployeeResponsible,
	DocumentLetterOfAuthority.ValidityPeriod AS ValidityPeriod,
	DocumentLetterOfAuthority.ValidityEndDate AS ValidityEndDate,
	DocumentLetterOfAuthority.ByDocument AS ByDocument,
	DocumentLetterOfAuthority.Status AS Status,
	DocumentLetterOfAuthority.Status AS State,
	DocumentLetterOfAuthority.PointInTime AS PointInTime,
	DocumentLetterOfAuthority.PresentationOfPersonDocument AS PresentationOfPersonDocument,
	CASE
		WHEN DocumentLetterOfAuthority.DeletionMark
			THEN DATETIME(1, 1, 1)
		WHEN DocumentLetterOfAuthority.Status = VALUE(Enum.StatusesOfAuthorizationLetters.Issued)
			THEN DocumentLetterOfAuthority.ValidityEndDate
		ELSE DATETIME(1, 1, 1)
	END AS EventDate,
	CASE
		WHEN DocumentLetterOfAuthority.ValidityEndDate &lt; &amp;UpdateDate
				AND DocumentLetterOfAuthority.ValidityEndDate &lt;> DATETIME(1, 1, 1)
				AND DocumentLetterOfAuthority.Status = VALUE(Enum.StatusesOfAuthorizationLetters.Issued)
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CASE
		WHEN DocumentLetterOfAuthority.AuthorizationLetterType = VALUE(Enum.TypesOfIssuedLettersOfAuthority.ToReceiveCash)
			THEN DocumentLetterOfAuthority.DocumentAmount
		ELSE DocumentLetterOfAuthority.NumberOfRows
	END AS DocumentAmount,
	CASE
		WHEN DocumentLetterOfAuthority.AuthorizationLetterType = VALUE(Enum.TypesOfIssuedLettersOfAuthority.ToReceiveCash)
			THEN DocumentLetterOfAuthority.Currency
		ELSE &amp;Positions_2
	END AS Currency,
	DocumentLetterOfAuthority.AuthorizationLetterType AS AuthorizationLetterType,
	CASE
		WHEN DocumentLetterOfAuthority.AuthorizationLetterType = VALUE(Enum.TypesOfIssuedLettersOfAuthority.ToReceiveCash)
			THEN CASE
					WHEN DocumentLetterOfAuthority.DocumentPaymentsAmount = 0
						THEN CAST(&amp;TextNoReceiptOfTheDS AS STRING(30))
					ELSE CASE
							WHEN DocumentLetterOfAuthority.DocumentPaymentsAmount &lt; DocumentLetterOfAuthority.DocumentAmount
								THEN CAST(&amp;TextPartialReceiptOfDS AS STRING(30))
							ELSE CAST(&amp;TextFullReceiptOfTheDS AS STRING(30))
						END
				END
		ELSE CASE
				WHEN DocumentLetterOfAuthority.HasGoodsReceipt
					THEN CAST(&amp;TheTextIsTheReceiptOfGoods AS STRING(30))
				ELSE CAST(&amp;TextNoGoodsReceived AS STRING(30))
			END
	END AS PaymentsReceiptsFilter,
	CASE
		WHEN DocumentLetterOfAuthority.AuthorizationLetterType = VALUE(Enum.TypesOfIssuedLettersOfAuthority.ToReceiveCash)
			THEN CASE
					WHEN DocumentLetterOfAuthority.DocumentPaymentsAmount = 0
						THEN CAST(&amp;TextNoReceiptOfTheDS AS STRING(30))
					ELSE CASE
							WHEN DocumentLetterOfAuthority.DocumentPaymentsAmount &lt; DocumentLetterOfAuthority.DocumentAmount
								THEN CAST(&amp;TextPartialReceiptOfDS AS STRING(30))
							ELSE CAST(&amp;TextFullReceiptOfTheDS AS STRING(30))
						END
				END
		ELSE CASE
				WHEN DocumentLetterOfAuthority.HasGoodsReceipt
					THEN CAST(&amp;TheTextIsTheReceiptOfGoods AS STRING(30))
				ELSE CAST(&amp;TextNoGoodsReceived AS STRING(30))
			END
	END AS PaymentReceipts,
	DocumentLetterOfAuthority.DocumentPaymentsAmount AS Payments,
    EDStates.EDIState,
    EDStates.StatusPresentation	
FROM
	Document.IssuedLetterOfAuthority AS DocumentLetterOfAuthority
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentLetterOfAuthority.Ref)
</queryText>
      <mainTable>Document.IssuedLetterOfAuthority</mainTable>
