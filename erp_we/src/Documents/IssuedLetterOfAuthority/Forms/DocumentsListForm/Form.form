    </title>
    <title>
      <key>pl</key>
      <value>Lista zlecenia do rejestracji</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список распоряжения на оформление</value>
    </title>
    <title>
      <key>tr</key>
      <value>Düzenlenen siparişlerin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách thứ tự thực hiện</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReferencesForRegistration.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	UNDEFINED AS Ref,
	FALSE AS DeletionMark,
	VALUETYPE(VALUE(Document.PurchaseOrder.EmptyRef)) AS TypeOfOrder_,
	DATETIME(1, 1, 1) AS Date,
	CAST(&quot;&quot; AS STRING(11)) AS Number,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef) AS Counterparty,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	VALUE(Catalog.Users.EmptyRef) AS Manager,
	0 AS DocumentAmount,
	VALUE(Catalog.Priorities.EmptyRef) AS Priority,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS BusinessOperation,
	&quot;&quot; AS BusinessOperationPresentation,
	&quot;&quot; AS Comment,
	FALSE AS ThereIsLetterOfAuthority,
	0 AS PictureOfPriority</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
