    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentIssuedTaxInvoicePrepayment.Number,
	DocumentIssuedTaxInvoicePrepayment.Date,
	DocumentIssuedTaxInvoicePrepayment.Ref AS TaxInvoice,
	DocumentIssuedTaxInvoicePrepayment.DocumentBasis,
	DocumentIssuedTaxInvoicePrepayment.Counterparty,
	DocumentIssuedTaxInvoicePrepayment.Sum,
	DocumentIssuedTaxInvoicePrepayment.VATAmount,
	DocumentIssuedTaxInvoicePrepayment.Comment
FROM
	Document.IssuedTaxInvoicePrepayment AS DocumentIssuedTaxInvoicePrepayment
WHERE
	DocumentIssuedTaxInvoicePrepayment.Ref IN (&amp;UnusedTaxInvoices)</queryText>
