  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	InvoiceIssued.Ref AS Ref,
	CASE
		WHEN OriginalTaxInvoice.Ref IS NULL 
			THEN InvoiceIssued.Number
		ELSE OriginalTaxInvoice.Number
	END AS Number,
	CASE
		WHEN OriginalTaxInvoice.Ref IS NULL 
			THEN InvoiceIssued.Date
		ELSE OriginalTaxInvoice.Date
	END AS Date,
	InvoiceIssued.CorrectionNumber AS CorrectionNumber,
	CASE
		WHEN OriginalTaxInvoice.Ref IS NULL 
			THEN &quot;&quot;
		ELSE InvoiceIssued.Date
	END AS CorrectionDate,
	InvoiceIssued.DeletionMark,
	InvoiceIssued.Posted,
	InvoiceIssued.Organization,
	InvoiceIssued.DocumentBasis,
	InvoiceIssued.BaseDocumentTaxInvoice,
	InvoiceIssued.Patch,
	InvoiceIssued.IssuedInElectronicFormat,
	InvoiceIssued.IssueDate,
	InvoiceIssued.TransactionKindCode,
	InvoiceIssued.PointInTime,
	InvoiceIssued.Counterparty,
	EDStates.EDIState,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN 3
		ELSE 0
	END AS ContainsIncorrectCounterparties
FROM
	Document.IssuedTaxInvoicePrepayment AS InvoiceIssued
		LEFT JOIN Document.IssuedTaxInvoicePrepayment AS OriginalTaxInvoice
		ON InvoiceIssued.Patch
			AND OriginalTaxInvoice.Ref = InvoiceIssued.BaseDocumentTaxInvoice
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = InvoiceIssued.Ref)
		LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON InvoiceIssued.Ref = DocumentsWithCounterpartyCheckErrors.Document
		AND &amp;UsingOfCheckIsAnOption}</queryText>
      <mainTable>Document.IssuedTaxInvoicePrepayment</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
