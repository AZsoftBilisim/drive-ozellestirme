			<field>Contract</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Manager</dataPath>
			<field>Manager</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnerAppeal</dataPath>
			<field>PartnerAppeal</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Partner salutation</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>عنوان خطاب شریک</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Modo di rivolgersi al partner</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Zwrot do partnera</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Обращение к партнеру</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İş ortağıyla iletişime geçme</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Liên lạc với đối tác</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentAmount</dataPath>
			<field>DocumentAmount</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PaymentDate</dataPath>
			<field>PaymentDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>EndOfPeriod</dataPath>
			<field>EndOfPeriod</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BeginOfPeriod</dataPath>
			<field>BeginOfPeriod</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IncomingDocumentDate</dataPath>
			<field>IncomingDocumentDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IncomingDocumentNumber</dataPath>
			<field>IncomingDocumentNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnerName_</dataPath>
			<field>PartnerName_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Partner name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نام شریک</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Nome del partner</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Nazwa partnera</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование партнера</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İş ortağının adı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tên gọi bạn hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	WriteOffReportFromCommissionAgent.Number,
	WriteOffReportFromCommissionAgent.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	WriteOffReportFromCommissionAgent.Manager,
	WriteOffReportFromCommissionAgent.Currency,
	WriteOffReportFromCommissionAgent.DocumentAmount,
	WriteOffReportFromCommissionAgent.Contract,
	WriteOffReportFromCommissionAgent.BeginOfPeriod,
	WriteOffReportFromCommissionAgent.EndOfPeriod,
	WriteOffReportFromCommissionAgent.PaymentDate,
	WriteOffReportFromCommissionAgent.IncomingDocumentNumber,
	WriteOffReportFromCommissionAgent.IncomingDocumentDate
FROM
	Document.WriteOffReportFromCommissionAgent AS WriteOffReportFromCommissionAgent
		{LEFT JOIN Catalog.Partners AS Partners
		ON WriteOffReportFromCommissionAgent.Partner = Partners.Ref}
WHERE
	WriteOffReportFromCommissionAgent.Ref = &amp;WriteOffReportFromCommissionAgent</query>
	</dataSet>
	<parameter>
		<name>WriteOffReportFromCommissionAgent</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Consignment stock adjustment</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تعدیل موجودی امانی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Report del commissionario sullo storno</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Raport komisanta ze spisania</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отчет комиссионера о списании</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Komisyon acentesi stok düzeltme raporu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Bảng kê hàng hóa ghi giảm của người nhận ký gửi</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.WriteOffReportFromCommissionAgent</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
