  <attributes>
    <name>ListReceiptDocuments</name>
    <title>
      <key>en</key>
      <value>List receipt documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست اسناد دریافت</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco documenti di arrivo</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista dokumentów wpływów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список документы поступления</value>
    </title>
    <title>
      <key>tr</key>
      <value>Teslim alım belgeleri listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách chứng từ tiếp nhận</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptDocuments.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListReceiptDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       VendorInvoice.Ref, 
       VendorInvoice.DeletionMark, 
       VendorInvoice.Number, 
       VendorInvoice.Date, 
       VendorInvoice.Posted, 
       VendorInvoice.Currency, 
       VendorInvoice.Partner, 
       VendorInvoice.BusinessOperation, 
       VendorInvoice.Department, 
       VendorInvoice.Warehouse, 
       VendorInvoice.Counterparty, 
       VendorInvoice.DocumentAmount, 
       VendorInvoice.AmountARAPByOrder, 
       VendorInvoice.Manager, 
       VendorInvoice.PurchaseOrder, 
       VendorInvoice.AdvanceHolder, 
       VendorInvoice.PriceIncludesVAT, 
       VendorInvoice.ARAPCurrency, 
       VendorInvoice.Comment, 
       VendorInvoice.PurchaseForActivity, 
       VendorInvoice.PaymentMethod, 
       VendorInvoice.Approved, 
       VendorInvoice.VATTaxation, 
       VendorInvoice.AmountARAP, 
       VendorInvoice.CompanyBankAccount, 
       VendorInvoice.IncomingDocumentNumber, 
       VendorInvoice.IncomingDocumentDate, 
       VendorInvoice.Shipper, 
       VendorInvoice.CounterpartyBankAccount, 
       VendorInvoice.ShipperBankAccount, 
       VendorInvoice.SalesOpportunity, 
       VendorInvoice.ReceivedBy, 
       VendorInvoice.AcceptedPosition, 
       VendorInvoice.ReceiptUnderOrders, 
       VendorInvoice.FinancialAccountingGroup, 
       VendorInvoice.RegisterVendorPrices, 
       VendorInvoice.Contract, 
       VendorInvoice.Author, 
       VendorInvoice.Director, 
       VendorInvoice.ARAPObjectSettings, 
       VendorInvoice.ToReturnReusablePackage, 
       VendorInvoice.ReusablePackagesReturnDate, 
       VendorInvoice.ReusablePackageFillingStatus, 
       VendorInvoice.PackageDepositIsRequired, 
       VendorInvoice.SubsequentDeliveryByDocument, 
       VendorInvoice.AdvancePurpose, 
       VendorInvoice.DocumentsCount, 
       VendorInvoice.SheetQuantity, 
       VendorInvoice.ChiefAccountant, 
       VendorInvoice.CashFlowItem, 
       VendorInvoice.DeliveryMethod, 
       VendorInvoice.CarrierPartner, 
       VendorInvoice.DeliveryZone, 
       VendorInvoice.DeliveryTimeFrom, 
       VendorInvoice.DeliveryTimeTo, 
       VendorInvoice.DeliveryAddress, 
       VendorInvoice.DeliveryAddressFieldValues, 
       VendorInvoice.AdditionalDeliveryInformation, 
       VendorInvoice.DeliveryAddressOfCarrier, 
       VendorInvoice.DeliveryAddressOfCarrierFieldValues, 
       VendorInvoice.SpecialTransportationConditions, 
       VendorInvoice.SpecialTransportationConditionsDescription, 
       VendorInvoice.LineOfBusiness,
       VendorInvoice.ThereAreAlcoholicProducts, 
       VendorInvoice.Terms, 
       VendorInvoice.Organization, 
       VendorInvoice.CourseNumerator, 
       VendorInvoice.CourseDenominator, 
       VendorInvoice.ThereAreProductsMarkedWithSPMS, 
       VendorInvoice.ThereAreSPMSControlIdentificationMarks, 
       VendorInvoice.GoodsReceiptOption, 
       VendorInvoice.AmountARAPByPackage, 
       VendorInvoice.ExpenseReport, 
       VendorInvoice.ExternalDocumentName, 
       VendorInvoice.Goods.*, 
       VendorInvoice.AdditionalAttributes.*, 
       VendorInvoice.ARAPDetails.*, 
       VendorInvoice.SetOfSeries.*, 
       VendorInvoice.InventoryKinds.*, 
       VendorInvoice.PaymentScheduleSteps.*, 
       VendorInvoice.PackageBarcodes.*, 
       VendorInvoice.PointInTime,
       //++ Localization
       CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
       //-- Localization
       EDStates.EDIState,
       EDStates.StatusPresentation
 FROM 
       Document.VendorInvoice AS VendorInvoice
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = VendorInvoice.Ref)
       </queryText>
      <mainTable>Document.VendorInvoice</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
