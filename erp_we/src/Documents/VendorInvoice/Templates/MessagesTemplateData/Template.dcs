		<field xsi:type="DataSetFieldField">
			<dataPath>IncomingDocumentNumber</dataPath>
			<field>IncomingDocumentNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnerName_</dataPath>
			<field>PartnerName_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Vendor name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نام تأمین‌کننده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Nominativo del fornitore</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Nazwa dostawcy</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование поставщика</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Tedarikçinin adı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tên nhà cung cấp</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VendorInvoice.Number,
	VendorInvoice.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	VendorInvoice.Warehouse,
	VendorInvoice.Manager,
	VendorInvoice.Currency,
	VendorInvoice.PaymentMethod,
	VendorInvoice.DocumentAmount,
	VendorInvoice.Contract,
	VendorInvoice.Shipper,
	VendorInvoice.CompanyBankAccount,
	VendorInvoice.IncomingDocumentNumber,
	VendorInvoice.IncomingDocumentDate
FROM
	Document.VendorInvoice AS VendorInvoice
		{LEFT JOIN Catalog.Partners AS Partners
		ON VendorInvoice.Partner = Partners.Ref}
WHERE
	VendorInvoice.Ref = &amp;VendorInvoice</query>
	</dataSet>
