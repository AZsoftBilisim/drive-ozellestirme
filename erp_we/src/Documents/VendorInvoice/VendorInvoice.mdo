      <synonym>
        <key>ru</key>
        <value>Количество</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Miktar</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Số lượng</value>
