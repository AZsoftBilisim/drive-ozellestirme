    <attributes uuid="9a31bd54-7b8a-4358-86fe-83066cfa6b2b">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
      <synonym>
