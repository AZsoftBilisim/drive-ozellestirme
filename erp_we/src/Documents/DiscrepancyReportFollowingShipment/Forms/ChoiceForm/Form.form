	DiscrepancyReportFollowingShipment.Partner,
	DiscrepancyReportFollowingShipment.Counterparty,
	DiscrepancyReportFollowingShipment.InsuranceCompany,
	DiscrepancyReportFollowingShipment.InsuranceCompanyCounterparty,
	DiscrepancyReportFollowingShipment.PurchaseContractNumber,
	DiscrepancyReportFollowingShipment.DateOfPurchaseContract,
	DiscrepancyReportFollowingShipment.CommercialReportNumber,
	DiscrepancyReportFollowingShipment.DateOfCommercialReport,
	DiscrepancyReportFollowingShipment.QualityCertificateNumber,
	DiscrepancyReportFollowingShipment.QualityCertificateDate,
	DiscrepancyReportFollowingShipment.VeterinaryCertificateNumber,
