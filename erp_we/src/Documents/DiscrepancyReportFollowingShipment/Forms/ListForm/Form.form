    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DiscrepancyReportFollowingShipment.Ref,
	DiscrepancyReportFollowingShipment.DeletionMark,
	DiscrepancyReportFollowingShipment.Number,
	DiscrepancyReportFollowingShipment.Date,
	DiscrepancyReportFollowingShipment.Posted,
	DiscrepancyReportFollowingShipment.Status,
	DiscrepancyReportFollowingShipment.Organization,
	DiscrepancyReportFollowingShipment.BaseDocumentForDrawingUpCertificate,
	DiscrepancyReportFollowingShipment.Currency,
	DiscrepancyReportFollowingShipment.PlaceForGoodsReceipt,
	DiscrepancyReportFollowingShipment.DateOfGoodsDelivery,
	DiscrepancyReportFollowingShipment.ListOfSupportingDocuments,
	DiscrepancyReportFollowingShipment.InvitedPartnerRepresentative,
	DiscrepancyReportFollowingShipment.DocumentKindForInvitationOfPartnerRepresentative,
	DiscrepancyReportFollowingShipment.NumberOfDocumentOnPartnerRepresentativeInvitation,
	DiscrepancyReportFollowingShipment.DateOfDocumentOnPartnerRepresentativeInvitation,
	DiscrepancyReportFollowingShipment.Shipper,
	DiscrepancyReportFollowingShipment.Manufacturer,
	DiscrepancyReportFollowingShipment.Partner,
	DiscrepancyReportFollowingShipment.Counterparty,
	DiscrepancyReportFollowingShipment.InsuranceCompany,
	DiscrepancyReportFollowingShipment.InsuranceCompanyCounterparty,
	DiscrepancyReportFollowingShipment.PurchaseContractNumber,
	DiscrepancyReportFollowingShipment.DateOfPurchaseContract,
	DiscrepancyReportFollowingShipment.CommercialReportNumber,
	DiscrepancyReportFollowingShipment.DateOfCommercialReport,
	DiscrepancyReportFollowingShipment.QualityCertificateNumber,
	DiscrepancyReportFollowingShipment.QualityCertificateDate,
	DiscrepancyReportFollowingShipment.VeterinaryCertificateNumber,
	DiscrepancyReportFollowingShipment.VeterinaryCertificateDate,
	DiscrepancyReportFollowingShipment.RailConsignmentNoteNumber,
	DiscrepancyReportFollowingShipment.RailConsignmentNoteDate,
	DiscrepancyReportFollowingShipment.BillOfLadingNumber,
	DiscrepancyReportFollowingShipment.BillOfLadingDate,
	DiscrepancyReportFollowingShipment.DeliveryMethod,
	DiscrepancyReportFollowingShipment.VehicleNumber,
	DiscrepancyReportFollowingShipment.DateOfGoodsDispatch,
	DiscrepancyReportFollowingShipment.DeparturePoint,
	DiscrepancyReportFollowingShipment.SenderWarehouse,
	DiscrepancyReportFollowingShipment.InformationOnTransportConditionAccordingToSupportingDocuments,
	DiscrepancyReportFollowingShipment.InformationOnActualTransportCondition,
	DiscrepancyReportFollowingShipment.GoodsStorageConditionsBeforeItsOpeningInDestinationWarehouse,
	DiscrepancyReportFollowingShipment.InformationOnTemperatureWhenUnloading,
	DiscrepancyReportFollowingShipment.PackageAndContainerCondition,
	DiscrepancyReportFollowingShipment.InformationOnExternalMarking,
	DiscrepancyReportFollowingShipment.PackageOpeningDate,
	DiscrepancyReportFollowingShipment.CompanyThatWeighedAndSealedGoods,
	DiscrepancyReportFollowingShipment.GoodsPickingProcedureForRandomInspection,
	DiscrepancyReportFollowingShipment.QuantityWeightMeasurementMethod,
	DiscrepancyReportFollowingShipment.PlaceToDetermineQuantityWeight,
	DiscrepancyReportFollowingShipment.InformationOnWeightMeasuringDevicesOperability,
	DiscrepancyReportFollowingShipment.OtherData,
	DiscrepancyReportFollowingShipment.DefectDetailedDescription,
	DiscrepancyReportFollowingShipment.CommissionConclusion,
	DiscrepancyReportFollowingShipment.Application,
	DiscrepancyReportFollowingShipment.DocumentCertifyingPowersOfVendorSRepresentative,
	DiscrepancyReportFollowingShipment.NumberOfDocumentCertifyingPowersOfVendorSRepresentative,
	DiscrepancyReportFollowingShipment.DateOfIssueOfDocumentConfirmingAuthorityOfPartnerRepresentative,
	DiscrepancyReportFollowingShipment.NumberOfAnnexSheets,
	DiscrepancyReportFollowingShipment.ExecutiveDecision,
	DiscrepancyReportFollowingShipment.WarehousemanWhoReceivedGoods,
	DiscrepancyReportFollowingShipment.GrossWeightAccordingToManufacturer,
	DiscrepancyReportFollowingShipment.GrossWeightAtDeparturePoint,
	DiscrepancyReportFollowingShipment.GrossWeightAtDestinationPoint,
	DiscrepancyReportFollowingShipment.NumberOfUnitLoadsAccordingToSenderDocuments,
	DiscrepancyReportFollowingShipment.NumberOfUnitLoadsAsReceived,
	DiscrepancyReportFollowingShipment.GrossWeightAccordingToSenderDocuments,
	DiscrepancyReportFollowingShipment.ActualGrossWeight,
	DiscrepancyReportFollowingShipment.NetWeightAccordingToSenderDocuments,
	DiscrepancyReportFollowingShipment.ActualNetWeight,
	DiscrepancyReportFollowingShipment.PackageWeightAccordingToSenderDocuments,
	DiscrepancyReportFollowingShipment.ActualPackageWeight,
	DiscrepancyReportFollowingShipment.FillingDegreeAccordingToSenderDocuments,
	DiscrepancyReportFollowingShipment.ActualFillingDegree,
	DiscrepancyReportFollowingShipment.CommissionChairperson,
	DiscrepancyReportFollowingShipment.JobTitleOfCommissionChairperson,
	DiscrepancyReportFollowingShipment.CommissionMember1,
	DiscrepancyReportFollowingShipment.CommitteeMemberJobTitle1,
	DiscrepancyReportFollowingShipment.CommissionMember2,
	DiscrepancyReportFollowingShipment.CommitteeMemberJobTitle2,
	DiscrepancyReportFollowingShipment.CommissionMember3,
	DiscrepancyReportFollowingShipment.CommitteeMemberJobTitle3,
	DiscrepancyReportFollowingShipment.Comment,
	DiscrepancyReportFollowingShipment.ContactPerson,
	DiscrepancyReportFollowingShipment.Director,
	DiscrepancyReportFollowingShipment.ChiefAccountant,
	DiscrepancyReportFollowingShipment.Terms,
	DiscrepancyReportFollowingShipment.Manager,
	DiscrepancyReportFollowingShipment.VATTaxation,
	DiscrepancyReportFollowingShipment.PriceIncludesVAT,
	DiscrepancyReportFollowingShipment.BusinessOperation,
	DiscrepancyReportFollowingShipment.Contract,
	DiscrepancyReportFollowingShipment.AdditionalInformation,
	DiscrepancyReportFollowingShipment.JobTitleExecutive,
	DiscrepancyReportFollowingShipment.TemperatureInsideMeatFish,
	DiscrepancyReportFollowingShipment.DiscrepanciesPostingMethod AS DiscrepanciesPostingMethod,
	CASE
		WHEN DiscrepancyReportFollowingShipment.DiscrepanciesPostingMethod = VALUE(Enum.MethodsOfRecordingDiscrepanciesCustomerReceivingNote.CorrectSourceDocuments)
			THEN &amp;StatusUpdate
		WHEN DiscrepancyReportFollowingShipment.DiscrepanciesPostingMethod = VALUE(Enum.MethodsOfRecordingDiscrepanciesCustomerReceivingNote.RegisterAdjustmentsAsSeparateBaseDocuments)
			THEN &amp;StatusAdjustmentAsNew
		WHEN DiscrepancyReportFollowingShipment.DiscrepanciesPostingMethod = VALUE(Enum.MethodsOfRecordingDiscrepanciesCustomerReceivingNote.RegisterAdjustmentErrorCorrection)
			THEN &amp;StatusCorrectionAsCorrection
	END AS DiscrepanciesPostingMethodPresentation,
	DiscrepancyReportFollowingShipment.TypeOfBaseDocumentForNonConformanceCertificate,
	DiscrepancyReportFollowingShipment.IncomingDocumentNumber,
	DiscrepancyReportFollowingShipment.IncomingDocumentDate,
	DiscrepancyReportFollowingShipment.Author,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.DiscrepancyReportFollowingShipment AS DiscrepancyReportFollowingShipment
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DiscrepancyReportFollowingShipment.Ref)	
WHERE
	DiscrepancyReportFollowingShipment.TypeOfBaseDocumentForNonConformanceCertificate IN(&amp;TypeOfBaseDocumentForNonConformanceCertificate)</queryText>
      <mainTable>Document.DiscrepancyReportFollowingShipment</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
