  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>Inventory consumption</value>
    </title>
    <title>
      <key>fa</key>
      <value>مصرف موجودی</value>
    </title>
    <title>
      <key>it</key>
      <value>Consumi interni</value>
    </title>
    <title>
      <key>pl</key>
      <value>Konsumpcje wewnętrzne</value>
    </title>
    <title>
      <key>ru</key>
      <value>Внутренние потребления</value>
    </title>
    <title>
      <key>tr</key>
      <value>İç tüketim</value>
    </title>
    <title>
      <key>vi</key>
      <value>Tiêu dùng trong nước</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	Documents.Ref,
	Documents.DeletionMark,
	Documents.Number,
	Documents.Date,
	Documents.Posted,
	Documents.Organization,
	Documents.Warehouse,
	Documents.InventoryConsumptionOrder,
	Documents.Department,
	Documents.EmployeeResponsible,
	Documents.Date AS ReferenceDate,
	Documents.PriceKind,
	Documents.SalesOpportunity,
	Documents.ConsumptionByOrders,
	Documents.BusinessOperation
FROM
	Document.InventoryConsumption AS Documents
	INNER JOIN Document.InventoryConsumption.Goods AS Rows
	    ON Rows.Ref = Documents.Ref
WHERE
    (&amp;Products &lt;> UNDEFINED AND Rows.Products = &amp;Products OR &amp;Products = UNDEFINED)
    AND (&amp;Characteristic &lt;> UNDEFINED AND Rows.Characteristic = &amp;Characteristic OR &amp;Characteristic = UNDEFINED)
