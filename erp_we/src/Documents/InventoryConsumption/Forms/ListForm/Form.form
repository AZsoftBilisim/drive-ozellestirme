    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentInventoryConsumption.Ref,
	DocumentInventoryConsumption.DeletionMark,
	DocumentInventoryConsumption.Number,
	DocumentInventoryConsumption.Date,
	DocumentInventoryConsumption.Posted,
	DocumentInventoryConsumption.Organization,
	DocumentInventoryConsumption.Warehouse,
	DocumentInventoryConsumption.InventoryConsumptionOrder,
	DocumentInventoryConsumption.Department,
	DocumentInventoryConsumption.EmployeeResponsible,
	DocumentInventoryConsumption.Comment,
	DocumentInventoryConsumption.PriceKind,
	DocumentInventoryConsumption.SalesOpportunity,
	DocumentInventoryConsumption.ConsumptionByOrders,
	DocumentInventoryConsumption.BusinessOperation,
	DocumentInventoryConsumption.ConsumptionForActivity,
	DocumentInventoryConsumption.ReusablePackageFillingStatus,
	DocumentInventoryConsumption.InventoryOwnerAttributesAreSpecifiedManually,
	DocumentInventoryConsumption.LineOfBusiness,
	DocumentInventoryConsumption.ThereAreSPMSControlIdentificationMarks,
	DocumentInventoryConsumption.ThereAreProductsMarkedWithSPMS,
	DocumentInventoryConsumption.DocumentBasis,
	DocumentInventoryConsumption.Goods,
	DocumentInventoryConsumption.InventoryKinds,
	DocumentInventoryConsumption.SetOfSeries,
	DocumentInventoryConsumption.AdditionalAttributes,
	DocumentInventoryConsumption.PointInTime,
    EDStates.EDIState,
    EDStates.StatusPresentation	
FROM
	Document.InventoryConsumption AS DocumentInventoryConsumption
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentInventoryConsumption.Ref)
	</queryText>
      <mainTable>Document.InventoryConsumption</mainTable>
