    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	AccrualOfCustomerRebates.Ref,
	AccrualOfCustomerRebates.DeletionMark,
	AccrualOfCustomerRebates.Number,
	AccrualOfCustomerRebates.Date,
	AccrualOfCustomerRebates.Posted,
	AccrualOfCustomerRebates.Organization,
	AccrualOfCustomerRebates.TermDocument,
	AccrualOfCustomerRebates.Counterparty,
	AccrualOfCustomerRebates.MultipleCounterparties,
	AccrualOfCustomerRebates.Partner,
	AccrualOfCustomerRebates.SeveralPartners,
	AccrualOfCustomerRebates.BeginOfPeriod,
	AccrualOfCustomerRebates.PeriodEnding,
	AccrualOfCustomerRebates.SettlementAmount_,
	AccrualOfCustomerRebates.AmountAccrued,
	AccrualOfCustomerRebates.Currency,
	AccrualOfCustomerRebates.EmployeeResponsible,
	AccrualOfCustomerRebates.Comment,
	AccrualOfCustomerRebates.Accruals.*,
	AccrualOfCustomerRebates.AdditionalAttributes.*,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
{SELECT
	HasFiles}
FROM
	Document.AccrualOfCustomerRebates AS AccrualOfCustomerRebates
		{LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON AccrualOfCustomerRebates.Ref = FilesExist.ObjectWithFiles}</queryText>
