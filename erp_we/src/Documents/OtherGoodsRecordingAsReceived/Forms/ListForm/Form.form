    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentOtherGoodsRecordingAsReceived.Ref,
	DocumentOtherGoodsRecordingAsReceived.DeletionMark,
	DocumentOtherGoodsRecordingAsReceived.Number,
	DocumentOtherGoodsRecordingAsReceived.Date,
	DocumentOtherGoodsRecordingAsReceived.Posted,
	DocumentOtherGoodsRecordingAsReceived.Organization,
	DocumentOtherGoodsRecordingAsReceived.Warehouse,
	DocumentOtherGoodsRecordingAsReceived.PriceKind,
	DocumentOtherGoodsRecordingAsReceived.Department,
	DocumentOtherGoodsRecordingAsReceived.EmployeeResponsible,
	DocumentOtherGoodsRecordingAsReceived.Comment,
	DocumentOtherGoodsRecordingAsReceived.BusinessOperation,
	DocumentOtherGoodsRecordingAsReceived.ReusablePackageFillingStatus,
	DocumentOtherGoodsRecordingAsReceived.DocumentBasis,
	DocumentOtherGoodsRecordingAsReceived.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.OtherGoodsRecordingAsReceived AS DocumentOtherGoodsRecordingAsReceived
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON EDStates.ObjectReference = DocumentOtherGoodsRecordingAsReceived.Ref
WHERE
	DocumentOtherGoodsRecordingAsReceived.BusinessOperation &lt;> VALUE(Enum.BusinessTransactions.ReturnFromProduction)</queryText>
      <mainTable>Document.OtherGoodsRecordingAsReceived</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
