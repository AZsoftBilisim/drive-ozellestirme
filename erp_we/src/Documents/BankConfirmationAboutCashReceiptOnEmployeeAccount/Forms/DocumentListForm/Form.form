    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Ref,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.DeletionMark,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Number,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Date,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Posted,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Organization,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Department,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.SourceDocument,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.PayrollCardProgram,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.HashOfFile,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.BriefDocumentComposition,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.EmployeeResponsible,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.Comment,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.EmployeesHR,
	DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount.PointInTime
FROM
	Document.BankConfirmationAboutCashReceiptOnEmployeeAccount AS DocumentBankConfirmationAboutCashReceiptOnEmployeeAccount</queryText>
