    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BankAccountIssue.Number AS Number,
	BankAccountIssue.Date AS Date,
	BankAccountIssue.Organization AS Organization,
	BankAccountIssue.BusinessOperation AS BusinessOperation,
	BankAccountIssue.Counterparty AS Counterparty,
	BankAccountIssue.DocumentAmount AS DocumentAmount,
	BankAccountIssue.Currency AS Currency,
	BankAccountIssue.Ref AS Ref,
	BankAccountIssue.ProcessedByBank AS ProcessedByBank,
	MAX(ISNULL(BankConfirmationAboutCashReceiptOnEmployeeAccount.Posted, FALSE)) AS ThereIsDocumentOfEnrollment
FROM
	Document.BankAccountIssue AS BankAccountIssue
		LEFT JOIN Document.BankConfirmationAboutCashReceiptOnEmployeeAccount AS BankConfirmationAboutCashReceiptOnEmployeeAccount
		ON BankAccountIssue.Ref = BankConfirmationAboutCashReceiptOnEmployeeAccount.SourceDocument
WHERE
	((BankAccountIssue.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
				AND BankAccountIssue.PersonsList
				AND &amp;UseCashDepositToListEmployees)
			OR (BankAccountIssue.BusinessOperation = VALUE(Enum.BusinessTransactions.SalaryPaymentByPayrollCardProgram)
				AND &amp;UsePayroll
				AND CASE
					WHEN NOT BankAccountIssue.ProcessedByBank
							OR BEGINOFPERIOD(BankAccountIssue.Date, DAY) = BankAccountIssue.BankPostingDate
							OR BankAccountIssue.Patch
						THEN BankAccountIssue.Date
					ELSE ENDOFPERIOD(BankAccountIssue.BankPostingDate, DAY)
				END >= &amp;StartDateOfSalaryTransferViaTransfersOnWay
				AND &amp;StartDateOfSalaryTransferViaTransfersOnWay &lt;> DATETIME(1, 1, 1)))
	AND BankAccountIssue.Posted

GROUP BY
	BankAccountIssue.Number,
	BankAccountIssue.Date,
	BankAccountIssue.Organization,
	BankAccountIssue.BusinessOperation,
	BankAccountIssue.Counterparty,
	BankAccountIssue.DocumentAmount,
	BankAccountIssue.Currency,
	BankAccountIssue.Ref,
	BankAccountIssue.ProcessedByBank
HAVING
	NOT MAX(ISNULL(BankConfirmationAboutCashReceiptOnEmployeeAccount.Posted, FALSE))</queryText>
      <mainTable>Document.BankAccountIssue</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
