      <queryText>
SELECT
	CashWithdrawalFromCashRegister.Ref AS Ref,
	CashWithdrawalFromCashRegister.Date AS Date,
	CashWithdrawalFromCashRegister.Number AS Number,
	CashWithdrawalFromCashRegister.Date AS PaymentDate,
