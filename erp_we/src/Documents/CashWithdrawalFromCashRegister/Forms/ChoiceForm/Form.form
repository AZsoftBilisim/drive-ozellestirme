	&amp;BusinessOperation AS BusinessOperation,
	
	CashWithdrawalFromCashRegister.CashRegister AS CashRegister,
	
	CashWithdrawalFromCashRegister.DocumentAmount AS DocumentAmount
	
FROM
	Document.CashWithdrawalFromCashRegister AS CashWithdrawalFromCashRegister
</queryText>
