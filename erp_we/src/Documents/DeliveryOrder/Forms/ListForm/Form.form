      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DeliveryOrder.Ref AS Ref,
	DeliveryOrder.DeletionMark AS DeletionMark,
	DeliveryOrder.Number AS Number,
	DeliveryOrder.Date AS Date,
	DeliveryOrder.Posted AS Posted,
	DeliveryOrder.DateOfShipment AS DateOfShipment,
	DeliveryOrder.DeliveryDirection AS DeliveryDirection,
	DeliveryOrder.Organization AS Organization,
	DeliveryOrder.DeliveryMethod AS DeliveryMethod,
	DeliveryOrder.Carrier AS Carrier,
	DeliveryOrder.Sender AS Sender,
	DeliveryOrder.SenderDeparturePoint AS SenderDeparturePoint,
	DeliveryOrder.Recipient AS Recipient,
	DeliveryOrder.DeliveryPointRecipient AS DeliveryPointRecipient,
	DeliveryOrder.DeliveryZone AS DeliveryZone,
	DeliveryOrder.CarrierDeliveryPoint AS CarrierDeliveryPoint,
	DeliveryOrder.DeliveryTimeFrom AS DeliveryTimeFrom,
	DeliveryOrder.DeliveryTimeTo AS DeliveryTimeTo,
	DeliveryOrder.EmployeeResponsible AS EmployeeResponsible,
	DeliveryOrder.Comment AS Comment,
	DeliveryOrder.AdditionalInformation AS AdditionalInformation,
	DeliveryOrder.SpecialTransportationConditions AS SpecialTransportationConditions,
	DeliveryOrder.SpecialTransportationConditionsDescription AS SpecialTransportationConditionsDescription,
	DeliveryOrder.DeliveryToCarrier AS DeliveryToCarrier,
	CASE
		WHEN DeliveryOrder.DeliveryToCarrier
			THEN DeliveryOrder.CarrierDeliveryPoint
		ELSE DeliveryOrder.DeliveryPointRecipient
	END AS DeliveryPoint,
	DeliveryOrder.CarrierSDeliveryArea AS CarrierSDeliveryArea,
	DeliveryOrder.Goods.*,
	DeliveryOrder.AdditionalAttributes.*,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
{SELECT
	HasFiles}
FROM
	Document.DeliveryOrder AS DeliveryOrder
		{LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON DeliveryOrder.Ref = FilesExist.ObjectWithFiles}</queryText>
      <mainTable>Document.DeliveryOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
