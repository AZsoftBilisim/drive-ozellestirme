      <queryText>SELECT
	AssignmentsOverridable.Ref AS Ref,
	AssignmentsOverridable.OrderDocument AS OrderDocument,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	CAST(&quot;&quot; AS STRING(50)) AS Comment,
	AssignmentsOverridable.LineOfBusiness AS LineOfBusiness,
	AssignmentsOverridable.Partner AS Partner,
	AssignmentsOverridable.Contract AS Contract,
	FALSE AS NoDirectionOfActivity,
	FALSE AS NoOrderRequired,
	FALSE AS WithoutAPartner,
	FALSE AS WithoutContract
FROM
	Catalog.Assignments AS AssignmentsOverridable</queryText>
