  <formCommands>
    <name>CreateReserveRemovalByAssignment</name>
    <title>
      <key>en</key>
      <value>Assignment removal</value>
    </title>
    <title>
      <key>fa</key>
      <value>حذف تخصیص</value>
    </title>
    <title>
      <key>it</key>
      <value>Annulla la prenotazione</value>
    </title>
    <title>
      <key>pl</key>
      <value>Usunięcie rezerwy</value>
    </title>
    <title>
      <key>ru</key>
      <value>Снятие резерва</value>
    </title>
    <title>
      <key>tr</key>
      <value>Rezervi kaldırma</value>
    </title>
    <title>
      <key>vi</key>
      <value>Rút dự phòng</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Create reserve removal by assignment</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>ایجاد حذف رزرو بر اساس تخصیص</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Crea annullamento della prenotazione per assegnazione</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Utwórz usunięcie rezerwy wg przeznaczenia</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Создать снятие резерва по назначению</value>
