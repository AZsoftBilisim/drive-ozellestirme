    <attributes uuid="9dec12cc-da24-4556-9175-993da00b03b0">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Quantità</value>
      </synonym>
      <synonym>
