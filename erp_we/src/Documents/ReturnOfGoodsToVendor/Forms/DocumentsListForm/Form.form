    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentReturnOfGoodsToVendor.Ref,
	DocumentReturnOfGoodsToVendor.Number,
	DocumentReturnOfGoodsToVendor.Date,
	DocumentReturnOfGoodsToVendor.Organization,
	DocumentReturnOfGoodsToVendor.Partner,
	DocumentReturnOfGoodsToVendor.Counterparty,
	DocumentReturnOfGoodsToVendor.Terms,
	DocumentReturnOfGoodsToVendor.Department,
	DocumentReturnOfGoodsToVendor.Currency,
	DocumentReturnOfGoodsToVendor.Warehouse,
	DocumentReturnOfGoodsToVendor.DocumentAmount,
	DocumentReturnOfGoodsToVendor.Manager,
	DocumentReturnOfGoodsToVendor.Comment,
	DocumentReturnOfGoodsToVendor.Contract,
	DocumentReturnOfGoodsToVendor.BusinessOperation,
	DocumentReturnOfGoodsToVendor.Author,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties,
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT
FROM
	Document.ReturnOfGoodsToVendor AS DocumentReturnOfGoodsToVendor
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentReturnOfGoodsToVendor.Ref)
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentReturnOfGoodsToVendor.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.ReturnOfGoodsToVendor</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
