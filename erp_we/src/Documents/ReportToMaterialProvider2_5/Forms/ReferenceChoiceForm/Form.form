    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	MaterialProviderOrder2_5.Ref AS Ref
INTO TheOrdersTable
FROM
	Document.MaterialProviderOrder2_5 AS MaterialProviderOrder2_5
WHERE
	MaterialProviderOrder2_5.Organization          = &amp;Organization
	AND MaterialProviderOrder2_5.Currency             = &amp;Currency
	AND MaterialProviderOrder2_5.Counterparty         = &amp;Counterparty
	AND MaterialProviderOrder2_5.Contract            = &amp;Contract
	AND MaterialProviderOrder2_5.Partner            = &amp;Partner
	AND MaterialProviderOrder2_5.SalesOpportunity             = &amp;SalesOpportunity
	AND MaterialProviderOrder2_5.BusinessOperation = &amp;BusinessOperation
	AND MaterialProviderOrder2_5.VATTaxation = &amp;VATTaxation
	AND (NOT &amp;UseLinesOfBusiness
		OR MaterialProviderOrder2_5.LineOfBusiness = &amp;LineOfBusiness)
	AND (MaterialProviderOrder2_5.Warehouse     = &amp;Warehouse
			OR MaterialProviderOrder2_5.Warehouse IN HIERARCHY (&amp;Warehouse)
			OR MaterialProviderOrder2_5.Warehouse = VALUE(Catalog.Warehouses.EmptyRef))
	AND MaterialProviderOrder2_5.Posted
	
INDEX BY
	Ref
;
////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	TableOfOrders.ReferenceOrder AS ReferenceOrder
INTO TableOfOrders
FROM
	(SELECT
		TableOfOrdersToBeProcessed.SalesOrder AS ReferenceOrder
	FROM
		(SELECT
			TurnoversByOrders.ReferenceOrder       AS SalesOrder,
			TurnoversByOrders.Products       AS Products,
			TurnoversByOrders.Characteristic     AS Characteristic,
			TurnoversByOrders.RowCode          AS RowCode,
			TurnoversByOrders.Warehouse              AS Warehouse,
			TurnoversByOrders.Series              AS Series,
			CASE
				WHEN TurnoversByOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
					THEN TurnoversByOrders.CountTurnover
				ELSE -TurnoversByOrders.CountTurnover
			END AS ToRegister
		FROM
			AccumulationRegister.ShipmentAndReturnReferences.Turnovers(
				,,, ReferenceOrder IN
					(SELECT
						TheOrdersTable.Ref AS Ref
					FROM
						TheOrdersTable AS TheOrdersTable)
				AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister),
					VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1))
				AND RowCode &lt;> 0) AS TurnoversByOrders
		
		UNION ALL
		
		SELECT
			ShipmentReferences.ReferenceOrder   AS SalesOrder,
			ShipmentReferences.Products   AS Products,
			ShipmentReferences.Characteristic AS Characteristic,
			ShipmentReferences.RowCode      AS RowCode,
			ShipmentReferences.Warehouse          AS Warehouse,
			ShipmentReferences.Series          AS Series,
			ShipmentReferences.Count AS ToRegister
		FROM
			AccumulationRegister.ShipmentAndReturnReferences AS ShipmentReferences
		WHERE
			ShipmentReferences.Active
			AND ShipmentReferences.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
			AND ShipmentReferences.Recorder = &amp;Recorder
			AND ShipmentReferences.ReferenceOrder IN
				(SELECT
					TheOrdersTable.Ref AS Ref
				FROM
					TheOrdersTable AS TheOrdersTable)
			AND ShipmentReferences.RowCode &lt;> 0) AS TableOfOrdersToBeProcessed
			
	GROUP BY
		TableOfOrdersToBeProcessed.SalesOrder,
		TableOfOrdersToBeProcessed.Products,
		TableOfOrdersToBeProcessed.Characteristic,
		TableOfOrdersToBeProcessed.RowCode,
		TableOfOrdersToBeProcessed.Warehouse,
		TableOfOrdersToBeProcessed.Series
		
	HAVING
		SUM(TableOfOrdersToBeProcessed.ToRegister) > 0
		
	UNION ALL
	
	SELECT
		TableOfOrdersOverAndAboveOrder.SalesOrder AS ReferenceOrder
	FROM
		(SELECT
			TurnoversByOrders.ReferenceOrder                                      AS SalesOrder,
			TurnoversByOrders.Products                                      AS Products,
			TurnoversByOrders.Characteristic                                    AS Characteristic,
			TurnoversByOrders.Warehouse                                             AS Warehouse,
			TurnoversByOrders.Series                                             AS Series,
			SUM(CASE
				WHEN TurnoversByOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
					THEN TurnoversByOrders.CountTurnover
				ELSE -TurnoversByOrders.CountTurnover
			END) AS ToRegister
		FROM
			AccumulationRegister.ShipmentAndReturnReferences.Turnovers(
				,,, ReferenceOrder IN
						(SELECT
							TheOrdersTable.Ref AS Ref
						FROM
							TheOrdersTable AS TheOrdersTable)
					AND Factor IN
						(VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1),
						VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip))
					AND RowCode = 0) AS TurnoversByOrders
		GROUP BY
			TurnoversByOrders.ReferenceOrder,
			TurnoversByOrders.Products,
			TurnoversByOrders.Characteristic,
			TurnoversByOrders.Warehouse,
			TurnoversByOrders.Series
		
		UNION ALL
		
		SELECT
			TurnoversByOrders.ReferenceOrder   AS SalesOrder,
			TurnoversByOrders.Products   AS Products,
			TurnoversByOrders.Characteristic AS Characteristic,
			TurnoversByOrders.Warehouse          AS Warehouse,
			TurnoversByOrders.Series          AS Series,
			TurnoversByOrders.Count AS ToRegister
		FROM
			AccumulationRegister.ShipmentAndReturnReferences AS TurnoversByOrders
		WHERE
			Active
			AND Recorder IN (&amp;Recorder)
			AND Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
			AND TurnoversByOrders.ReferenceOrder IN
				(SELECT
					TheOrdersTable.Ref AS Ref
				FROM
					TheOrdersTable AS TheOrdersTable)
			AND RowCode = 0) AS TableOfOrdersOverAndAboveOrder
			
	GROUP BY
		TableOfOrdersOverAndAboveOrder.SalesOrder,
		TableOfOrdersOverAndAboveOrder.Products,
		TableOfOrdersOverAndAboveOrder.Characteristic,
		TableOfOrdersOverAndAboveOrder.Warehouse,
		TableOfOrdersOverAndAboveOrder.Series
		
	HAVING
		SUM(TableOfOrdersOverAndAboveOrder.ToRegister) > 0) TableOfOrders
	
INDEX BY
	ReferenceOrder
;
////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	Orders.Ref                AS Ref,
	Orders.Date                  AS Date,
	Orders.Number                 AS Number,
	Orders.Partner               AS Partner,
	Orders.Counterparty            AS Counterparty,
	Orders.Organization           AS Organization,
	Orders.Contract               AS Contract,
	Orders.Warehouse                 AS Warehouse,
	Orders.Currency                AS Currency,
	Orders.Manager              AS Manager,
	Orders.Status                AS Status,
	Orders.DocumentAmount        AS DocumentAmount,
	Orders.Priority             AS Priority,
	Orders.BusinessOperation AS BusinessOperation,
	Orders.Purpose            AS Purpose,
	Orders.VATTaxation    AS VATTaxation,
	Orders.ARAPObjectSettings       AS ARAPObjectSettings,
	Orders.Comment           AS Comment,
	CASE
		WHEN Orders.Priority IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN Orders.Priority IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END                        AS PictureOfPriority
FROM
	 Document.MaterialProviderOrder2_5 AS Orders
		INNER JOIN TableOfOrders AS TableOfOrders
		ON Orders.Ref = TableOfOrders.ReferenceOrder</queryText>
