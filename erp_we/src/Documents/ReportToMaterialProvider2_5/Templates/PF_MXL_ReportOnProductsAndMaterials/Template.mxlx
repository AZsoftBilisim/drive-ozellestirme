	<rowsItem>
		<index>22</index>
		<row>
			<c>
				<i>1</i>
				<c>
					<f>36</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>The Customer does not have any complaints on volume or components of raw materials.																																																														</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>مشتری هیچ شکایتی درباره حجم یا اجزای مواد اولیه ندارد.																																																														</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Il committente non ha pretese sul volume e sulla composizione delle materie prime utilizzate.																																																														</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Klient nie ma roszczeń co do ilości i składu zużytych surowców.																																																														</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Заказчик претензий по объему и составу истраченного сырья не имеет.																																																														</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Müşterinin, kullanılan hammaddenin hacmi ve içeriğine ilişkin itirazları yoktur.																																																														</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Khách hàng không có khiếu nại liên quan đến khối lượng và thành phần của nguyên vật liệu đã sử dụng.																																																														</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
