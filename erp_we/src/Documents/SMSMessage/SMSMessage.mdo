  <attributes uuid="eb33a8fa-75a6-4926-a025-05bc0abe4374">
    <name>Subject</name>
    <synonym>
      <key>en</key>
      <value>Subject</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>موضوع</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Oggetto</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Temat</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Тема</value>
