    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentGoodsMisgrading.Ref,
	DocumentGoodsMisgrading.DeletionMark,
	DocumentGoodsMisgrading.Number,
	DocumentGoodsMisgrading.Date,
	DocumentGoodsMisgrading.Posted,
	DocumentGoodsMisgrading.Comment,
	DocumentGoodsMisgrading.Organization,
	DocumentGoodsMisgrading.EmployeeResponsible,
	DocumentGoodsMisgrading.Department,
	DocumentGoodsMisgrading.Warehouse,
	DocumentGoodsMisgrading.PriceKind,
	DocumentGoodsMisgrading.DimensionOfExpenses,
	DocumentGoodsMisgrading.ExpenseItem,
	DocumentGoodsMisgrading.DimensionOfRevenue,
	DocumentGoodsMisgrading.IncomeItem,
	DocumentGoodsMisgrading.ReceiveGoodsAtCostTheyWereIssuedFromWarehouse,
	DocumentGoodsMisgrading.InventoryOwnerAttributesAreSpecifiedManually,
	DocumentGoodsMisgrading.InventoryRecount,
	DocumentGoodsMisgrading.LineOfBusiness,
	DocumentGoodsMisgrading.VATActivityType,
	DocumentGoodsMisgrading.Currency,
	DocumentGoodsMisgrading.Goods,
	DocumentGoodsMisgrading.InventoryKinds,
	DocumentGoodsMisgrading.AdditionalAttributes,
	DocumentGoodsMisgrading.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	DocumentGoodsMisgrading.Author
FROM
	Document.GoodsMisgrading AS DocumentGoodsMisgrading
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentGoodsMisgrading.Ref)</queryText>
