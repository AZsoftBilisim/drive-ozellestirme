    <attributes uuid="789e962f-6fc6-4ea4-a8b5-ea0b1fea994b">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
