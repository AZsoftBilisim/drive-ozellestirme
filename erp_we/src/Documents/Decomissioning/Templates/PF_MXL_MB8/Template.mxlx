				<c>
					<f>27</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>for write-off of low-value
and short-life items</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>برای اسقاط اقلام کم‌ارزش
و کوتاه‌عمر</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>in storno degli elementi di poco valore o di
rapida movimentazione</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>do rozchodu przedmiotów o małej wartości i szybko 
zużywanych</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>на списание малоценных и быстроизнашивающихся
предметов</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>düşük maliyetli ve harcanabilir kalemlerin
 gider yazılması</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>để ghi giảm các mặt hàng có giá trị thấp và
nhanh hỏng</v8:content>
						</v8:item>
					</tl>
