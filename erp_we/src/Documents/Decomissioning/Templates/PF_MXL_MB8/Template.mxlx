	<rowsItem>
		<index>1</index>
		<row>
			<formatIndex>17</formatIndex>
			<c>
				<i>13</i>
				<c>
					<f>18</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Standard intersectoral form No. MB-8
Confirmed by decree of State Statistics Committee 
of the Russian Federation dated 10/30/97 No. 71-a</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>فرم استاندارد بین‌بخشی شماره MB-8
تأییدشده با مصوبه کمیته آمار دولتی 
فدراسیون روسیه مورخ 10/30/97 شماره 71-a</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Modulo di tipo interarea № MB-8
Approvato dal Servizio Federale di Statistica della Federazione Russa 
 dal  30.10.97 № 71-а</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Typowy formularz międzybranżowy nr MB-8
Zatwierdzony zarządzeniem Goskomstatu Rosji
от 30.10.97 nr 71-а</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Типовая межотраслевая форма № МБ-8
Утверждена постановлением Госкомстата России
от 30.10.97 № 71-а</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Rusya Devlet İstatistik Komitesi'nin 
30.10.97 tarih ve 71-a sayılı Kararı ile onaylanan MB-8 
 sayılı Standart Sektörlerarası Form</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Biểu mẫu liên ngành mẫu MB-8
Đã phê duyệt theo nghị định của Ủy ban thống kê Nga 
ngày 30.10.97 số 71-a</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
