						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Çekilme eylemlerinin numaraları ve tarihleri  _____________________________________________________________________________________________</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
