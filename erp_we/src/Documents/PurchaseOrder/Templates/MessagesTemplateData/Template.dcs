		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DocumentPurchaseOrder.Number,
	DocumentPurchaseOrder.Date,
	DocumentPurchaseOrder.Status,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	CASE
		WHEN DocumentPurchaseOrder.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.ConsignmentProcurement)
				AND DocumentPurchaseOrder.Posted
				AND DocumentPurchaseOrder.Status &lt;&gt; VALUE(Enum.PurchaseOrderStatuses.NotApproved)
				AND DocumentPurchaseOrder.DocumentAmount &gt; 0
			THEN CAST(ISNULL(VendorsARAPAccountingBalance.AmountDueReceipt, 0) AS NUMBER(31,2))
		ELSE 0
	END AS AmountPaid,
	CASE
		WHEN DocumentPurchaseOrder.Posted
				AND DocumentPurchaseOrder.Status &lt;&gt; VALUE(Enum.PurchaseOrderStatuses.NotApproved)
				AND DocumentPurchaseOrder.DocumentAmount &gt; 0
				AND ISNULL(SettlementsWithSuppliersBalancesAsOfDate.AmountDueBalance, 0) &lt; 0
			THEN CAST(-ISNULL(SettlementsWithSuppliersBalancesAsOfDate.AmountDueBalance, 0) AS NUMBER(31,2))
		ELSE 0
	END AS LatePaymentAmount,
	CASE
		WHEN DocumentPurchaseOrder.Posted
				AND DocumentPurchaseOrder.Status &lt;&gt; VALUE(Enum.PurchaseOrderStatuses.NotApproved)
				AND DocumentPurchaseOrder.Status &lt;&gt; VALUE(Enum.PurchaseOrderStatuses.Approved)
				AND DocumentPurchaseOrder.DocumentAmount &gt; 0
			THEN ISNULL(VendorsARAPAccountingBalance.ToReceiveExpense, 0)
		ELSE 0
	END AS ReceivedAmount,
	CASE
		WHEN DocumentPurchaseOrder.Posted
				AND DocumentPurchaseOrder.Status &lt;&gt; VALUE(Enum.PurchaseOrderStatuses.NotApproved)
				AND DocumentPurchaseOrder.DocumentAmount &gt; 0
				AND ISNULL(VendorsARAPAccountingBalance.SumClosingBalance, 0) &gt; 0
			THEN CAST(ISNULL(VendorsARAPAccountingBalance.SumClosingBalance, 0) AS NUMBER(31,2))
		ELSE 0
	END AS RemainingSupplierDebt,
	DocumentPurchaseOrder.Counterparty,
	DocumentPurchaseOrder.Organization,
	DocumentPurchaseOrder.Warehouse,
	DocumentPurchaseOrder.Currency,
	DocumentPurchaseOrder.Manager,
	DocumentPurchaseOrder.DocumentAmount,
	DocumentPurchaseOrder.AdditionalInformation,
	DocumentPurchaseOrder.RequestedDeliveryDate,
	DocumentPurchaseOrder.PaymentMethod,
	DocumentPurchaseOrder.BankAccount,
	DocumentPurchaseOrder.AmountAdvanceBeforeConfirmation,
	DocumentPurchaseOrder.PrepaymentAmountBeforeReceipt,
	DocumentPurchaseOrder.DocumentAmount - (DocumentPurchaseOrder.AmountAdvanceBeforeConfirmation + DocumentPurchaseOrder.PrepaymentAmountBeforeReceipt) AS LoanAmountAfterReceipt,
	DocumentPurchaseOrder.VendorReferenceNumber,
	DocumentPurchaseOrder.VendorReferenceDate,
	DocumentPurchaseOrder.Contract,
	DocumentPurchaseOrder.DateOfReceipt,
	CASE DocumentPurchaseOrder.DeliveryMethod
		WHEN VALUE(Enum.TransportMethods.ByVendorToOurWarehouse) THEN
			DocumentPurchaseOrder.DeliveryAddressForVendor
		WHEN VALUE(Enum.TransportMethods.ByCarrierToOurWarehouse) THEN
			DocumentPurchaseOrder.DeliveryAddressForVendor
		WHEN VALUE(Enum.TransportMethods.ByCarrierToTransferPoint) THEN
			DocumentPurchaseOrder.DeliveryAddressOfCarrier
		ELSE
			""""
	END													AS DeliveryAddress
FROM
	Document.PurchaseOrder AS DocumentPurchaseOrder
		{LEFT JOIN AccumulationRegister.PurchaseOrders.Balance(
				,
				PurchaseOrder = &amp;PurchaseOrder
					AND PurchaseOrder REFS Document.PurchaseOrder) AS PurchaseOrdersBalance
		ON (PurchaseOrdersBalance.PurchaseOrder = DocumentPurchaseOrder.Ref)
		LEFT JOIN Catalog.Partners AS Partners
		ON DocumentPurchaseOrder.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON DocumentPurchaseOrder.ContactPerson = ContactPersonsForPartners.Ref}
		{LEFT JOIN AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(
				,
				,
				,
				,
				ARAPObject.Object = &amp;PurchaseOrder
					AND ARAPObject.Object REFS Document.PurchaseOrder) AS VendorsARAPAccountingBalance
		ON DocumentPurchaseOrder.ARAPObject = VendorsARAPAccountingBalance.ARAPObject
		LEFT JOIN AccumulationRegister.VendorsARAPAccounting.Balance(
				&amp;CurrentDate,
				ARAPObject.Object = &amp;PurchaseOrder
					AND ARAPObject.Object REFS Document.PurchaseOrder) AS SettlementsWithSuppliersBalancesAsOfDate
		ON DocumentPurchaseOrder.ARAPObject = SettlementsWithSuppliersBalancesAsOfDate.ARAPObject}
WHERE
	DocumentPurchaseOrder.Ref = &amp;PurchaseOrder</query>
	</dataSet>
