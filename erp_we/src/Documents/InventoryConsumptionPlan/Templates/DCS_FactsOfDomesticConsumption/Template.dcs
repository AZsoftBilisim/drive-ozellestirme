		<dataSource>DataSource1</dataSource>
		<query>// !!! TAGS ARE USED !!!

SELECT ALLOWED
	DATEADD(GoodsInWarehousesTurnover.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset) Period,
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Products.ProductCategory AS ProductCategory,
	GoodsInWarehousesTurnover.Products.SalesRank AS SalesRank,
	ISNULL(GoodsInWarehousesTurnover.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	-GoodsInWarehousesTurnover.InStockTurnover AS FactsOfDomesticConsumption,
	GoodsInWarehousesTurnover.Purpose,
	CASE
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
			THEN ISNULL(GoodsInWarehousesTurnover.Recorder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
			THEN ISNULL(CAST(CAST(GoodsInWarehousesTurnover.Recorder AS Document.GoodsIssueNote).Recipient AS Catalog.BusinessStructure), VALUE(Catalog.BusinessStructure.EmptyRef))
		
		
		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END = &amp;FilterInternalConsumptionDepartment AS InternalConsumptionDepartment
INTO DomesticConsumerGoods
FROM
	AccumulationRegister.ProductStock.Turnovers(, , Auto, {(Warehouse = &amp;FilterWarehouse), (Purpose = &amp;FilterPurpose)}) AS GoodsInWarehousesTurnover
WHERE
	GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
	OR GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
	AND GoodsInWarehousesTurnover.Recorder.WarehouseOperation = VALUE(Enum.WarehouseTransactions.ShipmentForInternalNeeds)
	
	
{WHERE
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Warehouse AS Warehouse,
	(ISNULL(GoodsInWarehousesTurnover.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS Characteristic,
	(CASE WHEN GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
		THEN GoodsInWarehousesTurnover.Recorder.Department
	WHEN GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
		THEN GoodsInWarehousesTurnover.Recorder.Recipient
	
	
	END = &amp;FilterInternalConsumptionDepartment)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DomesticConsumerGoods.Period AS Period,
	DomesticConsumerGoods.Products AS Products,
	DomesticConsumerGoods.ProductCategory AS ProductCategory,
	DomesticConsumerGoods.SalesRank AS SalesRank,
	DomesticConsumerGoods.Characteristic AS Characteristic,
	DomesticConsumerGoods.FactsOfDomesticConsumption AS FactsOfDomesticConsumption,
	DomesticConsumerGoods.Purpose AS Purpose,
	DomesticConsumerGoods.InternalConsumptionDepartment AS InternalConsumptionDepartment
FROM
	DomesticConsumerGoods AS DomesticConsumerGoods 
{WHERE
	(CASE WHEN DomesticConsumerGoods.InternalConsumptionDepartment = VALUE(Catalog.BusinessStructure.EmptyRef) THEN &amp;FilterInternalConsumptionDepartment ELSE DomesticConsumerGoods.InternalConsumptionDepartment END) AS InternalConsumptionDepartment}</query>
	</dataSet>
	<totalField>
		<dataPath>FactsOfDomesticConsumption</dataPath>
		<expression>Sum(IsNull(FactsOfDomesticConsumption, 0))</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End</expression>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End</expression>
	</parameter>
	<parameter>
		<name>Periodicity</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
