		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Warehouse</dataPath>
			<field>Warehouse</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>
// !!! TAGS ARE USED !!!

SELECT ALLOWED DISTINCT
	GoodsInWarehousesTurnover.Products AS Products,
	ISNULL(GoodsInWarehousesTurnover.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	-GoodsInWarehousesTurnover.InStockTurnover AS WrittenOffGoods,
	ISNULL(GoodsInWarehousesTurnover.Purpose, VALUE(Catalog.Assignments.EmptyRef)) AS Purpose
FROM
	AccumulationRegister.ProductStock.Turnovers(, , Auto, ) AS GoodsInWarehousesTurnover
WHERE
	GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
{WHERE
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Warehouse AS Warehouse,
	(ISNULL(GoodsInWarehousesTurnover.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS Characteristic}
	


UNION ALL

SELECT
	GoodsInWarehousesTurnover.Products AS Products,
	ISNULL(GoodsInWarehousesTurnover.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	-GoodsInWarehousesTurnover.InStockTurnover AS WrittenOffGoods,
	ISNULL(GoodsInWarehousesTurnover.Purpose, VALUE(Catalog.Assignments.EmptyRef)) AS Purpose
FROM
	AccumulationRegister.ProductStock.Turnovers(, , Auto, ) AS GoodsInWarehousesTurnover
WHERE
	GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
	AND GoodsInWarehousesTurnover.Recorder.WarehouseOperation = VALUE(Enum.WarehouseTransactions.ShipmentForInternalNeeds)
{WHERE
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Warehouse AS Warehouse,
	(ISNULL(GoodsInWarehousesTurnover.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS Characteristic}</query>
	</dataSet>
	<totalField>
		<dataPath>WrittenOffGoods</dataPath>
		<expression>IsNull(Sum(WrittenOffGoods), 0)</expression>
	</totalField>
