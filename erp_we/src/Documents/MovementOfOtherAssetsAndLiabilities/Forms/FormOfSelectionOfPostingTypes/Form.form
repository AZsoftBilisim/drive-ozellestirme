  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Increase</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.LongDesc</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Recipient</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Source</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	Doc.Recipient,
	Doc.Source,
	Doc.Increase,
	Doc.LongDesc,
	CAST(CASE Doc.Recipient
		WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem) THEN
			CASE Doc.Increase
				WHEN TRUE THEN
					CASE Doc.Source
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.AssetItem)  THEN &amp;ReceiptOfAssetsAssets
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem) THEN &amp;ReceiptAssetsLiabilities
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem) THEN &amp;ReceiptAssetsExpenses
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)  THEN &amp;ReceiptOfAssetsIncome
						ELSE &quot;&quot;
					END
				ELSE
					CASE Doc.Source
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem) THEN &amp;ExpenseAssetsLiabilities
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem) THEN &amp;ExpenseAssetsExpense
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)  THEN &amp;ExpenseAssetsIncome
						ELSE &quot;&quot;
					END
			END
		WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem) THEN
			CASE Doc.Increase
				WHEN TRUE THEN
					CASE Doc.Source
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.LiabilityItem) THEN &amp;ReceiptLiabilitiesLiabilities
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem) THEN &amp;ReceiptsLiabilitiesExpenses
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)  THEN &amp;ReceiptsLiabilitiesIncome
						ELSE &quot;&quot;
					END
				ELSE
					CASE Doc.Source
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem) THEN &amp;ExpenseLiabilitiesExpenses
						WHEN VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem)  THEN &amp;ExpenseLiabilitiesIncome
						ELSE &quot;&quot;
					END
			END
		ELSE &quot;&quot;
	END AS STRING(1024)) AS MovementType
FROM
	Document.MovementOfOtherAssetsAndLiabilities AS Doc
WHERE
	Doc.Posted
	AND NOT Doc.Recipient IN(
		VALUE(Enum.TypesOfAssetAndLiabilityItems.IncomeItem),
		VALUE(Enum.TypesOfAssetAndLiabilityItems.ExpenseItem))
	AND NOT Doc.LongDesc = &quot;&quot;</queryText>
      <mainTable>Document.MovementOfOtherAssetsAndLiabilities</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
