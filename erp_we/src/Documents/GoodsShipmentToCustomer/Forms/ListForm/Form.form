    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       GoodsShipmentToCustomer.Ref, 
       GoodsShipmentToCustomer.DeletionMark, 
       GoodsShipmentToCustomer.Number, 
       GoodsShipmentToCustomer.Date, 
       GoodsShipmentToCustomer.Posted, 
       GoodsShipmentToCustomer.SalesOrder, 
       GoodsShipmentToCustomer.ShipmentByOrders, 
       GoodsShipmentToCustomer.Partner, 
       GoodsShipmentToCustomer.Counterparty, 
       GoodsShipmentToCustomer.CounterpartyBankAccount, 
       GoodsShipmentToCustomer.Terms, 
       GoodsShipmentToCustomer.BusinessOperation, 
       GoodsShipmentToCustomer.Organization, 
       GoodsShipmentToCustomer.CompanyBankAccount, 
       GoodsShipmentToCustomer.Contract, 
       GoodsShipmentToCustomer.Warehouse, 
       GoodsShipmentToCustomer.Currency, 
       GoodsShipmentToCustomer.Comment, 
       GoodsShipmentToCustomer.DeliveryMethod, 
       GoodsShipmentToCustomer.CarrierPartner, 
       GoodsShipmentToCustomer.DeliveryAddress, 
       GoodsShipmentToCustomer.DeliveryAddressFieldValues, 
       GoodsShipmentToCustomer.DeliveryAddressOfCarrier, 
       GoodsShipmentToCustomer.DeliveryAddressOfCarrierFieldValues, 
       GoodsShipmentToCustomer.DeliveryZone, 
       GoodsShipmentToCustomer.DeliveryTimeFrom, 
       GoodsShipmentToCustomer.DeliveryTimeTo, 
       GoodsShipmentToCustomer.AdditionalDeliveryInformation, 
       GoodsShipmentToCustomer.SpecialTransportationConditions, 
       GoodsShipmentToCustomer.SpecialTransportationConditionsDescription, 
       GoodsShipmentToCustomer.Manager, 
       GoodsShipmentToCustomer.SalesOpportunity, 
       GoodsShipmentToCustomer.ContactPerson, 
       GoodsShipmentToCustomer.Department, 
       GoodsShipmentToCustomer.LineOfBusiness, 
       GoodsShipmentToCustomer.InventoryOwnerAttributesAreSpecifiedManually, 
       GoodsShipmentToCustomer.SubsequentDeliveryByTransfer, 
       GoodsShipmentToCustomer.DocumentAmount, 
       GoodsShipmentToCustomer.Shipper, 
       GoodsShipmentToCustomer.ShipperBankAccount, 
       GoodsShipmentToCustomer.GoodsRecipient, 
       GoodsShipmentToCustomer.GoodsRecipientBankAccount, 
       GoodsShipmentToCustomer.Director, 
       GoodsShipmentToCustomer.ChiefAccountant, 
       GoodsShipmentToCustomer.IssuiedBy, 
       GoodsShipmentToCustomer.IssuiedByJobTitle, 
       GoodsShipmentToCustomer.Basis, 
       GoodsShipmentToCustomer.ReferenceDocumentDateForPrintForms, 
       GoodsShipmentToCustomer.BaseDocumentNumber, 
       GoodsShipmentToCustomer.Author, 
       GoodsShipmentToCustomer.LocalConversionRatio, 
       GoodsShipmentToCustomer.LetterOfAuthorityIssuedBy, 
       GoodsShipmentToCustomer.PowerOfAttorneyDate, 
       GoodsShipmentToCustomer.PowerOfAttorneyPerson, 
       GoodsShipmentToCustomer.PowerOfAttorneyNumber, 
       GoodsShipmentToCustomer.DeliveryAddressValue, 
       GoodsShipmentToCustomer.DeliveryAddressOfCarrierValue, 
       GoodsShipmentToCustomer.DeliveryPlanning, 
       GoodsShipmentToCustomer.DeliveryIsRequired, 
       GoodsShipmentToCustomer.Patch, 
       GoodsShipmentToCustomer.ReversedDocument, 
       GoodsShipmentToCustomer.CorrectedDocument, 
       GoodsShipmentToCustomer.DocumentBasis, 
       GoodsShipmentToCustomer.MaximumRowCode, 
       GoodsShipmentToCustomer.VATTaxation, 
       GoodsShipmentToCustomer.BaseDocumentOfDiscrepancyReportForCorrection, 
       GoodsShipmentToCustomer.BaseDocumentForDiscrepancyReport, 
       GoodsShipmentToCustomer.SpecialCircumstanceCode, 
       GoodsShipmentToCustomer.InformationOnTransportationAndCargo, 
       GoodsShipmentToCustomer.SupportingDocuments, 
       GoodsShipmentToCustomer.Goods.*, 
       GoodsShipmentToCustomer.InventoryKinds.*, 
       GoodsShipmentToCustomer.AdditionalAttributes.*, 
       GoodsShipmentToCustomer.SetOfSeries.*, 
       GoodsShipmentToCustomer.PackageBarcodes.*, 
       GoodsShipmentToCustomer.PointInTime,
       EDStates.EDIState,
       EDStates.StatusPresentation
FROM 
	Document.GoodsShipmentToCustomer AS  GoodsShipmentToCustomer
LEFT JOIN
	InformationRegister.StatesByEDIAccountingObjects AS EDStates
ON
	EDStates.ObjectReference = GoodsShipmentToCustomer.Ref</queryText>
      <mainTable>Document.GoodsShipmentToCustomer</mainTable>
