  <attributes uuid="1fa0166c-bea9-4696-86bd-5ce70b8995b9">
    <name>RentalServiceBalanceLocal</name>
    <synonym>
      <key>en</key>
      <value>Rental service (balance, local)</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>خدمات اجاره (مانده، محلی)</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Servizio relativo all'affitto (saldo, regolatorio)</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Usługa dotyczący dzierżawy (pozostałość, regl)</value>
    </synonym>
    <synonym>
      <key>ru</key>
      <value>Услуга по аренде (остаток, регл)</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Kiralama hizmeti (bakiye, yerel)</value>
    </synonym>
    <synonym>
      <key>vi</key>
      <value>Dịch vụ thuê (số dư, tài chính)</value>
    </synonym>
    <type>
      <types>DefinedType.MonetaryAmountNonNegative</types>
    </type>
    <toolTip>
      <key>en</key>
      <value>Balance of rental services in the local accounting currency</value>
    </toolTip>
