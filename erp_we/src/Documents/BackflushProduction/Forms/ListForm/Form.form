  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BackflushProduction.Ref,
	BackflushProduction.DeletionMark,
	BackflushProduction.Number,
	BackflushProduction.Date,
	BackflushProduction.Posted,
	BackflushProduction.Organization,
	BackflushProduction.Department,
	BackflushProduction.GroupCosts,
	BackflushProduction.ProductionIssueForActivity,
	BackflushProduction.LineOfBusiness,
	BackflushProduction.PriceKind,
	BackflushProduction.EmployeeResponsible,
	BackflushProduction.Comment,
	BackflushProduction.InventoryOwnerAttributesAreSpecifiedManually,
	BackflushProduction.Currency,
	BackflushProduction.ThereAreProductsMarkedWithSPMS,
	BackflushProduction.ReferenceOrderForLaborCosts,
	BackflushProduction.MaximumRowCodeFinishedProducts,
	BackflushProduction.MaximumRowCodeLaborCosts,
	BackflushProduction.MethodOfAllocatingFinishedProductCosts,
	BackflushProduction.ManufacturedProducts.*,
	BackflushProduction.BatchFinishedProducts.*,
	BackflushProduction.SideAndIntermediateRelease.*,
	BackflushProduction.BatchSideAndIntermediateRelease.*,
	BackflushProduction.MaterialsAndWorks.*,
	BackflushProduction.LaborCosts.*,
	BackflushProduction.AdditionalAttributes.*,
	BackflushProduction.InventoryOwnerAttributesMaterialsAndWorks.*,
	BackflushProduction.InventoryOwnerAttributesFinishedProducts.*,
	BackflushProduction.InventoryOwnerAttributesSideProducts.*,
	BackflushProduction.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	BackflushProduction.Author
FROM
	Document.BackflushProduction AS BackflushProduction
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = BackflushProduction.Ref)</queryText>
      <mainTable>Document.BackflushProduction</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
