  <attributes uuid="1a9971bf-e211-445a-b058-48e6b6fd45bb">
    <name>Count</name>
    <synonym>
      <key>en</key>
      <value>Quantity</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>مقدار</value>
    </synonym>
    <synonym>
