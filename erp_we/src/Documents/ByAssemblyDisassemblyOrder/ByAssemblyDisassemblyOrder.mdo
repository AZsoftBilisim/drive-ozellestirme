    <attributes uuid="aab1f1a8-7fae-4d77-ae88-3c7929d0d31d">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Count</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>شمارش</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Quantità</value>
      </synonym>
      <synonym>
        <key>pl</key>
        <value>Ilość</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Количество</value>
      </synonym>
      <synonym>
        <key>tr</key>
