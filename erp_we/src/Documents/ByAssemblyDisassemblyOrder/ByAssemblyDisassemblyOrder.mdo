  <attributes uuid="4ab5257a-9c1c-44f3-b0c7-281f6a83d4a7">
    <name>NumberOfPackages</name>
    <synonym>
      <key>en</key>
      <value>Quantity</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>مقدار</value>
    </synonym>
    <synonym>
