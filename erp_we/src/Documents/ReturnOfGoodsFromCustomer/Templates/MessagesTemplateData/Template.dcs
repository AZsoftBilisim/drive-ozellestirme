			<dataPath>CustomerDocumentNumber</dataPath>
			<field>CustomerDocumentNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashAccountIssueNoteNumber</dataPath>
			<field>CashAccountIssueNoteNumber</field>
