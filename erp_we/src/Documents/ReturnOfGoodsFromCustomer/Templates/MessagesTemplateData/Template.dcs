			<dataPath>Customer</dataPath>
			<field>Customer</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ReasonForReturn</dataPath>
			<field>ReasonForReturn</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CustomerDocumentSeries</dataPath>
			<field>CustomerDocumentSeries</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CustomerDocumentValidityPeriod</dataPath>
			<field>CustomerDocumentValidityPeriod</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentAmount</dataPath>
			<field>DocumentAmount</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashRegisterReceipt</dataPath>
			<field>CashRegisterReceipt</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Warehouse</dataPath>
			<field>Warehouse</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ReturnOfGoodsFromCustomer.Number,
	ReturnOfGoodsFromCustomer.Date,
	Partners.Description AS PartnerName_,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ReturnOfGoodsFromCustomer.Counterparty,
	ReturnOfGoodsFromCustomer.Currency,
	ReturnOfGoodsFromCustomer.DocumentAmount,
	ReturnOfGoodsFromCustomer.CashRegisterReceipt,
	ReturnOfGoodsFromCustomer.IncomingDocumentNumber,
	ReturnOfGoodsFromCustomer.IncomingDocumentDate,
	ReturnOfGoodsFromCustomer.CashIssued,
	ReturnOfGoodsFromCustomer.CashAccountIssueNoteNumber,
	ReturnOfGoodsFromCustomer.CashAccountIssueNoteDate,
	ReturnOfGoodsFromCustomer.Contract,
	ReturnOfGoodsFromCustomer.CustomerDocumentKind,
	ReturnOfGoodsFromCustomer.CustomerDocumentSeries,
	ReturnOfGoodsFromCustomer.CustomerDocumentNumber,
	ReturnOfGoodsFromCustomer.DateOfCustomerDocumentIssue,
	ReturnOfGoodsFromCustomer.CustomerDocumentValidityPeriod,
	ReturnOfGoodsFromCustomer.IssuingAuthorityOfCustomerDocument,
	ReturnOfGoodsFromCustomer.CustomerDocumentBusinessUnitCode,
	ReturnOfGoodsFromCustomer.CustomerSDateOfBirth,
	ReturnOfGoodsFromCustomer.Customer,
	ReturnOfGoodsFromCustomer.ReasonForReturn,
	ReturnOfGoodsFromCustomer.Warehouse
FROM
	Document.ReturnOfGoodsFromCustomer AS ReturnOfGoodsFromCustomer
		LEFT JOIN Catalog.Partners AS Partners
		ON ReturnOfGoodsFromCustomer.Partner = Partners.Ref
WHERE
	ReturnOfGoodsFromCustomer.Ref = &amp;ReturnOfGoodsFromCustomer</query>
	</dataSet>
