  <attributes>
    <name>ListGoodsReturnsFromCustomers</name>
    <title>
      <key>en</key>
      <value>List sales returns</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست برگشت‌های فروش</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco resi della merce dai clienti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista zwrotu towarów od klientów</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список возвраты товаров от клиентов</value>
    </title>
    <title>
      <key>tr</key>
      <value>Müşterilerden gelen ürün iadelerinin listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách nhận hàng bán bị trả lại</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListGoodsReturnsFromCustomers.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ReturnOfGoodsFromCustomer.Ref,
	ReturnOfGoodsFromCustomer.DeletionMark,
	ReturnOfGoodsFromCustomer.Number,
	ReturnOfGoodsFromCustomer.Date,
	ReturnOfGoodsFromCustomer.Posted,
	ReturnOfGoodsFromCustomer.Organization,
	ReturnOfGoodsFromCustomer.Partner,
	ReturnOfGoodsFromCustomer.Terms,
	ReturnOfGoodsFromCustomer.SalesOpportunity,
	ReturnOfGoodsFromCustomer.Currency,
	ReturnOfGoodsFromCustomer.DocumentAmount,
	ReturnOfGoodsFromCustomer.Warehouse,
	ReturnOfGoodsFromCustomer.PriceIncludesVAT,
	ReturnOfGoodsFromCustomer.Department,
	ReturnOfGoodsFromCustomer.Manager,
	ReturnOfGoodsFromCustomer.Comment,
	ReturnOfGoodsFromCustomer.DocumentSalesOfGoodsAndServices,
	ReturnOfGoodsFromCustomer.VATTaxation,
	ReturnOfGoodsFromCustomer.BusinessOperation,
	ReturnOfGoodsFromCustomer.CashRegisterReceipt,
	ReturnOfGoodsFromCustomer.RequestForReturnOfGoodsFromCustomer,
	ReturnOfGoodsFromCustomer.IncomingDocumentNumber,
	ReturnOfGoodsFromCustomer.IncomingDocumentDate,
	ReturnOfGoodsFromCustomer.CashIssued,
	ReturnOfGoodsFromCustomer.CashAccountIssueNoteNumber,
	ReturnOfGoodsFromCustomer.CashAccountIssueNoteDate,
	ReturnOfGoodsFromCustomer.ReturnOfSpoiledGoods,
	ReturnOfGoodsFromCustomer.Contract,
	ReturnOfGoodsFromCustomer.CustomerDocumentKind,
	ReturnOfGoodsFromCustomer.CustomerDocumentSeries,
	ReturnOfGoodsFromCustomer.CustomerDocumentNumber,
	ReturnOfGoodsFromCustomer.DateOfCustomerDocumentIssue,
	ReturnOfGoodsFromCustomer.CustomerDocumentValidityPeriod,
	ReturnOfGoodsFromCustomer.IssuingAuthorityOfCustomerDocument,
	ReturnOfGoodsFromCustomer.CustomerDocumentBusinessUnitCode,
	ReturnOfGoodsFromCustomer.CustomerSDateOfBirth,
	ReturnOfGoodsFromCustomer.Customer,
	ReturnOfGoodsFromCustomer.ReasonForReturn,
	ReturnOfGoodsFromCustomer.FinancialAccountingGroup,
	ReturnOfGoodsFromCustomer.ReusablePackageReturn,
	ReturnOfGoodsFromCustomer.ReusablePackageFillingStatus,
	ReturnOfGoodsFromCustomer.InventoryOwnerAttributesAreSpecifiedManually,
	ReturnOfGoodsFromCustomer.DepositForPackageIsRequired,
	ReturnOfGoodsFromCustomer.CompensationMethod,
	ReturnOfGoodsFromCustomer.ARAPObjectSettings,
	ReturnOfGoodsFromCustomer.ContactPerson,
	ReturnOfGoodsFromCustomer.CustomerVATExempt,
	ReturnOfGoodsFromCustomer.AdditionalReturnWithinGoodsReturn,
	ReturnOfGoodsFromCustomer.LineOfBusiness,
	ReturnOfGoodsFromCustomer.Counterparty,
	ReturnOfGoodsFromCustomer.ThereAreProductsMarkedWithSPMS,
	ReturnOfGoodsFromCustomer.GoodsReceiptOption,
	ReturnOfGoodsFromCustomer.ForeignCurrencyTransaction,
	ReturnOfGoodsFromCustomer.ARAPObject,
	ReturnOfGoodsFromCustomer.Goods.*,
	ReturnOfGoodsFromCustomer.InventoryKinds.*,
	ReturnOfGoodsFromCustomer.SetOfSeries.*,
	ReturnOfGoodsFromCustomer.BonusPointAccrual.*,
	ReturnOfGoodsFromCustomer.PaymentWithBonusPoints.*,
	ReturnOfGoodsFromCustomer.PackageBarcodes.*,
	ReturnOfGoodsFromCustomer.ARAPDetails.*,
	ReturnOfGoodsFromCustomer.AdditionalAttributes.*,
	ReturnOfGoodsFromCustomer.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	//++ Localization
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
	//-- Localization
	ReturnOfGoodsFromCustomer.Author
FROM
	Document.ReturnOfGoodsFromCustomer AS ReturnOfGoodsFromCustomer
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = ReturnOfGoodsFromCustomer.Ref)</queryText>
      <mainTable>Document.ReturnOfGoodsFromCustomer</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
