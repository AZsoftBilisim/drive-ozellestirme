      </synonym>
      <synonym>
        <key>ru</key>
        <value>Количество (в единицах хранения)</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Miktar (stok ölçü birimi cinsinden)</value>
      </synonym>
      <synonym>
