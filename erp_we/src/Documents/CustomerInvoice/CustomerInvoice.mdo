    <attributes uuid="dd1bc455-8a60-471b-b399-200f0a65a03e">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
