    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomerInvoice.Ref,
	CustomerInvoice.DeletionMark,
	CustomerInvoice.Number,
	CustomerInvoice.Date,
	CustomerInvoice.Posted,
	CustomerInvoice.DeliveryAddress,
	CustomerInvoice.CompanyBankAccount,
	CustomerInvoice.CounterpartyBankAccount,
	CustomerInvoice.ShipperBankAccount,
	CustomerInvoice.GoodsRecipientBankAccount,
	CustomerInvoice.Currency,
	CustomerInvoice.ARAPCurrency,
	CustomerInvoice.Shipper,
	CustomerInvoice.GoodsRecipient,
	CustomerInvoice.LetterOfAuthorityIssuedBy,
	CustomerInvoice.PowerOfAttorneyDate,
	CustomerInvoice.PowerOfAttorneyPerson,
	CustomerInvoice.PowerOfAttorneyNumber,
	CustomerInvoice.SalesOrder,
	CustomerInvoice.Organization,
	CustomerInvoice.Counterparty,
	CustomerInvoice.Manager,
	CustomerInvoice.VATTaxation,
	CustomerInvoice.DocumentAmount,
	CustomerInvoice.Partner,
	CustomerInvoice.Department,
	CustomerInvoice.SalesOpportunity,
	CustomerInvoice.DiscountsAreCalculated,
	CustomerInvoice.Warehouse,
	CustomerInvoice.Approved,
	CustomerInvoice.Terms,
	CustomerInvoice.AmountARAP,
	CustomerInvoice.Comment,
	CustomerInvoice.PaymentMethod,
	CustomerInvoice.BusinessOperation,
	CustomerInvoice.PriceIncludesVAT,
	CustomerInvoice.CashAccount,
	CustomerInvoice.IssuiedBy,
	CustomerInvoice.IssuiedByJobTitle,
	CustomerInvoice.OrderSales,
	CustomerInvoice.FinancialAccountingGroup,
	CustomerInvoice.LoyaltyCard,
	CustomerInvoice.Contract,
	CustomerInvoice.Basis,
	CustomerInvoice.Status,
	CustomerInvoice.Author,
	CustomerInvoice.DeliveryMethod,
	CustomerInvoice.DeliveryZone,
	CustomerInvoice.DeliveryAddressFieldValues,
	CustomerInvoice.CarrierPartner,
	CustomerInvoice.DeliveryTimeFrom,
	CustomerInvoice.DeliveryTimeTo,
	CustomerInvoice.DeliveryAddressOfCarrier,
	CustomerInvoice.DeliveryAddressOfCarrierFieldValues,
	CustomerInvoice.DeliveryIsRequired,
	CustomerInvoice.DeliveryPlanning,
	CustomerInvoice.AdditionalDeliveryInformation,
	CustomerInvoice.ContactPerson,
	CustomerInvoice.Director,
	CustomerInvoice.ChiefAccountant,
	CustomerInvoice.ARAPObjectSettings,
	CustomerInvoice.ToReturnReusablePackage,
	CustomerInvoice.ReusablePackagesReturnDate,
	CustomerInvoice.ReusablePackageFillingStatus,
	CustomerInvoice.InventoryOwnerAttributesAreSpecifiedManually,
	CustomerInvoice.PackageDepositIsRequired,
	CustomerInvoice.ReferenceDocumentDateForPrintForms,
	CustomerInvoice.BaseDocumentNumber,
	CustomerInvoice.SubsequentDeliveryBySale,
	CustomerInvoice.DateOfTransferOfTitleToGoods,
	CustomerInvoice.SaleRegistrationOption,
	CustomerInvoice.PaymentID,
	CustomerInvoice.SpecialTransportationConditions,
	CustomerInvoice.SpecialTransportationConditionsDescription,
	CustomerInvoice.LineOfBusiness,
	CustomerInvoice.CourseNumerator,
	CustomerInvoice.CourseDenominator,
	CustomerInvoice.ThereAreProductsMarkedWithSPMS,
	CustomerInvoice.AmountARAPByPackage,
	CustomerInvoice.Goods.*,
	CustomerInvoice.DiscountsMarkups.*,
	CustomerInvoice.InventoryKinds.*,
	CustomerInvoice.AdditionalAttributes.*,
	CustomerInvoice.ARAPDetails.*,
	CustomerInvoice.SetOfSeries.*,
	CustomerInvoice.PaymentScheduleSteps.*,
	CustomerInvoice.PackageBarcodes.*,
	CustomerInvoice.PointInTime,
	//++ Localization
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
	//-- Localization
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.CustomerInvoice AS CustomerInvoice
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = CustomerInvoice.Ref)</queryText>
      <mainTable>Document.CustomerInvoice</mainTable>
