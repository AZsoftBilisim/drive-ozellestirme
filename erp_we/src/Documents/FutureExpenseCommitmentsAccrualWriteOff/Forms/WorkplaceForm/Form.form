  <attributes>
    <name>ForRecord</name>
    <title>
      <key>en</key>
      <value>For record</value>
    </title>
    <title>
      <key>fa</key>
      <value>برای ثبت</value>
    </title>
    <title>
      <key>it</key>
      <value>Da visualizzare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Do odzwierciedlenia</value>
    </title>
    <title>
      <key>ru</key>
      <value>К отражению</value>
    </title>
    <title>
      <key>tr</key>
      <value>Yansıtılacak</value>
    </title>
    <title>
      <key>vi</key>
      <value>Để phản ánh</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ForRecord.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ForRecord.ReserveKind</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	ReflectedDocuments.Organization AS Organization,
	ReflectedDocuments.ReserveKind AS ReserveKind
INTO SecondaryDocuments
FROM
	Document.FutureExpenseCommitmentsAccrualWriteOff AS ReflectedDocuments
WHERE
	ReflectedDocuments.Date = &amp;EndOfPeriod
	AND ReflectedDocuments.Posted
	AND (&amp;AllCompanies OR ReflectedDocuments.Organization IN (&amp;CompanyArray))
INDEX BY
Organization,
ReserveKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FutureExpenseCommitments.Organization,
	FutureExpenseCommitments.ReserveKind
INTO TueReserveBalances
FROM
	AccumulationRegister.FutureExpenseCommitments.Balance(&amp;EndOfPeriod, Organization IN (&amp;CompanyArray) OR &amp;AllCompanies) AS FutureExpenseCommitments
		LEFT JOIN SecondaryDocuments AS ReflectedDocuments
		ON ReflectedDocuments.Organization = FutureExpenseCommitments.Organization
			AND ReflectedDocuments.ReserveKind = FutureExpenseCommitments.ReserveKind
WHERE
	ReflectedDocuments.Organization IS NULL
	AND (FutureExpenseCommitments.SumManBalance &lt; 0
			OR FutureExpenseCommitments.SumComplBalance &lt; 0)
INDEX BY
FutureExpenseCommitments.Organization,
FutureExpenseCommitments.ReserveKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProvisionObjects.Organization AS Organization,
	ProvisionObjects.ReserveKind AS ReserveKind
FROM
	Catalog.AccountingObjectsOfFutureExpenseCommitments AS ProvisionObjects
		LEFT JOIN SecondaryDocuments AS ReflectedDocuments
		ON ReflectedDocuments.Organization = ProvisionObjects.Organization
			AND ReflectedDocuments.ReserveKind = ProvisionObjects.ReserveKind
		LEFT JOIN TueReserveBalances AS Balance
		ON Balance.Organization = ProvisionObjects.Organization
			AND Balance.ReserveKind = ProvisionObjects.ReserveKind
		
WHERE
	(ReflectedDocuments.Organization IS NULL
	AND ProvisionObjects.BeginOfPeriod &lt;= &amp;EndOfPeriod
	AND (ProvisionObjects.EndOfPeriod = DATETIME(1, 1, 1)
			OR ProvisionObjects.EndOfPeriod > &amp;EndOfPeriod)
	AND (ProvisionObjects.Organization IN(&amp;CompanyArray)
			OR &amp;AllCompanies)
	AND NOT ProvisionObjects.DeletionMark)
	OR NOT Balance.Organization IS NULL</queryText>
      <mainTable>Catalog.AccountingObjectsOfFutureExpenseCommitments</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
