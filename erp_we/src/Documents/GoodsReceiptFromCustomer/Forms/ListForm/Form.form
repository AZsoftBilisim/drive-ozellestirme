    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	GoodsReceiptFromCustomer.Ref,
	GoodsReceiptFromCustomer.DeletionMark,
	GoodsReceiptFromCustomer.Number,
	GoodsReceiptFromCustomer.Date,
	GoodsReceiptFromCustomer.Posted,
	GoodsReceiptFromCustomer.Partner,
	GoodsReceiptFromCustomer.Counterparty,
	GoodsReceiptFromCustomer.Terms,
	GoodsReceiptFromCustomer.BusinessOperation,
	GoodsReceiptFromCustomer.Organization,
	GoodsReceiptFromCustomer.Contract,
	GoodsReceiptFromCustomer.Warehouse,
	GoodsReceiptFromCustomer.Currency,
	GoodsReceiptFromCustomer.Comment,
	GoodsReceiptFromCustomer.Manager,
	GoodsReceiptFromCustomer.SalesOpportunity,
	GoodsReceiptFromCustomer.Department,
	GoodsReceiptFromCustomer.LineOfBusiness,
	GoodsReceiptFromCustomer.InventoryOwnerAttributesAreSpecifiedManually,
	GoodsReceiptFromCustomer.IncomingDocumentNumber,
	GoodsReceiptFromCustomer.IncomingDocumentDate,
	GoodsReceiptFromCustomer.DocumentAmount,
	GoodsReceiptFromCustomer.Author,
	GoodsReceiptFromCustomer.ExternalDocumentName,
	GoodsReceiptFromCustomer.Patch,
	GoodsReceiptFromCustomer.ReversedDocument,
	GoodsReceiptFromCustomer.CorrectedDocument,
	GoodsReceiptFromCustomer.DocumentBasis,
	GoodsReceiptFromCustomer.DateOfReceipt,
	GoodsReceiptFromCustomer.GoodsReceiptOption,
	GoodsReceiptFromCustomer.ReturnOfSpoiledGoods,
	GoodsReceiptFromCustomer.ReferenceOrder,
	GoodsReceiptFromCustomer.BaseDocumentForDiscrepancyReport,
	GoodsReceiptFromCustomer.ReduceShipmentByReference,
	GoodsReceiptFromCustomer.Goods,
	GoodsReceiptFromCustomer.InventoryKinds,
	GoodsReceiptFromCustomer.AdditionalAttributes,
	GoodsReceiptFromCustomer.SetOfSeries,
	GoodsReceiptFromCustomer.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.GoodsReceiptFromCustomer AS GoodsReceiptFromCustomer
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = GoodsReceiptFromCustomer.Ref)</queryText>
      <mainTable>Document.GoodsReceiptFromCustomer</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
