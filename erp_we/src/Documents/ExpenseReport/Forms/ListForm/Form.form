  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentExpenseReport.Ref AS Ref,
	DocumentExpenseReport.DeletionMark AS DeletionMark,
	DocumentExpenseReport.Number AS Number,
	DocumentExpenseReport.Date AS Date,
	DocumentExpenseReport.Posted AS Posted,
	DocumentExpenseReport.Organization AS Organization,
	DocumentExpenseReport.AdvanceHolder AS AdvanceHolder,
	DocumentExpenseReport.Currency AS Currency,
	DocumentExpenseReport.Status,
	DocumentExpenseReport.AdvancePurpose AS AdvancePurpose,
	DocumentExpenseReport.DocumentsCount AS DocumentsCount,
	DocumentExpenseReport.SheetQuantity AS SheetQuantity,
	DocumentExpenseReport.Department AS Department,
	DocumentExpenseReport.Comment AS Comment,
	DocumentExpenseReport.Author AS Author,
	DocumentExpenseReport.Director AS Director,
	DocumentExpenseReport.ChiefAccountant AS ChiefAccountant,
	DocumentExpenseReport.BankAccount AS BankAccount,
	DocumentExpenseReport.AmountExpensed AS AmountExpensed,
	DocumentsRegistry.Sum AS DocumentAmount,
	DocumentExpenseReport.AmountRejected AS AmountRejected,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties,
    EDStates.EDIState,
    EDStates.StatusPresentation	
FROM
	Document.ExpenseReport AS DocumentExpenseReport
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentExpenseReport.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentExpenseReport.Ref)
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON DocumentExpenseReport.Ref = DocumentsRegistry.Ref
			AND (NOT DocumentsRegistry.AdditionalRecord)
			</queryText>
      <mainTable>Document.ExpenseReport</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
