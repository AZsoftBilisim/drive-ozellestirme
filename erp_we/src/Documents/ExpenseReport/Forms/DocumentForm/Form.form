      <value>Dokument zakupu</value>
    </title>
    <title>
      <key>ru</key>
      <value>Документы закупки</value>
    </title>
    <title>
      <key>tr</key>
      <value>Satın alma belgeleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Chứng từ mua hàng</value>
    </title>
    <id>25</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE
		WHEN DocumentDataOverridable.IncomingDocumentNumber = &quot;&quot; THEN
			DocumentData.IncomingDocumentNumber
		ELSE
			DocumentDataOverridable.IncomingDocumentNumber
	END AS IncomingDocumentNumber,
	CASE
		WHEN DocumentDataOverridable.IncomingDocumentDate = DATETIME(1,1,1) THEN
			DocumentData.IncomingDocumentDate
		ELSE
			DocumentDataOverridable.IncomingDocumentDate
	END AS IncomingDocumentDate,
	CASE
		WHEN DocumentDataOverridable.ExternalDocumentName = &quot;&quot; THEN
			DocumentData.ExternalDocumentName
		ELSE
			DocumentDataOverridable.ExternalDocumentName
	END AS ExternalDocumentName,
	DocumentData.Currency                           AS Currency,
	DocumentData.CashFlowItem    AS CashFlowItem,
	DocumentData.Ref                           AS DocumentPurchases,
	DocumentData.Counterparty                       AS Counterparty,
	SUM(DocumentDataOverridable.AmountIncludingVAT) AS Sum
FROM
	Document.VendorInvoice.Goods AS DocumentDataOverridable
		INNER JOIN Document.VendorInvoice AS DocumentData
		ON DocumentDataOverridable.Ref = DocumentData.Ref
WHERE
	DocumentData.Ref IN (&amp;PurchasingDocumentsList)
	AND DocumentData.Posted
GROUP BY
	CASE
		WHEN DocumentDataOverridable.IncomingDocumentNumber = &quot;&quot; THEN
			DocumentData.IncomingDocumentNumber
		ELSE
			DocumentDataOverridable.IncomingDocumentNumber
	END,
	CASE
		WHEN DocumentDataOverridable.IncomingDocumentDate = DATETIME(1,1,1) THEN
			DocumentData.IncomingDocumentDate
		ELSE
			DocumentDataOverridable.IncomingDocumentDate
	END,
	CASE
		WHEN DocumentDataOverridable.ExternalDocumentName = &quot;&quot; THEN
			DocumentData.ExternalDocumentName
		ELSE
			DocumentDataOverridable.ExternalDocumentName
	END,
	DocumentData.Ref
	
UNION ALL

SELECT
	
	DocumentDataOverridable.TicketNumber                             AS IncomingDocumentNumber,
	DocumentDataOverridable.Date                                    AS IncomingDocumentDate,
	PRESENTATION(DocumentDataOverridable.ServiceType)                AS ExternalDocumentName,
	DocumentDataOverridable.Currency                                  AS Currency,
	DocumentDataOverridable.CashFlowItem           AS CashFlowItem,
	DocumentDataOverridable.Ref                                  AS DocumentPurchases,
	DocumentDataOverridable.CounterpartyCarrier                    AS Counterparty,
	SUM(DocumentDataOverridable.DocumentAmount)                   AS Sum
FROM
	(SELECT
		DocumentDataOverridable.TicketNumber                             AS TicketNumber,
		DocumentDataOverridable.Date                                    AS Date,
		DocumentDataOverridable.ServiceType                               AS ServiceType,
		DocumentDataOverridable.Currency                                  AS Currency,
		DocumentDataOverridable.CashFlowItem           AS CashFlowItem,
		DocumentDataOverridable.Ref                                  AS Ref,
		DocumentDataOverridable.CounterpartyCarrier                    AS CounterpartyCarrier,
		DocumentDataOverridable.DocumentAmount                          AS DocumentAmount
	FROM
		Document.ElectronicTicketTransaction AS DocumentDataOverridable
		
	WHERE
			DocumentDataOverridable.Ref IN (&amp;PurchasingDocumentsList)
			AND DocumentDataOverridable.Posted
			AND DocumentDataOverridable.ElectronicTicket = VALUE(Document.ElectronicTicketTransaction.EmptyRef)
			
	UNION ALL
		
	SELECT
		DocumentDataOverridable.TicketNumber                             AS TicketNumber,
		DocumentDataOverridable.Date                                    AS Date,
		DocumentDataOverridable.ServiceType                               AS ServiceType,
		DocumentDataOverridable.Currency                                  AS Currency,
		DocumentDataOverridable.CashFlowItem           AS CashFlowItem,
		DocumentDataOverridable.Ref                                  AS Ref,
		DocumentDataOverridable.CounterpartyCarrier                    AS CounterpartyCarrier,
		CASE
			WHEN Ticket_OperationsOverridable.OperationType = VALUE(Enum.TypesOfTicketOperations.Return)
				THEN -Ticket_OperationsOverridable.DocumentAmount
			ELSE Ticket_OperationsOverridable.DocumentAmount
		END                                                                   AS Sum
	FROM
		Document.ElectronicTicketTransaction AS DocumentDataOverridable
		INNER JOIN Document.ElectronicTicketTransaction AS Ticket_OperationsOverridable
		ON DocumentDataOverridable.Ref = Ticket_OperationsOverridable.ElectronicTicket
		AND Ticket_OperationsOverridable.Posted
		
	WHERE
			DocumentDataOverridable.Ref IN (&amp;PurchasingDocumentsList)
			AND DocumentDataOverridable.Posted
			AND DocumentDataOverridable.ElectronicTicket = VALUE(Document.ElectronicTicketTransaction.EmptyRef)) AS DocumentDataOverridable
	
GROUP BY
	DocumentDataOverridable.TicketNumber,
	DocumentDataOverridable.Date,
	DocumentDataOverridable.ServiceType,
	DocumentDataOverridable.Currency,
	DocumentDataOverridable.CashFlowItem,
	DocumentDataOverridable.Ref,
	DocumentDataOverridable.CounterpartyCarrier</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
