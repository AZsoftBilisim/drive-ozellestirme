  <attributes>
    <name>PurchaseDocumentsAll</name>
    <title>
      <key>en</key>
      <value>Purchase documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>اسناد خرید</value>
    </title>
    <title>
      <key>it</key>
      <value>Documenti d'acquisto</value>
    </title>
    <title>
