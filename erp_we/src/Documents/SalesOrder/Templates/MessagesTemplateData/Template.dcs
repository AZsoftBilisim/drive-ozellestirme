		<field xsi:type="DataSetFieldField">
			<dataPath>Products</dataPath>
			<field>Products</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Characteristic</dataPath>
			<field>Characteristic</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>RowCode</dataPath>
			<field>RowCode</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Series</dataPath>
			<field>Series</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ReferenceOrder</dataPath>
			<field>ReferenceOrder</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Factor</dataPath>
			<field>Factor</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DocumentSalesOrder.Number,
	DocumentSalesOrder.Date,
	DocumentSalesOrder.Status,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	DocumentSalesOrder.DateOfShipment AS RequestShipmentOn,
	DocumentSalesOrder.PaymentSchedule,
	DocumentSalesOrder.Warehouse,
	DocumentSalesOrder.AdditionalInformation,
	DocumentSalesOrder.Manager,
	DocumentSalesOrder.Currency,
	DocumentSalesOrder.PaymentMethod,
	DocumentSalesOrder.BankAccount,
	DocumentSalesOrder.AmountPrepaymentBeforeGoodsIssue,
	DocumentSalesOrder.AmountOfPrepaymentBeforeShipment,
	DocumentSalesOrder.DocumentAmount - (DocumentSalesOrder.AmountPrepaymentBeforeGoodsIssue + DocumentSalesOrder.AmountOfPrepaymentBeforeShipment) AS CreditAmountAfterShipment,
	DocumentSalesOrder.DocumentAmount,
	DocumentSalesOrder.DateOfShipment,
	DocumentSalesOrder.LoyaltyCard,
	DocumentSalesOrder.NumberAccordingToCustomerData,
	DocumentSalesOrder.DateAccordingToInformationFromCustomer,
	DocumentSalesOrder.Contract,
	DocumentSalesOrder.DeliveryAddress,
	DocumentSalesOrder.Shipper,
	DocumentSalesOrder.GoodsRecipient,
	DocumentSalesOrder.DeliveryMethod,
	Carriers.DescriptionFull AS CarrierFullName,
	DocumentSalesOrder.DeliveryAddressOfCarrier,
	DocumentSalesOrder.AdditionalDeliveryInformation,
	CASE
		WHEN DocumentSalesOrder.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
				AND DocumentSalesOrder.ARAPObjectSettings &lt;&gt; VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
				AND DocumentSalesOrder.Posted
				AND DocumentSalesOrder.Status &lt;&gt; VALUE(Enum.SalesOrderStatuses.NotApproved)
				AND DocumentSalesOrder.DocumentAmount &gt; 0
			THEN CAST(DocumentSalesOrder.DocumentAmount - ISNULL(CustomersARAPAccountingBalance.AmountDueBalance, 0) AS NUMBER(31,2))
		ELSE 0
	END AS AmountPaid,
	CASE
		WHEN DocumentSalesOrder.Posted
				AND DocumentSalesOrder.ARAPObjectSettings &lt;&gt; VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
				AND DocumentSalesOrder.Status &lt;&gt; VALUE(Enum.SalesOrderStatuses.NotApproved)
				AND DocumentSalesOrder.DocumentAmount &gt; 0
				AND ISNULL(SettlementsWithCustomersBalancesAsOfDateOfRelevance.AmountDueBalance, 0) &gt; 0
			THEN CAST(ISNULL(SettlementsWithCustomersBalancesAsOfDateOfRelevance.AmountDueBalance, 0) AS NUMBER(31,2))
		ELSE 0
	END AS LatePaymentAmount,
	CASE
		WHEN DocumentSalesOrder.Posted
				AND DocumentSalesOrder.Status &lt;&gt; VALUE(Enum.SalesOrderStatuses.NotApproved)
				AND DocumentSalesOrder.DocumentAmount &gt; 0
			THEN DocumentSalesOrder.DocumentAmount - ISNULL(ShippingOrdersTurnover.SumTurnover, 0)
		ELSE 0
	END AS AmountShipped,
	CASE
		WHEN DocumentSalesOrder.Posted
				AND DocumentSalesOrder.ARAPObjectSettings &lt;&gt; VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
				AND DocumentSalesOrder.Status &lt;&gt; VALUE(Enum.SalesOrderStatuses.NotApproved)
				AND DocumentSalesOrder.DocumentAmount &gt; 0
				AND ISNULL(CustomersARAPAccountingBalance.SumBalance, 0) &gt; 0
			THEN CAST(ISNULL(CustomersARAPAccountingBalance.SumBalance, 0) AS NUMBER(31,2))
		ELSE 0
	END AS RemainingCustomerDebt,
	ContactPersonsForPartners.BirthDate
FROM
	Document.SalesOrder AS DocumentSalesOrder
		{LEFT JOIN AccumulationRegister.ShipmentAndReturnReferences.Turnovers(,,, ReferenceOrder = &amp;SalesOrder
				AND ReferenceOrder REFS Document.SalesOrder
				AND Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)) AS ShippingOrdersTurnover
		ON (ShippingOrdersTurnover.ReferenceOrder = DocumentSalesOrder.Ref)
		LEFT JOIN Catalog.Partners AS Partners
		ON DocumentSalesOrder.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON DocumentSalesOrder.ContactPerson = ContactPersonsForPartners.Ref
		LEFT JOIN Catalog.Partners AS Carriers
		ON DocumentSalesOrder.CarrierPartner = Carriers.Ref}
		{LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(
				,
				ARAPObject.Object = &amp;SalesOrder) AS CustomersARAPAccountingBalance
		ON DocumentSalesOrder.ARAPObject = CustomersARAPAccountingBalance.ARAPObject
		LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance(
				&amp;CurrentDate,
				ARAPObject.Object = &amp;SalesOrder) AS SettlementsWithCustomersBalancesAsOfDateOfRelevance
		ON DocumentSalesOrder.ARAPObject = SettlementsWithCustomersBalancesAsOfDateOfRelevance.ARAPObject}
WHERE
	DocumentSalesOrder.Ref = &amp;SalesOrder</query>
	</dataSet>
