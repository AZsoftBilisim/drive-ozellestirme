    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentSalesOrder.Ref AS Ref,
	DocumentSalesOrder.DeletionMark AS DeletionMark,
	DocumentSalesOrder.Number AS Number,
	DocumentSalesOrder.Date AS Date,
	DocumentSalesOrder.NumberAccordingToCustomerData AS NumberAccordingToCustomerData,
	DocumentSalesOrder.DateAccordingToInformationFromCustomer AS DateAccordingToInformationFromCustomer,
	DocumentSalesOrder.Posted AS Posted,
	DocumentSalesOrder.Priority AS Priority,
	DocumentSalesOrder.Partner AS Partner,
	DocumentSalesOrder.Counterparty AS Counterparty,
	DocumentSalesOrder.Organization AS Organization,
	DocumentSalesOrder.Terms AS Terms,
	DocumentSalesOrder.Contract AS Contract,
	DocumentSalesOrder.SalesOpportunity AS SalesOpportunity,
	DocumentSalesOrder.Currency AS Currency,
	DocumentSalesOrder.DocumentAmount AS DocumentAmount,
	DocumentSalesOrder.ReturnablePackagingAmount AS ReturnablePackagingAmount,
	DocumentSalesOrder.PaymentSchedule AS PaymentSchedule,
	DocumentSalesOrder.Warehouse AS Warehouse,
	DocumentSalesOrder.Status AS Status,
	DocumentSalesOrder.Manager AS Manager,
	DocumentSalesOrder.AdditionalInformation AS AdditionalInformation,
	DocumentSalesOrder.AmountPrepaymentBeforeGoodsIssue AS AmountPrepaymentBeforeGoodsIssue,
	DocumentSalesOrder.AmountOfPrepaymentBeforeShipment AS AmountOfPrepaymentBeforeShipment,
	DocumentSalesOrder.DateOfShipment AS DateOfShipment,
	DocumentSalesOrder.BusinessOperation AS BusinessOperation,
	DocumentSalesOrder.ARAPObjectSettings AS ARAPObjectSettings,
	DocumentSalesOrder.Comment AS Comment,
	DocumentSalesOrder.DeliveryIsRequired AS DeliveryIsRequired,
	DocumentSalesOrder.DeliverySpecificationMethod AS DeliverySpecificationMethod,
	DocumentSalesOrder.DeliveryPlanning AS DeliveryPlanning,
	CASE
		WHEN (NOT DocumentSalesOrder.Posted)
			THEN VALUE(Enum.SalesOrderStates.EmptyRef)
		ELSE ISNULL(SalesOrderStates.State, VALUE(Enum.SalesOrderStates.Closed))
	END AS State,
	CASE
		WHEN (NOT DocumentSalesOrder.Posted)
			THEN FALSE
		WHEN SalesOrderStates.EventDate &lt;> DATETIME(1, 1, 1)
		AND &amp;UpdateDate > SalesOrderStates.EventDate
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CASE
		WHEN DocumentSalesOrder.Priority IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentSalesOrder.Priority IN
			(SELECT TOP 1
				Priorities.Ref AS Priority
			FROM
				Catalog.Priorities AS Priorities
			ORDER BY
				Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	ISNULL(SalesOrderStates.PayAmount, 0) AS PayAmount,
	ISNULL(SalesOrderStates.PayPercentage, 0) AS PayPercentage,
	ISNULL(SalesOrderStates.AmountByShipment, 0) AS AmountByShipment,
	ISNULL(SalesOrderStates.OrderShipmentPercentage, 0) AS OrderShipmentPercentage,
	CASE
		WHEN ISNULL(SalesOrderStates.AmountOfDebt, 0) &lt; 0
			THEN -ISNULL(SalesOrderStates.AmountOfDebt, 0)
		ELSE 0
	END AS AccountsPayableOfCompany,
	CASE
		WHEN ISNULL(SalesOrderStates.AmountOfDebt, 0) > 0
			THEN ISNULL(SalesOrderStates.AmountOfDebt, 0)
		ELSE 0
	END AS CustomerAccountsReceivable,
	ISNULL(SalesOrderStates.DebtPercentage, 0) AS DebtPercentage,
	ISNULL(SalesOrderStates.EventDate, DATETIME(1, 1, 1)) AS EventDate,
	ISNULL(SalesOrderStates.ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoice, FALSE) AS ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoice,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	DocumentSalesOrder.Author,
	DocumentSalesOrder.ThisIsOrderAsInvoice AS ThisIsOrderAsInvoice
FROM
	Document.SalesOrder AS DocumentSalesOrder
		LEFT JOIN InformationRegister.SalesOrderStates AS SalesOrderStates
		ON (SalesOrderStates.OrderDocument = DocumentSalesOrder.Ref)
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentSalesOrder.Ref)}</queryText>
      <mainTable>Document.SalesOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
