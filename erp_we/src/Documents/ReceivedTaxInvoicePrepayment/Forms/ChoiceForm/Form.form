            </content>
            <content>
              <key>it</key>
              <value>Data di ricezione</value>
            </content>
            <content>
              <key>pl</key>
              <value>Data otrzymania</value>
            </content>
            <content>
              <key>ru</key>
              <value>Дата получения</value>
            </content>
            <content>
              <key>tr</key>
              <value>Alınan tarih</value>
            </content>
            <content>
              <key>vi</key>
              <value>Ngày nhận</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>EmployeeResponsible</dataPath>
        <field>EmployeeResponsible</field>
      </fields>
