  <attributes>
    <name>TeamWorkOrders</name>
    <title>
      <key>en</key>
      <value>Team work orders</value>
    </title>
    <title>
      <key>fa</key>
      <value>دستورهای کار تیمی</value>
    </title>
    <title>
      <key>it</key>
      <value>Ordini</value>
    </title>
    <title>
      <key>pl</key>
      <value>Zlecenia brygadowe</value>
    </title>
    <title>
      <key>ru</key>
      <value>Бригадные наряды</value>
    </title>
    <title>
      <key>tr</key>
      <value>Çalışma ekibi görevleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Trang bị đội lao động</value>
    </title>
    <id>8</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>TeamWorkOrders.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>TeamWorkOrders.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.Posted AS Posted,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	WorkOutput.Assignees AS Assignees,
	WorkOutput.Team AS Team,
	WorkOutput.Currency AS Currency,
	WorkOutput.WorkOrderKind AS WorkOrderKind,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.EmployeeResponsible AS EmployeeResponsible,
	DocumentsRegistry.Department AS Department,
	WorkOutput.PointInTime AS PointInTime,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties) AS Counterparty,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistry.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistry.ReversedDocument
	END AS ReversedCorrectedDocument,
	WorkOutput.AccountingForLaborCostsByEmployees AS AccountingForLaborCostsByEmployees,
	EDStates.EDIState,
	EDStates.StatusPresentation
{SELECT
	Team.*,
	Number,
	ReverseTransactionCorrection,
	CustomPicture,
	Date,
	WorkOrderKind.*,
	Assignees,
	EmployeeResponsible.*,
	Comment,
	ReversedCorrectedDocument.*,
	AccountingForLaborCostsByEmployees,
	Organization.*,
	Department.*,
	DeletionMark,
	Ref.*,
	EDIState,
	StatusPresentation}
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
	
	LEFT JOIN Document.WorkOutput AS WorkOutput
	ON DocumentsRegistry.Ref = WorkOutput.Ref
	
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
	ON EDStates.ObjectReference = DocumentsRegistry.Ref
WHERE
	DocumentsRegistry.RefType = &amp;RefType
	AND NOT DocumentsRegistry.AdditionalRecord
{WHERE
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	((DocumentsRegistry.IBDocumentDate >= &amp;BeginOfPeriod
	OR &amp;BeginOfPeriod = DATETIME(1, 1, 1))
	AND (DocumentsRegistry.IBDocumentDate &lt;= &amp;EndOfPeriod
	OR &amp;EndOfPeriod = DATETIME(1, 1, 1))),
	WorkOutput.AccountingForLaborCostsByEmployees,
	WorkOutput.Team.* AS Team,
	WorkOutput.WorkOrderKind.* AS WorkOrderKind,
	WorkOutput.Department.* AS Department,
	WorkOutput.Assignees AS Assignees,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.Organization.* Organization,
	WorkOutput.Ref.* AS Ref
}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Date</dataPath>
        <field>Date</field>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Date</value>
            </content>
            <content>
              <key>fa</key>
              <value>تاریخ</value>
            </content>
            <content>
              <key>ru</key>
              <value>Дата</value>
            </content>
            <content>
              <key>tr</key>
              <value>Tarih</value>
            </content>
            <content>
