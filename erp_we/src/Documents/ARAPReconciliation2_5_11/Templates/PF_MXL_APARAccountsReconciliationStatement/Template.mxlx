			<c>
				<c>
					<f>67</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>   2. Thus, as of [ReconciliationPeriodEnd]:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>2. بنابراین، در تاریخ [ReconciliationPeriodEnd]:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>   2. In questo modo, al [ReconciliationPeriodEnd]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>   2. W ten sposób, na [ReconciliationPeriodEnd]:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>   2. Таким образом, на [ReconciliationPeriodEnd]:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content> 2. Dolayısıyla [ReconciliationPeriodEnd] ilişkin:</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>   2. Như vậy, vào [ReconciliationPeriodEnd]:</v8:content>
						</v8:item>
					</tl>
