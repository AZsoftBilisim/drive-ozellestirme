		<dataSource>DataSource1</dataSource>
		<query>//Depending on the Cur user's access rights, tables are added programmatically to the query:
// - Accumulation register.Calculation of Financial instruments
// - Catalog.agreementcreditdeposits
// - Catalog.Lease agreements

// !!! TAGS ARE USED !!!
SELECT DISTINCT ALLOWED
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
	
INTO SelectionByPartnerSegment
{SELECT
	Partner.*
}
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner
}

INDEX BY
	Partner
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Dimension.DimensionKey AS DimensionKey,
	Dimension.Organization AS Organization,
	Dimension.Organization.ParentCompany AS ParentCompany,
	Dimension.Partner AS Partner,
	Dimension.LineOfBusiness AS LineOfBusiness,
	CASE WHEN Dimension.Contract = UNDEFINED
		THEN VALUE(Catalog.CounterpartyContracts.EmptyRef)
		ELSE Dimension.Contract
	END AS PartnerAgreement,
	ISNULL(CounterpartyContracts.Number, ISNULL(ContractsOfOrganizations.Number,&amp;IsBlankString)) AS ContractNumber,
	ISNULL(CounterpartyContracts.Date, ISNULL(ContractsOfOrganizations.Date,&amp;IsBlankString)) AS ContractDate_,
	ISNULL(CounterpartyContracts.NameForPrinting, ISNULL(ContractsOfOrganizations.NameForPrinting,&amp;IsBlankString)) AS ContractName,
	
	Dimension.Counterparty AS Counterparty
INTO DimensionByPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS Dimension
	LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
	ON Dimension.Contract = CounterpartyContracts.Ref
	LEFT JOIN Catalog.IntercompanyContracts AS ContractsOfOrganizations
	ON Dimension.Contract = ContractsOfOrganizations.Ref
{WHERE
	Dimension.Partner IN (
		SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}
{WHERE
	Dimension.Partner.* AS Partner,
	Dimension.Partner.MainManager.* AS MainManager,
	Dimension.Counterparty.* AS Counterparty,
	Dimension.Organization IN (&amp;Companies),
	Dimension.Counterparty IN (&amp;Counterparties),
	Dimension.Partner IN (&amp;Partners)}

INDEX BY
	DimensionKey
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;EndOfPeriod AS Period,
	VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting) AS PaymentType_,
	CustomersARAPAccountingBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.ParentCompany AS ParentCompany,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.PartnerAgreement AS Contract,
	CASE WHEN NOT CustomersARAPAccountingBalance.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN Dimension.LineOfBusiness
		ELSE CustomersARAPAccountingBalance.ARAPObject.LineOfBusiness 
	END AS LineOfBusiness,
	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	CustomersARAPAccountingBalance.Currency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover, //We always include contracts with turnover
	
	CustomersARAPAccountingBalance.DebtBalance - CustomersARAPAccountingBalance.PrepaymentBalance AS ClosingBalance,
	CustomersARAPAccountingBalance.DebtLocalBalance -CustomersARAPAccountingBalance.PrepaymentLocalBalance AS ClosingBalanceLocal,
	
	CustomersARAPAccountingBalance.DebtBalance AS ClosingBalanceDr,
	CustomersARAPAccountingBalance.PrepaymentBalance AS ClosingBalanceCr,
	CustomersARAPAccountingBalance.DebtLocalBalance AS FinalBalanceOfDrLocal,
	CustomersARAPAccountingBalance.PrepaymentLocalBalance AS FinalBalanceOfCrLocal,
	
	10 AS PaymentTypeOrder
INTO TTBalancesAtEndOfPeriodCustomers
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(
		{&amp;EndOfPeriod},
		{AccountingDimensionByPartners.Organization.* AS Organization,
		AccountingDimensionByPartners.Partner.* AS Partner,
		AccountingDimensionByPartners.Partner.MainManager.* AS MainManager,
		AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		AccountingDimensionByPartners.Contract.* AS Contract,
		ARAPObject.LineOfBusiness.* AS LineOfBusiness,
		AccountingDimensionByPartners.Organization IN (&amp;Companies),
		AccountingDimensionByPartners.Counterparty IN (&amp;Counterparties),
		AccountingDimensionByPartners.Partner IN (&amp;Partners)}
	) AS CustomersARAPAccountingBalance
	INNER JOIN DimensionByPartners AS Dimension
	ON CustomersARAPAccountingBalance.AccountingDimensionByPartners = Dimension.DimensionKey
{WHERE
	VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting) AS PaymentType_}

INDEX BY
	AccountingDimensionByPartners,
	ARAPObject,
	Currency
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;EndOfPeriod AS Period,
	VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting) AS PaymentType_,
	VendorsARAPAccountingBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.ParentCompany AS ParentCompany,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.PartnerAgreement AS Contract,
	CASE WHEN NOT VendorsARAPAccountingBalance.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN Dimension.LineOfBusiness
		ELSE VendorsARAPAccountingBalance.ARAPObject.LineOfBusiness 
	END AS LineOfBusiness,
	CASE WHEN VendorsARAPAccountingBalance.ARAPObject = UNDEFINED
		THEN VALUE(Catalog.CounterpartyContracts.EmptyRef)
		ELSE VendorsARAPAccountingBalance.ARAPObject
	END AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	VendorsARAPAccountingBalance.Currency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover, //We always include contracts with turnover
	
	VendorsARAPAccountingBalance.DebtBalance - VendorsARAPAccountingBalance.PrepaymentBalance AS ClosingBalance,
	VendorsARAPAccountingBalance.DebtLocalBalance - VendorsARAPAccountingBalance.PrepaymentLocalBalance AS ClosingBalanceLocal,
	
	VendorsARAPAccountingBalance.PrepaymentBalance AS ClosingBalanceDr,
	VendorsARAPAccountingBalance.DebtBalance AS ClosingBalanceCr,
	VendorsARAPAccountingBalance.PrepaymentLocalBalance AS FinalBalanceOfDrLocal,
	VendorsARAPAccountingBalance.DebtLocalBalance AS FinalBalanceOfCrLocal,
	
	20 AS PaymentTypeOrder
INTO TTBalanceAtEndOfPeriodSuppliers
FROM
	AccumulationRegister.VendorsARAPAccountingByDueDates.Balance(
		{&amp;EndOfPeriod},
		{AccountingDimensionByPartners.Organization.* AS Organization,
		AccountingDimensionByPartners.Partner.* AS Partner,
		AccountingDimensionByPartners.Partner.MainManager.* AS MainManager,
		AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		AccountingDimensionByPartners.Contract.* AS Contract,
		ARAPObject.LineOfBusiness.* AS LineOfBusiness,
		AccountingDimensionByPartners.Organization IN (&amp;Companies),
		AccountingDimensionByPartners.Counterparty IN (&amp;Counterparties),
		AccountingDimensionByPartners.Partner IN (&amp;Partners)}
	) AS VendorsARAPAccountingBalance
	INNER JOIN DimensionByPartners AS Dimension
	ON VendorsARAPAccountingBalance.AccountingDimensionByPartners = Dimension.DimensionKey
{WHERE
	VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting) AS PaymentType_}

INDEX BY
	AccountingDimensionByPartners,
	ARAPObject,
	Currency
;

//#0

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting) AS PaymentType_,
	CustomersARAPAccountingBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.ParentCompany AS ParentCompany,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.PartnerAgreement AS Contract,
	CASE WHEN NOT CustomersARAPAccountingBalance.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN Dimension.LineOfBusiness
		ELSE CustomersARAPAccountingBalance.ARAPObject.LineOfBusiness 
	END AS LineOfBusiness,
	Dimension.ContractNumber AS ContractNumber,
	Dimension.ContractDate_ AS ContractDate_,
	Dimension.ContractName AS ContractName,
	CustomersARAPAccountingBalance.ARAPObject AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	CustomersARAPAccountingBalance.Currency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover, //We always include contracts with turnover
	
	CustomersARAPAccountingBalance.DebtBalance - CustomersARAPAccountingBalance.PrepaymentBalance AS OpeningBalance,
	CustomersARAPAccountingBalance.DebtLocalBalance - CustomersARAPAccountingBalance.PrepaymentLocalBalance AS OpeningBalanceLocal,
	CustomersARAPAccountingBalance.DebtBalance AS OpeningBalanceDr,
	CustomersARAPAccountingBalance.DebtLocalBalance AS DrLocalOpeningBalance,
	CustomersARAPAccountingBalance.PrepaymentBalance AS OpeningBalanceCr,
	CustomersARAPAccountingBalance.PrepaymentLocalBalance AS InitialBalanceOfCrLocal,
	0 AS TurnoverDr,
	0 AS DrLocalTurnover,
	0 AS TurnoverCr,
	0 AS CrLocalTurnover,
	CustomersARAPAccountingBalance.DebtBalance AS Debt,
	CustomersARAPAccountingBalance.DebtLocalBalance AS DebtLocal,
	CustomersARAPAccountingBalance.PrepaymentBalance AS Prepayment,
	CustomersARAPAccountingBalance.PrepaymentLocalBalance AS PrepaymentLocal,
	
	ISNULL(BalancesAtEndOfPeriod.ClosingBalance, 0) AS ClosingBalance,
	ISNULL(BalancesAtEndOfPeriod.ClosingBalanceLocal, 0) AS ClosingBalanceLocal,
	ISNULL(BalancesAtEndOfPeriod.ClosingBalanceDr, 0) AS ClosingBalanceDr,
	ISNULL(BalancesAtEndOfPeriod.ClosingBalanceCr, 0) AS ClosingBalanceCr,
	ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfDrLocal, 0) AS FinalBalanceOfDrLocal,
	ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfCrLocal, 0) AS FinalBalanceOfCrLocal,
	
	10 AS PaymentTypeOrder
INTO Turnovers
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(
		{&amp;BeginOfPeriod},
		{AccountingDimensionByPartners.Organization.* AS Organization,
		AccountingDimensionByPartners.Partner.* AS Partner,
		AccountingDimensionByPartners.Partner.MainManager.* AS MainManager,
		AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		AccountingDimensionByPartners.Counterparty.* AS CompanyCounterparty,
		AccountingDimensionByPartners.Contract.* AS Contract,
		ARAPObject.LineOfBusiness.* AS LineOfBusiness,
		AccountingDimensionByPartners.Organization IN (&amp;Companies),
		AccountingDimensionByPartners.Counterparty IN (&amp;Counterparties),
		AccountingDimensionByPartners.Partner IN (&amp;Partners)}
	) AS CustomersARAPAccountingBalance
	INNER JOIN DimensionByPartners AS Dimension
	ON CustomersARAPAccountingBalance.AccountingDimensionByPartners = Dimension.DimensionKey	
	LEFT JOIN TTBalancesAtEndOfPeriodCustomers AS BalancesAtEndOfPeriod
	ON CustomersARAPAccountingBalance.AccountingDimensionByPartners = BalancesAtEndOfPeriod.AccountingDimensionByPartners
		AND CustomersARAPAccountingBalance.Currency = BalancesAtEndOfPeriod.Currency
{WHERE
	VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting) AS PaymentType_}

UNION ALL

SELECT
	NestedQuery.Period AS Period,
	VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting) AS PaymentType_,
	NestedQuery.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	NestedQuery.Organization AS Organization,
	NestedQuery.ParentCompany AS ParentCompany,
	NestedQuery.Partner AS Partner,
	NestedQuery.Counterparty AS Counterparty,
	NestedQuery.Contract AS Contract,
	NestedQuery.LineOfBusiness AS LineOfBusiness,
	NestedQuery.ContractNumber AS ContractNumber,
	NestedQuery.ContractDate_ AS ContractDate_,
	NestedQuery.ContractName AS ContractName,
	NestedQuery.ARAPObject AS ARAPObject,
	NestedQuery.Recorder AS ARAPDocument,
	NestedQuery.Currency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover, //We always include contracts with turnover
	
	0 AS OpeningBalance,
	0 AS OpeningBalanceLocal,
	0 AS OpeningBalanceDr,
	0 AS DrLocalOpeningBalance,
	0 AS OpeningBalanceCr,
	0 AS InitialBalanceOfCrLocal,

	CASE 
		WHEN SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt))
		WHEN SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment)
		ELSE
			0
	END AS TurnoverDr,
	CASE 
		WHEN SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal))
		WHEN SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal)
		ELSE
			0
	END AS DrLocalTurnover,
	CASE 
		WHEN SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment))
		WHEN SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt)
		ELSE
			0
	END AS TurnoverCr,
	CASE 
		WHEN SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal))
		WHEN SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal)
		ELSE
			0
	END AS CrLocalTurnover,
	SUM(NestedQuery.Debt) AS Debt,
	SUM(NestedQuery.DebtLocal) AS DebtLocal,
	SUM(NestedQuery.Prepayment) AS Prepayment,
	SUM(NestedQuery.PrepaymentLocal) AS PrepaymentLocal,
	
	NestedQuery.ClosingBalance AS ClosingBalance,
	NestedQuery.ClosingBalanceLocal AS ClosingBalanceLocal,
	NestedQuery.ClosingBalanceDr AS ClosingBalanceDr,
	NestedQuery.ClosingBalanceCr AS ClosingBalanceCr,
	NestedQuery.FinalBalanceOfDrLocal AS FinalBalanceOfDrLocal,
	NestedQuery.FinalBalanceOfCrLocal AS FinalBalanceOfCrLocal,
	
	10 AS PaymentTypeOrder
FROM
	(SELECT
		SettlementsWithCustomersTurnover.Period AS Period,
		SettlementsWithCustomersTurnover.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		Dimension.Organization AS Organization,
		Dimension.ParentCompany AS ParentCompany,
		Dimension.Partner AS Partner,
		Dimension.Counterparty AS Counterparty,
		Dimension.PartnerAgreement AS Contract,
		CASE WHEN NOT SettlementsWithCustomersTurnover.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
			THEN Dimension.LineOfBusiness
			ELSE SettlementsWithCustomersTurnover.ARAPObject.LineOfBusiness 
		END AS LineOfBusiness,
		Dimension.ContractNumber AS ContractNumber,
		Dimension.ContractDate_ AS ContractDate_,
		Dimension.ContractName AS ContractName,
		SettlementsWithCustomersTurnover.ARAPObject AS ARAPObject,
		SettlementsWithCustomersTurnover.DocumentRecorder AS Recorder,
		SettlementsWithCustomersTurnover.Currency AS Currency,
		
		CASE WHEN SettlementsWithCustomersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithCustomersTurnover.Debt
			ELSE -SettlementsWithCustomersTurnover.Debt
		END AS Debt,
		CASE WHEN SettlementsWithCustomersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithCustomersTurnover.DebtLocal
			ELSE -SettlementsWithCustomersTurnover.DebtLocal
		END AS DebtLocal,
		CASE WHEN SettlementsWithCustomersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithCustomersTurnover.Prepayment
			ELSE -SettlementsWithCustomersTurnover.Prepayment
		END AS Prepayment,
		CASE WHEN SettlementsWithCustomersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithCustomersTurnover.PrepaymentLocal
			ELSE -SettlementsWithCustomersTurnover.PrepaymentLocal
		END AS PrepaymentLocal,
		
		ISNULL(BalancesAtEndOfPeriod.ClosingBalance, 0) AS ClosingBalance,
		ISNULL(BalancesAtEndOfPeriod.ClosingBalanceLocal, 0) AS ClosingBalanceLocal,
		
		ISNULL(BalancesAtEndOfPeriod.ClosingBalanceDr, 0) AS ClosingBalanceDr,
		ISNULL(BalancesAtEndOfPeriod.ClosingBalanceCr, 0) AS ClosingBalanceCr,
		ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfDrLocal, 0) AS FinalBalanceOfDrLocal,
		ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfCrLocal, 0) AS FinalBalanceOfCrLocal
	FROM
		AccumulationRegister.CustomersARAPAccountingByDueDates AS SettlementsWithCustomersTurnover
		INNER JOIN DimensionByPartners AS Dimension
			ON SettlementsWithCustomersTurnover.AccountingDimensionByPartners = Dimension.DimensionKey
		LEFT JOIN TTBalancesAtEndOfPeriodCustomers AS BalancesAtEndOfPeriod
			ON SettlementsWithCustomersTurnover.AccountingDimensionByPartners = BalancesAtEndOfPeriod.AccountingDimensionByPartners
				AND SettlementsWithCustomersTurnover.Currency = BalancesAtEndOfPeriod.Currency
		WHERE
			SettlementsWithCustomersTurnover.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	) AS NestedQuery

GROUP BY
	NestedQuery.Period,
	NestedQuery.AccountingDimensionByPartners,
	NestedQuery.Organization,
	NestedQuery.ParentCompany,
	NestedQuery.Partner,
	NestedQuery.Counterparty,
	NestedQuery.Contract,
	NestedQuery.LineOfBusiness,
	NestedQuery.ARAPObject,
	NestedQuery.Recorder,
	NestedQuery.ContractNumber,
	NestedQuery.ContractDate_,
	NestedQuery.ContractName,
	NestedQuery.Currency,
	NestedQuery.ClosingBalance,
	NestedQuery.ClosingBalanceLocal,
	NestedQuery.ClosingBalanceDr,
	NestedQuery.ClosingBalanceCr,
	NestedQuery.FinalBalanceOfDrLocal,
	NestedQuery.FinalBalanceOfCrLocal
	
HAVING
	SUM(NestedQuery.Debt) &lt;&gt; 0 OR SUM(NestedQuery.DebtLocal) &lt;&gt; 0 
	OR SUM(NestedQuery.Prepayment) &lt;&gt; 0 OR SUM(NestedQuery.PrepaymentLocal) &lt;&gt; 0

{WHERE
	VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting) AS PaymentType_}

UNION ALL

SELECT
	&amp;BeginOfPeriod AS Period,
	VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting) AS PaymentType_,
	VendorsARAPAccountingBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.ParentCompany AS ParentCompany,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.PartnerAgreement AS Contract,
	CASE WHEN NOT VendorsARAPAccountingBalance.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN Dimension.LineOfBusiness
		ELSE VendorsARAPAccountingBalance.ARAPObject.LineOfBusiness 
	END AS LineOfBusiness,
	Dimension.ContractNumber AS ContractNumber,
	Dimension.ContractDate_ AS ContractDate_,
	Dimension.ContractName AS ContractName,
	VendorsARAPAccountingBalance.ARAPObject AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	VendorsARAPAccountingBalance.Currency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover, //We always include contracts with turnover
	
	VendorsARAPAccountingBalance.DebtBalance - VendorsARAPAccountingBalance.PrepaymentBalance AS OpeningBalance,
	VendorsARAPAccountingBalance.DebtLocalBalance - VendorsARAPAccountingBalance.PrepaymentLocalBalance AS OpeningBalanceLocal,
	VendorsARAPAccountingBalance.PrepaymentBalance AS OpeningBalanceDr,
	VendorsARAPAccountingBalance.PrepaymentLocalBalance AS DrLocalOpeningBalance,
	VendorsARAPAccountingBalance.DebtBalance AS OpeningBalanceCr,
	VendorsARAPAccountingBalance.DebtLocalBalance AS InitialBalanceOfCrLocal,
	0 AS TurnoverDr,
	0 AS DrLocalTurnover,
	0 AS TurnoverCr,
	0 AS CrLocalTurnover,
	VendorsARAPAccountingBalance.DebtBalance AS Debt,
	VendorsARAPAccountingBalance.DebtLocalBalance AS DebtLocal,
	VendorsARAPAccountingBalance.PrepaymentBalance AS Prepayment,
	VendorsARAPAccountingBalance.PrepaymentLocalBalance AS PrepaymentLocal,
	
	ISNULL(BalancesAtEndOfPeriod.ClosingBalance, 0) AS ClosingBalance,
	ISNULL(BalancesAtEndOfPeriod.ClosingBalanceLocal, 0) AS ClosingBalanceLocal,
	ISNULL(BalancesAtEndOfPeriod.ClosingBalanceDr, 0) AS ClosingBalanceDr,
	ISNULL(BalancesAtEndOfPeriod.ClosingBalanceCr, 0) AS ClosingBalanceCr,
	ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfDrLocal, 0) AS FinalBalanceOfDrLocal,
	ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfCrLocal, 0) AS FinalBalanceOfCrLocal,
	
	20 AS PaymentTypeOrder
FROM
	AccumulationRegister.VendorsARAPAccountingByDueDates.Balance(
		{&amp;BeginOfPeriod},
		{AccountingDimensionByPartners.Organization.* AS Organization,
		AccountingDimensionByPartners.Partner.* AS Partner,
		AccountingDimensionByPartners.Partner.MainManager.* AS MainManager,
		AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		AccountingDimensionByPartners.Counterparty.* AS CompanyCounterparty,
		AccountingDimensionByPartners.Contract.* AS Contract,
		ARAPObject.LineOfBusiness.* AS LineOfBusiness,
		AccountingDimensionByPartners.Organization IN (&amp;Companies),
		AccountingDimensionByPartners.Counterparty IN (&amp;Counterparties),
		AccountingDimensionByPartners.Partner IN (&amp;Partners)}
	) AS VendorsARAPAccountingBalance
	INNER JOIN DimensionByPartners AS Dimension
	ON VendorsARAPAccountingBalance.AccountingDimensionByPartners = Dimension.DimensionKey
	LEFT JOIN TTBalanceAtEndOfPeriodSuppliers AS BalancesAtEndOfPeriod
	ON VendorsARAPAccountingBalance.AccountingDimensionByPartners = BalancesAtEndOfPeriod.AccountingDimensionByPartners
		AND VendorsARAPAccountingBalance.Currency = BalancesAtEndOfPeriod.Currency
{WHERE
	VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting) AS PaymentType_}

UNION ALL

SELECT
	NestedQuery.Period AS Period,
	VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting) AS PaymentType_,
	NestedQuery.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	NestedQuery.Organization AS Organization,
	NestedQuery.ParentCompany AS ParentCompany,
	NestedQuery.Partner AS Partner,
	NestedQuery.Counterparty AS Counterparty,
	NestedQuery.Contract AS Contract,
	NestedQuery.LineOfBusiness AS LineOfBusiness,
	NestedQuery.ContractNumber AS ContractNumber,
	NestedQuery.ContractDate_ AS ContractDate_,
	NestedQuery.ContractName AS ContractName,
	NestedQuery.ARAPObject AS ARAPObject,
	NestedQuery.Recorder AS ARAPDocument,
	NestedQuery.Currency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover, //We always include contracts with turnover
	
	0 AS OpeningBalance,
	0 AS OpeningBalanceLocal,
	0 AS OpeningBalanceDr,
	0 AS DrLocalOpeningBalance,
	0 AS OpeningBalanceCr,
	0 AS InitialBalanceOfCrLocal,
	CASE 
		WHEN SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment))
		WHEN SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt)
		ELSE
			0
	END AS TurnoverDr,
	CASE 
		WHEN SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal))
		WHEN SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal)
		ELSE
			0
	END AS DrLocalTurnover,
	CASE 
		WHEN SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.Prepayment) - SUM(NestedQuery.Debt))
		WHEN SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.Debt) - SUM(NestedQuery.Prepayment)
		ELSE
			0
	END AS TurnoverCr,
	CASE 
		WHEN SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) = TYPE(Document.ReversingEntry)
			THEN -(SUM(NestedQuery.PrepaymentLocal) - SUM(NestedQuery.DebtLocal))
		WHEN SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal) &gt; 0
				AND VALUETYPE(NestedQuery.Recorder) &lt;&gt; TYPE(Document.ReversingEntry)
			THEN SUM(NestedQuery.DebtLocal) - SUM(NestedQuery.PrepaymentLocal)
		ELSE
			0
	END AS CrLocalTurnover,
	
	SUM(NestedQuery.Debt) AS Debt,
	SUM(NestedQuery.DebtLocal) AS DebtLocal,
	SUM(NestedQuery.Prepayment) AS Prepayment,
	SUM(NestedQuery.PrepaymentLocal) AS PrepaymentLocal,
	
	NestedQuery.ClosingBalance AS ClosingBalance,
	NestedQuery.ClosingBalanceLocal AS ClosingBalanceLocal,
	NestedQuery.ClosingBalanceDr AS ClosingBalanceDr,
	NestedQuery.ClosingBalanceCr AS ClosingBalanceCr,
	NestedQuery.FinalBalanceOfDrLocal AS FinalBalanceOfDrLocal,
	NestedQuery.FinalBalanceOfCrLocal AS FinalBalanceOfCrLocal,
	
	20 AS PaymentTypeOrder
FROM
	(SELECT
		SettlementsWithSuppliersTurnover.Period AS Period,
		SettlementsWithSuppliersTurnover.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		Dimension.Organization AS Organization,
		Dimension.ParentCompany AS ParentCompany,
		Dimension.Partner AS Partner,
		Dimension.Counterparty AS Counterparty,
		Dimension.PartnerAgreement AS Contract,
		CASE WHEN NOT SettlementsWithSuppliersTurnover.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
			THEN Dimension.LineOfBusiness
			ELSE SettlementsWithSuppliersTurnover.ARAPObject.LineOfBusiness
		END AS LineOfBusiness,
		Dimension.ContractNumber AS ContractNumber,
		Dimension.ContractDate_ AS ContractDate_,
		Dimension.ContractName AS ContractName,
		SettlementsWithSuppliersTurnover.ARAPObject AS ARAPObject,
		SettlementsWithSuppliersTurnover.DocumentRecorder AS Recorder,
		SettlementsWithSuppliersTurnover.Currency AS Currency,
		
		CASE WHEN SettlementsWithSuppliersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithSuppliersTurnover.Debt
			ELSE -SettlementsWithSuppliersTurnover.Debt
		END AS Debt,
		CASE WHEN SettlementsWithSuppliersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithSuppliersTurnover.DebtLocal
			ELSE -SettlementsWithSuppliersTurnover.DebtLocal
		END AS DebtLocal,
		CASE WHEN SettlementsWithSuppliersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithSuppliersTurnover.Prepayment
			ELSE -SettlementsWithSuppliersTurnover.Prepayment
		END AS Prepayment,
		CASE WHEN SettlementsWithSuppliersTurnover.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN SettlementsWithSuppliersTurnover.PrepaymentLocal
			ELSE -SettlementsWithSuppliersTurnover.PrepaymentLocal
		END AS PrepaymentLocal,
		
		ISNULL(BalancesAtEndOfPeriod.ClosingBalance, 0) AS ClosingBalance,
		ISNULL(BalancesAtEndOfPeriod.ClosingBalanceLocal, 0) AS ClosingBalanceLocal,
		ISNULL(BalancesAtEndOfPeriod.ClosingBalanceDr, 0) AS ClosingBalanceDr,
		ISNULL(BalancesAtEndOfPeriod.ClosingBalanceCr, 0) AS ClosingBalanceCr,
		ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfDrLocal, 0) AS FinalBalanceOfDrLocal,
		ISNULL(BalancesAtEndOfPeriod.FinalBalanceOfCrLocal, 0) AS FinalBalanceOfCrLocal
	FROM
		AccumulationRegister.VendorsARAPAccountingByDueDates AS SettlementsWithSuppliersTurnover
			INNER JOIN DimensionByPartners AS Dimension
				ON SettlementsWithSuppliersTurnover.AccountingDimensionByPartners = Dimension.DimensionKey
			LEFT JOIN TTBalanceAtEndOfPeriodSuppliers AS BalancesAtEndOfPeriod
				ON SettlementsWithSuppliersTurnover.AccountingDimensionByPartners = BalancesAtEndOfPeriod.AccountingDimensionByPartners
				AND SettlementsWithSuppliersTurnover.Currency = BalancesAtEndOfPeriod.Currency
		WHERE
			SettlementsWithSuppliersTurnover.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	) AS NestedQuery
	
GROUP BY
	NestedQuery.Period,
	NestedQuery.AccountingDimensionByPartners,
	NestedQuery.Organization,
	NestedQuery.ParentCompany,
	NestedQuery.Partner,
	NestedQuery.Counterparty,
	NestedQuery.Contract,
	NestedQuery.LineOfBusiness,
	NestedQuery.ARAPObject,
	NestedQuery.Recorder,
	NestedQuery.ContractNumber,
	NestedQuery.ContractDate_,
	NestedQuery.ContractName,
	NestedQuery.Currency,
	NestedQuery.ClosingBalance,
	NestedQuery.ClosingBalanceLocal,
	NestedQuery.ClosingBalanceDr,
	NestedQuery.ClosingBalanceCr,
	NestedQuery.FinalBalanceOfDrLocal,
	NestedQuery.FinalBalanceOfCrLocal
	
HAVING
	SUM(NestedQuery.Debt) &lt;&gt; 0 OR SUM(NestedQuery.DebtLocal) &lt;&gt; 0 
	OR SUM(NestedQuery.Prepayment) &lt;&gt; 0 OR SUM(NestedQuery.PrepaymentLocal) &lt;&gt; 0
	
{WHERE
	VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting) AS PaymentType_}

//#1

UNION ALL

SELECT
	&amp;BeginOfPeriod AS Period,
	CASE 
		WHEN Contracts.ContractType IN (
				VALUE(Enum.ContractTypes.WithCustomer),
				VALUE(Enum.ContractTypes.WithConsignee),
				VALUE(Enum.ContractTypes.ReceiptForTolling2_5),
				VALUE(Enum.ContractTypes.ReceivingForCustody),
				VALUE(Enum.ContractTypes.TransferToCustody),
				VALUE(Enum.ContractTypes.CustomerInvoiceOutsourcedSale),
				VALUE(Enum.ContractTypes.SalesViaCommissionAgent))
			THEN VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting)
		WHEN Contracts.ContractType IN (
				VALUE(Enum.ContractTypes.WithVendor),
				VALUE(Enum.ContractTypes.WithConsignor),
				VALUE(Enum.ContractTypes.TransferToTolling2_5),
				VALUE(Enum.ContractTypes.SubcontractingToTheEAEUCountries),
				VALUE(Enum.ContractTypes.Import),
				VALUE(Enum.ContractTypes.PurchaseEAEU))
			THEN VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting)
	END AS PaymentType_,
	UNDEFINED AS AccountingDimensionByPartners,
	Contracts.Organization AS Organization,
	Contracts.Organization.ParentCompany AS ParentCompany,
	Contracts.Partner AS Partner,
	Contracts.Counterparty AS Counterparty,
	Contracts.Ref AS Contract,
	Contracts.LineOfBusiness AS LineOfBusiness,
	Contracts.Number AS ContractNumber,
	Contracts.Date AS ContractDate_,
	Contracts.NameForPrinting AS ContractName,
	CASE WHEN Contracts.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
		THEN Contracts.Ref
		ELSE VALUE(Catalog.ARAPObjects.EmptyRef)
	END AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	Contracts.ARAPCurrency AS Currency,
	UNDEFINED AS AmountType,
	TRUE AS ContractsWithoutTurnover,
	
	0 AS OpeningBalance,
	0 AS OpeningBalanceLocal,
	0 AS OpeningBalanceDr,
	0 AS DrLocalOpeningBalance,
	0 AS OpeningBalanceCr,
	0 AS InitialBalanceOfCrLocal,
	0 AS TurnoverDr,
	0 AS DrLocalTurnover,
	0 AS TurnoverCr,
	0 AS CrLocalTurnover,
	0 AS Debt,
	0 AS DebtLocal,
	0 AS Prepayment,
	0 AS PrepaymentLocal,
	0 AS ClosingBalance,
	0 AS ClosingBalanceLocal,
	0 AS ClosingBalanceDr,
	0 AS ClosingBalanceCr,
	0 AS FinalBalanceOfDrLocal,
	0 AS FinalBalanceOfCrLocal,
	
	CASE 
		WHEN Contracts.ContractType IN (
				VALUE(Enum.ContractTypes.WithCustomer),
				VALUE(Enum.ContractTypes.WithConsignee),
				VALUE(Enum.ContractTypes.ReceiptForTolling2_5),
				VALUE(Enum.ContractTypes.ReceivingForCustody))
			THEN 10
		WHEN Contracts.ContractType IN (
				VALUE(Enum.ContractTypes.WithVendor),
				VALUE(Enum.ContractTypes.WithConsignor),
				VALUE(Enum.ContractTypes.TransferToTolling2_5),
				VALUE(Enum.ContractTypes.SubcontractingToTheEAEUCountries),
				VALUE(Enum.ContractTypes.Import),
				VALUE(Enum.ContractTypes.PurchaseEAEU))
			THEN 20
	END AS PaymentTypeOrder
FROM
	Catalog.CounterpartyContracts AS Contracts
WHERE
	NOT Contracts.DeletionMark
	AND &amp;ContractsWithoutTurnover
{WHERE
	CASE 
		WHEN Contracts.ContractType IN (
				VALUE(Enum.ContractTypes.WithCustomer),
				VALUE(Enum.ContractTypes.WithConsignee),
				VALUE(Enum.ContractTypes.ReceiptForTolling2_5),
				VALUE(Enum.ContractTypes.ReceivingForCustody))
			THEN VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting)
		WHEN Contracts.ContractType IN (
				VALUE(Enum.ContractTypes.WithVendor),
				VALUE(Enum.ContractTypes.WithConsignor),
				VALUE(Enum.ContractTypes.TransferToTolling2_5),
				VALUE(Enum.ContractTypes.SubcontractingToTheEAEUCountries),
				VALUE(Enum.ContractTypes.Import),
				VALUE(Enum.ContractTypes.PurchaseEAEU))
			THEN VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting)
	END AS PaymentType_,
	TRUE AS ContractsWithoutTurnover}

//#2
//#3

INDEX BY
	ARAPDocument,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT ALLOWED
	DocumentAmounts_.Ref AS Recorder,
	DocumentAmounts_.Ref.Number AS DocumentNumber,
	DocumentAmounts_.Ref.Date AS DocumentDate,
	Turnovers.PaymentType_ AS PaymentType_,
	Turnovers.Contract AS Contract,
	Turnovers.ARAPObject AS ARAPObject,
	DocumentAmounts_.Organization.LocalAccountingCurrency AS Currency,
	DocumentAmounts_.Ref.SumCompl AS Sum
INTO TTDebtOffset
FROM
	Document.ARAPSettlement.AccountsReceivable AS DocumentAmounts_
	INNER JOIN Turnovers AS Turnovers
	ON DocumentAmounts_.Ref = Turnovers.ARAPDocument
		AND DocumentAmounts_.PaymentType_ = Turnovers.PaymentType_
		AND DocumentAmounts_.ARAPObject = Turnovers.ARAPObject
		AND DocumentAmounts_.Organization = Turnovers.Organization
		AND DocumentAmounts_.Partner = Turnovers.Partner

UNION

SELECT DISTINCT
	DocumentAmounts_.Ref AS Recorder,
	DocumentAmounts_.Ref.Number AS DocumentNumber,
	DocumentAmounts_.Ref.Date AS DocumentDate,
	Turnovers.PaymentType_ AS PaymentType_,
	Turnovers.Contract AS Contract,
	Turnovers.ARAPObject AS ARAPObject,
	DocumentAmounts_.Organization.LocalAccountingCurrency AS Currency,
	DocumentAmounts_.Ref.SumCompl AS Sum
FROM
	Document.ARAPSettlement.AccountsPayable AS DocumentAmounts_
	INNER JOIN Turnovers AS Turnovers
	ON DocumentAmounts_.Ref = Turnovers.ARAPDocument
		AND DocumentAmounts_.PaymentType_ = Turnovers.PaymentType_
		AND DocumentAmounts_.ARAPObject = Turnovers.ARAPObject
		AND DocumentAmounts_.Organization = Turnovers.Organization
		AND DocumentAmounts_.Partner = Turnovers.Partner
		
UNION

// Mirror Objects Of Calculations
SELECT DISTINCT
	DocumentAmounts_.Ref AS Recorder,
	DocumentAmounts_.Ref.Number AS DocumentNumber,
	DocumentAmounts_.Ref.Date AS DocumentDate,
	Turnovers.PaymentType_ AS PaymentType_,
	Turnovers.Contract AS Contract,
	Turnovers.ARAPObject AS ARAPObject,
	DocumentAmounts_.Organization.LocalAccountingCurrency AS Currency,
	DocumentAmounts_.Ref.SumCompl AS Sum
FROM
	Document.ARAPSettlement.AccountsReceivable AS DocumentAmounts_
	INNER JOIN Turnovers AS Turnovers
	ON DocumentAmounts_.Ref = Turnovers.ARAPDocument
		AND DocumentAmounts_.ARAPObjectMirror = Turnovers.ARAPObject

UNION

SELECT DISTINCT
	DocumentAmounts_.Ref AS Recorder,
	DocumentAmounts_.Ref.Number AS DocumentNumber,
	DocumentAmounts_.Ref.Date AS DocumentDate,
	Turnovers.PaymentType_ AS PaymentType_,
	Turnovers.Contract AS Contract,
	Turnovers.ARAPObject AS ARAPObject,
	DocumentAmounts_.Organization.LocalAccountingCurrency AS Currency,
	DocumentAmounts_.Ref.SumCompl AS Sum
FROM
	Document.ARAPSettlement.AccountsPayable AS DocumentAmounts_
	INNER JOIN Turnovers AS Turnovers
	ON DocumentAmounts_.Ref = Turnovers.ARAPDocument
		AND DocumentAmounts_.ARAPObjectMirror = Turnovers.ARAPObject

UNION

// Storno offsetting
SELECT DISTINCT
	ReversingEntry.Ref AS Recorder,
	ReversingEntry.Number AS DocumentNumber,
	ReversingEntry.Date AS DocumentDate,
	Turnovers.PaymentType_ AS PaymentType_,
	Turnovers.Contract AS Contract,
	Turnovers.ARAPObject AS ARAPObject,
	ReversingEntry.Organization.LocalAccountingCurrency AS Currency,
	ARAPSettlement.SumCompl AS Sum
FROM
	Turnovers AS Turnovers
	INNER JOIN Document.ReversingEntry AS ReversingEntry
	ON Turnovers.ARAPDocument = ReversingEntry.Ref
		AND Turnovers.ARAPDocument &lt;&gt; UNDEFINED
	LEFT JOIN Document.ARAPSettlement AS ARAPSettlement
	ON ReversingEntry.ReversedDocument = ARAPSettlement.Ref
WHERE
	VALUETYPE(ReversingEntry.ReversedDocument) = TYPE(Document.ARAPSettlement)
	
INDEX BY
	Recorder,
	PaymentType_,
	Contract,
	ARAPObject,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT ALLOWED
	DocumentsRegistry.Ref AS Recorder,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Organization.ParentCompany AS ParentCompany,
	Turnovers.PaymentType_ AS PaymentType_,
	CASE
		WHEN VALUETYPE(Turnovers.ARAPDocument) IN 
					(TYPE(Document.BankAccountReceiptNote),
					TYPE(Document.BankAccountIssue))
			THEN CASE WHEN DocumentsRegistry.SourceDocumentDate = DATETIME(1,1,1)
							THEN DocumentsRegistry.RecordingInAccountingDate
							ELSE DocumentsRegistry.SourceDocumentDate
					END
		ELSE
			CASE WHEN DocumentsRegistry.SourceDocumentDate = DATETIME(1,1,1)
					THEN DocumentsRegistry.IBDocumentDate
					ELSE DocumentsRegistry.SourceDocumentDate
			END
	END AS DocumentDate,
	CASE WHEN DocumentsRegistry.SourceDocumentNumber = ""
		THEN DocumentsRegistry.IBDocumentNumber
		ELSE DocumentsRegistry.SourceDocumentNumber
	END AS DocumentNumber,
	DocumentsRegistry.IBDocumentDate AS IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber AS IBDocumentNumber,
	DocumentsRegistry.SourceDocumentName AS SourceDocumentName,
	DocumentsRegistry.SourceDocumentNumber AS SourceDocumentNumber,
	DocumentsRegistry.SourceDocumentDate AS SourceDocumentDate,
	DocumentsRegistry.CorrectedDocument AS CorrectedDocument,
	DocumentsRegistry.ReversedDocument AS ReversedDocument,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE WHEN DocumentsRegistry.Currency = VALUE(Catalog.Currencies.EmptyRef)
		THEN NULL
		ELSE DocumentsRegistry.Currency
	END AS Currency,
	DocumentsRegistry.Sum AS Sum
INTO DocumentsData
FROM
	Turnovers AS Turnovers
	INNER JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON Turnovers.ARAPDocument = DocumentsRegistry.Ref
		AND Turnovers.ARAPDocument &lt;&gt; UNDEFINED
WHERE
	VALUETYPE(DocumentsRegistry.Ref) &lt;&gt; TYPE(Document.ARAPAdjustment)
	AND VALUETYPE(DocumentsRegistry.Ref) &lt;&gt; TYPE(Document.ReversingEntry)

UNION ALL

SELECT DISTINCT
	RegisterAdjustment.Ref AS Recorder,
	Turnovers.Organization AS Organization,
	Turnovers.ParentCompany AS ParentCompany,
	Turnovers.PaymentType_ AS PaymentType_,
	RegisterAdjustment.Date AS DocumentDate,
	RegisterAdjustment.Number AS DocumentNumber,
	RegisterAdjustment.Date AS IBDocumentDate,
	RegisterAdjustment.Number AS IBDocumentNumber,
	"" AS SourceDocumentName,
	"" AS SourceDocumentNumber,
	UNDEFINED AS SourceDocumentDate,
	UNDEFINED AS CorrectedDocument,
	UNDEFINED AS ReversedDocument,
	FALSE AS ReverseTransactionCorrection,
	Turnovers.Currency AS Currency,
	0 AS Sum
FROM
	Turnovers AS Turnovers
	INNER JOIN Document.RegisterAdjustment AS RegisterAdjustment
	ON Turnovers.ARAPDocument = RegisterAdjustment.Ref
		AND Turnovers.ARAPDocument &lt;&gt; UNDEFINED

UNION ALL

SELECT DISTINCT
	ReversingEntry.Ref AS Recorder,
	Turnovers.Organization AS Organization,
	Turnovers.ParentCompany AS ParentCompany,
	Turnovers.PaymentType_ AS PaymentType_,
	ReversingEntry.Date AS DocumentDate,
	ReversingEntry.Number AS DocumentNumber,
	ReversingEntry.Date AS IBDocumentDate,
	ReversingEntry.Number AS IBDocumentNumber,
	"" AS SourceDocumentName,
	"" AS SourceDocumentNumber,
	UNDEFINED AS SourceDocumentDate,
	ReversingEntry.ReversedDocument AS CorrectedDocument,
	ReversingEntry.ReversedDocument AS ReversedDocument,
	TRUE AS ReverseTransactionCorrection,
	CASE WHEN DocumentsRegistry.Currency = VALUE(Catalog.Currencies.EmptyRef)
		THEN NULL
		ELSE DocumentsRegistry.Currency
	END AS Currency,
	DocumentsRegistry.Sum AS Sum
FROM
	Turnovers AS Turnovers
	INNER JOIN Document.ReversingEntry AS ReversingEntry
	ON Turnovers.ARAPDocument = ReversingEntry.Ref
		AND Turnovers.ARAPDocument &lt;&gt; UNDEFINED
	INNER JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON ReversingEntry.ReversedDocument = DocumentsRegistry.Ref
WHERE
	VALUETYPE(ReversingEntry.ReversedDocument) &lt;&gt; TYPE(Document.ARAPSettlement)

//#4
//#5

INDEX BY
	Recorder,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Turnovers.Period AS Period,
	Turnovers.PaymentType_ AS PaymentType_,
	Turnovers.Contract IN (
		UNDEFINED,
		VALUE(Catalog.CounterpartyContracts.EmptyRef),
		VALUE(Catalog.LeaseContract.EmptyRef),
		VALUE(Catalog.LoanAndDepositContracts.EmptyRef),
		VALUE(Catalog.IntercompanyContracts.EmptyRef)) AS EmptyContract,
	Turnovers.ARAPObject IN (
		UNDEFINED,
		VALUE(Catalog.ARAPObjects.EmptyRef)) AS EmptyCalculationObject,
	Turnovers.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Turnovers.Organization AS Organization,
	Turnovers.Partner AS Partner,
	Turnovers.Counterparty AS Counterparty,
	Turnovers.Contract AS Contract,
	Turnovers.ContractNumber AS ContractNumber,
	Turnovers.ContractDate_ AS ContractDate_,
	Turnovers.ContractName AS ContractName,
	Turnovers.LineOfBusiness AS LineOfBusiness,
	Turnovers.ARAPObject AS ARAPObject,
	Turnovers.ARAPDocument AS ARAPDocument,
	ISNULL(DocumentsData.DocumentDate,
		ISNULL(ARAPSettlement.DocumentDate, DATETIME(1,1,1))) AS DocumentDate,
	ISNULL(DocumentsData.DocumentNumber,
		ISNULL(ARAPSettlement.DocumentNumber, "")) AS DocumentNumber,
	ISNULL(DocumentsData.IBDocumentDate,
		ISNULL(ARAPSettlement.DocumentDate, DATETIME(1,1,1)))AS IBDocumentDate,
	ISNULL(DocumentsData.IBDocumentNumber,
		ISNULL(ARAPSettlement.DocumentNumber, "")) AS IBDocumentNumber,
	ISNULL(DocumentsData.SourceDocumentName, "") AS SourceDocumentName,
	ISNULL(DocumentsData.SourceDocumentNumber, "") AS SourceDocumentNumber,
	ISNULL(DocumentsData.SourceDocumentDate, "") AS SourceDocumentDate,
	ISNULL(DocumentsData.CorrectedDocument, UNDEFINED) AS CorrectedDocument,
	ISNULL(DocumentsData.ReversedDocument, UNDEFINED) AS ReversedDocument,
	ISNULL(DocumentsData.ReverseTransactionCorrection, FALSE) AS ReverseTransactionCorrection,
	Turnovers.Currency AS Currency,
	CASE WHEN &amp;ReconciliationInCurrency
		THEN Turnovers.Currency
		ELSE Companies.LocalAccountingCurrency
	END AS ReconciliationCurrency,
	Turnovers.AmountType AS AmountType,
	Turnovers.ContractsWithoutTurnover AS ContractsWithoutTurnover,
	ISNULL(ISNULL(ARAPSettlement.Currency, DocumentsData.Currency), Turnovers.Currency) AS DocumentCurrency,
	CASE
		WHEN VALUETYPE(Turnovers.ARAPDocument) = TYPE(Document.ARAPSettlement) 
			THEN
				ISNULL(ARAPSettlement.Sum, 0)
		WHEN (VALUETYPE(Turnovers.ARAPDocument) = TYPE(Document.LoanAndDepositInterestCharge)
					AND NOT &amp;ReconciliationInCurrency)
				OR VALUETYPE(Turnovers.ARAPDocument) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN
				Turnovers.DrLocalTurnover + Turnovers.CrLocalTurnover
		WHEN VALUETYPE(Turnovers.ARAPDocument) = TYPE(Document.LoanAndDepositInterestCharge)
				AND &amp;ReconciliationInCurrency
			THEN
				Turnovers.TurnoverDr + Turnovers.TurnoverCr
		ELSE 
			ISNULL(DocumentsData.Sum, 0)
	END AS DocumentAmount,
	
	Turnovers.OpeningBalance AS OpeningBalance,
	Turnovers.OpeningBalanceLocal AS OpeningBalanceLocal,
	Turnovers.OpeningBalanceDr AS OpeningBalanceDr,
	Turnovers.DrLocalOpeningBalance AS DrLocalOpeningBalance,
	Turnovers.OpeningBalanceCr AS OpeningBalanceCr,
	Turnovers.InitialBalanceOfCrLocal AS InitialBalanceOfCrLocal,
	
	Turnovers.TurnoverDr AS TurnoverDr,
	Turnovers.DrLocalTurnover AS DrLocalTurnover,
	Turnovers.TurnoverCr AS TurnoverCr,
	Turnovers.CrLocalTurnover AS CrLocalTurnover,
	
	Turnovers.ClosingBalance AS ClosingBalance,
	Turnovers.ClosingBalanceLocal AS ClosingBalanceLocal,
	Turnovers.ClosingBalanceDr AS ClosingBalanceDr,
	Turnovers.ClosingBalanceCr AS ClosingBalanceCr,
	Turnovers.FinalBalanceOfDrLocal AS FinalBalanceOfDrLocal,
	Turnovers.FinalBalanceOfCrLocal AS FinalBalanceOfCrLocal,
	
	Turnovers.Debt AS DebtAmount_,
	Turnovers.DebtLocal AS DebtAmountLocal,
	Turnovers.Prepayment AS AmountPrepayment,
	Turnovers.PrepaymentLocal AS PrepaymentAmountLocal_,
	Turnovers.TurnoverDr AS DebitAmount,
	Turnovers.DrLocalTurnover AS LocalDebitAmount,
	Turnovers.TurnoverCr AS LoanAmount_,
	Turnovers.CrLocalTurnover AS LocalCreditAmount,
	
	Documents.Ref AS ReconciliationDocument,
	CASE WHEN Documents.Ref IS NULL THEN
		FALSE
	ELSE
		TRUE
	END             AS ThereAreDocuments,
	&amp;ModifyDocumentLine AS ChangeDocument,
	CASE WHEN Documents.Ref IS NULL THEN
		TRUE
	ELSE
		FALSE
	END             AS CreateADocument,
	Documents.DescriptionOfOutgoingDocuments AS DescriptionOfOutgoingDocuments,
	StatesByEDIAccountingObjects.EDIState AS EDIState,
	ISNULL(SaleAdjustment.AdjustmentKind, UNDEFINED) 
		= VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties) AS ThisIsUAD,
	Turnovers.PaymentTypeOrder AS PaymentTypeOrder
INTO TTReconciliationData
FROM
	Turnovers AS Turnovers
	LEFT JOIN Catalog.Companies AS Companies
		ON Turnovers.Organization = Companies.Ref
	LEFT JOIN Document.ARAPReconciliation2_5_11 AS Documents
		ON Turnovers.Organization                           = Documents.Organization
			AND CASE WHEN &amp;ReconciliationInCurrency
				THEN Turnovers.Currency
				ELSE Companies.LocalAccountingCurrency
			END = Documents.Currency
			AND (Turnovers.PaymentType_                       = Documents.PaymentType_ OR NOT &amp;SplitByARAPTypes)
			AND (Turnovers.Partner                           = Documents.Partner OR NOT &amp;SplitByPartners)
			AND Turnovers.Counterparty                         = Documents.Counterparty
			AND (Turnovers.Contract                           = Documents.Contract OR NOT &amp;SplitByContracts)
			AND Documents.BeginOfPeriod                    = &amp;BeginOfPeriod
			AND ENDOFPERIOD(Documents.EndOfPeriod, DAY) = &amp;EndOfPeriod
			AND NOT Documents.DeletionMark
			AND &amp;ReceiveReconciliationDocuments
	LEFT JOIN DocumentsData AS DocumentsData
		ON Turnovers.ARAPDocument = DocumentsData.Recorder
			AND Turnovers.ParentCompany = DocumentsData.ParentCompany
			AND Turnovers.PaymentType_ = DocumentsData.PaymentType_
	LEFT JOIN TTDebtOffset AS ARAPSettlement
		ON Turnovers.ARAPDocument = ARAPSettlement.Recorder
			AND Turnovers.PaymentType_ = ARAPSettlement.PaymentType_
			AND Turnovers.Contract = ARAPSettlement.Contract
			AND Turnovers.ARAPObject = ARAPSettlement.ARAPObject
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS StatesByEDIAccountingObjects
		ON Documents.Ref = StatesByEDIAccountingObjects.ObjectReference
	LEFT JOIN Document.RegisterAdjustment AS RegisterAdjustment
		ON Turnovers.ARAPDocument = RegisterAdjustment.Ref
	LEFT JOIN Document.SaleAdjustment AS SaleAdjustment
		ON Turnovers.ARAPDocument = SaleAdjustment.Ref
WHERE
	// exclude system adjustments of the expanded balance
	(RegisterAdjustment.Operation = VALUE(Enum.RegisterAdjustmentOperations.ManualAdjustment)
		OR RegisterAdjustment.Operation IS NULL)
		
INDEX BY
	ARAPDocument
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ReconciliationData.Period AS DateOfTransaction,
	ReconciliationData.PaymentType_ AS PaymentType_,
	ReconciliationData.EmptyContract AS EmptyContract,
	ReconciliationData.EmptyCalculationObject AS EmptyCalculationObject,
	ReconciliationData.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	ReconciliationData.Organization AS Organization,
	CASE WHEN &amp;ContractReconciliationMode AND NOT &amp;SplitByPartners
		THEN UNDEFINED
		ELSE ReconciliationData.Partner
	END AS Partner,
	ReconciliationData.Counterparty AS Counterparty,
	ReconciliationData.Contract AS Contract,
	ReconciliationData.ContractNumber AS ContractNumber,
	ReconciliationData.ContractDate_ AS ContractDate_,
	ReconciliationData.ContractName AS ContractName,
	ReconciliationData.LineOfBusiness AS LineOfBusiness,
	ReconciliationData.ARAPObject AS ARAPObject,
	ReconciliationData.ARAPDocument AS ARAPDocument,
	ReconciliationData.DocumentDate AS DocumentDate,
	ReconciliationData.DocumentNumber AS DocumentNumber,
	ReconciliationData.IBDocumentDate AS IBDocumentDate,
	ReconciliationData.IBDocumentNumber AS IBDocumentNumber,
	ReconciliationData.SourceDocumentName AS SourceDocumentName,
	ReconciliationData.SourceDocumentNumber AS SourceDocumentNumber,
	ReconciliationData.SourceDocumentDate AS SourceDocumentDate,
	ReconciliationData.CorrectedDocument AS CorrectedDocument,
	ReconciliationData.ReversedDocument AS ReversedDocument,
	ReconciliationData.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	ReconciliationData.Currency AS Currency,
	ReconciliationData.ReconciliationCurrency AS ReconciliationCurrency,
	ReconciliationData.AmountType AS AmountType,
	ReconciliationData.ContractsWithoutTurnover AS ContractsWithoutTurnover,
	ReconciliationData.DocumentCurrency AS DocumentCurrency,
	ReconciliationData.DocumentAmount AS DocumentAmount,
	
	ReconciliationData.OpeningBalance AS OpeningBalance,
	ReconciliationData.OpeningBalanceLocal AS OpeningBalanceLocal,
	ReconciliationData.OpeningBalanceDr AS OpeningBalanceDr,
	ReconciliationData.DrLocalOpeningBalance AS DrLocalOpeningBalance,
	ReconciliationData.OpeningBalanceCr AS OpeningBalanceCr,
	ReconciliationData.InitialBalanceOfCrLocal AS InitialBalanceOfCrLocal,
	
	ReconciliationData.TurnoverDr AS TurnoverDr,
	ReconciliationData.DrLocalTurnover AS DrLocalTurnover,
	ReconciliationData.TurnoverCr AS TurnoverCr,
	ReconciliationData.CrLocalTurnover AS CrLocalTurnover,
	
	ReconciliationData.ClosingBalance AS ClosingBalance,
	ReconciliationData.ClosingBalanceLocal AS ClosingBalanceLocal,
	ReconciliationData.ClosingBalanceDr AS ClosingBalanceDr,
	ReconciliationData.ClosingBalanceCr AS ClosingBalanceCr,
	ReconciliationData.FinalBalanceOfDrLocal AS FinalBalanceOfDrLocal,
	ReconciliationData.FinalBalanceOfCrLocal AS FinalBalanceOfCrLocal,
	
	ReconciliationData.DebtAmount_ AS DebtAmount_,
	ReconciliationData.DebtAmountLocal AS DebtAmountLocal,
	ReconciliationData.AmountPrepayment AS AmountPrepayment,
	ReconciliationData.PrepaymentAmountLocal_ AS PrepaymentAmountLocal_,
	ReconciliationData.TurnoverDr AS DebitAmount,
	ReconciliationData.DrLocalTurnover AS LocalDebitAmount,
	ReconciliationData.TurnoverCr AS LoanAmount_,
	ReconciliationData.CrLocalTurnover AS LocalCreditAmount,
	
	ReconciliationData.ReconciliationDocument AS ReconciliationDocument,
	ReconciliationData.ThereAreDocuments AS ThereAreDocuments,
	ReconciliationData.ChangeDocument AS ChangeDocument,
	ReconciliationData.CreateADocument AS CreateADocument,
	
	ReconciliationData.EDIState AS EDIState,
	ReconciliationData.DescriptionOfOutgoingDocuments AS DescriptionOfOutgoingDocuments,
	ReconciliationData.ThisIsUAD AS ThisIsUAD,
	
	ReconciliationData.PaymentTypeOrder AS PaymentTypeOrder
{SELECT
	DateOfTransaction AS DateOfTransaction,
	PaymentType_ AS PaymentType_,
	AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Organization AS Organization,
	Partner AS Partner,
	Counterparty AS Counterparty,
	Contract AS Contract,
	ContractNumber AS ContractNumber,
	ContractDate_ AS ContractDate_,
	ContractName AS ContractName,
	LineOfBusiness AS LineOfBusiness,
	ARAPObject AS ARAPObject,
	ARAPDocument AS ARAPDocument,
	DocumentDate AS DocumentDate,
	DocumentNumber AS DocumentNumber,
	IBDocumentDate AS IBDocumentDate,
	IBDocumentNumber AS IBDocumentNumber,
	SourceDocumentName AS SourceDocumentName,
	SourceDocumentNumber AS SourceDocumentNumber,
	SourceDocumentDate AS SourceDocumentDate,
	CorrectedDocument AS CorrectedDocument,
	ReversedDocument AS ReversedDocument,
	ReverseTransactionCorrection AS ReverseTransactionCorrection,
	Currency AS Currency,
	ReconciliationCurrency AS ReconciliationCurrency,
	AmountType AS AmountType,
	DocumentCurrency AS DocumentCurrency,
	DocumentAmount AS DocumentAmount,
	
	OpeningBalance AS OpeningBalance,
	OpeningBalanceLocal AS OpeningBalanceLocal,
	OpeningBalanceDr AS OpeningBalanceDr,
	DrLocalOpeningBalance AS DrLocalOpeningBalance,
	OpeningBalanceCr AS OpeningBalanceCr,
	InitialBalanceOfCrLocal AS InitialBalanceOfCrLocal,
	
	TurnoverDr AS TurnoverDr,
	DrLocalTurnover AS DrLocalTurnover,
	TurnoverCr AS TurnoverCr,
	CrLocalTurnover AS CrLocalTurnover,
	
	ClosingBalance AS ClosingBalance,
	ClosingBalanceLocal AS ClosingBalanceLocal,
	ClosingBalanceDr AS ClosingBalanceDr,
	ClosingBalanceCr AS ClosingBalanceCr,
	FinalBalanceOfDrLocal AS FinalBalanceOfDrLocal,
	FinalBalanceOfCrLocal AS FinalBalanceOfCrLocal,
	
	DebtAmount_ AS DebtAmount_,
	DebtAmountLocal AS DebtAmountLocal,
	AmountPrepayment AS AmountPrepayment,
	PrepaymentAmountLocal_ AS PrepaymentAmountLocal_,
	TurnoverDr AS DebitAmount,
	DrLocalTurnover AS LocalDebitAmount,
	TurnoverCr AS LoanAmount_,
	CrLocalTurnover AS LocalCreditAmount,
	
	ReconciliationDocument AS ReconciliationDocument,
	ThereAreDocuments AS ThereAreDocuments,
	ChangeDocument AS ChangeDocument,
	CreateADocument AS CreateADocument,
	
	EDIState AS EDIState,
	DescriptionOfOutgoingDocuments AS DescriptionOfOutgoingDocuments,
	ThisIsUAD AS ThisIsUAD,
	
	PaymentTypeOrder AS PaymentTypeOrder
}
FROM
	TTReconciliationData AS ReconciliationData
	//#Service connectionsreferences
WHERE
	NOT (ReconciliationData.Contract.Number IS NULL AND NOT ReconciliationData.EmptyContract
		OR ReconciliationData.ARAPObject.Number IS NULL AND NOT ReconciliationData.EmptyCalculationObject)
	//#Custom ServiCesrefeRences
{WHERE
	ReconciliationData.ContractsWithoutTurnover,
	ReconciliationData.PaymentType_,
	ReconciliationData.Organization.*,
	ReconciliationData.Partner,
	ReconciliationData.Counterparty.*,
	ReconciliationData.Contract.*,
	ReconciliationData.LineOfBusiness.*,
	ReconciliationData.ARAPObject.*,
	ReconciliationData.ARAPDocument.*,
	ReconciliationData.DocumentDate,
	ReconciliationData.DocumentNumber,
	ReconciliationData.SourceDocumentName,
	ReconciliationData.SourceDocumentNumber,
	ReconciliationData.SourceDocumentDate,
	ReconciliationData.CorrectedDocument,
	ReconciliationData.ReversedDocument,
	ReconciliationData.ReverseTransactionCorrection,
	ReconciliationData.Currency.*,
	ReconciliationData.AmountType,
	ReconciliationData.OpeningBalance,
	ReconciliationData.OpeningBalanceLocal,
	ReconciliationData.ClosingBalance,
	ReconciliationData.ClosingBalanceLocal
}

ORDER BY
	Period,
	Organization,
	Counterparty</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
