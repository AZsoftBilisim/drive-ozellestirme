	<parameter>
		<name>SplitByPartners</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Split by partners</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تفکیک بر اساس شرکا</v8:content>
			</v8:item>
			<v8:item>
