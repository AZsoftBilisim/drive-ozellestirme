    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ARAPReconciliation.Ref AS Ref,
	ARAPReconciliation.DeletionMark AS DeletionMark,
	ARAPReconciliation.Number AS Number,
	ARAPReconciliation.Date AS Date,
	ARAPReconciliation.Organization AS Organization,
	ARAPReconciliation.Counterparty AS Counterparty,
	ARAPReconciliation.PaymentType_ AS PaymentType_,
	ARAPReconciliation.Partner AS Partner,
	ARAPReconciliation.Contract AS Contract,
	ARAPReconciliation.Manager AS Manager,
	ARAPReconciliation.Status AS Status,
	EDStates.EDIState AS EDIState,
	EDStates.StatusPresentation AS StatusPresentation
FROM
	Document.ARAPReconciliation2_5_11 AS ARAPReconciliation
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON ARAPReconciliation.Ref = EDStates.ObjectReference}</queryText>
      <mainTable>Document.ARAPReconciliation2_5_11</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
