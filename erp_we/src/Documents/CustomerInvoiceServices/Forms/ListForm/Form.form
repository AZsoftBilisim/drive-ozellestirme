    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       CustomerInvoiceServices.Ref, 
       CustomerInvoiceServices.DeletionMark, 
       CustomerInvoiceServices.Number, 
       CustomerInvoiceServices.Date, 
       CustomerInvoiceServices.Posted, 
       CustomerInvoiceServices.InvoiceByOrders, 
       CustomerInvoiceServices.CounterpartyBankAccount, 
       CustomerInvoiceServices.CompanyBankAccount, 
       CustomerInvoiceServices.Currency, 
       CustomerInvoiceServices.ARAPCurrency, 
       CustomerInvoiceServices.AdditionalInformation, 
       CustomerInvoiceServices.AdditionalInformationOfHeader, 
       CustomerInvoiceServices.SalesOrder, 
       CustomerInvoiceServices.CashAccount, 
       CustomerInvoiceServices.Comment, 
       CustomerInvoiceServices.Counterparty, 
       CustomerInvoiceServices.Manager, 
       CustomerInvoiceServices.VATTaxation, 
       CustomerInvoiceServices.Organization, 
       CustomerInvoiceServices.Partner, 
       CustomerInvoiceServices.Department, 
       CustomerInvoiceServices.SalesOpportunity, 
       CustomerInvoiceServices.DiscountsAreCalculated, 
       CustomerInvoiceServices.Approved, 
       CustomerInvoiceServices.Terms, 
       CustomerInvoiceServices.AmountARAP, 
       CustomerInvoiceServices.DocumentAmount, 
       CustomerInvoiceServices.PaymentMethod, 
       CustomerInvoiceServices.PriceIncludesVAT, 
       CustomerInvoiceServices.FinancialAccountingGroup, 
       CustomerInvoiceServices.LoyaltyCard, 
       CustomerInvoiceServices.Contract, 
       CustomerInvoiceServices.Author, 
       CustomerInvoiceServices.ContactPerson, 
       CustomerInvoiceServices.Director, 
       CustomerInvoiceServices.ChiefAccountant, 
       CustomerInvoiceServices.ARAPObjectSettings, 
       CustomerInvoiceServices.PaymentID, 
       CustomerInvoiceServices.LineOfBusiness, 
       CustomerInvoiceServices.CourseNumerator, 
       CustomerInvoiceServices.CourseDenominator, 
       CustomerInvoiceServices.Basis, 
       CustomerInvoiceServices.ReferenceDocumentDateForPrintForms, 
       CustomerInvoiceServices.BaseDocumentNumber, 
       CustomerInvoiceServices.Services.*, 
       CustomerInvoiceServices.DiscountsMarkups.*, 
       CustomerInvoiceServices.AdditionalAttributes.*, 
       CustomerInvoiceServices.ARAPDetails.*, 
       CustomerInvoiceServices.PaymentScheduleSteps.*, 
       CustomerInvoiceServices.PointInTime,
       EDStates.EDIState,
       EDStates.StatusPresentation
 FROM 
       Document.CustomerInvoiceServices AS CustomerInvoiceServices
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = CustomerInvoiceServices.Ref)
       </queryText>
      <mainTable>Document.CustomerInvoiceServices</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
