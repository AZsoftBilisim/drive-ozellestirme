		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CustomerInvoiceServices.Number,
	CustomerInvoiceServices.Date,
	CustomerInvoiceServices.CompanyBankAccount,
	CustomerInvoiceServices.Currency,
	CustomerInvoiceServices.Counterparty,
	CustomerInvoiceServices.Manager,
	CustomerInvoiceServices.Organization,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	CustomerInvoiceServices.Terms,
	CustomerInvoiceServices.PaymentMethod,
	CustomerInvoiceServices.DocumentAmount,
	CustomerInvoiceServices.LoyaltyCard,
	CustomerInvoiceServices.Contract,
	ContactPersonsForPartners.BirthDate AS ContactPersonDateOfBirth
FROM
	Document.CustomerInvoiceServices AS CustomerInvoiceServices
		{LEFT JOIN Catalog.Partners AS Partners
		ON CustomerInvoiceServices.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON CustomerInvoiceServices.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	CustomerInvoiceServices.Ref = &amp;CustomerInvoiceServices</query>
	</dataSet>
