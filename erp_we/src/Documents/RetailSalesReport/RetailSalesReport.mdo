    <attributes uuid="fac88c9a-cd54-4630-9213-01244bf5d0a1">
      <name>NumberOfPackagesReal</name>
      <synonym>
        <key>en</key>
        <value>Actual quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار واقعی</value>
      </synonym>
      <synonym>
