    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentFixedAssetsPhysicalCount.Ref,
	DocumentFixedAssetsPhysicalCount.DeletionMark,
	DocumentFixedAssetsPhysicalCount.Number,
	DocumentFixedAssetsPhysicalCount.Date,
	DocumentFixedAssetsPhysicalCount.Posted,
	DocumentFixedAssetsPhysicalCount.Organization,
	DocumentFixedAssetsPhysicalCount.Department,
	DocumentFixedAssetsPhysicalCount.DocumentBasisKind,
	DocumentFixedAssetsPhysicalCount.DocumentBaseDocumentNumber,
	DocumentFixedAssetsPhysicalCount.DocumentReferenceDocumentDateForPrintForms,
	DocumentFixedAssetsPhysicalCount.StartDateOfInventory,
	DocumentFixedAssetsPhysicalCount.EndDateOfInventory,
	DocumentFixedAssetsPhysicalCount.PhysicalInventoryCountReason,
	DocumentFixedAssetsPhysicalCount.EmployeeResponsible,
	DocumentFixedAssetsPhysicalCount.Comment,
	DocumentFixedAssetsPhysicalCount.BusinessOperation,
	DocumentFixedAssetsPhysicalCount.FA,
	DocumentFixedAssetsPhysicalCount.PhysicalInventoryCountCommission,
	DocumentFixedAssetsPhysicalCount.PointInTime,
    EDStates.EDIState,
    EDStates.StatusPresentation	
FROM
	Document.FixedAssetsPhysicalCount AS DocumentFixedAssetsPhysicalCount
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentFixedAssetsPhysicalCount.Ref)
</queryText>
      <mainTable>Document.FixedAssetsPhysicalCount</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
