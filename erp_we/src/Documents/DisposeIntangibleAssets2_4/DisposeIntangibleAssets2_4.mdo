    <attributes uuid="98308f71-c623-4065-9638-6f25fcfb8d3e">
      <name>ResidualValueMan</name>
      <synonym>
        <key>en</key>
        <value>Residual value (management accounting)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>ارزش باقی‌مانده (حسابداری مدیریتی)</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Valore diu liquidazione</value>
