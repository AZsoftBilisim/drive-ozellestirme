    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DebitCustomerRebates.Ref,
	DebitCustomerRebates.DeletionMark,
	DebitCustomerRebates.Number,
	DebitCustomerRebates.Date,
	DebitCustomerRebates.Posted,
	DebitCustomerRebates.Status,
	DebitCustomerRebates.Organization,
	DebitCustomerRebates.Counterparty,
	DebitCustomerRebates.Currency,
	DebitCustomerRebates.DocumentAmount,
	DebitCustomerRebates.EmployeeResponsible,
	DebitCustomerRebates.Comment,
	DebitCustomerRebates.DrillDownDebits.*,
	DebitCustomerRebates.AdditionalAttributes.*,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Document.DebitCustomerRebates AS DebitCustomerRebates
		{LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON DebitCustomerRebates.Ref = FilesExist.ObjectWithFiles}</queryText>
      <mainTable>Document.DebitCustomerRebates</mainTable>
