          </value>
        </choiceList>
        <choiceList>
          <presentation>
            <key>en</key>
            <value>by work duration</value>
          </presentation>
          <presentation>
            <key>fa</key>
            <value>بر اساس مدت کار</value>
          </presentation>
          <presentation>
            <key>it</key>
            <value>secondo la durata del lavoro</value>
          </presentation>
          <presentation>
            <key>pl</key>
            <value>wg czasu trwania prac</value>
          </presentation>
          <presentation>
            <key>ru</key>
            <value>по длительности работ</value>
          </presentation>
          <presentation>
            <key>tr</key>
            <value>iş devam süresine göre</value>
          </presentation>
          <presentation>
            <key>vi</key>
            <value>theo thời gian làm việc</value>
          </presentation>
          <value xsi:type="core:ReferenceValue">
            <value>Enum.TypesOfCostAllocatingBase.EnumValue.WorkPerformanceDuration</value>
          </value>
        </choiceList>
      </extInfo>
    </items>
    <items xsi:type="form:FormField">
