          </presentation>
          <presentation>
            <key>fa</key>
            <value>بر اساس بهای تمام‌شده استاندارد کارها</value>
          </presentation>
          <presentation>
            <key>it</key>
            <value>Secondo il costo di lavoro standard</value>
          </presentation>
          <presentation>
            <key>pl</key>
            <value>wg normatywnych kosztów prac</value>
          </presentation>
          <presentation>
            <key>ru</key>
            <value>по нормативной стоимости работ</value>
          </presentation>
          <presentation>
            <key>tr</key>
            <value>standart iş maliyetine göre</value>
          </presentation>
          <presentation>
            <key>vi</key>
            <value>với chi phí tiêu chuẩn của công việc</value>
