    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Cash.Organization    AS Organization,
	Cash.Recipient     AS BankAccount,
	Cash.Sender    AS CashAccount,
	Cash.Currency         AS Currency,
	CASE WHEN Cash.SumBalance &lt; 0 THEN
		-Cash.SumBalance
	ELSE
		0
	END AS ExcessAmount,
	CASE WHEN Cash.SumBalance > 0 THEN
		Cash.SumBalance
	ELSE
		0
	END AS AmountInTransit
FROM
	AccumulationRegister.CashInTransit.Balance(,
		CashTransferKind = VALUE(Enum.CashTransferKinds.CashDepositToBank)
	) AS Cash</queryText>
      <mainTable>AccumulationRegister.CashInTransit.Balance</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
