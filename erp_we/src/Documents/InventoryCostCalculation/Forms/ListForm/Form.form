    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentInventoryCostCalculation.Ref,
	DocumentInventoryCostCalculation.DeletionMark,
	DocumentInventoryCostCalculation.Number,
	DocumentInventoryCostCalculation.Date,
	DocumentInventoryCostCalculation.Posted,
	DocumentInventoryCostCalculation.Organization,
	CASE
		WHEN DocumentInventoryCostCalculation.Organization = VALUE(Catalog.Companies.EmptyRef)
			THEN DocumentInventoryCostCalculation.CalculatedCompanies
		ELSE DocumentInventoryCostCalculation.Organization.Description
	END AS CalculatedCompanies,
	DocumentInventoryCostCalculation.PreliminaryCalculation,
	DocumentInventoryCostCalculation.EvaluationMethod,
	DocumentInventoryCostCalculation.EntryType,
	DocumentInventoryCostCalculation.Comment,
	DocumentInventoryCostCalculation.Companies.(
		Ref,
		LineNumber,
		Organization
	),
	DocumentInventoryCostCalculation.PointInTime
FROM
	Document.InventoryCostCalculation AS DocumentInventoryCostCalculation</queryText>
      <mainTable>Document.InventoryCostCalculation</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
