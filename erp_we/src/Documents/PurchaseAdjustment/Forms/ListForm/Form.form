      <value>Danh sách điều chỉnh mua</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurchaseAdjustmentList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentPurchaseAdjustment.Ref,
	DocumentPurchaseAdjustment.DataVersion,
	DocumentPurchaseAdjustment.DeletionMark,
	DocumentPurchaseAdjustment.Number,
	DocumentPurchaseAdjustment.Date,
	DocumentPurchaseAdjustment.Posted,
	DocumentPurchaseAdjustment.DocumentBasis,
	DocumentPurchaseAdjustment.Partner,
	DocumentPurchaseAdjustment.Counterparty,
	DocumentPurchaseAdjustment.Terms,
	DocumentPurchaseAdjustment.Organization,
	DocumentPurchaseAdjustment.Contract,
	DocumentPurchaseAdjustment.Warehouse,
	DocumentPurchaseAdjustment.Department,
	DocumentPurchaseAdjustment.SalesOpportunity,
	DocumentPurchaseAdjustment.Currency,
	DocumentPurchaseAdjustment.ARAPCurrency,
	DocumentPurchaseAdjustment.Manager,
	DocumentPurchaseAdjustment.DocumentAmount,
	DocumentPurchaseAdjustment.PaymentDate,
	DocumentPurchaseAdjustment.PaymentMethod,
	DocumentPurchaseAdjustment.PriceIncludesVAT,
	DocumentPurchaseAdjustment.VATTaxation,
	DocumentPurchaseAdjustment.ReceiptUnderOrders,
	DocumentPurchaseAdjustment.IncomeItem,
	DocumentPurchaseAdjustment.DimensionOfRevenue,
	DocumentPurchaseAdjustment.ExpenseItem,
	DocumentPurchaseAdjustment.DimensionOfExpenses,
	DocumentPurchaseAdjustment.Approved,
	DocumentPurchaseAdjustment.IncomingDocumentNumber,
	DocumentPurchaseAdjustment.IncomingDocumentDate,
	DocumentPurchaseAdjustment.Comment,
	DocumentPurchaseAdjustment.AdjustmentKind,
	DocumentPurchaseAdjustment.Author,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	//++ Localization
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
	//-- Localization
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
FROM
	Document.PurchaseAdjustment AS DocumentPurchaseAdjustment
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON DocumentPurchaseAdjustment.Ref = EDStates.ObjectReference
		LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentPurchaseAdjustment.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.PurchaseAdjustment</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
