    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
	DocumentsRegistry.RefType, 
	DocumentsRegistry.BusinessOperation, 
	DocumentsRegistry.Organization, 
	DocumentsRegistry.Partner, 
	DocumentsRegistry.StorageLocation, 
	DocumentsRegistry.Counterparty, 
	DocumentsRegistry.Department, 
	DocumentsRegistry.IBDocumentDate, 
	DocumentsRegistry.Ref, 
	DocumentsRegistry.RecordSeparator, 
	DocumentsRegistry.IBDocumentNumber, 
	DocumentsRegistry.Status, 
	DocumentsRegistry.EmployeeResponsible, 
	DocumentsRegistry.AdditionalRecord, 
	DocumentsRegistry.More, 
	DocumentsRegistry.Comment, 
	DocumentsRegistry.Posted, 
	DocumentsRegistry.DeletionMark, 
	DocumentsRegistry.SourceDocumentDate, 
	DocumentsRegistry.Sum, 
	DocumentsRegistry.Currency, 
	DocumentsRegistry.Contract, 
	DocumentsRegistry.SourceDocumentNumber, 
	DocumentsRegistry.LineOfBusiness, 
	DocumentsRegistry.RecordingInAccountingDate, 
	DocumentsRegistry.Priority, 
	DocumentsRegistry.ReversedDocument, 
	DocumentsRegistry.CorrectedDocument, 
	DocumentsRegistry.ReverseTransactionCorrection, 
	DocumentsRegistry.Author, 
	DocumentsRegistry.SourceDocumentName,
	CASE 
		WHEN DocumentsRegistry.Ref IN (&amp;SelectedDocuments)
			THEN TRUE
		ELSE FALSE
	END AS Selected,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	VALUETYPE(DocumentsRegistry.Ref) AS ValueType
 FROM 
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
	LEFT JOIN
		InformationRegister.DocumentsRegistry AS RegisterOfDocumentsStornoCorrection
	ON
		RegisterOfDocumentsStornoCorrection.ReversedDocument = DocumentsRegistry.Ref
		AND RegisterOfDocumentsStornoCorrection.ReverseTransactionCorrection
		AND RegisterOfDocumentsStornoCorrection.Posted
		AND NOT RegisterOfDocumentsStornoCorrection.AdditionalRecord
WHERE
	NOT DocumentsRegistry.AdditionalRecord
	AND DocumentsRegistry.RefType IN (&amp;MetadataObjectIDs)
	AND TRUE IN (
		SELECT TOP 1
			TRUE
		FROM
			AccumulationRegister.VendorsARAPAccounting AS VendorsARAPAccounting
		WHERE
			VendorsARAPAccounting.Recorder = DocumentsRegistry.Ref
			AND VendorsARAPAccounting.Currency = &amp;ARAPCurrency
			
		UNION ALL
		
		SELECT TOP 1
			TRUE
		FROM
			Document.SourceDocument AS SourceDocument  
		WHERE
			SourceDocument.Ref = DocumentsRegistry.Ref
			AND SourceDocument.SourceDocumentType = VALUE(Enum.SourceDocumentTypes.PurchaseFromVendor)
			AND SourceDocument.ARAPCurrency = &amp;ARAPCurrency
	)
{WHERE
	DocumentsRegistry.Ref.* AS Ref,
	DocumentsRegistry.StorageLocation.* AS StorageLocation,
	(CAST(DocumentsRegistry.StorageLocation.Key AS Catalog.Warehouses)).* AS Warehouse,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.Status AS Status,
	DocumentsRegistry.RefType AS RefType,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Partner.* AS Partner,
	(CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties)).* AS Counterparty,
	DocumentsRegistry.Contract.* AS Contract,
	DocumentsRegistry.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS Manager,
	DocumentsRegistry.Author.* AS Author,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	((DocumentsRegistry.IBDocumentDate >= &amp;BeginOfPeriod
			OR &amp;BeginOfPeriod = DATETIME(1, 1, 1))
			AND (DocumentsRegistry.IBDocumentDate &lt;= &amp;EndOfPeriod
				OR &amp;EndOfPeriod = DATETIME(1, 1, 1)))}
</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
