  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentReceivingLeaseServices.Ref,
	DocumentReceivingLeaseServices.DeletionMark,
	DocumentReceivingLeaseServices.Number,
	DocumentReceivingLeaseServices.Date,
	DocumentReceivingLeaseServices.Posted,
	DocumentReceivingLeaseServices.Organization,
	DocumentReceivingLeaseServices.Counterparty,
	DocumentReceivingLeaseServices.Department,
	DocumentReceivingLeaseServices.DocumentAmount,
	DocumentReceivingLeaseServices.Comment,
	DocumentReceivingLeaseServices.EmployeeResponsible,
	DocumentReceivingLeaseServices.Currency,
	DocumentReceivingLeaseServices.VATTaxation,
	DocumentReceivingLeaseServices.ARAPCurrency,
	DocumentReceivingLeaseServices.PriceIncludesVAT,
	DocumentReceivingLeaseServices.IncomingDocumentNumber,
	DocumentReceivingLeaseServices.IncomingDocumentDate,
	DocumentReceivingLeaseServices.Contract,
	DocumentReceivingLeaseServices.PurchaseForActivity,
	DocumentReceivingLeaseServices.AmountARAP,
	DocumentReceivingLeaseServices.Author,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
FROM
	Document.ReceivingLeaseServices AS DocumentReceivingLeaseServices
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentReceivingLeaseServices.Ref = DocumentsWithCounterpartyCheckErrors.Document
		AND (&amp;UsingOfCheckIsAnOption)}</queryText>
      <mainTable>Document.ReceivingLeaseServices</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
