  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentTransportationJob.Ref,
	DocumentTransportationJob.DeletionMark,
	DocumentTransportationJob.Number,
	DocumentTransportationJob.Date,
	DocumentTransportationJob.Posted,
	CAST(DocumentTransportationJob.AdditionalInformation AS STRING(1000)) AS AdditionalInformation,
	DocumentTransportationJob.Status,
	CAST(DocumentTransportationJob.Comment AS STRING(1000)) AS Comment,
	DocumentTransportationJob.EmployeeResponsible,
	DocumentTransportationJob.PlanTripStartTime,
	DocumentTransportationJob.PlanTripEndTime,
	DocumentTransportationJob.ActualTripStartTime,
	DocumentTransportationJob.ActualTripEndTime,
	DocumentTransportationJob.Vehicle_,
	DocumentTransportationJob.CourierShippingAgent,
	DocumentTransportationJob.Driver,
	DocumentTransportationJob.Warehouse,
	DocumentTransportationJob.Weight,
	DocumentTransportationJob.VolumeM3,
	DocumentTransportationJob.PointsNumber,
	DocumentTransportationJob.Priority,
	DocumentTransportationJob.Operation,
	CASE
		WHEN DocumentTransportationJob.JobIsPerformedBy = VALUE(Enum.TypesOfTransportationJobAssignees.OurTransportationService)
			THEN 1
		ELSE 0
	END AS IndexOfImagePerformsTask,
	DocumentTransportationJob.JobIsPerformedBy
FROM
	Document.TransportationJob AS DocumentTransportationJob</queryText>
      <mainTable>Document.TransportationJob</mainTable>
