		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CommercialProposalForCustomer.Number          AS Number,
	CommercialProposalForCustomer.Date           AS Date,
	CommercialProposalForCustomer.Status         AS Status,
	Partners.Description                         AS PartnerName_,
	Partners.BusinessRegion                         AS BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END                                          AS PartnerAppeal,
	Partners.BirthDate                          AS BirthDate,
	ContactPersonsForPartners.Description           AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard     AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END                                                              AS ContactPersonAddress,
	CommercialProposalForCustomer.PaymentTermsText                  AS PaymentTerm,
	CASE
		WHEN PartialSaleAllowed 
			THEN &amp;PartialSaleAllowed
		ELSE &amp;NotPartialSaleAllowed
	END                                                              AS PartialSaleAllowed,
	CommercialProposalForCustomer.OtherAdditionalInformationText AS AdditionalInformation,
	CommercialProposalForCustomer.Manager                            AS Manager,
	CommercialProposalForCustomer.Currency                              AS Currency,
	CommercialProposalForCustomer.DocumentAmount                      AS DocumentAmount,
	CommercialProposalForCustomer.LoyaltyCard                     AS LoyaltyCard,
	CommercialProposalForCustomer.DeliveryTermsText                AS DeliveryTerms,
	CommercialProposalForCustomer.ValidityPeriod                        AS ValidityPeriod
FROM
	Document.CommercialProposalForCustomer AS CommercialProposalForCustomer
		{LEFT JOIN Catalog.Partners AS Partners
		ON CommercialProposalForCustomer.Client = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON CommercialProposalForCustomer.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	CommercialProposalForCustomer.Ref = &amp;CommercialProposalForCustomer</query>
	</dataSet>
