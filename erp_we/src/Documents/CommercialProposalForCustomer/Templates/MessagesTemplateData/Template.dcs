			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Giao tiếp</v8:content>
			</v8:item>
		</title>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
