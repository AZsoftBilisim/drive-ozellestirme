			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Non può essere riscattato parzialmente</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Nie może być wykupiony częściowo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Не может выкупаться частично</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
