  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentCommercialProposalForCustomer.Ref AS Ref,
	DocumentCommercialProposalForCustomer.DeletionMark AS DeletionMark,
	DocumentCommercialProposalForCustomer.Number AS Number,
	DocumentCommercialProposalForCustomer.Date AS Date,
	DocumentCommercialProposalForCustomer.Posted AS Posted,
	DocumentCommercialProposalForCustomer.Organization AS Organization,
	DocumentCommercialProposalForCustomer.Client AS Client,
	DocumentCommercialProposalForCustomer.Counterparty AS Counterparty,
	DocumentCommercialProposalForCustomer.ContactPerson AS ContactPerson,
	DocumentCommercialProposalForCustomer.Currency AS Currency,
	DocumentCommercialProposalForCustomer.BusinessOperation AS BusinessOperation,
	DocumentCommercialProposalForCustomer.Taxation AS Taxation,
	DocumentCommercialProposalForCustomer.PriceIncludesVAT AS PriceIncludesVAT,
	DocumentCommercialProposalForCustomer.ValidityPeriod AS ValidityPeriod,
	DocumentCommercialProposalForCustomer.Status AS Status,
	DocumentCommercialProposalForCustomer.DeliveryTermsText AS DeliveryTermsText,
	DocumentCommercialProposalForCustomer.PaymentTermsText AS PaymentTermsText,
	DocumentCommercialProposalForCustomer.OtherAdditionalInformationText AS OtherAdditionalInformationText,
	DocumentCommercialProposalForCustomer.PartialSaleAllowed AS PartialSaleAllowed,
	DocumentCommercialProposalForCustomer.Manager AS Manager,
	DocumentCommercialProposalForCustomer.DocumentAmount AS DocumentAmount,
	DocumentCommercialProposalForCustomer.AdditionalInformationToCustomerHTML AS AdditionalInformationToCustomerHTML,
	DocumentCommercialProposalForCustomer.Comment AS Comment,
	DocumentCommercialProposalForCustomer.EDDate AS EDDate,
	DocumentCommercialProposalForCustomer.EDNumber AS EDNumber,
	DocumentCommercialProposalForCustomer.DocumentBasis AS DocumentBasis,
	DocumentCommercialProposalForCustomer.Author AS Author,
	CASE
		WHEN
			NOT DocumentCommercialProposalForCustomer.Posted
		THEN
			DATETIME(1,1,1)
		WHEN
			DocumentCommercialProposalForCustomer.Status NOT IN (&amp;DraftStatuses) 
		THEN
			DocumentCommercialProposalForCustomer.ValidityPeriod
		ELSE
			DATETIME(1,1,1)
	END AS EventDate,
	CASE
		WHEN
			NOT DocumentCommercialProposalForCustomer.Posted
		THEN
			FALSE
		WHEN
			DocumentCommercialProposalForCustomer.Status  NOT IN (&amp;DraftStatuses)
			AND DocumentCommercialProposalForCustomer.ValidityPeriod &lt; &amp;UpdateDate
			AND DocumentCommercialProposalForCustomer.ValidityPeriod &lt;> DATETIME(1,1,1)
		THEN
			TRUE
		ELSE
			FALSE
	END AS Expired,
	&amp;UsingOfCheckIsAnOption AS UsingOfCheckIsAnOption,
	ISNULL(StatesOfCommercialProposalsToCustomers.State, UNDEFINED) AS State,
	StatesByEDIAccountingObjects.EDIState AS EDIState,
	StatesByEDIAccountingObjects.StatusPresentation AS StatusPresentation
FROM
	Document.CommercialProposalForCustomer AS DocumentCommercialProposalForCustomer
		LEFT JOIN InformationRegister.StatesOfCommercialProposalsToCustomers AS StatesOfCommercialProposalsToCustomers
		ON StatesOfCommercialProposalsToCustomers.CommercialProposalForCustomer = DocumentCommercialProposalForCustomer.Ref
		{LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS StatesByEDIAccountingObjects
		ON (StatesByEDIAccountingObjects.ObjectReference = DocumentCommercialProposalForCustomer.Ref)}</queryText>
      <mainTable>Document.CommercialProposalForCustomer</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
