    <attributes uuid="7240f2d2-55ff-4a5f-b0b9-0b04846e5d6b">
      <name>NumberOfPackages</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Quantità</value>
      </synonym>
