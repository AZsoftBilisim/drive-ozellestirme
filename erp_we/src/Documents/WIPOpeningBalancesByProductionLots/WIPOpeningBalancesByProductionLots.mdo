      <synonym>
        <key>pl</key>
        <value>Ilość (w jednostkach przechowywania)</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Количество(в единицах хранения)</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Miktar(stok ölçü biriminde)</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Số lượng (theo đơn vị tính)</value>
      </synonym>
