    <items xsi:type="form:FormField">
      <name>ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoice</name>
      <id>104</id>
      <title>
        <key>en</key>
        <value>There are discrepancies between the notes and the invoice</value>
      </title>
      <title>
        <key>fa</key>
        <value>بین حواله‌ها و فاکتور مغایرت وجود دارد</value>
      </title>
      <title>
        <key>it</key>
        <value>Ci sono le discrepanze tra mandati e documenti di trasporto</value>
      </title>
      <title>
        <key>pl</key>
        <value>Istnieje odchylenie zleceń z fakturą</value>
      </title>
      <title>
        <key>ru</key>
        <value>Есть расхождения ордеров с накладной</value>
      </title>
      <title>
        <key>tr</key>
        <value>Siparişlerin irsaliyelerle tutarsızlığı mevcut</value>
      </title>
      <title>
        <key>vi</key>
        <value>Có chênh lệch đơn hàng với hóa đơn</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <dataPath xsi:type="form:DataPath">
        <segments>List.ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoice</segments>
      </dataPath>
      <titleLocation>None</titleLocation>
      <toolTip>
        <key>en</key>
        <value>Correspondence of invoice
to issue and goods receipts
against the order</value>
      </toolTip>
      <toolTip>
        <key>fa</key>
        <value>تطابق فاکتور
با حواله‌های صدور و دریافت کالا
در مقابل سفارش</value>
      </toolTip>
      <toolTip>
        <key>it</key>
        <value>Corrispondenza del documento di trasporto
ai mandati di pagamento e reversali di incasso
secondo l'ordine</value>
      </toolTip>
      <toolTip>
        <key>pl</key>
        <value>Zgodność faktury
z dowodami KW i KP
wg zamówienia</value>
      </toolTip>
      <toolTip>
        <key>ru</key>
        <value>Соответствие накладной
расходным и приходным ордерам
по заказу</value>
      </toolTip>
      <toolTip>
        <key>tr</key>
        <value>İrsaliyenin
 sipariş için ambar çıkış ve giriş fişleri ile
uyuşması</value>
      </toolTip>
      <toolTip>
        <key>vi</key>
        <value>Phiếu gửi hàng
chi phí và nhận đơn đặt hàng
theo đơn đặt hàng</value>
      </toolTip>
      <extendedTooltip>
        <name>ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoiceExtendedTooltip</name>
        <id>106</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <contextMenu>
        <name>ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoiceContextMenu</name>
        <id>105</id>
        <autoFill>true</autoFill>
      </contextMenu>
      <type>PictureField</type>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerPicture xsi:type="core:PictureRef">
        <picture>CommonPicture.ShipmentAndReceiving</picture>
      </headerPicture>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
