	<dataSetLink>
		<sourceDataSet>CompositionTable</sourceDataSet>
		<destinationDataSet>Union</destinationDataSet>
		<sourceExpression>Case
        When &amp;Periodicity = Value(Enum.Periodicity.Week)
            Then BeginOfPeriod(CompositionPeriod, "Week")
        When &amp;Periodicity = Value(Enum.Periodicity.TenDays)
            Then BeginOfPeriod(CompositionPeriod, "TenDays")
        When &amp;Periodicity = Value(Enum.Periodicity.Month)
            Then BeginOfPeriod(CompositionPeriod, "Month")
        When &amp;Periodicity = Value(Enum.Periodicity.Quarter)
            Then BeginOfPeriod(CompositionPeriod, "Quarter")
        When &amp;Periodicity = Value(Enum.Periodicity.HalfYear)
            Then BeginOfPeriod(CompositionPeriod, "HalfYear")
        When &amp;Periodicity = Value(Enum.Periodicity.Year)
            Then BeginOfPeriod(CompositionPeriod, "Year")
        Else BeginOfPeriod(CompositionPeriod, "Day")
    End</sourceExpression>
		<destinationExpression>Period</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>CompositionTable</sourceDataSet>
