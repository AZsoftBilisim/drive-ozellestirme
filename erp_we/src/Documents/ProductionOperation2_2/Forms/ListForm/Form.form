    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentProductionOperation2_2.Ref,
	DocumentProductionOperation2_2.DeletionMark,
	DocumentProductionOperation2_2.Number,
	DocumentProductionOperation2_2.Date,
	DocumentProductionOperation2_2.Posted,
	DocumentProductionOperation2_2.Stage,
	DocumentProductionOperation2_2.Operation,
	DocumentProductionOperation2_2.OperationID,
	DocumentProductionOperation2_2.Status,
	DocumentProductionOperation2_2.Department,
	DocumentProductionOperation2_2.ProductionArea,
	DocumentProductionOperation2_2.Organization,
	DocumentProductionOperation2_2.Performer,
	CASE
		WHEN DocumentProductionOperation2_2.WorkCenter REFS Catalog.WorkCenterTypes
			THEN DocumentProductionOperation2_2.WorkCenter
		ELSE
			DocumentProductionOperation2_2.WorkCenter.WorkCenterType
	END AS WorkCenterType,
	CASE
		WHEN DocumentProductionOperation2_2.WorkCenter REFS Catalog.WorkCenters
			THEN DocumentProductionOperation2_2.WorkCenter
		ELSE
			VALUE(Catalog.WorkCenters.EmptyRef)
	END AS WorkCenter,
	DocumentProductionOperation2_2.SetupSettings,
	
	DocumentProductionOperation2_2.Count
		- DocumentProductionOperation2_2.CountCanceled AS Count,
	DocumentProductionOperation2_2.CountReal AS CountReal,
	DocumentProductionOperation2_2.DefectiveGoodsCount AS DefectiveGoodsCount,
	DocumentProductionOperation2_2.FollowUp AS FollowUp,
	DocumentProductionOperation2_2.QuantityUnderRevision AS QuantityUnderRevision,
	DocumentProductionOperation2_2.UnitOfMeasure,
	DocumentProductionOperation2_2.RunTime,
	DocumentProductionOperation2_2.ExecutionTimeUnitOfMeasure,
	DocumentProductionOperation2_2.ExecutionStarted,
	DocumentProductionOperation2_2.ExecutionEnd,
	DocumentProductionOperation2_2.EmployeeResponsible,
	DocumentProductionOperation2_2.Comment,
	DocumentProductionOperation2_2.StageOperationNumber,
	DocumentProductionOperation2_2.LotNumber,
	DocumentProductionOperation2_2.BasedOnPlanning,
	DocumentProductionOperation2_2.BasedOnMasterData,
	DocumentProductionOperation2_2.ShiftTask,
	DocumentProductionOperation2_2.Description,
	DocumentProductionOperation2_2.OperationKind,
	DocumentProductionOperation2_2.Repeatable,
	DocumentProductionOperation2_2.RepetitionIsRequired,
	DocumentProductionOperation2_2.Skippable,
	DocumentProductionOperation2_2.ManufacturedProducts,
	DocumentProductionOperation2_2.BatchFinishedProducts,
	DocumentProductionOperation2_2.MaterialsAndWorks,
	DocumentProductionOperation2_2.LaborCosts,
	DocumentProductionOperation2_2.AdditionalAttributes,
	DocumentProductionOperation2_2.PointInTime
FROM
	Document.ProductionOperation2_2 AS DocumentProductionOperation2_2</queryText>
      <mainTable>Document.ProductionOperation2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
