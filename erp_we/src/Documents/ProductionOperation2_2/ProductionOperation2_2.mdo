    </synonym>
    <synonym>
      <key>ru</key>
      <value>Передаточная партия</value>
    </synonym>
    <synonym>
      <key>tr</key>
      <value>Transfer lot</value>
    </synonym>
    <synonym>
      <key>vi</key>
