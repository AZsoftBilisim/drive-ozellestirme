    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentRMOrder.Ref,
	DocumentRMOrder.DeletionMark,
	DocumentRMOrder.Number,
	DocumentRMOrder.Date,
	DocumentRMOrder.Posted,
	DocumentRMOrder.Asset,
	DocumentRMOrder.Status,
	DocumentRMOrder.StartDate,
	DocumentRMOrder.CompletedOn,
	DocumentRMOrder.NameOfWork,
	DocumentRMOrder.Department,
	DocumentRMOrder.TechnicalSolution,
	DocumentRMOrder.EmployeeResponsible,
	DocumentRMOrder.Organization,
	DocumentRMOrder.RMActivity,
	DocumentRMOrder.StartDateActual,
	DocumentRMOrder.ActualCompletionDate,
	DocumentRMOrder.Purpose,
	DocumentRMOrder.MaximumRMCode,
	DocumentRMOrder.MaximumRowCodeItems,
	DocumentRMOrder.MaximumRowCodeOfLaborCosts,
	DocumentRMOrder.BusinessOperation,
	DocumentRMOrder.Comment,
	DocumentRMOrder.Author,
	DocumentRMOrder.LineOfBusiness,
	DocumentRMOrder.ConsumptionForActivity,
	DocumentRMOrder.LaborCostsAreAvailable,
	DocumentRMOrder.GeneralRMType,
	DocumentRMOrder.Priority AS Priority,
	CASE
		WHEN DocumentRMOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentRMOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Document.RMOrder AS DocumentRMOrder
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON DocumentRMOrder.Ref = FilesExist.ObjectWithFiles
	</queryText>
      <mainTable>Document.RMOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
