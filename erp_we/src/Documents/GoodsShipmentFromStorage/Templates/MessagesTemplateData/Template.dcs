		<field xsi:type="DataSetFieldField">
			<dataPath>Warehouse</dataPath>
			<field>Warehouse</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	GoodsShipmentFromStorage.Number,
	GoodsShipmentFromStorage.Date,
	Partners.Description AS PartnerName_,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description       AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	GoodsShipmentFromStorage.Organization,
	GoodsShipmentFromStorage.Counterparty,
	GoodsShipmentFromStorage.Currency,
	GoodsShipmentFromStorage.DocumentAmount,
	GoodsShipmentFromStorage.Manager,
	GoodsShipmentFromStorage.GoodsRecipient,
	GoodsShipmentFromStorage.Shipper,
	GoodsShipmentFromStorage.CompanyBankAccount,
	GoodsShipmentFromStorage.CounterpartyBankAccount,
	GoodsShipmentFromStorage.ShipperBankAccount,
	GoodsShipmentFromStorage.GoodsRecipientBankAccount,
	GoodsShipmentFromStorage.Contract,
	GoodsShipmentFromStorage.Warehouse
FROM
	Document.GoodsShipmentFromStorage AS GoodsShipmentFromStorage
		{LEFT JOIN Catalog.Partners AS Partners
		ON GoodsShipmentFromStorage.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON GoodsShipmentFromStorage.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	GoodsShipmentFromStorage.Ref = &amp;GoodsShipmentFromStorage</query>
	</dataSet>
