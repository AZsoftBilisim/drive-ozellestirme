    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DataOverridable.Organization,
	DataOverridable.Department,
	DataOverridable.LineOfBusiness,
	DataOverridable.ExpenseItem,
	DataOverridable.ExpenseItem.CostAllocationOptionManag AS CostAllocationOptionManag,
	DataOverridable.ExpenseItem.CostAllocationOptionLocal AS CostAllocationOptionLocal,
	DataOverridable.ExpenseItem.CostAllocationOptionTax AS CostAllocationOptionTax,
	DataOverridable.DimensionOfExpenses,
	DataOverridable.SumReceipt - DataOverridable.SumExpense AS Sum,
	DataOverridable.SumManReceipt - DataOverridable.SumManExpense AS SumMan,
	DataOverridable.SumComplReceipt - DataOverridable.SumComplExpense AS SumCompl,
	(DataOverridable.SumComplReceipt - DataOverridable.SumComplExpense)
		- (DataOverridable.PermanentDifferenceReceipt - DataOverridable.PermanentDifferenceExpense)
		- (DataOverridable.CostTDReceipt - DataOverridable.CostTDExpense) AS AmountFA,
	DataOverridable.PermanentDifferenceReceipt - DataOverridable.PermanentDifferenceExpense AS PermanentDifference,
	DataOverridable.CostTDReceipt - DataOverridable.CostTDExpense AS CostTD,
	DataOverridable.AITAmountReceipt - DataOverridable.AITAmountExpense AS AITAmount,
	0 AS AmountStatus,
	0 AS AmountOfUprStatus,
	0 AS AmountReglStatus,
	0 AS AmountAndStatus,
	0 AS NDDAmountStatus,
	FALSE AS CalculationOfAutoManAmounts,
	FALSE AS CalculationOfAutoLocalAmounts,
	FALSE AS CalculationOfAutoAmountsTa,
	FALSE AS CalculationOfAutoAmountsNDD,
	FALSE AS EverythingIsDistributedAmount,
	FALSE AS EverythingIsDistributedAmountMA,
	FALSE AS EverythingIsDistributedAmountLocal,
	FALSE AS EverythingIsDistributedSumIsTA,
	FALSE AS EverythingIsDistributedAmountNDD,
	FALSE AS ThereAreBalancesAmount,
	FALSE AS ThereAreBalancesAmountMA,
	FALSE AS ThereAreBalancesAmountLocal,
	FALSE AS ThereAreBalancesAmountTA,
	FALSE AS ThereAreBalancesAmountNDD

FROM
	AccumulationRegister.OtherExpenses.Turnovers(,, Day) AS DataOverridable</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
