    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentCashAccountReceiptNote.Ref,
	DocumentCashAccountReceiptNote.DeletionMark,
	DocumentCashAccountReceiptNote.Number,
	DocumentCashAccountReceiptNote.Date,
	DocumentCashAccountReceiptNote.Posted,
	DocumentCashAccountReceiptNote.Organization,
	DocumentCashAccountReceiptNote.CashAccount,
	DocumentCashAccountReceiptNote.DocumentAmount,
	DocumentCashAccountReceiptNote.BusinessOperation,
	DocumentCashAccountReceiptNote.ReceivedFrom,
	DocumentCashAccountReceiptNote.Basis,
	DocumentCashAccountReceiptNote.Application,
	DocumentCashAccountReceiptNote.Counterparty,
	DocumentCashAccountReceiptNote.AdvanceHolder,
	DocumentCashAccountReceiptNote.BankAccount,
	DocumentCashAccountReceiptNote.Currency,
	DocumentCashAccountReceiptNote.Cashier,
	DocumentCashAccountReceiptNote.CashFlowItem,
	DocumentCashAccountReceiptNote.CashTransferReferenceOrder,
	DocumentCashAccountReceiptNote.IncludingVAT,
	DocumentCashAccountReceiptNote.DocumentBasis,
	DocumentCashAccountReceiptNote.CashRegister,
	DocumentCashAccountReceiptNote.CashAccountIssuer,
	DocumentCashAccountReceiptNote.Comment,
	DocumentCashAccountReceiptNote.CurrencyOfConversion,
	DocumentCashAccountReceiptNote.ConversionRate,
	DocumentCashAccountReceiptNote.ChiefAccountant,
	DocumentCashAccountReceiptNote.IssuedLetterOfAuthority,
	DocumentCashAccountReceiptNote.ConversionAmount,
	DocumentCashAccountReceiptNote.Department,
	DocumentCashAccountReceiptNote.FinancialAccountingGroup,
	DocumentCashAccountReceiptNote.LineOfBusiness,
	DocumentCashAccountReceiptNote.Contract,
	DocumentCashAccountReceiptNote.Partner,
	DocumentCashAccountReceiptNote.ConversionRateMultiplier,
	DocumentCashAccountReceiptNote.ARAPDetails,
	DocumentCashAccountReceiptNote.AdditionalAttributes,
	DocumentCashAccountReceiptNote.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation,
	DocumentCashAccountReceiptNote.Author
FROM
	Document.CashAccountReceiptNote AS DocumentCashAccountReceiptNote
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentCashAccountReceiptNote.Ref)</queryText>
      <mainTable>Document.CashAccountReceiptNote</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
