  <attributes>
    <name>CashAccountReceiptNotes</name>
    <title>
      <key>en</key>
      <value>Incoming payments — Cash account</value>
    </title>
    <title>
      <key>fa</key>
      <value>دریافت‌های وجه — صندوق</value>
    </title>
    <title>
      <key>it</key>
      <value>Ricevuta ordine contanti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Asygnaty kasowo przychodowe</value>
    </title>
    <title>
      <key>ru</key>
      <value>Приходные кассовые ордера</value>
    </title>
    <title>
      <key>tr</key>
      <value>Gelen ödemeler - kasa hesabı </value>
    </title>
    <title>
      <key>vi</key>
      <value>Phiếu thu</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashAccountReceiptNotes.CashAccount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashAccountReceiptNotes.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashAccountReceiptNotes.PayerPresentation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashAccountReceiptNotes.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CAST(DocumentsRegistry.Ref AS Document.CashAccountReceiptNote) AS Ref,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.Organization AS Organization,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.CashAccount
		ELSE DocumentReceiptAndCashOrder.CashAccount
	END AS CashAccount,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.CashAccount.CashCurrency
		ELSE DocumentReceiptAndCashOrder.CashAccount.CashCurrency
	END AS Currency,
	DocumentsRegistry.Sum AS DocumentAmount,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	CASE
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromCustomer)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundFromVendor)
			THEN DocumentsRegistry.Counterparty
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromBank)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.BankAccount
					ELSE DocumentReceiptAndCashOrder.BankAccount
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReturnByAdvanceHolder)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.LoanRepaymentByEmployee)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.AdvanceHolder
					ELSE DocumentReceiptAndCashOrder.AdvanceHolder
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherCashAccount)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromOtherCompany)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.CashAccountIssuer
					ELSE DocumentReceiptAndCashOrder.CashAccountIssuer
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegister)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.CashRegister
					ELSE DocumentReceiptAndCashOrder.CashRegister
				END
		ELSE DocumentsRegistry.Counterparty
	END AS Dimension,
	CASE
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromCustomer)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundFromVendor)
			THEN DocumentsRegistry.Counterparty.Description
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromBank)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.BankAccount.Description
					ELSE DocumentReceiptAndCashOrder.BankAccount.Description
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReturnByAdvanceHolder)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.LoanRepaymentByEmployee)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.AdvanceHolder.Description
					ELSE DocumentReceiptAndCashOrder.AdvanceHolder.Description
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherCashAccount)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromOtherCompany)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.CashAccountIssuer.Description
					ELSE DocumentReceiptAndCashOrder.CashAccountIssuer.Description
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegister)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.CashRegister.Description
					ELSE DocumentReceiptAndCashOrder.CashRegister.Description
				END
		ELSE DocumentsRegistry.Counterparty.Description
	END AS PayerPresentation,
	DocumentReceiptAndCashOrder.Presentation AS Presentation,
	DocumentReceiptAndCashOrder.PointInTime AS PointInTime,
	DocumentReceiptAndCashOrder.Author AS Author,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistry.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistry.ReversedDocument
	END AS ReversedCorrectedDocument,
		CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.Basis
		ELSE DocumentReceiptAndCashOrder.Basis
	END AS Basis,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties,
    EDStates.EDIState AS StateOfEdVersion,
    EDStates.StatusPresentation AS StatusPresentation
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
	LEFT JOIN Document.CashAccountReceiptNote AS DocumentReceiptAndCashOrder
		ON DocumentsRegistry.Ref = DocumentReceiptAndCashOrder.Ref
	LEFT JOIN Document.CashAccountReceiptNote AS StornoData
		ON DocumentsRegistry.ReversedDocument = StornoData.Ref
	{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentReceiptAndCashOrder.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentsRegistry.Ref)
WHERE
	DocumentsRegistry.RefType = &amp;RefType
	AND NOT DocumentsRegistry.AdditionalRecord
{WHERE
	CAST(DocumentsRegistry.Ref AS Document.CashAccountReceiptNote).* AS Ref,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark}</queryText>
