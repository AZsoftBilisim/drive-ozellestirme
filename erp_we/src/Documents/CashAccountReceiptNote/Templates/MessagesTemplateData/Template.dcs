					<v8:lang>pl</v8:lang>
					<v8:content>Numer rachunku bankowego</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер банковского счета</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Banka hesap numarası</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số tài khoản ngân hàng</v8:content>
				</v8:item>
			</title>
		</field>
