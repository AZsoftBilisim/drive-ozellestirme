    <attributes uuid="628b3ce2-4791-489a-9690-8cc51d7f27c4">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity (Stock UOM)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار (واحد انبار)</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Quantità (in unità di stoccaggio)</value>
