    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	GoodsIssueNote.Ref,
	GoodsIssueNote.DeletionMark,
	GoodsIssueNote.Number,
	GoodsIssueNote.Date,
	GoodsIssueNote.Posted,
	GoodsIssueNote.TotalNumberOfPackageItems,
	GoodsIssueNote.DateOfShipment,
	GoodsIssueNote.TransportationJob,
	GoodsIssueNote.ShippingZone,
	GoodsIssueNote.Comment,
	GoodsIssueNote.Inspector,
	GoodsIssueNote.EmployeeResponsible,
	GoodsIssueNote.ShipmentUnderTransportationJob,
	GoodsIssueNote.Recipient,
	GoodsIssueNote.Premise,
	GoodsIssueNote.DeliveryProcedure,
	GoodsIssueNote.Priority,
	GoodsIssueNote.GoodsViewMode,
	GoodsIssueNote.Warehouse,
	GoodsIssueNote.WarehouseOperation,
	GoodsIssueNote.Status,
	GoodsIssueNote.GoodsByReferences.*,
	GoodsIssueNote.ShippedGoods.*,
	GoodsIssueNote.AdditionalAttributes.*,
	GoodsIssueNote.PackageBarcodes.*,
	GoodsIssueNote.PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.GoodsIssueNote AS GoodsIssueNote
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON EDStates.ObjectReference = GoodsIssueNote.Ref</queryText>
      <mainTable>Document.GoodsIssueNote</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
