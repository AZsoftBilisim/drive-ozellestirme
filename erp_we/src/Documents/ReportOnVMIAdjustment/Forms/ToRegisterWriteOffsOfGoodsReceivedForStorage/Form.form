    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfOrdersForDebitingFromStorage.ContractType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfOrdersForDebitingFromStorage.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfOrdersForDebitingFromStorage.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	CompanyGoodsBalance.Organization AS Organization,
	CompanyGoodsBalance.InventoryOwnerAttribute.GoodsOwner AS Partner,
	CompanyGoodsBalance.InventoryOwnerAttribute.Counterparty AS Counterparty,
	CompanyGoodsBalance.InventoryOwnerAttribute.Contract AS Contract,
	CASE
		WHEN VALUETYPE(CompanyGoodsBalance.InventoryOwnerAttribute.Contract) = TYPE(Catalog.CounterpartyContracts)
			THEN CAST(CompanyGoodsBalance.InventoryOwnerAttribute.Contract AS Catalog.CounterpartyContracts).ContractType
		WHEN VALUETYPE(CompanyGoodsBalance.InventoryOwnerAttribute.Contract) = TYPE(Catalog.IntercompanyContracts)
			THEN CAST(CompanyGoodsBalance.InventoryOwnerAttribute.Contract AS Catalog.IntercompanyContracts).ContractType	
		ELSE UNDEFINED
	END AS ContractType,
	CompanyGoodsBalance.InventoryOwnerAttribute.Contract AS Ref
FROM
	AccumulationRegister.CompanyGoods.Balance AS CompanyGoodsBalance
WHERE
	CompanyGoodsBalance.ToRegisterGoodsIssueBalance > 0
</queryText>
      <mainTable>AccumulationRegister.CompanyGoods.Balance</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
