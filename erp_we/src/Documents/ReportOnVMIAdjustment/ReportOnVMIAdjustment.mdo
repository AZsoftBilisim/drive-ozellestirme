    <attributes uuid="6cf2f7bc-3294-4496-9493-8b22f4b1b15c">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity (Stock UOM)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار (واحد انبار)</value>
      </synonym>
      <synonym>
        <key>it</key>
