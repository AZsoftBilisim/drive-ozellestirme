		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	PurchaseInvoiceConsignmentStockLost.Number,
	PurchaseInvoiceConsignmentStockLost.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	PurchaseInvoiceConsignmentStockLost.Manager,
	PurchaseInvoiceConsignmentStockLost.Currency,
	PurchaseInvoiceConsignmentStockLost.PaymentMethod,
	PurchaseInvoiceConsignmentStockLost.DocumentAmount,
	PurchaseInvoiceConsignmentStockLost.Contract,
	PurchaseInvoiceConsignmentStockLost.BeginOfPeriod,
	PurchaseInvoiceConsignmentStockLost.EndOfPeriod,
	PurchaseInvoiceConsignmentStockLost.PaymentDate
FROM
	Document.PurchaseInvoiceConsignmentStockLost AS PurchaseInvoiceConsignmentStockLost
		{LEFT JOIN Catalog.Partners AS Partners
		ON PurchaseInvoiceConsignmentStockLost.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON PurchaseInvoiceConsignmentStockLost.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	PurchaseInvoiceConsignmentStockLost.Ref = &amp;PurchaseInvoiceConsignmentStockLost</query>
	</dataSet>
