				<v8:content>Báo cáo ghi giảm cho người đặt ký gửi</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.PurchaseInvoiceConsignmentStockLost</v8:Type>
