        <value>Wyksięgowano</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Списано</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Kayıttan düşülen</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Ghi giảm</value>
