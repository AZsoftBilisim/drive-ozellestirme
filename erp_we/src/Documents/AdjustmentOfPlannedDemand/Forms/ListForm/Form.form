    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentAdjustmentOfPlannedDemand.Ref AS Ref,
	DocumentAdjustmentOfPlannedDemand.DeletionMark AS DeletionMark,
	DocumentAdjustmentOfPlannedDemand.Number AS Number,
	DocumentAdjustmentOfPlannedDemand.Date AS Date,
	DocumentAdjustmentOfPlannedDemand.Posted AS Posted,
	DocumentAdjustmentOfPlannedDemand.EmployeeResponsible AS EmployeeResponsible,
	DocumentAdjustmentOfPlannedDemand.Status AS Status,
	DocumentAdjustmentOfPlannedDemand.Scenario AS Scenario,
	DocumentAdjustmentOfPlannedDemand.PlanProfile AS PlanProfile,
	DocumentAdjustmentOfPlannedDemand.Plan AS Plan,
	DocumentAdjustmentOfPlannedDemand.Period AS Period,
	DocumentAdjustmentOfPlannedDemand.AdjustmentInputModeMultiline AS AdjustmentInputModeMultiline,
	DocumentAdjustmentOfPlannedDemand.PointInTime AS PointInTime,
	AdjustmentOfPlannedDemandIncreasedDemand.LineNumber AS LineNumber,
	AdjustmentOfPlannedDemandDecreasedDemands.LineNumber AS LineNumberDecrease,
	AdjustmentOfPlannedDemandDecreasedDemands.Products AS NomenclatureReduction,
	AdjustmentOfPlannedDemandDecreasedDemands.Characteristic AS FeatureReduction,
	AdjustmentOfPlannedDemandDecreasedDemands.Purpose AS PurposeReduction,
	AdjustmentOfPlannedDemandIncreasedDemand.Products AS NomenclatureIncrease,
	AdjustmentOfPlannedDemandIncreasedDemand.Characteristic AS FeatureMagnification,
	AdjustmentOfPlannedDemandIncreasedDemand.Purpose AS PurposeIncrease,
	CAST(DocumentAdjustmentOfPlannedDemand.Comment AS STRING(255)) AS Comment
FROM
	Document.AdjustmentOfPlannedDemand AS DocumentAdjustmentOfPlannedDemand
		LEFT JOIN Document.AdjustmentOfPlannedDemand.IncreasedDemand AS AdjustmentOfPlannedDemandIncreasedDemand
		ON AdjustmentOfPlannedDemandIncreasedDemand.Ref = DocumentAdjustmentOfPlannedDemand.Ref
		 AND AdjustmentOfPlannedDemandIncreasedDemand.LineNumber = 1
		LEFT JOIN Document.AdjustmentOfPlannedDemand.DecreasedDemands AS AdjustmentOfPlannedDemandDecreasedDemands
		ON AdjustmentOfPlannedDemandDecreasedDemands.Ref = DocumentAdjustmentOfPlannedDemand.Ref
		 AND AdjustmentOfPlannedDemandDecreasedDemands.LineNumber = 1</queryText>
      <mainTable>Document.AdjustmentOfPlannedDemand</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
