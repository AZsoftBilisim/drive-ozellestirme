      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Numero di imballaggi</value>
      </synonym>
      <synonym>
        <key>pl</key>
        <value>Liczba opakowań</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Количество упаковок</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Paket sayısı</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Số lượng đóng gói</value>
