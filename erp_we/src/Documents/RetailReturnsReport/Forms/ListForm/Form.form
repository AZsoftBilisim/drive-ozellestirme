  <attributes>
    <name>RetailReturnsReports</name>
    <title>
      <key>en</key>
      <value>Retail return reports</value>
    </title>
    <title>
      <key>fa</key>
      <value>گزارش‌های برگشت خرده‌فروشی</value>
    </title>
    <title>
      <key>it</key>
      <value>Report sui resi al dettaglio</value>
    </title>
    <title>
      <key>pl</key>
      <value>Raporty o zwrotach detalicznych</value>
    </title>
    <title>
      <key>ru</key>
      <value>Отчеты о розничных возвратах</value>
    </title>
    <title>
      <key>tr</key>
      <value>Perakende i̇ade raporları</value>
    </title>
    <title>
      <key>vi</key>
      <value>Bảng kê hàng hóa bán lẻ trả lại</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
