    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>// The request text is generated when the form is created on the server.
SELECT
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	NULL AS ReferenceOrder,
	NULL AS ProductionOrder,
	NULL AS TypeOfOrder_,
	&quot;&quot; AS TheNumberOfTheOrder,
	DATETIME(1, 1, 1) AS ReferenceDate,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	DATETIME(1, 1, 1) AS Begin,
	FALSE AS ItemVariantsAreUsed,
	FALSE AS LaunchDateIsOverdue,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Enum.GoodsReceiptOptions.EmptyRef) AS GoodsReceiptOption,
	VALUE(Enum.VATTaxationTypes.EmptyRef) AS PurchaseForActivity,
	FALSE AS DynamicStructure
WHERE
	FALSE</queryText>
