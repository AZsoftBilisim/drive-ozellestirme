  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	RecyclingOrder.Ref AS Ref,
	RecyclingOrder.DeletionMark AS DeletionMark,
	RecyclingOrder.Number AS Number,
	RecyclingOrder.Date AS Date,
	RecyclingOrder.Posted AS Posted,
	RecyclingOrder.Partner AS Partner,
	RecyclingOrder.Counterparty AS Counterparty,
	RecyclingOrder.Contract AS Contract,
	RecyclingOrder.Organization AS Organization,
	RecyclingOrder.Department AS Department,
	RecyclingOrder.PaymentSchedule AS PaymentSchedule,
	RecyclingOrder.Currency AS Currency,
	RecyclingOrder.Manager AS Manager,
	RecyclingOrder.Status AS Status,
	RecyclingOrder.DocumentAmount AS DocumentAmount,
	RecyclingOrder.DepositValue AS DepositValue,
	RecyclingOrder.Priority AS Priority,
	RecyclingOrder.Comment AS Comment,
	RecyclingOrder.AdditionalInformation AS AdditionalInformation,
	RecyclingOrder.RequestedDeliveryDate AS RequestedDeliveryDate,
	RecyclingOrder.DateOfFirstReceipt AS DateOfFirstReceipt,
	RecyclingOrder.DateOfShipment AS DateOfShipment,
	RecyclingOrder.BusinessOperation AS BusinessOperation,
	RecyclingOrder.LineOfBusiness AS LineOfBusiness,
	RecyclingOrder.AmountAdvanceBeforeConfirmation AS AmountAdvanceBeforeConfirmation,
	RecyclingOrder.PrepaymentAmountBeforeReceipt AS PrepaymentAmountBeforeReceipt,
	RecyclingOrder.ARAPObjectSettings AS ARAPObjectSettings,
	&quot;&quot; AS StageStatus,
	CASE
		WHEN RecyclingOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN RecyclingOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority
FROM
	Document.SubcontractOrder2_5 AS RecyclingOrder</queryText>
