    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	SubcontractOrder2_5.Ref AS Ref
INTO TheOrdersTable
FROM
	Document.SubcontractOrder2_5 AS SubcontractOrder2_5
WHERE
	SubcontractOrder2_5.Contract = &amp;Contract
	AND SubcontractOrder2_5.Posted

INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	DocSubcontractOrder.Ref AS Ref,
	DocSubcontractOrder.Organization AS Organization,
	DocSubcontractOrder.Organization AS OrganizationForSelection,
	DocSubcontractOrder.Partner AS Partner,
	DocSubcontractOrder.Number AS TheNumberOfTheOrder,
	DocSubcontractOrder.Date AS ReferenceDate,
	DocSubcontractOrder.Status AS Status,
	DocSubcontractOrder.Priority AS Priority,
	DocSubcontractOrder.Department AS Department,
	DocSubcontractOrder.DeletionMark AS DeletionMark,
	DocSubcontractOrder.LineOfBusiness AS LineOfBusiness
FROM
	(SELECT
		TableOfOrdersToBeProcessed.PurchaseOrder AS ReferenceOrder
	FROM
		(SELECT
			PurchaseOrders.PurchaseOrder AS PurchaseOrder,
			PurchaseOrders.Products AS Products,
			PurchaseOrders.Characteristic AS Characteristic,
			PurchaseOrders.Warehouse AS Warehouse,
			PurchaseOrders.ToRegisterBalance AS ToRegister
		FROM
			AccumulationRegister.PurchaseOrders.Balance(, PurchaseOrder IN
				(SELECT
					TheOrdersTable.Ref AS Ref
				FROM
					TheOrdersTable AS TheOrdersTable)
			AND RowCode &lt;> 0) AS PurchaseOrders

		UNION ALL

		SELECT
			PurchaseOrders.PurchaseOrder AS PurchaseOrder,
			PurchaseOrders.Products AS Products,
			PurchaseOrders.Characteristic AS Characteristic,
			PurchaseOrders.Warehouse AS Warehouse,
			PurchaseOrders.ToRegister AS ToRegister
		FROM
			AccumulationRegister.PurchaseOrders AS PurchaseOrders
		WHERE
			PurchaseOrders.Active
			AND PurchaseOrders.RecordType = VALUE(AccumulationRecordType.Expense)
			AND PurchaseOrders.Recorder = &amp;Recorder
			AND PurchaseOrders.PurchaseOrder IN
				(SELECT
					TheOrdersTable.Ref AS Ref
				FROM
					TheOrdersTable AS TheOrdersTable)
			AND PurchaseOrders.RowCode &lt;> 0) AS TableOfOrdersToBeProcessed
	GROUP BY
		TableOfOrdersToBeProcessed.PurchaseOrder,
		TableOfOrdersToBeProcessed.Products,
		TableOfOrdersToBeProcessed.Characteristic,
		TableOfOrdersToBeProcessed.Warehouse
	HAVING
		SUM(TableOfOrdersToBeProcessed.ToRegister) > 0

	UNION ALL

	SELECT
		TableOfOrdersOverAndAboveOrder.PurchaseOrder AS ReferenceOrder
	FROM
		(SELECT
			PurchaseOrders.PurchaseOrder AS PurchaseOrder,
			PurchaseOrders.Products AS Products,
			PurchaseOrders.Characteristic AS Characteristic,
			PurchaseOrders.RowCode AS RowCode,
			PurchaseOrders.ToReceiveReceipt - PurchaseOrders.ToRegisterExpense AS ToRegister
		FROM
			AccumulationRegister.PurchaseOrders.Turnovers(,,, PurchaseOrder IN
				(SELECT
					TheOrdersTable.Ref AS Ref
				FROM
					TheOrdersTable AS TheOrdersTable)
			AND RowCode = 0) AS PurchaseOrders

		UNION ALL

		SELECT
			PurchaseOrders.PurchaseOrder AS PurchaseOrder,
			PurchaseOrders.Products AS Products,
			PurchaseOrders.Characteristic AS Characteristic,
			PurchaseOrders.RowCode AS RowCode,
			PurchaseOrders.ToRegister AS ToRegister
		FROM
			AccumulationRegister.PurchaseOrders AS PurchaseOrders
		WHERE
			Active
			AND Recorder IN (&amp;Recorder)
			AND RecordType = VALUE(AccumulationRecordType.Expense)
			AND PurchaseOrders.PurchaseOrder IN
				(SELECT
					TheOrdersTable.Ref AS Ref
				FROM
					TheOrdersTable AS TheOrdersTable)
			AND RowCode = 0) AS TableOfOrdersOverAndAboveOrder
	GROUP BY
		TableOfOrdersOverAndAboveOrder.PurchaseOrder,
		TableOfOrdersOverAndAboveOrder.Products,
		TableOfOrdersOverAndAboveOrder.Characteristic,
		TableOfOrdersOverAndAboveOrder.RowCode
	HAVING
		SUM(TableOfOrdersOverAndAboveOrder.ToRegister) > 0) AS Data
		LEFT JOIN Document.SubcontractOrder2_5 AS DocSubcontractOrder
		ON Data.ReferenceOrder = DocSubcontractOrder.Ref</queryText>
      <mainTable>Document.SubcontractOrder2_5</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
