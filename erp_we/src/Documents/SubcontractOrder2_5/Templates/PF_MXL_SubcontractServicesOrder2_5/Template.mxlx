						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Zamówienie do przetwórcy na usługi dotyczące wypuszczenia produkcji nr [DocumentNumber] z dn. [DocumentDate]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Заказ переработчику на услуги по выпуску продукции № [DocumentNumber] от [DocumentDate]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>[DocumentDate] tarihli [DocumentNumber] numaralı üretim hizmetleri için verilen fason üretici siparişi</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Đơn hàng đặt gia công dịch vụ xuất xưởng thành phẩm số [DocumentNumber] ngày [DocumentDate]</v8:content>
						</v8:item>
