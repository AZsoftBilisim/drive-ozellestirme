  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	OrdersTable.TransferOrder AS TransferOrder,
	SUM(OrdersTable.ToRegister) AS ToRegister
INTO TueRemainingOrders
FROM
	(SELECT
		OrdersBalance.TransferOrder AS TransferOrder,
		OrdersBalance.ToRegisterBalance AS ToRegister
	FROM
		AccumulationRegister.TransferOrders.Balance(
				,
				TransferOrder.Department = &amp;Department
					AND TransferOrder.Organization = &amp;Organization
					AND TransferOrder.SourceWarehouse = &amp;SourceWarehouse
					AND TransferOrder.DestinationWarehouse = &amp;DestinationWarehouse) AS OrdersBalance
	
	UNION ALL
	
	SELECT
		TrafficOrders.TransferOrder,
		CASE
			WHEN TrafficOrders.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN -TrafficOrders.ToRegister
			ELSE TrafficOrders.ToRegister
		END
	FROM
		AccumulationRegister.TransferOrders AS TrafficOrders
	WHERE
		TrafficOrders.Recorder = &amp;Recorder
		AND TrafficOrders.Active
		AND TrafficOrders.TransferOrder.Department = &amp;Department
		AND TrafficOrders.TransferOrder.Organization = &amp;Organization
		AND TrafficOrders.TransferOrder.SourceWarehouse = &amp;SourceWarehouse
		AND TrafficOrders.TransferOrder.DestinationWarehouse = &amp;DestinationWarehouse) AS OrdersTable

GROUP BY
	OrdersTable.TransferOrder

HAVING
	SUM(OrdersTable.ToRegister) > 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsTransferOrder.Ref AS Ref,
	GoodsTransferOrder.Date AS Date,
	GoodsTransferOrder.Number AS Number,
	GoodsTransferOrder.Organization AS Organization,
	GoodsTransferOrder.EmployeeResponsible AS EmployeeResponsible,
	GoodsTransferOrder.Status AS Status,
	GoodsTransferOrder.SourceWarehouse AS SourceWarehouse,
	GoodsTransferOrder.DestinationWarehouse AS DestinationWarehouse,
	GoodsTransferOrder.Department AS Department,
	GoodsTransferOrder.Comment AS Comment
FROM
	Document.TransferOrder AS GoodsTransferOrder
		INNER JOIN TueRemainingOrders AS RemainingOrders
		ON GoodsTransferOrder.Ref = RemainingOrders.TransferOrder</queryText>
