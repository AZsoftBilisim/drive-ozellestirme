		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ConsignmentReportFromCustomer.Number,
	ConsignmentReportFromCustomer.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ConsignmentReportFromCustomer.Manager,
	ConsignmentReportFromCustomer.Currency,
	ConsignmentReportFromCustomer.PaymentMethod,
	ConsignmentReportFromCustomer.DocumentAmount,
	ConsignmentReportFromCustomer.Contract,
	ConsignmentReportFromCustomer.BeginOfPeriod,
	ConsignmentReportFromCustomer.EndOfPeriod,
	ConsignmentReportFromCustomer.PaymentDate,
	ConsignmentReportFromCustomer.CommissionFeeCalculationMethod,
	ConsignmentReportFromCustomer.RemunerationPercentage,
	ConsignmentReportFromCustomer.CommissionAmount,
	ConsignmentReportFromCustomer.BankAccount,
	ConsignmentReportFromCustomer.IncomingDocumentNumber,
	ConsignmentReportFromCustomer.IncomingDocumentDate
FROM
	Document.ConsignmentReportFromCustomer AS ConsignmentReportFromCustomer
		{LEFT JOIN Catalog.Partners AS Partners
		ON ConsignmentReportFromCustomer.Partner = Partners.Ref}
WHERE
	ConsignmentReportFromCustomer.Ref = &amp;ConsignmentReportFromCustomer</query>
