  <formCommands>
    <name>FillInByBalance</name>
    <title>
      <key>en</key>
      <value>Fill in according to the OA balance</value>
    </title>
    <title>
      <key>fa</key>
      <value>تکمیل طبق مانده حسابداری عملیاتی</value>
