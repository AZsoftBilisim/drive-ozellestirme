    <attributes uuid="f8896890-7f64-4158-b395-dcc56ed03735">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
      <synonym>
