    <attributes uuid="a2a25bf6-4127-463e-89d2-038ab252c496">
      <name>NumberOfPackages</name>
      <synonym>
        <key>en</key>
        <value>Qty purchased</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار خریداری‌شده</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Acquistato</value>
      </synonym>
      <synonym>
        <key>pl</key>
        <value>Nabyto</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Приобретено</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Satın alındı</value>
      </synonym>
      <synonym>
        <key>vi</key>
        <value>Mua</value>
