      <value>Danh sách mục đích lập</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UseAdvancedFeaturesOfSalesOrder</functionalOptions>
    <functionalOptions>FunctionalOption.ProvideAgentServicesOnPurchaseToPrincipals</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Consignor</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.ContractWithConsignor</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.CounterpartyCommitee</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.DocumentAcquisitions</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.FinancialAccountingGroup</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.LineOfBusiness</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.PriceIncludesVAT</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Purpose</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.VATTaxation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PurposeListForRegistration.Vendor</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED
	Assignments.Partner AS Consignor,
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.Organization AS Organization,
	CASE
		WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
			THEN SalesOrder.Ref
		ELSE CounterpartyContracts.Ref
	END AS DimensionAssignments,
	Assignments.Ref AS Purpose,
	CounterpartyContracts.Ref AS ContractWithConsignor,
	CounterpartyContracts.Counterparty AS CounterpartyCommitee,
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.Currency AS Currency,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.Partner,
		VALUE(Catalog.Partners.EmptyRef)) AS Vendor,
	SUM(GoodsAndServicesToRegisterPurchasingReportsToConsignor.AmountIncludingVATBalance) AS AmountIncludingVAT,
	SUM(GoodsAndServicesToRegisterPurchasingReportsToConsignor.VATAmountBalance) AS VATAmount,
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions AS DocumentAcquisitions,
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions AS Ref,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.PriceIncludesVAT, FALSE) AS
		PriceIncludesVAT,
	CASE
		WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
			THEN ISNULL(SalesOrder.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef))
		ELSE ISNULL(CounterpartyContracts.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef))
	END AS LineOfBusiness,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.FinancialAccountingGroup,
		VALUE(Catalog.FinancialAccountingGroupsOfARAP.EmptyRef)) AS FinancialAccountingGroup,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.VATTaxation,
		VALUE(Enum.VATTaxationTypes.EmptyRef)) AS VATTaxation,
	CASE
		WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
			THEN SalesOrder.Terms
		ELSE VALUE(Catalog.TermsOfSale.EmptyRef)
	END AS Terms,
	CASE
		WHEN GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions &lt;> UNDEFINED
		AND EDStates.StatusPresentation IS NULL
			THEN &amp;StateNotStarted
		ELSE EDStates.StatusPresentation
	END AS StatusPresentation,
	CounterpartyContracts.SplitReportByDocuments
FROM
	AccumulationRegister.GoodsAndServicesToRegisterPurchasingReportsToConsignor.Balance AS
		GoodsAndServicesToRegisterPurchasingReportsToConsignor
		INNER JOIN Catalog.Assignments AS Assignments
		ON Assignments.Ref = GoodsAndServicesToRegisterPurchasingReportsToConsignor.Purpose
		LEFT JOIN Document.SalesOrder AS SalesOrder
		ON SalesOrder.Ref = Assignments.OrderDocument
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions = EDStates.ObjectReference
		INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON CASE
			WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
				THEN SalesOrder.Contract
			ELSE Assignments.Contract
		END = CounterpartyContracts.Ref
GROUP BY
	Assignments.Partner,
	CASE
		WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
			THEN SalesOrder.Ref
		ELSE CounterpartyContracts.Ref
	END,
	Assignments.Ref,
	CounterpartyContracts.Ref,
	CounterpartyContracts.Counterparty,
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.Organization,
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.Currency,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.Partner,
		VALUE(Catalog.Partners.EmptyRef)),
	GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.PriceIncludesVAT, FALSE),
	CASE
		WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
			THEN ISNULL(SalesOrder.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef))
		ELSE ISNULL(CounterpartyContracts.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef))
	END,
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.FinancialAccountingGroup,
		VALUE(Catalog.FinancialAccountingGroupsOfARAP.EmptyRef)),
	ISNULL(GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions.VATTaxation,
		VALUE(Enum.VATTaxationTypes.EmptyRef)),
	CASE
		WHEN &amp;TheOptionOfSeparationIsUsedOnTheCustomerSOrder
			THEN SalesOrder.Terms
		ELSE VALUE(Catalog.TermsOfSale.EmptyRef)
	END,
	EDStates.StatusPresentation,
	CASE
		WHEN GoodsAndServicesToRegisterPurchasingReportsToConsignor.DocumentAcquisitions &lt;> UNDEFINED
		AND EDStates.StatusPresentation IS NULL
			THEN &amp;StateNotStarted
		ELSE EDStates.StatusPresentation
	END,
	CounterpartyContracts.SplitReportByDocuments</queryText>
      <mainTable>AccumulationRegister.GoodsAndServicesToRegisterPurchasingReportsToConsignor.Balance</mainTable>
