    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	GoodsToBeRegisteredInReportsToConsignorBalance.DocumentAcquisitions AS Ref,
	VALUETYPE(GoodsToBeRegisteredInReportsToConsignorBalance.DocumentAcquisitions) AS DocumentAcquisitions,
	GoodsToBeRegisteredInReportsToConsignorBalance.DocumentAcquisitions.Number AS PurchaseDocumentNumber,
	GoodsToBeRegisteredInReportsToConsignorBalance.DocumentAcquisitions.Date AS PurchaseDocumentDate,
	GoodsToBeRegisteredInReportsToConsignorBalance.Purpose AS Purpose,
	GoodsToBeRegisteredInReportsToConsignorBalance.Purpose.Contract AS Contract,

	CASE
		WHEN GoodsToBeRegisteredInReportsToConsignorBalance.DocumentAcquisitions &lt;> UNDEFINED
			AND EDStates.StatusPresentation IS NULL
		THEN &amp;StateIsNotStarted
	ELSE EDStates.StatusPresentation
	END AS StatusPresentation

FROM
	AccumulationRegister.GoodsAndServicesToRegisterPurchasingReportsToConsignor.Balance(
			,
			Purpose.Contract = &amp;Contract
			AND Purpose.Partner = &amp;Partner
			AND (NOT &amp;PickByOrder OR Purpose.OrderDocument IN (&amp;Orders))
			AND NOT DocumentAcquisitions = VALUE(Document.VendorInvoice.EmptyRef)) AS GoodsToBeRegisteredInReportsToConsignorBalance
	LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
	ON GoodsToBeRegisteredInReportsToConsignorBalance.DocumentAcquisitions = EDStates.ObjectReference
	
WHERE
	GoodsToBeRegisteredInReportsToConsignorBalance.CountBalance > 0
	
</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
