    <toolTip>
      <key>en</key>
      <value>Order used to perform the kitting.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>سفارشی که برای انجام کیت‌سازی استفاده می‌شود.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Ordine sulla base del quale si esegue il montaggio</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Zlecenie, na podstawie którego dokonywany jest zebranie.</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Заказ, на основании которого выполняется сборка.</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Montajın gerçekleştirildiği esasa göre sipariş.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đơn hàng, trên cơ sở đơn hàng thực hiện đóng bộ</value>
