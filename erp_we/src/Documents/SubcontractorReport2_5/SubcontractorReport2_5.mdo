    <attributes uuid="b157eb61-52fe-4aa8-a9e5-57f110d3667d">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity (Stock UOM)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار (واحد انبار)</value>
      </synonym>
      <synonym>
        <key>it</key>
