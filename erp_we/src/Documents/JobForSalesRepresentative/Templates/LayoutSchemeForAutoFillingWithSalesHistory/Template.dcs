				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AVG(NestedQuery.CountPlan) AS CountPlan,
	NestedQuery.Products,
	NestedQuery.Characteristic AS Characteristic
FROM
	(SELECT
		SUM(RevenueAndCostOfSalesTurnover.CountTurnover) AS CountPlan,
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products AS Products,
		CASE
			WHEN &amp;Period = "Day"
				THEN RevenueAndCostOfSalesTurnover.DayPeriod
			ELSE CASE
					WHEN &amp;Period = "Month"
						THEN RevenueAndCostOfSalesTurnover.MonthPeriod
					ELSE RevenueAndCostOfSalesTurnover.WeekPeriod
				END
		END AS Period,
		CASE
			WHEN &amp;CharacteristicsDetails
				THEN RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Characteristic
			ELSE NULL
		END AS Characteristic
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, ) AS RevenueAndCostOfSalesTurnover
	{WHERE
		AccountingDimensionByPartners.Partner.* AS Partner,
		AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
	
	GROUP BY
		RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products,
		CASE
			WHEN &amp;Period = "Day"
				THEN RevenueAndCostOfSalesTurnover.DayPeriod
			ELSE CASE
					WHEN &amp;Period = "Month"
						THEN RevenueAndCostOfSalesTurnover.MonthPeriod
					ELSE RevenueAndCostOfSalesTurnover.WeekPeriod
				END
		END,
		CASE
			WHEN &amp;CharacteristicsDetails
				THEN RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Characteristic
			ELSE NULL
		END) AS NestedQuery

GROUP BY
	NestedQuery.Products,
	NestedQuery.Characteristic

HAVING
	AVG(NestedQuery.CountPlan) &gt; 0</query>
	</dataSet>
	<totalField>
		<dataPath>CountPlan</dataPath>
		<expression>Sum(CountPlan)</expression>
	</totalField>
