				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AVG(NestedQuery.Sum) AS Sum
FROM
	(SELECT
		SUM(RevenueAndCostOfSalesTurnover.RevenueAmountTurnover) AS Sum,
		CASE
			WHEN &amp;Period = "Day"
				THEN RevenueAndCostOfSalesTurnover.DayPeriod
			ELSE CASE
					WHEN &amp;Period = "Month"
						THEN RevenueAndCostOfSalesTurnover.MonthPeriod
					ELSE RevenueAndCostOfSalesTurnover.WeekPeriod
				END
		END AS Period
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, ) AS RevenueAndCostOfSalesTurnover
	{WHERE
		RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Partner.* AS Partner,
		RevenueAndCostOfSalesTurnover.AccountingDimensionByPartners.Counterparty.* AS Counterparty}
	
	GROUP BY
		CASE
			WHEN &amp;Period = "Day"
				THEN RevenueAndCostOfSalesTurnover.DayPeriod
			ELSE CASE
					WHEN &amp;Period = "Month"
						THEN RevenueAndCostOfSalesTurnover.MonthPeriod
					ELSE RevenueAndCostOfSalesTurnover.WeekPeriod
				END
		END) AS NestedQuery</query>
	</dataSet>
