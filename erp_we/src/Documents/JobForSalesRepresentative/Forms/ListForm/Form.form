    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	DocumentJobForSalesRepresentative.Ref AS Ref,
	DocumentJobForSalesRepresentative.DeletionMark AS DeletionMark,
	DocumentJobForSalesRepresentative.Number AS Number,
	DocumentJobForSalesRepresentative.Date AS Date,
	DocumentJobForSalesRepresentative.Posted AS Posted,
	DocumentJobForSalesRepresentative.Organization AS Organization,
	DocumentJobForSalesRepresentative.Partner AS Partner,
	DocumentJobForSalesRepresentative.Counterparty AS Counterparty,
	DocumentJobForSalesRepresentative.Terms AS Terms,
	DocumentJobForSalesRepresentative.Currency AS Currency,
	DocumentJobForSalesRepresentative.PaymentSchedule AS PaymentSchedule,
	DocumentJobForSalesRepresentative.PriceIncludesVAT AS PriceIncludesVAT,
	DocumentJobForSalesRepresentative.Warehouse AS Warehouse,
	DocumentJobForSalesRepresentative.SalesRepresentative AS SalesRepresentative,
	DocumentJobForSalesRepresentative.PlannedVisitDate AS PlannedVisitDate,
	DocumentJobForSalesRepresentative.ActualVisitDate AS ActualVisitDate,
	DocumentJobForSalesRepresentative.BeginTime AS BeginTime,
	DocumentJobForSalesRepresentative.EndTime AS EndTime,
	DocumentJobForSalesRepresentative.Supervisor_ AS Supervisor_,
	DocumentJobForSalesRepresentative.ItemsDetails AS ItemsDetails,
	DocumentJobForSalesRepresentative.SumPlan AS SumPlan,
	DocumentJobForSalesRepresentative.Status AS Status,
	DocumentJobForSalesRepresentative.NotShipInInstallments AS NotShipInInstallments,
	DocumentJobForSalesRepresentative.RequestShipmentOn AS RequestShipmentOn,
	DocumentJobForSalesRepresentative.Presentation AS Presentation,
	DocumentJobForSalesRepresentative.PointInTime AS PointInTime,
	CASE
			WHEN (NOT SalesOrder.Ref IS NULL )
					AND (NOT SalesOrder.DeletionMark)
				THEN 0
			ELSE 1
	END AS PictureOfCompletedOrders,
	CASE
		WHEN DocumentJobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
				AND DocumentJobForSalesRepresentative.PlannedVisitDate &lt; BEGINOFPERIOD(&amp;UpdateDate, DAY)
			THEN TRUE
		WHEN DocumentJobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
				AND DocumentJobForSalesRepresentative.PlannedVisitDate &lt; BEGINOFPERIOD(&amp;UpdateDate, DAY)
				AND DocumentJobForSalesRepresentative.ActualVisitDate = &amp;DateEmpty
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CASE
		WHEN
			DocumentJobForSalesRepresentative.DeletionMark
		THEN
			&amp;DateEmpty
		WHEN DocumentJobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
				OR (DocumentJobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
				AND DocumentJobForSalesRepresentative.ActualVisitDate = &amp;DateEmpty)
		THEN
			DocumentJobForSalesRepresentative.PlannedVisitDate
		ELSE
			&amp;DateEmpty
	END AS EventDate,
	CASE
		WHEN (NOT SalesOrder.Ref IS NULL )
				AND (NOT SalesOrder.DeletionMark)
			THEN &amp;OrdersArePlaced
		ELSE &amp;OrdersAreNotPlaced
	END AS PresenceOfOrders
FROM
	Document.JobForSalesRepresentative AS DocumentJobForSalesRepresentative
		LEFT JOIN Document.SalesOrder AS SalesOrder
		ON (SalesOrder.DocumentBasis = DocumentJobForSalesRepresentative.Ref)
			AND ((NOT SalesOrder.DeletionMark))</queryText>
      <mainTable>Document.JobForSalesRepresentative</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
