  <attributes>
    <name>JobsList</name>
    <title>
      <key>en</key>
      <value>Task list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست وظایف</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco task</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista zadań</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список заданий</value>
    </title>
    <title>
      <key>tr</key>
      <value>Görevler listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách nhiệm vụ</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	MAX(JobForSalesRepresentative.ActualVisitDate) AS LastVisit,
	JobForSalesRepresentative.Partner AS Partner,
	JobForSalesRepresentative.ServiceTerms AS ServiceTerms
INTO BTLastSessionsConditions
FROM
	Document.JobForSalesRepresentative AS JobForSalesRepresentative
WHERE
	NOT JobForSalesRepresentative.DeletionMark
	AND JobForSalesRepresentative.Partner.ServedBySalesRepresentatives
	AND JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)

GROUP BY
	JobForSalesRepresentative.Partner,
	JobForSalesRepresentative.ServiceTerms
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MAX(JobForSalesRepresentative.ActualVisitDate) AS LastVisit,
	JobForSalesRepresentative.Partner AS Partner,
	JobForSalesRepresentative.Terms AS Terms
INTO LastSessionsWithoutConditions
FROM
	Document.JobForSalesRepresentative AS JobForSalesRepresentative
WHERE
	NOT JobForSalesRepresentative.DeletionMark
	AND JobForSalesRepresentative.Partner.ServedBySalesRepresentatives
	AND JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)

GROUP BY
	JobForSalesRepresentative.Partner,
	JobForSalesRepresentative.Terms
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	JobForSalesRepresentative.Ref AS JobForSalesRepresentative,
	JobForSalesRepresentative.Partner AS Partner,
	JobForSalesRepresentative.Terms AS Terms,
	JobForSalesRepresentative.SalesRepresentative AS SalesRepresentative,
	MIN(JobForSalesRepresentative.PlannedVisitDate) AS Scheduled,
	JobForSalesRepresentative.Supervisor_ AS Supervisor_,
	JobForSalesRepresentative.ServiceTerms AS ServiceTerms,
	JobForSalesRepresentative.Status AS Status
INTO UttarayanaJob
FROM
	Document.JobForSalesRepresentative AS JobForSalesRepresentative
WHERE
	NOT JobForSalesRepresentative.DeletionMark
	AND JobForSalesRepresentative.PlannedVisitDate >= &amp;StartDate_3
	AND JobForSalesRepresentative.Partner.ServedBySalesRepresentatives
	AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;PlanningEndDate
			OR &amp;PlanningEndDate = &amp;DateEmpty)
	AND (JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
			OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing))

GROUP BY
	JobForSalesRepresentative.Ref,
	JobForSalesRepresentative.Partner,
	JobForSalesRepresentative.Terms,
	JobForSalesRepresentative.SalesRepresentative,
	JobForSalesRepresentative.Supervisor_,
	JobForSalesRepresentative.ServiceTerms,
	JobForSalesRepresentative.Status
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MIN(CASE
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Monday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 1
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 1 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 1 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Tuesday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 2
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 2 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 2 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Wednesday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 3
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 3 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 3 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Thursday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 4
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 4 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 4 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Friday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 5
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 5 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 5 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Saturday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 6
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 6 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 6 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			WHEN TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.WeekDay = &amp;Sunday
				THEN CASE
						WHEN WEEKDAY(MainQuery.StartingDateOfCalculation) > 7
							THEN DATEADD(MainQuery.StartingDateOfCalculation, DAY, 7 - WEEKDAY(MainQuery.StartingDateOfCalculation) + 7)
						ELSE DATEADD(MainQuery.StartingDateOfCalculation, DAY, 7 - WEEKDAY(MainQuery.StartingDateOfCalculation))
					END
			ELSE &amp;DateEmpty
		END) AS PlannedDateOfVisit,
	MainQuery.ServiceTerms AS ServiceTerms,
	MainQuery.Terms AS Terms,
	MainQuery.Supervisor_ AS Supervisor_,
	MainQuery.SalesRepresentative AS SalesRepresentative,
	MIN(MainQuery.Scheduled) AS Scheduled,
	MainQuery.JobForSalesRepresentative AS JobForSalesRepresentative,
	MainQuery.Partner AS Partner,
	MAX(MainQuery.LastVisit) AS LastVisit,
	SUM(MainQuery.PictureIndex) AS PictureIndex
FROM
	(SELECT
		PartnersAndTermsOfService.ServiceTerms AS ServiceTerms,
		CASE
			WHEN ScheduledTask.Terms IS NULL
				THEN PartnersAndTermsOfService.Terms
			ELSE ScheduledTask.Terms
		END AS Terms,
		CASE
			WHEN ScheduledTask.Supervisor_ IS NULL
				THEN PartnersAndTermsOfService.Supervisor_
			ELSE ScheduledTask.Supervisor_
		END AS Supervisor_,
		CASE
			WHEN ScheduledTask.SalesRepresentative IS NULL
				THEN PartnersAndTermsOfService.SalesRepresentative
			ELSE ScheduledTask.SalesRepresentative
		END AS SalesRepresentative,
		MIN(ScheduledTask.Scheduled) AS Scheduled,
		ScheduledTask.JobForSalesRepresentative AS JobForSalesRepresentative,
		PartnersAndTermsOfService.Partner AS Partner,
		MAX(LastVisits.LastVisit) AS LastVisit,
		SUM(CASE
				WHEN ScheduledTask.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					THEN 0
				ELSE 1
			END) AS PictureIndex,
		MIN(CASE
				WHEN LastVisits.LastVisit &lt; &amp;InitialPlanningDate
						AND LastVisits.LastVisit &lt;> &amp;DateEmpty
					THEN CASE
							WHEN DATEADD(BEGINOFPERIOD(LastVisits.LastVisit, DAY), DAY, 1) &lt;= &amp;PlanningEndDate
									OR &amp;PlanningEndDate = &amp;DateEmpty
								THEN DATEADD(BEGINOFPERIOD(LastVisits.LastVisit, DAY), DAY, 1)
							ELSE NULL
						END
				ELSE &amp;InitialPlanningDate
			END) AS StartingDateOfCalculation
	FROM
		(SELECT
			Partners.Ref AS Partner,
			ISNULL(TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Ref, VALUE(Catalog.TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.EmptyRef)) AS ServiceTerms,
			TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Terms AS Terms,
			TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Supervisor_ AS Supervisor_,
			TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.SalesRepresentative AS SalesRepresentative
		FROM
			Catalog.Partners AS Partners
				LEFT JOIN Catalog.TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives AS TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives
				ON Partners.Ref = TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Owner
		WHERE
			NOT Partners.DeletionMark
			AND Partners.ServedBySalesRepresentatives
			AND (NOT TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.DeletionMark
					OR TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.DeletionMark IS NULL)
		
		GROUP BY
			Partners.Ref,
			TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Terms,
			TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Supervisor_,
			TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.SalesRepresentative,
			ISNULL(TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.Ref, VALUE(Catalog.TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.EmptyRef))) AS PartnersAndTermsOfService
			LEFT JOIN BTLastSessionsConditions AS LastVisits
			ON PartnersAndTermsOfService.Partner = LastVisits.Partner
				AND PartnersAndTermsOfService.ServiceTerms = LastVisits.ServiceTerms
			LEFT JOIN UttarayanaJob AS ScheduledTask
			ON PartnersAndTermsOfService.Partner = ScheduledTask.Partner
				AND PartnersAndTermsOfService.ServiceTerms = ScheduledTask.ServiceTerms
	
	GROUP BY
		PartnersAndTermsOfService.Partner,
		PartnersAndTermsOfService.ServiceTerms,
		ScheduledTask.JobForSalesRepresentative,
		CASE
			WHEN ScheduledTask.Terms IS NULL
				THEN PartnersAndTermsOfService.Terms
			ELSE ScheduledTask.Terms
		END,
		CASE
			WHEN ScheduledTask.Supervisor_ IS NULL
				THEN PartnersAndTermsOfService.Supervisor_
			ELSE ScheduledTask.Supervisor_
		END,
		CASE
			WHEN ScheduledTask.SalesRepresentative IS NULL
				THEN PartnersAndTermsOfService.SalesRepresentative
			ELSE ScheduledTask.SalesRepresentative
		END) AS MainQuery
		LEFT JOIN Catalog.TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.VisitSchedule AS TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule
		ON MainQuery.ServiceTerms = TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentativesVisitSchedule.Ref

GROUP BY
	MainQuery.Partner,
	MainQuery.JobForSalesRepresentative,
	MainQuery.SalesRepresentative,
	MainQuery.Supervisor_,
	MainQuery.ServiceTerms,
	MainQuery.Terms

UNION

SELECT
	MIN(&amp;DateEmpty),
	ScheduledTasksWithoutConditions.ServiceTerms,
	ScheduledTasksWithoutConditions.Terms,
	ScheduledTasksWithoutConditions.Supervisor_,
	ScheduledTasksWithoutConditions.SalesRepresentative,
	MIN(ScheduledTasksWithoutConditions.PlannedVisitDate),
	ScheduledTasksWithoutConditions.Ref,
	ScheduledTasksWithoutConditions.Partner,
	MAX(LastVisits.LastVisit),
	SUM(CASE
			WHEN ScheduledTasksWithoutConditions.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
				THEN 0
			ELSE 1
		END)
FROM
	Document.JobForSalesRepresentative AS ScheduledTasksWithoutConditions
		LEFT JOIN LastSessionsWithoutConditions AS LastVisits
		ON ScheduledTasksWithoutConditions.Partner = LastVisits.Partner
			AND ScheduledTasksWithoutConditions.Terms = LastVisits.Terms
WHERE
	NOT ScheduledTasksWithoutConditions.DeletionMark
	AND ScheduledTasksWithoutConditions.Partner.ServedBySalesRepresentatives
	AND ScheduledTasksWithoutConditions.ServiceTerms = VALUE(Catalog.TermsAndConditionsOfServicesProvidedToCustomersBySalesRepresentatives.EmptyRef)
	AND (ScheduledTasksWithoutConditions.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
			OR ScheduledTasksWithoutConditions.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing))
	AND ScheduledTasksWithoutConditions.PlannedVisitDate >= &amp;StartDate_3
	AND (ScheduledTasksWithoutConditions.PlannedVisitDate &lt;= &amp;PlanningEndDate
			OR &amp;PlanningEndDate = &amp;DateEmpty)

GROUP BY
	ScheduledTasksWithoutConditions.ServiceTerms,
	ScheduledTasksWithoutConditions.Terms,
	ScheduledTasksWithoutConditions.Supervisor_,
	ScheduledTasksWithoutConditions.SalesRepresentative,
	ScheduledTasksWithoutConditions.Ref,
	ScheduledTasksWithoutConditions.Partner

ORDER BY
	Partner,
	PlannedDateOfVisit,
	Supervisor_,
	SalesRepresentative</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
