    <attributes uuid="48b0e893-4236-41db-ab93-969e7a77405e">
      <name>NumberOfPackagesPlan</name>
      <synonym>
        <key>en</key>
        <value>Quantity (plan)</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار (برنامه)</value>
      </synonym>
      <synonym>
