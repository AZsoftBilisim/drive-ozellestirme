				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>عنوان خطاب تأمین‌کننده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Modo di rivolgersi al fornitore</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Zwrot do dostawcy</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Обращение к поставщику</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Tedarikçiyle iletişime geçme</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Liên hệ đối tác</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Warehouse</dataPath>
			<field>Warehouse</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentAmount</dataPath>
			<field>DocumentAmount</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IncomingDocumentDate</dataPath>
			<field>IncomingDocumentDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IncomingDocumentNumber</dataPath>
			<field>IncomingDocumentNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnerName_</dataPath>
			<field>PartnerName_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Vendor name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نام تأمین‌کننده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Nominativo del fornitore</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Nazwa dostawcy</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование поставщика</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Tedarikçinin adı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tên nhà cung cấp</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	GoodsReceiptForStorage.Number,
	GoodsReceiptForStorage.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	GoodsReceiptForStorage.Warehouse,
	GoodsReceiptForStorage.Manager,
	GoodsReceiptForStorage.Currency,
	GoodsReceiptForStorage.DocumentAmount,
	GoodsReceiptForStorage.Contract,
	GoodsReceiptForStorage.IncomingDocumentNumber,
	GoodsReceiptForStorage.IncomingDocumentDate
FROM
	Document.GoodsReceiptForStorage AS GoodsReceiptForStorage
		{LEFT JOIN Catalog.Partners AS Partners
		ON GoodsReceiptForStorage.Partner = Partners.Ref}
WHERE
	GoodsReceiptForStorage.Ref = &amp;GoodsReceiptForStorage</query>
	</dataSet>
