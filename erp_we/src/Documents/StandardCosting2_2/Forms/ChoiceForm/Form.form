  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	StandardCosting2_2.Ref,
	StandardCosting2_2.DeletionMark,
	StandardCosting2_2.Number,
	StandardCosting2_2.Date,
	StandardCosting2_2.Posted,
	StandardCosting2_2.Organization,
	StandardCosting2_2.ProductionDispatcherBusinessUnit,
	StandardCosting2_2.CostObject,
	StandardCosting2_2.PriceKind,
	StandardCosting2_2.EmployeeResponsible,
	StandardCosting2_2.Comment,
	StandardCosting2_2.Author,
	StandardCosting2_2.CostObjects.*,
	StandardCosting2_2.AdditionalAttributes.*,
	StandardCosting2_2.PointInTime
FROM
	Document.StandardCosting2_2 AS StandardCosting2_2
{WHERE
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.StatesOfStandardCostEstimates AS PCState
		WHERE
			PCState.StandardCostEstimate = StandardCosting2_2.Ref
			AND PCState.State = VALUE(Enum.StatesOfStandardCostEstimateCalculation.Calculated)) AS
		CalculatedSelection,
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS DD
		WHERE
			DD.StandardCostEstimate = StandardCosting2_2.Ref
			AND (DD.ManufacturedProduct = &amp;Product
			OR DD.SemiFinishedProduct = &amp;Product)) AS ProductSelection_4_,
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS DD
		WHERE
			DD.StandardCostEstimate = StandardCosting2_2.Ref
			AND (DD.ItemVariant = &amp;Characteristic
			OR DD.ItemVariantsOfIntermediateProduct = &amp;Characteristic)) AS FeatureSelection,
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS DD
		WHERE
			DD.StandardCostEstimate = StandardCosting2_2.Ref
			AND DD.Purpose = &amp;Purpose) AS PurposeSelection}</queryText>
