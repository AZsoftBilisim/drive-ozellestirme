    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	StandardCosting.Ref AS Ref,
	StandardCosting.DeletionMark AS DeletionMark,
	StandardCosting.Number AS Number,
	StandardCosting.Date AS Date,
	StandardCosting.Posted AS Posted,
	StandardCosting.Organization AS Organization,
	StandardCosting.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	StandardCosting.CostObject AS CostObject,
	StandardCosting.PriceKind AS PriceKind,
	(CalculationStates_3.State = VALUE(Enum.StatesOfStandardCostEstimateCalculation.CalculationError)) AS CalculationError,
	(CalculationStates_3.State = VALUE(Enum.StatesOfStandardCostEstimateCalculation.CalculateWithErrors)) AS CalculateWithErrors,
	ISNULL(CalculationStates_3.State, VALUE(Enum.StatesOfStandardCostEstimateCalculation.NotCalculated)) AS State,
	StandardCosting.EmployeeResponsible AS EmployeeResponsible,
	StandardCosting.Comment AS Comment,
	StandardCosting.CostObjects AS CostObjects,
	StandardCosting.Author AS Author,
	StandardCosting.PointInTime AS PointInTime,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.StandardCosting2_2 AS StandardCosting
		LEFT JOIN InformationRegister.StatesOfStandardCostEstimates AS CalculationStates_3
		ON StandardCosting.Ref = CalculationStates_3.StandardCostEstimate
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON EDStates.ObjectReference = StandardCosting.Ref</queryText>
      <mainTable>Document.StandardCosting2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
