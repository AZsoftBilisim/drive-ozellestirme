    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	ProductionOrder2_2.Ref AS Ref,
	ProductionOrder2_2.Number AS Number,
	ProductionOrder2_2.Date AS Date,
	ProductionOrder2_2.Status AS Status,
	ProductionOrder2_2.Department AS Department,
	ProductionOrder2_2.EmployeeResponsible AS EmployeeResponsible
FROM
	Document.ProductionOrder2_2 AS ProductionOrder2_2
		INNER JOIN Document.ProductionOrder2_2.ManufacturedProduct AS ProductionOrder2_2ManufacturedProduct
		ON (ProductionOrder2_2ManufacturedProduct.Ref = ProductionOrder2_2.Ref)
			AND (ProductionOrder2_2ManufacturedProduct.Products = &amp;Products)
			AND (ProductionOrder2_2ManufacturedProduct.Characteristic = &amp;Characteristic)
			AND (ProductionOrder2_2ManufacturedProduct.Purpose = &amp;Purpose
				OR &amp;ForAllAppointments)
			AND (ProductionOrder2_2ManufacturedProduct.Ref.Department = &amp;Department)
WHERE
	ProductionOrder2_2.ProductionProcessType IN (VALUE(Enum.ProductionProcessTypes.Assembly), VALUE(Enum.ProductionProcessTypes.Repair))</queryText>
      <mainTable>Document.ProductionOrder2_2</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
