    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	VendorBonusCertificate.Ref,
	VendorBonusCertificate.DeletionMark,
	VendorBonusCertificate.Number,
	VendorBonusCertificate.Date,
	VendorBonusCertificate.Posted,
	VendorBonusCertificate.Organization,
	VendorBonusCertificate.Counterparty,
	VendorBonusCertificate.Partner,
	VendorBonusCertificate.Contract,
	VendorBonusCertificate.ARAPCurrency,
	VendorBonusCertificate.AmountARAP,
	VendorBonusCertificate.Department,
	VendorBonusCertificate.FinancialAccountingGroup,
	VendorBonusCertificate.ARAPObject,
	VendorBonusCertificate.BusinessOperation,
	VendorBonusCertificate.EmployeeResponsible,
	VendorBonusCertificate.Comment,
	VendorBonusCertificate.DocumentID,
	VendorBonusCertificate.GLAccountSettings,
	VendorBonusCertificate.LineOfBusiness,
	VendorBonusCertificate.IncomingDocumentNumber,
	VendorBonusCertificate.IncomingDocumentDate,
	VendorBonusCertificate.IncomeLiabilityItem,
	VendorBonusCertificate.DimensionOfRevenue,
	VendorBonusCertificate.AssetsLiabilitiesDimension,
	VendorBonusCertificate.Rebates.*,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Document.VendorBonusCertificate AS VendorBonusCertificate
		{LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON VendorBonusCertificate.Ref = FilesExist.ObjectWithFiles}</queryText>
      <mainTable>Document.VendorBonusCertificate</mainTable>
