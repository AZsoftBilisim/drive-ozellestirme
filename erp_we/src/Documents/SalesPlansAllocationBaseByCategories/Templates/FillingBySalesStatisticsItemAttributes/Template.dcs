		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ItemsGroup AS Value,
	SUM(RevenueAndCostOfSalesTurnover.CountTurnover) AS Count
INTO Sales
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers AS RevenueAndCostOfSalesTurnover
WHERE
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ProductCategory = &amp;ProductCategory
{WHERE
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.StorageLocation.*,
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.* AS Products}

GROUP BY
	RevenueAndCostOfSalesTurnover.ItemsLocationAttributes.Products.ItemsGroup
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SUM(Sales.Count) AS Count
INTO GeneralSales
FROM
	Sales AS Sales
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Sales.Value,
	Sales.Count / GeneralSales.Count AS AllocationPercentage
FROM
	Sales AS Sales
		INNER JOIN GeneralSales AS GeneralSales
		ON (TRUE)</query>
