		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsInStorageBins.Products AS Products,
	GoodsInStorageBins.Characteristic AS Characteristic,
	GoodsInStorageBins.Purpose AS Purpose,
	&amp;QueryTextPackagingFactor AS PackageFactor,
	GoodsInStorageBins.Package AS Package,
	GoodsInStorageBins.Cell AS Cell,
	GoodsInStorageBins.InStockBalance AS NumberOfPackages,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN GoodsInStorageBins.InStockBalance
		ELSE GoodsInStorageBins.InStockBalance * &amp;QueryTextPackagingFactor
	END AS Count,
	GoodsInStorageBins.Series,
	CASE
		WHEN NOT WarehousesOfSeriesAccountingPolicy.BatchAccountingPolicy IS NULL 
				AND WarehousesOfSeriesAccountingPolicy.BatchAccountingPolicy.AccountForRemainingSeries
			THEN 4
		ELSE 0
	END AS BatchesIndicationStatus
FROM
	AccumulationRegister.GoodsInStorageBins.Balance(
			&amp;DateOfRemainingGoods,
			Cell.Owner = &amp;Warehouse
				AND Cell.Premise = &amp;Premise {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS GoodsInStorageBins
		LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS WarehousesOfSeriesAccountingPolicy
		ON GoodsInStorageBins.Products.ProductKind = WarehousesOfSeriesAccountingPolicy.Ref
			AND (WarehousesOfSeriesAccountingPolicy.Warehouse = &amp;Warehouse)</query>
	</dataSet>
