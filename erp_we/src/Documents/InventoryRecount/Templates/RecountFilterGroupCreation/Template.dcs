		<dataSource>DataSource1</dataSource>
		<query>SELECT
	StorageBins.Ref AS SelectionCell,
	StorageBins.WarehouseZone AS WarehouseZone,
	StorageBins.StorageArea AS StorageArea,
	StorageBins.Section3 AS Section3,
	StorageBins.Line AS Line,
	StorageBins.Rack AS Rack,
	StorageBins.Tier AS Tier,
	StorageBins.Position AS Position
INTO CellTable
FROM
	Catalog.StorageBins AS StorageBins
WHERE
	StorageBins.Owner = &amp;Warehouse
	AND StorageBins.Premise = &amp;Premise
	AND NOT StorageBins.IsFolder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ResiduesInCells.Cell,
	MAX(ResiduesInCells.ThereIsNegativeRemainder) AS ThereIsNegativeRemainder
INTO NonEmptyCells
FROM                      
	(SELECT
		ResiduesInCells.Cell AS Cell,
		ResiduesInCells.Products AS Products,
		ResiduesInCells.Characteristic AS Characteristic,
		ResiduesInCells.Series AS Series,
		ResiduesInCells.Package AS Package,
		CASE
			WHEN ResiduesInCells.InStockBalance &gt; 0
				THEN FALSE
			ELSE TRUE
		END AS ThereIsNegativeRemainder
	FROM
		AccumulationRegister.GoodsInStorageBins.Balance(
				,
				Cell IN
					(SELECT
						CellTable.SelectionCell
					FROM
						CellTable)) AS ResiduesInCells) AS ResiduesInCells

GROUP BY
	ResiduesInCells.Cell
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CellTable.SelectionCell AS Cell
INTO QuestionableCells
FROM
	CellTable AS CellTable
		INNER JOIN InformationRegister.BinRecountStates AS BinRecountStates
		ON (CellTable.SelectionCell = BinRecountStates.Cell)
WHERE
	BinRecountStates.State = VALUE(Enum.BinRecountStates.RecountIsRequired)
	AND &amp;FilterByDoubtfulStorageBins
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN CellTable.SelectionCell.UseFrequencyOfBinInventoryRecounts = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.UseCellSettings)
			THEN CellTable.SelectionCell.NumberOfDaysOfPhysicalCountCycle
		WHEN CellTable.SelectionCell.UseFrequencyOfBinInventoryRecounts = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.DontUse)
			THEN UNDEFINED
		WHEN CellTable.SelectionCell.UseFrequencyOfBinInventoryRecounts = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.UseStorageAreaSettings)
				AND NOT StorageAreas.Ref IS NULL 
			THEN CASE
					WHEN StorageAreas.FrequencyOfBinInventoryRecount = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.UseStorageAreaSettings)
						THEN StorageAreas.NumberOfDaysOfPhysicalCountCycle
					WHEN StorageAreas.FrequencyOfBinInventoryRecount = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.DontUse)
						THEN UNDEFINED
					ELSE UNDEFINED
				END
		ELSE UNDEFINED
	END AS NumberOfDaysOfPhysicalCountCycle,
	CellTable.SelectionCell AS Cell
INTO DaysCount
FROM
	CellTable AS CellTable
		LEFT JOIN Catalog.StorageAreas AS StorageAreas
		ON CellTable.StorageArea = StorageAreas.Ref
WHERE
	CASE
			WHEN CellTable.SelectionCell.UseFrequencyOfBinInventoryRecounts = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.UseCellSettings)
				THEN CellTable.SelectionCell.NumberOfDaysOfPhysicalCountCycle
			WHEN CellTable.SelectionCell.UseFrequencyOfBinInventoryRecounts = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.DontUse)
				THEN UNDEFINED
			WHEN CellTable.SelectionCell.UseFrequencyOfBinInventoryRecounts = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.UseStorageAreaSettings)
					AND NOT StorageAreas.Ref IS NULL 
				THEN CASE
						WHEN StorageAreas.FrequencyOfBinInventoryRecount = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.UseStorageAreaSettings)
							THEN StorageAreas.NumberOfDaysOfPhysicalCountCycle
						WHEN StorageAreas.FrequencyOfBinInventoryRecount = VALUE(Enum.OptionsOfUsingPeriodicPhysicalInventoryCountOfBins.DontUse)
							THEN UNDEFINED
						ELSE UNDEFINED
					END
			ELSE UNDEFINED
		END &lt;&gt; UNDEFINED
	AND &amp;FilterByRecountFrequency
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	DaysCount.Cell AS Cell
INTO CellsByPeriodicity
FROM
	DaysCount AS DaysCount
		LEFT JOIN InformationRegister.BinRecountStates AS BinRecountStates
		ON DaysCount.Cell = BinRecountStates.Cell
WHERE
	DATEADD(ISNULL(BinRecountStates.LastRecalculationDate, DATETIME(1, 1, 1)), DAY, CAST(DaysCount.NumberOfDaysOfPhysicalCountCycle AS NUMBER)) &lt;= &amp;RecountDate
	AND &amp;FilterByRecountFrequency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CellsByPeriodicity.Cell AS Cell
INTO CellsByAdditionalConditions
FROM
	CellsByPeriodicity AS CellsByPeriodicity

UNION

SELECT
	QuestionableCells.Cell
FROM
	QuestionableCells AS QuestionableCells

UNION

SELECT
	NonEmptyCells.Cell
FROM
	NonEmptyCells AS NonEmptyCells
WHERE
	NonEmptyCells.ThereIsNegativeRemainder
	AND &amp;FilterByNegativeInventory
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	CellTable.SelectionCell AS SelectionCell,
	CellTable.WarehouseZone AS WarehouseZone,
	CellTable.StorageArea AS StorageArea,
	CellTable.Section3 AS Section3,
	CellTable.Line AS Line,
	CellTable.Rack AS Rack,
	CellTable.Tier AS Tier,
	CellTable.Position AS Position
FROM
	CellTable AS CellTable
		{INNER JOIN AccumulationRegister.GoodsInStorageBins.Balance(
				,
				Cell IN
					(SELECT
						CellTable.SelectionCell
					FROM
						CellTable) {(Products).* AS NomenclatureSelection, (Characteristic).* AS FeatureSelection, (Series).* AS SeriesFilter, (Package).* AS PackagingSelection}) AS GoodsInStorageBinsBalance
		ON CellTable.SelectionCell = GoodsInStorageBinsBalance.Cell}
		{LEFT JOIN NonEmptyCells AS NonEmptyCells
		ON (NonEmptyCells.Cell = CellTable.SelectionCell)}
		{INNER JOIN CellsByAdditionalConditions AS CellsByAdditionalConditions
		ON CellTable.SelectionCell = CellsByAdditionalConditions.Cell}
{WHERE
	(NOT GoodsInStorageBinsBalance.InStockBalance IS NULL 
			AND &amp;FilterByRemainingProducts),
	(NOT NonEmptyCells.Cell IS NULL 
			AND &amp;FilterByStorageBinsWithRemainingGoods),
	(NonEmptyCells.Cell IS NULL 
			AND &amp;FilterByEmptyStorageBins),
	(NOT CellsByAdditionalConditions.Cell IS NULL 
			AND &amp;ThereIsFilterByAdditionalConditions)}</query>
	</dataSet>
	<parameter>
		<name>Warehouse</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Warehouse</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>انبار</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Magazzino</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Magazyn</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Склад</v8:content>
