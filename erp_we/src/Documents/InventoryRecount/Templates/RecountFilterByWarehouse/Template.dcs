		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Segments.Products,
	Segments.Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CatProducts.Ref AS Products,
	ISNULL(CatCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	CASE
		WHEN NOT WarehousesOfSeriesAccountingPolicy.BatchAccountingPolicy IS NULL 
				AND WarehousesOfSeriesAccountingPolicy.BatchAccountingPolicy.AccountForRemainingSeries
			THEN 4
		ELSE 0
	END AS BatchesIndicationStatus
INTO Goods
FROM
	Catalog.Products AS CatProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatCharacteristics
		ON (CatCharacteristics.Owner = CASE
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatProducts.ProductKind
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatProducts.Ref
				WHEN CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatProducts.ItemVariantsOwner
				ELSE UNDEFINED
			END)
			AND (NOT CatProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse))
		LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS WarehousesOfSeriesAccountingPolicy
		ON CatProducts.ProductKind = WarehousesOfSeriesAccountingPolicy.Ref
			AND (WarehousesOfSeriesAccountingPolicy.Warehouse = &amp;Warehouse)
WHERE
	CatProducts.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
	AND NOT CatProducts.IsFolder
{WHERE
	CatProducts.Ref.* AS Products,
	((CatProducts.Ref, ISNULL(CatCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ISNULL(ProductStock.InStockBalance, 0) AS Count,
	ISNULL(ProductStock.InStockBalance, 0) AS NumberOfPackages,
	ISNULL(ProductStock.Series, VALUE(Catalog.ItemsBatches.EmptyRef)) AS Series,
	Goods.Products,
	Goods.Characteristic,
	ISNULL(ProductStock.ControlledLotReference, VALUE(Catalog.ControlledLots.EmptyRef)) AS ControlledLotReference,
	ISNULL(ProductStock.Purpose, VALUE(Catalog.Assignments.EmptyRef)) AS Purpose,
	Goods.BatchesIndicationStatus
FROM
	Goods AS Goods
		LEFT JOIN AccumulationRegister.ProductStock.Balance(
				&amp;DateOfRemainingGoods,
				Warehouse = &amp;Warehouse
					AND Premise = &amp;Premise {(Products).* AS Products, ((Products, Characteristic) IN
				    (SELECT
				        SelectionByProductSegment.Products,
				        SelectionByProductSegment.Characteristic
				    FROM
				        SelectionByProductSegment
				    WHERE
				        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ProductStock
		ON Goods.Products = ProductStock.Products
			AND Goods.Characteristic = ProductStock.Characteristic
WHERE
	(Goods.BatchesIndicationStatus = 0
			OR ProductStock.Series IS NULL
			OR ISNULL(ProductStock.Series, VALUE(Catalog.ItemsBatches.EmptyRef)) &lt;&gt; VALUE(Catalog.ItemsBatches.EmptyRef))</query>
	</dataSet>
