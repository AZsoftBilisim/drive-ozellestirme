  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentDisposeFixedAssets2_4.Ref,
	DocumentDisposeFixedAssets2_4.DeletionMark,
	DocumentDisposeFixedAssets2_4.Number,
	DocumentDisposeFixedAssets2_4.Date,
	DocumentDisposeFixedAssets2_4.Posted,
	DocumentDisposeFixedAssets2_4.AssetsLiabilitiesDimension,
	DocumentDisposeFixedAssets2_4.DimensionOfExpenses,
	DocumentDisposeFixedAssets2_4.DocumentInAnotherAccounting,
	DocumentDisposeFixedAssets2_4.GeneratedDocument,
	DocumentDisposeFixedAssets2_4.DocumentBasis,
	DocumentDisposeFixedAssets2_4.Comment,
	DocumentDisposeFixedAssets2_4.Organization,
	DocumentDisposeFixedAssets2_4.EmployeeResponsible,
	DocumentDisposeFixedAssets2_4.RecordInLocalAccounting,
	DocumentDisposeFixedAssets2_4.RecordInManAccounting,
	DocumentDisposeFixedAssets2_4.Department,
	DocumentDisposeFixedAssets2_4.RetirementReason,
	DocumentDisposeFixedAssets2_4.FixedAssetsEvent,
	DocumentDisposeFixedAssets2_4.ExpenseItem,
	DocumentDisposeFixedAssets2_4.FA,
	DocumentDisposeFixedAssets2_4.RecordedAsReceivedTangibleAssets,
	DocumentDisposeFixedAssets2_4.PointInTime,
    EDStates.EDIState,
    EDStates.StatusPresentation	
FROM
	Document.DisposeFixedAssets2_4 AS DocumentDisposeFixedAssets2_4
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentDisposeFixedAssets2_4.Ref)
</queryText>
      <mainTable>Document.DisposeFixedAssets2_4</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>FA.ResidualValueMan</dataPath>
        <field>FA.ResidualValueMan</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DateOfDeduction</dataPath>
        <field>DateOfDeduction</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DeletionMark</dataPath>
        <field>DeletionMark</field>
