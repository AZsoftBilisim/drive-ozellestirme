      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ContactPerson</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentRequest.Ref AS Ref,
	DocumentRequest.DeletionMark AS DeletionMark,
	DocumentRequest.Number AS Number,
	DocumentRequest.Date AS Date,
	DocumentRequest.Posted AS Posted,
	DocumentRequest.Counterparty AS Counterparty,
	DocumentRequest.Terms AS Terms,
	DocumentRequest.Warehouse AS Warehouse,
	DocumentRequest.Currency AS Currency,
	DocumentRequest.Status AS Status,
	DocumentRequest.DocumentAmount AS DocumentAmount,
	DocumentRequest.ReplacementAmount AS ReplacementAmount,
	DocumentRequest.RequestedDeliveryDate AS RequestedDeliveryDate,
	DocumentRequest.DateOfShipment AS DateOfShipment,
	DocumentRequest.AmountPrepaymentBeforeGoodsIssue AS AmountPrepaymentBeforeGoodsIssue,
	DocumentRequest.AmountOfPrepaymentBeforeShipment AS AmountOfPrepaymentBeforeShipment,
	CASE
		WHEN NOT DocumentRequest.Posted
			THEN VALUE(Enum.StatesOfRequestsForReturnOfGoodsFromCustomers.EmptyRef)
		ELSE ISNULL(SalesOrderStates.State, VALUE(Enum.StatesOfRequestsForReturnOfGoodsFromCustomers.Executed))
	END AS State,
	CASE
		WHEN NOT DocumentRequest.Posted
			THEN FALSE
		WHEN SalesOrderStates.EventDate &lt;> DATETIME(1, 1, 1)
				AND &amp;UpdateDate > SalesOrderStates.EventDate
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CASE
		WHEN DocumentRequest.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentRequest.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	ISNULL(SalesOrderStates.PayAmount, 0) AS PayAmount,
	ISNULL(SalesOrderStates.PayPercentage, 0) AS PayPercentage,
	ISNULL(SalesOrderStates.AmountByShipment, 0) AS AmountByShipment,
	ISNULL(SalesOrderStates.OrderShipmentPercentage, 0) AS OrderShipmentPercentage,
	CASE
		WHEN ISNULL(SalesOrderStates.AmountOfDebt, 0) &lt; 0
			THEN ISNULL(SalesOrderStates.AmountOfDebt, 0)
		ELSE 0
	END AS AccountsPayableOfCompany,
	CASE
		WHEN ISNULL(SalesOrderStates.AmountOfDebt, 0) > 0
			THEN ISNULL(SalesOrderStates.AmountOfDebt, 0)
		ELSE 0
	END AS CustomerAccountsReceivable,
	ISNULL(SalesOrderStates.EventDate, DATETIME(1, 1, 1)) AS EventDate,
	ISNULL(SalesOrderStates.DebtPercentage, 0) AS DebtPercentage,
	DocumentRequest.ContactPerson
FROM
	Document.RequestForReturnOfGoodsFromCustomer AS DocumentRequest
		LEFT JOIN InformationRegister.SalesOrderStates AS SalesOrderStates
		ON (SalesOrderStates.OrderDocument = DocumentRequest.Ref)
		INNER JOIN Catalog.TermsOfSale AS TermsOfSale
		ON DocumentRequest.Terms = TermsOfSale.Ref
WHERE
	DocumentRequest.Partner = &amp;Partner
	AND DocumentRequest.Posted
	AND TermsOfSale.AvailableToExternalUsers</queryText>
      <mainTable>Document.RequestForReturnOfGoodsFromCustomer</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
