    <name>ToSetTheStatusToRejected</name>
    <title>
      <key>en</key>
      <value>Rejected</value>
    </title>
    <title>
      <key>fa</key>
      <value>ردشده</value>
    </title>
    <title>
      <key>it</key>
      <value>Respinta</value>
    </title>
    <title>
      <key>pl</key>
      <value>Odrzucona</value>
