    <attributes uuid="7203d8e4-4027-4e0a-81c0-3fd4ac1221a7">
      <name>Count</name>
      <synonym>
        <key>en</key>
        <value>Quantity</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>مقدار</value>
      </synonym>
