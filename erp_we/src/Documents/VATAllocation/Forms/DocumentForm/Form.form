        <items xsi:type="form:FormGroup">
          <name>GroupApplicationOfThe5PercentMarginRule</name>
          <id>174</id>
          <items xsi:type="form:FormGroup">
            <name>GroupApplicationOfThe5PercentRule</name>
            <id>162</id>
            <items xsi:type="form:FormGroup">
              <name>GroupExpensesForActivitiesNotSubjectToVAT</name>
              <id>179</id>
              <items xsi:type="form:FormField">
                <name>ApplicationOfThe5PercentRule</name>
                <id>176</id>
                <visible>true</visible>
                <enabled>true</enabled>
                <userVisible>
                  <common>true</common>
                </userVisible>
                <dataPath xsi:type="form:DataPath">
                  <segments>ApplicationOfThe5PercentRule</segments>
                </dataPath>
                <titleLocation>None</titleLocation>
                <handlers>
                  <event>OnChange</event>
                  <name>ApplicationOfThe5PercentRuleOnChange</name>
                </handlers>
                <extendedTooltip>
                  <name>ApplicationOfThe5PercentRuleExtendedTooltip</name>
                  <id>178</id>
                  <type>Label</type>
                  <autoMaxWidth>true</autoMaxWidth>
                  <autoMaxHeight>true</autoMaxHeight>
                  <extInfo xsi:type="form:LabelDecorationExtInfo">
                    <horizontalAlign>Left</horizontalAlign>
                  </extInfo>
                </extendedTooltip>
                <contextMenu>
                  <name>ApplicationOfThe5PercentRuleContextMenu</name>
                  <id>177</id>
                  <autoFill>true</autoFill>
                </contextMenu>
                <type>RadioButtonField</type>
                <editMode>Enter</editMode>
                <showInHeader>true</showInHeader>
                <headerHorizontalAlign>Left</headerHorizontalAlign>
                <showInFooter>true</showInFooter>
                <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
                  <columnsCount>1</columnsCount>
                  <choiceList>
                    <presentation>
                      <key>en</key>
                      <value>exceed 5% of total expenses, allocate VAT between activity types</value>
                    </presentation>
                    <presentation>
                      <key>fa</key>
                      <value>بیش از 5 درصد کل هزینه‌ها است، مالیات بر ارزش افزوده بین انواع فعالیت تسهیم شود</value>
                    </presentation>
                    <presentation>
                      <key>it</key>
                      <value>superano il 5% delle spese totali, eseguire la distribuzione dell'IVA tra i tipi di  attività</value>
                    </presentation>
                    <presentation>
                      <key>pl</key>
                      <value>przekraczają 5% od całkowitych rozchodów, wykonać podział VAT między rodzajami działalności</value>
                    </presentation>
                    <presentation>
                      <key>ru</key>
                      <value>превышают 5% от общих расходов, выполнить распределение НДС между видами деятельности</value>
                    </presentation>
                    <presentation>
                      <key>tr</key>
                      <value>toplam giderlerin yüzde 5'ini aşıyor, KDV vergilendirmesi arasında dağıtımı gerçekleştir</value>
                    </presentation>
                    <presentation>
                      <key>vi</key>
                      <value>vượt quá 5% tổng số chi phí, thực hiện phân bổ thuế GTGT giữa các dạng hoạt động</value>
                    </presentation>
                    <value xsi:type="core:NumberValue">
                      <value>0</value>
                    </value>
                  </choiceList>
                  <choiceList>
                    <presentation>
                      <key>en</key>
                      <value>do not exceed 5% from total expenses, accept the whole VAT for deduction</value>
                    </presentation>
                    <presentation>
                      <key>fa</key>
