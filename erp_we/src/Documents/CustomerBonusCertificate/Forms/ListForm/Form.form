    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CustomerBonusCertificate.Ref,
	CustomerBonusCertificate.DeletionMark,
	CustomerBonusCertificate.Number,
	CustomerBonusCertificate.Date,
	CustomerBonusCertificate.Posted,
	CustomerBonusCertificate.Status,
	CustomerBonusCertificate.AccountingRecognitionDate,
	CustomerBonusCertificate.Organization,
	CustomerBonusCertificate.Counterparty,
	CustomerBonusCertificate.Partner,
	CustomerBonusCertificate.Contract,
	CustomerBonusCertificate.DocumentCurrency,
	CustomerBonusCertificate.ARAPCurrency,
	CustomerBonusCertificate.CourseNumerator,
	CustomerBonusCertificate.CourseDenominator,
	CustomerBonusCertificate.BonusAmount,
	CustomerBonusCertificate.AmountARAP,
	CustomerBonusCertificate.ExpenseItemAssets,
	CustomerBonusCertificate.DimensionOfExpenses,
	CustomerBonusCertificate.AssetsLiabilitiesDimension,
	CustomerBonusCertificate.Department,
	CustomerBonusCertificate.FinancialAccountingGroup,
	CustomerBonusCertificate.ARAPObject,
	CustomerBonusCertificate.BusinessOperation,
	CustomerBonusCertificate.EmployeeResponsible,
	CustomerBonusCertificate.Comment,
	CustomerBonusCertificate.DocumentID,
	CustomerBonusCertificate.GLAccountSettings,
	CustomerBonusCertificate.LineOfBusiness,
	CustomerBonusCertificate.Rebates.*,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
{SELECT
	HasFiles}
FROM
	Document.CustomerBonusCertificate AS CustomerBonusCertificate
		{LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON CustomerBonusCertificate.Ref = FilesExist.ObjectWithFiles}</queryText>
      <mainTable>Document.CustomerBonusCertificate</mainTable>
