    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>OkClose</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
  </formCommands>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
