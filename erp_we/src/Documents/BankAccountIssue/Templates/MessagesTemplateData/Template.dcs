				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnerName_</dataPath>
			<field>PartnerName_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Beneficiary name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نام ذی‌نفع</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Nome del beneficiario</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Nazwa odbiorcy</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование получателя</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Alıcı Adı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tên người nhận</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	BankAccountIssue.Number,
	BankAccountIssue.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	BankAccountIssue.Currency,
	BankAccountIssue.BankAccount,
	BankAccountIssue.CounterpartyBankAccount,
	BankAccountIssue.DocumentAmount,
	BankAccountIssue.PaymentPurposes,
	BankAccountIssue.PaymentKind
FROM
	Document.BankAccountIssue AS BankAccountIssue
		{LEFT JOIN Catalog.Partners AS Partners
		ON BankAccountIssue.Counterparty.Partner = Partners.Ref}
WHERE
	BankAccountIssue.Ref = &amp;BankAccountIssue</query>
	</dataSet>
