			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chi tiền từ tài khoản ngân hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.BankAccountIssue</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
