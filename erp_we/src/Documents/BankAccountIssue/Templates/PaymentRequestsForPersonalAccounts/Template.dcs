		<field xsi:type="DataSetFieldField">
			<dataPath>CounterpartyBankAccount</dataPath>
			<field>CounterpartyBankAccount</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	CounterpartyBankAccounts.Bank AS Bank,
	PaymentRequest.Currency AS Currency
INTO BanksOfApplicationsByCurrency
FROM
	Document.PaymentRequest AS PaymentRequest
		INNER JOIN Document.PaymentRequest.PersonalAccountsOfStaff AS PaymentRequestPersonalAccountsOfStaff
			INNER JOIN Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
			ON PaymentRequestPersonalAccountsOfStaff.PersonalAccount = CounterpartyBankAccounts.Ref
		ON PaymentRequest.Ref = PaymentRequestPersonalAccountsOfStaff.Ref
WHERE
	PaymentRequest.Ref IN(&amp;ArrayOfRequests)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BanksOfApplicationsByCurrency.Bank AS Bank,
	BanksOfApplicationsByCurrency.Currency AS Currency,
	BankAccountIssue.CounterpartyBankAccount AS CounterpartyBankAccount,
	BankAccountIssue.Date AS Date,
	BankAccountIssue.Posted AS Posted,
	BankAccountIssue.DeletionMark AS DeletionMark
INTO WriteOffsToBankAccounts
FROM
	Document.BankAccountIssue AS BankAccountIssue
		INNER JOIN Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
			INNER JOIN BanksOfApplicationsByCurrency AS BanksOfApplicationsByCurrency
			ON CounterpartyBankAccounts.Bank = BanksOfApplicationsByCurrency.Bank
				AND CounterpartyBankAccounts.CashCurrency = BanksOfApplicationsByCurrency.Currency
		ON BankAccountIssue.CounterpartyBankAccount = CounterpartyBankAccounts.Ref
WHERE
	BankAccountIssue.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
	AND CounterpartyBankAccounts.Owner REFS Catalog.Counterparties
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	WriteOffsToBankAccounts.Bank AS Bank,
	WriteOffsToBankAccounts.Currency AS Currency,
	WriteOffsToBankAccounts.CounterpartyBankAccount AS CounterpartyBankAccount,
	MAX(WriteOffsToBankAccounts.Date) AS Date,
	1 AS Priority
INTO PrioritiesOfStatistics
FROM
	WriteOffsToBankAccounts AS WriteOffsToBankAccounts
WHERE
	WriteOffsToBankAccounts.Posted

GROUP BY
	WriteOffsToBankAccounts.Bank,
	WriteOffsToBankAccounts.Currency,
	WriteOffsToBankAccounts.CounterpartyBankAccount

UNION ALL

SELECT
	WriteOffsToBankAccounts.Bank,
	WriteOffsToBankAccounts.Currency,
	WriteOffsToBankAccounts.CounterpartyBankAccount,
	MAX(WriteOffsToBankAccounts.Date),
	2
FROM
	WriteOffsToBankAccounts AS WriteOffsToBankAccounts
WHERE
	NOT WriteOffsToBankAccounts.DeletionMark
	AND NOT WriteOffsToBankAccounts.Posted

GROUP BY
	WriteOffsToBankAccounts.Bank,
	WriteOffsToBankAccounts.Currency,
	WriteOffsToBankAccounts.CounterpartyBankAccount
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PrioritiesOfStatistics.Bank AS Bank,
	PrioritiesOfStatistics.Currency AS Currency,
	PrioritiesOfStatistics.CounterpartyBankAccount AS CounterpartyBankAccount
FROM
	(SELECT
		PrioritiesOfStatistics.Bank AS Bank,
		PrioritiesOfStatistics.Currency AS Currency,
		PrioritiesOfStatistics.Priority AS Priority,
		MAX(PrioritiesOfStatistics.Date) AS Date
	FROM
		(SELECT
			PrioritiesOfStatistics.Bank AS Bank,
			PrioritiesOfStatistics.Currency AS Currency,
			MIN(PrioritiesOfStatistics.Priority) AS Priority
		FROM
			PrioritiesOfStatistics AS PrioritiesOfStatistics
		
		GROUP BY
			PrioritiesOfStatistics.Bank,
			PrioritiesOfStatistics.Currency) AS NestedQuery
			INNER JOIN PrioritiesOfStatistics AS PrioritiesOfStatistics
			ON NestedQuery.Bank = PrioritiesOfStatistics.Bank
				AND NestedQuery.Currency = PrioritiesOfStatistics.Currency
				AND NestedQuery.Priority = PrioritiesOfStatistics.Priority
	
	GROUP BY
		PrioritiesOfStatistics.Bank,
		PrioritiesOfStatistics.Currency,
		PrioritiesOfStatistics.Priority) AS NestedQuery
		INNER JOIN PrioritiesOfStatistics AS PrioritiesOfStatistics
		ON NestedQuery.Bank = PrioritiesOfStatistics.Bank
			AND NestedQuery.Currency = PrioritiesOfStatistics.Currency
			AND NestedQuery.Priority = PrioritiesOfStatistics.Priority
			AND NestedQuery.Date = PrioritiesOfStatistics.Date</query>
	</dataSet>
