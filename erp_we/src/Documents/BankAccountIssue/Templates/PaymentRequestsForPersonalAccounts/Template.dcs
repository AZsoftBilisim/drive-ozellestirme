			<field>CashFlowItem</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PaymentRequest.Ref AS Request,
	PaymentRequest.CounterpartyBankAccount AS CounterpartyBankAccount,
	PaymentRequest.Currency AS Currency
INTO PaymentRequests
FROM
	Document.PaymentRequest AS PaymentRequest
WHERE
	PaymentRequest.Ref IN (&amp;ArrayOfRequests)
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	PaymentRequestPersonalAccountsOfStaff.Individual AS Individual,
	CounterpartyBankAccounts.Bank AS Bank,
	PaymentRequestPersonalAccountsOfStaff.Sum AS Sum,
	PaymentRequest.Currency AS Currency,
	PaymentRequestPersonalAccountsOfStaff.PersonalAccount AS PersonalAccount,
	PaymentRequest.Request AS Request,
	PaymentRequest.CounterpartyBankAccount AS CounterpartyBankAccount,
	PaymentRequestPersonalAccountsOfStaff.CashFlowItem AS CashFlowItem
INTO PaymentRequestsForPersonalAccounts
FROM
	PaymentRequests AS PaymentRequest
		INNER JOIN Document.PaymentRequest.PersonalAccountsOfStaff AS
			PaymentRequestPersonalAccountsOfStaff
		ON PaymentRequest.Request = PaymentRequestPersonalAccountsOfStaff.Ref
		INNER JOIN Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
		ON (PaymentRequestPersonalAccountsOfStaff.PersonalAccount = CounterpartyBankAccounts.Ref)
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	BankAccountIssueARAPDetails.PaymentRequest AS Request,
	BankAccountIssue.AdvanceHolder AS AdvanceHolder,
	BankAccountIssue.DocumentAmount AS AmountCredited,
	BankAccountIssue.Currency AS Currency,
	CASE
		WHEN CounterpartyBankAccounts.Owner = BankAccountIssue.AdvanceHolder
			THEN BankAccountIssue.CounterpartyBankAccount
		ELSE NULL
	END AS PersonalAccount,
	BankAccountIssue.CounterpartyBankAccount AS BankAccount,
	BankAccountIssueARAPDetails.CashFlowItem AS CashFlowItem
INTO WriteOffsOfNonCashFunds
FROM
	Document.BankAccountIssue AS BankAccountIssue
		INNER JOIN Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
		ON BankAccountIssue.CounterpartyBankAccount = CounterpartyBankAccounts.Ref
		INNER JOIN Document.BankAccountIssue.ARAPDetails AS
			BankAccountIssueARAPDetails
			INNER JOIN PaymentRequests AS PaymentRequests
			ON BankAccountIssueARAPDetails.PaymentRequest = PaymentRequests.Request
		ON BankAccountIssue.Ref = BankAccountIssueARAPDetails.Ref
WHERE
	BankAccountIssue.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
	AND BankAccountIssue.Posted
	AND NOT BankAccountIssue.PersonsList

UNION ALL

SELECT
	BankAccountIssueARAPDetails.PaymentRequest,
	BankAccountIssuePersonalAccountsOfStaff.Individual,
	BankAccountIssuePersonalAccountsOfStaff.Sum,
	BankAccountIssue.Currency,
	BankAccountIssuePersonalAccountsOfStaff.PersonalAccount,
	BankAccountIssue.CounterpartyBankAccount,
	BankAccountIssuePersonalAccountsOfStaff.CashFlowItem
FROM
	Document.BankAccountIssue AS BankAccountIssue
		INNER JOIN Document.BankAccountIssue.ARAPDetails AS
			BankAccountIssueARAPDetails
		ON BankAccountIssue.Ref = BankAccountIssueARAPDetails.Ref
		INNER JOIN PaymentRequests AS PaymentRequests
		ON BankAccountIssueARAPDetails.PaymentRequest = PaymentRequests.Request
		INNER JOIN Document.BankAccountIssue.PersonalAccountsOfStaff AS
			BankAccountIssuePersonalAccountsOfStaff
		ON BankAccountIssue.Ref = BankAccountIssuePersonalAccountsOfStaff.Ref
WHERE
	BankAccountIssue.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
	AND BankAccountIssue.Posted
	AND BankAccountIssue.PersonsList
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	WriteOffsOfNonCashFunds.Request AS Request,
	WriteOffsOfNonCashFunds.AdvanceHolder AS AdvanceHolder,
	SUM(WriteOffsOfNonCashFunds.AmountCredited) AS AmountCredited,
	WriteOffsOfNonCashFunds.Currency AS Currency,
	WriteOffsOfNonCashFunds.PersonalAccount AS PersonalAccount,
	WriteOffsOfNonCashFunds.BankAccount AS BankAccount,
	WriteOffsOfNonCashFunds.CashFlowItem AS CashFlowItem
INTO WriteOffsOfFundsOnApplications
FROM
	WriteOffsOfNonCashFunds AS WriteOffsOfNonCashFunds
GROUP BY
	WriteOffsOfNonCashFunds.Request,
	WriteOffsOfNonCashFunds.AdvanceHolder,
	WriteOffsOfNonCashFunds.Currency,
	WriteOffsOfNonCashFunds.PersonalAccount,
	WriteOffsOfNonCashFunds.BankAccount,
	WriteOffsOfNonCashFunds.CashFlowItem
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	WriteOffsOfFundsOnApplications.Request AS Request,
	WriteOffsOfFundsOnApplications.AdvanceHolder AS AdvanceHolder,
	SUM(WriteOffsOfFundsOnApplications.AmountCredited) AS AmountCredited,
	WriteOffsOfFundsOnApplications.Currency AS Currency,
	WriteOffsOfFundsOnApplications.PersonalAccount AS PersonalAccount,
	MAX(WriteOffsOfFundsOnApplications.BankAccount) AS BankAccount,
	WriteOffsOfFundsOnApplications.CashFlowItem AS CashFlowItem
INTO TableOfWriteOffsOnPersonalAccounts
FROM
	WriteOffsOfFundsOnApplications AS WriteOffsOfFundsOnApplications
WHERE
	NOT WriteOffsOfFundsOnApplications.PersonalAccount IS NULL
GROUP BY
	WriteOffsOfFundsOnApplications.Request,
	WriteOffsOfFundsOnApplications.AdvanceHolder,
	WriteOffsOfFundsOnApplications.Currency,
	WriteOffsOfFundsOnApplications.PersonalAccount,
	WriteOffsOfFundsOnApplications.CashFlowItem
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	WriteOffsOfFundsOnApplications.Request AS Request,
	WriteOffsOfFundsOnApplications.AdvanceHolder AS AdvanceHolder,
	SUM(WriteOffsOfFundsOnApplications.AmountCredited) AS AmountCredited,
	WriteOffsOfFundsOnApplications.Currency AS Currency,
	MAX(WriteOffsOfFundsOnApplications.BankAccount) AS BankAccount,
	WriteOffsOfFundsOnApplications.CashFlowItem AS CashFlowItem
INTO TableOfDebitsWithoutPersonalAccount
FROM
	WriteOffsOfFundsOnApplications AS WriteOffsOfFundsOnApplications
WHERE
	WriteOffsOfFundsOnApplications.PersonalAccount IS NULL
GROUP BY
	WriteOffsOfFundsOnApplications.Request,
	WriteOffsOfFundsOnApplications.AdvanceHolder,
	WriteOffsOfFundsOnApplications.Currency,
	WriteOffsOfFundsOnApplications.CashFlowItem
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	PaymentRequestsForPersonalAccounts.Individual AS Individual,
	PaymentRequestsForPersonalAccounts.Bank AS Bank,
	PaymentRequestsForPersonalAccounts.Sum AS Sum,
	PaymentRequestsForPersonalAccounts.Sum - TableOfWriteOffsOnPersonalAccounts.AmountCredited AS SumBalance,
	PaymentRequestsForPersonalAccounts.Currency AS Currency,
	PaymentRequestsForPersonalAccounts.PersonalAccount AS PersonalAccount,
	PaymentRequestsForPersonalAccounts.Request AS Request,
	TableOfWriteOffsOnPersonalAccounts.BankAccount AS BankAccount,
	PaymentRequestsForPersonalAccounts.CashFlowItem AS CashFlowItem
INTO PaymentByPersonalAccount
FROM
	PaymentRequestsForPersonalAccounts AS PaymentRequestsForPersonalAccounts
		INNER JOIN TableOfWriteOffsOnPersonalAccounts AS TableOfWriteOffsOnPersonalAccounts
		ON PaymentRequestsForPersonalAccounts.Request = TableOfWriteOffsOnPersonalAccounts.Request
		AND PaymentRequestsForPersonalAccounts.Individual = TableOfWriteOffsOnPersonalAccounts.AdvanceHolder
		AND PaymentRequestsForPersonalAccounts.PersonalAccount = TableOfWriteOffsOnPersonalAccounts.PersonalAccount
		AND PaymentRequestsForPersonalAccounts.CashFlowItem = TableOfWriteOffsOnPersonalAccounts.CashFlowItem
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	PaymentByPersonalAccount.Individual AS Individual,
	PaymentByPersonalAccount.Bank AS Bank,
	PaymentByPersonalAccount.Sum AS Sum,
	PaymentByPersonalAccount.SumBalance AS SumBalance,
	PaymentByPersonalAccount.Currency AS Currency,
	PaymentByPersonalAccount.PersonalAccount AS PersonalAccount,
	PaymentByPersonalAccount.Request AS Request,
	PaymentByPersonalAccount.BankAccount AS BankAccount,
	PaymentByPersonalAccount.CashFlowItem AS CashFlowItem
INTO ApplicationsForDistribution
FROM
	PaymentByPersonalAccount AS PaymentByPersonalAccount
WHERE
	PaymentByPersonalAccount.SumBalance &lt;&gt; 0

UNION ALL

SELECT
	PaymentRequestsForPersonalAccounts.Individual,
	PaymentRequestsForPersonalAccounts.Bank,
	PaymentRequestsForPersonalAccounts.Sum,
	PaymentRequestsForPersonalAccounts.Sum,
	PaymentRequestsForPersonalAccounts.Currency,
	PaymentRequestsForPersonalAccounts.PersonalAccount,
	PaymentRequestsForPersonalAccounts.Request,
	PaymentRequestsForPersonalAccounts.CounterpartyBankAccount,
	PaymentRequestsForPersonalAccounts.CashFlowItem
FROM
	PaymentRequestsForPersonalAccounts AS PaymentRequestsForPersonalAccounts
WHERE
	NOT (PaymentRequestsForPersonalAccounts.Individual, PaymentRequestsForPersonalAccounts.PersonalAccount,
		PaymentRequestsForPersonalAccounts.Request, PaymentRequestsForPersonalAccounts.CashFlowItem) IN
		(SELECT
			PaymentByPersonalAccount.Individual AS Individual,
			PaymentByPersonalAccount.PersonalAccount AS PersonalAccount,
			PaymentByPersonalAccount.Request AS Request,
			PaymentByPersonalAccount.CashFlowItem AS CashFlowItem
		FROM
			PaymentByPersonalAccount AS PaymentByPersonalAccount)
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	ApplicationsForDistributionWithCumulativeTotal.Individual AS Individual,
	ApplicationsForDistributionWithCumulativeTotal.Bank AS Bank,
	ApplicationsForDistributionWithCumulativeTotal.Sum AS Sum,
	ApplicationsForDistributionWithCumulativeTotal.SumBalance - CASE
		WHEN
			ApplicationsForDistributionWithCumulativeTotal.AmountBalanceWithCumulativeTotal &lt;= ISNULL(TableOfDebitsWithoutPersonalAccount.AmountCredited,
			0)
			THEN ApplicationsForDistributionWithCumulativeTotal.SumBalance
		WHEN ApplicationsForDistributionWithCumulativeTotal.SumBalance + ISNULL(TableOfDebitsWithoutPersonalAccount.AmountCredited,
			0) - ApplicationsForDistributionWithCumulativeTotal.AmountBalanceWithCumulativeTotal &lt; 0
			THEN 0
		ELSE ApplicationsForDistributionWithCumulativeTotal.SumBalance + ISNULL(TableOfDebitsWithoutPersonalAccount.AmountCredited,
			0) - ApplicationsForDistributionWithCumulativeTotal.AmountBalanceWithCumulativeTotal
	END AS SumBalance,
	ApplicationsForDistributionWithCumulativeTotal.Currency AS Currency,
	ApplicationsForDistributionWithCumulativeTotal.PersonalAccount AS PersonalAccount,
	ApplicationsForDistributionWithCumulativeTotal.Request AS Request,
	ISNULL(TableOfDebitsWithoutPersonalAccount.BankAccount, ApplicationsForDistributionWithCumulativeTotal.BankAccount) AS
		BankAccount,
	ApplicationsForDistributionWithCumulativeTotal.CashFlowItem AS CashFlowItem
INTO PaymentWithoutPersonalAccount
FROM
	(SELECT
		ApplicationsForDistribution.Individual AS Individual,
		ApplicationsForDistribution.Bank AS Bank,
		ApplicationsForDistribution.Sum AS Sum,
		ApplicationsForDistribution.SumBalance AS SumBalance,
		ApplicationsForDistribution.Currency AS Currency,
		ApplicationsForDistribution.PersonalAccount AS PersonalAccount,
		ApplicationsForDistribution.Request AS Request,
		ApplicationsForDistribution.BankAccount AS BankAccount,
		ApplicationsForDistribution.CashFlowItem AS CashFlowItem,
		SUM(ApplicationsForDistributionIncrease.SumBalance) AS AmountBalanceWithCumulativeTotal
	FROM
		ApplicationsForDistribution AS ApplicationsForDistribution
			LEFT JOIN ApplicationsForDistribution AS ApplicationsForDistributionIncrease
			ON ApplicationsForDistribution.Individual = ApplicationsForDistributionIncrease.Individual
			AND ApplicationsForDistribution.Request = ApplicationsForDistributionIncrease.Request
			AND ApplicationsForDistribution.CashFlowItem = ApplicationsForDistributionIncrease.CashFlowItem
			AND ApplicationsForDistribution.PersonalAccount &lt;= ApplicationsForDistributionIncrease.PersonalAccount
	GROUP BY
		ApplicationsForDistribution.Individual,
		ApplicationsForDistribution.Bank,
		ApplicationsForDistribution.Sum,
		ApplicationsForDistribution.SumBalance,
		ApplicationsForDistribution.Currency,
		ApplicationsForDistribution.PersonalAccount,
		ApplicationsForDistribution.Request,
		ApplicationsForDistribution.BankAccount,
		ApplicationsForDistribution.CashFlowItem) AS ApplicationsForDistributionWithCumulativeTotal
		LEFT JOIN TableOfDebitsWithoutPersonalAccount AS TableOfDebitsWithoutPersonalAccount
		ON ApplicationsForDistributionWithCumulativeTotal.Individual = TableOfDebitsWithoutPersonalAccount.AdvanceHolder
		AND ApplicationsForDistributionWithCumulativeTotal.Request = TableOfDebitsWithoutPersonalAccount.Request
		AND ApplicationsForDistributionWithCumulativeTotal.Currency = TableOfDebitsWithoutPersonalAccount.Currency
		AND ApplicationsForDistributionWithCumulativeTotal.CashFlowItem = TableOfDebitsWithoutPersonalAccount.CashFlowItem
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	NestedQuery.Request AS Request,
	CompaniesBankAccounts.Bank AS Bank,
	ScheduleOfPayments.BankAccountCashAccount AS CompanyBankAccount,
	SUM(ScheduleOfPayments.Sum) AS Sum
INTO ScheduleOfPayments
FROM
	(SELECT DISTINCT
		PaymentRequestsForPersonalAccounts.Request AS Request
	FROM
		PaymentRequestsForPersonalAccounts AS PaymentRequestsForPersonalAccounts) AS NestedQuery
		INNER JOIN InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
			INNER JOIN Catalog.CompaniesBankAccounts AS CompaniesBankAccounts
			ON ScheduleOfPayments.BankAccountCashAccount = CompaniesBankAccounts.Ref
		ON NestedQuery.Request = ScheduleOfPayments.PaymentObject
WHERE
	ScheduleOfPayments.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
	AND ScheduleOfPayments.BankAccountCashAccount REFS Catalog.CompaniesBankAccounts
GROUP BY
	ScheduleOfPayments.BankAccountCashAccount,
	CompaniesBankAccounts.Bank,
	NestedQuery.Request
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	FALSE AS Mark,
	NestedQuery.Individual AS Individual,
	NestedQuery.Bank AS Bank,
	NestedQuery.Sum AS SumByDocument,
	NestedQuery.SumBalance AS SumBalance,
	NestedQuery.SumBalance AS Sum,
	NestedQuery.Currency AS Currency,
	NestedQuery.PersonalAccount AS PersonalAccount,
	NestedQuery.Request AS Request,
	CASE
		WHEN NestedQuery.Bank &lt;&gt; NestedQuery.BankAccount.Bank
			THEN VALUE(Catalog.CounterpartyBankAccounts.EmptyRef)
		ELSE NestedQuery.BankAccount
	END AS BankAccount,
	ISNULL(ScheduleOfPayments.CompanyBankAccount, CASE
		WHEN &amp;ByRegistry = 0
			THEN NestedQuery.Request.BankAccount
		WHEN &amp;ByRegistry = 1
			AND NestedQuery.Bank = NestedQuery.Request.BankAccount.Bank
			THEN NestedQuery.Request.BankAccount
		ELSE VALUE(Catalog.CompaniesBankAccounts.EmptyRef)
	END) AS CompanyBankAccount,
	ISNULL(ScheduleOfPayments.Sum, 0) AS AmountBalanceOnSchedule,
	NestedQuery.CashFlowItem AS CashFlowItem
FROM
	(SELECT
		NestedQuery.Individual AS Individual,
		NestedQuery.Bank AS Bank,
		NestedQuery.Sum AS Sum,
		SUM(NestedQuery.SumBalance) AS SumBalance,
		NestedQuery.Currency AS Currency,
		NestedQuery.PersonalAccount AS PersonalAccount,
		NestedQuery.Request AS Request,
		MAX(NestedQuery.BankAccount) AS BankAccount,
		NestedQuery.CashFlowItem AS CashFlowItem
	FROM
		(SELECT
			PaymentByPersonalAccount.Individual AS Individual,
			PaymentByPersonalAccount.Bank AS Bank,
			PaymentByPersonalAccount.Sum AS Sum,
			0 AS SumBalance,
			PaymentByPersonalAccount.Currency AS Currency,
			PaymentByPersonalAccount.PersonalAccount AS PersonalAccount,
			PaymentByPersonalAccount.Request AS Request,
			PaymentByPersonalAccount.BankAccount AS BankAccount,
			PaymentByPersonalAccount.CashFlowItem AS CashFlowItem
		FROM
			PaymentByPersonalAccount AS PaymentByPersonalAccount

		UNION ALL

		SELECT
			PaymentWithoutPersonalAccount.Individual,
			PaymentWithoutPersonalAccount.Bank,
			PaymentWithoutPersonalAccount.Sum,
			PaymentWithoutPersonalAccount.SumBalance,
			PaymentWithoutPersonalAccount.Currency,
			PaymentWithoutPersonalAccount.PersonalAccount,
			PaymentWithoutPersonalAccount.Request,
			PaymentWithoutPersonalAccount.BankAccount,
			PaymentWithoutPersonalAccount.CashFlowItem
		FROM
			PaymentWithoutPersonalAccount AS PaymentWithoutPersonalAccount) AS NestedQuery
	GROUP BY
		NestedQuery.Request,
		NestedQuery.Individual,
		NestedQuery.PersonalAccount,
		NestedQuery.Bank,
		NestedQuery.Sum,
		NestedQuery.Currency,
		NestedQuery.CashFlowItem) AS NestedQuery
		LEFT JOIN ScheduleOfPayments AS ScheduleOfPayments
		ON NestedQuery.Request = ScheduleOfPayments.Request
		AND NestedQuery.Bank = ScheduleOfPayments.Bank
;

////////////////////////////////////////////////////////////////////////////////
 DROP PaymentRequests
;

////////////////////////////////////////////////////////////////////////////////
DROP PaymentRequestsForPersonalAccounts
;

////////////////////////////////////////////////////////////////////////////////
DROP WriteOffsOfNonCashFunds
;

////////////////////////////////////////////////////////////////////////////////
DROP WriteOffsOfFundsOnApplications
;

