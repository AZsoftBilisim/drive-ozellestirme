    </title>
    <title>
      <key>tr</key>
      <value>Vardiya raporları</value>
    </title>
    <title>
      <key>vi</key>
      <value>Bảng kê bán hàng trong ca</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfReportsPerShift.Document</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfReportsPerShift.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ListOfReportsPerShift.VATTaxation</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CASE
		WHEN RetailSalesReport.Posted
			THEN 0
		WHEN RetailSalesReport.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	RetailSalesReport.Ref AS Document,
	RetailSalesReport.Ref AS Ref,	
	RetailSalesReport.VATTaxation AS VATTaxation,
	RetailSalesReport.CashRegisterShift AS CashRegisterShift
FROM
	Document.RetailSalesReport AS RetailSalesReport

UNION ALL

SELECT
	CASE
		WHEN RetailReturnsReport.Posted
			THEN 0
		WHEN RetailReturnsReport.DeletionMark
			THEN 1
		ELSE 2
	END,
	RetailReturnsReport.Ref,
	RetailReturnsReport.Ref,	
	RetailReturnsReport.VATTaxation,
	RetailReturnsReport.CashRegisterShift
FROM
	Document.RetailReturnsReport AS RetailReturnsReport</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
