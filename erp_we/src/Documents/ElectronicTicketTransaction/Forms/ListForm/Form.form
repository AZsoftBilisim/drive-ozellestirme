  <excludedCommands>Create</excludedCommands>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThisIsElectronicTicket</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentData.ServiceType AS ServiceType,
	CASE
		WHEN DocumentData.OperationType = VALUE(Enum.TypesOfTicketOperations.EmptyRef)
			THEN &amp;DocumentTypeElectronicTicket
		ELSE DocumentData.OperationType
	END AS DocumentType,
	DocumentData.OperationType = VALUE(Enum.TypesOfTicketOperations.EmptyRef) AS ThisIsElectronicTicket,
	DocumentData.TicketNumber AS TicketNumber,
	DocumentData.Number AS Number,
	DocumentData.Date AS Date,
	DocumentData.Employee AS Employee,
	CASE
		WHEN DocumentData.OperationType = VALUE(Enum.TypesOfTicketOperations.EmptyRef)
			THEN DocumentData.PassengerSFullName
		ELSE InformationAboutElectronicTicket.PassengerSFullName
	END AS PassengerSFullName,
	DocumentData.DocumentAmount AS Sum,
	DocumentData.Currency AS Currency,
	DocumentData.PostingDate AS PostingDate,
	DocumentData.TripDetails AS TripDetails,
	DocumentData.DocumentBasis AS Request,
	DocumentData.BusinessOperation AS BusinessOperation,
	DocumentData.Department AS Department,
	DocumentData.Organization AS Organization,
	DocumentData.Ref AS Ref
FROM
	Document.ElectronicTicketTransaction AS DocumentData
		LEFT JOIN Document.ElectronicTicketTransaction AS InformationAboutElectronicTicket
		ON DocumentData.ElectronicTicket = InformationAboutElectronicTicket.Ref
WHERE
	NOT DocumentData.DeleteBookingType = VALUE(Enum.DeleteBookingTypes.Booking)</queryText>
      <mainTable>Document.ElectronicTicketTransaction</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
