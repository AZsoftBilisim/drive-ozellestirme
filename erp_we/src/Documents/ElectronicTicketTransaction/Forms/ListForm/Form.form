      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>DocumentType</dataPath>
        <field>DocumentType</field>
        <title>
          <localValue>
            <content>
              <key>en</key>
              <value>Document type</value>
            </content>
            <content>
              <key>fa</key>
              <value>نوع سند</value>
            </content>
            <content>
              <key>it</key>
              <value>Tipo di documento</value>
            </content>
            <content>
              <key>pl</key>
              <value>Typ dokumentu</value>
