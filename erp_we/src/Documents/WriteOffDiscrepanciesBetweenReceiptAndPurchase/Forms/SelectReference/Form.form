  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>List</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco</value>
    </title>
    <title>
