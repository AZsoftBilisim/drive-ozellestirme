    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Contract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Counterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Date</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Number</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Partner</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Terms</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ThisIsWarehouseGroup</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ValueType</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.VendorPriceKind</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CounterpartyContracts.Ref AS Ref,
	CounterpartyContracts.Date AS Date,
	CounterpartyContracts.Number AS Number,
	CounterpartyContracts.Description AS Description,
	CounterpartyContracts.Partner AS Partner,
	CounterpartyContracts.Counterparty AS Counterparty,
	&amp;Terms AS Terms,
	CASE
		WHEN CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit)
		WHEN CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt)
			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)
		WHEN CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit)
		WHEN CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)
		ELSE VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit)
	END AS BusinessOperation,
	CounterpartyContracts.Organization AS Organization,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	FALSE AS ThisIsWarehouseGroup,
	CounterpartyContracts.GoodsReceiptOption AS GoodsReceiptOption,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	VALUE(Catalog.Currencies.EmptyRef) AS VendorPriceKind,
	CounterpartyContracts.DeletionMark AS DeletionMark
INTO FilterByContracts
FROM
	Catalog.CounterpartyContracts AS CounterpartyContracts
WHERE
	(CounterpartyContracts.Ref = &amp;Contract
			OR &amp;Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
	AND CounterpartyContracts.BusinessOperation IN(&amp;BusinessOperationsOfTheContract)
	AND (CounterpartyContracts.Partner = &amp;Partner
			OR &amp;Partner = VALUE(Catalog.Partners.EmptyRef))
	AND (CounterpartyContracts.Organization = &amp;Organization
			OR &amp;Organization = VALUE(Catalog.Companies.EmptyRef))
	AND (CounterpartyContracts.Counterparty = &amp;Counterparty
			OR &amp;Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TermsOfPurchaseFromVendors.Ref AS Ref,
	TermsOfPurchaseFromVendors.Date AS Date,
	TermsOfPurchaseFromVendors.Number AS Number,
	TermsOfPurchaseFromVendors.Description AS Description,	
	TermsOfPurchaseFromVendors.Partner AS Partner,
	TermsOfPurchaseFromVendors.Counterparty AS Counterparty,
	VALUE(Enum.BusinessTransactions.WriteOffDiscrepanciesBetweenReceiptAndPurchase) AS BusinessOperation,
	TermsOfPurchaseFromVendors.Organization AS Organization,
	TermsOfPurchaseFromVendors.Warehouse AS Warehouse,
	ISNULL(TermsOfPurchaseFromVendors.Warehouse.IsFolder, FALSE) AS ThisIsWarehouseGroup,
	TermsOfPurchaseFromVendors.GoodsReceiptOption AS GoodsReceiptOption,
	TermsOfPurchaseFromVendors.Currency AS Currency,
	TermsOfPurchaseFromVendors.VendorPriceKind AS VendorPriceKind,
	TermsOfPurchaseFromVendors.DeletionMark AS DeletionMark
INTO FilterByAgreements
FROM
	Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
WHERE
	(TermsOfPurchaseFromVendors.Ref = &amp;Terms
			OR &amp;Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))
	AND TermsOfPurchaseFromVendors.BusinessOperation IN(&amp;BusinessOperationsAgreements)
	AND (TermsOfPurchaseFromVendors.Partner = &amp;Partner
			OR &amp;Partner = VALUE(Catalog.Partners.EmptyRef))
	AND (TermsOfPurchaseFromVendors.Organization = &amp;Organization
			OR &amp;Organization = VALUE(Catalog.Companies.EmptyRef)
			OR TermsOfPurchaseFromVendors.Organization = VALUE(Catalog.Companies.EmptyRef))
	AND (TermsOfPurchaseFromVendors.Counterparty = &amp;Counterparty
			OR &amp;Counterparty = VALUE(Catalog.Counterparties.EmptyRef)
			OR TermsOfPurchaseFromVendors.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	AND (TermsOfPurchaseFromVendors.Warehouse IN(&amp;Warehouses)
			OR TermsOfPurchaseFromVendors.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
			OR &amp;WithoutSelectionByWarehouse)
	AND TermsOfPurchaseFromVendors.ContractsAreUsed
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	VALUETYPE(PurchaseOrder.Ref) AS ValueType,
	PurchaseOrder.Ref AS Ref,
	PurchaseOrder.Number AS Number,
	PurchaseOrder.Date AS Date,
	PurchaseOrder.Partner AS Partner,
	PurchaseOrder.Counterparty AS Counterparty,
	PurchaseOrder.Terms AS Terms, CASE
		WHEN PurchaseOrder.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit)
		WHEN PurchaseOrder.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt)
			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)
		WHEN PurchaseOrder.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit)
		WHEN PurchaseOrder.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)
		WHEN PurchaseOrder.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit)
		ELSE PurchaseOrder.BusinessOperation 
	END AS BusinessOperation,
	PurchaseOrder.Organization AS Organization,
	PurchaseOrder.Contract AS Contract,
	PurchaseOrder.Warehouse AS Warehouse,
	PurchaseOrder.Warehouse.IsFolder AS ThisIsWarehouseGroup,
	PurchaseOrder.Currency AS Currency,
	ISNULL(PurchaseOrder.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef)) AS VendorPriceKind
FROM
	Document.PurchaseOrder AS PurchaseOrder
WHERE
	PurchaseOrder.Posted
	AND PurchaseOrder.Contract IN
			(SELECT
				FilterByContracts.Ref
			FROM
				FilterByContracts
			WHERE
				NOT FilterByContracts.GoodsReceiptOption IN (&amp;ContractAcceptanceOptions))
	AND (PurchaseOrder.Terms IN
				(SELECT
					FilterByAgreements.Ref
				FROM
					FilterByAgreements AS FilterByAgreements
				WHERE
					FilterByAgreements.GoodsReceiptOption IN (&amp;OrderAcceptanceOptions))
		OR PurchaseOrder.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
			AND PurchaseOrder.GoodsReceiptOption IN (&amp;OrderAcceptanceOptions, &amp;OptionsForAcceptanceUnderTheContractOnTheOrder))
	AND (PurchaseOrder.Warehouse IN(&amp;Warehouses)
		OR &amp;WithoutSelectionByWarehouse)
	AND PurchaseOrder.Warehouse &lt;> VALUE(Catalog.Warehouses.EmptyRef)
	AND PurchaseOrder.BusinessOperation IN(&amp;BusinessOperationsOfTheContract)

UNION ALL

SELECT
	VALUETYPE(VendorInvoice.Ref),
	VendorInvoice.Ref,
	VendorInvoice.Number,
	VendorInvoice.Date,
	VendorInvoice.Partner,
	VendorInvoice.Counterparty,
	VendorInvoice.Terms,
	CASE
		WHEN VendorInvoice.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit)
		WHEN VendorInvoice.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt)
			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)
		WHEN VendorInvoice.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit)
		WHEN VendorInvoice.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)
		WHEN VendorInvoice.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportGoodsInTransit)
			THEN VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit)
		ELSE VendorInvoice.BusinessOperation
	END AS BusinessOperation,
	VendorInvoice.Organization,
	VendorInvoice.Contract,
	VendorInvoice.Warehouse,
	VendorInvoice.Warehouse.IsFolder,
	VendorInvoice.Currency,
	ISNULL(VendorInvoice.Terms.VendorPriceKind, VALUE(Catalog.VendorPriceTypes.EmptyRef))
FROM
	Document.VendorInvoice AS VendorInvoice
WHERE
	VendorInvoice.Posted
	AND VendorInvoice.Contract IN
			(SELECT
				FilterByContracts.Ref
			FROM
				FilterByContracts
			WHERE
				NOT FilterByContracts.GoodsReceiptOption IN (&amp;ContractAcceptanceOptions))
	AND (VendorInvoice.ReceiptUnderOrders
			AND (VendorInvoice.Terms IN
					(SELECT
						FilterByAgreements.Ref
					FROM
						FilterByAgreements AS FilterByAgreements
					WHERE
						FilterByAgreements.GoodsReceiptOption IN (&amp;OptionsForAcceptanceByInvoiceByOrder))
			OR VendorInvoice.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
				AND &amp;ConstantAcceptanceOption IN (&amp;OptionsForAcceptanceByInvoiceByOrder))
		OR (NOT VendorInvoice.ReceiptUnderOrders
			AND (VendorInvoice.Terms IN
					(SELECT
						FilterByAgreements.Ref
					FROM
						FilterByAgreements AS FilterByAgreements
					WHERE
						FilterByAgreements.GoodsReceiptOption IN (&amp;AcceptanceOptionsForInvoiceWithoutOrder))
			OR VendorInvoice.Terms = VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))))
	AND (VendorInvoice.Warehouse IN (&amp;Warehouses)
		OR &amp;WithoutSelectionByWarehouse)
	AND VendorInvoice.Warehouse &lt;> VALUE(Catalog.Warehouses.EmptyRef)
	AND VendorInvoice.BusinessOperation IN(&amp;BusinessOperationsOfTheContract)

UNION ALL

SELECT
	TermsOfPurchaseFromVendors.Description,
	TermsOfPurchaseFromVendors.Ref,
	TermsOfPurchaseFromVendors.Number,
	TermsOfPurchaseFromVendors.Date,
	TermsOfPurchaseFromVendors.Partner,
	TermsOfPurchaseFromVendors.Counterparty,
	TermsOfPurchaseFromVendors.Ref,
	TermsOfPurchaseFromVendors.BusinessOperation,
	TermsOfPurchaseFromVendors.Organization,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	TermsOfPurchaseFromVendors.Warehouse,
	TermsOfPurchaseFromVendors.Warehouse.IsFolder,
	TermsOfPurchaseFromVendors.Currency,
	TermsOfPurchaseFromVendors.VendorPriceKind
FROM
	FilterByAgreements AS TermsOfPurchaseFromVendors
WHERE
	TermsOfPurchaseFromVendors.GoodsReceiptOption IN(&amp;AcceptanceOptionsUnderTheAgreement)
	AND NOT TermsOfPurchaseFromVendors.DeletionMark

UNION ALL

SELECT
	ReceiptUnderContracts.Description,
	ReceiptUnderContracts.Ref,
	ReceiptUnderContracts.Number,
	ReceiptUnderContracts.Date,
	ReceiptUnderContracts.Partner,
	ReceiptUnderContracts.Counterparty,
	CASE
		WHEN (ISNULL(TermsOfPurchaseFromVendors.BusinessOperation, UNDEFINED) = VALUE(Enum.BusinessTransactions.PurchaseFromSupplier)
					AND (ReceiptUnderContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit)
						OR ReceiptUnderContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)))
				OR (ISNULL(TermsOfPurchaseFromVendors.Ref, UNDEFINED) = VALUE(Enum.BusinessTransactions.ImportFromEAEU)
					AND (ReceiptUnderContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit)
						OR ReceiptUnderContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)))
				OR (ISNULL(TermsOfPurchaseFromVendors.Ref, UNDEFINED) = VALUE(Enum.BusinessTransactions.PurchaseByImport)
					AND ReceiptUnderContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit))
			THEN ReceiptUnderContracts.Terms
		ELSE VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)
	END AS Terms,
	ReceiptUnderContracts.BusinessOperation,
	ReceiptUnderContracts.Organization,
	ReceiptUnderContracts.Ref,
	ReceiptUnderContracts.Warehouse,
	ReceiptUnderContracts.Warehouse.IsFolder,
	ReceiptUnderContracts.Currency,
	ReceiptUnderContracts.VendorPriceKind
FROM
	FilterByContracts AS ReceiptUnderContracts
		LEFT JOIN Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
		ON ReceiptUnderContracts.Terms = TermsOfPurchaseFromVendors.Ref
WHERE
	ReceiptUnderContracts.GoodsReceiptOption IN(&amp;ContractAcceptanceOptions)
	AND NOT ReceiptUnderContracts.DeletionMark</queryText>
