  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Request.Ref,
	Request.Number,
	Request.Date,
	Request.Organization,
	Request.DocumentAmount,
	Request.Currency,
	
	CASE WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.CashDepositToBankAccount)
		OR Request.BusinessOperation = VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount)
	THEN
		Request.CashAccount
	ELSE
		Request.BankAccount
	END AS BankAccountCashAccount,
	
	CASE WHEN Request.BusinessOperation = VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount)
		OR Request.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromBank)
	THEN
		Request.CashAccountRecipient
	ELSE
		Request.BankAccountBeneficiary
	END AS BankAccountCashRegisterRecipient,
	
	Request.Status,
	Request.BusinessOperation
FROM
	Document.CashTransferReferenceOrder AS Request</queryText>
      <mainTable>Document.CashTransferReferenceOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
