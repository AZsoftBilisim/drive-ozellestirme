  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentData.Ref,
	DocumentData.Number,
	DocumentData.Date,
	DocumentData.Organization,
	DocumentData.DocumentAmount,
	DocumentData.Currency,
	CASE
		WHEN DocumentData.BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashDepositToBankAccount),
			VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.CashCollectionToBank)
			)
			THEN DocumentData.CashAccount
		ELSE DocumentData.BankAccount
	END AS BankAccountCashAccount,
	CASE
		WHEN DocumentData.BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromBank),
			VALUE(Enum.BusinessTransactions.WithdrawalFromBankAccount)
			)
			THEN DocumentData.CashAccountRecipient
		ELSE DocumentData.BankAccountBeneficiary
	END AS BankAccountCashRegisterRecipient,
	DocumentData.Status,
	DocumentData.BusinessOperation,
	CASE
		WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
				AND DocumentData.Posted
				AND (NOT DocumentData.Status = VALUE(Enum.CashTransferOrderStatuses.TurnDown))
			THEN TRUE
		ELSE FALSE
	END AS OrderPaidFor,
	DocumentData.Author,
	DocumentData.PaymentDate
FROM
	Document.CashTransferReferenceOrder AS DocumentData
		LEFT JOIN AccumulationRegister.CashToBePaid.Balance AS Cash
		ON (Cash.PaymentRequest = DocumentData.Ref)</queryText>
      <mainTable>Document.CashTransferReferenceOrder</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>BankAccount</dataPath>
        <field>BankAccount</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Department</dataPath>
        <field>Department</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>BankAccountBeneficiary</dataPath>
        <field>BankAccountBeneficiary</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CashAccountRecipient</dataPath>
        <field>CashAccountRecipient</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CashAccount</dataPath>
        <field>CashAccount</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Date</dataPath>
        <field>Date</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>WhoDecided</dataPath>
        <field>WhoDecided</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>CashFlowItem</dataPath>
        <field>CashFlowItem</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Author</dataPath>
        <field>Author</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Organization</dataPath>
        <field>Organization</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>PaymentPurposes</dataPath>
        <field>PaymentPurposes</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Comment</dataPath>
        <field>Comment</field>
      </fields>
