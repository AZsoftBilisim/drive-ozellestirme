		<field xsi:type="DataSetFieldField">
			<dataPath>Ref</dataPath>
			<field>Ref</field>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:DocumentRef.Trip</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Trip.Ref AS Ref
{SELECT
	Ref.*}
FROM
	Document.Trip AS Trip
{WHERE
	Trip.Ref.*}</query>
	</dataSet>
