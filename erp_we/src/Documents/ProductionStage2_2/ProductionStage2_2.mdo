    <attributes uuid="d5ce4b26-96a2-4be8-9677-3c0856667ac0">
      <name>BatchesIndicationStatusSender</name>
      <synonym>
        <key>en</key>
        <value>Batch specification status sender</value>
      </synonym>
      <synonym>
        <key>fa</key>
        <value>وضعیت تعیین بچ فرستنده</value>
      </synonym>
      <synonym>
        <key>it</key>
        <value>Stato dell'indicazione delle serie mittente</value>
      </synonym>
      <synonym>
        <key>pl</key>
        <value>Status wskazania serii nadawca</value>
      </synonym>
      <synonym>
        <key>ru</key>
        <value>Статус указания серий отправитель</value>
      </synonym>
      <synonym>
        <key>tr</key>
        <value>Parti belirtme durumu gönderici</value>
      </synonym>
      <synonym>
        <key>vi</key>
