    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.WorkPlanning</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.YouNeedToAssignOperations</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.YouNeedToPlanASchedule</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	StagesOverridable.Status AS Status,
	&amp;PresentationStage AS PresentationStage,
	StagesOverridable.ReferenceOrder AS ReferenceOrder,
	StagesOverridable.ReferenceOrder.Department AS ProductionDispatcherBusinessUnit,
	StagesOverridable.StageName AS StageName,
	StagesOverridable.ProductionByThirdParty AS ProductionByThirdParty,
	StagesOverridable.WorkPlanning AS WorkPlanning,
	StagesOverridable.Department AS Department,
	StagesOverridable.BillOfMaterials AS BillOfMaterials,
	StagesOverridable.ProductionLot AS ProductionLot,
	StagesOverridable.ProductionProcessType AS ProductionProcessType,
	StagesOverridable.NextStageNo AS NextStageNo,
	
	FALSE AS YouNeedToPlanASchedule,
	
	-1 AS StatusOfConstraintsInTheGraph,
	&amp;EmptyLinkStatus AS StageState,
	
	&amp;EmptyLinkOperationStatus AS OperationStatus,
	-1 AS OperationStatusCode,
	FALSE AS ItIsRequiredToPopulateByOperationsManually,
	FALSE AS YouNeedToAssignOperations,
	
	FALSE AS TheScheduleIsCalculated,
	FALSE AS Overdue,
	DATETIME(1,1,1) AS EventDate,
	DATETIME(1,1,1) AS StartDate,
	DATETIME(1,1,1) AS CompletedOn,
	DATETIME(1,1,1) AS ProductionDate,
	0 AS Delay,
	FALSE AS ThereIsABacklogFromTheSchedule,
	
	-1 AS StartDateImageIndex,
	-1 AS EndDateImageIndex,
	
	&amp;EmptyLinkToStateOfSoftware AS SupplyState,
	FALSE                              AS PendingSupply,
	
	FALSE AS DynamicStructure,
	
	FALSE AS UseOperationManagement,
	FALSE AS UseManufacturingExecutionSystem,
	FALSE AS UseShiftTasks,
	&amp;TechnologicalProcess AS TechnologicalProcess,
	&amp;TechnologicalProcessPresentation AS TechnologicalProcessPresentation,
	
	VALUE(Catalog.Products.EmptyRef) AS MainProduct,
	0 AS CountPlan,
	0 AS CountReal,
	0 AS CountCanceled,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS QuantityUnit,
	
	0 AS BalanceOfLaborInput,
	0 AS ProgressPercent,
	
	StagesOverridable.Ref AS Ref
FROM
