	|	TabularSection.ToControlQuality                    AS ToControlQuality,
	|	TabularSection.QualityConfirmationDate                    AS QualityConfirmationDate,
	|	TabularSection.BatchesIndicationStatus                          AS BatchesIndicationStatus,
	|	TabularSection.BatchesIndicationStatusSender               AS BatchesIndicationStatusSender,
	|	TabularSection.Series                                        AS Series,
	|	CASE
	|		WHEN TabularSection.BatchesIndicationStatusSender = 14
	|			THEN TabularSection.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END                                                       AS BatchSenderOverride,
	|	CASE
	|		WHEN TabularSection.BatchesIndicationStatusRecipient = 14
	|			THEN TabularSection.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END                                                       AS BatchRecipientOverride,
	|	TabularSection.ProductionDate                             AS ProductionDate,
	|	TabularSection.Recipient                                   AS Recipient,
	|	CAST(TabularSection.Recipient AS Catalog.Warehouses).UseWarehouseManagemantSystemForGoodsReceipt
	|                                                               AS RecipientUseAdvancedWarehousingWhenReceiving,
	|	CAST(TabularSection.Recipient AS Catalog.Warehouses).StartDateOfWarehouseManagemantSystemForGoodsReceipt
	|                                                               AS RecipientDateOfStartUsingAdvancedWarehousing,
	|	CAST(TabularSection.Recipient AS Catalog.Warehouses).ShopFloorStockroom
	|                                                               AS RecipientWorkshopStoreroom,
	|	CAST(TabularSection.Recipient AS Catalog.Warehouses).Department
	|                                                               AS RecipientDivision,
	|	TabularSection.Department                                AS Department,
	|	CASE
	|		WHEN TabularSection.ToExpenseAs
	|			THEN CASE
	|					WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|						THEN TabularSection.Department
	|					ELSE TabularSection.Recipient
	|				END
	|		ELSE TabularSection.Recipient
	|	END                                                       AS WarehouseRedefinition,
	|	CASE
	|		WHEN TabularSection.ProductionDate <> DATETIME(1,1,1)
	|			THEN TabularSection.ProductionDate
	|					
	|			ELSE CASE
	|					WHEN NOT ProductionSchedule.Stage IS NULL
	|						AND (TabularSection.Ref.Status = VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion)
	|							OR TabularSection.Ref.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1)
	|								AND TabularSection.Ref.DynamicStructure)
	|						THEN
	|							BEGINOFPERIOD(ProductionSchedule.Ending, DAY)
	|					ELSE DATETIME(1,1,1)
	|				END
	|	END                                                       AS DateOfReceiptOverride,
	|	CASE
	|		WHEN TabularSection.ProductionDate <> DATETIME(1,1,1)
	|			THEN TRUE
	|		ELSE NOT ProductionSchedule.Stage IS NULL
	|				AND (TabularSection.Ref.Status = VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion)
	|					OR TabularSection.Ref.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1)
	|						AND TabularSection.Ref.DynamicStructure)
	|	END                                                       AS AvailableForExpenseOverride,
	|	TabularSection.ToExpenseAs                             AS ToExpenseAs,
	|	TabularSection.ExpenseItem                               AS ExpenseItem,
	|	TabularSection.DimensionOfExpenses                            AS DimensionOfExpenses,
	|	TabularSection.AssetsLiabilitiesDimension                     AS AssetsLiabilitiesDimension,
	|	TabularSection.StageConsumer                              AS StageConsumer,
	|	TabularSection.ProcessByBOM                     AS ProcessByBOM,
	|	TabularSection.Manufactured                                  AS Manufactured,
	|	TabularSection.GLAccountSettings                         AS GLAccountSettings,
	|	TabularSection.KeyProducts                             AS KeyProducts,
	|	TabularSection.Canceled                                     AS Canceled,
	|	TabularSection.CancellationReason                                AS CancellationReason,
	|	TabularSection.RowID                          AS RowID,
	|	TabularSection.Count                                   AS Count,
	|	TabularSection.Sum                                        AS Sum
	|INTO DocumentDataTableOutputFinishedProducts
	|FROM
	|	Document.ProductionStage2_2.ManufacturedProducts AS TabularSection
	|
	|		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionSchedule
	|		ON ProductionSchedule.ProductionOrder = TabularSection.Ref.ReferenceOrder
	|		 AND ProductionSchedule.ScheduleStatus = &WorkingSchedule
	|		 AND ProductionSchedule.Stage = TabularSection.Ref
	|		 AND &TheProductionScheduleIsPlanned
	|
	|WHERE
	|	TabularSection.Ref IN (&Ref)
	|
	|INDEX BY
	|	Ref";
	
	QueryTexts.Add(QueryText, TableName);
	
	Return QueryText;
	
EndFunction

