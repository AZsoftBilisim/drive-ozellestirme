Function QueryTextTableOtherAssetsAndLiabilitiesRecords(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "OtherAssetsAndLiabilitiesRecords";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	If DocumentObject <> Undefined
	 And DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.Initiated
	 And DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.Completed Then
		
		Return "";
		
	EndIf;
	
	// The verification conditions must match the conditions in the write-off area of expensed assets_Write-offmaterialspun products and workspends
	If DocumentObject = Undefined
	 Or DocumentObject.ManufacturedProducts.Count() > 0
	   And DocumentObject.ManufacturedProducts.Find(True, "ToExpenseAs") <> Undefined
	 Or DocumentObject.SideAndIntermediateRelease.Count() > 0
	   And DocumentObject.SideAndIntermediateRelease.Find(True, "ToExpenseAs") <> Undefined
	 Or DocumentObject.UnusedMaterials.Count() > 0
	   And DocumentObject.UnusedMaterials.Find(True, "ToExpenseAs") <> Undefined Then
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"TTTypesOfStocks", QueryTexts, TempTablesManager) Then
		QueryTextTTTypesOfStocks(Query, QueryTexts, "InventoryCost", Undefined);
	EndIf;
	
	// Fields must be filled in in accordance with the request in the write-off area. Expendingactives_Write-offmaterialspun products and workspends
	QueryText =
	"SELECT
	|	TabularSection.DateOfTransaction                  AS Period,
	|	TabularSection.Organization                   AS Organization,
	|	TabularSection.Recipient                    AS Department,
	|	&LineOfBusiness                     AS LineOfBusiness,
	|	TabularSection.ExpenseItem                AS AssetRef,
	|	TabularSection.AssetsLiabilitiesDimension      AS Dimension,
	|	TabularSection.GLAccountSettings          AS GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
	|
	|	TabularSection.SumCompl                     AS SumCompl,
	|	TabularSection.SumMan                      AS SumMan,
	|	TabularSection.SumMan                      AS AmountIncludingVAT,
	|	TabularSection.SumMan                      AS AmountExcludingVAT,
	|
	|	TabularSection.FinRecordID AS FinRecordID,
	|	VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposes) AS BusinessTransactionSetting
	|FROM
	|	Document.ProductionStage2_2 AS DocumentTable
	|	INNER JOIN TTTypesOfStocks AS TabularSection
	|		ON TRUE		
	|WHERE
	|	DocumentTable.Ref IN (&Ref)
	|	AND TabularSection.ToExpenseAs
	|	AND TabularSection.ExpenseItem REFS ChartOfCharacteristicTypes.AssetLiabilityItems
	|	AND (TabularSection.SumMan <> 0 OR TabularSection.SumCompl <> 0)
	|";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
	Else
		Return "";
	EndIf;
	
EndFunction

Function QueryTextTableShipmentReferences(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "ShipmentAndReturnReferences";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	If DocumentObject <> Undefined
		And Not ((DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
				Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion
				Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
				Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
			And DocumentObject.ProductionByThirdParty
			And DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined,
		Undefined,
		Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
		"DocumentDataHeader",
		QueryTexts,
		TempTablesManager) Then
		
		QueryTextDocumentDataHeader(
			Query,
			QueryTexts,
			DocumentObject);
		
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
		"DocumentDataTableProvisionOfMaterialsAndWorks",
		QueryTexts,
		TempTablesManager) Then
		
		QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(
			Query,
			QueryTexts,
			DocumentObject);
		
	EndIf;
	
	QueryText =
	"SELECT
	|	TabularSection.LineNumber AS LineNumber,
	|	TabularSection.Ref                                AS Recorder,
	|	BEGINOFPERIOD(HeaderData_.Date, DAY)                AS Period,
	|	HeaderData_.SubcontractPurchaseOrderRedefinition        AS ReferenceOrder,
	|	TabularSection.Products                          AS Products,
	|	TabularSection.Characteristic                        AS Characteristic,
	|	TabularSection.Series                                 AS Series,
	|	TabularSection.RowCode                             AS RowCode,
	|	TabularSection.Warehouse                                 AS Warehouse,
	|	CASE
	|		WHEN TabularSection.Canceled
	|			THEN VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Canceled)
	|		ELSE VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
	|	END AS Factor,
	|	TabularSection.Count AS Count,
	|	CASE
	|		WHEN TabularSection.Canceled
	|			THEN TabularSection.CancellationReason
	|		ELSE UNDEFINED
	|	END AS CancellationReason
	|FROM
	|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|
	|WHERE
	|	HeaderData_.Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
	|		VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND HeaderData_.ProductionByThirdParty
	|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
	|	AND NOT TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.TransferedEarlier)
	|
	|UNION ALL
	|
	|SELECT
	|	TabularSection.LineNumber AS LineNumber,
	|	TabularSection.Ref                                AS Recorder,
	|	TabularSection.DateOfShipment                          AS Period,
	|	HeaderData_.SubcontractPurchaseOrderRedefinition        AS ReferenceOrder,
	|	TabularSection.Products                          AS Products,
	|	TabularSection.Characteristic                        AS Characteristic,
	|	TabularSection.Series                                 AS Series,
	|	TabularSection.RowCode                             AS RowCode,
	|	TabularSection.Warehouse                                 AS Warehouse,
	|	TableOfIndicators.Ref AS Factor,
	|	TabularSection.Count AS Count,
	|	VALUE(Catalog.ReasonsForSaleOrderCancellation.EmptyRef) AS CancellationReason
	|FROM
	|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	|		ON DocumentsRegistry.Ref = HeaderData_.SubcontractOrder
	|		AND NOT DocumentsRegistry.AdditionalRecord
	|		AND NOT HeaderData_.SubcontractOrder = UNDEFINED
	|		INNER JOIN Enum.IndicatorsOfShipmentAndReturnReferences AS TableOfIndicators
	|		ON TableOfIndicators.Ref IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister),
	|			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip))
	|
	|WHERE
	|	HeaderData_.Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
	|		VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND HeaderData_.ProductionByThirdParty
	|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
	|	AND NOT TabularSection.Canceled
	|	AND NOT TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|	AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|	AND ISNULL(DocumentsRegistry.Status, VALUE(Enum.TollingOrderStatuses.EmptyRef)) IN
	|		(VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|		VALUE(Enum.TollingOrderStatuses.Closed))
	|ORDER BY
	|	LineNumber,
	|	Factor";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTablePurchaseOrders(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "PurchaseOrders";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	ArrayOfRequestTexts = New Array;
	
	If DocumentObject = Undefined
	 Or DocumentObject.ProductionByThirdParty2_5
		 And DocumentObject.ManufacturedProducts.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
	
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// Output products (ordered, ready for registration)
		"SELECT
		|	TabularSection.Ref                         AS Recorder,
		|	VALUE(AccumulationRecordType.Receipt)        AS RecordType,
		|	HeaderData_.Date                              AS Period,
		|	HeaderData_.SubcontractPurchaseOrderRedefinition AS PurchaseOrder,
		|	TabularSection.Products                   AS Products,
		|	TabularSection.Characteristic                 AS Characteristic,
		|	TabularSection.RowCode                      AS RowCode,
		|	UNDEFINED                                  AS Warehouse,
		|	CASE
		|		WHEN NOT HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1)
		|			AND NOT TabularSection.Canceled
		|			THEN TabularSection.Count
		|		ELSE 0
		|	END                                         AS ToRegister,
		|	0                                             AS ToReceive,
		|	TabularSection.Count                     AS Ordered,
		|	0                                             AS Sum,
		|	UNDEFINED                                  AS CancellationReason
		|FROM
		|	DocumentDataTableOutputFinishedProducts AS TabularSection
		|		LEFT JOIN DocumentDataHeader AS HeaderData_
		|		ON TabularSection.Ref = HeaderData_.Ref
		|WHERE
		|	HeaderData_.ProductionByThirdParty2_5
		|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
		|
		|UNION ALL
		|
		// Output items (ordered, cancelled)
		|SELECT
		|	TabularSection.Ref                         AS Recorder,
		|	VALUE(AccumulationRecordType.Receipt)        AS RecordType,
		|	HeaderData_.Date                              AS Period,
		|	HeaderData_.SubcontractPurchaseOrderRedefinition AS PurchaseOrder,
		|	TabularSection.Products                   AS Products,
		|	TabularSection.Characteristic                 AS Characteristic,
		|	TabularSection.RowCode                      AS RowCode,
		|	UNDEFINED                                  AS Warehouse,
		|	0                                             AS ToRegister,
		|	0                                             AS ToReceive,
		|	-TabularSection.Count                    AS Ordered,
		|	0                                             AS Sum,
		|	TabularSection.CancellationReason                  AS CancellationReason
		|FROM
		|	DocumentDataTableOutputFinishedProducts AS TabularSection
		|		LEFT JOIN DocumentDataHeader AS HeaderData_
		|		ON TabularSection.Ref = HeaderData_.Ref
		|WHERE
		|	HeaderData_.ProductionByThirdParty2_5
		|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
		|	AND TabularSection.Canceled";
		
		ArrayOfRequestTexts.Add(QueryText);
		
		If DocumentObject = Undefined
		 Or Not DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
			 And Not DocumentObject.LeaveProductsAtSubcontractor
			 And DocumentObject.ManufacturedProducts.FindRows(
					New Structure("ToExpenseAs", False)).Count() > 0 Then
			
			QueryText =
			// Output products (to be received)
			"SELECT
			|	TabularSection.Ref                         AS Recorder,
			|	VALUE(AccumulationRecordType.Receipt)        AS RecordType,
			|	HeaderData_.Date                              AS Period,
			|	HeaderData_.SubcontractPurchaseOrderRedefinition AS PurchaseOrder,
			|	TabularSection.Products                   AS Products,
			|	TabularSection.Characteristic                 AS Characteristic,
			|	TabularSection.RowCode                      AS RowCode,
			|	TabularSection.Recipient                     AS Warehouse,
			|	0                                             AS ToRegister,
			|	TabularSection.Count                     AS ToReceive,
			|	0                                             AS Ordered,
			|	0                                             AS Sum,
			|	UNDEFINED                                  AS CancellationReason
			|FROM
			|	DocumentDataTableOutputFinishedProducts AS TabularSection
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	HeaderData_.ProductionByThirdParty2_5
			|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
			|	AND NOT TabularSection.Canceled
			|	AND NOT TabularSection.ToExpenseAs
			|	AND TabularSection.ProductsTypeOfProducts IN (
			|		VALUE(Enum.ItemsTypes.OwnGoods),
			|		VALUE(Enum.ItemsTypes.ReusablePackage))
			|	AND NOT HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1)
			|	AND NOT HeaderData_.LeaveProductsAtSubcontractor";
			
			ArrayOfRequestTexts.Add(QueryText);
			
		EndIf;
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or DocumentObject.ProductionByThirdParty2_5
		 And DocumentObject.SideAndIntermediateRelease.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
	
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// By-products (ordered, ready for registration)
		"SELECT
		|	TabularSection.Ref                         AS Recorder,
		|	VALUE(AccumulationRecordType.Receipt)        AS RecordType,
		|	HeaderData_.Date                              AS Period,
		|	HeaderData_.SubcontractPurchaseOrderRedefinition AS PurchaseOrder,
		|	TabularSection.Products                   AS Products,
		|	TabularSection.Characteristic                 AS Characteristic,
		|	TabularSection.RowCode                      AS RowCode,
		|	UNDEFINED                                  AS Warehouse,
		|	CASE
		|		WHEN NOT HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1)
		|			AND NOT TabularSection.Canceled
		|			THEN TabularSection.Count
		|		ELSE 0
		|	END                                         AS ToRegister,
		|	0                                             AS ToReceive,
		|	TabularSection.Count                     AS Ordered,
		|	0                                             AS Sum,
		|	UNDEFINED                                  AS CancellationReason
		|FROM
		|	DocumentDataTableOfByFinishedProducts AS TabularSection
		|		LEFT JOIN DocumentDataHeader AS HeaderData_
		|		ON TabularSection.Ref = HeaderData_.Ref
		|WHERE
		|	HeaderData_.ProductionByThirdParty2_5
		|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
		|
		|UNION ALL
		|
		// By-products (ordered, cancelled)
		|SELECT
		|	TabularSection.Ref                         AS Recorder,
		|	VALUE(AccumulationRecordType.Receipt)        AS RecordType,
		|	HeaderData_.Date                              AS Period,
		|	HeaderData_.SubcontractPurchaseOrderRedefinition AS PurchaseOrder,
		|	TabularSection.Products                   AS Products,
		|	TabularSection.Characteristic                 AS Characteristic,
		|	TabularSection.RowCode                      AS RowCode,
		|	UNDEFINED                                  AS Warehouse,
		|	0                                             AS ToRegister,
		|	0                                             AS ToReceive,
		|	-TabularSection.Count                    AS Ordered,
		|	0                                             AS Sum,
		|	TabularSection.CancellationReason                  AS CancellationReason
		|FROM
		|	DocumentDataTableOfByFinishedProducts AS TabularSection
		|		LEFT JOIN DocumentDataHeader AS HeaderData_
		|		ON TabularSection.Ref = HeaderData_.Ref
		|WHERE
		|	HeaderData_.ProductionByThirdParty2_5
		|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
		|	AND TabularSection.Canceled";
		
		ArrayOfRequestTexts.Add(QueryText);
		
		If DocumentObject = Undefined
		 Or Not DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
			 And Not DocumentObject.LeaveProductsAtSubcontractor
			 And DocumentObject.SideAndIntermediateRelease.FindRows(
					New Structure("ToExpenseAs", False)).Count() > 0 Then
			
			QueryText =
			// By-products (to be received)
			"SELECT
			|	TabularSection.Ref                         AS Recorder,
			|	VALUE(AccumulationRecordType.Receipt)        AS RecordType,
			|	HeaderData_.Date                              AS Period,
			|	HeaderData_.SubcontractPurchaseOrderRedefinition AS PurchaseOrder,
			|	TabularSection.Products                   AS Products,
			|	TabularSection.Characteristic                 AS Characteristic,
			|	TabularSection.RowCode                      AS RowCode,
			|	TabularSection.Recipient                     AS Warehouse,
			|	0                                             AS ToRegister,
			|	TabularSection.Count                     AS ToReceive,
			|	0                                             AS Ordered,
			|	0                                             AS Sum,
			|	UNDEFINED                                  AS CancellationReason
			|FROM
			|	DocumentDataTableOfByFinishedProducts AS TabularSection
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	HeaderData_.ProductionByThirdParty2_5
			|	AND NOT HeaderData_.SubcontractPurchaseOrderRedefinition = UNDEFINED
			|	AND NOT TabularSection.Canceled
			|	AND NOT TabularSection.ToExpenseAs
			|	AND TabularSection.ProductsTypeOfProducts IN (
			|		VALUE(Enum.ItemsTypes.OwnGoods),
			|		VALUE(Enum.ItemsTypes.ReusablePackage))
			|	AND NOT HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1)
			|	AND NOT HeaderData_.LeaveProductsAtSubcontractor";
			
			ArrayOfRequestTexts.Add(QueryText);
			
		EndIf;
		
	EndIf;
	
	
	If ArrayOfRequestTexts.Count() = 0 Then
		Return "";
	EndIf;
	
	QueryText = StrConcat(ArrayOfRequestTexts, TMCommonUse.QuerySeparatorInJoin());
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableRegisterRecordsProductsIncomeExpenses(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "RegisterRecordsProductsIncomeExpenses";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable("TTTypesOfStocks", QueryTexts, TempTablesManager) Then
		QueryTextTTTypesOfStocks(Query, QueryTexts, RegisterName, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"TTCurrencyConversionFactors", QueryTexts, TempTablesManager) Then
		QueryTextTTCurrencyConversionFactors(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText =
		"SELECT
		|	TabularSection.DateOfTransaction									AS Period,
		|	CASE
		|		WHEN VALUETYPE(TabularSection.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.ExpenseItems)
		|				AND TabularSection.ExpenseItem.CostAllocationOptionLocal =
		|						VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|			THEN CASE
		|					WHEN TabularSection.ExpenseItem.VATAssetTaxClass IN (
		|									VALUE(Enum.AssetKinds.FA),
		|									VALUE(Enum.AssetKinds.ConstructionInProgressObjects))
		|						THEN VALUE(Enum.BusinessTransactions.TransferToFixedAssets)
		|					WHEN TabularSection.ExpenseItem.VATAssetTaxClass = VALUE(Enum.AssetKinds.IA)
		|						THEN VALUE(Enum.BusinessTransactions.TransferToIntangibleAssetsAndRD)
		|				END
		|		WHEN VALUETYPE(TabularSection.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.ExpenseItems)
		|				AND TabularSection.ExpenseItem.CostAllocationOptionLocal =
		|						VALUE(Enum.CostAllocationOptions.OnOtherAssets)
		|			THEN VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		WHEN VALUETYPE(TabularSection.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
		|			THEN VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		ELSE
		|			VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)
		|	END										AS BusinessOperation,
		|	TabularSection.Organization					AS Organization,
		|	TabularSection.Recipient					AS Department,
		|	TabularSection.ItemsLocationAttributes	AS ItemsLocationAttributes,
		|	TabularSection.Department				AS Warehouse,
		|	TabularSection.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
		|	TabularSection.InventoryOwnerAttribute.InventoryType		AS InventoryType,
		|	TabularSection.ExpenseItem				AS IncomeAndExpenseItem,
		|	TabularSection.DimensionOfExpenses			AS DimensionOfExpenses,
		|	TabularSection.AssetsLiabilitiesDimension		AS AssetsLiabilitiesDimension,
		|	TabularSection.Count					AS Count,
		|	CAST(TabularSection.Sum * ISNULL(TTCurrencyConversionFactors.ConversionRateToManCurrency, 0)  AS NUMBER(31,2)) AS Cost,
		|	CAST(TabularSection.Sum * ISNULL(TTCurrencyConversionFactors.ConversionRateToManCurrency, 0)  AS NUMBER(31,2)) AS CostExcludingVAT,
		|	CAST(TabularSection.Sum * ISNULL(TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul, 0) AS NUMBER(31,2)) AS LocalCost,
		|	CASE
		|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
		|			THEN TabularSection.InventoryOwnerAttribute
		|		ELSE TabularSection.Products
		|	END																				AS SourceOfProductFinancialAccountingGroup
		|FROM
		|	TTTypesOfStocks AS TabularSection
		|
		|	LEFT JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
		|	ON BEGINOFPERIOD(TabularSection.DateOfTransaction, DAY) = TTCurrencyConversionFactors.Period
		|
		|WHERE
		|	TabularSection.ToExpenseAs
		|";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableRecordsProductsProducts(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "RecordsProductsProducts";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable("TTTypesOfStocks", QueryTexts, TempTablesManager) Then
		QueryTextTTTypesOfStocks(Query, QueryTexts, RegisterName, DocumentObject);
	EndIf;
	
	QueryText =
	"SELECT
	|	TabularSection.DateOfTransaction          AS Period,
	|	TabularSection.BusinessOperation AS BusinessOperation,
	|	CASE
	|		WHEN TabularSection.SaleOfAnotherCompanyInventory
	|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany
	|		ELSE TabularSection.Organization
	|	END                                AS Organization,
	|	&Department                       AS Department,
	|	TabularSection.ItemsLocationAttributes.Purpose.LineOfBusiness AS LineOfBusiness,
	|	CASE
	|		WHEN TTParametersOfBatchAccountingForConducting.KeepRecordsOfInventoryCostByAssignments
	|			THEN TabularSection.ItemsLocationAttributes
	|		ELSE TabularSection.AnalysisOfAccountingForProductsWithoutAssignment
	|	END                                AS ItemsLocationAttributes,
	|	TabularSection.ItemsLocationAttributes.StorageLocation AS Warehouse,
	|	CASE
	|		WHEN TabularSection.SaleOfAnotherCompanyInventory
	|			THEN TabularSection.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType
	|		ELSE TabularSection.InventoryOwnerAttribute.InventoryType
	|	END                                AS InventoryType,
	|	CASE
	|		WHEN TabularSection.SaleOfAnotherCompanyInventory
	|			THEN TabularSection.InventoryOwnerAttributeOfCompanyGoodsOwner
	|		ELSE TabularSection.InventoryOwnerAttribute
	|	END                                AS InventoryOwnerAttribute,
	|	TabularSection.CorItemsLocationAttributes.Purpose.LineOfBusiness AS CorLineOfBusiness,
	|	CASE
	|		WHEN TTParametersOfBatchAccountingForConducting.KeepRecordsOfInventoryCostByAssignments
	|			THEN TabularSection.CorItemsLocationAttributes
	|		ELSE TabularSection.CorAnalysisOfAccountingForProductsWithoutAssignment
	|	END                                AS CorItemsLocationAttributes,
	|	TabularSection.CorItemsLocationAttributes.StorageLocation AS CorWarehouseCorCommissionAgentCorBusinessUnit,
	|	CASE
	|		WHEN TabularSection.CorInventoryOwnerAttribute = UNDEFINED
	|			THEN TabularSection.InventoryOwnerAttribute.InventoryType
	|		ELSE TabularSection.CorInventoryOwnerAttribute.InventoryType
	|	END                                AS CorInventoryType,
	|	CASE
	|		WHEN TabularSection.CorInventoryOwnerAttribute = UNDEFINED
	|			THEN TabularSection.InventoryOwnerAttribute
	|		ELSE TabularSection.CorInventoryOwnerAttribute
	|	END                                AS CorInventoryOwnerAttribute,
	|
	|	TabularSection.Count            AS Count,
	|	TabularSection.Count            AS CorQuantity,
	|
	|	0                                    AS Cost,
	|	0                                    AS CostExcludingVAT,
	|	0                                    AS LocalCost,
	|
	|	CASE
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			THEN TabularSection.InventoryOwnerAttribute
	|		ELSE TabularSection.Products
	|	END                                AS SourceOfProductFinancialAccountingGroup,
	|	CASE
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			AND TabularSection.CorInventoryOwnerAttribute = UNDEFINED
	|			THEN TabularSection.InventoryOwnerAttribute
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			THEN TabularSection.CorInventoryOwnerAttribute
	|		ELSE TabularSection.Products
	|	END                                AS CorSourceOfItemsFinancialAccountingGroup,
	|	UNDEFINED                         AS DocumentRegisterRecords,
	|	UNDEFINED                         AS CorCompany
	|FROM
	|	TTTypesOfStocks AS TabularSection
	|	
	|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
	|	ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TabularSection.DateOfTransaction, MONTH)
	|		AND TTParametersOfBatchAccountingForConducting.Organization = TabularSection.Organization	
	|
	|WHERE
	|	NOT TabularSection.CorAccountingSection = UNDEFINED
	// We exclude movements in which the sender and recipient coincide
	|	AND (NOT TabularSection.AccountingSection = TabularSection.CorAccountingSection
	|		OR NOT TabularSection.InventoryOwnerAttribute = TabularSection.CorInventoryOwnerAttribute
	|		OR NOT (TTParametersOfBatchAccountingForConducting.KeepRecordsOfInventoryCostByAssignments
	|			AND TabularSection.ItemsLocationAttributes =
	|					TabularSection.CorItemsLocationAttributes)
	|		AND NOT (NOT TTParametersOfBatchAccountingForConducting.KeepRecordsOfInventoryCostByAssignments
	|			AND TabularSection.AnalysisOfAccountingForProductsWithoutAssignment =
	|					TabularSection.CorAnalysisOfAccountingForProductsWithoutAssignment)
	|	)
	|	AND NOT (TabularSection.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|		AND TabularSection.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock))
	|";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableDocumentsRegistry(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "DocumentsRegistry";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable("TTBases", QueryTexts, TempTablesManager) Then
		QueryTextTTBases(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataHeader", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText = 
	"SELECT
	|	&MetadataIdentifier                                  AS RefType,
	|	Departments.Organization                                 AS Organization,
	|	Departments.BusinessOperation                       AS BusinessOperation,
	|	TabularSection.Partner                                    AS Partner,
	|	UNDEFINED                                              AS Counterparty,
	|	TabularSection.ContractRedefinition                     AS Contract,
	|	TabularSection.LineOfBusiness                    AS LineOfBusiness,
	|	Departments.AdditionalRecord                        AS AdditionalRecord,
	|	Departments.Department                               AS Department,
	|	Departments.Department                               AS StorageLocation,
	|	Departments.Date                                        AS IBDocumentDate,
	|	TabularSection.Ref                                     AS Ref,
	|	TabularSection.OrderUniqueIdentifierString  AS RecordSeparator,
	|	TabularSection.Number                                      AS IBDocumentNumber,
	|	TabularSection.Status                                     AS Status,
	|	TabularSection.EmployeeResponsible                              AS EmployeeResponsible,
	|	CAST("""" AS STRING (100))                           AS More,
	|	CAST(TabularSection.Comment AS STRING (100))     AS Comment,
	|	TabularSection.Posted                                   AS Posted,
	|	TabularSection.DeletionMark                            AS DeletionMark,
	|	Departments.Date                                        AS SourceDocumentDate,
	|	TabularSection.NumberForPrinting                              AS SourceDocumentNumber,
	|	0                                                         AS Sum,
	|	TabularSection.Currency                                     AS Currency,
	|	FALSE                                                      AS ReverseTransactionCorrection,
	|	UNDEFINED                                              AS ReversedDocument,
	|	UNDEFINED                                              AS CorrectedDocument,
	|	Departments.Date                                        AS RecordingInAccountingDate,
	|	TabularSection.OrderPriorityOverride       AS Priority
	|FROM
	|	DocumentDataHeader AS TabularSection
	|	
	|	INNER JOIN TTBases AS Departments
	|	ON TabularSection.Ref = Departments.Ref
	|";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableProductionProcessSupply(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "ProductionProcessSupply";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	ArrayOfRequestTexts = New Array;
	
	If DocumentObject = Undefined
	 Or Not DocumentObject.DynamicStructure
		 And DocumentObject.ManufacturedProducts.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// Ensuring the need for production
		"SELECT
		|	TabularSection.Ref                  AS Recorder,
		|	HeaderData_.Date                       AS Period,
		|
		|	HeaderData_.ReferenceOrder               AS ReferenceOrder,
		|
		|	TabularSection.Products            AS Products,
		|	TabularSection.Characteristic          AS Characteristic,
		|
		|	HeaderData_.BillOfMaterials               AS BillOfMaterials,
		|
		|	TabularSection.Purpose              AS Purpose,
		|
		|	CASE
		|		WHEN HeaderData_.OrderAssignmentOfSemiFinishedProductsForPurposeOfStagesIsNotUsed
		|			THEN TabularSection.StageConsumer
		|		ELSE
		|			VALUE(Document.ProductionStage2_2.EmptyRef)
		|	END                                  AS Stage,
		|
		|	CASE WHEN TabularSection.ProductsTypeOfProducts IN (
		|			VALUE(Enum.ItemsTypes.OwnGoods),
		|			VALUE(Enum.ItemsTypes.ReusablePackage)) THEN
		|		TabularSection.Recipient
		|	ELSE
		|		VALUE(Catalog.Warehouses.EmptyRef)
		|	END AS Warehouse,
		|
		|	CASE 
		|		WHEN TabularSection.ToExpenseAs
		|			THEN CASE
		|					WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
		|						THEN TabularSection.Department
		|					ELSE TabularSection.Recipient
		|				  END
		|		WHEN TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
		|			THEN TabularSection.Recipient
		|	ELSE
		|		VALUE(Catalog.BusinessStructure.EmptyRef)
		|	END AS Department,
		|
		|	CASE
		|		WHEN HeaderData_.DynamicStructure
		|			THEN TabularSection.Ref
		|		ELSE
		|			VALUE(Document.ProductionStage2_2.EmptyRef)
		|	END AS ReleasingStage,
		|
		|   TabularSection.ToExpenseAs        AS ToExpenseAs,
		|	CASE
		|		WHEN TabularSection.ToExpenseAs
		|			THEN TabularSection.ExpenseItem
		|		ELSE UNDEFINED
		|	END                                  AS ExpenseItem,
		|	CASE
		|		WHEN TabularSection.ToExpenseAs
		|			THEN TabularSection.DimensionOfExpenses
		|		ELSE UNDEFINED
		|	END                                  AS DimensionOfExpenses,
		|	CASE
		|		WHEN TabularSection.ToExpenseAs
		|			THEN TabularSection.AssetsLiabilitiesDimension
		|		ELSE UNDEFINED
		|	END                                  AS AssetsLiabilitiesDimension,
		|
		|	0                                      AS Required2,
		|
