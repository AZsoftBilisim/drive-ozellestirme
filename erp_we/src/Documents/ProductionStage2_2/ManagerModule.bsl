Function CreateChainOfStages(SpecificationData)
	
	Result = New Array;
	
	HeaderAttributes = ProductionManagementServerCall.ValuesForFillingNewProductionStage(
		SpecificationData.ReferenceOrder,
		SpecificationData.AssignmentProducts,
		SpecificationData.ProductionLot,
		SpecificationData.ProductionProcessType,
		SpecificationData.BillOfMaterials);
	
	For IndexOf = 0 To SpecificationData.Stages.Count()-1 Do
		
		Data_Stage = SpecificationData.Stages[IndexOf];
				
		FillingData = New Structure;
		FillingData.Insert("HeaderAttributes", HeaderAttributes);
		FillingData.Insert("SpecificationData", SpecificationData);
		FillingData.Insert("Data_Stage", Data_Stage);
		
		DocumentObject = Documents.ProductionStage2_2.CreateDocument();
		DocumentObject.SetNewObjectRef(Data_Stage.ProductionStage);
		DocumentObject.SetBatchGenerationMode();
		DocumentObject.Fill(FillingData);
		
		SetPrivilegedMode(True);
		ConductWithDowngradedStatus(DocumentObject);
		SetPrivilegedMode(False);
		
		Result.Add(DocumentObject.Ref);
		
	EndDo;
	
	Return Result;
	
EndFunction

Function CreateChainOfStagesWhenDividing(BatchData, SpecificationData, BatchFinishedProducts, BatchSideAndIntermediateRelease, AdditionalAttributes, Parameters)
	
	If BatchData.DynamicStructure Then
		CopyLotReferenceLocationInOrderStructure(BatchData.ProductionLot, SpecificationData.ProductionLot);
	EndIf;
	
	References = New Array;
	
	HeaderAttributes = ProductionManagementServerCall.ValuesForFillingNewProductionStage(
		SpecificationData.ReferenceOrder,
		SpecificationData.AssignmentProducts,
		SpecificationData.ProductionLot,
		SpecificationData.ProductionProcessType,
		SpecificationData.BillOfMaterials);
	
	AttributesNames = StrSplit("Status,ProductionInOneDay,ProductionDate,ActualStageStart", ",");
	
	For IndexOf = 0 To SpecificationData.Stages.Count()-1 Do
		
		Data_Stage = SpecificationData.Stages[IndexOf];
				
		FillingData = New Structure;
		FillingData.Insert("HeaderAttributes", HeaderAttributes);
		FillingData.Insert("SpecificationData", SpecificationData);
		FillingData.Insert("Data_Stage", Data_Stage);
		FillingData.Insert("BatchFinishedProducts",
			BatchFinishedProducts.Copy(New Structure("Stage", Data_Stage.Stage)));
		FillingData.Insert("BatchSideAndIntermediateRelease",
			BatchSideAndIntermediateRelease.Copy(New Structure("Stage", Data_Stage.Stage)));
		
		DocumentObject = Documents.ProductionStage2_2.CreateDocument();
		DocumentObject.SetNewObjectRef(Data_Stage.ProductionStage);
		DocumentObject.SetBatchGenerationMode();
		DocumentObject.Fill(FillingData);
		
		Attributes = AdditionalAttributes.Get(Data_Stage.Stage);
		If Attributes <> Undefined Then
			For Each Name In AttributesNames Do
				If Attributes.Property(Name) Then
					DocumentObject[Name] = Attributes[Name];
				EndIf;
			EndDo;
			If Attributes.Property("DivisionAttributes") Then
				DocumentObject.ChangeDivisionAttributes(Attributes.DivisionAttributes);
			EndIf;
		EndIf;
		
		TechProcessParameters = ProductionProcessEditorClientServer.ProcessParametersConstructor();
		FillPropertyValues(TechProcessParameters, HeaderAttributes);
		DocumentObject.ChangeTechProcessParameters(TechProcessParameters);
		
		SetPrivilegedMode(True);
		ConductWithDowngradedStatus(DocumentObject);
		SetPrivilegedMode(False);
		
		References.Add(DocumentObject.Ref);
		
	EndDo;
	
	If References.UBound() <> -1 Then
		GenerationParameters = StageGenerationSettings();
		GenerationParameters.References.Add(SpecificationData.ReferenceOrder);
		FillPropertyValues(GenerationParameters, Parameters,
			"ReserveMaterials, ReplaceMaterialsWithAnalogs");
		
		FillInFormAndReflectRegisteredRecordsByStages(
			GenerationParameters, References, New TempTablesManager);
		
		If ProductionManagementCached.TheProductionScheduleIsUsed() Then
			If BatchData.DynamicStructure Then
				TasksToAdd = New ValueTable();
				TasksToAdd.Columns.Add("ProductionOrder", New TypeDescription("DocumentRef.ProductionOrder2_2"));
				TasksToAdd.Columns.Add("ProductionStage", New TypeDescription("DocumentRef.ProductionStage2_2"));
				For Each Ref In References Do
					NewRow = TasksToAdd.Add();
					NewRow.ProductionOrder = BatchData.ReferenceOrder;
					NewRow.ProductionStage = Ref;
				EndDo;
				InformationRegisters.OrderStructureCalculationJobsProductionSchedule.AddTasks(TasksToAdd);
			Else
				InformationRegisters.JobsToProductionScheduleCalculation.AddTasks(References);
			EndIf;
		EndIf;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.ProductionStageStates = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			References,
			"ACTION_FEFLECT_STAGES_STATE",
			RegistersToBeReflected);
		
		If UseOperationsInStages() Then
			
			StepsForCalculatingTaskQueue = ItIsRequiredToCalculateQueueOfOperations(References);
			If StepsForCalculatingTaskQueue.Count() > 0 Then
				TaskDataTable = 
					InformationRegisters.JobsForCalculatingProductionOperationQueue.InitializeTaskDataTable();
				For Each StageForCalculation In StepsForCalculatingTaskQueue Do
					NewRow = TaskDataTable.Add();
					NewRow.ObjectOfARAP = StageForCalculation;
				EndDo;
				InformationRegisters.JobsForCalculatingProductionOperationQueue.AddTasks(TaskDataTable, False);
			EndIf;
			
		EndIf;
	EndIf;
	
	Return References;
	
EndFunction

Function QueryTextListOfProductionStepsAvailableForDeletion() Export
	
	QueryText = 
	"SELECT
	|	T.Ref AS Ref,
	|	T.ProductionLot AS ProductionLot
	|INTO TTStages
	|FROM
	|	Document.ProductionStage2_2 AS T
	|WHERE
	|	T.Ref IN(&ReferencesArrray)
	|
	|INDEX BY
	|	ProductionLot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	T.ProductionLot AS ProductionLot
	|INTO TTExcludedChains
	|FROM
	|	Document.ProductionStage2_2 AS T
	|WHERE
	|	T.ProductionLot IN
	|			(SELECT
	|				TTStages.ProductionLot AS ProductionLot
	|			FROM
	|				TTStages AS TTStages)
	|	AND NOT T.Ref IN (&ReferencesArrray)
	|	AND T.Posted
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TTStages.Ref AS Ref
	|FROM
	|	TTStages AS TTStages
	|WHERE
	|	NOT TTStages.ProductionLot IN
	|				(SELECT
	|					TTExcludedChains.ProductionLot
	|				FROM
	|					TTExcludedChains)";
	
	Return QueryText;
	
EndFunction

Procedure CalculateShifts(StageList) Export
	
	Filter = New Structure("NextStageNo", 0);
	
	Queue = StageList.FindRows(Filter);
	
	While Queue.Count() > 0 Do
		
		Vertex = Queue[0];
		
		DurationBeforeProductionIssue = ?(Vertex.DurationInSeconds > 0,
			Vertex.DurationBeforeProductionIssue + Vertex.DurationInSeconds, Vertex.DurationBeforeProductionIssue + 0.0001);
		
		Filter.NextStageNo = Vertex.StageNumber;
		
		For Each Node In StageList.FindRows(Filter) Do
			
			Node.DurationBeforeProductionIssue = Max(DurationBeforeProductionIssue, Node.DurationBeforeProductionIssue);
			
			If Queue.Find(Node) = Undefined Then
				Queue.Add(Node);
			EndIf;
			
		EndDo;
		
		Queue.Delete(0);
		
	EndDo;
	
EndProcedure

Function QueryTextTTStageConnections() Export

	QueryText =
		"SELECT
		|		Table.Ref    AS Stage,
		|		Table.Stage      AS NextStage
		|	FROM
		|		Document.ProductionStage2_2.Successors AS Table
		|	WHERE
		|		Table.Ref IN (&ReferencesArrray)
		|		AND Table.Stage.Posted
		|		AND (NOT &ExcludeCompleted
		|				OR Table.Stage.Status <> VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|		AND (NOT &InternalConnectionsOnly
		|				OR Table.LinkType = 0)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		Table.Ref,
		|		Table.Stage
		|	FROM
		|		Document.ProductionStage2_2.Successors AS Table
		|	WHERE
		|		Table.Stage IN (&ReferencesArrray)
		|		AND Table.Ref.Posted
		|		AND (NOT &ExcludeCompleted
		|				OR Table.Ref.Status <> VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|		AND (NOT &InternalConnectionsOnly
		|				OR Table.LinkType = 0)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2),
		|		Table.Ref
		|	FROM
		|		Document.ProductionStage2_2 AS Table
		|	WHERE
		|		Table.Ref IN (&ReferencesArrray)
		|		AND CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2) <> VALUE(Document.ProductionStage2_2.EmptyRef)
		|		AND CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2).Posted
		|		AND (NOT &ExcludeCompleted
		|				OR CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2).Status <> VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|		AND NOT &InternalConnectionsOnly // simplified, there is a sequence of stages inside the Lot reference
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2),
		|		Table.Ref
		|	FROM
		|		Document.ProductionStage2_2 AS Table
		|	WHERE
		|		Table.PlanNotEarlierThan IN (&ReferencesArrray)
		|		AND Table.Ref.Posted
		|		AND (NOT &ExcludeCompleted
		|				OR Table.Ref.Status <> VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|		AND NOT &InternalConnectionsOnly // simplified, there is a sequence of stages inside the Lot reference
		|";
	
	Return QueryText;
	
EndFunction

