		|		AND NOT Goods.Canceled
		|		AND Goods.Products.ItemsType IN(&ItemsTypes)";
	If CreationParameters.NameOfDocumentManager = "TransferOrder" Then
		
		Query.Text = Query.Text + "
		|
		|UNION ALL
		|
		|SELECT DISTINCT
		|	1000000                                                    AS LineNumber,
		|	Goods.UnderRepairProduct                    AS Products,
		|	Goods.UnderRepairVariant                  AS Characteristic,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
		|	VALUE(Catalog.Warehouses.EmptyRef)                   AS Warehouse,
		|	VALUE(Catalog.BusinessStructure.EmptyRef)     AS Department,
		|	VALUE(Catalog.Assignments.EmptyRef)               AS Purpose,
		|	VALUE(Enum.SupplyOptions.ToSupply)    AS SupplyOption,
		|	FALSE                                                       AS WithAssignment,
		|	DATETIME(1,1,1)                                           AS DateOfShipment,
		|	1                                                          AS NumberOfUnitsPerDocument,
		|	1                                                          AS CountByDocument
		|FROM
