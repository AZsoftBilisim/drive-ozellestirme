Function QueryTextCheckCOSTShares(Object, LinkFields, CostGroupField_ = "") Export
	
	QueriesTexts = New Array;
	
	RequestTextsToProcessor2_5 = TextsOfRequestsToVerifyCostShareInOrderToProcessor2_5(Object);
	
	RequestTextsToProcessor = Undefined;
	If Not RequestTextsToProcessor2_5 = Undefined Then
		RequestTextsToProcessor = RequestTextsToProcessor2_5;
	EndIf;
	
	QueryText = "
	|" + ?(RequestTextsToProcessor = Undefined, "", RequestTextsToProcessor.TemporaryTable) + "
	|SELECT
	|	Document.ProductionLot AS ProductionLot,
	|	Table.Ref        		AS Ref,
	|	Table.LineNumber    		AS LineNumber,
	|	Table.Products   		AS Products,
	|	Table.Characteristic 		AS Characteristic,
	|	Table.CostShare  		AS CostShare
	|INTO TabularSection
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|	
	|	INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS Table
	|	ON Document.Ref = Table.Ref
	|
	|WHERE
	|	&FilterProductionLot
	|	AND Document.Posted
	|	AND Document.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
	|	AND NOT Table.Canceled
	|	AND &FilterCostsAllocationMethod
	|	AND &FilterCurrentDocument
	|" + ?(RequestTextsToProcessor = Undefined, "", RequestTextsToProcessor.Source) + "
	|;
	|////////////////////////////////////////////////////////////////
	|" + ProductionServer.QueryTextCheckSharesOfCostOfOutputProducts(LinkFields, CostGroupField_) + "
	|";
	
	QueryText = StrReplace(QueryText, "&FilterProductionLot",
		?(RequestTextsToProcessor = Undefined,
			"Document.ProductionLot IN(&ProductionLot)",
			"Document.ProductionLot IN(" + RequestTextsToProcessor.PartiesBySharesOfValue + ")"));
			
	QueryText = StrReplace(QueryText, "&FilterCurrentDocument",
		?(RequestTextsToProcessor = Undefined,
			"(TRUE)",
			"NOT Document.Ref IN(" + RequestTextsToProcessor.Stages + ")"));
	
	QueryText = StrReplace(QueryText, "&FilterCostsAllocationMethod",
		?(RequestTextsToProcessor = Undefined,
			"&MethodOfAllocatingFinishedProductCosts = Value(Enum.MethodsOfCostAllocatingOnProductCosts.ByCostShares)",
			"(TRUE)"));
		
	QueriesTexts.Add(QueryText);
	
	QueryText = 
	"SELECT
	|	Table.ProductionLot
	|FROM
	|	Document.ProductionStage2_2 AS Table
	|WHERE
	|	&FilterProductionLot
	|	AND Table.Posted
	|	AND Table.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
	|	AND Table.NextStageNo = 0 //This is the issuing step()
	|
	|GROUP BY
	|	Table.ProductionLot	
	|
	|HAVING
	|	COUNT(DISTINCT Table.MethodOfAllocatingFinishedProductCosts) > 1
	|";
	
	QueryText = StrReplace(QueryText, "&FilterProductionLot",
		?(RequestTextsToProcessor = Undefined, 
			"Table.ProductionLot IN(&ProductionLot)",
			"Table.ProductionLot IN(" + RequestTextsToProcessor.Lots + ")"));
	
	QueriesTexts.Add(QueryText);

	QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	Return QueryText;
	
EndFunction


Function TextsOfRequestsToVerifyCostShareInOrderToProcessor2_5(Object)
	
	If Not TypeOf(Object) = Type("Structure") Then
		Return Undefined;
	EndIf;
	
	QueriesTexts = New Structure;
	
	QueryText = 
	"SELECT
	|	SourceTable1.Ref         AS Stage,
	|	SourceTable1.LineNumber    AS LineNumber,
	|	SourceTable1.Products   AS Products,
	|	SourceTable1.Characteristic AS Characteristic,
	|	SourceTable1.CostShare  AS CostShare,
	|	SourceTable1.Canceled       AS Canceled
	|INTO SourceTable1
	|FROM
	|	&SourceTable1 AS SourceTable1
	|WHERE
	|	NOT SourceTable1.Canceled
	|
	|INDEX BY
	|	Stage
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	Documents.ProductionLot						 AS ProductionLot,
	|	Documents.MethodOfAllocatingFinishedProductCosts AS CostsAllocationMethod
	|INTO BatchTable
	|FROM
	|	Document.ProductionStage2_2 AS Documents
	|	
	|	INNER JOIN SourceTable1 AS SourceTable1
	|	ON Documents.Ref = SourceTable1.Stage
	|
	|INDEX BY
	|	CostsAllocationMethod
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	SourceTable1.Stage AS Stage
	|INTO StepsTable
	|FROM
	|	SourceTable1 AS SourceTable1
	|";
	
	QueryText = QueryText + Common.QueryBatchSeparator();
	QueriesTexts.Insert("TemporaryTable", QueryText);
	
	QueryText =
	"SELECT
	|	StageDetails.ProductionLot	AS ProductionLot,
	|	UNDEFINED						AS Ref,
	|	SourceTable1.LineNumber			AS LineNumber,
	|	SourceTable1.Products		AS Products,
	|	SourceTable1.Characteristic		AS Characteristic,
	|	SourceTable1.CostShare		AS CostShare
	|FROM
	|	Document.ProductionStage2_2 AS StageDetails
	|	
	|	INNER JOIN SourceTable1 AS SourceTable1
	|	ON StageDetails.Ref = SourceTable1.Stage
	|WHERE
	|	StageDetails.MethodOfAllocatingFinishedProductCosts = 
	|		VALUE(Enum.MethodsOfCostAllocatingOnProductCosts.ByCostShares)
	|";
	
	QueryText = TMCommonUse.QuerySeparatorInJoin() + QueryText;
	QueriesTexts.Insert("Source", QueryText);
	
	QueryText =
	"SELECT
	|	StepsTable.Stage AS Stage
	|FROM
	|	StepsTable AS StepsTable
	|";
	
	QueriesTexts.Insert("Stages", QueryText);
	
	QueryText =
	"SELECT
	|	BatchTable.ProductionLot AS ProductionLot
	|FROM
	|	BatchTable AS BatchTable
	|";
	
	QueriesTexts.Insert("Lots", QueryText);
	
	QueryText =
	"SELECT
	|	BatchTable.ProductionLot AS ProductionLot
	|FROM
	|	BatchTable AS BatchTable
	|WHERE
	|	BatchTable.CostsAllocationMethod = 
	|		VALUE(Enum.MethodsOfCostAllocatingOnProductCosts.ByCostShares)
	|";
	
	QueriesTexts.Insert("PartiesBySharesOfValue", QueryText);
	
	Return QueriesTexts;
	
EndFunction

