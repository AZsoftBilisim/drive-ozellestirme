#Region ProductionBatchMaintenanceSheet

Function ToFormPrintedFormOfSheetOfBatchOfProduction(ObjectsArray, PrintObjects, PrintParameters)
	
	SpreadsheetDocument = New SpreadsheetDocument;
	SpreadsheetDocument.FitToPage = True;
	SpreadsheetDocument.PageOrientation = PageOrientation.Portrait;
	SpreadsheetDocument.PrintParametersName = "Parameters_Seals_ProductionStage2_2_ProductionBatchMaintenanceSheet";
	
	Template = PrintManagement.PrintFormTemplate("Document.ProductionStage2_2.PF_MXL_ProductionBatchMaintenanceSheet");
	FirstDocument = True;
	
	DataForPrint = GetDataForPrintedFormOfProductionBatchSheet(ObjectsArray, PrintParameters);
	BatchSelection = DataForPrint.BatchSelection;
	
	While BatchSelection.Next() Do
	
		If Not FirstDocument Then
			SpreadsheetDocument.PutHorizontalPageBreak();
		EndIf;
		FirstDocument = False;
		
		RowNumberStart = SpreadsheetDocument.TableHeight + 1;
		
		ProductionBatchMaintenanceSheetOutputTitle(SpreadsheetDocument, Template, BatchSelection);
		
		ProductionBatchSupportSheetDisplayHeader(SpreadsheetDocument, Template, BatchSelection);
		
		ProductionBatchMaintenanceSheetAndRelatedStages(
			PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint, True);
		
		ProductionBatchMaintenanceSheetAndStages(
			PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint);
		
		ProductionBatchMaintenanceSheetAndMaterials(
			PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint);
		
		ProductionBatchMaintenanceSheetAndOutputProducts(
			PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint);
		
		ProductionBatchMaintenanceSheetAndRelatedStages(
			PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint, False);
			
		SpreadsheetDocument.Put(Template.GetArea("Signatures"));
		
		PrintManagement.SetDocumentPrintArea(
			SpreadsheetDocument,
			RowNumberStart,
			PrintObjects,
			BatchSelection.ProductionLot);
		
	EndDo;
	
	Return SpreadsheetDocument;
	
EndFunction

Function GetDataForPrintedFormOfProductionBatchSheet(ObjectsArray, PrintParameters)
	
	Query = New Query;
	
	#Region ReadingStages
	Query.Text = 
		"SELECT
		|	ProductionStage2_2.Ref AS Ref,
		|	ProductionStage2_2.ProductionLot AS ProductionLot
		|FROM
		|	Document.ProductionStage2_2 AS ProductionStage2_2
		|WHERE
		|	ProductionStage2_2.ProductionLot IN
		|			(SELECT DISTINCT
		|				ProductionStage2_2.ProductionLot AS ProductionLot
		|			FROM
		|				Document.ProductionStage2_2 AS ProductionStage2_2
		|			WHERE
		|				ProductionStage2_2.Ref IN(&References))
		|	AND ProductionStage2_2.Posted";
	Query.SetParameter("References", ObjectsArray);
	QueryResult = Query.Execute().Unload();
	
	Stages = QueryResult.UnloadColumn("Ref");
	
	#EndRegion
	
	BatchQueryText = New Array;
	IndexesOfResults = New Map;
	IndexOf = 0;
	
	#Region QueryTextHeader
	
	QueryText =
	"SELECT
	|	Document.ProductionLot                                                            AS ProductionLot,
	|	Document.ProductionLot.Code                                                        AS ProductionBatchCode,
	|	Document.ProductionLot.MainProductProducts                                AS Product,
	|	Document.ProductionLot.MainProductProducts.DescriptionFull             AS ProductNameFull,
	|	Document.ProductionLot.MainProductProducts.UnitOfMeasure.Presentation AS BatchUnit,
	|	Document.ProductionLot.MainProductCharacteristic.DescriptionFull           AS CharacteristicFullName,
	|	Document.ProductionLot.BillOfMaterials                                               AS BillOfMaterials,
	|	Document.ProductionLot.BillOfMaterials.Presentation                                 AS PresentationOfSpecification,
	|	Document.ReferenceOrder.Number                                                            AS OrderNumber__,
	|	SUM(CASE
	|			WHEN TabularSection.Products = ProductionLot.MainProductProducts
	|				AND TabularSection.Characteristic = Document.ProductionLot.MainProductCharacteristic
	|				THEN TabularSection.Count
	|			ELSE 0
	|		END)                                                                             AS Count,
	|	MAX(ISNULL(Schedule.Ending, DATETIME(1,1,1)))                            AS PlannedTermination
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|
	|		LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS TabularSection
	|		ON Document.Ref = TabularSection.Ref
	|			AND (NOT TabularSection.Canceled)
	|
	|		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	|		ON Document.ReferenceOrder = Schedule.ProductionOrder
	|			AND Document.Ref = Schedule.Stage
	|			AND (Schedule.ScheduleStatus = &WorkingSchedule)
	|WHERE
	|	Document.Ref IN(&Stages)
	|	AND Document.ProductionLot.ProcessType IN (
	|											VALUE(Enum.ProductionProcessTypes.Assembly),
	|											VALUE(Enum.ProductionProcessTypes.PerformRM),
	|											VALUE(Enum.ProductionProcessTypes.Repair),
	|											VALUE(Enum.ProductionProcessTypes.WithoutBillsOfMaterials))
	|
	|GROUP BY
	|	Document.ProductionLot,
	|	Document.ReferenceOrder
	|
	|UNION ALL
	|
	|SELECT
	|	Document.ProductionLot,
	|	Document.ProductionLot.Code,
	|	Document.ProductionLot.MainProductProducts,
	|	Document.ProductionLot.MainProductProducts.DescriptionFull,
	|	Document.ProductionLot.MainProductProducts.UnitOfMeasure.Presentation,
	|	Document.ProductionLot.MainProductCharacteristic.DescriptionFull,
	|	Document.ProductionLot.BillOfMaterials,
	|	Document.ProductionLot.BillOfMaterials.Presentation,
	|	Document.ReferenceOrder.Number,
	|	SUM(CASE
	|			WHEN TabularSection.Products = ProductionLot.MainProductProducts
	|				AND TabularSection.Characteristic = Document.ProductionLot.MainProductCharacteristic
	|				THEN TabularSection.Count
	|			ELSE 0
	|		END),
	|	MAX(ISNULL(Schedule.Ending, DATETIME(1,1,1)))
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|
	|		LEFT JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS TabularSection
	|		ON Document.Ref = TabularSection.Ref
	|			AND (NOT TabularSection.Canceled)
	|
	|		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	|		ON Document.ReferenceOrder = Schedule.ProductionOrder
	|			AND Document.Ref = Schedule.Stage
	|			AND (Schedule.ScheduleStatus = &WorkingSchedule)
	|WHERE
	|	Document.Ref IN(&Stages)
	|	AND Document.ProductionLot.ProcessType IN (VALUE(Enum.ProductionProcessTypes.Disassembly))
	|
	|GROUP BY
	|	Document.ProductionLot,
	|	Document.ReferenceOrder
	|
	|ORDER BY
	|	ProductionLot";
	
	BatchQueryText.Add(QueryText);
	IndexesOfResults.Insert("BatchSelection", IndexOf);
	IndexOf = IndexOf + 1;
	
	#EndRegion
	
	#Region QueryTextAdjacentStages
	
	If ProductionBatchMaintenanceSheetAndRelatedStages_(PrintParameters) Then
		
		QueryText =
		"SELECT
		|	CAST(TTCommunicationStages.NextStage AS Document.ProductionStage2_2).ProductionLot AS ProductionLot,
		|	TTCommunicationStages.Stage                                                                        AS Stage,
		|	&TTCommunicationStagesPresentationStage                                                           AS PresentationStage,
		|	CAST(TTCommunicationStages.Stage AS Document.ProductionStage2_2).Department               AS Department
		|FROM
		|	TTCommunicationStages AS TTCommunicationStages
		|WHERE
		|	TTCommunicationStages.NextStage IN(&Stages)
		|	AND CAST(TTCommunicationStages.NextStage AS Document.ProductionStage2_2).ProductionLot
		|		<> CAST(TTCommunicationStages.Stage AS Document.ProductionStage2_2).ProductionLot
		|
		|ORDER BY
		|	ProductionLot,
		|	Stage
		|TOTALS BY
		|	ProductionLot";
		
		QueryText = StrReplace(
			QueryText,
			"&TTCommunicationStagesPresentationStage",
			QueryTextPresentationStage("TTCommunicationStages.Stage"));
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SamplingPredecessors", IndexOf);
		IndexOf = IndexOf + 1;
		
		QueryText =
		"SELECT
		|	CAST(TTCommunicationStages.Stage AS Document.ProductionStage2_2).ProductionLot     AS ProductionLot,
		|	TTCommunicationStages.NextStage                                                          AS Stage,
		|	&TTCommunicationStagesPresentationNextStage                                             AS PresentationStage,
		|	CAST(TTCommunicationStages.NextStage AS Document.ProductionStage2_2).Department AS Department
		|FROM
		|	TTCommunicationStages AS TTCommunicationStages
		|WHERE
		|	TTCommunicationStages.Stage IN(&Stages)
		|	AND CAST(TTCommunicationStages.NextStage AS Document.ProductionStage2_2).ProductionLot
		|		<> CAST(TTCommunicationStages.Stage AS Document.ProductionStage2_2).ProductionLot
		|
		|ORDER BY
		|	ProductionLot,
		|	Stage
		|TOTALS BY
		|	ProductionLot";
		
		QueryText = StrReplace(
			QueryText,
			"&TTCommunicationStagesPresentationNextStage",
			QueryTextPresentationStage("TTCommunicationStages.NextStage"));
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SamplingFollowers", IndexOf);
		IndexOf = IndexOf + 1;
		
	EndIf;
	
	#EndRegion
	
	#Region QueryTextStages
	
	QueryText =
	"SELECT
	|	Document.ProductionLot                                        AS ProductionLot,
	|	Document.Ref                                                    AS Stage,
	|	&PresentationStage                                                AS PresentationStage,
	|	Document.Department                                             AS Department,
	|	Document.Department.Presentation                               AS DivisionRepresentation,
	|	ISNULL(ScheduleOfProductionStages2_2.Begin, UNDEFINED)         AS Begin,
	|	ISNULL(ScheduleOfProductionStages2_2.Ending, UNDEFINED)      AS Ending
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
	|		ON Document.ReferenceOrder = ScheduleOfProductionStages2_2.ProductionOrder
	|			AND Document.Ref = ScheduleOfProductionStages2_2.Stage
	|			AND (ScheduleOfProductionStages2_2.ScheduleStatus = &WorkingSchedule)
	|WHERE
	|	Document.Ref IN(&Stages)
	|
	|ORDER BY
	|	ProductionLot,
	|	Ref
	|TOTALS BY
	|	ProductionLot";
	
	QueryText = StrReplace(
		QueryText,
		"&PresentationStage",
		QueryTextPresentationStage("Document.Ref"));
	
	BatchQueryText.Add(QueryText);
	IndexesOfResults.Insert("SamplingStages", IndexOf);
	IndexOf = IndexOf + 1;
	
	#EndRegion
	
	#Region QueryTextUsedMaterials
	
	If ProductionBatchSupportSheetPrintingMaterials(PrintParameters) Then
		
		QueryText = "
		|SELECT
		|	UsedMaterials.Ref.ProductionLot         AS ProductionLot,
		|	UsedMaterials.Products                      AS Products,
		|	UsedMaterials.Products.Code                  AS Code,
		|	UsedMaterials.Products.SKU              AS SKU,
		|	UsedMaterials.Products.DescriptionFull   AS ProductFullName,
		|	UsedMaterials.Characteristic.DescriptionFull AS CharacteristicFullName,
		|	UsedMaterials.Warehouse                             AS Warehouse,
		|	UsedMaterials.Warehouse.Presentation               AS WarehousePresentation_,
		|	CASE
		|		WHEN UsedMaterials.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			THEN PRESENTATION(UsedMaterials.Products.UnitOfMeasure)
		|		ELSE PRESENTATION(UsedMaterials.Package)
		|	END                                       AS UnitOfMeasurePresentation,
		|	UsedMaterials.NumberOfPackages                AS Count
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS UsedMaterials
		|WHERE
		|	UsedMaterials.Ref IN(&Stages)
		|	AND NOT UsedMaterials.Canceled
		|
		|ORDER BY
		|	ProductionLot,
		|	UsedMaterials.Ref,
		|	UsedMaterials.LineNumber
		|TOTALS BY
		|	ProductionLot";
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SampleMaterials", IndexOf);
		IndexOf = IndexOf + 1;
		
	EndIf;
	
	#EndRegion
	
	#Region QueryTextManufacturedProducts
	
	If ProductionBatchMaintenanceSheetPrintOutputProducts(PrintParameters) Then
		
		QueryText = "
		|SELECT
		|	ProductionIssue.Ref.ProductionLot         AS ProductionLot,
		|	ProductionIssue.Ref                            AS Ref,
		|	ProductionIssue.LineNumber                       AS LineNumber,
		|	ProductionIssue.Products                      AS Products,
		|	ProductionIssue.Products.Code                  AS Code,
		|	ProductionIssue.Products.SKU              AS SKU,
		|	ProductionIssue.Products.DescriptionFull   AS ProductFullName,
		|	ProductionIssue.Characteristic.DescriptionFull AS CharacteristicFullName,
		|	ProductionIssue.Recipient                        AS Recipient,
		|	ProductionIssue.Recipient.Presentation          AS RecipientPresentation1,
		|	CASE
		|		WHEN ProductionIssue.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			THEN PRESENTATION(ProductionIssue.Products.UnitOfMeasure)
		|		ELSE PRESENTATION(ProductionIssue.Package)
		|	END                                    AS UnitOfMeasurePresentation,
		|	ProductionIssue.NumberOfPackages                AS Count
		|FROM
		|	Document.ProductionStage2_2.ManufacturedProducts AS ProductionIssue
		|WHERE
		|	ProductionIssue.Ref IN(&Stages)
		|	AND NOT ProductionIssue.Canceled
		|
		|UNION ALL
		|
		|SELECT
		|	SideRelease.Ref.ProductionLot         AS ProductionLot,
		|	SideRelease.Ref                            AS Ref,
		|	SideRelease.LineNumber                       AS LineNumber,
		|	SideRelease.Products                      AS Products,
		|	SideRelease.Products.Code                  AS Code,
		|	SideRelease.Products.SKU              AS SKU,
		|	SideRelease.Products.DescriptionFull   AS ProductFullName,
		|	SideRelease.Characteristic.DescriptionFull AS CharacteristicFullName,
		|	SideRelease.Recipient                        AS Recipient,
		|	SideRelease.Recipient.Presentation          AS RecipientPresentation1,
		|	CASE
		|		WHEN SideRelease.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			THEN PRESENTATION(SideRelease.Products.UnitOfMeasure)
		|		ELSE PRESENTATION(SideRelease.Package)
		|	END                                            AS UnitOfMeasurePresentation,
		|	SideRelease.NumberOfPackages                AS Count
		|FROM
		|	Document.ProductionStage2_2.SideAndIntermediateRelease AS SideRelease
		|WHERE
		|	SideRelease.Ref IN(&Stages)
		|	AND NOT SideRelease.Canceled
		|
		|ORDER BY
		|	ProductionLot,
		|	Ref,
		|	LineNumber
		|TOTALS BY
		|	ProductionLot";
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("ProductSelection_", IndexOf);
		IndexOf = IndexOf + 1;
		
	EndIf;
	
	#EndRegion
	
	#Region AssemblingText
	
	Separator =
	"
	|;
	|/////////////////////////////////////////////////////////////
	|";
	
	QueryText = StrConcat(BatchQueryText, Separator);
	
	#EndRegion
	
	#Region RequestExecution
	
	Query = New Query(QueryText);
	Query.SetParameter("Stages", Stages);
	Query.SetParameter("WorkingSchedule", InformationRegisters.ScheduleOfProductionStages2_2.StatusWorkingSchedule());
	Query.TempTablesManager = New TempTablesManager;
	
	SetPrivilegedMode(True);
	If ProductionBatchMaintenanceSheetAndRelatedStages_(PrintParameters) Then
		CreateVTLinksOfStages(Query.TempTablesManager, Stages);
	EndIf;
	ResultsArray = Query.ExecuteBatch();  
	SetPrivilegedMode(False);
	
	DataForPrint = New Structure;
	For Each Result In IndexesOfResults Do
		
		QueryResult = ResultsArray[Result.Value]; // QueryResult
		Selection = QueryResult.Select(
			?(Result.Key = "BatchSelection",
				QueryResultIteration.Linear,
				QueryResultIteration.ByGroups));
		DataForPrint.Insert(Result.Key, Selection);
		
	EndDo;
	
	#EndRegion
	
	Return DataForPrint;
	
EndFunction

Procedure ProductionBatchMaintenanceSheetOutputTitle(SpreadsheetDocument, Template, BatchSelection)
	
	Area = Template.GetArea("Title");
	
	Area.Parameters.Number = StrTemplate("%1.%2",
		ObjectsPrefixesClientServer.NumberForPrinting(BatchSelection.OrderNumber__, True, True),
		BatchSelection.ProductionBatchCode);
	
	BarcodingOfPrintForms.OutputBarcodeToTabularDocument(
		SpreadsheetDocument,
		Template,
		Area,
		BatchSelection.ProductionLot);
	
	SpreadsheetDocument.Put(Area);
	
EndProcedure

Procedure ProductionBatchSupportSheetDisplayHeader(SpreadsheetDocument, Template, BatchSelection)
	
	AdditionalParametersProductPresentation = ProductsClientServer.AdditionalParametersPresentationOfProductsForPrinting();
	AdditionalParametersProductPresentation.DefaultLanguageCode = Common.DefaultLanguageCode();
	
	Area = Template.GetArea("Header");
	Area.Parameters.Fill(BatchSelection);
	Area.Parameters.OutputProductPresentation = ProductsClientServer.PresentationOfProductsForPrinting(
		BatchSelection.ProductNameFull,
		BatchSelection.CharacteristicFullName,
				,
				,
				AdditionalParametersProductPresentation);
	Area.Parameters.PlannedTermination = Format(BatchSelection.PlannedTermination, "DLF=D");
	
	SpreadsheetDocument.Put(Area);
	
EndProcedure

Procedure ProductionBatchMaintenanceSheetAndRelatedStages(PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint, Predecessors)
	
	If Not ProductionBatchMaintenanceSheetAndRelatedStages_(PrintParameters) Then
		Return;
	Else
		
		If Predecessors Then
			SamplingStages = DataForPrint.SamplingPredecessors;
		Else
			SamplingStages = DataForPrint.SamplingFollowers;
		EndIf;
		
		TheStructureOfTheSearch = New Structure("ProductionLot", BatchSelection.ProductionLot);
		If Not SamplingStages.FindNext(TheStructureOfTheSearch) Then
			Return;
		EndIf;
		
	EndIf;
	
	//
	HeaderArea_ = Template.GetArea("RelatedStagesHeader");
	
	If Predecessors Then
		HeaderArea_.Parameters.AdjacentStagesHeaderText = NStr("vi = 'Nhận việc';
																|ru = 'Принять работу';
																|en = 'Accept the job'; fa = 'Accept the job';
																|it = 'Ricezione lavoro';
																|pl = 'Zaakceptować pracę';
																|tr = 'İşi kabul et'", Common.DefaultLanguageCode());
	Else
		HeaderArea_.Parameters.AdjacentStagesHeaderText = NStr("vi = 'Bàn giao công việc';
																|ru = 'Сдать работу';
																|en = 'Pass the work'; fa = 'Pass the work';
																|it = 'Consegna lavoro';
																|pl = 'Przekaż pracę';
																|tr = 'İşi teslim et'", Common.DefaultLanguageCode());
	EndIf;
	
	SpreadsheetDocument.Put(HeaderArea_);
	
	//
	AreaRow = Template.GetArea("AdjacentStagesLine");
	
	Selection = SamplingStages.Select();
	While Selection.Next() Do
		
		AreaRow.Parameters.Fill(Selection);
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
	BasementArea = Template.GetArea("AdjacentBasementStages");
	SpreadsheetDocument.Put(BasementArea);
	
EndProcedure

Procedure ProductionBatchMaintenanceSheetAndStages(PrintParameters, SpreadsheetDocument, Template, BatchSelection, DataForPrint)
	
	SamplingStages = DataForPrint.SamplingStages; // QueryResult - 
		
	TheStructureOfTheSearch = New Structure("ProductionLot", BatchSelection.ProductionLot);
	If Not SamplingStages.FindNext(TheStructureOfTheSearch) Then
		Return;
	EndIf;
	
	GraphIsUsed_ = ProductionManagementCached.TheProductionScheduleIsUsed();
	If GraphIsUsed_ Then
		SectionHeader = Template.GetArea("HeaderOfStagesTableWithSchedule");
		AreaRow = Template.GetArea("TableRowStagesWithGraph"); // See ProductionServer.ServiceStructureTabularDocument
	Else
		SectionHeader = Template.GetArea("HeaderOfTableStagesWithoutSchedule");
		AreaRow = Template.GetArea("TableRowStagesWithoutGraph"); // See ProductionServer.ServiceStructureTabularDocument
	EndIf;
	
	SpreadsheetDocument.Put(SectionHeader);
		
	LineNumber = 0;
	Selection = SamplingStages.Select();
	While Selection.Next() Do
		
		AreaRow.Parameters.Fill(Selection);
		
		LineNumber = LineNumber + 1;
		AreaRow.Parameters.LineNumber = LineNumber;
		
		If GraphIsUsed_ And ValueIsFilled(Selection.Begin) Then
			If BegOfDay(Selection.Begin) = BegOfDay(Selection.Ending) Then
				AreaRow.Parameters.ProductionPeriod = Format(Selection.Begin, "DF=dd.MM");
			Else
				AreaRow.Parameters.ProductionPeriod = StrTemplate("%1 - %2",
					Format(Selection.Begin, "DF=dd.MM"),
					Format(Selection.Ending, "DF=dd.MM"));
			EndIf;
		EndIf;
		
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
	SpreadsheetDocument.Put(Template.GetArea("BasementTableStages"));
	
EndProcedure

