#Region Internal

// The function of embedding in the provision mechanism. It is necessary to add this function to the manager module
// to embed the commands for setting the order actions of the form "Reserve in stock", "To ensure"
// , etc. in the list of documents. If the list of documents (orders) of the same type needs to use different
// embedding parameters, depending on the values of the Attributes of a particular document.
// In this case
// , the Client documentation method is used in processing commands.Perform action on a list of different types of orders.
// 
// Parameters:
//  AllOrders - Array of DocumentRef.ProductionStage2_2
//  ActionCode - String - the conditional designation of the executed command: "ACTION_LOAD", "ACTION_RESERVATION", etc.
// Returns:
//  See ProvisionInDocumentsServer.NewParametersForExecutingCommandsAndSettingActions
Function ParametersForExecutingCommandsAndActions(AllOrders, ActionCode) Export
	
	Query = New Query();
	Query.SetParameter("Orders", AllOrders);
	Query.SetParameter("ReserveItAsItComesIn",
		ActionCode = "ACTION_RESERVATION_REFERENCES");
	Query.Text =
		"SELECT
		|	Orders.Ref AS Ref
		|FROM
		|	Document.ProductionStage2_2 AS Orders
		|WHERE
		|	Orders.Ref IN(&Orders)
		|		AND Orders.ProductionByThirdParty
		|		AND ISNULL(Orders.SubcontractOrder.Posted, FALSE)
		|		AND (NOT Orders.DynamicStructure OR NOT &ReserveItAsItComesIn)
		|;
		|//////////////////////////
		|SELECT
		|	Orders.Ref AS Ref
		|FROM
		|	Document.ProductionStage2_2 AS Orders
		|WHERE
		|	Orders.Ref IN(&Orders)
		|		AND NOT (Orders.ProductionByThirdParty
		|				AND ISNULL(Orders.SubcontractOrder.Posted, FALSE))
		|		AND (NOT Orders.DynamicStructure OR NOT &ReserveItAsItComesIn)";
	QueryResult = Query.ExecuteBatch();
	Results = New Array();
	
	AdditionalParameters = New Structure("ReturnProductionParametersOnSide", True);
	
	Result = ProvisionInDocumentsServer.StructureOrdersAndEmbeddingParameters();
	Result.Orders = QueryResult[0].Unload().UnloadColumn("Ref");
	Result.EmbeddingParameters = AvailableRemainingEmbeddingOptions(Undefined, AdditionalParameters);
	Results.Add(Result);
	
	AdditionalParameters.ReturnProductionParametersOnSide = False;
	
	Result = ProvisionInDocumentsServer.StructureOrdersAndEmbeddingParameters();
	Result.Orders = QueryResult[1].Unload().UnloadColumn("Ref");
	Result.EmbeddingParameters = AvailableRemainingEmbeddingOptions(Undefined, AdditionalParameters);
	Results.Add(Result);
	
	QueryTexts = New Array();
	If ActionCode = "ACTION_LOAD" Or ActionCode = "Action_Ship_PRIORITY_WithAssignment" Then
		
		For Each CurrentParameters In Results Do
			
			Orders = CurrentParameters.Orders;
			EmbeddingParameters = CurrentParameters.EmbeddingParameters;
			
			If Orders.Count() > 0 Then
				
				Text =
					"SELECT TOP 1
					|	TRUE AS NeedQuestion
					|FROM
					|	AccumulationRegister.InventoryAndDemands.Balance(,
					|		OrderDocument IN(
					|			SELECT
					|				Table.Ref AS OrderDocument
					|			FROM
					|				&TableOverridable AS Table
					|			WHERE
					|				Table.Ref IN(&Orders)
					|				AND Table.Posted
					|				AND &ConditionOverridable <> UNDEFINED
					|				AND &ConditionOverridable < &DateWhenTheNewLinesWereShipped)) AS Demands
					|WHERE
					|	Demands.ReserveAtWarehouseBalance > 0
					|		OR Demands.ReserveAsReceivedBalance > 0
					|		OR Demands.SnoozeReservationBalance > 0
					|		OR Demands.ToSupplyBalance > 0
					|		OR Demands.NotProvideBalance > 0
					|
					|UNION ALL
					|
					|SELECT TOP 1
					|	TRUE AS NeedQuestion
					|FROM
					|	AccumulationRegister.InventoryAndDemands.Balance(,
					|		OrderDocument IN(
					|			SELECT
					|				Table.SubcontractOrder AS OrderDocument
					|			FROM
					|				&TableOverridable AS Table
					|			WHERE
					|				Table.Ref IN(&Orders)
					|				AND Table.Posted
					|
					// such orders are excluded from processing
					|		AND NOT Table.DateOfShipment = DATETIME(1, 1, 1)
					|		AND &ConditionOverridable <> UNDEFINED
					|		AND &ConditionOverridable < &DateWhenTheNewLinesWereShipped)) AS Demands
					|WHERE
					|	Demands.ReserveAtWarehouseBalance > 0
					|		OR Demands.ReserveAsReceivedBalance > 0
					|		OR Demands.SnoozeReservationBalance > 0
					|		OR Demands.ToSupplyBalance > 0
					|		OR Demands.NotProvideBalance > 0";
				Text = StrReplace(Text, "&TableOverridable", EmbeddingParameters.ObjectName);
				Text = StrReplace(Text, "&ConditionOverridable",
					EmbeddingParameters.ExpressionForQuestionWhenPerformingActionInOrderList);
				QueryTexts.Add(Text);
				
			EndIf;
			
		EndDo;
		
	EndIf;
	
	Result = ProvisionInDocumentsServer.NewParametersForExecutingCommandsAndSettingActions();
	Result.ActionCode = ActionCode;
	Result.ExecutionParameters = Results;
	
	If QueryTexts.Count() > 0 Then
		
		Query = New Query();
		Query.Text = StrConcat(QueryTexts, TMCommonUse.QuerySeparatorInJoin());
		DateWhenTheNewLinesWereShipped = BegOfDay(CurrentSessionDate());
		Query.SetParameter("DateWhenTheNewLinesWereShipped", DateWhenTheNewLinesWereShipped);
		Query.SetParameter("Orders", AllOrders);
		
		Result.NeedQuestion = Not Query.Execute().IsEmpty();
		Result.DateWhenTheNewLinesWereShipped = DateWhenTheNewLinesWereShipped;
		
	EndIf;
	
	Return Result;
	
EndFunction

// Parameters:
// 	Object - DocumentObject
// 	Changes - ValueTable
// 	Mode - String
// 	FillParameters - Structure
// 	Parameters - See ProductionManagement.FillInDataWhenStatusChanges
// Returns:
// 	String - LongDesc
Function AfterFillingOutCollateral(Object, Changes, Mode, FillParameters, Parameters) Export
	
	ProvisionInDocumentsServer.UpdateShipmentDate(
		FillParameters,
		Object.NotShipInInstallments,
		Object.DateOfShipment,
		Object.SupplyWithMaterialsAndWorks,
		"DateOfShipment");
		
	If ProvisionInDocumentsClientServer.YouNeedToCheckFillInShipmentDateForShipLines(Mode) Then
		
		ProvisionInDocumentsServer.CheckFillInShipmentDateForShipLines(
			Changes.UnloadColumn("String"),
			"DateOfShipment",
			Object.NotShipInInstallments,
			Object.DateOfShipment);
			
	EndIf;
		
	StructureOfActions = New Structure("FillInAssignmentInProductionPhase");
	CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
	BatchProcessingOfTablePartServer.ProcessTSStrings(
		Changes.UnloadColumn("String"),
		StructureOfActions,
		Object.SupplyWithMaterialsAndWorks,
		CachedValues);
	
	ProvisionInDocumentsServer.RecalculateNumberOfUnits(Changes, Object.SupplyWithMaterialsAndWorks);
	
	ChangedBankingDetails = "";
	If ProvisionInDocumentsClientServer.YouNeedToCheckFillInShipmentDateForShipLines(Mode) Then
		
		NewStatus = Undefined;
		// Taking into account the limitations of specifying security options in the stage - if there is a ship, then the status of the document changes.
		If Changes.Count() > 0
				And Changes.Find(Enums.SupplyOptions.Ship, "SupplyOption") <> Undefined Then
			If Object.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated
					Or Object.Status = Enums.StatusesOfProductionStages2_2.Generated1
					Or Object.Status = Enums.StatusesOfProductionStages2_2.ForCompletion Then
				NewStatus = Enums.StatusesOfProductionStages2_2.Initiated;
			EndIf;
		// Taking into account the limitations of specifying security options in the stage - if there is a Reserve, then the status of the document changes.
		ElsIf Changes.Count() > 0
				And (Changes.Find(Enums.SupplyOptions.FromWarehouse, "SupplyOption") <> Undefined
					Or Changes.Find(Enums.SupplyOptions.ReserveAsReceived, "SupplyOption") <> Undefined) Then
			If Object.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated Then
				NewStatus = Enums.StatusesOfProductionStages2_2.Generated1;
			EndIf;
			
		EndIf;
		
		If NewStatus <> Undefined Then
			StatusBeforeChange = Object.Status;
			Object.Status = NewStatus;
			ChangedBankingDetails = ProductionManagement.FillInStageDetailsWhenStatusChanges(
				Object,
				StatusBeforeChange,
				Parameters);
		EndIf;
		
	EndIf;
	
	ProductsServer.FillInStatusesForSpecifyingSeries(
		Object,
		SeriesSpecificationParameters(Object).SupplyWithMaterialsAndWorks);
	
	Return ChangedBankingDetails;
	
EndFunction

Function DivisionItems(Ref) Export
	
	Query = New Query(
		"SELECT DISTINCT
		|	SupplyWithMaterialsAndWorks.Products AS Products,
		|	SupplyWithMaterialsAndWorks.Characteristic AS Characteristic,
		|	SupplyWithMaterialsAndWorks.Warehouse AS Warehouse,
		|	SupplyWithMaterialsAndWorks.Purpose AS Purpose
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS SupplyWithMaterialsAndWorks
		|WHERE
		|	SupplyWithMaterialsAndWorks.Ref = &Ref
		|	AND NOT SupplyWithMaterialsAndWorks.Canceled
		|	AND TRUE IN (
		|		SELECT TOP 1
		|			TRUE
		|		FROM
		|			Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProducts
		|		WHERE
		|			ManufacturedProducts.Ref IN (
		|				SELECT TOP 1
		|					DivisionAttributes.Predecessor
		|				FROM
		|					InformationRegister.AttributesOfProductionStageDivision AS DivisionAttributes
		|				WHERE
		|					DivisionAttributes.Stage = SupplyWithMaterialsAndWorks.Ref)
		|			AND ManufacturedProducts.Products = SupplyWithMaterialsAndWorks.Products
		|			AND ManufacturedProducts.Characteristic = SupplyWithMaterialsAndWorks.Characteristic
		|			AND (ManufacturedProducts.Recipient = SupplyWithMaterialsAndWorks.Warehouse
		|				OR ManufacturedProducts.Recipient = SupplyWithMaterialsAndWorks.Department)
		|			AND ManufacturedProducts.Purpose = SupplyWithMaterialsAndWorks.Purpose
		|		)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ManufacturedProducts.Products AS Products,
		|	ManufacturedProducts.Characteristic AS Characteristic,
		|	ManufacturedProducts.Recipient AS Recipient,
		|	ManufacturedProducts.Purpose AS Purpose
		|FROM
		|	Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProducts
		|WHERE
		|	ManufacturedProducts.Ref = &Ref
		|	AND NOT ManufacturedProducts.Canceled
		|	AND TRUE IN (
		|		SELECT TOP 1
		|			TRUE
		|		FROM
		|			Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS SupplyWithMaterialsAndWorks
		|		WHERE
		|			SupplyWithMaterialsAndWorks.Ref IN (
		|				SELECT
		|					DivisionAttributes.Stage
		|				FROM
		|					InformationRegister.AttributesOfProductionStageDivision AS DivisionAttributes
		|				WHERE
		|					DivisionAttributes.Predecessor = ManufacturedProducts.Ref)
		|			AND SupplyWithMaterialsAndWorks.Products = ManufacturedProducts.Products
		|			AND SupplyWithMaterialsAndWorks.Characteristic = ManufacturedProducts.Characteristic
		|			AND (SupplyWithMaterialsAndWorks.Warehouse = ManufacturedProducts.Recipient
		|				OR SupplyWithMaterialsAndWorks.Department = ManufacturedProducts.Recipient)
		|			AND SupplyWithMaterialsAndWorks.Purpose = ManufacturedProducts.Purpose
		|		)
		|");
	Query.SetParameter("Ref", Ref);
	ResultsArray = Query.ExecuteBatch();
	
	Supply = ResultsArray[0].Unload();
	Supply.Indexes.Add("Products, Characteristic, Warehouse, Purpose");
	
	Products_1 = ResultsArray[1].Unload();
	Products_1.Indexes.Add("Products, Characteristic, Recipient, Purpose");
	
	Return New Structure("Supply, Products_1", Supply, Products_1);

EndFunction

#Region Substitutes

// Generates parameters for selecting analogs
//
// Parameters:
//  Object - ClientApplicationForm, DocumentObject.ProductionStage2_2 - Form or document object
//                                                                            the production stage.
//  TableName - String - Name of the table to be processed
//  Mode - Number - 0 - show analogs,
//                  1 - find analogs,
//                  2 - replace with analogs.
//  AdditionalParameters - Structure - with keys:
//                             * PermissionValidityDate - Date, Undefined -
//                             * AvailableRemainingEmbeddingOptions -See AvailableRemainingEmbeddingOptions
//
// Returns:
//  See AlternativeMaterials.AnalogSelectionParameters
//
Function AnalogSelectionParameters(Object, TableName, Mode, AdditionalParameters) Export
	
	If TypeOf(Object) = Type("DocumentObject.ProductionStage2_2") Then
		
		FormData1 = New Structure;
		FormData1.Insert("Object",                  Object);
		FormData1.Insert("UUID", Object.UUID);
		FormData1.Insert("Modified",      True);
		
		FormData1.Insert(
			"ProductionBatchData",
			Documents.ProductionStage2_2.ProductionBatchData(
				Object.ReferenceOrder,
				Object.AssignmentProducts,
				Object.ProductionLot));
		
		FormData1.Insert(
			"AvailableRemainingEmbeddingOptions",
			AdditionalParameters.AvailableRemainingEmbeddingOptions);
		
		AdditionalParametersAnaloguesOfMaterials = AlternativeMaterials.AdditionalParameters();
		AdditionalParametersAnaloguesOfMaterials.CallingFromForm = False;
		
	Else
		
		FormData1 = Object;
		
		AdditionalParametersAnaloguesOfMaterials = Undefined;
		
	EndIf;
	
	ObjectData = FormData1.Object;
	ProductionBatchData = FormData1.ProductionBatchData;
	
	SourceType = New TypeDescription("DocumentRef.ProductionStage2_2");
	FormParameters = AlternativeMaterials.AnalogSelectionParameters(SourceType);
	
	// GeneralParameters
	FormParameters.GeneralParameters.ShowBalance = True;
	
	// GoodsParameters
	FieldsStructure = AlternativeMaterials.StructureOfTableFieldsToReplaceWithAnalogues();
	FieldsStructure.AdditionalFields.Insert("Ref", SourceType);
	FieldsStructure.DefaultValues.Insert("Ref", ObjectData.Ref);
	FieldsStructure.SpoofFields.Insert("Purpose", "SupplyAssignment");
	
	ProductData_9 = AlternativeMaterials.GetProductData(
		FormData1, "Object", TableName, Mode, ?(Mode = 2, True, False), FieldsStructure, AdditionalParametersAnaloguesOfMaterials);
		
	If Mode = 1 Then	
		
		StructureOfGettingTable = New Structure;
		StructureOfGettingTable.Insert("Object", New Structure);
		StructureOfGettingTable.Insert("Items", Object.Items);
		StructureOfGettingTable.Insert("UUID", Object.UUID);
		StructureOfGettingTable.Insert("Modified", True);
		StructureOfGettingTable.Insert("AvailableRemainingEmbeddingOptions", Object.AvailableRemainingEmbeddingOptions);
		
		EmbeddingParameters = Object.AvailableRemainingEmbeddingOptions;
		
		For Each SerializationPattern In EmbeddingParameters.FormDataSerializationPattern.Object Do
			
			TemplateFieldName = SerializationPattern.Key;
			If TemplateFieldName = TableName Then
				Continue;
			EndIf;
			
			StructureOfGettingTable["Object"].Insert(TemplateFieldName);
			
		EndDo;
		
		FillPropertyValues(StructureOfGettingTable["Object"], Object.Object);
		StructureOfGettingTable["Object"].Insert(TableName, Object.Object[TableName].Unload());
		
		ProductData_9.InventoryAllocation = AlternativeMaterials.PlaceInventoryDistributionInTemporaryStorage(StructureOfGettingTable,
			ProductData_9.Goods);
		
	EndIf;
		
	If Mode = 2
	   And GetFunctionalOption("DynamicStructureOfProductionOrders") Then
	
		SelectionOfPermissions = New Map();
		TMCommonUse.AddSelectionItemToCollection(SelectionOfPermissions, "AlternativeMaterials.UseItForAutocorrectInOrders", "&UseItForAutocorrectInOrders");
		
		PermissionSelectionParameters = New Map();
		PermissionSelectionParameters.Insert("UseItForAutocorrectInOrders", CommonClientServer.ValueInArray(True));
		
		FormParameters.GeneralParameters.SelectionOfPermissions = SelectionOfPermissions;
		FormParameters.GeneralParameters.PermissionSelectionParameters = PermissionSelectionParameters;
	
	EndIf;	
		
	FillPropertyValues(FormParameters.GoodsParameters, ProductData_9);
	
	// SubstitutesParameters
	ParametersTable = FormParameters.SubstitutesParameters.ParametersTable;
	
	PermissionValidityDate = Undefined;
	If Not AdditionalParameters.Property("PermissionValidityDate", PermissionValidityDate)
	 Or Not ValueIsFilled(PermissionValidityDate) Then
		PermissionValidityDate = BegOfDay(CurrentSessionDate());
	EndIf;
	
	TableRow = ParametersTable.Add();
	TableRow.PermissionValidityDate  = PermissionValidityDate;
	TableRow.Ref                  = ObjectData.Ref;
	TableRow.Department           = ObjectData.Department;
	TableRow.LineOfBusiness = ObjectData.LineOfBusiness;
	TableRow.ProductionOrder     = ProductionBatchData.ReferenceOrder;
	TableRow.BillOfMaterials            = ProductionBatchData.BillOfMaterials;
	TableRow.Stage                    = ObjectData.Stage;
	TableRow.Product                 = ProductionBatchData.Products;
	TableRow.ItemVariantOfProduct   = ProductionBatchData.Characteristic;
	
	FormParameters.SubstitutesParameters.ParametersTable = PutToTempStorage(
															ParametersTable,
															FormData1.UUID);
	
	Return FormParameters;
	
EndFunction

// Performs replacement with analogs
//
// Parameters:
//  Object                  - See AnalogSelectionParameters.Object
//  TableName              - See AnalogSelectionParameters.TableName
//  AddressInStorage         - See AlternativeMaterials.PerformReplacementForAnalogues.AddressInStorage
//  ActionCodeAnalogs      - See AlternativeMaterials.PerformReplacementForAnalogues.ActionCodeAnalogs
//  AdditionalParameters - See AnalogSelectionParameters.AdditionalParameters
//
// Returns:
//  See AlternativeMaterials.PerformReplacementForAnalogues
//
Function Replace_With_Analogues(
			Object,
			TableName,
			AddressInStorage = Undefined,
			ActionCodeAnalogs = "Action_Substitutes_ToReserve_",
			AdditionalParameters = Undefined) Export
	
	AdditionalFields = "ProductCostElement, DateOfShipment";
	
	ObjectData = ?(TypeOf(Object) = Type("DocumentObject.ProductionStage2_2"), Object, Object.Object);
	
	If AddressInStorage = Undefined Then
		
		Result = AlternativeMaterials.PerformReplacementWithAnaloguesAutomatically(
						ObjectData[TableName],
						AnalogSelectionParameters(Object, TableName, 2, AdditionalParameters),
						AdditionalFields,
						ActionCodeAnalogs);
		
	Else
		
		Result = AlternativeMaterials.PerformReplacementForAnalogues(
						ObjectData[TableName],
						AddressInStorage,
						AdditionalFields,
						ActionCodeAnalogs);
		
	EndIf;
	
	Return Result;
	
EndFunction

// Fills in the necessary Attributes in the changed and new lines after replacing with analogs
//
// Parameters:
//  Object              - See AnalogSelectionParameters.Object
//  TableName          - See AnalogSelectionParameters.TableName
//  ReplacementResult     - See Replace_With_Analogues
//  StructureOfActions   - Structure, Undefined       - if the structure is passed, then the
//                                                        structures of the action on new lines are added to this structure (used in the Form
//                                                        of the production stage document).
//                                                        Undefined by default.
//  RowsIDs - Array of Number, Undefined - if an array is passed, then the
//                                                        IDs of the changed and new rows are added to this array.
//                                                        Undefined by default.
//
Procedure AfterReplacementWithAnalogs(
			Object,
			TableName,
			ReplacementResult,
			StructureOfActions = Undefined,
			RowsIDs = Undefined) Export
	
	IndexesOfModifiedRows = ReplacementResult.IndexesOfModifiedRows;
	IndexesOfNewRows      = ReplacementResult.IndexesOfNewRows;
	
	NumberOfRowsChanged    = IndexesOfModifiedRows.Count();
	NumberOfNewLines         = IndexesOfNewRows.Count();
	NumberOfReplacementsMade = NumberOfRowsChanged + NumberOfNewLines; 
	
	If NumberOfReplacementsMade = 0 Then
		Return;
	EndIf;
	
	If TypeOf(Object) = Type("DocumentObject.ProductionStage2_2") Then
		
		DetailsOfOrder = Common.ObjectAttributesValues(
									Object.ReferenceOrder,
									"EarliestStartDate, Department");
		
		FormData1 = New Structure;
		FormData1.Insert("Object", Object);
		FormData1.Insert("RecordOfPerformed", False);
		
		FormData1.Insert(
			"StageEditingParameters",
			New FixedStructure(Documents.ProductionStage2_2.StageEditingParameters()));
		
		FormData1.Insert(
			"SeriesSpecificationParameters",
			New FixedStructure(ProductsServer.SeriesSpecificationParameters(
											Object, 
											Documents.ProductionStage2_2)));
		
		FormData1.Insert(
			"BOMSelectionParameters",
			ProductDataManagement.BOMSelectionParameters(Object, Documents.ProductionStage2_2));
		FormData1.Insert("EarliestStartDate", DetailsOfOrder.EarliestStartDate);
		FormData1.Insert("ProductionDispatcherBusinessUnit", DetailsOfOrder.Department);
		
		FormData1.Insert(
			"ParametersForFillingAssignments",
			ProductionSupply.ActionParametersFillInPurposeOfProvisionInProductionPhase(
				Object,
				Object.ManufacturedProducts));
		
		ObjectData = Object;
		
		CallForForm = False;
		
	Else
		
		FormData1 = Object;
		ObjectData = FormData1.Object;
		
		CallForForm = True;
		
	EndIf;
	
	If StructureOfActions = Undefined Then
		StructureOfActions = New Structure;
	EndIf;
	
	If NumberOfRowsChanged > 0 Then
		
		StructureOfActions.Insert(
			"RecalculateNumberOfUnits",
			ProductionClientServer.ParametersForRecalculatingNumberOfUnits());
		ReadyForProcessing_ = New Array;
		
		For Each RowIndex In IndexesOfModifiedRows Do
			
			TSRow = ObjectData[TableName][RowIndex];
			ReadyForProcessing_.Add(TSRow);
			
			If RowsIDs <> Undefined Then
				RowsIDs.Add(TSRow.GetID());
			EndIf;
			
		EndDo;
		
		CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
		
		BatchProcessingOfTablePartServer.ProcessTSStrings(
			ReadyForProcessing_,
			StructureOfActions,
			ObjectData[TableName],
			CachedValues);
		
	EndIf;
	
	If NumberOfNewLines > 0 Then
		
		CurrentDivision = ObjectData.Department;
		
		DateOfShipment = ?(ObjectData.NotShipInInstallments, ObjectData.DateOfShipment, Undefined);
		CurrentSessionDate = CurrentSessionDate();
		
		SecurityOptionShip = Enums.SupplyOptions.Ship;
		
		ReadyForProcessing_ = New Array;
		
		StructureOfActions = New Structure;
		StructureOfActions.Insert("FillInPurposeOfProvisionInProductionPhase", FormData1.ParametersForFillingAssignments);
		
		AdditionalParameters = New Structure;
		AdditionalParameters.Insert("FillInSeparately", False);
		AdditionalParameters.Insert("FillInOnlyEmpty", True);
		
		ProductionManagementClientServer.AddActionsToStructureWhenChangingProducts(
			TableName, FormData1, ObjectData, StructureOfActions, AdditionalParameters, CallForForm);
		
		ProductionManagementClientServer.AddQualityControlActionsToStructure(
			TableName,
			StructureOfActions,
			QualityControl.DataCacheOfMechanism(ObjectData));
		
		For Each RowIndex In IndexesOfNewRows Do
			
			TSRow = ObjectData[TableName][RowIndex];
			TSRow.Department = CurrentDivision;
			TSRow.SupplyAssignment = TSRow.Purpose;
			
			ReadyForProcessing_.Add(TSRow);
			
			If DateOfShipment <> Undefined Then
				
				TSRow.DateOfShipment = DateOfShipment;
				
			ElsIf TSRow.SupplyOption = SecurityOptionShip Then
				
				TSRow.DateOfShipment = CurrentSessionDate;
				
			EndIf;
			
			If RowsIDs <> Undefined Then
				RowsIDs.Add(TSRow.GetID());
			EndIf;
			
		EndDo;
		
		CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
		
		BatchProcessingOfTablePartServer.ProcessTSStrings(
			ReadyForProcessing_,
			StructureOfActions,
			ObjectData[TableName],
			CachedValues);
		
	EndIf;
	
	ProductDataManagement.UpdateSetsOfMaterialsAndWorksTable(ObjectData);
	
EndProcedure

