// Checks whether the document can be divided into two parts.
// 
// Parameters:
// 	Ref - DocumentRef.ProductionStage2_2 - link to the document.
// 	MessageText - String - the variable contains a description of errors (if any).
// 
// Returns:
//	Boolean - True if the document can be split.
// 
Function YouCanSplitDocument(Ref, MessageText) Export
	
	Result = True;
	
	Attributes = Common.ObjectAttributesValues(Ref,
		"ProductionProcessType, NextStageNo, ProductionByThirdParty, SubcontractOrder");
	
	If (Attributes.ProductionProcessType = Enums.ProductionProcessTypes.Assembly
		Or Attributes.ProductionProcessType = Enums.ProductionProcessTypes.PerformRM
		Or Attributes.ProductionProcessType = Enums.ProductionProcessTypes.Repair)
		And Attributes.NextStageNo = 0 Then
		
		Result = False;
		MessageText = NStr("vi = 'Không thể có nhiều công đoạn cuối cùng.';
							|ru = 'Не может быть несколько последних этапов.';
							|en = 'There cannot be more than one last stage.'; fa = 'There cannot be more than one last stage.';
							|it = 'Non vi possono essere più fasi finali.';
							|pl = 'Nie może być kilku ostatnich etapów.';
							|tr = 'Birden fazla son aşama olamaz.'");
		
	ElsIf Attributes.ProductionByThirdParty
		And Not Attributes.SubcontractOrder = Undefined Then
		
		Result = False;
		MessageText = NStr("vi = 'Đối với công đoạn, đã tạo đơn đặt hàng gia công, không thể thực hiện thao tác.';
							|ru = 'Для этапа создан заказ переработчику, действие не может быть выполнено.';
							|en = '""Subcontracting purchase order"" is created for the stage, action cannot be completed.'; fa = '""Subcontracting purchase order"" is created for the stage, action cannot be completed.';
							|it = 'Per la fase è stato creato l''ordine di trasferimento in conto lavorazione, l''azione non può essere eseguita.';
							|pl = 'Dla etapu utworzono zamówienie do przetwórcy, działanie nie może być wykonane.';
							|tr = 'Aşama için verilen fason satın alma siparişi oluşturuldu, eylem gerçekleştirilemez.'");
		
	EndIf;
	
	Return Result;
	
EndFunction

// Divides the document into two parts: creates a new document by the specified amount
// and reduces the current document by the same amount.
// Stages with the "no specifications" type of production process are divided in the ratio of 50/50% (parameters
// The number of packages and Packaging are ignored in this case).
// Data from table parts is recalculated by proportion.
// 
// Parameters:
// 	Ref - DocumentRef.ProductionStage2_2 - link to the shared document.
// 	NumberOfPackages - Number - size of the new document. The quantity must be smaller than the size of the original document. 
// 	Package - CatalogRef.PackagesAndUnitsOfMeasure - unit of quantity measurement.
// 	Cancel - Boolean - True if the split was not performed due to errors.
//
Procedure DivideDocument(Ref, NumberOfPackages, Package, Cancel) Export
	
	BeginTransaction();
	
	Try
		
		Data_Stage = Common.ObjectAttributesValues(Ref, "ReferenceOrder,ProductionLot");
		
		Block = New DataLock;
		LockItem = Block.Add("Document.ProductionStage2_2");
		LockItem.SetValue("Ref", Ref);
		Block.Lock();
		
		DocumentObject = Ref.GetObject();
		DocumentObject.Lock();
		
		MessageText = "";
		If Not YouCanSplitDocument(Ref, MessageText) Then
			Common.MessageToUser(MessageText,,,, Cancel);
			RollbackTransaction();
			Return;
		EndIf;
		
		StageData_1 = StepDataForChangingBatches(Ref, False, True).RecalculationData;
		Stage = StageData_1.Attributes[0];
		
		// Calculation of coefficients (coefficient 1 - for the old document, coefficient 2 - for the new one)
		If Stage.ProductionProcessType = Enums.ProductionProcessTypes.WithoutBillsOfMaterials Then
			ZoomRatio1 = 0.5;
			ZoomRatio2 = 0.5;
		Else
			
			If Stage.PackagePlan = Package Then
				ZoomRatio2 = NumberOfPackages / Stage.NumberOfPackagesPlan;
			Else
				Products = Common.ObjectAttributeValue(
					Stage.ProductionLot, "MainProductProducts");
				CoefficientIsNew = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
					Package, Products);
				CoefficientIsOld = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
					Stage.PackagePlan, Products);
				ZoomRatio2 = (CoefficientIsNew / CoefficientIsOld * NumberOfPackages)
					/ Stage.NumberOfPackagesPlan;
			EndIf;
			
			If ZoomRatio2 = 1 Then
				Common.MessageToUser(
					NStr("vi = 'Số lượng trong chứng từ mới phải khác với số lượng trong hiện tại.';
						|ru = 'Количество в новом документе должно отличаться от количества в текущем.';
						|en = 'Quantity in a new document should differ from quantity in the current document.'; fa = 'Quantity in a new document should differ from quantity in the current document.';
						|it = 'La quantità nel nuovo documento deve differire dalla quantità nel documento corrente.';
						|pl = 'Ilość w nowym dokumencie powinno różnić się od ilości w bieżącym.';
						|tr = 'Yeni belgedeki miktar, mevcut belgedeki miktardan farklı olmalıdır.'"),,,, Cancel);
				RollbackTransaction();
				Return;
			ElsIf ZoomRatio2 > 1 Then
				Common.MessageToUser(
					NStr("vi = 'Số lượng trong chứng từ mới không thể nhiều hơn số lượng trong chứng từ hiện tại.';
						|ru = 'Количество в новом документе не может быть больше количества в текущем.';
						|en = 'Quantity in a new document cannot be greater than in the current one.'; fa = 'Quantity in a new document cannot be greater than in the current one.';
						|it = 'La quantità nel nuovo documento non può essere maggiore della quantità nel documento corrente.';
						|pl = 'Ilość w nowym dokumencie nie może być większa od ilości w bieżącej.';
						|tr = 'Yeni belgedeki miktar, mevcut belgedeki miktardan fazla olamaz.'"),,,, Cancel);
				RollbackTransaction();
				Return;
			EndIf;
			
			ZoomRatio1 = 1 - ZoomRatio2;
			
		EndIf;
		
		TechProcessParameters = ProductionProcessEditorClientServer.ProcessParametersConstructor();
		FillPropertyValues(TechProcessParameters, Stage);
		
		Parameters = RecalculateParametersByCoefficient();
		Parameters.ChangeFact = True;
		
		// Recalculation of an old document
		Parameters.ChangeDivisionItem = False;
		FillingValues = RecalculateStageDataByCoefficient(StageData_1, Ref, ZoomRatio1, Parameters);
		RecalculateCostFractionsWhenDividingDocument(FillingValues, ZoomRatio1);
		
		HeaderAttributes = New Structure;
		HeaderAttributes.Insert("NumberOfPackagesPlan", Round(Stage.NumberOfPackagesPlan * ZoomRatio1, 3));
		HeaderAttributes.Insert("NumberOfPackagesReal", Round(Stage.NumberOfPackagesReal * ZoomRatio1, 3));
		HeaderAttributes.Insert("NumberOfPackagesCanceled", Round(Stage.NumberOfPackagesCanceled * ZoomRatio1, 3));
		FillingValues.Insert("HeaderAttributes", HeaderAttributes);
		
		TechProcessParameters.TechnologicalProcessFactor = Round(Stage.TechnologicalProcessFactor * ZoomRatio1, 3);
		DocumentObject.ChangeTechProcessParameters(TechProcessParameters);
		
		DocumentObject.Fill(FillingValues);
		If Not DocumentObject.CheckFilling() Then
			DocumentObject.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated;
		EndIf;
		DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
		DocumentObject.Write(DocumentWriteMode.Posting);
		
		// Creating a new document
		Parameters.DeleteDivisionItem = True;
		Parameters.ClearRowKeys = True;
		FillingValues = RecalculateStageDataByCoefficient(StageData_1, Ref, ZoomRatio2, Parameters);
		RecalculateCostFractionsWhenDividingDocument(FillingValues, ZoomRatio2);
		
		HeaderAttributes = New Structure;
		For Each Column In StageData_1.Attributes.Columns Do
			If Column.Name = "Ref"
				Or Column.Name = "Purpose"
				Or Column.Name = "NumberOfPackagesPlan"
				Or Column.Name = "PackagePlan"
				Or Column.Name = "Number"
				Or Column.Name = "StartingLotStageNumber" Then
				Continue;
			EndIf;
			HeaderAttributes.Insert(Column.Name, Stage[Column.Name]);
		EndDo;
		HeaderAttributes.Insert("NumberOfPackagesPlan", NumberOfPackages);
		HeaderAttributes.Insert("PackagePlan", Package);
		HeaderAttributes.Insert("NumberOfPackagesReal", Round(Stage.NumberOfPackagesReal * ZoomRatio2, 3));
		HeaderAttributes.Insert("NumberOfPackagesCanceled", Round(Stage.NumberOfPackagesCanceled * ZoomRatio2, 3));
		FillingValues.Insert("HeaderAttributes", HeaderAttributes);
		
		FillingValues.Insert("Successors",
			StageData_1.Successors.Copy(New Structure("LinkType", CommunicationTypeFollower()))
				.UnloadColumn("Stage"));
		
		DocumentObject = Documents.ProductionStage2_2.CreateDocument();
		DocumentObject.Fill(FillingValues);
		If Not DocumentObject.CheckFilling() Then
			DocumentObject.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated;
		EndIf;
		DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
		
		TechProcessParameters.TechnologicalProcessFactor = Round(Stage.TechnologicalProcessFactor * ZoomRatio2, 3);
		DocumentObject.ChangeTechProcessParameters(TechProcessParameters);
		
		DocumentObject.Write(DocumentWriteMode.Posting);
		
		NewRef = DocumentObject.Ref;
		
		// Connection with predecessors
		Predecessors = PredecessorsInStageQueue(Ref);
		For Each Predecessor In Predecessors Do
			
			DocumentObject = Predecessor.GetObject(); // DocumentObject - 
			DocumentObject.Lock();
			
			NewRow = DocumentObject.Successors.Add();
			NewRow.Stage = NewRef;
			NewRow.LinkType = CommunicationTypeFollower();
			
			DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
			DocumentObject.Write(DocumentWriteMode.Posting);
			DocumentObject.Unlock();
			
		EndDo;
		
		// Adjustment of output for the purpose and inventory balances
		TransferReserves(
			CommonClientServer.ValueInArray(Ref),
			CommonClientServer.ValueInArray(NewRef));
		
		InformationRegisters.JobsForTargetProductionScheduleCalculation.RunJob(Stage.ReferenceOrder);
		If Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.TargetOrderStructureSchedule.StartCalculation();
		EndIf;
		
		CommitTransaction();
		
	Except
		
		RollbackTransaction();
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
					|it = 'Fase di produzione';
					|pl = 'Etap produkcji';
					|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
					+ NStr("vi = 'Chia chứng từ';
							|ru = 'Деление документа';
							|en = 'Document splitting'; fa = 'Document splitting';
							|it = 'Divisione del documento';
							|pl = 'Podział dokumentu';
							|tr = 'Belgenin bölünmesi'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,
			Ref.Metadata(),
			Ref,
			DetailErrorDescription(ErrorInfo()));
		
		Raise BriefErrorDescription(ErrorInfo());
		
	EndTry;
	
EndProcedure

// Creates a new stage to fill in the canceled amount in the specified document.
// 
// Parameters:
// 	Ref - DocumentRef.ProductionStage2_2 - document-data source.
// 	NumberOfPackages - Number - size of the new document.
// 	Package - CatalogRef.PackagesAndUnitsOfMeasure - unit of quantity measurement.
// 
// Returns:
// 	Undefined, DocumentRef.ProductionStage2_2 - Link to the created document.
//
Function CreateDocumentForCancelledQuantity(Ref, NumberOfPackages, Package) Export
	
	NewRef = Undefined;
	
	BeginTransaction();
	
	Try
		
		Data_Stage = Common.ObjectAttributesValues(Ref, "ReferenceOrder,ProductionLot");
		
		Block = New DataLock;
		LockItem = Block.Add("Document.ProductionStage2_2");
		LockItem.SetValue("Ref", Ref);
		Block.Lock();
		
		StageData_1 = StepDataForChangingBatches(Ref, False, True).RecalculationData;
		
		// Removing row cancellations
		TheStructureOfTheSearchCanceled = New Structure("Canceled", True);
		
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("Products");
		TheStructureOfTheSearch.Insert("Characteristic");
		TheStructureOfTheSearch.Insert("Series");
		TheStructureOfTheSearch.Insert("Package");
		TheStructureOfTheSearch.Insert("SupplyOption");
		TheStructureOfTheSearch.Insert("Warehouse");
		TheStructureOfTheSearch.Insert("Produced");
		TheStructureOfTheSearch.Insert("BillOfMaterials");
		TheStructureOfTheSearch.Insert("Purpose");
		TheStructureOfTheSearch.Insert("ProductCostElement");
		TheStructureOfTheSearch.Insert("Canceled", False);
		
		For Each String In StageData_1.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearchCanceled) Do
			
			FillPropertyValues(TheStructureOfTheSearch, String,, "Canceled");
			FoundRows = StageData_1.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearch);
			If FoundRows.UBound() = -1 Then
				String.Canceled = False;
				String.CancellationReason = Undefined;
			Else
				FoundRows[0].Count = FoundRows[0].Count + String.Count;
				FoundRows[0].NumberOfPackages = FoundRows[0].NumberOfPackages + String.NumberOfPackages;
				StageData_1.SupplyWithMaterialsAndWorks.Delete(String);
			EndIf;
		EndDo;
		
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("Products");
		TheStructureOfTheSearch.Insert("Characteristic");
		TheStructureOfTheSearch.Insert("Package");
		TheStructureOfTheSearch.Insert("Recipient");
		TheStructureOfTheSearch.Insert("Purpose");
		TheStructureOfTheSearch.Insert("Series");
		TheStructureOfTheSearch.Insert("Manufactured");
		TheStructureOfTheSearch.Insert("ToExpenseAs");
		TheStructureOfTheSearch.Insert("ExpenseItem");
		TheStructureOfTheSearch.Insert("DimensionOfExpenses");
		TheStructureOfTheSearch.Insert("AssetsLiabilitiesDimension");
		TheStructureOfTheSearch.Insert("ProcessByBOM");
		TheStructureOfTheSearch.Insert("BillOfMaterials");
		TheStructureOfTheSearch.Insert("StageConsumer");
		TheStructureOfTheSearch.Insert("Canceled", False);
		
		For Each String In StageData_1.ManufacturedProducts.FindRows(TheStructureOfTheSearchCanceled) Do
			
			FillPropertyValues(TheStructureOfTheSearch, String,, "Canceled");
			FoundRows = StageData_1.ManufacturedProducts.FindRows(TheStructureOfTheSearch);
			If FoundRows.UBound() = -1 Then
				String.Canceled = False;
				String.CancellationReason = Undefined;
			Else
				FoundRows[0].Count = FoundRows[0].Count + String.Count;
				FoundRows[0].NumberOfPackages = FoundRows[0].NumberOfPackages + String.NumberOfPackages;
				FoundRows[0].CostShare = FoundRows[0].CostShare + String.CostShare;
				StageData_1.ManufacturedProducts.Delete(String);
			EndIf;
		EndDo;
		
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("Products");
		TheStructureOfTheSearch.Insert("Characteristic");
		TheStructureOfTheSearch.Insert("Package");
		TheStructureOfTheSearch.Insert("Recipient");
		TheStructureOfTheSearch.Insert("Purpose");
		TheStructureOfTheSearch.Insert("Series");
		TheStructureOfTheSearch.Insert("Manufactured");
		TheStructureOfTheSearch.Insert("Price");
		TheStructureOfTheSearch.Insert("ToExpenseAs");
		TheStructureOfTheSearch.Insert("ExpenseItem");
		TheStructureOfTheSearch.Insert("DimensionOfExpenses");
		TheStructureOfTheSearch.Insert("AssetsLiabilitiesDimension");
		TheStructureOfTheSearch.Insert("ProductCostElement");
		TheStructureOfTheSearch.Insert("ProcessByBOM");
		TheStructureOfTheSearch.Insert("BillOfMaterials");
		TheStructureOfTheSearch.Insert("StageConsumer");
		TheStructureOfTheSearch.Insert("Canceled", False);
		
		For Each String In StageData_1.SideAndIntermediateRelease.FindRows(TheStructureOfTheSearchCanceled) Do
			
			FillPropertyValues(TheStructureOfTheSearch, String,, "Canceled");
			FoundRows = StageData_1.SideAndIntermediateRelease.FindRows(TheStructureOfTheSearch);
			If FoundRows.UBound() = -1 Then
				String.Canceled = False;
				String.CancellationReason = Undefined;
			Else
				FoundRows[0].Count = FoundRows[0].Count + String.Count;
				FoundRows[0].NumberOfPackages = FoundRows[0].NumberOfPackages + String.NumberOfPackages;
				FoundRows[0].Sum = FoundRows[0].Sum + String.Sum;
				StageData_1.SideAndIntermediateRelease.Delete(String);
			EndIf;
		EndDo;
		
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("WorkKind");
		TheStructureOfTheSearch.Insert("ProductCostElement");
		TheStructureOfTheSearch.Insert("Performer");
		TheStructureOfTheSearch.Insert("Completed2");
		TheStructureOfTheSearch.Insert("Canceled", False);
		
		For Each String In StageData_1.LaborCosts.FindRows(TheStructureOfTheSearchCanceled) Do
			
			FillPropertyValues(TheStructureOfTheSearch, String,, "Canceled");
			FoundRows = StageData_1.LaborCosts.FindRows(TheStructureOfTheSearch);
			If FoundRows.UBound() = -1 Then
				String.Canceled = False;
				String.CancellationReason = Undefined;
			Else
				FoundRows[0].Count = FoundRows[0].Count + String.Count;
				StageData_1.LaborCosts.Delete(String);
			EndIf;
		EndDo;
		
		// Calculation of the coefficient
		Stage = StageData_1.Attributes[0];
		If Stage.PackagePlan = Package Then
			ZoomRatio = NumberOfPackages / Stage.NumberOfPackagesPlan;
		Else
			Products = Common.ObjectAttributeValue(
				Stage.ProductionLot, "MainProductProducts");
			CoefficientIsNew = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
				Package, Products);
			CoefficientIsOld = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
				Stage.PackagePlan, Products);
			ZoomRatio = (CoefficientIsNew / CoefficientIsOld * NumberOfPackages)
				/ Stage.NumberOfPackagesPlan;
		EndIf;
		
		// Filling in the cost shares in the original document
		If ZoomRatio < 1 Then
			
			Query = New Query(
				"SELECT TOP 1
				|	TRUE
				|FROM
				|	Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProducts
				|WHERE
				|	ManufacturedProducts.Ref = &Ref
				|	AND ManufacturedProducts.CostShare = 0
				|	AND NOT ManufacturedProducts.Canceled");
			Query.SetParameter("Ref", Ref);
			 
			If Not Query.Execute().IsEmpty() Then
			
				DocumentObject = Ref.GetObject();
				DocumentObject.Lock();
				
				RecalculateCostFractionsWhenDividingDocument(DocumentObject, 1-ZoomRatio);
				
				If Not DocumentObject.CheckFilling() Then
					DocumentObject.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated;
				EndIf;
				DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
				DocumentObject.Write(DocumentWriteMode.Posting);
				
			EndIf;
			
		EndIf;
		
		// Creating a new document
		Parameters = RecalculateParametersByCoefficient();
		Parameters.ChangeFact = True;
		Parameters.DeleteDivisionItem = True;
		Parameters.ClearRowKeys = True;
		
		FillingValues = RecalculateStageDataByCoefficient(StageData_1, Ref, ZoomRatio, Parameters);
		RecalculateCostFractionsWhenDividingDocument(FillingValues, ZoomRatio);
		
		HeaderAttributes = New Structure;
		For Each Column In StageData_1.Attributes.Columns Do
			If Column.Name = "Ref"
				Or Column.Name = "Purpose"
				Or Column.Name = "NumberOfPackagesPlan"
				Or Column.Name = "PackagePlan"
				Or Column.Name = "Number"
				Or Column.Name = "StartingLotStageNumber" Then
				Continue;
			EndIf;
			HeaderAttributes.Insert(Column.Name, Stage[Column.Name]);
		EndDo;
		HeaderAttributes.Insert("NumberOfPackagesPlan", NumberOfPackages);
		HeaderAttributes.Insert("PackagePlan", Package);
		HeaderAttributes.Insert("NumberOfPackagesReal", 0);
		HeaderAttributes.Insert("NumberOfPackagesCanceled", 0);
		FillingValues.Insert("HeaderAttributes", HeaderAttributes);
		
		FillingValues.Insert("Successors",
			StageData_1.Successors.Copy(New Structure("LinkType", CommunicationTypeFollower()))
				.UnloadColumn("Stage"));
		
		DocumentObject = Documents.ProductionStage2_2.CreateDocument();
		DocumentObject.Fill(FillingValues);
		If Not DocumentObject.CheckFilling() Then
			DocumentObject.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated;
		EndIf;
		DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
		
		TechProcessParameters = ProductionProcessEditorClientServer.ProcessParametersConstructor();
		FillPropertyValues(TechProcessParameters, Stage);
		TechProcessParameters.TechnologicalProcessFactor = Round(Stage.TechnologicalProcessFactor * ZoomRatio, 3);
		DocumentObject.ChangeTechProcessParameters(TechProcessParameters);
		
		DocumentObject.Write(DocumentWriteMode.Posting);
		
		NewRef = DocumentObject.Ref;
		
		// Connection with predecessors
		Predecessors = PredecessorsInStageQueue(Ref);
		For Each Predecessor In Predecessors Do
			
			DocumentObject = Predecessor.GetObject(); // DocumentObject.ProductionStage2_2 - 
			DocumentObject.Lock();
			
			NewRow = DocumentObject.Successors.Add();
			NewRow.Stage = NewRef;
			NewRow.LinkType = CommunicationTypeFollower();
			
			DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
			DocumentObject.Write(DocumentWriteMode.Posting);
			DocumentObject.Unlock();
			
		EndDo;
		
		InformationRegisters.JobsForTargetProductionScheduleCalculation.RunJob(Stage.ReferenceOrder);
		If Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.TargetOrderStructureSchedule.StartCalculation();
		EndIf;
		
		CommitTransaction();
		
