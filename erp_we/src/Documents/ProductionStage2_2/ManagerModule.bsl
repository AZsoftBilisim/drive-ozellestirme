Function QueryTextTTTableOfPartyAccountingAnalysts(Query, QueryTexts, DocumentObject)
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataHeader", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	TextSelectionOfAnalystField =
	"SELECT
	|	""ManufacturedProducts""	AS TabularSectionName,
	|	DocumentTable.LineNumber	AS LineNumber,
	|	UNDEFINED					AS Vendor,
	|	UNDEFINED					AS Counterparty,
	|	UNDEFINED					AS VATRate,
	|	UNDEFINED					AS VATTaxation,
	|	CASE
	|		WHEN DocumentTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|			THEN VALUE(Enum.AssetKinds.OtherWorksAndServices)
	|		ELSE VALUE(Enum.AssetKinds.Goods)
	|	END							AS AssetTaxClass,
	|	CASE
	|		WHEN TTParametersOfBatchAccountingForConducting.BatchAccountingVersion22
	|			THEN DocumentTable.RowCode
	|		ELSE 0
	|	END							AS RowCode
	|INTO TTBatchAccountingAnalyst
	|FROM
	|	DocumentDataTableOutputFinishedProducts AS DocumentTable
	|
	|	INNER JOIN DocumentDataHeader AS HeaderData_
	|	ON DocumentTable.Ref = HeaderData_.Ref 
	|	
	|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
	|	ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(DocumentTable.ProductionDate, MONTH)
	|		AND TTParametersOfBatchAccountingForConducting.Organization = HeaderData_.Organization
	|
	|WHERE
	|	NOT DocumentTable.Canceled
	|";
	
	QueryText = Catalogs.KeysForLotVendorAttributes.QueryTextTTTableOfPartyAccountingAnalysts(TextSelectionOfAnalystField, Query, QueryTexts);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableTTInitialOtherExpenses(Query, QueryTexts, DocumentObject)
	
	RegisterName = "TTInitialOtherExpenses";
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"TTCurrencyConversionFactors", QueryTexts, TempTablesManager) Then
		QueryTextTTCurrencyConversionFactors(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableTypesOfProductStocks", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableTypesOfProductStocks(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText =
	"SELECT
	|	TabularSection.LineNumber                   AS LineNumber,
	|	TabularSection.DateOfTransaction                  AS Period,
	|	VALUE(AccumulationRecordType.Receipt)       AS RecordType,
	|	TabularSection.TypeOfInventoryOwnerAttributeCompany         AS Organization,
	|	CASE
	|		WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN TabularSection.Department
	|		ELSE TabularSection.Recipient
	|	END                                        AS Department,
	|	TabularSection.ExpenseItem                AS ExpenseItem,
	|	TabularSection.DimensionOfExpenses             AS DimensionOfExpenses,
	|	&LineOfBusiness                     AS LineOfBusiness,
	|	&ReleaseUnderActivityRedefinition        AS VATActivityType,
	|
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountIncludingVAT,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountExcludingVAT,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountExcludingVATMan,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul AS NUMBER(31,2)) AS AmountIncludingVATCompl,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul AS NUMBER(31,2)) AS AmountExcludingVATCompl,
	|	0                                            AS PermanentDifference,
	|	0                                            AS CostTD,
	|	TabularSection.FinRecordID           AS FinRecordID,
	|	CASE 
	|		WHEN TabularSection.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost) 
	|			THEN VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost) 
	|		ELSE VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand) 
	|	END AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsConsumptionOnDemand) AS BusinessTransactionSetting,
	|	TabularSection.ItemsLocationAttributes    AS ItemsLocationAttributes
	|INTO TTInitialOtherExpenses
	|FROM
	|	DocumentDataTableTypesOfProductStocks AS TabularSection
	|
	|	INNER JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
	|		ON BEGINOFPERIOD(TabularSection.DateOfTransaction, DAY) = TTCurrencyConversionFactors.Period
	|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
	|		ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TabularSection.DateOfTransaction, MONTH)
	|		AND TTParametersOfBatchAccountingForConducting.Organization = TabularSection.TypeOfInventoryOwnerAttributeCompany
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND TabularSection.ToExpenseAs
	|	AND NOT TabularSection.Sum = 0
	|	AND (TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
	|		OR TabularSection.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost))
	|	AND VALUETYPE(TabularSection.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	|
	|UNION ALL
	|
	|SELECT
	|	TabularSection.LineNumber                   AS LineNumber,
	|	TabularSection.ProductionDate              AS Period,
	|	VALUE(AccumulationRecordType.Receipt)       AS RecordType,
	|	CASE
	|		WHEN &InternalSubcontracting
	|			THEN &MaterialProviderCompany
	|		ELSE &Organization
	|	END                                        AS Organization,
	|	CASE
	|		WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN TabularSection.Department
	|		ELSE TabularSection.Recipient
	|	END                                        AS Department,
	|	TabularSection.ExpenseItem                AS ExpenseItem,
	|	TabularSection.DimensionOfExpenses             AS DimensionOfExpenses,
	|	&LineOfBusiness                     AS LineOfBusiness,
	|	&ReleaseUnderActivityRedefinition        AS VATActivityType,
	|
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountIncludingVAT,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountExcludingVAT,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountExcludingVATMan,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul AS NUMBER(31,2)) AS AmountIncludingVATCompl,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul AS NUMBER(31,2)) AS AmountExcludingVATCompl,
	|	0                                            AS PermanentDifference,
	|	0                                            AS CostTD,
	|	TabularSection.RowID           AS FinRecordID,
	|	VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)        AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsConsumptionOnDemand) AS BusinessTransactionSetting,
	|	TabularSection.ItemsLocationAttributes    AS ItemsLocationAttributes
	|
	|FROM
	|	DocumentDataTableOutputFinishedProducts AS TabularSection
	|
	|	INNER JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
	|		ON BEGINOFPERIOD(TabularSection.ProductionDate, DAY) = TTCurrencyConversionFactors.Period
	|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
	|		ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TabularSection.ProductionDate, MONTH)
	|		AND TTParametersOfBatchAccountingForConducting.Organization = (CASE
	|			WHEN &InternalSubcontracting THEN &MaterialProviderCompany
	|			ELSE &Organization END)
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND TabularSection.ToExpenseAs
	|	AND NOT TabularSection.Sum = 0
	|	AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT TabularSection.ItemOfTraceableItem
	|	AND TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
	|	AND VALUETYPE(TabularSection.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	|
	|UNION ALL
	|
	|SELECT
	|	TabularSection.LineNumber                   AS LineNumber,
	|	TabularSection.ProductionDate              AS Period,
	|	VALUE(AccumulationRecordType.Receipt)       AS RecordType,
	|	CASE
	|		WHEN NOT TabularSection.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
	|			THEN TabularSection.ProductOwner
	|		WHEN &InternalSubcontracting
	|			THEN &MaterialProviderCompany
	|		ELSE &Organization
	|	END                                        AS Organization,
	|	CASE
	|		WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN TabularSection.Department
	|		ELSE TabularSection.Recipient
	|	END                                        AS Department,
	|	TabularSection.ExpenseItem                AS ExpenseItem,
	|	TabularSection.DimensionOfExpenses             AS DimensionOfExpenses,
	|	&LineOfBusiness                     AS LineOfBusiness,
	|	&ReleaseUnderActivityRedefinition        AS VATActivityType,
	|
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountIncludingVAT,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountExcludingVAT,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS AmountExcludingVATMan,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul AS NUMBER(31,2)) AS AmountIncludingVATCompl,
	|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul AS NUMBER(31,2)) AS AmountExcludingVATCompl,
	|	0                                            AS PermanentDifference,
	|	0                                            AS CostTD,
	|	TabularSection.RowID           AS FinRecordID,
	|	VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsConsumptionOnDemand) AS BusinessTransactionSetting,
	|	TabularSection.ItemsLocationAttributes    AS ItemsLocationAttributes
	|
	|FROM
	|	DocumentDataTableOfByFinishedProducts AS TabularSection
	|
	|	INNER JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
	|		ON BEGINOFPERIOD(TabularSection.ProductionDate, DAY) = TTCurrencyConversionFactors.Period
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND TabularSection.ToExpenseAs
	|	AND NOT TabularSection.Sum = 0
	|	AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT TabularSection.ItemOfTraceableItem
	|	AND VALUETYPE(TabularSection.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	|";
	
	QueryTexts.Add(QueryText, RegisterName);
	Return QueryText;
	
EndFunction

