	CheckParameters = ParametersForVerifyingBankingDetails("Purpose", "GivingAppointmentIsNotFilledIn");
	CheckParameters.MessageTemplate = NStr("vi = 'Chưa điền mục đích khi sản xuất từ nguyên vật liệu gia công (dòng %1 của danh sách ""%2"").';
											|ru = 'Не заполнено назначение при производстве из давальческого сырья (строка %1 списка ""%2"").';
											|en = 'Subcontracting assignment is not filled (line %1 of the ""%2"" list).'; fa = 'Subcontracting assignment is not filled (line %1 of the ""%2"" list).';
											|it = 'Non è stata compilata l''assegnazione durante la produzione da materie prime del fornitore (stringa %1 dell''elenco ""%2"").';
											|pl = 'Nie wypełniono przeznaczenia przy produkcji z surowców przekazanych przez właściciela surowców (wiersz %1 listy ""%2"").';
