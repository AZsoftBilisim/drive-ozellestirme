		|	Table.DateOfShipment                 AS DateOfShipment,
		|	FALSE                                 AS Canceled,
		|	Table.BatchesIndicationStatus          AS BatchesIndicationStatus,
		|	Table.SupplyOption           AS SupplyOption,
