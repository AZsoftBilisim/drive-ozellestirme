		|	
		|WHERE
		|	NOT DataOfAccounting.ReferenceOrder IS NULL
		|	AND &Filter";
		
		TextSourceTable = "Document.ProductionStage2_2.UnusedMaterials AS Table";
		TextIsCompoundPieceOfGoodsInMeasuringUnit = TextSourceTable + "
													|	//&CompoundUnitGoodsInUnitOfMeasure";
		QueryText = StrReplace(QueryText, TextSourceTable, TextIsCompoundPieceOfGoodsInMeasuringUnit);
		
	Else
		
		ExceptionText = NStr("vi = 'Lỗi trong thủ tục %1. Hãy liên hệ với người quản trị.';
							|ru = 'Ошибка в процедуре %1. Обратитесь к администратору.';
							|en = 'Error in procedure %1. Please contact your administrator.'; fa = 'Error in procedure %1. Please contact your administrator.';
							|it = 'Errore nella procedura %1. Rivolgersi all''amministratore.';
							|pl = 'Błąd w procedurze %1. Należy zwrócić się do administratora.';
							|tr = '%1 prosedüründe hata. Yöneticiye başvurun.'");
		
		ExceptionText = StrTemplate(ExceptionText, "ProductionStage2_2.QueryTextDocumentGoods");
		Raise ExceptionText;
	EndIf;
	
	ApplyingParameters = ProductionServer.ParametersOfApplicationOfPieceProductInDimensionalUnit();
	ApplyingParameters.NumberOfPackages = False;
	ApplyingParameters.UnitGoodsInUnitsOfMeasure = False;
	ProductionServer.ApplyUnitItemSettingsInUnitOfMeasure(QueryText, "Table", ApplyingParameters);
	
	FilterText1 = "TRUE";
	
	If ValueIsFilled(Filter) Then
		
		For Each KeyValue In Filter Do
			
			Var_Key = KeyValue.Key;
			
			If Var_Key = "Ref" Then
				Var_Key = "Table.Ref";
			EndIf;
			
			FilterText1 = 
				FilterText1
				+ " And "
				+ Var_Key
				+ " IN(&"
				+ KeyValue.Value
				+ ")";
			
		EndDo;
		
	EndIf;
	
	QueryText = StrReplace(QueryText, "&Filter", FilterText1);
	
	Return QueryText;

