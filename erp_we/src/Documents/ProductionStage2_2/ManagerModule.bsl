// Outputs of adjacent stages
//
// Parameters:
//  PrintParameters - Structure
//  SpreadsheetDocument - SpreadsheetDocument
//  Template - SpreadsheetDocument, DataCompositionAppearanceTemplate, ActiveDocumentShell, GeographicalSchema, TextDocument, HTMLDocumentShell, BinaryData, GraphicalSchema, DataCompositionSchema -
//  SampleDocument - QueryResultSelection - Contains:
// * Ref - DocumentRef -
//  DataForPrint - Structure - Contains:
// * SamplingPredecessors - QueryResultSelection
// * SamplingFollowers - QueryResultSelection
//  Predecessors - Boolean
Procedure TaskForProductionIsToOutputAdjacentStages(PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint, Predecessors)
	
	If Not ProductionAssignmentAndRelatedStages(PrintParameters) Then
		Return;
	Else
		
		If Predecessors Then
			SamplingStages = DataForPrint.SamplingPredecessors;
		Else
			SamplingStages = DataForPrint.SamplingFollowers;
		EndIf;
		
		TheStructureOfTheSearch = New Structure("Ref", SampleDocument.Ref);
		If Not SamplingStages.FindNext(TheStructureOfTheSearch) Then
			Return;
		EndIf;
		
	EndIf;
	
	//
	HeaderArea_ = Template.GetArea("RelatedStagesHeader");
	
	If Predecessors Then
		HeaderArea_.Parameters.AdjacentStagesHeaderText = NStr("vi = 'Nhận việc';
																|ru = 'Принять работу';
																|en = 'Accept the job'; fa = 'Accept the job';
																|it = 'Ricezione lavoro';
																|pl = 'Zaakceptować pracę';
																|tr = 'İşi kabul et'", Common.DefaultLanguageCode());
	Else
		HeaderArea_.Parameters.AdjacentStagesHeaderText = NStr("vi = 'Bàn giao công việc';
																|ru = 'Сдать работу';
																|en = 'Pass the work'; fa = 'Pass the work';
																|it = 'Consegna lavoro';
																|pl = 'Przekaż pracę';
																|tr = 'İşi teslim et'", Common.DefaultLanguageCode());
	EndIf;
	
	SpreadsheetDocument.Put(HeaderArea_);
	
	//
	AreaRow = Template.GetArea("AdjacentStagesLine");
	
	Selection = SamplingStages.Select();
	While Selection.Next() Do
		
		AreaRow.Parameters.Fill(Selection);
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
	BasementArea = Template.GetArea("AdjacentBasementStages");
	SpreadsheetDocument.Put(BasementArea);
	
EndProcedure

// Outputs content
//
// Parameters:
//  PrintParameters - Structure
//  SpreadsheetDocument - SpreadsheetDocument
//  Template - SpreadsheetDocument, DataCompositionAppearanceTemplate, ActiveDocumentShell, GeographicalSchema, TextDocument, HTMLDocumentShell, BinaryData, GraphicalSchema, DataCompositionSchema -
//  SampleDocument - QueryResultSelection - Contains:
// * Ref - DocumentRef -
//  DataForPrint - Structure - Contains:
// * SampleMaterials - QueryResultSelection
Procedure ProductionAssignmentOutputMaterials(PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint)
	
	If Not ProductionAssignmentPrintMaterials(PrintParameters) Then
		Return;
	Else
		
		SampleMaterials = DataForPrint.SampleMaterials;
		
		TheStructureOfTheSearch = New Structure("Ref", SampleDocument.Ref);
		If Not SampleMaterials.FindNext(TheStructureOfTheSearch) Then
			Return;
		EndIf;
		
	EndIf;
	
	ColumnOfCodes = PrintFormGeneration.AdditionalColumnOfDocumentPrintForms();
	NameOfCodeColumn = ColumnOfCodes.ColumnName;
	PresentationOfCodesColumn = ColumnOfCodes.ColumnPresentation;
	OutputCodes = ValueIsFilled(NameOfCodeColumn);
	
	HeaderArea_ = Template.GetArea("TitleOfMaterialsTable");
	SpreadsheetDocument.Put(HeaderArea_);
	
	If OutputCodes Then
		
		SectionHeader = Template.GetArea("HeaderOfMaterialsTableWithCode");
		SectionHeader.Parameters.NameOfCodeColumn = PresentationOfCodesColumn;
		
		AreaNameString = "RowOfMaterialsTableWithCode";
		AreaRow = Template.GetArea(AreaNameString);
		
	Else
		
		SectionHeader = Template.GetArea("HeaderOfMaterialsTable_NoCode");
		
		AreaNameString = "RowOfMaterialsTable_NoCode";
		AreaRow = Template.GetArea(AreaNameString);
		
	EndIf;
	
	SpreadsheetDocument.Put(SectionHeader);
		
	LineNumber = 0;
	Selection = SampleMaterials.Select();
	While Selection.Next() Do
		
		AreaRow.Parameters.Fill(Selection);
		
		LineNumber = LineNumber + 1;
		AreaRow.Parameters.LineNumber = LineNumber;
		
		If OutputCodes Then
			AreaRow.Parameters.SKU = Selection[NameOfCodeColumn];
		EndIf;
		
		AdditionalParametersProductPresentation = ProductsClientServer.AdditionalParametersPresentationOfProductsForPrinting();
		AdditionalParametersProductPresentation.DefaultLanguageCode = Common.DefaultLanguageCode();
		
		ProductPresentation = ProductsClientServer.PresentationOfProductsForPrinting(
				Selection.ProductFullName,
				Selection.CharacteristicFullName,
				,
				,
				AdditionalParametersProductPresentation);
		AreaRow.Parameters.ProductPresentation = ProductPresentation;
		
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
	If ProductionTaskAddBlankLinesToMaterials(PrintParameters) Then
		
		AreaRow = Template.GetArea(AreaNameString);
		ProductionTaskOutputEmptyLines(SpreadsheetDocument, AreaRow, LineNumber);
		
	EndIf;
	
	BasementArea = Template.GetArea("BasementTableMaterials");
	SpreadsheetDocument.Put(BasementArea);
	
EndProcedure

// Displays the output of the product
//
// Parameters:
//  PrintParameters - Structure
//  SpreadsheetDocument - SpreadsheetDocument - Table document
//  Template - SpreadsheetDocument, DataCompositionAppearanceTemplate, ActiveDocumentShell, GeographicalSchema, TextDocument, HTMLDocumentShell, BinaryData, GraphicalSchema, DataCompositionSchema -
