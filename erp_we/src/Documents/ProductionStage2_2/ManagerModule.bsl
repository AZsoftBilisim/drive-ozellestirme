// Defines a list of creation commands based on.
//
// Parameters:
//  GenerationCommands - See GenerateFromOverridable.BeforeAddGenerationCommands.GenerationCommands
//  Parameters - See GenerateFromOverridable.BeforeAddGenerationCommands.Parameters
//
Procedure AddGenerationCommands(GenerationCommands, Parameters) Export
	
	Documents.WorkOutput.AddCreateCommandBasedOnCreatingNewEmployees(GenerationCommands);
	
	Command = Documents.MovementOfProductsAndMaterials.AddCommandCreateTransferToProductionBasedOnOrder(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
	EndIf;
	
	Command = Documents.MovementOfProductsAndMaterials.AddCreateRefundFromProductionBasedOnOrderCommand(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
	EndIf;
	
	Documents.GoodsIssueNote.AddCommandToCreateSpendingOrderForGoodsBasedOnIt(GenerationCommands);
	
	Documents.MovementOfProductsAndMaterials.AddCreateTransferFromProductionBasedOnOrderCommand(GenerationCommands);
	
	Documents.InventoryAssignmentAdjustment.AddGenerateCommand(GenerationCommands);
	
	Documents.InternalAcceptanceCertificate.AddGenerateCommand(GenerationCommands);
	
	Documents.StandardCosting2_2.AddGenerateCommand(GenerationCommands);
	
	Command = Documents.ProductionOperation2_2.AddGenerateCommand(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
	EndIf;
	
	Command = Documents.PurchaseOrder.AddCreateSecuringOrderCommand(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
	EndIf;
	
	Command = Documents.PurchaseOrder.AddCreateBasedOnOrdersToSuppliersCommand(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
	EndIf;
		
	Command = DataProcessors.ReferenceAddressWarehousingOfProducts.AddGenerateCommand(GenerationCommands);
	
	If Command <> Undefined Then
		DocumentStatuses = New Array;
		DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.Generated1);
		DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.ForCompletion);
		DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.Initiated);
		DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.Completed);
		
		AttachableCommands.AddCommandVisibilityCondition(Command,
															"Status",
															DocumentStatuses,
															DataCompositionComparisonType.InList);
	EndIf;
	
	Command = Documents.ProductionOrder2_2.AddCommandToCreateProductionOrderOfReverseKitType(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
		AttachableCommands.AddCommandVisibilityCondition(Command, "WorkPlanning", False, DataCompositionComparisonType.Equal);
	EndIf;
	
	Command = Documents.ProductionOrder2_2.AddCommandToCreateProductionOrderOfRepairWorkType(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "WorkPlanning", True, DataCompositionComparisonType.Equal);
	EndIf;
	
	Command = Documents.TransferOrder.AddCreateSecuringOrderCommand(GenerationCommands);
	If Command <> Undefined Then
		AttachableCommands.AddCommandVisibilityCondition(Command, "ProductionByThirdParty", False, DataCompositionComparisonType.Equal);
		AttachableCommands.AddCommandVisibilityCondition(Command, "WorkPlanning", False, DataCompositionComparisonType.Equal);
	EndIf;
	
	BusinessProcesses.Job.AddGenerateCommand(GenerationCommands);
	
	ProductionStage2_2Localization.AddGenerationCommands(GenerationCommands, Parameters);
	
EndProcedure

// Adds the "production Stage" document creation command.
//
// Parameters:
//  GenerationCommands - See GenerateFromOverridable.BeforeAddGenerationCommands.GenerationCommands
//
//Returns:
//  ValueTableRow, Undefined - See GenerateFromOverridable.BeforeAddGenerationCommands.GenerationCommands
Function AddGenerateCommand(GenerationCommands) Export
	If AccessRight("Insert", Metadata.Documents.ProductionStage2_2) Then
		CreateBasedOnCommand = GenerationCommands.Add();
		CreateBasedOnCommand.Manager = Metadata.Documents.ProductionStage2_2.FullName();
		CreateBasedOnCommand.Presentation = TMCommonUse.ObjectPresentation(Metadata.Documents.ProductionStage2_2);
		CreateBasedOnCommand.WriteMode = "Post";
		CreateBasedOnCommand.FunctionalOptions = "UseProductionManagement2_2";

		Return CreateBasedOnCommand;
	EndIf;

	Return Undefined;
EndFunction

