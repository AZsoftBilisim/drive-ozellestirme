// Calculates the minimum document date to be recorded in the document registry
//
// Parameters:
//  Object	 - DocumentObject.ProductionStage2_2, FormDataStructure	 - the document to get parameters for.
//
// Returns:
//  Date - minimum document date.
//
Function MainDocumentRegistryEntry(Object) Export
	
	MaxDate = Date(3999,12,31,23,59,59);
	Result = MaxDate;
	
	FilterStructure1 = New Structure("Canceled", False);
	
	OutputProductTable = Object.ManufacturedProducts.Unload(FilterStructure1, "ProductionDate");
	For Each CurRow In OutputProductTable Do
		If ValueIsFilled(CurRow.ProductionDate) Then
			Result = Min(Result, CurRow.ProductionDate);
		EndIf;
	EndDo;
	
	If Not Result = MaxDate Then
		MainEntry_ = New Structure;
		MainEntry_.Insert("DocumentRegistryDate", Result);
		MainEntry_.Insert("DocumentRegistryOperation",
			Enums.BusinessTransactions.ProductsRelease);
		Return MainEntry_;
	EndIf;
	
	TableOfByProducts = Object.SideAndIntermediateRelease.Unload(FilterStructure1, "ProductionDate");
	For Each CurRow In TableOfByProducts Do
		If ValueIsFilled(CurRow.ProductionDate) Then
			Result = Min(Result, CurRow.ProductionDate);
		EndIf;
	EndDo;
	
	If Not Result = MaxDate Then
		MainEntry_ = New Structure;
		MainEntry_.Insert("DocumentRegistryDate", Result);
		MainEntry_.Insert("DocumentRegistryOperation",
			Enums.BusinessTransactions.ProductsRelease);
		Return MainEntry_;
	EndIf;
	
	TableConsumptionOfMaterialsAndWorks = Object.MaterialsAndWorksConsumption.Unload(, "DateOfMaterialWorkConsumption");
	For Each CurRow In TableConsumptionOfMaterialsAndWorks Do
		If ValueIsFilled(CurRow.DateOfMaterialWorkConsumption) Then
			Result = Min(Result, CurRow.DateOfMaterialWorkConsumption);
		EndIf;
	EndDo;
	
	If Not Result = MaxDate Then
		MainEntry_ = New Structure;
		MainEntry_.Insert("DocumentRegistryDate", Result);
		MainEntry_.Insert("DocumentRegistryOperation",
			Enums.BusinessTransactions.ExpensingToProductionLots);
		Return MainEntry_;
	EndIf;
	
	TableSavingMaterials = Object.UnusedMaterials.Unload(, "DateOfTransaction");
	For Each CurRow In TableSavingMaterials Do
		If ValueIsFilled(CurRow.DateOfTransaction) Then
			Result = Min(Result, CurRow.DateOfTransaction);
		EndIf;
	EndDo;
	
	If Not Result = MaxDate Then
		MainEntry_ = New Structure;
		MainEntry_.Insert("DocumentRegistryDate", Result);
		MainEntry_.Insert("DocumentRegistryOperation",
			Enums.BusinessTransactions.ReturnOfMaterialsFromProduction);
		Return MainEntry_;
	EndIf;
	
	If Not ValueIsFilled(Object.Date) Then
		Object.Date = CurrentSessionDate();
	EndIf;
	
	MainEntry_ = New Structure;
	MainEntry_.Insert("DocumentRegistryDate", Object.Date);
	MainEntry_.Insert("DocumentRegistryOperation", Enums.BusinessTransactions.ProductsRelease);
	Return MainEntry_;
	
EndFunction

