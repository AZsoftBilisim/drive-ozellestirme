#Region Other

// Returns the data of the production batch
//
// Parameters:
//  ReferenceOrder		 - DocumentRef.ProductionOrder2_2 - production order
//  AssignmentProducts	 - CatalogRef.Assignments			 - product designation ( when separated by purpose )
//  ProductionLot	 - CatalogRef.ProductionLots - Production batch
//
// Returns:
//  Structure - data of the batch launched into production.
//
Function ProductionBatchData(ReferenceOrder, AssignmentProducts, ProductionLot) Export
	
	BatchData = New Structure("
		|ReferenceOrder,
		|AssignmentProducts,
		|ProductionLot,
		|Organization,
		|InternalSubcontracting,
		|MaterialProviderCompany,
		|BusinessOperation,
		|Partner,
		|Contract,
		|ProductionStart,
		|ProductionDispatcherBusinessUnit,
		|LineOfBusiness,
		|BillOfMaterials,
		|ProductionProcessType,
		|MainProductProducts,
		|MainProductCharacteristic,
		|UnderRepairProduct,
		|UnderRepairVariant,
		|UnderRepairBatch,
		|Products,
		|Characteristic,
		|Count,
		|DynamicStructure");
	
	Query = New Query(
		"SELECT
		|	&ReferenceOrder                  AS ReferenceOrder,
		|	&AssignmentProducts           AS AssignmentProducts,
		|	&ProductionLot            AS ProductionLot,
		|
		|	Orders.Organization             AS Organization,
		|	Orders.BusinessOperation   AS BusinessOperation,
		|	Orders.Partner                 AS Partner,
		|	Orders.Contract                 AS Contract,
		|	Orders.EarliestStartDate           AS ProductionStart,
		|	Orders.Department           AS ProductionDispatcherBusinessUnit,
		|	Orders.LineOfBusiness AS LineOfBusiness,
		|	Orders.DynamicStructure   AS DynamicStructure,
		|
		|	ISNULL(Lots.BillOfMaterials,
		|		VALUE(Catalog.BillsOfMaterials.EmptyRef))           AS BillOfMaterials,
		|	ISNULL(Lots.ProcessType,
		|		VALUE(Enum.ProductionProcessTypes.EmptyRef)) AS ProductionProcessType,
		|	ISNULL(Lots.MainProductProducts,
		|		VALUE(Catalog.Products.EmptyRef))                    AS MainProductProducts,
		|	ISNULL(Lots.MainProductCharacteristic,
		|		VALUE(Catalog.ItemsCharacteristics.EmptyRef))      AS MainProductCharacteristic,
		|	ISNULL(Lots.UnderRepairProduct,
		|		VALUE(Catalog.Products.EmptyRef))                    AS UnderRepairProduct,
		|	ISNULL(Lots.UnderRepairVariant,
		|		VALUE(Catalog.ItemsCharacteristics.EmptyRef))      AS UnderRepairVariant,
		|	ISNULL(Lots.UnderRepairBatch,
		|		VALUE(Catalog.ItemsBatches.EmptyRef))               AS UnderRepairBatch,
		|	ISNULL(Lots.InternalSubcontracting, FALSE)                           AS InternalSubcontracting,
		|	CASE
		|		WHEN ISNULL(Lots.InternalSubcontracting, FALSE)
		|			THEN ISNULL(Lots.Organization, VALUE(Catalog.Companies.EmptyRef))
		|		ELSE VALUE(Catalog.Companies.EmptyRef)
		|	END                          AS MaterialProviderCompany
		|FROM
		|	Document.ProductionOrder2_2 AS Orders
		|	
		|	LEFT JOIN Catalog.ProductionLots AS Lots
		|	ON Lots.Ref = &ProductionLot
		|
		|WHERE
		|	Orders.Ref = &ReferenceOrder");
	Query.SetParameter("ReferenceOrder", ReferenceOrder);
	Query.SetParameter("AssignmentProducts", AssignmentProducts);
	Query.SetParameter("ProductionLot", ProductionLot);
	
	SetPrivilegedMode(True);
	Selection = Query.Execute().Select();
	SetPrivilegedMode(False);
	
	Selection.Next();
	FillPropertyValues(BatchData, Selection);
	
	BatchData.Products = Selection.MainProductProducts; // for compatibility of the calculation mechanism of standards
	BatchData.Characteristic = Selection.MainProductCharacteristic;
	BatchData.Count = 0;
	
	If Not ProductionLot.IsEmpty() Then
		
		If Selection.ProductionProcessType = Enums.ProductionProcessTypes.Disassembly Then
			
			Query.Text = 
				"SELECT
				|	SUM(Products_1.Count) AS Count
				|FROM
				|	Document.ProductionStage2_2 AS ProductionStage
				|		INNER JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS Products_1
				|			ON Products_1.Ref = ProductionStage.Ref
				|			AND Products_1.Products = ProductionStage.ProductionLot.MainProductProducts
				|			AND Products_1.Characteristic = ProductionStage.ProductionLot.MainProductCharacteristic
				|WHERE
				|	ProductionStage.ProductionLot = &ProductionLot
				|	AND ProductionStage.Posted
				|	AND NOT Products_1.Canceled
				|
				|HAVING
				|	SUM(Products_1.Count) > 0";
			
			SetPrivilegedMode(True);
			Selection = Query.Execute().Select();
			SetPrivilegedMode(False);
			
			If Selection.Next() Then
				BatchData.Count = Selection.Count;
			EndIf;
			
		Else
			
			Query.Text = 
				"SELECT
				|	SUM(NestedQuery.NumberOfTS)    AS NumberOfTS,
				|	SUM(NestedQuery.NumberOfCaps) AS NumberOfCaps
				|FROM
				|	(SELECT
				|		SUM(ISNULL(Products_1.Count, 0))       AS NumberOfTS,
				|		SUM(ProductionStage.NumberOfPackagesPlan
				|				* ISNULL(&PackagingFactor, 1)) AS NumberOfCaps
				|	FROM
				|		Document.ProductionStage2_2 AS ProductionStage
				|			LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS Products_1
				|				ON Products_1.Ref = ProductionStage.Ref
				|				AND Products_1.Products = ProductionStage.ProductionLot.MainProductProducts
				|				AND Products_1.Characteristic = ProductionStage.ProductionLot.MainProductCharacteristic
				|				AND NOT Products_1.Canceled
				|	WHERE
				|		ProductionStage.ProductionLot = &ProductionLot
				|		AND ProductionStage.Posted
				|		AND ProductionStage.NextStageNo = 0
				|	
				|	UNION ALL
				|	
				|	SELECT
				|		SUM(Products_1.Count),
				|		0
				|	FROM
				|		Document.ProductionStage2_2 AS ProductionStage
				|			INNER JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS Products_1
				|				ON Products_1.Ref = ProductionStage.Ref
				|				AND Products_1.Products = ProductionStage.ProductionLot.MainProductProducts
				|				AND Products_1.Characteristic = ProductionStage.ProductionLot.MainProductCharacteristic
				|	WHERE
				|		ProductionStage.ProductionLot = &ProductionLot
				|		AND ProductionStage.Posted
				|		AND ProductionStage.NextStageNo = 0
				|		AND NOT Products_1.Canceled) AS NestedQuery
				|
				|HAVING
				|	SUM(NestedQuery.NumberOfTS) > 0
				|		OR SUM(NestedQuery.NumberOfCaps) > 0";
			
			Query.Text = StrReplace(Query.Text,
				"&PackagingFactor",
				Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
					"ProductionStage.PackagePlan",
					"ProductionStage.ProductionLot.MainProductProducts"));
			
			SetPrivilegedMode(True);
			Selection = Query.Execute().Select();
			SetPrivilegedMode(False);
			
			If Selection.Next() Then
				BatchData.Count = ?(Selection.NumberOfTS <> 0,
					Selection.NumberOfTS,
					Selection.NumberOfCaps);
			EndIf;
			
		EndIf;
		
	EndIf;
	
	If ValueIsFilled(AssignmentProducts) Then
		BatchData.LineOfBusiness =
			ProductionManagementCached.DirectionOfActivityPurposeOfProduction(AssignmentProducts);
	EndIf;
	
	Return New FixedStructure(BatchData);
	
EndFunction

// Returns the main product of the stage chain (determined by the first line).
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage of production.
//
// Returns:
//   - Structure - The item and characteristics of the main finished product, as well as the finished product being repaired (if available).
//
Function MainProductOfChainOfStages(Ref) Export
	
	Query = New Query(
	"SELECT
	|	Document.ProductionLot.MainProductProducts        AS Products,
	|	Document.ProductionLot.MainProductCharacteristic      AS Characteristic,
	|	SUM(TabularSection.Count)                               AS Count,
	|	Document.ProductionLot.UnderRepairProduct   AS UnderRepairProduct,
	|	Document.ProductionLot.UnderRepairVariant AS UnderRepairVariant,
	|	Document.ProductionLot.UnderRepairBatch          AS UnderRepairBatch
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|	
	|	LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS TabularSection
	|	ON Document.ProductionLot = TabularSection.Ref.ProductionLot
	|	AND Document.ProductionLot.MainProductProducts = TabularSection.Products
	|	AND Document.ProductionLot.MainProductCharacteristic = TabularSection.Characteristic
	|	AND NOT TabularSection.Canceled
	|	AND TabularSection.Ref.Posted
	|WHERE
	|	Document.Ref = &Ref
	|	AND Document.ProductionLot.ProcessType IN (
	|		VALUE(Enum.ProductionProcessTypes.Assembly),
	|		VALUE(Enum.ProductionProcessTypes.PerformRM),
	|		VALUE(Enum.ProductionProcessTypes.Repair),
	|		VALUE(Enum.ProductionProcessTypes.WithoutBillsOfMaterials))
	|GROUP BY
	|	Document.ProductionLot
	|
	|UNION ALL
	|
	|SELECT
	|	Document.ProductionLot.MainProductProducts      AS Products,
	|	Document.ProductionLot.MainProductCharacteristic    AS Characteristic,
	|	SUM(TabularSection.Count)                             AS Count,
	|	VALUE(Catalog.Products.EmptyRef)               AS UnderRepairProduct,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS UnderRepairVariant,
	|	VALUE(Catalog.ItemsBatches.EmptyRef)          AS UnderRepairBatch
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|	
	|	LEFT JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS TabularSection
	|	ON Document.ProductionLot = TabularSection.Ref.ProductionLot
	|	AND Document.ProductionLot.MainProductProducts = TabularSection.Products
	|	AND Document.ProductionLot.MainProductCharacteristic = TabularSection.Characteristic
	|	AND NOT TabularSection.Canceled
	|	AND TabularSection.Ref.Posted
	|WHERE
	|	Document.Ref = &Ref
	|	AND Document.ProductionLot.ProcessType IN (
	|		VALUE(Enum.ProductionProcessTypes.Disassembly))
	|
	|GROUP BY
	|	Document.ProductionLot");
	
	Query.SetParameter("Ref", Ref);
	
	Result = New Structure;
	Result.Insert("Products");
	Result.Insert("Characteristic");
	Result.Insert("Count", 0);
	Result.Insert("UnderRepairProduct");
	Result.Insert("UnderRepairVariant");
	Result.Insert("UnderRepairBatch");
	
	QueryResult = Query.Execute();
	
	If Not QueryResult.IsEmpty() Then
		
		Selection = QueryResult.Select();
		If Selection.Next() Then
			FillPropertyValues(Result, Selection);
		EndIf;
		
	EndIf;
	
	Return Result;
	
EndFunction

// Returns a fraction of the cost of output items for the remaining stages of the chain
//
// Parameters:
//  Ref	 - DocumentRef.ProductionStage2_2 - stage of production.
//
// Returns:
//  Number - the share of the cost of output products of the remaining stages of the chain.
//
Function ShareOfValueOfRemainingStagesOfChain(Ref) Export
	
	Query = New Query(
	"SELECT
	|	ChainStages.Ref AS Ref
	|INTO PartyStages
	|FROM
	|	Document.ProductionStage2_2 AS ProductionStage
	|	
	|	INNER JOIN Document.ProductionStage2_2 AS ChainStages
	|	ON ChainStages.ProductionLot = ProductionStage.ProductionLot
	|
	|WHERE
	|	ProductionStage.Ref = &Ref
	|	AND NOT ChainStages.Ref = &Ref
	|	AND ChainStages.Posted
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SUM(TabularSection.CostShare) AS CostShare
	|FROM
	|	PartyStages AS Document
	|	
	|	INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS TabularSection
	|	ON Document.Ref = TabularSection.Ref
	|
	|WHERE
	|	NOT TabularSection.Canceled
	|HAVING
	|	SUM(TabularSection.CostShare) > 0
	|");
	
	Query.SetParameter("Ref", Ref);
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		Result = Selection.CostShare;
	Else
		Result = 0;
	EndIf;
	
	Return Result;
	
EndFunction

