#Region ChangingBatchesOfStages

// Reduces / increases the batch size with recalculation of data in tabular parts.
//
// Parameters:
//  BatchData - See ProductionBatchData
//  Parameters - Structure - action execution parameters
//  BatchSize - See NewBatchSize
//  Assignments - Structure - purpose Of Finished Products and Materials
//	FormIdentifier - UUID - id of the form that initiated
//		the data change. Used to lock data for editing.
// 
// Returns:
//  Structure - where the Key is the action performed, and the Value is an array of links to documents.
//
Function ChangeBatchSize(BatchData, Parameters, BatchSize, Assignments, FormIdentifier = Undefined) Export
	
	Result = DataProcessors.ProductionLotDivision.ResultOfProcessingConstructor();
	
	Stage = Parameters.Stage;
	RecalculateByFactor = Parameters.RecalculateByFactor;
	CancelChangeFinishedProductInOrder = Parameters.CancelChangeFinishedProductInOrder;
	
	// Selection of stages with verification
	If ValueIsFilled(Stage) Then
		References = BatchStagesForChange(BatchData.ProductionLot, Stage, Result.Cancel, Result.Messages);
		If Result.Cancel Then
			Return Result;
		EndIf;
		
		Data_Stage = Common.ObjectAttributesValues(
			Stage, "Posted, Status, Number, ProductionByThirdParty, SubcontractOrder");
		
		CheckResult = CheckDivisionPoint(Data_Stage);
		If CheckResult.Cancel Then
			Result.Cancel = True;
			Result.Messages.Add(CheckResult.MessageText);
			Return Result;
		EndIf;
		
		References.Add(Stage);
	Else
		References = BatchStagesForChange(BatchData.ProductionLot, Undefined, Result.Cancel, Result.Messages);
		If Result.Cancel Then
			Return Result;
		EndIf;
	EndIf;
	
	LinksToBlocking = Common.CopyRecursive(References);
	If CancelChangeFinishedProductInOrder Then
		LinksToBlocking.Add(BatchData.ReferenceOrder);
	EndIf;
	
	Try
		
		// Blocking objects
		For Each Ref In LinksToBlocking Do
			LockDataForEdit(Ref,, FormIdentifier);
		EndDo;
		
		// Reduction/increase
		BatchParameters = New Structure("BatchData, BatchSize", BatchData, BatchSize);
		StageData_1 = ?(RecalculateByFactor,
			StepDataForChangingBatches(References, False, True).RecalculationData,
			StepDataForChangingBatches(References, True, False).TheseAdditions);
		
		ChangeParameters = ChangeSizeOfLotReferenceInStagesParameters();
		FillPropertyValues(ChangeParameters, Parameters);
		If RecalculateByFactor Then
			RecalculationParameters = RecalculateParametersByCoefficient();
			RecalculationParameters.ChangeFact = False;
			RecalculationParameters.ChangeDivisionItem = False;
			ChangeParameters.ConversionParametersByCoefficient = RecalculationParameters;
		Else
			ChangeParameters.RecalculateDivisionItemInSpecificationData = False;
		EndIf;
		
		Changes = ChangeBatchSizeInStages(
			BatchParameters, References, StageData_1, RecalculateByFactor, Assignments, Result, ChangeParameters);
		
		If Result.Cancel Then
			For Each Ref In LinksToBlocking Do
				UnlockDataForEdit(Ref, FormIdentifier);
			EndDo;
			Return Result;
		EndIf;
		For Each Ref In Changes.ChangedStage Do
			Result.ChangedStage.Add(Ref);
		EndDo;
		For Each Ref In Changes.StageRemoved Do
			Result.StageRemoved.Add(Ref);
		EndDo;
		For Each Ref In Changes.StageIsNotRecorded Do
			Result.StageIsNotRecorded.Add(Ref);
		EndDo;
		For Each Ref In Changes.AdjustmentCreated Do
			Result.AdjustmentCreated.Add(Ref);
		EndDo;
		For Each Ref In Changes.OrderChanged Do
			Result.OrderChanged.Add(Ref);
		EndDo;
		
		// Transfer of reserves
		Senders = Common.CopyRecursive(Result.StageRemoved);
		CommonClientServer.SupplementArray(Senders, Result.ChangedStage);
		If Senders.UBound() <> -1 Then
			
			Recipients = ?(Result.StageRemoved.UBound() <> -1,
				Common.CopyRecursive(Result.ChangedStage),
				New Array);
			
			Changes = TransferReserves(Senders, Recipients);
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
		EndIf;
		
		// Filling in related registers
		If Not BatchData.DynamicStructure Then
			InformationRegisters.JobsForTargetProductionScheduleCalculation.AddJob(
				BatchData.ReferenceOrder, True);
		ElsIf Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.OrderStructureCalculationJobsProductionSchedule.AddJob(
				BatchData.ReferenceOrder,,, True);
		EndIf;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.StatesOfProductionOrders = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			BatchData.ReferenceOrder,,
			RegistersToBeReflected);
		
		If UseOperationsInStages() Then
			InformationRegisters.JobsForCalculatingProductionOperationQueue.StartJobs();
		EndIf;
		
	Except
		
		For Each Ref In LinksToBlocking Do
			UnlockDataForEdit(Ref, FormIdentifier);
		EndDo;
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
					|it = 'Fase di produzione';
					|pl = 'Etap produkcji';
					|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Thay đổi kích thước lô hàng';
					|ru = 'Изменение размера партии';
					|en = 'Lot size change'; fa = 'Lot size change';
					|it = 'Modifica della dimensione del lotto';
					|pl = 'Zmiana rozmiaru partii';
					|tr = 'Lot boyutunun değiştirilmesi'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,,,
			DetailErrorDescription(ErrorInfo()));
		
		Raise BriefErrorDescription(ErrorInfo());
		
	EndTry;
	
	For Each Ref In LinksToBlocking Do
		UnlockDataForEdit(Ref, FormIdentifier);
	EndDo;
	
	Return Result;
	
EndFunction

// Refills documents according to the resource specification.
//
// Parameters:
//  ProductionLot - CatalogRef.ProductionLots - link to The Lot Reference.
//  Parameters - Structure - action execution parameters:
//		* Stage - DocumentRef.ProductionStage2_2 - the document to start the action from.
//		* BOMStage - CatalogRef.ProductionStages - the element to start the action from.
//			In the general case, it corresponds to the link in the stage-document. If the composition of the specification stages has been changed, then the parameter
//			specifies the place from which it is necessary to create documents.
//		* ReserveMaterials - Boolean
//		* ReplaceMaterialsWithAnalogs - Boolean
//	FormIdentifier - UUID - id of the form that initiated
//		the data change. Used to lock data for editing.
// 
// Returns:
//  Structure - where the Key is the action performed, and the Value is an array of links to documents.
//
Function ReFillBatch(ProductionLot, Parameters, FormIdentifier = Undefined) Export
	
	Result = DataProcessors.ProductionLotDivision.ResultOfProcessingConstructor();
	
	// Reading party details
	AttributesValues = Common.ObjectAttributesValues(ProductionLot, "Document, Purpose");
	
	BatchData = ProductionBatchData(
		AttributesValues.Document, AttributesValues.Purpose, ProductionLot);
	BatchData = New Structure(BatchData);
	
	BatchSize = NewBatchSize(BatchData.Count, Undefined, Undefined);
	
	Assignments = New Structure;
	Assignments.Insert("ManufacturedProductAssignments", New ValueTable);
	Assignments.Insert("AssignmentsOfMaterials", 
		ProductionSupply.CoefficientsOfSecurityAssignmentsInProductionStage(BatchData, New ValueTable));
	
	Stage = Parameters.Stage;
	BOMStage = ?(Parameters.Property("BOMStage"), Parameters.BOMStage, Undefined);
	
	// Selection of stages with verification
	If ValueIsFilled(Stage) Then
		QueryTexts = New Array;
		QueryTexts.Add(
			"SELECT
			|	ProductionStage2_2.Ref AS Ref,
			|	ISNULL(StandardScheduleOfProductionStages.DurationBeforeProductionIssue, ProductionStage2_2.DurationBeforeProductionIssue) AS DurationBeforeProductionIssue,
			|	ProductionStage2_2.ProductionProcessType IN (
			|		VALUE(Enum.ProductionProcessTypes.Assembly),
			|		VALUE(Enum.ProductionProcessTypes.PerformRM),
			|		VALUE(Enum.ProductionProcessTypes.Repair)) AS ThisIsKitForRAndM
			|INTO TTStages
			|FROM
			|	Document.ProductionStage2_2 AS ProductionStage2_2
			|
			|	LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardScheduleOfProductionStages
			|	ON ProductionStage2_2.Ref = StandardScheduleOfProductionStages.ProductionStage
			|WHERE
			|	ProductionStage2_2.ProductionLot = &ProductionLot
			|	AND ProductionStage2_2.Posted
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Successors.Ref AS Ref
			|FROM
			|	TTStages AS Stage
			|	
			|	INNER JOIN TTStages AS Successors
			|	ON Stage.DurationBeforeProductionIssue >= Successors.DurationBeforeProductionIssue
			|WHERE
			|	Stage.Ref = &Ref
			|	AND Successors.Ref <> &Ref
			|
			|ORDER BY
			|	-Successors.DurationBeforeProductionIssue
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT TOP 1
			|	TRUE AS ThereIsReleaseLimit
			|FROM
			|	Document.ProductionStage2_2.ManufacturedProducts AS Products_1
			|WHERE
			|	Products_1.Ref IN (
			|		SELECT
			|			Stages.Ref AS Ref
			|		FROM
			|			TTStages AS Stages
			|		WHERE
			|			Stages.ThisIsKitForRAndM)
			|	AND Products_1.Manufactured");
		If Not ValueIsFilled(BOMStage) Then
			QueryTexts.Add(
				"SELECT
				|	MAX(CASE
				|		WHEN NOT ISNULL(Document.Stage.DeletionMark, FALSE)
				|			THEN Document.Stage
				|		ELSE ISNULL(ProductionStages.Ref, VALUE(Catalog.ProductionStages.EmptyRef))
				|	END) AS BOMStage
				|FROM
				|	Document.ProductionStage2_2 AS Document
				|	
				|	LEFT JOIN Catalog.ProductionStages AS ProductionStages
				|	ON Document.BillOfMaterials = ProductionStages.Owner
				|		AND Document.Stage.Description = ProductionStages.Description
				|		AND NOT ProductionStages.DeletionMark
				|WHERE
				|	Document.Ref = &Ref
				|
				|HAVING
				|	COUNT(
				|		DISTINCT CASE
				|			WHEN NOT ISNULL(Document.Stage.DeletionMark, FALSE)
				|				THEN Document.Stage
				|			ELSE ISNULL(ProductionStages.Ref, VALUE(Catalog.ProductionStages.EmptyRef))
				|		END
				|	) = 1");
		EndIf;
		
		Query = New Query(ProductionManagement.CombineRequestTextsIntoPackage(QueryTexts));
		Query.SetParameter("Ref", Stage);
		Query.SetParameter("ProductionLot", ProductionLot);
		ResultsArray = Query.ExecuteBatch();
		
		Table = ResultsArray[1].Unload();
		
		AllFollowers = Documents.ProductionStage2_2.AllFollowers(Stage, ProductionLot);
		If AllFollowers.Count() <> Table.Count() Then
			Result.Cancel = True;
			Result.Messages.Add(
				NStr("vi = 'Trong điểm sản xuất đã chọn có các lộ trình thực hiện thực hiện song song, không thể thực hiện thao tác.';
					|ru = 'В выбранной точке производственного процесса имеются параллельные маршруты выполнения, действие не может быть выполнено.';
					|en = 'There are parallel execution routes at the selected production process point; the action cannot be completed.'; fa = 'There are parallel execution routes at the selected production process point; the action cannot be completed.';
					|it = 'В выбранной точке производственного процесса имеются параллельные маршруты выполнения, действие не может быть выполнено.';
					|pl = 'There are parallel execution routes at the selected production process point; the action cannot be completed.';
					|tr = 'Üretim sürecinin seçilen noktasında paralel gerçekleştirme yolları mevcut, eylem gerçekleştirilemez.'"));
		EndIf;
		
		If Not ResultsArray[2].IsEmpty() Then
			Result.Cancel = True;
			Result.Messages.Add(
				NStr("vi = 'Không thể điền lại các công đoạn, bởi vì trong lô hàng đã tạo xuất xưởng sản phẩm theo giá trị đã tính.';
					|ru = 'Этапы не могут быть перезаполнены, так как в партии оформлен выпуск изделий по рассчитываемой стоимости.';
					|en = 'The stages cannot be refilled as product release at the calculated cost is registered in the lot.'; fa = 'The stages cannot be refilled as product release at the calculated cost is registered in the lot.';
					|it = 'Этапы не могут быть перезаполнены, так как в партии оформлен выпуск изделий по рассчитываемой стоимости.';
					|pl = 'The stages cannot be refilled as product release at the calculated cost is registered in the lot.';
					|tr = 'Aşamalar yeniden doldurulamaz, çünkü lot bazından hesaplanan maliyetle nihai ürünlerin çıkışı düzenlendi.'"));
		EndIf;
		
		References = Table.UnloadColumn("Ref");
		References.Add(Stage);
		
		If Not ValueIsFilled(BOMStage) Then
			Selection = ResultsArray[3].Select();
			If Selection.Next() Then
				BOMStage = Selection.BOMStage;
			EndIf;
		EndIf;
	Else
		Query = New Query(
			"SELECT
			|	Stages.Ref AS Ref,
			|	Stages.ProductionProcessType IN (
			|			VALUE(Enum.ProductionProcessTypes.Assembly),
			|			VALUE(Enum.ProductionProcessTypes.PerformRM),
			|			VALUE(Enum.ProductionProcessTypes.Repair))
			|		AND TRUE IN (
			|			SELECT TOP 1
			|				TRUE
			|			FROM
			|				Document.ProductionStage2_2.ManufacturedProducts AS Products_1
			|			WHERE
			|				Products_1.Ref = Stages.Ref
			|				AND Products_1.Manufactured) AS ThereIsReleaseLimit
			|FROM
			|	Document.ProductionStage2_2 AS Stages
			|	
			|	LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS RegulatorySchedule
			|	ON Stages.Ref = RegulatorySchedule.ProductionStage
			|WHERE
			|	Stages.ProductionLot = &ProductionLot
			|	AND Stages.Posted
			|
			|ORDER BY
			|	ISNULL(RegulatorySchedule.DurationBeforeStart, -Stages.DurationBeforeProductionIssue)");
		Query.SetParameter("ProductionLot", ProductionLot);
		Table = Query.Execute().Unload();
		
		If Table.Count() = 0 Then
			Result.Cancel = True;
			Result.Messages.Add(
				NStr("vi = 'Không có công đoạn của lô hàng để thực hiện thao tác.';
					|ru = 'Отсутствуют этапы партии для выполнения действия.';
					|en = 'There are no lot stages to complete the action.'; fa = 'There are no lot stages to complete the action.';
					|it = 'Mancano le fasi del lotto per eseguire l''azione.';
					|pl = 'Brak etapów partii w celu wykonania czynności.';
					|tr = 'Eylemin gerçekleştirilmesi için lot aşamaları bulunmamaktadır.'"));
		ElsIf Table.Find(True, "ThereIsReleaseLimit") <> Undefined Then
			Result.Cancel = True;
			Result.Messages.Add(
				NStr("vi = 'Không thể điền lại các công đoạn, bởi vì trong lô hàng đã tạo xuất xưởng sản phẩm theo giá trị đã tính.';
					|ru = 'Этапы не могут быть перезаполнены, так как в партии оформлен выпуск изделий по рассчитываемой стоимости.';
					|en = 'The stages cannot be refilled as product release at the calculated cost is registered in the lot.'; fa = 'The stages cannot be refilled as product release at the calculated cost is registered in the lot.';
					|it = 'Этапы не могут быть перезаполнены, так как в партии оформлен выпуск изделий по рассчитываемой стоимости.';
					|pl = 'The stages cannot be refilled as product release at the calculated cost is registered in the lot.';
					|tr = 'Aşamalar yeniden doldurulamaz, çünkü lot bazından hesaplanan maliyetle nihai ürünlerin çıkışı düzenlendi.'"));
		Else
			References = Table.UnloadColumn("Ref");
		EndIf;
	EndIf;
	
	If Result.Cancel Then
		Return Result;
	EndIf;
	
	Try
		
		// Blocking objects
		For Each Ref In References Do
			LockDataForEdit(Ref,, FormIdentifier);
		EndDo;
		
		// Refilling
		BatchParameters = New Structure("BatchData, BatchSize", BatchData, BatchSize);
		StageData_1 = StepDataForChangingBatches(References, True, False).TheseAdditions;
		
		ChangeParameters = ChangeSizeOfLotReferenceInStagesParameters();
		FillPropertyValues(ChangeParameters, Parameters);
		ChangeParameters.RecalculateDivisionItemInSpecificationData = False;
		ChangeParameters.ChangeCompositionOfDocuments = True;
		ChangeParameters.BOMStage = BOMStage;
		
		Changes = ChangeBatchSizeInStages(
			BatchParameters, References, StageData_1, False, Assignments, Result, ChangeParameters);
		
		If Result.Cancel Then
			For Each Ref In References Do
				UnlockDataForEdit(Ref, FormIdentifier);
			EndDo;
			Return Result;
		EndIf;
		For Each Ref In Changes.StageCreated Do
			Result.StageCreated.Add(Ref);
		EndDo;
		For Each Ref In Changes.ChangedStage Do
			Result.ChangedStage.Add(Ref);
		EndDo;
		For Each Ref In Changes.StageRemoved Do
			Result.StageRemoved.Add(Ref);
		EndDo;
		For Each Ref In Changes.StageIsNotRecorded Do
			Result.StageIsNotRecorded.Add(Ref);
		EndDo;
		For Each Ref In Changes.AdjustmentCreated Do
			Result.AdjustmentCreated.Add(Ref);
		EndDo;
		
		// Transfer of reserves
		Senders = Common.CopyRecursive(Result.StageRemoved);
		CommonClientServer.SupplementArray(Senders, Result.ChangedStage);
		If Senders.UBound() <> -1 Then
			
			Recipients = Common.CopyRecursive(Result.StageCreated);
			If Result.StageRemoved.UBound() <> -1 Then
				CommonClientServer.SupplementArray(Recipients, Result.ChangedStage);
			EndIf;
			
			Changes = TransferReserves(Senders, Recipients);
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
		EndIf;
		
		// Filling in related registers
		If Not BatchData.DynamicStructure Then
			InformationRegisters.JobsForTargetProductionScheduleCalculation.AddJob(
				BatchData.ReferenceOrder, True);
		ElsIf Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.OrderStructureCalculationJobsProductionSchedule.AddJob(
				BatchData.ReferenceOrder,,, True);
		EndIf;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.StatesOfProductionOrders = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			BatchData.ReferenceOrder,,
			RegistersToBeReflected);
		
		If UseOperationsInStages() Then
			InformationRegisters.JobsForCalculatingProductionOperationQueue.StartJobs();
		EndIf;
		
	Except
		
		For Each Ref In References Do
			UnlockDataForEdit(Ref, FormIdentifier);
		EndDo;
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
					|it = 'Fase di produzione';
					|pl = 'Etap produkcji';
					|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Thay đổi kích thước lô hàng';
					|ru = 'Изменение размера партии';
					|en = 'Lot size change'; fa = 'Lot size change';
					|it = 'Modifica della dimensione del lotto';
					|pl = 'Zmiana rozmiaru partii';
					|tr = 'Lot boyutunun değiştirilmesi'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,,,
			DetailErrorDescription(ErrorInfo()));
		
		Raise BriefErrorDescription(ErrorInfo());
		
	EndTry;
	
	For Each Ref In References Do
		UnlockDataForEdit(Ref, FormIdentifier);
	EndDo;
	
	Return Result;
	
EndFunction

// Marks the stages of the specified production batch for deletion.
//
// Parameters:
//  BatchData - See ProductionBatchData
//  Parameters - Structure - action execution parameters
//	ManufacturedProducts - ValueTable - output FINISHED products at the calculated cost,
//		which will be placed in the release stage of the batch.
//		The composition of the fields is similar to the Attributes of the tabular part of the production stage of the same name.
//	SetOfSeries - ValueTable - series of output products.
//	FormIdentifier - UUID - id of the form that initiated
//		the data change. Used to lock data for editing.
//	
// Returns:
//  Structure - where the Key is the action performed, and the Value is an array of links to documents.
//
Function CancelParty(BatchData, Parameters, ManufacturedProducts, SetOfSeries, FormIdentifier = Undefined) Export
	
	Result = DataProcessors.ProductionLotDivision.ResultOfProcessingConstructor();
	
	FromBeginningOfParty = Parameters.FromBeginningOfParty;
	Stage = Parameters.Stage;
	OperationID = Parameters.OperationID;
	ItSNonconformityMarriage = Parameters.ItSNonconformityMarriage;
	NumberOfPackagingUnitsNonconformity = Parameters.NumberOfPackagingUnitsNonconformity;
	PackagingDefectiveGoods = Parameters.PackagingDefectiveGoods;
	CancelChangeFinishedProductInOrder = Parameters.CancelChangeFinishedProductInOrder;
	ReasonForCancelingFinishedProduct = Parameters.ReasonForCancelingFinishedProduct;
	
	// Selection of stages with verification
	If FromBeginningOfParty Then
		
		References = BatchStagesForChange(BatchData.ProductionLot, Undefined, Result.Cancel, Result.Messages);
		If Result.Cancel Then
			Return Result;
		EndIf;
		
		QueueManager = Undefined;
		CancelWithinStage = False;
		IntermediateReleaseStage = Undefined;
		ThisIsCancellationOfWorkPlanning = False;
		
		LinksToBlocking = Common.CopyRecursive(References);
		LinksToDataTransmission = Common.CopyRecursive(References);
		LinksToDelete = Common.CopyRecursive(References);
		
	Else
		
		References = BatchStagesForChange(BatchData.ProductionLot, Stage, Result.Cancel, Result.Messages);
		If Result.Cancel Then
			Return Result;
		EndIf;
		
		Data_Stage = Common.ObjectAttributesValues(
			Stage, "Posted, Status, Number, ProductionByThirdParty, SubcontractOrder, WorkPlanning");
		
		CheckResult = CheckDivisionPoint(Data_Stage);
		If CheckResult.Cancel Then
			Result.Cancel = True;
			Result.Messages.Add(CheckResult.MessageText);
			Return Result;
		EndIf;
		
		QueueManager = New TempTablesManager();
		DataProcessors.ProductionLotDivision.CreateTTQueueOfOperationsForDivision(QueueManager, Stage);
		
		CheckResult = CheckDivisionPointQueue(OperationID, QueueManager, False, ItSNonconformityMarriage, Not ItSNonconformityMarriage);
		If CheckResult.Cancel Then
			Result.Cancel = True;
			Result.Messages.Add(CheckResult.MessageText);
			Return Result;
		EndIf;
	
		CancelWithinStage = (Data_Stage.Status = Enums.StatusesOfProductionStages2_2.Initiated)
			Or CheckResult.ThisIsChangeInsideQueue
			Or ItSNonconformityMarriage;
		
		If CancelWithinStage
			And Data_Stage.WorkPlanning Then
			IntermediateReleaseStage = Undefined;
			ThisIsCancellationOfWorkPlanning = True;
		Else
			IntermediateReleaseStage = ?(CancelWithinStage, Stage, StageForIntermediateRelease(Stage));
			ThisIsCancellationOfWorkPlanning = False;
		EndIf;
		
		// Auxiliary collections:
		//  Blocked - blocked
		//  Data transmission - transfer analytics of their TS and warehouse reserves to new documents
		//  Deleted - marked for deletion
		LinksToBlocking = Common.CopyRecursive(References);
		LinksToBlocking.Add(Stage);
		If Not CancelWithinStage And IntermediateReleaseStage <> Undefined Then
			LinksToBlocking.Add(IntermediateReleaseStage);
		EndIf;
		If IntermediateReleaseStage = Undefined
			And Not ThisIsCancellationOfWorkPlanning Then
			Predecessors = PredecessorsInStageQueue(Stage);
			For Each Predecessor In Predecessors Do
				LinksToBlocking.Add(Predecessor);
			EndDo;
		EndIf;
		
		LinksToDataTransmission = Common.CopyRecursive(References);
		LinksToDataTransmission.Add(Stage);
		
		LinksToDelete = Common.CopyRecursive(References);
		If Not CancelWithinStage Then
			LinksToDelete.Add(Stage);
		EndIf;
		
	EndIf;
	
	If CancelChangeFinishedProductInOrder Then
		LinksToBlocking.Add(BatchData.ReferenceOrder);
	EndIf;
	
	Try
		
		// Blocking objects
		For Each Ref In LinksToBlocking Do
			LockDataForEdit(Ref,, FormIdentifier);
		EndDo;
		
		QueryText =
			"SELECT
			|	Inventories.Products AS Products,
			|	Inventories.Characteristic AS Characteristic,
			|	Inventories.Warehouse AS Warehouse,
			|	Inventories.Purpose AS Purpose,
			|	Inventories.OrderDocument AS OrderDocument,
			|	Inventories.LockedInStockBalance AS LockedInStockBalance,
			|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
			|	Inventories.ToUnlockBalance AS ToUnlockBalance,
			|	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
			|	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
			|INTO InventoryAndNeedsBalanceOfControlledLotsReference
			|FROM
			|	AccumulationRegister.InventoryAndDemands.Balance(,
			|		Purpose IN(
			|			SELECT
			|				Stages.Purpose AS Purpose
			|			FROM
			|				Document.ProductionStage2_2 AS Stages
			|			WHERE
			|				Stages.Ref IN (&References))) AS Inventories
			|INDEX BY
			|	Products, Characteristic, Warehouse, Purpose
			|;
			|
			|//////////////////////////////////////////////////
			|SELECT
			|	Inventories.Products AS Products,
			|	Inventories.Characteristic AS Characteristic,
			|	Inventories.Warehouse AS Warehouse,
			|	Inventories.Purpose AS Purpose,
			|	Inventories.InStockBalance AS InStockBalance,
			|	Inventories.LockedInStockBalance AS LockedInStockBalance,
			|	Inventories.OrderedBalance AS OrderedBalance,
			|	Inventories.Received_1Balance AS Received_1Balance,
			|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
			|	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
			|	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
			|	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
			|	Inventories.ToSupplyBalance AS ToSupplyBalance,
			|	Inventories.NotProvideBalance AS NotProvideBalance
			|INTO InventoryAndDemandsBalance
			|FROM
			|	AccumulationRegister.InventoryAndDemands.Balance(,
			|		Purpose IN(
			|			SELECT
			|				Stages.Purpose AS Purpose
			|			FROM
			|				Document.ProductionStage2_2 AS Stages
			|			WHERE
			|				Stages.Ref IN (&References))) AS Inventories
			|INDEX BY
			|	Products, Characteristic, Warehouse, Purpose
			|;
			|
			|//////////////////////////////////////////////////
			|SELECT
			|	Calculation.Products AS Products,
			|	Calculation.Characteristic AS Characteristic,
			|	Calculation.Warehouse AS Warehouse,
			|	Calculation.Purpose AS Purpose,
			|	Calculation.ControlledLotReference AS ControlledLotReference,
			|	Calculation.QuantityWithoutControlOfReservesForShipAction AS Count,
			|	Calculation.QuantityWithoutControlOfReservesForShipAction AS NumberOfPackages
			|FROM
			|		CalculationOfBalancesForSettingActions AS Calculation
			|WHERE
			|	Calculation.QuantityWithoutControlOfReservesForShipAction > 0";
		
		TablesNames = ProvisionInDocumentsServer.NewTableNamesForCalculatingBalancesForSettingActions();
		TablesNames.Balance = "InventoryAndDemandsBalance"; // @query-part-1
		TablesNames.BalanceSheetsOfControlledLotREFERENCES = "InventoryAndNeedsBalanceOfControlledLotsReference"; // @query-part-1
		TablesNames.Result = "CalculationOfBalancesForSettingActions"; // @query-part-1
		ProvisionInDocumentsServer.CalculationOfBalancesForSettingActions(QueryText, TablesNames);

		// Adjustment of appointments
		Query = New Query(QueryText);
		Query.SetParameter("References", LinksToDataTransmission);
		Goods = Query.Execute().Unload();
		If Goods.Count() > 0 Then
			HeaderAttributes = New Structure();
			HeaderAttributes.Insert("Date", CurrentSessionDate());
			HeaderAttributes.Insert("OperationKind", Enums.KindsOfAssignmentAdjustmentOperations.RemoveFromReserveForMultipleAssignments);
			HeaderAttributes.Insert("Organization", Common.ObjectAttributeValue(LinksToDataTransmission[0], "Organization"));
			
			DocumentObject = Documents.InventoryAssignmentAdjustment.CreateDocument();
			DocumentObject.Fill(New Structure("HeaderAttributes, Goods", HeaderAttributes, Goods));
			
			ProductsServer.FillInStatusesForSpecifyingSeries(
				DocumentObject,
				Documents.InventoryAssignmentAdjustment.SeriesSpecificationParameters(DocumentObject));
			
			If DocumentObject.CheckFilling() Then
				Try
					DocumentObject.Write(DocumentWriteMode.Posting);
				Except
					Common.MessageToUser(
						BriefErrorDescription(ErrorInfo()));
					
					Event = NStr("vi = 'Công đoạn sản xuất';
								|ru = 'Этап производства';
								|en = 'Production stage'; fa = 'مرحله تولید';
								|it = 'Fase di produzione';
								|pl = 'Etap produkcji';
								|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
						+ NStr("vi = 'Hủy bỏ lô hàng';
								|ru = 'Отмена партии';
								|en = 'Lot cancellation'; fa = 'Lot cancellation';
								|it = 'Annullare lotto';
								|pl = 'Anulowanie partii';
								|tr = 'Lotun iptali'", Common.DefaultLanguageCode());
					WriteLogEvent(Event,
						EventLogLevel.Error,,,
						DetailErrorDescription(ErrorInfo()));
					
					DocumentObject.Write(DocumentWriteMode.Write);
				EndTry;
			Else
				DocumentObject.Write(DocumentWriteMode.Write);
			EndIf;
			
			Result.AdjustmentCreated.Add(DocumentObject.Ref);
		EndIf;
		
		// Mark for deletion
		For Each Ref In LinksToDelete Do
			DocumentObject = Ref.GetObject();
			DocumentObject.SetDeletionMark(True);
			
			Result.StageRemoved.Add(Ref);
		EndDo;
		
		If Not FromBeginningOfParty Then
			// Party Update
			MainProduct = New Structure;
			MainProduct.Insert("Products", BatchData.MainProductProducts);
			MainProduct.Insert("Characteristic", BatchData.MainProductCharacteristic);
			MainProduct.Insert("UnderRepairProduct", BatchData.UnderRepairProduct);
			MainProduct.Insert("UnderRepairVariant", BatchData.UnderRepairVariant);
			MainProduct.Insert("UnderRepairBatch", BatchData.UnderRepairBatch);
			
			Catalogs.ProductionLots.CreateUpdateProductionBatch(
				BatchData.ProductionLot,
				BatchFields(BatchData, MainProduct),
				True);
			
			// Registration of an interim issue
			If IntermediateReleaseStage = Undefined Then
				NewStage = ToIssueInterimIssueInNewStage(
					BatchData, Stage, ManufacturedProducts, SetOfSeries, Parameters, Not ThisIsCancellationOfWorkPlanning);
				Result.StageCreated.Add(NewStage);
				
				If ThisIsCancellationOfWorkPlanning Then
					DocumentObject = Stage.GetObject(); // DocumentObject.ProductionStage2_2
					
					If DocumentObject.NextStageNo = 0 Then
						DocumentObject.NextStageNo = DocumentObject.StageNumber + 1;
					EndIf;
					
					DocumentObject.Successors.Clear();
					NewRow = DocumentObject.Successors.Add();
					NewRow.Stage = NewStage;
					NewRow.LinkType = CommunicationTypeFollower();
					
					DeletePlannedLines(BatchData, DocumentObject);
					
					DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
					DocumentWritten = ConductWithDowngradedStatus(DocumentObject);
					
					If DocumentWritten Then
						Result.ChangedStage.Add(Stage);
					Else
						Result.StageIsNotRecorded.Add(Stage);
					EndIf;
				Else
					// If there was a release of intermediate products at a fixed cost at the stage - point of division,
					// then it is necessary to reflect the consumption of these products in the "technical" stage to exclude
					// the doubling of output
					Adjusting = ReflectConsumptionOfByProductsInIntermediateRelease(
						NewStage, LinksToDelete);
					If Adjusting <> Undefined Then
						Result.AdjustmentCreated.Add(Adjusting);
					EndIf;
				EndIf;
			Else
				DocumentObject = IntermediateReleaseStage.GetObject();
				
				If CancelWithinStage Then
					// Changing the header
					If ItSNonconformityMarriage
						And DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.Initiated Then
						DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated;
						DocumentObject.ActualStageStart = CurrentSessionDate();
					EndIf;
					
					If ItSNonconformityMarriage Then
						If DocumentObject.NumberOfPackagesReal = 0 Then
							DocumentObject.NumberOfPackagesReal = NumberOfPackagingUnitsNonconformity;
							DocumentObject.PackageActualData = PackagingDefectiveGoods;
						EndIf;
					Else
						If DocumentObject.NumberOfPackagesCanceled = 0 Then
							DocumentObject.PackageCanceled = DocumentObject.PackagePlan;
							If DocumentObject.PackageActualData = DocumentObject.PackagePlan Then
								DocumentObject.NumberOfPackagesCanceled = DocumentObject.NumberOfPackagesPlan
									- DocumentObject.NumberOfPackagesReal;
							Else
								CoefficientPlan = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
									DocumentObject.PackagePlan, BatchData.MainProductProducts);
								CoefficientFact = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
									DocumentObject.PackageActualData, BatchData.MainProductProducts);
								NumberOfPackagesReal = DocumentObject.NumberOfPackagesReal
									* CoefficientFact
									/ CoefficientPlan;
								DocumentObject.NumberOfPackagesCanceled = DocumentObject.NumberOfPackagesPlan
									- NumberOfPackagesReal;
							EndIf;
						EndIf;
					EndIf;
					
					SetLastOperation(DocumentObject, OperationID, QueueManager);
					
					// TS Change
					DeletePlannedLines(BatchData, DocumentObject);
				EndIf;
				
				IssueInterimRelease(BatchData, DocumentObject, ManufacturedProducts, SetOfSeries, Parameters);
				
				DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
				DocumentWritten = ConductWithDowngradedStatus(DocumentObject);
				
				If DocumentWritten Then
					Result.ChangedStage.Add(IntermediateReleaseStage);
				Else
					Result.StageIsNotRecorded.Add(IntermediateReleaseStage);
				EndIf;
			EndIf;
		EndIf;
		
		// Filling in related registers
		If Not BatchData.DynamicStructure Then
			InformationRegisters.JobsForTargetProductionScheduleCalculation.AddJob(
				BatchData.ReferenceOrder, True);
		ElsIf Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.OrderStructureCalculationJobsProductionSchedule.AddJob(
				BatchData.ReferenceOrder,,, True);
		EndIf;
		If UseOperationsInStages() Then
			InformationRegisters.JobsForCalculatingProductionOperationQueue.StartJobs();
		EndIf;
		
		// Order change
		If CancelChangeFinishedProductInOrder Then
			DocumentObject = BatchData.ReferenceOrder.GetObject(); // DocumentObject.ProductionOrder2_2
			DocumentObject.CancelProducts(
				BatchData.MainProductProducts,
				BatchData.MainProductCharacteristic,
				BatchData.BillOfMaterials,
				BatchData.Count,
				ReasonForCancelingFinishedProduct);
			DocumentObject.Write(DocumentWriteMode.Posting);
			Result.OrderChanged.Add(BatchData.ReferenceOrder);
		EndIf;
		
	Except
		
		For Each Ref In LinksToBlocking Do
			UnlockDataForEdit(Ref, FormIdentifier);
		EndDo;
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
					|it = 'Fase di produzione';
					|pl = 'Etap produkcji';
					|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Hủy bỏ lô hàng';
					|ru = 'Отмена партии';
					|en = 'Lot cancellation'; fa = 'Lot cancellation';
					|it = 'Annullare lotto';
					|pl = 'Anulowanie partii';
					|tr = 'Lotun iptali'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,,,
			DetailErrorDescription(ErrorInfo()));
		
		Raise BriefErrorDescription(ErrorInfo());
		
	EndTry;
	
	For Each Ref In LinksToBlocking Do
		UnlockDataForEdit(Ref, FormIdentifier);
	EndDo;
	
	Return Result;
	
EndFunction

// Divides the party into several parallel parties. Division occurs from the first stage.
// 
// Parameters:
//  BatchData - See ProductionBatchData
// 	NewParties - Array of See NewBatchSize
//  Assignments - Array of Structure - purpose Of Finished Products and Materials
//  Parameters - Structure - action execution parameters
//	FormIdentifier - UUID - id of the form that initiated
//		the data change. Used to lock data for editing.
// 	
// Returns:
//  Structure - where the Key is the action performed, and the Value is an array of links to documents.
//
Function SplitParty(BatchData, NewParties, Assignments, Parameters, FormIdentifier = Undefined) Export
	
	FillInByBOM = Parameters.FillInByBOM;
	
	Result = DataProcessors.ProductionLotDivision.ResultOfProcessingConstructor();
	
	If NewParties.Count() = 0 Then
		Return Result;
	EndIf;
	
	// Selection of stages with verification
	References = BatchStagesForChange(BatchData.ProductionLot, Undefined, Result.Cancel, Result.Messages);
	If Result.Cancel Then
		Return Result;
	EndIf;
	
	Try
		
		// Blocking objects
		For Each Ref In References Do
			LockDataForEdit(Ref,, FormIdentifier);
		EndDo;
		
		If Not FillInByBOM Then
			
			RecalculationData = StepDataForChangingBatches(References, False, True).RecalculationData;
			
			// Changing the current batch (batch #1)
			BatchParameters = New Structure("BatchData, BatchSize", BatchData, NewParties[0]);
			
			RecalculationParameters = RecalculateParametersByCoefficient();
			RecalculationParameters.ChangeFact = False;
			RecalculationParameters.ChangeDivisionItem = True;
			
			ChangeParameters = ChangeSizeOfLotReferenceInStagesParameters();
			FillPropertyValues(ChangeParameters, Parameters);
			ChangeParameters.ConversionParametersByCoefficient = RecalculationParameters;
			
			Changes = ChangeBatchSizeInStages(
				BatchParameters, References, RecalculationData, True, Assignments[0], Result, ChangeParameters);
			
			If Result.Cancel Then
				For Each Ref In References Do
					UnlockDataForEdit(Ref, FormIdentifier);
				EndDo;
				Return Result;
			EndIf;
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageRemoved Do
				Result.StageRemoved.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
			// Division Attributes
			AdditionalAttributes = New Map;
			For Each Data_Stage In RecalculationData.Attributes Do
				If Data_Stage.FirstOperationID <> 0
					Or Data_Stage.LastOperationID <> 0
					Or ValueIsFilled(Data_Stage.Predecessor) Then
					DivisionAttributes = DataProcessors.ProductionLotDivision.DivisionAttributesConstructor();
					FillPropertyValues(DivisionAttributes, Data_Stage);
					AdditionalAttributes.Insert(Data_Stage.Ref, New Structure("DivisionAttributes", DivisionAttributes));
				EndIf;
			EndDo;
			
			// Creation of parties No. 2+
			RecalculationParameters = RecalculateParametersByCoefficient();
			RecalculationParameters.DeleteFact = True;
			RecalculationParameters.ChangeDivisionItem = True;
			RecalculationParameters.ClearRowKeys = True;
			
			For LotIndex = 1 To NewParties.UBound() Do
				
				ResultOfRecalculation = CopyBatchAndRecalculateByCoefficient(
					BatchData,
					RecalculationData,
					Undefined,
					NewParties[LotIndex],
					BatchData,
					AdditionalAttributes,
					RecalculationParameters);
				For Each Ref In ResultOfRecalculation Do
					Result.StageCreated.Add(Ref);
				EndDo;
				
			EndDo;
			
		Else
			
			TheseAdditions = StepDataForChangingBatches(References, True, False).TheseAdditions;
			
			// Obtaining specification data for batches No. 2+
			SpecificationsData = New Map;
			For LotIndex = 1 To NewParties.UBound() Do
				LotReferenceDataCopy = Common.CopyRecursive(BatchData);
				LotReferenceDataCopy.Count = NewParties[LotIndex].Count;
				SpecificationData = GetStandardsForSpecifications(LotReferenceDataCopy, False);
				
				Catalogs.BillsOfMaterials.CheckBatchSize(
					SpecificationData, NewParties[LotIndex].Count, Result.Cancel, Result.Messages);
				If Result.Cancel Then
					For Each Ref In References Do
						UnlockDataForEdit(Ref, FormIdentifier);
					EndDo;
					Return Result;
				EndIf;
				
				SpecificationsData.Insert(LotIndex, SpecificationData);
			EndDo;
			
			// Changing the current batch (batch #1)
			BatchParameters = New Structure("BatchData, BatchSize", BatchData, NewParties[0]);
			
			ChangeParameters = ChangeSizeOfLotReferenceInStagesParameters();
			FillPropertyValues(ChangeParameters, Parameters);
			ChangeParameters.RecalculateDivisionItemInSpecificationData = True;
			
			Changes = ChangeBatchSizeInStages(
				BatchParameters, References, TheseAdditions, False, Assignments[0], Result, ChangeParameters);
			
			If Result.Cancel Then
				For Each Ref In References Do
					UnlockDataForEdit(Ref, FormIdentifier);
				EndDo;
				Return Result;
			EndIf;
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageRemoved Do
				Result.StageRemoved.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
			// Creation of parties No. 2+
			For LotIndex = 1 To NewParties.UBound() Do
				
				SpecificationData = SpecificationsData[LotIndex];
				
				// Clearing Specification data
				SpecificationData.IncomingProducts.Clear();
				
				// Addition of specification data
				AdditionalAttributes = New Map;
				
				TheStructureOfTheSearch = New Structure("Stage");
				Tables = StrSplit("MaterialsAndServices,ManufacturedProducts,RecyclableWaste,WorkCenterTypes,AlternateWorkCenterTypes,LaborCosts", ",");
				For IndexOf = -SpecificationData.Stages.Count()+1 To 0 Do
					Data_Stage = SpecificationData.Stages[-IndexOf];
					FoundRow = TheseAdditions.Attributes.Find(Data_Stage.Stage, "Stage");
					If FoundRow = Undefined Then
						// Clearing data by stage
						TheStructureOfTheSearch.Stage = Data_Stage.Stage;
						For Each Table In Tables Do
							For Each DeleteLine In SpecificationData[Table].FindRows(TheStructureOfTheSearch) Do
								SpecificationData[Table].Delete(DeleteLine)
							EndDo;
						EndDo;
						SpecificationData.Stages.Delete(Data_Stage);
					ElsIf FoundRow.FirstOperationID <> 0
						Or FoundRow.LastOperationID <> 0
						Or ValueIsFilled(FoundRow.Predecessor) Then
						// Division Attributes
						DivisionAttributes = DataProcessors.ProductionLotDivision.DivisionAttributesConstructor();
						FillPropertyValues(DivisionAttributes, FoundRow);
						AdditionalAttributes.Insert(Data_Stage.Stage,
							New Structure("DivisionAttributes", DivisionAttributes));
					EndIf;
				EndDo;
				
				// SetOfSeries
				BatchFinishedProducts = New ValueTable;
				For Each Attribute In Documents.ProductionStage2_2.EmptyRef().Metadata().TabularSections.BatchFinishedProducts.Attributes Do
					BatchFinishedProducts.Columns.Add(Attribute.Name, Attribute.Type);
				EndDo;
				BatchFinishedProducts.Columns.Add("Stage", New TypeDescription("CatalogRef.ProductionStages"));
				
				BatchSideAndIntermediateRelease = New ValueTable;
				For Each Attribute In Documents.ProductionStage2_2.EmptyRef().Metadata().TabularSections.BatchSideAndIntermediateRelease.Attributes Do
					BatchSideAndIntermediateRelease.Columns.Add(Attribute.Name, Attribute.Type);
				EndDo;
				BatchSideAndIntermediateRelease.Columns.Add("Stage", New TypeDescription("CatalogRef.ProductionStages"));
				
				SpecificationData.Insert("AssignmentsOfMaterials", Assignments[LotIndex].AssignmentsOfMaterials);
				
				PrepareTheseSpecificationsForCreatingStages(SpecificationData, BatchData);
				
				DistributeStageDataToSpecificationData(
					TheseAdditions, SpecificationData, BatchFinishedProducts, BatchSideAndIntermediateRelease, Assignments[LotIndex].ManufacturedProductAssignments);
				
				Fraction = New Structure("Numerator, Denominator", 1, 1);
				If BatchData.Count <> 0 Then
					Fraction.Numerator = NewParties[LotIndex].Count;
					Fraction.Denominator = BatchData.Count;
				EndIf;
				AddDivisionItemToTheseSpecifications(TheseAdditions, SpecificationData, Fraction);
				
				// Creating stages
				NewStages = CreateChainOfStagesWhenDividing(
					BatchData, SpecificationData, BatchFinishedProducts, BatchSideAndIntermediateRelease, AdditionalAttributes, Parameters);
				
				For Each Ref In NewStages Do
					Result.StageCreated.Add(Ref);
				EndDo;
				
			EndDo;
			
		EndIf;
		
		// Transfer of reserves
		Senders = Common.CopyRecursive(Result.StageRemoved);
		CommonClientServer.SupplementArray(Senders, Result.ChangedStage);
		If Senders.UBound() <> -1 Then
			
			Recipients = Common.CopyRecursive(Result.StageCreated);
			If Result.StageRemoved.UBound() <> -1 Then
				CommonClientServer.SupplementArray(Recipients, Result.ChangedStage);
			EndIf;
			
			Changes = TransferReserves(Senders, Recipients);
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
		EndIf;
		
		// Filling in related registers
		If Not BatchData.DynamicStructure Then
			InformationRegisters.JobsForTargetProductionScheduleCalculation.AddJob(
				BatchData.ReferenceOrder, True);
		ElsIf Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.OrderStructureCalculationJobsProductionSchedule.AddJob(
				BatchData.ReferenceOrder,,, True);
		EndIf;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.StatesOfProductionOrders = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			BatchData.ReferenceOrder,,
			RegistersToBeReflected);
		
		If UseOperationsInStages() Then
			InformationRegisters.JobsForCalculatingProductionOperationQueue.StartJobs();
		EndIf;
		
	Except
		
		For Each Ref In References Do
			UnlockDataForEdit(Ref, FormIdentifier);
		EndDo;
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
					|it = 'Fase di produzione';
					|pl = 'Etap produkcji';
					|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Chia lô';
					|ru = 'Деление партии';
					|en = 'Lot division'; fa = 'Lot division';
					|it = 'Divisione lotto';
					|pl = 'Podział partii';
					|tr = 'Lotun bölünmesi'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,,,
			DetailErrorDescription(ErrorInfo()));
		
		Raise BriefErrorDescription(ErrorInfo());
		
	EndTry;
	
	For Each Ref In References Do
		UnlockDataForEdit(Ref, FormIdentifier);
	EndDo;
	
	Return Result;
	
EndFunction

// Divides the party into several parallel parties. The division starts from the specified stage.
// 
// Parameters:
//  BatchData - See ProductionBatchData
//	Parameters - Structure:
//     * Stage - DocumentRef.ProductionStage2_2 - the stage from which it is necessary to divide The Lot Reference.
//     * FillInByBOM - Boolean
//     * MethodOfAllocatingFinishedProductCosts - EnumRef.MethodsOfCostAllocatingOnProductCosts
//	ManufacturedProducts - ValueTable - output items at the calculated cost
//		that will be placed in the production stage of the batch.
//		The composition of the fields is similar to the details of the table part of the production stage with the same name.
//		It also contains fields describing the batches that need to be processed further
//		(that is, to form new production batches).
//	SetOfSeries - ValueTable - series of output products.
//	FormIdentifier - UUID - id of the form that initiated
//		the data change. Used to lock data for editing.
// 	
// Returns:
//  Structure - where the Key is the action performed, and the Value is an array of links to documents.
//
Function SplitLotReferenceFromStage(BatchData, Parameters, ManufacturedProducts, SetOfSeries, FormIdentifier = Undefined) Export
	
	Result = DataProcessors.ProductionLotDivision.ResultOfProcessingConstructor();
	
	Stage = Parameters.Stage;
	OperationID = Parameters.OperationID;
	FillInByBOM = Parameters.FillInByBOM;
	ItSNonconformityMarriage = Parameters.ItSNonconformityMarriage;
	NumberOfPackagingUnitsNonconformity = Parameters.NumberOfPackagingUnitsNonconformity;
	PackagingDefectiveGoods = Parameters.PackagingDefectiveGoods;
	
	// Selection of stages with verification
	References = BatchStagesForChange(BatchData.ProductionLot, Stage, Result.Cancel, Result.Messages);
	If Result.Cancel Then
		Return Result;
	EndIf;
	
	StageDetails = Common.ObjectAttributesValues(Stage,
		"Posted, Stage, Status, Number, StageNumber, ProductionByThirdParty, SubcontractOrder, WorkPlanning, ProductionInOneDay, ProductionDate, ActualStageStart");
	
	CheckResult = CheckDivisionPoint(StageDetails);
	If CheckResult.Cancel Then
		Result.Cancel = True;
		Result.Messages.Add(CheckResult.MessageText);
		Return Result;
	EndIf;
	
	QueueManager = New TempTablesManager();
	DataProcessors.ProductionLotDivision.CreateTTQueueOfOperationsForDivision(QueueManager, Stage);
	
	CheckResult = CheckDivisionPointQueue(OperationID, QueueManager, Not ItSNonconformityMarriage, ItSNonconformityMarriage, False);
	If CheckResult.Cancel Then
		Result.Cancel = True;
		Result.Messages.Add(CheckResult.MessageText);
		Return Result;
	EndIf;
	
	SplitWithinStage = (StageDetails.Status = Enums.StatusesOfProductionStages2_2.Initiated)
		Or CheckResult.ThisIsChangeInsideQueue
		Or ItSNonconformityMarriage;
	If SplitWithinStage
		And StageDetails.WorkPlanning Then
		IntermediateReleaseStage = Undefined;
		ThisIsDivisionOfWorkPlanning = True;
	Else
		IntermediateReleaseStage = ?(SplitWithinStage, Stage, StageForIntermediateRelease(Stage));
		ThisIsDivisionOfWorkPlanning = False;
	EndIf;
	IntermediateReleaseConsumers = New Array;
	
	// Auxiliary collections:
	//  Blocked - blocked
	//  Data transmission - transfer analytics of their TS and warehouse reserves to new documents
	//  Deleted - marked for deletion
	LinksToBlocking = Common.CopyRecursive(References);
	LinksToBlocking.Add(Stage);
	If Not SplitWithinStage And IntermediateReleaseStage <> Undefined Then
		LinksToBlocking.Add(IntermediateReleaseStage);
	EndIf;
	If IntermediateReleaseStage = Undefined
		And Not ThisIsDivisionOfWorkPlanning Then
		Predecessors = PredecessorsInStageQueue(Stage);
		For Each Predecessor In Predecessors Do
			LinksToBlocking.Add(Predecessor);
		EndDo;
	EndIf;
	If ManufacturedProducts.Find(True, "CancelChangeFinishedProductInOrder") <> Undefined Then
		LinksToBlocking.Add(BatchData.ReferenceOrder);
	EndIf;
	
	LinksToDataTransmission = Common.CopyRecursive(References);
	LinksToDataTransmission.Add(Stage);
	
	LinksToDelete = Common.CopyRecursive(References);
	If Not SplitWithinStage Then
		LinksToDelete.Add(Stage);
	EndIf;
	
	OrderObject = Undefined;
	
	Try
		
		// Blocking objects
		For Each Ref In LinksToBlocking Do
			LockDataForEdit(Ref,, FormIdentifier);
		EndDo;
		
		GetAdditionData = False;
		GetRecalculationData = False;
		
		// If the filling mode is selected by K. but "PC Continue" is different from "PC Lot Reference", then filling in a new Lot Reference By PC
		ManufacturedProducts.Columns.Add("FillInByBOM", New TypeDescription("Boolean"));
		
		// Obtaining and verifying specification data
		SpecificationsData = New Map;
		For PartyIndex = 0 To ManufacturedProducts.Count()-1 Do
			Lot = ManufacturedProducts[PartyIndex];
			If Lot.ContinueProcessing Then
				
				InitialStageIsToLeftOfDivisionPoint = False;
				If Not FillInByBOM
					And Lot.ContinueBOM = BatchData.BillOfMaterials
					And Lot.ContinueStage <> StageDetails.Stage Then
					InitialStageNumber = Common.ObjectAttributeValue(Lot.ContinueStage, "StageNumber");
					InitialStageIsToLeftOfDivisionPoint = InitialStageNumber < StageDetails.StageNumber;
				EndIf;
				
				Lot.FillInByBOM = FillInByBOM
					Or Lot.ContinueBOM <> BatchData.BillOfMaterials
					Or InitialStageIsToLeftOfDivisionPoint;
				
				If Lot.FillInByBOM Then
					GetAdditionData = True;
				
					BatchSize = NewBatchSize(
						Lot.LotQuantity,
						Lot.LotNumberOfPackages,
						Lot.PackageOfLot);
					
					// Getting Specification data
					ItemData_3 = Catalogs.BillsOfMaterials.ProductData_5();
					FillPropertyValues(ItemData_3, BatchData,
						"ReferenceOrder, ProductionStart, ProductionDispatcherBusinessUnit, LineOfBusiness");
					ItemData_3.BillOfMaterials = Lot.ContinueBOM;
					ItemData_3.Products = Lot.ContinueItem;
					ItemData_3.Characteristic = Lot.ContinueVariant;
					ItemData_3.Count = BatchSize.Count;
					
					TempTablesManager = New TempTablesManager;
					
					Documents.ProductionOrder2_2.CreateTTWaysToGetMaterials2_2(
						TempTablesManager,
						BatchData.ReferenceOrder);
					
					SelectionParameters = Catalogs.BillsOfMaterials.DataSamplingParameters(, TempTablesManager);
					SelectionParameters.CombineMaterialsAndIncomingProducts = True;
					SelectionParameters.CombineMaterialsAndWorksPerformed = True;
					SelectionParameters.CalculateShareOfCostOfOutputProducts = True;
					SelectionParameters.OverridingReleasePartySetting.Use = True;
					SelectionParameters.OverridingReleasePartySetting.ProductionIssueByCustomPortions = True;
					SelectionParameters.IntermediateSemiFinishedProducts = ProductDataManagementClientServer.IntermediateSemiFinishedProductsGet();
					
					If SelectionParameters.ListOfData.Find("Operations") = Undefined Then
						SelectionParameters.ListOfData.Add("Operations");
					EndIf;
					
					SpecificationData = Catalogs.BillsOfMaterials.SpecificationDataByProducts(
						ItemData_3,
						SelectionParameters);
					
					Catalogs.BillsOfMaterials.CheckBatchSize(
						SpecificationData, BatchSize.Count, Result.Cancel, Result.Messages);
					If Result.Cancel Then
						For Each Ref In LinksToBlocking Do
							UnlockDataForEdit(Ref, FormIdentifier);
						EndDo;
						Return Result;
					EndIf;
					
					SpecificationsData.Insert(PartyIndex, SpecificationData);
				Else
					GetRecalculationData = True;
				EndIf;
				
			EndIf;
		EndDo;
		
		// Getting these steps to fill in new documents
		StageData_1 = Undefined; // See StepDataForChangingBatches
		If GetAdditionData Or GetRecalculationData Then
			StageData_1 = StepDataForChangingBatches(
				LinksToDataTransmission, GetAdditionData, GetRecalculationData);
		EndIf;
		
		// Mark for deletion
		For Each Ref In LinksToDelete Do
			DocumentObject = Ref.GetObject();
			DocumentObject.SetDeletionMark(True);
			
			Result.StageRemoved.Add(Ref);
		EndDo;
		
		// Party Update
		MainProduct = New Structure;
		MainProduct.Insert("Products", BatchData.MainProductProducts);
		MainProduct.Insert("Characteristic", BatchData.MainProductCharacteristic);
		MainProduct.Insert("UnderRepairProduct", BatchData.UnderRepairProduct);
		MainProduct.Insert("UnderRepairVariant", BatchData.UnderRepairVariant);
		MainProduct.Insert("UnderRepairBatch", BatchData.UnderRepairBatch);
		
		Catalogs.ProductionLots.CreateUpdateProductionBatch(
			BatchData.ProductionLot,
			BatchFields(BatchData, MainProduct),
			True);
		
		// Withdrawal of division point reserves
		If SplitWithinStage
			And StageData_1 <> Undefined Then
			TheStructureOfTheSearch = New Structure("Ref, SupplyOption",
				Stage, Enums.SupplyOptions.FromWarehouse);
			FoundRows = ?(GetAdditionData,
				StageData_1.TheseAdditions.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearch),
				StageData_1.RecalculationData.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearch));
			If FoundRows.UBound() <> -1 Then
				DocumentObject = Stage.GetObject();
				
				TheStructureOfTheSearch = New Structure("SupplyOption", Enums.SupplyOptions.FromWarehouse);
				For Each String In DocumentObject.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearch) Do
					String.SupplyOption = Enums.SupplyOptions.ToSupply;
				EndDo;
				DocumentObject.Write(DocumentWriteMode.Posting);
				
				Result.ChangedStage.Add(Stage);
			EndIf;
		EndIf;
		
		// Creating new chains of stages
		For PartyIndex = 0 To ManufacturedProducts.Count()-1 Do
			
			Lot  = ManufacturedProducts[PartyIndex];
			
			// Order change
			If Lot.CancelChangeFinishedProductInOrder Then
				If OrderObject = Undefined Then
					OrderObject = BatchData.ReferenceOrder.GetObject(); // DocumentObject.ProductionOrder2_2
				EndIf;
				
				If Lot.ContinueProcessing
					And Lot.ChangeProductToBeReleased Then
					KeysOfProduction = New Structure;
					KeysOfProduction.Insert("Products", BatchData.MainProductProducts);
					KeysOfProduction.Insert("Characteristic", BatchData.MainProductCharacteristic);
					KeysOfProduction.Insert("BillOfMaterials", BatchData.BillOfMaterials);
					
					NewProductKeys = New Structure;
					NewProductKeys.Insert("Products", Lot.ContinueItem);
					NewProductKeys.Insert("Characteristic", Lot.ContinueVariant);
					NewProductKeys.Insert("BillOfMaterials", Lot.ContinueBOM);
					
					OrderObject.ReplaceProducts(
						KeysOfProduction,
						Lot.LotQuantity,
						Lot.ReasonForCancelingFinishedProduct,
						NewProductKeys);
				Else
					OrderObject.CancelProducts(
						BatchData.MainProductProducts,
						BatchData.MainProductCharacteristic,
						BatchData.BillOfMaterials,
						Lot.LotQuantity,
						Lot.ReasonForCancelingFinishedProduct);
				EndIf;
			EndIf;
			
			If Not Lot.ContinueProcessing Then
				Continue;
			EndIf;
			
			NewStages = Undefined;
			If Lot.FillInByBOM Then
				
				SpecificationData = SpecificationsData[PartyIndex];
				
				// Reduction of specification data by a given stage
				FoundRow = SpecificationData.Stages.Find(Lot.ContinueStage, "Stage");
				If FoundRow <> Undefined Then
					StagesToLeave = CommonClientServer.ValueInArray(Lot.ContinueStage);
					StageQueue = CommonClientServer.ValueInArray(FoundRow.NextStageNo);
					
					TheStructureOfTheSearch = New Structure("StageNumber");
					IndexOf = 0;
					While IndexOf <= StageQueue.UBound() Do
						TheStructureOfTheSearch.StageNumber = StageQueue[IndexOf];
						For Each FoundRow In SpecificationData.Stages.FindRows(TheStructureOfTheSearch) Do
							If StageQueue.Find(FoundRow.NextStageNo) = Undefined Then
								StageQueue.Add(FoundRow.NextStageNo);
							EndIf;
							StagesToLeave.Add(FoundRow.Stage)
						EndDo;
						IndexOf = IndexOf + 1;
					EndDo;
					
					TheStructureOfTheSearch = New Structure("Stage");
					Tables = StrSplit("IncomingProducts,MaterialsAndServices,ManufacturedProducts,RecyclableWaste,WorkCenterTypes,AlternateWorkCenterTypes,LaborCosts", ",");
					For IndexOf = -SpecificationData.Stages.Count()+1 To 0 Do
						String = SpecificationData.Stages[-IndexOf];
						If StagesToLeave.Find(String.Stage) = Undefined Then
							TheStructureOfTheSearch.Stage = String.Stage;
							For Each Table In Tables Do
								For Each DeleteLine In SpecificationData[Table].FindRows(TheStructureOfTheSearch) Do
									SpecificationData[Table].Delete(DeleteLine)
								EndDo;
							EndDo;
							SpecificationData.Stages.Delete(String);
						EndIf;
					EndDo;
				EndIf;
				
				// Reduction of specification data for a given operation
				If ValueIsFilled(Lot.ContinueOperationID)
					And Not Lot.ContinueThisIsFirstOperation Then
					FoundRows = SpecificationData.Operations.FindRows(
						New Structure("Stage, OperationID",
							Lot.ContinueStage, Lot.ContinueOperationID));
					If FoundRows.UBound() <> -1 Then
						StructureOfOperationSearch = New Structure("Stage, NextOperation",
							Lot.ContinueStage, FoundRows[0].OperationNumber);
						SpecificationData.Operations.Indexes.Add("Stage, NextOperation");
						OperationQueue = SpecificationData.Operations.FindRows(StructureOfOperationSearch);
						
						SearchStructureOperationData = New Structure("Stage, Operation", Lot.ContinueStage);
						
						While OperationQueue.UBound() <> -1 Do
							LineOperation = OperationQueue[0];
							SearchStructureOperationData.Operation = LineOperation.Operation;
							
							For Each Table In StrSplit("MaterialsAndServices,ManufacturedProducts,RecyclableWaste,LaborCosts", ",") Do
								For Each String In SpecificationData[Table].FindRows(SearchStructureOperationData) Do
									SpecificationData[Table].Delete(String);
								EndDo;
							EndDo;
							
							StructureOfOperationSearch.NextOperation = LineOperation.OperationNumber;
							For Each String In SpecificationData.Operations.FindRows(StructureOfOperationSearch) Do
								OperationQueue.Add(String);
							EndDo;
							
							OperationQueue.Delete(0);
						EndDo;
					EndIf;
				EndIf;
				
				// Addition of specification data
				SpecificationData.IncomingProducts.Clear();
				
				BatchFinishedProducts = New ValueTable;
				For Each Attribute In Documents.ProductionStage2_2.EmptyRef().Metadata().TabularSections.BatchFinishedProducts.Attributes Do
					BatchFinishedProducts.Columns.Add(Attribute.Name, Attribute.Type);
				EndDo;
				BatchFinishedProducts.Columns.Add("Stage", New TypeDescription("CatalogRef.ProductionStages"));
				
				BatchSideAndIntermediateRelease = New ValueTable;
				For Each Attribute In Documents.ProductionStage2_2.EmptyRef().Metadata().TabularSections.BatchSideAndIntermediateRelease.Attributes Do
					BatchSideAndIntermediateRelease.Columns.Add(Attribute.Name, Attribute.Type);
				EndDo;
				BatchSideAndIntermediateRelease.Columns.Add("Stage", New TypeDescription("CatalogRef.ProductionStages"));
				
				SpecificationData.Insert("AssignmentsOfMaterials", Lot.AssignmentsOfMaterials);
				
				PrepareTheseSpecificationsForCreatingStages(SpecificationData, BatchData);
				
				FinishedProductReplacement = Undefined;
				If Lot.CancelChangeFinishedProductInOrder
					And Lot.ChangeProductToBeReleased Then
					FinishedProductReplacement = New Structure;
					FinishedProductReplacement.Insert("Products", BatchData.MainProductProducts);
					FinishedProductReplacement.Insert("Characteristic", BatchData.MainProductCharacteristic);
					FinishedProductReplacement.Insert("ItemIsNew", Lot.ContinueItem);
					FinishedProductReplacement.Insert("CharacteristicIsNew", Lot.ContinueVariant);
				EndIf;
				
				DistributeStageDataToSpecificationData(
					StageData_1.TheseAdditions, SpecificationData, BatchFinishedProducts, BatchSideAndIntermediateRelease, Lot.ManufacturedProductAssignments, FinishedProductReplacement);
				
				// Substitution of the main product of the batch (during disassembly)
				If BatchData.ProductionProcessType = Enums.ProductionProcessTypes.Disassembly Then
					
					HeaderAttributes = New Structure;
					HeaderAttributes.Insert("ReferenceOrder", BatchData.ReferenceOrder);
					HeaderAttributes.Insert("ProductionLot", SpecificationData.ProductionLot);
					HeaderAttributes.Insert("AssignmentProducts", BatchData.AssignmentProducts);
					HeaderAttributes.Insert("ProductionProcessType", SpecificationData.ProductionProcessType);
					HeaderAttributes.Insert("BillOfMaterials", SpecificationData.BillOfMaterials);
					
					MainProduct = New Structure;
					MainProduct.Insert("Products", Lot.Products);
					MainProduct.Insert("Characteristic", Lot.Characteristic);
					
					BatchFields = BatchFields(HeaderAttributes, MainProduct,, SpecificationData);
					
					Catalogs.ProductionLots.CreateUpdateProductionBatch(
						SpecificationData.ProductionLot,
						BatchFields,
						True);
					
				EndIf;
				
				// additional banking details
				AttributesValues = New Structure;
				
				If SplitWithinStage
					And StageDetails.Stage = Lot.ContinueStage Then
					AttributesValues.Insert("ProductionInOneDay", StageDetails.ProductionInOneDay);
					AttributesValues.Insert("ProductionDate", StageDetails.ProductionDate);
				EndIf;
				
				If ValueIsFilled(Lot.ContinueOperationID)
					And Not Lot.ContinueThisIsFirstOperation Then
					DivisionAttributes = DataProcessors.ProductionLotDivision.DivisionAttributesConstructor();
					DivisionAttributes.FirstOperationID = Lot.ContinueOperationID;
					AttributesValues.Insert("DivisionAttributes", DivisionAttributes);
				EndIf;
				
				AdditionalAttributes = New Map;
				If AttributesValues.Count() > 0 Then
					AdditionalAttributes.Insert(Lot.ContinueStage, AttributesValues);
				EndIf;
				
				// Creating stages
				NewStages = CreateChainOfStagesWhenDividing(
					BatchData, SpecificationData, BatchFinishedProducts, BatchSideAndIntermediateRelease, AdditionalAttributes, Parameters);
				
			Else
				
				DataProcessorRefs = Undefined;
				If Lot.ContinueStage <> StageDetails.Stage Then
					FoundRow = StageData_1.RecalculationData.Attributes.Find(Lot.ContinueStage, "Stage");
					If FoundRow <> Undefined Then
						DataProcessorRefs = New Array;
						DataProcessorRefs.Add(FoundRow.Ref);
						
						StageQueue = New Array;
						StageQueue.Add(FoundRow.NextStageNo);
						
						TheStructureOfTheSearch = New Structure("StageNumber");
						IndexOf = 0;
						While IndexOf <= StageQueue.UBound() Do
							TheStructureOfTheSearch.StageNumber = StageQueue[IndexOf];
							For Each FoundRow In StageData_1.RecalculationData.Attributes.FindRows(TheStructureOfTheSearch) Do
								If StageQueue.Find(FoundRow.NextStageNo) = Undefined Then
									StageQueue.Add(FoundRow.NextStageNo);
								EndIf;
								DataProcessorRefs.Add(FoundRow.Ref);
							EndDo;
							IndexOf = IndexOf + 1;
						EndDo;
					EndIf;
				EndIf;
				
				BatchSize = NewBatchSize(
					Lot.LotQuantity,
					Lot.LotNumberOfPackages,
					Lot.PackageOfLot);
				
				MainProduct = New Structure;
				MainProduct.Insert("Products", Catalogs.Products.EmptyRef());
				MainProduct.Insert("Characteristic", Catalogs.ItemsCharacteristics.EmptyRef());
				MainProduct.Insert("UnderRepairProduct", Catalogs.Products.EmptyRef());
				MainProduct.Insert("UnderRepairVariant", Catalogs.ItemsCharacteristics.EmptyRef());
				MainProduct.Insert("UnderRepairBatch", Catalogs.ItemsBatches.EmptyRef());
				
				If BatchData.ProductionProcessType = Enums.ProductionProcessTypes.Disassembly Then
					// During disassembly, the main product of the new batch will be an intermediate release product
					FillPropertyValues(MainProduct, Lot);
				Else
					FillPropertyValues(MainProduct, BatchData);
				EndIf;
				
				AdditionalAttributes = New Map;
				If ValueIsFilled(Lot.ContinueOperationID)
					And Not Lot.ContinueThisIsFirstOperation Then
					Var_Key = Undefined;
					If Lot.ContinueStage = StageDetails.Stage Then
						Var_Key = Stage;
					Else
						FoundRow = StageData_1.RecalculationData.Attributes.Find(Lot.ContinueStage, "Stage");
						If FoundRow <> Undefined Then
							Var_Key = FoundRow.Ref;
						EndIf;
					EndIf;
					
					If Var_Key <> Undefined Then
						DivisionAttributes = DataProcessors.ProductionLotDivision.DivisionAttributesConstructor();
						DivisionAttributes.FirstOperationID = Lot.ContinueOperationID;
						AdditionalAttributes.Insert(Var_Key, New Structure("DivisionAttributes", DivisionAttributes));
					EndIf;
				EndIf;
				
				RecalculationParameters = RecalculateParametersByCoefficient();
				RecalculationParameters.DeleteFact = True;
				RecalculationParameters.DeleteDivisionItem = True;
				RecalculationParameters.ClearRowKeys = True;
			
				// Creating stages
				NewStages = CopyBatchAndRecalculateByCoefficient(
					BatchData,
					StageData_1.RecalculationData,
					DataProcessorRefs,
					BatchSize,
					MainProduct,
					AdditionalAttributes,
					RecalculationParameters);
				
			EndIf;
			
			For Each Ref In NewStages Do
				Result.StageCreated.Add(Ref);
			EndDo;
			
			// Adding the intermediate release nomenclature to the collateral
			Query = New Query(
				"SELECT TOP 1
				|	Document.Ref AS Ref
				|FROM
				|	Document.ProductionStage2_2 AS Document
				|WHERE
				|	Document.Ref IN(&References)
				|	AND NOT TRUE IN
				|				(SELECT TOP 1
				|					TRUE
				|				FROM
				|					Document.ProductionStage2_2.Successors AS Successors
				|				WHERE
				|					Successors.Stage = Document.Ref)");
			Query.SetParameter("References", NewStages);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				
				DocumentObject = Selection.Ref.GetObject(); // DocumentObject.ProductionStage2_2
				DocumentObject.Lock();
				
				ReadyForProcessing_ = New Array;
				
				TheStructureOfTheSearch = New Structure;
				TheStructureOfTheSearch.Insert("Products", Lot.Products);
				TheStructureOfTheSearch.Insert("Characteristic", Lot.Characteristic);
				TheStructureOfTheSearch.Insert("Canceled", False);
				FoundRows = DocumentObject.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearch);
				
				If FoundRows.UBound() = -1 Then
					
					NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Add();
					FillPropertyValues(NewRow, Lot);
					If DocumentObject.NotShipInInstallments Then
						NewRow.DateOfShipment = DocumentObject.DateOfShipment;
					EndIf;
					If Not DocumentObject.DynamicStructure Then
						NewRow.Produced = True;
					EndIf;
					NewRow.SupplyOption = Enums.SupplyOptions.ToSupply;
					NewRow.WithAssignment = True;
					NewRow.SupplyAssignment = DocumentObject.Purpose;
					NewRow.Purpose = DocumentObject.Purpose;
					NewRow.Warehouse = Lot.Recipient;
					NewRow.Department = DocumentObject.Department;
					NewRow.ProductCostElement = Catalogs.ProductCostElements.SemiFinishedProductsProducedInProcess;
					
				Else
					
					Balance = Lot.Count;
					For IndexOf = 0 To FoundRows.UBound() Do
						
						String = FoundRows[IndexOf];
						If Not DocumentObject.DynamicStructure Then
							String.Produced = True;
						EndIf;
						String.SupplyOption = Enums.SupplyOptions.ToSupply;
						String.WithAssignment = True;
						String.SupplyAssignment = DocumentObject.Purpose;
						String.Purpose = DocumentObject.Purpose;
						String.Warehouse = Lot.Recipient;
						
						If IndexOf = FoundRows.UBound()
							And Balance > String.Count Then
							String.Count = Balance;
							ReadyForProcessing_.Add(String);
						EndIf;
						
						Balance = Balance - String.Count;
						If Balance <= 0 Then
							Break;
						EndIf;
						
					EndDo;
					
				EndIf;
				
				StructureOfActions = New Structure("RecalculateNumberOfPackages");
				CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
				BatchProcessingOfTablePartServer.ProcessTSStrings(
					ReadyForProcessing_,
					StructureOfActions,
					DocumentObject.SupplyWithMaterialsAndWorks,
					CachedValues);
				
				SeriesSpecificationParameters = SeriesSpecificationParameters(DocumentObject);
				ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SupplyWithMaterialsAndWorks);
				
				DocumentObject.Comment = StrTemplate(
					NStr("vi = 'Đã tạo khi thay đổi lô hàng của công đoạn %1';
						|ru = 'Создан при изменении партии этапа %1';
						|en = 'Created when changing the lot of stage %1'; fa = 'Created when changing the lot of stage %1';
						|it = 'Создан при изменении партии этапа %1';
						|pl = 'Created when changing the lot of stage %1';
						|tr = '%1 aşamasının lotu değiştirilirken oluşturuldu'"),
					Common.ObjectAttributeValue(
						?(IntermediateReleaseStage = Undefined, Stage, IntermediateReleaseStage),
						"Number"));
				
				DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
				DocumentWritten = ConductWithDowngradedStatus(DocumentObject);
				DocumentObject.Unlock();
				
				If DocumentWritten Then
					Result.ChangedStage.Add(DocumentObject.Ref);
				Else
					Result.StageIsNotRecorded.Add(DocumentObject.Ref);
				EndIf;
				
				// Setting the properties of an interim release
				Lot.Purpose = DocumentObject.Purpose;
				For Each StringSeries In SetOfSeries.FindRows(New Structure("LotIndex", Lot.LotIndex)) Do
					StringSeries.Purpose = DocumentObject.Purpose;
				EndDo;
				If BatchData.ProductionProcessType = Enums.ProductionProcessTypes.Disassembly Then
					Lot.ProcessByBOM = True;
				EndIf;
				
				IntermediateReleaseConsumers.Add(DocumentObject.Ref);
				
			EndIf;
			
		EndDo;
		
		If IntermediateReleaseStage = Undefined Then
			// Registration of an interim issue
			IntermediateReleaseStage = ToIssueInterimIssueInNewStage(
				BatchData, Stage, ManufacturedProducts, SetOfSeries, Parameters, Not ThisIsDivisionOfWorkPlanning);
			
			If ThisIsDivisionOfWorkPlanning Then
				// Changing the stage - the division point
				DocumentObject = Stage.GetObject();
				
				If DocumentObject.NextStageNo = 0 Then
					DocumentObject.NextStageNo = DocumentObject.StageNumber + 1;
				EndIf;
				
				DocumentObject.Successors.Clear();
				NewRow = DocumentObject.Successors.Add();
				NewRow.Stage = IntermediateReleaseStage;
				NewRow.LinkType = CommunicationTypeFollower();
				
				DeletePlannedLines(BatchData, DocumentObject);
				
				DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
				DocumentWritten = ConductWithDowngradedStatus(DocumentObject);
				
				If DocumentWritten Then
					Result.ChangedStage.Add(Stage);
				Else
					Result.StageIsNotRecorded.Add(Stage);
				EndIf;
			Else
				// If there was a release of intermediate products at a fixed cost at the stage - point of division,
				// then it is necessary to reflect the consumption of these products in the "technical" stage to exclude
				// the doubling of output
				Adjusting = ReflectConsumptionOfByProductsInIntermediateRelease(
					IntermediateReleaseStage, LinksToDelete);
				If Adjusting <> Undefined Then
					Result.AdjustmentCreated.Add(Adjusting);
				EndIf;
			EndIf;
			
			// Change in reserves
			Changes = TransferReserves(LinksToDataTransmission, Result.StageCreated);
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
			Result.StageCreated.Add(IntermediateReleaseStage);
		Else
			// Change in reserves
			SendersToDelete = ?(SplitWithinStage,
				CommonClientServer.ValueInArray(IntermediateReleaseStage),
				Undefined);
			Changes = TransferReserves(LinksToDataTransmission, Result.StageCreated, SendersToDelete);
			For Each Ref In Changes.ChangedStage Do
				Result.ChangedStage.Add(Ref);
			EndDo;
			For Each Ref In Changes.StageIsNotRecorded Do
				Result.StageIsNotRecorded.Add(Ref);
			EndDo;
			For Each Ref In Changes.AdjustmentCreated Do
				Result.AdjustmentCreated.Add(Ref);
			EndDo;
			
			// Registration of an interim issue
			DocumentObject = IntermediateReleaseStage.GetObject();
			
			If SplitWithinStage Then
				// Changing the header
				If ItSNonconformityMarriage
					And DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.Initiated Then
					DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated;
					DocumentObject.ActualStageStart = CurrentSessionDate();
				EndIf;
				
				CalculateCanceled = False;
				If ItSNonconformityMarriage Then
					If DocumentObject.NumberOfPackagesReal = 0 Then
						DocumentObject.NumberOfPackagesReal = NumberOfPackagingUnitsNonconformity;
						DocumentObject.PackageActualData = PackagingDefectiveGoods;
						CalculateCanceled = True;
					EndIf;
				Else
					CalculateCanceled = True;
				EndIf;
				
				If CalculateCanceled
					And DocumentObject.NumberOfPackagesCanceled = 0 Then
					DocumentObject.PackageCanceled = DocumentObject.PackagePlan;
					If DocumentObject.PackageActualData = DocumentObject.PackagePlan Then
						DocumentObject.NumberOfPackagesCanceled = DocumentObject.NumberOfPackagesPlan
							- DocumentObject.NumberOfPackagesReal;
					Else
						CoefficientPlan = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
							DocumentObject.PackagePlan, BatchData.MainProductProducts);
						CoefficientFact = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
							DocumentObject.PackageActualData, BatchData.MainProductProducts);
						NumberOfPackagesReal = DocumentObject.NumberOfPackagesReal
							* CoefficientFact
							/ CoefficientPlan;
						DocumentObject.NumberOfPackagesCanceled = DocumentObject.NumberOfPackagesPlan
							- NumberOfPackagesReal;
					EndIf;
				EndIf;
				
				SetLastOperation(DocumentObject, OperationID, QueueManager);
				
				// TS Change
				DeletePlannedLines(BatchData, DocumentObject);
			EndIf;
			
			IssueInterimRelease(BatchData, DocumentObject, ManufacturedProducts, SetOfSeries, Parameters);
			
			DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
			DocumentWritten = ConductWithDowngradedStatus(DocumentObject);
			
			If DocumentWritten Then
				Result.ChangedStage.Add(IntermediateReleaseStage);
			Else
				Result.StageIsNotRecorded.Add(IntermediateReleaseStage);
			EndIf;
		EndIf;
		
		// Recording of the predecessor stage
		DivisionAttributes = DataProcessors.ProductionLotDivision.DivisionAttributesConstructor();
		DivisionAttributes.Predecessor = IntermediateReleaseStage;
		For Each Ref In IntermediateReleaseConsumers Do
			DataProcessors.ProductionLotDivision.ChangeStageDivisionAttributes(Ref, DivisionAttributes, 1);
		EndDo;
		
		// Filling in related registers
		If Not BatchData.DynamicStructure Then
			InformationRegisters.JobsForTargetProductionScheduleCalculation.AddJob(
				BatchData.ReferenceOrder, True);
		ElsIf Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.OrderStructureCalculationJobsProductionSchedule.AddJob(
				BatchData.ReferenceOrder,,, True);
		EndIf;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.StatesOfProductionOrders = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			BatchData.ReferenceOrder,,
			RegistersToBeReflected);
		
		If UseOperationsInStages() Then
			InformationRegisters.JobsForCalculatingProductionOperationQueue.StartJobs();
		EndIf;
		
		// Order Recording
		If OrderObject <> Undefined Then
			OrderObject.Write(DocumentWriteMode.Posting);
			Result.OrderChanged.Add(OrderObject.Ref);
		EndIf;
		
	Except
		
		For Each Ref In LinksToBlocking Do
			UnlockDataForEdit(Ref, FormIdentifier);
		EndDo;
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
