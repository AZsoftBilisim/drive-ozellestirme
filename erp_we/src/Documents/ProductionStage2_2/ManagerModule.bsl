#Region TextsOfRequestsForHolding

#Region QueryTextsTemporaryTables

Function QueryTextTTBases(Query, QueryTexts, DocumentObject)
	
	RegisterName = "TTBases";
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataHeader", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableTypesOfStocksMaterials", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableTypesOfStocksMaterials(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfExpensesOfMaterialsAndWorks", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfExpensesOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText = 
	"SELECT
	|	Departments.Organization                   AS Organization,
	|	Departments.BusinessOperation	        AS BusinessOperation,
	|	Departments.Ref				        AS Ref,
	|	Departments.Date					        AS Date,
	|	Departments.Department			        AS Department,
	|	MIN(Departments.AdditionalRecord)	AS AdditionalRecord
	|INTO TTBases
	|FROM
	|	(
	// Main document registry entry
	|	SELECT
	|		TabularSection.Organization					AS Organization,
	|		TabularSection.DocumentRegistryOperation	AS BusinessOperation,
	|		TabularSection.Ref						AS Ref,
	|		TabularSection.DocumentRegistryDate		AS Date,
	|		TabularSection.Department				AS Department,
	|		FALSE										AS AdditionalRecord
	|	FROM
	|		DocumentDataHeader AS TabularSection
	|	
	|	UNION ALL
	|	
	// Manufacturing division by product release date
	|	SELECT
	|		CASE
	|			WHEN DocumentData.InternalSubcontracting
	|				THEN DocumentData.MaterialProviderCompany
	|			ELSE DocumentData.Organization
	|		END							AS Organization,
	|		VALUE(Enum.BusinessTransactions.ProductsRelease) AS BusinessOperation,
	|		TabularSection.Ref			AS Ref,
	|		TabularSection.ProductionDate	AS Date,
	|		TabularSection.Department	AS Department,
	|		TRUE							AS AdditionalRecord
	|	FROM
	|		DocumentDataTableOutputFinishedProducts AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS DocumentData
	|		ON DocumentData.Ref = TabularSection.Ref
	|	WHERE
	|		TabularSection.Manufactured
	|		AND NOT TabularSection.Canceled
	|		AND NOT BEGINOFPERIOD(TabularSection.ProductionDate, DAY) = BEGINOFPERIOD(DocumentData.DocumentRegistryDate, DAY)
	|	
	|	UNION ALL
	|	
	// The producing division by the date of release of by-products
	|	SELECT
	|		CASE
	|			WHEN NOT TabularSection.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
	|				THEN TabularSection.ProductOwner
	|			WHEN DocumentData.InternalSubcontracting
	|				THEN DocumentData.MaterialProviderCompany
	|			ELSE DocumentData.Organization
	|		END							AS Organization,
	|		VALUE(Enum.BusinessTransactions.ProductsRelease) AS BusinessOperation,
	|		TabularSection.Ref			AS Ref,
	|		TabularSection.ProductionDate	AS Date,
	|		TabularSection.Department	AS Department,
	|		TRUE							AS AdditionalRecord
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS DocumentData
	|		ON DocumentData.Ref = TabularSection.Ref
	|	WHERE
	|		TabularSection.Manufactured
	|		AND NOT TabularSection.Canceled
	|		AND NOT BEGINOFPERIOD(TabularSection.ProductionDate, DAY) = BEGINOFPERIOD(DocumentData.DocumentRegistryDate, DAY)
	|	
	|	UNION ALL
	|	
	// The issuing division by date of consumption/saving of materials
	|	SELECT
	|		ISNULL(TabularSection.TypeOfInventoryOwnerAttributeCompany, DocumentData.Organization) AS Organization,
	|		TabularSection.BusinessOperation  AS BusinessOperation,
	|		TabularSection.Ref                 AS Ref,
	|		TabularSection.DateOfTransaction           AS Date,
	|		TabularSection.Department          AS Department,
	|		TRUE                                AS AdditionalRecord
	|	FROM
	|		DocumentDataTableTypesOfStocksMaterials AS TabularSection
	|		
	|		LEFT JOIN DocumentDataHeader AS DocumentData
	|		ON DocumentData.Ref = TabularSection.Ref
	|	WHERE
	|		NOT TabularSection.DateOfTransaction = DATETIME(1,1,1)
	|		AND TabularSection.BusinessOperation IN(
	|			VALUE(Enum.BusinessTransactions.ExpensingToProductionLots),
	|			VALUE(Enum.BusinessTransactions.ReturnOfMaterialsFromProduction))
	|		AND (NOT BEGINOFPERIOD(TabularSection.DateOfTransaction, DAY) = BEGINOFPERIOD(DocumentData.DocumentRegistryDate, DAY)
	|			OR NOT DocumentData.DocumentRegistryOperation = TabularSection.BusinessOperation)
	|	
	|	UNION ALL
	|	
	// The issuing division by date of consumption of works
	|	SELECT
	|		DocumentData.Organization AS Organization,
	|		VALUE(Enum.BusinessTransactions.ExpensingToProductionLots) AS BusinessOperation,
	|		TabularSection.Ref			AS Ref,
	|		TabularSection.DateOfMaterialWorkConsumption		AS Date,
	|		TabularSection.Department	AS Department,
	|		TRUE							AS AdditionalRecord
	|	FROM
	|		DocumentDataTableOfExpensesOfMaterialsAndWorks AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS DocumentData
	|		ON DocumentData.Ref = TabularSection.Ref
	|	WHERE
	|		NOT TabularSection.DateOfMaterialWorkConsumption = DATETIME(1,1,1)
	|		AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|		AND (NOT BEGINOFPERIOD(TabularSection.DateOfMaterialWorkConsumption, DAY) = BEGINOFPERIOD(DocumentData.DocumentRegistryDate, DAY)
	|			OR NOT DocumentData.DocumentRegistryOperation = VALUE(Enum.BusinessTransactions.ExpensingToProductionLots))
	|	) AS Departments
	|
	|GROUP BY
	|	Departments.Organization,
	|	Departments.Ref,
	|	Departments.Department,
	|	Departments.Date,
	|	Departments.BusinessOperation
	|";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

