		|	0 AS AdditionalExpensesExcludingVAT, 
		|	0 AS AddExpensesLocal, 
		|	0 AS AddExpensesMan, 
		|	0 AS PermanentDifference, 
		|	0 AS CostTD, 
		|	0 AS CorGrossInitialCostENT,
		|
		// Other fields
		|	TTTypesOfStocks.RowID				AS RowID,
		|	TTTypesOfStocks.FinRecordID			AS FinRecordID,
		|	TTTypesOfStocks.BusinessOperation				AS BusinessOperation,
		|	TTTypesOfStocks.BusinessTransactionSetting	AS BusinessTransactionSetting
		|
		|FROM
		|	Document.ProductionStage2_2 AS DocumentTable
		|	INNER JOIN TTTypesOfStocks AS TTTypesOfStocks
		|		ON TRUE
		|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
		|	ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH)
		|		AND TTParametersOfBatchAccountingForConducting.Organization = TTTypesOfStocks.Organization
		|WHERE
		|	DocumentTable.Ref IN (&Ref)
		|	AND TTTypesOfStocks.BusinessOperation = 
		|		VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|	AND NOT TTTypesOfStocks.AddOnForGiver
		|	AND (&PeriodOfRewritingRegisteredRecords = UNDEFINED
		|		OR &PeriodOfRewritingRegisteredRecords <> DATETIME(1,1,1)
		|			AND TTTypesOfStocks.DateOfTransaction >= &PeriodOfRewritingRegisteredRecords)
		|";
	
		CostCalculationDocumentsPosting.AddDescriptionOfTransactionForCostAccounting(
			DescriptionOfOperations,
			Enums.CostAccountingTransactions.InternalReceipt,
			QueryText);
		
	EndIf;
		
	#EndRegion
	
	Return DescriptionOfOperations;
	
EndFunction

