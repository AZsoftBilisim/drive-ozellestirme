#Region ProductionSchedule

// Stage completion period according to the production schedule
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage of production.
//
// Returns:
//   - Structure - the period of completion of the stage according to the production schedule.
//
Function ProductionSchedule(Ref) Export
	
	Result = ProductionManagementClientServer.StructureOfStagePlacementInSchedule();
	
	ProductionSchedule = InformationRegisters.ScheduleOfProductionStages2_2.ProductionSchedule(
		CommonClientServer.ValueInArray(Ref));
	
	If ProductionSchedule.Count() = 1 Then
		FillPropertyValues(Result, ProductionSchedule[0]);
	EndIf;
	
	Return Result;
	
EndFunction

// Stage completion period according to the standard production schedule
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage of production.
//
// Returns:
//   - Structure - the period of completion of the stage according to the standard production schedule.
//
Function StandardProductionSchedule(Ref) Export
	
	Result = ProductionManagementClientServer.StructureOfStagePlacementInSchedule();
	
	If Ref.IsEmpty() Then
		Return Result;
	EndIf;
	
	Query = New Query(
		"SELECT
		|	Table.ProductionStage AS Stage,
		|	TRUE                   AS Calculated,
		|	DATEADD(Table.ReferenceOrder.EarliestStartDate, SECOND, ISNULL(Table.DurationBeforeStart, 0))                          AS Begin,
		|	DATEADD(Table.ReferenceOrder.EarliestStartDate, SECOND, ISNULL(Table.DurationBeforeStart + Table.ResourceIntensity, 0)) AS Ending
		|FROM
		|	InformationRegister.StandardScheduleOfProductionStages AS Table
		|WHERE
		|	Table.ProductionStage = &Ref");
	Query.SetParameter("Ref", Ref);
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		FillPropertyValues(Result, Selection);
	EndIf;
	
	Return Result;
	
EndFunction

// The planned date of receipt of the goods
//
// If the production schedule is used, then the end date of the stage is from the schedule,
//  otherwise the planned date according to the standard schedule.
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage of production.
//
// Returns:
//   - Date - the planned date of receipt of products.
//
Function PlannedDateOfReceipt(Ref) Export
	
	If ProductionManagementCached.TheProductionScheduleIsUsed() Then
		ProductionSchedule = ProductionSchedule(Ref);
	Else
		ProductionSchedule = StandardProductionSchedule(Ref);
	EndIf;
	
	TargetDate = BegOfDay(ProductionSchedule.Ending);
	
	Return TargetDate;
	
EndFunction

// Updates the Registered Records schedule of goods after calculating the production schedule.
//
// Parameters:
//  Jobs - ValueTable - the columns correspond to the measurements, resources and Attributes of the register of information
//                              "Universal queue of operational tasks", there are also service columns:
//             * Object                 - DocumentRef          - link to the stage
//             * RecordID    - UUID -
//             * RecordDate             - Date                    -
//             * JobID   - UUID - Service_
//             * TaskDate_            - Date                    - Service_
//  IdsOfUnprocessedRecords - Map of UUID - The key is the identifier 
//                                                                                   of the failed (giving an error during
//                                                                                   execution) entries
//                                                                                   of the Job queue information register
//                                                                                   (measurement
//                                                                                   of the record identifier of the Job queue information register),
//                                                                                  the value is the Presentation of the error.
//  AdditionalProperties - Undefined, Structure - additional task completion properties.
//
Procedure UpdateScheduleOfRegisteredRecordsOfGoods(
			Jobs,
			IdsOfUnprocessedRecords,
			AdditionalProperties = Undefined) Export
	
	SetPrivilegedMode(True);
	
	ErrorFields = Undefined;
	DataOfError = Undefined;
	
	Query = New Query;
	FillInInitializationParameters(Query);
	
	Query.Text =
		"SELECT TOP 100000000
		|	Stages.Ref       AS Ref,
		|	Stages.DataVersion AS DataVersion,
		|	RECORDAUTONUMBER()  AS RecNo
		|INTO TTStages
		|FROM
		|	Document.ProductionStage2_2 AS Stages
		|
		|	INNER JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionSchedule
		|	ON ProductionSchedule.ProductionOrder = Stages.ReferenceOrder
		|		AND ProductionSchedule.ScheduleStatus = &WorkingSchedule
		|		AND ProductionSchedule.Stage = Stages.Ref
		|
		|WHERE
		|	Stages.Ref IN(&Ref)
		|	AND (Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion)
		|		OR Stages.DynamicStructure
		|			AND Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Generated1))
		|
		|ORDER BY
		|	ProductionSchedule.Ending,
		|	ProductionSchedule.Begin,
		|	Stages.Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Stages.Ref                            AS Ref,
		|	Stages.DataVersion                      AS DataVersion,
		|	INT((Stages.RecNo - 1) / 1000) + 1 AS NumberOfGroup
		|FROM
		|	TTStages AS Stages
		|
		|ORDER BY
		|	Stages.RecNo
		|
		|TOTALS BY
		|	NumberOfGroup";
	
	Query.SetParameter("Ref", Jobs.UnloadColumn("Object"));
	Query.SetParameter("WorkingSchedule", InformationRegisters.ScheduleOfProductionStages2_2.StatusWorkingSchedule());
	LinksTree = Query.Execute().Unload(QueryResultIteration.ByGroups);
	
	MovableRegisters =  New Structure;
	MovableRegisters.Insert("InventoryAndDemands", "Table" + "InventoryAndDemands");
	
	QueryTexts = RequestTextsForGeneratingRegisteredRecords(Query, Undefined, MovableRegisters); // ValueList
	
	For Each Group In LinksTree.Rows Do
		Query.SetParameter("Ref", Group.Rows.UnloadColumn("Ref"));
		
		TablesForRegisteredRecords = DocumentsPosting.InitializeDocumentDataForPosting(
			Query, QueryTexts, Undefined);
		
		StagesOfFailure = GenerateRegisteredRecordsInBatchMode(TablesForRegisteredRecords, Group.Rows, MovableRegisters);
		
		For Each Ref In StagesOfFailure Do
			If ErrorFields = Undefined Then
				ErrorFields = New Structure("Object");
				DataOfError = New Structure("Object");
				Jobs.Indexes.Add("Object");
			EndIf;
			
			ExceptionText = NStr("vi = 'Nỗ lực không thành công khi ghi lại vào biểu ghi ""Tồn kho và nhu cầu""';
								|ru = 'Неудачная попытка записи регистра ""Запасы и потребности""';
								|en = 'Failed attempt to write the ""Inventory and demands"" register'; fa = 'Failed attempt to write the ""Inventory and demands"" register';
								|it = 'Failed attempt to write the ""Inventory and demands"" register';
								|pl = 'Failed attempt to write the ""Inventory and demands"" register';
