#Region StateCalculation

// Returns a structure containing the query texts of temporary tables for calculating the state.
//
// Returns:
//   - Structure - the query texts of temporary tables for calculating the state.
//
Function TemporaryTablesForStateCalculation() Export
	
	Result = New Structure();
	
	QueryText =
		"SELECT
		|	Table.Ref                AS Ref,
		|	Table.Posted              AS Posted,
		|	Table.Status                AS Status,
		|	Table.ReferenceOrder          AS ReferenceOrder,
		|	Table.Department         AS Department,
		|	Table.BillOfMaterials          AS BillOfMaterials,
		|	Table.ProductionByThirdParty AS ProductionByThirdParty,
		|	Table.Stage                  AS Stage,
		|
		|	Table.DynamicStructure AS DynamicStructure,
		|	UUID(Table.Ref) AS DocumentID,
		|	
		|	CASE WHEN Table.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
		|				TRUE
		|			ELSE
		|				FALSE
		|	END                         AS StatusCompleted_1
		|	
		|INTO TTDocumentDetails
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|
		|WHERE
		|	Table.Ref IN(&ReferencesArrray)
		|INDEX BY
		|	Ref";
	
	Result.Insert("Attributes", QueryText);
	
	QueryText = 
		"SELECT
		|	NestedQuery.Ref AS Ref,
		|	CASE
		|		WHEN SUM(CASE
		|					WHEN NestedQuery.PredecessorStatus = &StatusCompleted_1
		|						THEN 1
		|					ELSE 0
		|				END) = COUNT(NestedQuery.Predecessor)
		|			THEN &PredecessorsAreCompleted
		|		WHEN SUM(CASE
		|					WHEN NestedQuery.PredecessorStatus = &StatusStarted
		|						THEN 1
		|					ELSE 0
		|				END) > 0
		|			THEN &PredecessorsAreStarted
		|		WHEN SUM(CASE
		|					WHEN NestedQuery.PredecessorStatus = &StatusStarted
		|						THEN 1
		|					ELSE 0
		|				END) = 0
		|			THEN &NotPredecessorsAreStarted
		|	END AS State
		|INTO TTStatesOfPredecessors
		|FROM
		|	(SELECT
		|		RelationshipTable.Stage AS Ref,
		|		Predecessors.Ref AS Predecessor,
		|		Predecessors.Status AS PredecessorStatus
		|	FROM
		|		Document.ProductionStage2_2.Successors AS RelationshipTable
		|			LEFT JOIN Document.ProductionStage2_2 AS Predecessors
		|			ON RelationshipTable.Ref = Predecessors.Ref
		|	WHERE
		|		RelationshipTable.Stage IN(&ReferencesArrray)
		|		AND Predecessors.Posted
		|		AND NOT Predecessors.Ref IN (&ArrayOfLinksToCleanUp)
		|	
		|	UNION
		|	
		|	SELECT
		|		Table.Ref,
		|		Predecessors.Ref,
		|		Predecessors.Status
		|	FROM
		|		Document.ProductionStage2_2 AS Table
		|			LEFT JOIN Document.ProductionStage2_2 AS Predecessors
		|			ON ((CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2)) = Predecessors.Ref)
		|	WHERE
		|		Table.Ref IN(&ReferencesArrray)
		|		AND (CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2)) <> VALUE(Document.ProductionStage2_2.EmptyRef)
		|		AND Predecessors.Posted
		|		AND NOT Predecessors.Ref IN (&ArrayOfLinksToCleanUp)) AS NestedQuery
		|
		|GROUP BY
		|	NestedQuery.Ref
		|
		|INDEX BY
		|	Ref";
		
	Result.Insert("PredecessorStates", QueryText);
	
	Return Result;
	
EndFunction

