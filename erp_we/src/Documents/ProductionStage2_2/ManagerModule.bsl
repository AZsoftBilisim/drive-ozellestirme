				|ru = 'Задание на производство';
				|en = 'Shop floor papers'; fa = 'برگه‌های کارگاه';
				|it = 'Task di produzione';
				|pl = 'Zadanie na produkcję';
				|tr = 'Üretim görevi'"),
			SpreadsheetDocument);
		
	EndIf;
	
	If PrintManagement.TemplatePrintRequired(PrintFormsCollection, "ProductionBatchMaintenanceSheet") Then
		
		SpreadsheetDocument = ToFormPrintedFormOfSheetOfBatchOfProduction(
			ObjectsArray, PrintObjects, PrintParameters);
		
		PrintManagement.OutputSpreadsheetDocumentToCollection(
			PrintFormsCollection,
			"ProductionBatchMaintenanceSheet",
			NStr("vi = 'Giấy tờ kèm theo lô hàng sản xuất';
				|ru = 'Лист сопровождения партии производства';
				|en = 'Accompanying sheet for production lot'; fa = 'برگه همراه لات تولید';
				|it = 'Foglio di accompagnamento del lotto di produzione';
				|pl = 'Arkusz prowadzenia partii produkcji';
				|tr = 'Üretim lotları eşlik listesi'"),
			SpreadsheetDocument);
		
	EndIf;
	
	ProductionStage2_2Localization.Print(ObjectsArray, PrintParameters, PrintFormsCollection, PrintObjects, OutputParameters);
	PrintFormGeneration.FillInSendingParameters(
		OutputParameters.SendOptions,
		ObjectsArray,
		PrintFormsCollection);
		
EndProcedure

#Region ProductionJob

Function CreatePrintedFormOfProductionOrder(ObjectsArray, PrintObjects, PrintParameters)
	
	SpreadsheetDocument = New SpreadsheetDocument;
	SpreadsheetDocument.FitToPage = True;
	SpreadsheetDocument.PageOrientation = PageOrientation.Landscape;
	SpreadsheetDocument.PrintParametersName = "Parameters_Seals_ProductionStage2_2_ProductionJob";
	
	Template = PrintManagement.PrintFormTemplate("Document.ProductionStage2_2.PF_MXL_ProductionJob");
	FirstDocument = True;
	
	DataForPrint = GetDataForPrintedProductionOrderForm(ObjectsArray, PrintParameters);
	SampleDocument = DataForPrint.SampleDocument;
	
	While SampleDocument.Next() Do
	
		If Not FirstDocument Then
			SpreadsheetDocument.PutHorizontalPageBreak();
		EndIf;
		FirstDocument = False;
		
		RowNumberStart = SpreadsheetDocument.TableHeight + 1;
		
		ProductionTaskPrintTitle(SpreadsheetDocument, Template, SampleDocument);
		
		ProductionTaskDisplayHeader(SpreadsheetDocument, Template, SampleDocument);
		
		TaskForProductionIsToOutputAdjacentStages(
			PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint, True);
			
		ProductionAssignmentOutputMaterials(
			PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint);
		
		ProductionTaskOutputOutputProducts(
			PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint);
		
		TaskForProductionIsToOutputAdjacentStages(
			PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint, False);
		
		ProductionAndOperationsAssignment(
			PrintParameters, SpreadsheetDocument, Template, SampleDocument);
		
		PrintManagement.SetDocumentPrintArea(
			SpreadsheetDocument,
			RowNumberStart,
			PrintObjects,
			SampleDocument.Ref);
		
	EndDo;
	
	Return SpreadsheetDocument;
	
EndFunction

Function GetDataForPrintedProductionOrderForm(ObjectsArray, PrintParameters)
	
	BatchQueryText = New Array;
	IndexesOfResults = New Map;
	IndexOf = 0;
	
	#Region QueryTextHeader
	
	QueryText =
	"SELECT
	|	DocumentData.Ref            AS Ref,
	|	DocumentData.Number             AS Number,
	|	DocumentData.StageName AS StageName,
	|
	|	DocumentData.ReferenceOrder                AS ReferenceOrder,
	|	DocumentData.ReferenceOrder.Presentation  AS PresentationOfOrder,
	|	DocumentData.Department               AS Department,
	|	DocumentData.Department.Presentation AS DivisionRepresentation,
	|
	|	DocumentData.ProductionLot.MainProductProducts                              AS Product,
	|	DocumentData.ProductionLot.MainProductCharacteristic                            AS ProductFeature,
	|	ISNULL(DocumentData.ProductionLot.MainProductProducts.Description, """") AS ProductPresentation,
	|	CASE
	|		WHEN DocumentData.ProductionLot.MainProductCharacteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND DocumentData.ProductionLot.MainProductProducts.UseVariants IN (
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|						VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems),
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|			THEN DocumentData.ProductionLot.MainProductCharacteristic.Description
	|		ELSE """"
	|	END                                                                                       AS ProductFeaturePresentation,
	|
	|	DocumentData.BillOfMaterials                                                                AS BillOfMaterials,
	|	DocumentData.BillOfMaterials.Presentation                                                  AS PresentationOfSpecification,
	|	DocumentData.Stage                                                                        AS BOMStage,
	|
	|	DocumentData.Department.UseOperationManagement  AS UseOperationManagement,
	|
	|	&TechProcessParameters,
	|
	|	DocumentData.NumberOfPackagesPlan     AS Count,
	|	ISNULL(&PackagingFactor, 1)          AS PackagingFactor,
	|	CASE
	|		WHEN DocumentData.PackagePlan = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN PRESENTATION(DocumentData.ProductionLot.MainProductProducts.UnitOfMeasure)
	|		ELSE PRESENTATION(DocumentData.PackagePlan)
	|	END                                      AS UnitOfMeasurePresentation,
	|
	|	ISNULL(ProductionSchedule.Ending, DATETIME(1, 1, 1)) AS PlannedEndOfStage,
	|
	|	DocumentData.Performer.Presentation AS ArtistPresentation,
	|
	|	ISNULL(TechnicalProcess.FirstOperationID, 0) AS FirstOperationID,
	|	ISNULL(TechnicalProcess.LastOperationID, 0) AS LastOperationID
	|FROM
	|	Document.ProductionStage2_2 AS DocumentData
	|		
	|		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionSchedule
	|		ON DocumentData.Ref = ProductionSchedule.Stage
	|			AND DocumentData.ReferenceOrder = ProductionSchedule.ProductionOrder
	|			AND (ProductionSchedule.ScheduleStatus = &WorkingSchedule)
	|		
	|		LEFT JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcess
	|		ON DocumentData.Ref = TechnicalProcess.Stage
	|
	|WHERE
	|	DocumentData.Ref IN(&ObjectsArray)
	|
	|ORDER BY
	|	Ref";
	
	QueryTextPackagingFactor = Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"DocumentData.PackagePlan",
		"DocumentData.ProductionLot.MainProductProducts");
		
	QueryText = StrReplace(
		QueryText,
		"&PackagingFactor",
		QueryTextPackagingFactor);
		
	QueryText = StrReplace(QueryText,
		"&TechProcessParameters",
		ProductionProcessEditor.QueryTextParametersOfTechnicalProcessOfStage("DocumentData"));
	
	BatchQueryText.Add(QueryText);
	IndexesOfResults.Insert("SampleDocument", IndexOf);
	IndexOf = IndexOf + 1;
	
	#EndRegion
	
	#Region QueryTextAdjacentStages
	
	If ProductionAssignmentAndRelatedStages(PrintParameters) Then
		
		QueryText =
		"SELECT
		|	TTCommunicationStages.NextStage AS Ref,
		|	TTCommunicationStages.Stage AS ProductionStage,
		|	&TTCommunicationStagesPresentationStage AS PresentationStage,
		|	CAST(TTCommunicationStages.Stage AS Document.ProductionStage2_2).Department AS Department
		|FROM
		|	TTCommunicationStages AS TTCommunicationStages
		|WHERE
		|	TTCommunicationStages.NextStage IN(&ObjectsArray)
		|
		|ORDER BY
		|	Ref,
		|	ProductionStage
		|TOTALS BY
		|	Ref";
		
		TextPresentationOfStage = QueryTextPresentationStage("TTCommunicationStages.Stage");
		QueryText = StrReplace(
			QueryText,
			"&TTCommunicationStagesPresentationStage",
			TextPresentationOfStage);
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SamplingPredecessors", IndexOf);
		IndexOf = IndexOf + 1;
		
		QueryText =
		"SELECT
		|	TTCommunicationStages.Stage AS Ref,
		|	TTCommunicationStages.NextStage AS ProductionStage,
		|	&TTCommunicationStagesPresentationNextStage AS PresentationStage,
		|	CAST(TTCommunicationStages.NextStage AS Document.ProductionStage2_2).Department AS Department
		|FROM
		|	TTCommunicationStages AS TTCommunicationStages
		|WHERE
		|	TTCommunicationStages.Stage IN(&ObjectsArray)
		|
		|ORDER BY
		|	Ref,
		|	ProductionStage
		|TOTALS BY
		|	Ref";
		
		TextPresentationOfStage = QueryTextPresentationStage("TTCommunicationStages.NextStage");
		QueryText = StrReplace(
			QueryText,
			"&TTCommunicationStagesPresentationNextStage",
			TextPresentationOfStage);
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SamplingFollowers", IndexOf);
		IndexOf = IndexOf + 1;
		
	EndIf;
	
	#EndRegion
	
	#Region QueryTextUsedMaterials
	
	If ProductionAssignmentPrintMaterials(PrintParameters) Then
		
		QueryText = "
		|SELECT
		|	UsedMaterials.Ref AS Ref,
		|	UsedMaterials.Products AS Products,
		|	UsedMaterials.Products.Code AS Code,
		|	UsedMaterials.Products.SKU AS SKU,
		|	UsedMaterials.Products.DescriptionFull AS ProductFullName,
		|	UsedMaterials.Characteristic.DescriptionFull AS CharacteristicFullName,
		|	UsedMaterials.Warehouse AS Warehouse,
		|	UsedMaterials.Warehouse.Presentation AS WarehousePresentation_,
		|	CASE
		|		WHEN UsedMaterials.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			THEN PRESENTATION(UsedMaterials.Products.UnitOfMeasure)
		|		ELSE PRESENTATION(UsedMaterials.Package)
		|	END AS UnitOfMeasurePresentation,
		|	UsedMaterials.NumberOfPackages AS Count
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS UsedMaterials
		|WHERE
		|	UsedMaterials.Ref IN(&ObjectsArray)
		|	AND NOT UsedMaterials.Canceled
		|
		|ORDER BY
		|	Ref,
		|	UsedMaterials.LineNumber
		|TOTALS BY
		|	Ref";
		
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SampleMaterials", IndexOf);
		IndexOf = IndexOf + 1;
		
	EndIf;
	
	#EndRegion
	
	#Region QueryTextManufacturedProducts
	
	If ProductionAssignmentPrintOutputProducts(PrintParameters) Then
		
		QueryText = "
		|SELECT
		|	ProductionIssue.Ref AS Ref,
		|	ProductionIssue.Products AS Products,
		|	ProductionIssue.Characteristic AS Characteristic,
		|	ProductionIssue.Recipient AS Recipient,
		|	CASE
		|		WHEN ProductionIssue.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			THEN PRESENTATION(ProductionIssue.Products.UnitOfMeasure)
		|		ELSE PRESENTATION(ProductionIssue.Package)
		|	END AS UnitOfMeasurePresentation,		
		|	ProductionIssue.NumberOfPackages AS Count,
		|	ProductionIssue.Purpose AS Purpose,
		|	ProductionIssue.StageConsumer AS StageConsumer,
		|	ProductionIssue.LineNumber AS LineNumber
		|INTO TTIssue
		|FROM
		|	Document.ProductionStage2_2.ManufacturedProducts AS ProductionIssue
		|WHERE
		|	ProductionIssue.Ref IN(&ObjectsArray)
		|	AND NOT ProductionIssue.Canceled
		|
		|UNION ALL
		|
		|SELECT
		|	SideRelease.Ref,
		|	SideRelease.Products,
		|	SideRelease.Characteristic,
		|	SideRelease.Recipient,
		|	CASE
		|		WHEN SideRelease.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			THEN PRESENTATION(SideRelease.Products.UnitOfMeasure)
		|		ELSE PRESENTATION(SideRelease.Package)
		|	END,
		|	SideRelease.NumberOfPackages,
		|	SideRelease.Purpose,
		|	SideRelease.StageConsumer,
		|	SideRelease.LineNumber
		|FROM
		|	Document.ProductionStage2_2.SideAndIntermediateRelease AS SideRelease
		|WHERE
		|	SideRelease.Ref IN(&ObjectsArray)
		|	AND NOT SideRelease.Canceled
		|
		|INDEX BY
		|	Purpose
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ProductionIssue.Ref AS Ref,
		|	ProductionIssue.Products AS Products,
		|	ProductionIssue.Products.Code AS Code,
		|	ProductionIssue.Products.SKU AS SKU,
		|	ProductionIssue.Products.DescriptionFull AS ProductFullName,
		|	ProductionIssue.Characteristic.DescriptionFull AS CharacteristicFullName,
		|	CASE
		|		WHEN ProductionIssue.StageConsumer <> &EmptyStageLink 
		|			THEN &PresentationStage
		|		ELSE ProductionIssue.Purpose.Presentation
		|	END AS PurposePresentation,
		|	ProductionIssue.Recipient AS Recipient,
		|	ProductionIssue.Recipient.Presentation AS RecipientPresentation1,
		|	ProductionIssue.UnitOfMeasurePresentation AS UnitOfMeasurePresentation,
		|	ProductionIssue.Count AS Count
		|FROM
		|	TTIssue AS ProductionIssue
		|
		|ORDER BY
		|	Ref,
		|	ProductionIssue.LineNumber
		|TOTALS BY
		|	Ref";
			
		TextPresentationOfStage = QueryTextPresentationStage("ProductionIssue.StageConsumer");
		
		QueryText = StrReplace(
			QueryText,
			"&PresentationStage",
			TextPresentationOfStage);
		
		IndexOf = IndexOf + 1;
		BatchQueryText.Add(QueryText);
		IndexesOfResults.Insert("SamplingOutputProducts", IndexOf);
		IndexOf = IndexOf + 1;
		
	EndIf;
	
	#EndRegion
	
	#Region AssemblingText
	
	Separator =
	"
	|;
	|/////////////////////////////////////////////////////////////
	|";
	
	QueryText = StrConcat(BatchQueryText, Separator);
	
	#EndRegion
	
	#Region RequestExecution
	
	Query = New Query(QueryText);
	Query.SetParameter("ObjectsArray", ObjectsArray);
	Query.SetParameter("EmptyStageLink", Documents.ProductionStage2_2.EmptyRef());
	Query.SetParameter("WorkingSchedule", InformationRegisters.ScheduleOfProductionStages2_2.StatusWorkingSchedule());
	Query.SetParameter("StoreOperationsInBillsOfMaterials", GetFunctionalOption("StoreOperationsInBillsOfMaterials"));
	Query.TempTablesManager = New TempTablesManager;
	
	SetPrivilegedMode(True);
	
	If ProductionAssignmentAndRelatedStages(PrintParameters) Then
		CreateVTLinksOfStages(Query.TempTablesManager, ObjectsArray);
	EndIf;
	
	ResultsArray = Query.ExecuteBatch();  
	
	SetPrivilegedMode(False);
	
	DataForPrint = New Structure;
	
	For Each Result In IndexesOfResults Do
		
		QueryResult = ResultsArray[Result.Value]; // QueryResult
		Selection = QueryResult.Select(
			?(Result.Key = "SampleDocument",
				QueryResultIteration.Linear,
				QueryResultIteration.ByGroups));
		DataForPrint.Insert(Result.Key, Selection);
		
	EndDo;
	
	#EndRegion
	
	Return DataForPrint;
	
EndFunction

