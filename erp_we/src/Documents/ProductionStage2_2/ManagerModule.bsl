#Region BatchFormationOfRegisteredRecords

Procedure FillInFormAndReflectRegisteredRecordsByStages(Parameters, Stages, TTManagerWaysToGetMaterials, OrderStructureCalculationQueue = 0) Export
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	FillInInitializationParameters(Query);
	
	// Sampling the processing queue
	Query.Text = 
		"SELECT TOP 100000000
		|	Stages.Ref AS Ref,
		|	RECORDAUTONUMBER() AS Queue
		|INTO TTProcessingQueue
		|FROM
		|	Document.ProductionStage2_2 AS Stages
		|		LEFT JOIN InformationRegister.LocationOfLaunchedLotAndStagesInOrderStructure AS LocationOfLaunchedLotAndStagesInOrderStructure
		|		ON Stages.ProductionLot = LocationOfLaunchedLotAndStagesInOrderStructure.Lot
		|		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardScheduleOfProductionStages
		|		ON Stages.Ref = StandardScheduleOfProductionStages.ProductionStage
		|WHERE
		|	Stages.Ref IN(&Ref)
		|
		|ORDER BY
		|	Stages.ReferenceOrder.Priority.AddlOrderingAttribute,
		|	Stages.ReferenceOrder.Department.AddlOrderingAttribute,
		|	Stages.ReferenceOrder.Queue,
		|	ISNULL(StandardScheduleOfProductionStages.DurationBeforeStart, -(ISNULL(LocationOfLaunchedLotAndStagesInOrderStructure.DurationBeforeProductionIssue, 0) + Stages.DurationBeforeProductionIssue))
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTProcessingQueue.Ref AS Ref,
		|	TTProcessingQueue.Queue AS Queue
		|FROM
		|	TTProcessingQueue AS TTProcessingQueue
		|
		|ORDER BY
		|	Queue,
		|	Ref";
	Query.SetParameter("Ref", Stages);
	
	SetPrivilegedMode(True);
	ProcessingQueue = Query.Execute().Unload().UnloadColumn("Ref");
	SetPrivilegedMode(False);
	
	MovableRegisters = RegistersForBatchGenerationOfRegisteredRecords(); // Structure
	QueryTexts    = RequestTextsForGeneratingRegisteredRecords(Query, Undefined, MovableRegisters); // ValueList
	
	NameOfDataVersionTable   = "Table" + "DataVersions";
	QueryTextDataVersions =
	"SELECT
	|	Stages.Ref             AS Ref,
	|	Stages.DataVersion       AS DataVersion,
	|	ProcessingQueue.Queue AS Queue
	|FROM
	|	Document.ProductionStage2_2 AS Stages
	|		INNER JOIN TTProcessingQueue AS ProcessingQueue
	|		ON Stages.Ref = ProcessingQueue.Ref
	|WHERE
	|	Stages.Ref IN (&Ref)
	|
	|ORDER BY
	|	Queue,
	|	Ref";
	
	QueryTexts.Add(QueryTextDataVersions, NameOfDataVersionTable);
	
	// Processing of documents in portions of 1000 pieces
	ProcessingPortion = New Array;
	MaxIndex_ = ProcessingQueue.UBound();
	
	For IndexOf = 0 To MaxIndex_ Do
		
		ProcessingPortion.Add(ProcessingQueue[IndexOf]);
		
		If IndexOf = MaxIndex_ Or ProcessingPortion.Count() = 1000 Then
			
			// Filling out security
			SoftwareInBatchMode(ProcessingPortion, Parameters, TTManagerWaysToGetMaterials);
			
			// The formation of movements
			For AttemptCounter = 1 To 2 Do
				
				Query.SetParameter("Ref", ProcessingPortion);
				
				SetPrivilegedMode(True);
				TablesForRegisteredRecords = DocumentsPosting.InitializeDocumentDataForPosting(
										Query, QueryTexts, Undefined);
				SetPrivilegedMode(False);
				
				TMCommonUse.DestroyTemporaryTables(Query.TempTablesManager,, "TTProcessingQueue");
				
				DataVersionTable = TablesForRegisteredRecords[NameOfDataVersionTable];
				TablesForRegisteredRecords.Delete(NameOfDataVersionTable);
				
				StagesOfFailure = GenerateRegisteredRecordsInBatchMode(
					TablesForRegisteredRecords, DataVersionTable, MovableRegisters, OrderStructureCalculationQueue);
				
				If StagesOfFailure.UBound() = -1 Then
					Break;
				Else
					
					ProcessingPortion.Clear();
					
					For Each KeyAndValue In Common.ObjectsAttributeValue(StagesOfFailure, "Status") Do
						
						Ref = KeyAndValue.Key;
						Status = KeyAndValue.Value;
						CancelPosting = True;
						
						// Downgrading the status
						If Status <> Enums.StatusesOfProductionStages2_2.BeingGenerated Then
							Try
								DocumentObject = Ref.GetObject();
								DocumentObject.Status = Enums.StatusesOfProductionStages2_2.BeingGenerated;
								DocumentObject.DataExchange.Load = True;
								DocumentObject.Write(DocumentWriteMode.Write);
								
								// Repeated attempt to conduct
								ProcessingPortion.Add(Ref);
								CancelPosting = False;
							Except
								Event = NStr("vi = 'Công đoạn sản xuất';
											|ru = 'Этап производства';
											|en = 'Production stage'; fa = 'مرحله تولید';
											|it = 'Fase di produzione';
											|pl = 'Etap produkcji';
											|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
									+ NStr("vi = 'Lập bản ghi kết chuyển theo gói';
											|ru = 'Пакетное формирование движений';
											|en = 'Batch register records generation'; fa = 'Batch register records generation';
											|it = 'Formazione in lotti dei movimenti';
											|pl = 'Tworzenie pakietów ruchów';
											|tr = 'Hareketlerin toplu düzenlenmesi'", Common.DefaultLanguageCode());
								WriteLogEvent(Event, EventLogLevel.Error,,,
									DetailErrorDescription(ErrorInfo()));
							EndTry;
						EndIf;
						
						// Cancellation of the event
						If CancelPosting Then
							Try
								DocumentObject = Ref.GetObject();
								DocumentObject.Write(DocumentWriteMode.UndoPosting);
							Except
								Event = NStr("vi = 'Công đoạn sản xuất';
											|ru = 'Этап производства';
											|en = 'Production stage'; fa = 'مرحله تولید';
											|it = 'Fase di produzione';
											|pl = 'Etap produkcji';
											|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
									+ NStr("vi = 'Lập bản ghi kết chuyển theo gói';
											|ru = 'Пакетное формирование движений';
											|en = 'Batch register records generation'; fa = 'Batch register records generation';
											|it = 'Formazione in lotti dei movimenti';
											|pl = 'Tworzenie pakietów ruchów';
											|tr = 'Hareketlerin toplu düzenlenmesi'", Common.DefaultLanguageCode());
								WriteLogEvent(Event, EventLogLevel.Error,,,
									DetailErrorDescription(ErrorInfo()));
							EndTry;
						EndIf;
						
					EndDo;
					
					If ProcessingPortion.UBound() = -1 Then
						Break;
					EndIf;
					
				EndIf;
				
			EndDo;
			
			ProcessingPortion.Clear();
			
		EndIf;
		
	EndDo;
	
	If GetFunctionalOption("DynamicStructureOfProductionOrders") Then
		OrderStructureDocumentPosting.GenerateTasksBatchGenerationOfStages(
			Stages,
			OrderStructureCalculationQueue);
	EndIf;
	
EndProcedure

Function RegistersForBatchGenerationOfRegisteredRecords()
	
	Result = New Structure;
	Result.Insert("ShipmentAndReturnReferences",	   "Table" + "ShipmentAndReturnReferences");
	Result.Insert("OrdersOfMaterialsForProduction",		   "Table" + "OrdersOfMaterialsForProduction");
	Result.Insert("PurchaseOrders",					   "Table" + "PurchaseOrders");
	Result.Insert("GoodsBatchMovement",				   "Table" + "GoodsBatchMovement");
	Result.Insert("InventoryAndDemands",				   "Table" + "InventoryAndDemands");
	Result.Insert("ProductionProcessSupply", "Table" + "ProductionProcessSupply");
	Result.Insert("ProductionOrders",                 "Table" + "ProductionOrders");
	Result.Insert("OrderStructure",					   "Table" + "OrderStructure");
	Result.Insert("OrderStructureLaborCosts",		   "Table" + "OrderStructureLaborCosts");
	Result.Insert("GoodsForIssue",					   "Table" + "GoodsForIssue");
	Result.Insert("DocumentsRegistry",					   "Table" + "DocumentsRegistry");
	
	Return Result;
	
EndFunction

Procedure SoftwareInBatchMode(Stages, Parameters, TempTablesManager)
	
	If Not Parameters.ReserveMaterials Then
		Return;
	EndIf;
	
	If Parameters.ReplaceMaterialsWithAnalogs And TempTablesManager.Tables.Find("TTExceptionsReplacementWithAnalogs") = Undefined Then 
		Documents.ProductionOrder2_2.CreateTTExceptionsReplacingWithAnalogs(TempTablesManager, Parameters.References);
	EndIf;
	
	DynamicStructureIsUsed = GetFunctionalOption("DynamicStructureOfProductionOrders");
	
	QueryTexts = New Array;
	
	QueryText =
		"SELECT DISTINCT
		|	UsedMaterials.Products   AS Products,
		|	UsedMaterials.Characteristic AS Characteristic,
		|	UsedMaterials.Warehouse          AS Warehouse,
		|	UsedMaterials.SupplyAssignment AS Purpose
		|INTO TTMaterials
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS UsedMaterials
		|WHERE
		|	UsedMaterials.Ref IN (&Stages)
		|	AND NOT UsedMaterials.Produced
		|	AND NOT UsedMaterials.Canceled
		|	AND UsedMaterials.SupplyOption IN(
		|		VALUE(Enum.SupplyOptions.ReserveAsReceived),
		|		VALUE(Enum.SupplyOptions.ToSupply))
		|	AND UsedMaterials.Products <> VALUE(Catalog.Products.EmptyRef)
		|	AND UsedMaterials.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|
		|INDEX BY
		|	Products, Characteristic, Warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	UsedMaterials.Products AS Products,
		|	UsedMaterials.Characteristic AS Characteristic,
		|	UsedMaterials.Warehouse AS Warehouse,
		|	UsedMaterials.Purpose AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference
		|INTO TTAnalytics_
		|FROM
		|	TTMaterials AS UsedMaterials
		|
		|UNION ALL
		|
		|SELECT DISTINCT
		|	UsedMaterials.Products AS Products,
		|	UsedMaterials.Characteristic AS Characteristic,
		|	UsedMaterials.Warehouse AS Warehouse,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference
		|FROM
		|	TTMaterials AS UsedMaterials
		|
		|INDEX BY
		|	Products, Characteristic, Warehouse, Purpose
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	UsedMaterials.Products      AS Products,
		|	UsedMaterials.Characteristic    AS Characteristic,
		|	UsedMaterials.Warehouse             AS Warehouse,
		|	UsedMaterials.Purpose        AS Purpose,
		|	SUM(UsedMaterials.Count) AS Count
		|INTO TTReserves
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS UsedMaterials
		|WHERE
		|	UsedMaterials.Ref IN(&Stages)
		|	AND UsedMaterials.Products <> VALUE(Catalog.Products.EmptyRef)
		|	AND UsedMaterials.SupplyOption = VALUE(Enum.SupplyOptions.FromWarehouse)
		|	AND NOT UsedMaterials.Canceled
		|
		|GROUP BY
		|	UsedMaterials.Products,
		|	UsedMaterials.Characteristic,
		|	UsedMaterials.Warehouse,
		|	UsedMaterials.Purpose";
	QueryTexts.Add(QueryText);
	
	QueryText =
		"SELECT
		|	Inventories.Products AS Products,
		|	Inventories.Characteristic AS Characteristic,
		|	Inventories.Warehouse AS Warehouse,
		|	Inventories.Purpose AS Purpose,
		|	Inventories.InStockBalance AS InStockBalance,
		|	Inventories.LockedInStockBalance AS LockedInStockBalance,
		|	Inventories.OrderedBalance AS OrderedBalance,
		|	Inventories.Received_1Balance AS Received_1Balance,
		|	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
		|	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
		|	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
		|	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
		|	Inventories.ToSupplyBalance AS ToSupplyBalance,
		|	Inventories.NotProvideBalance AS NotProvideBalance
		|INTO InventoryAndDemandsBalance
		|FROM
		|	AccumulationRegister.InventoryAndDemands.Balance(,
		|		(Products, Characteristic, Warehouse, Purpose) IN(
		|			SELECT
		|				Table.Products   AS Products,
		|				Table.Characteristic AS Characteristic,
		|				Table.Warehouse          AS Warehouse,
		|				Table.Purpose     AS Purpose
		|			FROM
		|				TTAnalytics_ AS Table)) AS Inventories
		|;
		|
		|//////////////////////////////////////////////////
		|SELECT
		|	Changes.Products AS Products,
		|	Changes.Characteristic AS Characteristic,
		|	Changes.Warehouse AS Warehouse,
		|	Changes.Purpose AS Purpose,
		|	&LinkOfNewStage AS OrderDocument,
		|	0 AS InStock,
		|	0 AS LockedInStock,
		|	0 AS Ordered,
		|	0 AS Received_1,
		|	0 AS LockedReceipt,
		|	0 AS ToUnlock,
		|	Changes.Count AS ReserveAtWarehouse,
		|	0 AS ReserveAsReceived,
		|	0 AS SnoozeReservation,
		|	0 AS ToSupply,
		|	0 AS NotProvide,
		|	0 AS ReserveAtWarehouseFromLocked,
		|	0 AS ReserveUponReceiptFromLocked
		|INTO InventoryAndDemandsUpdate
		|FROM
		|	TTReserves AS Changes
		|;
		|
		|//////////////////////////////////////////////////
		|SELECT
		|	Calculation.Products AS Products,
		|	Calculation.Characteristic AS Characteristic,
		|	Calculation.Warehouse AS Warehouse,
		|	Calculation.Purpose AS Purpose,
		|	Calculation.QuantityForShipAction AS Count
		|FROM
		|	CalculationOfBalancesForSettingActions AS Calculation
		|WHERE
		|	Calculation.QuantityForShipAction > 0
		|;
		|
		|/////////////////////////////////////////////////////
		|DROP InventoryAndDemandsBalance
		|;
		|
		|/////////////////////////////////////////////////////
		|DROP InventoryAndDemandsUpdate";
	
	TablesNames = ProvisionInDocumentsServer.NewTableNamesForCalculatingBalancesForSettingActions();
	TablesNames.Analysts = "TTAnalytics_"; // @query-part-1
	TablesNames.Balance = "InventoryAndDemandsBalance"; // @query-part-1
	TablesNames.InventoryAndDemandsUpdate = "InventoryAndDemandsUpdate";
	TablesNames.Result = "CalculationOfBalancesForSettingActions"; // @query-part-1
	ProvisionInDocumentsServer.CalculationOfBalancesForSettingActions(QueryText, TablesNames);
	QueryTexts.Add(QueryText);
	
	QueryText =
		"SELECT
		|	Stages.Ref                                           AS Stage,
		|	ISNULL(StandardScheduleOfProductionStages.DurationBeforeStart, -(ISNULL(LocationOfLaunchedLotAndStagesInOrderStructure.DurationBeforeProductionIssue, 0) + Stages.DurationBeforeProductionIssue)) AS Queue,
		|	UsedMaterials.Department                                AS Department,
		|	UsedMaterials.LineNumber                                  AS LineNumber,
		|	UsedMaterials.RowCode                                    AS RowCode,
		|	UsedMaterials.LinkKeyBOM                        AS LinkKeyBOM,
		|	UsedMaterials.Products                                 AS Products,
		|	UsedMaterials.Products.ItemsType                 AS ItemsType,
		|	UsedMaterials.Characteristic                               AS Characteristic,
		|	UsedMaterials.Warehouse                                        AS Warehouse,
		|	UsedMaterials.SupplyAssignment                        AS SupplyAssignment,
		|	UsedMaterials.Series                                        AS Series,
		|	UsedMaterials.WithAssignment                                  AS WithAssignment,
		|	UsedMaterials.SupplyOption                           AS SupplyOption,
		|	UsedMaterials.DateOfShipment                                 AS DateOfShipment,
		|	UsedMaterials.Count                                   AS Count,
		|	UsedMaterials.Count                                   AS TotalCount1,
		|
		|	UsedMaterials.CommunicationKeySet                               AS CommunicationKeySet,
		|	CASE
		|		WHEN Sets.BillOfMaterials REFS Catalog.BillsOfMaterials
		|				THEN Sets.BillOfMaterials
		|		ELSE Sets.ParentSpecification
		|	END                                                  AS BillOfMaterialsSet,
		|
		|	Stages.Stage                                             AS StageOfResourceBillOfMaterials,
		|	Stages.ReferenceOrder                                     AS ProductionOrder,
		|	Stages.ReferenceOrder.LineOfBusiness             AS LineOfBusiness,
		|	Stages.BillOfMaterials                                     AS BillOfMaterials,
		|	Stages.ProductionLot.MainProductProducts   AS Product,
		|	Stages.ProductionLot.MainProductCharacteristic AS ItemVariantOfProduct,
		|
		|	&QueryTextReplacementWithAnaloguesAttribute                    AS ReplacementWithAnalogues
		|
		|FROM
		|	Document.ProductionStage2_2 AS Stages
		|
		|		INNER JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS UsedMaterials
		|		ON UsedMaterials.Ref = Stages.Ref
		|
		|		LEFT JOIN InformationRegister.LocationOfLaunchedLotAndStagesInOrderStructure AS LocationOfLaunchedLotAndStagesInOrderStructure
		|		ON Stages.ProductionLot = LocationOfLaunchedLotAndStagesInOrderStructure.Lot
		|		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardScheduleOfProductionStages
		|		ON Stages.Ref = StandardScheduleOfProductionStages.ProductionStage
		|
		|		LEFT JOIN Document.ProductionStage2_2.MaterialsAndWorksSets AS Sets
		|		ON Sets.Ref = Stages.Ref
		|			AND Sets.ConnectionKey = UsedMaterials.CommunicationKeySet
		|
		|WHERE
		|	Stages.Ref IN(&Stages)
		|	AND NOT UsedMaterials.Produced
		|	AND NOT UsedMaterials.Canceled
		|	AND UsedMaterials.SupplyOption IN(
		|		VALUE(Enum.SupplyOptions.ReserveAsReceived),
		|		VALUE(Enum.SupplyOptions.ToSupply))
		|	AND UsedMaterials.Products <> VALUE(Catalog.Products.EmptyRef)
		|	AND UsedMaterials.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|	AND UsedMaterials.Count <> 0
		|
		|ORDER BY
		|	Stages.ReferenceOrder.Priority.AddlOrderingAttribute,
		|	Stages.ReferenceOrder.Department.AddlOrderingAttribute,
		|	Stages.ReferenceOrder.Queue,
		|	Queue,
		|	Stage,
		|	LineNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Reserves.Products   AS Products,
		|	Reserves.Characteristic AS Characteristic,
		|	Reserves.Warehouse          AS Warehouse,
		|	Reserves.Purpose     AS Purpose,
		|	Reserves.Count     AS Count
		|FROM
		|	TTReserves AS Reserves
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTMaterials
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTAnalytics_
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTReserves";
	
	If Parameters.ReplaceMaterialsWithAnalogs Then
		QueryText = StrReplace(
			QueryText,
			"&QueryTextReplacementWithAnaloguesAttribute",
			"NOT TRUE IN
			|	(SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTExceptionsReplacementWithAnalogs AS Exceptions
			|		WHERE
			|			Exceptions.ReferenceOrder     = Stages.ReferenceOrder
			|			AND Exceptions.Products   = UsedMaterials.Products
			|			AND Exceptions.Characteristic = UsedMaterials.Characteristic
			|			AND Exceptions.Warehouse          = UsedMaterials.Warehouse)");
	Else
		QueryText = StrReplace(QueryText, "&QueryTextReplacementWithAnaloguesAttribute", "FALSE");
	EndIf;
	
	QueryTexts.Add(QueryText);
	
	QueryText = StrConcat(QueryTexts, Common.QueryBatchSeparator());
	
	Query = New Query(QueryText);
	Query.SetParameter("Stages", Stages);
	Query.SetParameter("EmptyLinkKey", CommonClientServer.BlankUUID());
	Query.TempTablesManager = TempTablesManager;
	Query.SetParameter("LinkOfNewStage", Documents.ProductionStage2_2.GetRef());
	
	SetPrivilegedMode(True);
	ResultsPackage = Query.ExecuteBatch();
	SetPrivilegedMode(False);
	
	Balance = ResultsPackage[ResultsPackage.UBound()-9].Unload();
	UsedMaterials = ResultsPackage[ResultsPackage.UBound()-4].Unload();
	If UsedMaterials.Count() = 0
		Or Balance.Count() = 0 And Not Parameters.ReplaceMaterialsWithAnalogs Then
		Return;
	EndIf;
	
	Balance.Indexes.Add("Products, Characteristic, Warehouse, Purpose");
	TheStructureOfTheSearchBalance = New Structure("Products, Characteristic, Warehouse, Purpose");
	
	UsedMaterials.Columns.Add("Id", New TypeDescription("Number", New NumberQualifiers(10)));
	UsedMaterials.Columns.Add("OffsettingSeparatelyInWarehouse", New TypeDescription("Number", New NumberQualifiers(15, 3)));
	UsedMaterials.Columns.Add("OffsettingSeparatelyInSchedule", New TypeDescription("Number", New NumberQualifiers(15, 3)));
	UsedMaterials.Columns.Add("OffsettingIsNotSeparateInWarehouse", New TypeDescription("Number", New NumberQualifiers(15, 3)));
	UsedMaterials.Columns.Add("CreditedByAnalogues", New TypeDescription("Number", New NumberQualifiers(15, 3)));
	
	// Initialization of tables for replacement with analogues
	MaterialsReplace = Undefined;
	Reserves = Undefined;
	If Parameters.ReplaceMaterialsWithAnalogs Then
		
		MaterialsReplace = UsedMaterials.CopyColumns(
			"Id, Queue, Stage, Products, Characteristic, Department, SupplyAssignment, WithAssignment, Warehouse,
			|LineOfBusiness, ProductionOrder, BillOfMaterials, StageOfResourceBillOfMaterials,
			|Product, ItemVariantOfProduct, Count, TotalCount1");
		
		Reserves = ResultsPackage[ResultsPackage.UBound()-3].Unload();
		
	EndIf;
	
	// Getting data on priority replacements
	PriorityAnalogues = Undefined;
	
	If Parameters.ReplaceMaterialsWithAnalogs
	   And DynamicStructureIsUsed Then
	
		Filter = New Map();
		TMCommonUse.AddSelectionItemToCollection(Filter, "AlternativeMaterials.ReplacementPriority", "&ReplacementPriority");
		TMCommonUse.AddSelectionItemToCollection(Filter, "AlternativeMaterials.UseItForAutocorrectInOrders", "&UseItForAutocorrectInOrders");
		
		PermissionSelectionParameters = New Map();
		PermissionSelectionParameters.Insert("ReplacementPriority", Enums.RulesOfReplacingWithSubstitutes.IfThereIsSubstitute);
		PermissionSelectionParameters.Insert("UseItForAutocorrectInOrders", CommonClientServer.ValueInArray(True));
		
		SelectionOfPermissions = New Structure();
		SelectionOfPermissions.Insert("Filter", Filter);
		SelectionOfPermissions.Insert("PermissionSelectionParameters", PermissionSelectionParameters);
		
		TMCommonUse.NumberValueTable(UsedMaterials, "Id");
		
		MaterialsIsCopy = UsedMaterials.CopyColumns(
			"Id, Queue, Stage, Products, Characteristic, Department, SupplyAssignment, WithAssignment, Warehouse,
			|LineOfBusiness, ProductionOrder, BillOfMaterials, StageOfResourceBillOfMaterials,
			|Product, ItemVariantOfProduct, Count, TotalCount1");
		
		Id = 1;
		
		For Each String In UsedMaterials Do
			
			If String.ReplacementWithAnalogues Then
			
				NewRow = MaterialsIsCopy.Add();
				FillPropertyValues(NewRow, String);
				If ValueIsFilled(String.CommunicationKeySet) Then
					NewRow.BillOfMaterials = String.BillOfMaterialsSet;
				EndIf;
				
				NewRow.Id = Id;
			
			EndIf;
			
			Id = Id + 1;
		
		EndDo;
		
		PriorityAnalogues = AlternativeMaterials.GetReplacementTableForGeneratingStages(MaterialsIsCopy, SelectionOfPermissions, Reserves, True);
		
		If PriorityAnalogues <> Undefined Then
			PriorityAnalogues.Indexes.Add("Id");
			PriorityAnalogues.Indexes.Add("Ref, ThisIsASubstitute");
			PriorityAnalogues.Indexes.Add("ThisIsASubstitute");
			
			AppliedAnalogues = PriorityAnalogues.FindRows(New Structure("ThisIsASubstitute", True));
			
			For Each AnalogString In AppliedAnalogues Do
			
				NewRow = Reserves.Add();
				FillPropertyValues(NewRow, AnalogString);
			
			EndDo;
			
		EndIf;
	
	EndIf;
	
	// Distribution of residuals
	Id = 1;
	For IndexOf = 0 To UsedMaterials.Count()-1 Do
		
		String = UsedMaterials[IndexOf];
		
		String.Id = Id;
		Id = Id + 1;
		
		If PriorityAnalogues <> Undefined Then
			StringMaterial = PriorityAnalogues.Find(String.Id, "Id");
			If StringMaterial <> Undefined Then
				String.CreditedByAnalogues = String.Count - StringMaterial.Count;
				String.Count = StringMaterial.Count;
			EndIf;
		EndIf;
		
		// Isolated remainder
		If String.Count > 0
			And Balance.Count() <> 0 Then
			
			FillPropertyValues(TheStructureOfTheSearchBalance, String, "Products, Characteristic, Warehouse");
			TheStructureOfTheSearchBalance.Purpose = String.SupplyAssignment;
			
			FoundRows = Balance.FindRows(TheStructureOfTheSearchBalance);
			StringBalance = ?(FoundRows.UBound() <> -1, FoundRows[0], Undefined);
			If StringBalance <> Undefined
				And StringBalance.Count > 0 Then
				
				String.OffsettingSeparatelyInWarehouse = Min(String.Count, StringBalance.Count);
				String.Count = String.Count - String.OffsettingSeparatelyInWarehouse;
				StringBalance.Count = StringBalance.Count - String.OffsettingSeparatelyInWarehouse;
				
			EndIf;
			
		EndIf;
		
		// Non-isolated remainder
		If String.Count > 0
			And Balance.Count() <> 0
			And Not String.WithAssignment Then
			
			FillPropertyValues(TheStructureOfTheSearchBalance, String, "Products, Characteristic, Warehouse");
			TheStructureOfTheSearchBalance.Purpose = Catalogs.Assignments.EmptyRef();
			
			FoundRows = Balance.FindRows(TheStructureOfTheSearchBalance);
			StringBalance = ?(FoundRows.UBound() <> -1, FoundRows[0], Undefined);
			If StringBalance <> Undefined
				And StringBalance.Count > 0 Then
				
				String.OffsettingIsNotSeparateInWarehouse = Min(String.Count, StringBalance.Count);
				String.Count = String.Count - String.OffsettingIsNotSeparateInWarehouse;
				StringBalance.Count = StringBalance.Count - String.OffsettingIsNotSeparateInWarehouse;
				
			EndIf;
			
		EndIf;
		
		// Filling in tables for replacement with analogues
		If Parameters.ReplaceMaterialsWithAnalogs Then
			
			If String.ReplacementWithAnalogues Then
				NewRow = MaterialsReplace.Add();
				FillPropertyValues(NewRow, String);
				If ValueIsFilled(String.CommunicationKeySet) Then
					NewRow.BillOfMaterials = String.BillOfMaterialsSet;
				EndIf;
			EndIf;
			
			If String.OffsettingIsNotSeparateInWarehouse > 0 Then
				NewRow = Reserves.Add();
				FillPropertyValues(NewRow, String,, "Count");
				NewRow.Count = String.OffsettingIsNotSeparateInWarehouse;
				NewRow.Purpose = Catalogs.Assignments.EmptyRef();
			EndIf;
			
		EndIf;
		
	EndDo;
	
	// Getting analogs
	Substitutes = Undefined;
	If Parameters.ReplaceMaterialsWithAnalogs
		And MaterialsReplace.Count() > 0 Then
		
		MaterialsReplace.Sort("Queue, Stage");
		
		Filter = New Map();
		TMCommonUse.AddSelectionItemToCollection(Filter, "AlternativeMaterials.ReplacementPriority", "&ReplacementPriority");
		
		PermissionSelectionParameters = New Map();
		PermissionSelectionParameters.Insert("ReplacementPriority", Enums.RulesOfReplacingWithSubstitutes.IfThereAreNoMaterials);
		
		If DynamicStructureIsUsed Then
	
			TMCommonUse.AddSelectionItemToCollection(Filter, "AlternativeMaterials.UseItForAutocorrectInOrders", "&UseItForAutocorrectInOrders");
			PermissionSelectionParameters.Insert("UseItForAutocorrectInOrders", CommonClientServer.ValueInArray(True));
		
		EndIf;
		
		SelectionOfPermissions = New Structure();
		SelectionOfPermissions.Insert("Filter", Filter);
		SelectionOfPermissions.Insert("PermissionSelectionParameters", PermissionSelectionParameters);
		
		Substitutes = AlternativeMaterials.GetReplacementTableForGeneratingStages(MaterialsReplace, SelectionOfPermissions, Reserves, True);
		If Substitutes <> Undefined Then
			Substitutes.Indexes.Add("Ref, ThisIsASubstitute");
			UsedMaterials.Indexes.Add("Id");
		EndIf;
		
	EndIf;
	
	// Writing data to documents
	UsedMaterials.Sort("Queue, Stage");
	SearchStructureLinkAnalog = New Structure("Ref, ThisIsASubstitute");
	
	ReadyForProcessing_ = New Array;
	StructureOfActions = New Structure("RecalculateNumberOfPackages");
	CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
	
	ExcludeColumns = "RowCode, RowID, KeyProducts";
	
	DocumentObject = Undefined;
	DocumentChanged = False;
	
	For IndexOf = 0 To UsedMaterials.Count()-1 Do
		
		String = UsedMaterials[IndexOf];
		
		If DocumentObject = Undefined
			Or String.Stage <> DocumentObject.Ref Then
			
			DocumentObject = String.Stage.GetObject();
			DocumentChanged = False;
			
		EndIf;
		
		InitialString = DocumentObject.SupplyWithMaterialsAndWorks.Find(String.RowCode, "RowCode");
		If InitialString <> Undefined Then
			
			// Offset of Separate Balances
			If String.OffsettingSeparatelyInWarehouse <> 0 Then
				
				If InitialString.Count = String.OffsettingSeparatelyInWarehouse Then
					FillLine = InitialString;
				Else
					
					FillLine = DocumentObject.SupplyWithMaterialsAndWorks.Insert(
						DocumentObject.SupplyWithMaterialsAndWorks.IndexOf(InitialString));
					FillPropertyValues(FillLine, InitialString,, ExcludeColumns);
					FillLine.Count = String.OffsettingSeparatelyInWarehouse;
					ReadyForProcessing_.Add(FillLine);
					
					InitialString.Count = InitialString.Count - String.OffsettingSeparatelyInWarehouse;
					ReadyForProcessing_.Add(InitialString);
					
				EndIf;
				
				FillLine.SupplyOption = Enums.SupplyOptions.FromWarehouse;
				FillLine.WithAssignment = True;
				FillLine.Purpose = FillLine.SupplyAssignment;
				
				DocumentChanged = True;
				
			EndIf;
			
			// Offset of a separate admission schedule
			If String.OffsettingSeparatelyInSchedule <> 0 Then
				
				If InitialString.Count = String.OffsettingSeparatelyInSchedule Then
					FillLine = InitialString;
				Else
					
					FillLine = DocumentObject.SupplyWithMaterialsAndWorks.Insert(
						DocumentObject.SupplyWithMaterialsAndWorks.IndexOf(InitialString));
					FillPropertyValues(FillLine, InitialString,, ExcludeColumns);
					FillLine.Count = String.OffsettingSeparatelyInSchedule;
					ReadyForProcessing_.Add(FillLine);
					
					InitialString.Count = InitialString.Count - String.OffsettingSeparatelyInSchedule;
					ReadyForProcessing_.Add(InitialString);
					
				EndIf;
				
				FillLine.SupplyOption = Enums.SupplyOptions.ToSupply; // there is no "reserve in schedule" action
				FillLine.WithAssignment = True;
				FillLine.Purpose = FillLine.SupplyAssignment;
				
				DocumentChanged = True;
				
			EndIf;
			
			// Offset of non-isolated balances
			If String.OffsettingIsNotSeparateInWarehouse <> 0 Then
				
				If InitialString.Count = String.OffsettingIsNotSeparateInWarehouse Then
					FillLine = InitialString;
				Else
					
					FillLine = DocumentObject.SupplyWithMaterialsAndWorks.Insert(
						DocumentObject.SupplyWithMaterialsAndWorks.IndexOf(InitialString));
					FillPropertyValues(FillLine, InitialString,, ExcludeColumns);
					FillLine.Count = String.OffsettingIsNotSeparateInWarehouse;
					ReadyForProcessing_.Add(FillLine);
					
					InitialString.Count = InitialString.Count - String.OffsettingIsNotSeparateInWarehouse;
					ReadyForProcessing_.Add(InitialString);
					
				EndIf;
				
				FillLine.SupplyOption = Enums.SupplyOptions.FromWarehouse;
				FillLine.WithAssignment = False;
				FillLine.Purpose = Catalogs.Assignments.EmptyRef();
				
				DocumentChanged = True;
				
			EndIf;
			
		EndIf;
		
		If IndexOf = UsedMaterials.Count()-1
			Or UsedMaterials[IndexOf+1].Stage <> DocumentObject.Ref Then
			
			// Offsetting priority analogues
			
			If PriorityAnalogues <> Undefined Then
				SearchStructureLinkAnalog.Ref = DocumentObject.Ref;
				SearchStructureLinkAnalog.ThisIsASubstitute = True;
				DocumentAnalogues = PriorityAnalogues.FindRows(SearchStructureLinkAnalog);
				
				// Adding priority analogues
				For IndexAnalog = 0 To DocumentAnalogues.Count()-1 Do
					StringAnalog = DocumentAnalogues[IndexAnalog];
					
					InitialString = Undefined;
					
					If StringAnalog.ReplacedQuantityLineByLine.Count() <> 0 Then
						Id= 0;
						For Each KeyAndValue In StringAnalog.ReplacedQuantityLineByLine Do
							Id = KeyAndValue.Key;
							Break;
						EndDo;
						StringMaterial = UsedMaterials.Find(Id, "Id");
						InitialString = ?(StringMaterial <> Undefined,
							DocumentObject.SupplyWithMaterialsAndWorks.Find(StringMaterial.RowCode, "RowCode"),
							Undefined);
					EndIf;
					
					If InitialString = Undefined Then
						NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Add();
					Else
						NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Insert(
							DocumentObject.SupplyWithMaterialsAndWorks.IndexOf(InitialString));
						FillPropertyValues(NewRow, InitialString, "Department, ProductCostElement, SupplyAssignment");
					EndIf;
					
					FillPropertyValues(NewRow, StringAnalog, "Products, Characteristic, Warehouse, WithAssignment, Count");
					NewRow.NumberOfPackages = NewRow.Count;
					NewRow.SupplyOption = StringAnalog.SupplyOption;
					NewRow.DateOfShipment = DocumentObject.DateOfShipment;
					If NewRow.WithAssignment Then
						NewRow.Purpose = NewRow.SupplyAssignment;
					EndIf;
					
					DocumentChanged = True;
				EndDo;
				
				// Adjusting the original lines
				SearchStructureLinkAnalog.ThisIsASubstitute = False;
				ReplacedLines = PriorityAnalogues.FindRows(SearchStructureLinkAnalog);
				For Each ReplacedString In ReplacedLines Do
					StringMaterial = UsedMaterials.Find(ReplacedString.Id, "Id");
					InitialString = ?(StringMaterial <> Undefined,
						DocumentObject.SupplyWithMaterialsAndWorks.Find(StringMaterial.RowCode, "RowCode"),
						Undefined);
					
					If InitialString <> Undefined Then
						
						MaterialQuantity = StringMaterial.Count;
						
						If MaterialQuantity = 0 Then
							If ValueIsFilled(InitialString.CommunicationKeySet) Then
								ProductDataManagement.AdjustTableSetsOfMaterialsAndWorks(
									DocumentObject.MaterialsAndWorksSets, InitialString.CommunicationKeySet, -1);
							EndIf;
							DocumentObject.SupplyWithMaterialsAndWorks.Delete(InitialString);
						Else
							// When replaced with analogs, the original string is converted to the base unit.
							InitialString.Count = MaterialQuantity;
							InitialString.NumberOfPackages = MaterialQuantity;
							InitialString.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef();
						EndIf;
						DocumentChanged = True;
					EndIf;
				EndDo;
			EndIf;
			
			// Offset of analogues
			If Substitutes <> Undefined Then
				SearchStructureLinkAnalog.Ref = DocumentObject.Ref;
				SearchStructureLinkAnalog.ThisIsASubstitute = True;
				DocumentAnalogues = Substitutes.FindRows(SearchStructureLinkAnalog);
				
				// Adding analogs
				For IndexAnalog = 0 To DocumentAnalogues.Count()-1 Do
					StringAnalog = DocumentAnalogues[IndexAnalog];
					
					InitialString = Undefined;
					
					If StringAnalog.ReplacedQuantityLineByLine.Count() <> 0 Then
						Id= 0;
						For Each KeyAndValue In StringAnalog.ReplacedQuantityLineByLine Do
							Id = KeyAndValue.Key;
							Break;
						EndDo;
						StringMaterial = UsedMaterials.Find(Id, "Id");
						InitialString = ?(StringMaterial <> Undefined,
							DocumentObject.SupplyWithMaterialsAndWorks.Find(StringMaterial.RowCode, "RowCode"),
							Undefined);
					EndIf;
					
					If InitialString = Undefined Then
						NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Add();
					Else
						NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Insert(
							DocumentObject.SupplyWithMaterialsAndWorks.IndexOf(InitialString));
						FillPropertyValues(NewRow, InitialString, "Department, ProductCostElement, SupplyAssignment");
					EndIf;
					
					FillPropertyValues(NewRow, StringAnalog, "Products, Characteristic, Warehouse, WithAssignment, Count");
					NewRow.NumberOfPackages = NewRow.Count;
					NewRow.SupplyOption = StringAnalog.SupplyOption;
					NewRow.DateOfShipment = DocumentObject.DateOfShipment;
					If NewRow.WithAssignment Then
						NewRow.Purpose = NewRow.SupplyAssignment;
					EndIf;
					
					DocumentChanged = True;
				EndDo;
				
				// Adjusting the original lines
				SearchStructureLinkAnalog.ThisIsASubstitute = False;
				ReplacedLines = Substitutes.FindRows(SearchStructureLinkAnalog);
				For Each ReplacedString In ReplacedLines Do
					StringMaterial = UsedMaterials.Find(ReplacedString.Id, "Id");
					InitialString = ?(StringMaterial <> Undefined,
						DocumentObject.SupplyWithMaterialsAndWorks.Find(StringMaterial.RowCode, "RowCode"),
						Undefined);
					
					If InitialString <> Undefined Then
						If ReplacedString.Count = 0 Then
							If ValueIsFilled(InitialString.CommunicationKeySet) Then
								ProductDataManagement.AdjustTableSetsOfMaterialsAndWorks(
									DocumentObject.MaterialsAndWorksSets, InitialString.CommunicationKeySet, -1);
							EndIf;
							DocumentObject.SupplyWithMaterialsAndWorks.Delete(InitialString);
						Else
							// When replaced with analogs, the original string is converted to the base unit.
							InitialString.Count = ReplacedString.Count;
							InitialString.NumberOfPackages = ReplacedString.Count;
							InitialString.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef();
						EndIf;
						DocumentChanged = True;
					EndIf;
				EndDo;
			EndIf;
			
			If DocumentChanged Then
				
				BatchProcessingOfTablePartServer.ProcessTSStrings(
					ReadyForProcessing_,
					StructureOfActions,
					DocumentObject.SupplyWithMaterialsAndWorks,
					CachedValues);
				ReadyForProcessing_.Clear();
		
				ProductsServer.FillInStatusesForSpecifyingSeries(
					DocumentObject,
					SeriesSpecificationParameters(DocumentObject).SupplyWithMaterialsAndWorks);
				
				OrderStructureDocumentPosting.ProductionStageBeforeWrite(
					DocumentObject, DocumentObject.AdditionalProperties, False);
		
				OrdersServer.SetKeyInRowsOfTablePart(
					DocumentObject, "SupplyWithMaterialsAndWorks", "MaximumRowCodeMaterialsAndServicesSupply");
				
				DocumentObject.DataExchange.Load = True;
				
				Try
					DocumentObject.Write(DocumentWriteMode.Write);
				Except
					Event = NStr("vi = 'Công đoạn sản xuất';
								|ru = 'Этап производства';
								|en = 'Production stage'; fa = 'مرحله تولید';
								|it = 'Fase di produzione';
								|pl = 'Etap produkcji';
								|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
						+ NStr("vi = 'Lập bản ghi kết chuyển theo gói';
								|ru = 'Пакетное формирование движений';
								|en = 'Batch register records generation'; fa = 'Batch register records generation';
								|it = 'Formazione in lotti dei movimenti';
								|pl = 'Tworzenie pakietów ruchów';
								|tr = 'Hareketlerin toplu düzenlenmesi'", Common.DefaultLanguageCode());
					WriteLogEvent(Event, EventLogLevel.Error,,,
						DetailErrorDescription(ErrorInfo()));
				EndTry;
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
EndProcedure

Function GenerateRegisteredRecordsInBatchMode(MovementData, DataVersions, MovableRegisters, OrderStructureCalculationQueue = 0)
	
	StagesOfFailure = New Array;
	
	TablesOfIndependentRegisters = New Structure;
	TableName = "";
	
	If MovableRegisters.Property("OrderStructure", TableName) Then
		TablesOfIndependentRegisters.Insert(
			TableName,
			?(MovementData.Property(TableName),
				MovementData[TableName].CopyColumns(),
				InformationRegisters.OrderStructure.CreateRecordSet().Unload()));
	EndIf;
	
	If MovableRegisters.Property("OrderStructureLaborCosts", TableName) Then
		TablesOfIndependentRegisters.Insert(
			TableName,
			?(MovementData.Property(TableName),
				MovementData[TableName].CopyColumns(),
				InformationRegisters.OrderStructureLaborCosts.CreateRecordSet().Unload()));
	EndIf;
	
	If MovableRegisters.Property("DocumentsRegistry", TableName) Then
		TablesOfIndependentRegisters.Insert(
			TableName,
			?(MovementData.Property(TableName),
				MovementData[TableName].CopyColumns(),
				InformationRegisters.DocumentsRegistry.CreateRecordSet().Unload()));
	EndIf;
	
	NameOfDefaultSearchField   = "Recorder";
	DefaultSearchStructure = New Structure(NameOfDefaultSearchField);
	
	NamesOfSearchFields = New Structure;
	NamesOfSearchFields.Insert("OrderStructure",             "Stage");
	NamesOfSearchFields.Insert("OrderStructureLaborCosts", "Stage");
	NamesOfSearchFields.Insert("DocumentsRegistry",            "Ref");
	
	SearchStructures = New Structure;
	For Each NameOfTheSearchField In NamesOfSearchFields Do
		SearchStructures.Insert(NameOfTheSearchField.Key, New Structure(NameOfTheSearchField.Value)); 
	EndDo;
	
	IndexTables = True;
	
	For Each DataVersion In DataVersions Do
		
		DocumentRef = DataVersion.Ref;
		ErrorCounter = 1;
		While True Do
			
			For Each RegisterTable In TablesOfIndependentRegisters Do
				RegisterTable.Value.Clear();
			EndDo;
		
			BeginTransaction();
			Try
				
				Block = New DataLock;
				LockItem = Block.Add("Document.ProductionStage2_2");
				LockItem.Mode = DataLockMode.Exclusive;
				LockItem.SetValue("Ref", DocumentRef);
				Block.Lock();
				
				DocumentObject = DocumentRef.GetObject();
				
				If DocumentObject.DataVersion <> DataVersion.DataVersion Then
					RollbackTransaction();
					Break;
				EndIf;
				
				DocumentObject.SetBatchGenerationMode();
				DocumentObject.AdditionalProperties.Insert("OrderStructureCalculationQueue", OrderStructureCalculationQueue);
				
				DocumentsPosting.BeforeWritingDocument(DocumentObject, DocumentWriteMode.Posting, Undefined);
				
				DefaultSearchStructure[NameOfDefaultSearchField] = DocumentRef;
				For Each TheStructureOfTheSearch In SearchStructures Do
					TheStructureOfTheSearch.Value[NamesOfSearchFields[TheStructureOfTheSearch.Key]] = DocumentRef;
				EndDo;
				
				For Each MovableRegister In MovableRegisters Do
					
					TableName = MovableRegister.Value;
					
					TableForRegisteredRecords = MovementData[TableName]; // ValueTable
					
					If IndexTables Then
						
						NameOfTheSearchField = Undefined;
						If Not NamesOfSearchFields.Property(MovableRegister.Key, NameOfTheSearchField) Then
							NameOfTheSearchField = NameOfDefaultSearchField;
						EndIf;
						
						TableForRegisteredRecords.Indexes.Add(NameOfTheSearchField);
						
					EndIf;
					
					TheStructureOfTheSearch = Undefined;
					If Not SearchStructures.Property(MovableRegister.Key, TheStructureOfTheSearch) Then
						TheStructureOfTheSearch = DefaultSearchStructure;
					EndIf;
					
					FoundRows = TableForRegisteredRecords.FindRows(TheStructureOfTheSearch);
					If FoundRows.Count() > 0 Then
					
						If TablesOfIndependentRegisters.Property(TableName) Then
							RegisterRegisteredRecords = TablesOfIndependentRegisters[TableName];
						Else
							RegisterRegisteredRecords = DocumentObject.RegisterRecords[MovableRegister.Key];
							RegisterRegisteredRecords.Write = True;
						EndIf;
						
						For Each TableRow In FoundRows Do
							FillPropertyValues(RegisterRegisteredRecords.Add(), TableRow);
						EndDo;
						
					EndIf;
					
				EndDo;
				
				If IndexTables Then
					IndexTables = False;
				EndIf;
				
				Cancel = False;
				SetPrivilegedMode(True);
				
				InformationRegisters.DocumentsRegistry.WriteData(
					TablesOfIndependentRegisters, DocumentObject.Ref, Undefined, Cancel);
				
				DocumentsPosting.RecordRegisteredRecordsWithControl(DocumentObject, Cancel, True, True);
				
				OrderStructureDocumentPosting.WriteData(
					TablesOfIndependentRegisters, DocumentObject.Ref, Undefined, False, False);
				
				SetPrivilegedMode(False);
				
				If Cancel Then
					RollbackTransaction();
					StagesOfFailure.Add(DocumentRef);
					Break;
				EndIf;
				
				CommitTransaction();
				
			Except
				
				RollbackTransaction();
				
				If ErrorCounter < 3 Then
					Event = NStr("vi = 'Công đoạn sản xuất';
								|ru = 'Этап производства';
								|en = 'Production stage'; fa = 'مرحله تولید';
								|it = 'Fase di produzione';
								|pl = 'Etap produkcji';
								|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
						+ NStr("vi = 'Tạo bản ghi kết chuyển theo gói';
								|ru = 'Пакетное формирование движений';
								|en = 'Batch register records generation'; fa = 'Batch register records generation';
								|it = 'Formazione in lotti dei movimenti';
								|pl = 'Tworzenie pakietów ruchów';
								|tr = 'Hareketlerin toplu düzenlenmesi'", Common.DefaultLanguageCode());
					MessageText = StrTemplate(NStr("vi = 'Thử ghi lại thất bại (%1): %2';
													|ru = 'Неудачная попытка записи (%1): %2';
													|en = 'Unsuccessful attempt to write (%1): %2'; fa = 'Unsuccessful attempt to write (%1): %2';
													|it = 'Tentativo fallito di registrazione (%1): %2';
													|pl = 'Nieudana próba zapisu (%1): %2';
													|tr = 'Başarısız kayıt denemesi (%1): %2'"),
						ErrorCounter, DetailErrorDescription(ErrorInfo()));
					WriteLogEvent(Event, EventLogLevel.Warning,,, MessageText);
					
					ErrorCounter = ErrorCounter + 1;
					Continue;
				EndIf;
				
				Event = NStr("vi = 'Công đoạn sản xuất';
							|ru = 'Этап производства';
							|en = 'Production stage'; fa = 'مرحله تولید';
							|it = 'Fase di produzione';
							|pl = 'Etap produkcji';
							|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
					+ NStr("vi = 'Tạo bản ghi kết chuyển theo gói';
							|ru = 'Пакетное формирование движений';
							|en = 'Batch register records generation'; fa = 'Batch register records generation';
							|it = 'Formazione in lotti dei movimenti';
							|pl = 'Tworzenie pakietów ruchów';
							|tr = 'Hareketlerin toplu düzenlenmesi'", Common.DefaultLanguageCode());
				WriteLogEvent(Event, EventLogLevel.Error,,,
					DetailErrorDescription(ErrorInfo()));
				
				StagesOfFailure.Add(DocumentRef);
				
			EndTry;
			
			Break;
			
		EndDo;
		
	EndDo;
	
	Return StagesOfFailure;

EndFunction

Procedure FillInDocumentRegisterInBatchMode(ReferenceOrder, Stages, ReplaceRecords)
	
	SetPrivilegedMode(True);
	
	Query = New Query;
	FillInInitializationParameters(Query);
	Query.SetParameter("Ref", Stages);
	
	QueryTexts = RequestTextsForGeneratingRegisteredRecords(Query, Undefined, New Structure("DocumentsRegistry"));
	
	TablesForRegisteredRecords = DocumentsPosting.InitializeDocumentDataForPosting(
										Query, QueryTexts, Undefined);
	
	LineEntrySeparator = String(ReferenceOrder.UUID());
	InformationRegisters.DocumentsRegistry.WriteSeparatorData(TablesForRegisteredRecords, LineEntrySeparator, ReplaceRecords);
	
EndProcedure

