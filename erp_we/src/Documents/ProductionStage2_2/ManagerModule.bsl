// Fills in the request parameters that depend on the specific document instance.
//
// Parameters:
//  Query - Query - the query that initializes the document data.
//  QueryTexts - See DocumentsPosting.ThereIsQueryTable.QueryTexts
//  DocumentObject - DocumentObject.ProductionStage2_2, Undefined -
//
Procedure FillInInitializationParametersUsingLink(Query, QueryTexts, DocumentObject)
	
	TempTablesManager = Query.TempTablesManager;
	
	TemporaryQueryTexts = New ValueList;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataHeader", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataHeader(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	If TemporaryQueryTexts.Count() > 0 Then
		
		Query.Text = TemporaryQueryTexts[0].Value;
		
		SetPrivilegedMode(True);
		Query.Execute();
		SetPrivilegedMode(False);
		
	EndIf;
	
	Result = Query.TempTablesManager.Tables["DocumentDataHeader"].GetData();
	Attributes = Result.Select();
	Attributes.Next();
	
	For Each Column In Result.Columns Do
		
		FieldName = Column.Name;
		
		Query.SetParameter(FieldName, Attributes[FieldName]);
		
		If FieldName = "Date" Then
			Query.SetParameter("Period", Attributes[FieldName]);
		EndIf;
		
	EndDo;
	
	InvoiceIsOrder = PurchasesServer.OrderForAcceptanceOfGoodsConsignmentNote(Attributes.GoodsReceiptOption);
	
	Query.SetParameter("InvoiceIsOrder", InvoiceIsOrder);
	
	TemporaryQueryTexts.Clear();
	
	ArrayOfRequestTexts = New Array;
	
	QueryText1 =
	"SELECT
	|	DocumentTable.Date AS Period,
	|	DocumentTable.Organization AS Organization
	|FROM
	|	DocumentDataHeader AS DocumentTable";
	
	ArrayOfRequestTexts.Add(QueryText1);
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed) Then
		
		If DocumentObject = Undefined
		 Or DocumentObject.ManufacturedProducts.Count() > 0 Then
			
			If Not DocumentsPosting.ThereIsQueryTable(
						"DocumentDataTableOutputFinishedProducts", TemporaryQueryTexts, TempTablesManager) Then
				QueryTextDocumentDataTableOutputFinishedProducts(Query, TemporaryQueryTexts, DocumentObject);
			EndIf;
			
			QueryText1 =
			"SELECT
			|	GoodsTable.ProductionDate AS Period,
			|	CASE
			|		WHEN &InternalSubcontracting
			|			THEN &MaterialProviderCompany
			|		ELSE &Organization
			|	END AS Organization
			|FROM
			|	DocumentDataTableOutputFinishedProducts AS GoodsTable
			|WHERE
			|	&Status IN (
			|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			|	AND GoodsTable.Manufactured";
			
			ArrayOfRequestTexts.Add(QueryText1);
			
		EndIf;
		
		If DocumentObject = Undefined
		 Or DocumentObject.SideAndIntermediateRelease.Count() > 0 Then
			
			If Not DocumentsPosting.ThereIsQueryTable(
						"DocumentDataTableOfByFinishedProducts", TemporaryQueryTexts, TempTablesManager) Then
				QueryTextDocumentDataTableOfByFinishedProducts(Query, TemporaryQueryTexts, DocumentObject);
			EndIf;
			
			QueryText1 =
			"SELECT
			|	GoodsTable.ProductionDate AS Period,
			|	CASE
			|		WHEN NOT GoodsTable.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
			|			THEN GoodsTable.ProductOwner
			|		WHEN &InternalSubcontracting
			|			THEN &MaterialProviderCompany
			|		ELSE &Organization
			|	END AS Organization
			|FROM
			|	DocumentDataTableOfByFinishedProducts AS GoodsTable
			|WHERE
			|	&Status IN (
			|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			|	AND GoodsTable.Manufactured";
			
			ArrayOfRequestTexts.Add(QueryText1);
			
		EndIf;
		
		If DocumentObject = Undefined
		 Or DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0 Then
			
			If Not DocumentsPosting.ThereIsQueryTable(
						"DocumentDataTableProvisionOfMaterialsAndWorks",
						TemporaryQueryTexts,
						TempTablesManager) Then
				
				QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(
					Query, TemporaryQueryTexts, DocumentObject);
				
			EndIf;
			
			QueryText1 =
			"SELECT
			|	GoodsTable.DateOfShipment AS Period,
			|	&Organization AS Organization
			|FROM
			|	DocumentDataTableProvisionOfMaterialsAndWorks AS GoodsTable
			|WHERE
			|	&Status IN
			|		(VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			|	AND GoodsTable.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
			|	AND NOT GoodsTable.Canceled";
			
			ArrayOfRequestTexts.Add(QueryText1);
			
		EndIf;
		
		If DocumentObject = Undefined
		 Or DocumentObject.MaterialsAndWorksConsumption.Count() > 0 Then
			
			If Not DocumentsPosting.ThereIsQueryTable(
						"DocumentDataTableOfExpensesOfMaterialsAndWorks",
						TemporaryQueryTexts,
						TempTablesManager) Then
				
				QueryTextDocumentDataTableOfExpensesOfMaterialsAndWorks(
					Query, TemporaryQueryTexts, DocumentObject);
				
			EndIf;
			
			QueryText1 =
			"SELECT
			|	GoodsTable.DateOfMaterialWorkConsumption AS Period,
			|	&Organization AS Organization
			|FROM
			|	DocumentDataTableOfExpensesOfMaterialsAndWorks AS GoodsTable
			|	LEFT JOIN Catalog.Products AS CatalogProducts
			|		ON GoodsTable.Products = CatalogProducts.Ref
			|WHERE
			|	&Status IN
			|		(VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			// From the table of consumable work materials, we select only untraceable works.
			// Materials and traceable works are selected from the table Types of inventory materials.
			|	AND CatalogProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
			|	AND NOT (CatalogProducts.TracedGoods
			|			AND &UseTraceableImportedGoodsAccounting)
			|";
			
			ArrayOfRequestTexts.Add(QueryText1);
			
		EndIf;
		
		If DocumentObject = Undefined
		 Or DocumentObject.InventoryOwnerAttributesMaterials.Count() > 0 Then
			
			If Not DocumentsPosting.ThereIsQueryTable(
						"DocumentDataTableTypesOfStocksMaterials",
						TemporaryQueryTexts,
						TempTablesManager) Then
				QueryTextDocumentDataTableTypesOfStocksMaterials(Query, TemporaryQueryTexts, DocumentObject);
			EndIf;
			
			QueryText1 =
			"SELECT
			|	GoodsTable.DateOfTransaction AS Period,
			|	GoodsTable.TypeOfInventoryOwnerAttributeCompany AS Organization
			|FROM
			|	DocumentDataTableTypesOfStocksMaterials AS GoodsTable
			|WHERE
			|	&Status IN
			|		(VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))";
			
			ArrayOfRequestTexts.Add(QueryText1);
			
		EndIf;
		
	EndIf;
	
	QueryText1 =
	"SELECT DISTINCT
	|	BEGINOFPERIOD(PeriodsOfRegisteredRecords.Period, MONTH) AS Period,
	|	PeriodsOfRegisteredRecords.Organization AS Organization
	|FROM
	|	PeriodsTable AS PeriodsOfRegisteredRecords
	|";
	
	QueryText1 = StrReplace(
					QueryText1,
					"PeriodsTable",
					StrTemplate(
						"(%1)", 
						StrConcat(ArrayOfRequestTexts, TMCommonUse.QuerySeparatorInJoin())));
	
	TemporaryQueryTexts.Add(QueryText1);
	
	Query.Text = StrConcat(
					TemporaryQueryTexts.UnloadValues(),
					Common.QueryBatchSeparator());
	
	PeriodsTable = Query.Execute().Unload();
	ArrayOfPeriods = PeriodsTable.UnloadColumn("Period");
	
	CostCalculationAppliedAlgorithms.FillInInitializationParametersByPeriod(
		Query,
		Query.Parameters,
		, // TimeIntervals
		, // PeriodTableName
		PeriodsTable);
	
	// Filling in the VAT activities of the giver company during internal processing
	CompanyTable = New ValueTable;
	CompanyTable.Columns.Add("Organization", New TypeDescription("CatalogRef.Companies"));
	CompanyTable.Columns.Add("Period", New TypeDescription("Date"));
	
	If Query.Parameters.InternalSubcontracting
	 And ValueIsFilled(Query.Parameters.MaterialProviderCompany) Then
		
		For Each DateOfTransaction In ArrayOfPeriods Do
			
			NwRw = CompanyTable.Add();
			NwRw.Organization = Query.Parameters.MaterialProviderCompany;
			NwRw.Period = BegOfMonth(DateOfTransaction);
			
		EndDo;
		
		CompanyTable.GroupBy("Organization, Period", "");
		
	EndIf;
	
	CostCalculationAppliedAlgorithms.ToFormTTTypesOfVATActivities(Query, CompanyTable);
	
	DocumentsPosting.DeleteCreationOfTemporaryTablesFromQueryText(QueryTexts, TempTablesManager);
	
EndProcedure

Procedure FillInCostCalculationParameters(Query, AddlParameters)
	
	AdditionalProperties = Undefined;
	
	If AddlParameters = Undefined Then
		AdditionalProperties = New Structure;
	ElsIf AddlParameters.Property("AdditionalProperties", AdditionalProperties) Then
		AdditionalProperties = ?(AdditionalProperties <> Undefined,
									AddlParameters.AdditionalProperties,
									New Structure);
	Else
		AdditionalProperties = AddlParameters;
	EndIf;
	
	// If the filling period is not set, then all movements of the document are re-formed.
	// Overwriting of all movements is required for update handlers and motion recovery procedures.
	FillingPeriod = Undefined;
	
	// If the document is held interactively or the filling period is transferred, then we save the movements
	// until the filling period, and the movements from the beginning of the filling period are re-formed.
	If AdditionalProperties.Property("PeriodOfRewritingRegisteredRecords")
	 And Not CalculationOfCostCached.ValuesOfTechnologicalParameters().DoNotSaveCalculatedRegisteredRecords Then
		
		FillingPeriod = AdditionalProperties.PeriodOfRewritingRegisteredRecords;
		
		EndOfPeriodOfStoredRegisteredRecords = BegOfMonth(FillingPeriod) - 1;
		
		AccumulationRegisters.InventoryCost.InitializeSavingDocumentRegisteredRecordsForPeriod(
			AdditionalProperties, // additional document properties
			, // the beginning of the period of saved movements
			EndOfPeriodOfStoredRegisteredRecords);
			
	EndIf;
	
	Query.SetParameter("PeriodOfRewritingRegisteredRecords", FillingPeriod);
	
EndProcedure

Function RedefiningParameterCalculation(MainTable)
	
	Result = New Structure;
	
	Result.Insert("EmptyDestinationLink", "VALUE(Catalog.Assignments.EmptyRef)");
	
	ParameterText1 = StrReplace("%MainTable%.Department.UseOperationManagement",
									"%MainTable%",
									MainTable);
	Result.Insert("UseOperationManagement", ParameterText1);
	
	Return Result;
	
EndFunction

Function RedefineTemporaryTablesInQueryText(QueryText, TemporaryTableNames, QueryTexts)
	
	For Each TableName In TemporaryTableNames Do
		
		If TableName = "DocumentDataHeader" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataHeader(Undefined, QueryTexts, Undefined);
			
		ElsIf TableName = "DocumentDataTableOutputFinishedProducts" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableOutputFinishedProducts(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableOfByFinishedProducts" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableOfByFinishedProducts(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableProvisionOfMaterialsAndWorks" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableOfExpensesOfMaterialsAndWorks" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableOfExpensesOfMaterialsAndWorks(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableSavingMaterials" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableSavingMaterials(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableLaborCosts" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableLaborCosts(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableEmploymentOfTypesOfWorkCenters" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableEmploymentOfTypesOfWorkCenters(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableOutputFinishedProductsOfBatch" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableOutputFinishedProductsOfBatch(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableByFinishedProductsOfBatch" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableByFinishedProductsOfBatch(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableSavingBatchMaterials" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableSavingBatchMaterials(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableTypesOfProductStocks" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableTypesOfProductStocks(
											Undefined,
											QueryTexts,
											Undefined);
			
		ElsIf TableName = "DocumentDataTableTypesOfStocksMaterials" Then
			
			TemporaryTableQueryText = QueryTextDocumentDataTableTypesOfStocksMaterials(
											Undefined,
											QueryTexts,
											Undefined);
			
		EndIf;
		
		FirstChar    = StrFind(TemporaryTableQueryText, "INTO");
		LastChar = StrFind(TemporaryTableQueryText, TableName, SearchDirection.FromBegin, FirstChar)
						  + StrLen(TableName);
		
		SearchSubstitution = Mid(TemporaryTableQueryText, FirstChar, LastChar - FirstChar);
		SubstitutionOfTemporaryTable = StrReplace(TemporaryTableQueryText, SearchSubstitution, "");
		
		FirstChar = StrFind(SubstitutionOfTemporaryTable, "INDEX BY");
		If FirstChar > 0 Then
			SubstitutionOfTemporaryTable = Mid(SubstitutionOfTemporaryTable, 1, FirstChar - 1);
		EndIf;
		
		QueryText = StrReplace(QueryText, TableName, StrTemplate("(%1)", SubstitutionOfTemporaryTable));
		
	EndDo;
	
EndFunction

Procedure InitializeProductAnalysisKeys(Query, QueryTexts, DocumentObject)

	If Query = Undefined Or Query.Parameters.Property("ProductAnalysisKeysInitialized") Then
		Return;
	EndIf;
	
	CurrentStatus = Undefined;
	If Not Query.Parameters.Property("Status", CurrentStatus)
	 Or (CurrentStatus <> Enums.StatusesOfProductionStages2_2.Initiated
			And CurrentStatus <> Enums.StatusesOfProductionStages2_2.Completed) Then
		Return;
	EndIf;
	
	TemporaryQueryTexts = New ValueList;
	
	TempTablesManager = Query.TempTablesManager;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableProvisionOfMaterialsAndWorks",
				TemporaryQueryTexts,
				TempTablesManager) Then
		
		QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(
			Query,
			TemporaryQueryTexts,
			DocumentObject);
		
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOutputFinishedProducts", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOutputFinishedProducts(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfByFinishedProducts", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfByFinishedProducts(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfExpensesOfMaterialsAndWorks", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfExpensesOfMaterialsAndWorks(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;

	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableTypesOfStocksMaterials", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableTypesOfStocksMaterials(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableSavingMaterials", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableSavingMaterials(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	
	QueryText =
	"SELECT
	|	GoodsTable.StorageLocation		AS StorageLocation,
	|	GoodsTable.Products		AS Products,
	|	GoodsTable.Characteristic	AS Characteristic,
	|	GoodsTable.ProductCostElement	AS ProductCostElement,
	|	GoodsTable.Purpose		AS Purpose,
	|	GoodsTable.Series				AS Series
	|FROM
	|	(
	// Security by sender without destination
	|	SELECT
	|		GoodsTable.Warehouse                           AS StorageLocation,
	|		GoodsTable.Products                    AS Products,
	|		GoodsTable.Characteristic                  AS Characteristic,
	|		&EmptyArticle                                 AS ProductCostElement,
	|		&EmptyAssignment                             AS Purpose,
	|		GoodsTable.BatchSenderOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts     AS ItemsType
	|	FROM
	|		DocumentDataTableProvisionOfMaterialsAndWorks AS GoodsTable
	|	
	|	UNION ALL
	|	
	// Security for the recipient without appointment
	|	SELECT
	|		GoodsTable.Department	                 AS StorageLocation,
	|		GoodsTable.Products                   AS Products,
	|		GoodsTable.Characteristic                 AS Characteristic,
	|		&EmptyArticle                                AS ProductCostElement,
	|		&EmptyAssignment                            AS Purpose,
	|		GoodsTable.BatchRecipientOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts    AS ItemsType
	|	FROM
	|		DocumentDataTableProvisionOfMaterialsAndWorks AS GoodsTable
	|	
	|	UNION ALL
	|	
	// Provision for WIP (plan for materials in WIP)
	|	SELECT
	|		GoodsTable.Department                  AS StorageLocation,
	|		GoodsTable.Products                   AS Products,
	|		GoodsTable.Characteristic                 AS Characteristic,
	|		GoodsTable.ProductCostElement	             AS ProductCostElement,
	|		&Purpose                                  AS Purpose,
	|		GoodsTable.BatchRecipientOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts    AS ItemsType
	|	FROM
	|		DocumentDataTableProvisionOfMaterialsAndWorks AS GoodsTable
	|	
	|	UNION ALL
	|	
	// Consumption without appointment
	|	SELECT
	|		GoodsTable.Department		AS StorageLocation,
	|		GoodsTable.Products		AS Products,
	|		GoodsTable.Characteristic	AS Characteristic,
	|		GoodsTable.ProductCostElement	AS ProductCostElement,
	|		&EmptyAssignment				AS Purpose,
	|		CASE
	|			WHEN GoodsTable.BatchesIndicationStatus = 14
	|				THEN GoodsTable.Series
	|			ELSE &EmptyBatch_
	|		END							AS Series,
	|		GoodsTable.ProductsTypeOfProducts AS ItemsType
	|	FROM
	|		DocumentDataTableOfExpensesOfMaterialsAndWorks AS GoodsTable
	|	
	|	UNION ALL
	|	
	// Consumption of commission goods
	|	SELECT
	|		InventoryKinds.TypeOfInventoryOwnerAttributeOwnerOfItem	AS StorageLocation,
	|		Dimension.Products					AS Products,
	|		Dimension.Characteristic				AS Characteristic,
	|		&EmptyArticle							AS ProductCostElement,
	|		&EmptyAssignment						AS Purpose,
	|		&EmptyBatch_							AS Series,
	|		Dimension.Products.ItemsType  AS ItemsType
	|	FROM
	|		DocumentDataTableTypesOfStocksMaterials AS InventoryKinds
	|			INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|			ON InventoryKinds.ItemsLocationAttributes = Dimension.Ref
	|	WHERE
	|		InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|	
	|	UNION ALL
	|
	// Saving without appointment
	|	SELECT
	|		GoodsTable.Recipient		AS StorageLocation,
	|		GoodsTable.Products		AS Products,
	|		GoodsTable.Characteristic	AS Characteristic,
	|		&EmptyArticle					AS ProductCostElement,
	|		&EmptyAssignment				AS Purpose,
	|		CASE
	|			WHEN GoodsTable.BatchesIndicationStatusRecipient = 14
	|				THEN GoodsTable.Series
	|			ELSE &EmptyBatch_
	|		END							AS Series,
	|		GoodsTable.ProductsTypeOfProducts AS ItemsType
	|	FROM
	|		DocumentDataTableSavingMaterials AS GoodsTable
	|	WHERE
	|		NOT GoodsTable.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|	
	|	UNION ALL
	|
	// Output items without destination by sender
	|	SELECT
	|		GoodsTable.Department                   AS StorageLocation,
	|		GoodsTable.Products                    AS Products,
	|		GoodsTable.Characteristic                  AS Characteristic,
	|		&EmptyArticle                                 AS ProductCostElement,
	|		&EmptyAssignment                             AS Purpose,
	|		GoodsTable.BatchSenderOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts     AS ItemsType
	|	FROM
	|		DocumentDataTableOutputFinishedProducts AS GoodsTable
	|	
	|	UNION ALL
	|
	// Output products for internal processing by sender
	|	SELECT
	|		GoodsTable.Department               AS StorageLocation,
	|		Dimension.Products                    AS Products,
	|		Dimension.Characteristic                  AS Characteristic,
	|		Dimension.ProductCostElement               AS ProductCostElement,
	|		Dimension.Purpose                      AS Purpose,
	|		Dimension.Series                           AS Series,
	|		GoodsTable.ProductsTypeOfProducts AS ItemsType
	|	FROM
	|		DocumentDataTableOutputFinishedProducts AS GoodsTable
	|		
	|		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON Dimension.Ref = GoodsTable.ItemsLocationAttributes
	|	WHERE
	|		GoodsTable.Manufactured
	|		AND NOT GoodsTable.Canceled
	|	
	|	UNION ALL
	|
	// Output items without destination by recipient
	|	SELECT
	|		GoodsTable.Recipient                     AS StorageLocation,
	|		GoodsTable.Products                   AS Products,
	|		GoodsTable.Characteristic                 AS Characteristic,
	|		&EmptyArticle                                AS ProductCostElement,
	|		&EmptyAssignment                            AS Purpose,
	|		GoodsTable.BatchRecipientOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts    AS ItemsType
	|	FROM
	|		DocumentDataTableOutputFinishedProducts AS GoodsTable
	|	WHERE
	|		NOT GoodsTable.Recipient = GoodsTable.Department
	|		AND NOT GoodsTable.ToExpenseAs
	|	
	|	UNION ALL
	|
	// By-products without destination by sender
	|	SELECT
	|		GoodsTable.Department                   AS StorageLocation,
	|		GoodsTable.Products                    AS Products,
	|		GoodsTable.Characteristic                  AS Characteristic,
	|		&EmptyArticle                                 AS ProductCostElement,
	|		&EmptyAssignment                             AS Purpose,
	|		GoodsTable.BatchSenderOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts     AS ItemsType
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS GoodsTable
	|	
	|	UNION ALL
	|	
	// By-products without destination by recipient
	|	SELECT
	|		GoodsTable.Recipient                     AS StorageLocation,
	|		GoodsTable.Products                   AS Products,
	|		GoodsTable.Characteristic                 AS Characteristic,
	|		&EmptyArticle                                AS ProductCostElement,
	|		&EmptyAssignment                            AS Purpose,
	|		GoodsTable.BatchRecipientOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts    AS ItemsType
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS GoodsTable
	|	WHERE
	|		NOT GoodsTable.Recipient = GoodsTable.Department
	|		AND NOT GoodsTable.ToExpenseAs
	|	
	|	UNION ALL
	|	
	// By-products for Unfinished production with destination by sender
	|	SELECT
	|		GoodsTable.Department                   AS StorageLocation,
	|		GoodsTable.Products                    AS Products,
	|		GoodsTable.Characteristic                  AS Characteristic,
	|		GoodsTable.ProductCostElement               AS ProductCostElement,
	|		&Purpose                                   AS Purpose,
	|		GoodsTable.BatchSenderOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts     AS ItemsType
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS GoodsTable
	|	
	|	UNION ALL
	|	
	// By-products for Unfinished production without destination by sender
	|	SELECT
	|		GoodsTable.Department                   AS StorageLocation,
	|		GoodsTable.Products                    AS Products,
	|		GoodsTable.Characteristic                  AS Characteristic,
	|		GoodsTable.ProductCostElement               AS ProductCostElement,
	|		&EmptyAssignment                             AS Purpose,
	|		GoodsTable.BatchSenderOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts     AS ItemsType
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS GoodsTable
	|	
	|	UNION ALL
	|	
	// By-products for Unfinished production with destination by recipient
	|	SELECT
	|		GoodsTable.Department                  AS StorageLocation,
	|		GoodsTable.Products                   AS Products,
	|		GoodsTable.Characteristic                 AS Characteristic,
	|		GoodsTable.ProductCostElement              AS ProductCostElement,
	|		&Purpose                                  AS Purpose,
	|		GoodsTable.BatchRecipientOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts    AS ItemsType
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS GoodsTable
	|	
	|	UNION ALL
	|	
	// By-products for Unfinished production without assignment to the recipient
	|	SELECT
	|		GoodsTable.Department                  AS StorageLocation,
	|		GoodsTable.Products                   AS Products,
	|		GoodsTable.Characteristic                 AS Characteristic,
	|		GoodsTable.ProductCostElement	             AS ProductCostElement,
	|		&EmptyAssignment                            AS Purpose,
	|		GoodsTable.BatchRecipientOverride AS Series,
	|		GoodsTable.ProductsTypeOfProducts    AS ItemsType
	|	FROM
	|		DocumentDataTableOfByFinishedProducts AS GoodsTable
	|	) AS GoodsTable
	|WHERE
	|	NOT TRUE IN
	|			(SELECT TOP 1
	|				TRUE
	|			FROM
	|				InformationRegister.ItemsLocationAttributes AS Dimension
	|			WHERE
	|				Dimension.Products        = GoodsTable.Products
	|				AND Dimension.Characteristic    = GoodsTable.Characteristic
	|				AND Dimension.Series             = GoodsTable.Series
	|				AND Dimension.StorageLocation     = GoodsTable.StorageLocation
	|				AND Dimension.Purpose        = GoodsTable.Purpose
	|				AND Dimension.ProductCostElement = GoodsTable.ProductCostElement)
	|
	|	AND (NOT GoodsTable.StorageLocation IN (&EmptyStorageLocations)
	|		OR GoodsTable.ItemsType = VALUE(Enum.ItemsTypes.OperationService))
	|	AND NOT (GoodsTable.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|			AND GoodsTable.Purpose <> &EmptyAssignment
	|			AND NOT VALUETYPE(GoodsTable.StorageLocation) = TYPE(Catalog.BusinessStructure)
	|		)
	|
	|GROUP BY
	|	GoodsTable.StorageLocation,
	|	GoodsTable.Products,
	|	GoodsTable.Characteristic,
	|	GoodsTable.ProductCostElement,
	|	GoodsTable.Purpose,
	|	GoodsTable.Series";
	
	TemporaryQueryTexts.Add(QueryText);
	
	Query.Text = StrConcat(
					TemporaryQueryTexts.UnloadValues(),
					Common.QueryBatchSeparator());
	
	EmptyStorageLocations = New Array;
	EmptyStorageLocations.Add(Undefined);
	EmptyStorageLocations.Add(Catalogs.Warehouses.EmptyRef());
	EmptyStorageLocations.Add(Catalogs.BusinessStructure.EmptyRef());
	
	Query.SetParameter("Ref",                 Query.Parameters.Ref);
	Query.SetParameter("Purpose",             Query.Parameters.Purpose);
	Query.SetParameter("EmptyBatch_",            Catalogs.ItemsBatches.EmptyRef());
	Query.SetParameter("EmptyArticle",           Catalogs.ProductCostElements.EmptyRef());
	Query.SetParameter("EmptyAssignment",       Catalogs.Assignments.EmptyRef());
	Query.SetParameter("EmptyStorageLocations",    EmptyStorageLocations);
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		InformationRegisters.ItemsLocationAttributes.CreateAnalyticsKey(Selection)
	EndDo;
	
	DocumentsPosting.DeleteCreationOfTemporaryTablesFromQueryText(QueryTexts, TempTablesManager);
	
	Query.SetParameter("ProductAnalysisKeysInitialized", True);
	
EndProcedure

Procedure SetQueryParameterTableCurrencyConversionFactors(Query, QueryTexts, DocumentObject)
	
	If Query = Undefined Then
		Return;
	EndIf;
	
	TemporaryQueryTexts = New ValueList;
	
	TempTablesManager = Query.TempTablesManager;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOutputFinishedProducts", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOutputFinishedProducts(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfByFinishedProducts", TemporaryQueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfByFinishedProducts(Query, TemporaryQueryTexts, DocumentObject);
	EndIf;
	
	QueryText =
		"SELECT DISTINCT
		|	ProductionPeriods.Period AS Period
		|INTO TTPeriods
		|FROM
		|	(SELECT
		|		BEGINOFPERIOD(Products_1.ProductionDate, DAY) AS Period
		|	FROM
		|		DocumentDataTableOutputFinishedProducts AS Products_1
		|	WHERE
		|		Products_1.Manufactured
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		BEGINOFPERIOD(ProductionStage2_2ByProducts.ProductionDate, DAY)
		|	FROM
		|		DocumentDataTableOfByFinishedProducts AS ProductionStage2_2ByProducts
		|	WHERE
		|		NOT ProductionStage2_2ByProducts.Canceled) AS ProductionPeriods
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ISNULL(ExchangeRates.Currency, VALUE(Catalog.Currencies.EmptyRef)) AS Currency,
		|	ISNULL(ExchangeRates.BaseCurrency, VALUE(Catalog.Currencies.EmptyRef)) AS BaseCurrency,
		|	TTPeriods.Period AS Period,
		|	MAX(ISNULL(ExchangeRates.Period, DATETIME(1, 1, 1))) AS DateOfLastCourse
		|INTO TTDatesOfLastExchangeRates
		|FROM
		|	TTPeriods AS TTPeriods
		|		LEFT JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
		|		ON (ExchangeRates.Period <= TTPeriods.Period)
		|			AND (ExchangeRates.Currency = &CurrencyOfComplianceAccounting
		|				OR ExchangeRates.Currency = &CurrencyOfManAccounting
		|				OR ExchangeRates.Currency = &DocumentCurrency)
		|			AND (ExchangeRates.BaseCurrency = &CurrencyOfComplianceAccounting)
		|
		|GROUP BY
		|	TTPeriods.Period,
		|	ISNULL(ExchangeRates.Currency, VALUE(Catalog.Currencies.EmptyRef)),
		|	ISNULL(ExchangeRates.BaseCurrency, VALUE(Catalog.Currencies.EmptyRef))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	MAX(CASE
		|			WHEN NOT ExchangeRates.Currency IS NULL
		|					AND ExchangeRates.Currency = &CurrencyOfComplianceAccounting
		|				THEN ExchangeRates.CourseNumerator
		|			ELSE 0
		|		END) AS LocalAccountingCourse,
		|	MAX(CASE
		|			WHEN NOT ExchangeRates.Currency IS NULL
		|					AND ExchangeRates.Currency = &CurrencyOfComplianceAccounting
		|				THEN ExchangeRates.CourseDenominator
		|			ELSE 0
		|		END) AS MultiplicityOfLocalAccounting,
		|	TTDatesOfLastExchangeRates.Period AS Period,
		|	MAX(CASE
		|			WHEN NOT ExchangeRates.Currency IS NULL
		|					AND ExchangeRates.Currency = &CurrencyOfManAccounting
		|				THEN ExchangeRates.CourseNumerator
		|			ELSE 0
		|		END) AS ManAccountingCourse,
		|	MAX(CASE
		|			WHEN NOT ExchangeRates.Currency IS NULL
		|					AND ExchangeRates.Currency = &CurrencyOfManAccounting
		|				THEN ExchangeRates.CourseDenominator
		|			ELSE 0
		|		END) AS MultiplicityOfManAccounting,
		|	MAX(CASE
		|			WHEN NOT ExchangeRates.Currency IS NULL
		|					AND ExchangeRates.Currency = &DocumentCurrency
		|				THEN ExchangeRates.CourseNumerator
		|			ELSE 0
		|		END) AS DocumentCourse,
		|	MAX(CASE
		|			WHEN NOT ExchangeRates.Currency IS NULL
		|					AND ExchangeRates.Currency = &DocumentCurrency
		|				THEN ExchangeRates.CourseDenominator
		|			ELSE 0
		|		END) AS DocumentMultiplicity
		|INTO TTExchangeRatesAsOfDate
		|FROM
		|	TTDatesOfLastExchangeRates AS TTDatesOfLastExchangeRates
		|		LEFT JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
		|		ON TTDatesOfLastExchangeRates.DateOfLastCourse = ExchangeRates.Period
		|			AND TTDatesOfLastExchangeRates.BaseCurrency = ExchangeRates.BaseCurrency
		|			AND TTDatesOfLastExchangeRates.Currency = ExchangeRates.Currency
		|
		|GROUP BY
		|	TTDatesOfLastExchangeRates.Period
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTExchangeRatesAsOfDate.Period,
		|	CASE
		|		WHEN TTExchangeRatesAsOfDate.DocumentMultiplicity * TTExchangeRatesAsOfDate.ManAccountingCourse = 0
		|			THEN 1
		|		ELSE TTExchangeRatesAsOfDate.DocumentCourse * TTExchangeRatesAsOfDate.MultiplicityOfManAccounting / (TTExchangeRatesAsOfDate.DocumentMultiplicity * TTExchangeRatesAsOfDate.ManAccountingCourse)
		|	END AS ConversionRateToManCurrency,
		|	CASE
		|		WHEN TTExchangeRatesAsOfDate.DocumentMultiplicity * TTExchangeRatesAsOfDate.LocalAccountingCourse = 0
		|			THEN 1
		|		ELSE TTExchangeRatesAsOfDate.DocumentCourse * TTExchangeRatesAsOfDate.MultiplicityOfLocalAccounting / (TTExchangeRatesAsOfDate.DocumentMultiplicity * TTExchangeRatesAsOfDate.LocalAccountingCourse)
		|	END AS FactorOfConversionToCurrencyOfRegul
		|FROM
		|	TTExchangeRatesAsOfDate AS TTExchangeRatesAsOfDate
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTExchangeRatesAsOfDate
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTDatesOfLastExchangeRates
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTPeriods
		|";
	
	TemporaryQueryTexts.Add(QueryText);
	
	Query.Text = StrConcat(
					TemporaryQueryTexts.UnloadValues(),
					Common.QueryBatchSeparator());
	
	Query.SetParameter("DocumentCurrency", Query.Parameters.Currency);
	Query.SetParameter("CurrencyOfManAccounting",  Constants.ManagementAccountingCurrency.Get());
	Query.SetParameter("CurrencyOfComplianceAccounting", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(
					Common.ObjectAttributeValue(Query.Parameters.Ref, "Organization")));
	
	Results = Query.ExecuteBatch();
	
	Query.SetParameter("TTCurrencyConversionFactors", Results[Results.UBound() - 3].Unload());
	
	DocumentsPosting.DeleteCreationOfTemporaryTablesFromQueryText(QueryTexts, TempTablesManager);
	
EndProcedure

Procedure SetEmptyBatchTrackingAnalyticsQueryParameter(Query)
	
	If Not Query.Parameters.Property("AnalysisOfAccountingOfBatchesOfGoods") Then
		SelectionByPartyAnalysis = New Structure("Date, AssetTaxClass", Query.Parameters.Period, Enums.AssetKinds.Goods);
		Query.SetParameter("AnalysisOfAccountingOfBatchesOfGoods",
									Catalogs.KeysForLotVendorAttributes.GetAnalyticsKey(SelectionByPartyAnalysis));
	EndIf;
	
	If Not Query.Parameters.Property("AnalysisOfWorkBatchAccounting") Then
		SelectionByPartyAnalysis = New Structure("Date, AssetTaxClass", Query.Parameters.Period, Enums.AssetKinds.OtherWorksAndServices);
		Query.SetParameter("AnalysisOfWorkBatchAccounting",
									Catalogs.KeysForLotVendorAttributes.GetAnalyticsKey(SelectionByPartyAnalysis));
	EndIf;
	
EndProcedure

