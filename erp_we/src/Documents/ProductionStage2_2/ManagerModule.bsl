// Allows you to exclude orders from processing.
// Parameters:
//  Orders - Array of AnyRef -
//  ActionCode - String -
//  UserMessages - Array of Structure
Procedure BeforePerformingActionsInOrderList(Orders, ActionCode, UserMessages) Export
	
	If Not (ActionCode = "ACTION_LOAD" Or ActionCode = "Action_Ship_PRIORITY_WithAssignment") Then
		Return;
	EndIf;
	
	Query = New Query();
	Query.SetParameter("Orders", Orders);
	Query.Text =
		"SELECT
		|	Table.Ref AS Ref
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|WHERE
		|	Table.Ref IN (&Orders)
		|		AND NOT (Table.ProductionByThirdParty AND Table.NotShipInInstallments AND Table.DateOfShipment = DATETIME(1, 1, 1))
		|;
		|SELECT
		|	Table.Ref AS Ref
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|WHERE
		|	Table.Ref IN (&Orders)
		|		AND (Table.ProductionByThirdParty AND Table.NotShipInInstallments AND Table.DateOfShipment = DATETIME(1, 1, 1))";
	QueryBatch = Query.ExecuteBatch();
	ExcludedLinks = QueryBatch[1].Unload().UnloadColumn("Ref");
	Text = NStr("vi = 'Đối với %1 không thể thực hiện lệnh, bởi vì trong đơn đặt hàng gia công, đã thiết lập dấu hiệu ""Giao hàng trong một ngày"" và chưa điền ngày giao hàng';
				|ru = 'Для %1 команда не может быть выполнена, так как в заказе переработчику установлен признак ""Отгружать одной датой"" и дата отгрузки не заполнена';
				|en = 'For %1, cannot execute the command as the ""One-day shipping"" checkbox is selected in the subcontracting purchase order, and the shipment date is not filled'; fa = 'For %1, cannot execute the command as the ""One-day shipping"" checkbox is selected in the subcontracting purchase order, and the shipment date is not filled';
				|it = 'Для %1 команда не может быть выполнена, так как в заказе переработчику установлен признак ""Отгружать одной датой"" и дата отгрузки не заполнена';
				|pl = 'For %1, cannot execute the command as the ""One-day shipping"" checkbox is selected in the subcontracting purchase order, and the shipment date is not filled';
				|tr = '%1 için, verilen fason üretici siparişinde ""Aynı tarihte sevk et"" işareti yapılandırıldığından ve sevkiyat tarihi doldurulmadığından komut gerçekleştirilemez'");
	For Each Ref In ExcludedLinks Do 
		UserMessages.Add(New Structure("Text,Ref", StrTemplate(Text, Ref), Ref));
	EndDo;
	If ExcludedLinks.Count() > 0 Then
		Orders = QueryBatch[0].Unload().UnloadColumn("Ref");
	EndIf;
	
EndProcedure

// Changes the desired dates for securing stages.
//
// Parameters:
//  Stages - ValueTable - contains columns:
//		* ProductionStage - DocumentRef.ProductionStage2_2 - the document that you want to change.
//		* Date - Date - the value that you want to set as the desired date of the security.
//
// Returns:
// 	Number - the number of documents processed.
//
Function ChangeDesiredCollateralDates(Stages) Export
	
	ProcessedItemsCount = 0;
	
	For Each StringStages In Stages Do
		
		DocumentObject = StringStages.ProductionStage.GetObject();
		
		Try
			
			DocumentObject.Lock();
			
			DateOfShipment = '00010101';
			For Each Software_1 In DocumentObject.SupplyWithMaterialsAndWorks Do
				
				If Software_1.SupplyOption <> Enums.SupplyOptions.Ship Then
					Software_1.DateOfShipment = StringStages.Date;
				EndIf;
				
				If DateOfShipment = '00010101' Then
					DateOfShipment = Software_1.DateOfShipment;
				ElsIf DateOfShipment <> Undefined
					And DateOfShipment <> Software_1.DateOfShipment Then
					DateOfShipment = Undefined;
				EndIf;
				
			EndDo;
			
			If DocumentObject.NotShipInInstallments Then
				If ValueIsFilled(DateOfShipment) Then
					DocumentObject.DateOfShipment = DateOfShipment;
				ElsIf DateOfShipment = Undefined Then
					DocumentObject.NotShipInInstallments = False;
				EndIf;
			EndIf;
			
			DocumentObject.Write(DocumentWriteMode.Posting);
			DocumentObject.Unlock();
			
			ProcessedItemsCount = ProcessedItemsCount + 1;
			
		Except
			
			Event = NStr("vi = 'Công đoạn sản xuất';
						|ru = 'Этап производства';
						|en = 'Production stage'; fa = 'مرحله تولید';
						|it = 'Fase di produzione';
						|pl = 'Etap produkcji';
						|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
					+ NStr("vi = 'Chuyển ngày đảm bảo mong muốn';
							|ru = 'Перенос желаемой даты обеспечения';
							|en = 'Rescheduling requested supply date'; fa = 'Rescheduling requested supply date';
							|it = 'Posticipo della data di garanzia richiesta';
							|pl = 'Przeniesienie żądanej danej zabezpieczenia';
							|tr = 'İstenen temin tarihlerinin taşınması'", Common.DefaultLanguageCode());
					
			WriteLogEvent(Event,
				EventLogLevel.Error
				,
				,
				DetailErrorDescription(ErrorInfo()));
			
			Raise;
			
		EndTry;
		
	EndDo;
	
	Return ProcessedItemsCount;
	
EndFunction

