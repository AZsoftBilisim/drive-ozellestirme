// Forms the stages of production.
//
// Parameters:
//  Parameters - Structure - document generation settings.
//		See Documents.ProductionStage2_2.StageGenerationSettings.
//  StorageAddress - String - address of the storage where the result will be placed. The result is
//		the number of recorded documents.
//
Procedure GenerateStages(Parameters, StorageAddress) Export
	
	// The formation stages
	KeyOperation = "IntershopManagement2_2.GeneratingProductionStages";
	MeasurementDetails = PerformanceMonitor.StartTimeConsumingOperationMeasurement(KeyOperation);
	ResultOfFormation = FormStagesInsideTimeMeasurement(Parameters);
	PerformanceMonitor.EndTimeConsumingOperationMeasurement(MeasurementDetails, ResultOfFormation.GeneratedDocuments_);
	
	If ResultOfFormation.HasError Then
		PutToTempStorage(ResultOfFormation, StorageAddress);
		Return;
	EndIf;
	
	// Additional actions after the formation of stages	
	If Parameters.CalculateTheSchedule Then
		
		PlanningParameters = New Structure;
		PlanningParameters.Insert("References", Parameters.References);
		AddressPlanningResult = PutToTempStorage(Undefined);
		
		ProductionManagement.ScheduleOrders(
			PlanningParameters,
			AddressPlanningResult);
		
		PlanningResult = GetFromTempStorage(AddressPlanningResult);
		If PlanningResult.HasErrors Then
			ResultOfFormation.HasError = True;
			ResultOfFormation.ErrorText = StrTemplate(
				NStr("vi = 'Đã xảy ra lỗi trong khi lập kế hoạch đặt hàng %1. Để biết thêm thông tin, hãy xem nơi làm việc ""Lập kế hoạch lịch trình đặt hàng.""';
					|ru = 'При планировании заказа %1 возникли ошибки. Подробнее см. в рабочем месте ""Планирование графика заказа"".';
					|en = 'Errors occurred when planning order %1. For more information, see the ""Order schedule planning"" workplace.'; fa = 'Errors occurred when planning order %1. For more information, see the ""Order schedule planning"" workplace.';
					|it = 'Nel corso della programmazione dell''ordine %1 si sono verificati errori. Vedere dettagli nella postazione di lavoro ""Programmazione del grafico dell''ordine"".';
					|pl = 'Przy planowaniu zamówienia %1 wystąpiły błędy. Więcej informacji można znaleźć w miejscu pracy ""Planowanie harmonogramu zamówienia"".';
					|tr = '%1 siparişi planlanırken hata oluştu. Daha fazla bilgi için bkz. çalışma alanında ""Sipariş Programı Planlaması"".'"),
				ProductionManagementServerCall.OrderPresentation(PlanningResult.ThisIsMistake, ""));;
			ResultOfFormation.LinkError = PlanningResult.ThisIsMistake;
		EndIf;
		
	EndIf;
	
	PutToTempStorage(ResultOfFormation, StorageAddress);
	ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
	
EndProcedure

// Function-constructor of the structure of parameters for forming stages
//
// Returns:
//  Structure - formation parameters
//
Function StageGenerationSettings() Export
	
	Result = New Structure;
	Result.Insert("References", New Array);
	
	// Security parameters
	Result.Insert("ReserveMaterials", False);
	Result.Insert("ReservePF", False);
	
	Result.Insert("ReplaceMaterialsWithAnalogs", False);
	Result.Insert("ReplacePFNaAnalogues", False);

	// Actions performed after the formation of the stages
	Result.Insert("PassStagesForExecution", False);
	Result.Insert("CalculateTheSchedule", False);
	
	Return Result;
	
EndFunction

// Marks for deletion the chain of stages for the passed selection.
//
// Parameters:
//  Filter               - DocumentRef.ProductionOrder2_2, CatalogRef.ProductionLots - Filter
//  IncludeSubordinates - Boolean - determines whether subordinate chains will be marked for deletion.
//
// Returns:
//  Structure - Result
//
Function MarkStagesForDeletion(Filter, IncludeSubordinates = True) Export
	
	Result = New Structure("QuantityProcessed,HasErrors,LinkError",0,False);
	
	Query = New Query(
		"SELECT
		|	Table.ProductionLot AS ProductionLot,
		|	Table.ReferenceOrder AS ReferenceOrder
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|
		|		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS RegulatorySchedule
		|			ON Table.Ref = RegulatorySchedule.ProductionStage
		|
		|WHERE
		|	NOT Table.DeletionMark
		|	AND &Filter
		|
		|GROUP BY
		|	Table.ProductionLot,
		|	Table.ReferenceOrder
		|
		|ORDER BY
		|	MIN(ISNULL(RegulatorySchedule.DurationBeforeStart, -Table.DurationBeforeProductionIssue))
		|");
	
	FiltersEnabled = False;
	If ValueIsFilled(Filter) Then
		
		FilterType = TypeOf(Filter);
		AvailableSelections = New Structure;
		If FilterType = Type("DocumentRef.ProductionOrder2_2") Then
			AvailableSelections.Insert("ReferenceOrder", Filter);
		ElsIf FilterType = Type("CatalogRef.ProductionLots") Then
			If IncludeSubordinates Then
				List = ChildChains(Filter);
				List.Add(Filter);
			Else
				List = New Array;
				List.Add(Filter);
			EndIf;
			AvailableSelections.Insert("ProductionLot", List);
		EndIf;
		
		FilterText1 = "";
		
		For Each KeyValue In AvailableSelections Do
			
			FilterText1 = 
				FilterText1
				+ ?(IsBlankString(FilterText1), "", " And ")
				+ " Table."
				+ KeyValue.Key
				+ " IN(&"
				+ KeyValue.Key
				+ ")";
			Query.SetParameter(KeyValue.Key, KeyValue.Value);
			
			FiltersEnabled = True;
			
		EndDo;
		
		Query.Text = StrReplace(Query.Text, "&Filter", ?(ValueIsFilled(FilterText1), FilterText1, "TRUE"));
		
	EndIf;
	If Not FiltersEnabled Then
		Return Result;
	EndIf;
	
	QueryResult = Query.Execute();
	
	If QueryResult.IsEmpty() Then
		Return Result;
	EndIf;
	
	Selection = QueryResult.Select();
	
	While Selection.Next() Do
		
		ProductionLot = Selection.ProductionLot;
		
		BeginTransaction();
		Try
			
			ChainOfStages = ChainOfStages(ProductionLot, SortDirection.Asc);
			
			If ChainOfStages.UBound() = -1 Then
				Raise NStr("vi = 'Lỗi đọc các kỳ cho lô sản xuất';
							|ru = 'Ошибка чтения этапов по партии производства';
							|en = 'An error occurred when reading production lot stages'; fa = 'An error occurred when reading production lot stages';
							|it = 'Errore durante la lettura delle fasi del lotto di produzione';
							|pl = 'Błąd podczas odczytu etapów partii produkcyjnej';
							|tr = 'Üretim lotuna göre aşamaların okunma hatası'");
			EndIf;
			
			For Each ObjectReference In ChainOfStages Do
				
				DocumentObject = ObjectReference.GetObject();
				DocumentObject.SetDeletionMark(True);
				
				Result.QuantityProcessed = Result.QuantityProcessed + 1;
				
			EndDo;
			
			CommitTransaction();
			
		Except
			
			RollbackTransaction();
			
			Result.HasErrors = True;
			Result.LinkError = ProductionLot;
			
			EventLogEvent = ProductionServer.EventMarkingForDeletingStages();
			
			MessageText = StrTemplate(NStr("vi = 'Không thể đặt dấu xóa chuỗi công đoạn: %1 do nguyên nhân: %2';
											|ru = 'Не удалось пометить на удаление цепочку этапов: %1 по причине: %2';
											|en = 'Cannot mark stage chain for deletion: %1. Reason: %2'; fa = 'Cannot mark stage chain for deletion: %1. Reason: %2';
											|it = 'Impossibile contrassegnare una catena di fasi per la cancellazione:%1 a causa di:%2';
											|pl = 'Nie udało się zaznaczyć do usunięcia łańcucha etapów: %1 z powodu: %2';
											|tr = 'Aşamalar zinciri silinmek üzere işaretlenemedi: %1, nedeni: %2'"),
								ProductionLot,
								DetailErrorDescription(ErrorInfo()));
			
			WriteLogEvent(EventLogEvent, EventLogLevel.Error, ProductionLot.Metadata(), ProductionLot, MessageText);
			
			Break;
			
		EndTry;
		
	EndDo;
	
	Return Result;
	
EndFunction

// Creates new / modifies existing production stages within the same chain.
//
// Parameters:
//  Parameters		 - Structure					 - parameters for changing stages:
//  					* ReferenceOrder               - DocumentRef.ProductionOrder2_2 - production order.
//  					* ProductionLot         - CatalogRef.ProductionLots - production batch.
//  					* BatchFields                 - Structure                             - description of the production batch.
//  					* Actions                   - Array of Structure                   - the list of actions with production stages contains:
//  					   ** Ref - DocumentRef - 
//  					   ** Type - String - 
//  					   ** FillingValues - Structure - 
//  StorageAddress	 - UUID, String	 - the address in temporary storage where
//  	the result of the procedure will be placed - the chain ID.
//
Procedure EditingProductionStageChain(Parameters, StorageAddress) Export
	
	ReferenceOrder       = Parameters.ReferenceOrder;
	ProductionLot = Parameters.ProductionLot;
	BatchFields         = Parameters.BatchFields;
	Actions           = Parameters.Actions;
	
	SetPrivilegedMode(True);
	
	SessionParameters.PostWithoutControlOfCompanyStockBalance = 
		Parameters.PostWithoutControlOfCompanyStockBalance;
		
	SetPrivilegedMode(False);

	HasErrors = False;
	DocumentDate = CurrentSessionDate();
	BeginTransaction();
	Try
		
		LockSource = New ValueTable();
		LockSource.Columns.Add("Ref", New TypeDescription("DocumentRef.ProductionStage2_2"));
		
		For Each Action In Actions Do
			If Action.Type = "Change" Or Action.Type = "Delete" Then
				NewRow = LockSource.Add();
				NewRow.Ref = Action.Ref;
			EndIf;
		EndDo;
		
		If LockSource.Count() > 0 Then
			Block = New DataLock;
			LockItem = Block.Add("Document.ProductionStage2_2");
			LockItem.DataSource = LockSource;
			LockItem.UseFromDataSource("Ref", "Ref");
			Block.Lock();
		EndIf;
		
		LotDescription =
			Catalogs.ProductionLots.CreateUpdateProductionBatch(ProductionLot, BatchFields, True);
		
		If LotDescription.NewProductionBatch Then
			NewStageNumberInLaunchBatch = 1;
		Else
			NewStageNumberInLaunchBatch = NewStageNumberInLaunchBatch(ProductionLot);
		EndIf;
		
		For Each Action In Actions Do
			
			If Action.Type = "Create" Then
				
				DocumentObject = Documents.ProductionStage2_2.CreateDocument();
				DocumentObject.SetNewObjectRef(Action.Ref);
				
				DocumentObject.Date = DocumentDate;
				DocumentObject.StartingLotNumber = LotDescription.ProductionBatchNumber;
				DocumentObject.StartingLotStageNumber = NewStageNumberInLaunchBatch;
				
				Number = "";
				If ValueIsFilled(ReferenceOrder) Then
					DetailsOfOrder = ProductionManagementCached.ProductionOrderData(ReferenceOrder);
					
					Number = ObjectsPrefixesClientServer.DeleteLeadingZerosFromObjectNumber(DetailsOfOrder.Number);
					Number = TrimAll(Number);
				EndIf;
				
				If ValueIsFilled(LotDescription.ProductionBatchNumber) And ValueIsFilled(NewStageNumberInLaunchBatch) Then
					Number = DocumentNumber(Number, LotDescription.ProductionBatchNumber, NewStageNumberInLaunchBatch);
				EndIf; 
				
				DocumentObject.Number = Number;
				
				Attributes = Action.FillingValues.HeaderAttributes;
				Attributes.Insert("Ref", Action.Ref);
				
				DestinationPattern = Documents.ProductionStage2_2.DestinationPattern(Attributes);
				Catalogs.Assignments.OnWriteDocument(Attributes.Purpose, DestinationPattern, DocumentObject, Attributes.Department, Attributes.ProductionIssueForActivity);
				
				NewStageNumberInLaunchBatch = NewStageNumberInLaunchBatch + 1;
				
			ElsIf Action.Type = "Change" Or Action.Type = "Delete" Then
				
				DocumentObject = Action.Ref.GetObject();
				
				If Action.Type = "Delete" Then
					DocumentObject.SetDeletionMark(True);
					Continue;
				EndIf;
				
			EndIf;
			
			DocumentObject.Fill(Action.FillingValues);
			
			If DocumentObject.CheckFilling() Then
				
				DocumentObject.DisableVerificationOfStageChainDetails();
				DocumentObject.DisableCalculationOfDurationBeforeReleaseByStagesOfProduction();
				DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
				
				DocumentObject.Write(DocumentWriteMode.Posting);
				
			Else
				Raise NStr("vi = 'Tìm thấy lỗi điền vào các công đoạn sản xuất';
							|ru = 'Найдены ошибки заполнения этапов производства';
							|en = 'There are errors in filled production stages'; fa = 'There are errors in filled production stages';
							|it = 'Si sono verificati degli errori nell''esecuzione delle fasi di produzione';
							|pl = 'Znaleziono błędy wypełnienia etapów produkcji';
							|tr = 'Üretim aşamalarının doldurulma hata bulundu'");
			EndIf;
			
		EndDo;
		
		CommitTransaction();
		
	Except
		
		RollbackTransaction();
		
		EventName = ProductionServer.EventEditingStageChain();
		WriteLogEvent(EventName, EventLogLevel.Error,,, ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		HasErrors = True;
		
	EndTry;
	
	If Not HasErrors Then
		InformationRegisters.JobsForTargetProductionScheduleCalculation.RunJob(ReferenceOrder);
		If Not ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.TargetOrderStructureSchedule.StartCalculation();
		EndIf;
	EndIf;
	
	Result = New Structure("HasErrors, Messages", HasErrors, GetUserMessages(True));
	PutToTempStorage(Result, StorageAddress);
	
EndProcedure

// Returns the stages for selection
//
// Parameters:
//  Filter			- Structure	- Filter
//  ChooseFirst	- Number		- limiting the sample size
//
// Returns:
//  Array - found stages
//
Function FindStages(Filter, ChooseFirst = Undefined) Export
	
	Query = New Query("
	|SELECT
	|	Table.Ref
	|FROM
	|	Document.ProductionStage2_2 AS Table
	|WHERE
	|	&Filter");
	
	ListOfTexts = New Array;
	
	If ValueIsFilled(Filter) Then
		For Each KeyValue In Filter Do
			If TypeOf(KeyValue.Key) = Type("Array") Then
				FilterText1 = StrTemplate("Table.%1 IN (&%1)", KeyValue.Key);
				ListOfTexts.Add(FilterText1);
			Else
				FilterText1 = StrTemplate("Table.%1 = &%1", KeyValue.Key);
				ListOfTexts.Add(FilterText1);
			EndIf;
			Query.SetParameter(KeyValue.Key, KeyValue.Value);
		EndDo;
	EndIf;
	
	Query.Text =
		StrReplace(
			Query.Text,
			"&Filter",
			?(ListOfTexts.Count() > 0, StrConcat(ListOfTexts, " And "), "TRUE"));
	
	If TypeOf(ChooseFirst) = Type("Number") Then
		Query.Text = StrReplace(Query.Text, "SELECT", "SELECT TOP " + String(ChooseFirst)); //@Query-part-1 @Query-part-2
	EndIf;
	
	SetPrivilegedMode(True);
	Return Query.Execute().Unload().UnloadColumn(0)
	
EndFunction

// Determines the need to mark the removal of a production batch
// 
// Parameters:
//  ProductionLot - CatalogRef.ProductionLots -  Production batch
// 
// Returns:
//  Boolean -  Marking The Removal Of The Production Batch
Function MarkingRemovalOfProductionBatch(ProductionLot) Export
	
	Query = New Query(
	"SELECT
	|	MIN(ChainStages.DeletionMark) AS MarkingStageDeletion
	|FROM
	|	Document.ProductionStage2_2 AS ChainStages
	|
	|WHERE
	|	ChainStages.ProductionLot = &ProductionLot
	|	AND NOT ChainStages.ProductionProcessType =
	|		VALUE(Enum.ProductionProcessTypes.WithoutBillsOfMaterials)
	|");
	Query.SetParameter("ProductionLot", ProductionLot);
	
	Result = False;
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		Result = Selection.MarkingStageDeletion;
	EndIf;
	
	Return Result;
	
EndFunction

// Calculates shifts of stages within the party
//
// Parameters:
//  Jobs - ValueTable - the columns correspond to the measurements, resources and Attributes of the register of information
//                              "Tasks for the duration of the release of the production steps", there are also service columns:
//             * ProductionLot     - CatalogRef.ProductionLots -
//             * DeleteProductionStageLot            - DocumentRef.ProductionStage2_2 -
//             * RecordID    - UUID -
//             * NotUsedRegistrationDay - Number  -
//             * RecordDate             - Date   -
//             * JobID   - UUID - Service_
//             * TaskDate_            - Date                    - Service_
//  IdsOfUnprocessedRecords - Map of UUID - The key is the identifier 
//                                                                                   of the failed (giving an error during
//                                                                                   execution) entries
//                                                                                   of the Job queue information register
//                                                                                   (measurement
//                                                                                   of the record identifier of the Job queue information register),
//                                                                                  the value is the Presentation of the error.
//  AdditionalProperties - Undefined, Structure - additional task completion properties.
//
Procedure CalculateShiftsOfStagesWithinBatch(
			Jobs,
			IdsOfUnprocessedRecords,
			AdditionalProperties = Undefined) Export
	
	SetPrivilegedMode(True);
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	Jobs.ProductionLot  AS ProductionLot,
	|	Jobs.RecordID AS RecordID,
	|	Jobs.RecordDate          AS RecordDate
	|INTO Jobs
	|FROM
	|	&Jobs AS Jobs
	|
	|INDEX BY
	|	ProductionLot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Jobs.ProductionLot           AS ProductionLot,
	|	MIN(Jobs.RecordID) AS RecordID,
	|	MIN(Jobs.RecordDate)          AS RecordDate
	|FROM
	|	Jobs AS Jobs
	|GROUP BY
	|	Jobs.ProductionLot
	|
	|ORDER BY
	|	RecordDate,
	|	ProductionLot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Table.Ref                                AS Ref,
	|	Table.StageNumber                            AS StageNumber,
	|	Table.NextStageNo                  AS NextStageNo,
	|
	|	CASE
	|		WHEN Table.StageDuration = 0 THEN
	|			0.0001
	|		ELSE
	|			Table.StageDuration
	|			* CASE
	|				WHEN Table.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.MINUTE)
	|					THEN 60
	|				WHEN Table.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.HOUR)
	|					THEN 3600
	|				WHEN Table.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.DAY)
	|					THEN 86400
	|				WHEN Table.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.Days1)
	|					THEN 86400
	|				ELSE 1
	|			END
	|	END AS DurationInSeconds,
	|
	|	Table.DurationBeforeProductionIssue AS DurationBeforeReleaseInDocument,
	|
	|	Table.ReferenceOrder          AS ReferenceOrder,
	|	Table.ProductionLot    AS ProductionLot,
	|
	|	Table.Posted                                                              AS Posted,
	|	Table.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) AS Completed
	|FROM
	|	Document.ProductionStage2_2 AS Table
	|WHERE
	|	TRUE IN 
	|		(SELECT TOP 1
	|			TRUE
	|		FROM
	|			Jobs AS Jobs
	|		WHERE
	|			Jobs.ProductionLot = Table.ProductionLot)
	|	AND NOT Table.DeletionMark
	|";
	
	Query.SetParameter("Jobs", Jobs);
	
	Results = Query.ExecuteBatch();
	
	BatchTable = Results[1].Unload();
	
	StepsTable = Results[2].Unload();
	StepsTable.Columns.Add(
		"DurationBeforeProductionIssue",
		Common.TypeDescriptionNumber(14, 4, AllowedSign.Nonnegative));
		
	StepsTable.Indexes.Add("ProductionLot");
	
	FilterLot             = New Structure("ProductionLot");
	SelectionHasNotBeenCompleted = New Structure("Posted, Completed", True, False);
		
	RegistersList = New Structure("OrderStructure");
	
	For Each BatchTableRow In BatchTable Do
		
		FillPropertyValues(FilterLot, BatchTableRow);
		
		TableOfPartyStages = StepsTable.Copy(FilterLot);
		TableOfPartyStages.Indexes.Add("NextStageNo");
		TableOfPartyStages.Indexes.Add("Posted, Completed");
		
		CalculateShifts(TableOfPartyStages);
		
		StageList = TableOfPartyStages.Copy(SelectionHasNotBeenCompleted);
		If StageList.Count() = 0 Then
			Continue;
		EndIf;
		
		StageList.Columns.Add("Mark", New TypeDescription("Boolean"));
		StageList.Indexes.Add("Mark");
		
		ListToProcess = StageList;
		
		Boundary = ListToProcess.Count() - 1;
		IndexOf = 0;
		
		Continue_Processing = True;
	
		AttemptsNumber = 3;
		HadErrors = False;
		
		ErrorsTexts = New Map;
		
		While Continue_Processing Do
			
			ThereWereErrorsInCurStage = False;
			CurrentStep = ListToProcess[IndexOf];
			
			If CurrentStep.DurationBeforeProductionIssue <> CurrentStep.DurationBeforeReleaseInDocument Then
				
				BeginTransaction();
				
				Try
					
					Block = New DataLock;
					LockItem = Block.Add("Document.ProductionStage2_2");
					LockItem.SetValue("Ref", CurrentStep.Ref);
					Block.Lock();
					
					DocumentObject = CurrentStep.Ref.GetObject(); // DocumentObject - 
					
					If DocumentObject <> Undefined
					   And DocumentObject.Posted
					   And DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.Completed Then
						
						DocumentObject.DataExchange.Load = True;
						
						FillPropertyValues(
							DocumentObject,
							CurrentStep,,
							"ReferenceOrder,ProductionLot,Ref");
						
						DocumentsPosting.BeforeWritingDocument(DocumentObject, DocumentWriteMode.Posting, Undefined);
						DocumentObject.Write(DocumentWriteMode.Write);
						TablesForRegisteredRecords = DocumentsPosting.DocumentDataForPosting(DocumentObject.Ref, RegistersList);
						OrderStructureDocumentPosting.WriteData(TablesForRegisteredRecords, DocumentObject.Ref, Undefined, ThereWereErrorsInCurStage);
						
					EndIf;
					
					If ErrorsTexts.Get(CurrentStep.Ref) <> Undefined Then
						ErrorsTexts.Delete(CurrentStep.Ref);
					EndIf;
					
					CommitTransaction();
					
				Except
					
					RollbackTransaction();
					
					EventName = ProductionServer.EventCalculationOfDurationBeforeReleaseByStagesOfProduction();
					
					ErrorTemplate = NStr("vi = 'Không thể ghi nhận dịch chuyển của công đoạn sản xuất: %1 do nguyên nhân: %2';
										|ru = 'Не удалось зафиксировать сдвиги этапа производства: %1 по причине: %2';
										|en = 'Cannot commit production stage shifts: %1 due to: %2'; fa = 'Cannot commit production stage shifts: %1 due to: %2';
										|it = 'Non è stato possibile fissare i salti della fase di produzione:%1 a causa di:%2';
										|pl = 'Nie udało się zarejestrować przesunięć etapu produkcji: %1 z powodu: %2';
										|tr = 'Üretim aşaması kaymaları uygulanamadı: %1 çünkü: %2'");
					MessageText = StrTemplate(
										ErrorTemplate,
										CurrentStep.Ref,
										ErrorProcessing.DetailErrorDescription(ErrorInfo()));
					
					WriteLogEvent(
						EventName,
						EventLogLevel.Error,
						CurrentStep.Ref.Metadata(),
						CurrentStep.Ref,
						MessageText);
					
					If ErrorsTexts.Get(CurrentStep.Ref) = Undefined Then
						ErrorsTexts.Insert(CurrentStep.Ref, MessageText);
					EndIf;
					
					ThereWereErrorsInCurStage = True;
					
				EndTry;
			
			EndIf;
			
			CurrentStep.Mark = Not ThereWereErrorsInCurStage;
			HadErrors = HadErrors Or ThereWereErrorsInCurStage;
			
			If Boundary > IndexOf Then
				IndexOf = IndexOf + 1;
				Continue;
			EndIf;
			
			If HadErrors And AttemptsNumber > 0 Then
				ListToProcess = StageList.FindRows(New Structure("Mark", False));
				Boundary = ListToProcess.Count() - 1;
				IndexOf = 0;
				AttemptsNumber = AttemptsNumber - 1;
				HadErrors = False;
				Continue;
			EndIf;
			
			Continue_Processing = False;
			
		EndDo;
		
		If HadErrors Then
			
			ProductionLot = BatchTableRow.ProductionLot;
			
			EventName = ProductionServer.EventCalculationOfDurationBeforeReleaseByStagesOfProduction();
			
			MessageText = StrTemplate(
								NStr("vi = 'Không thể tính toán dịch chuyển các công đoạn trong lô hàng sản xuất: %1';
									|ru = 'Не удалось рассчитать сдвиги этапов внутри партии производства: %1';
									|en = 'Cannot calculate stage shifts within the production lot: %1'; fa = 'Cannot calculate stage shifts within the production lot: %1';
									|it = 'Non è stato possibile contare i salti di fase all''interno del lotto di produzione: %1';
									|pl = 'Nie udało się przeliczyć przesunięcia etapów wewnątrz partii produkcji: %1';
									|tr = 'Üretim lotu içindeki aşama kaymaları hesaplanamadı: %1'"),
								ProductionLot);
			
			WriteLogEvent(
				EventName,
				EventLogLevel.Error,
				ProductionLot.Metadata(),
				ProductionLot,
				MessageText);
			
			ArrayOfErrorTexts = New Array;
			ArrayOfErrorTexts.Add(MessageText);
			
			For Each ItemError In ErrorsTexts Do
				ArrayOfErrorTexts.Add(ItemError.Value);
			EndDo;
			
			ErrorText = DeferredJobs.ExecutionErrorText(
							New Structure("ProductionLot"),
							BatchTableRow,
							StrConcat(ArrayOfErrorTexts, Chars.LF));
			
			IdsOfUnprocessedRecords.Insert(BatchTableRow.RecordID, ErrorText);
			
		EndIf;
		
	EndDo;
	
EndProcedure

