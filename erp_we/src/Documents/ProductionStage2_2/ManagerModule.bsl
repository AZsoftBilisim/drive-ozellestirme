							|pl = 'wyrób';
							|tr = 'nihai ürün'"),
						NStr("vi = 'sản phẩm';
							|ru = 'изделия';
							|en = 'products'; fa = 'products';
							|it = 'prodotti';
							|pl = 'wyroby';
