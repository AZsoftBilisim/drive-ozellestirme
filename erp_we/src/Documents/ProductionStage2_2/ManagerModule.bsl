	Return 0;
	
EndFunction

Function CommunicationTypeConsumer() Export
	
	Return 1;
	
EndFunction

Function UseOperationsInStages()
	
	Return GetFunctionalOption("UseOperationManagement")
		Or GetFunctionalOption("UseManufacturingExecutionSystem");
	
EndFunction

Function QueueAttributesNeedToBeCalculated(Data_Stage)
	
	Result = False;
	
	StatusPending = Enums.StatusesOfProductionStages2_2.ForCompletion;
	StatusStarted       = Enums.StatusesOfProductionStages2_2.Initiated;
	StatusCompleted_1    = Enums.StatusesOfProductionStages2_2.Completed;
	
	If Not Data_Stage.Posted
			Or Not Data_Stage.ThereAreTechnologicalOperations Then
		Result = False;
	ElsIf (Data_Stage.UseManufacturingExecutionSystem
				Or Data_Stage.UseShiftTasks)
		And (Data_Stage.Status = StatusPending
				Or Data_Stage.Status = StatusStarted) Then
		Result = True;
	ElsIf (Data_Stage.UseManufacturingExecutionSystem
				Or Data_Stage.UseShiftTasks)
		And (Data_Stage.Status = StatusCompleted_1
				And Data_Stage.ThereAreUnfinishedOperations) Then
		Result = True;
	ElsIf Data_Stage.UseOperationManagement
		And Data_Stage.Status = StatusStarted Then
		Result = True;
	EndIf;
	
	Return Result;
	
EndFunction

// Queue Attributes in the archive.
// 
// Parameters:
//  Data_Stage
// 
// Returns:
//  Boolean - Queue Attributes in the archive
Function ArchiveQueueAttributes(Data_Stage) Export
	
	Result = Data_Stage.Status = Enums.StatusesOfProductionStages2_2.Completed
		Or Not Data_Stage.Posted
		Or ProductionManagementClientServer.StatusesAvailableByOperationalManagement(Data_Stage).Find(Data_Stage.Status) = Undefined;
	
	Return Result;
	
EndFunction

