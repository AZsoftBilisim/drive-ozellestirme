// Reads object data and puts it in temporary tables
//
// Parameters:
//  Object	 - DocumentObject.ProductionStage2_2, Structure - the object for which you want to read the data.
//
// Returns:
//  TempTablesManager - temporary table manager.
//
Function TemporaryObjectDataTables(Object) Export
	
	If TypeOf(Object) = Type("Structure") Then
		DataOfProductionStages = Object;
	Else
		DataOfProductionStages = Object.DataOfProductionStages();
	EndIf;
	
	QueryTexts = New Array;
	Query = New Query;
	
	QueryText = 
	"SELECT
	|	Table.Date AS Date,
	|	Table.Organization AS Organization,
	|	Table.BusinessOperation AS BusinessOperation,
	|	Table.InternalSubcontracting AS InternalSubcontracting,
	|	Table.MaterialProviderCompany AS MaterialProviderCompany,
	|	Table.ProductionLot AS ProductionLot,
	|	Table.ReferenceOrder AS ReferenceOrder,
	|	Table.Ref AS Ref,
	|	Table.DynamicStructure AS DynamicStructure,
	|	Table.WorkPlanning AS WorkPlanning,
	|	Table.ProductionIssueForActivity AS ProductionIssueForActivity,
	|	Table.Status AS Status,
	|
	|	Table.ProductionProcessType AS ProductionProcessType,
	|
	|	Table.ProductionByThirdParty AS ProductionByThirdParty,
	|	Table.ProductionByThirdParty2_5 AS ProductionByThirdParty2_5,
	|	Table.SubcontractOrder AS SubcontractOrder,
	|	Table.LeaveProductsAtSubcontractor AS LeaveProductsAtSubcontractor,
	|	
	|	Table.ProductionInOneDay AS ProductionInOneDay,
	|	Table.ProductionDate AS ProductionDate,
	|	Table.NotShipInInstallments AS NotShipInInstallments,
	|	Table.DateOfShipment AS DateOfShipment,
	|	Table.ConsumptionInOneDay AS ConsumptionInOneDay,
	|	Table.DateOfMaterialWorkConsumption AS DateOfMaterialWorkConsumption,
	|	Table.WorkPerformanceAsOneDay AS WorkPerformanceAsOneDay,
	|	Table.WorkExecutionDate AS WorkExecutionDate,
	|
	|	Table.ActualStageStart AS ActualStageStart,
	|	Table.ActualStageEnd AS ActualStageEnd,
	|
	|	Table.Purpose AS Purpose,
	|
	|	Table.MethodOfAllocatingFinishedProductCosts AS MethodOfAllocatingFinishedProductCosts,
	|	
	|	Table.NextStageNo = 0 AS ThisIsAProductionIssueStage
	|
	|INTO StageDetails_
	|FROM
	|	&Attributes AS Table
	|
	|INDEX BY
	|	Table.Ref
	|";
	
	QueryTexts.Add(QueryText);
	Query.SetParameter("Attributes", DataOfProductionStages.Attributes);
	
	If DataOfProductionStages.Property("OrderDetailsForProcessor")
		And ValueIsFilled(DataOfProductionStages.OrderDetailsForProcessor) Then
		
		QueryTexts.Add(
		"SELECT
		|	&SubcontractOrder AS SubcontractOrder,
		|	&Posted           AS Posted,
		|	&Status             AS Status
		|INTO AttributesOfOrdersToProcessor
		|");
		Query.SetParameter("SubcontractOrder", DataOfProductionStages.OrderDetailsForProcessor.SubcontractOrder);
		Query.SetParameter("Posted",           DataOfProductionStages.OrderDetailsForProcessor.Posted);
		Query.SetParameter("Status",             DataOfProductionStages.OrderDetailsForProcessor.Status);
		
	Else
		
		QueryTexts.Add(
		"SELECT
		|	StageDetails_.SubcontractOrder AS SubcontractOrder,
		|	OrdersToProcessor.Posted       AS Posted,
		|	OrdersToProcessor.Status         AS Status
		|INTO AttributesOfOrdersToProcessor
		|FROM
		|	StageDetails_ AS StageDetails_
		|	
		|	INNER JOIN InformationRegister.DocumentsRegistry AS OrdersToProcessor
		|	ON OrdersToProcessor.Ref = StageDetails_.SubcontractOrder
		|	AND NOT OrdersToProcessor.AdditionalRecord
		|	AND NOT StageDetails_.SubcontractOrder = UNDEFINED
		|
		|GROUP BY
		|	StageDetails_.SubcontractOrder,
		|	OrdersToProcessor.Posted,
		|	OrdersToProcessor.Status
		|
		|INDEX BY
		|	StageDetails_.SubcontractOrder
		|");
		
	EndIf;
	
	If DataOfProductionStages.CheckingTSManufacturedProducts Then
		
		QueryText = 
		"SELECT
		|	TabularSection.Ref,
		|	TabularSection.LineNumber,
		|	TabularSection.Products,
		|	TabularSection.Characteristic,
		|	TabularSection.Package,
		|	TabularSection.NumberOfPackages,
