		|			VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND VALUETYPE(TabularSection.Recipient) = TYPE(Catalog.Warehouses)
		|	AND (TabularSection.Manufactured
		|		OR HeaderData_.ProductionByThirdParty
		|			AND HeaderData_.SubcontractOrder <> UNDEFINED
		|			AND ISNULL(OrdersToProcessor.Posted, FALSE)
		|			AND ISNULL(OrdersToProcessor.Status, VALUE(Enum.TollingOrderStatuses.EmptyRef)) IN (
