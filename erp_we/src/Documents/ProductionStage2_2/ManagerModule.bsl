		|	LEFT JOIN TTCurrencyConversionFactors AS Coefficients
		|	ON Table.Ref.Currency = Coefficients.Currency
		|	LEFT JOIN TTAccountingData AS DataOfAccounting
		|	ON Table.Ref         = DataOfAccounting.ReferenceOrder
