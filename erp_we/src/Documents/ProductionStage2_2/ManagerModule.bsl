	CheckParameters = ParametersForVerifyingBankingDetails("Purpose", "ShipmentToDestinationOfNewStageIsNotAvailable");
	CheckParameters.MessageTemplate = NStr("vi = 'Không thể kết chuyển chứng từ với thao tác Giao hàng theo mục đích của Công đoạn mới, bởi vì không thể có số dư theo mục đích này (dòng %1 danh sách ""%2"").';
