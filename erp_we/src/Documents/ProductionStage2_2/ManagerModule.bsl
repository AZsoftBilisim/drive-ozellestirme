Function CheckDivisionPointQueue(OperationID, TempTablesManager, ThisIsDivision, ItSNonconformityMarriage, ThisIsCancellation)
	
	Cancel = False;
	MessageText = "";
	ThisIsChangeInsideQueue = False;
	
	If OperationID = 0 Then
		// By default, it is assumed that if the operation is not specified, then the action is performed from the first operation.
		Query = New Query(
			"SELECT TOP 1
			|	FirstOperation.OperationsToDestination > 0 AS ThereIsBalanceToDestination,
			|	FirstOperation.IsStarted                  AS IsStarted,
			|	TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTOperationQueue AS Successors
			|		WHERE
			|			FirstOperation.NextOperation <> 0
			|			AND Successors.OperationNumber >= FirstOperation.NextOperation
			|			AND Successors.IsStarted)        AS FollowersAreStarted
			|FROM
			|	TTOperationQueue AS FirstOperation
			|WHERE
			|	NOT TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTOperationQueue AS Predecessors
			|		WHERE
			|			Predecessors.NextOperation = FirstOperation.OperationNumber)
			|ORDER BY
			|	FirstOperation.OperationNumber");
		Query.TempTablesManager = TempTablesManager;
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			If Not Selection.ThereIsBalanceToDestination
				Or Selection.FollowersAreStarted Then
				Cancel = True;
				MessageText =
					NStr("vi = 'Đã bắt đầu thực hiện giao dịch của công đoạn. Để thực hiện thao tác, cần chỉ ra giao dịch.';
						|ru = 'Выполнение операций этапа начато. Для выполнения действия необходимо указать операцию.';
						|en = 'Stage operation execution is started. To perform the action, specify an operation.'; fa = 'Stage operation execution is started. To perform the action, specify an operation.';
						|it = 'Выполнение операций этапа начато. Для выполнения действия необходимо указать операцию.';
						|pl = 'Stage operation execution is started. To perform the action, specify an operation.';
						|tr = 'Aşama işlemlerin gerçekleştirilmesi başlatıldı. Eylemin gerçekleştirilmesi için işlem belirtmeniz gerekmektedir.'");
			EndIf;
			
			ThisIsChangeInsideQueue = Selection.IsStarted;
		EndIf;
	Else
		Query = New Query(
			"SELECT
			|	CurrentOperation.OperationsToDestination > 0 AS ThereIsBalanceToDestination,
			|	CurrentOperation.IsStarted                  AS IsStarted,
			|	NOT TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTOperationQueue AS Predecessors
			|		WHERE
			|			Predecessors.NextOperation = CurrentOperation.OperationNumber) AS ThisIsFirstOperation,
			|	TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTOperationQueue AS Predecessors
			|		WHERE
			|			CurrentOperation.ControlOperationID <> 0
			|			AND Predecessors.NextOperation = CurrentOperation.OperationNumber
			|			AND Predecessors.ControlOperationID = CurrentOperation.ControlOperationID) AS ThisIsControlledOperation,
			|	TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTOperationQueue AS Successors
			|		WHERE
			|			CurrentOperation.NextOperation <> 0
			|			AND Successors.OperationNumber >= CurrentOperation.NextOperation
			|			AND Successors.IsStarted) AS FollowersAreStarted
			|FROM
			|	TTOperationQueue AS CurrentOperation
			|WHERE
			|	CurrentOperation.OperationID = &OperationID");
		Query.TempTablesManager = TempTablesManager;
		Query.SetParameter("OperationID", OperationID);
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			If (ThisIsDivision Or ThisIsCancellation)
				And Not Selection.ThereIsBalanceToDestination Then
				Cancel = True;
				MessageText =
					NStr("vi = 'Đã ấn định giao dịch được chọn một cách đầy đủ. Để thực hiện thao tác, cần hủy bỏ toàn bộ giao dịch (hoặc một phần của giao dịch) hoặc chọn giao dịch tiếp theo.';
						|ru = 'Выбранная операция назначена в полном объеме. Для выполнения действия необходимо отменить всю операцию (либо ее часть) или выбрать последующую операцию.';
						|en = 'The selected operation is assigned in full. To perform the action, cancel the whole operation (or its part) or select the next operation.'; fa = 'The selected operation is assigned in full. To perform the action, cancel the whole operation (or its part) or select the next operation.';
						|it = 'Выбранная операция назначена в полном объеме. Для выполнения действия необходимо отменить всю операцию (либо ее часть) или выбрать последующую операцию.';
						|pl = 'The selected operation is assigned in full. To perform the action, cancel the whole operation (or its part) or select the next operation.';
						|tr = 'Seçilen işlem tam olarak atanmaktadır. Eylemin gerçekleştirilmesi için işlemin tamamını (veya bir kısmını) iptal etmeniz veya bir sonraki işlemi seçmeniz gerekmektedir.'");
			EndIf;
			
			If ThisIsDivision
				And Selection.ThisIsControlledOperation
				And Not Cancel Then
				Cancel = True;
				MessageText =
					NStr("vi = 'Đã chọn giao dịch được kiểm soát. Để thực hiện thao tác, cần chỉ ra giao dịch sau kiểm soát.';
						|ru = 'Выбрана контролируемая операция. Для выполнения действия необходимо указать операцию после контрольной.';
						|en = 'A controlled operation is selected. To perform the action, specify an operation after the controlled one.'; fa = 'A controlled operation is selected. To perform the action, specify an operation after the controlled one.';
						|it = 'Выбрана контролируемая операция. Для выполнения действия необходимо указать операцию после контрольной.';
						|pl = 'A controlled operation is selected. To perform the action, specify an operation after the controlled one.';
						|tr = 'Kontrollü işlem seçildi. Eylemin gerçekleştirilmesi için kontrolden sonraki işlemi belirtmeniz gerekmektedir.'");
			EndIf;
			
			If Selection.FollowersAreStarted
				And Not Cancel Then
				Cancel = True;
				MessageText =
					NStr("vi = 'Đã bắt đầu giao dịch tiếp theo. Để thực hiện thao tác, cần chỉ ra giao dịch chưa hoàn thành cuối cùng hoặc công đoạn tiếp theo.';
						|ru = 'Последующие операции начаты. Для выполнения действия необходимо указать последнюю незавершенную операцию либо последующий этап.';
						|en = 'The next operations are started. To perform the action, specify the last uncompleted operation or the next stage.'; fa = 'The next operations are started. To perform the action, specify the last uncompleted operation or the next stage.';
						|it = 'Последующие операции начаты. Для выполнения действия необходимо указать последнюю незавершенную операцию либо последующий этап.';
						|pl = 'The next operations are started. To perform the action, specify the last uncompleted operation or the next stage.';
						|tr = 'Sonraki işleler başlatıldı. Eylemin gerçekleştirilmesi için tamamlanmamış son işlemi veya sonraki aşamayı belirtmeniz gerekmektedir.'");
			EndIf;
			
			ThisIsChangeInsideQueue = Selection.IsStarted
				Or Not Selection.ThisIsFirstOperation;
		EndIf;
	EndIf;
	
	Result = New Structure;
	Result.Insert("Cancel", Cancel);
	Result.Insert("MessageText", MessageText);
	Result.Insert("ThisIsChangeInsideQueue", ThisIsChangeInsideQueue);
	
	Return Result;
	
EndFunction

Function StageForIntermediateRelease(BeforeStage)
	
	Query = New Query(
		"SELECT
		|	MIN(Table.Ref) AS Ref
		|FROM
		|	Document.ProductionStage2_2.Successors AS Table
		|WHERE
		|	Table.Stage = &Stage
		|	AND Table.LinkType = &CommunicationTypeFollower
		|	AND Table.Ref.Posted
		|
		|HAVING
		|	COUNT(Table.Ref) = 1
		|	AND MIN(Table.Ref.Status <> VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND MIN(NOT Table.Ref.WorkPlanning)");
	Query.SetParameter("Stage", BeforeStage);
	Query.SetParameter("CommunicationTypeFollower", CommunicationTypeFollower());
	Selection = Query.Execute().Select();
	
	Return ?(Selection.Next(), Selection.Ref, Undefined);
	
EndFunction

// Cancel part of the stage.
// 
// Parameters:
//  BatchData - See ProductionBatchData
//  DocumentObject - DocumentObject.ProductionStage2_2
//  Operation ID - Number
//
Procedure DeletePlannedLines(BatchData, DocumentObject)
	
	Exceptions = DivisionItems(DocumentObject.Ref);
	SoftwareExceptions = New Structure("Products, Characteristic, Warehouse, Purpose");
	FinishedProductExceptions = New Structure("Products, Characteristic, Recipient, Purpose");
	
	TheStructureOfTheSearch = New Structure("Canceled", False);
	For Each String In DocumentObject.SupplyWithMaterialsAndWorks.FindRows(TheStructureOfTheSearch) Do
		If String.SupplyOption = Enums.SupplyOptions.Ship Then
			Continue;
		Else
			FillPropertyValues(SoftwareExceptions, String);
			If Exceptions.Supply.FindRows(SoftwareExceptions).UBound() <> -1 Then
				Continue;
			EndIf;
		EndIf;
		DocumentObject.SupplyWithMaterialsAndWorks.Delete(String);
	EndDo;
	
	TheStructureOfTheSearch = New Structure("Manufactured, Canceled", False, False);
	For Each String In DocumentObject.ManufacturedProducts.FindRows(TheStructureOfTheSearch) Do
		FillPropertyValues(FinishedProductExceptions, String);
		If Exceptions.Products_1.FindRows(FinishedProductExceptions).UBound() <> -1 Then
			Continue;
		EndIf;
		DocumentObject.ManufacturedProducts.Delete(String);
	EndDo;
	For Each String In DocumentObject.BatchFinishedProducts.FindRows(TheStructureOfTheSearch) Do
		FillPropertyValues(FinishedProductExceptions, String);
		If Exceptions.Products_1.FindRows(FinishedProductExceptions).UBound() <> -1 Then
			Continue;
		EndIf;
		DocumentObject.BatchFinishedProducts.Delete(String);
	EndDo;
	For Each String In DocumentObject.SideAndIntermediateRelease.FindRows(TheStructureOfTheSearch) Do
		DocumentObject.SideAndIntermediateRelease.Delete(String);
	EndDo;
	For Each String In DocumentObject.BatchSideAndIntermediateRelease.FindRows(TheStructureOfTheSearch) Do
		DocumentObject.BatchSideAndIntermediateRelease.Delete(String);
	EndDo;
	
	DivisionParameters = ProductionServerCached.ProductionBusinessUnitDescription(
		DocumentObject.Department);
	LaborCostsInOperations = DivisionParameters.UseOperationManagement
		And DocumentObject.OperationAsOutputReference;
	
	If Not LaborCostsInOperations Then
		TheStructureOfTheSearch = New Structure("Completed2, Canceled", False, False);
		For Each String In DocumentObject.LaborCosts.FindRows(TheStructureOfTheSearch) Do
			DocumentObject.LaborCosts.Delete(String);
		EndDo;
	EndIf;
	
EndProcedure

Procedure SetLastOperation(DocumentObject, OperationID, TempTablesManager)
	
	FirstOperationID = 0;
	LastOperationID = 0;
	CanceledLastOperation = 0;
	Predecessor = Undefined;
	
	QueryTexts = New Array;
	QueryTexts.Add(
		"SELECT
		|	TechnicalProcess.FirstOperationID AS FirstOperationID,
		|	TechnicalProcess.LastOperationID AS LastOperationID,
		|	TechnicalProcess.CanceledLastOperation AS CanceledLastOperation,
		|	DivisionAttributes.Predecessor AS Predecessor
		|FROM
		|	InformationRegister.AttributesOfProductionStageDivision AS DivisionAttributes
		|
		|	FULL JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcess
		|	ON DivisionAttributes.Stage = TechnicalProcess.Stage
		|
		|WHERE
		|	DivisionAttributes.Stage = &Stage");
	SampleBankingDetails = Undefined;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.SetParameter("Stage", DocumentObject.Ref);
	
	If OperationID = 0 Then
		QueryTexts.Add(
			"SELECT TOP 1
			|	FirstOperation.Operation              AS Operation,
			|	FirstOperation.OperationID AS OperationID,
			|	FirstOperation.OperationsToDestination   AS OperationsToDestination
			|FROM
			|	TTOperationQueue AS FirstOperation
			|WHERE
			|	NOT TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			TTOperationQueue AS Predecessors
			|		WHERE
			|			Predecessors.NextOperation = FirstOperation.OperationNumber)
			|ORDER BY
			|	FirstOperation.OperationNumber");
		Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
		ResultsArray = Query.ExecuteBatch();
		
		SampleBankingDetails = ResultsArray[0].Select();
		
		SamplingOperation = ResultsArray[1].Select();
		If Not SamplingOperation.Next() Then
			Return;
		EndIf;
		
		LastOperationID = SamplingOperation.OperationID;
		CanceledLastOperation = SamplingOperation.OperationsToDestination;
	Else
		QueryTexts.Add(
			"SELECT
			|	CurrentOperation.Operation                           AS Operation,
			|	CurrentOperation.IsStarted                             AS IsStarted,
			|	CurrentOperation.OperationsToDestination                AS OperationsToDestination,
			|	ISNULL(Predecessors.Operation, UNDEFINED)   AS OperationPredecessor,
			|	ISNULL(Predecessors.OperationID, 0) AS IdOfPredecessorOperation
			|FROM
			|	TTOperationQueue AS CurrentOperation
			|	
			|	LEFT JOIN TTOperationQueue AS Predecessors
			|	ON CurrentOperation.OperationNumber = Predecessors.NextOperation
			|WHERE
			|	CurrentOperation.OperationID = &OperationID");
		Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
		Query.SetParameter("OperationID", OperationID);
		ResultsArray = Query.ExecuteBatch();
		
		SampleBankingDetails = ResultsArray[0].Select();
		
		SamplingOperation = ResultsArray[1].Select();
		If Not SamplingOperation.Next() Then
			Return;
		EndIf;
		
		If SamplingOperation.IsStarted
			Or SamplingOperation.IdOfPredecessorOperation = 0 Then
			LastOperationID = OperationID;
			CanceledLastOperation = SamplingOperation.OperationsToDestination;
		Else
			LastOperationID = SamplingOperation.IdOfPredecessorOperation;
		EndIf;
	EndIf;
	
	If SampleBankingDetails.Next() Then
		FirstOperationID = SampleBankingDetails.FirstOperationID;
		Predecessor = SampleBankingDetails.Predecessor;
		If SampleBankingDetails.LastOperationID = LastOperationID Then
			CanceledLastOperation = CanceledLastOperation + SampleBankingDetails.CanceledLastOperation;
		EndIf;
	EndIf;
	
	DivisionAttributes = DataProcessors.ProductionLotDivision.DivisionAttributesConstructor();
	DivisionAttributes.FirstOperationID = FirstOperationID;
	DivisionAttributes.LastOperationID = LastOperationID;
	DivisionAttributes.CanceledLastOperation = CanceledLastOperation;
	DivisionAttributes.Predecessor = Predecessor;
	
	DocumentObject.ChangeDivisionAttributes(DivisionAttributes);
	
EndProcedure

Procedure CopyLotReferenceLocationInOrderStructure(Lot, NewBatch_)
	
	Query = New Query(
		"SELECT
		|	&NewBatch_                            AS Lot,
		|	PlaceOfLotReference.Level                     AS Level,
		|	PlaceOfLotReference.DurationBeforeProductionIssue       AS DurationBeforeProductionIssue,
		|	PlaceOfLotReference.ProductionLotIDInProductGroup AS ProductionLotIDInProductGroup,
		|	PlaceOfLotReference.ProductItemsGroup               AS ProductItemsGroup
		|FROM
		|	InformationRegister.LocationOfLaunchedLotAndStagesInOrderStructure AS PlaceOfLotReference
		|WHERE
		|	PlaceOfLotReference.Lot = &Lot");
	Query.SetParameter("Lot", Lot);
	Query.SetParameter("NewBatch_", NewBatch_);
	Table = Query.Execute().Unload();
	
	InformationRegisters.LocationOfLaunchedLotAndStagesInOrderStructure.RecordNewLotReferences(Table);
	
EndProcedure

