	AttributesList.Add(CheckParameters);
	
	
	CheckParameters = ParametersForVerifyingBankingDetails("Purpose", "NonGivingAppointmentHasBeenSelected");
	CheckParameters.MessageTemplate = NStr("vi = 'Cần chọn mục đích của người đặt gia công khi sản xuất từ nguyên vật liệu gia công (dòng %1 của danh sách ""%2"").';
											|ru = 'Необходимо выбрать назначение давальца при производстве из давальческого сырья (строка %1 списка ""%2"").';
											|en = 'Select the provider assignment for subcontracting (line %1 of the ""%2"" list).'; fa = 'Select the provider assignment for subcontracting (line %1 of the ""%2"" list).';
											|it = 'È necessario selezionare l''assegnazione del fornitore durante la produzione da materie prime del fornitore (stringa %1 dell''elenco ""%2"").';
											|pl = 'Należy wybrać przeznaczenie powierzone w przy produkcji z surowców przekazanych przez właściciela surowców (wiersz %1 listy ""%2"").';
											|tr = 'Tedarikçi hammaddelerinden üretirken tedarikçi atamasını seçmeniz gerekmektedir (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	QueryTextTTTableOfGoods = 
	"SELECT
	|	TabularSection.Ref			AS Ref,
	|	TabularSection.LineNumber		LineNumber,
	|	TabularSection.ProductionDate	AS Period,
	|	TabularSection.Products		AS Products,
	|	ManufacturersOfExcisableItems.Country AS Country,
	|	ISNULL(ManufacturersOfExcisableItems.ProducesExcisableGoods, FALSE) AS ProducesExcisableGoods
	|INTO TTTableOfGoods
	|FROM
	|	ManufacturedProducts AS TabularSection
	|		INNER JOIN Catalog.Products AS CatalogProducts
	|		ON TabularSection.Products = CatalogProducts.Ref
	|		
	|		LEFT JOIN Catalog.Assignments AS CatalogAssignments
	|		ON TabularSection.Purpose = CatalogAssignments.Ref
	|		
	|		INNER JOIN ttCompaniesData AS OrganizationData_
	|		ON TabularSection.Ref = OrganizationData_.Ref
	|			AND TabularSection.LineNumber = OrganizationData_.LineNumber
	|		
	|		LEFT JOIN TTManufacturersOfExcisableItems AS ManufacturersOfExcisableItems
	|		ON OrganizationData_.Organization = ManufacturersOfExcisableItems.Organization
	|			AND OrganizationData_.Period = ManufacturersOfExcisableItems.Period
	|
	|WHERE
	|	CatalogProducts.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|	AND NOT (ISNULL(CatalogAssignments.AssignmentType, VALUE(Enum.AssignmentTypes.EmptyRef)) IN (
	|				VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22),
	|				VALUE(Enum.AssignmentTypes.Giveaway2_5))
	|	)";
	
	QueryTextCheckResult = 
	"SELECT
	|	TableOfGoods.Ref			AS Ref,
	|	TableOfGoods.LineNumber		LineNumber,
	|	TableOfGoods.ProducesExcisableGoods AS ProducesExcisableGoods,
	|	ISNULL(Category_Data.ExcisableGoods, FALSE) AS ExcisableGoods
	|INTO TableOfGoods
	|FROM
	|	TTTableOfGoods AS TableOfGoods
	|		LEFT JOIN TTExciseCategoriesOfItems AS Category_Data
	|		ON TableOfGoods.Products = Category_Data.Products
	|			AND TableOfGoods.Country = Category_Data.Country
	|			AND TableOfGoods.Period = Category_Data.Period
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ttCompaniesData
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTTableOfGoods
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.LineNumber,
	|	NestedQuery.WorksAreForbiddenToReleaseToWarehouse,
	|	NestedQuery.ItIsForbiddenToSelectRetailWarehouse,
	|	NestedQuery.ProductsNotFilledIn,
	|	NestedQuery.CharacteristicNotFilledIn_,
	|	NestedQuery.RecipientNotFilledIn,
	|	NestedQuery.AppointmentNotFilled,
	|	NestedQuery.AssignmentCoincidesWithStage,
	|	NestedQuery.CostFractionNotFilledIn,
	|	NestedQuery.ProducedNotFilled,
	|	NestedQuery.ProductionDateNotFilledIn,
	|	NestedQuery.DateOfQualityConfirmationIsNotFilledIn AS DateOfQualityConfirmationIsNotFilledIn,
	|	NestedQuery.QualityConfirmationDateIsLessThanProductionDate AS QualityConfirmationDateIsLessThanProductionDate,
	|	NestedQuery.NumberOfPackagesNotFilled,
	|	NestedQuery.QuantityNotFilled,
	|	NestedQuery.NoSelectionBasedOnGTD_OperationAllowed,
	|	NestedQuery.SelectionOfExcisableItemsIsProhibited,
	|	NestedQuery.CalculationArticleNotFilledIn,
	|	NestedQuery.ProductOwnerIsNotFilledIn,
	|	NestedQuery.ProductionDateIsLessThanActualStartOfStage,
	|	NestedQuery.ProductionDateIsLongerThanActualEndOfStage,
	|	NestedQuery.ReasonForCancellationNotFilledIn,
	|	NestedQuery.AssignmentAgreementSubdivisionNotFilledIn,
	|	NestedQuery.YouCanNotChooseGiverAppointment,
	|	NestedQuery.GivingAppointmentIsNotFilledIn,
	|	NestedQuery.NonGivingAppointmentHasBeenSelected
	|FROM
	|	(SELECT
	|		TabularSection.LineNumber AS LineNumber,
	|		CASE
	|			WHEN NOT (&UseTraceableImportedGoodsAccounting
	|						AND ISNULL(CatalogProducts.TracedGoods, FALSE))
	|					AND &RestrictTransactionsWithImportedGoodsWithoutCCDNumbers
	|					AND ISNULL(CatalogProducts.KeepRecordsByCCD, FALSE)
	|					AND ISNULL(CatalogProducts.ItemsType, UNDEFINED) IN(
	|									VALUE(Enum.ItemsTypes.OwnGoods),
	|									VALUE(Enum.ItemsTypes.ReusablePackage))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NoSelectionBasedOnGTD_OperationAllowed,
	|		CASE
	|			WHEN TableOfGoods.ExcisableGoods
	|					AND NOT TableOfGoods.ProducesExcisableGoods
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS SelectionOfExcisableItemsIsProhibited,
	|		CASE
	|			WHEN TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductsNotFilledIn,
	|		CASE
	|			WHEN &ItemVariantsAreUsed
	|				AND TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND CAST(TabularSection.Products AS Catalog.Products).UseVariants IN (
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|						VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems),
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CharacteristicNotFilledIn_,
	|		CASE
	|			WHEN TabularSection.Products <> VALUE(Catalog.Products.EmptyRef)
	|					AND CAST(TabularSection.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|					AND TabularSection.Recipient REFS Catalog.Warehouses
	|					AND TabularSection.Recipient <> VALUE(Catalog.Warehouses.EmptyRef)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS WorksAreForbiddenToReleaseToWarehouse,
	|		CASE
	|			WHEN TableOfGoods.ExcisableGoods
	|					AND TableOfGoods.ProducesExcisableGoods
	|					AND ISNULL(CatalogWarehouses.WarehouseStore, UNDEFINED) = VALUE(Enum.TypesOfWarehouses.RetailStore)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ItIsForbiddenToSelectRetailWarehouse,
	|		CASE
	|			WHEN TabularSection.Recipient IN (
	|							UNDEFINED, 
	|							VALUE(Catalog.Warehouses.EmptyRef), 
	|							VALUE(Catalog.BusinessStructure.EmptyRef))
	|					AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|					AND NOT TabularSection.ToExpenseAs
	|					AND NOT TabularSection.Canceled
	|					AND (NOT StageDetails_.LeaveProductsAtSubcontractor
	|						OR CAST(TabularSection.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.Work_5))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS RecipientNotFilledIn,
	|		CASE
	|			WHEN (TabularSection.Manufactured
	|						AND TabularSection.ProcessByBOM
	|					OR TabularSection.StageConsumer <> VALUE(Document.ProductionStage2_2.EmptyRef)
	|						AND StageDetails_.ReferenceOrder.DisabledAssignmentByProductionStageForIntermediateProducts)
	|				AND TabularSection.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS AppointmentNotFilled,
	|		CASE
	|			WHEN NOT TabularSection.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|				AND TabularSection.Purpose = StageDetails_.Purpose
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS AssignmentCoincidesWithStage,
	|		CASE
	|			WHEN TabularSection.CostShare = 0
	|					AND StageDetails_.MethodOfAllocatingFinishedProductCosts IN (
	// method ""By shares of the cost"" is checked separately
	|								VALUE(Enum.MethodsOfCostAllocatingOnProductCosts.ByCount),
	|								VALUE(Enum.MethodsOfCostAllocatingOnProductCosts.ByTargetCost),
	|								VALUE(Enum.MethodsOfCostAllocatingOnProductCosts.ByWeight),
	|								VALUE(Enum.MethodsOfCostAllocatingOnProductCosts.ByVolume))
	|					AND NOT TabularSection.Canceled
	|					AND NOT &CheckingSideRelease
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CostFractionNotFilledIn,
	|		CASE
	|			WHEN NOT TabularSection.Manufactured
	|					AND StageDetails_.Status IN (VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT TabularSection.Canceled
	|					AND NOT StageDetails_.ProductionByThirdParty
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProducedNotFilled,
	|		CASE
	|			WHEN (TabularSection.ProductionDate = DATETIME(1,1,1)
	|					AND (NOT StageDetails_.ProductionByThirdParty
	|						AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|						OR StageDetails_.ProductionByThirdParty
	|							AND ISNULL(AttributesOfOrdersToProcessor.Status, VALUE(Enum.TollingOrderStatuses.EmptyRef)) IN (
	|										VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|										VALUE(Enum.TollingOrderStatuses.Closed))
	|							AND ISNULL(AttributesOfOrdersToProcessor.Posted, FALSE)
	|					)
	|					AND NOT TabularSection.Canceled
	|					AND NOT StageDetails_.ProductionInOneDay
	|			)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductionDateNotFilledIn,
	|		TabularSection.ToControlQuality
	|			AND NOT TabularSection.ProductionDate = DATETIME(1,1,1)
	|			AND TabularSection.QualityConfirmationDate = DATETIME(1, 1, 1)
	|			AND NOT TabularSection.Canceled AS DateOfQualityConfirmationIsNotFilledIn,
	|		TabularSection.ToControlQuality
	|			AND NOT TabularSection.QualityConfirmationDate = DATETIME(1, 1, 1)
	|			AND TabularSection.QualityConfirmationDate < TabularSection.ProductionDate
	|			AND NOT TabularSection.Canceled AS QualityConfirmationDateIsLessThanProductionDate,
	|		CASE
	|			WHEN TabularSection.NumberOfPackages = 0
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NumberOfPackagesNotFilled,
	|		CASE
	|			WHEN TabularSection.Count = 0 AND TabularSection.NumberOfPackages <> 0
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS QuantityNotFilled,
	|		CASE
	|			WHEN TabularSection.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT TabularSection.Canceled
	|					AND &CheckingSideRelease
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CalculationArticleNotFilledIn,
	|		CASE
	|			WHEN &CheckingSideRelease
	|				AND StageDetails_.InternalSubcontracting
	|				AND NOT TabularSection.Canceled
	|				AND TabularSection.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
	|				AND NOT ISNULL(TabularSection.Purpose.AssignmentType, VALUE(Enum.AssignmentTypes.EmptyRef)) IN (
	|						VALUE(Enum.AssignmentTypes.Giveaway21),
	|						VALUE(Enum.AssignmentTypes.ProvidedMaterials22),
	|						VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22),
	|						VALUE(Enum.AssignmentTypes.SuppliedProducts22),
	|						VALUE(Enum.AssignmentTypes.Giveaway2_5))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductOwnerIsNotFilledIn,
	|		CASE
	|			WHEN TabularSection.ProductionDate <> DATETIME(1, 1, 1)
	|					AND TabularSection.ProductionDate < BEGINOFPERIOD(StageDetails_.ActualStageStart, DAY)
	|					AND NOT TabularSection.Canceled
	|					AND TabularSection.Manufactured
	|					AND NOT StageDetails_.ProductionInOneDay
	|					AND NOT StageDetails_.ProductionByThirdParty
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductionDateIsLessThanActualStartOfStage,
	|		CASE
	|			WHEN TabularSection.ProductionDate <> DATETIME(1, 1, 1)
	|					AND TabularSection.ProductionDate > StageDetails_.ActualStageEnd 
	|					AND NOT TabularSection.Canceled
	|					AND TabularSection.Manufactured
	|					AND NOT StageDetails_.ProductionInOneDay
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductionDateIsLongerThanActualEndOfStage,
	|		CASE
	|			WHEN TabularSection.Canceled
	|					AND TabularSection.CancellationReason = VALUE(Catalog.ReasonsForProductionCancellation.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ReasonForCancellationNotFilledIn,
	|		CASE
	|			WHEN TRUE
	|				THEN FALSE
	|		END AS AssignmentAgreementSubdivisionNotFilledIn,
	|		CASE
	|			WHEN StageDetails_.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
	|				AND NOT StageDetails_.BusinessOperation IN (
	|					VALUE(Enum.BusinessTransactions.TollManufacturing2_5))
	|				AND NOT TabularSection.Canceled
	|				AND TabularSection.Purpose.AssignmentType IN(
	|					VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22),
	|					VALUE(Enum.AssignmentTypes.Giveaway2_5))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS YouCanNotChooseGiverAppointment,
	|		CASE
	|			WHEN TabularSection.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|				AND StageDetails_.BusinessOperation IN(
	|					VALUE(Enum.BusinessTransactions.TollManufacturing2_5))
	|				AND NOT TabularSection.Canceled
	|				AND NOT CAST(TabularSection.Products AS Catalog.Products).ItemsType =
	|						VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND NOT &CheckingSideRelease
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS GivingAppointmentIsNotFilledIn,
	|		CASE
	|			WHEN TabularSection.Purpose <> VALUE(Catalog.Assignments.EmptyRef)
	|				AND StageDetails_.BusinessOperation =
	|					VALUE(Enum.BusinessTransactions.TollManufacturing2_5)
	|				AND NOT TabularSection.Purpose.AssignmentType IN(
	|						VALUE(Enum.AssignmentTypes.Giveaway2_5),
	|						VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22))
	|				AND NOT TabularSection.Canceled
	|				AND NOT &CheckingSideRelease
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NonGivingAppointmentHasBeenSelected
	|	FROM
	|		ManufacturedProducts AS TabularSection
	|			LEFT JOIN Catalog.Products AS  CatalogProducts
	|			ON TabularSection.Products = CatalogProducts.Ref
	|			
	|			LEFT JOIN Catalog.Warehouses AS CatalogWarehouses
	|			ON TabularSection.Recipient = CatalogWarehouses.Ref
	|			
	|			LEFT JOIN StageDetails_ AS StageDetails_
	|			ON StageDetails_.Ref = TabularSection.Ref
	|			
	|			LEFT JOIN AttributesOfOrdersToProcessor AS AttributesOfOrdersToProcessor
	|			ON AttributesOfOrdersToProcessor.SubcontractOrder = StageDetails_.SubcontractOrder
	|			
	|			LEFT JOIN TableOfGoods AS TableOfGoods
	|			ON TabularSection.Ref = TableOfGoods.Ref
	|				AND TabularSection.LineNumber = TableOfGoods.LineNumber
	|		
	|	) AS NestedQuery
	|WHERE
	|	(NestedQuery.WorksAreForbiddenToReleaseToWarehouse
	|			OR NestedQuery.ItIsForbiddenToSelectRetailWarehouse
	|			OR NestedQuery.ProductsNotFilledIn
	|			OR NestedQuery.CharacteristicNotFilledIn_
	|			OR NestedQuery.RecipientNotFilledIn
	|			OR NestedQuery.AppointmentNotFilled
	|			OR NestedQuery.AssignmentCoincidesWithStage
	|			OR NestedQuery.CostFractionNotFilledIn
	|			OR NestedQuery.ProducedNotFilled
	|			OR NestedQuery.ProductionDateNotFilledIn
	|			OR NestedQuery.NumberOfPackagesNotFilled
	|			OR NestedQuery.QuantityNotFilled
	|			OR NestedQuery.NoSelectionBasedOnGTD_OperationAllowed
	|			OR NestedQuery.SelectionOfExcisableItemsIsProhibited
	|			OR NestedQuery.DateOfQualityConfirmationIsNotFilledIn
	|			OR NestedQuery.QualityConfirmationDateIsLessThanProductionDate
	|			OR NestedQuery.CalculationArticleNotFilledIn
	|			OR NestedQuery.ProductOwnerIsNotFilledIn
	|			OR NestedQuery.ProductionDateIsLessThanActualStartOfStage
	|			OR NestedQuery.ProductionDateIsLongerThanActualEndOfStage
	|			OR NestedQuery.ReasonForCancellationNotFilledIn
	|			OR NestedQuery.AssignmentAgreementSubdivisionNotFilledIn
	|			OR NestedQuery.YouCanNotChooseGiverAppointment
	|			OR NestedQuery.GivingAppointmentIsNotFilledIn
	|			OR NestedQuery.NonGivingAppointmentHasBeenSelected
	|	)
	|
	|ORDER BY
	|	NestedQuery.LineNumber";
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	
	Query.SetParameter(
		"ItemVariantsAreUsed",
		GetFunctionalOption("UseItemVariants"));
	
	Query.SetParameter(
		"UseTraceableImportedGoodsAccounting",
		AccountingForTraceableGoodsLocalization.UseTraceableImportedGoodsAccounting(Date(1, 1, 1)));
	
	Query.SetParameter(
		"RestrictTransactionsWithImportedGoodsWithoutCCDNumbers",
		GetFunctionalOption("RestrictTransactionsWithImportedGoodsWithoutCCDNumbers"));
	
	Query.SetParameter(
		"BatchModeOfFormationOfStages",
		Not TypeOf(Object) = Type("Structure")
		And Common.IsDocument(Object.Metadata())
		And ProductionManagement.BatchFormationOfStagesIsPerformed(Object));
	
	Query.SetParameter(
		"MainCountry",
		SettingsValueClientServerCached.MainCountry());
	
	Query.SetParameter(
		"UseExcisableGoods",
		GetFunctionalOption("UseExcisableGoods"));
	
	AccountingForTraceableGoodsLocalization.SetParametersForUsingTrackingOfTraceableGoods(Query);
	
	If CheckingOutputProducts Then
		RequestTextParameters = ExcisableGoodsAccounting.ParametersOfQueryTextTTExciseCategoriesOfItems();
		RequestTextParameters.SelectingCategoriesByDate	= False;
		RequestTextParameters.ProductTableName_	= "TTTableOfGoods";
		RequestTextParameters.CountryWH			= True;
		
		QueryTexts = New Array;
		
		PartOfTheRequestText = 
		"SELECT
		|	TabularSection.Ref			AS Ref,
		|	TabularSection.LineNumber		AS LineNumber,
		|	TabularSection.ProductionDate	AS Period,
		|	CASE
		|		WHEN StageDetails_.InternalSubcontracting
		|			THEN StageDetails_.MaterialProviderCompany
		|		ELSE StageDetails_.Organization
		|	END							AS Organization
		|INTO ttCompaniesData
		|FROM
		|	ManufacturedProducts AS TabularSection
		|		LEFT JOIN StageDetails_ AS StageDetails_
		|		ON TabularSection.Ref = StageDetails_.Ref
		|WHERE
		|	NOT StageDetails_.ProductionByThirdParty2_5
		|
		|INDEX BY
		|	Period,
		|	Organization";
		QueryTexts.Add(PartOfTheRequestText);
		QueryTexts.Add(ExcisableGoodsAccounting.QueryTextManufacturersOfExcisableItems(
								TempTablesManager,
								"ttCompaniesData"));
		
		Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
		
		SetPrivilegedMode(True);
		Query.Execute();
		SetPrivilegedMode(False);
		
		QueryTexts.Clear();
		QueryTexts.Add(QueryTextTTTableOfGoods);
		QueryTexts.Add(ExcisableGoodsAccounting.QueryTextTTExciseCategoriesOfItems(
								TempTablesManager,
								RequestTextParameters));
		QueryTexts.Add(QueryTextCheckResult);
		
		Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
		
		Query.SetParameter("CheckingSideRelease", False);
		
		Selection = Query.Execute().Select();
		
		NotifyFillErrors(Object, Selection, AttributesList, "ManufacturedProducts", Cancel);
		
	EndIf;
	
	If InspectByProducts Then
		If TempTablesManager.Tables.Find("TableOfGoods") <> Undefined Then
			Query.Text = "DROP TableOfGoods";
			
			Query.Execute();
		EndIf;
		
		RequestTextParameters = ExcisableGoodsAccounting.ParametersOfQueryTextTTExciseCategoriesOfItems();
		RequestTextParameters.SelectingCategoriesByDate	= False;
		RequestTextParameters.ProductTableName_	= "TTTableOfGoods";
		RequestTextParameters.CountryWH			= True;
		
		QueryTexts = New Array;
		
		PartOfTheRequestText = 
		"SELECT
		|	TabularSection.Ref			AS Ref,
		|	TabularSection.LineNumber		AS LineNumber,
		|	TabularSection.ProductionDate	AS Period,
		|	CASE
		|		WHEN NOT TabularSection.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
		|			THEN TabularSection.ProductOwner
		|		WHEN StageDetails_.InternalSubcontracting
		|			THEN StageDetails_.MaterialProviderCompany
		|		ELSE StageDetails_.Organization
		|	END							AS Organization
		|INTO ttCompaniesData
		|FROM
		|	SideAndIntermediateRelease AS TabularSection
		|		LEFT JOIN StageDetails_ AS StageDetails_
		|		ON TabularSection.Ref = StageDetails_.Ref
		|WHERE
		|	NOT StageDetails_.ProductionByThirdParty2_5
		|
		|INDEX BY
		|	Period,
		|	Organization";
		QueryTexts.Add(PartOfTheRequestText);
		QueryTexts.Add(ExcisableGoodsAccounting.QueryTextManufacturersOfExcisableItems(
								TempTablesManager,
								"ttCompaniesData"));
		
		Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
		
		SetPrivilegedMode(True);
		Query.Execute();
		SetPrivilegedMode(False);
		
		QueryTexts.Clear();
		QueryTexts.Add(QueryTextTTTableOfGoods);
		QueryTexts.Add(ExcisableGoodsAccounting.QueryTextTTExciseCategoriesOfItems(
								TempTablesManager,
								RequestTextParameters));
		QueryTexts.Add(QueryTextCheckResult);
		
		Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
		Query.Text = StrReplace(Query.Text, "ManufacturedProducts AS TabularSection", "SideAndIntermediateRelease AS TabularSection");
		
		Query.SetParameter("CheckingSideRelease", True);
		
		Selection = Query.Execute().Select();
		
		NotifyFillErrors(Object, Selection, AttributesList, "SideAndIntermediateRelease", Cancel);
		
	EndIf;
	
EndProcedure

