		|		Stages.ProductionLot
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		Stages.ProductionLot                                                  AS ProductionLot,
		|		Stages.ProductionLot.MainProductProducts                      AS Products,
		|		Stages.ProductionLot.MainProductCharacteristic                    AS Characteristic,
		|		SUM(Products_1.Count)                                                 AS NumberOfTS,
		|		0                                                                         AS NumberOfCaps
		|	FROM
		|		Document.ProductionStage2_2 AS Stages
		|			INNER JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS Products_1
		|				ON Products_1.Ref = Stages.Ref
		|				AND Products_1.Products = Stages.ProductionLot.MainProductProducts
		|				AND Products_1.Characteristic = Stages.ProductionLot.MainProductCharacteristic
		|	WHERE
