// Returns normative specification data for the specified batch.
// 
// Parameters:
//  ProductionLot - See ProductionBatchData
//  ReceiveMaterialsOnDemand - Boolean
//  ListOfData - String
//  Filter - Structure
// 
// Returns:
//  See Catalogs.BillsOfMaterials.DataSpecificationConstructor.
//
Function GetStandardsForSpecifications(ProductionLot, ReceiveMaterialsOnDemand, ListOfData = Undefined, Filter = Undefined) Export
	
	If ProductionLot.Count = 0
		Or ProductionLot.Products.IsEmpty()
		Or ProductionLot.BillOfMaterials.IsEmpty() Then
		Return Undefined;
	EndIf;
	
	// The initial/final operation of the stages
	Query = New Query(
		"SELECT
		|	Document.Stage                             AS Stage,
		|	TechnicalProcess.FirstOperationID    AS FirstOperationID,
		|	TechnicalProcess.LastOperationID AS LastOperationID,
		|	TechnicalProcess.CanceledLastOperation      AS CanceledLastOperation
		|FROM
		|	Document.ProductionStage2_2 AS Document
		|	
		|	INNER JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcess
		|	ON Document.Ref = TechnicalProcess.Stage
		|		AND (TechnicalProcess.FirstOperationID > 0
		|				OR TechnicalProcess.LastOperationID > 0
		|				OR TechnicalProcess.CanceledLastOperation > 0)
		|WHERE
		|	Document.ProductionLot = &ProductionLot
		|	AND Document.Posted
		|	AND (&AllStages OR Document.Stage = &Stage)");
	Query.SetParameter("ProductionLot", ProductionLot.ProductionLot);
	If TypeOf(Filter) = Type("Structure") And Filter.Property("Stage") Then
		Query.SetParameter("AllStages", False);
		Query.SetParameter("Stage", Filter.Stage);
	Else
		Query.SetParameter("AllStages", True);
		Query.SetParameter("Stage", Undefined);
	EndIf;
	SelectionOfRestrictionsOnOperations = Query.Execute().Select();
	
	// Getting Specification data
	ItemData_3 = Catalogs.BillsOfMaterials.ProductData_5();
	
	FillPropertyValues(ItemData_3, ProductionLot,
		"ReferenceOrder, ProductionStart, ProductionDispatcherBusinessUnit, LineOfBusiness, BillOfMaterials, Products, Characteristic, Count");
	
	TempTablesManager = New TempTablesManager;
	
	Documents.ProductionOrder2_2.CreateTTWaysToGetMaterials2_2(
		TempTablesManager,
		ProductionLot.ReferenceOrder);
	
	SelectionParameters = Catalogs.BillsOfMaterials.DataSamplingParameters(
		ListOfData,
		TempTablesManager);
	
	SelectionParameters.CombineMaterialsAndIncomingProducts = True;
	SelectionParameters.CombineMaterialsAndWorksPerformed = True;
	SelectionParameters.MethodOfCalculationOfMaterials = ?(ReceiveMaterialsOnDemand,
		Enums.MaterialCalculationMethods.MaximumConsumption,
		Enums.MaterialCalculationMethods.MinimumConsumption);
	SelectionParameters.CalculateShareOfCostOfOutputProducts = True;
	SelectionParameters.OverridingReleasePartySetting.Use = True;
	SelectionParameters.OverridingReleasePartySetting.ProductionIssueByCustomPortions = True;
	SelectionParameters.IntermediateSemiFinishedProducts = ProductDataManagementClientServer.IntermediateSemiFinishedProductsGet();
	
	If SelectionOfRestrictionsOnOperations.Count() > 0
		And SelectionParameters.ListOfData.Find("Operations") = Undefined Then
		SelectionParameters.ListOfData.Add("Operations");
	EndIf;
	
	SpecificationData = Catalogs.BillsOfMaterials.SpecificationDataByProducts(
		ItemData_3,
		SelectionParameters,
		Filter);
	
	If ProductionLot.DynamicStructure Then
		// There are no semi-finished products produced in the process
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("ProducedInProcess", True);
		For Each String In SpecificationData.MaterialsAndServices.FindRows(TheStructureOfTheSearch) Do
			String.ProducedInProcess = False;
			String.Produced = False;
			String.MethodOfReceivingMaterial = Enums.MethodsOfReceivingBOMMaterials.Provide;
		EndDo;
	Else
		// The semi-finished products produced are provided separately
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("ProducedInProcess", True);
		TheStructureOfTheSearch.Insert("MethodOfReceivingMaterial", Enums.MethodsOfReceivingBOMMaterials.ProduceByBillsOfMaterials);
		TheStructureOfTheSearch.Insert("WithAssignment", False);
		For Each String In SpecificationData.MaterialsAndServices.FindRows(TheStructureOfTheSearch) Do
			String.WithAssignment = True;
		EndDo;
	EndIf;
	
	// Reduction of transaction data
	If SelectionOfRestrictionsOnOperations.Count() > 0 Then
		
		SpecificationData.Operations.Indexes.Add("Stage, NextOperation");
		SpecificationData.Operations.Indexes.Add("Stage, OperationNumber");
		
		TablesNames = StrSplit("MaterialsAndServices,ManufacturedProducts,RecyclableWaste,LaborCosts", ",");
		RowsOfTablesToBeProcessed = New Map;
		For Each Table In TablesNames Do
			If Not SpecificationData.Property(Table) Then
				Continue;
			EndIf;
			SpecificationData[Table].Indexes.Add("Stage, Operation");
			RowsOfTablesToBeProcessed.Insert(Table, New Array);
		EndDo;
		
		SearchStructureOperation = New Structure("Stage, OperationID");
		StructureOfSearchPredecessors = New Structure("Stage, NextOperation");
		SearchStructureFollowers = New Structure("Stage, OperationNumber");
		SearchStructureOperationData = New Structure("Stage, Operation");
		
		While SelectionOfRestrictionsOnOperations.Next() Do
			
			SearchStructureOperation.Stage = SelectionOfRestrictionsOnOperations.Stage;
			StructureOfSearchPredecessors.Stage = SelectionOfRestrictionsOnOperations.Stage;
			SearchStructureFollowers.Stage = SelectionOfRestrictionsOnOperations.Stage;
			SearchStructureOperationData.Stage = SelectionOfRestrictionsOnOperations.Stage;
			
			If SelectionOfRestrictionsOnOperations.FirstOperationID <> 0 Then
				SearchStructureOperation.OperationID = SelectionOfRestrictionsOnOperations.FirstOperationID;
				FoundRows = SpecificationData.Operations.FindRows(SearchStructureOperation);
				If FoundRows.UBound() <> -1 Then
					StructureOfSearchPredecessors.NextOperation = FoundRows[0].OperationNumber;
					OperationQueue = SpecificationData.Operations.FindRows(StructureOfSearchPredecessors);
					While OperationQueue.UBound() <> -1 Do
						LineOperation = OperationQueue[0];
						SearchStructureOperationData.Operation = LineOperation.Operation;
						
						For Each Table In TablesNames Do
							If Not SpecificationData.Property(Table) Then
								Continue;
							EndIf;
							For Each String In SpecificationData[Table].FindRows(SearchStructureOperationData) Do
								SpecificationData[Table].Delete(String);
							EndDo;
						EndDo;
						
						StructureOfSearchPredecessors.NextOperation = LineOperation.OperationNumber;
						For Each String In SpecificationData.Operations.FindRows(StructureOfSearchPredecessors) Do
							OperationQueue.Add(String);
						EndDo;
						
						OperationQueue.Delete(0);
					EndDo;
				EndIf;
			EndIf;
			
			If SelectionOfRestrictionsOnOperations.LastOperationID <> 0 Then
				SearchStructureOperation.OperationID = SelectionOfRestrictionsOnOperations.LastOperationID;
				FoundRows = SpecificationData.Operations.FindRows(SearchStructureOperation);
				If FoundRows.UBound() <> -1 Then
					LastOperation_ = FoundRows[0];
					
					// Deleting the data of subsequent operations
					SearchStructureFollowers.OperationNumber = LastOperation_.NextOperation;
					OperationQueue = SpecificationData.Operations.FindRows(SearchStructureFollowers);
					While OperationQueue.UBound() <> -1 Do
						LineOperation = OperationQueue[0];
						SearchStructureOperationData.Operation = LineOperation.Operation;
						
						For Each Table In TablesNames Do
							If Not SpecificationData.Property(Table) Then
								Continue;
							EndIf;
							For Each String In SpecificationData[Table].FindRows(SearchStructureOperationData) Do
								SpecificationData[Table].Delete(String);
							EndDo;
						EndDo;
						
						SearchStructureFollowers.OperationNumber = LineOperation.NextOperation;
						For Each String In SpecificationData.Operations.FindRows(SearchStructureFollowers) Do
							OperationQueue.Add(String);
						EndDo;
						
						OperationQueue.Delete(0);
					EndDo;
					
					// Reduction (deletion) of the data of the last operation
					If SelectionOfRestrictionsOnOperations.CanceledLastOperation <> 0 Then
						SearchStructureOperationData.Operation = LastOperation_.Operation;
						If SelectionOfRestrictionsOnOperations.CanceledLastOperation >= LastOperation_.QuantityPerBatch Then
							// Delete
							For Each Table In TablesNames Do
								If Not SpecificationData.Property(Table) Then
									Continue;
								EndIf;
								For Each String In SpecificationData[Table].FindRows(SearchStructureOperationData) Do
									SpecificationData[Table].Delete(String);
								EndDo;
							EndDo;
						ElsIf LastOperation_.QuantityPerBatch <> 0 Then
							// Abbr
							Numerator = LastOperation_.QuantityPerBatch - SelectionOfRestrictionsOnOperations.CanceledLastOperation;
							Denominator = LastOperation_.QuantityPerBatch;
							For Each Table In TablesNames Do
								If Not SpecificationData.Property(Table) Then
									Continue;
								EndIf;
								For Each String In SpecificationData[Table].FindRows(SearchStructureOperationData) Do
									String.Count = String.Count * Numerator / Denominator;
									If String.Count = 0 Then
										SpecificationData[Table].Delete(String);
									ElsIf Table <> "LaborCosts" Then
										RowsOfTablesToBeProcessed[Table].Add(String);
									EndIf;
								EndDo;
							EndDo;
						EndIf;
					EndIf;
				EndIf;
			EndIf;
		EndDo;
		
		StructureOfActions = New Structure("RecalculateNumberOfPackages");
		CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
		For Each KeyAndValue In RowsOfTablesToBeProcessed Do
			BatchProcessingOfTablePartServer.ProcessTSStrings(
				KeyAndValue.Value,
				StructureOfActions,
				SpecificationData[KeyAndValue.Key],
				CachedValues);
		EndDo;
		
	EndIf;
	
	Return SpecificationData;
	
EndFunction

Procedure AdjustTables(SourceTable_, AdjustmentTable, FilterStructure1, FilterFields = Undefined)
	
	CurAdjustmentIndex      = 0;
	MaximumAdjustmentIndex = AdjustmentTable.Count() - 1;
	While MaximumAdjustmentIndex > -1 Do
		
		Adjusting = AdjustmentTable[CurAdjustmentIndex];
		
		FillPropertyValues(FilterStructure1, Adjusting, FilterFields);
		
		OriginalLines          = SourceTable_.FindRows(FilterStructure1);
		MaximumRowIndex = OriginalLines.UBound();
		While MaximumRowIndex > -1 Do
			
			InitialString = OriginalLines[0];
			
			Count = Min(InitialString.Count, Adjusting.Count);
			
			Adjusting.Count  = Adjusting.Count  - Count;
			InitialString.Count = InitialString.Count - Count;
			
			If InitialString.Count > 0 Then
				Break;
			Else
				OriginalLines.Delete(0);
				SourceTable_.Delete(InitialString);
			EndIf;
			
			If Adjusting.Count = 0 Then
				Break;
			EndIf;
			
			MaximumRowIndex = MaximumRowIndex - 1;
			
		EndDo;
		
		If Adjusting.Count > 0 Then
			CurAdjustmentIndex = CurAdjustmentIndex + 1;
		Else
			AdjustmentTable.Delete(Adjusting);	
		EndIf;
		
		MaximumAdjustmentIndex = MaximumAdjustmentIndex - 1;
		
	EndDo;
	
EndProcedure

Procedure AllocateQuantity(SourceTable1, DestinationTable, FilterStructure1, Count)
	
	FoundRows = SourceTable1.FindRows(FilterStructure1);
	For Each SourceRow In FoundRows Do
		
		DestinationRow = DestinationTable.Add();
		
		FillPropertyValues(DestinationRow, SourceRow,, "Count");
		DestinationRow.Count = Min(Count, SourceRow.Count);
				
		Count = Count - DestinationRow.Count;
		SourceRow.Count = SourceRow.Count - DestinationRow.Count;
				
		If SourceRow.Count = 0 Then
			SourceTable1.Delete(SourceRow);
		EndIf;
		
		If Count = 0 Then
			Break;
		EndIf;
		
	EndDo;
	
EndProcedure

Function MarkOfPerformedLaborCostsIsUsed(Object) Export
	
	If Not Object.OperationAsOutputReference Then
		Return True;
	EndIf;
	
	DivisionParameters = ProductionServerCached.ProductionBusinessUnitDescription(Object.Department);
	UseOperationManagement = DivisionParameters.UseOperationManagement;
	
	If Not UseOperationManagement Then
		Return True;
	EndIf;
	
	Return False;
	
EndFunction

