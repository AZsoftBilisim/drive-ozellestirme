// Returns the provided stage materials minus the consumed materials.
//
// Parameters:
//  Stage - DocumentRef.ProductionStage2_2 - stage of production.
//	ViewPoints - String - a comma-separated list of fields where you want to get the remainder.
//		Acceptable values: Characteristic, Series. If not passed, the data is obtained only
//		by item.
//
// Returns:
//  ValueTable - tables with materials.
//
Function ResiduesOfProvidedMaterials(Stage, ViewPoints = Undefined) Export
	
	QueryText =
	"SELECT
	|	TabularSection.Products,
	|	&TextAdditionalFieldsSelection,
	|	MAX(TabularSection.Package) AS Package,
	|	SUM(TabularSection.Count) AS Count
	|INTO TTSoftware
	|FROM
	|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS TabularSection
	|WHERE
	|	TabularSection.Ref = &Stage
	|	AND NOT TabularSection.Canceled
	|
	|GROUP BY
	|	TabularSection.Products,
	|	&TextAdditionalFieldsGrouping
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TabularSection.Products,
	|	&TextAdditionalFieldsSelection,
	|	SUM(TabularSection.Count) AS Count
	|INTO TTExpense
	|FROM
	|	Document.ProductionStage2_2.MaterialsAndWorksConsumption AS TabularSection
	|WHERE
	|	TabularSection.Ref = &Stage
	|
	|GROUP BY
	|	TabularSection.Products,
	|	&TextAdditionalFieldsGrouping
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TabularSection.Products,
	|	&TextAdditionalFieldsSelection,
	|	TabularSection.Package,
	|	TabularSection.Count - ISNULL(TTExpense.Count, 0) AS Count,
	|	TabularSection.Count - ISNULL(TTExpense.Count, 0) / ISNULL(&QueryTextPackagingFactor, 1) AS NumberOfPackages
	|FROM
	|	TTSoftware AS TabularSection
	|		LEFT JOIN TTExpense AS TTExpense
	|		ON TabularSection.Products = TTExpense.Products
	|			AND &TextAdditionalFieldsConnection
	|WHERE
	|	TabularSection.Count - ISNULL(TTExpense.Count, 0) > 0";
	
	QueryText = StrReplace(
		QueryText,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"TabularSection.Package",
			"TabularSection.Products"));
			
	TextFieldsSelection = "";
	TextFieldsDimension = "";
	ConnectionTextFields = "";
	
	If ValueIsFilled(ViewPoints) Then
		
		FieldArray = StringFunctionsClientServer.SplitStringIntoWordArray(ViewPoints, ",");
		
		For Each Field In FieldArray Do
			
			Field = TrimAll(Field);
			
			TextFieldsSelection = TextFieldsSelection
				+ "TabularSection." + Field + " AS " + Field + ",";
			
			TextFieldsDimension = TextFieldsDimension
				+ ?(ValueIsFilled(TextFieldsDimension), ", ", "")
				+ "TabularSection." + Field;
			
			ConnectionTextFields = ConnectionTextFields
				+ " AND TabularSection." + Field + " = TTExpense." + Field;
			
		EndDo;
		
	EndIf;
	
	QueryText = StrReplace(QueryText, "&TextAdditionalFieldsSelection,", TextFieldsSelection);
	QueryText = StrReplace(QueryText, "&TextAdditionalFieldsGrouping", TextFieldsDimension);
	QueryText = StrReplace(QueryText, "AND &TextAdditionalFieldsConnection", ConnectionTextFields);
	
	Query = New Query(QueryText);
	
	Query.SetParameter("Stage", Stage);
	
	Return Query.Execute().Unload();
	
EndFunction

// Returns a table for the goods of the document for the creation mechanism based on the securing order.
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - the document for which you need to get the goods
//  CreationParameters - See ProvisionInDocumentsServer.ProductSelectionParametersForCreatingSecuringOrder
//  TempTablesManager - TempTablesManager - temporary table manager where a table with columns will be created:
//   * LineNumber - Number - Line number
//   * Products - CatalogRef.Products - Products
//   * Characteristic - CatalogRef.ItemsCharacteristics - Characteristic
//   * Package - CatalogRef.PackagesAndUnitsOfMeasure - Package
//   * Warehouse - CatalogRef.Warehouses - Warehouse
//   * Department - CatalogRef.BusinessStructure - Department
//   * Purpose - CatalogRef.Assignments - Purpose
//   * SupplyOption - EnumRef.SupplyOptions - security option
//   * WithAssignment - Boolean - WithAssignment
//   * QuantityOfUnits - Number - number of units
//   * CountByDocument - Number - Number of packages
Procedure GoodsOfDocumentForCreatingSecuringOrder(Ref, CreationParameters, TempTablesManager) Export
	
	Query = New Query();
	Query.TempTablesManager = TempTablesManager;
	Query.SetParameter("ItemsTypes", CreationParameters.ItemsTypes);
	Query.SetParameter("Ref", Ref);
	Query.Text =
		"SELECT
		|	Goods.LineNumber AS LineNumber,
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.Package AS Package,
		|	Goods.Warehouse AS Warehouse,
		|	Goods.Department AS Department,
		|	CASE
		|		WHEN Goods.WithAssignment
		|			THEN
		|				Goods.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END AS Purpose,
		|	Goods.SupplyOption AS SupplyOption,
		|	Goods.WithAssignment AS WithAssignment,
