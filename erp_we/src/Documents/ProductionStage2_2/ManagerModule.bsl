// Fills in the list of print commands.
//
// Parameters:
//   PrintCommands - See PrintManagement.CreatePrintCommandsCollection
//
Procedure AddPrintCommands(PrintCommands) Export
	
	// Job on the production
	PrintCommand = PrintCommands.Add();
	PrintCommand.Id = "ProductionJob";
	PrintCommand.Presentation = NStr("vi = 'Nhiệm vụ sản xuất';
									|ru = 'Задание на производство';
									|en = 'Shop floor papers'; fa = 'برگه‌های کارگاه';
									|it = 'Task di produzione';
									|pl = 'Zadanie na produkcję';
									|tr = 'Üretim görevi'");
	PrintCommand.CheckPostingBeforePrint = True;
	PrintCommand.Handler = "PrintManagementERPClient.PrintJobForProduction";
	
	// Production batch tracking sheet
	PrintCommand = PrintCommands.Add();
	PrintCommand.Id = "ProductionBatchMaintenanceSheet";
	PrintCommand.Presentation = NStr("vi = 'Bảng kèm theo lô sản xuất';
									|ru = 'Лист сопровождения партии производства';
									|en = 'Accompanying sheet for production lot'; fa = 'برگه همراه لات تولید';
									|it = 'Foglio di accompagnamento del lotto di produzione';
									|pl = 'Arkusz prowadzenia partii produkcji';
									|tr = 'Üretim lotları eşlik listesi'");
	PrintCommand.CheckPostingBeforePrint = True;
	PrintCommand.Handler = "PrintManagementERPClient.PrintingProductionBatchSheets";
	
	DocumentStatuses = New Array;
	DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.Generated1);
	DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.ForCompletion);
	DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.Initiated);
	DocumentStatuses.Add(Enums.StatusesOfProductionStages2_2.Completed);
	
	// Assignment for the placement of goods
	PrintCommand = DataProcessors.PrintJobsForInventoryPickingPlacementAndRecount.AddPrintCommand(PrintCommands,
																							"PlacementJob");
	
	AttachableCommands.AddCommandVisibilityCondition(PrintCommand,
														"Status",
														DocumentStatuses,
														ComparisonType.InList);
	
	// Task for the selection of goods
	PrintCommand = DataProcessors.PrintJobsForInventoryPickingPlacementAndRecount.AddPrintCommand(PrintCommands,
																							"SelectionTask");
	
	AttachableCommands.AddCommandVisibilityCondition(PrintCommand,
														"Status",
														DocumentStatuses,
														ComparisonType.InList);
	
	ProductionStage2_2Localization.AddPrintCommands(PrintCommands);

EndProcedure

