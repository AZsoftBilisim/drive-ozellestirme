	WarehousesServer.ArrangeShipmentOfGoods(Query, QueryTexts, Registers, TextOfDocumentDataRequest);
	
EndProcedure

Procedure ReflectStockDistribution(Query, QueryTexts, Registers, DocumentObject)
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	Texts = New ValueList();
	
	#Region SupplyWithMaterialsAndWorks
	
	If DocumentObject = Undefined
	 Or DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.BeingGenerated
		 And DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableProvisionOfMaterialsAndWorks",
					QueryTexts,
					TempTablesManager) Then
			QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref             AS Ref,
			|	DataCaps.Date                 AS Period,
			|	TabularSection.Products       AS Products,
			|	TabularSection.Characteristic     AS Characteristic,
			|	
			|	CASE WHEN TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5) THEN
			|				TabularSection.Department
			|			ELSE
			|				TabularSection.Warehouse
			|			END AS Warehouse,
			|	
			|	CASE WHEN TabularSection.WithAssignment THEN
			|				TabularSection.Purpose
			|			ELSE VALUE(Catalog.Assignments.EmptyRef)
			|		END AS Purpose,
			|	
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.Count         AS Count,
			|	
			|	DataCaps.OrderOverride AS PlannedConsumptionOfDistributedStock,
			|	
			|	TRUE                            AS ControlOfFreeResidue
			|FROM
			|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS DataCaps
			|		ON TabularSection.Ref = DataCaps.Ref
			|WHERE
			|	NOT TabularSection.Canceled
			|		AND DataCaps.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
			|		AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)";
		
		StockAllocationRecords.StockConsumption(Query, Texts, Registers, QueryTextTabPart, False);
		
		//
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref             AS Ref,
			|	HeaderData_.Date                  AS Period,
			|	TabularSection.Products       AS Products,
			|	TabularSection.Characteristic     AS Characteristic,
			|	
			|	CASE WHEN TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5) THEN
			|			TabularSection.Department
			|		ELSE
			|			TabularSection.Warehouse
			|		END AS Warehouse,
			|	
			|	CASE WHEN TabularSection.WithAssignment THEN
			|				TabularSection.Purpose
			|			ELSE VALUE(Catalog.Assignments.EmptyRef)
			|		END AS Purpose,
			|	
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.Count         AS Count,
			|	TabularSection.SupplyOption AS SupplyOption,
			|	
			|	HeaderData_.OrderOverride  AS OrderDocument,
			|	
			|	CASE WHEN HeaderData_.NotShipInInstallments THEN
			|				HeaderData_.DateOfShipment
			|			ELSE
			|				TabularSection.DateOfShipment
			|		END AS RequestShipmentOn,
			|	FALSE AS OnSchedule,
			|	UNDEFINED AS OrderInSchedule,
			|	0 AS QuantityInGraph
			|FROM
			|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.Canceled
			|		AND HeaderData_.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
			|		AND NOT TabularSection.SupplyOption IN
			|				(VALUE(Enum.SupplyOptions.TransferedEarlier),
			|				VALUE(Enum.SupplyOptions.Ship))
			|		AND (HeaderData_.DynamicStructure
			|				AND NOT TabularSection.SupplyOption IN (
			|						VALUE(Enum.SupplyOptions.ToSupply),
			|						VALUE(Enum.SupplyOptions.NotRequired)) OR NOT HeaderData_.DynamicStructure)";
		
		StockAllocationRecords.PlanStockConsumption(Query, Texts, Registers, QueryTextTabPart, False);
		
	EndIf;
	
	#EndRegion
	
	#Region ManufacturedProducts
	
	If DocumentObject = Undefined
	 Or DocumentObject.ManufacturedProducts.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref              AS Ref,
			|	HeaderData_.Date                   AS Period,
			|	TabularSection.Products        AS Products,
			|	TabularSection.Characteristic      AS Characteristic,
			|	TabularSection.WarehouseRedefinition AS Warehouse,
			|	TabularSection.Purpose          AS Purpose,
			|	TabularSection.ToControlQuality AS ToControlQuality,
			|	TabularSection.ToControlQuality AS SubjectToUnlocking,
			|	TabularSection.QualityConfirmationDate AS QualityConfirmationDate,
			|	CASE WHEN TabularSection.ToExpenseAs THEN
			|				0
			|			ELSE
			|				TabularSection.Count
			|		END AS Count,
			|	
			|	HeaderData_.OrderOverride   AS OrderDocument,
			|	
			|	TabularSection.DateOfReceiptOverride    AS DateOfReceipt,
			|
			|	TabularSection.AvailableForExpenseOverride AS AvailableForConsumption,
			|	
			|	TRUE                             AS OnSchedule,
			|	HeaderData_.ReferenceOrder           AS OrderInSchedule,
			|	TabularSection.Count          AS QuantityInGraph
			|FROM
			|	DocumentDataTableOutputFinishedProducts AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.Canceled
			|	AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
			|	AND (NOT TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			|		OR NOT TabularSection.ItemUsageCharacteristics IN (
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)))
			|	AND NOT TabularSection.WarehouseRedefinition IN (
			|			VALUE(Catalog.BusinessStructure.EmptyRef),
			|			VALUE(Catalog.Warehouses.EmptyRef),
			|			UNDEFINED)
			|	AND (NOT HeaderData_.LeaveProductsAtSubcontractor
			|		OR TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
			|		OR TabularSection.ToExpenseAs)
			|";
		
		StockAllocationRecords.ScheduleStockArrival(Query, Texts, Registers, QueryTextTabPart, True, True);
		
	EndIf;
	
	//
	
	If DocumentObject = Undefined
	 Or DocumentObject.ManufacturedProducts.FindRows(New Structure("ToExpenseAs", True)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
	
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref              AS Ref,
			|	HeaderData_.Date                   AS Period,
			|	TabularSection.Products        AS Products,
			|	TabularSection.Characteristic      AS Characteristic,
			|	CASE WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef) THEN
			|				TabularSection.Department
			|			ELSE
			|				TabularSection.Recipient
			|		END AS Warehouse,
			|	TabularSection.Purpose          AS Purpose,
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.Count          AS Count,
			|	HeaderData_.ReferenceOrder           AS OrderInSchedule
			|FROM
			|	DocumentDataTableOutputFinishedProducts AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.Canceled
			|	AND TabularSection.ToExpenseAs
			|	AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
			|	AND (NOT TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			|		OR NOT TabularSection.ItemUsageCharacteristics IN (
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)))
			|	AND NOT CASE WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef) THEN
			|				TabularSection.Department
			|			ELSE
			|				TabularSection.Recipient
			|		END IN (
			|			VALUE(Catalog.BusinessStructure.EmptyRef),
			|			VALUE(Catalog.Warehouses.EmptyRef),
			|			UNDEFINED)";
			
		StockAllocationRecords.CancelPlannedStockExpense(Query, Texts, Registers, QueryTextTabPart);
		
	EndIf;
	
	//
	
	If DocumentObject = Undefined
	 Or DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.BeingGenerated
	 Or DocumentObject.ManufacturedProducts.FindRows(New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref           AS Ref,
			|	TabularSection.ProductionDate AS Period,
			|	TabularSection.Products     AS Products,
			|	TabularSection.Characteristic   AS Characteristic,
			|	TabularSection.Recipient       AS Warehouse,
			|	TabularSection.Purpose       AS Purpose,
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.ToControlQuality AS ToControlQuality,
			|	TabularSection.ToControlQuality AS SubjectToUnlocking,
			|	TabularSection.QualityConfirmationDate AS QualityConfirmationDate,
			|	TabularSection.Count       AS Count,
			|	TRUE                          AS OnSchedule,
			|	TabularSection.Ref           AS OrderInSchedule
			|FROM
			|	DocumentDataTableOutputFinishedProducts AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	HeaderData_.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
			|		AND TabularSection.Manufactured
			|		AND NOT TabularSection.Canceled
			|		AND NOT TabularSection.ToExpenseAs
			|		AND (TabularSection.RecipientWorkshopStoreroom
			|				AND TabularSection.RecipientDivision = TabularSection.Department
			|			OR TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5))";
		
		StockAllocationRecords.StockArrival(Query, Texts, Registers, QueryTextTabPart, True, True);
		
	EndIf;
	
	#EndRegion
	
	#Region SideAndIntermediateRelease
	
	If DocumentObject = Undefined
	 Or DocumentObject.SideAndIntermediateRelease.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref              AS Ref,
			|	HeaderData_.Date                   AS Period,
			|	TabularSection.Products        AS Products,
			|	TabularSection.Characteristic      AS Characteristic,
			|	TabularSection.WarehouseRedefinition AS Warehouse,
			|	TabularSection.Purpose          AS Purpose,
			|	TabularSection.ToControlQuality AS ToControlQuality,
			|	TabularSection.ToControlQuality AS SubjectToUnlocking,
			|	TabularSection.QualityConfirmationDate AS QualityConfirmationDate,
			|	CASE WHEN TabularSection.ToExpenseAs THEN
			|				0
			|			ELSE
			|				TabularSection.Count
			|		END AS Count,
			|	
			|	HeaderData_.OrderOverride   AS OrderDocument,
			|	
			|	TabularSection.DateOfReceiptOverride    AS DateOfReceipt,
			|
			|	TabularSection.AvailableForExpenseOverride AS AvailableForConsumption,
			|	
			|	TRUE                             AS OnSchedule,
			|	HeaderData_.ReferenceOrder           AS OrderInSchedule,
			|	TabularSection.Count          AS QuantityInGraph
			|FROM
			|	DocumentDataTableOfByFinishedProducts AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.Canceled
			|	AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
			|	AND (NOT TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			|		OR NOT TabularSection.ItemUsageCharacteristics IN (
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)))
			|	AND NOT TabularSection.WarehouseRedefinition IN (
			|			VALUE(Catalog.BusinessStructure.EmptyRef),
			|			VALUE(Catalog.Warehouses.EmptyRef),
			|			UNDEFINED)
			|	AND (NOT HeaderData_.LeaveProductsAtSubcontractor
			|		OR TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
			|		OR TabularSection.ToExpenseAs)
			|";
		
		StockAllocationRecords.ScheduleStockArrival(Query, Texts, Registers, QueryTextTabPart, True, True);
		
	EndIf;
	
	//
	
	If DocumentObject = Undefined
	 Or DocumentObject.SideAndIntermediateRelease.FindRows(New Structure("ToExpenseAs", True)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref              AS Ref,
			|	HeaderData_.Date                   AS Period,
			|	TabularSection.Products        AS Products,
			|	TabularSection.Characteristic      AS Characteristic,
			|	CASE WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef) THEN
			|				TabularSection.Department
			|			ELSE
			|				TabularSection.Recipient
			|		END AS Warehouse,
			|	TabularSection.Purpose          AS Purpose,
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.Count          AS Count,
			|	HeaderData_.ReferenceOrder           AS OrderInSchedule
			|FROM
			|	DocumentDataTableOfByFinishedProducts AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.Canceled
			|	AND TabularSection.ToExpenseAs
			|	AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
			|	AND (NOT TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			|		OR NOT TabularSection.ItemUsageCharacteristics IN (
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind),
			|			VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)))
			|	AND NOT CASE WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef) THEN
			|				TabularSection.Department
			|			ELSE
			|				TabularSection.Recipient
			|		END IN (
			|			VALUE(Catalog.BusinessStructure.EmptyRef),
			|			VALUE(Catalog.Warehouses.EmptyRef),
			|			UNDEFINED)";
		
		StockAllocationRecords.CancelPlannedStockExpense(Query, Texts, Registers, QueryTextTabPart);
		
	EndIf;
	
	//
	
	If DocumentObject = Undefined
	 Or DocumentObject.Status <> Enums.StatusesOfProductionStages2_2.BeingGenerated
	 Or DocumentObject.SideAndIntermediateRelease.FindRows(New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref           AS Ref,
			|	TabularSection.ProductionDate AS Period,
			|	TabularSection.Products     AS Products,
			|	TabularSection.Characteristic   AS Characteristic,
			|	TabularSection.Recipient       AS Warehouse,
			|	TabularSection.Purpose       AS Purpose,
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.ToControlQuality AS ToControlQuality,
			|	TabularSection.ToControlQuality AS SubjectToUnlocking,
			|	TabularSection.QualityConfirmationDate AS QualityConfirmationDate,
			|	TabularSection.Count       AS Count,
			|	TRUE                          AS OnSchedule,
			|	TabularSection.Ref           AS OrderInSchedule
			|FROM
			|	DocumentDataTableOfByFinishedProducts AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	HeaderData_.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
			|		AND TabularSection.Manufactured
			|		AND NOT TabularSection.Canceled
			|		AND NOT TabularSection.ToExpenseAs
			|		AND (TabularSection.RecipientWorkshopStoreroom
			|				AND TabularSection.RecipientDivision = TabularSection.Department
			|			OR TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5))";
		
		StockAllocationRecords.StockArrival(Query, Texts, Registers, QueryTextTabPart, True, True);
		
	EndIf;
	
	#EndRegion
	
	#Region UnusedMaterials
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.UnusedMaterials.FindRows(
				New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableSavingMaterials", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableSavingMaterials(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref         AS Ref,
			|	HeaderData_.Date              AS Period,
			|	TabularSection.Products   AS Products,
			|	TabularSection.Characteristic AS Characteristic,
			|	TabularSection.Recipient     AS Warehouse,
			|	TabularSection.Purpose     AS Purpose,
			|	TabularSection.ToControlQuality AS ToControlQuality,
			|	TabularSection.ToControlQuality AS SubjectToUnlocking,
			|	TabularSection.QualityConfirmationDate AS QualityConfirmationDate,
			|	TabularSection.Count     AS Count,
			|	TabularSection.Ref         AS OrderDocument,
			|	TabularSection.DateOfTransaction   AS DateOfReceipt,
			|	TRUE                        AS AvailableForConsumption,
			|	FALSE                          AS OnSchedule,
			|	UNDEFINED                  AS OrderInSchedule,
			|	0                             AS QuantityInGraph
			|FROM
			|	DocumentDataTableSavingMaterials AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.ToExpenseAs
			|		AND HeaderData_.Status IN(
			|			VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|			VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			|		AND (NOT TabularSection.RecipientWorkshopStoreroom
			|				OR TabularSection.RecipientDivision <> TabularSection.Department)";
		
		StockAllocationRecords.ScheduleStockArrival(Query, Texts, Registers, QueryTextTabPart, False, True);
		
		//
		
		QueryTextTabPart =
			"SELECT
			|	TabularSection.Ref         AS Ref,
			|	TabularSection.DateOfTransaction   AS Period,
			|	TabularSection.Products   AS Products,
			|	TabularSection.Characteristic AS Characteristic,
			|	TabularSection.Recipient     AS Warehouse,
			|	TabularSection.Purpose     AS Purpose,
			|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
			|	TabularSection.ToControlQuality AS ToControlQuality,
			|	TabularSection.ToControlQuality AS SubjectToUnlocking,
			|	TabularSection.QualityConfirmationDate AS QualityConfirmationDate,
			|	TabularSection.Count     AS Count,
			|	FALSE                          AS OnSchedule,
			|	UNDEFINED                  AS OrderInSchedule
			|FROM
			|	DocumentDataTableSavingMaterials AS TabularSection
			|
			|		LEFT JOIN DocumentDataHeader AS HeaderData_
			|		ON TabularSection.Ref = HeaderData_.Ref
			|WHERE
			|	NOT TabularSection.ToExpenseAs
			|		AND HeaderData_.Status IN(
			|			VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
			|			VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			|		AND TabularSection.RecipientWorkshopStoreroom
			|		AND TabularSection.RecipientDivision = TabularSection.Department";
		
		StockAllocationRecords.StockArrival(Query, Texts, Registers, QueryTextTabPart, False, True);
		
	EndIf;
	
	#EndRegion
	
	// It is necessary to combine the request texts due to the peculiarities of the batch formation of the stages.
	If Texts.Count() > 0 Then
		Text = StrConcat(Texts.UnloadValues(), TMCommonUse.QuerySeparatorInJoin());
		QueryTexts.Add(Text, "InventoryAndDemands");
	EndIf;
	
EndProcedure

#Region BatchAccounting

Function DescriptionOfCostAndCostRegisters(Document) Export
	
	DescriptionOfRegisters = New Array;
	DescriptionOfRegisters.Add(Metadata.AccumulationRegisters.InventoryCost);
	
	Return DescriptionOfRegisters;
	
EndFunction

Function SetAdditionalParametersForCostAndCostAccountingOperations(Document, Query = Undefined) Export
	
	AdditionalParameters = New Array;
	
	If Query <> Undefined Then
		// There are no additional parameters.
	EndIf;
	
	Return AdditionalParameters;
	
EndFunction

Function GenerateAdditionalTablesOfCostAndCostAccountingOperations(Document, Query = Undefined, QueryTexts = Undefined) Export
	
	AdditionalTables = New Array;
	AdditionalTables.Add("TTCurrencyConversionFactors");
	AdditionalTables.Add("TTTypesOfStocks");
	
	If Query <> Undefined Then
		
		TempTablesManager = Query.TempTablesManager;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					AdditionalTables[0], QueryTexts, TempTablesManager) Then
			QueryTextTTCurrencyConversionFactors(Query, QueryTexts, Undefined);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					AdditionalTables[1], QueryTexts, TempTablesManager) Then
			QueryTextTTTypesOfStocks(Query, QueryTexts, "InventoryCost", Undefined);
		EndIf;
		
	EndIf;
	
	Return AdditionalTables;
	
EndFunction

Function DescriptionOfCostAccountingOperations(Document) Export
	
	DescriptionOfOperations = New Array;
	
	DataToCheck = ?(TypeOf(Document) = Type("DocumentObject.ProductionStage2_2"), Document, Undefined);
	
	If DataToCheck <> Undefined
	   And DataToCheck.Status <> Enums.StatusesOfProductionStages2_2.Initiated
	   And DataToCheck.Status <> Enums.StatusesOfProductionStages2_2.Completed Then
		
		Return DescriptionOfOperations;
		
	EndIf;
	
	#Region InternalReceipt_ReceiptOfManufacturedProducts
	
	If DataToCheck = Undefined
	 Or DataToCheck.ManufacturedProducts.Count() > 0
	 Or DataToCheck.SideAndIntermediateRelease.Count() > 0 Then
		
		QueryText = 
		"SELECT
		// Document description
		|	TTTypesOfStocks.DateOfTransaction	AS Period,
		|	DocumentTable.Ref		AS Ref,
		|	UNDEFINED				AS DocumentSource,
		|	UNDEFINED				AS SourceDocumentPeriod,
		|	UNDEFINED 				AS DocumentToBeCorrected,
		|	CASE
		|		WHEN TTTypesOfStocks.BusinessOperation =
		|			VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN DocumentTable.Ref
		|		ELSE UNDEFINED
		|	END						AS DocumentRegisterRecords,
		|	UNDEFINED			AS VariancePeriod,
		|
		// Item accounting fields
		|	TTTypesOfStocks.Organization					AS Organization,
		|	TTTypesOfStocks.ItemsLocationAttributes	AS ItemsLocationAttributes,
		|	TTTypesOfStocks.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
		|	CASE
		|		WHEN ISNULL(TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType, 
		|		 VALUE(Enum.VATTaxationTypes.EmptyRef)) <> VALUE(Enum.VATTaxationTypes.EmptyRef)
		|			THEN CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType = VALUE(Enum.VATTaxationTypes.ExportSale) THEN
		|					CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Products.FEACNCode.Commodity
		|						THEN VALUE(Enum.VATTaxationTypes.ExportOfCommoditiesServicesWorks)
		|						ELSE VALUE(Enum.VATTaxationTypes.ExportOfNonResourceGoods)
		|					END
		|			ELSE TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType END
		|		WHEN NOT TTActivitiesVAT.VATActivityType IS NULL
		|			THEN TTActivitiesVAT.VATActivityType
		|		ELSE DocumentTable.ProductionIssueForActivity
		|	END AS VATActivityType,
		|	CASE
		|		WHEN ISNULL(TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType, 
		|		 VALUE(Enum.VATTaxationTypes.EmptyRef)) <> VALUE(Enum.VATTaxationTypes.EmptyRef)
		|			THEN CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType = VALUE(Enum.VATTaxationTypes.ExportSale) THEN
		|					CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Products.FEACNCode.Commodity
		|						THEN VALUE(Enum.VATTaxationTypes.ExportOfCommoditiesServicesWorks)
		|						ELSE VALUE(Enum.VATTaxationTypes.ExportOfNonResourceGoods)
		|					END
		|			ELSE TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType END
		|		WHEN NOT TTActivitiesVAT.VATActivityType IS NULL
		|			THEN TTActivitiesVAT.VATActivityType
		|		ELSE DocumentTable.ProductionIssueForActivity
		|	END AS DocumentVATActivityType,
		|
		// Batch Accounting Analysis Fields
		|	DocumentTable.Ref				AS Lot,
		|	TTTypesOfStocks.LotVendorAttributes	AS LotVendorAttributes,
		|	0									AS RowCode,
		|
		// Corresponding fields
		|	TTTypesOfStocks.LotVendorAttributes						AS LotVendorAttributesCorr,
		|	CASE WHEN TTTypesOfStocks.AddOnForGiver
		|		THEN TTTypesOfStocks.CorItemsLocationAttributes
		|		ELSE UNDEFINED
		|	END													AS CorItemsLocationAttributes,
		|	CASE WHEN TTTypesOfStocks.AddOnForGiver
		|		THEN TTTypesOfStocks.CorInventoryOwnerAttribute
		|		ELSE UNDEFINED
		|	END													AS CorInventoryOwnerAttribute,
		|	UNDEFINED											AS CorGroupOfManufacturedProducts,
		|
		// Financial Accounting Analysis Fields
		|	UNDEFINED							AS SalesOpportunity,
		|	DocumentTable.Department			AS Department,
		|	DocumentTable.EmployeeResponsible			AS Manager,
		|	TTTypesOfStocks.FinancialAccountingDimension AS ProductsGroup,
		|
		// Quantitative and summary indicators
		|	TTTypesOfStocks.Count			AS Count,
		|	TTTypesOfStocks.SumMan				AS Cost,
		|	TTTypesOfStocks.SumMan				AS CostExcludingVAT,
		|	TTTypesOfStocks.SumCompl				AS LocalCost,
		|	TTTypesOfStocks.SumMan				AS CostMan,
		|	TTTypesOfStocks.OffBalanceSheetManAmount	AS OffBalanceCost,
		|	TTTypesOfStocks.OffBalanceSheetLocalAmount	AS OffBalanceCostLocal,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	0 AS AddExpensesForGoods,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	0 AS AddExpensesLocal,
		|	0 AS AddExpensesMan,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	0 AS CorGrossInitialCostENT,
		|
		// Other fields
		|	CASE WHEN TTTypesOfStocks.ToExpenseAs
		|		THEN VALUE(Enum.LotRecordTypes.Supplement)
		|		ELSE VALUE(Enum.LotRecordTypes.Lot)
		|	END 											AS EntryType,
		|	TTTypesOfStocks.RowID				AS RowID,
		|	TTTypesOfStocks.FinRecordID			AS FinRecordID,
		|	(CASE
		|		WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		 AND TTTypesOfStocks.BusinessOperation <> VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
		|		ELSE TTTypesOfStocks.BusinessOperation
		|	END) AS BusinessOperation,
		|	(CASE
		|		WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		 AND TTTypesOfStocks.BusinessOperation <> VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferOfProductsFromProduction)
		|		ELSE TTTypesOfStocks.BusinessTransactionSetting
		|	END) AS BusinessTransactionSetting
		|FROM
		|	Document.ProductionStage2_2 AS DocumentTable
		|	INNER JOIN TTTypesOfStocks AS TTTypesOfStocks
		|		ON TRUE
		|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
		|		ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH)
		|		AND TTParametersOfBatchAccountingForConducting.Organization = TTTypesOfStocks.Organization	
		|	LEFT JOIN TTActivitiesVAT AS TTActivitiesVAT
		|		ON TTTypesOfStocks.Organization = TTActivitiesVAT.MaterialProviderCompany
		|		AND BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH) = TTActivitiesVAT.Period
		|WHERE
		|	DocumentTable.Ref IN (&Ref)
		|	AND TTTypesOfStocks.BusinessOperation IN
		|		(VALUE(Enum.BusinessTransactions.ProductsRelease),
		|		VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost))
		|	AND (&PeriodOfRewritingRegisteredRecords = UNDEFINED
		|		OR &PeriodOfRewritingRegisteredRecords <> DATETIME(1,1,1)
		|			AND TTTypesOfStocks.DateOfTransaction >= &PeriodOfRewritingRegisteredRecords)
		|	AND NOT (TTTypesOfStocks.ToExpenseAs
		|		AND TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease))
		|";
	
		CostCalculationDocumentsPosting.AddDescriptionOfTransactionForCostAccounting(
			DescriptionOfOperations,
			Enums.CostAccountingTransactions.InternalReceipt,
			QueryText);
		
	EndIf;
		
	#EndRegion
	
	#Region InternalReceipt_ReceiptOfManufacturedProductsToDivision
	
	If DataToCheck = Undefined
	 Or DataToCheck.ManufacturedProducts.Count() > 0
	 Or DataToCheck.SideAndIntermediateRelease.Count() > 0 Then
		
		QueryText = 
		"SELECT
		// Document description
		|	TTTypesOfStocks.DateOfTransaction	AS Period,
		|	DocumentTable.Ref		AS Ref,
		|	UNDEFINED				AS DocumentSource,
		|	UNDEFINED				AS SourceDocumentPeriod,
		|	UNDEFINED 				AS DocumentToBeCorrected,
		|	UNDEFINED				AS DocumentRegisterRecords,
		|
		// Item accounting fields
		|	TTTypesOfStocks.Organization					AS Organization,
		|	TTTypesOfStocks.ItemsLocationAttributes	AS ItemsLocationAttributes,
		|	TTTypesOfStocks.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
		|	CASE
		|		WHEN ISNULL(TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType, 
		|		 VALUE(Enum.VATTaxationTypes.EmptyRef)) <> VALUE(Enum.VATTaxationTypes.EmptyRef)
		|			THEN CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType = VALUE(Enum.VATTaxationTypes.ExportSale) THEN
		|					CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Products.FEACNCode.Commodity
		|						THEN VALUE(Enum.VATTaxationTypes.ExportOfCommoditiesServicesWorks)
		|						ELSE VALUE(Enum.VATTaxationTypes.ExportOfNonResourceGoods)
		|					END
		|			ELSE TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType END
		|		WHEN NOT TTActivitiesVAT.VATActivityType IS NULL
		|			THEN TTActivitiesVAT.VATActivityType
		|		ELSE DocumentTable.ProductionIssueForActivity
		|	END AS VATActivityType,
		|	CASE
		|		WHEN ISNULL(TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType, 
		|		 VALUE(Enum.VATTaxationTypes.EmptyRef)) <> VALUE(Enum.VATTaxationTypes.EmptyRef)
		|			THEN CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType = VALUE(Enum.VATTaxationTypes.ExportSale) THEN
		|					CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Products.FEACNCode.Commodity
		|						THEN VALUE(Enum.VATTaxationTypes.ExportOfCommoditiesServicesWorks)
		|						ELSE VALUE(Enum.VATTaxationTypes.ExportOfNonResourceGoods)
		|					END
		|			ELSE TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType END
		|		WHEN NOT TTActivitiesVAT.VATActivityType IS NULL
		|			THEN TTActivitiesVAT.VATActivityType
		|		ELSE DocumentTable.ProductionIssueForActivity
		|	END AS DocumentVATActivityType,
		|
		// Batch Accounting Analysis Fields
		|	DocumentTable.Ref				AS Lot,
		|	TTTypesOfStocks.LotVendorAttributes	AS LotVendorAttributes,
		|	0									AS RowCode,
		|
		// Corresponding fields
		|	TTTypesOfStocks.LotVendorAttributes						AS LotVendorAttributesCorr,
		|	UNDEFINED											AS CorItemsLocationAttributes,
		|	UNDEFINED											AS CorInventoryOwnerAttribute,
		|	UNDEFINED											AS CorGroupOfManufacturedProducts,
		|
		// Financial Accounting Analysis Fields
		|	UNDEFINED							AS SalesOpportunity,
		|	DocumentTable.Department			AS Department,
		|	DocumentTable.EmployeeResponsible			AS Manager,
		|	TTTypesOfStocks.FinancialAccountingDimension AS ProductsGroup,
		|
		// Quantitative and summary indicators
		|	TTTypesOfStocks.Count			AS Count,
		|	TTTypesOfStocks.SumMan				AS Cost,
		|	TTTypesOfStocks.SumMan				AS CostExcludingVAT,
		|	TTTypesOfStocks.SumCompl				AS LocalCost,
		|	TTTypesOfStocks.SumMan				AS CostMan,
		|	TTTypesOfStocks.OffBalanceSheetManAmount	AS OffBalanceCost,
		|	TTTypesOfStocks.OffBalanceSheetLocalAmount	AS OffBalanceCostLocal,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	0 AS AddExpensesForGoods,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	0 AS AddExpensesLocal,
		|	0 AS AddExpensesMan,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	0 AS CorGrossInitialCostENT,
		|
		// Additional field
		|	CASE WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		THEN VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
		|		ELSE UNDEFINED
		|	END AS AccountingSection,
		|
		// Other fields
		|	VALUE(Enum.LotRecordTypes.Supplement) AS EntryType,
		|	TTTypesOfStocks.RowID				AS RowID,
		|	TTTypesOfStocks.FinRecordID			AS FinRecordID,
		|	TTTypesOfStocks.BusinessOperation 			AS BusinessOperation,
		|	TTTypesOfStocks.BusinessTransactionSetting	AS BusinessTransactionSetting
		|
		|FROM
		|	Document.ProductionStage2_2 AS DocumentTable
		|	INNER JOIN TTTypesOfStocks AS TTTypesOfStocks
		|		ON TRUE
		|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
		|		ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH)
		|		AND TTParametersOfBatchAccountingForConducting.Organization = TTTypesOfStocks.Organization
		|	LEFT JOIN TTActivitiesVAT AS TTActivitiesVAT
		|		ON TTTypesOfStocks.Organization = TTActivitiesVAT.MaterialProviderCompany
		|		AND BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH) = TTActivitiesVAT.Period
		|WHERE
		|	DocumentTable.Ref IN (&Ref)
		|	AND TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|	AND (TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost OR TTTypesOfStocks.ToExpenseAs)
		|	AND (&PeriodOfRewritingRegisteredRecords = UNDEFINED
		|		OR &PeriodOfRewritingRegisteredRecords <> DATETIME(1,1,1)
		|		AND TTTypesOfStocks.DateOfTransaction >= &PeriodOfRewritingRegisteredRecords)
		|";
	
		CostCalculationDocumentsPosting.AddDescriptionOfTransactionForCostAccounting(
			DescriptionOfOperations,
			Enums.CostAccountingTransactions.InternalReceipt,
			QueryText);
		
	EndIf;
		
	#EndRegion
	
	#Region WriteOffForExpensesAssets_WriteOffOfMaterialsAndManufacturedProductsAndWorksForExpenses
	
	// The verification conditions and filling in the fields in the request must match the function of the textquestionatablityapplication to other active arrays().
	If DataToCheck = Undefined
	 Or DataToCheck.ManufacturedProducts.Count() > 0
	   And DataToCheck.ManufacturedProducts.Find(True, "ToExpenseAs") <> Undefined
	 Or DataToCheck.SideAndIntermediateRelease.Count() > 0
	   And DataToCheck.SideAndIntermediateRelease.Find(True, "ToExpenseAs") <> Undefined
	 Or DataToCheck.UnusedMaterials.Count() > 0
	   And DataToCheck.UnusedMaterials.Find(True, "ToExpenseAs") <> Undefined Then
		
		QueryText = 
		"SELECT
		// Document description
		|	TTTypesOfStocks.DateOfTransaction	AS Period,
		|	DocumentTable.Ref		AS Ref,
		|	&Ref						AS DocumentRegisterRecords,
		|	UNDEFINED				AS DocumentSource,
		|	UNDEFINED				AS SourceDocumentPeriod,
		|	UNDEFINED 				AS DocumentToBeCorrected,
		|
		// Item accounting fields
		|	TTTypesOfStocks.Organization					AS Organization,
		|	TTTypesOfStocks.ItemsLocationAttributes	AS ItemsLocationAttributes,
		|	TTTypesOfStocks.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
		|	CASE
		|		WHEN ISNULL(TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType, 
		|		 VALUE(Enum.VATTaxationTypes.EmptyRef)) <> VALUE(Enum.VATTaxationTypes.EmptyRef)
		|			THEN CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType = VALUE(Enum.VATTaxationTypes.ExportSale) THEN
		|					CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Products.FEACNCode.Commodity
		|						THEN VALUE(Enum.VATTaxationTypes.ExportOfCommoditiesServicesWorks)
		|						ELSE VALUE(Enum.VATTaxationTypes.ExportOfNonResourceGoods)
		|					END
		|			ELSE TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType END
		|		WHEN NOT TTActivitiesVAT.VATActivityType IS NULL
		|			THEN TTActivitiesVAT.VATActivityType
		|		ELSE DocumentTable.ProductionIssueForActivity
		|	END AS VATActivityType,
		|	CASE
		|		WHEN ISNULL(TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType, 
		|		 VALUE(Enum.VATTaxationTypes.EmptyRef)) <> VALUE(Enum.VATTaxationTypes.EmptyRef)
		|			THEN CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType = VALUE(Enum.VATTaxationTypes.ExportSale) THEN
		|					CASE WHEN TTTypesOfStocks.ItemsLocationAttributes.Products.FEACNCode.Commodity
		|						THEN VALUE(Enum.VATTaxationTypes.ExportOfCommoditiesServicesWorks)
		|						ELSE VALUE(Enum.VATTaxationTypes.ExportOfNonResourceGoods)
		|					END
		|			ELSE TTTypesOfStocks.ItemsLocationAttributes.Purpose.VATActivityType END
		|		WHEN NOT TTActivitiesVAT.VATActivityType IS NULL
		|			THEN TTActivitiesVAT.VATActivityType
		|		ELSE DocumentTable.ProductionIssueForActivity
		|	END AS DocumentVATActivityType,
		|
		// Batch Accounting Analysis Fields
		|	DocumentTable.Ref				AS Lot,
		|	TTTypesOfStocks.LotVendorAttributes	AS LotVendorAttributes,
		|
		// Corresponding fields
		|	UNDEFINED 										AS CorCompany,
		|	UNDEFINED 										AS CorItemsLocationAttributes,
		|	UNDEFINED										AS CorInventoryOwnerAttribute,
		|	TTTypesOfStocks.ExpenseItem						AS ExpenseItemAssets,
		|	CASE WHEN TTTypesOfStocks.ExpenseItem REFS ChartOfCharacteristicTypes.ExpenseItems
		|		THEN TTTypesOfStocks.DimensionOfExpenses
		|		ELSE TTTypesOfStocks.AssetsLiabilitiesDimension
		|	END												AS AssetExpenseAnalytics,
		|	DocumentTable.LineOfBusiness			AS CorLineOfBusiness,
		|
		// Financial Accounting Analysis Fields
		|	UNDEFINED							AS SalesOpportunity,
		|	TTTypesOfStocks.Recipient				AS Department,
		|	DocumentTable.EmployeeResponsible			AS Manager,
		|	TTTypesOfStocks.FinancialAccountingDimension AS ProductsGroup,
		|
		// Quantitative and summary indicators
		|	TTTypesOfStocks.Count			AS Count,
		|	CASE
		|		WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		 OR TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN TTTypesOfStocks.SumMan
		|		ELSE 0 
		|	END AS Cost,
		|	CASE
		|		WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		 OR TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN TTTypesOfStocks.SumMan
		|		ELSE 0 
		|	END AS CostExcludingVAT,
		|	CASE
		|		WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		 OR TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN TTTypesOfStocks.SumCompl
		|		ELSE 0 
		|	END AS LocalCost,
		|	CASE
		|		WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|		 OR TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN TTTypesOfStocks.SumMan
		|		ELSE 0 
		|	END AS CostMan,
		|
		// Additional field
		|	CASE WHEN TTParametersOfBatchAccountingForConducting.ProductCostingByPlannedCost
		|	  AND TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|		THEN VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
		|		ELSE UNDEFINED
		|	END AS AccountingSection,
		|
		// Other fields
		|	CASE
		|		WHEN TTTypesOfStocks.BusinessOperation IN(
		|				VALUE(Enum.BusinessTransactions.ProductsRelease),
		|				VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost))
		|			THEN VALUE(Enum.LotRecordTypes.Supplement)
		|		ELSE VALUE(Enum.LotRecordTypes.Consumption)
		|	END															AS EntryType,
		|	TTTypesOfStocks.GLAccountSettings								AS GLAccountSettings,
		|	TTTypesOfStocks.RowID								AS RowID,
		|	TTTypesOfStocks.FinRecordID							AS FinRecordID,
		|	CASE
		|		WHEN TTTypesOfStocks.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
		|			THEN VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost)
		|		WHEN VALUETYPE(TTTypesOfStocks.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.ExpenseItems)
		|				AND TTTypesOfStocks.ExpenseItem.CostAllocationOptionLocal =
		|						VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|			THEN CASE
		|					WHEN TTTypesOfStocks.ExpenseItem.VATAssetTaxClass IN (
		|									VALUE(Enum.AssetKinds.FA),
		|									VALUE(Enum.AssetKinds.ConstructionInProgressObjects))
		|						THEN VALUE(Enum.BusinessTransactions.TransferToFixedAssets)
		|					WHEN TTTypesOfStocks.ExpenseItem.VATAssetTaxClass = VALUE(Enum.AssetKinds.IA)
		|						THEN VALUE(Enum.BusinessTransactions.TransferToIntangibleAssetsAndRD)
		|				END
		|		WHEN VALUETYPE(TTTypesOfStocks.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.ExpenseItems)
		|				AND TTTypesOfStocks.ExpenseItem.CostAllocationOptionLocal =
		|						VALUE(Enum.CostAllocationOptions.OnOtherAssets)
		|			THEN VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		WHEN VALUETYPE(TTTypesOfStocks.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
		|			THEN VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		ELSE
		|			VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)
		|	END																			AS BusinessOperation,
		|	CASE
		|		WHEN VALUETYPE(TTTypesOfStocks.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.ExpenseItems)
		|				AND TTTypesOfStocks.ExpenseItem.CostAllocationOptionLocal =
		|						VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|			THEN CASE
		|					WHEN TTTypesOfStocks.ExpenseItem.VATAssetTaxClass IN (
		|									VALUE(Enum.AssetKinds.FA),
		|									VALUE(Enum.AssetKinds.ConstructionInProgressObjects))
		|						THEN VALUE(Catalog.BusinessTransactionsSettings.TransferToFixedAssets)
		|					WHEN TTTypesOfStocks.ExpenseItem.VATAssetTaxClass = VALUE(Enum.AssetKinds.IA)
		|						THEN VALUE(Catalog.BusinessTransactionsSettings.TransferToIntangibleAssetsAndRD)
		|				END
		|		WHEN VALUETYPE(TTTypesOfStocks.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.ExpenseItems)
		|				AND TTTypesOfStocks.ExpenseItem.CostAllocationOptionLocal =
		|						VALUE(Enum.CostAllocationOptions.OnOtherAssets)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposes)
		|		WHEN VALUETYPE(TTTypesOfStocks.ExpenseItem) =
		|						TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposes)
		|		ELSE
		|			VALUE(Catalog.BusinessTransactionsSettings.GoodsConsumptionOnDemand)
		|	END																			AS BusinessTransactionSetting
		|
		|FROM
		|	Document.ProductionStage2_2 AS DocumentTable
		|	INNER JOIN TTTypesOfStocks AS TTTypesOfStocks
		|		ON TRUE
		|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
		|		ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH)
		|		AND TTParametersOfBatchAccountingForConducting.Organization = TTTypesOfStocks.Organization
		|	LEFT JOIN TTActivitiesVAT AS TTActivitiesVAT
		|		ON TTTypesOfStocks.Organization = TTActivitiesVAT.MaterialProviderCompany
		|		AND BEGINOFPERIOD(TTTypesOfStocks.DateOfTransaction, MONTH) = TTActivitiesVAT.Period
		|WHERE
		|	DocumentTable.Ref IN (&Ref)
		|	AND TTTypesOfStocks.ToExpenseAs
		|	AND (&PeriodOfRewritingRegisteredRecords = UNDEFINED
		|		OR &PeriodOfRewritingRegisteredRecords <> DATETIME(1,1,1)
		|			AND TTTypesOfStocks.DateOfTransaction >= &PeriodOfRewritingRegisteredRecords)
		|";

	CostCalculationDocumentsPosting.AddDescriptionOfTransactionForCostAccounting(
		DescriptionOfOperations,
		Enums.CostAccountingTransactions.RecogniseAsExpensesAssets,
		QueryText);
		
	EndIf;
	
