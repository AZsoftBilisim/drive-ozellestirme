		|			THEN TabularSection.ProductOwner
		|		WHEN &InternalSubcontracting
		|			THEN &MaterialProviderCompany
		|		ELSE &Organization
		|	END                                        AS Organization,
		|	CASE
		|		WHEN TabularSection.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
		|			THEN TabularSection.Department
		|		ELSE TabularSection.Recipient
		|	END                                        AS Department,
		|	TabularSection.ExpenseItem                AS AssetRef,
		|	CASE
		|		WHEN TabularSection.AssetsLiabilitiesDimension = VALUE(Enum.AssetAndLiabilityItemsWithoutDimension.EmptyRef)
		|			THEN UNDEFINED
		|		ELSE TabularSection.AssetsLiabilitiesDimension
		|	END                                        AS Dimension,
		|	CAST(TabularSection.Sum * TTCurrencyConversionFactors.ConversionRateToManCurrency AS NUMBER(31,2))  AS Sum
		|FROM
		|	DocumentDataTableOfByFinishedProducts AS TabularSection
		|	
