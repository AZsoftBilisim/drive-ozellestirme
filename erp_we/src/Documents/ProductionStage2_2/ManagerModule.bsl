Function QueryTextTableProductionOrders(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "ProductionOrders";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	If DocumentObject <> Undefined And Not DocumentObject.DynamicStructure Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataHeader", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableProvisionOfMaterialsAndWorks", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText =
	"SELECT
	|	TabularSection.Ref                                AS Recorder,
	|
	|	TabularSection.Products                          AS Products,
	|	TabularSection.Characteristic                        AS Characteristic,
	|	TabularSection.WarehouseRedefinition                  AS Warehouse,
	|	TabularSection.Purpose                            AS Purpose,
	|	TabularSection.KeyProducts                      AS KeyProducts,
	|
	|	HeaderData_.ReferenceOrder                             AS ProductionOrder,
	|
	|	TabularSection.Department                         AS Department,
	|	HeaderData_.ProductionLot                       AS Lot,
	|	HeaderData_.Ref                                   AS Stage,
	|	HeaderData_.ProductionLotIDInProductGroup              AS ProductionLotIDInProductGroup,
	|
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				UNDEFINED
	|			ELSE
	|				HeaderData_.OrderOverride
	|		END                                            AS ReceiptOrder,
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				DATETIME(1, 1, 1)
	|			ELSE
	|				TabularSection.ProductionDate
	|		END                                            AS DateOfReceipt,
	|
	|	0                                                    AS ReverseKittingStarted,
	|	0                                                    AS ReverseKittingCompleted,
	|
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				0
	|			ELSE
	|				TabularSection.Count
	|		END                                            AS Launched,
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				TabularSection.Count
	|			ELSE
	|				0
	|		END                                            AS Done
	|
	|FROM
	|	DocumentDataTableOutputFinishedProducts AS TabularSection
	|
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|
	|WHERE
	|	HeaderData_.Posted
	|	AND HeaderData_.DynamicStructure
	|	AND NOT TabularSection.Canceled
	|	AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|	AND (NOT TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|		OR NOT TabularSection.ItemUsageCharacteristics IN (
	|			VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|			VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind),
	|			VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)))
	|	AND NOT TabularSection.WarehouseRedefinition IN (
	|			VALUE(Catalog.BusinessStructure.EmptyRef),
	|			VALUE(Catalog.Warehouses.EmptyRef),
	|			UNDEFINED)
	|
	|UNION ALL
	|
	|SELECT
	|	TabularSection.Ref                                AS Recorder,
	|
	|	TabularSection.Products                          AS Products,
	|	TabularSection.Characteristic                        AS Characteristic,
	|	TabularSection.WarehouseRedefinition                  AS Warehouse,
	|	TabularSection.Purpose                            AS Purpose,
	|	TabularSection.KeyProducts                      AS KeyProducts,
	|
	|	HeaderData_.ReferenceOrder                             AS ProductionOrder,
	|
	|	TabularSection.Department                         AS Department,
	|	HeaderData_.ProductionLot                       AS Lot,
	|	HeaderData_.Ref                                   AS Stage,
	|	HeaderData_.ProductionLotIDInProductGroup              AS ProductionLotIDInProductGroup,
	|
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				UNDEFINED
	|			ELSE
	|				HeaderData_.OrderOverride
	|		END                                            AS ReceiptOrder,
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				DATETIME(1, 1, 1)
	|			ELSE
	|				TabularSection.ProductionDate
	|		END                                            AS DateOfReceipt,
	|
	|	0                                                    AS ReverseKittingStarted,
	|	0                                                    AS ReverseKittingCompleted,
	|
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				0
	|			ELSE
	|				TabularSection.Count
	|		END                                            AS Launched,
	|	CASE
	|		WHEN TabularSection.Manufactured
	|						OR HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				TabularSection.Count
	|			ELSE
	|				0
	|		END                                            AS Done
	|FROM
	|	DocumentDataTableOfByFinishedProducts AS TabularSection
	|
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|
	|WHERE
	|	HeaderData_.Posted
	|	AND HeaderData_.DynamicStructure
	|	AND NOT TabularSection.Canceled
	|	AND NOT TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|	AND (NOT TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|		OR NOT TabularSection.ItemUsageCharacteristics IN (
	|			VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|			VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind),
	|			VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)))
	|	AND NOT TabularSection.WarehouseRedefinition IN (
	|			VALUE(Catalog.BusinessStructure.EmptyRef),
	|			VALUE(Catalog.Warehouses.EmptyRef),
	|			UNDEFINED)
	|
	|UNION ALL
	|
	|SELECT
	|	HeaderData_.Ref                                   AS Recorder,
	|
	|	TabularSection.Products                          AS Products,
	|	TabularSection.Characteristic                        AS Characteristic,
	|	TabularSection.Warehouse                                 AS Warehouse,
	|	TabularSection.Purpose                            AS Purpose,
	|	TabularSection.KeyProducts                      AS KeyProducts,
	|
	|	HeaderData_.ReferenceOrder                             AS ProductionOrder,
	|
	|	TabularSection.Department                         AS Department,
	|	HeaderData_.ProductionLot                       AS Lot,
	|	HeaderData_.Ref                                   AS Stage,
	|	HeaderData_.ProductionLotIDInProductGroup              AS ProductionLotIDInProductGroup,
	|
	|	UNDEFINED                                         AS ReceiptOrder,
	|	DATETIME(1,1,1)                                     AS DateOfReceipt,
	|
	|	CASE
	|		WHEN HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				0
	|			ELSE
	|				TabularSection.Count
	|		END                                            AS ReverseKittingStarted,
	|	CASE
	|		WHEN HeaderData_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed) THEN
	|				TabularSection.Count
	|			ELSE
	|				0
	|		END                                            AS ReverseKittingCompleted,
	|
	|	0                                                    AS Launched,
	|	0                                                    AS Done
	|
	|FROM
	|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
	|
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|
	|WHERE
	|	HeaderData_.Posted
	|	AND HeaderData_.DynamicStructure
	|	AND HeaderData_.ProductionProcessType = VALUE(Enum.ProductionProcessTypes.Disassembly)
	|		AND &RequestTextDisassembledProduct
	|		AND NOT TabularSection.Canceled
	|";
	
	QueryText = StrReplace(QueryText, "&RequestTextDisassembledProduct", QueryTextSubstitutionDisassembledFinishedProduct());
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;

EndFunction

