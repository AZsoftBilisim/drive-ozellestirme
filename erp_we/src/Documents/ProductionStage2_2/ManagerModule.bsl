	CheckParameters = ParametersForVerifyingBankingDetails("Purpose", "YouCanNotChooseGiverAppointment");
	CheckParameters.MessageTemplate = NStr("vi = 'Cấm chọn mục đích của người đặt gia công khi sản xuất đặt riêng (dòng %1 của danh sách ""%2"").';
											|ru = 'Запрещено выбирать назначение давальца при собственном производстве (строка %1 списка ""%2"").';
