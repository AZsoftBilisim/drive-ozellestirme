// The function returns the number of the production stage that should be assigned to the new stage.
//
// Parameters:
//  ProductionLot	- DocumentRef.ProductionStage2_2 - ID of the stage chain.
//
// Returns:
//   - Number - stage number.
//
Function NewStageNumberInLaunchBatch(ProductionLot) Export
	
	Query = New Query(
	"SELECT
	|	ISNULL(MAX(ChainOfStages.StartingLotStageNumber), 0) + 1 AS NextStageNumberInLaunchBatch
	|FROM
	|	Document.ProductionStage2_2 AS ChainOfStages
	|WHERE
	|	ChainOfStages.ProductionLot = &ProductionLot
	|");
	Query.SetParameter("ProductionLot", ProductionLot);
	
	Selection = Query.Execute().Select();
	Selection.Next();
	
	Return Selection.NextStageNumberInLaunchBatch;
	
EndFunction

