Function QueryTextTableAvailabilityOfWorkCenterTypes(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "AvailabilityOfWorkCenterTypes";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	If DocumentObject <> Undefined
	   And Not DocumentObject.OccupancyOfWorkCenterTypes.Count() > 0 Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableEmploymentOfTypesOfWorkCenters", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableEmploymentOfTypesOfWorkCenters(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText = "
		|SELECT
		|	TabularSection.IntervalDate     AS Period,
		|	TabularSection.WorkCenterType AS WorkCenterType,
		|	TabularSection.IntervalDate     AS IntervalDate,
		|	SUM(TabularSection.Count) AS Busy,
		|	TabularSection.ReferenceOrder      AS ReferenceOrder,
		|	TabularSection.WorkCenterTypeDepartment AS Department,
		|	TabularSection.KeyLot        AS KeyLot,
		|	TabularSection.Ref            AS Stage
		|FROM
		|	DocumentDataTableEmploymentOfTypesOfWorkCenters AS TabularSection
		|WHERE
		|	&StagePlacementInProductionSchedule
		|	AND &Status <> VALUE(Enum.StatusesOfProductionStages2_2.Completed)
		|	
		|GROUP BY
		|	TabularSection.WorkCenterType,
		|	TabularSection.WorkCenterTypeDepartment,
		|	TabularSection.IntervalDate,
		|	TabularSection.ReferenceOrder,
		|	TabularSection.KeyLot,
		|	TabularSection.Ref";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableMaterialsAndWorksInProduction(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "MaterialsAndWorksInProduction";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	ArrayOfRequestTexts = New Array;
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.ManufacturedProducts.FindRows(New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// release of works at the calculated cost
		"SELECT
		|	TabularSection.ProductionDate        AS Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	CASE
		|		WHEN &InternalSubcontracting
		|			THEN &MaterialProviderCompany
		|		ELSE &Organization
		|	END                                  AS Organization,
		|	TabularSection.Recipient              AS Department,
		|	TabularSection.Products            AS Products,
		|	TabularSection.Characteristic          AS Characteristic,
		|	TabularSection.Purpose              AS Purpose,
		|	TabularSection.Count              AS Count
		|FROM
		|	DocumentDataTableOutputFinishedProducts AS TabularSection
		|WHERE
		|	&Status IN (
		|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
		|	AND NOT TabularSection.ItemOfTraceableItem
		|	AND TabularSection.Manufactured
		|	AND NOT TabularSection.Canceled
		|	AND NOT TabularSection.ToExpenseAs";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.SideAndIntermediateRelease.FindRows(New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// release of works at a fixed cost
		"SELECT
		|	TabularSection.ProductionDate        AS Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	CASE
		|		WHEN NOT TabularSection.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
		|			THEN TabularSection.ProductOwner
		|		WHEN &InternalSubcontracting
		|			THEN &MaterialProviderCompany
		|		ELSE &Organization
		|	END                                  AS Organization,
		|	TabularSection.Recipient              AS Department,
		|	TabularSection.Products            AS Products,
		|	TabularSection.Characteristic          AS Characteristic,
		|	TabularSection.Purpose              AS Purpose,
		|	TabularSection.Count              AS Count
		|FROM
		|	DocumentDataTableOfByFinishedProducts AS TabularSection
		|WHERE
		|	&Status IN (
		|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
		|	AND NOT TabularSection.ItemOfTraceableItem
		|	AND TabularSection.Manufactured
		|	AND NOT TabularSection.Canceled
		|	AND NOT TabularSection.ToExpenseAs";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableProvisionOfMaterialsAndWorks",
					QueryTexts,
					TempTablesManager) Then
			QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// consumption of works
		"SELECT
		|	TabularSection.DateOfShipment            AS Period,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	&Organization                           AS Organization,
		|	TabularSection.Department           AS Department,
		|	TabularSection.Products            AS Products,
		|	TabularSection.Characteristic          AS Characteristic,
		|	CASE
		|		WHEN TabularSection.WithAssignment
		|			THEN TabularSection.Purpose
		|		ELSE UNDEFINED
		|	END                                  AS Purpose,
		|	TabularSection.Count              AS Count
		|FROM
		|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
		|WHERE
		|	&Status IN (
		|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
		|	AND NOT TabularSection.ItemOfTraceableItem
		|	AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
		|	AND NOT TabularSection.Canceled";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or DocumentObject.ProductionByThirdParty2_5
		 And (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableProvisionOfMaterialsAndWorks",
					QueryTexts,
					TempTablesManager) Then
			QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// Arrival of works for the purpose of the stage
		// Necessary for processing the processor's report 2.5
		"SELECT
		|	TabularSection.DateOfShipment            AS Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	&Organization                           AS Organization,
		|	TabularSection.Department           AS Department,
		|	TabularSection.Products            AS Products,
		|	TabularSection.Characteristic          AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	TabularSection.Count              AS Count
		|FROM
		|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
		|WHERE
		|	&ProductionByThirdParty2_5
		|	AND &Status IN (
		|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND TabularSection.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
		|	AND NOT TabularSection.ItemOfTraceableItem
		|	AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
		|	AND NOT TabularSection.Canceled";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If ArrayOfRequestTexts.Count() = 0 Then
		Return "";
	EndIf;
	
	QueryText = StrConcat(ArrayOfRequestTexts, TMCommonUse.QuerySeparatorInJoin());
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableProductsRelease(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "ProductsRelease";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	ArrayOfRequestTexts = New Array;
	
	If DocumentObject = Undefined
	 Or DocumentObject.ManufacturedProducts.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		"SELECT
		|	CASE
		|		WHEN &InternalSubcontracting
		|			THEN &MaterialProviderCompany
		|		ELSE &Organization
		|	END										AS Organization,
		|	TabularSection.Department				AS Department,
		|	TabularSection.ProductionDate				AS Period,
		|	CASE
		|		WHEN TableOfConstants_.KeepRecordsOfInventoryCostByAssignments
		|			AND &Period >= BEGINOFPERIOD(TableOfConstants_.CostAccountingByAssignmentValidFrom, MONTH)
		|			THEN TabularSection.ItemsLocationAttributes
		|		ELSE AnalyticsWithoutAssignment.DimensionKey
		|	END										AS ItemsLocationAttributes,
		|	&Ref										AS ReferenceOrder,
		|	TabularSection.RowCode					AS RowCode,
		|	TabularSection.Count					AS Count,
		|	TabularSection.ExpenseItem				AS ExpenseItem,
		|	TabularSection.DimensionOfExpenses			AS DimensionOfExpenses,
		|	TabularSection.AssetsLiabilitiesDimension		AS AssetsLiabilitiesDimension
		|FROM
		|	DocumentDataTableOutputFinishedProducts AS TabularSection
		|	
		|	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
		|		ON TabularSection.ItemsLocationAttributes = Dimension.Ref
		|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		|		ON Dimension.Products = AnalyticsWithoutAssignment.Products
		|		AND Dimension.Characteristic = AnalyticsWithoutAssignment.Characteristic
		|		AND &EmptyDestinationLink = AnalyticsWithoutAssignment.Purpose
		|		AND Dimension.Series = AnalyticsWithoutAssignment.Series
		|		AND Dimension.StorageLocation = AnalyticsWithoutAssignment.StorageLocation
		|		AND VALUE(Catalog.ProductCostElements.EmptyRef) = AnalyticsWithoutAssignment.ProductCostElement
		|	LEFT JOIN Constants AS TableOfConstants_
		|	ON TRUE
		|WHERE
		|	TabularSection.Manufactured
		|	AND NOT TabularSection.Canceled";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or DocumentObject.SideAndIntermediateRelease.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		"SELECT
		|	CASE
		|		WHEN NOT TabularSection.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
		|			THEN TabularSection.ProductOwner
		|		WHEN &InternalSubcontracting
		|			THEN &MaterialProviderCompany
		|		ELSE &Organization
		|	END										AS Organization,
		|	TabularSection.Department				AS Department,
		|	TabularSection.ProductionDate				AS Period,
		|	CASE
		|		WHEN TableOfConstants_.KeepRecordsOfInventoryCostByAssignments
		|			AND &Period >= BEGINOFPERIOD(TableOfConstants_.CostAccountingByAssignmentValidFrom, MONTH)
		|			THEN TabularSection.ItemsLocationAttributes
		|		ELSE AnalyticsWithoutAssignment.DimensionKey
		|	END										AS ItemsLocationAttributes,
		|	&Ref										AS ReferenceOrder,
		|	TabularSection.RowCode					AS RowCode,
		|	TabularSection.Count					AS Count,
		|	TabularSection.ExpenseItem				AS ExpenseItem,
		|	TabularSection.DimensionOfExpenses			AS DimensionOfExpenses,
		|	TabularSection.AssetsLiabilitiesDimension		AS AssetsLiabilitiesDimension
		|FROM
		|	DocumentDataTableOfByFinishedProducts AS TabularSection
		|	
		|	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
		|		ON TabularSection.ItemsLocationAttributes = Dimension.Ref
		|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		|		ON Dimension.Products = AnalyticsWithoutAssignment.Products
		|		AND Dimension.Characteristic = AnalyticsWithoutAssignment.Characteristic
		|		AND &EmptyDestinationLink = AnalyticsWithoutAssignment.Purpose
		|		AND Dimension.Series = AnalyticsWithoutAssignment.Series
		|		AND Dimension.StorageLocation = AnalyticsWithoutAssignment.StorageLocation
		|		AND VALUE(Catalog.ProductCostElements.EmptyRef) = AnalyticsWithoutAssignment.ProductCostElement
		|	LEFT JOIN Constants AS TableOfConstants_
		|	ON TRUE
		|WHERE
		|	TabularSection.Manufactured
		|	AND NOT TabularSection.Canceled";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
		
	If ArrayOfRequestTexts.Count() = 0 Then
		Return "";
	EndIf;
	
	QueryText = StrConcat(ArrayOfRequestTexts, TMCommonUse.QuerySeparatorInJoin());
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableGoodsBatchMovement(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "GoodsBatchMovement";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	ArrayOfRequestTexts = New Array;
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And Not DocumentObject.ProductionByThirdParty
		 And DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableProvisionOfMaterialsAndWorks",
					QueryTexts,
					TempTablesManager) Then
			QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// Shipment of materials from the workshop storeroom
		"SELECT
		|	TabularSection.Ref                                   AS Recorder,
		|	TabularSection.DateOfShipment                             AS Period,
		|	TabularSection.Products                             AS Products,
		|	TabularSection.Characteristic                           AS Characteristic,
		|	CASE
		|		WHEN TabularSection.WithAssignment
		|			THEN TabularSection.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                                  	AS Purpose,
		|	TabularSection.Series                                    AS Series,
		|	TabularSection.Count                               AS Count,
		|	TabularSection.Warehouse                                    AS Sender,
		|	TabularSection.Department                            AS Recipient,
