								|tr = 'Verilen fason satın alma siparişi düzenlenmediğinden dolayı %Document% belgesinde ""%Status%"" durumu ayarlanmadı'");
				ErrorText = StrReplace(ErrorText, "%Document%", ValidationSample.Ref);
				ErrorText = StrReplace(ErrorText, "%Status%", ValidationSample.PresentationOfNewStatus);
				
				Common.MessageToUser(
							ErrorText,
							ValidationSample.Ref,
							"Status",,
							Cancel);
			EndIf;
		Else
			If ProductionManagementClientServer.ComparisonOfStageStatuses(
					MeaningOfNewStatus,
					Enums.StatusesOfProductionStages2_2.ForCompletion) < 0 Then
				
				ErrorText = NStr("vi = 'Chứng từ %Document% chưa đặt trạng thái ""%Status%"", bởi vì trên cơ sở đó đã lập đơn đặt hàng gia công';
								|ru = 'У документа %Document% статус ""%Status%"" не установлен, т.к. на основании него оформлен заказ переработчику';
								|en = 'The ""%Status%"" status of the %Document% document is not set as the subcontracting purchase order is not registered'; fa = 'The ""%Status%"" status of the %Document% document is not set as the subcontracting purchase order is not registered';
								|it = 'Lo stato ""%Status%"" del documento %Document% non è impostato, poiché in base ad esso l''ordine viene elaborato dal processore';
								|pl = 'W dokumencie %Document% status ""%Status%"" nie jest ustawiony, ponieważ na jego podstawie zlecenie przetwarzane jest przez przetwórcę';
								|tr = 'Verilen fason satın alma siparişi belge temelinde düzenlendiğinden dolayı %Document% belgesinde ""%Status%"" durumu ayarlanmadı'");
				ErrorText = StrReplace(ErrorText, "%Document%", ValidationSample.Ref);
				ErrorText = StrReplace(ErrorText, "%Status%", ValidationSample.PresentationOfNewStatus);
				
