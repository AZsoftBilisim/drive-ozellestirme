#Region BatchGenerationOfStages

Function FormStagesInsideTimeMeasurement(Parameters)
	
	ResultOfFormation = ResultOfFormationOfStages(Parameters.References);
	
	// Reading the requirements for the formation of stages
	TempTablesManager = New TempTablesManager;
	
	Documents.ProductionOrder2_2.CreateTTDataToGenerateStages(
		TempTablesManager, Parameters.References);
	
	CheckDataForGeneratingStages(TempTablesManager, ResultOfFormation);
	
	Documents.ProductionOrder2_2.CreateTTWaysToGetMaterials2_2(
		TempTablesManager, Parameters.References);
	
	Queue = QueueOfOrdersForFormationOfStages(TempTablesManager);
	If Queue.Count() = 0 Then
		Return ResultOfFormation;
	EndIf;
	
	Products_1 = ProductsAndSemiFinishedProductsForFormationOfStages(TempTablesManager);
	Products_1.Indexes.Add("ReferenceOrder");
	
	// The parameters of the explosion
	NodulationParameters = ProductDecomposition.NodulationParameters();
	NodulationParameters.GroupData_ = True;
	NodulationParameters.GroupFields = ProductDecomposition.GroupFields("ReferenceOrder,AssignmentProducts");
	NodulationParameters.ReservePFFromWarehouse = Parameters.ReservePF;
	NodulationParameters.ReservePFFieldNamePurpose = "AssignmentMaterials";
	NodulationParameters.ReplacePFNaAnalogues = Parameters.ReplacePFNaAnalogues;
	
	SelectionParameters = Catalogs.BillsOfMaterials.DataSamplingParameters(, TempTablesManager);
	SelectionParameters.CalculateShareOfCostOfOutputProducts = True;
	SelectionParameters.IntermediateSemiFinishedProducts = ProductDataManagementClientServer.IntermediateSemiFinishedProductsGet();
	
	SearchStepsToComplete = New Structure("ReadyForFulfillment", True);
	
	While Queue.Next() Do
		
		NodulationParameters.ReservePFOnlySeparately = Queue.TollManufacturing;
		
		// Reading specification data
		ResultOfNodulation = ProductDecomposition.Explosion(
			Products_1.Copy(New Structure("ReferenceOrder", Queue.ReferenceOrder)),
			NodulationParameters,
			SelectionParameters);
		
		If ResultOfNodulation.HasError Then
			FillPropertyValues(ResultOfFormation, ResultOfNodulation, "HasError, ErrorText, LinkError");
			Return ResultOfFormation;
		EndIf;
		
		SpecificationsData = ResultOfNodulation.SpecificationsData;
		AddSpecificationData(SpecificationsData, Queue.ReferenceOrder);
		
		// Creating documents
		Stages = New Array;
		StagesToBeCompleted = ?(Parameters.PassStagesForExecution, New Array, Undefined);
		For IndexOf = 0 To SpecificationsData.UBound() Do
			
			SpecificationData = SpecificationsData[IndexOf];
			
			If Parameters.PassStagesForExecution Then
				SpecificationData.Stages.Columns.Add(
					"Status", New TypeDescription("EnumRef.StatusesOfProductionStages2_2"));
				For Each Stage In SpecificationData.Stages.FindRows(SearchStepsToComplete) Do
					Stage.Status = Enums.StatusesOfProductionStages2_2.ForCompletion;
					StagesToBeCompleted.Add(Stage.ProductionStage);
				EndDo;
			EndIf;
			
			References = CreateChainOfStages(SpecificationData);
			
			For Each Ref In References Do
				Stages.Add(Ref);
			EndDo;
			ResultOfFormation.GeneratedDocuments_ = ResultOfFormation.GeneratedDocuments_ + References.Count();
			
		EndDo;
		
		// Separation of output in stages requiring disassembly
		SeparateRows = Products_1.FindRows(
			New Structure("ReferenceOrder, SeparateForDisassembly", Queue.ReferenceOrder, True));
		SeparateStages = Undefined;
		If SeparateRows.UBound() <> -1 Then
			SeparateStages = CommonClientServer.CollapseArray(
				Products_1.Copy(SeparateRows, "StageSource").UnloadColumn("StageSource"));
			SeparateReleaseForDisassembly(SeparateStages, Stages);
		EndIf;
		
		InformationRegisters.StandardScheduleOfProductionStages.Calculate(Queue.ReferenceOrder);
		
		// Filling in the provision and forming movements
		FillInFormAndReflectRegisteredRecordsByStages(Parameters, Stages, TempTablesManager);
		
		// Filling in related registers
		If StagesToBeCompleted <> Undefined
			And (GetFunctionalOption("UseOperationManagement")
				Or GetFunctionalOption("UseManufacturingExecutionSystem")) Then
			
			StepsForCalculatingTaskQueue = ItIsRequiredToCalculateQueueOfOperations(StagesToBeCompleted);
			If StepsForCalculatingTaskQueue.Count() > 0 Then
				TaskDataTable = 
					InformationRegisters.JobsForCalculatingProductionOperationQueue.InitializeTaskDataTable();
				For Each StageForCalculation In StepsForCalculatingTaskQueue Do
					NewRow = TaskDataTable.Add();
					NewRow.ObjectOfARAP = StageForCalculation;
				EndDo;
				InformationRegisters.JobsForCalculatingProductionOperationQueue.AddTasks(TaskDataTable);
			EndIf;
			
		EndIf;
		
		If ProductionManagementCached.TheProductionScheduleIsUsed() Then
			InformationRegisters.JobsToProductionScheduleCalculation.AddTasks(Stages);
		EndIf;
		
		If SeparateStages = Undefined Then
			StagesToReflection = Stages;
		Else
			
			StagesToReflection = New Array;
			CommonClientServer.SupplementArray(StagesToReflection, Stages);
			
			StagesToReflection.Add(SeparateStages);
			
		EndIf;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.ProductionStageStates = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			StagesToReflection,
			"ACTION_FEFLECT_STAGES_STATE",
			RegistersToBeReflected);
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.StatesOfProductionOrders = True;
		
		DocumentsStates.AddTasksToStateOfOrders(
			Undefined,
			Queue.ReferenceOrder,,
			RegistersToBeReflected);
		
	EndDo;
	
	Return ResultOfFormation;
	
EndFunction

Function ResultOfFormationOfStages(References = Undefined)
	
	Result = New Structure;
	
	Result.Insert("HasError", False);
	Result.Insert("ErrorText", Undefined);
	Result.Insert("LinkError", Undefined);
	
	Result.Insert("GeneratedDocuments_", 0);
	
	Result.Insert("References", References);
	
	Return Result;
	
EndFunction

Procedure CheckDataForGeneratingStages(TempTablesManager, ResultOfFormation)
	
	Query = New Query(
	"SELECT
	|	Table.Ref AS Ref,
	|	Table.ProductionProcessType AS ProductionProcessType
	|FROM
	|	(SELECT TOP 1
	|		CAST(TTNeeds.ReferenceOrder AS Document.ProductionOrder2_2) AS Ref,
	|		CAST(TTNeeds.ReferenceOrder AS Document.ProductionOrder2_2).ProductionProcessType AS ProductionProcessType
	|	FROM
	|		TTDataForGeneratingStages AS TTNeeds
	|	WHERE
	|		TTNeeds.StageSource = VALUE(Document.ProductionStage2_2.EmptyRef)
	|		AND TTNeeds.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT TOP 1
	|		CAST(TTNeeds.StageSource AS Document.ProductionStage2_2) AS Ref,
	|		CAST(TTNeeds.StageSource AS Document.ProductionStage2_2).ProductionProcessType AS ProductionProcessType
	|	FROM
	|		TTDataForGeneratingStages AS TTNeeds
	|	WHERE
	|		TTNeeds.StageSource <> VALUE(Document.ProductionStage2_2.EmptyRef)
	|		AND TTNeeds.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef)
	|) AS Table");
	
	Query.TempTablesManager = TempTablesManager;
	QueryResult = Query.Execute();
	
	If Not QueryResult.IsEmpty() Then
		
		Selection = QueryResult.Select();
		Selection.Next();
		
		If Selection.ProductionProcessType = Enums.ProductionProcessTypes.Disassembly Then
			Substitution = NStr("vi = 'sản xuất (tháo gỡ)';
								|ru = 'производства (разборки)';
								|en = 'production (disassembly)'; fa = 'production (disassembly)';
								|it = 'Produzione (smontaggio)';
								|pl = 'produkcji (demontażu)';
								|tr = 'üretim (demontaj)'");
		ElsIf Selection.ProductionProcessType = Enums.ProductionProcessTypes.Repair Then
			Substitution = NStr("vi = 'sản xuất (sửa chữa)';
								|ru = 'производства (ремонта)';
								|en = 'production (R&M)'; fa = 'production (R&M)';
								|it = 'Produzione (montaggio)';
								|pl = 'produkcji (remontu)';
								|tr = 'üretim (bakım-onarım)'");
		Else
			Substitution = NStr("vi = 'sản xuất';
								|ru = 'производства';
								|en = 'production'; fa = 'production';
								|it = 'di produzione';
								|pl = 'produkcji';
								|tr = 'üretim'");
		EndIf;
		
		TextPattern = NStr("vi = 'Đối với hàng hóa %1, bạn phải tạo các bước theo cách thủ công (xem chứng từ số %2)';
							|ru = 'Для %1 изделий необходимо создать этапы вручную (см. документ № %2)';
							|en = 'For the %1 goods, create stages manually (see document No.%2)'; fa = 'For the %1 goods, create stages manually (see document No.%2)';
							|it = 'Per  %1 i prodotti è necessario creare manualmente le fasi (vedi documento  №%2 )';
							|pl = 'Dla %1 produktów konieczne jest ręczne tworzenie etapów (patrz dokument nr %2)';
							|tr = '%1 nihai ürünü için manuel aşamalar oluşturmanız gerekmektedir (bk. %2 numaralı belge)'");
		ErrorText = StrTemplate(TextPattern, Substitution, Selection.Ref);

		ResultOfFormation.HasError = True;
		ResultOfFormation.ErrorText = ErrorText;
		ResultOfFormation.LinkError = Selection.Ref;
		
	EndIf;
	
EndProcedure

Function QueueOfOrdersForFormationOfStages(TempTablesManager)
	
	Query = New Query(
	"SELECT DISTINCT
	|	Table.ReferenceOrder AS ReferenceOrder,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).BusinessOperation IN (
	|	                         VALUE(Enum.BusinessTransactions.TollManufacturing2_5)) AS TollManufacturing,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).Priority.AddlOrderingAttribute     AS Priority1,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).Department.AddlOrderingAttribute AS Priority2,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).Queue                                 AS Priority3
	|
	|FROM
	|	TTDataForGeneratingStages AS Table
	|	
	|WHERE
	|	Table.BillOfMaterials <> VALUE(Catalog.BillsOfMaterials.EmptyRef)
	|
	|ORDER BY
	|	Priority1,
	|	Priority2,
	|	Priority3
	|");
	Query.TempTablesManager = TempTablesManager;
	
	Return Query.Execute().Select();
	
EndFunction

Function ProductsAndSemiFinishedProductsForFormationOfStages(TempTablesManager)
	
	Query = New Query(
	"SELECT
	|	Table.ReferenceOrder AS ReferenceOrder,
	|	
	|	Table.AssignmentProducts AS AssignmentProducts,
	|	Table.AssignmentMaterials AS AssignmentMaterials,
	|	
	|	Table.Products   AS Products,
	|	Table.Characteristic AS Characteristic,
	|
	|	Table.Sender    AS Sender,
	|	Table.Recipient     AS Recipient,
	|	
	|	Table.StageSource   AS StageSource,
	|	Table.Purpose     AS Purpose,
	|	
	|	Table.BillOfMaterials   AS BillOfMaterials,
	|
	|	Table.ToExpenseAs         AS ToExpenseAs,
	|	Table.ExpenseItem           AS ExpenseItem,
	|	Table.DimensionOfExpenses        AS DimensionOfExpenses,
	|	Table.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	|	
	|	Table.LineNumber    AS LineNumber,
	|	
	|	Table.Count     AS Count,
	|	
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).EarliestStartDate           AS StartDate2,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).DemandDate         AS DateOfProduction,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).ProductionScheduling       AS ProductionScheduling,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).LineOfBusiness AS LineOfBusiness,
	|	CAST(Table.ReferenceOrder AS Document.ProductionOrder2_2).Department           AS ProductionDispatcherBusinessUnit,
	|
	|	Table.StageSource <> VALUE(Document.ProductionStage2_2.EmptyRef)                AS SeparateForDisassembly
	|FROM
	|	TTDataForGeneratingStages AS Table
	|	
	|WHERE
	|	Table.BillOfMaterials <> VALUE(Catalog.BillsOfMaterials.EmptyRef)
	|");
	Query.TempTablesManager = TempTablesManager;
	
	Return Query.Execute().Unload();
	
EndFunction

Procedure SeparateReleaseForDisassembly(ReferencesNeed, Software_)
	
	Query = New Query(
		"SELECT
		|	SupplyWithMaterialsAndWorks.Ref            AS StageConsumer,
		|	SupplyWithMaterialsAndWorks.Products      AS Products,
		|	SupplyWithMaterialsAndWorks.Characteristic    AS Characteristic,
		|	SupplyWithMaterialsAndWorks.Warehouse             AS Recipient,
		|	SupplyWithMaterialsAndWorks.Purpose        AS Purpose,
		|	SUM(SupplyWithMaterialsAndWorks.Count) AS Count
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS SupplyWithMaterialsAndWorks
		|WHERE
		|	SupplyWithMaterialsAndWorks.Ref IN
		|			(SELECT
		|				T.StageConsumer AS Ref
		|			FROM
		|				Document.ProductionStage2_2.ManufacturedProducts AS T
		|			WHERE
		|				T.Ref IN (&ReferencesNeed)
		|				AND T.ProcessByBOM
		|				AND T.StageConsumer <> VALUE(Document.ProductionStage2_2.EmptyRef)
		|		
		|			UNION ALL
		|		
		|			SELECT
		|				T.StageConsumer
		|			FROM
		|				Document.ProductionStage2_2.SideAndIntermediateRelease AS T
		|			WHERE
		|				T.Ref IN (&ReferencesNeed)
		|				AND T.ProcessByBOM
		|				AND T.StageConsumer <> VALUE(Document.ProductionStage2_2.EmptyRef))
		|	AND SupplyWithMaterialsAndWorks.Ref.Posted
		|	AND SupplyWithMaterialsAndWorks.Produced
		|	AND NOT SupplyWithMaterialsAndWorks.Canceled
		|
		|GROUP BY
		|	SupplyWithMaterialsAndWorks.Characteristic,
		|	SupplyWithMaterialsAndWorks.Purpose,
		|	SupplyWithMaterialsAndWorks.Products,
		|	SupplyWithMaterialsAndWorks.Warehouse,
		|	SupplyWithMaterialsAndWorks.Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SupplyWithMaterialsAndWorks.Ref.BillOfMaterials AS BillOfMaterials,
		|	SupplyWithMaterialsAndWorks.Ref              AS StageConsumer,
		|	SupplyWithMaterialsAndWorks.Products        AS Products,
		|	SupplyWithMaterialsAndWorks.Characteristic      AS Characteristic,
		|	SupplyWithMaterialsAndWorks.Purpose          AS Purpose,
		|	SupplyWithMaterialsAndWorks.Warehouse               AS Recipient,
		|	SupplyWithMaterialsAndWorks.Count          AS Count
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS SupplyWithMaterialsAndWorks
		|WHERE
		|	SupplyWithMaterialsAndWorks.Ref IN(&Software_)
		|	AND SupplyWithMaterialsAndWorks.Produced
		|	AND NOT SupplyWithMaterialsAndWorks.Canceled
		|	AND SupplyWithMaterialsAndWorks.Ref.ProductionProcessType = VALUE(Enum.ProductionProcessTypes.Disassembly)");
	Query.SetParameter("ReferencesNeed", ReferencesNeed);
	Query.SetParameter("Software_", Software_);
	ResultsArray = Query.ExecuteBatch();  
	
	SoftwareOld = ResultsArray[0].Unload();
	SoftwareOld.Indexes.Add("StageConsumer,Products,Characteristic,Recipient,Purpose");
	TheStructureOfTheSearch1 = New Structure("StageConsumer,Products,Characteristic,Recipient,Purpose");
	
	SoftwareNew = ResultsArray[1].Unload();
	SoftwareNew.Indexes.Add("BillOfMaterials,Products,Characteristic,Recipient");
	TheStructureOfTheSearch2 = New Structure("BillOfMaterials,Products,Characteristic,Recipient");
	
	TheStructureOfTheSearch = New Structure("ProcessByBOM", True);
	
	ReadyForProcessing_ = New Array;
	StructureOfActions = New Structure("RecalculateNumberOfPackages");
	CachedValues = Undefined;
	
	For Each Ref In ReferencesNeed Do
		
		Try
			
			DocumentObject = Ref.GetObject();
			DocumentObject.Lock();
			
			For Cnt = 1 To 2 Do
				
				ReadyForProcessing_.Clear();
				
				TableName = ?(Cnt=1, "ManufacturedProducts", "SideAndIntermediateRelease");
				For Each String In DocumentObject[TableName].FindRows(TheStructureOfTheSearch) Do
					
					Balance = String.Count;
					
					If Not String.StageConsumer.IsEmpty() Then
						FillPropertyValues(TheStructureOfTheSearch1, String);
						For Each Software_1 In SoftwareOld.FindRows(TheStructureOfTheSearch1) Do
							Credit_ = Min(Balance, Software_1.Count);
							Software_1.Count = Software_1.Count - Credit_;
							Balance = Balance - Credit_;
						EndDo;
					EndIf;
					If Balance = 0 Then
						Continue;
					EndIf;
					
					FillPropertyValues(TheStructureOfTheSearch2, String);
					For Each Software_1 In SoftwareNew.FindRows(TheStructureOfTheSearch2) Do
						
						Credit_ = Min(Balance, Software_1.Count);
						
						If String.Count > Credit_ Then
							NewRow = DocumentObject[TableName].Add();
							FillPropertyValues(NewRow, String);
							NewRow.Count = Credit_;
							ReadyForProcessing_.Add(NewRow);
							
							String.Count = String.Count - Credit_;
							ReadyForProcessing_.Add(String);
							
							If TableName = "ManufacturedProducts" Then
								ProductionClientServer.RecalculateFractionOfCostWhenSplittingRow(
									NewRow, String, DocumentObject.MethodOfAllocatingFinishedProductCosts);
							EndIf;
							
							FillPropertyValues(NewRow, Software_1, "Purpose, StageConsumer");
						Else
							FillPropertyValues(String, Software_1, "Purpose, StageConsumer");
						EndIf;
						
						Balance = Balance - Credit_;
						If Balance = 0 Then
							Break;
						EndIf;
						
					EndDo;
					
				EndDo;
				
				BatchProcessingOfTablePartServer.ProcessTSStrings(
					ReadyForProcessing_,
					StructureOfActions,
					DocumentObject[TableName],
					CachedValues);
				
			EndDo;
			
			SeriesSpecificationParameters = SeriesSpecificationParameters(DocumentObject);
			ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.ManufacturedProducts);
			ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SideAndIntermediateRelease);
			
			DocumentObject.DisableFillingInRegulatoryScheduleWhenRecording();
			DocumentObject.Write(DocumentWriteMode.Posting);
			DocumentObject.Unlock();
			
		Except
			
			Event = NStr("vi = 'Công đoạn sản xuất';
						|ru = 'Этап производства';
						|en = 'Production stage'; fa = 'مرحله تولید';
						|it = 'Fase di produzione';
						|pl = 'Etap produkcji';
						|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
					+ NStr("vi = 'Lập công đoạn ';
							|ru = 'Формирование этапов';
							|en = 'Generate stages'; fa = 'ایجاد مراحل';
							|it = 'Generazione delle fasi';
							|pl = 'Formowanie etapów';
							|tr = 'Aşamaların oluşturulması'", Common.DefaultLanguageCode());
			
			WriteLogEvent(Event,
				EventLogLevel.Error,,,
				DetailErrorDescription(ErrorInfo()));
		EndTry;
			
	EndDo;
	
EndProcedure

