Function QueryTextTableGoodsToBeRegisteredInReportsToConsignor(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "GoodsToBeRegisteredInReportsToConsignor";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	If DocumentObject <> Undefined
	   And Not DocumentObject.InventoryOwnerAttributesMaterials.Count() > 0 Then
		Return "";
	EndIf;
	
	InitializeProductAnalysisKeys(Query, QueryTexts, DocumentObject);
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableTypesOfStocksMaterials", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableTypesOfStocksMaterials(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText = "
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt)	AS RecordType,
	|	InventoryKinds.DateOfTransaction				AS Period,
	|	&Organization							AS Organization,
	|	InventoryKinds.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
	|	CommitteeAnalytics.DimensionKey		AS ItemsLocationAttributes,
	|	InventoryKinds.StockTypeCurrency			AS Currency,
	|	InventoryKinds.CCDNumber					AS CCDNumber,
	|	0										AS Count,
	|	0										AS RevenueAmount,
	|	0										AS RevenueAmountExclVATLocal,
	|	0										AS RevenueAmountMan,
	|	InventoryKinds.Count					AS QuantityConsumed,
	|	0										AS QuantityToRegister,
	|	0										AS QuantityForRegistrationByProductBatchID,
	|	0										AS RevenueAmountToRegister,
	|	InventoryKinds.Count					AS QuantityConsumedForIncoiceRegistration,
	|	InventoryKinds.QuantityByGBRN			AS QuantityIsWrittenOffForRegistrationByProductBatchID,
	|	InventoryKinds.AnalysisOfAccountingForProductsProducts		AS Products,
	|	InventoryKinds.AnalysisOfAccountingProductsCharacteristics	AS Characteristic,
	|	InventoryKinds.BusinessOperation		AS BusinessOperation,
	|	&ReleaseUnderActivityRedefinition	AS VATTaxation,
	|	InventoryKinds.FinRecordID		AS FinRecordID,
	|	BusinessTransactionsSettings.Ref	AS BusinessTransactionSetting,
	|	InventoryKinds.RowID         AS RowID
	|FROM
	|	DocumentDataTableTypesOfStocksMaterials AS InventoryKinds
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS CommitteeAnalytics
	|		ON CommitteeAnalytics.Products = InventoryKinds.AnalysisOfAccountingForProductsProducts
	|			AND CommitteeAnalytics.Characteristic = InventoryKinds.AnalysisOfAccountingProductsCharacteristics
	|			AND CommitteeAnalytics.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|			AND CommitteeAnalytics.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|			AND CommitteeAnalytics.StorageLocation = InventoryKinds.TypeOfInventoryOwnerAttributeOwnerOfItem
	|			AND CommitteeAnalytics.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|		
	|		LEFT JOIN Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
	|		ON BusinessTransactionsSettings.BusinessOperation = InventoryKinds.BusinessOperation
	|
	|WHERE
	|	InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|	AND (InventoryKinds.ToExpenseAs
	|		OR InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpensingToProductionLots))";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Procedure ScheduleGoodsReceipt(Query, QueryTexts, Registers, DocumentObject)
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.ManufacturedProducts.FindRows(New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		// Output items
		QueryTextDocument_ = 
		"SELECT
		|	TabularSection.Ref                               AS Ref,
		|	CASE
		|		WHEN NOT HeaderData_.ProductionByThirdParty
		|			AND NOT Storerooms.Ref IS NULL
		|			THEN TabularSection.Ref
		|		ELSE UNDEFINED
		|	END                                               AS Invoice,
		|	FALSE                                                AS Patch,
		|	UNDEFINED                                        AS CorrectedDocument,
		|	UNDEFINED                                        AS GLAccountSettings,
		|	CASE
		|		WHEN NOT HeaderData_.ProductionByThirdParty
		|			AND NOT Storerooms.Ref IS NULL
		|			THEN UNDEFINED
		|		ELSE
		|			CASE
		|				WHEN HeaderData_.ProductionByThirdParty
		|					THEN HeaderData_.SubcontractOrder
		|				ELSE TabularSection.Ref
		|			END
		|	END                                               AS OrderDocument,
		|	TabularSection.ProductionDate                     AS Date,
		|	UNDEFINED                                        AS Contract,
		|	UNDEFINED                                        AS Terms,
		|	HeaderData_.GoodsReceiptOption                   AS GoodsReceiptOption,
		|	TabularSection.Recipient                           AS Warehouse,
		|	ISNULL(OrdersToProcessor.Partner, TabularSection.Department) AS Sender,
		|	CASE
		|		WHEN HeaderData_.ProductionByThirdParty
		|			AND VALUETYPE(HeaderData_.SubcontractOrder) = TYPE(Document.SubcontractOrder2_5)
		|			THEN VALUE(Enum.BusinessTransactions.ReceiptFromToller2_5)
		|		ELSE VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
		|	END                                               AS BusinessOperation,
		|	TabularSection.Products                         AS Products,
		|	TabularSection.Characteristic                       AS Characteristic,
		|	TabularSection.Purpose                           AS Purpose,
		|	TabularSection.ToControlQuality            AS ToControlQuality,
		|	FALSE                                                AS RecordOfAPreviouslyReceivedLot,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	0                                                   AS BatchesIndicationStatus,
		|	UNDEFINED                                        AS Series,
		|	TabularSection.Count                           AS Count,
		|	NOT HeaderData_.ProductionByThirdParty
		|		AND NOT Storerooms.Ref IS NULL                  AS ThisIsAnInvoice,
		|	FALSE                                                AS ReceiptUnderOrders,
		|	FALSE                                                AS ExceedingOrder
		|FROM
		|	DocumentDataTableOutputFinishedProducts AS TabularSection
		|
		|	LEFT JOIN DocumentDataHeader AS HeaderData_
		|	ON TabularSection.Ref = HeaderData_.Ref
		|	
		|	LEFT JOIN Catalog.Warehouses AS Storerooms
		|	ON Storerooms.Ref = TabularSection.Recipient
		|	AND Storerooms.ShopFloorStockroom
