	|	TabularSection.Characteristic                               AS Characteristic,
	|	TabularSection.ItemsLocationAttributes                   AS ItemsLocationAttributes,
	|	TabularSection.ItemsLocationAttributes.Series             AS InventoryLocationAttributeAnalysisBatch,
	|	TabularSection.ItemsLocationAttributes.StorageLocation     AS ProductAccountingAnalyticsStorageLocation,
	|	TabularSection.ItemsLocationAttributes.ProductCostElement AS InventoryLocationAttributeOfItemIsProductCostElementAnalysis,
