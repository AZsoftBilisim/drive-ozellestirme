#Region QueryTextsTTInventoryTypes

Function QueryTextTTTypesOfStocks(Query, QueryTexts, RegisterName, DocumentObject)
	
	TableName = "TTTypesOfStocks";
	
	CurrentStatus = Undefined;
	If Query = Undefined
	 Or Not Query.Parameters.Property("Status", CurrentStatus)
	 Or CurrentStatus = Enums.StatusesOfProductionStages2_2.Initiated
	 Or CurrentStatus = Enums.StatusesOfProductionStages2_2.Completed Then
		
		InitializeProductAnalysisKeys(Query, QueryTexts, DocumentObject);
		SetEmptyBatchTrackingAnalyticsQueryParameter(Query);
		
		TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
		
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"TTTableOfPartyAccountingAnalysts", QueryTexts, TempTablesManager) Then
			QueryTextTTTableOfPartyAccountingAnalysts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"TTCurrencyConversionFactors", QueryTexts, TempTablesManager) Then
			QueryTextTTCurrencyConversionFactors(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableTypesOfStocksMaterials", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableTypesOfStocksMaterials(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableTypesOfProductStocks", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableTypesOfProductStocks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableProvisionOfMaterialsAndWorks",
					QueryTexts,
					TempTablesManager) Then
			QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfExpensesOfMaterialsAndWorks", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfExpensesOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOutputFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOutputFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfByFinishedProducts", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfByFinishedProducts(Query, QueryTexts, DocumentObject);
		EndIf;
		
		TextsTTTypesOfStocks = New Array;
		TextsTTTypesOfStocks.Add(QueryTextTTStockTypesMaterials());
		TextsTTTypesOfStocks.Add(QueryTextTTTypesOfProductStocks());
		TextsTTTypesOfStocks.Add(RequestTextTTTypesOfInventorySoftware());
		TextsTTTypesOfStocks.Add(RequestTextTTTypesOfInventoryWorkExpense());
		TextsTTTypesOfStocks.Add(RequestTextTTTypesOfWorkStocksOutputProducts());
		TextsTTTypesOfStocks.Add(RequestTextTTTypesOfInventoryWorkByProducts());
		
		QueryText = StrConcat(TextsTTTypesOfStocks, TMCommonUse.QuerySeparatorInJoin());
		
	Else
		
		QueryText = QueryTextTTInventoryKindsEmptyTable();
		
	EndIf;
	
	QueryTexts.Add(QueryText, TableName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTTInventoryKindsEmptyTable()
	
	Return
	"SELECT TOP 0
	|	FALSE                                                                 AS AddOnForGiver,
	|	VALUE(Catalog.Companies.EmptyRef)                        AS Organization,
	|	VALUE(Catalog.InventoryKinds.EmptyRef)                        AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	VALUE(Catalog.Companies.EmptyRef)                        AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	FALSE                                                                 AS SaleOfAnotherCompanyInventory,
	|	VALUE(Catalog.InventoryKinds.EmptyRef)                        AS InventoryOwnerAttribute,
	|	VALUE(Catalog.InventoryKinds.EmptyRef)                        AS CorInventoryOwnerAttribute,
	|	VALUE(Catalog.CCDNumbers.EmptyRef)                          AS CCDNumber,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)    AS ItemsLocationAttributes,
	|	VALUE(Catalog.Products.EmptyRef)                       AS AnalysisOfAccountingForProductsProducts,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef)         AS AnalysisOfAccountingProductsCharacteristics,
	|	VALUE(Catalog.ItemsBatches.EmptyRef)                  AS InventoryLocationAttributeAnalysisBatch,
	|	VALUE(Catalog.Assignments.EmptyRef)                         AS ItemsLocationAttributesAssignment,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)    AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	VALUE(Catalog.Products.EmptyRef)                       AS Products,
	|	VALUE(Enum.ItemsTypes.EmptyRef)                 AS ProductsTypeOfProducts,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef)         AS Characteristic,
	|	0                                                                    AS Count,
	|	VALUE(Enum.BusinessTransactions.EmptyRef)            AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.EmptyRef)     AS BusinessTransactionSetting,
	|	FALSE                                                                 AS ToExpenseAs,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)    AS CorItemsLocationAttributes,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)    AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	DATETIME(1, 1, 1)                                                   AS DateOfTransaction,
	|	UNDEFINED                                                         AS Recipient,
	|	VALUE(Catalog.BusinessStructure.EmptyRef)               AS Department,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)         AS ExpenseItem,
	|	UNDEFINED                                                         AS DimensionOfExpenses,
	|	UNDEFINED                                                         AS AssetsLiabilitiesDimension,
	|	VALUE(Catalog.OtherTransactionsGLAccountsSettings.EmptyRef) AS GLAccountSettings,
	|	UNDEFINED                                                         AS LotVendorAttributes,
	|
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS AccountingSection,
	|
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS CorAccountingSection,
	|
	|	0                                                                    AS Sum,
	|	0                                                                    AS SumMan,
	|	0                                                                    AS SumCompl,
	|	0                                                                    AS OffBalanceSheetAmount,
	|	0                                                                    AS OffBalanceSheetManAmount,
	|	0                                                                    AS OffBalanceSheetLocalAmount,
	|	""""                                                                 AS RowID,
	|	""""                                                                 AS FinRecordID,
	|	UNDEFINED                                                         AS FinancialAccountingDimension,
	|	UNDEFINED                                                         AS CorControllingAttributes
	|INTO TTTypesOfStocks
	|";
	
EndFunction

Function QueryTextTTStockTypesMaterials()
	
	Return
	"SELECT
	|	FALSE														AS AddOnForGiver,
	|	InventoryKinds.TypeOfInventoryOwnerAttributeCompany							AS Organization,
	|	InventoryKinds.InventoryOwnerAttributeInventoryOwnerAttribute					AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	InventoryKinds.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany        AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	InventoryKinds.InventoryOwnerAttributeSaleOfAnotherCompanySInventory	AS SaleOfAnotherCompanyInventory,
	|	InventoryKinds.InventoryOwnerAttribute										AS InventoryOwnerAttribute,
	|	InventoryKinds.CorInventoryOwnerAttribute									AS CorInventoryOwnerAttribute,
	|	InventoryKinds.CCDNumber										AS CCDNumber,
	|	InventoryKinds.ItemsLocationAttributes						AS ItemsLocationAttributes,
	|	InventoryKinds.ItemsLocationAttributes.Products         AS AnalysisOfAccountingForProductsProducts,
	|	InventoryKinds.ItemsLocationAttributes.Characteristic       AS AnalysisOfAccountingProductsCharacteristics,
	|	InventoryKinds.ItemsLocationAttributes.Series                AS InventoryLocationAttributeAnalysisBatch,
	|	InventoryKinds.ItemsLocationAttributes.Purpose           AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey						AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	InventoryKinds.AnalysisOfAccountingForProductsProducts			AS Products,
	|	InventoryKinds.AnalysisOfAccountingForProductsProducts.ItemsType AS ProductsTypeOfProducts,
	|	InventoryKinds.AnalysisOfAccountingProductsCharacteristics		AS Characteristic,
	|	InventoryKinds.Count										AS Count,
	|	InventoryKinds.BusinessOperation							AS BusinessOperation,
	|	BusinessTransactionsSettings.Ref						AS BusinessTransactionSetting,
	|	InventoryKinds.ToExpenseAs								AS ToExpenseAs,
	|	InventoryKinds.CorItemsLocationAttributes					AS CorItemsLocationAttributes,
	|	CorAnalyticsWithoutAssignment.DimensionKey						AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	InventoryKinds.DateOfTransaction									AS DateOfTransaction,
	|	CASE
	|		WHEN InventoryKinds.ToExpenseAs
	|			AND InventoryKinds.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN InventoryKinds.Department
	|		WHEN InventoryKinds.ToExpenseAs
	|			AND NOT InventoryKinds.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN InventoryKinds.Recipient
	|		ELSE UNDEFINED
	|	END														AS Recipient,
	|	InventoryKinds.Department									AS Department,
	|	InventoryKinds.ExpenseItem									AS ExpenseItem,
	|	InventoryKinds.DimensionOfExpenses								AS DimensionOfExpenses,
	|	InventoryKinds.AssetsLiabilitiesDimension						AS AssetsLiabilitiesDimension,
	|	InventoryKinds.GLAccountSettings							AS GLAccountSettings,
	|	UNDEFINED												AS LotVendorAttributes,
	|
	|	CASE
	// tolling materials and semi-finished products are always on a separate accounting section
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.MaterialsReceivedForProcessing)
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider)
	|		  OR InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping)
	// when spending on production batches and writing off for expenses
	// , commission goods are always redeemed and written off from the "Goods in warehouses" section.
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			AND (InventoryKinds.ToExpenseAs
	|				OR InventoryKinds.BusinessOperation =
	|							VALUE(Enum.BusinessTransactions.ExpensingToProductionLots))
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
	// commission goods are always on a separate accounting section
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
	// accepted for storage with the right to sell on a separate accounting section
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.GoodsInStorageWithRightToSell)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsAtStorageWithRightOfSale)
	// for own accounting, the accounting section is production costs
	|		ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	END														AS AccountingSection,
	|
	|	CASE
	// when writing off expenses, there is an outflow from the cost of goods 
	|		WHEN InventoryKinds.ToExpenseAs
	|			THEN UNDEFINED
	// tolling materials and semi-finished products are always on a separate accounting section
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.MaterialsReceivedForProcessing)
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider)
	|		  OR InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping)
	// write-off of own and commission materials for production batches is always in the WIP 
	|		WHEN InventoryKinds.BusinessOperation =
	|						VALUE(Enum.BusinessTransactions.ExpensingToProductionLots)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)
	// commission goods are always on a separate accounting section
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
	// accepted for storage with the right to sell on a separate accounting section
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.GoodsInStorageWithRightToSell)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsAtStorageWithRightOfSale)
	// in other cases, the recipient is the production costs
	|		ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	END														AS CorAccountingSection,
	|
	|	0															AS Sum,
	|	0															AS SumMan,
	|	0															AS SumCompl,
	|	0															AS OffBalanceSheetAmount,
	|	0															AS OffBalanceSheetManAmount,
	|	0															AS OffBalanceSheetLocalAmount,
	|	InventoryKinds.RowID								AS RowID,
	|	InventoryKinds.FinRecordID							AS FinRecordID,
	|	UNDEFINED												AS FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE
	|			UNDEFINED
	|	END														AS CorControllingAttributes
	|INTO TTTypesOfStocks
	|FROM
	|	DocumentDataTableTypesOfStocksMaterials AS InventoryKinds
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = InventoryKinds.AnalysisOfAccountingForProductsProducts
	|	AND AnalyticsWithoutAssignment.Characteristic = InventoryKinds.AnalysisOfAccountingProductsCharacteristics
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = InventoryKinds.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = InventoryKinds.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = InventoryKinds.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalyticsWithoutAssignment
	|	ON CorAnalyticsWithoutAssignment.Products = InventoryKinds.CorItemsLocationAttributesProducts
	|	AND CorAnalyticsWithoutAssignment.Characteristic = InventoryKinds.CorItemsLocationAttributesItemsCharacteristic
	|	AND CorAnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND CorAnalyticsWithoutAssignment.Series = InventoryKinds.CorItemsLocationAttributesBatch
	|	AND CorAnalyticsWithoutAssignment.StorageLocation = InventoryKinds.CorItemsLocationAttributesStorageLocation
	|	AND CorAnalyticsWithoutAssignment.ProductCostElement = InventoryKinds.CorOfInventoryLocationAttributeOfProductCostingElements
	|
	|	LEFT JOIN Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
	|	ON BusinessTransactionsSettings.BusinessOperation = InventoryKinds.BusinessOperation
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|";
	
EndFunction

// Data of output products at calculated and fixed Cost.
//
Function QueryTextTTTypesOfProductStocks()
	
	Return
	"SELECT
	|	FALSE													AS AddOnForGiver,
	|	InventoryKinds.TypeOfInventoryOwnerAttributeCompany						AS Organization,
	|	UNDEFINED											AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	VALUE(Catalog.Companies.EmptyRef)           AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	FALSE													AS SaleOfAnotherCompanyInventory,
	|	InventoryKinds.InventoryOwnerAttribute									AS InventoryOwnerAttribute,
	|	UNDEFINED											AS CorInventoryOwnerAttribute,
	|	VALUE(Catalog.CCDNumbers.EmptyRef)				AS CCDNumber,
	|	InventoryKinds.ItemsLocationAttributes					AS ItemsLocationAttributes,
	|	InventoryKinds.ItemsLocationAttributes.Products     AS AnalysisOfAccountingForProductsProducts,
	|	InventoryKinds.ItemsLocationAttributes.Characteristic   AS AnalysisOfAccountingProductsCharacteristics,
	|	InventoryKinds.ItemsLocationAttributes.Series            AS InventoryLocationAttributeAnalysisBatch,
	|	InventoryKinds.ItemsLocationAttributes.Purpose       AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey					AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	InventoryKinds.AnalysisOfAccountingForProductsProducts		AS Products,
	|	InventoryKinds.AnalysisOfAccountingForProductsProducts.ItemsType AS ProductsTypeOfProducts,
	|	InventoryKinds.AnalysisOfAccountingProductsCharacteristics	AS Characteristic,
	|	InventoryKinds.Count									AS Count,
	|	InventoryKinds.BusinessOperation						AS BusinessOperation,
	|	BusinessTransactionsSettings.Ref					AS BusinessTransactionSetting,
	|	InventoryKinds.ToExpenseAs							AS ToExpenseAs,
	// Analysis of waste accounting in production batches (with/without purpose)
	|	CorDimension.DimensionKey								AS CorItemsLocationAttributes,
	|	CorAnalyticsWithoutAssignment.DimensionKey					AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	InventoryKinds.DateOfTransaction								AS DateOfTransaction,
	|	CASE
	|		WHEN InventoryKinds.ToExpenseAs
	|				AND InventoryKinds.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN InventoryKinds.Department
	|		WHEN InventoryKinds.ToExpenseAs
	|				AND NOT InventoryKinds.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN InventoryKinds.Recipient
	|		ELSE UNDEFINED	
	|	END													AS Recipient,
	|	InventoryKinds.Department								AS Department,
	|	InventoryKinds.ExpenseItem								AS ExpenseItem,
	|	InventoryKinds.DimensionOfExpenses							AS DimensionOfExpenses,
	|	InventoryKinds.AssetsLiabilitiesDimension					AS AssetsLiabilitiesDimension,
	|	InventoryKinds.GLAccountSettings						AS GLAccountSettings,
	|	CASE
	|		WHEN InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
	|			THEN TableOfBatchAccountingAnalysts.LotVendorAttributes
	|		ELSE &AnalysisOfAccountingOfBatchesOfGoods
	|	END													AS LotVendorAttributes,
	|
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.MaterialsReceivedForProcessing)
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider)
	|		  OR InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping)
	|		ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	END													AS AccountingSection,
	|
	|	UNDEFINED											AS CorAccountingSection,
	|
	|	CASE
	// For returnable waste belonging to the giver, only the off-balance sheet value should be filled in.
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory IN (
	|				VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|				VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	|			AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|			THEN 0
	|		ELSE InventoryKinds.Sum
	|	END													AS Sum,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory IN (
	|				VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|				VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	|			AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|			THEN 0
	|		ELSE CAST(InventoryKinds.Sum * ISNULL(TTCurrencyConversionFactors.ConversionRateToManCurrency, 0) AS NUMBER(31,2))
	|	END													AS SumMan,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory IN (
	|				VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|				VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	|			AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|			THEN 0
	|		ELSE CAST(InventoryKinds.Sum * ISNULL(TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul, 0) AS NUMBER(31,2))
	|	END													AS SumCompl,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory IN (
	|				VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|				VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	|			AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|			THEN InventoryKinds.Sum
	|		ELSE 0
	|	END													AS OffBalanceSheetAmount,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory IN
	|				(VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|				VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	|			AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|			THEN CAST(InventoryKinds.Sum * ISNULL(TTCurrencyConversionFactors.ConversionRateToManCurrency, 0) AS NUMBER(31,2))
	|		ELSE 0
	|	END													AS OffBalanceSheetManAmount,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttributeIsTypeOfInventory IN
	|				(VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|				VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	|			AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|			THEN CAST(InventoryKinds.Sum * ISNULL(TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul, 0) AS NUMBER(31,2))
	|		ELSE 0
	|	END													AS OffBalanceSheetLocalAmount,
	|	InventoryKinds.RowID							AS RowID,
	|	InventoryKinds.FinRecordID						AS FinRecordID,
	|	CASE
	|		WHEN &AnalyticalAccountingByProductsGroups
	|				AND NOT InventoryKinds.InventoryLocationAttributeOfItemIsAnalyticalAccountingGroup =
	|							VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN InventoryKinds.InventoryLocationAttributeOfItemIsAnalyticalAccountingGroup
	|		ELSE UNDEFINED
	|	END													AS FinancialAccountingDimension,
	|	CASE
	|		WHEN InventoryKinds.BusinessOperation =
	|						VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|				AND NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE UNDEFINED
	|	END													AS CorControllingAttributes
	|FROM
	|	DocumentDataTableTypesOfProductStocks AS InventoryKinds
	|	
	|	INNER JOIN TTParametersOfBatchAccountingForConducting AS TTParametersOfBatchAccountingForConducting
	|	ON TTParametersOfBatchAccountingForConducting.Period = BEGINOFPERIOD(InventoryKinds.Period, MONTH)
	|		AND TTParametersOfBatchAccountingForConducting.Organization = InventoryKinds.TypeOfInventoryOwnerAttributeCompany
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = InventoryKinds.AnalysisOfAccountingForProductsProducts
	|	AND AnalyticsWithoutAssignment.Characteristic = InventoryKinds.AnalysisOfAccountingProductsCharacteristics
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = InventoryKinds.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = InventoryKinds.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = InventoryKinds.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorDimension
	|	ON CorDimension.Products = InventoryKinds.AnalysisOfAccountingForProductsProducts
	|	AND CorDimension.Characteristic = InventoryKinds.AnalysisOfAccountingProductsCharacteristics
	|	AND CorDimension.Purpose = &Purpose
	|	AND CorDimension.Series = InventoryKinds.InventoryLocationAttributeAnalysisBatch
	|	AND CorDimension.StorageLocation = InventoryKinds.Department
	|	AND CorDimension.ProductCostElement = InventoryKinds.ProductCostElement
	|	AND InventoryKinds.BusinessOperation =
	|			VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalyticsWithoutAssignment
	|	ON CorAnalyticsWithoutAssignment.Products = InventoryKinds.AnalysisOfAccountingForProductsProducts
	|	AND CorAnalyticsWithoutAssignment.Characteristic = InventoryKinds.AnalysisOfAccountingProductsCharacteristics
	|	AND CorAnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND CorAnalyticsWithoutAssignment.Series = InventoryKinds.InventoryLocationAttributeAnalysisBatch
	|	AND CorAnalyticsWithoutAssignment.StorageLocation = InventoryKinds.Department
	|	AND CorAnalyticsWithoutAssignment.ProductCostElement = InventoryKinds.ProductCostElement
	|	AND InventoryKinds.BusinessOperation =
	|			VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|	
	|	LEFT JOIN TTTableOfPartyAccountingAnalysts AS TableOfBatchAccountingAnalysts
	|	ON TableOfBatchAccountingAnalysts.RowCode = InventoryKinds.RowCode
	|	AND TableOfBatchAccountingAnalysts.TabularSectionName = ""ManufacturedProducts""
	|	AND InventoryKinds.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
	|
	|	LEFT JOIN Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
	|	ON BusinessTransactionsSettings.BusinessOperation = InventoryKinds.BusinessOperation
	|
	|	LEFT JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
	|	ON BEGINOFPERIOD(InventoryKinds.DateOfTransaction, DAY) = TTCurrencyConversionFactors.Period
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|";
	
EndFunction

Function RequestTextTTTypesOfInventorySoftware()
	
	Return
	"SELECT
	|	FALSE																AS AddOnForGiver,
	|	&Organization														AS Oragnization,
	|	UNDEFINED														AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	VALUE(Catalog.Companies.EmptyRef)                       AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	FALSE																AS SaleOfAnotherCompanyInventory,
	|	VALUE(Catalog.InventoryKinds.EmptyRef)						AS InventoryOwnerAttribute,
	|	VALUE(Catalog.InventoryKinds.EmptyRef)						AS CorInventoryOwnerAttribute,
	|	UNDEFINED														AS CCDNumber,
	|	ProvisionOfWorks.ItemsLocationAttributes						AS ItemsLocationAttributes,
	|	ProvisionOfWorks.ItemsLocationAttributes.Products         AS AnalysisOfAccountingForProductsProducts,
	|	ProvisionOfWorks.ItemsLocationAttributes.Characteristic       AS AnalysisOfAccountingProductsCharacteristics,
	|	ProvisionOfWorks.ItemsLocationAttributes.Series                AS InventoryLocationAttributeAnalysisBatch,
	|	ProvisionOfWorks.ItemsLocationAttributes.Purpose           AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey								AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	ProvisionOfWorks.Products									AS Products,
	|	ProvisionOfWorks.Products.ItemsType                    AS ProductsTypeOfProducts,
	|	ProvisionOfWorks.Characteristic									AS Characteristic,
	|	ProvisionOfWorks.Count										AS Count,
	|	VALUE(Enum.BusinessTransactions.TransferToProduction)	AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.TransferToProduction) AS BusinessTransactionSetting,
	|	FALSE																AS ToExpenseAs,
	|	ProvisionOfWorks.CorItemsLocationAttributes					AS CorItemsLocationAttributes,
	|	CorAnalyticsWithoutAssignment.DimensionKey								AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	ProvisionOfWorks.DateOfShipment									AS DateOfTransaction,
	|	UNDEFINED														AS Recipient,
	|	ProvisionOfWorks.Department									AS Department,
	|	UNDEFINED														AS ExpenseItem,
	|	UNDEFINED														AS DimensionOfExpenses,
	|	UNDEFINED														AS AssetsLiabilitiesDimension,
	|	UNDEFINED														AS GLAccountSettings,
	|	UNDEFINED														AS LotVendorAttributes,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)	AS AccountingSection,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)	AS CorAccountingSection,
	|	0																	AS Sum,
	|	0																	AS SumMan,
	|	0																	AS SumCompl,
	|	0																	AS OffBalanceSheetAmount,
	|	0																	AS OffBalanceSheetManAmount,
	|	0																	AS OffBalanceSheetLocalAmount,
	|	""""																AS RowID,
	|	ProvisionOfWorks.RowID								AS FinRecordID,
	|	UNDEFINED														AS FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE UNDEFINED
	|	END																AS CorControllingAttributes
	|FROM
	|	DocumentDataTableProvisionOfMaterialsAndWorks AS ProvisionOfWorks
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = ProvisionOfWorks.Products
	|	AND AnalyticsWithoutAssignment.Characteristic = ProvisionOfWorks.Characteristic
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = ProvisionOfWorks.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = ProvisionOfWorks.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = ProvisionOfWorks.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalyticsWithoutAssignment
	|	ON CorAnalyticsWithoutAssignment.Products = ProvisionOfWorks.Products
	|	AND CorAnalyticsWithoutAssignment.Characteristic = ProvisionOfWorks.Characteristic
	|	AND CorAnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND CorAnalyticsWithoutAssignment.Series = ProvisionOfWorks.CorItemsLocationAttributesBatch
	|	AND CorAnalyticsWithoutAssignment.StorageLocation = ProvisionOfWorks.CorItemsLocationAttributesStorageLocation
	|	AND CorAnalyticsWithoutAssignment.ProductCostElement = ProvisionOfWorks.CorOfInventoryLocationAttributeOfProductCostingElements
	|
	|	LEFT JOIN Catalog.Products AS CatalogProducts
	|	ON ProvisionOfWorks.Products = CatalogProducts.Ref
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND CatalogProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|	AND ProvisionOfWorks.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|	AND NOT ProvisionOfWorks.Canceled
	|	AND NOT (CatalogProducts.TracedGoods
	|			AND &UseTraceableImportedGoodsAccounting)
	|";
	
EndFunction

Function RequestTextTTTypesOfInventoryWorkExpense()
	
	Return
	"SELECT
	|	FALSE										AS AddOnForGiver,
	|	&Organization								AS Organization,
	|	UNDEFINED								AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	VALUE(Catalog.Companies.EmptyRef) AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	FALSE										AS SaleOfAnotherCompanyInventory,
	|	VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
	|	VALUE(Catalog.InventoryKinds.EmptyRef) AS CorInventoryOwnerAttribute,
	|	UNDEFINED								AS CCDNumber,
	|	ConsumptionOfWorks.ItemsLocationAttributes		AS ItemsLocationAttributes,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Products   AS AnalysisOfAccountingForProductsProducts,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Characteristic AS AnalysisOfAccountingProductsCharacteristics,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Series          AS InventoryLocationAttributeAnalysisBatch,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Purpose     AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey		AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	ConsumptionOfWorks.Products					AS Products,
	|	ConsumptionOfWorks.Products.ItemsType    AS ProductsTypeOfProducts,
	|	ConsumptionOfWorks.Characteristic					AS Characteristic,
	|	ConsumptionOfWorks.Count						AS Count,
	|	VALUE(Enum.BusinessTransactions.ExpensingToProductionLots) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ExpensingToProductionLots) AS BusinessTransactionSetting,
	|	FALSE										AS ToExpenseAs,
	|	ConsumptionOfWorks.CorItemsLocationAttributes	AS CorItemsLocationAttributes,
	|	CorAnalyticsWithoutAssignment.DimensionKey		AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	ConsumptionOfWorks.DateOfMaterialWorkConsumption						AS DateOfTransaction,
	|	UNDEFINED								AS Recipient,
	|	ConsumptionOfWorks.Department					AS Department,
	|	UNDEFINED								AS ExpenseItem,
	|	UNDEFINED								AS DimensionOfExpenses,
	|	UNDEFINED								AS AssetsLiabilitiesDimension,
	|	UNDEFINED								AS GLAccountSettings,
	|	UNDEFINED								AS LotVendorAttributes,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)		AS AccountingSection,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)	AS CorAccountingSection,
	|	0											AS Sum,
	|	0											AS SumMan,
	|	0											AS SumCompl,
	|	0											AS OffBalanceSheetAmount,
	|	0											AS OffBalanceSheetManAmount,
	|	0											AS OffBalanceSheetLocalAmount,
	|	""""										AS RowID,
	|	ConsumptionOfWorks.RowID				AS FinRecordID,
	|	CASE
	|		WHEN NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE UNDEFINED
	|	END										AS FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE UNDEFINED
	|	END										AS CorControllingAttributes
	|FROM
	|	DocumentDataTableOfExpensesOfMaterialsAndWorks AS ConsumptionOfWorks
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = ConsumptionOfWorks.Products
	|	AND AnalyticsWithoutAssignment.Characteristic = ConsumptionOfWorks.Characteristic
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = ConsumptionOfWorks.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = ConsumptionOfWorks.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = ConsumptionOfWorks.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalyticsWithoutAssignment
	|	ON CorAnalyticsWithoutAssignment.Products = ConsumptionOfWorks.Products
	|	AND CorAnalyticsWithoutAssignment.Characteristic = ConsumptionOfWorks.Characteristic
	|	AND CorAnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND CorAnalyticsWithoutAssignment.Series = ConsumptionOfWorks.CorItemsLocationAttributesBatch
	|	AND CorAnalyticsWithoutAssignment.StorageLocation = ConsumptionOfWorks.CorItemsLocationAttributesStorageLocation
	|	AND CorAnalyticsWithoutAssignment.ProductCostElement = ConsumptionOfWorks.CorOfInventoryLocationAttributeOfProductCostingElements
	|
	|	LEFT JOIN Catalog.Products AS CatalogProducts
	|	ON ConsumptionOfWorks.Products = CatalogProducts.Ref
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND CatalogProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT (CatalogProducts.TracedGoods
	|			AND &UseTraceableImportedGoodsAccounting)
	|
	|UNION ALL
	|
	// For traceable work on your own PD, a separate request is not for the TS of the consummentmaterials of operation write-off of the expenses of the production party 
	// , because there is no way to add the necessary lines to the TS types of inventory materials.
	// The request mostly repeats See QueryTextTTStockTypesMaterials
// , but with nuances of work.
	|SELECT
	|	FALSE														AS AddOnForGiver,
	|	InventoryKinds.TypeOfInventoryOwnerAttributeCompany							AS Organization,
	|	InventoryKinds.InventoryOwnerAttributeInventoryOwnerAttribute					AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	InventoryKinds.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany        AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	InventoryKinds.InventoryOwnerAttributeSaleOfAnotherCompanySInventory	AS SaleOfAnotherCompanyInventory,
	|	InventoryKinds.InventoryOwnerAttribute										AS InventoryOwnerAttribute,
	|	InventoryKinds.CorInventoryOwnerAttribute									AS CorInventoryOwnerAttribute,
	|	InventoryKinds.CCDNumber										AS CCDNumber,
	|	ConsumptionOfWorks.ItemsLocationAttributes						AS ItemsLocationAttributes,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Products         AS AnalysisOfAccountingForProductsProducts,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Characteristic       AS AnalysisOfAccountingProductsCharacteristics,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Series                AS InventoryLocationAttributeAnalysisBatch,
	|	ConsumptionOfWorks.ItemsLocationAttributes.Purpose           AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey						AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	InventoryKinds.CorItemsLocationAttributesProducts		AS Products,
	|	InventoryKinds.CorItemsLocationAttributesProducts.ItemsType AS ProductsTypeOfProducts,
	|	InventoryKinds.CorItemsLocationAttributesItemsCharacteristic	AS Characteristic,
	|	InventoryKinds.Count										AS Count,
	|	VALUE(Enum.BusinessTransactions.ExpensingToProductionLots) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ExpensingToProductionLots) AS BusinessTransactionSetting,
	|	InventoryKinds.ToExpenseAs								AS ToExpenseAs,
	|	ConsumptionOfWorks.CorItemsLocationAttributes					AS CorItemsLocationAttributes,
	|	CorAnalyticsWithoutAssignment.DimensionKey						AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	ConsumptionOfWorks.DateOfMaterialWorkConsumption										AS DateOfTransaction,
	|	CASE
	|		WHEN InventoryKinds.ToExpenseAs
	|			AND InventoryKinds.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN InventoryKinds.Department
	|		WHEN InventoryKinds.ToExpenseAs
	|			AND NOT InventoryKinds.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN InventoryKinds.Recipient
	|		ELSE UNDEFINED
	|	END														AS Recipient,
	|	InventoryKinds.Department									AS Department,
	|	InventoryKinds.ExpenseItem									AS ExpenseItem,
	|	InventoryKinds.DimensionOfExpenses								AS DimensionOfExpenses,
	|	InventoryKinds.AssetsLiabilitiesDimension						AS AssetsLiabilitiesDimension,
	|	InventoryKinds.GLAccountSettings							AS GLAccountSettings,
	|	UNDEFINED												AS LotVendorAttributes,
	|
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)		AS AccountingSection,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)	AS CorAccountingSection, 
	|
	|	0															AS Sum,
	|	0															AS SumMan,
	|	0															AS SumCompl,
	|	0															AS OffBalanceSheetAmount,
	|	0															AS OffBalanceSheetManAmount,
	|	0															AS OffBalanceSheetLocalAmount,
	|	""""														AS RowID,
	|	ConsumptionOfWorks.RowID								AS FinRecordID,
	|	UNDEFINED												AS FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE
	|			UNDEFINED
	|	END														AS CorControllingAttributes
	|FROM
	|	DocumentDataTableTypesOfStocksMaterials AS InventoryKinds
	|
	|	INNER JOIN DocumentDataTableOfExpensesOfMaterialsAndWorks AS ConsumptionOfWorks
	|	ON ConsumptionOfWorks.Ref = InventoryKinds.Ref
	|	AND ConsumptionOfWorks.ItemsLocationAttributes = InventoryKinds.CorItemsLocationAttributes
	|	AND ConsumptionOfWorks.Department = InventoryKinds.Department
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = ConsumptionOfWorks.Products
	|	AND AnalyticsWithoutAssignment.Characteristic = ConsumptionOfWorks.Characteristic
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = ConsumptionOfWorks.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = ConsumptionOfWorks.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = ConsumptionOfWorks.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalyticsWithoutAssignment
	|	ON CorAnalyticsWithoutAssignment.Products = ConsumptionOfWorks.Products
	|	AND CorAnalyticsWithoutAssignment.Characteristic = ConsumptionOfWorks.Characteristic
	|	AND CorAnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND CorAnalyticsWithoutAssignment.Series = ConsumptionOfWorks.CorItemsLocationAttributesBatch
	|	AND CorAnalyticsWithoutAssignment.StorageLocation = ConsumptionOfWorks.CorItemsLocationAttributesStorageLocation
	|	AND CorAnalyticsWithoutAssignment.ProductCostElement = ConsumptionOfWorks.CorOfInventoryLocationAttributeOfProductCostingElements
	|
	|	LEFT JOIN Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
	|	ON BusinessTransactionsSettings.BusinessOperation = InventoryKinds.BusinessOperation
	|
	|	LEFT JOIN Catalog.Products AS CatalogProducts
	|	ON InventoryKinds.AnalysisOfAccountingForProductsProducts = CatalogProducts.Ref
	|
	|WHERE
	|	&Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|	AND CatalogProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|	AND CatalogProducts.TracedGoods
	|	AND &UseTraceableImportedGoodsAccounting
	|	AND NOT &ProductionByThirdParty2_5
	|";
	
EndFunction

Function RequestTextTTTypesOfWorkStocksOutputProducts()
	
	Return
	"SELECT
	|	FALSE															AS AddOnForGiver,
	|	CASE
	|		WHEN &InternalSubcontracting
	|			THEN &MaterialProviderCompany
	|		ELSE &Organization
	|	END															AS Organization,
	|	UNDEFINED													AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	VALUE(Catalog.Companies.EmptyRef)                   AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	FALSE															AS SaleOfAnotherCompanyInventory,
	|	UNDEFINED													AS InventoryOwnerAttribute,
	|	UNDEFINED													AS CorInventoryOwnerAttribute,
	|	VALUE(Catalog.CCDNumbers.EmptyRef)						AS CCDNumber,
	|	Works.ItemsLocationAttributes								AS ItemsLocationAttributes,
	|	Works.ItemsLocationAttributes.Products                  AS AnalysisOfAccountingForProductsProducts,
	|	Works.ItemsLocationAttributes.Characteristic                AS AnalysisOfAccountingProductsCharacteristics,
	|	Works.ItemsLocationAttributes.Series                         AS InventoryLocationAttributeAnalysisBatch,
	|	Works.ItemsLocationAttributes.Purpose                    AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey							AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	Works.Products												AS Products,
	|	Works.Products.ItemsType                             AS ProductsTypeOfProducts,
	|	Works.Characteristic											AS Characteristic,
	|	Works.Count												AS Count,
	|	VALUE(Enum.BusinessTransactions.ProductsRelease)	AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ProductsRelease) AS BusinessTransactionSetting,
	|	Works.ToExpenseAs											AS ToExpenseAs,
	|	UNDEFINED													AS CorItemsLocationAttributes,
	|	UNDEFINED													AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	Works.ProductionDate											AS DateOfTransaction,
	|	CASE
	|		WHEN Works.ToExpenseAs
	|				AND Works.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN Works.Department
	|		WHEN Works.ToExpenseAs
	|				AND NOT Works.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN Works.Recipient
	|		ELSE UNDEFINED
	|	END															AS Recipient,
	|	Works.Department											AS Department,
	|	Works.ExpenseItem											AS ExpenseItem,
	|	Works.DimensionOfExpenses										AS DimensionOfExpenses,
	|	Works.AssetsLiabilitiesDimension									AS AssetsLiabilitiesDimension,
	|	Works.GLAccountSettings										AS GLAccountSettings,
	|	TableOfBatchAccountingAnalysts.LotVendorAttributes					AS LotVendorAttributes,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts) AS AccountingSection,
	|	UNDEFINED													AS CorAccountingSection,
	|	Works.Sum													AS Sum,
	|	CAST(Works.Sum * ISNULL(TTCurrencyConversionFactors.ConversionRateToManCurrency, 0) AS NUMBER(31,2)) AS SumMan,
	|	CAST(Works.Sum * ISNULL(TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul, 0) AS NUMBER(31,2)) AS SumCompl,
	|	0																AS OffBalanceSheetAmount,
	|	0																AS OffBalanceSheetManAmount,
	|	0																AS OffBalanceSheetLocalAmount,
	|	Works.RowID										AS RowID,
	|	Works.RowID										AS FinRecordID,
	|	CASE
	|		WHEN &AnalyticalAccountingByProductsGroups
	|				AND NOT Works.ProductsAnalyticalAccountingGroup =
	|							VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN Works.ProductsAnalyticalAccountingGroup
	|		ELSE UNDEFINED
	|	END															AS FinancialAccountingDimension,
	|	UNDEFINED													AS CorControllingAttributes
	|FROM
	|	DocumentDataTableOutputFinishedProducts AS Works
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = Works.Products
	|	AND AnalyticsWithoutAssignment.Characteristic = Works.Characteristic
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = Works.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = Works.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = Works.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|	
	|	LEFT JOIN TTTableOfPartyAccountingAnalysts AS TableOfBatchAccountingAnalysts
	|	ON TableOfBatchAccountingAnalysts.RowCode = Works.RowCode
	|	AND TableOfBatchAccountingAnalysts.TabularSectionName = ""ManufacturedProducts""
	|
	|	LEFT JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
	|	ON BEGINOFPERIOD(Works.ProductionDate, DAY) = TTCurrencyConversionFactors.Period
	|
	|WHERE
	|	Works.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT Works.ItemOfTraceableItem
	|	AND Works.Manufactured
	|	AND NOT Works.Canceled
	|	AND &Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|";
	
EndFunction

Function RequestTextTTTypesOfInventoryWorkByProducts()
	
	Return
	"SELECT
	|	FALSE										AS AddOnForGiver,
	|	CASE
	|		WHEN NOT Works.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
	|			THEN Works.ProductOwner
	|		WHEN &InternalSubcontracting
	|			THEN &MaterialProviderCompany
	|		ELSE &Organization
	|	END										AS Organization,
	|	UNDEFINED								AS InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	VALUE(Catalog.Companies.EmptyRef) AS InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany,
	|	FALSE										AS SaleOfAnotherCompanyInventory,
	|	UNDEFINED								AS InventoryOwnerAttribute,
	|	UNDEFINED								AS CorInventoryOwnerAttribute,
	|	VALUE(Catalog.CCDNumbers.EmptyRef)	AS CCDNumber,
	|	Works.ItemsLocationAttributes			AS ItemsLocationAttributes,
	|	Works.ItemsLocationAttributes.Products   AS AnalysisOfAccountingForProductsProducts,
	|	Works.ItemsLocationAttributes.Characteristic AS AnalysisOfAccountingProductsCharacteristics,
	|	Works.ItemsLocationAttributes.Series          AS InventoryLocationAttributeAnalysisBatch,
	|	Works.ItemsLocationAttributes.Purpose     AS ItemsLocationAttributesAssignment,
	|	AnalyticsWithoutAssignment.DimensionKey		AS AnalysisOfAccountingForProductsWithoutAssignment,
	|	Works.Products							AS Products,
	|	Works.Products.ItemsType         AS ProductsTypeOfProducts,
	|	Works.Characteristic						AS Characteristic,
	|	Works.Count							AS Count,
	|	VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ProductsReleaseFixCost) AS BusinessTransactionSetting,
	|	Works.ToExpenseAs						AS ToExpenseAs,
	|	CorDimension.DimensionKey					AS CorItemsLocationAttributes,
	|	CorAnalyticsWithoutAssignment.DimensionKey		AS CorAnalysisOfAccountingForProductsWithoutAssignment,
	|	Works.ProductionDate						AS DateOfTransaction,
	|	CASE
	|		WHEN Works.ToExpenseAs
	|				AND Works.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN Works.Department
	|		WHEN Works.ToExpenseAs
	|				AND NOT Works.Recipient = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			THEN Works.Recipient
	|		ELSE UNDEFINED
	|	END										AS Recipient,
	|	Works.Department						AS Department,
	|	Works.ExpenseItem						AS ExpenseItem,
	|	Works.DimensionOfExpenses					AS DimensionOfExpenses,
	|	Works.AssetsLiabilitiesDimension				AS AssetsLiabilitiesDimension,
	|	Works.GLAccountSettings					AS GLAccountSettings,
	|	&AnalysisOfWorkBatchAccounting					AS LotVendorAttributes,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts) AS AccountingSection,
	|	UNDEFINED								AS CorAccountingSection,
	|	Works.Sum								AS Sum,
	|	CAST(Works.Sum * ISNULL(TTCurrencyConversionFactors.ConversionRateToManCurrency, 0) AS NUMBER(31,2)) AS SumMan,
	|	CAST(Works.Sum * ISNULL(TTCurrencyConversionFactors.FactorOfConversionToCurrencyOfRegul, 0) AS NUMBER(31,2)) AS SumCompl,
	|	0											AS OffBalanceSheetAmount,
	|	0											AS OffBalanceSheetManAmount,
	|	0											AS OffBalanceSheetLocalAmount,
	|	Works.RowID					AS RowID,
	|	Works.RowID					AS FinRecordID,
	|	CASE
	|		WHEN &AnalyticalAccountingByProductsGroups
	|				AND NOT Works.ProductsAnalyticalAccountingGroup =
	|							VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN Works.ProductsAnalyticalAccountingGroup
	|		ELSE UNDEFINED
	|	END										AS FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &ProductionLotReferenceGroupOfManufacturedProducts = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN &ProductionLotReferenceGroupOfManufacturedProducts
	|		ELSE UNDEFINED
	|	END										AS CorControllingAttributes
	|FROM
	|	DocumentDataTableOfByFinishedProducts AS Works
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|	ON AnalyticsWithoutAssignment.Products = Works.Products
	|	AND AnalyticsWithoutAssignment.Characteristic = Works.Characteristic
	|	AND AnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND AnalyticsWithoutAssignment.Series = Works.InventoryLocationAttributeAnalysisBatch
	|	AND AnalyticsWithoutAssignment.StorageLocation = Works.ProductAccountingAnalyticsStorageLocation
	|	AND AnalyticsWithoutAssignment.ProductCostElement = Works.InventoryLocationAttributeOfItemIsProductCostElementAnalysis
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorDimension
	|	ON CorDimension.Products = Works.Products
	|	AND CorDimension.Characteristic = Works.Characteristic
	|	AND CorDimension.Purpose = &Purpose
	|	AND CorDimension.Series = Works.InventoryLocationAttributeAnalysisBatch
	|	AND CorDimension.StorageLocation = Works.Department
	|	AND CorDimension.ProductCostElement = Works.ProductCostElement
	|
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalyticsWithoutAssignment
	|	ON CorAnalyticsWithoutAssignment.Products = Works.Products
	|	AND CorAnalyticsWithoutAssignment.Characteristic = Works.Characteristic
	|	AND CorAnalyticsWithoutAssignment.Purpose = &EmptyDestinationLink
	|	AND CorAnalyticsWithoutAssignment.Series = Works.InventoryLocationAttributeAnalysisBatch
	|	AND CorAnalyticsWithoutAssignment.StorageLocation = Works.Department
	|	AND CorAnalyticsWithoutAssignment.ProductCostElement = Works.ProductCostElement
	|
	|	LEFT JOIN TTCurrencyConversionFactors AS TTCurrencyConversionFactors
	|	ON BEGINOFPERIOD(Works.ProductionDate, DAY) = TTCurrencyConversionFactors.Period
	|
	|WHERE
	|	Works.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT Works.ItemOfTraceableItem
	|	AND Works.Manufactured
	|	AND NOT Works.Canceled
	|	AND &Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|";
	
EndFunction


