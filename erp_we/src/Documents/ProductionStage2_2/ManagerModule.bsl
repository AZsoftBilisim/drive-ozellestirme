	|	NestedQuery.ProductionDateIsLessThanActualStartOfStage	AS ProductionDateIsLessThanActualStartOfStage,
	|	NestedQuery.ProductionDateIsLongerThanActualEndOfStage AS ProductionDateIsLongerThanActualEndOfStage,	
	|	NestedQuery.ExpenseDateIsLessThanActualStartOfStage,
	|	NestedQuery.ExpenseDateIsLongerThanActualEndOfStage,
	|	NestedQuery.CompletionDateIsLessThanActualStartOfStage_,
	|	NestedQuery.CompletionDateIsLongerThanActualEndOfStage,
	|	NestedQuery.ActualStageStart AS ActualStageStart,
	|	NestedQuery.ActualStageEnd AS ActualStageEnd,
	|	NestedQuery.ActualEndOfStageIsLessThanActualStartOfStage AS ActualEndOfStageIsLessThanActualStartOfStage,
	|	NestedQuery.CompanyGiverIsNotFilledIn AS CompanyGiverIsNotFilledIn,
	|	NestedQuery.CompanyGiverCoincidesWithProcessor AS CompanyGiverCoincidesWithProcessor,
	|	NestedQuery.CompanyGiverIsAssociatedWithProcessor AS CompanyGiverIsAssociatedWithProcessor,
	|	NestedQuery.LocalCurrenciesMustMatch AS LocalCurrenciesMustMatch,
	|	NestedQuery.CountriesOfRegistrationMustMatch AS CountriesOfRegistrationMustMatch
	|FROM
	|	(SELECT
	|		CASE
	|			WHEN StageDetails_.ActualStageStart = DATETIME(1,1,1)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT StageDetails_.ProductionByThirdParty
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ActualStageStart,
	|		CASE
	|			WHEN StageDetails_.ActualStageEnd = DATETIME(1,1,1)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT StageDetails_.ProductionByThirdParty
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ActualStageEnd,
	|		CASE
	|			WHEN StageDetails_.ActualStageStart > StageDetails_.ActualStageEnd
	|					AND StageDetails_.ActualStageEnd <> DATETIME(1,1,1)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT StageDetails_.ProductionByThirdParty
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ActualEndOfStageIsLessThanActualStartOfStage,
	|		CASE
	|			WHEN StageDetails_.ProductionInOneDay
	|					AND StageDetails_.ProductionDate = DATETIME(1,1,1)
	|					AND (StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|						OR StageDetails_.ProductionByThirdParty
	|							AND ISNULL(AttributesOfOrdersToProcessor.Status, VALUE(Enum.TollingOrderStatuses.EmptyRef)) IN (
	|										VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|										VALUE(Enum.TollingOrderStatuses.Closed))
	|							AND ISNULL(AttributesOfOrdersToProcessor.Posted, FALSE)
	|					)
	|					AND (RowsCount.ManufacturedProducts > 0 OR RowsCount.SideAndIntermediateRelease > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductionDateNotFilledIn,
	|		CASE
	|			WHEN StageDetails_.ProductionInOneDay
	|					AND StageDetails_.ProductionDate < BEGINOFPERIOD(StageDetails_.ActualStageStart, DAY)
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND (RowsCount.ManufacturedProductsManufactured > 0 OR RowsCount.SideAndIntermediateReleaseManufactured > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductionDateIsLessThanActualStartOfStage,
	|		CASE
	|			WHEN StageDetails_.ProductionInOneDay 
	|					AND StageDetails_.ProductionDate > StageDetails_.ActualStageEnd
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND (RowsCount.ManufacturedProductsManufactured > 0 OR RowsCount.SideAndIntermediateReleaseManufactured > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductionDateIsLongerThanActualEndOfStage,
	|		CASE
	|			WHEN StageDetails_.NotShipInInstallments
	|					AND StageDetails_.DateOfShipment = DATETIME(1,1,1)
	|					AND RowsCount.DateOfShipmentRequired_
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS DateOfShipment,
	|		CASE
	|			WHEN StageDetails_.ConsumptionInOneDay
	|					AND StageDetails_.DateOfMaterialWorkConsumption = DATETIME(1,1,1)
	|					AND (RowsCount.Expense > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS DateOfMaterialWorkConsumption,
	|		CASE
	|			WHEN StageDetails_.ConsumptionInOneDay
	|					AND StageDetails_.DateOfMaterialWorkConsumption < BEGINOFPERIOD(StageDetails_.ActualStageStart, DAY)
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND (RowsCount.Expense > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ExpenseDateIsLessThanActualStartOfStage,
	|		CASE
	|			WHEN StageDetails_.ConsumptionInOneDay
	|					AND StageDetails_.DateOfMaterialWorkConsumption > StageDetails_.ActualStageEnd
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND (RowsCount.Expense > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ExpenseDateIsLongerThanActualEndOfStage,
	|		CASE
	|			WHEN StageDetails_.WorkPerformanceAsOneDay
	|					AND StageDetails_.WorkExecutionDate = DATETIME(1,1,1)
	|					AND (RowsCount.LaborCosts > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS WorkExecutionDate,
	|		CASE
	|			WHEN StageDetails_.WorkPerformanceAsOneDay
	|					AND StageDetails_.WorkExecutionDate < BEGINOFPERIOD(StageDetails_.ActualStageStart, DAY)
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND (RowsCount.LaborCosts > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompletionDateIsLessThanActualStartOfStage_,
	|		CASE
	|			WHEN StageDetails_.WorkPerformanceAsOneDay
	|					AND StageDetails_.WorkExecutionDate > StageDetails_.ActualStageEnd
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND (RowsCount.LaborCosts > 0)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompletionDateIsLongerThanActualEndOfStage,
	|		CASE
	|			WHEN StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.SubcontractOrder = UNDEFINED
	|					AND (StageDetails_.Status IN (
	|						VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|						VALUE(Enum.StatusesOfProductionStages2_2.Completed)))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS OrderToProcessorIsNotFormalized,
	|		CASE
	|			WHEN StageDetails_.ProductionByThirdParty
	|					AND NOT StageDetails_.SubcontractOrder = UNDEFINED
	|					AND (StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Generated1)))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS OrderSentToProcessor,
	|		CASE
	|			WHEN StageDetails_.InternalSubcontracting
	|				AND StageDetails_.MaterialProviderCompany = VALUE(Catalog.Companies.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompanyGiverIsNotFilledIn,
	|		CASE
	|			WHEN StageDetails_.InternalSubcontracting
	|				AND NOT StageDetails_.MaterialProviderCompany = VALUE(Catalog.Companies.EmptyRef)
	|				AND StageDetails_.MaterialProviderCompany = StageDetails_.Organization
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompanyGiverCoincidesWithProcessor,
	|		CASE
	|			WHEN StageDetails_.InternalSubcontracting
	|				AND NOT StageDetails_.MaterialProviderCompany = VALUE(Catalog.Companies.EmptyRef)
	|				AND TTInterconnectedCompanies.Organization1 IS NOT NULL
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompanyGiverIsAssociatedWithProcessor,
	|		CASE
	|			WHEN StageDetails_.InternalSubcontracting
	|				AND NOT StageDetails_.MaterialProviderCompany = VALUE(Catalog.Companies.EmptyRef)
	|				AND NOT StageDetails_.MaterialProviderCompany.LocalAccountingCurrency = StageDetails_.Organization.LocalAccountingCurrency
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS LocalCurrenciesMustMatch,
	|		CASE
	|			WHEN StageDetails_.InternalSubcontracting
	|				AND NOT StageDetails_.MaterialProviderCompany = VALUE(Catalog.Companies.EmptyRef)
	|				AND NOT StageDetails_.MaterialProviderCompany.RegistrationCountry = StageDetails_.Organization.RegistrationCountry
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CountriesOfRegistrationMustMatch
	|	FROM
	|		StageDetails_ AS StageDetails_
	|	
	|		LEFT JOIN TTNumberOfRowsWH AS RowsCount
	|		ON StageDetails_.Ref = RowsCount.Ref
	|	
	|		LEFT JOIN AttributesOfOrdersToProcessor AS AttributesOfOrdersToProcessor
	|		ON AttributesOfOrdersToProcessor.SubcontractOrder = StageDetails_.SubcontractOrder
	|	
	|		LEFT JOIN TTInterconnectedCompanies AS TTInterconnectedCompanies
	|		ON TTInterconnectedCompanies.Organization1 = StageDetails_.MaterialProviderCompany
	|		AND TTInterconnectedCompanies.Organization2 = StageDetails_.Organization
	|
	|) AS NestedQuery
	|WHERE
	|	(NestedQuery.OrderToProcessorIsNotFormalized
	|		OR NestedQuery.OrderSentToProcessor
	|		OR NestedQuery.ProductionDateNotFilledIn
	|		OR NestedQuery.ProductionDateIsLessThanActualStartOfStage
	|		OR NestedQuery.ProductionDateIsLongerThanActualEndOfStage	
	|		OR NestedQuery.DateOfShipment
	|		OR NestedQuery.DateOfMaterialWorkConsumption
	|		OR NestedQuery.ExpenseDateIsLessThanActualStartOfStage
	|		OR NestedQuery.ExpenseDateIsLongerThanActualEndOfStage
	|		OR NestedQuery.WorkExecutionDate
	|		OR NestedQuery.CompletionDateIsLessThanActualStartOfStage_
	|		OR NestedQuery.CompletionDateIsLongerThanActualEndOfStage
	|		OR NestedQuery.ActualStageStart
	|		OR NestedQuery.ActualStageEnd
	|		OR NestedQuery.ActualEndOfStageIsLessThanActualStartOfStage
	|		OR NestedQuery.CompanyGiverIsNotFilledIn
	|		OR NestedQuery.CompanyGiverCoincidesWithProcessor
	|		OR NestedQuery.CompanyGiverIsAssociatedWithProcessor
	|		OR NestedQuery.LocalCurrenciesMustMatch
	|		OR NestedQuery.CountriesOfRegistrationMustMatch
	|	)";
	
	Catalogs.Companies.GetRelatedCompanies(TempTablesManager);
	
	Query = New Query(QueryText);
	Query.TempTablesManager = TempTablesManager;
	
	Selection = Query.Execute().Select();
	NotifyFillErrors(
		Object,
		Selection,
		AttributesList,,
		Cancel);
	
EndProcedure

