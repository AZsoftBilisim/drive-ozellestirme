#Region JobMaintenance

// Passes the steps to be completed
//
// Parameters:
//  Parameters		 - Structure - transmission parameters
//  StorageAddress	 - String	 - address of the storage where the result will be placed.
//
Procedure PassStagesToExecutionDeferred(Parameters, StorageAddress) Export
	
	Var References;
	
	If Not Parameters.Property("References", References) Then
		Return;
	EndIf;
	
	Result = New Structure("Count", 0);
	
	Query = New Query(
	"SELECT
	|	ProductionStageStates.Stage AS Ref,
	|	ProductionStageStates.Stage.ReferenceOrder AS ReferenceOrder,
	|	ProductionStageStates.Stage.ProductionLot AS ProductionLot
	|FROM
	|	InformationRegister.ProductionStageStates AS ProductionStageStates
	|WHERE
	|	ProductionStageStates.ReferenceOrder IN (&References)
	|	AND ProductionStageStates.StateAtIntershopLevel = &ReadyForFulfillment");
	Query.SetParameter("References", References);
	Query.SetParameter("ReadyForFulfillment", Enums.StateOfProductionStagesAtIntershopLevel.ReadyForFulfillment);
	
	QueryResult = Query.Execute();
	
	If Not QueryResult.IsEmpty() Then
		
		GeneratedStatus = Enums.StatusesOfProductionStages2_2.Generated1;
		
		Selection = QueryResult.Select();
		
		While Selection.Next() Do
			
			BeginTransaction();
			Try
				
				Block = New DataLock;
				LockItem = Block.Add("Document.ProductionStage2_2");
				LockItem.SetValue("Ref", Selection.Ref);
				Block.Lock();
				
				DocumentObject = Selection.Ref.GetObject(); // DocumentObject - 
				If DocumentObject = Undefined Or DocumentObject.Status <> GeneratedStatus Then
					Raise NStr("vi = 'Đối tượng được xử lý không tương ứng các điều kiện lọc.';
								|ru = 'Обрабатываемый объект не соответствует условиям отбора.';
								|en = 'Processed object does not match filter conditions.'; fa = 'Processed object does not match filter conditions.';
								|it = 'L''oggetto in fase di elaborazione non è conforme alle condizioni di selezione.';
								|pl = 'Obrabiany obiekt nie spełnia warunków wyboru.';
								|tr = 'İşlenen nesne filtre koşullarına uygun değildir.'");
				EndIf;
				
				DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion;
				
				DocumentObject.SetPacketTransferModeToExecute();
				
				DocumentObject.Write(DocumentWriteMode.Posting);
				
				CommitTransaction();
				
			Except
				
				RollbackTransaction();
				
				EventLogEvent = ProductionServer.EventSendingStagesToExecution();
				
				MessageText = NStr("vi = 'Không thể chuyển sang kỳ thực hiện: %Ref% vì lý do: %Cause%';
									|ru = 'Не удалось передать к выполнению этап: %Ref% по причине: %Cause%';
									|en = 'Cannot pass the stage for completion: %Ref%. Reason: %Cause%'; fa = 'Cannot pass the stage for completion: %Ref%. Reason: %Cause%';
									|it = 'Impossibile passare alla fase di esecuzione: %Ref% a causa di: %Cause%';
									|pl = 'Nie powiodło się przekazanie do wykonania etapu %Ref% z powodu: %Cause%';
									|tr = 'Aşama gerçekleştirmeye aktarılamadı: %Ref% çünkü: %Cause%'");
				
				MessageText = StrReplace(MessageText, "%Ref%", Selection.Ref);
				MessageText = StrReplace(MessageText, "%Cause%", DetailErrorDescription(ErrorInfo()));
				
				WriteLogEvent(
					EventLogEvent,
					EventLogLevel.Warning,
					Selection.Ref.Metadata(),
					Selection.Ref,
					MessageText);
				
				Continue;
				
			EndTry;
			
			Result.Count = Result.Count + 1;
			
		EndDo;
		
		RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
		RegistersToBeReflected.StatesOfProductionOrders = True;
		
		DocumentsStates.AddTasksToStateOfOrders(Undefined, References,, RegistersToBeReflected);
		
		If UseOperationsInStages() Then
			
			InformationRegisters.JobsForCalculatingProductionOperationQueue.StartJobs();
			
		EndIf;
		
	EndIf;
	
	PutToTempStorage(Result, StorageAddress);
	ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
	
EndProcedure

// Marks for deletion the chain of stages for the passed selection.
//
// Parameters:
//  Filter		     - Structure - parameter structure
//  StorageAddress	 - String	 - address of the storage where the result will be placed.
//
Procedure MarkStagesDeferredForDeletion(Filter, StorageAddress) Export
	
	If TypeOf(Filter) = Type("Array") Then
		
		Result = New Structure("QuantityProcessed,HasErrors,LinkError",0,False);
		For Each FilterElement In Filter Do
			
			PortionResult = MarkStagesForDeletion(FilterElement);
			
			Result.QuantityProcessed = Result.QuantityProcessed + PortionResult.QuantityProcessed;
			
			If PortionResult.HasErrors Then
				FillPropertyValues(Result,PortionResult,,"QuantityProcessed");
				Break;
			EndIf;
			
		EndDo;
		
	Else
		
		Result = MarkStagesForDeletion(Filter);
		
	EndIf;
	
	PutToTempStorage(Result, StorageAddress);
	ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
	
EndProcedure

// Performs the necessary actions in the queue of tasks for processing production stages.
//
// Parameters:
//  Jobs - ValueTable - the columns correspond to the measurements, resources and Attributes of the register of information
//                              "Processing tasks of the production stage", there are also service columns:
//             * ProductionStage       - DocumentRef.ProductionStage2_2 -
//             * RecordID    - UUID -
//             * NotUsedRegistrationDay - Number  -
//             * RefreshStatus      - Boolean -
//             * FillInAccordingToOperations   - Boolean -
//             * RecordDate             - Date   -
//             * JobID   - UUID - Service_
//             * TaskDate_            - Date                    - Service_
//  IdsOfUnprocessedRecords - Map of UUID - The key is the identifier 
//                                                                                   of the failed (giving an error during
//                                                                                   execution) entries
//                                                                                   of the Job queue information register
//                                                                                   (measurement
//                                                                                   of the record identifier of the Job queue information register),
//                                                                                  the value is the Presentation of the error.
//  AdditionalProperties - See InformationRegisters.JobsForProcessingProductionStages.AdditionalProperties
//
Procedure ProcessDocumentDeferred(
			Jobs,
			IdsOfUnprocessedRecords,
			AdditionalProperties = Undefined) Export
	
	SetPrivilegedMode(True);
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	Jobs.ProductionStage     AS ProductionStage,
	|	Jobs.RefreshStatus    AS RefreshStatus,
	|	Jobs.FillInAccordingToOperations AS FillInAccordingToOperations,
	|	Jobs.RecordID  AS RecordID,
	|	Jobs.RecordDate           AS RecordDate
	|INTO Jobs
	|FROM
	|	&Jobs AS Jobs
	|
	|INDEX BY
	|	ProductionStage
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Jobs.ProductionStage              AS ProductionStage,
	|	CASE
	|		WHEN NOT Jobs.RefreshStatus AND NOT Jobs.FillInAccordingToOperations
	|			THEN TRUE
	|		ELSE Jobs.RefreshStatus
	|	END                                 AS RefreshStatus,
	|	CASE
	|		WHEN NOT Jobs.RefreshStatus AND NOT Jobs.FillInAccordingToOperations
	|			THEN TRUE
	|		ELSE Jobs.FillInAccordingToOperations
	|	END                                 AS FillInAccordingToOperations,
	|	DocumentAttributes.ReferenceOrder       AS ReferenceOrder,
	|	DocumentAttributes.ProductionLot AS ProductionLot,
	|	CASE
	|		WHEN (ISNULL(DocumentAttributes.Department.UseManufacturingExecutionSystem, FALSE)
	|				OR ISNULL(DocumentAttributes.Department.UseShiftTasks, FALSE))
	|			AND DocumentAttributes.Status IN (
	|					VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|					VALUE(Enum.StatusesOfProductionStages2_2.Initiated))
	|				THEN TRUE
	|		WHEN ISNULL(DocumentAttributes.Department.UseOperationManagement, FALSE)
	|			AND DocumentAttributes.Status = VALUE(Enum.StatusesOfProductionStages2_2.Initiated)
	|				THEN TRUE
	|		WHEN (ISNULL(DocumentAttributes.Department.UseManufacturingExecutionSystem, FALSE)
	|				OR ISNULL(DocumentAttributes.Department.UseOperationManagement, FALSE))
	|			AND DocumentAttributes.Status IN (
	|					VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
	|					VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|					VALUE(Enum.StatusesOfProductionStages2_2.Initiated))
	|			AND TRUE IN (SELECT TOP 1
	|							TRUE
	|						FROM
	|							Document.ProductionOperation2_2 AS ProductionOperation
	|						WHERE
	|							ProductionOperation.Stage = DocumentAttributes.Ref
	|							AND NOT ProductionOperation.BasedOnMasterData
	|							AND ProductionOperation.Posted
	|							AND ProductionOperation.Status = VALUE(Enum.ProductionOperationStatuses.Executed))
	|				THEN TRUE
	|		ELSE FALSE
	|	END
	|	AND DocumentAttributes.Posted         AS YouNeedToReflectExecutionOfOperations,
	|	Jobs.RecordID           AS RecordID,
	|	Jobs.RecordDate                    AS RecordDate,
	|	
	|	PRESENTATION(Jobs.ProductionStage) AS ProductionStagePresentation
	|
	|FROM
	|	Jobs AS Jobs
	|		LEFT JOIN Document.ProductionStage2_2 AS DocumentAttributes
	|		ON Jobs.ProductionStage = DocumentAttributes.Ref
	|
	|ORDER BY
	|	RecordDate,
	|	ProductionStage
	|
	|TOTALS
	|	MAX(RefreshStatus)                   AS RefreshStatus,
	|	MAX(FillInAccordingToOperations)                AS FillInAccordingToOperations,
	|	MAX(ReferenceOrder)                        AS ReferenceOrder,
	|	MAX(ProductionLot)                  AS ProductionLot,
	|	MAX(YouNeedToReflectExecutionOfOperations) AS YouNeedToReflectExecutionOfOperations,
	|	MAX(RecordID)                 AS RecordID,
	|	MIN(RecordDate)                           AS RecordDate
	|BY
	|	ProductionStage
	|";
	
	Query.SetParameter("Jobs", Jobs);
	
	QueryResult = Query.Execute();
	
	MetaOfRegister = Undefined;
	EventName   = Undefined;
	
	ErrorFields   = Undefined;
	
	TaskIdsForStageBlockingErrors = Undefined;
	If AdditionalProperties <> Undefined Then
		TaskIdsForStageBlockingErrors = AdditionalProperties.TaskIdsForStageBlockingErrors;
	EndIf;
	
	Selection = QueryResult.Select(QueryResultIteration.ByGroups);
	While Selection.Next() Do
		
		Ref = Selection.ProductionStage;
		
		If Selection.FillInAccordingToOperations And Selection.YouNeedToReflectExecutionOfOperations Then
			OperationData_ = Documents.ProductionOperation2_2.DataOfOperationsPerformed(Ref);
		EndIf;
		
		ItIsRequiredToPopulateByOperationsManually = False;
		
		OperationCompleted = True;
		
		BlockingDataForEditingHasBeenCompleted = Undefined;
		
		BeginTransaction();
		
		Try
			
			Block = New DataLock;
			LockItem = Block.Add("Document.ProductionStage2_2");
			LockItem.SetValue("Ref", Ref);
			Block.Lock();
			
			If Selection.FillInAccordingToOperations And Selection.YouNeedToReflectExecutionOfOperations Then
				
				BlockingDataForEditingHasBeenCompleted = False;
				
				LockDataForEdit(Ref);
				
				BlockingDataForEditingHasBeenCompleted = True;
				
				ItIsRequiredToPopulateByOperationsManually = True;
				
				DocumentObject = Ref.GetObject();
				DocumentObject.FillInAccordingToOperations(OperationData_);
				
				If DocumentObject.CheckFilling() Then
					DocumentObject.Write(DocumentWriteMode.Posting);
				Else
					DocumentObject.Read();
					DocumentObject.ItIsRequiredToPopulateByOperationsManually = True;
					DocumentObject.DataExchange.Load = True;
					DocumentObject.Write(DocumentWriteMode.Write);
				EndIf;
				
			EndIf;
			
			CommitTransaction();
			
		Except
			
			RollbackTransaction();
			
			If MetaOfRegister = Undefined Then
				MetaOfRegister = Metadata.InformationRegisters.JobsForProcessingProductionStages;
				EventName   = DeferredJobs.EventName();
			EndIf;
			
			ExceptionText = ErrorProcessing.DetailErrorDescription(ErrorInfo());
			
			WriteLogEvent(EventName, EventLogLevel.Error, MetaOfRegister,, ExceptionText);
			
			If TransactionActive() Then
				Raise ErrorProcessing.BriefErrorDescription(ErrorInfo());
			EndIf;
			
			OperationCompleted = False;
			
		EndTry;
		
		If Not OperationCompleted Then
			
			Try
				
				If ItIsRequiredToPopulateByOperationsManually Then
					DocumentObject = Ref.GetObject();
					DocumentObject.ItIsRequiredToPopulateByOperationsManually = True;
					DocumentObject.DataExchange.Load = True;
					DocumentObject.Write(DocumentWriteMode.Write);
				EndIf;
				
			Except
				
				WriteLogEvent(
					EventName,
					EventLogLevel.Error,
					MetaOfRegister,,
					ErrorProcessing.DetailErrorDescription(ErrorInfo()));
				
			EndTry;
			
			If ErrorFields = Undefined Then
				ErrorFields = New Structure;
				ErrorFields.Insert("ProductionStagePresentation", "ProductionStage");
				ErrorFields.Insert("RefreshStatus");
				ErrorFields.Insert("FillInAccordingToOperations");
				ErrorFields.Insert("YouNeedToReflectExecutionOfOperations");
			EndIf;
			
			ErrorText = DeferredJobs.ExecutionErrorText(ErrorFields, Selection, ExceptionText);
			
			IDsSelection = Selection.Select();
			While IDsSelection.Next() Do
				
				RecordID = IDsSelection.RecordID;
				
				IdsOfUnprocessedRecords.Insert(RecordID, ErrorText);
				
				If BlockingDataForEditingHasBeenCompleted = False
				   And TaskIdsForStageBlockingErrors <> Undefined Then
					TaskIdsForStageBlockingErrors.Add(RecordID);
				EndIf;
				
			EndDo;
			
		EndIf;
		
		If Selection.RefreshStatus Then
			
			RegistersToBeReflected = DocumentsStates.RegistersToReflectStateOfOrders();
			RegistersToBeReflected.ProductionStageStates = True;
			
			DocumentsStates.AddTasksToStateOfOrders(
				Undefined,
				Ref,
				"Action_Refresh_State_operations",
				RegistersToBeReflected);
			
		EndIf;
		
	EndDo;
	
EndProcedure

