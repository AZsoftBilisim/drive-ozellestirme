#Region ChainOfStages

#Region StageConnections

// Returns a chain of stages by production batch.
//
// Parameters:
//  ProductionLot	 - CatalogRef.ProductionLots	 - production batch.
//  Direction			 - SortDirection				 - the direction of sorting stages in the chain.
//
// Returns:
//  Array - chain of stages
//
Function ChainOfStages(ProductionLot, Direction = Undefined) Export
	
	QueryText = 
	"SELECT
	|	Table.Ref AS Ref
	|FROM
	|	Document.ProductionStage2_2 AS Table
	|WHERE
	|	Table.ProductionLot = &ProductionLot
	|	AND NOT Table.DeletionMark
	|";
	
	If Direction <> Undefined Then
		TextConnection_ = "
		|	LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS RegulatorySchedule
		|		ON Table.Ref = RegulatorySchedule.ProductionStage
		|";
		If Direction = SortDirection.Asc Then
			TextOrdering = "ORDER BY ISNULL(RegulatorySchedule.DurationBeforeStart, -Table.DurationBeforeProductionIssue)";
		ElsIf Direction = SortDirection.Desc Then
			TextOrdering = "ORDER BY ISNULL(RegulatorySchedule.DurationBeforeProductionIssue, Table.DurationBeforeProductionIssue)";
		EndIf;
		
		TextSourceTable = "Document.ProductionStage2_2 AS Table";
		QueryText = StrReplace(QueryText, TextSourceTable, TextSourceTable + TextConnection_);
		
		QueryText = QueryText + Chars.LF + TextOrdering;
		
	EndIf;
	
	Query = New Query(QueryText);
	Query.SetParameter("ProductionLot", ProductionLot);
	Return Query.Execute().Unload().UnloadColumn(0);
	
EndFunction

// Returns the child of a chain of stages
//
// Parameters:
//  ProductionLot	 - CatalogRef.ProductionLots	 - production batch.
//
// Returns:
//   - Array - all child stages.
//
Function ChildChains(ProductionLot)
	
	ChildChains = New Array();
	Query = New Query(
	"SELECT DISTINCT
	|	ChildChains.ProductionLot AS ProductionLot
	|INTO TTChildChains
	|FROM (
	|SELECT
	|	Table.StageConsumer.ProductionLot AS ProductionLot
	|FROM
	|	Document.ProductionStage2_2.ManufacturedProducts AS Table
	|WHERE
	|	Table.Ref IN(&ReferencesArrray)
	|	AND Table.ProcessByBOM
	|	AND NOT Table.Canceled
	|	AND NOT Table.StageConsumer.DeletionMark
	|	AND Table.Ref.ProductionLot <> Table.StageConsumer.ProductionLot
	|
	|UNION ALL
	|
	|SELECT
	|	Table.Ref.ProductionLot
	|FROM
	|	Document.ProductionStage2_2.ManufacturedProducts AS Table
	|WHERE
	|	Table.StageConsumer IN(&ReferencesArrray)
	|	AND NOT Table.ProcessByBOM
	|	AND NOT Table.Canceled
	|	AND NOT Table.Ref.DeletionMark
	|	AND Table.StageConsumer.ProductionLot <> Table.Ref.ProductionLot
	|
	|UNION ALL
	|
	|SELECT
	|	Table.StageConsumer.ProductionLot AS ProductionLot
	|FROM
	|	Document.ProductionStage2_2.SideAndIntermediateRelease AS Table
	|WHERE
	|	Table.Ref IN(&ReferencesArrray)
	|	AND Table.ProcessByBOM
	|	AND NOT Table.Canceled
	|	AND NOT Table.StageConsumer.DeletionMark
	|	AND Table.Ref.ProductionLot <> Table.StageConsumer.ProductionLot
	|
	|UNION ALL
	|
	|SELECT
	|	Table.Ref.ProductionLot
	|FROM
	|	Document.ProductionStage2_2.SideAndIntermediateRelease AS Table
	|WHERE
	|	Table.StageConsumer IN(&ReferencesArrray)
	|	AND NOT Table.ProcessByBOM
	|	AND NOT Table.Canceled
	|	AND NOT Table.Ref.DeletionMark
	|	AND Table.StageConsumer.ProductionLot <> Table.Ref.ProductionLot
	|
	|) AS ChildChains
	|
	|WHERE
	|	NOT ChildChains.ProductionLot IN (&ArrayOfChildChains)
	|
	|INDEX BY
	|	ProductionLot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Document.Ref AS Ref,
	|	Document.ProductionLot AS ProductionLot
	|FROM
	|	TTChildChains AS ChildChains
	|		LEFT JOIN Document.ProductionStage2_2 AS Document
	|		ON ChildChains.ProductionLot = Document.ProductionLot
	|WHERE
	|	NOT Document.DeletionMark");
	
	Queue = ChainOfStages(ProductionLot);
	
	While Queue.Count() > 0 Do
		
		Query.SetParameter("ReferencesArrray", Queue);
		Query.SetParameter("ArrayOfChildChains", ChildChains);
		
		Selection = Query.Execute().Select();
		Queue.Clear();
		
		While Selection.Next() Do
			Queue.Add(Selection.Ref);
			ChildChains.Add(Selection.ProductionLot);
		EndDo;
		
	EndDo;
	
	Return ChildChains;
	
EndFunction

// Returns the closest followers
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage or list of stages.
//
// Returns:
//   - Array - an array of closest followers.
//
Function Successors(Ref) Export
	
	Query = New Query(
		"SELECT
		|	Table.Stage AS Follower
		|FROM
		|	Document.ProductionStage2_2.Successors AS Table
		|WHERE
		|	Table.Ref IN (&Ref)
		|	AND Table.Stage.Posted
		|
		|UNION
		|
		|SELECT
		|	Table.Ref
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|WHERE
		|	Table.PlanNotEarlierThan IN (&Ref)
		|	AND Table.Posted");
	
	Query.SetParameter("Ref", Ref);
	
	QueryResult = Query.Execute();
	
	If QueryResult.IsEmpty() Then
		
		Return New Array;
		
	Else
		
		Return QueryResult.Unload().UnloadColumn(0);
		
	EndIf;
	
EndFunction

// Returns the closest predecessors
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage.
//
// Returns:
//   - Array - an array of the closest predecessors.
//
Function Predecessors(Ref) Export
	
	Query = New Query(
		"SELECT
		|	Table.Ref AS Predecessor
		|FROM
		|	Document.ProductionStage2_2.Successors AS Table
		|WHERE
		|	Table.Stage = &Ref
		|	AND Table.Ref.Posted
		|
		|UNION
		|
		|SELECT
		|	CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2)
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|WHERE
		|	Table.Ref = &Ref
		|	AND CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2) <> VALUE(Document.ProductionStage2_2.EmptyRef)
		|	AND CAST(Table.PlanNotEarlierThan AS Document.ProductionStage2_2).Posted");
	
	Query.SetParameter("Ref", Ref);
	
	QueryResult = Query.Execute();
	
	If QueryResult.IsEmpty() Then
		
		Return New Array;
		
	Else
		
		Return QueryResult.Unload().UnloadColumn(0);
		
	EndIf;
	
EndFunction


