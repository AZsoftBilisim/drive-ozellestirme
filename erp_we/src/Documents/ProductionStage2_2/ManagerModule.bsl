			"&TextOfFieldTablePartCCDNumber_",
			"TabularSection",
			"CCDNumber",
			"TabularSection.CCDNumber",
			"VALUE(Catalog.CCDNumbers.EmptyRef)");
		
		QueryTexts.Add(QueryText);
		Query.SetParameter("ManufacturedProducts", DataOfProductionStages.ManufacturedProducts);
		
	EndIf;
	
	If DataOfProductionStages.CheckingTSSideAndIntermediateRelease Then
		
		QueryText = 
		"SELECT
		|	TabularSection.Ref,
		|	TabularSection.LineNumber,
		|	TabularSection.Products,
		|	TabularSection.Characteristic,
		|	TabularSection.Package,
		|	TabularSection.NumberOfPackages,
		|	TabularSection.Count,
		|	TabularSection.ToExpenseAs,
		|	TabularSection.ExpenseItem,
		|	TabularSection.Purpose,
		|	TabularSection.StageConsumer,
		|	TabularSection.Recipient,
		|	TabularSection.Manufactured,
		|	TabularSection.ProductionDate,
