Procedure ProductionTaskOutputOutputProducts(PrintParameters, SpreadsheetDocument, Template, SampleDocument, DataForPrint)
	If Not ProductionAssignmentPrintOutputProducts(PrintParameters) Then
		Return;
	Else
		
		SamplingOutputProducts = DataForPrint.SamplingOutputProducts;
		
		TheStructureOfTheSearch = New Structure("Ref", SampleDocument.Ref);
		If Not SamplingOutputProducts.FindNext(TheStructureOfTheSearch) Then
			Return;
		EndIf;
		
	EndIf;
	
	ColumnOfCodes = PrintFormGeneration.AdditionalColumnOfDocumentPrintForms();
	NameOfCodeColumn = ColumnOfCodes.ColumnName;
	PresentationOfCodesColumn = ColumnOfCodes.ColumnPresentation;
	OutputCodes = ValueIsFilled(NameOfCodeColumn);
	
	HeaderArea_ = Template.GetArea("TableTitleOutputProducts");
	SpreadsheetDocument.Put(HeaderArea_);
	
	If OutputCodes Then
		
		SectionHeader = Template.GetArea("TableHeaderOutputProducts_CODE");
		SectionHeader.Parameters.NameOfCodeColumn = PresentationOfCodesColumn;
		
		AreaNameString = "TableRowOutputProducts_CCode";
		AreaRow = Template.GetArea(AreaNameString);
		
	Else
		
		SectionHeader = Template.GetArea("TableHeaderOutputProducts_WithoutCode");
		
		AreaNameString = "TableRowOutputProducts_WithoutCode";
		AreaRow = Template.GetArea(AreaNameString);
		
	EndIf;
	
	SpreadsheetDocument.Put(SectionHeader);
		
	LineNumber = 0;
	Selection = SamplingOutputProducts.Select();
	While Selection.Next() Do
		
		AreaRow.Parameters.Fill(Selection);
		
		LineNumber = LineNumber + 1;
		AreaRow.Parameters.LineNumber = LineNumber;
		
		If OutputCodes Then
			AreaRow.Parameters.SKU = Selection[NameOfCodeColumn];
		EndIf;
		
		AdditionalParametersProductPresentation = ProductsClientServer.AdditionalParametersPresentationOfProductsForPrinting();
		AdditionalParametersProductPresentation.DefaultLanguageCode = Common.DefaultLanguageCode();
		
		ProductPresentation = ProductsClientServer.PresentationOfProductsForPrinting(
				Selection.ProductFullName,
				Selection.CharacteristicFullName,
				,
				,
				AdditionalParametersProductPresentation);
		AreaRow.Parameters.ProductPresentation = ProductPresentation;
		
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
	If ProductionTaskAddBlankLinesToOutputProducts(PrintParameters) Then
		
		AreaRow = Template.GetArea(AreaNameString);
		ProductionTaskOutputEmptyLines(SpreadsheetDocument, AreaRow, LineNumber);
		
	EndIf;
	
	BasementArea = Template.GetArea("BasementTableOutputProducts");
	SpreadsheetDocument.Put(BasementArea);
	
EndProcedure

// Displays of operations
//
// Parameters:
//  PrintParameters - Structure
//  SpreadsheetDocument - SpreadsheetDocument - Table document
//  Template - SpreadsheetDocument, DataCompositionAppearanceTemplate, ActiveDocumentShell, GeographicalSchema, TextDocument, HTMLDocumentShell, BinaryData, GraphicalSchema, DataCompositionSchema -
//  SampleDocument - QueryResultSelection - Contains:
// * Ref - DocumentRef
Procedure ProductionAndOperationsAssignment(PrintParameters, SpreadsheetDocument, Template, SampleDocument)
	
	If Not ProductionAndOperationsAssignment_(PrintParameters)
		Or Not SampleDocument.UseOperationManagement Then
		Return;
	Else
		SpreadsheetDocument.PutHorizontalPageBreak();
	EndIf;
	
	HeaderArea_ = Template.GetArea("TableHeaderTechnologicalProcess");
	HeaderArea_.Parameters.Fill(SampleDocument);
	SpreadsheetDocument.Put(HeaderArea_);
	
	SectionHeader = Template.GetArea("HeaderOfTechnologicalProcessTable");
	SpreadsheetDocument.Put(SectionHeader);
	
	AreaRow = Template.GetArea("TableRowTechnologicalProcess");
	LineNumber = 0;
	
	Operations = InformationRegisters.QueueOfProductionOperations.ListOfOperationsAccordingToStageData(
		DataForCalculatingOperationQueue(SampleDocument.Ref)[SampleDocument.Ref], True);
	
	For Each Operation In Operations Do
		
		AreaRow.Parameters.Fill(Operation);
		
		LineNumber = LineNumber + 1;
		AreaRow.Parameters.LineNumber = LineNumber;
		
		If Operation.ExecutionTimeUnitOfMeasure = Enums.TimeMeasureUnits.Hour Then
			
			TimeClock = Operation.RunTime;
			
		Else
			
			TimeSeconds = ProductionPlanningClientServer.GetTimeInSeconds(
				Operation.RunTime, Operation.ExecutionTimeUnitOfMeasure);
				
			TimeClock = ProductionPlanningClientServer.GetTimeInUnit(
				TimeSeconds, Enums.TimeMeasureUnits.Hour);
				
		EndIf;
		
		AreaRow.Parameters.TimeClock = TimeClock;
		
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
	BasementArea = Template.GetArea("BasementTableTechnologicalProcess");
	SpreadsheetDocument.Put(BasementArea);
	
EndProcedure

Procedure ProductionTaskOutputEmptyLines(SpreadsheetDocument, AreaRow, LineNumber)
	
	Count = LineNumber/5;
	
	If Not Count = Int(Count) Then
		Count = Int(Count) + 1;
	EndIf;
	
	For Cnt = 1 To Count Do
		
		LineNumber = LineNumber + 1;
		AreaRow.Parameters.LineNumber = LineNumber;
		
		SpreadsheetDocument.Put(AreaRow);
		
	EndDo;
	
EndProcedure

