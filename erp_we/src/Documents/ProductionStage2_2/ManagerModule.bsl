// Returns stage data for calculating the queue of production operations.
//
// Parameters:
//  References - DocumentRef.ProductionStage2_2, Array of DocumentRef.ProductionStage2_2 - stage of production.
//  UseCurrentQueueOfOperations - Undefined,Boolean - the need to include in the result an existing list of operations from the queue register
//
// Returns:
//  Map of KeyAndValue:
//   * Key - DocumentRef.ProductionStage2_2 - link to the stage.
//   * Value - Structure:
//        * Key - String - property name.
//        * Value - String - the value of the property.
//
Function DataForCalculatingOperationQueue(References, UseCurrentQueueOfOperations = Undefined) Export
	
	QueryText = "
	|SELECT
	|	DocumentAttributes.Ref                        AS Ref,
	|	DocumentAttributes.Posted                      AS Posted,
	|	DocumentAttributes.Status                        AS Status,
	|	DocumentAttributes.ReferenceOrder                  AS ReferenceOrder,
	|	DocumentAttributes.Department                 AS Department,
	|	DocumentAttributes.BillOfMaterials                  AS BillOfMaterials,
	|	DocumentAttributes.Stage                          AS BOMStage,
	|	DocumentAttributes.LineOfBusiness       AS LineOfBusiness,
	|
	|	DocumentAttributes.ProductionLot                                                                      AS ProductionLot,
	|	DocumentAttributes.ProductionLot.MainProductProducts                                          AS Products,
	|	DocumentAttributes.ProductionLot.MainProductCharacteristic                                        AS Characteristic,
	|	CAST(DocumentAttributes.ProductionLot.Document AS Document.ProductionOrder2_2).Department AS ProductionDispatcherBusinessUnit,
	|	CAST(DocumentAttributes.ProductionLot.Document AS Document.ProductionOrder2_2).EarliestStartDate AS ProductionStart,
	|
	|	DocumentAttributes.NumberOfPackagesPlan  AS NumberOfPackagesPlan,
	|	DocumentAttributes.PackagePlan            AS PackagePlan,
	|	ISNULL(&PackagingFactor, 1)          AS PackagingFactor,
	|
	|	ISNULL(TechnicalProcess.FirstOperationID, 0)     AS FirstOperationID,
	|	ISNULL(TechnicalProcess.LastOperationID, 0)  AS LastOperationID,
	|	ISNULL(TechnicalProcess.CanceledLastOperation, 0)       AS CanceledLastOperation,
	|	&TechProcessParameters,
	|
	|	ISNULL(DocumentAttributes.Department.UseOperationManagement, FALSE) AS UseOperationManagement,
	|	ISNULL(DocumentAttributes.Department.UseShiftTasks, FALSE) AS UseShiftTasks,
	|	ISNULL(DocumentAttributes.Department.UseManufacturingExecutionSystem, FALSE) AS UseManufacturingExecutionSystem,
	|
	|	FALSE AS ThereAreUnfinishedOperations
	|
	|FROM
	|	Document.ProductionStage2_2 AS DocumentAttributes
	|
	|	LEFT JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcess
	|	ON DocumentAttributes.Ref = TechnicalProcess.Stage
	|
	|WHERE
	|	DocumentAttributes.Ref IN (&References)
	|";
	
	QueryTextPackagingFactor = Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"DocumentAttributes.PackagePlan",
		"DocumentAttributes.ProductionLot.MainProductProducts");
		
	QueryText = StrReplace(
		QueryText,
		"&PackagingFactor",
		QueryTextPackagingFactor);
		
	QueryText = StrReplace(QueryText,
		"&TechProcessParameters",
		ProductionProcessEditor.QueryTextParametersOfTechnicalProcessOfStage());
		
	QueriesTexts = New Array;
	QueriesTexts.Add(QueryText);
	
	RequestTextParameters = InformationRegisters.QueueOfProductionOperations.RequestTextParametersQueueOfOperations();
	RequestTextParameters.AttributesOfContractorOfOperation = True;
	RequestTextParameters.AttributesForCalculatingTimeOfOperation = True;
	RequestTextParameters.ExtendedAttributesOfOperations = True;
	RequestTextParameters.ExecutionIndicators = True;
	RequestTextParameters.Filters.Add("Queue.Stage IN (&References)");
	QueriesTexts.Add(InformationRegisters.QueueOfProductionOperations.QueryTextOperationQueue(RequestTextParameters));
	
	Query = New Query;
	Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	Query.SetParameter("References", References);
	
	SetPrivilegedMode(True);
	Results = Query.ExecuteBatch();
	SetPrivilegedMode(False);
	
	OperationsOfStages = Results[1].Unload();
	OperationsOfStages.Indexes.Add("Stage");
	
	Selection = Results[0].Select();
	
	Result = New Map();
	
	While Selection.Next() Do
		Data_Stage = New Structure(
			"Ref,
			|Posted,
			|Status,
			|ReferenceOrder,
			|Department,
			|BillOfMaterials,
			|BOMStage,
			|LineOfBusiness,
			|ProductionDispatcherBusinessUnit,
			|ProductionStart,
			|LineOfBusiness,
			|ProductionDispatcherBusinessUnit,
			|ProductionStart,
			|TechnologicalProcessType,
			|TechnologicalProcess,
			|TechnologicalProcessFactor,
			|FirstOperationID,
			|LastOperationID,
			|CanceledLastOperation,
			|ProductionLot,
			|Products,
			|Characteristic,
			|NumberOfPackagesPlan,
			|PackagingFactor,
			|RequiredToCalculate,
			|UseOperationManagement,
			|UseShiftTasks,
			|UseManufacturingExecutionSystem,
			|ThereAreTechnologicalOperations,
			|ThereAreUnfinishedOperations,
			|InArchive");
		FillPropertyValues(Data_Stage, Selection);
		OperationLines = OperationsOfStages.FindRows(New Structure("Stage", Selection.Ref));
		If OperationLines.Count() > 0 Then
			TransactionTable = Catalogs.ManufacturingOperations.OperationTableConstructor();
			For Each LineOperation In OperationLines Do
				If UseCurrentQueueOfOperations = True
					Or (UseCurrentQueueOfOperations = Undefined
						And Selection.TechnologicalProcessType = Enums.TechnologicalProcessTypesOfStage.Individual_) Then
					NewRow = TransactionTable.Add();
					FillPropertyValues(NewRow, LineOperation);
					NewRow.OperationPresentation = LineOperation.Description;
					ZoomRatio = ?(NewRow.TechnologicalProcessFactor > 1, NewRow.TechnologicalProcessFactor, 1);
					ProductionAccountingClientServer.CalculateTotalOperationTime(NewRow, ZoomRatio);
				EndIf;
				If LineOperation.Scheduled > LineOperation.Completed2 + LineOperation.Skipped3 + LineOperation.DefectiveGoods Then
					Data_Stage.ThereAreUnfinishedOperations = True;
				EndIf;
			EndDo;
			If TransactionTable.Count() > 0 Then
				TransactionTable.Sort("OperationNumber,OperationPresentation");
				Data_Stage.Insert("Operations", TransactionTable);
			EndIf;
		EndIf;
		Data_Stage.RequiredToCalculate = QueueAttributesNeedToBeCalculated(Data_Stage);
		Data_Stage.InArchive = ArchiveQueueAttributes(Data_Stage);
		Result.Insert(Selection.Ref, Data_Stage);
	EndDo;
	
	Return Result;
	
EndFunction

// Generates an array of documentlink.The stage of production2_2 requiring the calculation of the queue of production operations.
//  At the same time, the State of stage operations will be analyzed when it is not batch creation of stages.
//
// Parameters:
//  References - DocumentRef.ProductionStage2_2, Array of DocumentRef.ProductionStage2_2 - stage of production.
//  ThisIsNotBatchFormationOfStages - Boolean - indicates that the stages were started from the point where they were modified (and not created in batches)
//
// Returns:
//  Array of DocumentRef.ProductionStage2_2 
//
Function ItIsRequiredToCalculateQueueOfOperations(Val References, ThisIsNotBatchFormationOfStages = False) Export
	
	ArrayOfStagesForQueueCalculation = New Array;
	
	QueryText = "
	|SELECT
	|	DocumentAttributes.Ref                        AS Ref,
	|	DocumentAttributes.Posted                      AS Posted,
	|	DocumentAttributes.Status                        AS Status,
	|	&TechProcessParameters,
	|
	|	ISNULL(DocumentAttributes.Department.UseOperationManagement, FALSE) AS UseOperationManagement,
	|	ISNULL(DocumentAttributes.Department.UseShiftTasks, FALSE) AS UseShiftTasks,
	|	ISNULL(DocumentAttributes.Department.UseManufacturingExecutionSystem, FALSE) AS UseManufacturingExecutionSystem,
	|
	|	FALSE AS ThereAreUnfinishedOperations
	|
	|FROM
	|	Document.ProductionStage2_2 AS DocumentAttributes
	|
	|	LEFT JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcess
	|	ON DocumentAttributes.Ref = TechnicalProcess.Stage
	|
	|WHERE
	|	DocumentAttributes.Ref IN (&References)
	|";
	
	QueryText = StrReplace(QueryText,
		"&TechProcessParameters",
		ProductionProcessEditor.QueryTextParametersOfTechnicalProcessOfStage(,, 
							"TechnologicalProcessType, ThereAreTechnologicalOperations"));
		
	If ThisIsNotBatchFormationOfStages Then
			
		QueriesTexts = New Array;
		QueriesTexts.Add(QueryText);
		
		RequestTextParameters = InformationRegisters.QueueOfProductionOperations.RequestTextParametersQueueOfOperations();
		RequestTextParameters.ExecutionIndicators = True;
		RequestTextParameters.Filters.Add("Queue.Stage IN (&References)");
		QueriesTexts.Add(InformationRegisters.QueueOfProductionOperations.QueryTextOperationQueue(RequestTextParameters));
		
		Query = New Query;
		Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
		Query.SetParameter("References", References);
		
		SetPrivilegedMode(True);
		Results = Query.ExecuteBatch();
		SetPrivilegedMode(False);
		
		OperationsOfStages = Results[1].Unload();
		OperationsOfStages.Indexes.Add("Stage");
		
		Selection = Results[0].Select();
		
	Else
		
		Query = New Query;
		Query.Text = QueryText;
		Query.SetParameter("References", References);

		SetPrivilegedMode(True);
		QueryResult = Query.Execute();
		SetPrivilegedMode(False);
		
		Selection = QueryResult.Select();
		
	EndIf;
	
	While Selection.Next() Do
		
		Data_Stage = New Structure(
			"Posted,
			|Status,
			|UseOperationManagement,
			|UseShiftTasks,
			|UseManufacturingExecutionSystem,
			|ThereAreTechnologicalOperations,
			|ThereAreUnfinishedOperations");
		FillPropertyValues(Data_Stage, Selection); 
		If ThisIsNotBatchFormationOfStages Then
			
			OperationLines = OperationsOfStages.FindRows(New Structure("Stage", Selection.Ref));
			If OperationLines.Count() > 0  Then
				For Each LineOperation In OperationLines Do
					If LineOperation.Scheduled > LineOperation.Completed2 + LineOperation.Skipped3 + LineOperation.DefectiveGoods Then
						Data_Stage.ThereAreUnfinishedOperations = True;
						Break;
					EndIf;
				EndDo;
			EndIf;
			
		EndIf;
		
		If QueueAttributesNeedToBeCalculated(Data_Stage) Then
			ArrayOfStagesForQueueCalculation.Add(Selection.Ref);
		EndIf;
		
	EndDo;
	
	Return ArrayOfStagesForQueueCalculation;
	
EndFunction

