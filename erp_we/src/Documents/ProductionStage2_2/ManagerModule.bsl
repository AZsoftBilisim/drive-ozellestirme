			+ NStr("vi = 'Chia lô';
					|ru = 'Деление партии';
					|en = 'Lot division'; fa = 'Lot division';
					|it = 'Divisione lotto';
					|pl = 'Podział partii';
					|tr = 'Lotun bölünmesi'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,,,
			DetailErrorDescription(ErrorInfo()));
		
		Raise BriefErrorDescription(ErrorInfo());
		
	EndTry;
	
	For Each Ref In LinksToBlocking Do
		UnlockDataForEdit(Ref, FormIdentifier);
	EndDo;
	
	Return Result;
	
EndFunction

// Adds a defective finished product to the tabular part of the release at the calculated cost.
// 
// Parameters:
//  BatchData - See ProductionBatchData
//  Parameters - Structure
//  Product - ValueTableRow, Structure - defective Finishedproduct data
//	FormIdentifier - UUID - id of the form that initiated
//		the data change. Used to lock data for editing.
// 
// Returns:
//  Structure
//
Function AddNonconformity(BatchData, Parameters, Product, FormIdentifier = Undefined) Export
	
	Result = DataProcessors.ProductionLotDivision.ResultOfProcessingConstructor();
	
	Stage = Parameters.Stage;
	NumberOfPackagingUnitsNonconformity = Parameters.NumberOfPackagingUnitsNonconformity;
	PackagingDefectiveGoods = Parameters.PackagingDefectiveGoods;
	FillInCOSTShares = Parameters.FillInCOSTShares;
	SetOfSeries = Parameters.SetOfSeries;
	
	LinksToBlocking = CommonClientServer.ValueInArray(Stage);
	If Product.CancelChangeFinishedProductInOrder Then
		LinksToBlocking.Add(BatchData.ReferenceOrder);
	EndIf;
	
	Try
		For Each Ref In LinksToBlocking Do
			LockDataForEdit(Ref,, FormIdentifier);
		EndDo;
		
		DocumentObject = Stage.GetObject();
		
		// Reduction of the main finishedproduct
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("Products", BatchData.MainProductProducts);
		TheStructureOfTheSearch.Insert("Characteristic", BatchData.MainProductCharacteristic);
		TheStructureOfTheSearch.Insert("Manufactured", False);
		TheStructureOfTheSearch.Insert("Canceled", False);
		
		SeriesSearchStructure = New Structure("Products, Characteristic, Recipient, Purpose, Manufactured, ProductionDate, Department");
		
		StructureOfActions = New Structure("RecalculateNumberOfPackages");
		CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
		
		NonconformityPackingRatio = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(
			PackagingDefectiveGoods, BatchData.MainProductProducts);
		Balance = NumberOfPackagingUnitsNonconformity * NonconformityPackingRatio;
		
		RowsToProcess = New Array;
		For Each String In DocumentObject.ManufacturedProducts.FindRows(TheStructureOfTheSearch) Do
			Count = Min(String.Count, Balance);
			If Count = 0 Then
				Continue;
			EndIf;
			
			If String.BatchesIndicationStatus <> 0 Then
				RemainderOfSeries_ = Count;
				FillPropertyValues(SeriesSearchStructure, String);
				
				For Each RowSeries In DocumentObject.BatchFinishedProducts.FindRows(SeriesSearchStructure) Do
					NumberOfSeries_ = Min(RowSeries.Count, RemainderOfSeries_);
					
					If RowSeries.Count = NumberOfSeries_ Then
						DocumentObject.BatchFinishedProducts.Delete(RowSeries);
					Else
						RowSeries.Count = RowSeries.Count - NumberOfSeries_;
					EndIf;
					
					RemainderOfSeries_ = RemainderOfSeries_ - NumberOfSeries_;
					If RemainderOfSeries_ = 0 Then
						Break;
					EndIf;
				EndDo;
			EndIf;
			
			If String.Count = Count Then
				DocumentObject.ManufacturedProducts.Delete(String);
			Else
				String.Count = String.Count - Count;
				RowsToProcess.Add(String);
			EndIf;
			
			Balance = Balance - Count;
			If Balance = 0 Then
				Break;
			EndIf;
		EndDo;
		
			BatchProcessingOfTablePartServer.ProcessTSStrings(
			RowsToProcess,
			StructureOfActions,
			DocumentObject.ManufacturedProducts,
			CachedValues);
		
		// Filling in the cost shares
		If FillInCOSTShares Then
			For Each String In DocumentObject.ManufacturedProducts Do
				String.CostShare = String.Count;
			EndDo;
		EndIf;
		
		// Defective FINISHEDproduct
		NewRow = DocumentObject.ManufacturedProducts.Add();
		FillPropertyValues(NewRow, Product);
		
		If DocumentObject.PackageActualData = PackagingDefectiveGoods Then
			DocumentObject.NumberOfPackagesReal = DocumentObject.NumberOfPackagesReal + NumberOfPackagingUnitsNonconformity;
		EndIf;
		
		For Each String In SetOfSeries Do
			FillPropertyValues(DocumentObject.BatchFinishedProducts.Add(), String);
		EndDo;
		ProductsServer.FillInStatusesForSpecifyingSeries(
			DocumentObject, SeriesSpecificationParameters(DocumentObject).ManufacturedProducts);
		
		// Posting
		If DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion Then
			DocumentObject.SetStatus("Initiated", Undefined);
		EndIf;
		
		DocumentWritten = ConductWithDowngradedStatus(DocumentObject);
		
		If DocumentWritten Then
			Result.ChangedStage.Add(DocumentObject.Ref);
		Else
			Result.StageIsNotRecorded.Add(DocumentObject.Ref);
		EndIf;
		
		// Order change
		If Product.CancelChangeFinishedProductInOrder Then
			OrderObject = BatchData.ReferenceOrder.GetObject(); // DocumentObject.ProductionOrder2_2
			
			OrderObject.CancelProducts(
				BatchData.MainProductProducts,
				BatchData.MainProductCharacteristic,
				BatchData.BillOfMaterials,
				NumberOfPackagingUnitsNonconformity * NonconformityPackingRatio,
				Product.ReasonForCancelingFinishedProduct);
			
			OrderObject.Write(DocumentWriteMode.Posting);
			Result.OrderChanged.Add(OrderObject.Ref);
		EndIf;
	Except
		For Each Ref In LinksToBlocking Do
			UnlockDataForEdit(Ref, FormIdentifier);
		EndDo;
		
		Event = NStr("vi = 'Công đoạn sản xuất';
					|ru = 'Этап производства';
					|en = 'Production stage'; fa = 'مرحله تولید';
					|it = 'Этап производства';
					|pl = 'Etap produkcji';
					|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Thêm hàng hỏng';
					|ru = 'Добавление брака';
					|en = 'Add nonconformity'; fa = 'Add nonconformity';
					|it = 'Добавление брака';
					|pl = 'Add nonconformity';
					|tr = 'Bozuk ürün ekle'", Common.DefaultLanguageCode());
		
		WriteLogEvent(Event,
			EventLogLevel.Error,,,
			ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		Raise ErrorProcessing.BriefErrorDescription(ErrorInfo());
	EndTry;
	
	For Each Ref In LinksToBlocking Do
		UnlockDataForEdit(Ref, FormIdentifier);
	EndDo;
	
	Return Result;
	
EndFunction

Procedure ReFillInBatchesInBackground(Parameters, StorageAddress) Export
	
	BatchTable_ = Parameters.Lots;
	
	Cancel = False;
	ResultsArray = New Array;
	
	For Each String In BatchTable_ Do
		
		ResultByLine = ReFillBatch(
			String.ProductionLot,
			New Structure("Stage", String.Stage),
			Parameters.FormIdentifier);
			
		If ResultByLine.Cancel Then
			
			For Each MessageText In ResultByLine.Messages Do
				WriteLogEvent(
					NStr("vi = 'Điền lại lô hàng theo bảng kê chi tiết';
						|ru = 'Перезаполнение партий по спецификации';
						|en = 'Refill lots by BOM'; fa = 'Refill lots by BOM';
						|it = 'Ricompilazione lotti in base alla specifica';
						|pl = 'Ponowne wypełnienie partii według specyfikacji';
						|tr = 'Ürün reçetesine göre lotların yeniden doldurulması'", Common.DefaultLanguageCode()),
					EventLogLevel.Error,,,
					MessageText);
			EndDo;
			
			Cancel = True;
			
		EndIf;
		
		ResultsArray.Add(ResultByLine);
		
	EndDo;
	
	PutToTempStorage(
		New Structure("Cancel, ResultsArray", Cancel, ResultsArray),
		StorageAddress);
	
EndProcedure

