	Object.UnusedMaterials.Load(Result);
	
EndProcedure

// Set the ship action.
// 
// Parameters:
//  Object - DocumentObject.ProductionStage2_2
//
Procedure SetShipAction(Object) Export
	
	If Object.NotShipInInstallments Then
		DateOfTransaction = Object.DateOfShipment;
	Else
		DateOfTransaction = BegOfDay(CurrentSessionDate());
	EndIf;
	
	RowsWithEmptyWarehouse = New Array;
	
	For Each RowData In Object.SupplyWithMaterialsAndWorks Do
		
		If RowData.SupplyOption = Enums.SupplyOptions.Ship
				Or RowData.Canceled Then
			Continue;
		EndIf;
		
		RowData.DateOfShipment = DateOfTransaction;
		RowData.SupplyOption = Enums.SupplyOptions.Ship;
		
		If Not RowData.Produced
			And Not ValueIsFilled(RowData.Warehouse) Then
			// The warehouse may not be full if provision was not planned
			// You need to fill it with the default value.
			RowsWithEmptyWarehouse.Add(RowData);
		EndIf;
		
	EndDo; 
	
	// Filling empty warehouses
	If RowsWithEmptyWarehouse.Count() <> 0 Then
		
		TableOfMaterials = New ValueTable;
		TableOfMaterials.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
		TableOfMaterials.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
		TableOfMaterials.Columns.Add("Department", New TypeDescription("CatalogRef.BusinessStructure"));
		
		For Each RowData In RowsWithEmptyWarehouse Do
			FillPropertyValues(TableOfMaterials.Add(), RowData);
		EndDo;
		
		SecurityParameters = ProductionSupply.ProductListSupportParameters(TableOfMaterials);
		SecurityParameters.Indexes.Add("Products,Characteristic,Department");
		
		TheStructureOfTheSearch = New Structure("Products,Characteristic,Department");
		For Each RowData In RowsWithEmptyWarehouse Do
			
			FillPropertyValues(TheStructureOfTheSearch, RowData);
			StringsList = SecurityParameters.FindRows(TheStructureOfTheSearch);
			RowData.Warehouse = StringsList[0].Warehouse;
			
		EndDo;
		
	EndIf; 
	
EndProcedure

Procedure CancelShipAction(Object) Export
	
	For Each RowData In Object.SupplyWithMaterialsAndWorks Do
		
		If RowData.SupplyOption = Enums.SupplyOptions.Ship
				And Not RowData.Canceled Then
			RowData.SupplyOption = Enums.SupplyOptions.ToSupply;
		EndIf; 
		
	EndDo; 
	
EndProcedure

Procedure CancelReserveAction(Object) Export
	
	For Each RowData In Object.SupplyWithMaterialsAndWorks Do
		
		If (RowData.SupplyOption = Enums.SupplyOptions.FromWarehouse
					Or RowData.SupplyOption = Enums.SupplyOptions.ReserveAsReceived)
				And Not RowData.Canceled Then
			RowData.SupplyOption = Enums.SupplyOptions.ToSupply;
		EndIf;
		
	EndDo;
	
EndProcedure

Function CalculateMaterialConsumption(TempTablesManager, DateOfMaterialWorkConsumption = '00010101', Synchronize = False) Export
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	Supply.Ref            AS Ref,
	|	Supply.DateOfTransaction      AS DateOfTransaction,
	|	Supply.DateOfTransaction      AS DateOfMaterialWorkConsumption,
	|	Supply.Department     AS Department,
	|	Supply.Products      AS Products,
	|	Supply.Characteristic    AS Characteristic,
	|	Supply.Series             AS Series,
	|	Supply.ProductCostElement AS ProductCostElement,
	|	Supply.Package          AS Package,
	|	SUM(Supply.Count) AS Count
	|FROM
	|	Supply AS Supply
	|WHERE
	|	Supply.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|		OR CAST(Supply.Products AS Catalog.Products).UseVariants =
	|				VALUE(Enum.ItemVariantsUsageOptions.DontUse)
	|	
	|GROUP BY
	|	Supply.Ref,
	|	Supply.DateOfTransaction,
	|	Supply.Department,
	|	Supply.Products,
	|	Supply.Characteristic,
	|	Supply.Series,
	|	Supply.ProductCostElement,
	|	Supply.Package
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Savings.Ref            AS Ref,
	|	Savings.DateOfTransaction      AS DateOfTransaction,
	|	Savings.Department     AS Department,
	|	Savings.Products      AS Products,
	|	Savings.Characteristic    AS Characteristic,
	|	Savings.Series             AS Series,
	|	SUM(Savings.Count) AS Count
	|FROM
	|	Savings AS Savings
	|WHERE
	|	Savings.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|		OR CAST(Savings.Products AS Catalog.Products).UseVariants =
	|				VALUE(Enum.ItemVariantsUsageOptions.DontUse)
	|		
	|GROUP BY
	|	Savings.Ref,
	|	Savings.DateOfTransaction,
	|	Savings.Department,
	|	Savings.Products,
	|	Savings.Characteristic,
	|	Savings.Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ConsumptionFilledSeries.Ref              AS Ref,
	|	ConsumptionFilledSeries.Department       AS Department,
	|	ConsumptionFilledSeries.LineNumber         AS LineNumber,
	|	ConsumptionFilledSeries.RowID AS RowID,
	|	ConsumptionFilledSeries.Products        AS Products,
	|	ConsumptionFilledSeries.Characteristic      AS Characteristic,
	|	ConsumptionFilledSeries.Series               AS Series,
	|	ConsumptionFilledSeries.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	ConsumptionFilledSeries.ProductCostElement   AS ProductCostElement,
	|	ConsumptionFilledSeries.Package            AS Package,
	|	ConsumptionFilledSeries.DateOfMaterialWorkConsumption         AS DateOfMaterialWorkConsumption,
	|	ConsumptionFilledSeries.Count          AS Count
	|FROM
	|	ConsumptionFilledSeries AS ConsumptionFilledSeries
	|
	|ORDER BY
	|	ConsumptionFilledSeries.Ref,
	|	ConsumptionFilledSeries.LineNumber
	|";
	
	Result = Query.ExecuteBatch();
	UBound = Result.UBound();
	
	ShippedMaterials = Result[UBound - 2].Unload(); // ValueTable - 
	If Not Synchronize Then
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, Series, ProductCostElement");
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, Series");
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, ProductCostElement");
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic");
	Else
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, Series, ProductCostElement, DateOfMaterialWorkConsumption");
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, ProductCostElement, DateOfMaterialWorkConsumption");
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, Series, DateOfTransaction");
		ShippedMaterials.Indexes.Add("Ref, Department, Products, Characteristic, DateOfTransaction");
	EndIf;
	
	UnusedMaterials					= Result[UBound - 1].Unload();
	ConsumptionOfMaterialsAndWorksToEnsure	= Result[UBound].Unload();
	
	MaterialsAndWorksConsumption = ProductionManagement.TabularPartOfDocumentProductionStage("MaterialsAndWorksConsumption");
	TMCommonUse.AddRowsToTable(MaterialsAndWorksConsumption, ConsumptionOfMaterialsAndWorksToEnsure); 
	
	// We will provide the expense in the context of series and calculation articles
	If Synchronize Then
		FilterFields = "Ref, Department, Products, Characteristic, Series, ProductCostElement, DateOfMaterialWorkConsumption";
	Else
		FilterFields = "Ref, Department, Products, Characteristic, Series, ProductCostElement";
	EndIf;
	
	FilterStructure1 = New Structure(FilterFields);
	AdjustTables(ShippedMaterials, ConsumptionOfMaterialsAndWorksToEnsure, FilterStructure1);
	
	// We will provide savings in the context of series
	If Synchronize Then
		FilterFields = "Ref, Department, Products, Characteristic, Series, DateOfTransaction";
	Else
		FilterFields = "Ref, Department, Products, Characteristic, Series";
	EndIf;
	
	FilterStructure1 = New Structure(FilterFields);
	AdjustTables(ShippedMaterials, UnusedMaterials, FilterStructure1);
	
	// We will provide the remainder of the flow from the empty series
	If Synchronize Then
		FilterFields = "Ref, Department, Products, Characteristic, ProductCostElement, DateOfMaterialWorkConsumption";
	Else
		FilterFields = "Ref, Department, Products, Characteristic, ProductCostElement";
	EndIf;
	
	FilterStructure1 = New Structure(FilterFields);
	FilterStructure1.Insert("Series", Catalogs.ItemsBatches.EmptyRef());
	AdjustTables(ShippedMaterials, ConsumptionOfMaterialsAndWorksToEnsure, FilterStructure1, FilterFields);
	
	// We will provide the remaining savings without taking into account the series
	If Synchronize Then
		FilterFields = "Ref, Department, Products, Characteristic, DateOfTransaction";
	Else
		FilterFields = "Ref, Department, Products, Characteristic";
	EndIf;
	
	FilterStructure1 = New Structure(FilterFields);
	AdjustTables(ShippedMaterials, UnusedMaterials, FilterStructure1);
	
	If Synchronize Then
		
		MaterialsAndWorksConsumption.Indexes.Add("LineNumber");
		
		// Synchronizing the expense with the provision
		FilterStructure1 = New Structure("LineNumber");
		AdjustTables(MaterialsAndWorksConsumption, ConsumptionOfMaterialsAndWorksToEnsure, FilterStructure1);

		// Updating line numbers
		For Each TableRow In MaterialsAndWorksConsumption Do
			TableRow.LineNumber = MaterialsAndWorksConsumption.IndexOf(TableRow) + 1;
		EndDo;
	
	Else
	
		// We will provide the remaining consumption without taking into account the series
		FilterFields = "Ref, Department, Products, Characteristic, ProductCostElement";
		
		FilterStructure1 = New Structure(FilterFields);
		AdjustTables(ShippedMaterials, ConsumptionOfMaterialsAndWorksToEnsure, FilterStructure1);
	
	EndIf;
	
	// We will transfer the remaining collateral to the expense and restart the series
	For Each String In ShippedMaterials Do
		
		If String.Count = 0 Then
			Continue;
		EndIf;
		
		NewRow = MaterialsAndWorksConsumption.Add();
		FillPropertyValues(NewRow, String);
		If Not Synchronize Then
			NewRow.DateOfMaterialWorkConsumption = DateOfMaterialWorkConsumption;
		EndIf;
		
		NewRow.LineNumber = MaterialsAndWorksConsumption.Count();
		
	EndDo;
	
	// Let's recalculate the number of packages in the expense
	DataStructure_ = New Structure;
	DataStructure_.Insert(
		"RecalculateNumberOfPackages",
		BatchProcessingOfTablePartClientServer.StructureOfRecalculationOfNumberOfPackages());
	CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
	
	BatchProcessingOfTablePartServer.TreatTS(MaterialsAndWorksConsumption, DataStructure_, CachedValues);
	
	Return MaterialsAndWorksConsumption;
	
EndFunction

Function CalculateMaterialSavings(TempTablesManager, DateOfTransaction = '00010101') Export
	
	Query = New Query(
	"SELECT
	|	Expense.Ref AS Ref,
	|	Expense.Department AS Department,
	|	Expense.Products AS Products,
	|	Expense.Characteristic AS Characteristic,
	|	SUM(Expense.Count) AS Count
	|INTO TableExpense
	|FROM
	|	Expense AS Expense
	|WHERE
	|	Expense.Products <> VALUE(Catalog.Products.EmptyRef)
	|	AND Expense.Count <> 0
	|	AND CAST(Expense.Products AS Catalog.Products).ItemsType IN (
	|														VALUE(Enum.ItemsTypes.OwnGoods), 
	|														VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND (Expense.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|	OR CAST(Expense.Products AS Catalog.Products).UseVariants = 
	|			VALUE(Enum.ItemVariantsUsageOptions.DontUse))
	|GROUP BY
	|	Ref,
	|	Department,
	|	Products,
	|	Characteristic
	|
	|INDEX BY
	|	Ref,
	|	Department,
	|	Products,
	|	Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Supply.Ref AS Ref,
	|	Supply.Department AS Department,
	|	Supply.Products AS Products,
	|	Supply.Characteristic AS Characteristic,
	|	Supply.Warehouse AS Warehouse,
	|	Supply.Package AS Package,
	|	CASE
	|		WHEN &ControlExcessOfSeparateProvision
	|				AND Supply.Purpose = CAST(Supply.Ref AS Document.ProductionStage2_2).Purpose
	|			THEN VALUE(Catalog.Assignments.EmptyRef)
	|		ELSE Supply.Purpose
	|	END AS Purpose,
	|	Supply.Count AS Count
	|INTO Software_3
	|FROM
	|	Supply AS Supply
	|WHERE
	|	Supply.Products <> VALUE(Catalog.Products.EmptyRef)
	|	AND Supply.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|	AND Supply.Count <> 0
	|	AND CAST(Supply.Products AS Catalog.Products).ItemsType IN (
	|														VALUE(Enum.ItemsTypes.OwnGoods),
	|														VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND (Supply.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|	OR CAST(Supply.Products AS Catalog.Products).UseVariants =
	|			VALUE(Enum.ItemVariantsUsageOptions.DontUse))
	|	AND NOT Supply.Canceled
	|
	|INDEX BY
	|	Ref,
	|	Department,
	|	Products,
	|	Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Software_3.Ref AS Ref,
	|	Software_3.Department AS Department,
	|	Software_3.Products AS Products,
	|	Software_3.Characteristic AS Characteristic,
	|	SUM(Software_3.Count) - ISNULL(MAX(TableExpense.Count), 0) AS Count
	|INTO Distribution_Table
	|FROM
	|	Software_3 AS Software_3
	|		LEFT JOIN TableExpense AS TableExpense
	|		ON Software_3.Ref = TableExpense.Ref
	|			AND Software_3.Department = TableExpense.Department
	|			AND Software_3.Products = TableExpense.Products
	|			AND Software_3.Characteristic = TableExpense.Characteristic
	|GROUP BY
	|	Software_3.Ref,
	|	Software_3.Department,
	|	Software_3.Products,
	|	Software_3.Characteristic
	|HAVING
	|	SUM(Software_3.Count) > ISNULL(MAX(TableExpense.Count), 0)
	|
	|INDEX BY
	|	Ref,
	|	Department,
	|	Products,
	|	Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Software_3.Ref AS Ref,
	|	Software_3.Department AS Department,
	|	Software_3.Products AS Products,
	|	Software_3.Characteristic AS Characteristic,
	|	Software_3.Warehouse AS Recipient,
	|	Software_3.Purpose AS Purpose,
	|	Software_3.Package AS Package,
	|	Software_3.Count AS Count,
	|	ISNULL(CAST(Software_3.Warehouse AS Catalog.Warehouses).ShopFloorStockroom, FALSE) AS ShopFloorStockroom,
	|	&UnitGoodsInUnitsOfMeasure AS UnitGoodsInUnitsOfMeasure,
	|	NOT ISNULL(CAST(Software_3.Warehouse AS Catalog.Warehouses).ShopFloorStockroom, FALSE)
	|	AND &UnitGoodsInUnitsOfMeasure AS MustBeRoundOff
	|FROM
	|	&Software_3 AS Software_3
	|WHERE
	|	TRUE IN (SELECT TOP 1 
	|				 TRUE
	|			  FROM
	|			  	 Distribution_Table AS Distribution_Table
	|			  WHERE
	|				 Distribution_Table.Ref = Software_3.Ref
	|				 AND Distribution_Table.Department = Software_3.Department
	|				 AND Distribution_Table.Products = Software_3.Products
	|				 AND Distribution_Table.Characteristic = Software_3.Characteristic)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Distribution_Table.Ref AS Ref,
	|	Distribution_Table.Department AS Department,
	|	Distribution_Table.Products AS Products,
	|	Distribution_Table.Characteristic AS Characteristic,
	|	Distribution_Table.Count AS Count
	|FROM
	|	Distribution_Table AS Distribution_Table
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	*
	|FROM
	|	UnusedMaterials AS UnusedMaterials
	|");
	
	TextSourceTable = "Software_3 AS Software_3
						   |	%1";
	TextSourceTable = StrTemplate(TextSourceTable, "//&CompoundUnitGoodsInUnitOfMeasure");
	Query.Text = StrReplace(Query.Text, "&Software_3 AS Software_3", TextSourceTable);
	
	ApplyingParameters = ProductionServer.ParametersOfApplicationOfPieceProductInDimensionalUnit();
	ApplyingParameters.Package = False;
	ApplyingParameters.NumberOfPackages = False;
	ProductionServer.ApplyUnitItemSettingsInUnitOfMeasure(Query.Text, "Software_3", ApplyingParameters);
	
	Query.TempTablesManager = TempTablesManager;
	Query.SetParameter("ControlExcessOfSeparateProvision",
		SupplyCached.ControlExcessOfSeparateProvision());
	ResultsArray = Query.ExecuteBatch();
	
	FilterFields = "Ref, Department, Products, Characteristic";
	
	UBound = ResultsArray.UBound();	
	Software_3 = ResultsArray[UBound - 2].Unload();
	Software_3.Indexes.Add(FilterFields);
	Software_3.Indexes.Add(FilterFields + ", UnitGoodsInUnitsOfMeasure");
	Software_3.Indexes.Add(FilterFields + ", UnitGoodsInUnitsOfMeasure, ShopFloorStockroom");
	
	Distribution_Table = ResultsArray[UBound - 1].Unload();
	
	UnusedMaterials = ProductionManagement.TabularPartOfDocumentProductionStage("UnusedMaterials");
 	UnusedMaterials.Columns.Add("MustBeRoundOff", New TypeDescription("Boolean"));
 	UnusedMaterials.Indexes.Add("Ref, LineNumber");

	Selection = ResultsArray[UBound].Select();
	While Selection.Next() Do
		FillPropertyValues(UnusedMaterials.Add(), Selection);
	EndDo;
	
	AdjustmentTable = UnusedMaterials.Copy();
	
	TableEconomy = UnusedMaterials.CopyColumns();
	TableEconomy.Indexes.Add("Ref, Department, Products, Characteristic, Recipient, Purpose, Package");
	TableEconomy.Indexes.Add("Ref, Department, Products, Characteristic, Recipient, Purpose");
	
	RowsCount = Distribution_Table.Count();
	RowIndex = 0;
	While RowIndex < RowsCount Do
		
		TableRowDistribution = Distribution_Table[RowIndex];
				
		Count = TableRowDistribution.Count;
		QuantityWholePart = Int(Count);
		QuantityFractionalPart = Count - QuantityWholePart;
		
		FilterStructure1 = New Structure(FilterFields);
		FillPropertyValues(FilterStructure1, TableRowDistribution);
			
		// 1. The number of Whole units - Shop Floor = FALSE AND piece Goods in Dimensional units = TRUE				
		If QuantityWholePart > 0 Then
			FilterStructure1.Insert("ShopFloorStockroom", False);
			FilterStructure1.Insert("UnitGoodsInUnitsOfMeasure", True);
			AllocateQuantity(Software_3, TableEconomy, FilterStructure1, QuantityWholePart);
		EndIf;

		// 2. The quantity of the detailed part - Shop Warehouse = TRUTH AND piece goods in Dimensional units = TRUTH
		If QuantityFractionalPart > 0 Then
			FilterStructure1.Insert("ShopFloorStockroom", True);
			FilterStructure1.Insert("UnitGoodsInUnitsOfMeasure", True);
			AllocateQuantity(Software_3, TableEconomy, FilterStructure1, QuantityFractionalPart);
		EndIf;
		
		// 3. The number of details - Piece items in Dimensional units = FALSE
		If QuantityFractionalPart > 0 Then
			FilterStructure1.Delete("ShopFloorStockroom");
			FilterStructure1.Insert("UnitGoodsInUnitsOfMeasure", False);
			AllocateQuantity(Software_3, TableEconomy, FilterStructure1, QuantityFractionalPart);
		EndIf;		
		
		// 4. Quantity
		Count = QuantityWholePart + QuantityFractionalPart;
		If Count > 0 Then
			
			If FilterStructure1.Property("ShopFloorStockroom") Then
				FilterStructure1.Delete("ShopFloorStockroom");
			EndIf;
			
			FilterStructure1.Delete("UnitGoodsInUnitsOfMeasure");
			AllocateQuantity(Software_3, TableEconomy, FilterStructure1, Count);
					
		EndIf;		
		
		RowIndex = RowIndex + 1;
		
	EndDo;
	
	GroupingColumns = "Ref, Department, Products, Characteristic, Recipient, Package, Purpose, MustBeRoundOff";
	ProductionServer.CollapseValueTable(TableEconomy, GroupingColumns, "Count", True);
	
	TableEconomy.FillValues(DateOfTransaction, "DateOfTransaction");
	
	FilterFields = "Ref, Department, Products, Characteristic, Recipient, Purpose, Package";
	FilterStructure1 = New Structure(FilterFields);
	AdjustTables(TableEconomy, AdjustmentTable, FilterStructure1);
	
	If TableEconomy.Count() > 0 And AdjustmentTable.Count() > 0 Then
		FilterFields = "Ref, Department, Products, Characteristic, Recipient, Purpose";
		FilterStructure1 = New Structure(FilterFields);
		AdjustTables(TableEconomy, AdjustmentTable, FilterStructure1);
	EndIf;
	
	If AdjustmentTable.Count() > 0 Then
		FilterFields = "Ref, LineNumber";
		FilterStructure1 = New Structure(FilterFields);
		AdjustTables(UnusedMaterials, AdjustmentTable, FilterStructure1);
	EndIf;
	
	For Each TableRow In TableEconomy Do
		FillPropertyValues(UnusedMaterials.Add(), TableRow);
	EndDo;
	
	DataStructure_ = New Structure;
	DataStructure_.Insert(
		"RecalculateNumberOfPackages", BatchProcessingOfTablePartClientServer.StructureOfRecalculationOfNumberOfPackages());
		
	LineNumber = 0;
	For Each TableRow In UnusedMaterials Do
		
		LineNumber = LineNumber + 1;
		TableRow.LineNumber = LineNumber;
		
		If TableRow.MustBeRoundOff And TableRow.Count <> Int(TableRow.Count) Then
			TableRow.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef();	
		EndIf;
		
	EndDo;
			
	BatchProcessingOfTablePartServer.TreatTS(
		UnusedMaterials,
		DataStructure_);
			
	TableEconomy.Columns.Delete("MustBeRoundOff");
	
	Return UnusedMaterials; 

EndFunction

#EndRegion

#Region Assignments

// Returns a template for generating product assignments in the document.
//
// Parameters:
// 		Object - DocumentObject.ProductionStage2_2, FormDataStructure - The production stage for which you need to get the destination template.
//
// Returns:
// 		See Catalogs.Assignments.NewSubmenuTemplate
//
Function DestinationPattern(Object) Export
	
	DestinationPattern = Catalogs.Assignments.NewSubmenuTemplate();
	
	If LinesOfBusinessServer.ThisIsLineOfActivityWithSeparationOfGoodsAndWorks(Object.LineOfBusiness) Then
		DestinationPattern.LineOfBusiness = Object.LineOfBusiness;
	EndIf;
	
	If Object.BusinessOperation = Enums.BusinessTransactions.TollManufacturing2_5 Then
		
		DestinationPattern.Partner       = Object.Partner;
		DestinationPattern.Contract       = Object.Contract;
		DestinationPattern.AssignmentType = Enums.AssignmentTypes.Giveaway2_5;
		
	EndIf;
	
	DestinationPattern.OrderDocument = Object.Ref;
	
	Return DestinationPattern;
	
EndFunction

// Returns a template for selecting a destination for toll production.
//
// Parameters:
// 		Object - DocumentObject.ProductionStage2_2, FormDataStructure - The production stage for which you need to get the destination template.
//
// Returns:
// 		See Catalogs.Assignments.NewSubmenuTemplate
//
Function DefaultDestinationPatternForByProducts(Object) Export
	
	DestinationPattern = Catalogs.Assignments.NewSubmenuTemplate();
	
	If LinesOfBusinessServer.ThisIsLineOfActivityWithSeparationOfGoodsAndWorks(Object.LineOfBusiness) Then
		DestinationPattern.LineOfBusiness = Object.LineOfBusiness;
	EndIf;
	
	DestinationPattern.Partner = Object.Partner;
	DestinationPattern.Contract = Object.Contract;
	
	If Object.BusinessOperation = Enums.BusinessTransactions.TollManufacturing2_5 Then
		DestinationPattern.AssignmentType = Enums.AssignmentTypes.Giveaway2_5;
	Else
		DestinationPattern.AssignmentType = Enums.AssignmentTypes.ProvidedMaterials22;
	EndIf;
	
	Return DestinationPattern;
	
EndFunction

// The default assignment for toll-free production.
// 
// Parameters:
//  ReferenceOrder - DocumentRef.ProductionOrder2_2 - general Attributes Of The Production, or a link to them.
// 
// Returns:
//  CatalogRef.Assignments - Default assignment for toll-free production
//
Function DefaultAssignmentForByProducts(ReferenceOrder) Export
	
	DetailsOfOrder = New Structure;
	DetailsOfOrder.Insert("BusinessOperation");
	DetailsOfOrder.Insert("ProductionProcessType");
	DetailsOfOrder.Insert("Partner");
	DetailsOfOrder.Insert("Contract");
	DetailsOfOrder.Insert("AssignmentProducts");
	DetailsOfOrder.Insert("LineOfBusiness");
	
	DetailsOfOrder = Common.ObjectAttributesValues(ReferenceOrder, DetailsOfOrder);
	
	Result = Catalogs.Assignments.EmptyRef();
	
	If DetailsOfOrder.BusinessOperation = Enums.BusinessTransactions.TollManufacturing2_5
		Or False Then
		
		If DetailsOfOrder.BusinessOperation = Enums.BusinessTransactions.TollManufacturing2_5
			And DetailsOfOrder.ProductionProcessType = Enums.ProductionProcessTypes.WithoutBillsOfMaterials Then
			Result = DetailsOfOrder.AssignmentProducts;
		Else
			TemplateForAssigningGiveawayRelease = Documents.ProductionStage2_2.DefaultDestinationPatternForByProducts(DetailsOfOrder);
			Result = Catalogs.Assignments.FindByTemplate(TemplateForAssigningGiveawayRelease);
		EndIf;
		
	EndIf;
	
	Return Result;
	
EndFunction

