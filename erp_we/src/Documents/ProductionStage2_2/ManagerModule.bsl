// Cancels weekends and by-finished products.
//
// Parameters:
//	Parameters - Structure - contains parameters for selecting production stages and finished products.
//	ResultAddress - String - the address of the temporary storage for recording the result.
//
Procedure CancelOutputFinishedProductsOnHold(Parameters, ResultAddress) Export
	
	ProductionLot = Parameters.ProductionLot;
	Stage = Parameters.Stage;
	Products = Parameters.Products;
	Characteristic = Parameters.Characteristic;
	Recipient = Parameters.Recipient;
	Purpose = Parameters.Purpose;
	CancellationReason = Parameters.CancellationReason;
	
	If ValueIsFilled(Stage) Then
		Stages = CommonClientServer.ValueInArray(Stage);
	Else
		Query = New Query(
			"SELECT
			|	Stages.Ref AS Ref
			|FROM
			|	Document.ProductionStage2_2 AS Stages
			|WHERE
			|	Stages.ProductionLot = &ProductionLot
			|	AND Stages.Posted
			|	AND TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			Document.ProductionStage2_2.ManufacturedProducts AS Products_1
			|		WHERE
			|			Products_1.Ref = Stages.Ref
			|			AND Products_1.Products = &Products
			|			AND Products_1.Characteristic = &Characteristic
			|			AND Products_1.Recipient = &Recipient
			|			AND Products_1.Purpose = &Purpose
			|			AND NOT Products_1.Canceled
			|		
			|		UNION ALL
			|		
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			Document.ProductionStage2_2.SideAndIntermediateRelease AS Products_1
			|		WHERE
			|			Products_1.Ref = Stages.Ref
			|			AND Products_1.Products = &Products
			|			AND Products_1.Characteristic = &Characteristic
			|			AND Products_1.Recipient = &Recipient
			|			AND Products_1.Purpose = &Purpose
			|			AND NOT Products_1.Canceled)");
		Query.SetParameter("ProductionLot", ProductionLot);
		Query.SetParameter("Products", Products);
		Query.SetParameter("Characteristic", Characteristic);
		Query.SetParameter("Recipient", Recipient);
		Query.SetParameter("Purpose", Purpose);
		Stages = Query.Execute().Unload().UnloadColumn("Ref");
	EndIf;
	
	TheStructureOfTheSearch = New Structure;
	TheStructureOfTheSearch.Insert("Products", Products);
	TheStructureOfTheSearch.Insert("Characteristic", Characteristic);
	TheStructureOfTheSearch.Insert("Recipient", Recipient);
	TheStructureOfTheSearch.Insert("Purpose", Purpose);
	TheStructureOfTheSearch.Insert("Canceled", False);
	
	QuantityProcessed = 0;
	
	For Each StageLink In Stages Do
		DocumentObject = StageLink.GetObject(); // DocumentObject.ProductionStage2_2
		Try
			DocumentObject.Lock();
			
			SeriesSpecificationParameters = SeriesSpecificationParameters(DocumentObject);
			
			For Each String In DocumentObject.ManufacturedProducts.FindRows(TheStructureOfTheSearch) Do
				String.Canceled = True;
				String.CancellationReason = CancellationReason;
			EndDo;
			ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.ManufacturedProducts);
			
			For Each String In DocumentObject.SideAndIntermediateRelease.FindRows(TheStructureOfTheSearch) Do
				String.Canceled = True;
				String.CancellationReason = CancellationReason;
			EndDo;
			ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SideAndIntermediateRelease);
			
			DocumentObject.Write(DocumentWriteMode.Posting);
			
			QuantityProcessed = QuantityProcessed + 1;
		Except
			EventName = NStr("vi = 'Công đoạn sản xuất';
							|ru = 'Этап производства';
							|en = 'Production stage'; fa = 'مرحله تولید';
							|it = 'Fase di produzione';
							|pl = 'Etap produkcji';
							|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
				+ NStr("vi = 'Hủy bỏ sản phẩm đầu ra';
						|ru = 'Отмена выходных изделий';
						|en = 'Cancel finished products'; fa = 'Cancel finished products';
						|it = 'Cancel finished products';
						|pl = 'Cancel finished products';
						|tr = 'Üretilen nihai ürün iptali'", Common.DefaultLanguageCode());
			
			WriteLogEvent(EventName,
				EventLogLevel.Error,,,
				ErrorProcessing.DetailErrorDescription(ErrorInfo()));
			
			Raise;
		EndTry;
	EndDo;
	
	Result = New Structure("QuantityProcessed", QuantityProcessed);
	PutToTempStorage(Result, ResultAddress);
	
EndProcedure

// Changes the quality of output and by-finished products.
// If necessary, creates an item of the specified quality.
//
// Parameters:
//	Parameters - Structure - contains parameters for selecting production stages and finished products.
//	ResultAddress - String - the address of the temporary storage for recording the result.
//
Procedure ChangeQualityOfOutputFinishedProductsDelayed(Parameters, ResultAddress) Export
	
	ProductionLot = Parameters.ProductionLot;
	Stage = Parameters.Stage;
	Products = Parameters.Products;
	Characteristic = Parameters.Characteristic;
	Recipient = Parameters.Recipient;
	Purpose = Parameters.Purpose;
	Quality = Parameters.Quality;
	
	// Selection/creation of items
	ProductsOfDifferentQuality = Catalogs.Products.EmptyRef();
	CharacteristicOfDifferentQuality = Catalogs.ItemsCharacteristics.EmptyRef();
	
	BeginTransaction();
	
	Try
		DataLock = New DataLock;
		LockItem = DataLock.Add("InformationRegister.AnotherQualityGoods");
		LockItem.Mode = DataLockMode.Exclusive;
		LockItem.SetValue("Products", Products);
		DataLock.Lock();
		
		Query = New Query(
			"SELECT TOP 1
			|	Goods.OtherQualityGoods AS ProductsOfDifferentQuality
			|FROM
			|	InformationRegister.AnotherQualityGoods AS Goods
			|WHERE
			|	Goods.Products = &Products
			|	AND Goods.QualityGradation = &Quality
			|	AND NOT Goods.OtherQualityGoods.DeletionMark");
		Query.SetParameter("Products", Products);
		Query.SetParameter("Quality", Quality);
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			ProductsOfDifferentQuality = Selection.ProductsOfDifferentQuality;
		Else
			SetPrivilegedMode(True);
			ItemCopy = Products.Copy();
			ItemCopy.Description = ItemCopy.Description + ", " + String(Quality);
			ItemCopy.DescriptionFull = ItemCopy.DescriptionFull + ", " + String(Quality);
			ItemCopy.Quality = Quality;
			ItemCopy.PicturesFile = Catalogs.ProductsAttachedFiles.EmptyRef();
			ItemCopy.DescriptionFileForWebsite = Catalogs.ProductsAttachedFiles.EmptyRef();
			ItemCopy.Code = "";
			ItemCopy.SearchCode = "";
			ItemCopy.DeletionMark = False;
			ItemCopy.Write();
			
			ProductsOfDifferentQuality = ItemCopy.Ref;
			
			InformationRegisters.AnotherQualityGoods.RecordLinkToProductOfDifferentQuality(
				Products, ProductsOfDifferentQuality);
			SetPrivilegedMode(False);
		EndIf;
		
		If ValueIsFilled(Characteristic) Then
			CheckResult = Catalogs.Products.CharacteristicAndPackagingBelongToOwner(
				ProductsOfDifferentQuality, Characteristic, Catalogs.PackagesAndUnitsOfMeasure.EmptyRef());
			If CheckResult.ItemVariantsAreUsed Then
				If CheckResult.Characteristic.IsEmpty() Then
					CharacteristicOfDifferentQuality = Catalogs.ItemsCharacteristics.IdenticalCharacteristic(
						ProductsOfDifferentQuality, Characteristic);
				Else
					CharacteristicOfDifferentQuality = Characteristic;
				EndIf;
			EndIf;
		EndIf;
		
		CommitTransaction();
	Except
		RollbackTransaction();
		
		EventName = NStr("vi = 'Công đoạn sản xuất';
						|ru = 'Этап производства';
						|en = 'Production stage'; fa = 'مرحله تولید';
						|it = 'Fase di produzione';
						|pl = 'Etap produkcji';
						|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Thay đổi chất lượng sản phẩm đầu ra';
					|ru = 'Изменение качества выходных изделий';
					|en = 'Changing the quality of finished products'; fa = 'Changing the quality of finished products';
					|it = 'Changing the quality of finished products';
					|pl = 'Changing the quality of finished products';
					|tr = 'Üretilen nihai ürünlerinin kalitesindeki değişim'", Common.DefaultLanguageCode());
		
		WriteLogEvent(EventName,
			EventLogLevel.Error,,,
			ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		Raise;
	EndTry;
	
	// Changing documents
	If ValueIsFilled(Stage) Then
		Stages = CommonClientServer.ValueInArray(Stage);
	Else
		Query = New Query(
			"SELECT
			|	Stages.Ref AS Ref
			|FROM
			|	Document.ProductionStage2_2 AS Stages
			|WHERE
			|	Stages.ProductionLot = &ProductionLot
			|	AND Stages.Posted
			|	AND TRUE IN (
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			Document.ProductionStage2_2.ManufacturedProducts AS Products_1
			|		WHERE
			|			Products_1.Ref = Stages.Ref
			|			AND Products_1.Products = &Products
			|			AND Products_1.Characteristic = &Characteristic
			|			AND Products_1.Recipient = &Recipient
			|			AND Products_1.Purpose = &Purpose
			|			AND NOT Products_1.Canceled
			|		
			|		UNION ALL
			|		
			|		SELECT TOP 1
			|			TRUE
			|		FROM
			|			Document.ProductionStage2_2.SideAndIntermediateRelease AS Products_1
			|		WHERE
			|			Products_1.Ref = Stages.Ref
			|			AND Products_1.Products = &Products
			|			AND Products_1.Characteristic = &Characteristic
			|			AND Products_1.Recipient = &Recipient
			|			AND Products_1.Purpose = &Purpose
			|			AND NOT Products_1.Canceled)");
		Query.SetParameter("ProductionLot", ProductionLot);
		Query.SetParameter("Products", Products);
		Query.SetParameter("Characteristic", Characteristic);
		Query.SetParameter("Recipient", Recipient);
		Query.SetParameter("Purpose", Purpose);
		Stages = Query.Execute().Unload().UnloadColumn("Ref");
	EndIf;
	
	TheStructureOfTheSearch = New Structure;
	TheStructureOfTheSearch.Insert("Products", Products);
	TheStructureOfTheSearch.Insert("Characteristic", Characteristic);
	TheStructureOfTheSearch.Insert("Recipient", Recipient);
	TheStructureOfTheSearch.Insert("Purpose", Purpose);
	TheStructureOfTheSearch.Insert("Canceled", False);
	
	QuantityProcessed = 0;
	
	For Each StageLink In Stages Do
		DocumentObject = StageLink.GetObject(); // DocumentObject.ProductionStage2_2
		Try
			DocumentObject.Lock();
			
			SeriesSpecificationParameters = SeriesSpecificationParameters(DocumentObject);
			
			For Each String In DocumentObject.ManufacturedProducts.FindRows(TheStructureOfTheSearch) Do
