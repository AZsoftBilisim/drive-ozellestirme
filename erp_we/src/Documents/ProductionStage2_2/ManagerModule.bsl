Function ParametersForVerifyingBankingDetails(FieldName = "", NameOfValidationField = "")

	Return New Structure("FieldName,NameOfValidationField,MessageTemplate", FieldName, NameOfValidationField, "");

EndFunction

Procedure NotifyFillErrors(Object, Selection, AttributesList, TSName = "", Cancel = False) Export
	
	If Selection.Count() = 0 Then
		Return;
	EndIf;
	
	If TypeOf(Object) = Type("Structure")
		And Object.Property("SubcontractOrder") Then
		ObjectMetadata = Metadata.Documents.ProductionStage2_2;
		DataKey = Undefined;
		DataPath = "Object";
	ElsIf Not TypeOf(Object) = Type("DocumentObject.ProductionStage2_2") Then
		ObjectMetadata = Object.Metadata();
		DataKey = Undefined;
		DataPath = Object.PathToDetailsOfEditingForm();
	Else
		ObjectMetadata = Object.Metadata();
		DataKey = Object;
		DataPath = "";
	EndIf;
	
	While Selection.Next() Do
		For Each CheckParameters In AttributesList Do
			If Selection[CheckParameters.NameOfValidationField] <> True Then
				Continue;
			EndIf;
			If TSName <> "" Then // checking the tabular part
				ListName = ObjectMetadata.TabularSections[TSName].Synonym;
				If ValueIsFilled(CheckParameters.MessageTemplate) Then
					Template = CheckParameters.MessageTemplate;
					Text = StrTemplate(Template, Format(Selection.LineNumber, "NG="), ListName);
				Else
					Synonym = ObjectMetadata.TabularSections[TSName].Attributes[CheckParameters.FieldName].Synonym;
					Text = CommonClientServer.FillingErrorText("Column", "FillType", Synonym, Format(Selection.LineNumber, "NG="), ListName);
				EndIf;
				Field = CommonClientServer.PathToTabularSection(TSName, Selection.LineNumber, CheckParameters.FieldName);
				Common.MessageToUser(Text, DataKey, Field, DataPath, Cancel);
			Else
				If ValueIsFilled(CheckParameters.MessageTemplate) Then
					Text = CheckParameters.MessageTemplate;
				Else
					Synonym = ObjectMetadata.Attributes[CheckParameters.FieldName].Synonym;
					Text = CommonClientServer.FillingErrorText("Field", "FillType", Synonym);
				EndIf;
				Common.MessageToUser(Text, DataKey, CheckParameters.FieldName, DataPath, Cancel);
			EndIf;
		EndDo;
	EndDo;
	
EndProcedure

