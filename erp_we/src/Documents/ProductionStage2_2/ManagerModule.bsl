		|	Table.RowCode                                       AS RowCode,
		|	DataOfAccounting.Series                                       AS Series,
		|	Table.Count                                      AS Count,
		|	Table.Package                                        AS Package,
		|	DATETIME(1,1,1)                                        AS DateOfShipment,
		|	Table.Canceled                                        AS Canceled,
		|	Table.BatchesIndicationStatus                             AS BatchesIndicationStatus,
		|	VALUE(Enum.SupplyOptions.EmptyRef) AS SupplyOption,
		|	FALSE                                                    AS WithAssignment,
		|	VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef) AS ProductsGroup,
		|	VALUE(Catalog.Warehouses.EmptyRef)                AS Warehouse,
		|	Table.Price * ISNULL(Coefficients.ConversionRateToManCurrency, 0) AS Price,
		|	Table.Sum * ISNULL(Coefficients.ConversionRateToManCurrency, 0) AS Sum,
		|	ISNULL(DataOfAccounting.ToRegister, 0)                    AS ToRegister,
		|	ISNULL(DataOfAccounting.Ordered, 0)                       AS Ordered,
		|	FALSE													AS SideProduct
		|FROM
