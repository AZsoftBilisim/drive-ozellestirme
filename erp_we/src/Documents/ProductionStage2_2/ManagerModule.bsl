		|	AND NOT TabularSection.ToExpenseAs
		|";
		
		WarehousesServer.ScheduleGoodsReceipt(
			Query,
			QueryTexts,
			Registers,
			QueryTextDocument_,
			"TabularSection");
		
	EndIf;
	
EndProcedure

