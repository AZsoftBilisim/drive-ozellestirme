#Region ModificationOfSpecificationData

Procedure PrepareTheseSpecificationsForCreatingStages(SpecificationData, BatchData) Export
	
	// Adding Fields
	SpecificationData.Insert("ReferenceOrder", BatchData.ReferenceOrder);
	SpecificationData.Insert("AssignmentProducts", BatchData.AssignmentProducts);
	SpecificationData.Insert("PlanNoEarlierThanStageCode", 0);
	
	SpecificationData.MainProduct.Insert("UnderRepairProduct",
		BatchData.UnderRepairProduct);
	SpecificationData.MainProduct.Insert("UnderRepairVariant",
		BatchData.UnderRepairVariant);
	SpecificationData.MainProduct.Insert("UnderRepairBatch",
		BatchData.UnderRepairBatch);
	
	RecipientTypes = New Array;
	RecipientTypes.Add(Type("CatalogRef.BusinessStructure"));
	RecipientTypes.Add(Type("CatalogRef.Warehouses"));
	
	For Cnt = 1 To 2 Do
		
		TableName = ?(Cnt = 1, "ManufacturedProducts", "RecyclableWaste");
		
		If SpecificationData[TableName].Columns.Find("Purpose") = Undefined Then
			SpecificationData[TableName].Columns.Add(
				"Purpose", New TypeDescription("CatalogRef.Assignments"));
		EndIf;
		
		If SpecificationData[TableName].Columns.Find("StageConsumer") = Undefined Then
			SpecificationData[TableName].Columns.Add(
				"StageConsumer", New TypeDescription("DocumentRef.ProductionStage2_2"));
		EndIf;
		
		If SpecificationData[TableName].Columns.Find("Recipient") = Undefined Then
			SpecificationData[TableName].Columns.Add("Recipient", New TypeDescription(RecipientTypes));
			SpecificationData[TableName].LoadColumn(
				SpecificationData[TableName].UnloadColumn("Warehouse"), "Recipient");
		EndIf;
		
		If SpecificationData[TableName].Columns.Find("RecipientStageCode") = Undefined Then
			SpecificationData[TableName].Columns.Add(
				"RecipientStageCode", New TypeDescription("Number", New NumberQualifiers));
		EndIf;
		
		If SpecificationData[TableName].Columns.Find("ProductionDate") = Undefined Then
			SpecificationData[TableName].Columns.Add(
				"ProductionDate", New TypeDescription("Date",,, New DateQualifiers));
		EndIf;
		
	EndDo;
	
	// Coding of stages
	If SpecificationData.Stages.Columns.Find("StageCode") = Undefined Then
		
		SpecificationData.Stages.Columns.Add(
			"StageCode", New TypeDescription("Number", New NumberQualifiers));
		
		StageCode = 1;
		For Each String In SpecificationData.Stages Do
			String.StageCode = StageCode;
			StageCode = StageCode + 1;
		EndDo;
		
	EndIf;
	
	If SpecificationData.Property("MaterialsAndWorksSets") Then
		ProductDataManagement.UpdateSetsOfMaterialsAndWorksTable(SpecificationData, "MaterialsAndServices");
	EndIf;
	
	// Filling in the desired date
	If SpecificationData.Stages.Columns.Find("DateOfShipment") = Undefined Then
		
		SpecificationData.Stages.Columns.Add("DateOfShipment", New TypeDescription("Date",,, New DateQualifiers));
		SpecificationData.Stages.Columns.Add("NotShipInInstallments", New TypeDescription("Boolean"));
		SpecificationData.Stages.FillValues(True, "NotShipInInstallments");
		
		Query = New Query(
			"SELECT
			|	MIN(
			|		DATEADD(
			|			Stages.ReferenceOrder.EarliestStartDate,
			|			SECOND,
			|			RegulatorySchedule.DurationBeforeStart)) AS Date
			|FROM
			|	Document.ProductionStage2_2 AS Stages
			|		INNER JOIN InformationRegister.StandardScheduleOfProductionStages AS RegulatorySchedule
			|		ON Stages.Ref = RegulatorySchedule.ProductionStage
			|WHERE 
			|	Stages.ProductionLot = &ProductionLot
			|HAVING
			|	COUNT(Stages.Ref) > 0");
		Query.SetParameter("ProductionLot", BatchData.ProductionLot);
		Selection = Query.Execute().Select();
		
		If Selection.Next() Then
			
			InitialDate = Selection.Date;
			If InitialDate < CurrentSessionDate() Then
				InitialDate = CurrentSessionDate();
			EndIf;
			
			SpecificationData.Stages.Sort("StageNumber, NextStageNo");
			
			TheStructureOfTheSearch = New Structure("StageNumber");
			For IndexOf = 0 To SpecificationData.Stages.Count()-1 Do
				
				Stage = SpecificationData.Stages[IndexOf];
				
				If SpecificationData.Stages.Find(Stage.StageNumber, "NextStageNo") = Undefined Then
					Stage.DateOfShipment = InitialDate;
				EndIf;
				If ValueIsFilled(Stage.DateOfShipment )
						And Stage.NextStageNo <> 0 Then
					
					TheStructureOfTheSearch.StageNumber = Stage.NextStageNo;
					For Each NextStage In SpecificationData.Stages.FindRows(TheStructureOfTheSearch) Do
						If ValueIsFilled(NextStage.DateOfShipment) Then
							NextStage.DateOfShipment = Min(
								NextStage.DateOfShipment,
								Stage.DateOfShipment + Stage.StageDurationInSeconds);
						Else
							NextStage.DateOfShipment =
								Stage.DateOfShipment + Stage.StageDurationInSeconds;
						EndIf;
					EndDo;
					
				EndIf;
			EndDo;
		EndIf;
	EndIf;
	
	If BatchData.DynamicStructure Then
		If SpecificationData.ProductionProcessType <> Enums.ProductionProcessTypes.PerformRM Then
			// There are no semi-finished products produced in the process
			TheStructureOfTheSearch = New Structure;
			TheStructureOfTheSearch.Insert("ProducedInProcess", True);
			For Each String In SpecificationData.MaterialsAndServices.FindRows(TheStructureOfTheSearch) Do
				String.ProducedInProcess = False;
				String.Produced = False;
				String.MethodOfReceivingMaterial = Enums.MethodsOfReceivingBOMMaterials.Provide;
			EndDo;
		EndIf;
	Else
		// The semi-finished products produced are provided separately
		TheStructureOfTheSearch = New Structure;
		TheStructureOfTheSearch.Insert("ProducedInProcess", True);
		TheStructureOfTheSearch.Insert("MethodOfReceivingMaterial", Enums.MethodsOfReceivingBOMMaterials.ProduceByBillsOfMaterials);
		TheStructureOfTheSearch.Insert("WithAssignment", False);
		For Each String In SpecificationData.MaterialsAndServices.FindRows(TheStructureOfTheSearch) Do
			String.WithAssignment = True;
		EndDo;
	EndIf;
	
	AddSpecificationData(
		CommonClientServer.ValueInArray(SpecificationData),
		BatchData.ReferenceOrder);
	
	// Linking data on the release of PF at the stage
	If SpecificationData.RecyclableWaste.Count() > 0 Then
		GroupFields = New Structure("Products,Characteristic");
		
		Calculations = New ValueTable;
		Calculations.Columns.Add("Products");
		Calculations.Columns.Add("Characteristic");
		Calculations.Indexes.Add("Products,Characteristic");
		
		SemiFinishedProducts = New ValueTable;
		SemiFinishedProducts.Columns.Add("Products");
		SemiFinishedProducts.Columns.Add("Characteristic");
		SemiFinishedProducts.Columns.Add("StageNumber"); 
		SemiFinishedProducts.Columns.Add("LinesGroup"); // 0 - receipts, 1 - expenses
		SemiFinishedProducts.Columns.Add("String");
		SemiFinishedProducts.Columns.Add("Count");
		SemiFinishedProducts.Columns.Add("StringStages");
		
		SpecificationData.MaterialsAndServices.Indexes.Add("Products,Characteristic");
		SpecificationData.Stages.Indexes.Add("Stage");
		
		For Each ProductLine In SpecificationData.RecyclableWaste Do
			If ProductLine.ItIsSubjectToRAndM Then
				Continue;
			EndIf;
			
			ProductStageData = SpecificationData.Stages.Find(ProductLine.Stage, "Stage");
			If ProductStageData = Undefined
				Or ProductStageData.NextStageNo = 0 Then
				Continue;
			EndIf;
			
			FillPropertyValues(GroupFields, ProductLine);
			
			If Calculations.FindRows(GroupFields).UBound() <> -1 Then
				SemiFinishedProduct = SemiFinishedProducts.Add();
				FillPropertyValues(SemiFinishedProduct, ProductLine);
				SemiFinishedProduct.String = ProductLine;
				SemiFinishedProduct.StageNumber = ProductStageData.StageNumber;
				SemiFinishedProduct.LinesGroup = 0;
				SemiFinishedProduct.Count = ProductLine.Count;
			Else
				ThisIsASemiFinishedProduct = False;
				FoundSemiFinishedProducts = SpecificationData.MaterialsAndServices.FindRows(GroupFields);
				For Each FoundSemiFinishedProduct In FoundSemiFinishedProducts Do
					// PF produced in the process are not closed by a side release
					ManufacturedByBOM = FoundSemiFinishedProduct.ProducedInProcess
						And FoundSemiFinishedProduct.MethodOfReceivingMaterial <> Enums.MethodsOfReceivingBOMMaterials.ProducedOnStage;
					// In non-dynamic orders, the release communication at the stage is strictly based on the appropriate PC setting
					LimitedByOrderType = Not BatchData.DynamicStructure
						And FoundSemiFinishedProduct.MethodOfReceivingMaterial <> Enums.MethodsOfReceivingBOMMaterials.ProducedOnStage;
					If ManufacturedByBOM
						Or LimitedByOrderType Then
						Continue;
					EndIf;
					
					SemiFinishedProductStageData = SpecificationData.Stages.Find(FoundSemiFinishedProduct.Stage, "Stage");
					If SemiFinishedProductStageData = Undefined Then
						Continue;
					EndIf;
					ThisIsASemiFinishedProduct = True;
					SemiFinishedProduct = SemiFinishedProducts.Add();
					FillPropertyValues(SemiFinishedProduct, ProductLine);
					SemiFinishedProduct.String = FoundSemiFinishedProduct;
					SemiFinishedProduct.StageNumber = SemiFinishedProductStageData.StageNumber;
					SemiFinishedProduct.LinesGroup = 1;
					SemiFinishedProduct.Count = FoundSemiFinishedProduct.Count;
					SemiFinishedProduct.StringStages = SemiFinishedProductStageData;
				EndDo;
				If ThisIsASemiFinishedProduct Then 
					SemiFinishedProduct = SemiFinishedProducts.Add();
					FillPropertyValues(SemiFinishedProduct, ProductLine);
					SemiFinishedProduct.String = ProductLine;
					SemiFinishedProduct.StageNumber = ProductStageData.StageNumber;
					SemiFinishedProduct.LinesGroup = 0;
					SemiFinishedProduct.Count = ProductLine.Count;
					FillPropertyValues(Calculations.Add(), ProductLine);
				EndIf;
			EndIf; 
		EndDo;
		
		SemiFinishedProducts.Sort("Products, Characteristic, LinesGroup, StageNumber", New CompareValues);
		
		GroupFields.Products = Undefined;
		GroupFields.Characteristic = Undefined;
		
		IndexOfProduct = -1;
		ProductBoundary = -1;
		
		For CurIndex__ = 0 To SemiFinishedProducts.Count() - 1 Do
			CurRow = SemiFinishedProducts[CurIndex__];
			
			If GroupFields.Products <> CurRow.Products
					Or GroupFields.Characteristic <> CurRow.Characteristic Then
				FillPropertyValues(GroupFields, CurRow);
				IndexOfProduct = CurIndex__;
				ProductBoundary = -1;
			EndIf;
			If CurRow.LinesGroup = 0 Then
				ProductBoundary = CurIndex__;
				Continue;
			EndIf;
			
			StringMaterial = CurRow;
			
			While ProductBoundary >= IndexOfProduct Do
				ProductLine = SemiFinishedProducts[IndexOfProduct];
				
				If StringMaterial.StageNumber <= ProductLine.StageNumber Then
					Break;
				EndIf; 
				
				Allocated = Min(StringMaterial.Count, ProductLine.Count);
				
				If ProductLine.String.Count > Allocated Then
					NewRow = SpecificationData.RecyclableWaste.Insert(
						SpecificationData.RecyclableWaste.IndexOf(ProductLine.String)+1);
					FillPropertyValues(NewRow, ProductLine.String);
					NewRow.Count = Allocated;
					NewRow.NumberOfPackages = NewRow.Count
						* NewRow.PackageData.Denominator
						/ NewRow.PackageData.Numerator;
					
					ProductLine.String.Count = ProductLine.String.Count - Allocated;
					ProductLine.String.NumberOfPackages = ProductLine.String.Count
						* ProductLine.String.PackageData.Denominator
						/ ProductLine.String.PackageData.Numerator;
					
					FillLine = NewRow;
				Else
					FillLine = ProductLine.String;
				EndIf;
				
				FillLine.Recipient = ?(StringMaterial.String.ItemsType = Enums.ItemsTypes.Work_5,
					StringMaterial.String.StageSubdivision,
					StringMaterial.String.Warehouse);
				If ValueIsFilled(StringMaterial.String.Purpose) Then
					FillLine.Purpose = StringMaterial.String.Purpose;
					If StringMaterial.String.Purpose = StringMaterial.StringStages.Purpose Then
						FillLine.StageConsumer = StringMaterial.StringStages.ProductionStage;
					EndIf;
				EndIf;
				
				ProductLine.Count = ProductLine.Count - Allocated;
				If ProductLine.Count = 0 Then
					IndexOfProduct = IndexOfProduct + 1;
				EndIf;
				
				StringMaterial.Count = StringMaterial.Count - Allocated;
				If StringMaterial.Count = 0 Then
					Break;
				EndIf;
			EndDo;
		EndDo;
	EndIf;
	
EndProcedure

// Complements the specification data
// 
// Parameters:
//  SpecificationsData - Array of Structure - array of structures:
//    * Stages - ValueTable - 
//    * MaterialsAndServices - ValueTable - 
//    * IncomingProducts - ValueTable - 
//  ReferenceOrder - DocumentRef.ProductionOrder2_2 - OrderDocument
Procedure AddSpecificationData(SpecificationsData, ReferenceOrder)
	
	SeparationSchemes = Documents.ProductionOrder2_2.OrderSeparationSchemes(ReferenceOrder);
	
	StagesByCodes = New Map;
	FillInAppointments = New Array;
	FillInPLNoEarlier = New Array;
	
	FillInAccountingAccountSetting = New ValueTable;
	FillInAccountingAccountSetting.Columns.Add("ProductTable_Row",
		New TypeDescription("ValueTableRow"));
	FillInAccountingAccountSetting.Columns.Add("ExpenseItem",
		New TypeDescription("ChartOfCharacteristicTypesRef.AssetLiabilityItems"));
	
	NamesOfTSIssue = StrSplit("ManufacturedProducts,RecyclableWaste", ",");
	
	FreeReleaseAssignment = Documents.ProductionStage2_2.DefaultAssignmentForByProducts(ReferenceOrder);
	PurposeOfReverseKittingComponents = Common.ObjectAttributeValue(ReferenceOrder, "AssignmentProducts");
	
	ProductionLots = New ValueTable();
	ProductionLots.Columns.Add("Code", New TypeDescription("Number"));
	ProductionLots.Columns.Add("ProductionLot", New TypeDescription("CatalogRef.ProductionLots"));
	ProductionLots.Columns.Add("SpecificationDataIndex", New TypeDescription("Number"));
	
	For Each Attribute In Metadata.Catalogs.ProductionLots.Attributes Do
		ProductionLots.Columns.Add(Attribute.Name, Attribute.Type);
	EndDo;
	
	For Each TabularSection In Metadata.Catalogs.ProductionLots.TabularSections Do
		If TabularSection.Name = "AdditionalAttributes" Then
			Continue;
		EndIf;
		ProductionLots.Columns.Add(TabularSection.Name, New TypeDescription("ValueTable"));
	EndDo;
	
	For IndexData = 0 To SpecificationsData.UBound() Do
		
		SpecificationData = SpecificationsData[IndexData];
		
		// Adding Fields
		TypeDescription = New TypeDescription("DocumentRef.ProductionOrder2_2");
		SpecificationData.Stages.Columns.Add("ReferenceOrder", TypeDescription);
		
		TypeDescription = New TypeDescription("CatalogRef.ProductionLots");
		SpecificationData.Stages.Columns.Add("ProductionLot", TypeDescription);
		
		TypeDescription = New TypeDescription("CatalogRef.Assignments");
		SpecificationData.Stages.Columns.Add("AssignmentProducts", TypeDescription);
		SpecificationData.Stages.Columns.Add("AssignmentSemiFinishedProducts", TypeDescription);
		
		If SpecificationData.Stages.Columns.Find("PlanNotEarlierThan") = Undefined Then
			TypeDescription = New TypeDescription("DocumentRef.ProductionStage2_2, Date",,, New DateQualifiers);
			SpecificationData.Stages.Columns.Add("PlanNotEarlierThan", TypeDescription);
		EndIf;
		
		TypeDescription = New TypeDescription("DocumentRef.ProductionOrder2_2");
		SpecificationData.ReferenceOrder = TypeDescription.AdjustValue(SpecificationData.ReferenceOrder);
		
		If SpecificationData.Stages.Columns.Find("ProductionStage") = Undefined Then
			
			TypeDescription = New TypeDescription("DocumentRef.ProductionStage2_2");
			SpecificationData.Stages.Columns.Add("ProductionStage", TypeDescription);
			
			TypeDescription = New TypeDescription("CatalogRef.Assignments");
			SpecificationData.Stages.Columns.Add("Purpose", TypeDescription);
			
			TypeDescription = New TypeDescription("Number", New NumberQualifiers);
			SpecificationData.Stages.Columns.Add("StartingLotNumber", TypeDescription);
			SpecificationData.Stages.Columns.Add("StartingLotStageNumber", TypeDescription);
			
		EndIf;
		
		If SpecificationData.ManufacturedProducts.Columns.Find("ExpenseItem") = Undefined Then
			TypesOfArticles = New Array;
			TypesOfArticles.Add(Type("ChartOfCharacteristicTypesRef.ExpenseItems"));
			TypesOfArticles.Add(Type("ChartOfCharacteristicTypesRef.AssetLiabilityItems"));
			TypeDescription = New TypeDescription(TypesOfArticles);
			SpecificationData.ManufacturedProducts.Columns.Add("ExpenseItem", TypeDescription);
		EndIf;
		If SpecificationData.ManufacturedProducts.Columns.Find("GLAccountSettings") = Undefined Then
			TypeDescription = New TypeDescription("CatalogRef.OtherTransactionsGLAccountsSettings");
			SpecificationData.ManufacturedProducts.Columns.Add("GLAccountSettings", TypeDescription);
		EndIf;
		If SpecificationData.RecyclableWaste.Columns.Find("ExpenseItem") = Undefined Then
			TypesOfArticles = New Array;
			TypesOfArticles.Add(Type("ChartOfCharacteristicTypesRef.ExpenseItems"));
			TypesOfArticles.Add(Type("ChartOfCharacteristicTypesRef.AssetLiabilityItems"));
			TypeDescription = New TypeDescription(TypesOfArticles);
			SpecificationData.RecyclableWaste.Columns.Add("ExpenseItem", TypeDescription);
		EndIf;
		If SpecificationData.RecyclableWaste.Columns.Find("GLAccountSettings") = Undefined Then
			TypeDescription = New TypeDescription("CatalogRef.OtherTransactionsGLAccountsSettings");
			SpecificationData.RecyclableWaste.Columns.Add("GLAccountSettings", TypeDescription);
		EndIf;
		
		// Preparation for the creation of the party
		If SpecificationData.Property("ProductionLot")
			And ValueIsFilled(SpecificationData.ProductionLot) Then
			
			Query = New Query(
				"SELECT
				|	ProductionLots.Code AS ProductionLotNumber,
				|	MAX(ISNULL(Stages.StartingLotStageNumber, 0)) + 1 AS StartingLotStageNumber
				|FROM
				|	Catalog.ProductionLots AS ProductionLots
				|	
				|	LEFT JOIN Document.ProductionStage2_2 AS Stages
				|	ON ProductionLots.Ref = Stages.ProductionLot
				|WHERE
				|	ProductionLots.Ref = &Ref
				|GROUP BY
				|	ProductionLots.Code");
			Query.SetParameter("Ref", SpecificationData.ProductionLot);
			Selection = Query.Execute().Select();
			Selection.Next();
			
			ProductionLot = SpecificationData.ProductionLot;
			ProductionLotNumber = Selection.ProductionLotNumber;
			StartingLotStageNumber = Selection.StartingLotStageNumber;
			
		Else
			
			ProductionLot = Undefined;
			ProductionLotNumber = -1;
			StartingLotStageNumber = 1;
			
			SpecificationData.Insert("ProductionLot", Undefined);
			BatchFields = BatchFields(SpecificationData, SpecificationData.MainProduct,, SpecificationData);
			
			StringBatch = ProductionLots.Add();
			FillPropertyValues(StringBatch, BatchFields);
			StringBatch.SpecificationDataIndex = IndexData;
			
		EndIf;
		
		// Filling in the stages
		AssignmentProducts = SpecificationData.AssignmentProducts;
		IsolationScheme = SeparationSchemes[ReferenceOrder][AssignmentProducts];
		SpecificationData.Insert("IsolationScheme", IsolationScheme);
		
		For Each Data_Stage In SpecificationData.Stages Do
			
			Data_Stage.ReferenceOrder = ReferenceOrder;
			Data_Stage.AssignmentProducts = AssignmentProducts;
			Data_Stage.ProductionLot = ProductionLot;
			
			If Data_Stage.ProductionStage.IsEmpty() Then
				Data_Stage.ProductionStage = Documents.ProductionStage2_2.GetRef();
				Data_Stage.Purpose = Catalogs.Assignments.GetRef();
				Data_Stage.StartingLotNumber = ProductionLotNumber;
				Data_Stage.StartingLotStageNumber = StartingLotStageNumber;
				
				StartingLotStageNumber = StartingLotStageNumber + 1;
			EndIf;
			
			SeparationSettings = ProductionSupply.PurposeOfProvidingProductionStageAccordingToScheme(
				IsolationScheme,
				Data_Stage.Purpose,
				Data_Stage.WorkPlanning);
			Data_Stage.AssignmentSemiFinishedProducts = SeparationSettings.AssignmentSemiFinishedProducts;
			
			StagesByCodes.Insert(Data_Stage.StageCode, Data_Stage);
			
		EndDo;
		
		// Assignments of materials
		FillInAssignmentOfMaterialsSpecifications(
			SpecificationData,
			SpecificationData.Stages,
			IsolationScheme,
			?(SpecificationData.Property("AssignmentsOfMaterials"), SpecificationData.AssignmentsOfMaterials, Undefined));
		
		// Appointments and accounts of accounting in Output and By-finished Products
		For Each TSName In NamesOfTSIssue Do
			For Each String In SpecificationData[TSName] Do
				// Purpose
				If ValueIsFilled(String.RecipientStageCode) Then
					FillInAppointments.Add(String);
				ElsIf String.ItemsType = Enums.ItemsTypes.ReusablePackage Then
					String.Purpose = Catalogs.Assignments.EmptyRef();
				ElsIf Not ValueIsFilled(String.Purpose) Then
					If TSName = "ManufacturedProducts"
						And SpecificationData.ProductionProcessType = Enums.ProductionProcessTypes.Disassembly Then
						String.Purpose = PurposeOfReverseKittingComponents;
					ElsIf TSName = "RecyclableWaste"
						And String.ItIsSubjectToRAndM Then
						String.Purpose = IsolationScheme.AssignmentMaterials;
					EndIf;
					If Not ValueIsFilled(String.Purpose) And ValueIsFilled(FreeReleaseAssignment) Then
						String.Purpose = FreeReleaseAssignment;
					EndIf;
				EndIf;
				
				// Accounting accounts
				If ValueIsFilled(String.ExpenseItem)
					And TypeOf(String.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.AssetLiabilityItems")
					And Not ValueIsFilled(String.GLAccountSettings) Then
					FillLine = FillInAccountingAccountSetting.Add();
					FillLine.ProductTable_Row = String;
					FillLine.ExpenseItem = String.ExpenseItem;
				EndIf;
			EndDo;
		EndDo;
		
		If ValueIsFilled(SpecificationData.PlanNoEarlierThanStageCode) Then
			FillInPLNoEarlier.Add(SpecificationData);
		EndIf;
	EndDo;
	
	For Each String In FillInAppointments Do
		String.StageConsumer = StagesByCodes[String.RecipientStageCode].ProductionStage;
		String.Purpose = StagesByCodes[String.RecipientStageCode].AssignmentSemiFinishedProducts;
	EndDo;
	For Each SpecificationData In FillInPLNoEarlier Do
		Stage = SpecificationData.Stages.Find(1, "StageNumber");
		If Stage <> Undefined Then
			Stage.PlanNotEarlierThan = StagesByCodes[SpecificationData.PlanNoEarlierThanStageCode].ProductionStage;
		EndIf;
	EndDo;
	If FillInAccountingAccountSetting.Count() > 0 Then
		ARTICLES__ = FillInAccountingAccountSetting.Copy(, "ExpenseItem");
		ARTICLES__.GroupBy("ExpenseItem");
		SettingsOfAccounts = GLAccountSettingsInternalServerCall.DefaultAccountSettingsData(
			ARTICLES__.UnloadColumn("ExpenseItem"));
		
		For Each FillLine In FillInAccountingAccountSetting Do
			If SettingsOfAccounts[FillLine.ExpenseItem] <> Undefined Then
				FillLine.ProductTable_Row.GLAccountSettings = 
					GLAccountSettingsServer.NewAccountSettings_(SettingsOfAccounts[FillLine.ExpenseItem].ConfigurationData);
			EndIf;
		EndDo;
	EndIf;
	
	If ProductionLots.Count() <> 0 Then
		
		Catalogs.ProductionLots.GenerateProductionBatchesForListOfStages(ProductionLots);
		
		For IndexOf = -ProductionLots.Count()+1 To 0 Do
			StringBatch = ProductionLots[-IndexOf];
			If StringBatch.ProductionLot.IsEmpty() Then
				// The batch has not been created - the chain of documents cannot be created
				SpecificationsData.Delete(StringBatch.SpecificationDataIndex);
			Else
				SpecificationData = SpecificationsData[StringBatch.SpecificationDataIndex];
				SpecificationData.Insert("ProductionLot", StringBatch.ProductionLot);
				SpecificationData.Stages.FillValues(StringBatch.ProductionLot, "ProductionLot");
				SpecificationData.Stages.FillValues(StringBatch.Code, "StartingLotNumber");
			EndIf;
		EndDo;
		
	EndIf;
	
	ProductionStage2_2Localization.AddSpecificationData(SpecificationsData);
	
EndProcedure

Procedure FillInAssignmentOfMaterialsSpecifications(SpecificationData, Stages, IsolationScheme, AssignmentsOfMaterials)
	
	TypeDescription = New TypeDescription("CatalogRef.Assignments");
	If SpecificationData.MaterialsAndServices.Columns.Find("Purpose") = Undefined Then
		SpecificationData.MaterialsAndServices.Columns.Add("Purpose", TypeDescription);
	EndIf;
	If SpecificationData.MaterialsAndServices.Columns.Find("SupplyAssignment") = Undefined Then
		SpecificationData.MaterialsAndServices.Columns.Add("SupplyAssignment", TypeDescription);
	EndIf;
	If SpecificationData.IncomingProducts.Columns.Find("Purpose") = Undefined Then
		SpecificationData.IncomingProducts.Columns.Add("Purpose", TypeDescription);
	EndIf;
	If SpecificationData.IncomingProducts.Columns.Find("SupplyAssignment") = Undefined Then
		SpecificationData.IncomingProducts.Columns.Add("SupplyAssignment", TypeDescription);
	EndIf;
	
	AssignmentsOfMaterialsFromScheme = (AssignmentsOfMaterials = Undefined)
		Or AssignmentsOfMaterials.Count() = 0;
	
	If AssignmentsOfMaterials = Undefined Then
		AssignmentsOfMaterials = New ValueTable();
		AssignmentsOfMaterials.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
		AssignmentsOfMaterials.Columns.Add("ZoomRatio", New TypeDescription("Number", New NumberQualifiers()));
	EndIf;
	
	If AssignmentsOfMaterialsFromScheme Then
		AssignmentsOfMaterials.Add();
		AssignmentsOfMaterials[0].ZoomRatio = 1;
	EndIf;
	
	For Each String In Stages Do
		
		SeparationSettings = ProductionSupply.PurposeOfProvidingProductionStageAccordingToScheme(
			IsolationScheme, String.Purpose, String.WorkPlanning);
		
		If AssignmentsOfMaterialsFromScheme Then
			AssignmentsOfMaterials[0].Purpose = SeparationSettings.AssignmentMaterials;
		EndIf;
		
		ProductionSupply.FillInAssignmentOfMaterialsSpecifications(
			SpecificationData,
			String.Stage,
			AssignmentsOfMaterials,
			SeparationSettings.AssignmentSemiFinishedProducts);
		
	EndDo;
	
EndProcedure

