		QueryText = QueryTextTableProductsRelease(Undefined, QueryTexts, RegisterName, Undefined);
		
		TemporaryTableNames.Add("DocumentDataTableOutputFinishedProducts");
		TemporaryTableNames.Add("DocumentDataTableOfByFinishedProducts");
		
	ElsIf RegisterName = "LaborCostsToRegister" Then
		
		QueryText = QueryTextTableLaborCostsToRegister(
						Undefined,
						QueryTexts,
						RegisterName,
						Undefined);
		
		TemporaryTableNames.Add("DocumentDataTableLaborCosts");
		
	ElsIf RegisterName = "CompanyGoods" Then
		
		QueryText = QueryTextTableCompanyGoods(Undefined, QueryTexts, RegisterName, Undefined);
		
		TemporaryTableNames.Add("DocumentDataTableTypesOfProductStocks");
		TemporaryTableNames.Add("DocumentDataTableTypesOfStocksMaterials");
		
	ElsIf RegisterName = "ReflectionOfDocumentsInLocalAccounting" Then
		
		ProductionStage2_2Localization.AddRequestTexts(
			Undefined,
			QueryTexts,
			RegisterName,
			Undefined);
		
		QueryText = QueryTexts[QueryTexts.Count() - 1].Value;
		
		TemporaryTableNames.Add("DocumentDataTableTypesOfProductStocks");
		TemporaryTableNames.Add("DocumentDataTableTypesOfStocksMaterials");
		TemporaryTableNames.Add("DocumentDataTableOutputFinishedProducts");
		TemporaryTableNames.Add("DocumentDataTableOfByFinishedProducts");
		TemporaryTableNames.Add("DocumentDataTableProvisionOfMaterialsAndWorks");
		TemporaryTableNames.Add("DocumentDataTableOfExpensesOfMaterialsAndWorks");
		
	ElsIf RegisterName = "ShipmentAndReturnReferences" Then
		
		QueryText = QueryTextTableShipmentReferences(
						Undefined,
						QueryTexts,
						RegisterName,
						Undefined);
		
		TemporaryTableNames.Add("DocumentDataHeader");
		TemporaryTableNames.Add("DocumentDataTableProvisionOfMaterialsAndWorks");
		
	ElsIf RegisterName = "OrderStructure" Then
		
		QueryText = QueryTextTableOrderStructure(Undefined, QueryTexts, Undefined, Undefined);
		
		TemporaryTableNames.Add("DocumentDataHeader");
		TemporaryTableNames.Add("DocumentDataTableOutputFinishedProducts");
		TemporaryTableNames.Add("DocumentDataTableOfByFinishedProducts");
		TemporaryTableNames.Add("DocumentDataTableProvisionOfMaterialsAndWorks");
		
		ParameterValues.Insert("EmptyLinkKey", CommonClientServer.BlankUUID());
		
	ElsIf RegisterName = "OrderStructureLaborCosts" Then
		
		QueryText = QueryTextTableOrderStructureLaborCosts(
						Undefined,
						QueryTexts,
						RegisterName,
						Undefined);
		
		TemporaryTableNames.Add("DocumentDataHeader");
		TemporaryTableNames.Add("DocumentDataTableLaborCosts");
		
	Else
		ExceptionText = NStr("vi = 'Trong chứng từ %FullDocumentName% không thực hiện yêu cầu tạo bản ghi kết chuyển theo biểu ghi %RegisterName%.';
							|ru = 'В документе %FullDocumentName% не реализована адаптация текста запроса формирования движений по регистру %RegisterName%.';
							|en = 'In document %FullDocumentName%, adaptation of request for generating records of register %RegisterName% is not implemented.'; fa = 'In document %FullDocumentName%, adaptation of request for generating records of register %RegisterName% is not implemented.';
							|it = 'Nel documento %FullDocumentName% non è stato effettuato l''adattamento di testo della richiesta di generazione di movimenti sul registro%RegisterName%.';
							|pl = 'W dokumencie %FullDocumentName% nie jest realizowana adaptacja tekstu zapytania tworzenia przepływów w rejestrze %RegisterName%.';
							|tr = '%FullDocumentName% belgesinde, %RegisterName% kaydına göre hareketlerin düzenlenmesi talebinin metin uyarlaması uygulanmadı.'");
		ExceptionText = StrReplace(ExceptionText, "%FullDocumentName%", FullDocumentName);
		ExceptionText = StrReplace(ExceptionText, "%RegisterName%", RegisterName);
		
		Raise ExceptionText;
	EndIf;
	
	If TemporaryTableNames.Count() > 0 Then
		
		RedefineTemporaryTablesInQueryText(QueryText, TemporaryTableNames, QueryTexts);
		
	EndIf;
	
	If RegisterName = "DocumentsRegistry"
	 Or RegisterName = "OrderStructure"
	 Or RegisterName = "OrderStructureLaborCosts" Then
		
		QueryText = InfobaseUpdateTM.AdaptRequestForIndependentRegister(
			QueryText,
			FullDocumentName,
			SynonymForDocumentTable,
			RequestHasSource,
			RedefiningParameterCalculation,
			TemporaryTableQueryTexts);
		
	Else
		
		QueryText = InfobaseUpdateTM.AdaptRequestOfHoldingMechanism(
			QueryText,
			FullDocumentName,
			SynonymForDocumentTable,
			RedefiningParameterCalculation,
			TemporaryTableQueryTexts);
		
	EndIf;
	
	Result = InfobaseUpdateTM.ResultOfRequestAdaptation();
	Result.ParameterValues = ParameterValues;
	Result.QueryText = QueryText;
	
	Return Result;
	
EndFunction

