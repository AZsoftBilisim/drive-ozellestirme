// Forms an extended representation of the production stage according to the document data.
// If you need to get a view in a request, then you should
// use the Textquery function to represent this step.
//
// Parameters:
//  Data_Stage - Structure, DocumentRef.ProductionStage2_2 - stage data for generating a view:
//		* Number - String
//		* StageName - String
//		* Status - String
//		* Department - String
//
// Returns:
//  String - presentation of the production stage.
//
Function ExtendedStageView(Data_Stage) Export
	
	If TypeOf(Data_Stage) = Type("DocumentRef.ProductionStage2_2") Then
		Query = New Query();
		Query.SetParameter("Ref", Data_Stage);
		Query.Text = "
		|SELECT
		|	ProductionStage2_2.Number                        AS Number,
		|	ProductionStage2_2.StageName            AS StageName,
		|	PRESENTATION(ProductionStage2_2.Status)        AS StatusPresentation,
		|	PRESENTATION(ProductionStage2_2.Department) AS DepartmentPresentation
		|FROM
		|	Document.ProductionStage2_2 AS ProductionStage2_2
		|WHERE
		|	ProductionStage2_2.Ref = &Ref";
		Attributes = Query.Execute().Unload()[0];
	Else
		Attributes = Data_Stage;
	EndIf;
	
	Return StrTemplate("%1, %2, %3, %4", Attributes.Number, Attributes.DepartmentPresentation, Attributes.StageName, Attributes.StatusPresentation);
	
EndFunction

// Forms a representation of the main product of the stage.
//
// Parameters:
//  Ref - DocumentRef.ProductionStage2_2 - stage.
//
// Returns:
//  String - presentation of the main product.
//
Function MainProductPresentation(Ref) Export
	
	MainProductPresentation = "";
	
	Query = New Query(
	"SELECT
	|	ISNULL(Table.ProductionLot.MainProductProducts.Description, """") AS ProductsPresentation,
	|	CASE
	|		WHEN Table.ProductionLot.MainProductCharacteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND Table.ProductionLot.MainProductProducts.UseVariants IN (
	|					VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind), 
	|					VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems), 
	|					VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|			THEN Table.ProductionLot.MainProductCharacteristic.Description
	|		ELSE """"
	|	END AS CharacteristicPresentation
	|FROM
	|	Document.ProductionStage2_2 AS Table
	|WHERE
	|	Table.Ref = &Ref
	|;
	|
	|SELECT
	|	SUM(Table.Count) AS Count
	|FROM
	|(
	|SELECT
	|	SUM(1) AS Count
	|FROM
	|	Document.ProductionStage2_2 AS Document
	|		LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS TabularSection
	|			ON (Document.ProductionLot = TabularSection.Ref.ProductionLot
	|				AND NOT TabularSection.Canceled
	|				AND TabularSection.Ref.Posted)
	|WHERE
	|	Document.Ref = &Ref
	|	AND Document.ProductionLot.ProcessType IN (VALUE(Enum.ProductionProcessTypes.Assembly),
	|															VALUE(Enum.ProductionProcessTypes.PerformRM),
	|															VALUE(Enum.ProductionProcessTypes.Repair),
	|															VALUE(Enum.ProductionProcessTypes.WithoutBillsOfMaterials))
	|
	|UNION ALL
