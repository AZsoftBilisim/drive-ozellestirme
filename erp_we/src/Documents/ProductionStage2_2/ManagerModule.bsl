											|it = 'Нельзя провести документ с действием Отгрузить по назначению Нового этапа, т.к. не может быть остатков по такому назначению (строка %1 списка ""%2"").';
											|pl = 'Cannot post the document with the ""Ship by new stage assignment"" action. There can be no balance by such assignment (line %1 of the %2 list).';
											|tr = 'Bu atamaya göre bakiye olamayacağından dolayı Yeni Aşama Atamasına Sevk Et eylemiyle belge kaydedilemez (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters); 
	
	CheckParameters = ParametersForVerifyingBankingDetails("UnderRepairVariant", "RepairedFinishedProductCharacteristicIsNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	QueryText = 
	"SELECT
	|	NestedQuery.LineNumber AS LineNumber,
	|	NestedQuery.ProductsNotFilledIn,
	|	NestedQuery.CharacteristicNotFilledIn_,
	|	NestedQuery.ShipmentDateNotFilledIn,
	|	NestedQuery.PFSecurityOption,
	|	NestedQuery.SecurityOptionStageCompleted,
	|	NestedQuery.WarehouseIsNotFull,
	|	NestedQuery.BillOfMaterialsHasNotBeenCompleted,
	|	NestedQuery.DifferentBillOfMaterialsOfSameItem,
	|	NestedQuery.ShipmentUnavailable,
	|	NestedQuery.ShipmentUnavailableOrderStatus,
	|	NestedQuery.ShipmentUnavailableOrderNotCompleted,
	|	NestedQuery.ShipmentUnavailableNoOrder,
	|	NestedQuery.CalculationArticleNotFilledIn,
	|	NestedQuery.NumberOfPackagesNotFilled,
	|	NestedQuery.QuantityNotFilled,
	|	NestedQuery.ReasonForCancellationNotFilledIn,
	|	NestedQuery.YouCanNotChooseGiverAppointment,
	|	NestedQuery.SecurityAssignmentIsNotFilledIn,
	|	NestedQuery.ShipmentToDestinationOfNewStageIsNotAvailable,
	|	NestedQuery.RepairedFinishedProductCharacteristicIsNotFilledIn
	|FROM
	|	(SELECT
	|		TabularSection.LineNumber AS LineNumber,
	|		CASE
	|			WHEN TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductsNotFilledIn,
	|		CASE
	|			WHEN &ItemVariantsAreUsed
	|				AND TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND CAST(TabularSection.Products AS Catalog.Products).UseVariants IN (
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|						VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems),
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CharacteristicNotFilledIn_,
	|		CASE
	|			WHEN StageDetails_.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND TabularSection.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
	|					AND TabularSection.SupplyOption <> VALUE(Enum.SupplyOptions.Ship)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS SecurityOptionStageCompleted,
	|		CASE
	|			WHEN TabularSection.DateOfShipment = DATETIME(1, 1, 1)
	|					AND NOT StageDetails_.NotShipInInstallments
	|					AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ShipmentDateNotFilledIn,
	|		CASE
	|			WHEN TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|					AND NOT StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ShipmentUnavailable,
	|		CASE
	|			WHEN StageDetails_.ProductionByThirdParty
	|					AND ISNULL(AttributesOfOrdersToProcessor.Posted, FALSE)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|					AND NOT TabularSection.Canceled
	|					AND NOT ISNULL(AttributesOfOrdersToProcessor.Status, VALUE(Enum.TollingOrderStatuses.EmptyRef)) IN (
	|									VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|									VALUE(Enum.TollingOrderStatuses.Closed))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ShipmentUnavailableOrderStatus,
	|		CASE
	|			WHEN StageDetails_.ProductionByThirdParty
	|					AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|					AND NOT ISNULL(AttributesOfOrdersToProcessor.Posted, FALSE)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ShipmentUnavailableOrderNotCompleted,
	|		CASE
	|			WHEN StageDetails_.ProductionByThirdParty
	|					AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|					AND StageDetails_.SubcontractOrder = UNDEFINED
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ShipmentUnavailableNoOrder,
	|		CASE
	|			WHEN TabularSection.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
	|					AND NOT TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.TransferedEarlier)
	|					AND CAST(TabularSection.Products AS Catalog.Products).ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS WarehouseIsNotFull,
	|		CASE
	|			WHEN StageDetails_.WorkPlanning
	|					AND TabularSection.Produced
	|					AND TabularSection.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS BillOfMaterialsHasNotBeenCompleted,
	|		CASE
	|			WHEN StageDetails_.DynamicStructure
	|				AND NOT TabularSection.Canceled
	|				AND NOT TabularSection.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef)
	|				AND TRUE IN (SELECT TOP 1
	|								TRUE
	|							FROM
	|								SupplyWithMaterialsAndWorks AS T
	|							WHERE
	|								TabularSection.Ref = T.Ref 
	|								AND TabularSection.Products   = T.Products
	|	 							AND TabularSection.Characteristic = T.Characteristic
	|	 							AND TabularSection.Warehouse          = T.Warehouse
	|	 							AND TabularSection.Purpose     = T.Purpose
	|								AND NOT TabularSection.BillOfMaterials = T.BillOfMaterials
	|								AND NOT TabularSection.LineNumber = T.LineNumber
	|								AND NOT T.Canceled
	|								AND NOT T.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS DifferentBillOfMaterialsOfSameItem,
	|		CASE
	|			WHEN TabularSection.Produced AND NOT TabularSection.WithAssignment
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS PFSecurityOption,
	|		CASE
	|			WHEN TabularSection.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CalculationArticleNotFilledIn,
	|		CASE
	|			WHEN TabularSection.NumberOfPackages = 0
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NumberOfPackagesNotFilled,
	|		CASE
	|			WHEN TabularSection.Count = 0 AND TabularSection.NumberOfPackages <> 0
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS QuantityNotFilled,
	|		CASE
	|			WHEN TabularSection.Canceled
	|					AND TabularSection.CancellationReason = VALUE(Catalog.ReasonsForProductionCancellation.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ReasonForCancellationNotFilledIn,
	|		CASE
	|			WHEN StageDetails_.Status <> VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated)
	|				AND NOT StageDetails_.BusinessOperation IN (
	|					VALUE(Enum.BusinessTransactions.TollManufacturing2_5))
	|				AND NOT TabularSection.Canceled
	|				AND TabularSection.Purpose.AssignmentType IN(
	|					VALUE(Enum.AssignmentTypes.ProvidedMaterialsForStage22),
	|					VALUE(Enum.AssignmentTypes.Giveaway2_5))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS YouCanNotChooseGiverAppointment,
	|		CASE
	|			WHEN TabularSection.WithAssignment
	|					AND (TabularSection.SupplyAssignment = VALUE(Catalog.Assignments.EmptyRef)
	|						OR TabularSection.Purpose = VALUE(Catalog.Assignments.EmptyRef))
	|					AND NOT TabularSection.Canceled
	|					AND NOT TabularSection.Produced
	|					AND TabularSection.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS SecurityAssignmentIsNotFilledIn,
	|		CASE
	|			WHEN TabularSection.Purpose = StageDetails_.Purpose
	|					AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|					AND TabularSection.WithAssignment
	|					AND TabularSection.Ref = VALUE(Document.ProductionStage2_2.EmptyRef)
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ShipmentToDestinationOfNewStageIsNotAvailable,
	|		CASE
	|			WHEN &ItemVariantsAreUsed
	|				AND StageDetails_.ProductionProcessType = VALUE(Enum.ProductionProcessTypes.PerformRM)
	|				AND StageDetails_.WorkPlanning
	|				AND TabularSection.UnderRepairProduct <> VALUE(Catalog.Products.EmptyRef)
	|				AND TabularSection.UnderRepairVariant = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND CAST(TabularSection.UnderRepairProduct AS Catalog.Products).UseVariants IN (
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|						VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems),
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS RepairedFinishedProductCharacteristicIsNotFilledIn
	|	FROM
	|		SupplyWithMaterialsAndWorks AS TabularSection
	|	
	|		LEFT JOIN StageDetails_ AS StageDetails_
	|		ON StageDetails_.Ref = TabularSection.Ref
	|		
	|		LEFT JOIN AttributesOfOrdersToProcessor AS AttributesOfOrdersToProcessor
	|		ON AttributesOfOrdersToProcessor.SubcontractOrder = StageDetails_.SubcontractOrder
	|	) AS NestedQuery
	|WHERE
	|	(NestedQuery.WarehouseIsNotFull
	|			OR NestedQuery.ProductsNotFilledIn
	|			OR NestedQuery.CharacteristicNotFilledIn_
	|			OR NestedQuery.ShipmentDateNotFilledIn
	|			OR NestedQuery.PFSecurityOption
	|			OR NestedQuery.ShipmentUnavailable
	|			OR NestedQuery.ShipmentUnavailableOrderStatus
	|			OR NestedQuery.ShipmentUnavailableOrderNotCompleted
	|			OR NestedQuery.ShipmentUnavailableNoOrder
	|			OR NestedQuery.SecurityOptionStageCompleted
	|			OR NestedQuery.CalculationArticleNotFilledIn
	|			OR NestedQuery.NumberOfPackagesNotFilled
	|			OR NestedQuery.QuantityNotFilled
	|			OR NestedQuery.ReasonForCancellationNotFilledIn
	|			OR NestedQuery.YouCanNotChooseGiverAppointment
	|			OR NestedQuery.SecurityAssignmentIsNotFilledIn
	|			OR NestedQuery.ShipmentToDestinationOfNewStageIsNotAvailable
	|			OR NestedQuery.RepairedFinishedProductCharacteristicIsNotFilledIn
	|			OR NestedQuery.BillOfMaterialsHasNotBeenCompleted
	|			OR NestedQuery.DifferentBillOfMaterialsOfSameItem)
	|
	|ORDER BY
	|	LineNumber
	|";
	
	Query = New Query(QueryText);
	Query.TempTablesManager = TempTablesManager;
	Query.SetParameter("ItemVariantsAreUsed", GetFunctionalOption("UseItemVariants"));
	
	AccountingForTraceableGoodsLocalization.SetParametersForUsingTrackingOfTraceableGoods(Query);
	
	Selection = Query.Execute().Select();
	
	NotifyFillErrors(
		Object,
		Selection,
		AttributesList,
		"SupplyWithMaterialsAndWorks",
		Cancel);
	
EndProcedure

Procedure CheckLaborCosts(Object, TempTablesManager, CheckedAttributes, NotCheckedAttributeArray, Cancel)
	
	CheckLaborCosts_ = TempTablesManager.Tables.Find("LaborCosts") <> Undefined;
	If Not CheckLaborCosts_ Then
		DisableTSFillCheck("LaborCosts", CheckedAttributes, NotCheckedAttributeArray);
		Return;
	EndIf;
	
	AttributesList = New Array;
	
	CheckParameters = ParametersForVerifyingBankingDetails("Count", "QuantityNotFilled");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Performer", "PerformerNotFilledIn_");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Completed2", "CompletedNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("ExecutionDate", "CompletionDateNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("ExecutionDate", "CompletionDateIsLessThanActualStartOfStage");
	CheckParameters.MessageTemplate = NStr("vi = 'Ngày hoàn thành công việc không thể nhỏ hơn ngày bắt đầu của công đoạn (dòng %1 của danh sách ""%2"").';
											|ru = 'Дата выполнения работы не может быть меньше даты начала этапа (строка %1 списка ""%2"").';
											|en = 'Work completion date cannot be less than the stage start date (line %1 of the %2 list).'; fa = 'Work completion date cannot be less than the stage start date (line %1 of the %2 list).';
											|it = 'La data di completamento del lavoro non può essere precedente all''inizio della fase (riga %1 dell''elenco ""%2"").';
											|pl = 'Data zakończenia pracy nie może być mniejsza niż data początkowa etapu (wiersz %1 listy ""%2"").';
											|tr = 'İş gerçekleştirme tarihi, aşama başlangıç tarihinden önce olamaz (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("ExecutionDate", "CompletionDateIsGreaterThanActualEndOfStage");
	CheckParameters.MessageTemplate = NStr("vi = 'Ngày thực hiện công việc không thể lớn hơn ngày thực hiện công đoạn (dòng %1 của danh sách ""%2"").';
											|ru = 'Дата выполнения работы не может быть больше даты выполнения этапа (строка %1 списка ""%2"").';
											|en = 'Work completion date cannot be greater than the stage fulfillment date (line %1 of the %2 list).'; fa = 'Work completion date cannot be greater than the stage fulfillment date (line %1 of the %2 list).';
											|it = 'La data di completamento del lavoro non può essere successiva alla data di completamento della fase (riga %1 dell''elenco ""%2"").';
											|pl = 'Data zakończenia pracy nie może być większa niż data zakończenia etapu (wiersz %1 listy ""%2"").';
											|tr = 'İş gerçekleştirme tarihi, aşamanın gerçekleştirilme tarihinden önce olamaz (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("ProductCostElement", "CalculationArticleNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("CancellationReason", "ReasonForCancellationNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	QueryText = 
	"SELECT
	|	NestedQuery.LineNumber,
	|	NestedQuery.QuantityNotFilled,
	|	NestedQuery.PerformerNotFilledIn_,
	|	NestedQuery.CompletedNotFilledIn,
	|	NestedQuery.CompletionDateNotFilledIn,
	|	NestedQuery.CompletionDateIsLessThanActualStartOfStage,
	|	NestedQuery.CompletionDateIsGreaterThanActualEndOfStage,
	|	NestedQuery.CalculationArticleNotFilledIn,
	|	NestedQuery.ReasonForCancellationNotFilledIn
	|FROM
	|	(SELECT
	|		TabularSection.LineNumber AS LineNumber,
	|		CASE
	|			WHEN TabularSection.Count = 0
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS QuantityNotFilled,
	|		CASE
	|			WHEN TabularSection.Completed2 AND TabularSection.Performer IN (
	|													UNDEFINED,
	|													VALUE(Catalog.Teams.EmptyRef),
	|													VALUE(Catalog.Persons.EmptyRef))
	|				AND NOT StageDetails_.Status IN (VALUE(Enum.StatusesOfProductionStages2_2.BeingGenerated),
	|												VALUE(Enum.StatusesOfProductionStages2_2.Generated1))
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS PerformerNotFilledIn_,
	|		CASE
	|			WHEN NOT TabularSection.Completed2
	|				AND StageDetails_.Status IN (VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompletedNotFilledIn,
	|		CASE
	|			WHEN TabularSection.Completed2
	|				AND TabularSection.ExecutionDate = DATETIME(1,1,1)
	|				AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompletionDateNotFilledIn,
	|		CASE
	|			WHEN TabularSection.ExecutionDate <> DATETIME(1, 1, 1)
	|					AND TabularSection.ExecutionDate < BEGINOFPERIOD(StageDetails_.ActualStageStart, DAY) 
	|					AND TabularSection.Completed2
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompletionDateIsLessThanActualStartOfStage,
	|		CASE
	|			WHEN TabularSection.ExecutionDate <> DATETIME(1, 1, 1)
	|					AND TabularSection.ExecutionDate > StageDetails_.ActualStageEnd 
	|					AND TabularSection.Completed2
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CompletionDateIsGreaterThanActualEndOfStage,
	|		CASE
	|			WHEN TabularSection.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|					AND NOT TabularSection.Canceled
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CalculationArticleNotFilledIn,
	|		CASE
	|			WHEN TabularSection.Canceled
	|					AND TabularSection.CancellationReason = VALUE(Catalog.ReasonsForProductionCancellation.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ReasonForCancellationNotFilledIn
	|	FROM
	|		LaborCosts AS TabularSection
	|			LEFT JOIN StageDetails_ AS StageDetails_
	|				ON StageDetails_.Ref = TabularSection.Ref) AS NestedQuery
	|WHERE
	|	(NestedQuery.QuantityNotFilled
	|		OR NestedQuery.PerformerNotFilledIn_
	|		OR NestedQuery.CompletedNotFilledIn
	|		OR NestedQuery.CompletionDateNotFilledIn
	|		OR NestedQuery.CompletionDateIsLessThanActualStartOfStage
	|		OR NestedQuery.CompletionDateIsGreaterThanActualEndOfStage
	|		OR NestedQuery.CalculationArticleNotFilledIn
	|		OR NestedQuery.ReasonForCancellationNotFilledIn
	|	)
	|
	|ORDER BY
	|	NestedQuery.LineNumber";
	
	Query = New Query(QueryText);
	Query.TempTablesManager = TempTablesManager;
	
	Selection = Query.Execute().Select();
	NotifyFillErrors(
		Object,
		Selection,
		AttributesList,
		"LaborCosts",
		Cancel);
	
EndProcedure

Procedure CheckConsumptionOfMaterialsAndWorks(Object, TempTablesManager, CheckedAttributes, NotCheckedAttributeArray, Cancel)
	
	CheckConsumptionOfMaterialsAndWorks_ = TempTablesManager.Tables.Find("MaterialsAndWorksConsumption") <> Undefined;
	If Not CheckConsumptionOfMaterialsAndWorks_ Then
		DisableTSFillCheck("MaterialsAndWorksConsumption", CheckedAttributes, NotCheckedAttributeArray);
		Return;
	EndIf;
	
	AttributesList = New Array;
	
	CheckParameters = ParametersForVerifyingBankingDetails("Products", "ProductsNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Characteristic", "CharacteristicNotFilledIn_");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("DateOfMaterialWorkConsumption", "ExpenseDateNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("DateOfMaterialWorkConsumption", "ExpenseDateIsLessThanActualStartOfStage");
	CheckParameters.MessageTemplate = NStr("vi = 'Ngày chi phí không thể nhỏ hơn ngày bắt đầu của kỳ (dòng %1 của danh sách ""%2"").';
											|ru = 'Дата расхода не может быть меньше даты начала этапа (строка %1 списка ""%2"").';
											|en = 'Consumption date cannot be less than the stage start date (line %1 of the %2 list).'; fa = 'Consumption date cannot be less than the stage start date (line %1 of the %2 list).';
											|it = 'La data della spesa non può essere precedente alla data dell''inizio della fase (riga %1 dell''elenco ""%2"").';
											|pl = 'Data rozchodu nie może być mniejsza niż data rozpoczęcia etapu (wiersz %1 listy ""%2"").';
											|tr = 'Sarfiyat tarihi, aşama başlangıç tarihinden önce olamaz (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("DateOfMaterialWorkConsumption", "ExpenseDateIsLongerThanActualEndOfStage");
	CheckParameters.MessageTemplate = NStr("vi = 'Ngày chi phí không thể lớn hơn ngày kỳ hoàn thành (dòng %1 của danh sách ""%2"").';
											|ru = 'Дата расхода не может быть больше даты выполнения этапа (строка %1 списка ""%2"").';
											|en = 'Consumption date cannot be greater than the stage fulfillment date (line %1 of the %2 list).'; fa = 'Consumption date cannot be greater than the stage fulfillment date (line %1 of the %2 list).';
											|it = 'La data della spesa non può essere successiva alla data del completamento della fase (riga %1 dell''elenco ""%2"").';
											|pl = 'Data rozchodu nie może być większa niż data zakończenia etapu (wiersz %1 listy ""%2"").';
											|tr = 'Sarfiyat tarihi, aşamanın gerçekleştirilme tarihinden önce olamaz (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("NumberOfPackages", "NumberOfPackagesNotFilled");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Count", "QuantityNotFilled");
	CheckParameters.MessageTemplate = NStr("vi = 'Đã tìm thấy số lượng bằng 0 khi tính lại bằng đơn vị lưu kho tại dòng %1 danh sách ""%2"".';
											|ru = 'Обнаружено нулевое количество при пересчете в единицу хранения в строке %1 списка ""%2"".';
											|en = 'Zero quantity is detected when converted to storage unit in line %1 of the %2 list.'; fa = 'Zero quantity is detected when converted to storage unit in line %1 of the %2 list.';
											|it = 'È stata rilevata la quantità pari a zero nel corso di ricalcolo in unità di stoccaggio nella riga %1 dell''elenco ""%2"".';
											|pl = 'Wykryto zerową ilość podczas ponownego przeliczeniu do jednostki przechowania w wierszu %1 listy ""%2"".';
											|tr = '""%2"" listesinin %1 satırında stok ölçü birimine dönüştürülürken sıfır miktar bulundu.'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("ProductCostElement", "CalculationArticleNotFilledIn");
	CheckParameters.MessageTemplate = NStr("vi = 'Trong trạng thái ""Đã bắt đầu"" và ""Đã hoàn thành"", cần chỉ định dạng tính giá thành (dòng %1 của danh sách ""%2"").';
											|ru = 'В статусе ""Начат"" и ""Завершен"" указание статьи калькуляции является обязательным (строка %1 списка ""%2"").';
											|en = 'Product cost element specification is required in the Started and Completed status (line %1 of the ""%2"" list).'; fa = 'Product cost element specification is required in the Started and Completed status (line %1 of the ""%2"" list).';
											|it = 'Nello stato ""Iniziato"" e ""Completato"" l''indicazione dell''elemento di costo è obbligatoria (riga %1 dell''elenco ""%2"").';
											|pl = 'W statusie ""Rozpoczęty"" i ""Zakończony"" wskazanie pozycji kalkulacji jest obowiązkowe (wiersz %1 listy ""%2"").';
											|tr = '""Başlatıldı"" ve ""Tamamlandı"" durumlarında, ürün maliyet kaleminin belirtilmesi zorunludur (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	Query = New Query(
	"SELECT
	|	NestedQuery.LineNumber,
	|	NestedQuery.ProductsNotFilledIn,
	|	NestedQuery.CharacteristicNotFilledIn_,
	|	NestedQuery.CalculationArticleNotFilledIn,
	|	NestedQuery.ExpenseDateNotFilledIn,
	|	NestedQuery.ExpenseDateIsLessThanActualStartOfStage,
	|	NestedQuery.ExpenseDateIsLongerThanActualEndOfStage,
	|	NestedQuery.NumberOfPackagesNotFilled,
	|	NestedQuery.QuantityNotFilled
	|FROM
	|	(SELECT
	|		TabularSection.LineNumber AS LineNumber,
	|		CASE
	|			WHEN TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductsNotFilledIn,
	|		CASE
	|			WHEN &ItemVariantsAreUsed
	|				AND TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND CAST(TabularSection.Products AS Catalog.Products).UseVariants IN (
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|						VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems),
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CharacteristicNotFilledIn_,
	|		CASE
	|			WHEN TabularSection.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|				AND StageDetails_.Status IN (VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|												VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CalculationArticleNotFilledIn,
	|		CASE
	|			WHEN TabularSection.DateOfMaterialWorkConsumption = DATETIME(1, 1, 1)
	|					AND NOT StageDetails_.ConsumptionInOneDay
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ExpenseDateNotFilledIn,
	|		CASE
	|			WHEN TabularSection.DateOfMaterialWorkConsumption <> DATETIME(1, 1, 1)
	|					AND TabularSection.DateOfMaterialWorkConsumption < BEGINOFPERIOD(StageDetails_.ActualStageStart, DAY)
	|					AND NOT StageDetails_.ConsumptionInOneDay
	|					AND NOT StageDetails_.ProductionByThirdParty
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ExpenseDateIsLessThanActualStartOfStage,
	|		CASE
	|			WHEN TabularSection.DateOfMaterialWorkConsumption <> DATETIME(1, 1, 1)
	|					AND TabularSection.DateOfMaterialWorkConsumption > StageDetails_.ActualStageEnd
	|					AND NOT StageDetails_.ConsumptionInOneDay
	|					AND NOT StageDetails_.ProductionByThirdParty
	|					AND StageDetails_.Status IN (
	|								VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ExpenseDateIsLongerThanActualEndOfStage,
	|		CASE
	|			WHEN TabularSection.NumberOfPackages = 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NumberOfPackagesNotFilled,
	|		CASE
	|			WHEN TabularSection.Count = 0 AND TabularSection.NumberOfPackages <> 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS QuantityNotFilled
	|	FROM
	|		MaterialsAndWorksConsumption AS TabularSection
	|			LEFT JOIN StageDetails_ AS StageDetails_
	|				ON StageDetails_.Ref = TabularSection.Ref) AS NestedQuery
	|WHERE
	|	(NestedQuery.ProductsNotFilledIn
	|		OR NestedQuery.CharacteristicNotFilledIn_
	|		OR NestedQuery.CalculationArticleNotFilledIn
	|		OR NestedQuery.ExpenseDateNotFilledIn
	|		OR NestedQuery.ExpenseDateIsLessThanActualStartOfStage
	|		OR NestedQuery.ExpenseDateIsLongerThanActualEndOfStage
	|		OR NestedQuery.NumberOfPackagesNotFilled
	|		OR NestedQuery.QuantityNotFilled)
	|
	|ORDER BY
	|	NestedQuery.LineNumber");
	Query.SetParameter("ItemVariantsAreUsed", GetFunctionalOption("UseItemVariants"));
	
	Query.TempTablesManager = TempTablesManager;
	Selection = Query.Execute().Select();
	
	NotifyFillErrors(
		Object,
		Selection,
		AttributesList,
		"MaterialsAndWorksConsumption",
		Cancel);

EndProcedure

Procedure CheckSavingMaterials(Object, TempTablesManager, CheckedAttributes, NotCheckedAttributeArray, Cancel)
	
	SavingMaterials = TempTablesManager.Tables.Find("UnusedMaterials") <> Undefined;
	If Not SavingMaterials Then
		DisableTSFillCheck("UnusedMaterials", CheckedAttributes, NotCheckedAttributeArray);
		Return;
	EndIf;

	AttributesList = New Array;
	
	CheckParameters = ParametersForVerifyingBankingDetails("Products", "ProductsNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Characteristic", "CharacteristicNotFilledIn_");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Recipient", "RecipientNotFilledIn");
	CheckParameters.MessageTemplate = NStr("vi = 'Cột người nhận trong hàng %1 của danh sách ""%2"" không được điền.';
											|ru = 'Не заполнена колонка ""Получатель"" в строке %1 списка ""%2"".';
											|en = '""Recipient"" in line %1 of list ""%2"" is not filled in.'; fa = '""Recipient"" in line %1 of list ""%2"" is not filled in.';
											|it = 'La colonna ""compratore"" nella riga %1 dell''elenco ""%2"" non è compilata.';
											|pl = 'Kolumna ""Odbiorca"" w wierszu %1 listy ""%2"" nie jest wypełniona.';
											|tr = '""%2"" listesinin %1 satırında ""Alıcı"" sütunu doldurulmadı.'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Purpose", "IsolationOfContainersIsNotAllowed");
	CheckParameters.MessageTemplate = NStr("vi = 'Không được phép đặt riêng bao bì (dòng %1 của danh sách ""%2"").';
											|ru = 'Не допускается обособление тары (строка %1 списка ""%2"").';
											|en = 'Cannot separate package (line %1 of the ""%2"" list).'; fa = 'Cannot separate package (line %1 of the ""%2"" list).';
											|it = 'Non è consentita la separazione degli imbalaggi (riga %1 dell''elenco ""%2"").';
											|pl = 'Nie jest dopuszczalne oddzielenie opakowania (wiersz %1 listy ""%2"" ).';
											|tr = 'Ambalajların ayrılmasına izin verilmemektedir (""%2"" listesinin %1 satırı).'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("DateOfTransaction", "OperationDateNotFilledIn");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("QualityConfirmationDate", "DateOfQualityConfirmationIsNotFilledIn");
	CheckParameters.MessageTemplate = NStr("vi = 'Chưa điền cột ""Kiểm tra chất lượng trước"" trong dòng %1 của danh sách ""%2"".';
											|ru = 'Не заполнена колонка ""Проверить качество до"" в строке %1 списка ""%2"".';
											|en = 'The ""Check quality before"" column in line %1 of the ""%2"" list is not filled.'; fa = 'The ""Check quality before"" column in line %1 of the ""%2"" list is not filled.';
											|it = 'The ""Check quality before"" column in line %1 of the ""%2"" list is not filled.';
											|pl = 'The ""Check quality before"" column in line %1 of the ""%2"" list is not filled.';
											|tr = '""%2"" listesinin %1 satırında ""Kalite kontrol son tarih"" sütunu doldurulmamış.'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("QualityConfirmationDate", "QualityConfirmationDateIsLessThanOFOperationDate");
	CheckParameters.MessageTemplate = NStr("vi = 'Ngày xác nhận chất lượng không thể nhỏ hơn ngày giao dịch trong dòng %1 của danh sách ""%2"".';
											|ru = 'Дата подтверждения качества не может быть меньше даты операции в строке %1 списка ""%2"".';
											|en = 'Quality confirmation date cannot be earlier than the transaction date in line %1 of the ""%2"" list.'; fa = 'Quality confirmation date cannot be earlier than the transaction date in line %1 of the ""%2"" list.';
											|it = 'Quality confirmation date cannot be earlier than the transaction date in line %1 of the ""%2"" list.';
											|pl = 'Quality confirmation date cannot be earlier than the transaction date in line %1 of the ""%2"" list.';
											|tr = '"" %2"" listesinin %1 satırında kalite onay tarihi, üretim tarihinden önce olamaz.'");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("NumberOfPackages", "NumberOfPackagesNotFilled");
	AttributesList.Add(CheckParameters);
	
	CheckParameters = ParametersForVerifyingBankingDetails("Count", "QuantityNotFilled");
	CheckParameters.MessageTemplate = NStr("vi = 'Số lượng không được phát hiện khi được chuyển đổi sang đơn vị lưu trữ trong dòng %1 của danh sách ""%2"".';
											|ru = 'Обнаружено нулевое количество при пересчете в единицу хранения в строке %1 списка ""%2"".';
											|en = 'Zero quantity is detected when converted to storage unit in line %1 of the %2 list.'; fa = 'Zero quantity is detected when converted to storage unit in line %1 of the %2 list.';
											|it = 'È stata rilevata la quantità pari a zero nel corso di ricalcolo in unità di stoccaggio nella riga %1 dell''elenco ""%2"".';
											|pl = 'Wykryto zerową ilość podczas ponownego przeliczeniu do jednostki przechowania w wierszu %1 listy ""%2"".';
											|tr = '""%2"" listesinin %1 satırında stok ölçü birimine dönüştürülürken sıfır miktar bulundu.'");
	AttributesList.Add(CheckParameters);
	
	Query = New Query(
	"SELECT
	|	NestedQuery.LineNumber,
	|	NestedQuery.ProductsNotFilledIn,
	|	NestedQuery.CharacteristicNotFilledIn_,
	|	NestedQuery.RecipientNotFilledIn,
	|	NestedQuery.OperationDateNotFilledIn,
	|	NestedQuery.DateOfQualityConfirmationIsNotFilledIn,
	|	NestedQuery.QualityConfirmationDateIsLessThanOFOperationDate,
	|	NestedQuery.IsolationOfContainersIsNotAllowed,
	|	NestedQuery.NumberOfPackagesNotFilled,
	|	NestedQuery.QuantityNotFilled
	|FROM
	|	(SELECT
	|		TabularSection.LineNumber AS LineNumber,
	|		CASE
	|			WHEN TabularSection.Products = VALUE(Catalog.Products.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ProductsNotFilledIn,
	|		CASE
	|			WHEN &ItemVariantsAreUsed
	|				AND TabularSection.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|				AND CAST(TabularSection.Products AS Catalog.Products).UseVariants IN (
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind),
	|						VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems),
	|						VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind))
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS CharacteristicNotFilledIn_,
	|		CASE
	|			WHEN TabularSection.DateOfTransaction = DATETIME(1, 1, 1)
	|					AND NOT StageDetails_.ConsumptionInOneDay
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS OperationDateNotFilledIn,
	|		TabularSection.ToControlQuality
	|			AND TabularSection.QualityConfirmationDate = DATETIME(1, 1, 1) AS DateOfQualityConfirmationIsNotFilledIn,
	|		TabularSection.ToControlQuality
	|			AND TabularSection.QualityConfirmationDate < TabularSection.DateOfTransaction AS QualityConfirmationDateIsLessThanOFOperationDate,
	|		CASE
	|			WHEN TabularSection.Recipient IN (UNDEFINED,
	|						VALUE(Catalog.Warehouses.EmptyRef),
	|						VALUE(Catalog.BusinessStructure.EmptyRef))
	|					AND NOT TabularSection.ToExpenseAs
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS RecipientNotFilledIn,
	|		CASE
	|			WHEN TabularSection.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|					AND TabularSection.Purpose <> VALUE(Catalog.Assignments.EmptyRef)
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS IsolationOfContainersIsNotAllowed,
	|		CASE
	|			WHEN TabularSection.NumberOfPackages = 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NumberOfPackagesNotFilled,
	|		CASE
	|			WHEN TabularSection.Count = 0 AND TabularSection.NumberOfPackages <> 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS QuantityNotFilled
	|	FROM
	|		UnusedMaterials AS TabularSection
	|			LEFT JOIN StageDetails_ AS StageDetails_
	|				ON StageDetails_.Ref = TabularSection.Ref) AS NestedQuery
	|WHERE
	|	(NestedQuery.ProductsNotFilledIn
	|			OR NestedQuery.CharacteristicNotFilledIn_
	|			OR NestedQuery.RecipientNotFilledIn
	|			OR NestedQuery.OperationDateNotFilledIn
	|			OR NestedQuery.DateOfQualityConfirmationIsNotFilledIn
	|			OR NestedQuery.QualityConfirmationDateIsLessThanOFOperationDate
	|			OR NestedQuery.IsolationOfContainersIsNotAllowed
	|			OR NestedQuery.NumberOfPackagesNotFilled
	|			OR NestedQuery.QuantityNotFilled)
	|
	|ORDER BY
	|	NestedQuery.LineNumber
	|");
	
	Query.SetParameter("ItemVariantsAreUsed", GetFunctionalOption("UseItemVariants"));
	
	Query.TempTablesManager = TempTablesManager;
	
	Selection = Query.Execute().Select();
	NotifyFillErrors(
		Object,
		Selection,
		AttributesList,
		"UnusedMaterials",
		Cancel);
	
EndProcedure

Procedure CheckEqualityBasedOnMaterials(Object, TempTablesManager, Cancel)
	
	If Cancel
		Or TempTablesManager.Tables.Find("SupplyWithMaterialsAndWorks") = Undefined
		Or TempTablesManager.Tables.Find("MaterialsAndWorksConsumption") = Undefined
		Or TempTablesManager.Tables.Find("UnusedMaterials") = Undefined
		Then
		Return;
	EndIf;
	
	Query = New Query(
	// 0
	"SELECT
	|	TabularSection.Ref               AS Ref,
	|	StageDetails_.Status              AS Status,
	|	MIN(TabularSection.LineNumber) AS LineNumber,
	|	TabularSection.Department        AS Department,
	|	TabularSection.Products         AS Products,
	|	TabularSection.Characteristic       AS Characteristic,
	|	SUM(TabularSection.Count)    AS Count
	|
	|INTO Supply
	|FROM
	|	SupplyWithMaterialsAndWorks AS TabularSection
	|		LEFT JOIN StageDetails_ AS StageDetails_
	|		ON StageDetails_.Ref = TabularSection.Ref
	|WHERE
	|	NOT StageDetails_.ProductionByThirdParty
	|	AND NOT StageDetails_.WorkPlanning
	|	AND NOT TabularSection.Canceled
	|
	|GROUP BY
	|	TabularSection.Ref,
	|	TabularSection.Department,
	|	StageDetails_.Status,
	|	TabularSection.Products,
	|	TabularSection.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// 1
	|SELECT
	|	TabularSection.Ref               AS Ref,
	|	MIN(TabularSection.LineNumber) AS LineNumber,
	|	TabularSection.Department        AS Department,
	|	TabularSection.Products         AS Products,
	|	TabularSection.Characteristic       AS Characteristic,
	|	SUM(TabularSection.Count)    AS Count
	|INTO Expense
	|FROM
	|	MaterialsAndWorksConsumption AS TabularSection
	|		LEFT JOIN StageDetails_ AS StageDetails_
	|		ON StageDetails_.Ref = TabularSection.Ref
	|WHERE
	|	NOT StageDetails_.ProductionByThirdParty
	|	AND NOT StageDetails_.WorkPlanning
	|
	|GROUP BY
	|	TabularSection.Ref,
	|	TabularSection.Department,
	|	TabularSection.Products,
	|	TabularSection.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// 2
	|SELECT
	|	TabularSection.Ref               AS Ref,
	|	MIN(TabularSection.LineNumber) AS LineNumber,
	|	TabularSection.Department        AS Department,
	|	TabularSection.Products         AS Products,
	|	TabularSection.Characteristic       AS Characteristic,
	|	SUM(TabularSection.Count)    AS Count
	|INTO Savings
	|FROM
	|	UnusedMaterials AS TabularSection
	|		LEFT JOIN StageDetails_ AS StageDetails_
	|		ON StageDetails_.Ref = TabularSection.Ref
	|WHERE
	|	NOT StageDetails_.ProductionByThirdParty
	|	AND NOT StageDetails_.WorkPlanning
	|
	|GROUP BY
	|	TabularSection.Ref,
	|	TabularSection.Department,
	|	TabularSection.Products,
	|	TabularSection.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// 3
	|SELECT
	|	Supply.LineNumber AS LineNumber,
	|	CAST(Supply.Products AS Catalog.Products).ItemsType                AS ItemsType,
	|	CAST(Supply.Products AS Catalog.Products).UnitOfMeasure.Presentation AS UnitOfMeasure,
	|	CAST(Supply.Products AS Catalog.Products).UnitOfMeasure.MeasuredValueType AS MeasuredValueType,
	|	CAST(Supply.Products AS Catalog.Products).Presentation                  AS Products,
	|	CAST(Supply.Characteristic AS Catalog.ItemsCharacteristics).Presentation  AS Characteristic,
	|	CAST(InitialTS.Package AS Catalog.PackagesAndUnitsOfMeasure).Presentation           AS Package,
	|	ISNULL(&QueryTextPackagingFactor, 1) AS PackagingFactor,
	|	Supply.Count - (ISNULL(Expense.Count, 0) + ISNULL(Savings.Count, 0)) AS Count
	|FROM
	|	Supply AS Supply
	|		LEFT JOIN SupplyWithMaterialsAndWorks AS InitialTS
	|			ON InitialTS.Ref      = Supply.Ref
	|			 AND InitialTS.LineNumber = Supply.LineNumber
	|		LEFT JOIN Expense AS Expense
	|			ON Expense.Ref         = Supply.Ref
	|			 AND Expense.Department  = Supply.Department
	|			 AND Expense.Products   = Supply.Products
	|			 AND Expense.Characteristic = Supply.Characteristic
	|		LEFT JOIN Savings AS Savings
	|			ON Savings.Ref         = Supply.Ref
	|			 AND Savings.Department  = Supply.Department
	|			 AND Savings.Products   = Supply.Products
	|			 AND Savings.Characteristic = Supply.Characteristic
	|WHERE
	|	Supply.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
	|	AND Supply.Count > ISNULL(Expense.Count, 0) + ISNULL(Savings.Count, 0)
	|
	|ORDER BY
	|	LineNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// 4
	|SELECT
	|	Expense.LineNumber AS LineNumber,
	|	CAST(Expense.Products AS Catalog.Products).ItemsType                  AS ItemsType,
	|	CAST(Expense.Products AS Catalog.Products).UnitOfMeasure.Presentation   AS UnitOfMeasure,
	|	CAST(Expense.Products AS Catalog.Products).UnitOfMeasure.MeasuredValueType AS MeasuredValueType,
	|	CAST(Expense.Products AS Catalog.Products).Presentation                    AS Products,
	|	CAST(Expense.Characteristic AS Catalog.ItemsCharacteristics).Presentation    AS Characteristic,
	|	CAST(InitialTS.Package AS Catalog.PackagesAndUnitsOfMeasure).Presentation        AS Package,
	|	ISNULL(&QueryTextPackagingFactor, 1) AS PackagingFactor,
	|	Expense.Count - ISNULL(Supply.Count, 0) AS Count
	|FROM
	|	Expense AS Expense
	|		LEFT JOIN MaterialsAndWorksConsumption AS InitialTS
	|			ON InitialTS.Ref      = Expense.Ref
	|			 AND InitialTS.LineNumber = Expense.LineNumber
	|		LEFT JOIN Supply AS Supply
	|			ON Expense.Ref         = Supply.Ref
	|			 AND Expense.Department  = Supply.Department
	|			 AND Expense.Products   = Supply.Products
	|			 AND Expense.Characteristic = Supply.Characteristic
	|WHERE
	|	Expense.Count > ISNULL(Supply.Count, 0)
	|
	|ORDER BY
	|	LineNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// 5
	|SELECT
	|	Savings.LineNumber AS LineNumber,
	|	CAST(Savings.Products AS Catalog.Products).ItemsType                AS ItemsType,
	|	CAST(Savings.Products AS Catalog.Products).UnitOfMeasure.Presentation AS UnitOfMeasure,
	|	CAST(Savings.Products AS Catalog.Products).UnitOfMeasure.MeasuredValueType AS MeasuredValueType,
	|	CAST(Savings.Products AS Catalog.Products).Presentation                  AS Products,
	|	CAST(Savings.Characteristic AS Catalog.ItemsCharacteristics).Presentation  AS Characteristic,
	|	CAST(InitialTS.Package AS Catalog.PackagesAndUnitsOfMeasure).Presentation        AS Package,
	|	ISNULL(&QueryTextPackagingFactor, 1) AS PackagingFactor,
	|	Savings.Count - (ISNULL(Supply.Count, 0) - ISNULL(Expense.Count, 0)) AS Count
	|FROM
	|	Savings AS Savings
	|		LEFT JOIN UnusedMaterials AS InitialTS
	|			ON InitialTS.Ref      = Savings.Ref
	|			 AND InitialTS.LineNumber = Savings.LineNumber
	|		LEFT JOIN Supply AS Supply
	|			ON Savings.Ref         = Supply.Ref
	|			 AND Savings.Department  = Supply.Department
	|			 AND Savings.Products   = Supply.Products
	|			 AND Savings.Characteristic = Supply.Characteristic
	|		LEFT JOIN Expense AS Expense
	|			ON Savings.Ref         = Expense.Ref
	|			 AND Savings.Department  = Expense.Department
	|			 AND Savings.Products   = Expense.Products
	|			 AND Savings.Characteristic = Expense.Characteristic
	|WHERE
	|	Savings.Count > (ISNULL(Supply.Count, 0) - ISNULL(Expense.Count, 0))
	|
	|ORDER BY
	|	LineNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Supply
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Expense
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Savings
	|;");
	
	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"CAST(InitialTS.Package AS Catalog.PackagesAndUnitsOfMeasure)",
		"CAST(InitialTS.Products AS Catalog.Products)"));
	
	Query.TempTablesManager = TempTablesManager;
	Result = Query.ExecuteBatch();
	
	If TypeOf(Object) <> Type("DocumentObject.ProductionStage2_2") Then
		DataKey = Undefined;
		DataPath = Object.PathToDetailsOfEditingForm();
	Else
		DataKey = Object;
		DataPath = "";
	EndIf;
	
	// Material consumption is not specified
	If Not Result[3].IsEmpty() Then
		
		MessageTemplateProvidingMore = NStr("vi = 'Tiêu thụ nguyên vật liệu không được chỉ định ""%1"" với số lượng %2 %3';
											|ru = 'Не указан расход материала ""%1"" в количестве %2 %3';
											|en = 'The ""%1"" material consumption in the amount of %2 %3 is not specified'; fa = 'The ""%1"" material consumption in the amount of %2 %3 is not specified';
											|it = 'Nessun consumo di materiale ""%1"" in quantità %2 %3 indicato';
											|pl = 'Nie podano zużycia materiału ""%1"" w ilości %2 %3';
											|tr = '%3 %2 miktarında ""%1"" malzeme sarfiyatı belirtilmedi'");
		MessageTemplateProvidingMoreWork = NStr("vi = 'Quy trình công việc không được chỉ định ""%1"" với số lượng %2 %3';
												|ru = 'Не указан расход работ ""%1"" в количестве %2 %3';
												|en = 'The ""%1"" work consumption in the amount of %2 %3 is not specified'; fa = 'The ""%1"" work consumption in the amount of %2 %3 is not specified';
												|it = 'Nessun consumo di lavoro ""%1"" in quantità %2 %3 indicato';
												|pl = 'Nie podano wykorzystanie prac ""%1"" w ilości %2 %3';
												|tr = '%3 %2 miktarında ""%1"" iş sarfiyatı belirtilmedi'");
		
		Selection = Result[3].Select();
		While Selection.Next() Do
			
			ProductsPresentation = ProductsClientServer.PresentationOfProductsForPrinting(
										Selection.Products, 
										Selection.Characteristic);
										
			If ValueIsFilled(Selection.Package)
				And (Selection.MeasuredValueType <> Enums.TypesOfMeasuredValues.NumberOfPieces
					Or Int(Selection.Count / Selection.PackagingFactor) = (Selection.Count / Selection.PackagingFactor)) Then
				Count = Round(Selection.Count / Selection.PackagingFactor, 3);
				UnitOfMeasure = Selection.Package;
			Else
				Count = Selection.Count;
				UnitOfMeasure = Selection.UnitOfMeasure;
			EndIf;
			
			TemplateText = ?(Selection.ItemsType = Enums.ItemsTypes.Work_5, MessageTemplateProvidingMoreWork, MessageTemplateProvidingMore);
			MessageText = StrTemplate(TemplateText, ProductsPresentation, Format(Count, "NZ=0; NG=0"), UnitOfMeasure);
			
			Field = CommonClientServer.PathToTabularSection("SupplyWithMaterialsAndWorks", Selection.LineNumber, "NumberOfPackages");
			Common.MessageToUser(MessageText, DataKey, Field, DataPath, Cancel);
		
		EndDo;
		
	EndIf;
	
	// The expense exceeds the planned provision
	If Not Result[4].IsEmpty() Then
		
		TemplateOfExpenseMessageIsMore = NStr("vi = 'Số lượng xuất nguyên vật liệu ""%1"" vượt quá số lượng khả dụng là %2 %3';
												|ru = 'Количество расхода материала ""%1"" превышает доступное на %2 %3';
												|en = 'Material consumption amount ""%1"" exceeds the available one by %2 %3'; fa = 'Material consumption amount ""%1"" exceeds the available one by %2 %3';
												|it = 'Quantità di consumo del materiale ""%1"" supera quella disponibile di %2%3';
												|pl = 'Ilość zużycia materiału ""%1"" przekracza dostępne o %2 %3';
												|tr = '""%1"" malzemesinin sarfiyat miktarı, mevcut olanı %3 %2 aşmaktadır'");
		MessageTemplateExpenseIsMoreWork = NStr("vi = 'Số lượng xuất cho công việc ""%1"" vượt quá số lượng khả dụng là %2 %3';
												|ru = 'Количество расхода работы ""%1"" превышает доступное на %2 %3';
												|en = 'Work consumption amount ""%1"" exceeds the available one by %2 %3'; fa = 'Work consumption amount ""%1"" exceeds the available one by %2 %3';
												|it = 'Quantità di consumo di lavoro ""%1"" supera quella disponibile di %2%3';
												|pl = 'Ilość zużycia pracy ""%1"" przekracza dostępne o %2 %3';
												|tr = '""%1"" işinin sarfiyat miktarı mevcut olanı %3 %2 aşmaktadır'");
		
		Selection = Result[4].Select();
		While Selection.Next() Do
			
			ProductsPresentation = ProductsClientServer.PresentationOfProductsForPrinting(
										Selection.Products, 
										Selection.Characteristic);
										
			If ValueIsFilled(Selection.Package)
				And (Selection.MeasuredValueType <> Enums.TypesOfMeasuredValues.NumberOfPieces
					Or Int(Selection.Count / Selection.PackagingFactor) = (Selection.Count / Selection.PackagingFactor)) Then
				Count = Round(Selection.Count / Selection.PackagingFactor, 3);
				UnitOfMeasure = Selection.Package;
			Else
				Count = Selection.Count;
				UnitOfMeasure = Selection.UnitOfMeasure;
			EndIf;
			
			TemplateText = ?(Selection.ItemsType = Enums.ItemsTypes.Work_5, MessageTemplateExpenseIsMoreWork, TemplateOfExpenseMessageIsMore);
			MessageText = StrTemplate(TemplateText, ProductsPresentation, Format(Count, "NZ=0; NG=0"), UnitOfMeasure);
								
			Field = CommonClientServer.PathToTabularSection("MaterialsAndWorksConsumption", Selection.LineNumber, "NumberOfPackages");
			Common.MessageToUser(MessageText, DataKey, Field, DataPath, Cancel);
		
		EndDo;
		
	EndIf;
	
	// The amount of unspent material exceeds the planned provision
	If Not Result[5].IsEmpty() Then
		
		SavingMessageTemplate =
			NStr("vi = 'Số lượng nguyên vật liệu chưa tiêu hao ""%1"" vượt quá số lượng khả dụng là %2 %3';
				|ru = 'Количество неизрасходованного материала ""%1"" превышает доступное на %2 %3';
				|en = 'Unconsumed material amount ""%1"" exceeds the available one by %2 %3'; fa = 'Unconsumed material amount ""%1"" exceeds the available one by %2 %3';
				|it = 'Quantità di materiale non consumato ""%1"" supera quello disponibile di %2%3';
				|pl = 'Ilość niewykorzystanego materiału ""%1"" przekracza dostępne o %2 %3';
				|tr = '""%1"" malzemesinin sarf edilmeyen miktarı, mevcut olanı %3 %2 aşmaktadır'");
		
		Selection = Result[5].Select();
		While Selection.Next() Do
			
			ProductsPresentation = ProductsClientServer.PresentationOfProductsForPrinting(
										Selection.Products, 
										Selection.Characteristic);
										
			If ValueIsFilled(Selection.Package)
				And (Selection.MeasuredValueType <> Enums.TypesOfMeasuredValues.NumberOfPieces
					Or Int(Selection.Count / Selection.PackagingFactor) = (Selection.Count / Selection.PackagingFactor)) Then
				Count = Round(Selection.Count / Selection.PackagingFactor, 3);
				UnitOfMeasure = Selection.Package;
			Else
				Count = Selection.Count;
				UnitOfMeasure = Selection.UnitOfMeasure;
			EndIf;
			
			MessageText = StrTemplate(SavingMessageTemplate,
								ProductsPresentation,
								Format(Count, "NZ=0; NG=0"),
								UnitOfMeasure);
								
			Field = CommonClientServer.PathToTabularSection("UnusedMaterials", Selection.LineNumber, "NumberOfPackages");
			Common.MessageToUser(MessageText, DataKey, Field, DataPath, Cancel);
		
		EndDo;
		
	EndIf;
	
EndProcedure

Procedure CheckProductionDatesOnSide(Object, TempTablesManager, Cancel)
	
	If Cancel
		Or TempTablesManager.Tables.Find("ManufacturedProducts") = Undefined
		Or TempTablesManager.Tables.Find("SideAndIntermediateRelease") = Undefined
		Or TempTablesManager.Tables.Find("SupplyWithMaterialsAndWorks") = Undefined
		Or TempTablesManager.Tables.Find("AttributesOfOrdersToProcessor") = Undefined Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	ProductionDates.Ref                    AS Ref,
	|	MAX(ProductionDates.ProductionDate) AS ProductionDate
	|INTO MaximumProductionDates
	|FROM
	|	(SELECT
	|		StageDetails_.Ref                                AS Ref,
	|		ENDOFPERIOD(ManufacturedProducts.ProductionDate, MONTH) AS ProductionDate
	|	FROM
	|		StageDetails_ AS StageDetails_
	|		
	|		INNER JOIN ManufacturedProducts AS ManufacturedProducts
	|		ON ManufacturedProducts.Ref = StageDetails_.Ref
	|	
	|		INNER JOIN AttributesOfOrdersToProcessor AS AttributesOfOrdersToProcessor
	|		ON AttributesOfOrdersToProcessor.SubcontractOrder = StageDetails_.SubcontractOrder
	|	
	|	WHERE
	|		StageDetails_.ProductionByThirdParty2_5
	|		AND NOT ManufacturedProducts.Canceled
	|		AND AttributesOfOrdersToProcessor.Posted
	|		AND AttributesOfOrdersToProcessor.Status IN(
	|			VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|			VALUE(Enum.TollingOrderStatuses.Closed))
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		StageDetails_.Ref                                AS Ref,
	|		ENDOFPERIOD(SideAndIntermediateRelease.ProductionDate, MONTH) AS ProductionDate
	|	FROM
	|		StageDetails_ AS StageDetails_
	|		
	|		INNER JOIN SideAndIntermediateRelease AS SideAndIntermediateRelease
	|		ON SideAndIntermediateRelease.Ref = StageDetails_.Ref
	|	
	|		INNER JOIN AttributesOfOrdersToProcessor AS AttributesOfOrdersToProcessor
	|		ON AttributesOfOrdersToProcessor.SubcontractOrder = StageDetails_.SubcontractOrder
	|	
	|	WHERE
	|		StageDetails_.ProductionByThirdParty2_5
	|		AND NOT SideAndIntermediateRelease.Canceled
	|		AND AttributesOfOrdersToProcessor.Posted
	|		AND AttributesOfOrdersToProcessor.Status IN(
	|			VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|			VALUE(Enum.TollingOrderStatuses.Closed))
	|	) AS ProductionDates
	|
	|GROUP BY
	|	ProductionDates.Ref
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	StageDetails_.Ref                        AS Ref,
	|	MaximumProductionDates.ProductionDate AS ProductionDate
	|FROM
	|	StageDetails_ AS StageDetails_
	|	
	|	INNER JOIN MaximumProductionDates AS MaximumProductionDates
	|	ON MaximumProductionDates.Ref = StageDetails_.Ref
	|
	|WHERE
	|	StageDetails_.NotShipInInstallments
	|	AND StageDetails_.DateOfShipment > MaximumProductionDates.ProductionDate
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SupplyWithMaterialsAndWorks.Ref        AS Ref,
	|	SupplyWithMaterialsAndWorks.LineNumber   AS LineNumber,
	|	MaximumProductionDates.ProductionDate AS ProductionDate
	|FROM
	|	SupplyWithMaterialsAndWorks AS SupplyWithMaterialsAndWorks
	|	
	|	INNER JOIN StageDetails_ AS StageDetails_
	|	ON StageDetails_.Ref = SupplyWithMaterialsAndWorks.Ref
	|	
	|	INNER JOIN MaximumProductionDates AS MaximumProductionDates
	|	ON MaximumProductionDates.Ref = SupplyWithMaterialsAndWorks.Ref
	|
	|WHERE
	|	NOT StageDetails_.NotShipInInstallments
	|	AND NOT SupplyWithMaterialsAndWorks.Canceled
	|	AND SupplyWithMaterialsAndWorks.DateOfShipment > MaximumProductionDates.ProductionDate
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP MaximumProductionDates
	|";
	
	Query.TempTablesManager = TempTablesManager;
	Result = Query.ExecuteBatch();
	
	If TypeOf(Object) = Type("Structure")
		And Object.Property("SubcontractOrder") Then
		DataKey = Undefined;
		DataPath = "Object";
	ElsIf Not TypeOf(Object) = Type("DocumentObject.ProductionStage2_2") Then
		DataKey = Undefined;
		DataPath = Object.PathToDetailsOfEditingForm();
	Else
		DataKey = Object;
		DataPath = "";
	EndIf;
	
	TextMonthOfShipment = NStr("vi = 'Tháng giao hàng không được lớn hơn tháng tiếp nhận sản phẩm (%1)';
								|ru = 'Месяц отгрузки должен быть не больше месяца поступления изделий (%1)';
								|en = 'Shipment month cannot be greater than the month of finished product receipt (%1)'; fa = 'Shipment month cannot be greater than the month of finished product receipt (%1)';
								|it = 'Il mese di spedizione non deve essere successivo al mese di ricezione della produzione (%1)';
								|pl = 'Miesiąc wysyłki powinien być nie większy niż miesiąc wpływu wyrobów (%1)';
								|tr = 'Sevkiyat ayı, nihai ürün giriş ayından önce olmalıdır (%1)'");
	
	// Do not ship in parts. The month of shipment should be no more than a month of receipt of products and returnable waste.
	If Not Result[1].IsEmpty() Then
		
		Selection = Result[1].Select();
		While Selection.Next() Do
			MessageText = StrTemplate(TextMonthOfShipment, Format(Selection.ProductionDate, "DF='MMMM yyyy'"));
			Common.MessageToUser(MessageText, DataKey, "DateOfShipment", DataPath, Cancel);
		EndDo;
		
	EndIf;
	
	// Ship in parts. The month of shipment should be no more than a month of receipt of products and returnable waste.
	If Not Result[2].IsEmpty() Then
		
		Selection = Result[2].Select();
		While Selection.Next() Do
			
			MessageText = StrTemplate(TextMonthOfShipment, Format(Selection.ProductionDate, "DF='MMMM yyyy'"));
			
			Field =
				CommonClientServer.PathToTabularSection(
					"SupplyWithMaterialsAndWorks",
					Selection.LineNumber,
					"DateOfShipment");
			
			Common.MessageToUser(MessageText, DataKey, Field, DataPath, Cancel);
		
		EndDo;
		
	EndIf;
	
EndProcedure

Procedure CheckConformityOfImportedProductsAndMaterialsOfProductionOnSide(Object, TempTablesManager, Cancel)
	
	If (TempTablesManager.Tables.Find("ManufacturedProducts") = Undefined
			And TempTablesManager.Tables.Find("SideAndIntermediateRelease") = Undefined)
		Or TempTablesManager.Tables.Find("SupplyWithMaterialsAndWorks") = Undefined Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	
	QueryTexts = New Array;
	
	#Region TTImportedProducts
	
	TextsOfProductTable = New Array;
	If Not TempTablesManager.Tables.Find("ManufacturedProducts") = Undefined Then
		TextsOfProductTable.Add(
		"SELECT
		|	TabularSection.Ref					AS Ref,
		|	TabularSection.Products				AS Products,
		|	TabularSection.Characteristic			AS Characteristic,
		|	ISNULL(Goods.KeepRecordsByCCD, FALSE)	AS Imported_,
		|	CASE
		|		WHEN ISNULL(Goods.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) IN
		|					(VALUE(Enum.ItemsTypes.OwnGoods),
		|					VALUE(Enum.ItemsTypes.ReusablePackage))
		|			THEN CASE
		|					WHEN NOT &UseTraceableImportedGoodsAccounting
		|							OR BEGINOFPERIOD(TabularSection.ProductionDate, MONTH) < &DateOfTraceableImportedGoodsAccountingStart
		|						THEN FALSE
		|					ELSE ISNULL(Goods.TracedGoods, FALSE)
		|				END
		|		WHEN &UseTraceableImportedGoodsAccounting
		|			THEN ISNULL(Goods.TracedGoods, FALSE)
		|		ELSE FALSE
		|	END									AS Traceable,
		|	StageDetails_.ThisIsAProductionIssueStage		AS ThisIsAProductionIssueStage
		|FROM
		|	ManufacturedProducts AS TabularSection
		|	
		|	LEFT JOIN StageDetails_ AS StageDetails_
		|	ON TabularSection.Ref = StageDetails_.Ref
		|	
		|	LEFT JOIN Catalog.Products AS Goods
		|	ON TabularSection.Products = Goods.Ref
		|
		|WHERE
		|	ISNULL(Goods.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) IN
		|				(VALUE(Enum.ItemsTypes.OwnGoods),
		|				VALUE(Enum.ItemsTypes.Work_5),
		|				VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND StageDetails_.ProductionByThirdParty
		|	AND ISNULL(Goods.KeepRecordsByCCD, FALSE)
		|");
	EndIf;
	
	If Not TempTablesManager.Tables.Find("SideAndIntermediateRelease") = Undefined Then
		TextsOfProductTable.Add(
		"SELECT
		|	TabularSection.Ref					AS Ref,
		|	TabularSection.Products				AS Products,
		|	TabularSection.Characteristic			AS Characteristic,
		|	ISNULL(Goods.KeepRecordsByCCD, FALSE)	AS Imported_,
		|	CASE
		|		WHEN ISNULL(Goods.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) IN
		|					(VALUE(Enum.ItemsTypes.OwnGoods),
		|					VALUE(Enum.ItemsTypes.ReusablePackage))
		|			THEN CASE
		|					WHEN NOT &UseTraceableImportedGoodsAccounting
		|							OR BEGINOFPERIOD(TabularSection.ProductionDate, MONTH) < &DateOfTraceableImportedGoodsAccountingStart
		|						THEN FALSE
		|					ELSE ISNULL(Goods.TracedGoods, FALSE)
		|				END
		|		WHEN &UseTraceableImportedGoodsAccounting
		|			THEN ISNULL(Goods.TracedGoods, FALSE)
		|		ELSE FALSE
		|	END									AS Traceable,
		|	StageDetails_.ThisIsAProductionIssueStage		AS ThisIsAProductionIssueStage
		|FROM
		|	SideAndIntermediateRelease AS TabularSection
		|	
		|	LEFT JOIN StageDetails_ AS StageDetails_
		|	ON TabularSection.Ref = StageDetails_.Ref
		|	
		|	LEFT JOIN Catalog.Products AS Goods
		|	ON TabularSection.Products = Goods.Ref
		|
		|WHERE
		|	ISNULL(Goods.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			VALUE(Enum.ItemsTypes.Work_5),
		|			VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND StageDetails_.ProductionByThirdParty
		|	AND ISNULL(Goods.KeepRecordsByCCD, FALSE)
		|");
	EndIf;
	
	QueryText =
	"SELECT
	|	ProductTable_.Ref				AS Ref,
	|	ProductTable_.Products			AS Products,
	|	ProductTable_.Characteristic		AS Characteristic,
	|	ProductTable_.Traceable		AS Traceable,
	|	ProductTable_.ThisIsAProductionIssueStage	AS ThisIsAProductionIssueStage
	|INTO TTImportedProducts
	|FROM
	|	&ProductTableIsRedefinable AS ProductTable_
	|
	|GROUP BY
	|	ProductTable_.Ref,
	|	ProductTable_.Products,
	|	ProductTable_.Characteristic,
	|	ProductTable_.Traceable,
	|	ProductTable_.ThisIsAProductionIssueStage
	|
	|INDEX BY
	|	Ref,
	|	Products,
	|	Characteristic
	|";
	
	QueryTexts.Add(
		StrReplace(
			QueryText,
			"&ProductTableIsRedefinable",
			"(" + StrConcat(TextsOfProductTable, TMCommonUse.QuerySeparatorInJoin()) + ")"));
	
	#EndRegion
	
	#Region TTImportedDocumentMaterials
	
	QueryTexts.Add(
	"SELECT
	|	TabularSection.Ref					AS Ref,
	|	TabularSection.Products				AS Products,
	|	TabularSection.Characteristic			AS Characteristic,
	|	MAX(CASE
	|		WHEN NOT &UseTraceableImportedGoodsAccounting
	|				OR BEGINOFPERIOD(TabularSection.DateOfShipment, MONTH) < &DateOfTraceableImportedGoodsAccountingStart
	|			THEN FALSE
	|		ELSE ISNULL(Goods.TracedGoods, FALSE)
	|	END)									AS Traceable,
	|	StageDetails_.ThisIsAProductionIssueStage		AS ThisIsAProductionIssueStage
	|INTO TTImportedDocumentMaterials
	|FROM
	|	SupplyWithMaterialsAndWorks AS TabularSection
	|	
	|	LEFT JOIN StageDetails_ AS StageDetails_
	|	ON TabularSection.Ref = StageDetails_.Ref
	|	
	|	LEFT JOIN Catalog.Products AS Goods
	|	ON TabularSection.Products = Goods.Ref
	|
	|WHERE
	|	StageDetails_.ProductionByThirdParty
	|	AND ISNULL(Goods.KeepRecordsByCCD, FALSE)
	|	AND ISNULL(Goods.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.Work_5),
	|			VALUE(Enum.ItemsTypes.ReusablePackage))
	|
	|GROUP BY
	|	TabularSection.Ref,
	|	TabularSection.Products,
	|	TabularSection.Characteristic,
	|	StageDetails_.ThisIsAProductionIssueStage
	|
	|INDEX BY
	|	Ref,
	|	Products,
	|	Characteristic
	|");
	
	#EndRegion
	
	TextsOfChecks = New Array;
	
	#Region SeveralImportedProducts
	
	TextsOfChecks.Add(
	"SELECT
	|	CASE
	|		WHEN MAX(ImportedProductsOfDocument.ThisIsAProductionIssueStage)
	|			THEN &TableNameOutputProducts
	|		ELSE &NameOfByProductTable
	|	END                            AS TableName,
	|	CASE
	|		WHEN MAX(ImportedProductsOfDocument.ThisIsAProductionIssueStage)
	|			THEN &SynonymForTSOutputProducts
	|		ELSE &SynonymOfTSByProducts
	|	END                            AS TSSynonym,
	|	ImportedProductsOfDocument.Ref AS Ref,
	|	""SeveralImportedProducts""    AS TypeOfVerification
	|FROM
	|	TTImportedProducts AS ImportedProductsOfDocument
	|
	|WHERE
	|	&UseImportedGoods
	|
	|GROUP BY
	|	ImportedProductsOfDocument.Ref
	|
	|HAVING
	|	COUNT(ImportedProductsOfDocument.Ref) > 1
	|");
	
	#EndRegion
	
	#Region ImportedMaterialNotSpecified
	
	TextsOfChecks.Add(
	"SELECT DISTINCT
	|	&NameOfMaterialsAndWorksTable      AS TableName,
	|	&SynonymTSMaterialsAndWorks       AS TSSynonym,
	|	ImportedProductsOfDocument.Ref AS Ref,
	|	""ImportedMaterialNotSpecified""    AS TypeOfVerification
	|FROM
	|	TTImportedProducts AS ImportedProductsOfDocument
	|
	|WHERE
	|	&UseImportedGoods
	|	AND NOT ImportedProductsOfDocument.Traceable
	|	AND NOT ImportedProductsOfDocument.Ref IN
	|			(SELECT
	|				ImportedDocumentMaterials.Ref
	|			FROM
	|				TTImportedDocumentMaterials AS ImportedDocumentMaterials)
	|");
	
	#EndRegion
	
	ProductionStage2_2Localization.AddTextForRNPTVerification(TextsOfChecks);
	
	TabularSections = Metadata.Documents.ProductionStage2_2.TabularSections;
	Query.SetParameter("TableNameOutputProducts",  TabularSections.ManufacturedProducts.Name);
	Query.SetParameter("NameOfByProductTable",  TabularSections.SideAndIntermediateRelease.Name);
	Query.SetParameter("NameOfMaterialsAndWorksTable", TabularSections.SupplyWithMaterialsAndWorks.Name);
	
	Query.SetParameter("SynonymForTSOutputProducts",  TabularSections.ManufacturedProducts.Synonym);
	Query.SetParameter("SynonymOfTSByProducts",  TabularSections.SideAndIntermediateRelease.Synonym);
	Query.SetParameter("SynonymTSMaterialsAndWorks", TabularSections.SupplyWithMaterialsAndWorks.Synonym);
	
	Query.SetParameter("UseImportedGoods", GetFunctionalOption("UseImportedGoods"));
	
	AccountingForTraceableGoodsLocalization.SetParametersForUsingTrackingOfTraceableGoods(Query);
	
	QueryTexts.Add(StrConcat(TextsOfChecks, TMCommonUse.QuerySeparatorInJoin()));
	
	Query.Text = StrConcat(QueryTexts, Common.QueryBatchSeparator());
	
	Selection = Query.Execute().Select();
	If Not Selection.Count() = 0 Then
		
		If TypeOf(Object) = Type("Structure")
			And Object.Property("SubcontractOrder") Then
			DataKey = Undefined;
			DataPath = "Object";
		ElsIf Not TypeOf(Object) = Type("DocumentObject.ProductionStage2_2") Then
			DataKey = Undefined;
			DataPath = Object.PathToDetailsOfEditingForm();
		Else
			DataKey = Object;
			DataPath = "";
		EndIf;
		
		TemplateMultipleImportedProducts = NStr("vi = 'Đối với ""%1"" đã chỉ ra nhiều sản phẩm nhập khẩu.';
												|ru = 'Для ""%1"" указано несколько импортных изделий.';
												|en = 'Several imported finished products are specified for ""%1"".'; fa = 'Several imported finished products are specified for ""%1"".';
												|it = 'Several imported finished products are specified for ""%1"".';
												|pl = 'Several imported finished products are specified for ""%1"".';
												|tr = '""%1"" için birden fazla ithal ürün belirtildi.'");
		TemplateNotSpecifiedImportedMaterial = NStr("vi = 'Đối với ""%1"" chưa chỉ ra nguyên liệu nhập khẩu hoặc công việc.';
													|ru = 'Для ""%1"" не указан импортный материал или работа.';
													|en = 'No imported material or work is specified for ""%1"".'; fa = 'No imported material or work is specified for ""%1"".';
													|it = 'No imported material or work is specified for ""%1"".';
													|pl = 'No imported material or work is specified for ""%1"".';
													|tr = '""%1"" için ithal malzeme ya da iş belirtilmedi.'");
		
		While Selection.Next() Do
			
			ObjectPresentation = String(Selection.Ref);
			If TypeOf(Object) = Type("DocumentObject.ProductionStage2_2") Then
				ObjectPresentation = String(Object);
			EndIf;
			
			If Selection.TypeOfVerification = "SeveralImportedProducts" Then
				
				MessageText =
					StrTemplate(TemplateMultipleImportedProducts, ObjectPresentation);
				
				Common.MessageToUser(
					MessageText,
					DataKey,
					Selection.TableName,
					DataPath,
					Cancel);
				
			EndIf;
			
			If Selection.TypeOfVerification = "ImportedMaterialNotSpecified" Then
				
				MessageText =
					StrTemplate(TemplateNotSpecifiedImportedMaterial, ObjectPresentation);
				
				Common.MessageToUser(
					MessageText,
					DataKey,
					Selection.TableName,
					DataPath,
					Cancel);
				
			EndIf;
			
			ProductionStage2_2Localization.ReportErrorsFillingCostGroups(Selection, DataKey, DataPath, ObjectPresentation, Cancel);
			
		EndDo;
		
	EndIf;
	
EndProcedure

Function RequestTextNumberOfVHFLinesToCheckForFilling(TempTablesManager)
	
	QueryTextRowsCount =
	"SELECT
	|	DataTable.Ref                                           AS Ref,
	|	SUM(DataTable.NumberOfLinesFinishedProducts)            AS ManufacturedProducts,
	|	SUM(DataTable.NumberOfRowsOutputProductsProduced) AS ManufacturedProductsManufactured,
	|	SUM(DataTable.NumberOfRowsByProducts)            AS SideAndIntermediateRelease,
	|	SUM(DataTable.NumberOfRowsOfByProductsProduced) AS SideAndIntermediateReleaseManufactured,
	|	SUM(DataTable.NumberOfRowsProvision)                AS Supply,
	|	MAX(DataTable.DateOfShipmentIsMandatory)     AS DateOfShipmentRequired_,
	|	SUM(DataTable.RowsCountExpense)                     AS Expense,
	|	SUM(DataTable.NumberOfLinesLaborCosts)               AS LaborCosts
	|INTO TTNumberOfRowsWH
	|FROM
	|	&Data AS DataTable
	|
	|GROUP BY
	|	DataTable.Ref
	|	
	|;
	|////////////////////////////////////////////////////////////////
	|";
	
	QueryTexts = New Array;
	
	QueryText =
	"SELECT
	|	StageDetails_.Ref             AS Ref,
	|	0                                  AS NumberOfLinesFinishedProducts,
	|	0                                  AS NumberOfRowsOutputProductsProduced,
	|	0                                  AS NumberOfRowsByProducts,
	|	0                                  AS NumberOfRowsOfByProductsProduced,
	|	0                                  AS NumberOfRowsProvision,
	|	FALSE                               AS DateOfShipmentIsMandatory,
	|	0                                  AS RowsCountExpense,
	|	0                                  AS NumberOfLinesLaborCosts
	|FROM
	|	StageDetails_ AS StageDetails_";
	QueryTexts.Add(QueryText);
	
	If TempTablesManager.Tables.Find("ManufacturedProducts") <> Undefined Then
		QueryText =
		"SELECT
		|	ManufacturedProducts.Ref             AS Ref,
		|	1                                  AS NumberOfLinesFinishedProducts,
		|	ManufacturedProducts.ProducedAttribute AS NumberOfRowsOutputProductsProduced,
		|	0                                  AS NumberOfRowsByProducts,
		|	0                                  AS NumberOfRowsOfByProductsProduced,
		|	0                                  AS NumberOfRowsProvision,
		|	FALSE                               AS DateOfShipmentIsMandatory,
		|	0                                  AS RowsCountExpense,
		|	0                                  AS NumberOfLinesLaborCosts
		|FROM
		|	ManufacturedProducts AS ManufacturedProducts";
		QueryTexts.Add(QueryText);
	EndIf;
	
	If TempTablesManager.Tables.Find("SideAndIntermediateRelease") <> Undefined Then
		QueryText =
		"SELECT
		|	SideAndIntermediateRelease.Ref             AS Ref,
		|	0                                  AS NumberOfLinesFinishedProducts,
		|	0                                  AS NumberOfRowsOutputProductsProduced,
		|	1                                  AS NumberOfRowsByProducts,
		|	SideAndIntermediateRelease.ProducedAttribute AS NumberOfRowsOfByProductsProduced,
		|	0                                  AS NumberOfRowsProvision,
		|	FALSE                               AS DateOfShipmentIsMandatory,
		|	0                                  AS RowsCountExpense,
		|	0                                  AS NumberOfLinesLaborCosts
		|FROM
		|	SideAndIntermediateRelease AS SideAndIntermediateRelease";
		QueryTexts.Add(QueryText);
	EndIf;
	
	If TempTablesManager.Tables.Find("SupplyWithMaterialsAndWorks") <> Undefined Then
		QueryText =
		"SELECT
		|	Supply.Ref                 AS Ref,
		|	0                                  AS NumberOfLinesFinishedProducts,
		|	0                                  AS NumberOfRowsOutputProductsProduced,
		|	0                                  AS NumberOfRowsByProducts,
		|	0                                  AS NumberOfRowsOfByProductsProduced,
		|	1                                  AS NumberOfRowsProvision,
		|	Supply.SupplyOption =
		|		VALUE(Enum.SupplyOptions.Ship) AS DateOfShipmentIsMandatory,
		|	0                                  AS RowsCountExpense,
		|	0                                  AS NumberOfLinesLaborCosts
		|FROM
		|	SupplyWithMaterialsAndWorks AS Supply";
		QueryTexts.Add(QueryText);
	EndIf;
	
	If TempTablesManager.Tables.Find("MaterialsAndWorksConsumption") <> Undefined Then
		QueryText =
		"SELECT
		|	Expense.Ref                      AS Ref,
		|	0                                  AS NumberOfLinesFinishedProducts,
		|	0                                  AS NumberOfRowsOutputProductsProduced,
		|	0                                  AS NumberOfRowsByProducts,
		|	0                                  AS NumberOfRowsOfByProductsProduced,
		|	0                                  AS NumberOfRowsProvision,
		|	FALSE                               AS DateOfShipmentIsMandatory,
		|	1                                  AS RowsCountExpense,
		|	0                                  AS NumberOfLinesLaborCosts
		|FROM
		|	MaterialsAndWorksConsumption AS Expense";
		QueryTexts.Add(QueryText);
	EndIf;
	
	If TempTablesManager.Tables.Find("LaborCosts") <> Undefined Then
		QueryText =
		"SELECT
		|	LaborCosts.Ref                AS Ref,
		|	0                                  AS NumberOfLinesFinishedProducts,
		|	0                                  AS NumberOfRowsOutputProductsProduced,
		|	0                                  AS NumberOfRowsByProducts,
		|	0                                  AS NumberOfRowsOfByProductsProduced,
		|	0                                  AS NumberOfRowsProvision,
		|	FALSE                               AS DateOfShipmentIsMandatory,
		|	0                                  AS RowsCountExpense,
		|	1                                  AS NumberOfLinesLaborCosts
		|FROM
		|	LaborCosts AS LaborCosts";
		QueryTexts.Add(QueryText);
	EndIf;
	
	QueryTextRowsCount =
		StrReplace(
			QueryTextRowsCount,
			"&Data",
			StrTemplate("(%1)", StrConcat(QueryTexts, TMCommonUse.QuerySeparatorInJoin())));
	
	Return QueryTextRowsCount;
	
EndFunction

Procedure DisableTSFillCheck(TSName, CheckedAttributes, NotCheckedAttributeArray)
	
	For Each AttributePath1 In CheckedAttributes Do
		If Find(AttributePath1, TSName) > 0
			And NotCheckedAttributeArray.Find(AttributePath1) = Undefined Then
			NotCheckedAttributeArray.Add(AttributePath1);
		EndIf;
	EndDo;
	
EndProcedure

Procedure CheckUseOfBatchAccounting22(Object, Cancel) Export
	
	DocumentDate = Date('00010101');
	
	For Each String In Object.ManufacturedProducts Do
		If ValueIsFilled(String.ProductionDate) And ValueIsFilled(DocumentDate)
			And Not String.Canceled Then
			DocumentDate = Min(DocumentDate,String.ProductionDate);
		EndIf;
	EndDo;
	
	For Each String In Object.SideAndIntermediateRelease Do
		If ValueIsFilled(String.ProductionDate) And ValueIsFilled(DocumentDate)
			And Not String.Canceled Then
			DocumentDate = Min(DocumentDate,String.ProductionDate);
		EndIf;
	EndDo;
	
	For Each String In Object.SupplyWithMaterialsAndWorks Do
		If ValueIsFilled(String.DateOfShipment) And ValueIsFilled(DocumentDate)
			And Not String.Canceled Then
			DocumentDate = Min(DocumentDate,String.DateOfShipment);
		EndIf;
	EndDo;
	
	For Each String In Object.MaterialsAndWorksConsumption Do
		If ValueIsFilled(String.DateOfMaterialWorkConsumption) And ValueIsFilled(DocumentDate) Then
			DocumentDate = Min(DocumentDate,String.DateOfMaterialWorkConsumption);
		EndIf;
	EndDo;
	
	For Each String In Object.UnusedMaterials Do
		If ValueIsFilled(String.DateOfTransaction) And ValueIsFilled(DocumentDate) Then
			DocumentDate = Min(DocumentDate,String.DateOfTransaction);
		EndIf;
	EndDo;
	
	CostsServer.CheckUseOfBatchAccounting22(Object, DocumentDate, Cancel);
	
EndProcedure

