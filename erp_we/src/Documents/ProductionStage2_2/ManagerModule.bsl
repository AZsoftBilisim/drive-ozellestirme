Function TabularPartsForProcessingProcessorSReport() Export
	
	Result = New Structure("ManufacturedProducts,SideAndIntermediateRelease,SupplyWithMaterialsAndWorks");
	
	Result.ManufacturedProducts =
		"SELECT
		|	OutputStageProducts.LineNumber                             AS LineNumber,
		|	OutputStageProducts.Ref                                  AS Ref,
		|	OutputStageProducts.RowCode                               AS RowCode,
		|	OutputStageProducts.Ref.NextStageNo = 0         AS ThisIsAProductionIssueStage,
		|	OutputStageProducts.Products                            AS Products,
		|	OutputStageProducts.Characteristic                          AS Characteristic,
		|	OutputStageProducts.Purpose                              AS Purpose,
		|	OutputStageProducts.Recipient                              AS Recipient,
		|	OutputStageProducts.ToExpenseAs                        AS ToExpenseAs,
		|	OutputStageProducts.ExpenseItem                          AS ExpenseItem,
		|	OutputStageProducts.DimensionOfExpenses                       AS DimensionOfExpenses,
		|	OutputStageProducts.AssetsLiabilitiesDimension                AS AssetsLiabilitiesDimension,
		|	OutputStageProducts.GLAccountSettings                    AS GLAccountSettings,
		|	OutputStageProducts.Package                                AS Package,
		|	OutputStageProducts.CostShare                           AS CostShare,
		|	OutputStageProducts.CostSharePerUnit                  AS CostSharePerUnit,
		|	OutputStageProducts.Count                              AS Count,
		|	OutputStageProducts.NumberOfPackages                      AS NumberOfPackages
		|FROM
		|	Document.ProductionStage2_2.ManufacturedProducts AS OutputStageProducts
		|WHERE
		|	OutputStageProducts.Ref IN(&Stages)
		|	AND NOT OutputStageProducts.Canceled
		|";
	
	TextSourceTable = "Document.ProductionStage2_2.ManufacturedProducts AS OutputStageProducts";
	TextIsCompoundPieceOfGoodsInMeasuringUnit = TextSourceTable + "
												|	//&CompoundUnitGoodsInUnitOfMeasure";
	Result.ManufacturedProducts =
		StrReplace(Result.ManufacturedProducts, TextSourceTable, TextIsCompoundPieceOfGoodsInMeasuringUnit);
	
	ApplyingParameters = ProductionServer.ParametersOfApplicationOfPieceProductInDimensionalUnit();
	ApplyingParameters.UnitGoodsInUnitsOfMeasure = False;
	ProductionServer.ApplyUnitItemSettingsInUnitOfMeasure(Result.ManufacturedProducts, "OutputStageProducts", ApplyingParameters);	
	
	Result.SideAndIntermediateRelease =
		"SELECT
		|	StageByProducts.LineNumber                             AS LineNumber,
		|	StageByProducts.Ref                                  AS Ref,
		|	StageByProducts.RowCode                               AS RowCode,
		|	StageByProducts.Ref.NextStageNo = 0         AS ThisIsAProductionIssueStage,
		|	StageByProducts.Products                            AS Products,
		|	StageByProducts.Characteristic                          AS Characteristic,
		|	StageByProducts.Purpose                              AS Purpose,
		|	StageByProducts.Recipient                              AS Recipient,
		|	StageByProducts.ToExpenseAs                        AS ToExpenseAs,
		|	StageByProducts.ExpenseItem                          AS ExpenseItem,
		|	StageByProducts.DimensionOfExpenses                       AS DimensionOfExpenses,
		|	StageByProducts.AssetsLiabilitiesDimension                AS AssetsLiabilitiesDimension,
		|	StageByProducts.GLAccountSettings                    AS GLAccountSettings,
		|	StageByProducts.Package                                AS Package,
		|	StageByProducts.ProductCostElement                       AS ProductCostElement,
		|	StageByProducts.Price                                    AS Price,
		|	StageByProducts.Count                              AS Count,
		|	StageByProducts.NumberOfPackages                      AS NumberOfPackages
		|FROM
		|	Document.ProductionStage2_2.SideAndIntermediateRelease AS StageByProducts
		|WHERE
		|	StageByProducts.Ref IN(&Stages)
		|	AND NOT StageByProducts.Canceled
		|";
		
	TextSourceTable = "Document.ProductionStage2_2.SideAndIntermediateRelease AS StageByProducts";
	TextIsCompoundPieceOfGoodsInMeasuringUnit = TextSourceTable + "
												|	//&CompoundUnitGoodsInUnitOfMeasure";
	Result.SideAndIntermediateRelease =
		StrReplace(Result.SideAndIntermediateRelease, TextSourceTable, TextIsCompoundPieceOfGoodsInMeasuringUnit);
	
	ApplyingParameters = ProductionServer.ParametersOfApplicationOfPieceProductInDimensionalUnit();
	ApplyingParameters.UnitGoodsInUnitsOfMeasure = False;
	ProductionServer.ApplyUnitItemSettingsInUnitOfMeasure(Result.SideAndIntermediateRelease, "StageByProducts", ApplyingParameters);	
	
	Result.SupplyWithMaterialsAndWorks =
		"SELECT
		|	Supply.LineNumber                AS LineNumber,
		|	Supply.Ref                     AS Ref,
		|	Supply.Products               AS Products,
		|	Supply.Characteristic             AS Characteristic,
		|	
		|	CASE WHEN Supply.WithAssignment THEN
		|				Supply.Purpose
		|			ELSE VALUE(Catalog.Assignments.EmptyRef)
		|		END                              AS Purpose,
		|	
		|	Supply.Package                   AS Package,
		|	Supply.ProductCostElement          AS ProductCostElement,
		|	Supply.Count                 AS Count,
		|	Supply.NumberOfPackages         AS NumberOfPackages
		|FROM
		|	Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS Supply
		|WHERE
		|	Supply.Ref IN(&Stages)
		|	AND NOT Supply.Canceled
		|";
		
	TextSourceTable = "Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS Supply";
	TextIsCompoundPieceOfGoodsInMeasuringUnit = TextSourceTable + "
												|	//&CompoundUnitGoodsInUnitOfMeasure";
	Result.SupplyWithMaterialsAndWorks =
		StrReplace(
			Result.SupplyWithMaterialsAndWorks,
			TextSourceTable,
			TextIsCompoundPieceOfGoodsInMeasuringUnit);
		
	ApplyingParameters = ProductionServer.ParametersOfApplicationOfPieceProductInDimensionalUnit();
	ApplyingParameters.UnitGoodsInUnitsOfMeasure = False;
	ProductionServer.ApplyUnitItemSettingsInUnitOfMeasure(Result.SupplyWithMaterialsAndWorks, "Supply", ApplyingParameters);	
	
	Return Result;
	
EndFunction

