#Region QueryTextsTemporaryTablesByHeaderAndTableParts

Function QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject)
	
	TableName = "DocumentDataHeader";
	
	QueryText = 
	"SELECT
	|	TabularSection.Ref                                           AS Ref,
	|	TabularSection.Date                                             AS Date,
	|	TabularSection.Number                                            AS Number,
	|	TabularSection.NumberForPrinting                                    AS NumberForPrinting,
	|	TabularSection.DynamicStructure                            AS DynamicStructure,
	|	TabularSection.OperationAsOutputReference                 AS OperationAsOutputReference,
	|	TabularSection.StagePlacementInProductionSchedule                         AS StagePlacementInProductionSchedule,
	|	TabularSection.Status                                           AS Status,
	|	TabularSection.ProductionProcessType                     AS ProductionProcessType,
	|	TabularSection.ActualStageStart                           AS ActualStageStart,
	|	TabularSection.ActualStageEnd                        AS ActualStageEnd,
	|	TabularSection.Organization                                      AS Organization,
	|	TabularSection.Department                                    AS Department,
	|	TabularSection.ReferenceOrder                                     AS ReferenceOrder,
	|	TabularSection.ReferenceOrder.UUIDLine       AS OrderUniqueIdentifierString,
	|	CAST(TabularSection.ReferenceOrder AS Document.ProductionOrder2_2).DisabledAssignmentByProductionStageForIntermediateProducts
	|                                                                   AS OrderAssignmentOfSemiFinishedProductsForPurposeOfStagesIsNotUsed,
	|	CASE 
	|		WHEN TabularSection.ProductionByThirdParty
	|			AND VALUETYPE(TabularSection.SubcontractOrder) = TYPE(Document.SubcontractOrder2_5)
	|			AND CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Posted
	|				THEN CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Priority
	|		ELSE TabularSection.ReferenceOrder.Priority
	|	END                                                           AS OrderPriorityOverride,
	|	TabularSection.ProductionLot                               AS ProductionLot,
	|	TabularSection.ProductionLot.MainProductProducts   AS ProductionLotReferenceMainFinishedProductItem,
	|	TabularSection.ProductionLot.MainProductCharacteristic AS ProductionLotReferenceMainFinishedProductCharacteristics,
	|	TabularSection.ProductionLot.ProductsGroup               AS ProductionLotReferenceGroupOfManufacturedProducts,
	|	TabularSection.ProductionLot.VATActivityType            AS ProductionLotReferenceVATTaxationTypeOfActivity,
	|	TabularSection.Partner                                          AS Partner,
	|	CASE 
	|		WHEN TabularSection.ProductionByThirdParty
	|			AND VALUETYPE(TabularSection.SubcontractOrder) = TYPE(Document.SubcontractOrder2_5)
	|			AND CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Posted
	|				THEN CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Contract
	|		WHEN NOT TabularSection.ProductionByThirdParty
	|			THEN TabularSection.Contract
	|		ELSE VALUE(Catalog.CounterpartyContracts.EmptyRef)
	|	END                                                           AS ContractRedefinition,
	|	TabularSection.Currency                                           AS Currency,
	|	TabularSection.BillOfMaterials                                     AS BillOfMaterials,
	|	TabularSection.Purpose                                       AS Purpose,
	|	TabularSection.IsProductAssignment                     AS IsProductAssignment,
	|	TabularSection.LineOfBusiness                          AS LineOfBusiness,
	|	CASE
	|		WHEN ISNULL(TabularSection.AssignmentProducts.VATActivityType,
	|						VALUE(Enum.VATTaxationTypes.EmptyRef))
	|							<> VALUE(Enum.VATTaxationTypes.EmptyRef)
	|			THEN TabularSection.AssignmentProducts.VATActivityType
	|		ELSE TabularSection.ProductionIssueForActivity
	|	END                                                           AS ReleaseUnderActivityRedefinition,
	|	TabularSection.DateOfShipment                                     AS DateOfShipment,
	|	TabularSection.NotShipInInstallments                               AS NotShipInInstallments,
	|	TabularSection.GoodsReceiptOption                            AS GoodsReceiptOption,
	|	CASE
	|		WHEN VALUETYPE(TabularSection.SubcontractOrder) = TYPE(Document.SubcontractOrder2_5)
	|			AND CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Posted
	|			THEN TabularSection.SubcontractOrder
	|		ELSE TabularSection.Ref
	|	END                                                           AS OrderOverride,
	|	TabularSection.ProductionByThirdParty                            AS ProductionByThirdParty,
	|	TabularSection.ProductionByThirdParty2_5                         AS ProductionByThirdParty2_5,
	|	TabularSection.InternalSubcontracting                            AS InternalSubcontracting,
	|	TabularSection.MaterialProviderCompany                               AS MaterialProviderCompany,
	|	TabularSection.LeaveProductsAtSubcontractor                    AS LeaveProductsAtSubcontractor,
	|	TabularSection.SubcontractOrder                               AS SubcontractOrder,
	|	CASE
	|		WHEN TabularSection.ProductionByThirdParty
	|			AND VALUETYPE(TabularSection.SubcontractOrder) = TYPE(Document.SubcontractOrder2_5)
	|			AND CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Posted
	|			AND CAST(TabularSection.SubcontractOrder AS Document.SubcontractOrder2_5).Status IN (
	|											VALUE(Enum.TollingOrderStatuses.ToSupply),
	|											VALUE(Enum.TollingOrderStatuses.ForFulfillment),
	|											VALUE(Enum.TollingOrderStatuses.Closed))
	|				THEN TabularSection.SubcontractOrder 
	|		ELSE UNDEFINED
	|	END                                                           AS SubcontractPurchaseOrderRedefinition,
	|	TabularSection.DocumentRegistryOperation                        AS DocumentRegistryOperation,
	|	TabularSection.DocumentRegistryDate                            AS DocumentRegistryDate,
	|	TabularSection.EmployeeResponsible                                    AS EmployeeResponsible,
	|	TabularSection.Comment                                      AS Comment,
	|	TabularSection.UUID                          AS UUID,
	|	TabularSection.Posted                                         AS Posted,
	|	TabularSection.DeletionMark                                  AS DeletionMark,
	|	ISNULL(LocationOfLaunchedLotAndStagesInOrderStructure.ProductItemsGroup, """")         AS ProductItemsGroup,
	|	ISNULL(LocationOfLaunchedLotAndStagesInOrderStructure.ProductionLotIDInProductGroup, """") AS ProductionLotIDInProductGroup,
	|	ISNULL(LocationOfLaunchedLotAndStagesInOrderStructure.Level, 0)                  AS Level,
	|	ISNULL(LocationOfLaunchedLotAndStagesInOrderStructure.DurationBeforeProductionIssue, 0)
	|		+ TabularSection.DurationBeforeProductionIssue                      AS DurationBeforeProductionIssue,
	|	CASE
	|		WHEN TabularSection.StageDuration = 0 THEN
	|			0.0001
	|		ELSE
	|			TabularSection.StageDuration
	|			* CASE
	|				WHEN TabularSection.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.MINUTE)
	|					THEN 60
	|				WHEN TabularSection.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.HOUR)
	|					THEN 3600
	|				WHEN TabularSection.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.DAY)
	|					THEN 86400
	|				WHEN TabularSection.UnitOfMeasureOfStageDuration = VALUE(Enum.TimeMeasureUnits.Days1)
	|					THEN 86400
	|				ELSE 1
	|			END
	|	END                                                          AS StageDurationInSeconds,
	|	&RedefinedFields
	|INTO DocumentDataHeader
	|FROM
	|	Document.ProductionStage2_2 AS TabularSection
	|		LEFT JOIN InformationRegister.LocationOfLaunchedLotAndStagesInOrderStructure AS LocationOfLaunchedLotAndStagesInOrderStructure
	|		ON LocationOfLaunchedLotAndStagesInOrderStructure.Lot = TabularSection.ProductionLot
	|WHERE
	|	TabularSection.Ref IN (&Ref)
	|
	|INDEX BY
	|	Ref";
	
	RedefinedFields = "";
	
	RedefinedFields = New Array;
	
	RedefiningParameterCalculation = RedefiningParameterCalculation("TabularSection");
	For Each KeyAndValue In RedefiningParameterCalculation Do
		RedefinedFields.Add(StrTemplate("%1 AS %2", KeyAndValue.Value, KeyAndValue.Key));
	EndDo;
	
	Separator = ",
				  |";
	
	QueryText = StrReplace(QueryText, "&RedefinedFields", StrConcat(RedefinedFields, Separator));
	
	QueryTexts.Add(QueryText, TableName);
	
	Return QueryText;
	
EndFunction

