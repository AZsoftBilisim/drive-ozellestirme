//
// Returns:
//   - Array - the list of required details in the status "Being formed".
//
Function ListOfRequiredBankingDetailsInStatusIsGenerated(Object) Export
	
	Result = New Array;
	
	If Not Object.PlanOperationsOfWorkCenterTypes And Not Object.StagePlacementInProductionSchedule Then
		
		Result.Add("UnitOfMeasureOfStageDuration");
		
	EndIf;
	
	If Object.PlanOperationsOfWorkCenterTypes And Not Object.StagePlacementInProductionSchedule  Then
		
		Result.Add("UnitOfMeasureOfPreliminaryBuffer");
		Result.Add("UnitOfMeasureOfFollowUpBuffer");
		
	EndIf;
	
	Return Result;

EndFunction

// Fills in the "Price" Attribute in the tabular parts of the by-products and output products of the production stage.
//
// Parameters:
//  Object - DocumentObject - the document being processed.
//  TSName - String - The name of the tabular part where you need to fill in the prices.
//      This parameter is optional. If you do not specify it, the prices will be overfilled in the side products TS,
//      and the output products that are empty in the TS will be filled in.
//
Procedure FillInPricesByPriceKind(Object, TSName = "") Export
	
	If Object.PriceKind.IsEmpty() Then
		Return;
	EndIf;
	
	LinesToTSProcessingByProducts = New Array;
	LinesForProcessingTSOutputProducts = New Array;
	
	UseTargetCost = False;
	If TSName = "ManufacturedProducts" Or TSName = "" Then
		AccountingPolicyParameters = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate(
			"FinancialAccountingPolicy",
			Object.Organization,
			Object.Date);
	
		If Not AccountingPolicyParameters = Undefined Then
			UseTargetCost = AccountingPolicyParameters.ProductCostingByPlannedCost;
		EndIf;
	EndIf;
	
	If TSName = "SideAndIntermediateRelease" Or TSName = "" Then
		For Each String In Object.SideAndIntermediateRelease Do
			If String.Manufactured And Not String.Canceled Then
				LinesToTSProcessingByProducts.Add(String);
			EndIf;
			String.Price  = 0;
			String.Sum = 0;
		EndDo;
	EndIf;
	
	If UseTargetCost Then
		For Each String In Object.ManufacturedProducts Do
			If String.Manufactured And Not String.Canceled And String.Price  = 0 Then
				// Since the user can fill in the planned price of the output product manually or from the planned calculation,
				// we fill in the planned prices only if they are empty.
				LinesForProcessingTSOutputProducts.Add(String);
			EndIf;
		EndDo;
	EndIf;
	
	If LinesToTSProcessingByProducts.Count() > 0 Or LinesForProcessingTSOutputProducts.Count() > 0 Then
		FillParameters = ProductionManagementClientServer.ParametersForFillingIssuePrices(
			Object.PriceKind,
			Object.Currency,
			Object.ActualStageStart);
			
		FillParameters.Insert("Organization", Object.Organization);
	EndIf;
	
	If LinesToTSProcessingByProducts.Count() > 0 Then
		EnterprisePricesFillingServer.FillInPrices(
			Object.SideAndIntermediateRelease, // Table part
			LinesToTSProcessingByProducts, // Array of rows or selection structure
			FillParameters, // The fill parameters
			New Structure( // The structure of the action with the changed strings
				"RecalculateAmount",
				"NumberOfPackages"));
				
	EndIf;
	
	If LinesForProcessingTSOutputProducts.Count() > 0 Then
		EnterprisePricesFillingServer.FillInPrices(
			Object.ManufacturedProducts, // Table part
			LinesForProcessingTSOutputProducts, // Array of rows or selection structure
			FillParameters, // The fill parameters
			New Structure( // The structure of the action with the changed strings
				"RecalculateAmount",
				"NumberOfPackages"));
				
	EndIf;
	
EndProcedure

// This function checks whether you need to specify stages for orders
//
// Parameters:
//  Orders - DocumentRef.ProductionOrder2_2, Array - Production order.
//
// Returns:
//  Boolean - True - it is necessary to clarify the stages.
//
Function NeedToClarifySteps(Orders) Export
	
	ReferencesArrray = ProductionManagementClientServer.ArrayOfValues(Orders);
	
	Query = New Query(
		"SELECT TOP 1
		|	TRUE
		|FROM
		|	Document.ProductionStage2_2 AS Table
		|WHERE
		|	Table.ReferenceOrder IN (&ReferencesArrray)
		|	AND Table.Status = &StatusIsGenerated
		|	AND Table.Posted");
		
	Query.SetParameter("ReferencesArrray",      ReferencesArrray);
	Query.SetParameter("StatusIsGenerated", Enums.StatusesOfProductionStages2_2.BeingGenerated);
	
	SetPrivilegedMode(True);
	
	Return Not Query.Execute().IsEmpty();
	
EndFunction

// The function returns the text of the request for review of the grounds when entering
// acts to perform domestic work.
//
// Returns:
//   - String - the text of the request to check the grounds.
//
Function TextOfRequestForVerificationOfGroundsForActsOfWork() Export
	
	Return "
	// Recipients of output products (production stages)
	|SELECT
	|	CASE
	|		WHEN Attributes.InternalSubcontracting
	|			THEN Attributes.MaterialProviderCompany
	|		ELSE Attributes.Organization
	|	END								AS Organization,
	|	Attributes.LineOfBusiness	AS LineOfBusiness,
	|	Attributes.ProductionIssueForActivity		AS TransferForActivity,
	|	TableOfGoods.Recipient			AS Department
	|FROM
	|	Document.ProductionStage2_2.ManufacturedProducts AS TableOfGoods
	|		LEFT JOIN Document.ProductionStage2_2 AS Attributes
	|		ON TableOfGoods.Ref = Attributes.Ref
	|		LEFT JOIN Catalog.Products AS CatProducts
	|		ON TableOfGoods.Products = CatProducts.Ref
	|WHERE
	|	TableOfGoods.Ref IN(&ObjectsOfBases)
	|	AND TableOfGoods.Manufactured
	|	AND NOT TableOfGoods.Canceled
	|	AND CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|	AND VALUETYPE(TableOfGoods.Recipient) = TYPE(Catalog.BusinessStructure)
	|	AND NOT TableOfGoods.ToExpenseAs
	|
	|GROUP BY
	|	Attributes.LineOfBusiness,
	|	Attributes.ProductionIssueForActivity,
	|	TableOfGoods.Recipient,
	|	CASE
	|		WHEN Attributes.InternalSubcontracting
	|			THEN Attributes.MaterialProviderCompany
	|		ELSE Attributes.Organization
	|	END
	|
	|UNION ALL
	|
	// Recipients of by-products (production stages)
	|SELECT
	|	CASE
	|		WHEN NOT TableOfGoods.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
	|			THEN TableOfGoods.ProductOwner
	|		WHEN Attributes.InternalSubcontracting
	|			THEN Attributes.MaterialProviderCompany
	|		ELSE Attributes.Organization
	|	END								AS Organization,
	|	Attributes.LineOfBusiness	AS LineOfBusiness,
	|	Attributes.ProductionIssueForActivity		AS TransferForActivity,
	|	TableOfGoods.Recipient			AS Department
	|FROM
	|	Document.ProductionStage2_2.SideAndIntermediateRelease AS TableOfGoods
	|		LEFT JOIN Document.ProductionStage2_2 AS Attributes
	|		ON TableOfGoods.Ref = Attributes.Ref
	|		LEFT JOIN Catalog.Products AS CatProducts
	|		ON TableOfGoods.Products = CatProducts.Ref
	|WHERE
	|	TableOfGoods.Ref IN(&ObjectsOfBases)
	|	AND TableOfGoods.Manufactured
	|	AND NOT TableOfGoods.Canceled
	|	AND CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|	AND VALUETYPE(TableOfGoods.Recipient) = TYPE(Catalog.BusinessStructure)
	|	AND NOT TableOfGoods.ToExpenseAs
	|
	|GROUP BY
	|	Attributes.LineOfBusiness,
	|	Attributes.ProductionIssueForActivity,
	|	TableOfGoods.Recipient,
	|	CASE
	|		WHEN NOT TableOfGoods.ProductOwner = VALUE(Catalog.Companies.EmptyRef)
	|			THEN TableOfGoods.ProductOwner
	|		WHEN Attributes.InternalSubcontracting
	|			THEN Attributes.MaterialProviderCompany
	|		ELSE Attributes.Organization
	|	END
	|"
EndFunction

// Substitutes the selected fields from the output items in the query text
//
// Parameters:
//  QueryText	 - String - the query text in which to substitute the connection
//	SourceFields_ - Structure - contains the paths to the fields in the source text of the request in the form [Leading table].Field Name:
//		* Products - String - Path to the item field
//		* Characteristic - String - the path to the Characteristic field
//		* Purpose - String - path to the Destination field
//		* RowCode - String - path to the string code field
//		* CostShare - String - the path to the cost-sharing field
//		* Count - String - the path to the Quantity field.
//
// Returns:
//  String - new request text
//
Function SubstituteSelectedFields(QueryText, SourceFields_) Export
	
	OutputProductFields = New Map;
	OutputProductFields.Insert("Products", "Products");
	OutputProductFields.Insert("Characteristic", "Characteristic");
	OutputProductFields.Insert("Purpose", "Purpose");
	OutputProductFields.Insert("CostShare", "CostShare");
	OutputProductFields.Insert("Count", "Count");
	OutputProductFields.Insert("RowCode", "RowCode");
	
	For Each KeyAndValue In SourceFields_ Do
		
		WareField = OutputProductFields.Get(KeyAndValue.Key);
		If WareField = Undefined Then
			Continue;
		EndIf;
		
		LeadingTable = Left(KeyAndValue.Value, StrFind(KeyAndValue.Value, ".", SearchDirection.FromBegin));
		QueryText = StrReplace(QueryText, KeyAndValue.Value, LeadingTable + WareField);
		
	EndDo;
	
	Return QueryText;
	
EndFunction

// Inserts the connection required to get output items in the request text.
//
// Parameters:
//  QueryText	 - String - the query text in which to substitute the connection
//  ParameterName	 - String - name of the parameter to replace the connection with
//  ConnectionFields_	 - Structure - contains the paths to the fields in the original request in the form [Leading table].Nomenclature. The structure contains possible fields. Not all fields can be passed:
//		* ReferenceOrder - String - the production order for which it is necessary to receive output products
//		* Stage - String - the stage of production from which it is required to obtain output products
//		* Products - String - The output product
//		* Characteristic - String - characteristics of the output product
//		* Purpose - String - The purpose of the output product.
//
// Returns:
//  String - new request text
//
Function SubstituteConnectionToGetOutputProducts(QueryText, ParameterName, ConnectionFields_) Export
	
	ConnectedStageFields = New Map;
	ConnectedStageFields.Insert("ReferenceOrder", "Ref.ReferenceOrder");
	ConnectedStageFields.Insert("Stage", "Ref");
	ConnectedStageFields.Insert("Products", "Products");
	ConnectedStageFields.Insert("Characteristic", "Characteristic");
	ConnectedStageFields.Insert("Purpose", "Purpose");
	
	SubstitutionResult = QueryText;
	While True Do
		
		ParameterStart = StrFind(SubstitutionResult, ParameterName, SearchDirection.FromBegin);
		
		If ParameterStart = 0 Then
			Break;
		EndIf;
		
		LastChar = ParameterStart + StrLen(ParameterName);
		BeginningOfSynonym = StrFind(SubstitutionResult, "AS", SearchDirection.FromEnd, ParameterStart) + StrLen("AS");
		Synonym = TrimAll(StrReplace(Mid(SubstitutionResult, BeginningOfSynonym, ParameterStart - BeginningOfSynonym - 1), "ON", ""));
		FirstSymbol = StrFind(SubstitutionResult, "JOIN", SearchDirection.FromEnd, BeginningOfSynonym) + StrLen("JOIN");
		
		SearchSubstring = Mid(SubstitutionResult, FirstSymbol, LastChar - FirstSymbol);
		ReplaceSubstring = " Document.ProductionStage2_2.ManufacturedProducts AS %Synonym%";
		
		RelationshipOfConditions = " ON ";
		
		For Each KeyAndValue In ConnectionFields_ Do
			
			ConnectingField = ConnectedStageFields.Get(KeyAndValue.Key);
			If ConnectingField = Undefined Then
				Continue;
			EndIf;
			
			ReplaceSubstring = ReplaceSubstring + RelationshipOfConditions + KeyAndValue.Value + " = " + "%Synonym%." + ConnectingField;
			RelationshipOfConditions = " And ";
			
		EndDo;
		
		ReplaceSubstring = ReplaceSubstring + " AND NOT %Synonym%.Canceled";
		
		ReplaceSubstring = StrReplace(ReplaceSubstring, "%Synonym%", Synonym);
		SubstitutionResult = StrReplace(SubstitutionResult, SearchSubstring, ReplaceSubstring);
		
	EndDo;
	
	Return SubstitutionResult;
	
EndFunction

// Returns the selection text of the stage Source field for substitution in the query
//
// Parameters:
//  WayForward - String	 - path to data in the Order field
//  PathStage		 - String	 - path to the Stage field data
//  PathAssignment	 - String	 - path to data in the Destination field
//
// Returns:
//  String - text to be inserted into the query
//
Function RequestTextSourceStageField(WayForward, PathStage, PathAssignment) Export
	
	QueryText =
	"CASE
	|	WHEN CAST(&ReferenceOrder AS Document.ProductionOrder2_2).DisabledAssignmentByProductionStageForIntermediateProducts
	|		THEN
	|			&Stage
	|	WHEN CAST(&ReferenceOrder AS Document.ProductionOrder2_2) = CAST(CAST(&Purpose AS Catalog.Assignments).OrderDocument AS Document.ProductionStage2_2).ReferenceOrder
	|		THEN
	|			CAST(CAST(&Purpose AS Catalog.Assignments).OrderDocument AS Document.ProductionStage2_2)
	|	ELSE
	|		VALUE(Document.ProductionStage2_2.EmptyRef)
	|END
	|";
	QueryText = StrReplace(QueryText, "&ReferenceOrder", WayForward);
	QueryText = StrReplace(QueryText, "&Stage",         PathStage);
	QueryText = StrReplace(QueryText, "&Purpose",   PathAssignment);
	Return QueryText;
	
EndFunction

