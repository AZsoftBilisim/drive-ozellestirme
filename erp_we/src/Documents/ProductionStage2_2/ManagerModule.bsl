#Region FillType

// Fills in an expense based on security data
//
// Parameters:
//  Object - FormDataStructure - Contains:
//            * Ref - DocumentRef.ProductionStage2_2 - 
//  Mode - Number - 0 => filling occurs only according to the provision data (the flow is pre-cleared),
//                  1 => data from the provision is added to the flow,
//                  2 => the flow rate is adjusted (synchronized) according to the provision data.
//
Procedure FillInConsumptionOfMaterialsAndWorksAccordingToProvisionData(Object, Mode = 0) Export
	
	TempTablesManager = New TempTablesManager;
	
	Query = New Query(
	"SELECT
	|	&Ref                                            AS Ref,
	|	SupplyWithMaterialsAndWorks.DateOfShipment       AS DateOfTransaction,
	|	SupplyWithMaterialsAndWorks.Department      AS Department,
	|	SupplyWithMaterialsAndWorks.LineNumber        AS LineNumber,
	|	SupplyWithMaterialsAndWorks.Products       AS Products,
	|	SupplyWithMaterialsAndWorks.Characteristic     AS Characteristic,
	|	SupplyWithMaterialsAndWorks.Warehouse              AS Warehouse,
	|	SupplyWithMaterialsAndWorks.Series              AS Series,
	|	SupplyWithMaterialsAndWorks.ProductCostElement  AS ProductCostElement,
	|	SupplyWithMaterialsAndWorks.Package           AS Package,
	|	SupplyWithMaterialsAndWorks.Count         AS Count,
	|	SupplyWithMaterialsAndWorks.NumberOfPackages AS NumberOfPackages
	|INTO Supply
	|FROM
	|	&SupplyWithMaterialsAndWorks AS SupplyWithMaterialsAndWorks
	|WHERE
	|	SupplyWithMaterialsAndWorks.Products <> VALUE(Catalog.Products.EmptyRef)
	|	AND SupplyWithMaterialsAndWorks.Count <> 0
	|	AND SupplyWithMaterialsAndWorks.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|	AND NOT SupplyWithMaterialsAndWorks.Canceled
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	&Ref                                    AS Ref,
	|	MaterialsAndWorksConsumption.Department       AS Department,
	|	MaterialsAndWorksConsumption.LineNumber         AS LineNumber,
	|	MaterialsAndWorksConsumption.RowID AS RowID,
	|	MaterialsAndWorksConsumption.Products        AS Products,
	|	MaterialsAndWorksConsumption.Characteristic      AS Characteristic,
	|	MaterialsAndWorksConsumption.Series               AS Series,
	|	MaterialsAndWorksConsumption.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	MaterialsAndWorksConsumption.ProductCostElement   AS ProductCostElement,
	|	MaterialsAndWorksConsumption.Package            AS Package,
	|	MaterialsAndWorksConsumption.DateOfMaterialWorkConsumption         AS DateOfMaterialWorkConsumption,
	|	MaterialsAndWorksConsumption.Count          AS Count,
	|	MaterialsAndWorksConsumption.NumberOfPackages  AS NumberOfPackages
	|INTO ConsumptionFilledSeries
	|FROM
	|	&MaterialsAndWorksConsumption AS MaterialsAndWorksConsumption
	|WHERE
	|	MaterialsAndWorksConsumption.Products <> VALUE(Catalog.Products.EmptyRef)
	|	AND MaterialsAndWorksConsumption.Count <> 0
	// We select only correctly filled series
	|	AND MaterialsAndWorksConsumption.BatchesIndicationStatus IN (0, 2, 14)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	&Ref                           AS Ref,
	|	UnusedMaterials.DateOfTransaction   AS DateOfTransaction,
	|	UnusedMaterials.Department  AS Department,
	|	UnusedMaterials.Products   AS Products,
	|	UnusedMaterials.Characteristic AS Characteristic,
	|	UnusedMaterials.Series          AS Series,
	|	UnusedMaterials.Count     AS Count
	|INTO Savings
	|FROM
	|	&UnusedMaterials AS UnusedMaterials
	|WHERE
	|	UnusedMaterials.Products <> VALUE(Catalog.Products.EmptyRef)
	|	AND UnusedMaterials.Count <> 0");
	
	Query.SetParameter("Ref"                          , Object.Ref);
	Query.SetParameter("Department"                   , Object.Department);
	Query.SetParameter("SupplyWithMaterialsAndWorks" , Object.SupplyWithMaterialsAndWorks.Unload());
	Query.SetParameter("MaterialsAndWorksConsumption"          , 
		Object.MaterialsAndWorksConsumption.Unload(?(Mode = 0, New Array, Undefined)));
	Query.SetParameter("UnusedMaterials"              , Object.UnusedMaterials.Unload());
	
	Query.TempTablesManager = TempTablesManager;
	Query.Execute();
	
	If Object.ConsumptionInOneDay Then
		DateOfTransaction = Object.DateOfMaterialWorkConsumption;
	ElsIf Object.ActualStageEnd <> '000101010000'
		And Object.Status = PredefinedValue("Enum.StatusesOfProductionStages2_2.Completed") Then
		DateOfTransaction = Object.ActualStageEnd;
	Else
		DateOfTransaction = BegOfDay(CurrentSessionDate());
	EndIf;
	SeriesSpecificationParameters = SeriesSpecificationParameters(Object).MaterialsAndWorksConsumption;
	
	Result = CalculateMaterialConsumption(TempTablesManager, DateOfTransaction, Mode = 2);
	
	Object.MaterialsAndWorksConsumption.Load(Result);
	
	ProductsServer.FillInStatusesForSpecifyingSeries(Object, SeriesSpecificationParameters);
	ProductsServer.ClearUnusedSeries(Object, SeriesSpecificationParameters);
	
EndProcedure

// Fills in unspent materials
//
// Parameters:
//  Object - FormDataStructure - Contains:
//            * Ref - DocumentRef.ProductionStage2_2 - 
//
Procedure FillInUnspentMaterials(Object) Export
	
	TempTablesManager = New TempTablesManager;
	
	Query = New Query(
	"SELECT
