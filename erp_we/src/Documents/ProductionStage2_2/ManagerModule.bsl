		If SelectingRows.Count > 1 Then
			
			MainProductPresentation =
				MainProductPresentation
				+ " "
				+ StrTemplate(NStr("vi = 'và còn %1 %2';
									|ru = 'и еще %1 %2';
									|en = 'also in %1 %2'; fa = 'also in %1 %2';
									|it = 'e ancora %1 %2';
									|pl = 'i jeszcze %1 %2';
									|tr = 've %2 %1 daha'"), 
					Format(SelectingRows.Count - 1, "NG="),
					TMCommonUseClientServer.InPlural(
