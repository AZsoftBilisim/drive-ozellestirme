	QueryText = RequestTextNumberOfVHFLinesToCheckForFilling(TempTablesManager) + 
	"SELECT
	|	NestedQuery.OrderToProcessorIsNotFormalized AS OrderToProcessorIsNotFormalized,
	|	NestedQuery.OrderSentToProcessor AS OrderSentToProcessor,
	|	NestedQuery.ProductionDateNotFilledIn AS ProductionDateNotFilledIn,
	|	NestedQuery.DateOfShipment AS DateOfShipment,
	|	NestedQuery.DateOfMaterialWorkConsumption AS DateOfMaterialWorkConsumption,
