// Adds work to the planning stage of work, as well as (optionally) repaired finished products to the Reverse kit and kit stages.
//
// Parameters:
//  Stage - DocumentRef.ProductionStage2_2 - the work planning stage.
//  Works - ValueTable - a table with works and repaired finished products.
//
Procedure AddWorksAndRepairedFinishedProducts(Stage, Works) Export
	
	StagesOfReverseKitting = New Map();
	KittingSteps = New Map();
	
	BeginTransaction();
	Try
		// Adding works
		DocumentObject = Stage.GetObject();
		DocumentObject.Lock();
		
		For Each String In Works Do
			NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Add();
			FillPropertyValues(NewRow, String,
				"Products, Characteristic, Package, NumberOfPackages, Count, BillOfMaterials,
				|ProductCostElement,SupplyOption,WithAssignment,Produced,Purpose,SupplyAssignment,
				|UnderRepairProduct, UnderRepairVariant,
				|UnderRepairBatch, UnderRepairBatchSpecificationStatus");
			NewRow.Department = DocumentObject.Department;
			
			If String.AddFINISHEDProductBeingRepairedToSteps
				And ValueIsFilled(String.UnderRepairProduct)  Then
				
				If ValueIsFilled(String.RepairedFinishedProductDisassemblyStage) Then
					Products_1 = StagesOfReverseKitting.Get(String.RepairedFinishedProductDisassemblyStage);
					If Products_1 = Undefined Then
						Products_1 = New Array;
						StagesOfReverseKitting.Insert(String.RepairedFinishedProductDisassemblyStage, Products_1);
					EndIf;
					Products_1.Add(String);
				EndIf;
				
				If ValueIsFilled(String.FinishedProductBeingRepairedIsKitsStage) Then
					Products_1 = KittingSteps.Get(String.FinishedProductBeingRepairedIsKitsStage);
					If Products_1 = Undefined Then
						Products_1 = New Array;
						KittingSteps.Insert(String.FinishedProductBeingRepairedIsKitsStage, Products_1);
					EndIf;
					Products_1.Add(String);
				EndIf;
				
			EndIf;
			
		EndDo;
		
		If Not DocumentObject.CheckFilling() Then
			Raise TextOfErrorCheckingFillingWhenRecordingStage(DocumentObject);
		EndIf;
		
		DocumentObject.Write(DocumentWriteMode.Posting);
		
		// Adding Finished products to a kit
		If KittingSteps.Count() > 0 Then
			
			For Each KeyAndValue In KittingSteps Do
				
				DocumentObject = KeyAndValue.Key.GetObject(); // DocumentObject.ProductionStage2_2
				DocumentObject.Lock();
				
				Products_1 = KeyAndValue.Value; // Array
				
				RowsWithSeries_ = New Map();
				
				For Each String In Products_1 Do
					NewRow = DocumentObject.SupplyWithMaterialsAndWorks.Add();
					NewRow.Products = String.UnderRepairProduct;
					NewRow.Characteristic = String.UnderRepairVariant;
					NewRow.NumberOfPackages = String.FinishedProductToBeRepairedNumberOfPackagingUnits;
					NewRow.Count = String.RepairedFinishedProductQuantity;
					NewRow.Package = String.FinishedProductToBeRepairedPackagingunit;
					NewRow.SupplyOption = Enums.SupplyOptions.ToSupply;
					NewRow.WithAssignment = True;
					NewRow.Purpose = String.SupplyAssignment;
					NewRow.SupplyAssignment = String.SupplyAssignment;
					NewRow.Warehouse = String.RepairedFinishedProductWarehouse;
					NewRow.ProductCostElement = String.FinishedProductBeingRepairedIsProductCostingElement;
					NewRow.Department = DocumentObject.Department;
					
					If ValueIsFilled(String.UnderRepairBatch) Then
						RowsWithSeries_.Insert(String, NewRow);
					EndIf;
				EndDo;
				
				SeriesSpecificationParameters = SeriesSpecificationParameters(DocumentObject);
				ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SupplyWithMaterialsAndWorks);
				
				If RowsWithSeries_.Count() > 0 Then
					For Each KeyAndValue In RowsWithSeries_ Do
						String = KeyAndValue.Key;
						NewRow = KeyAndValue.Value;
						
						If NewRow.BatchesIndicationStatus <> 0 Then
							NewRow.Series = String.UnderRepairBatch;
						EndIf;
					EndDo;
					
					ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SupplyWithMaterialsAndWorks);
				EndIf;
				
				If Not DocumentObject.CheckFilling() Then
					Raise TextOfErrorCheckingFillingWhenRecordingStage(DocumentObject);
				EndIf;
				
				DocumentObject.Write(DocumentWriteMode.Posting);
				
			EndDo;
				
		EndIf;
		
		// Adding finished products to the Reverse Kit
		If StagesOfReverseKitting.Count() > 0 Then
			
			For Each KeyAndValue In StagesOfReverseKitting Do
				
				DocumentObject = KeyAndValue.Key.GetObject(); // DocumentObject.ProductionStage2_2
				DocumentObject.Lock();
				
				Products_1 = KeyAndValue.Value; // Array
				
				RowsWithSeries_ = New Map();
				
				RowsToProcess = New Array;
				For Each String In Products_1 Do
					NewRow = DocumentObject.SideAndIntermediateRelease.Add();
					NewRow.Products = String.UnderRepairProduct;
					NewRow.Characteristic = String.UnderRepairVariant;
					NewRow.NumberOfPackages = String.FinishedProductToBeRepairedNumberOfPackagingUnits;
					NewRow.Count = String.RepairedFinishedProductQuantity;
					NewRow.Package = String.FinishedProductToBeRepairedPackagingunit;
					NewRow.Recipient = String.RepairedFinishedProductWarehouse;
					NewRow.Purpose = String.SupplyAssignment;
					NewRow.ProductCostElement = String.FinishedProductBeingRepairedIsProductCostingElement;
					NewRow.Department = DocumentObject.Department;
					
					If ValueIsFilled(String.UnderRepairBatch) Then
						RowsWithSeries_.Insert(String, NewRow);
					EndIf;
					
					RowsToProcess.Add(NewRow);
					
				EndDo;
				
				StructureOfActions = New Structure;
				ProductionManagementClientServer.AddQualityControlActionsToStructure(
					"SideAndIntermediateRelease",
					StructureOfActions,
					QualityControl.DataCacheOfMechanism(DocumentObject));
				BatchProcessingOfTablePartServer.ProcessTSStrings(RowsToProcess, StructureOfActions, DocumentObject.SideAndIntermediateRelease);
				
				SeriesSpecificationParameters = SeriesSpecificationParameters(DocumentObject);
				ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SideAndIntermediateRelease);
				
				If RowsWithSeries_.Count() > 0 Then
					For Each KeyAndValue In RowsWithSeries_ Do
						String = KeyAndValue.Key;
						NewRow = KeyAndValue.Value;
						
						If NewRow.BatchesIndicationStatus = 0 Then
							Continue;
						EndIf;
						
						BatchAtTSItems = ProductsClientServer.InThisStatusOfSeriesWHGoodsAreIndicated(
							NewRow.BatchesIndicationStatus, SeriesSpecificationParameters.SideAndIntermediateRelease);
						If BatchAtTSItems Then
							NewRow.Series = String.UnderRepairBatch;
						Else
							NewRowSeries = DocumentObject.BatchSideAndIntermediateRelease.Add();
							FillPropertyValues(NewRowSeries, NewRow);
							NewRowSeries.Series = String.UnderRepairBatch;
						EndIf;
					EndDo;
					
					ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.SideAndIntermediateRelease);
				EndIf;
				
				If Not DocumentObject.CheckFilling() Then
					Raise TextOfErrorCheckingFillingWhenRecordingStage(DocumentObject);
				EndIf;
				
				DocumentObject.Write(DocumentWriteMode.Posting);
				
			EndDo;
			
		EndIf;
		
		CommitTransaction();
	Except
		RollbackTransaction();
		
		EventName = NStr("vi = 'Công đoạn sản xuất';
						|ru = 'Этап производства';
						|en = 'Production stage'; fa = 'مرحله تولید';
						|it = 'Fase di produzione';
						|pl = 'Etap produkcji';
						|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
			+ NStr("vi = 'Thêm công việc';
					|ru = 'Добавление работ';
					|en = 'Add works'; fa = 'افزودن کارها';
					|it = 'Add works';
					|pl = 'Add works';
					|tr = 'İş ekle'", Common.DefaultLanguageCode());
		
		WriteLogEvent(EventName,
			EventLogLevel.Error,,,
			ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		Raise;
	EndTry;
	
EndProcedure

