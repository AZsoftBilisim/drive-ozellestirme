		|			THEN TRUE
		|		ELSE FALSE
		|	END                                                  AS ThisIsWarehouseRecord
		|FROM
		|	DocumentDataTableSavingBatchMaterials AS TabularSection
		|		LEFT JOIN DocumentDataHeader AS HeaderData_
		|		ON TabularSection.Ref = HeaderData_.Ref
		|WHERE
		|	HeaderData_.Status IN (
		|		VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
		|		VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND TabularSection.Recipient <> VALUE(Catalog.Warehouses.EmptyRef)
		|	AND TabularSection.RecipientWorkshopStoreroom
		|	AND TabularSection.RecipientDivision = TabularSection.Department";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or (DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
			Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
		 And DocumentObject.MaterialsAndWorksConsumption.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataHeader", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
		EndIf;
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableOfExpensesOfMaterialsAndWorks", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableOfExpensesOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		// Material consumption
		"SELECT
		|	TabularSection.Ref                                   AS Recorder,
		|	TabularSection.DateOfMaterialWorkConsumption                              AS Period,
		|	TabularSection.Products                             AS Products,
		|	TabularSection.Characteristic                           AS Characteristic,
		|	HeaderData_.Purpose                                  AS Purpose,
		|	TabularSection.Series                                    AS Series,
		|	TabularSection.Count                               AS Count,
		|	TabularSection.Department                            AS Sender,
		|	TabularSection.Department                            AS Recipient,
		|	VALUE(Enum.WarehouseTransactions.ConsumptionDuringProduction) AS WarehouseOperation,
		|	TabularSection.Ref                                   AS Document,
		|	TRUE                                                  AS ThisIsWarehouseRecord
		|FROM
		|	DocumentDataTableOfExpensesOfMaterialsAndWorks AS TabularSection
		|		LEFT JOIN DocumentDataHeader AS HeaderData_
		|		ON TabularSection.Ref = HeaderData_.Ref
		|WHERE
		|	HeaderData_.Status IN (
		|		VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
		|		VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
		|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
		|	AND TabularSection.Series <> VALUE(Catalog.ItemsBatches.EmptyRef)";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If ArrayOfRequestTexts.Count() = 0 Then
		Return "";
	EndIf;
	
	QueryText = StrConcat(ArrayOfRequestTexts, TMCommonUse.QuerySeparatorInJoin());
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableCompanyGoods(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "CompanyGoods";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	ArrayOfRequestTexts = New Array;
	
	If DocumentObject = Undefined
	 Or DocumentObject.InventoryOwnerAttributesProducts.FindRows(New Structure("ToExpenseAs", False)).Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableTypesOfProductStocks", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableTypesOfProductStocks(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		"SELECT
		|	VALUE(AccumulationRecordType.Receipt)		AS RecordType,
		|	TabularSection.DateOfTransaction					AS Period,
		|	TabularSection.ItemsLocationAttributes	AS ItemsLocationAttributes,
		|	CASE
		|		WHEN TabularSection.InventoryOwnerAttributeSaleOfAnotherCompanySInventory
		|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttribute
		|		ELSE TabularSection.InventoryOwnerAttribute
		|	END										AS InventoryOwnerAttribute,
		|	TabularSection.CCDNumber						AS CCDNumber,
		|	TabularSection.Count					AS Count,
		|	0											AS QuantityByGBRN,
		|	0											AS ToRegisterGoodsIssue,
		|	0											AS ToRegisterGoodsIssueByProductBatchID,
		|	CASE
		|		WHEN TabularSection.InventoryOwnerAttributeSaleOfAnotherCompanySInventory
		|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany
		|		ELSE TabularSection.TypeOfInventoryOwnerAttributeCompany
		|	END										AS Organization,
		|	TabularSection.BusinessOperation		AS BusinessOperation,
		|	&DefaultProductAccountingAnalytics		AS CorItemsLocationAttributes,
		|	&DefaultStockView						AS CorInventoryOwnerAttribute,
		|	UNDEFINED								AS ExpenseItem,
		|	UNDEFINED								AS DimensionOfExpenses,
		|	UNDEFINED								AS AssetsLiabilitiesDimension
		|
		|FROM
		|	DocumentDataTableTypesOfProductStocks AS TabularSection
		|
		|WHERE
		|	NOT TabularSection.ToExpenseAs";
		
		ArrayOfRequestTexts.Add(QueryText);
		
	EndIf;
	
	If DocumentObject = Undefined
	 Or DocumentObject.InventoryOwnerAttributesMaterials.Count() > 0 Then
		
		If Not DocumentsPosting.ThereIsQueryTable(
					"DocumentDataTableTypesOfStocksMaterials", QueryTexts, TempTablesManager) Then
			QueryTextDocumentDataTableTypesOfStocksMaterials(Query, QueryTexts, DocumentObject);
		EndIf;
		
		QueryText =
		"SELECT
		|	VALUE(AccumulationRecordType.Expense)			AS RecordType,
		|	TabularSection.DateOfTransaction						AS Period,
		|	TabularSection.ItemsLocationAttributes		AS ItemsLocationAttributes,
		|	CASE
		|		WHEN TabularSection.InventoryOwnerAttributeSaleOfAnotherCompanySInventory
		|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttribute
		|		ELSE TabularSection.InventoryOwnerAttribute
		|	END											AS InventoryOwnerAttribute,
		|	TabularSection.CCDNumber							AS CCDNumber,
		|	TabularSection.Count						AS Count,
		|	TabularSection.QuantityByGBRN					AS QuantityByGBRN,
		|	0												AS ToRegisterGoodsIssue,
		|	0												AS ToRegisterGoodsIssueByProductBatchID,
		|	CASE
		|		WHEN TabularSection.InventoryOwnerAttributeSaleOfAnotherCompanySInventory
		|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany
		|		ELSE TabularSection.TypeOfInventoryOwnerAttributeCompany
		|	END											AS Organization,
		|	TabularSection.BusinessOperation			AS BusinessOperation,
		|	TabularSection.CorItemsLocationAttributes	AS CorItemsLocationAttributes,
		|	TabularSection.CorInventoryOwnerAttribute					AS CorInventoryOwnerAttribute,
		|	TabularSection.ExpenseItem					AS ExpenseItem,
		|	TabularSection.DimensionOfExpenses				AS DimensionOfExpenses,
		|	TabularSection.AssetsLiabilitiesDimension			AS AssetsLiabilitiesDimension
		|FROM
		|	DocumentDataTableTypesOfStocksMaterials AS TabularSection
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt)			AS RecordType,
		|	TabularSection.DateOfTransaction						AS Period,
		|	TabularSection.CorItemsLocationAttributes	AS ItemsLocationAttributes,
		|	CASE
		|		WHEN TabularSection.InventoryOwnerAttributeSaleOfAnotherCompanySInventory
		|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttribute
		|		ELSE TabularSection.InventoryOwnerAttribute
		|	END											AS InventoryOwnerAttribute,
		|	TabularSection.CCDNumber							AS CCDNumber,
		|	TabularSection.Count						AS Count,
		|	TabularSection.QuantityByGBRN					AS QuantityByGBRN,
		|	0												AS ToRegisterGoodsIssue,
		|	0												AS ToRegisterGoodsIssueByProductBatchID,
		|	CASE
		|		WHEN TabularSection.InventoryOwnerAttributeSaleOfAnotherCompanySInventory
		|			THEN TabularSection.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany
		|		ELSE TabularSection.TypeOfInventoryOwnerAttributeCompany
		|	END											AS Organization,
		|	TabularSection.BusinessOperation			AS BusinessOperation,
		|	&DefaultProductAccountingAnalytics			AS CorItemsLocationAttributes,
		|	&DefaultStockView							AS CorInventoryOwnerAttribute,
		|	UNDEFINED									AS ExpenseItem,
		|	UNDEFINED									AS DimensionOfExpenses,
		|	UNDEFINED									AS AssetsLiabilitiesDimension
		|FROM
		|	DocumentDataTableTypesOfStocksMaterials AS TabularSection
		|
		|WHERE
		|	TabularSection.BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.TransferToProduction),
		|			VALUE(Enum.BusinessTransactions.ReturnFromProduction))
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt)		AS RecordType,
		|	TabularSection.DateOfTransaction					AS Period,
		|	TabularSection.ItemsLocationAttributes	AS ItemsLocationAttributes,
		|	TabularSection.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
		|	TabularSection.CCDNumber						AS CCDNumber,
		|	0											AS Count,
		|	0											AS QuantityByGBRN,
		|	TabularSection.Count					AS ToRegisterGoodsIssue,
		|	TabularSection.QuantityByGBRN				AS ToRegisterGoodsIssueByProductBatchID,
		|	TabularSection.TypeOfInventoryOwnerAttributeCompany		AS Organization,
		|	TabularSection.BusinessOperation		AS BusinessOperation,
		|	&DefaultProductAccountingAnalytics		AS CorItemsLocationAttributes,
		|	&DefaultStockView						AS CorInventoryOwnerAttribute,
		|	UNDEFINED								AS ExpenseItem,
		|	UNDEFINED								AS DimensionOfExpenses,
		|	UNDEFINED								AS AssetsLiabilitiesDimension
		|FROM
		|	DocumentDataTableTypesOfStocksMaterials AS TabularSection
		|
		|WHERE
		|	TabularSection.BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)
		|	AND TabularSection.InventoryOwnerAttributeIsTypeOfInventory IN(
		|		VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider),
		|		VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
		|		VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider),
		|		VALUE(Enum.InventoryTypes.GoodsInStorageWithRightToSell))";
		
		ArrayOfRequestTexts.Add(QueryText);
		
		If DocumentObject = Undefined
		 Or Not DocumentObject.ProductionByThirdParty2_5 Then
			
			QueryText =
			// Write-off of work expenses for Lot references of production for the purpose of the stage.
			"SELECT
			|	VALUE(AccumulationRecordType.Expense)			AS RecordType,
			|	TabularSection.DateOfTransaction						AS Period,
			|	TabularSection.CorItemsLocationAttributes	AS ItemsLocationAttributes,
			|	TabularSection.InventoryOwnerAttribute						AS InventoryOwnerAttribute,
			|	TabularSection.CCDNumber							AS CCDNumber,
			|	TabularSection.Count						AS Count,
			|	TabularSection.QuantityByGBRN					AS QuantityByGBRN,
			|	0												AS ToRegisterGoodsIssue,
			|	0												AS ToRegisterGoodsIssueByProductBatchID,
			|	TabularSection.TypeOfInventoryOwnerAttributeCompany			AS Organization,
			|	VALUE(Enum.BusinessTransactions.ExpensingToProductionLots) AS BusinessOperation,
			|	&DefaultProductAccountingAnalytics			AS CorItemsLocationAttributes,
			|	&DefaultStockView							AS CorInventoryOwnerAttribute,
			|	UNDEFINED									AS ExpenseItem,
			|	UNDEFINED									AS DimensionOfExpenses,
			|	UNDEFINED									AS AssetsLiabilitiesDimension
			|FROM
			|	DocumentDataTableTypesOfStocksMaterials AS TabularSection
			|
			|WHERE
			|	NOT &ProductionByThirdParty2_5
			|	AND TabularSection.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.Work_5)";
			
			ArrayOfRequestTexts.Add(QueryText);
			
		EndIf;
		
	EndIf;
	
	If ArrayOfRequestTexts.Count() = 0 Then
		Return "";
	EndIf;
	
	QueryText = StrConcat(ArrayOfRequestTexts, TMCommonUse.QuerySeparatorInJoin());
	
	QueryText = StrReplace(QueryText,
								"&DefaultProductAccountingAnalytics",
								"VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)");
	QueryText = StrReplace(QueryText,
								"&DefaultStockView",
								"VALUE(Catalog.InventoryKinds.EmptyRef)");
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableCompanyGoodsForTransfer(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "CompanyGoodsForTransfer";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable("TTTypesOfStocks", QueryTexts, TempTablesManager) Then
		QueryTextTTTypesOfStocks(Query, QueryTexts, RegisterName, DocumentObject);
	EndIf;
	
	QueryText =
	"SELECT
	|	VALUE(AccumulationRecordType.Receipt)                  AS RecordType,
	|	TabularSection.DateOfTransaction                             AS Period,
	|	TabularSection.InventoryOwnerAttributeInventoryOwnerAttributeOfOwnerCompany	AS CompanyOwner,
	|	TabularSection.ItemsLocationAttributes               AS ItemsLocationAttributes,
	|	TabularSection.InventoryOwnerAttribute                               AS SellerInventoryOwnerAttribute,
	|	TabularSection.CCDNumber                                 AS CCDNumber,
	|	TabularSection.Count                               AS Count,
	|	TabularSection.BusinessOperation                    AS BusinessOperation,
	|	&ReleaseUnderActivityRedefinition                   AS VATTaxation
	|FROM
	|	TTTypesOfStocks AS TabularSection
	|WHERE
	|	TabularSection.SaleOfAnotherCompanyInventory
	|	AND TabularSection.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToProduction)
	|	AND TabularSection.ProductsTypeOfProducts IN(
	|		VALUE(Enum.ItemsTypes.OwnGoods),
	|		VALUE(Enum.ItemsTypes.ReusablePackage))";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableDatesOfCompanyGoodsReceipt(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "DatesOfCompanyGoodsReceipt";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable("TTTypesOfStocks", QueryTexts, TempTablesManager) Then
		QueryTextTTTypesOfStocks(Query, QueryTexts, RegisterName, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableTypesOfStocksMaterials", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataTableTypesOfStocksMaterials(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText =
	"SELECT DISTINCT
	|	TabularSection.DateOfTransaction									AS DateOfReceipt,
	|	TabularSection.AnalysisOfAccountingForProductsProducts		AS Products,
	|	TabularSection.AnalysisOfAccountingProductsCharacteristics		AS Characteristic,
	|	TabularSection.InventoryLocationAttributeAnalysisBatch				AS Series,
	|	TabularSection.ItemsLocationAttributesAssignment			AS Purpose,
	|	TabularSection.InventoryOwnerAttribute									AS InventoryOwnerAttribute,
	|	VALUE(Catalog.CCDNumbers.EmptyRef)					AS CCDNumber
	|FROM
	|	TTTypesOfStocks AS TabularSection
	|		LEFT JOIN InformationRegister.DatesOfCompanyGoodsReceipt AS UninvoicedReceipts
	|		ON TabularSection.InventoryOwnerAttribute = UninvoicedReceipts.InventoryOwnerAttribute
	|			AND TabularSection.AnalysisOfAccountingForProductsProducts = UninvoicedReceipts.Products
	|			AND TabularSection.AnalysisOfAccountingProductsCharacteristics = UninvoicedReceipts.Characteristic
	|			AND TabularSection.InventoryLocationAttributeAnalysisBatch = UninvoicedReceipts.Series
	|			AND TabularSection.ItemsLocationAttributesAssignment = UninvoicedReceipts.Purpose
	|			AND UninvoicedReceipts.CCDNumber = VALUE(Catalog.CCDNumbers.EmptyRef)
	|WHERE
	|	TabularSection.BusinessOperation IN(
	|			VALUE(Enum.BusinessTransactions.ProductsRelease),
	|			VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost))
	|	AND TabularSection.ProductsTypeOfProducts =
	|			VALUE(Enum.ItemsTypes.OwnGoods)
	|	AND NOT TabularSection.AddOnForGiver
	|	AND (UninvoicedReceipts.InventoryOwnerAttribute IS NULL
	|		OR UninvoicedReceipts.DateOfReceipt < TabularSection.DateOfTransaction)
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	TabularSection.DateOfTransaction									AS DateOfReceipt,
	|	TabularSection.CorItemsLocationAttributesProducts	AS Products,
	|	TabularSection.CorItemsLocationAttributesItemsCharacteristic	AS Characteristic,
	|	TabularSection.CorItemsLocationAttributesBatch			AS Series,
	|	TabularSection.CorItemsLocationAttributesAnalysis		AS Purpose,
	|	TabularSection.InventoryOwnerAttribute									AS InventoryOwnerAttribute,
	|	TabularSection.CCDNumber										AS CCDNumber
	|FROM
	|	DocumentDataTableTypesOfStocksMaterials AS TabularSection
	|		LEFT JOIN InformationRegister.DatesOfCompanyGoodsReceipt AS UninvoicedReceipts
	|		ON TabularSection.InventoryOwnerAttribute = UninvoicedReceipts.InventoryOwnerAttribute
	|			AND TabularSection.CorItemsLocationAttributesProducts = UninvoicedReceipts.Products
	|			AND TabularSection.CorItemsLocationAttributesItemsCharacteristic = UninvoicedReceipts.Characteristic
	|			AND TabularSection.CorItemsLocationAttributesBatch = UninvoicedReceipts.Series
	|			AND TabularSection.CorItemsLocationAttributesAnalysis = UninvoicedReceipts.Purpose
	|			AND TabularSection.CCDNumber = UninvoicedReceipts.CCDNumber
	|WHERE
	|	&ProductionByThirdParty2_5
	|	AND TabularSection.InventoryOwnerAttributeIsTypeOfInventory = VALUE(Enum.InventoryTypes.Work_5)
	|	AND (UninvoicedReceipts.InventoryOwnerAttribute IS NULL
	|		OR UninvoicedReceipts.DateOfReceipt < TabularSection.DateOfTransaction)
	|";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;
	
EndFunction

Function QueryTextTableOrdersOfMaterialsForProduction(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "OrdersOfMaterialsForProduction";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
	EndIf; 
	
	If DocumentObject <> Undefined
	   And Not ((DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Generated1
				Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.ForCompletion
				Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Initiated
				Or DocumentObject.Status = Enums.StatusesOfProductionStages2_2.Completed)
			 And Not DocumentObject.ProductionByThirdParty
			 And DocumentObject.SupplyWithMaterialsAndWorks.Count() > 0) Then
		Return "";
	EndIf;
	
	TempTablesManager = ?(Query = Undefined, Undefined, Query.TempTablesManager);
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataHeader", QueryTexts, TempTablesManager) Then
		QueryTextDocumentDataHeader(Query, QueryTexts, DocumentObject);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable(
				"DocumentDataTableProvisionOfMaterialsAndWorks",
				QueryTexts,
				TempTablesManager) Then
		QueryTextDocumentDataTableProvisionOfMaterialsAndWorks(Query, QueryTexts, DocumentObject);
	EndIf;
	
	QueryText = 
	"SELECT
	|	TabularSection.Ref                        AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt)       AS RecordType,
	|	HeaderData_.Date                             AS Period,
	|	TabularSection.Ref                        AS ReferenceOrder,
	|	TabularSection.Department                 AS Department,
	|	TabularSection.Department                 AS Recipient,
	|	TabularSection.Products                  AS Products,
	|	TabularSection.Characteristic                AS Characteristic,
	|	TabularSection.RowCode                     AS RowCode,
	|	TabularSection.Series                         AS Series,
	|	TabularSection.Warehouse                         AS Warehouse,
	|	CASE
	|		WHEN TabularSection.WithAssignment THEN
	|				TabularSection.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END                                        AS AssignmentSender,
	|	HeaderData_.Purpose                       AS Purpose,
	|	TabularSection.Count                    AS Ordered,
	|	CASE
	|		WHEN TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.FromWarehouse)
	|			THEN TabularSection.Count
	|	END                                        AS InReserve,
	|	CASE
	|		WHEN TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|			THEN TabularSection.Count
	|	END                                        AS ToRegister
	|FROM
	|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|WHERE
	|	HeaderData_.Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
	|		VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|
	|	AND NOT HeaderData_.ProductionByThirdParty
	|
	|	AND TabularSection.SupplyOption IN (
	|				VALUE(Enum.SupplyOptions.ReserveAsReceived),
	|				VALUE(Enum.SupplyOptions.ToSupply),
	|				VALUE(Enum.SupplyOptions.FromWarehouse),
	|				VALUE(Enum.SupplyOptions.Ship))
	|
	|	AND TabularSection.ProductsTypeOfProducts IN (
	|				VALUE(Enum.ItemsTypes.OwnGoods),
	|				VALUE(Enum.ItemsTypes.ReusablePackage))
	|
	|	AND NOT TabularSection.Canceled
	|
	|UNION ALL
	|
	|SELECT
	|	TabularSection.Ref                        AS Recorder,
	|	VALUE(AccumulationRecordType.Expense)       AS RecordType,
	|	TabularSection.DateOfShipment                  AS Period,
	|	TabularSection.Ref                        AS ReferenceOrder,
	|	TabularSection.Department                 AS Department,
	|	TabularSection.Department                 AS Recipient,
	|	TabularSection.Products                  AS Products,
	|	TabularSection.Characteristic                AS Characteristic,
	|	TabularSection.RowCode                     AS RowCode,
	|	TabularSection.Series                         AS Series,
	|	TabularSection.Warehouse                         AS Warehouse,
	|	CASE
	|		WHEN TabularSection.WithAssignment
	|			THEN TabularSection.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END                                        AS AssignmentSender,
	|	HeaderData_.Purpose                       AS Purpose,
	|	TabularSection.Count                    AS Ordered,
	|	0                                            AS InReserve,
	|	TabularSection.Count                    AS ToRegister
	|FROM
	|	DocumentDataTableProvisionOfMaterialsAndWorks AS TabularSection
	|		LEFT JOIN DocumentDataHeader AS HeaderData_
	|		ON TabularSection.Ref = HeaderData_.Ref
	|WHERE
	|	HeaderData_.Status IN (
	|		VALUE(Enum.StatusesOfProductionStages2_2.Generated1),
	|		VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
	|		VALUE(Enum.StatusesOfProductionStages2_2.Completed))
	|
	|	AND NOT HeaderData_.ProductionByThirdParty
	|
	|	AND (TabularSection.WarehouseShopFloorStockroom
	|		AND TabularSection.WarehouseDivision = TabularSection.Department)
	|
	|	AND TabularSection.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|
	|	AND TabularSection.ProductsTypeOfProducts IN (
	|				VALUE(Enum.ItemsTypes.OwnGoods),
	|				VALUE(Enum.ItemsTypes.ReusablePackage))
	|
	|	AND NOT TabularSection.Canceled";
	
	QueryTexts.Add(QueryText, RegisterName);
	
	Return QueryText;

EndFunction

Function QueryTextTableReferencesToTransferFromProduction(Query, QueryTexts, Registers, DocumentObject)
	
	RegisterName = "ReferencesToTransferFromProduction";
	
	If Not DocumentsPosting.RequiresTableForRegisteredRecords(RegisterName, Registers) Then
		Return "";
