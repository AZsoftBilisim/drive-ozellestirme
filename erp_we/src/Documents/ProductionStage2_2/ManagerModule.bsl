// Removes the flag for manual placement in the production schedule for stages.
//
// Parameters:
//  Stages - Array - array of production stages for which you need to remove the manual placement option in the schedule.
//
Procedure CancelManualPlacementOfStagesInSchedule(Stages) Export
	
	For Each Stage In Stages Do
		
		Try
			
			DocumentObject = Stage.GetObject();
			DocumentObject.Lock();
			DocumentObject.StagePlacementInProductionSchedule = False;
			DocumentObject.PlanOperationsOfWorkCenterTypes = DocumentObject.WorkCenterTypes.Count() > 0;
			
			DocumentObject.DisableControlOfPlacementParametersInChart();
			DocumentObject.DisableOrderStateUpdate();
			DocumentObject.Write(DocumentWriteMode.Posting);
			DocumentObject.Unlock();
			
		Except
		
			Event = NStr("vi = 'Công đoạn sản xuất';
						|ru = 'Этап производства';
						|en = 'Production stage'; fa = 'مرحله تولید';
						|it = 'Fase di produzione';
						|pl = 'Etap produkcji';
						|tr = 'Üretim aşaması'", Common.DefaultLanguageCode()) + "."
					+ NStr("vi = 'Đã hủy sắp xếp thủ công trong lịch biểu';
							|ru = 'Отмена ручного размещения в графике';
							|en = 'Canceling manual placement in the schedule'; fa = 'Canceling manual placement in the schedule';
							|it = 'Annullamento del riposizionamento manuale nel grafico';
							|pl = 'Anulowanie ręcznego rozmieszczenia w harmonogramie';
							|tr = 'Programda manuel yerleştirmenin iptali'", Common.DefaultLanguageCode());
			
			WriteLogEvent(Event,
				EventLogLevel.Error,
				,
				,
				DetailErrorDescription(ErrorInfo()));
			
			Raise;
			
		EndTry;
		
	EndDo;
	
EndProcedure

