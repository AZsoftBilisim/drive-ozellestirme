			<dataPath>AssetsLiabilitiesDimension</dataPath>
			<field>AssetsLiabilitiesDimension</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Purpose</dataPath>
			<field>Purpose</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Assignment</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تخصیص</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Destinazione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Przeznaczenie</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Назначение</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Atama</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Ấn định</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	 OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	ISNULL( OutputTurnover_.ItemsLocationAttributes.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	OutputTurnover_.CountTurnover AS ManufacturedProducts,
	 OutputTurnover_.ItemsLocationAttributes.Purpose AS Purpose
FROM
	AccumulationRegister.ProductsRelease.Turnovers(, , Auto, ) AS OutputTurnover_
{WHERE
	 OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	 OutputTurnover_.ItemsLocationAttributes.StorageLocation AS Warehouse,
	(ISNULL( OutputTurnover_.ItemsLocationAttributes.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS Characteristic}</query>
	</dataSet>
	<totalField>
		<dataPath>ManufacturedProducts</dataPath>
		<expression>IsNull(Sum(ManufacturedProducts), 0)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
