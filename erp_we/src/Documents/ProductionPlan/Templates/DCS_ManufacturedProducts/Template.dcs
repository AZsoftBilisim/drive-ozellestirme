		<field xsi:type="DataSetFieldField">
			<dataPath>ManufacturedProducts</dataPath>
			<field>ManufacturedProducts</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Manufactured products</v8:content>
				</v8:item>
