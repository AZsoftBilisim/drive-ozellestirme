		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DATEADD(OutputTurnover_.DayPeriod, &amp;PeriodString, -&amp;PeriodOffset) AS Period,
	OutputTurnover_.Recorder AS Recorder,
	OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	OutputTurnover_.ItemsLocationAttributes.Products.ProductCategory AS ProductCategory,
	OutputTurnover_.ItemsLocationAttributes.Products.SalesRank AS SalesRank,	
	ISNULL(OutputTurnover_.ItemsLocationAttributes.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	OutputTurnover_.CountTurnover AS ProductionFacts,
	CASE
		WHEN NOT ManufacturedProduct.Purpose IS NULL
			THEN ManufacturedProduct.Purpose
		WHEN NOT SideAndIntermediateRelease.Purpose IS NULL
			THEN SideAndIntermediateRelease.Purpose
		WHEN TRUE
			THEN OutputTurnover_.ItemsLocationAttributes.Purpose
	END AS Purpose,
	CASE
		WHEN OutputTurnover_.Recorder REFS Document.ProductionStage2_2
			THEN ISNULL(OutputTurnover_.Recorder.ReferenceOrder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN OutputTurnover_.Recorder REFS Document.BackflushProduction
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	

		WHEN TRUE 
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END AS ProductionDispatcherBusinessUnit
INTO OutputTurnover_
FROM
	AccumulationRegister.ProductsRelease.Turnovers(, , Auto, ) AS OutputTurnover_
		LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProduct
		ON (ManufacturedProduct.Ref = OutputTurnover_.ReferenceOrder)
			AND (ManufacturedProduct.RowCode = OutputTurnover_.RowCode)
		LEFT JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS SideAndIntermediateRelease
		ON (SideAndIntermediateRelease.Ref = OutputTurnover_.ReferenceOrder)
			AND (SideAndIntermediateRelease.RowCode = OutputTurnover_.RowCode)
{WHERE
	OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	OutputTurnover_.ItemsLocationAttributes.StorageLocation AS Warehouse,
	(ISNULL(OutputTurnover_.ItemsLocationAttributes.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS Characteristic,
	CASE
		WHEN NOT ManufacturedProduct.Purpose IS NULL
			THEN ManufacturedProduct.Purpose
		WHEN NOT SideAndIntermediateRelease.Purpose IS NULL
			THEN SideAndIntermediateRelease.Purpose
		WHEN TRUE
			THEN OutputTurnover_.ItemsLocationAttributes.Purpose
	END = &amp;FilterPurpose AS Purpose}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	OutputTurnover_.Period AS Period,
	OutputTurnover_.Recorder AS Recorder,
	OutputTurnover_.Products AS Products,
	OutputTurnover_.ProductCategory AS ProductCategory,
	OutputTurnover_.SalesRank AS SalesRank,
	OutputTurnover_.Characteristic AS Characteristic,
	OutputTurnover_.ProductionFacts AS ProductionFacts,
	OutputTurnover_.Purpose AS Purpose,
	OutputTurnover_.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit
FROM
	OutputTurnover_ AS OutputTurnover_
{WHERE
	(CASE WHEN OutputTurnover_.ProductionDispatcherBusinessUnit = VALUE(Catalog.BusinessStructure.EmptyRef) THEN &amp;FilterProductionDispatcherBusinessUnit ELSE OutputTurnover_.ProductionDispatcherBusinessUnit END) AS ProductionDispatcherBusinessUnit}</query>
	</dataSet>
	<totalField>
		<dataPath>ProductionFacts</dataPath>
		<expression>IsNull(Sum(ProductionFacts), 0)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End</expression>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End</expression>
	</parameter>
