    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ProductionPlansOverridable.Recorder AS Recorder,
	ProductionPlansOverridable.LineNumber AS LineNumber,
	
	ProductionPlansOverridable.ProductionPlan AS ProductionPlan,
	ProductionPlansOverridable.Period AS Period,
	ProductionPlansOverridable.BillOfMaterials AS BillOfMaterials,
	ProductionPlansOverridable.Products AS Products,
	ProductionPlansOverridable.Characteristic AS Characteristic,
	ProductionPlansOverridable.Purpose AS Purpose,

	ProductionPlansOverridable.ProductionIssueDateOfIntermediateProducts AS ProductionIssueDateOfIntermediateProducts,
	ProductionPlansOverridable.DateOfOrderReleaseAndProductionIssue AS DateOfOrderReleaseAndProductionIssue,

	ProductionPlansOverridable.Count AS Count,
	ProductionPlansOverridable.ToOrder AS ToOrder,

	VALUE(Enum.ItemsTypes.EmptyRef) AS ItemsType,
	FALSE AS ItemVariantsAreUsed,

	ProductionPlansOverridable.ManualAdjustment AS ManualAdjustment,
	ProductionPlansOverridable.AdjustmentDate AS AdjustmentDate,
	ProductionPlansOverridable.AdjustmentAuthor AS AdjustmentAuthor,
	ProductionPlansOverridable.Comment AS Comment
	
FROM
	AccumulationRegister.ProductionPlans AS ProductionPlansOverridable
WHERE
	FALSE</queryText>
      <mainTable>AccumulationRegister.ProductionPlans</mainTable>
