		<row>
			<c>
				<c>
					<f>5</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Product category</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>دسته محصول</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Categoria merceologica</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Kategoria produktu</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Товарная категория</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Ürün kategorisi</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Thể loại hàng hóa</v8:content>
						</v8:item>
					</tl>
					<detailParameter>ProductCategory</detailParameter>
					<note>
						<drawingType>Comment</drawingType>
						<id>0</id>
						<formatIndex>6</formatIndex>
						<text>
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Product category
Type: String (100 characters)
Example: Women's winter shoes</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>طبقه محصول
نوع: رشته (100 کاراکتر)
مثال: کفش زمستانی زنانه</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Categoria di prodotto
Tipo: Riga (100 simboli)
Esempio: Calzatura femminile invernale</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Kategoria towarowa
Typ: Wiersz (100 symboli)
Przykład: Obuwie żeńskie zimowe</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Товарная категория
Тип: Строка (100 символов)
Пример: Обувь женская зимняя</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Ürün kategorisi
Tip: Satır (100 karakter)
Örneğin: Kışlık kadın ayakkabı</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Thể loại hàng hóa
Kiểu: Xâu ký tự (100 ký tự)
Ví dụ: Giày nữ mùa đông</v8:content>
							</v8:item>
						</text>
						<beginRow>1</beginRow>
						<beginRowOffset>-21</beginRowOffset>
						<endRow>0</endRow>
						<endRowOffset>135</endRowOffset>
