			<c>
				<c>
					<f>7</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Brand</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>برند</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Marchio</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Marka (brand)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Марка (бренд)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Marka (marka)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Nhãn hiệu (thương hiệu)</v8:content>
						</v8:item>
					</tl>
					<detailParameter>Brand</detailParameter>
					<note>
						<drawingType>Comment</drawingType>
						<id>0</id>
						<formatIndex>6</formatIndex>
						<text>
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Goods item brand. An empty field means "Other brands".
Type: String (100 characters)
Example: Nike</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>برند قلم کالا. فیلد خالی به معنای "سایر برندها" است.
نوع: رشته (100 کاراکتر)
مثال: Nike</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Marchio (brand) del prodotto. Il campo vuoto indica "Altri marchi". 
Tipo: Riga (100 simboli)
Esempio: Nike</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Marka towaru. Puste pole oznacza "Pozostałe marki".
Typ: Wiersz (100 symboli)
Przykład: Nike</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Марка (бренд) товара. Пустое поле означает "Прочие марки".
Тип: Строка (100 символов)
Пример: Nike</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Ürün markası (marka). Boş alan, "Diğer markalar" anlamına gelir.
Tip: Satır (100 karakter)
Örneğin: Nike</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Nhãn hiệu hàng hóa. Trường trống nghĩa là "Nhãn hiệu khác".
Kiểu: Xâu ký tự (100 ký tự)
Ví dụ: Nike</v8:content>
							</v8:item>
						</text>
