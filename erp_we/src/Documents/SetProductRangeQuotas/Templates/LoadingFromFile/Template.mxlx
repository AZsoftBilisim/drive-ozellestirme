				<c>
					<f>8</f>
					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>% of variance</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>درصد انحراف</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>% di scostamento</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>% odchylenia</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>% отклонения</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>% sapma</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>% sai lệch</v8:content>
						</v8:item>
					</tl>
					<detailParameter>VariancePercentage</detailParameter>
					<note>
						<drawingType>Comment</drawingType>
						<id>0</id>
						<formatIndex>6</formatIndex>
						<text>
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Set quota variance percentage.
Type: Number (integer)
Example: 15</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>تنظیم درصد انحراف سهمیه.
نوع: عدد (صحیح)
مثال: 15</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Percentuale di deviazione della quota stabilita.
Tipo: Numero (numero intero)
Esempio: 15</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Procent odchylenia ustalonego kontyngentu.
Typ: Liczba (całkowita)
Przykład: 15</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Процент отклонения установленной квоты.
Тип: Число (целое)
Пример: 15</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Yapılandırılan kotanın sapma yüzdesi.
Tip: Sayı (tam sayı)
Örneğin: 15</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Phần trăm chênh lệch hạn mức đã thiết lập.
Kiểu: Số (nguyên)
Ví dụ: 15</v8:content>
							</v8:item>
						</text>
