				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PurchaseAssortment</dataPath>
			<field>PurchaseAssortment</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Purchase product range</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>سبد محصول خرید</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Assortimento degli acquisti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Asorytment zakupów</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ассортимент закупок</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Satın alımların ürün gamı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Phân loại mua hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat AS PlanningObject
INTO PlanningObjects
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(&amp;OffsetPeriodStart, {(Warehouse = &amp;FilterWarehouse)}) AS HistoryOfChangesToStoreFormatsCrossSection
WHERE
	HistoryOfChangesToStoreFormatsCrossSection.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)
{WHERE
	(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat = &amp;FilterStoreFormat)}

UNION ALL

SELECT
	StoreFormats.Ref
FROM
	Catalog.StoreFormats AS StoreFormats
{WHERE
	(StoreFormats.Ref = &amp;FilterStoreFormat),
	(VALUE(Catalog.Warehouses.EmptyRef) = &amp;FilterWarehouse)}

UNION ALL

SELECT
	Warehouses.Ref
FROM
	Catalog.Warehouses AS Warehouses
WHERE
	NOT Warehouses.IsFolder
{WHERE
	(Warehouses.Ref = &amp;FilterWarehouse),
	(VALUE(Catalog.StoreFormats.EmptyRef) = &amp;FilterStoreFormat)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductRangeSliceLast.Products,
	ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	1 AS PurchaseAssortment
FROM
	InformationRegister.ProductRange.SliceLast(
			&amp;OffsetPeriodStart,
			PlanningObject IN
				(SELECT DISTINCT
					PlanningObjects.PlanningObject
				FROM
					PlanningObjects AS PlanningObjects)) AS ProductRangeSliceLast
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON (CASE
				WHEN ProductRangeSliceLast.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN ProductRangeSliceLast.Products
				WHEN ProductRangeSliceLast.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN ProductRangeSliceLast.Products.ProductKind
				WHEN ProductRangeSliceLast.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN ProductRangeSliceLast.Products.ItemVariantsOwner
				ELSE UNDEFINED
			END = ItemsCharacteristics.Owner)
WHERE
	ProductRangeSliceLast.PurchasesAreAllowed</query>
	</dataSet>
	<totalField>
		<dataPath>PurchaseAssortment</dataPath>
		<expression>Sum(IsNull(PurchaseAssortment, 0))</expression>
	</totalField>
