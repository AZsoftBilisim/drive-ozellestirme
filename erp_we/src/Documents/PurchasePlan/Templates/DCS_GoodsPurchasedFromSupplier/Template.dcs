			<dataPath>ProductLineOfBusiness</dataPath>
			<field>ProductLineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Purpose</dataPath>
			<field>Purpose</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Assignment</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تخصیص</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Destinazione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Przeznaczenie</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Назначение</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Atama</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Ấn định</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	PurchasesTurnovers.ItemsLocationAttributes.Products AS Products,
	ISNULL(PurchasesTurnovers.ItemsLocationAttributes.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	PurchasesTurnovers.CountTurnover AS GoodsPurchasedFromSupplier,
	PurchasesTurnovers.ItemsLocationAttributes.Purpose AS Purpose
FROM
	AccumulationRegister.Purchases.Turnovers(, , Auto, BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromSupplier) {(Partner = &amp;FilterPartner)}) AS PurchasesTurnovers
{WHERE
	PurchasesTurnovers.ItemsLocationAttributes.Products AS Products,
	PurchasesTurnovers.ItemsLocationAttributes.Characteristic AS Characteristic}</query>
	</dataSet>
	<totalField>
		<dataPath>GoodsPurchasedFromSupplier</dataPath>
		<expression>Sum(IsNull(GoodsPurchasedFromSupplier, 0))</expression>
	</totalField>
	<parameter>
