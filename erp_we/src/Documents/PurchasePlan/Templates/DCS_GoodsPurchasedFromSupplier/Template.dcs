					<v8:lang>ru</v8:lang>
					<v8:content>Аналитика учета номенклатуры.Характеристика</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Ürün hesabı boyutu.Özellik</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đối tượng phân tích kế toán mặt hàng.Đặc tính</v8:content>
				</v8:item>
			</title>
		</field>
