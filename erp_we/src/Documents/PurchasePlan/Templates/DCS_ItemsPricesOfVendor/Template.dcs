		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CurrencyRatesCut.Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products AS Products,
	ISNULL(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind,
	&amp;QueryTextPackagingFactor AS Packing_Coefficient,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor, 1) * CASE
		WHEN &amp;Currency &lt;&gt; PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
			THEN CASE
					WHEN ISNULL(ExchangeRatePrices.CourseDenominator, 0) &gt; 0
							AND ISNULL(ExchangeRatePrices.CourseNumerator, 0) &gt; 0
							AND ISNULL(CurrencyExchangeRate.CourseDenominator, 0) &gt; 0
							AND ISNULL(CurrencyExchangeRate.CourseNumerator, 0) &gt; 0
						THEN ExchangeRatePrices.CourseNumerator * CurrencyExchangeRate.CourseDenominator / (CurrencyExchangeRate.CourseNumerator * ExchangeRatePrices.CourseDenominator)
					ELSE 0
				END
		ELSE 1
	END AS Price,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Package
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast(&amp;OffsetPeriodStart, {(VendorPriceKind = &amp;FilterVendorPriceKind), ((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
		LEFT JOIN ExchangeRates AS ExchangeRatePrices
		ON PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency = ExchangeRatePrices.Currency
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON (CurrencyExchangeRate.Currency = &amp;Currency)</query>
	</dataSet>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Avg(IsNull(Price,0) *  
                Case
                    When
                        Package &lt;&gt; Value(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
                    Then
                        Packing_Coefficient
                    Else
                        1
                End
                )</expression>
	</totalField>
