		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CustomerInvoiceServicesAndAssets.Number,
	CustomerInvoiceServicesAndAssets.Date,
	Partners.Description AS PartnerName_,
	Partners.BusinessRegion,
	CASE
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN Partners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS PartnerAppeal,
	Partners.BirthDate,
	ContactPersonsForPartners.Description AS ContactPersonName,
	ContactPersonsForPartners.JobTitleOnBusinessCard AS ContactPersonBusinessCardPosition,
	CASE
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Masculine)
			THEN &amp;SalutationMale
		WHEN ContactPersonsForPartners.Gender = VALUE(Enum.GenderPersons.Feminine)
			THEN &amp;SalutationFemale
		ELSE &amp;SalutationGenderUnknown
	END AS ContactPersonAddress,
	CustomerInvoiceServicesAndAssets.Manager,
	CustomerInvoiceServicesAndAssets.Currency,
	CustomerInvoiceServicesAndAssets.PaymentMethod,
	CustomerInvoiceServicesAndAssets.DocumentAmount,
	CustomerInvoiceServicesAndAssets.Contract,
	CustomerInvoiceServicesAndAssets.DeliveryAddress,
	CustomerInvoiceServicesAndAssets.Shipper,
	CustomerInvoiceServicesAndAssets.GoodsRecipient
FROM
	Document.CustomerInvoiceServicesAndAssets AS CustomerInvoiceServicesAndAssets
		{LEFT JOIN Catalog.Partners AS Partners
		ON CustomerInvoiceServicesAndAssets.Partner = Partners.Ref
		LEFT JOIN Catalog.ContactPersonsForPartners AS ContactPersonsForPartners
		ON CustomerInvoiceServicesAndAssets.ContactPerson = ContactPersonsForPartners.Ref}
WHERE
	CustomerInvoiceServicesAndAssets.Ref = &amp;CustomerInvoiceServicesAndAssets</query>
	</dataSet>
