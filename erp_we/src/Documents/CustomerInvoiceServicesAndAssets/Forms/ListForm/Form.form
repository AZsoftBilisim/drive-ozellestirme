    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentCustomerInvoiceServicesAndAssets.Ref,
	DocumentCustomerInvoiceServicesAndAssets.DeletionMark,
	DocumentCustomerInvoiceServicesAndAssets.Number,
	DocumentCustomerInvoiceServicesAndAssets.Date,
	DocumentCustomerInvoiceServicesAndAssets.Posted,
	DocumentCustomerInvoiceServicesAndAssets.BusinessOperation,
	DocumentCustomerInvoiceServicesAndAssets.Organization,
	DocumentCustomerInvoiceServicesAndAssets.Department,
	DocumentCustomerInvoiceServicesAndAssets.Manager,
	DocumentCustomerInvoiceServicesAndAssets.Partner,
	DocumentCustomerInvoiceServicesAndAssets.Counterparty,
	DocumentCustomerInvoiceServicesAndAssets.Terms,
	DocumentCustomerInvoiceServicesAndAssets.Contract,
	DocumentCustomerInvoiceServicesAndAssets.FinancialAccountingGroup,
	DocumentCustomerInvoiceServicesAndAssets.Currency,
	DocumentCustomerInvoiceServicesAndAssets.ARAPCurrency,
	DocumentCustomerInvoiceServicesAndAssets.PriceIncludesVAT,
	DocumentCustomerInvoiceServicesAndAssets.VATTaxation,
	DocumentCustomerInvoiceServicesAndAssets.DocumentAmount,
	DocumentCustomerInvoiceServicesAndAssets.AmountARAP,
	DocumentCustomerInvoiceServicesAndAssets.PaymentDate,
	DocumentCustomerInvoiceServicesAndAssets.PaymentMethod,
	DocumentCustomerInvoiceServicesAndAssets.CompanyBankAccount,
	DocumentCustomerInvoiceServicesAndAssets.CounterpartyBankAccount,
	DocumentCustomerInvoiceServicesAndAssets.Shipper,
	DocumentCustomerInvoiceServicesAndAssets.GoodsRecipient,
	DocumentCustomerInvoiceServicesAndAssets.ShipperBankAccount,
	DocumentCustomerInvoiceServicesAndAssets.GoodsRecipientBankAccount,
	DocumentCustomerInvoiceServicesAndAssets.DeliveryAddress,
	DocumentCustomerInvoiceServicesAndAssets.PowerOfAttorneyNumber,
	DocumentCustomerInvoiceServicesAndAssets.PowerOfAttorneyDate,
	DocumentCustomerInvoiceServicesAndAssets.LetterOfAuthorityIssuedBy,
	DocumentCustomerInvoiceServicesAndAssets.PowerOfAttorneyPerson,
	DocumentCustomerInvoiceServicesAndAssets.IssuiedBy,
	DocumentCustomerInvoiceServicesAndAssets.IssuiedByJobTitle,
	DocumentCustomerInvoiceServicesAndAssets.Basis,
	DocumentCustomerInvoiceServicesAndAssets.Comment,
	DocumentCustomerInvoiceServicesAndAssets.ContactPerson,
	DocumentCustomerInvoiceServicesAndAssets.Director,
	DocumentCustomerInvoiceServicesAndAssets.ChiefAccountant,
	DocumentCustomerInvoiceServicesAndAssets.ARAPObjectSettings,
	DocumentCustomerInvoiceServicesAndAssets.ReferenceDocumentDateForPrintForms,
	DocumentCustomerInvoiceServicesAndAssets.BaseDocumentNumber,
	DocumentCustomerInvoiceServicesAndAssets.PaymentID,
	DocumentCustomerInvoiceServicesAndAssets.Author,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties,
	EDStates.EDIState,
	EDStates.StatusPresentation	
FROM
	Document.CustomerInvoiceServicesAndAssets AS DocumentCustomerInvoiceServicesAndAssets
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
				ON DocumentCustomerInvoiceServicesAndAssets.Ref = DocumentsWithCounterpartyCheckErrors.Document
				AND &amp;UsingOfCheckIsAnOption}
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON (EDStates.ObjectReference = DocumentCustomerInvoiceServicesAndAssets.Ref)				</queryText>
      <mainTable>Document.CustomerInvoiceServicesAndAssets</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
