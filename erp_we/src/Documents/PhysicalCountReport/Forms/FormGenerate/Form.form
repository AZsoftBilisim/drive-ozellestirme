              <items xsi:type="form:Decoration">
                <name>SceneryYouNeedToCreateAnInventory</name>
                <id>107</id>
                <title>
                  <key>en</key>
                  <value>There are inventory adjustments in the specified period that are not included in inventory registers. It is recommended that you generate the inventory register.</value>
                </title>
                <title>
                  <key>fa</key>
