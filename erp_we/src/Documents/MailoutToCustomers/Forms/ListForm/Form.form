    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentMailoutToCustomers.Ref,
	DocumentMailoutToCustomers.DeletionMark,
	DocumentMailoutToCustomers.Number,
	DocumentMailoutToCustomers.Date,
	DocumentMailoutToCustomers.Posted,
	DocumentMailoutToCustomers.MailingDate,
	DocumentMailoutToCustomers.GroupOfMailoutsAndNotifications,
	CASE
		WHEN DocumentMailoutToCustomers.DesignedForEmails
			THEN &amp;ForEmails_2
		ELSE &amp;ForSMS
	END AS Purpose,
	DocumentMailoutToCustomers.Status,
	DocumentMailoutToCustomers.FilterPresentation,
	DocumentMailoutToCustomers.UpdateDate,
	DocumentMailoutToCustomers.EmployeeResponsible,
	DocumentMailoutToCustomers.Subject,
	DocumentMailoutToCustomers.HasAttachments
FROM
	Document.MailoutToCustomers AS DocumentMailoutToCustomers</queryText>
