      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>EmployeeResponsible</dataPath>
        <field>EmployeeResponsible</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Comment</dataPath>
        <field>Comment</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
