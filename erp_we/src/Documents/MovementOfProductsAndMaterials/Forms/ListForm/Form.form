  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.BusinessOperation</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.EmployeeResponsible</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Status</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentMovementOfProductsAndMaterials.Ref,
	DocumentMovementOfProductsAndMaterials.DeletionMark,
	DocumentMovementOfProductsAndMaterials.Number,
	DocumentMovementOfProductsAndMaterials.Date,
	DocumentMovementOfProductsAndMaterials.Posted,
	DocumentMovementOfProductsAndMaterials.Organization,
	DocumentMovementOfProductsAndMaterials.Sender,
	DocumentMovementOfProductsAndMaterials.Recipient,
	DocumentMovementOfProductsAndMaterials.ReferenceOrder,
	DocumentMovementOfProductsAndMaterials.EmployeeResponsible,
	DocumentMovementOfProductsAndMaterials.Author,
	DocumentMovementOfProductsAndMaterials.Comment,
	DocumentMovementOfProductsAndMaterials.BusinessOperation,
	//++ Localization
	CAST(&quot;&quot; AS STRING(50)) AS StateOfGISMT,
	//-- Localization
	DocumentMovementOfProductsAndMaterials.Status,
	EDStates.EDIState,
	EDStates.StatusPresentation
FROM
	Document.MovementOfProductsAndMaterials AS DocumentMovementOfProductsAndMaterials
		LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
		ON EDStates.ObjectReference = DocumentMovementOfProductsAndMaterials.Ref
WHERE 
	NOT &amp;ToUseTheReceiverOrTheSender
	OR DocumentMovementOfProductsAndMaterials.Recipient = &amp;RecipientOrSender
	OR DocumentMovementOfProductsAndMaterials.Sender = &amp;RecipientOrSender</queryText>
      <mainTable>Document.MovementOfProductsAndMaterials</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Author</dataPath>
        <field>Author</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
