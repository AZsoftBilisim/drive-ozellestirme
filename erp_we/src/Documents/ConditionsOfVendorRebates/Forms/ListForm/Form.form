    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ConditionsDocuments.Ref AS Ref,
	ConditionsDocuments.DeletionMark AS DeletionMark,
	ConditionsDocuments.Number AS Number,
	ConditionsDocuments.Date AS Date,
	ConditionsDocuments.Posted AS Posted,
	ConditionsDocuments.Status AS Status,
	ConditionsDocuments.Organization AS Organization,
	ConditionsDocuments.ValidOnDate AS ValidOnDate,
	CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.ValidTo
		ELSE ConditionsDocuments.ValidTo
	END AS ValidTo,
	CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.LongDesc
		ELSE ConditionsDocuments.LongDesc
	END AS LongDesc,
	CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.DateOfRemainingGoods
		ELSE ConditionsDocuments.DateOfRemainingGoods
	END AS DateOfRemainingGoods,
	ConditionsDocuments.RebateKind AS RebateKind,
	ConditionsDocuments.BonusType AS BonusType,
	ConditionsDocuments.WithoutCalculation AS WithoutCalculation,
	ConditionsDocuments.AccrueImmediately AS AccrueImmediately,
	ConditionsDocuments.RestrictAccrualOverPlan AS RestrictAccrualOverPlan,
	ConditionsDocuments.Currency AS Currency,
	ConditionsDocuments.ConditionFrequency AS ConditionFrequency,
	ConditionsDocuments.AccrualFrequency AS AccrualFrequency,
	ConditionsDocuments.SumPlan AS SumPlan,
	ConditionsDocuments.BonusPercent AS BonusPercent,
	ConditionsDocuments.FilterParties AS FilterParties,
	ConditionsDocuments.FilterOfProducts_ AS FilterOfProducts_,
	CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.EmployeeResponsible
		ELSE ConditionsDocuments.EmployeeResponsible
	END AS EmployeeResponsible,
	ConditionsDocuments.Comment AS Comment,
	ConditionsDocuments.Patch AS Patch,
	ConditionsDocuments.ReversedDocument AS ReversedDocument,
	ConditionsDocuments.CorrectedDocument AS CorrectedDocument,
	ConditionsDocuments.CustomerCounterparties.*,
	ConditionsDocuments.ClientsCounterpartiesTIN.*,
	ConditionsDocuments.Goods.*,
	ConditionsDocuments.GoodsSegments.*,
	ConditionsDocuments.AdditionalAttributes.*,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
{SELECT
	HasFiles}
FROM
	Document.ConditionsOfVendorRebates AS ConditionsDocuments
		{LEFT JOIN InformationRegister.VendorRebatesConditions AS ConditionsActual
		ON ConditionsDocuments.Ref = ConditionsActual.TermDocument}
		{LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON ConditionsDocuments.Ref = FilesExist.ObjectWithFiles}
{WHERE
	(CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.ValidTo
		ELSE ConditionsDocuments.ValidTo
	END) AS ValidTo,
	(CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.DateOfRemainingGoods
		ELSE ConditionsDocuments.DateOfRemainingGoods
	END) AS DateOfRemainingGoods,
	(CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.LongDesc
		ELSE ConditionsDocuments.LongDesc
	END) AS LongDesc,
	(CASE
		WHEN &amp;CurrentEditions
		AND ConditionsDocuments.Posted
		AND ConditionsDocuments.Status = VALUE(Enum.RebatesDocumentStatuses.Approved)
			THEN ConditionsActual.EmployeeResponsible
		ELSE ConditionsDocuments.EmployeeResponsible
	END).* AS EmployeeResponsible}</queryText>
      <mainTable>Document.ConditionsOfVendorRebates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
