    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	ConditionsOfVendorRebates.Ref,
	ConditionsOfVendorRebates.DeletionMark,
	ConditionsOfVendorRebates.Number,
	ConditionsOfVendorRebates.Date,
	ConditionsOfVendorRebates.Posted,
	ConditionsOfVendorRebates.Status,
	ConditionsOfVendorRebates.Organization,
	ConditionsOfVendorRebates.ValidOnDate,
	ConditionsOfVendorRebates.ValidTo,
	ConditionsOfVendorRebates.Counterparty,
	ConditionsOfVendorRebates.Partner,
	ConditionsOfVendorRebates.Contract,
	ConditionsOfVendorRebates.Terms,
	ConditionsOfVendorRebates.WithoutCalculation,
	ConditionsOfVendorRebates.BonusType,
	ConditionsOfVendorRebates.AccrueImmediately,
	ConditionsOfVendorRebates.LongDesc,
	ConditionsOfVendorRebates.RebateKind,
	ConditionsOfVendorRebates.ConditionFrequency,
	ConditionsOfVendorRebates.AccrualFrequency,
	ConditionsOfVendorRebates.SumPlan,
	ConditionsOfVendorRebates.AmountBonus,
	ConditionsOfVendorRebates.BonusPercent,
	ConditionsOfVendorRebates.Currency,
	ConditionsOfVendorRebates.RestrictAccrualOverPlan,
	ConditionsOfVendorRebates.FilterParties,
	ConditionsOfVendorRebates.FilterOfProducts_,
	ConditionsOfVendorRebates.SelectionOfWarehouses_,
	ConditionsOfVendorRebates.DateOfRemainingGoods,
	ConditionsOfVendorRebates.EmployeeResponsible,
	ConditionsOfVendorRebates.Comment,
	ConditionsOfVendorRebates.Patch,
	ConditionsOfVendorRebates.ReversedDocument,
	ConditionsOfVendorRebates.CorrectedDocument,
	ConditionsOfVendorRebates.ChainID,
	ConditionsOfVendorRebates.ModeMultipleVendors,
	ConditionsOfVendorRebates.IncomingDocumentNumber,
	ConditionsOfVendorRebates.IncomingDocumentDate,
	ConditionsOfVendorRebates.Goods.*,
	ConditionsOfVendorRebates.GoodsSegments.*,
	ConditionsOfVendorRebates.CustomerCounterparties.*,
	ConditionsOfVendorRebates.ClientsCounterpartiesTIN.*,
	ConditionsOfVendorRebates.Warehouses.*,
	ConditionsOfVendorRebates.Vendors.*,
	ConditionsOfVendorRebates.AdditionalAttributes.*
FROM
	Document.ConditionsOfVendorRebates AS ConditionsOfVendorRebates
{WHERE
	ConditionsOfVendorRebates.Ref IN
		(SELECT
			VendorRebatesVendors.TermDocument AS TermDocument
		FROM
			InformationRegister.VendorRebatesVendors AS VendorRebatesVendors
		WHERE
			VendorRebatesVendors.Counterparty = &amp;Counterparty
			OR VendorRebatesVendors.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))}</queryText>
      <mainTable>Document.ConditionsOfVendorRebates</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
