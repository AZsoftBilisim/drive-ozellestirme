                <value xsi:type="core:ReferenceValue">
                  <value>Enum.FixedAssetValueRegistrationProcedure.EnumValue.IncludeInExpensesOnRecognition</value>
                </value>
              </choiceList>
              <choiceList>
                <presentation>
                  <key>en</key>
                  <value>Do not recognize, add to expenses</value>
