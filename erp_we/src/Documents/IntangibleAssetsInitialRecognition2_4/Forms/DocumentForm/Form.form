                <value xsi:type="core:ReferenceValue">
                  <value>Enum.FixedAssetValueRegistrationProcedure.EnumValue.AccrueDepreciationOrAmortization</value>
                </value>
              </choiceList>
              <choiceList>
                <presentation>
                  <key>en</key>
                  <value>Cost is not included in expenses</value>
                </presentation>
                <presentation>
                  <key>fa</key>
                  <value>بهای تمام‌شده در هزینه‌ها گنجانده نمی‌شود</value>
