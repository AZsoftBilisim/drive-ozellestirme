  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>CashAccountIssueNotes</name>
    <title>
      <key>en</key>
      <value>Outgoing payments — Cash account</value>
    </title>
    <title>
      <key>fa</key>
      <value>پرداخت‌های وجه — صندوق</value>
    </title>
    <title>
      <key>it</key>
      <value>Mandati di pagamento</value>
    </title>
    <title>
      <key>pl</key>
      <value>Dowody kasowe KW</value>
    </title>
    <title>
      <key>ru</key>
      <value>Расходные кассовые ордера</value>
    </title>
    <title>
      <key>tr</key>
      <value>Giden ödemeler - kasa hesabı</value>
    </title>
    <title>
      <key>vi</key>
      <value>Phiếu chi</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashAccountIssueNotes.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashAccountIssueNotes.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CAST(DocumentsRegistry.Ref AS Document.CashVoucher) AS Ref,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.Organization AS Organization,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.CashAccount
		ELSE DocumentData.CashAccount
	END AS CashAccount,
	DocumentsRegistry.Sum AS DocumentAmount,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.Issue
		ELSE DocumentData.Issue
	END AS Issue,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.Basis
		ELSE DocumentData.Basis
	END AS Basis,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.Application
		ELSE DocumentData.Application
	END AS Application,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.Currency
		ELSE DocumentData.Currency
	END AS Currency,
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
			THEN StornoData.Cashier
		ELSE DocumentData.Cashier
	END AS Cashier,
  DocumentData.Author AS Author,
	CASE
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.PaymentToVendor)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToCustomer)
			THEN DocumentsRegistry.Counterparty
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashDepositToBankAccount)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.BankAccount
					ELSE DocumentData.BankAccount
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashIssueAsLoanToEmployee)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.AdvanceHolder
					ELSE DocumentData.AdvanceHolder
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashPaymentToAnotherCompany)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToAnotherCompany)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.CashAccountRecipient
					ELSE DocumentData.CashAccountRecipient
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.CashIssueToCashRegister)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.CashRegister
					ELSE DocumentData.CashRegister
				END
		WHEN DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.SalaryPaymentViaCashAccount)
				OR DocumentsRegistry.BusinessOperation = VALUE(Enum.BusinessTransactions.SalaryPaymentToEmployee)
			THEN
				CASE
					WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry) 
						THEN StornoData.AdvanceHolder
					ELSE DocumentData.AdvanceHolder
				END
		ELSE DocumentsRegistry.Counterparty
	END AS Dimension,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistry.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistry.ReversedDocument
	END AS ReversedCorrectedDocument,
		CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties,
  EDStates.EDIState AS StateOfEdVersion, 
  EDStates.StatusPresentation AS StatusPresentation
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
	LEFT JOIN Document.CashVoucher AS DocumentData
		ON DocumentsRegistry.Ref = DocumentData.Ref
	LEFT JOIN Document.CashVoucher AS StornoData
		ON DocumentsRegistry.ReversedDocument = StornoData.Ref
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
		ON DocumentsRegistry.Ref = DocumentsWithCounterpartyCheckErrors.Document
			AND (&amp;UsingOfCheckIsAnOption)}
  LEFT JOIN InformationRegister.StatesByEDIAccountingObjects AS EDStates
	  ON (EDStates.ObjectReference = DocumentsRegistry.Ref)
WHERE
	DocumentsRegistry.RefType = &amp;RefType
	AND NOT DocumentsRegistry.AdditionalRecord
{WHERE
	CAST(DocumentsRegistry.Ref AS Document.CashVoucher).* AS Ref,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
