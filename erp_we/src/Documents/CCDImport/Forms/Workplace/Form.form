  <attributes>
    <name>ToRegister</name>
    <title>
      <key>en</key>
      <value>To register</value>
    </title>
    <title>
      <key>fa</key>
      <value>برای ثبت</value>
    </title>
    <title>
      <key>it</key>
      <value>In formalizzazione</value>
    </title>
    <title>
      <key>pl</key>
      <value>Do zarejestrowania</value>
    </title>
    <title>
      <key>ru</key>
      <value>К оформлению</value>
    </title>
    <title>
      <key>tr</key>
      <value>Düzenlenecek</value>
    </title>
    <title>
      <key>vi</key>
      <value>Cần lập bảng kê</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.DocumentInflow</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.Vendor</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ToRegister.VendorSCounterparty</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT ALLOWED DISTINCT
	ForThePeriodOverridable.DocumentInflow AS DocumentInflow,
	ForThePeriodOverridable.Vendor AS Vendor,
	ForThePeriodOverridable.Organization AS Organization,
	ISNULL(VendorInvoiceOverridable.Counterparty, VALUE(Catalog.Counterparties.EmptyRef)) AS VendorSCounterparty,
	ForThePeriodOverridable.DocumentInflow AS Ref	
FROM
	AccumulationRegister.GoodsForRegistrationOfImportDocuments.Turnovers(&amp;StartDate, &amp;EndDate, , ImportDocumentType = &amp;IDCustomsDeclarationImport) AS ForThePeriodOverridable
		INNER JOIN AccumulationRegister.GoodsForRegistrationOfImportDocuments.Balance(, ) AS ForNowOverridable
		ON ForThePeriodOverridable.ItemsLocationAttributes = ForNowOverridable.ItemsLocationAttributes
			AND ForThePeriodOverridable.Vendor = ForNowOverridable.Vendor
			AND ForThePeriodOverridable.Organization = ForNowOverridable.Organization
			AND ForThePeriodOverridable.InventoryOwnerAttribute = ForNowOverridable.InventoryOwnerAttribute
			AND ForThePeriodOverridable.DocumentInflow = ForNowOverridable.DocumentInflow
			AND ForThePeriodOverridable.ImportDocumentType = ForNowOverridable.ImportDocumentType			
		LEFT JOIN Document.VendorInvoice AS VendorInvoiceOverridable
		ON ForThePeriodOverridable.DocumentInflow = VendorInvoiceOverridable.Ref
WHERE
	ForNowOverridable.CountBalance > 0
	AND ForThePeriodOverridable.CountTurnover > 0</queryText>
      <mainTable>Document.VendorInvoice</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
