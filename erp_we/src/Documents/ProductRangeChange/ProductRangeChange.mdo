    <name>LoadingFromFile</name>
    <synonym>
      <key>en</key>
      <value>Import from file</value>
    </synonym>
    <synonym>
      <key>fa</key>
      <value>ورود از فایل</value>
    </synonym>
    <synonym>
      <key>it</key>
      <value>Download dal file</value>
    </synonym>
    <synonym>
      <key>pl</key>
      <value>Pobranie z pliku</value>
    </synonym>
    <synonym>
