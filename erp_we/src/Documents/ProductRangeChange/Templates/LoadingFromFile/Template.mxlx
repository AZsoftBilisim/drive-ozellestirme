					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Price type</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>نوع قیمت</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Tipo di prezzo</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Rodzaj ceny</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Вид цены</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Fiyat türü</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Dạng giá</v8:content>
						</v8:item>
					</tl>
					<detailParameter>PriceKind</detailParameter>
					<note>
						<drawingType>Comment</drawingType>
						<id>0</id>
						<formatIndex>9</formatIndex>
						<text>
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Price type of items sale.
Type: String (50 characters)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>نوع قیمت فروش اقلام.
نوع: رشته (50 کاراکتر)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Tipo di prezzo della vendita degli articoli. 
Tipo: Riga (50 simboli)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Rodzaj ceny sprzedaży wykazu towarów.
Typ:Wiersz (50 symboli)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Вид цены продажи номенклатуры.
Тип: Строка (50 символов)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Öğe satış fiyatı türü.
Tip: Satır (50 karakter)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Dạng giá bán mặt hàng.
Kiểu: Xâu ký tự (50 ký tự)</v8:content>
							</v8:item>
						</text>
