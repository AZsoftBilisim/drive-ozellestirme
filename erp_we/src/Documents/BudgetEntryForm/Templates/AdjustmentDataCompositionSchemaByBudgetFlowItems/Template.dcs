					<v8:content>Action</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Action</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:EnumRef.TypesOfBudgetEntryFormActions</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	TurnoversAndTurnovers.PlanningPeriod AS PlanningPeriod,
	TurnoversAndTurnovers.BudgetFlowItem AS BudgetFlowItem,
	TurnoversAndTurnovers.Currency AS Currency,
	TurnoversAndTurnovers.Dimension1 AS Dimension1,
	TurnoversAndTurnovers.Dimension2 AS Dimension2,
	TurnoversAndTurnovers.Dimension3 AS Dimension3,
	TurnoversAndTurnovers.Dimension4 AS Dimension4,
	TurnoversAndTurnovers.Dimension5 AS Dimension5,
	TurnoversAndTurnovers.Dimension6 AS Dimension6,
	TurnoversAndTurnovers.AmountInCurrencyTurnover AS AmountInCurrency,
	TurnoversAndTurnovers.ScenarioAmountTurnover AS Sum,
	TurnoversAndTurnovers.CountTurnover AS Count
INTO TurnoverBeforeAdjustment
FROM
	AccumulationRegister.BudgetTurnovers.Turnovers(
			{(&amp;DateEmpty)},
			{(DATEADD(&amp;StartDate, SECOND, -1))},
			,
			PlanningPeriod BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
				AND BudgetFlowItem IN (&amp;ArticlesAndTargets)
				AND Scenario = &amp;Scenario
				AND Organization = &amp;Organization
				AND Department = &amp;Department
				AND CASE
					WHEN &amp;Dimension1 = UNDEFINED
						THEN TRUE
					ELSE Dimension1 = &amp;Dimension1
				END
				AND CASE
					WHEN &amp;Dimension2 = UNDEFINED
						THEN TRUE
					ELSE Dimension2 = &amp;Dimension2
				END
				AND CASE
					WHEN &amp;Dimension3 = UNDEFINED
						THEN TRUE
					ELSE Dimension3 = &amp;Dimension3
				END
				AND CASE
					WHEN &amp;Dimension4 = UNDEFINED
						THEN TRUE
					ELSE Dimension4 = &amp;Dimension4
				END
				AND CASE
					WHEN &amp;Dimension5 = UNDEFINED
						THEN TRUE
					ELSE Dimension5 = &amp;Dimension5
				END
				AND CASE
					WHEN &amp;Dimension6 = UNDEFINED
						THEN TRUE
					ELSE Dimension6 = &amp;Dimension6
				END) AS TurnoversAndTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BudgetTurnovers.PlanningPeriod AS PlanningPeriod,
	BudgetTurnovers.BudgetFlowItem AS BudgetFlowItem,
	BudgetTurnovers.Currency AS Currency,
	BudgetTurnovers.Dimension1 AS Dimension1,
	BudgetTurnovers.Dimension2 AS Dimension2,
	BudgetTurnovers.Dimension3 AS Dimension3,
	BudgetTurnovers.Dimension4 AS Dimension4,
	BudgetTurnovers.Dimension5 AS Dimension5,
	BudgetTurnovers.Dimension6 AS Dimension6,
	BudgetTurnovers.AmountInCurrency AS AmountInCurrency,
	BudgetTurnovers.ScenarioAmount AS Sum,
	BudgetTurnovers.Count AS Count,
	BudgetTurnovers.Recorder AS Recorder,
	BudgetTurnovers.Period AS Period,
	BudgetTurnovers.PointInTime AS PointInTime
INTO TurnoverOfAdjustments
FROM
	AccumulationRegister.BudgetTurnovers AS BudgetTurnovers
WHERE
	BudgetTurnovers.PlanningPeriod BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
	AND BudgetTurnovers.BudgetFlowItem IN(&amp;ArticlesAndTargets)
	AND BudgetTurnovers.Scenario = &amp;Scenario
	AND BudgetTurnovers.Organization = &amp;Organization
	AND BudgetTurnovers.Department = &amp;Department
	AND CASE
			WHEN &amp;Dimension1 = UNDEFINED
				THEN TRUE
			ELSE BudgetTurnovers.Dimension1 = &amp;Dimension1
		END
	AND CASE
			WHEN &amp;Dimension2 = UNDEFINED
				THEN TRUE
			ELSE BudgetTurnovers.Dimension2 = &amp;Dimension2
		END
	AND CASE
			WHEN &amp;Dimension3 = UNDEFINED
				THEN TRUE
			ELSE BudgetTurnovers.Dimension3 = &amp;Dimension3
		END
	AND CASE
			WHEN &amp;Dimension4 = UNDEFINED
				THEN TRUE
			ELSE BudgetTurnovers.Dimension4 = &amp;Dimension4
		END
	AND CASE
			WHEN &amp;Dimension5 = UNDEFINED
				THEN TRUE
			ELSE BudgetTurnovers.Dimension5 = &amp;Dimension5
		END
	AND CASE
			WHEN &amp;Dimension6 = UNDEFINED
				THEN TRUE
			ELSE BudgetTurnovers.Dimension6 = &amp;Dimension6
		END
{WHERE
	(BudgetTurnovers.Period BETWEEN &amp;StartDate AND ENDOFPERIOD(&amp;EndDate, DAY))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TurnoverOfCurrentAdjustment.PlanningPeriod AS PlanningPeriod,
	TurnoverOfCurrentAdjustment.BudgetFlowItem AS BudgetFlowItem,
	TurnoverOfCurrentAdjustment.Currency AS Currency,
	TurnoverOfCurrentAdjustment.Dimension1 AS Dimension1,
	TurnoverOfCurrentAdjustment.Dimension2 AS Dimension2,
	TurnoverOfCurrentAdjustment.Dimension3 AS Dimension3,
	TurnoverOfCurrentAdjustment.Dimension4 AS Dimension4,
	TurnoverOfCurrentAdjustment.Dimension5 AS Dimension5,
	TurnoverOfCurrentAdjustment.Dimension6 AS Dimension6,
	TurnoverOfCurrentAdjustment.Recorder AS Recorder,
	TurnoverOfCurrentAdjustment.Period AS Period,
	MAX(TurnoverOfCurrentAdjustment.AmountInCurrency) + SUM(ISNULL(TurnoverOfPreviousAdjustments.AmountInCurrency, 0)) AS AmountInCurrencyClosingBalance,
	MAX(TurnoverOfCurrentAdjustment.Sum) + SUM(ISNULL(TurnoverOfPreviousAdjustments.Sum, 0)) AS SumClosingBalance,
	MAX(TurnoverOfCurrentAdjustment.Count) + SUM(ISNULL(TurnoverOfPreviousAdjustments.Count, 0)) AS CountClosingBalance,
	SUM(ISNULL(TurnoverOfPreviousAdjustments.AmountInCurrency, 0)) AS AmountInCurrencyOpeningBalance,
	SUM(ISNULL(TurnoverOfPreviousAdjustments.Sum, 0)) AS SumOpeningBalance,
	SUM(ISNULL(TurnoverOfPreviousAdjustments.Count, 0)) AS CountOpeningBalance,
	MAX(TurnoverOfCurrentAdjustment.AmountInCurrency) AS AmountInCurrencyTurnover,
	MAX(TurnoverOfCurrentAdjustment.Sum) AS SumTurnover,
	MAX(TurnoverOfCurrentAdjustment.Count) AS CountTurnover
INTO TurnoverDuringPeriodOfAdjustments
FROM
	TurnoverOfAdjustments AS TurnoverOfCurrentAdjustment
		LEFT JOIN TurnoverOfAdjustments AS TurnoverOfPreviousAdjustments
		ON TurnoverOfCurrentAdjustment.PlanningPeriod = TurnoverOfPreviousAdjustments.PlanningPeriod
			AND TurnoverOfCurrentAdjustment.BudgetFlowItem = TurnoverOfPreviousAdjustments.BudgetFlowItem
			AND TurnoverOfCurrentAdjustment.Currency = TurnoverOfPreviousAdjustments.Currency
			AND TurnoverOfCurrentAdjustment.Dimension1 = TurnoverOfPreviousAdjustments.Dimension1
			AND TurnoverOfCurrentAdjustment.Dimension2 = TurnoverOfPreviousAdjustments.Dimension2
			AND TurnoverOfCurrentAdjustment.Dimension3 = TurnoverOfPreviousAdjustments.Dimension3
			AND TurnoverOfCurrentAdjustment.Dimension4 = TurnoverOfPreviousAdjustments.Dimension4
			AND TurnoverOfCurrentAdjustment.Dimension5 = TurnoverOfPreviousAdjustments.Dimension5
			AND TurnoverOfCurrentAdjustment.Dimension6 = TurnoverOfPreviousAdjustments.Dimension6
			AND TurnoverOfCurrentAdjustment.PointInTime &gt; TurnoverOfPreviousAdjustments.PointInTime

GROUP BY
	TurnoverOfCurrentAdjustment.PlanningPeriod,
	TurnoverOfCurrentAdjustment.BudgetFlowItem,
	TurnoverOfCurrentAdjustment.Currency,
	TurnoverOfCurrentAdjustment.Dimension1,
	TurnoverOfCurrentAdjustment.Dimension2,
	TurnoverOfCurrentAdjustment.Dimension3,
	TurnoverOfCurrentAdjustment.Dimension4,
	TurnoverOfCurrentAdjustment.Dimension5,
	TurnoverOfCurrentAdjustment.Dimension6,
	TurnoverOfCurrentAdjustment.Recorder,
	TurnoverOfCurrentAdjustment.Period
;

////////////////////////////////////////////////////////////////////////////////
DROP TurnoverOfAdjustments
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TurnoverDuringPeriodOfAdjustments.PlanningPeriod AS PlanningPeriod,
	TurnoverDuringPeriodOfAdjustments.BudgetFlowItem AS BudgetFlowItem,
	TurnoverDuringPeriodOfAdjustments.Currency AS Currency,
	TurnoverDuringPeriodOfAdjustments.Dimension1 AS Dimension1,
	TurnoverDuringPeriodOfAdjustments.Dimension2 AS Dimension2,
	TurnoverDuringPeriodOfAdjustments.Dimension3 AS Dimension3,
	TurnoverDuringPeriodOfAdjustments.Dimension4 AS Dimension4,
	TurnoverDuringPeriodOfAdjustments.Dimension5 AS Dimension5,
	TurnoverDuringPeriodOfAdjustments.Dimension6 AS Dimension6,
	TurnoverDuringPeriodOfAdjustments.Recorder AS Recorder,
	CAST(TurnoverDuringPeriodOfAdjustments.Recorder AS Document.BudgetEntryForm).Action AS Action,
	TurnoverDuringPeriodOfAdjustments.Period AS Period,
	TurnoverDuringPeriodOfAdjustments.AmountInCurrencyOpeningBalance + ISNULL(TurnoverBeforeAdjustment.AmountInCurrency, 0) AS AmountInCurrencyOpeningBalance,
	TurnoverDuringPeriodOfAdjustments.SumOpeningBalance + ISNULL(TurnoverBeforeAdjustment.Sum, 0) AS SumOpeningBalance,
	TurnoverDuringPeriodOfAdjustments.CountOpeningBalance + ISNULL(TurnoverBeforeAdjustment.Count, 0) AS CountOpeningBalance,
	TurnoverDuringPeriodOfAdjustments.AmountInCurrencyTurnover AS AmountInCurrencyTurnover,
	TurnoverDuringPeriodOfAdjustments.SumTurnover AS SumTurnover,
	TurnoverDuringPeriodOfAdjustments.CountTurnover AS CountTurnover,
	TurnoverDuringPeriodOfAdjustments.AmountInCurrencyClosingBalance + ISNULL(TurnoverBeforeAdjustment.AmountInCurrency, 0) AS AmountInCurrencyClosingBalance,
	TurnoverDuringPeriodOfAdjustments.SumClosingBalance + ISNULL(TurnoverBeforeAdjustment.Sum, 0) AS SumClosingBalance,
	TurnoverDuringPeriodOfAdjustments.CountClosingBalance + ISNULL(TurnoverBeforeAdjustment.Count, 0) AS CountClosingBalance
FROM
	TurnoverDuringPeriodOfAdjustments AS TurnoverDuringPeriodOfAdjustments
		LEFT JOIN TurnoverBeforeAdjustment AS TurnoverBeforeAdjustment
		ON TurnoverDuringPeriodOfAdjustments.PlanningPeriod = TurnoverBeforeAdjustment.PlanningPeriod
			AND TurnoverDuringPeriodOfAdjustments.BudgetFlowItem = TurnoverBeforeAdjustment.BudgetFlowItem
			AND TurnoverDuringPeriodOfAdjustments.Currency = TurnoverBeforeAdjustment.Currency
			AND TurnoverDuringPeriodOfAdjustments.Dimension1 = TurnoverBeforeAdjustment.Dimension1
			AND TurnoverDuringPeriodOfAdjustments.Dimension2 = TurnoverBeforeAdjustment.Dimension2
			AND TurnoverDuringPeriodOfAdjustments.Dimension3 = TurnoverBeforeAdjustment.Dimension3
			AND TurnoverDuringPeriodOfAdjustments.Dimension4 = TurnoverBeforeAdjustment.Dimension4
			AND TurnoverDuringPeriodOfAdjustments.Dimension5 = TurnoverBeforeAdjustment.Dimension5
			AND TurnoverDuringPeriodOfAdjustments.Dimension6 = TurnoverBeforeAdjustment.Dimension6</query>
	</dataSet>
	<calculatedField>
		<dataPath>AmountInCurrencyPercentage</dataPath>
		<expression>(Case When AmountInCurrencyTurnover = 0 Then 0 When AmountInCurrencyOpeningBalance = 0 Then 1 Else AmountInCurrencyTurnover / AmountInCurrencyOpeningBalance End) * 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Amount in currency, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مبلغ ارزی، درصد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма в валюте, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Para birimi cinsinden tutar, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Số tiền theo tiền tệ, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Amount in currency, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Amount in currency, %</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>NFD=2</v8:content>
