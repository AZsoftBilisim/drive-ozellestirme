    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BudgetEntryForm.Ref,
	BudgetEntryForm.DeletionMark,
	BudgetEntryForm.Number,
	BudgetEntryForm.Date,
	BudgetEntryForm.Posted,
	BudgetEntryForm.BudgetingModel,
	BudgetEntryForm.Organization,
	BudgetEntryForm.Department,
	BudgetEntryForm.Scenario,
	BudgetEntryForm.Action,
	BudgetEntryForm.BeginOfPeriod,
	BudgetEntryForm.PeriodEnding,
	BudgetEntryForm.BudgetProfile,
	BudgetEntryForm.EmployeeResponsible,
	BudgetEntryForm.Comment,
	BudgetEntryForm.Status,
	BudgetEntryForm.PointInTime,
	BudgetEntryForm.Dimension1,
	BudgetEntryForm.Dimension2,
	BudgetEntryForm.Dimension3,
	BudgetEntryForm.Dimension4,
	BudgetEntryForm.Dimension5,
	BudgetEntryForm.Dimension6,
	CASE &amp;MandatoryAnalytics1
		WHEN TypesOfBudgetsAnalyticsCaps1.DimensionKind
			THEN BudgetEntryForm.Dimension1
		WHEN TypesOfBudgetsAnalyticsCaps2.DimensionKind
			THEN BudgetEntryForm.Dimension2
		WHEN TypesOfBudgetsAnalyticsCaps3.DimensionKind
			THEN BudgetEntryForm.Dimension3
		WHEN TypesOfBudgetsAnalyticsCaps4.DimensionKind
			THEN BudgetEntryForm.Dimension4
		WHEN TypesOfBudgetsAnalyticsCaps5.DimensionKind
			THEN BudgetEntryForm.Dimension5
		WHEN TypesOfBudgetsAnalyticsCaps6.DimensionKind
			THEN BudgetEntryForm.Dimension6
	END AS MandatoryAnalytics1,
	CASE &amp;MandatoryAnalytics2
		WHEN TypesOfBudgetsAnalyticsCaps1.DimensionKind
			THEN BudgetEntryForm.Dimension1
		WHEN TypesOfBudgetsAnalyticsCaps2.DimensionKind
			THEN BudgetEntryForm.Dimension2
		WHEN TypesOfBudgetsAnalyticsCaps3.DimensionKind
			THEN BudgetEntryForm.Dimension3
		WHEN TypesOfBudgetsAnalyticsCaps4.DimensionKind
			THEN BudgetEntryForm.Dimension4
		WHEN TypesOfBudgetsAnalyticsCaps5.DimensionKind
			THEN BudgetEntryForm.Dimension5
		WHEN TypesOfBudgetsAnalyticsCaps6.DimensionKind
			THEN BudgetEntryForm.Dimension6
	END AS MandatoryAnalytics2,
	CASE &amp;MandatoryAnalytics3
		WHEN TypesOfBudgetsAnalyticsCaps1.DimensionKind
			THEN BudgetEntryForm.Dimension1
		WHEN TypesOfBudgetsAnalyticsCaps2.DimensionKind
			THEN BudgetEntryForm.Dimension2
		WHEN TypesOfBudgetsAnalyticsCaps3.DimensionKind
			THEN BudgetEntryForm.Dimension3
		WHEN TypesOfBudgetsAnalyticsCaps4.DimensionKind
			THEN BudgetEntryForm.Dimension4
		WHEN TypesOfBudgetsAnalyticsCaps5.DimensionKind
			THEN BudgetEntryForm.Dimension5
		WHEN TypesOfBudgetsAnalyticsCaps6.DimensionKind
			THEN BudgetEntryForm.Dimension6
	END AS MandatoryAnalytics3,
	CASE &amp;MandatoryAnalytics4
		WHEN TypesOfBudgetsAnalyticsCaps1.DimensionKind
			THEN BudgetEntryForm.Dimension1
		WHEN TypesOfBudgetsAnalyticsCaps2.DimensionKind
			THEN BudgetEntryForm.Dimension2
		WHEN TypesOfBudgetsAnalyticsCaps3.DimensionKind
			THEN BudgetEntryForm.Dimension3
		WHEN TypesOfBudgetsAnalyticsCaps4.DimensionKind
			THEN BudgetEntryForm.Dimension4
		WHEN TypesOfBudgetsAnalyticsCaps5.DimensionKind
			THEN BudgetEntryForm.Dimension5
		WHEN TypesOfBudgetsAnalyticsCaps6.DimensionKind
			THEN BudgetEntryForm.Dimension6
	END AS MandatoryAnalytics4,
	CASE &amp;MandatoryAnalytics5
		WHEN TypesOfBudgetsAnalyticsCaps1.DimensionKind
			THEN BudgetEntryForm.Dimension1
		WHEN TypesOfBudgetsAnalyticsCaps2.DimensionKind
			THEN BudgetEntryForm.Dimension2
		WHEN TypesOfBudgetsAnalyticsCaps3.DimensionKind
			THEN BudgetEntryForm.Dimension3
		WHEN TypesOfBudgetsAnalyticsCaps4.DimensionKind
			THEN BudgetEntryForm.Dimension4
		WHEN TypesOfBudgetsAnalyticsCaps5.DimensionKind
			THEN BudgetEntryForm.Dimension5
		WHEN TypesOfBudgetsAnalyticsCaps6.DimensionKind
			THEN BudgetEntryForm.Dimension6
	END AS MandatoryAnalytics5,
	CASE &amp;MandatoryAnalytics6
		WHEN TypesOfBudgetsAnalyticsCaps1.DimensionKind
			THEN BudgetEntryForm.Dimension1
		WHEN TypesOfBudgetsAnalyticsCaps2.DimensionKind
			THEN BudgetEntryForm.Dimension2
		WHEN TypesOfBudgetsAnalyticsCaps3.DimensionKind
			THEN BudgetEntryForm.Dimension3
		WHEN TypesOfBudgetsAnalyticsCaps4.DimensionKind
			THEN BudgetEntryForm.Dimension4
		WHEN TypesOfBudgetsAnalyticsCaps5.DimensionKind
			THEN BudgetEntryForm.Dimension5
		WHEN TypesOfBudgetsAnalyticsCaps6.DimensionKind
			THEN BudgetEntryForm.Dimension6
	END AS MandatoryAnalytics6
FROM
	Document.BudgetEntryForm AS BudgetEntryForm
		LEFT JOIN Catalog.BudgetProfiles.HeaderDimensions AS TypesOfBudgetsAnalyticsCaps1
		ON BudgetEntryForm.BudgetProfile = TypesOfBudgetsAnalyticsCaps1.Ref
			AND (TypesOfBudgetsAnalyticsCaps1.LineNumber = 1)
		LEFT JOIN Catalog.BudgetProfiles.HeaderDimensions AS TypesOfBudgetsAnalyticsCaps2
		ON BudgetEntryForm.BudgetProfile = TypesOfBudgetsAnalyticsCaps2.Ref
			AND (TypesOfBudgetsAnalyticsCaps2.LineNumber = 2)
		LEFT JOIN Catalog.BudgetProfiles.HeaderDimensions AS TypesOfBudgetsAnalyticsCaps3
		ON BudgetEntryForm.BudgetProfile = TypesOfBudgetsAnalyticsCaps3.Ref
			AND (TypesOfBudgetsAnalyticsCaps3.LineNumber = 3)
		LEFT JOIN Catalog.BudgetProfiles.HeaderDimensions AS TypesOfBudgetsAnalyticsCaps4
		ON BudgetEntryForm.BudgetProfile = TypesOfBudgetsAnalyticsCaps4.Ref
			AND (TypesOfBudgetsAnalyticsCaps4.LineNumber = 4)
		LEFT JOIN Catalog.BudgetProfiles.HeaderDimensions AS TypesOfBudgetsAnalyticsCaps5
		ON BudgetEntryForm.BudgetProfile = TypesOfBudgetsAnalyticsCaps5.Ref
			AND (TypesOfBudgetsAnalyticsCaps5.LineNumber = 5)
		LEFT JOIN Catalog.BudgetProfiles.HeaderDimensions AS TypesOfBudgetsAnalyticsCaps6
		ON BudgetEntryForm.BudgetProfile = TypesOfBudgetsAnalyticsCaps6.Ref
			AND (TypesOfBudgetsAnalyticsCaps6.LineNumber = 6)
WHERE
	(&amp;BeginOfPeriod >= BudgetEntryForm.BeginOfPeriod
				AND ENDOFPERIOD(&amp;PeriodEnding, DAY) &lt;= BudgetEntryForm.PeriodEnding
				AND &amp;BeginOfPeriod &lt;> &amp;DateEmpty
				AND &amp;PeriodEnding &lt;> &amp;DateEmpty
			OR BudgetEntryForm.BeginOfPeriod BETWEEN &amp;BeginOfPeriod AND ENDOFPERIOD(&amp;PeriodEnding, DAY)
			OR BudgetEntryForm.PeriodEnding BETWEEN &amp;BeginOfPeriod AND ENDOFPERIOD(&amp;PeriodEnding, DAY)
			OR BudgetEntryForm.PeriodEnding >= &amp;BeginOfPeriod
				AND &amp;PeriodEnding = &amp;DateEmpty)</queryText>
      <mainTable>Document.BudgetEntryForm</mainTable>
