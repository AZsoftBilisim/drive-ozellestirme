    <toolTip>
      <key>tr</key>
      <value>Listedeki tüm seçili siparişler için durumu &quot;Kapalı&quot; olarak ayarla.</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đặt trạng thái &quot;Đã đóng&quot; cho tất cả đơn hàng đã chọn trong danh sách đơn hàng.</value>
