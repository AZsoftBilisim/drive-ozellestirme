    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentMaterialProviderOrder2_5.Ref,
	DocumentMaterialProviderOrder2_5.DeletionMark,
	DocumentMaterialProviderOrder2_5.Number,
	DocumentMaterialProviderOrder2_5.Date,
	DocumentMaterialProviderOrder2_5.Posted,
	DocumentMaterialProviderOrder2_5.Partner,
	DocumentMaterialProviderOrder2_5.Counterparty,
	DocumentMaterialProviderOrder2_5.Organization,
	DocumentMaterialProviderOrder2_5.SalesOpportunity,
	DocumentMaterialProviderOrder2_5.Warehouse,
	DocumentMaterialProviderOrder2_5.Currency,
	DocumentMaterialProviderOrder2_5.Manager,
	DocumentMaterialProviderOrder2_5.PriceIncludesVAT,
	DocumentMaterialProviderOrder2_5.Status,
	DocumentMaterialProviderOrder2_5.DocumentAmount,
	DocumentMaterialProviderOrder2_5.DepositValue,
	DocumentMaterialProviderOrder2_5.AdditionalInformation,
	DocumentMaterialProviderOrder2_5.ProductsMaximumRowCode,
	DocumentMaterialProviderOrder2_5.VATTaxation,
	DocumentMaterialProviderOrder2_5.BusinessOperation,
	DocumentMaterialProviderOrder2_5.DateOfShipment,
	DocumentMaterialProviderOrder2_5.DeliveryAddress,
	DocumentMaterialProviderOrder2_5.NotShipInInstallments,
	DocumentMaterialProviderOrder2_5.PaymentMethod,
	DocumentMaterialProviderOrder2_5.BankAccount,
	DocumentMaterialProviderOrder2_5.CashAccount,
	DocumentMaterialProviderOrder2_5.PaymentSchedule,
	DocumentMaterialProviderOrder2_5.AmountPrepaymentBeforeGoodsIssue,
	DocumentMaterialProviderOrder2_5.AmountOfPrepaymentBeforeShipment,
	DocumentMaterialProviderOrder2_5.MaximumRowCodeMaterials,
	DocumentMaterialProviderOrder2_5.Comment,
	DocumentMaterialProviderOrder2_5.Shipper,
	DocumentMaterialProviderOrder2_5.GoodsRecipient,
	DocumentMaterialProviderOrder2_5.ShipperBankAccount,
	DocumentMaterialProviderOrder2_5.GoodsRecipientBankAccount,
	DocumentMaterialProviderOrder2_5.FinancialAccountingGroup,
	DocumentMaterialProviderOrder2_5.Contract,
	DocumentMaterialProviderOrder2_5.DateOfReceipt,
	DocumentMaterialProviderOrder2_5.OneDateReceipt,
	DocumentMaterialProviderOrder2_5.ARAPObjectSettings,
	DocumentMaterialProviderOrder2_5.DeliveryMethod,
	DocumentMaterialProviderOrder2_5.CarrierPartner,
	DocumentMaterialProviderOrder2_5.DeliveryZone,
	DocumentMaterialProviderOrder2_5.DeliveryTimeFrom,
	DocumentMaterialProviderOrder2_5.DeliveryTimeTo,
	DocumentMaterialProviderOrder2_5.DeliveryAddressOfCarrier,
	DocumentMaterialProviderOrder2_5.DeliveryAddressFieldValues,
	DocumentMaterialProviderOrder2_5.DeliveryAddressOfCarrierFieldValues,
	DocumentMaterialProviderOrder2_5.AdditionalDeliveryInformation,
	DocumentMaterialProviderOrder2_5.Purpose,
	DocumentMaterialProviderOrder2_5.Department,
	DocumentMaterialProviderOrder2_5.ContactPerson,
	DocumentMaterialProviderOrder2_5.Director,
	DocumentMaterialProviderOrder2_5.ChiefAccountant,
	DocumentMaterialProviderOrder2_5.NumberAccordingToPartnerData,
	DocumentMaterialProviderOrder2_5.DateAccordingToInformationFromPartner,
	DocumentMaterialProviderOrder2_5.CounterpartyBankAccount,
	DocumentMaterialProviderOrder2_5.PaymentPurposes,
	DocumentMaterialProviderOrder2_5.WarehouseForReceipt,
	DocumentMaterialProviderOrder2_5.Author,
	DocumentMaterialProviderOrder2_5.VATRate,
	DocumentMaterialProviderOrder2_5.ProcessingService,
	DocumentMaterialProviderOrder2_5.Basis,
	DocumentMaterialProviderOrder2_5.Priority,
	DocumentMaterialProviderOrder2_5.PaymentID,
	DocumentMaterialProviderOrder2_5.PointInTime,
	
	CASE
		WHEN (NOT DocumentMaterialProviderOrder2_5.Posted)
			THEN VALUE(Enum.SalesOrderStates.EmptyRef)
		ELSE
			ISNULL(SalesOrderStates.State, VALUE(Enum.SalesOrderStates.Closed)) 
	END AS State,
	CASE
		WHEN (NOT DocumentMaterialProviderOrder2_5.Posted)
			THEN FALSE
		WHEN SalesOrderStates.EventDate &lt;> DATETIME(1, 1, 1)
				AND &amp;UpdateDate > SalesOrderStates.EventDate 
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	CASE
		WHEN DocumentMaterialProviderOrder2_5.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentMaterialProviderOrder2_5.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,
	ISNULL(SalesOrderStates.PayAmount,0) AS PayAmount,
	ISNULL(SalesOrderStates.PayPercentage,0) AS PayPercentage,
	ISNULL(SalesOrderStates.AmountByShipment,0) AS AmountByShipment,
	ISNULL(SalesOrderStates.OrderShipmentPercentage,0) AS OrderShipmentPercentage,
	CASE
		WHEN ISNULL(SalesOrderStates.AmountOfDebt,0) &lt; 0 
			THEN -ISNULL(SalesOrderStates.AmountOfDebt,0)
		ELSE 0
	END AS AccountsPayableOfCompany,
	CASE
		WHEN ISNULL(SalesOrderStates.AmountOfDebt,0) > 0 
			THEN ISNULL(SalesOrderStates.AmountOfDebt,0)
		ELSE 0
	END AS CustomerAccountsReceivable,


	ISNULL(SalesOrderStates.DebtPercentage,0) AS DebtPercentage,
	ISNULL(SalesOrderStates.EventDate, DATETIME(1, 1, 1)) AS EventDate,
	ISNULL(SalesOrderStates.ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoice,FALSE) AS ThereAreDiscrepanciesOfGoodsReceiptNoteAndInvoice
	

FROM
	Document.MaterialProviderOrder2_5 AS DocumentMaterialProviderOrder2_5
	
	LEFT JOIN InformationRegister.SalesOrderStates AS SalesOrderStates
	ON SalesOrderStates.OrderDocument = DocumentMaterialProviderOrder2_5.Ref</queryText>
      <mainTable>Document.MaterialProviderOrder2_5</mainTable>
