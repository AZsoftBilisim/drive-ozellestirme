		<field xsi:type="DataSetFieldField">
			<dataPath>SalesRank</dataPath>
			<field>SalesRank</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Sales rank</v8:content>
				</v8:item>
				<v8:item>
