		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	SelectionByProductSegment.Products AS Products,
	SelectionByProductSegment.Characteristic AS Characteristic,
	SelectionByProductSegment.FilterByProductSegmentIsUsed AS FilterByProductSegmentIsUsed,
	ISNULL(CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE SelectionByProductSegment.Characteristic.ItemsCharacteristicForPricing
	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage
INTO SelectionByProductSegmentAugmented
FROM
	SelectionByProductSegment AS SelectionByProductSegment
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = SelectionByProductSegment.Products.ProductKind)
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	CurrencyRatesCut.Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	&amp;QueryTextPackagingFactor AS PackageFactor,
	ItemPricesCrossSectionOfTheLatest.PricingVariant AS PricingVariant,
	ItemPricesCrossSectionOfTheLatest.Price / ISNULL(&amp;QueryTextPackagingFactor, 1) * CASE
		WHEN &amp;Currency &lt;&gt; ItemPricesCrossSectionOfTheLatest.Currency
			THEN CASE
				WHEN ISNULL(ExchangeRatePrices.CourseDenominator, 0) &gt; 0
				AND ISNULL(ExchangeRatePrices.CourseNumerator, 0) &gt; 0
				AND ISNULL(CurrencyExchangeRate.CourseDenominator, 0) &gt; 0
				AND ISNULL(CurrencyExchangeRate.CourseNumerator, 0) &gt; 0
					THEN ExchangeRatePrices.CourseNumerator * CurrencyExchangeRate.CourseDenominator / (CurrencyExchangeRate.CourseNumerator *
						ExchangeRatePrices.CourseDenominator)
				ELSE 0
			END
		ELSE 1
	END AS Price,
	ItemPricesCrossSectionOfTheLatest.PricingPackage AS PricingPackage,
	ItemPricesCrossSectionOfTheLatest.Package AS Package
FROM
	InformationRegister.ItemsPrices25.SliceLast(&amp;OffsetPeriodStart, PriceKind = &amp;PriceKind {((Products,
		PricingVariant, PricingBatch, PricingPackage) IN
		(SELECT
			SelectionByProductSegmentAugmented.Products,
			SelectionByProductSegmentAugmented.PricingVariant,
			SelectionByProductSegmentAugmented.PricingBatch,
			SelectionByProductSegmentAugmented.PricingPackage
		FROM
			SelectionByProductSegmentAugmented
		WHERE
			SelectionByProductSegmentAugmented.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		ItemPricesCrossSectionOfTheLatest
		LEFT JOIN ExchangeRates AS ExchangeRatePrices
		ON ItemPricesCrossSectionOfTheLatest.Currency = ExchangeRatePrices.Currency
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON (CurrencyExchangeRate.Currency = &amp;Currency)
WHERE
	ItemPricesCrossSectionOfTheLatest.PricingBatch = VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)</query>
	</dataSet>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Avg(IsNull(Price,0) *  
                Case
                    When
                        Package &lt;&gt; Value(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
                    Then
                        PackageFactor
                    Else
                        1
                End
                )</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
