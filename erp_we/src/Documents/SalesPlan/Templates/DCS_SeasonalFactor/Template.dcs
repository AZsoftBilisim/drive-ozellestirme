		<field xsi:type="DataSetFieldField">
			<dataPath>Characteristic</dataPath>
			<field>Characteristic</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Variant</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>گونه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Caratteristica</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Charakterystyka</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Характеристика</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Varyant</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đặc tính</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogProducts.Ref AS Products,
	ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic
INTO SelectionByProductSegment
FROM
	Catalog.Products AS CatalogProducts
		LEFT JOIN Catalog.ItemsCharacteristics AS CatalogCharacteristics
		ON (CatalogCharacteristics.Owner = CASE
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN CatalogProducts.ProductKind
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN CatalogProducts.Ref
				WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN CatalogProducts.ItemVariantsOwner
				ELSE UNDEFINED
			END)
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON CatalogProducts.Ref = SegmentProducts.Products
			AND (ISNULL(CatalogCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SegmentProducts.Characteristic)}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN YEAR(&amp;BeginOfPeriod) &lt;&gt; YEAR(&amp;EndOfPeriod)
				AND SeasonalIndexes.PeriodNumber &gt;= 1
				AND SeasonalIndexes.PeriodNumber &lt;= DAYOFYEAR(&amp;EndOfPeriod)
			THEN DATEADD(BEGINOFPERIOD(DATEADD(BEGINOFPERIOD(&amp;EndOfPeriod, YEAR), DAY, SeasonalIndexes.PeriodNumber - 1), &amp;PeriodString), &amp;PeriodString, -&amp;PeriodOffset)
		ELSE DATEADD(BEGINOFPERIOD(DATEADD(BEGINOFPERIOD(&amp;BeginOfPeriod, YEAR), DAY, SeasonalIndexes.PeriodNumber - 1), &amp;PeriodString), &amp;PeriodString, -&amp;PeriodOffset)
	END AS Period,
	SeasonalIndexes.ItemsGroup AS ItemsGroup,
	SeasonalIndexes.ZoomRatio AS ZoomRatio,
	0 AS CoefficientShift
INTO AllCoefficients
FROM
	InformationRegister.SeasonalIndexes AS SeasonalIndexes
WHERE
	SeasonalIndexes.Periodicity = VALUE(Enum.Periodicity.DAY)
	AND SeasonalIndexes.SeasonalGroupOfBusinessRegion = VALUE(Catalog.SeasonalGroupsOfBusinessRegions.OtherItems)
	AND CASE
			WHEN YEAR(&amp;BeginOfPeriod) &lt;&gt; YEAR(&amp;EndOfPeriod)
				THEN SeasonalIndexes.PeriodNumber &gt;= 1
							AND SeasonalIndexes.PeriodNumber &lt;= DAYOFYEAR(&amp;EndOfPeriod)
						OR SeasonalIndexes.PeriodNumber &gt;= DAYOFYEAR(&amp;BeginOfPeriod)
							AND SeasonalIndexes.PeriodNumber &lt;= 365
			ELSE SeasonalIndexes.PeriodNumber &gt;= DAYOFYEAR(&amp;BeginOfPeriod)
					AND SeasonalIndexes.PeriodNumber &lt;= DAYOFYEAR(&amp;EndOfPeriod)
		END

UNION ALL

SELECT
	CASE
		WHEN YEAR(&amp;OffsetPeriodStart) &lt;&gt; YEAR(&amp;OffsetPeriodEnd)
				AND SeasonalIndexes.PeriodNumber &gt;= 1
				AND SeasonalIndexes.PeriodNumber &lt;= DAYOFYEAR(&amp;OffsetPeriodEnd)
			THEN BEGINOFPERIOD(DATEADD(BEGINOFPERIOD(&amp;OffsetPeriodEnd, YEAR), DAY, SeasonalIndexes.PeriodNumber - 1), &amp;PeriodString)
		ELSE BEGINOFPERIOD(DATEADD(BEGINOFPERIOD(&amp;OffsetPeriodStart, YEAR), DAY, SeasonalIndexes.PeriodNumber - 1), &amp;PeriodString)
	END,
	SeasonalIndexes.ItemsGroup,
	0,
	SeasonalIndexes.ZoomRatio
FROM
	InformationRegister.SeasonalIndexes AS SeasonalIndexes
WHERE
	SeasonalIndexes.Periodicity = VALUE(Enum.Periodicity.DAY)
	AND SeasonalIndexes.SeasonalGroupOfBusinessRegion = VALUE(Catalog.SeasonalGroupsOfBusinessRegions.OtherItems)
	AND CASE
			WHEN YEAR(&amp;OffsetPeriodStart) &lt;&gt; YEAR(&amp;OffsetPeriodEnd)
				THEN SeasonalIndexes.PeriodNumber &gt;= 1
							AND SeasonalIndexes.PeriodNumber &lt;= DAYOFYEAR(&amp;OffsetPeriodEnd)
						OR SeasonalIndexes.PeriodNumber &gt;= DAYOFYEAR(&amp;OffsetPeriodStart)
							AND SeasonalIndexes.PeriodNumber &lt;= 365
			ELSE SeasonalIndexes.PeriodNumber &gt;= DAYOFYEAR(&amp;OffsetPeriodStart)
					AND SeasonalIndexes.PeriodNumber &lt;= DAYOFYEAR(&amp;OffsetPeriodEnd)
		END
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AllCoefficients.Period,
	AllCoefficients.ItemsGroup AS ItemsGroup,
	SUM(AllCoefficients.ZoomRatio) AS ZoomRatio,
	SUM(AllCoefficients.CoefficientShift) AS CoefficientShift
INTO SeasonalIndexes
FROM
	AllCoefficients AS AllCoefficients

GROUP BY
	AllCoefficients.ItemsGroup,
	AllCoefficients.Period

INDEX BY
	ItemsGroup
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SeasonalIndexes.Period,
	CatalogProducts.Ref AS Products,
	ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	CASE
		WHEN SeasonalIndexes.ZoomRatio = 0
			THEN 0
		ELSE SeasonalIndexes.CoefficientShift / SeasonalIndexes.ZoomRatio
	END AS SeasonalFactor
FROM
	SeasonalIndexes AS SeasonalIndexes
		INNER JOIN Catalog.Products AS CatalogProducts
			LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
			ON (ItemsCharacteristics.Owner = CASE
					WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
						THEN CatalogProducts.ProductKind
					WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
						THEN CatalogProducts.Ref
					WHEN CatalogProducts.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
						THEN CatalogProducts.ItemVariantsOwner
					ELSE UNDEFINED
				END)
			{INNER JOIN SelectionByProductSegment AS SelectionByProductSegment
			ON (&amp;FilterByProductSegmentIsUsed = TRUE)
				AND CatalogProducts.Ref = SelectionByProductSegment.Products
				AND (ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) = SelectionByProductSegment.Characteristic)}
		ON SeasonalIndexes.ItemsGroup = CatalogProducts.ItemsGroup</query>
	</dataSet>
	<totalField>
		<dataPath>SeasonalFactor</dataPath>
		<expression>Max(IsNull(SeasonalFactor, 0))</expression>
	</totalField>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>فیلتر بر اساس بخش قلم استفاده می‌شود</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Viene utilizzata la selezione per segmento degli articoli</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jest używany filtr wg segmentu wierszy pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Используется отбор по сегменту номенклатуры</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok segmentine göre filtre kullanılıyor</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sử dụng lọc theo phân nhóm mặt hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>OffsetPeriodEnd</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Offset period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره جابجایی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine dello scostamento del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu przesunięcia</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода смещения</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kayma döneminin sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ dịch chuyển</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>OffsetPeriodStart</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Offset period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره جابه‌جایی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio dello scostamento del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu przesunięcia</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода смещения</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kayma döneminin başlangıcı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ dịch chuyển</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
