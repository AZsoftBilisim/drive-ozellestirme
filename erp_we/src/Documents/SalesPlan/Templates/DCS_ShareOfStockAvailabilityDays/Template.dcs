		<dataSource>DataSource1</dataSource>
		<query>SELECT
	0 AS DaysCount
INTO Counter

UNION ALL

SELECT
	1

UNION ALL

SELECT
	2

UNION ALL

SELECT
	3

UNION ALL

SELECT
	4

UNION ALL

SELECT
	5

UNION ALL

SELECT
	6

UNION ALL

SELECT
	7

UNION ALL

SELECT
	8

UNION ALL

SELECT
	9
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DATEADD(
		&amp;BeginOfPeriod,
		DAY,
		Counter1.DaysCount + Counter2.DaysCount * 10 + Counter3.DaysCount * 100 + Counter4.DaysCount * 1000) AS Day
INTO PeriodDays_
FROM
	Counter AS Counter1
		LEFT JOIN Counter AS Counter2
		ON TRUE
		LEFT JOIN Counter AS Counter3
		ON TRUE
		LEFT JOIN Counter AS Counter4
		ON TRUE
WHERE
	DATEADD(
		&amp;BeginOfPeriod,
		DAY,
		Counter1.DaysCount + Counter2.DaysCount * 10 + Counter3.DaysCount * 100 + Counter4.DaysCount * 1000) &lt;= &amp;EndOfPeriod	
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductStock.Period                  AS Period,
	ProductStock.Products            AS Products,
	ProductStock.Characteristic          AS Characteristic,
	ProductStock.Purpose              AS Purpose,
	ProductStock.InStockTurnover          AS InStockTurnover,
	ProductStock.InStockClosingBalance AS InStockClosingBalance
INTO ProductStock
FROM
	AccumulationRegister.ProductStock.BalanceAndTurnovers(
		&amp;BeginOfPeriod,
		&amp;EndOfPeriod,
		Day,,
		{(Warehouse = &amp;FilterWarehouse), (Purpose = &amp;FilterPurpose)}) AS ProductStock
	
INDEX BY
	Products,
	Characteristic,
	Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductStock.Products   AS Products,
	ProductStock.Characteristic AS Characteristic,
	ProductStock.Purpose     AS Purpose
INTO TableOfGoods
FROM
	ProductStock AS ProductStock
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PeriodDays_.Day                AS Day,
	ProductStock.Products   AS Products,
	ProductStock.Characteristic AS Characteristic,
	ProductStock.Purpose     AS Purpose
INTO TableOfProductsByDayOfPeriod
FROM
	ProductStock AS ProductStock
		LEFT JOIN PeriodDays_ AS PeriodDays_
		ON TRUE
	
INDEX BY
	Products,
	Characteristic,
	Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfProductsByDayOfPeriod.Day           AS Day,
	TableOfProductsByDayOfPeriod.Products   AS Products,
	TableOfProductsByDayOfPeriod.Characteristic AS Characteristic,
	TableOfProductsByDayOfPeriod.Purpose     AS Purpose,
	SUM(CASE
			WHEN ProductStock.Period = &amp;BeginOfPeriod
				THEN ProductStock.InStockClosingBalance
			WHEN TableOfProductsByDayOfPeriod.Day &gt;= ProductStock.Period
				THEN ProductStock.InStockTurnover
			ELSE 0
		  END)                               AS Balance,
	CASE
		WHEN SUM(CASE
						WHEN ProductStock.Period = &amp;BeginOfPeriod
							THEN ProductStock.InStockClosingBalance
						WHEN TableOfProductsByDayOfPeriod.Day &gt;= ProductStock.Period
							THEN ProductStock.InStockTurnover
						ELSE 0
					 END) &gt; 0
			THEN 1
		ELSE 0
	END                                      AS NumberOfDaysOfProductAvailabilityOnBalances
		  	
INTO BalanceForEachDay	
FROM
	TableOfProductsByDayOfPeriod AS TableOfProductsByDayOfPeriod
		LEFT JOIN ProductStock AS ProductStock
		ON TableOfProductsByDayOfPeriod.Products   = ProductStock.Products
		 AND TableOfProductsByDayOfPeriod.Characteristic = ProductStock.Characteristic
		 AND TableOfProductsByDayOfPeriod.Purpose     = ProductStock.Purpose
		 AND TableOfProductsByDayOfPeriod.Day &gt;= ProductStock.Period
		
GROUP BY
	TableOfProductsByDayOfPeriod.Day,
	TableOfProductsByDayOfPeriod.Products,
	TableOfProductsByDayOfPeriod.Characteristic,
	TableOfProductsByDayOfPeriod.Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;OffsetPeriodStart AS OffsetPeriodStart,
	&amp;BeginOfPeriod         AS BeginOfPeriod, 
	&amp;EndOfPeriod          AS EndOfPeriod
INTO PeriodsTable

WHERE
	&amp;NotOverridden
;

////////////////////////////////////////////////////////////////////////////////
SELECT	
	PeriodsTable.OffsetPeriodStart                                                      AS Period,
	BalanceForEachDay.Products                                                           AS Products,
	BalanceForEachDay.Characteristic                                                         AS Characteristic,
	BalanceForEachDay.Purpose                                                             AS Purpose,
	SUM(BalanceForEachDay.NumberOfDaysOfProductAvailabilityOnBalances)
		/ (DATEDIFF(PeriodsTable.BeginOfPeriod, PeriodsTable.EndOfPeriod, Day) + 1) AS ShareOfStockAvailabilityDays
FROM
	PeriodsTable AS PeriodsTable
		LEFT JOIN BalanceForEachDay AS BalanceForEachDay
		ON PeriodsTable.BeginOfPeriod &lt;= BalanceForEachDay.Day
		 AND PeriodsTable.EndOfPeriod &gt;= BalanceForEachDay.Day
	
GROUP BY
	PeriodsTable.OffsetPeriodStart,
	PeriodsTable.BeginOfPeriod,
	PeriodsTable.EndOfPeriod,
	BalanceForEachDay.Products,
	BalanceForEachDay.Characteristic,
	BalanceForEachDay.Purpose</query>
	</dataSet>
	<totalField>
		<dataPath>ShareOfStockAvailabilityDays</dataPath>
		<expression>Sum(IsNull(ShareOfStockAvailabilityDays, 0))</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then DateAdd(&amp;OffsetPeriodStart, "Week", &amp;PeriodOffset) When Value(Enum.Periodicity.TenDays) Then DateAdd(&amp;OffsetPeriodStart, "TenDays", &amp;PeriodOffset) When Value(Enum.Periodicity.Month) Then DateAdd(&amp;OffsetPeriodStart, "Month", &amp;PeriodOffset) When Value(Enum.Periodicity.Quarter) Then DateAdd(&amp;OffsetPeriodStart, "Quarter", &amp;PeriodOffset) When Value(Enum.Periodicity.HalfYear) Then DateAdd(&amp;OffsetPeriodStart, "HalfYear", &amp;PeriodOffset) When Value(Enum.Periodicity.Year) Then DateAdd(&amp;OffsetPeriodStart, "Year", &amp;PeriodOffset) Else DateAdd(&amp;OffsetPeriodStart, "Day", &amp;PeriodOffset) End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case &amp;Periodicity When Value(Enum.Periodicity.Week) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Week", &amp;PeriodOffset), "Week") When Value(Enum.Periodicity.TenDays) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "TenDays", &amp;PeriodOffset), "TenDays") When Value(Enum.Periodicity.Month) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Month", &amp;PeriodOffset), "Month") When Value(Enum.Periodicity.Quarter) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Quarter", &amp;PeriodOffset), "Quarter") When Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "HalfYear", &amp;PeriodOffset), "HalfYear") When Value(Enum.Periodicity.Year) Then EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Year", &amp;PeriodOffset), "Year") Else EndOfPeriod(DateAdd(&amp;OffsetPeriodEnd, "Day", &amp;PeriodOffset), "Day") End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
