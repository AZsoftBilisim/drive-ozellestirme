    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	SalesPlan.Ref,
	SalesPlan.Number,
	SalesPlan.Date,
	SalesPlan.Periodicity,
	SalesPlan.BeginOfPeriod,
	SalesPlan.PeriodEnding,
	SalesPlan.Terms,
	CASE
		WHEN BEGINOFPERIOD(&amp;CurrentDate, DAY) BETWEEN BEGINOFPERIOD(SalesPlan.BeginOfPeriod, DAY) AND ENDOFPERIOD(SalesPlan.PeriodEnding, DAY)
			THEN 1
		WHEN BEGINOFPERIOD(SalesPlan.BeginOfPeriod, DAY) > BEGINOFPERIOD(&amp;CurrentDate, DAY)
			THEN 2
		ELSE 0
	END AS RelevanceOfThePlan,
	SalesPlan.Status,
	TermsOfSale.AvailableToExternalUsers
FROM
	Document.SalesPlan AS SalesPlan
		INNER JOIN Catalog.TermsOfSale AS TermsOfSale
		ON SalesPlan.Terms = TermsOfSale.Ref
WHERE
	SalesPlan.Partner = &amp;Partner
	AND NOT SalesPlan.DeletionMark</queryText>
      <mainTable>Document.SalesPlan</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
