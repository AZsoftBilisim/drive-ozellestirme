        <headerHorizontalAlign>Left</headerHorizontalAlign>
        <showInFooter>true</showInFooter>
        <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
          <choiceList>
            <presentation>
              <key>en</key>
              <value>no change</value>
            </presentation>
            <presentation>
              <key>fa</key>
              <value>بدون تغییر</value>
            </presentation>
            <presentation>
              <key>it</key>
              <value>senza modifiche</value>
            </presentation>
            <presentation>
              <key>pl</key>
              <value>bez zmian</value>
            </presentation>
            <presentation>
              <key>ru</key>
              <value>без изменений</value>
            </presentation>
            <presentation>
              <key>tr</key>
              <value>değişiklik yapmadan</value>
            </presentation>
            <presentation>
              <key>vi</key>
              <value>không thay đổi</value>
            </presentation>
            <value xsi:type="core:ReferenceValue">
              <value>Enum.NumberPresentationKinds.EnumValue.Unchanged</value>
            </value>
          </choiceList>
          <choiceList>
            <presentation>
              <key>en</key>
              <value>In thousands</value>
            </presentation>
            <presentation>
              <key>fa</key>
              <value>به هزار</value>
            </presentation>
            <presentation>
              <key>it</key>
              <value>in migliaia</value>
            </presentation>
            <presentation>
              <key>pl</key>
              <value>w tysiącach</value>
            </presentation>
            <presentation>
              <key>ru</key>
              <value>в тысячах</value>
            </presentation>
            <presentation>
              <key>tr</key>
              <value>binler halinde</value>
            </presentation>
            <presentation>
              <key>vi</key>
              <value>trong hàng ngàn</value>
