              </presentation>
              <presentation>
                <key>fa</key>
                <value>در نظر گرفتن در حسابداری دریافتنی/پرداختنی</value>
              </presentation>
              <presentation>
                <key>ru</key>
                <value>Учитывать во взаиморасчетах</value>
              </presentation>
