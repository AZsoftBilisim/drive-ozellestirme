    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentSalesOrder.Ref,
	DocumentSalesOrder.Date,
	DocumentSalesOrder.Number,
	DocumentSalesOrder.Currency,
	DocumentSalesOrder.Partner,
	DocumentSalesOrder.Counterparty,
	DocumentSalesOrder.Organization,
	DocumentSalesOrder.Manager,
	DocumentSalesOrder.Priority,
	DocumentSalesOrder.Posted,
	DocumentSalesOrder.Status,
	DocumentSalesOrder.DocumentAmount,
	DocumentSalesOrder.PaymentMethod AS PaymentMethod,
	DocumentSalesOrder.BankAccount AS BankAccount,
	DocumentSalesOrder.CashAccount AS CashAccount,
	DocumentSalesOrder.Author,
	CASE
		WHEN DocumentSalesOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute)
			THEN 0
		WHEN DocumentSalesOrder.Priority IN
				(SELECT TOP 1
					Priorities.Ref AS Priority
				FROM
					Catalog.Priorities AS Priorities
				ORDER BY
					Priorities.AddlOrderingAttribute DESC)
			THEN 2
		ELSE 1
	END AS PictureOfPriority,

	CASE WHEN DocumentSalesOrder.Posted
		AND ISNULL(CustomersARAPAccounting.AmountDueBalance, 0) > 0
	THEN
		TRUE
	ELSE
		FALSE
	END PaymentRequired,
	
	ISNULL(CustomersARAPAccounting.AmountDueBalance, 0) AS AmountToPay
FROM
	Document.SalesOrder AS DocumentSalesOrder
	
	LEFT JOIN
		AccumulationRegister.CustomersARAPAccounting.Balance() AS CustomersARAPAccounting
	ON
		DocumentSalesOrder.ARAPObject = CustomersARAPAccounting.ARAPObject</queryText>
      <mainTable>Document.SalesOrder</mainTable>
