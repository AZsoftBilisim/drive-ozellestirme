  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.AcquiringContract</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Organization</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.POSTerminal</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Posted</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.DeletionMark,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture,
	DocumentsRegistry.Posted,
	DocumentsRegistry.Organization,
	DocumentsRegistry.Department,
	DocumentsRegistry.EmployeeResponsible,
	DocumentsRegistry.Comment,
	DocumentsRegistry.Sum AS DocumentAmount,
	DocumentsRegistry.Currency,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	DocumentsRegistry.Contract AS Contract,
	CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties) AS Counterparty,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.ReverseTransactionCorrection AS ReverseTransactionCorrection,
	CASE
		WHEN NOT DocumentsRegistry.ReverseTransactionCorrection
			THEN UNDEFINED
		ELSE DocumentsRegistry.ReversedDocument
	END AS ReversedCorrectedDocument,
	
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry)
			THEN StornoData.AcquiringContract
		ELSE PaymentCardTransaction.AcquiringContract
	END AS AcquiringContract,
	
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry)
			THEN StornoData.POSTerminal
		ELSE PaymentCardTransaction.POSTerminal
	END AS POSTerminal,

	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry)
			THEN StornoData.PaymentCardNumber
		ELSE PaymentCardTransaction.PaymentCardNumber
	END AS PaymentCardNumber,
	
	CASE
		WHEN VALUETYPE(DocumentsRegistry.Ref) = TYPE(Document.ReversingEntry)
			THEN StornoData.Author
		ELSE PaymentCardTransaction.Author
	END AS Author,
	
	CASE
		WHEN DocumentsRegistry.Posted
				AND ISNULL(AcquiringContractARAP.SumBalance, 0) = 0
				AND 1 IN
					(SELECT TOP 1
						1
					FROM
						AccumulationRegister.AcquiringContractARAP AS TrafficAcquiringCalculations
					WHERE
						TrafficAcquiringCalculations.POSTerminal = PaymentCardTransaction.POSTerminal
						AND TrafficAcquiringCalculations.PaymentDate = BEGINOFPERIOD(PaymentCardTransaction.Date, DAY)
						AND TrafficAcquiringCalculations.Recorder REFS Document.BankReportOnAcquiringTransactions
						AND (TrafficAcquiringCalculations.RecordType = VALUE(AccumulationRecordType.Expense)
								AND PaymentCardTransaction.BusinessOperation = VALUE(Enum.BusinessTransactions.CashReceiptFromCustomer)
							OR TrafficAcquiringCalculations.RecordType = VALUE(AccumulationRecordType.Receipt)
								AND PaymentCardTransaction.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToCustomer)))
			THEN TRUE
		ELSE FALSE
	END AS ProcessedByBank,
	CASE
		WHEN DocumentsWithCounterpartyCheckErrors.Document IS NULL 
			THEN FALSE
		ELSE TRUE
	END AS ThereAreErrorsInCheckingCounterparties
	
	
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
		LEFT JOIN Document.PaymentCardTransaction AS PaymentCardTransaction
			ON DocumentsRegistry.Ref = PaymentCardTransaction.Ref
		LEFT JOIN Document.PaymentCardTransaction AS StornoData
			ON DocumentsRegistry.ReversedDocument = StornoData.Ref
			
			
		LEFT JOIN AccumulationRegister.AcquiringContractARAP.Balance AS AcquiringContractARAP
			ON (AcquiringContractARAP.POSTerminal = PaymentCardTransaction.POSTerminal)
			AND (AcquiringContractARAP.PaymentDate = BEGINOFPERIOD(DocumentsRegistry.IBDocumentDate, DAY))
		{LEFT JOIN InformationRegister.DocumentsWithCounterpartyCheckErrors AS DocumentsWithCounterpartyCheckErrors
			ON DocumentsRegistry.Ref = DocumentsWithCounterpartyCheckErrors.Document
				AND (&amp;UsingOfCheckIsAnOption)}
WHERE
	NOT DocumentsRegistry.AdditionalRecord
	AND DocumentsRegistry.RefType = &amp;RefType
{WHERE
	DocumentsRegistry.Ref.* AS Ref,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.RefType AS RefType,
	DocumentsRegistry.BusinessOperation AS BusinessOperation,
	CAST(DocumentsRegistry.Counterparty.Key AS Catalog.Counterparties).* AS Counterparty,
	DocumentsRegistry.Contract.* AS Contract,
	DocumentsRegistry.Department.* AS Department,
	DocumentsRegistry.EmployeeResponsible.* AS EmployeeResponsible,
	DocumentsRegistry.More AS More,
	DocumentsRegistry.Comment AS Comment,
	DocumentsRegistry.Posted AS Posted,
	DocumentsRegistry.DeletionMark AS DeletionMark,
	((DocumentsRegistry.IBDocumentDate >= &amp;BeginOfPeriod
		OR &amp;BeginOfPeriod = DATETIME(1, 1, 1))
	AND (DocumentsRegistry.IBDocumentDate &lt;= &amp;EndOfPeriod
		OR &amp;EndOfPeriod = DATETIME(1, 1, 1)))}</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
