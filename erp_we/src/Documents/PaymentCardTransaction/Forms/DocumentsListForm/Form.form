  <attributes>
    <name>PaymentRequests</name>
    <title>
      <key>en</key>
      <value>Requests for payment</value>
    </title>
    <title>
      <key>fa</key>
      <value>درخواست‌های پرداخت</value>
    </title>
    <title>
      <key>it</key>
      <value>Importo da pagare</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wnioski do płatności</value>
    </title>
    <title>
      <key>ru</key>
      <value>Заявки к оплате</value>
    </title>
    <title>
      <key>tr</key>
      <value>Ödeme talepleri</value>
    </title>
    <title>
      <key>vi</key>
      <value>Giấy đề nghị cần thanh toán</value>
    </title>
    <id>7</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.UsePaymentRequests</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>PaymentRequests.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT TOP 1
	Priorities.Ref AS Priority
INTO MaximumPriority
FROM
	Catalog.PaymentPriorities AS Priorities
WHERE
	Priorities.AddlOrderingAttribute IN (
		SELECT
			MIN(Priorities.AddlOrderingAttribute)
		FROM
			Catalog.PaymentPriorities AS Priorities)
;

SELECT TOP 1
	Priorities.Ref AS Priority
INTO MinPriority
FROM
	Catalog.PaymentPriorities AS Priorities
WHERE
	Priorities.AddlOrderingAttribute IN (
		SELECT
			MAX(Priorities.AddlOrderingAttribute)
		FROM
			Catalog.PaymentPriorities AS Priorities)
;

SELECT
	Request.Ref AS Ref,
	Request.Ref AS RequestForPayment,
	Request.Date AS Date,
	Request.Number AS Number,
	Request.PaymentDate AS PaymentDate,
	Request.Currency AS Currency,
	Request.Posted AS Posted,
	
	Request.Organization AS Organization,
	Request.BusinessOperation AS BusinessOperation,
	
	Request.Counterparty AS Recipient,
	Request.Author AS Author,
	Request.DocumentAmount AS DocumentAmount,

	CASE
		WHEN Request.PaymentPriority = MaximumPriority.Priority THEN
			0
		WHEN Request.PaymentPriority = MinPriority.Priority THEN
			2
		ELSE
			1
	END AS PictureOfPriority,
	
	Request.PaymentMethodOfPaymentRequest AS PaymentMethod,
	
	CASE WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
		AND Request.Posted
	THEN
		TRUE
	ELSE
		FALSE
	END AS RequestIsPaid,
	
	CASE WHEN ISNULL(Cash.SumBalance, 0) > 0 THEN
		ISNULL(Cash.SumBalance, 0)
	ELSE
		0
	END AS AmountToPay
	
FROM
	Document.PaymentRequest AS Request
	
	LEFT JOIN AccumulationRegister.CashToBePaid.Balance AS Cash
	ON Request.Ref = Cash.PaymentRequest
	
	LEFT JOIN MaximumPriority
	ON TRUE
	
	LEFT JOIN MinPriority
	ON TRUE
	
WHERE
	Request.Posted
	AND Request.Status = VALUE(Enum.StatusesOfPaymentRequests.AmountDue)
	AND Request.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToCustomer)</queryText>
      <mainTable>Document.PaymentRequest</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
