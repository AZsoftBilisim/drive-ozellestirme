      <segments>DocumentsList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentData.Ref                 AS Ref,
	DocumentData.DeletionMark        AS DeletionMark,
	DocumentData.Number                  AS Number,
	DocumentData.Date                   AS Date,
	DocumentData.Posted               AS Posted,
	DocumentData.Organization            AS Organization,
	DocumentData.Department          AS Department,
	DocumentData.Employee              AS Employee,
	
	CASE
		WHEN DocumentData.PersonsList THEN
			DocumentData.EmployeeListAsString
		ELSE
			DocumentData.Employee.Description
	END AS EmployeePresentation,
	
	DocumentData.StartDate             AS StartDate,
	DocumentData.EndDate          AS EndDate,
	DocumentData.PlaceOfDestination        AS PlaceOfDestination,
	DocumentData.Partner                AS Partner,
	DocumentData.Target                   AS Target,
	DocumentData.Status                 AS Status,
	BookingStatus.State        AS BookingStatus_3,
	CASE ISNULL(BookingStatus.State, VALUE(Enum.BusinessTripApplicationBookingStatuses.EmptyRef))
		WHEN VALUE(Enum.BusinessTripApplicationBookingStatuses.EmptyRef) THEN
			-1
		WHEN VALUE(Enum.BusinessTripApplicationBookingStatuses.Sent_) THEN
			2
		WHEN VALUE(Enum.BusinessTripApplicationBookingStatuses.Accepted) THEN
			2
		WHEN VALUE(Enum.BusinessTripApplicationBookingStatuses.Processed1) THEN
			1
		WHEN VALUE(Enum.BusinessTripApplicationBookingStatuses.RolledBack) THEN
			-1
	END AS PictureOfTheStateOfTheReservation,
	
	DocumentData.DocumentAmount         AS DocumentAmount,
	DocumentData.Currency                 AS Currency,
	DocumentData.Comment            AS Comment,
	
	CASE WHEN ISNULL(Cash.SumBalance, 0) &lt;= 0
		AND DocumentData.Posted
		AND DocumentData.DocumentAmount &lt;> 0
		AND DocumentData.Status &lt;> VALUE(Enum.EmployeeApplicationStatuses.IsRejected)
	THEN
		TRUE
	ELSE
		FALSE
	END AS RequestIsPaid
FROM
	Document.ApplicationForBusinessTrip AS DocumentData
	
	LEFT JOIN
		InformationRegister.BusinessTripApplicationBookingStatuses.SliceLast AS BookingStatus
	ON
		BookingStatus.ApplicationForBusinessTrip = DocumentData.Ref
		
	LEFT JOIN
		AccumulationRegister.CashToBePaid.Balance AS Cash
	ON 
		Cash.PaymentRequest = DocumentData.Ref
</queryText>
      <mainTable>Document.ApplicationForBusinessTrip</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
