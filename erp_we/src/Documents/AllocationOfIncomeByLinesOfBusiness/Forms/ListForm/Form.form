    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Attributes.Ref,
	Attributes.DataVersion,
	Attributes.DeletionMark,
	Attributes.Number,
	Attributes.Date,
	Attributes.Posted,
	Attributes.Organization,
	Attributes.EmployeeResponsible,
	Attributes.AllocationByAllCompanies,
	Attributes.CalculatedCompanies,
	Attributes.Income,
	Attributes.Expenses,
	Attributes.PointInTime
FROM
	Document.AllocationOfIncomeByLinesOfBusiness AS Attributes
WHERE
	Attributes.AllocationByAllCompanies
	OR Attributes.Organization IN (&amp;CompanyArray)
</queryText>
