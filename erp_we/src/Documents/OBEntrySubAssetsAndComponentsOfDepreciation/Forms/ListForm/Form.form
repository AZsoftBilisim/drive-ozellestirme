    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentData.Ref AS Ref,
	DocumentData.DeletionMark AS DeletionMark,
	DocumentData.Number AS Number,
	DocumentData.Date AS Date,
	DocumentData.Posted AS Posted,
	DocumentData.Organization AS Organization,
	DocumentData.FixedAssetsLocation AS FixedAssetsLocation,
	DocumentData.EmployeeResponsible AS EmployeeResponsible,
	DocumentData.Comment AS Comment,
	DocumentData.PointInTime AS PointInTime,
	CASE
		WHEN DocumentData.RecordInOperationalAccounting
		AND DocumentData.Posted
			THEN 1
		WHEN DocumentData.RecordInOperationalAccounting
		AND NOT DocumentData.Posted
			THEN 2
		ELSE 0
	END AS RecordInOperationalAccounting,
	CASE
		WHEN DocumentData.PostInFinancialAndTaxAccounting
		AND DocumentData.Posted
			THEN 1
		WHEN DocumentData.PostInFinancialAndTaxAccounting
		AND NOT DocumentData.Posted
			THEN 2
		ELSE 0
	END AS PostInFinancialAndTaxAccounting,
	CASE
		WHEN DocumentData.RecordInMA
		AND DocumentData.Posted
			THEN 1
		WHEN DocumentData.RecordInMA
		AND NOT DocumentData.Posted
			THEN 2
		ELSE 0
	END AS RecordInMA,
	CASE
		WHEN DocumentData.RecordInManAccounting
		AND DocumentData.Posted
			THEN 1
		WHEN DocumentData.RecordInManAccounting
		AND NOT DocumentData.Posted
			THEN 2
		ELSE 0
	END AS RecordInManAccounting,
	CASE
		WHEN DocumentData.RecordInLocalAccounting
		AND DocumentData.Posted
			THEN 1
		WHEN DocumentData.RecordInLocalAccounting
		AND NOT DocumentData.Posted
			THEN 2
		ELSE 0
	END AS RecordInLocalAccounting,
	CASE
		WHEN FilesExist.HasFiles IS NULL
			THEN 0
		WHEN FilesExist.HasFiles
			THEN 1
		ELSE 0
	END AS HasFiles
FROM
	Document.OBEntrySubAssetsAndComponentsOfDepreciation AS DocumentData
		LEFT JOIN InformationRegister.FilesExist AS FilesExist
		ON DocumentData.Ref = FilesExist.ObjectWithFiles</queryText>
      <mainTable>Document.OBEntrySubAssetsAndComponentsOfDepreciation</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
