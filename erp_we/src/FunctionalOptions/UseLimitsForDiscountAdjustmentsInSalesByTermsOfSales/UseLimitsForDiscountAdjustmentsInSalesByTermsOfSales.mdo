<?xml version="1.0" encoding="UTF-8"?>
<mdclass:FunctionalOption xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="adb08c2c-baf4-417f-bde1-6145acacefd7">
  <name>UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales</name>
  <synonym>
    <key>en</key>
    <value>Use limits for discount adjustments in sales by terms of sales</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>استفاده از سقف تعدیل‌های تخفیف در فروش بر اساس شرایط فروش</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Utilizzare i limiti di sconto manuale nelle vendite per contratto</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Używaj ograniczenia ręcznych rabatów w sprzedażach wg porozumień</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Использовать ограничения ручных скидок в продажах по соглашениям</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Anlaşmaya göre satışlarda indirim düzeltmesi limitlerini kullan</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Sử dụng giới hạn chiết khấu bán hàng thủ công theo thỏa thuận</value>
  </synonym>
  <location>Constant.UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales</location>
  <privilegedGetMode>true</privilegedGetMode>
  <content>Catalog.SalesSettingsForUsers</content>
  <content>Catalog.TermsOfSale.Attribute.PercentRateOfManualDiscount</content>
  <content>Catalog.TermsOfSale.Attribute.MaximumPercentageForManualMarkup</content>
