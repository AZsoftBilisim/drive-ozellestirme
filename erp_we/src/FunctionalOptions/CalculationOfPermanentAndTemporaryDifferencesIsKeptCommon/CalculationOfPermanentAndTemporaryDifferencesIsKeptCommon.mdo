  </synonym>
  <synonym>
    <key>fa</key>
    <value>محاسبه تفاوت‌های دائم و موقت به‌صورت مشترک انجام می‌شود</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Si tiene registro delle differenze costanti e temporanee comune</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Jest prowadzona ewidencja stałych i czasowych różnic ogólna</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Ведется учет постоянных и временных разниц общая</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Kalıcı ve geçici fark muhasebesi yürütülüyor genel</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Hạch toán chênh lệch vĩnh viễn và tạm thời chung</value>
  </synonym>
