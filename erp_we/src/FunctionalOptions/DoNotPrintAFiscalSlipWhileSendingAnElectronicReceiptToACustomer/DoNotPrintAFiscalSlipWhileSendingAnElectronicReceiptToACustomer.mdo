<mdclass:FunctionalOption xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="260d8f06-28a5-4112-b234-bd6e141175da">
  <name>DoNotPrintAFiscalSlipWhileSendingAnElectronicReceiptToACustomer</name>
  <synonym>
    <key>en</key>
    <value>Do not print a fiscal receipt while sending an electronic receipt to a customer</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>هنگام ارسال رسید الکترونیکی به مشتری، رسید مالیاتی چاپ نشود</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Non stampare una ricevuta fiscale quando si invia un assegno elettronico all'acquirente</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Nie drukuj paragonu fiskalnego przy wysłaniu paragonu elektronicznego kupującemu</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Не печатать фискальный чек при отправке электронного чека покупателю</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>Müşteriye elektronik makbuz gönderirken elektronik makbuz yazdırma</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Không in biên lai tài chính khi gửi séc điện tử cho người mua</value>
  </synonym>
  <location>Constant.DoNotPrintAFiscalSlipWhileSendingAnElectronicReceiptToACustomer</location>
  <privilegedGetMode>true</privilegedGetMode>
</mdclass:FunctionalOption>
