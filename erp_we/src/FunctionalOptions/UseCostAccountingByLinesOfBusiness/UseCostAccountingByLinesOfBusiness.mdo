  <synonym>
    <key>en</key>
    <value>Use cost accounting by lines of business</value>
  </synonym>
  <synonym>
    <key>fa</key>
    <value>استفاده از حسابداری بها بر اساس خطوط کسب‌وکار</value>
  </synonym>
  <synonym>
    <key>it</key>
    <value>Utilizza la registrazione delle spese in base ai settori di attività</value>
  </synonym>
  <synonym>
    <key>pl</key>
    <value>Używaj ewidencji wydatków według rodzajów działalności</value>
  </synonym>
  <synonym>
    <key>ru</key>
    <value>Использовать учет затрат по направлениям деятельности</value>
  </synonym>
  <synonym>
    <key>tr</key>
    <value>İş kollarına göre gider muhasebesini kullan</value>
  </synonym>
  <synonym>
    <key>vi</key>
    <value>Sử dụng kế toán chi phí theo các mảng hoạt động</value>
  </synonym>
