Procedure SUB_Catalog_InformativeBalances_Sending_DuringProcessing(IBData, UsageOCR, ExchangeComponents)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7") Then
		UsageOCR.Clear();
	Else
		
		Filter = New Structure();
		Filter.Insert("Period", IBData.Filter.Period.Value);
		Filter.Insert("Warehouse",  IBData.Filter.Warehouse.Value);
		
		ExportedData = ExchangeComponents.ConversionParameters_SSLy.TableInformativeBalances.FindRows(Filter);
		
		If ExportedData.Count() > 0 Then
			UsageOCR.Clear();
		Else
		
			ExportedData = ExchangeComponents.ConversionParameters_SSLy.TableInformativeBalances.Add();
			ExportedData.Warehouse  = IBData.Filter.Warehouse.Value;
			ExportedData.Period = IBData.Filter.Period.Value;	
			
		EndIf;
		
	EndIf;
EndProcedure

