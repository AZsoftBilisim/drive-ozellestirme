Procedure UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, SellerSVAT = True, ForAllVersions = True, PropertyName = "Taxation")
	If SellerSVAT Then
		OCRName = "VATTaxationOfSeller";
	Else
		OCRName = "VATTaxation";
	EndIf;
	
	StructureInformationSecurityData = New Structure("VATTaxation, Organization, Warehouse, Contract, LineOfBusiness, Date");
	FillPropertyValues(StructureInformationSecurityData, IBData);
	If ValueIsFilled(StructureInformationSecurityData.VATTaxation) Then
		VATTaxation = StructureInformationSecurityData.VATTaxation;
	Else
		AccountingParametersForOrganization = VATAccountingERP.AccountingParametersForOrganization(
					StructureInformationSecurityData.Organization,
					StructureInformationSecurityData.Date,
					StructureInformationSecurityData.Warehouse);
			
		VATTaxation = AccountingParametersForOrganization.BasicTaxationVATSales;
		
	EndIf;
	
	If VATTaxation = Enums.VATTaxationTypes.DigitalServices
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7") Then
		Return;
	EndIf;		
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.20") 
		And VATTaxation = Enums.VATTaxationTypes.PreferentialVATTaxationOnSTS Then 
		If (TypeOf(IBData) = Type("Structure") And IBData.Property("Ref") 
			And TypeOf(IBData.Ref) = Type("DocumentRef.ExpenseReport")) 
			Or TypeOf(IBData) = Type("DocumentObject.ExpenseReport")
			Or TypeOf(IBData) = Type("DocumentObject.IntercompanyGoodsReturn") Then
		    XDTOData.Insert(PropertyName, New Structure("Value, OCRName", Enums.VATTaxationTypes.SaleIsSubjectToVAT, OCRName));
		Else
		    XDTOData.Insert(PropertyName, New Structure("Value, OCRName", Undefined, OCRName));
		EndIf;
		Return
	EndIf;
	XDTOData.Insert(PropertyName, New Structure("Value, OCRName", VATTaxation, OCRName));
EndProcedure 
Procedure UploadResponsiblePerson(ExchangeComponents,  IBData, XDTOData, AttributeName, UploadAsIndividual = False)
	DataOfResponsiblePerson = New Structure("Organization, Date, " + AttributeName);
	FillPropertyValues(DataOfResponsiblePerson, IBData);
	
	EmployeeInCharge_ = Undefined;
	If ValueIsFilled(DataOfResponsiblePerson[AttributeName]) Then
		EmployeeInCharge_ = DataOfResponsiblePerson[AttributeName];
	ElsIf ValueIsFilled(DataOfResponsiblePerson.Organization) Then
		ResponsiblePersons = ResponsiblePersonsServer.GetResponsiblePersonsOfOrganization(DataOfResponsiblePerson.Organization,
			DataOfResponsiblePerson.Date);
		If ResponsiblePersons.Property(AttributeName) And ValueIsFilled(ResponsiblePersons[AttributeName]) Then
			EmployeeInCharge_ = ResponsiblePersons[AttributeName];
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(EmployeeInCharge_) Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6")
		Or UploadAsIndividual Then
		
		If TypeOf(EmployeeInCharge_) = Type("CatalogRef.Persons") Then
			Individual = EmployeeInCharge_;
		ElsIf TypeOf(EmployeeInCharge_) = Type("CatalogRef.PersonsResponsibleAndCompanies") Then
			Individual = Common.ObjectAttributeValue(EmployeeInCharge_, "Individual");
		Else
			Return;
		EndIf;
		
		XDTOData.Insert(AttributeName, New Structure("Value, OCRName",
			Individual,
			"Catalog_Persons_Send"));
	Else
		XDTOData.Insert(AttributeName, Common.ObjectAttributeValue(
			EmployeeInCharge_, "Description"));
	EndIf;
EndProcedure
