Procedure PCO_Document_SBDSSettlementsWithEmployees_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	ConvertNumberToFormat11(ExchangeComponents, IBData, XDTOData);
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	IBDivision = IBData["Department"];
	If ValueIsFilled(IBDivision) Then
		UnloadDivision(IBData, XDTOData, IBDivision, "Department");
	Else
		UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	ThisIsWE = Not GetFunctionalOption("LocalizationRFService");
	
	FillInDataOfIncomingSBDsDocument(IBData, XDTOData);
	HeaderData_ = IBData.AdditionalProperties.HeaderData_;
	XDTOData.Insert("ARAPType", HeaderData_.ARAPType);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7")
		And ValueIsFilled(IBData.PaymentRequest) Then
		XDTOData.Insert("RequestForSpendingFunds", IBData.PaymentRequest);
	EndIf;
	
	TabDecryption = New ValueTable;
	TabDecryption.Columns.Add("CFItem");
	TabDecryption.Columns.Add("Sum"); 
	TabDecryption.Columns.Add("Employee");
	TabDecryption.Columns.Add("EmployeeSBankAccount");
	
	If IBData.ARAPDetails.Count() > 0 Then
		For Each String In IBData.ARAPDetails Do
			NewRow = TabDecryption.Add();
			NewRow.CFItem = String.CashFlowItem;
			NewRow.Sum = String.Sum;
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
				If ThisIsUT() Or ThisIsWE Then
					NewRow.Employee = IBData.AdvanceHolder;
				Else
					NewRow.Employee = ?(ValueIsFilled(String.EmployeeLoanAgreement.Individual), String.EmployeeLoanAgreement.Individual,IBData.AdvanceHolder);
				EndIf;
				If Not ValueIsFilled(NewRow.Employee) Then
					NewRow.Employee = Catalogs.Persons.EmptyRef();
				EndIf;
			EndIf;
		EndDo;
	Else
		NewRow = TabDecryption.Add();
		NewRow.CFItem = IBData.CashFlowItem;
		NewRow.Sum = IBData.DocumentAmount;  
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then  
			 NewRow.Employee = IBData.AdvanceHolder;
		EndIf;
	EndIf;
	
	XDTOData.Insert("ARAPDetails", TabDecryption);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.5")
		And ValueIsFilled(IBData.IncomeKindCode) Then
		XDTOData.Insert("IncomeKindCode", IBData.IncomeKindCode);
	EndIf;
EndProcedure

