Procedure PCO_Doc_OtherRegistration_Decommissioning___WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.PutOutOfOperation; 
	
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products",        "Products");
	FillingRules.Insert("Count",          "Count");
	FillingRules.Insert("Price",                "Price");
	FillingRules.Insert("Sum",               "Sum");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	FillingRules.Insert("DocumentTransfers_",    "DocumentTransfers_");
	FillingRules.Insert("Individual",      "Individual");
	FillingRules.Insert("AssetID",    "AssetID");
	
	FillingRules.Insert("IncomeItem",       "IncomeItem");
	FillingRules.Insert("CostItem",        "CostItem");
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
	    FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
	    FillingRules.Insert("CCDNumber", "CCDNumber");
	EndIf;
	
	ArrayOfRows = New Array;
	For Each String In XDTOData.Goods Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		If StringDataStructure.Property("NumberOfPackages") Then
		    If StringDataStructure.Property("Package") And StringDataStructure.Property("Sum") Then
				StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
			EndIf;
		Else
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf;	
		
		If StringDataStructure.Property("IncomeItem") Then
			StringDataStructure.Insert("ExpenseAndIncomeItem", New Structure("Value, OCRName",
				StringDataStructure.IncomeItem, "Catalog_IncomeItems"));
		ElsIf StringDataStructure.Property("CostItem") Then
			StringDataStructure.Insert("ExpenseAndIncomeItem", New Structure("Value, OCRName",
				StringDataStructure.CostItem, "Catalog_ExpenseItems"));
		EndIf;
		
		ArrayOfRows.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	
	#EndRegion
EndProcedure
Procedure PCO_Doc_OtherRegistration_Decommissioning___BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
	DocumentRef = ?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref);
	ImportAdditionalInfo(DocumentRef, ReceivedData.AdditionalProperties, ExchangeComponents);
	
	
	If IBData <> Undefined Then
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
		
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Package");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("Individual");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
				ReceivedData.Goods,
				IBData.Goods,
				KeyFieldsArray,
				Undefined,
				"Count, NumberOfPackages, Price, Sum, ExpenseAndIncomeItem, QuantityByGBRN, CCDNumber");
		
		IBData.Goods.Load(ReceivedData.Goods.Unload());
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If Not ValueIsFilled(DataToWriteToIB.Currency) Then
		DataToWriteToIB.Currency = LocalAccountingCurrency(DataToWriteToIB.Organization);
	EndIf;
	
	For Each String In DataToWriteToIB.Goods Do
		If Not ValueIsFilled(String.RowID) Then
			String.RowID = New UUID;
		EndIf;
	EndDo;
EndProcedure

