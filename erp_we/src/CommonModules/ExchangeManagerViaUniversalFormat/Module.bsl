#Region Internal
#Region ConversionProcedures
// The procedure performed before starting data conversion.
//
// Parameters:
//  ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//
Procedure BeforeConvert(ExchangeComponents) Export
	BeforeConvertingUTKAUP(ExchangeComponents);
EndProcedure

// The procedure performed after data conversion.
//
// Parameters:
//   ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//
Procedure AfterConvert(ExchangeComponents) Export
	AfterConvertingUTKAUP(ExchangeComponents);
EndProcedure

// The procedure performed before the start of deferred filling of objects.
//
// Parameters:
//   ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//
Procedure BeforeDeferredFilling(ExchangeComponents) Export
	BeforeDelayedFillingOfUTKAUP(ExchangeComponents);
EndProcedure

// The procedure that is performed when an object is deleted.
//
// Parameters:
//   ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//   RemovableObject - DocumentObject - The data object being deleted
//
Procedure BeforeProcessingObjectBeingDeleted(ExchangeComponents, RemovableObject) Export
	SetModeOfCarryingOutDocumentsUTKAUP(RemovableObject);
EndProcedure

#EndRegion
// Returns the format version of the exchange manager.
//
// Returns:
//  String - version number.
//   1 - Basic features
//   2 - Advanced conversion capabilities for properties of table parts and common composite properties. For BSP 2.4.1 and above
//   3 - only headers are bypassed when initializing the PKS.
Function ExchangeManagerFormatVersion() Export
	Return "2";
EndFunction

