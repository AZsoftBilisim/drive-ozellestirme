Procedure DownloadTSDebtAdjustment(ExchangeComponents, XDTOData, ReceivedData, NameOfTSFormat, DocumentTSName, FillingRules)
	ArrayOfStringsDebt = New Array;
	
	If XDTOData.Property(NameOfTSFormat)
		And ValueIsFilled(XDTOData[NameOfTSFormat]) Then
		For Each String In XDTOData[NameOfTSFormat] Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			StringDataStructure.Insert("Organization", ReceivedData.Organization);
			If ValueIsFilled(String.ARAPCurrency) Then
				If TypeOf(String.ARAPCurrency) = Type("Structure")
					And Not String.ARAPCurrency.Property("Ref") Then
					OCRName = "Catalog___FromStructure";
				Else
					OCRName = "Catalog_Currencies";
				EndIf;
				StringDataStructure.Insert("ARAPCurrency", New Structure("Value, OCRName", String.ARAPCurrency, OCRName));
			EndIf;
			If ValueIsFilled(String.ARAPType) Then
				PaymentType_ = Undefined;
				If String.ARAPType.Value = "WithCustomer" Then
					PaymentType_ = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting;
				ElsIf String.ARAPType.Value = "WithVendor" Then
					PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
				EndIf;
				If PaymentType_ <> Undefined Then
					StringDataStructure.Insert("PaymentType_",PaymentType_);
				EndIf;
			EndIf; 
			CalculationDocumentCompleted = False;
			If ValueIsFilled(String.DocumentOfARAPAccounting) Then
				DocumentOfARAPAccounting = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, String.DocumentOfARAPAccounting);
				If ValueIsFilled(DocumentOfARAPAccounting) Then
					StringDataStructure.Insert("DocumentOfARAPAccounting", DocumentOfARAPAccounting);
					CalculationDocumentCompleted = True
				EndIf;
			EndIf;
			If CalculationDocumentCompleted = False And ValueIsFilled(String.Contract) Then
				If TypeOf(String.Contract) = Type("Structure")
					And String.Contract.Property("Ref") = False Then
					OCRName = "Catalog_ContractsOfCounterparties_FromStructure__";
				Else
					OCRName = "Catalog_CounterpartyContracts_Receive";
				EndIf;
				DocumentOfARAPAccounting = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, String.Contract);
				If ValueIsFilled(DocumentOfARAPAccounting) Then
					StringDataStructure.Insert("DocumentOfARAPAccounting", DocumentOfARAPAccounting);
				EndIf;
			EndIf;
			ArrayOfStringsDebt.Add(StringDataStructure);
		EndDo;
	EndIf;
	If ArrayOfStringsDebt.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert(DocumentTSName, ArrayOfStringsDebt);
	EndIf;
EndProcedure
