Procedure DPR_Document_PaymentRequest_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	 
	ApplicationForRegisterOfSelfEmployed = IBData.OperationWithSelfEmployedPerson And IBData.ListOfCounterparties_;
	 
	If (IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToVendor 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany
		Or IBData.BusinessOperation = Enums.BusinessTransactions.DeletePaymentToSelfEmployedPerson)
		And Not ApplicationForRegisterOfSelfEmployed Then
		UsageOCR.Document_RequestForCashExpenseSettlementsWithCOMT_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee 
		And ValueIsFilled(IBData.AdvanceHolder) And IBData.ARAPDetails.Count() > 0 Then
		UsageOCR.Document_ApplicationForCashExpenseSettlementsWithSOTR_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfTaxesAndContributions Then
		UsageOCR.Document_RequestForTransferOfDSVBudget_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CustomsPayment Then
		UsageOCR.Document_RequestForTransferOfDSVBudget_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
		UsageOCR.Document_RequestForCashExpense_Transfer_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.SalaryPayment Then
		UsageOCR.Document_ApplicationForCashExpenditureSalaryPayment_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToLessor Then
		UsageOCR.Document_RequestForCashOther_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PaymentOnLoansAndBorrowingsReceived Then
		UsageOCR.Document_RequestForCashOther_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferToDeposits Then
		UsageOCR.Document_RequestForCashOther_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToCounterparty Then
		UsageOCR.Document_RequestForCashOther_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		UsageOCR.Document_ApplicationForExpenditureOfCashConvCurrency_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue Then
		UsageOCR.Document_RequestForCashOther_Sending = True;
	EndIf;
EndProcedure

