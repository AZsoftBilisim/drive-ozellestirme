Procedure OCR_Document_PurchaseOrder_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted    = True;
	ReceivedData.Approved  = True;
	ReceivedData.BusinessOperation  = Enums.BusinessTransactions.PurchaseFromSupplier;
	If GetFunctionalOption("UsePurchaseOrderStatuses") Then
		ReceivedData.Status  = Enums.PurchaseOrderStatuses.Approved;
	Else
		ReceivedData.Status  = Enums.PurchaseOrderStatuses.Closed;
	EndIf;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	
	FillingRules = New Map;
	FillingRules.Insert("Products",   "Products");
	FillingRules.Insert("SKUCounterparty_", "PartnerProducts");
	FillingRules.Insert("Count",     "Count");
	FillingRules.Insert("Sum",          "Sum");
	FillingRules.Insert("Price",           "Price");
	FillingRules.Insert("VATRate",      "VATRate");
	FillingRules.Insert("VATAmount",       "VATAmount");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	FillingRules.Insert("ExpectedDeliveryDate", "DateOfReceipt");
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	UploadContactPersonToReceivedData(XDTOData, ReceivedData);
	OneDateReceipt = False;
	If XDTOData.Property("ShipEntireOrder") Then
		OneDateReceipt = XDTOData.ShipEntireOrder;
	EndIf;
	
	ReceivedData.OneDateReceipt = OneDateReceipt;
		
	DateHeaderWasReceived = Date(1,1,1,0,0,0);
	
	AttributeNameDateOfDelivery = "ExpectedDeliveryDate";
	
	If  NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
		AttributeNameDateOfDelivery = "DeliveryDateFromSupplier";
	EndIf;
	
	If XDTOData.Property(AttributeNameDateOfDelivery) And ValueIsFilled(XDTOData[AttributeNameDateOfDelivery]) Then
		DateHeaderWasReceived = XDTOData[AttributeNameDateOfDelivery];
	EndIf;
	
	// Goods 
	ArrayOfRows = New Array;  
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
		
		For Each String In XDTOData.Goods Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			If StringDataStructure.Property("NumberOfPackages") And StringDataStructure.NumberOfPackages Then
			    If StringDataStructure.Property("Package") And StringDataStructure.Property("Sum") Then
					StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
				EndIf;
			Else
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;  
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
	
			If OneDateReceipt = True Or Not StringDataStructure.Property("DateOfReceipt") Then
				StringDataStructure.Insert("DateOfReceipt", DateHeaderWasReceived);
			Else
				DateHeaderWasReceived = Max(DateHeaderWasReceived, Date(StringDataStructure.DateOfReceipt));
			EndIf;
	
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	// Services are loaded into PM Goods with a different type of inventory.
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
	
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
	
			If OneDateReceipt = True Or Not StringDataStructure.Property("DateOfReceipt") Then
				StringDataStructure.Insert("DateOfReceipt", DateHeaderWasReceived);
			Else
				DateHeaderWasReceived = Max(DateHeaderWasReceived, Date(StringDataStructure.DateOfReceipt));
			EndIf;
	
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	If Not ValueIsFilled(ReceivedData.RequestedDeliveryDate) Then
		ReceivedData.RequestedDeliveryDate = DateHeaderWasReceived;
	EndIf;
		
	ReceivedData.DateOfReceipt = DateHeaderWasReceived;
		
	
	// The stages of payment schedule
	If XDTOData.Property("PaymentSteps")
		And ValueIsFilled(XDTOData.PaymentSteps) Then
		
		FillingRules = New Map;
		FillingRules.Insert("PaymentOption", "PaymentOption");
		FillingRules.Insert("PaymentDate", "PaymentDate");
		FillingRules.Insert("PaymentPercentage","PaymentPercentage");
		FillingRules.Insert("NumberOfDaysOfDeferral", "Move");
		FillingRules.Insert("PaymentAmount", "PaymentAmount");
		
		XDTOData.Insert("PaymentMethod", XDTOData.PaymentSteps[0].PaymentMethod);
		
		PaymentScheduleSteps = New Array;
		For Each XDTOPaymentStage In XDTOData.PaymentSteps Do
			PaymentScheduleStage = CollectionDataAsStructure(XDTOPaymentStage, FillingRules);
	
			PaymentScheduleSteps.Add(PaymentScheduleStage);
		EndDo;
	
		If PaymentScheduleSteps.Count() > 0 Then
			ReceivedData.AdditionalProperties.Insert("PaymentScheduleSteps", PaymentScheduleSteps);
		EndIf;
	EndIf;
EndProcedure
Procedure OCR_Document_PurchaseOrder_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	FillInDefaultCountOption(ReceivedData.PaymentScheduleSteps);
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
	
	If IBData <> Undefined Then
		// We transfer those properties that are specified in the PKS
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
		
		// Goods
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("VATRate");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.Goods,
			IBData.Goods,
			KeyFieldsArray,
			Undefined,
			"Count, Package, NumberOfPackages, Price, Sum, VATAmount, AmountIncludingVAT,
			|PercentRateOfManualDiscount, ManualDiscount, Canceled, PartnerProducts, DateOfReceipt");
		IBData.Goods.Load(ReceivedData.Goods.Unload());
		
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If Not ValueIsFilled(DataToWriteToIB.DeliveryMethod) Then
		DataToWriteToIB.DeliveryMethod = Enums.TransportMethods.ByVendorToOurWarehouse;
	EndIf;
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
EndProcedure

