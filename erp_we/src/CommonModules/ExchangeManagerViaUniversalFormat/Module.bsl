Procedure PCO_Document_CInvoiceReceivedAdvance_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	
	If Not ValueIsFilled(ReceivedData.TransactionKindCode) Then
		ReceivedData.TransactionKindCode = "02";
	EndIf;
	
	If XDTOData.Property("BillingMethod") And ValueIsFilled(XDTOData.BillingMethod) Then
		ReceivedData.DigitallyReceived = (XDTOData.BillingMethod.Value = "InElectronicForm");
	EndIf;
		
	If XDTOData.Property("BasisDocuments") And ValueIsFilled(XDTOData.BasisDocuments) Then
		For Each String In XDTOData.BasisDocuments Do
	
			If ValueIsFilled(String.DocumentBasis) And TypeOf(String.DocumentBasis) = Type("Structure") Then
				DocBasis = ValueInICOInstruction(ExchangeComponents, String.DocumentBasis);
				If DocBasis <> Undefined Then
					ReceivedData.AdditionalProperties.Insert("DocumentBasis", DocBasis);
					Break;
				EndIf;
			EndIf;
		EndDo;
	EndIf;
	
	FillingRules = New Map;
	FillingRules.Insert("VATRate", "VATRate");
	FillingRules.Insert("Sum",     "Sum");
	FillingRules.Insert("VATAmount",  "VATAmount");
	
	ArrayOfRowsAdvances = New Array;
	
	If XDTOData.Property("Prepayments")
		And ValueIsFilled(XDTOData.Prepayments) Then
	
		For Each String In XDTOData.Prepayments Do		
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			
			ArrayOfRowsAdvances.Add(StringDataStructure);		
		EndDo;
	
		ReceivedData.AdditionalProperties.Insert("Prepayments", ArrayOfRowsAdvances);
	EndIf;
EndProcedure
Procedure PCO_Document_CInvoiceReceivedAdvance_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If Not ValueIsFilled(DataToWriteToIB.VATTaxation) Then
		DataToWriteToIB.VATTaxation = Enums.VATTaxationTypes.SaleIsSubjectToVAT;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.RecordingInAccountingDate) Then
		DataToWriteToIB.RecordingInAccountingDate = 
			?(DataToWriteToIB.VATTaxation = Enums.VATTaxationTypes.SubjectToVATAtCustomer,
				DataToWriteToIB.DateCreated,
				DataToWriteToIB.Date);
	EndIf;
EndProcedure

