Procedure OCR_Document_ProformaInvoice_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted    = True;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);  
	
	#Region PaymentScheduleSteps
	If XDTOData.Property("PaymentSteps")
		And ValueIsFilled(XDTOData.PaymentSteps)
		And XDTOData.PaymentSteps.Count() > 0 Then
		
		ThereIsColumnFormOfPayment = XDTOData.PaymentSteps.Columns.Find("PaymentMethod") <> Undefined; 
		
		If ThereIsColumnFormOfPayment Then
			
			XDTOData.Insert("PaymentMethod", XDTOData.PaymentSteps[0].PaymentMethod);
			
		EndIf;
		
		FillingRules = New Map;
		
		FillingRules.Insert("PaymentDate", "PaymentDate");
		FillingRules.Insert("PaymentPercentage", "PaymentPercentage");
		FillingRules.Insert("PaymentAmount", "PaymentAmount");
		
		PaymentScheduleSteps = New Array;
		
		For Each XDTOPaymentStage In XDTOData.PaymentSteps Do
			
			PaymentScheduleStage = CollectionDataAsStructure(XDTOPaymentStage, FillingRules);
			
			// If the percentage of payment = 0, we consider it a pledge for the container
			If Not PaymentScheduleStage.Property("PaymentPercentage") Then
				
				PaymentScheduleStage.Insert("ThisIsDepositForPackage", True);
				
			EndIf;	
			
			PaymentScheduleSteps.Add(PaymentScheduleStage);
			
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("PaymentScheduleSteps", PaymentScheduleSteps);	
		
	EndIf;
	#EndRegion
EndProcedure
Procedure OCR_Document_ProformaInvoice_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData <> Undefined Then
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData); 
		
		// With partial payment, it is possible to edit the stages of the schedule
		//	otherwise, the stages are filled in from the foundation document.
		If IBData.PartialPayment 
			And ReceivedData.PaymentScheduleSteps.Count() > 0 Then
			
			IBData.PaymentScheduleSteps.Load(ReceivedData.PaymentScheduleSteps.Unload());	
			
		EndIf;
		
		ReceivedData = Undefined; 
		
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
EndProcedure


