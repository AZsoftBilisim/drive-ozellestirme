Function CheckDebtTablesForAmountOfReg(Document)
	Query = New Query;
	Query.Text = 
		"SELECT
		|	ARAPSettlementAccountsReceivable.SumCompl AS SumCompl
		|FROM
		|	Document.ARAPSettlement.AccountsReceivable AS ARAPSettlementAccountsReceivable
		|WHERE
		|	ARAPSettlementAccountsReceivable.SumCompl = 0
		|	AND ARAPSettlementAccountsReceivable.Ref = &Ref
		|
		|UNION ALL
		|
		|SELECT
		|	ARAPSettlementAccountsPayable.SumCompl
		|FROM
		|	Document.ARAPSettlement.AccountsPayable AS ARAPSettlementAccountsPayable
		|WHERE
		|	ARAPSettlementAccountsPayable.SumCompl = 0
		|	AND ARAPSettlementAccountsPayable.Ref = &Ref";
	
	Query.SetParameter("Ref", Document);
	QueryResult = Query.Execute();
	If Not QueryResult.IsEmpty() Then
	    Return True;
	EndIf; 
	Return False;
EndFunction
Function CheckFoundationDocument(IBData, DocumentBasis, UsageOCR, ExchangeComponents)
	// Unloading of some types of documents is not supported, and on versions of the ED format up to 1.7 it is not possible
	// to correctly unload the "primary document".
	If TypeOf(DocumentBasis) = Type("DocumentRef.ReturnablePackagingRedemptionByCustomer")
		Or TypeOf(DocumentBasis) = Type("DocumentRef.RedemptionOfGoodsByCustodian")
		Or (TypeOf(DocumentBasis) = Type("DocumentRef.SourceDocument")
			And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7")) 
		Or CommonClientServer.HasAttributeOrObjectProperty(IBData, "SalesViaCommissionAgent") And IBData.SalesViaCommissionAgent 
			And ((TypeOf(DocumentBasis) = Type("DocumentRef.ReturnOfGoodsFromCustomer") 
				And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.20"))
				Or ((TypeOf(DocumentBasis) = Type("DocumentRef.CustomerInvoice") 
					And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17")))) Then
				
		ClearUsageOCR(UsageOCR);
		
		WarningTemplate = NStr("vi = 'Không thể kết xuất chứng từ %1
			|bởi vì định dạng trao đổi không hỗ trợ kết xuất chứng từ
			|mà đã chỉ ra %2 là chứng từ cơ sở.';
			|ru = 'Документ %1 не может быть выгружен,
			|т.к. формат обмена не поддерживает выгрузку документа,
			|для которых в качестве документа-основания указан %2.';
			|en = 'The %1 document cannot be exported
			|because the exchange format does not support the export of documents
			|for which %2 is specified as the base document.'; fa = 'The %1 document cannot be exported
			|because the exchange format does not support the export of documents
			|for which %2 is specified as the base document.';
			|it = 'Il documento %1 non può essere caricato,
			|poiché il formato di scambio non supporta l''upload del documento
			| il cui documento base indicato è %2.';
			|pl = 'Dokument %1 nie może być wyeksportowany,
			|ponieważ format wymiany nie obsługuje eksportowania dokumentu,
			|dla których jako dokument źródłowy jest podany %2.';
			|tr = '%1 belgesi yüklenemez
			|çünkü değişim biçimi, temel belge olarak %2''nin belirtildiği
			|belgelerin yüklenmesini desteklemiyor.'");
			
		WarningText = StrTemplate(WarningTemplate, IBData.Ref, String(TypeOf(DocumentBasis)));
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
		Return False;
	
	Else
		Return True;
	EndIf;
EndFunction



Procedure CheckUpdateItemDetails(ObjectReference, AttributesValues, ExchangeComponents)
	// "Requirements values" is a structure where the Key is the name of the props, the Value is the value of the props.
	
	If ValueIsFilled(ObjectReference) And Common.RefExists(ObjectReference) Then
		
		VerificationDetails_1 = "";
		For Each StructureItem In AttributesValues Do
			VerificationDetails_1 = VerificationDetails_1 + ?(VerificationDetails_1="", "",", ") + StructureItem.Key;	
		EndDo;
		
		ObjectAttributes = Common.ObjectAttributesValues(ObjectReference, VerificationDetails_1);
		
		If Not Common.IdenticalCollections(AttributesValues, ObjectAttributes) Then
			Object = ObjectReference.GetObject();
			
			For Each StructureItem In AttributesValues Do
				Object[StructureItem.Key] = StructureItem.Value;	
			EndDo;
			
			Object.DataExchange.Load = True;
	
			Try
				Object.Write();
			Except
				WriteErrorToEventLog(ObjectReference,
					DetailErrorDescription(ErrorInfo()), ExchangeComponents);
			EndTry;
		EndIf;
			
	EndIf;
EndProcedure

Procedure CheckResultOfDocumentDataExchange(DataToWriteToIB, CorrespondentNode, DocumentType)
	If Not DataToWriteToIB = Undefined And (Common.RefExists(DataToWriteToIB.Ref) Or 
			TypeOf(DataToWriteToIB) = Type(DocumentType))Then 
		MapItemAvailableByFederalDistrict = Common.MetadataObjectAvailableByFunctionalOptions(DataToWriteToIB.Metadata());
		If Not MapItemAvailableByFederalDistrict Then
			MessageText = "";
			CheckStateOfFunctionalOptionsBasedOnDocuments(DataToWriteToIB.Metadata().Synonym, MessageText);
			If Not IsBlankString(MessageText) Then
			    If TypeOf(DataToWriteToIB) = Type("Structure") Then
					Return;
				EndIf;
				IssueType = Enums.DataExchangeIssuesTypes.HandlersCodeExecutionErrorOnGetData;
							
				If Common.IsRefTypeObject(DataToWriteToIB.Metadata()) Then
					InformationRegisters.DataExchangeResults.RecordDocumentCheckError(
						DataToWriteToIB.Ref,
						CorrespondentNode,
						MessageText,
						IssueType);
				Else
					InformationRegisters.DataExchangeResults.RecordDocumentCheckError(
						DataToWriteToIB,
						CorrespondentNode,
						MessageText,
						IssueType);
				EndIf;
			EndIf;  
		EndIf;
	EndIf;
EndProcedure
Procedure CheckStateOfFunctionalOptionsBasedOnDocuments(MetadataName, MessageText)
	FunctionalOptions = Metadata.FunctionalOptions;  
	Parameters = New Structure(StandardSubsystemsCached.InterfaceOptions());
	For Each FederalDistrict In FunctionalOptions Do
		For Each ElementValue In FederalDistrict.Content Do
			If Type(FederalDistrict.Location.Type) = Type("Boolean") And String(ElementValue.Object) = MetadataName Then
				FOIsEnabled = GetFunctionalOption(FederalDistrict.Name, Parameters);
				If Not FOIsEnabled Then
					ErrorText = NStr("vi = ' Trong tùy chỉnh kế toán đã ngắt tùy chọn chức năng ""%1"" chứng từ ""%2"" sẽ được kết nhập,
					| nhưng không được phép để xem.';
					|ru = ' В настройках учета отключена функциональная опция  ""%1"", документы ""%2"" будут загружены,
					| но недоступны для просмотра.';
					|en = ' In the accounting settings, the %1 functional option is disabled. The %2 documents will be imported
					| but unavailable to view.'; fa = ' In the accounting settings, the %1 functional option is disabled. The %2 documents will be imported
					| but unavailable to view.';
					|it = ' В настройках учета отключена функциональная опция  ""%1"", документы ""%2"" будут загружены,
					| но недоступны для просмотра.';
					|pl = ' In the accounting settings, the %1 functional option is disabled. The %2 documents will be imported
					| but unavailable to view.';
					|tr = ' Muhasebe ayarlarında ""%1"" işlev seçeneği devre dışı bırakıldı, ""%2"" belgeleri yüklenecek,
					| ancak görüntülenemiyor.'", Common.DefaultLanguageCode());
					ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText,
					FederalDistrict.Synonym, MetadataName);
				EndIf;
				MessageText = MessageText + ErrorText;
			EndIf;
		EndDo;
	EndDo;
EndProcedure
Procedure CheckStateOfFunctionalOptionsByName(FONames, ErrorsText)
	ErrorsArray = New Array;
	
	For Each FOName In FONames Do
		FOMetadata = Metadata.FunctionalOptions.Find(FOName);
	
		If FOMetadata = Undefined Then
			Continue;
		EndIf;
	
		If Type(FOMetadata.Location.Type) = Type("Boolean") Then
	
			If Not GetFunctionalOption(FOMetadata.Name) Then
				ErrorText = NStr("vi = 'Trong tùy chỉnh kế toán đã tắt tùy chọn chức năng ""%1""';
								|ru = 'В настройках учета отключена функциональная опция  ""%1""';
								|en = 'In the accounting settings, the ""%1"" functional option is disabled'; fa = 'In the accounting settings, the ""%1"" functional option is disabled';
								|it = 'В настройках учета отключена функциональная опция  ""%1""';
								|pl = 'In the accounting settings, the ""%1"" functional option is disabled';
								|tr = 'Muhasebe ayarlarında ""%1"" fonksiyonel seçeneği devre dışı bırakıldı'",
					Common.DefaultLanguageCode());
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, FOMetadata.Synonym);
				
				ErrorsArray.Add(ErrorText);
			EndIf;
	
		EndIf;
	
	EndDo;
	ErrorsText = StrConcat(ErrorsArray, Chars.LF);
EndProcedure
Procedure CheckingFillingInRequiredAttributesOfInformationSecurityObject(DataObject, ExchangeComponents, UsageOCR, AttributesSynonyms = Undefined, AdditionallyVerifiedBankingDetails = Undefined)
	If TypeOf(DataObject) = Type("Structure") Then
		Return;
	EndIf;
	
	If AttributesSynonyms = Undefined Then
		AttributesSynonyms = New Map;
	EndIf;
	
	If AdditionallyVerifiedBankingDetails = Undefined Then
		AdditionallyVerifiedBankingDetails = New Structure;
	EndIf;
	
	VerifiableStandardDetails = New Structure;
	
	VerifiableStandardDetails.Insert("Catalogs", New Array);
	VerifiableStandardDetails["Catalogs"].Add("Code");
	VerifiableStandardDetails["Catalogs"].Add("Description");
	VerifiableStandardDetails["Catalogs"].Add("Owner");
	
	VerifiableStandardDetails.Insert("Documents", New Array);
	VerifiableStandardDetails["Documents"].Add("Number");
	VerifiableStandardDetails["Documents"].Add("Date");
	
	VerifiableStandardDetails.Insert("ChartsOfCharacteristicTypes", New Array);
	VerifiableStandardDetails["ChartsOfCharacteristicTypes"].Add("Code");
	VerifiableStandardDetails["ChartsOfCharacteristicTypes"].Add("Description");
	
	VerifiableStandardDetails.Insert("InformationRegisters", New Array);
	VerifiableStandardDetails["InformationRegisters"].Add("Period");
	VerifiableStandardDetails["InformationRegisters"].Add("Recorder");
	
	MD = DataObject.Metadata();
	ObjectKind = Common.BaseTypeNameByMetadataObject(MD);
	
	ObjectAttributes            = MD.Attributes;
	StandardObjectDetails = MD.StandardAttributes;
	
	VerifiableStandardObjectDetails = Undefined;
	If Not VerifiableStandardDetails.Property(ObjectKind, VerifiableStandardObjectDetails) Then
		VerifiableStandardObjectDetails = New Array;
	EndIf;
	
	For Each KeyValue In UsageOCR Do
		
		If Not KeyValue.Value Then
			Continue;
		EndIf;
			
		ErrorText    = "";
		CurICO         = DataExchangeXDTOServer.OCRByName(ExchangeComponents, KeyValue.Key);
		XDTOObjectType = XDTOFactory.Type(ExchangeComponents.XMLSchema, CurICO.FormatObject);
		
		RequiredFormatProperties = New Array;
		
		For Each CurProperty In XDTOObjectType.Properties Do
			
			If CurProperty.Name = "KeyProperties" Or CurProperty.Name = "SharedData" Then
				
				For Each KeyProperty_ In CurProperty.Type.Properties Do
					If KeyProperty_.LowerBound > 0 Then
						RequiredFormatProperties.Add(KeyProperty_.Name);
					EndIf
				EndDo;
				
			ElsIf CurProperty.LowerBound > 0 Then
				RequiredFormatProperties.Add(CurProperty.Name);
			EndIf
			
		EndDo;
		
		// We check the required format properties
		// , which are not filled in using the conversion algorithm,
		// and have a direct comparison of the configuration details and format properties.
		// Additionally, the verification of the details is called, which are transmitted separately
		// in the structure of the additional verifiedrequests.
		For Each CurPCR In CurICO.Properties Do
			
			If (Not CurPCR.UsesConversionAlgorithm
				And ValueIsFilled(CurPCR.ConfigurationProperty)
				And StrFind(CurPCR.ConfigurationProperty, ".") = 0
				And RequiredFormatProperties.Find(CurPCR.FormatProperty) <> Undefined)
				Or (ValueIsFilled(AdditionallyVerifiedBankingDetails) And AdditionallyVerifiedBankingDetails.Property(CurPCR.ConfigurationProperty)) Then
				
				If (VerifiableStandardObjectDetails.Find(CurPCR.ConfigurationProperty) <> Undefined
						Or Common.IsStandardAttribute(StandardObjectDetails, CurPCR.ConfigurationProperty))
					And Not ValueIsFilled(DataObject[CurPCR.ConfigurationProperty]) Then
					
					MdDetails = StandardObjectDetails;
							
				ElsIf ObjectAttributes.Find(CurPCR.ConfigurationProperty) <> Undefined
					And (ObjectAttributes[CurPCR.ConfigurationProperty].FillChecking = FillChecking.ShowError
						Or AdditionallyVerifiedBankingDetails.Property(CurPCR.ConfigurationProperty))
					And Not ValueIsFilled(DataObject[CurPCR.ConfigurationProperty]) Then
					
					MdDetails = ObjectAttributes;
					
				Else
					Continue;
				EndIf;
				
				AttributeRepresentation = MdDetails[CurPCR.ConfigurationProperty].Synonym;
				
				If Not ValueIsFilled(AttributeRepresentation) Then 
					AttributeRepresentation = MdDetails[CurPCR.ConfigurationProperty].Name;
				EndIf;
				
				ErrorText = ErrorText + Chars.LF + "- "
					+ ?(AttributesSynonyms[CurPCR.ConfigurationProperty] <> Undefined,
						AttributesSynonyms[CurPCR.ConfigurationProperty], AttributeRepresentation) + ",";
				
			EndIf;
		EndDo;
		
		If ValueIsFilled(ErrorText) Then
			
			ErrorText = Mid(ErrorText, 1, StrLen(ErrorText)-1) + ".";
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(NStr("vi = 'Trong đối tượng %1 ""%2"" chưa điền mục tin:';
																						|ru = 'В объекте %1 ""%2"" не заполнены реквизиты:';
																						|en = 'Attributes are not filled in the %1 ""%2"" object:'; fa = 'Attributes are not filled in the %1 ""%2"" object:';
																						|it = 'В объекте %1 ""%2"" не заполнены реквизиты:';
																						|pl = 'Attributes are not filled in the %1 ""%2"" object:';
																						|tr = '%1 ""%2"" nesnesinde öznitelikler doldurulmadı:'"), TypeOf(DataObject.Ref),DataObject) + ErrorText;
			DataExchangeXDTOServer.WriteEventLogDataExchange1(ErrorText, ExchangeComponents, , DataObject.Ref);
			
			UsageOCR[KeyValue.Key] = False;
					
		EndIf;
	EndDo;
EndProcedure


Procedure PTiY_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	If ValueIsFilled(ReceivedData.Counterparty) And Not ValueIsFilled(ReceivedData.Partner) Then
		ReceivedData.Partner = Common.ObjectAttributeValue(ReceivedData.Counterparty, "Partner");
	EndIf;
	If Not ValueIsFilled(ReceivedData.Partner)
			And Not GetFunctionalOption("UsePartnersAndCounterparties") Then
		ReceivedData.Partner = Catalogs.Partners.UnknownPartner;
	EndIf;
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
	SeriesUponReceipt = 0;
	If IBData <> Undefined Then
		GoodsBatch = IBData.Goods.Unload();
		WarehouseInformationSecurityData = IBData.Warehouse;
	
		// We transfer those properties that are specified in the PKS
		ExcludedFieldsOfItemHeader = New Array;
		If ValueIsFilled(IBData.PurchaseOrder) Then
			ExcludedFieldsOfItemHeader.Add("PurchaseOrder");
			ExcludedFieldsOfItemHeader.Add("ReceiptUnderOrders");
		EndIf;
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData, ExcludedFieldsOfItemHeader);
		
		If Not ExchangeComponents.ConversionParameters_SSLy.UploadAnalyticsByWarehouse Then
			// Restoring the warehouse from the original document
			IBData.Warehouse = WarehouseInformationSecurityData;
		EndIf;
		
		// Goods
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("Warehouse");
		KeyFieldsArray.Add("VATRate");
		KeyFieldsArray.Add("CCDNumber");
		KeyFieldsArray.Add("Department");
		KeyFieldsArray.Add("ExpenseItem");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
				ReceivedData.Goods,
				IBData.Goods,
				KeyFieldsArray,
				"DimensionOfExpenses, PurchaseOrder, Certificate, PassportNumber, ToExpenseAs, BatchesIndicationStatus",
				Undefined);
	
		IBData.Goods.Load(ReceivedData.Goods.Unload());
	
		SeriesUponReceipt = ReceivedData.SetOfSeries.Count(); 
		RecipientSSeries = SeriesUponReceipt = 0 And IBData.SetOfSeries.Count() > 0;
		For Each String In IBData.Goods Do
			String.Warehouse = IBData.Warehouse;
			If RecipientSSeries Then
				FoundRow = GoodsBatch.Find(String.RowID, "RowID");
				If Not FoundRow = Undefined Then
					String.BatchesIndicationStatus = FoundRow.BatchesIndicationStatus;
				EndIf; 
			EndIf;
		EndDo;	
		ReceivedData = Undefined;
	Else
		If TypeOf(ReceivedData) = Type("DocumentObject.VendorInvoice") 
			And Common.HasObjectAttribute("NewWayToCreateApplicationForGoodsImportFromEAEU",ReceivedData.Metadata()) Then
			ReceivedData.NewWayToCreateApplicationForGoodsImportFromEAEU = True;
		EndIf;
		
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	For Each String In DataToWriteToIB.Goods Do
		If Not ValueIsFilled(String.Products) Then
			String.Products = DefaultElement(ExchangeComponents, "ProductsService1_");
		EndIf;
	EndDo;
	
	If DataToWriteToIB.Currency = DataToWriteToIB.ARAPCurrency Then
		DataToWriteToIB.CourseNumerator = 1;
		DataToWriteToIB.CourseDenominator = 1;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.ARAPCurrency) Then
		PurchaseTermsKeys			= "ConsiderWarehouseGroups, ExcludeWarehouseGroupsAvailableInOrders, SelectedAgreement";
		SelectionOfProcurementConditions			= New Structure(PurchaseTermsKeys, True, True, DataToWriteToIB.Terms);
		DefaultPurchasingConditions	= PurchasesServer.GetDefaultPurchaseTerms(DataToWriteToIB.Partner, SelectionOfProcurementConditions);
		If DefaultPurchasingConditions <> Undefined And DefaultPurchasingConditions.Property("ARAPCurrency") Then
			DataToWriteToIB.ARAPCurrency = DefaultPurchasingConditions.ARAPCurrency;
		EndIf;	
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.GoodsReceiptOption) Then
		DataToWriteToIB.GoodsReceiptOption = PurchasesServer.GetProductAcceptanceOption(Undefined, DataToWriteToIB.Contract);
	EndIf;
EndProcedure
Function PTiU_AdvancedInformationSecurityData(ExchangeComponents, IBData)
	Result = New Structure;
		
		CurrencyOfComplianceAccounting = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
		
		Query = New Query();
		Query.SetParameter("Ref",                     IBData.Ref);
		Query.SetParameter("Date",                       IBData.Date);
		Query.SetParameter("DateOfCourse", ?(ValueIsFilled(IBData.DocumentExchangeRateDate), 
			IBData.DocumentExchangeRateDate,  IBData.Date));
		Query.SetParameter("CurrencyDoc",                  IBData.Currency);
		Query.SetParameter("CurrencyReg",                  CurrencyOfComplianceAccounting);
		Query.SetParameter("UnloadingBarcodesOfPackages", UnloadingBarcodesOfPackages(ExchangeComponents));
		
		QueriesTexts = New Array;
		
		#Region RequestFragmentDocumentHeader
		// These document caps are necessary for calculating the exchange rate and multiplicity
		// of settlements and for calculating retail prices of goods.
		DocumentHeader = "SELECT
			|	DocumentHeaderData.Warehouse.RetailPriceType AS RetailPriceType,
			|	DocumentHeaderData.Currency,
			|	DocumentHeaderData.ARAPCurrency,
			|	DocumentHeaderData.CourseNumerator AS TransactionRate,
			|	DocumentHeaderData.CourseDenominator AS Multiplier_,
			|	CASE
			|		WHEN DocumentHeaderData.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE
			|			CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryTypeByTypeOfOperation,
			|	DocumentHeaderData.VATTaxation AS VATTaxation,
			|	DocumentHeaderData.PurchaseForActivity AS PurchaseForActivity
			|INTO DocumentHeaderData
			|FROM
			|	Document.VendorInvoice AS DocumentHeaderData
			|WHERE
			|	DocumentHeaderData.Ref = &Ref";
		
		FillInYourOwnProductsInText(DocumentHeader);
		
		QueriesTexts.Add(DocumentHeader);
		#EndRegion
		
		#Region RequestFragmentOperationData
		If IBData.Currency = CurrencyOfComplianceAccounting
			Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
			OperationData =
			"SELECT
			|	DocumentHeaderData.TransactionRate AS TransactionRate,
			|	DocumentHeaderData.Multiplier_ AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData";
		Else
			OperationData =
			"SELECT
			|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
			|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
			|				&DateOfCourse,
			|				Currency IN
			|					(SELECT
			|						Doc.Currency
			|					FROM
			|						DocumentHeaderData AS Doc)
			|				AND BaseCurrency = &CurrencyReg) AS DocumentExchangeRate
			|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency";
		EndIf;
		
		QueriesTexts.Add(OperationData);
		#EndRegion
		
		#Region RequestFragmentForDocument
		If IBData.BusinessOperation = Enums.BusinessTransactions.PurchaseByImport
			Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportGoodsInTransit Then
			// Upon receipt of import, the GTD numbers are assigned later by the document "Customs Declaration".
			
			Query.Text = 
			"SELECT
			|	SetOfSeries.Ref AS Ref,
			|	SetOfSeries.LineNumber AS LineNumber,
			|	SetOfSeries.Series AS Series,
			|	SetOfSeries.Count AS Count,
			|	SetOfSeries.Products AS Products,
			|	SetOfSeries.Characteristic AS Characteristic,
			|	SetOfSeries.Purpose AS Purpose,
			|	SetOfSeries.Warehouse AS Warehouse
			|INTO TTSeries_FullSample
			|FROM
			|	Document.VendorInvoice.SetOfSeries AS SetOfSeries
			|WHERE
			|	SetOfSeries.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	SetOfSeries.Ref AS Ref,
			|	SetOfSeries.Products AS Products,
			|	SetOfSeries.Characteristic AS Characteristic,
			|	SetOfSeries.Purpose AS Purpose,
			|	SetOfSeries.Warehouse AS Warehouse,
			|	MIN(SetOfSeries.LineNumber) AS LineNumber
			|INTO TTSeries_FirstLines
			|FROM
			|	TTSeries_FullSample AS SetOfSeries
			|
			|GROUP BY
			|	SetOfSeries.Ref,
			|	SetOfSeries.Products,
			|	SetOfSeries.Characteristic,
			|	SetOfSeries.Purpose,
			|	SetOfSeries.Warehouse
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	PSSeriesTT.Ref AS Ref,
			|	SetOfSeries.Series AS Series,
			|	PSSeriesTT.Products AS Products,
			|	PSSeriesTT.Characteristic AS Characteristic,
			|	PSSeriesTT.Purpose AS Purpose,
			|	PSSeriesTT.Warehouse AS Warehouse
			|INTO TTSeries
			|FROM
			|	TTSeries_FirstLines AS PSSeriesTT
			|		LEFT JOIN TTSeries_FullSample AS SetOfSeries
			|		ON PSSeriesTT.Products = SetOfSeries.Products
			|			AND PSSeriesTT.Characteristic = SetOfSeries.Characteristic
			|			AND PSSeriesTT.Purpose = SetOfSeries.Purpose
			|			AND PSSeriesTT.Warehouse = SetOfSeries.Warehouse
			|			AND PSSeriesTT.LineNumber = SetOfSeries.LineNumber
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.LineNumber AS DocumentRowNumber,
			|	Goods.Products AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	ISNULL(CASE
			|		WHEN Goods.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
			|			THEN SetOfSeries.Series
			|		ELSE Goods.Series
			|	END, VALUE(Catalog.ItemsBatches.EmptyRef)) AS Series,
			|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
			|	Goods.Count AS Count,
			|	Goods.Sum AS Sum,
			|	CASE
			|		WHEN Goods.Price > 0
			|				AND Goods.Price / ISNULL(&QueryTextPackagingFactor1, 1) < 0.01
			|			THEN 0.01
			|		ELSE Goods.Price / ISNULL(&QueryTextPackagingFactor1, 1)
			|	END AS UnitPrice_1,
			|	Goods.Price AS PricePerPackaging,
			|	Goods.Package AS Package,
			|	Goods.NumberOfPackages AS NumberOfPackages,
			|	Goods.VATRate AS VATRate,
			|	Goods.VATAmount AS VATAmount,
			|	Goods.RowID AS RowID,
			|	Goods.ExpenseItem AS ExpenseItem,
			|	Goods.ExpenseItem.OffsettingAccount AS OffsettingAccount,
			|	Goods.CCDNumber AS CCDNumber,
			|	Goods.QuantityByGBRN AS QuantityByGBRN,
			|	Goods.Ref.ToReturnReusablePackage AS ToReturnReusablePackage,
			|	Goods.Products.ItemsType AS ItemsType
			|FROM
			|	Document.VendorInvoice.Goods AS Goods
			|		LEFT JOIN TTSeries AS SetOfSeries
			|		ON Goods.Products = SetOfSeries.Products
			|			AND Goods.Characteristic = SetOfSeries.Characteristic
			|			AND Goods.Purpose = SetOfSeries.Purpose
			|			AND Goods.Warehouse = SetOfSeries.Warehouse
			|WHERE
			|	Goods.Ref = &Ref
			|	AND Goods.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CustomsDeclarationImportGoods.Products AS Products,
			|	CustomsDeclarationImportGoods.Characteristic AS Characteristic,
			|	CustomsDeclarationImportGoods.Series AS Series,
			|	CustomsDeclarationImportGoods.CCDNumber AS CCDNumber,
			|	SUM(CustomsDeclarationImportGoods.QuantityByGBRN) AS QuantityByGBRN,
			|	SUM(CustomsDeclarationImportGoods.Count) AS Count
			|FROM
			|	Document.CCDImport.Goods AS CustomsDeclarationImportGoods
			|WHERE
			|	CustomsDeclarationImportGoods.DocumentInflow = &Ref
			|	AND CustomsDeclarationImportGoods.Ref.Posted
			|
			|GROUP BY
			|	CustomsDeclarationImportGoods.Products,
			|	CustomsDeclarationImportGoods.Characteristic,
			|	CustomsDeclarationImportGoods.Ref,
			|	CustomsDeclarationImportGoods.Series,
			|	CustomsDeclarationImportGoods.CCDNumber";
			
			Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor1",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"Goods.Package",
			"Goods.Products"));
			
			QueryResults = Query.ExecuteBatch();
			GoodsTable = QueryResults[3].Unload();
			CCDTable    = QueryResults[4].Unload();
			
			GoodsResult = GoodsTable.CopyColumns();
			
			// Let's perform the distribution.
			TheStructureOfTheSearch = New Structure("Products, Characteristic, Series");
			For Each LineProducts_ In GoodsTable Do
				QuantityToDistribution     = LineProducts_.Count;
				NumberOfRNPsByDistribution = LineProducts_.QuantityByGBRN;
				NumberOfPackagesBalance    = LineProducts_.NumberOfPackages;
				SumBalance                 = LineProducts_.Sum;
				VATAmountBalance              = LineProducts_.VATAmount;
				
				FillPropertyValues(TheStructureOfTheSearch, LineProducts_);
				
				LinesOfCCD = CCDTable.FindRows(TheStructureOfTheSearch);
				For Each CCDLine In LinesOfCCD Do
					If QuantityToDistribution = 0 Then
						Break;
					EndIf;
					
					ResultRow = GoodsResult.Add();
					FillPropertyValues(ResultRow, LineProducts_,,
					"Sum, VATAmount, Count, NumberOfPackages, QuantityByGBRN");
					FillPropertyValues(ResultRow, CCDLine,
					"CCDNumber");
					
					ResultRow.Count       = Min(QuantityToDistribution, CCDLine.Count);
					If IBData.BusinessOperation = Enums.BusinessTransactions.PurchaseByImport Then
						ResultRow.QuantityByGBRN = Min(QuantityToDistribution, CCDLine.QuantityByGBRN);
					Else
						ResultRow.QuantityByGBRN = Min(NumberOfRNPsByDistribution, CCDLine.QuantityByGBRN);
					EndIf;
					QuantityToDistribution     = QuantityToDistribution - ResultRow.Count;
					NumberOfRNPsByDistribution = NumberOfRNPsByDistribution - ResultRow.QuantityByGBRN;
					DistributionCoefficient     = ResultRow.Count / LineProducts_.Count;
					
					ResultRow.Sum = Round(LineProducts_.Sum * DistributionCoefficient, 2);
					ResultRow.VATAmount = Round(LineProducts_.VATAmount * DistributionCoefficient, 2);
					ResultRow.NumberOfPackages = Round(LineProducts_.NumberOfPackages * DistributionCoefficient, 3);
					
					SumBalance              = SumBalance - ResultRow.Sum;
					VATAmountBalance           = VATAmountBalance - ResultRow.VATAmount;
					NumberOfPackagesBalance = NumberOfPackagesBalance - ResultRow.NumberOfPackages;
				EndDo;
				
				// We will add products for which there is no GTD yet.
				If QuantityToDistribution > 0 Then
					ResultRow = GoodsResult.Add();
					FillPropertyValues(ResultRow, LineProducts_,,
					"Sum, VATAmount, Count, NumberOfPackages, QuantityByGBRN");
					
					ResultRow.Count = QuantityToDistribution;
					ResultRow.QuantityByGBRN = NumberOfRNPsByDistribution
				EndIf;
				
				// Let's add the sum balances.
				ResultRow.Sum = SumBalance
				+ ?(ValueIsFilled(ResultRow.Sum), ResultRow.Sum, 0);
				ResultRow.VATAmount = VATAmountBalance
				+ ?(ValueIsFilled(ResultRow.VATAmount), ResultRow.VATAmount, 0);
				ResultRow.NumberOfPackages = NumberOfPackagesBalance
				+ ?(ValueIsFilled(ResultRow.NumberOfPackages), ResultRow.NumberOfPackages, 0);
				
			EndDo;
			
			DocumentGoods = 
			"SELECT *
			|INTO DocumentGoods
			|FROM
			|	&GoodsResult AS Goods";
			
			Query.SetParameter("GoodsResult", GoodsResult);
			
			QueriesTexts.Add(DocumentGoods);
		Else
			// Services are always obtained from PM Goods, and goods - depending on the sign of discrepancies.
			// If there are no discrepancies - from PM Goods, if there are - from PM goods provided by the supplier.
			
			Query.Text = 
			"SELECT
			|	SetOfSeries.Ref AS Ref,
			|	SetOfSeries.LineNumber AS LineNumber,
			|	SetOfSeries.Series AS Series,
			|	SetOfSeries.Count AS Count,
			|	SetOfSeries.Products AS Products,
			|	SetOfSeries.Characteristic AS Characteristic,
			|	SetOfSeries.Purpose AS Purpose,
			|	SetOfSeries.Warehouse AS Warehouse
			|INTO TTSeries_FullSample
			|FROM
			|	Document.VendorInvoice.SetOfSeries AS SetOfSeries
			|WHERE
			|	SetOfSeries.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	SetOfSeries.Ref AS Ref,
			|	SetOfSeries.Products AS Products,
			|	SetOfSeries.Characteristic AS Characteristic,
			|	SetOfSeries.Purpose AS Purpose,
			|	SetOfSeries.Warehouse AS Warehouse,
			|	MIN(SetOfSeries.LineNumber) AS LineNumber
			|INTO TTSeries_FirstLines
			|FROM
			|	TTSeries_FullSample AS SetOfSeries
			|
			|GROUP BY
			|	SetOfSeries.Ref,
			|	SetOfSeries.Products,
			|	SetOfSeries.Characteristic,
			|	SetOfSeries.Purpose,
			|	SetOfSeries.Warehouse
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	PSSeriesTT.Ref AS Ref,
			|	SetOfSeries.Series AS Series,
			|	PSSeriesTT.Products AS Products,
			|	PSSeriesTT.Characteristic AS Characteristic,
			|	PSSeriesTT.Purpose AS Purpose,
			|	PSSeriesTT.Warehouse AS Warehouse,
			|	SetOfSeries.LineNumber AS LineNumber,
			|	SetOfSeries.Count AS Count
			|INTO TTSeries
			|FROM
			|	TTSeries_FirstLines AS PSSeriesTT
			|		LEFT JOIN TTSeries_FullSample AS SetOfSeries
			|		ON PSSeriesTT.Products = SetOfSeries.Products
			|			AND PSSeriesTT.Characteristic = SetOfSeries.Characteristic
			|			AND PSSeriesTT.Purpose = SetOfSeries.Purpose
			|			AND PSSeriesTT.Warehouse = SetOfSeries.Warehouse
			|			AND PSSeriesTT.LineNumber = SetOfSeries.LineNumber
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	PurchaseOfGoodsServicesGoods.Products AS Products,
			|	PurchaseOfGoodsServicesGoods.Characteristic AS Characteristic,
			|	PurchaseOfGoodsServicesGoods.Series AS Series,
			|	COUNT(PurchaseOfGoodsServicesGoods.Products) AS NumberOfRows,
			|	PurchaseOfGoodsServicesGoods.Warehouse AS Warehouse,
			|	PurchaseOfGoodsServicesGoods.Purpose AS Purpose
			|INTO TT_RepeatingPositions
			|FROM
			|	Document.VendorInvoice.Goods AS PurchaseOfGoodsServicesGoods
			|WHERE
			|	PurchaseOfGoodsServicesGoods.Ref = &Ref
			|
			|GROUP BY
			|	PurchaseOfGoodsServicesGoods.Products,
			|	PurchaseOfGoodsServicesGoods.Characteristic,
			|	PurchaseOfGoodsServicesGoods.Series,
			|	PurchaseOfGoodsServicesGoods.Warehouse,
			|	PurchaseOfGoodsServicesGoods.Purpose
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.LineNumber AS DocumentRowNumber,
			|	Goods.Products AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
			|	Goods.Count AS Count,
			|	Goods.Sum AS Sum,
			|	CASE
			|		WHEN Goods.Price > 0
			|				AND Goods.Price / ISNULL(&QueryTextPackagingFactor1, 1) < 0.01
			|			THEN 0.01
			|		ELSE Goods.Price / ISNULL(&QueryTextPackagingFactor1, 1)
			|	END AS UnitPrice_1,
			|	Goods.Price AS PricePerPackaging,
			|	Goods.Package AS Package,
			|	Goods.NumberOfPackages AS NumberOfPackages,
			|	Goods.VATRate AS VATRate,
			|	Goods.VATAmount AS VATAmount,
			|	Goods.RowID AS RowID,
			|	Goods.ExpenseItem AS ExpenseItem,
			|	Goods.CCDNumber AS CCDNumber,
			|	Goods.QuantityByGBRN AS QuantityByGBRN,
			|	Goods.ExpenseItem.OffsettingAccount AS OffsettingAccount,
			|	Goods.Ref.ToReturnReusablePackage AS ToReturnReusablePackage,
			|	Goods.Products.ItemsType AS ItemsType,
			|	TT_RepeatingPositions.NumberOfRows AS NumberOfRows,
			|	Goods.Warehouse AS Warehouse,
			|	Goods.Purpose AS Purpose,
			|	Goods.Series AS Series
			|INTO TT_ProductsWithAdditionalParameters
			|FROM
			|	Document.VendorInvoice.Goods AS Goods
			|		LEFT JOIN TT_RepeatingPositions AS TT_RepeatingPositions
			|		ON Goods.Products = TT_RepeatingPositions.Products
			|			AND Goods.Characteristic = TT_RepeatingPositions.Characteristic
			|			AND Goods.Series = TT_RepeatingPositions.Series
			|			AND Goods.Warehouse = TT_RepeatingPositions.Warehouse
			|			AND Goods.Purpose = TT_RepeatingPositions.Purpose
			|WHERE
			|	Goods.Ref = &Ref
			|	AND Goods.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.DocumentRowNumber AS DocumentRowNumber,
			|	Goods.Products AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
			|	MAX(CASE
			|		WHEN Goods.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
			|			THEN ISNULL(TTSeries_FullSample.Series, TTSeries.Series)
			|		ELSE Goods.Series
			|	END) AS Series,
			|	Goods.Count AS Count,
			|	Goods.PricePerPackaging AS PricePerPackaging,
			|	Goods.UnitPrice_1 AS UnitPrice_1,
			|	Goods.Sum AS Sum,
			|	Goods.Package AS Package,
			|	Goods.NumberOfPackages AS NumberOfPackages,
			|	Goods.VATRate AS VATRate,
			|	Goods.VATAmount AS VATAmount,
			|	Goods.RowID AS RowID,
			|	Goods.ExpenseItem AS ExpenseItem,
			|	Goods.CCDNumber AS CCDNumber,
			|	Goods.QuantityByGBRN AS QuantityByGBRN,
			|	Goods.ExpenseItem.OffsettingAccount AS OffsettingAccount,
			|	Goods.Products.ItemsType AS ItemsType,
			|	Goods.Warehouse AS Warehouse,
			|	Goods.Purpose AS Purpose,
			|	Goods.ToReturnReusablePackage AS ToReturnReusablePackage,
			|	Goods.NumberOfRows AS NumberOfRows
			|FROM
			|	TT_ProductsWithAdditionalParameters AS Goods
			|		LEFT JOIN TTSeries_FullSample AS TTSeries_FullSample
			|		ON Goods.Products = TTSeries_FullSample.Products
			|			AND Goods.Characteristic = TTSeries_FullSample.Characteristic
			|			AND Goods.Warehouse = TTSeries_FullSample.Warehouse
			|			AND Goods.Purpose = TTSeries_FullSample.Purpose
			|			AND (CASE
			|				WHEN Goods.NumberOfRows > 1
			|					THEN Goods.Count = TTSeries_FullSample.Count
			|				ELSE FALSE
			|			END)
			|		LEFT JOIN TTSeries AS TTSeries
			|		ON Goods.Products = TTSeries.Products
			|			AND Goods.Characteristic = TTSeries.Characteristic
			|			AND Goods.Warehouse = TTSeries.Warehouse
			|			AND Goods.Purpose = TTSeries.Purpose
			|GROUP BY
			|		Goods.DocumentRowNumber,
			|		Goods.Products,
			|		Goods.Characteristic,
			|		Goods.Products.UnitOfMeasure,
			|		Goods.Count,
			|		Goods.PricePerPackaging,
			|		Goods.UnitPrice_1,
			|		Goods.Sum,
			|		Goods.Package,
			|		Goods.NumberOfPackages,
			|		Goods.VATAmount,
			|		Goods.RowID,
			|		Goods.ExpenseItem,
			|		Goods.CCDNumber,
			|		Goods.QuantityByGBRN,
			|		Goods.ExpenseItem.OffsettingAccount,
			|		Goods.Products.ItemsType,
			|		Goods.Warehouse,
			|		Goods.Purpose,
			|		Goods.ToReturnReusablePackage,
			|		Goods.VATRate,
			|		Goods.NumberOfRows";
			
			Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor1",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"Goods.Package",
			"Goods.Products"));
			
			QueryResult = Query.Execute();
			GoodsResult = QueryResult.Unload();
			
			DocumentGoods = 
			"SELECT *
			|INTO DocumentGoods
			|FROM
			|	&GoodsResult AS Goods";
			
			Query.SetParameter("GoodsResult", GoodsResult);
			
			QueriesTexts.Add(DocumentGoods);
		EndIf;
		#EndRegion
		
		#Region FragmentOfRetailPriceRequest
		// Information about retail prices according to the retail type of prices set for the warehouse.
		RetailPrices =
		"SELECT
		|	CAST(RetailPrices.Price 
		|	/ ISNULL(&QueryTextPackagingFactor2, 1)
		|	* CASE
		|		WHEN DocumentHeaderData.Currency = &CurrencyReg AND DocumentHeaderData.ARAPCurrency = &CurrencyReg
		|			THEN ISNULL(ExchangeRatesAndPrices.CourseNumerator, 1) / ISNULL(ExchangeRatesAndPrices.CourseDenominator, 1)
		|		WHEN DocumentHeaderData.Currency = &CurrencyReg OR DocumentHeaderData.ARAPCurrency = &CurrencyReg
		|			THEN ISNULL(ExchangeRatesAndPrices.CourseNumerator, 1) * ISNULL(DocumentHeaderData.Multiplier_, 1) / (ISNULL(ExchangeRatesAndPrices.CourseDenominator, 1) * ISNULL(DocumentHeaderData.TransactionRate, 1))
		|		WHEN ISNULL(ExchangeRatesOfCentralBankDocument.CourseDenominator, 0) > 0
		|				AND ISNULL(ExchangeRatesOfCentralBankDocument.CourseNumerator, 0) > 0
		|				AND ISNULL(ExchangeRatesAndPrices.CourseDenominator, 0) > 0
		|				AND ISNULL(ExchangeRatesAndPrices.CourseNumerator, 0) > 0
		|			THEN ExchangeRatesAndPrices.CourseNumerator * ExchangeRatesOfCentralBankDocument.CourseDenominator / (ExchangeRatesAndPrices.CourseDenominator * ExchangeRatesOfCentralBankDocument.CourseNumerator)
		|		ELSE 1
		|	END AS NUMBER(31,2))      AS Price,
		|	RetailPrices.Products   AS Products,
		|	RetailPrices.Characteristic AS Characteristic
		|INTO RetailPrices
		|FROM                                      
		|	InformationRegister.ItemsPrices.SliceLast(
		|			&Date,
		|			PriceKind IN
		|					(SELECT
		|						DocumentHeaderData.RetailPriceType
		|					FROM
		|						DocumentHeaderData AS DocumentHeaderData)
		|				AND Products IN
		|					(SELECT DISTINCT
		|						DocumentGoods.Products
		|					FROM
		|						DocumentGoods AS DocumentGoods)
		|				AND Characteristic IN
		|					(SELECT DISTINCT
		|						DocumentGoods.Characteristic
		|					FROM
		|						DocumentGoods AS DocumentGoods)) AS RetailPrices
		|
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &CurrencyReg) AS ExchangeRatesAndPrices
		|		ON RetailPrices.Currency = ExchangeRatesAndPrices.Currency
		|		LEFT JOIN DocumentHeaderData AS DocumentHeaderData
		|		ON (TRUE)
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &CurrencyReg) AS ExchangeRatesOfCentralBankDocument
		|		ON DocumentHeaderData.Currency = ExchangeRatesOfCentralBankDocument.Currency
		|
		|INDEX BY
		|	Products,
		|	Characteristic";
		
		QueriesTexts.Add(RetailPrices);
		#EndRegion
		
		#Region FragmentOfGoodsQueryInDocumentWithRetailPrices
		DocumentProductsWithRetailPrices =
		"SELECT
		|	DocumentGoods.DocumentRowNumber      AS DocumentRowNumber,
		|	DocumentGoods.Products              AS Products,
		|	DocumentGoods.Characteristic            AS Characteristic,
		|	DocumentGoods.Series                     AS Series,
		|	DocumentGoods.UnitOfMeasure          AS UnitOfMeasure,
		|	DocumentGoods.Count                AS Count,
		|	DocumentGoods.QuantityByGBRN          AS QuantityByGBRN,
		|	DocumentGoods.Sum                     AS Sum,
		|	DocumentGoods.UnitPrice_1             AS Price,
		|	DocumentGoods.PricePerPackaging            AS PricePerPackaging,
		|	DocumentGoods.Package                  AS Package,
		|	DocumentGoods.NumberOfPackages        AS NumberOfPackages,
		|	DocumentGoods.VATRate                 AS VATRate,
		|	DocumentGoods.ExpenseItem                 AS ExpenseItem,
		|	DocumentGoods.VATAmount                  AS VATAmount,
		|	DocumentGoods.RowID       AS RowID,
		|	DocumentGoods.CCDNumber                  AS CCDNumber,
		|	DocumentGoods.ToReturnReusablePackage AS ToReturnReusablePackage,
		|	DocumentGoods.ItemsType           AS ItemsType,
		|
		|	ISNULL(CASE
		|			WHEN RetailPrices.Price < 0.01
		|				THEN 0.01
		|			ELSE CAST(RetailPrices.Price AS NUMBER(31, 2))
		|		END, 0)                             AS RetailPrice,
		|
		|	DocumentGoods.Count 
		|	* ISNULL(RetailPrices.Price, 0)		  AS RetailAmount
		|
		|INTO DocumentProductsWithRetailPrices
		|FROM
		|	DocumentGoods AS DocumentGoods
		|		LEFT JOIN RetailPrices AS RetailPrices
		|		ON DocumentGoods.Products = RetailPrices.Products
		|			AND DocumentGoods.Characteristic = RetailPrices.Characteristic";
		// The sample includes both goods and multi-turn containers (returnable and non-returnable).
		
		QueriesTexts.Add(DocumentProductsWithRetailPrices);
		#EndRegion
		
		#Region QueryFragmentProductsTableData
		TableDataProducts =
		"SELECT
		|	GoodsInRozn.DocumentRowNumber      AS DocumentRowNumber,
		|	GoodsInRozn.Products              AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	&QueryTextShouldBeRecognizedAsExpensesForUSN_Goods,
		|	GoodsInRozn.UnitOfMeasure          AS UnitOfMeasure,
		|	GoodsInRozn.Count                AS Count,
		|	CAST(GoodsInRozn.RetailAmount AS NUMBER(31,2)) AS RetailAmount,
		|	CAST(GoodsInRozn.Sum AS NUMBER(31,2))        AS Sum,
		|	CAST(GoodsInRozn.Price AS NUMBER(31,2))         AS Price,
		|	CAST(GoodsInRozn.RetailPrice AS NUMBER(31,2)) AS RetailPrice,
		|	GoodsInRozn.VATRate                 AS VATRate,
		|	GoodsInRozn.VATAmount                  AS VATAmount,
		|	GoodsInRozn.RowID       AS RowID,
		|	GoodsInRozn.ToReturnReusablePackage AS ToReturnReusablePackage,
		|	GoodsInRozn.ItemsType           AS ItemsType,
		|	CASE WHEN GoodsInRozn.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|		AND GoodsInRozn.ToReturnReusablePackage THEN
		|		""ReturnContainers""
		|	ELSE
		|		DocumentHeaderData.InventoryTypeByTypeOfOperation
		|	END                                         AS InventoryType
		|
		|FROM
		|	DocumentProductsWithRetailPrices AS GoodsInRozn
		|	INNER JOIN DocumentHeaderData AS DocumentHeaderData
		|		ON (TRUE)
		|WHERE
		|	GoodsInRozn.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|		OR GoodsInRozn.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|
		|ORDER BY
		|	GoodsInRozn.DocumentRowNumber";
		
		QueriesTexts.Add(TableDataProducts);
		#EndRegion
		
		#Region QueryFragmentServiceTableData
		// Works and services.
		// Additional expenses are services and work with an item of expenses allocated to the cost price.
		// The exchange does not take into account discrepancies in the receipt of works and services, so we get data from PM Goods.
		ServiceTableData =
		"SELECT
		|	Goods.Products                                    AS Products,
		|	CASE WHEN CAST(Goods.Products.DescriptionFull AS STRING(5)) = ""     "" THEN
		|		Goods.Products.Description                       
		|	ELSE CAST(Goods.Products.DescriptionFull AS STRING(250)) END AS Content,
		|	Goods.Count                                      AS Count,
		|	Goods.Sum                                           AS Sum,
		|	CASE WHEN Goods.Price / ISNULL(&QueryTextPackagingFactor1, 1) < 0.01
		|		THEN 0.01
		|		ELSE CAST(Goods.Price / ISNULL(&QueryTextPackagingFactor1, 1) AS NUMBER(31, 2)) 
		|	END                                                  AS Price,
		|	Goods.VATRate                                      AS VATRate,
		|	Goods.VATAmount                                        AS VATAmount,
		|	Goods.RowID                             AS RowID,
		|   Goods.ExpenseItem                                  AS CostItem, 
		|	&QueryTextShouldBeRecognizedAsExpensesForUSN_Services,
		|   Goods.Department                                   AS Department,
		|	CASE
		|		WHEN Goods.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
		|			THEN TRUE
		|		ELSE FALSE
		|	END                                                  AS ThisIsAdditionalExpense
		|FROM
		|	Document.VendorInvoice.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref
		|	AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
		|		OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
		|ORDER BY
		|	Goods.LineNumber";
		
		QueriesTexts.Add(ServiceTableData);
		#EndRegion
		
		#Region PackagingMarkings
		
		QueryTextPackagingMarkings = 
		"SELECT
		|	VendorInvoicePackageBarcodes.LineNumber AS DocumentRowNumber,
		|	VendorInvoicePackageBarcodes.PackageBarcode AS PackageBarcode
		|INTO TTBarcodesOfPackages
		|FROM
		|	Document.VendorInvoice.PackageBarcodes AS VendorInvoicePackageBarcodes
		|WHERE
		|	&UnloadingBarcodesOfPackages
		|	AND VendorInvoicePackageBarcodes.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber,
		|	TTBarcodesOfPackages.PackageBarcode AS PackageMarking
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|";
		
		QueriesTexts.Add(QueryTextPackagingMarkings);
		#EndRegion
		
		QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
		
		QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor1",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"Goods.Package",
		"Goods.Products"));
		
		QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor2",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"RetailPrices.Package",
		"RetailPrices.Products"));
		
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "GoodsInRozn"));
		
		QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "GoodsInRozn"));
		
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "GoodsInRozn"));
		
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "GoodsInRozn"));
		
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "GoodsInRozn"));
		
		STSIsAppliedIncomeMinusExpenses = False;
		
		
		QueryText = StrReplace(QueryText, "&QueryTextShouldBeRecognizedAsExpensesForUSN_Goods",
		QueryTextRecognizeAsSTSExpenses(ExchangeComponents, "GoodsInRozn", STSIsAppliedIncomeMinusExpenses));  
		
		QueryText = StrReplace(QueryText, "&QueryTextShouldBeRecognizedAsExpensesForUSN_Services",
		QueryTextRecognizeAsSTSExpenses(ExchangeComponents, "Goods", STSIsAppliedIncomeMinusExpenses));
		
		Query.Text = QueryText;
		QueryResults = Query.ExecuteBatch();
		
		OperationData = QueryResults[1].Select();
		
		Result.Insert("TransactionRate",      1);
		Result.Insert("Multiplier_", 1);
		
		If OperationData.Next() Then
			Result.TransactionRate      = OperationData.TransactionRate;
			Result.Multiplier_ = OperationData.Multiplier_;
		EndIf;
		
		GoodsTable             = QueryResults[5].Unload();
		TableServices             = QueryResults[6].Unload();
		TableExciseStamps      = QueryResults[8].Unload();
		PackagingMarkingTable = QueryResults[9].Unload();  
		
		// Expense account for services.
		TableServices.Columns.Add("CostAccount");
		TableServices.Columns.Add("CostDivision");
		For Each ServiceLine_1 In TableServices Do
			If ValueIsFilled(ServiceLine_1.Department) Then
				StructureDivision = New Structure();
				UnloadDivision(IBData, StructureDivision, ServiceLine_1.Department);
				ServiceLine_1.CostDivision = StructureDivision.Department;
			EndIf;
			If Not ValueIsFilled(ServiceLine_1.CostItem) Then
				Continue;
			EndIf;
			ServiceLine_1.CostAccount = AccountingInvoiceForArticle(ServiceLine_1.CostItem, IBData.Organization,
				ServiceLine_1.Department, IBData.Date);
		EndDo;
		
		Result.Insert("Goods",             GoodsTable);
		Result.Insert("Services",             TableServices);
		Result.Insert("ExciseStamps",      TableExciseStamps);
		Result.Insert("PackageMarkings", PackagingMarkingTable);
		
		// Decoding of expenses
		// Nomenclature, Quantity, cost of goods, Amount, summands, document of receipt.
		TranscriptOfAdditionalExpenses = IncomeAndExpensesServer.ExpenseAllocationOnInventoryCosts(IBData.Ref);
		
		// Deleting lines with empty amounts from the decryption.
		NumberOfLinesAdditionalCosts = TranscriptOfAdditionalExpenses.Count();
		For LineNumber = 1 To NumberOfLinesAdditionalCosts Do
			IndexOf = NumberOfLinesAdditionalCosts - LineNumber;
			If Round(TranscriptOfAdditionalExpenses[IndexOf].Sum,2) = 0 Then
				TranscriptOfAdditionalExpenses.Delete(IndexOf);
			EndIf;
		EndDo;  
		Result.Insert("TranscriptOfAdditionalExpenses", TranscriptOfAdditionalExpenses);
		
		Return Result;
EndFunction


