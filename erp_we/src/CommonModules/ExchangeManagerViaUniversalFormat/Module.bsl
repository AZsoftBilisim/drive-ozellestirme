Procedure DeferredProcessing_CounterpartyAgreements(Object)
	If TrimAll(Object.Description) = "" Then
		DefaultDescription = "" + TrimAll(Object.ContractType) + ", " + Lower(TrimAll(Object.ARAPCurrency));
		If VueCalculationIsUnderway(Object.ARAPCurrency, Object.ForeignCurrencyTransaction, Object.Organization) Then
			DefaultDescription = DefaultDescription + " (u.e.)";
		EndIf;
		Object.Description = DefaultDescription;
	EndIf;
	
	FillingInPartnerInDocumentHeader(Object);
	
	If ValueIsFilled(Object.Date) And ValueIsFilled(Object.Number) And Not Object.PaymentsAsPer275FZ Then
		Object.PaymentID = TMCommonUse.GetUniquePaymentID(Object);
	Else
		Object.PaymentID = Undefined;
	EndIf;
	
	If Not ValueIsFilled(Object.ARAPCurrency) Then
		
		ARAPCurrency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization);
		
		If Not ValueIsFilled(ARAPCurrency) Then
			ARAPCurrency = IncomeAndExpensesServer.GetCurrencyOfManagementAccounting();
		EndIf;
		
		Object.ARAPCurrency = ARAPCurrency;
		
	EndIf;
EndProcedure
Procedure DeferredProcessing_LoanAgreements(Object, ObjectIsModified)
