Procedure PCO_Document_RequestForCashExpenseSettlementsWithCOMT_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RequestForCashExpenseSettlementsWithCOMT_Sending", 
										"ARAPDetails", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany Then
		
		// In contrast to the algorithms: 
		//   * PKO_document_pbdsaccountscontragents_Shipment_Some of the sent data;
		//   * PKO_Document_sbdsaccountscontragents_Shipment_Some of the sent data;
		// for the current one, we change the order, because the details of the bank account of the recipient allows an empty space.
		CounterpartyData = GetCounterpartyDataForOrganizationSBankAccount(IBData.BankAccountBeneficiary, ExchangeComponents);
		
		CounterpartyRef = CounterpartyData.Counterparty;
		If ValueIsFilled(CounterpartyRef) Then
			
			XDTOData.Insert("Counterparty", CounterpartyRef);
			
		Else
			
			CounterpartyRef = CounterpartyFromOrganization(IBData.CompanyRecipient, ExchangeComponents);
			XDTOData.Insert("Counterparty", CounterpartyRef);
			
		EndIf;
		
		XDTOData.Insert("BankAccount", CounterpartyData.CounterpartyBankAccount);
		
	Else
		
		XDTOData.Insert("BankAccount", IBData.CounterpartyBankAccount);
		XDTOData.Insert("Counterparty",     IBData.Counterparty);
		
		CounterpartyRef = IBData.Counterparty;
		
	EndIf;
		
	ARAPType = "";
	BusinessTransactionDocument = IBData.BusinessOperation;
	
	If BusinessTransactionDocument = Enums.BusinessTransactions.PaymentToVendor
		Or BusinessTransactionDocument = Enums.BusinessTransactions.CashPaymentToAnotherCompany 
		Or BusinessTransactionDocument = Enums.BusinessTransactions.DeletePaymentToSelfEmployedPerson Then
		ARAPType = "WithVendor";
	ElsIf BusinessTransactionDocument = Enums.BusinessTransactions.RefundToCustomer
		Or BusinessTransactionDocument = Enums.BusinessTransactions.RefundToAnotherCompany Then
		ARAPType = "WithCustomer";
	ElsIf BusinessTransactionDocument = Enums.BusinessTransactions.PaymentOnLoansAndBorrowingsReceived Then
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.15") Then
		     ARAPType = "LoansAndBorrowings";
		Else	
		     ARAPType = "CreditToCounterparty";
		EndIf;
	EndIf;
	
	XDTOData.Insert("ARAPType", ARAPType);
	
	Query = New Query("SELECT
		|	ARAPDetails.Sum AS Sum,
		|	ARAPDetails.ARAPObject.Object AS OrderDocument,
		|	ARAPDetails.ARAPCurrency,
		|	ARAPDetails.CashFlowItem AS CFItem,
		|	ARAPDetails.AmountARAP,
		|	ARAPDetails.VATRate AS VATRate,
		//++ NOT TM
		
	 
		//-- DON'T TM 
		|	ARAPDetails.VATAmount
		|FROM
		|	Document.PaymentRequest.ARAPDetails AS ARAPDetails
		|WHERE
		|	ARAPDetails.Ref = &Ref");
	
	Query.SetParameter("Ref", IBData.Ref);
	ARAPDetails = Query.Execute().Unload();
	
	ARAPDetails.Columns.Add("Contract");
	ARAPDetails.Columns.Add("DocumentOfARAPAccounting");
	
	For Each TableRow In ARAPDetails Do
		
		If ValueIsFilled(TableRow.OrderDocument) Then
			
			OrderType_5 = TypeOf(TableRow.OrderDocument);
			
			If OrderType_5 = Type("CatalogRef.CounterpartyContracts") Then
				TableRow.Contract = TableRow.OrderDocument;
			Else
				
				If TableRow.OrderDocument.Metadata().Attributes.Find("Contract") <> Undefined Then
				
					CurTreaty = Common.ObjectAttributeValue(TableRow.OrderDocument, "Contract");
					
					If TypeOf(CurTreaty) = Type("CatalogRef.CounterpartyContracts") Then
						TableRow.Contract = CurTreaty;
					EndIf;
					
				EndIf;
				
				OCRName = "";
				PaymentType_ = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting;
				
				If OrderType_5 = Type("DocumentRef.ReturnOfGoodsFromCustomer") Then
					OCRName = "Document_ReturnOfGoodsFromCustomer_Sending";
				ElsIf OrderType_5 = Type("DocumentRef.CCDImport") Then
					OCRName = "Document_CustomsDeclaration_Shipment";
				ElsIf OrderType_5 = Type("DocumentRef.VendorInvoice") Then
					OCRName = "Document_ReceiptOfGoodsServices_Dispatch";
					PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
				ElsIf OrderType_5 = Type("DocumentRef.ConsignmentReportFromCustomer") Then
					OCRName = "Document_CommissionAgentSReport_Sending";	
				ElsIf OrderType_5 = Type("DocumentRef.SourceDocument")
					And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
					OCRName = "Document_PrimaryDocument_Sending";
				ElsIf OrderType_5 = Type("DocumentRef.VendorInvoiceServicesAndAssets") Then
					OCRName = "Document_ReceiptOfServicesOtherAssets_Sending";
				ElsIf OrderType_5 = Type("DocumentRef.CustomerInvoice") Then
					OCRName = "Document_SaleOfGoodsAndServices_Shipment";
				ElsIf OrderType_5 = Type("DocumentRef.ReturnOfGoodsToVendor") Then
					OCRName = "Document_ReturnOfGoodsToSupplier_Sending";
					PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
					
					
				
				ElsIf OrderType_5 = Type("DocumentRef.PurchaseOrder") Then
					OCRName = "Document_OrderToSupplier_Sending";
					PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
				ElsIf OrderType_5 = Type("DocumentRef.ConsignmentReportToVendor") Then
					OCRName = "Document_ReportToCommittee_Sending";
					PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
				ElsIf OrderType_5 = Type("DocumentRef.CustomerInvoiceServicesAndAssets") Then
					OCRName = "Document_SaleOfServicesOtherAssets_Sending";
				ElsIf OrderType_5 = Type("DocumentRef.PurchaseInvoiceConsignmentStockLost") Then
					OCRName = "Document_ReportToCommitteeOnDebiting_Sending";
					PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
				ElsIf OrderType_5 = Type("DocumentRef.CustomerInvoiceServices") Then
					If PropertyOfExchangeFormat(ExchangeComponents, "Документ.АктВыполненныхРабот") Then //@NON-NLS-1
						OCRName = "Document_ReportOfCompletedWorks_Sending";
					Else
						OCRName = "Document_ReportOfCompletedWorkRTU_Sending";
					EndIf;
				ElsIf OrderType_5 = Type("DocumentRef.WriteOffReportFromCommissionAgent") Then
					OCRName = "Document_CommissionAgentSReportOnDebiting_Sending";
				ElsIf OrderType_5 = Type("DocumentRef.SalesOrder") Then
					OCRName = "Document_CustomerOrder_Sending";
				ElsIf OrderType_5 = Type("DocumentRef.CustomerInvoiceIntercompany") Then
					IntercampanyOrganizations = Common.ObjectAttributesValues(TableRow.OrderDocument, "Organization, CompanyRecipient");
					If IntercampanyOrganizations.Organization = CounterpartyRef Then
						OCRName = "TransferBetweenCompanies_CI_Send";
					ElsIf IntercampanyOrganizations.CompanyRecipient = CounterpartyRef Then
						OCRName = "TransferBetweenOrganizations_PTU_Sending";
						PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
					EndIf;
				ElsIf OrderType_5 = Type("DocumentRef.CommissionWriteOffReportIntercompany") Then
					IntercampanyOrganizations = Common.ObjectAttributesValues(TableRow.OrderDocument, "Organization, Consignee");
					If IntercampanyOrganizations.Organization = CounterpartyRef Then
						OCRName = "Document_CommissionWriteOffCommitteeReport";
						PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
					ElsIf IntercampanyOrganizations.Consignee = CounterpartyRef Then
						OCRName = "Document_CommissionWriteOffReportCommissionAgent";
					EndIf;
				ElsIf OrderType_5 = Type("DocumentRef.CommissionReportIntercompany") Then
					IntercampanyOrganizations = Common.ObjectAttributesValues(TableRow.OrderDocument, "Organization, Consignee");
					If IntercampanyOrganizations.Organization = CounterpartyRef Then
						OCRName = "ReportCommissionBetweenOrganizations_CommissionAgent__";
					ElsIf IntercampanyOrganizations.Consignee = CounterpartyRef Then
						OCRName = "ReportCommissionBetweenOrganizations_Commitee_Sending";
						PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
					EndIf;
				EndIf;
				
				If Not IsBlankString(OCRName) Then
					TableRow.DocumentOfARAPAccounting = New Structure("Value, OCRName", TableRow.OrderDocument, OCRName);
				EndIf;
				
			EndIf;
		EndIf;
		
		If ValueIsFilled(TableRow.Contract) Then
			Continue;
		EndIf;
		
		CalculationsInConventionalUnits = False;
		TypeOfAgreement = "";
	
		GetContractParametersForOrder(TableRow.OrderDocument, PaymentType_, TypeOfAgreement, CalculationsInConventionalUnits);
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = TableRow.ARAPCurrency;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		DefaultParameters.TypeOfAgreement              = TypeOfAgreement; 
		DefaultParameters.Counterparty               = CounterpartyRef;
		
		TableRow.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, TableRow.OrderDocument, IBData.Ref);
		
	EndDo;
	//++ NOT TM
	
	
	//-- DON'T TM
	XDTOData.Insert("ARAPDetails", ARAPDetails);
EndProcedure

