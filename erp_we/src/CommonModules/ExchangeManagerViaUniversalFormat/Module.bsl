Procedure OCR_Document_ApplicationForImportationOfGoods_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf; 
	
	#Region Header
	
	ARAPCurrency = IBData.Currency;
	
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
		ARAPCurrency = Common.ObjectAttributeValue(IBData.Contract, "ARAPCurrency");
	EndIf;
	
	XDTOData.Insert("ARAPCurrency", ARAPCurrency);
	
	If ValueIsFilled(IBData.CorrectedDocument) Then
		XDTOData.Insert("CorrectedDocument", IBData.CorrectedDocument);
	EndIf;
	
	If ValueIsFilled(IBData.ReversedDocument) Then
		XDTOData.Insert("ReversedDocument", IBData.ReversedDocument);
	EndIf; 
	 
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	#EndRegion 
	   
	#Region TabularSections
	
	Query = New Query;
	
	Query.Text = 
	"SELECT
	|	ApplicationForImportationOfGoodsTransactionParties.LineNumber AS DocumentRowNumber,
	|	PRESENTATION(ApplicationForImportationOfGoodsTransactionParties.SellerRole) AS SellerRole,
	|	ApplicationForImportationOfGoodsTransactionParties.Seller AS Seller,
	|	PRESENTATION(ApplicationForImportationOfGoodsTransactionParties.CustomerRole) AS CustomerRole,
	|	ApplicationForImportationOfGoodsTransactionParties.Customer AS Customer,
	|	ApplicationForImportationOfGoodsTransactionParties.ContractNumber AS ContractNumber,
	|	ApplicationForImportationOfGoodsTransactionParties.ContractDate_ AS ContractDate_,
	|	ApplicationForImportationOfGoodsTransactionParties.SpecificationNumber AS SpecificationNumber,
	|	ApplicationForImportationOfGoodsTransactionParties.SpecificationDate AS SpecificationDate
	|FROM
	|	Document.ApplicationForImportationOfGoods.TransactionParties AS ApplicationForImportationOfGoodsTransactionParties
	|WHERE
	|	ApplicationForImportationOfGoodsTransactionParties.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ApplicationForImportationOfGoodsSpecifications.LineNumber AS DocumentRowNumber,
	|	ApplicationForImportationOfGoodsSpecifications.SpecificationNumber AS SpecificationNumber,
	|	ApplicationForImportationOfGoodsSpecifications.SpecificationDate AS SpecificationDate
	|FROM
	|	Document.ApplicationForImportationOfGoods.Specifications AS ApplicationForImportationOfGoodsSpecifications
	|WHERE
	|	ApplicationForImportationOfGoodsSpecifications.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ApplicationForImportationOfGoodsDocumentsInformation.LineNumber AS DocumentRowNumber,
	|	ApplicationForImportationOfGoodsDocumentsInformation.Description AS Description,
	|	ApplicationForImportationOfGoodsDocumentsInformation.Number AS Number,
	|	ApplicationForImportationOfGoodsDocumentsInformation.Date AS Date
	|FROM
	|	Document.ApplicationForImportationOfGoods.DocumentsInformation AS ApplicationForImportationOfGoodsDocumentsInformation
	|WHERE
	|	ApplicationForImportationOfGoodsDocumentsInformation.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ApplicationForImportationOfGoodsGoods.LineNumber AS DocumentRowNumber,
	|	ApplicationForImportationOfGoodsGoods.AdValoremExciseRate AS AdValoremExciseRate,
	|	ApplicationForImportationOfGoodsGoods.NetWeightKg AS NetWeightKg,
	|	ApplicationForImportationOfGoodsGoods.AccountingRecordDate AS AccountingRecordDate,
	|	ApplicationForImportationOfGoodsGoods.TaxInvoiceDate AS TaxInvoiceDate,
	|	ApplicationForImportationOfGoodsGoods.SupportingDocumentDate AS SupportingDocumentDate,
	|	ApplicationForImportationOfGoodsGoods.Contract AS Contract,
	|	ApplicationForImportationOfGoodsGoods.DocumentInflow AS DocumentUninvoicedReceipts,
	|	ApplicationForImportationOfGoodsGoods.UnitOfMeasure AS UnitOfMeasure,
	|	ApplicationForImportationOfGoodsGoods.ExciseUnit AS ExciseUnit,
	|	ApplicationForImportationOfGoodsGoods.PurchaseForActivity AS PurchaseForActivity,
	|	ApplicationForImportationOfGoodsGoods.TransportKindCode AS TransportKindCode,
	|	ApplicationForImportationOfGoodsGoods.FEACNCode AS FEACNCode,
	|	ApplicationForImportationOfGoodsGoods.Count AS Count,
	|	ApplicationForImportationOfGoodsGoods.QuantityByFEACN AS QuantityByFEACN,
	|	ApplicationForImportationOfGoodsGoods.TaxBaseExcises AS TaxBaseExcises,
	|	ApplicationForImportationOfGoodsGoods.VATTaxBase AS VATTaxBase,
	|	ApplicationForImportationOfGoodsGoods.Products AS Products,
	|	ApplicationForImportationOfGoodsGoods.CDNumber AS CCDNumber,
	|	ApplicationForImportationOfGoodsGoods.TaxInvoiceNumber AS TaxInvoiceNumber,
	|	ApplicationForImportationOfGoodsGoods.Series AS Series,
	|	ApplicationForImportationOfGoodsGoods.SupportingDocumentSeriesNumber AS SupportingDocumentSeriesNumber,
	|	ApplicationForImportationOfGoodsGoods.VATRate AS VATRate,
	|	ApplicationForImportationOfGoodsGoods.FixedExciseDuty AS FixedExciseDuty,
	|	ApplicationForImportationOfGoodsGoods.TaxInvoicedPrice AS TaxInvoicedPrice,
	|	ApplicationForImportationOfGoodsGoods.Characteristic AS Characteristic,
	|	ApplicationForImportationOfGoodsGoods.ExciseTaxAmount AS ExciseTaxAmount
	|FROM
	|	Document.ApplicationForImportationOfGoods.Goods AS ApplicationForImportationOfGoodsGoods
	|WHERE
	|	ApplicationForImportationOfGoodsGoods.Ref = &Ref";
	
	Query.SetParameter("Ref", IBData.Ref);
	
	ResultsPackage = Query.ExecuteBatch();
	
	TransactionParties = ResultsPackage[0].Unload();
	Specifications = ResultsPackage[1].Unload(); 
	DocumentsInformation = ResultsPackage[2].Unload();
	RawGoods = ResultsPackage[3].Unload(); 
	
	Goods = RawGoods.CopyColumns();
	
	Goods.Columns.Add("DocumentInflow");
	
	For Each String In RawGoods Do
	    
	    NewRow = Goods.Add();
	    
		FillPropertyValues(NewRow, String,, "DocumentUninvoicedReceipts");
		
		If ValueIsFilled(String.DocumentUninvoicedReceipts) Then
		
			OCRName = NameOfICOForDataObject(ExchangeComponents, String.DocumentUninvoicedReceipts, IBData.Organization);
		    
		    NewRow.DocumentInflow = New Structure("Value, OCRName", 
		    	String.DocumentUninvoicedReceipts, OCRName);
		    
		EndIf;
	
	EndDo;
	
	XDTOData.Insert("Goods", Goods); 
	XDTOData.Insert("DocumentsInformation", DocumentsInformation); 
	XDTOData.Insert("Specifications", Specifications); 
	XDTOData.Insert("TransactionParties", TransactionParties);
	 
	#EndRegion
EndProcedure

