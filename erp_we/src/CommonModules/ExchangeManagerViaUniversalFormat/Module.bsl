Procedure OCR_Document_ConsignmentReportFromCustomer_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CommissionAgentSReport_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CommissionAgentSReport_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;   
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then 								
		VATRateOfRemuneration = VATRateAccordingToCatalog(IBData.VATRateOfRemuneration);
	Else
		VATRateOfRemuneration = New Structure;
		VATRateOfRemuneration.Insert("Value", IBData.VATRateOfRemuneration);
		VATRateOfRemuneration.Insert("OCRName", "CatalogLink_BIDS_Sending");
	EndIf;
	XDTOData.Insert("VATRateOfRemuneration", VATRateOfRemuneration);
	
	UnloadDivision(IBData, XDTOData);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
		XDTOData.KeyProperties.Insert("TypeOfOperationOfCommissionaireSReport", "SaleOfGoodsOnCommission");  
	EndIf;
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = IBData.Currency;
		DefaultParameters.TypeOfAgreement              = "WithConsignee";
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = False;
		
		OrderDocument = New Structure();
		OrderDocument.Insert("OrderDocument",      Undefined);
		OrderDocument.Insert("Terms", IBData.Terms);
		OrderDocument.Insert("SalesOpportunity",     Undefined);
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
	XDTOData.Insert("AmountIncludesVAT", True);
	
	// Item of remuneration costs
	// Parameters No.2,3 and 4 are necessary for calculating the cost account in the UP/KA.
	If ValueIsFilled(IBData.ExpenseItem) Then
		CostAccount = AccountingInvoiceForArticle(IBData.ExpenseItem, IBData.Organization, IBData.Department, IBData.Date);
		XDTOData.Insert("CostItem", IBData.ExpenseItem);
		XDTOData.Insert("CostAccount",   CostAccount);
	EndIf;
	
	// Table parts
	Query = New Query("SELECT
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Ref,
		|	Goods.Ref.Organization AS Organization,
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Count,
		|	Goods.QuantityByGBRN AS QuantityByGBRN,
		|	Goods.VATRate AS VATRate,
		|	CASE
		|		WHEN Goods.AmountIncludingVAT / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.AmountIncludingVAT / Goods.Count AS NUMBER(31, 2))
		|	END AS TransferPrice,
		|	Goods.AmountIncludingVAT AS TransferAmount,
		|	CASE
		|		WHEN Goods.SalesAmount / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.SalesAmount / Goods.Count AS NUMBER(31, 2))
		|	END AS Price,
		|	Goods.SalesAmount AS Sum,
		|	Goods.AmountSalesVAT AS VATAmount,
		|	Goods.CommissionAmount AS CommissionAmount,
		|	Goods.AmountVATRemuneration AS AmountVATRemuneration,
		|	CASE
		|		WHEN Goods.Count < 0
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ReversingEntry,
		|	CASE
		|		WHEN Goods.Customer = VALUE(Catalog.Counterparties.EmptyRef)
		|			THEN Goods.Ref.Counterparty
		|		ELSE Goods.Customer
		|	END AS Customer,
		|	Goods.Customer AS Buyer__,
		|	CASE
		|		WHEN Goods.DateOfTaxInvoiceIssuedByCommissionAgent = DATETIME(1, 1, 1)
		|			THEN BEGINOFPERIOD(Goods.Ref.Date, DAY)
		|		ELSE BEGINOFPERIOD(Goods.DateOfTaxInvoiceIssuedByCommissionAgent, DAY)
		|	END AS InvoiceDate,
		|	BEGINOFPERIOD(Goods.DateOfTaxInvoiceIssuedByCommissionAgent, DAY) AS SF_OriginalDate,
		|	Goods.RowID AS RowID,
		|	Goods.CommissionAgentSTaxInvoiceNumber AS InvoiceNumber
		|INTO Goods
		|FROM
		|	Document.ConsignmentReportFromCustomer.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref
		|	AND NOT Goods.Count = 0
		|	AND Goods.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|GROUP BY
		|	Goods.LineNumber,
		|	Goods.Ref,
		|	Goods.Ref.Organization,
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.Products.UnitOfMeasure,
		|	Goods.Count,
		|	Goods.QuantityByGBRN,
		|	Goods.RowID,
		|	Goods.VATRate,
		|	CASE
		|		WHEN Goods.AmountIncludingVAT / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.AmountIncludingVAT / Goods.Count AS NUMBER(31, 2))
		|	END,
		|	Goods.AmountIncludingVAT,
		|	CASE
		|		WHEN Goods.SalesAmount / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.SalesAmount / Goods.Count AS NUMBER(31, 2))
		|	END,
		|	Goods.SalesAmount,
		|	Goods.AmountSalesVAT,
		|	Goods.CommissionAmount,
		|	Goods.AmountVATRemuneration,
		|	CASE
		|		WHEN Goods.Count < 0
		|			THEN TRUE
		|		ELSE FALSE
		|	END,
		|	CASE
		|		WHEN Goods.DateOfTaxInvoiceIssuedByCommissionAgent = DATETIME(1, 1, 1)
		|			THEN BEGINOFPERIOD(Goods.Ref.Date, DAY)
		|		ELSE BEGINOFPERIOD(Goods.DateOfTaxInvoiceIssuedByCommissionAgent, DAY)
		|	END,
		|	BEGINOFPERIOD(Goods.DateOfTaxInvoiceIssuedByCommissionAgent, DAY),
		|	CASE
		|		WHEN Goods.Customer = VALUE(Catalog.Counterparties.EmptyRef)
		|			THEN Goods.Ref.Counterparty
		|		ELSE Goods.Customer
		|	END,
		|	Goods.Customer,
		|	Goods.CommissionAgentSTaxInvoiceNumber
		|
		|INDEX BY
		|	Goods.Ref,
		|	Organization,
		|	Customer,
		|	InvoiceDate,
		|	InvoiceNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.DocumentRowNumber,
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.UnitOfMeasure,
		|	Goods.Count,
		|	Goods.VATRate,
		|	Goods.TransferPrice,
		|	Goods.TransferAmount,
		|	Goods.Price,
		|	Goods.Sum,
		|	Goods.VATAmount,
		|	Goods.CommissionAmount,
		|	Goods.ReversingEntry,
		|	Goods.Customer,
		|	Goods.InvoiceDate,
		|	Goods.Buyer__,
		|	Goods.SF_OriginalDate,
		|	Goods.InvoiceNumber,
		|	FALSE AS TypesOfStocksFilled,
		|	1 AS ZoomRatio,
		|	1 AS RowKey,
		|	&EmptyCCDNumber,
		|	&QueryTextProductBatchID,
		|	VALUE(Catalog.WorldCountries.EmptyRef) AS OriginCountry,
		|	CAST("""" AS STRING(20)) AS InventoryType,
		|	Goods.RowID AS RowID,
		|	Goods.AmountVATRemuneration AS AmountVATRemuneration
		|FROM
		|	Goods AS Goods
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.Count AS Count,
		|	&FilledInCCDNumber,
		|	&FilledCountry,
		|	&TypesOfStocksTextOfRNPTRequest,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	CASE
		|		WHEN InventoryKinds.Count < 0
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ReversingEntry,
		|	InventoryKinds.DateOfTaxInvoiceIssuedByCommissionAgent AS InvoiceDate,
		|	InventoryKinds.CommissionAgentSTaxInvoiceNumber AS InvoiceNumber,
		|	InventoryKinds.RowID AS RowID,
		|	InventoryKinds.Customer,
		|	InventoryKinds.LineNumber AS DocumentRowNumber
		|FROM
		|	Document.ConsignmentReportFromCustomer.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	1 AS RowKey,
		|	Goods.Customer,
		|	Goods.InvoiceDate,
		|	MIN(Goods.DocumentRowNumber) AS OrderingValue
		|FROM
		|	Goods AS Goods
		|
		|GROUP BY
		|	Goods.Customer,
		|	Goods.InvoiceDate
		|
		|ORDER BY
		|	OrderingValue");
	
	
	
	FillInYourOwnProductsInText(Query.Text);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		EmptyCCDNumber = "VALUE(Catalog.CCDNumbers.EmptyRef) AS CCDNumber";
		FilledInCCDNumber = "InventoryKinds.CCDNumber AS CCDNumber";
		FilledCountry = "VALUE(Catalog.WorldCountries.EmptyRef) AS OriginCountry";
	Else
		EmptyCCDNumber = "CAST("""" AS STRING(30)) AS CCDNumber";
		FilledInCCDNumber = "InventoryKinds.CCDNumber.Code AS CCDNumber";
		FilledCountry = "InventoryKinds.CCDNumber.OriginCountry AS OriginCountry";
	EndIf;
	Query.Text = StrReplace(Query.Text, "&EmptyCCDNumber", EmptyCCDNumber);
	Query.Text = StrReplace(Query.Text, "&FilledInCCDNumber", FilledInCCDNumber);
	Query.Text = StrReplace(Query.Text, "&FilledCountry", FilledCountry);
	
	Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	Query.Text = StrReplace(Query.Text, "&TypesOfStocksTextOfRNPTRequest",
			GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	Query.SetParameter("Ref", IBData.Ref);
	QueryResults = Query.ExecuteBatch();
	
	SearchAttributes      = "Products, Characteristic, SF_OriginalDate, Buyer__, InvoiceNumber";
	DetailsToFillIn = "CCDNumber, OriginCountry, InventoryType, RowID";
	
	TabProducts = QueryResults[1].Unload();
	// Table of buyers
	Tobacco_ = QueryResults[3].Unload();
	
	SearchFields = "Customer";
	TheStructureOfTheSearch = New Structure(SearchFields);
	
	For Each String In Tobacco_ Do
		FoundRows = New Array();
		String.RowKey = Tobacco_.IndexOf(String) + 1;
		FillPropertyValues(TheStructureOfTheSearch, String);
		FoundRows = TabProducts.FindRows(TheStructureOfTheSearch);
		For Each RowOfGoods In FoundRows Do
			RowOfGoods.RowKey = String.RowKey;
		EndDo;
	EndDo;
	
	SearchAttributes      = "Products, Characteristic, SF_OriginalDate, Buyer__, InvoiceNumber, ReversingEntry";
	DetailsToFillIn = "CCDNumber, OriginCountry, InventoryType, RowID, DocumentRowNumber";
	
	TheStructureOfTheSearch = New Structure(SearchAttributes + ",TypesOfStocksFilled");
	TabProducts.Indexes.Add(SearchAttributes + ",TypesOfStocksFilled");
	
	InventoryKinds = QueryResults[2].Select();
	While InventoryKinds.Next() Do
	
		FillPropertyValues(TheStructureOfTheSearch, InventoryKinds, "Products, Characteristic, InvoiceNumber, ReversingEntry");
				
		TheStructureOfTheSearch.Buyer__  = InventoryKinds.Customer;
		TheStructureOfTheSearch.SF_OriginalDate      = InventoryKinds.InvoiceDate;
		TheStructureOfTheSearch.TypesOfStocksFilled = False;
		
		FoundRows     = TabProducts.FindRows(TheStructureOfTheSearch);
		RemainingInventoryKinds = InventoryKinds.Count;
	
		For Each DocumentLine In FoundRows Do
			
			If RemainingInventoryKinds = 0 Then
				Break;
			EndIf;
			
			If (DocumentLine.Count < 0 And RemainingInventoryKinds < 0 And DocumentLine.Count >= RemainingInventoryKinds)
				Or (DocumentLine.Count <= RemainingInventoryKinds) Then
				
				FillPropertyValues(DocumentLine, InventoryKinds, DetailsToFillIn);
				DocumentLine.TypesOfStocksFilled = True;
				RemainingInventoryKinds = RemainingInventoryKinds - DocumentLine.Count;
				
			Else
			
				// Selecting a new line with a filled inventory view.
				NewRow = TabProducts.Add();
				FillPropertyValues(NewRow, DocumentLine);
				
				PercentageOfInventoryTypeInDocumentLine = RemainingInventoryKinds / DocumentLine.Count;
				
				NewRow.Count             = RemainingInventoryKinds;
				NewRow.TransferAmount          = Round(DocumentLine.TransferAmount * PercentageOfInventoryTypeInDocumentLine, 2);
				NewRow.Sum                  = Round(DocumentLine.Sum * PercentageOfInventoryTypeInDocumentLine, 2);
				NewRow.VATAmount               = Round(DocumentLine.VATAmount * PercentageOfInventoryTypeInDocumentLine, 2);
				NewRow.CommissionAmount    = Round(DocumentLine.CommissionAmount * PercentageOfInventoryTypeInDocumentLine, 2);
				NewRow.AmountVATRemuneration = Round(DocumentLine.AmountVATRemuneration * PercentageOfInventoryTypeInDocumentLine, 2);
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
					NewRow.NumberOfRNPT   = Round(DocumentLine.NumberOfRNPT * PercentageOfInventoryTypeInDocumentLine, 2);
				EndIf;
				FillPropertyValues(NewRow, InventoryKinds, DetailsToFillIn);
				
				DocumentLine.Count             = DocumentLine.Count - NewRow.Count;
				DocumentLine.TransferAmount          = DocumentLine.TransferAmount - NewRow.TransferAmount;
				DocumentLine.Sum                  = DocumentLine.Sum - NewRow.Sum;
				DocumentLine.VATAmount               = DocumentLine.VATAmount - NewRow.VATAmount;
				DocumentLine.CommissionAmount    = DocumentLine.CommissionAmount - NewRow.CommissionAmount;
				DocumentLine.AmountVATRemuneration = DocumentLine.AmountVATRemuneration - NewRow.AmountVATRemuneration;
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
					DocumentLine.NumberOfRNPT   = DocumentLine.NumberOfRNPT - NewRow.NumberOfRNPT;
				EndIf;
				RemainingInventoryKinds = 0;
				
			EndIf;
		EndDo;
	EndDo;
	
	// Table of buyers
	NamesOfGroupingColumns	= "DocumentRowNumber, Products, Characteristic, UnitOfMeasure, VATRate,
	|Customer, InvoiceDate, Buyer__, SF_OriginalDate, InvoiceNumber, TypesOfStocksFilled, ZoomRatio, RowKey,
	|CCDNumber, TracedGoods, OriginCountry, UnitOfTraceability, InventoryType, RowID, Price, ReversingEntry";
	NamesOfSummationColumns= "Count, TransferPrice, TransferAmount, Sum, VATAmount, CommissionAmount,
	|AmountVATRemuneration, NumberOfRNPT";
	   
	TabProducts.GroupBy(NamesOfGroupingColumns, NamesOfSummationColumns);	
	TabProducts.Sort("DocumentRowNumber Asc");
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, TabProducts, True, False);
	//ProductBatchID information   
		
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(TabProducts, False);
	EndIf;
	XDTOData.Insert("Goods",     TabProducts);
	XDTOData.Insert("Buyers", Tobacco_);
EndProcedure

