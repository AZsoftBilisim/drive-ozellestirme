Procedure PCO_Doc_OtherRegistration_Decommissioning_Unlock_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Doc_OtherRegistration_Decommissioning_OTP", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	QueryText = 
		"SELECT
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Count AS Count,
		|	CAST(Goods.Sum / Goods.Count AS NUMBER(31, 2)) AS Price,
		|	Goods.Price AS PricePerPackaging,
		|	Goods.Sum AS Sum,
		|	&OwnProducts AS InventoryType,
		|	Goods.Individual AS Individual,
		|	CAST(Goods.Lot.Document AS Document.InventoryConsumption) AS DocumentTransfers_,
		|	CAST(Goods.ExpenseAndIncomeItem AS ChartOfCharacteristicTypes.IncomeItems) AS IncomeItem,
		|	ISNULL(Goods.Lot.AssetID, """") AS AssetID,
		|	Goods.ExpenseAndIncomeItem.Description AS ItemOfExpenditureName,
		|	Goods.ExpenseAndIncomeItem.OffsettingAccount AS ExpenseItemCorAccount
		|FROM
		|	Document.OtherGoodsRecordingAsReceived.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "Goods"));
			
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	
	Goods.Columns.Add("NameOfMethodForReflectingExpenses");
	
	For Each String In Goods Do
		String.NameOfMethodForReflectingExpenses = String.ItemOfExpenditureName;
	
		If ValueIsFilled(String.ExpenseItemCorAccount) Then
			NameOfMethodForReflectingExpenses = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = '%1 tài khoản( %2)';
					|ru = '%1 счет( %2)';
					|en = '%1 account( %2)'; fa = '%1 account( %2)';
					|it = '%1 conto( %2)';
					|pl = '%1 konto( %2)';
					|tr = '%1 hesap (%2)'"),
				TrimAll(String.NameOfMethodForReflectingExpenses),
				String.ExpenseItemCorAccount);
			String.NameOfMethodForReflectingExpenses = NameOfMethodForReflectingExpenses;
		EndIf;
	EndDo;
	XDTOData.Insert("Goods", Goods);
EndProcedure

