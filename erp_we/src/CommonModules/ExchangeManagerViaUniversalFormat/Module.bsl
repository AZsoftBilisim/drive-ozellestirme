Procedure OCR_Document_RetailSalesReport_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		XDTOData.Insert("CashRegisterShift", IBData.CashRegisterShift);
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RetailSalesReport__", 
										"GoodsSale", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RetailSalesReport__", 
										"GoodsReturnSales", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;   
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RetailSalesReport__", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending"); 
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RetailSalesReport__", 
										"GoodsSale", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");	
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RetailSalesReport__", 
										"GoodsReturnSales", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");	
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RetailSalesReport__", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");								
	EndIf;
	XDTOData.KeyProperties.Insert("CashRegisterShift", IBData.CashRegisterShift);
	XDTOData.Insert("CashRegister", IBData.CashRegister);
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	XDTOData.Insert("AccountingForRevenueInOperatingCashRegister", True);
	
	QueryResults = IBData.AdditionalProperties.QueryResults;
	NumberOfRequests_ = QueryResults.Count();
	
	TableNumbers = New Map;
	TableNumbers.Insert("Goods",                   NumberOfRequests_-12);
	TableNumbers.Insert("GoodsSale",            NumberOfRequests_-11);
	TableNumbers.Insert("GoodsReturnSales",     NumberOfRequests_-10);
	TableNumbers.Insert("Services",                   NumberOfRequests_-9);
	TableNumbers.Insert("PaymentByCards",            NumberOfRequests_-8);
	TableNumbers.Insert("PaymentByCertificates",      NumberOfRequests_-7);
	TableNumbers.Insert("GiftCertificates",    NumberOfRequests_-6);
	TableNumbers.Insert("PaymentByCreditCard",          NumberOfRequests_-5);
	TableNumbers.Insert("BonusPointAccrual", NumberOfRequests_-4);
	TableNumbers.Insert("PaymentWithBonusPoints",   NumberOfRequests_-3);
	TableNumbers.Insert("ExciseStamps",            NumberOfRequests_-2);
	TableNumbers.Insert("PackageMarkings",       NumberOfRequests_-1);
	
	
	#Region Goods
	
	AmountOfReturns = 0;
	
	NameOfProductsTable = "GoodsSale";
	
	GoodsReturnSales = QueryResults[TableNumbers.Get("GoodsReturnSales")].Unload();	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsReturnSales, True, False);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(GoodsReturnSales, False);
	EndIf;
	XDTOData.Insert("GoodsReturnSales", GoodsReturnSales);
	
	Query = New Query("
		|SELECT
		|	ISNULL(SUM(RetailReturnsReport.DocumentAmount), 0) AS DocumentAmount
		|FROM
		|	Document.RetailReturnsReport AS RetailReturnsReport
		|WHERE
		|	RetailReturnsReport.Posted
		|	AND RetailReturnsReport.CashRegisterShift = &CashRegisterShift
		|	AND RetailReturnsReport.CashRegisterShift <> VALUE(Document.CashRegisterShift.EmptyRef)
		|	AND RetailReturnsReport.VATTaxation = &VATTaxation
		|");
	Query.SetParameter("CashRegisterShift",      IBData.CashRegisterShift);
	Query.SetParameter("VATTaxation", IBData.VATTaxation);
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		AmountOfReturns = Selection.DocumentAmount;
	EndIf;
		
	GoodsSale = QueryResults[TableNumbers.Get(NameOfProductsTable)].Unload();
	For Each LineProducts_ In GoodsSale Do
		If ValueIsFilled(LineProducts_.Vendor)
			And TypeOf(LineProducts_.Vendor) = Type("CatalogRef.Companies") Then
			LineProducts_.Vendor = CounterpartyFromOrganization(LineProducts_.Vendor, ExchangeComponents);
		EndIf;
	EndDo;
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsSale, True, False); 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(GoodsSale, False);
	EndIf;
	XDTOData.Insert(NameOfProductsTable, GoodsSale);
	
	#EndRegion
	
	XDTOData.Insert("Sum", IBData.DocumentAmount - AmountOfReturns);
	
	#Region Services
	
	Services = QueryResults[TableNumbers.Get("Services")].Unload();
	TableOfServicesForPrincipal(ExchangeComponents, Services);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Services, False);
	EndIf;
	XDTOData.Insert("Services", Services);
	
	#EndRegion
	
	//ProductBatchID information   
		
	
	#Region PaymentWithPaymentCards
	
	PaymentByCards = QueryResults[TableNumbers.Get("PaymentByCards")].Unload(); // ValueTable
	
	If PaymentByCards.Count() <> 0 Then
		PaymentByCards.Columns.Add("AcquirerSContract");
		PaymentByCards.Columns.Add("POSTerminal");
	EndIf;
	For Each String In PaymentByCards Do
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17")
			And String.TypesOfCashRegisterPaymentSystem = Enums.TypesOfCashRegisterPaymentSystem.PaymentCard Then
			String.TypesOfCashRegisterPaymentSystem = Enums.TypesOfCashRegisterPaymentSystem.EmptyRef();
		EndIf;
		If Not ValueIsFilled(String.Acquirer) Then
			Continue
		EndIf;
		String.POSTerminal = New Structure("Number, Ref", TrimAll(String.POSTerminalNumber), String.POSTerminalLink); 
		String.AcquirerSContract = String.ConnectionContract;
		
	EndDo;
	XDTOData.Insert("PaymentWithPaymentCards", PaymentByCards);
	
	#EndRegion
	
	#Region PaymentByCertificates
	
	If PropertyOfExchangeFormat(ExchangeComponents, "Документ.ОтчетОРозничныхПродажах.ОплатаСертификатами") Then //@NON-NLS-1
		PaymentByCertificates = QueryResults[TableNumbers.Get("PaymentByCertificates")].Unload();	
		PaymentByCertificates.Columns.Add("GiftCertificateKind");
		For Each FA In PaymentByCertificates Do
			FA.GiftCertificateKind = New Structure("Value, OCRName",
				FA.TypeOfGiftCertificateLink, "Catalog_GiftCertificateKinds");
		EndDo;
		XDTOData.Insert("PaymentByCertificates", PaymentByCertificates);
	EndIf;
	
	#EndRegion
	
	#Region GiftCertificates
	
	If PropertyOfExchangeFormat(ExchangeComponents, "Документ.ОтчетОРозничныхПродажах.ПодарочныеСертификаты") Then //@NON-NLS-1
		GiftCertificates = QueryResults[TableNumbers.Get("GiftCertificates")].Unload(); // ValueTable	
		XDTOData.Insert("GiftCertificates", GiftCertificates);
	EndIf;
	
	#EndRegion
	
	#Region PaymentByCreditCardsForGiftCertificates
	
	If PropertyOfExchangeFormat(ExchangeComponents, "Документ.ОтчетОРозничныхПродажах.ОплатаПлатежнымиКартамиПодарочныхСертификатов") Then //@NON-NLS-1
		
		PaymentByCreditCard = QueryResults[TableNumbers.Get("PaymentByCreditCard")].Unload(); // ValueTable
		
		If PaymentByCreditCard.Count() <> 0 Then
			PaymentByCreditCard.Columns.Add("AcquirerSContract");
			PaymentByCreditCard.Columns.Add("POSTerminal");
		EndIf;
		
		For Each String In PaymentByCreditCard Do
			
			String.POSTerminal = New Structure("Number, Ref", TrimAll(String.POSTerminalNumber), String.POSTerminalLink); 
			String.AcquirerSContract = String.ConnectionContract;
			
		EndDo;
		XDTOData.Insert("PaymentByCreditCardsForGiftCertificates", PaymentByCreditCard);
	
	EndIf;
	#EndRegion
	
	#Region BonusPointAccrual
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		BonusPointAccrual = QueryResults[TableNumbers.Get("BonusPointAccrual")].Unload(); // ValueTable
		BonusPointAccrual.Columns.Add("Counterparty");
		For Each String In BonusPointAccrual Do
			Counterparty = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(String.Partner);
			If Not ValueIsFilled(Counterparty) Then
				Counterparty = CounterpartyFromPartner(String.Partner, ExchangeComponents);
			EndIf;
			String.Counterparty = Counterparty;
		EndDo;
		
		XDTOData.Insert("BonusPointAccrual", BonusPointAccrual);
	EndIf;
	
	#EndRegion
	
	#Region PaymentWithBonusPoints
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		PaymentWithBonusPoints = QueryResults[TableNumbers.Get("PaymentWithBonusPoints")].Unload(); // ValueTable
		PaymentWithBonusPoints.Columns.Add("Counterparty");
		For Each String In PaymentWithBonusPoints Do
			Counterparty = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(String.Partner);
			If Not ValueIsFilled(Counterparty) Then
				Counterparty = CounterpartyFromPartner(String.Partner, ExchangeComponents);
			EndIf;
			String.Counterparty = Counterparty;
		EndDo;
		
		XDTOData.Insert("PaymentWithBonusPoints", PaymentWithBonusPoints);
	EndIf;
	
	#EndRegion
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.RetailSalesReport.SetOfSeries", XDTOData);
	EndIf;
EndProcedure


