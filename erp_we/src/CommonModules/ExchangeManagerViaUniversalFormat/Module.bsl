Procedure AddPCO_Catalog_OrderState_Sending(ConversionRules)
	ConversionRule = DataExchangeXDTOServer.InitializeObjectConversionRule(ConversionRules);
	ConversionRule.OCRName            = "Catalog_OrderState_Send";
	ConversionRule.DataObject      = Metadata.InformationRegisters.SalesOrderStates;
	ConversionRule.FormatObject     = "Справочник.СостояниеЗаказа"; //@NON-NLS-1
	ConversionRule.OnSendData = "OCR_Catalog_OrderState_Send_OnSendData";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "", "StateDate", 1);
	AddPCR(HeaderProperties, "", "OrderDocument", 1, "Document_CustomerOrder_Sending");
	AddPCR(HeaderProperties, "", "OrderState", 1);
	AddPCR(HeaderProperties, "", "OrderStateByLine", 1);
EndProcedure
Procedure OCR_Catalog_OrderState_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	OrderDocument = IBData.Filter.OrderDocument.Value;
	XDTOData.KeyProperties.Insert("OrderDocument", OrderDocument);
	
	RecordTable = IBData.Unload();
	XDTOData.Insert("StateDate", RecordTable[0].EventDate);
	
	If OrderCancelled(OrderDocument) Then
	
		OrderState = "RolledBack_";
		OrderStateByLine = "RolledBack_";
	
	ElsIf RecordTable[0].State = Enums.SalesOrderStates.PendingApproval Then
	
		OrderState = "Accepted";
		OrderStateByLine = "Accepted";
	
	ElsIf RecordTable[0].State = Enums.SalesOrderStates.PendingAdvanceBeforeSupply
		Or RecordTable[0].State = Enums.SalesOrderStates.PendingPrepaymentBeforeShipment Then
		
		OrderState = "Confirmed_";
		OrderStateByLine = "Confirmed_";
	
	ElsIf RecordTable[0].State = Enums.SalesOrderStates.ReadyForSupply
		Or RecordTable[0].State = Enums.SalesOrderStates.PendingSupply Then
		
		OrderState = "Replenished";
		OrderStateByLine = "Replenished";
		
	ElsIf RecordTable[0].State = Enums.SalesOrderStates.ReadyToShip
		Or RecordTable[0].State = Enums.SalesOrderStates.DuringShipment
		Or RecordTable[0].State = Enums.SalesOrderStates.TransferOfTitleToGoodsIsExpected Then
				
		OrderState = "ReadyForIssuance";
		OrderStateByLine = "ReadyForIssuance";
		
	ElsIf RecordTable[0].State = Enums.SalesOrderStates.PendingPaymentAfterShipment
		Or RecordTable[0].State = Enums.SalesOrderStates.ReadyForClosure
		Or RecordTable[0].State = Enums.SalesOrderStates.Closed Then
	
		OrderState = "Completed";
		OrderStateByLine = "Completed";
	
	EndIf;	
	
	XDTOData.Insert("OrderState", OrderState);
	XDTOData.Insert("OrderStateByLine", OrderStateByLine);
EndProcedure

