Procedure PCO_Document_ExpenseCashOrder_ReceiptCCM_Receipt_WhenConvertingDataXDTO(XDTOData, ReceivedData, ExchangeComponents)
	// Filling in the header data
	ReceivedData.Posted = True;
	
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer;
	
	SalesOrder = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, XDTOData.SalesOrder);
	
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	ReturnOfGoodsFromCustomer.Ref AS Ref
	|FROM
	|	Document.ReturnOfGoodsFromCustomer AS ReturnOfGoodsFromCustomer
	|WHERE
	|	ReturnOfGoodsFromCustomer.DocumentSalesOfGoodsAndServices.SalesOrder = &SalesOrder
	|
	|ORDER BY
	|	ReturnOfGoodsFromCustomer.Date DESC";
	
	Query.SetParameter("SalesOrder", SalesOrder);
	QueryResult = Query.Execute();
	If Not QueryResult.IsEmpty() Then
		Selection = QueryResult.Select();
		Selection.Next();
		ReceivedData.DocumentBasis = Selection.Ref;
	EndIf; 
	
	ReceivedData.DocumentAmount = 0;
	If XDTOData.Property("CashRegisterPayments")
		And ValueIsFilled(XDTOData.CashRegisterPayments) Then
		
		For Each String In XDTOData.CashRegisterPayments Do
			If String.TypeOfPayment.Value = "CashPayment" Then
				ReceivedData.DocumentAmount = ReceivedData.DocumentAmount + String.Sum;
			EndIf;
		EndDo;
	EndIf;
EndProcedure
