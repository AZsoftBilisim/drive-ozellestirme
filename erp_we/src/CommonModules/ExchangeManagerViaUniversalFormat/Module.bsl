Procedure OCR_Catalog_Products_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then	
		Return;
	EndIf;
	
	VATRate = Undefined;
	Query = New Query("SELECT
			|	&VATRate AS VATRate
			|FROM
			|	Catalog.Products AS CatProducts,
			|	#TablesVATRate
			|WHERE
			|	CatProducts.Ref = &Ref");
	
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	FillInBidOfNDSInText(Query.Text, "CatProducts.Ref", FormatVersionIs17AndHigher);
	
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("RegistrationCountry", SettingsValueClientServerCached.MainCountry());
	Query.SetParameter("Period", CurrentSessionDate());
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then 
		VATRate = Selection.VATRate;
	EndIf;	  	   
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then 
		VATRateStructure = New Structure;
		VATRateStructure.Insert("Value", VATRate);
		VATRateStructure.Insert("OCRName", "CatalogLink_BIDS_Sending"); 
		XDTOData.Insert("VATRate", VATRateStructure);
	Else
		XDTOData.Insert("VATRate", VATRate);
	EndIf;
	If Not ValueIsFilled(IBData.DescriptionFull) Then
		XDTOData.KeyProperties.Insert("DescriptionFull", IBData.Description);
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
	
	If Not ValueIsFilled(IBData.UnitOfMeasure)
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.19")  Then
		
		DefaultUnit = Catalogs.PackagesAndUnitsOfMeasure.FindByCode("796",,,Catalogs.PackagingGroups.BasicUnitsOfMeasure);	
		If DefaultUnit = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef() Then
			DefaultUnit = Catalogs.PackagesAndUnitsOfMeasure.FindByDescription("pcs", True,,Catalogs.PackagingGroups.BasicUnitsOfMeasure);
		EndIf;
		
		XDTOData.Insert("UnitOfMeasure", DefaultUnit);
	
	EndIf;
	
	If PropertyOfExchangeFormat(ExchangeComponents, "Справочник.ГруппыАналитическогоУчетаНоменклатуры")
		And ValueIsFilled(IBData.AnalyticalGroup) Then //@NON-NLS-1
		XDTOData.Insert("AnalyticalGroup", ValueInICOInstruction(ExchangeComponents, IBData.AnalyticalGroup));
	EndIf;
	
	
	//HS code
	If ValueIsFilled(IBData.FEACNCode)
	And Common.RefExists(IBData.FEACNCode) Then
	   
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			ValueOfHSCode = New Structure("Value, OCRName", IBData.FEACNCode, "Catalog_FEACN_CatalogItem");
		Else
			ValueOfHSCode = Common.ObjectAttributesValues(IBData.FEACNCode, "Code, Description");
		EndIf;
	
		XDTOData.Insert("FEACNCode", ValueOfHSCode);
	
	EndIf;
	
	//Code of the code code
	If ValueIsFilled(IBData.BusinessActivityClassifierCode)
	And Common.RefExists(IBData.BusinessActivityClassifierCode) Then
	
		XDTOData.Insert("BusinessActivityClassifierCode", Common.ObjectAttributesValues(IBData.BusinessActivityClassifierCode, "Code, Description"));
	EndIf;
	
	//The code of the CodOCP
	If ValueIsFilled(IBData.RNCPCode)
	And Common.RefExists(IBData.RNCPCode) Then
	
		XDTOData.Insert("RNCPCode", Common.ObjectAttributeValue(IBData.RNCPCode, "Code"));
	EndIf;
	
	XDTOData.Insert("PriceGroup",   IBData.PriceGroup);
	XDTOData.Insert("ProductKind", IBData.ProductKind);
	XDTOData.Insert("Strength",        IBData.Strength);
		
	If XDTOData.Property("AdditionalInfo") And TypeOf(XDTOData.AdditionalInfo)= Type("Structure") Then
		AdditionalData = XDTOData.AdditionalInfo;
	Else
		AdditionalData = New Structure;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
	
		If Not ExchangeComponents.CorrespondentNodeObject = Undefined Then
			Organization = ?(ExchangeComponents.CorrespondentNodeObject.Companies.Count() > 0,
			ExchangeComponents.CorrespondentNodeObject.Companies[0].Organization, Undefined);
		Else
			Organization = Undefined;	
		EndIf; 
		ThisIsExcisableProduct = ExcisableGoodsAccounting.ThisIsExcisableProduct(IBData.Ref, Organization);
		SettlementSubjectFlag = RetailSalesClientServer.AttributeForSubjectOfFiscalTransactionCalculation(
			IBData.ItemsType,
			ThisIsExcisableProduct,
			ValueIsFilled(IBData.AccountingFeature),
			New Structure("AccountingFeature", IBData.AccountingFeature));
		
		XDTOData.Insert("SoldByWeight",                IBData.YouCanSpecifyWeightInDocuments);
		If PaymentSubjectAttributeIsSupportedInExchange(SettlementSubjectFlag) Then
		    XDTOData.Insert("SettlementSubjectFlag", Common.EnumerationValueName(SettlementSubjectFlag));
		EndIf;		
		XDTOData.Insert("ExcisableGoods",       ThisIsExcisableProduct);		
		XDTOData.Insert("ExpirationDate_",           IBData.ExpirationDate_);			
		
		UnloadUnitOfMeasurementOfExpirationDate(XDTOData, IBData, ExchangeComponents);            
		
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then 
		If ExchangeComponents.ConversionParameters_SSLy.DoNotExportPictures = False Then
			FileExtention = Common.ObjectAttributeValue(IBData.PicturesFile, "Extension");
			PicturesFiles = ImageExtensions();
			
			If PicturesFiles.Find(FileExtention) <> Undefined Then
				XDTOData.Insert("MainPicture", IBData.PicturesFile);
			EndIf; 
		EndIf;
		XDTOData.Insert("Manufacturer", IBData.Manufacturer);
		XDTOData.Insert("Brand", IBData.Brand);
		
	EndIf;
	If  NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17")
		And ValueIsFilled(IBData.ManufacturerImporterConterparty) Then
		XDTOData.Insert("Importer", IBData.ManufacturerImporterConterparty);
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then	
		XDTOData.Insert("TracedGoods", IBData.TracedGoods);	
	EndIf;
	//++ Principal
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21")
		And ValueIsFilled(IBData.Principal) Then
		
		PrincipalStructure = PrincipalByValue(IBData.Principal);
		If ValueIsFilled(PrincipalStructure) Then
			XDTOData.Insert("Principal", PrincipalStructure);
		EndIf;
		
	EndIf;
	//-- Principal
EndProcedure

