	DocumentsBetweenCompaniesAll.Add("RedemptionOfGoodsFromStorage");
	DocumentsBetweenCompaniesAll.Add("CommissionReportIntercompany");
	DocumentsBetweenCompaniesAll.Add("CustomerInvoiceIntercompany");
	
