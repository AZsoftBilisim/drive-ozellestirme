Procedure OCR_Document_ReturnOfRawMaterialsFromToller25_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReturnOfRawMaterialsFromProcessor25_Send", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	// Additional properties for the contract
	If Not ValueIsFilled(IBData.Contract) Then
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData, "Counterparty, Organization");
		DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithVendor";
		XDTOData.Insert("Contract", ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents));
	Else
		XDTOData.Insert("Contract", IBData.Contract);
	EndIf;
	QueryText = 
		"SELECT
		|	InventoryKinds.Products AS Products,
		|	InventoryKinds.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	InventoryKinds.Count AS Count,
		|	CASE
		|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|			THEN CAST(""ReturnContainers"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	InventoryKinds.Sum AS Sum,
		|	InventoryKinds.Price AS Price,
		|	CAST(InventoryKinds.Sum / InventoryKinds.NumberOfPackages AS NUMBER(31, 2)) AS PricePerPackaging
		|FROM
		|	Document.ReceiptOfGoodsFromCustodian.Goods AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	XDTOData.Insert("Goods", Goods);
EndProcedure

