Procedure DeferredProcessing_TransferOfGoodsToCustodian(Object, ExchangeComponents, ObjectIsModified)
	Object.LocalConversionRatio = ProcessingOfExchangeRatesTM.GetConversionFactorFromCurrencyToCurrency(Object.Currency,
										SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization),
										CurrentSessionDate());
	If Not ValueIsFilled(Object.DeliveryMethod) Then
		Object.DeliveryMethod = Enums.TransportMethods.SelfPickup;
	EndIf;
										
	For Each String In Object.Goods Do
		If Not ValueIsFilled(String.Products) Then
			String.Products = DefaultElement(ExchangeComponents, "ProductsService1_");
		EndIf;
	EndDo;
	
	If Not ValueIsFilled(Object.Partner) Then
		Object.Partner = CashServer.GetCounterpartyPartner(Object.Counterparty);
	EndIf;
	
	FillingInAgreementWithClientInHeaderOfDocument(Object);
	AgreementIsFilled = (GetFunctionalOption("ToUseTermsOfSales") And ValueIsFilled(Object.Terms));
	If AgreementIsFilled Then
	    SalesTermsAndConditions = SalesServer.GetTermsAndConditionsOfSale(Object.Terms, True, True);
	    If SalesTermsAndConditions.AgreementStatus <> Enums.StatusesOfTermsOfSales.Closed Then
	        Object.ReusablePackagesReturnDate = ReusablePackageServer.CalculateReturnDateOfMultiTurnContainer(
	            Object,
	            SalesTermsAndConditions.ReusablePackageReturnCycleLength,
	            SalesTermsAndConditions.CalculatePackageReturnDateAccordingToCalendar,
	            SalesTermsAndConditions.ScheduleOfPackageReturn); 
	    EndIf;
	Else
	    Object.ReusablePackagesReturnDate = Date(1,1,1);
	EndIf;
	
	FillInDeliveryParameters(Object);
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
EndProcedure
