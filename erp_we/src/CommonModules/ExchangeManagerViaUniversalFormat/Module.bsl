Procedure DPR_Document_SalesOrder_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	LimitingZeroSumServices   = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.6");
		
	Query = New Query(
		"SELECT TOP 1
		|	TRUE AS ThereAreNotMatchingFormat
		|FROM
		|	Document.SalesOrder.Goods AS Goods
		|		LEFT JOIN Catalog.Products AS ProductsCatalog
		|		ON Goods.Products = ProductsCatalog.Ref
		|WHERE
		|	Goods.Ref = &Ref
		|	AND Goods.Canceled = FALSE
		|	AND Goods.Sum = 0
		|	AND (ProductsCatalog.ItemsType IN (VALUE(Enum.ItemsTypes.OperationService), VALUE(Enum.ItemsTypes.Work_5))
		|				AND &LimitationOfServices)");
	
	Query.SetParameter("Ref",      IBData.Ref);
	Query.SetParameter("LimitationOfServices", LimitingZeroSumServices);
	
	QueryResult = Query.Execute();
	
	UsageOCR.Document_CustomerOrder_Sending = QueryResult.IsEmpty();
EndProcedure

