Procedure OCR_Document_DebtCancellation_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	FillingRules = New Map;
	FillingRules.Insert("AmountARAP", "Sum");
	
	If XDTOData.Property("AccountsReceivable")
		And ValueIsFilled(XDTOData.AccountsReceivable) Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.ARWriteOff;
		DownloadTSDebtAdjustment(ExchangeComponents, XDTOData, ReceivedData, "AccountsReceivable", "Debt_", FillingRules);
		ReceivedData.AdditionalProperties.Insert("Counterparty", XDTOData.CounterpartyDebtor);
	ElsIf XDTOData.Property("AccountsPayable")
		And ValueIsFilled(XDTOData.AccountsPayable) Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.APWriteOff;
		DownloadTSDebtAdjustment(ExchangeComponents, XDTOData, ReceivedData, "AccountsPayable", "Debt_", FillingRules);
		If XDTOData.Property("Creditor") Then
		    ReceivedData.AdditionalProperties.Insert("Counterparty", XDTOData.Creditor);
		EndIf; 
	EndIf;
	
	FillingRules = New Map;
	FillingRules.Insert("Currency",         "Currency");
	FillingRules.Insert("Department",  "Department");
	FillingRules.Insert("IncomeItem",  "IncomeItem");
	FillingRules.Insert("ExpenseItem", "ExpenseItem");
	
	If XDTOData.Property("AmountOfAccountsReceivable") Then
		FillingRules.Insert("AmountOfAccountsReceivable", "Sum");
	ElsIf XDTOData.Property("AmountOfAccountsPayable") Then
		FillingRules.Insert("AmountOfAccountsPayable", "Sum");
	EndIf;
	
	StructureOfData = CollectionDataAsStructure(XDTOData, FillingRules);
	
	If StructureOfData.Property("IncomeItem") Then
		StructureOfData.Insert("AssetRef",New Structure("Value, OCRName",
			StructureOfData.IncomeItem, "Catalog_IncomeItems"));
	ElsIf StructureOfData.Property("ExpenseItem") Then
		StructureOfData.Insert("AssetRef", New Structure("Value, OCRName",
			StructureOfData.ExpenseItem, "Catalog_ExpenseItems"));
	EndIf;
	
	IncomeExpensesAssetsLiabilities = New Array;
	IncomeExpensesAssetsLiabilities.Add(StructureOfData);
	
	ReceivedData.AdditionalProperties.Insert("IncomeExpensesAssetsLiabilities", IncomeExpensesAssetsLiabilities);
EndProcedure
