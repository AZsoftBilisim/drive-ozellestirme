				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_CashAccounts_Receive"), 
				"GetRef"); 
			EndIf;
		EndIf;  
		If XDTOData.AdditionalInfo.Property("CFItem") Then
			If ValueIsFilled(XDTOData.AdditionalInfo.CFItem) Then
				ReceivedData.CashFlowItem = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
				ExchangeComponents,
				XDTOData.AdditionalInfo.CFItem,
				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_CFItems"), 
