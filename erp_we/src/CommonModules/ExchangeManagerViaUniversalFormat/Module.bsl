	|	MAX(GoodsAdjustmentsIncreaseInSales.CCDNumber),
	|	VALUE(Enum.InventoryTypes.OwnGoods),
	|	GoodsAdjustmentsIncreaseInSales.Count,
	|	GoodsAdjustmentsIncreaseInSales.NumberOfPackages,
	|	GoodsAdjustmentsIncreaseInSales.QuantityByGBRN,
	|	GoodsAdjustmentsIncreaseInSales.AmountIncludingVAT,
	|	GoodsAdjustmentsIncreaseInSales.VATAmount,
	|	GoodsAdjustmentsIncreaseInSales.AdjustingEntryType,
	|	GoodsAdjustmentsIncreaseInSales.ItemsType,
	|	GoodsAdjustmentsIncreaseInSales.PostingOption
	|FROM
	|	GoodsAdjustmentsIncreaseInSales AS GoodsAdjustmentsIncreaseInSales   
	|WHERE
	|	GoodsAdjustmentsIncreaseInSales.Ref = &Ref  
	|	
	|GROUP BY
	|	GoodsAdjustmentsIncreaseInSales.Products,
	|	GoodsAdjustmentsIncreaseInSales.Characteristic,
	|	GoodsAdjustmentsIncreaseInSales.Series,
	|	GoodsAdjustmentsIncreaseInSales.Package,
	|	GoodsAdjustmentsIncreaseInSales.VATRate,
	|	GoodsAdjustmentsIncreaseInSales.Count,
	|	GoodsAdjustmentsIncreaseInSales.NumberOfPackages,
	|	GoodsAdjustmentsIncreaseInSales.QuantityByGBRN,
	|	GoodsAdjustmentsIncreaseInSales.AmountIncludingVAT,
	|	GoodsAdjustmentsIncreaseInSales.VATAmount,
	|	GoodsAdjustmentsIncreaseInSales.AdjustingEntryType,
	|	GoodsAdjustmentsIncreaseInSales.ItemsType,
	|	GoodsAdjustmentsIncreaseInSales.PostingOption
	|";
	
	// Changes in products
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT DISTINCT
	|	RevenueAdjustment.Ref AS Ref,
	|	RS_InventoryAccountingAnalytics.Products AS Products,
	|	RS_InventoryAccountingAnalytics.Characteristic AS Characteristic,
	|	RS_InventoryAccountingAnalytics.Series AS Series,
	|	RevenueAdjustment.Package AS Package,
	|	RevenueAdjustment.CCDNumber AS CCDNumber,
	|	RevenueAdjustment.VATRate AS VATRate,
	|	RevenueAdjustment.InventoryOwnerAttribute.InventoryType AS InventoryType,
	|	0 AS Count,
	|	0 AS NumberOfPackages,
	|	0 AS QuantityByGBRN,
	|	RevenueAdjustment.VATAmount AS VATAmount,
	|	RevenueAdjustment.AmountIncludingVAT AS AmountIncludingVAT,
	|	RevenueAdjustment.LineNumber AS LineNumber
	|INTO ChangesInGoodsWithSelectionOfPrev
	|FROM
	|	CorrectedDocument AS CorrectedDocument
	|		LEFT JOIN Document.SaleAdjustment.InventoryOwnerAttributesRevenueAdjustment AS RevenueAdjustment
	|			INNER JOIN InformationRegister.ItemsLocationAttributes AS RS_InventoryAccountingAnalytics
	|			ON (RS_InventoryAccountingAnalytics.Products = RevenueAdjustment.ItemsLocationAttributes.Products)
	|				AND (RS_InventoryAccountingAnalytics.Characteristic = RevenueAdjustment.ItemsLocationAttributes.Characteristic)
	|				AND RevenueAdjustment.ItemsLocationAttributes.Series = RS_InventoryAccountingAnalytics.Series
	|		ON (TRUE) 
	|	INNER JOIN SequenceDocumentParameters AS SequenceDocumentParameters
	|		ON (RevenueAdjustment.Ref IN
	|			(SELECT
	|				SequenceDocumentParameters.Ref
	|				FROM
	|					SequenceDocumentParameters
	|				WHERE
	|					NOT SequenceDocumentParameters.ThisIsFoundationDocument))
	|WHERE
	|	CASE
	|			WHEN RS_InventoryAccountingAnalytics.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				THEN TRUE
	|			WHEN RS_InventoryAccountingAnalytics.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|					AND NOT &ToReturnReusablePackage
	|				THEN TRUE
	|			ELSE FALSE
	|		END
	|	AND RS_InventoryAccountingAnalytics.Products IN
	|			(SELECT
	|				ProductsOfOriginalImplementation.Products
	|			FROM
	|				ProductsOfOriginalImplementation AS ProductsOfOriginalImplementation)
	|
	|UNION
	|
	|SELECT
	|	GoodsToRecordAsReceived.Ref,
	|	GoodsToRecordAsReceived.ItemsLocationAttributes.Products,
	|	GoodsToRecordAsReceived.ItemsLocationAttributes.Characteristic,
	|	GoodsToRecordAsReceived.ItemsLocationAttributes.Series,
	|	GoodsToRecordAsReceived.Package,
	|	GoodsToRecordAsReceived.CCDNumber,
	|	GoodsToRecordAsReceived.VATRate,
	|	GoodsToRecordAsReceived.InventoryOwnerAttribute.InventoryType,
	|	-GoodsToRecordAsReceived.Count,
	|	-GoodsToRecordAsReceived.NumberOfPackages,
	|	-GoodsToRecordAsReceived.QuantityByGBRN,
	|	-GoodsToRecordAsReceived.VATAmount,
	|	-GoodsToRecordAsReceived.AmountIncludingVAT,
	|	GoodsToRecordAsReceived.LineNumber
	|FROM
	|	Document.SaleAdjustment.InventoryOwnerAttributesGoodsReceipt AS GoodsToRecordAsReceived
	|		LEFT JOIN CorrectedDocument AS CorrectedDocument
	|		ON (TRUE)
	|		INNER JOIN InformationRegister.ItemsLocationAttributes AS RS_InventoryAccountingAnalytics
	|		ON (RS_InventoryAccountingAnalytics.Products = GoodsToRecordAsReceived.ItemsLocationAttributes.Products)
	|			AND (RS_InventoryAccountingAnalytics.Characteristic = GoodsToRecordAsReceived.ItemsLocationAttributes.Characteristic)
	|			AND GoodsToRecordAsReceived.ItemsLocationAttributes.Series = RS_InventoryAccountingAnalytics.Series
	|		INNER JOIN SequenceDocumentParameters AS Sequence
	|		ON (GoodsToRecordAsReceived.Ref IN
	|				(SELECT
	|					SequenceDocumentParameters.Ref
	|				FROM
	|					SequenceDocumentParameters
	|				WHERE
	|					NOT Sequence.ThisIsFoundationDocument))
	|WHERE
	|	RS_InventoryAccountingAnalytics.Products IN
	|			(SELECT
	|				ProductsOfOriginalImplementation.Products
	|			FROM
	|				ProductsOfOriginalImplementation AS ProductsOfOriginalImplementation)
	|	AND CASE
	|			WHEN RS_InventoryAccountingAnalytics.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				THEN TRUE
	|			WHEN RS_InventoryAccountingAnalytics.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|					AND NOT &ToReturnReusablePackage
	|				THEN TRUE
	|			ELSE FALSE
	|		END
	|
	|UNION
	|
	|SELECT
	|	GoodsToWriteOff.Ref,
	|	GoodsToWriteOff.ItemsLocationAttributes.Products,
	|	GoodsToWriteOff.ItemsLocationAttributes.Characteristic,
	|	GoodsToWriteOff.ItemsLocationAttributes.Series,
	|	GoodsToWriteOff.Package,
	|	GoodsToWriteOff.CCDNumber,
	|	GoodsToWriteOff.VATRate,
	|	GoodsToWriteOff.InventoryOwnerAttribute.InventoryType,
	|	GoodsToWriteOff.Count,
	|	GoodsToWriteOff.NumberOfPackages,
	|	GoodsToWriteOff.QuantityByGBRN,
	|	GoodsToWriteOff.VATAmount,
	|	GoodsToWriteOff.AmountIncludingVAT,
	|	GoodsToWriteOff.LineNumber
	|FROM
	|	Document.SaleAdjustment.InventoryOwnerAttributesConsumption AS GoodsToWriteOff
	|		INNER JOIN InformationRegister.ItemsLocationAttributes AS RS_InventoryAccountingAnalytics
	|		ON (RS_InventoryAccountingAnalytics.Products = GoodsToWriteOff.ItemsLocationAttributes.Products)
	|			AND (RS_InventoryAccountingAnalytics.Characteristic = GoodsToWriteOff.ItemsLocationAttributes.Characteristic)
	|			AND GoodsToWriteOff.ItemsLocationAttributes.Series = RS_InventoryAccountingAnalytics.Series
	|		LEFT JOIN CorrectedDocument AS CorrectedDocument
	|		ON (TRUE)   
	|		INNER JOIN SequenceDocumentParameters AS SequenceDocumentParameters
	|		ON (GoodsToWriteOff.Ref IN
	|				(SELECT
	|					SequenceDocumentParameters.Ref
	|				FROM
	|					SequenceDocumentParameters
	|				WHERE
	|					NOT SequenceDocumentParameters.ThisIsFoundationDocument))
	|WHERE
	|	RS_InventoryAccountingAnalytics.Products IN
	|			(SELECT
	|				ProductsOfOriginalImplementation.Products
	|			FROM
	|				ProductsOfOriginalImplementation AS ProductsOfOriginalImplementation)
	|	AND CASE
	|			WHEN RS_InventoryAccountingAnalytics.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				THEN TRUE
	|			WHEN RS_InventoryAccountingAnalytics.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|					AND NOT &ToReturnReusablePackage
	|				THEN TRUE
	|			ELSE FALSE
	|		END
	|
	|INDEX BY
	|	RevenueAdjustment.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|	SELECT
	|	MAX(ChangesInProductsWithSelection.Ref) AS Ref,
	|	ChangesInProductsWithSelection.Products AS Products,
	|	ChangesInProductsWithSelection.Characteristic AS Characteristic,
	|	ChangesInProductsWithSelection.Series AS Series,
	|	ChangesInProductsWithSelection.Package AS Package,
	|	ChangesInProductsWithSelection.CCDNumber AS CCDNumber,
	|	ChangesInProductsWithSelection.VATRate AS VATRate,
	|	ChangesInProductsWithSelection.InventoryType AS InventoryType,
	|	SUM(ChangesInProductsWithSelection.Count) AS Count,
	|	SUM(ChangesInProductsWithSelection.NumberOfPackages) AS NumberOfPackages,
	|	SUM(ChangesInProductsWithSelection.QuantityByGBRN) AS QuantityByGBRN,
	|	SUM(ChangesInProductsWithSelection.VATAmount) AS VATAmount,
	|	SUM(ChangesInProductsWithSelection.AmountIncludingVAT) AS AmountIncludingVAT
	|INTO ChangesInProductsWithSelection
	|FROM
	|	ChangesInGoodsWithSelectionOfPrev AS ChangesInProductsWithSelection
	|
	|GROUP BY
	|	ChangesInProductsWithSelection.Products,
	|	ChangesInProductsWithSelection.Characteristic,
	|	ChangesInProductsWithSelection.Series,
	|	ChangesInProductsWithSelection.Package,
	|	ChangesInProductsWithSelection.CCDNumber,
	|	ChangesInProductsWithSelection.VATRate,
	|	ChangesInProductsWithSelection.InventoryType
	|;
	// The fields of the number of TDS and the number of TDS in PM are the types of reserves... The implementation adjustment documents may be empty 
	// in a situation where the option of reflecting discrepancies is selected - on other income or balances have not been selected
	// for this reason, substitution of the GTD number and the amount of the inventory item according to the original implementation document is provided.
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Changes.Products AS Products,
	|	Changes.Characteristic AS Characteristic,
	|	Changes.Series AS Series,
	|	Changes.Package AS Package,
	|	CASE
	|		WHEN Changes.CCDNumber = VALUE(Catalog.CCDNumbers.EmptyRef)
	|			THEN ProductsOfOriginalImplementation.CCDNumber
	|		ELSE Changes.CCDNumber
	|	END AS CCDNumber,
	|	Changes.VATRate AS VATRate,
	|	Changes.InventoryType AS InventoryType,
	|	Changes.Count AS Count,
	|	Changes.NumberOfPackages AS NumberOfPackages,
	|	CASE
	|		WHEN Changes.Count <> 0
	|				AND Changes.QuantityByGBRN = 0
	|				AND ProductsOfOriginalImplementation.QuantityByGBRN <> 0
	|				AND ProductsOfOriginalImplementation.Count <> 0
	|			THEN ProductsOfOriginalImplementation.QuantityByGBRN * Changes.Count / ProductsOfOriginalImplementation.Count
	|		ELSE Changes.QuantityByGBRN
	|	END AS QuantityByGBRN,
	|	Changes.VATAmount AS VATAmount,
	|	Changes.AmountIncludingVAT AS AmountIncludingVAT,
	|	CASE
	|		WHEN NOT Sequence.Corrective
	|				AND Sequence.PointInTime <= DocumentBeforeAdjustment.PointInTime
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ChangesBeforeAdjustments,
	|	CASE
	|		WHEN Sequence.PointInTime <= CorrectedDocument.PointInTime
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ChangesBeforeCorrection
	|INTO ChangesInProductsExpanded
	|FROM
	|	ChangesInProductsWithSelection AS Changes
	|		LEFT JOIN ProductsOfOriginalImplementation AS ProductsOfOriginalImplementation
	|		ON (ProductsOfOriginalImplementation.Products = Changes.Products)
	|			AND (ProductsOfOriginalImplementation.Characteristic = Changes.Characteristic)
	|			AND (ProductsOfOriginalImplementation.Series = Changes.Series)	  		
	|			AND (ProductsOfOriginalImplementation.InventoryType = Changes.InventoryType)
	|			AND (ProductsOfOriginalImplementation.CCDNumber = Changes.CCDNumber)
	|		INNER JOIN SequenceDocumentParameters AS Sequence
	|		ON (NOT Sequence.ThisIsFoundationDocument
	|			AND Changes.Ref IN
	|				(SELECT
	|					Sequence.Ref
	|				FROM
	|					SequenceDocumentParameters))
	|		LEFT JOIN DocumentBeforeAdjustment AS DocumentBeforeAdjustment
	|		ON (TRUE)
	|		LEFT JOIN CorrectedDocument AS CorrectedDocument
	|		ON (TRUE)
	|
	|UNION
	|
	|SELECT
	|	SaleAdjustmentDiscrepancies.Products,
	|	SaleAdjustmentDiscrepancies.Characteristic,
	|	SaleAdjustmentDiscrepancies.Series,
	|	SaleAdjustmentDiscrepancies.Package,
	|	SaleAdjustmentDiscrepancies.CCDNumber,
	|	SaleAdjustmentDiscrepancies.VATRate,
	|	CASE
	|		WHEN ProductsForBalanceEntryAdjustments.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				AND ProductsForBalanceEntryAdjustments.InventoryType IS NULL
	|			THEN VALUE(Enum.InventoryTypes.OwnGoods)
	|		ELSE ProductsForBalanceEntryAdjustments.InventoryType
	|	END,
	|	SaleAdjustmentDiscrepancies.Count,
	|	SaleAdjustmentDiscrepancies.NumberOfPackages,
	|	SaleAdjustmentDiscrepancies.QuantityByGBRN,
	|	SaleAdjustmentDiscrepancies.VATAmount,
	|	SaleAdjustmentDiscrepancies.AmountIncludingVAT,
	|	CASE
	|		WHEN NOT Sequence.Corrective
	|				AND Sequence.PointInTime <= SaleAdjustmentDiscrepancies.Ref.PointInTime
	|			THEN TRUE
	|		ELSE FALSE
	|	END,
	|	CASE
	|		WHEN Sequence.PointInTime <= CorrectedDocument.PointInTime
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|FROM
	|	SequenceDocumentParameters AS Sequence
	|		LEFT JOIN Document.SaleAdjustment.Discrepancies AS SaleAdjustmentDiscrepancies
	|			LEFT JOIN ProductsForBalanceEntryAdjustments AS ProductsForBalanceEntryAdjustments
	|			ON SaleAdjustmentDiscrepancies.Products = ProductsForBalanceEntryAdjustments.Products
	|				AND SaleAdjustmentDiscrepancies.Characteristic = ProductsForBalanceEntryAdjustments.Characteristic
	|				AND SaleAdjustmentDiscrepancies.Series = ProductsForBalanceEntryAdjustments.Series
	|				AND SaleAdjustmentDiscrepancies.Ref = ProductsForBalanceEntryAdjustments.Ref
	|		ON (NOT Sequence.ThisIsFoundationDocument)
	|			AND (SaleAdjustmentDiscrepancies.Ref = Sequence.Ref)
	|		LEFT JOIN CorrectedDocument AS CorrectedDocument
	|		ON (TRUE)
	|WHERE
	|	SaleAdjustmentDiscrepancies.Ref.AdjustingEntryType = VALUE(Enum.AdjustingEntryTypes.AdjustmentByGoodsAndServices)
	|	AND SaleAdjustmentDiscrepancies.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ChangesInProductsExpanded.Products AS Products,
	|	ChangesInProductsExpanded.Characteristic AS Characteristic,
	|	ChangesInProductsExpanded.Series AS Series,
	|	ChangesInProductsExpanded.Package AS Package,
	|	ChangesInProductsExpanded.CCDNumber AS CCDNumber,
	|	ChangesInProductsExpanded.VATRate AS VATRate,
	|	ChangesInProductsExpanded.Count AS Count,
	|	ChangesInProductsExpanded.NumberOfPackages AS NumberOfPackages,
	|	ChangesInProductsExpanded.QuantityByGBRN AS QuantityByGBRN,
	|	ChangesInProductsExpanded.VATAmount AS VATAmount,
	|	ChangesInProductsExpanded.AmountIncludingVAT AS AmountIncludingVAT,
	|	ChangesInProductsExpanded.InventoryType AS InventoryType,
	|	ChangesInProductsExpanded.ChangesBeforeAdjustments AS ChangesBeforeAdjustments,
	|	ChangesInProductsExpanded.ChangesBeforeCorrection AS ChangesBeforeCorrection
	|INTO ChangesInProducts
	|FROM
	|	ChangesInProductsExpanded AS ChangesInProductsExpanded";
	
	// Tabular parts of the Goods (before correction, before correction, after correction)
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	ProductsOfOriginalImplementation.Products AS Products,
	|	ProductsOfOriginalImplementation.Characteristic AS Characteristic,
	|	ProductsOfOriginalImplementation.Series AS Series,
	|	ProductsOfOriginalImplementation.Package AS Package,
	|	ProductsOfOriginalImplementation.VATRate AS VATRate,
	|	ProductsOfOriginalImplementation.CCDNumber AS CCDNumber,
	|	ISNULL(ProductsOfOriginalImplementation.InventoryType, CASE
	|			WHEN ProductsOfOriginalImplementation.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				THEN VALUE(Enum.InventoryTypes.OwnGoods)
	|			ELSE UNDEFINED
