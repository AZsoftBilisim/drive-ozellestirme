Procedure DPR_Document_SaleAdjustment_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	If IBData.BusinessOperation = Enums.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated
		Or IBData.BusinessOperation = Enums.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated
		Or IBData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated
		Or IBData.AdjustmentKind
		= Enums.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated Then
		UsageOCR.Document_ImplementationAdjustment_Debt = True;
	
		Return;
	EndIf;
	
	If UsageOCR.Count() > 0 And Not TypeOfTaxationIsValid(Undefined, IBData.VATTaxation,
		ExchangeComponents.ExchangeFormatVersion) Then
	
		ClearUsageOCR(UsageOCR);
	
		WarningTemplate = NStr(
			"vi = 'Chưa kết xuất chứng từ %1, bởi vì kiểu hệ thống thuế %2 không được hỗ trợ với định dạng %3';
			|ru = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
			|en = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format'; fa = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
			|it = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
			|pl = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
			|tr = '%2 vergilendirme türü %3 biçiminde desteklenmediğinden dolayı %1 belgesi yüklenmedi'");
		WarningText = StrTemplate(WarningTemplate, IBData.Ref, "«" + String(
			IBData.VATTaxation) + "»", String(ExchangeComponents.ExchangeFormatVersion));
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
	
		Return;
	
	EndIf;
	
	ConsignmentSalesAreSupported = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion)
		>= NumberFormatVersion("1.17");
	
	If ValueIsFilled(IBData.Ref) And IBData.AdjustingEntryType = PredefinedValue(
		"Enum.AdjustingEntryTypes.AdjustmentByGoodsAndServices") Or Not ValueIsFilled(
		IBData.DocumentBasis) Then
		Return;
	EndIf;
	
	If TypeOf(IBData.DocumentBasis) = Type("DocumentRef.CustomerInvoice") Then
	
		If Not ConsignmentSalesAreSupported And SalesViaCommissionAgent(Common.ObjectAttributeValue(
			IBData.DocumentBasis, "BusinessOperation"))  Then
			Return;
		EndIf;
		
		If(IBData.AdjustmentKind = Enums.BusinessTransactions.ReturnOfUnderdeliveredGoods 
			And SalesViaCommissionAgent(Common.ObjectAttributeValue(IBData.DocumentBasis, "BusinessOperation")))Then
			Return;
		EndIf;
	
	EndIf;
	
	If TypeOf(IBData.DocumentBasis) = Type("DocumentRef.ReportToMaterialProvider2_5") Then
		Return;
	EndIf;
	
	If ValueIsFilled(IBData.Contract) Then
		
		ContractType = Common.ObjectAttributesValues(IBData.Contract, "ContractType");
		
		If ContractType = PredefinedValue("Enum.ContractTypes.TransferToRental") Then
			Return;
		EndIf;
			
	EndIf;
	
	QueryText =
	"SELECT
	|	SaleAdjustment.Currency AS Currency,
	|	SaleAdjustment.ARAPCurrency AS ARAPCurrency,
	|	SaleAdjustment.CourseNumerator AS TransactionRate,
	|	SaleAdjustment.CourseDenominator AS Multiplier_,
	|	SaleAdjustment.Director.Individual AS Director,
	|	SaleAdjustment.ChiefAccountant.Individual AS ChiefAccountant
	|INTO DocumentHeaderData
	|FROM
	|	Document.SaleAdjustment AS SaleAdjustment
	|WHERE
	|	SaleAdjustment.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
	|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_,
	|	DocumentHeaderData.Director AS Director,
	|	DocumentHeaderData.ChiefAccountant AS ChiefAccountant
	|FROM
	|	DocumentHeaderData AS DocumentHeaderData
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
	|				&Date,
	|				Currency IN
	|					(SELECT
	|						Doc.Currency
	|					FROM
	|						DocumentHeaderData AS Doc)
	|				AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
	|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency
	|WHERE
	|	NOT DocumentHeaderData.Currency = &CurrencyOfComplianceAccounting
	|	AND NOT DocumentHeaderData.ARAPCurrency = &CurrencyOfComplianceAccounting
	|
	|UNION ALL
	|
	|SELECT
	|	DocumentHeaderData.TransactionRate,
	|	DocumentHeaderData.Multiplier_,
	|	DocumentHeaderData.Director,
	|	DocumentHeaderData.ChiefAccountant
	|FROM
	|	DocumentHeaderData AS DocumentHeaderData
	|WHERE
	|	(DocumentHeaderData.Currency = &CurrencyOfComplianceAccounting
	|			OR DocumentHeaderData.ARAPCurrency = &CurrencyOfComplianceAccounting)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.LineNumber AS LineNumber,
	|	NestedQuery.Products AS Products,
	|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
	|	NestedQuery.Characteristic AS Characteristic,
	|	NestedQuery.Series AS Series,
	|	NestedQuery.Package AS Package,
	|	NestedQuery.Count AS Count,
	|	NestedQuery.NumberOfPackages AS NumberOfPackages,
	|	CASE
	|		WHEN &PriceIncludesVAT
	|			THEN NestedQuery.AmountIncludingVAT
	|		ELSE NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount
	|	END AS Sum,
	|	NestedQuery.VATRate AS VATRate,
	|	NestedQuery.VATAmount AS VATAmount,
	|	NestedQuery.InventoryType AS InventoryType,
	|	NestedQuery.CCDNumber AS CCDNumber,
	|	NestedQuery.QuantityByGBRN AS QuantityByGBRN,
	|	NestedQuery.ToIncomeExpenses AS ToIncomeExpenses,
	|	CASE
	|		WHEN &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT > 0
	|				AND NestedQuery.Count > 0
	|			THEN CAST(NestedQuery.AmountIncludingVAT / NestedQuery.Count AS NUMBER(31,2))
	|		WHEN NOT &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount > 0
	|				AND NestedQuery.Count > 0
	|			THEN CAST((NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount) / NestedQuery.Count AS NUMBER(31,2))
	|		ELSE 0
	|	END AS Price,
	|	CASE
	|		WHEN &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT > 0
	|				AND NestedQuery.NumberOfPackages > 0
	|			THEN CAST(NestedQuery.AmountIncludingVAT / NestedQuery.NumberOfPackages AS NUMBER(31,2))
	|		WHEN NOT &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount > 0
	|				AND NestedQuery.NumberOfPackages > 0
	|			THEN CAST((NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount) / NestedQuery.NumberOfPackages AS NUMBER(31,2))
	|		ELSE 0
	|	END AS PricePerPackaging
	|INTO TTProductsRegistration
	|FROM
	|	(SELECT
	|		AdjustmentOfRealizationTypesOfStocksRecording.LineNumber AS LineNumber,
	|		AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Products AS Products,
	|		AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
	|		AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Characteristic AS Characteristic,
	|		AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Series AS Series,
	|		AdjustmentOfRealizationTypesOfStocksRecording.Package AS Package,
	|		AdjustmentOfRealizationTypesOfStocksRecording.Count AS Count,
	|		AdjustmentOfRealizationTypesOfStocksRecording.NumberOfPackages AS NumberOfPackages,
	|		AdjustmentOfRealizationTypesOfStocksRecording.AmountIncludingVAT AS AmountIncludingVAT,
	|		AdjustmentOfRealizationTypesOfStocksRecording.VATRate AS VATRate,
	|		AdjustmentOfRealizationTypesOfStocksRecording.VATAmount AS VATAmount,
	|		CASE
	|			WHEN AdjustmentOfRealizationTypesOfStocksRecording.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|				THEN CAST(""CommissionGoods"" AS STRING(20))
	|			ELSE CAST(&OwnProducts AS STRING(20))
	|		END AS InventoryType,
	|		AdjustmentOfRealizationTypesOfStocksRecording.CCDNumber AS CCDNumber,
	|		AdjustmentOfRealizationTypesOfStocksRecording.QuantityByGBRN AS QuantityByGBRN,
	|		AdjustmentOfRealizationTypesOfStocksRecording.ToIncomeExpenses AS ToIncomeExpenses
	|	FROM
	|		Document.SaleAdjustment.InventoryOwnerAttributesGoodsReceipt AS AdjustmentOfRealizationTypesOfStocksRecording
	|	WHERE
	|		AdjustmentOfRealizationTypesOfStocksRecording.Ref = &Ref
	|		AND (AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				OR AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|					AND NOT ISNULL(CAST(AdjustmentOfRealizationTypesOfStocksRecording.Ref.DocumentBasis AS Document.CustomerInvoice).ToReturnReusablePackage, FALSE))) AS NestedQuery
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.LineNumber AS LineNumber,
	|	NestedQuery.Products AS Products,
	|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
	|	NestedQuery.Characteristic AS Characteristic,
	|	NestedQuery.Package AS Package,
	|	NestedQuery.Series AS Series,
	|	NestedQuery.Count AS Count,
	|	NestedQuery.NumberOfPackages AS NumberOfPackages,
	|	CASE
	|		WHEN &PriceIncludesVAT
	|			THEN NestedQuery.AmountIncludingVAT
	|		ELSE NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount
	|	END AS Sum,
	|	NestedQuery.VATRate AS VATRate,
	|	NestedQuery.VATAmount AS VATAmount,
	|	NestedQuery.InventoryType AS InventoryType,
	|	NestedQuery.CCDNumber AS CCDNumber,
	|	NestedQuery.QuantityByGBRN AS QuantityByGBRN,
	|	NestedQuery.ToIncomeExpenses AS ToIncomeExpenses,
	|	CASE
	|		WHEN &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT > 0
	|				AND NestedQuery.Count > 0
	|			THEN CAST(NestedQuery.AmountIncludingVAT / NestedQuery.Count AS NUMBER(31,2))
	|		WHEN NOT &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount > 0
	|				AND NestedQuery.Count > 0
	|			THEN CAST((NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount) / NestedQuery.Count AS NUMBER(31,2))
	|		ELSE 0
	|	END AS Price,
	|	CASE
	|		WHEN &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT > 0
	|				AND NestedQuery.NumberOfPackages > 0
	|			THEN CAST(NestedQuery.AmountIncludingVAT / NestedQuery.NumberOfPackages AS NUMBER(31,2))
	|		WHEN NOT &PriceIncludesVAT
	|				AND NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount > 0
	|				AND NestedQuery.NumberOfPackages > 0
	|			THEN CAST((NestedQuery.AmountIncludingVAT - NestedQuery.VATAmount) / NestedQuery.NumberOfPackages AS NUMBER(31,2))
	|		ELSE 0
	|	END AS PricePerPackaging
	|INTO TTProductsWriteOff
	|FROM
	|	(SELECT
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.LineNumber AS LineNumber,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Products AS Products,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Characteristic AS Characteristic,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.Package AS Package,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Series AS Series,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.Count AS Count,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.NumberOfPackages AS NumberOfPackages,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.AmountIncludingVAT AS AmountIncludingVAT,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.VATRate AS VATRate,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.VATAmount AS VATAmount,
	|		CASE
	|			WHEN AdjustmentOfSalesTypesOfInventoryWriteOff.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|				THEN CAST(""CommissionGoods"" AS STRING(20))
	|			ELSE CAST(&OwnProducts AS STRING(20))
	|		END AS InventoryType,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.CCDNumber AS CCDNumber,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.QuantityByGBRN AS QuantityByGBRN,
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.ToIncomeExpenses AS ToIncomeExpenses
	|	FROM
	|		Document.SaleAdjustment.InventoryOwnerAttributesConsumption AS AdjustmentOfSalesTypesOfInventoryWriteOff
	|	WHERE
	|		AdjustmentOfSalesTypesOfInventoryWriteOff.Ref = &Ref
	|		AND (AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|				OR AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|					AND NOT ISNULL(CAST(AdjustmentOfSalesTypesOfInventoryWriteOff.Ref.DocumentBasis AS Document.CustomerInvoice).ToReturnReusablePackage, FALSE))) AS NestedQuery
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products AS Products,
	|	&QueryTextCharacteristic,
	|	&QueryTextPackage,
	|	&QueryTextSeries,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	Goods.UnitOfMeasure AS UnitOfMeasure,
	|	Goods.InventoryType AS InventoryType,
	|	Goods.Count AS Count,
	|	Goods.Sum AS Sum,
	|	0 AS Price
	|FROM
	|	TTProductsRegistration AS Goods
	|WHERE
	|	Goods.ToIncomeExpenses
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products AS Products,
	|	&QueryTextCharacteristic,
	|	&QueryTextPackage,
	|	&QueryTextSeries,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	Goods.UnitOfMeasure AS UnitOfMeasure,
	|	Goods.InventoryType AS InventoryType,
	|	Goods.Count AS Count,
	|	Goods.Sum AS Sum,
	|	0 AS Price
	|FROM
	|	TTProductsWriteOff AS Goods
	|WHERE
	|	Goods.ToIncomeExpenses
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.LineNumber AS LineNumber,
	|	Goods.Products AS Products,
	|	Goods.UnitOfMeasure AS UnitOfMeasure,
	|	&QueryTextCharacteristic,
	|	&QueryTextPackage,
	|	&QueryTextSeries,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	Goods.Count AS Count,
	|	Goods.Sum AS Sum,
	|	Goods.VATRate AS VATRate,
	|	Goods.VATAmount AS VATAmount,
	|	Goods.InventoryType AS InventoryType,
	|	Goods.Price AS Price
	|FROM
	|	TTProductsRegistration AS Goods
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.LineNumber AS LineNumber,
	|	Goods.Products AS Products,
	|	Goods.UnitOfMeasure AS UnitOfMeasure,
	|	&QueryTextCharacteristic,
	|	&QueryTextPackage,
	|	&QueryTextSeries,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	Goods.Count AS Count,
	|	Goods.Sum AS Sum,
	|	Goods.VATRate AS VATRate,
	|	Goods.VATAmount AS VATAmount,
	|	Goods.InventoryType AS InventoryType,
	|	Goods.Price AS Price
	|FROM
	|	TTProductsWriteOff AS Goods";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic", GetTextOfCharacteristicsRequest(
		ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextPackage", GetPackagingRequestText(ExchangeComponents,
		"Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextSeries", GetSeriesRequestText(ExchangeComponents,
		"Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID", GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest", GetTextOfCCDRequest(ExchangeComponents, "Goods"));
	
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("CurrencyOfComplianceAccounting", CurrencyOfComplianceAccounting);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(
		IBData.Organization));
	Query.SetParameter("PriceIncludesVAT", IBData.PriceIncludesVAT);
	
	QueryResult = Query.ExecuteBatch();
	
	OperationData = QueryResult[1].Select();
	If OperationData.Next() Then
		IBData.AdditionalProperties.Insert("TransactionRate", OperationData.TransactionRate);
		IBData.AdditionalProperties.Insert("Multiplier_", OperationData.Multiplier_);
		IBData.AdditionalProperties.Insert("Director", OperationData.Director);
		IBData.AdditionalProperties.Insert("ChiefAccountant", OperationData.ChiefAccountant);
	EndIf;
	
	ItemsToBeWrittenOffInAccounting      = QueryResult[QueryResult.Count() - 4].Unload();
	GoodsToBeRegisteredInAccounting = QueryResult[QueryResult.Count() - 3].Unload();
	GoodsReturn_                    = QueryResult[QueryResult.Count() - 2].Unload();
	Sales_Goods                 = QueryResult[QueryResult.Count() - 1].Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, ItemsToBeWrittenOffInAccounting);
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsToBeRegisteredInAccounting);
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsReturn_);
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Sales_Goods);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then
		RedefineVATRateForOldFormats(Sales_Goods, False);
		RedefineVATRateForOldFormats(GoodsReturn_, False);
		RedefineVATRateForOldFormats(ItemsToBeWrittenOffInAccounting, False);
		RedefineVATRateForOldFormats(GoodsToBeRegisteredInAccounting, False);
	EndIf;
	If GoodsToBeRegisteredInAccounting.Count() > 0 Then
		FillInPriceWriteOffReEntry(GoodsToBeRegisteredInAccounting, ExchangeComponents);
	
		UsageOCR.Document_ImplementationAdjustment_Registration = True;
		IBData.AdditionalProperties.Insert("GoodsToBeRegisteredInAccounting", GoodsToBeRegisteredInAccounting);
	EndIf;
	
	If ItemsToBeWrittenOffInAccounting.Count() > 0 Then
		FillInPriceWriteOffReEntry(ItemsToBeWrittenOffInAccounting, ExchangeComponents);
	
		UsageOCR.Document_SalesAdjustment_InventoryWriteOff = True;
		IBData.AdditionalProperties.Insert("ItemsToBeWrittenOffInAccounting", ItemsToBeWrittenOffInAccounting);
	EndIf;
	
	If IBData.AdjustmentKind = Enums.BusinessTransactions.SaleOfOverdeliveredGoods Then
		If UsageOCR.Property("Document_ImplementationAdjustment_Implementation") Then
			UsageOCR.Document_ImplementationAdjustment_Implementation = True;
		EndIf;
		IBData.AdditionalProperties.Insert("Goods", Sales_Goods);
	ElsIf IBData.AdjustmentKind = Enums.BusinessTransactions.ReturnOfUnderdeliveredGoods Then
		If UsageOCR.Property("Document_ImplementationAdjustment_Return") Then
			UsageOCR.Document_ImplementationAdjustment_Return = True;
		EndIf;
		IBData.AdditionalProperties.Insert("Goods", GoodsReturn_); 
	ElsIf TypeOf(IBData.DocumentBasis) = Type("DocumentRef.SourceDocument")
		And Common.ObjectAttributesValues(IBData.DocumentBasis, "SourceDocumentType").SourceDocumentType = Enums.SourceDocumentTypes.SaleToCustomer Then
		UsageOCR.Document_ImplementationAdjustment_Dispatch = False;
	Else
		If UsageOCR.Property("Document_ImplementationAdjustment_Dispatch") Then
			UsageOCR.Document_ImplementationAdjustment_Dispatch = True;
		EndIf;
	EndIf;
EndProcedure


