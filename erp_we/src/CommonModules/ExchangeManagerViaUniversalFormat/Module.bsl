	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	
	UsePurchaseOrders = GetFunctionalOption("UsePurchaseOrders");
	If UsePurchaseOrders
		And XDTOData.Property("OrderDocument")
		And ValueIsFilled(XDTOData.OrderDocument) Then
		ReceivedData.ReceiptUnderOrders = True;
