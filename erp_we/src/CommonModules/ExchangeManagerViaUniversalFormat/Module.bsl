	For Each TSRow In Object[TSName] Do
		
		For Each ColumnName In Columns Do
			If ValueIsFilled(TSRow[ColumnName]) And Not Common.RefExists(TSRow[ColumnName]) Then
				TSRow[ColumnName] = Undefined;
