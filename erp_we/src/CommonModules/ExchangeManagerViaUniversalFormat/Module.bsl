		StringDataStructure.Insert(MapItem.Key,ValueOfTSProps); 
	EndDo;
EndProcedure

Procedure FillInTableOfBalancesForSettlementsWithCounterparties(ExchangeComponents, IBData, XDTOData, DefaultContractType)
	QueryText =
		"SELECT
		|	EnteringBalancesSettlementsWithPartners.Counterparty AS Counterparty,
		|	EnteringBalancesSettlementsWithPartners.Sum AS Sum,
		|	EnteringBalancesSettlementsWithPartners.SumCompl AS SumCompl,
		|	CASE
		|		WHEN EnteringBalancesSettlementsWithPartners.ARAPObject REFS Catalog.CounterpartyContracts
		|			THEN EnteringBalancesSettlementsWithPartners.ARAPObject
		|		ELSE UNDEFINED
		|	END AS ObjectAsContract,
		|	CASE
		|		WHEN EnteringBalancesSettlementsWithPartners.ARAPObject REFS Catalog.CounterpartyContracts
		|			THEN EnteringBalancesSettlementsWithPartners.ARAPObject.Currency <> EnteringBalancesSettlementsWithPartners.Ref.Organization.LocalAccountingCurrency AND NOT EnteringBalancesSettlementsWithPartners.ARAPObject.ForeignCurrencyTransaction
		|		ELSE FALSE
		|	END AS CalculationsInConventionalUnits,
		|	EnteringBalancesSettlementsWithPartners.ARAPCurrency AS ARAPCurrency,
		|	CurrencyRatesCut.CourseNumerator AS TransactionRate,
		|	CurrencyRatesCut.CourseDenominator AS Multiplier_,
		|	&QueryTextDocumentOfARAPAccounting AS DocumentOfARAPAccounting
		|FROM
		|	Document.OBEntry.PartnersARAPAccounting AS EnteringBalancesSettlementsWithPartners
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&SliceDate, BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
		|		ON EnteringBalancesSettlementsWithPartners.ARAPCurrency = CurrencyRatesCut.Currency
		|WHERE
		|	EnteringBalancesSettlementsWithPartners.Ref = &Ref";
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		QueryTextDocumentOfARAPAccounting = "EnteringBalancesSettlementsWithPartners.DocumentOfARAPAccounting";
	Else
		QueryTextDocumentOfARAPAccounting = "Undefined";
	EndIf;
		
	QueryText = StrReplace(QueryText, "&QueryTextDocumentOfARAPAccounting",
		QueryTextDocumentOfARAPAccounting);
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref",    IBData.Ref);
	Query.SetParameter("SliceDate", IBData.Date);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	TableCalculations = Query.Execute().Unload();
	TableCalculations.Columns.Add("Contract");
	
	For Each LineCalculations In TableCalculations Do
	
		If ValueIsFilled(LineCalculations.ObjectAsContract) Then
			LineCalculations.Contract = LineCalculations.ObjectAsContract;
		Else
	
			If TypeOf(LineCalculations.Counterparty) = Type("CatalogRef.Companies") Then	
				LineCalculations.Counterparty = CounterpartyFromOrganization(LineCalculations.Counterparty, ExchangeComponents);
			EndIf;
		
			DefaultParameters = New Structure(ContractFixedKeyStructure());
			DefaultParameters.Organization              = IBData.Organization;
			DefaultParameters.Counterparty               = LineCalculations.Counterparty;
			DefaultParameters.CalculationsInConventionalUnits = False;
			DefaultParameters.ARAPCurrency     = LineCalculations.ARAPCurrency;
			DefaultParameters.TypeOfAgreement              = DefaultContractType;
			
			LineCalculations.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents);
			
		EndIf;
	EndDo;
	
	XDTOData.Insert("Calculations", TableCalculations);
EndProcedure
Procedure FillInTableOfBalancesForSettlementsWithAccountablePersons(IBData, XDTOData)
	Query = New Query(
	"SELECT
	|	EnteringBalancesSettlementsWithAccountablePersons.AdvanceHolder AS Individual,
	|	EnteringBalancesSettlementsWithAccountablePersons.Currency AS ARAPCurrency,
	|	EnteringBalancesSettlementsWithAccountablePersons.Sum AS Sum,
	|	EnteringBalancesSettlementsWithAccountablePersons.SumCompl AS SumCompl
	|FROM
	|	Document.OBEntry.AdvanceHoldersARAPAccounting_ AS EnteringBalancesSettlementsWithAccountablePersons
	|WHERE
	|	EnteringBalancesSettlementsWithAccountablePersons.Ref = &Ref");
	Query.SetParameter("Ref", IBData.Ref);
	
	TableCalculations = Query.Execute().Unload();
	
	XDTOData.Insert("Calculations", TableCalculations);
EndProcedure
Procedure FillInTableOfArticleDDSIKBusinessTransactions(Object, ArticlesOfDDSIBusinessTransaction)
	If TypeOf(Object) = Type("DocumentObject.ExpenseReport") Then
		
		For Each String In Object.PaymentToVendors Do
		
			If ValueIsFilled(String.CashFlowItem) Then
				TableRow = ArticlesOfDDSIBusinessTransaction.Add();
				TableRow.CFItem   = Object.CashFlowItem;
				TableRow.BusinessTransaction = Enums.BusinessTransactions.PurchaseViaAdvanceHolder; 
			EndIf;
			
		EndDo;
		
		For Each String In Object.OtherExpenses Do
		
			If ValueIsFilled(String.CashFlowItem) Then
				TableRow = ArticlesOfDDSIBusinessTransaction.Add();
				TableRow.CFItem   = Object.CashFlowItem;
				TableRow.BusinessTransaction = Enums.BusinessTransactions.OtherExpensesOfAdvanceHolders; 
			EndIf;
			
		EndDo;
		
	ElsIf TypeOf(Object) = Type("DocumentObject.RetailSalesReport") Then
		
		If Common.HasObjectAttribute("CashFlowItem", Object.Metadata())
			And ValueIsFilled(Object.CashFlowItem) Then
		
			TableRow = ArticlesOfDDSIBusinessTransaction.Add();
			TableRow.CFItem   = Object.CashFlowItem;
			TableRow.BusinessTransaction = Enums.BusinessTransactions.RetailSaleOfGoods; 
			
		EndIf;
		
	ElsIf TypeOf(Object) = Type("DocumentObject.VendorInvoice") Then
		
		If ValueIsFilled(Object.CashFlowItem)
			And ValueIsFilled(Object.BusinessOperation) Then
		
			TableRow = ArticlesOfDDSIBusinessTransaction.Add();
			TableRow.CFItem = Object.CashFlowItem;
			TableRow.BusinessTransaction = Object.BusinessOperation; 
			
		EndIf;
		
	ElsIf TypeOf(Object) = Type("DocumentObject.BankAccountReceiptNote")
		Or TypeOf(Object) = Type("DocumentObject.CashAccountReceiptNote")
		Or TypeOf(Object) = Type("DocumentObject.CashVoucher") 
		Or TypeOf(Object) = Type("DocumentObject.BankAccountIssue") Then
		
		If ValueIsFilled(Object.BusinessOperation) Then
			If ValueIsFilled(Object.CashFlowItem) Then
			
				TableRow = ArticlesOfDDSIBusinessTransaction.Add();
				TableRow.CFItem = Object.CashFlowItem;
				TableRow.BusinessTransaction = Object.BusinessOperation; 
			EndIf;
			
			For Each DecryptionString In Object.ARAPDetails Do
			
				If ValueIsFilled(DecryptionString.CashFlowItem) Then
					TableRow = ArticlesOfDDSIBusinessTransaction.Add();
					TableRow.CFItem = DecryptionString.CashFlowItem;
					TableRow.BusinessTransaction = Object.BusinessOperation; 
				EndIf;
			
			EndDo;
		
		EndIf;
	
	EndIf;
EndProcedure
