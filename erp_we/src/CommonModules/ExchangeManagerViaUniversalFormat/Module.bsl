Procedure OCR_Document_PaymentCardTransaction_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count()>1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_PaymentCardOperation_Sending", 
										"ARAPDetails", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
								
	XDTOData.Insert("Acquirer", Common.ObjectAttributeValue(IBData.AcquiringContract, "Counterparty"));
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17")
		And ValueIsFilled(IBData.FPSPaymentID) Then
		XDTOData.Insert("FPSPaymentID", IBData.FPSPaymentID);
	EndIf;
	
	If ValueIsFilled(IBData.POSTerminal)
		And Common.RefExists(IBData.POSTerminal) Then
		
		ETData = Common.ObjectAttributesValues(IBData.POSTerminal, "Code, Ref");
		POSTerminal = New Structure("Number, Ref", TrimAll(ETData.Code), ETData.Ref);
		XDTOData.Insert("POSTerminal", POSTerminal);
	EndIf;
	
	BankAccount = Common.ObjectAttributeValue(IBData.AcquiringContract, "BankAccount");
	
	Department = ?(ValueIsFilled(BankAccount),
		Common.ObjectAttributeValue(BankAccount, "Department"), Undefined);
	
	If ValueIsFilled(IBData.Department) And ValueIsFilled(IBData.Organization) Then
		
		RegistrationOfSubdivisionWithTaxAuthority = DetermineRegistrationWithTaxAuthority(IBData.Department, IBData.Organization);
		DivisionName = Common.ObjectAttributeValue(IBData.Department, "Description");
		
		StructureDataDivisions = New Structure(
			"Description, RegistrationOfSubdivisionWithTaxAuthority", 
			DivisionName,
			RegistrationOfSubdivisionWithTaxAuthority);
		
		Instruction = New Structure;
		Instruction.Insert("Value", StructureDataDivisions);
		Instruction.Insert("OCRName", "Catalog_Divisions_FromStructure");
		
		XDTOData.Insert("Department", Instruction);
		
	Else
		XDTOData.Insert("Department", Undefined);
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	Query = New Query();
	Query.Text = "SELECT
		|	ARAPDetails.Sum AS Sum,
		|	ARAPDetails.AmountARAP AS AmountARAP,
		|	ARAPDetails.ARAPCurrency AS ARAPCurrency,
		|	ARAPDetails.ARAPObject.Object AS OrderDocument,
		|	ARAPDetails.PaymentPurpose AS PaymentPurpose,
		|	ARAPDetails.CashFlowItem AS CFItem,
		|	ARAPDetails.RowID AS RowID,
		|	ARAPDetails.VATRate AS VATRate,
		|	ARAPDetails.VATAmount
		|INTO TSData
		|FROM
		|	Document.PaymentCardTransaction.ARAPDetails AS ARAPDetails
		|WHERE
		|	ARAPDetails.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TSData.Sum,
		|	TSData.AmountARAP,
		|	TSData.ARAPCurrency,
		|	TSData.OrderDocument AS OrderRef,
		|	TSData.CFItem,
		|	ExchangeRates.CourseNumerator AS TransactionRate,
		|	ExchangeRates.CourseDenominator AS Multiplier_,
		|	TSData.RowID AS RowID,
		|	TSData.VATRate AS VATRate,
		|	TSData.VATAmount
		|FROM
		|	TSData AS TSData
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
		|				&Date,
		|				Currency IN
		|					(SELECT DISTINCT
		|						TSData.ARAPCurrency
		|					FROM
		|						TSData) AND BaseCurrency = &BaseCurrency) AS ExchangeRates
		|		ON (ExchangeRates.Currency = TSData.ARAPCurrency)";
	
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	ARAPDetails = Query.Execute().Unload();
	ARAPDetails.Columns.Add("Contract");
	ARAPDetails.Columns.Add("OrderDocument");
	ARAPDetails.Columns.Add("DocumentOfARAPAccounting");
	ARAPDetails.Columns.Add("MethodOfDebtRepayment");
	For Each String In ARAPDetails Do
		// Calculation of the contract.
		TypeOfAgreement = Undefined;
		VueCalculations = Undefined;
	
		If Not ValueIsFilled(String.OrderRef) Then
			TypeOfAgreement = "WithCustomer";
		Else
			OrderType_5 = TypeOf(String.OrderRef);
			
			ContractLink = Undefined;
			If OrderType_5 = Type("CatalogRef.CounterpartyContracts") Then
				ContractLink = String.OrderRef;
			Else
				If String.OrderRef.Metadata().Attributes.Find("Contract") <> Undefined Then
					ContractLink = Common.ObjectAttributeValue(String.OrderRef, "Contract");
				EndIf;
				
				UploadOrderSettlementDocumentPaymentTranscript(String, String.OrderRef, IBData.Organization, ExchangeComponents);
				String.MethodOfDebtRepayment = MethodOfDebtRepaymentLineDecryption(String, ExchangeComponents);
			EndIf;
			If ValueIsFilled(ContractLink) Then
				String.Contract = New Structure("Value, OCRName",
					ContractLink, "Catalog_CounterpartyContracts");
				Continue;
			EndIf;
		
			// The order type can be one of the following;
			//	- Document link.Customer's order,
			//	- Document link.Implementationsservices,
			//	- Document link.Actfulfilled works,
			//	- Document link.Commissionaire's Report,
			//	- Document link.Report of the Commissionerospisition,
			//	- Document link.Report to the Correspondent,
			//	- Document link.Report of the Commission by the organizations,
			//	- Document link.Transfers of goods between organizations.
			
			If OrderType_5 = Type("DocumentRef.CommissionReportIntercompany") Then
				TypeOfAgreement = "WithConsignee";
			ElsIf OrderType_5 = Type("DocumentRef.CustomerInvoiceIntercompany")
				Or String.OrderRef.Metadata().Attributes.Find("Terms") = Undefined Then
				TypeOfAgreement = "WithCustomer";
			Else
				
				// An agreement can be obtained for all variants of the operation.
				Terms = Common.ObjectAttributeValue(String.OrderRef, "Terms");
				
				// To continue analyzing the operation, it is necessary to determine the type of contract.
				TypeOfAgreement = TypeOfCounterpartyAgreement(String.OrderRef, Terms, IBData.BusinessOperation);
				TypeOfAgreement = ?(ValueIsFilled(TypeOfAgreement), TypeOfAgreement, "WithVendor");
				
				If TypeOfAgreement = "WithConsignor" Or TypeOfAgreement = "WithConsignee" Then
					// Commission agreements are unloaded without separation by transactions and orders and are always not in yandex units.
					VueCalculations = False;
				Else
					If ValueIsFilled(Terms) Then
						UECalculationData = Common.ObjectAttributesValues(Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
						VueCalculations 		= VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
					EndIf;
				EndIf;
			EndIf;
		EndIf;
		
		If VueCalculations = Undefined Then
			VueCalculations = IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> String.ARAPCurrency;
		EndIf;
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.Counterparty = IBData.Counterparty;
		DefaultParameters.ARAPCurrency = String.ARAPCurrency;
		DefaultParameters.TypeOfAgreement = TypeOfAgreement;
		DefaultParameters.CalculationsInConventionalUnits = VueCalculations;
		String.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, String.OrderRef, IBData);
	EndDo;  
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(ARAPDetails, False);
	EndIf;
	XDTOData.Insert("ARAPDetails", ARAPDetails);
	//++ NOT TM
	
	
	//-- DON'T TM
EndProcedure


