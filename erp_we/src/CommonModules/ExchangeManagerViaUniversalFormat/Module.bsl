Procedure GetContractParametersForOrder(OrderDocument, PaymentType_, TypeOfAgreement, CalculationsInConventionalUnits, Invert = False)
	If ValueIsFilled(OrderDocument) Then
		OrderType_5 = TypeOf(OrderDocument);
		
		If OrderType_5 = Type("DocumentRef.CommissionReportIntercompany") Then
			TypeOfAgreement = ?(PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting, "WithConsignor", "WithConsignee");
		EndIf;
		
		Terms = Undefined;
		If OrderDocument.Metadata().Attributes.Find("Terms") <> Undefined Then
			Terms = Common.ObjectAttributeValue(OrderDocument, "Terms");
			
			// To continue analyzing the operation, it is necessary to determine the type of contract
			If Not ValueIsFilled(TypeOfAgreement) Then
				TypeOfAgreement = TypeOfCounterpartyAgreement(OrderDocument, Terms, Undefined);
			EndIf;
		EndIf;
		
		// To continue analyzing the operation, it is necessary to determine the type of contract
		If Not ValueIsFilled(TypeOfAgreement) Then
			TypeOfAgreement = ?(PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting, "WithVendor", "WithCustomer");
		EndIf;
		
		If TypeOfAgreement = "WithConsignor" Or TypeOfAgreement = "WithConsignee" Then
			// Commission agreements are unloaded without separation by transactions and orders and are always not in yandex units.
			CalculationsInConventionalUnits = False;
		Else
			If ValueIsFilled(Terms) Then
				UECalculationData          = Common.ObjectAttributesValues(Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
				CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization);
			ElsIf OrderType_5 = Type("DocumentRef.CustomerInvoice") Or OrderType_5 = Type("DocumentRef.VendorInvoice") Then
				OrderData = Common.ObjectAttributesValues(OrderDocument, "Currency,ARAPCurrency,Organization");
				CalculationsInConventionalUnits = OrderData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(OrderData.Organization) And OrderData.Currency <> OrderData.ARAPCurrency;
			Else
				CalculationsInConventionalUnits = False;
			EndIf;
		EndIf;
	Else
		CalculationsInConventionalUnits = False;
		TypeOfAgreement = ?(PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting, "WithVendor", "WithCustomer");
	EndIf;
	
	If Invert Then
		If TypeOfAgreement = "WithVendor" Then
			TypeOfAgreement = "WithCustomer";
		ElsIf TypeOfAgreement = "WithCustomer" Then
			TypeOfAgreement = "WithVendor";
		EndIf;
		
		If TypeOfAgreement = "WithConsignor" Then
			TypeOfAgreement = "WithConsignee";
		ElsIf TypeOfAgreement = "WithConsignee" Then
			TypeOfAgreement = "WithConsignor";
		EndIf;
	EndIf;
EndProcedure
Function GetDetailsOfCashShiftOnDate(Object, DateTime)
	CashRegisterCashRegisterFiscalDevice = CashRegisterCashRegisterFiscalDevice(Object);
	FiscalDevice = CashRegisterCashRegisterFiscalDevice.FiscalDevice;
	CashRegister             = CashRegisterCashRegisterFiscalDevice.CashRegister;
	
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	CashRegisterShift.Number AS CashShiftNumber,
	|	CashRegisterShift.Ref AS CashRegisterShift,
	|	CashRegisterShift.Status AS CashRegisterShiftStatus,
	|	CashRegisterShift.PeriodEndTransactionsStatus AS PeriodEndTransactionsStatus,
	|	CashRegisterShift.Organization AS Organization,
	|	CashRegisterShift.CashRegister AS CashRegister,
	|	CashRegisterShift.FiscalDevice AS FiscalDevice,
	|	CASE
	|		WHEN CashRegisterShift.Status = VALUE(Enum.CashRegisterShiftStatuses.IsOpen)
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ShiftIsOpened,
	|	CASE
	|		WHEN CashRegisterShift.Status = VALUE(Enum.CashRegisterShiftStatuses.IsOpen)
	|			THEN CashRegisterShift.CashRegisterShiftStart
	|		ELSE CashRegisterShift.CashRegisterShiftEnd
	|	END AS StatusChangeDate
	|FROM
	|	Document.CashRegisterShift AS CashRegisterShift
	|WHERE
	|	CashRegisterShift.Posted
	|	AND (CashRegisterShift.CashRegister = &CashRegister
	|				AND &CashRegister <> UNDEFINED
	|			OR CashRegisterShift.FiscalDevice = &FiscalDevice
	|				AND &FiscalDevice <> UNDEFINED)
	|	AND CashRegisterShift.CashRegisterShiftStart <= &DateTime
	|
	|ORDER BY
	|	StatusChangeDate DESC";
	
	Query.SetParameter("CashRegister",             CashRegister);
	Query.SetParameter("FiscalDevice", FiscalDevice);
	
	Query.SetParameter("DateTime",            DateTime);
	
	Result = Query.Execute();
	Selection = Result.Select();
	
	AttributesStructure1 = New Structure;
	AttributesStructure1.Insert("CashShiftNumber");
	AttributesStructure1.Insert("CashRegisterShift");
	AttributesStructure1.Insert("CashRegisterShiftStatus");
	AttributesStructure1.Insert("PeriodEndTransactionsStatus");
	AttributesStructure1.Insert("Organization");
	AttributesStructure1.Insert("CashRegister");
	AttributesStructure1.Insert("FiscalDevice");
	AttributesStructure1.Insert("ShiftIsOpened", False);
	AttributesStructure1.Insert("StatusChangeDate");
	
	If Selection.Next() Then
		
		FillPropertyValues(AttributesStructure1, Selection);
		
	EndIf;
		
	Return AttributesStructure1;
EndFunction


Function GetLinkById(XDTOData, FullNameOfObjectManager)
	// The function returns a reference to the object found by the identifier and name of the metadata object,
	// otherwise it returns Undefined.
	//
	// The full name of the object manager is a string
	
	If XDTOData.Property("Ref") And ValueIsFilled(XDTOData.Ref) Then
	
		ObjectManager = Common.ObjectManagerByFullName(FullNameOfObjectManager);
		
		ObjectReference = ObjectManager.GetRef(New UUID(XDTOData.Ref.Value));
		If ValueIsFilled(ObjectReference) And Common.RefExists(ObjectReference) Then
			Return ObjectReference;	
		EndIf;
	EndIf;
	
	Return Undefined;
EndFunction
