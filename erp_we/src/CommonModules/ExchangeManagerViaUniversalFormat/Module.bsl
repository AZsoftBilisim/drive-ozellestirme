Function MagneticStripeCardTemplate(TemplateParameters, CreateElement)
	If TypeOf(TemplateParameters) = Type("Structure") Then
		TemplateStructure_ = New Structure("Track1, Track2, Track3");
		TrackStructure = New Structure("TrackAvailability, Prefix, Suffix, CodeLength, BlockSeparator, TrackFields");
		TrackFieldStructure = New Structure("Field, BlockNumber, NumberOfFirstCharacter, FieldLength");
		For Each KeyAndValue In TemplateStructure_ Do
			If TemplateParameters.Property(KeyAndValue.Key)
				And TypeOf(TemplateParameters[KeyAndValue.Key]) = Type("Structure") Then // TRACKN
				For Each KeyAndValue1 In TrackStructure Do
					If TemplateParameters[KeyAndValue.Key].Property(KeyAndValue1.Key) Then
						If KeyAndValue1.Key = "TrackFields" Then
							If TypeOf(TemplateParameters[KeyAndValue.Key][KeyAndValue1.Key]) = Type("Array") Then
								For Each TrackField In TemplateParameters[KeyAndValue.Key][KeyAndValue1.Key] Do
									If TypeOf(TrackField) = Type("Structure") Then
										For Each KeyAndValue2 In TrackFieldStructure Do
											If Not TrackField.Property(KeyAndValue2.Key) Then
												Return Undefined;
											EndIf;
										EndDo;
									Else
										Return Undefined;
									EndIf;
								EndDo;
							Else
								Return Undefined;
							EndIf;
						EndIf;
					Else
						Return Undefined;
					EndIf;
				EndDo;
			Else
				Return Undefined;
			EndIf;
		EndDo;
		Query = New Query(
			"SELECT
			|	MagneticStripeCardTemplates.Ref
			|FROM
			|	Catalog.MagneticStripeCardTemplates AS MagneticStripeCardTemplates
			|WHERE
			|	MagneticStripeCardTemplates.TrackAvailability1 = &TrackAvailability1
			|	AND MagneticStripeCardTemplates.TrackAvailability2 = &TrackAvailability2
			|	AND MagneticStripeCardTemplates.TrackAvailability3 = &TrackAvailability3
			|	AND MagneticStripeCardTemplates.CodeLength1 = &CodeLength1
			|	AND MagneticStripeCardTemplates.CodeLength2 = &CodeLength2
			|	AND MagneticStripeCardTemplates.CodeLength3 = &CodeLength3
			|	AND MagneticStripeCardTemplates.Prefix1 LIKE &Prefix1
			|	AND MagneticStripeCardTemplates.Prefix2 LIKE &Prefix2
			|	AND MagneticStripeCardTemplates.Prefix3 LIKE &Prefix3
			|	AND MagneticStripeCardTemplates.Suffix1 LIKE &Suffix1
			|	AND MagneticStripeCardTemplates.Suffix2 LIKE &Suffix2
			|	AND MagneticStripeCardTemplates.Suffix3 LIKE &Suffix3
			|	AND MagneticStripeCardTemplates.BlockSeparator1 = &BlockSeparator1
			|	AND MagneticStripeCardTemplates.BlockSeparator2 = &BlockSeparator2
			|	AND MagneticStripeCardTemplates.BlockSeparator3 = &BlockSeparator3");
		Query.SetParameter("CodeLength1", Number(TemplateParameters.Track1.CodeLength));
		Query.SetParameter("CodeLength2", Number(TemplateParameters.Track2.CodeLength));
		Query.SetParameter("CodeLength3", Number(TemplateParameters.Track3.CodeLength));
		Query.SetParameter("TrackAvailability1", TemplateParameters.Track1.TrackAvailability);
		Query.SetParameter("TrackAvailability2", TemplateParameters.Track2.TrackAvailability);
		Query.SetParameter("TrackAvailability3", TemplateParameters.Track3.TrackAvailability);
		Query.SetParameter("Prefix1", TemplateParameters.Track1.Prefix + "%");
		Query.SetParameter("Prefix2", TemplateParameters.Track2.Prefix + "%");
		Query.SetParameter("Prefix3", TemplateParameters.Track3.Prefix + "%");
		Query.SetParameter("Suffix1", TemplateParameters.Track1.Suffix + "%");
		Query.SetParameter("Suffix2", TemplateParameters.Track2.Suffix + "%");
		Query.SetParameter("Suffix3", TemplateParameters.Track3.Suffix + "%");
		Query.SetParameter("BlockSeparator1", TemplateParameters.Track1.BlockSeparator);
		Query.SetParameter("BlockSeparator2", TemplateParameters.Track2.BlockSeparator);
		Query.SetParameter("BlockSeparator3", TemplateParameters.Track3.BlockSeparator);
		Selection = Query.Execute().Select();
		
		TemplateList = New Array;
		If Selection.Next() Then
			Return Selection.Ref;
		ElsIf CreateElement Then
			MapTemplate = Catalogs.MagneticStripeCardTemplates.CreateItem();
			FillPropertyValues(MapTemplate, Query.Parameters);
			For Cnt = 1 To 3 Do
				TrackFields = TemplateParameters["Track" + Cnt]["TrackFields"];
				For Each TrackField In TrackFields Do
					TSTrackFields = MapTemplate["TrackFields" + Cnt]; // TabularSection
					FieldString = TSTrackFields.Add();
					FillPropertyValues(FieldString, TrackField);
				EndDo;
			EndDo;
			InfobaseUpdate.WriteData(MapTemplate);
			Return MapTemplate.Ref;
		EndIf;
	EndIf;
	
	Return Undefined;
EndFunction
Procedure AcquiringTerminalsBeforeRecordingReceivedData(ReceivedData, IBData, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If Not ValueIsFilled(DataToWriteToIB.Owner) Then
		
		ObjectAgreement = Catalogs.AcquiringContracts.CreateItem();
		ObjectAgreement.DataExchange.Load = True;
		
		If ReceivedData.AdditionalProperties.Property("CompanyBankAccount") Then
			
			BankAccount = ReceivedData.AdditionalProperties.CompanyBankAccount;
			ObjectAgreement.Organization             = BankAccount.Owner;
			ObjectAgreement.Department           = BankAccount.Department;
			ObjectAgreement.LineOfBusiness = BankAccount.LineOfBusiness;
			ObjectAgreement.BankAccount          = BankAccount.Ref;
		EndIf;
		
		If ReceivedData.AdditionalProperties.Property("Acquirer") Then	
			
			Acquirer = ReceivedData.AdditionalProperties.Acquirer;  // CatalogRef.Counterparties  
			ObjectAgreement.Counterparty = Acquirer.Ref;
			ObjectAgreement.Partner    = Acquirer.Partner;
			
		EndIf;
	
		ObjectAgreement.POSTerminalsAreUsed = True;
		ObjectAgreement.DetailedTransactionReconciliation          = True;
		ObjectAgreement.PaymentPeriod              = 1;
		ObjectAgreement.CommissionPostingMethod            = Enums.MethodsOfAcquiringCommissionRecording.InReport;
		ObjectAgreement.Status                             = Enums.CounterpartyContractStatuses.Valid;
		ObjectAgreement.Approved                         = True;
		
		If ValueIsFilled(DataToWriteToIB.Description) Then
			ObjectAgreement.Description = DataToWriteToIB.Description;
		Else
			ObjectAgreement.Description = NStr("vi = 'Đã tạo tự động';
												|ru = 'Создан автоматически';
												|en = 'Created automatically'; fa = 'Created automatically';
												|it = 'Creato automaticamente';
												|pl = 'Utworzony automatycznie';
												|tr = 'Otomatik oluşturuldu'");
		EndIf;
		If ValueIsFilled(ObjectAgreement.Organization) And ValueIsFilled(ObjectAgreement.Counterparty) Then
			ObjectAgreement.Write();
			DataToWriteToIB.Owner = ObjectAgreement.Ref;
		EndIf;
	EndIf;
