Procedure DeferredProcessing_SaleOfGoodsServices(Object, ExchangeComponents, ObjectIsModified)
	For Each String In Object.Goods Do
		If Not ValueIsFilled(String.Products) Then
			String.Products = DefaultElement(ExchangeComponents, "ProductsService1_");
		EndIf;
	EndDo;
	
	If Not ValueIsFilled(Object.Partner) Then
		Object.Partner = CashServer.GetCounterpartyPartner(Object.Counterparty);
	EndIf;
	
	If Not ValueIsFilled(Object.Partner)
		And Not GetFunctionalOption("UsePartnersAsCounterparties") Then
		
		CounterpartyLegEntInd = Common.ObjectAttributeValue(Object.Counterparty, "CompanyIndividual");
		
		Partner = Catalogs.Partners.UnknownPartner;
		
		If CounterpartyLegEntInd = Enums.CompanyIndividual.Individual Then
			Partner = Catalogs.Partners.RetailCustomer;
		EndIf;
		
		Object.Partner = Partner;
		
	EndIf;
	
	SalesViaCommissionAgent = SalesViaCommissionAgent(Object.BusinessOperation);
	
	If SalesViaCommissionAgent Then
		
		If Not ValueIsFilled(Object.CustomerPartner) Then
			Object.CustomerPartner = CashServer.GetCounterpartyPartner(Object.CustomerCounterparty);
		EndIf;
		
		If Not (ValueIsFilled(Object.CustomerContract) And Common.RefExists(Object.CustomerContract)) Then
			Object.CustomerContract = Undefined;  
		EndIf; 
		
	EndIf; 
	
	FillingInAgreementWithClientInHeaderOfDocument(Object);
	AgreementIsFilled = (GetFunctionalOption("ToUseTermsOfSales") And ValueIsFilled(Object.Terms));
	If AgreementIsFilled Then
	    SalesTermsAndConditions = SalesServer.GetTermsAndConditionsOfSale(Object.Terms, True, True);
	    If SalesTermsAndConditions.AgreementStatus <> Enums.StatusesOfTermsOfSales.Closed Then
	        Object.ReusablePackagesReturnDate = ReusablePackageServer.CalculateReturnDateOfMultiTurnContainer(
	            Object,
	            SalesTermsAndConditions.ReusablePackageReturnCycleLength,
	            SalesTermsAndConditions.CalculatePackageReturnDateAccordingToCalendar,
	            SalesTermsAndConditions.ScheduleOfPackageReturn); 
	    EndIf;
	Else
	    Object.ReusablePackagesReturnDate = Date(1,1,1);
	EndIf;
	
	FillInDeliveryParameters(Object);
	FillInDefaultTaxType(Object);
	
	StructureOfActions = New Structure;
	StructureOfActions.Insert("FillInHSCode", Object.VATTaxation);
	BatchProcessingOfTablePartServer.TreatTS(Object.Goods, StructureOfActions, Undefined);
	
	FillInCalculationProcedure(Object, Object.Contract, Object.Terms);
	If Object.Contract = Undefined Or Not Common.RefExists(Object.Contract) Then
		Object.Contract = Catalogs.CounterpartyContracts.EmptyRef();
	EndIf;
	PaymentStepsServer.CheckAndFillInPaymentScheduleStages(Object);
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	If Object.BusinessOperation <> Enums.BusinessTransactions.TransferToCommissionAgent
		And Not SalesViaCommissionAgent
		And GetFunctionalOption("UseDiscountsMarkupsInSales")
		And Not Object.DiscountsAreCalculated Then
		
		Object.DiscountsAreCalculated = True;
	EndIf;
EndProcedure


