EndProcedure
Procedure DPR_Document_CashVoucher_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	
	ARAPType = "";
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
	
		UsageOCR.Document_ACWInternalTransfer_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
	
		UsageOCR.Document_RCOCurrencyConversion_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashDepositToBankAccount Then
	
		UsageOCR.Document_RCOToBankAccount_Sending = True;
	
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			UsageOCR.Document_PBDSCashContributionFromStructure_Sending = True;
		EndIf;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashCollectionToBank Then
	
		UsageOCR.Document_RCOToBankAccount_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentViaCashAccount
		Or IBData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentToEmployee
		Or IBData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentByDistributor Then
	
		UsageOCR.Document_RCOSalaryPayment_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder Then
	
		UsageOCR.Document_RCOSettlementsWithEmployees_Sending = True;
		ARAPType = "Subreport";
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee Then
		
		UsageOCR.Document_RCOSettlementsWithEmployees_Sending = True;
		ARAPType = "Loans_";
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue
		Or IBData.BusinessOperation = Enums.BusinessTransactions.OtherExpenses Then
		// Household. The operation Other expenses will no longer be used. Left for a transitional period.
		// Other expenses are reflected by the type of operation of other monetary funds.
		UsageOCR.Document_RKOOtherIssue_Sending = True;
	
		TypeOfOperationOther = "OtherWriteOffs";
		// If the expense item is filled in, then it is a different expense.
		For Each TSRow In IBData.ARAPDetails Do
			If ValueIsFilled(TSRow.ExpenseItem)
				And TypeOf(TSRow.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
				UsageOCR.Document_RCOOtherExpense_Dispatch = True;
				UsageOCR.Document_RKOOtherIssue_Sending = False;
				Break;
			EndIf;
		EndDo;
	
	ElsIf  IBData.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany Then
	
		UsageOCR.Document_RCOSettlementsWithCounterparties_Sending = True;
		ARAPType = "WithCustomer";
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToVendor
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
	
		UsageOCR.Document_RCOSettlementsWithCounterparties_Sending = True;
		ARAPType = "WithVendor";
	
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.15")
		And ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation) Then
		UsageOCR.Document_RCOSettlementsWithCounterparties_Sending = True;
		ARAPType = "LoansAndBorrowings";
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15")
		And ThisIsBusinessTransactionCreditSettlements(IBData.BusinessOperation) Then 
		UsageOCR.Document_RCOSettlementsWithCounterparties_Sending = True;
		ARAPType = "CounterpartyCredit";
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15")
		And ThisIsBusinessTransactionLoanSettlements(IBData.BusinessOperation) Then 
		UsageOCR.Document_RCOSettlementsWithCounterparties_Sending = True;
		ARAPType = "LoanToCounterparty";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashIssueToCashRegister Then
		UsageOCR.Document_RCOIssuanceToCashRegister_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToLessor Then
	
		UsageOCR.Document_RCOSettlementsWithCounterparties_Sending = True;
		ARAPType = "Other";
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashIssueToAnotherCashAccount Then
		UsageOCR.Document_RCODeliveryToAnotherCashier_Sending = True;
	EndIf;
	
	If ARAPType <> "" Then
	
		HeaderData_ = New Structure();
		HeaderData_.Insert("ARAPType", ARAPType);
		IBData.AdditionalProperties.Insert("HeaderData_", HeaderData_);
	
	EndIf;
EndProcedure

