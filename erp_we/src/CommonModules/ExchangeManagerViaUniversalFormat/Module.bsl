		CounterpartyLedelets = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(IBData.Owner); 
		
		If Not ValueIsFilled(CounterpartyLedelets) Then
			
			UsageOCR.Clear();
			
			WarningTemplate = NStr("vi = 'Không thể kết xuất danh mục %1,
			|bởi vì không thể nhận đối tác đối với bạn hàng đã chỉ ra.';
			|ru = 'Справочник %1 не может быть выгружен,
			|т.к. не удалось получить контрагента для указанного партнера.';
			|en = 'The %1 catalog cannot be exported
			|as it was impossible to get a counterparty for the specified partner.'; fa = 'The %1 catalog cannot be exported
			|as it was impossible to get a counterparty for the specified partner.';
			|it = 'Справочник %1 не может быть выгружен,
			|т.к. не удалось получить контрагента для указанного партнера.';
			|pl = 'Katalog %1 nie może być wyeksportowany,
			|ponieważ nie udało się otrzymać kontrahenta dla podanego partnera.';
			|tr = '%1 kataloğu yüklenemez,
			|çünkü belirtilen iş ortağı için cari hesap alınamadı.'");
			
			WarningText = StrTemplate(WarningTemplate, IBData.Ref);
			SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
			
		EndIf;  
		
	Else
	
		UsageOCR.Clear();
		
	EndIf;
