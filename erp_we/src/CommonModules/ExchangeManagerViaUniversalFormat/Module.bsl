Function GetTextOfCCDRequest(ExchangeComponents, SourceName_)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.16") Then
			QueryText = "&SourceName_.CCDNumber AS CCDNumber,
			        |	&SourceName_.CCDNumber.AmountByProductBatchID AS AmountOfProductBatchID,
					|	&SourceName_.CCDNumber.CCDNumberType = VALUE(Enum.CCDNumberTypes.ProductBatchIDNumber) AS IsRNPT,
					|	CASE WHEN VALUETYPE(&SourceName_.CCDNumber) = TYPE(Catalog.CCDNumbers) THEN
					|		&SourceName_.CCDNumber.OriginCountry 
					|	ELSE """" END AS OriginCountry";
	
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			QueryText = "&SourceName_.CCDNumber AS CCDNumber,
					|	&SourceName_.CCDNumber.CCDNumberType = VALUE(Enum.CCDNumberTypes.ProductBatchIDNumber) AS IsRNPT,
					|	CASE WHEN VALUETYPE(&SourceName_.CCDNumber) = TYPE(Catalog.CCDNumbers) THEN
					|		&SourceName_.CCDNumber.OriginCountry 
					|	ELSE """" END AS OriginCountry";
	Else
		QueryText = "&SourceName_.CCDNumber.Code AS CCDNumber,
					|	&SourceName_.CCDNumber.OriginCountry AS OriginCountry";
	EndIf;
	
	QueryText = StrReplace(QueryText, "&SourceName_", SourceName_);
	
	Return QueryText;
EndFunction
Function GetTextOfRNPTRequest(ExchangeComponents, SourceName_, NameOfProductSource = "")
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		QueryText = "&NameOfProductSource.Products.FEACNCode.TracedGoods AS TracedGoods,
						|	&SourceName_.QuantityByGBRN AS NumberOfRNPT,
