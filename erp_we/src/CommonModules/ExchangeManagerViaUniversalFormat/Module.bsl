Procedure OCR_Document_PaymentCardTransaction_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	Partner = CashServer.GetCounterpartyPartner(ReceivedData.Counterparty, ReceivedData.BusinessOperation);
	
	// Breakdown of payment
	ArrayOfPaymentDecryptionStrings = New Array;
	FillingRules = New Map;
	FillingRules.Insert("Sum", "Sum");
	FillingRules.Insert("AmountARAP", "AmountARAP");
	FillingRules.Insert("CashFlowItem", "CFItem");
	FillingRules.Insert("VATRate", "VATRate");
	FillingRules.Insert("VATAmount", "VATAmount");
	FillingRules.Insert("ExchangeRateNumeratorOfMutualSettlements", "TransactionRate");
	FillingRules.Insert("TheExchangeRateIsTheDenominatorOfMutualSettlements", "Multiplier_");
	FillingRules.Insert("RowID", "RowID");
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") 
	And XDTOData.Property("AcquirerSContract") Then
		Instruction = New Structure;
		Instruction.Insert("Value", XDTOData.AcquirerSContract);
		Instruction.Insert("OCRName", "Catalog_AcquiringContracts_Receive");
		ReceivedData.AdditionalProperties.Insert("AcquiringContract", Instruction);
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") 
		And XDTOData.Property("FPSPaymentID") Then
		ReceivedData.AdditionalProperties.Insert("FPSPaymentID", XDTOData.FPSPaymentID);
	EndIf;
	
	AvailableSettlementColumns = AvailableColumnsForFillingInSettlementData(XDTOData.ARAPDetails);
	
	For Each XDTORow In XDTOData.ARAPDetails Do
		StringDataStructure = New Structure;
		FillInRowDataStructure(FillingRules, XDTORow, StringDataStructure);
		AddCurrencyToPaymentDecryption(StringDataStructure, XDTORow);
		StringDataStructure.Insert("Partner", Partner);
		
		If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
		    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
		EndIf;
		
		AddSettlementDataToPaymentTranscript(ExchangeComponents, XDTORow, StringDataStructure, AvailableSettlementColumns);
						
		ArrayOfPaymentDecryptionStrings.Add(StringDataStructure);
	EndDo;
	
	If ArrayOfPaymentDecryptionStrings.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfPaymentDecryptionStrings);
	EndIf;
EndProcedure
Procedure OCR_Document_PaymentCardTransaction_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	FillInAdditionalInformationSecurityDataPropertiesFromReceivedData(IBData, ReceivedData);
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	DefaultPOSTerminal = Catalogs.POSTerminals.DefaultPOSTerminal(DataToWriteToIB.Organization);
	If ValueIsFilled(DefaultPOSTerminal) Then
		DataToWriteToIB.POSTerminal = DefaultPOSTerminal;
	EndIf;
	
	If ValueIsFilled(DataToWriteToIB.POSTerminal) Then
		DataToWriteToIB.AcquiringContract = Common.ObjectAttributeValue(
											DataToWriteToIB.POSTerminal, "Owner");
	EndIf;
	
	DocumentType = "DocumentObject.PaymentCardTransaction";
	CheckResultOfDocumentDataExchange(DataToWriteToIB, ExchangeComponents.CorrespondentNode, DocumentType);
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
EndProcedure

