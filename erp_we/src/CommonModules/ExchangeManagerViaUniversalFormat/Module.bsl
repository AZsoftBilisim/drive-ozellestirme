	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Catalog_CounterpartyContracts_Receive";
	ProcessingRule.FilterObjectFormat     = "Справочник.Договоры"; //@NON-NLS-1
