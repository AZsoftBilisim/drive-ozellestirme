Procedure SUB_Document_PBDS_Sending_DuringProcessing(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	If ValueIsFilled(IBData.Contract) And (IBData.Contract.ContractType = PredefinedValue("Enum.ContractTypes.TransferToRental")
		 Or IBData.Contract.ContractType = PredefinedValue("Enum.ContractTypes.Sublease")) Then
		 ClearUsageOCR(UsageOCR);
		 Return
	 EndIf; 
	//When using the list of employees in the SBDS,
	//when issuing a sub-report, we use the logic of other receipts for the receipt of funds from the collection of a settlement account
	DocBasis = IBData.WithdrawalDocument;
	Use_PBDSOther = False;
	If ValueIsFilled(DocBasis) 
				And TypeOf(DocBasis) = Type("DocumentRef.BankAccountIssue") 
				And DocBasis.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder 
				And DocBasis.PersonsList = True Then
					//Use is short.Document_PD_PRocho_Application_Sending = True;
					Use_PBDSOther = True;
	EndIf;
	 
	PBDSTaxReturnIsSupported = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19");
	  
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount Then
		UsageOCR.Document_PBDSPaymentInCash_Sending = True;
		Return;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.ReturnOfPayrollPaymentByPayrollCardProgram 
		And Not Use_PBDSOther Then
		If ThisIsUT() Then
			ClearUsageOCR(UsageOCR);
		EndIf;
		
		Return;
			
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromAnotherAccount
		Or IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
		UsageOCR.Document_PBDSTransferToAnotherAccount_Sending = True;
		Return;
	EndIf;
		
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	CorAccountsFromArticlesAreUsed = ?(ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed = Undefined, False, ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed);	
	Query = New Query;
	Query.Text =
	"SELECT
	|	ISNULL(Header.CashFlowItem.OffsettingAccount, """") AS OffsettingAccount,
	|	ISNULL(Header.WithdrawalDocument.Date, Header.Date) AS SBDS_DATE,
	|	Header.BankAccount.CashCurrency AS BankAccountCurrency,
	|	Header.Currency AS Currency,
	|	Header.CurrencyOfConversion
	|INTO Header
	|FROM
	|	Document.BankAccountReceiptNote AS Header
	|WHERE
	|	Header.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	DocumentData.IncomeItem.OffsettingAccount AS OffsettingAccount,
	|	DocumentData.IncomeItem AS IncomeItem
	|INTO LineWithIncomeItemWithCorAccount
	|FROM
	|	Document.BankAccountReceiptNote.ARAPDetails AS DocumentData
	|WHERE
	|	DocumentData.Ref = &Ref
	|	AND (DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherIncome)
	|		OR DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherCashReceipt))
	|	AND DocumentData.IncomeItem.OffsettingAccount IS NOT null
	|	AND DocumentData.IncomeItem.OffsettingAccount <> """"
	|
	|ORDER BY
	|	DocumentData.LineNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	FirstLineOfDecryption.LoanDepositContract.CashFlowItemOfFeePayment AS FirstRowRP_LoanAgreementDeposit_SDDSCommission,
	|	FirstLineOfDecryption.LoanDepositContract.CashFlowItemOfInterestPayment AS FirstRowRP_DepositLoanAgreement_SDDSInterest,
	|	FirstLineOfDecryption.CashFlowItem AS FirstRowOfRP_SDDS
	|INTO FirstLineOfDecryption
	|FROM
	|	Document.BankAccountReceiptNote.ARAPDetails AS FirstLineOfDecryption
	|WHERE
	|	FirstLineOfDecryption.Ref = &Ref
	|
	|ORDER BY
	|	FirstLineOfDecryption.LineNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ISNULL(LineWithIncomeItemWithCorAccount.OffsettingAccount, Header.OffsettingAccount) AS OffsettingAccount,
	|	ISNULL(LineWithIncomeItemWithCorAccount.IncomeItem, UNDEFINED) AS IncomeItem,
	|	Header.SBDS_DATE,
	|	Header.BankAccountCurrency,
	|	ISNULL(FirstLineOfDecryption.FirstRowRP_LoanAgreementDeposit_SDDSCommission, UNDEFINED) AS FirstRowRP_LoanAgreementDeposit_SDDSCommission,
	|	ISNULL(FirstLineOfDecryption.FirstRowRP_DepositLoanAgreement_SDDSInterest, UNDEFINED) AS FirstRowRP_DepositLoanAgreement_SDDSInterest,
	|	ISNULL(FirstLineOfDecryption.FirstRowOfRP_SDDS, UNDEFINED) AS FirstRowOfRP_SDDS,
	|	ISNULL(ExchangeRates.CourseNumerator, 1) AS Currency_ExchangeRate,
	|	ISNULL(ExchangeRates.CourseDenominator, 1) AS Currency_Multiplicity
	|FROM
	|	Header AS Header
	|		LEFT JOIN LineWithIncomeItemWithCorAccount AS LineWithIncomeItemWithCorAccount
	|		ON (TRUE)
	|		LEFT JOIN FirstLineOfDecryption
	|		ON (TRUE)
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS ExchangeRates
	|		ON Header.Currency = ExchangeRates.Currency
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ARAPDetails.CashFlowItem                       AS CFItem,
	|	ARAPDetails.Sum                                               AS Sum,
	|	ARAPDetails.VATAmount                                            AS VATAmount,
	|	ARAPDetails.VATRate                                           AS VATRate,
	|	ARAPDetails.AmountARAP                                 AS AmountARAP,
	|	ARAPDetails.ARAPObject.Object                               AS OrderDocument,
	|	ARAPDetails.PaymentPurpose                                    AS PaymentPurpose,
	|	ARAPDetails.Partner                                             AS Partner,
	|	CAST(ARAPDetails.ARAPObject.Object AS Catalog.CounterpartyContracts) AS Contract,
	|	ARAPDetails.LoanDepositContract 							   AS LoanDepositContract,
	|	ARAPDetails.LeaseContracts									   AS LeaseContracts,
	|	ISNULL(ExchangeRates.CourseNumerator, 1)                                  AS TransactionRate,
	|	ISNULL(ExchangeRates.CourseDenominator, 1)                                AS Multiplier_,
	|	ARAPDetails.ARAPCurrency                                AS ARAPCurrency,
	|	CASE
	|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
	|			OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.LoanToEmployee)
	|			THEN CASE
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|						THEN ""ShortTermLoans_""
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|						THEN ""LongTermLoans_""
	|				END
	|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit)
	|			THEN CASE
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|								THEN ""ShortTermLoans""
	|						END
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|								THEN ""LongTermLoans""
	|						END
	|				END
	|		ELSE NULL
	|	END AS TypeOfCalculationsAdvanced,
	|	CASE 
	|		WHEN &ThisIsWE OR (ARAPDetails.CashFlowItem.OffsettingAccount <> """" AND &CorAccountsFromArticlesAreUsed) 
	|			THEN ARAPDetails.CashFlowItem.OffsettingAccount
	|		ELSE CASE
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.LoanToEmployee)
	|					THEN ""58.03""
	|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan))
	|					AND ARAPDetails.CashFlowItem <> ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|					THEN ""58.03""
	|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit))
	|					AND ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
	|											THEN ""66.03""
	|										ELSE ""66.23""
	|									END
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
	|											THEN ""67.03""
	|										ELSE ""67.23""
	|									END
	|						END
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
	|											THEN ""66.01""
	|										ELSE ""66.21""
	|									END
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
	|											THEN ""67.01""
	|										ELSE ""67.21""
	|									END
	|					END
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.DepositWithoutInterestCapitalization)
	|					OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.DepositWithInterestCapitalization)
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
	|								THEN ""55.03""
	|							ELSE ""55.23""
	|						END
	|		END
	|	END AS AccountForSettlementsWithCounterparty,
	|	ARAPDetails.RowID AS RowID,
	|	ARAPDetails.LoanAndDepositAmountType AS LoanAndDepositAmountType
	|FROM
	|	Document.BankAccountReceiptNote.ARAPDetails AS ARAPDetails
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS ExchangeRates
	|		ON ARAPDetails.ARAPCurrency = ExchangeRates.Currency
	|WHERE
	|	ARAPDetails.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	DocumentData.IncomeItem AS IncomeItem
	|FROM
	|	Document.BankAccountReceiptNote.ARAPDetails AS DocumentData
	|WHERE
	|	DocumentData.Ref = &Ref
	|	AND (DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherIncome)
	|		OR DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherCashReceipt))
	|	AND DocumentData.IncomeItem REFS ChartOfCharacteristicTypes.IncomeItems
	|   AND DocumentData.IncomeItem <> VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
	|ORDER BY
	|	DocumentData.LineNumber
	|";
	
	Query.SetParameter("Ref", IBData.Ref); 
	Query.SetParameter("ThisIsWE", Not GetFunctionalOption("LocalizationRFService"));
	Query.SetParameter("CorAccountsFromArticlesAreUsed", CorAccountsFromArticlesAreUsed);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("ComplAccountingCurrency", CurrencyOfComplianceAccounting);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	AdditionalData = Query.ExecuteBatch();
	
	HeaderData_ = AdditionalData[3].Unload()[0];
	IBData.AdditionalProperties.Insert("HeaderData_", HeaderData_);
	IBData.AdditionalProperties.Insert("ExtendedPaymentDecryption", AdditionalData[4]);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		
		If IBData.CurrencyOfConversion = CurrencyOfComplianceAccounting
			Or IBData.Currency = CurrencyOfComplianceAccounting Then
			
			UsageOCR.Document_PBDSCurrencyConversion_Sending = True;
			
		ElsIf IBData.Currency <> CurrencyOfComplianceAccounting
			And IBData.CurrencyOfConversion <> CurrencyOfComplianceAccounting Then
			
			UsageOCR.Document_PBDSSettlementsWithCounterparties_Sending = True;
			
		EndIf;
		
	ElsIf ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation) Then
		
		UsageOCR.Document_PBDSSettlementsWithCounterparties_Sending = True;
		
	ElsIf ThisIsBusinessOperationSettlementOfDeposits(IBData.BusinessOperation) Then
		UsageOCR.Document_Document_PBDSReceiptOnDeposit_Open = True; 
	ElsIf ThisIsBusinessTransactionRevaluationOfFinancialInstruments(IBData.BusinessOperation) Then
				
		UsageOCR.Document_PBDSOtherIncome_Sending = True;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromVendor
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromAnotherCompany Then
		
		UsageOCR.Document_PBDSSettlementsWithCounterparties_Sending = True;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherIncome
		Or IBData.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt Then
		
		// Household operation Other income is outdated. Left for a transitional period.
		// Other income is reflected by the type of operation through the availability of monetary funds.
		For Each TSRow In IBData.ARAPDetails Do
			
			// If the income item is filled in, then this is other income.
			If ValueIsFilled(TSRow.IncomeItem)
				And TypeOf(TSRow.IncomeItem) = Type("ChartOfCharacteristicTypesRef.IncomeItems") Then
				
				UsageOCR.Document_PBDSOtherIncome_Sending_ = True;
				Break;
				
			EndIf;
			
		EndDo;
		
		UsageOCR.Document_PBDSOtherIncome_Sending = Not UsageOCR.Document_PBDSOtherIncome_Sending_;
	
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TaxRefund Then
		
		UsageOCR.Document_PBDSTaxReturn_Sending = PBDSTaxReturnIsSupported;
		UsageOCR.Document_PBDSOtherIncome_Sending = Not PBDSTaxReturnIsSupported;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReturnByAdvanceHolder
		Or IBData.BusinessOperation = Enums.BusinessTransactions.LoanRepaymentByEmployee Then
		
		UsageOCR.Document_PBDSSettlementsWithEmployees_Sending = True;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment Then
		
		If PropertyOfExchangeFormat(ExchangeComponents, "Документ.ПБДСПоПлатежнымКартам") Then //@NON-NLS-1
			UsageOCR.Document_PBDSForPaymentCards_Sending = True;
		Else
			UsageOCR.Document_PBDSSettlementsWithCounterparties_Sending = True;
		EndIf;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.UnremittedSalaryReturnToPersonalAccounts 
		Or Use_PBDSOther Then
		
		UsageOCR.Document_PBDSOtherIncome_Sending = True;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromLessor Then
	
			UsageOCR.Document_PBDSSettlementsWithCounterparties_Sending = True;
	
	EndIf;
EndProcedure

