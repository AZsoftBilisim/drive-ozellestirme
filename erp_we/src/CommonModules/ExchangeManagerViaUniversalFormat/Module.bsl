Procedure OCR_Catalog_Counterparties_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents, True);
	
	UploadContactInformation(XDTOData, ReceivedData, Catalogs.ContactInformationKinds.CatalogCounterparties);
	If Not XDTOData.Property("KeyProperties") Then
		Return;
	EndIf;
	KeyProperties = XDTOData.KeyProperties; 
	 
	If KeyProperties.Property("IndividualEntrepreneur")
		And KeyProperties.IndividualEntrepreneur Then 
	
		ReceivedData.LegalEntityIndividual = Enums.LegalEntityIndividual.IndividualEntrepreneur;		
	
	EndIf;                                                                           
	
	RedefineCounterpartySearchFields(ExchangeComponents, XDTOData);
	
	FillingRules = New Map;
	
	FillingRules.Insert("StartDate", "Period");
	FillingRules.Insert("CRTR" ,"CRTR");
	FillingRules.Insert("DescriptionFull", "NameAbbreviated");
	
	UploadHistoryOfBankingDetailsToReceivedData(XDTOData, ReceivedData, FillingRules);
	
	RegistrationNumber = "";
	 
	If KeyProperties.Property("NonResidentRegistrationNumber") Then
		RegistrationNumber = KeyProperties.NonResidentRegistrationNumber;
	ElsIf KeyProperties.Property("RegistrationNumber") Then 
		RegistrationNumber = KeyProperties.RegistrationNumber;
	EndIf;
	
	ReceivedData.RegistrationNumber = RegistrationNumber; 
	CounterpartyData = CounterpartyDataForHistoricalSearchFields(XDTOData);
	If Not CounterpartyData = Undefined Then
		
		OriginalHistoricalData = New Structure;
		For Each Item In CounterpartyData Do
			OriginalHistoricalData.Insert(Item.Key, ReceivedData[Item.Key]);
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("OriginalHistoricalData", OriginalHistoricalData);
		FillPropertyValues(ReceivedData, CounterpartyData);
	EndIf;
EndProcedure
Procedure OCR_Catalog_Counterparties_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	OriginalHistoricalData = Undefined;
	If ReceivedData.AdditionalProperties.Property("OriginalHistoricalData", OriginalHistoricalData) Then
		
		If IBData = Undefined Then
			// We accept data from the exchange.
			For Each DataElement In OriginalHistoricalData Do
				ReceivedData[DataElement.Key] = DataElement.Value;
			EndDo;
		Else
			// Restoring the actual historical values of the cap details from the IB object.
			FillPropertyValues(ReceivedData, OriginalHistoricalData);
		EndIf;
		
	EndIf;
	
	// Updating the "cut of the latest" for historical data (if available).
	If IBData <> Undefined Then
		
		HistoricalData = New Structure; // The key is the name of the TS, the values are the names of the Attributes in the header and the TS
		HistoricalSignificanceData = New Structure;
		HistoricalSignificanceData.Insert("HeaderName", "CRTR");
		HistoricalSignificanceData.Insert("TSName",    "CRTR");
		HistoricalData.Insert("CRTRHistory", HistoricalSignificanceData);
		
		HistoricalSignificanceData = New Structure;
		HistoricalSignificanceData.Insert("HeaderName", "DescriptionFull");
		HistoricalSignificanceData.Insert("TSName",    "NameAbbreviated");
		HistoricalData.Insert("NameHistory", HistoricalSignificanceData);
		
		For Each DataElement In HistoricalData Do
			ReceivedData[DataElement.Key].Load(IBData[DataElement.Key].Unload());
			
			CurrentEntry     = Undefined;
			MeaningIsInHistory = False;
			
			For Each HistoryOfMeaning In ReceivedData[DataElement.Key] Do
				If Not MeaningIsInHistory
					And HistoryOfMeaning[DataElement.Value.TSName] = ReceivedData[DataElement.Value.HeaderName] Then
					MeaningIsInHistory = True;
				EndIf;
				
				If CurrentEntry = Undefined Then
					CurrentEntry = HistoryOfMeaning;
				ElsIf CurrentEntry.Period < HistoryOfMeaning.Period Then
					CurrentEntry = HistoryOfMeaning;
				EndIf;
			EndDo;
			
			If Not CurrentEntry = Undefined
				And Not MeaningIsInHistory Then
				CurrentEntry[DataElement.Value.TSName] = ReceivedData[DataElement.Value.HeaderName];
			EndIf;
			
		EndDo;
		If Not ValueIsFilled(ReceivedData.MainCounterparty) Then
			ReceivedData.MainCounterparty = IBData.MainCounterparty;
		EndIf;
		If Not ValueIsFilled(ReceivedData.RegistrationCountry) Then
			ReceivedData.RegistrationCountry = IBData.RegistrationCountry;
		EndIf;
		If ReceivedData.LegalEntityIndividual = Enums.LegalEntityIndividual.Person
			And IBData.LegalEntityIndividual = Enums.LegalEntityIndividual.IndividualEntrepreneur 
			Or ReceivedData.LegalEntityIndividual = Enums.LegalEntityIndividual.Entity
			And IBData.LegalEntityIndividual = Enums.LegalEntityIndividual.LegalEntityNonResident Then
			
			ReceivedData.LegalEntityIndividual = IBData.LegalEntityIndividual; 
		EndIf; 
	    EndIf;	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
EndProcedure


