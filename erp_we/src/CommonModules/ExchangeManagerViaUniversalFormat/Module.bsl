Procedure DPR_Document_DebtAdjustment_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	UsageOCR.Document_DebtOffset_Receipt = False;
	UsageOCR.Document_DebtCancellation_Receipt = False;
	OperationKind = XDTOData.OperationKind.Value;
	If OperationKind = "CarryingOutNetting" Or OperationKind = "DebtTransfer_"
		Or OperationKind = "RecordOfPaymentThroughTheCommissionAgent" Or OperationKind = "RecordOfRefundThroughTheCommissionAgent" Then	
		UsageOCR.Document_DebtOffset_Receipt = True;
	ElsIf OperationKind = "DebtCancellation" Then
		UsageOCR.Document_DebtCancellation_Receipt = True;
	EndIf;
EndProcedure

