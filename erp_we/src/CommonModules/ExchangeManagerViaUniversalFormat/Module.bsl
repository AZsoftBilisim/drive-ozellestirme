Procedure FillInBankingDetails(DataReceiver, DataSource_, AttributesString, ReFill_ = False)
	Attributes = StringFunctionsClientServer.SplitStringIntoSubstringsArray(AttributesString, ",", True, True);
	For Each Attribute In Attributes Do
		ReceiverValues = New Structure(Attribute);
		FillPropertyValues(ReceiverValues, DataReceiver);
		
		SourceValues = New Structure(Attribute);
		FillPropertyValues(SourceValues, DataSource_);
		
		If ValueIsFilled(SourceValues[Attribute])
			And (Not ValueIsFilled(ReceiverValues[Attribute]) Or ReFill_)  Then
			FillPropertyValues(DataReceiver, SourceValues);
		EndIf;
	EndDo;
EndProcedure
