Procedure DeferredProcessing_ReflectDocumentsInRegistry(ExchangeComponents)
	// It is necessary to reflect the unverified documents in the registry of documents.
	
	// We will generate document registry keys only if objects with the appropriate types were uploaded.
	MetadataObjectsForRegistryKeys = New Map;
		
	TypesOfKeys = Metadata.FindByFullName("Catalog.DocumentRegistryKeys").Attributes.Key.Type.Types();
	
	For Each ImportedObject In ExchangeComponents.ImportedObjects Do
		ObjectMetadata = ImportedObject.ObjectReference.Metadata();
		
		If Not Common.IsCatalog(ObjectMetadata) Then
			Continue;
		EndIf;
		
		RefType =  TypeOf(ImportedObject.ObjectReference);
		
		If TypesOfKeys.Find(RefType) <> Undefined Then
			
			If MetadataObjectsForRegistryKeys[ObjectMetadata] = Undefined Then
				MetadataObjectsForRegistryKeys[ObjectMetadata] = True;
			EndIf;
			
		EndIf;
	EndDo;
	
	If MetadataObjectsForRegistryKeys.Count() > 0 Then
		Catalogs.DocumentRegistryKeys.CreateUpdateRegistryKeys(MetadataObjectsForRegistryKeys);
	EndIf;
	
	DocumentsForDeferredPosting = ExchangeComponents.DocumentsForDeferredPosting.Copy();
	DocumentsForDeferredPosting.GroupBy("DocumentRef");
	
	If DocumentsForDeferredPosting.Count() = 0 Then
		Return;
	EndIf;
	
	// We will get the types of documents for deferred execution contained in the registry of documents.
	DocumentsToBeReflectedInRegistry = New Array;
	For Each TableRow In DocumentsForDeferredPosting Do
	
		If ValueIsFilled(TableRow.DocumentRef)
			And Common.RefExists(TableRow.DocumentRef) 
			And InformationRegisters.DocumentsRegistry.ObjectIsIncludedInRegistryData(TableRow.DocumentRef) Then
		
			DocumentsToBeReflectedInRegistry.Add(TableRow.DocumentRef);
			
		EndIf;
		
	EndDo;
	
	DocumentsToBeReflectedInRegistry = CommonClientServer.CollapseArray(DocumentsToBeReflectedInRegistry);
	
	For Each DocumentReference In DocumentsToBeReflectedInRegistry Do
	
		DataTables = DocumentsPosting.DocumentDataForPosting(DocumentReference, "DocumentsRegistry");
		InformationRegisters.DocumentsRegistry.WriteData(DataTables, DocumentReference, Undefined, False);
	
	EndDo;
EndProcedure
Procedure DeferredProcessing_ReportToPrincipalAndCommissionAgent(Object, ExchangeComponents)
	If Not ValueIsFilled(Object.OperationService) Then
		Object.OperationService = DefaultElement(ExchangeComponents, "ProductsService1_");
	EndIf;
	
	FillingInPartnerInDocumentHeader(Object);
	TheseArePurchases = True;
	If TypeOf(Object.Terms) = Type("CatalogRef.TermsOfSale") Then
		TheseArePurchases = False;
	EndIf;
	If TheseArePurchases Then
		FillingInAgreementWithSupplierInHeaderOfDocument(Object, ExchangeComponents.ConversionParameters_SSLy, Enums.BusinessTransactions.ConsignmentProcurement);
	Else
		FillingInAgreementWithClientInHeaderOfDocument(Object, Enums.BusinessTransactions.TransferToCommissionAgent);
	EndIf;
	FillInDefaultTaxType(Object);
	If Not ValueIsFilled(Object.AmountVATRemuneration) Then
		VATPercentage = VATAccountingERPClientServer.ValueOfVATRate(Object.VATRateOfRemuneration);
		ConsignmentSalesServer.CalculateAmountOfVATRemuneration(Object, VATPercentage);
	EndIf;
	
	If Object.PaymentScheduleSteps.Count() > 0 And Object.Goods.Total("SalesAmount") <> Object.PaymentScheduleSteps.Total("PaymentAmount") Then
		Object.PaymentScheduleSteps.Clear();
	EndIf;
	If Object.PaymentScheduleSteps.Count() = 0 Then
		
		PaymentLine_ = Object.PaymentScheduleSteps.Add();
		PaymentLine_.PaymentDate    = ?(ValueIsFilled(Object.PaymentDate), Object.PaymentDate, Object.Date);
		PaymentLine_.PaymentPercentage = 100;
		PaymentLine_.PaymentAmount   = Object.Goods.Total("SalesAmount");
		
		If TypeOf(Object) = Type("DocumentObject.ConsignmentReportFromCustomer") Then
			PaymentLine_.PaymentOption = Enums.CustomerPaymentControlOptions.CreditPlanned;
		ElsIf TypeOf(Object) = Type("DocumentObject.ConsignmentReportToVendor") Then
			PaymentLine_.PaymentOption = Enums.OptionsForControllingPaymentToSupplier.CreditAfterReceipt;
		EndIf;
	
		Move = (PaymentLine_.PaymentDate - BegOfDay(Object.Date)) / 86400;
		PaymentLine_.Move = ?(Move < 0,0,Move);
	
		PaymentLine_.CalculateFrom = Enums.PaymentDateCalculationOptions.FromShipmentDate;
			
	EndIf;
	
	FillInCalculationProcedure(Object, Object.Contract, Object.Terms); 
	 
	StructureOfRecalculationOfAmount = BatchProcessingOfTablePartClientServer.ParametersForRecalculatingNDSWTCHAmount(Object);
	
	StructureOfActions = New Structure; 
	
	StructureOfActions.Insert("RecalculateVATAmount", StructureOfRecalculationOfAmount);
	StructureOfActions.Insert("RecalculateAmountWithVAT", StructureOfRecalculationOfAmount);
	
	BatchProcessingOfTablePartServer.TreatTS(Object.Goods, StructureOfActions);
EndProcedure
Procedure DeferredProcessing_RetailSalesReport(Object, ExchangeComponents)
