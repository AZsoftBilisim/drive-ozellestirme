Procedure OCR_TransferBetweenOrganizations_MOUTH_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "I";
	DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	XDTOData.KeyProperties.Insert("Number", DocNumber);
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"TransferBetweenCompanies_CI_Send", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"TransferBetweenCompanies_CI_Send", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
		SetRuleForPCRTabPart(ExchangeComponents,
										"TransferBetweenCompanies_CI_Send", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	
	EndIf;
	CurrencyOfComplianceAccounting  = LocalAccountingCurrency(IBData.Organization);
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False);
	
	XDTOData.Insert("ChiefAccountant", Common.ObjectAttributeValue(IBData.ChiefAccountant, "Individual"));
	XDTOData.Insert("Director",     Common.ObjectAttributeValue(IBData.Director, "Individual"));
	
	If IBData.ARAPAccountingViaSeparateCounterparty Then
		CounterpartyRef = IBData.Counterparty;
	Else
		CounterpartyRef = CounterpartyFromOrganization(IBData.CompanyRecipient, ExchangeComponents);
	EndIf;
	XDTOData.Insert("Counterparty", CounterpartyRef);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
		
		XDTOData.Insert("OperationKind",          "SaleToCustomer");
		XDTOData.Insert("ARAPCurrency", IBData.ARAPCurrency);
	
		If IBData.Currency = CurrencyOfComplianceAccounting
			Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
			
			XDTOData.Insert("TransactionRate",      IBData.CourseNumerator);
			XDTOData.Insert("Multiplier_", IBData.CourseDenominator);
			
		Else
			UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
		EndIf;
		
	Else
		
		XDTOData.Insert("OperationKind",          "TransferToCommissionAgent");
		XDTOData.Insert("ARAPCurrency", IBData.Currency);
	
		If IBData.Currency <> CurrencyOfComplianceAccounting Then
			UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
		Else
			
			XDTOData.Insert("TransactionRate",      1);
			XDTOData.Insert("Multiplier_", 1);
			
		EndIf;
	
	EndIf;
	
	#Region Contract
	
	InstructionsContract = Undefined;
	If IBData.ARAPAccountingViaSeparateCounterparty
		And ValueIsFilled(IBData.SalesContract)
		And Common.RefExists(IBData.SalesContract) Then
		
		InstructionsContract = New Structure;
		InstructionsContract.Insert("OCRName",   "Catalog_CounterpartyContracts");
		InstructionsContract.Insert("Value", IBData.SalesContract);
		
	ElsIf ValueIsFilled(IBData.Contract) Then
		
		InstructionsContract = New Structure;
		InstructionsContract.Insert("OCRName",   "Catalog_IntercompanyContracts");
		InstructionsContract.Insert("Value", IBData.Contract);
		
	Else
	
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.Counterparty  = CounterpartyRef;
		If IBData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
			DefaultParameters.TypeOfAgreement              = "WithCustomer";
			DefaultParameters.ARAPCurrency     = IBData.ARAPCurrency;
			DefaultParameters.CalculationsInConventionalUnits = IBData.Currency = CurrencyOfComplianceAccounting And IBData.Currency <> IBData.ARAPCurrency;
		Else
			DefaultParameters.TypeOfAgreement              = "WithConsignee";
			DefaultParameters.ARAPCurrency     = IBData.Currency;
			DefaultParameters.CalculationsInConventionalUnits = False;
		EndIf;
		
		InstructionsContract = ConversionAgreementBasedOnSettlementData(DefaultParameters,
			ExchangeComponents,
			IBData.Contract);
	EndIf;
	XDTOData.Insert("Contract", InstructionsContract);
	
	#EndRegion
	
	// Table parts
	Query = New Query();
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("RegistrationCountry", SettingsValueClientServerCached.CountryOfOrganizationRegistration(IBData.Organization));
	Query.SetParameter("Period", IBData.Date);
	Query.SetParameter("SpecifyCCDNumbers", IBData.SpecifyCCDNumbers);
	
	Query.TempTablesManager = New TempTablesManager;
	Query.Text =  
	"SELECT
	|	""Goods"" AS TabularSectionName,
	|	T.ItemsLocationAttributes.Products AS Products,
	|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	SUM(1) AS RowsCount
	|INTO TTDocumentProducts
	|FROM
	|	Document.CustomerInvoiceIntercompany.Goods AS T
	|WHERE
	|	T.Ref = &Ref
	|
	|GROUP BY
	|	T.ItemsLocationAttributes.Products,
	|	T.ItemsLocationAttributes.Characteristic
	|
	|UNION ALL
	|
	|SELECT
	|	""InventoryKinds"",
	|	T.ItemsLocationAttributes.Products,
	|	T.ItemsLocationAttributes.Characteristic,
	|	SUM(1)
	|FROM
	|	Document.CustomerInvoiceIntercompany.InventoryKinds AS T
	|WHERE
	|	T.Ref = &Ref
	|
	|GROUP BY
	|	T.ItemsLocationAttributes.Products,
	|	T.ItemsLocationAttributes.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	""InventoryKinds"" AS TSInventoryKinds,
	|	T.LineNumber AS LineNumber,
	|	CASE
	|		WHEN Totals.RowsCount > 1
	|			THEN T.LineNumber
	|		ELSE 0
	|	END AS RowCode
	|INTO TTLineCodesForBatchAccountingAnalytics
	|FROM
	|	Document.CustomerInvoiceIntercompany.InventoryKinds AS T
	|		INNER JOIN TTDocumentProducts AS Totals
	|		ON T.ItemsLocationAttributes.Products = Totals.Products
	|			AND T.ItemsLocationAttributes.Characteristic = Totals.Characteristic
	|			AND (Totals.TabularSectionName = ""InventoryKinds"")
	|WHERE
	|	T.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products AS Products,
	|	CASE
	|		WHEN Goods.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|			THEN CASE
	|					WHEN CharacteristicsOfCat.DescriptionFull = """"
	|						THEN CharacteristicsOfCat.Description
	|					ELSE CharacteristicsOfCat.DescriptionFull
	|				END
	|		ELSE """"
	|	END AS CharacteristicName,
	|	CASE
	|		WHEN CatProducts_.DescriptionFull = """"
	|			THEN CatProducts_.Description
	|		ELSE CatProducts_.DescriptionFull
	|	END AS NomenclatureName,
	|	CASE
	|		WHEN Goods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN CAST(""CommissionGoods"" AS STRING(20))
	|		ELSE CAST(""OwnProducts"" AS STRING(20))
	|	END AS InventoryType,
	|	CatProducts_.UnitOfMeasure AS UnitOfMeasure,
	|	Goods.Count AS Count,
	|	Goods.QuantityByGBRN AS QuantityByGBRN,
	|	Goods.Price AS Price,
	|	Goods.Sum AS Sum,
	|	Goods.RowID AS RowID,
	|	Goods.VATRate AS GoodsVATRate,
	|	Goods.Ref.VATTaxation AS TaxationType,
	|	Goods.VATAmount AS VATAmount,
	|	CatProducts_.ItemsType AS ProductsTypeOfProducts,
	|	Goods.LineNumber AS LineNumber,
	|	CatProducts_.AccountingFeature AS AccountingFeature,
	|	CatProducts_.Counterparty AS Counterparty,
	|	CatProducts_.Principal AS Partner,
	|	Goods.Characteristic AS Characteristic,
	|	Goods.Series AS Series,
	|	Goods.Package AS Package,
	|	Goods.NumberOfPackages AS NumberOfPackages,
	|	Goods.CCDNumber AS CCDNumber,
	|	Goods.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	TTDocumentProducts.RowsCount AS RowsCount, 
	|	Goods.VATRate AS VATRate,
	|	Goods.Ref AS Ref
	|INTO GoodsTablePreliminary
	|FROM
	|	Document.CustomerInvoiceIntercompany.Goods AS Goods
	|		LEFT JOIN Catalog.Products AS CatProducts_
	|		ON (CatProducts_.Ref = Goods.Products)
	|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicsOfCat
	|		ON (CharacteristicsOfCat.Ref = Goods.Characteristic)
	|		LEFT JOIN TTDocumentProducts AS TTDocumentProducts
	|		ON (TTDocumentProducts.TabularSectionName = ""Goods"")
	|			AND (TTDocumentProducts.Products = Goods.Products)
	|			AND (TTDocumentProducts.Characteristic = Goods.Characteristic)
	|
	|WHERE
	|	Goods.Ref = &Ref
	|
	|INDEX BY
	|	Products
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsTable.Products AS Products,
	|	GoodsTable.Count AS Count,
	|	GoodsTable.QuantityByGBRN AS QuantityByGBRN,
	|	GoodsTable.Price AS Price,
	|	GoodsTable.Sum AS Sum,
	|	GoodsTable.VATAmount AS VATAmount,
	|	GoodsTable.Characteristic AS Characteristic,
	|	GoodsTable.Series AS Series,
	|	GoodsTable.Package AS Package,
	|	GoodsTable.RowID AS RowID,
	|	GoodsTable.NumberOfPackages AS NumberOfPackages,
	|	GoodsTable.CharacteristicName AS CharacteristicName,
	|	GoodsTable.NomenclatureName AS NomenclatureName,
	|	GoodsTable.InventoryType AS InventoryType,
	|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
	|	GoodsTable.TaxationType AS TaxationType,
	|	GoodsTable.ProductsTypeOfProducts AS ProductsTypeOfProducts,
	|	GoodsTable.LineNumber AS LineNumber,
	|	GoodsTable.AccountingFeature AS AccountingFeature,
	|	GoodsTable.Counterparty AS Counterparty,
	|	GoodsTable.Partner AS Partner, 
	|	GoodsTable.VATRate AS VATRate,
	|	TTLineCodesForBatchAccountingAnalytics.RowCode AS RowCode,
	|	GoodsTable.CCDNumber AS CCDNumber,
	|	GoodsTable.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	GoodsTable.Ref AS Ref,
	|	GoodsTable.RowsCount AS RowsCount,
	|	GoodsTable.GoodsVATRate AS GoodsVATRate
	|INTO TableProductsTotal
	|FROM
	|	GoodsTablePreliminary AS GoodsTable
	|		LEFT JOIN TTLineCodesForBatchAccountingAnalytics AS TTLineCodesForBatchAccountingAnalytics
	|		ON GoodsTable.LineNumber = TTLineCodesForBatchAccountingAnalytics.LineNumber
	|
	|INDEX BY
	|	Products
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	TableProductsTotal.Products AS Products,
	|	MAX(TableProductsTotal.LineNumber) AS LineNumber
	|INTO TableProductsByMaxRow
	|FROM
	|	TableProductsTotal AS TableProductsTotal
	|
	|GROUP BY
	|	TableProductsTotal.Products
	|
	|INDEX BY
	|	Products
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CatProducts.Ref AS Products,
	|	AnalyticsPA.Characteristic AS Characteristic,
	|	CatProducts.Description AS NomenclatureName,
	|	InventoryKinds.Count AS Count,
	|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN CAST(""CommissionGoods"" AS STRING(20))
	|		ELSE CAST(""OwnProducts"" AS STRING(20))
	|	END AS InventoryType,
	|	CASE
	|		WHEN TableProductsTotal.Price IS NULL
	|			THEN CAST(CASE
	|						WHEN InventoryKinds.Ref.PriceIncludesVAT
	|							THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
	|						ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
	|					END AS NUMBER(31, 2))
	|		ELSE TableProductsTotal.Price
	|	END AS Price,
	|	CASE
	|		WHEN InventoryKinds.Ref.PriceIncludesVAT
	|			THEN InventoryKinds.AmountIncludingVAT
	|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
	|	END AS Sum,
	|	InventoryKinds.VATAmount AS VATAmount,
	|	CASE
	|		WHEN &SpecifyCCDNumbers
	|			THEN TableProductsTotal.CCDNumber
	|		ELSE InventoryKinds.CCDNumber
	|	END AS CCDNumber,
	|	AnalyticsPA.Series AS Series,
	|	InventoryKinds.Package AS Package,
	|	InventoryKinds.RowID AS RowID,
	|	InventoryKinds.NumberOfPackages AS NumberOfPackages,
	|	AnalyticsPA.Characteristic.Description AS CharacteristicName,
	|	ISNULL(TableProductsTotal.UnitOfMeasure, AnalyticsPA.Products.UnitOfMeasure) AS UnitOfMeasure,
	|	InventoryKinds.Ref.VATTaxation AS TaxationType,
	|	AnalyticsPA.Products.ItemsType AS ProductsTypeOfProducts,
	|	ISNULL(TableProductsTotal.LineNumber, 0) AS LineNumber,
	|	CatProducts.AccountingFeature AS AccountingFeature,
	|	CatProducts.Counterparty AS Counterparty,
	|	CatProducts.Principal AS Partner,
	|	TableProductsTotal.RowCode AS RowCode,
	|	CatProducts.Ref.VATRate AS GoodsVATRate,
	|   InventoryKinds.VATRate AS VATRate
	|		
	|INTO TypesOfStocksGoods
	|FROM
	|	Document.CustomerInvoiceIntercompany.InventoryKinds AS InventoryKinds
	|		LEFT JOIN TableProductsTotal AS TableProductsTotal
	|		ON (TableProductsTotal.ItemsLocationAttributes = InventoryKinds.ItemsLocationAttributes)
	|			AND (InventoryKinds.Ref = TableProductsTotal.Ref)
	|			AND (CASE
	|				WHEN NOT TableProductsTotal.RowsCount IS NULL
	|						AND TableProductsTotal.RowsCount > 1
	|					THEN TableProductsTotal.RowCode = InventoryKinds.LineNumber
	|				ELSE TRUE
	|			END)
	|		LEFT JOIN Catalog.Products AS CatProducts
	|		ON (CatProducts.Ref = InventoryKinds.ItemsLocationAttributes.Products)
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsPA
	|		ON (InventoryKinds.ItemsLocationAttributes = AnalyticsPA.DimensionKey)
	|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(
	|				&Period,
	|				Country = &RegistrationCountry
	|					OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS ProductsVATRates
	|		ON (CatProducts.Ref = ProductsVATRates.Products)
	|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&Period, Country = &RegistrationCountry) AS BasicVATRates
	|		ON (TRUE)
	|	WHERE
	|	InventoryKinds.Ref = &Ref
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TableProductsTotal.Products,
	|		TableProductsTotal.Characteristic,
	|		TableProductsTotal.NomenclatureName,
	|		TableProductsTotal.Count,
	|		TableProductsTotal.QuantityByGBRN,
	|		TableProductsTotal.InventoryType,
	|		TableProductsTotal.Price,
	|		TableProductsTotal.Sum,
	|		TableProductsTotal.VATAmount,
	|		TableProductsTotal.CCDNumber,
	|		TableProductsTotal.Series,
	|		TableProductsTotal.Package,
	|		TableProductsTotal.RowID,
	|		TableProductsTotal.NumberOfPackages,
	|		TableProductsTotal.CharacteristicName,
	|		TableProductsTotal.UnitOfMeasure,
	|		TableProductsTotal.TaxationType,
	|		TableProductsTotal.ProductsTypeOfProducts,
	|		TableProductsTotal.LineNumber,
	|		TableProductsTotal.AccountingFeature,
	|		TableProductsTotal.Counterparty,
	|		TableProductsTotal.Partner,
	|		TableProductsTotal.RowCode,
	|		TableProductsTotal.VATRate,
	|		TableProductsTotal.GoodsVATRate
	|	FROM
	|		TableProductsTotal AS TableProductsTotal
	|	WHERE
	|		(TableProductsTotal.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.OperationService)
	|					AND (TableProductsTotal.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedBySellerCompany)
	|						OR TableProductsTotal.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.WithoutAccountingFeatures))
	|				OR TableProductsTotal.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5))
	|		
	|INDEX BY
	|	Products
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TypesOfStocksGoods.VATRate AS VATRate,
	|	TypesOfStocksGoods.Products AS Products,
	|	TypesOfStocksGoods.Characteristic AS Characteristic,
	|	TypesOfStocksGoods.NomenclatureName AS NomenclatureName,
	|	TypesOfStocksGoods.Count AS Count,
	|	TypesOfStocksGoods.QuantityByGBRN AS QuantityByGBRN,
	|	TypesOfStocksGoods.InventoryType AS InventoryType,
	|	TypesOfStocksGoods.RowID AS RowID,
	|	TypesOfStocksGoods.Price AS Price,
	|	TypesOfStocksGoods.Sum AS Sum,
	|	TypesOfStocksGoods.VATAmount AS VATAmount,
	|	TypesOfStocksGoods.CCDNumber AS CCDNumber,
	|	TypesOfStocksGoods.Series AS Series,
	|	TypesOfStocksGoods.Package AS Package,
	|	TypesOfStocksGoods.NumberOfPackages AS NumberOfPackages,
	|	TypesOfStocksGoods.CharacteristicName AS CharacteristicName,
	|	TypesOfStocksGoods.UnitOfMeasure AS UnitOfMeasure,
	|	TypesOfStocksGoods.TaxationType AS TaxationType,
	|	TypesOfStocksGoods.ProductsTypeOfProducts AS ProductsTypeOfProducts,
	|	CASE
	|		WHEN TypesOfStocksGoods.LineNumber = 0
	|			THEN TableProductsByMaxRow.LineNumber
	|		ELSE TypesOfStocksGoods.LineNumber
	|	END AS LineNumber,
	|	TypesOfStocksGoods.AccountingFeature AS AccountingFeature,
	|	TypesOfStocksGoods.Counterparty AS Counterparty,
	|	TypesOfStocksGoods.Partner AS Partner,
	|	TypesOfStocksGoods.RowCode AS RowCode,
	|	TypesOfStocksGoods.VATRate AS VATRate1,
	|	TypesOfStocksGoods.GoodsVATRate AS GoodsVATRate
	|INTO GoodsTable
	|FROM
	|	TypesOfStocksGoods AS TypesOfStocksGoods
	|		LEFT JOIN TableProductsByMaxRow AS TableProductsByMaxRow
	|		ON (CASE
	|				WHEN TypesOfStocksGoods.LineNumber = 0
	|					THEN TypesOfStocksGoods.Products = TableProductsByMaxRow.Products
	|				ELSE FALSE
	|			END)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsTable.Products AS Products,
	|	GoodsTable.Characteristic AS Characteristic,
	|	GoodsTable.NomenclatureName AS NomenclatureName,
	|	GoodsTable.Count AS Count,
	|	GoodsTable.QuantityByGBRN AS QuantityByGBRN,
	|	GoodsTable.InventoryType AS InventoryType,
	|	GoodsTable.Price AS Price,
	|	GoodsTable.Sum AS Sum,
	|	GoodsTable.RowID AS RowID,
	|	GoodsTable.VATAmount AS VATAmount,
	|	GoodsTable.CCDNumber AS CCDNumber,
	|	GoodsTable.Series AS Series,
	|	GoodsTable.Package AS Package,
	|	GoodsTable.NumberOfPackages AS NumberOfPackages,
	|	GoodsTable.CharacteristicName AS CharacteristicName,
	|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
	|	GoodsTable.TaxationType AS TaxationType,
	|	GoodsTable.ProductsTypeOfProducts AS ProductsTypeOfProducts,
	|	GoodsTable.LineNumber AS LineNumber,
	|	GoodsTable.AccountingFeature AS AccountingFeature,
	|	GoodsTable.Counterparty AS Counterparty,
	|	GoodsTable.Partner AS Partner,
	|	GoodsTable.RowCode AS RowCode,
	|	GoodsTable.VATRate AS VATRate,
	|	GoodsTable.GoodsVATRate AS GoodsVATRate
	|FROM
	|	GoodsTable AS GoodsTable
	|";
	
	Query.Execute();
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
		
		Query.Text =
		"SELECT
		|	GoodsTable.Products AS Products,
		|	CASE
		|		WHEN GoodsTable.CharacteristicName = """"
		|			THEN GoodsTable.NomenclatureName
		|		ELSE GoodsTable.NomenclatureName + "" ("" + GoodsTable.CharacteristicName + "")""
		|	END AS Content,
		|	GoodsTable.Products.Principal AS PrincipalLink,
		|	CASE
		|		WHEN GoodsTable.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByCompanyOnAgencyBasis)
		|				OR GoodsTable.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByPartner)
		|			THEN ""Agency""
		|		ELSE ""Own""
		|	END AS ServiceType,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Price AS Price,
		|	CASE
		|		WHEN GoodsTable.TaxationType = VALUE(Enum.VATTaxationTypes.SaleIsNotSubjectToVAT)
		|			THEN GoodsTable.GoodsVATRate
		|		ELSE GoodsTable.VATRate
		|	END AS VATRate,
		|	GoodsTable.Sum AS Sum,
		|	GoodsTable.RowID AS RowID,
		|	GoodsTable.VATAmount AS VATAmount
		|FROM
		|	GoodsTable AS GoodsTable
		|WHERE
		|	(GoodsTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.OperationService)
		|				AND (GoodsTable.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedBySellerCompany)
		|					OR GoodsTable.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.WithoutAccountingFeatures))
		|			OR GoodsTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.Products AS Products,
		|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
		|	GoodsTable.Price AS Price,
		|	CASE
		|		WHEN GoodsTable.TaxationType = VALUE(Enum.VATTaxationTypes.SaleIsNotSubjectToVAT)
		|			THEN GoodsTable.GoodsVATRate
		|		ELSE GoodsTable.VATRate
		|	END AS VATRate,
		|	GoodsTable.InventoryType AS InventoryType,
		|	GoodsTable.LineNumber AS DocumentRowNumber,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Sum AS Sum,
		|	GoodsTable.VATAmount AS VATAmount,
		|	GoodsTable.RowID AS RowID,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest
		|FROM
		|	GoodsTable AS GoodsTable
		|WHERE
		|	GoodsTable.ProductsTypeOfProducts <> VALUE(Enum.ItemsTypes.OperationService)
		|			AND GoodsTable.ProductsTypeOfProducts <> VALUE(Enum.ItemsTypes.Work_5)
		|
		|ORDER BY
		|	GoodsTable.LineNumber";
		
		FillInYourOwnProductsInText(Query.Text);
				
		Query.Text = StrReplace(Query.Text, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "GoodsTable"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "GoodsTable"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "GoodsTable"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "GoodsTable"));
		
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "GoodsTable"));
		
		QueryResults = Query.ExecuteBatch();
		
		OtherServices = QueryResults[0].Unload();
		TableOfServicesForPrincipal(ExchangeComponents, OtherServices);
		
		Goods = QueryResults[1].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
			RedefineVATRateForOldFormats(OtherServices, False);
		EndIf;
		XDTOData.Insert("Services", OtherServices);
		
	Else
		
		Query.Text =
		"SELECT
		|	Goods.Products AS Products,
		|	Goods.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Price AS Price,
		|	CASE
		|		WHEN Goods.TaxationType = VALUE(Enum.VATTaxationTypes.SaleIsNotSubjectToVAT)
		|			THEN Goods.GoodsVATRate
		|		ELSE Goods.VATRate
		|	END AS VATRate,
		|	Goods.InventoryType AS InventoryType,
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Count AS Count,
		|	Goods.Sum AS Sum,
		|	Goods.RowID AS RowID,
		|	Goods.VATAmount AS VATAmount,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest
		|FROM
		|	GoodsTable AS Goods
		|WHERE
		|	Goods.ProductsTypeOfProducts <> VALUE(Enum.ItemsTypes.OperationService)
		|			AND Goods.ProductsTypeOfProducts <> VALUE(Enum.ItemsTypes.Work_5)
		|
		|ORDER BY
		|	Goods.LineNumber";
		
		FillInYourOwnProductsInText(Query.Text);
		
		Query.Text = StrReplace(Query.Text, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "Goods"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Goods"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
		
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "Goods"));
		
		Goods = Query.Execute().Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
		
		
	EndIf; 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("Goods", Goods);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure


Procedure AddPCO_InformationRegister_SegmentItem_Sending(ConversionRules)
	ConversionRule = DataExchangeXDTOServer.InitializeObjectConversionRule(ConversionRules);
	ConversionRule.OCRName            = "InformationRegister_SegmentItem_Sending";
	ConversionRule.DataObject      = Metadata.InformationRegisters.SegmentProducts;
	ConversionRule.FormatObject     = "Справочник.НоменклатураСегмента"; //@NON-NLS-1
	ConversionRule.OnSendData = "OCR_InformationRegister_SegmentProducts_Send_OnSendData";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "", "Description", 1);
	AddPCR(HeaderProperties, "", "Products", 1, "Catalog_Products_Send");
	AddPCR(HeaderProperties, "", "Segment", 1, "Catalog_ProductSegments");
	AddPCR(HeaderProperties, "", "Characteristic", 1, "Catalog_ItemsCharacteristics");
EndProcedure
Procedure OCR_InformationRegister_SegmentProducts_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	ProductSegment = IBData.Filter.Segment.Value;
	
	// In the 1.19 format, key properties have been added for the format object, which does not make sense for Transferring information register entries
	//	for this reason, we fill in the name
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) <= NumberFormatVersion("1.20") Then
		
		Description = Common.ObjectAttributeValue(ProductSegment, "Description");
		
		XDTOData.KeyProperties.Insert("Description", Description);
		
	EndIf;
	
	XDTOData.Insert("Products",         IBData.Filter.Products.Value);
	XDTOData.Insert("Segment", ProductSegment);
	XDTOData.Insert("Characteristic",   IBData.Filter.Characteristic.Value);
EndProcedure

