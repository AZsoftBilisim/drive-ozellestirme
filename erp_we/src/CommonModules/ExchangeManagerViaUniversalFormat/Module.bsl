		|	VALUETYPE(ISNULL(&Source.Package.Owner, VALUE(Catalog.PackagingGroups.EmptyRef))) = TYPE(Catalog.Products) AS ProductPackaging,
		|	&Source.Package.Description AS PackagingName_,
		|	&Source.Package.UnitOfMeasure AS PackagingUnitOfMeasure,
