	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData,,"ARAPCurrency");
	
	If XDTOData.Property("LocalAgreement") And ValueIsFilled(XDTOData.LocalAgreement) Then
		AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents, "LocalAgreement");
	Else
		AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	EndIf;
	
	If XDTOData.Property("DocumentCourse") And ValueIsFilled(XDTOData.DocumentCourse) Then
		ReceivedData.AdditionalProperties.Insert("DocumentCourse", XDTOData.DocumentCourse);
	EndIf;
	
	If XDTOData.Property("DocumentMultiplicity") And ValueIsFilled(XDTOData.DocumentMultiplicity) Then
		ReceivedData.AdditionalProperties.Insert("DocumentMultiplicity", XDTOData.DocumentMultiplicity);
	EndIf; 
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	// Goods 
	FillingRules = New Map;
	FillingRules.Insert("SectionNumber",        "SectionNumber");
	FillingRules.Insert("Products",        "Products");
	FillingRules.Insert("Count",          "Count");
	FillingRules.Insert("CustomsValue", "CustomsValue");
	FillingRules.Insert("VATAmount",            "VATAmount");
	FillingRules.Insert("DutyAmount",        "DutyAmount");
	FillingRules.Insert("ExciseTaxAmount",         "ExciseTaxAmount");
	FillingRules.Insert("OriginCountry", "OriginCountry");
	FillingRules.Insert("DocumentInflow", "DocumentInflow");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	DocumentAmount = 0;
	
	#Region Goods
	
	ArrayOfRows = New Array;
	
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
		
		For Each String In XDTOData.Goods Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("SectionNumber") 
				And ValueIsFilled(StringDataStructure.SectionNumber) 
				And XDTOData.Property("Sections")
				And ValueIsFilled(XDTOData.Sections) Then
				
				SectionRow = XDTOData.Sections.Find(StringDataStructure.SectionNumber, "SectionNumber");
				If Not SectionRow = Undefined And ValueIsFilled(SectionRow.VATRate) Then
					StringDataStructure.Insert(
						"VATRate", CatalogOfVATRateTransfers(
							ExchangeComponents, SectionRow.VATRate));
				EndIf;
				
				If Not SectionRow = Undefined 
					And ValueIsFilled(SectionRow.DutyAmount)
					And ValueIsFilled(SectionRow.CustomsValue) Then
					
					DutyRate = 100 * StringDataStructure.DutyAmount / StringDataStructure.CustomsValue;
					StringDataStructure.Insert("DutyRate", DutyRate);
				EndIf;
			EndIf;
			
			If Not StringDataStructure.Property("NumberOfPackages") Then
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
			If Not StringDataStructure.Property("ExciseTaxAmount") Then
				StringDataStructure.Insert("ExciseTaxAmount", 0);
			EndIf;	
				
			If ValueIsFilled(XDTOData.DeclarationNo) Then
				StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", XDTOData.DeclarationNo, String.OriginCountry));
			EndIf;
			ArrayOfRows.Add(StringDataStructure);
			If Not StringDataStructure.Property("DutyAmount") Then
				StringDataStructure.Insert("DutyAmount", 0);
			EndIf;
			If Not StringDataStructure.Property("VATAmount") Then
				StringDataStructure.Insert("VATAmount", 0);
			EndIf;
	
			DocumentAmount = DocumentAmount + StringDataStructure.DutyAmount + StringDataStructure.VATAmount;
		EndDo;
	EndIf;
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	#EndRegion
	
	#Region Sections
	
	// Sections. 
	FillingRules = New Map;
	FillingRules.Insert("SectionNumber",        "SectionNumber");
	FillingRules.Insert("DutyRate",       "DutyRate");
	FillingRules.Insert("VATRate",           "VATRate");
	FillingRules.Insert("CustomsValue", "CustomsValue");
	FillingRules.Insert("VATAmount",            "VATAmount");
	FillingRules.Insert("DutyAmount",        "DutyAmount");
	ArrayOfRowsSections = New Array;
	If XDTOData.Property("Sections")
		And ValueIsFilled(XDTOData.Sections) Then
		
		For Each String In XDTOData.Sections Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			If StringDataStructure.Property("DutyAmount")
				And Not StringDataStructure.Property("DutyRate")
				And Not StringDataStructure.CustomsValue = 0 Then
				DutyRate = 100 * StringDataStructure.DutyAmount / StringDataStructure.CustomsValue;
				StringDataStructure.Insert("DutyRate", DutyRate);
			EndIf;
	
			// Country of origin - from the Goods section
			For Each LineProducts_ In XDTOData.Goods Do
				If LineProducts_.SectionNumber = String.SectionNumber And ValueIsFilled(LineProducts_.OriginCountry) Then
					StringDataStructure.Insert("OriginCountry", LineProducts_.OriginCountry);
					Break;
				EndIf;
			EndDo;
			ArrayOfRowsSections.Add(StringDataStructure);
		EndDo;
	EndIf;
	If ArrayOfRowsSections.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Sections", ArrayOfRowsSections);
	EndIf;
	
	#EndRegion
	
	ReceivedData.DocumentAmount = DocumentAmount + ReceivedData.CustomsFee + ReceivedData.CustomsPenalty;
	ReceivedData.AmountARAP = ReceivedData.DocumentAmount;
EndProcedure
Procedure OCR_Document_CustomsDeclaration_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
								
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If Not DataToWriteToIB.UseSections Then
		DataToWriteToIB.UseSections = GetFunctionalOption("UseSectionsOfCustomsDeclarationImport");
	EndIf;
	
	// The customs value of the BP is unloaded in the currency of the document, the rest in the currency of the registration
	If ReceivedData.Currency <> LocalAccountingCurrency(ExchangeComponents)
		And ReceivedData.AdditionalProperties.Property("DocumentCourse")
		And ReceivedData.AdditionalProperties.Property("DocumentMultiplicity") Then
		
		ReceivedData.Currency = LocalAccountingCurrency(ExchangeComponents);
		ReceivedData.ARAPCurrency = LocalAccountingCurrency(ExchangeComponents);
		
		For Each RowGoods In ReceivedData.Goods Do
			RowGoods.CustomsValue = RowGoods.CustomsValue * ReceivedData.AdditionalProperties.DocumentCourse / ReceivedData.AdditionalProperties.DocumentMultiplicity;
			RowGoods.DutyRate = 100 * RowGoods.DutyAmount / RowGoods.CustomsValue;
		EndDo;
		
		For Each RowSection In ReceivedData.Sections Do
			RowSection.CustomsValue = RowSection.CustomsValue * ReceivedData.AdditionalProperties.DocumentCourse / ReceivedData.AdditionalProperties.DocumentMultiplicity;
			RowSection.DutyRate = 100 * RowSection.DutyAmount / RowSection.CustomsValue;
		EndDo;
		
	EndIf;
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
EndProcedure

