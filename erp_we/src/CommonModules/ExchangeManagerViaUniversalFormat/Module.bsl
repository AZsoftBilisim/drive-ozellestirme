Procedure PCO_Document_PBDSOtherReceipt_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	FillInDateAndNumberOfIncomingDocument(ReceivedData);
	
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt;
	
	Account_Settlement = Undefined;
	If XDTOData.ARAPDetails.Columns.Find("Account_Settlement") <> Undefined Then
		Account_Settlement = XDTOData.ARAPDetails[0].Account_Settlement;
	EndIf;
	If ValueIsFilled(Account_Settlement) Then
		If Find(Account_Settlement, "51") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromAnotherAccount;
		ElsIf Find(Account_Settlement, "79.02") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices;
		ElsIf Find(Account_Settlement, "57.01") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount;
		ElsIf Find(Account_Settlement, "70") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.UnremittedSalaryReturnToPersonalAccounts;
		EndIf;
	EndIf;
	
	#Region ARAPDetails
	
	ArrayOfStringsDecryption = New Array;
	For Each String In XDTOData.ARAPDetails Do
		
		FillingRules = New Map;
		FillingRules.Insert("Sum", "Sum");
		FillingRules.Insert("CFItem", "CashFlowItem");
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		ArrayOfStringsDecryption.Add(StringDataStructure);
		
	EndDo;
	ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfStringsDecryption);
	
	#EndRegion
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
EndProcedure
