Procedure DPR_Document_ConsignmentReportFromCustomer_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	ClearUsageOCR(UsageOCR);
	
	If XDTOData.KeyProperties.Property("TypeOfOperationOfCommissionaireSReport") Then
		
		If (XDTOData.KeyProperties.TypeOfOperationOfCommissionaireSReport.Value = "SalesViaCommissionAgent"
			Or XDTOData.KeyProperties.TypeOfOperationOfCommissionaireSReport.Value = "SalesViaCommissionAgentGoodsInTransit") Then
			
			UsageOCR.Insert("Document_SaleOfGoodsAndServicesFee_Receipt", True);
		
		ElsIf XDTOData.KeyProperties.TypeOfOperationOfCommissionaireSReport.Value = "ReturnOfGoodsFromCommissionAgent" Then
			
			UsageOCR.Insert("Document_ReturnOfGoodsFromCustomerFee_Receipt", True);
			
		Else
			
			UsageOCR.Insert("Document_CommissionAgentSReport_Receipt", True);
			
		EndIf;
		
	Else
		
		UsageOCR.Insert("Document_CommissionAgentSReport_Receipt", True);
		
	EndIf;
EndProcedure

