Procedure UploadDecryptionCounterparties_ReceiptOfCash(IBData, XDTOData, ConversionAlgorithm, ExchangeComponents)
	HeaderData_                   = IBData.AdditionalProperties.HeaderData_;
	CurrencyOfComplianceAccounting               = LocalAccountingCurrency(IBData.Organization);
	
	DecryptionOfPaymentInInformationBase = TranscriptOfPaymentCashReceiptDocuments(IBData, ExchangeComponents);
	
	DecryptionOfXDTOPayment = NewXDTOPaymentDecryptionTable();
	
	If ConversionAlgorithm = "PaymentFromBuyer"
		Or ConversionAlgorithm = "PaymentFromIntercampanyBuyer"
		Or ConversionAlgorithm = "RefundFromSupplier"
		Or ConversionAlgorithm = "ReturnFromIntercampanySupplier"
		Or ConversionAlgorithm = "Loans_SettlementsOnLoansAndBorrowings" 
		Or ConversionAlgorithm = "Loans_LoanSettlements_"
		Or ConversionAlgorithm = "Loans_LoanSettlements"
		Or ConversionAlgorithm = "RefundFromLandlord"
		Or ConversionAlgorithm = "Deposits_OtherSettlementsWithCounterparties" Then
		
		// Multi-line decryption of the payment.
		For Each InformationBasePaymentDecryptionString In DecryptionOfPaymentInInformationBase Do
			
			PaymentDecryptionString = DecryptionOfXDTOPayment.Add();
			
			RowPaddingProperties = "CFItem, Sum, AmountARAP, TransactionRate, Multiplier_, 
					|TypeOfCalculationsAdvanced, AccountForSettlementsWithCounterparty, ARAPCurrency";
			
			
			If ConversionAlgorithm = "PaymentFromBuyer"
				Or ConversionAlgorithm = "PaymentFromIntercampanyBuyer"
				Or ConversionAlgorithm = "RefundFromSupplier"
				Or ConversionAlgorithm = "ReturnFromIntercampanySupplier" Then
				RowPaddingProperties = RowPaddingProperties + ", VATAmount, VATRate";
			EndIf;
			
			FillPropertyValues(PaymentDecryptionString, InformationBasePaymentDecryptionString, RowPaddingProperties);
			
			// Settlement documents.
			UploadOrderSettlementDocumentPaymentTranscript(PaymentDecryptionString, InformationBasePaymentDecryptionString.DocumentOfSettlementObject,
				IBData.Organization, ExchangeComponents);
					
			PaymentDecryptionString.MethodOfDebtRepayment = MethodOfDebtRepaymentLineDecryption(PaymentDecryptionString, ExchangeComponents);
			
			If ConversionAlgorithm = "Loans_SettlementsOnLoansAndBorrowings"
				Or ConversionAlgorithm = "Deposits_OtherSettlementsWithCounterparties" 
				Or ConversionAlgorithm = "Loans_LoanSettlements_" 
				Or ConversionAlgorithm = "Loans_LoanSettlements" Then
				
				PaymentDecryptionString.Contract = New Structure("Value, OCRName", 
					InformationBasePaymentDecryptionString.LoanDepositContract, "Catalog_LoanAndDepositContracts_Send");
				
			ElsIf ValueIsFilled(InformationBasePaymentDecryptionString.Contract) Then
				
				If TypeOf(InformationBasePaymentDecryptionString.Contract) = Type("CatalogRef.IntercompanyContracts") Then
					ContractData = ContractDataBetweenOrganizations(ExchangeComponents, InformationBasePaymentDecryptionString.Contract, IBData.Organization);
					PaymentDecryptionString.Contract = New Structure("Value, OCRName",
						ContractData, "Catalog_ContractsOfCounterparties_FromStructure");
				Else
					PaymentDecryptionString.Contract = InformationBasePaymentDecryptionString.Contract;
				EndIf;
				
			Else
				
				TypeOfAgreement              = "";
				CalculationsInConventionalUnits = Undefined;
				
				ARAPObjectIntercompany = ThisIsIntercampanyDocument(InformationBasePaymentDecryptionString.DocumentOfSettlementObject);
				
				CalculationObjectData = ValuesOfExistingItemDetails(InformationBasePaymentDecryptionString.DocumentOfSettlementObject,
					"Terms,Contract,SalesOpportunity");
				
				If ValueIsFilled(CalculationObjectData.Contract) Then
				
					If TypeOf(CalculationObjectData.Contract) = Type("CatalogRef.IntercompanyContracts") Then
						ContractData = ContractDataBetweenOrganizations(ExchangeComponents, CalculationObjectData.Contract, IBData.Organization);
						PaymentDecryptionString.Contract = New Structure("Value, OCRName",
						ContractData, "Catalog_ContractsOfCounterparties_FromStructure");
					Else
						PaymentDecryptionString.Contract = CalculationObjectData.Contract;
					EndIf;
					
				Else
					
					If IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany 
						Or ARAPObjectIntercompany Then
						
						TypeOfAgreement = "WithCustomer";
						
					Else
						
						TypeOfAgreement = TypeOfCounterpartyAgreement(
							InformationBasePaymentDecryptionString.DocumentOfSettlementObject,
							CalculationObjectData.Terms,
							IBData.BusinessOperation);
							
					EndIf;
				
					If Not ValueIsFilled(TypeOfAgreement) Then
						TypeOfAgreement = "Other";
					EndIf;
						
					// Calculations in conventional units
					If ValueIsFilled(CalculationObjectData.Terms) Then
						UECalculationData          = Common.ObjectAttributesValues(CalculationObjectData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
						CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
					Else
						CalculationsInConventionalUnits = IBData.Currency = CurrencyOfComplianceAccounting
							And IBData.Currency <> InformationBasePaymentDecryptionString.ARAPCurrency;
					EndIf;
					
					DefaultParameters = New Structure(ContractFixedKeyStructure());
					DefaultParameters.Counterparty               = XDTOData.Counterparty;
					DefaultParameters.Organization              = IBData.Organization;
					DefaultParameters.ARAPCurrency     = InformationBasePaymentDecryptionString.ARAPCurrency;
					DefaultParameters.TypeOfAgreement              = TypeOfAgreement;
					DefaultParameters.Date                     = IBData.Date;
					DefaultParameters.Number                    = IBData.Number;
					DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
					
					OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", 
						InformationBasePaymentDecryptionString.DocumentOfSettlementObject, CalculationObjectData.Terms, CalculationObjectData.SalesOpportunity);
					
					PaymentDecryptionString.Contract = 
						ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
				
				EndIf;
			EndIf;
		
			// Order from the payment basis.
			If Not ValueIsFilled(PaymentDecryptionString.OrderDocument)
				And ValueIsFilled(InformationBasePaymentDecryptionString.PaymentPurpose) Then
				
				OCRName = NameOfICOForDataObject(ExchangeComponents, InformationBasePaymentDecryptionString.PaymentPurpose, IBData.Organization);
				TypeOfPaymentBasis = TypeOf(InformationBasePaymentDecryptionString.PaymentPurpose);
				If ValueIsFilled(OCRName)
					And (TypeOfPaymentBasis = Type("DocumentRef.SalesOrder")
					Or TypeOfPaymentBasis = Type("DocumentRef.PurchaseOrder")) Then
					
					PaymentDecryptionString.OrderDocument = New Structure("Value, OCRName", 
						InformationBasePaymentDecryptionString.PaymentPurpose, OCRName);
				EndIf;
			EndIf;
		EndDo;
		
	ElsIf ConversionAlgorithm = "OtherIncome_SettlementsOnLoansAndBorrowings"
		Or ConversionAlgorithm = "OtherReceipts_OtherSettlementsWithCounterparties"
		Or ConversionAlgorithm = "CurrencyConversion_OtherSettlementsWithCounterparties" Then
		
		// One-line transcript of the payment
		PaymentDecryptionString = DecryptionOfXDTOPayment.Add();
		PaymentDecryptionString.CFItem               = IBData.CashFlowItem;
		PaymentDecryptionString.Sum                   = IBData.DocumentAmount;
		PaymentDecryptionString.TransactionRate      = HeaderData_.Currency_ExchangeRate;
		PaymentDecryptionString.Multiplier_ = HeaderData_.Currency_Multiplicity;
		PaymentDecryptionString.AmountARAP     = IBData.DocumentAmount;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = IBData.Currency;
		DefaultParameters.TypeOfAgreement              = "Other";
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = False;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", PaymentDecryptionString.OrderDocument, Undefined, Undefined);
		PaymentDecryptionString.Contract = 
			ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
			
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then
		 RedefineVATRateForOldFormats(DecryptionOfXDTOPayment, False);
	EndIf;
	XDTOData.Insert("ARAPDetails", DecryptionOfXDTOPayment);
EndProcedure
Procedure UploadDecryptionCounterparties_DebitingCash(IBData, XDTOData, CounterpartyRef, ExchangeComponents)
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	
	DecryptionOfPaymentInInformationBase = DecryptionOfPaymentOfDocumentsOfWriteOffOfCash(IBData, ExchangeComponents);
	
	DecryptionOfXDTOPayment = NewXDTOPaymentDecryptionTable();
	
	For Each InformationBasePaymentDecryptionString In DecryptionOfPaymentInInformationBase Do
		
		PaymentDecryptionString = DecryptionOfXDTOPayment.Add();
		RowPaddingProperties = "CFItem,Sum,AmountARAP,TransactionRate,Multiplier_,ARAPCurrency";
		
		If XDTOData.ARAPType = "WithVendor"
			Or XDTOData.ARAPType = "WithCustomer" Then
			RowPaddingProperties = RowPaddingProperties + ",VATRate,VATAmount";
		EndIf;
		
		FillPropertyValues(PaymentDecryptionString, InformationBasePaymentDecryptionString, RowPaddingProperties);
		
		If Not ValueIsFilled(PaymentDecryptionString.CFItem) Then
			PaymentDecryptionString.CFItem = IBData.CashFlowItem;
		EndIf;
		
		// Settlement Documents
		UploadOrderSettlementDocumentPaymentTranscript(PaymentDecryptionString, InformationBasePaymentDecryptionString.DocumentOfSettlementObject,
			IBData.Organization, ExchangeComponents);
		
		PaymentDecryptionString.MethodOfDebtRepayment = MethodOfDebtRepaymentLineDecryption(PaymentDecryptionString, ExchangeComponents);
		
		// Contract
		If ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation)
			Or ThisIsBusinessOperationSettlementOfDeposits(IBData.BusinessOperation) Then
			
			PaymentDecryptionString.Contract = New Structure("Value, OCRName",
				InformationBasePaymentDecryptionString.LoanDepositContract, "Catalog_LoanAndDepositContracts_Send");
			
		ElsIf ValueIsFilled(InformationBasePaymentDecryptionString.Contract) Then
			
			If TypeOf(InformationBasePaymentDecryptionString.Contract) = Type("CatalogRef.IntercompanyContracts") Then
				
				ContractData = ContractDataBetweenOrganizations(ExchangeComponents, InformationBasePaymentDecryptionString.Contract, IBData.Organization);
				PaymentDecryptionString.Contract = New Structure("Value, OCRName",
					ContractData, "Catalog_ContractsOfCounterparties_FromStructure");
				
			Else
				
				PaymentDecryptionString.Contract = InformationBasePaymentDecryptionString.Contract;
				
			EndIf;
			
		Else
			
			TypeOfAgreement = "";
			CalculationsInConventionalUnits = Undefined;
			
			ARAPObjectIntercompany = ThisIsIntercampanyDocument(InformationBasePaymentDecryptionString.DocumentOfSettlementObject);
			
			CalculationObjectData = ValuesOfExistingItemDetails(InformationBasePaymentDecryptionString.DocumentOfSettlementObject,
				"Terms,Contract,SalesOpportunity");
			
			If ValueIsFilled(CalculationObjectData.Contract) Then
				
				If TypeOf(CalculationObjectData.Contract) = Type("CatalogRef.IntercompanyContracts") Then
					ContractData = ContractDataBetweenOrganizations(ExchangeComponents, CalculationObjectData.Contract, IBData.Organization);
					PaymentDecryptionString.Contract = New Structure("Value, OCRName",
						ContractData, "Catalog_ContractsOfCounterparties_FromStructure");
				Else
					PaymentDecryptionString.Contract = CalculationObjectData.Contract;
				EndIf; 
				
			Else
				
				If IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToLessor Then 
					
					TypeOfAgreement = "Other";
					
				ElsIf ARAPObjectIntercompany Then 
					
					TypeOfAgreement = TypeOfContractForIntercampanySettlementObject(IBData.Organization, InformationBasePaymentDecryptionString.DocumentOfSettlementObject, "WithCustomer");
					
				Else
					
					TypeOfAgreement = TypeOfCounterpartyAgreement(InformationBasePaymentDecryptionString.DocumentOfSettlementObject,
						CalculationObjectData.Terms, IBData.BusinessOperation);
					
					If TypeOfAgreement = "WithConsignor"
						Or TypeOfAgreement = "WithConsignee" Then
						CalculationsInConventionalUnits = False;
					Else
						If ValueIsFilled(CalculationObjectData.Terms) Then
							UECalculationData          = Common.ObjectAttributesValues(CalculationObjectData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
							CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
						EndIf;
					EndIf;
					
				EndIf;
				
			EndIf;
			
			If Not ValueIsFilled(PaymentDecryptionString.Contract) Then
				
				If XDTOData.ARAPType = "Other" Then
					TypeOfAgreement = "Other";
				ElsIf Not ValueIsFilled(TypeOfAgreement) Then
					TypeOfAgreement = "WithVendor";
				EndIf;
				
				If Not ValueIsFilled(CalculationsInConventionalUnits) Then
					If TypeOfAgreement = "WithConsignor" Or TypeOfAgreement = "WithConsignee" Then
						CalculationsInConventionalUnits = False;
					Else
						CalculationsInConventionalUnits = IBData.Currency = CurrencyOfComplianceAccounting
							And IBData.Currency <> InformationBasePaymentDecryptionString.ARAPCurrency;
					EndIf;
				EndIf;
				
				ARAPCurrency = InformationBasePaymentDecryptionString.ARAPCurrency;
				If Not ValueIsFilled(ARAPCurrency) Then
					ARAPCurrency = CurrencyOfComplianceAccounting;
				EndIf;
				
				DefaultParameters = New Structure(ContractFixedKeyStructure());
				DefaultParameters.Counterparty               = CounterpartyRef;
				DefaultParameters.Organization              = IBData.Organization;
				DefaultParameters.ARAPCurrency     = ARAPCurrency;
				DefaultParameters.TypeOfAgreement              = TypeOfAgreement;
				DefaultParameters.Date                     = IBData.Date;
				DefaultParameters.Number                    = IBData.Number;
				DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
				
				OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", 
				InformationBasePaymentDecryptionString.DocumentOfSettlementObject, CalculationObjectData.Terms, Undefined);
				PaymentDecryptionString.Contract = 
					ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
				
			EndIf;
		EndIf;
		
		// The type of calculation is expanded and the account is accounted for by the counteragent
		PaymentDecryptionString.TypeOfCalculationsAdvanced = ?(ValueIsFilled(InformationBasePaymentDecryptionString.TypeOfCalculationsAdvanced),InformationBasePaymentDecryptionString.TypeOfCalculationsAdvanced, "");
		PaymentDecryptionString.AccountForSettlementsWithCounterparty = ?(ValueIsFilled(InformationBasePaymentDecryptionString.AccountForSettlementsWithCounterparty),InformationBasePaymentDecryptionString.AccountForSettlementsWithCounterparty,0);
		
	EndDo;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then
		 RedefineVATRateForOldFormats(DecryptionOfXDTOPayment, False);
	EndIf;
	XDTOData.Insert("ARAPDetails", DecryptionOfXDTOPayment);
EndProcedure
Procedure UploadDecryptionOfPaymentCurrencyConverterPDS(ExchangeComponents, IBData, XDTOData, DateOfTransaction)
	DecryptionOfXDTOPayment = NewPaymentDecryptionTableCurrencyConverterXDTO();
	LocalAccountingCurrency          = LocalAccountingCurrency(IBData.Organization);
	CurrencyOfOperation = ?(IBData.Currency = LocalAccountingCurrency, IBData.CurrencyOfConversion, IBData.Currency);
	ConversionMultiplicity = IBData.ConversionRateMultiplier;
	
	// In the format, the multiplicity can only be an integer. It must be rounded to avoid errors when uploading
	If ConversionMultiplicity <> Int(ConversionMultiplicity) Then
		ConversionMultiplicity = Round(ConversionMultiplicity);
	EndIf; 
	
	DecryptionString = DecryptionOfXDTOPayment.Add();
	
	DecryptionString.CFItem            = IBData.CashFlowItem;
	DecryptionString.CurrencyOfConversion    = IBData.CurrencyOfConversion;
	DecryptionString.ConversionRate      = IBData.ConversionRate;
	DecryptionString.Sum                = IBData.DocumentAmount;
	DecryptionString.SumCurr             = IBData.ConversionAmount;
	
	// ExchangeRateOfCentralBankOnDateOfConversion
	ParametersOfCentralBankExchangeRateOnDateOfCurrencyTransaction = ProcessingOfExchangeRatesTM.GetCurrencyRate(CurrencyOfOperation, IBData.Date, LocalAccountingCurrency);
	
	If ConversionMultiplicity <> 0 Then
		DecryptionString.ConversionMultiplicity = ConversionMultiplicity;
	Else 
		DecryptionString.ConversionMultiplicity = ParametersOfCentralBankExchangeRateOnDateOfCurrencyTransaction.CourseDenominator;
	EndIf;
	
	DecryptionString.ExchangeRateOfCentralBankOnDateOfConversion = ParametersOfCentralBankExchangeRateOnDateOfCurrencyTransaction.CourseNumerator;
	
	// Contract
	DefaultParameters = New Structure(ContractFixedKeyStructure());
	DefaultParameters.Counterparty  = IBData.Counterparty;
	DefaultParameters.Organization = IBData.Organization;
	DefaultParameters.TypeOfAgreement = "Other";
	DefaultParameters.Date        = IBData.Date;
	DefaultParameters.Number       = IBData.Number;
	
	DefaultParameters.ARAPCurrency     = IBData.CurrencyOfConversion;
	DefaultParameters.CalculationsInConventionalUnits = False;
	
	DecryptionString.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents);
	
	XDTOData.Insert("ARAPDetails", DecryptionOfXDTOPayment);
EndProcedure
