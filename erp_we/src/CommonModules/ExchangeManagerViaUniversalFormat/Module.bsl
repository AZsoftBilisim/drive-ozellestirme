Procedure PCO_Document_SBDSTransferringPOToLS_Getting_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	PayrollIsUsed = False;
	#Region Header
	
	ReceivedData.Posted = True;
	If XDTOData.Property("DateOfDischarge") Then
		ReceivedData.AdditionalProperties.Insert("DateOfDischarge", XDTOData.DateOfDischarge);
	EndIf;
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentToBankAccounts;
	
	// CashFlowItem
	ReceivedData.AdditionalProperties.Insert("CashFlowItem", XDTOData.ARAPDetails[0].CFItem);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	// Nomeredomostinavid payments, datavedomostinavid payments
	If Not PayrollIsUsed Then
		ReceivedData.AdditionalProperties.Insert("PaysheetNumber",
			XDTOData.ARAPDetails[0].PaysheetNumber);
		ReceivedData.AdditionalProperties.Insert("PaysheetDate",
			XDTOData.ARAPDetails[0].PaysheetDate);
	EndIf;
	
	If XDTOData.Property("IncomeKindCode") 
		And ValueIsFilled(XDTOData.IncomeKindCode) Then
		ReceivedData.AdditionalProperties.Insert("IncomeKindCode",
			XDTOData.IncomeKindCode);
	EndIf;
	
	#Region CounterpartyBankAccount
	
	// The counterparty's bank account contained in the format object is loaded into
	// the Counterparty's Bank Accounts directory and linked to the counterparty. This document requires a bank
	// account linked to an individual. We create and fill in these invoices after downloading all the data.
	// To do this, we remember the account number so that after downloading all the data, fill out the account of an individual.
	If XDTOData.Property("BankAccount") And ValueIsFilled(XDTOData.BankAccount) Then
		ReceivedData.AdditionalProperties.Insert("CounterpartySBankAccount_Number",
			XDTOData.BankAccount.AccountNumber);
	EndIf;		
	
	#EndRegion
	
	#EndRegion
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
EndProcedure
Procedure PCO_Document_SBDSTransferringPOToLS_Getting_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	ConvertNumberToFormat12(ReceivedData, IBData);
	
	BeforeMerzhevanii_SBDS(ReceivedData, IBData, ExchangeComponents);
	Merzhevanie_SBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents);
	
	If IBData <> Undefined Then
		
		#Region CounterpartyBankAccount
		
		// We check that the account number is specified correctly, if it matches, then we leave the current value.
		If Not ValueIsFilled(IBData.CounterpartyBankAccount)
			And ReceivedData.AdditionalProperties.Property("CounterpartySBankAccount_Number") Then
			
			AccountNumberSource = ReceivedData.AdditionalProperties.CounterpartySBankAccount_Number;
			AccountNumberReceiver = Common.ObjectAttributeValue(
				IBData.CounterpartyBankAccount, "AccountNumber");
			
			If AccountNumberSource <> AccountNumberReceiver Then
				
				IBData.CounterpartyBankAccount = Catalogs.CounterpartyBankAccounts.EmptyRef();
				IBData.AdditionalProperties.Insert("CounterpartySBankAccount_Number", AccountNumberSource);
				
			EndIf;
			
		EndIf;
		
		#EndRegion
		
	EndIf;
	
	AfterMerzhevaniya_SBDS(ReceivedData, IBData, ExchangeComponents);
	
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
EndProcedure

