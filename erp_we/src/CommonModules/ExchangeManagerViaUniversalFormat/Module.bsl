	|	&QueryTextCharacteristic,
	|	&QueryTextPackage,
	|	&QueryTextSeries,
	|	&TextOfCCDRequest,
	|	&TextOfCCDRequestBeforeChange,
	|	&QueryTextProductBatchID,
	|	&TextOfRPTRequestBeforeCorrection,
	|	&TextOfRPTRequestBeforeChange,
	|	MappingResult.VATRate AS VATRate,
	|	MappingResult.VATRate AS VATRateBeforeChange,
	|	ISNULL(MappingResult.QuantityBeforeAdjustment,0) AS QuantityBeforeAdjustment,
	|	ISNULL(MappingResult.QuantityBeforeChange_,0) AS QuantityBeforeChange_,
	|	MappingResult.Count AS Count,
	|	ISNULL(MappingResult.NumberOfPackagesBeforeAdjustment,0) AS NumberOfPackagesBeforeAdjustment,
	|	ISNULL(MappingResult.NumberOfPackagesBeforeChange_,0) AS NumberOfPackagesBeforeChange_,
	|	MappingResult.NumberOfPackages AS NumberOfPackages,
	|	ISNULL(MappingResult.AmountBeforeAdjustment,0) AS AmountBeforeAdjustment,
	|	ISNULL(MappingResult.AmountBeforeChange,0) AS AmountBeforeChange,
	|	MappingResult.Sum AS Sum,
	|	ISNULL(MappingResult.VATAmountBeforeChange,0) AS VATAmountBeforeChange,
	|	ISNULL(MappingResult.VATAmount,0) AS VATAmount,
	|	CASE
	|		WHEN ISNULL(MappingResult.QuantityBeforeAdjustment, 0) = 0
	|			THEN 0
	|		ELSE CASE
	|				WHEN MappingResult.AmountBeforeAdjustment / MappingResult.QuantityBeforeAdjustment < 0.01
	|					THEN 0.01
	|				ELSE CAST(MappingResult.AmountBeforeAdjustment / MappingResult.QuantityBeforeAdjustment AS NUMBER(31, 2))
	|			END
	|	END AS PriceBeforeAdjustment,
	|	CASE
	|		WHEN ISNULL(MappingResult.QuantityBeforeChange_, 0) = 0
	|			THEN 0
	|		ELSE CASE
	|				WHEN MappingResult.AmountBeforeChange / MappingResult.QuantityBeforeChange_ < 0.01
	|					THEN 0.01
	|				ELSE CAST(MappingResult.AmountBeforeChange / MappingResult.QuantityBeforeChange_ AS NUMBER(31, 2))
	|			END
	|	END AS PriceBeforeChange,
	|	CASE
	|		WHEN ISNULL(MappingResult.Count, 0) = 0
	|			THEN 0
	|		ELSE CASE
	|				WHEN MappingResult.Sum / MappingResult.Count < 0.01
	|					THEN 0.01
	|				ELSE CAST(MappingResult.Sum / MappingResult.Count AS NUMBER(31, 2))
	|			END
	|	END AS Price,
	|	ISNULL(LineNumbers.LineNumber, 0) AS DocumentRowNumber,
	|	MappingResult.ThereIsImplementationReceiptInDocument AS ThereIsImplementationReceiptInDocument
	|FROM
	|	ProductComparisonResult AS MappingResult
	|		LEFT JOIN LineNumbers AS LineNumbers
	|		ON MappingResult.Products = LineNumbers.Products
	|    WHERE
	|    (MappingResult.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|    		OR MappingResult.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|    			AND NOT &ToReturnReusablePackage)
	|ORDER BY
	|	MappingResult.ThereIsImplementationReceiptInDocument DESC,
	|	ISNULL(LineNumbers.LineNumber, 0)";
	
	// Tabular parts of the Service (before correction, before correction, after correction)
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	Goods.Products,
	|	"""" AS Content,
	|	Goods.VATRate AS VATRate,
	|	Goods.Count,
	|	Goods.Sum,
	|	Goods.VATAmount
	|INTO ServicesBeforeAdjustmentDeployed
	|FROM
	|	Document.CustomerInvoice.Goods AS Goods
	|		INNER JOIN DocumentBeforeAdjustment AS DocumentBeforeAdjustment
	|		ON Goods.Ref = DocumentBeforeAdjustment.Ref
	|			AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|				OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
	|
	|UNION ALL
	|
	|SELECT
	|	Services.Products,
	|	Services.Content,
	|	Services.VATRate,
	|	Services.Count,
	|	Services.Sum,
	|	Services.VATAmount
	|FROM
	|	Document.CustomerInvoiceServices.Services AS Services
	|		INNER JOIN DocumentBeforeAdjustment AS DocumentBeforeAdjustment
	|		ON Services.Ref = DocumentBeforeAdjustment.Ref
	|
	|UNION ALL
	|
	|SELECT
	|	&EmptyItemList,
	|	Services.Content,
	|	Services.VATRate,
	|	Services.Count,
	|	Services.Sum,
	|	Services.VATAmount
	|FROM
	|	Document.CustomerInvoiceServicesAndAssets.Income AS Services
	|		INNER JOIN DocumentBeforeAdjustment AS DocumentBeforeAdjustment
	|		ON Services.Ref = DocumentBeforeAdjustment.Ref
	|
	|UNION ALL
	|
	|SELECT
	|	Goods.Products,
	|	Goods.Content,
	|	Goods.VATRate,
	|	Goods.Count,
	|	Goods.Sum,
	|	Goods.VATAmount
	|FROM
	|	Document.SaleAdjustment.Goods AS Goods
	|		INNER JOIN DocumentBeforeAdjustment AS DocumentBeforeAdjustment
	|		ON Goods.Ref = DocumentBeforeAdjustment.Ref
	|			AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|				OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|				OR &ImplementationOfServices)
	|UNION ALL
	|
	|SELECT
	|	ProductsForBalanceEntryAdjustments.Products,
	|	ProductsForBalanceEntryAdjustments.Products.Description,
	|	ProductsForBalanceEntryAdjustments.VATRate,
	|	ProductsForBalanceEntryAdjustments.Count,
	|	ProductsForBalanceEntryAdjustments.Sum,
	|	ProductsForBalanceEntryAdjustments.VATAmount
	|FROM
	|	ProductsForBalanceEntryAdjustments AS ProductsForBalanceEntryAdjustments
	|WHERE
	|	(ProductsForBalanceEntryAdjustments.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|			OR ProductsForBalanceEntryAdjustments.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ServicesBeforeAdjustmentDeployed.Products,
	|	ServicesBeforeAdjustmentDeployed.Content,
	|	ServicesBeforeAdjustmentDeployed.VATRate,
	|	SUM(ServicesBeforeAdjustmentDeployed.Count) AS Count,
	|	SUM(ServicesBeforeAdjustmentDeployed.Sum) AS Sum,
	|	SUM(ServicesBeforeAdjustmentDeployed.VATAmount) AS VATAmount
	|INTO ServicesBeforeAdjustment
	|FROM
	|	ServicesBeforeAdjustmentDeployed AS ServicesBeforeAdjustmentDeployed
	|
	|GROUP BY
	|	ServicesBeforeAdjustmentDeployed.Products,
	|	ServicesBeforeAdjustmentDeployed.Content,
	|	ServicesBeforeAdjustmentDeployed.VATRate 
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products,
	|	"""" AS Content,
	|	Goods.VATRate AS VATRate,
	|	Goods.Count,
	|	Goods.Sum,
	|	Goods.AmountIncludingVAT,
	|	Goods.VATAmount
	|INTO PreFixServicesDeployed
	|FROM
	|	Document.CustomerInvoice.Goods AS Goods
	|		INNER JOIN CorrectedDocument AS CorrectedDocument
	|		ON Goods.Ref = CorrectedDocument.Ref
	|			AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|				OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
	|
	|UNION ALL
	|
	|SELECT
	|	Services.Products,
	|	Services.Content,
	|	Services.VATRate,
	|	Services.Count,
	|	Services.Sum,
	|	Services.AmountIncludingVAT,
	|	Services.VATAmount
	|FROM
	|	Document.CustomerInvoiceServices.Services AS Services
	|		INNER JOIN CorrectedDocument AS CorrectedDocument
	|		ON Services.Ref = CorrectedDocument.Ref
	|
	|UNION ALL
	|
	|SELECT
	|	&EmptyItemList,
	|	Services.Content,
	|	Services.VATRate,
	|	Services.Count,
	|	Services.Sum,
	|	Services.AmountIncludingVAT,
	|	Services.VATAmount
	|FROM
	|	Document.CustomerInvoiceServicesAndAssets.Income AS Services
	|		INNER JOIN CorrectedDocument AS CorrectedDocument
	|		ON Services.Ref = CorrectedDocument.Ref
	|
	|UNION ALL
	|
	|SELECT
	|	Goods.Products,
	|	Goods.Content,
	|	Goods.VATRate,
	|	Goods.Count,
	|	Goods.Sum,
	|	Goods.AmountIncludingVAT,
	|	Goods.VATAmount
	|FROM
	|	Document.SaleAdjustment.Goods AS Goods
	|		INNER JOIN CorrectedDocument AS CorrectedDocument
	|		ON Goods.Ref = CorrectedDocument.Ref
	|			AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|				OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|				OR &ImplementationOfServices)
	|
	|UNION ALL
	|
	|SELECT
	|	ProductsForBalanceEntryAdjustments.Products,
	|	ProductsForBalanceEntryAdjustments.Products.Description,
	|	ProductsForBalanceEntryAdjustments.VATRate,
	|	ProductsForBalanceEntryAdjustments.Count,
	|	ProductsForBalanceEntryAdjustments.Sum,
	|	ProductsForBalanceEntryAdjustments.AmountIncludingVAT,
	|	ProductsForBalanceEntryAdjustments.VATAmount
	|FROM
	|	CorrectedDocument AS CorrectedDocument
	|		INNER JOIN ProductsForBalanceEntryAdjustments AS ProductsForBalanceEntryAdjustments
	|		ON (ProductsForBalanceEntryAdjustments.Ref = CorrectedDocument.Ref
	|					AND ProductsForBalanceEntryAdjustments.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|				OR ProductsForBalanceEntryAdjustments.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PreFixServicesDeployed.Products,
	|	PreFixServicesDeployed.Content,
	|	PreFixServicesDeployed.VATRate,
	|	SUM(PreFixServicesDeployed.Count) AS Count,
	|	SUM(PreFixServicesDeployed.Sum) AS Sum,
	|	SUM(PreFixServicesDeployed.AmountIncludingVAT) AS AmountIncludingVAT,
	|	SUM(PreFixServicesDeployed.VATAmount) AS VATAmount
	|INTO PreFixServices
	|FROM
	|	PreFixServicesDeployed AS PreFixServicesDeployed
	|
	|GROUP BY
	|	PreFixServicesDeployed.Products,
	|	PreFixServicesDeployed.Content,
	|	PreFixServicesDeployed.VATRate
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products,
	|	Goods.Content,
	|	Goods.VATRate AS VATRate,
	|	SUM(Goods.Count) AS Count,
	|	SUM(Goods.Sum) AS Sum,
	|	SUM(Goods.VATAmount) AS VATAmount,
	|	SUM(Goods.AmountIncludingVAT) AS AmountIncludingVAT
	|INTO FinalServices
	|FROM
	|	Document.SaleAdjustment.Goods AS Goods
	|WHERE
	|	Goods.Ref = &Ref
	|	AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|		OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|		OR &ImplementationOfServices)
	|
	|GROUP BY
	|	Goods.Products,
	|	Goods.Content,
	|	Goods.VATRate";
	
	// The resulting tabular part of the Service
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	T.Products,
	|	T.Content,
	|	T.VATRate,
	|	MAX(T.NumberOfDocumentsToBeCorrected__) AS NumberOfDocumentsToBeCorrected__,
	|	MAX(T.ServicesOfDocumentBeingCorrected_Amount) AS ServicesOfDocumentBeingCorrected_Amount,
	|	MAX(T.ServicesOfDocumentBeingCorrected_AmountOfVAT) AS ServicesOfDocumentBeingCorrected_AmountOfVAT,
	|	MAX(T.CorrectionalDocumentServices_Number) AS CorrectionalDocumentServices_Number,
	|	MAX(T.CorrectionalDocumentServices_Amount) AS CorrectionalDocumentServices_Amount,
	|	MAX(T.CorrectiveDocumentServices_AmountOfVAT) AS CorrectiveDocumentServices_AmountOfVAT,
	|	MAX(T.CorrectionalDocumentServices_AmountWithVAT) AS CorrectionalDocumentServices_AmountWithVAT,
	|	MAX(T.DocumentServicesBeforeAdjustment_Quantity) AS DocumentServicesBeforeAdjustment_Quantity,
	|	MAX(T.DocumentSizeBeforeAdjustment_Amount) AS DocumentSizeBeforeAdjustment_Amount,
	|	MAX(T.DocumentServicesBeforeAdjustment_VATAmount) AS DocumentServicesBeforeAdjustment_VATAmount
	|INTO ResultOfComparisonOfTimeServices
	|FROM
	|	(SELECT
	|		ServicesOfCorrectedDocument.Products AS Products,
	|		ServicesOfCorrectedDocument.Content AS Content,
	|		ServicesOfCorrectedDocument.VATRate AS VATRate,
	|		NULL AS NumberOfDocumentsToBeCorrected__,
	|		NULL AS ServicesOfDocumentBeingCorrected_Amount,
	|		NULL AS ServicesOfDocumentBeingCorrected_AmountOfVAT,
	|		ServicesOfCorrectedDocument.Count AS CorrectionalDocumentServices_Number,
	|		ServicesOfCorrectedDocument.Sum AS CorrectionalDocumentServices_Amount,
	|		ServicesOfCorrectedDocument.AmountIncludingVAT AS CorrectionalDocumentServices_AmountWithVAT,
	|		ServicesOfCorrectedDocument.VATAmount AS CorrectiveDocumentServices_AmountOfVAT,
	|		NULL AS DocumentServicesBeforeAdjustment_Quantity,
	|		NULL AS DocumentSizeBeforeAdjustment_Amount,
	|		NULL AS DocumentServicesBeforeAdjustment_VATAmount
	|	FROM
	|		FinalServices AS ServicesOfCorrectedDocument
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		CorrectionalDocumentServices.Products,
	|		CorrectionalDocumentServices.Content,
	|		CorrectionalDocumentServices.VATRate,
	|		CorrectionalDocumentServices.Count,
	|		CorrectionalDocumentServices.Sum,
	|		CorrectionalDocumentServices.VATAmount,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL
	|	FROM
	|		PreFixServices AS CorrectionalDocumentServices
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		DocumentServicesBeforeAdjustments.Products,
	|		DocumentServicesBeforeAdjustments.Content,
	|		DocumentServicesBeforeAdjustments.VATRate,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		DocumentServicesBeforeAdjustments.Count,
	|		DocumentServicesBeforeAdjustments.Sum,
	|		DocumentServicesBeforeAdjustments.VATAmount
	|	FROM
	|		ServicesBeforeAdjustment AS DocumentServicesBeforeAdjustments) AS T
	|
	|GROUP BY
	|	T.Products,
	|	T.Content,
	|	T.VATRate
	|;
	|
	|SELECT
	|	Products,
	|	Content,
	|	VATRate,
	|	DocumentServicesBeforeAdjustment_Quantity AS QuantityBeforeAdjustment,
	|	DocumentSizeBeforeAdjustment_Amount AS AmountBeforeAdjustment,
	|	DocumentServicesBeforeAdjustment_VATAmount AS AmountOfVATBeforeAdjustment,
	|	NumberOfDocumentsToBeCorrected__ AS QuantityBeforeChange_,
	|	ServicesOfDocumentBeingCorrected_Amount AS AmountBeforeChange,
	|	ServicesOfDocumentBeingCorrected_AmountOfVAT AS VATAmountBeforeChange,
	|	CorrectionalDocumentServices_AmountWithVAT AS AmountIncludingVAT,
	|	CorrectionalDocumentServices_Number AS Count,
	|	CorrectionalDocumentServices_Amount AS Sum,
	|	CorrectiveDocumentServices_AmountOfVAT AS VATAmount,
	|	CASE
	|		WHEN ServicesOfDocumentBeingCorrected_Amount IS NULL 
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS ThereAreImplementationsInDocument
	|INTO ResultOfServiceComparison
	|FROM
	|	ResultOfComparisonOfTimeServices AS ResultOfComparisonOfTimeServices
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	MappingResult.Products,
	|	MappingResult.Content,
	|	MappingResult.Content AS ContentBeforeChange,
	|	MappingResult.VATRate,
	|	MappingResult.VATRate AS VATRateBeforeChange,
	|	MappingResult.QuantityBeforeAdjustment,
	|	MappingResult.QuantityBeforeChange_,
	|	MappingResult.Count,
	|	MappingResult.AmountBeforeAdjustment,
	|	MappingResult.AmountBeforeChange,
	|	MappingResult.Sum AS Sum,
	|	MappingResult.AmountOfVATBeforeAdjustment,
	|	MappingResult.VATAmountBeforeChange,
	|	MappingResult.VATAmount AS VATAmount,
	|	MappingResult.Products.Principal 	AS PrincipalLink,
	|	CASE WHEN 
	|		MappingResult.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByCompanyOnAgencyBasis)
	|		OR MappingResult.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByPartner) THEN
	|			""Agency""
	|		ELSE ""Own""
	|	END AS ServiceType,
	|	CASE
	|		WHEN ISNULL(MappingResult.QuantityBeforeAdjustment, 0) = 0
	|			THEN 0
	|		ELSE CAST(MappingResult.AmountBeforeAdjustment / MappingResult.QuantityBeforeAdjustment AS NUMBER(31, 2))
	|	END AS PriceBeforeAdjustment,
	|	CASE
	|		WHEN ISNULL(MappingResult.QuantityBeforeChange_, 0) = 0
	|			THEN 0
	|		ELSE CAST(MappingResult.AmountBeforeChange / MappingResult.QuantityBeforeChange_ AS NUMBER(31, 2))
	|	END AS PriceBeforeChange,
	|	CASE
	|		WHEN ISNULL(MappingResult.Count, 0) = 0
	|			THEN 0
	|		ELSE CAST(MappingResult.Sum / MappingResult.Count AS NUMBER(31, 2))
	|	END AS Price,
	|	ISNULL(LineNumbers.LineNumber, 0) AS DocumentRowNumber,
	|	MappingResult.ThereAreImplementationsInDocument
	|FROM
	|	ResultOfServiceComparison AS MappingResult
	|		LEFT JOIN LineNumbers AS LineNumbers
	|		ON MappingResult.Products = LineNumbers.Products
	|			AND MappingResult.Content = LineNumbers.Content
	|
	|ORDER BY
	|	MappingResult.ThereAreImplementationsInDocument DESC,
	|	ISNULL(LineNumbers.LineNumber, 0)";
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		TextOfCCDRequestBeforeChange = "MappingResult.CCDNumber AS CCDNumberBeforeChange";
		TextOfRPTRequestBeforeChange = "MappingResult.QuantityByRNPTBeforeChange AS NumberOfRNPTBeforeChange";
		TextOfRPTRequestBeforeCorrection = "MappingResult.RnptQuantityBeforeAdjustment AS NumberOfRNPTBeforeAdjustment";
	Else
		TextOfCCDRequestBeforeChange = "MappingResult.CCDNumber.Code AS CCDNumberBeforeChange,
		|	MappingResult.CCDNumber.OriginCountry AS CountryOfOriginBeforeChange";
		TextOfRPTRequestBeforeChange = "UNDEFINED AS NumberOfRNPTBeforeChange";
		TextOfRPTRequestBeforeCorrection = "UNDEFINED AS NumberOfRNPTBeforeAdjustment";
	EndIf;
	QueryText = StrReplace(QueryText, "&TextOfCCDRequestBeforeChange", TextOfCCDRequestBeforeChange);
	QueryText = StrReplace(QueryText, "&TextOfRPTRequestBeforeChange", TextOfRPTRequestBeforeChange);
	QueryText = StrReplace(QueryText, "&TextOfRPTRequestBeforeCorrection", TextOfRPTRequestBeforeCorrection);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
	GetTextOfCharacteristicsRequest(ExchangeComponents, "MappingResult"));
	
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
	GetSeriesRequestText(ExchangeComponents, "MappingResult"));
	
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
	GetPackagingRequestText(ExchangeComponents, "MappingResult", False));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
	GetTextOfCCDRequest(ExchangeComponents, "MappingResult"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
	GetTextOfRNPTRequest(ExchangeComponents, "MappingResult"));
	
	Query = New Query(QueryText);
	Query.SetParameter("DocumentBasis", IBData.DocumentBasis);
	Query.SetParameter("PointInTime", IBData.PointInTime());  
	ReflectionOptions = New ValueList;
	ReflectionOptions.Add(Enums.CreditNoteRecordingOptions.IncreaseSaleIncludeDuringPhysicalInventoryCount); 
	ReflectionOptions.Add(Enums.CreditNoteRecordingOptions.IncreaseSaleReduceWarehouseStock);
	ReflectionOptions.Add(Enums.CreditNoteRecordingOptions.IncreaseSale);
	Query.SetParameter("ReflectionOptions", ReflectionOptions);
	Query.SetParameter("ImplementationOfServices", 
	TypeOf(IBData.DocumentBasis) = Type("DocumentRef.CustomerInvoiceServices")
	Or TypeOf(IBData.DocumentBasis) = Type("DocumentRef.CustomerInvoiceServicesAndAssets"));
	Query.SetParameter("EmptyItemList", Catalogs.Products.EmptyRef());
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("PriceIncludesVAT", IBData.PriceIncludesVAT);
	If TypeOf(IBData.DocumentBasis) = Type("DocumentRef.CustomerInvoice") Then
		ToReturnReusablePackage =  IBData.DocumentBasis.ToReturnReusablePackage
	Else	
		ToReturnReusablePackage = False;
	EndIf;
	Query.SetParameter("ToReturnReusablePackage", ToReturnReusablePackage);
	
	InternationalVersion = True;
	Query.SetParameter("InternationalVersion", InternationalVersion);
	
	QueryResults = Query.ExecuteBatch();
	
	InvoiceDocumentRef = Undefined;
	DataSelection = QueryResults[4].Select(); 
	If DataSelection.Next() Then
		TypeOfPrimaryAdjustment = DataSelection.AdjustmentKind; 
	Else TypeOfPrimaryAdjustment = Undefined;
	EndIf;
	StructureKeyProperties = New Structure("Date, Number, Ref, Organization");  
	If (IBData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentUnderApprovalOfParties 
		And TypeOfPrimaryAdjustment = Undefined) Or  TypeOfPrimaryAdjustment = Enums.BusinessTransactions.ErrorCorrection Then
		InvoiceDocumentRef = IBData.DocumentBasis;
		If ValueIsFilled(IBData.DocumentBasis) Then
			TheseGrounds = Common.ObjectAttributesValues(IBData.DocumentBasis, "Date, Number, Organization");
			FillPropertyValues(StructureKeyProperties, TheseGrounds); 
		EndIf;
		StructureKeyProperties.Ref = InvoiceDocumentRef;
	ElsIf  DataSelection.Count() > 0 Then // Type of correction Error correction
		InvoiceDocumentRef = DataSelection.Ref;
		FillPropertyValues(StructureKeyProperties, DataSelection);
	EndIf;
	
	If ValueIsFilled(InvoiceDocumentRef) Then
		
		RefType = TypeOf(InvoiceDocumentRef);
		OCRName = "";
		If RefType = Type("DocumentRef.ReturnOfGoodsFromCustomer") Then
			OCRName = "Document_ReturnOfGoodsFromCustomer_Sending";
		ElsIf RefType = Type("DocumentRef.ReturnOfGoodsToVendor") Then
			OCRName = "Document_ReturnOfGoodsToSupplier_Sending";
		ElsIf RefType = Type("DocumentRef.CustomerInvoice") Then 
			OCRName = "Document_SaleOfGoodsAndServices_Shipment";
			If ConsignmentSalesAreSupported And SalesViaCommissionAgent(Common.ObjectAttributeValue(
				InvoiceDocumentRef, "BusinessOperation")) Then
				OCRName = "Document_SaleOfGoodsAndServicesFee_Shipment";
				AdditionalDataBases = Common.ObjectAttributesValues(InvoiceDocumentRef, 
				"Counterparty, BusinessOperation");
				StructureKeyProperties.Insert("Counterparty", AdditionalDataBases.Counterparty);
				StructureKeyProperties.Insert("BusinessOperation", AdditionalDataBases.BusinessOperation);
			EndIf;
		ElsIf RefType = Type("DocumentRef.ConsignmentReportFromCustomer") Then
			OCRName = "Document_CommissionAgentSReport_Sending";
		ElsIf RefType = Type("DocumentRef.ConsignmentReportToVendor") Then
			OCRName = "Document_ReportToCommittee_Sending";
		ElsIf RefType = Type("DocumentRef.SaleAdjustment")  Then
			OCRName = "Document_ImplementationAdjustment_Dispatch";
		ElsIf RefType = Type("DocumentRef.CustomerInvoiceServices") Then
			OCRName = "Document_ReportOfCompletedWorks_Sending";
		ElsIf RefType = Type("DocumentRef.CustomerInvoiceServicesAndAssets") Then
			OCRName = "Document_SaleOfServicesOtherAssets_Sending"; 
		ElsIf	RefType = Type("DocumentRef.SourceDocument")Then
			OCRName = "Document_PrimaryDocument_Sending"; 
			StructureKeyProperties = New Structure("Date, Number, Ref, Organization, IncomingDocumentDate,
			|ExternalDocumentName, IncomingDocumentNumber, Counterparty, Contract");  
			FillPropertyValues(StructureKeyProperties, InvoiceDocumentRef);
		EndIf;  
		
		If OCRName = "Document_ReportOfCompletedWorks_Sending"
			And Not PropertyOfExchangeFormat(ExchangeComponents, "Document.CustomerInvoiceServices") Then
			OCRName = "Document_ReportOfCompletedWorkRTU_Sending";
		EndIf;
		
		If OCRName <> "" Then
			XDTOData.Insert("DocumentSalesOfGoodsAndServices", New Structure("Value, OCRName", StructureKeyProperties, OCRName));
		EndIf;
	EndIf;
	
	XDTOData.Insert("OperationKind");
	XDTOData.OperationKind = ?(IBData.AdjustmentKind = Enums.BusinessTransactions.ErrorCorrection,
	"CorrectionOfErrors", "AgreedChange");
	
	If IBData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentUnderApprovalOfParties Then
		If XDTOData.Property("DocumentSalesOfGoodsAndServices") And ValueIsFilled(XDTOData.DocumentSalesOfGoodsAndServices) Then
			XDTOData.Insert("CorrectedImplementationDocument", XDTOData.DocumentSalesOfGoodsAndServices);
		EndIf;
	Else // Type of correction Error correction
		DataSelection = QueryResults[4].Select();
		If DataSelection.Next() Then
			If ValueIsFilled(DataSelection.Ref) Then
				StructureKeyProperties = New Structure("Date, Number, Ref, Organization");
				RefType = TypeOf(DataSelection.Ref);
				OCRName = "";
				If RefType = Type("DocumentRef.ReturnOfGoodsFromCustomer") Then
					OCRName = "Document_ReturnOfGoodsFromCustomer_Sending";
				ElsIf RefType = Type("DocumentRef.ReturnOfGoodsToVendor") Then
					OCRName = "Document_ReturnOfGoodsToSupplier_Sending";
				ElsIf RefType = Type("DocumentRef.CustomerInvoice") Then
					OCRName = "Document_SaleOfGoodsAndServices_Shipment"; 
					If ConsignmentSalesAreSupported And SalesViaCommissionAgent(Common.ObjectAttributeValue(
						DataSelection.Ref, "BusinessOperation")) Then
						OCRName = "Document_SaleOfGoodsAndServicesFee_Shipment";
						AdditionalDataBases = Common.ObjectAttributesValues(InvoiceDocumentRef, 
						"Counterparty, BusinessOperation");
						StructureKeyProperties.Insert("Counterparty", AdditionalDataBases.Counterparty);
						StructureKeyProperties.Insert("BusinessOperation", AdditionalDataBases.BusinessOperation);
					EndIf;
				ElsIf RefType = Type("DocumentRef.ConsignmentReportFromCustomer") Then
					OCRName = "Document_CommissionAgentSReport_Sending";
				ElsIf RefType = Type("DocumentRef.ConsignmentReportToVendor") Then
					OCRName = "Document_ReportToCommittee_Sending";
				ElsIf RefType = Type("DocumentRef.SaleAdjustment")Then 
					OCRName = "Document_ImplementationAdjustment_Dispatch";  
				ElsIf	RefType = Type("DocumentRef.SourceDocument")Then
					OCRName = "Document_PrimaryDocument_Sending"; 
					StructureKeyProperties = New Structure("Date, Number, Ref, Organization, IncomingDocumentDate,
					|ExternalDocumentName, IncomingDocumentNumber, Counterparty, Contract");  
					FillPropertyValues(StructureKeyProperties, InvoiceDocumentRef);
				ElsIf RefType = Type("DocumentRef.CustomerInvoiceServices") Then
					OCRName = "Document_ReportOfCompletedWorks_Sending";
				ElsIf RefType = Type("DocumentRef.CustomerInvoiceServicesAndAssets") Then
					OCRName = "Document_SaleOfServicesOtherAssets_Sending";
				EndIf;
				
				If OCRName = "Document_ReportOfCompletedWorks_Sending"
					And Not PropertyOfExchangeFormat(ExchangeComponents, "Document.CustomerInvoiceServices") Then
					OCRName = "Document_ReportOfCompletedWorkRTU_Sending";
				EndIf;
				
				If OCRName <> "" Then
					FillPropertyValues(StructureKeyProperties, DataSelection);
					XDTOData.Insert("CorrectedImplementationDocument", New Structure("Value, OCRName", StructureKeyProperties, OCRName));
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	LastItemNumber = QueryResults.Count() - 1;
	GoodsTable = QueryResults[24].Unload();
	TableServices = QueryResults[LastItemNumber].Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsTable, True, True);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	// the amount of the document.
	DocumentAmount = 0;
	DocumentAmount = DocumentAmount + GoodsTable.Total("Sum");
	DocumentAmount = DocumentAmount + TableServices.Total("Sum");
	If Not IBData.PriceIncludesVAT Then
		DocumentAmount = DocumentAmount + GoodsTable.Total("VATAmount");
		DocumentAmount = DocumentAmount + TableServices.Total("VATAmount");
	EndIf;
	If DocumentAmount = 0 Then
		DocumentAmount = -1;
	EndIf;
	XDTOData.Insert("Sum", DocumentAmount);
	
	TableOfServicesForPrincipal(ExchangeComponents, TableServices);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		RedefineVATRateForOldFormats(GoodsTable, False);
		RedefineVATRateForOldFormats(TableServices, False);
	EndIf;
	XDTOData.Insert("Goods", GoodsTable);
	XDTOData.Insert("Services", TableServices);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty = IBData.Counterparty;
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.ARAPCurrency = IBData.ARAPCurrency;
		DefaultParameters.TypeOfAgreement = "WithCustomer";
		DefaultParameters.Date = IBData.Date;
		DefaultParameters.Number = IBData.Number;
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = (IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> IBData.ARAPCurrency);
		EndIf;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		Selection = QueryResults[0].Select();
		SalesOrder = ?(Selection.Next(), Selection.Ref, Undefined);
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", SalesOrder, IBData.Terms, IBData.SalesOpportunity);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
	EndIf;
	
	If ValueIsFilled(IBData.CompanyBankAccount)
		And IBData.CompanyBankAccount.Owner <> IBData.Organization Then
		XDTOData.Insert("CompanyBankAccount", Undefined);
	EndIf;
	//ProductBatchID information   
	
	If ConsignmentSalesAreSupported Then 
		
		If TypeOf(IBData.DocumentBasis) = Type("DocumentRef.CustomerInvoice") 
			And SalesViaCommissionAgent(Common.ObjectAttributeValue(
			IBData.DocumentBasis, "BusinessOperation")) Then
			
			XDTOData.Insert("ContractOfBuyerOfCommissionGoods", IBData.CustomerContract);
			XDTOData.Insert("ConsignedGoodsCustomer", IBData.CustomerCounterparty);	
			
		EndIf;
		
	EndIf;
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy, True);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
EndProcedure

