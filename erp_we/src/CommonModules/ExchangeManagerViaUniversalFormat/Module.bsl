Procedure PCO_Document_SBDSOtherWriteOff_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	// Clarifying the type of operation
	
	Account_Settlement = Undefined;
	If XDTOData.ARAPDetails.Columns.Find("Account_Settlement") <> Undefined Then
		Account_Settlement = XDTOData.ARAPDetails[0].Account_Settlement;
	EndIf;
	If ValueIsFilled(Account_Settlement) Then
		If Find(Account_Settlement, "57.01") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.WithdrawalFromBankAccount;
		EndIf;
	EndIf;
	
	If XDTOData.Property("IncomeKindCode") 
		And ValueIsFilled(XDTOData.IncomeKindCode) Then
		ReceivedData.AdditionalProperties.Insert("IncomeKindCode",
			XDTOData.IncomeKindCode);
	EndIf;
	
	// CFItem
	If  XDTOData.ARAPDetails.Count() > 0 Then
		FillingRules = New Map;
		FillingRules.Insert("Sum", "Sum");
		FillingRules.Insert("CFItem", "CashFlowItem");
		ArrayOfStringsDecryption = New Array;
		For Each String In XDTOData.ARAPDetails Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			ArrayOfStringsDecryption.Add(StringDataStructure);
		EndDo;
		ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfStringsDecryption);
		
		If XDTOData.ARAPDetails.Count() = 1 Then
			ReceivedData.AdditionalProperties.Insert("CashFlowItem",
				XDTOData.ARAPDetails[0].CFItem);
		EndIf;
	EndIf;
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
EndProcedure
Procedure PCO_Document_SBDSOtherWriteOff_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	ConvertNumberToFormat12(ReceivedData, IBData);
	
	If IBData <> Undefined Then
		If IBData.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder 
			And ReceivedData.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue Then
			ReceivedData = Undefined;
			Return;
		EndIf;
		If IBData.BusinessOperation = Enums.BusinessTransactions.DeletePaymentToSelfEmployedPerson Then
		     ReceivedData.BusinessOperation = IBData.BusinessOperation;
		EndIf;
	EndIf;
	
	BeforeMerzhevanii_SBDS(ReceivedData, IBData, ExchangeComponents);
	Merzhevanie_SBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents);
	AfterMerzhevaniya_SBDS(ReceivedData, IBData, ExchangeComponents);
	
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
EndProcedure

