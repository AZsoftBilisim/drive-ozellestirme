	#Region Goods
	
	QueryText = 
		"SELECT
		|	OrderToMoveGoods.LineNumber AS DocumentRowNumber,
		|	OrderToMoveGoods.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	OrderToMoveGoods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	OrderToMoveGoods.Count AS Count,
		|	OrderToMoveGoods.Canceled AS Canceled
