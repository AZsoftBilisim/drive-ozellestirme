Procedure OCR_Document_PSRefund_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.Text = "SELECT
	               |	ISNULL(GiftCertificates.Code, """") AS SerialNumber,
	               |	ISNULL(GiftCertificates.Barcode, """") AS Barcode,
	               |	ISNULL(GiftCertificates.MagneticCode, """") AS MagneticCode,
	               |	ISNULL(GiftCertificates.Owner, VALUE(Catalog.GiftCertificateKinds.EmptyRef)) AS TypeOfGiftCertificateLink,
	               |	ReturnOfGiftCardsGiftCertificates.Sum AS Sum
	               |FROM
	               |	Document.ReturnOfGiftCards.GiftCertificates AS ReturnOfGiftCardsGiftCertificates
	               |		LEFT JOIN Catalog.GiftCertificates AS GiftCertificates
	               |		ON ReturnOfGiftCardsGiftCertificates.GiftCertificate = GiftCertificates.Ref
	               |WHERE
	               |	ReturnOfGiftCardsGiftCertificates.Ref = &Ref
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |SELECT
	               |	ISNULL(RetailSalesReport.Ref, VALUE(Document.RetailSalesReport.EmptyRef)) AS Ref
	               |FROM
	               |	Document.ReturnOfGiftCards AS ReturnOfGiftCards
	               |		INNER JOIN Document.RetailSalesReport AS RetailSalesReport
	               |		ON ReturnOfGiftCards.CashRegisterShift = RetailSalesReport.CashRegisterShift
	               |WHERE
	               |	ReturnOfGiftCards.Ref = &Ref
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |SELECT
	               |	ISNULL(CashRegisters.Warehouse, VALUE(Catalog.Warehouses.EmptyRef)) AS Warehouse
	               |FROM
	               |	Document.ReturnOfGiftCards AS ReturnOfGiftCards
	               |		LEFT JOIN Catalog.CashRegisters AS CashRegisters
	               |		ON ReturnOfGiftCards.CashRegister = CashRegisters.Ref
	               |WHERE
	               |	ReturnOfGiftCards.Ref = &Ref
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |SELECT
	               |	SUM(PaymentWithPaymentCards.Sum) AS PayAmount,
	               |	CASE
	               |		WHEN (CAST(PaymentWithPaymentCards.PaymentCardNumber AS STRING(22))) <> """"
	               |			THEN PaymentWithPaymentCards.PaymentCardNumber
	               |		ELSE ""00""
	               |	END AS CardNumber,
				   |	PaymentWithPaymentCards.PaymentKind_ AS TypesOfCashRegisterPaymentSystem,
	               |	ISNULL(POSTerminals.Owner.BankAccount, VALUE(Catalog.CompaniesBankAccounts.EmptyRef)) AS CompanyBankAccount,
	               |	ISNULL(POSTerminals.Owner.Counterparty, VALUE(Catalog.Counterparties.EmptyRef)) AS Acquirer,
	               |	ISNULL(POSTerminals.Code, """") AS Number,
	               |	ISNULL(POSTerminals.Ref, VALUE(Catalog.POSTerminals.EmptyRef)) AS POSTerminal
	               |FROM
	               |	Document.ReturnOfGiftCards.PaymentWithPaymentCards AS PaymentWithPaymentCards
	               |		LEFT JOIN Catalog.POSTerminals AS POSTerminals
	               |		ON PaymentWithPaymentCards.POSTerminal = POSTerminals.Ref
	               |WHERE
	               |	PaymentWithPaymentCards.Ref = &Ref
	               |
	               |GROUP BY
	               |	PaymentWithPaymentCards.POSTerminal,
	               |	PaymentWithPaymentCards.PaymentCardNumber,
	               |	PaymentWithPaymentCards.PaymentKind_,
	               |	ISNULL(POSTerminals.Owner.BankAccount, VALUE(Catalog.CompaniesBankAccounts.EmptyRef)),
	               |	ISNULL(POSTerminals.Owner.Counterparty, VALUE(Catalog.Counterparties.EmptyRef)),
	               |	ISNULL(POSTerminals.Code, """"),
	               |	ISNULL(POSTerminals.Ref, VALUE(Catalog.POSTerminals.EmptyRef))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |SELECT
	               |	ReturnOfGiftCards.GiftCertificateSale.Ref AS Ref,
	               |	ReturnOfGiftCards.GiftCertificateSale.Date AS Date,
	               |	ReturnOfGiftCards.GiftCertificateSale.Number AS Number,
	               |	ReturnOfGiftCards.GiftCertificateSale.Organization AS Organization
	               |FROM
	               |	Document.ReturnOfGiftCards AS ReturnOfGiftCards
	               |WHERE
	               |	ReturnOfGiftCards.Ref = &Ref";
	
	Query.SetParameter("Ref", IBData.Ref);
	QueryResult = Query.ExecuteBatch();
	
	GiftCertificates = QueryResult[0].Unload();
	GiftCertificates.Columns.Add("GiftCertificateKind");
	For Each LF In GiftCertificates Do
		LF.GiftCertificateKind = New Structure("Value, OCRName",
			LF.TypeOfGiftCertificateLink, "Catalog_GiftCertificateKinds");
	EndDo;
	XDTOData.Insert("GiftCertificates", GiftCertificates);
	
	//The retail sales report within which the operation was carried out is determined
	Instruction = New Structure();
	Instruction.Insert("OCRName", "Document_RetailSalesReport__");
	
	Selection = QueryResult[1].Select();
	If Selection.Next() Then
		Instruction.Insert("Value", Selection.Ref);
	    XDTOData.Insert("RetailSalesReport", Instruction);
	EndIf;
	
	//The document warehouse is determined
	Selection = QueryResult[2].Select();
	If Selection.Next() Then
		WarehouseForUnloading = Selection.Warehouse;
	Else
		WarehouseForUnloading = Catalogs.Warehouses.EmptyRef();
	EndIf;
	WarehouseInstructions = New Structure();
	WarehouseInstructions.Insert("OCRName", "Catalog_Warehouses_Send");
	WarehouseInstructions.Insert("Value", WarehouseForUnloading(WarehouseForUnloading, ExchangeComponents.ConversionParameters_SSLy, True));
	XDTOData.Insert("Warehouse", WarehouseInstructions);
	
	//Information about card payments is being prepared
	TABCardPayment = QueryResult[3].Unload();
	TABCardPayment.Columns.Add("AcquiringContract");
	
	AcquirerSIndex = TABCardPayment.Indexes.Add("Acquirer");
	//The parameters of the virtual contract are determined
	DefaultParameters = New Structure(ContractFixedKeyStructure());
	DefaultParameters.Organization              = IBData.Organization;
	DefaultParameters.ARAPCurrency     = LocalAccountingCurrency(IBData.Organization);
	DefaultParameters.CalculationsInConventionalUnits = False;
	DefaultParameters.TypeOfAgreement              = "Other"; 
	
	AcquiringContract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents);
	For Each String In TABCardPayment Do
	 
		DefaultParameters.Counterparty               = String.Acquirer;
		//We form the instructions for unloading the acquiring terminal   
		If Not AcquiringContract = Undefined Then
		     String.AcquiringContract = AcquiringContract;
		EndIf;
		If ValueIsFilled(String.AcquiringContract) Then
		   	CatPOSTerminal = String.POSTerminal;
		   	If ValueIsFilled(CatPOSTerminal) Then
				Instruction = New Structure();
				Instruction.Insert("Value", String.POSTerminal);
				Instruction.Insert("OCRName",   "Catalog_POSTerminals_Send");
				String.POSTerminal = Instruction;
			EndIf;	
		EndIf;
	    
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17")
			And String.TypesOfCashRegisterPaymentSystem = Enums.TypesOfCashRegisterPaymentSystem.PaymentCard Then
			String.TypesOfCashRegisterPaymentSystem = Enums.TypesOfCashRegisterPaymentSystem.EmptyRef();
		EndIf;
	EndDo;
	
	XDTOData.Insert("PaymentWithPaymentCards", TABCardPayment);
EndProcedure


