Procedure LoadingAdditionalDetails_DefineNameOfICO(PropertyValue, OCRName, PropertyValueType1)
	PropertyValueType1 = PropertyValue.ValueType;
	
	If Find(PropertyValueType1, "НоменклатураГруппа")>0 Then //@NON-NLS-1
	
		OCRName = "Catalog_ProductsGroup";
		PropertyValueType1 = Type("CatalogRef.Products");
		
	ElsIf Find(PropertyValueType1, "Номенклатура")>0 Then //@NON-NLS-1
		
		OCRName = "Catalog_Products_Receive";
		PropertyValueType1 = Type("CatalogRef.Products");
		
	ElsIf Find(PropertyValueType1, "КонтрагентГруппа")>0 Then //@NON-NLS-1
		
		Return;
		
	ElsIf Find(PropertyValueType1, "Контрагент")>0 Then //@NON-NLS-1
		
		OCRName = "Catalog_Counterparties_Receive";
		PropertyValueType1 = Type("CatalogRef.Counterparties");
		
	ElsIf Find(PropertyValueType1, "ЗначенияДополнительныхРеквизитов")>0 Then //@NON-NLS-1
		
		OCRName = "Catalog_AdditionalAttributesValues";
		PropertyValueType1 = Type("CatalogRef.ObjectsPropertiesValues");
		
	ElsIf Find(PropertyValueType1, "Банк")>0 Then //@NON-NLS-1
		
		OCRName = "Catalog_Banks";
		PropertyValueType1 = Type("CatalogRef.BankClassifier");
		
	ElsIf Find(PropertyValueType1, "Валюта")>0 Then //@NON-NLS-1
		
		If TypeOf(PropertyValue) = Type("Structure")
			And PropertyValue.Property("Ref") = False Then
			OCRName = "Catalog___FromStructure";
		Else
			OCRName = "Catalog_Currencies";
		EndIf;
		PropertyValueType1 = Type("CatalogRef.Currencies");
		
	ElsIf Find(PropertyValueType1, "Договор")>0 Then //@NON-NLS-1
		
		If TypeOf(PropertyValue) = Type("Structure")
			And PropertyValue.Property("Ref") = False Then
			OCRName = "Catalog_ContractsOfCounterparties_FromStructure__";
		Else
			OCRName = "Catalog_CounterpartyContracts_Receive";
		EndIf;
		PropertyValueType1 = Type("CatalogRef.CounterpartyContracts");
	
	ElsIf Find(PropertyValueType1, "ЕдиницаИзмерения")>0 Then //@NON-NLS-1
	
		OCRName = "Catalog_UnitsOfMeasurement";
		PropertyValueType1 = Type("CatalogRef.PackagesAndUnitsOfMeasure");
	
	ElsIf Find(PropertyValueType1, "Организация")>0 Then //@NON-NLS-1
	
		OCRName = "Catalog_Companies_Receive";
