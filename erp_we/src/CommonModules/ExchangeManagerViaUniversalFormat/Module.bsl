Procedure OCR_Document_IncomeAdjustment_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
		
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_IncomeAdjustment_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_IncomeAdjustment_Sending", 
										"Goods", 
										"CCDNumberBeforeChange",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_IncomeAdjustment_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending"); 
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_IncomeAdjustment_Sending", 
										"Goods", 
										"VATRateBeforeChange",
										True,
										"CatalogLink_BIDS_Sending"); 
	
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_IncomeAdjustment_Sending", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_IncomeAdjustment_Sending", 
										"Services", 
										"VATRateBeforeChange",
										True,
										"CatalogLink_BIDS_Sending");
						
	EndIf;
	// Warehouse
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy, True);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	If Not IBData.Warehouse.IsFolder Then
		UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	EndIf;
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	If IBData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentUnderApprovalOfParties Then
		XDTOData.Insert("OperationKind", "AgreedChange");
	Else
		XDTOData.Insert("OperationKind", "CorrectionOfErrors");
	EndIf;
	FillInDataForAdjustingReceiptOfGoods(IBData, XDTOData, ExchangeComponents);
EndProcedure

