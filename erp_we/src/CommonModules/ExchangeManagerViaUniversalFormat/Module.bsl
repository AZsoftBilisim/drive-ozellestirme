Procedure PCO_Document_MovementOfGoods_inProduction_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "T";
	DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	
