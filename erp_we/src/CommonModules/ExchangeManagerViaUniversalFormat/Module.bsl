	WriteLogEvent(EventLogMessageKey,
		EventLogLevel.Warning,
		MetadataObject,
		ObjectToProcess,
		WarningText);
EndProcedure
// Parameters:
//  ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//  IBData - AnyRef - the object of the information base.
//  XDTOData - Structure - The structure in which the properties of the received conversion object are transmitted.
//
Function ConvertNumberToFormat11(ExchangeComponents, IBData, XDTOData)
	OnlyKeyProperties = Undefined;
	If Type("DocumentObject.BankAccountIssue") = TypeOf(IBData) Then
		
		OnlyKeyProperties = False;
		
	ElsIf Type("DocumentRef.BankAccountIssue") = TypeOf(IBData) Then
		
		OnlyKeyProperties = True;
		
	Else
		
		Return False;
		
	EndIf;
	
	If StrLen(TrimAll(IBData.Number)) < 12
		Or Not XDTOData.Property("KeyProperties") Then
		
		Return False;
		
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
		
		XDTOData.KeyProperties.Insert("ExtendedNumber", IBData.Number);
		
	EndIf;
	
	If OnlyKeyProperties Then
		
		SubstringsOfNumber = StrSplit(XDTOData.Number, "-");
		
	Else
		
		SubstringsOfNumber = StrSplit(XDTOData.KeyProperties.Number, "-");
		
	EndIf;
	
	If SubstringsOfNumber.Count() = 2
		And StrLen(TrimAll(SubstringsOfNumber[1])) = 7 Then
		
		ProcessedNumber = "";
		If Left(SubstringsOfNumber[1], 1) = "P" Then
			
			SubstringsOfNumber[1] = "P" + Right(TrimAll(SubstringsOfNumber[1]),5);
			ProcessedNumber = StrConcat(SubstringsOfNumber, "-");
			
		Else
			
			If XDTOData.KeyProperties.Property("Number") Then
				ProcessedNumber = Left(XDTOData.KeyProperties.Number, 5) + Right(XDTOData.KeyProperties.Number, 6);
			Else 	
				ProcessedNumber = "000000";
			EndIf;
			
		EndIf;
		
		If OnlyKeyProperties Then
			
			XDTOData.Number = ProcessedNumber;
			
		Else
			If XDTOData.KeyProperties.Property("Number") Then
				XDTOData.KeyProperties.Number = ProcessedNumber;
			EndIf;
		EndIf;
		
	Else
		
		NumberCurrent = "";
		If OnlyKeyProperties Then
			
			NumberCurrent = XDTOData.Number;
			
		Else
			If XDTOData.KeyProperties.Property("Number") Then
				NumberCurrent = XDTOData.KeyProperties.Number;  
			Else
				NumberCurrent = "";
			EndIf;                                           
	
		EndIf;
		
		// The algorithm for uploading an arbitrary number of 12 characters: 
		// - we are looking for the first digit, if this digit is 0, then we cut it off and send the remaining 11 characters. 
		//   If the first digit found was not 0 or there were no digits at all,
		//   then we take 11 characters from the right (we sacrifice the potential prefix symbol)
		NumberConverted = False;
		For CharacterCount = 0 To 11 Do
			
			NumberSymbol = Mid(NumberCurrent, CharacterCount, 1);
			If StrFind("0123456789", NumberSymbol) > 0 Then
				
				If NumberSymbol = "0" Then
					
					NumberPart1 = Left(NumberCurrent, CharacterCount - 1); 
					NumberPart2 = Mid(NumberCurrent, CharacterCount + 1);
					NumberCurrent = NumberPart1 + NumberPart2;
					NumberConverted = True;
					
				EndIf;
				
				Break;
				
			EndIf;
			
		EndDo;
		
		If OnlyKeyProperties Then
			
			XDTOData.Number = ?(NumberConverted, NumberCurrent, Right(TrimAll(XDTOData.Number), 11));
			
		Else
			If XDTOData.KeyProperties.Property("Number") Then
				XDTOData.KeyProperties.Number = ?(NumberConverted, NumberCurrent, Right(TrimAll(XDTOData.KeyProperties.Number), 11));
			EndIf;
		EndIf;
		
	EndIf;
	
	If OnlyKeyProperties
		And StrLen(XDTOData.Number) > 11 Then
		
		XDTOData.Number = Right(XDTOData.Number, 11);
		
	ElsIf Not OnlyKeyProperties
		And StrLen(XDTOData.KeyProperties.Number) > 11 And XDTOData.KeyProperties.Property("Number") Then
		XDTOData.KeyProperties.Number = Right(XDTOData.KeyProperties.Number, 11);
		
	EndIf;
	
	Return True;
EndFunction
Function ConvertNumberToFormat12(ReceivedData, IBData)
	If TypeOf(IBData) = Type("DocumentObject.BankAccountIssue") Then
		
		If ValueIsFilled(IBData.Ref) Then
			
			// we do not change the numbers in existing documents
			ReceivedData.Number = IBData.Number;
			Return True;
			
		ElsIf StrLen(IBData.Number) < 12
			Or TrimAll(ReceivedData.Number) = TrimAll(IBData.Number) Then
			
			Return False;
			
		EndIf;
		
	EndIf;
	
	SubstringsOfNumber = StrSplit(ReceivedData.Number, "-");
	If SubstringsOfNumber.Count() = 2
		And StrLen(SubstringsOfNumber[1]) > 0 Then
		
		If Left(SubstringsOfNumber[1], 1) = "P" Then
			
			SubstringsOfNumber[1] = StrReplace(SubstringsOfNumber[1], "P", "P0");
			
		Else
			
			SubstringsOfNumber[1] = "0" + SubstringsOfNumber[1];
			
		EndIf;
		
		ReceivedData.Number = StrConcat(SubstringsOfNumber, "-");
		
	EndIf;
	
	Return True;
EndFunction
