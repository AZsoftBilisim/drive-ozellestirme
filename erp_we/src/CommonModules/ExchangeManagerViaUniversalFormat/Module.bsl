Procedure PCO_Document_PBDSSettlementsWithEmployees_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If TrimAll(IBData.IncomingDocumentNumber) = "-" Then
		// The "-" symbol is put down artificially if a document with an empty number is loaded from the PSU.
		XDTOData.IncomingDocumentNumber = "";
	EndIf;
	ThisIsWE = Not GetFunctionalOption("LocalizationRFService");
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashReturnByAdvanceHolder Then
		ARAPType = "Subreport";
	Else
		ARAPType = "Loans_";
	EndIf;
	XDTOData.Insert("ARAPType", ARAPType);
	
	// Breakdown of payment
	TabRP = New ValueTable;
	TabRP.Columns.Add("CFItem");
	TabRP.Columns.Add("Sum");
	TabRP.Columns.Add("Employee");
	TabRP.Columns.Add("EmployeeSBankAccount");
	If IBData.ARAPDetails.Count() > 0 Then
		For Each TSRow In IBData.ARAPDetails Do
			LineRP = TabRP.Add();
			LineRP.Sum = TSRow.Sum;
			LineRP.CFItem = TSRow.CashFlowItem; 
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
				If ThisIsUT() Or ThisIsWE Then 
					LineRP.Employee = IBData.AdvanceHolder;
				Else
					LineRP.Employee = ?(ValueIsFilled(TSRow.EmployeeLoanAgreement.Individual), TSRow.EmployeeLoanAgreement.Individual,IBData.AdvanceHolder);
				EndIf;
				If Not ValueIsFilled(LineRP.Employee) Then
				     LineRP.Employee = Catalogs.Persons.EmptyRef();
				EndIf;
			EndIf;
		EndDo;
	Else
		LineRP = TabRP.Add();
		LineRP.Sum = IBData.DocumentAmount;
		LineRP.CFItem = IBData.CashFlowItem; 
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then  
			 LineRP.Employee = IBData.AdvanceHolder;
		EndIf;
	EndIf;
	XDTOData.Insert("ARAPDetails", TabRP);
EndProcedure

