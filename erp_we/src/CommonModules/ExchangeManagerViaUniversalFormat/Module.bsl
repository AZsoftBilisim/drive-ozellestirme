		XDTOData.KeyProperties.Insert("Ref", IBData.Ref);
	EndIf;
		
	ZoomRatio = ?(IBData.Denominator = 0, IBData.Numerator, Round(IBData.Numerator / IBData.Denominator,3));
	
	Products = Undefined;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		If ValueIsFilled(IBData.Owner) And TypeOf(IBData.Owner) = Type("CatalogRef.Products") Then
			Products = IBData.Owner;
		EndIf;
	EndIf;
	
	If ExportStack.Count() > 1 Then
		XDTOData.Insert("ZoomRatio", ZoomRatio);
		If ValueIsFilled(Products) Then
			XDTOData.Insert("Products", Products);
		EndIf;
		Return;
	EndIf;
	
	XDTOData.KeyProperties.Insert("ZoomRatio", ZoomRatio);
	If ValueIsFilled(Products) Then
		XDTOData.KeyProperties.Insert("Products", Products);
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7") Then
		If Not ValueIsFilled(IBData.Height) Then
			XDTOData.Insert("Height", -1);
		EndIf;
		If Not ValueIsFilled(IBData.Depth) Then
			XDTOData.Insert("Depth", -1);
		EndIf;
		If Not ValueIsFilled(IBData.VolumeM3) Then
			XDTOData.Insert("VolumeM3", -1);
		EndIf;
		If Not ValueIsFilled(IBData.Width) Then
			XDTOData.Insert("Width", -1);
		EndIf;
	EndIf;
EndProcedure

