	ProcessingRule.OCRUsed.Add("Catalog_CounterpartyContracts_Receive");
EndProcedure
Procedure DPR_Catalog_CounterpartyContracts_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	//If this is a Contract for connecting to the payment system, we will not ship it
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.11") Then
		If XDTOData.KeyProperties.Property("ThisIsAcquiringContract")
				And XDTOData.KeyProperties.ThisIsAcquiringContract = True Then
			ClearUsageOCR(UsageOCR);
			Return;
		EndIf;
	EndIf;
	
	// If both functional options are disabled, then it makes no sense to ship the contract.
	If Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed
		And Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed Then
	
		UsageOCR.Catalog_CounterpartyContracts_Receive = False;
		Return;
		
	EndIf;
	
	// Let's define the type of contract for checking a specific functional option.
	ContractType = Undefined;
	TypeOfAgreement = Undefined;
	
	If XDTOData.KeyProperties.Property("TypeOfAgreement") Then
		
		TypeOfAgreement = XDTOData.KeyProperties.TypeOfAgreement;
		
		If  TypeOf(TypeOfAgreement) = Type("Structure")
			And TypeOfAgreement.Property("Value") Then
		    
		    ContractType = TypeOfAgreement.Value;
		    
		EndIf;
		
	EndIf;	
	
	If Not ValueIsFilled(ContractType)
		Or (Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed
		And (ContractType = "WithCustomer"
		Or ContractType = "WithConsignee"
		Or ContractType = "WithCommissionAgentForPurchase"))
		Or (Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed
		And (ContractType = "WithVendor"
		Or ContractType = "WithConsignor"
		Or ContractType = "CustomerInvoiceOutsourcedSale"
		Or ContractType = "Other")) Then
		
		UsageOCR.Catalog_CounterpartyContracts_Receive = False;
		Return;
	
	EndIf;
	
	// Let's define the attribute of a previously created virtual contract. 
	// If the contract was created from a collection of other objects, it should not be loaded.
	AddAttributes = Undefined;
	
	If XDTOData.Property("AdditionalAttributes", AddAttributes)
		And TypeOf(AddAttributes) = Type("ValueTable") And AddAttributes.Count() > 0 Then
	
		For Each AdditionalAttribute5 In AddAttributes Do
			If AdditionalAttribute5.PropertyValue = "VirtualContract" Then
				// A virtual contract has arrived.
				UsageOCR.Catalog_CounterpartyContracts_Receive = False;
				Return;
			EndIf;
		EndDo;
	EndIf;
	
	If ContractType = "WithCustomer" And GetFunctionalOption("ToUseTermsOfSales")
		Or ContractType = "WithVendor" And GetFunctionalOption("UseTermsOfPurchases") Then
		
		// Checking the rules for creating Contracts of counterparties.
		// If the Contracts are not related to the Agreements, we will ship them
		If Not AdditionalAnalyticsForContracts(ExchangeComponents).AgreementToContract Then
			Return;
		EndIf;
			
		// If there is not a single agreement with the configuration using
		// the agreements of the contractors, then we do not upload the contract.
		Query = New Query("SELECT
			|	Terms1.Ref
			|FROM
			|	Catalog.TermsOfSale AS Terms1
			|WHERE
			|	Terms1.ContractsAreUsed
			|	AND NOT Terms1.DeletionMark
			|	AND Terms1.Counterparty IN (&Counterparties)
			|	AND Terms1.Organization IN (&Companies)
			|");
		
		If ContractType = "WithVendor" Then
			Query.Text = StrReplace(Query.Text, "TermsOfSale", "TermsOfPurchaseFromVendors");
		EndIf;
		
		If XDTOData.KeyProperties.Property("ARAPCurrency")
			And TypeOf(XDTOData.KeyProperties.ARAPCurrency) = Type("Structure")
			And XDTOData.KeyProperties.ARAPCurrency.Property("Ref")
			And TypeOf(XDTOData.KeyProperties.ARAPCurrency.Ref) = Type("Structure")
			And XDTOData.KeyProperties.ARAPCurrency.Ref.Property("Value") Then
			
			Currency = DataExchangeXDTOServer.ObjectRefByXDTODataObjectUUID(
				String(XDTOData.KeyProperties.ARAPCurrency.Ref.Value),
				Type("CatalogRef.Currencies"),
				ExchangeComponents);
			Query.Text = Query.Text + Chars.LF + " AND Terms1.Currency = &Currency";
			Query.SetParameter("Currency", Currency);
		EndIf;
		
		Counterparties = New Array;
		Counterparties.Add(DataExchangeXDTOServer.ObjectRefByXDTODataObjectUUID(
			String(XDTOData.KeyProperties.Counterparty.Ref.Value),
			Type("CatalogRef.Counterparties"),
			ExchangeComponents));
		Counterparties.Add(Catalogs.Counterparties.EmptyRef());
		Companies = New Array;
		Companies.Add(DataExchangeXDTOServer.ObjectRefByXDTODataObjectUUID(
			String(XDTOData.KeyProperties.Organization.Ref.Value),
			Type("CatalogRef.Companies"),
			ExchangeComponents));
		Companies.Add(Catalogs.Companies.EmptyRef());
		Query.SetParameter("Counterparties", Counterparties);
		Query.SetParameter("Companies", Companies);
		
		Result = Query.Execute();
		UsageOCR.Catalog_CounterpartyContracts_Receive = Not Result.IsEmpty();
		
		Return;
	
	EndIf;
EndProcedure

