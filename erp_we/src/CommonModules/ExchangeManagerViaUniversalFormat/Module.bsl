Function AddPKTCH(ConversionRule, TSConfigurationName, NameOfTSFormat, Namespace = "")
	
	If ConversionRule.TabularSectionsProperties.Columns.Count() = 0 Then
		DataExchangeXDTOServer.InitializeTabularSectionsProperties(ConversionRule);
	EndIf;
	
	ConvertingTablePart                = ConversionRule.TabularSectionsProperties.Add();
	ConvertingTablePart.TSConfigurations = TSConfigurationName;
	ConvertingTablePart.TSFormat_      = NameOfTSFormat;
	ConvertingTablePart.Properties       = DataExchangeXDTOServer.InitializePropertiesTableForConversionRule();
	ConvertingTablePart.Namespace = Namespace;
	Return ConvertingTablePart.Properties;
EndFunction

Procedure AddPCR(PCRParent, ConfigurationProperty, FormatProperty, UsesConversionAlgorithm = 0, 
		PropertyConversionRule = "", Namespace = "")
	NewRow                                 = PCRParent.Add();
	NewRow.ConfigurationProperty            = ConfigurationProperty;
	NewRow.FormatProperty                 = FormatProperty;
	NewRow.UsesConversionAlgorithm = ?(UsesConversionAlgorithm = 0, False, True);
	NewRow.PropertyConversionRule      = PropertyConversionRule;
	NewRow.Namespace                = Namespace;
EndProcedure

#Region Algorithms

Procedure AdaptationOfPKPD(ExchangeComponents)
	PKPDLine = ExchangeComponents.PredefinedDataConversionRules.Find("Transfer_MethodsForCalculatingCommissionIncome", "PDCRName");
	
	CurrentVersionOfFormat = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion);
	
	If PKPDLine <> Undefined Then 
		
		ComplianceWithPKPDSending = PKPDLine.ConvertValuesOnSend;
		
		If CurrentVersionOfFormat >= NumberFormatVersion("1.17") Then
			
			ComplianceWithPKPDSending.Insert(Enums.CommissionFeeCalculationMethods.ArbitraryAmount, "ArbitraryAmount");
			
		EndIf;
		
	EndIf;
	
	PKPDLine = ExchangeComponents.PredefinedDataConversionRules.Find("VATTaxation", "PDCRName");
	
	If PKPDLine <> Undefined Then
		
		ComplianceWithPKPDSending = PKPDLine.ConvertValuesOnSend;
		ComplianceWithPKPDReceipt = PKPDLine.ConvertValuesOnReceipt;
		
		If CurrentVersionOfFormat >= NumberFormatVersion("1.19") Then
			
			ComplianceWithPKPDSending.Insert(Enums.VATTaxationTypes.SalesAreSubjectToVATInEEU, "SalesAreSubjectToVATInEEU");
			ComplianceWithPKPDReceipt.Insert("SalesAreSubjectToVATInEEU", Enums.VATTaxationTypes.SalesAreSubjectToVATInEEU);	
			
		EndIf;
		
	EndIf;
EndProcedure
Function UploadAlgorithmSettlementsWithCounterpartiesSending(IBData, FormatVersion)
	HeaderData_ = IBData.AdditionalProperties.HeaderData_;
	LocalAccountingCurrency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	
	ConversionAlgorithm = "";
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer Then 
		ConversionAlgorithm = "PaymentFromBuyer";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany Then
		ConversionAlgorithm = "PaymentFromIntercampanyBuyer";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment Then
		ConversionAlgorithm = "OtherReceipts_OtherSettlementsWithCounterparties";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromVendor Then
		ConversionAlgorithm = "RefundFromSupplier";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromAnotherCompany Then
		ConversionAlgorithm = "ReturnFromIntercampanySupplier";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt Then
		If Find(HeaderData_.OffsettingAccount, "66") > 0
			Or Find(HeaderData_.OffsettingAccount, "67") > 0 Then
			ConversionAlgorithm = "OtherIncome_SettlementsOnLoansAndBorrowings";
		ElsIf Find(HeaderData_.OffsettingAccount, "60") > 0
			Or Find(HeaderData_.OffsettingAccount, "62") > 0
			Or Find(HeaderData_.OffsettingAccount, "76") > 0 Then
			ConversionAlgorithm = "OtherReceipts_OtherSettlementsWithCounterparties";
		EndIf;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		If IBData.Currency <> LocalAccountingCurrency
			And IBData.CurrencyOfConversion <> LocalAccountingCurrency Then
			// The conversion of one currency into another is unloaded with the type of operation "Other settlements with counterparties".
			ConversionAlgorithm = "CurrencyConversion_OtherSettlementsWithCounterparties";
		EndIf;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromLessor Then
		ConversionAlgorithm = "RefundFromLandlord";
	ElsIf TypeOf(IBData) = Type("DocumentObject.CashAccountReceiptNote") 
		And IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty Then
		ConversionAlgorithm = "Loans_LoanSettlements_";
	ElsIf TypeOf(IBData) = Type("DocumentObject.CashAccountReceiptNote")
		And ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation) Then
		ConversionAlgorithm = "Loans_SettlementsOnLoansAndBorrowings";  
	ElsIf FormatVersion < 11500 And ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation) Then
		ConversionAlgorithm = "Loans_SettlementsOnLoansAndBorrowings";  
	ElsIf FormatVersion >= 11500 And TypeOf(IBData) = Type("DocumentObject.BankAccountReceiptNote") 
		And ThisIsBusinessTransactionCreditSettlements(IBData.BusinessOperation)Then
		ConversionAlgorithm = "Loans_LoanSettlements"; 
	ElsIf FormatVersion >= 11500 And TypeOf(IBData) = Type("DocumentObject.BankAccountReceiptNote") 
		And ThisIsBusinessTransactionLoanSettlements(IBData.BusinessOperation)Then
		ConversionAlgorithm = "Loans_LoanSettlements_"; 
	ElsIf ThisIsBusinessOperationSettlementOfDeposits(IBData.BusinessOperation) Then
		ConversionAlgorithm = "Deposits_OtherSettlementsWithCounterparties";
	EndIf;
	
	Return ConversionAlgorithm;
EndFunction
Function DefaultCounterpartyBankAccount(Counterparty, Currency)
	Query = New Query("SELECT TOP 2 Ref AS Ref
		|	FROM Catalog.CounterpartyBankAccounts
		|	WHERE Owner = &Counterparty 
		|		AND CashCurrency = &Currency 
		|		AND NOT Closed 
		|		AND NOT DeletionMark");
	
	Query.SetParameter("Counterparty", Counterparty);
	Query.SetParameter("Currency", Currency);
	
	AccountBank = Query.Execute().Unload();
	
	If AccountBank.Count() = 1 Then
		Return AccountBank[0].Ref;
	Else
		Return Catalogs.CounterpartyBankAccounts.EmptyRef();
	EndIf;
EndFunction


Function LocalAccountingCurrency(Organization = Undefined)
	If Not ValueIsFilled(Organization) Or TypeOf(Organization) <> Type("CatalogRef.Companies") Then
		Return SettingsValueCached.DefaultBaseCurrency();
	Else
		Return SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Organization);
	EndIf;
EndFunction
Function ManagementAccountingCurrency(ExchangeComponents)
	Return SettingsValueCached.ManagementAccountingCurrency();
EndFunction
Function FPS3ConfigurationOption(SettingsMode)
	Return ExchangePlans.DataSynchronizationViaUniversalFormat.ThisIsIdOfSBP3Setting(SettingsMode);
EndFunction
Function VueCalculationIsUnderway(Currency, ForeignCurrencyTransaction, Organization, ExchangeComponents = Undefined)
	If ExchangeComponents = Undefined Then
		LocalAccountingCurrency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Organization);
	Else
		LocalAccountingCurrency = LocalAccountingCurrency(Organization);
	EndIf;
	
	Return Currency <> LocalAccountingCurrency And Not ForeignCurrencyTransaction;
EndFunction


Function NumberFormatVersion(VersionString)
	If Not ValueIsFilled(VersionString) Or VersionString = "1.0.beta" Then
		Return 0;
	EndIf;
	
	NumberFormatVersion = 0;
	
	VersionRanks = StrSplit(VersionString, ".");
	If VersionRanks.Count() <> 2 Then
		ExceptionText = NStr("vi = 'Sai định dạng tham số %1: %2';
							|ru = 'Неправильный формат параметра %1: %2';
							|en = 'Invalid %1 parameter format: %2'; fa = 'Invalid %1 parameter format: %2';
							|it = 'Formato non corretto del parametro %1: %2';
							|pl = 'Nieprawidłowy format parametru %1: %2';
							|tr = 'Yanlış parametre biçimi%1:%2'");
		Raise StrTemplate(ExceptionText, "VersionString1", VersionString);
	EndIf;
	
	DischargeMultiplier = 10000;
	For DischargeIndexIsReversed = 0 To 1 Do
		NumberFormatVersion = NumberFormatVersion + Number(VersionRanks[DischargeIndexIsReversed])*DischargeMultiplier;
		DischargeMultiplier = DischargeMultiplier / 100;
	EndDo;
	Return NumberFormatVersion;
EndFunction
// This function defines the type of counterparty agreement to exchange
//	with the enterprise Accounting configuration.
//
// Parameters:
//		DocumentOfARAPAccounting - DocumentRef - A settlement document that is used to determine the type of contract.
//		Terms - CatalogRef.TermsOfPurchaseFromVendors,CatalogRef.TermsOfSale - The agreement document.
//		BusinessOperation - EnumRef.BusinessTransactions - business operation of the document.
//
// Returns:
// 		String - The type of contract, for example, "by the buyer".
Function TypeOfCounterpartyAgreement(DocumentOfARAPAccounting, Terms, BusinessOperation)
	TypeOfAgreement = "";
	
	If ValueIsFilled(DocumentOfARAPAccounting) Then
		
		If TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.SalesOrder") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent) THEN
			|		""WithConsignee""
			|	ELSE
			|		""WithCustomer""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.SalesOrder AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithCustomer";
			EndIf;
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent) THEN
			|		""WithConsignee""
			|	ELSE
			|		""WithCustomer""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.RequestForReturnOfGoodsFromCustomer AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithCustomer";
			EndIf;	
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.PurchaseOrder") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement) THEN
			|		""WithConsignor""
			|	ELSE
			|		""WithVendor""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.PurchaseOrder AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithVendor";
			EndIf;
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.VendorInvoice") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement) THEN
			|		""WithConsignor""
			|	ELSE
			|		""WithVendor""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.VendorInvoice AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithVendor";
			EndIf;
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.VendorInvoiceServicesAndAssets") Then
			
			TypeOfAgreement = "WithVendor";
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.CustomerInvoiceServicesAndAssets") Then
			
			TypeOfAgreement = "WithCustomer";
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.ReturnOfGoodsToVendor") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsToConsignor) THEN
			|		""WithConsignor""
			|	ELSE
			|		""WithVendor""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.ReturnOfGoodsToVendor AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithVendor";
			EndIf;	
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.CustomerInvoice") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent) THEN
			|		""WithConsignee""
			|	ELSE
			|		""WithCustomer""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.CustomerInvoice AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithCustomer";
			EndIf;
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.ReturnOfGoodsFromCustomer") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent) THEN
			|		""WithConsignee""
			|	ELSE
			|		""WithCustomer""
			|	END AS TypeOfAgreement
			|FROM
			|	Document.ReturnOfGoodsFromCustomer AS DocumentData
			|WHERE
			|	DocumentData.Ref = &Ref
			|");
			Query.SetParameter("Ref", DocumentOfARAPAccounting);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithCustomer";
			EndIf;	
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.ConsignmentReportFromCustomer")
		 Or TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.WriteOffReportFromCommissionAgent") Then
			TypeOfAgreement = "WithConsignee";
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.ConsignmentReportToVendor")
		 Or TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.PurchaseInvoiceConsignmentStockLost") Then
			TypeOfAgreement = "WithConsignor";
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.CommissionReportIntercompany") Then
			If BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
				TypeOfAgreement = "WithConsignor";
				
			ElsIf BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany Then
				TypeOfAgreement = "WithConsignee";
				
			Else
				TypeOfAgreement = "WithConsignor";
				
			EndIf;
			
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.CustomerInvoiceIntercompany") Then
			If BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
				TypeOfAgreement = "WithVendor";
				
			ElsIf BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany Then
				TypeOfAgreement = "WithCustomer";
				
			Else
				TypeOfAgreement = "WithVendor";
				
			EndIf;
		ElsIf TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.ConsumptionReportSubcontractingServicesDeliveredIntercompany") Then
			If BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
				TypeOfAgreement = "WithVendor";
			Else
				TypeOfAgreement = "WithCustomer";
			EndIf;
		EndIf;
		
	EndIf;
		
	If IsBlankString(TypeOfAgreement)
	 And ValueIsFilled(Terms) Then
		
		If TypeOf(Terms) = Type("CatalogRef.TermsOfPurchaseFromVendors") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN CatalogData.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement) THEN
			|		""WithConsignor""
			|	ELSE
			|		""WithVendor""
			|	END AS TypeOfAgreement
			|FROM
			|	Catalog.TermsOfPurchaseFromVendors AS CatalogData
			|WHERE
			|	CatalogData.Ref = &Ref
			|");
			Query.SetParameter("Ref", Terms);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithVendor";
			EndIf;
			
		ElsIf TypeOf(Terms) = Type("CatalogRef.TermsOfSale") Then
			Query = New Query("
			|SELECT
			|	CASE WHEN CatalogData.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent) THEN
			|		""WithConsignee""
			|	ELSE
			|		""WithCustomer""
			|	END AS TypeOfAgreement
			|FROM
			|	Catalog.TermsOfSale AS CatalogData
			|WHERE
			|	CatalogData.Ref = &Ref
			|");
			Query.SetParameter("Ref", Terms);
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TypeOfAgreement = Selection.TypeOfAgreement;
			Else
				TypeOfAgreement = "WithCustomer";
			EndIf;
			
		EndIf;
		
	EndIf;
		
	If IsBlankString(TypeOfAgreement)
	 And ValueIsFilled(BusinessOperation) Then
		
		If BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer
		 Or BusinessOperation = Enums.BusinessTransactions.RefundToCustomer Then
			TypeOfAgreement = "WithCustomer";
		Else
			TypeOfAgreement = "WithVendor";
		EndIf;
		
	EndIf;
	
	Return TypeOfAgreement;
EndFunction
Function TypeOfContractForIntercampanySettlementObject(Organization, ARAPObject, DefaultContractType)
	If ValueIsFilled(ARAPObject) Then
		If TypeOf(ARAPObject) = Type("CatalogRef.IntercompanyContracts") Then
			Return TypeOfContractByIntercampanyContractType(Organization, ARAPObject);
		ElsIf TypeOf(ARAPObject) = Type("DocumentRef.CommissionReportIntercompany")
			Or TypeOf(ARAPObject) = Type("DocumentRef.CommissionWriteOffReportIntercompany") Then
			
			IntercampanyOrganizations = Common.ObjectAttributesValues(ARAPObject, "Organization, Consignee");
			If IntercampanyOrganizations.Organization = Organization Then
				Return "WithConsignee";
			ElsIf IntercampanyOrganizations.Consignee = Organization Then
				Return "WithConsignee";
			Else
				Return "Other";
			EndIf;
			
		ElsIf TypeOf(ARAPObject) = Type("DocumentRef.CustomerInvoiceIntercompany") Then
			
			IntercampanyOrganizations = Common.ObjectAttributesValues(ARAPObject, "Organization, CompanyRecipient");
			If IntercampanyOrganizations.Organization = Organization Then
				Return "WithCustomer";
			ElsIf IntercampanyOrganizations.CompanyRecipient = Organization Then
				Return "WithVendor";
			Else
				Return "Other";
			EndIf;
			
		Else
			Return "Other";
		EndIf;
	Else
		Return DefaultContractType;
	EndIf;
EndFunction
Function TypeOfContractByIntercampanyContractType(Organization, IntercampanyTreaty)
	ContractParameters = Common.ObjectAttributesValues(IntercampanyTreaty,
		"Organization, CompanyRecipient, ContractType");
	
	If ContractParameters.ContractType = Enums.TypesOfIntercompanyContracts.PurchaseAndSale Then
		If ContractParameters.Organization = Organization Then
			TypeOfAgreement = "WithCustomer";
		ElsIf ContractParameters.CompanyRecipient = Organization Then
			TypeOfAgreement = "WithVendor";
		Else
			TypeOfAgreement = "Other";
		EndIf;
	ElsIf ContractParameters.ContractType = Enums.TypesOfIntercompanyContracts.Consignment Then
		If ContractParameters.Organization = Organization Then
			TypeOfAgreement = "WithConsignee";
		ElsIf ContractParameters.CompanyRecipient = Organization Then
			TypeOfAgreement = "WithConsignor";
		Else
			TypeOfAgreement = "Other";
		EndIf;
	Else
		TypeOfAgreement = "Other";
	EndIf;
	
	Return TypeOfAgreement;
EndFunction
Function PartnerSKiTypeByCounterpartyKiType(KindCIOfCounterparty, UsePartnersAsCounterparties)
	PartnerSKiType = Undefined;
	
	If KindCIOfCounterparty = Catalogs.ContactInformationKinds.EmailCounterparty_ Then
		PartnerSKiType = Catalogs.ContactInformationKinds.EmailPartner_;
	ElsIf KindCIOfCounterparty = Catalogs.ContactInformationKinds.CounterpartySPhoneNumber Then
		PartnerSKiType = Catalogs.ContactInformationKinds.PartnerSPhoneNumber;
	ElsIf KindCIOfCounterparty = Catalogs.ContactInformationKinds.ActualDataCounterpartyAddress Then
		PartnerSKiType = Catalogs.ContactInformationKinds.PartnerAddress;
	ElsIf ValueIsFilled(KindCIOfCounterparty) And UsePartnersAsCounterparties Then
	
		RequiresCreationOfCIKind = False;
		If Common.RefExists(KindCIOfCounterparty)
			And Not Common.ObjectAttributeValue(KindCIOfCounterparty, "Predefined") Then
			RequiresCreationOfCIKind = True;
		EndIf;
		
		If Not RequiresCreationOfCIKind Then
			Return Undefined;
		EndIf;
		
		// Search for or create other types of CI.
		ValuesOfCITypeDetails = Common.ObjectAttributesValues(KindCIOfCounterparty, "Type, Description"); // Structure
		
		PartnerSKiType = TypeOfUserContactInformation(ValuesOfCITypeDetails.Description,
			Catalogs.ContactInformationKinds.CatalogPartners,
			ValuesOfCITypeDetails.Type);
		
	EndIf;
	
	Return PartnerSKiType;
EndFunction
Function ViewContactInformationFromLine(KiLineView, NameOfCI, CIKindsGroup)
	CurVidKi = Undefined;
		
	UserKeyPrefix = "UserCI";
			
	If StrStartsWith(KiLineView, UserKeyPrefix) Then
	
		KiTypeName = StrReplace(KiLineView, UserKeyPrefix, "");
	
		CurVidKi  = TypeOfUserContactInformation(NameOfCI,
			CIKindsGroup,
			Enums.ContactInformationTypes[KiTypeName]);
		
	Else
	
		CatalogCIKinds = Catalogs.ContactInformationKinds;
		
		If CIKindsGroup = CatalogCIKinds.CatalogCounterparties Then
			If KiLineView = "Email" Then
				CurVidKi = CatalogCIKinds.EmailCounterparty_;
			ElsIf KiLineView = "MailAddress" Then
				CurVidKi = CatalogCIKinds.PostalAddressOfCounterparty;
			ElsIf KiLineView = "ActualAddress" Then
				CurVidKi = CatalogCIKinds.ActualDataCounterpartyAddress;
			ElsIf KiLineView = "LegalAddress" Then
				CurVidKi = CatalogCIKinds.LegalAddressOfCounterparty;
			ElsIf KiLineView = "Phone" Then
				CurVidKi = CatalogCIKinds.CounterpartySPhoneNumber;
			ElsIf KiLineView = "Fax" Then
				CurVidKi = CatalogCIKinds.FaxCounterparties;
			EndIf;
		ElsIf CIKindsGroup = CatalogCIKinds.CatalogCompanies Then
			If KiLineView = "Email" Then
				CurVidKi = CatalogCIKinds.EmailCompanies;
			ElsIf KiLineView = "MailAddress" Then
				CurVidKi = CatalogCIKinds.CompanyPostalAddress;
			ElsIf KiLineView = "ActualAddress" Then
				CurVidKi = CatalogCIKinds.ActualDataAddressOfCompany;
			ElsIf KiLineView = "LegalAddress" Then
				CurVidKi = CatalogCIKinds.LegalAddressOfCompany;
			ElsIf KiLineView = "Phone" Then
				CurVidKi = CatalogCIKinds.CompanyPhone;
			ElsIf KiLineView = "Fax" Then
				CurVidKi = CatalogCIKinds.CompanyFax;
			EndIf;
		ElsIf CIKindsGroup = CatalogCIKinds.CatalogPersons Then
			If KiLineView = "Email" Then
				CurVidKi = CatalogCIKinds.EMailPersons;
			ElsIf KiLineView = "MailAddress" Then
				CurVidKi = CatalogCIKinds.AddressForInformingPersons;
			ElsIf KiLineView = "ActualAddress" Then
				CurVidKi = CatalogCIKinds.ResidentialAddressPersons;		
			ElsIf KiLineView = "LegalAddress" Then
				CurVidKi = CatalogCIKinds.RegistrationAddressPersons;
			ElsIf KiLineView = "Phone" Then
				CurVidKi = CatalogCIKinds.MobilePhoneOfPerson;
			ElsIf KiLineView = "HomePhoneNumber" Then
				CurVidKi = CatalogCIKinds.HomePhoneNumberOfPerson;
			ElsIf KiLineView = "WorkingPhone" Then
				CurVidKi = CatalogCIKinds.WorkingPhoneNumberOfPerson;
			EndIf;
		ElsIf CIKindsGroup = CatalogCIKinds.CatalogWarehouses Then
		    If KiLineView = "ActualAddress" Or KiLineView = "LegalAddress" Then
				CurVidKi = CatalogCIKinds.WarehouseAddress;
			ElsIf KiLineView = "Phone" Then
				CurVidKi = CatalogCIKinds.WarehousePhone;
			EndIf;
		ElsIf CIKindsGroup = CatalogCIKinds.CatalogContactPersonsForPartners Then
			If  KiLineView = "Phone" Then
				CurVidKi = CatalogCIKinds.ContactPersonSPhoneNumber;
			ElsIf KiLineView = "Email" Then
				CurVidKi = CatalogCIKinds.EmailContactPerson;
			EndIf;
		EndIf;
		
	EndIf;
	
	Return CurVidKi;
EndFunction
Function TypeOfUserContactInformation(NameOfCI, CIKindsGroup, CIType)
	CurVidKi = Undefined;
	
	Query = New Query(
	"SELECT TOP 1
	|	ContactInformationKinds.Ref AS Ref
	|FROM
	|	Catalog.ContactInformationKinds AS ContactInformationKinds
	|WHERE
	|	ContactInformationKinds.Ref IN HIERARCHY(&CIKindsGroup)
	|	AND ContactInformationKinds.Description = &Description
	|	AND ContactInformationKinds.Type = &CIType
	|	AND ContactInformationKinds.Used = TRUE
	|	AND ContactInformationKinds.IsFolder = FALSE");
	Query.SetParameter("CIKindsGroup", CIKindsGroup);
	Query.SetParameter("Description",  NameOfCI);
	Query.SetParameter("CIType",         CIType);
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		CurVidKi = Selection.Ref;
	EndIf;
	
	If Not ValueIsFilled(CurVidKi) Then
		CurVidKi = NewTypeOfContactInformation(NameOfCI, CIKindsGroup, CIType);
	EndIf;
	
	Return CurVidKi;
EndFunction

Function TypeOfSettlementsWithCounterpartyReceipt(ExchangeComponents, ConversionAlgorithm)
	If ConversionAlgorithm = "PaymentFromBuyer"
		Or ConversionAlgorithm = "PaymentFromIntercampanyBuyer" Then
		Return "WithCustomer";
	ElsIf ConversionAlgorithm = "RefundFromSupplier"
		Or ConversionAlgorithm = "ReturnFromIntercampanySupplier" Then
		Return "WithVendor";
	ElsIf ConversionAlgorithm = "OtherReceipts_OtherSettlementsWithCounterparties"
		Or ConversionAlgorithm = "OtherReceipts_OtherSettlementsWithCounterparties"
		Or ConversionAlgorithm = "CurrencyConversion_OtherSettlementsWithCounterparties"
		Or ConversionAlgorithm = "RefundFromLandlord"
		Or ConversionAlgorithm = "Deposits_OtherSettlementsWithCounterparties" Then
		Return "Other";
	ElsIf ConversionAlgorithm = "OtherIncome_SettlementsOnLoansAndBorrowings" Then 
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.15") Then
			Return "LoansAndBorrowings";
		Else	
			Return "CounterpartyCredit";
		EndIf;
	ElsIf ConversionAlgorithm = "Loans_SettlementsOnLoansAndBorrowings" Then
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.15") Then
			Return "LoansAndBorrowings";
		Else	
			Return "CounterpartyCredit";
		EndIf; 
	ElsIf ConversionAlgorithm = "Loans_LoanSettlements" Then
		Return "CounterpartyCredit";
	ElsIf ConversionAlgorithm = "Loans_LoanSettlements_" Then  
		Return "LoanToCounterparty";
	EndIf;
EndFunction  
Function ReturnOfGoodsViaCommissionAgent(BusinessOperation)
	Return ConsignmentSalesServer.ReturnOfGoodsViaCommissionAgent(BusinessOperation);
EndFunction
Function UnloadingBarcodesOfPackages(ExchangeComponents)
	If ExchangeComponents.CorrespondentNode = Undefined Then
		Return False;
	Else
		Return ExchangeComponents.CorrespondentNode.UploadMarkingData;
	EndIf;
EndFunction
Procedure UnloadBankFromBankAccount(IBData, XDTOData, ExchangeComponents, ExportStack)
	BankStructure = New Structure("BIC, CorrAccount, Description, SWIFTBIC, Country, City, Address, ForeignBank");
		
	If (IBData.ManualBankDetailsChange Or IBData.ForeignBank)
		And (ValueIsFilled(IBData.BankBIC) Or ValueIsFilled(IBData.BankSWIFTCode)) Then
		
		Bank = Common.CopyRecursive(BankStructure);
		Bank.BIC          = IBData.BankBIC;
		Bank.SWIFTBIC     = IBData.BankSWIFTCode;
		
		If IBData.ForeignBank Then
			Bank.Description = IBData.BankNameInt;
			Bank.CorrAccount     = IBData.BankAccountForPayments;
			Bank.City        = IBData.BankCity;
		Else
			Bank.Description = IBData.BankDescription;
			Bank.CorrAccount     = IBData.BankCorrAccount;
			Bank.City        = IBData.BankCityInt;
		EndIf;
		
		Bank.Address           = IBData.BankAddressInt;
		Bank.ForeignBank = IBData.ForeignBank;
		Bank.Country          = IBData.CountryOfBank;
		
		Instruction = New Structure("OCRName, Value", "Catalog___FromStructure_", Bank);
		
		If ExportStack.Count() = 1 Then
			XDTOData.KeyProperties.Insert("Bank", Instruction);
		Else
			XDTOData.Insert("Bank", Instruction);
		EndIf;
		
		ProcessingRule = ExchangeComponents.DataProcessingRules.Find("Catalog_Banks_Send", "Name");
		If Not ProcessingRule = Undefined Then
			DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Bank, ProcessingRule);
		EndIf;
	
	EndIf;
	
	If IBData.TransferBankDetailsManualEdit And (ValueIsFilled(IBData.TransferBankBIC)
		Or ValueIsFilled(IBData.BankSWIFTCodeForPayments)) Then
	
		TransferBank = Common.CopyRecursive(BankStructure);
		If IBData.CashCurrency = LocalAccountingCurrency(IBData.Owner) Then
		    TransferBank.Description = IBData.TransferBankDescription;
		    TransferBank.City        = IBData.TransferBankCity;
		Else
			TransferBank.Description = IBData.BankNameForPaymentsInt;
			TransferBank.City        = IBData.BankCityForPaymentsInt;
		EndIf;
		TransferBank.BIC          = IBData.TransferBankBIC;
		TransferBank.SWIFTBIC     = IBData.BankSWIFTCodeForPayments;
		TransferBank.CorrAccount     = IBData.TransferBankCorrAccount;
		
		TransferBank.Address           = IBData.BankAddressForPaymentInt;
		TransferBank.ForeignBank = IBData.ForeignBank;
		TransferBank.Country          = IBData.CountryOfBankForPayments;
		
		Instruction = New Structure("OCRName, Value", "Catalog___FromStructure_", TransferBank);
		
		If ExportStack.Count() = 1 Then
			XDTOData.KeyProperties.Insert("TransferBank", Instruction);
		Else
			XDTOData.Insert("TransferBank", Instruction);
		EndIf;
		
		ProcessingRule = ExchangeComponents.DataProcessingRules.Find("Catalog_Banks_Send", "Name");
		If Not ProcessingRule = Undefined Then
			DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, TransferBank, ProcessingRule);
		EndIf;
		
	EndIf;
EndProcedure


Procedure UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, HasAddlAttributes = False)
	If StandardSubsystemsServer.IsBaseConfigurationVersion() Then
		Return;
	EndIf;
	
	AdditionalAttributes = New ValueTable;
	AdditionalAttributes.Columns.Add("Property");
	AdditionalAttributes.Columns.Add("PropertyValue");
	
	If HasAddlAttributes Then
		UnloadingAdditionalDetailsFromValueTable(IBData.AdditionalAttributes, AdditionalAttributes);
	EndIf;
	
	Query = New Query("SELECT
		|	Property AS Property,
		|	Value AS Value
		|FROM
		|	InformationRegister.AdditionalInfo
		|WHERE Object = &Ref");
	
	Query.SetParameter("Ref", IBData.Ref);
	AdditionalInformationFromInformationSecurityData = Query.Execute().Unload();
	
	// Additional Boolean-type information is stored in the "Additional Data" information register
	// only with the value True. In this regard, the False values must be forcibly unloaded.
	Ref               = IBData.Ref;
	ObjectMetadata    = Ref.Metadata();
	MetadataObjectName = ObjectMetadata.Name;
	MetadataObjectKind = Common.ObjectKindByRef(Ref);
	
	OwnerOfThisInformationIsGroup = False;
	
	If MetadataObjectKind = "Catalog"
		Or MetadataObjectKind = "ChartOfCharacteristicTypes" Then
		OwnerOfThisInformationIsGroup = Common.ObjectIsFolder(Ref);
	EndIf;
	
	MoreInformationWithBooleanValue = GetVTAdditionalInformationBoolean(ExchangeComponents);
	
	If Not OwnerOfThisInformationIsGroup Then
		
		TagName       = MetadataObjectKind + "_" + MetadataObjectName;
		AdditionalPropertyStringBoolean = MoreInformationWithBooleanValue.Find(TagName, "PredefinedDataName");
		
		If Not AdditionalPropertyStringBoolean = Undefined Then
			
			If AdditionalInformationFromInformationSecurityData.Find(AdditionalPropertyStringBoolean.Property, "Property") = Undefined Then
				AStringOfAdditionalDetails = AdditionalInformationFromInformationSecurityData.Add();
				AStringOfAdditionalDetails.Property = AdditionalPropertyStringBoolean.Property;
				AStringOfAdditionalDetails.Value = False;
			EndIf;
			
		EndIf;
		
	EndIf;
	
	UnloadingAdditionalDetailsFromValueTable(AdditionalInformationFromInformationSecurityData, AdditionalAttributes);
	
	If AdditionalAttributes.Count() > 0 Then
		XDTOData.Insert("AdditionalAttributes", AdditionalAttributes);
	EndIf;
EndProcedure
Procedure UnloadUnitOfMeasurementOfExpirationDate(XDTOData, IBData, ExchangeComponents)
	If Not ValueIsFilled(IBData.ShelfLifeUnitOfMeasure) Then
		
		Return;
		
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
		
		ShelfLifeUnitOfMeasure = "";
		
		ShelfLifeUnitOfMeasure = XMLString(IBData.ShelfLifeUnitOfMeasure);
		
	Else
		
		CorrespondenceOfUnitsOfMeasurementToCodes = New Map;
		
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Second, 1);
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Minute, 2);
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Hour, 3);
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Day, 4);
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Days1, 5);
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Month, 6);
		CorrespondenceOfUnitsOfMeasurementToCodes.Insert(Enums.TimeMeasureUnits.Year, 7);
		
		UnitOfMeasurementOfExpirationDateByCode = CorrespondenceOfUnitsOfMeasurementToCodes.Get(IBData.ShelfLifeUnitOfMeasure);
		ShelfLifeUnitOfMeasure = ?(UnitOfMeasurementOfExpirationDateByCode = Undefined, 0, UnitOfMeasurementOfExpirationDateByCode); 
		
	EndIf;
	
	XDTOData.Insert("ShelfLifeUnitOfMeasure", ShelfLifeUnitOfMeasure);
EndProcedure
