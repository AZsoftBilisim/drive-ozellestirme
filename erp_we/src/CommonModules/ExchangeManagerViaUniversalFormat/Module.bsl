Procedure OCR_Document_ReturnOfGoodsFromCustomer_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReturnOfGoodsFromCustomer_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReturnOfGoodsFromCustomer_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	// Let's define the counterparty of the document. For a return from a retail buyer, the counterparty is not filled in in the document.
	// Only the Retail Buyer partner is filled in.
	DocumentCounterparty = IBData.Counterparty;
	If Not ValueIsFilled(DocumentCounterparty)
		And IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromRetailCustomer Then
		DocumentCounterparty = Catalogs.Counterparties.RetailCustomer;
	EndIf;
	
	XDTOData.Insert("Counterparty", DocumentCounterparty);
	
	// The currency of the settlements is needed to calculate the exchange rate and multiplicity.
	// The calculation of conditional units is calculated in parallel, because it can be useful if the contract is empty.
	CalculationsInConventionalUnits = False;
	ARAPCurrency     = IBData.Currency;
	
	If Not (IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromRetailCustomer) Then
		
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
			ARAPCurrency	 = UECalculationData.ARAPCurrency;		 
		Else
			If IBData.ARAPDetails.Count() > 0 Then
				ARAPCurrency = IBData.ARAPDetails[0].ARAPCurrency;
				CalculationsInConventionalUnits = (IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> ARAPCurrency);
			EndIf;
		EndIf;
		
	EndIf;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True);
	
	If Not ValueIsFilled(IBData.BusinessOperation)
		Or ReturnOfGoodsViaCommissionAgent(IBData.BusinessOperation) Then
		XDTOData.Insert("OperationKind", "ReturnFromCustomer");
	EndIf;	
	UploadRateAndMultiplicityOfSettlements(XDTOData, ARAPCurrency, IBData.Date, IBData.Organization);
	
	// Implementation document
	DocumentSalesOfGoodsAndServices = Undefined;
	If ValueIsFilled(IBData.DocumentSalesOfGoodsAndServices) Then
		
		DocumentSalesOfGoodsAndServices = IBData.DocumentSalesOfGoodsAndServices;
		
	ElsIf Not IBData.ReturnOfSpoiledGoods Then
	
		Query = New Query;
		Query.Text = "SELECT DISTINCT
			|Goods.DocumentSalesOfGoodsAndServices.Ref AS Ref
			|FROM Document.ReturnOfGoodsFromCustomer.Goods AS Goods
			|WHERE 
			|	Goods.Ref = &Ref";
	
		Query.SetParameter("Ref", IBData.Ref);
	
		Selection = Query.Execute().Select();
		If Selection.Count() = 1 Then
			Selection.Next();
			DocumentSalesOfGoodsAndServices = Selection.Ref;
		EndIf;
		
	EndIf;
	
	XDTOData.Insert("DocumentSalesOfGoodsAndServices");
	
	ReturnsViaCommissionAgentAreSupported = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17"); 
	
	If DocumentSalesOfGoodsAndServices <> Undefined Then
		
		OCRName = "Document_SaleOfGoodsAndServices_Shipment";
		
		If TypeOf(DocumentSalesOfGoodsAndServices) = Type("DocumentRef.RetailSalesReport") Then
			OCRName = "Document_RetailSalesReport__";
	   	EndIf;
		
		XDTOData.Insert("DocumentSalesOfGoodsAndServices", New Structure("Value, OCRName", DocumentSalesOfGoodsAndServices, OCRName));
		
	EndIf;
	If ReturnOfGoodsViaCommissionAgent(IBData.BusinessOperation) And ReturnsViaCommissionAgentAreSupported Then
	    
		If XDTOData.Property("AdditionalInfo") And TypeOf(XDTOData.AdditionalInfo)= Type("Structure") Then
			AdditionalData = XDTOData.AdditionalInfo;
		Else
			AdditionalData = New Structure;
		EndIf;
	
		CounterpartySIDIsXDTO = InformationRegisters.SynchronizedObjectPublicIDs.PublicIDByObjectRef(
			ExchangeComponents.CorrespondentNode, IBData.CustomerCounterparty);
			
		XDTOContractUID = InformationRegisters.SynchronizedObjectPublicIDs.PublicIDByObjectRef(
			ExchangeComponents.CorrespondentNode, IBData.CustomerContract);
			
		AdditionalData.Insert("CustomerCounterparty", CounterpartySIDIsXDTO);
		AdditionalData.Insert("CustomerContract", XDTOContractUID);
		AdditionalData.Insert("RefundViaCommissionAgent", True);
		
		XDTOData.Insert("AdditionalInfo", AdditionalData);
		
	EndIf;
		
	If IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromRetailCustomer Then
		XDTOData.Insert("BuyerIssuesInvoiceForReturn", False);
	EndIf;
	
	// Goods
	If IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent Then
		
			QueryText = 
			"SELECT
			|	""Goods"" AS TabularSectionName,
			|	T.ItemsLocationAttributes.Products AS Products,
			|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
			|	SUM(1) AS RowsCount
			|INTO TTDocumentProducts
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.Goods AS T
			|WHERE
			|	T.Ref = &Ref
			|
			|GROUP BY
			|	T.ItemsLocationAttributes.Products,
			|	T.ItemsLocationAttributes.Characteristic
			|
			|UNION ALL
			|
			|SELECT
			|	""InventoryKinds"",
			|	T.ItemsLocationAttributes.Products,
			|	T.ItemsLocationAttributes.Characteristic,
			|	SUM(1)
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS T
			|WHERE
			|	T.Ref = &Ref
			|
			|GROUP BY
			|	T.ItemsLocationAttributes.Products,
			|	T.ItemsLocationAttributes.Characteristic
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	""InventoryKinds"" AS TSInventoryKinds,
			|	T.LineNumber AS LineNumber,
			|	CASE
			|		WHEN Totals.RowsCount > 1
			|			THEN T.LineNumber
			|		ELSE 0
			|	END AS RowCode
			|INTO TTLineCodes
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS T
			|		INNER JOIN TTDocumentProducts AS Totals
			|		ON T.ItemsLocationAttributes.Products = Totals.Products
			|			AND T.ItemsLocationAttributes.Characteristic = Totals.Characteristic
			|			AND (Totals.TabularSectionName = ""InventoryKinds"")
			|WHERE
			|	T.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.LineNumber AS LineNumber,
			|	Goods.Products AS Products,
			|	Goods.Price AS Price,
			|	TTDocumentProducts.RowsCount AS RowsCount,
			|	Goods.RowID AS RowID,
			|	Goods.ItemsLocationAttributes AS ItemsLocationAttributes
			|INTO TempTableOfGoodsWithPricesPreliminary
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.Goods AS Goods
			|		LEFT JOIN TTDocumentProducts AS TTDocumentProducts
			|		ON (TTDocumentProducts.TabularSectionName = ""Goods"")
			|			AND (TTDocumentProducts.Products = Goods.Products)
			|			AND (TTDocumentProducts.Characteristic = Goods.Characteristic)
			|WHERE
			|	Goods.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	TempTableOfGoodsWithPricesPreliminary.LineNumber AS LineNumber,
			|	TempTableOfGoodsWithPricesPreliminary.Products AS Products,
			|	TempTableOfGoodsWithPricesPreliminary.Price AS Price,
			|	TempTableOfGoodsWithPricesPreliminary.RowsCount AS RowsCount,
			|	TTLineCodes.RowCode AS RowCode,  
			|	TempTableOfGoodsWithPricesPreliminary.RowID AS RowID,
			|	TempTableOfGoodsWithPricesPreliminary.ItemsLocationAttributes AS ItemsLocationAttributes
			|INTO TemporaryTableProductsTotal
			|FROM
			|	TempTableOfGoodsWithPricesPreliminary AS TempTableOfGoodsWithPricesPreliminary
			|		LEFT JOIN TTLineCodes AS TTLineCodes
			|		ON TempTableOfGoodsWithPricesPreliminary.LineNumber = TTLineCodes.LineNumber
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CASE
			|		WHEN InventoryKinds.ProductsRecordingAsReceived = VALUE(Catalog.Products.EmptyRef)
			|			THEN InventoryKinds.ItemsLocationAttributes.Products
			|		ELSE InventoryKinds.ProductsRecordingAsReceived
			|	END AS Products,
			|	CASE
			|		WHEN InventoryKinds.CharacteristicRecordingAsReceived = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			|			THEN InventoryKinds.ItemsLocationAttributes.Characteristic
			|		ELSE InventoryKinds.CharacteristicRecordingAsReceived
			|	END AS Characteristic,
			|	InventoryKinds.Count AS Count,
			|	InventoryKinds.AmountIncludingVAT AS AmountIncludingVAT,
			|	InventoryKinds.VATRate AS VATRate,
			|	InventoryKinds.VATAmount AS VATAmount,
			|	CASE
			|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.FromCurrentDocument)
			|			THEN 0
			|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.Manually)
			|			THEN CASE
			|					WHEN ISNULL(&Rate, 0) > 0
			|							AND ISNULL(&Repetition, 0) > 0
			|						THEN CAST(InventoryKinds.CostLocal / &Rate / &Repetition AS NUMBER(31, 2))
			|					ELSE 0
			|				END
			|		ELSE 0
			|	END AS Cost_,
			|	InventoryKinds.Ref.PriceIncludesVAT AS PriceIncludesVAT,
			|	InventoryKinds.CCDNumber AS CCDNumber,
			|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
			|	InventoryKinds.Ref.ReusablePackageReturn AS ReusablePackageReturn,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType,    
			|	InventoryKinds.RowID AS RowID,
			|	InventoryKinds.ItemsLocationAttributes.Series AS Series
			|INTO InventoryKinds
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS InventoryKinds
			|WHERE
			|	InventoryKinds.Ref = &Ref
			|
			|INDEX BY
			|	Products
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	InventoryKinds.Products AS Products,
			|	InventoryKinds.Products.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	InventoryKinds.Count AS Count,
			|	InventoryKinds.VATRate AS VATRate,
			|	InventoryKinds.VATAmount AS VATAmount,
			|	CAST(CASE
			|			WHEN InventoryKinds.PriceIncludesVAT
			|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
			|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
			|		END AS NUMBER(31, 2)) AS Price,
			|	CASE
			|		WHEN InventoryKinds.PriceIncludesVAT
			|			THEN InventoryKinds.AmountIncludingVAT
			|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
			|	END AS Sum,
			|	InventoryKinds.Cost_ AS Cost_, 
			|	InventoryKinds.RowID AS RowID,
			|	CASE
			|		WHEN InventoryKinds.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|				AND InventoryKinds.ReusablePackageReturn
			|			THEN ""ReturnContainers""
			|		WHEN InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType
			|FROM
			|	InventoryKinds AS InventoryKinds";
			
	Else
			
		QueryText = 
			"SELECT
			|	""Goods"" AS TabularSectionName,
			|	T.ItemsLocationAttributes.Products AS Products,
			|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
			|	SUM(1) AS RowsCount
			|INTO TTDocumentProducts
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.Goods AS T
			|WHERE
			|	T.Ref = &Ref
			|
			|GROUP BY
			|	T.ItemsLocationAttributes.Products,
			|	T.ItemsLocationAttributes.Characteristic
			|
			|UNION ALL
			|
			|SELECT
			|	""InventoryKinds"",
			|	T.ItemsLocationAttributes.Products,
			|	T.ItemsLocationAttributes.Characteristic,
			|	SUM(1)
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS T
			|WHERE
			|	T.Ref = &Ref
			|
			|GROUP BY
			|	T.ItemsLocationAttributes.Products,
			|	T.ItemsLocationAttributes.Characteristic
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	""InventoryKinds"" AS TSInventoryKinds,
			|	T.LineNumber AS LineNumber,
			|	CASE
			|		WHEN Totals.RowsCount > 1
			|			THEN T.LineNumber
			|		ELSE 0
			|	END AS RowCode
			|INTO TTLineCodes
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS T
			|		INNER JOIN TTDocumentProducts AS Totals
			|		ON T.ItemsLocationAttributes.Products = Totals.Products
			|			AND T.ItemsLocationAttributes.Characteristic = Totals.Characteristic
			|			AND (Totals.TabularSectionName = ""InventoryKinds"")
			|WHERE
			|	T.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.LineNumber AS LineNumber,
			|	Goods.Products AS Products,
			|	Goods.Price AS Price,
			|	TTDocumentProducts.RowsCount AS RowsCount,
			|	Goods.ItemsLocationAttributes AS ItemsLocationAttributes
			|INTO TempTableOfGoodsWithPricesPreliminary
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.Goods AS Goods
			|		LEFT JOIN TTDocumentProducts AS TTDocumentProducts
			|		ON (TTDocumentProducts.TabularSectionName = ""Goods"")
			|			AND (TTDocumentProducts.Products = Goods.Products)
			|			AND (TTDocumentProducts.Characteristic = Goods.Characteristic)
			|WHERE
			|	Goods.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	TempTableOfGoodsWithPricesPreliminary.LineNumber AS LineNumber,
			|	TempTableOfGoodsWithPricesPreliminary.Products AS Products,
			|	TempTableOfGoodsWithPricesPreliminary.Price AS Price,
			|	TempTableOfGoodsWithPricesPreliminary.RowsCount AS RowsCount,
			|	TTLineCodes.RowCode AS RowCode,
			|	TempTableOfGoodsWithPricesPreliminary.ItemsLocationAttributes AS ItemsLocationAttributes
			|INTO TemporaryTableProductsTotal
			|FROM
			|	TempTableOfGoodsWithPricesPreliminary AS TempTableOfGoodsWithPricesPreliminary
			|		LEFT JOIN TTLineCodes AS TTLineCodes
			|		ON TempTableOfGoodsWithPricesPreliminary.LineNumber = TTLineCodes.LineNumber
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CASE
			|		WHEN InventoryKinds.ProductsRecordingAsReceived = VALUE(Catalog.Products.EmptyRef)
			|			THEN InventoryKinds.ItemsLocationAttributes.Products
			|		ELSE InventoryKinds.ProductsRecordingAsReceived
			|	END AS Products,
			|	CASE
			|		WHEN InventoryKinds.CharacteristicRecordingAsReceived = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			|			THEN InventoryKinds.ItemsLocationAttributes.Characteristic
			|		ELSE InventoryKinds.CharacteristicRecordingAsReceived
			|	END AS Characteristic,
			|	InventoryKinds.Count AS Count,
			|	InventoryKinds.Ref.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
			|	InventoryKinds.Ref.ReturnOfSpoiledGoods AS ReturnOfSpoiledGoods,
			|	InventoryKinds.Ref.PriceIncludesVAT AS PriceIncludesVAT,
			|	InventoryKinds.AmountIncludingVAT AS AmountIncludingVAT,
			|	InventoryKinds.VATAmount AS VATAmount,
			|	InventoryKinds.VATRate AS VATRate,
			|	CASE
			|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.FromCurrentDocument)
			|			THEN CASE
			|					WHEN InventoryKinds.Ref.PriceIncludesVAT
			|						THEN InventoryKinds.AmountIncludingVAT
			|					ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
			|				END
			|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.Manually)
			|			THEN CASE
			|					WHEN ISNULL(&Rate, 0) > 0
			|							AND ISNULL(&Repetition, 0) > 0
			|						THEN CAST(InventoryKinds.CostLocal / &Rate / &Repetition AS NUMBER(31, 2))
			|					ELSE 0
			|				END
			|		ELSE 0
			|	END AS Cost_,
			|	InventoryKinds.CCDNumber AS CCDNumber,
			|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType,
			|	InventoryKinds.InventoryOwnerAttributeShipment AS InventoryOwnerAttributeShipment,
			|	InventoryKinds.Ref.ReusablePackageReturn AS ReusablePackageReturn,
			|	InventoryKinds.ItemsLocationAttributes.Series AS Series
			|INTO InventoryKinds
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS InventoryKinds
			|WHERE
			|	InventoryKinds.Ref = &Ref
			|
			|INDEX BY
			|	Products
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	TypesOfStocksImplementation.ItemsLocationAttributes.Products AS Products,
			|	TypesOfStocksImplementation.ItemsLocationAttributes.Characteristic AS Characteristic,
			|	TypesOfStocksImplementation.InventoryOwnerAttribute AS InventoryOwnerAttribute,
			|	MAX(CAST(CASE
			|		WHEN TypesOfStocksImplementation.AmountIncludingVAT = 0 OR TypesOfStocksImplementation.Count = 0
			|			THEN NULL
			|		WHEN TypesOfStocksImplementation.Ref.PriceIncludesVAT
			|			THEN TypesOfStocksImplementation.AmountIncludingVAT / TypesOfStocksImplementation.Count
			|		ELSE (TypesOfStocksImplementation.AmountIncludingVAT - TypesOfStocksImplementation.VATAmount) / TypesOfStocksImplementation.Count
			|	END AS NUMBER(31, 2))) AS Price,
			|	SUM(1) AS RowsCount
			|INTO TypesOfStocksImplementation
			|FROM
			|	Document.CustomerInvoice.InventoryKinds AS TypesOfStocksImplementation
			|		INNER JOIN InventoryKinds AS InventoryKinds
			|		ON TypesOfStocksImplementation.Ref = InventoryKinds.DocumentSalesOfGoodsAndServices
			|
			|GROUP BY
			|	TypesOfStocksImplementation.ItemsLocationAttributes.Characteristic,
			|	TypesOfStocksImplementation.InventoryOwnerAttribute,
			|	TypesOfStocksImplementation.ItemsLocationAttributes.Products
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	InventoryKinds.Products AS Products,
			|	InventoryKinds.Products.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	InventoryKinds.Count AS Count,
			|	InventoryKinds.VATRate AS VATRate,
			|	InventoryKinds.VATAmount AS VATAmount,
			|	CAST(CASE
			|			WHEN InventoryKinds.PriceIncludesVAT
			|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
			|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
			|		END AS NUMBER(31, 2)) AS Price,
			|	CASE
			|		WHEN InventoryKinds.PriceIncludesVAT
			|			THEN InventoryKinds.AmountIncludingVAT
			|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
			|	END AS Sum,
			|	InventoryKinds.Cost_ AS Cost_,
			|	CASE
			|		WHEN InventoryKinds.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|				AND InventoryKinds.ReusablePackageReturn
			|			THEN ""ReturnContainers""
			|		ELSE InventoryKinds.InventoryType
			|	END AS InventoryType
			|FROM
			|	InventoryKinds AS InventoryKinds
			|	LEFT JOIN TypesOfStocksImplementation AS TypesOfStocksImplementation
			|ON InventoryKinds.Products = TypesOfStocksImplementation.Products
			|	AND InventoryKinds.Characteristic = TypesOfStocksImplementation.Characteristic
			|	AND InventoryKinds.InventoryOwnerAttributeShipment = TypesOfStocksImplementation.InventoryOwnerAttribute
			|	AND (TypesOfStocksImplementation.RowsCount = 1)";
	
	EndIf;
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
		
	// We take the customer's order from the tabular part "Payment decryption"
	// If several orders are indicated there or a document that is not an order is specified as an order, then we do nothing
	QueryText = QueryText + Common.QueryBatchSeparator() + 
		"SELECT DISTINCT
		|	CASE
		|		WHEN ReturnOfGoodsFromCustomer.DocumentSalesOfGoodsAndServices REFS Document.CustomerInvoice
		|			THEN CAST(ReturnOfGoodsFromCustomer.DocumentSalesOfGoodsAndServices AS Document.CustomerInvoice).SalesOrder
		|		ELSE UNDEFINED
		|	END AS OrderDocument
		|FROM
		|	Document.ReturnOfGoodsFromCustomer AS ReturnOfGoodsFromCustomer
		|WHERE
		|	ReturnOfGoodsFromCustomer.Ref = &Ref";
	
	#Region PackagingMarkings
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
		"SELECT
		|	ReturnOfGoodsFromCustomerPackageBarcodes.LineNumber AS DocumentRowNumber,
		|	ReturnOfGoodsFromCustomerPackageBarcodes.PackageBarcode AS PackageBarcode
		|INTO TTBarcodesOfPackages
		|FROM
		|	Document.ReturnOfGoodsFromCustomer.PackageBarcodes AS ReturnOfGoodsFromCustomerPackageBarcodes
		|WHERE
		|	&UnloadingBarcodesOfPackages
		|	AND ReturnOfGoodsFromCustomerPackageBarcodes.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber,
		|	TTBarcodesOfPackages.PackageBarcode AS PackageMarking
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|";
	
	#EndRegion
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("UnloadingBarcodesOfPackages", UnloadingBarcodesOfPackages(ExchangeComponents));
	
	If IBData.Currency = LocalAccountingCurrency(IBData.Organization) Then
		Query.SetParameter("Rate", 1);
		Query.SetParameter("Repetition", 1);
	Else
		CurrencyExchangeRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(IBData.Currency, IBData.Date,
						SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		Query.SetParameter("Rate", CurrencyExchangeRate.CourseNumerator);
		Query.SetParameter("Repetition", CurrencyExchangeRate.CourseDenominator);
	EndIf;
	Result = Query.ExecuteBatch();
	
	Goods = Result[Result.Count() - 5].Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "ReturnUnderOperation");
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("Goods", Goods);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = DocumentCounterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = ARAPCurrency;
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
	
		DefaultParameters.TypeOfAgreement = ?(IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent,
			"WithConsignee", "WithCustomer");
		
		SalesOrder = Undefined;
		
		Selection = Result[Result.Count() - 4].Select();
		If Selection.Next() Then
			SalesOrder = Selection.OrderDocument;
		EndIf;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", SalesOrder, IBData.Terms, IBData.SalesOpportunity);
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.ReturnOfGoodsFromCustomer.SetOfSeries", XDTOData);
	EndIf;
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

