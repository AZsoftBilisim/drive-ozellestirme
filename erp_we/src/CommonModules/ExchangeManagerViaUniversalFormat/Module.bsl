Procedure OCR_Document_SalesOrder_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
			PropertyStructure = Common.ObjectAttributesValues(IBData, "DateAccordingToInformationFromCustomer, NumberAccordingToCustomerData");
			XDTOData.Insert("IncomingDocumentDate", PropertyStructure.DateAccordingToInformationFromCustomer);
			XDTOData.Insert("IncomingDocumentNumber", PropertyStructure.NumberAccordingToCustomerData);
		EndIf;
	
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
		XDTOData.KeyProperties.Insert("IncomingDocumentDate", IBData.DateAccordingToInformationFromCustomer);
		XDTOData.KeyProperties.Insert("IncomingDocumentNumber", IBData.NumberAccordingToCustomerData);
		
		XDTOData.Insert("ShipEntireOrder", IBData.NotShipInInstallments);
		UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False, "VATTaxationOfSeller");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CustomerOrder_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CustomerOrder_Sending", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy, True);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	If IBData.DeliveryMethod = Enums.TransportMethods.ByCarrierToAddress
		Or IBData.DeliveryMethod = Enums.TransportMethods.ByCarrierToOurWarehouse
		Or IBData.DeliveryMethod = Enums.TransportMethods.ByCarrierToTransferPoint Then
			
		XDTOData.Insert("DeliveryAddress", IBData.DeliveryAddressOfCarrier);
	Else
		XDTOData.Insert("DeliveryAddress", IBData.DeliveryAddress);
	EndIf;
	
	// The "Courier" delivery method is not supported in early formats
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.10")
		And IBData.DeliveryMethod = Enums.TransportMethods.ToCustomerByCourier  Then
		IBData.DeliveryMethod = Enums.TransportMethods.ToCustomer;
	EndIf;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	ARAPCurrency = IBData.Currency;
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		
		ContractProperties = Common.ObjectAttributesValues(
			IBData.Contract, "ForeignCurrencyTransaction, ARAPCurrency, Organization");
		
		XDTOData.Insert("Contract",                  IBData.Contract);
		XDTOData.Insert("CalculationsInConventionalUnits", VueCalculationIsUnderway(ContractProperties.ARAPCurrency, ContractProperties.ForeignCurrencyTransaction, ContractProperties.Organization, ExchangeComponents));
		
		ARAPCurrency = ContractProperties.ARAPCurrency;
		
	Else
		
		If ValueIsFilled(IBData.Terms) Then
			ARAPCurrency = Common.ObjectAttributeValue(IBData.Terms, "Currency");
		EndIf;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty = IBData.Counterparty;
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.ARAPCurrency = ARAPCurrency;
		DefaultParameters.TypeOfAgreement = TypeOfCounterpartyAgreement(IBData.Ref, IBData.Terms, IBData.BusinessOperation);
		DefaultParameters.Date = IBData.Date;
		DefaultParameters.Number = IBData.Number;
		
		If DefaultParameters.TypeOfAgreement = "WithConsignee" Then
			CalculationsInConventionalUnits = False;
		Else
			If ValueIsFilled(IBData.Terms) Then
				UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
				CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
			Else
				CalculationsInConventionalUnits = False;
			EndIf;
		EndIf;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", IBData.Ref, IBData.Terms, IBData.SalesOpportunity);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		
		XDTOData.Insert("Contract", Contract);
		XDTOData.Insert("CalculationsInConventionalUnits", CalculationsInConventionalUnits);
	EndIf;
	
	XDTOData.Insert("ARAPCurrency", ARAPCurrency);
	
	UploadRateAndMultiplicityOfSettlements(XDTOData, ARAPCurrency, IBData.Date, IBData.Organization);
	UploadPartnerSContactPerson(IBData, XDTOData, ExchangeComponents);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		XDTOData.Insert("DeliveryMethod", IBData.DeliveryMethod);
	EndIf;
	
	// Table parts
	QueryText =
		"SELECT
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Products AS Products,
		|	ISNULL(ProductsCatalog.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) AS ItemsType,
		|	ISNULL(ProductsCatalog.SaleRegistrationOption, VALUE(Enum.SalesRegistrationOptions.EmptyRef)) AS SaleRegistrationOption,
		|	CASE
		|		WHEN Goods.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|			THEN CASE
		|					WHEN CharacteristicsCatalog.DescriptionFull = """"
		|						THEN CharacteristicsCatalog.Description
		|					ELSE CharacteristicsCatalog.DescriptionFull
		|				END
		|		ELSE """"
		|	END AS CharacteristicName,
		|	CASE
		|		WHEN ProductsCatalog.DescriptionFull = """"
		|			THEN ProductsCatalog.Description
		|		ELSE ProductsCatalog.DescriptionFull
		|	END AS NomenclatureName,
		|	ISNULL(ProductsCatalog.UnitOfMeasure, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS UnitOfMeasure,
		|	CASE
		|		WHEN ISNULL(ProductsCatalog.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) = VALUE(Enum.ItemsTypes.ReusablePackage)
		|				AND Goods.Ref.ToReturnReusablePackage
		|			THEN CAST(""ReturnContainers"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	Goods.Content AS Content,
		|	Goods.Count AS Count,
		|	CASE
		|		WHEN ISNULL(ProductsCatalog.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) = VALUE(Enum.ItemsTypes.OwnGoods)
		|				OR ISNULL(ProductsCatalog.ItemsType, VALUE(Enum.ItemsTypes.EmptyRef)) = VALUE(Enum.ItemsTypes.ReusablePackage)
		|			THEN CASE
		|					WHEN Goods.Count > 0
		|						THEN CAST(Goods.Sum / Goods.Count AS NUMBER(31, 2))
		|					ELSE 0
		|				END
		|		ELSE Goods.Price
		|	END AS Price,
		|	Goods.Sum AS Sum,
		|	Goods.VATRate AS VATRate,
		|	Goods.VATAmount AS VATAmount,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.Package AS Package,
		|	Goods.NumberOfPackages AS NumberOfPackages,
		|	CASE
		|		WHEN Goods.Count > 0
		|			THEN CAST(Goods.Sum / Goods.NumberOfPackages AS NUMBER(31, 2))
		|		ELSE 0
		|	END AS PricePerPackaging,
		|	Goods.PartnerProducts AS SKUCounterparty_,
		|	CASE
		|		WHEN &OneDateReceipt
		|			THEN &DateOfReceipt
		|		ELSE Goods.DateOfShipment
		|	END AS ExpectedDeliveryDate
		|INTO OrderedItems
		|FROM
		|	Document.SalesOrder.Goods AS Goods
		|		LEFT JOIN Catalog.Products AS ProductsCatalog
		|		ON Goods.Products = ProductsCatalog.Ref
		|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicsCatalog
		|		ON Goods.Characteristic = CharacteristicsCatalog.Ref
		|WHERE
		|	Goods.Ref = &Ref
		|	AND Goods.Canceled = FALSE
		|
		|INDEX BY
		|	ItemsType
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.DocumentRowNumber AS DocumentRowNumber,
		|	GoodsTable.Products AS Products,
		|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
		|	GoodsTable.InventoryType AS InventoryType,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Price AS Price,
		|	GoodsTable.Sum AS Sum,
		|	GoodsTable.VATRate AS VATRate,
		|	GoodsTable.VATAmount AS VATAmount,
		|	&TextOfCounterpartySSKURequest,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&RequestTextExpectedDeliveryDate,
		|	GoodsTable.PricePerPackaging AS PricePerPackaging
		|FROM
		|	OrderedItems AS GoodsTable
		|WHERE
		|	(GoodsTable.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|			OR GoodsTable.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|ORDER BY
		|	GoodsTable.DocumentRowNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TableServices.DocumentRowNumber AS DocumentRowNumber,
		|	TableServices.Products AS Products,
		|	CASE
		|		WHEN TableServices.SaleRegistrationOption = VALUE(Enum.SalesRegistrationOptions.CustomerInvoiceServices)
		|				OR TableServices.SaleRegistrationOption = VALUE(Enum.SalesRegistrationOptions.DeedOfTransfer)
		|			THEN TableServices.Content
		|		ELSE CASE
		|				WHEN TableServices.CharacteristicName = """"
		|					THEN TableServices.NomenclatureName
		|				ELSE TableServices.NomenclatureName + "" ("" + TableServices.CharacteristicName + "")""
		|			END
		|	END AS Content,
		|	TableServices.UnitOfMeasure AS UnitOfMeasure,
		|	TableServices.Count AS Count,
		|	TableServices.Price AS Price,
		|	TableServices.Sum AS Sum,
		|	TableServices.VATRate AS VATRate,
		|	TableServices.VATAmount AS VATAmount,
		|	&RequestTextExpectedServiceDeliveryDate,
		|	&RequestTextCounterpartyService
		|FROM
		|	OrderedItems AS TableServices
		|WHERE
		|	(TableServices.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
		|			OR TableServices.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
		|
		|ORDER BY
		|	TableServices.DocumentRowNumber
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	&PaymentMethod AS PaymentMethod,
		|	SalesOrderPaymentScheduleSteps.PaymentOption AS PaymentOption,
		|	SalesOrderPaymentScheduleSteps.PaymentDate AS PaymentDate,
		|	SalesOrderPaymentScheduleSteps.PaymentPercentage AS PaymentPercentage,
		|	SalesOrderPaymentScheduleSteps.PaymentAmount AS PaymentAmount,
		|	SalesOrderPaymentScheduleSteps.Move AS NumberOfDaysOfDeferral
		|FROM
		|	Document.SalesOrder.PaymentScheduleSteps AS SalesOrderPaymentScheduleSteps
		|WHERE
		|	SalesOrderPaymentScheduleSteps.Ref = &Ref
		|	AND SalesOrderPaymentScheduleSteps.PaymentAmount > 0
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	MAX(OrderedItems.ExpectedDeliveryDate) AS ExpectedDeliveryDate
		|FROM
		|	OrderedItems AS OrderedItems
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	OrderedItems.Products AS Products,
		|	OrderedItems.Characteristic AS Characteristic,
		|	OrderedItems.Package AS Package,
		|	ItemsBarcodes.Barcode AS Barcode
		|FROM
		|	InformationRegister.ItemsBarcodes AS ItemsBarcodes
		|		INNER JOIN OrderedItems AS OrderedItems
		|		ON (OrderedItems.Products = ItemsBarcodes.Products)
		|			AND (OrderedItems.Characteristic = ItemsBarcodes.Characteristic)
		|			AND (OrderedItems.Package = ItemsBarcodes.Package)
		|WHERE
		|	OrderedItems.Package.Owner <> VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure)
		|
		|UNION ALL
		|
		|SELECT DISTINCT
		|	OrderedItems.Products,
		|	OrderedItems.Characteristic,
		|	OrderedItems.Package,
		|	ItemsBarcodes.Barcode
		|FROM
		|	InformationRegister.ItemsBarcodes AS ItemsBarcodes
		|		INNER JOIN OrderedItems AS OrderedItems
		|		ON (OrderedItems.Products = ItemsBarcodes.Products)
		|			AND (OrderedItems.Characteristic = ItemsBarcodes.Characteristic)
		|			AND (OrderedItems.Package.Owner = VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure))";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "GoodsTable"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "GoodsTable"));
	
	QueryText = StrReplace(QueryText, "&TextOfCounterpartySSKURequest",
			TextOfCounterpartySSKURequest(ExchangeComponents, "GoodsTable",
			NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8")));
		
	QueryText = StrReplace(QueryText, "&RequestTextCounterpartyService",
		TextOfCounterpartySSKURequest(ExchangeComponents, "TableServices",
		NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8")));
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
		RequestTextExpectedDeliveryDate = "GoodsTable.ExpectedDeliveryDate AS ExpectedDeliveryDate";
		RequestTextExpectedServiceDeliveryDate = "TableServices.ExpectedDeliveryDate AS ExpectedDeliveryDate";
	Else
		RequestTextExpectedDeliveryDate = "UNDEFINED AS ExpectedDeliveryDate";
		RequestTextExpectedServiceDeliveryDate = "UNDEFINED AS ExpectedDeliveryDate";
	EndIf;
	
	QueryText = StrReplace(QueryText, "&RequestTextExpectedDeliveryDate",
		RequestTextExpectedDeliveryDate);
	
	QueryText = StrReplace(QueryText, "&RequestTextExpectedServiceDeliveryDate",
		RequestTextExpectedServiceDeliveryDate);
		
	Query = New Query(QueryText);
		
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("OneDateReceipt", IBData.NotShipInInstallments);
	Query.SetParameter("DateOfReceipt", IBData.DateOfShipment);
	Query.SetParameter("PaymentMethod", ?(ValueIsFilled(IBData.PaymentMethod),
		IBData.PaymentMethod, Enums.PaymentForms.BankAccountPayment));
	
	QueryResult = Query.ExecuteBatch();
	
	Goods = QueryResult[1].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	FillInWHBarcodes(ExchangeComponents, Goods, QueryResult[5].Unload());
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("Goods", Goods);
	
	Services = QueryResult[2].Unload();
	FillInProductListOfVHFCounterparty(ExchangeComponents, Services, IBData.Counterparty); 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Services, False);
	EndIf;
	XDTOData.Insert("Services", Services);
		
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		XDTOData.Insert("Comment", IBData.Comment);
	EndIf;	
	PaymentSteps = QueryResult[3].Unload();
	For Each Page1 In PaymentSteps Do
	   If Page1.PaymentMethod = Enums.PaymentForms.InstantPayments Then
	      Page1.PaymentMethod = Enums.PaymentForms.BankAccountPayment;
	   EndIf;
	EndDo;
	 	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
		XDTOData.Insert("PaymentSteps", PaymentSteps);
		
		AttributeNameDateOfDelivery = "ExpectedDeliveryDate";
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
			
			AttributeNameDateOfDelivery = "DeliveryDateToCustomer";
			
			XDTOData.Insert("DeliveryTimeFrom", IBData.DeliveryTimeFrom); 
			XDTOData.Insert("DeliveryTimeTo", IBData.DeliveryTimeTo);   
			
		EndIf;
		
		AggregatedData = QueryResult[4].Unload();
		
		If AggregatedData.Count() > 0 Then
			XDTOData.Insert(AttributeNameDateOfDelivery, AggregatedData[0].ExpectedDeliveryDate);
		EndIf;  
		
	EndIf;
EndProcedure

