	SaleVATDocuments.Add("CommercialProposalForCustomer");
	SaleVATDocuments.Add("ConsignmentReportFromCustomer");
	SaleVATDocuments.Add("WriteOffReportFromCommissionAgent");
	SaleVATDocuments.Add("RetailSalesReport");
	SaleVATDocuments.Add("RetailReturnsReport");
	SaleVATDocuments.Add("CommissionReportIntercompany");
	SaleVATDocuments.Add("CustomerInvoiceIntercompany");
	SaleVATDocuments.Add("CustomerInvoice");
