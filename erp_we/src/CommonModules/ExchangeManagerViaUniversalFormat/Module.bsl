	XDTOData.Insert("Sum", IBData.DocumentAmount);
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData, "Counterparty, Organization");
		DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithVendor";
		XDTOData.Insert("Contract", ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents));
	EndIf;
	QueryText = 
		"SELECT
		|	Tab.Products AS Products,
		|	Tab.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	Tab.Count AS Count,
		|	CASE
		|		WHEN Tab.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|			THEN CAST(""ReturnContainers"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType
		|FROM
		|	Document.ReceiptOfGoodsFromCustodian.Goods AS Tab
		|WHERE
		|	Tab.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Tab"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Tab"));
	
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "Tab"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "IncomeForActivities", "");
	XDTOData.Insert("Goods", Goods);
EndProcedure


