Procedure OCR_Catalog_GiftCertificateKinds_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	TypeOfValidityPeriod = Undefined;  
	GiftCardAccounting25 = False;
	NumberOfValidityPeriods = Undefined;
	If IBData.ActionPeriod = Enums.Periodicity.Day Then
		TypeOfValidityPeriod = "Day";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods;
	ElsIf IBData.ActionPeriod = Enums.Periodicity.Week Then
		TypeOfValidityPeriod = "Day";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods * 7;
	ElsIf IBData.ActionPeriod = Enums.Periodicity.TenDays Then
		TypeOfValidityPeriod = "Day";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods * 10;
	ElsIf IBData.ActionPeriod = Enums.Periodicity.Month Then
		TypeOfValidityPeriod = "Month";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods;
	ElsIf IBData.ActionPeriod = Enums.Periodicity.Quarter Then
		TypeOfValidityPeriod = "Month";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods * 3;
	ElsIf IBData.ActionPeriod = Enums.Periodicity.HalfYear Then
		TypeOfValidityPeriod = "Month";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods * 6;
	ElsIf IBData.ActionPeriod = Enums.Periodicity.Year Then
		TypeOfValidityPeriod = "Month";
		NumberOfValidityPeriods = IBData.NumberOfValidityPeriods * 12;
	EndIf;
	If ValueIsFilled(TypeOfValidityPeriod) And ValueIsFilled(NumberOfValidityPeriods) Then
		XDTOData.Insert("TypeOfValidityPeriod", TypeOfValidityPeriod);
		XDTOData.Insert("NumberOfValidityPeriods", NumberOfValidityPeriods);
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then 
		If ValueIsFilled(IBData.Organization) Then
			XDTOData.Insert("Organization", IBData.Organization);
		EndIf;		
	EndIf; 
	
	Query = New Query;
	Query.Text =
		"SELECT
		|	GiftCertificateKindsGiftCertificateCodeTemplates.LineNumber AS LineNumber,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.BarcodeLength AS BarcodeLength,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.StartOfBarcodeRange AS StartOfBarcodeRange,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.EndOfBarcodeRange AS EndOfBarcodeRange,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.MagneticCodeLength AS MagneticCodeLength,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.StartOfMagneticCodeRange AS StartOfMagneticCodeRange,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.EndOfMagneticCodeRange AS EndOfMagneticCodeRange,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.MagneticStripeCardTemplate AS MagneticStripeCardTemplate,
		|	GiftCertificateKindsGiftCertificateCodeTemplates.Ref.GiftCardAccounting25 AS GiftCardAccounting25
		|INTO TTPSCodeTemplates
		|FROM
		|	Catalog.GiftCertificateKinds.GiftCertificateCodeTemplates AS GiftCertificateKindsGiftCertificateCodeTemplates
		|WHERE
		|	GiftCertificateKindsGiftCertificateCodeTemplates.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTPSCodeTemplates.MagneticStripeCardTemplate AS MagneticStripeCardTemplate,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.TrackAvailability1 AS TrackAvailability,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.Prefix1 AS Prefix,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.Suffix1 AS Suffix,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.CodeLength1 AS CodeLength,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.BlockSeparator1 AS BlockSeparator,
		|	MagneticStripeCardTemplatesTrackFields1.Field AS Field,
		|	MagneticStripeCardTemplatesTrackFields1.BlockNumber AS BlockNumber,
		|	MagneticStripeCardTemplatesTrackFields1.NumberOfFirstCharacter AS NumberOfFirstCharacter,
		|	MagneticStripeCardTemplatesTrackFields1.FieldLength AS FieldLength,
		|	""Track1"" AS Track
		|FROM
		|	TTPSCodeTemplates AS TTPSCodeTemplates
		|		LEFT JOIN Catalog.MagneticStripeCardTemplates.TrackFields1 AS MagneticStripeCardTemplatesTrackFields1
		|		ON TTPSCodeTemplates.MagneticStripeCardTemplate = MagneticStripeCardTemplatesTrackFields1.Ref
		|			AND (TTPSCodeTemplates.MagneticStripeCardTemplate.TrackAvailability1)
		|
		|UNION ALL
		|
		|SELECT
		|	TTPSCodeTemplates.MagneticStripeCardTemplate,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.TrackAvailability2,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.Prefix2,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.Suffix2,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.CodeLength2,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.BlockSeparator2,
		|	MagneticStripeCardTemplatesTrackFields2.Field,
		|	MagneticStripeCardTemplatesTrackFields2.BlockNumber,
		|	MagneticStripeCardTemplatesTrackFields2.NumberOfFirstCharacter,
		|	MagneticStripeCardTemplatesTrackFields2.FieldLength,
		|	""Track2""
		|FROM
		|	TTPSCodeTemplates AS TTPSCodeTemplates
		|		LEFT JOIN Catalog.MagneticStripeCardTemplates.TrackFields2 AS MagneticStripeCardTemplatesTrackFields2
		|		ON TTPSCodeTemplates.MagneticStripeCardTemplate = MagneticStripeCardTemplatesTrackFields2.Ref
		|			AND (TTPSCodeTemplates.MagneticStripeCardTemplate.TrackAvailability2)
		|
		|UNION ALL
		|
		|SELECT
		|	TTPSCodeTemplates.MagneticStripeCardTemplate,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.TrackAvailability3,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.Prefix3,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.Suffix3,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.CodeLength3,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate.BlockSeparator3,
		|	MagneticStripeCardTemplatesTrackFields3.Field,
		|	MagneticStripeCardTemplatesTrackFields3.BlockNumber,
		|	MagneticStripeCardTemplatesTrackFields3.NumberOfFirstCharacter,
		|	MagneticStripeCardTemplatesTrackFields3.FieldLength,
		|	""Track3""
		|FROM
		|	TTPSCodeTemplates AS TTPSCodeTemplates
		|		LEFT JOIN Catalog.MagneticStripeCardTemplates.TrackFields3 AS MagneticStripeCardTemplatesTrackFields3
		|		ON TTPSCodeTemplates.MagneticStripeCardTemplate = MagneticStripeCardTemplatesTrackFields3.Ref
		|			AND (TTPSCodeTemplates.MagneticStripeCardTemplate.TrackAvailability3)
		|TOTALS BY
		|	MagneticStripeCardTemplate,
		|	Track
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTPSCodeTemplates.LineNumber AS LineNumber,
		|	TTPSCodeTemplates.BarcodeLength AS BarcodeLength,
		|	TTPSCodeTemplates.StartOfBarcodeRange AS StartOfBarcodeRange,
		|	TTPSCodeTemplates.EndOfBarcodeRange AS EndOfBarcodeRange,
		|	TTPSCodeTemplates.MagneticCodeLength AS MagneticCodeLength,
		|	TTPSCodeTemplates.StartOfMagneticCodeRange AS StartOfMagneticCodeRange,
		|	TTPSCodeTemplates.EndOfMagneticCodeRange AS EndOfMagneticCodeRange,
		|	TTPSCodeTemplates.MagneticStripeCardTemplate AS MagneticCardTemplateLink,
		|	TTPSCodeTemplates.GiftCardAccounting25 AS GiftCardAccounting25
		|FROM
		|	TTPSCodeTemplates AS TTPSCodeTemplates";
	
	Query.SetParameter("Ref", IBData.Ref);
	
	Result = Query.ExecuteBatch();
	Templates = New Map;
	TemplateStructure_ = New Structure("Track1, Track2, Track3");
	
	SampleTemplates = Result[1].Select(QueryResultIteration.ByGroups);
	While SampleTemplates.Next() Do
		TrackSelection = SampleTemplates.Select(QueryResultIteration.ByGroups);
		While TrackSelection.Next() Do
			TrackFields 		= New Array;
			TrackStructure 	= New Structure("TrackAvailability, Prefix, Suffix, CodeLength, BlockSeparator, TrackFields");
			
			FillPropertyValues(TrackStructure, TrackSelection);
			
			TrackFieldSelection = TrackSelection.Select();
			While TrackFieldSelection.Next() Do
				TrackFieldStructure 	= New Structure("Field, BlockNumber, NumberOfFirstCharacter, FieldLength");
				FillPropertyValues(TrackFieldStructure, TrackFieldSelection);
				TrackFields.Add(TrackFieldStructure);
			EndDo;
			
			TrackStructure.TrackFields = TrackFields;
			
			TemplateStructure_[TrackSelection.Track] = TrackStructure;
		EndDo;
		
		Templates.Insert(SampleTemplates.MagneticStripeCardTemplate, TemplateStructure_);
	EndDo;
	
	CodeTemplates = Result[2].Unload();
	CodeTemplates.Columns.Add("MagneticStripeCardTemplate");
	For Each String In CodeTemplates Do
		If ValueIsFilled(String.MagneticCardTemplateLink) Then
			If Templates[String.MagneticCardTemplateLink] <> Undefined  Then
				String.MagneticStripeCardTemplate = ValueToStringInternal(Templates[String.MagneticCardTemplateLink]);
			Else
				String.MagneticStripeCardTemplate = "";
			EndIf;
		EndIf;
		GiftCardAccounting25 = String.GiftCardAccounting25;
	EndDo;
	If XDTOData.Property("AdditionalInfo") And TypeOf(XDTOData.AdditionalInfo)= Type("Structure") Then
		AdditionalData = XDTOData.AdditionalInfo;
	Else
		AdditionalData = New Structure;
	EndIf;
	AdditionalData.Insert("GiftCardAccounting25", GiftCardAccounting25); 
	XDTOData.Insert("AdditionalInfo", AdditionalData);
	XDTOData.Insert("CodeTemplates", CodeTemplates);
EndProcedure


