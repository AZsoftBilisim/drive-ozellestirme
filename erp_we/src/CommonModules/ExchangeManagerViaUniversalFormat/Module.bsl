Procedure PCO_ReportCommissionBetweenOrganizations_CommissionAgent_Sender_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "I";
		DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
		XDTOData.KeyProperties.Insert("Number", DocNumber);
		
		If IBData.ARAPAccountingViaSeparateCounterparty Then
			CounterpartyRef = IBData.Counterparty;
		Else
			CounterpartyRef = CounterpartyFromOrganization(IBData.Consignee, ExchangeComponents);
		EndIf;
		XDTOData.KeyProperties.Insert("Counterparty", CounterpartyRef);
		
		If ExportStack.Count() > 1 Then
			Return;
		EndIf;
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			SetRuleForPCRTabPart(ExchangeComponents,
											"ReportCommissionBetweenOrganizations_CommissionAgent__", 
											"Goods", 
											"CCDNumber",
											True,
											"Catalog_CCDNumbers_Send");
		EndIf;
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
			SetRuleForPCRTabPart(ExchangeComponents,
										"ReportCommissionBetweenOrganizations_CommissionAgent__", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
		EndIf;
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
			XDTOData.KeyProperties.Insert("TypeOfOperationOfCommissionaireSReport", "SaleOfGoodsOnCommission");  
		EndIf;
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then 
			VATRateOfRemuneration = VATRateAccordingToCatalog(IBData.VATRateOfRemuneration);  
		Else   
			VATRateOfRemuneration = New Structure;
			VATRateOfRemuneration.Insert("Value", IBData.VATRateOfRemuneration);
			VATRateOfRemuneration.Insert("OCRName", "CatalogLink_BIDS_Sending");
		EndIf;
		
		XDTOData.Insert("VATRateOfRemuneration", VATRateOfRemuneration);
		
		XDTOData.Insert("IncomingDocumentNumber", ObjectsPrefixesClientServer.NumberForPrinting(DocNumber, False, True));
		
		UnloadDivision(IBData, XDTOData);
		
		#Region Contract
		
		InstructionsContract = Undefined;
		If IBData.ARAPAccountingViaSeparateCounterparty
			And ValueIsFilled(IBData.PurchasingContract)
			And Common.RefExists(IBData.PurchasingContract) Then
			
			InstructionsContract = New Structure;
			InstructionsContract.Insert("OCRName",   "Catalog_CounterpartyContracts");
			InstructionsContract.Insert("Value", IBData.PurchasingContract);
			
		ElsIf ValueIsFilled(IBData.Contract) Then
			
			InstructionsContract = New Structure;
			InstructionsContract.Insert("OCRName",   "Catalog_IntercompanyContracts");
			InstructionsContract.Insert("Value", IBData.Contract);
			
		Else
			DefaultParameters = New Structure(ContractFixedKeyStructure());
			DefaultParameters.TypeOfAgreement              = "WithConsignee";
			DefaultParameters.Organization              = IBData.Organization;
			DefaultParameters.Counterparty               = CounterpartyRef;
			DefaultParameters.ARAPCurrency     = IBData.Currency;
			DefaultParameters.CalculationsInConventionalUnits = False;
			
			InstructionsContract = ConversionAgreementBasedOnSettlementData(DefaultParameters,
			ExchangeComponents,
			IBData.Contract);
		EndIf;
		XDTOData.Insert("Contract", InstructionsContract);
		
		#EndRegion
		
		UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
		
		XDTOData.Insert("AmountIncludesVAT", True);
		
		// Tabular parts.
		
		Query = New Query(
		"SELECT
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Ref AS Ref,
		|	Goods.Ref.Organization AS Organization,
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Count AS Count,
		|	Goods.VATRate AS VATRate,
		|	CASE
		|		WHEN Goods.AmountIncludingVAT / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.AmountIncludingVAT / Goods.Count AS NUMBER(31, 2))
		|	END AS TransferPrice,
		|	Goods.AmountIncludingVAT AS TransferAmount,
		|	CASE
		|		WHEN Goods.SalesAmount / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.SalesAmount / Goods.Count AS NUMBER(31, 2))
		|	END AS Price,
		|	Goods.SalesAmount AS Sum,
		|	Goods.AmountSalesVAT AS VATAmount,
		|	Goods.CommissionAmount AS CommissionAmount,
		|	Goods.Customer AS Customer,
		|	Goods.DateOfTaxInvoiceIssuedByCommissionAgent AS InvoiceDate,
		|	CatProducts_.AccountingFeature AS AccountingFeature,
		|	CatProducts_.ItemsType AS ItemsType,
		|	CASE
		|		WHEN Goods.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|			THEN CASE
		|					WHEN CharacteristicsOfCat.DescriptionFull = """"
		|						THEN CharacteristicsOfCat.Description
		|					ELSE CharacteristicsOfCat.DescriptionFull
		|				END
		|		ELSE """"
		|	END AS CharacteristicName,
		|	CASE
		|		WHEN CatProducts_.DescriptionFull = """"
		|			THEN CatProducts_.Description
		|		ELSE CatProducts_.DescriptionFull
		|	END AS NomenclatureName,
		|	Goods.CCDNumber AS CCDNumber
		|INTO TTProducts_1
		|FROM
		|	Document.CommissionReportIntercompany.Goods AS Goods
		|		LEFT JOIN Catalog.Products AS CatProducts_
		|		ON (CatProducts_.Ref = Goods.Products)
		|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicsOfCat
		|		ON (CharacteristicsOfCat.Ref = Goods.Characteristic)
		|WHERE
		|	Goods.Ref = &Ref
		|	AND Goods.Count > 0
		|
		|GROUP BY
		|	Goods.LineNumber,
		|	Goods.Ref,
		|	Goods.Ref.Organization,
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.Products.UnitOfMeasure,
		|	Goods.Count,
		|	Goods.VATRate,
		|	CASE
		|		WHEN Goods.AmountIncludingVAT / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.AmountIncludingVAT / Goods.Count AS NUMBER(31, 2))
		|	END,
		|	Goods.AmountIncludingVAT,
		|	CASE
		|		WHEN Goods.SalesAmount / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.SalesAmount / Goods.Count AS NUMBER(31, 2))
		|	END,
		|	Goods.SalesAmount,
		|	Goods.AmountSalesVAT,
		|	Goods.CommissionAmount,
		|	CASE
		|		WHEN Goods.Count < 0
		|			THEN TRUE
		|		ELSE FALSE
		|	END,
		|	Goods.Customer,
		|	Goods.DateOfTaxInvoiceIssuedByCommissionAgent,
		|	CatProducts_.AccountingFeature,
		|	CatProducts_.ItemsType,
		|	CASE
		|		WHEN Goods.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|			THEN CASE
		|					WHEN CharacteristicsOfCat.DescriptionFull = """"
		|						THEN CharacteristicsOfCat.Description
		|					ELSE CharacteristicsOfCat.DescriptionFull
		|				END
		|		ELSE """"
		|	END,
		|	CASE
		|		WHEN CatProducts_.DescriptionFull = """"
		|			THEN CatProducts_.Description
		|		ELSE CatProducts_.DescriptionFull
		|	END,
		|	Goods.CCDNumber
		|
		|INDEX BY
		|	Goods.Ref,
		|	Organization,
		|	Customer,
		|	InvoiceDate
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	DistributionTable_1.DocumentRowNumber AS DocumentRowNumber,
		|	DistributionTable_1.Products AS Products,
		|	DistributionTable_1.Characteristic AS Characteristic,
		|	DistributionTable_1.UnitOfMeasure AS UnitOfMeasure,
		|	DistributionTable_1.VATRate AS VATRate,
		|	DistributionTable_1.CommissionAmount AS CommissionAmount,
		|	DistributionTable_1.Customer AS Customer,
		|	DistributionTable_1.InvoiceDate AS InvoiceDate,
		|	DistributionTable_1.ItemsType AS ItemsType,
		|	0 AS AmountVATRemuneration
		|FROM
		|	TTProducts_1 AS DistributionTable_1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.DocumentRowNumber AS DocumentRowNumber,
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Count AS Count,
		|	Goods.VATRate AS VATRate,
		|	Goods.TransferPrice AS TransferPrice,
		|	Goods.TransferAmount AS TransferAmount,
		|	Goods.Price AS Price,
		|	Goods.Sum AS Sum,
		|	Goods.VATAmount AS VATAmount,
		|	Goods.CommissionAmount AS CommissionAmount,
		|	Goods.Customer AS Customer,
		|	Goods.InvoiceDate AS InvoiceDate,
		|	FALSE AS TypesOfStocksFilled,
		|	1 AS ZoomRatio,
		|	1 AS RowKey,
		|	CAST(&OwnProducts AS STRING(50)) AS InventoryType,
		|	&GoodsCCDNumber AS CCDNumber,
		|	VALUE(Catalog.WorldCountries.EmptyRef) AS OriginCountry,
		|	0 AS AmountVATRemuneration
		|FROM
		|	TTProducts_1 AS Goods
		|WHERE
		|	Goods.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Services.DocumentRowNumber AS DocumentRowNumber,
		|	Services.Products AS Products,
		|	Services.Characteristic AS Characteristic,
		|	CASE
		|		WHEN Services.CharacteristicName = """"
		|			THEN Services.NomenclatureName
		|		ELSE Services.NomenclatureName + "" ("" + Services.CharacteristicName + "")""
		|	END AS Content,
		|	Services.Count AS Count,
		|	Services.VATRate AS VATRate,
		|	Services.Price AS Price,
		|	Services.Sum AS Sum,
		|	Services.VATAmount AS VATAmount,
		|	Services.CommissionAmount AS CommissionAmount,
		|	Services.Customer AS Customer,
		|	Services.InvoiceDate AS InvoiceDate,
		|	1 AS RowKey,
		|	0 AS AmountVATRemuneration
		|FROM
		|	TTProducts_1 AS Services
		|WHERE
		|	Services.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
		|	AND Services.AccountingFeature <> VALUE(Enum.ItemAccountingFeatures.PerformedBySellerCompany)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.Count AS Count,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
		|			THEN CASE
		|					WHEN InventoryKinds.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|						THEN CAST(""CommissionGoods"" AS STRING(20))
		|					ELSE CAST(&OwnProducts AS STRING(20))
		|				END
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	CASE
		|		WHEN InventoryKinds.Count < 0
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ReversingEntry,
		|	InventoryKinds.DateOfTaxInvoiceIssuedByCommissionAgent AS InvoiceDate,
		|	InventoryKinds.Customer AS Customer,
		|	Dimension.Products AS Products,
		|	Dimension.Characteristic AS Characteristic
		|FROM
		|	Document.CommissionReportIntercompany.InventoryKinds AS InventoryKinds
		|		INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
		|		ON InventoryKinds.ItemsLocationAttributes = Dimension.DimensionKey
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|	AND InventoryKinds.Count > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	1 AS RowKey,
		|	CASE
		|		WHEN TTProducts_1.Customer = VALUE(Catalog.Counterparties.EmptyRef)
		|			THEN TTProducts_1.Ref.Counterparty
		|		ELSE TTProducts_1.Customer
		|	END AS Customer,
		|	MIN(TTProducts_1.DocumentRowNumber) AS OrderingValue
		|FROM
		|	TTProducts_1 AS TTProducts_1
		|
		|GROUP BY
		|	CASE
		|		WHEN TTProducts_1.Customer = VALUE(Catalog.Counterparties.EmptyRef)
		|			THEN TTProducts_1.Ref.Counterparty
		|		ELSE TTProducts_1.Customer
		|	END
		|");
		
		FillInYourOwnProductsInText(Query.Text);
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			GoodsCCDNumber = "Goods.CCDNumber";
		Else
			GoodsCCDNumber = "ISNULL(Goods.CCDNumber.Code, """")";
		EndIf;
		
		Query.Text = StrReplace(Query.Text, "&GoodsCCDNumber" , GoodsCCDNumber); 
		
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "Dimension"));
		
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
		
		Query.SetParameter("Ref", IBData.Ref);
		QueryResults = Query.ExecuteBatch();
		
		// Unloading tables from the query
		
		DistributionTab = QueryResults[1].Unload();
		TabProducts        = QueryResults[2].Unload();
		OtherServices        = QueryResults[3].Unload();
		InventoryKinds      = QueryResults[4].Select();
		Tobacco_    = QueryResults[5].Unload();
		
		SearchAttributes = "Products,Characteristic,InvoiceDate,Customer";
		
		// Distribution of VAT remuneration
		
		BaseOfDistributionByAmountOfRemuneration = DistributionTab.UnloadColumn("CommissionAmount");
		DistributionOfVATRemuneration = Common.DistributeAmountInProportionToCoefficients(IBData.AmountVATRemuneration, 
		BaseOfDistributionByAmountOfRemuneration);
		
		If ValueIsFilled(DistributionOfVATRemuneration) Then
			DistributionTab.LoadColumn(DistributionOfVATRemuneration, "AmountVATRemuneration");
		EndIf;
		
		TheStructureOfTheSearch = New Structure(SearchAttributes + ",VATRate");
		DetailsToFillIn = "AmountVATRemuneration";
		
		TabProducts.Indexes.Add(SearchAttributes + ",VATRate");
		
		For Each DistributionTableRow In DistributionTab Do
			
			FillPropertyValues(TheStructureOfTheSearch, DistributionTableRow);
			
			If DistributionTableRow.ItemsType = Enums.ItemsTypes.OwnGoods Then
				FoundRows = TabProducts.FindRows(TheStructureOfTheSearch);
			ElsIf DistributionTableRow.ItemsType = Enums.ItemsTypes.OperationService Then
				FoundRows = OtherServices.FindRows(TheStructureOfTheSearch);
			EndIf;
			
			For Each DocumentLine In FoundRows Do
				FillPropertyValues(DocumentLine, DistributionTableRow, DetailsToFillIn);
			EndDo;
			
		EndDo;
		
		// Distribution of goods by type of inventory
		
		TheStructureOfTheSearch = New Structure(SearchAttributes + ",TypesOfStocksFilled");
		DetailsToFillIn = "InventoryType";
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			DetailsToFillIn = DetailsToFillIn + ", UnitOfTraceability, TracedGoods, NumberOfRNPT, OriginCountry";
			TabProducts.Columns.Add("UnitOfTraceability");
			TabProducts.Columns.Add("TracedGoods");
			TabProducts.Columns.Add("NumberOfRNPT"); 
		Else
			DetailsToFillIn = DetailsToFillIn + ", OriginCountry";
		EndIf;
		
		TabProducts.Indexes.Add(SearchAttributes + ",TypesOfStocksFilled");
		
		While InventoryKinds.Next() Do
			
			FillPropertyValues(TheStructureOfTheSearch, InventoryKinds, SearchAttributes);
			TheStructureOfTheSearch.TypesOfStocksFilled = False;
			
			FoundRows = TabProducts.FindRows(TheStructureOfTheSearch);
			
			RemainingInventoryKinds = InventoryKinds.Count;
			For Each DocumentLine In FoundRows Do
				
				If RemainingInventoryKinds = 0 Then
					Break;
				EndIf;
				
				If DocumentLine.Count <= RemainingInventoryKinds Then
					
					FillPropertyValues(DocumentLine, InventoryKinds, DetailsToFillIn);
					DocumentLine.TypesOfStocksFilled = True;
					If Not ValueIsFilled(DocumentLine.CCDNumber) Then
						DocumentLine.CCDNumber = InventoryKinds.CCDNumber;
					EndIf;
					RemainingInventoryKinds = RemainingInventoryKinds - DocumentLine.Count;
					
				Else
					
					// Selecting a new line with a filled inventory view.
					NewRow = TabProducts.Add();
					FillPropertyValues(NewRow, DocumentLine);
					
					PercentageOfInventoryTypeInDocumentLine = RemainingInventoryKinds / DocumentLine.Count;
					
					NewRow.Count             = RemainingInventoryKinds;
					NewRow.TransferAmount          = Round(DocumentLine.TransferAmount * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.Sum                  = Round(DocumentLine.Sum * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.VATAmount               = Round(DocumentLine.VATAmount * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.CommissionAmount    = Round(DocumentLine.CommissionAmount * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.AmountVATRemuneration = Round(DocumentLine.AmountVATRemuneration * PercentageOfInventoryTypeInDocumentLine, 2);
					
					FillPropertyValues(NewRow, InventoryKinds, DetailsToFillIn);
					
					DocumentLine.Count             = DocumentLine.Count - NewRow.Count;
					DocumentLine.TransferAmount          = DocumentLine.TransferAmount - NewRow.TransferAmount;
					DocumentLine.Sum                  = DocumentLine.Sum - NewRow.Sum;
					DocumentLine.VATAmount               = DocumentLine.VATAmount - NewRow.VATAmount;
					DocumentLine.CommissionAmount    = DocumentLine.CommissionAmount - NewRow.CommissionAmount;
					DocumentLine.AmountVATRemuneration = DocumentLine.AmountVATRemuneration - NewRow.AmountVATRemuneration;
					
					RemainingInventoryKinds = 0;
					
				EndIf;
				
			EndDo;
			
		EndDo;
		
		TabProducts.Sort("DocumentRowNumber Asc");
		OtherServices.Sort("DocumentRowNumber Asc");
		
		// Establishing links between the buyers table and the tables of goods and services.
		
		TheStructureOfTheSearch = New Structure("Customer");
		
		DetailsToFillIn = "RowKey";
		
		For Each String In Tobacco_ Do
			
			String.RowKey = Tobacco_.IndexOf(String) + 1;
			
			FillPropertyValues(TheStructureOfTheSearch, String);
			
			FoundProductLines = TabProducts.FindRows(TheStructureOfTheSearch);
			FoundServiceLines   = OtherServices.FindRows(TheStructureOfTheSearch);
			
			For Each RowOfGoods In FoundProductLines Do
				FillPropertyValues(RowOfGoods, String, DetailsToFillIn);
			EndDo;
			
			For Each ServiceLine_ In FoundServiceLines Do
				FillPropertyValues(ServiceLine_, String, DetailsToFillIn);
			EndDo;
			
		EndDo;
		
		FillInCharacteristicsOfWHPackage(ExchangeComponents, TabProducts, True, False);
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
			RedefineVATRateForOldFormats(TabProducts, False);
		EndIf;
		XDTOData.Insert("Goods", TabProducts);
		XDTOData.Insert("Buyers", Tobacco_);
		If ValueIsFilled(IBData.ExpenseItem) Then
			CostAccount = AccountingInvoiceForArticle(IBData.ExpenseItem, IBData.Organization, IBData.Department, IBData.Date);
			XDTOData.Insert("CostItem", IBData.ExpenseItem);
			XDTOData.Insert("CostAccount",   CostAccount);
		EndIf;
		UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

Procedure AddICO_ReportCommissionBetweenOrganizations_Commitee_Sending(ConversionRules)
	ConversionRule = DataExchangeXDTOServer.InitializeObjectConversionRule(ConversionRules);
	ConversionRule.OCRName            = "ReportCommissionBetweenOrganizations_Commitee_Sending";
	ConversionRule.DataObject      = Metadata.Documents.CommissionReportIntercompany;
	ConversionRule.FormatObject     = "Документ.ОтчетКомитенту"; //@NON-NLS-1
	ConversionRule.OnSendData = "PCO_ReportCommissionBetweenOrganizations_Commitee_Sending_WhenSendingData";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "Currency",                      "Currency", , "Catalog_Currencies");
	AddPCR(HeaderProperties, "FinancialAccountingGroup",      "GroupOfFinancialAccountingSettingsForSettlements", , "Catalog_GRFinancialAccountingCalculations_Sending");
	AddPCR(HeaderProperties, "Date",                        "Date");
	AddPCR(HeaderProperties, "",                            "Contract", 1, "Catalog_ContractsOfCounterparties_FromStructure");
	AddPCR(HeaderProperties, "Consignee",                 "Organization", , "Catalog_Companies_Send");
	AddPCR(HeaderProperties, "Comment",                 "Comment");
	AddPCR(HeaderProperties, "",                            "Counterparty", 1, "Catalog_Counterparties");
	AddPCR(HeaderProperties, "",                            "Multiplier_", 1);
	AddPCR(HeaderProperties, "",                            "TransactionRate", 1);
	AddPCR(HeaderProperties, "Manager",                    "EmployeeResponsible", , "Catalog_Users");
	AddPCR(HeaderProperties, "",                            "Number", 1);
	AddPCR(HeaderProperties, "",                            "Department", 1);
	AddPCR(HeaderProperties, "RemunerationPercentage",       "PercentageOfCommission");
	AddPCR(HeaderProperties, "CommissionFeeCalculationMethod", "MethodOfCalculationOfCommission", , "Transfer_MethodsForCalculatingCommissionIncome");
	AddPCR(HeaderProperties, "",                            "VATRateOfRemuneration", 1);
	AddPCR(HeaderProperties, "",                            "AmountIncludesVAT", 1);
	AddPCR(HeaderProperties, "CommissionAmount",         "CommissionAmount");
	AddPCR(HeaderProperties, "DocumentAmount",              "Sum");
	AddPCR(HeaderProperties, "KeepCommissionFee",      "WithholdCommission");
	AddPCR(HeaderProperties, "OperationService",                      "RewardService", , "Catalog_Products_Send");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "AdditionalAttributes");
	AddPCR(PropertiesOfTS, "", "PropertyValue", 1);
	AddPCR(PropertiesOfTS, "", "Property", 1, "Catalog_AdditionalAttributes");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "ProductBatchIDInformation");
	AddPCR(PropertiesOfTS, "", "UnitOfProductBatchID", 1, "Catalog_UnitsOfMeasurement");
