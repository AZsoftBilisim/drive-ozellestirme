	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False);
	
	CurrencyOfComplianceAccounting = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData, "Counterparty, Organization");
		DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithCustomer";
		XDTOData.Insert("Contract", ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents));
	EndIf;	
	
	Query = New Query;
	
	DocumentHeader = 
		"SELECT
		|	DocumentHeaderData.Currency AS Currency,
		|	DocumentHeaderData.ARAPCurrency AS ARAPCurrency,
		|	DocumentHeaderData.CourseNumerator AS TransactionRate,
		|	DocumentHeaderData.CourseDenominator AS Multiplier_
		|INTO DocumentHeaderData
		|FROM
		|	Document.ReportToMaterialProvider2_5 AS DocumentHeaderData
		|WHERE
		|	DocumentHeaderData.Ref = &Ref";
		
	If IBData.Currency = CurrencyOfComplianceAccounting
		Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
		OperationData = 
			"SELECT
			|	DocumentHeaderData.TransactionRate AS TransactionRate,
			|	DocumentHeaderData.Multiplier_ AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData";
	Else
		OperationData =
			"SELECT
			|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
			|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
			|				&Date,
			|				Currency IN
			|					(SELECT
			|						Doc.Currency
			|					FROM
			|						DocumentHeaderData AS Doc)
			|				AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
			|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency";
	EndIf;
	
	DocumentServices =
		"SELECT
		|	Services.Products AS Products,
		|	Services.Products.Description AS Content,
		|	Services.Products.UnitOfMeasure AS UnitOfMeasure,
		|	Services.Count AS Count,
		|	CASE
		|		WHEN Services.Sum = 0
		|			THEN 0.01
		|		ELSE Services.Price
		|	END AS Price,
		|	CASE
		|		WHEN Services.Sum = 0
		|			THEN 0.01 * Services.Count
		|		ELSE Services.Sum
		|	END AS Sum,
		|	Services.VATAmount AS VATAmount,
		|	Services.Ref.VATRate AS VATRate
		|FROM
		|	Document.ReportToMaterialProvider2_5.ManufacturedProduct AS Services
		|WHERE
		|	Services.Ref = &Ref";
	
	AccountingPolicyParameters = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate(
			"FinancialAccountingPolicy",
			IBData.Organization,
			IBData.Date);
			
	If Not AccountingPolicyParameters = Undefined
		And AccountingPolicyParameters.InventoryValuationMethod =
		Enums.InventoryValuationMethods.FIFORollingValuation Then
		
		TempTableManager = New TempTablesManager;
		
		CostTreeParameters = CostStructure.CostTreeParameters();
		CostTreeParameters.DynamicReading = False;
		CostTreeParameters.ResultTypeTempTableManager = True;
		CostTreeParameters.TempTablesManager = TempTableManager;
		
		CostTreeParameters.ReportParameters.Cost_Data = 3;
		CostTreeParameters.ReportParameters.Recorders.Add(IBData.Ref);
		
		CostStructure.BuildCostTree(CostTreeParameters);
		
		Query = New Query;
		Query.TempTablesManager = TempTableManager;
		
		DocumentMaterials =
			"SELECT
			|	CAST(Costs.Products AS Catalog.Products) AS Products,
			|	CAST(Costs.Characteristic AS Catalog.ItemsCharacteristics) AS Characteristic,
			|	CAST(Costs.Series AS Catalog.ItemsBatches) AS Series,
			|	SUM(Costs.Count) AS Count,
			|	Costs.UnitOfMeasure AS UnitOfMeasure
			|INTO TT_UsedMaterials
			|FROM
			|	Result AS ManufacturedProduct
			|		INNER JOIN Result AS Costs
			|		ON (Costs.ProductsAccountingDimension = ManufacturedProduct.ProductsAccountingDimension)
			|			AND (Costs.LineKind = VALUE(Enum.KindsOfCostTreeRows.LotCosts))
			|			AND (VALUETYPE(Costs.BatchCost) = TYPE(Document.GoodsReceiptForStorage))
			|			AND (CAST(Costs.BatchCost AS Document.GoodsReceiptForStorage).BusinessOperation = VALUE(Enum.BusinessTransactions.ReceiptFromMaterialProvider2_5))
			|WHERE
			|	ManufacturedProduct.LineKind = VALUE(Enum.KindsOfCostTreeRows.ProductsBatch)
			|
			|GROUP BY
			|	Costs.Products,
			|	Costs.Characteristic,
			|	Costs.Series,
			|	Costs.UnitOfMeasure
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	TT_UsedMaterials.Products AS Products,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	CAST(TT_UsedMaterials.Count AS NUMBER(15, 3)) AS Count,
			|	TT_UsedMaterials.UnitOfMeasure AS UnitOfMeasure
			|FROM
			|	TT_UsedMaterials AS TT_UsedMaterials";
		
		DocumentMaterials = StrReplace(DocumentMaterials, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "TT_UsedMaterials"));
			
		DocumentMaterials = StrReplace(DocumentMaterials, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "TT_UsedMaterials"));
	Else
		// A method of estimating the value of goods has been established for the organization ""According to the average for the month."" The report cannot be uploaded.'
		DocumentMaterials = "";
	EndIf;
	
	BatchQueryText = New Array;
	BatchQueryText.Add(DocumentHeader);
	BatchQueryText.Add(OperationData);
	BatchQueryText.Add(DocumentServices);
	
	If ValueIsFilled(DocumentMaterials) Then
		BatchQueryText.Add(DocumentMaterials);
	EndIf;
	
	Query.Text = StrConcat(BatchQueryText, Common.QueryBatchSeparator());
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date",   IBData.Date);
	Query.SetParameter("BaseCurrency", CurrencyOfComplianceAccounting);
	QueryResults = Query.ExecuteBatch();
	
	OperationData = QueryResults[1].Select();
	If OperationData.Next() Then
		XDTOData.Insert("TransactionRate",      OperationData.TransactionRate);
		XDTOData.Insert("Multiplier_", OperationData.Multiplier_);
	EndIf;
	
	OtherServices = QueryResults[2].Unload();
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(OtherServices, False);
	EndIf;
	XDTOData.Insert("Services", OtherServices);
	
	If ValueIsFilled(DocumentMaterials) Then
		Tab_Materials = QueryResults[QueryResults.Count() - 1].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Tab_Materials, True, False);
		XDTOData.Insert("CustomerMaterials", Tab_Materials);
	EndIf;
EndProcedure

