Procedure OCR_Catalog_ResponsiblePersons_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	PersonsResponsibleAndCompanies.Owner AS Organization,
		|	PersonsResponsibleAndCompanies.EmployeeInCharge_ AS ResponsiblePersonKind,
		|	PRESENTATION(PersonsResponsibleAndCompanies.EmployeeInCharge_) AS TypeOfResponsiblePersonByLine,
		|	PersonsResponsibleAndCompanies.Individual AS Individual,
		|	PersonsResponsibleAndCompanies.SignatureRight AS AuthorizedPerson,
		|	PersonsResponsibleAndCompanies.StartDate AS StartDate,
		|	PersonsResponsibleAndCompanies.EndDate AS EndDate,
		|	PersonsResponsibleAndCompanies.NumberOfSignatureRightDocument AS NumberOfSignatureRightDocument,
		|	PersonsResponsibleAndCompanies.DateOfDocumentSignatureRight AS DateOfDocumentSignatureRight,
		|	PersonsResponsibleAndCompanies.SignatureRightDocument AS PresentationOfSignatureRightsDocument,
		|	PersonsResponsibleAndCompanies.JobTitleRef AS JobTitle,
		|	PersonsResponsibleAndCompanies.SignatureRightDocument AS TypeOfDocumentRightToSign
		|FROM
		|	Catalog.PersonsResponsibleAndCompanies AS PersonsResponsibleAndCompanies
		|WHERE
		|	PersonsResponsibleAndCompanies.Ref = &Ref";
	Query.SetParameter("Ref", IBData.Ref);
	
	Records = Query.Execute().Unload();
	
	For Each Record In Records Do
		If IsBlankString(Record.TypeOfDocumentRightToSign) Then
			Record.TypeOfDocumentRightToSign = NStr("vi = 'Lệnh';
													|ru = 'Приказ';
													|en = 'Order'; fa = 'سفارش';
													|it = 'Ordine';
													|pl = 'Order';
													|tr = 'Sipariş'");
		EndIf;
	EndDo;
	
	XDTOData.Insert("Records", Records);
EndProcedure

