Procedure OCR_Catalog_Users_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	Person = Undefined;
	If XDTOData.KeyProperties.Property("Individual") Then
		Person = XDTOData.KeyProperties.Individual;
	ElsIf XDTOData.Property("Individual") Then
		Person = XDTOData.Individual;
	EndIf;
	If Person <> Undefined Then
		ReceivedData.AdditionalProperties.Insert("Individual", New Structure("Value, OCRName", Person,"Catalog_Persons_Receive"));
	EndIf;
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents, True);
EndProcedure
