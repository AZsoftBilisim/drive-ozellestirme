Procedure PCO_Document_CashShiftClosing_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	OCRName = "Catalog_CashRegisters_Send";
	
	If ExportStack.Count() > 1 Then
		If ValueIsFilled(IBData.CashRegister) Then
			CashRegister = IBData.CashRegister;
		Else
			CashRegisterCashRegisterFiscalDevice = CashRegisterCashRegisterFiscalDevice(IBData.FiscalDevice);
			CashRegister = CashRegisterCashRegisterFiscalDevice.CashRegister;
		EndIf;	
		XDTOData.Insert("CashRegister", New Structure("Value, OCRName", CashRegister, OCRName));
		Return;
	EndIf;
	
	CashRegister = IBData.AdditionalProperties.CashRegister;
	
	XDTOData.KeyProperties.Insert("CashRegister", New Structure("Value, OCRName", CashRegister, OCRName));
	Currency = Common.ObjectAttributeValue(CashRegister, "CashCurrency");
	XDTOData.Insert("Currency", New Structure("Value, OCRName", Currency, "Catalog_Currencies"));
	
	//Find the Retail sales report
	RetailSalesReport = Undefined;
	
	Query = New Query;
	Query.Text = 
	"SELECT TOP 1
	|	RetailSalesReport.Ref AS Ref
	|FROM
	|	Document.RetailSalesReport AS RetailSalesReport
	|WHERE
	|	RetailSalesReport.CashRegisterShift = &CashRegisterShift";
	
	Query.SetParameter("CashRegisterShift", IBData.Ref);
	
	Result = Query.Execute();
	Selection = Result.Select();
	
	If Selection.Next() Then
		RetailSalesReport = Selection.Ref;
		XDTOData.Insert("Sum", RetailSalesReport.DocumentAmount);
		XDTOData.Insert("Cashier", New Structure("Value, OCRName", RetailSalesReport.EmployeeResponsible, "Catalog_Users"));
	EndIf;
EndProcedure

