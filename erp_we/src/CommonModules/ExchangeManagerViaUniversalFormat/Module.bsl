		If Not ValueIsFilled(IBData.IncomingDocumentNumber) Then
			XDTOData.Insert("IncomingDocumentNumber", ObjectsPrefixesClientServer.NumberForPrinting(IBData.Number, False, True));
		EndIf;
	EndIf;
EndProcedure
Procedure FillInDataForAdjustingReceiptOfGoods(IBData, XDTOData, ExchangeComponents)
	// Data of the original receipt document.
	QueryText =
	"SELECT
	|	Doc.PurchaseOrder AS PurchaseOrder,
	|	Doc.Shipper AS Shipper,
	|	CASE
	|		WHEN VALUETYPE(Doc.Ref) = TYPE(Document.SourceDocument)
	|				AND Doc.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToUTII)
	|			THEN TRUE
	|		WHEN Doc.PurchaseForActivity = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToUTII)
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ThisIsENVD,
	|	Doc.ToReturnReusablePackage AS ToReturnReusablePackage
	|INTO ReceiptDocumentData
	|FROM
	|	Document.VendorInvoice AS Doc
	|WHERE
	|	Doc.Ref = &DocumentBasis
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Doc.PurchaseOrder AS PurchaseOrder,
	|	Doc.Shipper AS Shipper,
	|	Doc.ThisIsENVD AS ThisIsENVD,
	|	Doc.ToReturnReusablePackage AS ToReturnReusablePackage
	|FROM
	|	ReceiptDocumentData AS Doc";
	
	// A link to the document being corrected.
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	Doc.Ref,
	|	Doc.PointInTime,
	|	FALSE AS ThisIsFoundationDocument
	|INTO DocumentSequence
	|FROM
	|	Document.PurchaseAdjustment AS Doc
	|WHERE
	|	Doc.DocumentBasis = &DocumentBasis
	|	AND Doc.PointInTime <= &PointInTime
	|	AND Doc.Posted
	|
	|UNION ALL
	|
	|SELECT
	|	Doc.DocumentBasis,
	|	Doc.DocumentBasis.PointInTime,
	|	TRUE
	|FROM
	|	Document.PurchaseAdjustment AS Doc
	|WHERE
	|	Doc.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DocumentSequence.Ref,
	|	DocumentSequence.PointInTime,
	|	DocumentSequence.ThisIsFoundationDocument,
	|	MAX(CASE
	|			WHEN &InternationalVersion
	|				THEN FALSE
	|			ELSE TRUE
	|		END) AS Corrective
	|INTO SequenceDocumentParameters
	|FROM
	|	DocumentSequence AS DocumentSequence
	|
	|GROUP BY
	|	DocumentSequence.Ref,
	|	DocumentSequence.PointInTime,
	|	DocumentSequence.ThisIsFoundationDocument
	|
	|INDEX BY
	|	DocumentSequence.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Parameters1.Ref,
	|	Parameters1.Corrective,
	|	MIN(CASE
	|			WHEN Parameters1.Corrective
	|					AND NOT Parameters2.Corrective
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS InitialAdjustment
	|INTO FilterParameters
	|FROM
	|	SequenceDocumentParameters AS Parameters1
	|		INNER JOIN SequenceDocumentParameters AS Parameters2
	|		ON (Parameters1.Ref = &Ref)
	|			AND (Parameters2.Ref <> &Ref)
	|
	|GROUP BY
	|	Parameters1.Ref,
	|	Parameters1.Corrective
	|
	|INDEX BY
	|	Parameters1.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	CorrectedDocuments.Ref
	|INTO CorrectedDocument
	|FROM
	|	SequenceDocumentParameters AS CorrectedDocuments
	|		INNER JOIN FilterParameters AS FilterParameters
	|		ON (CorrectedDocuments.Corrective = FilterParameters.Corrective
	|				OR FilterParameters.InitialAdjustment
	|				OR CorrectedDocuments.ThisIsFoundationDocument)
	|			AND CorrectedDocuments.Ref <> FilterParameters.Ref
	|
	|ORDER BY
	|	CorrectedDocuments.PointInTime DESC
	|;
	|
	// The actual document being corrected
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CorrectedDocument.Ref AS Ref,
	|	CorrectedDocument.Ref.Date AS Date,
	|	CorrectedDocument.Ref.Number AS Number
	|FROM
	|	CorrectedDocument AS CorrectedDocument";
	
	// A link to the basis of the correction (correction) and the document before the correction.
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT TOP 1
	|	CorrectedDocuments.Ref AS Ref,
	|	CorrectedDocuments.Ref.Date AS Date,
	|	CorrectedDocuments.Ref.Number AS Number
	|FROM
	|	SequenceDocumentParameters AS CorrectedDocuments
	|		INNER JOIN FilterParameters AS FilterParameters
	|		ON (CorrectedDocuments.Corrective = FilterParameters.Corrective
	|				OR CorrectedDocuments.ThisIsFoundationDocument)
	|			AND CorrectedDocuments.Ref <> FilterParameters.Ref
	|
	|ORDER BY
	|	CorrectedDocuments.ThisIsFoundationDocument DESC,
	|	CorrectedDocuments.PointInTime
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	CorrectedDocuments.Ref
	|INTO DocumentBeforeAdjustment
	|FROM
	|	SequenceDocumentParameters AS CorrectedDocuments
	|		INNER JOIN FilterParameters AS FilterParameters
	|		ON FilterParameters.Corrective AND NOT FilterParameters.InitialAdjustment
	|			AND CorrectedDocuments.Corrective = FALSE
	|			AND CorrectedDocuments.Ref <> FilterParameters.Ref
	|
	|ORDER BY
	|	CorrectedDocuments.ThisIsFoundationDocument,
	|	CorrectedDocuments.PointInTime DESC";
	
	// Tabular parts of the Goods and Services of the corrected document.
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	Goods.Products AS Products,
	|	Goods.Characteristic AS Characteristic,
	|	Goods.Package AS Package,
	|	"""" AS Content,
	|	Goods.VATRate AS VATRate,
	|	Goods.CCDNumber AS CCDNumber,
	|	Goods.Count AS Count,
	|	Goods.NumberOfPackages AS NumberOfPackages,
	|	Goods.QuantityByGBRN AS QuantityByGBRN,
	|	Goods.Sum AS Sum,
	|	Goods.VATAmount AS VATAmount,
	|	Goods.AmountIncludingVAT AS AmountIncludingVAT,
	|	Goods.ExpenseItem AS ExpenseItem,
	|	Goods.LineNumber AS LineNumber,
	|	Goods.RowID AS RowID,
	|	Goods.Series AS Series
	|INTO GoodsAndServicesOfDocumentBeingCorrectedExpanded
	|FROM
	|	Document.VendorInvoice.Goods AS Goods
	|WHERE
	|	Goods.Ref IN
	|			(SELECT
	|				CorrectedDocument.Ref
	|			FROM
	|				CorrectedDocument AS CorrectedDocument)
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(Catalog.Products.EmptyRef),
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef),
	|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	|	Expenses.Content,
	|	Expenses.VATRate AS VATRate,
	|	VALUE(Catalog.CCDNumbers.EmptyRef),
	|	Expenses.Count,
