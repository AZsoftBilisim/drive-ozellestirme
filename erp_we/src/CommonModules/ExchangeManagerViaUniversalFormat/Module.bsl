Procedure OCR_Document_PBDSReceiptOfCashOnDeposits_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	FillInDateAndNumberOfIncomingDocument(ReceivedData);
	
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashReceiptUnderDeposits;
	// CashFlowItem
	ReceivedData.AdditionalProperties.Insert("CashFlowItem",
		XDTOData.ARAPDetails[0].CFItem);
	
	Account_Settlement = Undefined;
	If XDTOData.ARAPDetails.Columns.Find("Account_Settlement") <> Undefined Then
		Account_Settlement = XDTOData.ARAPDetails[0].Account_Settlement;
	EndIf;
	If ValueIsFilled(Account_Settlement) And Find(Account_Settlement, "76") > 0 Then
		TheseArePercentages = True;
	Else 
		TheseArePercentages = False;
	EndIf;
	
	#Region ARAPDetails
	
	ArrayOfStringsDecryption = New Array;
	For Each String In XDTOData.ARAPDetails Do
		
		FillingRules = New Map;
		FillingRules.Insert("Sum", "Sum");
		FillingRules.Insert("CFItem", "CashFlowItem"); 
		FillingRules.Insert("Currency", "ARAPCurrency");
		StringDataStructure = CollectionDataAsStructure(String, FillingRules); 
		
		If TheseArePercentages Then
		     StringDataStructure.Insert("LoanAndDepositAmountType", Enums.LoanAndDepositScheduleAmountTypes.Interests);
		Else
			StringDataStructure.Insert("LoanAndDepositAmountType", Enums.LoanAndDepositScheduleAmountTypes.PrincipalDebt); 
		EndIf;  
				
		ArrayOfStringsDecryption.Add(StringDataStructure);
		
	EndDo;
	ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfStringsDecryption);
	
	#EndRegion
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
