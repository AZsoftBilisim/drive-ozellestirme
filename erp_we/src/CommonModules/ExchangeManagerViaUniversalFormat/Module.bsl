Procedure OCR_Catalog_ResponsiblePersons_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ThereIsPostLink = False;
	
	FillingRules = New Map;
	FillingRules.Insert("Individual",             "Individual");
	If ThereIsPostLink Then
		FillingRules.Insert("JobTitle",                  "JobTitleRef");
	EndIf;
	FillingRules.Insert("ResponsiblePersonKind",      "EmployeeInCharge_");
	FillingRules.Insert("AuthorizedPerson",         "AuthorizedPerson");
	FillingRules.Insert("StartDate",                 "StartDate");
	FillingRules.Insert("EndDate",              "EndDate");
	FillingRules.Insert("TypeOfDocumentRightToSign",   "SignatureRightDocument");
	FillingRules.Insert("DateOfDocumentSignatureRight",  "DateOfDocumentSignatureRight");
	FillingRules.Insert("NumberOfSignatureRightDocument", "NumberOfSignatureRightDocument");
	
	If XDTOData.Property("Records")
		And ValueIsFilled(XDTOData.Records) Then
		
		StartDate = Undefined;
		Records = XDTOData.Records; // ValueTable
		For Each String In Records Do
		
			If StartDate <> Undefined And String.StartDate < StartDate Then
				Continue;
			EndIf;
			
			StartDate = String.StartDate;
			JobTitle = String.JobTitle; // Structure
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If Not ThereIsPostLink Then
				If ValueIsFilled(JobTitle) And JobTitle.Property("Description") Then
					StringDataStructure.Insert("JobTitle", JobTitle.Description);
				Else
					StringDataStructure.Insert("JobTitle", "");
				EndIf;
			EndIf;
		EndDo;
		
		StructureKeys = New Structure("StartDate, EndDate, NumberOfSignatureRightDocument, DateOfDocumentSignatureRight, SignatureRightDocument, Individual, JobTitleRef, EmployeeInCharge_");
		For Each KeyValue In StructureKeys Do
			If Not StringDataStructure.Property(KeyValue.Key) Then
				StringDataStructure.Insert(KeyValue.Key);
			EndIf;
		EndDo;
		If TypeOf(StringDataStructure.SignatureRightDocument) = Type("Structure")
			And StringDataStructure.SignatureRightDocument.Property("Value") Then
			
			StringDataStructure.SignatureRightDocument = StringDataStructure.SignatureRightDocument.Value;
		EndIf;
		
		FillPropertyValues(ReceivedData, StringDataStructure,
			"StartDate, EndDate, NumberOfSignatureRightDocument, DateOfDocumentSignatureRight, SignatureRightDocument");
		ReceivedData.AdditionalProperties.Insert("Individual",    StringDataStructure.Individual);
		If ThereIsPostLink Then
			ReceivedData.AdditionalProperties.Insert("JobTitleRef",   StringDataStructure.JobTitleRef);
		Else 
			ReceivedData.AdditionalProperties.Insert("JobTitle",   StringDataStructure.JobTitle);
		EndIf;
		ReceivedData.AdditionalProperties.Insert("EmployeeInCharge_", StringDataStructure.EmployeeInCharge_);
		SignatureRightBasis = NStr("vi = '%1 Số %2 ngày %3';
									|ru = '%1 №%2 от %3';
									|en = '%1 No%2 dated %3'; fa = '%1 No%2 dated %3';
									|it = '%1 №%2 del %3';
									|pl = '%1 nr %2 z dnia %3.';
									|tr = '%3 itibaren %1 №%2'");
		ReceivedData.SignatureRightBasis = StringFunctionsClientServer.SubstituteParametersToString(
													SignatureRightBasis,
													ReceivedData.SignatureRightDocument,
													ReceivedData.NumberOfSignatureRightDocument,
													ReceivedData.DateOfDocumentSignatureRight);
	EndIf;
EndProcedure
Procedure OCR_Catalog_ResponsiblePersons_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
									ReceivedData.AdditionalProperties, ExchangeComponents);
	
	// If there is an object in the database, it will be recorded (and not the received data).
	// The header (as part of the properties from the PKS) is previously transferred from the received data to the data.:
	If IBData <> Undefined Then
		// We transfer those properties that are specified in the PKS.
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
		
		ReceivedData = Undefined;
	EndIf;
EndProcedure


