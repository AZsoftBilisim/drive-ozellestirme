Procedure OCR_Document_ReturnOfGoodsToVendor_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReturnOfGoodsToSupplier_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReturnOfGoodsToSupplier_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	// The currency of the settlements is needed for further calculation of the exchange rate and multiplicity.
	// The calculation of the conditional units is calculated in parallel, so as not to do the same thing a second time if necessary.
	CalculationsInConventionalUnits = False;
	ARAPCurrency     = IBData.Currency;
	
	If IBData.BusinessOperation <> Enums.BusinessTransactions.ReturnOfGoodsToConsignor Then
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
			ARAPCurrency     = Common.ObjectAttributeValue(IBData.Terms, "Currency");
		Else
			If IBData.ARAPDetails.Count() > 0 Then
				ARAPCurrency     = IBData.ARAPDetails[0].ARAPCurrency;
				CalculationsInConventionalUnits = (IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> ARAPCurrency);
			EndIf;
		EndIf;
	EndIf;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False, False);
	
	If Not ValueIsFilled(IBData.BusinessOperation) Then
		XDTOData.Insert("OperationKind", "ReturnToVendor");
	EndIf;
	
	XDTOData.Insert("DocumentInflow", Undefined);
	UploadRateAndMultiplicityOfSettlements(XDTOData, ARAPCurrency, IBData.Date, IBData.Organization);
	
	// Goods
	QueryText = 
		"SELECT DISTINCT
		|	ReturnOfGoodsToVendorInventoryKinds.LineNumber AS LineNumber,
		|	CAST(ReturnOfGoodsToVendorInventoryKinds.DocumentInflow AS Document.VendorInvoice) AS DocumentInflow
		|INTO TueReceiptDocuments
		|FROM
		|	Document.ReturnOfGoodsToVendor.InventoryKinds AS ReturnOfGoodsToVendorInventoryKinds
		|WHERE
		|	ReturnOfGoodsToVendorInventoryKinds.DocumentInflow.BusinessOperation <> VALUE(Enum.BusinessTransactions.PurchaseViaAdvanceHolder)
		|	AND ReturnOfGoodsToVendorInventoryKinds.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.AmountIncludingVAT AS AmountIncludingVAT,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|		END AS NUMBER(31, 2)) AS Price,
		|	InventoryKinds.Ref.ReturnOfReceivedReusablePackages AS ReturnOfReceivedReusablePackages,
		|	InventoryKinds.Ref.BusinessOperation AS BusinessOperation,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.NumberOfPackages
		|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.NumberOfPackages
		|		END AS NUMBER(31, 2)) AS PricePerPackaging,
		|	CASE
		|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|				AND InventoryKinds.Ref.ReturnOfReceivedReusablePackages
		|			THEN ""ReturnContainers""
		|		WHEN InventoryKinds.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsToConsignor)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	TueReceiptDocuments.DocumentInflow AS DocumentInflow
		|FROM
		|	Document.ReturnOfGoodsToVendor.InventoryKinds AS InventoryKinds
		|		LEFT JOIN TueReceiptDocuments AS TueReceiptDocuments
		|		ON InventoryKinds.LineNumber = TueReceiptDocuments.LineNumber
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ARAPDetails.ARAPObject.Object AS OrderDocument
		|FROM
		|	Document.ReturnOfGoodsToVendor.ARAPDetails AS ARAPDetails
		|WHERE
		|	ARAPDetails.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
			
	#Region PackagingMarkings
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
		"SELECT
		|	ReturnOfGoodsToVendorPackageBarcodes.LineNumber AS DocumentRowNumber,
		|	ReturnOfGoodsToVendorPackageBarcodes.PackageBarcode AS PackageBarcode
		|INTO TTBarcodesOfPackages
		|FROM
		|	Document.ReturnOfGoodsToVendor.PackageBarcodes AS ReturnOfGoodsToVendorPackageBarcodes
		|WHERE
		|	&UnloadingBarcodesOfPackages
		|	AND ReturnOfGoodsToVendorPackageBarcodes.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber,
		|	TTBarcodesOfPackages.PackageBarcode AS PackageMarking
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|";
	
	#EndRegion
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref",                     IBData.Ref);
	Query.SetParameter("Date",                       IBData.Date);
	Query.SetParameter("UnloadingBarcodesOfPackages", UnloadingBarcodesOfPackages(ExchangeComponents));
	
	Result = Query.ExecuteBatch();
	
	Goods = Result[1].Unload();
	
	If ValueIsFilled(IBData.DocumentInflow) And Common.RefExists(IBData.DocumentInflow)
		And Not Common.ObjectAttributeValue(IBData.DocumentInflow, "BusinessOperation") = Enums.BusinessTransactions.PurchaseViaAdvanceHolder Then
		XDTOData.Insert("DocumentInflow", IBData.DocumentInflow);
		Goods.FillValues(Undefined, "DocumentInflow");
	EndIf;
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	
	XDTOData.Insert("Goods", Goods);
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		// We take the order to the supplier from the tabular part "Decryption of payment"
		// If several orders are indicated there or a document that is not an order is specified as an order, then we do nothing
		
		TabOrders = Result[2].Unload();
		
		If TabOrders.Count() = 1 And TypeOf(TabOrders[0].OrderDocument) = Type("DocumentRef.PurchaseOrder") Then
			PurchaseOrder = TabOrders[0].OrderDocument;
		Else
			PurchaseOrder = Undefined;
		EndIf;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = ARAPCurrency;
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		DefaultParameters.TypeOfAgreement              = ?(IBData.BusinessOperation = Enums.BusinessTransactions.ReturnOfGoodsToConsignor,
			"WithConsignor", "WithVendor");
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", PurchaseOrder, IBData.Terms, IBData.SalesOpportunity);
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.ReturnOfGoodsToVendor.SetOfSeries", XDTOData);
	EndIf;
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure


