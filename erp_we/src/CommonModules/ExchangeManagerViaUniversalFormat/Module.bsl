Procedure AddDPR_Document_ExpenseReport_Receive(DataProcessingRules)
	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Document_AdvanceReport_Receipt";
	ProcessingRule.FilterObjectFormat     = "Документ.АвансовыйОтчет"; //@NON-NLS-1
	ProcessingRule.OnProcess            = "DPR_Document_ExpenseReport_Receive_OnProcess";
	ProcessingRule.OCRUsed.Add("Document_AdvanceReport_Receipt");
	ProcessingRule.OCRUsed.Add("Document_PTUThroughAccountablePerson_Receipt");
EndProcedure
Procedure DPR_Document_ExpenseReport_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	UsageOCR.Document_PTUThroughAccountablePerson_Receipt = False;
			
	#Region MultiCurrencyAO
	
	// When uploading multicurrency advance reports, the link is transmitted only together
	// with the advance report of the regulated currency.
	// In this case, a custom currency prefix is added to the number.
	// Such advance reports should not be uploaded in the opposite direction.
	CustomPrefix = ObjectsPrefixesClientServer.CustomPrefix(XDTOData.KeyProperties.Number);
	If ValueIsFilled(CustomPrefix) Then
		// Let's search for a custom prefix among currency prefixes.
		Query = New Query;
		Query.SetParameter("CustomPrefix", CustomPrefix + "%");
		Query.Text =
			"SELECT
			|	Currencies.Ref AS Ref
			|FROM
			|	Catalog.Currencies AS Currencies
			|WHERE
			|	Currencies.Description LIKE &CustomPrefix";
		
		If Query.Execute().Select().Count() > 0 Then
			DocumentNumber = XDTOData.KeyProperties.Number;
			// Remove the custom prefix from the document number.
			NumberWithoutPrefix = StrReplace(DocumentNumber, CustomPrefix, "");
			NumberWithoutPrefixes = ObjectsPrefixesClientServer.DeletePrefixesFromObjectNumber(NumberWithoutPrefix, True, True);
			StandardPrefix = StrReplace(NumberWithoutPrefix, NumberWithoutPrefixes, "");
			NumberForPrinting = ObjectsPrefixesClientServer.NumberForPrinting(DocumentNumber, True, True);
			
			DocumentNumber = StandardPrefix
				+ StringFunctionsClientServer.SupplementString(NumberForPrinting, 11 - StrLen(StandardPrefix));
				
			// Let's search for an advance report by number without a custom prefix.
			AdvanceHolder = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
				ExchangeComponents,
				XDTOData.AdvanceHolder,
				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Persons_Receive"), 
				"GetRef").Ref;
				
			Query = New Query;
			Query.SetParameter("Date", XDTOData.KeyProperties.Date);
			Query.SetParameter("Number", DocumentNumber);
			Query.SetParameter("AdvanceHolder", AdvanceHolder);
			Query.Text =
				"SELECT
				|	ExpenseReport.Ref AS Ref
				|FROM
				|	Document.ExpenseReport AS ExpenseReport
				|WHERE
				|	ExpenseReport.Date = &Date
				|	AND ExpenseReport.Number = &Number
				|	AND ExpenseReport.Multicurrency
				|	AND ExpenseReport.AdvanceHolder = &AdvanceHolder";
				
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				UsageOCR.Document_AdvanceReport_Receipt = False;
				
				WarningTemplate = NStr("vi = 'Không thể kết nhập giấy thanh toán tiền tạm ứng số %1 ngày %2.
					|Không hỗ trợ kết nhập giấy thanh toán tiền tạm ứng đa tiền tệ đã kết xuất từ trước.
					|Chứng từ nguồn ban đầu: %3';
					|ru = 'Авансовый отчет №%1 от %2 не может быть загружен.
					|Загрузка ранее выгруженных мультивалютных авансовых отчетов не поддерживается.
					|Документ первоисточник: %3';
					|en = 'Expense report No.%1 from %2 cannot be imported.
					|Import of previously exported multicurrency expense reports is not supported.
					|Source document: %3'; fa = 'Expense report No.%1 from %2 cannot be imported.
					|Import of previously exported multicurrency expense reports is not supported.
					|Source document: %3';
					|it = 'Impossibile scaricare report anticipo №%1 di %2.
					|Non è supportato il download di report di anticipi multivaluta precedentemente caricati.
					|Documento originario: %3';
					|pl = 'Raport zaliczkowy nr%1 z dn. %2 nie może być wczytany.
					|Wczytywanie wcześniej eksportowanych wielowalutowych raportów zaliczkowych nie jest obsługiwane.
					|Dokument źródłowych: %3';
					|tr = '%2''dan №%1 numaralı gider raporu yüklenemez.
					|Daha önce yüklenmiş birden çok para birimli gider raporlarının indirilmesi desteklenmiyor.
					|Belge kaynağı: %3'");
				
				WarningText = StrTemplate(WarningTemplate,
					XDTOData.KeyProperties.Number,
					XDTOData.KeyProperties.Date,
					Selection.Ref);
				
				ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.CompletedWithWarnings; 
				DataExchangeXDTOServer.WriteToExecutionProtocol(
					ExchangeComponents, WarningText, Undefined, False);
			EndIf;
		EndIf;
	EndIf;
	
	#EndRegion
	
	#Region VocationalSchoolThroughAccountablePerson
	
	If XDTOData.Property("Goods") And XDTOData.Goods.Count() > 0 Then
		
		StartDateOfPrintingSingleExpenseReport = Constants.StartDateOfPrintingSingleExpenseReport.Get();
		If XDTOData.KeyProperties.Date < StartDateOfPrintingSingleExpenseReport Then 
			UsageOCR.Document_AdvanceReport_Receipt = False;
			UsageOCR.Document_PTUThroughAccountablePerson_Receipt = True;
			Return;
		EndIf;
		
		ExpenseReport = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
			ExchangeComponents,
			XDTOData.KeyProperties,
			DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Document_AdvanceReport_Receipt"), 
			"GetRef");
			
		XDTOData.Insert("ExpenseReport", XDTOData.KeyProperties);
			
		Goods = XDTOData.Goods; // ValueTable
		Goods.Columns.Add("SupplierByLine");
		For Each LineProducts_ In XDTOData.Goods Do
			LineProducts_.SupplierByLine = ValueToStringInternal(LineProducts_.Vendor);
		EndDo;
		
		KeyReceiptFields = "SupplierByLine, IncomingDocumentDate, IncomingDocumentNumber";
		ReceiptDocumentKeys = XDTOData.Goods.Copy();
		ReceiptDocumentKeys.GroupBy(KeyReceiptFields);
		
		ThisIsNewAdvanceReport = TypeOf(ExpenseReport) = Type("DocumentObject.ExpenseReport");
		
		If ThisIsNewAdvanceReport And ReceiptDocumentKeys.Count() = 1 Then
			UsageOCR.Document_PTUThroughAccountablePerson_Receipt = True;
		Else
			// Vocational schools will be created from the PCO of the Advance Report.
			XDTOData.Insert("ReceiptDocumentKeys", ReceiptDocumentKeys);
			XDTOData.Insert("KeyReceiptFields",    KeyReceiptFields);
			XDTOData.Insert("ThisIsNewAdvanceReport",     ThisIsNewAdvanceReport);
			XDTOData.Insert("AdvanceReportLink",       ExpenseReport.Ref);
			UsageOCR.Delete("Document_PTUThroughAccountablePerson_Receipt");
		EndIf;
		
	EndIf;
	
	#EndRegion
EndProcedure

