	ConversionRule.FormatObject                      = "Справочник.Упаковки"; //@NON-NLS-1
	ConversionRule.OnSendData                  = "OCR_Catalog_Packages_OnSendData";
	ConversionRule.OnConvertXDTOData           = "OCR_Catalog_Packages_OnConvertXDTOData";
	ConversionRule.BeforeWriteReceivedData       = "OCR_Catalog_Packages_BeforeWriteReceivedData";
	ConversionRule.AfterImportAllData            = "DelayedProcessing_Packaging";
	ConversionRule.IdentificationOption               = "FirstByUUIDThenBySearchFields";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "Owner",         "", 1, "Catalog_Products_Receive");
	AddPCR(HeaderProperties, "Height",           "Height");
	AddPCR(HeaderProperties, "Depth",          "Depth");
	AddPCR(HeaderProperties, "UnitOfMeasure", "UnitOfMeasure", , "Catalog_UnitsOfMeasurement");
	AddPCR(HeaderProperties, "Denominator",      "", 1);
	AddPCR(HeaderProperties, "",                 "ZoomRatio", 1);
	AddPCR(HeaderProperties, "Description",     "Description");
	AddPCR(HeaderProperties, "",                 "Products", 1, "Catalog_Products_Send");
	AddPCR(HeaderProperties, "VolumeM3",            "VolumeM3");
	AddPCR(HeaderProperties, "Numerator",        "", 1);
	AddPCR(HeaderProperties, "Width",           "Width");
	ConversionRule.SearchFields.Add("UnitOfMeasure,Description,Owner");
EndProcedure
Procedure OCR_Catalog_Packages_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	ZoomRatio = ?(IBData.Denominator = 0, IBData.Numerator, Round(IBData.Numerator / IBData.Denominator,3));
	
	Products = Undefined;
	
	If ValueIsFilled(IBData.Owner) And TypeOf(IBData.Owner) = Type("CatalogRef.Products") Then
		Products = IBData.Owner;
	EndIf;
	
	If ExportStack.Count() > 1 Then
		XDTOData.Insert("ZoomRatio", ZoomRatio);
		If ValueIsFilled(Products) Then
			XDTOData.Insert("Products", Products);
		EndIf;
		Return;
	EndIf;
	
	XDTOData.KeyProperties.Insert("ZoomRatio", ZoomRatio);
	If ValueIsFilled(Products) Then
		XDTOData.KeyProperties.Insert("Products", Products);
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7") Then
		If Not ValueIsFilled(IBData.Height) Then
			XDTOData.Insert("Height", -1);
		EndIf;
		If Not ValueIsFilled(IBData.Depth) Then
			XDTOData.Insert("Depth", -1);
		EndIf;
		If Not ValueIsFilled(IBData.VolumeM3) Then
			XDTOData.Insert("VolumeM3", -1);
		EndIf;
		If Not ValueIsFilled(IBData.Width) Then
			XDTOData.Insert("Width", -1);
		EndIf;
	EndIf;
EndProcedure
Procedure OCR_Catalog_Packages_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If XDTOData.KeyProperties.Property("Products") Then
	
		// Packages for a set of packages are unloaded as a "Structure"
		// with substitution as the owner - Nomenclature from the document line.
		// Let's check the existence of the item at the time of loading.
		Products = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
				ExchangeComponents,
				XDTOData.KeyProperties.Products,
				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Products_Receive"), 
				"GetRef");
		
		If TypeOf(Products) = Type("CatalogRef.Products") Then
			PackagingGroup = Common.ObjectAttributeValue(Products, "PackagingGroup");
			
			If ValueIsFilled(PackagingGroup) And Not PackagingGroup = Catalogs.PackagingGroups.SpecialForItem Then	
		    	ReceivedData.Owner = PackagingGroup;
		    EndIf;
		EndIf;
		
		If Not ValueIsFilled(ReceivedData.Owner) Then
			ReceivedData.AdditionalProperties.Insert("Owner", XDTOData.KeyProperties.Products);
		EndIf;
	EndIf;
	
	If XDTOData.KeyProperties.Property("ZoomRatio")
		And ValueIsFilled(XDTOData.KeyProperties.Property("ZoomRatio")) Then
		ReceivedData.Numerator = XDTOData.KeyProperties.ZoomRatio;
		ReceivedData.Denominator = 1;
	EndIf;
EndProcedure
Procedure OCR_Catalog_Packages_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If Not ValueIsFilled(ReceivedData.Owner)
		Or (Not IBData = Undefined And TypeOf(IBData.Owner) = Type("CatalogRef.PackagingGroups")) Then
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If Not ValueIsFilled(DataToWriteToIB.Denominator) Then
		DataToWriteToIB.Denominator = 1;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.PackageType) Then
		DataToWriteToIB.PackageType = Enums.TypesOfItemsPackages.Final;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.MeasuredValueType) Then
		DataToWriteToIB.MeasuredValueType = Enums.TypesOfMeasuredValues.Package;
	EndIf;
EndProcedure

