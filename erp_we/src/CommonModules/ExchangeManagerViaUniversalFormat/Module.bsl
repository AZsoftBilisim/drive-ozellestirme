Procedure OCR_Document_AdjustmentOfSalesOfGoods_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted    = True;
	ReceivedData.Approved  = True;
	ReceivedData.PaymentDate = ReceivedData.Date;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	If XDTOData.Property("ContractOfBuyerOfCommissionGoods") Then
	
		AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents, 
		"ContractOfBuyerOfCommissionGoods", "CustomerContract");
	
	EndIf;
	
	If XDTOData.Property("ConsignedGoodsCustomer") Then
	
		ReceivedData.AdditionalProperties.Insert("CustomerCounterparty", XDTOData.ConsignedGoodsCustomer);	
	
	EndIf; 
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	ImplementationDocumentData = Undefined;
	OCRName = "";
	XDTOData.Property("CorrectedImplementationDocument", ImplementationDocumentData);
	If ImplementationDocumentData <> Undefined And TypeOf(ImplementationDocumentData) = Type("Structure") Then
		ValueTypeDocument = ImplementationDocumentData.ValueType;
		If Find(ValueTypeDocument, "РеализацияТоваровУслуг") Then // @Non-NLS-1
			OCRName = "Document_SaleOfGoodsServices_Receipt";
		EndIf; 
	EndIf;
	// If the Implementation Correction type is specified in the correctableidocumentrealization property, you need to check what is in the Implementation document.
	If ImplementationDocumentData = Undefined Or OCRName = "" Then
		XDTOData.Property("DocumentSalesOfGoodsAndServices", ImplementationDocumentData);
	EndIf;
	If ImplementationDocumentData <> Undefined And TypeOf(ImplementationDocumentData) = Type("Structure") Then
		ValueTypeDocument = ImplementationDocumentData.ValueType;
		If Find(ValueTypeDocument, "РеализацияТоваровУслуг") Then // @Non-NLS-1
			OCRName = "Document_SaleOfGoodsServices_Receipt";
		ElsIf Find(ValueTypeDocument, "КорректировкаРеализацииТоваров") Then // @Non-NLS-1
			AdjustingUID = ImplementationDocumentData.Ref.Value;
			IBObjectValueType = Type("DocumentRef.SaleAdjustment");
			AdjustingLink = DataExchangeXDTOServer.ObjectRefByXDTODataObjectUUID(AdjustingUID,IBObjectValueType,ExchangeComponents);
	
			If TypeOf(AdjustingLink.DocumentBasis) = Type("DocumentRef.CustomerInvoice") Then
				ReceivedData.DocumentBasis = AdjustingLink.DocumentBasis;
			EndIf; 
		ElsIf Find(ValueTypeDocument, "ОтчетКомиссионера") Then // @Non-NLS-1
			OCRName = "Document_SaleOfGoodsAndServicesFee_Receipt";
		EndIf; 
	EndIf;
	If OCRName <> "" Then
		ReceivedData.AdditionalProperties.Insert("DocumentBasis", New Structure("Value, OCRName",ImplementationDocumentData,OCRName));
	EndIf;
	If XDTOData.OperationKind.Value = "CorrectionOfErrors" Then
		ReceivedData.AdjustmentKind = Enums.BusinessTransactions.ErrorCorrection;
	Else
		ReceivedData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentUnderApprovalOfParties;
	EndIf;
	ReceivedData.AdjustingEntryType = Enums.AdjustingEntryTypes.StandardAdjustment;
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");
	FillingRules.Insert("Sum",        "Sum");
	FillingRules.Insert("Price",         "Price");
	FillingRules.Insert("VATRate",    "VATRate");
	FillingRules.Insert("VATAmount",     "VATAmount");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	ArrayOfRows = New Array;
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
	
		For Each String In XDTOData.Goods Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("Count") Then
				If StringDataStructure.Count <= 0 Then
					Continue;
				EndIf;
			Else
				// The quantity is not set.
				Continue;
			EndIf;
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount;
			EndIf;
	
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			StringDataStructure.Insert("NumberOfPackages",String.Count);
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
			StringDataStructure.Insert("AmountARAP", String.Sum);
			If StringDataStructure.Property("VATAmount") Then
				StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
			EndIf;
			StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
	
			StringDataStructure.VATRate = String.VATRate;
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	// We add services to products.
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
	
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("Count") Then
				If StringDataStructure.Count <= 0 Then
					Continue;
				EndIf;
			Else
				// The quantity is not set.
				Continue;
			EndIf;
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
	
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
			If ValueIsFilled(String.Content) Then
				StringDataStructure.Insert("Content", String.Content);
			EndIf;
			StringDataStructure.Insert("AmountARAP", String.Sum);
			If StringDataStructure.Property("VATAmount") Then
				StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
			EndIf;
	
			StringDataStructure.VATRate = String.VATRate;
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	#EndRegion 
	#Region Discrepancies
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");  
	FillingRules.Insert("Sum",        "Sum");  
	
	FillingRules.Insert("VATRate",    "VATRate");
	
	FillingRules.Insert("VATAmount", "VATAmount"); 
	
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	
	ArrayOfLinesDiscrepancy = New Array;
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then 
		For Each String In XDTOData.Goods Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules); 
			If Not String.VATRate.Property("Rate1") Then
				String.VATRate.Insert("Rate1", "0");
			EndIf;
			If Not String.VATRateBeforeChange.Property("Rate1") Then
				String.VATRateBeforeChange.Insert("Rate1", "0");
			EndIf;
	
			If StringDataStructure.Property("Count") Then
				If StringDataStructure.Count <= 0 Then
					Continue;
				EndIf;
			Else
				// The quantity is not set.
				Continue;
			EndIf;
			If Not String.ThereIsImplementationReceiptInDocument = True 
				Or (Not FormatVersionIs17AndHigher And (ValueIsFilled(String.VATRate) And ValueIsFilled(String.VATRateBeforeChange))  
				And String.VATRate.Value <> String.VATRateBeforeChange.Value)
				Or (FormatVersionIs17AndHigher And String.VATRate.Rate1 <> String.VATRateBeforeChange.Rate1)
				Then
				// Two lines old minus new plus.
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
					StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount;
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
				StringDataStructure.VATRate = String.VATRate;
				If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
					StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
				EndIf;
	
				If Not String.ThereIsImplementationReceiptInDocument = True Then
					Continue;
				EndIf;
				// Reflect the data before the change with a minus sign.
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				Count =  (-1) * ?(String.QuantityBeforeChange_ = Undefined, 0,String.QuantityBeforeChange_);
				Sum = (-1) * ?(String.AmountBeforeChange = Undefined, 0,String.AmountBeforeChange);
	
				StringDataStructure.Insert("Count", Count);
				StringDataStructure.Insert("Sum", Sum);
				If StringDataStructure.Property("VATAmount") And ValueIsFilled(String.VATAmountBeforeChange) Then
					StringDataStructure.VATAmount = (-1) * String.VATAmountBeforeChange;
				EndIf;
				StringDataStructure.VATRate = String.VATRateBeforeChange;
				If StringDataStructure.Property("NumberOfPackages") Then
					StringDataStructure.NumberOfPackages = (-1) * String.NumberOfPackagesBeforeChange_;
				EndIf;
				If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
					StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT - StringDataStructure.VATAmount;
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
			ElsIf String.Count <> String.QuantityBeforeChange_ Or String.Sum <> String.AmountBeforeChange Or String.VATAmount <> String.VATAmountBeforeChange Then
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				StringDataStructure.Count = String.Count - ?(Not String.QuantityBeforeChange_ = Undefined,String.QuantityBeforeChange_, 0);
				If StringDataStructure.Property("Sum") And ValueIsFilled(String.AmountBeforeChange) Then
					StringDataStructure.Sum = String.Sum - String.AmountBeforeChange;
				EndIf;
				If StringDataStructure.Property("VATAmount") And ValueIsFilled(String.VATAmountBeforeChange) Then 
					StringDataStructure.VATAmount = String.VATAmount - String.VATAmountBeforeChange;
				EndIf;
				If StringDataStructure.Property("NumberOfPackages") Then
					StringDataStructure.NumberOfPackages = StringDataStructure.NumberOfPackages - ?(String.NumberOfPackagesBeforeChange_ = Undefined, 0, String.NumberOfPackagesBeforeChange_);
				EndIf;
				If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
					StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount;
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
			Else
				// If there are no changes, we skip them.
				Continue;
			EndIf;
		EndDo;
	EndIf;
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
		For Each LineService In XDTOData.Services Do 
			If LineService.VATRate = Undefined Or LineService.VATRateBeforeChange = Undefined Then
				Continue
			EndIf;
			If Not LineService.VATRate.Property("Rate1") Then
				LineService.VATRate.Insert("Rate1", "0");
			EndIf;
			If TypeOf(LineService.VATRateBeforeChange) = Type("Structure") And Not LineService.VATRateBeforeChange.Property("Rate1") Then
				LineService.VATRateBeforeChange.Insert("Rate1", "0");
			EndIf;
			If ((Not FormatVersionIs17AndHigher And Not LineService.VATRate.Value <> LineService.VATRateBeforeChange.Value) 
				Or (FormatVersionIs17AndHigher And LineService.VATRate.Rate1 <> LineService.VATRateBeforeChange.Rate1)) 
				Or (Not LineService.ThereIsImplementationReceiptInDocument = Undefined 
				And Not LineService.ThereIsImplementationReceiptInDocument = True)
				Or (ValueIsFilled(LineService.Content) And ValueIsFilled(LineService.ContentBeforeChange) 
				And LineService.Content <> LineService.ContentBeforeChange) Then
				// Two lines old minus new plus.
				StringDataStructure = CollectionDataAsStructure(LineService, FillingRules);
				If ValueIsFilled(LineService.Content) Then
					StringDataStructure.Insert("Content", LineService.Content);
				EndIf;
				AmountIncludingVAT = LineService.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				ProcessVATRateUponReceipt(ExchangeComponents, LineService, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				If ValueIsFilled(LineService.Content) Then
					StringDataStructure.Insert("Content", LineService.Content);
				EndIf;
				StringDataStructure.Insert("AmountARAP", LineService.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				ArrayOfLinesDiscrepancy.Add(StringDataStructure); 
	
				StringDataStructure.VATRate = LineService.VATRate;
				If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
					StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
				EndIf;
	
				If Not String.ThereIsImplementationReceiptInDocument = True Then
					Continue;
				EndIf;
	
				StringDataStructure = CollectionDataAsStructure(LineService, FillingRules);
	
				Count =  (-1) * ?(LineService.QuantityBeforeChange_ = Undefined, 0,LineService.QuantityBeforeChange_);
				Sum = (-1) * ?(LineService.AmountBeforeChange = Undefined, 0,LineService.AmountBeforeChange);
	
				StringDataStructure.Insert("Count", Count);
				StringDataStructure.Insert("Sum", Sum);
				If StringDataStructure.Property("VATAmount") And ValueIsFilled(LineService.VATAmountBeforeChange) Then
					StringDataStructure.VATAmount = (-1) * LineService.VATAmountBeforeChange;
				EndIf;
				StringDataStructure.VATRate = LineService.VATRateBeforeChange;
				If ValueIsFilled(LineService.ContentBeforeChange) Then
					StringDataStructure.Insert("Content", LineService.ContentBeforeChange);
				EndIf;
				AmountIncludingVAT = LineService.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				ProcessVATRateUponReceipt(ExchangeComponents, LineService, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				If ValueIsFilled(LineService.Content) Then
					StringDataStructure.Insert("Content", LineService.Content);
				EndIf;
				StringDataStructure.Insert("AmountARAP", LineService.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
	
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
				
			ElsIf LineService.Count <> LineService.QuantityBeforeChange_ Or ?(LineService.Sum = Undefined, 0, LineService.Sum) <> LineService.AmountBeforeChange Or LineService.VATAmount <> LineService.VATAmountBeforeChange Then
				StringDataStructure = CollectionDataAsStructure(LineService, FillingRules); 
				Sum = ?(LineService.Sum = Undefined, 0, LineService.Sum); 
				If StringDataStructure.Property("Sum") = False Then
				    StringDataStructure.Insert("Sum");
				EndIf;
				If ValueIsFilled(LineService.Count) And ValueIsFilled(LineService.QuantityBeforeChange_) Then
					StringDataStructure.Count = LineService.Count - LineService.QuantityBeforeChange_;
				EndIf;
				StringDataStructure.Sum = Sum - ?(LineService.AmountBeforeChange = Undefined, 0, LineService.AmountBeforeChange);
				If StringDataStructure.Property("VATAmount") And ValueIsFilled(LineService.VATAmountBeforeChange) Then
					StringDataStructure.VATAmount = LineService.VATAmount - LineService.VATAmountBeforeChange;
				EndIf;
				If ValueIsFilled(LineService.Content) Then
					StringDataStructure.Insert("Content", LineService.Content);
				EndIf;
				AmountIncludingVAT = Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				ProcessVATRateUponReceipt(ExchangeComponents, LineService, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				If ValueIsFilled(LineService.Content) Then
					StringDataStructure.Insert("Content", LineService.Content);
				EndIf;
				StringDataStructure.Insert("AmountARAP", Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);	
			Else
				// If there are no changes, we skip them.
			EndIf;
		EndDo;
	EndIf; 
	If ArrayOfLinesDiscrepancy.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Discrepancies", ArrayOfLinesDiscrepancy);
	EndIf;
	
	#EndRegion
EndProcedure
Procedure OCR_Document_AdjustmentOfSalesOfGoods_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	If Not IBData = Undefined Then
		// We transfer those properties that are specified in the PKS
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		// Goods
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("VATRate");
	
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.Goods,
			IBData.Goods,
			KeyFieldsArray,
			Undefined,
			"Count, NumberOfPackages, Package, Content, Sum, VATAmount, AmountIncludingVAT, Price, Warehouse");
		IBData.Goods.Load(ReceivedData.Goods.Unload());
	
		// Discrepancies
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("VATRate");
	
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.Discrepancies,
			IBData.Discrepancies,
			KeyFieldsArray,
			Undefined,
			"Count, NumberOfPackages, Package, Content, Sum, VATAmount, AmountIncludingVAT, Warehouse");
		IBData.Discrepancies.Load(ReceivedData.Discrepancies.Unload());
	
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	DocumentType = "DocumentObject.SaleAdjustment";
	CheckResultOfDocumentDataExchange(DataToWriteToIB, ExchangeComponents.CorrespondentNode, DocumentType);
EndProcedure


