Procedure PCO_Document_PBDSCurrencyConversion_Getting_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	FillInDateAndNumberOfIncomingDocument(ReceivedData);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	// BusinessOperation
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion;
	
	// ConversionRate
	ReceivedData.ConversionRate           = XDTOData.ARAPDetails[0].ConversionRate;
	ReceivedData.ConversionRateMultiplier = XDTOData.ARAPDetails[0].ConversionMultiplicity;
	
	// CashFlowItem
	ReceivedData.AdditionalProperties.Insert("CashFlowItem",
		XDTOData.ARAPDetails[0].CFItem);
	
	// CurrencyOfConversion
	CurrencyOfConversion = XDTOData.ARAPDetails[0].CurrencyOfConversion;
	If TypeOf(CurrencyOfConversion) = Type("Structure")
		And CurrencyOfConversion.Property("Ref") = False Then
		OCRName = "Catalog___FromStructure";
	Else
