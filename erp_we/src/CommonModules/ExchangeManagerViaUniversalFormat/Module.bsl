	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Document_ApplicationForCashExpenditurePaymentOfSalary_Receipt";
	ProcessingRule.FilterObjectFormat     = "Документ.ЗаявкаНаРасходДСВыплатаЗарплаты"; //@NON-NLS-1
	ProcessingRule.OnProcess            = "POD_Document_ApplicationForCashExpenditureSalaryPayment_Receipt_DuringProcessing";
	ProcessingRule.OCRUsed.Add("Document_ApplicationPaymentOfSalaryVRKO_Receipt");
	ProcessingRule.OCRUsed.Add("Document_ApplicationForCashExpenditurePaymentOfSalary_Receipt");
EndProcedure
Procedure POD_Document_ApplicationForCashExpenditureSalaryPayment_Receipt_DuringProcessing(XDTOData, UsageOCR, ExchangeComponents)
	UseCashSpendingRequests = GetFunctionalOption("UsePaymentRequests");
	
	ClearUsageOCR(UsageOCR);
	UsageOCR.Insert("Document_ApplicationForCashExpenditurePaymentOfSalary_Receipt", False);
	
	If UseCashSpendingRequests Then
		UsageOCR.Insert("Document_ApplicationForCashExpenditurePaymentOfSalary_Receipt", True);
	
	ElsIf XDTOData.Property("ApprovedFormOfPayment") And ValueIsFilled(XDTOData.ApprovedFormOfPayment) Then	
		
		If XDTOData.ApprovedFormOfPayment.Value = "CashAccountPayment_" Then
			
			UsageOCR.Insert("Document_ApplicationPaymentOfSalaryVRKO_Receipt", True);
		
		ElsIf XDTOData.ApprovedFormOfPayment.Value = "BankAccountPayment" Then
			
			DocumentData = New Structure;
			DocumentData.Insert("Department");
			DocumentData.Insert("Organization");
			DocumentData.Insert("Currency");
			DocumentData.Insert("Counterparty");
			DocumentData.Insert("Date");
			
			FillPropertyValues(DocumentData, XDTOData); 
			If XDTOData.Property("KeyProperties") Then
				FillPropertyValues(DocumentData, XDTOData.KeyProperties);
			EndIf;
			
			DocumentData.Insert("Posted",               False);
			DocumentData.Insert("PaymentDocumentType", Enums.TypesOfPaymentDocuments.PaymentOrder);
												
			If XDTOData.Property("Counterparty") And ValueIsFilled(XDTOData.Counterparty)
				And XDTOData.Property("BankAccount") And ValueIsFilled(XDTOData.BankAccount) Then
		     
				DocumentData.Insert("BusinessOperation", Enums.BusinessTransactions.SalaryPaymentByPayrollCardProgram);
				DocumentData.Insert("CashFlowItem", 
							Catalogs.CashFlowReportItems.CashFlowItemForBusinessTransaction(DocumentData.BusinessOperation));
				DocumentData.Insert("DocumentAmount", XDTOData.Sum);
				If XDTOData.Property("BankAccount") Then
					DocumentData.Insert("CounterpartyBankAccount", XDTOData.BankAccount);
				EndIf;
				
				If XDTOData.ARAPDetails.Count() > 0 Then
					DocumentData.Insert("PaysheetDate");
					DocumentData.Insert("PaysheetNumber");
					FillPropertyValues(DocumentData, XDTOData.ARAPDetails[0],
						"PaysheetDate, PaysheetNumber");
					DocumentData.PaysheetDate = BegOfDay(DocumentData.PaysheetDate);
				EndIf;
						
				DataExchangeXDTOServer.XDTOObjectStructureToIBData(
					ExchangeComponents,
					DocumentData,
					DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Document_SBDSFromStructure__"), 
					"ConvertAndWrite");
			Else
			
				DocumentsCount = XDTOData.ARAPDetails.Count();
				If DocumentsCount > 0 Then
					
					For Counter = 0 To DocumentsCount - 1 Do
						
						DecryptionString = XDTOData.ARAPDetails[Counter];
						
						DocumentData.Insert("BusinessOperation",  Enums.BusinessTransactions.SalaryPaymentToBankAccounts);
						DocumentData.Insert("CashFlowItem", 
							Catalogs.CashFlowReportItems.CashFlowItemForBusinessTransaction(DocumentData.BusinessOperation));
			
						DocumentData.Insert("AdvanceHolder",                 DecryptionString.Employee);
						DocumentData.Insert("PaysheetNumber", DecryptionString.PaysheetNumber);
						DocumentData.Insert("IncomingDocumentDate",          BegOfDay(DecryptionString.PaysheetDate));
						DocumentData.Insert("PaysheetDate",  BegOfDay(DecryptionString.PaysheetDate));
						DocumentData.Insert("CounterpartyBankAccount",       DecryptionString.BankAccount);
						DocumentData.Insert("DocumentAmount",                 	DecryptionString.Sum);
						
					 	DataExchangeXDTOServer.XDTOObjectStructureToIBData(
							ExchangeComponents,
							DocumentData,
							DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Document_SBDSFromStructure__"), 
							"ConvertAndWrite");
					EndDo;
				EndIf;
			EndIf;	
		EndIf;
	EndIf;
EndProcedure

