	ProcessingRule.Name                     = "Document_ResortmentOfGoods_Shipment";
	ProcessingRule.SelectionObjectMetadata = Metadata.Documents.GoodsMisgrading;
	ProcessingRule.OnProcess            = "DPR_Document_GoodsMisgrading_Send_OnProcess";
	ProcessingRule.DataClearing           = True;
	ProcessingRule.OCRUsed.Add("Document_ReSortingToReRegistration_Sending");
	ProcessingRule.OCRUsed.Add("Document_ResortingToInventoryWriteOff_Sending");
	ProcessingRule.OCRUsed.Add("Document_ResortmentOfGoods_Shipment");
EndProcedure
Procedure DPR_Document_GoodsMisgrading_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	FormatVersionLessThan1_19 = (NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.19"));
	If Not FormatVersionLessThan1_19 Then	
		UsageOCR.Document_ResortmentOfGoods_Shipment = True; 
		UsageOCR.Document_ReSortingToReRegistration_Sending = False;
		UsageOCR.Document_ResortingToInventoryWriteOff_Sending = False;
	Else 
		UsageOCR.Document_ResortmentOfGoods_Shipment = False;
		UsageOCR.Document_ReSortingToReRegistration_Sending = True;
		UsageOCR.Document_ResortingToInventoryWriteOff_Sending = True;
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	Query.SetParameter("Ref",    IBData.Ref);
	Query.SetParameter("Date",      IBData.Date);
	Query.SetParameter("PricesKind",    IBData.PriceKind);
	Query.SetParameter("RegCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	Query.SetParameter("DocumentCurrency", IBData.Currency);
	
	Query.Text =
		"SELECT
		|	Goods.ProductsRecordingAsReceived AS Products,
		|	Goods.CharacteristicRecordingAsReceived AS Characteristic,
		|	Goods.BatchReceipt AS Series,
		|	Goods.Products AS WriteOffProducts,
		|	Goods.Characteristic AS WriteOffFeature,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	1 AS ZoomRatio,
		|	Goods.Count AS Count,
		|	Goods.Price AS Price,
		|	Goods.Price * Goods.Count AS Sum,
		|	Goods.CCDNumber AS CCDNumber,
		|	Goods.QuantityByGBRN AS QuantityByGBRN,
		|	Goods.LineNumber AS LineNumber
		|INTO TemporaryTableOfGoods_
		|FROM
		|	Document.GoodsMisgrading.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref
		|
		|INDEX BY
		|	WriteOffProducts,
		|	WriteOffFeature";
	
	Query.Execute();
	
	If IBData.ReceiveGoodsAtCostTheyWereIssuedFromWarehouse Then
		
		Query.Text =
			"SELECT
			|	TemporaryTableOfGoods_.Products AS Products,
			|	TemporaryTableOfGoods_.Characteristic AS Characteristic,
			|	CAST(ItemPricesCrossSectionOfTheLatest.Price / ISNULL(&QueryTextPackagingFactor1, 1) * ISNULL(&QueryTextPackagingFactor2, 1) * CASE
			|		WHEN &RegCurrency <> ItemPricesCrossSectionOfTheLatest.Currency
			|			THEN CASE
			|					WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
			|							AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
			|							AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
			|							AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
			|						THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
			|					ELSE 0
			|				END
			|		ELSE 1
			|	END AS NUMBER(31, 2)) AS Price,
			|	TemporaryTableOfGoods_.CCDNumber AS CCDNumber,
			|	TemporaryTableOfGoods_.QuantityByGBRN AS QuantityByGBRN,
			|	TemporaryTableOfGoods_.UnitOfMeasure AS UnitOfMeasure,
			|	TemporaryTableOfGoods_.ZoomRatio AS ZoomRatio,
			|	TemporaryTableOfGoods_.Count AS Count,
			|	TemporaryTableOfGoods_.LineNumber AS LineNumber,
			|	TemporaryTableOfGoods_.Series AS Series
			|INTO PrimaryData
			|FROM
			|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
			|		LEFT JOIN InformationRegister.ItemsPrices.SliceLast(
			|				&Date,
			|				PriceKind = &PricesKind
			|					AND (Products, Characteristic) IN
			|						(SELECT
			|							TemporaryTableOfGoods_.WriteOffProducts,
			|							TemporaryTableOfGoods_.WriteOffFeature
			|						FROM
			|							TemporaryTableOfGoods_ AS TemporaryTableOfGoods_)) AS ItemPricesCrossSectionOfTheLatest
			|		ON TemporaryTableOfGoods_.WriteOffProducts = ItemPricesCrossSectionOfTheLatest.Products
			|			AND TemporaryTableOfGoods_.WriteOffFeature = ItemPricesCrossSectionOfTheLatest.Characteristic
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &RegCurrency) AS CurrencyRatesPrices
			|		ON (ItemPricesCrossSectionOfTheLatest.Currency = CurrencyRatesPrices.Currency)
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &RegCurrency AND BaseCurrency = &RegCurrency) AS Currency_Rates
			|		ON (TRUE)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	PrimaryData.Products AS Products,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	CASE
			|		WHEN PrimaryData.Price < 0.01
			|			THEN 0.01
			|		ELSE CAST(PrimaryData.Price AS NUMBER(31, 2))
			|	END AS Price,
			|	CAST(CASE
			|			WHEN PrimaryData.Price < 0.01
			|				THEN 0.01
			|			ELSE CAST(PrimaryData.Price AS NUMBER(31, 2))
			|		END * PrimaryData.Count AS NUMBER(31, 2)) AS Sum,
			|	PrimaryData.UnitOfMeasure AS UnitOfMeasure,
			|	PrimaryData.ZoomRatio AS ZoomRatio,
			|	PrimaryData.Count AS Count,
			|	PrimaryData.LineNumber AS LineNumber
			|FROM
			|	PrimaryData AS PrimaryData";
		
		Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor1",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"ItemPricesCrossSectionOfTheLatest.Package",
			"ItemPricesCrossSectionOfTheLatest.Products"));
			
		Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor2",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"TemporaryTableOfGoods_.UnitOfMeasure",
			"TemporaryTableOfGoods_.Products"));
			
		Query.Text = StrReplace(Query.Text, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "PrimaryData"));
			
		Query.Text = StrReplace(Query.Text, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "PrimaryData"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "PrimaryData"));
	
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "PrimaryData"));
			
		Query.SetParameter("Date",   IBData.Date);
		Query.SetParameter("PricesKind", Common.ObjectAttributeValue(IBData.Warehouse, "AccountingPriceType"));
		Query.SetParameter("Currency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		
	Else
		
		Query.Text =
			"SELECT
			|	TemporaryTableOfGoods_.Products AS Products,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	TemporaryTableOfGoods_.UnitOfMeasure AS UnitOfMeasure,
			|	TemporaryTableOfGoods_.ZoomRatio AS ZoomRatio,
			|	TemporaryTableOfGoods_.Count AS Count,
			|	CAST(TemporaryTableOfGoods_.Price * CASE
			|			WHEN &RegCurrency <> &DocumentCurrency
			|				THEN CASE
			|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
			|								AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
			|								AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
			|								AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
			|							THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
			|						ELSE 0
			|					END
			|			ELSE 1
			|		END AS NUMBER(31, 2)) AS Price,
			|	CAST(TemporaryTableOfGoods_.Sum * CASE
			|			WHEN &RegCurrency <> &DocumentCurrency
			|				THEN CASE
			|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
			|								AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
			|								AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
			|								AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
			|							THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
			|						ELSE 0
			|					END
			|			ELSE 1
			|		END AS NUMBER(31, 2)) AS Sum
			|FROM
			|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &DocumentCurrency AND BaseCurrency = &RegCurrency) AS CurrencyRatesPrices
			|		ON (TRUE)
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &RegCurrency AND BaseCurrency = &RegCurrency) AS Currency_Rates
			|		ON (TRUE)
			|
			|ORDER BY
			|	TemporaryTableOfGoods_.LineNumber";
		
		Query.Text = StrReplace(Query.Text, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "TemporaryTableOfGoods_"));
			
		Query.Text = StrReplace(Query.Text, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "TemporaryTableOfGoods_"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "TemporaryTableOfGoods_"));
	
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "TemporaryTableOfGoods_"));
			
	EndIf;
	
	GoodsTable = Query.Execute().Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsTable, True, False);
	
	ThereIsEmpty = False;
	For Each String In GoodsTable Do
		If Not ValueIsFilled(String.Price) Or Not ValueIsFilled(String.Sum) Then
			ThereIsEmpty = True;
			Break;
		EndIf;
	EndDo;
	
	If ThereIsEmpty Then
		
		UsageOCR.Document_ReSortingToReRegistration_Sending = False;
		UsageOCR.Document_ResortingToInventoryWriteOff_Sending      = False;
		WarningTemplate = NStr("vi = 'Không thể kết xuất chứng từ %1,
		|bởi vì không phải tất cả mặt hàng nhập đều được đặt đơn giá kế toán.
		|Kiểu đơn giá kế toán được đặt trong tham số kho bãi là ""Dạng giá kế toán"".';
		|ru = 'Документ %1 не может быть выгружен,
		|т.к. не для всех приходуемых номенклатурных позиций задана учетная цена.
		|Тип учетной цены задается в параметрах склада как ""Учетный вид цены"".';
		|en = 'The %1 document cannot be exported 
		| as an accounting price is set not for all product items to receive.
		|The accounting price type is set in warehouse parameters as ""Accounting price type"".'; fa = 'The %1 document cannot be exported 
		| as an accounting price is set not for all product items to receive.
		|The accounting price type is set in warehouse parameters as ""Accounting price type"".';
		|it = 'Il documento %1 non può essere caricato,
		|poiché non tutte le posizioni di nomenclatura da ricevere hanno un prezzo contabile indicato.
		|Il tipo di prezzo contabile viene indicato nei parametri di magazzino come ""Tipo di prezzo contabile"".';
		|pl = 'Dokument %1 nie może być eksportowany,
		|ponieważ nie dla wszystkich rejestrowanych produktów jest ustawiona cena ewidencyjna.
		|Rodzaj ceny ewidencyjnej jest ustawiany w parametrach magazynu jako ""Ewidencyjny rodzaj ceny"".';
		|tr = '%1 belgesi yüklenemez
		|çünkü tüm gelen öğe kalemlerinin muhasebe fiyatı yoktur.
		|Muhasebe fiyat tipi, ambar parametrelerinde ""Muhasebe fiyat türü"" olarak ayarlanmıştır.'");
		
		WarningText = StrTemplate(WarningTemplate, IBData.Ref);
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
	EndIf;
	
	IBData.AdditionalProperties.Insert("Goods", GoodsTable);
EndProcedure

