Function ThisIsIntercampanyDocument(Document)
	ThisIsIntercampanyDocument = False;
	
	If Not ValueIsFilled(Document) Then
		
		Return ThisIsIntercampanyDocument;
		
	EndIf;
	
	DocumentType = TypeOf(Document);
	
	If DocumentType = Type("DocumentRef.IntercompanyGoodsReturn")
		Or DocumentType = Type("DocumentRef.CustomerInvoiceIntercompany")
		Or DocumentType = Type("DocumentRef.CommissionReportIntercompany")
		Or DocumentType = Type("DocumentRef.CommissionWriteOffReportIntercompany") Then
		
		ThisIsIntercampanyDocument = True;
		
	EndIf;
	
	Return ThisIsIntercampanyDocument;
EndFunction


Function ThisIsUT()
	Return GetFunctionalOption("TradeManagement");
EndFunction
Function ThisIsBusinessTransactionRevaluationOfFinancialInstruments(BusinessTransaction)
	Return BusinessTransaction = Enums.BusinessTransactions.RevaluationOfFinancialInstruments;
EndFunction
Function ThisIsBusinessOperationSettlementOfDeposits(BusinessTransaction)
	Return (BusinessTransaction = Enums.BusinessTransactions.TransferToDeposits
		Or BusinessTransaction = Enums.BusinessTransactions.CashReceiptUnderDeposits);
EndFunction
Function ThisIsBusinessTransactionLoanSettlements(BusinessTransaction)
	Return BusinessTransaction = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty
		Or BusinessTransaction = Enums.BusinessTransactions.CashIssueAsLoanToCounterparty
		Or BusinessTransaction = Enums.BusinessTransactions.LoanRepaymentByEmployee;
EndFunction
Function ThisIsBusinessTransactionCreditSettlements(BusinessTransaction)
	Return BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromLoansRepayment
			Or BusinessTransaction = Enums.BusinessTransactions.PaymentOnLoansAndBorrowingsReceived;
EndFunction
Function ThisIsBusinessOperationSettlementsOnLoansLoans(BusinessTransaction)
	Return BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromLoansRepayment
		Or BusinessTransaction = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty
		Or BusinessTransaction = Enums.BusinessTransactions.PaymentOnLoansAndBorrowingsReceived
		Or BusinessTransaction = Enums.BusinessTransactions.CashIssueAsLoanToCounterparty;
EndFunction

