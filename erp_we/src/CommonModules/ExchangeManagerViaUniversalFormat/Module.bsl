Procedure AddDPR_Document_CommissionReportIntercompany_Send(DataProcessingRules)
	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Document_CommissionReportBetweenOrganizations__";
	ProcessingRule.SelectionObjectMetadata = Metadata.Documents.CommissionReportIntercompany;
	ProcessingRule.OnProcess            = "DPR_Document_CommissionReportIntercompany_Send_OnProcess";
	ProcessingRule.DataClearing           = True;
	ProcessingRule.OCRUsed.Add("ReportCommissionBetweenOrganizations_CommissionAgent__");
	ProcessingRule.OCRUsed.Add("ReportCommissionBetweenOrganizations_Commitee_Sending");
EndProcedure
Procedure DPR_Document_CommissionReportIntercompany_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	If ExchangeComponents.ConversionParameters_SSLy.UseFilterByCompanies Then
		
		ListOfOrganizationsNode = ExchangeComponents.ConversionParameters_SSLy.Companies;
		
		UploadCommissionAgentSReport = ListOfOrganizationsNode.FindByValue(IBData.Organization) <> Undefined;
		UploadReportToCommittee	   = ListOfOrganizationsNode.FindByValue(IBData.Consignee) <> Undefined;
		
	Else
		
		UploadCommissionAgentSReport = ExchangeComponents.ConversionParameters_SSLy.UnloadManagementCompany 
			Or IBData.Organization <> ManagementCompany();
			
		UploadReportToCommittee = ExchangeComponents.ConversionParameters_SSLy.UnloadManagementCompany 
			Or IBData.Consignee <> ManagementCompany();
		
	EndIf;
	
	UsageOCR.ReportCommissionBetweenOrganizations_Commitee_Sending  = UploadReportToCommittee;
	UsageOCR.ReportCommissionBetweenOrganizations_CommissionAgent__ = UploadCommissionAgentSReport;
EndProcedure

