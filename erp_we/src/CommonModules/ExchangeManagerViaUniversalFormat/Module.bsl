Procedure PCO_Document_PBDSSettlementsWithEmployees_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	If ThisIsUT()And ReceivedData.BusinessOperation = Enums.BusinessTransactions.LoanRepaymentByEmployee Then
		WarningTemplate = NStr("ru = 'Операция %1 не поддерживается в УТ.';
								|vi = 'The ""%1"" operation is not supported in TM.';
								|en = 'The ""%1"" operation is not supported in TM.'; fa = 'The ""%1"" operation is not supported in TM.';
								|it = 'The ""%1"" operation is not supported in TM.';
								|pl = 'The ""%1"" operation is not supported in TM.';
								|tr = '%1 işlemi Ticaret Yönetimini desteklemiyor.'");
		WarningText = StrTemplate(WarningTemplate, ReceivedData.BusinessOperation); 
		InformationRegisters.DataExchangeResults.RecordDocumentCheckError(
				ReceivedData.Ref,
				ExchangeComponents.CorrespondentNode,
				WarningText,
				Enums.DataExchangeIssuesTypes.UnpostedDocument);
	EndIf;
	BeforeMerzhevanii_PBDS(ReceivedData, IBData, ExchangeComponents);
	
	If IBData <> Undefined Then
		
		// Replacing the properties that we got from the XDTO
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
		// Alignment of the amount in the decryption and in the header
		If IBData.ARAPDetails.Count() = 1 Then
			IBData.ARAPDetails[0].Sum = IBData.DocumentAmount;
		EndIf; 
		
	EndIf;
	
	Merzhevanie_PBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents);
	AfterMerzhevaniya_PBDS(ReceivedData, IBData, ExchangeComponents);
	
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
EndProcedure

