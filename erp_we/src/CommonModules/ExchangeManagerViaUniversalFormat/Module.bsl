Procedure OCR_Document_ReversingEntry_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData <> Undefined Then
		
		If DocumentCorrection.IsThereFixOrReverse(IBData.ReversedDocument) Then
	
			If ExchangeComponents.IsExchangeViaExchangePlan Then
			
				ReasonIsTemplate = NStr("ru = 'Для документа ""%1"" обнаружен исправительный документ.
										|Документ не загружен.';
										|vi = 'For the ""%1"" document, a correction document is detected.
										|The document is not imported.';
										|en = 'For the ""%1"" document, a correction document is detected.
										|The document is not imported.'; fa = 'For the ""%1"" document, a correction document is detected.
										|The document is not imported.';
										|it = 'Per il documento ""%1"" è stato rilevato un documento correttivo.
										|Documento non scaricato.';
										|pl = 'Dla dokumentu ""%1"" wykryto dokument korygujący.
										|Dokument nie został przesłany.';
										|tr = '""%1"" belgesi için düzeltme belgesi bulundu.
										|Belge yüklenmedi.'", Common.DefaultLanguageCode());
				
				InformationRegisters.DataExchangeResults.RecordDocumentCheckError(
					IBData.Ref,
					ExchangeComponents.CorrespondentNode,
					StrTemplate(ReasonIsTemplate, IBData.Ref),
					Enums.DataExchangeIssuesTypes.BlankAttributes);
		
			EndIf;
		
			IBData = Undefined;
			ReceivedData = Undefined;
			
		EndIf;
		
	Else
		
		// If the document being canceled has not yet been fully converted, an error may occur during the primary recording
		//	. You need to pass an additional parameter to disable the recording of primary document data
		
		If Not LinkIsFilledInAndExists(ReceivedData.ReversedDocument) Then
			
			ReceivedData.AdditionalProperties.Insert("RegisterPrimaryDocumentData", False);
			
		EndIf;
		
	EndIf;
EndProcedure

