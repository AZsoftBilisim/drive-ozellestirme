Procedure PKO_Document_ApplicationForCashExpenseSettlementsWithSOTR_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder Then
		ARAPType = "Subreport";
	Else
		ARAPType = "Loans_";
	EndIf;
	XDTOData.Insert("ARAPType", ARAPType);
	ThisIsWE = Not GetFunctionalOption("LocalizationRFService");
	Query = New Query;
	QueryText =  ?(Not ThisIsUT() And Not ThisIsWE,
			"SELECT
			|	SUM(ARAPDetails.Sum) AS Sum,
			|	ARAPDetails.CashFlowItem AS CFItem,
			|	CASE
			|		WHEN ARAPDetails.EmployeeLoanAgreement.Individual = VALUE(Catalog.Persons.EmptyRef)
			|				OR ARAPDetails.EmployeeLoanAgreement.Individual IS NULL
			|			THEN ARAPDetails.Ref.AdvanceHolder
			|		ELSE ARAPDetails.EmployeeLoanAgreement.Individual
			|	END AS Employee
			|FROM
			|	Document.PaymentRequest.ARAPDetails AS ARAPDetails
			|WHERE
			|	ARAPDetails.Ref = &Ref
			|
			|GROUP BY
			|	ARAPDetails.CashFlowItem,
			|	CASE
			|		WHEN ARAPDetails.EmployeeLoanAgreement.Individual = VALUE(Catalog.Persons.EmptyRef)
			|				OR ARAPDetails.EmployeeLoanAgreement.Individual IS NULL
			|			THEN ARAPDetails.Ref.AdvanceHolder
			|		ELSE ARAPDetails.EmployeeLoanAgreement.Individual
			|	END"
			,
			"SELECT
			|	SUM(ARAPDetails.Sum) AS Sum,
			|	ARAPDetails.CashFlowItem AS CFItem,
			|	ARAPDetails.Ref.AdvanceHolder AS Employee
			|FROM
			|	Document.PaymentRequest.ARAPDetails AS ARAPDetails
			|WHERE
			|	ARAPDetails.Ref = &Ref
			|
			|GROUP BY
			|	ARAPDetails.CashFlowItem,
			|	ARAPDetails.Ref.AdvanceHolder"
			);
	Query.Text = QueryText;
	Query.SetParameter("Ref", IBData.Ref);
	TabRP = Query.Execute().Unload();
	XDTOData.Insert("ARAPDetails", TabRP);
EndProcedure

