Procedure OCR_Document_SubcontractorReport25_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ProcessorReport25_Send", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	UnloadDivision(IBData, XDTOData);
	XDTOData.Insert("CostDivision", XDTOData.Department); 
	
	ProductTrackingAnalystRequest = New Query("
		|SELECT DISTINCT
		|	ProcessorReportProducts.Products.AnalyticalGroup AS ProductsAnalyticalAccountingGroup
		|FROM
		|	Document.SubcontractorReport2_5.ManufacturedProducts AS ProcessorReportProducts
		|WHERE
		|	ProcessorReportProducts.Ref = &Ref");
	ProductTrackingAnalystRequest.SetParameter("Ref", IBData.Ref);
	SelectionProductAccountingAnalyst = ProductTrackingAnalystRequest.Execute().Select();
	If SelectionProductAccountingAnalyst.Count() = 1 Then
		SelectionProductAccountingAnalyst.Next();
		XDTOData.Insert(
			"AnalyticalProductGroup", 
			SelectionProductAccountingAnalyst.ProductsAnalyticalAccountingGroup);
	EndIf;
	
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData, "Counterparty, Organization");
		DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithVendor";
		XDTOData.Insert("Contract", ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents));
	EndIf;
	
	DocumentData =
		"SELECT
		|	Services.Products AS Products,
		|	Services.Products.Description AS Content,
		|	Services.VATRate AS VATRate,
		|	Services.Count AS Count,
		|	Services.Sum AS Sum,
		|	Services.Price AS Price,
		|	Services.VATAmount AS VATAmount
		|FROM
		|	Document.SubcontractorReport2_5.Services AS Services
		|WHERE
		|	Services.Ref = &Ref
		|	AND Services.Ref.ProcessingServices = VALUE(Enum.OptionsOfRegisteringProcessingDocumentServices.SpecifiedInOrder)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
		|	NestedQuery.Count AS Count,
		|	NestedQuery.InventoryType AS InventoryType
		|FROM
		|	(SELECT
		|		UsedMaterials.ItemsLocationAttributes.Products AS Products,
		|		UsedMaterials.ItemsLocationAttributes.Characteristic AS Characteristic,
		|		UsedMaterials.ItemsLocationAttributes.Series AS Series,
		|		UsedMaterials.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|		SUM(UsedMaterials.Count) AS Count,
		|		CASE
		|			WHEN UsedMaterials.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|				THEN CAST(""ReturnContainers"" AS STRING(20))
		|			WHEN UsedMaterials.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|				THEN CAST(""CommissionGoods"" AS STRING(20))
		|			ELSE CAST(&OwnProducts AS STRING(20))
		|		END AS InventoryType
		|	FROM
		|		Document.SubcontractorReport2_5.InventoryOwnerAttributesMaterials AS UsedMaterials
		|	WHERE
		|		UsedMaterials.Ref = &Ref
		|	
		|	GROUP BY
		|		UsedMaterials.ItemsLocationAttributes,
		|		UsedMaterials.InventoryOwnerAttribute,
		|		UsedMaterials.ItemsLocationAttributes.Products,
		|		UsedMaterials.ItemsLocationAttributes.Characteristic,
		|		UsedMaterials.ItemsLocationAttributes.Products.UnitOfMeasure,
		|		CASE
		|			WHEN UsedMaterials.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|				THEN CAST(""ReturnContainers"" AS STRING(20))
		|			WHEN UsedMaterials.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|				THEN CAST(""CommissionGoods"" AS STRING(20))
		|			ELSE CAST(&OwnProducts AS STRING(20))
		|		END,
		|		UsedMaterials.ItemsLocationAttributes.Series) AS NestedQuery
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
		|	NestedQuery.Count AS Count
		|FROM
		|	(SELECT
		|		ProcessorReportProducts.ItemsLocationAttributes.Products AS Products,
		|		ProcessorReportProducts.ItemsLocationAttributes.Characteristic AS Characteristic,
		|		ProcessorReportProducts.ItemsLocationAttributes.Series AS Series,
		|		ProcessorReportProducts.Package AS Package,
		|		ProcessorReportProducts.NumberOfPackages AS NumberOfPackages,
		|		ProcessorReportProducts.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|		SUM(ProcessorReportProducts.Count) AS Count
		|	FROM
		|		Document.SubcontractorReport2_5.ManufacturedProducts AS ProcessorReportProducts
		|	WHERE
		|		ProcessorReportProducts.Ref = &Ref
		|	
		|	GROUP BY
		|		ProcessorReportProducts.ItemsLocationAttributes,
		|		ProcessorReportProducts.ItemsLocationAttributes.Products,
		|		ProcessorReportProducts.ItemsLocationAttributes.Characteristic,
		|		ProcessorReportProducts.ItemsLocationAttributes.Products.UnitOfMeasure,
		|		ProcessorReportProducts.Package,
		|		ProcessorReportProducts.NumberOfPackages,
		|		ProcessorReportProducts.ItemsLocationAttributes.Series) AS NestedQuery";
	
	FillInYourOwnProductsInText(DocumentData);
	
	DocumentData = StrReplace(DocumentData, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "NestedQuery"));
		
	DocumentData = StrReplace(DocumentData, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "NestedQuery"));
		
	DocumentData = StrReplace(DocumentData, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "NestedQuery"));
	
	Query = New Query(DocumentData);
	Query.SetParameter("Ref", IBData.Ref);
	QueryResult = Query.ExecuteBatch();
	
	OtherServices = QueryResult[0].Unload();
	For Each RowService In OtherServices Do
		If RowService.Sum = 0 Then
			RowService.Sum = 0.01;
		EndIf;
		If RowService.Price = 0 Then
			RowService.Price = 0.01;
		EndIf;
	EndDo;   
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(OtherServices, False);
	EndIf;
	XDTOData.Insert("Services",    OtherServices);
	
	UsedMaterials = QueryResult[1].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, UsedMaterials, True, False);
	
	XDTOData.Insert("UsedMaterials", UsedMaterials);
	
	ManufacturedProduct = QueryResult[2].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, ManufacturedProduct);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, ManufacturedProduct, "IncomeForActivities", "PurchaseForActivity");
	XDTOData.Insert("ManufacturedProduct", ManufacturedProduct);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	If IBData.ProcessingServices = Enums.OptionsOfRegisteringProcessingDocumentServices.RegisteredSeparately
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.4") Then
		
		//In versions of the format below 1.4, the "Amount" field is mandatory,
		//and if the services are specified separately, the amount will be equal to 0
		//and the exchange will fail with an error.           
		XDTOData.Insert("Sum",    -0.01);	
	EndIf;
EndProcedure

