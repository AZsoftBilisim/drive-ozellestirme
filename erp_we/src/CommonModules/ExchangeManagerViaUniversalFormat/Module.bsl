Procedure DPR_Catalog_Companies_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	If StandardSubsystemsServer.IsBaseConfigurationVersion() Then
		ThisIsDefaultCompany = False;    
		TIN =  XDTOData.KeyProperties.TIN;
		CRTR =  XDTOData.KeyProperties.CRTR; 
		If XDTOData.Property("KeyProperties") Then
			KeyProperties = XDTOData.KeyProperties; // Structure 
		Else KeyProperties = Undefined
		EndIf;
		If KeyProperties <> Undefined And KeyProperties.Property("AbbreviatedDescription") Then
			AbbreviatedDescription = KeyProperties.AbbreviatedDescription; // String
		Else
			AbbreviatedDescription = KeyProperties.Description; // String
		EndIf;
	
		Query = New Query;
		Query.Text = 
		"SELECT
		|	Companies.Ref AS Ref
		|FROM
		|	Catalog.Companies AS Companies
		|WHERE
		|	Companies.CRTR = &CRTR
		|	AND Companies.TIN = &TIN
		|	AND Companies.AbbreviatedDescription = &AbbreviatedDescription";
		
		Query.SetParameter("TIN", TIN);
		Query.SetParameter("CRTR", CRTR);
		Query.SetParameter("AbbreviatedDescription", AbbreviatedDescription);
		
		QueryResult = Query.Execute();
		If Not QueryResult.IsEmpty() Then
			ThisIsDefaultCompany = True;
		EndIf;
		
		If Not ThisIsDefaultCompany Then
			ClearUsageOCR(UsageOCR); 
			If KeyProperties <> Undefined Then  
	
				Description = KeyProperties.Description;
			Else
				Description = "";
			EndIf;
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(NStr("vi = 'Đối tượng: %1 chưa được ghi lại. Trong phiên bản cơ sở, tiến hành ghi nhận chỉ theo một doanh nghiệp.';
																						|ru = 'Объект: %1 не записан. В базовой версии учет ведется только по одной организации.';
																						|en = 'The %1 object is not saved. In the base version, accounting is kept for one company only.'; fa = 'The %1 object is not saved. In the base version, accounting is kept for one company only.';
																						|it = 'The %1 object is not saved. In the base version, accounting is kept for one company only.';
																						|pl = 'The %1 object is not saved. In the base version, accounting is kept for one company only.';
																						|tr = 'Nesne: %1 kaydedilmedi. Ana sürümdeki kayıtlar sadece tek bir iş yeri için tutulmaktadır.'"), Description);
			DataExchangeXDTOServer.WriteEventLogDataExchange1(ErrorText, ExchangeComponents, , Description);
			ExchangeComponents.ErrorFlag = True;
			ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.Error;
			Raise(ErrorText);
			
		EndIf;  
	EndIf;
EndProcedure


