		|FROM
		|	Document.GoodsShipmentFromStorage.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref";
	
	FillInYourOwnProductsInText(DocumentData);
	
	DocumentData = StrReplace(DocumentData, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	DocumentData = StrReplace(DocumentData, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	DocumentData = StrReplace(DocumentData, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
	
	DocumentData = StrReplace(DocumentData, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	DocumentData = StrReplace(DocumentData, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
	
	Query = New Query(DocumentData);
	Query.SetParameter("Ref", IBData.Ref);
	Goods = Query.Execute().Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	
	XDTOData.Insert("Goods", Goods);
