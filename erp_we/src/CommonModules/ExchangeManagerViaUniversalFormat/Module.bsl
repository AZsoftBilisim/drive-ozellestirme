Procedure OCR_Document_PSImplementation_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If Not (XDTOData.Property("GiftCertificates") And ValueIsFilled(XDTOData.GiftCertificates)) Then
		Return;
	EndIf;
	
	ReceivedData.Posted = True;
	ReceivedData.Status = Enums.CashRegisterReceiptStatuses.ReceiptIsIssued_;
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	Warehouse = Catalogs.Warehouses.EmptyRef();
	If XDTOData.Property("Warehouse") Then
		Warehouse = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
			ExchangeComponents,
			XDTOData.Warehouse,
			DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Warehouses_Receive"), 
			"GetRef");
	EndIf;
	ReceivedData.AdditionalProperties.Insert("Warehouse", Warehouse);
	
	// GiftCertificates
	ArrayOfRows = New Array;
	
	If XDTOData.Property("GiftCertificates")
		And ValueIsFilled(XDTOData.GiftCertificates) Then
		
		For Each String In XDTOData.GiftCertificates Do
		
			StringDataStructure = New Structure;
			StringDataStructure.Insert("Sum", String.Sum);
			If ValueIsFilled(String.Barcode) Then
				// We are preparing instructions for converting a gift certificate.
				Instruction = New Structure;
				Instruction.Insert("OCRName", "Catalog_GiftCertificates");
			
				GiftCertificateStructure = New Structure;
				GiftCertificateStructure.Insert("Barcode", String.Barcode);
				GiftCertificateStructure.Insert("MagneticCode", String.MagneticCode);
				GiftCertificateStructure.Insert("SerialNumber", String.SerialNumber);
				GiftCertificateStructure.Insert("GiftCertificateKind", String.GiftCertificateKind);
			
				Instruction.Insert("Value", GiftCertificateStructure);
			
				StringDataStructure.Insert("GiftCertificate", Instruction);
			EndIf;
			ArrayOfRows.Add(StringDataStructure);
			
		EndDo;
	EndIf;
	
	ReceivedData.AdditionalProperties.Insert("GiftCertificates", ArrayOfRows);
	
	// Payment cards.
	ArrayOfLinesPaymentPC = New Array;
	
	If XDTOData.Property("PaymentByCreditCardsForGiftCertificates")
		And ValueIsFilled(XDTOData.PaymentByCreditCardsForGiftCertificates) Then
		
		For Each String In XDTOData.PaymentByCreditCardsForGiftCertificates Do
			StringDataStructure = New Structure;
			StringDataStructure.Insert("Sum", String.PayAmount);
			StringDataStructure.Insert("PaymentCardNumber", String.CardNumber);
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.11") Then
				If StringDataStructure.Property("TypesOfCashRegisterPaymentSystem") Then
					StringDataStructure.Insert("PaymentKind_", String.TypesOfCashRegisterPaymentSystem);
				EndIf;
			EndIf;
			If ValueIsFilled(String.POSTerminal) Then
				CatPOSTerminal = String.POSTerminal;
				If CatPOSTerminal.Property("Number") And Not IsBlankString(CatPOSTerminal.Number) Then
					Instruction = New Structure;
					Instruction.Insert("Value", String.POSTerminal);
					Instruction.Insert("OCRName", "Catalog_POSTerminals_Receive");
			
					StringDataStructure.Insert("POSTerminal", Instruction);
			 	EndIf;
			EndIf;
			ArrayOfLinesPaymentPC.Add(StringDataStructure);
			
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("PaymentWithPaymentCards", ArrayOfLinesPaymentPC);
	EndIf;
	
	ReceivedData.DocumentAmount = XDTOData.GiftCertificates.Total("Sum");
EndProcedure
Procedure OCR_Document_PSImplementation_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
		ReceivedData.AdditionalProperties, ExchangeComponents);
	
	Warehouse = ReceivedData.AdditionalProperties.Warehouse;
	
	// If there is an object in the database, it will be recorded (and not the received data).
	// The header and tabular part are preliminarily transferred from the received data to the given data:
	// the header is part of the properties from the PKS, the tabular part is completely taken from the received data.
	If IBData <> Undefined Then
	
		// We transfer those properties that are specified in the PKS.
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		// Table parts
		IBData.GiftCertificates.Load(ReceivedData.GiftCertificates.Unload());
		If IBData.PaymentWithPaymentCards.Total("Sum") <> ReceivedData.PaymentWithPaymentCards.Total("Sum")
			Or ReceivedData.PaymentWithPaymentCards.Count() <> IBData.PaymentWithPaymentCards.Count() Then
			IBData.PaymentWithPaymentCards.Load(ReceivedData.PaymentWithPaymentCards.Unload());
		EndIf;
	
		ReceivedData   = Undefined;
		DataToWriteToIB = IBData;
		
	Else
		DataToWriteToIB = ReceivedData;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.CashRegister) Then
		
		Warehouse = WarehouseToLoad(Warehouse, ExchangeComponents.ConversionParameters_SSLy);
				
		StructureOfKKMCashRegisterSearch = New Structure("Organization, Currency, CashRegister");
		StructureOfKKMCashRegisterSearch.Insert("Warehouse", Warehouse);
				
		FillPropertyValues(StructureOfKKMCashRegisterSearch, DataToWriteToIB, "Organization, Currency, CashRegister");
	
		FillInCashRegisterByCurrencyWarehouseAndOrganization(StructureOfKKMCashRegisterSearch, ExchangeComponents);
		
		DataToWriteToIB.CashRegister = StructureOfKKMCashRegisterSearch.CashRegister;
		
	EndIf;
	
	For Each PaymentLine_ In DataToWriteToIB.PaymentWithPaymentCards Do
		If Not ValueIsFilled(PaymentLine_.POSTerminal) Then
			PaymentLine_.POSTerminal = Catalogs.POSTerminals.DefaultPOSTerminal(DataToWriteToIB.Organization);
		EndIf;
	EndDo;
	
	If Not ValueIsFilled(DataToWriteToIB.CashRegisterShift) Then
		
		DocumentsWithGiftCertificates = ExchangeComponents.ConversionParameters_SSLy.DocumentsWithGiftCertificates; // ValueTable
			
		NewRow = DocumentsWithGiftCertificates.Add();
		NewRow.DocumentRef   = ?(IBData = Undefined, DataToWriteToIB.GetNewObjectRef(), DataToWriteToIB.Ref);
		NewRow.DocumentDate    = DataToWriteToIB.Date;
		NewRow.DocumentQueue = 2;
		NewRow.CashRegister         = DataToWriteToIB.CashRegister;
		NewRow.Organization      = DataToWriteToIB.Organization;
		NewRow.Currency           = DataToWriteToIB.Currency;
		
	EndIf;
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
EndProcedure

