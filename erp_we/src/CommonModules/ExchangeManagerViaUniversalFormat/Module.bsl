		Return
	EndIf;
	
	If Not ValueIsFilled(ReceivedData.Bank)
		And XDTOData.KeyProperties.Property("Bank") Then
		
		Bank =  XDTOData.KeyProperties.Bank; // Structure
			
		If XDTOData.KeyProperties.Bank.Property("BIC") Then
			ReceivedData.BankBIC = Bank.BIC;
		EndIf;
		
		If XDTOData.KeyProperties.Bank.Property("SWIFTBIC") Then
			ReceivedData.BankSWIFTCode = Bank.SWIFTBIC;
		EndIf;
	
		If XDTOData.KeyProperties.Bank.Property("Description") Then
			ReceivedData.BankDescription = Bank.Description;
		EndIf;
		
		If XDTOData.KeyProperties.Bank.Property("CorrAccount") Then
			ReceivedData.BankCorrAccount = Bank.CorrAccount;
		EndIf;
		
	EndIf;
	
	If Not ValueIsFilled(ReceivedData.TransferBank)
		And XDTOData.KeyProperties.Property("TransferBank") Then
		
		TransferBank = XDTOData.KeyProperties.TransferBank; // Structure
			
		If XDTOData.KeyProperties.TransferBank.Property("BIC") Then
			ReceivedData.TransferBankBIC = TransferBank.BIC;
		EndIf;
		
		If XDTOData.KeyProperties.TransferBank.Property("SWIFTBIC") Then
			ReceivedData.BankSWIFTCodeForPayments = TransferBank.SWIFTBIC;
		EndIf;
	
		If XDTOData.KeyProperties.TransferBank.Property("Description") Then
			ReceivedData.TransferBankDescription = TransferBank.Description;
		EndIf;
		
		If XDTOData.KeyProperties.TransferBank.Property("CorrAccount") Then
			ReceivedData.TransferBankCorrAccount = TransferBank.CorrAccount;
		EndIf;
					
	EndIf;
EndProcedure
Procedure UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents, ThereArePMAdditionalDetails = False)
	If Not (XDTOData.Property("AdditionalAttributes")
		And ValueIsFilled(XDTOData.AdditionalAttributes)) Then
		Return;
	EndIf;
	
	If StandardSubsystemsServer.IsBaseConfigurationVersion() 
		Or Not GetFunctionalOption("UseAdditionalAttributesAndInfo") Then
		Return;
	EndIf;
	
	MetaObject      = ReceivedData.Metadata();
	BaseTypeName = Common.BaseTypeNameByMetadataObject(MetaObject);
	
	StringDataType = BaseTypeName + "." + MetaObject.Name;
	
	ArrayOfStringsAdditionalDetails = New Array;
	ArrayOfStringsAdditionalInformation  = New Array;
	
	AddAttributes = ExchangeComponents.ConversionParameters_SSLy.UploadedAdditionalBankingDetailsAndInformation; // ValueTable
	
	For Each TSRow In XDTOData.AdditionalAttributes Do
		
		ThisIsAdditionalSummary = TSRow.Property.Property("IsAdditionalInfo") And TSRow.Property.IsAdditionalInfo;
		
		StringDataStructure = New Structure("Property, Value");
		
		// Checking for a simple type.
		If TypeOf(TSRow.PropertyValue) = Type("String")
			Or TypeOf(TSRow.PropertyValue) = Type("Number")
			Or TypeOf(TSRow.PropertyValue) = Type("Date")
			Or TypeOf(TSRow.PropertyValue) = Type("Boolean")
			Or TSRow.PropertyValue = Undefined Then
			
			StringDataStructure.Property = TSRow.Property;
			StringDataStructure.Value = TSRow.PropertyValue;
			
			ValueType = TypeOf(TSRow.PropertyValue);
		Else
			OCRName = "";
			ValueType = Undefined;
			LoadingAdditionalDetails_DefineNameOfICO(TSRow.PropertyValue, OCRName, ValueType);
			
			If OCRName = "" Then
				Continue;
			EndIf;
			
			StringDataStructure.Property = TSRow.Property;
			
			PropertyValue = TSRow.PropertyValue;
			If OCRName = "Catalog_AdditionalAttributesValues" Then
				If Not (PropertyValue.Property("Owner") And ValueIsFilled(PropertyValue.Owner)) Then
					// The Owner key property must be specified explicitly.
					PropertyValue.Insert("Owner", TSRow.Property);
				EndIf;
			EndIf;
			
			StringDataStructure.Value = New Structure("Value, OCRName", TSRow.PropertyValue, OCRName);
			
		EndIf;
		
		If Not ValueIsFilled(ValueType)
			Or Not Metadata.ChartsOfCharacteristicTypes.AdditionalAttributesAndInfo.Type.ContainsType(ValueType) Then
			// This value is additional.Attributes or additional.We won't be able to download the information.
			// Therefore, we skip it.
			Continue;
		EndIf;
		
		AdditionalLineDetails = AddAttributes.Add();
		AdditionalLineDetails.Property = TSRow.Property;
		AdditionalLineDetails.ThisIsAdditionalSummary = ThisIsAdditionalSummary;
		AdditionalLineDetails.ObjectType = StringDataType;
		AdditionalLineDetails.ValueType = ValueType;
		
		If ThisIsAdditionalSummary Then
			ArrayOfStringsAdditionalInformation.Add(StringDataStructure);
		ElsIf ThereArePMAdditionalDetails Then
			ArrayOfStringsAdditionalDetails.Add(StringDataStructure);
		EndIf;
		
	EndDo;
	
	If ArrayOfStringsAdditionalDetails.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("AdditionalAttributes", ArrayOfStringsAdditionalDetails);
	EndIf;
	
	If ArrayOfStringsAdditionalInformation.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("AdditionalInfo", ArrayOfStringsAdditionalInformation);
	EndIf;
EndProcedure
Procedure ImportAdditionalInfo(ObjectRef, StructureAndProperties, ExchangeComponents)
	If Not StructureAndProperties.Property("AdditionalInfo")
		Or StructureAndProperties.AdditionalInfo.Count() = 0 Then
		Return;
	EndIf;
	
	If StandardSubsystemsServer.IsBaseConfigurationVersion()
		Or Not GetFunctionalOption("UseAdditionalAttributesAndInfo") Then
		Return;
	EndIf;
	
	AdditionalInformationRecordSet = InformationRegisters.AdditionalInfo.CreateRecordSet();
	AdditionalInformationRecordSet.Filter.Object.Set(ObjectRef);
	
	PCO_AdditionalDetails = DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_AdditionalAttributes");
	
	For Each AdditionalInformationLine In StructureAndProperties.AdditionalInfo Do
		LinkProperty = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents, 
			AdditionalInformationLine.Property, 
			PCO_AdditionalDetails, 
			"GetRef").Ref;
			
		If TypeOf(AdditionalInformationLine.Value) = Type("Structure") Then
			PCO_PropertyValue = DataExchangeXDTOServer.OCRByName(ExchangeComponents, AdditionalInformationLine.Value.OCRName);
			
			PropertyValue = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents, 
				AdditionalInformationLine.Value.Value, 
				PCO_PropertyValue, 
				"GetRef").Ref;
		Else
			PropertyValue = AdditionalInformationLine.Value;
		EndIf;
		
		NewRecord1 = AdditionalInformationRecordSet.Add();
		NewRecord1.Object   = ObjectRef;
		NewRecord1.Property = LinkProperty;
		NewRecord1.Value = PropertyValue;
	EndDo;
		
	AdditionalInformationRecordSet.DataExchange.Load = True;
	AdditionalInformationRecordSet.Write();
EndProcedure
Procedure DownloadExpirationDateMeasurementUnit(XDTOData, ReceivedData, ExchangeComponents)
	If Not XDTOData.Property("ShelfLifeUnitOfMeasure")
		Or Not ValueIsFilled(XDTOData.ShelfLifeUnitOfMeasure) Then 
	
		Return;
		
	EndIf;
	            
	ShelfLifeUnitOfMeasure = Enums.TimeMeasureUnits.EmptyRef();
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
	
		PKPD_TimeUnits = PKPDByName(ExchangeComponents, "TimeUnits_Receipt");
		
		ShelfLifeUnitOfMeasure = PKPD_TimeUnits.ConvertValuesOnReceipt.Get(XDTOData.ShelfLifeUnitOfMeasure);
	
	Else
	
		CorrespondenceOfCodesToUnitsOfMeasurement = New Map;
		
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(1, Enums.TimeMeasureUnits.Second);
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(2, Enums.TimeMeasureUnits.Minute);
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(3, Enums.TimeMeasureUnits.Hour);
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(4, Enums.TimeMeasureUnits.Day);
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(5, Enums.TimeMeasureUnits.Days1);
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(6, Enums.TimeMeasureUnits.Month);
		CorrespondenceOfCodesToUnitsOfMeasurement.Insert(7, Enums.TimeMeasureUnits.Year);
		
		ShelfLifeUnitOfMeasure = CorrespondenceOfCodesToUnitsOfMeasurement.Get(XDTOData.ShelfLifeUnitOfMeasure);
	
	EndIf;  
	
	ReceivedData.AdditionalProperties.Insert("ShelfLifeUnitOfMeasure", ShelfLifeUnitOfMeasure);
EndProcedure
Procedure UploadHistoryOfBankingDetailsToReceivedData(XDTOData, ReceivedData, LineFillingRules)
	ArrayOfTSNames = New Array;
	
	ArrayOfTSNames.Add("NameHistory");
	ArrayOfTSNames.Add("CRTRHistory");
	
	For Each TSName In ArrayOfTSNames Do
		
		If XDTOData.Property(TSName) And ValueIsFilled(XDTOData[TSName]) 
			And XDTOData[TSName].Count() > 1 Then
			
			ArrayOfPropsHistoryLines = New Array;
			
			// Setting the initial value of the history, since the format does not support an empty date in multiple properties of the history of Attributes
			AttributesHistoryTable = XDTOData[TSName];
			AttributesHistoryTable.Sort("StartDate");
						
			For Each HistoryRow In XDTOData[TSName] Do
			
				DataStructureOfHistoryString = CollectionDataAsStructure(HistoryRow, LineFillingRules);
				
				ArrayOfPropsHistoryLines.Add(DataStructureOfHistoryString);
			
			EndDo;
			  
			ReceivedData.AdditionalProperties.Insert(TSName, ArrayOfPropsHistoryLines);
			
		EndIf;
		
	EndDo;
EndProcedure
