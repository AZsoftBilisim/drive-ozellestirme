Procedure DPR_Document_CustomerInvoice_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	ClearUsageOCR(UsageOCR);
	
	// The sale of goods could have been unloaded from the sale adjustment,
	// let's check the existence of the link.
	If Not GetLinkById(XDTOData, "Document.SaleAdjustment") = Undefined Then
		Return;
	ElsIf XDTOData.Property("OperationKind") And XDTOData.OperationKind.Value = "TransferToCommissionAgent" 	
		And (ExchangeComponents.ConversionParameters_SSLy.OnlyConsignmentSales25 
			Or GetLinkById(XDTOData, "Document.TransferOfGoodsToBailee") <> Undefined) Then
		UsageOCR.Insert("Document_GoodsHandover_SaleOfGoodsAndServices_Receive", True);
	Else
		UsageOCR.Insert("Document_SaleOfGoodsServices_Receipt", True);
