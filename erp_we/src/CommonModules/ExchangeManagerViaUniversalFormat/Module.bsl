Procedure OCR_Document_WorkOutput_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	#Region CompletedWorks
	Obsolete = New Array;
	Obsolete.Add(Enums.TeamWorkOrderKinds.Repair);
	Obsolete.Add(Enums.TeamWorkOrderKinds.OtherActivities);
	Obsolete.Add(Enums.TeamWorkOrderKinds.TeamWithoutOrder21);
	
	If IBData.WorkOrderKind = Enums.TeamWorkOrderKinds.Personal
		Or Not IBData.AutoAllocation And Obsolete.Find(IBData.WorkOrderKind) <> Undefined Then
		//We take a ready-made table of "Types of work", distributed manually
		RequestTypesOfWork = New Query;
		RequestTypesOfWork.Text = 
		"SELECT
		|	ActivityKinds.Employee_ AS Individual,
		|	ActivityKinds.WorkKind AS WorkKind,
		|	SUM(ActivityKinds.AmountDueForPayment) AS Count,
		|	SUM(ActivityKinds.Sum) AS Sum,
		|	ActivityKinds.Rate_ AS Rate_,
		|	ActivityKinds.Ref.Date AS ExecutionDate
		|FROM
		|	Document.WorkOutput.ActivityKinds AS ActivityKinds
		|WHERE
		|	ActivityKinds.Ref = &Ref
		|
		|GROUP BY
		|	ActivityKinds.WorkKind,
		|	ActivityKinds.Rate_,
		|	ActivityKinds.Employee_,
		|	ActivityKinds.Employee,
		|	ActivityKinds.Ref.Date";
		
		RequestTypesOfWork.SetParameter("Ref", IBData.Ref);
		
		TableOfTypesOfWorkOfEmployees = RequestTypesOfWork.Execute().Unload();
		
	Else
		//Distribute
		TableOfTypesOfWorkOfEmployees = New ValueTable;
		TableOfTypesOfWorkOfEmployees.Columns.Add("Individual",	New TypeDescription("CatalogRef.Persons")); 
	      	TableOfTypesOfWorkOfEmployees.Columns.Add("WorkKind",		New TypeDescription("CatalogRef.EmployeeWorkKinds"));
		TableOfTypesOfWorkOfEmployees.Columns.Add("Count",		New TypeDescription("Number"));
		TableOfTypesOfWorkOfEmployees.Columns.Add("Rate_",		New TypeDescription("Number"));
		TableOfTypesOfWorkOfEmployees.Columns.Add("Sum",			New TypeDescription("Number")); 
		TableOfTypesOfWorkOfEmployees.Columns.Add("ExecutionDate",	New TypeDescription("Date"));
		
		RequestTypesOfWork = New Query;
		RequestTypesOfWork.Text = 
		"SELECT
		|	ActivityKinds.WorkKind AS WorkKind,
		|	SUM(ActivityKinds.AmountDueForPayment) AS Count,
		|	SUM(ActivityKinds.Sum) AS Sum,
		|	ActivityKinds.Rate_ AS Rate_
		|FROM
		|	Document.WorkOutput.ActivityKinds AS ActivityKinds
		|WHERE
		|	ActivityKinds.Ref = &Ref
		|
		|GROUP BY
		|	ActivityKinds.WorkKind,
		|	ActivityKinds.Rate_
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Employees.Employee_ AS Employee_,
		|	Employees.Sum AS Sum
		|FROM
		|	Document.WorkOutput.Employees AS Employees
		|WHERE
		|	Employees.Ref = &Ref
		|
		|ORDER BY
		|	Employees.Sum";
		
		RequestTypesOfWork.SetParameter("Ref", IBData.Ref);
		
		Results = RequestTypesOfWork.ExecuteBatch();
	
		ActivityKinds = Results[0].Select();
		Employees = Results[1].Unload();
		
		Coefficients = Employees.UnloadColumn("Sum");
		
		While ActivityKinds.Next() Do
			
			Quantities = Common.DistributeAmountInProportionToCoefficients(ActivityKinds.Count, Coefficients);
			Amounts = Common.DistributeAmountInProportionToCoefficients(ActivityKinds.Sum, Coefficients);
			
			IndexOf = 0;
			For Each String In Employees Do
				
				NewRow = TableOfTypesOfWorkOfEmployees.Add();
				
				//Fill in the values of properties(new line, types of work);
				NewRow.WorkKind = ActivityKinds.WorkKind;
				NewRow.Individual = String.Employee_;
				NewRow.Count = Quantities[IndexOf];
				NewRow.Rate_ = ActivityKinds.Rate_;
				NewRow.Sum = Amounts[IndexOf];
				
				IndexOf = IndexOf + 1;
				
			EndDo;
			
		EndDo;
	EndIf;
	
	XDTOData.Insert("CompletedWorks", TableOfTypesOfWorkOfEmployees);
	
	#EndRegion
EndProcedure


