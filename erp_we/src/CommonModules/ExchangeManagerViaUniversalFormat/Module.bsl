Procedure OCR_Document_WriteOffOfGoodsShortages_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_WriteOffOfShortageOfGoods_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False, False);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	QueryText = 
		"SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.CCDNumber AS CCDNumber,
		|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
		|	CASE
		|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|			THEN ""ReturnContainers""
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
		|	InventoryKinds.RowID AS RowID
		|INTO InventoryKinds
		|FROM
		|	Document.WriteOffOfGoodsShortages.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|
		|INDEX BY
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.Series AS Series,
		|	MAX(Goods.LineNumber) AS LineNumber
		|INTO TableProductsByMaxRow
		|FROM
		|	Document.WriteOffOfGoodsShortages.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref
		|
		|GROUP BY
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.Series
		|
		|INDEX BY
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.Products AS Products,
		|	InventoryKinds.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.RowID AS RowID,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	InventoryKinds.InventoryType AS InventoryType,
		|	ISNULL(RowOrderOfGoodsTable.LineNumber, 0) AS DocumentRowNumber,
		|	InventoryKinds.Count AS Count,
		|	0 AS Sum,
		|	0 AS Price,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries
		|FROM
		|	InventoryKinds AS InventoryKinds
		|		LEFT JOIN TableProductsByMaxRow AS RowOrderOfGoodsTable
		|		ON InventoryKinds.Products = RowOrderOfGoodsTable.Products
		|			AND InventoryKinds.Characteristic = RowOrderOfGoodsTable.Characteristic
		|			AND InventoryKinds.Series = RowOrderOfGoodsTable.Series
		|
		|ORDER BY
		|	ISNULL(RowOrderOfGoodsTable.LineNumber, 0)";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
		
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	
	XDTOData.Insert("Goods", Goods);
EndProcedure


