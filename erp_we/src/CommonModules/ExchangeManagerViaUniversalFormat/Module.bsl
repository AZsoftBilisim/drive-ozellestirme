Procedure OCR_Catalog_GiftCertificateKinds_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If XDTOData.Property("TypeOfValidityPeriod") And XDTOData.Property("NumberOfValidityPeriods") Then
		If XDTOData.TypeOfValidityPeriod = "Day" Then
			If XDTOData.NumberOfValidityPeriods % 10 = 0 Then
			    ReceivedData.ActionPeriod = Enums.Periodicity.TenDays;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods / 10;
			ElsIf XDTOData.NumberOfValidityPeriods % 7 = 0 Then
			    ReceivedData.ActionPeriod = Enums.Periodicity.Week;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods / 7;
			Else
			    ReceivedData.ActionPeriod = Enums.Periodicity.Day;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods;
			EndIf;
		Else // Type of Action period = "Month"
			If XDTOData.NumberOfValidityPeriods % 12 = 0 Then
			    ReceivedData.ActionPeriod = Enums.Periodicity.Year;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods / 12;
			ElsIf XDTOData.NumberOfValidityPeriods % 6 = 0 Then
			    ReceivedData.ActionPeriod = Enums.Periodicity.HalfYear;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods / 6;
			ElsIf XDTOData.NumberOfValidityPeriods % 3 = 0 Then
			    ReceivedData.ActionPeriod = Enums.Periodicity.Quarter;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods / 3;
			Else
			    ReceivedData.ActionPeriod = Enums.Periodicity.Month;
			    ReceivedData.NumberOfValidityPeriods = XDTOData.NumberOfValidityPeriods;
			EndIf;
		EndIf;
	EndIf;
	If XDTOData.Property("Organization") And ValueIsFilled(XDTOData.Organization) Then
	
		ReceivedData.AdditionalProperties.Insert("Organization", XDTOData.Organization);
	
	EndIf;
	
	If XDTOData.Property("AdditionalInfo") And TypeOf(XDTOData.AdditionalInfo) = Type("Structure") Then  
		If XDTOData.AdditionalInfo.Property("GiftCardAccounting25") Then
			GiftCardAccounting25 = XDTOData.AdditionalInfo.GiftCardAccounting25;
			ReceivedData.GiftCardAccounting25 = GiftCardAccounting25;
		EndIf;
	Else ReceivedData.GiftCardAccounting25 = False;
	EndIf;
	
	If XDTOData.Property("CodeTemplates") And XDTOData.CodeTemplates.Count() > 0 Then
		CodeTemplates = New Array;
		ThereIsBarcodeData = False;
		ThereIsMagneticData = False;
		For Each String In XDTOData.CodeTemplates Do
			StructureOfCodes = New Structure("MagneticStripeCardTemplate, StartOfBarcodeRange, StartOfMagneticCodeRange, EndOfBarcodeRange, EndOfMagneticCodeRange, BarcodeLength, MagneticCodeLength");
			If ValueIsFilled(String.MagneticStripeCardTemplate) Then
				StructureOfCodes.MagneticStripeCardTemplate = MagneticStripeCardTemplate(ValueFromStringInternal(String.MagneticStripeCardTemplate), ExchangeComponents.DataImportToInfobaseMode);
			EndIf;
			If String.StartOfBarcodeRange = 0 Then
				StructureOfCodes.StartOfBarcodeRange = "0";
			Else
				StructureOfCodes.StartOfBarcodeRange = StrReplace(String.StartOfBarcodeRange, " ", "");
			EndIf;
			If String.StartOfMagneticCodeRange = 0 Then
				StructureOfCodes.StartOfMagneticCodeRange = "0";
			Else
				StructureOfCodes.StartOfMagneticCodeRange = StrReplace(String.StartOfMagneticCodeRange, " ", "");
			EndIf;
			StructureOfCodes.EndOfMagneticCodeRange = StrReplace(String.EndOfMagneticCodeRange, " ", "");
			StructureOfCodes.EndOfBarcodeRange      = StrReplace(String.EndOfBarcodeRange, " ", "");
			StructureOfCodes.BarcodeLength               = String.BarcodeLength;
			StructureOfCodes.MagneticCodeLength          = String.MagneticCodeLength;
			
			ThereIsBarcodeData = ThereIsBarcodeData Or ValueIsFilled(StructureOfCodes.BarcodeLength);
			ThereIsMagneticData = ThereIsMagneticData Or ValueIsFilled(StructureOfCodes.MagneticCodeLength);
			
			CodeTemplates.Add(StructureOfCodes);
		EndDo;
		If ThereIsBarcodeData And ThereIsMagneticData Then
			ReceivedData.CardType = Enums.CardTypes.Mixed;
		ElsIf ThereIsMagneticData Then
			ReceivedData.CardType = Enums.CardTypes.Magnetic;
		Else
			ReceivedData.CardType = Enums.CardTypes.Barcode_;
		EndIf;
		ReceivedData.AdditionalProperties.Insert("GiftCertificateCodeTemplates", CodeTemplates);
	Else 
		CodeTemplates = New Array;
		StructureOfCodes = New Structure("MagneticStripeCardTemplate, StartOfBarcodeRange, StartOfMagneticCodeRange, EndOfBarcodeRange, EndOfMagneticCodeRange, BarcodeLength, MagneticCodeLength");
		StructureOfCodes.BarcodeLength          = "2";
		StructureOfCodes.StartOfBarcodeRange = "90";
		StructureOfCodes.EndOfBarcodeRange      = "99"; 
		StructureOfCodes.MagneticCodeLength          = "0";	
		StructureOfCodes.EndOfMagneticCodeRange = "0";
		StructureOfCodes.StartOfMagneticCodeRange = "0";
		CodeTemplates.Add(StructureOfCodes); 
		ReceivedData.Description = NStr("vi = 'Đã kết nhập từ Bán lẻ';
										|ru = 'Загружено из Розницы';
										|en = 'Imported from Retail'; fa = 'Imported from Retail';
										|it = 'Загружено из Розницы';
										|pl = 'Imported from Retail';
										|tr = 'Perakendeden yüklendi'", Common.DefaultLanguageCode());
		ReceivedData.CardType = Enums.CardTypes.Barcode_;
		ReceivedData.ActionPeriod = Enums.Periodicity.Year; 
		ReceivedData.NumberOfValidityPeriods = 1;
		ReceivedData.AdditionalProperties.Insert("GiftCertificateCodeTemplates", CodeTemplates);
	EndIf;
EndProcedure
Procedure OCR_Catalog_GiftCertificateKinds_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
									ReceivedData.AdditionalProperties, ExchangeComponents);
	
	// If there is an object in the database, it will be recorded (and not the received data).
	// The header and tabular part are preliminarily transferred from the received data to the given data:
	// the header is part of the properties from the PKS, the tabular part is completely taken from the received data.
	If IBData <> Undefined Then
		// We transfer those properties that are specified in the PKS.
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		// Table parts
		IBData.GiftCertificateCodeTemplates.Load(ReceivedData.GiftCertificateCodeTemplates.Unload());
	
