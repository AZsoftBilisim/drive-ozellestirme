Procedure OCR_Document_BackflushProduction_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");
	FillingRules.Insert("Sum",        "CostShare");
	If FOValue("UseItemVariants", ExchangeComponents) Then
	FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
	FillingRules.Insert("Package",           "Package");
	FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
	FillingRules.Insert("Series",              "Series");
	EndIf;
	
	// Upon release to the division, the recipient will be the storeroom of the workshop.
	Recipient = Undefined;
	If XDTOData.OperationKind.Value = "ProductsReleaseToBusinessUnit" Then
	
	If XDTOData.Property("CostDivision") And ValueIsFilled(XDTOData.CostDivision) Then
		CostDivision = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
			ExchangeComponents,
			XDTOData.CostDivision,
			DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Departments_Receive"), 
			"GetRef").Ref;
	Else
		CostDivision = DefaultElement(ExchangeComponents, "Department");
	EndIf;
	
	// Let's check the details of the division.
	AttributesValues = New Structure("ProductionBusinessUnit, BackflushProduction_", True, True);
	CheckUpdateItemDetails(CostDivision, AttributesValues, ExchangeComponents);
	
	// We will get the default pantry.
	AddlParameters = New Structure;
	AddlParameters.Insert("Department", CostDivision);
	Recipient = DefaultElement(ExchangeComponents, "WorkshopPantry", AddlParameters);
	
	ElsIf XDTOData.Property("Warehouse") And ValueIsFilled(XDTOData.Warehouse) Then
	Recipient = XDTOData.Warehouse;		
	EndIf;
	
	#Region ManufacturedProducts
	
	If XDTOData.Property("ManufacturedProduct") And ValueIsFilled(XDTOData.ManufacturedProduct) Then
	
	ArrayOfRowsOutputProducts = New Array;
	For Each String In XDTOData.ManufacturedProduct Do
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		If ValueIsFilled(Recipient) Then
			StringDataStructure.Insert("Recipient", Recipient);
		EndIf;
		
		StringDataStructure.Insert("DirectionOfProductionIssue", Enums.BusinessTransactions.ProductsReleaseToWarehouse);
		
		If Not StringDataStructure.Property("NumberOfPackages") Then
		 	StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf; 
	
		ArrayOfRowsOutputProducts.Add(StringDataStructure);
	EndDo;
	
	If ArrayOfRowsOutputProducts.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("ManufacturedProducts", ArrayOfRowsOutputProducts);
	EndIf;
	
	EndIf;
	
	#EndRegion
	
	#Region RecyclableWaste
	
	If XDTOData.Property("RecyclableWaste") And ValueIsFilled(XDTOData.RecyclableWaste) Then
	
	ArrayOfRowsReturnableWaste = New Array;
	FillingRules.Insert("Sum", "Sum");
		
	For Each String In XDTOData.RecyclableWaste Do
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		If ValueIsFilled(Recipient) Then
			StringDataStructure.Insert("Recipient", Recipient);
		EndIf;
		
		StringDataStructure.Insert("DirectionOfProductionIssue", Enums.BusinessTransactions.ProductsReleaseToWarehouse);
		
		If Not StringDataStructure.Property("NumberOfPackages") Then
		 	StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf;
		If StringDataStructure.Property("Sum") Then
			StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
		EndIf;
	
		ArrayOfRowsReturnableWaste.Add(StringDataStructure);
	EndDo;
	
	If ArrayOfRowsReturnableWaste.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("SideAndIntermediateRelease", ArrayOfRowsReturnableWaste);
	EndIf;
	
	EndIf;
	
	#EndRegion
	
	#Region MaterialsAndWorks
	
	ArrayOfWorkMaterialsRows = New Array;
	
	If XDTOData.Property("UsedMaterials") And ValueIsFilled(XDTOData.UsedMaterials) Then
	
	FillingRules.Insert("CostDivision", "Department");
		
	For Each String In XDTOData.UsedMaterials Do
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		If XDTOData.Property("Warehouse") Then
			StringDataStructure.Insert("Warehouse", XDTOData.Warehouse);
		EndIf;
		
		If Not StringDataStructure.Property("NumberOfPackages") Then
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf;
	        StringDataStructure.Insert("CostGroupNumber", 1);
		ArrayOfWorkMaterialsRows.Add(StringDataStructure);
	EndDo;
	
	EndIf;
	
	If XDTOData.Property("Works") And ValueIsFilled(XDTOData.Works) Then
	
	FillingRules.Insert("CostDivision", "Department");
		
	For Each String In XDTOData.Works Do
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		StringDataStructure.Insert("CostGroupNumber", 1);
		ArrayOfWorkMaterialsRows.Add(StringDataStructure);
	EndDo;
	
	EndIf;
	
	If ArrayOfWorkMaterialsRows.Count() > 0 Then
	ReceivedData.AdditionalProperties.Insert("MaterialsAndWorks", ArrayOfWorkMaterialsRows);
	EndIf;
	
	#EndRegion
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
EndProcedure
Procedure OCR_Document_BackflushProduction_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
	ReceivedData.AdditionalProperties, ExchangeComponents);
	
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
	
	If Not IBData = Undefined Then
		// We transfer those properties that are specified in the PKS
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
		
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("Recipient");
		KeyFieldsArray.Add("DirectionOfProductionIssue");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
		ReceivedData.ManufacturedProducts,
		IBData.ManufacturedProducts,
		KeyFieldsArray,
		Undefined,
		"Count, Package, NumberOfPackages");  
		IBData.ManufacturedProducts.Load(ReceivedData.ManufacturedProducts.Unload());
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
		ReceivedData.SideAndIntermediateRelease,
		IBData.SideAndIntermediateRelease,
		KeyFieldsArray,
		Undefined,
		"Count, Package, NumberOfPackages, Price, Sum");  
		IBData.SideAndIntermediateRelease.Load(ReceivedData.SideAndIntermediateRelease.Unload());
		
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("Warehouse");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
		ReceivedData.MaterialsAndWorks,
		IBData.MaterialsAndWorks,
		KeyFieldsArray,
		Undefined,
		"Count, Package, NumberOfPackages, Department");  
		IBData.MaterialsAndWorks.Load(ReceivedData.MaterialsAndWorks.Unload());
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7") Then	
			// We will transfer the works from the data, because the format object does not support their transmission.
			Query = New Query;
			Query.SetParameter("Ref", IBData.Ref);
			Query.Text = 
			"SELECT
			|	*
			|FROM
			|	Document.BackflushProduction.MaterialsAndWorks AS BackflushProductionMaterialsAndWorks
			|WHERE
			|	BackflushProductionMaterialsAndWorks.Ref = &Ref
			|	AND BackflushProductionMaterialsAndWorks.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)";
			
			Selection = Query.Execute().Select();
			While Selection.Next() Do
				TSRow = IBData.MaterialsAndWorks.Add();
				FillPropertyValues(TSRow, Selection);
			EndDo;
		EndIf;	
		
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If Not ValueIsFilled(DataToWriteToIB.GroupCosts) Then
		If DataToWriteToIB.MaterialsAndWorks.Count() = 0
			And DataToWriteToIB.SideAndIntermediateRelease.Count() = 0
			And DataToWriteToIB.LaborCosts.Count() = 0 Then
			DataToWriteToIB.GroupCosts = Enums.GroupingsOfCostsInBackflushProduction.CostsAreNotSpecified;
		Else
			DataToWriteToIB.GroupCosts = Enums.GroupingsOfCostsInBackflushProduction.ByDocument;
		EndIf;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.MethodOfAllocatingFinishedProductCosts) Then
		// The exchange file contains summary estimates of products, we will use them as a share.
		If DataToWriteToIB.ManufacturedProducts.Total("CostShare") > 0 Then
			DataToWriteToIB.MethodOfAllocatingFinishedProductCosts = Enums.MethodsOfCostAllocatingOnProductCosts.ByCostShares;
		Else
			DataToWriteToIB.MethodOfAllocatingFinishedProductCosts = Enums.MethodsOfCostAllocatingOnProductCosts.ByTargetCost;
		EndIf;
	EndIf;   
	DataToWriteToIB.PackagingUnitsInInventoryOwnerAttributes = True;
EndProcedure

