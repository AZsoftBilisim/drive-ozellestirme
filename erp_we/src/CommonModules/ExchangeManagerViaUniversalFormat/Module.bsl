Procedure PCO_Doc_OtherRegistration_Output_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	DocNumber = Left(IBData.Number, 5) + "PD" + Mid(IBData.Number, 8);
	XDTOData.KeyProperties.Insert("Number", DocNumber);
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Doc_OtherRegistration_ProductsRelease_Send", 
										"ManufacturedProduct", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	
	XDTOData.Insert("OperationKind", "ProductsReleaseToWarehouse");
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	If IBData.Goods.Count() > 0 Then
		CostInvoiceAsLine = Common.ObjectAttributeValue(IBData.Goods[0].ExpenseAndIncomeItem, "OffsettingAccount");
		XDTOData.Insert("CostAccount", CostInvoiceAsLine);
	EndIf;
	XDTOData.Insert("Currency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	QueryText =
		"SELECT
		|	ManufacturedProduct.Products AS Products,
		|	ManufacturedProduct.Products.UnitOfMeasure AS UnitOfMeasure,
		|	ManufacturedProduct.Count AS Count,
		|	CAST(ManufacturedProduct.Price * CASE
		|			WHEN &RegCurrency <> &ManCurrency
		|				THEN CASE
		|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
		|								AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
		|							THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|						ELSE 0
		|					END
		|			ELSE 1
		|		END AS NUMBER(10, 2)) AS Price,
		|	CAST(ManufacturedProduct.Sum * CASE
		|			WHEN &RegCurrency <> &ManCurrency
		|				THEN CASE
		|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
		|								AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
		|							THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|						ELSE 0
		|					END
		|			ELSE 1
		|		END AS NUMBER(10, 2)) AS Sum,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest
		|FROM
		|	Document.OtherGoodsRecordingAsReceived.Goods AS ManufacturedProduct
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &ManCurrency AND BaseCurrency = &RegCurrency) AS CurrencyRatesPrices
		|		ON (TRUE)
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &RegCurrency AND BaseCurrency = &RegCurrency) AS Currency_Rates
		|		ON (TRUE)
		|WHERE
		|	ManufacturedProduct.Ref = &Ref";
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
