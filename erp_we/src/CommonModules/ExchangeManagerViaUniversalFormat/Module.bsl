Procedure PCO_Document_InputOfBalancesOnFinancialInstruments_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Query = New Query("SELECT
		|	EnteringBalancesSettlementsOnFinancialInstruments.Counterparty AS Counterparty,
		|	EnteringBalancesSettlementsOnFinancialInstruments.Contract AS Contract,
		|	CASE
		|		WHEN EnteringBalancesSettlementsOnFinancialInstruments.AmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.PrincipalDebt)
		|			THEN CASE
		|					WHEN EnteringBalancesSettlementsOnFinancialInstruments.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|						THEN CASE
		|								WHEN EnteringBalancesSettlementsOnFinancialInstruments.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|									THEN ""LongTermLoans_""
		|								ELSE ""LongTermLoans""
		|							END
		|					ELSE CASE
		|							WHEN EnteringBalancesSettlementsOnFinancialInstruments.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|								THEN ""ShortTermLoans_""
		|							ELSE ""ShortTermLoans""
		|						END
		|				END
		|		WHEN EnteringBalancesSettlementsOnFinancialInstruments.AmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Interests)
		|			THEN CASE
		|					WHEN EnteringBalancesSettlementsOnFinancialInstruments.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|						THEN CASE
		|								WHEN EnteringBalancesSettlementsOnFinancialInstruments.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|									THEN ""InterestOnLongTermLoans""
		|								ELSE ""InterestOnLongTermLoans_""
		|							END
		|					ELSE CASE
		|							WHEN EnteringBalancesSettlementsOnFinancialInstruments.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|								THEN ""InterestOnShortTermLoans""
		|							ELSE ""InterestOnShortTermLoans_""
		|						END
		|				END
		|		ELSE ""Fee""
		|	END AS ARAPType,
		|	EnteringBalancesSettlementsOnFinancialInstruments.Sum AS Sum,
		|	EnteringBalancesSettlementsOnFinancialInstruments.Contract.ARAPCurrency AS ARAPCurrency
		|FROM
		|	Document.OBEntryFinancialInstruments.FinancialInstrumentsARAP AS EnteringBalancesSettlementsOnFinancialInstruments
		|WHERE
		|	EnteringBalancesSettlementsOnFinancialInstruments.Ref = &Ref");
	
	Query.SetParameter("Ref", IBData.Ref);
	TableCalculations = Query.Execute().Unload();
	
	XDTOData.Insert("Calculations", TableCalculations);
EndProcedure

