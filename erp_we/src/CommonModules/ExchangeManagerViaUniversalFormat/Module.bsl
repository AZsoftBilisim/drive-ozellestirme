Function PrincipalByValue(Val Principal)
	If Not ValueIsFilled(Principal) Then
		
		Return Undefined;
		
	EndIf;
	
	If TypeOf(Principal) = Type("CatalogRef.Companies") Then
		
		PrincipalStructure = New Structure;
		PrincipalStructure.Insert("Value", Principal);
		PrincipalStructure.Insert("OCRName", "Catalog_Companies_Send"); 
		
		Return PrincipalStructure;
		
	ElsIf TypeOf(Principal) = Type("CatalogRef.Partners") Then
		
		CounterpartyByPartner = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(Principal);
