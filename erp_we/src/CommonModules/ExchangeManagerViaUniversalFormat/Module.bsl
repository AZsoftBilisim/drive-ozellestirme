Procedure TransferSeriesWHSeries(Object, SeriesSpecificationParameters, ExchangeComponents)
	If SeriesSpecificationParameters.TSSeriesName = SeriesSpecificationParameters.NameTSGoods Then
		Return;	
	EndIf;
	
	Object[SeriesSpecificationParameters.TSSeriesName].Clear();
	
	If SeriesSpecificationParameters.ProductInHeader Then
		If ValueIsFilled(Object.Series)
			And ProductsClientServer.ThisSeriesStatusIndicatesWHSeries(Object.BatchesIndicationStatus, SeriesSpecificationParameters) Then
			
			RowSeries = Object[SeriesSpecificationParameters.TSSeriesName].Add();
			FillPropertyValues(RowSeries, Object);
		EndIf;
	Else
		For Each TSRow In Object[SeriesSpecificationParameters.NameTSGoods] Do
			If ValueIsFilled(TSRow.Series)
				And ProductsClientServer.ThisSeriesStatusIndicatesWHSeries(TSRow.BatchesIndicationStatus, SeriesSpecificationParameters) Then
				
				RowSeries = Object[SeriesSpecificationParameters.TSSeriesName].Add();
				FillPropertyValues(RowSeries, TSRow);
			EndIf;
		EndDo;
	EndIf;
EndProcedure
Procedure RedefineCounterpartySearchFields(ExchangeComponents, XDTOData)
	//  If the counterparty is an individual entrepreneur or an individual. If you are a legal entity, then you need to redefine the search fields,
	//	since two counterparties with the same key fields can be recorded in the application: TIN + Name, but with a different type of legal entity
	
	CounterpartyConversionRules = ExchangeComponents.ObjectsConversionRules.Find("Catalog_Counterparties_Receive", "OCRName");
	If CounterpartyConversionRules = Undefined Then
		Return;
	EndIf;
	
	KeyProperties = Undefined;
	If Not XDTOData.Property("KeyProperties", KeyProperties) Then
		KeyProperties = XDTOData;
	EndIf;
	
	If Not (KeyProperties.Property("CompanyIndividual") And 
		KeyProperties.CompanyIndividual.Value = "Individual") Then
		
		Return;
		
	EndIf;
	
	SearchFields = CounterpartyConversionRules.SearchFields;
	SearchFields.Clear();
	
	INNFilledIn = KeyProperties.Property("TIN") And ValueIsFilled(KeyProperties.TIN);
	
	If INNFilledIn Then
		SearchFields.Add("TIN, LegalEntityIndividual");
	Else
		SearchFields.Add("DescriptionFull,LegalEntityIndividual");
		SearchFields.Add("Description,LegalEntityIndividual");
	EndIf;
EndProcedure
Procedure RedefineVATRateForOldFormats(DataTable, VATAtRates2And4)
	If DataTable = Undefined Or DataTable.Count() = 0 
		Or DataTable.Columns.Find("VATRate") = Undefined 
		And DataTable.Columns.Find("RetailNDSRate") = Undefined Then
		Return
	EndIf; 
	
	DescriptionOfVATColumnType = New TypeDescription("String");
	
	DataTable.Columns.Add("VATRateByLine", DescriptionOfVATColumnType); 
	
	If DataTable.Columns.Find("VATRateBeforeChange") <> Undefined Then   
		DataTable.Columns.Add("VATRateBeforeChangeString", DescriptionOfVATColumnType); 
	EndIf;
	If DataTable.Columns.Find("RetailNDSRate") <> Undefined Then    
		DataTable.Columns.Add("RetailTaxRateByString", DescriptionOfVATColumnType); 
	EndIf;
	For Each Page1 In DataTable Do 
		If ValueIsFilled(Page1.VATRate) And TypeOf(Page1.VATRate) = Type("CatalogRef.VATRates") Then  
			Page1.VATRateByLine = VATRateToXDTOString(Page1.VATRate, VATAtRates2And4);
		EndIf;  
		If DataTable.Columns.Find("VATRateBeforeChange") <> Undefined And ValueIsFilled(Page1.VATRateBeforeChange) 
			And TypeOf(Page1.VATRateBeforeChange) = Type("CatalogRef.VATRates") Then
			Page1.VATRateBeforeChangeString = VATRateToXDTOString(Page1.VATRateBeforeChange, VATAtRates2And4);
		EndIf;
		If DataTable.Columns.Find("RetailNDSRate") <> Undefined And ValueIsFilled(Page1.RetailNDSRate)
			And TypeOf(Page1.RetailNDSRate) = Type("CatalogRef.VATRates")Then
			Page1.RetailTaxRateByString = VATRateToXDTOString(Page1.RetailNDSRate, VATAtRates2And4);
		EndIf;
	EndDo; 
	DataTable.Columns.Delete("VATRate");
	DataTable.Columns.VATRateByLine.Name = "VATRate";
	If DataTable.Columns.Find("VATRateBeforeChange") <> Undefined Then
		DataTable.Columns.Delete("VATRateBeforeChange");
		DataTable.Columns.VATRateBeforeChangeString.Name = "VATRateBeforeChange";
	EndIf;
	If DataTable.Columns.Find("RetailNDSRate") <> Undefined Then
		DataTable.Columns.Delete("RetailNDSRate");
		DataTable.Columns.RetailTaxRateByString.Name = "RetailNDSRate";
	EndIf;
EndProcedure
Function RecalculationOfAmountInLocalAndMan(ExchangeComponents, Organization, Currency, RecountDate, Sum)
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(Organization);
	CurrencyOfManAccounting  = ManagementAccountingCurrency(ExchangeComponents);
	
	AmountsInLocalAndManCurrencies = New Structure("SumMan, SumCompl");
	
	If Currency = CurrencyOfComplianceAccounting Then
		AmountsInLocalAndManCurrencies.SumCompl = Sum;
	Else
		ConversionFactor_ = ProcessingOfExchangeRatesTM.GetConversionFactorFromCurrencyToCurrency(Currency, CurrencyOfComplianceAccounting, RecountDate);
		AmountsInLocalAndManCurrencies.SumCompl = Round(Sum * ConversionFactor_, 2, 1);
	EndIf;
	
	If Currency = CurrencyOfManAccounting Then
		AmountsInLocalAndManCurrencies.SumMan = Sum;
	Else
		ConversionFactor_ = ProcessingOfExchangeRatesTM.GetConversionFactorFromCurrencyToCurrency(Currency, CurrencyOfManAccounting, RecountDate);
		AmountsInLocalAndManCurrencies.SumMan = Round(Sum * ConversionFactor_, 2, 1);
	EndIf;
	
	Return AmountsInLocalAndManCurrencies;
EndFunction


