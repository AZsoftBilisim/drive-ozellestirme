Procedure OCR_Document_SBDsSettlementsWithCounterparties_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	ARAPType = "WithVendor";
	If XDTOData.Property("ARAPType") Then
		ARAPType = XDTOData.ARAPType.Value;
	EndIf;
	
	If ARAPType = "WithVendor" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.PaymentToVendor;
	ElsIf ARAPType = "WithCustomer" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer;
	Else
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue;
	EndIf;
	// Other values; payments to loans, payouts to deposits, payouts to loans issued - by PM decryption of the payment.
	If XDTOData.ARAPDetails.Count() = 1 Then
		TypeOfCalculationsAdvanced = XDTOData.ARAPDetails[0].TypeOfCalculationsAdvanced;
		If Find(Lower(TypeOfCalculationsAdvanced), "loan") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToCounterparty;
		EndIf;
		If Find(Lower(TypeOfCalculationsAdvanced), "credit") > 0 Then
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.PaymentOnLoansAndBorrowingsReceived;
		EndIf;
	EndIf;
	
	// CashFlowItem
	CFItem = XDTOData.ARAPDetails[0].CFItem;
	If ValueIsFilled(CFItem)
		And (ReceivedData.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue
		Or XDTOData.ARAPDetails.Count() = 1) Then
		
		ReceivedData.AdditionalProperties.Insert("CashFlowItem", CFItem);
	EndIf;
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	// Breakdown of payment
	FillInContract = (ARAPType = "WithCustomer" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed)
					Or (ARAPType = "WithVendor" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed);
	
	ArrayOfPaymentDecryptionStrings = New Array;
	FillingRules = New Map;
	FillingRules.Insert("Sum", "Sum");
	FillingRules.Insert("AmountARAP", "AmountARAP");
	FillingRules.Insert("CashFlowItem", "CFItem");
	FillingRules.Insert("VATRate", "VATRate");
	FillingRules.Insert("VATAmount", "VATAmount");
	FillingRules.Insert("ExchangeRateNumeratorOfMutualSettlements", "TransactionRate");
	FillingRules.Insert("TheExchangeRateIsTheDenominatorOfMutualSettlements", "Multiplier_");
	
	AvailableSettlementColumns = AvailableColumnsForFillingInSettlementData(XDTOData.ARAPDetails, FillInContract);
	
	For Each XDTORow In XDTOData.ARAPDetails Do
		StringDataStructure = New Structure;
		FillInRowDataStructure(FillingRules, XDTORow, StringDataStructure);
		
		If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
		    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
		EndIf;
	
		AddCurrencyToPaymentDecryption(StringDataStructure, XDTORow);
		
		AddSettlementDataToPaymentTranscript(ExchangeComponents, XDTORow, StringDataStructure, AvailableSettlementColumns);
		
		If Not XDTOData.ARAPDetails.Columns.Find("RowID") = Undefined Then
			StringDataStructure.Insert("RowID", XDTORow.RowID);
		EndIf;	 
	
		ArrayOfPaymentDecryptionStrings.Add(StringDataStructure);
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfPaymentDecryptionStrings);
	
	//++ NOT TM
	
	
	//-- DON'T TM
EndProcedure
Procedure OCR_Document_SBDsSettlementsWithCounterparties_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	If IBData <> Undefined Then
		If IBData.BusinessOperation = Enums.BusinessTransactions.DeletePaymentToSelfEmployedPerson Then
			ReceivedData.BusinessOperation = IBData.BusinessOperation;
		EndIf; 
	EndIf;
	ConvertNumberToFormat12(ReceivedData, IBData);
	
	BeforeMerzhevanii_SBDS(ReceivedData, IBData, ExchangeComponents);
	Merzhevanie_SBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents);
	AfterMerzhevaniya_SBDS(ReceivedData, IBData, ExchangeComponents);
	
	FillInAdditionalInformationSecurityDataPropertiesFromReceivedData(IBData, ReceivedData);
	If ValueIsFilled(ReceivedData.Contract) And IBData <> Undefined 
		And Not ValueIsFilled(IBData.Contract) Then
	     IBData.Contract = ReceivedData.Contract;
	EndIf;
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
EndProcedure


