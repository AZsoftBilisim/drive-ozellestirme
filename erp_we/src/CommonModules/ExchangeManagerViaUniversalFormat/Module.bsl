Procedure PCO_Document_SBDSOtherWriteOff_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	ConvertNumberToFormat11(ExchangeComponents, IBData, XDTOData);
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	IBDivision = IBData["Department"];
	If ValueIsFilled(IBDivision) Then
		UnloadDivision(IBData, XDTOData, IBDivision, "Department");
	Else
		UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	EndIf;
	
	FillInDataOfIncomingSBDsDocument(IBData, XDTOData);
	HeaderData_ = IBData.AdditionalProperties.HeaderData_;
	XDTOData.Insert("OperationKind", HeaderData_.TypeOfOperationOther);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7")
		And ValueIsFilled(IBData.PaymentRequest) Then
		XDTOData.Insert("RequestForSpendingFunds", IBData.PaymentRequest);
	EndIf;
	
	TabDecryption = New ValueTable;
	TabDecryption.Columns.Add("CFItem");
	TabDecryption.Columns.Add("Sum");
	TabDecryption.Columns.Add("Account_Settlement");
	
	SettlementAccount_ = "";
	
	Instruction = Undefined;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
		Instruction = New Structure("Value, OCRName", IBData.BankAccountBeneficiary, "Catalog_CompaniesBankAccounts_Send");
	Else
		Instruction = New Structure("Value, OCRName", IBData.CounterpartyBankAccount, "Catalog_CounterpartyBankAccounts_Send");
	EndIf;
	
	XDTOData.Insert("BankAccount", Instruction);
	
	If IBData.ARAPDetails.Count() > 0 Then
		For Each String In IBData.ARAPDetails Do
			
			NewRow = TabDecryption.Add();
			If IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
				NewRow.CFItem = IBData.CashFlowItem;
			Else
				NewRow.CFItem = String.CashFlowItem;
			EndIf;
			NewRow.Sum = String.Sum;
			// A document is uploaded with the operation "Other Monetary funds",
			// in which only the articles of assets / liabilities are indicated.
			If ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed Then
				NewRow.Account_Settlement = AccountForSettlementsOfOtherDDSOperations(New Structure("CFItem", String.CashFlowItem));
			EndIf;
			If ValueIsFilled(SettlementAccount_) And Not ValueIsFilled(NewRow.Account_Settlement) Then
				NewRow.Account_Settlement = SettlementAccount_;
			EndIf;
	
		EndDo;
	Else
	
		NewRow = TabDecryption.Add();
		NewRow.CFItem         = IBData.CashFlowItem;
		NewRow.Sum             = IBData.DocumentAmount;
		If ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed Then
			NewRow.Account_Settlement = AccountForSettlementsOfOtherDDSOperations(New Structure("CFItem", IBData.CashFlowItem));
		ElsIf ValueIsFilled(SettlementAccount_) Then
			NewRow.Account_Settlement = SettlementAccount_;
		EndIf;
	EndIf;
	
	XDTOData.Insert("ARAPDetails", TabDecryption);
	
	If ValueIsFilled(IBData.IncomeKindCode) Then
		XDTOData.Insert("IncomeKindCode", IBData.IncomeKindCode);
	EndIf;
EndProcedure

