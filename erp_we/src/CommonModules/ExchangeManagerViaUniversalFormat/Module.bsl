Procedure AssignBankAccountName(ReceivedData, IBData)
	If IBData = Undefined Or Not ValueIsFilled(IBData.Description) Then
		AccountNumber = Right(TrimAll(ReceivedData.AccountNumber), 4);
		If  ValueIsFilled(ReceivedData.Bank) Then
			NameString_ = StringFunctionsClientServer.SubstituteParametersToString(
						NStr("vi = '%1 trong %2 (%3).';
							|ru = '%1 в %2 (%3).';
							|en = '%1 in %2 (%3).'; fa = '%1 in %2 (%3).';
							|it = '%1 in %2 (%3).';
							|pl = '%1 w %2 (%3).';
							|tr = '%2''de %1 (%3).'"), AccountNumber, ReceivedData.Bank,
						String(ReceivedData.CashCurrency)); 
		Else
			NameString_ = AccountNumber + "(" + String(ReceivedData.CashCurrency) + ")"; 
		EndIf;
		NameString_ = Left(NameString_, 150);
	
		ReceivedData.Description = NameString_;
