Procedure OCR_Document_GoodsReceiptForStorage_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_AcceptanceOfGoodsForStorage_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData, "Counterparty, Organization");
		DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithCustomer";
		XDTOData.Insert("Contract", ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents));
	EndIf;
	
	QueryText = 
		"SELECT
		|	DocumentHeaderData.Currency AS Currency
		|INTO DocumentHeaderData
		|FROM
		|	Document.GoodsReceiptForStorage AS DocumentHeaderData
		|WHERE
		|	DocumentHeaderData.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
		|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
		|FROM
		|	DocumentHeaderData AS DocumentHeaderData
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
		|				&Date,
		|				Currency IN
		|						(SELECT
		|							Doc.Currency
		|						FROM
		|							DocumentHeaderData AS Doc)
		|					AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
		|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.Products AS Products,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	&TextOfCCDRequest,
		|	Goods.Count AS Count,
		|	CAST(Goods.Price AS NUMBER(31, 2)) AS Price,
		|	CAST(Goods.Sum AS NUMBER(31, 2)) AS Sum,
		|	CASE
		|		WHEN Goods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		WHEN Goods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
		|			THEN ""GiverRawMaterialsAndSupplies""
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType
		|FROM
		|	Document.GoodsReceiptForStorage.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "Goods"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	QueryResults = Query.ExecuteBatch();
	OperationData = QueryResults[1].Select();
	If OperationData.Next() Then
		XDTOData.Insert("TransactionRate", OperationData.TransactionRate);
		XDTOData.Insert("Multiplier_", OperationData.Multiplier_);
	EndIf;
	Goods = QueryResults[2].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	XDTOData.Insert("Sum", Goods.Total("Sum"));
	
	VATActivityType = PredefinedValue("Enum.VATTaxationTypes.SaleIsNotSubjectToVAT");
	ColumnName = "IncomeForActivities";
	Goods.Columns.Add(ColumnName);
	Goods.FillValues(VATActivityType, ColumnName);
	
	XDTOData.Insert("Goods", Goods);
EndProcedure

