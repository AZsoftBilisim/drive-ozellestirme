Procedure DPR_Document_GoodsShipmentFromStorage_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
		
	QueryText = 
		"SELECT
		|	DocumentHeaderData.Currency AS Currency
		|INTO DocumentHeaderData
		|FROM
		|	Document.GoodsShipmentFromStorage AS DocumentHeaderData
		|WHERE
		|	DocumentHeaderData.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
		|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
		|FROM
		|	DocumentHeaderData AS DocumentHeaderData
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
		|				&Date,
		|				Currency IN
		|						(SELECT
		|							Doc.Currency
		|						FROM
		|							DocumentHeaderData AS Doc)
		|					AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
		|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.Count AS Count,
		|	CASE
		|		WHEN InventoryKinds.Sum = 0
		|			THEN 0.01
		|		ELSE CAST(InventoryKinds.Sum / InventoryKinds.NumberOfPackages AS NUMBER(31, 2))
		|	END AS PricePerPackaging,
		|	CASE
		|		WHEN InventoryKinds.Sum = 0
		|			THEN CAST(0.01 * InventoryKinds.Count AS NUMBER(15, 2))
		|		ELSE InventoryKinds.Sum
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN ""CommissionGoods""
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
		|			THEN ""GiverRawMaterialsAndSupplies""
		|		ELSE &OwnProducts
		|	END AS InventoryType,
		|	CAST(InventoryKinds.Sum / InventoryKinds.Count AS NUMBER(31, 2)) AS Price
		|FROM
		|	Document.GoodsShipmentFromStorage.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	QueryResults = Query.ExecuteBatch();
	OperationData = QueryResults[1].Select();
		
	Goods = QueryResults[2].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	If Not Goods = Undefined And Goods.Count() > 0 Then
	    IBData.AdditionalProperties.Insert("Goods", Goods); 
	EndIf;  
	
	If OperationData.Next() Then   
		TSOperationData = New Structure;
		TSOperationData.Insert("TransactionRate", OperationData.TransactionRate);
		TSOperationData.Insert("Multiplier_", OperationData.Multiplier_);
	EndIf;
	IBData.AdditionalProperties.Insert("OperationData", TSOperationData);
	If IBData.BusinessOperation = Enums.BusinessTransactions.ReturnToMaterialProvider2_5
		Or (IBData.BusinessOperation = Enums.BusinessTransactions.ShipGoodsReceivedFromStorageWithRightOfSale And Goods.Count() > 0) Then
		UsageOCR.Document_GoodsShipmentFromStorage_Return_Send = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5 Then
		UsageOCR.Doc_GoodsShipmentFromStorage_Transfer__Send = True;
	EndIf;
EndProcedure


