Procedure OCR_Catalog_Companies_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData <> Undefined Then
	
		If ReceivedData.AdditionalProperties.Property("RNCPS") Then
			IBData.AdditionalProperties.Insert("RNCPS", ReceivedData.AdditionalProperties.RNCPS);
		EndIf;
		ReceivedData.BranchOffice =  IBData.BranchOffice;
		ReceivedData.ParentCompany =  IBData.ParentCompany;
		If Not ValueIsFilled(ReceivedData.AbbreviatedDescription) Then
			ReceivedData.AbbreviatedDescription = IBData.AbbreviatedDescription;
		EndIf;
		If Not ValueIsFilled(ReceivedData.BusinessActivityClassifierCode) Then
			ReceivedData.BusinessActivityClassifierCode = IBData.BusinessActivityClassifierCode;
		EndIf;  
		If Not ValueIsFilled(ReceivedData.BusinessActivityClassifierCode2) Then
			ReceivedData.BusinessActivityClassifierCode2 = IBData.BusinessActivityClassifierCode2;
		EndIf; 
		If Not ValueIsFilled(ReceivedData.RNCFI) Then
			ReceivedData.RNCFI = IBData.RNCFI;
		EndIf;   
		If Not ValueIsFilled(ReceivedData.OKFS) Then
			ReceivedData.OKFS = IBData.OKFS;
		EndIf;
		
		If ValueIsFilled(ReceivedData.NameHistory) Then
			
			If IBData.NameHistory.Count() > 0 Then
				
				KeyFieldsArray = New Array;
				
				KeyFieldsArray.Add("Period");
				KeyFieldsArray.Add("DescriptionFull"); 
				
				DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
					ReceivedData.NameHistory,
					IBData.NameHistory,
					KeyFieldsArray, 
					"DescriptionInternational"); 
					
			EndIf;
			
			IBData.NameHistory.Load(ReceivedData.NameHistory.Unload());
		Else
			ReceivedData.NameHistory.Load(IBData.NameHistory.Unload());
		EndIf;
	
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If ReceivedData.AdditionalProperties.Property("Prefix") And ValueIsFilled(ReceivedData.AdditionalProperties.Prefix) Then
		DataToWriteToIB.Prefix = ReceivedData.AdditionalProperties.Prefix;
	EndIf;
	If ReceivedData.AdditionalProperties.Property("OGRN") And ValueIsFilled(ReceivedData.AdditionalProperties.OGRN) Then
		DataToWriteToIB.OGRN = ReceivedData.AdditionalProperties.OGRN;
	EndIf;
	If ReceivedData.AdditionalProperties.Property("CRTR") And ValueIsFilled(ReceivedData.AdditionalProperties.CRTR) Then
		DataToWriteToIB.CRTR = ReceivedData.AdditionalProperties.CRTR;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.LocalAccountingCurrency) Then
		DataToWriteToIB.LocalAccountingCurrency = SettingsValueCached.DefaultBaseCurrency();
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.RegistrationCountry) Then
	     DataToWriteToIB.RegistrationCountry = Constants.MainCountry.Get();
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.Status) Then
		DataToWriteToIB.Status = PredefinedValue("Enum.BusinessUnitCompanyStatuses.Valid");
	EndIf;
	
	FillInHistoryOfCompanyNames(DataToWriteToIB, ReceivedData);
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
	                            ReceivedData.AdditionalProperties, ExchangeComponents);
EndProcedure


