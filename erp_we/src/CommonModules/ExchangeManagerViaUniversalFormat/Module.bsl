Procedure PCO_Document_ReceiptOfServicesOtherAssets_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "S";
	Number = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	XDTOData.KeyProperties.Insert("Number", Number);	
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	
	If FormatVersionIs17AndHigher Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReceiptOfServicesOtherAssets_Sending", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	XDTOData.Insert("OperationKind", "PurchaseFromSupplier_");
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData);
	
	UnloadDivision(IBData, XDTOData);
	
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	
	If IBData.Currency = CurrencyOfComplianceAccounting
		Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
		XDTOData.Insert("TransactionRate",      IBData.CourseNumerator);
		XDTOData.Insert("Multiplier_", IBData.CourseDenominator);
	Else
		UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
	EndIf;
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = IBData.Currency = CurrencyOfComplianceAccounting And IBData.Currency <> IBData.ARAPCurrency;
		EndIf;
	
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = IBData.ARAPCurrency;
		DefaultParameters.TypeOfAgreement              = "WithVendor";
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", Undefined, IBData.Terms, Undefined);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	//Services
	Query = New Query("SELECT
	|	Expenses.Content,
	|	CASE WHEN Expenses.Count = 0 THEN 1 ELSE Expenses.Count END AS Count,
	|	Expenses.Price,
	|	Expenses.Sum,
	|	Expenses.VATRate,
	|	Expenses.VATAmount,
	|	Expenses.ExpenseItem AS ExpenseItem,
	|	Expenses.Department AS Department,
	|	CASE
	|		WHEN Expenses.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|			THEN 0
	|		ELSE Expenses.AmountIncludingVAT
	|	END AS AmountIncludingVAT,
	|	Expenses.DimensionOfExpenses AS DimensionOfExpenses,
	|	CASE
	|		WHEN Expenses.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ThisIsAdditionalExpense
	|FROM
	|	Document.VendorInvoiceServicesAndAssets.Expenses AS Expenses
	|WHERE
	|	Expenses.Ref = &Ref");
	
	Query.SetParameter("Ref", IBData.Ref);
	Services = Query.Execute().Unload();
	Services.Columns.Add("CostAccount");
	Services.Columns.Add("CostDivision");
	Services.Columns.Add("CostItem");
	
	// Filling out the cost account.
	For Each ServiceLine_1 In Services Do
		
		AccountingInvoiceServiceLine = Undefined;
		
		// Parameters No.2,3 and 4 are necessary for calculating the cost account in the UP/KA.
		ServiceLine_1.CostAccount = AccountingInvoiceForArticle(ServiceLine_1.ExpenseItem, IBData.Organization,
			ServiceLine_1.Department, IBData.Date, AccountingInvoiceServiceLine);
		
		If ValueIsFilled(ServiceLine_1.Department) Then
			StructureDivision = New Structure();
			UnloadDivision(IBData, StructureDivision, ServiceLine_1.Department);
			ServiceLine_1.CostDivision = StructureDivision.Department;
		EndIf;
		
	EndDo;
	
	XDTOData.Insert("Sum", Services.Total("Sum"));
	
	TranscriptOfAdditionalExpenses = IncomeAndExpensesServer.ExpenseAllocationOnInventoryCosts(IBData.Ref);
	// Deleting lines with empty amounts from the decryption.
	NumberOfLinesAdditionalCosts = TranscriptOfAdditionalExpenses.Count();
	For LineNumber = 1 To NumberOfLinesAdditionalCosts Do
		IndexOf = NumberOfLinesAdditionalCosts - LineNumber;
		If Round(TranscriptOfAdditionalExpenses[IndexOf].Sum,2) = 0 Then
			TranscriptOfAdditionalExpenses.Delete(IndexOf);
		EndIf;
	EndDo;
	
	// We do not transfer as additional expenses if there are blank receipt documents.
	NoBaseForDistribution = (TranscriptOfAdditionalExpenses.Count()=0);
	For Each LineDecryptionOfAdditionalExpenses In TranscriptOfAdditionalExpenses Do
		If Not ValueIsFilled(LineDecryptionOfAdditionalExpenses.DocumentInflow) Then
			NoBaseForDistribution = True;
			Break;
		EndIf;
	EndDo;
	
	If NoBaseForDistribution Then
		Services.FillValues(False, "ThisIsAdditionalExpense");
		TranscriptOfAdditionalExpenses.Clear();
	EndIf;
	
	If TranscriptOfAdditionalExpenses.Count() > 0 Then
		For Each OperationService In Services Do 
			Filter = New Structure("DocumentInflow", OperationService.DimensionOfExpenses);
			OperationService.ThisIsAdditionalExpense = TranscriptOfAdditionalExpenses.FindRows(Filter).Count() > 0;
		EndDo;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Services, False);
	EndIf;
	XDTOData.Insert("Services", Services);  
	TotalRows = TranscriptOfAdditionalExpenses.Count();
	If TotalRows > 0 Then   
		If FormatVersionIs17AndHigher Then 
			TranscriptOfAdditionalExpenses.Columns.DocumentInflow.Name = "DocumentLink";  
			TranscriptOfAdditionalExpenses.Columns.Add("DocumentInflow");
			For Each Page1 In TranscriptOfAdditionalExpenses Do
				If TypeOf(Page1.DocumentLink) = Type("DocumentRef.AssemblyFromComponents") Then  
					OCR = "Document_AssemblyFromComponents";  
				ElsIf TypeOf(Page1.DocumentLink) = Type("DocumentRef.VendorInvoice") Then	
					OCR = "Document_ReceiptOfGoodsServices_Dispatch";
				EndIf;
				If ValueIsFilled(OCR) Then
					Instruction = New Structure("Value, OCRName", Page1.DocumentLink, OCR);
					Page1.DocumentInflow = Instruction;
				EndIf;
			EndDo; 
		Else
			For Counter = 0 To TotalRows - 1 Do 
				CurrentRow = TranscriptOfAdditionalExpenses[TotalRows - Counter - 1];
				If TypeOf(CurrentRow.DocumentInflow) = Type("DocumentRef.AssemblyFromComponents") Then
					TranscriptOfAdditionalExpenses.Delete(CurrentRow);
				EndIf;
			EndDo;
		EndIf;
	EndIf;
	XDTOData.Insert("TranscriptOfAdditionalExpenses", TranscriptOfAdditionalExpenses);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

