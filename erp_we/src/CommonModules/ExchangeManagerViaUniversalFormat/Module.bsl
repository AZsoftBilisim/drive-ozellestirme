Procedure DPR_Document_RetailSalesReport_OnProcess(IBData, UsageOCR, ExchangeComponents)
	If UsageOCR.Count() > 0
		And Not TypeOfTaxationIsValid(Undefined, IBData.VATTaxation, ExchangeComponents.ExchangeFormatVersion) Then
		
		ClearUsageOCR(UsageOCR);
		WarningTemplate = NStr("vi = 'Chưa kết xuất chứng từ %1, bởi vì kiểu hệ thống thuế %2 không được hỗ trợ với định dạng %3';
								|ru = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
								|en = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format'; fa = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
								|it = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
								|pl = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
								|tr = '%2 vergilendirme türü %3 biçiminde desteklenmediğinden dolayı %1 belgesi yüklenmedi'");
		WarningText = StrTemplate(WarningTemplate, IBData.Ref, "«" + String(IBData.VATTaxation) + "»", String(ExchangeComponents.ExchangeFormatVersion));
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
	EndIf;
	
	QueryText = 
		"SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.CCDNumber AS CCDNumber,
		|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
		|	InventoryKinds.InventoryOwnerAttribute.Counterparty AS Vendor,
		|	CASE
		|		WHEN CASE
		|				WHEN InventoryKinds.Ref.PriceIncludesVAT
		|					THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|				ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|			END < 0.01
		|			THEN 0.01
		|		ELSE CAST(CASE
		|					WHEN InventoryKinds.Ref.PriceIncludesVAT
		|						THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|					ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|				END AS NUMBER(31, 2))
		|	END AS Price,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	InventoryKinds.ItemsLocationAttributes.Products.OriginCountry AS OriginCountry
		|INTO TT_TypesOfInventory
		|FROM
		|	Document.RetailSalesReport.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.CCDNumber AS CCDNumber,
		|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
		|	InventoryKinds.InventoryOwnerAttribute.Counterparty AS Vendor,
		|	CASE
		|		WHEN CASE
		|				WHEN InventoryKinds.Ref.PriceIncludesVAT
		|					THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|				ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|			END < 0.01
		|			THEN 0.01
		|		ELSE CAST(CASE
		|					WHEN InventoryKinds.Ref.PriceIncludesVAT
		|						THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|					ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|				END AS NUMBER(31, 2))
		|	END AS Price,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	InventoryKinds.DocumentSalesOfGoodsAndServices.Date AS DateOfSale,
		|	InventoryKinds.Ref.Date AS Date,
		|	InventoryKinds.ItemsLocationAttributes.Products.OriginCountry AS OriginCountry
		|INTO TT_TypesOfInventoryReturns
		|FROM
		|	Document.RetailReturnsReport.InventoryKinds AS InventoryKinds
		|WHERE
		|	&RefundsSeparately
		|	AND InventoryKinds.Ref.Posted
		|	AND InventoryKinds.Ref.CashRegisterShift = &CashRegisterShift
		|	AND InventoryKinds.Ref.CashRegisterShift <> VALUE(Document.CashRegisterShift.EmptyRef)
		|	AND InventoryKinds.Ref.VATTaxation = &VATTaxation
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GiftCertificateSale.Ref AS Ref,
		|	GiftCertificateSale.Organization AS Organization
		|INTO TT_PSImplementation
		|FROM
		|	Document.GiftCertificateSale AS GiftCertificateSale
		|WHERE
		|	GiftCertificateSale.CashRegisterShift = &CashRegisterShift
		|	AND GiftCertificateSale.Status = VALUE(Enum.CashRegisterReceiptStatuses.ReceiptIsIssued_)
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RetailSalesReportExciseStamps.LineNumber AS DocumentRowNumber,
		|	RetailSalesReportExciseStamps.ExciseStamp AS ExciseStamp
		|INTO TTExciseStamps
		|FROM
		|	Document.RetailSalesReport.ExciseStamps AS RetailSalesReportExciseStamps
		|WHERE
		|	&UnloadingBarcodesOfPackages
		|	AND RetailSalesReportExciseStamps.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TabProducts.Products AS Products,
		|	TabProducts.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	TabProducts.Price AS Price,
		|	TabProducts.VATRate,
		|	TabProducts.Vendor AS Vendor,
		|	TabProducts.InventoryType AS InventoryType,
		|	TabProducts.Count AS Count,
		|	TabProducts.Sum AS Sum,
		|	TabProducts.VATAmount AS VATAmount
		|FROM
		|	TT_TypesOfInventory AS TabProducts
		|WHERE
		|	NOT &RefundsSeparately
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TabProducts.Products AS Products,
		|	TabProducts.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	TabProducts.Price AS Price,
		|	TabProducts.VATRate,
		|	TabProducts.Vendor AS Vendor,
		|	TabProducts.InventoryType AS InventoryType,
		|	TabProducts.Count AS Count,
		|	TabProducts.Sum AS Sum,
		|	TabProducts.VATAmount AS VATAmount
		|FROM
		|	TT_TypesOfInventory AS TabProducts
		|WHERE
		|	&RefundsSeparately
		|	AND TabProducts.Count > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TabProducts.Products AS Products,
		|	TabProducts.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	TabProducts.Price AS Price,
		|	TabProducts.VATRate,
		|	TabProducts.Vendor AS Vendor,
		|	TabProducts.InventoryType AS InventoryType,
		|	TabProducts.Count AS Count,
		|	TabProducts.Sum AS Sum,
		|	ISNULL(TabProducts.DateOfSale, TabProducts.Date) AS DateOfSale,
		|	TabProducts.VATAmount AS VATAmount
		|FROM
		|	TT_TypesOfInventoryReturns AS TabProducts
		|WHERE
		|	&RefundsSeparately
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.Products.Description AS Content,
		|	Goods.Count AS Count,
		|	Goods.Price AS Price,
		|	Goods.Sum AS Sum,
		|	Goods.VATRate AS VATRate,
		|	Goods.Products.Principal AS PrincipalLink,
		|	CASE
		|		WHEN Goods.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByCompanyOnAgencyBasis)
		|				OR Goods.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByPartner)
		|			THEN ""Agency""
		|		ELSE ""Own""
		|	END AS ServiceType,
		|	Goods.VATAmount AS VATAmount,
		|	Goods.Products.OriginCountry AS OriginCountry
		|FROM
		|	Document.RetailSalesReport.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref
		|	AND (Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
		|			OR Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	PaymentWithPaymentCards.Sum AS PayAmount,
		|	CASE 
		|		WHEN PaymentCardNumber = """" THEN
		|			""0000 0000 0000 0000 00""
		|		ELSE
		|			PaymentWithPaymentCards.PaymentCardNumber
		|	END AS CardNumber,
		|	""Undefined"" AS CardKind,
		|	PaymentWithPaymentCards.PaymentKind_ AS TypesOfCashRegisterPaymentSystem,
		|	PaymentWithPaymentCards.POSTerminal.Owner.BankAccount AS CompanyBankAccount,
		|	PaymentWithPaymentCards.POSTerminal.Code AS POSTerminalNumber,
		|	PaymentWithPaymentCards.POSTerminal.Ref AS POSTerminalLink,
		|	CASE
		|		WHEN PaymentWithPaymentCards.POSTerminal.Owner.Counterparty IS NULL
		|			THEN PaymentWithPaymentCards.ConnectionContract.Counterparty
		|		WHEN PaymentWithPaymentCards.POSTerminal.Owner.Counterparty = VALUE(Catalog.Counterparties.EmptyRef)
		|			THEN PaymentWithPaymentCards.ConnectionContract.Counterparty
		|		ELSE ISNULL(PaymentWithPaymentCards.POSTerminal.Owner.Counterparty, VALUE(Catalog.Counterparties.EmptyRef))
		|	END AS Acquirer,
		|	PaymentWithPaymentCards.ConnectionContract AS ConnectionContract
		|FROM
		|	Document.RetailSalesReport.PaymentWithPaymentCards AS PaymentWithPaymentCards
		|
		|WHERE
		|	PaymentWithPaymentCards.Ref = &Ref
		|
		|UNION ALL
		|
		|SELECT
		|	-PaymentByPaymentCardsRefund.Sum AS PayAmount,
		|	CASE 
		|		WHEN PaymentCardNumber = """" THEN
		|			""0000 0000 0000 0000 00""
		|		ELSE
		|			PaymentByPaymentCardsRefund.PaymentCardNumber
		|	END AS CardNumber,
		|	""Undefined"" AS CardKind,
		|	PaymentByPaymentCardsRefund.PaymentKind_ AS TypesOfCashRegisterPaymentSystem,
		|	PaymentByPaymentCardsRefund.POSTerminal.Owner.BankAccount AS CompanyBankAccount,
		|	PaymentByPaymentCardsRefund.POSTerminal.Code AS Number,
		|	PaymentByPaymentCardsRefund.POSTerminal.Ref AS Ref,
		|	ISNULL(PaymentByPaymentCardsRefund.POSTerminal.Owner.Counterparty, VALUE(Catalog.Counterparties.EmptyRef)) AS Acquirer,
		|	PaymentByPaymentCardsRefund.ConnectionContract
		|FROM
		|	Document.RetailReturnsReport.PaymentWithPaymentCards AS PaymentByPaymentCardsRefund
		|WHERE
		|	&RefundsSeparately
		|	AND PaymentByPaymentCardsRefund.Ref.Posted
		|	AND PaymentByPaymentCardsRefund.Ref.CashRegisterShift = &CashRegisterShift
		|	AND PaymentByPaymentCardsRefund.Ref.CashRegisterShift <> VALUE(Document.CashRegisterShift.EmptyRef)
		|	AND PaymentByPaymentCardsRefund.Ref.VATTaxation = &VATTaxation
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SUM(GiftCertificates.Sum) AS Sum,
		|	GiftCertificates.GiftCertificate.Code AS SerialNumber,
		|	GiftCertificates.GiftCertificate.Barcode AS Barcode,
		|	GiftCertificates.GiftCertificate.MagneticCode AS MagneticCode,
		|	GiftCertificates.GiftCertificate.Owner AS TypeOfGiftCertificateLink
		|FROM
		|	Document.RetailSalesReport.GiftCertificates AS GiftCertificates
		|WHERE
		|	GiftCertificates.Ref = &Ref
		|
		|GROUP BY
		|	GiftCertificates.GiftCertificate.Code,
		|	GiftCertificates.GiftCertificate.Barcode,
		|	GiftCertificates.GiftCertificate.MagneticCode,
		|	GiftCertificates.GiftCertificate.Owner
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GiftCertificateSale.Sum AS Sum,
		|	GiftCertificateSale.GiftCertificate.Barcode AS Barcode,
		|	GiftCertificateSale.GiftCertificate.MagneticCode AS MagneticCode,
		|	GiftCertificateSale.GiftCertificate.Code AS SerialNumber,
		|	GiftCertificateKinds.PartialPayment AS PartialPaymentIsAllowed,
		|	GiftCertificateKinds.Ref AS GiftCertificateKind,
		|	MAX(ISNULL(CASE
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.DAY)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, DAY, GiftCertificateKinds.NumberOfValidityPeriods)
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.WEEK)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, WEEK, GiftCertificateKinds.NumberOfValidityPeriods)
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.MONTH)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, MONTH, GiftCertificateKinds.NumberOfValidityPeriods)
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.QUARTER)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, QUARTER, GiftCertificateKinds.NumberOfValidityPeriods)
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.YEAR)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, YEAR, GiftCertificateKinds.NumberOfValidityPeriods)
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.TENDAYS)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, TENDAYS, GiftCertificateKinds.NumberOfValidityPeriods)
		|				WHEN GiftCertificateKinds.ActionPeriod = VALUE(Enum.Periodicity.HALFYEAR)
		|					THEN DATEADD(ActivatingGiftCertificates.Period, HALFYEAR, GiftCertificateKinds.NumberOfValidityPeriods)
		|				ELSE ActivatingGiftCertificates.Period
		|			END, DATETIME(1, 1, 1))) AS ValidBefore
		|FROM
		|	Document.GiftCertificateSale.GiftCertificates AS GiftCertificateSale
		|		INNER JOIN TT_PSImplementation AS TT_PSImplementation
		|		ON GiftCertificateSale.Ref = TT_PSImplementation.Ref
		|		INNER JOIN Catalog.GiftCertificateKinds AS GiftCertificateKinds
		|		ON GiftCertificateSale.GiftCertificate.Owner = GiftCertificateKinds.Ref
		|		LEFT JOIN InformationRegister.GiftCardHistory AS ActivatingGiftCertificates
		|		ON (CASE
		|		WHEN GiftCertificateKinds.GiftCardAccounting25
		|			THEN GiftCertificateSale.GiftCertificate = ActivatingGiftCertificates.GiftCertificate
		|					AND ActivatingGiftCertificates.Status = VALUE(Enum.GiftCertificateStatuses.Activated)
		|	END)
		|
		|GROUP BY
		|	GiftCertificateSale.Sum,
		|	GiftCertificateSale.GiftCertificate.Barcode,
		|	GiftCertificateSale.GiftCertificate.MagneticCode,
		|	GiftCertificateSale.GiftCertificate.Code,
		|	GiftCertificateKinds.PartialPayment,
		|	GiftCertificateKinds.Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SUM(PaymentWithPaymentCards.Sum) AS PayAmount,
		|	CASE 
		|		WHEN PaymentCardNumber = """" THEN
		|			""0000 0000 0000 0000 00""
		|		ELSE
		|			PaymentWithPaymentCards.PaymentCardNumber
		|	END AS CardNumber,
		|	""Undefined"" AS CardKind,
		|	PaymentWithPaymentCards.PaymentKind_ AS TypesOfCashRegisterPaymentSystem,
		|	ISNULL(POSTerminals.Owner.Counterparty, PaymentWithPaymentCards.ConnectionContract.Counterparty) AS Acquirer,
		|	ISNULL(POSTerminals.Owner.BankAccount, VALUE(Catalog.CompaniesBankAccounts.EmptyRef)) AS CompanyBankAccount,
		|	POSTerminals.Code AS POSTerminalNumber,
		|	POSTerminals.Ref AS POSTerminalLink,
		|	PaymentWithPaymentCards.ConnectionContract AS ConnectionContract
		|FROM
		|	Document.GiftCertificateSale.PaymentWithPaymentCards AS PaymentWithPaymentCards
		|		LEFT JOIN Catalog.POSTerminals AS POSTerminals
		|		ON PaymentWithPaymentCards.POSTerminal = POSTerminals.Ref
		|		INNER JOIN TT_PSImplementation AS TT_PSImplementation
		|		ON PaymentWithPaymentCards.Ref = TT_PSImplementation.Ref
		|
		|GROUP BY
		|	PaymentWithPaymentCards.POSTerminal,
		|	PaymentWithPaymentCards.PaymentCardNumber,
		|	PaymentWithPaymentCards.PaymentKind_,
		|	ISNULL(POSTerminals.Owner.Counterparty, PaymentWithPaymentCards.ConnectionContract.Counterparty),
		|	ISNULL(POSTerminals.Owner.BankAccount, VALUE(Catalog.CompaniesBankAccounts.EmptyRef)),
		|	POSTerminals.Code,
		|	POSTerminals.Ref,
		|	PaymentWithPaymentCards.ConnectionContract
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RetailSalesReportBonusPointAccrual.LineNumber AS DocumentRowNumber,
		|	RetailSalesReportBonusPointAccrual.AccrualDate AS AccrualDate,
		|	RetailSalesReportBonusPointAccrual.DateOfDeduction AS DateOfDeduction,
		|	RetailSalesReportBonusPointAccrual.Partner AS Partner,
		|	RetailSalesReportBonusPointAccrual.LoyaltyProgram AS LoyaltyProgram_,
		|	RetailSalesReportBonusPointAccrual.AmountOfBonusPoints AS AmountOfBonusPoints
		|FROM
		|	Document.RetailSalesReport.BonusPointAccrual AS RetailSalesReportBonusPointAccrual
		|WHERE
		|	RetailSalesReportBonusPointAccrual.Ref = &Ref
		|	AND NOT RetailSalesReportBonusPointAccrual.Partner = VALUE(Catalog.Partners.EmptyRef)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	RetailSalesReportPaymentWithBonusPoints.LineNumber AS DocumentRowNumber,
		|	RetailSalesReportPaymentWithBonusPoints.Partner AS Partner,
		|	RetailSalesReportPaymentWithBonusPoints.LoyaltyProgram AS LoyaltyProgram_,
		|	RetailSalesReportPaymentWithBonusPoints.AmountOfBonusPoints AS AmountOfBonusPoints
		|FROM
		|	Document.RetailSalesReport.PaymentWithBonusPoints AS RetailSalesReportPaymentWithBonusPoints
		|WHERE
		|	RetailSalesReportPaymentWithBonusPoints.Ref = &Ref
		|	AND NOT RetailSalesReportPaymentWithBonusPoints.Partner = VALUE(Catalog.Partners.EmptyRef)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTExciseStamps.DocumentRowNumber AS DocumentRowNumber
		|FROM
		|	TTExciseStamps AS TTExciseStamps
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTExciseStamps.DocumentRowNumber AS DocumentRowNumber,
		|	TTExciseStamps.ExciseStamp AS PackageMarking
		|FROM
		|	TTExciseStamps AS TTExciseStamps
		|";
		
	FillInYourOwnProductsInText(QueryText);
	
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
	GetTextOfCharacteristicsRequest(ExchangeComponents, "TabProducts"));
	
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
	GetPackagingRequestText(ExchangeComponents, "TabProducts"));
	
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
	GetSeriesRequestText(ExchangeComponents, "TabProducts"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
	GetTextOfRNPTRequest(ExchangeComponents, "TabProducts"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
	GetTextOfCCDRequest(ExchangeComponents, "TabProducts"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref",                     IBData.Ref);
	Query.SetParameter("CashRegisterShift",              IBData.CashRegisterShift);
	Query.SetParameter("VATTaxation",         IBData.VATTaxation);
	Query.SetParameter("RefundsSeparately",           True);
	Query.SetParameter("UnloadingBarcodesOfPackages", UnloadingBarcodesOfPackages(ExchangeComponents)); 
	QueryResults = Query.ExecuteBatch();
	IBData.AdditionalProperties.Insert("QueryResults", QueryResults);
	
	CheckingFillingInRequiredAttributesOfInformationSecurityObject(IBData, ExchangeComponents, UsageOCR);
EndProcedure


