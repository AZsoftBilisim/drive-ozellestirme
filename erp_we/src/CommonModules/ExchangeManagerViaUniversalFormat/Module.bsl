Procedure OCR_Document_ExpenseReport_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	ReceivedData.PriceIncludesVAT = True;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	#Region PaymentToVendors
	
	FillingRules = New Map;
	FillingRules.Insert("Counterparty",              "Counterparty");
	FillingRules.Insert("Sum",                   "Sum");
	FillingRules.Insert("AmountARAP",     "AmountARAP");
	FillingRules.Insert("Content",              "Comment");
	FillingRules.Insert("IncomingDocumentNumber", "IncomingDocumentNumber");
	FillingRules.Insert("IncomingDocumentDate",  "IncomingDocumentDate");
	
	ArrayOfPaymentToSuppliersLines = New Array;
	
	If XDTOData.Property("PaymentToCounterparties")
		And ValueIsFilled(XDTOData.PaymentToCounterparties) Then
		
		For Each String In XDTOData.PaymentToCounterparties Do
			
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			// The currency of mutual settlements
			If ValueIsFilled(String.ARAPCurrency) Then
				If TypeOf(String.ARAPCurrency) = Type("Structure")
					And Not String.ARAPCurrency.Property("Ref") Then
					OCRName = "Catalog___FromStructure";
				Else
					OCRName = "Catalog_Currencies";
				EndIf;
				StringDataStructure.Insert("ARAPCurrency", New Structure("Value, OCRName", String.ARAPCurrency, OCRName));
			EndIf;
			
			// Contract
			If ValueIsFilled(String.Contract) Then
				If TypeOf(String.Contract) = Type("Structure")
					And Not String.Contract.Property("Ref") Then
					OCRName = "Catalog_ContractsOfCounterparties_FromStructure__";
				Else
					OCRName = "Catalog_CounterpartyContracts_Receive";
				EndIf;
				DocumentOfARAPAccounting = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, String.Contract);
				If ValueIsFilled(DocumentOfARAPAccounting) Then
					StringDataStructure.Insert("DocumentOfARAPAccounting", DocumentOfARAPAccounting)
				EndIf;
			EndIf;
			
			If ValueIsFilled(String.DocumentOfARAPAccounting) Then
				DocumentOfARAPAccounting = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, String.DocumentOfARAPAccounting);
				If ValueIsFilled(DocumentOfARAPAccounting) Then
					StringDataStructure.Insert("DocumentOfARAPAccounting", DocumentOfARAPAccounting)
				EndIf;
			EndIf;
			
			ArrayOfPaymentToSuppliersLines.Add(StringDataStructure);
		
		EndDo;
		
	EndIf;
	
	If ArrayOfPaymentToSuppliersLines.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("PaymentToVendors", ArrayOfPaymentToSuppliersLines);
	EndIf;
	#EndRegion
	
	#Region Other
	
	FillingRules = New Map;
	FillingRules.Insert("Content",              "Content");
	FillingRules.Insert("Vendor",               "Counterparty");
	FillingRules.Insert("Sum",                   "Sum");
	FillingRules.Insert("VATRate",               "VATRate");
	FillingRules.Insert("VATAmount",                "VATAmount");
	FillingRules.Insert("IncomingDocumentNumber", "IncomingDocumentNumber");
	FillingRules.Insert("IncomingDocumentDate",  "IncomingDocumentDate");
	FillingRules.Insert("CostDivision",     "Department");
	FillingRules.Insert("CostItem",            "CostItem");
	FillingRules.Insert("InvIsSubmitted",            "InvIsSubmitted");
	FillingRules.Insert("InvoiceDate",                  "InvoiceDate");
	FillingRules.Insert("InvoiceNumber",                 "InvoiceNumber");
	FillingRules.Insert("RowID",     "RowID");
	FillingRules.Insert("ExternalDocumentName", "ExternalDocumentName");
	
	ArrayOfStringsOther = New Array;
	
	If XDTOData.Property("OtherExpenses")
		And ValueIsFilled(XDTOData.OtherExpenses) Then
		
		For Each String In XDTOData.OtherExpenses Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
					
			If StringDataStructure.Property("CostItem")
				And ValueIsFilled(StringDataStructure.CostItem) Then
				StringDataStructure.Insert("ExpenseItem",
					New Structure("OCRName, Value", "Catalog_ExpenseItems", StringDataStructure.CostItem));
			EndIf;
			
			Sum     = StringDataStructure.Sum;
			VATAmount  = 0;
			AmountIncludingVAT = 0;
			If StringDataStructure.Property("VATAmount") And ValueIsFilled(StringDataStructure.VATAmount) Then
				VATAmount = StringDataStructure.VATAmount;
			EndIf;
			If XDTOData.Property("AmountIncludesVAT") And XDTOData.AmountIncludesVAT Then
				AmountIncludingVAT = Sum;
			Else
				AmountIncludingVAT = Sum + VATAmount;
				StringDataStructure.Sum = AmountIncludingVAT;
			EndIf;
			
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			
			ArrayOfStringsOther.Add(StringDataStructure);
		EndDo;
	
	EndIf;
	
	If ArrayOfStringsOther.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("OtherExpenses", ArrayOfStringsOther);
	EndIf;
	
	#EndRegion
	
	#Region Goods
		
	If XDTOData.Property("ReceiptDocumentKeys") Then
		// When the option "Printing a single advance report" is enabled and there
		// are several different sets of fields
		// "Supplier, date of the incoming document, number of the incoming document" in the tabular part of the "Goods", it is not possible
		// to use a separate PCO in the AML, because the object splits into many vocational schools.
		
		QueryText =
			"SELECT
			|	VendorInvoice.Ref AS Ref
			|FROM
			|	Document.VendorInvoice AS VendorInvoice
			|WHERE
			|	VendorInvoice.IncomingDocumentDate = &IncomingDocumentDate
			|	AND VendorInvoice.IncomingDocumentNumber = &IncomingDocumentNumber
			|	AND VendorInvoice.Organization = &Organization
			|	AND &SupplierCondition";
		
		TheStructureOfTheSearch = New Structure(XDTOData.KeyReceiptFields);
		For Each SetOfKeys In XDTOData.ReceiptDocumentKeys Do
			
			FillPropertyValues(TheStructureOfTheSearch, SetOfKeys);
			TSGoods = XDTOData.Goods.Copy(TheStructureOfTheSearch);
			
			ReceiptIdentified = False;
			Vendor = Undefined;
			If Not XDTOData.ThisIsNewAdvanceReport
				And ValueIsFilled(TheStructureOfTheSearch.IncomingDocumentDate)
				And ValueIsFilled(TheStructureOfTheSearch.IncomingDocumentNumber) Then
				
				// We will upload receipts that can be explicitly identified
				// by key fields.
				
				Query = New Query;
				Query.SetParameter("IncomingDocumentDate", TheStructureOfTheSearch.IncomingDocumentDate);
				Query.SetParameter("IncomingDocumentNumber", TheStructureOfTheSearch.IncomingDocumentNumber);
				Query.SetParameter("Organization", ReceivedData.Organization);
				
				// Let's try to find the receipt document taking into account the supplier.
				If TSGoods.Count()>0 And ValueIsFilled(TSGoods[0].Vendor) Then
					Vendor = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
						ExchangeComponents,
						TSGoods[0].Vendor,
						DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Counterparties_Receive"), 
						"GetRef").Ref;
				
					Query.Text = StrReplace(QueryText, "&SupplierCondition", "VendorInvoice.Counterparty = &Counterparty");
					Query.SetParameter("Counterparty", Vendor);
					
					ReceiptIdentified = Query.Execute().Select().Count() = 1;
				EndIf;
				
				If Not ReceiptIdentified Then
					// Let's try to find the receipt document without taking into account the supplier.
					Query.Text = StrReplace(QueryText, "&SupplierCondition", "True");
					ReceiptIdentified = Query.Execute().Select().Count() = 1;
				EndIf;
			EndIf;
			
			If XDTOData.ThisIsNewAdvanceReport Or ReceiptIdentified Then
				StructureOfVocationalSchools = Common.CopyRecursive(XDTOData);
				StructureOfVocationalSchools.Insert("Goods", TSGoods);
				If StructureOfVocationalSchools.Property("Ref") Then
					StructureOfVocationalSchools.Delete("Ref");
				EndIf;
				If StructureOfVocationalSchools.KeyProperties.Property("Ref") Then
					StructureOfVocationalSchools.KeyProperties.Delete("Ref");
				EndIf;
				If StructureOfVocationalSchools.KeyProperties.Property("Number") Then
					StructureOfVocationalSchools.KeyProperties.Delete("Number");
				EndIf;
				If ValueIsFilled(TheStructureOfTheSearch.IncomingDocumentNumber) Then
					VocationalSchoolThroughAccountablePerson = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
						ExchangeComponents,
						StructureOfVocationalSchools,
						DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Document_PTUThroughAccountablePerson_Receipt"), 
						"ConvertAndWrite");
				EndIf;
			Else
				WarningTemplate = NStr("vi = 'Phần bảng ""Mua hàng"" của chứng từ %1 đã được kết nhập không đầy đủ,
					|bởi vì không thể định danh rõ ràng và kết nhập chứng từ liên quan ""Mua hàng hóa và dịch vụ""
					|với dạng giao dịch ""Mua hàng thông qua người nhận tạm ứng"".
					|Số chứng từ đầu vào %2 ngày %3, nhà cung cấp: %4.';
					|ru = 'Табличная часть ""Закупки"" документа %1 загружена не полностью,
					|т.к. не удалось однозначно идентифицировать и загрузить связанный документ ""Приобретение товаров и услуг""
					|с видом операции ""Закупка через подотчетное лицо"".
					|Вх. номер %2 от %3, поставщик: %4.';
					|en = 'The ""Purchases"" table of the %1 document is partially imported
					|as unambiguous identification and import of the related ""Vendor invoice"" document with the ""Purchase via advance holder""
					|operation type were unsuccessful.
					|Incoming number %2 from %3, vendor: %4.'; fa = 'The ""Purchases"" table of the %1 document is partially imported
					|as unambiguous identification and import of the related ""Vendor invoice"" document with the ""Purchase via advance holder""
					|operation type were unsuccessful.
					|Incoming number %2 from %3, vendor: %4.';
					|it = 'La parte tabellare ""Acquisti"" del documento %1 non è stata caricata integralmente,
					|poiché non è stato possibile identificare univocamente e scaricare il documento collegato ""Acquisizione articoli e servizi""
					| con tipo di operazione ""Acquisto tramite responsabile"".
					|Numero sup. %2 di %3, fornitore: %4.';
					|pl = 'Sekcja tabelaryczny ""Zakup"" dokumentu %1 jest wczytana w całości,
					|ponieważ nie udało się jednoznacznie zidentyfikować i wczytać powiązany dokument ""Zakup towarów i usług""
					|z rodzajem operacji ""Zakup przez zaliczkobiorcę"".
					|Numer przychodzący %2 z dn. %3, dostawca: %4.';
					|tr = '%1 belgesinin ""Satın alma"" tablosu bölümü tam olarak yüklenmedi,
					|çünkü ilişkili ""Satın alma faturası"" belgesini
					|""Sorumlu bir kişi aracılığıyla satın alma"" işlem türüyle net bir şekilde tanımlamak ve yüklemek mümkün değildi.
					|Gelen. numara %2, %3''ten, tedarikçi: %4.'");
				
				WarningText = StrTemplate(WarningTemplate,
					XDTOData.AdvanceReportLink,
					TheStructureOfTheSearch.IncomingDocumentNumber,
					TheStructureOfTheSearch.IncomingDocumentDate,
					Vendor);
				
				ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.CompletedWithWarnings; 
				DataExchangeXDTOServer.WriteToExecutionProtocol(
					ExchangeComponents, WarningText, Undefined, False);
			EndIf;
			
		EndDo;
	EndIf;
	
	#EndRegion
EndProcedure
Procedure OCR_Document_ExpenseReport_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
	
	// Fill in the default document status.
	If ((IBData <> Undefined And Not ValueIsFilled(IBData.Status)) Or IBData = Undefined) Then
		ReceivedData.Status = Enums.ExpenseReportStatuses.Upholded;
	Else
		ReceivedData.Status = IBData.Status;
	EndIf;
	
	For Each String In ReceivedData.PaymentToVendors Do
	
		If ValueIsFilled(String.Vendor) 
			Or Not ValueIsFilled(String.Counterparty) Then
			Continue;
		EndIf;
			
		Partner = CashServer.GetCounterpartyPartner(String.Counterparty);
		
		If Not ValueIsFilled(Partner) Then
			Partner = Catalogs.Partners.UnknownPartner;
		EndIf;
	
		String.Vendor = Partner;
		
	EndDo;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
	                            ReceivedData.AdditionalProperties, ExchangeComponents);
	
	If IBData = Undefined Then
		Return;
	EndIf;
	
	// We transfer those properties that are specified in the PKS.
	FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
	IBData.PaymentToVendors.Load(ReceivedData.PaymentToVendors.Unload());
	
	If IBData.OtherExpenses.Count() > 0 Then
		// Other
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Comment");
		KeyFieldsArray.Add("Counterparty");
		KeyFieldsArray.Add("VATRate");
		KeyFieldsArray.Add("IncomingDocumentDate");
		KeyFieldsArray.Add("IncomingDocumentNumber");
		KeyFieldsArray.Add("Sum");
		KeyFieldsArray.Add("VATAmount");
		KeyFieldsArray.Add("AmountIncludingVAT");
	
		FillObjectTabularSectionWithInitialData(
			ReceivedData.OtherExpenses,
			IBData.OtherExpenses,
			KeyFieldsArray,,
			"ExpenseItem, DimensionOfExpenses, AssetsLiabilitiesDimension, Department, GLAccountSettings");
	EndIf;
	
	IBData.OtherExpenses.Load(ReceivedData.OtherExpenses.Unload());
	FillInAdditionalInformationSecurityDataPropertiesFromReceivedData(IBData, ReceivedData);
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
	ReceivedData = Undefined;
EndProcedure

