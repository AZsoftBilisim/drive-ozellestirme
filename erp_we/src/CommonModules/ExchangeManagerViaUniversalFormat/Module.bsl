	ProcessingRule.OCRUsed.Add("Document_CashAccountReceiptNote_CashRegisterReceipt_Receive");
	ProcessingRule.OCRUsed.Add("Document_CashVoucher_CashRegisterReceipt_Receive");
	ProcessingRule.OCRUsed.Add("Document_CustomerInvoice_CashRegisterReceipt_Receive");
	ProcessingRule.OCRUsed.Add("Document_Receipt_Receipt");
	ProcessingRule.OCRUsed.Add("Document_ReceiptCashRegisterRefund_Receipt");
	ProcessingRule.OCRUsed.Add("Document_ReceiptOfCashRegisterCorrection_Receipt");
EndProcedure
Procedure DPR_Document_CashRegisterReceipt_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		
		CashPaymentAmount = 0;
		If XDTOData.Property("CashRegisterPayments") Then
			For Each String In XDTOData.CashRegisterPayments Do
				If String.TypeOfPayment <> Undefined And String.TypeOfPayment.Value = "CashPayment" Then
					CashPaymentAmount = CashPaymentAmount + String.Sum;
				EndIf;
			EndDo;
		EndIf;
		
		DocumentOnClientSOrder 		= XDTOData.Property("SalesOrder") And ValueIsFilled(XDTOData.SalesOrder);
		DocumentReturnPolicy				= XDTOData.Property("GoodsReturnSales") And ValueIsFilled(XDTOData.GoodsReturnSales);
		DocumentSales					= XDTOData.Property("GoodsSale") And ValueIsFilled(XDTOData.GoodsSale)
											Or XDTOData.Property("Services") And ValueIsFilled(XDTOData.Services);
		DocumentAdjustingEntries 			= XDTOData.Property("Corrective") And XDTOData.Corrective;
		DocumentPaymentCards_ = XDTOData.Property("PaymentWithPaymentCards") And ValueIsFilled(XDTOData.PaymentWithPaymentCards);
		DocumentPaymentInCash 		= (CashPaymentAmount > 0);
		
		UsageOCR.Document_Receipt_Receipt = 								Not DocumentOnClientSOrder
																					And DocumentSales
																					And Not DocumentAdjustingEntries;
													 
		UsageOCR.Document_ReceiptCashRegisterRefund_Receipt = 						Not DocumentOnClientSOrder
																					And DocumentReturnPolicy
																					And Not DocumentAdjustingEntries;
													
		UsageOCR.Document_ReceiptOfCashRegisterCorrection_Receipt = 						Not DocumentOnClientSOrder
																					And Not DocumentReturnPolicy
																					And DocumentAdjustingEntries;
													
		UsageOCR.Document_CustomerInvoice_CashRegisterReceipt_Receive =			DocumentOnClientSOrder
																					And DocumentSales
																					And Not DocumentAdjustingEntries;
													
		UsageOCR.Document_ReturnOfGoodsFromCustomer_CashRegisterReceipt_Receive = 		DocumentOnClientSOrder
																					And DocumentReturnPolicy;
													
		UsageOCR.Document_SaleAdjustment_CashRegisterReceipt_Receive =		DocumentOnClientSOrder
																					And DocumentAdjustingEntries;
													
		UsageOCR.Document_CashAccountReceiptNote_CashRegisterReceipt_Receive = 		DocumentOnClientSOrder
																					And DocumentPaymentInCash
																					And DocumentSales
																					And Not DocumentAdjustingEntries;
		
		UsageOCR.Document_PaymentCardTransaction_CashRegisterReceipt_Receive = 		DocumentOnClientSOrder
																					And DocumentPaymentCards_
																					And Not DocumentAdjustingEntries;
		
		UsageOCR.Document_CashVoucher_CashRegisterReceipt_Receive =			DocumentOnClientSOrder
																					And DocumentPaymentInCash
																					And DocumentReturnPolicy
																					And Not DocumentAdjustingEntries;
																					
	Else
	
		ClearUsageOCR(UsageOCR);
		
	EndIf;
EndProcedure


