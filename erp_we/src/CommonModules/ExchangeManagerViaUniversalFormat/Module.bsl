Procedure OCR_Catalog_ItemsCharacteristics_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If Not ValueIsFilled(IBData.DescriptionFull) And ValueIsFilled(IBData.Description) Then
		XDTOData.KeyProperties.Insert("DescriptionFull", IBData.Description);
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6")
		And TypeOf(IBData.Owner) = Type("CatalogRef.Products") Then
			XDTOData.KeyProperties.Insert("Products", IBData.Owner);
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7")
		And TypeOf(IBData.Owner) = Type("CatalogRef.ItemKinds") Then
			XDTOData.KeyProperties.Insert("ProductKind", IBData.Owner);
	EndIf; 
	//++ Principal
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21")
		And ValueIsFilled(IBData.Principal) Then
		
		PrincipalStructure = PrincipalByValue(IBData.Principal);
		If ValueIsFilled(PrincipalStructure) Then
			XDTOData.Insert("Principal", PrincipalStructure);
		EndIf;
		
	EndIf;
	//-- Principal
EndProcedure
Procedure OCR_Catalog_ItemsCharacteristics_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	OwnerSInstructions = New Structure;
	If XDTOData.KeyProperties.Property("ProductKind") Then
		OwnerSInstructions.Insert("Value", XDTOData.KeyProperties.ProductKind);
		OwnerSInstructions.Insert("OCRName",   "Catalog_ItemKinds");
	ElsIf XDTOData.KeyProperties.Property("Products") Then
	
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7") Then
			// The characteristic for the type of nomenclature is unloaded as a "Structure"
			// with substitution as the owner of the Nomenclature from the document line.
			// Let's check the existence of the item at the time of loading.
			Products = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
					ExchangeComponents,
					XDTOData.KeyProperties.Products,
					DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Products_Receive"), 
					"GetRef");
			
			If TypeOf(Products) = Type("CatalogRef.Products") Then
				ProductAttributes = Common.ObjectAttributesValues(Products,
					"ProductKind, ItemVariantsOwner, UseVariants");
					
				If ValueIsFilled(ProductAttributes.UseVariants) Then
					If ProductAttributes.UseVariants = Enums.ItemVariantsUsageOptions.CommonForItemKind
						And ValueIsFilled(ProductAttributes.ProductKind) Then
						ReceivedData.Owner = ProductAttributes.ProductKind;
					ElsIf ProductAttributes.UseVariants = Enums.ItemVariantsUsageOptions.CommonWithOtherItemKind
						And ValueIsFilled(ProductAttributes.ItemVariantsOwner) Then
						ReceivedData.Owner = ProductAttributes.ItemVariantsOwner;
					EndIf;
				EndIf;
			EndIf;
		EndIf;		
				
		If Not ValueIsFilled(ReceivedData.Owner) Then
			OwnerSInstructions.Insert("Value", XDTOData.KeyProperties.Products);
			OwnerSInstructions.Insert("OCRName",   "Catalog_Products_Receive");
		EndIf;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21")
		And XDTOData.Property("Principal") And ValueIsFilled(XDTOData.Principal) Then
		
		If XDTOData.Principal.ValueType = "Organization" Then
			CurICO = "Catalog_Companies_Receive";
		ElsIf XDTOData.Principal.ValueType = "Counterparty" Then
			CurICO = "Catalog_Counterparties_Receive";
		Else
			CurICO = Undefined;
		EndIf;
		If Not IsBlankString(CurICO) Then
			DescriptionOfReceipt = New Structure("Value, OCRName", XDTOData.Principal, CurICO);
			ReceivedData.AdditionalProperties.Insert("Principal", DescriptionOfReceipt);
			
			ICOString = New Structure;
			ICOString.Insert("ConversionRule", DataExchangeXDTOServer.OCRByName(ExchangeComponents, CurICO));
			ICOString.Insert("DeleteObjectsCreatedByKeyProperties", True);
			PrincipalLink = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents, XDTOData.Principal, ICOString, "GetRef");
			ReceivedData.AdditionalProperties.Insert("PrincipalIncomingLink", PrincipalLink);
		EndIf;
		
	EndIf;
	If ValueIsFilled(OwnerSInstructions) Then
		ReceivedData.AdditionalProperties.Insert("Owner", OwnerSInstructions);
	EndIf;
EndProcedure
Procedure OCR_Catalog_ItemsCharacteristics_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If Not ValueIsFilled(ReceivedData.Owner)
		Or (Not IBData = Undefined And TypeOf(IBData.Owner) = Type("CatalogRef.ItemKinds")
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7")) Then
		ReceivedData = Undefined;
	EndIf;  
	    If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21") Then
		
		If ReceivedData.AdditionalProperties.Property("PrincipalIncomingLink") Then
			PrincipalReceived = ReceivedData.AdditionalProperties.PrincipalIncomingLink;
			ErrorText = "";
			If Not ValueIsFilled(PrincipalReceived) Then
				ErrorText = NStr("ru = 'Не удалось получить Принципала для характеристики.';
								|vi = 'Cannot get the Principal for the variant.';
								|en = 'Cannot get the Principal for the variant.'; fa = 'Cannot get the Principal for the variant.';
								|it = 'Cannot get the Principal for the variant.';
								|pl = 'Cannot get the Principal for the variant.';
								|tr = 'Varyant için müvekkil alınamadı.'");
			ElsIf  TypeOf(PrincipalReceived) = Type("CatalogRef.Companies")  Then
				IBData.Principal = PrincipalReceived;
			ElsIf  TypeOf(PrincipalReceived) = Type("CatalogRef.Counterparties")  Then
				CurPartner_ = Common.ObjectAttributeValue(PrincipalReceived, "Partner");
				IBData.Principal = CurPartner_;
				
				If Not ValueIsFilled(CurPartner_) Then
					ErrorText = NStr("ru = 'Не удалось получить партнера по контрагенту для характеристики.';
									|vi = 'Cannot get the partner by counterparty for the variant.';
									|en = 'Cannot get the partner by counterparty for the variant.'; fa = 'Cannot get the partner by counterparty for the variant.';
									|it = 'Cannot get the partner by counterparty for the variant.';
									|pl = 'Cannot get the partner by counterparty for the variant.';
									|tr = 'Varyant için cari hesap üzerinden partner alınamadı.'");
				EndIf;
			EndIf;
			
			If Not IsBlankString(ErrorText) Then
				WriteErrorToEventLog(IBData.Ref, ErrorText, ExchangeComponents, EventLogLevel.Warning);		
				InformationRegisters.DataExchangeResults.RecordDocumentCheckError(
				IBData.Ref,
				ExchangeComponents.CorrespondentNode,
				ErrorText,
				Enums.DataExchangeIssuesTypes.HandlersCodeExecutionErrorOnGetData);
			EndIf;
			
		EndIf;
	EndIf;
EndProcedure


