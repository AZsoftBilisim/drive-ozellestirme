Procedure Merzhevanie_RKO(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData = Undefined Then
		Return;
	EndIf;
	
	IB_CounterpartyDataBeforeChange = IBData.Counterparty;
	
	#Region Header
	
	// During intercampany operations, some details of the IB object have a higher priority.
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
		FillPropertyValues(ReceivedData, IBData,
			"Counterparty,BusinessOperation");
	EndIf;
	
	// Filling in the counterparty in special cases when there is no PKS for him.
	If ValueIsFilled(ReceivedData.Counterparty) Then
		IBData.Counterparty = ReceivedData.Counterparty;
	EndIf;
	
	// Filling out a bank account for cash Collection and Deposit operations.
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashCollectionToBank
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashDepositToBankAccount Then
		If Not ValueIsFilled(ReceivedData.BankAccount) Then
			ReceivedData.BankAccount = IBData.BankAccount;
		EndIf;
	EndIf;
	
	// Replacing the properties that we got from the XDTO.
	FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
	// Filling in the recipient's cash register.
	If IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		CashRegisterAttributes = Common.ObjectAttributesValues(IBData.CashAccountRecipient, "CashCurrency, Owner");
		If CashRegisterAttributes.CashCurrency <> ReceivedData.CurrencyOfConversion 
			Or CashRegisterAttributes.Owner <> ReceivedData.Organization Then
			IBData.CashAccountRecipient = ReceivedData.CashAccountRecipient;
		EndIf;
	EndIf;
	
	#EndRegion
	
	#Region ARAPDetails
	
	// Getting the decryption of the payment.
	PaymentDecryptionSource = ReceivedData.ARAPDetails;
	PaymentDecryptionReceiver = IBData.ARAPDetails;
	
	If PaymentDecryptionSource.Count() = PaymentDecryptionReceiver.Count() Then
		
		For RowIndex = 0 To PaymentDecryptionSource.Count() - 1 Do
			
			SourceRow = PaymentDecryptionSource[RowIndex];
			DestinationRow = PaymentDecryptionReceiver[RowIndex];
			
			FillPropertyValues(DestinationRow, SourceRow,
				"Sum,
				|AmountARAP,
				|ARAPCurrency");
			
			If ValueIsFilled(SourceRow.ExpenseItem) Then
				DestinationRow.ExpenseItem = SourceRow.ExpenseItem;
			EndIf;
			
			If ValueIsFilled(SourceRow.CashFlowItem) Then
				DestinationRow.CashFlowItem = SourceRow.CashFlowItem;
			EndIf;
			
			If ValueIsFilled(SourceRow.Department) Then
				DestinationRow.Department = SourceRow.Department;
			EndIf;
			
			// Changing the counterparty updates the analytics dependent on it.
			If IBData.Counterparty <> IB_CounterpartyDataBeforeChange Then
				FillPropertyValues(DestinationRow, SourceRow, "Partner");
			EndIf;
				
		EndDo;
		
	Else
		IBData.ARAPDetails.Load(ReceivedData.ARAPDetails.Unload());
	EndIf;
	
	#EndRegion
EndProcedure
Procedure Merzhevanie_SBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData = Undefined Then
		Return;
	EndIf;
	
	IB_CounterpartyDataBeforeChange = IBData.Counterparty;
	
	#Region Header
	
	// The order of payment.
	If Not ValueIsFilled(ReceivedData.RankingInPriorityOfPayment) Then
		ReceivedData.RankingInPriorityOfPayment = IBData.RankingInPriorityOfPayment;
	EndIf;
	AdditionalProperties = ReceivedData.AdditionalProperties;
	
	If AdditionalProperties.Property("Contract") Then
		ReceivedData.Contract = AdditionalProperties.Contract;
	EndIf;
	// Filling in the counterparty, if it is not filled in.
	If Not ValueIsFilled(ReceivedData.Counterparty) Then
		If ValueIsFilled(IBData.Counterparty) Then
			ReceivedData.Counterparty = IBData.Counterparty;
		Else
			FillInAllOurEnterprise(ReceivedData, ExchangeComponents.ConversionParameters_SSLy);
		EndIf;
	EndIf;
	
	// During intercampany operations, some details of the IB object have a higher priority.
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
		FillPropertyValues(ReceivedData, IBData,
			"Counterparty,CounterpartyBankAccount,BusinessOperation");
	EndIf;
	
	// Replacing the properties that we got from the XDTO.
	FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
	#EndRegion
	
	#Region ARAPDetails
	
	// Getting the decryption of the payment.
	PaymentDecryptionSource = ReceivedData.ARAPDetails;
	PaymentDecryptionReceiver = IBData.ARAPDetails;
	
	If PaymentDecryptionSource.Count() = PaymentDecryptionReceiver.Count() Then
		
		For RowIndex = 0 To PaymentDecryptionSource.Count() - 1 Do
			
			SourceRow = PaymentDecryptionSource[RowIndex];
			DestinationRow = PaymentDecryptionReceiver[RowIndex];
			
			FillPropertyValues(DestinationRow, SourceRow,
				"Sum,
				|AmountARAP,
				|ARAPCurrency");
			
			If ValueIsFilled(SourceRow.ExpenseItem) Then
				DestinationRow.ExpenseItem = SourceRow.ExpenseItem;
			EndIf;
			
			If ValueIsFilled(SourceRow.CashFlowItem) Then
				If Common.RefExists(SourceRow.CashFlowItem) Then
					DestinationRow.CashFlowItem = SourceRow.CashFlowItem;
				Else
					DestinationRow.CashFlowItem = Catalogs.CashFlowReportItems.EmptyRef();
				EndIf;
			EndIf;
			
			// Changing the counterparty updates the analytics dependent on it.
			If IBData.Counterparty <> IB_CounterpartyDataBeforeChange Then
				FillPropertyValues(DestinationRow, SourceRow, "Partner");
			EndIf;
			
		EndDo;
		
	Else
		IBData.ARAPDetails.Load(ReceivedData.ARAPDetails.Unload());
	EndIf;
	
	// Synchronization of the amount in the decryption and in the header.
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashToAnotherAccount Then
		
		If IBData.ARAPDetails.Count() = 1 Then
			IBData.ARAPDetails[0].Sum = IBData.DocumentAmount;
		EndIf; 
	
	EndIf;
	
	#EndRegion
EndProcedure
Function MetadataPassesThroughFiltersOfNodeSDocumentTypes(NameOfMetadataObjects, ExchangeComponents)
	ObjectPassesFilter = True;
	
	If Not ExchangeComponents.IsExchangeViaExchangePlan
		Or Not ExchangeComponents.CorrespondentNodeObject.UseFilterByAccountingSectionAndDocument
		Or Not ValueIsFilled(NameOfMetadataObjects) Then
		
		Return ObjectPassesFilter;
		
	EndIf;
	
	TheStructureOfTheSearch = New Structure("MetadataObjectName", NameOfMetadataObjects);
	
	FoundRows = ExchangeComponents.CorrespondentNodeObject.DocumentsKinds.FindRows(TheStructureOfTheSearch);
	
	If FoundRows.Count() = 0 Then
		
		ObjectPassesFilter = False;
		
	EndIf;
	
	Return ObjectPassesFilter;
EndFunction


