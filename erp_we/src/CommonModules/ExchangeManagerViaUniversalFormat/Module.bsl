Procedure AddDPR_Document_PhysicalCountReport_Send(DataProcessingRules)
	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Document_Inventory_Sending";
	ProcessingRule.SelectionObjectMetadata = Metadata.Documents.PhysicalCountReport;
	ProcessingRule.OnProcess            = "DPR_Document_PhysicalCountReport_Send_OnProcess";
	ProcessingRule.DataClearing           = True;
	ProcessingRule.OCRUsed.Add("Document_Inventory_Sending");
EndProcedure
Procedure DPR_Document_PhysicalCountReport_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	UsageOCR.Document_Inventory_Sending = False;	
	
	DocumentData = Documents.PhysicalCountReport.InventoryData(IBData.Ref);
	
	If DocumentData = Undefined Then
		UsageOCR.Document_Inventory_Sending = False;
	Else
		TableOfGoods = DocumentData.ResultForTabularPart.Unload();
		TableOfGoods.Columns.QuantityByAccount.Name = "NumberOfDays_1";
		TableOfGoods.Columns.Quantity_Actual.Name = "Count";
		TableOfGoods.Columns.AccountInAccounting.Name = "AmountAccounting_";
		TableOfGoods.Columns.Amount_Actual.Name = "Sum";
		TableOfGoods.Columns.Add("Barcode");
		TableOfGoods.Columns.Add("RetailPrice");
		TableOfGoods.Columns.Add("PricePerPackaging");
		TableOfGoods.Columns.Add("NumberOfPackages");
		TableOfGoods.Columns.Add("NumberOfPackagesAccounting");
		TableOfGoods.Columns.Add("InventoryType");
		TableOfGoods.Columns.Add("GLAccount");
		TableOfGoods.Columns.Add("DocumentRowNumber");
		TableOfGoods.Columns.Add("UnitOfMeasure");
	
		If DocumentData.ResultCurrencyExchangeRate <> Undefined Then
			CurrencyExchangeRate = DocumentData.ResultCurrencyExchangeRate.Select();
			If CurrencyExchangeRate.Next() Then
				ConversionFactor_ = CurrencyExchangeRate.ConversionFactor_;
			Else
				ConversionFactor_ = 1;
			EndIf;
		Else
			ConversionFactor_ = 1;
		EndIf;
		
		FillInCharacteristicsOfWHPackage(ExchangeComponents, TableOfGoods);
	
		LineNumber = 0;
		UnitsOfMeasurement = Common.ObjectsAttributeValue(TableOfGoods.UnloadColumn("Products"), "UnitOfMeasure");
		For Each TableRow In TableOfGoods Do
			LineNumber = LineNumber + 1;
			TableRow.DocumentRowNumber = LineNumber;
			TableRow.UnitOfMeasure     = UnitsOfMeasurement[TableRow.Products];
			TableRow.Price                 = Round(TableRow.Price * ConversionFactor_, 2);
			TableRow.AmountAccounting_            = Round(TableRow.AmountAccounting_ * ConversionFactor_, 2);
			TableRow.Sum                = Round(TableRow.Sum * ConversionFactor_, 2);
			TableRow.InventoryType           = Enums.InventoryTypes.OwnGoods;	
		EndDo;
		
		IBData.AdditionalProperties.Insert("Goods", TableOfGoods);
		
	EndIf;
EndProcedure


