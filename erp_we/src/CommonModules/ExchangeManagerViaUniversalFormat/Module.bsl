Procedure OCR_Document_RetailReturnsReport_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	
	Number = XDTOData.KeyProperties.Number;
	If StrFind(Number,"-") = 0 Then
		ReceivedData.Number = "";
	EndIf;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	If Not ValueIsFilled(ReceivedData.PriceKind) And ValueIsFilled(ReceivedData.Warehouse) Then
		ReceivedData.PriceKind = ReceivedData.Warehouse.RetailPriceType;
	EndIf;
	If Not ValueIsFilled(ReceivedData.PriceKind) And Not ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes = Undefined 
		And ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes.Count() > 0 Then
		ReceivedData.PriceKind = ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes[0].Value; 
	EndIf;
	
	FillInVATTaxationBasedOnReceivedData(ExchangeComponents, ReceivedData, XDTOData, False);
	
	FillingRules = New Map;
	FillingRules.Insert("Products",  "Products");
	FillingRules.Insert("Count",    "Count");
	FillingRules.Insert("Sum",         "Sum");
	FillingRules.Insert("Price",          "Price");
	FillingRules.Insert("VATRate",     "VATRate");
	FillingRules.Insert("VATAmount",      "VATAmount");
	FillingRules.Insert("DiscountPercentage", "PercentRateOfManualDiscount");
	FillingRules.Insert("DiscountAmount",   "ManualDiscount");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	DocumentAmount = 0;
	ArrayOfRows = New Array;
	
	If XDTOData.Property("GoodsReturnSales")
		And ValueIsFilled(XDTOData.GoodsReturnSales) Then
		
		For Each String In XDTOData.GoodsReturnSales Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			If Not StringDataStructure.Property("NumberOfPackages") Then
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
			If StringDataStructure.Property("Sum") Then
				StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
				DocumentAmount = DocumentAmount + StringDataStructure.Sum;
			EndIf;
			
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	//Payment with payment cards
	ArrayOfLinesPaymentPC = New Array;
	
	If XDTOData.Property("PaymentWithPaymentCards")
		And ValueIsFilled(XDTOData.PaymentWithPaymentCards) Then
		
		For Each String In XDTOData.PaymentWithPaymentCards Do
			If String.PayAmount >= 0 And (ExchangeComponents.IsExchangeViaExchangePlan And Not ExchangeComponents.CorrespondentNode.SettingsMode = "CashExchange") Then
				Continue;
			EndIf;
			StringDataStructure = New Structure;  
			If String.PayAmount >= 0 And (ExchangeComponents.IsExchangeViaExchangePlan And ExchangeComponents.CorrespondentNode.SettingsMode = "CashExchange") Then 
				PayAmount = Min(String.PayAmount, DocumentAmount);
				StringDataStructure.Insert("Sum", PayAmount);
			Else
				StringDataStructure.Insert("Sum", (-1) * String.PayAmount);
			EndIf;
			StringDataStructure.Insert("PaymentCardNumber", String.CardNumber);
			If ValueIsFilled(String.POSTerminal) Then 
				CatPOSTerminal = String.POSTerminal;
				If CatPOSTerminal.Property("Number") And Not IsBlankString(CatPOSTerminal.Number) Then
					Instruction = New Structure;
					Instruction.Insert("Value", String.POSTerminal);
					Instruction.Insert("OCRName", "Catalog_POSTerminals_Receive");
				    StringDataStructure.Insert("POSTerminal", Instruction);
				EndIf;	
			EndIf;		
					
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.11") Then  
				StringDataStructure.Insert("PaymentKind_", String.TypesOfCashRegisterPaymentSystem);
			EndIf;
			
			ArrayOfLinesPaymentPC.Add(StringDataStructure);
			
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("PaymentWithPaymentCards", ArrayOfLinesPaymentPC);	
	EndIf;
	
	ReceivedData.AdditionalProperties.Insert("DocumentAmount", DocumentAmount);
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
EndProcedure
Procedure OCR_Document_RetailReturnsReport_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	For Each String In ReceivedData.Goods Do
		String.Partner = Catalogs.Partners.RetailCustomer;
	EndDo;
	
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
	
	// If there is an object in the database, it will be recorded (and not the received data).
	// The header and tabular part are preliminarily transferred from the received data to the given data:
	// the header is part of the properties from the PKS, the tabular part is completely taken from the received data.
	If IBData <> Undefined Then
		WarehouseInformationSecurityData = IBData.Warehouse;
	
		// We transfer those properties that are specified in the PKS.
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		If Not ExchangeComponents.ConversionParameters_SSLy.UploadAnalyticsByWarehouse Then
			// Restoring the warehouse from the original document.
			IBData.Warehouse = WarehouseInformationSecurityData;
		EndIf;
	
		// Table parts
		IBData.Goods.Load(ReceivedData.Goods.Unload());
		// If the number of lines and the amount of PM payments with payment cards has not changed, then we do not overwrite the tabular part
		// so as not to erase the terminal and the card number.
		If Not (IBData.PaymentWithPaymentCards.Count() = ReceivedData.PaymentWithPaymentCards.Count()
			And IBData.PaymentWithPaymentCards.Total("Sum") = ReceivedData.PaymentWithPaymentCards.Total("Sum")) Then
			IBData.PaymentWithPaymentCards.Load(ReceivedData.PaymentWithPaymentCards.Unload());
		EndIf;
	
		AuxProperties = ReceivedData.AdditionalProperties;
		For Each StructureItem In AuxProperties Do
			IBData.AdditionalProperties.Insert(StructureItem.Key, StructureItem.Value);
		EndDo;
		ReceivedData = Undefined;
		DataToWriteToIB = IBData;
	Else
		DataToWriteToIB = ReceivedData;
	EndIf;
	
	If ValueIsFilled(DataToWriteToIB.CashRegister) And Not ValueIsFilled(DataToWriteToIB.Warehouse) Then
		DataToWriteToIB.Warehouse = Common.ObjectAttributeValue(DataToWriteToIB.CashRegister, "Warehouse");
	EndIf;
		
	If ValueIsFilled(DataToWriteToIB.CashRegister) And Not ValueIsFilled(DataToWriteToIB.PriceKind) Then
		DataToWriteToIB.PriceKind = Common.ObjectAttributeValue(DataToWriteToIB.CashRegister, "Warehouse.RetailPriceType");
	EndIf;
	
	TableOfParts = New Structure;
	For Each TS In DataToWriteToIB.Metadata().TabularSections Do
		TableOfParts.Insert(TS.Name, DataToWriteToIB[TS.Name].Unload());
	EndDo;
	DataToWriteToIB.AdditionalProperties.Insert("TableOfParts", TableOfParts);
EndProcedure

