Procedure OCR_Catalog_CounterpartyContracts_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	XDTOData.KeyProperties.Insert("CalculationsInConventionalUnits", False);
	
	If VueCalculationIsUnderway(IBData.ARAPCurrency, IBData.ForeignCurrencyTransaction, IBData.Organization, ExchangeComponents) Then
		XDTOData.KeyProperties.CalculationsInConventionalUnits = True;
	EndIf;
	
	InstructionsTypeOfAgreement = New Structure;
	InstructionsTypeOfAgreement.Insert("OCRName",   "Enumeration_TypesOfContracts_Sending");
	InstructionsTypeOfAgreement.Insert("Value", IBData.ContractType);
	
	If IBData.ContractType = Enums.ContractTypes.WithVendor Then	
		Query = New Query(
		"SELECT TOP 1
		|	CCDImport.Ref AS Ref
		|FROM
		|	Document.CCDImport AS CCDImport
		|WHERE
		|	CCDImport.Contract = &Contract
		|	AND CCDImport.Posted");
		Query.SetParameter("Contract", IBData.Ref);
	
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			XDTOData.KeyProperties.Insert("TypeOfAgreement", "Other");
		Else
			XDTOData.KeyProperties.Insert("TypeOfAgreement", InstructionsTypeOfAgreement);
		EndIf;
	Else
		XDTOData.KeyProperties.Insert("TypeOfAgreement", InstructionsTypeOfAgreement);
	EndIf;
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") 
		And IBData.ContractType = Enums.ContractTypes.SalesViaCommissionAgent Then
			
			XDTOData.Insert("Consignee", IBData.CounterpartyCommissionAgent);
			XDTOData.Insert("ContractWithCommissionAgent", IBData.ContractWithCommissionAgent); 
			
	EndIf;
	
	If XDTOData.Property("KeyProperties") Then
		KeyProperties = XDTOData.KeyProperties; // Structure
		KeyProperties.Description = TrimAll(IBData.Description);
	EndIf;
	If ValueIsFilled(IBData.ForeignExchangeControlUniqueNumber)
		And StrLen(IBData.ForeignExchangeControlUniqueNumber)< 22 Then 
	    XDTOData.Insert("ForeignExchangeControlUniqueNumber", "");
	EndIf;
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
EndProcedure

