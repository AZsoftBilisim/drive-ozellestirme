Procedure PCO_Document_SaleOfGoodsAndServicesFee_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	//Fill in the tax return with the received data(Exchange components, received data, DATAXDTO, False);
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	If XDTOData.Property("ARAPCurrency") Then
	     AddCurrencyToAdditionalProperties(ReceivedData, XDTOData, "ARAPCurrency", "ARAPCurrency");
	ElsIf Not GetFunctionalOption("UseMultipleCurrencies")And GetFunctionalOption("CurrenciesOfManAndLocalAccountingMatch") Then	
	     AddCurrencyToAdditionalProperties(ReceivedData, XDTOData, "Currency", "ARAPCurrency");
	EndIf;
	
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	
	// Head and Chief Accountant
	If XDTOData.Property("Director") And ValueIsFilled(XDTOData.Director) Then
		
		DirectorStructure = New Structure;
		DirectorStructure.Insert("Owner", ReceivedData.Organization);
		DirectorStructure.Insert("Individual", XDTOData.Director);
		DirectorStructure.Insert("JobTitle", NStr("vi = 'Lãnh đạo';
													|ru = 'Руководитель';
													|en = 'CEO'; fa = 'مدیرعامل';
													|it = 'Руководитель';
													|pl = 'CEO';
													|tr = 'Yönetici'"));
		DirectorStructure.Insert("Description", NStr("vi = 'Lãnh đạo';
													|ru = 'Руководитель';
													|en = 'CEO'; fa = 'مدیرعامل';
													|it = 'Руководитель';
													|pl = 'CEO';
													|tr = 'Yönetici'"));
		DirectorStructure.Insert("EmployeeInCharge_", "Director");
		DirectorStructure.Insert("StartDate", Date(1980,1,1));
		
		ReceivedData.AdditionalProperties.Insert("Director", DirectorStructure);
		
	EndIf;
	
	If XDTOData.Property("ChiefAccountant") And ValueIsFilled(XDTOData.ChiefAccountant) Then
		
		ChiefAccountantStructure = New Structure;
		ChiefAccountantStructure.Insert("Owner", ReceivedData.Organization);
		ChiefAccountantStructure.Insert("Individual", XDTOData.ChiefAccountant);
		ChiefAccountantStructure.Insert("JobTitle", NStr("vi = 'Kế toán trưởng';
														|ru = 'Главный бухгалтер';
														|en = 'Chief Accountant'; fa = 'حسابدار ارشد';
														|it = 'Главный бухгалтер';
														|pl = 'Główny księgowy';
														|tr = 'Muhasebe şefi'"));
		ChiefAccountantStructure.Insert("Description", NStr("vi = 'Kế toán trưởng';
															|ru = 'Главный бухгалтер';
															|en = 'Chief Accountant'; fa = 'حسابدار ارشد';
															|it = 'Главный бухгалтер';
															|pl = 'Główny księgowy';
															|tr = 'Muhasebe şefi'"));
		ChiefAccountantStructure.Insert("EmployeeInCharge_", "ChiefAccountant");
		ChiefAccountantStructure.Insert("StartDate", Date(1980,1,1));
		
		ReceivedData.AdditionalProperties.Insert("ChiefAccountant", ChiefAccountantStructure);
		
	EndIf;
	
	ReceivedData.Posted    = True;
	ReceivedData.Approved  = True;
	
	If ReceivedData.BusinessOperation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit
		And Not ValueIsFilled(ReceivedData.DateOfTransferOfTitleToGoods) Then
		ReceivedData.Status = Enums.StatusesOfCustomerInvoices.InTransit;	
	Else
		ReceivedData.Status = Enums.StatusesOfCustomerInvoices.Shipped;
	EndIf;
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products",       "Products");
	FillingRules.Insert("Count",         "Count");
	FillingRules.Insert("Sum",              "Sum");
	FillingRules.Insert("Price",               "Price");
	FillingRules.Insert("VATRate",          "VATRate");
	FillingRules.Insert("VATAmount",           "VATAmount");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	// Goods 
	ThereIsPropertyLineNumberReceived = False;
	ArrayOfRows = New Array;
	
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
		
		For Each String In XDTOData.Goods Do
		
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("LineNumberReceived") Then
			     StringDataStructure.Insert("LineNumberReceived", StringDataStructure.DocumentRowNumber);
			     ThereIsPropertyLineNumberReceived = True;
			EndIf;
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			If StringDataStructure.Property("NumberOfPackages") Then
			    If StringDataStructure.Property("Package") And StringDataStructure.Property("Sum") Then
					StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
				EndIf;
			Else
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
			
			If XDTOData.Property("Warehouse") Then
				StringDataStructure.Insert("Warehouse", XDTOData.Warehouse);
			EndIf;
			
			AmountIncludingVAT = String.Sum;	
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			
	    	ArrayOfRows.Add(StringDataStructure);
	    	
		EndDo;
		
	EndIf;
	
	// Services are loaded into PM Goods 
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
	
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			If StringDataStructure.Property("LineNumberReceived") Then
			     StringDataStructure.Insert("LineNumberReceived", StringDataStructure.DocumentRowNumber);
			EndIf;
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
				
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;		
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			
			ArrayOfRows.Add(StringDataStructure);
			
		EndDo;
		
	EndIf;      
	
	If ThereIsPropertyLineNumberReceived Then
		SortTable = TMCommonUse.ArrayToValueTable(ArrayOfRows); 
		SortTable.Sort("LineNumberReceived Asc"); 
		ArrayOfRows = Common.ValueTableToArray(SortTable);
	EndIf;
		
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	#EndRegion
		
	#Region Buyers
	
	If XDTOData.Property("Buyers") And ValueIsFilled(XDTOData.Buyers)
		And XDTOData.Buyers.Count() > 0 Then
		
		ReceivedData.AdditionalProperties.Insert("CustomerCounterparty", XDTOData.Buyers[0].Customer);
		ReceivedData.AdditionalProperties.Insert("CustomerContract", XDTOData.Buyers[0].ContractOfBuyerOfCommissionGoods);
		
	EndIf;
	
	#EndRegion
EndProcedure
Procedure PCO_Document_SaleOfGoodsAndServicesFee_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	If ValueIsFilled(ReceivedData.Counterparty) And Not ValueIsFilled(ReceivedData.Partner) Then
		ReceivedData.Partner = Common.ObjectAttributeValue(ReceivedData.Counterparty, "Partner");
	EndIf;
	          
	If ValueIsFilled(ReceivedData.CustomerCounterparty) And Not ValueIsFilled(ReceivedData.CustomerPartner) Then
		ReceivedData.CustomerPartner = Common.ObjectAttributeValue(ReceivedData.CustomerCounterparty, "Partner");
	EndIf;          
	          
	// Department
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
								
	If IBData <> Undefined Then
	
		// We transfer those properties that are specified in the PKS.
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		// Goods
		KeyFieldsArray = New Array;
		
		KeyFieldsArray.Add("Products");
		
		PreGoods = ReceivedData.Goods.Unload(); 
		If Not PreGoods = Undefined And Not PreGoods.Columns.Find("Characteristic")  = Undefined Then
			PreGoods.GroupBy("Characteristic");
			If PreGoods.Count()> 0 And ValueIsFilled(PreGoods[0].Characteristic) Then
				KeyFieldsArray.Add("Characteristic");
			EndIf;
		EndIf;
		
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("Warehouse");
		KeyFieldsArray.Add("VATRate");
	
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
				ReceivedData.Goods,
				IBData.Goods,
				KeyFieldsArray,
				Undefined,
				"Count, Package, NumberOfPackages, Price, Sum, VATAmount, AmountIncludingVAT");
			
		IBData.Goods.Load(ReceivedData.Goods.Unload());
	
		ReceivedData = Undefined;
		
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If DataToWriteToIB.Currency = DataToWriteToIB.ARAPCurrency Then
		DataToWriteToIB.CourseNumerator   = 1;
		DataToWriteToIB.CourseDenominator = 1;
	EndIf;
	
	If Not IBData = Undefined Then
	    ThereAreAdjustingEntries = False;
		SalesServer.CheckForAdjustments(IBData.Ref, IBData.Ref, ThereAreAdjustingEntries);
		If ThereAreAdjustingEntries = False Then
		     ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData); 
		EndIf;
	EndIf;
EndProcedure


