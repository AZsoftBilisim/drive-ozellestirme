Procedure OCR_Document_PaymentCardTransaction_CashRegister_Receipt(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	
	If ValueIsFilled(XDTOData.SalesOrder) Then
		ReceivedData.AdditionalProperties.Insert("PaymentPurpose", LinkToCalculationDocumentFromXDTOData(ExchangeComponents, XDTOData.SalesOrder));
	EndIf;
	
	ReceivedData.DocumentAmount = 0;
	If XDTOData.Property("PaymentWithPaymentCards")
		And ValueIsFilled(XDTOData.PaymentWithPaymentCards) Then
		For Each String In XDTOData.PaymentWithPaymentCards Do
			ReceivedData.DocumentAmount = ReceivedData.DocumentAmount + String.PayAmount;
		EndDo;
	EndIf;
	
	If XDTOData.Property("PaymentWithPaymentCards") And XDTOData.PaymentWithPaymentCards.Count() > 0 Then
		PaymentByXDTOPaymentCards = XDTOData.PaymentWithPaymentCards[0];
		//Acquiring terminal
		If ValueIsFilled(PaymentByXDTOPaymentCards.POSTerminal)Then 
			CatPOSTerminal = String.POSTerminal;
			If CatPOSTerminal.Property("Number") And Not IsBlankString(CatPOSTerminal.Number) Then
				Instruction = New Structure;
				Instruction.Insert("Value", PaymentByXDTOPaymentCards.POSTerminal);
				Instruction.Insert("OCRName", "Catalog_POSTerminals_Receive");
				ReceivedData.AdditionalProperties.Insert("POSTerminal", Instruction);
			EndIf;
		EndIf;
	
	EndIf;
EndProcedure
