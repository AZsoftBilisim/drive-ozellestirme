Procedure OCR_Document_ExpenseReport_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	UnloadDivision(IBData, XDTOData);
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_AdvanceReport_Dispatch", 
										"OtherExpenses", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending"); 
	EndIf;
	
	Query = New Query;
	
	// These document headers are necessary for calculating the rate and multiplicity.
	Query.Text =
	"SELECT
	|	ISNULL(CurrencyRatesCut.CourseNumerator, 1) AS TransactionRate,
	|	ISNULL(CurrencyRatesCut.CourseDenominator, 1) AS Multiplier_
	|FROM
	|	(SELECT
	|		&Currency AS Currency) AS DocumentCurrency
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &Currency AND BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
	|		ON (CurrencyRatesCut.Currency = DocumentCurrency.Currency)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherExpenses.Counterparty,
	|	OtherExpenses.Sum,
	|	OtherExpenses.VATAmount,
	|	OtherExpenses.CashFlowItem,
	|	OtherExpenses.Department,
	|	OtherExpenses.ExpenseItem,
	|	OtherExpenses.RowID,
	|	OtherExpenses.IncomingDocumentNumber,
	|	OtherExpenses.IncomingDocumentDate,
	|	OtherExpenses.ExternalDocumentName,
	|	OtherExpenses.Comment,
	|	OtherExpenses.ExpenseItem AS ExpenseItem1
	|INTO TTOtherExpenses_
	|FROM
	|	&OtherExpenses AS OtherExpenses
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PaymentToVendors.Counterparty,
	|	PaymentToVendors.Sum,
	|	PaymentToVendors.AmountARAP,
	|	PaymentToVendors.Comment,
	|	PaymentToVendors.IncomingDocumentNumber,
	|	PaymentToVendors.IncomingDocumentDate,
	|	PaymentToVendors.ARAPObject AS ARAPObject,
	|	PaymentToVendors.ARAPCurrency
	|INTO TTPaymentToSuppliers
	|FROM
	|	&PaymentToVendors AS PaymentToVendors
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NULL AS Products,
	|	AdvanceReportOtherExpenses.Counterparty AS Vendor,
	|	AdvanceReportOtherExpenses.Sum AS Sum,
	|	AdvanceReportOtherExpenses.VATAmount AS VATAmount,
	|	AdvanceReportOtherExpenses.CashFlowItem AS CashFlowItem,
	|	AdvanceReportOtherExpenses.Department AS Department,
	|	AdvanceReportOtherExpenses.ExpenseItem AS ExpenseItem,
	|	AdvanceReportOtherExpenses.RowID AS RowID,
	|	FALSE AS InvIsSubmitted,
	|	AdvanceReportOtherExpenses.IncomingDocumentNumber AS IncomingDocumentNumber,
	|	AdvanceReportOtherExpenses.IncomingDocumentDate AS IncomingDocumentDate,
	|	AdvanceReportOtherExpenses.ExternalDocumentName AS ExternalDocumentName,
	|	NULL AS InvoiceDate,
	|	NULL AS InvoiceNumber,
	|	CASE
	|		WHEN SUBSTRING(AdvanceReportOtherExpenses.Comment, 0, 1) = """"
	|			THEN ISNULL(ExpenseItems.Description, ISNULL(AssetLiabilityItems.Description, """"))
	|		ELSE AdvanceReportOtherExpenses.Comment
	|	END AS Content
	|FROM
	|	TTOtherExpenses_ AS AdvanceReportOtherExpenses
	|		LEFT JOIN ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|		ON (ExpenseItems.Ref = AdvanceReportOtherExpenses.ExpenseItem)
	|		LEFT JOIN ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
	|		ON (AssetLiabilityItems.Ref = AdvanceReportOtherExpenses.ExpenseItem)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	AdvanceReportPaymentToSuppliers.Counterparty,
	|	AdvanceReportPaymentToSuppliers.Sum,
	|	AdvanceReportPaymentToSuppliers.AmountARAP,
	|	AdvanceReportPaymentToSuppliers.Comment AS Content,
	|	AdvanceReportPaymentToSuppliers.IncomingDocumentNumber,
	|	AdvanceReportPaymentToSuppliers.IncomingDocumentDate,
	|	AdvanceReportPaymentToSuppliers.ARAPObject.Object AS OrderDocument,
	|	AdvanceReportPaymentToSuppliers.ARAPCurrency AS ARAPCurrency,
	|	ISNULL(CurrencyExchangeRate.CourseNumerator, 1) AS TransactionRate,
	|	ISNULL(CurrencyExchangeRate.CourseDenominator, 1) AS Multiplier_
	|FROM
	|	TTPaymentToSuppliers AS AdvanceReportPaymentToSuppliers
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS CurrencyExchangeRate
	|		ON AdvanceReportPaymentToSuppliers.ARAPCurrency = CurrencyExchangeRate.Currency";
	
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("Currency", IBData.Currency);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	If TypeOf(IBData) = Type("Structure") Then
		Query.SetParameter("OtherExpenses", IBData.OtherExpenses);
		Query.SetParameter("PaymentToVendors", IBData.PaymentToVendors);
	Else
		Query.SetParameter("OtherExpenses", IBData.OtherExpenses.Unload());
		Query.SetParameter("PaymentToVendors", IBData.PaymentToVendors.Unload());
	EndIf;
	
	QueryResults = Query.ExecuteBatch();
	OperationData = QueryResults[0].Select();
	If OperationData.Next() Then
		XDTOData.Insert("DocumentCourse", OperationData.TransactionRate);
		XDTOData.Insert("DocumentMultiplicity", OperationData.Multiplier_);
	EndIf;
	
	Tobacco_0 = QueryResults[3].Unload(); 
	Tobacco_0.Columns.Add("CostDivision");
	Tobacco_0.Columns.Add("CostAccount");
	Tobacco_0.Columns.Add("CostItem");
	For Each LineOther In Tobacco_0 Do
		If ValueIsFilled(LineOther.Department) Then
			StructureDivision = New Structure();
			UnloadDivision(IBData, StructureDivision, LineOther.Department);
			LineOther.CostDivision = StructureDivision.Department;
		EndIf;
	
		CostAccount = AccountingInvoiceForArticle(LineOther.ExpenseItem, IBData.Organization, LineOther.Department, IBData.Date);
	
		If TypeOf(LineOther.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
			LineOther.CostItem = LineOther.ExpenseItem;
			If ThisIsUT() 
				And ValueIsFilled(LineOther.CashFlowItem) Then
				DDSCostAccount = TrimAll(Common.ObjectAttributeValue(LineOther.CashFlowItem, 
											"OffsettingAccount"));
				If ValueIsFilled(DDSCostAccount) Then
					CostAccount = DDSCostAccount;
				EndIf;
			EndIf;
		EndIf;
		LineOther.CostAccount = CostAccount;
	EndDo;  
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Tobacco_0, False);
	EndIf;
	XDTOData.Insert("OtherExpenses", Tobacco_0);
	
	TabPaymentToSuppliers = QueryResults[4].Unload(); 
	// Filling out the contract
	TabPaymentToSuppliers.Columns.Add("Contract");
	For Each TableRow In TabPaymentToSuppliers Do
		CurTreaty = Undefined;
		CalculationsInConventionalUnits = False;
		Terms = Undefined;
		If ValueIsFilled(TableRow.OrderDocument) Then
			If TypeOf(TableRow.OrderDocument) = Type("CatalogRef.CounterpartyContracts") Then
				CurTreaty = TableRow.OrderDocument;
			EndIf;
				
			If CurTreaty = Undefined Then
				If TableRow.OrderDocument.Metadata().Attributes.Find("Contract") <> Undefined Then
					CurTreaty = Common.ObjectAttributeValue(TableRow.OrderDocument, "Contract");
				Else
					// The contract could not be determined from the order. The contract will be calculated later.
					CurTreaty = Undefined;
				EndIf;
				If TableRow.OrderDocument.Metadata().Attributes.Find("Terms") <> Undefined Then
					Terms = Common.ObjectAttributeValue(TableRow.OrderDocument, "Terms");
				Else
					// The agreement could not be determined from the order. The agreement will be calculated later.
					Terms = Undefined;
				EndIf;
			EndIf;
		EndIf;
		If CurTreaty <> Undefined And ValueIsFilled(CurTreaty) Then
			TableRow.Contract = CurTreaty;
			Continue;
		EndIf;
		If ValueIsFilled(Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> TableRow.ARAPCurrency;
		EndIf;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.TypeOfAgreement = "WithVendor";
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.Counterparty = TableRow.Counterparty;
		DefaultParameters.ARAPCurrency = TableRow.ARAPCurrency;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		TableRow.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, TableRow.OrderDocument, IBData);
	EndDo;
	XDTOData.Insert("PaymentToVendors", TabPaymentToSuppliers);
	XDTOData.Insert("AmountIncludesVAT", True);
	XDTOData.Insert("Sum", Tobacco_0.Total("Sum") + TabPaymentToSuppliers.Total("Sum"));
EndProcedure

