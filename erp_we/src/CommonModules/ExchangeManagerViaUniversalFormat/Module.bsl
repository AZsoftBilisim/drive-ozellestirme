Procedure UploadYourBankingDetailsHistory(IBData, XDTOData, ExchangeComponents)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then 
		
		Return;
		
	EndIf;
	
	Query = New Query;
	
	Query.SetParameter("Ref", IBData.Ref);
	
	If TypeOf(IBData) = Type("CatalogObject.Companies") Then
		
		Query.Text =
		"SELECT
		|	CompaniesNameHistory.LineNumber AS LineNumber,
		|	CASE
		|		WHEN CompaniesNameHistory.Period = DATETIME(1, 1, 1)
		|			THEN DATETIME(1980, 1, 1)
		|		ELSE CompaniesNameHistory.Period
		|	END AS StartDate,
		|	CompaniesNameHistory.DescriptionInternational AS DescriptionInternational,
		|	CompaniesNameHistory.AbbreviatedDescription AS AbbreviatedDescription,
		|	CompaniesNameHistory.DescriptionFull AS DescriptionFull
		|FROM
		|	Catalog.Companies.NameHistory AS CompaniesNameHistory
		|WHERE
		|	CompaniesNameHistory.Ref = &Ref
		|
		|ORDER BY
		|	StartDate";
	
	Result = Query.Execute();
	
	If Not Result.IsEmpty() Then
		
		XDTOData.Insert("NameHistory", Result.Unload())
		
	EndIf;
	
	ElsIf  TypeOf(IBData) = Type("CatalogObject.Counterparties") Then
		
		Query.Text = 
		"SELECT
		|	CounterpartiesCRTRHistory.LineNumber AS LineNumber,
		|	CASE
		|		WHEN CounterpartiesCRTRHistory.Period = DATETIME(1, 1, 1)
		|			THEN DATETIME(1980, 1, 1)
		|		ELSE CounterpartiesCRTRHistory.Period
		|	END AS StartDate,
		|	CounterpartiesCRTRHistory.CRTR AS CRTR
		|FROM
		|	Catalog.Counterparties.CRTRHistory AS CounterpartiesCRTRHistory
		|WHERE
		|	CounterpartiesCRTRHistory.Ref = &Ref
		|
		|ORDER BY
		|	StartDate
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CounterpartiesNameHistory.LineNumber AS LineNumber,
		|	CASE
		|		WHEN CounterpartiesNameHistory.Period = DATETIME(1, 1, 1)
		|			THEN DATETIME(1980, 1, 1)
		|		ELSE CounterpartiesNameHistory.Period
		|	END AS StartDate,
		|	CounterpartiesNameHistory.NameAbbreviated AS DescriptionFull
		|FROM
		|	Catalog.Counterparties.NameHistory AS CounterpartiesNameHistory
		|WHERE
		|	CounterpartiesNameHistory.Ref = &Ref
		|
		|ORDER BY
		|	StartDate";
		
		Results = Query.ExecuteBatch();
		
		QueryResultCheckpointHistory = Results[0];
		
		If Not QueryResultCheckpointHistory.IsEmpty() Then
			
			XDTOData.Insert("CRTRHistory", QueryResultCheckpointHistory.Unload()) ;
			
		EndIf;
		
		QueryResultNameHistory = Results[1];
		
		If Not QueryResultNameHistory.IsEmpty() Then
			
			XDTOData.Insert("NameHistory", QueryResultNameHistory.Unload()) ;
			
		EndIf;
		
	EndIf;
EndProcedure
