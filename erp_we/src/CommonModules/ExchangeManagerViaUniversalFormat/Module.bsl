Function CashRegisterCashRegisterFiscalDevice(Object)
	FiscalDevice = Undefined;
	CashRegister             = Undefined;
	
	If TypeOf(Object) = Type("CatalogRef.CashRegisters") Then
		
		CashRegister = Object;
		
		Query = New Query(
		"SELECT TOP 1
		|	CashRegisters.Peripherals AS FiscalDevice,
		|	CASE
		|		WHEN CashRegisters.Ref.Workplace = &Workplace
		|			THEN 1
		|		ELSE 2
		|	END AS Priority
		|FROM
		|	Catalog.CWPSettings.CashRegisters AS CashRegisters
		|WHERE
		|	CashRegisters.CashRegister = &CashRegister
		|	AND NOT CashRegisters.UseWithoutConnectingPeripherals
		|
		|ORDER BY
		|	Priority");
		
		Query.SetParameter("CashRegister",     CashRegister);
		Query.SetParameter("Workplace", EquipmentManagerServerCall.GetClientSWorkplace());
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then	
			FiscalDevice = Selection.FiscalDevice;
		EndIf;
		
	Else
		
		FiscalDevice = Object;
		
		Query = New Query(
		"SELECT TOP 1
		|	CashRegisters.CashRegister AS CashRegister,
		|	CASE
		|		WHEN CashRegisters.Ref.Workplace = &Workplace
		|			THEN 1
		|		ELSE 2
		|	END AS Priority
		|FROM
		|	Catalog.CWPSettings.CashRegisters AS CashRegisters
		|WHERE
		|	CashRegisters.Peripherals = &FiscalDevice
		|
		|ORDER BY
		|	Priority");
	
		Query.SetParameter("FiscalDevice", FiscalDevice);
		Query.SetParameter("Workplace",         EquipmentManagerServerCall.GetClientSWorkplace());
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then	
			CashRegister = Selection.CashRegister;
		EndIf;
		
	EndIf;
	
	ReturnValue = New Structure;
	ReturnValue.Insert("FiscalDevice", FiscalDevice);
	ReturnValue.Insert("CashRegister",             CashRegister);
	
	Return ReturnValue;
EndFunction
Function DefaultCheckout(FilterParameters, ExchangeComponents)
	Currency = FilterParameters.Currency;
	Organization = FilterParameters.Organization;
	Department = FilterParameters.Department;
	
	YouMustCreateElement = False;
	
	If Common.RefExists(Organization) And Common.RefExists(Currency) Then
		NameOfItemToExchangeByDefault = TrimAll(Organization) + " (" + TrimAll(Currency) + ")";
	Else
		NameOfItemToExchangeByDefault = NStr("vi = 'Quỹ tiền mặt chính';
											|ru = 'Основная касса';
											|en = 'Main cash account'; fa = 'صندوق اصلی';
											|it = 'Cassa perincipale';
											|pl = 'Kasa podstawowa';
											|tr = 'Ana kasa hesabı'");
	EndIf;
	
	DepartmentList = New ValueList();
	DepartmentList.Add(Catalogs.BusinessStructure.EmptyRef());
	DepartmentList.Add(Department);
	
	Query = New Query("SELECT TOP 2
		|	CashAccounts.Ref AS CashAccount,
		|	CASE
		|		WHEN CashAccounts.Description = &NameOfItemToExchangeByDefault
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ThisIsDefaultItemForSharing,
		|	CashAccounts.Department AS Department
		|FROM
		|	Catalog.CashAccounts AS CashAccounts
		|WHERE
		|	NOT CashAccounts.DeletionMark
		|	AND CashAccounts.Owner = &Organization
		|	AND CashAccounts.CashCurrency = &Currency
		|	AND CashAccounts.Department IN(&DepartmentList)
		|
		|ORDER BY
		|	ThisIsDefaultItemForSharing DESC,
		|	Department DESC");
	
	Query.SetParameter("NameOfItemToExchangeByDefault", NameOfItemToExchangeByDefault);
	Query.SetParameter("Organization", Organization);
	Query.SetParameter("Currency", Currency);
	Query.SetParameter("DepartmentList", DepartmentList);
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		If Selection.Count() = 1 Or Selection.ThisIsDefaultItemForSharing Then
			CashAccount = Selection.CashAccount;
		Else
			YouMustCreateElement = True;
		EndIf;
	Else
		YouMustCreateElement = True;
	EndIf;
	
	// Creating an item to exchange with the specified parameters
	If YouMustCreateElement Then
		CashRegisterObject = Catalogs.CashAccounts.CreateItem();
		CashRegisterObject.Description			= NameOfItemToExchangeByDefault;
		CashRegisterObject.CashCurrency	= Currency;
		CashRegisterObject.Owner				= Organization;
		CashRegisterObject.Department			= Department;	
		Try
			CashRegisterObject.Write();
			CashAccount = CashRegisterObject.Ref;
		Except
			CashAccount = Catalogs.CashAccounts.EmptyRef();
			WriteErrorToEventLog(CashAccount,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents);
		EndTry
	EndIf;
		
	Return CashAccount;
EndFunction
Function CounterpartyFromOrganization(Val OrganizationForCreatingCounterparty, ExchangeComponents)
	// Let's check if there is a counterparty created by the organization in the database, if not, then we will create it and upload it.
	LinkToCounterparty = Catalogs.Counterparties.GetRef(OrganizationForCreatingCounterparty.UUID());
	If Not Common.RefExists(LinkToCounterparty) Or LinkToCounterparty.GetObject() = Undefined Then
		
		RequestCounter = New Query;
		RequestCounter.Text = "SELECT TOP 1 Ref
		|FROM Catalog.Counterparties
		|WHERE Description = &Description 
		|	AND TIN = &TIN
		|	AND CRTR = &CRTR
		|	AND CompanyIndividual = &CompanyIndividual";
		RequestCounter.SetParameter("Description", OrganizationForCreatingCounterparty.Description);
		RequestCounter.SetParameter("TIN", OrganizationForCreatingCounterparty.TIN);
		RequestCounter.SetParameter("CRTR", OrganizationForCreatingCounterparty.CRTR);
		RequestCounter.SetParameter("CompanyIndividual", OrganizationForCreatingCounterparty.CompanyIndividual);
		Selection = RequestCounter.Execute().Select();
		If Selection.Next() Then
			LinkToCounterparty = Selection.Ref;
			Return LinkToCounterparty;
		EndIf;
		
		CounterpartyBeingCreated = Catalogs.Counterparties.CreateItem();
		FillPropertyValues(CounterpartyBeingCreated, OrganizationForCreatingCounterparty,
			"DeletionMark,TIN,NCBOCode,CRTR,DescriptionFull,LegalEntityIndividual,Description,BranchOffice");
		
		If CounterpartyBeingCreated.LegalEntityIndividual = Enums.LegalEntityIndividual.IndividualEntrepreneur
			Or CounterpartyBeingCreated.LegalEntityIndividual = Enums.LegalEntityIndividual.Person Then
			
			CounterpartyBeingCreated.CompanyIndividual = Enums.CompanyIndividual.Individual;
			
		ElsIf CounterpartyBeingCreated.LegalEntityIndividual = Enums.LegalEntityIndividual.Entity
			Or CounterpartyBeingCreated.LegalEntityIndividual = Enums.LegalEntityIndividual.LegalEntityNonResident Then
			
			CounterpartyBeingCreated.CompanyIndividual = Enums.CompanyIndividual.BusinessEntity;
			
		EndIf;
		
		If CounterpartyBeingCreated.BranchOffice Then
			OrganizationForCreatingCounterparty = OrganizationForCreatingCounterparty.ParentCompany;
			MainCounterparty = CounterpartyFromOrganization(OrganizationForCreatingCounterparty, ExchangeComponents);
			CounterpartyBeingCreated.MainCounterparty = MainCounterparty;
		Else
			CounterpartyBeingCreated.MainCounterparty = LinkToCounterparty;
		EndIf;
		
		PartnerObject_ = Catalogs.Partners.CreateItem();
		SynchronizePartnerDataWithCounterpartyData(PartnerObject_, CounterpartyBeingCreated, ExchangeComponents);
		CounterpartyBeingCreated.Partner = PartnerObject_.Ref;
		
		CounterpartyBeingCreated.SetNewObjectRef(LinkToCounterparty);
		CounterpartyBeingCreated.DataExchange.Load = True;
		CounterpartyBeingCreated.Write();
		
		CreatedOnExportObjects = ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects; // Array
		CreatedOnExportObjects.Add(CounterpartyBeingCreated.Ref);
		
		LinkToCounterparty = CounterpartyBeingCreated.Ref;
	EndIf;
	Return LinkToCounterparty;
EndFunction
Function CounterpartyFromPartner(Val Partner, ExchangeComponents)
	// Let's check if there is a counterparty created by a partner in the database, if not, then we will create it and upload it.
	LinkToCounterparty = Catalogs.Counterparties.GetRef(Partner.UUID());
	If Not Common.RefExists(LinkToCounterparty) Or LinkToCounterparty.GetObject() = Undefined Then
		
		RequestCounter = New Query;
		RequestCounter.Text = "SELECT TOP 1 Ref
		|FROM Catalog.Counterparties
		|WHERE Description = &Description 
		|	AND CompanyIndividual = &CompanyIndividual";
		
		PartnerData = Common.ObjectAttributesValues(Partner, "Description, DescriptionFull, LegalEntityIndividual");
		PartnerData.Insert("CompanyIndividual", ?(PartnerData.LegalEntityIndividual = Enums.IndividualCompany.Person_,
				Enums.CompanyIndividual.Individual,
				Enums.CompanyIndividual.BusinessEntity));
		
		RequestCounter.SetParameter("Description", PartnerData.Description);
		RequestCounter.SetParameter("CompanyIndividual", PartnerData.CompanyIndividual);
				
		Selection = RequestCounter.Execute().Select();
		If Selection.Next() Then
			LinkToCounterparty = Selection.Ref;
			Return LinkToCounterparty;
		EndIf;
		
		CounterpartyBeingCreated = Catalogs.Counterparties.CreateItem();
		FillPropertyValues(CounterpartyBeingCreated, PartnerData,
			"DescriptionFull, Description, CompanyIndividual");
			
		If CounterpartyBeingCreated.CompanyIndividual = Enums.CompanyIndividual.Individual Then
			
			CounterpartyBeingCreated.LegalEntityIndividual = Enums.LegalEntityIndividual.Person;
			
		Else
			
			CounterpartyBeingCreated.CompanyIndividual = Enums.LegalEntityIndividual.Entity;
			
		EndIf;
		
		CounterpartyBeingCreated.Partner = Partner;
		
		CounterpartyBeingCreated.SetNewObjectRef(LinkToCounterparty);
		CounterpartyBeingCreated.DataExchange.Load = True;
		CounterpartyBeingCreated.Write();
		
		ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects.Add(CounterpartyBeingCreated.Ref);
		
		LinkToCounterparty = CounterpartyBeingCreated.Ref;
	EndIf;
	Return LinkToCounterparty;
EndFunction
Procedure Merzhevanie_PBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData = Undefined Then
		Return;
	EndIf;
	
	IB_CounterpartyDataBeforeChange = IBData.Counterparty;
	
	#Region Header
	AdditionalProperties = ReceivedData.AdditionalProperties;
		
	If TypeOf(ReceivedData) = Type("DocumentObject.BankAccountReceiptNote") Then
	     If AdditionalProperties.Property("Contract") Then
		      ReceivedData.Contract = AdditionalProperties.Contract;
		 EndIf;
	EndIf;
	// Filling in the counterparty, if it is not filled in.
	If Not ValueIsFilled(ReceivedData.Counterparty) Then
		If ValueIsFilled(IBData.Counterparty) Then
			ReceivedData.Counterparty = IBData.Counterparty;
		Else
			FillInAllOurEnterprise(ReceivedData, ExchangeComponents.ConversionParameters_SSLy);
		EndIf;
	EndIf;
	
	// During intercampany operations, some details of the IB object have a higher priority.
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany Then
		FillPropertyValues(ReceivedData, IBData,
			"Counterparty,CounterpartyBankAccount,BusinessOperation");
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromLessor Then
		FillPropertyValues(ReceivedData, IBData,
		"Counterparty,CounterpartyBankAccount,BusinessOperation");
	EndIf;
	
	// Replacing the properties that we got from the XDTO.
	FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
	#EndRegion
	
	#Region ARAPDetails
	
	// Getting the decryption of the payment.
	PaymentDecryptionSource = ReceivedData.ARAPDetails;
	PaymentDecryptionReceiver = IBData.ARAPDetails;
	
	If PaymentDecryptionSource.Count() = PaymentDecryptionReceiver.Count() Then
		
		For RowIndex = 0 To PaymentDecryptionSource.Count() - 1 Do
			
			SourceRow = PaymentDecryptionSource[RowIndex];
			DestinationRow = PaymentDecryptionReceiver[RowIndex];
			
			FillPropertyValues(DestinationRow, SourceRow,
				"Sum,
				|AmountARAP,
				|ARAPCurrency");
				
			If ValueIsFilled(SourceRow.IncomeItem) Then
				DestinationRow.IncomeItem = SourceRow.IncomeItem;
			EndIf;
					
			If ValueIsFilled(SourceRow.CashFlowItem) Then
				DestinationRow.CashFlowItem = SourceRow.CashFlowItem;
			EndIf;
			
			If ValueIsFilled(SourceRow.Department) Then
				DestinationRow.Department = SourceRow.Department;
			EndIf;
				
			// Changing the counterparty updates the analytics dependent on it.
			If IBData.Counterparty <> IB_CounterpartyDataBeforeChange Then
				FillPropertyValues(DestinationRow, SourceRow,
					"Partner");
			EndIf;
		EndDo;
		
	Else
		IBData.ARAPDetails.Load(ReceivedData.ARAPDetails.Unload());
	EndIf;
	
	#EndRegion
EndProcedure
