	ProcessingRule.OnProcess            = "DPR_Document_IncomeAdjustment_Send_OnProcess";
	ProcessingRule.DataClearing           = True;
	ProcessingRule.OCRUsed.Add("Document_ReceiptAdjustment_Registration");
	ProcessingRule.OCRUsed.Add("Document_IncomeAdjustment_Sending");
	ProcessingRule.OCRUsed.Add("Document_RevenueAdjustment_InventoryWriteOff");
	ProcessingRule.OCRUsed.Add("Document_PurchaseAdjustment_Debt");
EndProcedure
Procedure DPR_Document_IncomeAdjustment_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	If IBData.BusinessOperation = Enums.BusinessTransactions.AdjustmentOfAcquisitionIncreaseInDebtConsolidated
		Or IBData.BusinessOperation = Enums.BusinessTransactions.AcquisitionAdjustmentDebtReductionConsolidated
		Or IBData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentOfAcquisitionIncreaseInDebtConsolidated
		Or IBData.AdjustmentKind = Enums.BusinessTransactions.AcquisitionAdjustmentDebtReductionConsolidated Then
		UsageOCR.Document_PurchaseAdjustment_Debt = True;
		Return;
	EndIf;
	
	If Not IBData = Undefined And ValueIsFilled(IBData.Ref) And IBData.AdjustingEntryType = PredefinedValue("Enum.AdjustingEntryTypes.AdjustmentByGoodsAndServices") Then
		Return
	ElsIf ValueIsFilled(IBData.DocumentBasis) And TypeOf(IBData.DocumentBasis) = Type("DocumentRef.SourceDocument")
		And Common.ObjectAttributesValues(IBData.DocumentBasis, "SourceDocumentType").SourceDocumentType = Enums.SourceDocumentTypes.PurchaseFromVendor Then
		Return
	EndIf;	
	If Not IBData = Undefined And ValueIsFilled(IBData.Ref)
	 	And TypeOf(IBData.Ref.DocumentBasis) = Type("DocumentRef.SubcontractorReport2_5") Then 
	 	Return;
	EndIf; 	
	UsageOCR.Document_IncomeAdjustment_Sending = True;
	
	If IBData.Discrepancies.Count() = 0 Then
		Return;
	EndIf;
	
	// Write-off, Registration
	QueryText =
	"SELECT
	|	Doc.Products AS Products,
	|	Doc.Characteristic AS Characteristic,
	|	CASE
	|		WHEN Doc.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN CAST(""CommissionGoods"" AS STRING(20))
	|		ELSE CAST(&OwnProducts AS STRING(20))
	|	END AS InventoryType,
	|	SUM(Doc.Count) AS Count,
	|	SUM(Doc.QuantityByGBRN) AS QuantityByGBRN,
	|	SUM(Doc.AmountIncludingVAT - Doc.VATAmount) AS Sum,
	|	Doc.CCDNumber AS CCDNumber,
	|	Doc.Series AS Series,
	|	Doc.Package AS Package,
	|	Doc.NumberOfPackages AS NumberOfPackages
	|INTO NoQuantitativeDiscrepancies
	|FROM
	|	Document.PurchaseAdjustment.Discrepancies AS Doc
	|WHERE
	|	Doc.Ref = &IncomeAdjustment
	|	AND (Doc.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|			OR Doc.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND NOT ISNULL(CAST(Doc.Ref.DocumentBasis AS Document.VendorInvoice).ToReturnReusablePackage, FALSE))
	|	AND Doc.PostingOption IN (VALUE(Enum.OptionsOfPostingReceiptAdjustingEntries.RecordInOtherIncome), VALUE(Enum.OptionsOfPostingReceiptAdjustingEntries.ToExpenseAs))
	|
	|GROUP BY
	|	Doc.Products,
	|	Doc.Characteristic,
	|	Doc.CCDNumber,
	|	CASE
	|		WHEN Doc.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN CAST(""CommissionGoods"" AS STRING(20))
	|		ELSE CAST(&OwnProducts AS STRING(20))
	|	END,
	|	Doc.Series,
	|	Doc.Package,
	|	Doc.NumberOfPackages
	|
	|INDEX BY
	|	Count
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products AS Products,
	|	&QueryTextCharacteristic,
	|	&QueryTextSeries,
	|	&QueryTextPackage,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	Goods.InventoryType AS InventoryType,
	|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
	|	Goods.Count AS Count,
	|	Goods.Sum AS Sum,
	|	CAST(0 AS NUMBER(31, 2)) AS Price
	|FROM
	|	NoQuantitativeDiscrepancies AS Goods
	|WHERE
	|	Goods.Count > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Products AS Products,
	|	&QueryTextCharacteristic,
	|	&QueryTextSeries,
	|	&QueryTextPackage,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	Goods.InventoryType AS InventoryType,
	|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
	|	-Goods.Count AS Count,
	|	-Goods.Sum AS Sum,
	|	CAST(0 AS NUMBER(31, 2)) AS Price
	|FROM
	|	NoQuantitativeDiscrepancies AS Goods
	|WHERE
	|	Goods.Count < 0";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "Goods"));
	
	Query = New Query(QueryText);
	Query.SetParameter("IncomeAdjustment", IBData.Ref);
	
	QueryResult = Query.ExecuteBatch();
	
	ItemsToBeWrittenOffInAccounting      = QueryResult[1].Unload();
	GoodsToBeRegisteredInAccounting = QueryResult[2].Unload();
	
	If ItemsToBeWrittenOffInAccounting.Count() > 0 Then
		FillInCharacteristicsOfWHPackage(ExchangeComponents, ItemsToBeWrittenOffInAccounting);
		FillInPriceWriteOffReEntry(ItemsToBeWrittenOffInAccounting, ExchangeComponents);
		
		UsageOCR.Document_RevenueAdjustment_InventoryWriteOff = True;
		IBData.AdditionalProperties.Insert("GoodsToWriteOff", ItemsToBeWrittenOffInAccounting);
	EndIf;
	
	If GoodsToBeRegisteredInAccounting.Count() > 0 Then
		FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsToBeRegisteredInAccounting);
		FillInPriceWriteOffReEntry(GoodsToBeRegisteredInAccounting, ExchangeComponents);
		    	
		If Not ValueIsFilled(IBData.DocumentBasis) Then
		    VATActivityType = Undefined;
		ElsIf TypeOf(IBData.DocumentBasis) = Type("DocumentRef.SourceDocument") Then
			VATActivityType = IBData.DocumentBasis.VATTaxation;
		Else	
			VATActivityType = Common.ObjectAttributeValue(IBData.DocumentBasis, "PurchaseForActivity");
	    EndIf;
		GoodsToBeRegisteredInAccounting.Columns.Add("ActivityRegistration");
		GoodsToBeRegisteredInAccounting.FillValues(VATActivityType, "ActivityRegistration");
			
		UsageOCR.Document_ReceiptAdjustment_Registration = True;
		IBData.AdditionalProperties.Insert("GoodsToRecordAsReceived", GoodsToBeRegisteredInAccounting);
	EndIf;
EndProcedure

