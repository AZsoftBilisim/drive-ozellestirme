Procedure FillInDeadlineForReturningCashWhenIssuingItToAccountablePerson(ReceivedData, IBData)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	If DataToWriteToIB.BusinessOperation <> Enums.BusinessTransactions.IssueCashToAdvanceHolder Then
		Return;
	EndIf;
	// If the deadline is not specified, it is filled in as with interactive input: by default, "In a week".
	If Not ValueIsFilled(DataToWriteToIB.ExpenseReportDate) Then
		DataToWriteToIB.ExpenseReportDate = DataToWriteToIB.Date + 7 * 24 * 3600;
	EndIf;
EndProcedure
Procedure FillInBidOfNDSInText(Text, PathToNomenclature, FormatVersionIs17AndHigher)
	// Replacing the table
	TextOfRequestForVATRateTable = 
	"SELECT
	|	WorldCountries.Ref AS Country
	|FROM   
	|	Catalog.WorldCountries AS WorldCountries
	|		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(
	|				&Period,
	|				Country = &RegistrationCountry
	|					OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS ProductsVATRates
	|		ON &Products = ProductsVATRates.Products
	|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&Period, Country = &RegistrationCountry) AS BasicVATRates
	|		ON (TRUE)";
	
	TextOfRequestForVATRateTable = StrReplace(TextOfRequestForVATRateTable, "SELECT
	|	WorldCountries.Ref AS Country
	|FROM   
	|	Catalog.WorldCountries AS WorldCountries
	|", "");
	  	TextOfRequestForVATRateTable = StrReplace(TextOfRequestForVATRateTable, "&Products", PathToNomenclature);
	
	Text = StrReplace(Text, "#TablesVATRate", TextOfRequestForVATRateTable);
	
	QueryTextVATRate = StrReplace(QueryTextVATRate, "&VATRate",
		"(ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef))))");
	
	// Replacing a field  
	If FormatVersionIs17AndHigher Then
		QueryTextVATRate = "&VATRate";
	Else
		QueryTextVATRate = "CASE
		|	WHEN &VATRate = VALUE(Catalog.VATRates.EXCLUDINGVAT)
		|		THEN ""EXCLUDINGVAT""
		|	WHEN &VATRate.CalculatedRate
		|		THEN CASE
		|				WHEN &VATRate.Rate1 = 10
		|					THEN ""VAT10_110""
		|				WHEN &VATRate.Rate1 = 18
		|					THEN ""VAT18_118""
		|				WHEN &VATRate.Rate1 = 20
		|					THEN ""VAT20_120""
		|			END
		|	ELSE CASE
		|			WHEN &VATRate.Rate1 = 0
		|				THEN ""VAT0""
		|			WHEN &VATRate.Rate1 = 10
		|				THEN ""VAT10""
		|			WHEN &VATRate.Rate1 = 18
		|				THEN ""VAT18""
		|			WHEN &VATRate.Rate1 = 20
		|				THEN ""VAT20""
		|		END
		|END";
		
	EndIf;
	QueryTextVATRate = StrReplace(QueryTextVATRate, "&VATRate",
		"(ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef))))");
		
	If Not FormatVersionIs17AndHigher Then
	
	EndIf;
	
	Text = StrReplace(Text, "&VATRate", QueryTextVATRate);
EndProcedure
Procedure FillInStatusesForSpecifyingSeries(Object, ExchangeComponents)
	FullObjectName  = Object.Metadata().FullName();
	ManagerOfDocument = Common.ObjectManagerByFullName(FullObjectName);
	
	SeriesSpecificationParameters = New FixedStructure(ProductsServer.SeriesSpecificationParameters(Object, ManagerOfDocument));
	
	If FullObjectName = "Document.AssemblyFromComponents" Then
		NamesOfTS = "Header,TS";
	ElsIf FullObjectName = "Document.BackflushProduction" Then
		NamesOfTS = "ManufacturedProducts,SideAndIntermediateRelease,MaterialsAndWorks";
	ElsIf FullObjectName = "Document.SaleAdjustment" Then
		NamesOfTS = "Goods";
	Else
		NamesOfTS = "";	
	EndIf;
	
	NamesArray = StrSplit(NamesOfTS, ",", True);
	For Each TSName In NamesArray Do
		If ValueIsFilled(TSName) Then
			TimeParameters = SeriesSpecificationParameters[TSName];
		Else
			TimeParameters = SeriesSpecificationParameters;
		EndIf;
		If ExchangeComponents.IsExchangeViaExchangePlan 
			And FPS3ConfigurationOption(ExchangeComponents.CorrespondentNode.SettingsMode) Then 
			Continue
		Else	
			FillInTypeOfProductForVHFSeries(Object, TimeParameters, ExchangeComponents, FullObjectName);
			ProductsServer.FillInStatusesForSpecifyingSeries(Object, TimeParameters);
			TransferSeriesWHSeries(Object, TimeParameters, ExchangeComponents);
			// A repeated call to indicate Statuses is necessary to correctly indicate the Status within the policy,
			// because the correct calculation of the coincidence of the quantity by series with the quantity of goods is possible only
			// after filling in both tabular parts. See ProductsServer.FillInStatusesForSpecifyingSeries
			ProductsServer.FillInStatusesForSpecifyingSeries(Object, TimeParameters);
			ProductsServer.ClearUnusedSeries(Object, TimeParameters);
		EndIf;
	EndDo;
EndProcedure
