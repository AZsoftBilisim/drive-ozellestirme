	|	SUM(Goods.AmountIncludingVAT) AS AmountIncludingVAT,
	|	SUM(Goods.VATAmount) AS VATAmount,
	|	"""" AS AdjustingEntryType,
	|	Goods.ItemsLocationAttributes.Products.ItemsType AS ItemsType
	|INTO InvoiceBasisGoods
	|	FROM
