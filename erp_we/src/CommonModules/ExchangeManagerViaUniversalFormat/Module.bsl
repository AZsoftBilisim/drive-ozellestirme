Procedure PCO_Document_PCOOtherReceipt_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "CashAccount");
	UploadResponsiblePerson(ExchangeComponents, IBData, XDTOData, "ChiefAccountant");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	TabDecryption = New ValueTable;
	TabDecryption.Columns.Add("CFItem");
	TabDecryption.Columns.Add("Sum");
	TabDecryption.Columns.Add("Account_Settlement");
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashCollectionFromBank Then
		// The operation is converted according to this rule only when using the format "1.0.beta" and "1.0".
		NewRow = TabDecryption.Add();
		NewRow.CFItem         = IBData.CashFlowItem;
		NewRow.Sum             = IBData.DocumentAmount;
		If GetFunctionalOption("LocalizationRFService") Then
			NewRow.Account_Settlement = "57.01";
		Else
			NewRow.Account_Settlement = AccountForSettlementsOfOtherDDSOperations(New Structure("CFItem",IBData.CashFlowItem));
		EndIf;
	Else
		// The document is unloaded from the household. the operation "Other cash flow", 
		// in the tabular part of which the income items are either not filled in,
		// or only the items of assets / liabilities are indicated in it.
		If IBData.ARAPDetails.Count() > 0 Then
			For Each String In IBData.ARAPDetails Do
				SettlementAccount_ = "";
				If ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed Then
					SettlementAccount_ = AccountForSettlementsOfOtherDDSOperations(New Structure("CFItem",String.CashFlowItem));
				EndIf;
	
				NewRow = TabDecryption.Add();
				NewRow.CFItem         = String.CashFlowItem;
				NewRow.Sum             = String.Sum;
				NewRow.Account_Settlement = SettlementAccount_;
			EndDo;
		EndIf;
	EndIf;
	
	XDTOData.Insert("ARAPDetails", TabDecryption);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.20") Then
		XDTOData.Insert("OperationKind", "Other");
	EndIf;
EndProcedure

