Procedure OCR_Document_LoanAndDepositInterestCharge_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.LoansInterestCharge Then
		XDTOData.Insert("OperationKind", "LoansReceived_");
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.DepositInterestCharge Then
		XDTOData.Insert("OperationKind", "Deposits");
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.IssuedBorrowingsInterestCharge Then
		XDTOData.Insert("OperationKind", "LoansReceived");
	EndIf;
	
	Query = New Query("SELECT
		|	DocumentAccrualTable.LineNumber AS LineNumber,
		|	MAX(ExchangeRates.Period) AS Period
		|INTO ExchangeRatePeriods
		|FROM
		|	Document.LoanAndDepositInterestCharge.Accruals AS DocumentAccrualTable
		|		LEFT JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
		|		ON DocumentAccrualTable.Date >= ExchangeRates.Period
		|			AND DocumentAccrualTable.ARAPCurrency = ExchangeRates.Currency
		|			AND ExchangeRates.BaseCurrency = &ComplAccountingCurrency
		|WHERE
		|	DocumentAccrualTable.Ref = &Ref
		|
		|GROUP BY
		|	DocumentAccrualTable.LineNumber
		|
		|INDEX BY
		|	LineNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CASE
		|		WHEN &ThisIsWE 
		|			THEN """"
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.LoansInterestCharge)
		|			THEN CASE
		|					WHEN DocumentAccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Fee)
		|						THEN CASE
		|								WHEN DocumentAccrualTable.ARAPCurrency = &ComplAccountingCurrency
		|									THEN ""76.09""
		|								ELSE ""76.29""
		|							END
		|					WHEN DocumentAccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Interests)
		|						THEN CASE
		|								WHEN DocumentAccrualTable.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|									THEN CASE
		|											WHEN DocumentAccrualTable.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
		|												THEN CASE
		|														WHEN DocumentAccrualTable.ARAPCurrency = &ComplAccountingCurrency
		|															THEN ""66.02""
		|														ELSE ""66.22""
		|													END
		|											WHEN DocumentAccrualTable.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|												THEN CASE
		|														WHEN DocumentAccrualTable.ARAPCurrency = &ComplAccountingCurrency
		|															THEN ""67.02""
		|														ELSE ""67.22""
		|													END
		|										END
		|								WHEN DocumentAccrualTable.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit)
		|										OR DocumentAccrualTable.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
		|										OR DocumentAccrualTable.Contract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
		|									THEN CASE
		|											WHEN DocumentAccrualTable.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
		|												THEN CASE
		|														WHEN DocumentAccrualTable.ARAPCurrency = &ComplAccountingCurrency
		|															THEN ""66.04""
		|														ELSE ""66.24""
		|													END
		|											WHEN DocumentAccrualTable.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|												THEN CASE
		|														WHEN DocumentAccrualTable.ARAPCurrency = &ComplAccountingCurrency
		|															THEN ""67.04""
		|														ELSE ""67.24""
		|													END
		|										END
		|							END
		|				END
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.IssuedBorrowingsInterestCharge)
		|				OR Document.BusinessOperation = VALUE(Enum.BusinessTransactions.DepositInterestCharge)
		|			THEN ""91.01""
		|	END AS CtScoreIsCalculated,
		|	CASE
		|		WHEN &ThisIsWE 
		|			THEN """"
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.LoansInterestCharge)
		|			THEN ""91.02""
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.IssuedBorrowingsInterestCharge)
		|			THEN ""76.09""
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.DepositInterestCharge)
		|			THEN CASE
		|					WHEN DocumentAccrualTable.ARAPCurrency = &ComplAccountingCurrency
		|						THEN ""55.03""
		|					ELSE ""55.23""
		|				END
		|	END AS DtCalculationAccount,
		|	CASE
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.LoansInterestCharge)
		|			THEN CASE
		|					WHEN DocumentAccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Fee)
		|						THEN DocumentAccrualTable.Contract.CashFlowItemOfFeePayment.OffsettingAccount
		|					WHEN DocumentAccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Interests)
		|						THEN DocumentAccrualTable.Contract.CashFlowItemOfInterestPayment.OffsettingAccount
		|				END
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.IssuedBorrowingsInterestCharge)
		|				OR Document.BusinessOperation = VALUE(Enum.BusinessTransactions.DepositInterestCharge)
		|			THEN ""91.01""
		|	END AS CrInvoiceUnderAgreement,
		|	CASE
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.LoansInterestCharge)
		|			THEN ""91.02""
		|		WHEN Document.BusinessOperation = VALUE(Enum.BusinessTransactions.IssuedBorrowingsInterestCharge)
		|				OR Document.BusinessOperation = VALUE(Enum.BusinessTransactions.DepositInterestCharge)
		|			THEN CASE
		|					WHEN DocumentAccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Fee)
		|						THEN DocumentAccrualTable.Contract.CashFlowItemOfFeePayment.OffsettingAccount
		|					WHEN DocumentAccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Interests)
		|						THEN DocumentAccrualTable.Contract.CashFlowItemOfInterestPayment.OffsettingAccount
		|				END
		|	END AS DrInvoiceUnderAgreement,
		|	Document.Date AS Date,
		|	DocumentAccrualTable.Counterparty AS Counterparty,
		|	DocumentAccrualTable.Contract AS Contract,
		|	DocumentAccrualTable.AmountARAP AS Sum,
		|	DocumentAccrualTable.AmountARAP AS AmountARAP,
		|	DocumentAccrualTable.ARAPCurrency AS ARAPCurrency,
		|	DocumentAccrualTable.ScheduleAmountType AS ScheduleAmountType,
		|	CASE
		|		WHEN DocumentAccrualTable.Contract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|			THEN ""LongTerm""
		|		ELSE ""ShortTerm""
		|	END AS UrgencyOfLoanLoan,
		|	CAST(DocumentAccrualTable.IncomeAndExpenseItem AS ChartOfCharacteristicTypes.IncomeItems) AS IncomeItem,
		|	CAST(DocumentAccrualTable.IncomeAndExpenseItem AS ChartOfCharacteristicTypes.ExpenseItems) AS ExpenseItem
		|INTO CalculatingAccountingAccount
		|FROM
		|	Document.LoanAndDepositInterestCharge AS Document
		|		LEFT JOIN Document.LoanAndDepositInterestCharge.Accruals AS DocumentAccrualTable
		|		ON Document.Ref = DocumentAccrualTable.Ref
		|			AND (Document.Ref = &Ref)
		|		LEFT JOIN ExchangeRatePeriods AS ExchangeRatePeriods
		|		ON (DocumentAccrualTable.LineNumber = ExchangeRatePeriods.LineNumber)
		|		LEFT JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
		|		ON (ExchangeRatePeriods.Period = ExchangeRates.Period)
		|			AND (DocumentAccrualTable.ARAPCurrency = ExchangeRates.Currency)
		|			AND (ExchangeRates.BaseCurrency = &ComplAccountingCurrency)
		|WHERE
		|	Document.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CASE
		|		WHEN AccrualTable.CrInvoiceUnderAgreement IS NULL
		|				OR AccrualTable.CrInvoiceUnderAgreement = """"
		|			THEN AccrualTable.CtScoreIsCalculated
		|		ELSE AccrualTable.CrInvoiceUnderAgreement
		|	END AS AccountCr,
		|	CASE
		|		WHEN AccrualTable.DrInvoiceUnderAgreement IS NULL
		|				OR AccrualTable.DrInvoiceUnderAgreement = """"
		|			THEN AccrualTable.DtCalculationAccount
		|		ELSE AccrualTable.DrInvoiceUnderAgreement
		|	END AS AccountDr,
		|	AccrualTable.Counterparty AS CounterpartyRef,
		|	AccrualTable.Contract AS Contract,
		|	CASE
		|		WHEN AccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Interests)
		|				OR AccrualTable.ScheduleAmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.PrincipalDebt)
		|			THEN ""Interests""
		|		ELSE ""Fee""
		|	END AS ScheduleAmountType,
		|	AccrualTable.Date AS Date,
		|	AccrualTable.ARAPCurrency AS ARAPCurrency,
		|	AccrualTable.Sum AS Sum,
		|	AccrualTable.AmountARAP AS AmountARAP,
		|	ISNULL(AccrualTable.IncomeItem, VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)) AS IncomeItem,
		|	ISNULL(AccrualTable.ExpenseItem, VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)) AS ExpenseItem
		|FROM
		|	CalculatingAccountingAccount AS AccrualTable");
	
	ThisIsWE = Not GetFunctionalOption("LocalizationRFService");
	
	Query.SetParameter("Ref",         IBData.Ref);
	Query.SetParameter("ComplAccountingCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	Query.SetParameter("ThisIsWE", ThisIsWE);
	
	AccrualTable = Query.Execute().Unload();
	AccrualTable.Columns.Add("Counterparty");
	
	For Each String In AccrualTable Do
		If ThisIsWE And Not ValueIsFilled(String.AccountDr) And ValueIsFilled(String.IncomeItem) Then
			String.AccountDr = Common.ObjectAttributeValue(String.IncomeItem, "OffsettingAccount");
		EndIf;
		If ThisIsWE And Not ValueIsFilled(String.AccountCr) And ValueIsFilled(String.ExpenseItem) Then
			String.AccountCr = Common.ObjectAttributeValue(String.ExpenseItem, "OffsettingAccount");
		EndIf;
		
		If ValueIsFilled(String.CounterpartyRef) Then
	
			If TypeOf(String.CounterpartyRef) = Type("CatalogRef.Counterparties") Then
				String.Counterparty = New Structure("Value, OCRName", String.CounterpartyRef, "Catalog_Counterparties");
			Else
				String.Counterparty = New Structure("Value, OCRName", String.CounterpartyRef, "Catalog_Persons_Send");
			EndIf;
		
		EndIf;
	EndDo;
	
	XDTOData.Insert("Accruals", AccrualTable);
EndProcedure

