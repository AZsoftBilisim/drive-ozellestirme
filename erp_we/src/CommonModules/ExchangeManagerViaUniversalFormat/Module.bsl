Procedure AddPOD_Catalog_ContractsBetweenOrganizations(DataProcessingRules)
	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Catalog_IntercompanyContracts";
	ProcessingRule.SelectionObjectMetadata = Metadata.Catalogs.IntercompanyContracts;
	ProcessingRule.OnProcess            = "DPR_Catalog_IntercompanyContracts_OnProcess";
	ProcessingRule.DataClearing           = False;
	ProcessingRule.OCRUsed.Add("Catalog_IntercompanyContracts");
EndProcedure
Procedure DPR_Catalog_IntercompanyContracts_OnProcess(IBData, UsageOCR, ExchangeComponents)
	RuleConsistsOfStructure = ExchangeComponents.DataProcessingRules.Find("Catalog_IntercompanyContracts", "Name");
	
	If RuleConsistsOfStructure = Undefined Then
		Return;
	EndIf;
	
	If ExchangeComponents.IsExchangeViaExchangePlan Then
		ListOfOrganizationsNode = ExchangeComponents.ConversionParameters_SSLy.Companies;
	Else
		ListOfOrganizationsNode = New ValueList();
	EndIf;
		
	If TypeOf(IBData) <> Type("Structure") Then
		
		If ListOfOrganizationsNode.FindByValue(IBData.Organization) = Undefined Then
			ClearUsageOCR(UsageOCR);
		EndIf;
		
		If ListOfOrganizationsNode.FindByValue(IBData.CompanyRecipient) <> Undefined Then
			ContractData = ContractDataBetweenOrganizations(ExchangeComponents, IBData);
			DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, ContractData, RuleConsistsOfStructure);
		EndIf;
		
	Else
		ClearUsageOCR(UsageOCR);
		UsageOCR.Insert("Catalog_ContractsOfCounterparties_FromStructure", True);
	EndIf;
EndProcedure

