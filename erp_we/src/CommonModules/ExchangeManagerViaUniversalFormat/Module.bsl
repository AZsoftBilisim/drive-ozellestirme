Procedure PCO_Document_ShipmentOfGoodsFromStorage_Return_Dispatch_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	Prefix = "N";
	XDTOData.KeyProperties.Number = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	// Additional properties for the contract
	If Not ValueIsFilled(IBData.Contract) Then
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData, "Counterparty, Organization");
		DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithCustomer";
		XDTOData.Insert("Contract", ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents));
	Else
		XDTOData.Insert("Contract", IBData.Contract);
	EndIf;
	If CommonClientServer.HasAttributeOrObjectProperty(IBData, "AdditionalProperties") Then
		If IBData.AdditionalProperties.Property("Goods") Then
			Goods = IBData.AdditionalProperties.Goods;
			If Not Goods = Undefined And Goods.Count() > 0 Then
				XDTOData.Insert("Goods", Goods);  
			EndIf; 
		EndIf;
		If IBData.AdditionalProperties.Property("OperationData") Then
			OperationData = IBData.AdditionalProperties.OperationData;
			XDTOData.Insert("TransactionRate", OperationData.TransactionRate);
			XDTOData.Insert("Multiplier_", OperationData.Multiplier_);
		EndIf;
	EndIf;
	XDTOData.Insert("Sum", Goods.Total("Sum"));
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.GoodsShipmentFromStorage.SetOfSeries", XDTOData);
	EndIf;
EndProcedure


