		ListOfOrganizationsNode = ExchangeComponents.ConversionParameters_SSLy.Companies;
		
		UnloadingSale = ListOfOrganizationsNode.FindByValue(IBData.Organization) <> Undefined;
		UploadPurchase = ListOfOrganizationsNode.FindByValue(IBData.CompanyRecipient) <> Undefined;
		
	Else
		
		UnloadingSale = ExchangeComponents.ConversionParameters_SSLy.UnloadManagementCompany 
			Or IBData.Organization <> ManagementCompany();
			
		UploadPurchase = ExchangeComponents.ConversionParameters_SSLy.UnloadManagementCompany 
			Or IBData.CompanyRecipient <> ManagementCompany();
		
	EndIf;
	
	UsageOCR.TransferBetweenOrganizations_PTU_Sending = UploadPurchase;
	UsageOCR.TransferBetweenCompanies_CI_Send = UnloadingSale;
	
	If UsageOCR.Count() > 0
		And Not TypeOfTaxationIsValid(Undefined, IBData.VATTaxation, ExchangeComponents.ExchangeFormatVersion) Then
		
		ClearUsageOCR(UsageOCR);
		
		WarningTemplate = NStr("vi = 'Chưa kết xuất chứng từ %1, bởi vì kiểu hệ thống thuế %2 không được hỗ trợ với định dạng %3';
								|ru = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
								|en = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format'; fa = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
								|it = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
								|pl = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
								|tr = '%2 vergilendirme türü %3 biçiminde desteklenmediğinden dolayı %1 belgesi yüklenmedi'");
		WarningText = StrTemplate(WarningTemplate, IBData.Ref, "«" + String(IBData.VATTaxation) + "»", String(ExchangeComponents.ExchangeFormatVersion));
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
	EndIf;
EndProcedure

