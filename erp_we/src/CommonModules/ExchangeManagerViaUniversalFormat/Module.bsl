Procedure DeferredProcessing_ERPCustomsDeclaration(Object, ExchangeComponents, ObjectIsModified)
	If ValueIsFilled(Object.Counterparty) Then
		CurPartner_ = Common.ObjectAttributeValue(Object.Counterparty, "Partner");
		Object.Partner = CurPartner_;
	EndIf;
	
	// If the partner could not be filled in according to the receipt document
	FillingInPartnerInDocumentHeader(Object);
	
	// filling in the supplier and warehouse from the receipt document
	Query = New Query(
	"SELECT
	|	ReceiptOfGoodsServices.Ref AS DocumentInflow,
	|	ReceiptOfGoodsServices.Warehouse,
	|	ReceiptOfGoodsServices.Partner,
	|	ReceiptOfGoodsServices.Counterparty
	|FROM
	|	Document.VendorInvoice AS ReceiptOfGoodsServices
	|WHERE
	|	ReceiptOfGoodsServices.Ref IN(&ReceiptDocuments)");
	Query.SetParameter("ReceiptDocuments", Object.Goods.UnloadColumn("DocumentInflow"));
	
	DetailsOfReceipts = Query.Execute().Unload();
	DetailsOfReceipts.Indexes.Add("DocumentInflow");
	
	CurSupplier = Undefined;
	CurSupplierSCounterparty = Undefined;
	For Each String In Object.Goods Do
		If Not ValueIsFilled(String.DocumentInflow) Then
			Continue;
		EndIf;
		
		ReceiptDetails = DetailsOfReceipts.Find(String.DocumentInflow, "DocumentInflow");
		
		If Not ReceiptDetails = Undefined Then
			CurSupplier = ReceiptDetails.Partner;
			CurSupplierSCounterparty = ReceiptDetails.Counterparty;
			String.Warehouse = ReceiptDetails.Warehouse;
		EndIf;
			
	EndDo;
	
	Object.Vendor = CurSupplier;
	Object.VendorSCounterparty = CurSupplierSCounterparty;
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	If Object.RegistrationOption = Enums.BusinessTransactions.RegisterCCDUnassisted Then
	   Object.PaymentMethod = Enums.PaymentForms.BankAccountPayment;
	EndIf;
	
	If ValueIsFilled(Object.VendorSCounterparty)
		And Not ValueIsFilled(Object.Vendor) Then
		Vendor = CashServer.GetCounterpartyPartner(Object.VendorSCounterparty);	
		If Not ValueIsFilled(Vendor) Then
			Vendor = Catalogs.Partners.UnknownPartner;
		EndIf;
	
		Object.Vendor = Vendor;	
	EndIf;
	
	If Object.CustomsFee <> 0 And Not ValueIsFilled(Object.ExpenseItemFee) Then
		Object.ExpenseItemFee = DefaultElement(ExchangeComponents, "ItemOfExpenditureCustomsDuty");
	EndIf;
	If Object.CustomsPenalty <> 0 And Not ValueIsFilled(Object.ExpenseItemPenalty) Then
		Object.ExpenseItemPenalty = DefaultElement(ExchangeComponents, "ItemOfExpenditureCustomsFine");
	EndIf;
EndProcedure
