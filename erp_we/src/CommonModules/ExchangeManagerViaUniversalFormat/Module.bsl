Procedure OCR_Document_CostsItems_DebtAdjustment_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "R";
	XDTOData.KeyProperties.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7));
	
	XDTOData.Insert("OperationKind",        "DebtCancellation");
	XDTOData.Insert("Currency",             LocalAccountingCurrency(IBData.Organization));
	XDTOData.Insert("DocumentCourse",      1);
	XDTOData.Insert("DocumentMultiplicity", 1);
	
	IncomeExpensesAssetsLiabilities = Undefined;
	
	If IBData.IncomeExpensesAssetsLiabilities.Count() > 0 Then
		IncomeExpensesAssetsLiabilities = IBData.IncomeExpensesAssetsLiabilities[0];
		UnloadDivision(IncomeExpensesAssetsLiabilities, XDTOData);
	EndIf;	
		
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	If IBData.IntercompanyARAP And ValueIsFilled(IBData.Counterparty) Then
		CounterpartyOrganization = IBData.Counterparty;
		UnloadedCounterparty = CounterpartyFromOrganization(CounterpartyOrganization, ExchangeComponents);
	Else
		UnloadedCounterparty = IBData.Counterparty;
	EndIf;
	
	DataDebt = UnloadDebtTable("Debt_",
		IBData.Ref, UnloadedCounterparty, IBData.Organization, , ExchangeComponents);
	
	If DataDebt.Count() > 0 Then
		XDTOData.Insert("Currency",             DataDebt[0].ARAPCurrency);
		XDTOData.Insert("DocumentCourse",      DataDebt[0].TransactionRate);
		XDTOData.Insert("DocumentMultiplicity", DataDebt[0].Multiplier_);
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.APWriteOff Then
		XDTOData.Insert("Creditor",             UnloadedCounterparty);
		XDTOData.Insert("CounterpartyDebtor",              Catalogs.Counterparties.EmptyRef());
		XDTOData.Insert("AmountOfAccountsReceivable",  0);
		XDTOData.Insert("AmountOfAccountsPayable", IBData.Debt_.Total("Sum"));
		XDTOData.Insert("AccountsPayable",      DataDebt);
		
		If ValueIsFilled(IncomeExpensesAssetsLiabilities) Then
			AccountingAccountInformationSecurityData = Common.ObjectAttributeValue(
									IncomeExpensesAssetsLiabilities.GLAccountSettings, 
									"GLAccount");
			GLAccount = AccountingInvoiceForArticle(
							IncomeExpensesAssetsLiabilities.AssetRef,
							IBData.Organization,
							IncomeExpensesAssetsLiabilities.Department,
							IBData.Date,
							AccountingAccountInformationSecurityData);
			XDTOData.Insert("AccountDr", Undefined);
			XDTOData.Insert("AccountCr", GLAccount);
			IncomeItem = Undefined;
			If TypeOf(IncomeExpensesAssetsLiabilities.AssetRef) = Type("ChartOfCharacteristicTypesRef.IncomeItems") Then
				IncomeItem = IncomeExpensesAssetsLiabilities.AssetRef;
			EndIf;
			
			XDTOData.Insert("IncomeItem", IncomeItem);
			XDTOData.Insert("ExpenseItem", Undefined);
		EndIf;
	Else
		XDTOData.Insert("CounterpartyDebtor",  UnloadedCounterparty);
		XDTOData.Insert("Creditor", Catalogs.Counterparties.EmptyRef());
		XDTOData.Insert("AmountOfAccountsReceivable", IBData.Debt_.Total("Sum"));
		XDTOData.Insert("AmountOfAccountsPayable", 0);
		XDTOData.Insert("AccountsReceivable",  DataDebt);
		
		If ValueIsFilled(IncomeExpensesAssetsLiabilities) Then
			AccountingAccountInformationSecurityData = Common.ObjectAttributeValue(
									IncomeExpensesAssetsLiabilities.GLAccountSettings,
									"GLAccount");
			GLAccount = AccountingInvoiceForArticle(
							IncomeExpensesAssetsLiabilities.AssetRef,
					 		IBData.Organization,
					 		IncomeExpensesAssetsLiabilities.Department,
							IBData.Date,
					 		AccountingAccountInformationSecurityData);
			XDTOData.Insert("AccountDr", GLAccount);
			XDTOData.Insert("AccountCr", Undefined);
			ExpenseItem = Undefined;
			If TypeOf(IncomeExpensesAssetsLiabilities.AssetRef) = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
				ExpenseItem = IncomeExpensesAssetsLiabilities.AssetRef;
			EndIf;
		
			XDTOData.Insert("IncomeItem", Undefined);
			XDTOData.Insert("ExpenseItem", ExpenseItem);
		EndIf;
	EndIf;
EndProcedure


