	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False, "VATTaxationOfSeller");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	// Goods
	Goods = AdvancedInformationSecurityData.Goods;
	Goods.Columns.Add("Vendor");
	Goods.Columns.Add("InvIsSubmitted");
	Goods.Columns.Add("InvoiceDate");
	Goods.Columns.Add("InvoiceNumber");
