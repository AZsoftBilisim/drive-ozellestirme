Procedure PCO_Document_RevocationOfPS_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	// GiftCertificates
	ArrayOfRows = New Array;
	
	If XDTOData.Property("GiftCertificates")
		And ValueIsFilled(XDTOData.GiftCertificates) Then
		
		For Each String In XDTOData.GiftCertificates Do
			
			GiftCertificateStructure = New Structure;
			GiftCertificateStructure.Insert("Barcode",                  String.Barcode);
			GiftCertificateStructure.Insert("MagneticCode",              String.MagneticCode);
			GiftCertificateStructure.Insert("SerialNumber",             String.SerialNumber);
			
			// We are preparing instructions for converting a gift certificate.
			Instruction = New Structure;
			
			GiftCertificateStructure.Insert("GiftCertificateKind", String.GiftCertificateKind);
			Instruction.Insert("OCRName", "Catalog_GiftCertificates");
			
			Instruction.Insert("Value", GiftCertificateStructure);
	
			StringDataStructure = New Structure;
			StringDataStructure.Insert("AmountInCertificateCurrency", String.Sum);
			StringDataStructure.Insert("GiftCertificate",    Instruction);
			
			ArrayOfRows.Add(StringDataStructure);
			
		EndDo;
	EndIf;
	
	ReceivedData.AdditionalProperties.Insert("GiftCertificates", ArrayOfRows);
EndProcedure
