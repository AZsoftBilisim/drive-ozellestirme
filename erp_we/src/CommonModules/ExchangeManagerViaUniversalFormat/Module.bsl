		TabOwnProducts.Columns.Add("CostAccount");
		TabOwnProducts.FillValues(ExchangeComponents.ConversionParameters_SSLy.CostAccountMaterialTransferToProduction, "CostAccount");
	EndIf;
	XDTOData.Insert("Goods", TabOwnProducts);
EndProcedure

