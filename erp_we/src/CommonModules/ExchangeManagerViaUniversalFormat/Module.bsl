Procedure PCO_RefundBetweenOrganizations_FromBuyer_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "I";
	DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	
	XDTOData.KeyProperties.Insert("Number", DocNumber);
	XDTOData.KeyProperties.Insert("Date", BegOfDay(IBData.Date));
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"RefundBetweenOrganizations_FromBuyer_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"RefundBetweenOrganizations_FromBuyer_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True);
	
	If IBData.ARAPDetails.Count() > 0 Then
		XDTOData.Insert("ARAPCurrency", IBData.ARAPDetails[0].ARAPCurrency);
	Else
		XDTOData.Insert("ARAPCurrency", IBData.Currency);
	EndIf;
	
	XDTOData.Insert("BuyerIssuesInvoiceForReturn", False);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.IntercompanyGoodsReturn Then
		XDTOData.Insert("OperationKind", "ReturnFromCustomer");
	Else
		XDTOData.Insert("OperationKind", "ReturnFromCommissionAgent");
	EndIf;
	
	If IBData.ARAPAccountingViaSeparateCounterparty Then
		CounterpartyRef = IBData.Counterparty;
		
	Else
		CounterpartyRef = CounterpartyFromOrganization(IBData.Organization, ExchangeComponents);
		
	EndIf;
	XDTOData.Insert("Counterparty", CounterpartyRef);
	
	#Region Contract
	
	InstructionsContract = Undefined;
	If IBData.ARAPAccountingViaSeparateCounterparty
		And ValueIsFilled(IBData.SalesContract)
		And Common.RefExists(IBData.SalesContract) Then
		
		InstructionsContract = New Structure;
		InstructionsContract.Insert("OCRName",   "Catalog_CounterpartyContracts");
		InstructionsContract.Insert("Value", IBData.SalesContract);
		
	ElsIf ValueIsFilled(IBData.Contract) Then
		
		InstructionsContract = New Structure;
		InstructionsContract.Insert("OCRName",   "Catalog_IntercompanyContracts");
		InstructionsContract.Insert("Value", IBData.Contract);
	
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Organization = IBData.CompanyRecipient;
		DefaultParameters.Counterparty  = CounterpartyRef;
		If IBData.BusinessOperation = Enums.BusinessTransactions.IntercompanyGoodsReturn Then
			DefaultParameters.TypeOfAgreement = "WithCustomer";
		Else
			DefaultParameters.TypeOfAgreement = "WithConsignee";
		EndIf;
		DefaultParameters.ARAPCurrency = XDTOData.ARAPCurrency;
		DefaultParameters.CalculationsInConventionalUnits =
			IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization)
			And IBData.Currency <> XDTOData.ARAPCurrency;
		
		InstructionsContract = ConversionAgreementBasedOnSettlementData(DefaultParameters,
			ExchangeComponents,
			IBData.Contract);
	EndIf;
	XDTOData.Insert("Contract", InstructionsContract);
	
	#EndRegion
	
	UploadRateAndMultiplicityOfSettlements(XDTOData, XDTOData.ARAPCurrency, IBData.Date, IBData.Organization);
	
	// Table part
	QueryText = 
		"SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|		END AS NUMBER(31, 2)) AS Price,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.FromCurrentDocument)
		|			THEN CASE
		|					WHEN InventoryKinds.Ref.PriceIncludesVAT
		|						THEN InventoryKinds.AmountIncludingVAT
		|					ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|				END
		|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.Manually)
		|			THEN CASE
		|					WHEN ISNULL(&Rate, 0) > 0
		|							AND ISNULL(&Repetition, 0) > 0
		|						THEN CAST(InventoryKinds.CostLocal / &Rate / &Repetition AS NUMBER(31, 2))
		|					ELSE 0
		|				END
		|		ELSE 0
		|	END AS Cost_,
		|	CASE
		|		WHEN InventoryKinds.RecipientInventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	CAST(CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN CASE
		|					WHEN InventoryKinds.NumberOfPackages = 0
		|						THEN InventoryKinds.AmountIncludingVAT
		|					ELSE InventoryKinds.AmountIncludingVAT / InventoryKinds.NumberOfPackages
		|				END
		|		ELSE CASE
		|				WHEN InventoryKinds.NumberOfPackages = 0
		|					THEN InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|				ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.NumberOfPackages
		|			END
		|	END AS NUMBER(15, 2)) AS PricePerPackaging
		|FROM
		|	Document.IntercompanyGoodsReturn.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
				
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	If IBData.Currency = LocalAccountingCurrency(IBData.Organization) Then
		Query.SetParameter("Rate", 1);
		Query.SetParameter("Repetition", 1);
	Else
		CurrencyExchangeRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(IBData.Currency, IBData.Date,
		SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		Query.SetParameter("Rate", CurrencyExchangeRate.CourseNumerator);
		Query.SetParameter("Repetition", CurrencyExchangeRate.CourseDenominator);
	EndIf;
		
	Goods = Query.Execute().Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "ReturnUnderOperation");
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		RedefineVATRateForOldFormats(Goods, False);
	EndIf; 
	XDTOData.Insert("Goods", Goods);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

