Procedure PCO_Document_AdvanceReportFromStructure_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_AdvanceReportFromStructure_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_AdvanceReportFromStructure_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending"); 
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_AdvanceReportFromStructure_Sending", 
										"OtherExpenses", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");								
	EndIf;
	UnloadDivision(IBData, XDTOData);
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, True, False, "VATTaxationOfSeller");
	
	Query = New Query;
	
	// These document headers are necessary for calculating the rate and multiplicity.
	Query.Text =
	"SELECT
	|	ISNULL(CurrencyRatesCut.CourseNumerator, 1) AS TransactionRate,
	|	ISNULL(CurrencyRatesCut.CourseDenominator, 1) AS Multiplier_
	|FROM
	|	(SELECT
	|		&Currency AS Currency) AS DocumentCurrency
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &Currency AND BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
	|		ON (CurrencyRatesCut.Currency = DocumentCurrency.Currency)";
	
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("Currency", IBData.Currency);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		XDTOData.Insert("DocumentCourse", Selection.TransactionRate);
		XDTOData.Insert("DocumentMultiplicity", Selection.Multiplier_);
	EndIf;
	
	If IBData.Property("Warehouse") Then
		WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
		XDTOData.Insert("Warehouse", WarehouseForUnloading);
	EndIf;
	
	For Each LineOther In IBData.OtherExpenses Do
		CostAccount = AccountingInvoiceForArticle(LineOther.ExpenseItem, IBData.Organization, LineOther.Department, IBData.Date);
		If TypeOf(LineOther.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
			LineOther.CostItem = LineOther.ExpenseItem;
			If ThisIsUT() 
				And ValueIsFilled(LineOther.CashFlowItem) Then
				DDSCostAccount = TrimAll(Common.ObjectAttributeValue(LineOther.CashFlowItem, 
				"OffsettingAccount"));
				If ValueIsFilled(DDSCostAccount) Then
					CostAccount = DDSCostAccount;
				EndIf;
			EndIf;
		EndIf;
		LineOther.CostAccount = CostAccount; 
	EndDo;
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	AdvanceReportOtherExpenses.ElectronicTicket AS ProductData_1,
		|	AdvanceReportOtherExpenses.AmountTotal AS AmountTotal,
		|	AdvanceReportOtherExpenses.Sum AS Sum,
		|	AdvanceReportOtherExpenses.RowID AS RowID,
		|	AdvanceReportOtherExpenses.VATAmount AS VATAmount,
		|	ElectronicTicketTransaction.PostingDate AS BusinessTripStartDate,
		|	ElectronicTicketTransaction.ArrivalDate AS BusinessTripEndDate
		|FROM
		|	Document.ExpenseReport.OtherExpenses AS AdvanceReportOtherExpenses
		|		LEFT JOIN Document.ElectronicTicketTransaction AS ElectronicTicketTransaction
		|		ON AdvanceReportOtherExpenses.ElectronicTicket = ElectronicTicketTransaction.Ref
		|WHERE
		|	AdvanceReportOtherExpenses.Ref = &Ref
		|	AND NOT AdvanceReportOtherExpenses.ElectronicTicket = VALUE(Document.ElectronicTicketTransaction.EmptyRef)";
	
	If IBData.Property("Ref") Then
	     Query.SetParameter("Ref", IBData.Ref);
	     ElectronicTickets = Query.Execute().Unload();
	   	EndIf;
	
	Goods             = IBData.Goods;
	OtherExpenses      = IBData.OtherExpenses;
	PaymentToCounterparties = IBData.PaymentToCounterparties;
	PrepaymentsToVendor_     = IBData.PrepaymentsToVendor_;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		RedefineVATRateForOldFormats(Goods, False);
		RedefineVATRateForOldFormats(OtherExpenses, False);
	EndIf;
	XDTOData.Insert("Goods",				Goods);
	XDTOData.Insert("OtherExpenses",		OtherExpenses);
	XDTOData.Insert("PaymentToCounterparties",	PaymentToCounterparties);
	XDTOData.Insert("PrepaymentsToVendor_",		PrepaymentsToVendor_);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17")
		And ElectronicTickets <> Undefined And ElectronicTickets.Count() > 0 Then 
		//Dataxdto.Insert("Travel documents",T Electronic tickets);
		XDTOData.Insert("BusinessTripStartDate", ElectronicTickets[0].BusinessTripStartDate);
		XDTOData.Insert("BusinessTripEndDate", ElectronicTickets[0].BusinessTripEndDate);
	EndIf;
	
	XDTOData.Insert("AmountIncludesVAT", True);
	XDTOData.Insert("Sum", Goods.Total("Sum") + OtherExpenses.Total("Sum") + PaymentToCounterparties.Total("Sum"));
	
	If IBData.Property("Ref")
		And Not IBData.Property("UploadDeletionByLink") Then
		XDTOData.KeyProperties.Insert("Ref", IBData.Ref);
	EndIf;
EndProcedure

