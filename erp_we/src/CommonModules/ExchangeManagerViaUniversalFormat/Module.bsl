Procedure UploadContactInformation(XDTOData, ReceivedData, CIKindsGroup)
	If Not (XDTOData.Property("ContactInformation")
		And ValueIsFilled(XDTOData.ContactInformation)) Then
		Return;
	EndIf;
	FormatSupportsJSONValue = (Not XDTOData.ContactInformation.Columns.Find("Value") = Undefined);	
	For Each XDTORow In XDTOData.ContactInformation Do
		KiLineView   = TrimAll(XDTORow.ContactInformationKind.Value);
		NameOfCI = TrimAll(XDTORow.NameOfContactInformation);
		
		CurVidKi = ViewContactInformationFromLine(KiLineView, NameOfCI, CIKindsGroup);
		
		If Not ValueIsFilled(CurVidKi) Then
			Continue;
		EndIf;
		
		If FormatSupportsJSONValue And ValueIsFilled(XDTORow.Value) Then
			KIValue = XDTORow.Value;
		Else
			KIValue = XDTORow.FieldValues;
		EndIf;
		
		ContactsManager.AddContactInformation(ReceivedData, TrimAll(KIValue), CurVidKi);
	EndDo;
EndProcedure
