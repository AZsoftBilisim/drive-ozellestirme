Procedure UnloadingAdditionalBankingDetails_DetermineNameOfICO(PropertyValue, OCRName, NameICOGroup)
	PropertyValueType1 = TypeOf(PropertyValue);
	If PropertyValueType1 = Type("CatalogRef.Products") Then
		OCRName = "Catalog_Products_Send";
		NameICOGroup = "Catalog_ProductsGroup";
	ElsIf PropertyValueType1 = Type("CatalogRef.Counterparties") Then
		OCRName = "Catalog_Counterparties";
	ElsIf PropertyValueType1 = Type("CatalogRef.ObjectsPropertiesValues") Then
		OCRName = "Catalog_AdditionalAttributesValues";
	ElsIf PropertyValueType1 = Type("CatalogRef.BankClassifier") Then
		OCRName = "Catalog_Banks";
	ElsIf PropertyValueType1 = Type("CatalogRef.Currencies") Then
		OCRName = "Catalog_Currencies";
	ElsIf PropertyValueType1 = Type("CatalogRef.CounterpartyContracts") Then
		OCRName = "Catalog_CounterpartyContracts";
	ElsIf PropertyValueType1 = Type("CatalogRef.PackagesAndUnitsOfMeasure") Then
		OCRName = "Catalog_UnitsOfMeasurement";
	ElsIf PropertyValueType1 = Type("CatalogRef.Companies") Then
		OCRName = "Catalog_Companies_Send";
	ElsIf PropertyValueType1 = Type("CatalogRef.Users") Then
		OCRName = "Catalog_Users";
	ElsIf PropertyValueType1 = Type("CatalogRef.Warehouses") Then
		OCRName = "Catalog_Warehouses_Send";
		NameICOGroup = "Catalog_WarehousesGroup";
	ElsIf PropertyValueType1 = Type("CatalogRef.CashFlowReportItems") Then
		OCRName = "Catalog_CFItems";
	ElsIf PropertyValueType1 = Type("ChartOfCharacteristicTypesRef.IncomeItems") Then
		OCRName = "Catalog_IncomeItems";
	ElsIf PropertyValueType1 = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
		OCRName = "Catalog_ExpenseItems";
	ElsIf PropertyValueType1 = Type("CatalogRef.WorldCountries") Then
		OCRName = "Catalog_WorldCountries";
	ElsIf PropertyValueType1 = Type("CatalogRef.TypesOfPrices") Then
		OCRName = "Catalog_PriceTypes";
	ElsIf PropertyValueType1 = Type("CatalogRef.Persons") Then
		OCRName = "Catalog_Persons_Send";
		NameICOGroup = "Catalog_IndividualsGroup_Sending";
	EndIf;
EndProcedure
Procedure UnloadingAdditionalDetailsFromValueTable(InformationSecurityDetailsAdditionalDetails, AddlAttributesTable)
	For Each TSRow In InformationSecurityDetailsAdditionalDetails Do
		If Not ValueIsFilled(TSRow.Property) Then
			Continue;
		EndIf;
		PropertyValueType1 = TypeOf(TSRow.Value);
		OCRName = "";
		NameICOGroup = "";
		If PropertyValueType1 = Type("Number") 
			Or PropertyValueType1 = Type("String")
			Or PropertyValueType1 = Type("Boolean")
			Or PropertyValueType1 = Type("Date") Then
			NewString = AddlAttributesTable.Add();
			NewString.Property = TSRow.Property;
			NewString.PropertyValue = TSRow.Value;
			Continue;
		ElsIf PropertyValueType1 = Type("CatalogRef.BusinessStructure") Then
			StructureDataDivisions = New Structure(
				"Description, RegistrationOfSubdivisionWithTaxAuthority", 
				String(TSRow.Value), Undefined);
	
			Instruction = New Structure(
				"Value, OCRName",
				StructureDataDivisions,
				"Catalog_Divisions_FromStructure");
			NewString = AddlAttributesTable.Add();
			NewString.Property = TSRow.Property;
			NewString.PropertyValue = Instruction;
			Continue;
		EndIf;
		UnloadingAdditionalBankingDetails_DetermineNameOfICO(TSRow.Value, OCRName, NameICOGroup);
		If OCRName = "" Then
			Continue;
		EndIf; 	
		If NameICOGroup <> "" And TSRow.Value.IsFolder Then
			CurICOName = NameICOGroup;
		Else
			CurICOName = OCRName;
		EndIf;
		NewString = AddlAttributesTable.Add();
		NewString.Property = TSRow.Property;
		NewString.PropertyValue = New Structure("Value, OCRName", TSRow.Value, CurICOName);
	EndDo;
EndProcedure
Function ContractDataBetweenOrganizations(ExchangeComponents, Contract, ObjectCompany = Undefined)
	If TypeOf(Contract) = Type("CatalogObject.IntercompanyContracts") Then
		InformationSecurityAgreementData = Contract;
		LinkToIntercampanyContract = Contract.Ref;
	Else
		Query = New Query("SELECT
			|	IntercompanyContracts.Number AS Number,
			|	IntercompanyContracts.Description AS Description,
			|	IntercompanyContracts.Date AS Date,
			|	IntercompanyContracts.ARAPCurrency AS ARAPCurrency,
			|	IntercompanyContracts.ContractType AS ContractType,
			|	IntercompanyContracts.ForeignCurrencyTransaction AS ForeignCurrencyTransaction,
			|	IntercompanyContracts.CompanyRecipient AS CompanyRecipient,
			|	IntercompanyContracts.Organization AS Organization
			|FROM
			|	Catalog.IntercompanyContracts AS IntercompanyContracts
			|WHERE
			|	IntercompanyContracts.Ref = &Ref");
		Query.SetParameter("Ref", Contract);
	
		Selection = Query.Execute().Select();
		Selection.Next();
		
		InformationSecurityAgreementData = Selection;
		LinkToIntercampanyContract = Contract;
	EndIf;
	
	CompanyAttributeName = "CompanyRecipient";
	AttributeNameCounterparty = "Organization";
	
	If ValueIsFilled(ObjectCompany)
		And ObjectCompany = InformationSecurityAgreementData.Organization Then
		
		CompanyAttributeName = "Organization";
		AttributeNameCounterparty = "CompanyRecipient";
		
	EndIf;
	
	ContractData = New Structure();
	
	ContractData.Insert("Number",                    InformationSecurityAgreementData.Number);
	ContractData.Insert("Description",             InformationSecurityAgreementData.Description);
	ContractData.Insert("Date",                     InformationSecurityAgreementData.Date);
	ContractData.Insert("ARAPCurrency",     InformationSecurityAgreementData.ARAPCurrency);
	ContractData.Insert("Organization",              InformationSecurityAgreementData[CompanyAttributeName]);
	ContractData.Insert("Counterparty",               CounterpartyFromOrganization(InformationSecurityAgreementData[AttributeNameCounterparty], ExchangeComponents));
	
	ContractData.Insert("TypeOfAgreement", TypeOfContractByIntercampanyContractType(InformationSecurityAgreementData[CompanyAttributeName], LinkToIntercampanyContract));
	   	ContractData.Insert("CalculationsInConventionalUnits", False);
	If VueCalculationIsUnderway(InformationSecurityAgreementData.ARAPCurrency, InformationSecurityAgreementData.ForeignCurrencyTransaction, InformationSecurityAgreementData.Organization, ExchangeComponents) Then
		ContractData.Insert("CalculationsInConventionalUnits", True);
	EndIf;
	
	Return ContractData;
EndFunction
Function CollectionDataAsStructure(Source, FillingRules)
	Result = New Structure;
	
	For Each FillingRule In FillingRules Do
	
		StructureForValueTransfer = New Structure(FillingRule.Key, Undefined);
		FillPropertyValues(StructureForValueTransfer, Source);
		
		Value = StructureForValueTransfer[FillingRule.Key];
		If Value <> Undefined Then
			Result.Insert(FillingRule.Value, Value);
		EndIf;
	
	EndDo;
	
	Return Result;
EndFunction
Function CounterpartyDataForHistoricalSearchFields(XDTOData)
	KeyProperties = Undefined;
	If Not XDTOData.Property("KeyProperties", KeyProperties) Then
		KeyProperties = XDTOData;
	EndIf;
	
	// INN+KPP
	If (KeyProperties.Property("TIN") And ValueIsFilled(KeyProperties.TIN))
		And (KeyProperties.Property("CRTR") And ValueIsFilled(KeyProperties.CRTR)) Then
		Query = New Query(
		"SELECT TOP 1
		|	Counterparties.CRTR AS CRTR
		|FROM
		|	Catalog.Counterparties AS Counterparties
		|		INNER JOIN Catalog.Counterparties.CRTRHistory AS CounterpartiesCRTRHistory
		|		ON (CounterpartiesCRTRHistory.Ref = Counterparties.Ref)
		|WHERE
		|	Counterparties.TIN = &TIN
		|	AND CounterpartiesCRTRHistory.CRTR = &CRTR
		|	AND CounterpartiesCRTRHistory.CRTR <> Counterparties.CRTR");
		Query.SetParameter("TIN", KeyProperties.TIN);
		Query.SetParameter("CRTR", KeyProperties.CRTR);
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			Result = New Structure("CRTR");
			FillPropertyValues(Result, Selection);
			
			Return Result;
		EndIf;
	EndIf;
	
	// DescriptionFull
	If KeyProperties.Property("DescriptionFull")
		And ValueIsFilled(KeyProperties.DescriptionFull) Then
		Query = New Query(
		"SELECT TOP 1
		|	Counterparties.DescriptionFull AS DescriptionFull
		|FROM
		|	Catalog.Counterparties AS Counterparties
		|		INNER JOIN Catalog.Counterparties.NameHistory AS CounterpartiesNameHistory
		|		ON (CounterpartiesNameHistory.Ref = Counterparties.Ref)
		|WHERE
		|	CounterpartiesNameHistory.NameAbbreviated = &DescriptionFull
		|	AND CounterpartiesNameHistory.NameAbbreviated <> Counterparties.DescriptionFull");
		Query.SetParameter("DescriptionFull", KeyProperties.DescriptionFull);
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			Result = New Structure("DescriptionFull");
			FillPropertyValues(Result, Selection);
			
			Return Result;
		EndIf;
	EndIf;
	
	Return Undefined;
EndFunction
Procedure AddCurrencyToAdditionalProperties(ReceivedData, XDTOData, PropertyNameXDTO = "Currency", NameOfThisProperty = "Currency")
	If XDTOData.Property(PropertyNameXDTO)
		And ValueIsFilled(XDTOData[PropertyNameXDTO]) Then
		
		If XDTOData[PropertyNameXDTO].Property("Ref") Then
			OCRName = "Catalog_Currencies";
		Else
			OCRName = "Catalog___FromStructure";
		EndIf;
		
		ReceivedData.AdditionalProperties.Insert(NameOfThisProperty, New Structure("Value, OCRName", XDTOData[PropertyNameXDTO], OCRName));
	
	EndIf;
EndProcedure
Procedure AddCurrencyToPaymentDecryption(StringDataStructure, XDTORow)
	ARAPCurrency = XDTORow.ARAPCurrency;
	If TypeOf(ARAPCurrency) = Type("Structure")
		And ARAPCurrency.Property("Ref") = False Then
		OCRName = "Catalog___FromStructure";
	Else
		OCRName = "Catalog_Currencies";
	EndIf;
	Instruction = New Structure("Value, OCRName", ARAPCurrency, OCRName);
	StringDataStructure.Insert("ARAPCurrency", Instruction);
EndProcedure
Procedure AddSettlementDataToPaymentTranscript(ExchangeComponents, DecryptionString, StringDataStructure, AvailableColumns)
	DocumentOfARAPAccounting = Undefined;
	
	If AvailableColumns.ThereIsColumnCalculationDocument
		And ValueIsFilled(DecryptionString.DocumentOfARAPAccounting) Then
		
		DocumentOfARAPAccounting = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, DecryptionString.DocumentOfARAPAccounting);
		
	ElsIf AvailableColumns.ThereIsOrderColumn 
		And ValueIsFilled(DecryptionString.OrderDocument) Then
		
		DocumentOfARAPAccounting = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, DecryptionString.OrderDocument);
		
	EndIf;
	
	If ValueIsFilled(DocumentOfARAPAccounting) Then
		
		StringDataStructure.Insert("DocumentOfARAPAccounting", DocumentOfARAPAccounting);
		
	ElsIf AvailableColumns.ThereIsContractColumn 
		And ValueIsFilled(DecryptionString.Contract) Then
		
		Contract = LinkToCalculationDocumentFromXDTOData(ExchangeComponents, DecryptionString.Contract); 
		
		If ValueIsFilled(Contract) Then
			
			StringDataStructure.Insert("Contract", Contract); 
			
		EndIf;
		
	EndIf;
EndProcedure
Procedure AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents, PropertyNameXDTO = "Contract", AttributeName = "Contract")
	// If the use of contracts is disabled, then the contract in the document is not filled in.
	If Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed
		And Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed Then
		Return;
		
	EndIf;
	
	If XDTOData.Property(PropertyNameXDTO) And ValueIsFilled(XDTOData[PropertyNameXDTO]) Then
		XDTOPropertyValue = XDTOData[PropertyNameXDTO];
		// The need to fill out the contract depends on the type of contract.
		FillInContract = True;
		If Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed
			Or Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed Then
			ContractType = Undefined;
			TypeOfAgreement = Undefined;
			XDTOPropertyValue.Property("TypeOfAgreement", TypeOfAgreement);
			If  TypeOf(TypeOfAgreement) = Type("Structure")
				And TypeOfAgreement.Property("Value") Then
			    ContractType = TypeOfAgreement.Value;
			EndIf;
			If Not ValueIsFilled(ContractType)
				Or (Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed
				And (ContractType = "WithCustomer"
				Or ContractType = "WithConsignee"
				Or ContractType = "WithCommissionAgentForPurchase"))
				Or (Not ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed
				And (ContractType = "WithVendor"
				Or ContractType = "WithConsignor"
				Or ContractType = "CustomerInvoiceOutsourcedSale"
				Or ContractType = "Other")) Then
				
				FillInContract = False;
			EndIf;
		EndIf;
		If FillInContract Then
			If TypeOf(XDTOPropertyValue) = Type("Structure")
				And XDTOPropertyValue.Property("Ref") = False Then
				OCRName = "Catalog_ContractsOfCounterparties_FromStructure__";
			Else
				OCRName = "Catalog_CounterpartyContracts_Receive";
			EndIf;
			ReceivedData.AdditionalProperties.Insert(AttributeName, New Structure("Value, OCRName", XDTOPropertyValue, OCRName));
		EndIf;
	EndIf;
EndProcedure
Procedure AddCalculationDocumentToRowDataStructure(XDTOData, String, StringDataStructure)
	If StringDataStructure.Property("DocumentOfARAPAccounting")
		And ValueIsFilled(StringDataStructure.DocumentOfARAPAccounting)
		And StringDataStructure.DocumentOfARAPAccounting.Property("ValueType")
		And StringDataStructure.DocumentOfARAPAccounting.ValueType = "ИсходныйДокумент" Then // @Non-NLS-3
		SourceDocument = StringDataStructure.DocumentOfARAPAccounting;
		NameOfICOPrimaryDocument = "Document_PrimaryDocument_Receipt";
	Else
		SourceDocument = PrepareDataStructureOfPrimaryDocument(XDTOData, String);	
		NameOfICOPrimaryDocument = "Document_PrimaryDocumentFromStructure_Receive";
	EndIf;
	
	InstructionPrimaryDocument = New Structure("Value, OCRName",
		SourceDocument, NameOfICOPrimaryDocument);
	StringDataStructure.Insert("DocumentOfARAPAccounting", InstructionPrimaryDocument);
EndProcedure


Procedure AddPrimaryPmDocumentsToDeferredProcessing(ExchangeComponents, CrawlData, BusinessOperation, ColumnName = "DocumentOfARAPAccounting")
	ComplianceOfBusinessTransactionsWithDocumentTypes = New Map;
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.CashReceiptFromCustomer,
		Enums.SourceDocumentTypes.SaleToCustomer);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.RefundFromVendor,
		Enums.SourceDocumentTypes.PaymentToVendor);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.PaymentToVendor,
		Enums.SourceDocumentTypes.PurchaseFromVendor);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.RefundToCustomer,
		Enums.SourceDocumentTypes.PaymentFromCustomer);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.OBEntryUnmatchedPrepaymentFromCustomer,
		Enums.SourceDocumentTypes.PaymentFromCustomer);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.OBEntryCustomerAccountsReceivable,
		Enums.SourceDocumentTypes.SaleToCustomer);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.OBEntryUnmatchedPrepaymentToVendor,
		Enums.SourceDocumentTypes.PaymentToVendor);
	ComplianceOfBusinessTransactionsWithDocumentTypes.Insert(Enums.BusinessTransactions.OBEntryVendorAccountsPayable,
		Enums.SourceDocumentTypes.PurchaseFromVendor);
	
	PrimaryDocuments = ExchangeComponents.ConversionParameters_SSLy.PrimaryDocuments; // ValueTable
	
	For Each DocumentLine In CrawlData Do
		
		If TypeOf(DocumentLine) = Type("Structure") And Not DocumentLine.Property(ColumnName) Then
			Continue;
		EndIf;
			
		DocumentOfARAPAccounting = DocumentLine[ColumnName];
		
		If ValueIsFilled(DocumentOfARAPAccounting)
			And TypeOf(DocumentLine[ColumnName]) = Type("DocumentRef.SourceDocument") Then
			
			SourceDocumentType = ComplianceOfBusinessTransactionsWithDocumentTypes.Get(BusinessOperation);
			
			If Not SourceDocumentType = Undefined Then
				RowPrimaryDocuments = PrimaryDocuments.Add();
				RowPrimaryDocuments.SourceDocument = DocumentLine[ColumnName];
				RowPrimaryDocuments.SourceDocumentType = SourceDocumentType;
			EndIf;
		EndIf;
	EndDo;
EndProcedure


Function ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, ARAPObject = Undefined, IBData = Undefined)
	// The function generates and returns instructions for unloading the contract
	// according to the received parameters and settings of the exchange plan node.
	//
	// The function, according to the generated instructions, performs the forced unloading of the contract into the exchange file.
	//
	// Before calling this function, the presence of the contract in the document being uploaded
	// or in the settlement object is checked, if the contract is not found, then this function is called.
	
	StructureContractData = New Structure(ContractFixedKeyStructure());
	ContractIsFilled = False;
	StructureContractData.TypeOfAgreement = DefaultParameters.TypeOfAgreement;
	
	If ValueIsFilled(ARAPObject)
		And TypeOf(ARAPObject) = Type("CatalogRef.IntercompanyContracts") Then
		
		FillPropertyValues(StructureContractData, DefaultParameters,
			"Organization, Counterparty");
		
		IntercampanyDetails = Common.ObjectAttributesValues(ARAPObject,
			"Date, Number, Description, ARAPCurrency, ForeignCurrencyTransaction, Organization");
		FillPropertyValues(StructureContractData, IntercampanyDetails);
	
		StructureContractData.CalculationsInConventionalUnits = VueCalculationIsUnderway(
														IntercampanyDetails.ARAPCurrency, 
														IntercampanyDetails.ForeignCurrencyTransaction,
														IntercampanyDetails.Organization, 
														ExchangeComponents);	
		
		ContractIsFilled = True;
			
	ElsIf ValueIsFilled(ARAPObject)
		And IBData <> Undefined
		And Not AdditionalAnalyticsForContracts(ExchangeComponents).ContractToContract Then
		If TypeOf(ARAPObject) = Type("Structure") Then
			// If the agreement and the order are 2 different details in the document, then the values of these details are transmitted in the structure:
			// "Order" - a link to the customer's Order (supplier).
			// "Agreement" - a link to the Agreement with the customer (supplier).
			// "Transactions" - A link to a Transaction with a client.
			OrderRef      = Undefined;
			AgreementLink = Undefined;
			DealLink     = Undefined;
			
			ThisIsOrder      = ARAPObject.Property("OrderDocument", OrderRef) And ValueIsFilled(OrderRef);
			ThisIsConvention = ARAPObject.Property("Terms", AgreementLink) And ValueIsFilled(AgreementLink);
			ItSDeal     = ARAPObject.Property("SalesOpportunity", DealLink) And ValueIsFilled(DealLink);
		Else
			// It is understood that the details of the uploaded document "Order" - has a composite type
			// and can be an Order, Agreement, Transaction or other type of document / directory,
			// in addition, the object specified in this detail may have the details "Agreement" and / or "Transaction".
			OrderRef      = ARAPObject;
			AgreementLink = ARAPObject;
			DealLink     = ARAPObject;
			
			ThisIsOrder = TypeOf(ARAPObject) = Type("DocumentRef.SalesOrder")
				Or TypeOf(ARAPObject) = Type("DocumentRef.PurchaseOrder");
			
			OrderDetails = New Array;
			If ARAPObject.Metadata().Attributes.Find("Terms") <> Undefined Then
				OrderDetails.Add("Terms");
			EndIf;
			If ARAPObject.Metadata().Attributes.Find("SalesOpportunity") <> Undefined Then
				OrderDetails.Add("SalesOpportunity");
			EndIf;
			
			If OrderDetails.Count() > 0 Then
				StructureOrderData = Common.ObjectAttributesValues(ARAPObject, OrderDetails);
			Else
				StructureOrderData = New Structure;
			EndIf;
			
			ThisIsConvention = TypeOf(ARAPObject) = Type("CatalogRef.TermsOfSale")
				Or TypeOf(ARAPObject) = Type("CatalogRef.TermsOfPurchaseFromVendors")
				Or (StructureOrderData.Property("Terms", AgreementLink) And ValueIsFilled(AgreementLink));
				
			ItSDeal = TypeOf(ARAPObject) = Type("CatalogRef.SalesOpportunitiesToCustomer")
				Or (StructureOrderData.Property("SalesOpportunity", DealLink) And ValueIsFilled(DealLink));
		EndIf;
			
		If ThisIsOrder Or ThisIsConvention Or ItSDeal Then
			If ThisIsOrder And ExchangeComponents.ConversionParameters_SSLy.SettingsForAdditionalAnalyticsUnderContracts.OrderToContract Then
				
				Query = New Query;
				Query.TempTablesManager = New TempTablesManager;
				
				Query.SetParameter("Ref", OrderRef);
				Query.SetParameter("LocalAccountingCurrency", LocalAccountingCurrency(OrderRef.Organization));
				
				If TypeOf(OrderRef) = Type("DocumentRef.SalesOrder") Then
					Query.Text = 
					"SELECT
					|	SalesOrder.Ref AS Ref,
					|	SalesOrder.Counterparty AS Counterparty,
					|	SalesOrder.Organization AS Organization,
					|	SalesOrder.Date AS Date,
					|	SalesOrder.Number AS Number,
					|	SalesOrder.Currency AS Currency,
					|	SalesOrder.Presentation AS Presentation,
					|	SalesOrder.Currency <> &LocalAccountingCurrency AND NOT SalesOrder.ForeignCurrencyTransaction AS CalculationsInConventionalUnits
					|INTO TT_Document
					|FROM
					|	Document.SalesOrder AS SalesOrder
					|WHERE
					|	SalesOrder.Ref = &Ref";
					Query.Execute();
				ElsIf TypeOf(OrderRef) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
					Query.Text = 
					"SELECT
					|	RequestForReturnOfGoodsFromCustomer.Ref AS Ref,
					|	RequestForReturnOfGoodsFromCustomer.Counterparty AS Counterparty,
					|	RequestForReturnOfGoodsFromCustomer.Organization AS Organization,
					|	RequestForReturnOfGoodsFromCustomer.Date AS Date,
					|	RequestForReturnOfGoodsFromCustomer.Number AS Number,
					|	RequestForReturnOfGoodsFromCustomer.Currency AS Currency,
					|	RequestForReturnOfGoodsFromCustomer.Presentation AS Presentation,
					|	RequestForReturnOfGoodsFromCustomer.Currency <> &LocalAccountingCurrency AND NOT RequestForReturnOfGoodsFromCustomer.ForeignCurrencyTransaction AS CalculationsInConventionalUnits
					|INTO TT_Document
					|FROM
					|	Document.RequestForReturnOfGoodsFromCustomer AS RequestForReturnOfGoodsFromCustomer
					|WHERE
					|	RequestForReturnOfGoodsFromCustomer.Ref = &Ref";
					Query.Execute();
				ElsIf TypeOf(OrderRef) = Type("DocumentRef.PurchaseOrder") Then
					Query.Text = 
					"SELECT
					|	PurchaseOrder.Ref AS Ref,
					|	PurchaseOrder.Counterparty AS Counterparty,
					|	PurchaseOrder.Organization AS Organization,
					|	PurchaseOrder.Date AS Date,
					|	PurchaseOrder.Number AS Number,
					|	PurchaseOrder.Currency AS Currency,
					|	PurchaseOrder.Presentation AS Presentation,
					|	PurchaseOrder.Currency <> &LocalAccountingCurrency AND NOT PurchaseOrder.ForeignCurrencyTransaction AS CalculationsInConventionalUnits
					|INTO TT_Document
					|FROM
					|	Document.PurchaseOrder AS PurchaseOrder
					|WHERE
					|	PurchaseOrder.Ref = &Ref";
					Query.Execute();
				EndIf;
				
				If Query.TempTablesManager.Tables.Count() > 0 Then
					
					Query.Text = 
					"SELECT
					|	TT_Document.Ref AS Ref,
					|	TT_Document.Counterparty AS Counterparty,
					|	TT_Document.Organization AS Organization,
					|	TT_Document.Date AS Date,
					|	TT_Document.Number AS Number,
					|	TT_Document.Currency AS ARAPCurrency,
					|	TT_Document.Presentation AS Description,
					|	TT_Document.CalculationsInConventionalUnits AS CalculationsInConventionalUnits,
					|	CurrencyRatesCut.CourseNumerator AS TransactionRate,
					|	CurrencyRatesCut.CourseDenominator AS Multiplier_
					|FROM
					|	TT_Document AS TT_Document
					|		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&DocDate, BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
					|		ON TT_Document.Currency = CurrencyRatesCut.Currency";
					Query.SetParameter("DocDate", IBData.Date);
					Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(OrderRef.Organization));
					
					Selection = Query.Execute().Select();
					If Selection.Next() Then
						FillPropertyValues(StructureContractData, Selection);
						StructureContractData.Description = TMCommonUse.GetDocumentPresentation(OrderRef, Selection.Number, Selection.Date);
						ContractIsFilled = True;
					EndIf;
					
				EndIf;
			EndIf;
			
			If ThisIsConvention And AdditionalAnalyticsForContracts(ExchangeComponents).AgreementToContract Then
				
				Query = New Query;
				Query.TempTablesManager = New TempTablesManager;
				
				Query.SetParameter("Ref", AgreementLink);
				Query.SetParameter("LocalAccountingCurrency", LocalAccountingCurrency(AgreementLink.Organization));
				
				If TypeOf(AgreementLink) = Type("CatalogRef.TermsOfSale") Then
					Query.Text = 
					"SELECT
					|	TermsOfSale.Ref AS Ref,
					|	TermsOfSale.Counterparty AS Counterparty,
					|	TermsOfSale.Organization AS Organization,
					|	TermsOfSale.Date AS Date,
					|	TermsOfSale.Number AS Number,
					|	TermsOfSale.Currency AS ARAPCurrency,
					|	TermsOfSale.Description AS Description,
					|	TermsOfSale.Standard_ AS Standard_,
					|	TermsOfSale.Currency <> &LocalAccountingCurrency AND NOT TermsOfSale.ForeignCurrencyTransaction AS CalculationsInConventionalUnits
					|INTO TT_Terms
					|FROM
					|	Catalog.TermsOfSale AS TermsOfSale
					|WHERE
					|	TermsOfSale.Ref = &Ref";
					Query.Execute();
				ElsIf TypeOf(AgreementLink) = Type("CatalogRef.TermsOfPurchaseFromVendors") Then
					Query.Text = 
					"SELECT
					|	TermsOfPurchaseFromVendors.Ref AS Ref,
					|	TermsOfPurchaseFromVendors.Counterparty AS Counterparty,
					|	TermsOfPurchaseFromVendors.Organization AS Organization,
					|	TermsOfPurchaseFromVendors.Date AS Date,
					|	TermsOfPurchaseFromVendors.Number AS Number,
					|	TermsOfPurchaseFromVendors.Currency AS ARAPCurrency,
					|	TermsOfPurchaseFromVendors.Description AS Description,
					|	FALSE AS Standard_,
					|	TermsOfPurchaseFromVendors.Currency <> &LocalAccountingCurrency AND NOT TermsOfPurchaseFromVendors.ForeignCurrencyTransaction AS CalculationsInConventionalUnits
					|INTO TT_Terms
					|FROM
					|	Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
					|WHERE
					|	TermsOfPurchaseFromVendors.Ref = &Ref";
					Query.Execute();
				EndIf;
				
				If Query.TempTablesManager.Tables.Count() > 0 Then
					
					Query.Text = 
					"SELECT
					|	TermsOfSale.Ref AS Ref,
					|	TermsOfSale.Counterparty AS Counterparty,
					|	TermsOfSale.Organization AS Organization,
					|	TermsOfSale.Date AS Date,
					|	TermsOfSale.Number AS Number,
					|	TermsOfSale.ARAPCurrency AS ARAPCurrency,
					|	TermsOfSale.Description AS Description,
					|	TermsOfSale.CalculationsInConventionalUnits AS CalculationsInConventionalUnits,
					|	TermsOfSale.Standard_ AS Standard_,
					|	CurrencyRatesCut.CourseNumerator AS TransactionRate,
					|	CurrencyRatesCut.CourseDenominator AS Multiplier_
					|FROM
					|	TT_Terms AS TermsOfSale
					|		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&DocDate, BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
					|		ON TermsOfSale.ARAPCurrency = CurrencyRatesCut.Currency";
					Query.SetParameter("DocDate", IBData.Date);
					Query.SetParameter("BaseCurrency", LocalAccountingCurrency(AgreementLink.Organization));
					
					Selection = Query.Execute().Select();
					If Selection.Next() Then
						FillPropertyValues(StructureContractData, Selection);
						
						If Not ValueIsFilled(StructureContractData.Counterparty) Then
							If ThereAreDetailsOfInformationSecurityData(IBData, "Counterparty") Then
								StructureContractData.Counterparty = IBData.Counterparty;
							Else
								StructureContractData.Counterparty = DefaultParameters.Counterparty;
							EndIf;
						EndIf;
						
						If Not ValueIsFilled(StructureContractData.Organization) Then
							If ValueIsFilled(IBData.Organization) Then
								StructureContractData.Organization = IBData.Organization;
							Else
								StructureContractData.Organization = DefaultParameters.Organization;
							EndIf;
						EndIf;
						
						If TypeOf(AgreementLink) = Type("CatalogRef.TermsOfSale") Then
							Description = ?(Selection.Standard_, NStr("vi = 'Chung';
																		|ru = 'Типовое';
																		|en = 'Standard'; fa = 'استاندارد';
																		|it = 'Accordo tipo';
																		|pl = 'Typowe';
																		|tr = 'Standart'"), NStr("vi = 'Cá nhân';
																								|ru = 'Индивидуальное';
																								|en = 'Individual'; fa = 'شخص حقیقی';
																								|it = 'Accordi individuali';
																								|pl = 'Indywidualny';
																								|tr = 'Özelleştirilmiş'")) + "; ";
						Else
						    Description = "";
						EndIf;
						
						Description = Description + Selection.Description
							+ " " + ?(ValueIsFilled(Selection.Number), "№" + Selection.Number, "")
							+ " " + ?(ValueIsFilled(Selection.Date), NStr("vi = 'ngày';
																			|ru = 'от';
																			|en = 'dated'; fa = 'مورخ';
																			|it = 'del';
																			|pl = 'od';
																			|tr = 'itibaren'") + " " + Format(Selection.Date, "DLF=D"), "");
							
						StructureContractData.Description = TrimAll(Description);
						ContractIsFilled = True;
					EndIf;
					
				EndIf;
				
			EndIf;
			
			If ItSDeal And AdditionalAnalyticsForContracts(ExchangeComponents).TransactionToContract Then
				Query = New Query(
				"SELECT
				|	SalesOpportunitiesToCustomer.Ref,
				|	SalesOpportunitiesToCustomer.Code AS Number,
				|	"""" AS Counterparty,
				|	"""" AS Organization,
				|	SalesOpportunitiesToCustomer.StartDate AS Date,
				|	CurrencyRatesCut.Currency AS ARAPCurrency,
				|	SalesOpportunitiesToCustomer.Description AS Description,
				|	CurrencyRatesCut.CourseNumerator AS TransactionRate,
				|	CurrencyRatesCut.CourseDenominator AS Multiplier_
				|FROM
				|	Catalog.SalesOpportunitiesToCustomer AS SalesOpportunitiesToCustomer,
				|	InformationRegister.RelativeExchangeRates.SliceLast(&DocDate, Currency = &Currency AND BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
				|WHERE
				|	SalesOpportunitiesToCustomer.Ref = &Ref");
				Query.SetParameter("Ref",  DealLink);
				Query.SetParameter("DocDate", IBData.Date);
				Query.SetParameter("Currency",  DefaultParameters.ARAPCurrency);
				Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
				
				Selection = Query.Execute().Select();
				If Selection.Next() Then
					FillPropertyValues(StructureContractData, Selection);
					StructureContractData.Organization = IBData.Organization;
					If ThereAreDetailsOfInformationSecurityData(IBData, "Counterparty") Then
						StructureContractData.Counterparty = IBData.Counterparty;
					Else
						StructureContractData.Counterparty = DefaultParameters.Counterparty;
					EndIf;
					If DefaultParameters.Property("CalculationsInConventionalUnits") Then
						StructureContractData.CalculationsInConventionalUnits = DefaultParameters.CalculationsInConventionalUnits;
					EndIf;
					StructureContractData.Description = ?(ValueIsFilled(DealLink.Metadata().ObjectPresentation),
						DealLink.Metadata().ObjectPresentation, DealLink.Metadata().Synonym)
							+ ?(ValueIsFilled(Selection.Number), " " + Selection.Number, "");
					ContractIsFilled = True;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	
	If Not ContractIsFilled Then
		FillPropertyValues(StructureContractData, DefaultParameters, , "Date, Number");
		StructureContractData.Description = NStr("vi = 'Hợp đồng chính';
												|ru = 'Основной договор';
												|en = 'Main contract'; fa = 'Main contract';
												|it = 'Contratto principale';
												|pl = 'Podstawowy kontrakt';
												|tr = 'Ana sözleşme'");
	Else	
		StructureContractData.ExternalID = StructureContractData.Description;
	EndIf;
	
	AddAttributes = New ValueTable;
	AddAttributes.Columns.Add("Property");
	AddAttributes.Columns.Add("PropertyValue");
	
	AdditionalBankingDetailsLine = AddAttributes.Add();
	AdditionalBankingDetailsLine.Property = New Structure("Description", "VirtualContract");
	AdditionalBankingDetailsLine.PropertyValue = "VirtualContract";
	
	StructureContractData.Insert("AdditionalAttributes", AddAttributes);
	
	Contract = New Structure("Value, OCRName", StructureContractData, "Catalog_ContractsOfCounterparties_FromStructure");
	
