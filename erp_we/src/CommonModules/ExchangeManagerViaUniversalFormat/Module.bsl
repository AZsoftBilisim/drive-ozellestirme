Procedure PCO_Document_ApplicationForCashExpenditureSalaryPayment_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.SalaryPayment;
	ReceivedData.PaymentPriority = Catalogs.PaymentPriorities.GetDefaultPriority(Undefined);
	
	ReceivedData.Posted = True;
	
	If ReceivedData.PaymentMethodOfPaymentRequest = Enums.PaymentForms.CashAccountPayment_ Then
		ReceivedData.PayrollTransaction = Enums.BusinessTransactions.SalaryPaymentViaCashAccount;	
	ElsIf ReceivedData.PaymentMethodOfPaymentRequest = Enums.PaymentForms.BankAccountPayment Then
		// A necessary and sufficient condition for the fact that this is a salary project, we consider the fullness of the properties of the Counterparty and the Bank account.
		If XDTOData.Property("Counterparty") And ValueIsFilled(XDTOData.Counterparty)
			And XDTOData.Property("BankAccount") And ValueIsFilled(XDTOData.BankAccount) Then
			
			ReceivedData.PayrollTransaction = Enums.BusinessTransactions.SalaryPaymentByPayrollCardProgram;
		Else
			ReceivedData.PayrollTransaction = Enums.BusinessTransactions.SalaryPaymentToBankAccounts;
		EndIf;
	EndIf;
	
	ReceivedData.CashFlowItem = 
		Catalogs.CashFlowReportItems.CashFlowItemForBusinessTransaction(
			?(ReceivedData.BusinessOperation = Enums.BusinessTransactions.SalaryPayment,
				ReceivedData.PayrollTransaction, ReceivedData.BusinessOperation));
	
	PaysheetNumber	= "";
	PaysheetDate	= '00010101';
	
	DecryptionOfXDTOPayment = Undefined;
	If XDTOData.Property("ARAPDetails", DecryptionOfXDTOPayment)
		And ValueIsFilled(DecryptionOfXDTOPayment) Then
		
		PaymentDecryptionArray = New Array;
		
		If ReceivedData.PayrollTransaction = Enums.BusinessTransactions.SalaryPaymentToBankAccounts Then
			ArrayPersonalAccountsOfEmployees = New Array;
			
			FillingRules = New Structure;
			FillingRules.Insert("Employee", "Individual");
			FillingRules.Insert("BankAccount", "PersonalAccount");
			FillingRules.Insert("Sum", "Sum");
			
			TotalAmount__ = 0;
			For Each XDTOPaymentDecryptionLine In DecryptionOfXDTOPayment Do
				PaymentDecryptionLine = CollectionDataAsStructure(XDTOPaymentDecryptionLine, FillingRules);		
				ArrayPersonalAccountsOfEmployees.Add(PaymentDecryptionLine);
				
				PaysheetNumber	= XDTOPaymentDecryptionLine.PaysheetNumber;
				PaysheetDate	= XDTOPaymentDecryptionLine.PaysheetDate;
				
				TotalAmount__ = TotalAmount__ + PaymentDecryptionLine.Sum;
			EndDo;
			
			If ArrayPersonalAccountsOfEmployees.Count() > 0 Then
				ReceivedData.AdditionalProperties.Insert("PersonalAccountsOfStaff", ArrayPersonalAccountsOfEmployees);
			EndIf; 
			
			PaymentDecryptionLine = New Structure("Sum", TotalAmount__);
			PaymentDecryptionArray.Add(PaymentDecryptionLine);
		Else
			FillingRules = New Map;
			FillingRules.Insert("Sum", "Sum");
			FillingRules.Insert("CFItem", "CashFlowItem");
			
			For Each XDTOPaymentDecryptionLine In DecryptionOfXDTOPayment Do
				PaymentDecryptionLine = CollectionDataAsStructure(XDTOPaymentDecryptionLine, FillingRules);		
				PaymentDecryptionArray.Add(PaymentDecryptionLine);
				
				PaysheetNumber	= XDTOPaymentDecryptionLine.PaysheetNumber;
				PaysheetDate	= XDTOPaymentDecryptionLine.PaysheetDate;
			EndDo;
		EndIf;
		
		If PaymentDecryptionArray.Count() > 0 Then
			ReceivedData.AdditionalProperties.Insert("ARAPDetails", PaymentDecryptionArray);
		EndIf;
	EndIf;
	
	ReceivedData.AdditionalProperties.Insert("PaysheetNumber",	PaysheetNumber);
	ReceivedData.AdditionalProperties.Insert("PaysheetDate",	PaysheetDate);
EndProcedure
Procedure OCR_Document_RequestForCashExpensePaymentOfSalary_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If Not IBData = Undefined Then 
		StatusIsChanged = False;
		For Each String In ReceivedData.ARAPDetails Do
			Filter = New Structure;
			Filter.Insert("Sum", String.Sum); 
			Found_Strings = IBData.ARAPDetails.FindRows(Filter);
			If Found_Strings.Count() = 0 Then
				StatusIsChanged = True;
			EndIf;
		EndDo;
		If Not StatusIsChanged Then
			ReceivedData.Status = IBData.Status;
		EndIf;
	EndIf;
EndProcedure

