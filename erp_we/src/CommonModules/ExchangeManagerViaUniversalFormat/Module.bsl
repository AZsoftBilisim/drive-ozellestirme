Procedure OCR_Document_SaleAdjustment_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	ConsignmentSalesAreSupported = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_ImplementationAdjustment_Dispatch", 
		"Goods", 
		"CCDNumber",
		True,
		"Catalog_CCDNumbers_Send");
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_ImplementationAdjustment_Dispatch", 
		"Goods", 
		"CCDNumberBeforeChange",
		True,
		"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_ImplementationAdjustment_Dispatch", 
		"Goods", 
		"VATRate",
		True,
		"CatalogLink_BIDS_Sending"); 
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_ImplementationAdjustment_Dispatch", 
		"Services", 
		"VATRate",
		True,
		"CatalogLink_BIDS_Sending");
		
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_ImplementationAdjustment_Dispatch", 
		"Goods", 
		"VATRateBeforeChange",
		True,
		"CatalogLink_BIDS_Sending"); 
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_ImplementationAdjustment_Dispatch", 
		"Services", 
		"VATRateBeforeChange",
		True,
		"CatalogLink_BIDS_Sending");
		
	EndIf;
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False, False);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	// Data from the original implementation document
	QueryText =
	"SELECT
	|	Doc.SalesOrder AS SalesOrder,
	|	Doc.ToReturnReusablePackage AS ToReturnReusablePackage,
	|	DocCustomerOrder.Date AS Date,
	|	DocCustomerOrder.Ref AS Ref,
	|	DocCustomerOrder.Number AS Number,
	|	DocCustomerOrder.Organization AS Organization
	|FROM
	|	Document.CustomerInvoice AS Doc
	|		LEFT JOIN Document.SalesOrder AS DocCustomerOrder
	|		ON Doc.SalesOrder = DocCustomerOrder.Ref
	|WHERE
	|	Doc.Ref = &DocumentBasis
	|
	|UNION ALL
	|
	|SELECT
	|	Doc.SalesOrder,
	|	FALSE,
	|	DocSalesOrder.Date,
	|	DocSalesOrder.Ref,
	|	DocSalesOrder.Number,
	|	DocSalesOrder.Organization
	|FROM
	|	Document.CustomerInvoiceServices AS Doc
	|		LEFT JOIN Document.SalesOrder AS DocSalesOrder
	|		ON Doc.SalesOrder = DocSalesOrder.Ref
	|WHERE
	|	Doc.Ref = &DocumentBasis";
	
	// Link to the document being corrected
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	SaleAdjustment.Ref AS Ref,
	|	SaleAdjustment.PointInTime AS PointInTime,
	|	MAX(CASE
	|			WHEN &InternationalVersion
	|				THEN FALSE
	|			ELSE TRUE
	|		END) AS Corrective,
	|	FALSE AS ThisIsFoundationDocument,
	|	SaleAdjustment.AdjustingEntryType AS AdjustingEntryType,
	|	SaleAdjustment.AdjustmentKind AS AdjustmentKind
	|INTO SequenceDocumentParameters
	|FROM
	|	Document.SaleAdjustment AS SaleAdjustment
	|WHERE
	|	SaleAdjustment.Posted
	|	AND SaleAdjustment.PointInTime <= &PointInTime
	|	AND SaleAdjustment.DocumentBasis = &DocumentBasis
	|
	|GROUP BY
	|	SaleAdjustment.Ref,
	|	SaleAdjustment.PointInTime,
	|	SaleAdjustment.AdjustingEntryType,
	|	SaleAdjustment.AdjustmentKind
	|
	|UNION ALL
	|
	|SELECT
	|	SaleAdjustment.DocumentBasis,
	|	SaleAdjustment.DocumentBasis.PointInTime,
	|	MAX(CASE
	|			WHEN &InternationalVersion
	|				THEN FALSE
	|			ELSE TRUE
	|		END),
	|	TRUE,
	|	SaleAdjustment.AdjustingEntryType,
	|	SaleAdjustment.AdjustmentKind
	|FROM
	|	Document.SaleAdjustment AS SaleAdjustment
	|WHERE
	|	SaleAdjustment.Ref = &Ref
	|
	|GROUP BY
	|	SaleAdjustment.DocumentBasis,
	|	SaleAdjustment.AdjustingEntryType,
	|	SaleAdjustment.AdjustmentKind,
	|	SaleAdjustment.DocumentBasis.PointInTime
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Parameters1.Ref AS Ref,
	|	Parameters1.Corrective AS Corrective,
	|	MIN(CASE
	|			WHEN Parameters1.Corrective
	|					AND NOT Parameters2.Corrective
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS InitialAdjustment
	|INTO FilterParameters
	|FROM
	|	SequenceDocumentParameters AS Parameters1
	|		INNER JOIN SequenceDocumentParameters AS Parameters2
	|		ON (Parameters1.Ref = &Ref)
	|			AND (Parameters2.Ref <> &Ref)
	|
	|GROUP BY
	|	Parameters1.Ref,
	|	Parameters1.Corrective
	|
	|INDEX BY
	|	Parameters1.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	CorrectedDocuments.Ref AS Ref,
	|	CorrectedDocuments.PointInTime AS PointInTime
	|INTO CorrectedDocument
	|FROM
	|	SequenceDocumentParameters AS CorrectedDocuments
	|		INNER JOIN FilterParameters AS FilterParameters
	|		ON (CorrectedDocuments.Corrective = FilterParameters.Corrective
	|				OR FilterParameters.InitialAdjustment
	|				OR CorrectedDocuments.ThisIsFoundationDocument)
	|			AND CorrectedDocuments.Ref <> FilterParameters.Ref
	|
	|ORDER BY
	|	CorrectedDocuments.PointInTime DESC
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	CorrectedDocuments.Ref AS Ref,
	|	CorrectedDocuments.PointInTime AS PointInTime,
	|	CorrectedDocuments.Ref.Date AS Date,
	|	CorrectedDocuments.Ref.Organization AS Organization,
	|	CorrectedDocuments.Ref.Number AS Number,  
	|	CorrectedDocuments.AdjustmentKind AS AdjustmentKind,
	|	FilterParameters.InitialAdjustment AS InitialAdjustment
	|FROM
	|	SequenceDocumentParameters AS CorrectedDocuments
	|		INNER JOIN FilterParameters AS FilterParameters
	|		ON CorrectedDocuments.Ref <> FilterParameters.Ref
	|
	|ORDER BY
	|	CorrectedDocuments.PointInTime DESC";
	
	// Link to the basis of the correction (correction) and the document before the correction
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT TOP 1
	|	CorrectedDocuments.Ref AS Ref,
	|	CorrectedDocuments.PointInTime AS PointInTime
	|INTO DocumentBeforeAdjustment
	|FROM
	|	SequenceDocumentParameters AS CorrectedDocuments
	|		INNER JOIN FilterParameters AS FilterParameters
	|		ON (FilterParameters.Corrective)
	|			AND (NOT FilterParameters.InitialAdjustment)
	|			AND (NOT CorrectedDocuments.Corrective)
	|			AND CorrectedDocuments.Ref <> FilterParameters.Ref
	|
	|ORDER BY
	|	CorrectedDocuments.ThisIsFoundationDocument,
	|	CorrectedDocuments.PointInTime DESC";
	
	// The goods of the original implementation
	
	QueryText = QueryText + Common.QueryBatchSeparator() +
	"SELECT
	|	SaleAdjustmentGoods.Products AS Products,
	|	SaleAdjustmentGoods.Characteristic AS Characteristic,
	|	SaleAdjustmentGoods.Series AS Series,
	|	SaleAdjustmentGoods.Package AS Package,
	|	SaleAdjustmentGoods.VATRate AS VATRate,
	|	SaleAdjustmentGoods.CCDNumber AS CCDNumber,
	|	ISNULL(SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment.InventoryOwnerAttribute.InventoryType, ISNULL(AdjustmentOfRealizationTypesOfStocksRecording.InventoryOwnerAttribute.InventoryType, AdjustmentOfSalesTypesOfInventoryWriteOff.InventoryOwnerAttribute.InventoryType)) AS InventoryType,
	|	SaleAdjustmentGoods.Count AS Count,
	|	SaleAdjustmentGoods.NumberOfPackages - SaleAdjustmentDiscrepancies.NumberOfPackages AS NumberOfPackages,
	|	SaleAdjustmentGoods.QuantityByGBRN AS QuantityByGBRN,
	|	SaleAdjustmentGoods.AmountIncludingVAT AS AmountIncludingVAT,
	|	SaleAdjustmentGoods.VATAmount AS VATAmount,
	|	SaleAdjustmentGoods.Ref.AdjustingEntryType AS AdjustingEntryType,
	|	SaleAdjustmentDiscrepancies.Products.ItemsType AS ItemsType,
	|	SaleAdjustmentGoods.Ref AS Ref,
	|	SaleAdjustmentGoods.LineNumber AS LineNumber,
	|	SaleAdjustmentGoods.Sum AS Sum,
	|	SaleAdjustmentDiscrepancies.PostingOption AS PostingOption
	|INTO ProductsForBalanceEntryAdjustments
	|FROM
	|	SequenceDocumentParameters AS SequenceDocumentParameters
	|		LEFT JOIN Document.SaleAdjustment.Goods AS SaleAdjustmentGoods
	|			INNER JOIN Document.SaleAdjustment.Discrepancies AS SaleAdjustmentDiscrepancies
	|			ON SaleAdjustmentGoods.Ref = SaleAdjustmentDiscrepancies.Ref
	|				AND SaleAdjustmentGoods.Products = SaleAdjustmentDiscrepancies.Products
	|				AND SaleAdjustmentGoods.Characteristic = SaleAdjustmentDiscrepancies.Characteristic
	|				AND SaleAdjustmentGoods.LineNumber = SaleAdjustmentDiscrepancies.LineNumber
	|			LEFT JOIN Document.SaleAdjustment.InventoryOwnerAttributesRevenueAdjustment AS SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment
	|			ON SaleAdjustmentGoods.Ref = SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment.Ref
	|				AND SaleAdjustmentGoods.Products = SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment.ItemsLocationAttributes.Products
	|				AND SaleAdjustmentGoods.Characteristic = SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment.ItemsLocationAttributes.Characteristic
	|				AND SaleAdjustmentGoods.Series = SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment.ItemsLocationAttributes.Series
	|			LEFT JOIN Document.SaleAdjustment.InventoryOwnerAttributesGoodsReceipt AS AdjustmentOfRealizationTypesOfStocksRecording
	|			ON SaleAdjustmentGoods.Ref = AdjustmentOfRealizationTypesOfStocksRecording.Ref
	|				AND SaleAdjustmentGoods.Products = AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Products
	|				AND SaleAdjustmentGoods.Characteristic = AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Characteristic
	|				AND SaleAdjustmentGoods.Series = AdjustmentOfRealizationTypesOfStocksRecording.ItemsLocationAttributes.Series
	|			LEFT JOIN Document.SaleAdjustment.InventoryOwnerAttributesConsumption AS AdjustmentOfSalesTypesOfInventoryWriteOff 
	|			ON SaleAdjustmentGoods.Ref = AdjustmentOfSalesTypesOfInventoryWriteOff.Ref
	|			AND (AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Products = SaleAdjustmentGoods.Products)
	|			AND (AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Characteristic = SaleAdjustmentGoods.Characteristic)
	|			AND (AdjustmentOfSalesTypesOfInventoryWriteOff.ItemsLocationAttributes.Series = SaleAdjustmentGoods.Series)
	|		ON SequenceDocumentParameters.Ref = SaleAdjustmentGoods.Ref
	|WHERE
	|	SequenceDocumentParameters.AdjustingEntryType = VALUE(Enum.AdjustingEntryTypes.AdjustmentByGoodsAndServices)
	|	AND SequenceDocumentParameters.Ref REFS Document.SaleAdjustment
	|
	|GROUP BY
	|	SaleAdjustmentGoods.Products,
	|	SaleAdjustmentGoods.Characteristic,
	|	SaleAdjustmentGoods.Series,
	|	SaleAdjustmentGoods.Package,
	|	SaleAdjustmentGoods.CCDNumber,
	|	SaleAdjustmentGoods.Count,
	|	SaleAdjustmentGoods.NumberOfPackages - SaleAdjustmentDiscrepancies.NumberOfPackages,
	|	SaleAdjustmentGoods.QuantityByGBRN,
	|	SaleAdjustmentGoods.AmountIncludingVAT,
	|	SaleAdjustmentGoods.VATAmount,
	|	SaleAdjustmentGoods.Ref.AdjustingEntryType,
	|	SaleAdjustmentDiscrepancies.Products.ItemsType,
	|	ISNULL(SaleAdjustmentInventoryOwnerAttributesRevenueAdjustment.InventoryOwnerAttribute.InventoryType, ISNULL(AdjustmentOfRealizationTypesOfStocksRecording.InventoryOwnerAttribute.InventoryType, AdjustmentOfSalesTypesOfInventoryWriteOff.InventoryOwnerAttribute.InventoryType)),
	|	SaleAdjustmentGoods.Ref,
	|	SaleAdjustmentGoods.VATRate,
	|	SaleAdjustmentGoods.LineNumber,
	|	SaleAdjustmentGoods.Sum,
	|	SaleAdjustmentDiscrepancies.PostingOption  
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.ItemsLocationAttributes.Products AS Products,
	|	Goods.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	Goods.ItemsLocationAttributes.Series AS Series,
	|	Goods.Package AS Package,
