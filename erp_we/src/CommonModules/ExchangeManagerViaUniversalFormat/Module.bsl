Procedure PCO_Catalog_DiscountCards_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If Not IBData = Undefined Then
		ReceivedData.Owner = IBData.Owner;
	
		CardType = Common.ObjectAttributeValue(IBData.Owner, "CardType");
		If CardType = Enums.CardTypes.Barcode_ Then
			IBData.Barcode = ReceivedData.Barcode;
		ElsIf CardType = Enums.CardTypes.Magnetic Then
			IBData.MagneticCode = ReceivedData.MagneticCode;
		ElsIf Not (IBData.Barcode = ReceivedData.Barcode Or IBData.MagneticCode = ReceivedData.MagneticCode) Then
			IBData.Barcode     = ReceivedData.Barcode;
			IBData.MagneticCode = ReceivedData.MagneticCode;
		EndIf;
	EndIf;
EndProcedure

