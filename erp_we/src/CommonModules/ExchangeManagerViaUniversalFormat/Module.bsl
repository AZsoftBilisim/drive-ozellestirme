		XDTOData.Insert("MainCounterparty", IBData.MainCounterparty);
	Else
		XDTOData.Insert("MainCounterparty", Undefined);
	EndIf;
	PrepareDataContactInformation(IBData, XDTOData, ExchangeComponents);
	If Not ValueIsFilled(IBData.CompanyIndividual) Then
		If XDTOData.Property("KeyProperties") Then
		   	XDTOData.KeyProperties.Insert("CompanyIndividual", "Individual");
		EndIf;
	EndIf;
	
	PropertyNameRegNumber = "NonResidentRegistrationNumber";
	 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		IndividualEntrepreneur = IBData.LegalEntityIndividual = Enums.LegalEntityIndividual.IndividualEntrepreneur;
		XDTOData.KeyProperties.Insert("IndividualEntrepreneur", IndividualEntrepreneur);
		
		PropertyNameRegNumber = "RegistrationNumber";
	EndIf;
	
	XDTOData.KeyProperties.Insert(PropertyNameRegNumber, IBData.RegistrationNumber);
	//Dataxdto.Insert("OGRN", dataeib.Registration number); 
	XDTOData.Insert("AdditionalInformation", IBData.AdditionalInformation);
	UploadYourBankingDetailsHistory(IBData, XDTOData, ExchangeComponents);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
EndProcedure

