Procedure AddPOD_Catalog_DiscountCards_Sending(DataProcessingRules)
	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Catalog_DiscountCards_Sending";
	ProcessingRule.SelectionObjectMetadata = Metadata.Catalogs.LoyaltyCards;
	ProcessingRule.OnProcess            = "POD_Catalog_DiscountCards_Sending_DuringProcessing";
	ProcessingRule.DataClearing           = False;
	ProcessingRule.OCRUsed.Add("Catalog_DiscountCards_Sending");
EndProcedure
Procedure POD_Catalog_DiscountCards_Sending_DuringProcessing(IBData, UsageOCR, ExchangeComponents)
	DataMapView = Common.ObjectAttributesValues(
					IBData.Owner, "CardType, LoyaltyProgram, Personalized");
	
	CardNumber = "";				
	If DataMapView.CardType = Enums.CardTypes.Barcode_ Then
		CardNumber = IBData.Barcode;
	ElsIf DataMapView.CardType = Enums.CardTypes.Magnetic Then
		CardNumber = IBData.MagneticCode;
	Else
		If ValueIsFilled(IBData.Barcode) Then
			CardNumber = IBData.Barcode;
		ElsIf ValueIsFilled(IBData.MagneticCode) Then
			CardNumber = IBData.MagneticCode;
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(CardNumber) Or Not DataMapView.Personalized Then
		UsageOCR.Clear();
		Return;
	EndIf;
	If Not ValueIsFilled(IBData.Partner) Then
	     IBData.Partner = Catalogs.Partners.UnknownPartner;
	EndIf;
	IBData.AdditionalProperties.Insert("CardNumber", CardNumber);
	
	If ValueIsFilled(DataMapView.LoyaltyProgram) Then
		IBData.AdditionalProperties.Insert("LoyaltyProgram_", DataMapView.LoyaltyProgram);
	EndIf;
EndProcedure

