			UsageOCR.Catalog_Persons_Send       = False;
			UsageOCR.Catalog_IndividualsGroup_Sending = False;
			
			WarningTemplate = NStr("vi = 'Không thể kết xuất chủ thể %1,
			|bởi vì dữ liệu cá nhân đã bị ẩn.';
			|ru = 'Субъект %1 не может быть выгружен,
			|т.к. его персональные данные скрыты.';
			|en = 'The %1 subject cannot be exported
			|as personal data is hidden.'; fa = 'The %1 subject cannot be exported
			|as personal data is hidden.';
			|it = 'Il soggetto %1 non può essere caricato,
			|poiché i suoi dati personali sono nascosti.';
			|pl = 'Podmiot %1 nie może być wyeksportowany,
			|ponieważ jego dane osobowe są ukryte.';
			|tr = '%1 öznesi yüklenemez
			|çünkü onun kişisel verileri gizlidir.'");
			
			WarningText = StringFunctionsClientServer.SubstituteParametersToString(WarningTemplate, IBData.Ref);
			SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
			
			Return;
			
		EndIf;
		
	EndIf;
	 
	UsageOCR.Catalog_Persons_Send       = Not IBData.IsFolder;
	UsageOCR.Catalog_IndividualsGroup_Sending = IBData.IsFolder;
EndProcedure

