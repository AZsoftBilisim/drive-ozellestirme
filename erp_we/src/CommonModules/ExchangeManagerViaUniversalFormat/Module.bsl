Procedure PCO_Document_InternalConsumption_Operation_Otpa_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False, False);
	
	QueryText =
		"SELECT
			|	Goods.LineNumber AS DocumentRowNumber,
			|	Goods.Products AS Products,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextPackage,
			|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
			|	Goods.Count AS Count,
			|	&InventoryType AS InventoryType,
			|	Goods.Individual AS Individual,
			|	Goods.Ref.Department AS Department,
			|	Goods.ExpenseItem.OffsettingAccount AS ExpenseItemCorAccount,
			|	Goods.ExpenseItem.Description AS ItemOfExpenditureName,
			|	Goods.ExpenseItem AS CostItem,
			|	Goods.AssetID AS AssetID
			|FROM
			|	Document.InventoryConsumption.Goods AS Goods
			|WHERE
			|	Goods.Ref = &Ref";
		
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "Goods"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Goods"));
	
	InventoryTypeInRequest = "&OwnProducts";
	QueryText = StrReplace(QueryText, "&InventoryType", InventoryTypeInRequest);
	
	FillInYourOwnProductsInText(QueryText);
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Period", IBData.Date);
	GoodsTable = Query.Execute().Unload();
	GoodsTable.Columns.Add("NameOfPurposeOfUse");
	GoodsTable.Columns.Add("NameOfMethodForReflectingExpenses");
	GoodsTable.Columns.Add("CostDivision");
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsTable);
	
	For Each String In GoodsTable Do
		
		String.NameOfMethodForReflectingExpenses = String.ItemOfExpenditureName;
	
		If ValueIsFilled(String.ExpenseItemCorAccount) Then
			NameOfMethodForReflectingExpenses = StringFunctionsClientServer.SubstituteParametersToString(
	    		NStr("vi = '%1 tài khoản( %2)';
					|ru = '%1 счет( %2)';
					|en = '%1 account( %2)'; fa = '%1 account( %2)';
					|it = '%1 conto( %2)';
					|pl = '%1 konto( %2)';
					|tr = '%1 hesap (%2)'"),
	    		TrimAll(String.NameOfMethodForReflectingExpenses),
	    		String.ExpenseItemCorAccount);
			String.NameOfMethodForReflectingExpenses = NameOfMethodForReflectingExpenses;
		EndIf;
		
		If ValueIsFilled(String.Department) Then
			StructureDivision = New Structure;
			UnloadDivision(IBData, StructureDivision, String.Department);
			String.CostDivision = StructureDivision.Department;
		EndIf;
	
	EndDo;
	
	XDTOData.Insert("Goods", GoodsTable);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.InventoryConsumption.SetOfSeries", XDTOData);
	EndIf;
EndProcedure

