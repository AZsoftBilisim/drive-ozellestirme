Function PropertyOfExchangeFormat(ExchangeComponents, PropertyName)
	Result = False;
	
	Namespace = ExchangeComponents.XMLSchema;
	
	If XDTOFactory.Type(New XMLDataType(PropertyName, Namespace)) <> Undefined Then
		Result = True;
	Else
		RowsArray = CommonClientServer.ParseStringByDotsAndSlashes(PropertyName);
		
		If RowsArray.Count() > 1 Then
			ObjectName = RowsArray[0] + "." + RowsArray[1];
			FactoryType = XDTOFactory.Type(New XMLDataType(ObjectName, Namespace));
			If FactoryType <> Undefined Then
				For Cnt = 2 To RowsArray.Count() - 1 Do
					NameOfCurObject = RowsArray[Cnt];
					If TypeOf(FactoryType) = Type("XDTOProperty") Then
						FactoryType = FactoryType.Type.Properties.Get(NameOfCurObject);
					Else
						FactoryType = FactoryType.Properties.Get(NameOfCurObject);
					EndIf;
					If FactoryType = Undefined Then
						Return False;
					EndIf
				EndDo;
				Result = FactoryType <> Undefined;
			EndIf;
		EndIf;
	EndIf;
	
	Return Result;
EndFunction
// Parameters:
//  PartnerObject_ - CatalogObject.Partners - the object of the information base.
//  Counterparty - CatalogObject.Counterparties - the object of the information base.
//  ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//
Procedure SynchronizePartnerDataWithCounterpartyData(PartnerObject_, Counterparty, ExchangeComponents)
	If PartnerObject_.IsNew() Then
		PartnerObject_.RegistrationDate = Date('19800101');
		PartnerObject_.Client          = True;
		PartnerObject_.Vendor       = True;
		PartnerObject_.OtherRelations = True;
		PartnerObject_.AccessGroup   = DefaultElement(ExchangeComponents, "PartnerAccessGroup");
		
		PartnerObject_.SetNewCode();
	EndIf;
	
	// Synchronization of counterparty and partner properties.
	If PartnerObject_.Ref <> Catalogs.Partners.UnknownPartner Then
		
		PartnerObject_.Description        = Counterparty.Description;
		PartnerObject_.DescriptionFull  = Counterparty.DescriptionFull;
		If Counterparty.LegalEntityIndividual = Enums.LegalEntityIndividual.Person Then
			PartnerObject_.LegalEntityIndividual = Enums.IndividualCompany.Person_;
		Else
			PartnerObject_.LegalEntityIndividual = Enums.IndividualCompany.Company;
		EndIf;
		
		PartnerObject_.ContactInformation.Clear();
		For Each CounterpartyKiString In Counterparty.ContactInformation Do
			
			If CounterpartyKiString.Kind = Catalogs.ContactInformationKinds.EmailCounterparty_ Then
				PartnerSKiType = Catalogs.ContactInformationKinds.EmailPartner_;
			ElsIf CounterpartyKiString.Kind = Catalogs.ContactInformationKinds.CounterpartySPhoneNumber Then
				PartnerSKiType = Catalogs.ContactInformationKinds.PartnerSPhoneNumber;
			ElsIf CounterpartyKiString.Kind = Catalogs.ContactInformationKinds.LegalAddressOfCounterparty Then
				PartnerSKiType = Catalogs.ContactInformationKinds.PartnerAddress;
			Else
				Continue;
			EndIf;
			
			PartnerKiString = PartnerObject_.ContactInformation.Add();
			FillPropertyValues(PartnerKiString, CounterpartyKiString);
			PartnerKiString.Kind = PartnerSKiType;
			
		EndDo;
		
		PartnerObject_.DeletionMark = False;
		
		PartnerObject_.DataExchange.Load = True;
		PartnerObject_.Write();
		
		PartnersAndCounterparties.RecordPartnerHierarchy(PartnerObject_.Ref);
		
	EndIf;
EndProcedure
