Procedure OCR_Document_WriteOffReportFromCommissionAgent_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "S";
	XDTOData.KeyProperties.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7));
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CommissionAgentSReportOnDebiting_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CommissionAgentSReportOnDebiting_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then	
		XDTOData.KeyProperties.Insert("TypeOfOperationOfCommissionaireSReport", "WriteOffOfGoodsForCommissions"); 
	EndIf;
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty = IBData.Counterparty;
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.ARAPCurrency = IBData.Currency;
		DefaultParameters.TypeOfAgreement = "WithConsignee";
		DefaultParameters.Date = IBData.Date;
		DefaultParameters.Number = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = False;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", Undefined, IBData.Terms, Undefined);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
	EndIf;
	
	UnloadDivision(IBData, XDTOData);
	
	UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
	
	XDTOData.Insert("MethodOfCalculationOfCommission", "NotCalculating");
	XDTOData.Insert("AmountIncludesVAT", True);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		XDTOData.Insert("BeginningOfReportPeriod",    IBData.BeginOfPeriod);
		XDTOData.Insert("EndOfReportPeriod_", IBData.EndOfPeriod);
	EndIf;
	
	Query = New Query();
	Query.Text = "SELECT
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Products,
		|	Goods.Characteristic,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Count,
		|	&QueryTextProductBatchID,
		|	CASE
		|		WHEN Goods.AmountIncludingVAT / Goods.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(Goods.AmountIncludingVAT / Goods.Count AS NUMBER(31, 2))
		|	END AS Price,
		|	Goods.AmountIncludingVAT AS Sum,
		|	Goods.VATRate AS VATRate,
		|	Goods.VATAmount,
		|	1 AS RowKey
		|FROM
		|	Document.WriteOffReportFromCommissionAgent.Goods AS Goods
		|WHERE
		|	Goods.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.Count AS Count,
		|	&FilledInCCDNumber,
		|	&FilledCountry,
		|	&TypesOfStocksTextOfRNPTRequest,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType
		|FROM
		|	Document.WriteOffReportFromCommissionAgent.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref";
		
	FillInYourOwnProductsInText(Query.Text);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		FilledInCCDNumber = "InventoryKinds.CCDNumber AS CCDNumber";
		FilledCountry = "VALUE(Catalog.WorldCountries.EmptyRef) AS OriginCountry";
	Else
		FilledInCCDNumber = "InventoryKinds.CCDNumber.Code AS CCDNumber";
		FilledCountry = "InventoryKinds.CCDNumber.OriginCountry AS OriginCountry";
	EndIf;
	Query.Text = StrReplace(Query.Text, "&FilledInCCDNumber", FilledInCCDNumber);
	Query.Text = StrReplace(Query.Text, "&FilledCountry", FilledCountry);
	
	Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	Query.Text = StrReplace(Query.Text, "&TypesOfStocksTextOfRNPTRequest",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	Query.SetParameter("Ref", IBData.Ref);
	QueryResults = Query.ExecuteBatch();
	TabProducts = QueryResults[0].Unload(); // ValueTable
	TabProducts.Columns.Add("CCDNumber");
	TabProducts.Columns.Add("OriginCountry");
	TabProducts.Columns.Add("AmountVATRemuneration");
	TabProducts.Columns.Add("InventoryType");
	TabProducts.Indexes.Add("Products, Characteristic, CCDNumber");
	TheStructureOfTheSearch = New Structure;
	TheStructureOfTheSearch.Insert("Products", Undefined);
	TheStructureOfTheSearch.Insert("Characteristic", Undefined);
	TheStructureOfTheSearch.Insert("CCDNumber", Undefined);
	InventoryKinds = QueryResults[1].Select();
	While InventoryKinds.Next() Do
		TheStructureOfTheSearch.Products   = InventoryKinds.Products;
		TheStructureOfTheSearch.Characteristic = InventoryKinds.Characteristic;
		FoundRows = TabProducts.FindRows(TheStructureOfTheSearch);
		RemainingInventoryKinds = InventoryKinds.Count;
		For Each DocumentLine In FoundRows Do
			If RemainingInventoryKinds = 0 Then
				Break;
			EndIf;
			If DocumentLine.Count <= RemainingInventoryKinds Then
				FillPropertyValues(DocumentLine, InventoryKinds, "CCDNumber, OriginCountry, InventoryType");
				RemainingInventoryKinds = RemainingInventoryKinds - DocumentLine.Count;
			Else
				// We select a new line from the document line with a certain type of inventory
				NewRow = TabProducts.Add();
				FillPropertyValues(NewRow, DocumentLine);
				PercentageOfInventoryTypeInDocumentLine = RemainingInventoryKinds / DocumentLine.Count;
				NewRow.Count 					= RemainingInventoryKinds;
				NewRow.Sum      					= Round(DocumentLine.Sum * PercentageOfInventoryTypeInDocumentLine, 2);
				NewRow.VATAmount   					= Round(DocumentLine.VATAmount * PercentageOfInventoryTypeInDocumentLine, 2);
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
					NewRow.NumberOfRNPT        = Round(DocumentLine.NumberOfRNPT * PercentageOfInventoryTypeInDocumentLine, 2);
				EndIf;
				FillPropertyValues(NewRow, InventoryKinds, "CCDNumber, OriginCountry, InventoryType");
				DocumentLine.Count				= DocumentLine.Count - NewRow.Count;
				DocumentLine.Sum					= DocumentLine.Sum - NewRow.Sum;
				DocumentLine.VATAmount				= DocumentLine.VATAmount - NewRow.VATAmount;
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
					DocumentLine.NumberOfRNPT    = DocumentLine.NumberOfRNPT - NewRow.NumberOfRNPT;
				EndIf;
				DocumentLine.RowKey 				= 1;
				RemainingInventoryKinds = 0;
			EndIf;
		EndDo;
	EndDo;
	TabProducts.Sort("DocumentRowNumber Asc");
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, TabProducts, True, False);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(TabProducts, False);
	EndIf;
	XDTOData.Insert("Goods", TabProducts);
	Tobacco_ = New ValueTable;
	Tobacco_.Columns.Add("SetSF");
	Tobacco_.Columns.Add("Customer");
	Tobacco_.Columns.Add("RowKey");
	NewRow = Tobacco_.Add();
	NewRow.SetSF	= False;
	NewRow.Customer	= IBData.Counterparty;
	NewRow.RowKey	= 1;
	XDTOData.Insert("Buyers", Tobacco_);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

