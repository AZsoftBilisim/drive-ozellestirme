		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_PBDSSettlementsWithCounterparties_Sending", 
										"ARAPDetails", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	If TrimAll(IBData.IncomingDocumentNumber) = "-" Then
		// The "-" symbol is put down artificially if a document with an empty number is loaded from the PSU.
		XDTOData.IncomingDocumentNumber = "";
	EndIf;
	
	// Counterparty and bank account
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany
		Or  IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromAnotherCompany Then
		CounterpartyData = GetCounterpartyDataForOrganizationSBankAccount(IBData.SenderBankAccount, ExchangeComponents);
		XDTOData.Insert("Counterparty", CounterpartyData.Counterparty);
		XDTOData.Insert("CounterpartyBankAccount", CounterpartyData.CounterpartyBankAccount);
	Else
		XDTOData.Insert("Counterparty", IBData.Counterparty);
		XDTOData.Insert("CounterpartyBankAccount", IBData.CounterpartyBankAccount);
	EndIf;
		
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
	
	LocalAccountingCurrency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	FormatVersion = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion);
	ConversionAlgorithm = UploadAlgorithmSettlementsWithCounterpartiesSending(IBData, FormatVersion);
	XDTOData.Insert("ARAPType", TypeOfSettlementsWithCounterpartyReceipt(ExchangeComponents, ConversionAlgorithm));
	UploadDecryptionCounterparties_ReceiptOfCash(IBData, XDTOData, ConversionAlgorithm, ExchangeComponents);
EndProcedure

