Procedure PCO_Document_EnteringBalancesOfGoodsOfOwnTM_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_EnteringBalanceOfGoodsOfOwnTM_Sending", 
										"INVENTORY", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_EnteringBalanceOfGoodsOfOwnTM_Sending", 
										"INVENTORY", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	QueryText = 
		"SELECT
		|	EnteringProductBalances.Products AS Products,
		|	CASE
		|		WHEN EnteringProductBalances.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryOwnerAttribute,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	CASE
		|		WHEN PackagesAndUnitsOfMeasure.Ref IS NULL
		|				OR PackagesAndUnitsOfMeasure.Denominator = 0
		|			THEN EnteringProductBalances.Count
		|		ELSE CAST(EnteringProductBalances.Count * (PackagesAndUnitsOfMeasure.Numerator / PackagesAndUnitsOfMeasure.Denominator) AS NUMBER(18, 2))
		|	END AS Count,
		|	EnteringProductBalances.VATRate AS VATRate,
		|	CASE
		|		WHEN NOT EnteringProductBalances.AmountExcludingVAT = 0
		|			THEN EnteringProductBalances.AmountExcludingVAT
		|		ELSE CASE
		|				WHEN EnteringProductBalances.Count > 0
		|					THEN -0.01
		|				ELSE 0.01
		|			END
		|	END AS AmountExcludingVAT,
		|	EnteringProductBalances.VATAmount AS VATAmount,
		|	EnteringProductBalances.RowID,
		|	CatProducts.UnitOfMeasure AS UnitOfMeasure
		|FROM
		|	Document.OBEntryGoods.Goods AS EnteringProductBalances
		|		LEFT JOIN Catalog.Products AS CatProducts
		|		ON EnteringProductBalances.Products = CatProducts.Ref
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		|		ON EnteringProductBalances.Package = PackagesAndUnitsOfMeasure.Ref
		|WHERE
		|	EnteringProductBalances.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "EnteringProductBalances"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "EnteringProductBalances"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "EnteringProductBalances"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "EnteringProductBalances"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "EnteringProductBalances"));
		
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);  
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("INVENTORY", Goods);
EndProcedure

