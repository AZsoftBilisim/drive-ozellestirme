	ProcessingRule.OnProcess            = "POD_Document_RequestForTransferOfDSVBudget_Receipt_DuringProcessing";
	ProcessingRule.OCRUsed.Add("Document_RequestForTransferOfDSVBudget_Receipt");
	ProcessingRule.OCRUsed.Add("Document_RequestForTransferOfDSVBudgetVSBDS_Receipt");
	ProcessingRule.OCRUsed.Add("Document_ApplicationForTransferOfDSVBudgetFrom__Receipt");
	ProcessingRule.OCRUsed.Add("Document_RequestForTransferOfDSVBudgetsOfSBDSExceeded_Receipt");
EndProcedure
Procedure POD_Document_RequestForTransferOfDSVBudget_Receipt_DuringProcessing(XDTOData, UsageOCR, ExchangeComponents)
	UseCashSpendingRequests = GetFunctionalOption("UsePaymentRequests");
		
	If XDTOData.Property("ApprovedPaymentDate") Then
		ApprovedPaymentDate = XDTOData.ApprovedPaymentDate;
	Else	
		ApprovedPaymentDate = Date(1,1,1) ;
	EndIf;
	
	If UseCashSpendingRequests And ApprovedPaymentDate < Date(2023,2,1) Then 
		UsageOCR.Document_RequestForTransferOfDSVBudget_Receipt = True;
	Else	
		UsageOCR.Document_RequestForTransferOfDSVBudget_Receipt = False; 
	EndIf;
	
	If Not UseCashSpendingRequests And ApprovedPaymentDate < Date(2023,2,1) Then
		UsageOCR.Document_RequestForTransferOfDSVBudgetVSBDS_Receipt = True;
	Else	
		UsageOCR.Document_RequestForTransferOfDSVBudgetVSBDS_Receipt = False; 
	EndIf;	
	
	UsageOCR.Document_ApplicationForTransferOfDSVBudgetFrom__Receipt = False;
	UsageOCR.Document_RequestForTransferOfDSVBudgetsOfSBDSExceeded_Receipt = False;
		 
	If UseCashSpendingRequests Then 
		If XDTOData.Property("AdditionalInfo") And TypeOf(XDTOData.AdditionalInfo) = Type("Structure") Then  
			If XDTOData.AdditionalInfo.Property("PersonalIncomeTaxDecryption") Then
				PersonalIncomeTaxDecryption = XDTOData.AdditionalInfo.PersonalIncomeTaxDecryption;
				UsageOCR.Document_RequestForTransferOfDSVBudget_Receipt  = PersonalIncomeTaxDecryption.Property("PERSONALINCOMETAX")  
				And PersonalIncomeTaxDecryption.PersonalIncomeTax > 0 And ApprovedPaymentDate < Date(2023,2,1);
				UsageOCR.Document_ApplicationForTransferOfDSVBudgetFrom__Receipt = PersonalIncomeTaxDecryption.Property("PersonalIncomeTaxOnIncomeInExcessOfMaximumAmountCalculatedByTaxAgent") 
				And PersonalIncomeTaxDecryption.PersonalIncomeTaxOnIncomeInExcessOfMaximumAmountCalculatedByTaxAgent > 0 And ApprovedPaymentDate < Date(2023,2,1);
			EndIf;
		EndIf;
	EndIf;
	If Not UseCashSpendingRequests Then   
		If XDTOData.Property("AdditionalInfo") And TypeOf(XDTOData.AdditionalInfo) = Type("Structure") Then 
			If XDTOData.AdditionalInfo.Property("PersonalIncomeTaxDecryption") Then  
				PersonalIncomeTaxDecryption = XDTOData.AdditionalInfo.PersonalIncomeTaxDecryption;
				UsageOCR.Document_RequestForTransferOfDSVBudgetVSBDS_Receipt  = PersonalIncomeTaxDecryption.Property("PERSONALINCOMETAX")
				And PersonalIncomeTaxDecryption.PersonalIncomeTax > 0 And ApprovedPaymentDate < Date(2023,2,1);
				UsageOCR.Document_RequestForTransferOfDSVBudgetsOfSBDSExceeded_Receipt = PersonalIncomeTaxDecryption.Property("PersonalIncomeTaxOnIncomeInExcessOfMaximumAmountCalculatedByTaxAgent")
				And PersonalIncomeTaxDecryption.PersonalIncomeTaxOnIncomeInExcessOfMaximumAmountCalculatedByTaxAgent > 0 And ApprovedPaymentDate < Date(2023,2,1);
			EndIf;
		EndIf;
	EndIf;
EndProcedure

