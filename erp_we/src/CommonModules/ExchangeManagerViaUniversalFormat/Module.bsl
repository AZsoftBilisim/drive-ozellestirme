Function DefaultElement(ExchangeComponents, ItemKind, AddlParameters = Undefined)
	ConversionParameters_SSLy = ExchangeComponents.ConversionParameters_SSLy;
		
	If Not ValueIsFilled(ConversionParameters_SSLy.DefaultElements) Then
		ConversionParameters_SSLy.DefaultElements = New Structure;
	EndIf;
	
	ElementValue = Undefined;
	If AddlParameters = Undefined And ConversionParameters_SSLy.DefaultElements.Property(ItemKind, ElementValue) Then
		Return ElementValue;
	EndIf;
	
	If ItemKind = "ProductAccessGroup" Then
	
		YouMustCreateElement = False;
		
		DefaultElementName = NStr("vi = 'Nhóm truy cập mặc định';
									|ru = 'Группа доступа по умолчанию';
									|en = 'Default access group'; fa = 'Default access group';
									|it = 'Gruppo di accesso da impostazione predefinita';
									|pl = 'Grupa dostępu domyślna';
									|tr = 'Varsayılan erişim grubu'");
		
		Query = New Query(
		"SELECT TOP 2
		|	ItemAccessGroups.Ref AS Ref,
		|	CASE
		|		WHEN ItemAccessGroups.Description = &DefaultElementName
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ThisIsDefaultItemForSharing
		|FROM
		|	Catalog.ItemAccessGroups AS ItemAccessGroups
		|WHERE
		|	NOT ItemAccessGroups.DeletionMark
		|
		|ORDER BY
		|	ThisIsDefaultItemForSharing DESC");
		Query.SetParameter("DefaultElementName", DefaultElementName);
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			If Selection.Count() = 1
				Or Selection.ThisIsDefaultItemForSharing Then
				ElementValue = Selection.Ref;
			Else
				YouMustCreateElement = True;
			EndIf;
		Else
			YouMustCreateElement = True;
		EndIf;
		
		If YouMustCreateElement Then
			AccessGroupObject = Catalogs.ItemAccessGroups.CreateItem();
			AccessGroupObject.Description = DefaultElementName;
			
			AccessGroupObject.DataExchange.Load = True;
			
			Try
				AccessGroupObject.Write();
				ElementValue = AccessGroupObject.Ref;
			Except
				ElementValue = Catalogs.ItemAccessGroups.EmptyRef();
				WriteErrorToEventLog(ElementValue,
					DetailErrorDescription(ErrorInfo()), ExchangeComponents);
			EndTry;
		EndIf;
		
	ElsIf ItemKind = "IndividualAccessGroup" Then
			
		YouMustCreateElement = False;
		
		DefaultElementName = NStr("vi = 'Nhóm truy cập mặc định';
