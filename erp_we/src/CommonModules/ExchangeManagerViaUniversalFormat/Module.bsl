Procedure OCR_Document_ICOSettlementsWithCounterparties_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	// Filling in the header data
	ReceivedData.Posted = True;
	
	ARAPType = "WithCustomer";
	If XDTOData.Property("ARAPType") Then
		ARAPType = XDTOData.ARAPType.Value;
	EndIf;
	
	If ARAPType = "WithCustomer" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer;
	ElsIf ARAPType = "WithVendor" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.RefundFromVendor; 
	ElsIf ARAPType = "LoanToCounterparty" Then	
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty;
	ElsIf ARAPType = "CounterpartyCredit" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.PaymentOnLoansAndBorrowingsReceived;  
	Else
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt;
	EndIf;
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "ChiefAccountant");
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	// Breakdown of payment
	FillInContract = (ARAPType = "WithCustomer" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed)
					Or (ARAPType = "WithVendor" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed);
	
	ArrayOfPaymentDecryptionStrings = New Array;
	If ValueIsFilled(XDTOData.ARAPDetails) Then
	
		T_RP = New Map;
		T_RP.Insert("Sum", "Sum");
		T_RP.Insert("AmountARAP", "AmountARAP");
		T_RP.Insert("CashFlowItem", "CFItem");
		T_RP.Insert("VATAmount", "VATAmount");
		T_RP.Insert("VATRate", "VATRate");
		T_RP.Insert("TheExchangeRateIsTheDenominatorOfMutualSettlements", "Multiplier_");
		T_RP.Insert("ExchangeRateNumeratorOfMutualSettlements", "TransactionRate");
		
		AvailableSettlementColumns = AvailableColumnsForFillingInSettlementData(XDTOData.ARAPDetails, FillInContract);
		
		For Each XDTORow In XDTOData.ARAPDetails Do
			StringDataStructure = New Structure;
			FillInRowDataStructure(T_RP, XDTORow, StringDataStructure);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			
			AddCurrencyToPaymentDecryption(StringDataStructure, XDTORow);
			
			If Not StringDataStructure.Property("AmountARAP")
				Or StringDataStructure.Property("AmountARAP")
					And Not ValueIsFilled(StringDataStructure.AmountARAP) Then
				
				StringDataStructure.Insert("AmountARAP", StringDataStructure.Sum);
			EndIf;
			
			AddSettlementDataToPaymentTranscript(ExchangeComponents, XDTORow, StringDataStructure, AvailableSettlementColumns);
					
			ArrayOfPaymentDecryptionStrings.Add(StringDataStructure);
			TypeOfCalculationsAdvanced = XDTORow.TypeOfCalculationsAdvanced;
			If Find(Lower(TypeOfCalculationsAdvanced), "loan") > 0
			And (ARAPType = "LoansAndBorrowings" Or ARAPType = "LoanToCounterparty") Then
				ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty;
			EndIf;
			If Not XDTOData.ARAPDetails.Columns.Find("RowID") = Undefined Then
				StringDataStructure.Insert("RowID", XDTORow.RowID);
			EndIf;
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfPaymentDecryptionStrings);
		//++ NOT TM
		
	 
		//-- DON'T TM
	EndIf;
EndProcedure
