Procedure OCR_Catalog_CounterpartyBankAccounts_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Instruction = New Structure("Value, OCRName");
	Instruction.Value = IBData.Owner;
	If TypeOf(IBData.Owner) = Type("CatalogRef.Counterparties") Then
		Instruction.OCRName = "Catalog_Counterparties";
	ElsIf TypeOf(IBData.Owner) = Type("CatalogRef.Companies") Then
		Instruction.OCRName = "Catalog_Companies_Send";
	ElsIf TypeOf(IBData.Owner) = Type("CatalogRef.Persons") Then
		Instruction.OCRName = "Catalog_Persons_Send";
	EndIf;
	XDTOData.KeyProperties.Insert("Owner", Instruction);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		UnloadBankFromBankAccount(IBData, XDTOData, ExchangeComponents, ExportStack);	
	EndIf;	
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

Procedure AddPCO_Catalog_BankAccountsOfOrganizations_Sending(ConversionRules)
	ConversionRule = DataExchangeXDTOServer.InitializeObjectConversionRule(ConversionRules);
	ConversionRule.OCRName            = "Catalog_CompaniesBankAccounts_Send";
	ConversionRule.DataObject      = Metadata.Catalogs.CompaniesBankAccounts;
	ConversionRule.FormatObject     = "Справочник.БанковскиеСчета"; //@NON-NLS-1
	ConversionRule.OnSendData = "OCR_Catalog_CompaniesBankAccounts_Send_OnSendData";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "BankAddress",                       "BankAddress");
	AddPCR(HeaderProperties, "TransferBankAddress",            "TransferBankAddress");
	AddPCR(HeaderProperties, "Bank",                             "Bank", 1, "Catalog_Banks");
	AddPCR(HeaderProperties, "TransferBank",                  "TransferBank", 1, "Catalog_Banks");
	AddPCR(HeaderProperties, "BankBIC",                         "BankBIC");
	AddPCR(HeaderProperties, "TransferBankBIC",              "TransferBankBIC");
	AddPCR(HeaderProperties, "CashCurrency",            "CashCurrency", , "Catalog_Currencies");
	AddPCR(HeaderProperties, "",                                 "AccountType", 1);
	AddPCR(HeaderProperties, "Owner",                         "Owner", , "Catalog_Companies_Send");
	AddPCR(HeaderProperties, "OutputAmountWithoutFractionalPart",           "OutputAmountWithoutFractionalPart");
	AddPCR(HeaderProperties, "BankCity",                       "BankCity");
	AddPCR(HeaderProperties, "TransferBankCity",            "TransferBankCity");
	AddPCR(HeaderProperties, "DigitalRoubleAccountID", "DigitalAccountId");
	AddPCR(HeaderProperties, "BankCorrAccount",                    "BankCorrAccount");
