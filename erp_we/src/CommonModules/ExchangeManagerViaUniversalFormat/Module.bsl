Procedure OCR_Document_PurchaseAdjustment_Debt__OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "KP";
	XDTOData.KeyProperties.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 8));
	XDTOData.Insert("Currency",             LocalAccountingCurrency(IBData.Organization));
	XDTOData.Insert("DocumentCourse",      1);
	XDTOData.Insert("DocumentMultiplicity", 1);
	XDTOData.Insert("OperationKind",        "DebtCancellation");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	DataDebt = UnloadDebtTable("ARAPAdjustment",
		IBData.Ref, IBData.Counterparty, IBData.Organization, , ExchangeComponents);
	
	If DataDebt.Count() > 0 Then
		XDTOData.Insert("Currency",             DataDebt[0].ARAPCurrency);
		XDTOData.Insert("DocumentCourse",      DataDebt[0].TransactionRate);
		XDTOData.Insert("DocumentMultiplicity", DataDebt[0].Multiplier_);
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.AdjustmentOfAcquisitionIncreaseInDebtConsolidated Then
		XDTOData.Insert("AccountsReceivable",  DataDebt);
		XDTOData.Insert("Creditor", Catalogs.Counterparties.EmptyRef());
	    XDTOData.Insert("AmountOfAccountsPayable", 0); 
	    XDTOData.Insert("AmountOfAccountsReceivable", IBData.ARAPAdjustment.Total("AdjustmentSum"));
		GLAccount = AccountingInvoiceForArticle(
							IBData.ExpenseItem,
							IBData.Organization,
							IBData.Department,
							IBData.Date);
		XDTOData.Insert("AccountCr", Undefined);
		XDTOData.Insert("AccountDr", GLAccount); 
	Else 
		XDTOData.Insert("AccountsPayable",  DataDebt);
		XDTOData.Insert("CounterpartyDebtor", Catalogs.Counterparties.EmptyRef());
		XDTOData.Insert("AmountOfAccountsReceivable", 0); 
		XDTOData.Insert("AmountOfAccountsPayable", IBData.ARAPAdjustment.Total("AdjustmentSum")); 
		GLAccount = AccountingInvoiceForArticle(
							IBData.IncomeItem,
							IBData.Organization,
							IBData.Department,
							IBData.Date);
	
		XDTOData.Insert("AccountDr", Undefined);
		XDTOData.Insert("AccountCr", GLAccount);
	EndIf;
EndProcedure

