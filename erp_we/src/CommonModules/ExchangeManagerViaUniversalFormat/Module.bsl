Procedure OCR_Document_InventoryTransfer_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	SeriesUponReceipt = ReceivedData.SetOfSeries.Count();
	If Not IBData = Undefined And ValueIsFilled(IBData.Ref) Then
		If GetFunctionalOption("UseTransferOrders") Then
			ReceivedData.AdditionalProperties.Delete("Goods");
			Goods = Common.ValueTableToArray(IBData.Goods.Unload());
			ReceivedData.AdditionalProperties.Insert("Goods", Goods);
		EndIf;
		ReceivedData.BusinessOperation = IBData.BusinessOperation;
		RecipientSSeries = (SeriesUponReceipt = 0 And IBData.SetOfSeries.Count() > 0);
		GoodsBatch = IBData.Goods.Unload();
		If RecipientSSeries Then
			For Each String In IBData.Goods Do
				FoundRow = GoodsBatch.Find(String.RowID, "RowID");
				If Not FoundRow = Undefined Then
					String.BatchesIndicationStatus = FoundRow.BatchesIndicationStatus; 
					String.BatchesIndicationStatusRecipient = FoundRow.BatchesIndicationStatusRecipient;
					String.BatchesIndicationStatusSender = FoundRow.BatchesIndicationStatusSender;
				EndIf; 
			EndDo;	
		ElsIf SeriesUponReceipt > 0 Then  
			For Each Page1 In ReceivedData.SetOfSeries Do
				Filter = New Structure("Products",Page1.Products);
				Filter.Insert("Characteristic", Page1.Characteristic);
				ProductLines_3 = IBData.Goods.FindRows(Filter);
				If Not ProductLines_3 = Undefined And ProductLines_3.Count()> 0 Then
					For Each RowProducts_ In ProductLines_3 Do 
						RowProducts_.BatchesIndicationStatus = 2; 
						RowProducts_.BatchesIndicationStatusSender = 2;
						RowProducts_.BatchesIndicationStatusRecipient = 2;
						RowProducts_.Series = Page1.Series;
					EndDo;
				EndIf;
			EndDo;
		EndIf;
		
	Else
		For Each Page1 In ReceivedData.SetOfSeries Do
			Filter = New Structure("Products",Page1.Products);
			Filter.Insert("Characteristic", Page1.Characteristic);
			ProductLines_3 = ReceivedData.Goods.FindRows(Filter);
			If Not ProductLines_3 = Undefined And ProductLines_3.Count()> 0 Then
				For Each RowProducts_ In ProductLines_3 Do
					RowProducts_.BatchesIndicationStatus = 2; 
					RowProducts_.BatchesIndicationStatusSender = 2;
					RowProducts_.BatchesIndicationStatusRecipient = 2;
					RowProducts_.Series = Page1.Series;
				EndDo;
			EndIf;
		EndDo;
	EndIf;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
	ReceivedData.GoodsReceiptOption = PurchasesServer.GetProductAcceptanceOption(Undefined, Undefined);
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
EndProcedure

