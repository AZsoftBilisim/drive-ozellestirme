Function UnloadDebtTable(TSName, Ref, CurCounterparty, CurOrganization, DocumentOrganization = Undefined, ExchangeComponents)
	QueryText = "SELECT
		|	Debt_.ARAPObject.Object AS OrderDocument,
		|	Debt_.PaymentType_ AS ARAPType,
		|	Debt_.AmountARAP AS AmountARAP,
		|	Debt_.SumCompl AS Sum,
		|	Debt_.ARAPCurrency AS ARAPCurrency,
		|	ISNULL(ExchangeRates.CourseNumerator, 1) AS TransactionRate,
		|	ISNULL(ExchangeRates.CourseDenominator, 1) AS Multiplier_
		|FROM &DocumentTable AS Debt_
		|	LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&DocDate, BaseCurrency = &BaseCurrency) AS ExchangeRates
		|	ON Debt_.ARAPCurrency = ExchangeRates.Currency 
		|WHERE
		|	Debt_.Ref = &Ref";
	
	Query = New Query;
	If TypeOf(Ref) = Type("DocumentRef.ARAPAdjustment") Then
		QueryText = StrReplace(QueryText, "Debt_.SumCompl AS",
			"CAST(Debt_.Sum * ISNULL(ExchangeRates.CourseNumerator, 1) / ISNULL(ExchangeRates.CourseDenominator, 1) AS NUMBER(31, 2)) AS");
		QueryText = StrReplace(QueryText, "Debt_.AmountARAP AS", "Debt_.Sum AS");
	ElsIf TypeOf(Ref) = Type("DocumentRef.PurchaseAdjustment") Or TypeOf(Ref) = Type("DocumentRef.SaleAdjustment") Then
		QueryText = StrReplace(QueryText, "Debt_.SumCompl AS",
			"CAST(Debt_.AdjustmentSum * ISNULL(ExchangeRates.CourseNumerator, 1) / ISNULL(ExchangeRates.CourseDenominator, 1) AS NUMBER(31, 2)) AS");
		QueryText = StrReplace(QueryText, "Debt_.ARAPCurrency",
			"Debt_.Ref.ARAPCurrency"); 
		If TypeOf(Ref) = Type("DocumentRef.PurchaseAdjustment") Then
			QueryText = StrReplace(QueryText, "Debt_.PaymentType_ AS",
				"VALUE(Enum.PartnersARAPAccountingTypes.VendorARAPAccounting)");
		Else
			QueryText = StrReplace(QueryText, "Debt_.PaymentType_ AS",
				"VALUE(Enum.PartnersARAPAccountingTypes.CustomerARAPAccounting)");
		EndIf;
	EndIf;
	
	Query.Text = StrReplace(QueryText, "&DocumentTable", "Document." + Ref.Metadata().Name + "." + TSName);
	Query.SetParameter("Ref", Ref);
	Query.SetParameter("DocDate", Ref.Date);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(CurOrganization));
	DataDebt = Query.Execute().Unload();
	
	DataDebt.Columns.Add("Contract");
	DataDebt.Columns.Add("DocumentOfARAPAccounting");
	
	For Each TableRow In DataDebt Do
		
		If ValueIsFilled(TableRow.OrderDocument) Then
			
			OrderType_5 = TypeOf(TableRow.OrderDocument);
			
			If OrderType_5 = Type("CatalogRef.CounterpartyContracts") Then
				TableRow.Contract = TableRow.OrderDocument;
			Else
				If TableRow.OrderDocument.Metadata().Attributes.Find("Contract") <> Undefined Then
					CurTreaty = Common.ObjectAttributeValue(TableRow.OrderDocument, "Contract");
					If TypeOf(CurTreaty) = Type("CatalogRef.CounterpartyContracts") Then
						TableRow.Contract = CurTreaty;
					EndIf;
				EndIf;
				
				OCRName = NameOfICOForDataObject(ExchangeComponents, TableRow.OrderDocument, CurCounterparty);
				
				If Not IsBlankString(OCRName) Then
					TableRow.DocumentOfARAPAccounting = New Structure("Value, OCRName", TableRow.OrderDocument, OCRName);
				EndIf;
			EndIf;
			
		EndIf;
		
		If ValueIsFilled(TableRow.Contract) Then
			Continue;
		EndIf;
		
		InvertContractParameters = False;
		CalculationsInConventionalUnits       = False;
		TypeOfAgreement                    = "";
		
		If ValueIsFilled(DocumentOrganization)
			And DocumentOrganization <> CurOrganization Then
			InvertContractParameters = True;
		EndIf;
		
		GetContractParametersForOrder(TableRow.OrderDocument, TableRow.ARAPType,
			TypeOfAgreement, CalculationsInConventionalUnits, InvertContractParameters);
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Organization              = CurOrganization;
		DefaultParameters.ARAPCurrency     = TableRow.ARAPCurrency;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		DefaultParameters.TypeOfAgreement              = TypeOfAgreement; 
		DefaultParameters.Counterparty               = CurCounterparty;
		
		TableRow.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, TableRow.OrderDocument, Ref);
		
	EndDo;
	
	DataDebt.Columns.Delete("OrderDocument");
	
	Return DataDebt;
EndFunction
