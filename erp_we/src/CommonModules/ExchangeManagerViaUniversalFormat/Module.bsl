Procedure DPR_Document_ReturnOfGoodsToVendor_OnProcess(IBData, UsageOCR, ExchangeComponents)
	// Checking for the presence of records in the tabular part of the Goods.
	// If the table part is empty, then the document is not unloaded, otherwise it will not pass the check according to the scheme.
	
	Query = New Query("SELECT TOP 1
		|	TRUE AS ThereAreRecords
		|FROM
		|	Document.ReturnOfGoodsToVendor.InventoryKinds AS InventoryKinds
		|		INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
		|		ON InventoryKinds.ItemsLocationAttributes = Dimension.DimensionKey
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|	AND (Dimension.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|		OR Dimension.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage))");
	
	Query.SetParameter("Ref", IBData.Ref);
	Selection = Query.Execute();
	If Selection.IsEmpty()
		Or (NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.18") 
		And IBData.VATTaxation = Enums.VATTaxationTypes.PreferentialVATTaxationOnSTS) Then
		UsageOCR.Document_ReturnOfGoodsToSupplier_Sending = False;
	EndIf;
EndProcedure


