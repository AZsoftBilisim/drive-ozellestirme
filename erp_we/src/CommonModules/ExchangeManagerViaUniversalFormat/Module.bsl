Procedure DPR_Document_RedemptionOfGoodsFromStorage_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	QueryText =
		"SELECT
		|	InventoryKinds.ItemsLocationAttributes.StorageLocation AS Warehouse,
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.Package AS Package,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.NumberOfPackages AS NumberOfPackages,
		|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
		|	InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount AS Sum,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.CCDNumber AS CCDNumber,
		|	1 AS ZoomRatio,
		|	""GiverRawMaterialsAndSupplies"" AS InventoryType,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.ItemsLocationAttributes.Series AS Series
		|INTO InventoryKinds
		|FROM
		|	Document.RedemptionOfGoodsFromStorage.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|
		|INDEX BY
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.Warehouse AS Warehouse,
		|	InventoryKinds.Products AS Products,
		|	InventoryKinds.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.ZoomRatio AS ZoomRatio,
		|	InventoryKinds.InventoryType AS InventoryType,
		|	InventoryKinds.Count AS Count,
		|	CAST(InventoryKinds.Sum / InventoryKinds.NumberOfPackages AS NUMBER(31, 2)) AS PricePerPackaging,
		|	CAST(InventoryKinds.Sum / InventoryKinds.Count AS NUMBER(31, 2)) AS Price,
		|	0 AS DocumentRowNumber,
		|	InventoryKinds.Sum AS Sum,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.VATRate AS VATRate,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	&QueryTextPackage
		|FROM
		|	InventoryKinds AS InventoryKinds";
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	
	Goods = Query.Execute().Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "PurchaseForActivity", "");
		
	Warehouse = Undefined;
	DocumentRowNumber = 1;
	For Each String In Goods Do
		String.DocumentRowNumber = DocumentRowNumber;
		DocumentRowNumber = DocumentRowNumber + 1;
		
		If Not ValueIsFilled(Warehouse) And TypeOf(String.Warehouse) = Type("CatalogRef.Warehouses") Then
			Warehouse = String.Warehouse;
		EndIf;
		
	EndDo; 
	IBData.AdditionalProperties.Insert("Goods", Goods);
	IBData.AdditionalProperties.Insert("Warehouse", Warehouse);
EndProcedure


