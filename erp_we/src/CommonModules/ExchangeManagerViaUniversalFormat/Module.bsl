		|	&TextOfCCDRequest,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|		END AS NUMBER(31, 2)) AS Price,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.FromCurrentDocument)
		|			THEN CASE
		|					WHEN InventoryKinds.Ref.PriceIncludesVAT
		|						THEN InventoryKinds.AmountIncludingVAT
		|					ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|				END
		|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.Manually)
		|			THEN CASE
		|					WHEN ISNULL(&Rate, 0) > 0
		|							AND ISNULL(&Repetition, 0) > 0
		|						THEN CAST(InventoryKinds.CostLocal / &Rate / &Repetition AS NUMBER(31, 2))
		|					ELSE 0
		|				END
		|		ELSE 0
		|	END AS Cost_,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN CASE
		|						WHEN InventoryKinds.NumberOfPackages = 0
		|							THEN InventoryKinds.AmountIncludingVAT
		|						ELSE InventoryKinds.AmountIncludingVAT / InventoryKinds.NumberOfPackages
		|					END
		|			ELSE CASE
		|					WHEN InventoryKinds.NumberOfPackages = 0
		|						THEN InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|					ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.NumberOfPackages
		|				END
		|		END AS NUMBER(15, 2)) AS PricePerPackaging
		|FROM
		|	Document.IntercompanyGoodsReturn.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref";
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
			
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	If IBData.Currency = LocalAccountingCurrency(IBData.Organization) Then
		Query.SetParameter("Rate", 1);
		Query.SetParameter("Repetition", 1);
	Else
		CurrencyExchangeRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(IBData.Currency, IBData.Date,
			SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		Query.SetParameter("Rate", CurrencyExchangeRate.CourseNumerator);
		Query.SetParameter("Repetition", CurrencyExchangeRate.CourseDenominator);
	EndIf;
		
	Goods = Query.Execute().Unload();
	Goods.Columns.Add("InventoryType");
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	Goods.FillValues(?(XDTOData.OperationKind = "ReturnToVendor", "СобственныеТовары", "CommissionGoods"), "InventoryType"); //@NON-NLS-2
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("Goods", Goods);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

