	AddPCR(HeaderProperties, "Extension",    "Extension");
	AddPCR(HeaderProperties, "",              "StoredFile", 1);
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "EncryptionCertificates");
	AddPCR(PropertiesOfTS, "", "Certificate", 1);
	
