	EndIf;
	
	If Not ValueIsFilled(NameOfProductSource) Then
		NameOfProductSource = SourceName_;
	EndIf;
	
	QueryText = StrReplace(QueryText, "&NameOfProductSource", NameOfProductSource);
	QueryText = StrReplace(QueryText, "&SourceName_", SourceName_);
	
