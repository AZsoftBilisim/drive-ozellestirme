Procedure OCR_Catalog_CounterpartyContracts_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If XDTOData.KeyProperties.Property("ARAPCurrency")
		And ValueIsFilled(XDTOData.KeyProperties.ARAPCurrency) Then
		
		If XDTOData.KeyProperties.ARAPCurrency.Property("Ref") Then
			OCRName = "Catalog_Currencies";
		Else
			OCRName = "Catalog___FromStructure";
		EndIf;
		ReceivedData.AdditionalProperties.Insert("ARAPCurrency", New Structure("Value, OCRName", XDTOData.KeyProperties.ARAPCurrency, OCRName));
	EndIf;
	
	If XDTOData.Property("ConductSettlementsWithCommissionAgentInContextOfEndCustomers") 
		And XDTOData.ConductSettlementsWithCommissionAgentInContextOfEndCustomers Then
		
		ReceivedData.ConductARAPAccountingThroughEndCustomers = True;
	EndIf;
	
	If XDTOData.Property("ContractWithCommissionAgent") 
		And ValueIsFilled(XDTOData.ContractWithCommissionAgent) Then
		ReceivedData.ContractType = Enums.ContractTypes.SalesViaCommissionAgent; 
		ReceivedData.AdditionalProperties.Insert("ContractWithCommissionAgent", XDTOData.ContractWithCommissionAgent); 
		
	EndIf;
	
	If XDTOData.Property("Consignee") 
		And ValueIsFilled(XDTOData.Consignee) Then
		
		ReceivedData.AdditionalProperties.Insert("CounterpartyCommissionAgent", XDTOData.Consignee);
		
	EndIf; 
	If XDTOData.Property("ForeignExchangeControlUniqueNumber") 
		And ValueIsFilled(XDTOData.ForeignExchangeControlUniqueNumber) Then
		ReceivedData.AdditionalProperties.Insert("ForeignExchangeControlUniqueNumber", XDTOData.ForeignExchangeControlUniqueNumber);
	EndIf;	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents, True);
EndProcedure
Procedure OCR_Catalog_CounterpartyContracts_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	ContractsOfCounterpartiesBeforeRecordingReceivedData(ReceivedData, IBData, ExchangeComponents);
	
	If ValueIsFilled(ReceivedData.ForeignExchangeControlUniqueNumber) Then
		FONames = New Array;
		FONames.Add("UseCurrencyPayments");
		ErrorsText = "";
		CheckStateOfFunctionalOptionsByName(FONames, ErrorsText);
	EndIf;
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
		ReceivedData.AdditionalProperties, ExchangeComponents);
EndProcedure

