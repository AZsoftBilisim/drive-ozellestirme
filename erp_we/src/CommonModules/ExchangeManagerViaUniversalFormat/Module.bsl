Procedure OCR_Document_Document_PBDSReceiptOnDeposit_Otpr(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If TrimAll(IBData.IncomingDocumentNumber) = "-" Then
		// The symbol "-" is put down artificially if a document with an empty number is loaded from the PSU.
		XDTOData.IncomingDocumentNumber = "";
	EndIf;
	
	HeaderData_ = IBData.AdditionalProperties.HeaderData_;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
	
	Account_Settlement = "55";
	
	ARAPDetails = TranscriptOfPaymentCashReceiptDocuments(IBData, ExchangeComponents);
	
	// Breakdown of payment
	TabDecryption = New ValueTable;
	TabDecryption.Columns.Add("CFItem");
	TabDecryption.Columns.Add("Sum");
	TabDecryption.Columns.Add("Account_Settlement");
	
	If ARAPDetails.Count() > 0 Then
		For Each String In ARAPDetails Do
			NewRow = TabDecryption.Add();
			FillPropertyValues(NewRow, String, "Sum, CFItem");
			
			If ValueIsFilled(String.AccountForSettlementsWithCounterparty) Then
				NewRow.Account_Settlement = String.AccountForSettlementsWithCounterparty;
			EndIf;  
			If String.LoanAndDepositAmountType = Enums.LoanAndDepositScheduleAmountTypes.Interests Then
			    NewRow.Account_Settlement = "76.09"
			EndIf;
	
			If Not ValueIsFilled(NewRow.Account_Settlement) Then
				If ValueIsFilled(Account_Settlement) Then
					NewRow.Account_Settlement = Account_Settlement;
				ElsIf ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed Then
					NewRow.Account_Settlement = AccountForSettlementsOfOtherDDSOperations(New Structure("CFItem", String.CFItem));
				EndIf;
			EndIf; 
		EndDo;
	Else
		NewRow = TabDecryption.Add();
		NewRow.Sum             = IBData.DocumentAmount;
		NewRow.CFItem         = IBData.CashFlowItem;
		If ValueIsFilled(Account_Settlement) Then
			NewRow.Account_Settlement = Account_Settlement;
		ElsIf ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed Then
			NewRow.Account_Settlement = AccountForSettlementsOfOtherDDSOperations(New Structure("CFItem", IBData.CashFlowItem));
		EndIf;
	EndIf;	
	
	XDTOData.Insert("ARAPDetails", TabDecryption);
EndProcedure

