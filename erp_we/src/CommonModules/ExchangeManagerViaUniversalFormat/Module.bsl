Procedure OCR_Document_PBDSSettlementsWithCounterparties_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	FillInDateAndNumberOfIncomingDocument(ReceivedData);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	// BusinessOperation
	ValueMap = New Map;
	ValueMap.Insert("WithCustomer",  	   Enums.BusinessTransactions.CashReceiptFromCustomer);
	ValueMap.Insert("WithVendor",  	   Enums.BusinessTransactions.RefundFromVendor);
	ValueMap.Insert("LoansAndBorrowings", 	   Enums.BusinessTransactions.OtherCashReceipt);
	ValueMap.Insert("CreditToCounterparty", Enums.BusinessTransactions.OtherCashReceipt);
	ValueMap.Insert("Other",        	   Enums.BusinessTransactions.OtherCashReceipt);
	ValueMap.Insert("BankCredit",       Enums.BusinessTransactions.CashReceiptFromLoansRepayment);
	ValueMap.Insert("LoanToCounterparty",   Enums.BusinessTransactions.CashReceiptFromLoansRepayment);
	
	ReceivedData.BusinessOperation = ValueMap.Get(XDTOData.ARAPType.Value); 
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	// ARAPDetails
	FillInContract = (XDTOData.ARAPType.Value = "WithCustomer" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed)
		Or (XDTOData.ARAPType.Value = "WithVendor" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed);
	
	ArrayOfStringsDecryption = New Array;
	
	FillingRules = New Map;
	
	FillingRules.Insert("Sum", "Sum");
	FillingRules.Insert("AmountARAP", "AmountARAP");
	FillingRules.Insert("CFItem", "CashFlowItem");
	FillingRules.Insert("VATRate", "VATRate");
	FillingRules.Insert("VATAmount", "VATAmount");
	FillingRules.Insert("TransactionRate", "ExchangeRateNumeratorOfMutualSettlements");
	FillingRules.Insert("Multiplier_", "TheExchangeRateIsTheDenominatorOfMutualSettlements");
	
	AvailableSettlementColumns = AvailableColumnsForFillingInSettlementData(XDTOData.ARAPDetails, FillInContract);
	
	For Each String In XDTOData.ARAPDetails Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
		EndIf;
		
		AddCurrencyToPaymentDecryption(StringDataStructure, String);
		
		AddSettlementDataToPaymentTranscript(ExchangeComponents, String, StringDataStructure, AvailableSettlementColumns);
		
		If Not XDTOData.ARAPDetails.Columns.Find("RowID") = Undefined Then
			StringDataStructure.Insert("RowID", String.RowID);
		EndIf;	
		ArrayOfStringsDecryption.Add(StringDataStructure);
		
	EndDo; 
	
	ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfStringsDecryption);
	//++ NOT TM
	
	
	//-- DON'T TM
EndProcedure
Procedure OCR_Document_PBDSSettlementsWithCounterparties_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	If Not IBData = Undefined Then
		If IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromLessor Then
			ReceivedData = Undefined;
			Return;
		EndIf;
	EndIf;
	
	BeforeMerzhevanii_PBDS(ReceivedData, IBData, ExchangeComponents);
	Merzhevanie_PBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents);
	AfterMerzhevaniya_PBDS(ReceivedData, IBData, ExchangeComponents);
	
	FillInAdditionalInformationSecurityDataPropertiesFromReceivedData(IBData, ReceivedData);
	
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
EndProcedure

