		LF.GiftCertificateKind = New Structure("Value, OCRName",
			LF.TypeOfGiftCertificateLink, "Catalog_GiftCertificateKinds");
	EndDo;
	
	XDTOData.Insert("GiftCertificates", GiftCertificates);
EndProcedure

