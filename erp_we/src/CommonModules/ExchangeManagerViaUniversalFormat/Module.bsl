Procedure DPR_Document_PriceSetup_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	If TypeOf(IBData) = Type("Structure") Then
			Return;
		EndIf;
		
		QueryText = "SELECT
		|	ItemsPrices.PriceKind AS PriceType_,
		|	ItemsPrices.Products AS Products,
		|	ItemsPrices.PricingVariant AS PricingVariant,
		|	ItemsPrices.PricingBatch AS PricingBatch,
		|	ItemsPrices.PricingPackage AS PricingPackage,
		|	MAX(ItemsPrices.Package) AS Package,
		|	MAX(ISNULL(&QueryTextPackagingFactor, 1)) AS PackagingFactor,
		|	MAX(ItemsPrices.Price) AS Price
		|INTO TT_PricesOfNomenclaturePrev
		|FROM
		|	Document.PriceSetup.Goods2_5 AS ItemsPrices
		|WHERE
		|	ItemsPrices.Ref = &Ref
		|	AND ItemsPrices.Price <> 0
		|	AND ItemsPrices.PriceKind IN (&ProductPricesTypes)
		|GROUP BY
		|	ItemsPrices.PriceKind,
		|	ItemsPrices.Products,
		|	ItemsPrices.PricingVariant,
		|	ItemsPrices.PricingPackage,
		|	ItemsPrices.PricingBatch
		|
		|INDEX BY
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TT_PricesOfNomenclaturePrev.PriceType_,
		|	TT_PricesOfNomenclaturePrev.Products,
		|	TT_PricesOfNomenclaturePrev.PricingVariant AS PricingVariant,
		|	TT_PricesOfNomenclaturePrev.PricingBatch,
		|	TT_PricesOfNomenclaturePrev.PricingPackage,
		|	TT_PricesOfNomenclaturePrev.Package,
		|	TT_PricesOfNomenclaturePrev.PackagingFactor,
		|	TT_PricesOfNomenclaturePrev.Price,
		|	CASE
		|		WHEN
		|			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
		|			THEN CatProducts_.Ref
		|		WHEN
		|			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
		|			THEN CatProducts_.ProductKind
		|		WHEN
		|			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
		|			THEN CatProducts_.ItemVariantsOwner
		|		ELSE UNDEFINED
		|	END AS ItemVariantsOwner
		|INTO TT_ItemsPrices
		|FROM
		|	TT_PricesOfNomenclaturePrev AS TT_PricesOfNomenclaturePrev
		|		LEFT JOIN Catalog.Products AS CatProducts_
		|		ON TT_PricesOfNomenclaturePrev.Products = CatProducts_.Ref
		|
		|WHERE
		|	NOT &ExportItemsWithInventoryOnly
		|
		|UNION ALL
		|	
		|SELECT
		|	TT_PricesOfNomenclaturePrev.PriceType_,
		|	TT_PricesOfNomenclaturePrev.Products,
		|	TT_PricesOfNomenclaturePrev.PricingVariant AS PricingVariant,
		|	TT_PricesOfNomenclaturePrev.PricingBatch,
		|	TT_PricesOfNomenclaturePrev.PricingPackage,
		|	TT_PricesOfNomenclaturePrev.Package,
		|	TT_PricesOfNomenclaturePrev.PackagingFactor,
		|	TT_PricesOfNomenclaturePrev.Price,
		|	CASE
		|		WHEN
		|			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
		|			THEN CatProducts_.Ref
		|		WHEN
		|			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
		|			THEN CatProducts_.ProductKind
		|		WHEN
		|			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
		|			THEN CatProducts_.ItemVariantsOwner
		|		ELSE UNDEFINED
		|	END AS ItemVariantsOwner
		|FROM
		|	TT_PricesOfNomenclaturePrev AS TT_PricesOfNomenclaturePrev
		|		INNER JOIN Catalog.Products AS CatProducts_
		|		ON TT_PricesOfNomenclaturePrev.Products = CatProducts_.Ref
		|		LEFT JOIN AccumulationRegister.ProductStock.Balance(, 
		|			Warehouse IN (&Warehouses) AND Products IN (SELECT Products FROM TT_PricesOfNomenclaturePrev)) AS StockBalance
		|		ON TT_PricesOfNomenclaturePrev.Products = StockBalance.Products
		|		AND StockBalance.InStockBalance > 0
		|		AND &ExportItemsWithInventoryOnly
		|		LEFT JOIN InformationRegister.ObjectsDataToRegisterInExchanges AS ObjectsDataToRegisterInExchanges
		|		ON TT_PricesOfNomenclaturePrev.Products = ObjectsDataToRegisterInExchanges.Ref
		|		AND ObjectsDataToRegisterInExchanges.InfobaseNode = &CorrespondentNode
		|		AND &ExportItemsWithInventoryOnly
		|WHERE 
		|	&ExportItemsWithInventoryOnly
		|	AND (NOT ObjectsDataToRegisterInExchanges.Ref IS NULL
		|		OR NOT StockBalance.Products IS NULL)
		|
		|INDEX BY
		|	PricingVariant,
		|	ItemVariantsOwner
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TT_ItemsPrices.PriceType_ AS PriceType_,
		|	TT_ItemsPrices.Products AS Products,
		|	ISNULL(ItemsBatches.Ref, VALUE(Catalog.ItemsBatches.EmptyRef)) AS Series,
		|	TT_ItemsPrices.Package AS Package,
		|	TT_ItemsPrices.Price AS Price,
		|	TT_ItemsPrices.PackagingFactor AS PackagingFactor,
		|	ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
		|	TT_ItemsPrices.PricingVariant AS PricingVariant,
		|	TT_ItemsPrices.ItemVariantsOwner AS ItemVariantsOwner
		|INTO TabGoodsPrev
		|FROM
		|	TT_ItemsPrices AS TT_ItemsPrices
		|		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		|		ON (TT_ItemsPrices.PricingVariant <> VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		|			AND TT_ItemsPrices.PricingVariant = ItemsCharacteristics.ItemsCharacteristicForPricing
		|		LEFT JOIN Catalog.ItemsBatches AS ItemsBatches
		|		ON (ItemsBatches.ItemsBatchForPricing <> VALUE(Catalog.ItemsBatchesForPricing.EmptyRef))
		|			AND TT_ItemsPrices.PricingBatch = ItemsBatches.ItemsBatchForPricing
		|;
		|
		|
		|//////////////////////////////////////////////////////////////////////////////// 
		|SELECT
		|	TabProducts.PriceType_ AS PriceType_,
		|	TabProducts.Products AS Products,
		|	TabProducts.Package AS Package,
		|	TabProducts.Price AS Price,
		|	TabProducts.PackagingFactor AS PackagingFactor,
		|	ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
		|	ItemsCharacteristics.Owner AS Owner,
		|	TabProducts.PricingVariant AS PricingVariant,
		|	TabProducts.Series AS Series
		|INTO TabGoodsAdditional
		|FROM
		|	TabGoodsPrev AS TabProducts
		|		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		|		ON TabProducts.ItemVariantsOwner = ItemsCharacteristics.Owner
		|WHERE
		|	TabProducts.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TabGoodsPrev.PriceType_ AS PriceType_,
		|	TabGoodsPrev.Products AS Products,
		|	TabGoodsPrev.Package AS Package,
		|	TabGoodsPrev.Price AS Price,
		|	TabGoodsPrev.PackagingFactor AS PackagingFactor,
		|	TabGoodsPrev.PricingVariant AS PricingVariant,
		|	CASE 
		|		WHEN TabGoodsPrev.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef) THEN
		|			TabGoodsPrev.Characteristic
		|		WHEN TabGoodsAdditional.Characteristic IS NULL THEN
		|			VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|		ELSE TabGoodsAdditional.Characteristic
		|		END AS Characteristic,
		|	TabGoodsPrev.Series AS Series
		|INTO TabProducts
		|FROM
		|	TabGoodsPrev AS TabGoodsPrev
		|		LEFT JOIN TabGoodsAdditional AS TabGoodsAdditional
		|		ON (TabGoodsPrev.Products = TabGoodsAdditional.Products
		|		AND TabGoodsPrev.PriceType_ = TabGoodsAdditional.PriceType_)
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TabProducts.Products AS Products,
		|	TabProducts.Characteristic AS Characteristic,
		|	TabProducts.Series AS Series,
		|	TabProducts.Package AS Package,
		|	MAX(TabProducts.PackagingFactor) AS PackagingFactor
		|INTO SelectionForSKU
		|FROM
		|	TabProducts AS TabProducts
		|WHERE
		|	ISNULL(TabProducts.Package.UnitOfMeasure.MeasuredValueType, TabProducts.Products.UnitOfMeasure.MeasuredValueType) 
		|		= VALUE(Enum.TypesOfMeasuredValues.Weight)
		|	AND &SKUCalculationCondition
		|GROUP BY
		|	TabProducts.Products,
		|	TabProducts.Characteristic,
		|	TabProducts.Series,
		|	TabProducts.Package
		|
		|UNION
		|
		|SELECT
		|	ItemsPrices.Products AS Products,
		|	ItemsPrices.Characteristic AS Characteristic,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	ItemsPrices.Package AS Package,
		|	MAX(ISNULL(&QueryTextPackagingFactor, 1)) AS PackagingFactor
		|FROM
		|	Document.PriceSetup.Goods AS ItemsPrices
		|WHERE
		|	ItemsPrices.Ref = &Ref
		|	AND ISNULL(ItemsPrices.Package.UnitOfMeasure.MeasuredValueType, ItemsPrices.Products.UnitOfMeasure.MeasuredValueType) 
		|	= VALUE(Enum.TypesOfMeasuredValues.Weight)
		|	AND &SKUCalculationCondition
		|GROUP BY
		|	ItemsPrices.Products,
		|	ItemsPrices.Characteristic,
		|	ItemsPrices.Package
		|INDEX BY	
		|	Products
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SKUData.Products AS Products,
		|	SKUData.Characteristic AS Characteristic,
		|	SKUData.Package AS Package,
		|	SKUData.PackagingFactor AS PackagingFactor,
		|	SUBSTRING(SKUData.BarcodeForSKU,3,5) AS SKU,
		|	SKUData.BarcodeForSKU AS BarcodeForSKU
		|INTO ItemWeightCodes
		|FROM
		|	(SELECT
		|		TabProducts.Products AS Products,
		|		TabProducts.Characteristic AS Characteristic,
		|		TabProducts.Package AS Package,
		|		TabProducts.PackagingFactor AS PackagingFactor,
		|		MIN(WeightScales.Barcode) AS BarcodeForSKU
		|	FROM
		|		SelectionForSKU AS TabProducts
		|			INNER JOIN InformationRegister.ItemsBarcodes AS WeightScales
		|			ON WeightScales.Products = TabProducts.Products
		|				AND WeightScales.Characteristic = TabProducts.Characteristic
		|	WHERE
		|		NOT ISNULL(WeightScales.Package.DeletionMark, FALSE)
		|		AND CASE 
		|			WHEN TabProducts.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) THEN
		|				WeightScales.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|					OR WeightScales.Products.UnitOfMeasure = WeightScales.Package.UnitOfMeasure
		|			WHEN TabProducts.Package.Owner = TabProducts.Products THEN
		|				TabProducts.Package = WeightScales.Package
		|				OR TabProducts.Package = TabProducts.Products.UnitOfMeasure
		|					AND WeightScales.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|			WHEN VALUETYPE(TabProducts.Package.Owner) = TYPE(Catalog.PackagingGroups) THEN
		|				TabProducts.Package = WeightScales.Package.UnitOfMeasure
		|					OR TabProducts.Package = TabProducts.Products.UnitOfMeasure
		|						AND WeightScales.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|		END
		|		AND WeightScales.Barcode LIKE ""2______00000_""
		|		AND SUBSTRING(WeightScales.Barcode, 1, 2) = ""2_""
		|		AND SUBSTRING(WeightScales.Barcode, 8, 6) = ""00000_""
		|		AND ISNULL(WeightScales.Package.UnitOfMeasure.MeasuredValueType, VALUE(Enum.TypesOfMeasuredValues.Weight)) 
		|			= VALUE(Enum.TypesOfMeasuredValues.Weight)
		|		AND ISNULL(WeightScales.Products.UnitOfMeasure.MeasuredValueType, VALUE(Enum.TypesOfMeasuredValues.Weight)) 
		|			= VALUE(Enum.TypesOfMeasuredValues.Weight)
		|	
		|	GROUP BY
		|		TabProducts.Products,
		|		TabProducts.Characteristic,
		|		TabProducts.Package,
		|		TabProducts.PackagingFactor) AS SKUData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|		ItemsPrices.Products AS Products
		|INTO DataDoc20
		|	FROM
		|		Document.PriceSetup.Goods AS ItemsPrices
		|	WHERE
		|		ItemsPrices.Ref = &Ref
		|		AND ItemsPrices.Price <> 0
		|		AND ItemsPrices.PriceKind IN (&ProductPricesTypes)
		|		AND &ExportItemsWithInventoryOnly
		|INDEX BY 
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TabProducts.PriceType_ AS PriceType_,
		|	TabProducts.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	ItemWeightCodes.SKU AS SKU,
		|	TabProducts.Price AS Price,
		|	TabProducts.PackagingFactor AS PackagingFactor
		|FROM
		|	TabProducts AS TabProducts
		|	LEFT JOIN ItemWeightCodes AS ItemWeightCodes
		|		ON TabProducts.Products = ItemWeightCodes.Products
		|		AND TabProducts.Characteristic = ItemWeightCodes.Characteristic
		|		AND TabProducts.Package = ItemWeightCodes.Package
		|
		|UNION ALL
		|
		|SELECT
		|	TabProducts.PriceType_,
		|	TabProducts.Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	ItemWeightCodes.SKU AS SKU,
		|	TabProducts.Price,
		|	TabProducts.ZoomRatio
		|FROM
		|	(SELECT
		|		ItemsPrices.PriceKind AS PriceType_,
		|		ItemsPrices.Products AS Products,
		|		ItemsPrices.Characteristic AS Characteristic,
		|		ItemsPrices.Package AS Package,
		|		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|		MAX(ISNULL(&QueryTextPackagingFactor, 1)) AS ZoomRatio,
		|		MAX(ItemsPrices.Price) AS Price
		|	FROM
		|		Document.PriceSetup.Goods AS ItemsPrices
		|	WHERE
		|		ItemsPrices.Ref = &Ref
		|		AND ItemsPrices.Price <> 0
		|		AND ItemsPrices.PriceKind IN (&ProductPricesTypes)
		|		AND NOT &ExportItemsWithInventoryOnly
		|	GROUP BY
		|		ItemsPrices.PriceKind,
		|		ItemsPrices.Products,
		|		ItemsPrices.Characteristic,
		|		VALUE(Catalog.ItemsBatches.EmptyRef),
		|		ItemsPrices.Package
		|
		|	UNION ALL
		|
		|	SELECT
		|		ItemsPrices.PriceKind AS PriceType_,
		|		ItemsPrices.Products AS Products,
		|		ItemsPrices.Characteristic AS Characteristic,
		|		ItemsPrices.Package AS Package,
		|		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|		MAX(ISNULL(&QueryTextPackagingFactor, 1)) AS ZoomRatio,
		|		MAX(ItemsPrices.Price) AS Price
		|	FROM
		|		Document.PriceSetup.Goods AS ItemsPrices
		|			LEFT JOIN InformationRegister.ObjectsDataToRegisterInExchanges AS ObjectsDataToRegisterInExchanges
		|			ON ItemsPrices.Products = ObjectsDataToRegisterInExchanges.Ref
		|			AND ObjectsDataToRegisterInExchanges.InfobaseNode = &CorrespondentNode
		|			LEFT JOIN AccumulationRegister.ProductStock.Balance(, 
		|					Products IN (SELECT Products FROM DataDoc20) AND Warehouse IN (&Warehouses)) AS BalanceData
		|				ON ItemsPrices.Products = BalanceData.Products
		|				AND BalanceData.InStockBalance > 0
		|	WHERE
		|		ItemsPrices.Ref = &Ref
		|		AND ItemsPrices.Price <> 0
		|		AND ItemsPrices.PriceKind IN (&ProductPricesTypes)
		|		AND &ExportItemsWithInventoryOnly
		|		AND (ObjectsDataToRegisterInExchanges.Ref IS NOT NULL 
		|			OR BalanceData.Products IS NOT NULL)
		|
		|	GROUP BY
		|		ItemsPrices.PriceKind,
		|		ItemsPrices.Products,
		|		ItemsPrices.Characteristic,
		|		VALUE(Catalog.ItemsBatches.EmptyRef),
		|		ItemsPrices.Package) AS TabProducts
		|	LEFT JOIN ItemWeightCodes AS ItemWeightCodes
		|		ON TabProducts.Products = ItemWeightCodes.Products
		|		AND TabProducts.Characteristic = ItemWeightCodes.Characteristic
		|		AND TabProducts.Package = ItemWeightCodes.Package
		|TOTALS
		|BY
		|	PriceType_";
		
		QueryTextPackagingFactor = Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"ItemsPrices.Package",
		"ItemsPrices.Products");
		
		QueryText = StrReplace(QueryText, "&QueryTextPackagingFactor", QueryTextPackagingFactor);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "TabProducts"));
		
		QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "TabProducts", False));
		
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "TabProducts"));
		
		QueryText = StrReplace(QueryText, "&SKUCalculationCondition",
		GetSKURequestText(ExchangeComponents));
		
		Query = New Query(QueryText);
		Query.SetParameter("Ref", IBData.Ref);
		Query.SetParameter("ProductPricesTypes", ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes);
		Query.SetParameter("CorrespondentNode", ExchangeComponents.CorrespondentNode);
		Query.SetParameter("ExportItemsWithInventoryOnly", ExchangeComponents.ConversionParameters_SSLy.ExportItemsWithInventoryOnly = True);
		Query.SetParameter("Warehouses", ExchangeComponents.CorrespondentNodeObject.Warehouses.Unload().UnloadColumn("Warehouse"));
		
		QueryResult = Query.Execute();
		
		ProductTableTemplate = New ValueTable;
		For Each ResultColumn In QueryResult.Columns Do
			ProductTableTemplate.Columns.Add(ResultColumn.Name, ResultColumn.ValueType);
		EndDo;
		
		SelectionPriceType = QueryResult.Select(QueryResultIteration.ByGroups);
		
		RuleSettingPricesSending = ExchangeComponents.DataProcessingRules.Find("Document_SettingProductPrices_Sending", "Name");
		If Not RuleSettingPricesSending = Undefined Then
			
			PriceCount = 0;
			While SelectionPriceType.Next() Do
				
				If Not ValueIsFilled(SelectionPriceType.PriceType_) Then
					Continue;
				EndIf;
				
				InformationSecurityDataStructure = New Structure("Date, Number, EmployeeResponsible, Comment");
				FillPropertyValues(InformationSecurityDataStructure, IBData);
				
				If SelectionPriceType.Count() = 1 Then
					InformationSecurityDataStructure.Insert("Ref", IBData.Ref);
				Else
					NumberWithoutPrefixes = ObjectsPrefixesClientServer.DeletePrefixesFromObjectNumber(IBData.Number, True, True);
					StandardPrefixes = StrReplace(IBData.Number, NumberWithoutPrefixes, "");
					
					NumberPrefix = StandardPrefixes + StringFunctionsClientServer.SupplementString(String(PriceCount), 2);
					NumberForPrinting = ObjectsPrefixesClientServer.NumberForPrinting(IBData.Number, True, True);
					If StrLen(NumberPrefix + NumberForPrinting) <= 11 Then
						InformationSecurityDataStructure.Number = NumberPrefix
						+ StringFunctionsClientServer.SupplementString(NumberForPrinting, 11 - StrLen(NumberPrefix));
					EndIf;
				EndIf;
				
				DetailsSelection = SelectionPriceType.Select();
				TableOfGoods = ProductTableTemplate.Copy();
				
				While DetailsSelection.Next() Do
					LineProducts_ = TableOfGoods.Add();
					FillPropertyValues(LineProducts_, DetailsSelection);
					If Not DetailsSelection.PackagingFactor = 1
						And (NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.7")
						Or Not DetailsSelection.UnloadingPackages) Then
						LineProducts_.Price = Round(DetailsSelection.Price * DetailsSelection.PackagingFactor, 2);
					EndIf;
				EndDo;
				
				FillInCharacteristicsOfWHPackage(ExchangeComponents, TableOfGoods, True, True);
				
				InformationSecurityDataStructure.Insert("PriceType_", SelectionPriceType.PriceType_);
				InformationSecurityDataStructure.Insert("Goods", TableOfGoods);
				
				DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, 
				InformationSecurityDataStructure, 
				RuleSettingPricesSending);
				
				PriceCount = PriceCount + 1;	
			EndDo;
			
		EndIf;
		
		UsageOCR.Document_SettingProductPrices_Sending = False;
EndProcedure

