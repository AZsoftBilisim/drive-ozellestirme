Procedure PCO_Document_PBDSTaxReturn_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;    
	
	#Region Header
	
	If TrimAll(IBData.IncomingDocumentNumber) = "-" Then
		// The "-" symbol is put down artificially if a document with an empty number is loaded from the PSU.
		XDTOData.IncomingDocumentNumber = "";
	EndIf; 
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
	
	DateIndicator = IBData.DateIndicator;
	
	If ValueIsFilled(DateIndicator) And DateIndicator <> "0" Then
		
		DateIndicator = Format(StringFunctionsClientServer.StringToDate(DateIndicator), "DLF=D");
		
	EndIf;
	
	XDTOData.Insert("DateIndicator", DateIndicator);
	
	TaxKind = "OtherTaxesFees";
	
	
	XDTOData.Insert("TaxKind", TaxKind);
	
	#EndRegion
	
	#Region ARAPDetails
	
	PaymentDecryptionTable = New ValueTable;
	
	PaymentDecryptionTable.Columns.Add("CFItem");
	PaymentDecryptionTable.Columns.Add("Sum");
	PaymentDecryptionTable.Columns.Add("Account_Settlement");
	 
	CodeOfAccountingAccount = ""; 
	 
	
	If IBData.ARAPDetails.Count() > 0 Then
		
		For Each String In IBData.ARAPDetails Do
			
			NewRow = PaymentDecryptionTable.Add(); 
			
			NewRow.CFItem = String.CashFlowItem;
			NewRow.Sum = String.Sum;
			
				
			If Not ValueIsFilled(NewRow.Account_Settlement)
