Procedure PCO_Document_RCOSettlementsWithEmployees_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	FirstFilledInCFItem = Undefined;
	For Each String In XDTOData.ARAPDetails Do
		If FirstFilledInCFItem = Undefined And ValueIsFilled(String.CFItem) Then
			FirstFilledInCFItem = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
				ExchangeComponents,
				String.CFItem,
				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_CFItems"),
				"GetRef");
		EndIf;	
	EndDo;
	
	#Region Header
	
	ReceivedData.Posted = True;
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "ChiefAccountant");
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "Director");
	
	// BusinessOperation
	
	ARAPType = TrimAll(XDTOData.ARAPType.Value);
	If ARAPType = "Loans_" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee;
	Else
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder;
	EndIf;
	// CFItem
	ReceivedData.CashFlowItem = FirstFilledInCFItem;
	
	#EndRegion
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	#Region ARAPDetails
	
	ArrayOfPaymentDecryptionStrings = New Array;
	If ValueIsFilled(XDTOData.ARAPDetails) Then
	
		T_RP = New Map;
		T_RP.Insert("Sum", "Sum");
		T_RP.Insert("CashFlowItem", "CFItem");
		
		For Each XDTORow In XDTOData.ARAPDetails Do
			StringDataStructure = New Structure;
			FillInRowDataStructure(T_RP, XDTORow, StringDataStructure);
			ArrayOfPaymentDecryptionStrings.Add(StringDataStructure);
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfPaymentDecryptionStrings);
	
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
		If XDTOData.ARAPDetails.Count()> 0
			And XDTOData.ARAPDetails.Columns.Find("Employee") <> Undefined Then  
			Instruction = New Structure("Value, OCRName", XDTOData.ARAPDetails[0].Employee, "Catalog_Persons_Receive"); 
			ReceivedData.AdditionalProperties.Insert("AdvanceHolder", Instruction);
		EndIf;  
	EndIf;
	
	#EndRegion
EndProcedure
