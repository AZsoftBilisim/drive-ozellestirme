Procedure OCR_Document_ReceiptOfCashRegisterAdjustment_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	FillInAttributesOfReceiptCashRegister(ReceivedData);
	
	If Not ValueIsFilled(ReceivedData.Warehouse) Then  
		If Not ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes = Undefined 
			And ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes.Count() > 0 Then
			ReceivedData.PriceKind = ExchangeComponents.ConversionParameters_SSLy.ProductPricesTypes[0].Value; 
		EndIf;
		If ValueIsFilled(ExchangeComponents.ConversionParameters_SSLy.DefaultWarehouse)
			And ExchangeComponents.ConversionParameters_SSLy.DefaultWarehouse.WarehouseStore = PredefinedValue("Enum.TypesOfWarehouses.RetailStore") Then
			ReceivedData.Warehouse = ExchangeComponents.ConversionParameters_SSLy.DefaultWarehouse;
		EndIf;
	EndIf;
	
	FillInVATTaxationBasedOnReceivedData(ExchangeComponents, ReceivedData, XDTOData, False);
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	FillInCashShiftByNumberAndCashierCashREGISTER(ReceivedData, ReceivedData.CashRegister, XDTOData.KeyProperties.CashShiftNumber);
	ReceivedData.AdditionalProperties.Insert("CashShiftNumber", XDTOData.KeyProperties.CashShiftNumber);
	
	ReceivedData.Status = Enums.CashRegisterReceiptStatuses.ReceiptIsIssued_;
	
	If XDTOData.Property("AdditionalAttributes") Then
		For Each String In XDTOData.AdditionalAttributes Do
			Property = String.Property; // Structure
			If Property.Description = "AdjustmentDescription" Then
				ReceivedData.AdjustmentDescription = String.PropertyValue;
			ElsIf Property.Description = "CorrectionDate_" Then
				ReceivedData.DateOfAdjustedCalculation = String.PropertyValue;
			ElsIf Property.Description = "PrescriptionNumber" Then
				ReceivedData.PrescriptionNumberOfTaxAuthority = String.PropertyValue;
			ElsIf Property.Description = "CRENonApplication" 
				And Lower(String.PropertyValue) = "true" Then
				ReceivedData.TypeOfCorrection = Enums.KindsOfAdjustmentReceipts.CRENonApplication;
			EndIf;
		EndDo;
	Else
		ReceivedData.AdjustmentDescription = NStr("vi = 'Điều chỉnh dữ liệu trên phiếu';
													|ru = 'Корректировка данных чека';
													|en = 'Receipt data adjustment'; fa = 'Receipt data adjustment';
													|it = 'Correzione dati scontrino';
													|pl = 'Korekta danych paragonu';
													|tr = 'Fiş verilerinin düzeltilmesi'");
		ReceivedData.DateOfAdjustedCalculation = ReceivedData.Date;
		ReceivedData.TypeOfCorrection = Enums.KindsOfAdjustmentReceipts.CorrectionOfErrors;
	EndIf;
	
	If ValueIsFilled(ReceivedData.PrescriptionNumberOfTaxAuthority) Then
		ReceivedData.AdjustmentType = Enums.TypesOfAdjustmentReceipts.ByPrescription;
	Else
		ReceivedData.AdjustmentType = Enums.TypesOfAdjustmentReceipts.Independently_;
	EndIf;
	
	If Not ValueIsFilled(ReceivedData.Partner) Then
		ReceivedData.Partner = Catalogs.Partners.UnknownPartner;
	EndIf;
	
	// Cash register payments
	If XDTOData.Property("CashRegisterPayments")
		And ValueIsFilled(XDTOData.CashRegisterPayments) Then
		
		For Each String In XDTOData.CashRegisterPayments Do
			If  String.TypeOfPayment <> Undefined Then
				If String.TypeOfPayment.Value = "CashPayment" Then
					ReceivedData.ReceivedInCash = String.Sum;
				ElsIf String.TypeOfPayment.Value = "Electronically" Then
					NewRow = ReceivedData.PaymentWithPaymentCards.Add();
					NewRow.PaymentKind_ = Enums.TypesOfCashRegisterPaymentSystem.PaymentCard;
					NewRow.POSTerminal = DefaultElement(ExchangeComponents, "POSTerminal");
					NewRow.Sum = String.Sum; 
				EndIf; 
			Else
				NewRow = ReceivedData.PaymentWithPaymentCards.Add();
				NewRow.Sum = String.Sum;
			EndIf;
		EndDo;
		
		If XDTOData.CashRegisterPayments.Count() = 1
			And XDTOData.CashRegisterPayments[0].TypeOfPayment <> Undefined Then
			CREPaymentTypes = PKPDByName(ExchangeComponents, "Transfer_CCTPaymentTypes").ConvertValuesOnReceipt.Get(XDTOData.CashRegisterPayments[0].TypeOfPayment.Value);
			If CREPaymentTypes = Enums.CREPaymentTypes.CashPayment Then
				ReceivedData.PaymentMethod = Enums.PaymentForms.CashAccountPayment_;
			EndIf;
		EndIf;
		
	EndIf;
	
	FillingRules = New Map;
	FillingRules.Insert("Products",  "Products");
	FillingRules.Insert("Count",    "Count");
	FillingRules.Insert("Sum",         "Sum");
	FillingRules.Insert("Price",          "Price");
	FillingRules.Insert("VATRate",     "VATRate");
	FillingRules.Insert("VATAmount",      "VATAmount");
	FillingRules.Insert("DiscountPercentage", "PercentRateOfManualDiscount");
	FillingRules.Insert("DiscountAmount",   "ManualDiscount");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	ArrayOfRows = New Array;
	If XDTOData.Property("GoodsSale")
		And ValueIsFilled(XDTOData.GoodsSale) Then
		
		For Each String In XDTOData.GoodsSale Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			If Not StringDataStructure.Property("NumberOfPackages") Then
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
			If StringDataStructure.Property("Sum") Then
				StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
			EndIf;
			StringDataStructure.Insert("Seller", ReceivedData.Cashier);
			
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	// Services are loaded into PM Goods
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
		
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			StringDataStructure.Insert("Seller", ReceivedData.Cashier);
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	//Payment with payment cards
	ArrayOfLinesPaymentPC = New Array;
	
	If XDTOData.Property("PaymentWithPaymentCards")
		And ValueIsFilled(XDTOData.PaymentWithPaymentCards) Then
		
		For Each String In XDTOData.PaymentWithPaymentCards Do
			StringDataStructure = New Structure;
			StringDataStructure.Insert("Sum", String.PayAmount);
			StringDataStructure.Insert("PaymentCardNumber", String.CardNumber);
			StringDataStructure.Insert("PaymentKind_", 
					?(XDTOData.PaymentWithPaymentCards.Columns.Find("TypesOfCashRegisterPaymentSystem") <> Undefined, 
					String.TypesOfCashRegisterPaymentSystem,
					Undefined));
		    If ValueIsFilled(String.POSTerminal) Then  
				CatPOSTerminal = String.POSTerminal;
				If CatPOSTerminal.Property("Number") And Not IsBlankString(CatPOSTerminal.Number) Then
					Instruction = New Structure;
					Instruction.Insert("Value", String.POSTerminal);
					Instruction.Insert("OCRName", "Catalog_POSTerminals_Receive");
			
					StringDataStructure.Insert("POSTerminal", Instruction);
				EndIf;	
			EndIf;
			ArrayOfLinesPaymentPC.Add(StringDataStructure);
		
		EndDo;
		
		If XDTOData.PaymentWithPaymentCards.Total("PayAmount") = XDTOData.CashRegisterPayments.Total("Sum") Then
			ReceivedData.PaymentMethod = Enums.PaymentForms.PaymentCard;
		EndIf;
		
		ReceivedData.AdditionalProperties.Insert("PaymentWithPaymentCards", ArrayOfLinesPaymentPC);
	EndIf;
	
	//Gift certificate
	ArrayOfPSStrings = New Array; 
	
	If XDTOData.Property("PaymentByCertificates")
		And ValueIsFilled(XDTOData.PaymentByCertificates) Then
		
		For Each String In XDTOData.PaymentByCertificates Do
			StringDataStructure = New Structure;
			StringDataStructure.Insert("Sum", String.Sum);
			If ValueIsFilled(String.Barcode) Then
				// We are preparing instructions for converting a gift certificate.
				Instruction = New Structure;
				GiftCertificateStructure = New Structure;
				GiftCertificateStructure.Insert("Barcode", String.Barcode);
				GiftCertificateStructure.Insert("MagneticCode", String.MagneticCode);
				GiftCertificateStructure.Insert("SerialNumber", String.SerialNumber);
			
				Instruction.Insert("OCRName", "Catalog_GiftCertificates");
				GiftCertificateStructure.Insert("GiftCertificateKind", String.GiftCertificateKind);
					
				Instruction.Insert("Value", GiftCertificateStructure);
				StringDataStructure.Insert("GiftCertificate", Instruction);
			EndIf;
			ArrayOfPSStrings.Add(StringDataStructure);
		
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("GiftCertificates", ArrayOfPSStrings);	
	EndIf;
	
	// Barcodes of packages.
	UploadPackageBarcodes(XDTOData, ReceivedData, ExchangeComponents, "ExciseStamps", "ExciseStamp");
EndProcedure
Procedure OCR_Document_ReceiptOfCashRegisterAdjustment_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
								
	CashShiftNumber = ReceivedData.AdditionalProperties.CashShiftNumber;
	
	// If there is an object in the database, it will be recorded (and not the received data).
	// The header and tabular part are preliminarily transferred from the received data to the given data:
	// the header is part of the properties from the PKS, the tabular part is completely taken from the received data.
	If IBData <> Undefined Then
		WarehouseInformationSecurityData = IBData.Warehouse;
	
		// We transfer those properties that are specified in the PKS.
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		If Not ExchangeComponents.ConversionParameters_SSLy.UploadAnalyticsByWarehouse Then
			// Restoring the warehouse from the original document.
			IBData.Warehouse = WarehouseInformationSecurityData;
		EndIf;
	
		// Table parts
		IBData.Goods.Load(ReceivedData.Goods.Unload());
		IBData.PaymentWithPaymentCards.Load(ReceivedData.PaymentWithPaymentCards.Unload());
		IBData.GiftCertificates.Load(ReceivedData.GiftCertificates.Unload());
	
		ReceivedData = Undefined;
		DataToWriteToIB = IBData;
	Else
		DataToWriteToIB = ReceivedData;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.CashRegisterShift) Then
		
		DocumentsWithGiftCertificates = ExchangeComponents.ConversionParameters_SSLy.DocumentsWithGiftCertificates; // ValueTable
			
		NewRow = DocumentsWithGiftCertificates.Add();
		NewRow.DocumentRef      = ?(IBData = Undefined, DataToWriteToIB.GetNewObjectRef(), DataToWriteToIB.Ref);
		NewRow.DocumentDate       = DataToWriteToIB.Date;
		NewRow.DocumentQueue    = 0;
		NewRow.CashRegister            = DataToWriteToIB.CashRegister;
		NewRow.CashShiftNumber  = CashShiftNumber;
		
	EndIf;
	
	For Each LineProducts_ In DataToWriteToIB.Goods Do
		If ValueIsFilled(LineProducts_.Series) Then
			StringSeries = DataToWriteToIB.SetOfSeries.Add();
			FillPropertyValues(StringSeries, LineProducts_);
		EndIf;
	EndDo;
		
	For Each PaymentLine_ In DataToWriteToIB.PaymentWithPaymentCards Do
		If Not ValueIsFilled(PaymentLine_.POSTerminal) Then
			PaymentLine_.POSTerminal = Catalogs.POSTerminals.DefaultPOSTerminal(DataToWriteToIB.Organization);
		EndIf;
	EndDo;
EndProcedure

