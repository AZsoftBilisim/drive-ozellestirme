Procedure OCR_Document_SubcontractorReport25_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.ProductionByToller2_5;
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData, "ARAPCurrency", "ARAPCurrency");
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	
	FillInVATTaxationBasedOnReceivedData(ExchangeComponents, ReceivedData, XDTOData);
	
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	
	If XDTOData.Property("UsedMaterials") And ValueIsFilled(XDTOData.UsedMaterials) Then
		ArrayOfStringsMaterials = New Array;
		For Each String In XDTOData.UsedMaterials Do
			
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If Not StringDataStructure.Property("NumberOfPackages") Then
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;	
			
			ArrayOfStringsMaterials.Add(StringDataStructure);
			
		EndDo;
	
		ReceivedData.AdditionalProperties.Insert("MaterialsAndWorks", ArrayOfStringsMaterials);
	EndIf;
	
	If XDTOData.Property("ManufacturedProduct") And ValueIsFilled(XDTOData.ManufacturedProduct) Then
		ArrayOfStringsProducts = New Array;
		For Each String In XDTOData.ManufacturedProduct Do
			
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If Not StringDataStructure.Property("NumberOfPackages") Then
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;	
			
			ArrayOfStringsProducts.Add(StringDataStructure);
			
		EndDo;
	
		ReceivedData.AdditionalProperties.Insert("ManufacturedProducts", ArrayOfStringsProducts);
	EndIf;
	
	#EndRegion
	
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("VATRate",    "VATRate");
	FillingRules.Insert("Sum",        "Sum");
	FillingRules.Insert("VATAmount",     "VATAmount");
	FillingRules.Insert("Count",   "Count");
	FillingRules.Insert("Price",         "Price");
	
	ArrayOfServiceStrings = New Array;
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
		
		TotalAmount = 0;
		TotalAmountOfVAT_ = 0;
		TotalAmountWithVAT_ = 0;
		
		For Each String In XDTOData.Services Do
			
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
	
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			If String.Sum = Undefined Then
				 String.Sum = 0;
			EndIf;
			
			If String.VATAmount = Undefined Then
				 String.VATAmount = 0;
			EndIf;
			AmountIncludingVAT = String.Sum + String.VATAmount;
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT); 
			
			If ValueIsFilled(ReceivedData.CourseNumerator) And ValueIsFilled(ReceivedData.CourseDenominator) Then
				StringDataStructure.Insert("AmountARAP", AmountIncludingVAT * ReceivedData.CourseNumerator / ReceivedData.CourseDenominator);
				StringDataStructure.Insert("AmountVATARAP", String.VATAmount * ReceivedData.CourseNumerator / ReceivedData.CourseDenominator);
			Else
				StringDataStructure.Insert("AmountARAP", AmountIncludingVAT);
				StringDataStructure.Insert("AmountVATARAP", String.VATAmount);
			EndIf;
			
			ArrayOfServiceStrings.Add(StringDataStructure);
		
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("Services", ArrayOfServiceStrings);
		
	EndIf;
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
EndProcedure
Procedure OCR_Document_SubcontractorReport25_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
		                            ReceivedData.AdditionalProperties, ExchangeComponents);
	
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
		                            
	If Not IBData = Undefined Then
		// We transfer those properties that are specified in the PKS
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.MaterialsAndWorks,
			IBData.MaterialsAndWorks,
			KeyFieldsArray,
			Undefined,
			"Count, Package, NumberOfPackages");  
		IBData.MaterialsAndWorks.Load(ReceivedData.MaterialsAndWorks.Unload());
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.ManufacturedProducts,
			IBData.ManufacturedProducts,
			KeyFieldsArray,
			Undefined,
			"Count, Package, NumberOfPackages");  
		IBData.ManufacturedProducts.Load(ReceivedData.ManufacturedProducts.Unload());
		
		KeyFieldsArray.Add("VATRate");
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.Services,
			IBData.Services,
			KeyFieldsArray,
			Undefined,
			"Sum, VATAmount, AmountIncludingVAT");  
		IBData.Services.Load(ReceivedData.Services.Unload());
		
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If Not ValueIsFilled(DataToWriteToIB.ProcessingServices) Then
		DataToWriteToIB.ProcessingServices = Enums.OptionsOfRegisteringProcessingDocumentServices.SpecifiedInOrder;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.GroupCosts) Then
		DataToWriteToIB.GroupCosts = Enums.CostGroupingsInTollingOrder.NoGrouping;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.MethodOfAllocatingFinishedProductCosts) Then
		DataToWriteToIB.MethodOfAllocatingFinishedProductCosts = Enums.MethodsOfCostAllocatingOnProductCosts.ByCostShares;
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.PriceKind) Then
		Filters = New Structure();
		Filters.Insert("UseForIssuingProductsWorksAndServicesAtFixedCost", True);
		DataToWriteToIB.PriceKind = Catalogs.TypesOfPrices.DefaultPriceType(DataToWriteToIB.PriceKind, Filters);
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.ARAPObjectSettings) Then
		DataToWriteToIB.ARAPObjectSettings = Enums.ARAPObjectSettings.ByARAPDocuments;
	EndIf;
	
	If ValueIsFilled(DataToWriteToIB.CourseNumerator) And ValueIsFilled(DataToWriteToIB.CourseDenominator) Then
		DataToWriteToIB.AmountARAP = DataToWriteToIB.DocumentAmount * DataToWriteToIB.CourseNumerator / DataToWriteToIB.CourseDenominator;
	Else
		DataToWriteToIB.AmountARAP = DataToWriteToIB.DocumentAmount;
	EndIf;
EndProcedure

