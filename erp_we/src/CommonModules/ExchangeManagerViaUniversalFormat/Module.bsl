	EndIf;
	If UsageOCR.Count() > 0 Then
	   If Not ValueIsFilled(IBData.Organization) Or Not ValueIsFilled(IBData.Counterparty) Then
			ClearUsageOCR(UsageOCR);
	   EndIf;		
	EndIf;
	If UsageOCR.Count() > 0 Then
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.18")
			And (ExchangeComponents.CorrespondentNodeObject <> Undefined And ExchangeComponents.CorrespondentNodeObject.SettingsMode = "ExchangeOfUPRMC")
			And IBData.MakingPaymentMethod <> Enums.MakingPaymentMethods.InstantPayments Then
			ClearUsageOCR(UsageOCR);
		EndIf;
	EndIf;
