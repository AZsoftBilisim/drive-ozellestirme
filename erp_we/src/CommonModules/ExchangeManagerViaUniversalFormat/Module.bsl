Function GetVTAdditionalInformationBoolean(ExchangeComponents)
	VTAdditionalInformationBoolean = ExchangeComponents.ConversionParameters_SSLy.VTAdditionalInformationBoolean;
	If VTAdditionalInformationBoolean = Undefined Then
		
		VTAdditionalInformationBoolean = New ValueTable;
		VTAdditionalInformationBoolean.Columns.Add("PredefinedDataName", New TypeDescription("String"));
		VTAdditionalInformationBoolean.Columns.Add("Property", New TypeDescription("ChartOfCharacteristicTypesRef.AdditionalAttributesAndInfo"));
	
		Query = New Query;
		Query.Text = "SELECT
		               |	AdditionalAttributesAndInfo.Ref AS Property,
		               |	AdditionalAttributesAndInfo.PropertiesSet.PredefinedDataName AS PredefinedDataName,
		               |	AdditionalAttributesAndInfo.ValueType AS ValueType
		               |FROM
		               |	ChartOfCharacteristicTypes.AdditionalAttributesAndInfo AS AdditionalAttributesAndInfo
		               |WHERE
		               |	AdditionalAttributesAndInfo.IsAdditionalInfo
		               |	AND NOT AdditionalAttributesAndInfo.PropertiesSet.PredefinedDataName = """"";
	
		Selection = Query.Execute().Select();
		While Selection.Next() Do
			If Selection.ValueType = New TypeDescription("Boolean") Then
				 AdditionalInformationLine = VTAdditionalInformationBoolean.Add();
				 FillPropertyValues(AdditionalInformationLine, Selection);
			EndIf;
		EndDo;
		
		ExchangeComponents.ConversionParameters_SSLy.VTAdditionalInformationBoolean = VTAdditionalInformationBoolean;
		
	EndIf;	
	
	Return VTAdditionalInformationBoolean;
EndFunction
Procedure AfterConvertingUTKAUP(ExchangeComponents)
	If StandardSubsystemsServer.IsBaseConfigurationVersion() And Not ExchangeComponents.Property("ThisIsEDIExchange") Then
		
		If ExchangeComponents.IsExchangeViaExchangePlan Then
			
			CreatedOnExportObjects = ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects;
	
			If CreatedOnExportObjects.Count() > 0 Then
				
				CorrespondentNode = ExchangeComponents.CorrespondentNode;
				SentNo = Common.ObjectAttributeValue(CorrespondentNode, "SentNo") + 1;
				
				ChangesSelection = DataExchangeServer.SelectChanges(
					CorrespondentNode,
					SentNo,
					ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects);
				
				While ChangesSelection.Next() Do
					
					Data = ChangesSelection.Get();
					DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Data);
					
				EndDo;
				
			EndIf;
			
		EndIf;
	
	EndIf;
	
	If ExchangeComponents.ExchangeDirection = "Receive" Then
	
		If ExchangeComponents.DataImportToInfobaseMode Then
	
			ParametersAfterDataLoading = TMDataExchange.ParametersAfterDataLoading();
	
			If ExchangeComponents.IsExchangeViaExchangePlan Then
				ParametersAfterDataLoading.CheckForUseOfContracts = False;
			EndIf;
	
			TMDataExchange.AfterImportData(ParametersAfterDataLoading);
		
			ProcessUploadedAdditionalBankingDetailsAndInformation(ExchangeComponents);
			ProcessUploadedArticlesDDSIKBusinessTransactions(ExchangeComponents);
			ProcessSFReceivedForUploadedAO(ExchangeComponents);
			DeferredProcessing_FillInProducts(ExchangeComponents);
			DeferredProcessing_FillingCashShifts(ExchangeComponents);
			DelayedProcessing_ClosingOfCashShifts(ExchangeComponents);
			DeferredProcessing_FillInFEAClassifier(ExchangeComponents);
			DeferredProcessing__PSRefunds(ExchangeComponents); 
	 		DeferredProcessing_FillPrimaryDocTypes(ExchangeComponents);
	 		DeferredProcessing_CreateUpdateCalculationObjects(ExchangeComponents);
	 		DeferredProcessing_FillCalculationObjects(ExchangeComponents);
	 		DeferredProcessing_GradeDocDeferredProv(ExchangeComponents);
	 		DeferredProcessing_ReflectDocumentsInRegistry(ExchangeComponents);
	 		
		EndIf;
		
		If ExchangeComponents.ConversionParameters_SSLy.WarningWasRegisteredDuringSynchronization
			And (ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.Completed2
			Or ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Undefined) Then
			ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.CompletedWithWarnings;
			ExchangeComponents.ConversionParameters_SSLy.WarningWasRegisteredDuringSynchronization = False;
		EndIf;
	
	ElsIf ExchangeComponents.ExchangeDirection = "Send" Then
		
		If ExchangeComponents.IsExchangeViaExchangePlan Then
			
			CreatedOnExportObjects = ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects;
			If CreatedOnExportObjects.Count() > 0 Then
				
				CorrespondentNode = ExchangeComponents.CorrespondentNode;
				SentNo = Common.ObjectAttributeValue(CorrespondentNode, "SentNo") + 1;
				
				ChangesSelection = DataExchangeServer.SelectChanges(
					CorrespondentNode,
					SentNo,
					ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects);
				
				While ChangesSelection.Next() Do
					
					Data = ChangesSelection.Get();
					DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Data);
					
				EndDo;
				
			EndIf;
			
		EndIf;
		
		If ExchangeComponents.ConversionParameters_SSLy.WarningWasRegisteredDuringSynchronization
			And (ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.Completed2
			Or ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Undefined) Then
			ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.CompletedWithWarnings;
			ExchangeComponents.ConversionParameters_SSLy.WarningWasRegisteredDuringSynchronization = False;		
		EndIf;
		
	EndIf;
EndProcedure
Procedure AfterMerzhevaniya_PBDS(ReceivedData, IBData, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	// Type of payment document.
	If Not ValueIsFilled(DataToWriteToIB.PaymentDocumentType) Then
		DataToWriteToIB.PaymentDocumentType = Enums.TypesOfPaymentDocuments.PaymentOrder;
	EndIf;
	
	// Recalculation of the conversion amount.
	If DataToWriteToIB.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		
		If DataToWriteToIB.ConversionRate <> 0 And DataToWriteToIB.DocumentAmount <> 0 Then
			If DataToWriteToIB.CurrencyOfConversion = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(DataToWriteToIB.Organization) Then
				DataToWriteToIB.ConversionAmount = DataToWriteToIB.DocumentAmount * DataToWriteToIB.ConversionRate;
			Else
				DataToWriteToIB.ConversionAmount = DataToWriteToIB.DocumentAmount / DataToWriteToIB.ConversionRate;
			EndIf;
		Else
			DataToWriteToIB.ConversionAmount = 0;
		EndIf;
	
	EndIf;
		
	// Decryption of the payment. Income item and division.
	If DataToWriteToIB.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt Then
		
		FillInDivisionInPaymentTranscript(DataToWriteToIB, ExchangeComponents);
		
		For Each LineRP In DataToWriteToIB.ARAPDetails Do
			If Not ValueIsFilled(LineRP.IncomeItem) Then
				LineRP.IncomeItem = ChartsOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOtherAssets;
			EndIf;
		EndDo;
	
	EndIf;
	If Not ValueIsFilled(ReceivedData.Counterparty) Then
	    FillInAllOurEnterprise(ReceivedData, ExchangeComponents.ConversionParameters_SSLy);
	EndIf;
	FillInPaymentBasisFromAdditionalProperties(DataToWriteToIB, ReceivedData.AdditionalProperties);
EndProcedure
Procedure AfterMerzhevaniya_PKO(ReceivedData, IBData, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	// Decryption of the payment. Income item and division.
	If DataToWriteToIB.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt Then
		
		FillInDivisionInPaymentTranscript(DataToWriteToIB, ExchangeComponents);
		
		For Each LineRP In DataToWriteToIB.ARAPDetails Do
			If Not ValueIsFilled(LineRP.IncomeItem) Then
				LineRP.IncomeItem = ChartsOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOtherAssets;
			EndIf;
		EndDo;
		
	EndIf;
	
	FillInPaymentBasisFromAdditionalProperties(DataToWriteToIB, ReceivedData.AdditionalProperties);
EndProcedure
Procedure AfterMerzhevaniya_RKO(ReceivedData, IBData, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	// Decryption of the payment. Item of expenditure and division.
	If DataToWriteToIB.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue Then
		
		FillInDivisionInPaymentTranscript(DataToWriteToIB, ExchangeComponents);
		
		For Each LineRP In DataToWriteToIB.ARAPDetails Do
			If Not ValueIsFilled(LineRP.ExpenseItem) Then
				LineRP.ExpenseItem = ChartsOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOtherLiabilities;
			EndIf;
		EndDo;
	
	EndIf;
EndProcedure
Procedure AfterMerzhevaniya_SBDS(ReceivedData, IBData, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	// Type of payment document.
	If Not ValueIsFilled(DataToWriteToIB.PaymentDocumentType) Then
		DataToWriteToIB.PaymentDocumentType = Enums.TypesOfPaymentDocuments.PaymentOrder;
	EndIf;
	
	// The order of payment.
	If Not ValueIsFilled(DataToWriteToIB.RankingInPriorityOfPayment) Then
		DataToWriteToIB.RankingInPriorityOfPayment = 5;
	EndIf;
	
	// Counterparty's Bank account. 
	If Not ValueIsFilled(DataToWriteToIB.CounterpartyBankAccount) And ValueIsFilled(DataToWriteToIB.Counterparty)
		And ValueIsFilled(DataToWriteToIB.Currency) Then
		DataToWriteToIB.CounterpartyBankAccount = DefaultCounterpartyBankAccount(DataToWriteToIB.Counterparty, DataToWriteToIB.Currency);
	EndIf;
	
	// Decryption of the payment. Item of expenditure and division.
	If DataToWriteToIB.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue
		Or DataToWriteToIB.BusinessOperation = Enums.BusinessTransactions.TransferOfTaxesAndContributions Then
		
		FillInDivisionInPaymentTranscript(DataToWriteToIB, ExchangeComponents);
		
		For Each LineRP In DataToWriteToIB.ARAPDetails Do
			If Not ValueIsFilled(LineRP.ExpenseItem) Then
				LineRP.ExpenseItem = ChartsOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOtherLiabilities;
			EndIf;
		EndDo;
	
	EndIf;
	// Bank Accounts Of the List Of Counterparties
	If DataToWriteToIB.OperationWithSelfEmployedPerson And Not DataToWriteToIB.ListOfCounterparties_ 
		And DataToWriteToIB.BankAccountsOfCounterpartyList.Count() > 0 Then
		
		DataToWriteToIB.BankAccountsOfCounterpartyList.Clear();
		
	EndIf;
EndProcedure
