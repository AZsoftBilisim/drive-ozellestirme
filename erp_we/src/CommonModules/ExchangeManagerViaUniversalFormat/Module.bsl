		Return;
	EndIf;
	
	If Not ValueIsFilled(IBData.Department) Then
		XDTOData.Insert("SendingDepartment",
			Common.ObjectAttributeValue(IBData.SourceWarehouse, "Department"));
	EndIf;
	
