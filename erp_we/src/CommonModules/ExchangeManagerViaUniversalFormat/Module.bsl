	EndIf;
EndProcedure
Procedure FillInTSAndEnterBalances(ReceivedData, PMXDTOData, ExchangeComponents, FillingRules = Undefined)
	If FillingRules = Undefined Then
		FillingRules = New Map;
		FillingRules.Insert("AmountExcludingVAT",         "AmountExcludingVAT");
		FillingRules.Insert("VATAmount",            "VATAmount");
		FillingRules.Insert("Products",        "Products");
		FillingRules.Insert("Count",          "Count");
		FillingRules.Insert("VATRate",           "VATRate");
		FillingRules.Insert("RowID", "RowID");
		If FOValue("UseItemVariants", ExchangeComponents) Then
			FillingRules.Insert("Characteristic",     "Characteristic");
		EndIf;
		If FOValue("UseItemPackages", ExchangeComponents) Then
			FillingRules.Insert("Package",           "Package");
			FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
		EndIf;
		If FOValue("UseItemsBatch", ExchangeComponents) Then
			FillingRules.Insert("Series",              "Series");
		EndIf;
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		    FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
		EndIf;
	EndIf;
	
	ThereIsColumnNumberOfCCD = PMXDTOData.Columns.Find("CCDNumber") <> Undefined;
	ArrayOfTSStrings = New Array;
	
	For Each String In PMXDTOData Do
	
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
		    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
		EndIf;
	
		If ThereIsColumnNumberOfCCD And ValueIsFilled(String.CCDNumber) Then
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		        StringDataStructure.Insert("CCDNumber", String.CCDNumber);
		    Else
				StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
			EndIf;
		EndIf;
		
		//Bypassing the format restriction
		If ValueIsFilled(String.AmountExcludingVAT)
			And String.AmountExcludingVAT = 0.01 * ?(String.Count > 0, -1, 1) Then
			String.AmountExcludingVAT = 0;
		EndIf;
		
		If Not ValueIsFilled(String.VATAmount) Then
			String.VATAmount = 0;
		EndIf;
		
		If String.Count <> 0 Then
			StringDataStructure.Insert("Price", Round(String.AmountExcludingVAT / String.Count, 2));
		EndIf;
		
		StringDataStructure.Insert("Sum",     		 String.AmountExcludingVAT);
		StringDataStructure.Insert("SumCompl",     	 String.AmountExcludingVAT);
		StringDataStructure.Insert("AmountIncludingVAT",     	 String.AmountExcludingVAT + String.VATAmount);
		StringDataStructure.Insert("VATLocal",     		 String.VATAmount);
		If StringDataStructure.Property("NumberOfPackages") Then
		    If StringDataStructure.Property("Package") And StringDataStructure.Property("Sum") Then
				StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
			EndIf;
		Else
			StringDataStructure.Insert("NumberOfPackages", String.Count);
		EndIf;
		
		ArrayOfTSStrings.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfTSStrings);
EndProcedure
Procedure FillPackingOfTSString(ExchangeComponents, String, AccordingToRequest = True)
	If AccordingToRequest Then
		If String.UnloadingPackages And ValueIsFilled(String.PackagingRef) Then
			If String.ProductPackaging Then
				String.Package = String.PackagingRef;
			Else
				Package = New Structure();
				Package.Insert("Description",     String.PackagingName_);
				Package.Insert("UnitOfMeasure", String.PackagingUnitOfMeasure);
				Package.Insert("Height",           String.PackingHeight);
				Package.Insert("Depth",          String.PackingDepth);
				Package.Insert("VolumeM3",            String.PackagingVolume);
				Package.Insert("Width",           String.PackingWidth);
				Package.Insert("Denominator",      String.PackingDenominator);
				Package.Insert("Numerator",        String.PackingNumerator);
				Package.Insert("Owner",         String.Products);
				Package.Insert("Ref",           String.PackagingRef);
				
				// Search for the unit of measurement if the base unit is being unloaded as a package.
				If Not ValueIsFilled(String.PackagingUnitOfMeasure) And String.PackagingOwner = Catalogs.PackagingGroups.BasicUnitsOfMeasure Then
					
					// In interactive mode, you cannot specify a basic unit of measurement with the number of pieces type in the package.
					// We do not unload incorrectly filled packages.
					If String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.NumberOfPieces Then
						Return;
					EndIf;
					
					If String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.Length Then
						BaseUnitOfMeasureDescription = "m";
						BaseUnitCode          = "006";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.AreaTypeOfMeasurement Then
						BaseUnitOfMeasureDescription = "M2";
						BaseUnitCode          = "055";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.VolumeM3 Then
						BaseUnitOfMeasureDescription = "M3";
						BaseUnitCode          = "113";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.Weight Then
						BaseUnitOfMeasureDescription = "kg";
						BaseUnitCode          = "166";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.Energy Then
						BaseUnitOfMeasureDescription = "TT.Ch";
						BaseUnitCode          = "243";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.Capacity Then
						BaseUnitOfMeasureDescription = "TT";
						BaseUnitCode          = "212";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.ElectricCharge Then
						BaseUnitOfMeasureDescription = "A.Ch";
						BaseUnitCode          = "263";
					ElsIf String.PackagingTypeOfMeasuredValue = Enums.TypesOfMeasuredValues.Time Then
						BaseUnitOfMeasureDescription = "From1";
						BaseUnitCode          = "354";
					EndIf;
					
					Query = New Query("SELECT
						|	PackagesAndUnitsOfMeasure.Ref AS Ref
						|FROM
						|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
						|WHERE
						|	PackagesAndUnitsOfMeasure.Owner = VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure)
						|	AND PackagesAndUnitsOfMeasure.Code = &Code
						|
						|UNION ALL
						|
						|SELECT
						|	PackagesAndUnitsOfMeasure.Ref
						|FROM
						|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
						|WHERE
						|	PackagesAndUnitsOfMeasure.Owner = VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure)
						|	AND PackagesAndUnitsOfMeasure.Description = &Description");
					Query.SetParameter("Code", BaseUnitCode);
					Query.SetParameter("Description", BaseUnitOfMeasureDescription);
					
					Selection = Query.Execute().Select();
					If Selection.Next() And ValueIsFilled(Selection.Ref) Then
						Package.Insert("UnitOfMeasure", Selection.Ref);
					EndIf;
				EndIf;
				
				String.Package = New Structure("Value, OCRName",
					Package, "Catalog_Packing_FromStructure");
					
				ProcessingRule = ExchangeComponents.DataProcessingRules.Find("Catalog_PackagesAndUnitsOfMeasure_Send", "Name");
				If Not ProcessingRule = Undefined Then
					DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Package, ProcessingRule);
				EndIf;
			EndIf;
		EndIf;
	Else
		If ValueIsFilled(String.PackagingRef) And ValueIsFilled(String.Products) Then
			Package = Common.ObjectAttributesValues(
					String.PackagingRef, "Owner, Description, UnitOfMeasure, Height,
						|Depth, VolumeM3, Width, Denominator, Numerator");
			
			If Package.Owner = String.Products Then
				String.Package = String.PackagingRef;
			Else
				Package.Insert("Owner", String.Products);
				String.Package = New Structure("Value, OCRName",
					Package, "Catalog_Packing_FromStructure");
					
				ProcessingRule = ExchangeComponents.DataProcessingRules.Find("Catalog_PackagesAndUnitsOfMeasure_Send", "Name");
				If Not ProcessingRule = Undefined Then
					DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Package, ProcessingRule);
				EndIf;
			EndIf;
		EndIf;
	EndIf;
EndProcedure
Procedure FillInCharacteristicOfTSString(ExchangeComponents, String, AccordingToRequest = True)
	If AccordingToRequest Then
		If ValueIsFilled(String.CharacteristicReference) Then
			If String.CharacteristicCorrespondsToFormat Then
				String.Characteristic = String.CharacteristicReference;
			Else
				Characteristic = New Structure();
				Characteristic.Insert("Description",       String.CharacteristicName);
				Characteristic.Insert("DescriptionFull", String.CharacteristicFullName);
				Characteristic.Insert("Owner",           String.CharacteristicOwner);
				
				String.Characteristic = New Structure("Value, OCRName",
					Characteristic, "Catalog_ProductCharacteristics_FromStructure");
					
				ProcessingRule = ExchangeComponents.DataProcessingRules.Find("Catalog_ItemsCharacteristics_Send", "Name");
				If Not ProcessingRule = Undefined Then
					DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Characteristic, ProcessingRule);
				EndIf;
			EndIf;
		EndIf;
	Else
		If ValueIsFilled(String.CharacteristicReference) And ValueIsFilled(String.Products) Then
			Characteristic = Common.ObjectAttributesValues(String.CharacteristicReference,
				"Owner, Description, DescriptionFull");
				
			ProductKind = Common.ObjectAttributeValue(String.Products, "ProductKind");
			
			If Characteristic.Owner = String.Products
				Or (Characteristic.Owner = ProductKind
				And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7")) Then
				String.Characteristic = String.CharacteristicReference;	
			Else	
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) = NumberFormatVersion("1.6") Then
					Characteristic.Insert("Owner", String.Products);
				Else
			        Characteristic.Insert("Owner", ProductKind);
			    EndIf;
			        
				String.Characteristic = New Structure("Value, OCRName",
					Characteristic, "Catalog_ProductCharacteristics_FromStructure");
					
				ProcessingRule = ExchangeComponents.DataProcessingRules.Find(
					"Catalog_ItemsCharacteristics_Send", "Name");
				If Not ProcessingRule = Undefined Then
					DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Characteristic, ProcessingRule);
				EndIf;
			EndIf;
		EndIf;
	EndIf;
EndProcedure
Procedure FillInCharacteristicsOfWHPackage(ExchangeComponents, Table, FillInCharacteristic = True, FillPackage = True)
	If FillInCharacteristic Then
		
		CharacteristicsBasedOnRequestData = Not Table.Columns.Find("CharacteristicReference") = Undefined;
		
		If CharacteristicsBasedOnRequestData Then
			Table.Columns.Add("Characteristic");
		Else
			Table.Columns.Characteristic.Name = "CharacteristicReference";
			Table.Columns.Add("Characteristic");
		EndIf;
		
	EndIf;
	
	If FillPackage Then
		
		PackingAccordingToRequest = Not Table.Columns.Find("PackagingRef") = Undefined;
		
		If PackingAccordingToRequest Then
			Table.Columns.Add("Package");
		Else
			Table.Columns.Package.Name = "PackagingRef";
			Table.Columns.Add("Package");
		EndIf;
		
	EndIf;
	
	For Each String In Table Do
		If FillInCharacteristic
			And GetFunctionalOption("UseItemVariants")  Then
			FillInCharacteristicOfTSString(ExchangeComponents, String, CharacteristicsBasedOnRequestData);
		EndIf;
		
		If FillPackage 
			And GetFunctionalOption("UseItemPackages") Then
			FillPackingOfTSString(ExchangeComponents, String, PackingAccordingToRequest);
		EndIf;
		
	EndDo;
	
	If Not GetFunctionalOption("UseItemVariants")
		And Not Table.Columns.Find("Characteristic") = Undefined Then
		
		Table.Columns.Delete("Characteristic");
	EndIf;
	
	If Not GetFunctionalOption("UseItemPackages") 
		And Not Table.Columns.Find("Package") = Undefined Then
		
		Table.Columns.Delete("Package");
	EndIf;
EndProcedure
Procedure FillInPriceWriteOffReEntry(GoodsTable, ExchangeComponents)
	For Each LineProducts_ In GoodsTable Do
		Price = 0;
		If Not LineProducts_.Count = 0 Then
			Price = Round(LineProducts_.Sum / LineProducts_.Count, 2);
		EndIf;
		
		LineProducts_.Price = Price;
		
	EndDo;
EndProcedure
Procedure FillInWHBarcodes(ExchangeComponents, Table, BarcodeTable)
	If BarcodeTable.Count() = 0 Then
		Return;
	EndIf;
	
	Table.Columns.Add("Barcode");
	BarcodeTable.Indexes.Add("Products, Characteristic, Package");
	For Each TableRow In Table Do
		Filter = New Structure;
		Filter.Insert("Products", TableRow.Products);
		
		Filter.Insert("Characteristic", 
			?(ValueIsFilled(TableRow.CharacteristicReference),
			TableRow.CharacteristicReference,
			Catalogs.ItemsCharacteristics.EmptyRef()
			));
		
		Filter.Insert("Package", 
			?(ValueIsFilled(TableRow.PackagingRef),
			TableRow.PackagingRef,
			Catalogs.PackagesAndUnitsOfMeasure.EmptyRef()
			));
			
		FoundBarcodes = BarcodeTable.FindRows(Filter);
		If Not ValueIsFilled(FoundBarcodes) Then
			Continue;
		EndIf;
		
		TableRow.Barcode = FoundBarcodes[0].Barcode;
	EndDo;
EndProcedure


Function ValueInICOInstruction(ExchangeComponents, Value, IsSimpleType = False, RuleFound = False)
	// Parameters:
	// Exchange components - the structure of the exchange components within the Cur session;
	// Value - the value that must be placed in the property of the XDTO object;
	// This type is the outgoing parameter. Specifies whether the type of the passed value is primitive (Number, String, Boolean, Date);
	// Rule found - determines whether the conversion rule was found. If a rule is found, but Result = Undefined, it means that more than one ICO was found for the value.
	Result = Undefined;
	
	If Not ValueIsFilled(Value) Then
		Return Result;
	EndIf;
	
	ThisIsSending		= (ExchangeComponents.ExchangeDirection = "Send");
	ThisIsGetting	= (ExchangeComponents.ExchangeDirection = "Receive");
	
	PropertyValueType1 = TypeOf(Value);
	
	If ThisIsGetting
		And TypeOf(Value) = Type("Structure")
		And Value.Property("Ref") Then
		
		PropertyValueType1 = Value.Ref.XDTOValueType;
	ElsIf TypeOf(Value) = Type("Structure")
		And Value.Property("OCRName") Then
		
		Return New Structure("Value, OCRName", Value, Value.OCRName);
	EndIf;
	
	If PropertyValueType1 = Type("Number") 
		Or PropertyValueType1 = Type("String")
		Or PropertyValueType1 = Type("Boolean")
		Or PropertyValueType1 = Type("Date") Then
		
		Result = Value;
		IsSimpleType = True;
	Else
		
		// For some objects of the format, upon receipt, it is necessary to perform a ICO search by conditions
		//  if it was possible to find a rule by condition, then we refuse further search.
		Result = ValueInICOInstructionAccordingToConditions(Value, ExchangeComponents);
		
		If Result <> Undefined Then
			
			Return Result;
			
		EndIf;
		
		ICOLines = New Array;
		
		If ThisIsSending Then
			ICOLines = ExchangeComponents.ObjectsConversionRules.FindRows(New Structure("DataType", PropertyValueType1));
		ElsIf ThisIsGetting Then
			ICOLines = ExchangeComponents.ObjectsConversionRules.FindRows(New Structure("XDTORefType", PropertyValueType1));
		EndIf;
	
		// We are only looking for an unambiguous match.
		// If more than one rule is found, we assume that the conversion has not been completed.
		IsFolder = Undefined;
				
		For Each ICOString In ICOLines Do
			
			If ThisIsGetting And TypeOf(Value) = Type("Structure") And Value.Property("ValueType") Then
				
				// Error bypass up to version ED 1.6
				// link type "Key property of the report to the Subscriber" - the report of the Commissionaire.
				If (Value.ValueType = "ОтчетКомитенту" Or Value.ValueType = "ОтчетКомиссионера")
	
					And StrFind(ICOString.FormatObject, Value.ValueType) = 0 Then  // @Non-NLS-1 @Non-NLS-2
					Continue;
				EndIf;
	
				If Value.ValueType = "РеализацияТоваровУслуг"
	
					And StrFind(ICOString.ReceivedDataTableName, Value.ValueType) = 0 Then // @Non-NLS-1
					Continue;
				EndIf;
	
				If Value.ValueType = "ПоступлениеТоваровУслуг" Then // @Non-NLS-1
					ICOString.OCRName = "Document_ReceiptOfGoodsServices_Receipt";
					RuleFound = False;
				EndIf;
				
			EndIf;
			
			If ThisIsSending Then
				
				If ICOString.IsCatalog Then
					
					If IsFolder = Undefined
						And ICOString.DataObject.Hierarchical
						And ICOString.DataObject.HierarchyType = Metadata.ObjectProperties.HierarchyType.HierarchyFoldersAndItems Then
						IsFolder = Common.ObjectAttributeValue(Value, "IsFolder");
					EndIf;
					
					If IsFolder = Undefined 
						Or (IsFolder = True
							And Not ICOString.RuleForCatalogGroup)
						Or (Not IsFolder = True
							And ICOString.RuleForCatalogGroup) Then
						
						Continue;					
					
					EndIf;			
					
				EndIf;
	
			EndIf;
			
			If RuleFound Then
				Result = Undefined;
				Break;
			Else
				Result = New Structure("Value, OCRName", Value, ICOString.OCRName);
				RuleFound = True;
			EndIf;
					
		EndDo;			
	EndIf;
	
	Return Result;
EndFunction
Function ValueInICOInstructionAccordingToConditions(Value, ExchangeComponents)
	Result = Undefined;
	
	If ExchangeComponents.ExchangeDirection = "Receive"
		And TypeOf(Value) = Type("Structure") And Value.Property("ValueType") Then
	
		// Bypassing restrictions on searching for rules to support sales through a commission agent 
		If Value.ValueType = "ОтчетКомиссионера" Then // @Non-NLS-1
			
			OCRName = "Document_CommissionAgentSReport_Receipt";
			
			If Value.Property("ВидОперацииОтчетаКоммисионера") Then // @Non-NLS-1
				
				If (Value.TypeOfOperationOfCommissionaireSReport.Value = "РеализацияЧерезКомиссионераБезПереходаПраваСобственности"
					Or Value.TypeOfOperationOfCommissionaireSReport.Value = "РеализацияЧерезКомиссионера")  Then // @Non-NLS-1 @Non-NLS-2
					
					OCRName = "Document_SaleOfGoodsAndServicesFee_Receipt";
					
				ElsIf Value.TypeOfOperationOfCommissionaireSReport.Value = "ВозвратТоваровОтКомиссионера" Then // @Non-NLS-1
					
					OCRName = "Document_ReturnOfGoodsFromCustomerFee_Receipt";
					
				EndIf;
				
			EndIf;
			
			Result = New Structure("Value, OCRName", Value, OCRName); 
			
		ElsIf Value.ValueType = "ОперацияПоПлатежнойКарте" Then // @Non-NLS-1
			
			OCRName = "Document_PaymentCardOperation_Receipt";
			
			
			Result = New Structure("Value, OCRName", Value, OCRName);
		
		ElsIf Value.ValueType = "ВозвратТоваровОтПокупателя" Then // @Non-NLS-1
			
			Result = New Structure("Value, OCRName", Value, "Document_ReturnOfGoodsFromBuyer_Receipt");
			
			
		EndIf;
	
	EndIf;
	
	Return Result;
EndFunction
Function ValueIsInCompositeTypeOfExchangeFormat(NameOfPropertyOfCompositeType, PropertyTypeYouAreLookingFor, ExchangeComponents)
	PropertyFound = False;
	
	FlexibleTypeProperty = XDTOFactory.Type(New XMLDataType(NameOfPropertyOfCompositeType, ExchangeComponents.XMLSchema));
	
	If FlexibleTypeProperty = Undefined Then
		
		Return PropertyFound;
		
	EndIf;
	
	TypesCollecton = XDTOFactory.Create(FlexibleTypeProperty).Properties();
	
	For Each FlexibleTypeProperty In TypesCollecton Do
		
		If FlexibleTypeProperty.Type = PropertyTypeYouAreLookingFor Then
			
			PropertyFound = True;
			
			Break;
			
		EndIf;
		
	EndDo;
	
	Return PropertyFound;
EndFunction
Function TheValueOfTheEnumerationByName(TypeOfEnumeration_, EnumValueName)
	EnumValues = Metadata.Enums[TypeOfEnumeration_].EnumValues;
				
	If Not EnumValues.Find(EnumValueName) = Undefined Then
		Return Enums[TypeOfEnumeration_][EnumValueName];
	Else
		Return Undefined;
	EndIf;
EndFunction

Function FOValue(FOName, ExchangeComponents)
	FOValues = ExchangeComponents.ConversionParameters_SSLy.FOValues;
	
	FOValue = FOValues.Get(FOName);
	If FOValue = Undefined Then
		FOValue = GetFunctionalOption(FOName);
		FOValues.Insert(FOName, FOValue);
	EndIf;
	
	Return FOValue;
EndFunction


Function ValuesOfExistingItemDetails(Object, AttributesNames)
	AttributesStructure1 = New Structure(AttributesNames);
	
	If Not ValueIsFilled(Object) Then
		
		Return AttributesStructure1;
		
	EndIf;
	
	ArrayOfPropsNames = StrSplit(AttributesNames, ",", False);
	
	For ReverseIndex = - ArrayOfPropsNames.UBound() To 0 Do
		
		IndexOf = - ReverseIndex;
		
		If Not CommonClientServer.HasAttributeOrObjectProperty(Object, ArrayOfPropsNames[IndexOf]) Then
			
			ArrayOfPropsNames.Delete(IndexOf);
			
		EndIf;
		
	EndDo;
	
	ObjectAttributesValues = Common.ObjectAttributesValues(Object, ArrayOfPropsNames);
	
	FillPropertyValues(AttributesStructure1, ObjectAttributesValues);
	
	Return AttributesStructure1;
EndFunction
Function NameOfICOForDataObject(ExchangeComponents, Object, Organization)
	OCRName = "";
	RefType = TypeOf(Object);
	
	If RefType = Type("DocumentRef.ExpenseReport") Then
		
		OCRName = "Document_AdvanceReport_Dispatch";
		
	ElsIf RefType = Type("DocumentRef.CustomerInvoiceServices") Then
		
		OCRName = ?(PropertyOfExchangeFormat(ExchangeComponents, "Документ.АктВыполненныхРабот"),
			"Document_ReportOfCompletedWorks_Sending",
			"Document_ReportOfCompletedWorkRTU_Sending"); //@NON-NLS-1
		
	ElsIf RefType = Type("DocumentRef.ARAPSettlement") Then
		
		OCRName = "Document_VZ_OurOrganization";	
	
	ElsIf RefType = Type("DocumentRef.ReturnOfGoodsToVendor") Then
		
		OCRName = "Document_ReturnOfGoodsToSupplier_Sending";
		
	ElsIf RefType = Type("DocumentRef.ReturnOfGoodsFromCustomer") Then
		
		OCRName = "Document_ReturnOfGoodsFromCustomer_Sending";
		If ReturnOfGoodsViaCommissionAgent(Common.ObjectAttributeValue(Object, "BusinessOperation")) Then
			
			OCRName = "Document_ReturnOfGoodsFromCustomerFee_Sending";
			
		EndIf;	
	ElsIf RefType = Type("DocumentRef.PurchaseOrder") Then
		
		OCRName = "Document_OrderToSupplier_Sending";	
		
	ElsIf RefType = Type("DocumentRef.SalesOrder") Then
		
		OCRName = "Document_CustomerOrder_Sending";	
	
	ElsIf RefType = Type("DocumentRef.PurchaseAdjustment") Then
		
		OCRName = "Document_IncomeAdjustment_Sending";
		
	ElsIf RefType = Type("DocumentRef.SaleAdjustment") Then
		
		AdjustmentKind = Common.ObjectAttributeValue(Object, "AdjustmentKind");	
	
		If AdjustmentKind = Enums.BusinessTransactions.SaleOfOverdeliveredGoods Then
			OCRName = "Document_ImplementationAdjustment_Implementation";
		ElsIf AdjustmentKind = Enums.BusinessTransactions.ReturnOfUnderdeliveredGoods Then
			OCRName = "Document_ImplementationAdjustment_Return";
		Else
			OCRName = "Document_ImplementationAdjustment_Dispatch";
		EndIf;
	ElsIf RefType = Type("DocumentRef.GoodsShipmentToCustomer")
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21") Then
	
		OCRName = "Document_ShipmentOfGoodsToCustomer_Sending";
	
	ElsIf TypeOf(Object) = Type("DocumentRef.ReportToMaterialProvider2_5") Then
			
		OCRName = "Document_ReportToGiver25_Sending";
		
		
	ElsIf TypeOf(Object) = Type("DocumentRef.SubcontractorReport2_5") Then
		
		OCRName = "Document_ProcessorReport25_Send";
	ElsIf TypeOf(Object) = Type("DocumentRef.RedemptionOfGoodsFromStorage") Then
		
		OCRName = "Document_PurchaseOfGoods_PTU_Shipment";		
		
	ElsIf RefType = Type("DocumentRef.ConsignmentReportFromCustomer") Then
		
		OCRName = "Document_CommissionAgentSReport_Sending";
		
	ElsIf RefType = Type("DocumentRef.ConsignmentReportToVendor") Then
		
		OCRName = "Document_ReportToCommittee_Sending";
		
	ElsIf RefType = Type("DocumentRef.WriteOffReportFromCommissionAgent") Then
		
		OCRName = "Document_CommissionAgentSReportOnDebiting_Sending";	
		
	ElsIf RefType = Type("DocumentRef.PurchaseInvoiceConsignmentStockLost") Then
		
		OCRName = "Document_ReportToCommitteeOnDebiting_Sending";
		
	ElsIf RefType = Type("DocumentRef.SourceDocument")
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		
		OCRName = "Document_PrimaryDocument_Sending";
		
	ElsIf RefType = Type("DocumentRef.VendorInvoice") Then
		
		BusinessTransaction = Common.ObjectAttributeValue(Object, "BusinessOperation");
		
		OCRName = ?(BusinessTransaction = Enums.BusinessTransactions.PurchaseViaAdvanceHolder,
			"Document_PTUThroughAccountablePerson_Sending",
			"Document_ReceiptOfGoodsServices_Dispatch");
		
	ElsIf RefType = Type("DocumentRef.VendorInvoiceServicesAndAssets") Then
		
		BusinessTransaction = Common.ObjectAttributeValue(Object, "BusinessOperation");
		
		OCRName = ?(BusinessTransaction = Enums.BusinessTransactions.PurchaseViaAdvanceHolder,
			"Document_PUPAThroughAccountablePerson_Sending",
			"Document_ReceiptOfServicesOtherAssets_Sending");
	
	ElsIf RefType = Type("DocumentRef.CashVoucher") Then
		
		BusinessTransaction = Common.ObjectAttributeValue(Object, "BusinessOperation");
		
		If BusinessTransaction = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
			OCRName = "Document_ACWInternalTransfer_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CurrencyConversion Then
			OCRName = "Document_RCOCurrencyConversion_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashDepositToBankAccount
				Or BusinessTransaction = Enums.BusinessTransactions.CashCollectionToBank Then
			OCRName = "Document_RCOToBankAccount_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.SalaryPaymentViaCashAccount
			Or BusinessTransaction = Enums.BusinessTransactions.SalaryPaymentToEmployee
			Or BusinessTransaction = Enums.BusinessTransactions.SalaryPaymentByDistributor Then
			OCRName = "Document_RCOSalaryPayment_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.IssueCashToAdvanceHolder Then
			OCRName = "Document_RCOSettlementsWithEmployees_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.OtherCashIssue
			Or BusinessTransaction = Enums.BusinessTransactions.OtherExpenses Then
			OCRName = "Document_RKOOtherIssue_Sending";
		ElsIf  BusinessTransaction = Enums.BusinessTransactions.RefundToCustomer
			Or BusinessTransaction = Enums.BusinessTransactions.RefundToAnotherCompany Then
			OCRName = "Document_RCOSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.PaymentToVendor
			Or BusinessTransaction = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
			OCRName = "Document_RCOSettlementsWithCounterparties_Sending";
		ElsIf ThisIsBusinessOperationSettlementsOnLoansLoans(BusinessTransaction) Then
			OCRName = "Document_RCOSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashIssueToCashRegister Then
			OCRName = "Document_RCOIssuanceToCashRegister_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.PaymentToLessor Then
			OCRName = "Document_RCOSettlementsWithCounterparties_Sending";	
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashIssueToAnotherCashAccount Then
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
				OCRName = "Document_RCODeliveryToAnotherCashier_Sending";
			EndIf;
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.CashAccountReceiptNote") Then
		
		BusinessTransaction = Common.ObjectAttributeValue(Object, "BusinessOperation");
		
		If BusinessTransaction = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
			OCRName = "Document_OCRInternalTransfer_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CurrencyConversion Then
			OCRName = "Document_PCOCurrencyConversion_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromBank Then
			OCRName = "Document_PCOReceiptOfCashInBank_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashCollectionFromBank Then
			OCRName = "Document_PCOReceiptOfCashInBank_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromOtherCompany
			Or BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromCustomer Then
			OCRName = "Document_PCOSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.RefundFromVendor
			Or BusinessTransaction = Enums.BusinessTransactions.RefundFromAnotherCompany Then
			OCRName = "Document_PCOSettlementsWithCounterparties_Sending";
		ElsIf ThisIsBusinessOperationSettlementsOnLoansLoans(BusinessTransaction)
			Or ThisIsBusinessOperationSettlementOfDeposits(BusinessTransaction) 
			Or BusinessTransaction = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty Then
			OCRName = "Document_PCOSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReturnByAdvanceHolder
			Or BusinessTransaction = Enums.BusinessTransactions.LoanRepaymentByEmployee Then
			OCRName = "Document_PCOSettlementsWithEmployees_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromCashRegister Then
			OCRName = "Document_PCOReceiptFromCashRegister_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromAnotherCashAccount Then
			OCRName ="Document_PCOReceivedFromAnotherSalesRegister_Sent";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.RefundFromLessor Then
			OCRName ="Document_PCOSettlementsWithCounterparties_Sending";
		EndIf;
	
	ElsIf RefType = Type("DocumentRef.CustomerInvoice") Then
		
		OCRName = "Document_SaleOfGoodsAndServices_Shipment";
		If SalesViaCommissionAgent(Common.ObjectAttributeValue(Object, "BusinessOperation")) 
			And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17")  Then
	
			OCRName = "Document_SaleOfGoodsAndServicesFee_Shipment";
	
		EndIf;
	ElsIf RefType = Type("DocumentRef.CustomerInvoiceServicesAndAssets") Then
		
		OCRName = "Document_SaleOfServicesOtherAssets_Sending";
		
	ElsIf RefType = Type("DocumentRef.BankAccountIssue") Then
		
		BusinessTransaction = Common.ObjectAttributeValue(Object, "BusinessOperation");
		
		If BusinessTransaction = Enums.BusinessTransactions.CurrencyConversion Then
			OCRName = "Document_SBDSCurrencyConversion_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.TransferCashToAnotherAccount Then
			OCRName = "Document_SBDSTransferToAnotherAccount_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.SalaryPaymentByPayrollCardProgram Then
			OCRName = "Document_SBDSPayrollTransfer_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.SalaryPaymentToBankAccounts Then
			OCRName = "Document_SBDSTransferringPOToEmployee_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.TransferOfTaxesAndContributions Then
			OCRName = "Document_SBDSPaymentsToBudget_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CustomsPayment Then
			OCRName = "Document_SBDSSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
			OCRName = "Document_SBDSOtherWriteOff_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.OtherExpenses 
			Or BusinessTransaction = Enums.BusinessTransactions.OtherCashIssue
			Or BusinessTransaction = Enums.BusinessTransactions.CashIssueAsLoanToEmployee Then
			OCRName = "Document_SBDSOtherWriteOff_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.PaymentToVendor
			Or BusinessTransaction = Enums.BusinessTransactions.CashPaymentToAnotherCompany Then
			OCRName = "Document_SBDSSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.RefundToCustomer
			Or BusinessTransaction = Enums.BusinessTransactions.RefundToAnotherCompany Then
			OCRName = "Document_SBDSSettlementsWithCounterparties_Sending";
		ElsIf ThisIsBusinessOperationSettlementsOnLoansLoans(BusinessTransaction) Then
			OCRName = "Document_SBDSSettlementsWithCounterparties_Sending";
		ElsIf ThisIsBusinessOperationSettlementOfDeposits(BusinessTransaction) Then
			OCRName = "Document_SBDSOtherWriteOff_Sending";	
		ElsIf BusinessTransaction = Enums.BusinessTransactions.PaymentToLessor Then
			OCRName = "Document_SBDSSettlementsWithCounterparties_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.IssueCashToAdvanceHolder Then
			OCRName = "Document_SBDSSettlementsWithEmployees_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.WithdrawalFromBankAccount Then
			OCRName = "Document_SBDSCashWithdrawal_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.RefundAcquiringPayment
			And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
			OCRName = "Document_SBDSSettlementsWithCounterparties_Sending";
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.BankAccountReceiptNote") Then
		
		BusinessTransaction = Common.ObjectAttributeValue(Object, "BusinessOperation");
			
		If ThisIsBusinessOperationSettlementsOnLoansLoans(BusinessTransaction) Then
			OCRName = "Document_PBDSSettlementsWithCounterparties_Sending";
		ElsIf ThisIsBusinessOperationSettlementOfDeposits(BusinessTransaction) Then
			OCRName = "Document_PBDSOtherIncome_Sending";
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromCustomer
			Or BusinessTransaction = Enums.BusinessTransactions.RefundFromVendor
			Or BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromOtherCompany
			Or BusinessTransaction = Enums.BusinessTransactions.RefundFromAnotherCompany
			Or BusinessTransaction = Enums.BusinessTransactions.RefundFromLessor Then
			
			OCRName = "Document_PBDSSettlementsWithCounterparties_Sending";
			
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReturnByAdvanceHolder
			Or BusinessTransaction = Enums.BusinessTransactions.LoanRepaymentByEmployee Then
			
			OCRName = "Document_PBDSSettlementsWithEmployees_Sending";
			
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment Then
			
			If PropertyOfExchangeFormat(ExchangeComponents, "Документ.ПБДСПоПлатежнымКартам") Then //@NON-NLS-1
				OCRName = "Document_PBDSForPaymentCards_Sending";
			Else
				OCRName = "Document_PBDSSettlementsWithCounterparties_Sending";
			EndIf;
			
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CurrencyConversion Then
			
			AttributesValues = Common.ObjectAttributesValues(Object, "Currency, CurrencyOfConversion");
			
			CurrencyOfComplianceAccounting = LocalAccountingCurrency(Organization);
			
			If AttributesValues.CurrencyOfConversion = CurrencyOfComplianceAccounting
				Or AttributesValues.Currency = CurrencyOfComplianceAccounting Then
				OCRName = "Document_PBDSCurrencyConversion_Sending";
			ElsIf AttributesValues.Currency <> CurrencyOfComplianceAccounting
				And AttributesValues.CurrencyOfConversion <> CurrencyOfComplianceAccounting Then
				OCRName = "Document_PBDSSettlementsWithCounterparties_Sending";
			EndIf;
			
		ElsIf BusinessTransaction = Enums.BusinessTransactions.OtherIncome
			Or BusinessTransaction = Enums.BusinessTransactions.OtherCashReceipt Then
			
			OCRName = "Document_PBDSOtherIncome_Sending";
			
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromAnotherAccount
			Or BusinessTransaction = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
			
			OCRName = "Document_PBDSTransferToAnotherAccount_Sending";
			
		ElsIf BusinessTransaction = Enums.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount Then
			
			OCRName = "Document_PBDSPaymentInCash_Sending";
			
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.IntercompanyGoodsReturn") Then	
		
		IntercampanyOrganizations = Common.ObjectAttributesValues(Object, "Organization, CompanyRecipient");
		
		If IntercampanyOrganizations.Organization = Organization Then
			OCRName = "RefundBetweenOrganizations_ToSupplier_Sending";
		ElsIf IntercampanyOrganizations.CompanyRecipient = Organization Then
			OCRName = "RefundBetweenOrganizations_FromBuyer_Sending";
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.CustomerInvoiceIntercompany") Then
		
		IntercampanyOrganizations = Common.ObjectAttributesValues(Object, "Organization, CompanyRecipient");
		
		If IntercampanyOrganizations.Organization = Organization Then
			OCRName = "TransferBetweenCompanies_CI_Send";
		ElsIf IntercampanyOrganizations.CompanyRecipient = Organization Then
			OCRName = "TransferBetweenOrganizations_PTU_Sending";
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.CommissionWriteOffReportIntercompany") Then
		
		IntercampanyOrganizations = Common.ObjectAttributesValues(Object, "Organization, Consignee");
		
		If IntercampanyOrganizations.Organization = Organization Then
			OCRName = "Document_CommissionWriteOffCommitteeReport";
		ElsIf IntercampanyOrganizations.Consignee = Organization Then
			OCRName = "Document_CommissionWriteOffReportCommissionAgent";
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.CommissionReportIntercompany") Then
		
		IntercampanyOrganizations = Common.ObjectAttributesValues(Object, "Organization, Consignee");
		
		If IntercampanyOrganizations.Organization = Organization Then
			OCRName = "ReportCommissionBetweenOrganizations_CommissionAgent__";
		ElsIf IntercampanyOrganizations.Consignee = Organization Then
			OCRName = "ReportCommissionBetweenOrganizations_Commitee_Sending";
		EndIf;
		
	
	ElsIf RefType = Type("DocumentRef.CCDImport") Then
		
		OCRName = "Document_CustomsDeclaration_Shipment";
		
	ElsIf RefType = Type("DocumentRef.CashWithdrawalFromCashRegister") Then
		
		OCRName = "Document_WithdrawalOfCashFromCashRegister_Sending";
		
	ElsIf RefType = Type("DocumentRef.LoanAndDepositInterestCharge") Then
		
		OCRName = "Document_AccrualsOfLoansAndDeposits_Sending";
		
	ElsIf RefType = Type("DocumentRef.PaymentCardTransaction") Then
		
		OCRName = "Document_PaymentCardOperation_Sending";
		
	ElsIf RefType = Type("DocumentRef.InventorySurplusRecognition") Then
		
		OCRName = "Document_ProductRegistration_Shipment";
		
	ElsIf RefType = Type("DocumentRef.WriteOffOfGoodsShortages") Then
		
		OCRName = "Document_WriteOffOfShortageOfGoods_Sending";
		
	ElsIf RefType = Type("DocumentRef.GoodsMisgrading")
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
		
		OCRName = "Document_ResortmentOfGoods_Shipment";
		
	ElsIf RefType = Type("DocumentRef.AssemblyFromComponents") Then
		
		OCRName = "Document_AssemblyFromComponents";
		
	ElsIf RefType = Type("DocumentRef.BankReportOnAcquiringTransactions") Then
		
		OCRName = "Document_ReportOfBankOnAcquiringOperations__";
		
	ElsIf RefType = Type("DocumentRef.TransferOfGoodsToBailee") Then
		
		BusinessOperation = Common.ObjectAttributeValue(Object, "BusinessOperation");
		
		If BusinessOperation = Enums.BusinessTransactions.TransferToToller2_5 Then 
			OCRName = "Document_TransferToProcessor25_Sending";
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.GoodsShipmentFromStorage") Then
		
		AttributesValues = Common.ObjectAttributesValues(Object, "BusinessOperation, Goods");
		
		If AttributesValues.BusinessOperation = Enums.BusinessTransactions.ReturnToMaterialProvider2_5
			Or (AttributesValues.BusinessOperation = Enums.BusinessTransactions.ShipGoodsReceivedFromStorageWithRightOfSale 
			And Not AttributesValues.Goods.IsEmpty()) Then
			OCRName = "Document_GoodsShipmentFromStorage_Return_Send";
		ElsIf AttributesValues.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5 Then
			OCRName = "Doc_GoodsShipmentFromStorage_Transfer__Send";
		EndIf;
		
	ElsIf RefType = Type("DocumentRef.GoodsReceiptForStorage") Then
		
		OCRName = "Document_AcceptanceOfGoodsForStorage_Sending";
		
	ElsIf RefType = Type("DocumentRef.InventoryTransfer") Then
		
		Query = New Query;
		Query.Text =
		"SELECT
		|	InventoryTransfer.SourceWarehouse.ShopFloorStockroom AS SenderWorkshopStoreroom,
		|	InventoryTransfer.DestinationWarehouse.ShopFloorStockroom AS RecipientWorkshopStoreroom,
		|	InventoryTransfer.BusinessOperation AS BusinessOperation
		|FROM
		|	Document.InventoryTransfer AS InventoryTransfer
		|WHERE
		|	InventoryTransfer.Ref = &Ref";
		
		Query.SetParameter("Ref", Object);
		
		Selection = Query.Execute().Select();
		
		Selection.Next();
		
		If Selection.BusinessOperation <> Enums.BusinessTransactions.TransferOfGoodsBetweenBranchOffices Then
			
			OCRName = "Document_MovingGoods_Sending";
			If Selection.RecipientWorkshopStoreroom Then
				OCRName = "Document_MovementOfGoods_inProduction_Sending";
			ElsIf Selection.SenderWorkshopStoreroom Then
				OCRName = "Document_MovementOfGoods_ReturnFromProduction_Sending";
			EndIf;
			
		EndIf;
			
	ElsIf RefType = Type("DocumentRef.GoodsShipmentFromStorage") Then
		
		OCRName = "Document.ReturnOfRawMaterialsToMaterialProvider";
		
		
	EndIf;
	
	Return OCRName;
EndFunction
