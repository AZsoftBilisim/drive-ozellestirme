Function OrderCancelled(Ref)
	QueryText = 
		"SELECT
		|	Source.Products AS Products,
		|	Source.Characteristic AS Characteristic,
		|	Source.Package AS Package
		|FROM
		|	&Source AS Source
		|WHERE
		|	Source.Ref = &Ref
		|	AND Source.Canceled = FALSE";
	
	FullObjectName  = Ref.Metadata().FullName();
	
	QueryText = StrReplace(QueryText , "&Source", FullObjectName + ".Goods");
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", Ref);
	
	Return Query.Execute().Select().Count() = 0;
EndFunction


