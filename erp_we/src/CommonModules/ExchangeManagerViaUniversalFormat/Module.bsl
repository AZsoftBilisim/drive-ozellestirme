	ThisIsNettingOfTwoOrganizations = IBData.AdditionalProperties.Property("NettingInvolvingTwoOrganizations");
		
	If ThisIsNettingOfTwoOrganizations Then
		LinkOrganization = IBData.Organization;
		LinkDebtor     = IBData.CounterpartyDebtor;
		LinkLender    = IBData.CompanyCreditor;
		OperationKind       = "CarryingOutNetting";
	Else
		LinkOrganization = IBData.Creditor;
		LinkDebtor     = IBData.Organization;
		LinkLender    = IBData.CounterpartyDebtor;
		OperationKind       = "DebtTransfer_";
	EndIf;
	
	Prefix = "AC";
	If ExportStack.Count() > 1 Then
		XDTOData.Insert("Date", IBData.Date);
		XDTOData.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 8));
		XDTOData.Insert("Organization", LinkOrganization);
		Return;
	EndIf;
	
	XDTOData.Insert("OperationKind", OperationKind);
	
	XDTOData.KeyProperties.Insert("Date", IBData.Date);
	XDTOData.KeyProperties.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 8));
	XDTOData.KeyProperties.Insert("Organization", LinkOrganization);
	
	If ValueIsFilled(IBData.Comment) Then
		XDTOData.Insert("Comment", IBData.Comment);
	EndIf;
	 
	If ValueIsFilled(IBData.EmployeeResponsible) Then
		XDTOData.Insert("EmployeeResponsible", IBData.EmployeeResponsible);	
	EndIf; 
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	XDTOData.Insert("Currency", CurrencyOfComplianceAccounting);
	UnloadCourseAndMultiplicityOfDocument(XDTOData, CurrencyOfComplianceAccounting, IBData.Date, IBData.Organization);
	
	AmountOfAccountsReceivable  = IBData.AccountsReceivable.Total("SumCompl");
	AmountOfAccountsPayable = IBData.AccountsPayable.Total("SumCompl");
	XDTOData.Insert("AmountOfAccountsReceivable", AmountOfAccountsReceivable);
	XDTOData.Insert("AmountOfAccountsPayable", AmountOfAccountsPayable);
	
	UnloadDivision(IBData, XDTOData);
	
	If TypeOf(LinkDebtor) = Type("CatalogRef.Companies") Then
