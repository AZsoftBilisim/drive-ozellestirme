Procedure OCR_Document_WorkOutput_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	
	If XDTOData.Property("CompletedWorks")
		And ValueIsFilled(XDTOData.CompletedWorks) Then
		
		TableTypesOfWork = XDTOData.CompletedWorks.Copy(); // ValueTable
		TableTypesOfWork.Columns.Individual.Name = "Employee_";
		TableTypesOfWork.Columns.Count.Name = "AmountDueForPayment";
		
		UseProductionManagement21 = GetFunctionalOption("UseProductionManagement");
		If UseProductionManagement21 Then
		    ReceivedData.WorkOrderKind = Enums.TeamWorkOrderKinds.TeamWithoutOrder21;
					
			ReceivedData.AdditionalProperties.Insert("ActivityKinds", TableTypesOfWork);
		Else
			ReceivedData.WorkOrderKind = Enums.TeamWorkOrderKinds.TeamKind;
			
			TableEmployees = TableTypesOfWork.Copy();
			
			TableTypesOfWork.GroupBy("WorkKind, Rate_, Employee_", "AmountDueForPayment, Sum");
			TableEmployees.GroupBy("Employee_", "Sum");
					
			ReceivedData.AdditionalProperties.Insert("ActivityKinds", TableTypesOfWork);
			ReceivedData.AdditionalProperties.Insert("Employees", TableEmployees);
		EndIf;
	EndIf;
EndProcedure
