Procedure OCR_Document_ReturnFromCommissionAgent_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RefundFromCommissionAgent_Shipment", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RefundFromCommissionAgent_Shipment", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	CalculationsInConventionalUnits = False;
	ARAPCurrency     = IBData.Currency;
	
	If Not (IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ReturnFromRetailCustomer) Then
		
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
			ARAPCurrency	 = UECalculationData.ARAPCurrency;		 
		EndIf;
		
	EndIf;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = ARAPCurrency;
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
	
		DefaultParameters.TypeOfAgreement = "WithConsignee";
		
		SalesOrder = Undefined;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", SalesOrder, IBData.Terms, IBData.SalesOpportunity);
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	QueryText = "SELECT
			|	Goods.Products AS Products,
			|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
			|	Goods.RowID AS RowID,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	Goods.Count AS Count,
			|	&VATRate AS VATRate,
			|	Goods.Price AS Price,
			|	Goods.Sum AS Sum,
			|	CASE
			|		WHEN Goods.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|				AND Goods.Ref.ReusablePackageReturn
			|			THEN ""ReturnContainers""
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType
			|FROM
			|	Document.ReceiptOfGoodsFromCustodian.Goods AS Goods,
			|	#TablesVATRate
			|WHERE
			|	Goods.Ref = &Ref
			|";
		
	FillInYourOwnProductsInText(QueryText);
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17"); 
	FillInBidOfNDSInText(QueryText, "Goods.Products", FormatVersionIs17AndHigher);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "Goods"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("RegistrationCountry", SettingsValueClientServerCached.CountryOfOrganizationRegistration(IBData.Organization));
	Query.SetParameter("Period", IBData.Date);
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "ReturnUnderOperation");
		
	XDTOData.Insert("Goods", Goods);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

