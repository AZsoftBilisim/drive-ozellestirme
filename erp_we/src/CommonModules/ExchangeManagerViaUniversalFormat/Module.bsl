	// We transfer those properties that are specified in the PKS
	FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
	// Goods
	KeyFieldsArray = New Array;
	KeyFieldsArray.Add("Products");
	KeyFieldsArray.Add("Characteristic");
	KeyFieldsArray.Add("VATRate");
	
	ExclusionColumnsAreExtra = "";
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		ExclusionColumnsAreExtra = ", QuantityByGBRN, CCDNumber";
	EndIf;
	
	DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
		ReceivedData.Goods,
		IBData.Goods,
		KeyFieldsArray,
		Undefined,
		"Count, Package, NumberOfPackages, Price, Sum, AmountSalesVAT, SalesAmount, CommissionAmount, AmountVATRemuneration, SellingPrice"
		+ ", DateOfTaxInvoiceIssuedByCommissionAgent, CommissionAgentSTaxInvoiceNumber, Customer" + ExclusionColumnsAreExtra);
	IBData.Goods.Load(ReceivedData.Goods.Unload());
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
	ReceivedData = Undefined;
EndProcedure

