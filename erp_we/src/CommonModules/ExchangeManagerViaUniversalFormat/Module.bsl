Procedure DPR_Document_InventoryTransfer_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	
	SenderWorkshopPantry = Common.ObjectAttributeValue(IBData.SourceWarehouse, "ShopFloorStockroom");
	RecipientWorkshopPantry = Common.ObjectAttributeValue(IBData.DestinationWarehouse, "ShopFloorStockroom");
	
	If IBData.InventoryKinds.Count() = 0
		Or SenderWorkshopPantry And RecipientWorkshopPantry Then
		Return;
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfGoodsBetweenBranchOffices Then
		
		QueryText = 
			"SELECT
			|	InventoryKinds.LineNumber 												AS LineNumber,
			|	InventoryKinds.ItemsLocationAttributes.Products 					AS Products,
			|	InventoryKinds.ItemsLocationAttributes.Characteristic 					AS Characteristic,
			|	InventoryKinds.ItemsLocationAttributes.Series                            AS Series,
			|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure 	AS UnitOfMeasure,
			|	InventoryKinds.Count 													AS Count,
			|	InventoryKinds.CCDNumber                                                    AS CCDNumber,
			|	InventoryKinds.QuantityByGBRN                                            AS QuantityByGBRN,
			|	ENDOFPERIOD(InventoryKinds.Ref.Date, DAY) 							AS DateOfPriceReceipt,
			|	InventoryKinds.Ref.PriceKind 												AS PriceKind,
			|	InventoryKinds.Ref.PriceKind.PriceCurrency 									AS PriceCurrency,
			|	CASE
			|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|			THEN ""ReturnContainers""
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END 																	AS InventoryType,
			|	CASE
			|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|			THEN ""ReturnContainers""
			|		WHEN InventoryKinds.RecipientInventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END 																	AS RecipientInventoryType
			|INTO Goods
			|FROM
			|	Document.InventoryTransfer.InventoryKinds AS InventoryKinds
			|WHERE
			|	InventoryKinds.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	ProductPricePeriods.LineNumber,
			|	ItemsPrices.Price
			|INTO Prices
			|FROM
			|	(SELECT
			|		Goods.LineNumber,
			|		ItemsPrices.PriceKind AS PriceKind,
			|		ItemsPrices.Products AS Products,
			|		ItemsPrices.Characteristic AS Characteristic,
			|		MAX(ItemsPrices.Period) AS Period
			|	FROM
			|		Goods AS Goods
			|			INNER JOIN InformationRegister.ItemsPrices AS ItemsPrices
			|			ON Goods.PriceKind = ItemsPrices.PriceKind
			|				AND Goods.Products = ItemsPrices.Products
			|				AND Goods.Characteristic = ItemsPrices.Characteristic
			|				AND Goods.DateOfPriceReceipt >= ItemsPrices.Period
			|				AND Goods.PriceCurrency = ItemsPrices.Currency
			|	
			|	GROUP BY
			|		Goods.LineNumber,
			|		ItemsPrices.PriceKind,
			|		ItemsPrices.Products,
			|		ItemsPrices.Characteristic) AS ProductPricePeriods
			|		INNER JOIN InformationRegister.ItemsPrices AS ItemsPrices
			|		ON ProductPricePeriods.Period = ItemsPrices.Period
			|			AND ProductPricePeriods.PriceKind = ItemsPrices.PriceKind
			|			AND ProductPricePeriods.Products = ItemsPrices.Products
			|			AND ProductPricePeriods.Characteristic = ItemsPrices.Characteristic
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	ExchangeRates.Currency,
			|	ExchangeRates.CourseNumerator AS Rate,
			|	ExchangeRates.CourseDenominator AS Repetition
			|INTO ExchangeRates
			|FROM
			|	(SELECT
			|		MAX(ExchangeRates.Period) AS Period,
			|		ExchangeRates.Currency AS Currency,
			|		ExchangeRates.BaseCurrency AS BaseCurrency
			|	FROM
			|		Document.InventoryTransfer AS DocumentsMovementOfGoods
			|			INNER JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
			|			ON DocumentsMovementOfGoods.PriceKind.PriceCurrency = ExchangeRates.Currency
			|				AND DocumentsMovementOfGoods.Organization.LocalAccountingCurrency = ExchangeRates.BaseCurrency
			|				AND DocumentsMovementOfGoods.Date >= ExchangeRates.Period
			|	WHERE
			|		DocumentsMovementOfGoods.Ref = &Ref
			|	
			|	GROUP BY
			|		ExchangeRates.Currency,
			|		ExchangeRates.BaseCurrency) AS PeriodsOfExchangeRatesAccordingToDocuments
			|		INNER JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
			|		ON PeriodsOfExchangeRatesAccordingToDocuments.Period = ExchangeRates.Period
			|			AND PeriodsOfExchangeRatesAccordingToDocuments.Currency = ExchangeRates.Currency
			|			AND PeriodsOfExchangeRatesAccordingToDocuments.BaseCurrency = ExchangeRates.BaseCurrency
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.Products 		AS Products,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	Goods.UnitOfMeasure 	AS UnitOfMeasure,
			|	Goods.Count 			AS Count,
			|	Goods.InventoryType 			AS InventoryType,
			|	Goods.RecipientInventoryType AS RecipientInventoryType,
			|	CAST(CAST(ISNULL(Prices.Price, 0)* ISNULL(ExchangeRates.Rate, 1) / ISNULL(ExchangeRates.Repetition, 1) AS NUMBER(31, 2)) * Goods.Count AS NUMBER(31, 2)) AS Sum,
			|	Goods.LineNumber AS DocumentRowNumber
			|FROM
			|	Goods AS Goods
			|		LEFT JOIN ExchangeRates AS ExchangeRates
			|		ON TRUE
			|		LEFT JOIN Prices AS Prices
			|		ON Goods.LineNumber = Prices.LineNumber
			|
			|ORDER BY
			|	Goods.LineNumber";
		
		FillInYourOwnProductsInText(QueryText);
			
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
			
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "Goods"));
		
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "Goods"));
				
		UsageOCR.Document_InternalMovement_MpzReceiptInput_Sending  = True;
		UsageOCR.Document_InternalTransfer_MpzReceiptExodus_Sending = True;
		
	Else
		QueryText =
			"SELECT
			|	NestedQuery.Products AS Products,
			|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	NestedQuery.Count AS Count,
			|	NestedQuery.InventoryType AS InventoryType,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest
			|FROM
			|	(SELECT
			|		InventoryTransferInventoryKinds.ItemsLocationAttributes.Products AS Products,
			|		InventoryTransferInventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
			|		InventoryTransferInventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
			|		InventoryTransferInventoryKinds.ItemsLocationAttributes.Series AS Series,
			|		InventoryTransferInventoryKinds.Count AS Count,
			|		CASE
			|			WHEN InventoryTransferInventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|				THEN CAST(""CommissionGoods"" AS STRING(20))
			|			WHEN InventoryTransferInventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
			|				THEN ""GiverRawMaterialsAndSupplies""
			|			ELSE CAST(&OwnProducts AS STRING(20))
			|		END AS InventoryType,
			|		InventoryTransferInventoryKinds.CCDNumber AS CCDNumber,
			|		InventoryTransferInventoryKinds.QuantityByGBRN AS QuantityByGBRN
			|	FROM
			|		Document.InventoryTransfer.InventoryKinds AS InventoryTransferInventoryKinds
			|	WHERE
			|		InventoryTransferInventoryKinds.Ref = &Ref) AS NestedQuery";
		
		FillInYourOwnProductsInText(QueryText);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "NestedQuery"));
	
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "NestedQuery"));
			
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "NestedQuery"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "NestedQuery"));
			
		If RecipientWorkshopPantry Then
			UsageOCR.Document_MovementOfGoods_inProduction_Sending = True;
		ElsIf SenderWorkshopPantry Then
			UsageOCR.Document_MovementOfGoods_ReturnFromProduction_Sending = True;
		Else
			UsageOCR.Document_MovingGoods_Sending = True;
		EndIf;
	
	EndIf;
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	
	Goods = Query.Execute().Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	
	IBData.AdditionalProperties.Insert("Goods", Goods);
EndProcedure

