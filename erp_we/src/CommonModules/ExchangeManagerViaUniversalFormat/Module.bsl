Procedure ContractsOfCounterpartiesBeforeRecordingReceivedData(ReceivedData, IBData, ExchangeComponents)
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If Not ValueIsFilled(DataToWriteToIB.Status) Then
		DataToWriteToIB.Status = Enums.CounterpartyContractStatuses.Valid;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.ARAPObjectSettings) Then
		DataToWriteToIB.ARAPObjectSettings = Enums.ARAPObjectSettings.ByCounterpartyContracts;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.GoodsReceiptOption) Then
		DataToWriteToIB.GoodsReceiptOption = Constants.GoodsReceiptOption.Get();
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.PurchaseRegistrationOption) Then
		DataToWriteToIB.PurchaseRegistrationOption = Enums.PurchaseRegistrationOptions.NotSeparate;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.BusinessOperation) Then
		DataToWriteToIB.BusinessOperation = Catalogs.CounterpartyContracts.BusinessOperation(
			DataToWriteToIB.ContractType,
			DataToWriteToIB.PurchaseRegistrationOption);
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.VATTaxation)
		And Not DataToWriteToIB.VATTaxationIsDeterminedInDocuments Then
		DataToWriteToIB.VATTaxationIsDeterminedInDocuments = True;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.PurchaseForActivity)
		And Not DataToWriteToIB.PurchaseForActivityIsDeterminedInDocument Then
		DataToWriteToIB.PurchaseForActivityIsDeterminedInDocument = True;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.DeliveryMethod) Then
		DataToWriteToIB.DeliveryMethod = Enums.TransportMethods.DeterminedInReference;				
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.ContractRateOption) Then
		DataToWriteToIB.ContractRateOption = Enums.ContractRateOptions.Mutable;
	EndIf;
	If Not ValueIsFilled(DataToWriteToIB.ProcedureToRecordUninvoicedDeliveriesTA) Then
		DataToWriteToIB.ProcedureToRecordUninvoicedDeliveriesTA = Enums.OptionsToRecordUninvoicedDeliveriesTA.RecordOnReceipt;
	EndIf;
	If ReceivedData.ContractType = Enums.ContractTypes.WithConsignee
		And ExchangeComponents.ConversionParameters_SSLy.OnlyConsignmentSales25 Then
		DataToWriteToIB.ConsignmentSales25 = True;
	EndIf;
	
	If IBData = Undefined Then
		ReceivedData.InitializeCatalog(, False);
	EndIf;
EndProcedure
