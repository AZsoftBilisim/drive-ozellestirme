		XDTOData.Insert("Creditor", LinkLender);
	EndIf;
	
	AccountsReceivable = UnloadDebtTable(
		?(ThisIsNettingOfTwoOrganizations, "AccountsReceivable", "AccountsPayable"),
		IBData.Ref,
		XDTOData.CounterpartyDebtor,
		LinkOrganization,
		?(ThisIsNettingOfTwoOrganizations, Undefined, LinkDebtor),
		ExchangeComponents);
	XDTOData.Insert("AccountsReceivable", AccountsReceivable);
	
	DefaultParameters = New Structure(ContractFixedKeyStructure());
	DefaultParameters.Organization              = LinkOrganization;
	DefaultParameters.ARAPCurrency     = CurrencyOfComplianceAccounting;
	DefaultParameters.CalculationsInConventionalUnits = False;
	DefaultParameters.TypeOfAgreement              = "Other"; 
	DefaultParameters.Counterparty               = XDTOData.Creditor;
	
	If ThisIsNettingOfTwoOrganizations Then
		DefaultParameters.TypeOfAgreement = TypeOfContractForIntercampanySettlementObject(LinkOrganization,
			IBData.ARAPObjectIntercompany, "WithVendor");
	EndIf;
	
	AccountsPayable = New ValueTable;
	AccountsPayable.Columns.Add("Contract");
	AccountsPayable.Columns.Add("Multiplier_");
	AccountsPayable.Columns.Add("TransactionRate");
	AccountsPayable.Columns.Add("Sum");
	AccountsPayable.Columns.Add("AmountARAP");
	AccountsPayable.Columns.Add("ARAPType");
	
	AccountsPayableLine = AccountsPayable.Add();
	AccountsPayableLine.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents);
	AccountsPayableLine.Multiplier_ = 1;
	AccountsPayableLine.TransactionRate = 1;
	AccountsPayableLine.Sum = AmountOfAccountsPayable;
	AccountsPayableLine.AmountARAP = AmountOfAccountsPayable;
	If IBData.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient Then
		AccountsPayableLine.ARAPType = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
	Else
		AccountsPayableLine.ARAPType = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting;
	EndIf;
	
	XDTOData.Insert("AccountsPayable", AccountsPayable);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

