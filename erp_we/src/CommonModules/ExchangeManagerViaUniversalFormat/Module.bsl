Procedure PrepareDataContactInformation(IBData, XDTOData, ExchangeComponents)
	If IBData.ContactInformation.Count() = 0 Then
		Return;
	EndIf;
	
	TabContactInformation = New ValueTable;
	
	TabContactInformation.Columns.Add("FieldValues");
	TabContactInformation.Columns.Add("ContactInformationKind");
	TabContactInformation.Columns.Add("NameOfContactInformation"); 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21") Then
	   TabContactInformation.Columns.Add("Value");
	EndIf;   
	   
	For Each CIRow In IBData.ContactInformation Do
		If Not ValueIsFilled(CIRow.Kind)
			Or (Not ValueIsFilled(CIRow.FieldValues) And Not ValueIsFilled(CIRow.Presentation)) Then
			Continue;
		EndIf;
		
		PropertiesOfCIType = Common.ObjectAttributesValues(CIRow.Kind, "Description, Predefined, StoreChangeHistory");
		If PropertiesOfCIType.StoreChangeHistory = True Then
			FoundRows = IBData.ContactInformation.FindRows(New Structure("Kind", CIRow.Kind));
			If FoundRows.Count() > 1 Then
				LatestVersion = True;
				For Each FoundRow In FoundRows Do
					If FoundRow <> CIRow And FoundRow.ValidFrom > CIRow.ValidFrom Then
						LatestVersion = False;
						Break;
					EndIf;
				EndDo;
				If Not LatestVersion Then
					Continue;
				EndIf;
			EndIf;
		EndIf;
		
		If Left(TrimL(CIRow.FieldValues),1) = "<" Then
			// The CI is in the correct format.
			FieldValues = TrimAll(CIRow.FieldValues);
		Else
			FieldValues = "";
			// Attempt No. 1.
			If ValueIsFilled(TrimAll(CIRow.FieldValues)) Then 
				FieldValues = ContactsManager.ContactInformationToXML(TrimAll(CIRow.FieldValues), TrimAll(CIRow.Presentation), CIRow.Kind);
			EndIf;
			If Left(TrimL(FieldValues),1) <> "<" Then
				// Attempt #2.
				FieldValues = ContactsManager.ContactsByPresentation(TrimAll(CIRow.Presentation), CIRow.Kind);
			EndIf;
		EndIf;
		
		If Not ValueIsFilled(FieldValues) Then
			Continue;
		EndIf;
		
		TkkiString = TabContactInformation.Add();
		TkkiString.FieldValues = FieldValues; 
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21") 
			And ContactsManagerClientServer.IsJSONContactInformation(CIRow.Value) Then
			
			TkkiString.Value = TrimAll(CIRow.Value);
			
		EndIf;
		
		// Let's check the possibility of converting the value using the control panel.
		KiLineView = Undefined;
		PredefinedDataConversionRules = ExchangeComponents.PredefinedDataConversionRules;
		ConversionRule = PredefinedDataConversionRules.Find("TypesOfWhales", "PDCRName");
		If Not ConversionRule = Undefined Then
			ConvertValuesOnSend = ConversionRule.ConvertValuesOnSend; // Map
			KiLineView = ConvertValuesOnSend.Get(CIRow.Kind);
		EndIf;
		If Not ValueIsFilled(KiLineView) Then
			// Getting the name of the enumeration value.
			KiTypeIndex = Enums.ContactInformationTypes.IndexOf(CIRow.Type);
			KiTypeName = Metadata.Enums.ContactInformationTypes.EnumValues[KiTypeIndex].Name;
			
			KiLineView = "UserCI"+KiTypeName;
		EndIf;
		
		TkkiString.NameOfContactInformation = PropertiesOfCIType.Description;
		TkkiString.ContactInformationKind = KiLineView;
		
	EndDo;
	
	XDTOData.Insert("ContactInformation", TabContactInformation);
EndProcedure
