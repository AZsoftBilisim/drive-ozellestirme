Procedure DeferredProcessing_BankAccounts(Object, ExchangeComponents, ObjectIsModified)
	If Not ValueIsFilled(Object.Bank) Then
	
		TheStructureOfTheSearch = New Structure();
		
		MatchingKeyFields = New Map;
		MatchingKeyFields.Insert("BankBIC",          "BIC");
		MatchingKeyFields.Insert("BankSWIFTCode",        "SWIFTBIC");
		MatchingKeyFields.Insert("BankDescription", "Description");
		MatchingKeyFields.Insert("BankCorrAccount",     "CorrAccount");
		
		MatchingOtherFields = New Map;
		MatchingOtherFields.Insert("BankCity",              "City");
		MatchingOtherFields.Insert("BankAddressInt", "Address");
		MatchingOtherFields.Insert("ForeignBank",         "ForeignBank");
		MatchingOtherFields.Insert("BankPhones",           "Phones");
		MatchingOtherFields.Insert("CountryOfBank",             "Country");
		
		For Each Map In MatchingKeyFields Do
			If ValueIsFilled(Object[Map.Key]) Then
				TheStructureOfTheSearch.Insert(Map.Value, Object[Map.Key]);
			EndIf;
		EndDo;	
			
		If ValueIsFilled(TheStructureOfTheSearch) Then
		    Object.ManualBankDetailsChange = True;
			
			TableBanks = ExchangeComponents.ConversionParameters_SSLy.TableBanks;
			RowsArray = TableBanks.FindRows(TheStructureOfTheSearch);
			If RowsArray.Count() = 1 Then
				LineBank = RowsArray[0];
				
				If LineBank.ForeignBank = True Then
					MatchingOtherFields.Insert("BankNameInt", "Description");
					MatchingOtherFields.Insert("BankAccountForPayments",          "CorrAccount");
					MatchingOtherFields.Insert("BankCityInt",        "City");
				EndIf;
			
				For Each Map In MatchingOtherFields Do
					If ValueIsFilled(LineBank[Map.Value]) Then
					    Object[Map.Key] = LineBank[Map.Value];
					EndIf;
				EndDo;
			EndIf;
		EndIf;
		
			
	EndIf;
	
	If Not ValueIsFilled(Object.TransferBank) Then
	
		TheStructureOfTheSearch = New Structure();
		
		MatchingKeyFields = New Map;
		MatchingKeyFields.Insert("TransferBankBIC",          "BIC");
		MatchingKeyFields.Insert("BankSWIFTCodeForPayments",        "SWIFTBIC");
		MatchingKeyFields.Insert("TransferBankDescription", "Description");
		MatchingKeyFields.Insert("TransferBankCorrAccount",     "CorrAccount");
		
		MatchingOtherFields = New Map;
		MatchingOtherFields.Insert("TransferBankCity",              "City");
		MatchingOtherFields.Insert("BankAddressForPaymentInt", "Address");
		MatchingOtherFields.Insert("TransferBankPhones",           "Phones");
		MatchingOtherFields.Insert("CountryOfBankForPayments",             "Country");
		
		For Each Map In MatchingKeyFields Do
			If ValueIsFilled(Object[Map.Key]) Then
				TheStructureOfTheSearch.Insert(Map.Value, Object[Map.Key]);
			EndIf;
		EndDo;	
			
		If ValueIsFilled(TheStructureOfTheSearch) Then
		    Object.TransferBankDetailsManualEdit = True;
			
			TableBanks = ExchangeComponents.ConversionParameters_SSLy.TableBanks;
			RowsArray = TableBanks.FindRows(TheStructureOfTheSearch);
			If RowsArray.Count() = 1 Then
				LineBank = RowsArray[0];
				
				If Not Object.CashCurrency = LocalAccountingCurrency(ExchangeComponents) Then
					MatchingOtherFields.Insert("BankNameForPaymentsInt", "Description");
					MatchingOtherFields.Insert("BankCityForPaymentsInt",        "City");
				EndIf;
			
				For Each Map In MatchingOtherFields Do
					If ValueIsFilled(LineBank[Map.Value]) Then
					    Object[Map.Key] = LineBank[Map.Value];
					EndIf;
				EndDo;
			EndIf;
		EndIf;
	EndIf;
