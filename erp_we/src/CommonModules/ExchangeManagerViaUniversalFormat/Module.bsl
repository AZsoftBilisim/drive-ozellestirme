Procedure DPR_Document_InventoryConsumption_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.GoodsConsumptionOnDemand Then
		QueryText = 
			"SELECT
			|	Dimension.Products AS Products,
			|	VACProducts.Characteristic AS Characteristic,
			|	VACProducts.Series AS Series,
			|	VACProducts.Package AS Package,
			|	SUM(VACProducts.NumberOfPackages) AS NumberOfPackages,
			|	Dimension.Products.UnitOfMeasure AS UnitOfMeasure,
			|	SUM(VACTypesOfStocks.Count) AS Count,
			|	SUM(VACTypesOfStocks.QuantityByGBRN) AS QuantityByGBRN,
			|	VACTypesOfStocks.CCDNumber AS CCDNumber,
			|	VACTypesOfStocks.ExpenseItem AS ExpenseItem,
			|	VPT_Cap.Department AS Department,
			|	CASE
			|		WHEN VACTypesOfStocks.ProductsGroup = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
			|			THEN ISNULL(Dimension.Products.AnalyticalGroup, VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef))
			|		ELSE VACTypesOfStocks.ProductsGroup
			|	END AS AnalyticalProductGroup,
			|	CASE
			|		WHEN VACTypesOfStocks.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType
			|INTO ProductsAll
			|FROM
			|	Document.InventoryConsumption AS VPT_Cap
			|		INNER JOIN Document.InventoryConsumption.InventoryKinds AS VACTypesOfStocks
			|		ON (VACTypesOfStocks.Ref = VPT_Cap.Ref)
			|		INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
			|		ON (VACTypesOfStocks.ItemsLocationAttributes = Dimension.DimensionKey)
			|		LEFT JOIN Document.InventoryConsumption.Goods AS VACProducts
			|		ON (VACProducts.Ref = VPT_Cap.Ref)
			|			AND (VACProducts.RowID = VACTypesOfStocks.RowID)
			|WHERE
			|	VPT_Cap.Ref = &Ref
			|
			|GROUP BY
			|	Dimension.Products,
			|	Dimension.Products.UnitOfMeasure,
			|	VACTypesOfStocks.CCDNumber,
			|	VACTypesOfStocks.ExpenseItem,
			|	VPT_Cap.Department,
			|	CASE
			|		WHEN VACTypesOfStocks.ProductsGroup = VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
			|			THEN ISNULL(Dimension.Products.AnalyticalGroup, VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef))
			|		ELSE VACTypesOfStocks.ProductsGroup
			|	END,
			|	CASE
			|		WHEN VACTypesOfStocks.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END,
			|	VACProducts.Characteristic,
			|	VACProducts.Package,
			|	VACProducts.Series
			|
			|INDEX BY
			|	InventoryType
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.Products AS Products,
			|	Goods.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextPackage,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	Goods.Count AS Count,
			|	CAST("""" AS STRING(7)) AS CostAccount,
			|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CostItem,
			|	Goods.ExpenseItem AS ExpenseItem,
			|	Goods.Department AS Department,
			|	Goods.AnalyticalProductGroup AS AnalyticalProductGroup,
			|	Goods.InventoryType AS InventoryType
			|FROM
			|	ProductsAll AS Goods
			|WHERE
			|	Goods.InventoryType = &OwnProducts
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.Products AS Products,
			|	Goods.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextPackage,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	Goods.Count AS Count,
			|	Goods.InventoryType AS InventoryType
			|FROM
			|	ProductsAll AS Goods
			|WHERE
			|	Goods.InventoryType = ""CommissionGoods""";
			
		FillInYourOwnProductsInText(QueryText);
			
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
			
		QueryText = StrReplace(QueryText, "&QueryTextPackage",
			GetPackagingRequestText(ExchangeComponents, "Goods"));
			
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "Goods"));
	
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "Goods"));
			
		Query = New Query(QueryText);
		Query.SetParameter("Ref", IBData.Ref);
		Query.SetParameter("ThisIsUT", ThisIsUT());
		QueryResult = Query.ExecuteBatch();
		
		OwnProducts = QueryResult[1].Unload();
		OwnProducts.Columns.Add("CostDivision");
		FillInCharacteristicsOfWHPackage(ExchangeComponents, OwnProducts);
		
		CommissionGoods = QueryResult[2].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, CommissionGoods);
		
		For Each OwnProductsLine In OwnProducts Do
			If ValueIsFilled(OwnProductsLine.Department) Then
				StructureDivision = New Structure;
				UnloadDivision(IBData, StructureDivision, OwnProductsLine.Department);
				OwnProductsLine.CostDivision = StructureDivision.Department;
			EndIf;
		
			If ValueIsFilled(OwnProductsLine.AnalyticalProductGroup)
				And PropertyOfExchangeFormat(ExchangeComponents, "Справочник.ГруппыАналитическогоУчетаНоменклатуры") Then //@NON-NLS-1
				StructureOfAnalytics = New Structure;
				StructureOfAnalytics.Insert("Value", OwnProductsLine.AnalyticalProductGroup);
				StructureOfAnalytics.Insert("OCRName", ?(OwnProductsLine.AnalyticalProductGroup.IsFolder,
					"Cat_AnalyticalAccountingGroupsProductsGroup", "Cat_AnalyticalInventoryGroups"));
				OwnProductsLine.AnalyticalProductGroup = StructureOfAnalytics;
			EndIf;
			
			OwnProductsAccountingAccount = Undefined;
			OwnProductsLine.CostAccount = AccountingInvoiceForArticle(OwnProductsLine.ExpenseItem,
				IBData.Organization, IBData.Department, IBData.Date);
		EndDo;
		
		If OwnProducts.Count() > 0 Then
			IBData.AdditionalProperties.Insert("OwnProducts", OwnProducts);
			UsageOCR.Document_DomesticConsumption_inProduction_Otpr = True;
		EndIf;
		
		If CommissionGoods.Count() > 0 Then    
			IBData.AdditionalProperties.Insert("CommissionGoods", CommissionGoods);
			UsageOCR.Document_InternalConsumption_BWriteOffStock_OTR = True;
		EndIf;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferToOperation Then
		UsageOCR.Document_InternalConsumption_inOperation_Otpra = True;
	EndIf;
EndProcedure


