	EndIf;
	
	ObjectReference = IBData.Filter.ObjectReference.Value;
	If TypeOf(ObjectReference) = Type("DocumentRef.SaleAdjustment") 
		Or (CommonClientServer.HasAttributeOrObjectProperty(ObjectReference, "BusinessOperation") And 
		ObjectReference.BusinessOperation  = PredefinedValue("Enum.BusinessTransactions.PurchaseViaAdvanceHolder")) Then  
		ClearUsageOCR(UsageOCR);
