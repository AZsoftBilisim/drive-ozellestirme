Procedure PCO_Document_SaleOfGoodsAndServicesFee_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	XDTOData.Insert("ChiefAccountant", Common.ObjectAttributeValue(IBData.ChiefAccountant, "Individual"));
	XDTOData.Insert("Director",     Common.ObjectAttributeValue(IBData.Director, "Individual"));
	
	UnloadDivision(IBData, XDTOData); 
	//Unload the taxable deposits(Exchange components, dataib, DATAXDTO, False);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	CurrencyOfComplianceAccounting = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	
	// These document caps are necessary for calculating
	// the exchange rate and multiplicity of settlements and the buyers' table
	DocumentHeader =
		"SELECT
		|	DocumentHeaderData.Currency AS Currency,
		|	DocumentHeaderData.ARAPCurrency AS ARAPCurrency,
		|	DocumentHeaderData.CourseNumerator AS TransactionRate,
		|	DocumentHeaderData.CourseDenominator AS Multiplier_,
		|	DocumentHeaderData.Ref AS Ref,
		|	DocumentHeaderData.CustomerCounterparty AS Customer,
		|	DocumentHeaderData.CustomerContract AS ContractOfBuyerOfCommissionGoods
		|INTO DocumentHeaderData
		|FROM
		|	Document.CustomerInvoice AS DocumentHeaderData
		|WHERE
		|	DocumentHeaderData.Ref = &Ref
		|
		|INDEX BY
		|	Currency,
		|	Ref";
		
	If IBData.Currency = CurrencyOfComplianceAccounting
		Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
		
		OperationData =
			"SELECT
			|	DocumentHeaderData.TransactionRate AS TransactionRate,
			|	DocumentHeaderData.Multiplier_ AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData";
		
	Else
		
		OperationData =
			"SELECT
			|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
			|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
			|				&Date,
			|				Currency IN
			|					(SELECT
			|						Doc.Currency
			|					FROM
			|						DocumentHeaderData AS Doc)
			|				AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
			|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency";
		
	EndIf;
	
	Buyers = 
		"SELECT
		|	MAX(CASE
		|			WHEN InvoiceIssued.Ref IS NULL
		|				THEN FALSE
		|			ELSE TRUE
		|		END) AS SetSF,
		|	ISNULL(InvoiceIssued.Ref.DATE, """") AS InvoiceDate,
		|	1 AS RowKey,
		|	ISNULL(InvoiceIssued.Ref.Number, """") AS InvoiceNumber,
		|	DocumentHeaderData.Customer AS Customer,
		|	ISNULL(InvoiceIssued.Ref, UNDEFINED) AS TaxInvoice,
		|	DocumentHeaderData.ContractOfBuyerOfCommissionGoods AS ContractOfBuyerOfCommissionGoods
		|FROM
		|	DocumentHeaderData AS DocumentHeaderData
		|		LEFT JOIN Document.InvoiceIssued.BasisDocuments AS InvoiceIssued
		|		ON DocumentHeaderData.Ref = InvoiceIssued.DocumentBasis
		|
		|GROUP BY
		|	DocumentHeaderData.Customer,
		|	DocumentHeaderData.ContractOfBuyerOfCommissionGoods,
		|	ISNULL(InvoiceIssued.Ref.DATE, """"),
		|	ISNULL(InvoiceIssued.Ref.Number, """"),
		|	ISNULL(InvoiceIssued.Ref, UNDEFINED)";
	
	GoodsAndServicesOfDocument =
		"SELECT
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	CASE
		|		WHEN Goods.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|			THEN CASE
		|					WHEN CharacteristicsOfCat.DescriptionFull = """"
		|						THEN CharacteristicsOfCat.Description
		|					ELSE CharacteristicsOfCat.DescriptionFull
		|				END
		|		ELSE """"
		|	END AS CharacteristicName,
		|	CASE
		|		WHEN CatProducts_.DescriptionFull = """"
		|			THEN CatProducts_.Description
		|		ELSE CatProducts_.DescriptionFull
		|	END AS NomenclatureName,
		|	Goods.Count AS Count,
		|	Goods.Price AS Price,
		|	Goods.Sum AS Sum,
		|	Goods.VATRate AS VATRate,
		|	Goods.VATAmount AS VATAmount,
		|	Goods.Products.ItemsType AS ProductsTypeOfProducts,
		|	Goods.LineNumber AS LineNumber,
		|	Goods.RowID AS RowID,
		|	Goods.Series AS Series
		|INTO GoodsTable
		|FROM
		|	Document.CustomerInvoice.Goods AS Goods
		|		LEFT JOIN Catalog.Products AS CatProducts_
		|		ON (CatProducts_.Ref = Goods.Products)
		|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicsOfCat
		|		ON (CharacteristicsOfCat.Ref = Goods.Characteristic)
		|WHERE
		|	Goods.Ref = &Ref
		|
		|INDEX BY
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
		|	InventoryKinds.Package AS Package,
		|	InventoryKinds.NumberOfPackages AS NumberOfPackages,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.CCDNumber AS CCDNumber,
		|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
		|	InventoryKinds.Ref.ToReturnReusablePackage AS ToReturnReusablePackage,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|		END AS NUMBER(31, 2)) AS Price,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	InventoryKinds.RowID AS RowID,
		|	1 AS RowKey
		|INTO InventoryKinds
		|FROM
		|	Document.CustomerInvoice.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.Products AS Products,
		|	GoodsTable.Characteristic AS Characteristic,
		|	CASE
		|		WHEN GoodsTable.CharacteristicName = """"
		|			THEN GoodsTable.NomenclatureName
		|		ELSE GoodsTable.NomenclatureName + "" ("" + GoodsTable.CharacteristicName + "")""
		|	END AS Content,
		|	GoodsTable.Products.Principal AS PrincipalLink,
		|	CASE
		|		WHEN GoodsTable.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByCompanyOnAgencyBasis)
		|				OR GoodsTable.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByPartner)
		|			THEN ""Agency""
		|		ELSE ""Own""
		|	END AS ServiceType,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Price AS Price,
		|	GoodsTable.VATRate AS VATRate,
		|	GoodsTable.Sum AS Sum,
		|	GoodsTable.VATAmount AS VATAmount,
		|	GoodsTable.RowID AS RowID,
		|	GoodsTable.LineNumber AS DocumentRowNumber,
		|	1 AS RowKey
		|FROM
		|	GoodsTable AS GoodsTable
		|WHERE
		|	(GoodsTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.OperationService)
		|			OR GoodsTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.Products AS Products,
		|	MAX(GoodsTable.LineNumber) AS LineNumber
		|INTO TablesProductsByMaxRow
		|FROM
		|	GoodsTable AS GoodsTable
		|
		|GROUP BY
		|	GoodsTable.Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.Products AS Products,
		|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	NestedQuery.VATRate AS VATRate,
		|	NestedQuery.InventoryType AS InventoryType,
		|	NestedQuery.DocumentRowNumber AS DocumentRowNumber,
		|	NestedQuery.Price AS Price,
		|	NestedQuery.Count AS Count,
		|	NestedQuery.Sum AS Sum,
		|	NestedQuery.VATAmount AS VATAmount,
		|	NestedQuery.RowID AS RowID,
		|	NestedQuery.RowKey AS RowKey
		|FROM
		|	(SELECT
		|		InventoryKinds.Products AS Products,
		|		InventoryKinds.UnitOfMeasure AS UnitOfMeasure,
		|		InventoryKinds.Characteristic AS Characteristic,
		|		InventoryKinds.Series AS Series,
		|		InventoryKinds.Package AS Package,
		|		InventoryKinds.NumberOfPackages AS NumberOfPackages,
		|		InventoryKinds.VATRate AS VATRate,
		|		InventoryKinds.CCDNumber AS CCDNumber,
		|		CASE
		|			WHEN InventoryKinds.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|					AND InventoryKinds.ToReturnReusablePackage
		|				THEN ""ReturnContainers""
		|			ELSE InventoryKinds.InventoryType
		|		END AS InventoryType,
		|		ISNULL(RowOrderOfGoodsTable.LineNumber, 0) AS DocumentRowNumber,
		|		CAST(InventoryKinds.Price AS NUMBER(31, 2)) AS Price,
		|		SUM(InventoryKinds.Count) AS Count,
		|		SUM(InventoryKinds.QuantityByGBRN) AS QuantityByGBRN,
		|		SUM(CAST(InventoryKinds.Sum AS NUMBER(31, 2))) AS Sum,
		|		SUM(InventoryKinds.VATAmount) AS VATAmount,
		|		InventoryKinds.RowID AS RowID,
		|		InventoryKinds.RowKey AS RowKey
		|	FROM
		|		InventoryKinds AS InventoryKinds
		|			LEFT JOIN TablesProductsByMaxRow AS RowOrderOfGoodsTable
		|			ON InventoryKinds.Products = RowOrderOfGoodsTable.Products
		|	
		|	GROUP BY
		|		InventoryKinds.Products,
		|		InventoryKinds.Characteristic,
		|		InventoryKinds.UnitOfMeasure,
		|		InventoryKinds.VATRate,
		|		InventoryKinds.Price,
		|		InventoryKinds.CCDNumber,
		|		CASE
		|			WHEN InventoryKinds.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|					AND InventoryKinds.ToReturnReusablePackage
		|				THEN ""ReturnContainers""
		|			ELSE InventoryKinds.InventoryType
		|		END,
		|		ISNULL(RowOrderOfGoodsTable.LineNumber, 0),
		|		InventoryKinds.Series,
		|		InventoryKinds.Package,
		|		InventoryKinds.NumberOfPackages,
		|		InventoryKinds.RowID,
		|		InventoryKinds.RowKey) AS NestedQuery
		|
		|ORDER BY
		|	DocumentRowNumber";
	
	FillInYourOwnProductsInText(GoodsAndServicesOfDocument);
	
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "NestedQuery"));
		
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "NestedQuery"));
		
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "NestedQuery"));
	
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "NestedQuery"));
	
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "NestedQuery"));
	
	
	Query = New Query; 
	
	Query.Text = DocumentHeader + Common.QueryBatchSeparator() 
		+ OperationData + Common.QueryBatchSeparator()  
		+ Buyers + Common.QueryBatchSeparator()
		+ GoodsAndServicesOfDocument + Common.QueryBatchSeparator();
	
	Query.SetParameter("Ref",                     IBData.Ref);
	Query.SetParameter("Date",                       IBData.Date);
	Query.SetParameter("BaseCurrency",              CurrencyOfComplianceAccounting);
	
	QueryResults = Query.ExecuteBatch();
	
	OperationData = QueryResults[1].Select();
	
	If OperationData.Next() Then
		XDTOData.Insert("TransactionRate",      OperationData.TransactionRate);
		XDTOData.Insert("Multiplier_", OperationData.Multiplier_);
	EndIf;
	
	Buyers = QueryResults[2].Unload();
	OtherServices = QueryResults[5].Unload();
	TabProducts = QueryResults[7].Unload(); 
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, TabProducts);
	TableOfServicesForPrincipal(ExchangeComponents, OtherServices);
	
	XDTOData.Insert("Goods", TabProducts);
	XDTOData.Insert("Services", OtherServices);
	XDTOData.Insert("Buyers", Buyers);
EndProcedure

