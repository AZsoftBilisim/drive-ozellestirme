Procedure PCO_RequestForSpendingFundsPF_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	StoredFile = FilesOperations.FileBinaryData(IBData.Ref);
	
	XDTOData.Insert("StoredFile", StoredFile);
	
	VTElSignatures = New ValueTable();
	VTElSignatures.Columns.Add("Signature");
	VTElSignatures.Columns.Add("Certificate");
	
	DigitalSignaturesArray = DigitalSignature.SetSignatures(IBData.Ref);
	For Each SignatureStructure In DigitalSignaturesArray Do
		VTRow_ = VTElSignatures.Add();
		If TypeOf(SignatureStructure.Signature) = Type("ValueStorage") Then
			Signature = SignatureStructure.Signature; // ValueStorage
			VTRow_.Signature = Signature.Get();
		Else
			VTRow_.Signature = SignatureStructure.Signature;
		EndIf;
		If TypeOf(SignatureStructure.Certificate) = Type("ValueStorage") Then
			Certificate = SignatureStructure.Certificate; // ValueStorage
			VTRow_.Certificate = Certificate.Get();
		Else
			VTRow_.Certificate = SignatureStructure.Certificate;
		EndIf;
	EndDo;
	If VTElSignatures.Count() > 0 Then
		XDTOData.Insert("DigitalSignatures", VTElSignatures);
	EndIf;	
	
	VTCertificates = New ValueTable();
	VTCertificates.Columns.Add("Certificate");
	EncryptionCertificatesArray = DigitalSignature.EncryptionCertificates(IBData.Ref);
	For Each CertificateStructure_ In EncryptionCertificatesArray Do
		VTRow_ = VTCertificates.Add();
		If TypeOf(CertificateStructure_.Certificate) = Type("ValueStorage") Then
			Certificate = CertificateStructure_.Certificate; // ValueStorage
			VTRow_.Certificate = Certificate.Get();
		Else
			VTRow_.Certificate = CertificateStructure_.Certificate;
		EndIf;
	EndDo;
	If VTCertificates.Count() > 0 Then
		XDTOData.Insert("EncryptionCertificates", VTCertificates);
	EndIf;
EndProcedure


