		SourceDocument.Insert("IncomingDocumentNumber", String.DocumentOfARAPAccounting.Number);
	ElsIf ValueIsFilled(String.Contract)
		And String.Contract.Property("Date") And String.Contract.Property("Number") Then
		
		SourceDocument.Insert("Date",                    String.Contract.Date);
