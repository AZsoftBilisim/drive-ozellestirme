Procedure PCO_Document_VZ_OurOrganization_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Prefix = "A";
		XDTOData.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7));
		Return;
	EndIf;	
	
	LinkDebtor     = IBData.CounterpartyDebtor;
	LinkLender    = IBData.Creditor;
	
	XDTOData.KeyProperties.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7));
	
	CommissionOffset = IBData.OperationKind = Enums.KindsOfARAPSettlements.RecordOfPaymentThroughTheCommissionAgent
			Or IBData.OperationKind = Enums.KindsOfARAPSettlements.RecordOfRefundThroughTheCommissionAgent;
	
	OperationKind = "CarryingOutNetting";  
	If CommissionOffset 
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
	
		OperationKind = XMLString(IBData.OperationKind);
	    
	    XDTOData.Insert("DateOfCommissionAgentSPaymentOrder", IBData.IncomingDocumentDate);
		XDTOData.Insert("NumberOfCommissionAgentSPaymentOrder", IBData.IncomingDocumentNumber);
	    
	EndIf;
	 
	CommissionOffset = OperationKind = Enums.KindsOfARAPSettlements.RecordOfPaymentThroughTheCommissionAgent
			Or OperationKind = Enums.KindsOfARAPSettlements.RecordOfRefundThroughTheCommissionAgent;
	
	XDTOData.Insert("OperationKind", OperationKind);
	
	XDTOData.Insert("Currency",      LocalAccountingCurrency(IBData.Organization));
	
	UnloadCourseAndMultiplicityOfDocument(XDTOData, ExchangeComponents.ConversionParameters_SSLy.LocalAccountingCurrency, IBData.Date, IBData.Organization);
	UnloadDivision(IBData, XDTOData);
	
	CounterpartyDebtor = LinkDebtor;
	If TypeOf(CounterpartyDebtor) = Type("CatalogRef.Companies") Then
		CounterpartyDebtor = CounterpartyFromOrganization(CounterpartyDebtor, ExchangeComponents);
	EndIf;
	
	Creditor = LinkLender;
	If TypeOf(Creditor) = Type("CatalogRef.Companies") Then
		Creditor = CounterpartyFromOrganization(Creditor, ExchangeComponents);
	EndIf;
	
	XDTOData.Insert("CounterpartyDebtor",  CounterpartyDebtor);
	XDTOData.Insert("Creditor", Creditor);
	
	TableDZ = UnloadDebtTable("AccountsReceivable",
		IBData.Ref, XDTOData.CounterpartyDebtor, IBData.Organization, , ExchangeComponents);
	XDTOData.Insert("AccountsReceivable", TableDZ);
	
	KZTable = UnloadDebtTable("AccountsPayable",
		IBData.Ref, XDTOData.Creditor, IBData.Organization, , ExchangeComponents);
	XDTOData.Insert("AccountsPayable", KZTable);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

