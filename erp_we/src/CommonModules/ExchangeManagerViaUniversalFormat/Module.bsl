Procedure OCR_Document_GoodsRecordingAsReceived_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_RegistrationOfGoods_Receipt", 
										"Goods", 
										"CCDNumber",
										False,
										"Catalog_CCDNumbers_ItemReceive");
	EndIf;
	
	ReceivedData.Posted = True;
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");
	FillingRules.Insert("Price",         "Price");
	FillingRules.Insert("Sum",        "Sum");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
	    FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
	EndIf;
	
	ArrayOfRows = New Array;
	For Each String In XDTOData.Goods Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		If ValueIsFilled(String.CCDNumber) Then
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		        StringDataStructure.Insert("CCDNumber", String.CCDNumber);
		    Else
		    	StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
		    EndIf;
		EndIf;
		
		ArrayOfRows.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	
	#EndRegion
EndProcedure
Procedure OCR_Document_GoodsRecordingAsReceived_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	If IBData = Undefined Then
		Warehouse = ReceivedData.Warehouse;
		Currency = ReceivedData.Currency;
	Else	
		Warehouse = IBData.Warehouse;
		Currency = IBData.Currency;
	EndIf;
		
	If Not ValueIsFilled(Currency) Then
		PriceKind = Catalogs.Warehouses.AccountingPriceType(Warehouse);
		Currency = IncomeAndExpensesServer.GetCurrencyOfManagementAccounting(
						Catalogs.TypesOfPrices.GetPriceTypeDetails(PriceKind).PriceCurrency);
	EndIf;
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
							ReceivedData.AdditionalProperties, ExchangeComponents);
							
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);  
	DataToWriteToIB.Currency = Currency;
EndProcedure

