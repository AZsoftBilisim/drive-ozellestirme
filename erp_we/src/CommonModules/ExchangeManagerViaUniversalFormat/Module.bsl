Procedure DeferredProcessing_Organization(Object)
	If ValueIsFilled(Object.ParentCompany) Then
		Object.BranchOffice = (Not Object.ParentCompany = Object.Ref);
	Else
		Object.BranchOffice = False;
	EndIf;
	If Not ValueIsFilled(Object.ParentCompany)
		And Not Object.BranchOffice Then
		Object.ParentCompany = Object.Ref;
	EndIf;
	If Not ValueIsFilled(Object.RegionalFactor) Then
		Object.RegionalFactor = 1;
	EndIf;
	If Not ValueIsFilled(Object.RegistrationCountry) Then
	
		ItSInternational = True;
	
		CountryRegistrationData = Catalogs.Companies.DataOfCountriesOfRegistrationOfOrganizations();
	
		If Not ItSInternational Then
			Object.RegistrationCountry = Constants.MainCountry.Get();
		Else
			If CountryRegistrationData <> Undefined Then
				If ValueIsFilled(CountryRegistrationData.RegistrationCountry) Then
					Object.RegistrationCountry = CountryRegistrationData.RegistrationCountry;
				Else
					Object.RegistrationCountry = Constants.MainCountry.Get();
				EndIf;
			Else
				Object.RegistrationCountry = Constants.MainCountry.Get();
			EndIf;
		EndIf;
	
	EndIf;
EndProcedure
