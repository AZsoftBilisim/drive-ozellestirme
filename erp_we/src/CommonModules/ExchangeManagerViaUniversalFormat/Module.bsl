	|	ProductComparisonResultTime.DocumentItemsBeforeAdjustment_Amount AS AmountBeforeAdjustment,
	|	ProductComparisonResultTime.DocumentItemsBeforeAdjustment_VATAmount AS AmountOfVATBeforeAdjustment,
	|	ProductComparisonResultTime.ItemsOfDocumentBeingCorrected_Quantity AS QuantityBeforeChange_,
	|	ProductComparisonResultTime.ProductsOfDocumentBeingCorrected_NumberOfPackages AS NumberOfPackagesBeforeChange_,
	|	ProductComparisonResultTime.GoodsOfCorrectedDocument_QuantityAccordingToRNPT AS QuantityByRNPTBeforeChange,
	|	ProductComparisonResultTime.NameOfDocumentBeingCorrected_Amount AS AmountBeforeChange,
	|	ProductComparisonResultTime.ItemsInDocumentBeingCorrected_VATAmount AS VATAmountBeforeChange,
	|	ProductComparisonResultTime.GoodsOfCorrectionalDocument_Quantity AS Count,
