		For Each TSRow In Object.Goods Do
			If Not ValueIsFilled(TSRow.Department) Then
				TSRow.Department = DefaultElement(ExchangeComponents, "Department");
			EndIf;
		EndDo;
	EndIf;
	
	// Let's check the details of the division.
	AttributesValues = New Structure("ProductionBusinessUnit, BackflushProduction_", True, True);
	CheckUpdateItemDetails(Object.Department, AttributesValues, ExchangeComponents);
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
EndProcedure


Procedure DeferredProcessing_MovementOfProductsAndMaterials(Object, ExchangeComponents)
	If Object.AdditionalProperties.Property("OperationKind") 
		And Object.AdditionalProperties.OperationKind.Value = "ProductsReleaseToBusinessUnit" Then
		
		If Object.AdditionalProperties.Property("CostDivision") And ValueIsFilled(Object.AdditionalProperties.CostDivision) Then
			CostDivision = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
				ExchangeComponents,
				Object.AdditionalProperties.CostDivision,
				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Departments_Receive"), 
				"GetRef").Ref;
		Else
			CostDivision = DefaultElement(ExchangeComponents, "Department");
		EndIf;
		
		// Let's check the details of the division.
		AttributesValues = New Structure("ProductionBusinessUnit, BackflushProduction_", True, True);
		CheckUpdateItemDetails(CostDivision, AttributesValues, ExchangeComponents);
		
		// We will get the default pantry.
		AddlParameters = New Structure;
		AddlParameters.Insert("Department", CostDivision);
		
		Object.Recipient = DefaultElement(ExchangeComponents, "WorkshopPantry", AddlParameters);
		
	EndIf;
	
	FillInDefaultActivity(Object, "VATTaxation");
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	#Region FillingPantry
	
	WorkshopPantry = Undefined;
	PantryDivision = Undefined;
	PropsNamePantry = "";
	If Object.BusinessOperation = Enums.BusinessTransactions.TransferOfMaterialsToStoreroom Then
		PropsNamePantry = "Recipient";
	ElsIf Object.BusinessOperation = Enums.BusinessTransactions.ReturnOfMaterialsFromStoreroom
		Or Object.BusinessOperation = Enums.BusinessTransactions.TransferOfProductsFromStoreroom Then
		PropsNamePantry = "Sender";
	EndIf;
		
	If ValueIsFilled(PropsNamePantry) Then	
		If ValueIsFilled(Object[PropsNamePantry])
			And Common.RefExists(Object[PropsNamePantry]) Then
			
			If TypeOf(Object[PropsNamePantry]) = Type("CatalogRef.Warehouses")
				And Common.ObjectAttributeValue(Object[PropsNamePantry], "ShopFloorStockroom") Then
			
				WorkshopPantry = Object[PropsNamePantry]
			ElsIf TypeOf(Object[PropsNamePantry]) = Type("CatalogRef.BusinessStructure") Then
				PantryDivision = Object[PropsNamePantry];
			EndIf;
		EndIf;
		
		If Not ValueIsFilled(WorkshopPantry) Then
			If Not ValueIsFilled(PantryDivision) Then
				PantryDivision = DefaultElement(ExchangeComponents, "Department");
			EndIf;
			
			// Let's check the details of the division.
			AttributesValues = New Structure("ProductionBusinessUnit, ProductionByOrders", True, True);
			CheckUpdateItemDetails(PantryDivision, AttributesValues, ExchangeComponents);
			
			// We will get the default pantry.
			AddlParameters = New Structure;
			AddlParameters.Insert("Department", PantryDivision);
			WorkshopPantry = DefaultElement(ExchangeComponents, "WorkshopPantry", AddlParameters);
			
			Object[PropsNamePantry] = WorkshopPantry;
		EndIf;
	EndIf;
		
	#EndRegion
EndProcedure


