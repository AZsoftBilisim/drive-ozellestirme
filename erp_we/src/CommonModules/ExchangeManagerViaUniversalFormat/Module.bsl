Procedure OCR_Document_ConsignmentReportFromCustomer_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted    = True;
	ReceivedData.PaymentDate = ReceivedData.Date;
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	TheseAreCustomerReturns = False;
	Goods = Undefined;
	If XDTOData.Property("VATRateOfRemuneration") And ValueIsFilled(XDTOData.VATRateOfRemuneration) Then
		ReceivedData.AdditionalProperties.Insert("VATRateOfRemuneration", CatalogOfVATRateTransfers(ExchangeComponents, XDTOData.VATRateOfRemuneration));
	EndIf;
	
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "Director");
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "ChiefAccountant");
	
	#Region Goods
	If XDTOData.Property("Goods") Then
		ReceivedData.AmountVATRemuneration = XDTOData.Goods.Total("AmountVATRemuneration");
	Else
		ReceivedData.AmountVATRemuneration = 0;
	EndIf;
	
	FillingRules = New Map;
	
	FillingRules.Insert("Products",           "Products");
	FillingRules.Insert("Count",             "Count");
	FillingRules.Insert("Customer",             "Customer");
	FillingRules.Insert("Sum",                  "SalesAmount");
	FillingRules.Insert("CommissionAmount",    "CommissionAmount");
	FillingRules.Insert("TransferAmount",          "Sum");
	FillingRules.Insert("TransferPrice",                   "Price"); 
	FillingRules.Insert("Price",                   "SellingPrice");
	FillingRules.Insert("VATRate",              "VATRate");
	FillingRules.Insert("VATAmount",               "AmountSalesVAT");
	FillingRules.Insert("AmountVATRemuneration", "AmountVATRemuneration");
	
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
	    FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
	    FillingRules.Insert("CCDNumber", "CCDNumber");
	EndIf;
	
	ArrayOfRows = New Array;
	If XDTOData.Property("Goods") Then
	    Goods = XDTOData.Goods 
	ElsIf XDTOData.Property("CustomerRefunds") Then
		Goods = XDTOData.CustomerRefunds;
		TheseAreCustomerReturns = True;
	EndIf;  
	If Goods = Undefined Or Goods.Count() = 0 Then
	     Return;
	EndIf;
	For Each String In Goods Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
		    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
		EndIf;
	
		If Not StringDataStructure.Property("NumberOfPackages") Then
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf;
		If StringDataStructure.Property("Sum") Then
			StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
		EndIf;
		If StringDataStructure.Property("SalesAmount") Then
			StringDataStructure.Insert("SellingPrice", StringDataStructure.SalesAmount / StringDataStructure.NumberOfPackages);
		EndIf;
			
		If XDTOData.Property("Buyers") And ValueIsFilled(XDTOData.Buyers) Then
			StringDataStructure.Insert("Customer");
			StringDataStructure.Insert("DateOfTaxInvoiceIssuedByCommissionAgent");
			StringDataStructure.Insert("CommissionAgentSTaxInvoiceNumber");
			
			RulesForFillingInSF = New Map;
			RulesForFillingInSF.Insert("Customer",  "Customer");
			RulesForFillingInSF.Insert("InvoiceDate",      "DateOfTaxInvoiceIssuedByCommissionAgent");
			RulesForFillingInSF.Insert("InvoiceNumber",     "CommissionAgentSTaxInvoiceNumber");
			RulesForFillingInSF.Insert("TaxInvoice", "TaxInvoice");
		
			CustomerLine = XDTOData.Buyers.Find(String.RowKey, "RowKey");
			If Not CustomerLine = Undefined Then
				SFStringDataStructure = CollectionDataAsStructure(CustomerLine, RulesForFillingInSF);
				FillPropertyValues(StringDataStructure, SFStringDataStructure);
				
				If SFStringDataStructure.Property("TaxInvoice")
					And (Not SFStringDataStructure.Property("DateOfTaxInvoiceIssuedByCommissionAgent")
					Or Not SFStringDataStructure.Property("CommissionAgentSTaxInvoiceNumber")) Then
					If SFStringDataStructure.TaxInvoice.Property("Number") Then
						StringDataStructure.Insert("CommissionAgentSTaxInvoiceNumber", SFStringDataStructure.TaxInvoice.Number);
					EndIf;
					If SFStringDataStructure.TaxInvoice.Property("Date") Then
						StringDataStructure.Insert("DateOfTaxInvoiceIssuedByCommissionAgent",  SFStringDataStructure.TaxInvoice.Date);
					EndIf;
				EndIf;
				
			EndIf;
		EndIf;	
		
		ArrayOfRows.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	
	#EndRegion
EndProcedure
Procedure OCR_Document_ConsignmentReportFromCustomer_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
