// Parameters:
//  VATRate - Structure
//  Exchange Components - See DataExchangeXDTOServer.InitializeExchangeComponents
//
Function CatalogOfVATRateTransfers(ExchangeComponents, VATRate)
	PaymentVATRate = Undefined;
	CatalogVATRate   = Undefined;
	
	If TypeOf(VATRate) = Type("Structure") Then  
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
			
			
			If Not VATRate.Property("Rate1") Then
				Return Catalogs.VATRates.EXCLUDINGVAT;
			EndIf;
			CountryDescription = ""; 
			If Not VATRate.Property("Country") Then
				Country = SettingsValueClientServerCached.MainCountry();
				CountryDescription = Country.Description;
			Else	 
				Country = VATRate.Country; // Structure 
				CountryDescription = Country.Description;
			EndIf;
	
			Query = New Query("SELECT
			|	VATRates.Ref AS Ref
			|FROM
			|	Catalog.VATRates AS VATRates
			|WHERE
			|	VATRates.CalculatedRate = &CalculatedRate
			|	AND VATRates.Country.Description = &Country
			|	AND VATRates.Rate1 = &Rate1");
	
			Query.SetParameter("Rate1", ?(VATRate.Property("Rate1"),VATRate.Rate1, 0));
			Query.SetParameter("CalculatedRate", VATRate.CalculatedRate);
			Query.SetParameter("Country", CountryDescription);
			Selection = Query.Execute().Select();
	
			If Selection.Next() Then
				CatalogVATRate = Selection.Ref;
			EndIf;
	
			Return ?(ValueIsFilled(CatalogVATRate), CatalogVATRate,Catalogs.VATRates.EmptyRef());
		EndIf;
	EndIf;
	
	
	If TypeOf(VATRate) = Type("Structure") Then
	
		VATRateByLine = VATRate.Value;
		If VATRateByLine = "EXCLUDINGVAT" Then 
			Return Catalogs.VATRates.EXCLUDINGVAT;
		EndIf;
	
		VATRateByLine = StrReplace(VATRateByLine, "VAT", "");
		CalculatedRate = StrFind(VATRateByLine, "_") > 0;
	
		If CalculatedRate Then
			VATRateByLine = StrReplace(VATRateByLine, "_", "/");
		Else
			VATRateByLine = VATRateByLine + "%";
		EndIf;
	
		Query = New Query("SELECT
		|	VATRates.Ref AS Ref
		|FROM
		|	Catalog.VATRates AS VATRates
		|WHERE
		|	VATRates.Description = &Description
		|	AND VATRates.CalculatedRate = &CalculatedRate");
	
		Query.SetParameter("Description", VATRateByLine);
		Query.SetParameter("CalculatedRate", CalculatedRate);
	
		Selection = Query.Execute().Select();
	
		If Selection.Next() Then
			CatalogVATRate = Selection.Ref;
		EndIf;
	
	EndIf;
	
	Return CatalogVATRate;
EndFunction


Function LinkToGetARAPObject(StringDataStructure)
	ObjectReference = Undefined;
	
	ContractCompleted = StringDataStructure.Property("Contract") 
		And LinkIsFilledInAndExists(StringDataStructure.Contract);
	CalculationDocumentIsFilledIn = StringDataStructure.Property("DocumentOfARAPAccounting") 
		And LinkIsFilledInAndExists(StringDataStructure.DocumentOfARAPAccounting);
		
	If CalculationDocumentIsFilledIn Then
		
		DocumentOfARAPAccounting = StringDataStructure.DocumentOfARAPAccounting.GetObject();
		
		ObjectManager = Common.ObjectManagerByRef(DocumentOfARAPAccounting.Ref);
		MechanismParameters = ObjectManager.SettlementParameters_(DocumentOfARAPAccounting);
		
		AugmentedMechanismParameters = ARAPAccountingServer.AugmentedMechanismParameters(DocumentOfARAPAccounting, MechanismParameters);
		
		For Each ParametersStructure In AugmentedMechanismParameters.ParametersArray Do
			
			ARAPObjectSettings = TMCommonUseClientServer.DataAlongWay(DocumentOfARAPAccounting, ParametersStructure.ARAPObjectSettings, , Enums.ARAPObjectSettings.ByARAPDocuments);
			Contract = TMCommonUseClientServer.DataAlongWay(DocumentOfARAPAccounting, ParametersStructure.Contract);
			
			If ARAPObjectsServer.ReferenceIsObjectOfCalculations(DocumentOfARAPAccounting, ParametersStructure) Then
				ObjectReference = DocumentOfARAPAccounting.Ref; 
			ElsIf ARAPObjectSettings = Enums.ARAPObjectSettings.ByCounterpartyContracts
				And LinkIsFilledInAndExists(Contract) Then
				ObjectReference = Contract; 
			EndIf;
			
		EndDo;
		
	ElsIf ContractCompleted Then
		
		ARAPObjectSettings = Common.ObjectAttributeValue(StringDataStructure.Contract, "ARAPObjectSettings");
		
		If (ARAPObjectSettings = Enums.ARAPObjectSettings.ByCounterpartyContracts
			Or ARAPObjectSettings = Enums.ARAPObjectSettings.ContractForPrepaymentInvoiceForInvoice) Then
			
			ObjectReference = StringDataStructure.Contract; 
			
		EndIf;
		
	EndIf;
	
	Return ObjectReference;
EndFunction
Function LinkIsFilledInAndExists(Ref)
	Return ValueIsFilled(Ref)
		And Common.RefExists(Ref);
EndFunction
Function LinkToCalculationDocumentFromXDTOData(ExchangeComponents, XDTOData)
	TypeOfCalculationDocument = XDTOData.ValueType;
	DocumentOfARAPAccounting     = Undefined;
	OCRName               = "";
	
	If TypeOfCalculationDocument = "АвансовыйОтчет" Then // @Non-NLS-1
		OCRName = "Document_AdvanceReport_Receipt";
		
	ElsIf TypeOfCalculationDocument = "ВозвратТоваровОтПокупателя" Then // @Non-NLS-1
		OCRName = "Document_ReturnOfGoodsFromBuyer_Receipt";
		
	ElsIf TypeOfCalculationDocument = "ВозвратТоваровПоставщику" Then // @Non-NLS-1
		OCRName = "Document_ReturnOfGoodsToSupplier_Receipt";
		
	ElsIf TypeOfCalculationDocument = "ЗаказКлиента" Then // @Non-NLS-1
		OCRName = "Document_CustomerOrder_Receipt";
		
	ElsIf TypeOfCalculationDocument = "ЗаказПоставщику" Then // @Non-NLS-1
		OCRName = "Document_OrderToSupplier_Receipt";	
		
	ElsIf TypeOfCalculationDocument = "КорректировкаДолга" Then // @Non-NLS-1
		OCRName = "Document_DebtCancellation_Receipt";
		
	ElsIf TypeOfCalculationDocument = "КорректировкаПоступленияТоваров" Then // @Non-NLS-1
		OCRName = "Document_AdjustmentOfReceiptOfGoods_Receipt";
		
	ElsIf TypeOfCalculationDocument = "КорректировкаРеализацииТоваров" Then // @Non-NLS-1
		OCRName = "Document_AdjustmentOfSalesOfGoods_Receipt";
		
	ElsIf TypeOfCalculationDocument = "ОперацияПоПлатежнойКарте" Then // @Non-NLS-1
		OCRName = "Document_PaymentCardOperation_Receipt";
	
	ElsIf TypeOfCalculationDocument = "ОтчетКомиссионера" Then // @Non-NLS-1
		OCRName = "Document_CommissionAgentSReport_Receipt";
	
	ElsIf TypeOfCalculationDocument = "ОтчетКомитенту" Then // @Non-NLS-1
		OCRName = "Document_ReportToCommittee_Receipt";
	
	ElsIf TypeOfCalculationDocument = "ПБДСРасчетыСКонтрагентами" Then // @Non-NLS-1
		OCRName = "Document_PBDSSettlementsWithCounterparties_Receipt";
	
	ElsIf TypeOfCalculationDocument = "ПКОРасчетыСКонтрагентами" Then // @Non-NLS-1
		OCRName = "Document_PCOSettlementsWithCounterparties_Receipt";
	
	ElsIf TypeOfCalculationDocument = "ПоступлениеТоваровУслуг" Then // @Non-NLS-1
		OCRName = "Document_ReceiptOfGoodsServices_Receipt";
	
	ElsIf TypeOfCalculationDocument = "РеализацияТоваровУслуг" Then // @Non-NLS-1
		OCRName = "Document_SaleOfGoodsServices_Receipt";
	
	ElsIf TypeOfCalculationDocument = "РКОРасчетыСКонтрагентами" Then // @Non-NLS-1
		OCRName = "Document_RCOSettlementsWithCounterparties_Receipt";
		
	ElsIf TypeOfCalculationDocument = "СБДСРасчетыСКонтрагентами" Then // @Non-NLS-1
		OCRName = "Document_SBDSSettlementsWithCounterparties_Receipt";
		
	ElsIf TypeOfCalculationDocument = "ТаможеннаяДекларация" Then // @Non-NLS-1
		OCRName = "Document_CustomsDeclaration_Receipt";
	
	ElsIf TypeOfCalculationDocument = "ИсходныйДокумент" Then // @Non-NLS-1
		OCRName = "Document_PrimaryDocument_Receipt";
		
	ElsIf TypeOfCalculationDocument = "Договор" Then // @Non-NLS-1
		If Not XDTOData.Property("Ref") Then
			OCRName = "Catalog_ContractsOfCounterparties_FromStructure__";
		Else
			OCRName = "Catalog_CounterpartyContracts_Receive";
		EndIf;
	EndIf;
	
	If ValueIsFilled(OCRName) Then
		ICOString = DataExchangeXDTOServer.OCRByName(ExchangeComponents, OCRName);
		
		// Error bypass up to version ED 1.6
		// link type "Key property of the report to the Subscriber" - the report of the Commissionaire.
		If Not (NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6")
		And (TypeOfCalculationDocument = "ОтчетКомитенту" Or TypeOfCalculationDocument = "ОтчетКомиссионера")
		And StrFind(ICOString.FormatObject, TypeOfCalculationDocument) = 0) Then // @Non-NLS-2 @Non-NLS-3
		
			DocumentOfARAPAccounting = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents,
				XDTOData,
				ICOString,
				"GetRef");
			If Not Common.IsReference(TypeOf(DocumentOfARAPAccounting)) Then
				DocumentOfARAPAccounting = DocumentOfARAPAccounting.Ref;
			EndIf;
		EndIf;
	EndIf;
	
	Return DocumentOfARAPAccounting;
EndFunction
Function VATRateToXDTOString(VATRate, VATAtRates2And4)
	If VATRate = Catalogs.VATRates.EXCLUDINGVAT Then
		
		Return "EXCLUDINGVAT"; 
		
	EndIf;  
	
	AttributesOfVATRate = Common.ObjectAttributesValues(VATRate,  "Rate1, CalculatedRate");
	
	If AttributesOfVATRate.Rate1 = 0 Then
		
		Return "VAT0";
		
	EndIf;
	
	
	MatchingRates = New Map;
	
	If AttributesOfVATRate.CalculatedRate Then
		
		MatchingRates.Insert(10, "VAT10_110");
		MatchingRates.Insert(18, "VAT18_118");
		MatchingRates.Insert(20, "VAT20_120");
		
	Else
		
		MatchingRates.Insert(10, "VAT10");
		MatchingRates.Insert(18, "VAT18");
		MatchingRates.Insert(20, "VAT20");
		
	EndIf;
	
	VATRateByLine = MatchingRates.Get(AttributesOfVATRate.Rate1);
	VATRateByLine = ?(VATRateByLine = Undefined, "", VATRateByLine);
	
	Return VATRateByLine;
EndFunction


Function VATRateAccordingToCatalog(RefVATRate)
	If Not ValueIsFilled(RefVATRate) Then
		Return "EXCLUDINGVAT";
	EndIf;
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	CASE
		|		WHEN VATRates.Ref = VALUE(Catalog.VATRates.EXCLUDINGVAT)
		|			THEN ""EXCLUDINGVAT""
		|		WHEN VATRates.CalculatedRate
		|			THEN CASE
		|					WHEN VATRates.Rate1 = 10
		|						THEN ""VAT10_110""
		|					WHEN VATRates.Rate1 = 18
		|						THEN ""VAT18_118""
		|					WHEN VATRates.Rate1 = 20
		|						THEN ""VAT20_120""
		|				END
		|		ELSE CASE
		|				WHEN VATRates.Rate1 = 0
		|					THEN ""VAT0""
		|				WHEN VATRates.Rate1 = 10
		|					THEN ""VAT10""
		|				WHEN VATRates.Rate1 = 18
		|					THEN ""VAT18""
		|				WHEN VATRates.Rate1 = 20
		|					THEN ""VAT20""
		|			END
		|	END AS Rate1
		|FROM
		|	Catalog.VATRates AS VATRates
		|WHERE
		|	VATRates.Ref = &Ref";
	
	Query.SetParameter("Ref", RefVATRate);
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		Return Selection.Rate1;
	Else
		Return "EXCLUDINGVAT";
	EndIf;
EndFunction


