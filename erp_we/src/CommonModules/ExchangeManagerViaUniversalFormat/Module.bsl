Procedure PCO_Document_SaleOfGoodsAndServices_ReceiptKKM_Receipt_WhenConvertingDataXDTO(XDTOData, ReceivedData, ExchangeComponents)
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	FillInVATTaxationBasedOnReceivedData(ExchangeComponents, ReceivedData, XDTOData, False);
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	ReceivedData.Status = Enums.StatusesOfCustomerInvoices.Shipped;
	
	FillingRules = New Map;
	FillingRules.Insert("Products",  "Products");
	FillingRules.Insert("Count",    "Count");
	FillingRules.Insert("Sum",         "Sum");
	FillingRules.Insert("Price",          "Price");
	FillingRules.Insert("VATRate",     "VATRate");
	FillingRules.Insert("VATAmount",      "VATAmount");
	FillingRules.Insert("DiscountPercentage", "PercentRateOfManualDiscount");
	FillingRules.Insert("DiscountAmount",   "ManualDiscount");
	FillingRules.Insert("RowID",   "RowID");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	// Goods 
	ArrayOfRows = New Array;
	
	If XDTOData.Property("GoodsSale")
		And ValueIsFilled(XDTOData.GoodsSale) Then
		
		For Each String In XDTOData.GoodsSale Do
		
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			If StringDataStructure.Property("NumberOfPackages") Then
			    If StringDataStructure.Property("Package") And StringDataStructure.Property("Sum") Then
					StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
				EndIf;
			Else
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
			If XDTOData.Property("Warehouse") Then
				StringDataStructure.Insert("Warehouse", XDTOData.Warehouse);
			EndIf;
			
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			
			// Discount rates are loaded into TS products 
			If XDTOData.Property("DiscountsMarkups")
				And ValueIsFilled(XDTOData.DiscountsMarkups) Then
				DiscountsFound = XDTOData.DiscountsMarkups.FindRows(New Structure("RowID", String.RowID));
				If DiscountsFound.Count() > 0 Then
					DiscountMarkUpLine = DiscountsFound[0];
					StringDataStructure.Insert("ManualDiscount", DiscountMarkUpLine.DiscountAmount);
					StringDataStructure.Insert("PercentRateOfManualDiscount", DiscountMarkUpLine.DiscountPercentage);
				EndIf;
			EndIf;
		
			ArrayOfRows.Add(StringDataStructure);
			
		EndDo;
		
	EndIf;
	
	// Services are loaded into PM Goods 
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
	
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			
