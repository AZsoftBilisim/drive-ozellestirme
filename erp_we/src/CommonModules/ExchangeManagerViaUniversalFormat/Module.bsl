Procedure DeferredProcessing_SettingProductPrices(Object, ObjectIsModified, ExchangeComponents)
	If Not ValueIsFilled(Object.Status) Then
		Object.Status = Enums.ProductPricingStatuses.Approved;
	EndIf;
	
	If ExchangeComponents.ConversionParameters_SSLy.UsePriceManagementSystem25
		And ValueIsFilled(Object.AdditionalProperties)
		And Object.AdditionalProperties.Property("Goods2_5")
		And Object.Goods2_5.Count() = Object.AdditionalProperties.Goods2_5.Count() Then
		
		RowIndex = -1;
		
		For Each RowOfProductsAndProperties In Object.AdditionalProperties.Goods2_5 Do
			
			RowIndex = RowIndex + 1;
			
			If Not (RowOfProductsAndProperties.Property("PricingVariant") Or RowOfProductsAndProperties.Property("PricingBatch")) Then
				Continue;
			EndIf;
			
			Line1OfDocument = Object.Goods2_5[RowIndex];
			
			Products = Line1OfDocument.Products;
			If Not ValueIsFilled(Products) Then
				Continue;
			EndIf;
			
			ProductKind = Common.ObjectAttributeValue(Products, "ProductKind");
			If Not ValueIsFilled(ProductKind) Then
				Continue;
			EndIf;
			
			SettingsOfPriceKeyByItemVariant = Common.ObjectAttributeValue(ProductKind, "SettingsOfPriceKeyByItemVariant");
			SettingsOfPriceKeyByBatch          = Common.ObjectAttributeValue(ProductKind, "SettingsOfPriceKeyByBatch");
			
			If RowOfProductsAndProperties.Property("PricingVariant") 
				And (SettingsOfPriceKeyByItemVariant = Enums.FilterOptionForPriceKey.Use
					Or SettingsOfPriceKeyByItemVariant = Enums.FilterOptionForPriceKey.UseByAttributes) Then
					
				CharacteristicReference = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
							ExchangeComponents,
							RowOfProductsAndProperties.PricingVariant,
							DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_ItemsCharacteristics"),
							"GetRef");
				If Not TypeOf(CharacteristicReference) = Type("CatalogRef.ItemsCharacteristics") Then
					Continue;
				EndIf;
				
				Characteristic = CharacteristicReference.GetObject();
				PricingVariant = Characteristic.ItemsCharacteristicForPricing;
				
				If Not ValueIsFilled(PricingVariant) Then
					
					SearchDetails_ = Characteristic.GetAttributesForSearch(ProductKind, SettingsOfPriceKeyByItemVariant);
					
					PricingVariant = Catalogs.ItemsCharacteristicsForPricing.GetCharacteristicsOfProductsForPricing(SearchDetails_);
					Characteristic.ItemsCharacteristicForPricing = PricingVariant;
					Characteristic.DataExchange.Load = True;
					Characteristic.Write();
					
				EndIf;
				
				Line1OfDocument.PricingVariant = PricingVariant;
			EndIf;
			
			If RowOfProductsAndProperties.Property("PricingBatch") 
				And (SettingsOfPriceKeyByBatch = Enums.FilterOptionForPriceKey.Use
					Or SettingsOfPriceKeyByBatch = Enums.FilterOptionForPriceKey.UseByAttributes) Then
			
				SeriesReference = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
							ExchangeComponents,
							RowOfProductsAndProperties.PricingBatch,
							DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_ItemsBatches"),
							"GetRef");
				If Not TypeOf(SeriesReference) = Type("CatalogRef.ItemsBatches") Then
					Continue;
				EndIf;
				
				Series = SeriesReference.GetObject();
				PricingBatch = Series.ItemsBatchForPricing;
				
				If Not ValueIsFilled(PricingBatch) Then
					
					SeriesUseSettings  = Catalogs.ItemKinds.SeriesUseSettings(ProductKind);
					SearchDetails_ = Series.GetAttributesForSearch(ProductKind, SeriesUseSettings, True);
					PricingBatch = Catalogs.ItemsBatchesForPricing.GetSeriesOfProductsForPricing(SearchDetails_);
	
					Series.ItemsBatchForPricing = PricingBatch;
					Series.DataExchange.Load = True;
					Series.Write();
					
				EndIf;
				
				Line1OfDocument.PricingBatch = PricingBatch;
			EndIf;
			
		EndDo;
	EndIf;
EndProcedure
