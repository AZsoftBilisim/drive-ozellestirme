Procedure PCO_Catalog_DiscountCards_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Counterparty = IBData.Counterparty;
	If Not ValueIsFilled(Counterparty) Then
		Counterparty = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(IBData.Partner);
		If Not ValueIsFilled(Counterparty) Then
			Counterparty = CounterpartyFromPartner(IBData.Partner, ExchangeComponents);
		EndIf;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
		
		XDTOData.Insert("Status", IBData.Status);
		
	EndIf;
	
	If ExportStack.Count() > 1 Then
	
		CardType = Common.ObjectAttributeValue(IBData.Owner, "CardType");
	
		CardNumber = "";				
		If CardType = Enums.CardTypes.Barcode_ Then
			CardNumber = IBData.Barcode;
		ElsIf CardType = Enums.CardTypes.Magnetic Then
			CardNumber = IBData.MagneticCode;
		Else
			If ValueIsFilled(IBData.Barcode) Then
				CardNumber = IBData.Barcode;
			ElsIf ValueIsFilled(IBData.MagneticCode) Then
				CardNumber = IBData.MagneticCode;
			EndIf;
		EndIf;
			
		If Not ValueIsFilled(CardNumber) Or Not ValueIsFilled(Counterparty) Then
			XDTOData = Undefined;
			Return;
		EndIf;
	
		XDTOData.Insert("CardNumber", CardNumber);
		XDTOData.Insert("Cardholder", Counterparty);
	
	Else
		XDTOData.KeyProperties.Insert("CardNumber", IBData.AdditionalProperties.CardNumber);
		XDTOData.KeyProperties.Insert("Cardholder", Counterparty);
		
		If IBData.AdditionalProperties.Property("LoyaltyProgram_") Then
			XDTOData.Insert("LoyaltyProgram_", IBData.AdditionalProperties.LoyaltyProgram_);
		EndIf;
	EndIf;
EndProcedure

