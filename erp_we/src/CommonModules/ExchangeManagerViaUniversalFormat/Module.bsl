		Or (Common.DataSeparationEnabled()
		And Common.SeparatedDataUsageAvailable()) Then
		
		ClearUsageOCR(UsageOCR);
	
		// If the bank does not have a BIC filled in or data separation is used (and the bank is not found),
		// bank details are loaded directly into bank accounts. 	
		TableBanks = ExchangeComponents.ConversionParameters_SSLy.TableBanks; //ValueTable
		
