Procedure DPR_Document_ReversingEntry_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	WarningText = "";
	
	If Not NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21") Then
		
		WarningText = NStr("ru = 'Документ %1 не выгружен, так как не поддерживается в формате %2';
							|vi = 'The %1 document is not exported as it is not supported in the %2 format';
							|en = 'The %1 document is not exported as it is not supported in the %2 format'; fa = 'The %1 document is not exported as it is not supported in the %2 format';
							|it = 'The %1 document is not exported as it is not supported in the %2 format';
							|pl = 'The %1 document is not exported as it is not supported in the %2 format';
							|tr = '%1 belgesi, %2 formatında desteklenmediği için dışa aktarılmadı'");
		WarningText = StringFunctionsClientServer.SubstituteParametersToString(WarningText, IBData.Ref, String(ExchangeComponents.ExchangeFormatVersion));
		
	ElsIf Not DocumentUploadIsSupported(IBData.ReversedDocument, IBData.Organization, ExchangeComponents) Then
		
		WarningText = NStr("ru = 'Документ %1 не выгружен, так как сторнируемый документ %2 не поддерживается в формате обмена %3';
							|vi = 'The %1 document is not exported as the %2 reversed document is not supported in the %3 exchange format';
							|en = 'The %1 document is not exported as the %2 reversed document is not supported in the %3 exchange format'; fa = 'The %1 document is not exported as the %2 reversed document is not supported in the %3 exchange format';
							|it = 'The %1 document is not exported as the %2 reversed document is not supported in the %3 exchange format';
							|pl = 'The %1 document is not exported as the %2 reversed document is not supported in the %3 exchange format';
							|tr = '%1 belgesi, iptal edilen %2 belgesi %3 değişim formatında desteklenmediği için dışa aktarılmadı'");
		WarningText = StringFunctionsClientServer.SubstituteParametersToString(WarningText, IBData.Ref, String(IBData.ReversedDocument), String(ExchangeComponents.ExchangeFormatVersion));
		
	EndIf;
	
	If Not IsBlankString(WarningText) Then
		
		ClearUsageOCR(UsageOCR);
	
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
		Return;
		
	EndIf;
EndProcedure

Procedure AddDPR_Document_ProformaInvoice_Send(DataProcessingRules)
