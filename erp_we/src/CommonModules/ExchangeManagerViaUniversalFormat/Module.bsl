Procedure DeferredProcessing_ProductCharacteristics(Object, ExchangeComponents)
	#Region OwnerProcessing
	
	TechnicalCharacteristics = Undefined;
	If TypeOf(Object.Owner) = Type("CatalogRef.Products") Then
		UseVariants = Common.ObjectAttributeValue(Object.Owner, "UseVariants");
		If UseVariants = Enums.ItemVariantsUsageOptions.DontUse
			Or Not ValueIsFilled(UseVariants) Then
			
			TechnicalCharacteristics = Object.Owner.GetObject();
			TechnicalCharacteristics.UseVariants = Enums.ItemVariantsUsageOptions.SpecialForItems;
			
		EndIf;
	ElsIf TypeOf(Object.Owner) = Type("CatalogRef.ItemKinds")
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		
		OwnerData = Common.ObjectAttributesValues(Object.Owner,
			"UseVariants, UseCharacteristics");
		If Not OwnerData.UseCharacteristics
			Or Not ValueIsFilled(OwnerData.UseVariants)
			Or OwnerData.UseVariants = Enums.ItemVariantsUsageOptions.DontUse Then
			
			TechnicalCharacteristics = Object.Owner.GetObject();
			TechnicalCharacteristics.UseCharacteristics = True;
			TechnicalCharacteristics.UseVariants = Enums.ItemVariantsUsageOptions.CommonForItemKind;
			
		EndIf;
	EndIf;
	
	If Not TechnicalCharacteristics = Undefined Then
		TechnicalCharacteristics.DataExchange.Load = True;
		Try
			TechnicalCharacteristics.Write();
		Except
			WriteErrorToEventLog(TechnicalCharacteristics.Ref,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents);
		EndTry;
	EndIf;
	
	#EndRegion
	
	If Not ValueIsFilled(Object.Description) Then
		Object.Description = Object.DescriptionFull;
	EndIf;
EndProcedure


