Procedure OCR_Catalog_ProductsFromVendor_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	Owner = Catalogs.Partners.UnknownPartner;
	If XDTOData.KeyProperties.Property("Owner") 
		And ValueIsFilled(XDTOData.KeyProperties.Owner) Then
		
		Counterparty = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents,
							XDTOData.KeyProperties.Owner,
							DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Counterparties_Receive"), 
							"GetRef");
		
		If TypeOf(Counterparty) = Type("CatalogObject.Counterparties") Then
			Counterparty = Counterparty.Ref;
		EndIf;
		
		ReceivedData.AdditionalProperties.Insert("Counterparty", Counterparty);
							
		If ValueIsFilled(Counterparty) And Common.RefExists(Counterparty) Then
			Owner = CashServer.GetCounterpartyPartner(Counterparty);
		EndIf;
	EndIf; 
	
	ReceivedData.AdditionalProperties.Insert("Owner", Owner);
						
	If XDTOData.KeyProperties.Property("ProductPackaging") 
		And ValueIsFilled(XDTOData.KeyProperties.ProductPackaging) Then
		
		FillingRules = New Map;
		FillingRules.Insert("UnitOfMeasure", "UnitOfMeasure");
		FillingRules.Insert("ZoomRatio", "ZoomRatio");
		FillingRules.Insert("Description", "PackageName");
		PackageData = CollectionDataAsStructure(XDTOData.KeyProperties.ProductPackaging, FillingRules);
			
		ReceivedData.PackageName = PackageData.PackageName;
				
		If Not PackageData.Property("ZoomRatio") Or 
			(PackageData.Property("ZoomRatio") And Not ValueIsFilled(PackageData.ZoomRatio)) Then
			ReceivedData.NumberOfPackages = 1;
			ReceivedData.QuantityInBaseUnitOfMeasure = 1;
		ElsIf PackageData.Property("ZoomRatio") Then
			ReceivedData.NumberOfPackages = 1;
			ReceivedData.QuantityInBaseUnitOfMeasure = PackageData.ZoomRatio;	
		EndIf;
		
		If ValueIsFilled(PackageData.UnitOfMeasure) Then
			FillingRules = New Map;
			FillingRules.Insert("Code", "BaseUnitOfMeasureARCMUCode");
			FillingRules.Insert("Description", "BaseUnitOfMeasureDescription");
			DataOfUnit = CollectionDataAsStructure(PackageData.UnitOfMeasure, FillingRules);
		
			FillPropertyValues(ReceivedData, DataOfUnit);
		EndIf;
	EndIf;
EndProcedure
