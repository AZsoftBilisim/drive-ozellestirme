	EndIf;
	OCRNameBasisED = NameOfICOForDataObject(ExchangeComponents, ObjectReference, Undefined);
	
	ConversionRule = ExchangeComponents.ObjectsConversionRules.Find(OCRNameBasisED, "OCRName");
	
	If ConversionRule = Undefined
		Or Not ValueIsInCompositeTypeOfExchangeFormat("СоставнойОснованияЭлектронныхДокументов",
			ConversionRule.KeyPropertiesTypeOfXDTOObject, ExchangeComponents) Then // @Non-NLS-1
		
		ClearUsageOCR(UsageOCR);
		Return;
		
	EndIf;
	
EndProcedure


