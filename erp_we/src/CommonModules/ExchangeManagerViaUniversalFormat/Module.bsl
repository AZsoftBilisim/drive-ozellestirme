	|	MAX(T.CorrectiveDocumentServices_AmountOfVAT) AS CorrectiveDocumentServices_AmountOfVAT,
	|	MAX(T.CorrectionalDocumentServices_AmountWithVAT) AS CorrectionalDocumentServices_AmountWithVAT,
	|	MAX(T.DocumentServicesBeforeAdjustment_Quantity) AS DocumentServicesBeforeAdjustment_Quantity,
	|	MAX(T.DocumentSizeBeforeAdjustment_Amount) AS DocumentSizeBeforeAdjustment_Amount,
	|	MAX(T.DocumentServicesBeforeAdjustment_VATAmount) AS DocumentServicesBeforeAdjustment_VATAmount
	|INTO ResultOfComparisonOfTimeServices
	|FROM
	|	(SELECT
	|		ServicesOfCorrectedDocument.Products AS Products,
	|		ServicesOfCorrectedDocument.Content AS Content,
	|		ServicesOfCorrectedDocument.VATRate AS VATRate,
	|		ServicesOfCorrectedDocument.ExpenseItem AS ExpenseItem,
	|		ServicesOfCorrectedDocument.Count AS NumberOfDocumentsToBeCorrected__,
	|		ServicesOfCorrectedDocument.Sum AS ServicesOfDocumentBeingCorrected_Amount,
	|		ServicesOfCorrectedDocument.VATAmount AS ServicesOfDocumentBeingCorrected_AmountOfVAT,
	|		NULL AS CorrectionalDocumentServices_Number,
	|		NULL AS CorrectionalDocumentServices_Amount,
	|		NULL AS CorrectionalDocumentServices_AmountWithVAT,
	|		NULL AS CorrectiveDocumentServices_AmountOfVAT,
	|		NULL AS DocumentServicesBeforeAdjustment_Quantity,
	|		NULL AS DocumentSizeBeforeAdjustment_Amount,
	|		NULL AS DocumentServicesBeforeAdjustment_VATAmount
	|	FROM
	|		ServicesOfCorrectedDocument AS ServicesOfCorrectedDocument
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		CorrectionalDocumentServices.Products,
	|		CorrectionalDocumentServices.Content,
	|		CorrectionalDocumentServices.VATRate,
	|		CorrectionalDocumentServices.ExpenseItem,
	|		NULL,
	|		NULL,
	|		NULL,
	|		CorrectionalDocumentServices.Count,
	|		CorrectionalDocumentServices.Sum,
	|		CorrectionalDocumentServices.AmountIncludingVAT,
	|		CorrectionalDocumentServices.VATAmount,
	|		NULL,
	|		NULL,
	|		NULL
	|	FROM
	|		CorrectionalDocumentServices AS CorrectionalDocumentServices
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		DocumentServicesBeforeAdjustments.Products,
	|		DocumentServicesBeforeAdjustments.Content,
	|		DocumentServicesBeforeAdjustments.VATRate,
	|		DocumentServicesBeforeAdjustments.ExpenseItem,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		DocumentServicesBeforeAdjustments.Count,
	|		DocumentServicesBeforeAdjustments.Sum,
	|		DocumentServicesBeforeAdjustments.VATAmount
	|	FROM
	|		DocumentServicesBeforeAdjustments AS DocumentServicesBeforeAdjustments) AS T
	|
	|GROUP BY
	|	T.Products,
	|	T.Content,
	|	T.VATRate,
	|	T.ExpenseItem
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResultOfComparisonOfTimeServices.Products AS Products,
	|	ResultOfComparisonOfTimeServices.Content AS Content,
	|	ResultOfComparisonOfTimeServices.VATRate AS VATRate,
	|	ResultOfComparisonOfTimeServices.ExpenseItem AS ExpenseItem,
	|	ResultOfComparisonOfTimeServices.DocumentServicesBeforeAdjustment_Quantity AS QuantityBeforeAdjustment,
	|	ResultOfComparisonOfTimeServices.DocumentSizeBeforeAdjustment_Amount AS AmountBeforeAdjustment,
	|	ResultOfComparisonOfTimeServices.DocumentServicesBeforeAdjustment_VATAmount AS AmountOfVATBeforeAdjustment,
	|	ResultOfComparisonOfTimeServices.NumberOfDocumentsToBeCorrected__ AS QuantityBeforeChange_,
	|	ResultOfComparisonOfTimeServices.ServicesOfDocumentBeingCorrected_Amount AS AmountBeforeChange,
	|	ResultOfComparisonOfTimeServices.ServicesOfDocumentBeingCorrected_AmountOfVAT AS VATAmountBeforeChange,
	|	ResultOfComparisonOfTimeServices.CorrectionalDocumentServices_Number AS Count,
	|	ResultOfComparisonOfTimeServices.CorrectionalDocumentServices_Amount AS Sum,
	|	ResultOfComparisonOfTimeServices.CorrectiveDocumentServices_AmountOfVAT AS VATAmount,
	|	ResultOfComparisonOfTimeServices.CorrectionalDocumentServices_AmountWithVAT AS AmountIncludingVAT,
	|	CASE
	|		WHEN ISNULL(ResultOfComparisonOfTimeServices.ServicesOfDocumentBeingCorrected_Amount, ResultOfComparisonOfTimeServices.DocumentSizeBeforeAdjustment_Amount) IS NULL
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS ThereIsImplementationReceiptInDocument
	|INTO ResultOfServiceComparison
	|FROM
	|	ResultOfComparisonOfTimeServices AS ResultOfComparisonOfTimeServices
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	MappingResult.Products AS Products,
	|	MappingResult.Content AS Content,
	|	MappingResult.Content AS ContentBeforeChange,
	|	MappingResult.VATRate AS VATRate,
	|	MappingResult.VATRate AS VATRateBeforeChange,
	|	MappingResult.QuantityBeforeAdjustment AS QuantityBeforeAdjustment,
	|	MappingResult.AmountBeforeAdjustment AS AmountBeforeAdjustment,
	|	MappingResult.AmountOfVATBeforeAdjustment AS AmountOfVATBeforeAdjustment,
	|	MappingResult.QuantityBeforeChange_ AS QuantityBeforeChange_,
	|	MappingResult.AmountBeforeChange AS AmountBeforeChange,
	|	MappingResult.VATAmountBeforeChange AS VATAmountBeforeChange,
	|	MappingResult.Count AS Count,
	|	MappingResult.Sum AS Sum,
	|	MappingResult.VATAmount AS VATAmount,
	|	MappingResult.AmountIncludingVAT AS AmountIncludingVAT,
	|	CASE
	|		WHEN NOT(MappingResult.Count IS NULL
	|					OR MappingResult.Count = 0)
	|			THEN CAST(MappingResult.Sum / MappingResult.Count AS NUMBER(31, 2))
	|		ELSE 0
	|	END AS Price,
	|	CASE
	|		WHEN NOT(MappingResult.QuantityBeforeChange_ IS NULL
	|					OR MappingResult.QuantityBeforeChange_ = 0)
	|			THEN CAST(MappingResult.AmountBeforeChange / MappingResult.QuantityBeforeChange_ AS NUMBER(31, 2))
	|		ELSE 0
	|	END AS PriceBeforeChange,
	|	CASE
	|		WHEN NOT(MappingResult.QuantityBeforeAdjustment IS NULL
	|					OR MappingResult.QuantityBeforeAdjustment = 0)
	|			THEN CAST(MappingResult.AmountBeforeAdjustment / MappingResult.QuantityBeforeAdjustment AS NUMBER(31, 2))
	|		ELSE 0
	|	END AS PriceBeforeAdjustment,
	|	MappingResult.ExpenseItem AS ExpenseItem,
	|	MappingResult.ExpenseItem.OffsettingAccount AS CostAccount,
	|	MappingResult.ExpenseItem.OffsettingAccount AS CostAccountTa,
	|	MappingResult.ThereIsImplementationReceiptInDocument AS ThereIsImplementationReceiptInDocument,
	|	ISNULL(TTLineNumber.LineNumber, 0) AS DocumentRowNumber
	|FROM
	|	ResultOfServiceComparison AS MappingResult
	|		LEFT JOIN TTLineNumber AS TTLineNumber
	|		ON MappingResult.Products = TTLineNumber.Products
	|			AND MappingResult.Content = TTLineNumber.Content
	|
	|ORDER BY
	|	ThereIsImplementationReceiptInDocument DESC,
	|	ISNULL(TTLineNumber.LineNumber, 0)";
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		TextOfCCDRequestBeforeChange = "MappingResult.CCDNumber AS CCDNumberBeforeChange";
		TextOfRPTRequestBeforeChange = "MappingResult.QuantityByRNPTBeforeChange AS NumberOfRNPTBeforeChange";
		TextOfRPTRequestBeforeCorrection = "MappingResult.RnptQuantityBeforeAdjustment AS NumberOfRNPTBeforeAdjustment";
	Else
		TextOfCCDRequestBeforeChange = "MappingResult.CCDNumber.Code AS CCDNumberBeforeChange,
		|	MappingResult.CCDNumber.OriginCountry AS CountryOfOriginBeforeChange";
		TextOfRPTRequestBeforeChange = "UNDEFINED AS NumberOfRNPTBeforeChange";
		TextOfRPTRequestBeforeCorrection = "UNDEFINED AS NumberOfRNPTBeforeAdjustment";
	EndIf;
	QueryText = StrReplace(QueryText, "&TextOfCCDRequestBeforeChange", TextOfCCDRequestBeforeChange);
	QueryText = StrReplace(QueryText, "&TextOfRPTRequestBeforeChange", TextOfRPTRequestBeforeChange);
	QueryText = StrReplace(QueryText, "&TextOfRPTRequestBeforeCorrection", TextOfRPTRequestBeforeCorrection);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
	GetTextOfCharacteristicsRequest(ExchangeComponents, "MappingResult"));
	
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
	GetPackagingRequestText(ExchangeComponents, "MappingResult", False));
	
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
	GetSeriesRequestText(ExchangeComponents, "MappingResult"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
	GetTextOfCCDRequest(ExchangeComponents, "MappingResult"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
	GetTextOfRNPTRequest(ExchangeComponents, "MappingResult"));
	
	Query = New Query(QueryText);
	
	Query.SetParameter("DocumentBasis", IBData.DocumentBasis);
	Query.SetParameter("PointInTime",     IBData.PointInTime());
	Query.SetParameter("ReceiptOfServices",  TypeOf(IBData.DocumentBasis) = Type("DocumentRef.VendorInvoiceServicesAndAssets"));
	Query.SetParameter("Ref",            IBData.Ref);
	
	InternationalVersion = True;
	Query.SetParameter("InternationalVersion", InternationalVersion);
	
	QueryResults = Query.ExecuteBatch();
	
	PurchaseOrder = Undefined;
	XDTOData.Insert("Shipper");
	
	Selection = QueryResults[1].Select();
	If Selection.Next() Then
		XDTOData.Shipper = Selection.Shipper;
		PurchaseOrder             = Selection.PurchaseOrder;
	EndIf;
	
	DataSelection = QueryResults[6].Select();
	If DataSelection.Next()
		And ValueIsFilled(DataSelection.Ref) Then
		
		OCRName = NameOfICOForDataObject(ExchangeComponents, DataSelection.Ref, DataSelection.Ref.Organization);
		If OCRName <> ""  Then
			XDTOData.Insert("DocumentInflow", New Structure("Value, OCRName", DataSelection.Ref, OCRName));
		EndIf;
		
	EndIf;
	
	CorrectedDocumentIsAdjustmentOfReceipt = False;
	
	DataSelection = QueryResults[7].Select();
	If DataSelection.Next()
		And ValueIsFilled(DataSelection.Ref) Then
		
		CorrectedDocumentIsAdjustmentOfReceipt = (TypeOf(DataSelection.Ref) = Type("DocumentRef.PurchaseAdjustment"));
		
		OCRName = NameOfICOForDataObject(ExchangeComponents, DataSelection.Ref, DataSelection.Ref.Organization);
		If OCRName <> "" Then
			XDTOData.Insert("CorrectedReceiptDocument", New Structure("Value, OCRName", DataSelection.Ref, OCRName));
		EndIf;
		
	EndIf;
	
	If XDTOData.OperationKind = "AgreedChange"
		Or CorrectedDocumentIsAdjustmentOfReceipt Then
		XDTOData.Insert("RestoreVAT", True);
	Else
		XDTOData.Insert("RestoreVAT", False);
	EndIf;
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		
		CalculationsInConventionalUnits = False;
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = (IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> IBData.ARAPCurrency);
		EndIf;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = IBData.ARAPCurrency;
		DefaultParameters.TypeOfAgreement              = "WithVendor";
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", PurchaseOrder, IBData.Terms, IBData.SalesOpportunity);
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	GoodsTable = QueryResults[17].Unload();
	TableServices = QueryResults[23].Unload(); 
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsTable, True, True);
	If TypeOf(IBData.DocumentBasis) = Type("DocumentRef.SourceDocument") Then
		VATActivityType = IBData.DocumentBasis.VATTaxation;
	ElsIf Not ValueIsFilled(IBData.DocumentBasis) Then
		VATActivityType = Undefined;
	Else	
		VATActivityType = Common.ObjectAttributeValue(IBData.DocumentBasis, "PurchaseForActivity");
	EndIf;
	
	GoodsTable.Columns.Add("PurchaseForActivity");
	GoodsTable.FillValues(VATActivityType, "PurchaseForActivity");
	
	XDTOData.Insert("Sum", GoodsTable.Total("AmountIncludingVAT") + TableServices.Total("AmountIncludingVAT"));
		
	If GoodsTable.Count() > 0 Then
		XDTOData.Insert("Goods", GoodsTable);
	EndIf;
	
	If TableServices.Count() > 0 Then
		XDTOData.Insert("Services", TableServices);
	EndIf;
EndProcedure


