	EndIf;
	
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	#Region Goods
	
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
		
		ArrayOfRows = New Array;
		
		FillingRules = New Map;
		
		FillingRules.Insert("AdValoremExciseRate", "AdValoremExciseRate");
		FillingRules.Insert("NetWeightKg",         "NetWeightKg");
		FillingRules.Insert("AccountingRecordDate", "AccountingRecordDate");
		FillingRules.Insert("TaxInvoiceDate",   "TaxInvoiceDate");
		FillingRules.Insert("SupportingDocumentDate",            "SupportingDocumentDate");
		FillingRules.Insert("UnitOfMeasure",   "UnitOfMeasure");
		FillingRules.Insert("ExciseUnit", "ExciseUnit");
		FillingRules.Insert("PurchaseForActivity", "PurchaseForActivity");
		FillingRules.Insert("TransportKindCode",  "TransportKindCode");
		FillingRules.Insert("FEACNCode",           "FEACNCode");
		FillingRules.Insert("Count",         "Count");
		FillingRules.Insert("QuantityByFEACN",  "QuantityByFEACN");
		FillingRules.Insert("TaxBaseExcises","TaxBaseExcises");
		FillingRules.Insert("VATTaxBase",   "VATTaxBase");
		FillingRules.Insert("Products",       "Products");
		FillingRules.Insert("TaxInvoiceNumber",  "TaxInvoiceNumber");
		FillingRules.Insert("CCDNumber",           "CDNumber");
		FillingRules.Insert("SupportingDocumentSeriesNumber",      "SupportingDocumentSeriesNumber");
		FillingRules.Insert("VATRate",          "VATRate");
		FillingRules.Insert("FixedExciseDuty","FixedExciseDuty"); 
		FillingRules.Insert("ExciseTaxAmount",        "ExciseTaxAmount");
		FillingRules.Insert("TaxInvoicedPrice", "TaxInvoicedPrice");
		
		If FOValue("UseItemVariants", ExchangeComponents) Then
			FillingRules.Insert("Characteristic",     "Characteristic");
		EndIf;
		If FOValue("UseItemsBatch", ExchangeComponents) Then
			FillingRules.Insert("Series",              "Series");
		EndIf;
		
		For Each String In XDTOData.Goods Do
			
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If ValueIsFilled(String.Contract) Then
				
				OCRName = "Catalog_CounterpartyContracts_Receive";
				
				If TypeOf(String.Contract) = Type("Structure")
					And Not String.Contract.Property("Ref") Then
					OCRName = "Catalog_ContractsOfCounterparties_FromStructure__";
				EndIf;
				
				StringDataStructure.Insert("Contract", New Structure("Value, OCRName", String.Contract, OCRName));
				
			EndIf;
			
			If ValueIsFilled(String.DocumentInflow) Then
				
				OCRName = "Document_ReceiptOfGoodsServices_Receipt";
				
				StringDataStructure.Insert("DocumentInflow", New Structure("Value, OCRName", 
				String.DocumentInflow, OCRName));
			EndIf;
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			
			ArrayOfRows.Add(StringDataStructure);
			
		EndDo;
		
		If ArrayOfRows.Count() > 0 Then
			
			ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
			
		EndIf;
		
	EndIf;
	
	#EndRegion 
	
	#Region DocumentsInformation
	
	If XDTOData.Property("DocumentsInformation")
		And ValueIsFilled(XDTOData.DocumentsInformation) Then
		
		ArrayOfStringsInformationAboutDocuments = New Array;
		
		FillingRules = New Map;  
		
		FillingRules.Insert("Date",       "Date");
		FillingRules.Insert("Description",         "Description");
		FillingRules.Insert("Number",              "Number");
		
		For Each String In XDTOData.DocumentsInformation Do
			
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			ArrayOfStringsInformationAboutDocuments.Add(StringDataStructure);
			
		EndDo;
		
		If ArrayOfStringsInformationAboutDocuments.Count() > 0 Then
			
			ReceivedData.AdditionalProperties.Insert("DocumentsInformation", ArrayOfStringsInformationAboutDocuments);
			
		EndIf;
		
	EndIf;
	
	#EndRegion
	
	#Region Specifications
	
	If XDTOData.Property("Specifications")
		And ValueIsFilled(XDTOData.Specifications) Then
		
		ArrayOfSpecificationStrings = New Array;
		
		FillingRules = New Map; 
		
		FillingRules.Insert("SpecificationDate",       "SpecificationDate");
		FillingRules.Insert("SpecificationNumber",         "SpecificationNumber");
		
		For Each String In XDTOData.Specifications Do
		
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			ArrayOfSpecificationStrings.Add(StringDataStructure);
			
		EndDo;
		
		If ArrayOfSpecificationStrings.Count() > 0 Then
			
			ReceivedData.AdditionalProperties.Insert("Specifications", ArrayOfSpecificationStrings);
			
		EndIf;
		
	EndIf;
	
	#EndRegion
	
	#Region TransactionParties
	
	If XDTOData.Property("TransactionParties")
		And ValueIsFilled(XDTOData.TransactionParties) Then
		
		ArrayOfRowsParticipantsOfTransaction = New Array;
		
		FillingRules = New Map;
		
		FillingRules.Insert("ContractDate_",       "ContractDate_");
		FillingRules.Insert("SpecificationDate",         "SpecificationDate");
		FillingRules.Insert("ContractNumber",              "ContractNumber");
		FillingRules.Insert("SpecificationNumber",               "SpecificationNumber");
		FillingRules.Insert("Customer",           "Customer");
		FillingRules.Insert("Seller",          "Seller");
		FillingRules.Insert("CustomerRole", "BuyerSRoleByLine");
		FillingRules.Insert("SellerRole",       "RoleOfSellerByLine");
		
		For Each String In XDTOData.TransactionParties Do
		
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("BuyerSRoleByLine") 
				And ValueIsFilled(StringDataStructure.BuyerSRoleByLine) Then
				
				CustomerRole = TheValueOfTheEnumerationByName("SubjectsOfCivilLawRelations", 
					StringDataStructure.BuyerSRoleByLine);
					
				If CustomerRole <> Undefined Then
						
					StringDataStructure.Insert("CustomerRole", CustomerRole);
					
				EndIf;
				
			EndIf; 
			
			If StringDataStructure.Property("RoleOfSellerByLine") 
				And ValueIsFilled(StringDataStructure.RoleOfSellerByLine) Then
				
				SellerRole = TheValueOfTheEnumerationByName("SubjectsOfCivilLawRelations", 
					StringDataStructure.RoleOfSellerByLine);
				
				If SellerRole <> Undefined Then
					
					StringDataStructure.Insert("SellerRole", SellerRole);
					
				EndIf;
				
			EndIf;
			
			ArrayOfRowsParticipantsOfTransaction.Add(StringDataStructure);
			
		EndDo;
		
		If ArrayOfRowsParticipantsOfTransaction.Count() > 0 Then
			
			ReceivedData.AdditionalProperties.Insert("TransactionParties", ArrayOfRowsParticipantsOfTransaction);
			
		EndIf;
		
	EndIf;
	
	#EndRegion
EndProcedure
Procedure OCR_Document_ApplicationForImportationOfGoods_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
			ReceivedData.AdditionalProperties, ExchangeComponents);
	UseExcises = ExcisableGoodsAccounting.ImportOfExcisableItemsIsUsed(ReceivedData.Organization, ReceivedData.Date);
	For Each LineProducts_ In ReceivedData.Goods Do
		If ValueIsFilled(LineProducts_.VATTaxBase)
			And ValueIsFilled(LineProducts_.VATRate)
			And Not ValueIsFilled(LineProducts_.VATAmount) Then
			LineProducts_.VATAmount = VATAccountingERPClientServer.CalculateVATAmount(
			LineProducts_.VATTaxBase,
			VATAccountingERPClientServer.ValueOfVATRate(LineProducts_.VATRate),
			False);
			
		EndIf;  
		If ValueIsFilled(LineProducts_.ExciseTaxAmount) Then 
			UseExcises  = True;
		EndIf;
	EndDo;
	ReceivedData.UseExcises = UseExcises;
		
	If IBData = Undefined Then
		Return;
	EndIf;
	
	FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
	KeyFieldsArray = New Array;
	
	KeyFieldsArray.Add("Products");
	KeyFieldsArray.Add("FEACNCode");
	KeyFieldsArray.Add("Count");
	KeyFieldsArray.Add("UnitOfMeasure");
	KeyFieldsArray.Add("QuantityByFEACN");
	KeyFieldsArray.Add("TaxInvoicedPrice");
	KeyFieldsArray.Add("SupportingDocumentSeriesNumber");
	KeyFieldsArray.Add("SupportingDocumentDate");
	KeyFieldsArray.Add("TaxInvoiceNumber");
	KeyFieldsArray.Add("TaxInvoiceDate");
	KeyFieldsArray.Add("AccountingRecordDate");
	KeyFieldsArray.Add("VATTaxBase");
	KeyFieldsArray.Add("VATRate");
	KeyFieldsArray.Add("DocumentInflow");
	KeyFieldsArray.Add("CDNumber");
	
	ColumnsToExclude1 = "ItemsLocationAttributes, Currency, PartnerProducts, Department,
		|StatValueUSDollars, Warehouse, VATAmount, Content, Contract";
	
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.21") Then
		
		ColumnsToExclude1 = ColumnsToExclude1 + ", AdValoremExciseRate, PurchaseForActivity, ExciseUnit";
		
	EndIf;
	
	FillObjectTabularSectionWithInitialData(ReceivedData.Goods, IBData.Goods,
		KeyFieldsArray, ColumnsToExclude1);
	
	IBData.Goods.Load(ReceivedData.Goods.Unload());
	
	If ValueIsFilled(ReceivedData.TransactionParties) Then
		IBData.TransactionParties.Load(ReceivedData.TransactionParties.Unload());
	EndIf;
	
	If ValueIsFilled(ReceivedData.Specifications) Then
		IBData.Specifications.Load(ReceivedData.Specifications.Unload());
	EndIf;
	
	If ValueIsFilled(ReceivedData.DocumentsInformation) Then
		IBData.DocumentsInformation.Load(ReceivedData.DocumentsInformation.Unload());
	EndIf;
	
	ReceivedData = Undefined;
EndProcedure

