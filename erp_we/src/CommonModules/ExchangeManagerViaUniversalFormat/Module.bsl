Procedure OCR_Document_CustomsDeclaration_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_CustomsDeclaration_Shipment", 
										"Sections", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf; 
								 
	UnloadDivision(IBData, XDTOData);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	// These document headers are necessary for calculating
	// the exchange rate and the multiplicity of settlements.
	DocumentHeader = 
		"SELECT
		|	DocumentHeaderData.Currency,
		|	DocumentHeaderData.ARAPCurrency
		|INTO DocumentHeaderData
		|FROM
		|	Document.CCDImport AS DocumentHeaderData
		|WHERE
		|	DocumentHeaderData.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
		|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
		|FROM
		|	DocumentHeaderData AS DocumentHeaderData
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
		|				&Date,
		|				Currency IN
		|					(SELECT
		|						Doc.ARAPCurrency
		|					FROM
		|						DocumentHeaderData AS Doc)
		|				AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
		|		ON DocumentHeaderData.ARAPCurrency = DocumentExchangeRate.Currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////";
	Query = New Query;
	Query.Text = DocumentHeader;
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	Selection = Query.Execute().Select();
	Selection.Next();
	XDTOData.Insert("TransactionRate", Selection.TransactionRate);
	XDTOData.Insert("Multiplier_", Selection.Multiplier_);
	XDTOData.Insert("DocumentCourse", Selection.TransactionRate);
	XDTOData.Insert("DocumentMultiplicity", Selection.Multiplier_);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
		
		Rule6 = ExchangeComponents.DataProcessingRules.Find("Catalog_CounterpartyContracts_Send", "Name");
		If Not Rule6 = Undefined Then
			DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, 
				IBData.Contract, 
				Rule6);
		EndIf;
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty = IBData.Counterparty;
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.ARAPCurrency = IBData.ARAPCurrency;
		DefaultParameters.TypeOfAgreement = "Other";
		DefaultParameters.Date = IBData.Date;
		DefaultParameters.Number = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = False;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", Undefined, IBData.Terms, Undefined);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
	EndIf;
	
	// Table parts
	QueryText =
		"SELECT
		|	TheseProducts.SectionNumber AS SectionNumber,
		|	TheseProducts.Products AS Products,
		|	&QueryTextCharacteristic,
		|	TheseProducts.DocumentInflow AS DocumentInflow,
		|	TheseProducts.Count AS Count,
		|	TheseProducts.CustomsValue AS CustomsValue,
		|	TheseProducts.VATAmount AS VATAmount,
		|	TheseProducts.DutyAmount AS DutyAmount,
		|	TheseProducts.OriginCountry AS OriginCountry,
		|	TheseProducts.ExciseTaxAmount AS ExciseTaxAmount,
		|	&QueryTextSeries,
		|	&QueryTextPackage
		|FROM
		|	Document.CCDImport.Goods AS TheseProducts
		|WHERE
		|	TheseProducts.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TheseSections.SectionNumber AS SectionNumber,
		|	TheseSections.CustomsValue AS CustomsValue,
		|	TheseSections.VATRate AS VATRate,
		|	TheseSections.VATAmount AS VATAmount,
		|	CAST(TheseSections.DutyRate AS NUMBER(10, 2)) AS DutyRate,
		|	TheseSections.DutyAmount AS DutyAmount
		|FROM
		|	Document.CCDImport.Sections AS TheseSections
		|WHERE
		|	TheseSections.Ref = &Ref";
	
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "TheseProducts"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "TheseProducts"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "TheseProducts"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	
	Selection = Query.ExecuteBatch();
	
	Goods = Selection[0].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("Goods", Goods); 
	Sections = Selection[1].Unload(); 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Sections, False);
	EndIf;
	XDTOData.Insert("Sections", Sections);
EndProcedure


