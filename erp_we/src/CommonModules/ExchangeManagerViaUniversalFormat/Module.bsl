Procedure DPR_Catalog_DocumentsPersons_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	PropertiesSelection_1 = XDTOData;
	
	If XDTOData.Property("KeyProperties") Then
		PropertiesSelection_1 = XDTOData.KeyProperties;
	EndIf;
	
	IndividualSelection = Undefined;
	DocumentTypeSelection   = Undefined;
	PeriodFilter         = Undefined;
	
	PropertiesSelection_1.Property("IndividualSelection", IndividualSelection);
	PropertiesSelection_1.Property("DocumentTypeSelection",   DocumentTypeSelection);
	PropertiesSelection_1.Property("PeriodFilter",         PeriodFilter);
	
	ConversionRuleIndividuals = DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Persons_Receive");
	RuleOfConversionTypesOfDocuments = DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_DocumentKindsOfPersons");
	
	PLDocuments = InformationRegisters.DocumentsPersons.CreateRecordSet();
	PLDocuments.AdditionalProperties.Insert("DisableObjectChangeRecordMechanism", True);
	If ValueIsFilled(IndividualSelection) Then
		PLDocuments.Filter.Person.Set(DataExchangeXDTOServer.XDTOObjectStructureToIBData(
			ExchangeComponents, IndividualSelection, ConversionRuleIndividuals, "GetRef").Ref);
	EndIf;
	If ValueIsFilled(DocumentTypeSelection) Then
		PLDocuments.Filter.DocumentKind.Set(DataExchangeXDTOServer.XDTOObjectStructureToIBData(
			ExchangeComponents, DocumentTypeSelection, RuleOfConversionTypesOfDocuments, "GetRef").Ref);
	EndIf;
	If ValueIsFilled(PeriodFilter) Then
		PLDocuments.Filter.Period.Set(PeriodFilter);
	EndIf;
	
	If Not ValueIsFilled(PLDocuments.Filter.Person.Value) Then
		Return;
	EndIf;
	
	If XDTOData.Property("Records")
		And ValueIsFilled(XDTOData.Records) Then
	
		For Each RecordRow In XDTOData.Records Do
			RecordFLDocuments = PLDocuments.Add();
			
			If Not ValueIsFilled(PLDocuments.Filter.Person.Value) Then
				RecordFLDocuments.Person = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
					ExchangeComponents, RecordRow.Individual, ConversionRuleIndividuals, "GetRef").Ref;
			Else
				RecordFLDocuments.Person = PLDocuments.Filter.Person.Value;
			EndIf;
			
			If Not ValueIsFilled(PLDocuments.Filter.DocumentKind.Value) Then
				RecordFLDocuments.DocumentKind = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
					ExchangeComponents, RecordRow.DocumentKind, RuleOfConversionTypesOfDocuments, "GetRef").Ref;
			Else
				RecordFLDocuments.DocumentKind = PLDocuments.Filter.DocumentKind.Value;
			EndIf;
			
			If Not ValueIsFilled(PLDocuments.Filter.Period.Value) Then
				RecordFLDocuments.Period = RecordRow.Period;
			Else
				RecordFLDocuments.Period = PLDocuments.Filter.Period.Value;
			EndIf;
			
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
				RecordFLDocuments.ThisIsAnIdentityDocument = RecordRow.IsIdentityDocument;
			Else
				RecordFLDocuments.ThisIsAnIdentityDocument = True;
			EndIf;
			
			FillPropertyValues(RecordFLDocuments, RecordRow, "Series, Number, DateOfIssue1, ValidityPeriod, IssuedBy, BusinessUnitCode, Presentation");
			
		EndDo;
		
	EndIf;
	
	PLDocuments.DataExchange.Load = True;
	PLDocuments.Write(True);
EndProcedure


