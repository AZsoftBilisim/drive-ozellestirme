Procedure OCR_Document_SBDsSettlementsWithCounterparties_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	ConvertNumberToFormat11(ExchangeComponents, IBData, XDTOData);
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_SBDSSettlementsWithCounterparties_Sending", 
										"ARAPDetails", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	
	IBDivision = IBData["Department"];
	If ValueIsFilled(IBDivision) Then
		UnloadDivision(IBData, XDTOData, IBDivision, "Department");
	Else
		UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "BankAccount");
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany Then
		
		CounterpartyData = GetCounterpartyDataForOrganizationSBankAccount(IBData.BankAccountBeneficiary, ExchangeComponents);
		XDTOData.Insert("Counterparty",     CounterpartyData.Counterparty);
		XDTOData.Insert("BankAccount", CounterpartyData.CounterpartyBankAccount);
	
		CounterpartyRef = CounterpartyData.Counterparty;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundAcquiringPayment	Then
		CounterpartyRef = ?(ValueIsFilled(IBData.Counterparty), IBData.Counterparty, Catalogs.Counterparties.EmptyRef());
		XDTOData.Insert("Counterparty",      CounterpartyRef);
		XDTOData.Insert("BankAccount",  IBData.CounterpartyBankAccount);
	Else
		
		CounterpartyRef = ?(ValueIsFilled(IBData.Counterparty), IBData.Counterparty, Catalogs.Counterparties.EmptyRef());
		XDTOData.Insert("BankAccount", IBData.CounterpartyBankAccount);
		XDTOData.Insert("Counterparty",     CounterpartyRef);
	
	EndIf;
	
	FillInDataOfIncomingSBDsDocument(IBData, XDTOData);
	
	HeaderData_ = IBData.AdditionalProperties.HeaderData_;
	XDTOData.Insert("ARAPType", HeaderData_.ARAPType);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7")
		And ValueIsFilled(IBData.PaymentRequest) Then
		XDTOData.Insert("RequestForSpendingFunds", IBData.PaymentRequest);
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.RefundAcquiringPayment	Then 
		ARAPDetails = New ValueTable;
		ARAPDetails.Columns.Add("Contract");
		ARAPDetails.Columns.Add("DocumentOfARAPAccounting");
		ARAPDetails.Columns.Add("Sum");
		ARAPDetails.Columns.Add("ARAPCurrency");  
		NewRow = ARAPDetails.Add();
		NewRow.Sum = IBData.DocumentAmount;
		NewRow.ARAPCurrency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization); 
		NewRow.Contract = IBData.Contract;
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
			RedefineVATRateForOldFormats(ARAPDetails, False);
		EndIf; 
		XDTOData.Insert("ARAPDetails", ARAPDetails);
	Else
		UploadDecryptionCounterparties_DebitingCash(IBData, XDTOData, CounterpartyRef, ExchangeComponents);
		//++ NOT TM
	
	
		//-- DON'T TM
	EndIf;
EndProcedure


