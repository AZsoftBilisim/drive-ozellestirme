Procedure OCR_Document_VZ_DebtorOrganization__OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	ThisIsNettingOfTwoOrganizations = IBData.AdditionalProperties.Property("NettingInvolvingTwoOrganizations");
		
	If ThisIsNettingOfTwoOrganizations Then
		LinkOrganization = IBData.CompanyCreditor;
		LinkDebtor     = IBData.Organization;
		LinkLender    = IBData.Creditor;
		OperationKind       = "CarryingOutNetting";
	Else
		LinkOrganization = IBData.CounterpartyDebtor;
		LinkDebtor     = IBData.Creditor;
		LinkLender    = IBData.Organization;
		OperationKind       = "DebtTransfer_";
	EndIf;
	
	Prefix = "AD";
	
	If ExportStack.Count() > 1 Then
		XDTOData.Insert("Date", IBData.Date);
		XDTOData.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 8));
		XDTOData.Insert("Organization", LinkOrganization);
		Return;
	EndIf;
	
	XDTOData.Insert("OperationKind", OperationKind);
	
	XDTOData.KeyProperties.Insert("Date", IBData.Date);
	XDTOData.KeyProperties.Insert("Number", Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 8));
	XDTOData.KeyProperties.Insert("Organization", LinkOrganization);
	
	If ValueIsFilled(IBData.Comment) Then
		XDTOData.Insert("Comment", IBData.Comment);
	EndIf;
	 
	If ValueIsFilled(IBData.EmployeeResponsible) Then
		XDTOData.Insert("EmployeeResponsible", IBData.EmployeeResponsible);	
	EndIf;  
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	XDTOData.Insert("Currency", CurrencyOfComplianceAccounting);
	UnloadCourseAndMultiplicityOfDocument(XDTOData, CurrencyOfComplianceAccounting, IBData.Date, IBData.Organization);
	
	AmountOfAccountsReceivable  = IBData.AccountsReceivable.Total("SumCompl");
	AmountOfAccountsPayable = IBData.AccountsPayable.Total("SumCompl");
	XDTOData.Insert("AmountOfAccountsReceivable", AmountOfAccountsReceivable);
	XDTOData.Insert("AmountOfAccountsPayable", AmountOfAccountsPayable);
	
	UnloadDivision(IBData, XDTOData);
	
	If TypeOf(LinkLender) = Type("CatalogRef.Companies") Then
		LinkToCounterparty = CounterpartyFromOrganization(LinkLender, ExchangeComponents);
		XDTOData.Insert("Creditor", LinkToCounterparty);
	Else
		XDTOData.Insert("Creditor", LinkLender);
	EndIf;
	
	If TypeOf(LinkDebtor) = Type("CatalogRef.Companies") Then
		LinkToCounterparty = CounterpartyFromOrganization(LinkDebtor, ExchangeComponents);
		XDTOData.Insert("CounterpartyDebtor", LinkToCounterparty);
	Else
		XDTOData.Insert("CounterpartyDebtor", LinkDebtor);
	EndIf;
	
	AccountsPayable = UnloadDebtTable(
		?(ThisIsNettingOfTwoOrganizations, "AccountsPayable", "AccountsReceivable"),
		IBData.Ref,
		XDTOData.Creditor,
		LinkOrganization,
		?(ThisIsNettingOfTwoOrganizations, Undefined, LinkLender),
		ExchangeComponents);
	XDTOData.Insert("AccountsPayable", AccountsPayable);
	
	DefaultParameters = New Structure(ContractFixedKeyStructure());
	DefaultParameters.Organization              = LinkOrganization;
	DefaultParameters.ARAPCurrency     = CurrencyOfComplianceAccounting;
	DefaultParameters.CalculationsInConventionalUnits = False;
	DefaultParameters.TypeOfAgreement              = "Other"; 
	DefaultParameters.Counterparty               = XDTOData.CounterpartyDebtor;
	
	If ThisIsNettingOfTwoOrganizations Then
		DefaultParameters.TypeOfAgreement = TypeOfContractForIntercampanySettlementObject(LinkOrganization,
			IBData.ARAPObjectIntercompany, "WithCustomer");
	EndIf;
	
	AccountsReceivable = New ValueTable;
	AccountsReceivable.Columns.Add("Contract");
	AccountsReceivable.Columns.Add("Multiplier_");
	AccountsReceivable.Columns.Add("TransactionRate");
	AccountsReceivable.Columns.Add("Sum");
	AccountsReceivable.Columns.Add("AmountARAP");
	AccountsReceivable.Columns.Add("ARAPType");
	
	AccountsReceivableLine = AccountsReceivable.Add();
	AccountsReceivableLine.Multiplier_ = 1;
	AccountsReceivableLine.TransactionRate = 1;
	AccountsReceivableLine.Sum = AmountOfAccountsReceivable;
	AccountsReceivableLine.AmountARAP = AmountOfAccountsReceivable;
	AccountsReceivableLine.Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents);
	If IBData.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient Then
		AccountsReceivableLine.ARAPType = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
	Else
		AccountsReceivableLine.ARAPType = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting;
	EndIf;
	
	XDTOData.Insert("AccountsReceivable", AccountsReceivable);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

