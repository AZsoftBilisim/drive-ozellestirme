EndProcedure
Procedure DPR_Document_BankAccountIssue_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
		
	HeaderData_       = New Structure;
	TypeOfOperationOther = "";
	ARAPType       = "";
	OperationWithSelfEmployedPerson = False;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
	          
		OperationWithSelfEmployedPerson = IBData.OperationWithSelfEmployedPerson;	          
	          
	EndIf; 
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		
		UsageOCR.Document_SBDSCurrencyConversion_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashToAnotherAccount Then
		
		UsageOCR.Document_SBDSTransferToAnotherAccount_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentByPayrollCardProgram Then
		
		UsageOCR.Document_SBDSPayrollTransfer_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentToBankAccounts Then
		
		UsageOCR.Document_SBDSTransferringPOToEmployee_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfTaxesAndContributions Then
		
		UsageOCR.Document_SBDSPaymentsToBudget_Sending = True;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CustomsPayment Then
		
		UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "Other";
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
		
		TypeOfOperationOther = "InternalTransfer";
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherExpenses 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue Then
		
		// Household. The operation Other expenses will no longer be used. Left for a transitional period.
		// Other expenses are reflected by the type of operation of other monetary funds.
		TypeOfOperationOther = "OtherWriteOffs";
		For Each TSRow In IBData.ARAPDetails Do
			
			// If the expense item is filled in, then it is a different expense.
			If ValueIsFilled(TSRow.ExpenseItem)
				And TypeOf(TSRow.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
				
				UsageOCR.Document_SBDSOtherExpenses_Sending = True;
				// When the operation is performed, the type of operation should not be filled in any more.
				TypeOfOperationOther = "";
				Break;
				
			EndIf;
			
		EndDo;
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToVendor
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.DeletePaymentToSelfEmployedPerson Then
	
		ARAPType = "WithVendor";
	    
	    If Not OperationWithSelfEmployedPerson Then 
	    	UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;      
	    Else
	    	UsageOCR.Document_SBDSSettlementsWithSelfEmployed_Sending = True;	 
	    EndIf; 
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany Then
		UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "WithCustomer";
	
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.15")
		And ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation) Then
	  	UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "LoansAndBorrowings";
	
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15")
		And IBData.BusinessOperation = Enums.BusinessTransactions.RefundAcquiringPayment Then
	    UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "WithCustomer";
		
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15")
		And ThisIsBusinessTransactionCreditSettlements(IBData.BusinessOperation) Then  
		UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "CounterpartyCredit";
		
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15")
		And ThisIsBusinessTransactionLoanSettlements(IBData.BusinessOperation) Then
		UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "LoanToCounterparty";
			
	ElsIf ThisIsBusinessOperationSettlementOfDeposits(IBData.BusinessOperation) Then  
		UsageOCR.Document_SBDSTransferToDeposit_Sending = True;
	ElsIf ThisIsBusinessTransactionRevaluationOfFinancialInstruments(IBData.BusinessOperation) Then
		TypeOfOperationOther = "OtherWriteOffs";
		
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PaymentToLessor Then
	
		UsageOCR.Document_SBDSSettlementsWithCounterparties_Sending = True;
		ARAPType = "Other";
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder Then
		If IBData.PersonsList = True Then
			UsageOCR.Document_SBDSOtherWriteOff_Sending = True;
			ARAPType = "Subreport";
			TypeOfOperationOther = "OtherWriteOffs";
		Else
			UsageOCR.Document_SBDSSettlementsWithEmployees_Sending = True;
			ARAPType = "Subreport";
		EndIf;
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee Then
	
		UsageOCR.Document_SBDSSettlementsWithEmployees_Sending = True;
		ARAPType = "Loans_";
	
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.WithdrawalFromBankAccount Then
		UsageOCR.Document_SBDSCashWithdrawal_Sending = True;
	EndIf;
	
	If ValueIsFilled(TypeOfOperationOther) Then
	
		HeaderData_.Insert("TypeOfOperationOther", TypeOfOperationOther);
		UsageOCR.Document_SBDSOtherWriteOff_Sending = True;
	
	EndIf;
	
	If ValueIsFilled(ARAPType) Then
		
		HeaderData_.Insert("ARAPType", ARAPType);
		
	EndIf;
	
	IBData.AdditionalProperties.Insert("HeaderData_", HeaderData_);
EndProcedure

