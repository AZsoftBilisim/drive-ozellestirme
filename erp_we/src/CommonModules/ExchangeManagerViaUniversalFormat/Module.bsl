Procedure PCO_Document_RCOSalaryPayment_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "ChiefAccountant");
	UploadResponsiblePerson_(ReceivedData, XDTOData, ExchangeComponents, "Director");
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	ArrayOfPayoutLines         = New Array;
	ArrayOfDecryptionStrings     = New Array;
	FirstFilledInCFItem = Undefined;
	For Each String In XDTOData.ARAPDetails Do
		If ValueIsFilled(String.Employee) Then
			StringDataStructure = New Structure("Individual,Sum");
			StringDataStructure.Individual = String.Employee;
			StringDataStructure.Sum = String.Sum;
			
			ArrayOfPayoutLines.Add(StringDataStructure);
		EndIf;
		
		DetailsStructure2 = New Structure("Sum,CashFlowItem,AmountARAP");
		DetailsStructure2.CashFlowItem = String.CFItem;
		DetailsStructure2.Sum = String.Sum;
		DetailsStructure2.AmountARAP = String.Sum;
		ArrayOfDecryptionStrings.Add(DetailsStructure2);
		
		If FirstFilledInCFItem = Undefined And ValueIsFilled(String.CFItem) Then
			FirstFilledInCFItem = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
				ExchangeComponents,
				String.CFItem,
				DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_CFItems"),
				"GetRef");
		EndIf;
		
		If ValueIsFilled(String.PaysheetNumber) And Not ValueIsFilled(ReceivedData.PaysheetNumber) Then
			ReceivedData.PaysheetNumber = String.PaysheetNumber;
		EndIf;
		If ValueIsFilled(String.PaysheetDate) And Not ValueIsFilled(ReceivedData.PaysheetDate) Then
		    ReceivedData.PaysheetDate = String.PaysheetDate;
		EndIf;
			
	EndDo;
	
	
	#Region Header
	
	ReceivedData.Posted = True;
	
	// BusinessOperation
	If ArrayOfPayoutLines.Count() = 1 Then
	
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentToEmployee;
		ReceivedData.AdvanceHolder = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
					ExchangeComponents,
					ArrayOfPayoutLines[0].Individual,
					DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Persons_Receive"),
					"GetRef");
		
	Else
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentViaCashAccount;
	EndIf;
	
	// CFItem
