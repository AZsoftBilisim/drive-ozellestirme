	AddPCR(PropertiesOfTS, "AmountARAP",    "", 1);
	AddPCR(PropertiesOfTS, "VATAmount",               "", 1);
	AddPCR(PropertiesOfTS, "AmountVATARAP", "", 1);
	AddPCR(PropertiesOfTS, "AmountIncludingVAT",              "", 1);
	AddPCR(PropertiesOfTS, "Package",               "", 1, "Catalog_Packages");
	AddPCR(PropertiesOfTS, "Characteristic",         "", 1, "Catalog_ItemsCharacteristics");
	AddPCR(PropertiesOfTS, "Price",                   "", 1);
	
