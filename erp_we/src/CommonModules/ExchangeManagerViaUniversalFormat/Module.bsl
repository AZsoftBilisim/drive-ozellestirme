Procedure ProcessUploadedAdditionalBankingDetailsAndInformation(ExchangeComponents)
	AddlAttributesAndInfo = ExchangeComponents.ConversionParameters_SSLy.UploadedAdditionalBankingDetailsAndInformation;
	If AddlAttributesAndInfo.Count() = 0 Then
		Return;
	EndIf;
	MatchingObjectTypeAndSet = New Map;
	PredefinedItemsNames = Metadata.Catalogs.AdditionalAttributesAndInfoSets.GetPredefinedNames();
	For Each AdditionalAttributesRow In AddlAttributesAndInfo Do
		// Getting a set of additional details.
		SetOfAdditionalBankingDetails = MatchingObjectTypeAndSet.Get(AdditionalAttributesRow.ObjectType);
		If SetOfAdditionalBankingDetails = Catalogs.AdditionalAttributesAndInfoSets.EmptyRef() Then
			// In previous iterations, it was not possible to find a set of additional details.
			Continue;
		ElsIf SetOfAdditionalBankingDetails = Undefined Then
			// The search for the set has not been performed yet.
			// Stage 1 - direct search.
			PredefinedItemName1 = StrReplace(AdditionalAttributesRow.ObjectType, ".", "_");
			If PredefinedItemsNames.Find(PredefinedItemName1) <> Undefined Then
				SetOfAdditionalBankingDetails = PropertyManager.PropertiesSetByName(PredefinedItemName1);
				If SetOfAdditionalBankingDetails.IsFolder Then
					SetOfAdditionalBankingDetails = Undefined;
				EndIf;
			EndIf;
			// Stage 2 - search for a common element.
			If SetOfAdditionalBankingDetails = Undefined Then
				PredefinedItemName1 = PredefinedItemName1 + "_Overall";
				If PredefinedItemsNames.Find(PredefinedItemName1) <> Undefined Then
					SetOfAdditionalBankingDetails = PropertyManager.PropertiesSetByName(PredefinedItemName1);
					If SetOfAdditionalBankingDetails.IsFolder Then
						SetOfAdditionalBankingDetails = Undefined;
					EndIf;
				EndIf;
			EndIf;
			// Stage 3 - search by name.
			If SetOfAdditionalBankingDetails = Undefined Then
				ObjectTypeName = Right(AdditionalAttributesRow.ObjectType, StrLen(AdditionalAttributesRow.ObjectType) - Find(AdditionalAttributesRow.ObjectType, "."));
				Query = New Query;
				Query.Text = "SELECT TOP 1 Ref
				|FROM Catalog.AdditionalAttributesAndInfoSets
				|WHERE IsFolder = FALSE AND Description LIKE &NameSearch_";
				Query.SetParameter("NameSearch_", "%"+ObjectTypeName+"%");
				Selection = Query.Execute().Select();
				If Selection.Next() Then
					SetOfAdditionalBankingDetails = Selection.Ref;
				EndIf;
			EndIf;
			If SetOfAdditionalBankingDetails = Undefined Then
				MatchingObjectTypeAndSet.Insert(AdditionalAttributesRow.ObjectType, Catalogs.AdditionalAttributesAndInfoSets.EmptyRef());
				Continue;
			Else
				MatchingObjectTypeAndSet.Insert(AdditionalAttributesRow.ObjectType, SetOfAdditionalBankingDetails);
			EndIf;
		EndIf; 
		// Converting a property from an XDTO to a reference.
		LinkProperty = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents, 
							AdditionalAttributesRow.Property, 
							DataExchangeXDTOServer.OCRByName(ExchangeComponents,"Catalog_AdditionalAttributes"),
							"GetRef").Ref;
		If Not ValueIsFilled(LinkProperty) Then
			// It is possible at the stage of data analysis, when the data has not yet been uploaded to the IB.					
			Continue;
		EndIf;
		// Checking the property type.
		If ValueIsFilled(AdditionalAttributesRow.ValueType) Then
			PropertyValueType1 = Common.ObjectAttributeValue(LinkProperty, "ValueType");
			WhatValuesAreUsed = Common.ObjectAttributeValue(LinkProperty, "AdditionalValuesUsed");
			ExcludeTypicalValues = False;
	
			// For a new default property, the type "Values of properties of objects" can be automatically set.
			// It should be reset if this type does not match the value type.
			If PropertyValueType1 <> Undefined 
				// A sign of the "legitimately" established type of "Values of the properties of objects".
				And Not WhatValuesAreUsed 
				And PropertyValueType1.ContainsType(Type("CatalogRef.ObjectsPropertiesValues")) Then
				If AdditionalAttributesRow.ValueType = Type("CatalogRef.ObjectsPropertiesValues") Then
					ObjectProperty = LinkProperty.GetObject();
					ObjectProperty.AdditionalValuesUsed = True;
					ObjectProperty.DataExchange.Load = True;
					ObjectProperty.Write();
					Continue;
				Else
					If PropertyValueType1.Types().Count() = 1 Then
						PropertyValueType1 = Undefined;
					Else
						ExcludeTypicalValues = True;
					EndIf;
					
				EndIf;
			EndIf;
			If (PropertyValueType1 = Undefined) 
				Or Not PropertyValueType1.ContainsType(AdditionalAttributesRow.ValueType) Then
				// The property type should be supplemented.
				ObjectProperty = LinkProperty.GetObject();
				TypesArray = New Array;
				If Not AdditionalAttributesRow.ValueType = Type("Undefined") Then
					TypesArray.Add(AdditionalAttributesRow.ValueType);
				EndIf;
				If AdditionalAttributesRow.ValueType = Type("CatalogRef.ObjectsPropertiesValues") Then
					ObjectProperty.AdditionalValuesUsed = True;
				EndIf;
				If PropertyValueType1 <> Undefined 
					And PropertyValueType1.Types().Count() > 0 Then
					// Composite type.
					For Each CurType In PropertyValueType1.Types() Do
						If ExcludeTypicalValues And CurType = Type("CatalogRef.ObjectsPropertiesValues") Then
							Continue;
						EndIf;
						TypesArray.Add(CurType);
					EndDo;
				EndIf;
				If TypesArray.Count() > 0 Then
					ObjectProperty.ValueType = New TypeDescription(TypesArray);
					ObjectProperty.DataExchange.Load = True;
					ObjectProperty.Write();
				EndIf;
			EndIf;
		EndIf;
		// Checking the presence of additional props or additional information in the set.
		TabSectionName = ?(AdditionalAttributesRow.ThisIsAdditionalSummary, "AdditionalInfo", "AdditionalAttributes");
		If SetOfAdditionalBankingDetails[TabSectionName].Find(LinkProperty, "Property") <> Undefined Then
			Continue;
		EndIf;
		If TypeOf(SetOfAdditionalBankingDetails) = Type("CatalogRef.AdditionalAttributesAndInfoSets") Then
			// The set has not changed yet. Getting an object and placing it in accordance.
			SetOfAdditionalItemDetails = SetOfAdditionalBankingDetails.GetObject();
			MatchingObjectTypeAndSet.Insert(AdditionalAttributesRow.ObjectType, SetOfAdditionalItemDetails); 
		Else
			SetOfAdditionalItemDetails = SetOfAdditionalBankingDetails;
		EndIf;
		SetOfAdditionalItemDetails.DataExchange.Load = True;
		TabularSection = SetOfAdditionalItemDetails[TabSectionName]; // TabularSection
		TSRow = TabularSection.Add();
		TSRow.Property = LinkProperty;	
	EndDo;
	// Recording modified sets.
	For Each SetMatchingElement In MatchingObjectTypeAndSet Do
		If TypeOf(SetMatchingElement.Value) = Type("CatalogObject.AdditionalAttributesAndInfoSets") Then
			SetOfAdditionalItemDetails = SetMatchingElement.Value;
			SetOfAdditionalItemDetails.AttributesCount = Format(SetOfAdditionalItemDetails.AdditionalAttributes.FindRows(
				New Structure("DeletionMark", False)).Count(), "NG=");
			
			SetOfAdditionalItemDetails.InfoCount   = Format(SetOfAdditionalItemDetails.AdditionalInfo.FindRows(
				New Structure("DeletionMark", False)).Count(), "NG=");
			SetOfAdditionalItemDetails.Write();
		EndIf;
	EndDo;
EndProcedure
Procedure ProcessUploadedArticlesDDSIKBusinessTransactions(ExchangeComponents)
	ArticlesOfDDSIBusinessTransaction = ExchangeComponents.ConversionParameters_SSLy.UploadedArticlesByDDSIKBusinessTransactions;
	ArticlesOfDDSIBusinessTransaction.GroupBy("CFItem, BusinessTransaction");
	ArticlesOfDDSIBusinessTransaction.Sort("CFItem");
	
	ArticleDDSReference = Undefined;
	ArrayOfBusinessTransactions = New Array;
	ArticlesDDSKProcessing = New Map;
	
	WriteCFItem = False;
	For Each TabRow In ArticlesOfDDSIBusinessTransaction Do
		If ArticleDDSReference = Undefined Then
			// The first row of the table.
			ArticleDDSReference = TabRow.CFItem;
		ElsIf ArticleDDSReference <> TabRow.CFItem Then
			// Processing the transition to a new DDS article.
			If ArrayOfBusinessTransactions.Count() > 0 Then
				ArticlesDDSKProcessing.Insert(ArticleDDSReference, ArrayOfBusinessTransactions);
			EndIf;
			ArticleDDSReference = TabRow.CFItem;
			ArrayOfBusinessTransactions = New Array;
		EndIf;
		If Not (ValueIsFilled(ArticleDDSReference) And Common.RefExists(ArticleDDSReference)) Then
			Continue;
		EndIf;
			
		If ArticleDDSReference.BusinessTransactions.Find(TabRow.BusinessTransaction, "BusinessOperation") = Undefined Then
			ArrayOfBusinessTransactions.Add(TabRow.BusinessTransaction);
		EndIf;
	EndDo;
	// Processing of the last DDS article.
	If ArrayOfBusinessTransactions.Count() > 0 Then
		ArticlesDDSKProcessing.Insert(ArticleDDSReference, ArrayOfBusinessTransactions);
	EndIf;
	// Modification of DDS articles.
	For Each DataForProcessing_ In ArticlesDDSKProcessing Do
		// It is necessary to add household operations to the DDS article
		ObjectBlocked = True;
		Try
			LockDataForEdit(DataForProcessing_.Key);
		Except
			ObjectBlocked = False;
			WriteErrorToEventLog(DataForProcessing_.Key,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents, NStr("vi = 'phong tỏa đối tượng';
																				|ru = 'заблокировать объект';
																				|en = 'lock object'; fa = 'lock object';
																				|it = 'bloccare oggetto';
																				|pl = 'zablokuj obiekt';
																				|tr = 'nesneyi kilitle'"));
		EndTry;
		If ObjectBlocked Then
			ArticleObject = DataForProcessing_.Key.GetObject();
			ArticleObject.DataExchange.Load = True;
			For Each BusinessOperation In DataForProcessing_.Value Do
				BusinessTransactions = ArticleObject.BusinessTransactions; // TabularSection
				BusinessTransactions.Add().BusinessOperation = BusinessOperation;
			EndDo;
			ArticleObject.Write();
			ArticleObject.Unlock();
		EndIf;
	EndDo;
EndProcedure
Procedure ProcessProductListOfVHFCounterparty(Object, TSName, ExchangeComponents)
	If Not ValueIsFilled(Object.Partner) Or Object.Partner = Catalogs.Partners.UnknownPartner Then
		Return;
	EndIf;
	
	QueryText = 
		"SELECT
		|	ProductsFromVendor.Ref AS SupplierProducts
		|FROM
		|	&Source AS Table
		|		INNER JOIN Catalog.ProductCrossReferences AS ProductsFromVendor
		|		ON Table.PartnerProducts = ProductsFromVendor.Ref
		|WHERE
		|	Table.Ref = &Ref
		|	AND ProductsFromVendor.Owner = VALUE(Catalog.Partners.UnknownPartner)";
	
	ObjectName = Object.Metadata().FullName();
	QueryText = StrReplace(QueryText, "&Source", ObjectName + "." + TSName);
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", Object.Ref);
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		ItemProducts_ = Selection.SupplierProducts.GetObject();
		ItemProducts_.Owner = Object.Partner;
		
		ItemProducts_.DataExchange.Load = True;
		
		Try
			ItemProducts_.Write();
		Except
			WriteErrorToEventLog(Selection.SupplierProducts,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents);
		EndTry;
	EndDo;
EndProcedure
