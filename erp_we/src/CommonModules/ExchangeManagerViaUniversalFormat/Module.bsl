Procedure OCR_Document_AssemblyFromComponents_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_AssemblyFromComponents",
										"Goods",
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
									
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	If ValueIsFilled(IBData.Characteristic)
		And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
	
		TechnicalCharacteristics = Common.ObjectAttributeValue(IBData.Characteristic, "Owner");
		ProductKind = Common.ObjectAttributeValue(IBData.Products, "ProductKind");
		
		Instruction = New Structure;
		If TechnicalCharacteristics = IBData.Products
			Or (TechnicalCharacteristics = ProductKind
			And NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7")) Then
			
			Instruction.Insert("Value", IBData.Characteristic);
			Instruction.Insert("OCRName", "Catalog_ItemsCharacteristics");
		Else
			Instruction.Insert("OCRName", "Catalog_ProductCharacteristics_FromStructure");
			
			Characteristic = Common.ObjectAttributesValues(
			IBData.Characteristic, "Description, DescriptionFull");
			
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) = NumberFormatVersion("1.6") Then
				Characteristic.Insert("Owner", IBData.Products);
			Else
				Characteristic.Insert("Owner", ProductKind);
			EndIf;
			
			Instruction.Insert("Value", Characteristic);
			
			ProcessingRule = ExchangeComponents.DataProcessingRules.Find("Catalog_ItemsCharacteristics_Send", "Name");
			If Not ProcessingRule = Undefined Then
				DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, Characteristic, ProcessingRule);
			EndIf;
			
		EndIf;
		
		XDTOData.Insert("Characteristic", Instruction);
	EndIf;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	QueryText = "SELECT
		|	Products.UnitOfMeasure AS UnitOfMeasure
		|FROM
		|	Catalog.Products AS Products
		|WHERE
		|	Products.Ref = &ProductsLink";
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.AssemblyFromComponents Then
		
		XDTOData.Insert("OperationKind", "Assembly");
		XDTOData.Insert("InventoryType", "СобственныеТовары"); //@NON-NLS-2
		
		QueryText = QueryText + Common.QueryBatchSeparator() +
			"SELECT
			|	AssemblyFromComponentsGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
			|	SUM(AssemblyFromComponentsGoods.CostShare) AS CostShare,
			|	SUM(AssemblyFromComponentsGoods.Count) AS Count
			|INTO TTProducts_1
			|FROM
			|	Document.AssemblyFromComponents.Goods AS AssemblyFromComponentsGoods
			|WHERE
			|	AssemblyFromComponentsGoods.Ref = &Ref
			|
			|GROUP BY
			|	AssemblyFromComponentsGoods.ItemsLocationAttributes
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	ISNULL(InventoryLocationAttributeKeys.Products, VALUE(Catalog.Products.EmptyRef)) AS Products,
			|	ISNULL(CatProducts.UnitOfMeasure, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	InventoryKinds.Count AS Count,
			|	CAST(TTProducts_1.CostShare / TTProducts_1.Count * InventoryKinds.Count AS NUMBER(10, 0)) AS CostShare,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType,
			|	InventoryKinds.RowID AS RowID
			|FROM
			|	Document.AssemblyFromComponents.InventoryOwnerAttributesConsumption AS InventoryKinds
			|		LEFT JOIN TTProducts_1 AS TTProducts_1
			|		ON InventoryKinds.ItemsLocationAttributes = TTProducts_1.ItemsLocationAttributes
			|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
			|		ON InventoryKinds.ItemsLocationAttributes = InventoryLocationAttributeKeys.Ref
			|		LEFT JOIN Catalog.Products AS CatProducts
			|		ON (InventoryLocationAttributeKeys.Products = CatProducts.Ref)
			|WHERE
			|	InventoryKinds.Ref = &Ref";
		
		FillInYourOwnProductsInText(QueryText);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryLocationAttributeKeys"));
			
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "InventoryLocationAttributeKeys"));
		
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryLocationAttributeKeys"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
			
	Else
		
		XDTOData.Insert("OperationKind", "Disassembly");
		
		QueryText = QueryText + Common.QueryBatchSeparator() +
			"SELECT
			|	Goods.Products AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	SUM(Goods.Count) AS Count,
			|	SUM(Goods.CostShare) AS CostShare,
			|	Goods.Series AS Series,
			|	Goods.ItemsLocationAttributes AS ItemsLocationAttributes,
			|	Goods.LineNumber AS LineNumber,
			|	Goods.RowID AS RowID
			|INTO TTProducts_1
			|FROM
			|	Document.AssemblyFromComponents.Goods AS Goods
			|WHERE
			|	Goods.Ref = &Ref
			|
			|GROUP BY
			|	Goods.Series,
			|	Goods.Products,
			|	Goods.ItemsLocationAttributes,
			|	Goods.Characteristic, 
			|	Goods.LineNumber,
			|	Goods.RowID
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
			|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	InventoryKinds.Count AS Count,
			|	CAST(TTProducts_1.CostShare * InventoryKinds.Count / TTProducts_1.Count AS NUMBER(10, 0)) AS CostShare,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType,
			|	TTProducts_1.RowID
			|FROM
			|	TTProducts_1 AS TTProducts_1
			|		LEFT JOIN Document.AssemblyFromComponents.InventoryOwnerAttributesGoodsReceipt AS InventoryKinds
			|		ON (TTProducts_1.ItemsLocationAttributes = InventoryKinds.ItemsLocationAttributes
			|			AND InventoryKinds.LineNumber = TTProducts_1.LineNumber)
			|WHERE
			|	InventoryKinds.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT TOP 1
			|	CASE
			|		WHEN InventoryOwnerAttributesConsumption.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType
			|FROM
			|	Document.AssemblyFromComponents.InventoryOwnerAttributesConsumption AS InventoryOwnerAttributesConsumption
			|WHERE
			|	InventoryOwnerAttributesConsumption.Ref = &Ref";
		
		FillInYourOwnProductsInText(QueryText);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
			
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
				
	EndIf;
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref",             IBData.Ref);
	Query.SetParameter("ProductsLink", IBData.Products);
	
	QueryResult = Query.ExecuteBatch();
	
	ProductData_1 = QueryResult[0].Select();
	If ProductData_1.Next() Then
		XDTOData.Insert("UnitOfMeasure", ProductData_1.UnitOfMeasure);
	Else
		XDTOData.Insert("UnitOfMeasure", Catalogs.PackagesAndUnitsOfMeasure.EmptyRef());
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.DisassemblyIntoComponents Then
		
		DataOfTypesOfStocks = QueryResult[QueryResult.Count() - 1].Select();
		
		If DataOfTypesOfStocks.Next() Then
			XDTOData.Insert("InventoryType", DataOfTypesOfStocks.InventoryType);
		Else
			XDTOData.Insert("InventoryType", "СобственныеТовары"); //@NON-NLS-2
		EndIf;
		
		Goods = QueryResult[QueryResult.Count() - 2].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
		
	Else
		// Assembling.
		Goods = QueryResult[QueryResult.Count() - 1].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	EndIf;
	
	XDTOData.Insert("Goods", Goods);
	//ProductBatchID information
	
EndProcedure

