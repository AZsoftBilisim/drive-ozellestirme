Procedure OCR_Document_InventoryTransfer_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_MovingGoods_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_MovingGoods_Sending", 
										"Goods", 
										"RetailNDSRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False);
	
	// Divisions.
	XDTOData.Insert("SendingDepartment", Undefined);
	XDTOData.Insert("ReceivingBusinessUnit",  Undefined);
	
	If ValueIsFilled(IBData.Organization) Then
		
		SourceWarehouse                      = IBData.SourceWarehouse;
		DestinationWarehouse                       = IBData.DestinationWarehouse;
	    MatchingForGettingDivisions = Undefined;
	    CurSender           = Undefined;
	    CurUnitRecipient            = Undefined;
	    SupplementMap                 = False;
	    
	    ExchangeComponents.ConversionParameters_SSLy.Property("MatchingForGettingDivisions", MatchingForGettingDivisions);
	    
	    If MatchingForGettingDivisions = Undefined Then
	    	MatchingForGettingDivisions = New Map;
	    	SupplementMap = True;
	    Else 
	    	CurSender = MatchingForGettingDivisions.Get(SourceWarehouse);
	    	CurUnitRecipient = MatchingForGettingDivisions.Get(DestinationWarehouse);
	    EndIf;
	
	    If CurSender = Undefined Then
	    	CurSender = Common.ObjectAttributeValue(SourceWarehouse, "Department");
	    	SupplementMap = True;
	    EndIf;
	
	    If CurUnitRecipient = Undefined Then
	    	CurUnitRecipient = Common.ObjectAttributeValue(DestinationWarehouse, "Department");
	    	SupplementMap = True;
	    EndIf;
	
	    If ValueIsFilled(CurSender) Then
	
	    	RegistrationOfSubdivisionWithTaxAuthority = DetermineRegistrationWithTaxAuthority(CurSender, IBData.Organization);
		
			StructureDataDivisions = New Structure(
				"Description, RegistrationOfSubdivisionWithTaxAuthority", 
				String(CurSender),
				RegistrationOfSubdivisionWithTaxAuthority);
			
			Instruction = New Structure(
				"Value, OCRName",
				StructureDataDivisions,
				"Catalog_Divisions_FromStructure");
			
			XDTOData.Insert("SendingDepartment", Instruction);
	
	    EndIf;
	
	    If ValueIsFilled(CurUnitRecipient) Then
	
	    	RegistrationOfSubdivisionWithTaxAuthority = DetermineRegistrationWithTaxAuthority(CurUnitRecipient, IBData.Organization);
		
			StructureDataDivisions = New Structure(
				"Description, RegistrationOfSubdivisionWithTaxAuthority", 
				String(CurUnitRecipient),
				RegistrationOfSubdivisionWithTaxAuthority);
			
			Instruction = New Structure(
				"Value, OCRName",
				StructureDataDivisions,
				"Catalog_Divisions_FromStructure");
			
			XDTOData.Insert("ReceivingBusinessUnit", Instruction);
	
	    EndIf;
	
		If SupplementMap Then
	
			MatchingForGettingDivisions.Insert(SourceWarehouse, CurSender);
			MatchingForGettingDivisions.Insert(DestinationWarehouse, CurUnitRecipient);
			ExchangeComponents.ConversionParameters_SSLy.Insert("MatchingForGettingDivisions", MatchingForGettingDivisions);
		EndIf;
		
	EndIf;
	
	Query = New Query;
	Query.SetParameter("Ref", IBData.Ref);
	
	RecipientSWarehouseData = Common.ObjectAttributesValues(IBData.DestinationWarehouse, "WarehouseStore,RetailPriceType");
	
	If RecipientSWarehouseData.WarehouseStore = Enums.TypesOfWarehouses.RetailStore
		And ValueIsFilled(RecipientSWarehouseData.RetailPriceType) Then
		
		Query.Text =
			"SELECT
			|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
			|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
			|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
			|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
			|	InventoryKinds.Count AS Count,
			|	InventoryKinds.CCDNumber AS CCDNumber,
			|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
			|	CASE
			|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|			THEN ""ReturnContainers""
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType,
			|	InventoryKinds.RowID AS RowID
			|INTO TableOfGoods
			|FROM
			|	Document.InventoryTransfer.InventoryKinds AS InventoryKinds
			|WHERE
			|	InventoryKinds.Ref = &Ref
			|
			|INDEX BY
			|	Products,
			|	Characteristic
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	TableOfGoods.Products AS Products,
			|	TableOfGoods.Characteristic AS Characteristic,
			|	TableOfGoods.Series AS Series,
			|	TableOfGoods.UnitOfMeasure AS UnitOfMeasure,
			|	TableOfGoods.Count AS Count,
			|	TableOfGoods.InventoryType AS InventoryType,
			|	TableOfGoods.CCDNumber AS CCDNumber,
			|	TableOfGoods.QuantityByGBRN AS QuantityByGBRN,
			|	ItemPricesCrossSectionOfTheLatest.Price / ISNULL(&QueryTextPackagingFactor1, 1) * ISNULL(&QueryTextPackagingFactor2, 1) * CASE
			|		WHEN &Currency <> ItemPricesCrossSectionOfTheLatest.Currency
			|			THEN CASE
			|					WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
			|							AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
			|							AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
			|							AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
			|						THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
			|					ELSE 0
			|				END
			|		ELSE 1
			|	END AS RetailPrice,
			|	TableOfGoods.RowID AS RowID,
			|	&VATRate AS RetailNDSRate
			|INTO PrimaryData
			|FROM
			|	TableOfGoods AS TableOfGoods
			|		LEFT JOIN InformationRegister.ItemsPrices.SliceLast(
			|				&Date,
			|				PriceKind = &PricesKind
			|					AND Products IN
			|						(SELECT
			|							TableOfGoods.Products
			|						FROM
			|							TableOfGoods AS TableOfGoods)
			|					AND (Characteristic IN
			|							(SELECT
			|								TableOfGoods.Characteristic
			|							FROM
			|								TableOfGoods AS TableOfGoods)
			|						OR Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef))) AS ItemPricesCrossSectionOfTheLatest
			|		ON TableOfGoods.Products = ItemPricesCrossSectionOfTheLatest.Products
			|			AND TableOfGoods.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS CurrencyRatesPrices
			|		ON (ItemPricesCrossSectionOfTheLatest.Currency = CurrencyRatesPrices.Currency)
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &Currency AND BaseCurrency = &BaseCurrency) AS Currency_Rates
			|		ON (TRUE),
			|		#TablesVATRate
			|WHERE
			|	(TableOfGoods.InventoryType = &OwnProducts
			|			OR TableOfGoods.InventoryType = ""ReturnContainers"")
			|
			|UNION ALL
			|
			|SELECT
			|	TableOfGoods.Products,
			|	TableOfGoods.Characteristic,
			|	TableOfGoods.Series,
			|	TableOfGoods.UnitOfMeasure,
			|	TableOfGoods.Count,
			|	TableOfGoods.InventoryType,
			|	TableOfGoods.CCDNumber,
			|	TableOfGoods.QuantityByGBRN,
			|	0,
			|	TableOfGoods.RowID,
			|	NULL
			|FROM
			|	TableOfGoods AS TableOfGoods
			|WHERE
			|	TableOfGoods.InventoryType = ""CommissionGoods""
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	PrimaryData.Products AS Products,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	PrimaryData.UnitOfMeasure AS UnitOfMeasure,
			|	PrimaryData.Count AS Count,
			|	PrimaryData.InventoryType AS InventoryType,
			|	CASE
			|		WHEN PrimaryData.RetailPrice < 0.01
			|			THEN 0.01
			|		ELSE CAST(PrimaryData.RetailPrice AS NUMBER(31, 2))
			|	END AS RetailPrice,
			|	PrimaryData.RetailNDSRate AS RetailNDSRate,
			|	PrimaryData.RowID AS RowID,
			|	CAST(CASE
			|			WHEN PrimaryData.RetailPrice < 0.01
			|				THEN 0.01
			|			ELSE CAST(PrimaryData.RetailPrice AS NUMBER(31, 2))
			|		END * PrimaryData.Count AS NUMBER(31, 2)) AS RetailAmount
			|FROM
			|	PrimaryData AS PrimaryData";
		
		FillInYourOwnProductsInText(Query.Text);
		FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
		FillInBidOfNDSInText(Query.Text, "TableOfGoods.Products", FormatVersionIs17AndHigher);
		Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor1",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"ItemPricesCrossSectionOfTheLatest.Package",
			"ItemPricesCrossSectionOfTheLatest.Products"));
			
		Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor2",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"TableOfGoods.UnitOfMeasure",
			"TableOfGoods.Products"));
			
		Query.Text = StrReplace(Query.Text, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "PrimaryData"));
			
		Query.Text = StrReplace(Query.Text, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "PrimaryData"));
	
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
			GetTextOfRPTRequest_MovementOfGoods(ExchangeComponents, "PrimaryData"));
	
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "PrimaryData"));
		
		Query.SetParameter("Date",	EndOfDay(IBData.Date));
		Query.SetParameter("Currency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		Query.SetParameter("PricesKind", RecipientSWarehouseData.RetailPriceType);
		Query.SetParameter("RegistrationCountry", SettingsValueClientServerCached.CountryOfOrganizationRegistration(IBData.Organization));
		Query.SetParameter("Period", IBData.Date);
		
	Else
		
		Query.Text =
			"SELECT
			|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
			|	InventoryKinds.RowID AS RowID,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
			|	InventoryKinds.Count AS Count,
			|	CASE
			|		WHEN InventoryKinds.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
			|			THEN ""ReturnContainers""
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType
			|FROM
			|	Document.InventoryTransfer.InventoryKinds AS InventoryKinds
			|WHERE
			|	InventoryKinds.Ref = &Ref";
		
		FillInYourOwnProductsInText(Query.Text);
		FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
		FillInBidOfNDSInText(Query.Text, "TableOfGoods.Products", FormatVersionIs17AndHigher);
	
		Query.Text = StrReplace(Query.Text, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
			
		Query.Text = StrReplace(Query.Text, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
		Query.Text = StrReplace(Query.Text, "&QueryTextProductBatchID",
			GetTextOfRPTRequest_MovementOfGoods(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
		Query.Text = StrReplace(Query.Text, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
				
	EndIf;
	
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "TransferForActivity", "TransferForActivity");
	//If the versionsformat is empty (the exchange components.Version of the Exchange format) < The format version is("1.17") Then   
	//	 Redefine the Stock for Old formats (Goods, Lies);
	//The end if;
	XDTOData.Insert("Goods", Goods);
EndProcedure

