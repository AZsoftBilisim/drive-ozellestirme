Procedure FillInSeriesAccordingToDocument(DocumentRef, TableName, XDTOData)
	Query = New Query;
	Query.Text = 
		"SELECT
		|	SeriesTable.LineNumber AS LineNumber,
		|	SeriesTable.Series AS Series,
		|	SeriesTable.Count AS Count,
		|	SeriesTable.Products AS Products,
		|	SeriesTable.Characteristic AS Characteristic
		|FROM 
		| 	DocumentTableOfSeries   AS SeriesTable
		|WHERE
		|	SeriesTable.Ref = &Ref";
		
	Query.Text = StrReplace(Query.Text, "DocumentTableOfSeries", TableName);
	Query.SetParameter("Ref", DocumentRef);
	
	QueryResult = Query.Execute();
	
	SeriesSelection = QueryResult.Unload();
	
	If Not SeriesSelection.Count()= 0 Then
	     XDTOData.Insert("ItemsBatches", SeriesSelection);
	EndIf;
EndProcedure
Procedure FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents, AttributeName = "Warehouse", TabularSectionName = Undefined)
	If ValueIsFilled(ReceivedData[AttributeName]) And TabularSectionName = Undefined Then
		Return;
	ElsIf IBData <> Undefined And ValueIsFilled(IBData[AttributeName]) 
		And Not ValueIsFilled(ReceivedData[AttributeName]) Then
		// The warehouse was filled in the IB data - we will put it in the received data so that it does not get lost.
		ReceivedData[AttributeName] = IBData[AttributeName];
	EndIf;
	If Not ValueIsFilled(ReceivedData[AttributeName]) Then
	     ReceivedData[AttributeName] = WarehouseToLoad(ReceivedData[AttributeName], ExchangeComponents.ConversionParameters_SSLy);
	EndIf;
	
	If Not TabularSectionName = Undefined Then
	     For Each Page1 In ReceivedData[TabularSectionName] Do
		     Page1.Warehouse = ReceivedData[AttributeName];
		 EndDo;
	EndIf;
EndProcedure


Procedure FillInYourOwnProductsInText(Text)
	Text = StrReplace(Text, "&OwnProducts", """СобственныеТовары"""); //@NON-NLS-2
