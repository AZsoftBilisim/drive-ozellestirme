Procedure FillingInPartnerFieldInPaymentTranscript(Object)
	Partner = Undefined;
	ListOfCounterparties_ = CommonClientServer.HasAttributeOrObjectProperty(Object, "ListOfCounterparties_")
						And Object.ListOfCounterparties_;
	For Each String In Object.ARAPDetails Do
		
		If ListOfCounterparties_ Then
			Partner = CashServer.GetCounterpartyPartner(String.Counterparty, Object.BusinessOperation); 
		Else
			Partner = CashServer.GetCounterpartyPartner(Object.Counterparty, Object.BusinessOperation); 
		EndIf;
	
		If Not ValueIsFilled(Partner) Then
			Partner = Catalogs.Partners.UnknownPartner;
		EndIf;
		
		If Not ValueIsFilled(String.Partner)
			Or String.Partner <> Partner Then
			String.Partner = Partner;
		EndIf;
		
	EndDo;
EndProcedure
Procedure FillingInPartnerInDocumentHeader(Object)
	Partner = CashServer.GetCounterpartyPartner(Object.Counterparty);
	
	If Not ValueIsFilled(Partner) Then
		Partner = Catalogs.Partners.UnknownPartner;
	EndIf;
	
	If Not ValueIsFilled(Object.Partner)
		Or Object.Partner <> Partner Then
	
		Object.Partner = Partner;
		
	EndIf;  
	
	AttributesStructure1 = AttributesOfObjectSCustomerCounterparty(Object);
	
	If AttributesStructure1 <> Undefined Then
	 
		If ValueIsFilled(Object[AttributesStructure1.AttributeNameClient]) 
			And Not ValueIsFilled(Object[AttributesStructure1.BankingDetailsNameClientPartner]) Then
			
			PartnerOfCommissionAgent = CashServer.GetCounterpartyPartner(Object[AttributesStructure1.AttributeNameClient]);
			
			If Not ValueIsFilled(PartnerOfCommissionAgent) Then
				PartnerOfCommissionAgent = Catalogs.Partners.UnknownPartner;
			EndIf;
			
			Object[AttributesStructure1.BankingDetailsNameClientPartner] = PartnerOfCommissionAgent;
			
		EndIf;
		
	EndIf;
EndProcedure
Procedure FillingInAgreementWithClientInHeaderOfDocument(Object, BusinessTransactionAgreements = Undefined)
	// Necessary checks before filling out the agreement in the header of the document.
	// Checking for the use of functional options agreements
	If Not GetFunctionalOption("ToUseTermsOfSales") Then
		Return;
	EndIf;
	
	// Checking for the completeness of the required details for the selection of agreements.
	// If at least one of the details is not filled in, it is impossible to find or create an agreement.
	If Not (ValueIsFilled(Object.Partner)
		And Common.RefExists(Object.Partner)) Then
		Return;
	EndIf;
	
	// Search for a suitable agreement.
	// 1. Check whether the agreement is completed in the document.
	//    If the agreement in the document is filled in, then check whether the details of the agreement correspond
	//    to the details of the document. If the details of the agreement correspond to the details of the document,
	//    it is not required to change the agreement in the document.
	// 2. If the agreement in the document is not filled in, or the details of the agreement do not correspond
	//    to the details of the document, we will select the agreement in the document from the agreements already available in the database.
	// 3. If the agreement could not be selected, we create a new agreement.
	
	// Initialize the key properties of the agreement.
	UseStandardConventions                  = GetFunctionalOption("UseStandardTermsOfSalesWithCustomers");
	UseIndividualAgreements           = GetFunctionalOption("UseCustomerTermsOfSales");
	UseCounterpartyAgreements               = GetFunctionalOption("UseCustomerContracts");
	ShipmentWithDeferredTransferOfTitle          = False;
	AgreementContainsContract                      = UseCounterpartyAgreements And ValueIsFilled(Object.Contract)
		And Common.RefExists(Object.Contract);
	ARAPObjectSettings                                = Enums.ARAPObjectSettings.OrderForPrepaymentInvoiceForInvoice;
	ConsignmentSales25 						   = False;
	
	If Not AgreementContainsContract And ValueIsFilled(Object.Contract) Then
		Object.Contract = Undefined;
	EndIf;
	
	If Common.HasObjectAttribute("BusinessOperation", Object.Metadata()) Then 
		
		ShipmentWithDeferredTransferOfTitle = (Object.BusinessOperation = Enums.BusinessTransactions.SaleWithDeferredTransferOfTitle 
			Or Object.BusinessOperation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit);
		ConsignmentSales25 = SalesViaCommissionAgent(Object.BusinessOperation); 
		
		If (Object.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent
			Or Object.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent
			Or ConsignmentSales25) Then
			
			BusinessTransaction = Enums.BusinessTransactions.TransferToCommissionAgent;
		EndIf;
		
	EndIf;
	
	If BusinessTransactionAgreements = Undefined And ValueIsFilled(BusinessTransaction) Then
		BusinessTransactionAgreements = BusinessTransaction;
	ElsIf BusinessTransactionAgreements = Undefined  Then
		BusinessTransactionAgreements = PredefinedValue("Enum.BusinessTransactions.SaleToCustomer")
	EndIf;
		
	CurrencyOfMutualSettlementsOfAgreement = ?(Common.HasObjectAttribute("ARAPCurrency", Object.Metadata()), 
		Object.ARAPCurrency, Object.Currency);
	
	If AgreementContainsContract Then
		
		ContractDetails_ = Common.ObjectAttributesValues(Object.Contract, "ARAPCurrency, ARAPObjectSettings");
		
		If ValueIsFilled(ContractDetails_.ARAPCurrency) Then
			CurrencyOfMutualSettlementsOfAgreement = ContractDetails_.ARAPCurrency;
		EndIf;
			
		If ValueIsFilled(ContractDetails_.ARAPObjectSettings) Then
			ARAPObjectSettings = ContractDetails_.ARAPObjectSettings;
		EndIf;
		
	EndIf;
	
	// Initialize the add. conditions for the selection of agreements.
	AdditionalConditions = New Array;	
	If ShipmentWithDeferredTransferOfTitle Then
		AdditionalConditions.Add("TermsOfSale.SaleWithDeferredTransferOfTitleIsAllowed");
	EndIf;
	
	If AgreementContainsContract Then
		ConditionsForUsingCounterpartyAgreements = "TermsOfSale.ContractsAreUsed";
	Else
		ConditionsForUsingCounterpartyAgreements = "NOT TermsOfSale.ContractsAreUsed";
	EndIf;
	
	AdditionalConditions.Add(ConditionsForUsingCounterpartyAgreements);
	
	If ConsignmentSales25 Then
		AdditionalConditions.Add("TermsOfSale.ConsignmentSales25");
	EndIf;
	
	TextOfAdditionalConditions = StrConcat(AdditionalConditions, " And " );	
	// Item 1. Let's check whether the agreement filled in in the object is correct for this document.
	// If the agreement is correct, then no further selection is required.
	AgreementFilledInCorrectly = False;
	If ValueIsFilled(Object.Terms) Then
		
		Query = New Query(
			"SELECT
			|	TermsOfSale.Ref AS Ref
			|FROM
			|	Catalog.TermsOfSale AS TermsOfSale
			|WHERE
			|	TermsOfSale.Ref = &AgreementInObject
			|	AND TermsOfSale.Partner = &Partner
			|	AND TermsOfSale.Currency = &Currency
			|	AND (TermsOfSale.ARAPCurrency = &ARAPCurrency
			|			OR TermsOfSale.ContractsAreUsed)
			|	AND TermsOfSale.BusinessOperation = &BusinessTransaction
			|	AND (TermsOfSale.Organization = &Organization
			|			OR TermsOfSale.Organization = VALUE(Catalog.Companies.EmptyRef))
			|	AND TermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			|	AND &AdditionalConditions");
			
		Query.SetParameter("AgreementInObject",   Object.Terms);
		Query.SetParameter("Organization",          Object.Organization);
		Query.SetParameter("Currency",               Object.Currency);
		Query.SetParameter("ARAPCurrency", CurrencyOfMutualSettlementsOfAgreement);
		Query.SetParameter("Partner",              Object.Partner);
		Query.SetParameter("BusinessTransaction",          BusinessTransactionAgreements);
		
		Query.Text = StrReplace(Query.Text, "&AdditionalConditions", TextOfAdditionalConditions);
		AgreementFilledInCorrectly = Not Query.Execute().IsEmpty();
		
	EndIf;
	
	If AgreementFilledInCorrectly Then
		Return;
	EndIf;
	
	// Item 2. Let's try to find a suitable default element among the agreements already available in the database.
	// When forming the default name, the platform representation of objects cannot be used,
	// because the organization, partner or currency may not be in the database,
	// and the platform will form a representation: "The object is not found".
	// It is necessary to form the name taking into account this behavior of the platform.
	// If one of the objects forming the name is missing by default in the database,
	// then its name should be replaced with an empty string.
	DefaultAgreementNameTemplate = NStr("vi = '%1 , %2, %3, %4 (mặc định)';
										|ru = '%1 , %2, %3, %4 (по умолчанию)';
										|en = '%1 , %2, %3, %4 (default)'; fa = '%1 , %2, %3, %4 (default)';
										|it = '%1 , %2, %3, %4 (da impostazione predefinita)';
										|pl = '%1 , %2, %3, %4 (domyślnie)';
										|tr = '%1 , %2, %3, %4 (varsayılan)'");
	
	CompanyName = "";
	PartnerName    = "";
	NameOfCurrency      = "";
	
	If ValueIsFilled(Object.Organization) Then
		CompanyName = Common.ObjectAttributeValue(Object.Organization, "Description");
	EndIf;
	
	If ValueIsFilled(Object.Partner) Then
		PartnerName = Common.ObjectAttributeValue(Object.Partner, "Description");
	EndIf;
	
	If ValueIsFilled(CurrencyOfMutualSettlementsOfAgreement) Then
		NameOfCurrency = Common.ObjectAttributeValue(CurrencyOfMutualSettlementsOfAgreement, "Description");
	EndIf;
	
	NameOfDefaultAgreement = StrTemplate(DefaultAgreementNameTemplate,
		PartnerName, BusinessTransactionAgreements, CompanyName, NameOfCurrency);
	
	Query = New Query;
	Query.SetParameter("Organization",             Object.Organization);
	Query.SetParameter("Currency",                  Object.Currency);
	Query.SetParameter("ARAPCurrency",    CurrencyOfMutualSettlementsOfAgreement);
	Query.SetParameter("Partner",                 Object.Partner);
	Query.SetParameter("BusinessOperation",   BusinessTransactionAgreements);
	Query.SetParameter("OnlyStandard",           UseStandardConventions And Not UseIndividualAgreements);
	Query.SetParameter("OnlyPersonal",    Not UseStandardConventions And UseIndividualAgreements);
	Query.SetParameter("DefaultDescription", NameOfDefaultAgreement);
	
	Query.Text = "SELECT DISTINCT TOP 2
		|	TermsOfSale.Ref AS Ref,
		|	TermsOfSale.Description AS Description,
		|	CASE
		|		WHEN TermsOfSale.Description = &DefaultDescription
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ThisIsDefault
		|FROM
		|	Catalog.TermsOfSale AS TermsOfSale
		|WHERE
		|	TermsOfSale.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
		|	AND TermsOfSale.BusinessOperation = &BusinessOperation
		|	AND TermsOfSale.Currency = &Currency
		|	AND (TermsOfSale.ARAPCurrency = &ARAPCurrency
		|		OR TermsOfSale.ContractsAreUsed)
		|	AND (TermsOfSale.Organization = &Organization
		|		OR TermsOfSale.Organization = VALUE(Catalog.Companies.EmptyRef))
		|	AND NOT TermsOfSale.DeletionMark
		|	AND CASE
		|			WHEN &OnlyStandard = TRUE
		|					AND &OnlyPersonal = FALSE
		|					AND (TermsOfSale.Standard_
		|						AND (TermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		|							OR TermsOfSale.PartnersSegment IN
		|								(SELECT
		|									SegmentPartners.Segment
		|								FROM
		|									InformationRegister.SegmentPartners AS SegmentPartners
		|								WHERE
		|									SegmentPartners.Partner = &Partner)))
		|				THEN TRUE
		|			WHEN &OnlyPersonal = TRUE
		|					AND NOT &OnlyStandard = TRUE
		|					AND (NOT TermsOfSale.Standard_
		|						AND (TermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		|							OR TermsOfSale.PartnersSegment IN
		|								(SELECT
		|									SegmentPartners.Segment
		|								FROM
		|									InformationRegister.SegmentPartners AS SegmentPartners
		|								WHERE
		|									SegmentPartners.Partner = &Partner)))
		|					AND (&Partner = VALUE(Catalog.Partners.EmptyRef)
		|						OR TermsOfSale.Partner = &Partner)
		|				THEN TRUE
		|			WHEN &OnlyStandard = FALSE
		|					AND &OnlyPersonal = FALSE
		|					AND (TermsOfSale.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		|						OR TermsOfSale.PartnersSegment IN
		|							(SELECT
		|								SegmentPartners.Segment
		|							FROM
		|								InformationRegister.SegmentPartners AS SegmentPartners
		|							WHERE
		|								SegmentPartners.Partner = &Partner))
		|					AND (&Partner = VALUE(Catalog.Partners.EmptyRef)
		|						OR TermsOfSale.Partner = VALUE(Catalog.Partners.EmptyRef)
		|						OR TermsOfSale.Partner = &Partner)
		|				THEN TRUE
		|			ELSE FALSE
		|		END
		|	AND &AdditionalConditions
		|
		|ORDER BY
		|	ThisIsDefault DESC";
	
	Query.Text = StrReplace(Query.Text, "&AdditionalConditions", TextOfAdditionalConditions);
	Selection = Query.Execute().Select();
	
	CreateAgreement = True;
	
	If Selection.Count() = 1 Then
		// Only one suitable one - we will substitute it.
		Selection.Next();
		CreateAgreement = False;
		Object.Terms = Selection.Ref;
	Else
		// Search for a previously created default agreement.
		While Selection.Next() Do
			If Selection.ThisIsDefault Then
				CreateAgreement = False;
				Object.Terms = Selection.Ref;
			EndIf;
		EndDo;
	EndIf;
	
	If Not CreateAgreement Then
		// The agreement has been selected, you do not need to create a new one.
		Return;
	EndIf;
	
	// Let's create a default agreement.
	NewAgreement = Catalogs.TermsOfSale.CreateItem();
	NewAgreement.Description                                    = NameOfDefaultAgreement;
	NewAgreement.Status                                          = Enums.StatusesOfTermsOfSales.Valid;
	NewAgreement.BusinessOperation                           = BusinessTransactionAgreements;
	NewAgreement.Currency                                          = Object.Currency;
	NewAgreement.ARAPCurrency                            = CurrencyOfMutualSettlementsOfAgreement;
	NewAgreement.Organization                                     = Object.Organization;
	NewAgreement.Approved                                      = True;
	NewAgreement.ContractsAreUsed                = AgreementContainsContract;
	NewAgreement.SaleWithDeferredTransferOfTitleIsAllowed = ShipmentWithDeferredTransferOfTitle;
	NewAgreement.ARAPObjectSettings                                 = ARAPObjectSettings;
	NewAgreement.ConsignmentSales25							= ConsignmentSales25;
	If UseStandardConventions And Not UseIndividualAgreements Then
		
		NewAgreement.Standard_ = True;
		
		// Let's define the partner segment
		Query = New Query;
		Query.Text = "SELECT TOP 1
			|	SegmentPartners.Segment
			|FROM
			|	InformationRegister.SegmentPartners AS SegmentPartners
			|WHERE
			|	SegmentPartners.Partner = &Partner";
			
		Query.SetParameter("Partner", Object.Partner);
		Selection = Query.Execute().Select();
		
		If Selection.Next() Then
			NewAgreement.PartnersSegment = Selection.Segment;
		EndIf;
		
	Else 
		NewAgreement.Standard_    = False;
		NewAgreement.Partner    = Object.Partner;
		NewAgreement.Counterparty = Object.Counterparty;
	EndIf;
	
	NewAgreement.Write();
	Object.Terms = NewAgreement.Ref;
EndProcedure
Procedure FillingInAgreementWithSupplierInHeaderOfDocument(Object, ConversionParameters_SSLy, BusinessTransactionAgreements = Undefined)
	// Necessary checks before filling out the agreement in the header of the document.
	// Checking for the use of functional options agreements
	If Not GetFunctionalOption("UseTermsOfPurchases") Then
		Return;
	EndIf;
	
	// Checking for the completeness of the required details for the selection of agreements.
	// If at least one of the details is not filled in, it is impossible to find or create an agreement.
	If Not (ValueIsFilled(Object.Partner)
		And Common.RefExists(Object.Partner)) Then
		Return;
	EndIf;
	
	// Search for a suitable agreement.
	// 1. Check whether the agreement is completed in the document.
	//    If the agreement in the document is filled in, then check whether the details of the agreement correspond
	//    to the details of the document. If the details of the agreement correspond to the details of the document,
	//    it is not required to change the agreement in the document.
	// 2. If the agreement in the document is not filled in, or the details of the agreement do not correspond
	//    to the details of the document, we will select the agreement in the document from the agreements already available in the database.
	// 3. If the agreement could not be selected, we create a new agreement.
	
	// Initialize the key properties of the agreement.
	UseAgreements                = GetFunctionalOption("UseTermsOfPurchases");
	UseCounterpartyAgreements      = GetFunctionalOption("UseContractsWithVendors");
	AgreementContainsContract             = UseCounterpartyAgreements And ValueIsFilled(Object.Contract)
		And Common.RefExists(Object.Contract);
	ARAPObjectSettings                       = Enums.ARAPObjectSettings.OrderForPrepaymentInvoiceForInvoice;
	
	If Not AgreementContainsContract And ValueIsFilled(Object.Contract) Then
		Object.Contract = Undefined;
	EndIf;
	
	If BusinessTransactionAgreements = Undefined Then
		If Object.BusinessOperation = Enums.BusinessTransactions.ConsignmentProcurement
			Or Object.BusinessOperation = Enums.BusinessTransactions.ReturnOfGoodsToConsignor Then
			BusinessTransactionAgreements = Enums.BusinessTransactions.ConsignmentProcurement;
		ElsIf Object.BusinessOperation = Enums.BusinessTransactions.PurchaseByImport Then
			BusinessTransactionAgreements = Enums.BusinessTransactions.PurchaseByImport;
		ElsIf Object.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEU Then
			BusinessTransactionAgreements = Enums.BusinessTransactions.ImportFromEAEU;
		Else
			BusinessTransactionAgreements = Enums.BusinessTransactions.PurchaseFromSupplier;
		EndIf;
	EndIf;
	
	CurrencyOfMutualSettlementsOfAgreement = ?(Common.HasObjectAttribute("ARAPCurrency", Object.Metadata()), 
		Object.ARAPCurrency, Object.Currency);
		
	If AgreementContainsContract Then
		
		ContractDetails_ = Common.ObjectAttributesValues(Object.Contract, "ARAPCurrency, ARAPObjectSettings");
		
		If ValueIsFilled(ContractDetails_.ARAPCurrency) Then
			CurrencyOfMutualSettlementsOfAgreement = ContractDetails_.ARAPCurrency;
		EndIf;
			
		If ValueIsFilled(ContractDetails_.ARAPObjectSettings) Then
			ARAPObjectSettings = ContractDetails_.ARAPObjectSettings;
		EndIf;
		
	EndIf;
	
	// Initialize the add. conditions for the selection of agreements.
	ConditionsForUsingCounterpartyAgreements    = "";
	TemplateForAdditionalConditions                    = "%1";
	
	If AgreementContainsContract Then
		ConditionsForUsingCounterpartyAgreements = "TermsOfPurchaseFromVendors.ContractsAreUsed";
	Else
		ConditionsForUsingCounterpartyAgreements = "NOT TermsOfPurchaseFromVendors.ContractsAreUsed";
	EndIf;
	
	TextOfAdditionalConditions = StrTemplate(TemplateForAdditionalConditions, ConditionsForUsingCounterpartyAgreements);
	
	// Item 1. Let's check whether the agreement filled in in the object is correct for this document.
	// If the agreement is correct, then no further selection is required.
	AgreementFilledInCorrectly = False;
	If ValueIsFilled(Object.Terms) Then
		
		Query = New Query("SELECT
			|	TermsOfPurchaseFromVendors.Ref AS Ref
			|FROM
			|	Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
			|WHERE
			|	TermsOfPurchaseFromVendors.Ref = &AgreementInObject
			|	AND TermsOfPurchaseFromVendors.Partner = &Partner
			|	AND TermsOfPurchaseFromVendors.Currency = &Currency
			|	AND (TermsOfPurchaseFromVendors.ARAPCurrency = &ARAPCurrency
			|			OR CASE
			|				WHEN &AgreementContainsContract
			|					THEN TermsOfPurchaseFromVendors.ARAPCurrency = VALUE(Catalog.Currencies.EmptyRef)
			|			END)
			|	AND TermsOfPurchaseFromVendors.BusinessOperation = &BusinessTransaction
			|	AND TermsOfPurchaseFromVendors.Organization = &Organization
			|	AND TermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			|	AND &AdditionalConditions
			|
			|UNION ALL
			|
			|SELECT
			|	TermsOfPurchaseFromVendors.Ref
			|FROM
			|	Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
			|WHERE
			|	TermsOfPurchaseFromVendors.Ref = &AgreementInObject
			|	AND TermsOfPurchaseFromVendors.Partner = &Partner
			|	AND TermsOfPurchaseFromVendors.Currency = &Currency
			|	AND (TermsOfPurchaseFromVendors.ARAPCurrency = &ARAPCurrency
			|			OR CASE
			|				WHEN &AgreementContainsContract
			|					THEN TermsOfPurchaseFromVendors.ARAPCurrency = VALUE(Catalog.Currencies.EmptyRef)
			|			END)
			|	AND TermsOfPurchaseFromVendors.BusinessOperation = &BusinessTransaction
			|	AND TermsOfPurchaseFromVendors.Organization = VALUE(Catalog.Companies.EmptyRef)
			|	AND TermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
			|	AND &AdditionalConditions");
			
		Query.SetParameter("AgreementInObject",        Object.Terms);
		Query.SetParameter("Organization",               Object.Organization);
		Query.SetParameter("Currency",                    Object.Currency);
		Query.SetParameter("ARAPCurrency",      CurrencyOfMutualSettlementsOfAgreement);
		Query.SetParameter("Partner",                   Object.Partner);
		Query.SetParameter("BusinessTransaction",               BusinessTransactionAgreements);
		Query.SetParameter("AgreementContainsContract", AgreementContainsContract);
		Query.Text = StrReplace(Query.Text, "&AdditionalConditions", TextOfAdditionalConditions);
		AgreementFilledInCorrectly = Not Query.Execute().IsEmpty();
		
	EndIf;
	
	If AgreementFilledInCorrectly Then
		Return;
	EndIf;
	
	// Item 2. Let's try to find a suitable default element among the agreements already available in the database.
	// When forming the default name, the platform representation of objects cannot be used,
	// because the organization, partner or currency may not be in the database,
	// and the platform will form a representation: "The object is not found".
	// It is necessary to form the name taking into account this behavior of the platform.
	// If one of the objects forming the name is missing by default in the database,
	// then its name should be replaced with an empty string.
	DefaultAgreementNameTemplate = NStr("vi = '%1 , %2, %3, %4 (mặc định)';
										|ru = '%1 , %2, %3, %4 (по умолчанию)';
										|en = '%1 , %2, %3, %4 (default)'; fa = '%1 , %2, %3, %4 (default)';
										|it = '%1 , %2, %3, %4 (da impostazione predefinita)';
										|pl = '%1 , %2, %3, %4 (domyślnie)';
										|tr = '%1 , %2, %3, %4 (varsayılan)'");
	
	CompanyName = "";
	PartnerName    = "";
	NameOfCurrency      = "";
	
	If ValueIsFilled(Object.Organization) Then
		CompanyName = Common.ObjectAttributeValue(Object.Organization, "Description");
	EndIf;
	
	If ValueIsFilled(Object.Partner) Then
		PartnerName = Common.ObjectAttributeValue(Object.Partner, "Description");
	EndIf;
	
	If ValueIsFilled(CurrencyOfMutualSettlementsOfAgreement) Then
		NameOfCurrency = Common.ObjectAttributeValue(CurrencyOfMutualSettlementsOfAgreement, "Description");
	EndIf;
	
	NameOfDefaultAgreement = StrTemplate(DefaultAgreementNameTemplate,
		PartnerName, BusinessTransactionAgreements, CompanyName, NameOfCurrency);
	
	Query = New Query;
	Query.SetParameter("Organization",             Object.Organization);
	Query.SetParameter("Currency",                  Object.Currency);
	Query.SetParameter("ARAPCurrency",    CurrencyOfMutualSettlementsOfAgreement);
	Query.SetParameter("Partner",                 Object.Partner);
	Query.SetParameter("BusinessOperation",   BusinessTransactionAgreements);
	Query.SetParameter("DefaultDescription", NameOfDefaultAgreement);
	
	Query.Text = "SELECT DISTINCT TOP 2
		|	TermsOfPurchaseFromVendors.Ref AS Ref,
		|	CASE
		|		WHEN TermsOfPurchaseFromVendors.Description = &DefaultDescription
		|			THEN TRUE
		|		ELSE FALSE
		|	END AS ThisIsDefault
		|FROM
		|	Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
		|WHERE
		|	TermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
		|	AND TermsOfPurchaseFromVendors.BusinessOperation = &BusinessOperation
		|	AND TermsOfPurchaseFromVendors.Currency = &Currency
		|	AND TermsOfPurchaseFromVendors.ARAPCurrency = &ARAPCurrency
		|	AND TermsOfPurchaseFromVendors.Organization = &Organization
		|	AND TermsOfPurchaseFromVendors.Partner = &Partner
		|	AND NOT TermsOfPurchaseFromVendors.DeletionMark
		|	AND &AdditionalConditions
		|
		|UNION ALL
		|
		|SELECT DISTINCT TOP 2
		|	TermsOfPurchaseFromVendors.Ref,
		|	CASE
		|		WHEN TermsOfPurchaseFromVendors.Description = &DefaultDescription
		|			THEN TRUE
		|		ELSE FALSE
		|	END
		|FROM
		|	Catalog.TermsOfPurchaseFromVendors AS TermsOfPurchaseFromVendors
		|WHERE
		|	TermsOfPurchaseFromVendors.Status = VALUE(Enum.StatusesOfTermsOfPurchase.Valid)
		|	AND TermsOfPurchaseFromVendors.BusinessOperation = &BusinessOperation
		|	AND TermsOfPurchaseFromVendors.Currency = &Currency
		|	AND TermsOfPurchaseFromVendors.ARAPCurrency = &ARAPCurrency
		|	AND TermsOfPurchaseFromVendors.Organization = VALUE(Catalog.Companies.EmptyRef)
		|	AND TermsOfPurchaseFromVendors.Partner = &Partner
		|	AND NOT TermsOfPurchaseFromVendors.DeletionMark
		|	AND &AdditionalConditions
		|
		|ORDER BY
		|	ThisIsDefault DESC";
	
	Query.Text = StrReplace(Query.Text,"&AdditionalConditions", TextOfAdditionalConditions);
	Selection = Query.Execute().Select();
	
	CreateAgreement = True;
	
	If Selection.Count() = 1 Then
		// Only one suitable one - we will substitute it.
		Selection.Next();
		CreateAgreement = False;
		Object.Terms = Selection.Ref;
	Else
		// Search for a previously created default agreement.
		While Selection.Next() Do
			If Selection.ThisIsDefault Then
				CreateAgreement = False;
				Object.Terms = Selection.Ref;
			EndIf;
		EndDo;
	EndIf;
	
	If Not CreateAgreement Then
		// The agreement has been selected, you do not need to create a new one.
		Return;
	EndIf;
	
	// Let's create a default agreement.
	NewAgreement = Catalogs.TermsOfPurchaseFromVendors.CreateItem();
	NewAgreement.Description                     = NameOfDefaultAgreement;
	NewAgreement.Status                           = Enums.StatusesOfTermsOfPurchase.Valid;
	NewAgreement.BusinessOperation            = BusinessTransactionAgreements;
	NewAgreement.Currency                           = Object.Currency;
	NewAgreement.ARAPCurrency             = CurrencyOfMutualSettlementsOfAgreement;
	NewAgreement.Organization                      = Object.Organization;
	NewAgreement.Approved                       = True;
	NewAgreement.GoodsReceiptOption            = Constants.GoodsReceiptOption.Get();
	NewAgreement.ContractsAreUsed = AgreementContainsContract;
	NewAgreement.Partner                          = Object.Partner;
	NewAgreement.Counterparty                       = Object.Counterparty;
	NewAgreement.ARAPObjectSettings                  = ARAPObjectSettings;
	
	NewAgreement.Write();
	Object.Terms = NewAgreement.Ref;
EndProcedure
Procedure FillingInArticleDDSVDocument(Object)
	// If there is no household operation, it is impossible to fill out the article.
	If Not ValueIsFilled(Object.BusinessOperation) Then
		Return;
	EndIf;
		
	CFItemFilledInHeader = ValueIsFilled(Object.CashFlowItem);
	ArticleDDSVDecryptionFilledIn = Object.ARAPDetails.Count() <> 0;
	For Each StringDecryption In Object.ARAPDetails Do
		If Not ValueIsFilled(StringDecryption.CashFlowItem) Then
			ArticleDDSVDecryptionFilledIn = False;
		EndIf;
	EndDo;
	// If the article is filled in the header or in all lines of PM, we do nothing.
	If CFItemFilledInHeader And ArticleDDSVDecryptionFilledIn Then
		Return; 
	EndIf;
	
	// Calculation of the DDS article by default.
	
	Query = New Query;
	Query.Text = "SELECT TOP 2
	|	TabBusinessTransactions.Ref AS Ref,
	|	CASE WHEN TabBusinessTransactions.Ref.Description = &DefaultArticleName THEN
	|		2 
	|	WHEN TabBusinessTransactions.Ref.Predefined THEN 1
	|	ELSE 0 END AS OrderingValue
	|FROM Catalog.CashFlowReportItems.BusinessTransactions AS TabBusinessTransactions
	|WHERE TabBusinessTransactions.BusinessOperation = &BusinessOperation
	|ORDER BY OrderingValue DESC";
	
	SalaryPaymentOperations = New ValueList;
	SalaryPaymentOperations.Add(Enums.BusinessTransactions.SalaryPayment);
	SalaryPaymentOperations.Add(Enums.BusinessTransactions.SalaryPaymentToBankAccounts);
	SalaryPaymentOperations.Add(Enums.BusinessTransactions.SalaryPaymentByPayrollCardProgram);
	SalaryPaymentOperations.Add(Enums.BusinessTransactions.SalaryPaymentToEmployee);
	SalaryPaymentOperations.Add(Enums.BusinessTransactions.SalaryPaymentByDistributor);
	SalaryPaymentOperations.Add(Enums.BusinessTransactions.SalaryPaymentViaCashAccount);
	
	If SalaryPaymentOperations.FindByValue(Object.BusinessOperation) = Undefined Then
		BusinessTransaction = Object.BusinessOperation;
		DefaultArticleName = "" + TrimAll(Object.BusinessOperation) + " "+ NStr("vi = '(mặc định)';
																				|ru = '(по умолчанию)';
																				|en = '(default)'; fa = '(default)';
																				|it = '(da impostazione predefinita)';
																				|pl = '(domyślnie)';
																				|tr = '(varsayılan)'");
		TypeOfCashMovement = "";
		If (Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptUnderDeposits)
			Or (Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromLoansRepayment)
			Or (Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty)
			Or (Object.BusinessOperation = Enums.BusinessTransactions.OtherIncome) Then
			TypeOfCashMovement = Enums.CashFlowKinds.OtherReceiptsFromOperatingActivities;
		ElsIf (Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer)
			Or (Object.BusinessOperation = Enums.BusinessTransactions.CashRecieptFromCustomerByAcquiringTransactions) Then
			TypeOfCashMovement = Enums.CashFlowKinds.CahsReceiptFromCustomesSales;
		ElsIf (Object.BusinessOperation = Enums.BusinessTransactions.OtherExpenses) Then
			TypeOfCashMovement = Enums.CashFlowKinds.OtherPaymentsForCurrentActivities;
		EndIf;
	Else
		BusinessTransaction = Enums.BusinessTransactions.SalaryPayment;
		DefaultArticleName = "" + TrimAll(Enums.BusinessTransactions.SalaryPayment) + " " + NStr("vi = '(mặc định)';
																								|ru = '(по умолчанию)';
																								|en = '(default)'; fa = '(default)';
																								|it = '(da impostazione predefinita)';
																								|pl = '(domyślnie)';
																								|tr = '(varsayılan)'");
		TypeOfCashMovement = Enums.CashFlowKinds.Payroll;
	EndIf;
	Query.SetParameter("BusinessOperation", BusinessTransaction);
	Query.SetParameter("DefaultArticleName", DefaultArticleName);
	Selection = Query.Execute().Select();
	YouNeedToCreateArticle = False;
	If Selection.Next() Then
		If Selection.Count() = 1 Or Selection.OrderingValue > 0 Then
			DefaultCFItem = Selection.Ref;
		Else
			YouNeedToCreateArticle = True;
		EndIf;
	Else
		YouNeedToCreateArticle = True;
	EndIf;
	If YouNeedToCreateArticle Then
		NewItem = Catalogs.CashFlowReportItems.CreateItem();
		NewItem.Description = DefaultArticleName;
		NewItem.CashFlowKind = TypeOfCashMovement;
		
		LineOfTablePartBusinessOperations = NewItem.BusinessTransactions.Add();
		LineOfTablePartBusinessOperations.BusinessOperation = BusinessTransaction;
		
		NewItem.Write();
		DefaultCFItem = NewItem.Ref;
	EndIf;
	If Not CFItemFilledInHeader Then
		Object.CashFlowItem = DefaultCFItem;
	EndIf;
		
	For Each StringDecryption In Object.ARAPDetails Do
		If Not ValueIsFilled(StringDecryption.CashFlowItem) Then
			StringDecryption.CashFlowItem = DefaultCFItem;
		EndIf;
	EndDo;
EndProcedure
Procedure FillInBankAccountUsingOrganizationSCurrency(Object)
	SettlementAccountDetails = Common.ObjectAttributesValues(Object.BankAccount, "CashCurrency,Owner");
	If Not ValueIsFilled(Object.BankAccount)
		Or SettlementAccountDetails.CashCurrency <> Object.Currency Or SettlementAccountDetails.Owner <> Object.Organization Then
		
		Object.BankAccount = Catalogs.CompaniesBankAccounts.EmptyRef();
	
		Query = New Query("SELECT
		|	CompaniesBankAccounts.Ref
		|FROM
		|	Catalog.CompaniesBankAccounts AS CompaniesBankAccounts
		|WHERE
		|	CompaniesBankAccounts.Owner = &Owner
		|	AND CompaniesBankAccounts.CashCurrency = &CashCurrency
		|	AND CompaniesBankAccounts.DeletionMark = FALSE");
		Query.SetParameter("Owner", Object.Organization);
		Query.SetParameter("CashCurrency", Object.Currency);
		TabCurrentAccounts = Query.Execute().Unload();
	
		If TabCurrentAccounts.Count() = 1 Then
			Object.BankAccount = TabCurrentAccounts[0].Ref;
		EndIf;
	
	EndIf;
EndProcedure
Procedure FillInIndividualSBankAccount(Object)
	If Not Object.AdditionalProperties.Property("CounterpartySBankAccount_Number") Then
		Return;
	EndIf;
	
	Query = New Query();
	Query.Text = 
	"SELECT TOP 1
	|	CounterpartyBankAccounts.Ref
	|FROM
	|	Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
	|WHERE
	|	CounterpartyBankAccounts.Owner = &Individual
	|	AND CounterpartyBankAccounts.AccountNumber = &AccountNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	CounterpartyBankAccounts.Ref
	|FROM
	|	Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
	|WHERE
	|	VALUETYPE(CounterpartyBankAccounts.Owner) = TYPE(Catalog.Counterparties)
	|	AND CounterpartyBankAccounts.AccountNumber = &AccountNumber";
	Query.SetParameter("Individual", Object.AdvanceHolder);
	Query.SetParameter("AccountNumber", Object.AdditionalProperties.CounterpartySBankAccount_Number);
	
	QueryResult = Query.ExecuteBatch();
	Selection = QueryResult[0].Select();
	If Selection.Next() Then
		Object.CounterpartyBankAccount = Selection.Ref;
	Else
		
		Selection = QueryResult[1].Select();
		If Selection.Next() Then
			
			TheAccountOfPhysicalPerson = Catalogs.CounterpartyBankAccounts.CreateItem();
			FillPropertyValues(TheAccountOfPhysicalPerson, Selection.Ref,, "Parent");
			TheAccountOfPhysicalPerson.SetNewCode();
			TheAccountOfPhysicalPerson.Owner = Object.AdvanceHolder;
			TheAccountOfPhysicalPerson.DataExchange.Load = True;
			TheAccountOfPhysicalPerson.Write();
			
			Object.CounterpartyBankAccount = TheAccountOfPhysicalPerson.Ref;
			
		EndIf;
	EndIf;
EndProcedure
Procedure FillInDefaultCountOption(PaymentSteps, CalculateFrom = Undefined)
	If PaymentSteps.Count() = 0 Then
		Return;
	EndIf;
	
	If Not ValueIsFilled(CalculateFrom) Then
		CalculateFrom = Enums.PaymentDateCalculationOptions.FixedDate;
	EndIf;
	
	For Each PaymentStage In PaymentSteps Do
	
		If ValueIsFilled(PaymentStage.CalculateFrom) Then 
			Continue;
		EndIf;
		
		PaymentStage.CalculateFrom = CalculateFrom;
	
	EndDo;
EndProcedure
Procedure FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Table, ColumnName, AttributeName = "", PurchaseOfGoods = True)
	If AttributeName = "" Then
		// We will get the type of VAT activity by default.
		StructureInformationSecurityData = New Structure("Organization, Date, Warehouse");
		FillPropertyValues(StructureInformationSecurityData, IBData);
		
		AccountingParametersForOrganization = VATAccountingERP.AccountingParametersForOrganization(
				StructureInformationSecurityData.Organization,
				StructureInformationSecurityData.Date,
				StructureInformationSecurityData.Warehouse);
		
		If PurchaseOfGoods Then
			VATActivityType = AccountingParametersForOrganization.MainActivityVATProcurement;		
		Else
			VATActivityType = AccountingParametersForOrganization.BasicTaxationVATSales;
		EndIf;
		 
	Else
		VATActivityType = IBData[AttributeName];
	EndIf;
	
	Table.Columns.Add(ColumnName);
	Table.FillValues(VATActivityType, ColumnName);
EndProcedure
Procedure FillInDefaultActivity(Object, NameOfBankingDetailsToFillIn)
	If Not ValueIsFilled(Object[NameOfBankingDetailsToFillIn]) Then
		ManagerOfDocument = Common.ObjectManagerByFullName(Object.Metadata().FullName());
		
		If TypeOf(Object) = Type("DocumentObject.OBEntryARAP") 
			Or TypeOf(Object) = Type("DocumentObject.OBEntryCash")
			Or TypeOf(Object) = Type("DocumentObject.OBEntryFinancialInstruments")
			Or TypeOf(Object) = Type("DocumentObject.OBEntryARAPAdvanceHolders")
			Or TypeOf(Object) = Type("DocumentObject.OBEntryGoods") Then
			
			FillParameters = VATAccountingERPClientServer.ParametersForFillingInVATActivityType();
			FillParameters.Organization             = Object.Organization;
			FillParameters.Date                    = Object.Date;
			FillParameters.Warehouse                   = Object.Warehouse;
			FillParameters.Contract                 = Object.Contract;
			FillParameters.LineOfBusiness = Object.LineOfBusiness;
			FillParameters.PurchaseOfGoods     = True;
		
		ElsIf TypeOf(Object) = Type("DocumentObject.InventoryTransfer")
			Or TypeOf(Object) = Type("DocumentObject.TransferOrder") Then
			FillParameters = VATAccountingERPClientServer.ParametersForFillingInVATActivityType();
			FillParameters.Organization              = Object.Organization;
			FillParameters.Date                     = Object.Date;
			FillParameters.Warehouse                    = Object.DestinationWarehouse;
			FillParameters.MovementOfGoodsInWarehouses = True;
		Else	
			FillParameters = ManagerOfDocument.ParametersForFillingInVATActivityType(Object);
		EndIf;
		
		VATAccountingERP.FillInTypeOfActivityVAT(Object[NameOfBankingDetailsToFillIn], FillParameters);
	EndIf;
EndProcedure 
Procedure FillInTypeOfProductForVHFSeries(Object, SeriesSpecificationParameters, ExchangeComponents, FullObjectName = "")
	If Not ValueIsFilled(FullObjectName) Then
		FullObjectName  = Object.Metadata().FullName();
	EndIf;
	
	If (TypeOf(SeriesSpecificationParameters) = Type("FixedStructure") Or TypeOf(SeriesSpecificationParameters) = Type("Structure"))
		And SeriesSpecificationParameters.Property("NameTSGoods") Then
		TSName = SeriesSpecificationParameters.NameTSGoods;
	Else
		Return;
	EndIf;
	
	QueryText = 
			"SELECT
			|	Source.Series AS Series,
			|	CASE
			|		WHEN Source.Products.ProductKind.BatchOwner = VALUE(Catalog.ItemKinds.EmptyRef)
			|			THEN Source.Products.ProductKind
			|		ELSE Source.Products.ProductKind.BatchOwner
			|	END AS BatchOwner
			|FROM
			|	&Source AS Source
			|WHERE
			|	Source.Ref = &Ref
			|	AND Source.Series.ProductKind = VALUE(Catalog.ItemKinds.EmptyRef)";
	
	If SeriesSpecificationParameters.ProductInHeader Then
		QueryText = StrReplace(QueryText , "&Source", FullObjectName);
	Else
		QueryText = StrReplace(QueryText , "&Source", FullObjectName + "." + TSName);
	EndIf;
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", Object.Ref);
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		ObjectSeries = Selection.Series.GetObject();
		ObjectSeries.ProductKind = Selection.BatchOwner;
		
		ObjectSeries.DataExchange.Load = True;
		
		Try
			ObjectSeries.Write();
		Except
			WriteErrorToEventLog(Selection.Series,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents);
		EndTry;	
	EndDo;
EndProcedure


Procedure FillInDataOfIncomingSBDsDocument(IBData, XDTOData)
