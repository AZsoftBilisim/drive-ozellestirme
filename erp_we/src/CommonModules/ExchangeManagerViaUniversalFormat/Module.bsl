Procedure PCO_Document_LoanBalances_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted              = True;
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.OBEntryDebtOutstandingOfLoansAndBorrowings;
	
	#Region FinancialInstrumentsARAP
	
	Interests     = Enums.LoanAndDepositScheduleAmountTypes.Interests;
	PrincipalDebt = Enums.LoanAndDepositScheduleAmountTypes.PrincipalDebt;
	
	RulesForConvertingAmountTypes = New Map;
	RulesForConvertingAmountTypes.Insert("ShortTermLoans_", PrincipalDebt);
	RulesForConvertingAmountTypes.Insert("ShortTermLoans",   PrincipalDebt);
	RulesForConvertingAmountTypes.Insert("LongTermLoans_",  PrincipalDebt);
	RulesForConvertingAmountTypes.Insert("LongTermLoans",    PrincipalDebt);
	RulesForConvertingAmountTypes.Insert("InterestOnShortTermLoans", Interests);
	RulesForConvertingAmountTypes.Insert("InterestOnShortTermLoans_",   Interests);
	RulesForConvertingAmountTypes.Insert("InterestOnLongTermLoans",  Interests);
	RulesForConvertingAmountTypes.Insert("InterestOnLongTermLoans_",    Interests);
	
	ShortTerm = Enums.LoanAndDepositPriorityType.ShortTerm;
	LongTerm  = Enums.LoanAndDepositPriorityType.LongTerm;
	
	ConversionRulesTypesOfUrgency = New Map;
	ConversionRulesTypesOfUrgency.Insert("ShortTermLoans_",            ShortTerm);
	ConversionRulesTypesOfUrgency.Insert("ShortTermLoans",              ShortTerm);
	ConversionRulesTypesOfUrgency.Insert("InterestOnShortTermLoans", ShortTerm);
	ConversionRulesTypesOfUrgency.Insert("InterestOnShortTermLoans_",   ShortTerm);
	ConversionRulesTypesOfUrgency.Insert("LongTermLoans_",             LongTerm);
	ConversionRulesTypesOfUrgency.Insert("LongTermLoans",               LongTerm);
	ConversionRulesTypesOfUrgency.Insert("InterestOnLongTermLoans",  LongTerm);
	ConversionRulesTypesOfUrgency.Insert("InterestOnLongTermLoans_",    LongTerm);
	
	FillingRules = New Map;
	FillingRules.Insert("Sum",      "Sum");
	FillingRules.Insert("SumCompl",  "SumCompl");
	FillingRules.Insert("Counterparty", "Counterparty");
	
	ManSExchangeRate = Undefined;
	
	CurrencyCodeLocal = Common.ObjectAttributeValue(
		LocalAccountingCurrency(ReceivedData.Organization),
		"Code");
	
	ArrayOfTSStrings = New Array;
	
	For Each String In XDTOData.Calculations Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		StringDataStructure.Insert("SumMan", String.Sum);
		StringDataStructure.Insert("AmountType", RulesForConvertingAmountTypes.Get(String.ARAPType.Value));
		
		ContractData = New Structure;
		ContractData.Insert("PriorityType", ConversionRulesTypesOfUrgency.Get(String.ARAPType.Value));
		ContractData.Insert("Organization",  XDTOData.Organization);
		ContractData.Insert("Counterparty",   String.Counterparty);
		ContractData.Insert("Date",         XDTOData.Date);
		ContractData.Insert("Number",        NStr("vi = 'b/n';
													|ru = 'б/н';
													|en = 'without number'; fa = 'without number';
													|it = 'b/n';
													|pl = 'without number';
													|tr = 'numarasız'"));
		ContractData.Insert("Description", NStr("vi = 'Khoản tín dụng hoặc khoản vay nhận được';
												|ru = 'Кредит или займ полученный';
												|en = 'Received credit or loan'; fa = 'Received credit or loan';
												|it = 'Credito o prestito ricevuto';
												|pl = 'Kredyt lub pożyczka otrzymane';
												|tr = 'Kredi veya alınan borç'"));
		ContractData.Insert("ARAPCurrency", String.ARAPCurrency);
		
		StringDataStructure.Insert("Contract", ContractData);
		
		If ValueIsFilled(String.ARAPCurrency) And String.ARAPCurrency.Code <> CurrencyCodeLocal Then
			If ManSExchangeRate = Undefined Then
				ManSExchangeRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(Constants.ManagementAccountingCurrency.Get(), EndOfDay(XDTOData.Date),
										SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(ReceivedData.Organization));
			EndIf;
			
			If ManSExchangeRate.CourseDenominator <> 0 Then
				StringDataStructure.Insert("SumCompl", Round(StringDataStructure.Sum * ManSExchangeRate.CourseNumerator / ManSExchangeRate.CourseDenominator, 2));
			EndIf;
		Else
			StringDataStructure.Insert("SumCompl", StringDataStructure.Sum);
		EndIf;
		
		ArrayOfTSStrings.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("FinancialInstrumentsARAP", ArrayOfTSStrings);
	
	#EndRegion
EndProcedure
