		EndIf;
	EndIf;
	
	FillInDefaultTaxType(Object);
	
	If Object.AdditionalProperties.Property("TableOfParts") Then
		For Each TS In Object.AdditionalProperties.TableOfParts Do
			If ValueIsFilled(Object.AdditionalProperties.TableOfParts[TS.Key]) Then
				Object[TS.Key].Load(Object.AdditionalProperties.TableOfParts[TS.Key]);
			EndIf;
		EndDo;
	EndIf;
	
	If Not ValueIsFilled(Object.CashRegister) Then
		FillInCashRegisterByCurrencyWarehouseAndOrganization(Object, ExchangeComponents);
	EndIf;
	
	If Not ValueIsFilled(Object.CashRegisterShift) Then
		DocumentsWithGiftCertificates = ExchangeComponents.ConversionParameters_SSLy.DocumentsWithGiftCertificates; // ValueTable
			
		NewRow = DocumentsWithGiftCertificates.Add();
