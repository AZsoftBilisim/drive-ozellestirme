Procedure OCR_Document_InventoryConsumption_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.TransferToOperation; 
	
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products",        "Products");
	FillingRules.Insert("Count",          "Count");
	FillingRules.Insert("Individual",      "Individual");
	FillingRules.Insert("CostItem",        "ExpenseItem");
	FillingRules.Insert("AssetID",    "AssetID");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	ArrayOfRows = New Array;
	For Each String In XDTOData.Goods Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		If Not StringDataStructure.Property("NumberOfPackages") Then
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf;
		
		
		ArrayOfRows.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	
	#EndRegion
EndProcedure
Procedure OCR_Document_InventoryConsumption_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
							ReceivedData.AdditionalProperties, ExchangeComponents);
	
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents);
	
	If IBData <> Undefined Then
		
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
		
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("Individual");
		KeyFieldsArray.Add("AssetID");
		
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
				ReceivedData.Goods,
				IBData.Goods,
				KeyFieldsArray,
				Undefined,
				"Count, Package, NumberOfPackages, ExpenseItem");
		
		IBData.Goods.Load(ReceivedData.Goods.Unload());
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If Not GetFunctionalOption("UseInventoryConsumptionStatuses")
		Or DataToWriteToIB.Patch = True
		Or DataToWriteToIB.BusinessOperation <> Enums.BusinessTransactions.TransferToOperation Then
		
		DataToWriteToIB.Status = Enums.InternalConsumptionStatuses.Accepted;
	Else
		DataToWriteToIB.Status = Enums.InternalConsumptionStatuses.Shipped;
	EndIf;
	
	For Each String In DataToWriteToIB.Goods Do
		If Not ValueIsFilled(String.RowID) Then
			String.RowID = New UUID;
		EndIf;
	EndDo;
EndProcedure

