Procedure FillOutApplicationForSpendingCash(Object)
	If Not TypeOf(Object) = Type("DocumentObject.BankAccountIssue")
		And Not TypeOf(Object) = Type("DocumentObject.CashVoucher") Then
		Return;
	EndIf;
	
	If Not GetFunctionalOption("UsePaymentRequests") Then
		Return;
	EndIf;
	
	If ValueIsFilled(Object.PaymentRequest) Then
		Return;
	EndIf;
	
	Query = New Query(
	"SELECT
	|	Request.Ref AS Request,
	|	Request.DocumentAmount AS DocumentAmount
	|INTO TTApplicationForCashSpending
	|FROM
	|	Document.PaymentRequest AS Request
	|WHERE
	|	Request.Posted
	|	AND Request.Status = VALUE(Enum.StatusesOfPaymentRequests.AmountDue)
	|	AND Request.Date <= &Date
	|	AND Request.BusinessOperation = &BusinessOperation
	|	AND Request.DocumentAmount = &DocumentAmount
	|	AND Request.Currency = &Currency
	|	AND Request.Organization = &Organization
	|	AND &AdditionalConditions
	|
	|INDEX BY
	|	Request
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CashToBePaidBalance.PaymentRequest AS Request,
	|	CashToBePaidBalance.SumBalance
	|INTO TTApplicationBalances
	|FROM
	|	AccumulationRegister.CashToBePaid.Balance(
	|			,
	|			PaymentRequest IN
	|				(SELECT
	|					TTApplicationForCashSpending.Request
	|				FROM
	|					TTApplicationForCashSpending)) AS CashToBePaidBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TTApplicationForCashSpending.Request AS Request
	|FROM
	|	TTApplicationForCashSpending AS TTApplicationForCashSpending
	|		INNER JOIN TTApplicationBalances AS TTApplicationBalances
	|		ON (TTApplicationBalances.Request = TTApplicationForCashSpending.Request)
	|			AND (TTApplicationBalances.SumBalance = -TTApplicationForCashSpending.DocumentAmount)");
	
	TextAdditionalConditions = "TRUE";
	If TypeOf(Object) = Type("DocumentObject.BankAccountIssue") Then
		TextAdditionalConditions = TextAdditionalConditions + "
		|	AND Request.PaymentMethodBankAccount
		|	AND Request.PaymentMethodOfPaymentRequest IN (VALUE(Enum.PaymentForms.BankAccountPayment), VALUE(Enum.PaymentForms.InstantPayments))";
		
		If Object.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany
			Or Object.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices
			Or Object.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany Then
			
			TextAdditionalConditions = TextAdditionalConditions + "
			|	AND Request.BankAccountBeneficiary = &BankAccountBeneficiary";
			Query.SetParameter("BankAccountBeneficiary", Object.BankAccountBeneficiary);
		ElsIf Object.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder
			And Object.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee Then
			
			TextAdditionalConditions = TextAdditionalConditions + "
			|	AND Request.AdvanceHolder = &AdvanceHolder";
			Query.SetParameter("AdvanceHolder", Object.AdvanceHolder);
		Else
			TextAdditionalConditions = TextAdditionalConditions + "
			|	AND Request.Counterparty = &Counterparty
			|	AND Request.CounterpartyBankAccount = &CounterpartyBankAccount
			|	AND Request.OperationWithSelfEmployedPerson = &OperationWithSelfEmployedPerson";
			Query.SetParameter("Counterparty", Object.Counterparty);
			Query.SetParameter("CounterpartyBankAccount", Object.CounterpartyBankAccount);
			Query.SetParameter("OperationWithSelfEmployedPerson", Object.OperationWithSelfEmployedPerson);
		EndIf;
		
	ElsIf TypeOf(Object) = Type("DocumentObject.CashVoucher") Then
		TextAdditionalConditions = TextAdditionalConditions + "
		|	AND Request.PaymentMethodCash
		|	AND Request.PaymentMethodOfPaymentRequest = VALUE(Enum.PaymentForms.CashAccountPayment_)";
		
		If Object.BusinessOperation = Enums.BusinessTransactions.CashPaymentToAnotherCompany
			Or Object.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices
			Or Object.BusinessOperation = Enums.BusinessTransactions.RefundToAnotherCompany Then
			
			TextAdditionalConditions = TextAdditionalConditions + "
			|	AND Request.CashAccountRecipient = &CashAccountRecipient";
			Query.SetParameter("CashAccountRecipient", Object.CashAccountRecipient);
		ElsIf Object.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder
			And Object.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee Then
			
			TextAdditionalConditions = TextAdditionalConditions + "
			|	AND Request.AdvanceHolder = &AdvanceHolder";
			Query.SetParameter("AdvanceHolder", Object.AdvanceHolder);
		Else
			TextAdditionalConditions = TextAdditionalConditions + "
			|	AND Request.Counterparty = &Counterparty";
			Query.SetParameter("Counterparty", Object.Counterparty);
		EndIf;
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "&AdditionalConditions", TextAdditionalConditions);
	
	Query.SetParameter("Date", Object.Date);
	Query.SetParameter("BusinessOperation", Object.BusinessOperation);
	Query.SetParameter("DocumentAmount", Object.DocumentAmount);
	Query.SetParameter("Currency", Object.Currency);
	Query.SetParameter("Organization", Object.Organization);
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		Object.PaymentRequest = Selection.Request;
		For Each DecryptionString In Object.ARAPDetails Do
			DecryptionString.PaymentRequest = Selection.Request;
		EndDo;
	EndIf;
EndProcedure
Procedure FillInHistoryOfCompanyNames(ReceivedInformationSecurityData, ReceivedData)
	Ref = ReceivedInformationSecurityData.Ref;
	If Not ReceivedData.AdditionalProperties.Property("DescriptionFull") 
		Or Not ReceivedData.AdditionalProperties.Property("AbbreviatedDescription")
		Or (ReceivedData.AdditionalProperties.Property("NameHistory") 
		And ValueIsFilled(ReceivedData.AdditionalProperties.NameHistory)) Then
		
		Return;
		
	EndIf;
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	CompaniesNameHistory.Period AS Period,
		|	CompaniesNameHistory.AbbreviatedDescription AS AbbreviatedDescription,
		|	CompaniesNameHistory.DescriptionFull AS DescriptionFull,
		|	CompaniesNameHistory.DescriptionInternational AS DescriptionInternational
		|FROM
		|	Catalog.Companies.NameHistory AS CompaniesNameHistory
		|WHERE
		|	CompaniesNameHistory.Ref = &Ref
		|	AND (CompaniesNameHistory.AbbreviatedDescription = &AbbreviatedDescription
		|			AND CompaniesNameHistory.DescriptionFull = &DescriptionFull)";
	
	Query.SetParameter("DescriptionFull", ReceivedData.AdditionalProperties.DescriptionFull);
	Query.SetParameter("AbbreviatedDescription", ReceivedData.AdditionalProperties.AbbreviatedDescription);
	Query.SetParameter("Ref", Ref);
	
	QueryResult = Query.Execute();
	If Not QueryResult.IsEmpty() Then
	     Return;
	EndIf;
	NameHistory = ReceivedInformationSecurityData.NameHistory;
	RecordsCount = NameHistory.Count();
	NewRow = NameHistory.Add();
	NewRow.Period  = ?(RecordsCount > 0, CurrentDate(), Date(1,1,1));  
	NewRow.AbbreviatedDescription = ReceivedData.AbbreviatedDescription; 
	NewRow.DescriptionFull = ReceivedData.DescriptionFull;
EndProcedure
Procedure FillInCashShiftByNumberAndCashierCashREGISTER(ReceivedData, CashRegister, CashShiftNumber)
	Query = New Query;
	Query.Text = "
	|SELECT TOP 1
	|	CashRegisterShift.Ref AS CashShiftLink
	|FROM
	|	Document.CashRegisterShift AS CashRegisterShift
	|WHERE
	|	CashRegisterShift.CashRegister = &CashRegister
	|	AND CashRegisterShift.CREShiftNumber = &CREShiftNumber
	|	AND NOT CashRegisterShift.DeletionMark
	|	AND CashRegisterShift.Status = VALUE(Enum.CashRegisterShiftStatuses.IsOpen)
	|
	|ORDER BY
	|	CashRegisterShift.Date DESC";
	Query.SetParameter("CashRegister", CashRegister);
	Query.SetParameter("CREShiftNumber", Number(CashShiftNumber));
	
	QueryResult = Query.Execute();
	If Not QueryResult.IsEmpty() Then
		Selection = QueryResult.Select();
		Selection.Next();
		ReceivedData.CashRegisterShift = Selection.CashShiftLink;
	EndIf;
EndProcedure
Procedure FillInCashRegisterByCurrencyDivisionAndOrganization(ReceivedData)
	CashRegisterDetails = Common.ObjectAttributesValues(ReceivedData.CashRegister, "CashCurrency, Owner");
	
	If CashRegisterDetails.CashCurrency <> ReceivedData.Currency 
		Or CashRegisterDetails.Owner <> ReceivedData.Organization Then
		
		CashRegister = Undefined;
		Currency = ReceivedData.Currency;
		Organization = ReceivedData.Organization;
		Department = ReceivedData.Department;
		
		FilterParameters = New Structure;
		FilterParameters.Insert("Currency", Currency);
		FilterParameters.Insert("Organization", Organization);
		FilterParameters.Insert("Department", Department);
	
		YouMustCreateElement = False;
	
		If Common.RefExists(Organization) And Common.RefExists(Currency) Then
			NameOfItemToExchangeByDefault = TrimAll(Organization) + " (" + TrimAll(Currency) + ")";
		Else
			NameOfItemToExchangeByDefault = NStr("vi = 'Quầy thu ngân chính';
												|ru = 'Основная касса ККМ';
												|en = 'Main cash register'; fa = 'Main cash register';
												|it = 'Registratore di cassa principale';
												|pl = 'Kasa podstawowa';
												|tr = 'Ana yazar kasa'");
		EndIf;
		
		DepartmentList = New ValueList();
		DepartmentList.Add(Catalogs.BusinessStructure.EmptyRef());
		DepartmentList.Add(Department);
		
		Query = New Query("SELECT TOP 2
			|	CashAccounts.Ref AS CashAccount,
			|	CASE
			|		WHEN CashAccounts.Description = &NameOfItemToExchangeByDefault
			|			THEN TRUE
			|		ELSE FALSE
			|	END AS ThisIsDefaultItemForSharing,
			|	CashAccounts.Warehouse AS Warehouse
			|FROM
			|	Catalog.CashRegisters AS CashAccounts
			|WHERE
			|	NOT CashAccounts.DeletionMark
			|	AND CashAccounts.Owner = &Organization
			|	AND CashAccounts.CashCurrency = &Currency
			|	AND CashAccounts.Department IN(&DepartmentList)
			|
			|ORDER BY
			|	ThisIsDefaultItemForSharing DESC,
			|	Warehouse DESC");
	
		Query.SetParameter("NameOfItemToExchangeByDefault", NameOfItemToExchangeByDefault);
		Query.SetParameter("Organization", Organization);
		Query.SetParameter("Currency", Currency);
		Query.SetParameter("DepartmentList", DepartmentList);
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			If Selection.Count() = 1 Or Selection.ThisIsDefaultItemForSharing Then
				CashRegister = Selection.CashAccount;
			Else
				YouMustCreateElement = True;
			EndIf;
		Else
			YouMustCreateElement = True;
		EndIf;
		
		// Creating an item to exchange with the specified parameters
		If YouMustCreateElement Then
			CashRegisterObject = Catalogs.CashRegisters.CreateItem();
			CashRegisterObject.Description			= NameOfItemToExchangeByDefault;
			CashRegisterObject.CashCurrency	= Currency;
			CashRegisterObject.Owner				= Organization;
			CashRegisterObject.Department			= Department;
			CashRegisterObject.CashRegisterType                = Enums.CashRegisterTypes.FiscalCashRegisters;
	
			Try
				CashRegisterObject.Write();
				CashRegister = CashRegisterObject.Ref;
			Except
				WriteLogEvent(NStr("vi = 'Trao đổi dữ liệu.Tạo mới phần tử Quầy thu ngân';
									|ru = 'Обмен данными.Создание элемента КассыККМ';
									|en = 'Data exchange.Create cash register item'; fa = 'Data exchange.Create cash register item';
									|it = 'Scambio dati.Creazione elemento Registratore di cassa';
									|pl = 'Wymiana danych. Utworzenie elementu Kasy';
									|tr = 'Veri değişimi. Yazar Kasa öğesinin oluşturulması'", 
					Common.DefaultLanguageCode()),
	       			EventLogLevel.Error,,,
	       			DetailErrorDescription(ErrorInfo()));
			
				CashRegister = Catalogs.CashRegisters.EmptyRef();
			EndTry
		EndIf;
		
		ReceivedData.CashRegister = CashRegister;
	EndIf;
EndProcedure
Procedure FillInCashRegisterByCurrencyWarehouseAndOrganization(ReceivedData, ExchangeComponents, NameOfTheWarehouse = "")
	If ValueIsFilled(NameOfTheWarehouse) Then
		Warehouse = Catalogs.Warehouses.FindByDescription(NameOfTheWarehouse, True);
	Else
		Warehouse = ReceivedData.Warehouse;
	EndIf;
		
	CashRegisterDetails = Common.ObjectAttributesValues(ReceivedData.CashRegister, "CashCurrency, Owner, Warehouse");
	
	If CashRegisterDetails.CashCurrency <> ReceivedData.Currency 
		Or CashRegisterDetails.Owner <> ReceivedData.Organization
		Or (ExchangeComponents.ConversionParameters_SSLy.UploadAnalyticsByWarehouse And CashRegisterDetails.Warehouse <> Warehouse) Then
		
		CashRegister = Undefined;
		Currency = ReceivedData.Currency;
		Organization = ReceivedData.Organization;
		
		FilterParameters = New Structure;
		FilterParameters.Insert("Currency", Currency);
		FilterParameters.Insert("Organization", Organization);
		FilterParameters.Insert("Warehouse", Warehouse);
	
		YouMustCreateElement = False;
	
		If Common.RefExists(Organization) And Common.RefExists(Currency) Then
			NameOfItemToExchangeByDefault = TrimAll(Organization) + " (" + TrimAll(Currency) + ")";
		Else
			NameOfItemToExchangeByDefault = NStr("vi = 'Quầy thu ngân chính';
												|ru = 'Основная касса ККМ';
												|en = 'Main cash register'; fa = 'Main cash register';
												|it = 'Registratore di cassa principale';
												|pl = 'Kasa podstawowa';
												|tr = 'Ana yazar kasa'");
		EndIf;
		
		WarehousesList = New ValueList();
		WarehousesList.Add(Catalogs.Warehouses.EmptyRef());
		WarehousesList.Add(Warehouse);
		
		Query = New Query("SELECT TOP 2
			|	CashAccounts.Ref AS CashAccount,
			|	CASE
			|		WHEN CashAccounts.Description = &NameOfItemToExchangeByDefault
			|			THEN TRUE
			|		ELSE FALSE
			|	END AS ThisIsDefaultItemForSharing,
			|	CashAccounts.Warehouse AS Warehouse
			|FROM
			|	Catalog.CashRegisters AS CashAccounts
			|WHERE
			|	NOT CashAccounts.DeletionMark
			|	AND CashAccounts.Owner = &Organization
			|	AND CashAccounts.CashCurrency = &Currency
			|	AND CashAccounts.Warehouse IN(&WarehousesList)
	
			|
			|ORDER BY
			|	ThisIsDefaultItemForSharing DESC,
			|	Warehouse DESC");
	
		Query.SetParameter("NameOfItemToExchangeByDefault", NameOfItemToExchangeByDefault);
		Query.SetParameter("Organization", Organization);
		Query.SetParameter("Currency", Currency);
		Query.SetParameter("WarehousesList", WarehousesList);
	
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			If Selection.Count() = 1 Or Selection.ThisIsDefaultItemForSharing Then
				CashRegister = Selection.CashAccount;
			Else
				YouMustCreateElement = True;
			EndIf;
		Else
			YouMustCreateElement = True;
		EndIf;
	
		// Creating an item to exchange with the specified parameters
		If YouMustCreateElement Then
			CashRegisterObject = Catalogs.CashRegisters.CreateItem();
			CashRegisterObject.Description			= NameOfItemToExchangeByDefault;
			CashRegisterObject.CashCurrency	= Currency;
			CashRegisterObject.Owner				= Organization;
			CashRegisterObject.Warehouse					= Warehouse;
			CashRegisterObject.CashRegisterType                = Enums.CashRegisterTypes.FiscalCashRegisters;
	
			Try
				CashRegisterObject.Write();
				CashRegister = CashRegisterObject.Ref;
			Except
				CashRegister = Catalogs.CashRegisters.EmptyRef();
				WriteErrorToEventLog(CashRegister, ErrorInfo(), ExchangeComponents);
			EndTry
		EndIf;
		
		ReceivedData.CashRegister = CashRegister;
	EndIf;
EndProcedure
Procedure FillOutCashRegisterByCurrencyAndOrganization(ReceivedData, ExchangeComponents, DivisionName = "")
	If ValueIsFilled(ReceivedData.CashAccount) Then
		Return;
	EndIf;
	
	If ValueIsFilled(DivisionName) Then
		Department = Catalogs.BusinessStructure.FindByDescription(DivisionName, True);
	Else
		Department = Catalogs.BusinessStructure.EmptyRef();
	EndIf;
		
	CashRegisterAttributes = Common.ObjectAttributesValues(ReceivedData.CashAccount, "CashCurrency, Owner, Department");
	
	If CashRegisterAttributes.CashCurrency <> ReceivedData.Currency 
		Or CashRegisterAttributes.Owner <> ReceivedData.Organization
		Or ?(ValueIsFilled(Department), CashRegisterAttributes.Department <> Department,False) Then
		
		FilterParameters = New Structure(
			"Currency,Organization,Department",
			ReceivedData.Currency,
			ReceivedData.Organization,
			Department);
		
		ReceivedData.CashAccount = DefaultCheckout(FilterParameters, ExchangeComponents);
		
	EndIf;
EndProcedure
Procedure FillOutCashRegisterOfTabularPartByCurrencyAndOrganization(ReceivedData, ExchangeComponents, DivisionName = "")
	If ValueIsFilled(DivisionName) Then
		Department = Catalogs.BusinessStructure.FindByDescription(DivisionName, True);
	Else
		Department = Catalogs.BusinessStructure.EmptyRef();
	EndIf;
	
	IndexOf = 0;
	For Each String In ReceivedData.CashAccounts Do
		
		// We get the currency from the source string from additional properties. The currency must be converted into a database object.
		CashAccounts = ReceivedData.AdditionalProperties.CashAccounts; // Array
		Currency = CashAccounts.Get(IndexOf).Currency;
		
		CashRegisterAttributes = Common.ObjectAttributesValues(String.CashAccount, "CashCurrency, Owner, Department");
		
		If CashRegisterAttributes.CashCurrency <> Currency 
			Or CashRegisterAttributes.Owner <> ReceivedData.Organization
			Or ?(ValueIsFilled(Department), CashRegisterAttributes.Department <> Department, False) Then
			
			FilterParameters = New Structure(
				"Currency,Organization,Department",
				Currency,
				ReceivedData.Organization,
				Department);
			
			String.CashAccount = DefaultCheckout(FilterParameters, ExchangeComponents);
			
		EndIf;
		
		IndexOf = IndexOf + 1;
	EndDo;
EndProcedure
Procedure FillInAllOurEnterprise(ReceivedData, ConversionParameters_SSLy, FillingOutBankAccount = False)
	If ValueIsFilled(ReceivedData.Counterparty) Then
		Return;
	EndIf;
	If Not ValueIsFilled(ConversionParameters_SSLy.CounterpartyOurCompany) Then
		Query = New Query("SELECT TOP 1
		  | Counterparties.Ref AS CounterpartyOurCompany
		  |FROM
		  | Catalog.Counterparties AS Counterparties
		  |WHERE
		  | Counterparties.Partner = VALUE(Catalog.Partners.OurEnterprise)");
		  
		Selection = Query.Execute().Select();
		If Not Selection.Next() Then
			Return;
		EndIf;
		 	
		ConversionParameters_SSLy.CounterpartyOurCompany = Selection.CounterpartyOurCompany;
	EndIf;
	
	ReceivedData.Counterparty = ConversionParameters_SSLy.CounterpartyOurCompany;
	
	If FillingOutBankAccount Then
		If Not ValueIsFilled(ConversionParameters_SSLy.CounterpartyOurCompanyBankAccount) Then
			Query = New Query("SELECT TOP 1
		  	| AccountBank.Ref AS BankAccount
		  	|FROM
		  	| Catalog.CounterpartyBankAccounts AS AccountBank
		  	|WHERE
		 	| AccountBank.Owner = &OurEnterprise AND AccountBank.CashCurrency = &Currency");
			Query.SetParameter("OurEnterprise", ConversionParameters_SSLy.CounterpartyOurCompany);
			Query.SetParameter("Currency", ReceivedData.Currency);
			Selection = Query.Execute().Select();
			If Not Selection.Next() Then
				Return;
			EndIf;
			ConversionParameters_SSLy.CounterpartyOurCompanyBankAccount = Selection.BankAccount;
		EndIf;
		ReceivedData.CounterpartyBankAccount = ConversionParameters_SSLy.CounterpartyOurCompanyBankAccount;
	EndIf;
EndProcedure
Procedure FillInCourseAndMultiplicityInDecryptionLines(Object)
	For Each TSRow In Object.ARAPDetails Do
		If ValueIsFilled(TSRow.ExchangeRateNumeratorOfMutualSettlements) Or ValueIsFilled(TSRow.TheExchangeRateIsTheDenominatorOfMutualSettlements) Then
			Continue;
		EndIf;
		
		CurrencyOfComplianceAccounting = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization);
		CourseAndMultiplicity = New Structure("CourseNumerator, CourseDenominator", 0, 0);
		
		If TypeOf(Object) = Type("DocumentObject.BankAccountReceiptNote") Or TypeOf(Object) = Type("DocumentObject.BankAccountIssue") Then
			DateOfCourseReceipt = ?(ValueIsFilled(Object.BankPostingDate), Object.BankPostingDate, Object.Date);
		Else
			DateOfCourseReceipt = Object.Date;
		EndIf;
			
		If ValueIsFilled(Object.Currency) And ValueIsFilled(TSRow.ARAPCurrency) And ValueIsFilled(CurrencyOfComplianceAccounting) Then
			CourseAndMultiplicity = CashServer.CourseNumeratorAndCourseDenominatorOfMutualSettlements(Object.Currency,
																								TSRow.ARAPCurrency,
																								CurrencyOfComplianceAccounting,
																								DateOfCourseReceipt,
																								TSRow.ARAPObject);
		ElsIf ValueIsFilled(TSRow.Sum) And ValueIsFilled(TSRow.AmountARAP) Then
			CourseAndMultiplicity.CourseNumerator = TSRow.Sum / TSRow.AmountARAP;
			CourseAndMultiplicity.CourseDenominator = 1;
		EndIf;
		
		TSRow.ExchangeRateNumeratorOfMutualSettlements = CourseAndMultiplicity.CourseNumerator;
		TSRow.TheExchangeRateIsTheDenominatorOfMutualSettlements = CourseAndMultiplicity.CourseDenominator;
	EndDo;
EndProcedure
Procedure FillInVATTaxationBasedOnReceivedData(ExchangeComponents, ReceivedData, XDTOData, SellerSVAT = True)
	// We fill out the taxing forms in the document according to the data obtained from the format.
	If XDTOData.Property("Taxation")
		And ValueIsFilled(XDTOData.Taxation) Then
		
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
			If SellerSVAT Then
				OCRName = "VATTaxationOfSeller";
			Else
				OCRName = "VATTaxation";
			EndIf;
			
			ReceivedData.AdditionalProperties.Insert("VATTaxation",
				New Structure("Value, OCRName", XDTOData.Taxation, OCRName));
		Else
		
			ReceivedData.AdditionalProperties.Insert("VATTaxation",
				New Structure("Value, OCRName", XDTOData.Taxation, "Transfers_TypesOfVATTaxation"));
		EndIf;
	ElsIf XDTOData.Property("VATTaxationOfSeller")
		And ValueIsFilled(XDTOData.VATTaxationOfSeller) Then
		ReceivedData.AdditionalProperties.Insert("VATTaxation",
			New Structure("Value, OCRName", XDTOData.VATTaxationOfSeller, "VATTaxationOfSeller"));
	EndIf;
EndProcedure
Procedure FillInProductListOfVHFCounterparty(ExchangeComponents, Table, DefaultCounterparty)
	Table.Columns.Add("SKUCounterparty_");
	
	For Each TableRow In Table Do
		If Not ValueIsFilled(TableRow.SKULink) Then
			Continue;
		EndIf;
		
		Owner = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(TableRow.SKUOwner); 
		If ValueIsFilled(Owner) Then
			TableRow.SKUCounterparty_ = TableRow.SKULink;
			
			Continue;
		EndIf;
		
		ProductCrossReference = New Structure;
		ProductCrossReference.Insert("Ref", TableRow.SKULink);
		ProductCrossReference.Insert("Owner", DefaultCounterparty);
		ProductCrossReference.Insert("Description", TableRow.SKUCounterpartyName);
		ProductCrossReference.Insert("Id", TableRow.CounterpartySSKUID);
		ProductCrossReference.Insert("SKU", TableRow.SKUArticleNumber);
		ProductCrossReference.Insert("Barcode", TableRow.SKUBarcode);
		ProductCrossReference.Insert("IDOf1CProductsProductCategory",
			TableRow.SKUIDOfServiceProductCategory);
		ProductCrossReference.Insert("IDOf1CProductsServiceCharacteristic",
			TableRow.CounterpartySKUIDOfServiceCharacteristic);
		
		If (ValueIsFilled(TableRow.SKUNameOfBaseUnitOfMeasurement) Or ValueIsFilled(TableRow.SKUOkeyCodeOfBaseUnitOfMeasurement)) 
			And (ValueIsFilled(TableRow.SKUPackageName) Or ValueIsFilled(TableRow.SKUNameOfBaseUnitOfMeasurement)) Then
		
			UnitOfMeasure = New Structure;
			UnitOfMeasure.Insert("Description", TableRow.SKUNameOfBaseUnitOfMeasurement);
			UnitOfMeasure.Insert("Code", TableRow.SKUOkeyCodeOfBaseUnitOfMeasurement);
	
			Products = New Structure;
			Products.Insert("Description", ProductCrossReference.Description);
			Products.Insert("SKU", ProductCrossReference.SKU);
			Products.Insert("IDOf1CProductsService",
				ProductCrossReference.IDOf1CProductsProductCategory);
	
			If ValueIsFilled(TableRow.SKUPackageName) Then
				Package = New Structure;
				Package.Insert("Description", TableRow.SKUPackageName);
				Package.Insert("UnitOfMeasure", UnitOfMeasure);
				Package.Insert("Products", Products);
				Package.Insert("ZoomRatio",?(TableRow.SKUNumberOfPackages = 0,
					TableRow.SKUNumberOfBaseUnitOfMeasurement,
					Round(TableRow.SKUNumberOfBaseUnitOfMeasurement / TableRow.SKUNumberOfPackages,3)));
			Else
				Package = New Structure;
				Package.Insert("Description", TableRow.SKUNameOfBaseUnitOfMeasurement);
				Package.Insert("UnitOfMeasure", UnitOfMeasure);
				Package.Insert("Products", Products);
				Package.Insert("ZoomRatio", 1);
			EndIf;
			
			ProductCrossReference.Insert("ProductPackaging", Package);
		
		EndIf;
		
		TableRow.SKUCounterparty_ = New Structure("Value, OCRName",
				ProductCrossReference, "Catalog_SupplierProducts_FromStructure");
	EndDo;
EndProcedure
Procedure FillInCalculationObjectInBalances(ReceivedData, FillInContract = False, DefaultCalculationObject = Undefined)
	For Each String In ReceivedData.PartnersARAPAccounting Do
		
		String.PaymentDate = ReceivedData.Date;
		
		If Not FillInContract Or Not ValueIsFilled(String.ARAPObject) Then
			If ValueIsFilled(DefaultCalculationObject) Then
				String.ARAPObject = DefaultCalculationObject;
			EndIf;
			Continue;
		EndIf;
		
		If ValueIsFilled(String.ARAPObject) And TypeOf(String.ARAPObject) = Type("CatalogRef.CounterpartyContracts") Then
		
			StructureOfContract = Common.ObjectAttributesValues(String.ARAPObject, "Number,Date,Description");
			String.NumberOfARAPDocument = StructureOfContract.Number;
			String.APARDocumentDate  = StructureOfContract.Date;			
			
			PositionFrom = Find(StructureOfContract.Description, " dated ");
			
			If PositionFrom > 0 Then
				
				If Not ValueIsFilled(String.NumberOfARAPDocument) Then
					String.NumberOfARAPDocument = TrimAll(Left(StructureOfContract.Description, PositionFrom));
				EndIf;
				
				If Not ValueIsFilled(String.APARDocumentDate) Then
					String.APARDocumentDate = TrimAll(Right(StructureOfContract.Description, 
						StrLen(StructureOfContract.Description)-PositionFrom));
				EndIf;
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
	FinancialSettlementsWithPartners = ReceivedData.PartnersARAPAccounting.Unload();
	FinancialSettlementsWithPartners.GroupBy("Partner, Counterparty, ARAPCurrency, ARAPObject, NumberOfARAPDocument, APARDocumentDate, PaymentDate, DocumentOfARAPAccounting", "Sum, SumCompl");
	
	ReceivedData.PartnersARAPAccounting.Load(FinancialSettlementsWithPartners);
EndProcedure
Procedure FillInWHCalculationObject(Object, TSName, PaymentType_, Partner, Counterparty, NameCalculationDocument = "DocumentOfARAPAccounting", NameCalculationObject = "ARAPObject")
	If Not Object.AdditionalProperties.Property(TSName) Then
		Return;
	EndIf;
	
	If Object[TSName].Count() = Object.AdditionalProperties[TSName].Count() Then
		
		For Cnt = 0 To Object[TSName].Count() - 1 Do
			
			LinkToGetARAPObject = LinkToGetARAPObject(Object.AdditionalProperties[TSName][Cnt]);
			
			If Not ValueIsFilled(LinkToGetARAPObject) Then
				Continue;
			EndIf;
			
			Additional_Criteria = ARAPObjectsServer.AdditionalSearchCriteria_1();
			
			If ValueIsFilled(Partner) Then
				If TypeOf(Partner) = Type("String") And ValueIsFilled(Object[TSName][Cnt][Partner]) Then
					Additional_Criteria.Partner = Object[TSName][Cnt][Partner];
				ElsIf TypeOf(Partner) = Type("CatalogRef.Partners") Then
					Additional_Criteria.Partner = Partner;
				EndIf;
			EndIf;
			
			If ValueIsFilled(Counterparty) Then
				If TypeOf(Counterparty) = Type("String") And ValueIsFilled(Object[TSName][Cnt][Counterparty]) Then
					Additional_Criteria.Counterparty = Object[TSName][Cnt][Counterparty];
				ElsIf TypeOf(Counterparty) = Type("CatalogRef.Counterparties") Then
					Additional_Criteria.Counterparty = Counterparty;
				EndIf;
			EndIf;
			
			If ValueIsFilled(PaymentType_) And TypeOf(PaymentType_) = Type("String") Then
				PaymentType_ = Object[TSName][Cnt][PaymentType_];
			EndIf;
			
			If Additional_Criteria.Property("OnlyBalance") Then
				Additional_Criteria.OnlyBalance = False;
			Else
				Additional_Criteria.Insert("OnlyBalance", False);
			EndIf;
			
			ARAPObject = ARAPObjectsServer.GetCalculationObjectFromLink(
				LinkToGetARAPObject,
				Object.Organization,
				PaymentType_, 
				Additional_Criteria);
			
			If ValueIsFilled(ARAPObject) Then
				Object[TSName][Cnt][NameCalculationObject] = ARAPObject;
			EndIf;
			
		EndDo;
	EndIf;
EndProcedure
Procedure FillInPaymentBasisFromAdditionalProperties(DataToWriteToIB, AdditionalProperties, PropertyName = "DocumentOfARAPAccounting")
	If AdditionalProperties.Property("ARAPDetails") Then
		ARAPDetails = AdditionalProperties.ARAPDetails;
		TSMetadata = DataToWriteToIB.Metadata().TabularSections.ARAPDetails; 
		
		If TSMetadata.Attributes.Find("PaymentPurpose") <> Undefined And ARAPDetails.Count()> 0 Then
			
			For Each Page1 In DataToWriteToIB.ARAPDetails Do 
				
				If Not ARAPDetails[Page1.LineNumber - 1].Property(PropertyName) Then
					Continue;
				EndIf;
				
				Page1.PaymentPurpose = ARAPDetails[Page1.LineNumber - 1][PropertyName];
			EndDo; 
			
		EndIf; 
		
	EndIf;
EndProcedure
Procedure FillInBasisOfPaymentForSettlementObject(Object, TSName, NameBasisOfPayment = "PaymentPurpose", NameCalculationObject = "ARAPObject")
	If Not Common.HasObjectAttribute(NameBasisOfPayment, Object.Metadata().TabularSections[TSName]) Then
		Return;
	EndIf;
	
	For Each TSRow In Object[TSName] Do
		If ValueIsFilled(TSRow.PaymentPurpose) Then
			Continue;
		EndIf;
		PaymentPurpose = Undefined;
		If ValueIsFilled(TSRow[NameCalculationObject]) Then
			PaymentPurpose = Common.ObjectAttributeValue(TSRow[NameCalculationObject], "Object");
		EndIf;
		
		If ValueIsFilled(PaymentPurpose) Then
			TSRow[NameBasisOfPayment] = PaymentPurpose;
		EndIf;
		
	EndDo;
EndProcedure
Procedure FillInDeliveryParameters(Object)
	If Not ThereAreDetailsOfInformationSecurityData(Object, "DeliveryMethod") Then
		Return;
	EndIf;
	
	If Not ValueIsFilled(Object.DeliveryMethod) Then
		If TypeOf(Object) = Type("DocumentObject.ReturnOfGoodsToVendor") Then
			Object.DeliveryMethod = Enums.TransportMethods.SelfPickup;
		ElsIf TypeOf(Object) = Type("DocumentObject.VendorInvoice") Then
			Object.DeliveryMethod = Enums.TransportMethods.ByVendorToOurWarehouse;
		ElsIf TypeOf(Object) = Type("DocumentObject.CustomerInvoice") Then
			Object.DeliveryMethod = Enums.TransportMethods.SelfPickup;
		EndIf;
	EndIf;
EndProcedure
Procedure FillInDivisionInPaymentTranscript(Object, ExchangeComponents)
	DefaultDepartment = Undefined;
	For Each String In Object.ARAPDetails Do
		If Not ValueIsFilled(String.Department) Then
			If DefaultDepartment = Undefined Then
				DefaultDepartment = DefaultElement(ExchangeComponents, "Department");
			EndIf;
			String.Department = DefaultDepartment;
		EndIf;
	EndDo;
EndProcedure
Procedure FillInDefaultDivision(ReceivedData, IBData, ExchangeComponents, FillInByCashAccount = False)
	If ValueIsFilled(ReceivedData.Department) Then
		Return;
	ElsIf IBData <> Undefined And ValueIsFilled(IBData.Department) Then
		// The division was filled in in the IB data - we will put it in the received data so that it does not get lost.
		ReceivedData.Department = IBData.Department;
		Return;
	EndIf;
	
	If FillInByCashAccount Then
		
		If IBData <> Undefined And Not ValueIsFilled(IBData.Department) 
			And ValueIsFilled(ReceivedData.CashRegister) Then			
			DivisionOfCashAccount = Common.ObjectAttributeValue(ReceivedData.CashRegister, "Department");	
			
			If ValueIsFilled(DivisionOfCashAccount) Then
				ReceivedData.Department = DivisionOfCashAccount;
				Return;
			EndIf;
			
		EndIf;
		
	EndIf;
	
	ReceivedData.Department = DefaultElement(ExchangeComponents, "Department");
EndProcedure
