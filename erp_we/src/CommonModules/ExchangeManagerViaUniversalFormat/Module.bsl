#Region DPR
#Region Send
Procedure AddSUB_Document_AdvanceReport(DataProcessingRules)
	ProcessingRule                         = DataProcessingRules.Add();
	ProcessingRule.Name                     = "Document_ExpenseReport";
	ProcessingRule.SelectionObjectMetadata = Metadata.Documents.ExpenseReport;
	ProcessingRule.OnProcess            = "DPR_Document_ExpenseReport_OnProcess";
	ProcessingRule.DataClearing           = False;
	ProcessingRule.OCRUsed.Add("Document_AdvanceReport_Dispatch");
	ProcessingRule.OCRUsed.Add("Document_AdvanceReportFromStructure_Sending");
EndProcedure
Procedure DPR_Document_ExpenseReport_OnProcess(IBData, UsageOCR, ExchangeComponents)
	If TypeOf(IBData) = Type("Structure") Then
		If IBData.Property("UploadDeletionByLink") Then
			UsageOCR.Document_AdvanceReport_Dispatch = False;
		Else
			UsageOCR.Delete("Document_AdvanceReport_Dispatch");
		EndIf;
		
		Return;
	EndIf;
	
	ClearUsageOCR(UsageOCR);
	
	RuleAdvanceReport = ExchangeComponents.DataProcessingRules.Find("Document_ExpenseReport", "Name");
	If RuleAdvanceReport = Undefined Then
		Return;
	EndIf;
	
	QueryText =
		"SELECT
		|	VendorInvoice.Ref AS VendorInvoice,
		|	VendorInvoice.Warehouse AS Warehouse,
		|	VendorInvoice.PriceIncludesVAT AS PriceIncludesVAT
		|INTO TTAcquisitionDocuments
		|FROM
		|	Document.VendorInvoice AS VendorInvoice
		|WHERE
		|	VendorInvoice.ExpenseReport = &Ref
		|	AND VendorInvoice.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseViaAdvanceHolder)
		|
		|GROUP BY
		|	VendorInvoice.Ref,
		|	VendorInvoice.Warehouse,
		|	VendorInvoice.PriceIncludesVAT
		|
		|INDEX BY
		|	VendorInvoice
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.LineNumber AS DocumentRowNumber,
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	Goods.Series AS Series,
		|	Goods.Products.UnitOfMeasure AS UnitOfMeasure,
		|	Goods.Count AS Count,
		|	CASE
		|		WHEN TTAcquisitionDocuments.PriceIncludesVAT
		|			THEN Goods.Sum
		|		ELSE Goods.Sum + Goods.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN Goods.Count > 0
		|			THEN CAST(CASE
		|						WHEN TTAcquisitionDocuments.PriceIncludesVAT
		|							THEN Goods.Sum
		|						ELSE Goods.Sum + Goods.VATAmount
		|					END / Goods.Count AS NUMBER(31, 2))
		|		ELSE 0
		|	END AS Price,
		|	CASE
		|		WHEN Goods.NumberOfPackages > 0
		|			THEN CAST(CASE
		|						WHEN TTAcquisitionDocuments.PriceIncludesVAT
		|							THEN Goods.Sum
		|						ELSE Goods.Sum + Goods.VATAmount
		|					END / Goods.NumberOfPackages AS NUMBER(31, 2))
		|		ELSE 0
		|	END AS PricePerPackaging,
		|	Goods.Package AS Package,
		|	Goods.NumberOfPackages AS NumberOfPackages,
		|	Goods.VATRate AS VATRate,
		|	Goods.VATAmount AS VATAmount,
		|	Goods.ExpenseItem AS ExpenseItem,
		|	&QueryTextShouldBeRecognizedAsExpensesForUSN_GoodsAndServices,
		|	Goods.CCDNumber AS CCDNumber,
		|	Goods.QuantityByGBRN AS QuantityByGBRN,
		|	Goods.ExpenseItem.OffsettingAccount AS OffsettingAccount,
		|	Goods.Ref.ToReturnReusablePackage AS ToReturnReusablePackage,
		|	Goods.Products.ItemsType AS ItemsType,
		|	Goods.Department AS Department,
		|	Goods.RowID AS RowID,
		|	Goods.Ref.Counterparty AS Vendor,
		|	Goods.Ref.IncomingDocumentDate AS IncomingDocumentDate,
		|	Goods.Ref.IncomingDocumentNumber AS IncomingDocumentNumber,
		|	Goods.Ref.Currency AS Currency,
		|	Goods.Ref.BusinessOperation AS BusinessOperation
		|INTO TTProductsServices
		|FROM
		|	TTAcquisitionDocuments AS TTAcquisitionDocuments
		|		INNER JOIN Document.VendorInvoice.Goods AS Goods
		|		ON TTAcquisitionDocuments.VendorInvoice = Goods.Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	VendorInvoicePackageBarcodes.LineNumber AS DocumentRowNumber,
		|	VendorInvoicePackageBarcodes.PackageBarcode AS PackageBarcode
		|INTO TTBarcodesOfPackages
		|FROM
		|	Document.VendorInvoice.PackageBarcodes AS VendorInvoicePackageBarcodes
		|		INNER JOIN TTAcquisitionDocuments AS TTAcquisitionDocuments
		|		ON VendorInvoicePackageBarcodes.Ref = TTAcquisitionDocuments.VendorInvoice
		|WHERE
		|	&UnloadingBarcodesOfPackages
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	TTAcquisitionDocuments.Warehouse AS Warehouse
		|FROM
		|	TTAcquisitionDocuments AS TTAcquisitionDocuments
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTProducts_1.DocumentRowNumber AS DocumentRowNumber,
		|	TTProducts_1.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextPackage,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	TTProducts_1.UnitOfMeasure AS UnitOfMeasure,
		|	TTProducts_1.Count AS Count,
		|	TTProducts_1.Sum AS Sum,
		|	TTProducts_1.Price AS Price,
		|	TTProducts_1.VATRate AS VATRate,
		|	TTProducts_1.VATAmount AS VATAmount,
		|	TTProducts_1.ExpenseItem AS ExpenseItem,
		|	TTProducts_1.IncludeVUSNExpenses AS IncludeVUSNExpenses,
		|	TTProducts_1.RowID AS RowID,
		|	TTProducts_1.Vendor AS Vendor,
		|	TTProducts_1.IncomingDocumentDate AS IncomingDocumentDate,
		|	TTProducts_1.IncomingDocumentNumber AS IncomingDocumentNumber,
		|	CASE
		|		WHEN TTProducts_1.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|				AND TTProducts_1.ToReturnReusablePackage
		|			THEN ""ReturnContainers""
		|		ELSE CASE
		|				WHEN TTProducts_1.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement)
		|					THEN CAST(""CommissionGoods"" AS STRING(20))
		|				ELSE CAST(&OwnProducts AS STRING(20))
		|			END
		|	END AS InventoryType,
		|	TTProducts_1.Currency AS Currency
		|FROM
		|	TTProductsServices AS TTProducts_1
		|WHERE
		|	TTProducts_1.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NULL AS Products,
		|	AdvanceReportOtherExpenses.Counterparty AS Vendor,
		|	AdvanceReportOtherExpenses.Sum AS Sum,
		|	AdvanceReportOtherExpenses.VATRate AS VATRate,
		|	AdvanceReportOtherExpenses.VATAmount AS VATAmount,
		|	AdvanceReportOtherExpenses.CashFlowItem AS CashFlowItem,
		|	AdvanceReportOtherExpenses.Department AS Department,
		|	AdvanceReportOtherExpenses.ExpenseItem AS ExpenseItem,
		|	&RecognizeQueryTextAsExpensesForUSN_OtherExpenses, 
		|	AdvanceReportOtherExpenses.RowID AS RowID,
		|	AdvanceReportOtherExpenses.IncomingDocumentNumber AS IncomingDocumentNumber,
		|	AdvanceReportOtherExpenses.IncomingDocumentDate AS IncomingDocumentDate,
		|	AdvanceReportOtherExpenses.ExternalDocumentName AS ExternalDocumentName,
		|	AdvanceReportOtherExpenses.Content AS Content,
		|	AdvanceReportOtherExpenses.Currency AS Currency
		|FROM
		|	Document.ExpenseReport.OtherExpenses AS AdvanceReportOtherExpenses
		|		LEFT JOIN ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
		|		ON (ExpenseItems.Ref = AdvanceReportOtherExpenses.ExpenseItem)
		|		LEFT JOIN ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
		|		ON (AssetLiabilityItems.Ref = AdvanceReportOtherExpenses.ExpenseItem)
		|WHERE
		|	AdvanceReportOtherExpenses.Ref = &Ref
		|
		|UNION ALL
		|
		|SELECT
		|	TTServices.Products,
		|	TTServices.Vendor,
		|	TTServices.Sum,
		|	TTServices.VATRate,
		|	TTServices.VATAmount,
		|	NULL,
		|	TTServices.Department,
		|	TTServices.ExpenseItem,
		|	TTServices.IncludeVUSNExpenses,
		|	TTServices.RowID,
		|	TTServices.IncomingDocumentNumber,
		|	TTServices.IncomingDocumentDate,
		|	NULL,
		|	CASE
		|		WHEN (CAST(TTServices.Products.DescriptionFull AS STRING(5))) = ""     ""
		|			THEN TTServices.Products.Description
		|		ELSE CAST(TTServices.Products.DescriptionFull AS STRING(250))
		|	END,
		|	TTServices.Currency
		|FROM
		|	TTProductsServices AS TTServices
		|WHERE
		|	(TTServices.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
		|			OR TTServices.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	AdvanceReportPaymentToSuppliers.Counterparty AS Counterparty,
		|	AdvanceReportPaymentToSuppliers.Sum AS Sum,
		|	AdvanceReportPaymentToSuppliers.AmountARAP AS AmountARAP,
		|	AdvanceReportPaymentToSuppliers.Comment AS Content,
		|	AdvanceReportPaymentToSuppliers.IncomingDocumentNumber AS IncomingDocumentNumber,
		|	AdvanceReportPaymentToSuppliers.IncomingDocumentDate AS IncomingDocumentDate,
		|	AdvanceReportPaymentToSuppliers.ARAPObject.Object AS OrderDocument,
		|	AdvanceReportPaymentToSuppliers.ARAPCurrency AS ARAPCurrency,
		|	ISNULL(RelativeExchangeRate.CourseNumerator, 1) AS TransactionRate,
		|	ISNULL(RelativeExchangeRate.CourseDenominator, 1) AS Multiplier_,
		|	AdvanceReportPaymentToSuppliers.Currency AS Currency
		|FROM
		|	Document.ExpenseReport.PaymentToVendors AS AdvanceReportPaymentToSuppliers
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS RelativeExchangeRate
		|		ON AdvanceReportPaymentToSuppliers.ARAPCurrency = RelativeExchangeRate.Currency
		|WHERE
		|	AdvanceReportPaymentToSuppliers.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber,
		|	TTBarcodesOfPackages.PackageBarcode AS PackageMarking
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|";
	
	FillInYourOwnProductsInText(QueryText);
	
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "TTProducts_1"));
	
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "TTProducts_1"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "TTProducts_1"));
		
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "TTProducts_1"));
			
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "TTProducts_1"));
		
	STSIsAppliedIncomeMinusExpenses = False;
		
	
	QueryText = StrReplace(QueryText, "&RecognizeQueryTextAsExpensesForUSN_OtherExpenses",
		QueryTextRecognizeAsSTSExpenses(ExchangeComponents, "AdvanceReportOtherExpenses", STSIsAppliedIncomeMinusExpenses));  
	
	QueryText = StrReplace(QueryText, "&QueryTextShouldBeRecognizedAsExpensesForUSN_GoodsAndServices",
		QueryTextRecognizeAsSTSExpenses(ExchangeComponents, "Goods", STSIsAppliedIncomeMinusExpenses));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref",                     IBData.Ref);
	Query.SetParameter("Date",                       IBData.Date);
	Query.SetParameter("BaseCurrency",              SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	Query.SetParameter("UnloadingBarcodesOfPackages", UnloadingBarcodesOfPackages(ExchangeComponents));
	
	QueryResults = Query.ExecuteBatch();
	
	PurchaseHeaderData	= QueryResults[QueryResults.Count() - 6].Select();
	Goods					= QueryResults[QueryResults.Count() - 5].Unload();
	OtherExpenses			= QueryResults[QueryResults.Count() - 4].Unload();
	PaymentToCounterparties		= QueryResults[QueryResults.Count() - 3].Unload();
	ExciseStamps			= QueryResults[QueryResults.Count() - 2].Unload();
	PackageMarkings		= QueryResults[QueryResults.Count() - 1].Unload();
	
	If Goods.Total("Sum") + OtherExpenses.Total("Sum") + PaymentToCounterparties.Total("Sum") = 0 Then
		Return;
	EndIf;
	
	Warehouse = Undefined;
	If PurchaseHeaderData.Next() Then
		Warehouse = PurchaseHeaderData.Warehouse;
	EndIf;
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "PurchaseForActivity", "PurchaseForActivity");
	
	#Region OtherExpenses
	OtherExpenses.Columns.Add("CostDivision");
	OtherExpenses.Columns.Add("CostAccount");
	OtherExpenses.Columns.Add("CostItem");
	For Each LineOther In OtherExpenses Do
		If ValueIsFilled(LineOther.Department) Then
			StructureDivision = New Structure();
			UnloadDivision(IBData, StructureDivision, LineOther.Department);
			LineOther.CostDivision = StructureDivision.Department;
		EndIf;
		LineOther.CostAccount = AccountingInvoiceForArticle(LineOther.ExpenseItem, IBData.Organization, LineOther.Department, IBData.Date);
	EndDo;
	
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, OtherExpenses, "PurchaseForActivity", "PurchaseForActivity");
	
	#EndRegion
	
	#Region PaymentToCounterparties
	
	// Filling out the contract
	PaymentToCounterparties.Columns.Add("Contract");
	PaymentToCounterparties.Columns.Add("DocumentOfARAPAccounting");
	For Each TableRow In PaymentToCounterparties Do
		CurTreaty = Undefined;
		CalculationsInConventionalUnits = False;
		Terms = Undefined;
		If ValueIsFilled(TableRow.OrderDocument) Then
			
			If TypeOf(TableRow.OrderDocument) = Type("DocumentRef.VendorInvoice") Then
				TableRow.DocumentOfARAPAccounting = TableRow.OrderDocument;
			EndIf;
			
			If TypeOf(TableRow.OrderDocument) = Type("CatalogRef.CounterpartyContracts") Then
				CurTreaty = TableRow.OrderDocument;
			EndIf;
				
			If CurTreaty = Undefined Then
				If TableRow.OrderDocument.Metadata().Attributes.Find("Contract") <> Undefined Then
					CurTreaty = Common.ObjectAttributeValue(TableRow.OrderDocument, "Contract");
				Else
					// The contract could not be determined from the order. The contract will be calculated later.
					CurTreaty = Undefined;
				EndIf;
				If TableRow.OrderDocument.Metadata().Attributes.Find("Terms") <> Undefined Then
					Terms = Common.ObjectAttributeValue(TableRow.OrderDocument, "Terms");
				Else
					// The agreement could not be determined from the order. The agreement will be calculated later.
					Terms = Undefined;
				EndIf;
			EndIf;
		EndIf;
		If CurTreaty <> Undefined And ValueIsFilled(CurTreaty) Then
			TableRow.Contract = CurTreaty;
			Continue;
		EndIf;
		If ValueIsFilled(Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> TableRow.ARAPCurrency;
		EndIf;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.TypeOfAgreement = "WithVendor";
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.Counterparty = TableRow.Counterparty;
		DefaultParameters.ARAPCurrency = TableRow.ARAPCurrency;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", TableRow.OrderDocument, Terms, Undefined);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		TableRow.Contract = Contract;
	EndDo;
	
	#EndRegion
	
	#Region PrepaymentsToVendor_
	
	PrepaymentsToVendor_ = New ValueTable;
	PrepaymentsToVendor_.Columns.Add("Document");
	PrepaymentsToVendor_.Columns.Add("Sum");
	PrepaymentsToVendor_.Columns.Add("Currency");
	If ValueIsFilled(IBData.DocumentBasis)
		And Common.RefExists(IBData.DocumentBasis)Then
	
		OCRName = "";
		If TypeOf(IBData.DocumentBasis) = Type("DocumentRef.CashVoucher") Then
			OCRName = "Document_RCOSettlementsWithEmployees_Sending";
		ElsIf TypeOf(IBData.DocumentBasis) = Type("DocumentRef.BankAccountIssue") Then
			OCRName = "Document_SBDSSettlementsWithEmployees_Sending";
		EndIf;
		If ValueIsFilled(OCRName) Then
			Instruction = New Structure("Value, OCRName", IBData.DocumentBasis, OCRName);
			
			DetailsOfFoundation = Common.ObjectAttributesValues(IBData.DocumentBasis, "Currency, DocumentAmount");
			
			AdvanceLine = PrepaymentsToVendor_.Add();
			FillPropertyValues(AdvanceLine, DetailsOfFoundation);
			AdvanceLine.Document = Instruction;
			
		EndIf;
	EndIf;
	
	#EndRegion
	
	AdditionalAttributes = IBData.AdditionalAttributes.Unload();
	
	If Not IBData.Multicurrency Then
		InformationSecurityDataStructure = New Structure("Ref, Number, Date, Organization, Department, Currency, 
		|DocumentsCount, SheetQuantity, Comment, AdvancePurpose, AdvanceHolder, DocumentBasis, PurchaseForActivity");
		FillPropertyValues(InformationSecurityDataStructure, IBData);
		
		InformationSecurityDataStructure.Insert("EmployeeResponsible",           IBData.Author);
		InformationSecurityDataStructure.Insert("Goods",                  Goods);
		InformationSecurityDataStructure.Insert("OtherExpenses",           OtherExpenses);
		InformationSecurityDataStructure.Insert("PaymentToCounterparties",      PaymentToCounterparties);
		InformationSecurityDataStructure.Insert("PrepaymentsToVendor_",          PrepaymentsToVendor_);
		InformationSecurityDataStructure.Insert("AdditionalAttributes", AdditionalAttributes);
		If ValueIsFilled(Warehouse) Then
			InformationSecurityDataStructure.Insert("Warehouse", Warehouse);
		EndIf;
		
		DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, 
			InformationSecurityDataStructure, 
			RuleAdvanceReport);
	Else
		ArrayOfCurrencies = New Array;
		CommonClientServer.SupplementArray(ArrayOfCurrencies,
			Goods.UnloadColumn("Currency"), True);
		CommonClientServer.SupplementArray(ArrayOfCurrencies,
			OtherExpenses.UnloadColumn("Currency"), True);
		CommonClientServer.SupplementArray(ArrayOfCurrencies,
			PaymentToCounterparties.UnloadColumn("Currency"), True);
		
		Query = New Query(
		"SELECT
		|	Currencies.Ref AS Currency,
		|	ISNULL(SUBSTRING(Currencies.Description, 1, 2), """") AS CurrencyPrefix_
		|FROM
		|	Catalog.Currencies AS Currencies
		|WHERE
		|	Currencies.Ref IN(&Currencies)");
		Query.SetParameter("Currencies", ArrayOfCurrencies);
	
		Document_Currencies = Query.Execute().Unload();
		
		CurrencyOfComplianceAccounting   = LocalAccountingCurrency(IBData.Organization);
		UnloadingDeletion = (Document_Currencies.Find(CurrencyOfComplianceAccounting, "Currency") = Undefined);
		
		For Each DocumentCurrency In Document_Currencies Do
			
			CurrencySelection_2 = New Structure("Currency", DocumentCurrency.Currency);
			
			ProductsByCurrency             = Goods.Copy(CurrencySelection_2);
			OtherExpensesByCurrency      = OtherExpenses.Copy(CurrencySelection_2);
			PaymentToCounterpartiesByCurrency = PaymentToCounterparties.Copy(CurrencySelection_2);
			AdvancesIssuedByCurrency     = PrepaymentsToVendor_.Copy(CurrencySelection_2);
			
			InformationSecurityDataStructure = New Structure("Number, Date, Organization, Department,
			|DocumentsCount, SheetQuantity, Comment, AdvancePurpose, AdvanceHolder, DocumentBasis, PurchaseForActivity");
			FillPropertyValues(InformationSecurityDataStructure, IBData);
			
			If DocumentCurrency.Currency = CurrencyOfComplianceAccounting Then
				InformationSecurityDataStructure.Insert("Ref", IBData.Ref);
			Else
				NumberWithoutPrefixes = ObjectsPrefixesClientServer.DeletePrefixesFromObjectNumber(IBData.Number, True, True);
				StandardPrefixes = StrReplace(IBData.Number, NumberWithoutPrefixes, "");
				NumberPrefix = StandardPrefixes + DocumentCurrency.CurrencyPrefix_;
				NumberForPrinting = ObjectsPrefixesClientServer.NumberForPrinting(IBData.Number, True, True);
				If StrLen(NumberPrefix + NumberForPrinting) <= 11 Then
					InformationSecurityDataStructure.Number = NumberPrefix
						+ StringFunctionsClientServer.SupplementString(NumberForPrinting, 11 - StrLen(NumberPrefix));
				EndIf;
			EndIf;
			
			InformationSecurityDataStructure.Insert("EmployeeResponsible",           IBData.Author);
			InformationSecurityDataStructure.Insert("Currency",                  DocumentCurrency.Currency);
			InformationSecurityDataStructure.Insert("Goods",                  ProductsByCurrency);
			InformationSecurityDataStructure.Insert("OtherExpenses",           OtherExpensesByCurrency);
			InformationSecurityDataStructure.Insert("PaymentToCounterparties",      PaymentToCounterpartiesByCurrency);
			InformationSecurityDataStructure.Insert("PrepaymentsToVendor_",          AdvancesIssuedByCurrency);
			InformationSecurityDataStructure.Insert("AdditionalAttributes", AdditionalAttributes);
			If ValueIsFilled(Warehouse) Then
				InformationSecurityDataStructure.Insert("Warehouse", Warehouse);
			EndIf;
			
			If UnloadingDeletion Then
				InformationSecurityDataStructure.Insert("UploadDeletionByLink", True);
				InformationSecurityDataStructure.Insert("Ref", IBData.Ref);
				UnloadingDeletion = False;
			EndIf;
			
			DataExchangeXDTOServer.ExportSelectionObject(ExchangeComponents, 
				InformationSecurityDataStructure, 
				RuleAdvanceReport);
		EndDo;
	EndIf;
EndProcedure

