	FillingRules.Insert("Sum",                "SumCompl");
	FillingRules.Insert("AmountARAP",  "AmountARAP");
	FillingRules.Insert("ARAPCurrency", "ARAPCurrency");
	DownloadTSDebtAdjustment(ExchangeComponents, XDTOData, ReceivedData, "AccountsReceivable", "AccountsReceivable", FillingRules);
	DownloadTSDebtAdjustment(ExchangeComponents, XDTOData, ReceivedData, "AccountsPayable", "AccountsPayable", FillingRules);
