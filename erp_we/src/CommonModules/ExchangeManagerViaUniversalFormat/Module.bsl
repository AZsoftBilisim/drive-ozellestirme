	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
EndProcedure
Procedure PCO_Catalog_PriceTypes_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents, True);
	ReceivedData.PricingMethod = Enums.PriceSettingMethods.Manually;
	ReceivedData.UseWhileSellingToCustomers = True;
	
	// If the identifier generated by the name is busy, the auto-generated one is set.
	ReceivedData.Id = TMCommonUseClientServer.GetID(ReceivedData.Description);
	Query = New Query();
	Query.Text = "
		|SELECT
		|	1 AS Field1
		|FROM
		|	Catalog.TypesOfPrices AS TypesOfPrices
		|WHERE
		|	TypesOfPrices.Id = &Id";
	Query.SetParameter("Id", ReceivedData.Id);
	If Not Query.Execute().IsEmpty() Then
		ReceivedData.Id = String(New UUID());
	EndIf;
	
	If XDTOData.KeyProperties.Property("PriceCurrency")
		And ValueIsFilled(XDTOData.KeyProperties.PriceCurrency) Then
	
		CurrencyValue = XDTOData.KeyProperties.PriceCurrency; 
		If CurrencyValue.Property("Ref") Then
			OCRName = "Catalog_Currencies";
		Else
			OCRName = "Catalog___FromStructure";
		EndIf;
		ReceivedData.AdditionalProperties.Insert("PriceCurrency", New Structure("Value, OCRName", CurrencyValue, OCRName));
	EndIf;
EndProcedure
Procedure PCO_Catalog_PriceTypes_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IBData <> Undefined Then
		
		// ID: The "do not overfill" logic.
		If ValueIsFilled(IBData.Id) Then
			ReceivedData.Id = IBData.Id;
		EndIf;
		
		// The method of setting the price: the logic of "do not overfill".
		If ValueIsFilled(IBData.PricingMethod) Then
			ReceivedData.PricingMethod = IBData.PricingMethod;
		EndIf;
		
		// Use on sale: the "do not overfill" logic.
		ReceivedData.UseWhileSellingToCustomers = IBData.UseWhileSellingToCustomers;
	
	EndIf;
	
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
								ReceivedData.AdditionalProperties, ExchangeComponents);
EndProcedure

