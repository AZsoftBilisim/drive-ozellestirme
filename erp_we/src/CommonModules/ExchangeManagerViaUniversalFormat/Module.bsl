Procedure PCO_Document_ApplicationForCashExpenseCalculationsWithCounter_Receipt_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashIssueAsLoanToEmployee;
	
	PossibleBusinessTransactions = Enums.BusinessTransactions;
	ARAPType = XDTOData.ARAPType.Value;
	If ARAPType = "WithVendor" Then
		ReceivedData.BusinessOperation = PossibleBusinessTransactions.PaymentToVendor;
	ElsIf ARAPType = "WithCustomer" Then
		ReceivedData.BusinessOperation = PossibleBusinessTransactions.RefundToCustomer;
	ElsIf ARAPType = "LoansAndBorrowings" Then
		ReceivedData.BusinessOperation = PossibleBusinessTransactions.PaymentOnLoansAndBorrowingsReceived;
	ElsIf ARAPType = "CreditToCounterparty" Then
		ReceivedData.BusinessOperation = PossibleBusinessTransactions.PaymentOnLoansAndBorrowingsReceived;
	Else
		ReceivedData.BusinessOperation = PossibleBusinessTransactions.OtherCashIssue;
	EndIf;
	
	ReceivedData.CashFlowItem = 
		Catalogs.CashFlowReportItems.CashFlowItemForBusinessTransaction(ReceivedData.BusinessOperation);
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	#Region ARAPDetails
	
	FillInContract = (ARAPType = "WithCustomer" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithClientsAreUsed)
					Or (ARAPType = "WithVendor" And ExchangeComponents.ConversionParameters_SSLy.ContractsWithSuppliersAreUsed);
	
	AvailableSettlementColumns = AvailableColumnsForFillingInSettlementData(XDTOData.ARAPDetails, FillInContract);
	
	ArrayOfStringsDecryption = New Array;
	For Each String In XDTOData.ARAPDetails Do
		FillingRules = New Map;
		FillingRules.Insert("Sum", "Sum");
		FillingRules.Insert("AmountARAP", "AmountARAP");
		FillingRules.Insert("CFItem", "CashFlowItem");
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		//CurrencyOfConversion
		ARAPCurrency = String.ARAPCurrency;
		If TypeOf(ARAPCurrency) = Type("Structure")
			And ARAPCurrency.Property("Ref") = False Then
			OCRName = "Catalog___FromStructure";
		Else
			OCRName = "Catalog_Currencies";
		EndIf;
		Instruction = New Structure("Value, OCRName", ARAPCurrency, OCRName);
		StringDataStructure.Insert("ARAPCurrency", Instruction);
		
		AddSettlementDataToPaymentTranscript(ExchangeComponents, String, StringDataStructure, AvailableSettlementColumns);	
		
		ArrayOfStringsDecryption.Add(StringDataStructure);
	EndDo;
	ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfStringsDecryption);
	
	#EndRegion
	//++ NOT TM
	
	
	//-- DON'T TM
	ReceivedData.Posted = True;
EndProcedure
