Procedure PCO_ReportCommissionBetweenOrganizations_Commitee_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "I";
	DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	XDTOData.KeyProperties.Insert("Number", DocNumber);
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"ReportCommissionBetweenOrganizations_Commitee_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	UnloadDivision(IBData, XDTOData);
	
	If IBData.ARAPAccountingViaSeparateCounterparty Then
		CounterpartyRef = IBData.Counterparty;
	Else
		CounterpartyRef = CounterpartyFromOrganization(IBData.Organization, ExchangeComponents);
	EndIf;
	XDTOData.Insert("Counterparty", CounterpartyRef);
	
	#Region Contract
	
	InstructionsContract = Undefined;
	If IBData.ARAPAccountingViaSeparateCounterparty
		And ValueIsFilled(IBData.SalesContract)
		And Common.RefExists(IBData.SalesContract) Then
			InstructionsContract = New Structure;
			InstructionsContract.Insert("OCRName",   "Catalog_CounterpartyContracts");
			InstructionsContract.Insert("Value", IBData.SalesContract);
		
	ElsIf ValueIsFilled(IBData.Contract) Then
		
		ContractData = ContractDataBetweenOrganizations(ExchangeComponents, IBData.Contract);
		InstructionsContract = New Structure("Value, OCRName", ContractData, "Catalog_ContractsOfCounterparties_FromStructure");
		
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.TypeOfAgreement              = "WithConsignor";
		DefaultParameters.Organization              = IBData.Consignee;
		DefaultParameters.Counterparty               = CounterpartyRef;
		DefaultParameters.ARAPCurrency     = IBData.Currency;
		DefaultParameters.CalculationsInConventionalUnits = False;
		InstructionsContract = ConversionAgreementBasedOnSettlementData(DefaultParameters,
							ExchangeComponents,
							IBData.Contract);
	EndIf;
	XDTOData.Insert("Contract", InstructionsContract);
	
	#EndRegion
	
	XDTOData.Insert("AmountIncludesVAT", True);
	
	UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
	
	// Table part
	QueryText =
	"SELECT
	|	ReportOnCommissionsBetweenOrganizations.LineNumber AS DocumentRowNumber,
	|	ReportOnCommissionsBetweenOrganizations.Products AS Products,
	|	ReportOnCommissionsBetweenOrganizations.Characteristic AS Characteristic,
	|	ReportOnCommissionsBetweenOrganizations.Products.UnitOfMeasure AS UnitOfMeasure,
	|	ReportOnCommissionsBetweenOrganizations.Count AS Count,
	|	CASE
	|		WHEN ReportOnCommissionsBetweenOrganizations.Count = 0
	|			THEN 0
	|		ELSE CASE
	|				WHEN ReportOnCommissionsBetweenOrganizations.AmountIncludingVAT / ReportOnCommissionsBetweenOrganizations.Count < 0.01
	|					THEN 0.01
	|				ELSE CAST(ReportOnCommissionsBetweenOrganizations.AmountIncludingVAT / ReportOnCommissionsBetweenOrganizations.Count AS NUMBER(31, 2))
	|			END
	|	END AS ReceiptPrice,
	|	ReportOnCommissionsBetweenOrganizations.AmountIncludingVAT AS OrderReceiptAmount,
	|	CASE
	|		WHEN ReportOnCommissionsBetweenOrganizations.Count = 0
	|			THEN 0
	|		ELSE CASE
	|				WHEN ReportOnCommissionsBetweenOrganizations.SalesAmount / ReportOnCommissionsBetweenOrganizations.Count < 0.01
	|					THEN 0.01
	|				ELSE CAST(ReportOnCommissionsBetweenOrganizations.SalesAmount / ReportOnCommissionsBetweenOrganizations.Count AS NUMBER(31, 2))
	|			END
	|	END AS Price,
	|	ReportOnCommissionsBetweenOrganizations.SalesAmount AS Sum,
	|	ReportOnCommissionsBetweenOrganizations.AmountSalesVAT AS VATAmount,
	|	ReportOnCommissionsBetweenOrganizations.VATRate AS VATRate,
	|	ReportOnCommissionsBetweenOrganizations.CommissionAmount AS CommissionAmount,
	|	ReportOnCommissionsBetweenOrganizations.AmountVATRemuneration AS AmountVATRemuneration,
	|	ReportOnCommissionsBetweenOrganizations.DateOfTaxInvoiceIssuedByCommissionAgent AS SaleDate,
	|	ReportOnCommissionsBetweenOrganizations.Customer AS Customer
	|FROM
	|	Document.CommissionReportIntercompany.Goods AS ReportOnCommissionsBetweenOrganizations
	|WHERE
	|	ReportOnCommissionsBetweenOrganizations.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InventoryKinds.Count AS Count,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
	|			THEN CASE
	|					WHEN InventoryKinds.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|						THEN CAST(""CommissionGoods"" AS STRING(20))
	|					ELSE CAST(&OwnProducts AS STRING(20))
	|				END
	|		ELSE CAST(&OwnProducts AS STRING(20))
	|	END AS InventoryType,
	|	InventoryKinds.DateOfTaxInvoiceIssuedByCommissionAgent AS SaleDate,
	|	InventoryKinds.Customer AS Customer,
	|	Dimension.Products AS Products,
	|	Dimension.Characteristic AS Characteristic
	|FROM
	|	Document.CommissionReportIntercompany.InventoryKinds AS InventoryKinds
	|		INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
	|		ON InventoryKinds.ItemsLocationAttributes = Dimension.DimensionKey
	|WHERE
	|	InventoryKinds.Ref = &Ref
	|	AND InventoryKinds.Count > 0";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
	GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "Dimension"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
	GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
	
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	
	QueryResults = Query.ExecuteBatch();
	
	Goods = QueryResults[0].Unload();
	InventoryKinds = QueryResults[1].Select();
	
	If Goods.Total("AmountVATRemuneration") <> IBData.AmountVATRemuneration Then
		
		BaseOfDistributionByAmountOfRemuneration = Goods.UnloadColumn("CommissionAmount");
		DistributionOfVATRemuneration = Common.DistributeAmountInProportionToCoefficients(IBData.AmountVATRemuneration, 
		BaseOfDistributionByAmountOfRemuneration);
		
		If ValueIsFilled(DistributionOfVATRemuneration) Then
			Goods.LoadColumn(DistributionOfVATRemuneration, "AmountVATRemuneration");
		EndIf;
		
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		
		Goods.Columns.Add("CCDNumber");
		Goods.Columns.Add("OriginCountry");
		Goods.Columns.Add("NumberOfRNPT");
		Goods.Columns.Add("TracedGoods");
		Goods.Columns.Add("UnitOfTraceability");
		
		SearchAttributes = "Products, Characteristic, SaleDate, Customer";
		
		DetailsToFillIn = "CCDNumber, OriginCountry, NumberOfRNPT, TracedGoods, UnitOfTraceability";
		TheStructureOfTheSearch = New Structure(SearchAttributes);
		
		While InventoryKinds.Next() Do
			FillPropertyValues(TheStructureOfTheSearch, InventoryKinds);
			FoundRows = Goods.FindRows(TheStructureOfTheSearch);
			RemainingInventoryKinds = InventoryKinds.Count;
			
			For Each DocumentLine In FoundRows Do
				If RemainingInventoryKinds = 0 Then
					Break;
				EndIf;
				
				If DocumentLine.Count <= RemainingInventoryKinds Then
					FillPropertyValues(DocumentLine, InventoryKinds, DetailsToFillIn); 
					If ValueIsFilled(DocumentLine.TracedGoods) And DocumentLine.TracedGoods And TypeOf(DocumentLine.CCDNumber) = Type("String") Then
						CatOfDocumentIsCCDNumber = Catalogs.CCDNumbers.FindByCode(InventoryKinds.CCDNumber);  
						If Not ValueIsFilled(CatOfDocumentIsCCDNumber) Then
							DocumentLine.CCDNumber = Catalogs.CCDNumbers.EmptyRef();
						Else 	
							DocumentLine.CCDNumber = CatOfDocumentIsCCDNumber.Ref;
						EndIf;
					EndIf;
					RemainingInventoryKinds = RemainingInventoryKinds - DocumentLine.Count;
				Else
					// Selecting a new line with a filled inventory view.
					NewRow = Goods.Add();
					FillPropertyValues(NewRow, DocumentLine);
					
					PercentageOfInventoryTypeInDocumentLine = RemainingInventoryKinds / DocumentLine.Count;
					NewRow.Count             = RemainingInventoryKinds;
					NewRow.OrderReceiptAmount       = Round(DocumentLine.OrderReceiptAmount * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.Sum                  = Round(DocumentLine.Sum * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.VATAmount               = Round(DocumentLine.VATAmount * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.CommissionAmount    = Round(DocumentLine.CommissionAmount * PercentageOfInventoryTypeInDocumentLine, 2);
					NewRow.AmountVATRemuneration = Round(DocumentLine.AmountVATRemuneration * PercentageOfInventoryTypeInDocumentLine, 2);
					FillPropertyValues(NewRow, InventoryKinds, DetailsToFillIn);
					
					DocumentLine.Count             = DocumentLine.Count - NewRow.Count;
					DocumentLine.OrderReceiptAmount       = DocumentLine.OrderReceiptAmount - NewRow.OrderReceiptAmount;
					DocumentLine.Sum                  = DocumentLine.Sum - NewRow.Sum;
					DocumentLine.VATAmount               = DocumentLine.VATAmount - NewRow.VATAmount;
					DocumentLine.CommissionAmount    = DocumentLine.CommissionAmount - NewRow.CommissionAmount;
					DocumentLine.AmountVATRemuneration = DocumentLine.AmountVATRemuneration - NewRow.AmountVATRemuneration;
					RemainingInventoryKinds = 0;
				EndIf;
			EndDo;
		EndDo;
	EndIf;
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	XDTOData.Insert("Goods", Goods);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

