Procedure OCR_Document_ReturnOfGoodsFromCustomerFee_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "R";
	DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	
	XDTOData.KeyProperties.Insert("Number", DocNumber);
	
	If ExportStack.Count() > 1 Then
	
		Return;
		
	EndIf;
	
	#Region Header 
	
	UnloadDivision(IBData, XDTOData); 
	UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
	
	#EndRegion
		
	QueryText = 
	"SELECT
	|	ReturnOfGoodsFromCustomer.Ref AS Ref,
	|	ReturnOfGoodsFromCustomer.CustomerCounterparty AS Counterparty,
	|	ReturnOfGoodsFromCustomer.CustomerContract AS CustomerContract
	|INTO DocumentHeaderData
	|FROM
	|	Document.ReturnOfGoodsFromCustomer AS ReturnOfGoodsFromCustomer
	|WHERE
	|	ReturnOfGoodsFromCustomer.Ref = &Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InventoryKinds.Ref.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
	|	CASE
	|		WHEN InventoryKinds.ProductsRecordingAsReceived = VALUE(Catalog.Products.EmptyRef)
	|			THEN InventoryKinds.ItemsLocationAttributes.Products
	|		ELSE InventoryKinds.ProductsRecordingAsReceived
	|	END AS Products,
	|	CASE
	|		WHEN InventoryKinds.CharacteristicRecordingAsReceived = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|			THEN InventoryKinds.ItemsLocationAttributes.Characteristic
	|		ELSE InventoryKinds.CharacteristicRecordingAsReceived
	|	END AS Characteristic,
	|	InventoryKinds.Package AS Package,
	|	1 AS RowKey,
	|	InventoryKinds.Count AS Count,
	|	InventoryKinds.NumberOfPackages AS NumberOfPackages,
	|	InventoryKinds.AmountIncludingVAT AS AmountIncludingVAT,
	|	InventoryKinds.VATRate AS VATRate,
	|	InventoryKinds.VATAmount AS VATAmount,
	|	CASE
	|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.FromCurrentDocument)
	|			THEN 0
	|		WHEN InventoryKinds.CostDefiningMethod = VALUE(Enum.WaysToCalculateReturnCost.Manually)
	|			THEN CASE
	|					WHEN ISNULL(&Rate, 0) > 0
	|							AND ISNULL(&Repetition, 0) > 0
	|						THEN CAST(InventoryKinds.CostLocal / &Rate / &Repetition AS NUMBER(31, 2))
	|					ELSE 0
	|				END
	|		ELSE 0
	|	END AS Cost_,
	|	InventoryKinds.Ref.PriceIncludesVAT AS PriceIncludesVAT,
	|	InventoryKinds.CCDNumber AS CCDNumber,
	|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
	|	CASE
	|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN CAST(""CommissionGoods"" AS STRING(20))
	|		ELSE CAST(&OwnProducts AS STRING(20))
	|	END AS InventoryType,
	|	InventoryKinds.ItemsLocationAttributes.Series AS Series
	|INTO InventoryKinds
	|FROM
	|	Document.ReturnOfGoodsFromCustomer.InventoryKinds AS InventoryKinds
	|		INNER JOIN DocumentHeaderData AS DocumentHeaderData
	|		ON InventoryKinds.Ref = DocumentHeaderData.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DocumentHeaderData.Counterparty AS Customer,
	|	DocumentHeaderData.CustomerContract AS ContractOfBuyerOfCommissionGoods,
	|	1 AS RowKey
	|FROM
	|	DocumentHeaderData AS DocumentHeaderData
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	MAX(CASE
	|			WHEN InvoiceIssued.Ref IS NULL
	|				THEN FALSE
	|			ELSE TRUE
	|		END) AS SetSF,
	|	ISNULL(InvoiceIssued.Ref.DATE, UNDEFINED) AS InvoiceDate,
	|	1 AS RowKey,
	|	ISNULL(InvoiceIssued.Ref.Number, """") AS InvoiceNumber,
	|	DocumentHeaderData.Counterparty AS Counterparty,
	|	ISNULL(InvoiceIssued.Ref, UNDEFINED) AS TaxInvoice,
	|	DocumentHeaderData.CustomerContract AS ContractOfBuyerOfCommissionGoods
	|FROM
	|	DocumentHeaderData AS DocumentHeaderData
	|		LEFT JOIN Document.InvoiceIssued.BasisDocuments AS InvoiceIssued
	|		ON DocumentHeaderData.Ref = InvoiceIssued.DocumentBasis
	|
	|GROUP BY
	|	DocumentHeaderData.Counterparty,
	|	DocumentHeaderData.CustomerContract,
	|	ISNULL(InvoiceIssued.Ref.DATE, UNDEFINED),
	|	ISNULL(InvoiceIssued.Ref.Number, """"),
	|	ISNULL(InvoiceIssued.Ref, UNDEFINED)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InventoryKinds.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
	|	InventoryKinds.Products AS Products,
	|	InventoryKinds.Products.UnitOfMeasure AS UnitOfMeasure,
	|	InventoryKinds.RowKey AS RowKey,
	|	&QueryTextCharacteristic,
	|	&QueryTextSeries,
	|	&QueryTextProductBatchID,
	|	&TextOfCCDRequest,
	|	&QueryTextPackage,
	|	InventoryKinds.Count AS Count,
	|	InventoryKinds.VATRate AS VATRate,
	|	InventoryKinds.VATAmount AS VATAmount,
	|	CAST(CASE
	|			WHEN InventoryKinds.PriceIncludesVAT
	|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
	|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
	|		END AS NUMBER(31, 2)) AS Price,
	|	CASE
	|		WHEN InventoryKinds.PriceIncludesVAT
	|			THEN InventoryKinds.AmountIncludingVAT
	|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
	|	END AS Sum,
	|	InventoryKinds.Cost_ AS Cost_,
	|	InventoryKinds.InventoryType AS InventoryType
	|FROM
	|	InventoryKinds AS InventoryKinds";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds"));
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "InventoryKinds"));
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds"));
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "InventoryKinds"));
		
	Query = New Query(QueryText);
	
	If IBData.Currency = LocalAccountingCurrency(IBData.Organization) Then
		
		Query.SetParameter("Rate", 1);
		Query.SetParameter("Repetition", 1);
		
	Else
		
		CurrencyExchangeRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(IBData.Currency, IBData.Date,
			SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
		
		Query.SetParameter("Rate", CurrencyExchangeRate.CourseNumerator);
		Query.SetParameter("Repetition", CurrencyExchangeRate.CourseDenominator);
		
	EndIf;
	
	Query.SetParameter("Ref", IBData.Ref);
	
	QueryResult = Query.ExecuteBatch();
	
	Buyers = QueryResult[2].Unload();
	ReturnCounterparties = QueryResult[3].Unload();
	CustomerRefunds = QueryResult[4].Unload();
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, CustomerRefunds);
	
	XDTOData.Insert("CustomerRefunds", CustomerRefunds);
	XDTOData.Insert("ReturnCounterparties", ReturnCounterparties);
	XDTOData.Insert("Buyers", Buyers);
	
EndProcedure

