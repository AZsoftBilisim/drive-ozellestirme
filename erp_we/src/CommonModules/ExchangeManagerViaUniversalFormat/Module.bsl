EndProcedure
Procedure DeferredProcessing_NonCashCashMovementDocuments(Object, ExchangeComponents)
	// Filling in partner analytics if necessary.
	If Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer
		Or Object.BusinessOperation = Enums.BusinessTransactions.RefundFromVendor
		Or Object.BusinessOperation = Enums.BusinessTransactions.PaymentToVendor
		Or Object.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer Then
		FillingInPartnerFieldInPaymentTranscript(Object);
		If Common.HasObjectAttribute("Partner", Object.Metadata()) Then
			FillingInPartnerInDocumentHeader(Object);
		EndIf;
		
		FillInCalculationObject = ExchangeComponents.ConversionParameters_SSLy.FillInCalculationObject; // Array
		FillInCalculationObject.Add(Object);	
		AddPrimaryPmDocumentsToDeferredProcessing(ExchangeComponents,
														Object.AdditionalProperties.ARAPDetails,
														Object.BusinessOperation);
	EndIf;
	
	// Filling in an individual's bank account, if necessary.
	If Object.BusinessOperation = Enums.BusinessTransactions.CashReturnByAdvanceHolder
		Or Object.BusinessOperation = Enums.BusinessTransactions.IssueCashToAdvanceHolder
		Or Object.BusinessOperation = Enums.BusinessTransactions.SalaryPaymentToBankAccounts Then
	
		If Not ValueIsFilled(Object.CounterpartyBankAccount) Then
			FillInIndividualSBankAccount(Object);
		EndIf;
		
	EndIf;
	
	// Filling out the cash register if necessary.
	If Object.BusinessOperation = Enums.BusinessTransactions.WithdrawalFromBankAccount Then
			
		CashRegisterAttributes = Common.ObjectAttributesValues(Object.CashAccountRecipient, "CashCurrency, Owner");
	
		If CashRegisterAttributes.CashCurrency <> Object.Currency 
			Or CashRegisterAttributes.Owner <> Object.Organization Then
			
			Department = Catalogs.BusinessStructure.EmptyRef();
			FilterParameters = New Structure(
				"Currency,Organization,Department",
				Object.Currency,
				Object.Organization,
				Department);
			
			Object.CashAccountRecipient = DefaultCheckout(FilterParameters, ExchangeComponents);
			
		EndIf;
	EndIf;
	
	If Object.BusinessOperation = Enums.BusinessTransactions.TransferOfTaxesAndContributions
		And Not ValueIsFilled(Object.TaxType) Then
		If Not ValueIsFilled(Object.TaxType) Then
			Object.TaxType = Catalogs.TaxContributionKinds.GetLinkOfPredefinedElement("OtherTaxesAndCharges");
		EndIf;
	EndIf;
	
	If Object.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices 
		And TypeOf(Object) = Type("DocumentObject.BankAccountIssue")
		And Not ValueIsFilled(Object.BankAccountBeneficiary) Then
		
		Query = New Query("
		|SELECT ALLOWED
		|	BankAccounts.Ref AS Ref
		|FROM
		|	Catalog.CompaniesBankAccounts AS BankAccounts
		|
		|WHERE
		|	BankAccounts.Owner IN (&Owner)
		|	AND BankAccounts.Ref <> &SenderBankAccount
		|");
		ArrayOfInterconnectedOrganizations = Catalogs.Companies.ArrayOfInterconnectedOrganizations(Object.Organization);
		Query.SetParameter("Owner", ArrayOfInterconnectedOrganizations);
		Query.SetParameter("SenderBankAccount", Object.BankAccount);
		
		RecipientAccounts = Query.Execute().Select();
		If RecipientAccounts.Count() = 1 Then
			RecipientAccounts.Next();
			Object.BankAccountBeneficiary = RecipientAccounts.Ref;
		EndIf;
	EndIf;
	
	
	FillingInArticleDDSVDocument(Object);
	FillInTableOfArticleDDSIKBusinessTransactions(Object, ExchangeComponents.ConversionParameters_SSLy.UploadedArticlesByDDSIKBusinessTransactions);
	FillOutApplicationForSpendingCash(Object);
	
	DocumentLine = SBDsTableGetFromParameters(ExchangeComponents).Find(Object.Ref, "DocumentRef");
	If DocumentLine <> Undefined Then
		LinkToCounterparty = Catalogs.Counterparties.GetRef(DocumentLine.Individual.UUID());
		If Not Common.RefExists(LinkToCounterparty) Then
			NewCounterparty = Catalogs.Counterparties.CreateItem();
			NewCounterparty.Description              = DocumentLine.Individual.Description;
			NewCounterparty.TIN                       = DocumentLine.Individual.TIN;
			NewCounterparty.CompanyIndividual = Enums.CompanyIndividual.Individual;
			NewCounterparty.LegalEntityIndividual                 = Enums.LegalEntityIndividual.Person;
			NewCounterparty.DescriptionFull        = DocumentLine.Individual.Description;
			NewCounterparty.MainCounterparty        = LinkToCounterparty;
			
			NewCounterparty.SetNewObjectRef(LinkToCounterparty);
			NewCounterparty.Write();
			LinkToCounterparty = NewCounterparty.Ref;
		EndIf;
		Object.Counterparty = LinkToCounterparty;
		
		Query = New Query("SELECT TOP 1
			|	CounterpartyBankAccounts.Ref AS LinkToAccount
			|FROM
			|	Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
			|		INNER JOIN Catalog.CounterpartyBankAccounts AS BankAccounts
			|		ON CounterpartyBankAccounts.AccountNumber = BankAccounts.AccountNumber
			|WHERE
			|	BankAccounts.Ref = &BankAccount
			|	AND CounterpartyBankAccounts.Owner = &Owner");
			
		Query.SetParameter("BankAccount", DocumentLine.BankAccount);
		Query.SetParameter("Owner",       LinkToCounterparty);
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			BankAccount = Selection.LinkToAccount;
		Else
			NewBankAccount = Catalogs.CounterpartyBankAccounts.CreateItem();
			FillPropertyValues(NewBankAccount, DocumentLine.BankAccount,, "Owner, Parent, Code");
			
			NewBankAccount.Owner = LinkToCounterparty;
			NewBankAccount.SetNewCode();
			NewBankAccount.Write();
			BankAccount = NewBankAccount.Ref;
		EndIf;
		Object.CounterpartyBankAccount = BankAccount;
	EndIf;
	
	
	FillInCourseAndMultiplicityInDecryptionLines(Object);
	
	DocumentType = TypeOf(Object.Ref);
	ListOfBusinessSalesOperations = CashServer.GetListOfBusinessSalesOperationsForDocument(DocumentType);
	ListOfBusinessProcurementOperations = CashServer.GetListOfPurchasingBusinessOperationsForDocument(DocumentType);
	
	If Not ListOfBusinessSalesOperations.Find(Object.BusinessOperation) = Undefined Then
		ObjectManager = Common.ObjectManagerByRef(Object.Ref);
		FillParameters = ObjectManager.ParametersForFillingInSalesVATTaxation(Object);
		VATAccountingERP.FillInSalesVATTaxation(Object.VATTaxation, FillParameters, Undefined);
	ElsIf Not ListOfBusinessProcurementOperations.Find(Object.BusinessOperation) = Undefined Then
		ObjectManager = Common.ObjectManagerByRef(Object.Ref);
		FillParameters = ObjectManager.ParametersForFillingInVATTaxationPurchases(Object);
		VATAccountingERP.FillInVATTaxationPurchases(Object.VATTaxation, FillParameters, Undefined);
	EndIf;
	
	
	If DocumentType = Type("DocumentRef.BankAccountIssue") Then
		
		
		If Object.FileEncoding = "" Then
			Object.FileEncoding = "UTF-8";
		EndIf;
		
	EndIf;
EndProcedure
Procedure DeferredProcessing_CashFlowDocuments(Object, ExchangeComponents)
	// Filling in partner analytics if necessary.
	If Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer
		Or Object.BusinessOperation = Enums.BusinessTransactions.RefundFromVendor
		Or Object.BusinessOperation = Enums.BusinessTransactions.PaymentToVendor
		Or Object.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer Then
		FillingInPartnerFieldInPaymentTranscript(Object);
		If Common.HasObjectAttribute("Partner", Object.Metadata()) Then
			FillingInPartnerInDocumentHeader(Object);
		EndIf;
		
		FillInCalculationObject = ExchangeComponents.ConversionParameters_SSLy.FillInCalculationObject; // Array
		FillInCalculationObject.Add(Object);
		AddPrimaryPmDocumentsToDeferredProcessing(ExchangeComponents,
														Object.AdditionalProperties.ARAPDetails,
														Object.BusinessOperation);
	
	EndIf;
	
	If Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromBank
		Or Object.BusinessOperation = Enums.BusinessTransactions.CashDepositToBankAccount
		Or Object.BusinessOperation = Enums.BusinessTransactions.CashCollectionToBank Then
		FillInBankAccountUsingOrganizationSCurrency(Object);
	EndIf;
	
	
	If Object.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
		If ValueIsFilled(Object.DocumentBasis)
			And TypeOf(Object.DocumentBasis) = Type("DocumentRef.CashVoucher") Then
			
			Object.CashAccount = Object.DocumentBasis.CashAccountRecipient;
			Object.CashAccountIssuer = Object.DocumentBasis.CashAccount;
	
			Object.CashFlowItem = Object.DocumentBasis.CashFlowItem;
		EndIf;
		If Not ValueIsFilled(Object.CashAccount) Then
			FilterParameters = New Structure(
				"Currency,Organization,Department",
				Object.Currency,
				Object.Organization,
				Catalogs.BusinessStructure.EmptyRef());
			
			Object.CashAccount = DefaultCheckout(FilterParameters, ExchangeComponents);
		EndIf;
		If Not ValueIsFilled(Object.CashFlowItem) Then
			Object.CashFlowItem =
				SettingsValueCached.GetCashFlowItem(Object.BusinessOperation);
		EndIf;
	Else
		FillOutCashRegisterByCurrencyAndOrganization(Object, ExchangeComponents);
	
		If Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCashRegister
			Or Object.BusinessOperation = Enums.BusinessTransactions.CashIssueToCashRegister Then
			FillInCashRegisterByCurrencyDivisionAndOrganization(Object);	
		Else
			FillingInArticleDDSVDocument(Object);
			FillInTableOfArticleDDSIKBusinessTransactions(Object, ExchangeComponents.ConversionParameters_SSLy.UploadedArticlesByDDSIKBusinessTransactions);
		EndIf;
	EndIf;
	
	FillInCourseAndMultiplicityInDecryptionLines(Object);
	
	DocumentType = TypeOf(Object.Ref);
	ListOfBusinessSalesOperations = CashServer.GetListOfBusinessSalesOperationsForDocument(DocumentType);
	ListOfBusinessProcurementOperations = CashServer.GetListOfPurchasingBusinessOperationsForDocument(DocumentType);
	
	If Not ListOfBusinessSalesOperations.Find(Object.BusinessOperation) = Undefined Then
		ObjectManager = Common.ObjectManagerByRef(Object.Ref);
		FillParameters = ObjectManager.ParametersForFillingInSalesVATTaxation(Object);
		VATAccountingERP.FillInSalesVATTaxation(Object.VATTaxation, FillParameters, Undefined);
	ElsIf Not ListOfBusinessProcurementOperations.Find(Object.BusinessOperation) = Undefined Then
		ObjectManager = Common.ObjectManagerByRef(Object.Ref);
		FillParameters = ObjectManager.ParametersForFillingInVATTaxationPurchases(Object);
		VATAccountingERP.FillInVATTaxationPurchases(Object.VATTaxation, FillParameters, Undefined);
	EndIf;
	
	
EndProcedure


Procedure DeferredProcessing_MovingOrder(Object, ExchangeComponents)
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	FillInDefaultActivity(Object, "TransferForActivity");
	
	#Region FillingOutCollateral
	
	EmptyAssignment = Catalogs.Assignments.EmptyRef();
	
	Goods_Copy = Object.Goods.Unload(New Array()); // ValueTable
	Goods_Copy.Columns.Add("IndexInGoodsTable");
	UBound = Object.Goods.Count() - 1;
	For IndexOf = 0 To UBound Do
		LineProducts_ = Object.Goods[IndexOf];
		If Not ValueIsFilled(LineProducts_.SupplyOption) Then
			NewRow = Goods_Copy.Add();
			FillPropertyValues(NewRow, LineProducts_);
			NewRow.IndexInGoodsTable = IndexOf;
		EndIf;
	EndDo;
	
	ProvisionInDocumentsServer.FillInDefaultSecurityOption(Goods_Copy);
	
	For Each LineCopy In Goods_Copy Do
		Object.Goods[LineCopy.IndexInGoodsTable].SupplyOption = LineCopy.SupplyOption;
		LineProducts_.Purpose = EmptyAssignment;
	EndDo;
	
	For Each Page1 In Object.Goods Do
		If Not ValueIsFilled(Page1.ShipmentStart) Then
			Page1.ShipmentStart = Object.Date;
		EndIf;
	EndDo;
	
	#EndRegion
EndProcedure
Procedure DeferredProcessing_OrdersToCustomerSSupplier(Object, ExchangeComponents)
	ThisIsOrderToSupplier = (Object.Metadata().Attributes.Find("PurchaseForActivity") <> Undefined);
	
	If ThisIsOrderToSupplier And Not ValueIsFilled(Object.PurchaseForActivity) Then
		FillInDefaultActivity(Object, "PurchaseForActivity");
	EndIf;
	
	If Not ValueIsFilled(Object.Priority) Then
		Object.Priority = Catalogs.Priorities.GetDefaultPriority();
	EndIf;
	
	If Not ValueIsFilled(Object.Partner) Then
		Object.Partner = CashServer.GetCounterpartyPartner(Object.Counterparty);
	EndIf;
	
	If Not ValueIsFilled(Object.Terms) Then
		If ThisIsOrderToSupplier Then
			FillingInAgreementWithSupplierInHeaderOfDocument(Object, ExchangeComponents.ConversionParameters_SSLy);
		Else
			FillingInAgreementWithClientInHeaderOfDocument(Object);
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(Object.DeliveryAddressFieldValues)
		And ValueIsFilled(Object.DeliveryAddress) Then
		GeneralPurposeTMServerCall.FillInValuesOfCIFieldsOnPresentation(Object.DeliveryAddress, Object.DeliveryAddressFieldValues);
	EndIf;
		
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.8")
		Or Not ValueIsFilled(Object.VATTaxation) Then
	
		FillInDefaultTaxType(Object);
	EndIf;
	
	If ValueIsFilled(Object.Contract) And Not Common.RefExists(Object.Contract) Then
		Object.Contract = Catalogs.CounterpartyContracts.EmptyRef();
	EndIf;   
	FillInCalculationProcedure(Object, Object.Contract, Object.Terms);
	PaymentStepsServer.CheckAndFillInPaymentScheduleStages(Object);
	
	If ThisIsOrderToSupplier Then
		
				
		For Each Page1 In Object.Goods Do
			If Not ValueIsFilled(Page1.Warehouse) Then
				Page1.Warehouse = Object.Warehouse;
			EndIf;
		EndDo;
		
		If Not ValueIsFilled(Object.GoodsReceiptOption) Then
			Object.GoodsReceiptOption = PurchasesServer.GetProductAcceptanceOption(Undefined, Object.Contract);
		EndIf;
		
		//Date of receipt
		If (Object.Status = Enums.PurchaseOrderStatuses.Confirmed_
			Or Object.Status = Enums.PurchaseOrderStatuses.Closed) Then
			
			If ValueIsFilled(Object.RequestedDeliveryDate) And Object.RequestedDeliveryDate >= Object.Date Then
				DateOfReceipt = Object.RequestedDeliveryDate;
			Else
				DateOfReceipt = Object.Date;
			EndIf;
			
			If Not Object.OneDateReceipt Then
				For Each TSRow In Object.Goods Do
					If Not ValueIsFilled(TSRow.DateOfReceipt) Then
						TSRow.DateOfReceipt = DateOfReceipt;
					EndIf;
				EndDo;
			Else
				If Not ValueIsFilled(Object.DateOfReceipt) Then
					Object.DateOfReceipt = DateOfReceipt;
				EndIf;
				For Each TSRow In Object.Goods Do
					TSRow.DateOfReceipt = Object.DateOfReceipt;
				EndDo;	
			EndIf;	
		EndIf;
		
		// The nomenclature of suppliers.
		ProcessProductListOfVHFCounterparty(Object, "Goods", ExchangeComponents);
			
	Else
		//Sales order
		
		StructureOfActions = New Structure;
		
		DocumentParameters = Documents.SalesOrder.DocumentParametersForSoftwareActions(Object);
		StringFields_ = "SupplyOption";
		ProvisionInDocumentsClientServer.AddCollateralActions(StructureOfActions, StringFields_, DocumentParameters);
		RowsToProcess = New Array();
		CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
		
		For Each Page1 In Object.Goods Do
			If Not ValueIsFilled(Page1.SupplyOption) 
				And Common.RefExists(Page1.Products) Then
					RowsToProcess.Add(Page1);
			EndIf;
			
			If Not ValueIsFilled(Page1.Warehouse) Then
				Page1.Warehouse = Object.Warehouse;
			EndIf;
		EndDo;
		
		BatchProcessingOfTablePartServer.ProcessTSStrings(
			RowsToProcess,
			StructureOfActions,
			Object.Goods,
			CachedValues);
		
	EndIf;
	
	// We will establish the owner for the contact person.
	If ValueIsFilled(Object.ContactPerson) And ValueIsFilled(Object.Partner) Then
		OwnerOfContactPerson = Common.ObjectAttributeValue(Object.ContactPerson, "Owner");
		If OwnerOfContactPerson = Catalogs.Partners.UnknownPartner Then
			ContactPersonObject = Object.ContactPerson.GetObject();
			ContactPersonObject.Owner = Object.Partner;
			
			ContactPersonObject.DataExchange.Load = True;
			
			Try
				ContactPersonObject.Write();
			Except
				WriteErrorToEventLog(Object.ContactPerson,
					DetailErrorDescription(ErrorInfo()), ExchangeComponents);
			EndTry;
		ElsIf Not OwnerOfContactPerson = Object.Partner Then
			Object.ContactPerson = Undefined;
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(Object.Author) Then
		If ValueIsFilled(Object.Manager) Then
			Object.Author = Object.Manager;	
		Else
		    Object.Author = Users.CurrentUser();
		EndIf;    
	EndIf;
	
	If Not ThisIsOrderToSupplier
		And GetFunctionalOption("UseDiscountsMarkupsInSales")
		And Not Object.DiscountsAreCalculated
		And SalesServer.GoodsTransferOperations().Find(Object.BusinessOperation) = Undefined Then
		
		Object.DiscountsAreCalculated = True;
	EndIf;
EndProcedure
Procedure DelayedProcessing_ClosingCashShift(Object, ObjectIsModified, ExchangeComponents)
	CashierShiftsToClose = ExchangeComponents.ConversionParameters_SSLy.CashierShiftsToClose; // ValueTable
	CashRegisterShift = CashierShiftsToClose.Add();
	CashRegisterShift.CashRegisterShift = Object.Ref;
	CashRegisterShift.CashRegister = Object.CashRegister;
	CashRegisterShift.Organization = Object.Organization;
	CashRegisterShift.CashShiftNumber = Object.Number;
	CashRegisterShift.CashRegisterShiftStatus = Object.Status;
	CashRegisterShift.PeriodEndTransactionsStatus = Object.PeriodEndTransactionsStatus;
	CashRegisterShift.ShiftIsOpened = (Object.Status = Enums.CashRegisterShiftStatuses.IsOpen);
	CashRegisterShift.StatusChangeDate = ?(Object.Status = Enums.CashRegisterShiftStatuses.IsOpen, Object.CashRegisterShiftStart, Object.CashRegisterShiftEnd);
	CashRegisterShift.UpdateReports = False;
EndProcedure
Procedure DelayedProcessing_ClosingOfCashShifts(ExchangeComponents)
	CashierShiftsToClose = ExchangeComponents.ConversionParameters_SSLy.CashierShiftsToClose; // ValueTable
	
	For Each StringPOSShift In CashierShiftsToClose Do
	
		CashRegister = StringPOSShift.CashRegister;
		ErrorDescription = "";
		
		If ValueIsFilled(CashRegister) Then
			// We will get the status of the cash shift
			RegisterShiftState = RetailSales.GetCashShiftState(CashRegister, StringPOSShift.CashRegisterShift);
			FillPropertyValues(RegisterShiftState, StringPOSShift);
			RetailSales.GenerateDocumentsForCashShiftClosingOperation(RegisterShiftState, ErrorDescription, True);
		EndIf;
	
		If StringPOSShift.ShiftIsOpened Then
			Document = StringPOSShift.CashRegisterShift.GetObject();
			Document.Status = Enums.CashRegisterShiftStatuses.Closed_;
			Document.DataExchange.Load = True;
			Document.Write();
		EndIf;
	
	EndDo;
EndProcedure
Procedure DeferredProcessing_FillingCashShifts(ExchangeComponents)
	ATPDocuments = ExchangeComponents.ConversionParameters_SSLy.DocumentsWithGiftCertificates;
	TableForDeferredHolding = ExchangeComponents.DocumentsForDeferredPosting;
		
	If TypeOf(ATPDocuments) = Type("ValueTable") And ATPDocuments.Count() > 0 Then
		ATPDocuments.Indexes.Add("DocumentQueue");
		
		DocumentsReceiptsCashRegister = ATPDocuments.Copy(New Structure("DocumentQueue", 0));
		If DocumentsReceiptsCashRegister.Count() > 0 Then
			
			Query = New Query;
			Query.Text = 
			"SELECT
			|	CashRegisterReceipts.DocumentRef AS DocumentRef,
			|	CashRegisterReceipts.DocumentDate AS DocumentDate,
			|	CashRegisterReceipts.CashRegister AS CashRegister,
			|	CashRegisterReceipts.CashShiftNumber AS CashShiftNumber
			|INTO CashRegisterTTReceipts
			|FROM
			|	&CashRegisterReceipts AS CashRegisterReceipts
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CashRegisterShift.Ref AS CashRegisterShift,
			|	CashRegisterTTReceipts.DocumentRef AS Document
			|FROM
			|	CashRegisterTTReceipts AS CashRegisterTTReceipts
			|		INNER JOIN Document.CashRegisterShift AS CashRegisterShift
			|		ON CashRegisterTTReceipts.CashRegister = CashRegisterShift.CashRegister
			|			AND CashRegisterTTReceipts.CashShiftNumber = CashRegisterShift.CREShiftNumber
			|			AND (NOT CashRegisterShift.DeletionMark)
			|			AND (CashRegisterTTReceipts.DocumentDate >= CashRegisterShift.CashRegisterShiftStart
			|					AND (CashRegisterTTReceipts.DocumentDate <= CashRegisterShift.CashRegisterShiftEnd
			|						OR CashRegisterShift.CashRegisterShiftEnd = DATETIME(1,1,1)))";
			Query.SetParameter("CashRegisterReceipts", DocumentsReceiptsCashRegister);
			Selection = Query.Execute().Select();
			While Selection.Next() Do
				If ValueIsFilled(Selection.CashRegisterShift) Then
					CashRegisterReceipt = Selection.Document.GetObject();
					CashRegisterReceipt.CashRegisterShift = Selection.CashRegisterShift;
					CashRegisterReceipt.DataExchange.Load = True;
					CashRegisterReceipt.Write();
				EndIf;
			EndDo;
			
		EndIf;
		
		PIUDocuments = ATPDocuments.Copy(New Structure("DocumentQueue", 1));
		If PIUDocuments.Count() > 0 Then
		
			PIUDocuments.Sort("DocumentDate");
			
			Query = New Query;
			Query.Text =
				"SELECT
				|	MAX(ISNULL(DocCashRegisterShift.CashRegisterShiftEnd, BEGINOFPERIOD(RetailSalesReport.Date, DAY))) AS CashRegisterShiftStart,
				|	RetailSalesReport.Ref AS ORP,
				|	RetailSalesReport.Currency AS Currency,
				|	RetailSalesReport.CashRegister AS CashRegister,
				|	RetailSalesReport.Date AS CashRegisterShiftEnd,
				|	RetailSalesReport.Date AS Date,
				|	RetailSalesReport.Organization AS Organization,
				|	RetailSalesReport.Warehouse AS Warehouse,
				|	RetailSalesReport.PriceKind AS PriceKind,
				|	RetailSalesReport.VATTaxation AS VATTaxation,
				|	VALUE(Enum.CashRegisterShiftStatuses.Closed_) AS Status,
				|	MAX(CASE
				|			WHEN ISNULL(DocCashRegisterShift.CashRegisterShiftEnd, DATETIME(1, 1, 1)) = RetailSalesReport.Date
				|					AND NOT RetailSalesReport.Date = DATETIME(1, 1, 1)
				|				THEN DocCashRegisterShift.Ref
				|			ELSE VALUE(Document.CashRegisterShift.EmptyRef)
				|		END) AS CashRegisterShift
				|FROM
				|	Document.RetailSalesReport AS RetailSalesReport
				|		LEFT JOIN Document.CashRegisterShift AS DocCashRegisterShift
				|		ON RetailSalesReport.CashRegister = DocCashRegisterShift.CashRegister
				|			AND RetailSalesReport.Organization = DocCashRegisterShift.Organization
				|			AND (NOT DocCashRegisterShift.DeletionMark)
				|			AND (DocCashRegisterShift.CashRegisterShiftEnd = RetailSalesReport.Date
				|				OR BEGINOFPERIOD(RetailSalesReport.Date, DAY) <= DocCashRegisterShift.CashRegisterShiftStart
				|					AND DocCashRegisterShift.CashRegisterShiftEnd < RetailSalesReport.Date)
				|WHERE
				|	RetailSalesReport.Ref IN(&ReferencesArrray)
				|
				|GROUP BY
				|	RetailSalesReport.Ref,
				|	RetailSalesReport.Currency,
				|	RetailSalesReport.CashRegister,
				|	RetailSalesReport.Date,
				|	RetailSalesReport.Organization,
				|	RetailSalesReport.Warehouse,
				|	RetailSalesReport.PriceKind,
				|	RetailSalesReport.VATTaxation,
				|	RetailSalesReport.Date
				|
				|ORDER BY
				|	Organization,
				|	Warehouse,
				|	Currency,
				|	CashRegister,
				|	CashRegisterShiftEnd";
			
			Query.SetParameter("ReferencesArrray", PIUDocuments.UnloadColumn("DocumentRef"));
			
			Organization = Undefined;
			Warehouse = Undefined;
			Currency = Undefined;
			CashRegister = Undefined;
	
			Selection = Query.Execute().Select();
			While Selection.Next() Do
				
				ORPObject = Selection.ORP.GetObject();
				If ValueIsFilled(Selection.CashRegisterShift) Then
					ORPObject.CashRegisterShift = Selection.CashRegisterShift;
				Else
					If Organization <> Selection.Organization Or CashRegister <> Selection.CashRegister
						Or Warehouse <> Selection.Warehouse Or Currency <> Selection.Currency Then
						
						Organization = Selection.Organization;
						CashRegister = Selection.CashRegister;
						Warehouse = Selection.Warehouse;
						Currency = Selection.Currency;
						StartOfShift = Selection.CashRegisterShiftStart;
						If Not ValueIsFilled(StartOfShift) Then
							StartOfShift = Selection.Date;
						EndIf;
					EndIf;
					
					NewDocument = Documents.CashRegisterShift.CreateDocument();
					StartOfShift = StartOfShift + ?(StartOfShift = BegOfDay(StartOfShift), 0, 1);
					FillPropertyValues(NewDocument, Selection);
					NewDocument.Date = StartOfShift;
					NewDocument.CashRegisterShiftStart = StartOfShift;
					NewDocument.PeriodEndTransactionsStatus = Enums.StatusesOfPeriodEndTransactionsOfCashRegisterShift.ReportIsCreatedReceiptsAreArchived;
					ReceivedDataRef = DataExchangeXDTOServer.ObjectRefByXDTODataObjectUUID(
						String(Selection.ORP.UUID()),
						Type("DocumentRef.CashRegisterShift"),
						ExchangeComponents);
					If TypeOf(ReceivedDataRef) = Type("DocumentObject.CashRegisterShift") Then
						NewDocument.SetNewObjectRef(ReceivedDataRef);
					EndIf;
					NewDocument.SetNewNumber();
					NewDocument.DataExchange.Load = True;
					NewDocument.Write();
					
					ORPObject.CashRegisterShift = NewDocument.Ref;
				EndIf;
				ORPObject.DataExchange.Load = True;
				ORPObject.Write();
				StartOfShift = Selection.CashRegisterShiftEnd;
			EndDo;
		EndIf;
		RPSDocuments = ATPDocuments.Copy(New Structure("DocumentQueue", 2));
		If RPSDocuments.Count() > 0 Then
			RPSDocuments.Sort("DocumentDate");
			Query = New Query;
			Query.Text =
				"SELECT
				|	ReturnOfGiftCards.Ref AS Ref,
				|	ReturnOfGiftCards.Organization AS Organization,
				|	ReturnOfGiftCards.Currency AS Currency,
				|	ReturnOfGiftCards.CashRegister AS CashRegister,
				|	ReturnOfGiftCards.Date AS Date
				|INTO VT_ImplementationPSRefund
				|FROM
				|	Document.ReturnOfGiftCards AS ReturnOfGiftCards
				|WHERE
				|	ReturnOfGiftCards.Ref IN(&ReferencesArrray)
				|
				|UNION ALL
				|
				|SELECT
				|	GiftCertificateSale.Ref,
				|	GiftCertificateSale.Organization,
				|	GiftCertificateSale.Currency,
				|	GiftCertificateSale.CashRegister,
				|	GiftCertificateSale.Date
				|FROM
				|	Document.GiftCertificateSale AS GiftCertificateSale
				|WHERE
				|	GiftCertificateSale.Ref IN(&ReferencesArrray)
				|
				|INDEX BY
				|	Organization,
				|	Currency,
				|	CashRegister
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	CashRegisterShift.Ref AS CashShiftLink,
				|	VT_ImplementationPSRefund.Ref AS Ref,
				|	CashRegisterShift.CashRegisterShiftStart AS CashRegisterShiftStart
				|FROM
				|	VT_ImplementationPSRefund AS VT_ImplementationPSRefund
				|		INNER JOIN Document.CashRegisterShift AS CashRegisterShift
				|		ON VT_ImplementationPSRefund.Organization = CashRegisterShift.Organization
				|			AND VT_ImplementationPSRefund.CashRegister = CashRegisterShift.CashRegister
				|			AND VT_ImplementationPSRefund.Date >= CashRegisterShift.CashRegisterShiftStart
				|			AND VT_ImplementationPSRefund.Date <= CashRegisterShift.CashRegisterShiftEnd";
			
			Query.SetParameter("ReferencesArrray", RPSDocuments.UnloadColumn("DocumentRef"));
			
			Selection = Query.Execute().Select();
			While Selection.Next() Do
				RPSObject = Selection.Ref.GetObject();
				RPSObject.Date = Selection.CashRegisterShiftStart;
				RPSObject.CashRegisterShift = Selection.CashShiftLink;
				RPSObject.DataExchange.Load = True;
				RPSObject.Write();
				
				FoundRow = TableForDeferredHolding.Find(Selection.Ref, "DocumentRef");
				If FoundRow <> Undefined Then
					FoundRow.DocumentDate  = Selection.CashRegisterShiftStart;
				EndIf;
			EndDo;
		EndIf;
		
		UPUTable = ATPDocuments.Copy(New Structure("DocumentQueue", 3));
		If UPUTable.Count() > 0 Then
			UPUTable.Sort("DocumentDate");
			Query = New Query;
			Query.Text = "SELECT
							|	UPUTable.DocumentRef AS PSRefund,
							|	UPUTable.ORP AS ORP
							|INTO TTUPU
							|FROM
							|	&UPUTable AS UPUTable
							|;
							|
							|////////////////////////////////////////////////////////////////////////////////
							|SELECT
							|	ReturnOfGiftCards.Ref AS PSRefund,
							|	RetailSalesReport.CashRegisterShift AS CashRegisterShift,
							|	RetailSalesReport.CashRegister AS CashRegister
							|FROM
							|	TTUPU AS TTUPU
							|		INNER JOIN Document.ReturnOfGiftCards AS ReturnOfGiftCards
							|		ON TTUPU.PSRefund = ReturnOfGiftCards.Ref
							|		INNER JOIN Document.RetailSalesReport AS RetailSalesReport
							|		ON TTUPU.ORP = RetailSalesReport.Ref";
			
			Query.SetParameter("UPUTable", UPUTable);
			
			Selection = Query.Execute().Select();
			While Selection.Next() Do
				UPUObject = Selection.PSRefund.GetObject();
				UPUObject.CashRegisterShift = Selection.CashRegisterShift;
				UPUObject.CashRegister = Selection.CashRegister;
				UPUObject.DataExchange.Load = True;
				UPUObject.Write();
			EndDo;
		EndIf;
	EndIf;
EndProcedure
Procedure DeferredProcessing__PSRefunds(ExchangeComponents)
	PSRefundArray = ExchangeComponents.ConversionParameters_SSLy.ArrayReturnsPSFillBase;
	
	If PSRefundArray.Count() > 0 Then
		Query = New Query("SELECT
		                      |	ReturnOfGiftCardsGiftCertificates.Ref AS PSRefund,
		                      |	MAX(GiftCertificateSaleGiftCertificates.Ref) AS PSImplementation,
		                      |	COUNT(DISTINCT GiftCertificateSaleGiftCertificates.Ref) AS NumberOfPSImplementations
		                      |FROM
		                      |	Document.ReturnOfGiftCards.GiftCertificates AS ReturnOfGiftCardsGiftCertificates
		                      |		LEFT JOIN Document.GiftCertificateSale.GiftCertificates AS GiftCertificateSaleGiftCertificates
		                      |		ON ReturnOfGiftCardsGiftCertificates.Ref.CashRegisterShift = GiftCertificateSaleGiftCertificates.Ref.CashRegisterShift
		                      |			AND ReturnOfGiftCardsGiftCertificates.GiftCertificate = GiftCertificateSaleGiftCertificates.GiftCertificate
		                      |WHERE
		                      |	ReturnOfGiftCardsGiftCertificates.Ref IN(&PSRefundArray)
		                      |
		                      |GROUP BY
		                      |	ReturnOfGiftCardsGiftCertificates.Ref");
		
		Query.SetParameter("PSRefundArray", PSRefundArray);
		Selection = Query.Execute().Select();
		While Selection.Next() Do
			If Selection.NumberOfPSImplementations = 1 Then
				ReturnToItem = Selection.PSRefund.GetObject();
				ReturnToItem.GiftCertificateSale = Selection.PSImplementation;
				ReturnToItem.DataExchange.Load = True;
				ReturnToItem.Write();
			EndIf;
		EndDo;
	
	EndIf;
EndProcedure
Procedure DeferredProcessing_FillInFEAClassifier(ExchangeComponents)
	ArrayOfFuelAndEnergyEfficiency = ExchangeComponents.ConversionParameters_SSLy.ArrayOfFuelAndEnergyEfficiency;
	
	If ArrayOfFuelAndEnergyEfficiency.Count() > 0 Then
		QueryText =
		"SELECT
		|	FEACN.Ref AS Ref,
		|	FEACN.Code AS LinkCode
		|INTO TTTNVED
		|FROM
		|	Catalog.FEACN AS FEACN
		|WHERE
		|	FEACN.UnitOfMeasure = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	AND FEACN.Ref IN(&ArrayOfFuelAndEnergyEfficiency)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.Code AS Code,
		|	T.UnitOfMeasureCode AS UnitOfMeasureCode,
		|	T.TracedGoods AS TracedGoods
		|INTO TableOfClassifier
		|FROM
		|	&TableOfClassifier AS T
		|
		|INDEX BY
		|	Code
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTTNVED.Ref AS Ref,
		|	Units.Ref AS UnitOfMeasure,
		|	TableOfClassifier.TracedGoods AS TracedGoods
		|FROM
		|	TTTNVED AS TTTNVED
		|		INNER JOIN TableOfClassifier AS TableOfClassifier
		|		ON TTTNVED.LinkCode = TableOfClassifier.Code
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS Units
		|		ON (TableOfClassifier.UnitOfMeasureCode = Units.Code)
		|			AND (Units.Owner = VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure))";
			
		Query = New Query(QueryText);
		Query.SetParameter("TableOfClassifier", Catalogs.FEACN.TableOfClassifier(0));
		Query.SetParameter("ArrayOfFuelAndEnergyEfficiency", ArrayOfFuelAndEnergyEfficiency);
		Selection = Query.Execute().Select();
		
		While Selection.Next() Do
			CatalogObject = Selection.Ref.GetObject(); // CatalogObject.FEACN
			If (Not ValueIsFilled(CatalogObject.UnitOfMeasure) And ValueIsFilled(Selection.UnitOfMeasure))
				Or Not CatalogObject.TracedGoods = Selection.TracedGoods Then
				
				CatalogObject.UnitOfMeasure = Selection.UnitOfMeasure;
				CatalogObject.TracedGoods = Selection.TracedGoods;
				Try
					CatalogObject.Write();
				Except
					WriteErrorToEventLog(CatalogObject,
						DetailErrorDescription(ErrorInfo()), ExchangeComponents);
				EndTry
			EndIf;	
		EndDo;
	EndIf;
EndProcedure
Procedure DeferredProcessing_FillInProducts(ExchangeComponents)
	ProductsForDeferredProcessing = ExchangeComponents.ConversionParameters_SSLy.ProductsForDeferredProcessing;
	
	Query = New Query;
	Query.SetParameter("ProductsForDeferredProcessing", ProductsForDeferredProcessing);
	Query.Text = 
		"SELECT
		|	Products.Ref AS Products,
		|	ISNULL(Products.ProductKind.UseVariants, VALUE(Enum.ItemVariantsUsageOptions.DontUse)) AS UseVariants
		|FROM
		|	Catalog.Products AS Products
		|WHERE
		|	Products.Ref IN(&ProductsForDeferredProcessing)";
		
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		ItemProducts_ = Selection.Products.GetObject();
		ItemProducts_.UseVariants = Selection.UseVariants;
		
		ItemProducts_.DataExchange.Load = True;
		
		Try
			ItemProducts_.Write();
		Except
			WriteErrorToEventLog(Selection.Products,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents);
		EndTry;
	EndDo;
EndProcedure
Procedure DeferredProcessing_FillCalculationObjects(ExchangeComponents)
	For Each MapItemToFillIn In ExchangeComponents.ConversionParameters_SSLy.FillInCalculationObject Do
		
		// Updating the object to match the version
		Object = MapItemToFillIn.Ref.GetObject();
		For Each KeyAndValue In MapItemToFillIn.AdditionalProperties Do
			Object.AdditionalProperties.Insert(KeyAndValue.Key, KeyAndValue.Value);
		EndDo;
		
		If TypeOf(Object) = Type("DocumentObject.BankAccountReceiptNote")
			Or TypeOf(Object) = Type("DocumentObject.BankAccountIssue")
			Or (TypeOf(Object) = Type("DocumentObject.PaymentRequest")
				And Not (Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.CashAccountPayment_
				Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.PaymentCard
				Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.GiftCertificate
				Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.BonusPoints)) Then
				
			PaymentType_ = ?(Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer 
				Or Object.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer,
				Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting,
				Enums.PartnersARAPAccountingTypes.VendorARAPAccounting);
			
			FillInWHCalculationObject(Object, "ARAPDetails", PaymentType_, "Partner", Undefined);
			FillInBasisOfPaymentForSettlementObject(Object, "ARAPDetails");
			
			NamesOfColumnsToCheck = "ARAPObject";
			If TypeOf(Object) = Type("DocumentObject.BankAccountReceiptNote") Then
				NamesOfColumnsToCheck = NamesOfColumnsToCheck + ",PaymentPurpose";
			EndIf;
			
			ClearNonExistentVTCHLinks(Object, "ARAPDetails", NamesOfColumnsToCheck);
			Try
				Object.Write();
			Except
		 		WriteErrorToEventLog(Object,
		      		DetailErrorDescription(ErrorInfo()), ExchangeComponents);
			EndTry;
	
		ElsIf TypeOf(Object) = Type("DocumentObject.CashAccountReceiptNote")
			Or TypeOf(Object) = Type("DocumentObject.CashVoucher")
			Or (TypeOf(Object) = Type("DocumentObject.PaymentRequest")
				And  (Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.CashAccountPayment_
				Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.PaymentCard
				Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.GiftCertificate
				Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.BonusPoints)) Then
				
			PaymentType_ = ?(Object.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer 
				Or Object.BusinessOperation = Enums.BusinessTransactions.RefundToCustomer,
				Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting,
				Enums.PartnersARAPAccountingTypes.VendorARAPAccounting);
			FillInWHCalculationObject(Object, "ARAPDetails", PaymentType_, "Partner", Undefined);
			FillInBasisOfPaymentForSettlementObject(Object, "ARAPDetails");
	
			NamesOfColumnsToCheck = "ARAPObject";
			If TypeOf(Object) = Type("DocumentObject.CashAccountReceiptNote") Then
				NamesOfColumnsToCheck = NamesOfColumnsToCheck + ",PaymentPurpose";
			EndIf;
			ClearNonExistentVTCHLinks(Object, "ARAPDetails", NamesOfColumnsToCheck);
		
			Object.Write();
					
		ElsIf TypeOf(Object) = Type("DocumentObject.PaymentCardTransaction") Then
		
			FillInWHCalculationObject(Object, "ARAPDetails", Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting, "Partner", Undefined);
			Object.Write();
			
		ElsIf TypeOf(Object) = Type("DocumentObject.ARAPAdjustment") Then
			
			FillInWHCalculationObject(Object, "Debt_", "PaymentType_", "Partner", Object.Counterparty);
			Object.Write();
			
		ElsIf TypeOf(Object) = Type("DocumentObject.ExpenseReport") Then
			
			FillInWHCalculationObject(Object, "PaymentToVendors", Enums.PartnersARAPAccountingTypes.VendorARAPAccounting, "Vendor", "Counterparty");
			Object.Write();
			
		ElsIf TypeOf(Object) = Type("DocumentObject.ARAPSettlement") Then
			
			PartnerDebtor = Undefined;
			If Not Object.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient
				And Not Object.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.CompanyVendor
				And ValueIsFilled(Object.CounterpartyDebtor) Then
				PartnerDebtor = CashServer.GetCounterpartyPartner(Object.CounterpartyDebtor);
				If Not ValueIsFilled(PartnerDebtor) Then
					PartnerDebtor = Catalogs.Partners.UnknownPartner;
				EndIf;
			EndIf;
			PartnerCreditor = Undefined;
			If Not Object.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient
				And Not Object.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.CompanyVendor
				And ValueIsFilled(Object.Creditor) Then
				PartnerCreditor = CashServer.GetCounterpartyPartner(Object.Creditor);
				If Not ValueIsFilled(PartnerCreditor) Then
					PartnerCreditor = Catalogs.Partners.UnknownPartner;
				EndIf;
			EndIf;
			
			For Each String In Object.AccountsReceivable Do			
				ARAPObject   = Undefined;
				DocumentOfARAPAccounting = Undefined;
				
				String.ARAPObject = Catalogs.ARAPObjects.EmptyRef();
				
				If Object.AdditionalProperties.AccountsReceivable[String.LineNumber-1].Property("DocumentOfARAPAccounting") 
					And ValueIsFilled(Object.AdditionalProperties.AccountsReceivable[String.LineNumber-1].DocumentOfARAPAccounting) Then
					DocumentOfARAPAccounting = Object.AdditionalProperties.AccountsReceivable[String.LineNumber-1].DocumentOfARAPAccounting;
				EndIf;
				
				If ValueIsFilled(DocumentOfARAPAccounting) Then
					
					Additional_Criteria = ARAPObjectsServer.AdditionalSearchCriteria_1();
					Additional_Criteria.Partner = PartnerDebtor;
					Additional_Criteria.Counterparty = Object.CounterpartyDebtor;
					
					PaymentType_ = ?(Object.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.Client
						Or Object.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient,
						Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting,
						Enums.PartnersARAPAccountingTypes.VendorARAPAccounting);
					
					String.ARAPObject = ARAPObjectsServer.GetCalculationObjectFromLink(
						DocumentOfARAPAccounting,
						Object.Organization,
						PaymentType_, 
						Additional_Criteria);
				EndIf;
			EndDo;
			
			For Each String In Object.AccountsPayable Do
				ARAPObject = Undefined;
				DocumentOfARAPAccounting = Undefined;
				
				String.ARAPObject = Catalogs.ARAPObjects.EmptyRef();
				
				If Object.AdditionalProperties.AccountsPayable[String.LineNumber-1].Property("DocumentOfARAPAccounting") 
					And ValueIsFilled(Object.AdditionalProperties.AccountsPayable[String.LineNumber-1].DocumentOfARAPAccounting) Then
					DocumentOfARAPAccounting = Object.AdditionalProperties.AccountsPayable[String.LineNumber-1].DocumentOfARAPAccounting;
				EndIf;
				
				If ValueIsFilled(DocumentOfARAPAccounting) Then
					
					Additional_Criteria = ARAPObjectsServer.AdditionalSearchCriteria_1();
					Additional_Criteria.Partner = PartnerCreditor;
					Additional_Criteria.Counterparty = Object.Creditor;
					
					PaymentType_ = ?(Object.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.Client
						Or Object.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient,
						Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting,
						Enums.PartnersARAPAccountingTypes.VendorARAPAccounting);
					
					String.ARAPObject = ARAPObjectsServer.GetCalculationObjectFromLink(
						DocumentOfARAPAccounting,
						Object.Organization,
						PaymentType_, 
						Additional_Criteria);
				EndIf;
			EndDo;
			
			Object.Write();
			
		EndIf;		
	EndDo
EndProcedure


Procedure DeferredProcessing_FillPrimaryDocTypes(ExchangeComponents)
	PrimaryDocuments = ExchangeComponents.ConversionParameters_SSLy.PrimaryDocuments;
	
	Query = New Query;
	Query.SetParameter("PrimaryDocuments", PrimaryDocuments);
	Query.Text =
		"SELECT
		|	PrimaryDocuments.SourceDocument AS Ref,
		|	PrimaryDocuments.SourceDocumentType AS SourceDocumentType
		|INTO TTPrimaryDocuments
		|FROM
		|	&PrimaryDocuments AS PrimaryDocuments
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SourceDocument.Ref AS SourceDocument,
		|	TTPrimaryDocuments.SourceDocumentType AS SourceDocumentType
		|FROM
		|	TTPrimaryDocuments AS TTPrimaryDocuments
		|		INNER JOIN Document.SourceDocument AS SourceDocument
		|		ON TTPrimaryDocuments.Ref = SourceDocument.Ref
		|WHERE
		|	SourceDocument.SourceDocumentType = VALUE(Enum.SourceDocumentTypes.EmptyRef)";
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		PrimaryDocumentObject = Selection.SourceDocument.GetObject();
		PrimaryDocumentObject.SourceDocumentType = Selection.SourceDocumentType;
		
		PrimaryDocumentObject.DataExchange.Load = True;
		
		Try
			PrimaryDocumentObject.Write();
		Except
			WriteErrorToEventLog(Selection.SourceDocument,
				DetailErrorDescription(ErrorInfo()), ExchangeComponents);
		EndTry;
	EndDo;
EndProcedure
Procedure DeferredProcessing_RequestForCashExpenseSettlementsWithCounter(Object, ExchangeComponents)
	If Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.CashAccountPayment_
		Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.PaymentCard
		Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.GiftCertificate
		Or Object.PaymentMethodOfPaymentRequest = Enums.PaymentForms.BonusPoints Then
		DeferredProcessing_CashFlowDocuments(Object, ExchangeComponents);
	Else
		DeferredProcessing_NonCashCashMovementDocuments(Object, ExchangeComponents);
	EndIf;
EndProcedure
Procedure DeferredProcessing_CashierByCurrencyAndOrganization(Object, ExchangeComponents)
	Department = Catalogs.BusinessStructure.EmptyRef();
		
	CashRegisterAttributes = Common.ObjectAttributesValues(Object.CashAccount, "CashCurrency, Owner, Department");
	
	If CashRegisterAttributes.CashCurrency <> Object.Currency 
		Or CashRegisterAttributes.Owner <> Object.Organization Then
		
		FilterParameters = New Structure(
			"Currency,Organization,Department",
			Object.Currency,
			Object.Organization,
			Department);
		
		Object.CashAccount = DefaultCheckout(FilterParameters, ExchangeComponents);
		
	EndIf;
EndProcedure
// Parameters:
//  Object - CatalogObject.ContactPersonsForPartners - the object of the information base.
//  ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//  ObjectIsModified - Boolean
//
Procedure DeferredProcessing_ContactPersonsOfPartners(Object, ExchangeComponents, ObjectIsModified)
	If Not ValueIsFilled(Object.Owner) Then
		AdditionalProperties = Object.AdditionalProperties;
		If AdditionalProperties.Property("Counterparty") Then
			Counterparty = AdditionalProperties.Counterparty;
			PartnerOwner = CashServer.GetCounterpartyPartner(Counterparty);
			Object.Owner = PartnerOwner;
		EndIf;
	EndIf;
EndProcedure
// Parameters:
//  Object - CatalogObject.Counterparties - the object of the information base.
//  ExchangeComponents - See DataExchangeXDTOServer.InitializeExchangeComponents
//  ObjectIsModified - Boolean
//
Procedure DeferredProcessing_Counterparties(Object, ExchangeComponents, ObjectIsModified)
	If Not ValueIsFilled(Object.Description) And ValueIsFilled(Object.DescriptionFull) Then
		Object.Description = Object.DescriptionFull;
	EndIf;
	
	If Not (ValueIsFilled(Object.RegistrationCountry) Or Object.LegalEntityIndividual = Enums.LegalEntityIndividual.LegalEntityNonResident) Then
		Object.RegistrationCountry = Constants.MainCountry.Get();
	EndIf;	
	 
	If ValueIsFilled(Object.RegistrationCountry) And Not Object.RegistrationCountry = Constants.MainCountry.Get() Then
		Object.LegalEntityIndividual = Enums.LegalEntityIndividual.LegalEntityNonResident;
	ElsIf Not ValueIsFilled(Object.LegalEntityIndividual) And ValueIsFilled(Object.CompanyIndividual) Then
		Object.LegalEntityIndividual = ?(Object.CompanyIndividual = Enums.CompanyIndividual.Individual,
			Enums.LegalEntityIndividual.Person,
			Enums.LegalEntityIndividual.Entity);
	EndIf;	  
	
	UsePartnersAsCounterparties = GetFunctionalOption("UsePartnersAsCounterparties");
	
	PartnerObject_ = ?(ValueIsFilled(Object.Partner),
		Object.Partner.GetObject(),
		Catalogs.Partners.CreateItem()); // CatalogObject.Partners
		
	If PartnerObject_.IsNew() Then
		PartnerObject_.RegistrationDate = Date('19800101');
		PartnerObject_.Client          = True;
		PartnerObject_.Vendor       = True;
		PartnerObject_.OtherRelations = True;
		PartnerObject_.SetNewCode();
		
		PartnerObject_.AccessGroup   = DefaultElement(ExchangeComponents, "PartnerAccessGroup");
	EndIf;
	
	// Synchronization of counterparty and partner properties.
	If PartnerObject_ <> Catalogs.Partners.UnknownPartner
		And (PartnerObject_.IsNew() Or UsePartnersAsCounterparties) Then
		PartnerObject_.Description       = Object.Description;
		PartnerObject_.DescriptionFull = Object.DescriptionFull;
		
		PartnerObject_.LegalEntityIndividual = ?(Object.LegalEntityIndividual = Enums.LegalEntityIndividual.Person,
			Enums.IndividualCompany.Person_,
			Enums.IndividualCompany.Company);
		
		For Each CounterpartyKiString In Object.ContactInformation Do
			PartnerSKiType = PartnerSKiTypeByCounterpartyKiType(CounterpartyKiString.Kind, UsePartnersAsCounterparties); //CatalogRef.ContactInformationKinds
			If PartnerSKiType = Undefined Then
				Continue;
			EndIf;
			
			PartnerKiStrings = PartnerObject_.ContactInformation.FindRows(New Structure("Kind", PartnerSKiType));
			For Each PartnerKiString In PartnerKiStrings Do
				PartnerObject_.ContactInformation.Delete(PartnerKiString);
			EndDo;
			
			PartnerKiString = PartnerObject_.ContactInformation.Add();
			FillPropertyValues(PartnerKiString, CounterpartyKiString);
			PartnerKiString.Kind = PartnerSKiType;
		EndDo;
		
		WasDeletionMark = PartnerObject_.DeletionMark;
		PartnerObject_.DeletionMark = False;
		
		PartnerObject_.DataExchange.Load = True;
		PartnerObject_.Write();
		
		PartnersAndCounterparties.RecordPartnerHierarchy(PartnerObject_.Ref);
		If Object.Partner <> PartnerObject_.Ref Then
			Object.Partner = PartnerObject_.Ref;
		Else
			ObjectIsModified = False;
		EndIf;
		
	EndIf;
EndProcedure
Procedure DeferredProcessing_DebtAdjustment(Object, ExchangeComponents)
	CurrencyOfComplianceAccounting   = LocalAccountingCurrency(Object.Organization);
	CourseAndMultiplicityOfLocal = ProcessingOfExchangeRatesTM.GetCurrencyRate(CurrencyOfComplianceAccounting, Object.Date,
							SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization));
	LocalCurrencySettings = New Structure("CourseNumerator, CourseDenominator, Currency", CourseAndMultiplicityOfLocal.CourseNumerator, CourseAndMultiplicityOfLocal.CourseDenominator, CurrencyOfComplianceAccounting);
	CurrencyOfManAccounting   = ManagementAccountingCurrency(ExchangeComponents);
	CourseAndMultiplicityOfMan = ProcessingOfExchangeRatesTM.GetCurrencyRate(CurrencyOfManAccounting, Object.Date,
							SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization));
	ManCurrencyParameters = New Structure("CourseNumerator, CourseDenominator, Currency", CourseAndMultiplicityOfMan.CourseNumerator, CourseAndMultiplicityOfMan.CourseDenominator, CurrencyOfManAccounting);
	
	PartnerDebtor = Undefined;
	If Not Object.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient
		And Not Object.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.CompanyVendor
		And ValueIsFilled(Object.CounterpartyDebtor) Then
		PartnerDebtor = CashServer.GetCounterpartyPartner(Object.CounterpartyDebtor);
		If Not ValueIsFilled(PartnerDebtor) Then
			PartnerDebtor = Catalogs.Partners.UnknownPartner;
		EndIf;
	EndIf;
	PartnerCreditor = Undefined;
	If Not Object.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.OrganizationClient
		And Not Object.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.CompanyVendor
		And ValueIsFilled(Object.Creditor) Then
		PartnerCreditor = CashServer.GetCounterpartyPartner(Object.Creditor);
		If Not ValueIsFilled(PartnerCreditor) Then
			PartnerCreditor = Catalogs.Partners.UnknownPartner;
		EndIf;
	EndIf;
	
	SettlementCurrencyParameters = New Map;
	Object.SumCompl = 0;
	Object.SumMan = 0;
	Object.CounterpartyCreditorType = Undefined;
	Object.CounterpartyDebtorType = Undefined;
	PrimaryDocuments = ExchangeComponents.ConversionParameters_SSLy.PrimaryDocuments;
	
	FillInCalculationObject = ExchangeComponents.ConversionParameters_SSLy.FillInCalculationObject; // Array
	FillInCalculationObject.Add(Object);
	
	For Each String In Object.AccountsReceivable Do
		CurCurrencySettings = SettlementCurrencyParameters.Get(String.ARAPCurrency);
		If CurCurrencySettings = Undefined Then
			CourseAndMultiplicityOfCur = ProcessingOfExchangeRatesTM.GetCurrencyRate(String.ARAPCurrency, Object.Date,
							SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization));
			CurCurrencySettings = New Structure("CourseNumerator, CourseDenominator, Currency", CourseAndMultiplicityOfCur.CourseNumerator, CourseAndMultiplicityOfCur.CourseDenominator, String.ARAPCurrency);
			SettlementCurrencyParameters.Insert(String.ARAPCurrency, CurCurrencySettings);
		EndIf;
		
		If String.ARAPCurrency = CurrencyOfManAccounting Then
			String.SumMan = String.AmountARAP;
		Else
			String.SumMan = ProcessingOfExchangeRatesTMClientServer.ConvertAtRate(String.AmountARAP, CurCurrencySettings, ManCurrencyParameters);
		EndIf;
		If Not ValueIsFilled(Object.CounterpartyDebtorType) And ValueIsFilled(String.PaymentType_) Then
			Object.CounterpartyDebtorType = ?(String.PaymentType_ = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting,Enums.ARAPSettlemenParticipantTypes.Client,Enums.ARAPSettlemenParticipantTypes.Vendor);
		EndIf;
		If ValueIsFilled(PartnerDebtor) Then
			String.Partner = PartnerDebtor;
		EndIf;		
	EndDo;
	
	For Each String In Object.AccountsPayable Do
		CurCurrencySettings = SettlementCurrencyParameters.Get(String.ARAPCurrency);
		If CurCurrencySettings = Undefined Then
			CourseAndMultiplicityOfCur = ProcessingOfExchangeRatesTM.GetCurrencyRate(String.ARAPCurrency, Object.Date,
							SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Object.Organization));
			CurCurrencySettings = New Structure("CourseNumerator, CourseDenominator, Currency", CourseAndMultiplicityOfCur.CourseNumerator, CourseAndMultiplicityOfCur.CourseDenominator, String.ARAPCurrency);
			SettlementCurrencyParameters.Insert(String.ARAPCurrency, CurCurrencySettings);
		EndIf;
		
		If String.ARAPCurrency = CurrencyOfManAccounting Then
			String.SumMan = String.AmountARAP;
		Else
			String.SumMan = ProcessingOfExchangeRatesTMClientServer.ConvertAtRate(String.AmountARAP, CurCurrencySettings, ManCurrencyParameters);
		EndIf;
		If Not ValueIsFilled(Object.CounterpartyCreditorType) And ValueIsFilled(String.PaymentType_) Then
			Object.CounterpartyCreditorType = ?(String.PaymentType_ = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting,Enums.ARAPSettlemenParticipantTypes.Client,Enums.ARAPSettlemenParticipantTypes.Vendor);
		EndIf;
		If ValueIsFilled(PartnerCreditor) Then
			String.Partner = PartnerCreditor;
		EndIf;
	EndDo;
	
	PrimaryDocuments = ExchangeComponents.ConversionParameters_SSLy.PrimaryDocuments; // ValueTable
	
	For Each Details In Object.AdditionalProperties.AccountsReceivable Do
		DocumentOfARAPAccounting = Details.DocumentOfARAPAccounting;
		If ValueIsFilled(DocumentOfARAPAccounting) And TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.SourceDocument") Then
			RowPrimaryDocuments = PrimaryDocuments.Add();
			RowPrimaryDocuments.SourceDocument = DocumentOfARAPAccounting;
			RowPrimaryDocuments.SourceDocumentType = Enums.SourceDocumentTypes.SaleToCustomer;
		EndIf;
	EndDo;
	
	For Each Details In Object.AdditionalProperties.AccountsPayable Do
		DocumentOfARAPAccounting = Details.DocumentOfARAPAccounting;
		If ValueIsFilled(DocumentOfARAPAccounting) And TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.SourceDocument") Then
			RowPrimaryDocuments = PrimaryDocuments.Add();
			RowPrimaryDocuments.SourceDocument = DocumentOfARAPAccounting;
			RowPrimaryDocuments.SourceDocumentType = Enums.SourceDocumentTypes.PurchaseFromVendor;
		EndIf;
	EndDo;
EndProcedure
Procedure DeferredProcessing_RevenueAdjustment(Object, ObjectIsModified, ExchangeComponents)
	FillingInPartnerInDocumentHeader(Object);
	If Not ValueIsFilled(Object.VATTaxation) And ValueIsFilled(Object.DocumentBasis) Then
		Object.VATTaxation = Common.ObjectAttributeValue(Object.DocumentBasis, "VATTaxation");
	EndIf;
	If Not ValueIsFilled(Object.ARAPCurrency) Then
		If ValueIsFilled(Object.Contract) Then
			Object.ARAPCurrency = Common.ObjectAttributeValue(Object.Contract, "ARAPCurrency");
		Else
			Object.ARAPCurrency = Object.Currency;
		EndIf;
	EndIf;
	If Not ValueIsFilled(Object.GoodsReceiptOption) Then
		
		GoodsReceiptOption = Enums.GoodsReceiptOptions.DividedByOrdersAndInvoices;
		
		If ValueIsFilled(Object.DocumentBasis) And Common.RefExists(Object.DocumentBasis) Then
			
			BasisType = TypeOf(Object.DocumentBasis); 
			
			If (BasisType = Type("DocumentRef.VendorInvoice")
				Or BasisType = Type("DocumentRef.DiscrepancyReportFollowingReceipt")) Then
				GoodsReceiptOption = Common.ObjectAttributeValue(Object.DocumentBasis,
					"GoodsReceiptOption");
			EndIf; 
			
		EndIf;
		
		Object.GoodsReceiptOption = GoodsReceiptOption;
		
	EndIf;
	// Filling in the column quantity of packages in PM Goods
	For Each String In Object.Goods Do
		If String.Count = 0 Then
			Continue;
		EndIf;
		Coef = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(String.Package, String.Products);
		If Coef = 0 Then
			String.NumberOfPackages = String.Count;
		Else
			String.NumberOfPackages = Round(String.Count / Coef, 3);
		EndIf;
	EndDo; 
	// Filling in the column Number of packages in TS Discrepancies
	For Each String In Object.Discrepancies Do
		If String.Count = 0 Then
			Continue;
		EndIf;
		Coef = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(String.Package, String.Products);
		If Coef = 0 Then
			String.NumberOfPackages = String.Count;
		Else
			String.NumberOfPackages = Round(String.Count / Coef, 3);
		EndIf;
	EndDo;
	
	If ValueIsFilled(Object.DocumentBasis) And Common.RefExists(Object.DocumentBasis) Then
		BusinessTransactionGrounds = Common.ObjectAttributeValue(Object.DocumentBasis, "BusinessOperation");
		FillingInAgreementWithSupplierInHeaderOfDocument(Object, ExchangeComponents.ConversionParameters_SSLy, BusinessTransactionGrounds);
		// Filling in the variant of reflecting discrepancies.
		For Each String In Object.Discrepancies Do
			If String.NumberOfPackages > 0 Then
				String.PostingOption = Enums.OptionsOfPostingReceiptAdjustingEntries.IncreasePurchaseIncreaseWarehouseStock;
			Else
				String.PostingOption = Enums.OptionsOfPostingReceiptAdjustingEntries.ReducePurchaseReduceWarehouseStock;
			EndIf;		
		EndDo;
	Else 
		WarningTemplate = NStr("vi = 'Trong chứng từ %1 chưa điền chứng từ cơ sở. Một số mục tin có thể được điền không chính xác.';
								|ru = 'У документа %1 не заполнен документ-основание. Некоторые реквизиты могут быть заполнены не корректно.';
								|en = 'The base document is not filled in for the %1 document. Some attributes may be filled in incorrectly.'; fa = 'The base document is not filled in for the %1 document. Some attributes may be filled in incorrectly.';
								|it = 'Nel documento %1 non è compilato il documento di base. Alcuni attributi possono essere stati compilati in modo errato.';
								|pl = 'Dla dokumentu %1 nie jest wypełniony dokument źródłowy. Niektóre atrybuty mogą być wypełnione niepoprawnie.';
								|tr = '%1 belgesinde temel belge doldurulmadı. Bazı öznitelikler doğru doldurulmamış olabilir.'");
		WarningText = StrTemplate(WarningTemplate, Object.Ref);
		SynchronizationWarning_(ExchangeComponents, Object.Ref, WarningText);
	EndIf;
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	FillInCalculationProcedure(Object, Object.Contract, Object.Terms);
	
	FillInDefaultActivity(Object, "PurchaseForActivity");
EndProcedure
Procedure DeferredProcessing_ImplementationAdjustment(Object, ObjectIsModified, ExchangeComponents)
	FillingInPartnerInDocumentHeader(Object);
	If Not ValueIsFilled(Object.VATTaxation) And ValueIsFilled(Object.DocumentBasis) Then
		Object.VATTaxation = Common.ObjectAttributeValue(Object.DocumentBasis, "VATTaxation");
	EndIf;
	If Not ValueIsFilled(Object.ARAPCurrency) Then
		If ValueIsFilled(Object.Contract) And Common.RefExists(Object.Contract) Then
			Object.ARAPCurrency = Common.ObjectAttributeValue(Object.Contract, "ARAPCurrency");
		Else
			Object.ARAPCurrency = Object.Currency;
			Object.AmountARAP  = Object.DocumentAmount;
		EndIf;
	EndIf;
	// Filling in the column quantity of packages in PM Goods
	For Each String In Object.Goods Do
		If String.Count = 0 Then
			Continue;
		EndIf;
		Coef = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(String.Package, String.Products);
		If Coef = 0 Then
			String.NumberOfPackages = String.Count;
		Else
			String.NumberOfPackages = Round(String.Count / Coef, 3);
		EndIf;
	EndDo;   
	// Filling in the column Number of packages in TS Discrepancies
	For Each String In Object.Discrepancies Do
		If String.Count = 0 Then
			Continue;
		EndIf;
		Coef = Catalogs.PackagesAndUnitsOfMeasure.PackagingFactor(String.Package, String.Products);
		If Coef = 0 Then
			String.NumberOfPackages = String.Count;
		Else
			String.NumberOfPackages = Round(String.Count / Coef, 3);
		EndIf;
	EndDo;
	
	If ValueIsFilled(Object.DocumentBasis) Then
		BusinessTransactionGrounds = Common.ObjectAttributeValue(Object.DocumentBasis, "BusinessOperation");
		FillingInAgreementWithClientInHeaderOfDocument(Object, BusinessTransactionGrounds);
		// Filling in the variant of reflecting discrepancies.
		For Each String In Object.Discrepancies Do
			If String.NumberOfPackages > 0 Then
				String.PostingOption = Enums.CreditNoteRecordingOptions.IncreaseSaleReduceWarehouseStock;
			Else
				String.PostingOption = Enums.CreditNoteRecordingOptions.ReduceSaleIncreaseWarehouseStock;
			EndIf;		
		EndDo;
	EndIf;
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	FillInCalculationProcedure(Object, Object.Contract, Object.Terms);
EndProcedure


Procedure DeferredProcessing_AccrualOfLoansDeposits(Object, ExchangeComponents)
	Partner = Undefined;
	
	For Each String In Object.Accruals Do
		
		If Not ValueIsFilled(String.IncomeAndExpenseItem)
			And ValueIsFilled(Object.BusinessOperation) Then
			
			If Object.BusinessOperation = Enums.BusinessTransactions.LoansInterestCharge Then
				String.IncomeAndExpenseItem = DefaultElement(ExchangeComponents, "ExpenseItemLoans");
			Else
				String.IncomeAndExpenseItem = DefaultElement(ExchangeComponents, "IncomeItemLoansDeposits");
			EndIf;
		EndIf;
		
		Partner = CashServer.GetCounterpartyPartner(String.Counterparty);
	
		If Not ValueIsFilled(Partner) Then
			Partner = Catalogs.Partners.UnknownPartner;
		EndIf;
		
		If Not ValueIsFilled(String.Partner)
			Or String.Partner <> Partner Then
			String.Partner = Partner;
		EndIf;
		
		If Not ValueIsFilled(String.Department) Then
			Department = Undefined;
			If ValueIsFilled(String.Contract) Then
				Department = Common.ObjectAttributeValue(String.Contract, "Department");
			EndIf;
			If Not ValueIsFilled(Department) Then
		    	Department = DefaultElement(ExchangeComponents, "Department");
		    EndIf;
		    
		    String.Department = Department;
		EndIf;
		
	EndDo;
EndProcedure


Procedure DeferredProcessing_Products(Object, ExchangeComponents)
	If Not ValueIsFilled(Object.AccessGroup) Then
		Object.AccessGroup = DefaultElement(ExchangeComponents, "ProductAccessGroup");
	EndIf;
	
	If Not ValueIsFilled(Object.Quality) Then
		Object.Quality = Enums.QualityLevels.New;
	EndIf;
	
	If Not ValueIsFilled(Object.SaleRegistrationOption) Then
		Object.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice;
	EndIf;
	
	If Not ValueIsFilled(Object.UseVariants) Then
		ProductsForDeferredProcessing = ExchangeComponents.ConversionParameters_SSLy.ProductsForDeferredProcessing; // Array
		ProductsForDeferredProcessing.Add(Object.Ref);
	EndIf;
	
	If ValueIsFilled(Object.OriginCountry) And Not Object.KeepRecordsByCCD Then
		Object.KeepRecordsByCCD = True;
	EndIf;
	
	If ValueIsFilled(Object.FEACNCode) And Common.RefExists(Object.FEACNCode) Then
		TracedGoods = Common.ObjectAttributeValue(Object.FEACNCode, "TracedGoods");
		If TracedGoods And Not Object.KeepRecordsByCCD Then
			Object.KeepRecordsByCCD = True;
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(Object.UnitOfMeasure) 
		And Object.ItemsType <> Enums.ItemsTypes.OperationService Then
		Object.UnitOfMeasure = DefaultElement(ExchangeComponents, "UnitOfMeasure");	
	EndIf;
	
	// When uploading, it is necessary to check for an entry in the PC,
	// otherwise the default rate (20%) gets into the document.
	CurrentVATRate = InformationRegisters.ProductsVATRates.CurrentVATRateOfProductByMainCountry(Object.Ref);
	If Object.VATRate <> CurrentVATRate Then
		
		If CurrentVATRate.IsEmpty() Then
			
			RecordDate = Date(1980, 1, 1);
			
		Else
			
			RecordDate = CurrentSessionDate();
			
		EndIf;
		
		InformationRegisters.ProductsVATRates.SetCurrentVATRateOfProductForMainCountry(
			Object.Ref, Object.VATRate, False, RecordDate);
		
	EndIf;
	
	#Region ProductKind
	If Not ValueIsFilled(Object.ProductKind)
		And ValueIsFilled(Object.ItemsType) Then
		// The type of nomenclature is selected by type and on the basis of alcoholic beverages.
		ProductKind = Undefined;
		
		SearchParameters = New Structure("ItemsType, AlcoholContainingProducts");
		FillPropertyValues(SearchParameters, Object);
		NaydLines = ExchangeComponents.ConversionParameters_SSLy.DefaultProductTypes.FindRows(SearchParameters);
		NaydString = ?(NaydLines.Count() = 0, Undefined, NaydLines[0]);
	
		If NaydString = Undefined Then
	
			YouMustCreateElement = False;
	
			If SearchParameters.ItemsType = Enums.ItemsTypes.OwnGoods Then
				NameOfItemToExchangeByDefault = NStr("vi = 'Hàng hóa';
													|ru = 'Товар';
													|en = 'Product'; fa = 'کالا';
													|it = 'Merce';
													|pl = 'Towar';
													|tr = 'Ürün'", Metadata.DefaultLanguage.LanguageCode); // the string is written to the IB
			ElsIf SearchParameters.ItemsType = Enums.ItemsTypes.OperationService Then
				NameOfItemToExchangeByDefault = NStr("vi = 'Dịch vụ';
													|ru = 'Услуга';
													|en = 'Service'; fa = 'خدمت';
													|it = 'Servizio';
													|pl = 'Usługa';
													|tr = 'Hizmet'", Metadata.DefaultLanguage.LanguageCode); // the string is written to the IB
			EndIf;
			
			If SearchParameters.AlcoholContainingProducts Then
				NameOfItemToExchangeByDefault = NameOfItemToExchangeByDefault + "; ALC";
			EndIf;
	
			Query = New Query("SELECT TOP 2
			|	ItemKinds.Ref AS ProductKind,
			|	CASE
			|		WHEN ItemKinds.Description = &NameOfItemToExchangeByDefault
			|			THEN TRUE
			|		ELSE FALSE
			|	END AS ThisIsDefaultItemForSharing
			|FROM
			|	Catalog.ItemKinds AS ItemKinds
			|WHERE
			|	NOT ItemKinds.DeletionMark
			|	AND ItemKinds.ItemsType = &ItemsType
			|	AND ItemKinds.AlcoholContainingProducts = &AlcoholContainingProducts
			|
			|ORDER BY
			|	ThisIsDefaultItemForSharing DESC");
	
			Query.SetParameter("ItemsType", SearchParameters.ItemsType);
			Query.SetParameter("AlcoholContainingProducts", SearchParameters.AlcoholContainingProducts);
			Query.SetParameter("NameOfItemToExchangeByDefault", NameOfItemToExchangeByDefault);
			QueryResult = Query.Execute();
	
			Selection = QueryResult.Select();
			If Selection.Next() Then
				If Selection.Count() = 1 Or Selection.ThisIsDefaultItemForSharing Then
					ProductKind = Selection.ProductKind;
				Else
					YouMustCreateElement = True;
				EndIf;
			Else
				YouMustCreateElement = True;
			EndIf;
	
			// Creating an item to exchange with the specified parameters
			If YouMustCreateElement Then
				
				ItemProductType = Catalogs.ItemKinds.CreateItem();
				
				FillPropertyValues(ItemProductType, SearchParameters);
				
				ItemProductType.Description                            = NameOfItemToExchangeByDefault;
				ItemProductType.LongDesc                                = NStr("vi = '#Đã tạo tự động khi trao đổi trên cơ sở định dạng dữ liệu đa năng';
																				|ru = '#Создан автоматически при обмене на основе универсального формата данных';
																				|en = '#Created automatically during exchange based on the interim format data'; fa = '#Created automatically during exchange based on the interim format data';
																				|it = '#Creato automaticamente durante lo scambio in base a un formato dati universale';
																				|pl = '#Utworzono automatycznie podczas wymiany na podstawie uniwersalnego formatu danych';
																				|tr = '#Yaygın veri biçimine göre değişim sırasında otomatik olarak oluşturuldu'", Metadata.DefaultLanguage.LanguageCode); // the string is written to the IB
				ItemProductType.SaleRegistrationOption                = Enums.SalesRegistrationOptions.CustomerInvoice;
				ItemProductType.UseVariants              = Enums.ItemVariantsUsageOptions.DontUse;
				ItemProductType.BatchUsageSettings             = Enums.ItemsBatchUsageSettings.InventoryItem;
				ItemProductType.PrecisionOfBatchShelfLifeIndication      = Enums.AccuracyOfShelfLifeIndication.UpToDays;
				ItemProductType.NameTemplateForPrintingOfProductItem = "[Description]";
				ItemProductType.NameTemplateForPrintingOfProductItem = "[Description]";
				ItemProductType.UseVariants              = Enums.ItemVariantsUsageOptions.DontUse;
				
				// Filling in the access group
				If Not ValueIsFilled(ItemProductType.AccessGroup)
					And GetFunctionalOption("UseItemAccessGroups") Then
					ItemProductType.AccessGroup = Object.AccessGroup;
				EndIf;
				
				Try
					ItemProductType.Write();
					ProductKind = ItemProductType.Ref;
				Except
					ProductKind = Catalogs.ItemKinds.EmptyRef();
					WriteErrorToEventLog(ProductKind,
						DetailErrorDescription(ErrorInfo()), ExchangeComponents);
				EndTry
			EndIf;
			
			NewRow = ExchangeComponents.ConversionParameters_SSLy.DefaultProductTypes.Add();
			FillPropertyValues(NewRow, SearchParameters);
			NewRow.ProductKind = ProductKind;
			
		Else
			ProductKind = NaydString.ProductKind;
		EndIf;	
		Object.ProductKind = ProductKind;
	EndIf;
	#EndRegion
	
	ListOfProperties = New Array;
	ListOfProperties.Add("AccountingFeature");
	ListOfProperties.Add("BatchOwner");
	ListOfProperties.Add("ItemVariantsOwner");
	ListOfProperties.Add("ProductCategoryOwner");
	TMCommonUseClientServer.FillInValuesOfEmptyProperties(Object, Object.ProductKind, ListOfProperties);
EndProcedure
