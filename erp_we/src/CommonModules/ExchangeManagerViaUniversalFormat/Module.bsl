Procedure OCR_Catalog_Products_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents, True);
	
	If PropertyOfExchangeFormat(ExchangeComponents, "Справочник.ГруппыАналитическогоУчетаНоменклатуры")
		And XDTOData.Property("AnalyticalGroup")
		And ValueIsFilled(XDTOData.AnalyticalGroup) Then //@NON-NLS-1
		
		ReceivedData.AdditionalProperties.Insert("AnalyticalGroup",
			New Structure("Value, OCRName", XDTOData.AnalyticalGroup, "Cat_AnalyticalInventoryGroups"));
			
	EndIf;
	
	If XDTOData.Property("FEACNCode") And ValueIsFilled(XDTOData.FEACNCode) Then
	    If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			ReceivedData.AdditionalProperties.Insert("FEACNCode",
				New Structure("Value, OCRName", XDTOData.FEACNCode, "Catalog_FEACN_CatalogItem"));
		Else
			ReceivedData.AdditionalProperties.Insert("FEACNCode",
				New Structure("Value, OCRName", XDTOData.FEACNCode, "Catalog_FEACN"));
		EndIf;		
	EndIf;
	
	
	If XDTOData.Property("VATRate") And ValueIsFilled(XDTOData.VATRate) Then
		ReceivedData.AdditionalProperties.Insert("VATRate", CatalogOfVATRateTransfers(ExchangeComponents, XDTOData.VATRate));
	EndIf;
	
	If XDTOData.Property("ExpirationDate_") Then
		ReceivedData.AdditionalProperties.Insert("ExpirationDate_", XDTOData.ExpirationDate_);
	EndIf;
	
	DownloadExpirationDateMeasurementUnit(XDTOData, ReceivedData, ExchangeComponents);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21")
		And XDTOData.Property("Principal") And ValueIsFilled(XDTOData.Principal) Then
		
		If XDTOData.Principal.ValueType = "Organization" Then
			CurICO = "Catalog_Companies_Receive";
		ElsIf XDTOData.Principal.ValueType = "Counterparty" Then
			CurICO = "Catalog_Counterparties_Receive";
		Else
			CurICO = Undefined;
		EndIf;
		If Not IsBlankString(CurICO) Then
			DescriptionOfReceipt = New Structure("Value, OCRName", XDTOData.Principal, CurICO);
			ReceivedData.AdditionalProperties.Insert("Principal", DescriptionOfReceipt);
			
			ICOString = New Structure;
			ICOString.Insert("ConversionRule", DataExchangeXDTOServer.OCRByName(ExchangeComponents, CurICO));
			ICOString.Insert("DeleteObjectsCreatedByKeyProperties", True);
			PrincipalLink = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents, XDTOData.Principal, ICOString, "GetRef");
			ReceivedData.AdditionalProperties.Insert("PrincipalIncomingLink", PrincipalLink);
		EndIf;
		
	EndIf;
EndProcedure
Procedure OCR_Catalog_Products_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If Not IBData = Undefined Then
		FillInBankingDetails(ReceivedData, IBData, "VATRate, AnalyticalGroup");
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	
	If DataToWriteToIB.WeightUse And (
		Not ValueIsFilled(DataToWriteToIB.WeightDenominator)
		Or Not ValueIsFilled(DataToWriteToIB.WeightNumerator)) Then
		
		DataToWriteToIB.WeightDenominator      = 1;
		DataToWriteToIB.WeightNumerator        = 1;
		DataToWriteToIB.WeightUnitOfMeasure = ProductsServer.DefaultUnitOfMeasurement("Weight");
	EndIf;
	
	If Not ValueIsFilled(DataToWriteToIB.ItemsType) Then
		DataToWriteToIB.ItemsType = Enums.ItemsTypes.OwnGoods;
	EndIf;
	
	If ReceivedData.AdditionalProperties.Property("ShelfLifeUnitOfMeasure")
		And ValueIsFilled(ReceivedData.AdditionalProperties.ShelfLifeUnitOfMeasure) Then 
		DataToWriteToIB.ShelfLifeUnitOfMeasure = ReceivedData.AdditionalProperties.ShelfLifeUnitOfMeasure;
	EndIf;
	If ReceivedData.AdditionalProperties.Property("ExcisableGoods") Then
		Country = SettingsValueClientServerCached.MainCountry(); 
		ExcisableGoods = ReceivedData.AdditionalProperties.ExcisableGoods;
		InformationRegisters.ExcisableGoodsCategories.UploadExcisableItemAttribute(DataToWriteToIB.Ref, Country, ExcisableGoods);   
	EndIf;
	ImportAdditionalInfo(?(IBData = Undefined, ReceivedData.GetNewObjectRef(), IBData.Ref), 
	ReceivedData.AdditionalProperties, ExchangeComponents);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.21") Then
		
		If ReceivedData.AdditionalProperties.Property("PrincipalIncomingLink") Then
			PrincipalReceived = ReceivedData.AdditionalProperties.PrincipalIncomingLink;
			ErrorText = "";
			If Not ValueIsFilled(PrincipalReceived) Then
				ErrorText = NStr("ru = 'Не удалось получить Принципала для номенклатуры.';
								|vi = 'Cannot get the Principal for the item.';
								|en = 'Cannot get the Principal for the item.'; fa = 'Cannot get the Principal for the item.';
								|it = 'Cannot get the Principal for the item.';
								|pl = 'Cannot get the Principal for the item.';
								|tr = 'Stok kalemi için müvekkil alınamadı.'");
			ElsIf  TypeOf(PrincipalReceived) = Type("CatalogRef.Companies")  Then
				DataToWriteToIB.Principal = PrincipalReceived;
			ElsIf  TypeOf(PrincipalReceived) = Type("CatalogRef.Counterparties")  Then
				CurPartner_ = Common.ObjectAttributeValue(PrincipalReceived, "Partner");
				DataToWriteToIB.Principal = CurPartner_;
				
				If Not ValueIsFilled(CurPartner_) Then
					ErrorText = NStr("ru = 'Не удалось получить партнера по контрагенту.';
									|vi = 'Cannot get the partner by counterparty.';
									|en = 'Cannot get the partner by counterparty.'; fa = 'Cannot get the partner by counterparty.';
									|it = 'Cannot get the partner by counterparty.';
									|pl = 'Cannot get the partner by counterparty.';
									|tr = 'Cari hesap üzerinden partner alınamadı.'");
				EndIf;
			EndIf;
			
			If Not IsBlankString(ErrorText) Then
				WriteErrorToEventLog(IBData.Ref, ErrorText, ExchangeComponents, EventLogLevel.Warning);		
				InformationRegisters.DataExchangeResults.RecordDocumentCheckError(
				IBData.Ref,
				ExchangeComponents.CorrespondentNode,
				ErrorText,
				Enums.DataExchangeIssuesTypes.BlankAttributes);
			EndIf;
			
		EndIf;
	EndIf;
EndProcedure

