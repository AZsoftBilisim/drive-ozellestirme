Procedure OCR_Document_IssuedTaxInvoicePrepayment_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_InvoiceIssuedAdvancePayment_Sending", 
										"Prepayments", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	UploadKitOfPrintedDocumentsSignedSign(ExchangeComponents, IBData, XDTOData);
	
	If TypeOf(IBData.Counterparty) = Type("CatalogRef.Companies") Then
		CounterpartyOrganization = IBData.Counterparty;
		LinkToCounterparty = CounterpartyFromOrganization(CounterpartyOrganization, ExchangeComponents);
	ElsIf TypeOf(IBData.Counterparty) = Type("CatalogRef.Counterparties") Then
		LinkToCounterparty = IBData.Counterparty;
	Else
		LinkToCounterparty = Catalogs.Counterparties.EmptyRef();
	EndIf;
	
	If Not ValueIsFilled(IBData.TransactionKindCode) Then
		XDTOData.Insert("TransactionKindCode", "02");
	EndIf;
	
	If IBData.IssuedInElectronicFormat Then
		XDTOData.Insert("BillingMethod", "InElectronicForm");
	Else
		XDTOData.Insert("BillingMethod", "OnPaperMedium");
	EndIf; 
	
	XDTOData.Insert("Counterparty",       LinkToCounterparty);
	XDTOData.Insert("Issued",        ValueIsFilled(IBData.IssueDate));
	XDTOData.Insert("Director",     IBData.Director.Individual);
	XDTOData.Insert("ChiefAccountant", IBData.ChiefAccountant.Individual);
	XDTOData.Insert("Currency",           SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	XDTOData.Insert("InvoiceType",  "AdvancePayment");
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		XDTOData.Insert("TINOfCounterparty", IBData.TINOfCounterparty);
		XDTOData.Insert("CounterpartyCRTR", IBData.CounterpartyCRTR);
	EndIf;
	
	UploadIdOfStateContract(IBData, XDTOData, ExchangeComponents);
	
	// Getting information from the foundation document.
	Document__CurrencyOfSettlements     = Undefined;
	DocumentBasis_ContractLink            = Undefined;
	Document__CalculationsInConventionalUnits = False;
	DocumentBase_NameOfICO                   = "";
	
	OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity");
	
	Query = New Query();
	Query.SetParameter("Ref", IBData.DocumentBasis);
	
	TypeOfBaseDocumentValue = TypeOf(IBData.DocumentBasis);
	
	If TypeOfBaseDocumentValue = Type("DocumentRef.CashAccountReceiptNote")
		Or TypeOfBaseDocumentValue = Type("DocumentRef.CashVoucher")
		Or TypeOfBaseDocumentValue = Type("DocumentRef.BankAccountReceiptNote")
		Or TypeOfBaseDocumentValue = Type("DocumentRef.BankAccountIssue")
		Or TypeOfBaseDocumentValue = Type("DocumentRef.PaymentCardTransaction") Then
		
		Query.Text = "SELECT
			|	ARAPDetails.ARAPObject.Object AS OrderDocument,
			|	ARAPDetails.ARAPObject.OBJECT.Terms AS Terms,
			|	ARAPDetails.ARAPObject.OBJECT.SalesOpportunity AS SalesOpportunity,
			|	ARAPDetails.ARAPCurrency
			|INTO ContractData
			|FROM
			|	&DocumentTable AS ARAPDetails
			|WHERE
			|	ARAPDetails.Ref = &Ref
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.OrderDocument
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.ARAPCurrency
			|FROM
			|	ContractData AS ContractData
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.Terms
			|FROM
			|	ContractData AS ContractData
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.SalesOpportunity
			|FROM
			|	ContractData AS ContractData";
		
		Query.Text = StrReplace(Query.Text, "&DocumentTable", "Document." + IBData.DocumentBasis.Metadata().Name + ".ARAPDetails");
		ContractData = Query.ExecuteBatch();
		
		ConvolutionByOrders = ContractData[1].Unload();
	
		If ConvolutionByOrders.Count() = 1 Then
			
			SalesOrder = ConvolutionByOrders[0].OrderDocument;
			
			If ValueIsFilled(SalesOrder) And Common.RefExists(SalesOrder) Then
				If TypeOf(SalesOrder) = Type("CatalogRef.CounterpartyContracts") Then
					DocumentBasis_ContractLink = SalesOrder;
				ElsIf TypeOf(SalesOrder) = Type("DocumentRef.SalesOrder") Then
					OrderDocument.OrderDocument = SalesOrder;
				EndIf;
			EndIf;
			
		EndIf;
		
		ConvolutionBySettlementCurrency = ContractData[2].Unload();
		If ConvolutionBySettlementCurrency.Count() = 1 Then
			Document__CurrencyOfSettlements = ConvolutionBySettlementCurrency[0].ARAPCurrency;
		EndIf;
		
		ConvolutionByAgreement = ContractData[3].Unload();
		If ConvolutionByAgreement.Count() = 1 Then
			OrderDocument.Terms = ConvolutionByAgreement[0].Terms;
		EndIf;
		
		ConvolutionByTransactions = ContractData[4].Unload();
		If ConvolutionByTransactions.Count() = 1 Then
			OrderDocument.SalesOpportunity = ConvolutionByTransactions[0].SalesOpportunity;
		EndIf;
		
		If TypeOfBaseDocumentValue = Type("DocumentRef.CashAccountReceiptNote") Then
			DocumentBase_NameOfICO = "Document_PCOSettlementsWithCounterparties_Sending";
		ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.PaymentCardTransaction") Then
			DocumentBase_NameOfICO = "Document_PaymentCardOperation_Sending";
		ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.BankAccountReceiptNote") Then
			DocumentBase_NameOfICO = "Document_PBDSSettlementsWithCounterparties_Sending";
		ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.CashVoucher") Then
			DocumentBase_NameOfICO = "Document_RCOSettlementsWithCounterparties_Sending";	
		ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.BankAccountIssue") Then
			DocumentBase_NameOfICO = "Document_SBDSSettlementsWithCounterparties_Sending";
		EndIf;
		
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.ReturnOfGoodsFromCustomer") Then
		
		Query.Text = "SELECT
			|	ARAPDetails.Ref.Terms AS Terms,
			|	ARAPDetails.Ref.Terms.Currency AS AgreementCurrency,
			|	ARAPDetails.Ref.SalesOpportunity AS SalesOpportunity,
			|	ARAPDetails.ARAPObject.Object AS OrderDocument,
			|	ARAPDetails.ARAPCurrency
			|INTO ContractData
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.ARAPDetails AS ARAPDetails
			|WHERE
			|	ARAPDetails.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT TOP 1
			|	ContractData.Terms,
			|	ContractData.SalesOpportunity,
			|	ContractData.ARAPCurrency,
			|	ContractData.AgreementCurrency
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.OrderDocument
			|FROM
			|	ContractData AS ContractData";
		
		ContractData = Query.ExecuteBatch();
		
		MainAttributes = ContractData[1].Unload();
	
		If MainAttributes.Count() > 0 Then
			
			OrderDocument.Terms = MainAttributes[0].Terms;
			
			If ValueIsFilled(MainAttributes[0].AgreementCurrency) Then
				Document__CurrencyOfSettlements = MainAttributes[0].AgreementCurrency;
			Else
				Document__CurrencyOfSettlements = MainAttributes[0].ARAPCurrency;
			EndIf;
		EndIf;
	
		ConvolutionByOrders = ContractData[2].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			
			SalesOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(SalesOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = SalesOrder;
			ElsIf TypeOf(SalesOrder) = Type("DocumentRef.SalesOrder") Then
				OrderDocument.OrderDocument = SalesOrder;
			EndIf;
			
		EndIf;
		
		DocumentBase_NameOfICO = "Document_ReturnOfGoodsFromCustomer_Sending";
			
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.ARAPSettlement") Then
		
		TSName                    = "AccountsReceivable";
		PaymentType_              = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting;
		DocumentBase_NameOfICO = "Document_VZ_OurOrganization";
		
		If IBData.Organization = Common.ObjectAttributeValue(IBData.DocumentBasis, "Creditor") Then
			TSName = "AccountsPayable";
			PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
			
			DocumentBase_NameOfICO = "Document_VZ_LenderOrganization";
		EndIf;
		
		Query.Text = "SELECT
			|	TabDoc.ARAPObject.Object AS OrderDocument,
			|	TabDoc.ARAPObject.OBJECT.Terms AS Terms,
			|	TabDoc.ARAPObject.OBJECT.SalesOpportunity AS SalesOpportunity,
			|	TabDoc.ARAPCurrency
			|INTO ContractData
			|FROM
			|	&DocumentTable AS TabDoc
			|WHERE
			|	TabDoc.Ref = &Ref
			|	AND TabDoc.PaymentType_ = &PaymentType_
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.OrderDocument
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.ARAPCurrency
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.Terms
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.SalesOpportunity
			|FROM
			|	ContractData AS ContractData";
		
		Query.Text = StrReplace(Query.Text, "&DocumentTable", "Document.ARAPSettlement." + TSName);
		Query.SetParameter("PaymentType_", PaymentType_);
		
		ContractData = Query.ExecuteBatch();
		
		ConvolutionByOrders = ContractData[1].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			
			SalesOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(SalesOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = SalesOrder;
			ElsIf TypeOf(SalesOrder) = Type("DocumentRef.SalesOrder") Then
				OrderDocument.OrderDocument = SalesOrder;
			EndIf;
			
		EndIf;
		
		ConvolutionBySettlementCurrency = ContractData[2].Unload();
		If ConvolutionBySettlementCurrency.Count() = 1 Then
			Document__CurrencyOfSettlements = ConvolutionBySettlementCurrency[0].ARAPCurrency;
		EndIf;
		
		ConvolutionByAgreement = ContractData[3].Unload();
		If ConvolutionByAgreement.Count() = 1 Then
			OrderDocument.Terms = ConvolutionByAgreement[0].Terms;
		EndIf;
		
		ConvolutionByTransactions = ContractData[4].Unload();
		If ConvolutionByTransactions.Count() = 1 Then
			OrderDocument.SalesOpportunity = ConvolutionByTransactions[0].SalesOpportunity;
		EndIf;
		
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.ARAPAdjustment") Then
		
		DocumentBase_NameOfICO = "Document_CZ_DebtAdjustment";
		
		Query.Text = "SELECT
			|	TabDoc.ARAPObject.Object AS OrderDocument,
			|	TabDoc.ARAPObject.Object.Terms AS Terms,
			|	TabDoc.ARAPObject.Object.SalesOpportunity AS SalesOpportunity,
			|	TabDoc.ARAPCurrency
			|INTO ContractData
			|FROM
			|	Document.ARAPAdjustment.Debt_ AS TabDoc
			|WHERE
			|	TabDoc.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.OrderDocument
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.ARAPCurrency
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.Terms
			|FROM
			|	ContractData AS ContractData
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	ContractData.SalesOpportunity
			|FROM
			|	ContractData AS ContractData";
		
		ContractData = Query.ExecuteBatch();
		
		ConvolutionByOrders = ContractData[1].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			
			SalesOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(SalesOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = SalesOrder;
			ElsIf TypeOf(SalesOrder) = Type("DocumentRef.SalesOrder") Then
				OrderDocument.OrderDocument = SalesOrder;
			EndIf;
			
		EndIf;
		
		ConvolutionBySettlementCurrency = ContractData[2].Unload();
		If ConvolutionBySettlementCurrency.Count() = 1 Then
			Document__CurrencyOfSettlements = ConvolutionBySettlementCurrency[0].ARAPCurrency;
		EndIf;
		
		ConvolutionByAgreement = ContractData[3].Unload();
		If ConvolutionByAgreement.Count() = 1 Then
			OrderDocument.Terms = ConvolutionByAgreement[0].Terms;
		EndIf;
		
		ConvolutionByTransactions = ContractData[4].Unload();
		If ConvolutionByTransactions.Count() = 1 Then
			OrderDocument.SalesOpportunity = ConvolutionByTransactions[0].SalesOpportunity;
		EndIf;
		
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.IntercompanyGoodsReturn") Then
	
		Query.Text = "SELECT
			|	Doc.Currency
			|FROM
			|	Document.IntercompanyGoodsReturn AS Doc
			|WHERE
			|	Doc.Ref = &Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT TOP 1
			|	ARAPDetails.ARAPCurrency
			|FROM
			|	Document.IntercompanyGoodsReturn.ARAPDetails AS ARAPDetails
			|WHERE
			|	ARAPDetails.Ref = &Ref
			|
			|ORDER BY
			|	ARAPDetails.LineNumber";
		
		QueryResult = Query.ExecuteBatch();	
		HeaderData_              = QueryResult[0].Unload()[0];
		PaymentDecryptionData = QueryResult[1].Unload();
		
		If PaymentDecryptionData.Count() = 1 Then
			Document__CurrencyOfSettlements = PaymentDecryptionData[0].ARAPCurrency;
			Document__CalculationsInConventionalUnits = (HeaderData_.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization)
				And HeaderData_.Currency <> PaymentDecryptionData[0].ARAPCurrency);
		Else
			Document__CurrencyOfSettlements = HeaderData_.Currency;
		EndIf;
		
		DocumentBase_NameOfICO = "RefundBetweenOrganizations_FromBuyer_Sending";
		
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.SaleAdjustment") Then
		
		DocumentBase_NameOfICO = "Document_ImplementationAdjustment_Dispatch";
		CurrenciesData = Common.ObjectAttributesValues(IBData.DocumentBasis, "Currency, ARAPCurrency");
	
		Document__CurrencyOfSettlements = CurrenciesData.ARAPCurrency;
	
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.SourceDocument") Then
	
		DocumentBase_NameOfICO = "Document_PrimaryDocument_Sending";
	EndIf;
	
	If Not ValueIsFilled(Document__CurrencyOfSettlements) Then
		Document__CurrencyOfSettlements = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	EndIf;
	
	If ValueIsFilled(DocumentBasis_ContractLink) Then
		XDTOData.Insert("Contract", DocumentBasis_ContractLink);
	Else
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty           = XDTOData.Counterparty;
		DefaultParameters.Organization          = IBData.Organization;
		DefaultParameters.ARAPCurrency = Document__CurrencyOfSettlements;
		DefaultParameters.TypeOfAgreement          = "WithCustomer";
		DefaultParameters.Date                 = IBData.Date;
		DefaultParameters.Number                = IBData.Number;
		
		If Not Document__CalculationsInConventionalUnits Then
			Document__CalculationsInConventionalUnits = (XDTOData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization)
				And XDTOData.Currency <> Document__CurrencyOfSettlements);
		EndIf;
		
		DefaultParameters.CalculationsInConventionalUnits = Document__CalculationsInConventionalUnits;
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	//TabularSections
	QueryText =
		"SELECT
		|	InvoiceAdvanceIssuedAdvances.Products AS Products,
		|	&QueryTextCharacteristic,
		|	InvoiceAdvanceIssuedAdvances.Content AS Content,
		|	InvoiceAdvanceIssuedAdvances.Sum AS Sum,
		|	InvoiceAdvanceIssuedAdvances.VATRate AS VATRate,
		|	InvoiceAdvanceIssuedAdvances.VATAmount AS VATAmount
		|FROM
		|	Document.IssuedTaxInvoicePrepayment.Prepayments AS InvoiceAdvanceIssuedAdvances
		|WHERE
		|	InvoiceAdvanceIssuedAdvances.Ref = &Ref
		|	AND NOT InvoiceAdvanceIssuedAdvances.Sum = 0";
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "InvoiceAdvanceIssuedAdvances"));
		
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Prepayments = Query.Execute().Unload();
	
	If Prepayments.Count() > 0 Then
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Prepayments, True, False); 
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
			RedefineVATRateForOldFormats(Prepayments, False);
		EndIf;
		XDTOData.Insert("Prepayments", Prepayments);
	EndIf;
	
	If ValueIsFilled(IBData.DocumentBasis) Then
		BasisDocuments = New ValueTable();
		BasisDocuments.Columns.Add("DocumentBasis");
		StringBase = BasisDocuments.Add();
		StringBase.DocumentBasis = New Structure("Value, OCRName",
			IBData.DocumentBasis, DocumentBase_NameOfICO);
		XDTOData.Insert("BasisDocuments", BasisDocuments);
	EndIf;
	
	If ValueIsFilled(IBData.DateOfDocumentInARAPAccounting)
		And ValueIsFilled(IBData.SettlementDocumentNumber) Then
		PaymentDocuments_ = New ValueTable;
		PaymentDocuments_.Columns.Add("DocumentDate");
		PaymentDocuments_.Columns.Add("DocumentNumber");
		LineOfBoardsPerDocument = PaymentDocuments_.Add();
		LineOfBoardsPerDocument.DocumentDate = IBData.DateOfDocumentInARAPAccounting;
		LineOfBoardsPerDocument.DocumentNumber = IBData.SettlementDocumentNumber;
		XDTOData.Insert("PaymentAndSettlementDocuments", PaymentDocuments_);
	EndIf;
EndProcedure


Procedure AddPCO_Document_InvoiceReceivedAdvance_Sending(ConversionRules)
	ConversionRule = DataExchangeXDTOServer.InitializeObjectConversionRule(ConversionRules);
	ConversionRule.OCRName            = "Document_InvoiceReceivedAdvancePayment_Sending";
	ConversionRule.DataObject      = Metadata.Documents.ReceivedTaxInvoicePrepayment;
	ConversionRule.FormatObject     = "Документ.СчетФактураПолученный"; //@NON-NLS-1
	ConversionRule.OnSendData = "OCR_Document_ReceivedTaxInvoicePrepayment_Send_OnSendData";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "",                "Currency", 1, "Catalog_Currencies");
	AddPCR(HeaderProperties, "",                "InvoiceType", 1);
	AddPCR(HeaderProperties, "Date",            "DateReceived");
	AddPCR(HeaderProperties, "DateCreated", "IncomingDocumentDate");
	AddPCR(HeaderProperties, "",                "Contract", 1, "Catalog_CounterpartyContracts");
	AddPCR(HeaderProperties, "",                "TINOfCounterparty", 1);
	AddPCR(HeaderProperties, "TransactionKindCode", "TransactionKindCode");
	AddPCR(HeaderProperties, "Comment",     "Comment");
	AddPCR(HeaderProperties, "",                "KitOfPrintedDocumentsIsSignedReceived", 1);
	AddPCR(HeaderProperties, "",                "Counterparty", 1, "Catalog_Counterparties");
	AddPCR(HeaderProperties, "",                "CounterpartyCRTR", 1);
	AddPCR(HeaderProperties, "Number",           "IncomingDocumentNumber");
	AddPCR(HeaderProperties, "Organization",     "Organization", , "Catalog_Companies_Send");
	AddPCR(HeaderProperties, "",                "BillingMethod", 1);
	AddPCR(HeaderProperties, "Sum",           "Sum");
	AddPCR(HeaderProperties, "VATAmount",        "VATAmount");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "Prepayments");
	AddPCR(PropertiesOfTS, "", "VATRate", 1);
	AddPCR(PropertiesOfTS, "", "Sum", 1);
	AddPCR(PropertiesOfTS, "", "VATAmount", 1);
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "BasisDocuments");
	AddPCR(PropertiesOfTS, "", "DocumentBasis", 1);
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "AdditionalAttributes");
	AddPCR(PropertiesOfTS, "", "PropertyValue", 1);
	AddPCR(PropertiesOfTS, "", "Property", 1, "Catalog_AdditionalAttributes");

EndProcedure
Procedure OCR_Document_ReceivedTaxInvoicePrepayment_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count()>1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_InvoiceReceivedAdvancePayment_Sending", 
										"Prepayments", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	UploadKitOfPrintedDocumentsSignedSign(ExchangeComponents, IBData, XDTOData);
	
	If IBData.DigitallyReceived Then
		XDTOData.Insert("BillingMethod", "InElectronicForm");
	Else
		XDTOData.Insert("BillingMethod", "OnPaperMedium");
	EndIf;
	
	If TypeOf(IBData.Counterparty) = Type("CatalogRef.Companies") Then
			
		CounterpartyOrganization = IBData.Counterparty;
		LinkToCounterparty = CounterpartyFromOrganization(CounterpartyOrganization, ExchangeComponents);
			
	ElsIf TypeOf(IBData.Counterparty) = Type("CatalogRef.Counterparties") Then
		LinkToCounterparty = IBData.Counterparty;
	Else
		LinkToCounterparty = Catalogs.Counterparties.EmptyRef();
	EndIf;
	
	XDTOData.KeyProperties.Insert("Counterparty", LinkToCounterparty);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.7") Then
		XDTOData.Insert("TINOfCounterparty", IBData.TINOfCounterparty);
		XDTOData.Insert("CounterpartyCRTR", IBData.CounterpartyCRTR);
	EndIf;
	
	XDTOData.Insert("InvoiceType", "AdvancePayment");
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	
	// Calculating the currency of the base document
	If ValueIsFilled(IBData.DocumentBasis)
		And Not TypeOf(IBData.DocumentBasis) = Type("DocumentRef.ARAPSettlement") Then
		
		CurrencyOfFoundingDocument = Common.ObjectAttributeValue(IBData.DocumentBasis, "Currency");
		
		If ValueIsFilled(CurrencyOfFoundingDocument) Then
			XDTOData.Insert("Currency", CurrencyOfFoundingDocument);
		Else
			XDTOData.Insert("Currency", CurrencyOfComplianceAccounting);
		EndIf;
		
	Else
		XDTOData.Insert("Currency", CurrencyOfComplianceAccounting);
	EndIf;
	
	// Getting information from the foundation document.
	Document__CurrencyOfSettlements = CurrencyOfComplianceAccounting;
	DocumentBasis_ContractLink = Undefined;
	Document__CalculationsInConventionalUnits = False;
	DocumentBase_NameOfICO = "";
	
	OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity");
	
	Query = New Query();
	Query.SetParameter("Ref", IBData.DocumentBasis);
	Query.SetParameter("Counterparty", LinkToCounterparty);
	TypeOfBaseDocumentValue = TypeOf(IBData.DocumentBasis);
	
	If TypeOfBaseDocumentValue = Type("DocumentRef.CashVoucher") 
		Or TypeOfBaseDocumentValue = Type("DocumentRef.BankAccountIssue") Then
		
		Query.Text = "
		|SELECT
		|	ARAPDetails.ARAPObject.Object AS OrderDocument,
		|	ARAPDetails.ARAPObject.OBJECT.Terms AS Terms,
		|	ARAPDetails.ARAPCurrency
		|INTO ContractData
		|FROM
		|	&DocumentTable AS ARAPDetails
		|WHERE
		|	ARAPDetails.Ref = &Ref
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.Terms
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.OrderDocument
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.ARAPCurrency
		|FROM
		|	ContractData AS ContractData";
		
		Query.Text = StrReplace(Query.Text, "&DocumentTable", "Document." + IBData.DocumentBasis.Metadata().Name + ".ARAPDetails");
		
		ContractData = Query.ExecuteBatch();
		
		ConvolutionByAgreement = ContractData[1].Unload();
		If ConvolutionByAgreement.Count() = 1 Then
			OrderDocument.Terms = ConvolutionByAgreement[0].Terms;
		EndIf;
			
		ConvolutionByOrders = ContractData[2].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			
			PurchaseOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(PurchaseOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = PurchaseOrder;
			ElsIf TypeOf(PurchaseOrder) = Type("DocumentRef.PurchaseOrder") Then
				OrderDocument.OrderDocument = PurchaseOrder;
			EndIf;
			
		EndIf;
		
		ConvolutionBySettlementCurrency = ContractData[3].Unload();
		If ConvolutionBySettlementCurrency.Count() = 1 Then
			Document__CurrencyOfSettlements = ConvolutionBySettlementCurrency[0].ARAPCurrency;
		EndIf;
		
		If TypeOfBaseDocumentValue = Type("DocumentRef.CashVoucher") Then
			DocumentBase_NameOfICO = "Document_RCOSettlementsWithCounterparties_Sending";
		Else
			DocumentBase_NameOfICO = "Document_SBDSSettlementsWithCounterparties_Sending";
		EndIf;
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.PurchaseAdjustment") Then
		DocumentBase_NameOfICO = "Document_IncomeAdjustment_Sending";	
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.ReturnOfGoodsToVendor") Then
		Query.Text = "
		|SELECT
		|	ARAPDetails.Ref.Terms AS Terms,
		|	ARAPDetails.Ref.Terms.Currency AS AgreementCurrency,
		|	ARAPDetails.ARAPObject.Object AS OrderDocument,
		|	ARAPDetails.ARAPCurrency
		|INTO ContractData
		|FROM
		|	Document.ReturnOfGoodsToVendor.ARAPDetails AS ARAPDetails
		|WHERE
		|	ARAPDetails.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	ContractData.Terms,
		|	ContractData.ARAPCurrency,
		|	ContractData.AgreementCurrency
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.OrderDocument
		|FROM
		|	ContractData AS ContractData";
		
		ContractData = Query.ExecuteBatch();
		
		MainAttributes = ContractData[1].Unload();
		If MainAttributes.Count() > 0 Then
			OrderDocument.Terms = MainAttributes[0].Terms;
			
			If ValueIsFilled(OrderDocument.Terms) Then
				Document__CurrencyOfSettlements = MainAttributes[0].AgreementCurrency;
			EndIf;
		EndIf;
		
		ConvolutionByOrders = ContractData[2].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			PurchaseOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(PurchaseOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = PurchaseOrder;
			ElsIf TypeOf(PurchaseOrder) = Type("DocumentRef.PurchaseOrder") Then
				OrderDocument.OrderDocument = PurchaseOrder;
			EndIf;
		EndIf;
		DocumentBase_NameOfICO = "Document_ReturnOfGoodsToSupplier_Sending";
	
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.ExpenseReport") Then	
	
		Query.Text = "
		|SELECT
		|	PaymentToVendors.ARAPCurrency,
		|	PaymentToVendors.ARAPObject.Object.Terms AS Terms,
		|	PaymentToVendors.ARAPObject.Object AS OrderDocument
		|INTO ContractData
		|FROM
		|	Document.ExpenseReport.PaymentToVendors AS PaymentToVendors
		|WHERE
		|	PaymentToVendors.Ref = &Ref
		|	AND PaymentToVendors.Counterparty = &Counterparty
		|;
		|
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.Terms
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.OrderDocument
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.ARAPCurrency
		|FROM
		|	ContractData AS ContractData";
	
		ContractData = Query.ExecuteBatch();
		
		ConvolutionByAgreement = ContractData[1].Unload();
		If ConvolutionByAgreement.Count() = 1 Then
			OrderDocument.Terms = ConvolutionByAgreement[0].Terms;
		EndIf;
		
		ConvolutionByOrders = ContractData[2].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			
			PurchaseOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(PurchaseOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = PurchaseOrder;
			ElsIf TypeOf(PurchaseOrder) = Type("DocumentRef.PurchaseOrder") Then
				OrderDocument.OrderDocument = PurchaseOrder;
			EndIf;
			
		EndIf;
		
		ConvolutionBySettlementCurrency = ContractData[3].Unload();
		If ConvolutionBySettlementCurrency.Count() = 1 Then
			Document__CurrencyOfSettlements = ConvolutionBySettlementCurrency[0].ARAPCurrency;
		EndIf;
		DocumentBase_NameOfICO = "Document_AdvanceReport_Dispatch";
	
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.ARAPSettlement") Then
		
		TSName = "AccountsPayable";
		PaymentType_ = Enums.PartnersARAPAccountingTypes.VendorARAPAccounting;
		
		If IBData.Organization = Common.ObjectAttributeValue(IBData.DocumentBasis, "Creditor") Then
			TSName = "AccountsReceivable";
			PaymentType_ = Enums.PartnersARAPAccountingTypes.CustomerARAPAccounting;
		EndIf;
		
		Query.Text = "
		|SELECT
		|	TabDoc.ARAPObject.Object AS OrderDocument,
		|	TabDoc.ARAPCurrency,
		|	TabDoc.ARAPObject.OBJECT.Terms AS Terms
		|INTO ContractData
		|FROM
		|	&DocumentTable AS TabDoc
		|WHERE
		|	TabDoc.Ref = &Ref
		|	AND TabDoc.PaymentType_ = &PaymentType_
		|;
		|
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.Terms
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.OrderDocument
		|FROM
		|	ContractData AS ContractData
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ContractData.ARAPCurrency
		|FROM
		|	ContractData AS ContractData";
		
		Query.Text = StrReplace(Query.Text, "&DocumentTable", "Document.ARAPSettlement." + TSName);	
		Query.SetParameter("PaymentType_", PaymentType_);
		
		ContractData = Query.ExecuteBatch();
		
		ConvolutionByAgreement = ContractData[1].Unload();
		If ConvolutionByAgreement.Count() = 1 Then
			OrderDocument.Terms = ConvolutionByAgreement[0].Terms;
		EndIf;  
			
		ConvolutionByOrders = ContractData[2].Unload();
		If ConvolutionByOrders.Count() = 1 Then
			
			PurchaseOrder = ConvolutionByOrders[0].OrderDocument;
			If TypeOf(PurchaseOrder) = Type("CatalogRef.CounterpartyContracts") Then
				DocumentBasis_ContractLink = PurchaseOrder;
			ElsIf TypeOf(PurchaseOrder) = Type("DocumentRef.PurchaseOrder") Then
				OrderDocument.OrderDocument = PurchaseOrder;
			EndIf;
			
		EndIf;
		
		ConvolutionBySettlementCurrency = ContractData[3].Unload();
		If ConvolutionBySettlementCurrency.Count() = 1 Then
			Document__CurrencyOfSettlements = ConvolutionBySettlementCurrency[0].ARAPCurrency;
		EndIf;
		DocumentBase_NameOfICO = "Document_VZ_OurOrganization";
	ElsIf TypeOfBaseDocumentValue = Type("DocumentRef.IntercompanyGoodsReturn") Then
		
		Query.Text = "
		|SELECT
		|	Doc.Currency
		|FROM
		|	Document.IntercompanyGoodsReturn AS Doc
		|WHERE
		|	Doc.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	ARAPDetails.ARAPCurrency
		|FROM
		|	Document.IntercompanyGoodsReturn.ARAPDetails AS ARAPDetails
		|WHERE
		|	ARAPDetails.Ref = &Ref
		|
		|ORDER BY
		|	ARAPDetails.LineNumber";
		
		QueryResult = Query.ExecuteBatch();	
		HeaderData_              = QueryResult[0].Unload()[0];
		PaymentDecryptionData = QueryResult[1].Unload();
		
		If PaymentDecryptionData.Count() = 1 Then
			Document__CurrencyOfSettlements = PaymentDecryptionData[0].ARAPCurrency;
			Document__CalculationsInConventionalUnits = HeaderData_.Currency = CurrencyOfComplianceAccounting
				And HeaderData_.Currency <> XDTOData.Currency;
		EndIf;
		DocumentBase_NameOfICO = "RefundBetweenOrganizations_ToSupplier_Sending";
	EndIf;	
	If ValueIsFilled(DocumentBasis_ContractLink) Then
		XDTOData.Insert("Contract", DocumentBasis_ContractLink);
	Else
		If Not ValueIsFilled(Document__CurrencyOfSettlements) Then
			Document__CurrencyOfSettlements = XDTOData.Currency;
		EndIf;
		If Not ValueIsFilled(Document__CalculationsInConventionalUnits) Then
			If ValueIsFilled(OrderDocument.Terms) Then
				UECalculationData = Common.ObjectAttributesValues(OrderDocument.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
				Document__CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
	
			Else
				Document__CalculationsInConventionalUnits = XDTOData.Currency = CurrencyOfComplianceAccounting
					And XDTOData.Currency <> Document__CurrencyOfSettlements;
			EndIf;
		EndIf;
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty = LinkToCounterparty;
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.ARAPCurrency = Document__CurrencyOfSettlements;
		DefaultParameters.TypeOfAgreement = "WithVendor";
		DefaultParameters.Date = IBData.Date;
		DefaultParameters.Number = IBData.Number;
		DefaultParameters.CalculationsInConventionalUnits = Document__CalculationsInConventionalUnits;
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
	EndIf;
	
	BasisDocuments = New ValueTable();
	BasisDocuments.Columns.Add("DocumentBasis");
	StringBase = BasisDocuments.Add();	
	StringBase.DocumentBasis = New Structure("Value, OCRName",
		IBData.DocumentBasis, DocumentBase_NameOfICO);
	XDTOData.Insert("BasisDocuments", BasisDocuments);
	
	Query = New Query;
	Query.Text = "SELECT
	|	Sum,
	|	VATRate AS VATRate,
	|	VATAmount
	|FROM Document.ReceivedTaxInvoicePrepayment.Prepayments
	|WHERE Ref = &Ref";
	
	Query.SetParameter("Ref", IBData.Ref);
	Result = Query.Execute();
	If Not Result.IsEmpty() Then  
		Prepayments = Result.Unload();
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
			RedefineVATRateForOldFormats(Prepayments, False);
		EndIf;
		XDTOData.Insert("Prepayments", Prepayments);
	EndIf;
EndProcedure


