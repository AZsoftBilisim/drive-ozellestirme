Procedure DeferredProcessing_CreateUpdateCalculationObjects(ExchangeComponents)
	For Each ImportedObject In ExchangeComponents.ImportedObjects Do
		
		// There is no need to create a settlement object for loan agreements and gift certificates
		If TypeOf(ImportedObject.ObjectReference) = Type("CatalogRef.LoanAndDepositContracts") 
			Or TypeOf(ImportedObject.ObjectReference) = Type("CatalogRef.GiftCertificates") Then 
			
			Continue;
		EndIf;
		
		If Metadata.DefinedTypes.ARAPObject.Type.ContainsType(TypeOf(ImportedObject.ObjectReference)) Then
					 			
			Object = ImportedObject.ObjectReference.GetObject();
			Object.DataExchange.Load = True;
			
			ObjectMetadata = ImportedObject.ObjectReference.Metadata();
			CreateARAPObject = False;
			
			If ObjectMetadata = Metadata.Documents.SourceDocument Then
				// We skip primary documents with an empty type
				CreateARAPObject = ValueIsFilled(Object.SourceDocumentType);
			Else
				ObjectManager = Common.ObjectManagerByRef(Object.Ref);
				If TypeOf(Object) = Type("CatalogObject.CounterpartyContracts") 
					Or (CommonClientServer.HasAttributeOrObjectProperty(Object, "Contract") And Object.Contract <> Undefined) Then
					MechanismParameters = ObjectManager.SettlementParameters_(Object);
				Else Return
				EndIf;
				
				AugmentedMechanismParameters = ARAPAccountingServer.AugmentedMechanismParameters(Object, MechanismParameters);
				
				For Each ParametersStructure In AugmentedMechanismParameters.ParametersArray Do
					
					If Not CreateARAPObject Then
						
						If ARAPObjectsServer.ReferenceIsObjectOfCalculations(Object, ParametersStructure) Then
							CreateARAPObject = True;
						ElsIf ValueIsFilled(ParametersStructure.PathToTSDataPaymentDecryption) Then
							ARAPDetails = TMCommonUseClientServer.DataAlongWay(Object, ParametersStructure.PathToTSDataPaymentDecryption);
							Query = New Query;
							Query.Text = "
							|SELECT
							|	Details.ARAPObject
							|INTO Details
							|FROM &Details AS Details
							|;
							|SELECT TOP 1
							|	TRUE
							|FROM
							|	Details
							|WHERE
							|	Details.ARAPObject.OBJECT = &Ref";
							Query.SetParameter("Details", ARAPDetails);
							Query.SetParameter("Ref", ImportedObject.ObjectReference);
							Selection = Query.Execute().Select();
							CreateARAPObject = Selection.Next();
							
							For Each DecryptionString In ARAPDetails Do
								If Not ValueIsFilled(DecryptionString.ARAPObject) Then
									CreateARAPObject = True;
								EndIf;
							EndDo;
						EndIf;
					EndIf;
				EndDo;
			EndIf;
			
			If Not CreateARAPObject Then 
				Continue;
			EndIf;
			
			// In the procedure of the calculation object Server.Check the objects of the calculations by recording() possible blocking, we perform in the transaction
			BeginTransaction();
			Try
			
				If Common.IsDocument(ObjectMetadata) And
					ObjectMetadata.Posting = Metadata.ObjectProperties.Posting.Allow Then 
					
					// Create a settlement object for the contract if necessary
					If Common.HasObjectAttribute("Contract", ObjectMetadata) And ValueIsFilled(Object.Contract)
						And Common.ObjectAttributeValue(Object.Contract, "ARAPObjectSettings") =  Enums.ARAPObjectSettings.ByCounterpartyContracts Then
						
						Contract = Object.Contract.GetObject();
						If Not ValueIsFilled(Contract.Partner) Then
							FillingInPartnerInDocumentHeader(Contract);
							Contract.DataExchange.Load = True;
							Contract.Write();
						EndIf;
						ARAPAccountingServer.BeforeWrite(Contract, False);
						
					EndIf;
									
					If ObjectMetadata = Metadata.Documents.SourceDocument Then					
						Documents.SourceDocument.UpdateCalculationObject(Object, False);
					ElsIf Common.IsReference(TypeOf(Object)) 
						And CommonClientServer.HasAttributeOrObjectProperty(Object, "Contract")
						And Not Common.RefExists(Object.Contract)  Then
						Continue
					ElsIf (CommonClientServer.HasAttributeOrObjectProperty(Object, "BusinessOperation") 
						And Not Object.BusinessOperation = Enums.BusinessTransactions.OtherCashIssue)
						Or Not CommonClientServer.HasAttributeOrObjectProperty(Object, "BusinessOperation") Then
						ARAPAccountingServer.BeforeWrite(Object, False, DocumentWriteMode.Posting);
					EndIf;
					
				Else
					ARAPAccountingServer.BeforeWrite(Object, False);
				EndIf;
				
				CommitTransaction();
				
			Except
				
				RollbackTransaction();
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(NStr("vi = 'Đối với đối tượng %1 không thể tạo mới đối tượng hạch toán';
																							|ru = 'Для объекта %1 не удалось создать объект расчета';
																							|en = 'Cannot create AR/AP object for the %1 object'; fa = 'Cannot create AR/AP object for the %1 object';
																							|it = 'Non è stato possibile creare l''oggetto di calcolo per l''oggetto %1';
																							|pl = 'Dla obiektu %1 nie udało się utworzyć obiektu rozliczeń';
																							|tr = '%1 nesnesi için alacak/borç nesnesi oluşturulamadı'"), ImportedObject.ObjectReference);
				DataExchangeXDTOServer.WriteEventLogDataExchange1(ErrorText, ExchangeComponents, , ImportedObject.ObjectReference);
				ExchangeComponents.ErrorFlag = True;
				ExchangeComponents.DataExchangeState.ExchangeExecutionResult = Enums.ExchangeExecutionResults.Error;
				
				Raise;
				
			EndTry;
		EndIf;
	EndDo;
EndProcedure
Procedure DeferredProcessing_GradeDocDeferredProv(ExchangeComponents)
	// In some cases, documents with a single date must be carried out in a certain order.
		
	// Let's add the column "Examination queue" to the table "Document for the proposed examination".
	// The smaller the queue value, the earlier the document will be held within the documents of the same date.
	// By default, the queue has a zero (0) value.
	DocumentsForDeferredPosting = ExchangeComponents.DocumentsForDeferredPosting; // ValueTable
	DocumentsForDeferredPosting.Columns.Add("HoldingQueue", New TypeDescription("Number"));
	
	InvoiceTypes = New Array;
	InvoiceTypes.Add(Type("DocumentRef.IssuedTaxInvoicePrepayment"));
	InvoiceTypes.Add(Type("DocumentRef.ReceivedTaxInvoicePrepayment"));
	
	For Each TableRow In DocumentsForDeferredPosting Do
		
		If TableRow.DocumentRef.IsEmpty() Then
			Continue;
		EndIf;	
	
		If Not InvoiceTypes.Find(TypeOf(TableRow.DocumentRef)) = Undefined Then
			TableRow.HoldingQueue = 2;
		EndIf;
			
	EndDo;
	
	DocumentsForDeferredPosting.Sort("DocumentDate, HoldingQueue");
EndProcedure


Procedure DeferredProcessing_DebtWriteOff(Object, ExchangeComponents)
	IncomeExpensesAssetsLiabilities = Object.IncomeExpensesAssetsLiabilities[0];
	
	If Object.BusinessOperation = Enums.BusinessTransactions.ARWriteOff
		And Not ValueIsFilled(IncomeExpensesAssetsLiabilities.AssetRef) Then
		IncomeExpensesAssetsLiabilities.AssetRef = DefaultElement(ExchangeComponents, "ExpenseItemDebtCancellation");
	ElsIf Object.BusinessOperation = Enums.BusinessTransactions.APWriteOff
		And Not ValueIsFilled(IncomeExpensesAssetsLiabilities.AssetRef) Then
		IncomeExpensesAssetsLiabilities.AssetRef = DefaultElement(ExchangeComponents, "IncomeItemCancellationOfDebt");
	EndIf;
	
	Partner = CashServer.GetCounterpartyPartner(Object.Counterparty);	
	If Not ValueIsFilled(Partner) Then
		Partner = Catalogs.Partners.UnknownPartner;
	EndIf;
	
	For Each TSRow In Object.Debt_ Do
		If Not ValueIsFilled(TSRow.Partner)
			Or Not TSRow.Partner = Partner Then
			TSRow.Partner = Partner;
		EndIf;
	EndDo;
	
	PrimaryDocuments = ExchangeComponents.ConversionParameters_SSLy.PrimaryDocuments; // ValueTable
	
	For Each Details In Object.AdditionalProperties.Debt_ Do
		DocumentOfARAPAccounting   = Details.DocumentOfARAPAccounting;
		If ValueIsFilled(DocumentOfARAPAccounting) And TypeOf(DocumentOfARAPAccounting) = Type("DocumentRef.SourceDocument") Then
			RowPrimaryDocuments = PrimaryDocuments.Add();
			RowPrimaryDocuments.SourceDocument = DocumentOfARAPAccounting;
			If Object.BusinessOperation = Enums.BusinessTransactions.ARWriteOff Then
			    RowPrimaryDocuments.SourceDocumentType = Enums.SourceDocumentTypes.SaleToCustomer;
			Else
				RowPrimaryDocuments.SourceDocumentType = Enums.SourceDocumentTypes.PurchaseFromVendor;
			EndIf;
		EndIf;
	EndDo;
	
	Object.CorrespondenceWithIncome = Object.BusinessOperation = Enums.BusinessTransactions.APWriteOff;
	
	FillInCalculationObject = ExchangeComponents.ConversionParameters_SSLy.FillInCalculationObject; // Array
	FillInCalculationObject.Add(Object);
EndProcedure


