	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	// Goods 
	ArrayOfRows = New Array;
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
		
		If XDTOData.Goods.Columns.Find("PurchaseForActivity") <> Undefined Then
			PurchaseForActivity = XDTOData.Goods[0].PurchaseForActivity;
			If ValueIsFilled(PurchaseForActivity) Then
				ReceivedData.AdditionalProperties.Insert("PurchaseForActivity", PurchaseForActivity);
			EndIf;
		EndIf;
		
		For Each String In XDTOData.Goods Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			
			If ValueIsFilled(String.CCDNumber) Then
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
					StringDataStructure.Insert("CCDNumber", String.CCDNumber);
				Else
					StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
				EndIf;
			EndIf;
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			If StringDataStructure.Property("NumberOfPackages") Then
			    If StringDataStructure.Property("Package") And StringDataStructure.Property("Sum") Then
					StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
				EndIf;
			Else
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
			If XDTOData.Property("Warehouse") Then
				StringDataStructure.Insert("Warehouse", XDTOData.Warehouse);
			EndIf;
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
	
			ArrayOfRows.Add(StringDataStructure);
			
		EndDo;
	EndIf;
	
	// Transcript of the addendum .expenses - we minimize the document and the amount.
	AmountsOfAdditionalExpenses = New ValueTable;
	AmountsOfAdditionalExpenses.Columns.Add("DocumentInflow");
	AmountsOfAdditionalExpenses.Columns.Add("Sum");
	DocumentInflow = Undefined;
	If XDTOData.Property("TranscriptOfAdditionalExpenses")
		And ValueIsFilled(XDTOData.TranscriptOfAdditionalExpenses) Then
		For Each String In XDTOData.TranscriptOfAdditionalExpenses Do
			If Find(String.DocumentInflow.ValueType, "Авансовый")>0 Then // @Non-NLS-1
				OCRName = "Document_AdvanceReport_Receipt";
			ElsIf Find(String.DocumentInflow.ValueType, "ПоступлениеТоваров")>0 Then // @Non-NLS-1
				OCRName = "Document_ReceiptOfGoodsServices_Receipt";
			Else
				Continue;
			EndIf;
			LineAddExpense = AmountsOfAdditionalExpenses.Add();
			LineAddExpense.DocumentInflow = DataExchangeXDTOServer.XDTOObjectStructureToIBData(ExchangeComponents, 
							String.DocumentInflow, 
							DataExchangeXDTOServer.OCRByName(ExchangeComponents, OCRName), "GetRef");
			LineAddExpense.Sum = String.Sum;
		EndDo;
		If XDTOData.TranscriptOfAdditionalExpenses.Count() > 1 Then
			AmountsOfAdditionalExpenses.GroupBy("DocumentInflow", "Sum");
		EndIf;
		If AmountsOfAdditionalExpenses.Count() = 1 Then
			// Only one receipt document for which expenses are allocated.
			DocumentInflow = AmountsOfAdditionalExpenses[0].DocumentInflow;
		EndIf;
	EndIf; 
	
	// Services are loaded into PM Goods with a different type of inventory.
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
			
		FillingRules.Insert("CostDivision", "Department");
		FillingRules.Insert("CostItem", "ExpenseItem");
		
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
			
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			If XDTOData.Property("Warehouse") Then
				StringDataStructure.Insert("Warehouse", XDTOData.Warehouse);
			EndIf;
			
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
	
			If String.ThisIsAdditionalExpense = True And AmountsOfAdditionalExpenses.Count() > 0 Then
				If DocumentInflow <> Undefined Then
					StringDataStructure.Insert("DimensionOfExpenses", DocumentInflow);
					ArrayOfRows.Add(StringDataStructure);
				Else
					// Distribution of the service into several receipt documents
					AmountTotal = StringDataStructure.Sum;
					SumWithVATTotal = StringDataStructure.AmountIncludingVAT;
					TotalDocuments_ = AmountsOfAdditionalExpenses.Total("Sum");
					For Each LineAddExpense In AmountsOfAdditionalExpenses Do
						DataStructureOfAdditionalExpenseLine = New Structure();
						For Each RowData In StringDataStructure Do
							DataStructureOfAdditionalExpenseLine.Insert(RowData.Key, RowData.Value);
						EndDo;
						ConversionFactor_ = LineAddExpense.Sum / TotalDocuments_;
						DataStructureOfAdditionalExpenseLine.Sum = Round(AmountTotal * ConversionFactor_, 2);
						DataStructureOfAdditionalExpenseLine.AmountIncludingVAT = Round(SumWithVATTotal * ConversionFactor_, 2);
						If DataStructureOfAdditionalExpenseLine.AmountIncludingVAT = 0 Or DataStructureOfAdditionalExpenseLine.Sum = 0 Then
							Continue;
						EndIf;
						DataStructureOfAdditionalExpenseLine.Insert("Price", Round(DataStructureOfAdditionalExpenseLine.Price * ConversionFactor_, 2));
						DataStructureOfAdditionalExpenseLine.Insert("VATAmount", DataStructureOfAdditionalExpenseLine.AmountIncludingVAT - DataStructureOfAdditionalExpenseLine.Sum);
						DataStructureOfAdditionalExpenseLine.Insert("DimensionOfExpenses", LineAddExpense.DocumentInflow);
						ArrayOfRows.Add(DataStructureOfAdditionalExpenseLine);
					EndDo;
				EndIf;
			Else
				ArrayOfRows.Add(StringDataStructure);
			EndIf;
		EndDo;
	EndIf;
	
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	// Barcodes of packages.
	UploadPackageBarcodes(XDTOData, ReceivedData, ExchangeComponents);
EndProcedure
