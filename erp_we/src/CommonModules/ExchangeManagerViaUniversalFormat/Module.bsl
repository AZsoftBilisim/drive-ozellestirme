Procedure OCR_Document_ProformaInvoice_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	ARAPCurrency = IBData.Currency;
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		
		ContractProperties = Common.ObjectAttributesValues(
			IBData.Contract, "ForeignCurrencyTransaction, ARAPCurrency, Organization");
		
		XDTOData.Insert("Contract",                  IBData.Contract);
		XDTOData.Insert("CalculationsInConventionalUnits", VueCalculationIsUnderway(ContractProperties.ARAPCurrency, ContractProperties.ForeignCurrencyTransaction, ContractProperties.Organization, ExchangeComponents));
		
		ARAPCurrency = ContractProperties.ARAPCurrency;
		
	Else
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty               = IBData.Counterparty;
		DefaultParameters.Organization              = IBData.Organization;
		DefaultParameters.ARAPCurrency     = ARAPCurrency;
		DefaultParameters.Date                     = IBData.Date;
		DefaultParameters.Number                    = IBData.Number;
	 	DefaultParameters.CalculationsInConventionalUnits = False;
		DefaultParameters.TypeOfAgreement
			= TypeOfCounterpartyAgreement(IBData.Ref, Undefined, Enums.BusinessTransactions.CashReceiptFromCustomer);
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", IBData.Ref, Undefined, Undefined);
		
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, IBData.DocumentBasis, IBData);
		XDTOData.Insert("Contract", Contract);
		XDTOData.Insert("CalculationsInConventionalUnits", False);
		
	EndIf;    
	              
	#Region PaymentSteps              
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.19") Then
	
		Query = New Query;
	
		Query.Text = 
		"SELECT
		|	""Prepayment"" AS PaymentOption,
		|	CustomerCommercialInvoicePaymentScheduleSteps.PaymentDate AS PaymentDate,
		|	CustomerCommercialInvoicePaymentScheduleSteps.PaymentPercentage AS PaymentPercentage,
		|	CustomerCommercialInvoicePaymentScheduleSteps.PaymentAmount AS PaymentAmount,
		|	&PaymentMethod AS PaymentMethod,
		|	CustomerCommercialInvoicePaymentScheduleSteps.LineNumber AS DocumentRowNumber
		|FROM
		|	Document.CustomerCommercialInvoice.PaymentScheduleSteps AS CustomerCommercialInvoicePaymentScheduleSteps
		|WHERE
		|	CustomerCommercialInvoicePaymentScheduleSteps.Ref = &Ref
		|
		|ORDER BY
		|	PaymentDate
		|	
		|";
	    
	    Query.SetParameter("Ref", IBData.Ref);
	    Query.SetParameter("PaymentMethod", ?(ValueIsFilled(IBData.PaymentMethod),
			IBData.PaymentMethod, Enums.PaymentForms.BankAccountPayment));    
	    
		PaymentStagesTable = Query.Execute().Unload();
		
		If PaymentStagesTable.Count() > 0 Then
			For Each Page1 In PaymentStagesTable Do
				If Page1.PaymentMethod = Enums.PaymentForms.InstantPayments Then
					Page1.PaymentMethod = Enums.PaymentForms.BankAccountPayment;
				EndIf;
			EndDo;
			XDTOData.Insert("PaymentSteps", PaymentStagesTable);
		EndIf;	
	   	EndIf;
	#EndRegion
EndProcedure


