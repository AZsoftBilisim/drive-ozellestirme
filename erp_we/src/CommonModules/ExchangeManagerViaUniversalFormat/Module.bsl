Procedure OCR_Document_VocationalSchoolThroughAccountablePerson_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_PTUThroughAccountablePerson_Receipt", 
										"Goods", 
										"CCDNumber",
										False,
										"Catalog_CCDNumbers_ItemReceive");
	EndIf;
	
	ReceivedData.Posted               = True;
	ReceivedData.Approved             = True;
	ReceivedData.BusinessOperation  = Enums.BusinessTransactions.PurchaseViaAdvanceHolder;
	ReceivedData.DeliveryMethod 		= Enums.TransportMethods.ByVendorToOurWarehouse;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	ReceivedData.AdditionalProperties.Insert("AmountIncludesVAT", XDTOData.AmountIncludesVAT);
	
	If XDTOData.Property("ExpenseReport") Then
		ReceivedData.AdditionalProperties.Insert("ExpenseReport", XDTOData.ExpenseReport);
	EndIf;
	
	FillingRules = New Map;
	FillingRules.Insert("Products",        "Products");
	FillingRules.Insert("Count",          "Count");
	FillingRules.Insert("Sum",               "Sum");
	FillingRules.Insert("Price",                "Price");
	FillingRules.Insert("VATRate",           "VATRate");
	FillingRules.Insert("VATAmount",            "VATAmount");
	FillingRules.Insert("RowID", "RowID");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
	    FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
	EndIf;
	
	//Goods 
	DocumentAmount = 0;
	ArrayOfRows = New Array;
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
		
		If XDTOData.Goods.Columns.Find("PurchaseForActivity") <> Undefined Then
			ReceivedData.AdditionalProperties.Insert("PurchaseForActivity",
				XDTOData.Goods[0].PurchaseForActivity);
		EndIf;
		
		For Each String In XDTOData.Goods Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
			    StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			If ValueIsFilled(String.CCDNumber) Then
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
			        StringDataStructure.Insert("CCDNumber", String.CCDNumber);
			    Else
			        StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
			    EndIf;
			EndIf;
			If XDTOData.Property("Warehouse") Then
				StringDataStructure.Insert("Warehouse", XDTOData.Warehouse);
			EndIf;
			
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
			DocumentAmount = DocumentAmount + AmountIncludingVAT;
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				
			If StringDataStructure.Property("NumberOfPackages") Then
			    If StringDataStructure.Property("Package") Then
					StringDataStructure.Insert("Price", StringDataStructure.Sum / StringDataStructure.NumberOfPackages);
				EndIf;
			Else
				StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
			EndIf;
	
			If ValueIsFilled(String.Vendor) And Not ReceivedData.AdditionalProperties.Property("Counterparty") Then
				ReceivedData.AdditionalProperties.Insert("Counterparty", String.Vendor);
			EndIf;
			If ValueIsFilled(String.IncomingDocumentNumber) And Not ValueIsFilled(ReceivedData.IncomingDocumentNumber) Then
				ReceivedData.IncomingDocumentNumber = String.IncomingDocumentNumber;
			EndIf;
			If ValueIsFilled(String.IncomingDocumentDate) And Not ValueIsFilled(ReceivedData.IncomingDocumentDate) Then
				ReceivedData.IncomingDocumentDate = String.IncomingDocumentDate;
			EndIf;
			If ValueIsFilled(String.ExternalDocumentName) And Not ValueIsFilled(ReceivedData.ExternalDocumentName) Then
				ReceivedData.ExternalDocumentName = String.ExternalDocumentName;
			EndIf;
			If ValueIsFilled(String.InvIsSubmitted) 
				And ValueIsFilled(String.InvoiceDate)
				And ValueIsFilled (String.InvoiceNumber) 
				And Not ReceivedData.AdditionalProperties.Property("InvoiceDate") Then
				ReceivedData.AdditionalProperties.Insert("InvoiceDate", String.InvoiceDate);
				ReceivedData.AdditionalProperties.Insert("InvoiceNumber", String.InvoiceNumber);
			EndIf;
	
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	ReceivedData.DocumentAmount = DocumentAmount;
	ReceivedData.AmountARAP = DocumentAmount;
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	// Barcodes of packages.
	UploadPackageBarcodes(XDTOData, ReceivedData, ExchangeComponents);
EndProcedure
