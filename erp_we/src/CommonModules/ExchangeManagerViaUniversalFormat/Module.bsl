		|	CASE
		|		WHEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count < 0.01
		|			THEN 0.01
		|		ELSE CAST(InventoryKinds.AmountIncludingVAT / InventoryKinds.Count AS NUMBER(31, 2))
		|	END AS Price,
		|	InventoryKinds.AmountIncludingVAT AS Sum,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	1 AS RowKey,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
