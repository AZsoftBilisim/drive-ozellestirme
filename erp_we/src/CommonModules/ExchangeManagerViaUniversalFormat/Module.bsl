Procedure OCR_Catalog_Users_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If TypeOf(IBData) = Type("CatalogRef.Users") Then
		If ExportStack.Count() > 1 Then
			XDTOData.Insert("Individual", New Structure("Value, OCRName", IBData.Individual,"Catalog_Persons_Send"));
			Return;
		EndIf;
		XDTOData.KeyProperties.Insert("Individual", New Structure("Value, OCRName", IBData.Individual,"Catalog_Persons_Send"));
	ElsIf TypeOf(IBData) = Type("CatalogRef.Persons") Then
		XDTOData.Insert("Individual", New Structure("Value, OCRName", IBData.Ref,"Catalog_Persons_Send"));
	EndIf;
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData, True);
