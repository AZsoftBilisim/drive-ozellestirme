Procedure DPR_Document_CashAccountReceiptNote_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	
	Query = New Query;
	Query.Text = "SELECT
		|	ISNULL(Header.CashFlowItem.OffsettingAccount, """") AS OffsettingAccount,
		|	Header.BankAccount.CashCurrency AS BankAccountCurrency,
		|	Header.Currency AS Currency,
		|	Header.CurrencyOfConversion
		|INTO Header
		|FROM
		|	Document.CashAccountReceiptNote AS Header
		|WHERE
		|	Header.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	DocumentData.IncomeItem.OffsettingAccount AS OffsettingAccount,
		|	DocumentData.IncomeItem AS IncomeItem
		|INTO LineWithIncomeItemWithCorAccount
		|FROM
		|	Document.CashAccountReceiptNote.ARAPDetails AS DocumentData
		|WHERE
		|	DocumentData.Ref = &Ref
		|	AND (DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherIncome)
		|			OR DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherCashReceipt))
		|	AND DocumentData.IncomeItem.OffsettingAccount IS NOT NULL 
		|	AND DocumentData.IncomeItem.OffsettingAccount <> """"
		|
		|ORDER BY
		|	DocumentData.LineNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	FirstLineOfDecryption.LoanDepositContract.CashFlowItemOfFeePayment AS FirstRowRP_LoanAgreementDeposit_SDDSCommission,
		|	FirstLineOfDecryption.LoanDepositContract.CashFlowItemOfInterestPayment AS FirstRowRP_DepositLoanAgreement_SDDSInterest,
		|	FirstLineOfDecryption.CashFlowItem AS FirstRowOfRP_SDDS
		|INTO FirstLineOfDecryption
		|FROM
		|	Document.CashAccountReceiptNote.ARAPDetails AS FirstLineOfDecryption
		|WHERE
		|	FirstLineOfDecryption.Ref = &Ref
		|
		|ORDER BY
		|	FirstLineOfDecryption.LineNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ISNULL(LineWithIncomeItemWithCorAccount.OffsettingAccount, Header.OffsettingAccount) AS OffsettingAccount,
		|	ISNULL(LineWithIncomeItemWithCorAccount.IncomeItem, UNDEFINED) AS IncomeItem,
		|	Header.BankAccountCurrency,
		|	ISNULL(FirstLineOfDecryption.FirstRowRP_LoanAgreementDeposit_SDDSCommission, UNDEFINED) AS FirstRowRP_LoanAgreementDeposit_SDDSCommission,
		|	ISNULL(FirstLineOfDecryption.FirstRowRP_DepositLoanAgreement_SDDSInterest, UNDEFINED) AS FirstRowRP_DepositLoanAgreement_SDDSInterest,
		|	ISNULL(FirstLineOfDecryption.FirstRowOfRP_SDDS, UNDEFINED) AS FirstRowOfRP_SDDS,
		|	ISNULL(ExchangeRates.CourseNumerator, 1) AS Currency_ExchangeRate,
		|	ISNULL(ExchangeRates.CourseDenominator, 1) AS Currency_Multiplicity
		|FROM
		|	Header AS Header
		|		LEFT JOIN LineWithIncomeItemWithCorAccount AS LineWithIncomeItemWithCorAccount
		|		ON (TRUE)
		|		LEFT JOIN FirstLineOfDecryption AS FirstLineOfDecryption
		|		ON (TRUE)
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &ComplAccountingCurrency) AS ExchangeRates
		|		ON Header.Currency = ExchangeRates.Currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ARAPDetails.CashFlowItem AS CFItem,
		|	ARAPDetails.Sum AS Sum,
		|	ARAPDetails.VATAmount AS VATAmount,
		|	ARAPDetails.VATRate AS VATRate,
		|	ARAPDetails.AmountARAP AS AmountARAP,
		|	ARAPDetails.LoanDepositContract AS LoanDepositContract,
		|	ARAPDetails.ARAPObject.Object AS OrderDocument,
		|	ARAPDetails.PaymentPurpose AS PaymentPurpose,
		|	ARAPDetails.Partner AS Partner,
		|	CAST(ARAPDetails.ARAPObject.Object AS Catalog.CounterpartyContracts) AS Contract,
		|	ARAPDetails.LeaseContracts AS LeaseContracts,
		|	ISNULL(ExchangeRates.CourseNumerator, 1) AS TransactionRate,
		|	ISNULL(ExchangeRates.CourseDenominator, 1) AS Multiplier_,
		|	ARAPDetails.ARAPCurrency AS ARAPCurrency,
		|	CASE
		|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|			THEN CASE
		|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
		|						THEN ""ShortTermLoans_""
		|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|						THEN ""LongTermLoans_""
		|				END
		|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
		|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
		|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit)
		|			THEN CASE
		|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
		|						THEN CASE
		|								WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
		|									THEN ""ShortTermLoans""
		|							END
		|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|						THEN CASE
		|								WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
		|									THEN ""LongTermLoans""
		|							END
		|				END
		|		ELSE NULL
		|	END AS TypeOfCalculationsAdvanced,
		//++ NOT TM
		
	 
		//-- DON'T TM 
		|	CASE
		|		WHEN &ThisIsWE OR (&CorAccountsFromArticlesAreUsed AND ARAPDetails.CashFlowItem.OffsettingAccount <> """")
		|			THEN ARAPDetails.CashFlowItem.OffsettingAccount
		|		ELSE CASE
		|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
		|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan))
		|						AND (ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
		|							OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment)
		|					THEN ""58.03""
		|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
		|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
		|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit))
		|						AND ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
		|					THEN CASE
		|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
		|								THEN CASE
		|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
		|											THEN ""66.03""
		|										ELSE ""66.23""
		|									END
		|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|								THEN CASE
		|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
		|											THEN ""67.03""
		|										ELSE ""67.23""
		|									END
		|						END
		|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
		|					THEN CASE
		|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
		|								THEN CASE
		|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
		|											THEN ""66.01""
		|										ELSE ""66.21""
		|									END
		|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
		|								THEN CASE
		|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &ComplAccountingCurrency
		|											THEN ""67.01""
		|										ELSE ""67.21""
		|									END
		|						END
		|			END
		|	END AS AccountForSettlementsWithCounterparty
		|FROM
		|	Document.CashAccountReceiptNote.ARAPDetails AS ARAPDetails
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &ComplAccountingCurrency) AS ExchangeRates
		|		ON ARAPDetails.ARAPCurrency = ExchangeRates.Currency
		|WHERE
		|	ARAPDetails.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 1
		|	DocumentData.IncomeItem AS IncomeItem
		|FROM
		|	Document.CashAccountReceiptNote.ARAPDetails AS DocumentData
		|WHERE
		|	DocumentData.Ref = &Ref
		|	AND (DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherIncome)
		|			OR DocumentData.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.OtherCashReceipt))
		|	AND (DocumentData.IncomeItem REFS ChartOfCharacteristicTypes.IncomeItems
		|				AND DocumentData.IncomeItem <> VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
		|			OR DocumentData.IncomeItem REFS ChartOfCharacteristicTypes.ExpenseItems
		|				AND DocumentData.IncomeItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef))
		|
		|ORDER BY
		|	DocumentData.LineNumber";
	
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("ComplAccountingCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	Query.SetParameter("CorAccountsFromArticlesAreUsed", ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed); 
	Query.SetParameter("ThisIsWE", Not GetFunctionalOption("LocalizationRFService"));
	
	AdditionalData = Query.ExecuteBatch();
	
	HeaderData_ = AdditionalData[3].Unload()[0];
	IBData.AdditionalProperties.Insert("HeaderData_",                   HeaderData_);
	IBData.AdditionalProperties.Insert("ExtendedPaymentDecryption", AdditionalData[4]);
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferCashBetweenCompanyAndItsBranchOffices Then
		UsageOCR.Document_OCRInternalTransfer_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CurrencyConversion Then
		UsageOCR.Document_PCOCurrencyConversion_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromBank Then
		UsageOCR.Document_PCOReceiptOfCashInBank_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashCollectionFromBank Then
		UsageOCR.Document_PCOReceiptOfCashInBank_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherIncome
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ReversalOfOtherExpenses Then
		// Household operations Other income and reversal of other expenses will no longer be used.
		// Left for a transitional period.
		UsageOCR.Document_PKOOtherIncome_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.OtherCashReceipt Then
		RevenueData_ = AdditionalData[5].Unload();
		If RevenueData_.Count() > 0 Then
			UsageOCR.Document_PKOOtherIncome_Sending = True;
		Else
			UsageOCR.Document_PKOOtherReceipt_Sending = True;
		EndIf;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromOtherCompany
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCustomer Then
		UsageOCR.Document_PCOSettlementsWithCounterparties_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromVendor
		Or IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromAnotherCompany Then
		UsageOCR.Document_PCOSettlementsWithCounterparties_Sending = True;
	ElsIf ThisIsBusinessOperationSettlementsOnLoansLoans(IBData.BusinessOperation)
		Or ThisIsBusinessOperationSettlementOfDeposits(IBData.BusinessOperation) 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptBorrowingsProvidedToCounterparty Then
		UsageOCR.Document_PCOSettlementsWithCounterparties_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReturnByAdvanceHolder
		Or IBData.BusinessOperation = Enums.BusinessTransactions.LoanRepaymentByEmployee Then
		UsageOCR.Document_PCOSettlementsWithEmployees_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromCashRegister Then
		UsageOCR.Document_PCOReceiptFromCashRegister_Sending = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.CashReceiptFromAnotherCashAccount Then
		UsageOCR.Document_PCOReceivedFromAnotherSalesRegister_Sent = True;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.RefundFromLessor Then
		UsageOCR.Document_PCOSettlementsWithCounterparties_Sending = True;
	EndIf;
EndProcedure

