Procedure PCO_Catalog_LoanAgreements_FromStructure_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Approved = True;
	ReceivedData.Status = Enums.CounterpartyContractStatuses.Valid;
	If XDTOData.KeyProperties.Property("ContractKind")
		And ValueIsFilled(XDTOData.KeyProperties.ContractKind) Then
		ReceivedData.ContractKind = XDTOData.KeyProperties.ContractKind;
	Else    
	    ReceivedData.ContractKind = Enums.ContractKindsOfFinancialInstruments.LoanOrBorrowing;
	EndIf;
	If XDTOData.KeyProperties.Property("ContractType")
		And ValueIsFilled(XDTOData.KeyProperties.ContractType) Then
		ReceivedData.ContractType = XDTOData.KeyProperties.ContractType;
	Else    
	    ReceivedData.ContractType = Enums.LoanAndDepositContractTypes.BankLoan;
	EndIf;
	If XDTOData.KeyProperties.Property("PriorityType")
		And ValueIsFilled(XDTOData.KeyProperties.PriorityType) Then
		ReceivedData.PriorityType = XDTOData.KeyProperties.PriorityType;
	Else    
	    ReceivedData.PriorityType = Enums.LoanAndDepositPriorityType.LongTerm;
	EndIf;
	
	ReceivedData.FeeType = Enums.LoanAndDepositFeeTypes.None;
	ReceivedData.Date = XDTOData.KeyProperties.Date;
	ReceivedData.Number = XDTOData.KeyProperties.Number;
	ReceivedData.Description = XDTOData.KeyProperties.Description;
	
	AdditionalProperties = ReceivedData.AdditionalProperties;
	AdditionalProperties.Insert("Organization", XDTOData.KeyProperties.Organization);
	AdditionalProperties.Insert("Counterparty", XDTOData.KeyProperties.Counterparty);
	If XDTOData.KeyProperties.Property("ARAPCurrency")
		And ValueIsFilled(XDTOData.KeyProperties.ARAPCurrency) Then
		
		If XDTOData.KeyProperties.ARAPCurrency.Property("Ref") Then
			OCRName = "Catalog_Currencies";
		Else
			OCRName = "Catalog___FromStructure";
		EndIf;
		ReceivedData.AdditionalProperties.Insert("ARAPCurrency", New Structure("Value, OCRName", XDTOData.KeyProperties.ARAPCurrency, OCRName));
	Else
		ReceivedData.ARAPCurrency = SettingsValueCached.DefaultBaseCurrency();
	EndIf;
EndProcedure

