Procedure DPR_Document_CashRegisterShift_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	//We will get a cash register .
	CashRegister = IBData.CashRegister;
	If Not ValueIsFilled(CashRegister) Then
		
		CashRegisterCashRegisterFiscalDevice = CashRegisterCashRegisterFiscalDevice(IBData.FiscalDevice);
		CashRegister = CashRegisterCashRegisterFiscalDevice.CashRegister;
		
		If Not ValueIsFilled(CashRegister) Then
			
			UsageOCR.Clear();
			
			WarningTemplate = NStr("vi = 'Không thể kết xuất chứng từ %1,
			|bởi vì không tìm thấy Quầy thu ngân tương ứng với thiết bị: 
			|%2';
			|ru = 'Документ %1 не может быть выгружен,
			|т.к. не обнаружена Касса ККМ, соответствующая оборудованию: 
			|%2';
			|en = 'The %1 document cannot be exported
			|as the cash register corresponding to the equipment is not found: 
			|%2'; fa = 'The %1 document cannot be exported
			|as the cash register corresponding to the equipment is not found: 
			|%2';
			|it = 'Il documento %1 non può essere caricato,
			|poiché non è stata rilevato il Registratore di cassa corrispondente all''attrezzatura: 
			|%2';
			|pl = 'Dokument %1 nie może być wyeksportowany,
			|ponieważ nie wykryto Kasy, odpowiadającej sprzetowi: 
			|%2';
			|tr = '%1 belgesi yüklenemez
			|çünkü ekipmana karşılık gelen yazar kasa bulunamadı: 
			|%2'");
			
			WarningText = StrTemplate(WarningTemplate, IBData.Ref, IBData.FiscalDevice);
			SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
			
			Return;
		EndIf;
	EndIf;
	
	IBData.AdditionalProperties.Insert("CashRegister", CashRegister);
	
	If IBData.Status = Enums.CashRegisterShiftStatuses.IsOpen Then
		UsageOCR.Document_CashShift__Sending = False;
	EndIf;
EndProcedure

