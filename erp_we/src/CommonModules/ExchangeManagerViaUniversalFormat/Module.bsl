Function TranscriptOfPaymentCashReceiptDocuments(IBData, ExchangeComponents)
	Query = New Query;
	
	Query.Text = 
	"SELECT
	|	ARAPDetails.CashFlowItem                       AS CFItem,
	|	ARAPDetails.Sum                                               AS Sum,
	|	ARAPDetails.VATAmount                                            AS VATAmount,
	|	ARAPDetails.VATRate                                           AS VATRate,
	|	ARAPDetails.AmountARAP                                 AS AmountARAP,
	|	ARAPDetails.ARAPObject.Object                               AS DocumentOfSettlementObject,
	|	ARAPDetails.ARAPObject.Contract                              AS Contract,
	|	ARAPDetails.PaymentPurpose                                    AS PaymentPurpose,
	|	ARAPDetails.Partner                                             AS Partner,
	|	ARAPDetails.LoanDepositContract                              AS LoanDepositContract,
	|	ARAPDetails.LeaseContracts                                       AS LeaseContracts,
	|	ARAPDetails.ExchangeRateNumeratorOfMutualSettlements                         AS TransactionRate,
	|	ARAPDetails.TheExchangeRateIsTheDenominatorOfMutualSettlements                       AS Multiplier_,
	|	ARAPDetails.ARAPCurrency                                AS ARAPCurrency,
	|	CASE
	|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
	|			OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.LoanToEmployee)
	|			THEN CASE
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|						THEN ""ShortTermLoans_""
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|						THEN ""LongTermLoans_""
	|				END
	|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit)
	|			THEN CASE
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|								THEN ""ShortTermLoans""
	|						END
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|								THEN ""LongTermLoans""
	|						END
	|				END
	|		ELSE NULL
	|	END AS TypeOfCalculationsAdvanced,
	|	CASE 
	|		WHEN &ThisIsWE OR (ARAPDetails.CashFlowItem.OffsettingAccount <> """" AND &CorAccountsFromArticlesAreUsed) 
	|			THEN ARAPDetails.CashFlowItem.OffsettingAccount
	|		ELSE CASE
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.LoanToEmployee)
	|					THEN ""58.03""
	|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan))
	|					AND ARAPDetails.CashFlowItem <> ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|					THEN ""58.03""
	|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit))
	|					AND ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|											THEN ""66.03""
	|										ELSE ""66.23""
	|									END
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|											THEN ""67.03""
	|										ELSE ""67.23""
	|									END
	|						END
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|											THEN ""66.01""
	|										ELSE ""66.21""
	|									END
	|							WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|											THEN ""67.01""
	|										ELSE ""67.21""
	|									END
	|					END
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.DepositWithoutInterestCapitalization)
	|					OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.DepositWithInterestCapitalization)
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|								THEN ""55.03""
	|							ELSE ""55.23""
	|						END
	|		END
	|	END AS AccountForSettlementsWithCounterparty,
	|	ARAPDetails.RowID AS RowID,
	|	ARAPDetails.LoanAndDepositAmountType AS LoanAndDepositAmountType,
	|	FALSE AS ThisIsPrepayment
	|FROM
	|	&DocumentTable AS ARAPDetails
	|WHERE
	|	ARAPDetails.Ref = &Ref";
	
	Query.Text = StrReplace(Query.Text, "&DocumentTable", "Document." + IBData.Ref.Metadata().Name +".ARAPDetails");
	
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("ThisIsWE", Not GetFunctionalOption("LocalizationRFService"));
	Query.SetParameter("CorAccountsFromArticlesAreUsed", ExchangeComponents.ConversionParameters_SSLy.CorAccountsFromArticlesAreUsed);
	Query.SetParameter("CurrencyOfComplianceAccounting", LocalAccountingCurrency(IBData.Organization));
	
	DecryptionOfPaymentInInformationBase = Query.Execute().Unload();
	
	Return DecryptionOfPaymentInInformationBase;
EndFunction
Function DecryptionOfPaymentOfDocumentsOfWriteOffOfCash(IBData, ExchangeComponents)
	Query = New Query;
	
	Query.Text =
	"SELECT
	|	ARAPDetails.CashFlowItem                       AS CFItem,
	|	ARAPDetails.Sum                                               AS Sum,
	|	ARAPDetails.VATAmount                                            AS VATAmount,
	|	ARAPDetails.VATRate                                           AS VATRate,
	|	ARAPDetails.AmountARAP                                 AS AmountARAP,
	|	ARAPDetails.LoanDepositContract                              AS LoanDepositContract,
	|	ARAPDetails.ARAPObject.Object                               AS DocumentOfSettlementObject,
	|	ARAPDetails.ARAPObject.Contract                              AS Contract,
	|	ARAPDetails.Partner                                             AS Partner,
	|	ARAPDetails.RowID                                 AS RowID,
	|	ARAPDetails.ExchangeRateNumeratorOfMutualSettlements                         AS TransactionRate,
	|	ARAPDetails.TheExchangeRateIsTheDenominatorOfMutualSettlements                       AS Multiplier_,
	|	ARAPDetails.ARAPCurrency                                AS ARAPCurrency,
	|	CASE
	|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
	|			OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.LoanToEmployee)
	|			THEN CASE
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
	|								THEN ""ShortTermLoans_""
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment
	|								OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfFeePayment
	|								THEN ""InterestOnShortTermLoans""
	|						END
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
	|								THEN ""LongTermLoans_""
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment
	|								OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfFeePayment
	|								THEN ""InterestOnLongTermLoans""
	|						END
	|				END
	|		WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|				OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit)
	|			THEN CASE
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
	|								THEN ""ShortTermLoans""
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment
	|								OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfFeePayment
	|								THEN ""InterestOnShortTermLoans_""
	|						END
	|					WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|						THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
	|								THEN ""LongTermLoans""
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment
	|								OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfFeePayment
	|								THEN ""InterestOnLongTermLoans_""
	|						END
	|				END
	|		ELSE NULL
	|	END AS TypeOfCalculationsAdvanced,
	|	CASE
	|		WHEN ARAPDetails.CashFlowItem.OffsettingAccount <> """"
	|				AND &ThisIsUT
	|			THEN ARAPDetails.CashFlowItem.OffsettingAccount
	|		ELSE CASE
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.LoanToEmployee)
	|						THEN ""58.03""
	|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|					OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|					OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit))
	|					AND ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfReceiptIssuie
	|						THEN ""58.03""
	|				WHEN (ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.InternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.ExternalLoan)
	|						OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.EmployeeDeposit))
	|					THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""66.03""
	|													ELSE ""66.23""
	|												END
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""67.03""
	|													ELSE ""67.23""
	|												END
	|								END
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment
	|									OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfFeePayment
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""66.04""
	|													ELSE ""66.43""
	|												END
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""67.04""
	|													ELSE ""67.43""
	|												END
	|								END
	|					END
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.BankLoan)
	|					THEN CASE
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfPrincipalDebt
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""66.01""
	|													ELSE ""66.21""
	|												END
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""67.01""
	|													ELSE ""67.21""
	|												END
	|								END
	|							WHEN ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfInterestPayment
	|									OR ARAPDetails.CashFlowItem = ARAPDetails.LoanDepositContract.CashFlowItemOfFeePayment
	|								THEN CASE
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.ShortTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""66.02""
	|													ELSE ""66.22""
	|												END
	|										WHEN ARAPDetails.LoanDepositContract.PriorityType = VALUE(Enum.LoanAndDepositPriorityType.LongTerm)
	|											THEN CASE
	|													WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|														THEN ""67.02""
	|													ELSE ""67.22""
	|												END
	|								END
	|					END
	|				WHEN ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.DepositWithoutInterestCapitalization)
	|					OR ARAPDetails.LoanDepositContract.ContractType = VALUE(Enum.LoanAndDepositContractTypes.DepositWithInterestCapitalization)
	|					THEN CASE
	|							WHEN ARAPDetails.LoanDepositContract.ARAPCurrency = &CurrencyOfComplianceAccounting
	|								THEN ""55.03""
	|							ELSE ""55.23""
	|						END
	|		END
	|	END AS AccountForSettlementsWithCounterparty,
	|	FALSE AS ThisIsPrepayment
	|FROM
	|	&DocumentTable AS ARAPDetails
	|WHERE
	|	ARAPDetails.Ref = &Ref";
	
	Query.Text = StrReplace(Query.Text, "&DocumentTable", "Document." + IBData.Ref.Metadata().Name +".ARAPDetails");
	
	Query.SetParameter("Ref",          IBData.Ref);
	Query.SetParameter("ThisIsUT",           ThisIsUT());
	Query.SetParameter("Date",            IBData.Date);
	Query.SetParameter("CurrencyOfComplianceAccounting", LocalAccountingCurrency(IBData.Organization)); 
	
	DecryptionOfPaymentInInformationBase = Query.Execute().Unload();
		
	Return DecryptionOfPaymentInInformationBase;
EndFunction
