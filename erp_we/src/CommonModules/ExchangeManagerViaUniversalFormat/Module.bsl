Procedure OCR_Document_AssemblyFromComponents_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	ReceivedData.Status = Enums.GoodsAssemblyStatuses.AssembledDisassembled;
	If XDTOData.OperationKind.Value = "Disassembly" Then
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.DisassemblyIntoComponents;
	Else	
		ReceivedData.BusinessOperation = Enums.BusinessTransactions.AssemblyFromComponents;
	EndIf;
	
	If XDTOData.Property("Characteristic") And ValueIsFilled(XDTOData.Characteristic)
		And FOValue("UseItemVariants", ExchangeComponents) Then
		ReceivedData.AdditionalProperties.Insert("Characteristic", XDTOData.Characteristic);
	EndIf;
	If XDTOData.Property("Package") And ValueIsFilled(XDTOData.Package)
		And FOValue("UseItemPackages", ExchangeComponents) Then
		ReceivedData.AdditionalProperties.Insert("Package", XDTOData.Package);
		
		If XDTOData.Property("NumberOfPackages") And ValueIsFilled(XDTOData.NumberOfPackages) Then
			ReceivedData.NumberOfPackages = XDTOData.NumberOfPackages;
		EndIf;	
	EndIf;	
	
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products",        "Products");
	FillingRules.Insert("Count",          "Count");
	FillingRules.Insert("CostShare",       "CostShare");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	
	ArrayOfRows = New Array;
	For Each String In XDTOData.Goods Do
		
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		
		If Not (StringDataStructure.Property("NumberOfPackages") And StringDataStructure.NumberOfPackages <> 0) Then
			StringDataStructure.Insert("NumberOfPackages", StringDataStructure.Count);
		EndIf;
		
		ArrayOfRows.Add(StringDataStructure);
		
	EndDo;
	
	ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	
	#EndRegion
EndProcedure
Procedure OCR_Document_AssemblyFromComponents_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
