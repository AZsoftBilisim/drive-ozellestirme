Procedure OCR_Catalog_ProductsFromVendor_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	UnitOfMeasure = Undefined;
	Owner = Undefined;
	Package = Undefined;
	
	BasicEd = Catalogs.PackagingGroups.BasicUnitsOfMeasure;
	If ValueIsFilled(IBData.Package) And Common.RefExists(IBData.Package)
		And Common.ObjectAttributeValue(IBData.Package, "Owner") = BasicEd Then
		
		UnitOfMeasure = IBData.Package;
	EndIf;
	
	If Not ValueIsFilled(UnitOfMeasure) And ValueIsFilled(IBData.Products) Then
		UnitOfMeasure = Common.ObjectAttributeValue(IBData.Products, "UnitOfMeasure");
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
		Owner = PartnersAndCounterparties.GetPartnerSDefaultCounterparty(IBData.Owner);
		
		Products = New Structure;
		Products.Insert("Description", IBData.Description);
		Products.Insert("SKU", IBData.SKU);
		Products.Insert("IDOf1CProductsService", IBData.ServiceItemID);
		
		If (ValueIsFilled(IBData.BaseUnitOfMeasureDescription) Or ValueIsFilled(IBData.BaseUnitOfMeasureARCMUCode)) 
			And (ValueIsFilled(IBData.PackageName) Or ValueIsFilled(IBData.BaseUnitOfMeasureDescription)) Then
				
			UnitOfMeasure = New Structure;
			UnitOfMeasure.Insert("Description", IBData.BaseUnitOfMeasureDescription);
			UnitOfMeasure.Insert("Code", IBData.BaseUnitOfMeasureARCMUCode);
	
			If ValueIsFilled(IBData.PackageName) Then
				Package = New Structure;
				Package.Insert("Description", IBData.PackageName);
				Package.Insert("UnitOfMeasure", UnitOfMeasure);
				Package.Insert("Products", Products);
				Package.Insert("ZoomRatio",?(IBData.NumberOfPackages = 0,
					IBData.QuantityInBaseUnitOfMeasure,
					Round(IBData.QuantityInBaseUnitOfMeasure / IBData.NumberOfPackages,3)));
			Else
				Package = New Structure;
				Package.Insert("Description", IBData.BaseUnitOfMeasureDescription);
				Package.Insert("UnitOfMeasure", UnitOfMeasure);
				Package.Insert("Products", Products);
				Package.Insert("ZoomRatio", 1);
			EndIf;
			
		EndIf;
	EndIf;
	
	If ExportStack.Count() > 1 Then
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
			XDTOData.Insert("ProductPackaging", Package);
			XDTOData.Insert("Owner", Owner);
		Else
			XDTOData.Insert("UnitOfMeasure", UnitOfMeasure);
		EndIf;
		
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.8") Then
		XDTOData.KeyProperties.Insert("ProductPackaging", Package);
		XDTOData.KeyProperties.Insert("Owner", Owner);
		
		XDTOData.Insert("UnitOfMeasure", UnitOfMeasure);
	Else
		XDTOData.KeyProperties.Insert("UnitOfMeasure", UnitOfMeasure);
	EndIf;
EndProcedure

