Procedure SUB_Catalog_InventoryAccessoriesTT_Shipment_DuringProcessing(IBData, UsageOCR, ExchangeComponents)
	If IBData.Count() = 0 Then
		// deleting a register entry does NOT go away in exchange
		UsageOCR.Clear();
		Return;
	EndIf;
	FilterWarehouse = IBData.Filter.Warehouse.Value;	// CatalogRef.Warehouses
	FilterOrganization = IBData.Filter.CompanyCustomer.Value;
	If ExchangeComponents.CorrespondentNodeObject = Undefined Then
		UsageOCR.Clear();
		Return;
	EndIf;
	If ExchangeComponents.CorrespondentNodeObject.UseFilterByCompanies
		And ExchangeComponents.CorrespondentNodeObject.Companies.Find(FilterOrganization) = Undefined Then
		UsageOCR.Clear();
		Return;
	EndIf;
	If ExchangeComponents.CorrespondentNodeObject.UseFilterByWarehouses
		And ExchangeComponents.CorrespondentNodeObject.Warehouses.Find(FilterWarehouse) = Undefined Then
		UsageOCR.Clear();
		Return;
	EndIf;
	If ExchangeComponents.CorrespondentNodeObject.UploadProductPrices Then
		PriceTypeOfWarehouse = Common.ObjectAttributeValue(FilterWarehouse, "RetailPriceType");
		If ExchangeComponents.CorrespondentNodeObject.ProductPricesTypes.Find(PriceTypeOfWarehouse) = Undefined Then
			UsageOCR.Clear();
			Return;
		EndIf;
	EndIf;
EndProcedure

