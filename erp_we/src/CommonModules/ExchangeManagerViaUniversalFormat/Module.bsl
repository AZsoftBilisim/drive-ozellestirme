			|ponieważ nie udało się otrzymać kontrahenta dla podanego partnera.';
			|tr = '%1 kataloğu yüklenemez,
			|çünkü belirtilen iş ortağı için cari hesap alınamadı.'");
			
			WarningText = StrTemplate(WarningTemplate, IBData.Ref);
			SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
			
		EndIf;
		
		UnitOfMeasure = Undefined;
		
		BasicEd = Catalogs.PackagingGroups.BasicUnitsOfMeasure;
		If ValueIsFilled(IBData.Package) And Common.RefExists(IBData.Package)
			And Common.ObjectAttributeValue(IBData.Package, "Owner") = BasicEd Then
			
			UnitOfMeasure = IBData.Package;
		EndIf;
	 
		If Not ValueIsFilled(UnitOfMeasure) And ValueIsFilled(IBData.Products) Then
			UnitOfMeasure = Common.ObjectAttributeValue(IBData.Products, "UnitOfMeasure");
		EndIf;
		
		If Not ValueIsFilled(UnitOfMeasure) Then
			UsageOCR.Clear();
			
			WarningTemplate = NStr("vi = 'Không thể kết xuất danh mục %1,
			|bởi vì chưa chỉ ra đơn vị tính.';
			|ru = 'Справочник %1 не может быть выгружен,
			|т.к. не указана единица измерения.';
			|en = 'The %1 catalog cannot be exported
			|as the unit of measure is not specified.'; fa = 'The %1 catalog cannot be exported
			|as the unit of measure is not specified.';
			|it = 'La directory %1 non può essere caricata,
			|poiché non è indicata l''unità di misura.';
			|pl = 'Katalog %1 nie może być wyeksportowany,
			|ponieważ nie podano jednostki miary.';
			|tr = '%1 kataloğu yüklenemez,
			|çünkü ölçü birimi belirtilmedi.'");
			
			WarningText = StrTemplate(WarningTemplate, IBData.Ref);
			SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
	
		EndIf;
	EndIf;
EndProcedure

