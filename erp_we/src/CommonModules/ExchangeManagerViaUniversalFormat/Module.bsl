Procedure DPR_Document_ProductsRelease_Receive_OnProcess(XDTOData, UsageOCR, ExchangeComponents)
	ClearUsageOCR(UsageOCR);
	UsageOCR.Insert("Document_ProductionWithoutOrder_Receipt", True);
	UsageOCR.Insert("Document_MovementProdAndMat_IssueProd_Receipt", True);
	
	SetUsageOCR(UsageOCR, False);
	
	If Not GetLinkById(XDTOData, "Document.BackflushProduction") = Undefined Then
		UsageOCR.Document_ProductionWithoutOrder_Receipt = True;
	ElsIf Not GetLinkById(XDTOData, "Document.MovementOfProductsAndMaterials") = Undefined Then
		UsageOCR.Document_MovementProdAndMat_IssueProd_Receipt = True;
	Else
		UseProductionManagement2_2 = GetFunctionalOption("UseProductionManagement2_2");
		
		If UseProductionManagement2_2 Then
			// We will determine the PCO used depending on the composition of the exchange file
			// and the details of the unit.
			If Not XDTOData.Property("UsedMaterials")
				And Not XDTOData.Property("RecyclableWaste")
				And XDTOData.Property("Department") And ValueIsFilled(XDTOData.Department) Then
	 
				Department = DataExchangeXDTOServer.XDTOObjectStructureToIBData(
					ExchangeComponents,
					XDTOData.Department,
					DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Catalog_Departments_Receive"), 
					"GetRef");
				
				If TypeOf(Department) = Type("CatalogRef.BusinessStructure") Then
					// The division existed at the time of loading, we will check its details.
					DetailsOfDivision = Common.ObjectAttributesValues(Department, "ProductionByOrders, BackflushProduction_");
					If DetailsOfDivision.ProductionByOrders And Not DetailsOfDivision.BackflushProduction_ Then
						UsageOCR.Document_MovementProdAndMat_IssueProd_Receipt = True;
					EndIf;
				EndIf;
			EndIf;
			
			// In all other cases, we upload it to the "Production Order".
			If Not UsageOCR.Document_MovementProdAndMat_IssueProd_Receipt Then
				UsageOCR.Document_ProductionWithoutOrder_Receipt = True;
			EndIf;
		EndIf;
			
	EndIf;
EndProcedure


