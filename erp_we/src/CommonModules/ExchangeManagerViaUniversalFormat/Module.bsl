Procedure OCR_Document_ReceiptOfGoodsServices_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReceiptOfGoodsServices_Dispatch", 
										"Goods", 
										"CCDNumber", 
										True,
										"Catalog_CCDNumbers_Send");
	EndIf; 
	If FormatVersionIs17AndHigher Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReceiptOfGoodsServices_Dispatch", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending"); 
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ReceiptOfGoodsServices_Dispatch", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
										
	EndIf;
	
	AdvancedInformationSecurityData = PTiU_AdvancedInformationSecurityData(ExchangeComponents, IBData);
	
	XDTOData.Insert("TransactionRate",      AdvancedInformationSecurityData.TransactionRate);
	XDTOData.Insert("Multiplier_", AdvancedInformationSecurityData.Multiplier_);
	
	// Warehouse
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy, True);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	//OrderDocument
	If ValueIsFilled(IBData.PurchaseOrder)
		And Common.RefExists(IBData.PurchaseOrder)
		And ObjectPassesThroughFiltersOfNodeSDocumentTypes(IBData.PurchaseOrder, ExchangeComponents) Then
		
		Instruction = New Structure("Value, OCRName",
					IBData.PurchaseOrder,
					"Document_OrderToSupplier_Sending");
		XDTOData.Insert("OrderDocument", Instruction);
	EndIf;
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	UploadKitOfPrintedDocumentsSignedSign(ExchangeComponents, IBData, XDTOData);
	
	// Type of operation
	// When the FO "Use commission for sale" is turned off, the "Business transaction" details
	// may not be filled in, which means the usual implementation.
	XDTOData.Insert("OperationKind");
	If IBData.BusinessOperation = Enums.BusinessTransactions.ConsignmentProcurement Then
		XDTOData.OperationKind = "ConsignmentProcurement";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.PurchaseByImport
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEU
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUUninvoicedDelivery
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUGoodsInTransit
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUInvoicedDelivery
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportReceiptFromGoodsInTransit 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ImportGoodsInTransit 
		Or IBData.BusinessOperation = Enums.BusinessTransactions.ProductionAtProcessorInEAEUCountries2_5 Then
		XDTOData.OperationKind = "PurchaseByImport";
	Else
		XDTOData.OperationKind = "PurchaseFromSupplier_";
	EndIf;
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Counterparty = IBData.Counterparty;
		DefaultParameters.Organization = IBData.Organization;
		DefaultParameters.ARAPCurrency = IBData.ARAPCurrency;
		DefaultParameters.TypeOfAgreement = ?(IBData.BusinessOperation = Enums.BusinessTransactions.ConsignmentProcurement,
			"WithConsignor", "WithVendor");
		DefaultParameters.Date = IBData.Date;
		DefaultParameters.Number = IBData.Number;
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = IBData.Currency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization) And IBData.Currency <> IBData.ARAPCurrency;
		EndIf;
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity",  IBData.PurchaseOrder, IBData.Terms, Undefined);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		XDTOData.Insert("Contract", Contract);
	EndIf;
	
	// Goods
	Goods = AdvancedInformationSecurityData.Goods;
	If Goods.Count() > 0 Then
		FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
		FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "PurchaseForActivity", "PurchaseForActivity");
		XDTOData.Insert("Goods", Goods);
	EndIf;
	
	// Services, decryption of expenses
	Services = AdvancedInformationSecurityData.Services;
	TranscriptOfAdditionalExpenses = AdvancedInformationSecurityData.TranscriptOfAdditionalExpenses.Copy();
	TranscriptOfAdditionalExpenses.Columns.DocumentInflow.Name = "DocumentLink";
	// A new column with an arbitrary type is needed so that the value of the Structure type can be written there.
	TranscriptOfAdditionalExpenses.Columns.Add("DocumentInflow");
	
	//ProductBatchID information   
	
		
	// We do not transfer as additional expenses if there are blank receipt documents.
	NoBaseForDistribution = (TranscriptOfAdditionalExpenses.Count()=0);
	CompositePropertyType = Undefined; 
	TotalRows = TranscriptOfAdditionalExpenses.Count();
	If TotalRows > 0 And Not FormatVersionIs17AndHigher Then
		For Counter = 0 To TotalRows - 1 Do 
			CurrentRow = TranscriptOfAdditionalExpenses[TotalRows - Counter - 1];
			If TypeOf(CurrentRow.DocumentLink) = Type("DocumentRef.AssemblyFromComponents") Then
				TranscriptOfAdditionalExpenses.Delete(CurrentRow);
			EndIf;
		EndDo;
	EndIf;
	
	For Each LineDecryptionOfAdditionalExpenses In TranscriptOfAdditionalExpenses Do
		If Not ValueIsFilled(LineDecryptionOfAdditionalExpenses.DocumentLink) Then
			NoBaseForDistribution = True;
			Break;
		ElsIf LineDecryptionOfAdditionalExpenses.DocumentLink = IBData.Ref Then
			// We bypass the looping protection - we record the already converted link value as the receipt document.
			LineDecryptionOfAdditionalExpenses.DocumentInflow = XDTOData.KeyProperties;
			If CompositePropertyType = Undefined Then
				CurICO = DataExchangeXDTOServer.OCRByName(ExchangeComponents, "Document_ReceiptOfGoodsServices_Dispatch");
				CompositePropertyType = CurICO.KeyPropertiesTypeOfXDTOObject;
			EndIf;
			LineDecryptionOfAdditionalExpenses.DocumentInflow.Insert("CompositePropertyType", CompositePropertyType); 
		ElsIf TypeOf(LineDecryptionOfAdditionalExpenses.DocumentLink) = Type("DocumentRef.AssemblyFromComponents") And FormatVersionIs17AndHigher Then 
			Instruction = New Structure("Value, OCRName", LineDecryptionOfAdditionalExpenses.DocumentLink, "Document_AssemblyFromComponents");
			LineDecryptionOfAdditionalExpenses.DocumentInflow = Instruction;
	        Else
			
			ThisIsInternalDisplacement = (TypeOf(LineDecryptionOfAdditionalExpenses.DocumentLink) = Type("DocumentRef.CustomerInvoiceIntercompany"));
			ReceiptICOName = ?(ThisIsInternalDisplacement, "TransferBetweenOrganizations_PTU_Sending", "Document_ReceiptOfGoodsServices_Dispatch");
			DescriptionOfConversion = New Structure("Value, OCRName", LineDecryptionOfAdditionalExpenses.DocumentLink, ReceiptICOName);
			LineDecryptionOfAdditionalExpenses.DocumentInflow = DescriptionOfConversion;
			
		EndIf;
	EndDo;
		
	If NoBaseForDistribution Then
		Services.FillValues(False, "ThisIsAdditionalExpense");
		TranscriptOfAdditionalExpenses.Clear();
	EndIf;
	
	If Services.Count() > 0 Then
		XDTOData.Insert("Services", Services);
	EndIf;
	
	If TranscriptOfAdditionalExpenses.Count() > 0 Then
		XDTOData.Insert("TranscriptOfAdditionalExpenses", TranscriptOfAdditionalExpenses);
		Services.FillValues(True, "ThisIsAdditionalExpense");
	EndIf;
	
	
	#Region RepaymentOfDebt
	
	If IBData.ARAPObjectSettings = Enums.ARAPObjectSettings.ByARAPDocuments Then
	
		Query = New Query("SELECT
			|	VendorInvoiceARAPDetails.ARAPObject.Object AS OrderDocument,
			|	SUM(VendorInvoiceARAPDetails.Sum) AS Sum
			|FROM
			|	Document.VendorInvoice.ARAPDetails AS VendorInvoiceARAPDetails
			|WHERE
			|	VendorInvoiceARAPDetails.Ref = &Ref
			|	AND VALUETYPE(VendorInvoiceARAPDetails.ARAPObject.Object) IN (&TypesOfPaymentDocuments)
			|	AND VendorInvoiceARAPDetails.ARAPObject.Object.Date < VendorInvoiceARAPDetails.Ref.Date
			|
			|GROUP BY
			|	VendorInvoiceARAPDetails.ARAPObject.Object");
		
		TypesOfPaymentDocuments = New Array;
		TypesOfPaymentDocuments.Add(Type("DocumentRef.BankAccountIssue"));
		TypesOfPaymentDocuments.Add(Type("DocumentRef.CashVoucher"));
		
		Query.SetParameter("Ref", IBData.Ref);
		Query.SetParameter("TypesOfPaymentDocuments", TypesOfPaymentDocuments);
		
		TableCredited = Query.Execute().Unload();
		TableCredited.Columns.Add("DocumentOfARAPAccounting", New TypeDescription("Structure"));
		ArrayOfRowsToDelete_1 = New Array;
		
		For Each RowCredited In TableCredited Do
			OCRName = NameOfICOForDataObject(ExchangeComponents, RowCredited.OrderDocument, IBData.Organization);
			If ValueIsFilled(OCRName) Then
				RowCalculationDocument = New Structure("Value, OCRName", RowCredited.OrderDocument, OCRName);
				RowCredited.DocumentOfARAPAccounting = RowCalculationDocument;
			Else
				ArrayOfRowsToDelete_1.Add(RowCredited);
			EndIf;
		EndDo;
		
		If ValueIsFilled(ArrayOfRowsToDelete_1) Then
			For Each RowToDelete In ArrayOfRowsToDelete_1 Do
				TableCredited.Delete(RowToDelete);
			EndDo;
		EndIf;
		
		XDTOData.Insert("RepaymentOfDebt", TableCredited);
		
			
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.VendorInvoice.SetOfSeries", XDTOData);
	EndIf;
	#EndRegion
EndProcedure

