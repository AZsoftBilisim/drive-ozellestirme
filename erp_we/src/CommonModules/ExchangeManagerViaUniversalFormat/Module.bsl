Procedure PKO_Document_BalancesOfGoodsTransferredToCommission_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	FillInAccountingSectionForEnteringBalances(ReceivedData);
	
	#Region Agreement_With_commissioner
	If IBData = Undefined Or Not ValueIsFilled(IBData.TermsOfConsignmentSales) Then
		
		If Not ValueIsFilled(ReceivedData.TermsOfConsignmentSales) Then
	
			Query = New Query;
			Query.Text = "
				|	SELECT TOP 1
				|		TermsOfSale.Ref
				|	FROM
				|		Catalog.TermsOfSale AS TermsOfSale
				|	WHERE
				|		TermsOfSale.BusinessOperation = &BusinessOperation
				|		AND NOT TermsOfSale.Standard_
				|		AND NOT TermsOfSale.DeletionMark
				|		AND TermsOfSale.Counterparty = &Counterparty
				|		AND TermsOfSale.Organization = &Organization
				|		AND TermsOfSale.Currency = &Currency
				|	
				|	UNION ALL
				|	
				|	SELECT TOP 1
				|		TermsOfSale.Ref
				|	FROM
				|		Catalog.TermsOfSale AS TermsOfSale
				|	WHERE
				|		TermsOfSale.BusinessOperation = &BusinessOperation
				|		AND TermsOfSale.Standard_
				|		AND NOT TermsOfSale.DeletionMark
				|		AND TermsOfSale.Currency = &Currency";
				
			Query.SetParameter("BusinessOperation", Enums.BusinessTransactions.TransferToCommissionAgent);
			Query.SetParameter("Counterparty", ReceivedData.Counterparty);
			Query.SetParameter("Organization", ReceivedData.Organization);
			Query.SetParameter("Currency", ReceivedData.Currency);
			
			TermsOfConsignmentSales = Catalogs.TermsOfSale.EmptyRef();
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				TermsOfConsignmentSales = Selection.Ref;
			Else
				Terms = Catalogs.TermsOfSale.CreateItem();
				Terms.Description          = NStr("vi = 'Với người nhận ký gửi (mặc định)';
													|ru = 'С комиссионером (по умолчанию)';
													|en = 'With consignee (default)'; fa = 'With consignee (default)';
													|it = 'Con commissionario (da impostazione predefinita)';
													|pl = 'Z komisantam (domyślnie)';
													|tr = 'Konsinye ile (varsayılan)'");
				Terms.Organization           = ReceivedData.Organization;
				Terms.Counterparty            = ReceivedData.Counterparty;
				Terms.Partner               = CashServer.GetCounterpartyPartner(ReceivedData.Counterparty);
				Terms.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent;
				Terms.Currency                = ReceivedData.Currency;
				
				Terms.Status = Enums.StatusesOfTermsOfSales.Valid;
				Terms.Approved = True;
				Terms.Comment = NStr("vi = 'KTDN -> ERP 2.0';
									|ru = 'БП -> ERP 2.0';
									|en = '1C:Enterprise Accounting -> ERP 2.0'; fa = '1C:Enterprise Accounting -> ERP 2.0';
									|it = 'BP -> ERP 2.0';
									|pl = 'Księgowość przedsiębiorstwa -> ERP 2.0';
									|tr = 'İM -> ERP 2.0'");
				Terms.Write();
				
				// Synchronization of the value of the corresponding functional option.
				CurConstantValue = Constants.UseTermsOfSales.Get();
				NewConstantValue = Undefined;
				If CurConstantValue = Enums.UseTermsOfSales.DontUse Then
					NewConstantValue = Enums.UseTermsOfSales.OnlySpecialTermsOfSales;
				ElsIf CurConstantValue = Enums.UseTermsOfSales.OnlyStandardTermsOfSales Then
					NewConstantValue = Enums.UseTermsOfSales.StandardAndIndividualTermsOfSales;
				EndIf;
				If NewConstantValue <> Undefined Then
					Constants.UseTermsOfSales.Set(NewConstantValue);
				EndIf;				
				
				TermsOfConsignmentSales = Terms.Ref;
			EndIf;
			
			ReceivedData.TermsOfConsignmentSales = TermsOfConsignmentSales;
			If IBData <> Undefined Then
				IBData.TermsOfConsignmentSales = TermsOfConsignmentSales;
			EndIf;
		EndIf;
			
	EndIf;	
	#EndRegion
EndProcedure

