Function DocumentUploadIsSupported(Document, Organization, ExchangeComponents)
	OCRName = NameOfICOForDataObject(ExchangeComponents, Document, Organization);
	
	If IsBlankString(OCRName) Then
		
		Return False;
		
	EndIf;
	
	ConversionRule = ExchangeComponents.ObjectsConversionRules.Find(OCRName, "OCRName");
	
	// If the correspondent does not support loading the object in the format in which the document is uploaded,
	//	then conversion is not required.
	If ConversionRule <> Undefined Then
		
		Return FormatObjectPassesXDTOFilter(ConversionRule.FormatObject, ExchangeComponents);
		
	EndIf;
	
	Return False;
EndFunction


Function GetCounterpartyDataForOrganizationSBankAccount(CompanyBankAccount, ExchangeComponents)
	StructureReturn = New Structure("Counterparty, CounterpartyBankAccount");
	
	If Not ValueIsFilled(CompanyBankAccount) Then
		Return StructureReturn; 
	EndIf;
	
	// Search for a counterparty corresponding to the Organization.
	Counterparty = CounterpartyFromOrganization(CompanyBankAccount.Owner, ExchangeComponents);
	
	StructureReturn.Counterparty = Counterparty;
	
	// Filling out a bank account.
	Query = New Query("SELECT TOP 1
		|	CounterpartyBankAccounts.Ref
		|FROM
		|	Catalog.CounterpartyBankAccounts AS CounterpartyBankAccounts
		|WHERE
		|	CounterpartyBankAccounts.Owner = &Owner
		|	AND CounterpartyBankAccounts.AccountNumber = &AccountNumber");
	Query.SetParameter("Owner",   Counterparty);
	Query.SetParameter("AccountNumber", CompanyBankAccount.AccountNumber);
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		StructureReturn.CounterpartyBankAccount = Selection.Ref;
	Else
		
		// Creating a new bank account.
		BankAccountObject = Catalogs.CounterpartyBankAccounts.CreateItem();
		BankAccountObject.Owner = Counterparty;
		FillPropertyValues(BankAccountObject, CompanyBankAccount,,"Owner, Parent");
		BankAccountObject.Write();
		
		CreatedOnExportObjects = ExchangeComponents.ConversionParameters_SSLy.CreatedOnExportObjects; // Array
		CreatedOnExportObjects.Add(BankAccountObject.Ref);
		
		StructureReturn.CounterpartyBankAccount = BankAccountObject.Ref;
		
	EndIf;
	
	Return StructureReturn;
EndFunction
