Procedure OCR_Document_CustomerInvoice_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_SaleOfGoodsAndServices_Shipment", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_SaleOfGoodsAndServices_Shipment", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_SaleOfGoodsAndServices_Shipment", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	TypeOfOperationByString = "";   
	NumberOfShipmentsOfGoodsToCustomer = 0;
	UploadingOrdersIsSupported = MetadataPassesThroughFiltersOfNodeSDocumentTypes("SalesOrder", ExchangeComponents);
	
	If Not ValueIsFilled(IBData.BusinessOperation) Then
		TypeOfOperationByString = "SaleToCustomer";
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.SaleWithDeferredTransferOfTitle Then
		
		If IBData.Status = Enums.StatusesOfCustomerInvoices.InTransit Then
			TypeOfOperationByString = "ShipmentWithoutTransferOfOwnership_inPath";
		Else
			TypeOfOperationByString = "ShipmentWithoutTransferOfOwnership_Implemented"; 
		EndIf;
		
	EndIf;
	
	If TypeOfOperationByString <> "" Then
		XDTOData.Insert("OperationKind", TypeOfOperationByString); 
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent Then
		XDTOData.Insert("OperationKind", "TransferToCommissionAgent");	
	Else
		XDTOData.Insert("OperationKind", "SaleToCustomer");
	EndIf; 
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.15") Then
		XDTOData.Insert("UISStateContractStep", IBData.UISStateContractStep);    
	EndIf; 
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy, True);
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods Then
		If ValueIsFilled(IBData.SalesOrder) Then
			SalesOrder = IBData.SalesOrder;
			WarehouseForUnloading = Common.ObjectAttributeValue(SalesOrder, "Warehouse");
		 ElsIf Not ValueIsFilled(IBData.SalesOrder) Then
			LineProducts_ = IBData.Goods[0];
			SalesOrder = LineProducts_.SalesOrder; 
			WarehouseForUnloading = Common.ObjectAttributeValue(SalesOrder, "Warehouse");
		EndIf;
	EndIf;
	
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	XDTOData.Insert("ChiefAccountant", Common.ObjectAttributeValue(IBData.ChiefAccountant, "Individual"));
	XDTOData.Insert("Director",     Common.ObjectAttributeValue(IBData.Director, "Individual"));
	
	If IBData.OrderSales And ValueIsFilled(IBData.SalesOrder) 
		And TypeOf(IBData.SalesOrder) = Type("DocumentRef.SalesOrder")
		And UploadingOrdersIsSupported Then
		XDTOData.Insert("OrderDocument", IBData.SalesOrder);
	Else
		XDTOData.Insert("OrderDocument", Undefined);
	EndIf;
		
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	UploadKitOfPrintedDocumentsSignedSign(ExchangeComponents, IBData, XDTOData);
	
	CurrencyOfComplianceAccounting = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	
	// Additional properties for the contract
	If ValueIsFilled(IBData.Contract) Then
		XDTOData.Insert("Contract", IBData.Contract);
	Else
		
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		FillPropertyValues(DefaultParameters, IBData);
		
		DefaultParameters.TypeOfAgreement =
			?(IBData.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent, "WithConsignee", "WithCustomer");
			
		If ValueIsFilled(IBData.Terms) Then
			UECalculationData          = Common.ObjectAttributesValues(IBData.Terms, "ARAPCurrency, ForeignCurrencyTransaction, Organization");
			CalculationsInConventionalUnits = VueCalculationIsUnderway(UECalculationData.ARAPCurrency, UECalculationData.ForeignCurrencyTransaction, UECalculationData.Organization, ExchangeComponents);
		Else
			CalculationsInConventionalUnits = (IBData.Currency = CurrencyOfComplianceAccounting And IBData.Currency <> IBData.ARAPCurrency);
		EndIf;
		
		DefaultParameters.CalculationsInConventionalUnits = CalculationsInConventionalUnits;
		
		OrderDocument = New Structure("OrderDocument, Terms, SalesOpportunity", IBData.SalesOrder, IBData.Terms, IBData.SalesOpportunity);
		Contract = ConversionAgreementBasedOnSettlementData(DefaultParameters, ExchangeComponents, OrderDocument, IBData);
		
		XDTOData.Insert("Contract", Contract);
		
	EndIf;
	
	// These document headers are necessary for calculating
	// the exchange rate and the multiplicity of settlements.
	DocumentHeader =
		"SELECT
		|	DocumentHeaderData.Currency AS Currency,
		|	DocumentHeaderData.ARAPCurrency AS ARAPCurrency,
		|	DocumentHeaderData.CourseNumerator AS TransactionRate,
		|	DocumentHeaderData.CourseDenominator AS Multiplier_
		|INTO DocumentHeaderData
		|FROM
		|	Document.CustomerInvoice AS DocumentHeaderData
		|WHERE
		|	DocumentHeaderData.Ref = &Ref
		|INDEX BY
		|	Currency";
		
	If IBData.Currency = CurrencyOfComplianceAccounting
		Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
		
		OperationData =
			"SELECT
			|	DocumentHeaderData.TransactionRate AS TransactionRate,
			|	DocumentHeaderData.Multiplier_ AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData";
		
	Else
		
		OperationData =
			"SELECT
			|	ISNULL(DocumentExchangeRate.CourseNumerator, 1) AS TransactionRate,
			|	ISNULL(DocumentExchangeRate.CourseDenominator, 1) AS Multiplier_
			|FROM
			|	DocumentHeaderData AS DocumentHeaderData
			|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(
			|				&Date,
			|				Currency IN
			|					(SELECT
			|						Doc.Currency
			|					FROM
			|						DocumentHeaderData AS Doc)
			|				AND BaseCurrency = &BaseCurrency) AS DocumentExchangeRate
			|		ON DocumentHeaderData.Currency = DocumentExchangeRate.Currency";
		
	EndIf;
	
	GoodsAndServicesOfDocument =
		"SELECT
		|	Goods.Products AS Products,
		|	Goods.Characteristic AS Characteristic,
		|	CASE
		|		WHEN Goods.Characteristic <> VALUE(Catalog.ItemsCharacteristics.EmptyRef)
		|			THEN CASE
		|					WHEN CharacteristicsOfCat.DescriptionFull = """"
		|						THEN CharacteristicsOfCat.Description
		|					ELSE CharacteristicsOfCat.DescriptionFull
		|				END
		|		ELSE """"
		|	END AS CharacteristicName,
		|	CASE
		|		WHEN CatProducts_.DescriptionFull = """"
		|			THEN CatProducts_.Description
		|		ELSE CatProducts_.DescriptionFull
		|	END AS NomenclatureName,
		|	Goods.Count AS Count,
		|	Goods.Price AS Price,
		|	Goods.Sum AS Sum,
		|	Goods.VATRate AS VATRate,
		|	Goods.VATAmount AS VATAmount,
		|	Goods.Products.ItemsType AS ProductsTypeOfProducts,
		|	Goods.LineNumber AS LineNumber,
		|	Goods.PercentRateOfManualDiscount AS DiscountPercentage,
		|	Goods.ManualDiscount AS DiscountAmount,
		|	Goods.AmountOfBonusPointsToDeduction AS AmountOfBonusPoints,
		|	Goods.RowID AS RowID,
		|	Goods.Series AS Series,
		|	CASE
		|		WHEN &UploadingOrdersIsSupported
		|				AND &SalesAgainstSeveralOrders
		|				AND Goods.SalesOrder REFS Document.SalesOrder
		|			THEN Goods.SalesOrder
		|		ELSE UNDEFINED
		|	END AS OrderDocument,
		|	Goods.SalesOrder AS SalesOrder
		|INTO GoodsTable
		|FROM
		|	Document.CustomerInvoice.Goods AS Goods
		|		LEFT JOIN Catalog.Products AS CatProducts_
		|		ON (CatProducts_.Ref = Goods.Products)
		|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicsOfCat
		|		ON (CharacteristicsOfCat.Ref = Goods.Characteristic)
		|WHERE
		|	Goods.Ref = &Ref
		|
		|INDEX BY
		|	Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
		|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
		|	InventoryKinds.Package AS Package,
		|	InventoryKinds.NumberOfPackages AS NumberOfPackages,
		|	InventoryKinds.Count AS Count,
		|	InventoryKinds.VATRate AS VATRate,
		|	InventoryKinds.VATAmount AS VATAmount,
		|	InventoryKinds.CCDNumber AS CCDNumber,
		|	InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
		|	InventoryKinds.Ref.ToReturnReusablePackage AS ToReturnReusablePackage,
		|	CAST(CASE
		|			WHEN InventoryKinds.Ref.PriceIncludesVAT
		|				THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
		|			ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
		|		END AS NUMBER(31, 2)) AS Price,
		|	CASE
		|		WHEN InventoryKinds.Ref.PriceIncludesVAT
		|			THEN InventoryKinds.AmountIncludingVAT
		|		ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
		|	END AS Sum,
		|	CASE
		|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	InventoryKinds.RowID AS RowID,
		|	CASE
		|		WHEN InventoryKinds.ManualDiscount > 0
		|			THEN InventoryKinds.ManualDiscount
		|		WHEN InventoryKinds.DiscountMarkupAmount > 0
		|			THEN InventoryKinds.DiscountMarkupAmount
		|	END AS DiscountAmount,
		|	CASE
		|		WHEN &UploadingOrdersIsSupported
		|				AND &SalesAgainstSeveralOrders 
		|				AND InventoryKinds.SalesOrder REFS Document.SalesOrder
		|			THEN InventoryKinds.SalesOrder
		|		ELSE UNDEFINED
		|	END AS OrderDocument,
		|	InventoryKinds.ExciseTaxAmount AS ExciseTaxAmount
		|INTO InventoryKinds
		|FROM
		|	Document.CustomerInvoice.InventoryKinds AS InventoryKinds
		|WHERE
		|	InventoryKinds.Ref = &Ref
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
		|	AND InventoryKinds.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|	SELECT DISTINCT
		|		GoodsTable.Products AS Products,
		|		GoodsTable.Characteristic AS Characteristic,
		|		MAX(GoodsTable.DiscountPercentage) AS DiscountPercentage,
		|		MAX(GoodsTable.DiscountAmount) AS DiscountAmount,
		|		MAX(GoodsTable.AmountOfBonusPoints) AS AmountOfBonusPoints,
		|		GoodsTable.Series AS Series
		|	INTO VT_BonusesAndDiscounts
		|	FROM
		|		GoodsTable AS GoodsTable
		|	
		|	GROUP BY
		|		GoodsTable.Products,
		|		GoodsTable.Characteristic,
		|		GoodsTable.Series
		|	;
	  	|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.Products AS Products,
		|	GoodsTable.Characteristic AS Characteristic,
		|	CASE
		|		WHEN GoodsTable.CharacteristicName = """"
		|			THEN GoodsTable.NomenclatureName
		|		ELSE GoodsTable.NomenclatureName + "" ("" + GoodsTable.CharacteristicName + "")""
		|	END AS Content,
		|	GoodsTable.Products.Principal AS PrincipalLink,
		|	CASE
		|		WHEN GoodsTable.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByCompanyOnAgencyBasis)
		|				OR GoodsTable.Products.AccountingFeature = VALUE(Enum.ItemAccountingFeatures.PerformedByPartner)
		|			THEN ""Agency""
		|		ELSE ""Own""
		|	END AS ServiceType,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.OrderDocument AS OrderDocument,
		|	GoodsTable.Price AS Price,
		|	GoodsTable.VATRate AS VATRate,
		|	GoodsTable.Sum AS Sum,
		|	GoodsTable.VATAmount AS VATAmount,
		|	GoodsTable.DiscountPercentage AS DiscountPercentage,
		|	GoodsTable.DiscountAmount AS DiscountAmount,
		|	GoodsTable.AmountOfBonusPoints AS AmountOfBonusPoints,
		|	GoodsTable.RowID AS RowID,
		|	GoodsTable.LineNumber AS DocumentRowNumber
		|FROM
		|	GoodsTable AS GoodsTable
		|WHERE
		|	(GoodsTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.OperationService)
		|			OR GoodsTable.ProductsTypeOfProducts = VALUE(Enum.ItemsTypes.Work_5))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.Products AS Products,
		|	MAX(GoodsTable.LineNumber) AS LineNumber
		|INTO TablesProductsByMaxRow
		|FROM
		|	GoodsTable AS GoodsTable
		|
		|GROUP BY
		|	GoodsTable.Products
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.Products AS Products,
		|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextPackage,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	NestedQuery.VATRate AS VATRate,
		|	NestedQuery.InventoryType AS InventoryType,
		|	NestedQuery.DocumentRowNumber AS DocumentRowNumber,
		|	NestedQuery.Price AS Price,
		|	NestedQuery.Count AS Count,
		|	NestedQuery.Sum AS Sum,
		|	NestedQuery.VATAmount AS VATAmount,
		|	NestedQuery.DiscountAmount AS DiscountAmount,
		|	VT_BonusesAndDiscounts.DiscountPercentage AS DiscountPercentage,
		|	VT_BonusesAndDiscounts.AmountOfBonusPoints AS AmountOfBonusPoints,
		|	NestedQuery.RowID AS RowID,
		|	NestedQuery.OrderDocument AS OrderDocument,
		|	NestedQuery.ExciseTaxAmount AS ExciseTaxAmount
		|FROM
		|	(SELECT
		|		InventoryKinds.Products AS Products,
		|		InventoryKinds.UnitOfMeasure AS UnitOfMeasure,
		|		InventoryKinds.Characteristic AS Characteristic,
		|		InventoryKinds.Series AS Series,
		|		InventoryKinds.Package AS Package,
		|		InventoryKinds.NumberOfPackages AS NumberOfPackages,
		|		InventoryKinds.VATRate AS VATRate,
		|		InventoryKinds.CCDNumber AS CCDNumber,
		|		CASE
		|			WHEN InventoryKinds.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|					AND InventoryKinds.ToReturnReusablePackage
		|				THEN ""ReturnContainers""
		|			ELSE InventoryKinds.InventoryType
		|		END AS InventoryType,
		|		ISNULL(RowOrderOfGoodsTable.LineNumber, 0) AS DocumentRowNumber,
		|		CAST(InventoryKinds.Price AS NUMBER(31, 2)) AS Price,
		|		SUM(InventoryKinds.Count) AS Count,
		|		SUM(InventoryKinds.QuantityByGBRN) AS QuantityByGBRN,
		|		SUM(CAST(InventoryKinds.Sum AS NUMBER(31, 2))) AS Sum,
		|		SUM(InventoryKinds.VATAmount) AS VATAmount,
		|		InventoryKinds.RowID AS RowID,
		|		SUM(InventoryKinds.DiscountAmount) AS DiscountAmount,
		|		InventoryKinds.OrderDocument AS OrderDocument,
		|		InventoryKinds.ExciseTaxAmount AS ExciseTaxAmount
		|	FROM
		|		InventoryKinds AS InventoryKinds
		|			LEFT JOIN TablesProductsByMaxRow AS RowOrderOfGoodsTable
		|			ON InventoryKinds.Products = RowOrderOfGoodsTable.Products
		|	
		|	GROUP BY
		|		InventoryKinds.Products,
		|		InventoryKinds.Characteristic,
		|		InventoryKinds.UnitOfMeasure,
		|		InventoryKinds.VATRate,
		|		InventoryKinds.Price,
		|		InventoryKinds.CCDNumber,
		|		CASE
		|			WHEN InventoryKinds.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|					AND InventoryKinds.ToReturnReusablePackage
		|				THEN ""ReturnContainers""
		|			ELSE InventoryKinds.InventoryType
		|		END,
		|		ISNULL(RowOrderOfGoodsTable.LineNumber, 0),
		|		InventoryKinds.Series,
		|		InventoryKinds.Package,
		|		InventoryKinds.NumberOfPackages,
		|		InventoryKinds.OrderDocument,
		|		InventoryKinds.RowID,
		|		InventoryKinds.ExciseTaxAmount) AS NestedQuery
		|		LEFT JOIN VT_BonusesAndDiscounts AS VT_BonusesAndDiscounts
		|		ON (NestedQuery.Products = VT_BonusesAndDiscounts.Products
		|				AND NestedQuery.Characteristic = VT_BonusesAndDiscounts.Characteristic
		|				AND NestedQuery.Series = VT_BonusesAndDiscounts.Series
		|				AND VT_BonusesAndDiscounts.DiscountAmount = NestedQuery.DiscountAmount)
		|
		|ORDER BY
		|	DocumentRowNumber; 
		|
		|////////////////////////////////////////////////////////////////////////////////
	        |
		|	SELECT
		|		SUM(CASE
		|			WHEN VALUETYPE(GoodsTable.SalesOrder) = TYPE(Document.GoodsShipmentToCustomer)
		|				THEN 1
		|			ELSE 0
		|		END) AS NumberOfShipments
		|	FROM
		|		GoodsTable AS GoodsTable
		|";
	
	FillInYourOwnProductsInText(GoodsAndServicesOfDocument);
	
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "NestedQuery"));
		
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "NestedQuery"));
		
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "NestedQuery"));
	
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "NestedQuery"));
	
	GoodsAndServicesOfDocument = StrReplace(GoodsAndServicesOfDocument, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "NestedQuery"));
	#Region PackagingMarkings
	
	QueryTextPackagingMarkings =
		"SELECT
		|	CustomerInvoicePackageBarcodes.LineNumber AS DocumentRowNumber,
		|	CustomerInvoicePackageBarcodes.PackageBarcode AS PackageBarcode
		|INTO TTBarcodesOfPackages
		|FROM
		|	Document.CustomerInvoice.PackageBarcodes AS CustomerInvoicePackageBarcodes
		|WHERE
		|	&UnloadingBarcodesOfPackages
		|	AND CustomerInvoicePackageBarcodes.Ref = &Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTBarcodesOfPackages.DocumentRowNumber AS DocumentRowNumber,
		|	TTBarcodesOfPackages.PackageBarcode AS PackageMarking
		|FROM
		|	TTBarcodesOfPackages AS TTBarcodesOfPackages
		|";
	
	#EndRegion
	
	Query = New Query;
	Query.Text = DocumentHeader + Common.QueryBatchSeparator() 
		+ OperationData + Common.QueryBatchSeparator() 
		+ GoodsAndServicesOfDocument + Common.QueryBatchSeparator()
		+ QueryTextPackagingMarkings;
		
	Query.SetParameter("Ref",                     IBData.Ref);
	Query.SetParameter("Date",                       IBData.Date);
	Query.SetParameter("BaseCurrency",              CurrencyOfComplianceAccounting);
	Query.SetParameter("UnloadingBarcodesOfPackages", UnloadingBarcodesOfPackages(ExchangeComponents)); 
	Query.SetParameter("UploadingOrdersIsSupported", IBData.OrderSales And UploadingOrdersIsSupported);
	Query.SetParameter("SalesAgainstSeveralOrders", IBData.OrderSales
		And Not ValueIsFilled(IBData.SalesOrder));
	
	QueryResults = Query.ExecuteBatch();
	
	OperationData = QueryResults[1].Select();
	
	If OperationData.Next() Then
		XDTOData.Insert("TransactionRate",      OperationData.TransactionRate);
		XDTOData.Insert("Multiplier_", OperationData.Multiplier_);
	EndIf;
	
	OtherServices = QueryResults[5].Unload();
	TabProducts = QueryResults[7].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, TabProducts);
	TableOfServicesForPrincipal(ExchangeComponents, OtherServices);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(TabProducts, False);
		 RedefineVATRateForOldFormats(OtherServices, False);
	EndIf;
	
	XDTOData.Insert("Goods", TabProducts);
	XDTOData.Insert("Services", OtherServices);
	If IBData.OrderSales And Not ValueIsFilled(IBData.SalesOrder) Then
		TSNumberOfShipments = QueryResults[8].Unload();
		NumberOfShipmentsOfGoodsToCustomer = TSNumberOfShipments[0].NumberOfShipments;
	ElsIf IBData.OrderSales And ValueIsFilled(IBData.SalesOrder)
		And TypeOf(IBData.SalesOrder) = Type("DocumentRef.GoodsShipmentToCustomer") Then
		NumberOfShipmentsOfGoodsToCustomer = 1;
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods Then
		  NumberOfShipmentsOfGoodsToCustomer = 1;
	EndIf;
		
	XDTOData.KeyProperties.Insert("NumberOfShipmentsOfGoodsToCustomer", NumberOfShipmentsOfGoodsToCustomer);
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		FillInSeriesAccordingToDocument(IBData.Ref, "Document.CustomerInvoice.SetOfSeries", XDTOData);
	EndIf;
EndProcedure

Procedure AddPCO_Document_SaleOfGoodsAndServicesFee_Shipment(ConversionRules)
	ConversionRule = DataExchangeXDTOServer.InitializeObjectConversionRule(ConversionRules);
	ConversionRule.OCRName            = "Document_SaleOfGoodsAndServicesFee_Shipment";
	ConversionRule.DataObject      = Metadata.Documents.CustomerInvoice;
	ConversionRule.FormatObject     = "Документ.ОтчетКомиссионера"; //@NON-NLS-1
	ConversionRule.OnSendData = "PCO_Document_SaleOfGoodsAndServicesFee_Sending_WhenSendingData";
	HeaderProperties = ConversionRule.Properties;
	AddPCR(HeaderProperties, "Currency",                         "Currency", , "Catalog_Currencies");
	AddPCR(HeaderProperties, "ARAPCurrency",           "ARAPCurrency", , "Catalog_Currencies");
	AddPCR(HeaderProperties, "",                               "ChiefAccountant", 1, "Catalog_Persons_Send");
	AddPCR(HeaderProperties, "Date",                           "Date");
	AddPCR(HeaderProperties, "DateOfTransferOfTitleToGoods", "DateOfTransferOfTitleToGoods");
	AddPCR(HeaderProperties, "Contract",                        "Contract", , "Catalog_CounterpartyContracts");
	AddPCR(HeaderProperties, "Comment",                    "Comment");
	AddPCR(HeaderProperties, "Counterparty",                     "Counterparty", , "Catalog_Counterparties");
	AddPCR(HeaderProperties, "",                               "Multiplier_", 1);
	AddPCR(HeaderProperties, "",                               "TransactionRate", 1);
	AddPCR(HeaderProperties, "Number",                          "Number");
	AddPCR(HeaderProperties, "Organization",                    "Organization", , "Catalog_Companies_Send");
	AddPCR(HeaderProperties, "",                               "Department", 1, "Catalog_Departments_Send");
	AddPCR(HeaderProperties, "",                               "Director", 1, "Catalog_Persons_Send");
	AddPCR(HeaderProperties, "DocumentAmount",                 "Sum");
	AddPCR(HeaderProperties, "BusinessOperation",          "TypeOfOperationOfCommissionaireSReport", , "TypeOfOperationOfReportsOfCommissioners");
	AddPCR(HeaderProperties, "PriceIncludesVAT",                "AmountIncludesVAT");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "AdditionalAttributes");
	AddPCR(PropertiesOfTS, "", "PropertyValue", 1);
	AddPCR(PropertiesOfTS, "", "Property", 1, "Catalog_AdditionalAttributes");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "Buyers");
	AddPCR(PropertiesOfTS, "", "SetSF", 1);
	AddPCR(PropertiesOfTS, "", "InvoiceDate", 1);
	AddPCR(PropertiesOfTS, "", "ContractOfBuyerOfCommissionGoods", 1, "Catalog_CounterpartyContracts");
	AddPCR(PropertiesOfTS, "", "RowKey", 1);
	AddPCR(PropertiesOfTS, "", "InvoiceNumber", 1);
	AddPCR(PropertiesOfTS, "", "Customer", 1, "Catalog_Counterparties");
	AddPCR(PropertiesOfTS, "", "TaxInvoice", 1, "Document_InvoiceToCommissionAgent_Sending");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "ProductBatchIDInformation");
	AddPCR(PropertiesOfTS, "", "UnitOfProductBatchID", 1, "Catalog_UnitsOfMeasurement");
	AddPCR(PropertiesOfTS, "", "RowID", 1);
	AddPCR(PropertiesOfTS, "", "Count", 1);
	AddPCR(PropertiesOfTS, "", "NumberOfRNPT", 1);
	AddPCR(PropertiesOfTS, "", "ProductName", 1);
	AddPCR(PropertiesOfTS, "", "Products", 1, "Catalog_Products_Send");
	AddPCR(PropertiesOfTS, "", "PRODUCTBATCHID", 1, "Catalog_CCDNumbers_Send");
	AddPCR(PropertiesOfTS, "", "AmountOfProductBatchID", 1);
	AddPCR(PropertiesOfTS, "", "Package", 1, "Catalog_Packages");
	
	PropertiesOfTS = AddPKTCH(ConversionRule, "", "Goods");
	AddPCR(PropertiesOfTS, "", "UnitOfMeasure", 1, "Catalog_UnitsOfMeasurement");
	AddPCR(PropertiesOfTS, "", "UnitOfTraceability", 1, "Catalog_UnitsOfMeasurement");
	AddPCR(PropertiesOfTS, "", "RowID", 1);
	AddPCR(PropertiesOfTS, "", "RowKey", 1);
	AddPCR(PropertiesOfTS, "", "Count", 1);
	AddPCR(PropertiesOfTS, "", "NumberOfRNPT", 1);
	AddPCR(PropertiesOfTS, "", "NumberOfPackages", 1);
	AddPCR(PropertiesOfTS, "", "Products", 1, "Catalog_Products_Send");
	AddPCR(PropertiesOfTS, "", "CCDNumber", 1, "Catalog_CCDNumbers_Send");
	AddPCR(PropertiesOfTS, "", "DocumentRowNumber", 1);
