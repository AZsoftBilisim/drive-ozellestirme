Procedure PCO_Document_PUPAThroughAccountablePerson_Sending_WhenSendingData(IBData, XDTOData, ExchangeComponents, ExportStack)
	Prefix = "S";
	Number = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	XDTOData.KeyProperties.Insert("Number", Number);	
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_PUPAThroughAccountablePerson_Sending", 
										"OtherExpenses", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
	EndIf;
	UnloadDivision(IBData, XDTOData);
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, , , "VATTaxationOfSeller");
	
	CurrencyOfComplianceAccounting = LocalAccountingCurrency(IBData.Organization);
	
	If IBData.Currency = CurrencyOfComplianceAccounting
		Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
		XDTOData.Insert("DocumentCourse",      IBData.Rate);
		XDTOData.Insert("DocumentMultiplicity", IBData.Repetition);
	Else
		UnloadCourseAndMultiplicityOfDocument(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
	EndIf;
	
	Query = New Query(
	"SELECT
	|	Expenses.Ref.IncomingDocumentDate 		AS IncomingDocumentDate,
	|	Expenses.Ref.IncomingDocumentNumber		AS IncomingDocumentNumber,
	|	Expenses.Ref.ExternalDocumentName AS ExternalDocumentName,
	|	Expenses.Ref.Counterparty AS Vendor,
	|	Expenses.Content 							AS Content,
	|	Expenses.Sum 								AS Sum,
	|	Expenses.VATRate                          	AS VATRate,
	|	Expenses.VATAmount 							AS VATAmount,
	|	Expenses.Department AS Department,
	|	Expenses.ExpenseItem AS ExpenseItem,
	|	Expenses.GLAccountSettings.GLAccount AS GLAccount
	|FROM
	|	Document.VendorInvoiceServicesAndAssets.Expenses AS Expenses
	|WHERE
	|	Expenses.Ref = &Ref");
	
	Query.SetParameter("Ref", IBData.Ref);
		
	Tobacco_0 = Query.Execute().Unload();
	Tobacco_0.Columns.Add("CostDivision");
	Tobacco_0.Columns.Add("CostAccount");
	Tobacco_0.Columns.Add("CostItem");
	For Each LineOther In Tobacco_0 Do
		If ValueIsFilled(LineOther.Department) Then
			StructureDivision = New Structure();
			UnloadDivision(IBData, StructureDivision, LineOther.Department);
			LineOther.CostDivision = StructureDivision.Department;
		EndIf;
		
		CostAccount = AccountingInvoiceForArticle(LineOther.ExpenseItem, IBData.Organization, LineOther.Department,
			IBData.Date, LineOther.GLAccount);
	
		If TypeOf(LineOther.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.ExpenseItems") Then
			LineOther.CostItem = LineOther.ExpenseItem;
		ElsIf TypeOf(LineOther.ExpenseItem) = Type("ChartOfCharacteristicTypesRef.AssetLiabilityItems") Then
			LineOther.CostItem = LineOther.ExpenseItemAssetsLiabilities;
		EndIf;
		
		LineOther.CostAccount = CostAccount;
	
	EndDo;
	
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Tobacco_0, "PurchaseForActivity", "PurchaseForActivity");
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(Tobacco_0, False);
	EndIf;
	XDTOData.Insert("OtherExpenses", Tobacco_0);
	
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

