	Goods.FillValues(IBData.IncomingDocumentDate,         "IncomingDocumentDate");
	Goods.FillValues(IBData.ExternalDocumentName, "ExternalDocumentName");
	
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods);
	
	// Services
	Services = AdvancedInformationSecurityData.Services;
	Services.Columns.Add("Vendor");
	Services.Columns.Add("InvIsSubmitted");
	Services.Columns.Add("InvoiceDate");
	Services.Columns.Add("InvoiceNumber");
	Services.Columns.Add("IncomingDocumentNumber");
	Services.Columns.Add("IncomingDocumentDate");
	Services.Columns.Add("ExternalDocumentName");
	
	Services.FillValues(IBData.Counterparty,                     "Vendor");
	Services.FillValues(IBData.IncomingDocumentNumber,        "IncomingDocumentNumber");
	Services.FillValues(IBData.IncomingDocumentDate,         "IncomingDocumentDate");
	Services.FillValues(IBData.ExternalDocumentName, "ExternalDocumentName");
	
	
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "PurchaseForActivity", "PurchaseForActivity");
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Services, "PurchaseForActivity", "PurchaseForActivity");
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		RedefineVATRateForOldFormats(Goods, False);
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		RedefineVATRateForOldFormats(Services, False);
	EndIf;
	XDTOData.Insert("Goods",        Goods);
	XDTOData.Insert("OtherExpenses", Services);
	
