Procedure OCR_Document_LoanAndDepositInterestCharge_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted    = True;
	
	ContractKind = Undefined;
	If XDTOData.Property("OperationKind") And ValueIsFilled(XDTOData.OperationKind) Then
		OperationKind = XDTOData.OperationKind.Value;
		If OperationKind = "LoansReceived_" Then
			ContractKind = Enums.ContractKindsOfFinancialInstruments.LoanOrBorrowing;
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.LoansInterestCharge;
		ElsIf OperationKind = "Deposits" Then
			ContractKind = Enums.ContractKindsOfFinancialInstruments.Deposit;
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.DepositInterestCharge;
		ElsIf OperationKind = "LoansReceived" Then
			ContractKind = Enums.ContractKindsOfFinancialInstruments.IssuedBorrowing;
			ReceivedData.BusinessOperation = Enums.BusinessTransactions.IssuedBorrowingsInterestCharge;
		EndIf;
	EndIf;
	
	MatchingNatureOfContractType = New Map;
	MatchingNatureOfContractType.Insert(Enums.ContractKindsOfFinancialInstruments.LoanOrBorrowing,
		Enums.LoanAndDepositContractTypes.BankLoan);
	MatchingNatureOfContractType.Insert(Enums.ContractKindsOfFinancialInstruments.Deposit,
		Enums.LoanAndDepositContractTypes.DepositWithoutInterestCapitalization);
	MatchingNatureOfContractType.Insert(Enums.ContractKindsOfFinancialInstruments.IssuedBorrowing,
		Enums.LoanAndDepositContractTypes.ExternalLoan);
	
	If XDTOData.Property("Accruals") And ValueIsFilled(XDTOData.Accruals) Then
		FillingRules = New Map;
		FillingRules.Insert("Date", "Date");
		FillingRules.Insert("Counterparty",           "Counterparty");
		FillingRules.Insert("Contract",              "Contract");
		FillingRules.Insert("AmountARAP",  "AmountARAP");
		FillingRules.Insert("ARAPCurrency", "ARAPCurrency");
		
		ArrayOfAccrualLines = New Array;
		For Each String In XDTOData.Accruals Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			ScheduleAmountType = String.ScheduleAmountType.Value;
			If ScheduleAmountType = "Interests" Then
				StringDataStructure.Insert("ScheduleAmountType", Enums.LoanAndDepositScheduleAmountTypes.Interests);
			ElsIf ScheduleAmountType = "Fee" Then
				StringDataStructure.Insert("ScheduleAmountType", Enums.LoanAndDepositScheduleAmountTypes.Fee);
			Else
				StringDataStructure.Insert("ScheduleAmountType", Enums.LoanAndDepositScheduleAmountTypes.PrincipalDebt);
			EndIf;
			
			If StringDataStructure.Property("Contract") Then
				If ValueIsFilled(String.UrgencyOfLoanLoan) Then
					If String.UrgencyOfLoanLoan.Value = "ShortTerm" Then
						PriorityType = Enums.LoanAndDepositPriorityType.ShortTerm;
					Else
						PriorityType = Enums.LoanAndDepositPriorityType.LongTerm;
					EndIf;
					StringDataStructure.Contract.Insert("PriorityType", PriorityType);
				EndIf;
				If ValueIsFilled(ContractKind) Then
					StringDataStructure.Contract.Insert("ContractKind", ContractKind);
					ContractType = MatchingNatureOfContractType.Get(ContractKind);
					StringDataStructure.Contract.Insert("ContractType", ContractType);
				EndIf;
			EndIf;
			
			AddCurrencyToPaymentDecryption(StringDataStructure, String);	
			
			If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
				If ValueIsFilled(String.ExpenseItem) Then
					StringDataStructure.Insert(
						"IncomeAndExpenseItem", 
						New Structure("Value, OCRName", String.ExpenseItem, "Catalog_ExpenseItems"));
				ElsIf ValueIsFilled(String.IncomeItem) Then 
					StringDataStructure.Insert(
						"IncomeAndExpenseItem", 
						New Structure("Value, OCRName", String.IncomeItem, "Catalog_IncomeItems"));
				EndIf;
			EndIf;
			
			ArrayOfAccrualLines.Add(StringDataStructure);
		EndDo;
		
		ReceivedData.AdditionalProperties.Insert("Accruals", ArrayOfAccrualLines);
	EndIf;
EndProcedure
