Procedure OCR_Document_AdjustmentOfGoodsReceipts_Receive_OnConvertXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
		"Document_AdjustmentOfReceiptOfGoods_Receipt", 
		"Goods", 
		"CCDNumber",
		False,
		"Catalog_CCDNumbers_ItemReceive");
	EndIf;
	
	ReceivedData.Posted    = True;
	ReceivedData.Approved  = True;
	ReceivedData.PaymentDate = ReceivedData.Date;
	
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	AddContractToAdditionalProperties(ReceivedData, XDTOData, ExchangeComponents);
	
	DocumentAndData = Undefined;
	OCRName = "";
	XDTOData.Property("CorrectedReceiptDocument", DocumentAndData);
	If DocumentAndData = Undefined Then
		XDTOData.Property("DocumentInflow", DocumentAndData);
	EndIf;
	If DocumentAndData <> Undefined And TypeOf(DocumentAndData) = Type("Structure") Then
		ValueTypeDocument = DocumentAndData.ValueType;
		If Find(ValueTypeDocument, "ПоступлениеТоваровУслуг") Then // @Non-NLS-1
			OCRName = "Document_ReceiptOfGoodsServices_Receipt";
		EndIf; 
	EndIf;
	If OCRName <> "" Then
		ReceivedData.AdditionalProperties.Insert("DocumentBasis", New Structure("Value, OCRName",DocumentAndData,OCRName));
	EndIf;
	
	If XDTOData.OperationKind.Value = "CorrectionOfErrors" Then
		ReceivedData.AdjustmentKind = Enums.BusinessTransactions.ErrorCorrection;
	Else
		ReceivedData.AdjustmentKind = Enums.BusinessTransactions.AdjustmentUnderApprovalOfParties;
	EndIf;
	ReceivedData.AdjustingEntryType = Enums.AdjustingEntryTypes.StandardAdjustment;
	#Region Goods
	
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");
	FillingRules.Insert("Sum",        "Sum");
	FillingRules.Insert("Price",         "Price");
	FillingRules.Insert("VATRate",    "VATRate");
	FillingRules.Insert("VATAmount",     "VATAmount");
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
	EndIf;
	FormatVersionIs17AndHigher = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	ArrayOfRows = New Array;
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then
	
		For Each String In XDTOData.Goods Do
			If Not ValueIsFilled(String.Count) Or String.Count <= 0 Then
				Continue;
			EndIf;
	
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("Count") And StringDataStructure.Count <= 0 Then
				Continue;
			EndIf;
	
			If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
				StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
			EndIf;
	
			If ValueIsFilled(String.CCDNumber) Then
				If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
					StringDataStructure.Insert("CCDNumber", String.CCDNumber);
				Else
					StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
				EndIf;
			EndIf;
	
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount;
			EndIf;
	
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy,FormatVersionIs17AndHigher);
			StringDataStructure.Insert("AmountARAP", String.Sum);
			If StringDataStructure.Property("VATAmount") Then
				StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
			EndIf;
			StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
	
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	// We add services to products.
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
	
		For Each String In XDTOData.Services Do
			StringDataStructure = CollectionDataAsStructure(String, FillingRules);
			If StringDataStructure.Property("Count") And StringDataStructure.Count <= 0 Then
				Continue;
			EndIf;
			AmountIncludingVAT = String.Sum;
			If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
				AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
			EndIf;
	
			StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
			ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
			If ValueIsFilled(String.Content) Then
				StringDataStructure.Insert("Content", String.Content);
			EndIf;
			StringDataStructure.Insert("AmountARAP", String.Sum);
			If StringDataStructure.Property("VATAmount") Then
				StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
			EndIf;
			If Not StringDataStructure.Property("Count") Or StringDataStructure.Count = Undefined Then
				StringDataStructure.Insert("Count", 1); 
			EndIf;	 
			ArrayOfRows.Add(StringDataStructure);
		EndDo;
	EndIf;
	
	If ArrayOfRows.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Goods", ArrayOfRows);
	EndIf;
	
	#EndRegion
	#Region Discrepancies
	FillingRules = New Map;
	FillingRules.Insert("Products", "Products");
	FillingRules.Insert("Count",   "Count");  
	FillingRules.Insert("Sum",        "Sum");  
	FillingRules.Insert("Price",         "Price"); 
	
	FillingRules.Insert("VATRate",    "VATRate");
	
	FillingRules.Insert("VATAmount", "VATAmount"); 
	
	If FOValue("UseItemVariants", ExchangeComponents) Then
		FillingRules.Insert("Characteristic",     "Characteristic");
	EndIf;
	If FOValue("UseItemsBatch", ExchangeComponents) Then
		FillingRules.Insert("Series",              "Series");
	EndIf;
	If FOValue("UseItemPackages", ExchangeComponents) Then
		FillingRules.Insert("Package",           "Package");
		FillingRules.Insert("NumberOfPackages", "NumberOfPackages");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		FillingRules.Insert("NumberOfRNPT", "QuantityByGBRN");
	EndIf;
	ArrayOfLinesDiscrepancy = New Array;
	If XDTOData.Property("Goods")
		And ValueIsFilled(XDTOData.Goods) Then 
		For Each String In XDTOData.Goods Do
			If Not ValueIsFilled(String.Count) And Not ValueIsFilled(String.QuantityBeforeChange_) Then
				Continue;
			EndIf;  	
			If Not ValueIsFilled(String.Count) Then
				String.Count = 0;
			EndIf;  
	
			If Not ValueIsFilled(String.Sum) Then
				String.Sum = 0;
			EndIf;  
	
			If FormatVersionIs17AndHigher And Not String.VATRate.Property("Rate1") Then
				String.VATRate.Insert("Rate1", "0");
			EndIf; 
			If FormatVersionIs17AndHigher 
				And ValueIsFilled(String.VATRateBeforeChange) And Not String.VATRateBeforeChange.Property("Rate1") Then
				String.VATRateBeforeChange.Insert("Rate1", "0");
			EndIf; 
	
			If Not String.ThereIsImplementationReceiptInDocument 
				Or ValueIsFilled(String.VATRateBeforeChange) And (Not FormatVersionIs17AndHigher And String.VATRate.Value <> String.VATRateBeforeChange.Value
				Or FormatVersionIs17AndHigher And String.VATRate.Rate1 <> String.VATRateBeforeChange.Rate1)
				Or Not ((String.CCDNumber = Undefined And String.CCDNumberBeforeChange = Undefined)
				Or (TypeOf(String.CCDNumber) = Type("Structure") And TypeOf(String.CCDNumberBeforeChange) = Type("Structure")
				And (String.CCDNumber.Property("Ref") And String.CCDNumber.Ref.Value = String.CCDNumberBeforeChange.Ref.Value)))
				Or Not ((String.OriginCountry = Undefined And String.CountryOfOriginBeforeChange = Undefined)
				Or (TypeOf(String.OriginCountry) = Type("Structure") And TypeOf(String.OriginCountry) = Type("Structure")
				And (Not String.CountryOfOriginBeforeChange = Undefined And String.OriginCountry.Ref.Value = String.CountryOfOriginBeforeChange.Ref.Value )))
				Then
				// Two lines old minus new plus.
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				If ValueIsFilled(String.CCDNumber) Then
					If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
						StringDataStructure.Insert("CCDNumber", String.CCDNumber);
					Else
						StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
					EndIf;
				EndIf;
				If StringDataStructure.Property("VATRate") And ValueIsFilled(StringDataStructure.VATRate) Then
					StringDataStructure.VATRate = CatalogOfVATRateTransfers(ExchangeComponents, StringDataStructure.VATRate);
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount;
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy,FormatVersionIs17AndHigher);
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
				If Not StringDataStructure.Count = 0 Then
					ArrayOfLinesDiscrepancy.Add(StringDataStructure);
				EndIf;
	
				If Not String.ThereIsImplementationReceiptInDocument Then
					Continue;
				EndIf;
				// Reflect the data before the change with a minus sign.
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				StringDataStructure.Count = (-1) * String.QuantityBeforeChange_;
				If Not StringDataStructure.Property("Sum") Then
					StringDataStructure.Insert("Sum");
				EndIf;
				StringDataStructure.Sum = (-1) * String.AmountBeforeChange;
				If StringDataStructure.Property("VATAmount") And ValueIsFilled(String.VATAmountBeforeChange) Then
					StringDataStructure.VATAmount = (-1) * String.VATAmountBeforeChange;
				EndIf;
				StringDataStructure.VATRate = String.VATRateBeforeChange; 
				If Not StringDataStructure.Property("Price") Then
					StringDataStructure.Insert("Price");
				EndIf;
				StringDataStructure.Price = String.PriceBeforeChange; 
				If StringDataStructure.Property("QuantityByGBRN") Then
					StringDataStructure.QuantityByGBRN = (-1) * String.NumberOfRNPTBeforeChange;
				EndIf;
				If StringDataStructure.Property("NumberOfPackages") Then
					StringDataStructure.NumberOfPackages = (-1) * String.NumberOfPackagesBeforeChange_;
				EndIf;
				If ValueIsFilled(String.CCDNumber) Then
					If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
						StringDataStructure.Insert("CCDNumber", String.CCDNumberBeforeChange);
					Else
						StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumberBeforeChange, String.CountryOfOriginBeforeChange));
					EndIf;
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT - StringDataStructure.VATAmount;
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
			ElsIf String.Count <> String.QuantityBeforeChange_ Or String.Sum <> String.AmountBeforeChange Or String.VATAmount <> String.VATAmountBeforeChange Then
				StringDataStructure = CollectionDataAsStructure(String, FillingRules); 
	
				StringDataStructure.Count = ?(ValueIsFilled(String.Count), 
				String.Count - String.QuantityBeforeChange_, (-1) * String.QuantityBeforeChange_);
				StringDataStructure.Sum = ?(ValueIsFilled(String.Sum), 
				String.Sum - String.AmountBeforeChange, (-1) * String.AmountBeforeChange);
	
				VATAmountBeforeChange = ?(ValueIsFilled(String.VATAmountBeforeChange),String.VATAmountBeforeChange, 0); 
				VATAmount = ?(ValueIsFilled(String.VATAmount), String.VATAmount - VATAmountBeforeChange, (-1) * VATAmountBeforeChange);
	
				StringDataStructure.Insert("VATAmount", VATAmount);
	
				If Not StringDataStructure.Property("Price") Then
				     StringDataStructure.Insert("Price");
				EndIf;
				StringDataStructure.Price = ?(Not String.Price = Undefined, String.Price, 0) - ?(Not String.PriceBeforeChange = Undefined, String.PriceBeforeChange, 0); 
				If StringDataStructure.Property("QuantityByGBRN") Then
					StringDataStructure.QuantityByGBRN = ?(ValueIsFilled(StringDataStructure.QuantityByGBRN), 
					StringDataStructure.QuantityByGBRN- String.NumberOfRNPTBeforeChange, (-1) * String.NumberOfRNPTBeforeChange);
				EndIf;
				If StringDataStructure.Property("NumberOfPackages") Then
					StringDataStructure.NumberOfPackages = ?(ValueIsFilled(StringDataStructure.NumberOfPackages), 
					StringDataStructure.NumberOfPackages - String.NumberOfPackagesBeforeChange_, (-1) * String.NumberOfPackagesBeforeChange_);
				EndIf;
				If ValueIsFilled(String.CCDNumber) Then
					If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
						StringDataStructure.Insert("CCDNumber", String.CCDNumber);
					Else
						StringDataStructure.Insert("CCDNumber", New Structure("CCDNumber, OriginCountry", String.CCDNumber, String.OriginCountry));
					EndIf;
				EndIf;
				AmountIncludingVAT = StringDataStructure.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount;
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
	
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				//Structuredannyhstrings.Insert ("Sum of mutual settlements", Line.Amount);
				StringDataStructure.Insert("AmountARAP", StringDataStructure.AmountIncludingVAT);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				StringDataStructure.Insert("Warehouse", ReceivedData.Warehouse);
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
			Else
				// If there are no changes, we skip them.
				Continue;
			EndIf;
		EndDo;
	EndIf;
	If XDTOData.Property("Services")
		And ValueIsFilled(XDTOData.Services) Then
		For Each String In XDTOData.Services Do
			If FormatVersionIs17AndHigher And Not String.VATRate.Property("Rate1") Then
				String.VATRate.Insert("Rate1", "0");
			EndIf; 
			If FormatVersionIs17AndHigher 
				And ValueIsFilled(String.VATRateBeforeChange) And Not String.VATRateBeforeChange.Property("Rate1") Then
				String.VATRateBeforeChange.Insert("Rate1", "0");
			EndIf; 
			If Not ValueIsFilled(String.Count) Then
				String.Count = 1;
			EndIf;
	
			If Not ValueIsFilled(String.QuantityBeforeChange_) Then
				String.QuantityBeforeChange_ = 0;
			EndIf;
	
			If Not String.ThereIsImplementationReceiptInDocument
				Or ValueIsFilled(String.VATRateBeforeChange) And (Not FormatVersionIs17AndHigher And String.VATRate.Value <> String.VATRateBeforeChange.Value
				Or FormatVersionIs17AndHigher And String.VATRate.Rate1 <> String.VATRateBeforeChange.Rate1)
				Or String.Content <> String.ContentBeforeChange Then
				// Two lines old minus new plus.
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				If ValueIsFilled(String.Content) Then
					StringDataStructure.Insert("Content", String.Content);
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				If ValueIsFilled(String.Content) Then
					StringDataStructure.Insert("Content", String.Content);
				EndIf;
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				ArrayOfLinesDiscrepancy.Add(StringDataStructure); 
	
				If Not String.ThereIsImplementationReceiptInDocument Then
					Continue;
				EndIf;
	
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				Count =  (-1) * ?(String.QuantityBeforeChange_ = Undefined, 0,String.QuantityBeforeChange_);
				Sum = (-1) * ?(String.AmountBeforeChange = Undefined, 0,String.AmountBeforeChange);
				Price = ?(String.PriceBeforeChange = Undefined, 0,String.PriceBeforeChange);
				StringDataStructure.Insert("Count", Count);
				StringDataStructure.Insert("Sum", Sum);
				StringDataStructure.Insert("Price", Price);
				If StringDataStructure.Property("VATAmount") And ValueIsFilled(String.VATAmountBeforeChange) Then
					StringDataStructure.VATAmount = (-1) * String.VATAmountBeforeChange;
				EndIf;
				StringDataStructure.VATRate = String.VATRateBeforeChange;
				StringDataStructure.Price = String.PriceBeforeChange; 
				If ValueIsFilled(String.ContentBeforeChange) Then
					StringDataStructure.Insert("Content", String.ContentBeforeChange);
				EndIf;
				AmountIncludingVAT = String.Sum;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				If ValueIsFilled(String.Content) Then
					StringDataStructure.Insert("Content", String.Content);
				EndIf;
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
			ElsIf String.Count <> ?(ValueIsFilled(String.QuantityBeforeChange_), String.QuantityBeforeChange_, 0) Or String.Sum <> String.AmountBeforeChange Or String.VATAmount <> String.VATAmountBeforeChange Then
				StringDataStructure = CollectionDataAsStructure(String, FillingRules);
				If ValueIsFilled(String.Count) And ValueIsFilled(String.QuantityBeforeChange_) Then
					StringDataStructure.Count = String.Count - ?(Not String.QuantityBeforeChange_ = Undefined,String.QuantityBeforeChange_, 0);
				EndIf; 
				If StringDataStructure.Property("Sum") Then 
					AmountBeforeChange = ?(String.AmountBeforeChange = Undefined, 0, String.AmountBeforeChange);
					StringDataStructure.Sum = ?(ValueIsFilled(String.Sum),String.Sum - AmountBeforeChange, 0);
					AmountIncludingVAT = String.Sum;
				Else
					AmountIncludingVAT = 0;
				EndIf;
				If StringDataStructure.Property("VATAmount") And String.VATAmountBeforeChange <> Undefined Then
					StringDataStructure.VATAmount = String.VATAmount - ?(ValueIsFilled(String.VATAmountBeforeChange), String.VATAmountBeforeChange, 0); 
				ElsIf StringDataStructure.Property("VATAmount") Then
					StringDataStructure.VATAmount = 0;	
				EndIf;    
				If StringDataStructure.Property("Price") Then
					StringDataStructure.Price = String.Price - ?(ValueIsFilled(String.PriceBeforeChange),String.PriceBeforeChange, 0); 
				EndIf;	
				If ValueIsFilled(String.Content) Then
					StringDataStructure.Insert("Content", String.Content);
				EndIf;
				If StringDataStructure.Property("VATAmount") And Not ReceivedData.PriceIncludesVAT Then
					AmountIncludingVAT = AmountIncludingVAT + StringDataStructure.VATAmount
				EndIf;
	
				StringDataStructure.Insert("AmountIncludingVAT", AmountIncludingVAT);
				ProcessVATRateUponReceipt(ExchangeComponents, String, StringDataStructure, ReceivedData, ExchangeComponents.ConversionParameters_SSLy, FormatVersionIs17AndHigher);
				If ValueIsFilled(String.Content) Then
					StringDataStructure.Insert("Content", String.Content);
				EndIf;
				StringDataStructure.Insert("AmountARAP", String.Sum);
				If StringDataStructure.Property("VATAmount") Then
					StringDataStructure.Insert("AmountVATARAP", StringDataStructure.VATAmount);
				EndIf;
				ArrayOfLinesDiscrepancy.Add(StringDataStructure);
	
			Else
				// If there are no changes, we skip them.
			EndIf;
		EndDo;
	EndIf; 
	If ArrayOfLinesDiscrepancy.Count() > 0 Then
		ReceivedData.AdditionalProperties.Insert("Discrepancies", ArrayOfLinesDiscrepancy);
	EndIf;
	#EndRegion
EndProcedure
Procedure OCR_Document_AdjustmentOfGoodsReceipts_Receive_BeforeWriteReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	FillDefaultWarehouse(ReceivedData, IBData, ExchangeComponents);
	If Not IBData = Undefined Then
		// We transfer those properties that are specified in the PKS
		FillInItemHeaderProperties(PropertiesConversion, ReceivedData, IBData);
	
		// Goods
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("VATRate");
	
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.Goods,
			IBData.Goods,
			KeyFieldsArray,
			Undefined,
			"Count, NumberOfPackages, QuantityByGBRN, Package, Content, Sum, AmountARAP, VATAmount, AmountVATARAP, AmountIncludingVAT, Price, Warehouse");
		IBData.Goods.Load(ReceivedData.Goods.Unload());
	
		// Discrepancies
		KeyFieldsArray = New Array;
		KeyFieldsArray.Add("Products");
		KeyFieldsArray.Add("Characteristic");
		KeyFieldsArray.Add("Series");
		KeyFieldsArray.Add("VATRate");
	
		DataExchangeXDTOServer.FillObjectTabularSectionWithInitialData(
			ReceivedData.Discrepancies,
			IBData.Discrepancies,
			KeyFieldsArray,
			Undefined,
			"Count, NumberOfPackages, QuantityByGBRN, Package, Content, Sum, AmountARAP, VATAmount, AmountVATARAP, AmountIncludingVAT, Price, Warehouse");
		IBData.Discrepancies.Load(ReceivedData.Discrepancies.Unload());
		DefaultDepartment = DefaultElement(ExchangeComponents, "Department");
		For Each String In IBData.Goods Do
			If Not ValueIsFilled(String.Department) Then
				String.Department = DefaultDepartment;
			EndIf;
		EndDo;
		ReceivedData = Undefined;
	EndIf;
	
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	DocumentType = "DocumentObject.PurchaseAdjustment";
	CheckResultOfDocumentDataExchange(DataToWriteToIB, ExchangeComponents.CorrespondentNode, DocumentType);
	ToEstablishCancellationOfMechanicalCleaningOfRegisteredRecorded(IBData);
EndProcedure

