		NewRow.DocumentDate    = Object.Date;
		NewRow.DocumentQueue = 1;
		
		FillPropertyValues(NewRow, Object, "CashRegister, Organization, Currency");
	EndIf;
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	// Acquiring terminal in PM paymentpayable cards
	POSTerminal = DefaultElement(ExchangeComponents, "POSTerminal");
	
	For Each String In Object.PaymentWithPaymentCards Do
		If Not ValueIsFilled(String.POSTerminal) Then
			String.POSTerminal = POSTerminal; 
		EndIf;
	EndDo;
	
EndProcedure



Procedure DeferredProcessing_ProcessorReport25(Object, ExchangeComponents)
	FillingInPartnerInDocumentHeader(Object);
	
	If Not ValueIsFilled(Object.PurchaseForActivity) Then
		FillParameters = Documents.SubcontractorReport2_5.ParametersForFillingInVATActivityType(Object);
		VATAccountingERP.FillInTypeOfActivityVAT(
			Object.PurchaseForActivity,
			FillParameters);
	EndIf;
	
	If Object.MethodOfAllocatingFinishedProductCosts = Enums.MethodsOfCostAllocatingOnProductCosts.ByTargetCost Then
		// Let's recalculate the shares according to the planned cost.
		CostAllocationParametersStructure = Documents.SubcontractorReport2_5.CostAllocationParameters(Object);
		CostAllocationParameters = New FixedStructure(CostAllocationParametersStructure);
		
		ProductionServer.CalculateFractionOfCost(Object, CostAllocationParameters);
	EndIf;
	
	For Each TableRow In Object.ManufacturedProducts Do
		If Not ValueIsFilled(TableRow.CostGroupNumber) Then
			TableRow.CostGroupNumber = 1;
		EndIf;
	EndDo;
	
	For Each TableRow In Object.MaterialsAndWorks Do
		If Not ValueIsFilled(TableRow.ProductCostElement) Then
			TableRow.ProductCostElement = DefaultElement(ExchangeComponents, "ArticleOfCalculationMaterialCosts");
		EndIf;
		If Not ValueIsFilled(TableRow.CostGroupNumber) Then
			TableRow.CostGroupNumber = 1;
		EndIf;
	EndDo;
	
	For Each TableRow In Object.Services Do
		If Not ValueIsFilled(TableRow.ProductCostElement) Then
			TableRow.ProductCostElement = DefaultElement(ExchangeComponents, "ArticleCalculationOther");
		EndIf;
		If Not ValueIsFilled(TableRow.CostGroupNumber) Then
			TableRow.CostGroupNumber = 1;
		EndIf;
	EndDo;
EndProcedure

