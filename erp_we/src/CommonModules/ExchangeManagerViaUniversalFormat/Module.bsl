Procedure PCO_Document_PBDSForPaymentCards_Receiving_WhenConvertingXDTOData(XDTOData, ReceivedData, ExchangeComponents)
	ReceivedData.Posted = True;
	FillInDateAndNumberOfIncomingDocument(ReceivedData);
	AddCurrencyToAdditionalProperties(ReceivedData, XDTOData);
	
	NameOfConnectionContractProperty = NameOfContractForConnectingToPaymentSystemProperty(ExchangeComponents.ExchangeFormatVersion);
	
	If XDTOData.Property("CounterpartyContract")
		And ValueIsFilled(XDTOData.CounterpartyContract) 
		And XDTOData.CounterpartyContract.Property(NameOfConnectionContractProperty) 
		And XDTOData.CounterpartyContract[NameOfConnectionContractProperty] = True Then
		
		ConnectionContractInstructions = New Structure("Value, OCRName", XDTOData.CounterpartyContract, "Catalog_AcquiringContracts_Receive");
		
		ReceivedData.AdditionalProperties.Insert("AcquiringContract", ConnectionContractInstructions);
		
	EndIf;
	
	ReceivedData.ProcessedByBank = ValueIsFilled(ReceivedData.BankPostingDate);
	ReceivedData.BusinessOperation = Enums.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment;
	UploadAdditionalBankingDetails_(ReceivedData, XDTOData, ExchangeComponents);
	
	// ARAPDetails
	ArrayOfStringsDecryption = New Array;
	For Each String In XDTOData.ARAPDetails Do
		
		FillingRules = New Map;
		
		FillingRules.Insert("Sum", "Sum");
		FillingRules.Insert("AmountARAP", "AmountARAP");
		FillingRules.Insert("CFItem", "CashFlowItem");
		StringDataStructure = CollectionDataAsStructure(String, FillingRules);
		AddCurrencyToPaymentDecryption(StringDataStructure, String);
		ArrayOfStringsDecryption.Add(StringDataStructure);
		If XDTOData.ARAPDetails.Count() = 1 Then
			ReceivedData.AdditionalProperties.Insert("CashFlowItem", String.CFItem);
		EndIf;
		
	EndDo;
	ReceivedData.AdditionalProperties.Insert("ARAPDetails", ArrayOfStringsDecryption);
EndProcedure
Procedure PCO_Document_PBDSForPaymentCards_Receipt_BeforeRecordingReceivedData(ReceivedData, IBData, PropertiesConversion, ExchangeComponents)
	If IsThereFixOrReverse(IBData, ReceivedData, ExchangeComponents) Then
		Return;
	EndIf;
	
	BeforeMerzhevanii_PBDS(ReceivedData, IBData, ExchangeComponents);
	Merzhevanie_PBDS(ReceivedData, IBData, PropertiesConversion, ExchangeComponents);
	AfterMerzhevaniya_PBDS(ReceivedData, IBData, ExchangeComponents);
	
	ReceivedData = ?(IBData = Undefined, ReceivedData, Undefined);
	
	//Search for a Contract for connecting to the payment system
	DataToWriteToIB = ?(IBData = Undefined, ReceivedData, IBData);
	
	If Not ValueIsFilled(DataToWriteToIB.AcquiringContract) Then
	
		Query = New Query("SELECT
				|	AcquiringContracts.Ref AS Ref
				|FROM
				|	Catalog.AcquiringContracts AS AcquiringContracts
				|WHERE
				|	AcquiringContracts.Counterparty = &Counterparty
				|	AND AcquiringContracts.BankAccount = &BankAccount
				|");
		Query.SetParameter("Counterparty",     DataToWriteToIB.Counterparty);
		Query.SetParameter("BankAccount", DataToWriteToIB.BankAccount);
		
		Selection = Query.Execute().Select();
		If Selection.Count() = 1 Then
			Selection.Next();
			DataToWriteToIB.AcquiringContract = Selection.Ref;
		EndIf;
	
	EndIf;
EndProcedure

