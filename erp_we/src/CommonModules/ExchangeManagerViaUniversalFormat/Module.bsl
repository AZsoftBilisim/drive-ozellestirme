	ProcessingRule.OnProcess            = "DPR_Document_BackflushProduction_Send_OnProcess";
	ProcessingRule.DataClearing           = False;
	ProcessingRule.OCRUsed.Add("Document_ProductionWithoutOrder_Sending");
	ProcessingRule.OCRUsed.Add("Document_ProductionWithoutOrder_InventoryWriteOff");
EndProcedure
Procedure DPR_Document_BackflushProduction_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	If IBData.InternalSubcontracting Then
	     SetUsageOCR(UsageOCR, False);
		 Return;
	EndIf;	
	UseTargetCost = False;
	
	PolicySettings = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate("FinancialAccountingPolicy", 
																										IBData.Organization, 
																										IBData.Date);
	If PolicySettings <> Undefined Then
		UseTargetCost = PolicySettings.ProductCostingByPlannedCost;
	EndIf;
	
	Query = New Query;
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Date);
	Query.SetParameter("UseTargetCost", UseTargetCost);
	Query.SetParameter("TypeOfPricePlannedCost", ProductionServerCached.TypeOfPricePlannedCost_());
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	
	QueryText = 
		"SELECT
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.LineNumber AS LineNumber,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Products AS Products,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Series AS Series,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|	Warehouses.Ref AS Warehouse,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.Count AS Count,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.CostShare AS CostShare,
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.Ref.Currency AS DocumentCurrency,
		|	ISNULL(BackflushProductionInventoryOwnerAttributesFinishedProducts.Ref.PriceKind.PriceCurrency, VALUE(Catalog.Currencies.EmptyRef)) AS PriceCurrency,
		|	CASE
		|		WHEN BackflushProductionInventoryOwnerAttributesFinishedProducts.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType
		|INTO TTManufacturedProduct
		|FROM
		|	Document.BackflushProduction.InventoryOwnerAttributesFinishedProducts AS BackflushProductionInventoryOwnerAttributesFinishedProducts
		|		LEFT JOIN Catalog.Warehouses AS Warehouses
		|		ON BackflushProductionInventoryOwnerAttributesFinishedProducts.Recipient = Warehouses.Ref
		|		LEFT JOIN Document.BackflushProduction.ManufacturedProducts AS BackflushProductionManufacturedProducts
		|		ON (BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Products = BackflushProductionManufacturedProducts.Products
		|				AND BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Characteristic = BackflushProductionManufacturedProducts.Characteristic
		|				AND BackflushProductionInventoryOwnerAttributesFinishedProducts.ItemsLocationAttributes.Series = BackflushProductionManufacturedProducts.Series)
	      	|WHERE
		|	BackflushProductionInventoryOwnerAttributesFinishedProducts.Ref = &Ref
		|	AND NOT ISNULL(Warehouses.ShopFloorStockroom, FALSE)
		|	AND NOT BackflushProductionManufacturedProducts.InternalSubcontracting
		|	AND BackflushProductionManufacturedProducts.Ref = &Ref
	      	|
		|UNION
		|
		|SELECT
		|	BackflushProductionManufacturedProducts.LineNumber,
		|	BackflushProductionManufacturedProducts.ItemsLocationAttributes.Products,
		|	BackflushProductionManufacturedProducts.ItemsLocationAttributes.Characteristic,
		|	BackflushProductionManufacturedProducts.ItemsLocationAttributes.Series,
		|	BackflushProductionManufacturedProducts.ItemsLocationAttributes.Products.UnitOfMeasure,
		|	BackflushProductionManufacturedProducts.DirectionOfProductionIssue,
		|	Warehouses.Ref,
		|	BackflushProductionManufacturedProducts.Count,
		|	BackflushProductionManufacturedProducts.CostShare,
		|	BackflushProductionManufacturedProducts.Ref.Currency,
		|	ISNULL(BackflushProductionManufacturedProducts.Ref.PriceKind.PriceCurrency, VALUE(Catalog.Currencies.EmptyRef)),
		|	CAST(""FinishedProducts"" AS STRING(20))
		|FROM
		|	Document.BackflushProduction.ManufacturedProducts AS BackflushProductionManufacturedProducts
		|		LEFT JOIN Catalog.Warehouses AS Warehouses
		|		ON BackflushProductionManufacturedProducts.Recipient = Warehouses.Ref
		|WHERE
		|	BackflushProductionManufacturedProducts.Ref = &Ref
		|	AND NOT ISNULL(Warehouses.ShopFloorStockroom, FALSE)
		|	AND BackflushProductionManufacturedProducts.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
		|
		|INDEX BY
		|	Products,
		|	Characteristic
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.LineNumber AS DocumentRowNumber,
		|	NestedQuery.Products AS Products,
		|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
		|	NestedQuery.Characteristic AS Characteristic,
		|	NestedQuery.Series AS Series,
		|	NestedQuery.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|	NestedQuery.Warehouse AS Warehouse,
		|	NestedQuery.Count AS Count,
		|	NestedQuery.InventoryType AS InventoryType,
		|	CAST(NestedQuery.Price / ISNULL(&QueryTextPackagingFactor, 1) AS NUMBER(31, 2)) AS Price,
		|	(CAST(NestedQuery.Price / ISNULL(&QueryTextPackagingFactor, 1) AS NUMBER(31, 2))) * NestedQuery.Count AS Sum
		|INTO TTProductsWithValue
		|FROM
		|	(SELECT
		|		TTProducts_1.LineNumber AS LineNumber,
		|		TTProducts_1.Products AS Products,
		|		TTProducts_1.UnitOfMeasure AS UnitOfMeasure,
		|		TTProducts_1.Characteristic AS Characteristic,
		|		TTProducts_1.Series AS Series,
		|		TTProducts_1.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|		TTProducts_1.Warehouse AS Warehouse,
		|		TTProducts_1.Count AS Count,
		|		TTProducts_1.InventoryType AS InventoryType,
		|		ItemPricesCrossSectionOfTheLatest.Package AS PricePackaging,
		|		ISNULL(ItemPricesCrossSectionOfTheLatest.Price, 0) * CASE
		|			WHEN TTProducts_1.DocumentCurrency = VALUE(Catalog.Currencies.EmptyRef)
		|					OR TTProducts_1.PriceCurrency = VALUE(Catalog.Currencies.EmptyRef)
		|				THEN 0
		|			WHEN TTProducts_1.DocumentCurrency = TTProducts_1.PriceCurrency
		|				THEN 1
		|			ELSE CurrencyRatesPrices.CourseNumerator * DocumentCurrencyRates.CourseDenominator / (DocumentCurrencyRates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|		END AS Price
		|	FROM
		|		TTManufacturedProduct AS TTProducts_1
		|			LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&Date, PriceKind = &TypeOfPricePlannedCost) AS ItemPricesCrossSectionOfTheLatest
		|			ON TTProducts_1.Products = ItemPricesCrossSectionOfTheLatest.Products
		|				AND TTProducts_1.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic
		|				AND (&UseTargetCost)
		|			LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS DocumentCurrencyRates
		|			ON (&UseTargetCost)
		|				AND TTProducts_1.DocumentCurrency = DocumentCurrencyRates.Currency
		|			LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS CurrencyRatesPrices
		|			ON (&UseTargetCost)
		|				AND TTProducts_1.PriceCurrency = CurrencyRatesPrices.Currency
		|	WHERE
		|		NOT TTProducts_1.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)) AS NestedQuery
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.LineNumber AS DocumentRowNumber,
		|	NestedQuery.Products AS Products,
		|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
		|	NestedQuery.Characteristic AS Characteristic,
		|	NestedQuery.Series AS Series,
		|	NestedQuery.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|	NestedQuery.Warehouse AS Warehouse,
		|	NestedQuery.Count AS Count,
		|	CASE
		|		WHEN NestedQuery.Count > 0
		|			THEN CAST(NestedQuery.Sum / NestedQuery.Count AS NUMBER(31, 2))
		|		ELSE 0
		|	END AS Price,
		|	NestedQuery.Sum AS Sum,
		|	NestedQuery.InventoryType AS InventoryType
		|INTO TTReturnableWaste
		|FROM
		|	(SELECT
		|		BackflushProductionInventoryOwnerAttributesSideProducts.LineNumber AS LineNumber,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.ItemsLocationAttributes.Products AS Products,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.ItemsLocationAttributes.Characteristic AS Characteristic,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.ItemsLocationAttributes.Series AS Series,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.Count AS Count,
		|		BackflushProductionInventoryOwnerAttributesSideProducts.Sum AS Sum,
		|		Warehouses.Ref AS Warehouse,
		|		CASE
		|			WHEN BackflushProductionInventoryOwnerAttributesSideProducts.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|				THEN CAST(""CommissionGoods"" AS STRING(20))
		|			ELSE CAST(&OwnProducts AS STRING(20))
		|		END AS InventoryType
		|	FROM
		|		Document.BackflushProduction.InventoryOwnerAttributesSideProducts AS BackflushProductionInventoryOwnerAttributesSideProducts
		|			LEFT JOIN Catalog.Warehouses AS Warehouses
		|			ON BackflushProductionInventoryOwnerAttributesSideProducts.Recipient = Warehouses.Ref
		|	WHERE
		|		BackflushProductionInventoryOwnerAttributesSideProducts.Ref = &Ref
		|		AND NOT ISNULL(Warehouses.ShopFloorStockroom, FALSE)
		|		AND NOT BackflushProductionInventoryOwnerAttributesSideProducts.DirectionOfProductionIssue = VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)) AS NestedQuery
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.DocumentRowNumber AS DocumentRowNumber,
		|	GoodsTable.Products AS Products,
		|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
		|	GoodsTable.InventoryType AS InventoryType,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	GoodsTable.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|	GoodsTable.Warehouse AS Warehouse,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Price AS Price,
		|	GoodsTable.Sum AS Sum
		|FROM
		|	TTProductsWithValue AS GoodsTable
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.DocumentRowNumber AS DocumentRowNumber,
		|	GoodsTable.Products AS Products,
		|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
		|	GoodsTable.InventoryType AS InventoryType,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	GoodsTable.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|	GoodsTable.Warehouse AS Warehouse,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Price AS Price,
		|	GoodsTable.Sum AS Sum
		|FROM
		|	TTReturnableWaste AS GoodsTable
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.LineNumber AS DocumentRowNumber,
		|	GoodsTable.Products AS Products,
		|	GoodsTable.InventoryType AS InventoryType,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.CostDivision AS CostDivision
		|FROM
		|	(SELECT
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.LineNumber AS LineNumber,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.ItemsLocationAttributes.Products AS Products,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.ItemsLocationAttributes.Characteristic AS Characteristic,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.ItemsLocationAttributes.Series AS Series,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.CCDNumber AS CCDNumber,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.QuantityByGBRN AS QuantityByGBRN,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
		|		CASE
		|			WHEN BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|				THEN CAST(""CommissionGoods"" AS STRING(20))
		|			WHEN BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
		|				THEN ""GiverRawMaterialsAndSupplies""
		|			ELSE CAST(&OwnProducts AS STRING(20))
		|		END AS InventoryType,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.Count AS Count,
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.Department AS CostDivision
		|	FROM
		|		Document.BackflushProduction.InventoryOwnerAttributesMaterialsAndWorks AS BackflushProductionInventoryOwnerAttributesMaterialsAndWorks
		|	WHERE
		|		BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.Ref = &Ref
		|		AND NOT ISNULL(BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.ItemsLocationAttributes.StorageLocation.ShopFloorStockroom, FALSE)
		|		AND NOT BackflushProductionInventoryOwnerAttributesMaterialsAndWorks.ItemsLocationAttributes.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OperationService), VALUE(Enum.ItemsTypes.Work_5))) AS GoodsTable
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsTable.Products AS Products,
		|	GoodsTable.UnitOfMeasure AS UnitOfMeasure,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	GoodsTable.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|	GoodsTable.Warehouse AS Warehouse,
		|	GoodsTable.Count AS Count,
		|	GoodsTable.Price AS Price,
		|	GoodsTable.Sum AS Sum,
		|	GoodsTable.InventoryType AS InventoryType
		|FROM
		|	(SELECT
		|		TTProductsWithValue.DocumentRowNumber AS DocumentRowNumber,
		|		TTProductsWithValue.Products AS Products,
		|		TTProductsWithValue.UnitOfMeasure AS UnitOfMeasure,
		|		TTProductsWithValue.Characteristic AS Characteristic,
		|		TTProductsWithValue.Series AS Series,
		|		TTProductsWithValue.DirectionOfProductionIssue AS DirectionOfProductionIssue,
		|		TTProductsWithValue.Warehouse AS Warehouse,
		|		TTProductsWithValue.Count AS Count,
		|		TTProductsWithValue.Price AS Price,
		|		TTProductsWithValue.Sum AS Sum,
		|		TTProductsWithValue.InventoryType AS InventoryType,
		|		1 AS Priority
		|	FROM
		|		TTProductsWithValue AS TTProductsWithValue
		|	WHERE
		|		TTProductsWithValue.DirectionOfProductionIssue = VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		TTReturnableWaste.DocumentRowNumber,
		|		TTReturnableWaste.Products,
		|		TTReturnableWaste.UnitOfMeasure,
		|		TTReturnableWaste.Characteristic,
		|		TTReturnableWaste.Series,
		|		TTReturnableWaste.DirectionOfProductionIssue,
		|		TTReturnableWaste.Warehouse,
		|		TTReturnableWaste.Count,
		|		TTReturnableWaste.Price,
		|		TTReturnableWaste.Sum,
		|		TTReturnableWaste.InventoryType,
		|		2
		|	FROM
		|		TTReturnableWaste AS TTReturnableWaste
		|	WHERE
		|		TTReturnableWaste.DirectionOfProductionIssue = VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)) AS GoodsTable
		|
		|ORDER BY
		|	GoodsTable.Priority
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	BackflushProductionMaterialsAndWorks.Products AS Products,
		|	BackflushProductionMaterialsAndWorks.Count AS Count,
		|	BackflushProductionMaterialsAndWorks.Department AS CostDivision
		|FROM
		|	Document.BackflushProduction.MaterialsAndWorks AS BackflushProductionMaterialsAndWorks
		|WHERE
		|	BackflushProductionMaterialsAndWorks.Ref = &Ref
		|	AND BackflushProductionMaterialsAndWorks.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OperationService), VALUE(Enum.ItemsTypes.Work_5))";
		
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText,
				"&QueryTextPackagingFactor",
				Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
				"NestedQuery.PricePackaging",
				"NestedQuery.Products"));
				
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "GoodsTable"));
			
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "GoodsTable"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "GoodsTable"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "GoodsTable"));
			
	Query.Text = QueryText;
	
	QueryResult = Query.ExecuteBatch();
				
	TableProduction          = QueryResult[QueryResult.Count() - 5].Unload();
	TableReturnableWaste   = QueryResult[QueryResult.Count() - 4].Unload();
	TableMaterials          = QueryResult[QueryResult.Count() - 3].Unload();
	TableOfProductsToWriteOff = QueryResult[QueryResult.Count() - 2].Unload();
	WorkTable             = QueryResult[QueryResult.Count() - 1].Unload();
	
	WarehouseForUnloading = Undefined;
	DirectionOfProductionIssue = Undefined;
	If TableProduction.Count() > 0 Then
		UsageOCR.Document_ProductionWithoutOrder_Sending = True;
		FillInCharacteristicsOfWHPackage(ExchangeComponents, TableProduction, True, False);
	
		// The warehouse and the direction of release will be taken from the first row of the sample.
		WarehouseForUnloading = WarehouseForUnloading(TableProduction[0].Warehouse, ExchangeComponents.ConversionParameters_SSLy);
		DirectionOfProductionIssue = TableProduction[0].DirectionOfProductionIssue;
		
	EndIf;
	
	If TableReturnableWaste.Count() > 0 Then
		UsageOCR.Document_ProductionWithoutOrder_Sending = True;
		If Not ValueIsFilled(WarehouseForUnloading) Then
			WarehouseForUnloading = WarehouseForUnloading(TableReturnableWaste[0].Warehouse, ExchangeComponents.ConversionParameters_SSLy);	
		EndIf;
		
		If Not ValueIsFilled(DirectionOfProductionIssue) Then
			DirectionOfProductionIssue = TableReturnableWaste[0].DirectionOfProductionIssue;	
		EndIf;
		
		FillInCharacteristicsOfWHPackage(ExchangeComponents, TableReturnableWaste, True, False);
	EndIf;
	
	If TableMaterials.Count() > 0 Then
		UsageOCR.Document_ProductionWithoutOrder_Sending = True;
		If Not ValueIsFilled(DirectionOfProductionIssue) Then
			DirectionOfProductionIssue = Enums.BusinessTransactions.ProductsReleaseToWarehouse;	
		EndIf;
		
		FillInCharacteristicsOfWHPackage(ExchangeComponents, TableMaterials, True, False);
	EndIf;
	
	If TableOfProductsToWriteOff.Count() > 0 Then
		FillInCharacteristicsOfWHPackage(ExchangeComponents, TableOfProductsToWriteOff, True, False);
		UsageOCR.Document_ProductionWithoutOrder_InventoryWriteOff = True;
	EndIf;
	
	If WorkTable.Count() > 0 Then
		UsageOCR.Document_ProductionWithoutOrder_Sending = True;
	EndIf;
	
	IBData.AdditionalProperties.Insert("TableProduction", TableProduction);
	IBData.AdditionalProperties.Insert("TableReturnableWaste", TableReturnableWaste);
	IBData.AdditionalProperties.Insert("TableMaterials", TableMaterials);
	IBData.AdditionalProperties.Insert("TableOfProductsToWriteOff", TableOfProductsToWriteOff);
	IBData.AdditionalProperties.Insert("WorkTable", WorkTable);
	
	IBData.AdditionalProperties.Insert("WarehouseForUnloading", WarehouseForUnloading);
	IBData.AdditionalProperties.Insert("DirectionOfProductionIssue", ?(DirectionOfProductionIssue = Undefined, Enums.BusinessTransactions.ProductsReleaseToWarehouse, DirectionOfProductionIssue));
EndProcedure

