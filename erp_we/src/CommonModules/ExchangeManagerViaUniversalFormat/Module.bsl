Procedure OCR_Document_GoodsRecordingAsReceived_Send_OnSendData(IBData, XDTOData, ExchangeComponents, ExportStack)
	XDTOData.KeyProperties.Insert("OperationKind", "RegistrationOfOwnGoods");
	
	If ExportStack.Count() > 1 Then
		Return;
	EndIf;
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"Document_ProductRegistration_Shipment", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;	
		
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
	
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);
	XDTOData.Insert("Warehouse", WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData, False, False);
	
	QueryText =
		"SELECT
		|	GoodsRegistration.Products AS Products,
		|	&QueryTextCharacteristic,
		|	&QueryTextSeries,
		|	&QueryTextProductBatchID,
		|	&TextOfCCDRequest,
		|	GoodsRegistration.Products.UnitOfMeasure AS UnitOfMeasure,
		|	GoodsRegistration.Count AS Count,
		|	CAST(GoodsRegistration.Price * CASE
		|			WHEN &RegCurrency <> &ManCurrency
		|				THEN CASE
		|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
		|								AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
		|							THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|						ELSE 1
		|					END
		|			ELSE 1
		|		END AS NUMBER(31, 2)) AS Price,
		|	CAST(GoodsRegistration.Sum * CASE
		|			WHEN &RegCurrency <> &ManCurrency
		|				THEN CASE
		|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
		|								AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
		|								AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
		|							THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|						ELSE 1
		|					END
		|			ELSE 1
		|		END AS NUMBER(31, 2)) AS Sum,
		|	CASE
		|		WHEN GoodsRegistration.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		|			THEN CAST(""CommissionGoods"" AS STRING(20))
		|		ELSE CAST(&OwnProducts AS STRING(20))
		|	END AS InventoryType,
		|	GoodsRegistration.RowID AS RowID
		|FROM
		|	Document.InventorySurplusRecognition.Goods AS GoodsRegistration
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &ManCurrency AND BaseCurrency = &RegCurrency) AS CurrencyRatesPrices
		|		ON (TRUE)
		|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&Date, Currency = &RegCurrency AND BaseCurrency = &RegCurrency) AS Currency_Rates
		|		ON (TRUE)
		|WHERE
		|	GoodsRegistration.Ref = &Ref";
	
	FillInYourOwnProductsInText(QueryText);
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "GoodsRegistration"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "GoodsRegistration"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "GoodsRegistration"));
	
	QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
		GetTextOfCCDRequest(ExchangeComponents, "GoodsRegistration"));
		
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("Date", IBData.Ref.Date);
	Query.SetParameter("RegCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
	If ValueIsFilled(IBData.Currency) Then
		Query.SetParameter("ManCurrency", IBData.Currency);
	Else
		Query.SetParameter("ManCurrency", Constants.ManagementAccountingCurrency.Get());
	EndIf;
	
	Goods = Query.Execute().Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, Goods, "ActivityRegistration");
	
	XDTOData.Insert("Goods", Goods);
EndProcedure

