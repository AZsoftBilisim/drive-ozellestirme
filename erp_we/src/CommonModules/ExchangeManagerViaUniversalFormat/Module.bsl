Procedure DPR_Document_ReturnOfGoodsFromCustomer_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
	
	RefundViaCommissionAgent = ReturnOfGoodsViaCommissionAgent(IBData.BusinessOperation);
	
	If ReturnOfGoodsViaCommissionAgent(IBData.BusinessOperation) Then
		
		UsageOCR.Document_ReturnOfGoodsFromCustomerFee_Sending = True;
		
		If Not NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.20") Then
			
			ClearUsageOCR(UsageOCR);
			
			WarningTemplate = NStr("vi = 'Chứng từ %1 chưa được kết xuất, bởi vì giao dịch kinh tế %2 không được hỗ trợ với định dạng %3';
									|ru = 'Документ %1 не выгружен, так как хозяйственная операция %2 не поддерживается в формате %3';
									|en = 'The %1 document is not exported as the %2 business transaction is not supported in the %3 format'; fa = 'The %1 document is not exported as the %2 business transaction is not supported in the %3 format';
									|it = 'Документ %1 не выгружен, так как хозяйственная операция %2 не поддерживается в формате %3';
									|pl = 'The %1 document is not exported as the %2 business transaction is not supported in the %3 format';
									|tr = '%2 ticari işlem türü %3 biçiminde desteklenmediği için %1 belgesi yüklenemiyor'");
			WarningText = StrTemplate(WarningTemplate, IBData.Ref, "«" + String(IBData.BusinessOperation) + "»", String(ExchangeComponents.ExchangeFormatVersion));
			SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
			
			Return;
			
		EndIf;
		
	Else
		
		UsageOCR.Document_ReturnOfGoodsFromCustomer_Sending = True;
		
	EndIf;
	
	If Not TypeOfTaxationIsValid(Undefined, IBData.VATTaxation, ExchangeComponents.ExchangeFormatVersion) Then
		
		ClearUsageOCR(UsageOCR);
		
		WarningTemplate = NStr("vi = 'Chưa kết xuất chứng từ %1, bởi vì kiểu hệ thống thuế %2 không được hỗ trợ với định dạng %3';
								|ru = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
								|en = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format'; fa = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
								|it = 'Документ %1 не выгружен, так как, тип налогообложения %2 не поддерживается в формате %3';
								|pl = 'The %1 document is not exported as the %2 taxation type is not supported in the %3 format';
								|tr = '%2 vergilendirme türü %3 biçiminde desteklenmediğinden dolayı %1 belgesi yüklenmedi'");
		WarningText = StrTemplate(WarningTemplate, IBData.Ref, "«" + String(IBData.VATTaxation) + "»", String(ExchangeComponents.ExchangeFormatVersion));
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
	EndIf;
EndProcedure

