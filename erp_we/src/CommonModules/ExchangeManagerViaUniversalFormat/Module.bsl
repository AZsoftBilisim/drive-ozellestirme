Procedure DPR_Document_MovementOfProductsAndMaterials_Send_OnProcess(IBData, UsageOCR, ExchangeComponents)
	SetUsageOCR(UsageOCR, False);
		
	If IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfSemiFinishedProducts Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.SetParameter("Ref", IBData.Ref);
	
	WarehouseLink         = Undefined;
	UnitReference_1 = Undefined;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.MaterialTransferToProduction
		Or IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfMaterialsToStoreroom Then
		#Region TransferToProduction
		
		WarehouseLink         = IBData.Sender;
		UnitReference_1 = IBData.Recipient;
		
		If ValueIsFilled(WarehouseLink) And Common.RefExists(WarehouseLink)
			And Common.ObjectAttributeValue(WarehouseLink, "ShopFloorStockroom") Then
			Return;
		EndIf;
		
		QueryText =
			"SELECT
			|	Dimension.Products AS Products,
			|	Dimension.Characteristic AS Characteristic,
			|	Dimension.Series AS Series,
			|	Dimension.Products.UnitOfMeasure AS UnitOfMeasure,
			|	InventoryKinds.CCDNumber AS CCDNumber,
			|	SUM(InventoryKinds.QuantityByGBRN) AS QuantityByGBRN,
			|	InventoryKinds.ProductsGroup AS AnalyticalProductGroup,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
			|			THEN ""GiverRawMaterialsAndSupplies""
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END AS InventoryType,
			|	CASE 
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
			|			AND VALUETYPE(InventoryKinds.InventoryOwnerAttribute.Counterparty) = TYPE(Catalog.Counterparties)
			|			THEN InventoryKinds.InventoryOwnerAttribute.Counterparty
			|		ELSE VALUE(Catalog.Counterparties.EmptyRef)
			|	END AS Customer_,
			|	SUM(InventoryKinds.Count) AS Count
			|INTO ProductsAll
			|FROM
			|	Document.MovementOfProductsAndMaterials.InventoryKinds AS InventoryKinds
			|		INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
			|		ON InventoryKinds.ItemsLocationAttributes = Dimension.DimensionKey
			|WHERE
			|	InventoryKinds.Ref = &Ref
			|
			|GROUP BY
			|	Dimension.Products,
			|	Dimension.Products.UnitOfMeasure,
			|	InventoryKinds.CCDNumber,
			|	InventoryKinds.ProductsGroup,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN CAST(""CommissionGoods"" AS STRING(20))
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
			|			THEN ""GiverRawMaterialsAndSupplies""
			|		ELSE CAST(&OwnProducts AS STRING(20))
			|	END,
			|	CASE 
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
			|			AND VALUETYPE(InventoryKinds.InventoryOwnerAttribute.Counterparty) = TYPE(Catalog.Counterparties)
			|			THEN InventoryKinds.InventoryOwnerAttribute.Counterparty
			|		ELSE VALUE(Catalog.Counterparties.EmptyRef)
			|	END,
			|	Dimension.Characteristic,
			|	Dimension.Series
			|
			|INDEX BY
			|	InventoryType
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.Products AS Products,
			|	Goods.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	Goods.Count AS Count,
			|	Goods.Customer_ AS Customer_,
			|	Goods.AnalyticalProductGroup AS AnalyticalProductGroup,
			|	Goods.InventoryType AS InventoryType
			|FROM
			|	ProductsAll AS Goods
			|WHERE
			|	NOT Goods.InventoryType = ""CommissionGoods""
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Goods.Products AS Products,
			|	Goods.UnitOfMeasure AS UnitOfMeasure,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	Goods.Count AS Count,
			|	Goods.InventoryType AS InventoryType
			|FROM
			|	ProductsAll AS Goods
			|WHERE
			|	Goods.InventoryType = ""CommissionGoods""";
		
		FillInYourOwnProductsInText(QueryText);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "Goods"));
		
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "Goods"));
	
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "Goods"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "Goods"));
			
		Query.Text = QueryText;
		
		QueryResult = Query.ExecuteBatch();
		
		OwnProducts  = QueryResult[1].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, OwnProducts, True, False);
		CommissionGoods = QueryResult[2].Unload();
		FillInCharacteristicsOfWHPackage(ExchangeComponents, CommissionGoods, True, False);
		
		If OwnProducts.Count() > 0 Then
			IBData.AdditionalProperties.Insert("OwnProducts", OwnProducts);
			UsageOCR.Document_MovementOfProductsAndMaterials_BProductions = True;
		EndIf;
		
		If CommissionGoods.Count() > 0 Then    
			IBData.AdditionalProperties.Insert("CommissionGoods", CommissionGoods);
			UsageOCR.Document_MovementOfProductsAndMaterials_BPDSpisStock = True;
		EndIf;
		
		#EndRegion
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfProductsFromProduction
			Or IBData.BusinessOperation = Enums.BusinessTransactions.TransferOfProductsFromStoreroom Then
		#Region ProductsRelease
		
		WarehouseLink         = IBData.Recipient;
		UnitReference_1 = IBData.Sender;
		
		If ValueIsFilled(WarehouseLink) And Common.RefExists(WarehouseLink)
			And Common.ObjectAttributeValue(WarehouseLink, "ShopFloorStockroom") Then
			Return;
		EndIf;
		
		TypeOfPlannedPrices = TypeOfPlannedPricesUsed(ExchangeComponents);
		
		If Not ValueIsFilled(TypeOfPlannedPrices) Then
			// Prices must be indicated in the document.
			QueryText =
				"SELECT
				|	Goods.Products AS Products,
				|	SUM(Goods.Count) AS Count,
				|	SUM(Goods.Sum) AS Sum,
				|	Goods.Characteristic AS Characteristic,
				|	Goods.Series AS Series
				|INTO TTProducts_1
				|FROM
				|	Document.MovementOfProductsAndMaterials.Goods AS Goods
				|WHERE
				|	Goods.Ref = &Ref
				|
				|GROUP BY
				|	Goods.Products,
				|	Goods.Characteristic,
				|	Goods.Series
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
				|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
				|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
				|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
				|	CASE
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				|			THEN CAST(""CommissionGoods"" AS STRING(20))
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
				|			THEN ""GiverRawMaterialsAndSupplies""
				|		ELSE CAST(&OwnProducts AS STRING(20))
				|	END AS InventoryType,
				|	InventoryKinds.CCDNumber AS CCDNumber,
				|	SUM(InventoryKinds.QuantityByGBRN) AS QuantityByGBRN,
				|	SUM(InventoryKinds.Count) AS Count
				|INTO TTTypesOfStocks
				|FROM
				|	Document.MovementOfProductsAndMaterials.InventoryKinds AS InventoryKinds
				|WHERE
				|	InventoryKinds.Ref = &Ref
				|
				|GROUP BY
				|	InventoryKinds.ItemsLocationAttributes.Products,
				|	InventoryKinds.ItemsLocationAttributes.Characteristic,
				|	InventoryKinds.CCDNumber,
				|	CASE
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				|			THEN CAST(""CommissionGoods"" AS STRING(20))
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
				|			THEN ""GiverRawMaterialsAndSupplies""
				|		ELSE CAST(&OwnProducts AS STRING(20))
				|	END,
				|	InventoryKinds.ItemsLocationAttributes.Series,
				|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure
				|
				|INDEX BY
				|	Products,
				|	Characteristic,
				|	Series
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	TTTypesOfStocks.Products AS Products,
				|	TTTypesOfStocks.UnitOfMeasure AS UnitOfMeasure,
				|	&QueryTextCharacteristic,
				|	&QueryTextSeries,
				|	&QueryTextProductBatchID,
				|	&TextOfCCDRequest,
				|	TTTypesOfStocks.InventoryType AS InventoryType,
				|	TTTypesOfStocks.Count AS Count,
				|	CAST(TTProducts_1.Sum / TTProducts_1.Count * TTTypesOfStocks.Count AS NUMBER(31, 2)) AS Sum,
				|	CAST(TTProducts_1.Sum / TTProducts_1.Count AS NUMBER(31, 2)) AS Price
				|FROM
				|	TTTypesOfStocks AS TTTypesOfStocks
				|		INNER JOIN TTProducts_1 AS TTProducts_1
				|		ON TTTypesOfStocks.Products = TTProducts_1.Products
				|			AND TTTypesOfStocks.Characteristic = TTProducts_1.Characteristic
				|			AND TTTypesOfStocks.Series = TTProducts_1.Series";
		Else
			// The planned type of prices specified in the constant of the type of price of the planned cost of the materials of work is used.
			QueryText =
				"SELECT
				|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
				|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
				|	InventoryKinds.ItemsLocationAttributes.Characteristic AS Characteristic,
				|	InventoryKinds.ItemsLocationAttributes.Series AS Series,
				|	CASE
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				|			THEN CAST(""CommissionGoods"" AS STRING(20))
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
				|			THEN ""GiverRawMaterialsAndSupplies""
				|		ELSE CAST(&OwnProducts AS STRING(20))
				|	END AS InventoryType,
				|	InventoryKinds.CCDNumber AS CCDNumber,
				|	SUM(InventoryKinds.QuantityByGBRN) AS QuantityByGBRN,
				|	SUM(InventoryKinds.Count) AS Count
				|INTO TTTypesOfStocks
				|FROM
				|	Document.MovementOfProductsAndMaterials.InventoryKinds AS InventoryKinds
				|WHERE
				|	InventoryKinds.Ref = &Ref
				|
				|GROUP BY
				|	InventoryKinds.ItemsLocationAttributes.Products,
				|	InventoryKinds.ItemsLocationAttributes.Characteristic,
				|	InventoryKinds.CCDNumber,
				|	CASE
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				|			THEN CAST(""CommissionGoods"" AS STRING(20))
				|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
				|			THEN ""GiverRawMaterialsAndSupplies""
				|		ELSE CAST(&OwnProducts AS STRING(20))
				|	END,
				|	InventoryKinds.ItemsLocationAttributes.Series,
				|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure
				|
				|INDEX BY
				|	Products,
				|	Characteristic
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	TTTypesOfStocks.Products AS Products,
				|	TTTypesOfStocks.UnitOfMeasure AS UnitOfMeasure,
				|	TTTypesOfStocks.InventoryType AS InventoryType,
				|	TTTypesOfStocks.Count AS Count,
				|	CAST(ISNULL(ItemPricesCrossSectionOfTheLatest.Price, 0) * ISNULL(CurrencyRatesCut.CourseNumerator, 1) / ISNULL(CurrencyRatesCut.CourseDenominator, 1) AS NUMBER(31, 2)) AS Price,
				|	CAST((CAST(ISNULL(ItemPricesCrossSectionOfTheLatest.Price, 0) * ISNULL(CurrencyRatesCut.CourseNumerator, 1) / ISNULL(CurrencyRatesCut.CourseDenominator, 1) AS NUMBER(31, 2))) * TTTypesOfStocks.Count AS NUMBER(31, 2)) AS Sum,
				|	&QueryTextCharacteristic,
				|	&QueryTextSeries,
				|	&QueryTextProductBatchID,
				|	&TextOfCCDRequest
				|FROM
				|	TTTypesOfStocks AS TTTypesOfStocks
				|		LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&DocumentDate, PriceKind = &TypeOfPlannedPrices) AS ItemPricesCrossSectionOfTheLatest
				|		ON TTTypesOfStocks.Products = ItemPricesCrossSectionOfTheLatest.Products
				|			AND TTTypesOfStocks.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic
				|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&DocumentDate, BaseCurrency = &BaseCurrency) AS CurrencyRatesCut
				|		ON (ItemPricesCrossSectionOfTheLatest.Currency = CurrencyRatesCut.Currency)";
			
			Query.SetParameter("TypeOfPlannedPrices", TypeOfPlannedPrices);
			Query.SetParameter("DocumentDate",  IBData.Date);
			Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization));
			
		EndIf;
		
		FillInYourOwnProductsInText(QueryText);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "TTTypesOfStocks"));
			
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "TTTypesOfStocks"));
		
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "TTTypesOfStocks"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "TTTypesOfStocks"));
			
		Query.Text = QueryText;
		
		Goods = Query.Execute().Unload();
		
		If Goods.Count() > 0 Then
			FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
	
			IBData.AdditionalProperties.Insert("Goods", Goods);
			UsageOCR.Document_ProductAndMaterialMovement_ProductRelease = True;
		EndIf;
		
		#EndRegion
	ElsIf IBData.BusinessOperation = Enums.BusinessTransactions.ReturnOfMaterialsFromProduction
			Or IBData.BusinessOperation = Enums.BusinessTransactions.ReturnOfMaterialsFromStoreroom Then
		#Region ReturnFromProduction
		
		WarehouseLink         = IBData.Recipient;
		UnitReference_1 = IBData.Sender;
		
		If ValueIsFilled(WarehouseLink) And Common.RefExists(WarehouseLink)
			And Common.ObjectAttributeValue(WarehouseLink, "ShopFloorStockroom") Then
			Return;
		EndIf;
		
		QueryText =
			"SELECT
			|	InventoryKinds.ItemsLocationAttributes.Products AS Products,
			|	InventoryKinds.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasure,
			|	InventoryKinds.Count AS Count,
			|	&QueryTextCharacteristic,
			|	&QueryTextSeries,
			|	&QueryTextProductBatchID,
			|	&TextOfCCDRequest,
			|	CASE
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			|			THEN ""CommissionGoods""
			|		WHEN InventoryKinds.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider)
			|			THEN ""GiverRawMaterialsAndSupplies""
			|		ELSE &OwnProducts
			|	END AS InventoryType
			|FROM
			|	Document.MovementOfProductsAndMaterials.InventoryKinds AS InventoryKinds
			|WHERE
			|	InventoryKinds.Ref = &Ref";
		
		FillInYourOwnProductsInText(QueryText);
		
		QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
			GetTextOfCharacteristicsRequest(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
			
		QueryText = StrReplace(QueryText, "&QueryTextSeries",
			GetSeriesRequestText(ExchangeComponents, "InventoryKinds.ItemsLocationAttributes"));
		
		QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
			GetTextOfRNPTRequest(ExchangeComponents, "InventoryKinds", "InventoryKinds.ItemsLocationAttributes"));
	
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest",
			GetTextOfCCDRequest(ExchangeComponents, "InventoryKinds"));
	
		Query.Text = QueryText;
		
		Goods = Query.Execute().Unload();
		
		If Goods.Count() > 0 Then
			FillInCharacteristicsOfWHPackage(ExchangeComponents, Goods, True, False);
			IBData.AdditionalProperties.Insert("Goods", Goods);
			UsageOCR.Document_MovementOfProductsAndMaterials_ReturnFromPD = True;
		EndIf;
		
		#EndRegion
	Else
		Return;
	EndIf;
	
	IBData.AdditionalProperties.Insert("Warehouse", WarehouseForUnloading(WarehouseLink, ExchangeComponents.ConversionParameters_SSLy));
		
	If TypeOf(UnitReference_1) = Type("CatalogRef.BusinessStructure") Then
		IBData.AdditionalProperties.Insert("Department", UnitReference_1);
	ElsIf TypeOf(UnitReference_1) = Type("CatalogRef.Warehouses") Then
		IBData.AdditionalProperties.Insert("Department", Common.ObjectAttributeValue(UnitReference_1, "Department"));
	Else
		IBData.AdditionalProperties.Department = Catalogs.BusinessStructure.EmptyRef();
	EndIf;
EndProcedure


