Procedure DeferredProcessing_ReceiptOfGoodsServices(Object, ObjectIsModified, ExchangeComponents)
	FillingInPartnerInDocumentHeader(Object);
	FillingInAgreementWithSupplierInHeaderOfDocument(Object, ExchangeComponents.ConversionParameters_SSLy);
	FillInDeliveryParameters(Object);
	FillInDefaultTaxType(Object);
	FillInDefaultActivity(Object, "PurchaseForActivity");
	
	// Re-fulfillment of the contract type for the import purchase operation.
	If Object.BusinessOperation = Enums.BusinessTransactions.PurchaseByImport Then
	
		ContractLink = Object.Contract;
	
		If ValueIsFilled(ContractLink)
			And Common.RefExists(ContractLink) Then
			
			ContractData = Common.ObjectAttributesValues(ContractLink, "ContractType, BusinessOperation");
			
			ContractTypeImportRequired = Enums.ContractTypes.Import;
			EconomicOperationIsRequired = Enums.BusinessTransactions.PurchaseByImport;
			
			If ContractData.ContractType <> ContractTypeImportRequired
				Or ContractData.BusinessOperation <> EconomicOperationIsRequired Then
				
				ObjectAgreement = ContractLink.GetObject(); // CatalogObject.CounterpartyContracts
				
				ObjectAgreement.ContractType           = ContractTypeImportRequired;
				ObjectAgreement.BusinessOperation = EconomicOperationIsRequired;
				
				ExchangeNode = ?(ExchangeComponents.IsExchangeViaExchangePlan, ExchangeComponents.CorrespondentNode, Undefined);
				DataExchangeServer.SetDataExchangeLoad(ObjectAgreement, True, False, ExchangeNode);
				
				ObjectAgreement.Write();
				
			EndIf;
		EndIf;
	EndIf;
	
	If ValueIsFilled(Object.Contract) And Not Common.RefExists(Object.Contract) Then
		Object.Contract = Undefined;
	EndIf;
	
	// Division in PM Goods for Services
	Department = DefaultElement(ExchangeComponents, "Department");
	
	// Filling in an empty expense item and division for services
	ExpenseItem = Undefined;
	ItemOfExpenditureAdditionalExpenses = Undefined;
	
	For Each String In Object.Goods Do
		If (String.Products.ItemsType = Enums.ItemsTypes.OperationService
				Or String.Products.ItemsType = Enums.ItemsTypes.Work_5) Then
			String.ToExpenseAs = True;
			If ValueIsFilled(String.DimensionOfExpenses)
					And TypeOf(String.DimensionOfExpenses) = Type("DocumentRef.VendorInvoice")
					And Not ValueIsFilled(String.ExpenseItem) Then
					If ItemOfExpenditureAdditionalExpenses = Undefined Then
						ItemOfExpenditureAdditionalExpenses = DefaultElement(ExchangeComponents, "ItemOfExpenditureReceiptOfServicesAdditionalExpenses");
					EndIf;
					String.ExpenseItem = ItemOfExpenditureAdditionalExpenses; 
			ElsIf Not ValueIsFilled(String.ExpenseItem) Then
				If ExpenseItem = Undefined Then
					ExpenseItem = DefaultElement(ExchangeComponents, "ItemOfExpenditureReceiptOfServices");
				EndIf;
				String.ExpenseItem = ExpenseItem;
			EndIf;
			If Not ValueIsFilled(String.Department) Then
				String.Department = Department; 
			EndIf;
		EndIf;
		
		If Object.ReceiptUnderOrders And Not ValueIsFilled(String.PurchaseOrder) And ValueIsFilled(Object.PurchaseOrder) Then
			String.PurchaseOrder = Object.PurchaseOrder;
		EndIf;
	EndDo;
	
	FillInTableOfArticleDDSIKBusinessTransactions(Object, ExchangeComponents.ConversionParameters_SSLy.UploadedArticlesByDDSIKBusinessTransactions);
	
	If Not ValueIsFilled(Object.GoodsReceiptOption) Then
		Object.GoodsReceiptOption = PurchasesServer.GetProductAcceptanceOption(Undefined, Object.Contract);
	EndIf;
	
	PaymentStepsServer.CheckAndFillInPaymentScheduleStages(Object);
			
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
	
	FillInCalculationProcedure(Object, Object.Contract, Object.Terms);
EndProcedure



Procedure DeferredProcessing_ProductionWithoutOrder(Object, ExchangeComponents)
	If Not ValueIsFilled(Object.PriceKind) Then
		Object.PriceKind = Catalogs.TypesOfPrices.TypeOfPricePlannedCostOfInventory(Object.PriceKind);
	EndIf;
	
	If Not ValueIsFilled(Object.ProductionIssueForActivity) Then
		FillParameters = Documents.BackflushProduction.ParametersForFillingInVATActivityType(Object);
		VATAccountingERP.FillInTypeOfActivityVAT(Object.ProductionIssueForActivity, FillParameters);
	EndIf;
	
	If Not ValueIsFilled(Object.Currency) Then
		Object.Currency = IncomeAndExpensesServer.GetCurrencyOfManagementAccounting();
	EndIf;
	
	Object.ReferenceOrderForLaborCosts = True;
	
	For Each TableRow In Object.ManufacturedProducts Do
		If Not ValueIsFilled(TableRow.Recipient) Then
			TableRow.Recipient = WarehouseToLoad(TableRow.Recipient, ExchangeComponents.ConversionParameters_SSLy);
		EndIf; 
		If Not ValueIsFilled(TableRow.CostGroupNumber) Then
			TableRow.CostGroupNumber = 1;
		EndIf;
	EndDo;
	
	If Object.MethodOfAllocatingFinishedProductCosts = Enums.MethodsOfCostAllocatingOnProductCosts.ByTargetCost Then
		// Let's recalculate the shares according to the planned cost.
		CostAllocationParametersStructure = Documents.BackflushProduction.CostAllocationParameters(Object);
		CostAllocationParameters = New FixedStructure(CostAllocationParametersStructure);
		
		ProductionServer.CalculateFractionOfCost(Object, CostAllocationParameters);
	EndIf;
	
	ArrayOfRowsForRecalculatingPrice = New Array;
	For Each TableRow In Object.SideAndIntermediateRelease Do
		If Not ValueIsFilled(TableRow.Recipient) Then
			TableRow.Recipient = WarehouseToLoad(TableRow.Recipient, ExchangeComponents.ConversionParameters_SSLy);
		EndIf;
		
		If Not ValueIsFilled(TableRow.Department) Then
			Department = Undefined;
			If ValueIsFilled(TableRow.Recipient)
				And TypeOf(TableRow.Recipient) = Type("CatalogRef.Warehouses") Then
				Department = Common.ObjectAttributeValue(TableRow.Recipient, "Department");
			EndIf;
			If Not ValueIsFilled(Department) Then
				Department = DefaultElement(ExchangeComponents, "Department");
			EndIf;
			
			If ValueIsFilled(Department) Then
				TableRow.Department = Department;
			EndIf;
		EndIf;
		
		If Not ValueIsFilled(TableRow.ProductCostElement) Then
			TableRow.ProductCostElement = DefaultElement(ExchangeComponents, "ArticleOfCalculationReturnableWaste");
		EndIf;
		
		If Not ValueIsFilled(TableRow.Price) And ValueIsFilled(Object.PriceKind) Then
			ArrayOfRowsForRecalculatingPrice.Add(TableRow);
		EndIf;
	EndDo;
	
	// We will replenish the cost of returnable waste at the planned cost.
	If ArrayOfRowsForRecalculatingPrice.Count() > 0 Then
		
		FillParameters = EnterprisePricesFillingServer.NewFillOptionsFillPrices();
		FillPropertyValues(FillParameters, Object, "Date, Currency, PriceKind, Organization");
		FillParameters.PopulationFields = "Price";
		
		StructureOfActions = New Structure;
		StructureOfActions.Insert("RecalculateAmount", "NumberOfPackages");
		
		PricesCalculated = EnterprisePricesFillingServer.FillInPrices(
			Object.SideAndIntermediateRelease,
			ArrayOfRowsForRecalculatingPrice,
			FillParameters,
			StructureOfActions);
	EndIf;
	
	For Each TableRow In Object.MaterialsAndWorks Do
	
		TableRow.Warehouse = WarehouseToLoad(TableRow.Warehouse, ExchangeComponents.ConversionParameters_SSLy);	
	
		If Not ValueIsFilled(TableRow.Department) Then
			Department = Common.ObjectAttributeValue(TableRow.Warehouse, "Department");
			If Not ValueIsFilled(Department) Then
				Department = DefaultElement(ExchangeComponents, "Department");
			EndIf;
			
			TableRow.Department = Department;
		EndIf;
		If Not ValueIsFilled(TableRow.CostGroupNumber) Then
			TableRow.CostGroupNumber = 1;
		EndIf;
		If Not ValueIsFilled(TableRow.ProductCostElement) Then
			TableRow.ProductCostElement = DefaultElement(ExchangeComponents, "ArticleOfCalculationMaterialCosts");
		EndIf;
	EndDo;
	
	// Let's check the details of the division.
	AttributesValues = New Structure("ProductionBusinessUnit, BackflushProduction_", True, True);
	CheckUpdateItemDetails(Object.Department, AttributesValues, ExchangeComponents);
	
	FillInStatusesForSpecifyingSeries(Object, ExchangeComponents);
EndProcedure

