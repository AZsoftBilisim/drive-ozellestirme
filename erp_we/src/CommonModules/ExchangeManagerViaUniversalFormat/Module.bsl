Procedure SUB_Document_VZ_DebtAdjustment_Sending_DuringProcessing(IBData, UsageOCR, ExchangeComponents)
	ConsignmentSalesAreSupported = NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17");
	
	If Not ConsignmentSalesAreSupported And (IBData.OperationKind = Enums.KindsOfARAPSettlements.RecordOfPaymentThroughTheCommissionAgent
		Or IBData.OperationKind = Enums.KindsOfARAPSettlements.RecordOfRefundThroughTheCommissionAgent) Then
		ClearUsageOCR(UsageOCR);
		
		WarningTemplate = NStr("vi = 'Chứng từ %1 chưa được kết xuất, bởi vì dạng giao dịch %2 không được hỗ trợ với định dạng %3';
								|ru = 'Документ %1 не выгружен, так как вид операции %2 не поддерживается в формате %3';
								|en = 'The %1 document is not exported as the %2 transaction type is not supported in the %3 format'; fa = 'The %1 document is not exported as the %2 transaction type is not supported in the %3 format';
								|it = 'Документ %1 не выгружен, так как вид операции %2 не поддерживается в формате %3';
								|pl = 'The %1 document is not exported as the %2 transaction type is not supported in the %3 format';
								|tr = '%2 işlem türü %3 biçiminde desteklenmediği için %1 belgesi yüklenemiyor'");
		WarningText = StrTemplate(WarningTemplate, IBData.Ref, "«" + String(IBData.OperationKind) + "»", String(ExchangeComponents.ExchangeFormatVersion));
		SynchronizationWarning_(ExchangeComponents, IBData.Ref, WarningText);
		
		Return;
	EndIf;
	
	If ExchangeComponents.IsExchangeViaExchangePlan Then
		UseFilterByCompanies = ExchangeComponents.ConversionParameters_SSLy.UseFilterByCompanies;
		UnloadManOrganization         = ExchangeComponents.ConversionParameters_SSLy.UnloadManagementCompany;
		ListOfOrganizationsNode           = ExchangeComponents.ConversionParameters_SSLy.Companies;
	Else
		UseFilterByCompanies = False;
		UnloadManOrganization         = True;
		ListOfOrganizationsNode           = New Array();
	EndIf;
	
	If ValueIsFilled(IBData.CompanyCreditor)
		And TypeOf(IBData.CompanyCreditor) = Type("CatalogRef.Companies") Then
		
		IBData.AdditionalProperties.Insert("NettingInvolvingTwoOrganizations", True);
		
		UsageOCR.Document_VZ_OurOrganization = False;
		
		If UseFilterByCompanies Then
			
			If ListOfOrganizationsNode.FindByValue(IBData.Organization) <> Undefined Then
				UsageOCR.Document_VZ_OrganizationDebtor  = True;
			Else
				UsageOCR.Document_VZ_OrganizationDebtor  = False;
			EndIf;
			
			If ListOfOrganizationsNode.FindByValue(IBData.CompanyCreditor) <> Undefined Then
				UsageOCR.Document_VZ_LenderOrganization = True;
			Else
				UsageOCR.Document_VZ_LenderOrganization = False;
			EndIf;
			
		Else
			
			UsageOCR.Document_VZ_OrganizationDebtor  = UnloadManOrganization
			Or IBData.Organization <> ManagementCompany();
			UsageOCR.Document_VZ_LenderOrganization = UnloadManOrganization
			Or IBData.CompanyCreditor <> ManagementCompany();
			
		EndIf;
		
	Else
		
		If UseFilterByCompanies Then
			
			If ListOfOrganizationsNode.FindByValue(IBData.Organization) <> Undefined Then
				UsageOCR.Document_VZ_OurOrganization = True;
			Else
				UsageOCR.Document_VZ_OurOrganization = False;
			EndIf;
			
			If TypeOf(IBData.Creditor) = Type("CatalogRef.Companies")
				And ListOfOrganizationsNode.FindByValue(IBData.Creditor) <> Undefined Then
				UsageOCR.Document_VZ_LenderOrganization = True;
			Else
				UsageOCR.Document_VZ_LenderOrganization = False;
			EndIf;
			
			If TypeOf(IBData.CounterpartyDebtor) = Type("CatalogRef.Companies")
				And ListOfOrganizationsNode.FindByValue(IBData.CounterpartyDebtor) <> Undefined Then
				UsageOCR.Document_VZ_OrganizationDebtor = True;
			Else
				UsageOCR.Document_VZ_OrganizationDebtor = False;
			EndIf;
			
		Else
			CounterOffsetOfDebtOfOrganizations = (IBData.OperationKind = Enums.KindsOfARAPSettlements.ARAPClearingBetweenCompanies);
			
			ManyToManySettlement = (IBData.OperationKind = Enums.KindsOfARAPSettlements.CustomerPrepaymentOffsetBetweenTwoCompanies
			Or IBData.OperationKind = Enums.KindsOfARAPSettlements.AccountsReceivableOffsetBetweenTwoCompanies
			Or IBData.OperationKind = Enums.KindsOfARAPSettlements.AccountsPayableOffsetBetweenTwoCompanies
			Or IBData.OperationKind = Enums.KindsOfARAPSettlements.PrepaymentToVendorOffsetBetweenTwoCompanies);
			
			If Not ManyToManySettlement And Not CounterOffsetOfDebtOfOrganizations Then
				UsageOCR.Document_VZ_OurOrganization = UnloadManOrganization 
				Or IBData.Organization <> ManagementCompany();  
			Else
				UsageOCR.Document_VZ_OurOrganization = False;
			EndIf;
			
			TypeOrganizationClient = Enums.ARAPSettlemenParticipantTypes.OrganizationClient;
			
			UsageOCR.Document_VZ_OrganizationDebtor = (IBData.CounterpartyDebtorType = TypeOrganizationClient
			Or IBData.CounterpartyDebtorType = Enums.ARAPSettlemenParticipantTypes.CompanyVendor)
			And (UnloadManOrganization Or IBData.CounterpartyDebtor <> ManagementCompany());
			
			UsageOCR.Document_VZ_LenderOrganization = (IBData.CounterpartyCreditorType = TypeOrganizationClient
			Or IBData.CounterpartyCreditorType = Enums.ARAPSettlemenParticipantTypes.CompanyVendor)
			And (UnloadManOrganization Or IBData.Creditor <> ManagementCompany());
		EndIf;
		
	EndIf;  
	
	IncorrectAmounts = CheckDebtTablesForAmountOfReg(IBData.Ref); 
	If IncorrectAmounts Then
		ClearUsageOCR(UsageOCR);
	EndIf;
EndProcedure

