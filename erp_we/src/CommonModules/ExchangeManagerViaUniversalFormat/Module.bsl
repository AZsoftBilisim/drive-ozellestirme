Procedure PCO_TransferBetweenOrganizations_PTU_Sending_WhenSendingData_(IBData, XDTOData, ExchangeComponents, ExportStack)
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"TransferBetweenOrganizations_PTU_Sending", 
										"Goods", 
										"CCDNumber",
										True,
										"Catalog_CCDNumbers_Send");
	EndIf;
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.17") Then
		SetRuleForPCRTabPart(ExchangeComponents,
										"TransferBetweenOrganizations_PTU_Sending", 
										"Goods", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
		SetRuleForPCRTabPart(ExchangeComponents,
										"TransferBetweenOrganizations_PTU_Sending", 
										"Services", 
										"VATRate",
										True,
										"CatalogLink_BIDS_Sending");
								
	EndIf;
	DocDate  = BegOfDay(IBData.Date);
	Prefix = "I";
	DocNumber = Left(IBData.Number, 5) + Prefix + Mid(IBData.Number, 7);
	
	BXDocumentNumber = ObjectsPrefixesClientServer.NumberForPrinting(DocNumber, False, True);
	
	If IBData.ARAPAccountingViaSeparateCounterparty Then
		CounterpartyRef = IBData.Counterparty;
	Else
		CounterpartyRef = CounterpartyFromOrganization(IBData.Organization, ExchangeComponents);
	EndIf;
	
	If ExportStack.Count() > 1 Then
		XDTOData.Insert("Date",  DocDate);
		XDTOData.Insert("Number", DocNumber);
	
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then 
			XDTOData.Insert("Counterparty", CounterpartyRef);
			XDTOData.Insert("IncomingDocumentNumber", BXDocumentNumber);
		EndIf;
		Return;
	EndIf;
	
	XDTOData.KeyProperties.Insert("Date",  DocDate);
	XDTOData.KeyProperties.Insert("Number", DocNumber);
		
	CurrencyOfComplianceAccounting  = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(IBData.Organization);
	WarehouseForUnloading = WarehouseForUnloading(IBData.Warehouse, ExchangeComponents.ConversionParameters_SSLy);	
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		XDTOData.KeyProperties.Insert("IncomingDocumentNumber", BXDocumentNumber);
	Else
		XDTOData.Insert("IncomingDocumentNumber", BXDocumentNumber);
	EndIf;
	XDTOData.Insert("Warehouse",                   WarehouseForUnloading);
	
	UnloadDivisionFromDocumentDetail(ExchangeComponents, IBData, XDTOData, "Warehouse");
	UnloadVATTaxation(ExchangeComponents, IBData, XDTOData);
	
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.6") Then
		XDTOData.KeyProperties.Insert("Counterparty", CounterpartyRef);
	Else
		XDTOData.Insert("Counterparty", CounterpartyRef);
	EndIf;
	
	If IBData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
		
		XDTOData.Insert("OperationKind",          "PurchaseFromSupplier_");
		XDTOData.Insert("ARAPCurrency", IBData.ARAPCurrency);
		
		If IBData.Currency = CurrencyOfComplianceAccounting
			Or IBData.ARAPCurrency = CurrencyOfComplianceAccounting Then
			
			XDTOData.Insert("TransactionRate",      IBData.CourseNumerator);
			XDTOData.Insert("Multiplier_", IBData.CourseDenominator);
			
		Else
			UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
		EndIf;
		
	Else
		
		XDTOData.Insert("OperationKind",          "ConsignmentProcurement");
		XDTOData.Insert("ARAPCurrency", IBData.Currency);
		
		If IBData.Currency <> CurrencyOfComplianceAccounting Then
			UploadRateAndMultiplicityOfSettlements(XDTOData, IBData.Currency, IBData.Date, IBData.Organization);
		Else
			XDTOData.Insert("TransactionRate",      1);
			XDTOData.Insert("Multiplier_", 1);
		EndIf;
		
	EndIf;
	
	#Region Contract
	
	InstructionsContract = Undefined;
	If IBData.ARAPAccountingViaSeparateCounterparty
		And ValueIsFilled(IBData.PurchasingContract)
		And Common.RefExists(IBData.PurchasingContract) Then
		
		InstructionsContract = New Structure;
		InstructionsContract.Insert("OCRName",   "Catalog_CounterpartyContracts");
		InstructionsContract.Insert("Value", IBData.PurchasingContract);
		
	ElsIf ValueIsFilled(IBData.Contract) Then
		
		ContractData = ContractDataBetweenOrganizations(ExchangeComponents, IBData.Contract);
		InstructionsContract = New Structure("Value, OCRName", ContractData, "Catalog_ContractsOfCounterparties_FromStructure");
	
	Else
		DefaultParameters = New Structure(ContractFixedKeyStructure());
		DefaultParameters.Organization = IBData.CompanyRecipient;
		DefaultParameters.Counterparty  = CounterpartyRef;
		If IBData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
			DefaultParameters.TypeOfAgreement              = "WithVendor";
			DefaultParameters.ARAPCurrency     = IBData.ARAPCurrency;
			DefaultParameters.CalculationsInConventionalUnits = (IBData.Currency = CurrencyOfComplianceAccounting And IBData.Currency <> IBData.ARAPCurrency);
		Else
			DefaultParameters.TypeOfAgreement              = "WithConsignor";
			DefaultParameters.ARAPCurrency     = IBData.Currency;
			DefaultParameters.CalculationsInConventionalUnits = False;
		EndIf;
		
		InstructionsContract = ConversionAgreementBasedOnSettlementData(DefaultParameters,
			ExchangeComponents,
			IBData.Contract);
	EndIf;
	XDTOData.Insert("Contract", InstructionsContract);
	
	#EndRegion
	
	// Table parts
	QueryText =
	"SELECT
	|	""Goods"" AS TabularSectionName,
	|	T.ItemsLocationAttributes.Products AS Products,
	|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	SUM(1) AS RowsCount
	|INTO TTDocumentProducts
	|FROM
	|	Document.CustomerInvoiceIntercompany.Goods AS T
	|WHERE
	|	T.Ref = &Ref
	|
	|GROUP BY
	|	T.ItemsLocationAttributes.Products,
	|	T.ItemsLocationAttributes.Characteristic
	|
	|UNION ALL
	|
	|SELECT
	|	""InventoryKinds"",
	|	T.ItemsLocationAttributes.Products,
	|	T.ItemsLocationAttributes.Characteristic,
	|	SUM(1)
	|FROM
	|	Document.CustomerInvoiceIntercompany.InventoryKinds AS T
	|WHERE
	|	T.Ref = &Ref
	|
	|GROUP BY
	|	T.ItemsLocationAttributes.Products,
	|	T.ItemsLocationAttributes.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	""InventoryKinds"" AS TSInventoryKinds,
	|	T.LineNumber AS LineNumber,
	|	CASE
	|		WHEN Totals.RowsCount > 1
	|			THEN T.LineNumber
	|		ELSE 0
	|	END AS RowCode
	|INTO TTLineCodesForBatchAccountingAnalytics
	|FROM
	|	Document.CustomerInvoiceIntercompany.InventoryKinds AS T
	|		INNER JOIN TTDocumentProducts AS Totals
	|		ON T.ItemsLocationAttributes.Products = Totals.Products
	|			AND T.ItemsLocationAttributes.Characteristic = Totals.Characteristic
	|			AND (Totals.TabularSectionName = ""InventoryKinds"")
	|WHERE
	|	T.Ref = &Ref
	|;
	|	////////////////////////////////////////////////////////////////////////////////
	|	SELECT
	|		Goods.LineNumber AS LineNumber,
	|		Goods.Products AS Products,
	|		Goods.Products.UnitOfMeasure AS UnitOfMeasure,
	|		Goods.RowID AS RowID,
	|		Goods.Products.ItemsType AS ItemsType,
	|		Goods.Count AS Count,
	|		Goods.Price AS Price,
	|		Goods.Sum AS Sum,
	|		Goods.VATRate AS VATRate,
	|		Goods.VATAmount AS VATAmount,
	|		Goods.QuantityByGBRN AS QuantityByGBRN,
	|		Goods.ExpenseItem AS ExpenseItem,
	|		Goods.AmountIncludingVAT AS AmountIncludingVAT,
	|		Goods.Characteristic AS Characteristic,
	|		Goods.Series AS Series,
	|		Goods.Package AS Package,
	|		TTDocumentProducts.RowsCount AS RowsCount,
	|		Goods.NumberOfPackages AS NumberOfPackages,
	|		Goods.Ref AS Ref,
	|		Goods.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		Goods.CCDNumber AS CCDNumber
	|	INTO TemporaryTableOfGoods_Preliminary
	|	FROM
	|		Document.CustomerInvoiceIntercompany.Goods AS Goods
	|			LEFT JOIN TTDocumentProducts AS TTDocumentProducts
	|			ON (TTDocumentProducts.TabularSectionName = ""Goods"")
	|				AND (TTDocumentProducts.Products = Goods.Products)
	|				AND (TTDocumentProducts.Characteristic = Goods.Characteristic)
	|	WHERE
	|		Goods.Ref = &Ref
	|;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	SELECT
	|		TemporaryTableOfGoods_Preliminary.LineNumber AS LineNumber,
	|		TemporaryTableOfGoods_Preliminary.Products AS Products,
	|		TemporaryTableOfGoods_Preliminary.UnitOfMeasure AS UnitOfMeasure,
	|		TemporaryTableOfGoods_Preliminary.RowID AS RowID,
	|		TemporaryTableOfGoods_Preliminary.ItemsType AS ItemsType,
	|		TemporaryTableOfGoods_Preliminary.Count AS Count,
	|		TemporaryTableOfGoods_Preliminary.Price AS Price,
	|		TemporaryTableOfGoods_Preliminary.Sum AS Sum,
	|		TemporaryTableOfGoods_Preliminary.VATRate AS VATRate,
	|		TemporaryTableOfGoods_Preliminary.VATAmount AS VATAmount,
	|		TemporaryTableOfGoods_Preliminary.QuantityByGBRN AS QuantityByGBRN,
	|		TemporaryTableOfGoods_Preliminary.ExpenseItem AS ExpenseItem,
	|		TemporaryTableOfGoods_Preliminary.AmountIncludingVAT AS AmountIncludingVAT,
	|		TemporaryTableOfGoods_Preliminary.Characteristic AS Characteristic,
	|		TemporaryTableOfGoods_Preliminary.Series AS Series,
	|		TemporaryTableOfGoods_Preliminary.Package AS Package,
	|		TemporaryTableOfGoods_Preliminary.RowsCount AS RowsCount,
	|		TemporaryTableOfGoods_Preliminary.NumberOfPackages AS NumberOfPackages,
	|		TTLineCodesForBatchAccountingAnalytics.RowCode AS RowCode,
	|		TemporaryTableOfGoods_Preliminary.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		TemporaryTableOfGoods_Preliminary.Ref AS Ref,
	|		TemporaryTableOfGoods_Preliminary.CCDNumber AS CCDNumber
	|	INTO TemporaryTableProductsTotal
	|	FROM
	|		TemporaryTableOfGoods_Preliminary AS TemporaryTableOfGoods_Preliminary
	|			LEFT JOIN TTLineCodesForBatchAccountingAnalytics AS TTLineCodesForBatchAccountingAnalytics
	|			ON (TemporaryTableOfGoods_Preliminary.LineNumber = TTLineCodesForBatchAccountingAnalytics.LineNumber)
	|;
	|//////////////////////////////////////////////////////////////////////////////// 
	|	SELECT DISTINCT
	|		TemporaryTableProductsTotal.Products AS Products,
	|		MAX(TemporaryTableProductsTotal.LineNumber) AS LineNumber
	|	INTO TableProductsByMaxRow
	|	FROM
	|		TemporaryTableProductsTotal AS TemporaryTableProductsTotal
	|	
	|	GROUP BY
	|		TemporaryTableProductsTotal.Products
	|	
	|	INDEX BY
	|		Products
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	SELECT
	|		ISNULL(TemporaryTableProductsTotal.LineNumber, 0) AS LineNumber,
	|		AnalyticsPA.Products AS Products,
	|		ISNULL(TemporaryTableProductsTotal.UnitOfMeasure, AnalyticsPA.Products.UnitOfMeasure) AS UnitOfMeasure,
	|		AnalyticsPA.Products.ItemsType AS ItemsType,
	|		InventoryKinds.Count AS Count,
	|		CASE
	|			WHEN TemporaryTableProductsTotal.Price IS NULL
	|				THEN CAST(CASE
	|							WHEN InventoryKinds.Ref.PriceIncludesVAT
	|								THEN InventoryKinds.AmountIncludingVAT / InventoryKinds.Count
	|							ELSE (InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount) / InventoryKinds.Count
	|					  END AS NUMBER(31, 2))
	|			ELSE TemporaryTableProductsTotal.Price
	|		END AS Price,
	|		CASE
	|			WHEN InventoryKinds.Ref.PriceIncludesVAT
	|				THEN InventoryKinds.AmountIncludingVAT
	|			ELSE InventoryKinds.AmountIncludingVAT - InventoryKinds.VATAmount
	|		END AS Sum,
	|		InventoryKinds.VATRate AS VATRate,
	|		InventoryKinds.VATAmount AS VATAmount,
	|		CASE
	|			WHEN &SpecifyCCDNumbers AND NOT TemporaryTableProductsTotal.CCDNumber IS Null 
	|				THEN TemporaryTableProductsTotal.CCDNumber
	|			ELSE InventoryKinds.CCDNumber
	|		END AS CCDNumber,
	|		InventoryKinds.QuantityByGBRN AS QuantityByGBRN,
	|		InventoryKinds.ExpenseItem AS ExpenseItem,
	|		InventoryKinds.RowID AS RowID,
	|		InventoryKinds.AmountIncludingVAT AS AmountIncludingVAT,
	|		AnalyticsPA.Characteristic AS Characteristic,
	|		AnalyticsPA.Series AS Series,
	|		InventoryKinds.Package AS Package,
	|		TemporaryTableProductsTotal.RowsCount AS RowsCount,
	|		InventoryKinds.NumberOfPackages AS NumberOfPackages
	|		INTO TypesOfStocksGoods
	|		FROM
	|		Document.CustomerInvoiceIntercompany.InventoryKinds AS InventoryKinds
	|			LEFT JOIN TemporaryTableProductsTotal AS TemporaryTableProductsTotal
	|			ON (TemporaryTableProductsTotal.ItemsLocationAttributes = InventoryKinds.ItemsLocationAttributes)
	|				AND (InventoryKinds.Ref = TemporaryTableProductsTotal.Ref)
	|				AND (CASE
	|					WHEN NOT TemporaryTableProductsTotal.RowsCount IS NULL
	|							AND TemporaryTableProductsTotal.RowsCount > 1
	|						THEN TemporaryTableProductsTotal.RowCode = InventoryKinds.LineNumber
	|					ELSE TRUE
	|				END)
	|			LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsPA
	|			ON (InventoryKinds.ItemsLocationAttributes = AnalyticsPA.DimensionKey)
	|		WHERE
	|		InventoryKinds.Ref = &Ref	
	|;
	|
	|	////////////////////////////////////////////////////////////////////////////////
	|	SELECT
	|		CASE
	|			WHEN TypesOfStocksGoods.LineNumber = 0
	|				THEN TableProductsByMaxRow.LineNumber
	|			ELSE TypesOfStocksGoods.LineNumber
	|		END AS LineNumber,
	|		TypesOfStocksGoods.Products AS Products,
	|		TypesOfStocksGoods.UnitOfMeasure AS UnitOfMeasure,
	|		TypesOfStocksGoods.ItemsType AS ItemsType,
	|		TypesOfStocksGoods.RowID AS RowID,
	|		TypesOfStocksGoods.Count AS Count,
	|		TypesOfStocksGoods.Price AS Price,
	|		TypesOfStocksGoods.Sum AS Sum,
	|		TypesOfStocksGoods.VATRate AS VATRate,
	|		TypesOfStocksGoods.VATAmount AS VATAmount,
	|		TypesOfStocksGoods.CCDNumber AS CCDNumber,
	|		TypesOfStocksGoods.QuantityByGBRN AS QuantityByGBRN,
	|		TypesOfStocksGoods.ExpenseItem AS ExpenseItem,
	|		TypesOfStocksGoods.AmountIncludingVAT AS AmountIncludingVAT,
	|		TypesOfStocksGoods.Characteristic AS Characteristic,
	|		TypesOfStocksGoods.Series AS Series,
	|		TypesOfStocksGoods.Package AS Package,
	|		TypesOfStocksGoods.RowsCount AS RowsCount,
	|		TypesOfStocksGoods.NumberOfPackages AS NumberOfPackages
	|	INTO TemporaryTableOfGoods_
	|	FROM
	|		TypesOfStocksGoods AS TypesOfStocksGoods
	|			LEFT JOIN TableProductsByMaxRow AS TableProductsByMaxRow
	|			ON (CASE
	|					WHEN TypesOfStocksGoods.LineNumber = 0
	|						THEN TypesOfStocksGoods.Products = TableProductsByMaxRow.Products
	|					ELSE FALSE
	|				END)
	|;
	|	
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TemporaryTableProductsTotal.Products AS Products,
	|	TemporaryTableProductsTotal.Products.Description AS Content,
	|	TemporaryTableProductsTotal.Count AS Count,
	|	TemporaryTableProductsTotal.Price AS Price,
	|	TemporaryTableProductsTotal.Sum AS Sum,
	|	TemporaryTableProductsTotal.VATRate AS VATRate,
	|	TemporaryTableProductsTotal.VATAmount AS VATAmount
	|FROM
	|	TemporaryTableProductsTotal AS TemporaryTableProductsTotal
	|WHERE
	|	(TemporaryTableProductsTotal.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|			OR TemporaryTableProductsTotal.ItemsType = VALUE(Enum.ItemsTypes.Work_5))
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.Products AS Products,
	|	NestedQuery.UnitOfMeasure AS UnitOfMeasure,
	|	NestedQuery.Price AS Price,
	|	NestedQuery.VATRate AS VATRate,
	|	NestedQuery.DocumentRowNumber AS DocumentRowNumber,
	|	NestedQuery.Count AS Count,
	|	NestedQuery.RowID AS RowID,
	|	NestedQuery.Sum AS Sum,
	|	NestedQuery.VATAmount AS VATAmount,
	|	&QueryTextCharacteristic,
	|	&QueryTextSeries,
	|	&QueryTextPackage,
	|	&QueryTextProductBatchID,
	|	NestedQuery.CCDNumber AS CCDNumber
	|FROM
	|	(SELECT
	|		TemporaryTableOfGoods_.Products AS Products,
	|		TemporaryTableOfGoods_.UnitOfMeasure AS UnitOfMeasure,
	|		TemporaryTableOfGoods_.Price AS Price,
	|		TemporaryTableOfGoods_.VATRate AS VATRate,
	|		TemporaryTableOfGoods_.RowID AS RowID,
	|		TemporaryTableOfGoods_.CCDNumber AS CCDNumber,
	|		TemporaryTableOfGoods_.LineNumber AS DocumentRowNumber,
	|		SUM(TemporaryTableOfGoods_.Count) AS Count,
	|		SUM(TemporaryTableOfGoods_.QuantityByGBRN) AS QuantityByGBRN,
	|		SUM(TemporaryTableOfGoods_.Sum) AS Sum,
	|		SUM(TemporaryTableOfGoods_.VATAmount) AS VATAmount,
	|		TemporaryTableOfGoods_.Characteristic AS Characteristic,
	|		TemporaryTableOfGoods_.Series AS Series,
	|		TemporaryTableOfGoods_.Package AS Package,
	|		SUM(TemporaryTableOfGoods_.NumberOfPackages) AS NumberOfPackages
	|	FROM
	|		TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
	|WHERE
	|	TemporaryTableOfGoods_.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
	|			AND TemporaryTableOfGoods_.ItemsType <> VALUE(Enum.ItemsTypes.Work_5)
	|	
	|	GROUP BY
	|		TemporaryTableOfGoods_.Products,
	|		TemporaryTableOfGoods_.UnitOfMeasure,
	|		TemporaryTableOfGoods_.Price,
	|		TemporaryTableOfGoods_.VATRate,
	|		TemporaryTableOfGoods_.CCDNumber,
	|		TemporaryTableOfGoods_.LineNumber,
	|		TemporaryTableOfGoods_.RowID,
	|		TemporaryTableOfGoods_.Characteristic,
	|		TemporaryTableOfGoods_.Series,
	|		TemporaryTableOfGoods_.Package) AS NestedQuery
	|
	|ORDER BY
	|	DocumentRowNumber";
	
	QueryText = StrReplace(QueryText, "&QueryTextCharacteristic",
		GetTextOfCharacteristicsRequest(ExchangeComponents, "NestedQuery"));
		
	QueryText = StrReplace(QueryText, "&QueryTextPackage",
		GetPackagingRequestText(ExchangeComponents, "NestedQuery"));
		
	QueryText = StrReplace(QueryText, "&QueryTextSeries",
		GetSeriesRequestText(ExchangeComponents, "NestedQuery"));
	
	QueryText = StrReplace(QueryText, "&QueryTextProductBatchID",
		GetTextOfRNPTRequest(ExchangeComponents, "NestedQuery"));
		
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) >= NumberFormatVersion("1.10") Then
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest","NestedQuery.CCDNumber"); 
	ElsIf NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) <= NumberFormatVersion("1.8") Then
	    QueryText = StrReplace(QueryText, "NestedQuery.CCDNumber", "IsNull(NestedQuery.CCDNumber.Code, """")");
	Else
		QueryText = StrReplace(QueryText, "&TextOfCCDRequest", "NestedQuery.CCDNumber.Code");
	EndIf;
		
	Query = New Query(QueryText);
	Query.SetParameter("Ref", IBData.Ref);
	Query.SetParameter("SpecifyCCDNumbers", IBData.SpecifyCCDNumbers);
	
	QueryResults = Query.ExecuteBatch();
	GoodsTable     = QueryResults[QueryResults.Count()-1].Unload();
	FillInCharacteristicsOfWHPackage(ExchangeComponents, GoodsTable);
	GoodsTable.Columns.Add("InventoryType");
	
	If XDTOData.OperationKind = "ConsignmentProcurement" Then
		GoodsTable.FillValues("CommissionGoods", "InventoryType");
	Else
		GoodsTable.FillValues("СобственныеТовары", "InventoryType"); //@NON-NLS-1
		Services = QueryResults[QueryResults.Count()-2].Unload();
		If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
			RedefineVATRateForOldFormats(Services, False);
		EndIf;  
		
		// Services are unloaded only for the implementation operation to another organization.
		XDTOData.Insert("Services", Services);
	EndIf;
	
	FillInTypeOfActivityOfNDSVTCH(ExchangeComponents, IBData, GoodsTable, "PurchaseForActivity", "TransferForActivity_");
	If NumberFormatVersion(ExchangeComponents.ExchangeFormatVersion) < NumberFormatVersion("1.17") Then   
		 RedefineVATRateForOldFormats(GoodsTable, False);
	EndIf;
	XDTOData.Insert("Goods", GoodsTable);
	UploadAdditionalAttributesAndInfo(ExchangeComponents, IBData, XDTOData);
EndProcedure

