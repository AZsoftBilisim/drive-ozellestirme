// Generates A New Layout Template after replacing the parameters in the expressions of the resulting fields
// Called from the Cost of goods report.
//
// Parameters:
//  DataCompositionTemplate - DataCompositionTemplate - the Original Template generated in the report 
//  DataCompositionSchema - DataCompositionSchema - the layout scheme of the report, which has a parameter using 
//							turn-by-turnanalysts and this parameter is specified in the expressions of the final fields
//	ReportSettings - DataCompositionSettings - settings that will be used to Create a new Layout Template
//	DetailsData - DataCompositionDetailsData - report decryption data.
//
Procedure OptimizingUseOfReverseAnalytics(DataCompositionTemplate, DataCompositionSchema, ReportSettings, Val DetailsData) Export

	ReverseAnalyticsIsUsed = False;
	
	For Each LinkingDatasets In DataCompositionTemplate.DataSetLinks Do 
		If LinkingDatasets.SourceDataSet = "ReverseAnalytics" 
			Or LinkingDatasets.DestinationDataSet = "ReverseAnalytics" Then
			
			ReverseAnalyticsIsUsed = True;
			Break;
		EndIf;
	EndDo;
	
	If DataCompositionTemplate.DataSets.Find("Documents") <> Undefined Then
		ReverseAnalyticsIsUsed = True;
	EndIf;
	
	DataCompositionClientServer.SetParameter(ReportSettings, "ReverseAnalyticsIsUsed", ReverseAnalyticsIsUsed);
	
	For Each TotalField In DataCompositionSchema.TotalFields Do 
		If StrFind(TotalField.Expression, "&ReverseAnalyticsIsUsed") <> 0 Then
			NameOfMainAnalyticsSummaryField = TotalField.DataPath;
			NameParts = StringFunctionsClientServer.SplitStringIntoWordArray(NameOfMainAnalyticsSummaryField, ".");
			NameOfDocumentSummaryField = "Doc_" + NameParts[NameParts.Count()-1];
			TotalExpression = StringFunctionsClientServer.SubstituteParametersToString("Sum(%1)",
					?(ReverseAnalyticsIsUsed, NameOfDocumentSummaryField, NameOfMainAnalyticsSummaryField));
			TotalField.Expression = StrReplace(TotalField.Expression, "&ReverseAnalyticsIsUsed", TotalExpression);
		EndIf;
	EndDo;
	
	TemplateComposer = New DataCompositionTemplateComposer;
	DataCompositionTemplate = TemplateComposer.Execute(DataCompositionSchema, ReportSettings, DetailsData);

EndProcedure

// Calculates the ordinal position of a number relative to other numbers in the array after sorting it.
//
// Parameters:
//	DataCompositionGroupProcessingData - Structure - structure with properties:
//	 *Data - ValueTable - the SKD table being processed, the place is determined for the values of the first column
//	 *CurrentItem - ValueTableRow - current row of the value table.
//	SortingOrder - DataCompositionSortDirection - determines whether the ordinal position will be calculated at the top or bottom of the array.
//
// Returns:
//	Number - SKD field
//
Function PlaceInSequence(DataCompositionGroupProcessingData, SortingOrder) Export
	PlaceInSequence = 0;
	
	Data			= DataCompositionGroupProcessingData.Data;
	FieldName			= DataCompositionGroupProcessingData.Data.Columns[0].Name;
	
	If DataCompositionGroupProcessingData.CurrentItem <> Undefined Then
		Simple	= DataCompositionGroupProcessingData.CurrentItem[0];
		
		If Simple = 0 Then
			Return	"<>";
		EndIf;
		
		DataCopy = Data.Copy();
		DataCopy.Sort(FieldName + " " + SortingOrder);
		
		SearchRow = DataCopy.Find(Simple, FieldName);
		
		If SearchRow <> Undefined Then
			PlaceInSequence = DataCopy.IndexOf(SearchRow) + 1;
		EndIf;
	EndIf;
	
	Return PlaceInSequence;
EndFunction

// Calculates the amount of unclassified turnover for reports that use turnover Analytics
// Called when calculating the amounts of resources.
//
// Parameters:
//	DataCompositionGroupProcessingData - Structure - structure with properties:
//	 *Data - ValueTable - data table.
//			The composition of the columns of the processed data: 
//				"Turnaround analytics" - a column with the values of turnaround analytics.
//				"Resource name" - the resources column of the main data set.
//				"About the resource name" - the resource column of the document dataset. The name is formed by adding
//						the prefix "Ob_" to the column name of the resource name.
//				"Doc_name of the resource" is the resource column of the data set for turnover analysts. The name is formed by
//						adding the prefix "Ob_" to the column name of the resource name.
//	 *CurrentItem - ValueTableRow - Current row of the data table.
//	 *ProcessingTempData - Structure - Structure with properties (optional):
//	   **CumulativeTurnover - Number - The turnover is cumulative.
//	   **UnclassifiedTurnover - Number - Unclassified turnover.
//	   **ProcessedAnalyticsValue - Arbitrary - The processed Analytics value.
//	ResourceName - String - name of the resource being processed.
//	ResourceSummary - Number, Null - A calculated result.
//	NameOfReverseAnalytics - String - name of the Analytics being processed.
//	DimensionValue - Arbitrary - the value of analytics.
//
// Returns:
//	Number - the total for the field.
//
Function ClassificationOfTurnover(DataCompositionGroupProcessingData, ResourceName, ResourceSummary, NameOfReverseAnalytics, DimensionValue) Export
	Data = DataCompositionGroupProcessingData.Data;
	CurrentRow = DataCompositionGroupProcessingData.CurrentItem;
	TemporaryData = DataCompositionGroupProcessingData.ProcessingTempData;
	TurnoverValue = 0;
	
	If Not TemporaryData.Property("CumulativeTurnover") Then
		TemporaryData.Insert("CumulativeTurnover", 0);
	EndIf;
	If Not TemporaryData.Property("UnclassifiedTurnover") Then
		TemporaryData.Insert("UnclassifiedTurnover", ?(ResourceSummary = Null, 0, ResourceSummary));
	EndIf;
	If Not TemporaryData.Property("ProcessedAnalyticsValue") Then
		TemporaryData.Insert("ProcessedAnalyticsValue", New Map);
	EndIf;
	
	If CurrentRow <> Undefined Then
		UpdateTemporaryData = 
			// Calculation at the 1st level of grouping
			(DimensionValue <> Null And TemporaryData.ProcessedAnalyticsValue[DimensionValue] = Undefined)
			// Calculation at the 2nd and more levels of grouping
			Or (DimensionValue = Null And TemporaryData.ProcessedAnalyticsValue.Count() = 0);

		If CurrentRow["Doc_"+ ResourceName] = Null Then
			TurnoverValue = 0;
		ElsIf CurrentRow["turn_"+ ResourceName] > CurrentRow["Doc_"+ ResourceName] Then
			TurnoverValue = CurrentRow["Doc_"+ ResourceName];
		Else
			TurnoverValue = CurrentRow["turn_"+ ResourceName];
		EndIf;
		
		TurnoverValue = ?(TurnoverValue = Null, 0, TurnoverValue);
		
		If UpdateTemporaryData Then
			TemporaryData.Insert("CumulativeTurnover", 
				TemporaryData.CumulativeTurnover + TurnoverValue);
				
			TemporaryData.Insert("UnclassifiedTurnover", 
				TemporaryData.UnclassifiedTurnover - TurnoverValue);
		EndIf;
		
		If DimensionValue = Null Then
			TurnoverValue = TemporaryData.UnclassifiedTurnover;
		EndIf;
		
		TemporaryData.ProcessedAnalyticsValue.Insert(DimensionValue, DimensionValue);
	Else 
		If Data.Total("Doc_"+ ResourceName) = Null Then
			TurnoverValue = 0;
		ElsIf Data.Total("turn_"+ ResourceName) > Data.Total("Doc_"+ ResourceName) Then
			TurnoverValue = Data.Total("Doc_"+ ResourceName);
		Else
			TurnoverValue = Data.Total("turn_"+ ResourceName);
		EndIf;
	EndIf;
	
	Return TurnoverValue;
EndFunction

