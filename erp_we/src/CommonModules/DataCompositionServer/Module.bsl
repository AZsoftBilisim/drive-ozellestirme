// The options Componentdesigner.Virusisolator
// 
// Returns:
//  Structure:
//  * CompositionSchema - String - an address in temporary storage
//								or the full name of the layout, such as a Document.Realizationduring.Data from the message template.
//						- DataCompositionSchema - the actual data layout scheme.
//  * CompositionSettings - String - address in the temporary storage of layout settings or the name of the layout settings option.
//						- DataCompositionSettings - the actual layout settings.
//						- Undefined - the default settings will be applied. 
//  * ExpectedColumns - ValueTable - if the columns described in the layout are disabled by FO,
//					they will be missing in the table(tree) of values obtained after using the layout
//					.if this parameter is passed, the function will add the missing columns to the resulting table(tree) of values
//					.
//  * ExecuteInPrivilegedMode - Boolean - the default value is False.
//  * ResultType - String - possible value: ""Table values"", "tree Values"", default value ""table Values"".
//  * ExternalDataSets - Structure, Undefined - external data layout sets
//									. if a structure is passed, the key is the name of the external set,
//									and the value is the table of values of the external set.
//  * CanUseExternalFunctions - Boolean - Specifies whether
//														the shared configuration modules function can be used in data layout expressions
//														. the default value is True.
//
Function ParametersUploadDCSResult() Export
	
	Result = New Structure;
	Result.Insert("CompositionSchema", "");
	Result.Insert("CompositionSettings", Undefined);
	Result.Insert("ExpectedColumns", New ValueTable);
	Result.Insert("ExecuteInPrivilegedMode", False);
	Result.Insert("ExternalDataSets", Undefined);
	Result.Insert("CanUseExternalFunctions", True);
	Result.Insert("ResultType", "ValueTable");
	
	Return Result;
	
EndFunction

// Executes the layout layout by applying settings, and returns a table of values or a tree of values
//
// Parameters:
//  Parameters - See DataCompositionServer.ParametersUploadDCSResult
//  TempStorageAddress - String - if the temporary storage address is passed in this parameter,
//  				the resulting table is placed at this address.
// 
// Returns:
//  ValueTable, String - the resulting table of values or its address in the temporary storage 
//
Function UploadDCSResults(Parameters, TempStorageAddress = "") Export
	
	If Parameters.ExecuteInPrivilegedMode Then
		SetPrivilegedMode(True);
	EndIf;
	
	CompositionSchema = LayoutDiagramByParameter(Parameters.CompositionSchema);
	
	TemplateComposer = New DataCompositionTemplateComposer;
	CompositionTemplate = TemplateComposer.Execute(CompositionSchema,
		LayoutSettingsByParameter(CompositionSchema, Parameters.CompositionSettings),,,
		Type("DataCompositionValueCollectionTemplateGenerator"));
		
	CompositionProcessor = New DataCompositionProcessor;
	If Parameters.ExternalDataSets = Undefined Then
		CompositionProcessor.Initialize(CompositionTemplate,,,Parameters.CanUseExternalFunctions);
	Else
		CompositionProcessor.Initialize(CompositionTemplate,
			Parameters.ExternalDataSets,,
			Parameters.CanUseExternalFunctions);
	EndIf;
	
	If Parameters.ResultType = "ValueTable" Then
		ResultingTable = New ValueTable;
	ElsIf Parameters.ResultType = "ValueTree" Then
		ResultingTable = New ValueTree;
	Else
		ExceptionText = NStr("vi = 'Loại kết quả không xác định %ResultType%';
							|ru = 'Неизвестный тип результата %ResultType%';
							|en = 'Unknown result type %ResultType%'; fa = 'Unknown result type %ResultType%';
							|it = 'Tipo di risultato sconosciuto %ResultType%';
							|pl = 'Nieznany typ wyniku %ResultType%';
							|tr = '%ResultType% bilinmeyen sonuç tipi'");
		ExceptionText = StrReplace(ExceptionText, "%ResultType%", Parameters.ResultType);
	EndIf;
	
	OutputProcessor = New DataCompositionResultValueCollectionOutputProcessor;
	OutputProcessor.SetObject(ResultingTable);	
	ResultingTable = OutputProcessor.Output(CompositionProcessor);
	
	If Parameters.ExecuteInPrivilegedMode Then
		SetPrivilegedMode(False);
	EndIf;
	
	ExpectedColumns = Parameters.ExpectedColumns; // ValueTable -
	For Each Column In ExpectedColumns.Columns Do
		If ResultingTable.Columns.Find(Column.Name) = Undefined Then
			ResultingTable.Columns.Add(Column.Name, Column.ValueType);
		EndIf;
	EndDo;

	If IsTempStorageURL(TempStorageAddress) Then
		PutToTempStorage(ResultingTable, TempStorageAddress);
		Return TempStorageAddress;
	Else
		Return ResultingTable;
	EndIf;
	
EndFunction

// Initialize the data layout settings linker.
// You can pass the data layout scheme directly in the parameter, or set the layout name (address)
//
// Parameters:
//  SettingsComposer - DataCompositionSettingsComposer
//  DataCompositionSchema - String, DataCompositionSchema - the address of the temporary storage layout scheme
//											or the full name of the layout, such as a Document.Realizationduring.Data
//											from the message template or the actual layout diagram.
//  CompositionSettings - String - address in the temporary storage of layout settings or the name of the layout settings option.
//						- DataCompositionSettings - the actual layout settings.
//						- Undefined - the default settings will be applied.
//
Procedure InitializeSettingsComposer(SettingsComposer, Val DataCompositionSchema, Val CompositionSettings = Undefined) Export
	
	DataCompositionSchema = LayoutDiagramByParameter(DataCompositionSchema);
	
	URLSchemes = PutToTempStorage(DataCompositionSchema, New UUID());
	SettingsSource = New DataCompositionAvailableSettingsSource(URLSchemes);
	SettingsComposer.Initialize(SettingsSource);
	
	CompositionSettings = LayoutSettingsByParameter(DataCompositionSchema, CompositionSettings); 
	SettingsComposer.LoadSettings(CompositionSettings);
	
	SettingsComposer.Refresh(DataCompositionSettingsRefreshMethod.CheckAvailability);
	
EndProcedure

// Fills the array of layout elements.
// 
// Parameters:
// 	ItemsCollection - DataCompositionConditionalAppearanceItemCollection, DataCompositionSelectedFieldCollection, DataCompositionFilterItemCollection, DataCompositionOrderItemCollection - LongDesc
// 	ItemArray - Array of DataCompositionSelectedField - array of elements.
// 	SearchValues - DataCompositionField, Array of DataCompositionField - the search value.
Procedure FindSelectedFieldRecursively(ItemsCollection, ItemArray, SearchValues) Export

	If TypeOf(SearchValues) = Type("DataCompositionField") Then
		SearchValues = CommonClientServer.ValueInArray(SearchValues);
	EndIf;
	
	For Each Item In ItemsCollection Do
		
		If TypeOf(Item) = Type("DataCompositionSelectedField") Then
			For Each SearchValue In SearchValues Do
				If Item.Field = SearchValue Then
					ItemArray.Add(Item);
				EndIf;
			EndDo;
		
		ElsIf TypeOf(Item) = Type("DataCompositionAutoSelectedField") Then
			
			Continue;
			
		Else
			
			FindSelectedFieldRecursively(Item.Items, ItemArray, SearchValues);
			
		EndIf;
		
	EndDo;

EndProcedure

