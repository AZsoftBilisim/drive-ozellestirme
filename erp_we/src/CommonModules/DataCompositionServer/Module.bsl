// Returns a structure for substituting headers for the weight, volume, and quantity grouping table fields by unit of measurement.
//
// Parameters:
//	SettingsComposer - DataCompositionSettingsComposer - the report settings.
//	OverridingHeaders - Structure - allows you to override headers, may contain properties:
//		* TotalInStorageUnits - String -
//		* TotalInUnitsForReports - String -
//
// Returns:
//	Structure - the key specifies the template for replacing the header, and the value specifies the replacement value.
//
Function UnitFieldHeaders(SettingsComposer, OverridingHeaders = Undefined) Export
	
	TheStructureOfTheHeaders = New Structure;
	
	If OverridingHeaders = Undefined Then
		OverridingHeaders = New Structure;
	EndIf;
	If Not OverridingHeaders.Property("TotalInStorageUnits") Then
		OverridingHeaders.Insert("TotalInStorageUnits", NStr("vi = 'Tổng số hàng hóa theo đơn vị lưu kho';
															|ru = 'Итого товаров в единицах хранения';
															|en = 'Total goods in stock UOM'; fa = 'Total goods in stock UOM';
															|it = 'Articoli totali in unità di archiviazione';
															|pl = 'Łącznie towarów w jednostkach przechowywania';
															|tr = 'Stok ölçü biriminde toplam ürün sayısı'"));
	EndIf;
	If Not OverridingHeaders.Property("TotalInUnitsForReports") Then
		OverridingHeaders.Insert("TotalInUnitsForReports", NStr("vi = 'Tổng số hàng hóa theo các đơn vị báo cáo';
																|ru = 'Итого товаров в единицах для отчетов';
																|en = 'Total goods in units for reports'; fa = 'Total goods in units for reports';
																|it = 'Totali merci in unità di stoccaggio per i report';
																|pl = 'Łącznie towarów w jednostkach dla raportów';
																|tr = 'Stok ölçü biriminde toplam ürün sayısı'"));
	EndIf;
	
	WeightUnit = String(Constants.UnitOfMeasureForWeight.Get());
	VolumeUnit = String(Constants.UnitOfMeasureForVolume.Get());
	
	QuantityUnitParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "QuantityUnits");
	
	If QuantityUnitParameter <> Undefined And QuantityUnitParameter.Value = 0 Then
		TitleEd = OverridingHeaders.TotalInStorageUnits;
	Else
		TitleEd = OverridingHeaders.TotalInUnitsForReports;
	EndIf;
	
	TheStructureOfTheHeaders.Insert("WeightUnit", WeightUnit);
	TheStructureOfTheHeaders.Insert("VolumeUnit", VolumeUnit);
	TheStructureOfTheHeaders.Insert("HeadingOfEDDimension", TitleEd);

	Return TheStructureOfTheHeaders;
	
EndFunction

// Returns a match to replace the headers of the weight, volume fields and the quantity grouping table by units of measurement.
//
// Parameters:
//	SettingsComposer - DataCompositionSettingsComposer - the report settings.
//
// Returns:
//	Map - the key specifies the template for replacing the header, and the value specifies the replacement value.
//
Function MatchingUnitFieldHeaders(SettingsComposer) Export
	
	TitlesMap = New Map;
	
	WeightUnit = String(Constants.UnitOfMeasureForWeight.Get());
	VolumeUnit = String(Constants.UnitOfMeasureForVolume.Get());
	
	QuantityUnitParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "QuantityUnits");
	
	If QuantityUnitParameter <> Undefined
		And QuantityUnitParameter.Value = 0 Then
		TitleEd = NStr("vi = 'Tổng số hàng hóa theo các đơn vị lưu kho';
						|ru = 'Итого товаров в единицах хранения';
						|en = 'Total goods in stock UOM'; fa = 'Total goods in stock UOM';
						|it = 'Articoli totali in unità di archiviazione';
						|pl = 'Łącznie towarów w jednostkach przechowywania';
						|tr = 'Stok ölçü biriminde toplam ürün sayısı'");
	Else
		TitleEd = NStr("vi = 'Tổng số hàng hóa theo đơn vị báo cáo';
						|ru = 'Итого товаров в единицах для отчетов';
						|en = 'Total goods in units for reports'; fa = 'Total goods in units for reports';
						|it = 'Totali merci in unità di stoccaggio per i report';
						|pl = 'Łącznie towarów w jednostkach dla raportów';
						|tr = 'Stok ölçü biriminde toplam ürün sayısı'");
	EndIf;
	
	TitlesMap.Insert("12", WeightUnit); // WeightUnit
	TitlesMap.Insert("13", VolumeUnit); // VolumeUnit
	TitlesMap.Insert("11", TitleEd); // HeadingOfEDDimension

	Return TitlesMap;
	
EndFunction

