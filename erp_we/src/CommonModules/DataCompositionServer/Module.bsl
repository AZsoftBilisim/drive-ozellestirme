// Deletes the selected field from the settings and user settings of the report
//
// Parameters:
//  DataCompositionSettings - DataCompositionSettingsComposer, DataCompositionSettings, DataCompositionGroup, DataCompositionTableGroup -
//  ItemsNames - String, Array of String - name of the item to be deleted.
//  SearchInDimensions - Boolean - Search for a field in the selected dimension fields of the first-level report.
//
Procedure DeleteSelectedFieldFromAllReportSettings(DataCompositionSettings, ItemsNames, SearchInDimensions = False) Export
	
	If TypeOf(DataCompositionSettings) = Type("DataCompositionSettingsComposer") Then
		Settings = DataCompositionSettings.Settings;
		UserSettings = DataCompositionSettings.UserSettings;
	ElsIf TypeOf(DataCompositionSettings) = Type("DataCompositionSettings")
		Or TypeOf(DataCompositionSettings) = Type("DataCompositionGroup")
		Or TypeOf(DataCompositionSettings) = Type("DataCompositionTableGroup") Then
		Settings = DataCompositionSettings;
		UserSettings = New DataCompositionUserSettings;
	Else
		Return
	EndIf;
	
	If TypeOf(ItemsNames) = Type("String") Then
		CollectionOfElementNames = New Array;
	Else
		CollectionOfElementNames = ItemsNames;
	EndIf;
	
	SearchValues = New Array;
	For Each TagName In CollectionOfElementNames Do
		SearchValues.Add(New DataCompositionField(TagName));
	EndDo;
	
	ItemArray = New Array; // Array of DataCompositionSelectedField -
	
	SelectedFields = Settings.Selection;
	IDOfCustomSettingOfSelectedFields = SelectedFields.UserSettingID;
	
	FindSelectedFieldRecursively(SelectedFields.Items, ItemArray, SearchValues);
	
	If SearchInDimensions Then
		For Each ReportStructureElement In Settings.Structure Do
			If TypeOf(ReportStructureElement) = Type("DataCompositionGroup") Then
				FindSelectedFieldRecursively(ReportStructureElement.Selection.Items, ItemArray, SearchValues);
			EndIf;
		EndDo;
	EndIf;
	
	For Each Item In ItemArray Do
		
		IDOfElementSCustomSetting = Settings.Selection.GetIDByObject(Item);
		If Item.Parent <> Undefined Then
			Item.Parent.Items.Delete(Item);
		Else
			SelectedFields.Items.Delete(Item);
		EndIf;
		
		CustomSettingsOfSelectedFields = UserSettings.Items.Find(IDOfCustomSettingOfSelectedFields);
		If CustomSettingsOfSelectedFields <> Undefined Then
			ItemTheCustomSettings = CustomSettingsOfSelectedFields.GetObjectByID(IDOfElementSCustomSetting);
			If ItemTheCustomSettings <> Undefined Then
				If ItemTheCustomSettings.Parent <> Undefined Then
					ItemTheCustomSettings.Parent.Items.Delete(ItemTheCustomSettings);
				Else
					CustomSettingsOfSelectedFields.Items.Delete(ItemTheCustomSettings);
				EndIf;
			EndIf;
		EndIf;
		
	EndDo;
	
EndProcedure


// Deletes the selected field from the settings and user settings of the report
//
// Parameters:
//  DataCompositionSettings - DataCompositionSettingsComposer, DataCompositionSettings, DataCompositionGroup, DataCompositionTableGroup - 
//  TagName - String - the name of the element whose parent will be deleted.
//
Procedure DeleteGroupOfSelectedFieldFromAllReportSettings(DataCompositionSettings, TagName) Export
	
	If TypeOf(DataCompositionSettings) = Type("DataCompositionSettingsComposer") Then
		Settings = DataCompositionSettings.Settings;
		UserSettings = DataCompositionSettings.UserSettings;
	ElsIf TypeOf(DataCompositionSettings) = Type("DataCompositionSettings")
		Or TypeOf(DataCompositionSettings) = Type("DataCompositionGroup")
		Or TypeOf(DataCompositionSettings) = Type("DataCompositionTableGroup") Then
		Settings = DataCompositionSettings;
		UserSettings = New DataCompositionUserSettings;
	Else
		Return
	EndIf;
	
	SearchValue = New DataCompositionField(TagName);
	ItemArray = New Array; // Array of DataCompositionSelectedField -
	
	SelectedFields = Settings.Selection;
	IDOfCustomSettingOfSelectedFields = SelectedFields.UserSettingID;
	
	FindSelectedFieldRecursively(SelectedFields.Items, ItemArray, SearchValue);
	For Each Item In ItemArray Do
		
		IDOfElementSCustomSetting = Settings.Selection.GetIDByObject(Item);;
		If Item.Parent <> Undefined And Item.Parent.Parent <> Undefined Then
			Item.Parent.Parent.Items.Delete(Item.Parent);
		Else
			Continue;
		EndIf;
		
		CustomSettingsOfSelectedFields = UserSettings.Items.Find(IDOfCustomSettingOfSelectedFields);
		If CustomSettingsOfSelectedFields <> Undefined Then
			ItemTheCustomSettings = CustomSettingsOfSelectedFields.GetObjectByID(IDOfElementSCustomSetting);
			If ItemTheCustomSettings <> Undefined Then
				If ItemTheCustomSettings.Parent <> Undefined Then
					ItemTheCustomSettings.Parent.Items.Delete(ItemTheCustomSettings);
				Else
					CustomSettingsOfSelectedFields.Items.Delete(ItemTheCustomSettings);
				EndIf;
			EndIf;
		EndIf;
		
	EndDo;
	
EndProcedure

// Removes grouping from report settings and user settings
//
// Parameters:
//  DataCompositionSettings - DataCompositionSettingsComposer, DataCompositionSettings - customization.
//  TagName - String - name of the item to be deleted.
//
Procedure RemoveDimensionFromAllReportSettings(DataCompositionSettings, TagName) Export
	
	If TypeOf(DataCompositionSettings) = Type("DataCompositionSettingsComposer") Then
		Settings = DataCompositionSettings.Settings;
		UserSettings = DataCompositionSettings.UserSettings;
	ElsIf TypeOf(DataCompositionSettings) = Type("DataCompositionSettings") Then
		Settings = DataCompositionSettings;
		UserSettings = New DataCompositionUserSettings;
	Else
		Return
	EndIf;
	
	SearchValue  = New DataCompositionField(TagName);
	MatchingElements = New Map;
	
	GroupingStructure   = Settings.Structure;
	
	FindGroupingRecursively(GroupingStructure, MatchingElements, SearchValue);
	For Each Group In MatchingElements Do
		CurDimensionElement = Group.Key; // DataCompositionGroup, DataCompositionTableGroup, DataCompositionChartGroup -
		If CurDimensionElement.GroupFields.Items.Count() = 1 Then
			If TypeOf(CurDimensionElement.Parent) = Type("DataCompositionTable") Then
				ColumnCollection = CurDimensionElement.Parent.Columns;
				StringCollection  = CurDimensionElement.Parent.Rows;
				For Each GroupItem2 In ColumnCollection Do
					If GroupItem2 = Group.Key Then
						ColumnCollection.Delete(Group.Key);
						Break;
					EndIf;
				EndDo;
				
				For Each GroupItem2 In StringCollection Do
					If GroupItem2 = Group.Key Then
						StringCollection.Delete(Group.Key);
						Break;
					EndIf;
				EndDo;
			ElsIf TypeOf(CurDimensionElement.Parent) = Type("DataCompositionChart") Then
				CollectionSeries = CurDimensionElement.Parent.Series;
				PointCollection = CurDimensionElement.Parent.Points;
				For Each GroupItem2 In CollectionSeries Do
					If GroupItem2 = Group.Key Then
						CollectionSeries.Delete(Group.Key);
						Break;
					EndIf;
				EndDo;
				
				For Each GroupItem2 In PointCollection Do
					If GroupItem2 = Group.Key Then
						PointCollection.Delete(Group.Key);
						Break;
					EndIf;
				EndDo;
			Else
				CurDimensionElement.Parent.Structure.Delete(Group.Key);
			EndIf;
		Else
			CurDimensionElement.GroupFields.Items.Delete(Group.Value);
		EndIf;
		
		IDOfElementSCustomSetting = CurDimensionElement.UserSettingID;
		
		CustomSettingsOfSelectedFields = UserSettings.Items.Find(IDOfElementSCustomSetting);
		If CustomSettingsOfSelectedFields <> Undefined Then
			ItemTheCustomSettings = CustomSettingsOfSelectedFields.GetObjectByID(IDOfElementSCustomSetting);
			If ItemTheCustomSettings <> Undefined Then
				If ItemTheCustomSettings.Parent <> Undefined Then
					ItemTheCustomSettings.Parent.Items.Delete(ItemTheCustomSettings);
				Else
					CustomSettingsOfSelectedFields.Items.Delete(ItemTheCustomSettings);
				EndIf;
			EndIf;
		EndIf;
	EndDo;
EndProcedure

