//  					The type ("Set of New data schemas").
//  SetName - String - name of the new set (optional by default, " Typeset1")
//  SourceName - String - name of the data source for the new layout schema (optional by default " data Source1")
//  ObjectName - String - name of the external data source (optional by default, equal to the name of the data set).
//
// Returns:
//  DataCompositionSchemaDataSetQuery, DataCompositionSchemaDataSetUnion, DataCompositionSchemaDataSetObject - a new data set of the specified type.
//
Function AddEmptyDataSet(SchemaSet, SetType = Undefined, SetName = "DataSet1", SourceName = "DataSource1", ObjectName = "") Export
	
	If SetType = Undefined Then
		SetType = Type("DataCompositionSchemaDataSetQuery");
	EndIf;
	
	If TypeOf(SchemaSet) = Type("DataCompositionSchema") Then
		
		DataSets = SchemaSet.DataSets;
		
	ElsIf TypeOf(SchemaSet) = Type("DataCompositionSchemaDataSets") Then
		
		DataSets = SchemaSet;
		
	ElsIf TypeOf(SchemaSet) = Type("DataCompositionSchemaDataSetUnion") Then
		
		DataSets = SchemaSet.Items;
		
	EndIf;
	
	NewSet = DataSets.Add(SetType);
	
	NewSet.Name = SetName;
	If Not SetType = Type("DataCompositionSchemaDataSetUnion")
		And ValueIsFilled(SourceName) Then
		
		NewSet.DataSource = SourceName;
		
	EndIf;
	
	If SetType = Type("DataCompositionSchemaDataSetObject") Then
		NewSet.ObjectName = ?(ValueIsFilled(ObjectName), ObjectName, SetName);
	EndIf;
		
	Return NewSet;
	
EndFunction

// Allows you to copy data sets from one schema to another or within the schema.
// Returns an array of references to copied sets in the receiver.
//
// Parameters:
// 	ReceiverOfDataSets - DataCompositionSchema - 
//							- DataCompositionSchemaDataSets -
//							- DataCompositionSchemaDataSetUnion - set receiver.
// 	SourceOfDataSets - DataCompositionSchema - 
//							Setdannyhshemykomponovkidannyh-
//							Nabordannyhobedineniyeshemykomponovkidannyh- 
//							Nabordannyhproschemykomponovkidannyh- 
//							Nabordannyhobjectshemykomponovkidannyh-set source.
// 	PrimaryNameOfDataSet - String - name of the data set in the receiver.
//									If the receiver already has a data set with this name, the next sequence number will be added to the name.
//									If the source contains multiple data sets, the primary name will not be applied.
//									If the source contains a single join, the main name will only be applied to it.
//									If no name is specified, the original names of the data sets will be preserved if possible.
//
// Returns:
// 	Array of DataCompositionSchemaDataSets, DataCompositionSchemaDataSetUnion, DataCompositionSchemaDataSetQuery, DataCompositionSchemaDataSetObject - links
// 				to the copied sets in the receiver.
//
Function CopyDatasets(ReceiverOfDataSets, SourceOfDataSets, PrimaryNameOfDataSet = "") Export
	
	Var CopiedDataSets;
	
	CopiedDataSets = New Array;
	ThisIsUnification = False;
	
	// A collection to which a dataset can be added
	If TypeOf(ReceiverOfDataSets) = Type("DataCompositionSchema") Then
		Receiver = ReceiverOfDataSets.DataSets;
	ElsIf TypeOf(ReceiverOfDataSets) = Type("DataCompositionSchemaDataSets") Then
		Receiver = ReceiverOfDataSets;
	ElsIf TypeOf(ReceiverOfDataSets) = Type("DataCompositionSchemaDataSetUnion") Then
		Receiver = ReceiverOfDataSets.Items;
		ThisIsUnification = True;
	Else 
		Raise NStr("vi = 'Không hợp lệ loại tham số 1';
					|ru = 'Некорректный тип параметра 1';
					|en = 'Incorrect type of parameter 1'; fa = 'Incorrect type of parameter 1';
					|it = 'Tipo del parametro 1 non valido';
					|pl = 'Niepoprawny typ parametru 1';
					|tr = 'Yanlış parametre türü 1'") ;
	EndIf;
		
	// A collection that contains datasets
	If TypeOf(SourceOfDataSets) = Type("DataCompositionSchema") Then
		Source = SourceOfDataSets.DataSets;
	ElsIf TypeOf(SourceOfDataSets) = Type("DataCompositionSchemaDataSets") Then
		Source = SourceOfDataSets;
	ElsIf TypeOf(SourceOfDataSets) = Type("DataCompositionSchemaDataSetUnion") Then
		Source = SourceOfDataSets.Items;
	ElsIf TypeOf(SourceOfDataSets) = Type("DataCompositionSchemaDataSetQuery")
		Or TypeOf(SourceOfDataSets) = Type("DataCompositionSchemaDataSetObject") Then
		Source = New Array;
		Source.Add(SourceOfDataSets);
	Else 
		Raise NStr("vi = 'Không hợp lệ loại tham số 2';
					|ru = 'Некорректный тип параметра 2';
					|en = 'Incorrect type of parameter 2'; fa = 'Incorrect type of parameter 2';
					|it = 'Tipo del parametro 2 non valido';
					|pl = 'Niepoprawny typ parametru 2';
					|tr = 'Yanlış parametre türü 2'") ;
	EndIf;
		
	For Each SetSource In Source Do 
		SetType = TypeOf(SetSource);
		SetName = ?(ValueIsFilled(PrimaryNameOfDataSet), PrimaryNameOfDataSet, SetSource.Name);
		
		NewSet = DataCompositionServer.AddEmptyDataSet(Receiver, SetType, SetName);
		FillPropertyValues(NewSet, SetSource, , "Name");
		
		CopiedDataSets.Add(NewSet);
		
		If SetType = Type("DataCompositionSchemaDataSetUnion") Then
			// Recursively migrate datasets
			CopiedInRecursion = CopyDatasets(NewSet, SetSource);
			
			CommonClientServer.SupplementArray(CopiedDataSets, CopiedInRecursion, True);
		EndIf;
		
		CopyDataSetFields(NewSet, SetSource);
		
		If TypeOf(ReceiverOfDataSets) = Type("DataCompositionSchemaDataSetUnion") Then
			CopyDataSetFields(ReceiverOfDataSets, NewSet, ThisIsUnification);
		EndIf;
			
	EndDo;
	
	Return CopiedDataSets;
	
EndFunction

// Allows you to copy fields from one data set to another.
// If the field is already in the receiver, it is skipped.
// Returns an array of references to the copied data set fields in the receiver.
//
// Parameters:
// 	ReceiverOfDataSetFields - DataCompositionSchemaDataSetUnion - 
//								- DataCompositionSchemaDataSetQuery - 
//								- DataCompositionSchemaDataSetObject - set receiver.
// 	SourceOfDatasetFields - DataCompositionSchemaDataSetUnion - 
//								- DataCompositionSchemaDataSetQuery - 
//								- DataCompositionSchemaDataSetObject - the source set.
// 	DuplicateNameInFieldPath - Boolean - indicates whether the data path and field expression should be equated (False by default).
//
// Returns:
// 	Array of DataCompositionSchemaDataSetField, DataCompositionSchemaDataSetFieldFolder - links to copied fields typed in the receiver.
//
Function CopyDataSetFields(ReceiverOfDataSetFields, SourceOfDatasetFields, DuplicateNameInFieldPath = False) Export
	
	Var CopiedDataSetFields;
	
	CopiedDataSetFields = New Array;
	
	DestinationFields = ReceiverOfDataSetFields.Fields;
	SourceFields = SourceOfDatasetFields.Fields;
	
	// Move fields, except for the properties of the edit parameters, 
	For Each SourceField In SourceFields Do 
		If Not DestinationFields.Find(SourceField.DataPath) = Undefined Then
			Continue;
		EndIf;
		
		If TypeOf(SourceField) = Type("DataCompositionSchemaDataSetField") Then
			DestinationField = FinancialReportingServer.NewSetField(ReceiverOfDataSetFields, "NewField");
			FillPropertyValues(DestinationField, SourceField);
			
			If DuplicateNameInFieldPath Then
				DestinationField.DataPath = DestinationField.Field;
			EndIf;
			
			AvailableSourceFieldValues = SourceField.GetAvailableValues();
			If Not AvailableSourceFieldValues = Undefined Then
				DestinationField.SetAvailableValues(AvailableSourceFieldValues);
			EndIf;
			
			FillPropertyValues(DestinationField.Role, SourceField.Role);
		Else
			DestinationField = FinancialReportingServer.NewSetGroup(ReceiverOfDataSetFields, "NewFolder");
			FillPropertyValues(DestinationField, SourceField);
		EndIf;
		
		CopiedDataSetFields.Add(DestinationField);
	EndDo;
	
	Return CopiedDataSetFields;
	
EndFunction

