//
Function CopyParameters(ParameterReceiver, SourceOfParameters, ReFillExistingOne = False) Export
	
	Var CopiedParameters;
	
	CopiedParameters = New Array;
	
	// A collection to which a dataset can be added
	If TypeOf(ParameterReceiver) = Type("DataCompositionSchema") Then
		Receiver = ParameterReceiver.Parameters;
	ElsIf TypeOf(ParameterReceiver) = Type("DataCompositionSchemaParameters") Then
		Receiver = ParameterReceiver;
	Else 
		Raise NStr("vi = 'Không hợp lệ loại tham số 1';
					|ru = 'Некорректный тип параметра 1';
					|en = 'Incorrect type of parameter 1'; fa = 'Incorrect type of parameter 1';
					|it = 'Tipo del parametro 1 non valido';
					|pl = 'Niepoprawny typ parametru 1';
					|tr = 'Yanlış parametre türü 1'") ;
	EndIf;
		
	// A collection that contains datasets
	If TypeOf(SourceOfParameters) = Type("DataCompositionSchema") Then
		Source = SourceOfParameters.Parameters;
	ElsIf TypeOf(SourceOfParameters) = Type("DataCompositionSchemaParameters") Then
		Source = SourceOfParameters;
	Else 
		Raise NStr("vi = 'Không hợp lệ loại tham số 2';
					|ru = 'Некорректный тип параметра 2';
					|en = 'Incorrect type of parameter 2'; fa = 'Incorrect type of parameter 2';
					|it = 'Tipo del parametro 2 non valido';
					|pl = 'Niepoprawny typ parametru 2';
					|tr = 'Yanlış parametre türü 2'") ;
	EndIf;
		
	For Each SourceParameter_ In Source Do
		If Not ReFillExistingOne Then
			NewParameter1 = Receiver.Add();
		Else
			NewParameter1 = Receiver.Find(SourceParameter_.Name);
			
			If NewParameter1 = Undefined Then
				NewParameter1 = Receiver.Add();
			EndIf;
		EndIf;
	
		FillPropertyValues(NewParameter1, SourceParameter_);
	EndDo;
	
	Return CopiedParameters;
	
