// Gets the full field name in parts
//
// Parameters:
//	FullName - String - the full name field of access control.
//
// Returns:
//	Array of String - an array containing parts of the full name.
//
Function FromFullFieldNameGetParts(FullName)

	ArrParts = New Array;
	RowShortName = FullName;
	
	While Not IsBlankString(RowShortName) Do
		If Left(RowShortName, 1) = "[" Then
			
			Pos = StrFind(RowShortName, "]");
			If Pos = 0 Then
				ArrParts.Add(Mid(RowShortName, 2));
				RowShortName = "";
			Else
				ArrParts.Add(Mid(RowShortName, 1, Pos));
				RowShortName = Mid(RowShortName, Pos + 2);
			EndIf;
			
		Else
			
			Pos = StrFind(RowShortName, ".");
			If Pos = 0 Then
				ArrParts.Add(RowShortName);
				RowShortName = "";
			Else
				ArrParts.Add(Left(RowShortName, Pos - 1));
				RowShortName = Mid(RowShortName, Pos + 1);
			EndIf;
		EndIf;
	EndDo;
	
	Return ArrParts;

EndFunction

// Finds a field by name among the elements of the SKD fields.
//
// Parameters:
//	Items - DataCompositionAvailableFieldCollection - field of access control.
//	Name - String - SKD field name
//
// Returns:
//	DataCompositionField - SKD field.
//
Function FindDCSFieldByName(Items, Name)
	
	For Each Item In Items Do
		If Upper(String(Item.Field)) = Upper(Name) Then
			Return Item;
		EndIf;
	EndDo;
	
	Return Undefined;
	
EndFunction

Function StructureOfColorSeries(ChartSeriesCollection)
	StructureOfColorSeries = New Structure;
	ColorStructure = New Structure("Red, Green, B", 0, 0, 0);

	For Each ChartSeries In ChartSeriesCollection Do
		SeriesColorStructure = New Structure; 
		TMCommonUseClientServer.SupplementStructure(SeriesColorStructure, ColorStructure, True);
		
		SeriesColorView = ChartSeries.Color.Type;
		If SeriesColorView = ColorType.WebColor Then
			TargetValueMonitoring.GetRedGreenBlueWebColors(ChartSeries.Color,
															SeriesColorStructure.Red,
															SeriesColorStructure.Green,
															SeriesColorStructure.B);
		ElsIf SeriesColorView = ColorType.Absolute Then 
			SeriesColorStructure.Red = ChartSeries.Color.R;
			SeriesColorStructure.Green = ChartSeries.Color.G;
			SeriesColorStructure.B = ChartSeries.Color.B;
		EndIf;
		
		ColorDescription = "Color_"
						+ String(SeriesColorStructure.Red)
						+ "_"
						+ String(SeriesColorStructure.Green)
						+ "_"
						+ String(SeriesColorStructure.B);
		If Not StructureOfColorSeries.Property(ColorDescription) Then
			StructureOfColorSeries.Insert(ColorDescription, New Structure);
			
			SeriesDescription_ = StructureOfColorSeries[ColorDescription]; // Structure
			SeriesDescription_.Insert("SetOfSeries", New Array);
			SeriesDescription_.SetOfSeries.Add(ChartSeries);
			
			SeriesDescription_.Insert("Color", SeriesColorStructure);
		Else
			SeriesDescription_ = StructureOfColorSeries[ColorDescription]; // Structure -
			ArraySeries = SeriesDescription_.SetOfSeries; // Array -
			ArraySeries.Add(ChartSeries);
		EndIf;
	EndDo;
	
	Return StructureOfColorSeries;
EndFunction

Procedure FormGradientOverSeriesOfColors(StructureOfColorSeries)
	For Each SeriesOfDifferentColors In StructureOfColorSeries Do 
		SeriesData = SeriesOfDifferentColors.Value; // Structure -
		ProcessedSeries_ = SeriesData.SetOfSeries;
		SeriesCount = ProcessedSeries_.Count();
		
		If SeriesCount = 1 Then
			Continue;
		EndIf;
		
		ColorSeries = SeriesOfDifferentColors.Value.Color; // Color -
		
		Tone = 0; 
		Saturation = 0; 
		Brightness = 0;
		
		BatchNumber = 0;
		For Each ProcessedSeries In ProcessedSeries_ Do
			If Tone + Saturation + Brightness = 0 Then
				TargetValueMonitoring.GetToneSaturationBrightnessByRedGreenBlue(ColorSeries["Red"],
					ColorSeries["Green"],
					ColorSeries["B"],
					Tone,
					Saturation,
					Brightness);
			EndIf;
			
			// Set the coefficient to 0.8 so that the gradient does not go white
			BrightnessGradientStep = 0.8 * (100 - Brightness) / (SeriesCount - 1);
			
			// Saturation does not need to be limited
			SaturationGradientStep = (100 - ?(Saturation = 0, 100, Saturation)) / (SeriesCount - 1);
			
			NewRed = 0; 
			NewGreen = 0;
			NewBlue = 0;
			
			TargetValueMonitoring.GetRedGreenBlueByToneSaturationBrightness(Tone, 
				Saturation + SaturationGradientStep * BatchNumber, 
				Brightness + BrightnessGradientStep * BatchNumber, 
				NewRed, NewGreen, NewBlue);
			
			NewColorSeries = New Color(NewRed, NewGreen, NewBlue);
			
			ProcessedSeries.Color = NewColorSeries;
			
			BatchNumber = BatchNumber + 1;
		EndDo;
	EndDo;
EndProcedure

// Sets the standard layout for the transmitted chart
// 
// Parameters:
//	Chart - Chart - changeable chart
//	ChartParameters_ - Structure - the structure parameters corresponding to properties of the chart.
//
Procedure SetDefaultChartLayout(Chart, ChartParameters_ = Undefined)
	// Chart design
	ChartParametersPassed = (ChartParameters_ <> Undefined);
	
	If ChartParametersPassed Then
		ReportParameter = Undefined;
		ObjectPassedReport = ChartParameters_.Property("Report", ReportParameter) 
			And ReportParameter <> Undefined;
		
		ParameterExtendedSeriesDesign = False;
		ParameterExtendedSeriesDesign = ChartParameters_.Property("ExtendedSeriesDesign", ParameterExtendedSeriesDesign)
			And ParameterExtendedSeriesDesign;
		
		MaximumSeriesParameter = 0;
		If ChartParameters_.Property("MaxSeriesCount", MaximumSeriesParameter)
			And MaximumSeriesParameter > 0 And MaximumSeriesParameter <> 999 Then
			Chart.MaxSeries = MaxSeries.Limited;
			Chart.MaxSeriesCount = MaximumSeriesParameter;
		ElsIf ChartParameters_.Property("MaxSeriesPercent", MaximumSeriesParameter)
			And MaximumSeriesParameter > 0 Then
			Chart.MaxSeries = MaxSeries.Percent;
			Chart.MaxSeriesPercent = MaximumSeriesParameter;
		ElsIf MaximumSeriesParameter = 999 And MaximumSeriesParameter <> 999 Then
			Chart.MaxSeries = MaxSeries.NotDefined;
		EndIf;
		
		ChartTypeParameter = Undefined;
		If ChartParameters_.Property("ChartType", ChartTypeParameter) Then
			If ChartTypeParameter <> "Arbitrary" Then
				Chart.ChartType = ChartTypeParameter;
			EndIf;
		EndIf;
	EndIf;
	
	// Design of the construction area
	PlotArea = Chart.PlotArea;
	PlotArea.ScaleColor = Metadata.StyleItems.ChartScaleColor.Value;
	PlotArea.ValueScaleFormat = "NG=3,0";
	
	// Design of the legend area
	LegendArea = Chart.LegendArea;
	LegendArea.Scrolling = True;
	
	// Design of series and points
	ChartSeriesCollection = Chart.Series;
	DisplayChartPointMarkers = False;
	For Each ChartSeries In ChartSeriesCollection Do
		If ChartParameters_.Property("DisplayChartPointMarkers", DisplayChartPointMarkers) Then
			SetDefaultDesignOfSeries(ChartSeries, DisplayChartPointMarkers);
		Else
			SetDefaultDesignOfSeries(ChartSeries);
		EndIf;
		
		// Let's design a series of diagrams according to the extended report algorithm
		If ChartParametersPassed And ObjectPassedReport And ParameterExtendedSeriesDesign Then
			ReportParameter.InstallExtendedSeriesDesign(ChartSeries);
		EndIf;
	EndDo;
	
	If ChartParameters_ <> Undefined Then
		SelectChartSeriesParameter = Undefined;
		GradientChartSeriesParameter = False;
		If ChartParameters_.Property("SelectionOfChartSeries", SelectChartSeriesParameter)
			And SelectChartSeriesParameter <> 0 
			And ChartParameters_.Property("GradientOfChartSeries", GradientChartSeriesParameter) 
			And GradientChartSeriesParameter Then
			StructureOfColorSeries = StructureOfColorSeries(ChartSeriesCollection);
			FormGradientOverSeriesOfColors(StructureOfColorSeries);
		EndIf;
	EndIf;	

	SetDefaultLayoutOfSummarySeries(Chart.SummarySeries);
EndProcedure

Procedure SetDefaultDesignOfSeries(Series, DisplayPointMarkers = True)
	// Installable properties of the series
	If Not DisplayPointMarkers Then
		Series.Marker = ChartMarkerType.None;
	EndIf;
EndProcedure
 
Procedure SetDefaultLayoutOfSummarySeries(Series)
	// Installable properties of the series
	Series.Marker = ChartMarkerType.None;
	Series.Line = New Line(ChartLineType.Solid, 3);
	Series.Color = Metadata.StyleItems.ColorOfPivotSeriesChart.Value;
EndProcedure

Procedure DeleteChartLayoutParameters(SettingsComposer, SpreadsheetDocument, ChartParameters)
	
	// Parameters processed in the code
	If ChartParameters <> Undefined Then
		AvailableParameters = SettingsComposer.Settings.DataParameters.AvailableParameters;
		
		For Each ChartsParameter In ChartParameters Do
			ChartsParameter = AvailableParameters.FindParameter(New DataCompositionParameter(ChartsParameter.Key));
			
			If ChartsParameter <> Undefined Then
				FoundArea = SpreadsheetDocument.FindText(ChartsParameter.Title);
				
				If FoundArea <> Undefined Then
					AreaToDelete_ = SpreadsheetDocument.Area(FoundArea.Top,, FoundArea.Bottom);
					SpreadsheetDocument.DeleteArea(AreaToDelete_, SpreadsheetDocumentShiftType.Vertical);
					
					If SpreadsheetDocument.FixedTop <> 0 Then
						SpreadsheetDocument.FixedTop = SpreadsheetDocument.FixedTop - 1;
					EndIf;
				EndIf;
			EndIf;
		EndDo; 
	EndIf;
EndProcedure

Function FormatStringForDataLayout(Periodicity)
	FormatString = "";
	
	If Periodicity = Enums.Periodicity.Day Then
		FormatString = NStr("vi = 'DLF=D';
							|ru = 'ДЛФ=D';
							|en = 'DLF=D'; fa = 'DLF=D';
							|it = 'DLF=D';
							|pl = 'DLF=D';
							|tr = 'DLF=D'");
	ElsIf Periodicity = Enums.Periodicity.Week Then
		FormatString = NStr("vi = 'DLF=D';
							|ru = 'ДЛФ=D';
							|en = 'DLF=D'; fa = 'DLF=D';
							|it = 'DLF=D';
							|pl = 'DLF=D';
							|tr = 'DLF=D'");
	ElsIf Periodicity = Enums.Periodicity.TenDays Then
		FormatString = NStr("vi = 'DLF=D';
							|ru = 'ДЛФ=D';
							|en = 'DLF=D'; fa = 'DLF=D';
							|it = 'DLF=D';
							|pl = 'DLF=D';
							|tr = 'DLF=D'");
	ElsIf Periodicity = Enums.Periodicity.Month Then
		FormatString = NStr("vi = 'DF=''MMMM yyyy''';
							|ru = 'ДФ=''ММММ гггг''';
							|en = 'DF=''MMMM yyyy'''; fa = 'DF=''MMMM yyyy''';
							|it = 'DF=''MMMM yyyy''';
							|pl = 'DF=''MMMM yyyy''';
							|tr = 'DF=''MMMM yyyy'''");
	ElsIf Periodicity = Enums.Periodicity.Quarter Then
		FormatString = NStr("vi = 'DF=''%1 ""quý"" yyyy''';
							|ru = 'ДФ=''%1 ""кв."" гггг''';
							|en = 'DF=''%1'' ""q"" yyyy'''; fa = 'DF=''%1'' ""q"" yyyy''';
							|it = 'DF=''%1 ""trim."" yyyy''';
							|pl = 'DF=''%1 ""kw."" yyyy''';
							|tr = 'DF=''%1 ""çy."" yyyy'''");
		ParameterIsWrittenInCodeLanguage = "k";
		FormatString = StringFunctionsClientServer.SubstituteParametersToString(
			FormatString, ParameterIsWrittenInCodeLanguage);
	ElsIf Periodicity = Enums.Periodicity.HalfYear Then
		FormatString = StrTemplate(NStr("vi = 'DF=%1';
										|ru = 'ДФ=%1';
										|en = 'DF=%1'; fa = 'DF=%1';
										|it = 'DF=%1';
										|pl = 'DF=%1';
										|tr = 'DF=%1'"), "MM.yyyy");
	ElsIf Periodicity = Enums.Periodicity.Year Then
		FormatString = NStr("vi = 'DF=yyyy';
							|ru = 'ДФ=yyyy';
							|en = 'DF=yyyy'; fa = 'DF=yyyy';
							|it = 'Formato data=yyyy';
							|pl = 'DF=yyyy';
							|tr = 'DF=yyyy'");
	EndIf;
	
	Return FormatString;
EndFunction

Procedure FindGroupingRecursively(ItemsCollection, MatchingElements, SearchValue)
	For Each Item In ItemsCollection Do
		If TypeOf(Item) = Type("DataCompositionGroup")
			Or TypeOf(Item) = Type("DataCompositionTableGroup")
			Or TypeOf(Item) = Type("DataCompositionChartGroup") Then
			For Each GroupingField In Item.GroupFields.Items Do
				If TypeOf(GroupingField) <> Type("DataCompositionAutoGroupField") 
						And GroupingField.Field = SearchValue
				Then
					MatchingElements.Insert(Item, GroupingField)
				EndIf;
			EndDo;
			FindGroupingRecursively(Item.Structure, MatchingElements, SearchValue);
		ElsIf TypeOf(Item) = Type("DataCompositionTable") Then
			FindGroupingRecursively(Item.Rows, MatchingElements, SearchValue);
			FindGroupingRecursively(Item.Columns, MatchingElements, SearchValue);
		ElsIf TypeOf(Item) = Type("DataCompositionChart") Then
			FindGroupingRecursively(Item.Series, MatchingElements, SearchValue);
			FindGroupingRecursively(Item.Points, MatchingElements, SearchValue);
		EndIf;
	EndDo;
EndProcedure


// Layout settings by parameter.
// 
// Parameters:
//  CompositionSchema - DataCompositionSchema
//  CompositionSettings - DataCompositionSettings
// 
// Returns:
//  Arbitrary, DataCompositionSettings - Customize the layout according to the parameter
Function LayoutSettingsByParameter(CompositionSchema, Val CompositionSettings) Export
	
	If TypeOf(CompositionSettings) = Type("String") Then
		If IsTempStorageURL(CompositionSettings) Then
			
			CompositionSettings = GetFromTempStorage(CompositionSettings);
			If TypeOf(CompositionSettings) <> Type("DataCompositionSettings") Then
				ExceptionText = NStr("vi = 'Địa chỉ lưu trữ tạm thời được chuyển không thể có được cài đặt thành phần dữ liệu.';
									|ru = 'По переданному адресу временного хранилища не удалось получить настройки компоновки данных.';
									|en = 'Cannot receive data composition settings for the passed address of temporary storage.'; fa = 'Cannot receive data composition settings for the passed address of temporary storage.';
									|it = 'Non è possibile ottenere le impostazioni di layout dei dati dall''indirizzo di archiviazione temporaneo passato.';
									|pl = 'Pod przekazanym adresem repozytorium tymczasowego nie udało się uzyskać ustawienia układu danych.';
									|tr = 'Transfer edilen geçici depolama adresi kullanılarak veri oluşturma ayarları alınamadı.'");
				Raise ExceptionText;
			EndIf;
			
			Return CompositionSettings;
			
		Else
			
			Return CompositionSchema.SettingVariants[CompositionSettings].Settings;
			
		EndIf;
	ElsIf TypeOf(CompositionSettings) = Type("DataCompositionSettings") Then		
		
		Return CompositionSettings;
		
	Else 
		
		Return CompositionSchema.DefaultSettings;
		
	EndIf;
	
EndFunction

Function LayoutDiagramByParameter(Val CompositionSchema) Export
	
	If TypeOf(CompositionSchema) = Type("String") Then
		If IsTempStorageURL(CompositionSchema) Then
			
			CompositionSchema = GetFromTempStorage(CompositionSchema);
			If TypeOf(CompositionSchema) <> Type("DataCompositionSchema") Then
				ExceptionText = NStr("vi = 'Không thể có được sơ đồ thành phần dữ liệu tại địa chỉ lưu trữ tạm thời được chuyển.';
									|ru = 'По переданному адресу временного хранилища не удалось получить схему компоновки данных.';
									|en = 'Cannot receive data composition schema for the transferred address of temporary storage.'; fa = 'Cannot receive data composition schema for the transferred address of temporary storage.';
									|it = 'Non è possibile ottenere lo schema di layout dei dati dall''indirizzo di archiviazione temporaneo passato.';
									|pl = 'Pod przekazanym adresem repozytorium tymczasowego nie udało się uzyskać schemat układu danych.';
									|tr = 'Transfer edilen geçici depolama adresi kullanılarak veri inşa edilme şeması alınamadı.'");
				Raise ExceptionText;
			EndIf;
			
			Return CompositionSchema;
		Else
			Return TMCommonUse.TemplateByName(CompositionSchema);
		EndIf;
	ElsIf TypeOf(CompositionSchema) = Type("DataCompositionSchema") Then
		Return CompositionSchema;
	Else
		ExceptionText = StrTemplate(NStr("vi = 'Kiểu tham số không được hỗ trợ ""%1""';
										|ru = 'Неподдерживаемый тип параметра ""%1""';
										|en = 'Unsupported parameter type ""%1""'; fa = 'Unsupported parameter type ""%1""';
										|it = 'Tipo di parametro schema di ""%1""';
										|pl = 'Nieobsługiwany typ parametru ""%1""';
										|tr = 'Desteklenmeyen parametre tipi ""%1""'"), "CompositionSchema");
		Raise ExceptionText;
	EndIf;
	
EndFunction

