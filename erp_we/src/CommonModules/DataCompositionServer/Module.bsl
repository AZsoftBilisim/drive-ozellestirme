#Region ReportsSettings

// The procedure sets the calculation formula and the format of the dynamic period
//
// Parameters:
//		DataCompositionSchema - DataCompositionSchema - SKD of the report
//		SettingsComposer - DataCompositionSettingsComposer - report settings
//		AddPeriod_0 - Boolean - indicates whether the period extension is being used.
//		PathCompletion - String - Prefix to the dynamic period field, for example, " Periods."
//
Procedure SetUpDynamicPeriod(DataCompositionSchema, SettingsComposer, AddPeriod_0 = False, PathCompletion = "") Export
	
	PeriodicityParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "Periodicity");
	
	If PeriodicityParameter <> Undefined 
		And DataCompositionClientServer.FieldUsed_(SettingsComposer, New DataCompositionField(PathCompletion + "DynamicPeriod")) Then
		
		SearchField = DataCompositionSchema.CalculatedFields.Find(PathCompletion + "DynamicPeriod");
		
		If SearchField <> Undefined Then
			
			If Not ValueIsFilled(PeriodicityParameter.Value) Then
				Raise NStr("vi = 'Cài đặt không chính xác của tham số ""Định kỳ"".';
							|ru = 'Некорректная настройка параметра ""Периодичность"".';
							|en = 'Incorrect setting of the ""Frequency"" parameter.'; fa = 'Incorrect setting of the ""Frequency"" parameter.';
							|it = 'Impostazione non corretta dell''opzione ""Frequenza"".';
							|pl = 'Niepoprawne ustawienie parametru ""Периодичность"".';
							|tr = '""Zaman sınırı"" parametresinin yanlış ayarlanması.'") ;
			EndIf;
			
			ExpressionPeriod = FinancialReportingClientServer.PeriodStrings(PeriodicityParameter.Value).Period;
			
			SearchField.Expression = PathCompletion + ExpressionPeriod;
			
			FormatDesignParameter = SearchField.Appearance.Items.Find("Format");
			FormatDesignParameter.Value = FormatStringForDataLayout(PeriodicityParameter.Value);
			FormatDesignParameter.Use = True;
			
			If AddPeriod_0 Then
				
				PeriodAddition = DataCompositionPeriodAdditionType[Common.EnumerationValueName(PeriodicityParameter.Value)];
				PeriodParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "Period"); // DataCompositionSettingsParameterValue, Undefined -
				
				If PeriodParameter <> Undefined Then
					
					DynamicPeriodField = New DataCompositionField(PathCompletion + "DynamicPeriod");
					Groups = DataCompositionClientServer.GetGroupings(SettingsComposer);
					
					LiteralsOfSupportedFields = "YearPeriod,HalfYearPeriod,QuarterPeriod,MonthPeriod,TenDaysPeriod,WeekPeriod,DayPeriod";
					SupportedPeriodFields = StrSplit(LiteralsOfSupportedFields, ",");
					
					If ValueIsFilled(PathCompletion) Then
						For Each ListItem In SupportedPeriodFields Do
							ListItem = PathCompletion + ListItem;
						EndDo;
					EndIf;
					
					For Each Group In Groups Do
						GroupItem2 = Group.Value; // DataCompositionTableGroup, DataCompositionGroup, DataCompositionChartGroup -
						ElementDimensionFields = GroupItem2.GroupFields;
						If ElementDimensionFields.Items.Count() = 1
							And ElementDimensionFields.Items[0].Field = DynamicPeriodField Then
							
							GroupingDynamicPeriod = GroupItem2.GroupFields.Items[0];
							ParentGrouping_ = Group.Value.Parent;
							
							PeriodAdditionBegin = DataCompositionPeriodAdditionType.None;
							PeriodAdditionEnd = DataCompositionPeriodAdditionType.None;
								
							// We will include the addition of the period depending on the placement of the grouping
							GroupingDynamicPeriod.AdditionType = PeriodAddition;
							
							// Root element or first-level grouping
							If TypeOf(ParentGrouping_) = Type("DataCompositionSettings")
								Or TypeOf(ParentGrouping_) = Type("DataCompositionTable")
								Or TypeOf(ParentGrouping_) = Type("DataCompositionChart") Then
								
								StandardPeriodParameter = PeriodParameter.Value; // StandardPeriod -
								PeriodAdditionBegin = StandardPeriodParameter.StartDate;
								PeriodAdditionEnd = StandardPeriodParameter.EndDate;
								
							// There is a parent grouping and there is one field in it, which is typical for groupings by period.
							ElsIf TypeOf(ParentGrouping_) = Type("DataCompositionGroup")
									Or TypeOf(ParentGrouping_) = Type("DataCompositionTableGroup") 
									Or TypeOf(ParentGrouping_) = Type("DataCompositionChartGroup") Then
							
								ParentGroupingElements = ParentGrouping_.GroupFields.Items;
								If ParentGroupingElements.Count() = 1 Then
									
									IndexOfParentSSupportedPeriod = SupportedPeriodFields.Find(String(ParentGroupingElements[0].Field));
									If IndexOfParentSSupportedPeriod <> Undefined Then
										SupportedPeriodParent = SupportedPeriodFields[IndexOfParentSSupportedPeriod];
										
										TypeOfAddOnByParentGrouping = DataCompositionPeriodAdditionType[StrReplace(SupportedPeriodParent, "Period", "")];
										
										PeriodAdditionBegin = TypeOfAddOnByParentGrouping;
										PeriodAdditionEnd = TypeOfAddOnByParentGrouping;
									
									EndIf;
									
								EndIf;
								
							EndIf;
							
							GroupingDynamicPeriod.BeginOfPeriod = PeriodAdditionBegin;
							GroupingDynamicPeriod.EndOfPeriod = PeriodAdditionEnd;
							
						EndIf;
					EndDo;
				EndIf;
			EndIf;
		EndIf;
	EndIf;
	
EndProcedure

// Returns the value of the data layout schema parameter
//
// Parameters:
//	DataCompositionSchema - DataCompositionSchema - Scheme.
//	Parameter - String, DataCompositionParameter - name of the CD parameter to return the parameter value for.
//
// Returns:
//	DataCompositionSchemaParameter, Undefined - The value of the parameter, if the parameter is not found.
//
Function GetDCSParameter(DataCompositionSchema, Parameter) Export
	
	ParameterValue = Undefined;
	ParameterField_ = ?(TypeOf(Parameter) = Type("String"), New DataCompositionParameter(Parameter), Parameter);
	
	If TypeOf(DataCompositionSchema) = Type("DataCompositionSchema") Then
		ParameterValue = DataCompositionSchema.Parameters.Find(ParameterField_);
	EndIf;
	
	Return ParameterValue;
	
EndFunction

// Sets the data layout scheme parameter
//
// Parameters:
//	DataCompositionSchema - DataCompositionSchema - scheme of the layout.
//	Parameter - String, DataCompositionParameter - the option that you want to install.
//	Value - Arbitrary - the value that you want to install.
//	Use - Boolean - indicates whether the CD parameter is used.
//
// Returns:
//	DataCompositionSchemaParameter - the set parameter of the CD settings. Undefined if the parameter is not found.
//
Function SetDCSParameter(DataCompositionSchema, Parameter, Value, Use = True) Export
	
	ParameterValue = GetDCSParameter(DataCompositionSchema, Parameter);
	
	If ParameterValue <> Undefined Then
		If TypeOf(DataCompositionSchema) <> Type("DataCompositionSchema") Then
			ParameterValue.Use	= Use;
		EndIf;
		ParameterValue.Value		= Value;
	EndIf;
	
	Return ParameterValue;
	
EndFunction

// Finds a field by full name among the elements of the SCD fields.
//
// Parameters:
//	Items - DataCompositionAvailableFieldCollection - field of access control.
//	FullName - String - the full name field of access control.
//
// Returns:
//	DataCompositionField - SKD field.
//
Function FindDCSFieldByFullName(Items, FullName) Export
	
	ArrayOfNameParts = FromFullFieldNameGetParts(FullName);
	PartCount = ArrayOfNameParts.Count();
	
	CurrentName = ArrayOfNameParts[0];
	
	Field = FindDCSFieldByName(Items, CurrentName);
	If Field = Undefined Then
		Return Undefined;
	EndIf;
	
	For Cnt = 2 To PartCount Do
		CurrentName = CurrentName +"." + ArrayOfNameParts[Cnt-1];
		Field = FindDCSFieldByName(Field.Items, CurrentName);
		If Field = Undefined Then
			Return Undefined;
		EndIf;
	EndDo;
	
	Return Field;

EndFunction

