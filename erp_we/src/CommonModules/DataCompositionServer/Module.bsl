// Adds or refills parameter properties in the data layout schema
// 
// Parameters:
//	DataCompositionSchema - DataCompositionSchema - the schema to add parameters to or find and re-fill properties in.
//	ParameterName - String - parameter name.
//	ValueType - Type, Undefined - type of parameter values.
//	Value - Arbitrary, Undefined - default.
//	UseAlways_ - Boolean - True, then the parameters will always be used. False - automatic platform management.
//	ReFillExistingOne - Boolean - True, the parameter with the specified name will be searched before adding it.
//		Note that the operation is resource-intensive and should only be enabled if you can't check the uniqueness of the parameters otherwise.
//
// Returns:
//	DataCompositionParameter - a parameter that was created or refilled.
// 
Function AddParameter(DataCompositionSchema, ParameterName, ValueType = Undefined, Value = Undefined, UseAlways_ = True, ReFillExistingOne = False) Export
	
	Var Parameter;
	
	If Not ReFillExistingOne Then
		Parameter = DataCompositionSchema.Parameters.Add();
	Else
		Parameter = DataCompositionSchema.Parameters.Find(ParameterName);
		ParameterExists = Parameter <> Undefined;
		
		If Not ParameterExists Then
			Parameter = DataCompositionSchema.Parameters.Add();
		EndIf;
	EndIf;
	
	Parameter.Name = ParameterName;
	If ValueType <> Undefined Then
		Parameter.ValueType = ValueType;
	EndIf;
	
	If Value <> Undefined Then
		Parameter.Value = Value;
	EndIf;
	
	Parameter.Use = ?(UseAlways_,
								DataCompositionParameterUse.Always,
								DataCompositionParameterUse.Auto);
	
	Return Parameter;
	
EndFunction

// Adds a selection for comparison with the list of values loaded from the specified table column.
// 
// Parameters:
//	LayoutSettingsElement - DataCompositionSettingsComposer, DataCompositionSettings - data layout structure element
//	DataTable - ValueTable - table with data
//	ColumnName - String - name of the column to be compared with in the selection.
//
Procedure AddSelectionByValueTableColumn(LayoutSettingsElement, DataTable, ColumnName) Export
	
	Var ArrayOfSelectionValues, ValueList;
	
	ArrayOfSelectionValues = DataTable.UnloadColumn(ColumnName);
	ArrayOfSelectionValues = CommonClientServer.CollapseArray(ArrayOfSelectionValues);
	
	If Not (ArrayOfSelectionValues.Count() = 1 
		And TypeOf(ArrayOfSelectionValues[0]) = Type("Null")) Then
		ValueList = New ValueList;
		ValueList.LoadValues(ArrayOfSelectionValues);
		
		DataCompositionClientServer.AddFilter(LayoutSettingsElement,
			ColumnName,
			ValueList,
			DataCompositionComparisonType.InList);
	EndIf;

EndProcedure

// Returns an indication that at least one of the passed table names occurs in at least one query text for one
// of the data sets.
// 
// Parameters:
//	DataSets - DataCompositionSchemaDataSets - collection of data sets
//	TablesNames - Array - names of the required tables.
//
// Returns:
//	Boolean - True, table names are found in dataset queries.
// 
Function DatasetsAreReferencedInQueriesToTables(DataSets, TablesNames) Export
	// Let's check the queries of data sources for the use of the table name
	For Each DataSet In DataSets Do
		If TypeOf(DataSet) = Type("DataCompositionSchemaDataSetQuery") Then
			For Each TableName In TablesNames Do
				Query = Lower(DataSet.Query);
				SearchString = Lower(TableName);
				If StrFind(Query, SearchString) > 0 Then
					Return True;
				EndIf;
			EndDo;
		ElsIf TypeOf(DataSet) = Type("DataCompositionSchemaDataSetUnion") Then
			If DatasetsAreReferencedInQueriesToTables(DataSet.Items, TablesNames) Then
				Return True;
			EndIf;
		EndIf;
	EndDo;
	
	Return False;
	
EndFunction

// Allows you to copy parameters from one schema to another or within the schema.
