
#Region Public

// The procedure generates a transcript report based on the description prepared by the corresponding function of the client module.
//
// Parameters:
//		Form - Form - the form where the report is located
//		FormAttributeName - String - name of the reportobject form details
//		DescriptionOfDecryptionProcessing - DataCompositionDetailsProcessDescription - the value generated by the corresponding client function.
//
Procedure ProcessDecryption(Form, FormAttributeName, DescriptionOfDecryptionProcessing) Export
	ReportObject = Form.FormAttributeToValue(FormAttributeName);
	
	DetailsData = GetFromTempStorage(Form["DetailsDataAddress" + FormAttributeName]);
	AvailableSettingsSource = New DataCompositionAvailableSettingsSource(Form["SchemaURL" + FormAttributeName]);
	
	DetailProcessing = New DataCompositionDetailsProcess(DetailsData, AvailableSettingsSource);
	
	DetailsID = DescriptionOfDecryptionProcessing.ID; // DataCompositionDetailsID -
	ResultingSettings = DetailProcessing.ApplySettings(DetailsID,
		DescriptionOfDecryptionProcessing.UsedSettings);
	
	ReportObject.SettingsComposer.Initialize(AvailableSettingsSource);
	If TypeOf(ResultingSettings) = Type("DataCompositionSettings") Then
		ReportObject.SettingsComposer.LoadSettings(ResultingSettings);
	ElsIf TypeOf(ResultingSettings) = Type("DataCompositionUserSettings") Then
		ReportObject.SettingsComposer.LoadUserSettings(ResultingSettings);
	EndIf;
	
	// Get a table for the report output.
	ReportResultTable = Form["Table" + FormAttributeName];
	ReportResultTable.Clear();
	
	// Output the report.
	ReportObject.ComposeResult(ReportResultTable, DetailsData);
	
	Form["DetailsDataAddress" + FormAttributeName] = PutToTempStorage(DetailsData, New UUID());
EndProcedure

// The procedure generates a report located in the form with the settings made by the user.
//
// Parameters:
//		Form - Form - the form where the report is located
//		FormAttributeName - String - name of the reportobject form details
//		ReportName - String - name of the generated report in the metadata
//		NameOfSettingsOption - String - name of the report option in the report settings.
//
Procedure GenerateReport(Form, FormAttributeName, ReportName, NameOfSettingsOption) Export
	Var DetailsData;
	
	If Not AccessRight("Use", Metadata.Reports[ReportName]) Then
		Return;
	EndIf;
	
	// When updating the report, user settings are applied.
	
	ReportObject = Form.FormAttributeToValue(FormAttributeName);
	
	Form["SchemaURL" + FormAttributeName] = PutToTempStorage(ReportObject.DataCompositionSchema, Form.UUID);
	AvailableSettingsSource = New DataCompositionAvailableSettingsSource(Form["SchemaURL" + FormAttributeName]);
	
	ReportObject.SettingsComposer.Initialize(AvailableSettingsSource);
	ReportObject.SettingsComposer.Refresh(DataCompositionSettingsRefreshMethod.CheckAvailability);
	ReportObject.SettingsComposer.LoadUserSettings(ReportObject.SettingsComposer.UserSettings);
	
	SettingsComposer = ReportObject.SettingsComposer; // DataCompositionSettingsComposer -
	If ClientApplication.CurrentInterfaceVariant() = ClientApplicationInterfaceVariant.Taxi Then
		LayoutTemplateParameter = SettingsComposer.Settings.OutputParameters.Items.Find("AppearanceTemplate");
		If LayoutTemplateParameter.Value = "Main" 
			Or LayoutTemplateParameter.Value = "Main" Then
			LayoutTemplateParameter.Value = "ReportingBeige";
			LayoutTemplateParameter.Use = True;
		EndIf;
		
		For Each StructureItem In SettingsComposer.Settings.Structure Do
			If TypeOf(StructureItem) = Type("DataCompositionNestedObjectSettings") Then
				LayoutTemplateParameter = StructureItem.Settings.OutputParameters.Items.Find("AppearanceTemplate");
				If LayoutTemplateParameter.Value = "Main" 
					Or LayoutTemplateParameter.Value = "Main" Then
					LayoutTemplateParameter.Value = "ReportingBeige";
					LayoutTemplateParameter.Use = True;
				EndIf;
			EndIf;
		EndDo;
		
		Form.Items["Table" + FormAttributeName].ViewScalingMode = ViewScalingMode.Normal;
	EndIf;
	
	// Output the report.
	ReportResultTable = Form["Table" + FormAttributeName];
	ReportResultTable.Clear();
	
	ReportObject.ComposeResult(ReportResultTable, DetailsData);

	Form["DetailsDataAddress" + FormAttributeName] = PutToTempStorage(DetailsData, New UUID());
EndProcedure

// The procedure initializes the report located in the form with the default settings and sets context selections.
//
// Parameters:
//		Form - Form - the form where the report is located
//		FormAttributeName - String - name of the reportobject form details
//		ReportName - String - name of the generated report in the metadata
//		NameOfSettingsOption - String - name of the report option in the report settings
//		Filter - Structure - key - selection name, value-selection value
//		Parameters - Structure - key - parameter name, value-parameter value.
//
Procedure CustomizeStandardSettings(Form, FormAttributeName, ReportName, NameOfSettingsOption, Filter, Parameters = Undefined) Export
	If Not AccessRight("Use", Metadata.Reports[ReportName]) Then
		Return;
	EndIf;
	
	ReportObject = Form.FormAttributeToValue(FormAttributeName);		
	
	Form["SchemaURL" + FormAttributeName] = PutToTempStorage(ReportObject.DataCompositionSchema, Form.UUID);
	
	AvailableSettingsSource = New DataCompositionAvailableSettingsSource(Form["SchemaURL" + FormAttributeName]);
	
	ReportObject.SettingsComposer.Initialize(AvailableSettingsSource);
	
	DataCompositionSettings = ReportObject.DataCompositionSchema.SettingVariants[NameOfSettingsOption].Settings;
	ReportObject.SettingsComposer.LoadSettings(DataCompositionSettings);
	
	SettingsComposer = ReportObject.SettingsComposer; // DataCompositionSettingsComposer -
	For Each Item In Filter Do
		FilterElement = SettingsComposer.Settings.Filter.Items.Add(Type("DataCompositionFilterItem"));
		
		FilterElement.LeftValue = New DataCompositionField(Item.Key);
		FilterElement.ComparisonType = DataCompositionComparisonType.Equal;
		FilterElement.RightValue = Item.Value;
		FilterElement.Use = True;
	EndDo;
	
	If Parameters <> Undefined Then
		For Each Item In Parameters Do
			SettingsComposer.Settings.DataParameters.SetParameterValue(Item.Key, Item.Value);
		EndDo; 
	EndIf; 
	
EndProcedure

// Returns a string representation of a unique identifier
// The " - " characters are replaced with "_"
// Intended for use in SKD expressions.
// 
// Parameters:
//	IDSource - AnyRef, String, UUID - any link, string, or number.
//
// Returns:
//	String - string representation of a unique identifier.
//
Function RowUniqueIdentifier(IDSource) Export
	RowUniqueIdentifier = Undefined;
	
	If Common.IsReference(TypeOf(IDSource)) Then
		UUID = IDSource.UUID();
		RowUniqueIdentifier = TargetValueMonitoring.UniqueIDPerLine(UUID);
	ElsIf TypeOf(IDSource) = Type("UUID") Then
		RowUniqueIdentifier = TargetValueMonitoring.UniqueIDPerLine(UUID);
	Else
		RowUniqueIdentifier = IDSource;
	EndIf;
	
	Return RowUniqueIdentifier;
EndFunction

#Region PostProcessingReports

// This procedure changes the settings of charts and their elements in the design part 
// Design parameters (supported) can be used independently.
//
// Parameters:
//		SettingsComposer - DataCompositionSettingsComposer - report settings
//		SpreadsheetDocument - SpreadsheetDocument - result of report output
//		ChartParameters - Structure - Structure of variable chart parameters
//			Supported parameters:
//				The maximum number of series is a number greater than 0, determines the number of output series of the diagram, the "extra" series are combined into a summary series.
//					The value 999 is used to remove the restriction and output all series.
//				Maximumseries Percentage - Number - 0 - 100%, , determines the number of output series of the diagram, the "extra" series are combined into a summary series. 
//					The value 999 is used to remove the restriction and output all series.
//				Diagram Type - String - the name of the diagram type, as it is specified in the configurator
//				Selecting a series of datagrams - Number - "0" - do not select, "1" - select the first series, "2" - Select tracked analytics
//				Gradientseriagrams - Boolean - enables/disables the gradient mode of the color of the data series.
//
Procedure CreateReportDiagrams(SettingsComposer, SpreadsheetDocument, ChartParameters = Undefined) Export
	If ChartParameters = Undefined Then
		ChartParameters = ChartParameters(SettingsComposer);
	EndIf;
	For Each Drawing In SpreadsheetDocument.Drawings Do
		DrawingObject = Drawing.Object;
		If TypeOf(DrawingObject) = Type("Chart") Then
			Drawing.Line = New Line(SpreadsheetDocumentDrawingLineType.Solid);
			Drawing.LineColor = StyleColors.BorderColor;
			
			SetDefaultChartLayout(DrawingObject, ChartParameters);
		EndIf;
	EndDo;
	
	DeleteChartLayoutParameters(SettingsComposer, SpreadsheetDocument, ChartParameters);
EndProcedure

// Returns the structure of chart parameters to redefine
//
// Parameters:
//		SettingsComposer - DataCompositionSettingsComposer - report settings
// Returns:
//		Structure - the parameter name is set in the key, and the parameters value is set in the value.
Function ChartParameters(SettingsComposer) Export
	ChartParameters = New Structure;
	
	MaximumSeriesParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "MaxSeriesCount");
	If MaximumSeriesParameter <> Undefined And MaximumSeriesParameter.Use Then
		ChartParameters.Insert("MaxSeriesCount", MaximumSeriesParameter.Value);
	EndIf;
	
	ChartTypeParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "ChartType");
	If ChartTypeParameter <> Undefined And ChartTypeParameter.Use Then
		ChartParameters.Insert("ChartType", ChartTypeParameter.Value);
	EndIf;
	
	SelectChartSeriesParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "SelectionOfChartSeries");
	If SelectChartSeriesParameter <> Undefined And SelectChartSeriesParameter.Use Then
		ChartParameters.Insert("SelectionOfChartSeries", SelectChartSeriesParameter.Value);
	EndIf;
	
	GradientChartSeriesParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "GradientOfChartSeries");
	If GradientChartSeriesParameter <> Undefined And GradientChartSeriesParameter.Use Then
		ChartParameters.Insert("GradientOfChartSeries", GradientChartSeriesParameter.Value);
	EndIf;
	
	ParameterDisplayingChartPointMarkers = DataCompositionClientServer.GetParameter(SettingsComposer, "DisplayChartPointMarkers");
	If ParameterDisplayingChartPointMarkers <> Undefined And ParameterDisplayingChartPointMarkers.Use Then
		ChartParameters.Insert("DisplayChartPointMarkers", ParameterDisplayingChartPointMarkers.Value);
	EndIf;
	
	TrackedAnalyticsParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "FollowedDimensions");
	If TrackedAnalyticsParameter <> Undefined And TrackedAnalyticsParameter.Use Then
		ChartParameters.Insert("FollowedDimensions", TrackedAnalyticsParameter.Value);
	EndIf;
	
	Return ChartParameters;
EndFunction

// This procedure removes rows with auxiliary parameters from the report parameters section.
//
// Parameters:
//		DataCompositionSchema - DataCompositionSchema - scheme of the layout.
//		SettingsComposer - DataCompositionSettingsComposer - The linker settings.
//		SpreadsheetDocument - SpreadsheetDocument - result of the report output.
//		ReportParameters - Array of String - names of report parameters.
//
Procedure HideAuxiliaryReportParameters(DataCompositionSchema, SettingsComposer, SpreadsheetDocument, ReportParameters) Export
	HiddenReportParameters = New Array;
	For Each ReportParameter_ In ReportParameters Do
		AddParameterPresentationsToArray(DataCompositionSchema,
			SettingsComposer,
			HiddenReportParameters,
			ReportParameter_);
	EndDo;
	
	For Each HiddenReportParameter In HiddenReportParameters Do 
		RestoreParameterHeader = False;
		
		FoundArea = SpreadsheetDocument.FindText(HiddenReportParameter);
		If FoundArea <> Undefined 
			And FoundArea.ColumnSizeChangeMode = SizeChangeMode.Normal Then
			AreaToDelete_ = SpreadsheetDocument.Area(FoundArea.Top,, FoundArea.Bottom);
			
			If StrFind(SpreadsheetDocument.Area(FoundArea.Top, FoundArea.Left - 1).Text, 
					NStr("vi = 'Tham số';
						|ru = 'Параметры';
						|en = 'Parameters'; fa = 'پارامترها';
						|it = 'Parametri';
						|pl = 'Parametry';
						|tr = 'Parametreler'") + ":") > 0 Then
				RestoreParameterHeader = True;
				String = FoundArea.Top;
				Column = FoundArea.Left - 1;
			EndIf;
			
			SpreadsheetDocument.DeleteArea(AreaToDelete_, SpreadsheetDocumentShiftType.Vertical);
			
			If RestoreParameterHeader
				And IsBlankString(SpreadsheetDocument.Area(String, Column + 1, String, Column + 1).Text) Then
				RestoreParameterHeader = False;
			EndIf;
			
			If RestoreParameterHeader Then
				SpreadsheetDocument.Area(String, Column, String, Column).Text = NStr("vi = 'Tham số';
																					|ru = 'Параметры';
																					|en = 'Parameters'; fa = 'پارامترها';
																					|it = 'Parametri';
																					|pl = 'Parametry';
																					|tr = 'Parametreler'") + ":";
			EndIf;
			
			If SpreadsheetDocument.FixedTop <> 0 Then
				SpreadsheetDocument.FixedTop = SpreadsheetDocument.FixedTop - 1;
			EndIf;
		EndIf;
	EndDo;
EndProcedure

// The procedure adds auxiliary report parameters to the array,
// which are not automatically disabled by the values of functional options
// It should be used in conjunction with the Reportsoutdefinable method.Set up parameters for selecting functional options.
//
// Parameters:
//		ReportParameters - Array of String - names of report parameters.
//
Procedure AddAuxiliaryReportParametersForFunctionalOptions(ReportParameters) Export
	If Not GetFunctionalOption("UseMultipleCompanies") Then
		ReportParameters.Add("ShowSales_");
	EndIf;
	
	If Not GetFunctionalOption("UseMultipleCurrencies")
		Or GetFunctionalOption("BaseVersion") Then
		ReportParameters.Add("Currency");
		ReportParameters.Add("ReportCurrency");
		ReportParameters.Add("ReportData");
		ReportParameters.Add("CashInformation");
		ReportParameters.Add("SettlementsData");
		ReportParameters.Add("WithdrawAmounts");
	EndIf;
	
	If Not GetFunctionalOption("UseSeveralPriceTypes") Then
		ReportParameters.Add("PriceKind");
	EndIf;
	
	If Not GetFunctionalOption("UseUnitsOfMeasureForReports") Then
		ReportParameters.Add("QuantityUnits");
	EndIf;
EndProcedure

// Iterates through the layout layout cells and replaces their text.
//
// Parameters:
//		ReplacementParameters - Structure, Map - The key defines the text specified in the layout scheme
//													(framed with "%" signs), the value is the replacement text.
//		CompositionTemplate - DataCompositionTemplate - The layout of the layout headers will be substituted.
//
Procedure SetLayoutTemplateHeaders(ReplacementParameters, CompositionTemplate) Export
	
	If Not (TypeOf(ReplacementParameters) = Type("Structure")
		Or TypeOf(ReplacementParameters) = Type("Map")) Then
		
		Return;
		
	EndIf;
	
	For Each CurTemplate In CompositionTemplate.Templates Do
		If TypeOf(CurTemplate.Template) <> Type("DataCompositionAreaTemplate") Then
			Continue;
		EndIf;
		For Each RowOfLayoutTable In CurTemplate.Template Do
			For Each LayoutAreaTableCell In RowOfLayoutTable.Cells Do
				For Each Item In LayoutAreaTableCell.Items Do
					For Each Field In ReplacementParameters Do
						ReplacementString = "%" + Field.Key + "%";
						If StrFind(Item.Value, ReplacementString) > 0 Then
							Item.Value = StrReplace(Item.Value, ReplacementString, Field.Value);
						EndIf;
					EndDo;
				EndDo;
			EndDo;
		EndDo;
	EndDo;
	
EndProcedure

// The procedure searches for parameter representations by their name
// and places the found representations in the passed array.
//
// Parameters:
//		DataCompositionSchema - DataCompositionSchema - the report schema
//		SettingsComposer - DataCompositionSettingsComposer - report settings
//		Parameters - Array - parameters hidden from the report table document
//		ParameterName - String - name of the report parameter to hide.
//
Procedure AddParameterPresentationsToArray(DataCompositionSchema, SettingsComposer, Parameters, ParameterName) Export
	Parameter = DataCompositionSchema.Parameters.Find(ParameterName);
	If Not Parameter = Undefined Then
		ParameterHeader = Parameter.Title;
		
		LayoutParameter = DataCompositionClientServer.GetParameter(SettingsComposer, ParameterName);
		If ValueIsFilled(LayoutParameter.UserSettingID) Then
			SettingID = LayoutParameter.UserSettingID;
			If Not SettingsComposer.UserSettings.Items.Find(SettingID) = Undefined Then
				CustomParameterPresentation = "";
			Else
				CustomParameterPresentation = LayoutParameter.UserSettingPresentation;
			EndIf;
		Else
			CustomParameterPresentation = LayoutParameter.UserSettingPresentation;
		EndIf;
		
		Parameters.Add(ParameterHeader);
		Parameters.Add(CustomParameterPresentation);
	EndIf;
EndProcedure

