// Clears the report structure of deleted fields.
//
// Parameters:
//  ReportStructure - DataCompositionSettingStructureItemCollection 
//  FieldsToDelete__  - Array - contains layout fields that need to be removed from the report structure.
//
Procedure ClearStructureByFunctionalOptions(ReportStructure, FieldsToDelete__) Export

	For Each StructureItem In ReportStructure Do
		
		If TypeOf(StructureItem) = Type("DataCompositionGroup")
			Or TypeOf(StructureItem) = Type("DataCompositionTableGroup") Then
			ClearStructureByFunctionalOptions(StructureItem.Structure, FieldsToDelete__);
		ElsIf TypeOf(StructureItem) = Type("DataCompositionTable") Then
			
			ClearStructureByFunctionalOptions(StructureItem.Rows, FieldsToDelete__);
			Continue;
			
		EndIf;
		
		GroupFields = StructureItem.GroupFields.Items;
		IndexOf = GroupFields.Count() - 1;
		While IndexOf >= 0 Do
			
			If Not FieldsToDelete__.Find(GroupFields[IndexOf].Field) = Undefined Then
				GroupFields.Delete(GroupFields[IndexOf]);
			EndIf;
			
			IndexOf = IndexOf - 1;
			
		EndDo;
		
	EndDo;
	
EndProcedure

// Sets parameterizable headers for the selected data layout fields.
//
// Parameters:
//	Fields - DataCompositionSelectedFields - field layout of the data that you want to install the headers.
//	Parameters - Structure, Map - parameters for replacing the header text of the data layout field.
//											The key defines the text specified in the layout diagram (framed with "% " characters).
//											Value - the replacement text.
//
Procedure SetHeadersOfSelectedFields(Fields, Parameters) Export
	
	If Not (TypeOf(Parameters) = Type("Structure")
		Or TypeOf(Parameters) = Type("Map")) Then
		
		Return;
		
	EndIf;
	
	For Each Field In Fields Do
		If TypeOf(Field) = Type("DataCompositionAutoSelectedField") Then
			Continue;
		EndIf;
		
		For Each Parameter In Parameters Do
			ReplacementString = "%" + Parameter.Key + "%";
			
			If StrFind(Field.Title, ReplacementString) > 0 Then
				Field.Title = StrReplace(Field.Title, ReplacementString, Parameter.Value);
			EndIf;
		EndDo;
		
		If TypeOf(Field) = Type("DataCompositionSelectedFieldGroup") Then
			SetHeadersOfSelectedFields(Field.Items, Parameters);
		EndIf;
	EndDo;
	
EndProcedure

// Sets the generic headers of the fields in the group layout data.
//
// Parameters:
//	Fields - DataCompositionSettingStructureItemCollection, DataCompositionUserSettingsItemCollection - field layout of the data that you want to install the headers.
//	Parameters - Structure, Map - parameters for replacing the header text of the data layout field.
//											The key defines the text specified in the layout diagram (framed with "% " characters).
//											Value - the replacement text.
//
Procedure SetDimensionFieldHeaders(Fields, Parameters) Export
	
	If Not (TypeOf(Parameters) = Type("Structure")
		Or TypeOf(Parameters) = Type("Map")) Then
		
		Return;
		
	EndIf;
	
	HeaderParameter_ = New DataCompositionParameter("Title");
	
	For Each Field In Fields Do
		If TypeOf(Field) <> Type("DataCompositionGroup") Then
			Continue;
		EndIf;
		
		HeaderOutputParameter = Field.OutputParameters.FindParameterValue(HeaderParameter_);
		
		If HeaderOutputParameter.Use Then
			For Each Parameter In Parameters Do
				ReplacementString = "%" + Parameter.Key + "%";
				
				If StrFind(HeaderOutputParameter.Value, ReplacementString) > 0 Then
					HeaderOutputParameter.Value = StrReplace(HeaderOutputParameter.Value, ReplacementString, Parameter.Value);
				EndIf;
			EndDo;
		EndIf;
	EndDo;
	
EndProcedure

