// Expands all nodes of the passed tree
//
// Parameters:
//  Form - ClientApplicationForm - the form where the tree Value element is placed.
//  ElementTreeData - FormDataTree - a form element containing a tree of values.
//
Procedure ExpandTreeOfSavedItems(Form, ElementTreeData) Export
	
	FoundItems1 = ElementTreeData.GetItems();
	If FoundItems1.Count() = 1 Then
		RowID = FoundItems1[0].GetID();
		Form.Items.SavedItemsTree.Expand(RowID);
	EndIf;
	
EndProcedure

// Calculates the sum of selected cells in a table document.
//
// Parameters:
//	FieldAmount - Number - The sum of the cells.
//	Result - SpreadsheetDocument - Table document with cells.
//	SelectedAreaCache - Structure - Contains previously calculated cell values.
//	MustBeCalculatedOnServer - Boolean - Indicates that a server call is required.
//
Procedure CalculateSumOfSelectedCellsInTableDocument(FieldAmount, Result, SelectedAreaCache, MustBeCalculatedOnServer) Export
	
	If NeedToUpdateAmount(Result, SelectedAreaCache) Then
		FieldAmount = 0;
		NumberOfSelectedAreas = SelectedAreaCache.Count();
		If NumberOfSelectedAreas = 0      // Nothing is highlighted.
			Or SelectedAreaCache.Property("T") Then // The entire tabular document is highlighted (Ctrl+A).
			SelectedAreaCache.Insert("Sum", 0);
		ElsIf NumberOfSelectedAreas = 1 Then
			// If a small number of cells are allocated, we will get the amount on the client.
			For Each KeyAndValue In SelectedAreaCache Do
				StructureAddressOfAllocatedArea = KeyAndValue.Value;
			EndDo;
			
			VerticalAreaSize   = StructureAddressOfAllocatedArea.Bottom   - StructureAddressOfAllocatedArea.Top;
			HorizontalAreaSize = StructureAddressOfAllocatedArea.Right - StructureAddressOfAllocatedArea.Left;
			
			// In some reports, indicators (and analytics that the user can get up to)
			// are displayed in "combined" cells - it is not advisable in this case to make a server call. 
			// The selected area of 10 cells covers all such cases and will most likely always be available on the client.
			// At most, one implicit server call can be made.
			CalculateOnClient = (VerticalAreaSize + HorizontalAreaSize) < 12;
			If CalculateOnClient Then
				AmountInCells = 0;
				For RowIndex1 = StructureAddressOfAllocatedArea.Top To StructureAddressOfAllocatedArea.Bottom Do
					For IndexColumn = StructureAddressOfAllocatedArea.Left To StructureAddressOfAllocatedArea.Right Do
						Try
							Cell = Result.Area(RowIndex1, IndexColumn, RowIndex1, IndexColumn);
							If Cell.Visible = True Then
								If Cell.ContainsValue And TypeOf(Cell.Value) = Type("Number") Then
									AmountInCells = AmountInCells + Cell.Value;
								ElsIf ValueIsFilled(Cell.Text) Then
									NumberInCell  = Number(StringFunctionsClientServer.ReplaceCharsWithOther(Char(32)+Char(43), Cell.Text, Char(0)));
									AmountInCells = AmountInCells + NumberInCell;
								EndIf;
							EndIf;
						Except
							// No log entry is required.
						EndTry;
					EndDo;
				EndDo;
				
				FieldAmount = AmountInCells;
				SelectedAreaCache.Insert("Sum", FieldAmount);
			Else
				// If there are a lot of cells, then it is better to calculate the sum of cells on the server for one call,
				// because there can be much more implicit server calls.
				MustBeCalculatedOnServer = True;
			EndIf;
		Else
			// Calculate the sum of the cells on the server.
			MustBeCalculatedOnServer = True;
		EndIf;
	Else	
		FieldAmount = SelectedAreaCache.Sum;
	EndIf;
	
EndProcedure

#Region ReportDecryptionProceduresAndFunctions

// Called from the handler of the report form processing Decryption from the SKD report 
// generated by the financial reporting generator and financial reporting instances.
//
// Parameters:
//
//  ReportForm - ClientApplicationForm - form of the report that caused decryption processing.
//  Item - FormField - a form element containing the report result.
//  Details - Structure - standard SCD transcript.
//
Procedure ProcessingReportDecryption(ReportForm, Item, Details) Export
	
	If TypeOf(Details) <> Type("Structure") Then
		Return;
	EndIf;
	
	If Not Details.Property("Filter") Then
		Details.Insert("Filter", New Structure);
	EndIf;
	
	ReportParameters = NewReportParameters(); // Structure
	If ReportForm.FormName = "Report.FinancialReport.Form.ReportForm" Then
		
		FormReport = ReportForm.Report;
		
		If ReportForm.UseFilterByCompanies Then
			Details.Filter.Insert("Organization", ReportForm.Companies.UnloadValues());
		EndIf;
		If ReportForm.UseFilterByDepartments Then
			Details.Filter.Insert("Department", ReportForm.Departments.UnloadValues());
		EndIf;
		If ReportForm.UseSelectionByDirection Then
			Details.Filter.Insert("LineOfBusiness", ReportForm.Directions.UnloadValues());
		EndIf;
		
	Else
		
		FormReport = ReportForm.Object;
		
		CompanyArray = New Array;
		If ValueIsFilled(FormReport.Organization) Then
			CompanyArray.Add(FormReport.Organization);
		EndIf;
		
		ArrayOfDivisions = New Array;
		If ValueIsFilled(FormReport.Department) Then
			ArrayOfDivisions.Add(FormReport.Department);
		EndIf;
		
		Details.Filter.Insert("Organization", 	CompanyArray);
		Details.Filter.Insert("Department", ArrayOfDivisions);
		
	EndIf;
	
	FillPropertyValues(ReportParameters, ReportForm);
	FillPropertyValues(ReportParameters, FormReport);
	If Not Details.Property("Filter") Then
		Details.Insert("Filter", New Structure);
	EndIf;
	ReportParameters.Insert("Value", Item.CurrentArea.Text);
	ReportParameters.SettingsAddress = PutToTempStorage(Undefined, ReportForm.UUID);
	DetailsParameters = InternationalReportingServerCall.ReportDecryptionParameters(Details, ReportParameters);
	DetailsParameters.MultiplierOfAmounts = FormReport.MultiplierOfAmounts;
		
	If DetailsParameters = Undefined Or DetailsParameters.Factor = Undefined Then
		Return;
	EndIf;
	
	Factor = DetailsParameters.Factor; //Structure - See FinancialReportingClientServer.ReportElementStructure
	If Factor.ItemKind = ItemKind("MonetaryIndicator") Then
		If TypeOf(Factor.GLAccount_) = FinancialAccountingClientServer.TypeChartOfAccounts() Then
			
			ReportOpeningParameters= DetailsParameters.ParametersForOpeningInternationalAccountingReport;
			SettingsKey = "DecryptionOfFinancialReport";
			
			DecryptionReport = New Structure("ReportName, VariantName", 
					ReportOpeningParameters.ReportName,
					ReportOpeningParameters.ReportOptionName);
					
			FinancialAccountingClient.OpenDecryption(
				DecryptionReport, 
				ReportOpeningParameters.SettingsComposer, 
				SettingsKey, 
				SettingsKey);
			
		ElsIf TypeOf(Factor.GLAccount_) = LocalAccntingClientServer.TypeChartOfAccounts() Then
			ReportSettings1 = DetailsParameters.SettingUpLocalInvoiceAnalysis;
			LocalAccntingClient.OpenInvoiceAnalysisReport(DetailsParameters.Filter, ReportSettings1.SettingsAddress);
		Else
			ShowValue(Undefined, Factor.ReportItem);
		EndIf;
	ElsIf Factor.ItemKind = ItemKind("DerivedItem") Then
		FormParameters = New Structure("GenerateReport", True);
		FormParameters.Insert("DetailsParameters", DetailsParameters);
		OpenForm("Report.FinancialReport.Form", FormParameters, ReportForm, True);
		
	ElsIf Factor.ItemKind = ItemKind("NonMonetaryItem") Then
		ShowValue(Undefined, Factor.NonMonetaryItem);
		
	ElsIf ReportParameters.ReportKind <> Factor.Owner
		And ValueIsFilled(Factor.Owner) Then
		FormParameters = New Structure("GenerateReport", True);
		DetailsParameters.ReportKind = Factor.Owner;
		If Factor.ItemKind = ItemKind("TotalByGroup") Then
			DetailsParameters.Factor = DetailsParameters.EmptyRef;
		EndIf;
		FormParameters.Insert("DetailsParameters", DetailsParameters);
		OpenForm("Report.FinancialReport.Form.ReportForm", FormParameters, ReportForm, True);
		
	EndIf;
	
EndProcedure

#Region ProcessingOfFormulas

// The function adds new operands to the operand table
//
// Parameters:
//  Form  - ClientApplicationForm - formula constructor form
//  NewOperands  - Array - Operand tree strings
//  OperandsTable - ValueTable - Table of operands selected in the formula:
//   *AccountIndicatorDimension - String, CatalogRef.NonMonetaryItems, ChartOfAccountsRef - 
//   *ReportItem - CatalogRef.FinancialReportItems - 
//   *Id - String - 
//   *NameForPrinting - String - 
//   *ThisIsReference - Boolean - 
//   *AddressOfItemStructure - String - 
//   *CustomPicture - Number - 
//   *ItemKind - EnumRef.FinancialReportItemKinds - 
//   *Id - String - 
//   *GLAccount_ - ChartOfAccountsRef - 
//   *TotalType - EnumRef.TypesOfTotals - 
//   *OpeningBalance - Boolean - 
//   *HasSettings - Boolean - 
//   *Accuracy - Number -
//  Unique - Boolean - a sign of the uniqueness of the operands (add operands, if any).
//
// Returns:
//   Array   - array of added rows of the operand table.
//
Function AddFormulaOperands(Form, NewOperands, OperandsTable, Unique = True) Export
	
	TotalType = PredefinedValue("Enum.TypesOfTotals.Balance_Dr");
	ArrayOfAdded = New Array;
	For Each Operand In NewOperands Do
		
		If Operand.IsFolder Then
			Continue;
		EndIf;
		
		Id = OperandName(Operand, OperandsTable, Unique);
		FoundOperand = Undefined;
		If ThereIsIndicator(Id, OperandsTable, FoundOperand) Then
			ArrayOfAdded.Add(FoundOperand);
		ElsIf Operand.ThisIsReference Then
			AddStoredOperand(Form, OperandsTable, Operand, ArrayOfAdded);
		Else
			NewRow = OperandsTable.Add();
			FillPropertyValues(NewRow, Operand,,"ThisIsReference");
			NewRow.Id = Id;
			NewRow.GLAccount_ = Operand.ReportingKindItem;
			NewRow.TotalType = TotalType;
			NewRow.AccountIndicatorDimension = Operand.ReportingKindItem;
			ArrayOfAdded.Add(NewRow);
		EndIf;
		
		If Not Form.Modified Then
			Form.Modified = True;
		EndIf;
		
	EndDo;
	
	Return ArrayOfAdded;
	
EndFunction

