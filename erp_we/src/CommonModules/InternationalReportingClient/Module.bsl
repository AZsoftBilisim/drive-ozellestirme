#Region Private

Function NeedToUpdateAmount(Result, SelectedAreaCache)
	Var StructureAddressOfAllocatedArea;
	
	SelectedAreas    = Result.SelectedAreas;
	NumberOfAllocated = SelectedAreas.Count();
	
	If NumberOfAllocated = 0 Then
		SelectedAreaCache = New Structure();
		Return True;
	EndIf;
	
	ReturnValue = False;
	If TypeOf(SelectedAreaCache) <> Type("Structure") Then
		SelectedAreaCache = New Structure();
		ReturnValue = True;
	ElsIf SelectedAreas.Count() <> SelectedAreaCache.Count() Then
		SelectedAreaCache = New Structure();
		ReturnValue = True;
	Else
		For AreaIndex = 0 To NumberOfAllocated - 1 Do
			SelectedArea1 = SelectedAreas[AreaIndex];
			AreaName = StrReplace(SelectedArea1.Name, ":", "_");
			SelectedAreaCache.Property(AreaName, StructureAddressOfAllocatedArea);
			
			// We didn't find the desired area in the cache, so we reinitialize the cache.
			If TypeOf(StructureAddressOfAllocatedArea) <> Type("Structure") Then
				SelectedAreaCache = New Structure();
				ReturnValue = True;
				Break;
			EndIf;
		EndDo;
	EndIf;
	
	For AreaIndex = 0 To NumberOfAllocated - 1 Do
		SelectedArea1 = SelectedAreas[AreaIndex];
		AreaName = StrReplace(SelectedArea1.Name, ":", "_");
		
		If TypeOf(SelectedArea1) <> Type("SpreadsheetDocumentRange") Then
			StructureAddressOfAllocatedArea = New Structure;
			StructureAddressOfAllocatedArea.Insert("Top", 0);
			StructureAddressOfAllocatedArea.Insert("Bottom",  0);
			StructureAddressOfAllocatedArea.Insert("Left", 0);
			StructureAddressOfAllocatedArea.Insert("Right",0);
			SelectedAreaCache.Insert(AreaName, StructureAddressOfAllocatedArea);
			ReturnValue = True;
			Continue;
		EndIf;
		
		SelectedAreaCache.Property(AreaName, StructureAddressOfAllocatedArea);
		If TypeOf(StructureAddressOfAllocatedArea) <> Type("Structure") Then
			StructureAddressOfAllocatedArea = New Structure;
			StructureAddressOfAllocatedArea.Insert("Top", 0);
			StructureAddressOfAllocatedArea.Insert("Bottom",  0);
			StructureAddressOfAllocatedArea.Insert("Left", 0);
			StructureAddressOfAllocatedArea.Insert("Right",0);
			SelectedAreaCache.Insert(AreaName, StructureAddressOfAllocatedArea);
			ReturnValue = True;
		EndIf;
		
		If StructureAddressOfAllocatedArea.Top <> SelectedArea1.Top
			Or StructureAddressOfAllocatedArea.Bottom <> SelectedArea1.Bottom
			Or StructureAddressOfAllocatedArea.Left <> SelectedArea1.Left
			Or StructureAddressOfAllocatedArea.Right <> SelectedArea1.Right Then
				StructureAddressOfAllocatedArea = New Structure;
				StructureAddressOfAllocatedArea.Insert("Top",  SelectedArea1.Top);
				StructureAddressOfAllocatedArea.Insert("Bottom",   SelectedArea1.Bottom);
				StructureAddressOfAllocatedArea.Insert("Left",  SelectedArea1.Left);
				StructureAddressOfAllocatedArea.Insert("Right", SelectedArea1.Right);
				SelectedAreaCache.Insert(AreaName, StructureAddressOfAllocatedArea);
				ReturnValue = True;
		EndIf;
		
	EndDo;
	
	Return ReturnValue;
	
EndFunction

Function ItemKind(ElementTypeName)
	
	Return PredefinedValue("Enum.FinancialReportItemKinds."+ElementTypeName);
	
EndFunction

Function ThereIsIndicator(Id, OperandsTable, FoundOperand = Undefined)
	
	For Each OperandString_ In OperandsTable Do
		If OperandString_.Id = Id Then
			FoundOperand = OperandString_;
			Return True;
		EndIf;
	EndDo;
	
	Return False;
	
EndFunction

Function OperandName(Operand, OperandsTable, Unique = True)
	
	If Operand.Property("ReportingKindItem")
		And (TypeOf(Operand.ReportingKindItem) = FinancialAccountingClientServer.TypeChartOfAccounts()
		Or TypeOf(Operand.ReportingKindItem) = LocalAccntingClientServer.TypeChartOfAccounts())
		Or Operand.Property("GLAccount_") And ValueIsFilled(Operand.GLAccount_) Then
		Result = "Cnt" + Operand.Code;
		
		Result = StrReplace(Result," ","");
		Result = StrReplace(Result,".","_");
		Result = StrReplace(Result,",","_");
		Result = StrReplace(Result,"/","_");
	Else
		Try
			Result = "P" + Format(Number(Operand.Code), "NZ=0; NG=0");
		Except
			Result = "P" + Operand.Code;
		EndTry;
	EndIf;
	
	Id = Result;
	If Not Unique Then
		Return Id;
	EndIf;
	
	Cnt = 0;
	While ThereIsIndicator(Id, OperandsTable) Do
		Cnt = Cnt + 1;
		Id = Result + "_" + Format(Cnt, "NG=");
	EndDo;
	
	Return Id;
	
EndFunction

Procedure AddStoredOperand(Form, OperandsTable, Operand, ArrayOfAdded)

	OperandData = InternationalReportingClientServer.NewOperandData();
	FillPropertyValues(OperandData,Operand);
	Added2 = InternationalReportingServerCall.AddStoredOperand( 
					OperandData, 
					Form.MainStorageID);
	
	For Each NewOperand In Added2.NewOperands Do
		NewRow = OperandsTable.Add();
		FillPropertyValues(NewRow, NewOperand);
		If IsBlankString(NewRow.Id) Then
			NewRow.Id = OperandName(NewOperand, OperandsTable);
		EndIf;
		ArrayOfAdded.Add(NewOperand);
	EndDo;
	
	If Not IsBlankString(Added2.Formula) Then
		If Not IsBlankString(Form.Formula) Then
			Form.Formula = Form.Formula + Chars.LF;
		EndIf;
		Form.Formula = Form.Formula + Added2.Formula;
	EndIf;

EndProcedure

Function NewReportParameters()
	
	Result = New Structure;
	Result.Insert("ReportKind");
	Result.Insert("ReportingSet");
	Result.Insert("BeginOfPeriod");
	Result.Insert("EndOfPeriod");
	Result.Insert("DetailsData");
	Result.Insert("SettingsAddress");
	Result.Insert("Organization");
	Result.Insert("Department");
	Result.Insert("LineOfBusiness");
	Result.Insert("Resource");
	Result.Insert("IndicatorData");
	Return Result;
	
EndFunction

