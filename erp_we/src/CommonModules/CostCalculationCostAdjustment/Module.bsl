	|	T.CorInventoryOwnerAttribute,
	|	CASE
	|		WHEN T.CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|			THEN T.CorLineOfBusiness
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(T.CorItemsLocationAttributes.Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END, // CorLineOfBusiness
	|	CASE
	|		WHEN T.CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|			THEN T.Department
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.CorItemsLocationAttributes.StorageLocation
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END, // DebitBusinessUnit
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN ISNULL(T.CorItemsLocationAttributes.StorageLocation, UNDEFINED)
	|		ELSE UNDEFINED
	|	END, // BoxStorageLocation
	// Other
	|	T.AccountingDimensionByPartners,
	|	T.ExpenseItemOfWriteOff,
	|	T.DimensionOfExpenses,
	|	T.AssetAndLiabilityItem,
	|	T.AssetsLiabilitiesDimension,
	|	T.GLAccountSettings,
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting
	|
	|INDEX BY
	|	Organization,
	|	Products,
	|	Characteristic,
	|	InventoryOwnerAttribute,
	|	LineOfBusiness,
	|	Department,
	|	StorageLocation
	|;	
	|";
	#EndRegion

	#Region TTDeviationsFromPreviousPeriods
	QueryText = QueryText + "
	|SELECT
	|	Analysts.Period,
	|	Analysts.ThereIsCorPart,
	// Dimensions
	|	Analysts.AccountingSection AS AccountingSection,
	|	T.Organization AS Organization,
	|	T.Products AS Products,
	|	T.Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.Department AS Department,
	|	T.StorageLocation AS StorageLocation,
	|	Analysts.VariancePeriod AS VariancePeriod,
	// Cor Attributes
	|	Analysts.CorCompany AS CorCompany,
	|	Analysts.CorNomenclature AS CorNomenclature,
	|	Analysts.CorCharacteristics AS CorCharacteristics,
	|	Analysts.CorInventoryOwnerAttribute AS CorInventoryOwnerAttribute,
	|	Analysts.CorLineOfBusiness AS CorLineOfBusiness,
	|	Analysts.DebitBusinessUnit AS DebitBusinessUnit,
	|	Analysts.BoxStorageLocation AS BoxStorageLocation,
	// Other
	|	Analysts.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	|	Analysts.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
	|	Analysts.DimensionOfExpenses AS DimensionOfExpenses,
	|	Analysts.AssetAndLiabilityItem AS AssetAndLiabilityItem,
	|	Analysts.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	|	Analysts.GLAccountSettings AS GLAccountSettings,
	|	Analysts.BusinessReturnOperation AS BusinessOperation,
	|	Analysts.SettingUpBusinessOfOperationRefund AS BusinessTransactionSetting,
	|	Analysts.FinRecordID AS FinRecordID,
	|	Analysts.Count AS CountByDocument,
	|	Analysts.ReversingEntry AS ReversingEntry,
	|	SUM(T.CostVariancesIncludingVAT) AS CostVariancesIncludingVAT,
	|	SUM(T.CostVariancesExcludingVAT) AS CostVariancesExcludingVAT,
	|	SUM(T.CostVariancesLocal) AS CostVariancesLocal,
	|	SUM(T.CostVariancesMgmt) AS CostVariancesMgmt,
	|	SUM(T.AdditionalExpensesIncludingVAT) AS AdditionalExpensesIncludingVAT,
	|	SUM(T.AdditionalExpensesExcludingVAT) AS AdditionalExpensesExcludingVAT,
	|	SUM(T.AddExpensesLocal) AS AddExpensesLocal,
	|	SUM(T.AddExpensesMan) AS AddExpensesMan,
	|	SUM(T.VATLocal) AS VATLocal,
	|	SUM(T.VATManag) AS VATManag,
	|	SUM(T.PermanentDifference) AS PermanentDifference,
	|	SUM(T.CostTD) AS CostTD,
	|	SUM(T.AIT) AS AIT,
	|	SUM(T.Count) AS Count
	|
	|INTO TTDeviationsFromPreviousPeriods
	|FROM
	|	AnalyticsOfCorrectedDocumentsAndRefundsTT AS Analysts
	|	INNER JOIN AccumulationRegister.GoodsCostVariances AS T
	|		ON Analysts.VariancePeriod = BEGINOFPERIOD(T.Period, MONTH)
	// If the document being cancelled relates to returns of past periods, then the rejection period will refer to another past period.
	|		AND (Analysts.VariancePeriod = T.VariancePeriod
	|			OR T.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods))
	// Dimensions
	|		AND Analysts.Organization = T.Organization
	|		AND Analysts.Products = T.Products
	|		AND Analysts.Characteristic = T.Characteristic
	|		AND Analysts.InventoryOwnerAttribute = T.InventoryOwnerAttribute
	|		AND Analysts.LineOfBusiness = T.LineOfBusiness
	|		AND Analysts.Department = T.Department
	|		AND Analysts.StorageLocation = T.StorageLocation
	// Attributes
	|		AND Analysts.BusinessOperation = T.BusinessOperation
	|WHERE
	|	T.Period BETWEEN &MinimumPastPeriod AND &EndOfPreviousPeriod
	|	AND T.RecordType = VALUE(AccumulationRecordType.Expense)
	|	AND T.Active
	|	AND NOT T.ReversingEntry
	|
	|GROUP BY
	|	Analysts.Period,
	|	Analysts.ThereIsCorPart,
	|	Analysts.AccountingSection,
	|	T.Organization,
	|	T.Products,
	|	T.Characteristic,
	|	T.InventoryOwnerAttribute,
	|	T.LineOfBusiness,
	|	T.Department,
	|	T.StorageLocation,
	|	Analysts.VariancePeriod,
	// Cor Attributes
	|	Analysts.CorCompany,
	|	Analysts.CorNomenclature,
	|	Analysts.CorCharacteristics,
	|	Analysts.CorInventoryOwnerAttribute,
	|	Analysts.CorLineOfBusiness,
	|	Analysts.DebitBusinessUnit,
	|	Analysts.BoxStorageLocation,
	// Other
	|	Analysts.AccountingDimensionByPartners,
	|	Analysts.ExpenseItemOfWriteOff,
	|	Analysts.DimensionOfExpenses,
	|	Analysts.AssetAndLiabilityItem,
	|	Analysts.AssetsLiabilitiesDimension,
	|	Analysts.GLAccountSettings,
	|	Analysts.BusinessReturnOperation,
	|	Analysts.SettingUpBusinessOfOperationRefund,
	|	Analysts.FinRecordID,
	|	Analysts.Count,
	|	Analysts.ReversingEntry
	|;	
	|";

	#EndRegion
	
	#Region TTIsStornoOfDeviationsOfPreviousPeriod
	QueryText = QueryText + "
	|SELECT
	|	T.Period,
	|	Recorders.Ref AS Recorder,
	|	T.ThereIsCorPart,
	// Dimensions
	|	T.AccountingSection AS AccountingSection,
	|	T.Organization AS Organization,
	|	T.Products AS Products,
	|	T.Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.Department AS Department,
	|	T.StorageLocation AS StorageLocation,
	|	T.VariancePeriod AS VariancePeriod,
	// Cor Attributes
	|	T.CorCompany AS CorCompany,
	|	T.CorNomenclature AS CorNomenclature,
	|	T.CorCharacteristics AS CorCharacteristics,
	|	T.CorInventoryOwnerAttribute AS CorInventoryOwnerAttribute,
	|	T.CorLineOfBusiness AS CorLineOfBusiness,
	|	T.DebitBusinessUnit AS DebitBusinessUnit,
	|	T.BoxStorageLocation AS BoxStorageLocation,
	// Other
	|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
	|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	|	T.GLAccountSettings AS GLAccountSettings,
	|	T.BusinessOperation AS BusinessOperation,
	|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	T.FinRecordID AS FinRecordID,
	|	T.ReversingEntry AS ReversingEntry,
	|	(CASE
	|		WHEN T.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND TTAccountingPoliciesOfFinancialAccounting.ProductCostingByPlannedCost
	|		 AND TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN TRUE
	|		ELSE FALSE
	|	END) AS WriteOffDeviationsToCostOfGoodsSelling,
	|	(CASE WHEN T.ReversingEntry THEN -1 ELSE 1 END) AS Character,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.CostVariancesIncludingVAT
	|		ELSE CAST(T.CountByDocument * (T.CostVariancesIncludingVAT / T.Count) AS NUMBER(31,2))
	|		END) AS CostVariancesIncludingVAT,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.CostVariancesExcludingVAT
	|		ELSE CAST(T.CountByDocument * (T.CostVariancesExcludingVAT / T.Count) AS NUMBER(31,2))
	|		END) AS CostVariancesExcludingVAT,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.CostVariancesLocal
	|		ELSE CAST(T.CountByDocument * (T.CostVariancesLocal / T.Count) AS NUMBER(31,2))
	|		END) AS CostVariancesLocal,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.CostVariancesMgmt
	|		ELSE CAST(T.CountByDocument * (T.CostVariancesMgmt / T.Count) AS NUMBER(31,2))
	|		END) AS CostVariancesMgmt,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.AdditionalExpensesIncludingVAT
	|		ELSE CAST(T.CountByDocument * (T.AdditionalExpensesIncludingVAT / T.Count) AS NUMBER(31,2))
	|		END) AS AdditionalExpensesIncludingVAT,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.AdditionalExpensesExcludingVAT
	|		ELSE CAST(T.CountByDocument * (T.AdditionalExpensesExcludingVAT / T.Count) AS NUMBER(31,2))
	|		END) AS AdditionalExpensesExcludingVAT,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.AddExpensesLocal
	|		ELSE CAST(T.CountByDocument * (T.AddExpensesLocal / T.Count) AS NUMBER(31,2))
	|		END) AS AddExpensesLocal,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.AddExpensesMan
	|		ELSE CAST(T.CountByDocument * (T.AddExpensesMan / T.Count) AS NUMBER(31,2))
	|		END) AS AddExpensesMan,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.VATLocal
	|		ELSE CAST(T.CountByDocument * (T.VATLocal / T.Count) AS NUMBER(31,2))
	|		END) AS VATLocal,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.VATManag
	|		ELSE CAST(T.CountByDocument * (T.VATManag / T.Count) AS NUMBER(31,2))
	|		END) AS VATManag,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.PermanentDifference
	|		ELSE CAST(T.CountByDocument * (T.PermanentDifference / T.Count) AS NUMBER(31,2))
	|		END) AS PermanentDifference,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.CostTD
	|		ELSE CAST(T.CountByDocument * (T.CostTD / T.Count) AS NUMBER(31,2))
	|		END) AS CostTD,
	|	(CASE
	|		WHEN T.CountByDocument = T.Count OR T.Count = 0
	|			THEN T.AIT
	|		ELSE CAST(T.CountByDocument * (T.AIT / T.Count) AS NUMBER(31,2))
	|		END) AS AIT,
	|	T.CountByDocument AS Count
	|
	|INTO TTIsStornoOfDeviationsOfPreviousPeriod
	|FROM
	|	TTDeviationsFromPreviousPeriods AS T
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON T.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|	LEFT JOIN TTCostCalculationRecorders AS Recorders
	|		ON T.Organization = Recorders.Organization
	|;	
	|";

	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

