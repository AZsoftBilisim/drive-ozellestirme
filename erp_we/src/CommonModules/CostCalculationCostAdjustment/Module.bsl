Function TextOfRegisteredRecordsOfInventoryCostsByPeriod() // Uses the following movements for the highest values of goods by period
	Return "	
		|SELECT
		|	""TextOfRegisteredRecordsOfInventoryCostsByPeriod"" AS RequestSource,
		|	FALSE AS TheseAreLeftovers,
		|	T.ThisIsCurrentPeriod,
		|	T.ThereIsCorPart,
		|	T.SourceNodeNumber AS SourceNodeNumber,
		|	T.ReceiverNodeNumber AS ReceiverNodeNumber,
		|	SourceNodes.Recorder,
		|	T.Period,
		// Measurement of deviations
		|	T.Organization AS Organization,
		|	T.Products AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation AS StorageLocation,
		// Cost measurements
		|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
		|	T.AccountingSection AS AccountingSection,
		|	T.Lot AS Lot,
		|	T.LotVendorAttributes AS LotVendorAttributes,
		|	T.FinancialAccountingDimension AS FinancialAccountingDimension,
		|	T.VATActivityType AS VATActivityType,
		// Cor Attributes of deviations
		|	T.CorCompany,
		|	T.CorNomenclature AS CorNomenclature,
		|	T.CorCharacteristics CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	T.BoxStorageLocation BoxStorageLocation,
		// Cor Attributes
		|	T.CorItemsLocationAttributes,
		|	T.CorAccountingSection,
		|	T.CorLot,
		|	T.LotVendorAttributesCorr,
		|	T.CorControllingAttributes,
		|	T.CorVATActivityTypes,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	UNDEFINED AS ProductCostElement,
		|	UNDEFINED AS RuleOfCostAllocatingToProductionLots,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.ExpenseItemOfWriteOff AS CorExpenseItem,
		|	T.DimensionOfExpenses AS CorExpenditureDimension,
		|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		// The Setting up of the Business Operation field should be filled in the same way as the requests:
		// Textstory movementsreferences before the logoperiodesreading() and texttneactual movementsreferences().
		|	(CASE
		|		WHEN NOT T.Organization IN (&MediumSlipOrganizations)
		|			THEN T.BusinessTransactionSetting
		// For organizations on a medium-slip, separate household settings are used. of operations to reflect
		// the Registered Records of the register "Deviations in the cost of goods."
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		 OR T.AssetAndLiabilityItem <> UNDEFINED
		|		 AND T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposesVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
		|		 AND T.WriteOffDeviationsToCostOfGoodsSelling
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferOfProductsFromProductionVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.ProductReleaseVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.IntercompanyConsumptionReportSubcontractingServicesDeliveredVariances)
		|		WHEN NOT T.ThereIsCorPart
		|		 AND T.ExpenseItemOfWriteOff <> UNDEFINED
		|		 AND T.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.WriteOffAsExpensesVariances)
		|		ELSE T.BusinessTransactionSetting END) AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		|	T.DistributionPeriodSource AS DistributionPeriodSource,
		|	T.PeriodOfDistributionReceiver AS PeriodOfDistributionReceiver,
		|	FALSE AS ReversingEntry,
		|	FALSE AS WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	T.Count AS Count,
		|	CAST(T.Count * SourceNodes.CostVariancesIncludingVAT AS NUMBER(31,2)) AS CostVariancesIncludingVAT,
		|	CAST(T.Count * SourceNodes.CostVariancesExcludingVAT AS NUMBER(31,2)) AS CostVariancesExcludingVAT,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.CostVariancesLocal END AS NUMBER(31,2)) AS CostVariancesLocal,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.CostVariancesMgmt END AS NUMBER(31,2)) AS CostVariancesMgmt,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.VATLocal END AS NUMBER(31,2)) AS VATLocal,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.VATManag END AS NUMBER(31,2)) AS VATManag,
		|	CAST(T.Count * SourceNodes.AdditionalExpensesIncludingVAT AS NUMBER(31,2)) AS AdditionalExpensesIncludingVAT,
		|	CAST(T.Count * SourceNodes.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.AddExpensesLocal END AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.AddExpensesMan END AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.Count *
		|		CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling THEN 0
		|		ELSE SourceNodes.PermanentDifference END AS NUMBER(31,2)) AS PermanentDifference,
		|	CAST(T.Count *
		// Amount Local. accounting and Cost (PD) charged to cost of sales, therefore the temporary difference will decrease 
		// in the amount of Local. keeping and increasing the amount of permanent difference
		|		(CASE WHEN T.WriteOffDeviationsToCostOfGoodsSelling
		|			THEN -(SourceNodes.CostVariancesLocal
		|				+ SourceNodes.AddExpensesLocal
		|				+ SourceNodes.VATLocal
		|				- SourceNodes.PermanentDifference
		|				- SourceNodes.CostTD)
		|		ELSE SourceNodes.CostTD END) AS NUMBER(31,2)) AS CostTD,
		|	CAST(T.Count * SourceNodes.AIT AS NUMBER(31,2)) AS AIT
		|FROM
		|	TTOfRegisteredRecordsOfInventoryCostsByPeriod AS T
		|
		|	INNER JOIN TableOfSolutionsInDetail AS SourceNodes
		|		ON SourceNodes.NodeNumber = T.SourceNodeNumber
		|WHERE
		|	SourceNodes.ThereIsCost
		|	AND T.SourceNodeNumber <> ISNULL(T.ReceiverNodeNumber, -1)
		|";
EndFunction
		
Function TextWriteOffOfDeviationsToCostOfGoodsSold() // Uses the following movements for the highest values of goods by period
	// Write-off of deviations to the cost of sales.
	Return "
		|SELECT
		|	""TextWriteOffOfDeviationsToCostOfGoodsSold"" AS RequestSource,
		|	FALSE AS TheseAreLeftovers,
		|	T.ThisIsCurrentPeriod,
		|	FALSE AS ThereIsCorPart,
		|	T.SourceNodeNumber AS SourceNodeNumber,
		|	-1 AS ReceiverNodeNumber,
		|	SourceNodes.Recorder,
		|	T.Period,
		// Measurement of deviations
		|	T.Organization AS Organization,
		|	T.Products AS Products,
		|	T.Characteristic AS Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation AS StorageLocation,
		// Cost measurements
		|	T.ItemsLocationAttributes,
		|	T.AccountingSection,
		|	T.Lot,
		|	T.LotVendorAttributes,
		|	T.FinancialAccountingDimension,
		|	T.VATActivityType,
		// Cor Attributes of deviations
		|	T.CorCompany,
		|	T.CorNomenclature AS CorNomenclature,
		|	T.CorCharacteristics AS CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.Department AS DebitBusinessUnit,
		|	T.BoxStorageLocation AS BoxStorageLocation,
		// Cor Attributes
		|	T.CorItemsLocationAttributes,
		|	T.CorAccountingSection,
		|	T.CorLot,
		|	T.LotVendorAttributesCorr,
		|	T.CorControllingAttributes,
		|	T.CorVATActivityTypes,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	UNDEFINED AS ProductCostElement,
		|	UNDEFINED AS RuleOfCostAllocatingToProductionLots,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItemOfWriteOff,
		|	UNDEFINED AS DimensionOfExpenses,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
		|	UNDEFINED AS CorExpenditureDimension,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AssetAndLiabilityItem,
		|	UNDEFINED AS AssetsLiabilitiesDimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold) AS BusinessOperation,
		|	(CASE
		|		WHEN T.Organization IN (&MediumSlipOrganizations)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.WriteOffOfVariancesToCostOfGoodsSoldVariances)
		|		ELSE VALUE(Catalog.BusinessTransactionsSettings.WriteOffOfVariancesToCostOfGoodsSold) END) AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		|	SourceNodes.VariancePeriod AS DeviationPeriodSource,
		|	DATETIME(1,1,1) AS ReceiverDeviationPeriod,
		|	FALSE AS ReversingEntry,
		|	T.WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	T.Count AS Count,
		|	0 AS CostVariancesIncludingVAT,
		|	0 AS CostVariancesExcludingVAT,
		|	CAST(T.Count * SourceNodes.CostVariancesLocal AS NUMBER(31,2)) AS CostVariancesLocal,
		|	CAST(T.Count * SourceNodes.CostVariancesMgmt AS NUMBER(31,2)) AS CostVariancesMgmt,
		|	CAST(T.Count * SourceNodes.VATLocal AS NUMBER(31,2)) AS VATLocal,
		|	CAST(T.Count * SourceNodes.VATManag AS NUMBER(31,2)) AS VATManag,
		|	0 AS AdditionalExpensesIncludingVAT,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	CAST(T.Count * SourceNodes.AddExpensesLocal AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.Count * SourceNodes.AddExpensesMan AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.Count * SourceNodes.PermanentDifference AS NUMBER(31,2)) AS PermanentDifference,
		// When releasing products with write-off of deviations to the cost of goods sold, the cost of tax accounting will be zero,
		// so the amount of the temporary difference in deviations in cost should be reflected in the full amount of Local accounting
		// for the minus of the permanent difference.
		|	CAST(T.Count *
		|		(SourceNodes.CostVariancesLocal
		|		+ SourceNodes.AddExpensesLocal
		|		+ SourceNodes.VATLocal
		|		- SourceNodes.PermanentDifference) AS NUMBER(31,2)) AS CostTD,
		|	0 AS AIT
		|FROM
		|	TTOfRegisteredRecordsOfInventoryCostsByPeriod AS T
		|
		|	INNER JOIN TableOfSolutionsInDetail AS SourceNodes
		|		ON SourceNodes.NodeNumber = T.SourceNodeNumber
		|WHERE
		|	T.WriteOffDeviationsToCostOfGoodsSelling
		|	AND SourceNodes.ThereIsCost
		|";
EndFunction
		
Function TextDistributionOfExpensesForInventoryCosts() // Uses the movement method according to the periods, the table of decisions according to the period, the detailed
	// distribution of expenses for the inventory cost.
	Return "
		|SELECT
		|	""TextDistributionOfExpensesForInventoryCosts"" AS RequestSource,
		|	FALSE AS TheseAreLeftovers,
		|	FALSE AS ThisIsCurrentPeriod,
		|	TRUE AS ThereIsCorPart,
		|	SourceNodes.NodeNumber AS SourceNodeNumber,
		|	ISNULL(ReceiverNodes_.NodeNumber, -1) AS ReceiverNodeNumber,
		|	(CASE
		|		WHEN T.Recorder <> UNDEFINED THEN T.Recorder
		|		ELSE SourceNodes.Recorder END) AS Recorder,
		|	T.Period,
		// Measurement of deviations
		|	T.Organization AS Organization,
		|	UNDEFINED AS Products,
		|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
		|	VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Department,
		|	UNDEFINED AS StorageLocation,
		// Cost measurements
		|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ItemsLocationAttributes,
		|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS AccountingSection,
		|	T.Lot AS Lot,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributes,
		|	UNDEFINED AS FinancialAccountingDimension,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATActivityType,
		// Cor Attributes of deviations
		|	T.Organization AS CorCompany,
		|	T.CorNomenclature AS CorNomenclature,
		|	T.CorCharacteristics AS CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	T.BoxStorageLocation AS BoxStorageLocation,
		// Cor Attributes
		|	T.CorItemsLocationAttributes,
		|	T.CorAccountingSection,
		|	T.CorLot,
		|	T.LotVendorAttributesCorr,
		|	T.CorControllingAttributes,
		|	T.CorVATActivityTypes,
		// Other fields
		|	VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef) AS AccountingDimensionByPartners,
		|	T.ProductCostElement AS ProductCostElement,
		|	T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
		|	T.ExpenseItem AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.CorExpenseItem AS CorExpenseItem,
		|	T.CorExpenditureDimension AS CorExpenditureDimension,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AssetAndLiabilityItem,
		|	UNDEFINED AS AssetsLiabilitiesDimension,
		|	UNDEFINED AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	ISNULL(IDsTable.Id, T.FinRecordID) AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		|	SourceNodes.VariancePeriod AS DeviationPeriodSource,
		|	DATETIME(1,1,1) AS ReceiverDeviationPeriod,
		|	FALSE AS ReversingEntry,
		|	FALSE AS WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	0 AS Count,
		|	CAST(T.AmountIncludingVAT * SourceNodes.CostVariancesIncludingVAT AS NUMBER(31,2)) AS CostVariancesIncludingVAT,
		|	CAST(T.AmountExcludingVAT * SourceNodes.CostVariancesExcludingVAT AS NUMBER(31,2)) AS CostVariancesExcludingVAT,
		|	CAST(T.SumCompl * SourceNodes.CostVariancesLocal AS NUMBER(31,2)) AS CostVariancesLocal,
		|	CAST(T.SumMan * SourceNodes.CostVariancesMgmt AS NUMBER(31,2)) AS CostVariancesMgmt,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	CAST(T.AmountIncludingVAT * SourceNodes.AdditionalExpensesIncludingVAT AS NUMBER(31,2)) AS AdditionalExpensesIncludingVAT,
		|	CAST(T.AmountExcludingVAT * SourceNodes.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
		|	CAST(T.SumCompl * SourceNodes.AddExpensesLocal AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.SumMan * SourceNodes.AddExpensesMan AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.SumCompl * SourceNodes.PermanentDifference AS NUMBER(31,2)) AS PermanentDifference,
		|	CAST(CASE
		|		WHEN T.AmountFA = 0 AND T.SumCompl <> 0
		|			THEN T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.SumCompl * SourceNodes.AddExpensesLocal
		|			- T.SumCompl * SourceNodes.PermanentDifference
		|		WHEN T.AmountFA <> 0 AND T.SumCompl = 0
		|			THEN -(T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.AmountFA * SourceNodes.CostInTaxAccounting
		|			- T.SumCompl * SourceNodes.PermanentDifference)
		// If the cost in the node is TA zero, then the time Cost(TD) is calculated from the amount of Local.
		|		WHEN SourceNodes.CostInTaxAccounting = 0 AND SourceNodes.PermanentDifference = 0
		|			THEN T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.SumCompl * SourceNodes.AddExpensesLocal
		|		ELSE T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.SumCompl * SourceNodes.AddExpensesLocal
		|			- T.AmountFA * SourceNodes.CostInTaxAccounting
		|			- T.SumCompl * SourceNodes.PermanentDifference
		|		END AS NUMBER(31,2)) AS CostTD,
		|	CAST(T.AmountFA * SourceNodes.AIT AS NUMBER(31,2)) AS AIT
		|FROM
		|	RegisteredRecordsTTOtherExpensesByPeriod AS T
		|
		|	INNER JOIN TableOfSolutionsOtherExpensesInDetail AS SourceNodes
		|		ON SourceNodes.Organization = T.Organization
		|		AND SourceNodes.Department = T.Department
		|		AND SourceNodes.LineOfBusiness = T.LineOfBusiness
		|		AND SourceNodes.ExpenseItem = T.ExpenseItem
		|		AND SourceNodes.DimensionOfExpenses = T.DimensionOfExpenses	
		|		AND SourceNodes.Lot = T.Lot
		|		AND SourceNodes.DistributionPeriod = T.DistributionPeriod
		|		AND SourceNodes.VariancePeriod <= T.DistributionPeriod
		|
		// When distributing the costs of the receiving node, there may not be if the costs are distributed to the Balance of goods
		// for which there are no Registered Records.
		|	LEFT JOIN TableOfSolutionsInDetail AS ReceiverNodes_
		|		ON ReceiverNodes_.ItemsLocationAttributes = T.CorItemsLocationAttributes
		|		AND ReceiverNodes_.AccountingSection = T.CorAccountingSection
		|		AND ReceiverNodes_.InventoryOwnerAttribute = T.CorInventoryOwnerAttribute
		|		AND ReceiverNodes_.Lot = T.CorLot
		|		AND ReceiverNodes_.LotVendorAttributes = T.LotVendorAttributesCorr
		|		AND ReceiverNodes_.FinancialAccountingDimension = T.CorControllingAttributes
		|		AND ReceiverNodes_.VATActivityType = T.CorVATActivityTypes
		|		AND ReceiverNodes_.DistributionPeriod = T.DistributionPeriod
		|		AND ReceiverNodes_.VariancePeriod <= T.DistributionPeriod
		|		AND (CASE WHEN T.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
		|			THEN T.CorCompany ELSE T.Organization END) = ReceiverNodes_.Organization
		|
		|	LEFT JOIN IDsTable AS IDsTable
		|		ON IDsTable.SourceNodeNumber = SourceNodes.NodeNumber
		|		AND IDsTable.ReceiverNodeNumber = ReceiverNodes_.NodeNumber
		|		AND T.FinRecordID = """"
		|WHERE
		|	SourceNodes.ThereIsCost
		|	AND T.CorNomenclature <> VALUE(Catalog.Products.EmptyRef)
		|	AND VALUETYPE(T.CorLot) <> TYPE(Catalog.ProductionLots)
		|";
EndFunction
		
