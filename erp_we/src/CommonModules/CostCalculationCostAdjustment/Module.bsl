		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		|
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
