		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	UNDEFINED AS ProductCostElement,
		|	UNDEFINED AS RuleOfCostAllocatingToProductionLots,
		|	T.ExpenseItem AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.CorExpenseItem AS CorExpenseItem,
		|	T.CorExpenditureDimension AS CorExpenditureDimension,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AssetAndLiabilityItem,
		|	UNDEFINED AS AssetsLiabilitiesDimension,
		|	UNDEFINED AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	ISNULL(IDsTable.Id, T.FinRecordID) AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		|	SourceNodes.VariancePeriod AS DeviationPeriodSource,
		|	DATETIME(1,1,1) AS ReceiverDeviationPeriod,
		|	FALSE AS ReversingEntry,
		|	FALSE AS WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	0 AS Count,
		|	CAST(T.AmountIncludingVAT * SourceNodes.CostVariancesIncludingVAT AS NUMBER(31,2)) AS CostVariancesIncludingVAT,
		|	CAST(T.AmountExcludingVAT * SourceNodes.CostVariancesExcludingVAT AS NUMBER(31,2)) AS CostVariancesExcludingVAT,
		|	CAST(T.SumCompl * SourceNodes.CostVariancesLocal AS NUMBER(31,2)) AS CostVariancesLocal,
		|	CAST(T.SumMan * SourceNodes.CostVariancesMgmt AS NUMBER(31,2)) AS CostVariancesMgmt,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	CAST(T.AmountIncludingVAT * SourceNodes.AdditionalExpensesIncludingVAT AS NUMBER(31,2)) AS AdditionalExpensesIncludingVAT,
		|	CAST(T.AmountExcludingVAT * SourceNodes.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
		|	CAST(T.SumCompl * SourceNodes.AddExpensesLocal AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.SumMan * SourceNodes.AddExpensesMan AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.SumCompl * SourceNodes.PermanentDifference AS NUMBER(31,2)) AS PermanentDifference,
		|	CAST(CASE
		|		WHEN T.AmountFA = 0 AND T.SumCompl <> 0
		|			THEN T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.SumCompl * SourceNodes.AddExpensesLocal
		|			- T.SumCompl * SourceNodes.PermanentDifference
		|		WHEN T.AmountFA <> 0 AND T.SumCompl = 0
		|			THEN -(T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.AmountFA * SourceNodes.CostInTaxAccounting
		|			- T.SumCompl * SourceNodes.PermanentDifference)
		// If the cost in the node is TA zero, then the time Cost(TD) is calculated from the amount of Local.
		|		WHEN SourceNodes.CostInTaxAccounting = 0 AND SourceNodes.PermanentDifference = 0
		|			THEN T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.SumCompl * SourceNodes.AddExpensesLocal
		|		ELSE T.SumCompl * SourceNodes.CostVariancesLocal
		|			+ T.SumCompl * SourceNodes.AddExpensesLocal
		|			- T.AmountFA * SourceNodes.CostInTaxAccounting
		|			- T.SumCompl * SourceNodes.PermanentDifference
		|		END AS NUMBER(31,2)) AS CostTD,
		|	CAST(T.AmountFA * SourceNodes.AIT AS NUMBER(31,2)) AS AIT
		|FROM
		|	RegisteredRecordsTTOtherExpensesByPeriod AS T
		|
		|	INNER JOIN TableOfSolutionsOtherExpensesInDetail AS SourceNodes
		|		ON SourceNodes.Organization = T.Organization
		|		AND SourceNodes.Department = T.Department
		|		AND SourceNodes.LineOfBusiness = T.LineOfBusiness
		|		AND SourceNodes.ExpenseItem = T.ExpenseItem
		|		AND SourceNodes.DimensionOfExpenses = T.DimensionOfExpenses	
		|		AND SourceNodes.Lot = UNDEFINED
		|		AND SourceNodes.DistributionPeriod = T.DistributionPeriod
		|		AND SourceNodes.VariancePeriod <= T.DistributionPeriod
		|
		|	LEFT JOIN TableOfSolutionsOtherExpensesInDetail AS ReceiverNodes_
		|		ON ReceiverNodes_.Organization = T.CorCompany
		|		AND ReceiverNodes_.Department = T.DebitBusinessUnit
		|		AND ReceiverNodes_.LineOfBusiness = T.CorLineOfBusiness
		|		AND ReceiverNodes_.ExpenseItem = T.CorExpenseItem
		|		AND ReceiverNodes_.DimensionOfExpenses = T.CorExpenditureDimension
		|		AND ReceiverNodes_.Lot = UNDEFINED
		|		AND ReceiverNodes_.DistributionPeriod = T.DistributionPeriod
		|		AND ReceiverNodes_.VariancePeriod <= T.DistributionPeriod
		|
		|	LEFT JOIN IDsTable AS IDsTable
		|		ON IDsTable.SourceNodeNumber = SourceNodes.NodeNumber
		|		AND IDsTable.ReceiverNodeNumber = ReceiverNodes_.NodeNumber
		|WHERE
		|	SourceNodes.ThereIsCost
		|	AND T.CorNomenclature = VALUE(Catalog.Products.EmptyRef)
		|	AND T.CorLot = UNDEFINED
		|";
EndFunction

Function TextTTOfIrrelevantRegisteredRecordsOtherExpensesPreliminary() // TTIrrelevantRegisteredRecordsOtherExpensesPreliminary
	Return "
		|SELECT
		|	TRUE AS ThereAreRegisteredRecords,
		|	T.ThereIsCorPart,
		|	UNDEFINED AS Recorder,
		|	T.Period,
		// Measurement of deviations
		|	T.Organization AS Organization,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Department,
		|	T.ExpenseItem AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		// Cor Attributes
		|	T.Organization AS CorCompany,
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	T.CorExpenseItem AS CorExpenseItem,
		|	T.CorExpenditureDimension AS CorExpenditureDimension,
		// Other fields
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		// Resources
		|	0 AS AdditionalExpensesIncludingVAT,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	0 AS AddExpensesLocal,
		|	0 AS AddExpensesMan,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	0 AS AIT
		|
		|INTO TTIrrelevantRegisteredRecordsOtherExpensesPreliminary
		|FROM
		|	RegisteredRecordsTTOtherExpensesByPeriod AS T
		|
		|UNION ALL
		|
		|SELECT
		|	FALSE AS ThereAreRegisteredRecords,
		|	CASE
		|		WHEN MotionCor.Recorder IS NULL
		|			THEN FALSE 
		|		ELSE TRUE END AS ThereIsCorPart,
		|	Recorders.Ref AS Recorder,
		|	T.Period,
		// Measurement of deviations
		|	T.Organization AS Organization,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Department,
		|	T.ExpenseItem AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		// Cor Attributes
		|	T.Organization AS CorCompany,
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	T.CorExpenseItem AS CorExpenseItem,
		|	T.CorExpenditureDimension AS CorExpenditureDimension,
		// Other fields
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		// Resources
		|	-T.Sum AS AdditionalExpensesIncludingVAT,
		|	-T.AmountExcludingVAT AS AdditionalExpensesExcludingVAT,
		|	-T.SumCompl AS AddExpensesLocal,
		|	-T.SumMan AS AddExpensesMan,
		|	-T.PermanentDifference AS PermanentDifference,
		|	-T.CostTD AS CostTD,
		|	-T.AITAmount AS AIT
		|FROM
		|	AccumulationRegister.OtherExpenses AS T
		|	LEFT JOIN TTCostCalculationRecorders AS Recorders
		|		ON T.Organization = Recorders.Organization
		|	LEFT JOIN AccumulationRegister.OtherExpenses AS MotionCor
		|		ON MotionCor.Recorder = T.Recorder
		|		AND MotionCor.Period = T.Period
		|		AND MotionCor.BusinessTransactionSetting = T.BusinessTransactionSetting
		|		AND MotionCor.FinRecordID = T.FinRecordID
		|		AND MotionCor.RecordType = VALUE(AccumulationRecordType.Receipt)
		|		AND MotionCor.Sum = T.Sum
		|		AND MotionCor.AmountExcludingVAT = T.AmountExcludingVAT
		|		AND MotionCor.SumCompl = T.SumCompl
		|		AND MotionCor.SumMan = T.SumMan
		|		AND MotionCor.PermanentDifference = T.PermanentDifference
		|		AND MotionCor.CostTD = T.CostTD
		|WHERE
		|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
		|	AND T.RecordType = VALUE(AccumulationRecordType.Expense)
		|	AND T.Active
		|	AND T.Recorder REFS Document.CostCalculationRecorder
		|	AND NOT T.BusinessOperation IN (
		|		VALUE(Enum.BusinessTransactions.WriteOffVariancesToAllocate))
		|	AND T.Organization IN (
		|		SELECT
		|			Filter.Organization
		|		FROM
		|			RegisteredRecordsTTOtherExpensesByPeriod AS Filter)
		|";
EndFunction

Function TextTTOfIrrelevantRegisteredRecordsOtherExpenses() // TTIrrelevantRegisteredRecordsOtherExpenses
	Return "
		|SELECT
		|	MAX(T.ThereAreRegisteredRecords) AS ThereAreRegisteredRecords,
		|	MAX(T.ThereIsCorPart) AS ThereIsCorPart,
		|	MAX(T.Recorder) AS Recorder,
		|	T.Period,
		// Dimensions
		|	T.Organization AS Organization,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.Department,
		|	T.ExpenseItem AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		// Cor Attributes
		|	T.Organization AS CorCompany,
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	T.CorExpenseItem AS CorExpenseItem,
		|	T.CorExpenditureDimension AS CorExpenditureDimension,
		// Other fields
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		// Resources
		|	SUM(T.AdditionalExpensesIncludingVAT) AS AdditionalExpensesIncludingVAT,
		|	SUM(T.AdditionalExpensesExcludingVAT) AS AdditionalExpensesExcludingVAT,
		|	SUM(T.AddExpensesLocal) AS AddExpensesLocal,
		|	SUM(T.AddExpensesMan) AS AddExpensesMan,
		|	SUM(T.PermanentDifference) AS PermanentDifference,
		|	SUM(T.CostTD) AS CostTD,
		|	SUM(T.AIT) AS AIT
		|
		|INTO TTIrrelevantRegisteredRecordsOtherExpenses
		|FROM
		|	TTIrrelevantRegisteredRecordsOtherExpensesPreliminary AS T
		|GROUP BY
		|	T.Period,
		// Dimensions
		|	T.Organization,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.ExpenseItem,
		|	T.DimensionOfExpenses,
		// Cor Attributes
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.CorExpenseItem,
		|	T.CorExpenditureDimension,
		// Other fields
		|	T.BusinessOperation,
		|	T.BusinessTransactionSetting,
		|	T.FinRecordID
		|HAVING
		|	MAX(T.ThereAreRegisteredRecords) = FALSE
		|	AND (SUM(T.AdditionalExpensesIncludingVAT) <> 0
		|		OR SUM(T.AdditionalExpensesExcludingVAT) <> 0
		|		OR SUM(T.AddExpensesLocal) <> 0
		|		OR SUM(T.AddExpensesMan) <> 0
		|		OR SUM(T.PermanentDifference) <> 0
		|		OR SUM(T.CostTD) <> 0
		|		OR SUM(T.AIT) <> 0)
		|";
EndFunction

