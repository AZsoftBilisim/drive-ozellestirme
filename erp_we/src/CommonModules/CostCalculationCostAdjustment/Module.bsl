#Region Initialize

// Before starting the calculation, it fills in all the necessary parameters and initializes all data structures used by the calculation algorithm.
// If the cost calculation is not called independently, but as a batch calculation step
// , the calculation Parameters parameter will already be initialized by the General properties of the calculation mechanisms.
//
// Note: if an entity is used in more than one calculation step, it should be entered in the calculation Parameters.
//
Procedure InitializeGeneralCostCalculationParameters(StartupParameters, CalculationParameters, DebugParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "InitializeGeneralCostCalculationParameters");
	
	// Let's create a container of all parameters used by the batch calculation mechanism
	InitializationParameters = New Structure;
	CostCalculationOnly =
		?(StartupParameters.Property("CostCalculationOnly"), StartupParameters.CostCalculationOnly, False);
	PreliminaryCalculation =
		?(StartupParameters.Property("PreliminaryCalculation"), StartupParameters.PreliminaryCalculation, False);
	InitializationParameters.Insert("Date",
		?(CostCalculationOnly And PreliminaryCalculation,
			EndOfDay(StartupParameters.Date), EndOfMonth(StartupParameters.Date)));
	InitializationParameters.Insert("BeginOfPeriod", BegOfMonth(StartupParameters.Date));
	InitializationParameters.Insert("EndOfPeriod", InitializationParameters.Date);
	If StartupParameters.Property("OnlyOneOrganization") And StartupParameters.OnlyOneOrganization Then
		InitializationParameters.Insert("CompanyArray", StartupParameters.CompanyArray);
	Else
		InitializationParameters.Insert("CompanyArray",
			?(TypeOf(StartupParameters.CompanyArray) <> Type("Array") And ValueIsFilled(StartupParameters.CompanyArray),
				CostCalculationAppliedAlgorithms.LinksOfOrganizationsUnderIntercampanyScheme(BegOfMonth(StartupParameters.Date), StartupParameters.CompanyArray),
				StartupParameters.CompanyArray));
	EndIf;
	InitializationParameters.Insert("BatchCalculationStarted", False);
	InitializationParameters.Insert("OnlyPreliminaryCostCalculation",
		?(CostCalculationOnly, PreliminaryCalculation, False));
	InitializationParameters.Insert("StartedByRoutineTask", 
		?(StartupParameters.Property("ScheduledJob"), StartupParameters.ScheduledJob, False));
	
	If StartupParameters.Property("DocumentsChanged") Then
		// Regular call from the batch accounting mechanism version 2.1.
		InitializationParameters.Insert("DocumentsChanged", StartupParameters.DocumentsChanged);
	EndIf;
	If StartupParameters.Property("MeasurementDetails") Then
		// Regular call from the batch accounting mechanism version 2.1.
		InitializationParameters.Insert("MeasurementDetails", StartupParameters.MeasurementDetails);
	EndIf;
	
	If StartupParameters.Property("AutoTesting") And StartupParameters.AutoTesting Then
		InitializationParameters.Insert("AutoTesting", True); // called during testing
	Else
		InitializationParameters.Insert("AutoTesting", False);
	EndIf;
	
	If CostCalculationOnly And StartupParameters.Property("PlaceOfCalculationCall") Then
		InitializationParameters.Insert("PlaceOfCalculationCall", StartupParameters.PlaceOfCalculationCall);
	EndIf;
	
	CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters(
		InitializationParameters, CalculationParameters, DebugParameters);
		
	If CalculationParameters.BatchCalculationStarted Then
		
		CostCalculationAppliedAlgorithms.CostCalculationMechanismIsPerformed(CalculationParameters, True);
		
		If CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, "TTValueOfBatchesOfGoods") > 0 Then
			
			CostCalculationProtocol.CleaningUpFormedRegisteredRecords(
				CalculationParameters,
				Metadata.InformationRegisters.GoodsCost.Name);
			
		EndIf;
		
		If CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, "TTCostAdjustmentUnits") > 0 Then
			
			CostCalculationAppliedAlgorithms.ClearTemporaryTable(CalculationParameters, "TTCostAdjustmentUnits");
			CostCalculationAppliedAlgorithms.ClearTemporaryTable(CalculationParameters, "TTCommunicationNodesCostAdjustment");
			
		EndIf;
		
	Else
		
		TaskNumberBeforeCalculation = InformationRegisters.JobsForCalculatingCost.GetTaskNumber();
		CalculationParameters.Insert("TaskNumberBeforeCalculation", TaskNumberBeforeCalculation - 1);
		
		// Let's remember the calculation protocol and return it to the place where the calculation is called
		DebugParameters.Insert("CalculationProtocols", New Array);
		
		// Initialize the caches of registers serviced by the batch accounting mechanism
		// The caches will be directly updated in initialize parameters of the calculation of the value of the group of organizations
		For Each KeyAndValue In UsedCachesOfBatchAccountingRegisters() Do
			
			Register = KeyAndValue.Key; // MetadataObjectAccumulationRegister
			CostCalculationAppliedAlgorithms.InitializeRegisterData(CalculationParameters, Register);
			
			RegisterDescription = CalculationParameters.RegisterRecords[Register.Name];
			RegisterDescription.UseTTCache = False; // the calculated movements should be taken from the information security data
			
		EndDo;
		
	EndIf;
	
	// General cost calculation parameters
	CalculationParameters.Insert("PreliminaryCalculation", PreliminaryCalculation);
	CalculationParameters.Insert("SaveSLU",
		StartupParameters.Property("SaveSLU") And StartupParameters.SaveSLU);
	
EndProcedure

Procedure InitializeCostCalculationParametersForGroupOfOrganizations(StartupParameters, CalculationParameters, DebugParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "InitializeCostCalculationParametersForGroupOfOrganizations");
	
	CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
		CalculationParameters,
		StartupParameters.GroupOfOrganizations.Count());
	
	// Let's replace the main selection by organizations with the current calculated group.
	// At the end of the cost calculation, the main selection will be restored from the calculation parameters.Copies of Mass organizations
	OnlyOneOrganization = StartupParameters.Property("OnlyOneOrganization") And StartupParameters.OnlyOneOrganization;
	If Not OnlyOneOrganization Then
		CalculationParameters.Insert("CompanyArray", StartupParameters.GroupOfOrganizations);
	EndIf;
	CalculationParameters.Insert("EvaluationMethod", 	   StartupParameters.EvaluationMethod); // a common assessment method for this group of organizations
	
	// Let's update the temporary tables with selections by organizations.
	CostCalculationAppliedAlgorithms.InitializeTemporaryTablesForSelections(CalculationParameters);
	
	// Let's update all the calculated caches of balances and turnover - they should only contain records for the calculated group of organizations
	// If the calculation is caused by a routine operation, then we calculate the cost according to the average (excluding batches)
	// To do this, the fields related to batches will be "cleared" in the calculated cache of revolutions and balances
	// If the cost calculation is called from the batch accounting mechanism, then at the end of the cost calculation
	// , the settlement caches will be restored automatically.
	CostCalculationAppliedAlgorithms.UpdateCalculatedRegisterCaches_(CalculationParameters);
	
	CalculationParameters.Insert("NodeCount",     0);
	CalculationParameters.Insert("NumberOfLocalNodes", 0);
	
	// Let's add information about the current iteration of the cost calculation to the calculation protocol
	ProtocolString = NStr("vi = 'Dạng tính toán giá vốn';
							|ru = 'Вид расчета себестоимости';
							|en = 'Cost calculation kind'; fa = 'Cost calculation kind';
							|it = 'Tipo del calcolo del costo di produzione';
							|pl = 'Rodzaj obliczania kosztów własnych';
							|tr = 'Alacak/Borç türü maliyeti'", Common.DefaultLanguageCode()) + ": "
		+ ?(CalculationParameters.PreliminaryCalculation, NStr("vi = 'Xem trước';
																|ru = 'Предварительный';
																|en = 'Preliminary'; fa = 'مقدماتی';
																|it = 'Preliminare';
																|pl = 'Wstępny';
																|tr = 'Başlangıc'", Common.DefaultLanguageCode()), NStr("vi = 'Thực tế';
																														|ru = 'Фактический';
																														|en = 'Actual'; fa = 'واقعی';
																														|it = 'Effettivo';
																														|pl = 'Faktyczny';
																														|tr = 'Gerçek'", Common.DefaultLanguageCode()));
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, ProtocolString);
	
	If CalculationParameters.PreliminaryCalculation Then
		// The evaluation method does not affect the calculation algorithm
		PresentationOfEvaluationMethod = NStr("vi = 'Không ảnh hưởng đến kết quả tính toán';
												|ru = 'Не влияет на результат расчета';
												|en = 'Does not affect the calculation result'; fa = 'Does not affect the calculation result';
												|it = 'Non influisce sul risultato di calcolo';
												|pl = 'Nie wpływa na wynik rozliczenia';
												|tr = 'Hesaplama sonucunu etkilemez'", Common.DefaultLanguageCode());
	ElsIf CalculationParameters.BatchAccountingVersion22 And Not ValueIsFilled(CalculationParameters.EvaluationMethod) Then
		// See CostCalculationAppliedAlgorithms.DetermineMethodOfValuationForGroupOfOrganizations
		PresentationOfEvaluationMethod = NStr("vi = 'Khác với ""FIFO (đánh giá bình quân)""';
												|ru = 'Отличный от ""ФИФО (взвешенная оценка)""';
												|en = 'Different from ""FIFO (weighted estimate)""'; fa = 'Different from ""FIFO (weighted estimate)""';
												|it = 'Altro che ""FIFO (punteggio ponderato)""';
												|pl = 'Różni się od ""FIFO (ocena ważona)""';
												|tr = '""FIFO''dan (ağırlıklı değerleme)"" farklı'", Common.DefaultLanguageCode());
	Else
		PresentationOfEvaluationMethod = CalculationParameters.EvaluationMethod;
	EndIf;
	
	ProtocolString = NStr("vi = 'Phương pháp đánh giá giá trị';
							|ru = 'Метод оценки стоимости';
							|en = 'Cost evaluation method'; fa = 'روش ارزیابی بهای تمام‌شده';
							|it = 'Metodo di valutazione del costo';
							|pl = 'Metoda oceny kosztów';
							|tr = 'Maliyet değerleme yöntemi'", Common.DefaultLanguageCode()) + ": "
