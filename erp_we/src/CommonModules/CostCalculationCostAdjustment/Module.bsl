#Region StageProcedure_StornoSuspendedProductionCosts

// Performs the formation of storno suspended production expenses. Suspended production expenses may arise
// by Lot references of production, which in the current period performed the reversal of output or allocation of expenses,
// including distributable.
//
// Parameters:
//	CalculationParameters - Structure - cost calculation parameters
//
Procedure StornoSuspendedProductionCosts(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "StornoSuspendedProductionCosts");
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"TTCostRegisteredRecords,
		|TTOtherWorkInProgressExpenses,
		|RegisteredRecordsOfTTWIPLaborCostsOfWorkInProgress");
	
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextOfStornoSuspendedProductionCostsExpense(CalculationParameters));
	
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "StornoSuspendedProductionCosts_RegisteredRecordFormation");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	// Expendable Registered Records of Unfinished production.
	
	// Add the row IDs to the Registered Records.
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(
		CalculationParameters,
		CalculationParameters.RegisterRecords[Metadata.AccumulationRegisters.InventoryCost.Name],
		"TTCostRegisteredRecords");
	
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(
		CalculationParameters,
		CalculationParameters.RegisterRecords[Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name],
		"TTOtherWorkInProgressExpenses",
		"Organization, Department, ExpenseItem, DimensionOfExpenses, LineOfBusiness,
		|ProductionLot, ProductCostElement, ProductsGroup, RuleOfCostAllocatingToProductionLots");
	
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(
		CalculationParameters,
		CalculationParameters.RegisterRecords[Metadata.AccumulationRegisters.WIPLaborCosts.Name],
		"RegisteredRecordsOfTTWIPLaborCostsOfWorkInProgress",
		"ProductionLot");
	
	// The incoming RegisteredRecorded in otherexpenses with matching by row IDs
	Query.Text = TextOfStornoSuspendedProductionCostsReceipt(CalculationParameters);
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	MatchingTemporaryMovementTables = New Map;
	
#Region WriteOffOfInventoryCostOfGoods
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.InventoryCost.Name);
	DescriptionOfTT.TTResultName = "TTCostOfReverseRegisteredRecords";
	DescriptionOfTT.NameOfSourceTT = "TTCostRegisteredRecords";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion
	
#Region WriteOffOfOtherExpensesOfWorkInProgress

	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name);
	DescriptionOfTT.TTResultName = "TTOtherWorkInProgressExpensesStornot";
	DescriptionOfTT.NameOfSourceTT = "TTOtherWorkInProgressExpenses";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion
	
#Region WriteOffOfWorkInWIPLaborCosts

	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.WIPLaborCosts.Name);
	DescriptionOfTT.TTResultName = "TTWIPLaborCostsOfWorkInProgressStornoOfRegisteredRecords";
	DescriptionOfTT.NameOfSourceTT = "RegisteredRecordsOfTTWIPLaborCostsOfWorkInProgress";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion
	
#Region RegistrationOtherExpenses
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherExpenses.Name);
	DescriptionOfTT.TTResultName = "TTOtherExpensesStornot";
	DescriptionOfTT.NameOfSourceTT = "TTOtherExpenses";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

Function TextOfStornoSuspendedProductionCostsExpense(CalculationParameters)
	
	QueryText = "";
	
	#Region CorrectionCostOfGoods // TTCostRegisteredRecords

	QueryText = QueryText + "
	|SELECT
	|	VALUE(Enum.LotRecordTypes.AdditionLotsCalculation) AS EntryType,
	|	&EndOfPeriod                          AS Period,
	|	CostCalculationDocuments.Ref   AS Recorder,
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	// Dimensions
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	DD.Organization,
	|	DD.Lot,
	|	DD.LotVendorAttributes,
	|	DD.FinancialAccountingDimension,
	|	DD.VATActivityType,
	// Resources
	|	DD.Count AS Count,
	|	0 AS Cost,
	|	0 AS CostExcludingVAT,
	|	0 AS OffBalanceCost,
	|	0 AS CostMan,
	|	0 AS AddExpensesMan,
	|	0 AS ItemizedVariableCostsIncludingVAT,
	|	0 AS ItemizedVariableCostsExcludingVAT,
	|	0 AS LaborCostsMan,
	|	0 AS ItemizedFixedCostsManag,
	|	0 AS ItemizedVariableCostsManag,
	|	0 AS AddExpensesForGoods,
	|	0 AS AdditionalExpensesExcludingVAT,
	|	0 AS LaborCosts,
	|	0 AS ItemizedFixedCostsIncludingVAT,
	|	0 AS ItemizedFixedCostsExcludingVAT,
	|	0 AS LocalCost,
	|	0 AS OffBalanceCostLocal,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	0 AS CostOfPersonalIncomeTax,
	|	0 AS AddExpensesLocal,
	|	0 AS LaborCostsLocal,
	|	0 AS ItemizedFixedCostsCompl,
	|	0 AS ItemizedVariableCostsCompl,
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan,
	// Attributes
	|	CostCalculationDocuments.Ref AS DocumentRegisterRecords,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.ProductionCostsReverseTransaction) AS ExpenseItemOfWriteOff,
	|	ProductionLots.Products AS DimensionOfExpenses,
	|	ProductionLots.LineOfBusiness AS CorLineOfBusiness,
	|	DD.ItemsLocationAttributes.Department AS Department,
	|	VALUE(Enum.BusinessTransactions.ProductionCostsReverseTransaction)        AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ProductionCostsReverseTransaction) AS BusinessTransactionSetting
	|INTO TTCostRegisteredRecords
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS DD
	|	
	|	INNER JOIN ProductionBatchesAreSummarized AS ProductionLots
	|	ON ProductionLots.ProductionLot = DD.Lot
	|	AND ProductionLots.Organization = DD.Organization
	|	
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|	ON CostCalculationDocuments.Organization = DD.Organization
	|
	|WHERE
	|	NOT DD.Count = 0
	|	AND NOT ProductionLots.CostAllocationForIssue
	|;";
	#EndRegion
	
	#Region CorrectionOtherWorkInProgressExpenses
	QueryText = QueryText + "
	|SELECT
	|	&EndOfPeriod                          AS Period,
	|	CostCalculationDocuments.Ref   AS Recorder,
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	// Dimensions
	|	DD.ExpenseItem                      AS ExpenseItem,
	|	DD.Organization                         AS Organization,
	|	DD.Department                       AS Department,
	|	DD.DimensionOfExpenses                   AS DimensionOfExpenses,
	|	DD.LineOfBusiness             AS LineOfBusiness,
	|	DD.ProductionLot                  AS ProductionLot,
	|	DD.ProductCostElement                   AS ProductCostElement,
	|	DD.ProductsGroup                     AS ProductsGroup,
	|	DD.RuleOfCostAllocatingToProductionLots            AS RuleOfCostAllocatingToProductionLots,
	// Resources
	|	DD.CostShare                      AS CostShare,
	|	DD.Cost                          AS Cost,
	|	DD.CostExcludingVAT                    AS CostExcludingVAT,
	|	DD.LocalCost                      AS LocalCost,
	|	DD.PermanentDifference                  AS PermanentDifference,
	|	DD.CostTD                   AS CostTD,
	|	DD.CostOfPersonalIncomeTax                       AS CostOfPersonalIncomeTax,
	|	DD.CostMan                       AS CostMan,
	// Attributes
	|	VALUE(Enum.BusinessTransactions.ProductionCostsReverseTransaction)        AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ProductionCostsReverseTransaction) AS BusinessTransactionSetting
	|INTO TTOtherWorkInProgressExpenses
	|FROM
	|	TTCashSettlementBalancesOtherWorkInProgressExpenses AS DD
	|	
	|	INNER JOIN ProductionBatchesAreSummarized AS ProductionLots
	|	ON ProductionLots.ProductionLot = DD.ProductionLot
	|	AND ProductionLots.Organization = DD.Organization
	|	
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|	ON CostCalculationDocuments.Organization = DD.Organization
	|
	|WHERE
	|	(NOT DD.CostShare = 0
	|		OR NOT DD.Cost = 0
	|		OR NOT DD.CostExcludingVAT = 0
	|		OR NOT DD.LocalCost = 0
	|		OR NOT DD.PermanentDifference = 0
	|		OR NOT DD.CostTD = 0
	|		OR NOT DD.CostOfPersonalIncomeTax = 0
	|		OR NOT DD.CostMan = 0)
	|	AND NOT ProductionLots.CostAllocationForIssue
	|;";
	#EndRegion
	
	#Region CorrectionWIPLaborCostsOfWorkInProgress
	QueryText = QueryText + "
	|SELECT
	|	&EndOfPeriod                          AS Period,
	|	CostCalculationDocuments.Ref   AS Recorder,
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	// Dimensions
	|	DD.Organization                         AS Organization,
	|	DD.Department                       AS Department,
	|	DD.WorkKind                            AS WorkKind,
	|	DD.ContributionsFundKind                     AS ContributionsFundKind,
	|	DD.ProductionLot                  AS ProductionLot,
	|	DD.ProductCostElement                   AS ProductCostElement,
	|	DD.ProductsGroup                     AS ProductsGroup,
	// Resources
	|	DD.Count                         AS Count,
	|	DD.StandardCost               AS StandardCost,
	|	DD.Cost                          AS Cost,
	|	DD.LocalCost                      AS LocalCost,
	|	DD.PermanentDifference                  AS PermanentDifference,
	|	DD.CostTD                   AS CostTD,
	|	DD.CostOfPersonalIncomeTax                       AS CostOfPersonalIncomeTax,
	// Attributes
	|	VALUE(Enum.BusinessTransactions.ProductionCostsReverseTransaction)        AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ProductionCostsReverseTransaction) AS BusinessTransactionSetting
	|INTO RegisteredRecordsOfTTWIPLaborCostsOfWorkInProgress
	|FROM
	|	TTCashEstimatedBalancesWorkInProgress AS DD
	|	
	|	INNER JOIN ProductionBatchesAreSummarized AS ProductionLots
	|	ON ProductionLots.ProductionLot = DD.ProductionLot
	|	AND ProductionLots.Organization = DD.Organization
	|	
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|	ON CostCalculationDocuments.Organization = DD.Organization
	|
	|WHERE
	|	(NOT DD.Count = 0
	|		OR NOT DD.StandardCost = 0
	|		OR NOT DD.Cost = 0
	|		OR NOT DD.LocalCost = 0
	|		OR NOT DD.PermanentDifference = 0
	|		OR NOT DD.CostTD = 0
	|		OR NOT DD.CostOfPersonalIncomeTax = 0)
	|	AND NOT ProductionLots.CostAllocationForIssue
	|;";
	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

Function TextOfStornoSuspendedProductionCostsReceipt(CalculationParameters)
	
	QueryText = "";
	
	#Region CorrectionOtherExpenses
	
	QueryText = QueryText + "
	// To get the initial units for Receipt of otherexpenses, select the Registered Records cor. from the otherexpenses.
	// For this purpose, only documents of distribution of other expenses are suitable.
	// There may be several distribution documents, as well as initial divisions, so we select only 1 division.
	|SELECT DISTINCT
	|	OtherExpensesOfUnfinishedProduction.Recorder              AS Recorder,
	|	OtherExpensesOfUnfinishedProduction.ProductionLot       AS ProductionLot,
	|	OtherExpensesOfUnfinishedProduction.DimensionOfExpenses        AS DimensionOfExpenses,
	|	OtherExpensesOfUnfinishedProduction.ExpenseItem           AS ExpenseItem,
	|	OtherExpensesOfUnfinishedProduction.LineOfBusiness  AS LineOfBusiness,
	|	OtherExpensesOfUnfinishedProduction.ProductsGroup          AS ProductsGroup,
	|	OtherExpensesOfUnfinishedProduction.ProductCostElement        AS ProductCostElement,
	|	OtherExpensesOfUnfinishedProduction.Organization              AS Organization,
	|	OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|	OtherExpensesOfUnfinishedProduction.Department            AS Department
	|	
	|INTO TTOfRegisteredRecordsOtherExpensesUnfinishedProductionOfCorrectionsOfProductionWithoutOrder
	|FROM
	|	AccumulationRegister.OtherWorkInProgressExpenses AS OtherExpensesOfUnfinishedProduction
	|
	|	INNER JOIN TTOtherWorkInProgressExpenses AS DD
	|	ON OtherExpensesOfUnfinishedProduction.Organization = DD.Organization
	|	AND OtherExpensesOfUnfinishedProduction.Department = DD.Department
	|	AND OtherExpensesOfUnfinishedProduction.ExpenseItem = DD.ExpenseItem
	|	AND OtherExpensesOfUnfinishedProduction.DimensionOfExpenses = DD.DimensionOfExpenses
	|	AND OtherExpensesOfUnfinishedProduction.LineOfBusiness = DD.LineOfBusiness
	|	AND OtherExpensesOfUnfinishedProduction.ProductionLot = DD.ProductionLot
	|	AND OtherExpensesOfUnfinishedProduction.ProductCostElement = DD.ProductCostElement
	|	AND OtherExpensesOfUnfinishedProduction.ProductsGroup = DD.ProductsGroup
	|	AND OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = DD.RuleOfCostAllocatingToProductionLots
	|	
	|	INNER JOIN Catalog.ProductionLots AS ProductionLots
	|	ON ProductionLots.Ref = DD.ProductionLot
	|	
	|	LEFT JOIN Document.BackflushProduction AS AttributesBP
	|	ON AttributesBP.Ref = ProductionLots.Document
	|
	|WHERE
	|	OtherExpensesOfUnfinishedProduction.Period < &BeginOfPeriod
	|	AND OtherExpensesOfUnfinishedProduction.Active
	|	AND OtherExpensesOfUnfinishedProduction.RecordType = VALUE(AccumulationRecordType.Receipt)
	|	AND VALUETYPE(OtherExpensesOfUnfinishedProduction.Recorder) = TYPE(Document.AllocationOfOtherCosts)
	|	AND NOT (&BatchAccountingWasUsedBeforeSwitchingToVersion22 = TRUE // the parameter value can be UNDEFINED
	|		AND OtherExpensesOfUnfinishedProduction.Period < &DateOfMigrationToBatchAccounting22)
	// For old chains of corrections, we keep the write-off to "Storno of production Expenses",
	// so the list of source items is formed only for new chains.
	|	AND ISNULL(AttributesBP.CorrectionSavesProductionLots, TRUE)
	|
	|INDEX BY
	|	Recorder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	OtherExpensesOfUnfinishedProduction.ProductionLot                AS ProductionLot,
	|	OtherExpensesOfUnfinishedProduction.DimensionOfExpenses                 AS DimensionOfExpenses,
	|	OtherExpensesOfUnfinishedProduction.ExpenseItem                    AS ExpenseItem,
	|	OtherExpensesOfUnfinishedProduction.Department                     AS Department,
	|	OtherExpensesOfUnfinishedProduction.LineOfBusiness           AS LineOfBusiness,
	|	OtherExpensesOfUnfinishedProduction.ProductCostElement                 AS ProductCostElement,
	|	OtherExpensesOfUnfinishedProduction.Organization                       AS Organization,
	|	OtherExpensesOfUnfinishedProduction.ProductsGroup                   AS ProductsGroup,
	|	OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots          AS RuleOfCostAllocatingToProductionLots,
	|	MAX(CorOtherExpenses.Department)           AS SourceDivision,
	|	MAX(CorOtherExpenses.LineOfBusiness) AS InitialDirectionOfActivity
	|INTO InitialUnitsOfCorrectionsOfProductionWithoutOrdersForOtherExpensesOfUnfinishedProduction
	|FROM
	|	TTOfRegisteredRecordsOtherExpensesUnfinishedProductionOfCorrectionsOfProductionWithoutOrder AS OtherExpensesOfUnfinishedProduction
	|	
	|	INNER JOIN AccumulationRegister.OtherExpenses AS CorOtherExpenses
	|	ON OtherExpensesOfUnfinishedProduction.Recorder = CorOtherExpenses.Recorder
	|
	|GROUP BY
	|	OtherExpensesOfUnfinishedProduction.ExpenseItem,
	|	OtherExpensesOfUnfinishedProduction.Department,
	|	OtherExpensesOfUnfinishedProduction.Organization,
	|	OtherExpensesOfUnfinishedProduction.DimensionOfExpenses,
	|	OtherExpensesOfUnfinishedProduction.LineOfBusiness,
	|	OtherExpensesOfUnfinishedProduction.ProductionLot,
	|	OtherExpensesOfUnfinishedProduction.ProductCostElement,
	|	OtherExpensesOfUnfinishedProduction.ProductsGroup,
	|	OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots
	|
	|INDEX BY
	|	ProductionLot,
	|	DimensionOfExpenses,
	|	ExpenseItem,
	|	Department,
	|	LineOfBusiness,
	|	ProductCostElement,
	|	Organization,
	|	ProductsGroup,
	|	RuleOfCostAllocatingToProductionLots
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Attribution of the value of nomenclature expenses to other expenses (when reversing backflushed production)
	|SELECT
	|	DD.Period                                      AS Period,
	|	DD.Recorder                                 AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt)         AS RecordType,
	// Dimensions
	|	DD.Organization                                 AS Organization,
	|	DD.Department                               AS Department,
	|	DD.CorLineOfBusiness                  AS LineOfBusiness,
	|	DD.ExpenseItemOfWriteOff                      AS ExpenseItem,
	|	DD.DimensionOfExpenses                           AS DimensionOfExpenses,
	// Resources
	|	(DD.Cost
	|		+ DD.AddExpensesForGoods
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsIncludingVAT
	|		+ DD.ItemizedVariableCostsIncludingVAT)            AS Sum,
	|	(DD.CostExcludingVAT
	|		+ DD.AdditionalExpensesExcludingVAT
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsExcludingVAT
	|		+ DD.ItemizedVariableCostsExcludingVAT)          AS AmountExcludingVAT,
	|	(DD.LocalCost
	|		+ DD.AddExpensesLocal
	|		+ DD.LaborCostsLocal
	|		+ DD.ItemizedFixedCostsCompl
	|		+ DD.ItemizedVariableCostsCompl
	|		+ DD.ProvisionForImpairmentLocal)             AS SumCompl,
	|	DD.PermanentDifference                          AS PermanentDifference,
	|	DD.CostTD                           AS CostTD,
	|	DD.CostOfPersonalIncomeTax                               AS AITAmount,
	|	(DD.CostMan
	|		+ DD.AddExpensesLocal
	|		+ DD.AddExpensesMan
	|		+ DD.ItemizedFixedCostsManag
	|		+ DD.ItemizedVariableCostsManag
	|		+ DD.ProvisionForImpairmentMan)              AS SumMan,
	// Attributes
	|	DD.BusinessOperation                       AS BusinessOperation,
	|	DD.ItemsLocationAttributes                  AS ItemsLocationAttributes,
	|	DD.DocumentRegisterRecords                            AS DocumentRegisterRecords,
	|	DD.BusinessTransactionSetting              AS BusinessTransactionSetting,
	|	DD.FinRecordID                      AS FinRecordID
	|INTO TTOtherExpenses
	|FROM
	|	TTCostRegisteredRecords AS DD
	|	
	|UNION ALL
	|
	// Attribution of the cost of item-by-item costs to other expenses (when reversing production without orders)
	|SELECT
	|	DD.Period                         AS Period,
	|	DD.Recorder                    AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	// Dimensions
	|	DD.Organization                    AS Organization,
	|	ISNULL(InitialDataOfItemByItemCosts.SourceDivision, DD.Department) AS Department,
	|	ISNULL(InitialDataOfItemByItemCosts.InitialDirectionOfActivity, DD.LineOfBusiness) AS LineOfBusiness,
	|	ISNULL(InitialDataOfItemByItemCosts.ExpenseItem, VALUE(ChartOfCharacteristicTypes.ExpenseItems.ProductionCostsReverseTransaction)) AS ExpenseItem,
	|	ISNULL(InitialDataOfItemByItemCosts.DimensionOfExpenses, ProductionLots.MainProductProducts) AS DimensionOfExpenses,
	// Resources
	|	DD.Cost                      AS Sum,
	|	DD.CostExcludingVAT                AS AmountExcludingVAT,
	|	DD.LocalCost                  AS SumCompl,
	|	DD.PermanentDifference              AS PermanentDifference,
	|	DD.CostTD               AS CostTD,
	|	DD.CostOfPersonalIncomeTax                   AS AITAmount,
	|	DD.CostMan                   AS SumMan,
	// Attributes
	|	DD.BusinessOperation          AS BusinessOperation,
	|	UNDEFINED                      AS ItemsLocationAttributes,
	|	UNDEFINED                      AS DocumentRegisterRecords,
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	DD.FinRecordID         AS FinRecordID
	|FROM
	|	TTOtherWorkInProgressExpenses AS DD
	|
	|	LEFT JOIN InitialUnitsOfCorrectionsOfProductionWithoutOrdersForOtherExpensesOfUnfinishedProduction AS InitialDataOfItemByItemCosts
	|	ON InitialDataOfItemByItemCosts.Organization = DD.Organization
	|		AND InitialDataOfItemByItemCosts.Department = DD.Department
	|		AND InitialDataOfItemByItemCosts.ExpenseItem = DD.ExpenseItem
	|		AND InitialDataOfItemByItemCosts.DimensionOfExpenses = DD.DimensionOfExpenses
	|		AND InitialDataOfItemByItemCosts.LineOfBusiness = DD.LineOfBusiness
	|		AND InitialDataOfItemByItemCosts.ProductionLot = DD.ProductionLot
	|		AND InitialDataOfItemByItemCosts.ProductCostElement = DD.ProductCostElement
	|		AND InitialDataOfItemByItemCosts.ProductsGroup = DD.ProductsGroup
	|		AND InitialDataOfItemByItemCosts.RuleOfCostAllocatingToProductionLots = DD.RuleOfCostAllocatingToProductionLots
	|	
	|	INNER JOIN Catalog.ProductionLots AS ProductionLots
	|	ON ProductionLots.Ref = DD.ProductionLot
	|
	|UNION ALL
	|
	// Attribution of the cost of labor to otherexpenses (when canceling backflushed production)
	|SELECT
	|	DD.Period                                      AS Period,
	|	DD.Recorder                                 AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt)         AS RecordType,
	// Dimensions
	|	DD.Organization                                 AS Organization,
	|	DD.Department                               AS Department,
	|	ProductionLots.LineOfBusiness     AS LineOfBusiness,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.ProductionCostsReverseTransaction) AS ExpenseItem,
	|	ProductionLots.MainProductProducts AS DimensionOfExpenses,
	// Resources
	|	DD.Cost                                  AS Sum,
	|	DD.Cost                                  AS AmountExcludingVAT,
	|	DD.LocalCost                              AS SumCompl,
	|	DD.PermanentDifference                          AS PermanentDifference,
	|	DD.CostTD                           AS CostTD,
	|	DD.CostOfPersonalIncomeTax                               AS AITAmount,
	|	DD.Cost                                  AS SumMan,
	// Attributes
	|	DD.BusinessOperation                       AS BusinessOperation,
	|	UNDEFINED                                   AS ItemsLocationAttributes,
	|	UNDEFINED                                   AS DocumentRegisterRecords,
	|	DD.BusinessTransactionSetting              AS BusinessTransactionSetting,
	|	DD.FinRecordID                      AS FinRecordID
	|FROM
	|	RegisteredRecordsOfTTWIPLaborCostsOfWorkInProgress AS DD
	|	
	|	INNER JOIN Catalog.ProductionLots AS ProductionLots
	|	ON ProductionLots.Ref = DD.ProductionLot
	|;";
	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

#EndRegion

// Step 3.4
// Creates a temporary table Vnezavisimosti
//
Procedure AllocateOtherWorkInProgressExpenses(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AllocateOtherWorkInProgressExpenses");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	If CalculationParameters.PreliminaryCalculation Then
		
		Query.Text =
			"SELECT TOP 0
			|	VALUE(Catalog.Companies.EmptyRef)				AS Organization,
			|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS AccountingSection,
			|	VALUE(Catalog.ProductionLots.EmptyRef)		AS Lot,
			|	VALUE(Enum.VATTaxationTypes.EmptyRef)	AS VATActivityType,
			|	UNDEFINED												AS LotVendorAttributes,
			|	0															AS RowCodeProducts,
			|	VALUE(Catalog.LinesOfBusiness.EmptyRef)	AS LineOfBusiness,
			|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
			|	UNDEFINED												AS DimensionOfExpenses,
			|	VALUE(Catalog.BusinessStructure.EmptyRef)		AS Department,
			|	VALUE(Catalog.ProductCostElements.EmptyRef)			AS ProductCostElement,
			|	VALUE(Catalog.ProductionStages.EmptyRef)			AS Stage,
			|	VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef) AS ProductsGroup,
			|	VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef) AS RuleOfCostAllocatingToProductionLots,
			
			|	0 AS Count,
			|	0 AS QuantityWithoutVAT,
			|	0 AS NumberOfLocal,
			|	0 AS NumberOfTA,
			|	0 AS NumberOfMen,
			
			|	0 AS Sum,
			|	0 AS AmountExcludingVAT,
			|	0 AS SumMan,
			|	0 AS SumCompl,
			|	0 AS AmountFA,
			|	0 AS PermanentDifference,
			|	0 AS CostTD,
			|	0 AS CostOfPersonalIncomeTax
			|
			|INTO TTWorkInProgress
			|;
			|
			|SELECT TOP 0
			|	VALUE(Catalog.Companies.EmptyRef)				AS Organization,
			|	VALUE(Catalog.LinesOfBusiness.EmptyRef)	AS LineOfBusiness,
			|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
			|	UNDEFINED												AS DimensionOfExpenses,
			|	VALUE(Catalog.BusinessStructure.EmptyRef)		AS Department,
			|	0 AS SumCompl,
			|	0 AS SumMan,
			|	0 AS CostOfPersonalIncomeTax
			|INTO ExpenditureItemsCoveredByReserves";
		
		Query.Execute();
		
		Return;
		
	EndIf;
	
	
	Query.Text = TextTTWorkInProgress(CalculationParameters);
	Query.Text = SetBitDepthOfNumbersInRequestText(CalculationParameters, Query.Text);
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTWorkInProgress");
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
		"AllocationBaseForIndirectExpensesAllocation, OtherWorkInProgressExpensesBalance, 
		|ExpenditureItemsCoveredByReservesPreliminary, ExpenseAmounts, TTWorkInProgressBalances, TTDistributionPerBatch");
	
EndProcedure

Function TextTTWorkInProgress(CalculationParameters = Undefined) Export
	
	QueriesTexts = New Array;
	
	#Region OtherWorkInProgressExpensesBalance
	QueryTextTTDistributionPerBatch = "
	|SELECT
	|	DD.Organization                                   AS Organization,
	|	DD.ProductionLot                            AS ProductionLot,
	|	DD.ProductionOrder                           AS ProductionOrder,
	|	DD.RowCodeProducts                            AS RowCodeProducts,
	|	DD.LineOfBusiness                       AS LineOfBusiness,
	|	DD.Department                                 AS Department,
	|	DD.ExpenseItem                                AS ExpenseItem,
	|	DD.DimensionOfExpenses                             AS DimensionOfExpenses,
	|	DD.ProductCostElement                             AS ProductCostElement,
	|	DD.Stage                                			 AS Stage,
	|	DD.ProductsGroup                               AS ProductsGroup,
	|	DD.RuleOfCostAllocatingToProductionLots                      AS RuleOfCostAllocatingToProductionLots,
	|	SUM(DD.CostBalance)                       AS CostBalance,
	|	SUM(DD.CostExcludingVATBalance)                 AS CostExcludingVATBalance,
	|	SUM(DD.CostManBalance)                    AS CostManBalance,
	|	SUM(DD.LocalCostBalance)                   AS LocalCostBalance,
	|	SUM(DD.PermanentDifferenceBalance)               AS PermanentDifferenceBalance,
	|	SUM(DD.CostTDBalance)                AS CostTDBalance,
	|	SUM(DD.CostShareBalance)                   AS CostShareBalance,
	|	SUM(DD.CostOfPersonalIncomeTaxBalance)					 AS CostOfPersonalIncomeTaxBalance
	|INTO OtherWorkInProgressExpensesBalance
	|FROM (
	|	SELECT
	|		DD.Organization                                   AS Organization,
	|		DD.ProductionLot                            AS ProductionLot,
	|		DD.ProductionOrder                           AS ProductionOrder,
	|		DD.RowCodeProducts                            AS RowCodeProducts,
	|		DD.LineOfBusiness                       AS LineOfBusiness,
	|		DD.Department                                 AS Department,
	|		DD.ExpenseItem                                AS ExpenseItem,
	|		DD.DimensionOfExpenses                             AS DimensionOfExpenses,
	|		DD.ProductCostElement                             AS ProductCostElement,
	|		DD.Stage                                			 AS Stage,
	|		DD.ProductsGroup                               AS ProductsGroup,
	|		DD.RuleOfCostAllocatingToProductionLots                      AS RuleOfCostAllocatingToProductionLots,
	|		DD.CostBalance                              AS CostBalance,
	|		DD.CostExcludingVATBalance                        AS CostExcludingVATBalance,
	|		DD.CostManBalance                           AS CostManBalance,
	|		DD.LocalCostBalance                          AS LocalCostBalance,
	|		DD.PermanentDifferenceBalance                      AS PermanentDifferenceBalance,
	|		DD.CostTDBalance                       AS CostTDBalance,
	|		DD.CostShareBalance                          AS CostShareBalance,
	|		DD.CostOfPersonalIncomeTaxBalance							 AS CostOfPersonalIncomeTaxBalance
	|	FROM
	|		AccumulationRegister.OtherWorkInProgressExpenses.Balance(&BeginOfPeriod,
	|			Organization IN (&CompanyArray) AND &BatchAccountingVersion22) AS DD
	|
	|	UNION ALL
	|
	|	SELECT
	|		DD.Organization                                   AS Organization,
	|		DD.ProductionLot                            AS ProductionLot,
	|		DD.ProductionOrder                           AS ProductionOrder,
	|		DD.RowCodeProducts                            AS RowCodeProducts,
	|		DD.LineOfBusiness                       AS LineOfBusiness,
	|		DD.Department                                 AS Department,
	|		DD.ExpenseItem                                AS ExpenseItem,
	|		DD.DimensionOfExpenses                             AS DimensionOfExpenses,
	|		DD.ProductCostElement                             AS ProductCostElement,
	|		DD.Stage                                			 AS Stage,
	|		DD.ProductsGroup                               AS ProductsGroup,
	|		DD.RuleOfCostAllocatingToProductionLots                      AS RuleOfCostAllocatingToProductionLots,
	|		DD.Cost                                     AS CostBalance,
	|		DD.CostExcludingVAT                               AS CostExcludingVATBalance,
	|		DD.CostMan                                  AS CostManBalance,
	|		DD.LocalCost                                 AS LocalCostBalance,
	|		DD.PermanentDifference                             AS PermanentDifferenceBalance,
	|		DD.CostTD                              AS CostTDBalance,
	|		DD.CostShare                                 AS CostShareBalance,
	|		DD.CostOfPersonalIncomeTax									 AS CostOfPersonalIncomeTaxBalance
	|	FROM
	|		TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS DD
	|		INNER JOIN Document.WIPOpeningBalancesByProductionLots AS InitialResiduals
	|			ON InitialResiduals.Ref = DD.Recorder
	|
	|	UNION ALL
	|
	// Data on the storno distribution of other expenses of Unfinished production.
	|	SELECT
	|		DD.Organization                                   AS Organization,
	|		DD.ProductionLot                            AS ProductionLot,
	|		DD.ProductionOrder                           AS ProductionOrder,
	|		DD.RowCodeProducts                            AS RowCodeProducts,
	|		DD.LineOfBusiness                       AS LineOfBusiness,
	|		DD.Department                                 AS Department,
	|		DD.ExpenseItem                                AS ExpenseItem,
	|		DD.DimensionOfExpenses                             AS DimensionOfExpenses,
	|		DD.ProductCostElement                             AS ProductCostElement,
	|		DD.Stage                                          AS Stage,
	|		DD.ProductsGroup                               AS ProductsGroup,
	|		DD.RuleOfCostAllocatingToProductionLots                      AS RuleOfCostAllocatingToProductionLots,
	// Storno is performed by negative consumption, so we change the sign.
	|		-DD.Cost                                    AS CostBalance,
	|		-DD.CostExcludingVAT                              AS CostExcludingVATBalance,
	|		-DD.CostMan                                 AS CostManBalance,
	|		-DD.LocalCost                                AS LocalCostBalance,
	|		-DD.PermanentDifference                            AS PermanentDifferenceBalance,
	|		-DD.CostTD                             AS CostTDBalance,
	|		-DD.CostShare                                AS CostShareBalance,
	|		-DD.CostOfPersonalIncomeTax								 AS CostOfPersonalIncomeTaxBalance
	|	FROM
	|		TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS DD
	|	WHERE
	|		DD.ReversingEntry
	|		AND NOT DD.OfficialTypeOfMovementParish
	|		AND &BatchAccountingVersion22
	|		AND &MonthEndClosingMode <> VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|	) AS DD
	|GROUP BY
	|	DD.Organization,
	|	DD.ProductionLot,
	|	DD.ProductionOrder,
	|	DD.RowCodeProducts,
	|	DD.LineOfBusiness,
	|	DD.Department,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.Stage,
	|	DD.ProductCostElement,
	|	DD.ProductsGroup,
	|	DD.RuleOfCostAllocatingToProductionLots
	|
	|INDEX BY
	|	Organization,
	|	ProductionLot,
	|	ProductionOrder,
	|	RowCodeProducts,
	|	LineOfBusiness,
	|	Department,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Stage,
	|	ProductCostElement,
	|	ProductsGroup,
	|	RuleOfCostAllocatingToProductionLots
	|;";
	#EndRegion
	
	#Region TTWorkInProgressBalances
	QueryTextTTDistributionPerBatch = QueryTextTTDistributionPerBatch + "
	|SELECT
	|	DD.Organization                                   AS Organization,
	|	DD.Department                                 AS Department,
	|	DD.LineOfBusiness                       AS LineOfBusiness,
	|	DD.DocumentOfProductionIssue                               AS Lot,
	|	DD.ReleaseLotDimension                        AS LotVendorAttributes,
	|	DD.RowCodeProducts                            AS RowCodeProducts,
	|	DD.ExpenseItem                                AS ExpenseItem,
	|	DD.DimensionOfExpenses                             AS DimensionOfExpenses,
	|	DD.ProductCostElement                             AS ProductCostElement,
	|	DD.Stage                                			 AS Stage,
	|	DD.ProductsGroup                               AS ProductsGroup,
	|	DD.RuleOfCostAllocatingToProductionLots                      AS RuleOfCostAllocatingToProductionLots,
	|	ISNULL(RemnantsOfUnfinishedProduction.CostBalance, 0)            AS Cost,
	|	ISNULL(RemnantsOfUnfinishedProduction.CostExcludingVATBalance, 0)      AS CostExcludingVAT,
	|	ISNULL(RemnantsOfUnfinishedProduction.CostManBalance, 0)         AS CostMan,
	|	ISNULL(RemnantsOfUnfinishedProduction.LocalCostBalance, 0)        AS LocalCost,
	|	ISNULL(RemnantsOfUnfinishedProduction.PermanentDifferenceBalance, 0)    AS PermanentDifference,
	|	ISNULL(RemnantsOfUnfinishedProduction.CostTDBalance, 0)     AS CostTD,
	|	ISNULL(RemnantsOfUnfinishedProduction.CostShareBalance, 0)        AS CostShare,
	|	CAST((ISNULL(Material_.Balance, 0) + ISNULL(LaborCosts.Balance, 0) + ISNULL(ManufacturedProduct.Balance, 0) + ISNULL(ManufacturedProduct21.Balance, 0)) / ISNULL(Coefficients.ZoomRatio, 1) AS NUMBER (23, 10)) AS IndicatorOfAllocationToIssue,
	|	CAST((ISNULL(Material_.BalanceWithoutVAT, 0) + ISNULL(LaborCosts.BalanceWithoutVAT, 0) + ISNULL(ManufacturedProduct.BalanceWithoutVAT, 0) + ISNULL(ManufacturedProduct21.BalanceWithoutVAT, 0)) / ISNULL(Coefficients.CoefficientWithoutVAT, 1) AS NUMBER (23, 10)) AS IndicatorOfAttributionToOutputWithoutVAT,
	|	CAST((ISNULL(Material_.RemainderOfLocal, 0) + ISNULL(LaborCosts.RemainderOfLocal, 0) + ISNULL(ManufacturedProduct.RemainderOfLocal, 0) + ISNULL(ManufacturedProduct21.RemainderOfLocal, 0)) / ISNULL(Coefficients.LocalCoefficient, 1) AS NUMBER (23, 10)) AS LocalIssueAttributionRate,
	|	CAST((ISNULL(Material_.BalanceMan, 0) + ISNULL(LaborCosts.BalanceMan, 0) + ISNULL(ManufacturedProduct.BalanceMan, 0) + ISNULL(ManufacturedProduct21.BalanceMan, 0)) / ISNULL(Coefficients.ManSCoefficient, 1) AS NUMBER (23, 10)) AS IndicatorOfAssignmentToIssueOfMan,
	|	ISNULL(RemnantsOfUnfinishedProduction.CostOfPersonalIncomeTaxBalance, 0) AS CostOfPersonalIncomeTax
	|INTO TTWorkInProgressBalances
	|FROM
	|	LotsForAttributingExpenses AS DD
	|	LEFT JOIN OtherWorkInProgressExpensesBalance AS RemnantsOfUnfinishedProduction
	|		ON DD.Organization = RemnantsOfUnfinishedProduction.Organization
	|		AND DD.Department = RemnantsOfUnfinishedProduction.Department
	|		AND DD.ProductionLot = RemnantsOfUnfinishedProduction.ProductionLot
	|		AND DD.ProductionOrder = RemnantsOfUnfinishedProduction.ProductionOrder
	|		AND DD.RowCodeProducts = RemnantsOfUnfinishedProduction.RowCodeProducts
	|		AND DD.LineOfBusiness = RemnantsOfUnfinishedProduction.LineOfBusiness
	|		AND DD.ProductCostElement = RemnantsOfUnfinishedProduction.ProductCostElement
	|		AND DD.ExpenseItem = RemnantsOfUnfinishedProduction.ExpenseItem
	|		AND DD.DimensionOfExpenses = RemnantsOfUnfinishedProduction.DimensionOfExpenses
	|		AND DD.Stage = RemnantsOfUnfinishedProduction.Stage
	|		AND DD.ProductsGroup = RemnantsOfUnfinishedProduction.ProductsGroup
	|		AND DD.RuleOfCostAllocatingToProductionLots = RemnantsOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots
	|	LEFT JOIN RemnantsOfDistributionBases AS Material_
	|		ON DD.Organization = Material_.Organization
	|			AND DD.Department = Material_.Department
	|			AND DD.ProductionLot = Material_.ProductionLot
	|			AND DD.ProductionOrder = Material_.ProductionOrder
	|			AND DD.RowCodeProducts = Material_.RowCodeProducts
	|			AND (CASE
	|				WHEN DD.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialCosts)
	|						OR DD.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialAndLaborCosts)
	|					THEN Material_.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialCosts)
	|				ELSE FALSE
	|			END)
	|	LEFT JOIN RemnantsOfDistributionBases AS LaborCosts
	|		ON DD.Organization = LaborCosts.Organization
	|			AND DD.Department = LaborCosts.Department
	|			AND DD.ProductionLot = LaborCosts.ProductionLot
	|			AND DD.ProductionOrder = LaborCosts.ProductionOrder
	|			AND DD.RowCodeProducts = LaborCosts.RowCodeProducts
	|			AND (CASE
	|				WHEN DD.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByLaborCosts)
	|						OR DD.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialAndLaborCosts)
	|					THEN LaborCosts.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByLaborCosts)
	|				ELSE FALSE
	|			END)
	|	LEFT JOIN RemnantsOfDistributionBases AS ManufacturedProduct
	|		ON DD.Organization = ManufacturedProduct.Organization
	|			AND ManufacturedProduct.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			AND DD.ProductionLot = ManufacturedProduct.ProductionLot
	|			AND DD.ProductionOrder = ManufacturedProduct.ProductionOrder
	|			AND DD.RowCodeProducts = ManufacturedProduct.RowCodeProducts
	|			AND (CASE
	|				WHEN DD.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByProductsIncludingFutureReleases)
	|					THEN ManufacturedProduct.RuleOfCostAllocatingToProductionLots = DD.RuleOfCostAllocatingToProductionLots
	|				ELSE FALSE
	|			END)
	|	LEFT JOIN RemnantsOfDistributionBases AS ManufacturedProduct21
	|		ON DD.Organization = ManufacturedProduct21.Organization
	|			AND ManufacturedProduct21.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
	|			AND DD.ProductionLot = ManufacturedProduct21.ProductionLot
	|			AND DD.ProductionOrder = ManufacturedProduct21.ProductionOrder
	|			AND DD.RowCodeProducts = ManufacturedProduct21.RowCodeProducts
	|			AND (CASE
	|				WHEN DD.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef)
	|					THEN ManufacturedProduct21.RuleOfCostAllocatingToProductionLots = DD.RuleOfCostAllocatingToProductionLots
	|				ELSE FALSE
	|			END)
	|	LEFT JOIN ReductionCoefficients AS Coefficients
	|		ON Coefficients.Organization = DD.Organization
	|		AND Coefficients.ProductionLot = DD.ProductionLot
	|		AND Coefficients.ProductionOrder = DD.ProductionOrder
	|		AND Coefficients.RuleOfCostAllocatingToProductionLots = DD.RuleOfCostAllocatingToProductionLots
	|WHERE
	|	DD.Organization IN (&CompanyArray)
	|	AND (ISNULL(RemnantsOfUnfinishedProduction.CostBalance,0) <> 0
	|	OR ISNULL(RemnantsOfUnfinishedProduction.CostExcludingVATBalance,0) <> 0
	|	OR ISNULL(RemnantsOfUnfinishedProduction.LocalCostBalance,0) <> 0
	|	OR ISNULL(RemnantsOfUnfinishedProduction.PermanentDifferenceBalance,0) <> 0
	|	OR ISNULL(RemnantsOfUnfinishedProduction.CostTDBalance,0) <> 0
	|	OR ISNULL(RemnantsOfUnfinishedProduction.CostManBalance,0) <> 0
	|	OR ISNULL(RemnantsOfUnfinishedProduction.CostOfPersonalIncomeTaxBalance,0) <> 0
	|	OR (ISNULL(Material_.Balance, 0) + ISNULL(LaborCosts.Balance, 0) + ISNULL(ManufacturedProduct.Balance, 0)) <> 0)
	|;";
	#EndRegion
	
	#Region ProvisionsForExpenses
	QueryTextTTDistributionPerBatch = QueryTextTTDistributionPerBatch + "
	|SELECT
	|	DD.Organization,
	|	DD.LineOfBusiness,
	|	DD.ReserveKind,
	|	DD.ProvisionObject,
	|	ExpenseAmounts.ExpenseItem,
	|	ExpenseAmounts.DimensionOfExpenses,
	|	ExpenseAmounts.Department,
	|	MAX(-DD.SumCompl) AS ReserveLocal,
	|	MAX(-DD.AmountFA) AS TAReserve,
	|	MAX(-DD.SumMan) AS ReserveMan
	|INTO ProvisionsForExpenses
	|FROM
	|	TTCashSettlementBalancesProvisionsForFutureExpenses AS DD
	|	INNER JOIN Catalog.AccountingObjectsOfFutureExpenseCommitments.UseReserve AS ARTICLES__
	|		ON DD.ProvisionObject = ARTICLES__.Ref
	|	INNER JOIN ExpenseAmounts AS ExpenseAmounts
	|		ON DD.Organization = ExpenseAmounts.Organization
	|		AND DD.LineOfBusiness = ExpenseAmounts.LineOfBusiness
	|		AND ARTICLES__.ExpenseItem = ExpenseAmounts.ExpenseItem
	|		AND (ARTICLES__.DimensionOfExpenses = ExpenseAmounts.DimensionOfExpenses OR ARTICLES__.AnyExpenseDimension)
	|WHERE
	|	&BatchAccountingVersion22
	|	AND (ExpenseAmounts.SumMan >= 0 OR ExpenseAmounts.SumCompl >= 0)
	|
	|GROUP BY
	|	DD.Organization,
	|	DD.LineOfBusiness,
	|	DD.ReserveKind,
	|	DD.ProvisionObject,
	|	ExpenseAmounts.ExpenseItem,
	|	ExpenseAmounts.DimensionOfExpenses,
	|	ExpenseAmounts.Department
	|;";
	#EndRegion
	
	#Region ExpenditureItemsCoveredByReserves
	QueryTextTTDistributionPerBatch = QueryTextTTDistributionPerBatch + "
	|SELECT DISTINCT
	|	DD.Organization,
	|	DD.LineOfBusiness,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.Department
	|INTO ExpenditureItemsCoveredByReservesPreliminary
	|FROM
	|	ProvisionsForExpenses AS DD
	|;
	|
	|////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RECORDAUTONUMBER() AS NodeNumber,
	|	DD.Organization,
	|	DD.LineOfBusiness,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.Department,
	|	ISNULL(ExpenseAmounts.SumCompl, 0) AS SumCompl,
	|	ISNULL(ExpenseAmounts.SumCompl, 0)
	|		- ISNULL(ExpenseAmounts.PermanentDifference, 0)
	|		- ISNULL(ExpenseAmounts.CostTD, 0) AS AmountFA,
	|	ISNULL(ExpenseAmounts.PermanentDifference, 0) AS PermanentDifference,
	|	ISNULL(ExpenseAmounts.CostTD, 0) AS CostTD,
	|	ISNULL(ExpenseAmounts.SumMan, 0) AS SumMan,
	|	ISNULL(ExpenseAmounts.AITAmount, 0) AS CostOfPersonalIncomeTax
	|INTO ExpenditureItemsCoveredByReserves
	|FROM
	|	ExpenditureItemsCoveredByReservesPreliminary AS DD
	|		LEFT JOIN ExpenseAmounts AS ExpenseAmounts
	|		ON DD.Organization = ExpenseAmounts.Organization
	|			AND DD.Department = ExpenseAmounts.Department
	|			AND DD.LineOfBusiness = ExpenseAmounts.LineOfBusiness
	|			AND DD.ExpenseItem = ExpenseAmounts.ExpenseItem
	|			AND DD.DimensionOfExpenses = ExpenseAmounts.DimensionOfExpenses
	|;";
	#EndRegion
	
	#Region ReserveMovementDocuments
	QueryTextTTDistributionPerBatch = QueryTextTTDistributionPerBatch + "
	|SELECT
	|	ReserveBalances.Organization AS Organization,
	|	ReserveBalances.ReserveKind AS ReserveKind,
	|	MAX(Attributes.Ref)	AS DocumentRegisterRecords
	|INTO ReserveMovementDocuments
	|FROM
	|	TTCashSettlementBalancesProvisionsForFutureExpenses AS ReserveBalances
	|		INNER JOIN Document.FutureExpenseCommitmentsAccrualWriteOff AS Attributes
	|		ON ReserveBalances.Organization = Attributes.Organization
	|			AND ReserveBalances.ReserveKind = Attributes.ReserveKind
	|WHERE
	|	Attributes.Posted
	|	AND Attributes.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|
	|GROUP BY
	|	ReserveBalances.Organization,
	|	ReserveBalances.ReserveKind		
	|;";
	#EndRegion
	
	#Region TTDistributionPerBatch
	QueryTextTTDistributionPerBatch = QueryTextTTDistributionPerBatch + "
	|SELECT
	|	Expenses.Organization				AS Organization,
	|	Expenses.ExpenseItem			AS ExpenseItem,
	|	Expenses.DimensionOfExpenses		AS DimensionOfExpenses,
	|	Expenses.LineOfBusiness	AS LineOfBusiness,
	|	Expenses.Department			AS Department,
	|	SUM(Expenses.Count)		AS Count,
	|	SUM(Expenses.QuantityWithoutVAT)	AS QuantityWithoutVAT,
	|	SUM(Expenses.NumberOfLocal)	AS NumberOfLocal,
	|	SUM(Expenses.NumberOfMen)	AS NumberOfMen,
	|	SUM(Expenses.NumberOfPersonalData)	AS NumberOfPersonalData,
	|	SUM(Expenses.NumberOfTA)		AS NumberOfTA
	|INTO TTDistributionPerBatch
	|FROM (
	// distribution into stages at PU21
	|	SELECT
	|		Expenses.Organization					AS Organization,
	|		Operation.ExpenseItem				AS ExpenseItem,
	|		Operation.DimensionOfExpenses			AS DimensionOfExpenses,
	|		Operation.Department				AS Department,
	|		Operation.LineOfBusiness	AS LineOfBusiness,
	|		Expenses.CostShare				AS Count,
	|		Expenses.CostShare				AS QuantityWithoutVAT,
	|		Expenses.CostShare				AS NumberOfLocal,
	|		Expenses.CostShare				AS NumberOfMen,
	|		Expenses.CostShare				AS NumberOfPersonalData,
	|		Expenses.CostShare				AS NumberOfTA
	|	FROM
	|		TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS Expenses
	|		INNER JOIN Document.AllocationOfOtherCosts AS Operation
	|			ON Operation.Ref = Expenses.Recorder
	|	WHERE
	|		Expenses.OfficialTypeOfMovementParish
	|		AND NOT &BatchAccountingVersion22
	|
	|	UNION ALL
	|
	// distribution to other articles at PU21
	|	SELECT
	|		Operation.Organization,
	|		Operation.ExpenseItem,
	|		Operation.DimensionOfExpenses,
	|		Operation.Department,
	|		Operation.LineOfBusiness,
	|		Rows.CostShare,
	|		Rows.CostShare,
	|		Rows.CostShare,
	|		Rows.CostShare,
	|		Rows.CostShare,
	|		Rows.CostShare
	|	FROM
	|		Document.AllocationOfOtherCosts AS Operation
	|		INNER JOIN Document.AllocationOfOtherCosts.WriteOff AS Rows
	|			ON Rows.Ref = Operation.Ref
	|	WHERE
	|		Operation.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND Operation.Organization IN(&CompanyArray)
	|		AND Operation.Posted
	|		AND NOT &BatchAccountingVersion22
	|
	|	UNION ALL
	|
	// distribution for PU 2.2
	|	SELECT
	|		DD.Organization,
	|		DD.ExpenseItem,
	|		DD.DimensionOfExpenses,
	|		DD.Department,
	|		DD.LineOfBusiness,
	|		DD.CostShare,
	|		DD.ShareOfValueWithoutVAT,
	|		DD.ShareOfLocalValue,
	|		DD.ShareOfManSCost,
	|		DD.ShareOfCostOfPersonalIncomeTax,
	|		DD.ShareValueTa
	|	FROM
	|		SharesOfProductionCosts AS DD
	|	WHERE
	|		DD.Organization IN(&CompanyArray)
	|		AND &BatchAccountingVersion22
	|		AND NOT (DD.CostShare = 0
	|			AND DD.ShareOfValueWithoutVAT = 0
	|			AND DD.ShareOfLocalValue = 0
	|			AND DD.ShareOfManSCost = 0
	|			AND DD.ShareOfCostOfPersonalIncomeTax = 0
	|			AND DD.ShareValueTa = 0)
	|
	|	UNION ALL
	|
	// allocation for production cost expenses
	|	SELECT
	|		DD.Organization,
	|		DD.ExpenseItem,
	|		DD.DimensionOfExpenses,
	|		DD.Department,
	|		DD.LineOfBusiness,
	|		DD.CostShare,
	|		DD.ShareOfValueWithoutVAT,
	|		DD.ShareOfLocalValue,
	|		DD.ShareOfManSCost,
	|		DD.ShareOfCostOfPersonalIncomeTax,
	|		DD.ShareValueTa
	|	FROM
	|		DirectProductionCosts AS DD
	|	WHERE
	|		DD.Organization IN(&CompanyArray)
	|	) AS Expenses
	|
	|GROUP BY
	|	Expenses.Organization,
	|	Expenses.ExpenseItem,
	|	Expenses.DimensionOfExpenses,
	|	Expenses.Department,
	|	Expenses.LineOfBusiness
	|";
	#EndRegion
	
	QueryTextOfSettingsOfArticlesAndCostCentersByAIT = CalculationOfCostLocalization.AITSettingsQueryText("TTDistributionPerBatch", "CostCalculationCostAdjustment_TextTTWorkInProgress", CalculationParameters);
	
	QueryTextTTWorkInProgress = "";
	
	#Region TTWorkInProgress
	QueryTextTTWorkInProgress = QueryTextTTWorkInProgress + "
	// The distribution of the party
	|SELECT TOP 9999999999999
	|	RECORDAUTONUMBER() AS NodeNumber,
	|	Expenses.Organization,
	|	Expenses.AccountingSection,
	|	Expenses.Lot,
	|	Expenses.VATActivityType,
	|	Expenses.LotVendorAttributes,
	|	Expenses.RowCodeProducts,
	|	Expenses.LineOfBusiness,
	|	Expenses.ExpenseItem,
	|	Expenses.DimensionOfExpenses,
	|	Expenses.Department,
	|	Expenses.ProductCostElement,
	|	Expenses.Stage,
	|	Expenses.ProductsGroup,
	|	Expenses.RuleOfCostAllocatingToProductionLots,
	|	Expenses.Count,
	|	Expenses.QuantityWithoutVAT,
	|	Expenses.NumberOfLocal,
	|	Expenses.NumberOfTA,
	|	Expenses.NumberOfPersonalData,
	|	Expenses.NumberOfMen,
	
	|	Expenses.Sum,
	|	Expenses.AmountExcludingVAT,
	|	Expenses.SumMan,
	|	Expenses.SumCompl,
	|	Expenses.AmountFA,
	|	Expenses.PermanentDifference,
	|	Expenses.CostTD,
	|	Expenses.CostOfPersonalIncomeTax
	|
	|INTO TTWorkInProgress
	|FROM (
	|
	|SELECT
	|	Expenses.Organization                                        AS Organization,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts) AS AccountingSection,
	|	VALUE(Catalog.ProductionLots.EmptyRef)	   AS Lot,
	|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATActivityType,
	|	UNDEFINED                                               AS LotVendorAttributes,
	|	0													       AS RowCodeProducts,
	|	Expenses.LineOfBusiness                            AS LineOfBusiness,
	|	Expenses.ExpenseItem                                     AS ExpenseItem,
	|	Expenses.DimensionOfExpenses                                  AS DimensionOfExpenses,
	|	Expenses.Department                                      AS Department,
	|	VALUE(Catalog.ProductCostElements.EmptyRef)        AS ProductCostElement,
	|	VALUE(Catalog.ProductionStages.EmptyRef)        AS Stage,
	|	VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef) AS ProductsGroup,
	|	VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef) AS RuleOfCostAllocatingToProductionLots,
	|	Expenses.Count                                  		AS Count,
	|	Expenses.QuantityWithoutVAT                            		AS QuantityWithoutVAT,
	|	Expenses.NumberOfLocal                              		AS NumberOfLocal,
	|	Expenses.NumberOfTA                              			AS NumberOfTA,
	|	Expenses.NumberOfPersonalData                              			AS NumberOfPersonalData,
	|	Expenses.NumberOfMen                               		AS NumberOfMen,
	|	ISNULL(ManSExpenses_.Sum, 0)              			AS Sum,
	|	ISNULL(ManSExpenses_.AmountExcludingVAT, 0)        			AS AmountExcludingVAT,
	|	ISNULL(ManSExpenses_.SumMan, 0)           			AS SumMan,
	|	ISNULL(LocalExpenditureAmounts.SumCompl, 0)         			AS SumCompl,
	|	ISNULL(AmountOfExpensesTA.AmountFA, 0)						AS AmountFA,
	|	ISNULL(LocalExpenditureAmounts.PermanentDifference, 0)			AS PermanentDifference,
	|	ISNULL(LocalExpenditureAmounts.SumCompl, 0) - ISNULL(LocalExpenditureAmounts.PermanentDifference, 0)
	|	+ ISNULL(AmountOfExpensesTA.PermanentDifference, 0) + ISNULL(AmountOfExpensesTA.CostTD, 0) 
	|		- ISNULL(AmountOfExpensesTA.SumCompl, 0)				AS CostTD,
	|	ISNULL(AITExpenses.AITAmount, 0)						AS CostOfPersonalIncomeTax
	|FROM
	|	TTDistributionPerBatch AS Expenses
	|	INNER JOIN ChartOfCharacteristicTypes.ExpenseItems AS ARTICLES__
	|		ON ARTICLES__.Ref = Expenses.ExpenseItem
	|
	|	LEFT JOIN TTOvz AS TTOvz
	|		ON Expenses.DimensionOfExpenses = TTOvz.ConstCenter
	|
	|	LEFT JOIN AITArticleDistributionSettings AS AITArticleDistributionSettings
	|	ON Expenses.Organization = AITArticleDistributionSettings.Organization
	|		AND Expenses.ExpenseItem = AITArticleDistributionSettings.ExpenseItem
	|		AND &Expenses_ObjectOfSeparateAccountingAIT = AITArticleDistributionSettings.ObjectOfSeparateAccountingAIT
	|
	|	LEFT JOIN SettingsForDistributionOfAITArticlesByCostCenter AS SettingsForDistributionOfAITArticlesByCostCenter
	|	ON Expenses.DimensionOfExpenses = SettingsForDistributionOfAITArticlesByCostCenter.ConstCenter
	|
	|	LEFT JOIN ExpenseAmounts AS ManSExpenses_
	|		ON ManSExpenses_.Organization = Expenses.Organization
	|		AND ManSExpenses_.ExpenseItem = Expenses.ExpenseItem
	|		AND ManSExpenses_.DimensionOfExpenses = Expenses.DimensionOfExpenses
	|		AND ManSExpenses_.Department = Expenses.Department
	|		AND ManSExpenses_.LineOfBusiness = Expenses.LineOfBusiness
	|		AND ISNULL(TTOvz.CostAllocationOptionManag, ARTICLES__.CostAllocationOptionManag) IN (
	|			VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness), // to calculate reserves 
	|			VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly), // to calculate reserves
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|		)
	|
	|	LEFT JOIN ExpenseAmounts AS LocalExpenditureAmounts
	|		ON LocalExpenditureAmounts.Organization = Expenses.Organization
	|		AND LocalExpenditureAmounts.ExpenseItem = Expenses.ExpenseItem
	|		AND LocalExpenditureAmounts.DimensionOfExpenses = Expenses.DimensionOfExpenses
	|		AND LocalExpenditureAmounts.Department = Expenses.Department
	|		AND LocalExpenditureAmounts.LineOfBusiness = Expenses.LineOfBusiness
	|		AND ISNULL(TTOvz.CostAllocationOptionLocal, ARTICLES__.CostAllocationOptionLocal) IN (
	|			VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness), // to calculate reserves
	|			VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly), // to calculate reserves 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|		)
	|
	|	LEFT JOIN ExpenseAmounts AS AmountOfExpensesTA
	|		ON AmountOfExpensesTA.Organization = Expenses.Organization
	|		AND AmountOfExpensesTA.ExpenseItem = Expenses.ExpenseItem
	|		AND AmountOfExpensesTA.DimensionOfExpenses = Expenses.DimensionOfExpenses
	|		AND AmountOfExpensesTA.Department = Expenses.Department
	|		AND AmountOfExpensesTA.LineOfBusiness = Expenses.LineOfBusiness
	|		AND ISNULL(TTOvz.CostAllocationOptionTax, ARTICLES__.CostAllocationOptionTax) IN (
	|			VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness), // to calculate reserves
	|			VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly), // to calculate reserves 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|		)
	|
	|	LEFT JOIN ExpenseAmounts AS AITExpenses
	|		ON AITExpenses.Organization = Expenses.Organization
	|		AND AITExpenses.ExpenseItem = Expenses.ExpenseItem
	|		AND AITExpenses.DimensionOfExpenses = Expenses.DimensionOfExpenses
	|		AND AITExpenses.Department = Expenses.Department
	|		AND AITExpenses.LineOfBusiness = Expenses.LineOfBusiness
	|		AND ISNULL(SettingsForDistributionOfAITArticlesByCostCenter.AITCostAllocationOption, 
	|			ISNULL(AITArticleDistributionSettings.AITCostAllocationOption,
	|				VALUE(Enum.CostAllocationOptions.EmptyRef))) IN (
	|					VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|					VALUE(Enum.CostAllocationOptions.ToProductionCostDirect))
	|
	|WHERE
	|	ISNULL(TTOvz.CostAllocationOptionManag, ARTICLES__.CostAllocationOptionManag) IN (
	|			VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness), // to calculate reserves
	|			VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly), // to calculate reserves 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|		)
	|	OR ISNULL(TTOvz.CostAllocationOptionLocal, ARTICLES__.CostAllocationOptionLocal) IN (
	|			VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness), // to calculate reserves
	|			VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly), // to calculate reserves 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|		)
	|	OR ISNULL(TTOvz.CostAllocationOptionTax, ARTICLES__.CostAllocationOptionTax) IN (
	|			VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness), // to calculate reserves
	|			VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly), // to calculate reserves 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|			VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|		)
	|	OR ISNULL(SettingsForDistributionOfAITArticlesByCostCenter.AITCostAllocationOption, 
	|				ISNULL(AITArticleDistributionSettings.AITCostAllocationOption,
	|					VALUE(Enum.CostAllocationOptions.EmptyRef))) IN (
	|						VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|						VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|					)
	|
	|UNION ALL
	|
	// product distribution
	|SELECT
	|	DD.Organization                                       AS Organization,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress) AS AccountingSection,
	|	DD.Lot                                            AS Lot,
	|	DD.VATActivityType								 AS VATActivityType,
	|	DD.LotVendorAttributes                              AS LotVendorAttributes,
	|	DD.RowCodeProducts								 AS RowCodeProducts,
	|	DD.LineOfBusiness							 AS LineOfBusiness,
	|	DD.ExpenseItem                                    AS ExpenseItem,
	|	DD.DimensionOfExpenses                                 AS DimensionOfExpenses,
	|	DD.Department                                     AS Department,
	|	DD.ProductCostElement                                 AS ProductCostElement,
	|	DD.Stage												 AS Stage,
	|	DD.ProductsGroup                                   AS ProductsGroup,
	|	DD.RuleOfCostAllocatingToProductionLots                          AS RuleOfCostAllocatingToProductionLots,
	|	SUM(DD.IndicatorOfAllocationToIssue)                AS Count,
	|	SUM(DD.IndicatorOfAttributionToOutputWithoutVAT)          AS QuantityWithoutVAT,
	|	SUM(DD.LocalIssueAttributionRate)            AS NumberOfLocal,
	|	SUM(DD.IndicatorOfAttributionToIssueIsTA)              AS NumberOfTA,
	|	SUM(DD.IndicatorOfAttributionToIssueOfPersonalIncomeTax)             AS NumberOfPersonalData,
	|	SUM(DD.IndicatorOfAssignmentToIssueOfMan)             AS NumberOfMen,
	|	SUM(DD.Sum)                                      AS Sum,
	|	SUM(DD.AmountExcludingVAT)                                AS AmountExcludingVAT,
	|	SUM(DD.SumMan)                                   AS SumMan,
	|	SUM(DD.SumCompl)                                  AS SumCompl,
	|	SUM(DD.SumCompl
	|	 - DD.PermanentDifference - DD.CostTD)       AS AmountFA,
	|	SUM(DD.PermanentDifference)                          AS PermanentDifference,
	|	SUM(DD.CostTD)                           AS CostTD,
	|	SUM(DD.CostOfPersonalIncomeTax)								 AS CostOfPersonalIncomeTax
	|FROM (
	|	SELECT
	|		DD.Organization                           AS Organization,
	|		DD.DocumentOfProductionIssue                       AS Lot,
	|		DD.VATActivityType					 AS VATActivityType,
	|		DD.ReleaseLotDimension      			 AS LotVendorAttributes,
	|		DD.RowCodeProducts      				 AS RowCodeProducts,
	|		DD.ExpenseItem                        AS ExpenseItem,
	|		DD.DimensionOfExpenses                     AS DimensionOfExpenses,
	|		DD.Department                         AS Department,
	|		DD.LineOfBusiness               AS LineOfBusiness,
	|		DD.ProductCostElement                     AS ProductCostElement,
	|		DD.Stage              					 AS Stage,
	|		DD.ProductsGroup                       AS ProductsGroup,
	|		DD.RuleOfCostAllocatingToProductionLots              AS RuleOfCostAllocatingToProductionLots,
	|		DD.IndicatorOfAllocationToIssue			 AS IndicatorOfAllocationToIssue,
	|		DD.IndicatorOfAttributionToOutputWithoutVAT	 AS IndicatorOfAttributionToOutputWithoutVAT,
	|		DD.LocalIssueAttributionRate		 AS LocalIssueAttributionRate,
	|		DD.IndicatorOfAttributionToIssueIsTA		 AS IndicatorOfAttributionToIssueIsTA,
	|		DD.IndicatorOfAttributionToIssueOfPersonalIncomeTax		 AS IndicatorOfAttributionToIssueOfPersonalIncomeTax,
	|		DD.IndicatorOfAssignmentToIssueOfMan		 AS IndicatorOfAssignmentToIssueOfMan,
	|		0                                        AS Sum,
	|		0                                        AS AmountExcludingVAT,
	|		0                                        AS SumMan,
	|		0                                        AS SumCompl,
	|		0                                        AS PermanentDifference,
	|		0                                        AS CostTD,
	|		0										 AS CostOfPersonalIncomeTax
	|	FROM
	|		TTOtherWorkInProgressExpenses__ AS DD
	|	WHERE
	|		DD.Organization IN (&CompanyArray)
	|		AND DD.RecordType = VALUE(AccumulationRecordType.Expense)
	|		AND &BatchAccountingVersion22
	|
	|UNION ALL
	|
	|
	|	SELECT
	|		DD.Organization                           AS Organization,
	|		DD.Lot                                AS Lot,
	|		ISNULL(
	|			CAST(DD.LotVendorAttributes AS Catalog.InventoryLocationAttributeKeys).Purpose.VATActivityType, UNDEFINED) AS VATActivityType,
	|		DD.LotVendorAttributes                  AS LotVendorAttributes,
	|		DD.RowCodeProducts      				 AS RowCodeProducts,
	|		DD.ExpenseItem                        AS ExpenseItem,
	|		DD.DimensionOfExpenses                     AS DimensionOfExpenses,
	|		DD.Department                         AS Department,
	|		DD.LineOfBusiness               AS LineOfBusiness,
	|		DD.ProductCostElement                     AS ProductCostElement,
	|		DD.Stage              					 AS Stage,
	|		DD.ProductsGroup                       AS ProductsGroup,
	|		DD.RuleOfCostAllocatingToProductionLots              AS RuleOfCostAllocatingToProductionLots,
	|		DD.IndicatorOfAllocationToIssue           AS IndicatorOfAllocationToIssue,
	|		DD.IndicatorOfAttributionToOutputWithoutVAT	 AS IndicatorOfAttributionToOutputWithoutVAT,
	|		DD.LocalIssueAttributionRate		 AS LocalIssueAttributionRate,
	|		DD.LocalIssueAttributionRate		 AS IndicatorOfAttributionToIssueIsTA,
	|		DD.LocalIssueAttributionRate		 AS IndicatorOfAttributionToIssueOfPersonalIncomeTax,
	|		DD.IndicatorOfAssignmentToIssueOfMan		 AS IndicatorOfAssignmentToIssueOfMan,
	|		DD.Cost                             AS Sum,
	|		DD.CostExcludingVAT                       AS AmountExcludingVAT,
	|		DD.CostMan                          AS SumMan,
	|		DD.LocalCost                         AS SumCompl,
	|		DD.PermanentDifference                     AS PermanentDifference,
	|		DD.CostTD                      AS CostTD,
	|		DD.CostOfPersonalIncomeTax							 AS CostOfPersonalIncomeTax
	|	FROM
	|		TTWorkInProgressBalances AS DD
	|	WHERE
	|		&BatchAccountingVersion22
	|	) AS DD
	|
	|	GROUP BY
	|		DD.Lot,
	|		DD.VATActivityType,
	|		DD.LotVendorAttributes,
	|		DD.RowCodeProducts,
	|		DD.Organization,
	|		DD.ExpenseItem,
	|		DD.DimensionOfExpenses,
	|		DD.Department,
	|		DD.LineOfBusiness,
	|		DD.ProductCostElement,
	|		DD.Stage,
	|		DD.ProductsGroup,
	|		DD.RuleOfCostAllocatingToProductionLots
	|) AS Expenses
	|
	|ORDER BY
	|	Organization,
	|	LineOfBusiness,
	|	Department,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Lot
	|";
	#EndRegion
	
	QueriesTexts.Add(TextOfAmountOfOtherExpenses(CalculationParameters));
	QueriesTexts.Add(QueryTextTTDistributionPerBatch);
	QueriesTexts.Add(QueryTextOfSettingsOfArticlesAndCostCentersByAIT);
	QueriesTexts.Add(QueryTextTTWorkInProgress);
	
	QueryText = StrConcat(QueriesTexts,
		Common.QueryBatchSeparator());
	
	CalculationOfCostLocalization.SubstituteAITTypeOfSeparateAccountingObjectInRequest(QueryText, "Expenses_ObjectOfSeparateAccountingAIT");
	
	Return QueryText;
		
EndFunction

Function TextOfAmountOfOtherExpenses(CalculationParameters) Export
	
	// If you change the Query Text TT sum of expenses, you also need to fix See CalculationOfCostLocalization.ChangeTextOfAmountOfOtherExpenses
	
	#Region WriteOffForExpensesExceptions
	QueryText = "
	|SELECT DISTINCT
	|	WriteOffsForFixedCostExpenses.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	WriteOffsForFixedCostExpenses.AccountingSection AS AccountingSection,
	|	WriteOffsForFixedCostExpenses.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	WriteOffsForFixedCostExpenses.Organization AS Organization,
	|	WriteOffsForFixedCostExpenses.Lot AS Lot,
	|	WriteOffsForFixedCostExpenses.LotVendorAttributes AS LotVendorAttributes,
	|	WriteOffsForFixedCostExpenses.FinancialAccountingDimension AS FinancialAccountingDimension,
	|	WriteOffsForFixedCostExpenses.VATActivityType AS VATActivityType
	|INTO WriteOffForExpensesExceptions
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS WriteOffsForFixedCostExpenses
	|	INNER JOIN TTCashEstimatedTurnoverCostOfGoods AS WriteOffsForExpensesAtEstimatedCost
	|	ON
	|		WriteOffsForFixedCostExpenses.ItemsLocationAttributes = WriteOffsForExpensesAtEstimatedCost.ItemsLocationAttributes
	|		AND WriteOffsForFixedCostExpenses.AccountingSection = WriteOffsForExpensesAtEstimatedCost.AccountingSection
	|		AND WriteOffsForFixedCostExpenses.InventoryOwnerAttribute = WriteOffsForExpensesAtEstimatedCost.InventoryOwnerAttribute
	|		AND WriteOffsForFixedCostExpenses.Organization = WriteOffsForExpensesAtEstimatedCost.Organization
	|		AND WriteOffsForFixedCostExpenses.Lot = WriteOffsForExpensesAtEstimatedCost.Lot
	|		AND WriteOffsForFixedCostExpenses.LotVendorAttributes = WriteOffsForExpensesAtEstimatedCost.LotVendorAttributes
	|		AND WriteOffsForFixedCostExpenses.FinancialAccountingDimension = WriteOffsForExpensesAtEstimatedCost.FinancialAccountingDimension
	|		AND WriteOffsForFixedCostExpenses.VATActivityType = WriteOffsForExpensesAtEstimatedCost.VATActivityType
	|		AND WriteOffsForFixedCostExpenses.OfficialTypeOfMovementParish = WriteOffsForExpensesAtEstimatedCost.OfficialTypeOfMovementParish
	|		AND WriteOffsForFixedCostExpenses.BusinessOperation = 
	|			VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)
	|		AND WriteOffsForExpensesAtEstimatedCost.BusinessOperation = 
	|			VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost)
	|
	|WHERE
	|	NOT WriteOffsForFixedCostExpenses.OfficialTypeOfMovementParish
	|
	|INDEX BY
	|	ItemsLocationAttributes,
	|	Organization,
	|	Lot
	|;";
	#EndRegion
	
	#Region TTEstimatedTurnoverCostIndexed
	QueryText = QueryText + "
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	|	DD.FinRecordID AS FinRecordID,
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting
	|INTO TTEstimatedTurnoverCostIndexed
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|		INNER JOIN WriteOffForExpensesExceptions AS WriteOffForExpensesExceptions
	|			ON DD.ItemsLocationAttributes = WriteOffForExpensesExceptions.ItemsLocationAttributes
	|			AND DD.AccountingSection = WriteOffForExpensesExceptions.AccountingSection
	|			AND DD.InventoryOwnerAttribute = WriteOffForExpensesExceptions.InventoryOwnerAttribute
	|			AND DD.Organization = WriteOffForExpensesExceptions.Organization
	|			AND DD.Lot = WriteOffForExpensesExceptions.Lot
	|			AND DD.LotVendorAttributes = WriteOffForExpensesExceptions.LotVendorAttributes
	|			AND DD.FinancialAccountingDimension = WriteOffForExpensesExceptions.FinancialAccountingDimension
	|			AND DD.VATActivityType = WriteOffForExpensesExceptions.VATActivityType
	|WHERE
	|	&BatchAccountingVersion22
	|	AND DD.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost)
	|	AND NOT VALUETYPE(DD.Recorder) = TYPE(Document.AllocationOfIncomeByLinesOfBusiness)
	|INDEX BY
	|	Recorder,
	|	FinRecordID,
	|	BusinessTransactionSetting,
	|	Period
	|;";
	#EndRegion
	
	#Region AdditionalExpensesForBatchOfPreviousPeriod
	QueryText = QueryText + "
	|SELECT DISTINCT
	|	DD.Recorder AS Recorder
	|
	|INTO AdditionalExpensesForBatchOfPreviousPeriod
	|FROM
	|	ProductReceivers AS DD
	|WHERE
	|	DD.ThisIsPartyOfPastPeriod
	|INDEX BY
	|	Recorder
	|;";
	#EndRegion
	
	#Region TTEstimatedTurnoverOtherExpensesIndexed
	QueryText = QueryText + "
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	|	DD.FinRecordID AS FinRecordID,
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	DD.Organization,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.Department,
	|	DD.LineOfBusiness,
	|
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END AS Character,
	|	DD.Sum AS Sum,
	|	DD.AmountExcludingVAT AS AmountExcludingVAT,
	|	DD.SumMan AS SumMan,
	|	DD.SumCompl AS SumCompl,
	|	(CASE
	// We exclude the PD amounts generated during the distribution of additional expenses for the disposal of goods in previous periods.
	// The amounts for such expenses will be calculated when solving the case.
	// Connections of additional expenses with production expenses are formed in the function of communication nodes of production expenditures of the past periods()
	|		WHEN NOT Allocation.Recorder IS NULL
	|			THEN 0
	|		ELSE DD.PermanentDifference END) AS PermanentDifference,
	|	DD.CostTD AS CostTD,
	|	(CASE
	// We exclude the amounts of WELL formed during the allocation of additional expenses for the disposal of goods in previous periods.
	// The amounts for such expenses will be calculated when solving the case.
	// The connections of additional expenses with production expenses are formed in the function of the connection of the nodes of production expenses of the past periods()
	|		WHEN NOT Allocation.Recorder IS NULL
	|			THEN 0
	|		ELSE DD.SumCompl
	|		- DD.PermanentDifference
	|		- DD.CostTD END) AS AmountFA,
	|	DD.AITAmount AS AITAmount
	|INTO TTEstimatedTurnoverOtherExpensesIndexed
	|FROM
	|	TTCashEstimatedTurnoverOtherExpenses AS DD
	|	LEFT JOIN CalculatedDocuments AS CalculatedDocuments
	|		ON CalculatedDocuments.Period = DD.Period
	|		AND CalculatedDocuments.Recorder = DD.Recorder
	|		AND &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|	LEFT JOIN AdditionalExpensesForBatchOfPreviousPeriod AS Allocation
	|		ON Allocation.Recorder = DD.Recorder
	|WHERE
	|	&BatchAccountingVersion22
	|	AND NOT VALUETYPE(DD.Recorder) = TYPE(Document.AllocationOfIncomeByLinesOfBusiness)
	// In The old releases, The Document On The distribution Of The Total Costs Had Registered Recorded Write-Offs for The financial result, generated without the "Calculated" attribute
	|	AND NOT (VALUETYPE(DD.Recorder) = TYPE(Document.AllocationOfOtherCosts) AND NOT DD.LotCalculation AND NOT DD.CalculationOfCost)
	// During the preliminary calculation, we exclude documents for which previously calculated movements are saved
	|	AND CalculatedDocuments.Recorder IS NULL
	|
	|UNION ALL
	|
	// From the amount of expenses we subtract the output of products at the planned cost.
	// The initial cost of such expenses will be determined in the function of the textthe initial cost of the item's expenses().
	// When writing-off deviations to the cost of goods sold, we do not deduct the planned cost in management and tax accounting
	// , such expenses are distributed based on the planned cost.
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	|	DD.FinRecordID AS FinRecordID,
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	DD.Organization					AS Organization,
	|	DD.ExpenseItemOfWriteOff		AS ExpenseItem,
	|	DD.DimensionOfExpenses			AS DimensionOfExpenses,
	|	DD.Department				AS Department,
	|	DD.CorLineOfBusiness	AS LineOfBusiness,
	|	1 AS Character,
	|	-DD.Cost AS Sum,
	|	-DD.CostExcludingVAT AS AmountExcludingVAT,
	|	-(CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN 0
	|		ELSE DD.CostMan END) AS SumMan,
	|	-(CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN 0
	|		ELSE DD.LocalCost END) AS SumCompl,
	|	0 AS PermanentDifference,
	|	(CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN DD.LocalCost
	|		ELSE 0 END) AS CostTD,
	|	-DD.LocalCost AS AmountFA,
	|	0 AS AITAmount
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON DD.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|WHERE
	|	NOT DD.OfficialTypeOfMovementParish
	|	AND DD.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	AND DD.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|	AND NOT DD.LotCalculation
	|	AND NOT DD.CalculationOfCost
	|
	|INDEX BY
	|	Recorder,
	|	FinRecordID,
	|	BusinessTransactionSetting,
	|	Period
	|;";
	#EndRegion
	
	#Region ExpenseAmountsPreliminary
	QueryText = QueryText + "
	|SELECT
	|	""1""						AS RequestSource,
	|	DD.Organization				AS Organization,
	|	DD.ExpenseItem			AS ExpenseItem,
	|	DD.DimensionOfExpenses		AS DimensionOfExpenses,
	|	DD.Department			AS Department,
	|	DD.LineOfBusiness	AS LineOfBusiness,
	|	DD.SumBalance				AS Sum,
	|	DD.AmountExcludingVATBalance		AS AmountExcludingVAT,
	|	DD.SumManBalance			AS SumMan,
	|	DD.SumComplBalance			AS SumCompl,
	|	CASE
	|		WHEN FALSE THEN 0 // for easy tag placement
	|		WHEN DD.ExpenseItem.ExpenseKind IN (&TypesOfExpensesNormalized)
	|			THEN 0
	|		ELSE
	|			DD.PermanentDifferenceBalance
	|	END AS PermanentDifference,
	|	DD.CostTDBalance AS CostTD,
	|	DD.SumComplBalance
	|		- DD.PermanentDifferenceBalance
	|		- DD.CostTDBalance AS AmountFA,
	|	DD.AITAmountBalance AS AITAmount
	|
	|INTO ExpenseAmountsPreliminary
	|FROM
	|	AccumulationRegister.OtherExpenses.Balance(&BorderEndOfPreviousPeriod,
	|		&BatchAccountingVersion22
	|		AND Organization IN (&CompanyArray)) AS DD
	|
	|UNION ALL	
	|
	|SELECT
	|	""2""							AS RequestSource,
	|	DD.Organization					AS Organization,
	|	DD.ExpenseItem				AS ExpenseItem,
	|	DD.DimensionOfExpenses			AS DimensionOfExpenses,
	|	DD.Department				AS Department,
	|	DD.LineOfBusiness		AS LineOfBusiness,
	|	DD.Character * DD.Sum				AS Sum,
	|	DD.Character * DD.AmountExcludingVAT		AS AmountExcludingVAT,
	|	DD.Character * DD.SumMan			AS SumMan,
	|	DD.Character * DD.SumCompl			AS SumCompl,
	|	DD.Character * DD.PermanentDifference	AS PermanentDifference,
	|	DD.Character * DD.CostTD	AS CostTD,
	|	DD.Character * DD.AmountFA			AS AmountFA,
	|	DD.Character * DD.AITAmount			AS AITAmount
	|FROM
	|	TTEstimatedTurnoverOtherExpensesIndexed AS DD
	|	LEFT JOIN TTEstimatedTurnoverCostIndexed AS CostRegisteredRecords
	|		ON CostRegisteredRecords.Period = DD.Period
	|		AND CostRegisteredRecords.Recorder = DD.Recorder
	|		AND CostRegisteredRecords.FinRecordID = DD.FinRecordID
	|		AND CostRegisteredRecords.BusinessTransactionSetting = DD.BusinessTransactionSetting
	|
	|WHERE
	// We exclude the amounts of expenses generated by the documents of the output of products (works), where the output takes place both according to a fixed and calculated estimate.
	// The amounts of such expenses will be taken from the cost of goods.
	|	CostRegisteredRecords.Recorder IS NULL
	|
	|UNION ALL	
	|
	|SELECT
	|	""3""						AS RequestSource,
	|	DD.Organization				AS Organization,
	|	DD.ExpenseItem			AS ExpenseItem,
	|	DD.DimensionOfExpenses		AS DimensionOfExpenses,
	|	DD.Department			AS Department,
	|	DD.LineOfBusiness	AS LineOfBusiness,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.Sum				AS Sum,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.AmountExcludingVAT			AS AmountExcludingVAT,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.SumMan				AS SumMan,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.SumCompl			AS SumCompl,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.PermanentDifference	AS PermanentDifference,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.CostTD		AS CostTD,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END
	|		* (DD.SumCompl
	|		- DD.PermanentDifference
	|		- DD.CostTD) AS AmountFA,
	|	CASE WHEN DD.OfficialTypeOfMovementParish THEN 1 ELSE - 1 END * DD.AITAmount				AS AITAmount
	|FROM
	|	TTCashEstimatedTurnoverOtherExpenses AS DD
	|		LEFT JOIN Document.AllocationOfOtherCosts AS T
	|		ON DD.Recorder = T.Ref
	|WHERE
	|	NOT &BatchAccountingVersion22
	|	AND DD.CalculationOfCost
	|	AND NOT DD.Recorder REFS Document.AllocationOfIncomeByLinesOfBusiness
	|	AND (T.Ref IS NULL
	|		OR NOT T.AssignAllocationSetting = VALUE(Enum.AssignmentOfCostAllocationRules.ExpenseAllocationToFinancialResult))
	|
	|UNION ALL	
	|
	// Write-offs for expenses, the amounts of which are calculated in the process of calculating the cost
	// A sign of such Registered Records is the filled-in Attribute of the expenditure item of the inventory in the cost of goods
	|SELECT
	|	""4""							AS RequestSource,
	|	DD.Organization					AS Organization,
	|	DD.ExpenseItemOfWriteOff		AS ExpenseItem,
	|	DD.DimensionOfExpenses			AS DimensionOfExpenses,
	|	DD.Department				AS Department,
	|	DD.CorLineOfBusiness	AS LineOfBusiness,
	|	0 AS Sum,
	|	0 AS AmountExcludingVAT,
	|	0 AS SumMan,
	|	0 AS SumCompl,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	0 AS AmountFA,
	|	0 AS AITAmount
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|WHERE
	|	DD.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|
	|INDEX BY
	|	ExpenseItem
	|;";
	#EndRegion
	
	#Region ExpenseAmounts
	QueryText = QueryText + "
	// The fields of the temporary Expense summary table must correspond to the temporary expense summary tables.
	// The sum of the expenses in the function changes the text of the sum of the other expenses() of the general module of the calculation of the value of the index. 
	|SELECT
	|	DD.Organization AS Organization,
	|	DD.ExpenseItem AS ExpenseItem,
	|	DD.DimensionOfExpenses AS DimensionOfExpenses,
	|	DD.Department AS Department,
	|	DD.LineOfBusiness AS LineOfBusiness,
	|	SUM(DD.Sum) AS Sum,
	|	SUM(DD.AmountExcludingVAT) AS AmountExcludingVAT,
	|	SUM(DD.SumMan) AS SumMan,
	|	SUM(CASE
	|			WHEN NOT ISNULL(TTOvz.CostAllocationOptionLocal, ARTICLES__.CostAllocationOptionLocal) 
	|					IN (	
	|						VALUE(Enum.CostAllocationOptions.ToProductionCostDirect),
	|						VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|						VALUE(Enum.CostAllocationOptions.ToCostCenters),
	|						VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
	|						VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly),
	|						VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|					)
	|				THEN 0
	|			ELSE
	|				DD.SumCompl
	|		END) AS SumCompl,
	|	SUM(CASE
	|			WHEN ISNULL(TTOvz.CostAllocationOptionLocal, ARTICLES__.CostAllocationOptionLocal) 
	|					IN (	
	|						VALUE(Enum.CostAllocationOptions.ToProductionCostDirect),
	|						VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|						VALUE(Enum.CostAllocationOptions.ToCostCenters),
	|						VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
	|						VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly),
	|						VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|					)
	|				THEN DD.PermanentDifference
	|			ELSE
	|				0
	|		END) + 
	|	0 AS PermanentDifference,
	|	SUM(
	|		CASE
	|			WHEN ISNULL(TTOvz.CostAllocationOptionLocal, ARTICLES__.CostAllocationOptionLocal) 
	|					IN (	
	|						VALUE(Enum.CostAllocationOptions.ToProductionCostDirect),
	|						VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|						VALUE(Enum.CostAllocationOptions.ToCostCenters),
	|						VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
	|						VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly),
	|						VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|					)
	|				THEN DD.SumCompl - DD.PermanentDifference
	|			ELSE
	|				0
	|		END +
	|		CASE
	|			WHEN ISNULL(TTOvz.CostAllocationOptionTax, ARTICLES__.CostAllocationOptionTax) 
	|					IN (	
	|						VALUE(Enum.CostAllocationOptions.ToProductionCostDirect),
	|						VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|						VALUE(Enum.CostAllocationOptions.ToCostCenters),
	|						VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
	|						VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly),
	|						VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|					)
	|				THEN DD.PermanentDifference + DD.CostTD - DD.SumCompl
	|			ELSE
	|				0
	|		END) +
	|	0 AS CostTD,
	|	SUM(DD.AmountFA) AS AmountFA,
	|	&AITAmount AS AITAmount
	|INTO ExpenseAmounts
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ARTICLES__
	|	INNER JOIN ExpenseAmountsPreliminary AS DD
	|		ON ARTICLES__.Ref = DD.ExpenseItem
	|	
	|	LEFT JOIN TTOvz AS TTOvz
	|		ON DD.DimensionOfExpenses = TTOvz.ConstCenter
	|	
	|GROUP BY
	|	DD.Organization,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.Department,
	|	DD.LineOfBusiness
	|
	|INDEX BY
	|	Organization,
	|	LineOfBusiness,
	|	Department,
	|	ExpenseItem,
	|	DimensionOfExpenses
	|";
	#EndRegion
	
	QueryText = CalculationOfCostLocalization.ChangeTextOfAmountOfOtherExpenses(QueryText, CalculationParameters);
	
	QueryText = StrReplace(QueryText, "&AITAmount", "0");
	
	Return QueryText;
EndFunction

// Adjustment of the Product write-off cost (used for batch accounting 2.2, 2.1 and when batch accounting is disabled.
// The procedure calculates deviations in the amounts of movements according to the register of the cost of goods from the calculated cost 
// and corrects the movements of the following registers:
// Cost of goods, other expenses
//
Procedure AdjustInventoryWriteOffCosts(CalculationParameters) Export

	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustInventoryWriteOffCosts");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	#Region DataSelection
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfWriteOffOfInventory_DataPreparation");
	
	#Region CorrectedDocuments_
	Query.Text = CostCalculationFillingInformationAboutLots.TextCorrectedDocuments(); // tue Corrected documents
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	#EndRegion
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"RegisteredRecordsAdjustmentTable");
	
	BusinessTransactionsAdjustmentTables  = New Array;
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.ReturnOfGoodsToVendor);
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.IntercompanyGoodsReturn);
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.GoodsMisgradingWithRevaluation);
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.GoodsDamageRevaluation);
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.SaleOfTransferredReturnablePackaging);
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.TransferredPackageReverseTransaction);
	BusinessTransactionsAdjustmentTables.Add(Enums.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse);
	
	If CalculationParameters.Property("NodesWithFieldOverflow") Then
		NodesWithFieldOverflow = CalculationParameters.NodesWithFieldOverflow;
	Else
		NodesWithFieldOverflow = New Array;
	EndIf;
	
	AddlParameters = CalculationParameters.AdditionalStageRequestParameters;
	AddlParameters.Insert("BusinessTransactionsAdjustmentTables", BusinessTransactionsAdjustmentTables);
	AddlParameters.Insert("NodesWithFieldOverflow", NodesWithFieldOverflow);
	AddlParameters.Insert("InaccuracyValue", 0.01);
	
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextAdjustCostOfInventoryWriteOffPreparingData(CalculationParameters));
	
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
	#EndRegion
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfWriteOffOfInventories_FormationOfRegisteredRecords");
	
	MatchingTemporaryMovementTables = New Map;
	
	// Adjustment of the write-off of goods
	GenerateTotalCostOfGoodsWithRequest(CalculationParameters, MatchingTemporaryMovementTables);
	GenerateRegisteredRecordsCostOfGoodsWriteOffReservesByRequest(CalculationParameters, MatchingTemporaryMovementTables);

	// If there is a cor. section, it is necessary to adjust the cost in the cor. part.
	GenerateCorCostOfGoodsByRequest(CalculationParameters, MatchingTemporaryMovementTables);
		
	// Reversal of the cost of goods by the management organization.
	GenerateTotalCostOfGoodsReverseInManAccountingRequest(CalculationParameters, MatchingTemporaryMovementTables);
	
	// Reflection of deviations of the actual cost from the planned in the register "Deviations in the cost of goods"
	GenerateRegisteredRecordsOfDeviationsInCostOfGoodsByRequest(CalculationParameters, Query, "TTOfRegisteredRecordedDeviationsInCostOfGoods", MatchingTemporaryMovementTables);
	
	// Adjustment of the write-off of goods for costs in the register of accounting for other expenses.
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpenses Then
		ConditionWHERE = "(
		|	(
		|		BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.GoodsConsumption),
		|			VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand),
		|			VALUE(Enum.BusinessTransactions.InventoryConsumptionReverseTransaction),
		|			VALUE(Enum.BusinessTransactions.WriteOffShortagesAtDepositorSExpense),
		|			VALUE(Enum.BusinessTransactions.RecognizeInventorySurplusForTheBenefitOfConsignor),
		|			VALUE(Enum.BusinessTransactions.RecognizeInventorySurplusForTheBenefitOfDepositor),
		|			VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost),
		|			VALUE(Enum.BusinessTransactions.WriteOffOfShippedGoods),
		|			VALUE(Enum.BusinessTransactions.GoodsWriteOffAtToller),
		|			VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAtTheExpenseOfProvider),
		|			VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany),
		|			VALUE(Enum.BusinessTransactions.TransferToFixedAssets),
		|			VALUE(Enum.BusinessTransactions.TransferToIntangibleAssetsAndRD),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ProductionCostsReverseTransaction),
		|			VALUE(Enum.BusinessTransactions.TransferForOtherPurposes),
		|			VALUE(Enum.BusinessTransactions.TransferToOperation),
		|			VALUE(Enum.BusinessTransactions.CommissioningACAndTA),
		|			VALUE(Enum.BusinessTransactions.WriteOffReportFromCommissionAgent))
		|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			AND (NOT CorCompany IS NULL AND CorCompany <> UNDEFINED AND CorCompany <> VALUE(Catalog.Companies.EmptyRef))
		|	)
		|)
		| AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
		| AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.MaterialsReceivedForProcessing)
		|";
	
		ConditionWhereotherExpenses = ConditionWHERE + "
		| AND (NOT ExpenseItemOfWriteOff IS NULL 
		|		AND ExpenseItemOfWriteOff <> UNDEFINED 
		|		AND ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|		AND AssetAndLiabilityItem = VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
		|";
		
		StructureOfTextsOfSummaryIndicators = New Structure;
		StructureOfTextsOfSummaryIndicators.Insert("TextAmount", "(AmountIncludingVAT + CASE WHEN ThisIsOutput THEN InitialCost_ ELSE 0 END)");
		StructureOfTextsOfSummaryIndicators.Insert("TextAmountWithoutVAT", "(AmountExcludingVAT + CASE WHEN ThisIsOutput THEN InitialValueWithoutVAT ELSE 0 END)");
		StructureOfTextsOfSummaryIndicators.Insert("TextAmountRegl", "(SumCompl + CASE WHEN ThisIsOutput THEN InitialLocalCost ELSE 0 END)");
		StructureOfTextsOfSummaryIndicators.Insert("TextOfSumOfMan", "(SumMan + CASE WHEN ThisIsOutput THEN InitialCostOfMan ELSE 0 END)");
		StructureOfTextsOfSummaryIndicators.Insert("TextConstantDifference", "PermanentDifference");
		StructureOfTextsOfSummaryIndicators.Insert("TextTimeDifference", "CostTD");
		StructureOfTextsOfSummaryIndicators.Insert("TextSumOfPersonalIncomeTax", "AITAmount");
		
		GenerateAllOtherExpensesUsingRequest(CalculationParameters, "TTOtherExpenses_1", MatchingTemporaryMovementTables, ConditionWhereotherExpenses,
			StructureOfTextsOfSummaryIndicators);

	EndIf;
	
	GenerateRegisteredRecordsOtherAssetsLiabilitiesByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables);
	GenerateRegisteredRecordsOnOtherAssetsLiabilitiesByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables);
	
	// Formation of other income/expenses in case of deviations in the cost of goods
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpenses Then
		
		ConditionWHERE = "
		|	(
		|		BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReturnOfGoodsToVendor),
		|			VALUE(Enum.BusinessTransactions.IntercompanyGoodsReturn),
		|			VALUE(Enum.BusinessTransactions.GoodsMisgradingWithRevaluation),
		|			VALUE(Enum.BusinessTransactions.GoodsDamageRevaluation),
		|			VALUE(Enum.BusinessTransactions.SaleOfTransferredReturnablePackaging),
		|			VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransaction),
		|			VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse),
		|			VALUE(Enum.BusinessTransactions.GoodsLotsMisgrading),
		|			VALUE(Enum.BusinessTransactions.WriteOffDiscrepanciesBetweenReceiptAndPurchase),
		|			VALUE(Enum.BusinessTransactions.RecognitionOfStockSurplusShippedToCustomer),
		|			VALUE(Enum.BusinessTransactions.WriteOffShortagesAtConsignorSExpense))
		|		OR EntryType = VALUE(Enum.LotRecordTypes.CostVarianceForOtherIncome)
		|		OR EntryType = VALUE(Enum.LotRecordTypes.GoodsCostVarianceForOtherExpenses)
		|	)
		|	AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
		|	AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.MaterialsReceivedForProcessing)
		|	";
		
		StructureOfTextsOfSummaryIndicators = New Structure;
		StructureOfTextsOfSummaryIndicators.Insert("TextAmount", "AmountIncludingVAT");
		StructureOfTextsOfSummaryIndicators.Insert("TextAmountWithoutVAT", "AmountExcludingVAT");
		StructureOfTextsOfSummaryIndicators.Insert("TextOfSumOfMan", "SumMan");
		
		GenerateAllOtherExpensesInManAccountingByRequest(CalculationParameters, "TTOtherExpensesRefundToManSupplier", MatchingTemporaryMovementTables, 
			ConditionWHERE + "
				|	AND (NOT ItemOfExpenditureWriteOffMan IS NULL 
				|		AND ItemOfExpenditureWriteOffMan <> UNDEFINED 
				|		AND ItemOfExpenditureWriteOffMan <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
				|		AND ItemOfExpenditureWriteOffMan <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
				|	)"
				,
			StructureOfTextsOfSummaryIndicators);

		GenerateAllOtherIncomeInManAccountingByRequest(CalculationParameters, "TTOtherIncomeRefundToManSupplier", MatchingTemporaryMovementTables, 
			ConditionWHERE + "
				|	AND (NOT ManSIncomeItem IS NULL 
				|		AND ManSIncomeItem <> UNDEFINED 
				|		AND ManSIncomeItem <> VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
				|	)"
				,
			"-AmountIncludingVAT",
			"- SumMan");
	
		// Formation of other income /expenses in case of deviations in the cost of goods.
		If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting Then
			
			StructureOfTextsOfSummaryIndicators = New Structure;
			StructureOfTextsOfSummaryIndicators.Insert("TextAmount", "0");
			StructureOfTextsOfSummaryIndicators.Insert("TextAmountWithoutVAT", "0");
			StructureOfTextsOfSummaryIndicators.Insert("TextOfSumOfMan", "0");
			StructureOfTextsOfSummaryIndicators.Insert("TextAmountRegl", "SumCompl");
			StructureOfTextsOfSummaryIndicators.Insert("TextConstantDifference", "PermanentDifference");
			StructureOfTextsOfSummaryIndicators.Insert("TextTimeDifference", "CostTD");
			StructureOfTextsOfSummaryIndicators.Insert("TextSumOfPersonalIncomeTax", "AITAmount");
			
			GenerateAllOtherExpensesUsingRequest(CalculationParameters, "TTOtherExpensesRefundToSupplier", MatchingTemporaryMovementTables, 
				ConditionWHERE + "
					|	AND (NOT ExpenseItemOfWriteOff IS NULL 
					|		AND ExpenseItemOfWriteOff <> UNDEFINED 
					|		AND ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
					|		AND ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
					|	)"
					,
				StructureOfTextsOfSummaryIndicators);

			GenerateOtherRevenueRegisteredRecordsWithRequest(CalculationParameters, "TTOtherIncomeRefundToSupplier", MatchingTemporaryMovementTables, 
				ConditionWHERE + "
					|	AND (NOT IncomeItem IS NULL 
					|		AND IncomeItem <> UNDEFINED 
					|		AND IncomeItem <> VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
					|	)"
					,
				"0",
				"- SumCompl",
				"0");

		EndIf;
				
	EndIf;			
	
	// Restoration of reserves for impairment of inventories.
	// Deviations of the actual cost of manufactured products from the planned.
	GenerateRegisterRecordsOfRevenueAndCostOfGoodsSoldByRequest(CalculationParameters, Query, "RegisteredRecordsTTRevenueAndCostOfSalesReservesAndDeviations", MatchingTemporaryMovementTables);
	
	// Adjustment of movements according to the turnover registers of management accounting.
	GenerateRegisteredRecordsForTurnoverRegistersOfAccountingManWithRequest(CalculationParameters, MatchingTemporaryMovementTables);
	
	// Formation of movements according to the register of information about the cost of operation
	GenerateTotalCostOfInventoryItemInOperationByRequest(CalculationParameters, Query, "TTCostOfTMTSVOperation", MatchingTemporaryMovementTables);
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

Function TextAdjustCostOfInventoryWriteOffPreparingData(CalculationParameters)
	
	QueryText = "";
	
	#Region ThereIsReturnableWaste
	
	QueryText = QueryText + CostCalculationLESSolution.TextTTHasReturnableWaste() + ";";
	
	#EndRegion
	
	
	#Region DetailsOfCorRegisteredRecords
	
	QueryText = QueryText + "
	|SELECT
	|	DD.Organization AS Organization,
	|	DD.Recorder AS Recorder,
	|	DD.FinRecordID AS FinRecordID,
	|	DD.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	DD.AccountingSection AS AccountingSection,
	|	MAX(DD.CorItemsLocationAttributes) AS CorItemsLocationAttributes,
	|	MAX(DD.BusinessOperation) AS BusinessOperation,
	|	MAX(DD.EntryType) AS EntryType,
	|	MAX(DD.BusinessTransactionSetting) AS BusinessTransactionSetting
	|
	|INTO DetailsOfCorRegisteredRecords
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|WHERE
	|	DD.OfficialTypeOfMovementParish
	|	AND DD.Count <> 0
	|	AND DD.EntryType <> VALUE(Enum.LotRecordTypes.EmptyRef)
	|	AND DD.BusinessTransactionSetting <> VALUE(Catalog.BusinessTransactionsSettings.EmptyRef)
	|GROUP BY
	|	DD.Organization,
	|	DD.Recorder,
	|	DD.FinRecordID,
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection
	|
	|INDEX BY
	|	Recorder,
	|	FinRecordID,
	|	ItemsLocationAttributes,
	|	Organization
	|;";
	#EndRegion
	
	#Region TTProductAccountingAnalytics
	// Optimization of joining VTKASHCOUNTABLE turnover and cost of goods to the directories of the keyanalyticsaccounting of the nomenclature and
	// the direction of activity, taking into account the composite type of columns of the analyticaccounting of the nomenclature and coralitikaccounting of the nomenclature in VTKASHCOUNTABLE turnover and cost of goods.
	QueryText = QueryText + "
	|SELECT DISTINCT
	|	CAST(DD.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS Ref
	|INTO TTUsedInventoryLocationAttributeAnalysis
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|WHERE
	|	VALUETYPE(DD.ItemsLocationAttributes) = TYPE(Catalog.InventoryLocationAttributeKeys)
	|
	|UNION
	|
	|SELECT DISTINCT
	|	CAST(DD.CorItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys)
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|WHERE
	|	VALUETYPE(DD.CorItemsLocationAttributes) = TYPE(Catalog.InventoryLocationAttributeKeys)
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ItemAccountingAnalyticsUsed.Ref AS Ref,
	|	InventoryLocationAttributeKeys.StorageLocation AS StorageLocation,
	|	InventoryLocationAttributeKeys.Products AS Products,
	|	InventoryLocationAttributeKeys.Characteristic AS Characteristic,
	|	InventoryLocationAttributeKeys.Purpose.LineOfBusiness AS LineOfBusiness
	|INTO TTProductAccountingAnalytics
	|FROM
	|	TTUsedInventoryLocationAttributeAnalysis AS ItemAccountingAnalyticsUsed
	|		INNER JOIN Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
	|		ON ItemAccountingAnalyticsUsed.Ref = InventoryLocationAttributeKeys.Ref
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTUsedInventoryLocationAttributeAnalysis
	|;";
	
	#EndRegion
	
	#Region TTAdjustmentTable
	
	QueryText = QueryText + "
	|SELECT
	|	CostAccounting_.Period                        	AS Period,
	|	MAX(CostAccounting_.VariancePeriod)       	AS VariancePeriod,
	|	CASE
	|		WHEN CostAccounting_.OfficialTypeOfMovementParish
	|			THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END                   							AS RecordType,
	|	CASE WHEN CostAccounting_.Organization IN(&MediumSlipOrganizations)
	|		THEN CalculationLoggers.Ref
	|		ELSE CostAccounting_.Recorder
	|	END 												AS DocumentRegisterRecords,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END) AS DocumentCalculation,
	|	CostAccounting_.Organization                   	AS Organization,
	|	DimensionOfProductItem.StorageLocation             	AS Warehouse,
	|	DimensionOfProductItem.Products             		AS Products,
	|	CostAccounting_.ItemsLocationAttributes    	AS ItemsLocationAttributes,
	|	(CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|		 AND CostAccounting_.Count < 0
	|		 AND NOT ThereIsReturnableWaste.Organization IS NULL
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) // returnable waste is accounted for by an empty accounting section
	|		ELSE CostAccounting_.AccountingSection END) AS AccountingSection,
	|	CostAccounting_.InventoryOwnerAttribute                    	AS InventoryOwnerAttribute,
	|	ISNULL(CostAccounting_.InventoryOwnerAttribute.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)) AS InventoryType,
	|	CostAccounting_.BusinessOperation				AS BusinessOperation,
	|	CostAccounting_.CorItemsLocationAttributes 	AS CorItemsLocationAttributes,
	|	CorAnalysisOfProducts.StorageLocation          	AS CorWarehouseCorCommissionAgentCorBusinessUnit,
	|	CorAnalysisOfProducts.Products           	AS CorNomenclature,
	// When using the average sliding cost from the "Output" section, the difference between the actual and planned cost
	// is reflected in the register "Deviations in the cost of goods", so the accounting field is not filled in.
	|	(CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|		ELSE CostAccounting_.CorAccountingSection END)   AS CorAccountingSection,
	|	CostAccounting_.CorInventoryOwnerAttribute                 	AS CorInventoryOwnerAttribute,
	|	ISNULL(CostAccounting_.CorInventoryOwnerAttribute.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)) AS CorInventoryType,
	|	CostAccounting_.CorCompany                	AS CorCompany,
	|	CostAccounting_.Department                 	AS Department,
	|	CostAccounting_.AccountingDimensionByPartners     	AS AccountingDimensionByPartners,
	|	CostAccounting_.SalesOrder                  	AS SalesOrder,
	|	CostAccounting_.DimensionOfExpenses            		AS DimensionOfExpenses,
	|	CostAccounting_.ExpenseItemOfWriteOff        	AS ExpenseItemOfWriteOff,
	|	CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionManag		  AS CostAllocationOptionManag,
	|	CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionLocal		  AS CostAllocationOptionLocal,
	|	ISNULL(CostAccounting_.ExpenseItemOfWriteOff.EnteredInTaxAccounting, FALSE) AS EnteredInTaxAccounting,
	|	CostAccounting_.IncomeItem                 	AS IncomeItem,
	|	CostAccounting_.DimensionOfRevenue              	AS DimensionOfRevenue,
	|	CostAccounting_.AssetAndLiabilityItem         	AS AssetAndLiabilityItem,
	|	CostAccounting_.AssetsLiabilitiesDimension      	AS AssetsLiabilitiesDimension,
	|	CostAccounting_.RowID           	AS RowID,
	|	CostAccounting_.RowCode                     	AS RowCode,
	|	CostAccounting_.SalePeriod                 	AS SalePeriod,
	|	CostAccounting_.ProductsGroup               	AS ProductsGroup,
	|	ISNULL(DimensionOfProductItem.LineOfBusiness,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	|	CostAccounting_.CorLineOfBusiness        AS CorLineOfBusiness,
	|	CASE WHEN NOT StornoCommissionAgentSReports.Period IS NULL
	|	 AND CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|	 AND CostAccounting_.Count < 0
	|		THEN TRUE
	|		ELSE FALSE
	|	END 												AS StornoReportOnCommission,
	|	CostAccounting_.Lot                          	AS Lot,
	|	CostAccounting_.LotVendorAttributes              AS LotVendorAttributes,
	|	CostAccounting_.FinancialAccountingDimension         AS FinancialAccountingDimension,
	|	CostAccounting_.VATActivityType                AS VATActivityType,
	|	CostAccounting_.CorLot                 		AS CorLot,
	|	CostAccounting_.LotVendorAttributesCorr           AS LotVendorAttributesCorr,
	|	CostAccounting_.CorControllingAttributes      AS CorControllingAttributes,
	|	CostAccounting_.CorVATActivityTypes             AS CorVATActivityTypes,
	|	CostAccounting_.VATActivityTypeShipments        AS VATActivityTypeShipments,
	|	CostAccounting_.ProductCostElement                 AS ProductCostElement,
	|	CostAccounting_.EntryType                 		AS EntryType,
	// In sum movements, we do not fill in the Document Source field to exclude the occurrence of unnecessary rounding
	// when splitting the initial amount into different source documents.
	|	UNDEFINED                                        AS DocumentSource,
	// For organizations on a medium-slip line, the Storno sign is not filled in, because Registered Records are generated under the service
	// document "Cost Calculation Registrar" and these are estimated Registered Records, and not storno Registered Records of the corrected document.
	|	CASE
	|		WHEN CostAccounting_.Organization IN (&MediumSlipOrganizations)
	|			THEN FALSE
	|		ELSE CostAccounting_.ReversingEntry END			AS ReversingEntry,
	|	CostAccounting_.BusinessTransactionSetting	AS BusinessTransactionSetting,
	|	CostAccounting_.FinRecordID			AS FinRecordID,
	|	CostAccounting_.GLAccountSettings              AS GLAccountSettings,
	|	CostAccounting_.CostAccountingTransaction        AS CostAccountingTransaction,
	|	CostAccounting_.CostDefiningMethod    AS CostDefiningMethod,
	
	|	CASE
	// The output of products at the planned cost, if deviations are written off to the cost of goods sold.
	// Reserves for supply of inventories are written off to the cost of goods sold at the time of production.
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND TTAccountingPoliciesOfFinancialAccounting.ProductCostingByPlannedCost
	|		 AND TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN TRUE
	// The conditions for the formation of the Restore Reserves field must correspond to the conditions for the formation of a similar field
	// in the function of the texttableconnection of the item data() #The area of the textquestionmaterialstatistics.
	|		WHEN CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|			THEN TRUE
	|		WHEN CostAccounting_.Organization IN (&CompaniesWithRestorationOfReservesWhenInventoryWriteOffForExpenses)
	|		 AND NOT CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionLocal IS NULL
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS RestoreReserves,
	|
	|	ISNULL(DetailsOfCorRegisteredRecords.BusinessOperation,
	|		CostAccounting_.BusinessOperation)        AS ParishEconomicOperation,
	|	ISNULL(DetailsOfCorRegisteredRecords.EntryType,
	|		CostAccounting_.EntryType)                    AS ParishRecordType,
	|	ISNULL(DetailsOfCorRegisteredRecords.BusinessTransactionSetting,
	|		CostAccounting_.BusinessTransactionSetting) AS ArrivalSettingUpBusinessOperation,
	|	ISNULL(DetailsOfCorRegisteredRecords.CorItemsLocationAttributes,
	|		CostAccounting_.CorItemsLocationAttributes) AS ArrivalOfCorAnalyticsAccountingProducts,
	|
	|	(CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND NOT CostAccounting_.OfficialTypeOfMovementParish
	|		 AND TTAccountingPoliciesOfFinancialAccounting.ProductCostingByPlannedCost
	|		 AND TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN TRUE
	|		ELSE FALSE
	|	END) AS WriteOffDeviationsToCostOfGoodsSelling,
	|
	|	SUM(CostAccounting_.Count)        			AS Count,
	|	SUM(CostAccounting_.Cost)              	AS Cost,
	|	SUM(CostAccounting_.CostExcludingVAT)        	AS CostExcludingVAT,
	|	SUM(CostAccounting_.LocalCost)          	AS LocalCost,
	|	SUM(CostAccounting_.AddExpensesForGoods)					AS AddExpensesForGoods,
	|	SUM(CostAccounting_.AdditionalExpensesExcludingVAT)			AS AdditionalExpensesExcludingVAT,
	|	SUM(CostAccounting_.AddExpensesLocal)				AS AddExpensesLocal,
	|	SUM(CostAccounting_.LaborCosts)				AS LaborCosts,
	|	SUM(CostAccounting_.LaborCostsLocal)			AS LaborCostsLocal,
	|	SUM(CostAccounting_.ItemizedFixedCostsIncludingVAT)	AS ItemizedFixedCostsIncludingVAT,
	|	SUM(CostAccounting_.ItemizedFixedCostsExcludingVAT) AS ItemizedFixedCostsExcludingVAT,
	|	SUM(CostAccounting_.ItemizedFixedCostsCompl)	AS ItemizedFixedCostsCompl,
	|	SUM(CostAccounting_.ItemizedVariableCostsIncludingVAT)	AS ItemizedVariableCostsIncludingVAT,
	|	SUM(CostAccounting_.ItemizedVariableCostsExcludingVAT) AS ItemizedVariableCostsExcludingVAT,
	|	SUM(CostAccounting_.ItemizedVariableCostsCompl)	AS ItemizedVariableCostsCompl,
	|	SUM(CostAccounting_.PermanentDifference)      	AS PermanentDifference,
	|	SUM(CostAccounting_.CostTD)       	AS CostTD,
	|	SUM(CostAccounting_.CostOfPersonalIncomeTax)       		AS CostOfPersonalIncomeTax,
	|	SUM(CostAccounting_.OffBalanceCost)      AS OffBalanceCost,
	|	SUM(CostAccounting_.OffBalanceCostLocal)  AS OffBalanceCostLocal,
	|	SUM(CostAccounting_.ProvisionForImpairmentLocal)   AS ProvisionForImpairmentLocal,
	|	SUM(CostAccounting_.ProvisionForImpairmentMan)    AS ProvisionForImpairmentMan,
	|	SUM(CostAccounting_.CorGrossInitialCostENT)           	AS CorGrossInitialCostENT,
	|	SUM(CostAccounting_.VATLocal)           			AS VATLocal,
	|	SUM(CostAccounting_.CostMan)				AS CostMan,
	|	SUM(CostAccounting_.AddExpensesMan)				AS AddExpensesMan,
	|	SUM(CostAccounting_.LaborCostsMan)			AS LaborCostsMan,
	|	SUM(CostAccounting_.ItemizedFixedCostsManag)	AS ItemizedFixedCostsManag,
	|	SUM(CostAccounting_.ItemizedVariableCostsManag)	AS ItemizedVariableCostsManag,
	|	SUM(CostAccounting_.VATManag)           			AS VATManag
	|INTO TTAdjustmentTable
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS CostAccounting_
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON CostAccounting_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|	LEFT JOIN TTProductAccountingAnalytics AS DimensionOfProductItem
	|		ON CostAccounting_.ItemsLocationAttributes = DimensionOfProductItem.Ref
	|	LEFT JOIN TTProductAccountingAnalytics AS CorAnalysisOfProducts
	|		ON CostAccounting_.CorItemsLocationAttributes = CorAnalysisOfProducts.Ref
	|	LEFT JOIN StornoCommissionAgentSReports AS StornoCommissionAgentSReports // Created in the procedure to adjust the value of the returns of the past periods()
	|		ON StornoCommissionAgentSReports.ItemsLocationAttributes = CostAccounting_.ItemsLocationAttributes
	|		AND StornoCommissionAgentSReports.AccountingSection = CostAccounting_.AccountingSection
	|		AND StornoCommissionAgentSReports.InventoryOwnerAttribute = CostAccounting_.InventoryOwnerAttribute
	|		AND StornoCommissionAgentSReports.Organization = CostAccounting_.Organization
	|		AND CostAccounting_.Count < 0
	|		AND CostAccounting_.DocumentSource = UNDEFINED

	|	LEFT JOIN ThereIsReturnableWaste AS ThereIsReturnableWaste
	|		ON ThereIsReturnableWaste.Organization = CostAccounting_.Organization
	|		AND ThereIsReturnableWaste.ItemsLocationAttributes = CostAccounting_.ItemsLocationAttributes
	|		AND ThereIsReturnableWaste.InventoryOwnerAttribute = CostAccounting_.InventoryOwnerAttribute
	|		AND ThereIsReturnableWaste.AccountingSection = CostAccounting_.AccountingSection
	|	LEFT JOIN DetailsOfCorRegisteredRecords AS DetailsOfCorRegisteredRecords
	|		ON CASE WHEN CostAccounting_.CorCompany = VALUE(Catalog.Companies.EmptyRef)
	|				THEN DetailsOfCorRegisteredRecords.Organization = CostAccounting_.Organization
	|				ELSE DetailsOfCorRegisteredRecords.Organization = CostAccounting_.CorCompany
	|			END
	|		AND DetailsOfCorRegisteredRecords.Recorder = CostAccounting_.Recorder
	|		AND DetailsOfCorRegisteredRecords.FinRecordID = CostAccounting_.FinRecordID
	|		AND DetailsOfCorRegisteredRecords.ItemsLocationAttributes = CostAccounting_.CorItemsLocationAttributes
	|		AND DetailsOfCorRegisteredRecords.AccountingSection = CostAccounting_.CorAccountingSection
	|	LEFT JOIN CalculatedDocuments AS CalculatedDocuments
	|		ON CalculatedDocuments.Period = CostAccounting_.Period
	|		AND CalculatedDocuments.Recorder = CostAccounting_.Recorder
	|		AND &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = CostAccounting_.Organization
	|	LEFT JOIN TueDatesOfSourceDocuments AS Register3
	|		ON Register3.Ref = CostAccounting_.DocumentSource
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = CostAccounting_.Recorder
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocumentsOnSourceDocument
	|		ON CorrectedDocumentsOnSourceDocument.ReversedDocument = CostAccounting_.Recorder
	|WHERE
	|	(NOT CostAccounting_.OfficialTypeOfMovementParish
	|		AND NOT CostAccounting_.EntryType IN (VALUE(Enum.LotRecordTypes.Lot),
	|											VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods),
	|											VALUE(Enum.LotRecordTypes.CostVariance),
	|											VALUE(Enum.LotRecordTypes.CostVarianceForOtherIncome),
	|											VALUE(Enum.LotRecordTypes.GoodsCostVarianceForOtherExpenses),
	|		 									VALUE(Enum.LotRecordTypes.CostAdjustment),
	|											VALUE(Enum.LotRecordTypes.AddExpensesLotIsSpecified),
	|											VALUE(Enum.LotRecordTypes.AddExpensesLotIsNotSpecified),
	|											VALUE(Enum.LotRecordTypes.AdditionalExpensesReverseTransaction),
	|											VALUE(Enum.LotRecordTypes.IncludeExciseInCost),
	|											VALUE(Enum.LotRecordTypes.DebitNoteForPreviousPeriod))
	|		OR (CostAccounting_.Count <> 0
	|			 AND CostAccounting_.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.ReverseOfSaleReturnToAnotherWarehouse),
	|				VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse),
	|				VALUE(Enum.BusinessTransactions.ProductsRelease),
	|				VALUE(Enum.BusinessTransactions.ProductsReleaseToBusinessUnit))
	|			 AND NOT CostAccounting_.ReversingEntry
	|		OR CostAccounting_.Count <> 0
	|			AND CostAccounting_.EntryType = VALUE(Enum.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction)
	|			)
	// When calculating the cost, the planned cost of production is reversed, because the actual cost is formed from the cost
	// of writing off materials and it is not possible to calculate deviations from the planned cost. 
	|		OR CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.PostingOfReleaseTargetCost)
	|			AND &MonthEndClosingMode <> VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|	)
	|	AND (CostAccounting_.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries)
	|		OR CostAccounting_.CostAccountingTransaction = VALUE(Enum.CostAccountingTransactions.DisposalAtFixedCost)
	|		OR CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsLotsMisgrading))
	// We exclude refunds from the previous period.
	// The data sampling conditions must correspond to the function adjust the value of the returns of the past periods()
	|	AND NOT (NOT CostAccounting_.OfficialTypeOfMovementParish
	|			AND CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|			AND CostAccounting_.EntryType = VALUE(Enum.LotRecordTypes.ReturnWithoutSourceDocument)
	|			AND CostAccounting_.DocumentSource <> UNDEFINED
	|			AND Register3.IBDocumentDate < &BeginOfPeriod
	|			)
	|	AND NOT (NOT CostAccounting_.OfficialTypeOfMovementParish
	|			AND CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|			AND CostAccounting_.EntryType = VALUE(Enum.LotRecordTypes.ReturnWithoutSourceDocument)
	|			AND CostAccounting_.DocumentSource = UNDEFINED
	|			AND (ISNULL(StornoCommissionAgentSReports.Period,
	|				BEGINOFPERIOD(CostAccounting_.SalePeriod, MONTH)) <> DATETIME(1,1,1,0,0,0)
	// Additionally, it is necessary to exclude the sum movement formed in the corrected value of the returns of the previous periods()
	|					OR CostAccounting_.CalculationOfCost)
	|			AND CostAccounting_.SalePeriod < &BeginOfPeriod)
	|
	// We exclude the storno Registered Records of corrections and adjustments of the previous period.
	// Such Registered Records have already been formed in the procedure for correcting the cost of roadmovementsrecorded documents() The area of correction of the cost of goods
	// In addition to Registering Recorded movements according to the Accounting section "Output" when using the "Medium-slip" method, because with this method, the initial
	// Registered Records are generated by the Recorders of the cost calculation and the Registered Records are not storno generated
	// in the procedure to adjust the value of the fixed documents() 
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND CostAccounting_.ReversingEntry
	|		AND NOT (CostAccounting_.Organization IN (&MediumSlipOrganizations)
	|			AND CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease))
	|	)
	|
	|	AND NOT (CostAccounting_.ReversingEntry
	|		AND CostAccounting_.EntryType = VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|		AND CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost))
	// We exclude the calculation of deviations for disposal at a fixed cost if the batch was not selected for recording.
	// Calculation of deviations in the cost of such a record will be performed at the stage of re-sorting batches of goods.
	// The data sampling conditions must match the function See CostCalculationLESSolution.TextTT_Adjustments_MaterialAndLaborCosts
	|	AND NOT (CostAccounting_.CostAccountingTransaction = VALUE(Enum.CostAccountingTransactions.DisposalAtFixedCost)
	|		AND CostAccounting_.CalculationIsNotCompleted
	|		AND CostAccounting_.Cost <> 0)
	|
	// We Exclude write-offs for expenses and transfer of products from Production at A Fixed Cost.
	|	AND NOT CostAccounting_.BusinessOperation IN (
	|		VALUE(Enum.BusinessTransactions.TransferOfProductsFromProductionFixedCost))
	// During the preliminary calculation, we exclude documents for which previously calculated movements are saved
	|	AND CalculatedDocuments.Recorder IS NULL
	// We exclude the adjustment of the planned cost of the issue.
	|	AND NOT (CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.PostingOfReleaseTargetCost)
	|		AND CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease))
	|	AND CostAccounting_.BusinessOperation <> VALUE(Enum.BusinessTransactions.InternalChangingPriceEvaluationMethod)
	// We exclude storno documents of return of goods from the client (there are no corrections on them, only storno).
	|	AND NOT (CorrectedDocumentsOnSourceDocument.ReversedDocument IS NOT NULL
	|		AND VALUETYPE(CostAccounting_.Recorder) = TYPE(Document.ReturnOfGoodsFromCustomer))
	// We exclude the sum Register Records generated for the cost calculation registrar.
	// Such Registered Records are formed by the stage of correcting the value of the past periods and do not require correction.
	|	AND NOT (CostAccounting_.Count = 0
	|		AND VALUETYPE(CostAccounting_.Recorder) = TYPE(Document.CostCalculationRecorder))
	|	
	|GROUP BY
	|	CostAccounting_.Period,
	|	CASE
	|		WHEN CostAccounting_.OfficialTypeOfMovementParish
	|			THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END,
	|	CASE WHEN CostAccounting_.Organization IN(&MediumSlipOrganizations)
	|		THEN CalculationLoggers.Ref
	|		ELSE CostAccounting_.Recorder
	|	END,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END), // DocumentCalculation
	|	CostAccounting_.Organization,
	|	DimensionOfProductItem.StorageLocation,
	|	DimensionOfProductItem.Products,
	|	CostAccounting_.ItemsLocationAttributes,
	|	(CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|		 AND CostAccounting_.Count < 0
	|		 AND NOT ThereIsReturnableWaste.Organization IS NULL
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) // returnable waste is accounted for by an empty accounting section
	|			ELSE CostAccounting_.AccountingSection END),
	|	CostAccounting_.InventoryOwnerAttribute,
	|	ISNULL(CostAccounting_.InventoryOwnerAttribute.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)),
	|	CostAccounting_.BusinessOperation,
	|	CostAccounting_.CorItemsLocationAttributes,
	|	CorAnalysisOfProducts.StorageLocation,
	|	CorAnalysisOfProducts.Products,
	|	(CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|		ELSE CostAccounting_.CorAccountingSection END), // CorAccountingSection
	|	CostAccounting_.CorInventoryOwnerAttribute,
	|	ISNULL(CostAccounting_.CorInventoryOwnerAttribute.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)),
	|	CostAccounting_.CorCompany,
	|	CostAccounting_.Department,
	|	CostAccounting_.AccountingDimensionByPartners,
	|	CostAccounting_.SalesOrder,
	|	CostAccounting_.DimensionOfExpenses,
	|	CostAccounting_.ExpenseItemOfWriteOff,
	|	CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionManag,
	|	CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionLocal,
	|	ISNULL(CostAccounting_.ExpenseItemOfWriteOff.EnteredInTaxAccounting, FALSE),
	|	CostAccounting_.IncomeItem,
	|	CostAccounting_.DimensionOfRevenue,
	|	CostAccounting_.AssetAndLiabilityItem,
	|	CostAccounting_.AssetsLiabilitiesDimension,
	|	CostAccounting_.RowID,
	|	CostAccounting_.RowCode,
	|	CostAccounting_.SalePeriod,
	|	CostAccounting_.ProductsGroup,
	|	ISNULL(DimensionOfProductItem.LineOfBusiness,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef)),
	|	CostAccounting_.CorLineOfBusiness,
	|	CASE WHEN NOT StornoCommissionAgentSReports.Period IS NULL
	|	 AND CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|	 AND CostAccounting_.Count < 0
	|		THEN TRUE
	|		ELSE FALSE
	|	END,
	|	CostAccounting_.Lot,
	|	CostAccounting_.LotVendorAttributes,
	|	CostAccounting_.FinancialAccountingDimension,
	|	CostAccounting_.VATActivityType,
	|	CostAccounting_.CorLot,
	|	CostAccounting_.LotVendorAttributesCorr,
	|	CostAccounting_.CorControllingAttributes,
	|	CostAccounting_.CorVATActivityTypes,
	|	CostAccounting_.VATActivityTypeShipments,
	|	CostAccounting_.ProductCostElement,
	|	CostAccounting_.EntryType,
	|	CASE
	|		WHEN CostAccounting_.Organization IN (&MediumSlipOrganizations)
	|			THEN FALSE
	|		ELSE CostAccounting_.ReversingEntry END, // ReversingEntry
	|	CostAccounting_.BusinessTransactionSetting,
	|	CostAccounting_.FinRecordID,
	|	CostAccounting_.GLAccountSettings,
	|	CostAccounting_.CostAccountingTransaction,
	|	CostAccounting_.CostDefiningMethod,
	|	CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND TTAccountingPoliciesOfFinancialAccounting.ProductCostingByPlannedCost
	|		 AND TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN TRUE
	|		WHEN CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|			THEN TRUE
	|		WHEN CostAccounting_.Organization IN (&CompaniesWithRestorationOfReservesWhenInventoryWriteOffForExpenses)
	|		 AND NOT CostAccounting_.ExpenseItemOfWriteOff.CostAllocationOptionLocal IS NULL
	|			THEN TRUE
	|		ELSE FALSE
	|	END, // RestoreReserves
	|	ISNULL(DetailsOfCorRegisteredRecords.BusinessOperation,
	|		CostAccounting_.BusinessOperation), // ParishEconomicOperation
	|	ISNULL(DetailsOfCorRegisteredRecords.EntryType,
	|		CostAccounting_.EntryType),
	|	ISNULL(DetailsOfCorRegisteredRecords.BusinessTransactionSetting,
	|		CostAccounting_.BusinessTransactionSetting), // ArrivalSettingUpBusinessOperation
	|	ISNULL(DetailsOfCorRegisteredRecords.CorItemsLocationAttributes,
	|		CostAccounting_.CorItemsLocationAttributes), // ArrivalOfCorAnalyticsAccountingProducts
	|	(CASE
	|		WHEN CostAccounting_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|		 AND NOT CostAccounting_.OfficialTypeOfMovementParish
	|		 AND TTAccountingPoliciesOfFinancialAccounting.ProductCostingByPlannedCost
	|		 AND TTAccountingPoliciesOfFinancialAccounting.WriteOffProductCostVariancesToCostOfGoodsSold
	|			THEN TRUE
	|		ELSE FALSE
	|	END) // WriteOffDeviationsToCostOfGoodsSelling
	|
	|INDEX BY
	|	ItemsLocationAttributes,
	|	InventoryOwnerAttribute,
	|	Organization,
	|	AccountingSection
	|;";
	#EndRegion
	
	#Region AITExpenseRecognitionSettingsForItemAccountingAnalytics
	
	QueryText = QueryText + CalculationOfCostLocalization.AITSettingsQueryText("TTAdjustmentTable",
		"CostCalculationCostAdjustment_AdjustCostOfWriteOffOfInventories",
		CalculationParameters) + 
		Common.QueryBatchSeparator();
		
	#EndRegion
	
	#Region TTDataAdjustmentTable
	
	QueryText = QueryText + "
	|SELECT
	|	Register3.Ref AS Ref,
	|	MAX(Register3.Department) AS Department
	|INTO VtRegisterOfMovementDocuments
	|FROM
	|	TTAdjustmentTable AS AdjustmentTable
	|	INNER JOIN InformationRegister.DocumentsRegistry AS Register3
	|	ON Register3.Ref = AdjustmentTable.DocumentRegisterRecords
	|		AND NOT Register3.AdditionalRecord
	|GROUP BY
	|	Register3.Ref
	|INDEX BY
	|	Ref
	|;
	|SELECT
	|	AdjustmentTable.Period                        AS Period,
	|	AdjustmentTable.VariancePeriod       	   AS VariancePeriod,
	|	AdjustmentTable.RecordType                   AS RecordType,
	|	AdjustmentTable.DocumentRegisterRecords              AS DocumentRegisterRecords,
	|	AdjustmentTable.DocumentCalculation               AS DocumentCalculation,
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.Warehouse                         AS Warehouse,
	|	AdjustmentTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	Dimension.Products                             AS Products,
	|	(CASE
	|		WHEN AdjustmentTable.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|		ELSE AdjustmentTable.AccountingSection END) AS AccountingSection,
	|	AdjustmentTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN AdjustmentTable.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|		 OR (AdjustmentTable.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|				AND NOT AdjustmentTable.Products.TracedGoods)
	|			THEN UNDEFINED
	|		ELSE ISNULL(AdjustmentTable.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods))
	|	END                                              AS InventoryType,
	|	AdjustmentTable.BusinessOperation         AS BusinessOperation,
	|	AdjustmentTable.CorItemsLocationAttributes AS CorItemsLocationAttributes,
	|	CASE
	|		WHEN &KeepRecordsOfInventoryCostByAssignments
	|			THEN RecyclableWasteAllocation.ItemsLocationAttributes
	|		ELSE AnalysisOfProductsWithoutAssignment.DimensionKey
	|	END                                              AS AnalysisOfAccountingForProductRange,
	|	CASE
	|		WHEN &AnalyticalAccountingByProductsGroups
	|			AND NOT ISNULL(CatProducts.AnalyticalGroup,
	|					VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)) =
	|						VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|			THEN CatProducts.AnalyticalGroup
	|		ELSE UNDEFINED
	|	END                                              AS AnalysisOfFinancialAccountingIn,
	|	AdjustmentTable.CorWarehouseCorCommissionAgentCorBusinessUnit                      AS CorWarehouseCorCommissionAgentCorBusinessUnit,
	|	AdjustmentTable.CorAccountingSection                AS CorAccountingSection,
	|	AdjustmentTable.CorInventoryOwnerAttribute                 AS CorInventoryOwnerAttribute,
	|	CASE
	|		WHEN AdjustmentTable.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
	|		 OR (AdjustmentTable.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|				AND NOT AdjustmentTable.Products.TracedGoods)
	|			THEN UNDEFINED
	|		ELSE ISNULL(AdjustmentTable.CorInventoryType, VALUE(Enum.InventoryTypes.OwnGoods))
	|	END                                              AS CorInventoryType,
	|	AdjustmentTable.CorCompany                AS CorCompany,
	|	AdjustmentTable.Department                 AS Department,
	|	AdjustmentTable.AccountingDimensionByPartners     AS AccountingDimensionByPartners,
	|	AdjustmentTable.SalesOrder                  AS SalesOrder,
	|	AdjustmentTable.DimensionOfExpenses             AS DimensionOfExpenses,
	|	AdjustmentTable.ExpenseItemOfWriteOff        AS ExpenseItemOfWriteOff,
	|	AdjustmentTable.ExpenseItemOfWriteOff        AS ItemOfExpenditureWriteOffMan,
	|	AdjustmentTable.DimensionOfExpenses             AS AnalysisOfManSExpenses,
	|	AdjustmentTable.CostAllocationOptionManag  AS CostAllocationOptionManag,
	|	AdjustmentTable.CostAllocationOptionLocal AS CostAllocationOptionLocal,
	|	AdjustmentTable.EnteredInTaxAccounting      AS EnteredInTaxAccounting,
	|	AdjustmentTable.LineOfBusiness       AS LineOfBusiness,
	|	AdjustmentTable.CorLineOfBusiness    AS CorLineOfBusiness,
	|	AdjustmentTable.IncomeItem                 AS IncomeItem,
	|	AdjustmentTable.DimensionOfRevenue              AS DimensionOfRevenue,
	|	AdjustmentTable.IncomeItem                 AS ManSIncomeItem,
	|	AdjustmentTable.DimensionOfRevenue              AS ManRevenueAnalytics,
	|	AdjustmentTable.AssetAndLiabilityItem         AS AssetAndLiabilityItem,
	|	AdjustmentTable.AssetsLiabilitiesDimension      AS AssetsLiabilitiesDimension,
	|	AdjustmentTable.RowID           AS RowID,
	|	AdjustmentTable.RowCode                     AS RowCode,
	|	AdjustmentTable.SalePeriod                 AS SalePeriod,
	|	AdjustmentTable.ProductsGroup               AS ProductsGroup,
	|	AdjustmentTable.StornoReportOnCommission		   AS StornoReportOnCommission,
	|	AdjustmentTable.Lot                        AS Lot,
	|	AdjustmentTable.LotVendorAttributes          AS LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType            AS VATActivityType,
	|	AdjustmentTable.CorLot                 	   AS CorLot,
	|	AdjustmentTable.LotVendorAttributesCorr       AS LotVendorAttributesCorr,
	|	AdjustmentTable.CorControllingAttributes  AS CorControllingAttributes,
	|	AdjustmentTable.CorVATActivityTypes         AS CorVATActivityTypes,
	|	AdjustmentTable.ProductCostElement             AS ProductCostElement,
	|	AdjustmentTable.EntryType                 	   AS EntryType,
	|	AdjustmentTable.DocumentSource              AS DocumentSource,
	|	AdjustmentTable.ReversingEntry                        AS ReversingEntry,
	|	AdjustmentTable.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	AdjustmentTable.FinRecordID        AS FinRecordID,
	|	AdjustmentTable.GLAccountSettings          AS GLAccountSettings,
	|	AdjustmentTable.CostAccountingTransaction    AS CostAccountingTransaction,
	|	AdjustmentTable.CostDefiningMethod AS CostDefiningMethod,
	|	AdjustmentTable.RestoreReserves        AS RestoreReserves,
	|	AdjustmentTable.ParishEconomicOperation   AS ParishEconomicOperation,
	|	AdjustmentTable.ParishRecordType               AS ParishRecordType,
	|	AdjustmentTable.ArrivalSettingUpBusinessOperation AS ArrivalSettingUpBusinessOperation,
	|	AdjustmentTable.ArrivalOfCorAnalyticsAccountingProducts  AS ArrivalOfCorAnalyticsAccountingProducts,
	|	AdjustmentTable.WriteOffDeviationsToCostOfGoodsSelling AS WriteOffDeviationsToCostOfGoodsSelling,
	|	ISNULL(Register3.Department, UNDEFINED) AS DocumentSubdivision,
	|
	|	CASE
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			THEN AdjustmentTable.InventoryOwnerAttribute
	|		ELSE 
	|			AdjustmentTable.Products
	|	END AS SourceOfProductFinancialAccountingGroup,
	|	CASE
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			THEN AdjustmentTable.CorInventoryOwnerAttribute
	|		ELSE 
	|			AdjustmentTable.CorNomenclature
	|	END AS CorSourceOfItemsFinancialAccountingGroup,
	|	CASE WHEN AdjustmentTable.BusinessOperation IN (&ArrayOfTransferOperations) THEN
	|			TRUE
	|		ELSE
	|			FALSE
	|	END                                              AS ThisIsTransferBetweenOrganizations,
	|	(CASE
	|		WHEN ISNULL(CorAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod, UNDEFINED)
	|				= VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|			THEN TRUE
	|		ELSE FALSE END)                              AS CorCompanyOnMediumSlip,
	|	AdjustmentTable.CorGrossInitialCostENT                  AS CorGrossInitialCostENT,
	|
	|	CASE
	|		WHEN TRUE THEN // for easy tag placement
	|			FALSE
	|		ELSE
	|			FALSE
	|	END ThisIsOutput,
	|
	|	CASE
	|		WHEN AdjustmentTable.BusinessOperation = VALUE(Enum.BusinessTransactions.IntercompanyGoodsReturn) THEN
	|			TRUE
	|		ELSE
	|			FALSE
	|	END ThisIsReturnBetweenOrganizations,
	// Provisions for impairment of inventories are not written off if
	//	- the Products and characteristics do not change
	//	- The Product list is written off for production from the Work-in-Progress section
	// or the batch is written off. This is a Catalog of "Production batches".
	// The conditions for the formation of the Write-off reserves field must correspond to the conditions for the formation of the Transfer reserves field
	// in the function of the calculation of the value of the value of the value.Text of the link between the nodes of reserves and the depreciation of reserves().
	|	(CASE
	|		WHEN AdjustmentTable.CorAccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|		 AND Dimension.Products = ISNULL(CorDimension.Products, UNDEFINED)
	|		 AND Dimension.Characteristic = ISNULL(CorDimension.Characteristic, UNDEFINED)
	|		 AND NOT AdjustmentTable.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany),
	|				VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
	|				VALUE(Enum.BusinessTransactions.Subcontracting2_5),
	|				VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
	|				VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
	|				VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5)
	|				)
	|			THEN FALSE
	|		WHEN AdjustmentTable.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)
	|			THEN FALSE
	|		WHEN VALUETYPE(AdjustmentTable.Lot) = TYPE(Catalog.ProductionLots)
	|			THEN FALSE
	|		ELSE TRUE END) AS WriteOffReserves,
	|
	|	(CASE
	// We exclude the calculation of the cost of the Registered Records for which the calculation is performed on a medium-slip.
	|		WHEN AdjustmentTable.CostDefiningMethod IN (
	|			VALUE(Enum.WaysToCalculateInventoryCost.FromDocument),
	|			VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage),
	|		 	VALUE(Enum.WaysToCalculateInventoryCost.BySourceDocumentRegisterRecords))
	|		  AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|		  AND AdjustmentTable.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|			THEN 0
	|		WHEN AdjustmentTable.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost)
	|			THEN 0
	|		WHEN TRUE
	|			THEN CAST(AdjustmentTable.Count
	|			* ISNULL(ReturnOfGoodsCost.Cost, ISNULL(GoodsCost.Cost, 0)) AS NUMBER(31,2))
	|			- AdjustmentTable.Cost
	|	END) AS Cost,
	|
	|	(CASE
	|		WHEN AdjustmentTable.CostDefiningMethod IN (
	|			VALUE(Enum.WaysToCalculateInventoryCost.FromDocument),
	|			VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage),
	|		 	VALUE(Enum.WaysToCalculateInventoryCost.BySourceDocumentRegisterRecords))
	|		  AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|		  AND AdjustmentTable.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|			THEN 0
	|		WHEN TRUE
	|			THEN CAST(AdjustmentTable.Count
	|		* ISNULL(ReturnOfGoodsCost.OffBalanceCost, ISNULL(GoodsCost.OffBalanceCost, 0)) AS NUMBER(31,2))
	|		- AdjustmentTable.OffBalanceCost
	|	END) AS OffBalanceCost,
	|
	|	(CASE
	|		WHEN AdjustmentTable.CostDefiningMethod IN (
	|			VALUE(Enum.WaysToCalculateInventoryCost.FromDocument),
	|			VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage),
	|		 	VALUE(Enum.WaysToCalculateInventoryCost.BySourceDocumentRegisterRecords))
	|		  AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|		  AND AdjustmentTable.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|			THEN 0
	|		WHEN AdjustmentTable.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffForExpensesFixedCost)
	|			THEN 0
