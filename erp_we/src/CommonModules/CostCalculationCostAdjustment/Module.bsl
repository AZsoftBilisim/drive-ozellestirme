	|	
	|DROP TTAdjustmentTableWithoutIDs_Preliminary;
	|
	|SELECT
	|	T.Period AS Period,
	|	T.RecordType AS RecordType,
	|	T.DocumentRegisterRecords AS DocumentRegisterRecords,
	|	T.Organization AS Organization,
	|	T.ProductionLot AS ProductionLot,
	|	T.ProductionOrder AS ProductionOrder,
	|	T.RowCodeProducts AS RowCodeProducts,
	|	T.Stage AS Stage,
	|	T.ProductCostElement AS ProductCostElement,
	|	T.ProductsAccountingDimension AS ProductsAccountingDimension,
	|	T.ManufacturedProduct AS ManufacturedProduct,
	|	T.ItemVariant AS ItemVariant,
	|	T.AccountingSection AS AccountingSection,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.ProductsGroup AS ProductsGroup,
	|	T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|	MAX(T.FinRecordID) AS FinRecordID
	|INTO IDsByAdjustmentTableFields
	|FROM
	|	(SELECT
	|		TRUE AS NewMovement,
	|		T.Period AS Period,
	|		T.RecordType AS RecordType,
	|		T.DocumentRegisterRecords AS DocumentRegisterRecords,
	|		T.Organization AS Organization,
	|		T.ProductionLot AS ProductionLot,
	|		T.ProductionOrder AS ProductionOrder,
	|		T.RowCodeProducts AS RowCodeProducts,
	|		CASE WHEN VALUETYPE(T.Stage) = TYPE(Catalog.ProductionStages)
	|			THEN T.Stage
	|			ELSE VALUE(Catalog.ProductionStages.EmptyRef)
	|		END AS Stage,
	|		CASE WHEN VALUETYPE(T.ProductCostElement) = TYPE(Catalog.ProductCostElements)
	|			THEN T.ProductCostElement
	|			ELSE VALUE(Catalog.ProductCostElements.EmptyRef)
	|		END AS ProductCostElement,
	|		CASE WHEN VALUETYPE(T.ProductsAccountingDimension) = TYPE(Catalog.InventoryLocationAttributeKeys)
	|			THEN T.ProductsAccountingDimension
	|			ELSE VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
	|		END AS ProductsAccountingDimension,
	|		CASE WHEN VALUETYPE(T.ManufacturedProduct) = TYPE(Catalog.Products)
	|			THEN T.ManufacturedProduct
	|			ELSE VALUE(Catalog.Products.EmptyRef)
	|		END AS ManufacturedProduct,
	|		CASE WHEN VALUETYPE(T.ItemVariant) = TYPE(Catalog.ItemsCharacteristics)
	|			THEN T.ItemVariant
	|			ELSE VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|		END AS ItemVariant,
	|		CASE WHEN VALUETYPE(T.AccountingSection) = TYPE(Enum.SectionsOfInventoryCostAccounting)
	|			THEN T.AccountingSection
	|			ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|		END AS AccountingSection,
	|		T.Department AS Department,
	|		CASE WHEN VALUETYPE(T.LineOfBusiness) = TYPE(Catalog.LinesOfBusiness)
	|			THEN T.LineOfBusiness
	|			ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|		END AS LineOfBusiness,
	|		T.DimensionOfExpenses AS DimensionOfExpenses,
	|		CASE WHEN VALUETYPE(T.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	|			THEN T.ExpenseItem
	|			ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|		END AS ExpenseItem,
	|		CASE WHEN VALUETYPE(T.ProductsGroup) = TYPE(Catalog.AnalyticalInventoryGroups)
	|			THEN T.ProductsGroup
	|			ELSE VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|		END AS ProductsGroup,
	|		CASE WHEN VALUETYPE(T.RuleOfCostAllocatingToProductionLots) = TYPE(Enum.RulesOfCostAllocationToProductCost)
	|			THEN T.RuleOfCostAllocatingToProductionLots
	|			ELSE VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef)
	|		END AS RuleOfCostAllocatingToProductionLots,
	|		"""" AS FinRecordID
	|	FROM
	|		TTAdjustmentTableWithoutIDs AS T
	|	WHERE
	|		T.RecordType = VALUE(AccumulationRecordType.Receipt)
	|
	|	UNION ALL
	|	
	|	SELECT
	|		FALSE AS NewMovement,
	|		T.Period AS Period,
	|		T.RecordType AS RecordType,
	|		T.Recorder AS DocumentRegisterRecords,
	|		T.Organization AS Organization,
	|		T.ProductionLot AS ProductionLot,
	|		T.ProductionOrder AS ProductionOrder,
	|		T.RowCodeProducts AS RowCodeProducts,
	|		T.Stage AS Stage,
	|		T.ProductCostElement AS ProductCostElement,
	|		T.ProductsAccountingDimension AS ProductsAccountingDimension,
	|		T.ManufacturedProduct AS ManufacturedProduct,
	|		T.ItemVariant AS ItemVariant,
	|		T.AccountingSection AS AccountingSection,
	|		T.Department AS Department,
	|		CASE WHEN VALUETYPE(T.Recorder) <> TYPE(Document.AllocationOfOtherCosts)
	|			THEN T.LineOfBusiness
	|			ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|		END AS LineOfBusiness,
	|		T.DimensionOfExpenses AS DimensionOfExpenses,
	|		T.ExpenseItem AS ExpenseItem,
	|		T.ProductsGroup AS ProductsGroup,
	|		T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|		T.FinRecordID FinRecordID
	|	FROM
	|		AccumulationRegister.OtherWorkInProgressExpenses AS T
	|	WHERE
	|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND T.Organization IN (&CompanyArray)
	|		AND T.Active
	|		AND T.RecordType = VALUE(AccumulationRecordType.Receipt)
	|		AND T.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.ProductsRelease)
	|) AS T
	|
	|GROUP BY
	|	T.Period,
	|	T.RecordType,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.ProductionLot,
	|	T.ProductionOrder,
	|	T.RowCodeProducts,
	|	T.Stage,
	|	T.ProductCostElement,
	|	T.ProductsAccountingDimension,
	|	T.ManufacturedProduct,
	|	T.ItemVariant,
	|	T.AccountingSection,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.DimensionOfExpenses,
	|	T.ExpenseItem,
	|	T.ProductsGroup,
	|	T.RuleOfCostAllocatingToProductionLots
	|HAVING
	|	MAX(T.NewMovement) = TRUE
	|	AND MAX(T.FinRecordID) <> """"
	|INDEX BY
	|	DocumentRegisterRecords,
	|	ProductionLot,
	|	ExpenseItem,
	|	Department
	|;
	|
	|SELECT
	|	RECORDAUTONUMBER() AS RecNo,
	|	T.Period AS Period,
	|	T.RecordType AS RecordType,
	|	T.DocumentRegisterRecords AS DocumentRegisterRecords,
	|	T.Organization AS Organization,
	|	T.ProductionLot AS ProductionLot,
	|	T.Lot AS Lot,
	|	T.LotVendorAttributes AS LotVendorAttributes,
	|	T.ArticleOfCostCalculation AS ArticleOfCostCalculation,
	|	T.CostProductionGroup AS CostProductionGroup,
	|	T.RuleOfAttributionToIssueOfValue AS RuleOfAttributionToIssueOfValue,
	|	T.ProductionOrder AS ProductionOrder,
	|	T.RowCodeProducts AS RowCodeProducts,
	|	T.LineCodeOutputForValue AS LineCodeOutputForValue,
	|	T.Stage AS Stage,
	|	T.ProductCostElement AS ProductCostElement,
	|	T.ProductsAccountingDimension AS ProductsAccountingDimension,
	|	T.LotVendorAttributesCorr AS LotVendorAttributesCorr,
	|	T.AccountingSection AS AccountingSection,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CAST(T.InventoryOwnerAttribute AS Catalog.InventoryKinds).InventoryType AS InventoryType,
	|	T.Purpose AS Purpose,
	|	VALUE(Enum.BusinessTransactions.ProductsRelease) AS BusinessOperation,
	|	T.Department AS Department,
	|	T.DivisionOfValue AS DivisionOfValue,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.CorLineOfBusiness AS CorLineOfBusiness,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DirectCostsLocal AS DirectCostsLocal,
	|	T.DirectCostsTA AS DirectCostsTA,
	|	T.AcceptedVNU AS AcceptedVNU,
	|	T.ManufacturedProduct AS ManufacturedProduct,
	|	T.ItemVariant AS ItemVariant,
	|	T.ProductsGroup AS ProductsGroup,
	|	T.VATActivityType AS VATActivityType,
	|	T.CostAccountingSection AS CostAccountingSection,
	|	T.DocumentOfProductionIssue AS DocumentOfProductionIssue,
	|	T.ReleaseLotDimension AS ReleaseLotDimension,
	|	T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|	T.CostShare AS CostShare,
	|	T.Count AS Count,
	|	T.QuantityWithoutVAT AS QuantityWithoutVAT,
	|	T.NumberOfLocal AS NumberOfLocal,
	|	T.NumberOfTA AS NumberOfTA,
	|	T.NumberOfMen AS NumberOfMen,
	|	T.NumberOfPersonalData,
	|	ISNULL(IDs.FinRecordID, """") AS FinRecordID
	|INTO TTAdjustmentTable
	|FROM
	|	TTAdjustmentTableWithoutIDs AS T
	|	LEFT JOIN IDsByAdjustmentTableFields AS IDs
	|		 ON T.Period = IDs.Period
	|		 AND T.RecordType = IDs.RecordType
	|		 AND T.DocumentRegisterRecords = IDs.DocumentRegisterRecords
	|		 AND T.Organization = IDs.Organization
	|		 AND T.ProductionLot = IDs.ProductionLot
	|		 AND T.ProductionOrder = IDs.ProductionOrder
	|		 AND T.RowCodeProducts = IDs.RowCodeProducts
	|		 AND CASE WHEN VALUETYPE(T.Stage) = TYPE(Catalog.ProductionStages)
	|			THEN T.Stage
	|			ELSE VALUE(Catalog.ProductionStages.EmptyRef)
	|		  END = IDs.Stage
	|		 AND CASE WHEN VALUETYPE(T.ProductCostElement) = TYPE(Catalog.ProductCostElements)
	|			THEN T.ProductCostElement
	|			ELSE VALUE(Catalog.ProductCostElements.EmptyRef)
	|		  END = IDs.ProductCostElement
	|		 AND CASE WHEN VALUETYPE(T.ProductsAccountingDimension) = TYPE(Catalog.InventoryLocationAttributeKeys)
	|			THEN T.ProductsAccountingDimension
	|			ELSE VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
	|		  END = IDs.ProductsAccountingDimension
	|		 AND CASE WHEN VALUETYPE(T.ManufacturedProduct) = TYPE(Catalog.Products)
	|			THEN T.ManufacturedProduct
	|			ELSE VALUE(Catalog.Products.EmptyRef)
	|		  END = IDs.ManufacturedProduct
	|		 AND CASE WHEN VALUETYPE(T.ItemVariant) = TYPE(Catalog.ItemsCharacteristics)
	|			THEN T.ItemVariant
	|			ELSE VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	|		  END = IDs.ItemVariant
	|		 AND CASE WHEN VALUETYPE(T.AccountingSection) = TYPE(Enum.SectionsOfInventoryCostAccounting)
	|			THEN T.AccountingSection
	|			ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
	|		  END = IDs.AccountingSection
	|		 AND T.Department = IDs.Department
	|		 AND CASE WHEN VALUETYPE(T.LineOfBusiness) = TYPE(Catalog.LinesOfBusiness)
	|			THEN T.LineOfBusiness
	|			ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|		  END = IDs.LineOfBusiness
	|		 AND T.DimensionOfExpenses = IDs.DimensionOfExpenses
	|		 AND T.ExpenseItem = IDs.ExpenseItem
	|		 AND CASE WHEN VALUETYPE(T.ProductsGroup) = TYPE(Catalog.AnalyticalInventoryGroups)
	|			THEN T.ProductsGroup
	|			ELSE VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|		  END = IDs.ProductsGroup
	|		 AND CASE WHEN VALUETYPE(T.RuleOfCostAllocatingToProductionLots) = TYPE(Enum.RulesOfCostAllocationToProductCost)
	|			THEN T.RuleOfCostAllocatingToProductionLots
	|			ELSE VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef)
	|		  END = IDs.RuleOfCostAllocatingToProductionLots
	|INDEX BY
	|	Organization,
	|	DivisionOfValue,
	|	ExpenseItem,
	|	DimensionOfExpenses
	|;
	|
	|SELECT
	|	T.RecNo
	|FROM
	|	TTAdjustmentTable AS T
	|WHERE
	|	T.FinRecordID = """"
	|";
	#EndRegion
	
	IDsTable = New ValueTable;
	IDsTable.Columns.Add("Id", Common.StringTypeDetails(36));
	IDsTable.Columns.Add("RecNo", Common.TypeDescriptionNumber(31));
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	While Selection.Next() Do
		NewRow = IDsTable.Add();
		NewRow.Id = New UUID;
		NewRow.RecNo = Selection.RecNo;
	EndDo;
	
	Query.SetParameter("IDsTable", IDsTable);
	
	#Region TTTimeAdjustmentTable
	Query.Text = "
	|SELECT
	|	IDsTable.Id AS Id,
	|	IDsTable.RecNo AS RecNo
	|INTO IDsTable
	|FROM
	|	&IDsTable AS IDsTable
	|INDEX BY
	|	RecNo
	|;
	|SELECT
	|	AdjustmentTable.Period AS Period,
	|	AdjustmentTable.RecordType AS RecordType,
	|	AdjustmentTable.DocumentRegisterRecords AS DocumentRegisterRecords,
	|	AdjustmentTable.Organization AS Organization,
	|	AdjustmentTable.ProductionLot AS ProductionLot,
	|	AdjustmentTable.ProductionOrder AS ProductionOrder,
	|	AdjustmentTable.RowCodeProducts AS RowCodeProducts,
	|	AdjustmentTable.Stage AS Stage,
	|	AdjustmentTable.ProductCostElement AS ProductCostElement,
	|	AdjustmentTable.ProductsAccountingDimension AS ProductsAccountingDimension,
	|	AdjustmentTable.ProductsAccountingDimension AS ProductAccountingAnalyticsCost,
	|	AdjustmentTable.LotVendorAttributesCorr AS LotVendorAttributesCorr,
	|	AdjustmentTable.ManufacturedProduct AS ManufacturedProduct,
	|	AdjustmentTable.ItemVariant AS ItemVariant,
	|	AdjustmentTable.AccountingSection AS AccountingSection,
	|	ISNULL(Releases.InventoryOwnerAttribute, AdjustmentTable.InventoryOwnerAttribute) AS InventoryOwnerAttribute,
	|	ISNULL(Releases.Lot, UNDEFINED) AS Lot,
	|	ISNULL(Releases.LotVendorAttributes, UNDEFINED) AS LotVendorAttributes,
	|	ISNULL(Releases.FinancialAccountingDimension, UNDEFINED) AS FinancialAccountingDimension,
	|	ISNULL(Releases.VATActivityType, UNDEFINED) AS VATActivityType,
	|	ISNULL(AdjustmentTable.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)) AS InventoryType,
	|	AdjustmentTable.BusinessOperation AS BusinessOperation,
	|	AdjustmentTable.Department AS Department,
	|	AdjustmentTable.LineOfBusiness AS LineOfBusiness,
	|	AdjustmentTable.CorLineOfBusiness AS CorLineOfBusiness,
	|	AdjustmentTable.DimensionOfExpenses AS DimensionOfExpenses,
	|	AdjustmentTable.ExpenseItem AS ExpenseItem,
	|	AdjustmentTable.ProductsGroup AS ProductsGroup,
	|	AdjustmentTable.DivisionOfValue AS SourceDivision,
	|	AdjustmentTable.Department AS DebitBusinessUnit,
	|	AdjustmentTable.ReleaseLotDimension AS ReleaseLotDimension,
	|	AdjustmentTable.DocumentOfProductionIssue AS DocumentOfProductionIssue,
	|	AdjustmentTable.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|	AdjustmentTable.NumberOfLocal AS AllocationBase,
	|	AdjustmentTable.CostShare AS CostShare,
	|	AdjustmentTable.Count AS Count,
	|
	|	CAST(
	|		CAST(AdjustmentTable.Count AS NUMBER(23,10))
	|			* ISNULL(Costs_2.Cost, 0) AS NUMBER(31,2)) AS Cost,
	|
	|	CAST(
	|		CAST(AdjustmentTable.QuantityWithoutVAT AS NUMBER(23,10))
	|			* ISNULL(Costs_2.CostExcludingVAT, 0) AS NUMBER(31,2)) AS CostExcludingVAT,
	|
	|	CAST(
	|		CAST(AdjustmentTable.Count AS NUMBER(23,10))
	|			* ISNULL(Costs_2.AdditionalExpenseCost, 0) AS NUMBER(31,2)) AS AddExpensesForGoods,
	|
	|	CAST(
	|		CAST(AdjustmentTable.QuantityWithoutVAT AS NUMBER(23,10))
	|			* ISNULL(Costs_2.AdditionalExpensesCostExcludingVAT, 0) AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
	|
	|	0 AS PermanentDifference,
	|
	|	0 AS CostTD,
	|
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfPersonalData AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.CostOfPersonalIncomeTax, 0)AS NUMBER(31,2)) AS CostOfPersonalIncomeTax,
	|
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.LocalCost, 0) AS NUMBER(31,2)) AS LocalCost,
	|
	|	CAST(
	|		AdjustmentTable.Count
	|			* ISNULL(Costs_2.OffBalanceCost, 0) AS NUMBER(31,2)) 		AS OffBalanceCost,
	|	CAST(
	|		CAST(AdjustmentTable.Count AS NUMBER(23,10))
	|			* ISNULL(Costs_2.LaborCosts, 0) AS NUMBER(31,2)) 					AS LaborCosts,
	|	CAST(
	|		CAST(AdjustmentTable.Count AS NUMBER(23,10))
	|			* CAST(ISNULL(Costs_2.ItemizedFixedCostsIncludingVAT, 0) AS NUMBER(23,10)) AS NUMBER(31,2)) 	AS ItemizedFixedCostsIncludingVAT,
	|	CAST(
	|		CAST(AdjustmentTable.QuantityWithoutVAT AS NUMBER(23,10))
	|			* CAST(ISNULL(Costs_2.ItemizedFixedCostsExcludingVAT, 0) AS NUMBER(23,10)) AS NUMBER(31,2)) 	AS ItemizedFixedCostsExcludingVAT,
	|	CAST(
	|		CAST(AdjustmentTable.Count AS NUMBER(23,10))
	|			* CAST(ISNULL(Costs_2.ItemizedVariableCostsIncludingVAT, 0) AS NUMBER(23,10)) AS NUMBER(31,2)) 	AS ItemizedVariableCostsIncludingVAT,
	|	CAST(
	|		CAST(AdjustmentTable.QuantityWithoutVAT AS NUMBER(23,10))
	|			* CAST(ISNULL(Costs_2.ItemizedVariableCostsExcludingVAT, 0) AS NUMBER(23,10)) AS NUMBER(31,2)) 	AS ItemizedVariableCostsExcludingVAT,
	|
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.OffBalanceCostLocal, 0) AS NUMBER(31,2)) AS OffBalanceCostLocal,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.AddExpensesLocal, 0) AS NUMBER(31,2)) 			AS AddExpensesLocal,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.LaborCostsLocal, 0) AS NUMBER(31,2)) 			AS LaborCostsLocal,
	|	CAST(
	|		CAST(AdjustmentTable.QuantityWithoutVAT AS NUMBER(23,10))
	|			* ISNULL(Costs_2.LaborCostsWithoutVAT, 0) AS NUMBER(31,2)) 			AS LaborCostsWithoutVAT,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* CASE
	|			WHEN NOT AdjustmentTable.DirectCostsLocal AND AdjustmentTable.DirectCostsTA
	|				THEN 0
	|			ELSE 
	|				CAST(ISNULL(LocalCosts.ItemizedFixedCostsCompl, 0) AS NUMBER(23,10)) END
	|	AS NUMBER(31,2)) AS ItemizedFixedCostsCompl,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* CASE
	|			WHEN NOT AdjustmentTable.DirectCostsLocal AND AdjustmentTable.DirectCostsTA
	|				THEN 0
	|			ELSE 
	|				CAST(ISNULL(LocalCosts.ItemizedVariableCostsCompl, 0) AS NUMBER(23,10)) END
	|	AS NUMBER(31,2)) AS ItemizedVariableCostsCompl,
	|
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfLocal AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.ReserveLocal, 0) AS NUMBER(31,2)) 				AS ReserveLocal,
	|
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfMen AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.CostMan, 0) AS NUMBER(31,2))				AS CostMan,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfMen AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.AddExpensesMan, 0) AS NUMBER(31,2)) 			AS AddExpensesMan,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfMen AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.LaborCostsMan, 0) AS NUMBER(31,2)) 			AS LaborCostsMan,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfMen AS NUMBER(23,10))
	|			* CAST(ISNULL(LocalCosts.ItemizedFixedCostsManag, 0) AS NUMBER(23,10)) AS NUMBER(31,2))	AS ItemizedFixedCostsManag,
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfMen AS NUMBER(23,10))
	|			* CAST(ISNULL(LocalCosts.ItemizedVariableCostsManag, 0) AS NUMBER(23,10)) AS NUMBER(31,2))	AS ItemizedVariableCostsManag,
	|
	|	CAST(
	|		CAST(AdjustmentTable.NumberOfMen AS NUMBER(23,10))
	|			* ISNULL(LocalCosts.ReserveMan, 0) AS NUMBER(31,2)) 				AS ReserveMan,
	|
	|	CASE
	|		WHEN AdjustmentTable.RecordType = VALUE(AccumulationRecordType.Expense)
	|			AND NOT (ISNULL(Costs_2.Cost, 0) = 0
	|					AND ISNULL(Costs_2.CostExcludingVAT, 0) = 0
	|					AND ISNULL(Costs_2.AdditionalExpenseCost, 0) = 0
	|					AND ISNULL(Costs_2.AdditionalExpensesCostExcludingVAT, 0) = 0
	|					AND ISNULL(Costs_2.LaborCosts, 0) = 0
	|					AND ISNULL(Costs_2.ItemizedFixedCostsIncludingVAT, 0) = 0
	|					AND ISNULL(Costs_2.ItemizedFixedCostsExcludingVAT, 0) = 0
	|					AND ISNULL(Costs_2.ItemizedVariableCostsIncludingVAT, 0) = 0
	|					AND ISNULL(Costs_2.ItemizedVariableCostsExcludingVAT, 0) = 0
	|					AND ISNULL(Costs_2.LaborCostsWithoutVAT, 0) = 0
	|					AND ISNULL(LocalCosts.CostMan, 0) = 0
	|					AND ISNULL(LocalCosts.AddExpensesMan, 0) = 0
	|					AND ISNULL(LocalCosts.LaborCostsMan, 0) = 0
	|					AND ISNULL(LocalCosts.ItemizedFixedCostsManag, 0) = 0
	|					AND ISNULL(LocalCosts.ItemizedVariableCostsManag, 0) = 0
	|					AND ISNULL(LocalCosts.ItemizedVariableCostsCompl, 0) = 0
	|					AND ISNULL(LocalCosts.ItemizedFixedCostsCompl, 0) = 0
	|					AND ISNULL(LocalCosts.LaborCostsLocal, 0) = 0
	|					AND ISNULL(LocalCosts.AddExpensesLocal, 0) = 0
	|					AND ISNULL(LocalCosts.CostInTaxAccounting, 0) = 0
	|					AND ISNULL(LocalCosts.PermanentDifference, 0) = 0
	
	|					AND ISNULL(LocalCosts.CostOfPersonalIncomeTax, 0) = 0
	|					AND ISNULL(LocalCosts.LocalCost, 0) = 0
	|					AND ISNULL(Costs_2.OffBalanceCost, 0) = 0
	|					AND ISNULL(LocalCosts.OffBalanceCostLocal, 0) = 0)
	|			THEN TRUE
	|		ELSE
	|			FALSE
	|	END AS IsExpense,
	|	(CASE
	|		WHEN AdjustmentTable.RecordType = VALUE(AccumulationRecordType.Expense)
	|			THEN VALUE(Catalog.BusinessTransactionsSettings.ProductsReleaseItemized)
	|		ELSE BsnsTransactionsSettings.Ref END) AS BusinessTransactionSetting,
	|	ISNULL(Releases.FinRecordID,
	|		ISNULL(IDsTable.Id, AdjustmentTable.FinRecordID)) AS FinRecordID
	|
	|INTO TTTimeAdjustmentTable
	|
	|FROM
	|	TTAdjustmentTable AS AdjustmentTable
	|	LEFT JOIN TTIssues AS Releases
	|		ON Releases.Recorder = AdjustmentTable.DocumentRegisterRecords
	|		AND Releases.ItemsLocationAttributes = AdjustmentTable.ProductsAccountingDimension
	|		AND Releases.AccountingSection = AdjustmentTable.AccountingSection
	|		AND Releases.LotVendorAttributes = AdjustmentTable.LotVendorAttributesCorr
	|		AND Releases.InventoryOwnerAttribute = AdjustmentTable.InventoryOwnerAttribute
	|		AND (Releases.VATActivityType = AdjustmentTable.VATActivityType
	|			OR AdjustmentTable.VATActivityType = UNDEFINED)
	|		
	|	LEFT JOIN
	|		TTValueOfWorkInProgress AS Costs_2
	|	ON 
	|		AdjustmentTable.Lot = Costs_2.Lot
	|		AND AdjustmentTable.LotVendorAttributes = Costs_2.LotVendorAttributes
	|		AND AdjustmentTable.ExpenseItem = Costs_2.ExpenseItem
	|		AND AdjustmentTable.DimensionOfExpenses = Costs_2.DimensionOfExpenses
	|		AND AdjustmentTable.DivisionOfValue = Costs_2.Department
	|		AND AdjustmentTable.Stage = Costs_2.Stage
	|		AND AdjustmentTable.Organization = Costs_2.Organization
	|		AND AdjustmentTable.LineOfBusiness = Costs_2.LineOfBusiness
	|		AND AdjustmentTable.ArticleOfCostCalculation = Costs_2.ProductCostElement
	|		AND AdjustmentTable.CostProductionGroup = Costs_2.ProductsGroup
	|		AND AdjustmentTable.RuleOfAttributionToIssueOfValue = Costs_2.RuleOfCostAllocatingToProductionLots
	|		AND AdjustmentTable.LineCodeOutputForValue = Costs_2.RowCodeProducts
	|		AND AdjustmentTable.CostAccountingSection = Costs_2.AccountingSection
	|		
	|	LEFT JOIN
	|		TTValueOfWorkInProgressLocal AS LocalCosts
	|	ON 
	|		AdjustmentTable.Lot = LocalCosts.Lot
	|		AND AdjustmentTable.LotVendorAttributes = LocalCosts.LotVendorAttributes
	|		AND AdjustmentTable.ExpenseItem = LocalCosts.ExpenseItem
	|		AND AdjustmentTable.DimensionOfExpenses = LocalCosts.DimensionOfExpenses
	|		AND AdjustmentTable.DivisionOfValue = LocalCosts.Department
	|		AND AdjustmentTable.Stage = LocalCosts.Stage
	|		AND AdjustmentTable.Organization = LocalCosts.Organization
	|		AND AdjustmentTable.LineOfBusiness = LocalCosts.LineOfBusiness
	|		AND AdjustmentTable.ArticleOfCostCalculation = LocalCosts.ProductCostElement
	|		AND AdjustmentTable.CostProductionGroup = LocalCosts.ProductsGroup
	|		AND AdjustmentTable.RuleOfAttributionToIssueOfValue = LocalCosts.RuleOfCostAllocatingToProductionLots
	|		AND AdjustmentTable.LineCodeOutputForValue = LocalCosts.RowCodeProducts
	|		AND AdjustmentTable.CostAccountingSection = LocalCosts.AccountingSection
	|
	|	LEFT JOIN
	|		Catalog.Assignments AS CatAssignments
	|	ON
	|		AdjustmentTable.Purpose = CatAssignments.Ref
	|
	|	LEFT JOIN IDsTable AS IDsTable
	|		ON IDsTable.RecNo = AdjustmentTable.RecNo
	|
	|	LEFT JOIN Catalog.BusinessTransactionsSettings AS BsnsTransactionsSettings
	|		ON BsnsTransactionsSettings.BusinessOperation = AdjustmentTable.BusinessOperation
	|WHERE
	|	AdjustmentTable.Count <> 0
	|	OR AdjustmentTable.QuantityWithoutVAT <> 0	
	|	OR AdjustmentTable.NumberOfLocal <> 0	
	|	OR AdjustmentTable.NumberOfTA <> 0	
	|	OR AdjustmentTable.NumberOfMen <> 0	
	|	OR AdjustmentTable.NumberOfPersonalData <> 0
	|;";
	#EndRegion
	
	#Region MovementErrors_
	Query.Text = Query.Text + "
	|SELECT
	|	AdjustmentTable.Period,
	|	AdjustmentTable.Organization,
	|	AdjustmentTable.ProductAccountingAnalyticsCost,
	|	AdjustmentTable.AccountingSection,
	|	AdjustmentTable.InventoryOwnerAttribute,
	|	AdjustmentTable.Lot,
	|	AdjustmentTable.LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType,
	|	SUM(AdjustmentTable.Count),
	|	CAST(SUM(AdjustmentTable.ItemizedFixedCostsIncludingVAT
	|	   	- CAST(AdjustmentTable.ItemizedFixedCostsIncludingVAT AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedFixedCostsIncludingVAT,
	|	CAST(SUM(AdjustmentTable.ItemizedFixedCostsExcludingVAT
	|	   	- CAST(AdjustmentTable.ItemizedFixedCostsExcludingVAT AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedFixedCostsExcludingVAT,
	|	CAST(SUM(AdjustmentTable.ItemizedVariableCostsIncludingVAT
	|	   	- CAST(AdjustmentTable.ItemizedVariableCostsIncludingVAT AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedVariableCostsIncludingVAT,
	|	CAST(SUM(AdjustmentTable.ItemizedVariableCostsExcludingVAT
	|	   	- CAST(AdjustmentTable.ItemizedVariableCostsExcludingVAT AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedVariableCostsExcludingVAT,
	|	CAST(SUM(AdjustmentTable.ItemizedFixedCostsCompl
	|	   	- CAST(AdjustmentTable.ItemizedFixedCostsCompl AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedFixedCostsCompl,
	|	CAST(SUM(AdjustmentTable.ItemizedVariableCostsCompl
	|	   	- CAST(AdjustmentTable.ItemizedVariableCostsCompl AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedVariableCostsCompl,
	|	CAST(SUM(AdjustmentTable.ItemizedFixedCostsManag
	|	   	- CAST(AdjustmentTable.ItemizedFixedCostsManag AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedFixedCostsManag,
	|	CAST(SUM(AdjustmentTable.ItemizedVariableCostsManag
	|	   	- CAST(AdjustmentTable.ItemizedVariableCostsManag AS NUMBER(31,2))) AS NUMBER(31, 2))  AS ItemizedVariableCostsManag,
	|	CAST(SUM(AdjustmentTable.CostOfPersonalIncomeTax
	|		- CAST(AdjustmentTable.CostOfPersonalIncomeTax AS NUMBER(31,2))) AS NUMBER(31, 2)) AS CostOfPersonalIncomeTax
	|INTO RoundingErrors_
	|FROM
	|	TTTimeAdjustmentTable AS AdjustmentTable
	|WHERE
	|	AdjustmentTable.Count <> 0
	|	AND AdjustmentTable.RecordType = VALUE(AccumulationRecordType.Expense)
	|	AND NOT (CAST(AdjustmentTable.ItemizedFixedCostsIncludingVAT
	|	   		- CAST(AdjustmentTable.ItemizedFixedCostsIncludingVAT AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0 
	|		AND CAST(AdjustmentTable.ItemizedFixedCostsExcludingVAT
	|	   		- CAST(AdjustmentTable.ItemizedFixedCostsExcludingVAT AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedVariableCostsIncludingVAT
	|	   		- CAST(AdjustmentTable.ItemizedVariableCostsIncludingVAT AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedVariableCostsExcludingVAT
	|	   		- CAST(AdjustmentTable.ItemizedVariableCostsExcludingVAT AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedFixedCostsIncludingVAT
	|	   		- CAST(AdjustmentTable.ItemizedFixedCostsIncludingVAT AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedFixedCostsCompl
	|	   		- CAST(AdjustmentTable.ItemizedFixedCostsCompl AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedVariableCostsCompl
	|	   		- CAST(AdjustmentTable.ItemizedVariableCostsCompl AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedFixedCostsManag
	|	   		- CAST(AdjustmentTable.ItemizedFixedCostsManag AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.ItemizedVariableCostsManag
	|	   		- CAST(AdjustmentTable.ItemizedVariableCostsManag AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		AND CAST(AdjustmentTable.CostOfPersonalIncomeTax
	|			- CAST(AdjustmentTable.CostOfPersonalIncomeTax AS NUMBER(31,2)) AS NUMBER(31, 2)) = 0
	|		)
	|
	|GROUP BY
	|	AdjustmentTable.Period,
	|	AdjustmentTable.Organization,
	|	AdjustmentTable.ProductAccountingAnalyticsCost,
	|	AdjustmentTable.AccountingSection,
	|	AdjustmentTable.InventoryOwnerAttribute,
	|	AdjustmentTable.Lot,
	|	AdjustmentTable.LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType
	|;
	|
	|SELECT
	|	T.Period,
	|	T.RecordType,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.ProductionLot,
	|	T.ProductionOrder,
	|	T.RowCodeProducts,
	|	T.Stage,
	|	T.ProductCostElement,
	|	T.ProductsAccountingDimension,
	|	T.ProductAccountingAnalyticsCost,
	|	T.LotVendorAttributesCorr,
	|	T.ManufacturedProduct,
	|	T.ItemVariant,
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.InventoryType,
	|	T.BusinessOperation,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.CorLineOfBusiness,
	|	T.DimensionOfExpenses,
	|	T.ExpenseItem,
	|	T.ProductsGroup,
	|	T.SourceDivision,
	|	T.DebitBusinessUnit,
	|	T.ReleaseLotDimension,
	|	T.DocumentOfProductionIssue,
	|	T.RuleOfCostAllocatingToProductionLots,
	|	T.AllocationBase,
	|	T.CostShare,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	SUM(T.Count) AS Count
	|INTO ErrorReceivers
	|FROM
	|	TTTimeAdjustmentTable AS T
	|		LEFT JOIN RoundingErrors_ AS Errors_
	|		ON Errors_.Organization = T.Organization
	|			AND Errors_.ProductAccountingAnalyticsCost = T.ProductAccountingAnalyticsCost 
	|			AND Errors_.AccountingSection = T.AccountingSection
	|			AND Errors_.InventoryOwnerAttribute = T.InventoryOwnerAttribute
	|			AND Errors_.Lot = T.Lot
	|			AND Errors_.LotVendorAttributes = T.LotVendorAttributes
	|			AND Errors_.FinancialAccountingDimension = T.FinancialAccountingDimension
	|			AND Errors_.VATActivityType = T.VATActivityType
	|WHERE
	|	T.RecordType = VALUE(AccumulationRecordType.Expense)	
	|	AND NOT Errors_.Organization IS NULL
	|
	|GROUP BY
	|	T.Period,
	|	T.RecordType,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.ProductionLot,
	|	T.ProductionOrder,
	|	T.RowCodeProducts,
	|	T.Stage,
	|	T.ProductCostElement,
	|	T.ProductsAccountingDimension,
	|	T.ProductAccountingAnalyticsCost,
	|	T.LotVendorAttributesCorr,
	|	T.ManufacturedProduct,
	|	T.ItemVariant,
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.InventoryType,
	|	T.BusinessOperation,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.CorLineOfBusiness,
	|	T.DimensionOfExpenses,
	|	T.ExpenseItem,
	|	T.ProductsGroup,
	|	T.SourceDivision,
	|	T.DebitBusinessUnit,
	|	T.ReleaseLotDimension,
	|	T.DocumentOfProductionIssue,
	|	T.RuleOfCostAllocatingToProductionLots,
	|	T.AllocationBase,
	|	T.CostShare,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|;";
	#EndRegion
	
	#Region AnalystsOfExpenditureRegisteredRecordsOfItemByItemExpenses
	Query.Text = Query.Text + "
	|SELECT DISTINCT
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ProductionLot AS ProductionLot,
	|	T.ProductionOrder AS ProductionOrder,
	|	T.RowCodeProducts AS RowCodeProducts,
	|	T.Stage AS Stage,
	|	T.ProductCostElement AS ProductCostElement,
	|	T.ProductsGroup AS ProductsGroup,
	|	T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots
	|
	|INTO AnalystsOfExpenditureRegisteredRecordsOfItemByItemExpenses
	|FROM (
	|	SELECT
	|		AdjustmentTable.Organization				AS Organization,
	|		AdjustmentTable.Department				AS Department,
	|		AdjustmentTable.ExpenseItem				AS ExpenseItem,
	|		AdjustmentTable.DimensionOfExpenses			AS DimensionOfExpenses,
	|		AdjustmentTable.LineOfBusiness	AS LineOfBusiness,
	|		AdjustmentTable.ProductionLot			AS ProductionLot,
	|		AdjustmentTable.ProductionOrder		AS ProductionOrder,
	|		AdjustmentTable.RowCodeProducts			AS RowCodeProducts,
	|		AdjustmentTable.Stage						AS Stage,
	|		AdjustmentTable.ProductCostElement			AS ProductCostElement,
	|		AdjustmentTable.ProductsGroup			AS ProductsGroup,
	|		AdjustmentTable.RuleOfCostAllocatingToProductionLots	AS RuleOfCostAllocatingToProductionLots
	|
	|	FROM
	|		TTTimeAdjustmentTable AS AdjustmentTable
	|	WHERE
	|		AdjustmentTable.IsExpense
	|
	|	UNION ALL
	|
	|	SELECT
	|		OtherExpensesOfUnfinishedProduction.Organization				AS Organization,
	|		OtherExpensesOfUnfinishedProduction.Department				AS Department,
	|		OtherExpensesOfUnfinishedProduction.ExpenseItem				AS ExpenseItem,
	|		OtherExpensesOfUnfinishedProduction.DimensionOfExpenses			AS DimensionOfExpenses,
	|		OtherExpensesOfUnfinishedProduction.LineOfBusiness	AS LineOfBusiness,
	|		OtherExpensesOfUnfinishedProduction.ProductionLot			AS ProductionLot,
	|		OtherExpensesOfUnfinishedProduction.ProductionOrder		AS ProductionOrder,
	|		OtherExpensesOfUnfinishedProduction.RowCodeProducts			AS RowCodeProducts,
	|		OtherExpensesOfUnfinishedProduction.Stage						AS Stage,
	|		OtherExpensesOfUnfinishedProduction.ProductCostElement			AS ProductCostElement,
	|		OtherExpensesOfUnfinishedProduction.ProductsGroup			AS ProductsGroup,
	|		OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots	AS RuleOfCostAllocatingToProductionLots
	|	FROM
	|		TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS OtherExpensesOfUnfinishedProduction
	|	WHERE
	|		NOT OtherExpensesOfUnfinishedProduction.OfficialTypeOfMovementParish
	|		AND OtherExpensesOfUnfinishedProduction.ReversingEntry
	|	) AS T
	|
	|INDEX BY
	|	Organization,
	|	Department,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	LineOfBusiness,
	|	ProductionLot,
	|	ProductionOrder,
	|	RowCodeProducts,
	|	Stage,
	|	ProductCostElement,
	|	ProductsGroup,
	|	RuleOfCostAllocatingToProductionLots
	|;";
	#EndRegion
	
	Query.Execute();
	
	#Region DataDistribution
	
	// Initializing the distribution
	LinkFields = "Period, Organization, ProductAccountingAnalyticsCost, InventoryOwnerAttribute, AccountingSection, Lot, LotVendorAttributes,
		|FinancialAccountingDimension, VATActivityType";
	DistributionParameters = CostCalculationUniversalAlgorithms.InitializeDistributionParametersUsingReducedRemainderMethod(
		"RoundingErrors_",
		"ErrorReceivers",
		LinkFields);
	
	AllocatedResources = "ItemizedFixedCostsIncludingVAT,ItemizedVariableCostsIncludingVAT,ItemizedFixedCostsExcludingVAT,ItemizedVariableCostsExcludingVAT,
		|ItemizedFixedCostsCompl,ItemizedVariableCostsCompl,ItemizedFixedCostsManag,ItemizedVariableCostsManag,CostOfPersonalIncomeTax";
	CostCalculationUniversalAlgorithms.InitializeNumericalDistributionFieldsUsingReducedRemainderMethod(
		DistributionParameters,
		AllocatedResources);
		
	OtherDatabaseFields = "RecordType, DocumentRegisterRecords, ProductionLot, ProductionOrder, RowCodeProducts, Stage, ProductCostElement, ProductsAccountingDimension, LotVendorAttributesCorr,
		|ManufacturedProduct, ItemVariant, InventoryType, BusinessOperation, Department, LineOfBusiness, CorLineOfBusiness, DimensionOfExpenses, ExpenseItem,
		|ProductsGroup, SourceDivision, DebitBusinessUnit, ReleaseLotDimension, DocumentOfProductionIssue, RuleOfCostAllocatingToProductionLots, AllocationBase, CostShare, BusinessTransactionSetting, FinRecordID";
		
	CostCalculationUniversalAlgorithms.InitializeOtherDistributionFieldsUsingReducedRemainderMethod(
		DistributionParameters,
		,
		OtherDatabaseFields);
		
	// We distribute
	CostCalculationUniversalAlgorithms.DistributeUsingReducedRemainderMethod(Query.TempTablesManager, DistributionParameters);
	
	#EndRegion
	
	#Region RegisteredRecordsAdjustmentTable
	
	Query.Text = "
	|SELECT
	|	T.ThisIsAdjustment,
	|	T.RemnantsOfUnfinishedProduction,
	|	T.Period,
	|	T.RecordType,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.ProductionLot,
	|	T.ProductionOrder,
	|	T.RowCodeProducts,
	|	T.Stage,
	|	T.ProductCostElement,
	|	T.ProductsAccountingDimension,
	|	T.ProductAccountingAnalyticsCost,
	|	T.LotVendorAttributesCorr,
	|	T.ManufacturedProduct,
	|	T.ItemVariant,
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.InventoryType,
	|	T.BusinessOperation,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.CorLineOfBusiness,
	|	CASE
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			THEN T.InventoryOwnerAttribute
	|		ELSE 
	|			T.ManufacturedProduct
	|	END AS SourceOfProductFinancialAccountingGroup,
	|	T.DimensionOfExpenses,
	|	T.ExpenseItem,
	|	T.ProductsGroup,
	|	T.SourceDivision,
	|	T.DebitBusinessUnit,
	|	T.ReleaseLotDimension,
	|	T.DocumentOfProductionIssue,
	|	T.RuleOfCostAllocatingToProductionLots,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	MAX(T.AllocationBase) AS AllocationBase,
	|	SUM(T.CostShare) AS CostShare,
	|	SUM(T.Cost) AS Cost,
	|	SUM(T.CostExcludingVAT) AS CostExcludingVAT,
	|	SUM(T.AddExpensesForGoods) AS AddExpensesForGoods,
	|	SUM(T.AdditionalExpensesExcludingVAT) AS AdditionalExpensesExcludingVAT,
	|	SUM(T.PermanentDifference) AS PermanentDifference,
	|	SUM(T.CostTD) AS CostTD,
	|	SUM(T.CostOfPersonalIncomeTax) AS CostOfPersonalIncomeTax,
	|	SUM(T.LocalCost) AS LocalCost,
	|	SUM(T.OffBalanceCost) AS OffBalanceCost,
	|	SUM(T.LaborCosts) AS LaborCosts,
	|	CAST(SUM(T.ItemizedFixedCostsIncludingVAT) AS NUMBER(31, 2)) AS ItemizedFixedCostsIncludingVAT,
	|	CAST(SUM(T.ItemizedFixedCostsExcludingVAT) AS NUMBER(31, 2)) AS ItemizedFixedCostsExcludingVAT,
	|	CAST(SUM(T.ItemizedVariableCostsIncludingVAT) AS NUMBER(31, 2)) AS ItemizedVariableCostsIncludingVAT,
	|	CAST(SUM(T.ItemizedVariableCostsExcludingVAT) AS NUMBER(31, 2)) AS ItemizedVariableCostsExcludingVAT,
	|	SUM(T.OffBalanceCostLocal) AS OffBalanceCostLocal,
	|	SUM(T.AddExpensesLocal) AS AddExpensesLocal,
	|	SUM(T.LaborCostsLocal) AS LaborCostsLocal,
	|	SUM(T.LaborCostsWithoutVAT) AS LaborCostsWithoutVAT,
	|	CAST(SUM(T.ItemizedFixedCostsCompl) AS NUMBER(31, 2)) AS ItemizedFixedCostsCompl,
	|	CAST(SUM(T.ItemizedVariableCostsCompl) AS NUMBER(31, 2)) AS ItemizedVariableCostsCompl,
	|	SUM(T.ReserveLocal) AS ReserveLocal,
	|	SUM(T.CostMan) AS CostMan,
	|	SUM(T.AddExpensesMan) AS AddExpensesMan,
	|	SUM(T.LaborCostsMan) AS LaborCostsMan,
	|	CAST(SUM(T.ItemizedFixedCostsManag) AS NUMBER(31, 2)) AS ItemizedFixedCostsManag,
	|	CAST(SUM(T.ItemizedVariableCostsManag) AS NUMBER(31, 2)) AS ItemizedVariableCostsManag,
	|	SUM(T.ReserveMan) AS ReserveMan,
	|  	
	|	CAST(SUM(T.AmountIncludingVAT) AS NUMBER(31, 2)) AS AmountIncludingVAT,
	|	CAST(SUM(T.AmountExcludingVAT) AS NUMBER(31, 2)) AS AmountExcludingVAT,
	|	CAST(SUM(T.SumCompl) AS NUMBER(31, 2)) AS SumCompl,
	|	CAST(SUM(T.SumMan) AS NUMBER(31, 2)) AS SumMan,
	|	CAST(SUM(T.AITAmount) AS NUMBER(31, 2)) AS AITAmount
	|INTO RegisteredRecordsAdjustmentTable
	|FROM
	|	(SELECT
	|		FALSE AS ThisIsAdjustment,
	|		FALSE AS RemnantsOfUnfinishedProduction,
	|		TTTimeAdjustmentTable.Period AS Period,
	|		TTTimeAdjustmentTable.RecordType AS RecordType,
	|		TTTimeAdjustmentTable.DocumentRegisterRecords AS DocumentRegisterRecords,
	|		TTTimeAdjustmentTable.Organization AS Organization,
	|		TTTimeAdjustmentTable.ProductionLot AS ProductionLot,
	|		TTTimeAdjustmentTable.ProductionOrder AS ProductionOrder,
	|		TTTimeAdjustmentTable.RowCodeProducts AS RowCodeProducts,
	|		TTTimeAdjustmentTable.Stage AS Stage,
	|		TTTimeAdjustmentTable.ProductCostElement AS ProductCostElement,
	|		TTTimeAdjustmentTable.ProductsAccountingDimension AS ProductsAccountingDimension,
	|		TTTimeAdjustmentTable.ProductsAccountingDimension AS ProductAccountingAnalyticsCost,
	|		TTTimeAdjustmentTable.LotVendorAttributesCorr AS LotVendorAttributesCorr,
	|		TTTimeAdjustmentTable.ManufacturedProduct AS ManufacturedProduct,
	|		TTTimeAdjustmentTable.ItemVariant AS ItemVariant,
	|		TTTimeAdjustmentTable.AccountingSection AS AccountingSection,
	|		TTTimeAdjustmentTable.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|		TTTimeAdjustmentTable.Lot AS Lot,
	|		TTTimeAdjustmentTable.LotVendorAttributes AS LotVendorAttributes,
	|		TTTimeAdjustmentTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	|		TTTimeAdjustmentTable.VATActivityType AS VATActivityType,
	|		TTTimeAdjustmentTable.InventoryType AS InventoryType,
	|		TTTimeAdjustmentTable.BusinessOperation AS BusinessOperation,
	|		TTTimeAdjustmentTable.Department AS Department,
	|		TTTimeAdjustmentTable.LineOfBusiness AS LineOfBusiness,
	|		TTTimeAdjustmentTable.CorLineOfBusiness AS CorLineOfBusiness,
	|		TTTimeAdjustmentTable.DimensionOfExpenses AS DimensionOfExpenses,
	|		TTTimeAdjustmentTable.ExpenseItem AS ExpenseItem,
	|		TTTimeAdjustmentTable.ProductsGroup AS ProductsGroup,
	|		TTTimeAdjustmentTable.SourceDivision AS SourceDivision,
	|		TTTimeAdjustmentTable.Department AS DebitBusinessUnit,
	|		TTTimeAdjustmentTable.ReleaseLotDimension AS ReleaseLotDimension,
	|		TTTimeAdjustmentTable.DocumentOfProductionIssue AS DocumentOfProductionIssue,
	|		TTTimeAdjustmentTable.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|		TTTimeAdjustmentTable.AllocationBase AS AllocationBase,
	|		TTTimeAdjustmentTable.CostShare AS CostShare,
	|		TTTimeAdjustmentTable.Cost AS Cost,
	|		TTTimeAdjustmentTable.CostExcludingVAT AS CostExcludingVAT,
	|		TTTimeAdjustmentTable.AddExpensesForGoods AS AddExpensesForGoods,
	|		TTTimeAdjustmentTable.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
	|		TTTimeAdjustmentTable.PermanentDifference AS PermanentDifference,
	|		TTTimeAdjustmentTable.CostTD AS CostTD,
	|		TTTimeAdjustmentTable.CostOfPersonalIncomeTax AS CostOfPersonalIncomeTax,
	|		TTTimeAdjustmentTable.LocalCost AS LocalCost,
	|		TTTimeAdjustmentTable.OffBalanceCost AS OffBalanceCost,
	|		TTTimeAdjustmentTable.LaborCosts AS LaborCosts,
	|		CAST(TTTimeAdjustmentTable.ItemizedFixedCostsIncludingVAT AS NUMBER(31, 2)) AS ItemizedFixedCostsIncludingVAT,
	|		CAST(TTTimeAdjustmentTable.ItemizedFixedCostsExcludingVAT AS NUMBER(31, 2)) AS ItemizedFixedCostsExcludingVAT,
	|		CAST(TTTimeAdjustmentTable.ItemizedVariableCostsIncludingVAT AS NUMBER(31, 2)) AS ItemizedVariableCostsIncludingVAT,
	|		CAST(TTTimeAdjustmentTable.ItemizedVariableCostsExcludingVAT AS NUMBER(31, 2)) AS ItemizedVariableCostsExcludingVAT,
	|		TTTimeAdjustmentTable.OffBalanceCostLocal AS OffBalanceCostLocal,
	|		TTTimeAdjustmentTable.AddExpensesLocal AS AddExpensesLocal,
	|		TTTimeAdjustmentTable.LaborCostsLocal AS LaborCostsLocal,
	|		TTTimeAdjustmentTable.LaborCostsWithoutVAT AS LaborCostsWithoutVAT,
	|		CAST(TTTimeAdjustmentTable.ItemizedFixedCostsCompl AS NUMBER(31, 2)) AS ItemizedFixedCostsCompl,
	|		CAST(TTTimeAdjustmentTable.ItemizedVariableCostsCompl AS NUMBER(31, 2)) AS ItemizedVariableCostsCompl,
	|		TTTimeAdjustmentTable.ReserveLocal AS ReserveLocal,
	|		TTTimeAdjustmentTable.CostMan AS CostMan,
	|		TTTimeAdjustmentTable.AddExpensesMan AS AddExpensesMan,
	|		TTTimeAdjustmentTable.LaborCostsMan AS LaborCostsMan,
	|		CAST(TTTimeAdjustmentTable.ItemizedFixedCostsManag AS NUMBER(31, 2)) AS ItemizedFixedCostsManag,
	|		CAST(TTTimeAdjustmentTable.ItemizedVariableCostsManag AS NUMBER(31, 2)) AS ItemizedVariableCostsManag,
	|		TTTimeAdjustmentTable.ReserveMan AS ReserveMan,
	|		TTTimeAdjustmentTable.BusinessTransactionSetting,
	|		TTTimeAdjustmentTable.FinRecordID,
	|		
	|		CAST(Cost AS NUMBER(31, 2)) 
	|			+ CAST(AddExpensesForGoods AS NUMBER(31, 2))  
	|			+ CAST(LaborCosts AS NUMBER(31, 2))  
	|			+ CAST(ItemizedFixedCostsIncludingVAT AS NUMBER(31, 2))  
	|			+ CAST(ItemizedVariableCostsIncludingVAT AS NUMBER(31, 2)) AS AmountIncludingVAT,
	|		CAST(CostExcludingVAT AS NUMBER(31, 2))  
	|			+ CAST(AdditionalExpensesExcludingVAT AS NUMBER(31, 2))  
	|			+ CAST(LaborCostsWithoutVAT AS NUMBER(31, 2))  
	|			+ CAST(ItemizedFixedCostsExcludingVAT AS NUMBER(31, 2))  
	|			+ CAST(ItemizedVariableCostsExcludingVAT AS NUMBER(31, 2)) AS AmountExcludingVAT,
	|		CAST(LocalCost AS NUMBER(31, 2))  
	|			+ CAST(AddExpensesLocal AS NUMBER(31, 2))  
	|			+ CAST(LaborCostsLocal AS NUMBER(31, 2))  
	|			+ CAST(ItemizedFixedCostsCompl AS NUMBER(31, 2))  
	|			+ CAST(ItemizedVariableCostsCompl AS NUMBER(31, 2)) AS SumCompl,
	|		CAST(CostMan AS NUMBER(31, 2))  
	|			+ CAST(AddExpensesMan AS NUMBER(31, 2))  
	|			+ CAST(LaborCostsMan AS NUMBER(31, 2))  
	|			+ CAST(ItemizedFixedCostsManag AS NUMBER(31, 2))  
	|			+ CAST(ItemizedVariableCostsManag AS NUMBER(31, 2)) AS SumMan,
	|		CAST(CostOfPersonalIncomeTax AS NUMBER(31, 2)) AS AITAmount
	|
	|	FROM
	|		TTTimeAdjustmentTable AS TTTimeAdjustmentTable
	|
	|	UNION ALL
	|
	|	SELECT
	|		FALSE AS ThisIsAdjustment,
	|		FALSE AS RemnantsOfUnfinishedProduction,
	|		T.Period AS Period,
	|		T.RecordType AS RecordType,
	|		T.DocumentRegisterRecords AS DocumentRegisterRecords,
	|		T.Organization AS Organization,
	|		T.ProductionLot AS ProductionLot,
	|		T.ProductionOrder AS ProductionOrder,
	|		T.RowCodeProducts AS RowCodeProducts,
	|		T.Stage AS Stage,
	|		T.ProductCostElement AS ProductCostElement,
	|		T.ProductAccountingAnalyticsCost AS ProductsAccountingDimension,
	|		T.ProductAccountingAnalyticsCost AS ProductAccountingAnalyticsCost,
	|		T.LotVendorAttributesCorr AS LotVendorAttributesCorr,
	|		T.ManufacturedProduct AS ManufacturedProduct,
	|		T.ItemVariant AS ItemVariant,
	|		T.AccountingSection AS AccountingSection,
	|		T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|		T.Lot AS Lot,
	|		T.LotVendorAttributes AS LotVendorAttributes,
	|		T.FinancialAccountingDimension AS FinancialAccountingDimension,
	|		T.VATActivityType AS VATActivityType,
	|		T.InventoryType AS InventoryType,
	|		T.BusinessOperation AS BusinessOperation,
	|		T.Department AS Department,
	|		T.LineOfBusiness AS LineOfBusiness,
	|		T.CorLineOfBusiness AS CorLineOfBusiness,
	|		T.DimensionOfExpenses AS DimensionOfExpenses,
	|		T.ExpenseItem AS ExpenseItem,
	|		T.ProductsGroup AS ProductsGroup,
	|		T.SourceDivision AS SourceDivision,
	|		T.Department AS DebitBusinessUnit,
	|		T.ReleaseLotDimension AS ReleaseLotDimension,
	|		T.DocumentOfProductionIssue AS DocumentOfProductionIssue,
	|		T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	|		T.AllocationBase AS AllocationBase,
	|		T.CostShare AS CostShare,
	|		0 AS Cost,
	|		0 AS CostExcludingVAT,
	|		0 AS AddExpensesForGoods,
	|		0 AS AdditionalExpensesExcludingVAT,
	|		0 AS PermanentDifference,
	|		0 AS CostTD,
	|		0 AS CostOfPersonalIncomeTax,
	|		0 AS LocalCost,
	|		0 AS OffBalanceCost,
	|		0 AS LaborCosts,
	|		T.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	|		T.ItemizedFixedCostsExcludingVAT AS ItemizedFixedCostsExcludingVAT,
	|		T.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	|		T.ItemizedVariableCostsExcludingVAT AS ItemizedVariableCostsExcludingVAT,
	|		0 AS OffBalanceCostLocal,
	|		0 AS AddExpensesLocal,
	|		0 AS LaborCostsLocal,
	|		0 AS LaborCostsWithoutVAT,
	|		T.ItemizedFixedCostsCompl AS ItemizedFixedCostsCompl,
	|		T.ItemizedVariableCostsCompl AS ItemizedVariableCostsCompl,
	|		0 AS ReserveLocal,
	|		0 AS CostMan,
	|		0 AS AddExpensesMan,
	|		0 AS LaborCostsMan,
	|		T.ItemizedFixedCostsManag AS ItemizedFixedCostsManag,
	|		T.ItemizedVariableCostsManag AS ItemizedVariableCostsManag,
	|		0 AS ReserveMan,
	|		T.BusinessTransactionSetting,
	|		T.FinRecordID,
	|	
	|		ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT AS AmountIncludingVAT,
	|		ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT AS AmountExcludingVAT,
	|		ItemizedFixedCostsCompl + ItemizedVariableCostsCompl AS SumCompl,
	|		ItemizedFixedCostsManag + ItemizedVariableCostsManag AS SumMan,
	|		0 AS AITAmount
	|	FROM
	|		TTDistributionResult AS T) AS T
	|
	|GROUP BY
	|	T.ThisIsAdjustment,
	|	T.RemnantsOfUnfinishedProduction,
	|	T.Period,
	|	T.RecordType,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.ProductionLot,
	|	T.ProductionOrder,
	|	T.RowCodeProducts,
	|	CASE
	|		WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|			THEN T.InventoryOwnerAttribute
	|		ELSE 
	|			T.ManufacturedProduct
	|	END,
	|	T.Stage,
	|	T.ProductCostElement,
	|	T.ProductsAccountingDimension,
	|	T.ProductAccountingAnalyticsCost,
	|	T.LotVendorAttributesCorr,
	|	T.ManufacturedProduct,
	|	T.ItemVariant,
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.InventoryType,
	|	T.BusinessOperation,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.CorLineOfBusiness,
	|	T.DimensionOfExpenses,
	|	T.ExpenseItem,
	|	T.ProductsGroup,
	|	T.SourceDivision,
	|	T.DebitBusinessUnit,
	|	T.ReleaseLotDimension,
	|	T.DocumentOfProductionIssue,
	|	T.RuleOfCostAllocatingToProductionLots,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID	
	|";
	#EndRegion
	
	Query.Text = SetBitDepthOfNumbersInRequestText(CalculationParameters, Query.Text);
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
		"TTAdjustmentTableWithoutIDs, IDsByAdjustmentTableFields, TTTimeAdjustmentTable");
	
	MatchingTemporaryMovementTables = New Map;
	
	// Movements are formed by registers:
	// - Other expenses
	// - Other expenses of the perfected production
	// - Cost of goods
		
	GenerateAllOtherWorkInProgressExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables);
	GenerateTotalCostOfGoodsWriteOffUnfinishedProductionRequest(CalculationParameters, MatchingTemporaryMovementTables);
	GenerateTrafficProductsProductsWriteOffUnfinishedProductionRequest(CalculationParameters, MatchingTemporaryMovementTables);
	
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpenses Then
		GenerateRegisteredRecordsOtherExpensesWriteOffUnfinishedProductionRequest(CalculationParameters, MatchingTemporaryMovementTables);
	EndIf;
		
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	ArrayOfLocalTemporaryTables = New Array;
	ArrayOfLocalTemporaryTables.Add("RegisteredRecordsAdjustmentTable");
	ArrayOfLocalTemporaryTables.Add("IDsTable");
	ArrayOfLocalTemporaryTables.Add("ErrorReceivers");
	ArrayOfLocalTemporaryTables.Add("RoundingErrors_");
	For Each KeyValue In MatchingTemporaryMovementTables Do
		ArrayOfLocalTemporaryTables.Add(KeyValue.Key);
	EndDo;
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, "TTAdjustmentTable, Releases,
		|" + StrConcat(ArrayOfLocalTemporaryTables, ","));
	
EndProcedure

// Stage 3.15 b
Procedure AdjustCostOfWritingOffReservesForUpcomingExpenses(CalculationParameters)
	
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfWritingOffReservesForUpcomingExpenses");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	MatchingTemporaryMovementTables = New Map;
	
	Query.Text = 
		"SELECT
		|	&EndOfPeriod AS Period,
		|	ReserveMovementDocuments.DocumentRegisterRecords AS Recorder,
		|	Movement.Organization,
		|	Movement.LineOfBusiness,
		|	Movement.ReserveKind,
		|	Movement.ProvisionObject,
		|	Movement.ExpenseItem,
		|	Movement.DimensionOfExpenses,
		|	Movement.Department,
		|	Movement.SumCompl AS SumCompl,
		|	0 AS AmountFA,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	Movement.SumMan AS SumMan,	
		|	VALUE(Enum.BusinessTransactions.ExpenseWithCorrespondenceToProvisions) AS BusinessOperation,
		|	VALUE(Catalog.BusinessTransactionsSettings.ExpenseWithCorrespondenceToProvisions) AS BusinessTransactionSetting,
		|	Movement.ReserveKind AS AdjReserveKind,
		|	Movement.ProvisionObject AS CorProvisionObject
		|
		|INTO RegisteredRecordedTTExpensesWriteOff
		|FROM
		|	FutureExpenseCommitments AS Movement
		|		INNER JOIN ReserveMovementDocuments AS ReserveMovementDocuments
		|		ON Movement.Organization = ReserveMovementDocuments.Organization
		|			AND Movement.ReserveKind = ReserveMovementDocuments.ReserveKind";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	TMCommonUse.AddIDsToTemporaryTable("RegisteredRecordedTTExpensesWriteOff", CalculationParameters.TempTablesManager, "FinRecordID");
	
	#Region ExpenseWithCorrespondenceToProvisions_OtherExpenses
	
	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTOtherExpensesWriteOffDueToReserves";
	TemporaryTableNameSource = "RegisteredRecordedTTExpensesWriteOff";
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Expense)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "FALSE");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
	#EndRegion
	
	#Region ExpenseWithCorrespondenceToProvisions_FutureExpenseCommitments
	
	RegisterName = Metadata.AccumulationRegisters.FutureExpenseCommitments.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTProvisionsAndContingentLiabilitiesWriteOffDueToReserves";
	TemporaryTableNameSource = "RegisteredRecordedTTExpensesWriteOff";
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
	#EndRegion
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

// Stage 3.16
Procedure AdjustCostOfOtherWriteOffOfWorkInProgress(CalculationParameters) Export
	
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfOtherWriteOffOfWorkInProgress");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	Operation.Date AS Period,
	|	Operation.Ref AS Recorder,
	|	Operation.Organization AS Organization,
	|	Operation.Department AS Department,
	|	Operation.Department AS DebitBusinessUnit,
	|	Operation.ExpenseItem AS ExpenseItem,
	|	Operation.DimensionOfExpenses AS DimensionOfExpenses,
	|	Operation.LineOfBusiness AS LineOfBusiness,
	|	Rows.LineOfBusiness AS LineOfBusinessRecipient,
	|	CASE
	|		WHEN VALUETYPE(Rows.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	|			THEN Rows.ExpenseItem
	|		ELSE UNDEFINED
	|	END AS ExpenseItemRecipient,
	|	CASE
	|		WHEN VALUETYPE(Rows.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	|			THEN Rows.DimensionOfExpenses
	|		ELSE UNDEFINED
	|	END AS ExpensesDimensionRecipient,
	|	CASE
	|		WHEN VALUETYPE(Rows.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
	|			THEN Rows.ExpenseItem
	|		ELSE UNDEFINED
	|	END AS AssetAndLiabilityItem,
	|	CASE
	|		WHEN VALUETYPE(Rows.ExpenseItem) = TYPE(ChartOfCharacteristicTypes.AssetLiabilityItems)
	|			THEN Rows.DimensionOfExpenses
	|		ELSE UNDEFINED
	|	END AS AssetsLiabilitiesDimension,
	|	Rows.RowID AS RowID,
	|	VALUE(Enum.BusinessTransactions.WriteOffOtherExpenses) AS BusinessOperation,
	|	SUM(Rows.CostShare) AS Count,
	|	SUM(Rows.CostShare) AS QuantityWithoutVAT,
	|	SUM(Rows.CostShare) AS NumberOfLocal,
	|	SUM(Rows.CostShare) AS NumberOfTA,
	|	SUM(Rows.CostShare) AS NumberOfPersonalData,
	|	SUM(Rows.CostShare) AS NumberOfMen
	|INTO TTAdjustmentTable
	|FROM
	|	Document.AllocationOfOtherCosts AS Operation
	|	INNER JOIN Document.AllocationOfOtherCosts.WriteOff AS Rows
	|		ON Rows.Ref = Operation.Ref
	|WHERE
	|	Operation.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND Operation.Organization IN(&CompanyArray)
	|	AND Operation.Posted
	|	AND NOT &BatchAccountingVersion22
	|	
	|GROUP BY
	|	Operation.Date,
	|	Operation.Ref,
	|	Operation.Organization,
	|	Operation.Department,
	|	Operation.ExpenseItem,
	|	Operation.DimensionOfExpenses,
	|	Operation.LineOfBusiness,
	|	Rows.LineOfBusiness,
	|	Rows.ExpenseItem,
	|	Rows.DimensionOfExpenses,
	|	Rows.RowID
	|
	|UNION ALL
	|
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	|	DD.Organization AS Organization,
	|	DD.Department AS Department,
	|	DD.DebitBusinessUnit AS DebitBusinessUnit,
	|	DD.ExpenseItem AS ExpenseItem,
	|	DD.DimensionOfExpenses AS DimensionOfExpenses,
	|	DD.LineOfBusiness AS LineOfBusiness,
	|	DD.CorLineOfBusiness AS LineOfBusinessRecipient,
	|	DD.CorExpenseItem AS ExpenseItemRecipient,
	|	DD.CorExpenditureDimension AS ExpensesDimensionRecipient,
	|	DD.CorArticleOfAssetsLiabilities AS AssetAndLiabilityItem,
	|	DD.CorDimensionOfAssetsLiabilities AS AssetsLiabilitiesDimension,
	|	DD.RowID AS RowID,
	|	DD.BusinessOperation AS BusinessOperation,
	|	SUM(DD.CostShare) AS Count,
	|	SUM(DD.ShareOfValueWithoutVAT) AS QuantityWithoutVAT,
	|	SUM(DD.ShareOfLocalValue) AS NumberOfLocal,
	|	SUM(DD.ShareValueTa) AS NumberOfTA,
	|	SUM(DD.ShareOfCostOfPersonalIncomeTax) AS NumberOfPersonalData,
	|	SUM(DD.ShareOfManSCost) AS NumberOfMen
	|FROM
	|	SharesOfProductionCosts AS DD
	|WHERE
	|	DD.Organization IN(&CompanyArray)
	|	AND &BatchAccountingVersion22
	|	AND DD.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffOtherExpenses)
	|	AND NOT (DD.CostShare = 0
	|		AND DD.ShareOfValueWithoutVAT = 0
	|		AND DD.ShareOfLocalValue = 0
	|		AND DD.ShareValueTa = 0
	|		AND DD.ShareOfCostOfPersonalIncomeTax = 0
	|		AND DD.ShareOfManSCost = 0)
	|	
	|GROUP BY
	|	DD.Period,
	|	DD.Recorder,
	|	DD.Organization,
	|	DD.Department,
	|	DD.DebitBusinessUnit,
	|	DD.ExpenseItem,
	|	DD.CorExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.CorExpenditureDimension,
	|	DD.CorArticleOfAssetsLiabilities,
	|	DD.CorDimensionOfAssetsLiabilities,
	|	DD.LineOfBusiness,
	|	DD.CorLineOfBusiness,
	|	DD.RowID,
	|	DD.BusinessOperation
	|
	|UNION ALL
	|
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	|	DD.Organization AS Organization,
	|	DD.Department AS Department,
	|	DD.DebitBusinessUnit AS DebitBusinessUnit,
	|	DD.ExpenseItem AS ExpenseItem,
	|	DD.DimensionOfExpenses AS DimensionOfExpenses,
	|	DD.LineOfBusiness AS LineOfBusiness,
	|	DD.CorLineOfBusiness AS LineOfBusinessRecipient,
	|	DD.CorExpenseItem AS ExpenseItemRecipient,
	|	DD.CorExpenditureDimension AS ExpensesDimensionRecipient,
	|	DD.CorArticleOfAssetsLiabilities AS AssetAndLiabilityItem,
	|	DD.CorDimensionOfAssetsLiabilities AS AssetsLiabilitiesDimension,
	|	DD.RowID AS RowID,
	|	DD.BusinessOperation AS BusinessOperation,
	|	SUM(DD.CostShare) AS Count,
	|	SUM(DD.ShareOfValueWithoutVAT) AS QuantityWithoutVAT,
	|	SUM(DD.ShareOfLocalValue) AS NumberOfLocal,
	|	SUM(DD.ShareValueTa) AS NumberOfTA,
	|	SUM(DD.ShareOfCostOfPersonalIncomeTax) AS NumberOfPersonalData,
	|	SUM(DD.ShareOfManSCost) AS NumberOfMen
	|FROM
	|	DirectProductionCosts AS DD
	|WHERE
	|	DD.Organization IN(&CompanyArray)
	|	AND &BatchAccountingVersion22
	|	AND DD.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffOtherExpenses)
	|	AND NOT (DD.CostShare = 0
	|		AND DD.ShareOfValueWithoutVAT = 0
	|		AND DD.ShareOfLocalValue = 0
	|		AND DD.ShareValueTa = 0
	|		AND DD.ShareOfCostOfPersonalIncomeTax = 0
	|		AND DD.ShareOfManSCost = 0)
	|	
	|GROUP BY
	|	DD.Period,
	|	DD.Recorder,
	|	DD.Organization,
	|	DD.Department,
	|	DD.DebitBusinessUnit,
	|	DD.ExpenseItem,
	|	DD.CorExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.CorExpenditureDimension,
	|	DD.CorArticleOfAssetsLiabilities,
	|	DD.CorDimensionOfAssetsLiabilities,
	|	DD.LineOfBusiness,
	|	DD.CorLineOfBusiness,
	|	DD.RowID,
	|	DD.BusinessOperation
	|
	|UNION ALL
	|
	|SELECT
	|	Operation.Date AS Period,
	|	DD.DocumentRegisterRecords AS Recorder,
	|	DD.Organization AS Organization,
	|	DD.Department AS Department,
	|	DD.DebitBusinessUnit AS DebitBusinessUnit,
	|	DD.ExpenseItem AS ExpenseItem,
	|	DD.DimensionOfExpenses AS DimensionOfExpenses,
	|	DD.LineOfBusiness AS LineOfBusiness,
	|	DD.LineOfBusiness AS LineOfBusinessRecipient,
	|	DD.ExpenseItem AS ExpenseItemRecipient,
	|	DD.CorExpenditureDimension AS ExpensesDimensionRecipient,
	|	UNDEFINED AS AssetAndLiabilityItem,
	|	UNDEFINED AS AssetsLiabilitiesDimension,
	|	UNDEFINED AS RowID,
	|	VALUE(Enum.BusinessTransactions.TransitOfExpensesBetweenCostCenters) AS BusinessOperation,
	|	SUM(CASE 
	|			WHEN Operation.CostShareToCostCenters = 0 THEN 0 
	|			ELSE DD.LedWeight
	|			END) AS Count,
	|	SUM(CASE 
	|			WHEN Operation.CostShareToCostCenters = 0 THEN 0 
	|			ELSE DD.LedWeight
	|			END) AS QuantityWithoutVAT,
	|	SUM(CASE 
	|			WHEN Operation.CostShareToCostCenters = 0 THEN 0 
	|			ELSE DD.LocalWeightGiven
	|			END) AS NumberOfLocal,
	|	SUM(CASE 
	|			WHEN Operation.CostShareToCostCenters = 0 THEN 0 
	|			ELSE DD.LocalWeightGiven
	|			END) AS NumberOfTA,
	|	SUM(CASE 
	|			WHEN Operation.CostShareToCostCenters = 0 THEN 0 
	|			ELSE DD.LocalWeightGiven
	|			END) AS NumberOfPersonalData,
	|	SUM(CASE 
	|			WHEN Operation.CostShareToCostCenters = 0 THEN 0 
	|			ELSE DD.LedWeight
	|			END) AS NumberOfMen
	|FROM
	|	TTTransitOfExpensesBetweenHIA AS DD
	|	INNER JOIN TTShareOfDistributionOfOtherCosts AS Operation
	|		ON
	|			Operation.Document = DD.DocumentRegisterRecords
	|
	|WHERE
	|	DD.Organization IN(&CompanyArray)
	|	AND NOT (DD.LedWeight = 0 AND DD.LocalWeightGiven = 0)
	|	
	|GROUP BY
	|	Operation.Date,
	|	DD.DocumentRegisterRecords,
	|	DD.Organization,
	|	DD.Department,
	|	DD.DebitBusinessUnit,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.LineOfBusiness,
	|	DD.CorExpenditureDimension
	|
	|UNION ALL
	|
	|SELECT
	|	Operation.Date AS Period,
	|	Operation.Ref AS Recorder,
	|	Operation.Organization AS Organization,
	|	Operation.Department AS Department,
	|	WriteOffItems.Department AS DebitBusinessUnit,
	|	TransitHubs.ExpenseItem AS ExpenseItem,
	|	Operation.DimensionOfExpenses AS DimensionOfExpenses,
	|	TransitHubs.LineOfBusiness AS LineOfBusiness,
	|	WriteOffItems.LineOfBusiness AS LineOfBusinessRecipient,
	|	WriteOffItems.ExpenseItem AS ExpenseItemRecipient,
	|	WriteOffItems.DimensionOfExpenses AS ExpensesDimensionRecipient,
	|	UNDEFINED AS AssetAndLiabilityItem,
	|	UNDEFINED AS AssetsLiabilitiesDimension,
	|	UNDEFINED AS RowID,
	|	VALUE(Enum.BusinessTransactions.WriteOffOtherExpenses) AS BusinessOperation,
	|	SUM(CASE WHEN Operation.ManagementAccounting THEN WriteOffItems.CostShare*TransitHubs.Weight ELSE 0 END) AS Count,
	|	SUM(CASE WHEN Operation.ManagementAccounting THEN WriteOffItems.CostShare*TransitHubs.Weight ELSE 0 END) AS QuantityWithoutVAT,
	|	SUM(CASE WHEN Operation.LocalAccounting THEN WriteOffItems.CostShare*TransitHubs.LocalWeight ELSE 0 END) AS NumberOfLocal,
	|	SUM(CASE WHEN Operation.TaxAccounting THEN WriteOffItems.CostShare*TransitHubs.LocalWeight ELSE 0 END) AS NumberOfTA,
	|	SUM(CASE WHEN Operation.AIT THEN WriteOffItems.CostShare*TransitHubs.LocalWeight ELSE 0 END) AS NumberOfPersonalData,
	|	SUM(CASE WHEN Operation.ManagementAccounting THEN WriteOffItems.CostShare*TransitHubs.Weight ELSE 0 END) AS NumberOfMen
	|FROM
	|	Document.AllocationOfOtherCosts.WriteOff AS WriteOffItems
	|	INNER JOIN TTShareOfDistributionOfOtherCosts AS Operation
	|		ON
	|			WriteOffItems.Ref = Operation.Document
	|	INNER JOIN
	|		TTInitialDataOfTransitNodesOfExpendituresBetweenHIA AS TransitHubs
	|		ON
	|			TransitHubs.Organization = Operation.Organization
	|			AND TransitHubs.Department = Operation.Department
	|			AND TransitHubs.DimensionOfExpenses = Operation.DimensionOfExpenses
	|
	|WHERE
	|	Operation.ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	AND Operation.AllocateToExpenseItems
	|	
	|GROUP BY
	|	Operation.Date,
	|	Operation.Ref,
	|	Operation.Organization,
	|	Operation.Department,
	|	WriteOffItems.Department,
	|	TransitHubs.ExpenseItem,
	|	WriteOffItems.ExpenseItem,
	|	Operation.DimensionOfExpenses,
	|	TransitHubs.LineOfBusiness,
	|	WriteOffItems.LineOfBusiness,
	|	WriteOffItems.DimensionOfExpenses,
	|	UNDEFINED,
	|	VALUE(Enum.BusinessTransactions.WriteOffOtherExpenses)
	|
	|INDEX BY
	|	Recorder
	|";

	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	ColumnMapping = New Structure;
	ColumnMapping.Insert(
		Metadata.AccumulationRegisters.OtherExpenses.Attributes.CorExpenditureDimension.Name,
		"ExpensesDimensionRecipient");
	
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(
		CalculationParameters,
		CalculationParameters.RegisterRecords[Metadata.AccumulationRegisters.OtherExpenses.Name],
		"TTAdjustmentTable",
		"Organization, Department, ExpenseItem, DimensionOfExpenses",
		ColumnMapping);
	
	Query.Text =
	"SELECT 
	|	ARTICLES__.Ref
	|INTO TTArticleExceptionsForValueWithoutVAT
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ARTICLES__
	|WHERE
	|	ARTICLES__.CostAllocationOptionManag IN (
	|		VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|		VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|;
	|SELECT
	|	AdjustmentTable.Period,
	|	AdjustmentTable.Recorder AS DocumentRegisterRecords,
	|	AdjustmentTable.Organization,
	|	AdjustmentTable.Department,
	|	AdjustmentTable.DebitBusinessUnit,
	|	AdjustmentTable.ExpenseItem,
	|	AdjustmentTable.DimensionOfExpenses,
	|	AdjustmentTable.LineOfBusiness,
	|	AdjustmentTable.LineOfBusinessRecipient AS CorLineOfBusiness,
	|	AdjustmentTable.ExpenseItemRecipient,
	|	AdjustmentTable.ExpensesDimensionRecipient,
	|	AdjustmentTable.AssetAndLiabilityItem,
	|	AdjustmentTable.AssetsLiabilitiesDimension,
	|	AdjustmentTable.RowID,
	|	AdjustmentTable.BusinessOperation,
	|	BsnsTransactionsSettings.Ref AS BusinessTransactionSetting,
	|	AdjustmentTable.FinRecordID,
	|	NOT ArticlesOfExclusion.Ref IS NULL AS ExcludeValueWithoutVAT,
	// When expenses are transited between CostCenter, the sign of acceptance of operation of the expense item is not taken into account,
	// because during this operation there is no change in the expense item, only the CostCenter changes. 
	|	(CASE
	|		WHEN AdjustmentTable.BusinessOperation = VALUE(Enum.BusinessTransactions.TransitOfExpensesBetweenCostCenters)
	|			THEN TRUE
	|		ELSE ISNULL(CorExpenseItem.EnteredInTaxAccounting, TRUE) END) AS AcceptanceOfCCPWhenDebiting,
	|	CAST(AdjustmentTable.NumberOfLocal AS NUMBER(31,2)) AS AllocationBase,
	|	CAST(
	|		AdjustmentTable.Count
	|			* (ISNULL(Costs_2.Cost, 0)
	|				+ ISNULL(Costs_2.ItemizedFixedCostsIncludingVAT, 0)
	|				+ ISNULL(Costs_2.ItemizedVariableCostsIncludingVAT, 0)
	|				+ ISNULL(Costs_2.LaborCosts, 0)) AS NUMBER(31,2)) AS Cost,
	|
	|	CAST(
	|		AdjustmentTable.QuantityWithoutVAT
	|			* (ISNULL(Costs_2.CostExcludingVAT, 0)
	|				+ ISNULL(Costs_2.ItemizedFixedCostsExcludingVAT, 0)
	|				+ ISNULL(Costs_2.ItemizedVariableCostsExcludingVAT, 0)
	|				+ ISNULL(Costs_2.LaborCostsWithoutVAT, 0)) AS NUMBER(31,2)) AS CostExcludingVAT,
	|
	|	CAST(
	|		AdjustmentTable.Count
	|			* ISNULL(Costs_2.AdditionalExpenseCost, 0) AS NUMBER(31,2)) AS AddExpensesForGoods,
	|
	|	CAST(
	|		AdjustmentTable.QuantityWithoutVAT
	|			* ISNULL(Costs_2.AdditionalExpensesCostExcludingVAT, 0) AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
	|
	|	0 AS PermanentDifference,
	|
	|	0 AS CostTD,
	|
	|	CAST(
	|		AdjustmentTable.NumberOfLocal
	|			* (ISNULL(LocalCosts.LocalCost, 0)
	|				+ ISNULL(LocalCosts.AddExpensesLocal, 0)
	|				+ ISNULL(LocalCosts.ItemizedFixedCostsCompl, 0)
	|				+ ISNULL(LocalCosts.ItemizedVariableCostsCompl, 0)
	|				+ ISNULL(LocalCosts.LaborCostsLocal, 0)) AS NUMBER(31,2)) AS LocalCost,
	|
	|	CAST(AdjustmentTable.NumberOfPersonalData
	|			* ISNULL(LocalCosts.CostOfPersonalIncomeTax, 0) AS NUMBER(31,2)) AS CostOfPersonalIncomeTax,
	|
	|	CAST(
	|		AdjustmentTable.NumberOfMen
	|			* (ISNULL(LocalCosts.CostMan, 0)
	|				+ ISNULL(LocalCosts.AddExpensesMan, 0)
	|				+ ISNULL(LocalCosts.ItemizedFixedCostsManag, 0)
	|				+ ISNULL(LocalCosts.ItemizedVariableCostsManag, 0)
	|				+ ISNULL(LocalCosts.LaborCostsMan, 0)) AS NUMBER(31,2)) AS CostMan
	|FROM
	|	TTAdjustmentTable AS AdjustmentTable
	|		
	|	LEFT JOIN ChartOfCharacteristicTypes.ExpenseItems AS CorExpenseItem
	|	ON CorExpenseItem.Ref = AdjustmentTable.ExpenseItemRecipient
	|	
	|	LEFT JOIN TTArticleExceptionsForValueWithoutVAT AS ArticlesOfExclusion
	|	ON ArticlesOfExclusion.Ref = AdjustmentTable.ExpenseItemRecipient
	|	
	|	LEFT JOIN Catalog.BusinessTransactionsSettings AS BsnsTransactionsSettings
	|	ON BsnsTransactionsSettings.BusinessOperation = AdjustmentTable.BusinessOperation
	|	
	|	LEFT JOIN
	|		TTValueOfWorkInProgress AS Costs_2
	|	ON 
	|		AdjustmentTable.Organization = Costs_2.Organization
	|		AND AdjustmentTable.Department = Costs_2.Department
	|		AND AdjustmentTable.LineOfBusiness = Costs_2.LineOfBusiness
	|		AND AdjustmentTable.ExpenseItem = Costs_2.ExpenseItem
	|		AND AdjustmentTable.DimensionOfExpenses = Costs_2.DimensionOfExpenses
	|		AND Costs_2.Lot = VALUE(Catalog.ProductionLots.EmptyRef)
	|		
	|	LEFT JOIN
	|		TTValueOfWorkInProgressLocal AS LocalCosts
	|	ON 
	|		AdjustmentTable.Organization = LocalCosts.Organization
	|		AND AdjustmentTable.Department = LocalCosts.Department
	|		AND AdjustmentTable.LineOfBusiness = LocalCosts.LineOfBusiness
	|		AND AdjustmentTable.ExpenseItem = LocalCosts.ExpenseItem
	|		AND AdjustmentTable.DimensionOfExpenses = LocalCosts.DimensionOfExpenses
	|		AND LocalCosts.Lot = VALUE(Catalog.ProductionLots.EmptyRef)
	|WHERE
	|	NOT (AdjustmentTable.Count = 0
	|		AND AdjustmentTable.QuantityWithoutVAT = 0
	|		AND AdjustmentTable.NumberOfLocal = 0
	|		AND AdjustmentTable.NumberOfTA = 0
	|		AND AdjustmentTable.NumberOfPersonalData = 0
	|		AND AdjustmentTable.NumberOfMen = 0)
	|
	|ORDER BY
	|	AdjustmentTable.Organization,
	|	AdjustmentTable.ExpenseItem,
	|	AdjustmentTable.DimensionOfExpenses,
	|	AdjustmentTable.Department,
	|	AdjustmentTable.ExpenseItemRecipient,
	|	AdjustmentTable.ExpensesDimensionRecipient,
	|	AdjustmentTable.Period,
	|	AdjustmentTable.Recorder,
	|	AdjustmentTable.RowID
	|";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	// Movements are formed by registers:
	// - Other expenses
	While Selection.Next() Do
		
		CashFlowsOtherExpensesOtherWriteOffOfUnfinishedProduction(CalculationParameters, Selection);
		CashFlowsIncomeExpensesOtherAssetsLiabilitiesOtherWriteOffUnfinishedProduction(CalculationParameters, Selection);
		
	EndDo;
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, "TTAdjustmentTable, TTArticleExceptionsForValueWithoutVAT");
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);
	
EndProcedure

Procedure AdjustCostOfAdditionalExpenses(CalculationParameters, Primary_1) Export
	
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing
	 And Not CalculationParameters.DistributionOfAdditionalCostsBetweenPartiesAndGoods Then
		Return;
	EndIf;
	
	If Primary_1 Then
		CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfAdditionalExpenses_Stage1");
	Else
		CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfAdditionalExpenses_Stage2");
	EndIf;
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"RegisteredRecordsTimeAdjustmentTable");
		
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextAdjustCostOfAdditionalExpenses(Primary_1));
		
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfAdditionalExpenses_FormationOfRegisteredRecords");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	#Region IDsTable
	
	Query.Text = "
	|SELECT
	|	T.RecNo
	|FROM
	|	RegisteredRecordsTimeAdjustmentTable AS T
	|WHERE
	|	T.FinRecordID = """"
	|";
	
	IDsTable = New ValueTable;
	IDsTable.Columns.Add("Id", Common.StringTypeDetails(36));
	IDsTable.Columns.Add("RecNo", Common.TypeDescriptionNumber(31));
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	While Selection.Next() Do
		NewRow = IDsTable.Add();
		NewRow.Id = New UUID;
		NewRow.RecNo = Selection.RecNo;
	EndDo;
	
	Query.SetParameter("IDsTable", IDsTable);
	
	Query.Text = "
	|SELECT
	|	IDsTable.Id AS Id,
	|	IDsTable.RecNo AS RecNo
	|INTO IDsTable
	|FROM
	|	&IDsTable AS IDsTable
	|INDEX BY
	|	RecNo
	|;
	|";
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	#EndRegion
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"RegisteredRecordsAdjustmentTable, SharesOfAdditionalExpensesForVAT");
		
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextAdjustCostOfAdditionalExpensesFormationOfRegisteredRecords());
		
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
	MatchingTemporaryMovementTables = New Map;
	
	// Movements are formed by registers:
	// - Other expenses
	// - Cost of goods
	
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpenses Then
		GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables);
		GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables, False);
	EndIf;
	GenerateRegisteredRecordsOtherAssetsLiabilitiesAdditionalExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables);
	GenerateRegisterRecordsForOtherAssetsLiabilitiesAdditionalExpensesAmountByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables);

	GenerateTotalCostOfGoodsAndAdditionalExpensesWithRequest(CalculationParameters, MatchingTemporaryMovementTables, False);
	GenerateTotalCostOfGoodsAndAdditionalExpensesWithRequest(CalculationParameters, MatchingTemporaryMovementTables, True);
	
	GenerateFollowingProductsIncomeAndExpensesQuery(CalculationParameters, MatchingTemporaryMovementTables);
	GenerateRevenueAndCostRegisteredRecordsAndExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables);
	
	GenerateRegisteredRecordsOfDeviationsInCostOfGoodsAdditionalExpensesByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables);
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	TempTablesToDelete = New Array;
	TempTablesToDelete.Add("RegisteredRecordsAdjustmentTable");
	For Each KeyValue In MatchingTemporaryMovementTables Do
		TempTablesToDelete.Add(KeyValue.Key);
	EndDo;
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, StrConcat(TempTablesToDelete, ","));
	
EndProcedure

Function TextAdjustCostOfAdditionalExpenses(Primary_1)
	
	QueryText = "";
	
	#Region TTTimeAdjustmentTable
	
	If Primary_1 Then
		//@skip-check bsl-ql-hub
		QueryText = QueryText + 
			"SELECT
			|	RECORDAUTONUMBER() AS RecNo,
			|	VALUE(AccumulationRecordType.Expense) AS RecordType,
			|	RegisterRecords.Recorder AS Recorder,
			|	RegisterRecords.ReceiptPeriod AS ReceiptPeriod,
			|	RegisterRecords.AdjustmentPeriod_ AS AdjustmentPeriod_,
			|	Attributes.Date AS Period,
			|	Attributes.Organization AS Organization,
			|	Attributes.Department AS Department,
			|	Attributes.LineOfBusiness AS LineOfBusiness,
			|	Attributes.ExpenseItem AS ExpenseItem,
			|	Attributes.ExpenseItem.EnteredInTaxAccounting AS EnteredInTaxAccounting,
			|	Attributes.DimensionOfExpenses AS DimensionOfExpenses,
			|	RegisterRecords.CorCompany AS CorCompany,
			|	RegisterRecords.CorAccountingSection AS AccountingSection,
			|	RegisterRecords.CorItemsLocationAttributes AS ItemsLocationAttributes,
			|	RegisterRecords.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
			|	RegisterRecords.CorLot AS Lot,
			|	RegisterRecords.LotVendorAttributesCorr AS LotVendorAttributes,
			|	RegisterRecords.CorControllingAttributes AS FinancialAccountingDimension,
			|	RegisterRecords.CorVATActivityTypes AS VATActivityType,
			|	RegisterRecords.CorExpenseItem AS CorExpenseItem,
			|	RegisterRecords.CorExpenseItem.EnteredInTaxAccounting AS CorAcceptanceForTaxAccounting,
			|	RegisterRecords.CorExpenditureDimension AS CorExpenditureDimension,
			|	RegisterRecords.CorArticleOfAssetsLiabilities AS CorArticleOfAssetsLiabilities,
			|	RegisterRecords.CorDimensionOfAssetsLiabilities AS CorDimensionOfAssetsLiabilities,
			|	RegisterRecords.CorSettingUpAccountingAccounts AS CorSettingUpAccountingAccounts,
			|	RegisterRecords.DebitBusinessUnit AS DebitBusinessUnit,
			|	RegisterRecords.CorLineOfBusiness AS CorLineOfBusiness,
			|	RegisterRecords.BusinessOperation,
			|	RegisterRecords.EntryType,
			|	RegisterRecords.SourceOfProductFinancialAccountingGroup,
			|	RegisterRecords.AccountingDimensionByPartners,
			|	RegisterRecords.SalesOrder,
			|	RegisterRecords.Manager,
			|	RegisterRecords.Warehouse,
			|	RegisterRecords.Terms,
			|	RegisterRecords.Contract,
			|	RegisterRecords.InventoryType,
			|	RegisterRecords.CounterpartyLineOfBusiness,
			|	RegisterRecords.SourceOfARAPFinancialAccountingGroup,
			|	RegisterRecords.VATTaxationPartySTypeOfActivity,
			|	RegisterRecords.TypeOfActivityVATDisposals,
			|	RegisterRecords.FinRecordID,
			|	(CASE
			|		WHEN Attributes.ManagementAccounting
			|			THEN CAST(RegisterRecords.CostShare * ISNULL(Costs_2.CostInclVAT, 0) AS NUMBER(31, 2))
			|		ELSE 0 END) AS AddExpensesForGoods,
			|	(CASE
			|		WHEN Attributes.ManagementAccounting
			|			THEN CAST(RegisterRecords.ShareOfValueWithoutVAT * ISNULL(Costs_2.CostExcludingVAT, 0) AS NUMBER(31, 2))
			|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
			|	(CASE
			|		WHEN Attributes.LocalAccounting
			|			THEN CAST(RegisterRecords.ShareOfLocalValue * ISNULL(Costs_2.LocalCost, 0) AS NUMBER(31, 2))
			|		ELSE 0 END) AS AddExpensesLocal,
			|	(CASE
			|		WHEN Attributes.ManagementAccounting
			|			THEN CAST(RegisterRecords.ShareOfManSCost * ISNULL(Costs_2.CostMan, 0) AS NUMBER(31, 2))
			|		ELSE 0 END) AS AddExpensesMan,
			|	0 AS ItemizedFixedCostsIncludingVAT,
			|	0 AS ItemizedVariableCostsIncludingVAT,
			|	0 AS ItemizedFixedCostsExcludingVAT,
			|	0 AS ItemizedVariableCostsExcludingVAT,
			|	0 AS ItemizedFixedCostsCompl,
			|	0 AS ItemizedVariableCostsCompl,
			|	0 AS ItemizedFixedCostsManag,
			|	0 AS ItemizedVariableCostsManag,
			|	0 AS PermanentDifference,
			|	0 AS CostTD,
			|	0 AS CostInTaxAccounting,
			|	0 AS CostOfPersonalIncomeTax
			|
			|INTO TTTimeAdjustmentTable
			|FROM
			|	SharesOfAdditionalExpenses AS RegisterRecords
			|		INNER JOIN Document.AllocationOfOtherCosts AS Attributes
			|		ON RegisterRecords.Recorder = Attributes.Ref
			|		LEFT JOIN CostOfAdditionalExpenses AS Costs_2
			|		ON Attributes.Organization = Costs_2.Organization
			|			AND Attributes.Department = Costs_2.Department
			|			AND Attributes.LineOfBusiness = Costs_2.LineOfBusiness
			|			AND Attributes.ExpenseItem = Costs_2.ExpenseItem
			|			AND Attributes.DimensionOfExpenses = Costs_2.DimensionOfExpenses
			|WHERE
			|	Attributes.Organization IN(&CompanyArray)
			// We exclude expenses distributed according to the database of the previous period. 
			// The Registered Records for such expenses are formed in the stage of adjusting the cost of the previous periods.
			|	AND NOT (RegisterRecords.ReceiptPeriod < &BeginOfPeriod
			|		 AND Attributes.Organization IN (&CompaniesWithDistributionOfDeviationsInPastPeriods))
			|INDEX BY
			|	Recorder,
			|	Lot,
			|	AccountingSection,
			|	ItemsLocationAttributes
			|;";
	Else
		QueryText = QueryText + 
			"SELECT
			|	RECORDAUTONUMBER() AS RecNo,
			|	VALUE(AccumulationRecordType.Expense) AS RecordType,
			|	RegisterRecords.Recorder AS Recorder,
			|	RegisterRecords.ReceiptPeriod AS ReceiptPeriod,
			|	RegisterRecords.AdjustmentPeriod_ AS AdjustmentPeriod_,
			|	Attributes.Date AS Period,
			|	Attributes.Organization AS Organization,
			|	Attributes.Department AS Department,
			|	Attributes.LineOfBusiness AS LineOfBusiness,
			|	Attributes.ExpenseItem AS ExpenseItem,
			|	Attributes.ExpenseItem.EnteredInTaxAccounting AS EnteredInTaxAccounting,
			|	Attributes.DimensionOfExpenses AS DimensionOfExpenses,
			|	RegisterRecords.CorCompany AS CorCompany,
			|	RegisterRecords.CorAccountingSection AS AccountingSection,
			|	RegisterRecords.CorItemsLocationAttributes AS ItemsLocationAttributes,
			|	RegisterRecords.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
			|	RegisterRecords.CorLot AS Lot,
			|	RegisterRecords.LotVendorAttributesCorr AS LotVendorAttributes,
			|	RegisterRecords.CorControllingAttributes AS FinancialAccountingDimension,
			|	RegisterRecords.CorVATActivityTypes AS VATActivityType,
			|	RegisterRecords.CorExpenseItem AS CorExpenseItem,
			|	RegisterRecords.CorExpenseItem.EnteredInTaxAccounting AS CorAcceptanceForTaxAccounting,
			|	RegisterRecords.CorExpenditureDimension AS CorExpenditureDimension,
			|	RegisterRecords.CorArticleOfAssetsLiabilities AS CorArticleOfAssetsLiabilities,
			|	RegisterRecords.CorDimensionOfAssetsLiabilities AS CorDimensionOfAssetsLiabilities,
			|	RegisterRecords.CorSettingUpAccountingAccounts AS CorSettingUpAccountingAccounts,
			|	RegisterRecords.DebitBusinessUnit AS DebitBusinessUnit,
			|	RegisterRecords.CorLineOfBusiness AS CorLineOfBusiness,
			|	RegisterRecords.BusinessOperation,
			|	RegisterRecords.EntryType,
			|	RegisterRecords.SourceOfProductFinancialAccountingGroup,
			|	RegisterRecords.AccountingDimensionByPartners,
			|	RegisterRecords.SalesOrder,
			|	RegisterRecords.Manager,
			|	RegisterRecords.Warehouse,
			|	RegisterRecords.Terms,
			|	RegisterRecords.Contract,
			|	RegisterRecords.InventoryType,
			|	RegisterRecords.CounterpartyLineOfBusiness,
			|	RegisterRecords.SourceOfARAPFinancialAccountingGroup,
			|	RegisterRecords.VATTaxationPartySTypeOfActivity,
			|	RegisterRecords.TypeOfActivityVATDisposals,
			|	RegisterRecords.FinRecordID,
			|
			|	0 AS AddExpensesForGoods,
			|	0 AS AdditionalExpensesExcludingVAT,
			|	0 AS AddExpensesLocal,
			|	0 AS AddExpensesMan,
			|
			|	CASE WHEN Attributes.ManagementAccounting THEN 1 ELSE 0 END *
			|		CAST(RegisterRecords.CostShare
			|			* ISNULL(Costs_2.ItemizedFixedCostsIncludingVAT, 0) AS NUMBER(31, 2)) AS ItemizedFixedCostsIncludingVAT,
			|	CASE WHEN Attributes.ManagementAccounting THEN 1 ELSE 0 END *
			|		CAST(RegisterRecords.CostShare
			|			* ISNULL(Costs_2.ItemizedVariableCostsIncludingVAT, 0) AS NUMBER(31, 2)) AS ItemizedVariableCostsIncludingVAT,
			|	CASE WHEN Attributes.ManagementAccounting THEN 1 ELSE 0 END *
			|		CAST(RegisterRecords.ShareOfValueWithoutVAT
			|			* ISNULL(Costs_2.ItemizedFixedCostsExcludingVAT, 0) AS NUMBER(31, 2)) AS ItemizedFixedCostsExcludingVAT,
			|	CASE WHEN Attributes.ManagementAccounting THEN 1 ELSE 0 END *
			|		CAST(RegisterRecords.ShareOfValueWithoutVAT
			|			* ISNULL(Costs_2.ItemizedVariableCostsExcludingVAT, 0) AS NUMBER(31, 2)) AS ItemizedVariableCostsExcludingVAT,
			|	CASE WHEN Attributes.LocalAccounting THEN 1 ELSE 0 END *
			|		CAST(RegisterRecords.ShareOfLocalValue 
			|			* ISNULL(LocalCosts.ItemizedFixedCostsCompl, 0) AS NUMBER(31, 2)) AS ItemizedFixedCostsCompl,
			|	CASE WHEN Attributes.LocalAccounting THEN 1 ELSE 0 END *
			|		CAST(RegisterRecords.ShareOfLocalValue 
			|			* ISNULL(LocalCosts.ItemizedVariableCostsCompl, 0) AS NUMBER(31, 2)) AS ItemizedVariableCostsCompl,
			|	0 AS PermanentDifference,
			|	0 AS CostTD,
			|	CAST(RegisterRecords.ShareValueTa 
			|			* ISNULL(LocalCosts.CostInTaxAccounting, 0) AS NUMBER(31, 2)) AS CostInTaxAccounting,
			|	CAST(RegisterRecords.ShareOfCostOfPersonalIncomeTax 
			|			* ISNULL(LocalCosts.CostOfPersonalIncomeTax, 0) AS NUMBER(31, 2)) AS CostOfPersonalIncomeTax,
			|	CAST(RegisterRecords.ShareOfManSCost 
			|		* ISNULL(LocalCosts.ItemizedFixedCostsManag, 0) AS NUMBER(31, 2)) AS ItemizedFixedCostsManag,
			|	CAST(RegisterRecords.ShareOfManSCost 
			|		* ISNULL(LocalCosts.ItemizedVariableCostsManag, 0) AS NUMBER(31, 2)) AS ItemizedVariableCostsManag
			|INTO TTTimeAdjustmentTable
			|FROM
			|	SharesOfAdditionalExpenses AS RegisterRecords
			|		INNER JOIN Document.AllocationOfOtherCosts AS Attributes
			|		ON RegisterRecords.Recorder = Attributes.Ref
			|		LEFT JOIN TtOfCostOfAdditionalExpenses AS Costs_2
			|		ON Attributes.Organization = Costs_2.Organization
			|			AND Attributes.Department = Costs_2.Department
			|			AND Attributes.LineOfBusiness = Costs_2.LineOfBusiness
			|			AND Attributes.ExpenseItem = Costs_2.ExpenseItem
			|			AND Attributes.DimensionOfExpenses = Costs_2.DimensionOfExpenses
			|		LEFT JOIN CostOfAdditionalExpenses AS ACCosts
			|		ON Attributes.Organization = ACCosts.Organization
			|			AND Attributes.Department = ACCosts.Department
			|			AND Attributes.LineOfBusiness = ACCosts.LineOfBusiness
			|			AND Attributes.ExpenseItem = ACCosts.ExpenseItem
			|			AND Attributes.DimensionOfExpenses = ACCosts.DimensionOfExpenses
			|		LEFT JOIN TtOfCostOfAdditionalLocalExpenses AS LocalCosts
			|		ON Attributes.Organization = LocalCosts.Organization
			|			AND Attributes.Department = LocalCosts.Department
			|			AND Attributes.LineOfBusiness = LocalCosts.LineOfBusiness
			|			AND Attributes.ExpenseItem = LocalCosts.ExpenseItem
			|			AND Attributes.DimensionOfExpenses = LocalCosts.DimensionOfExpenses
			|WHERE
			|	Attributes.Organization IN(&CompanyArray)
			// We exclude expenses distributed according to the database of the previous period. 
			// The Registered Records for such expenses are formed in the stage of adjusting the cost of the previous periods.
			|	AND NOT (RegisterRecords.ReceiptPeriod < &BeginOfPeriod
			|		 AND Attributes.Organization IN (&CompaniesWithDistributionOfDeviationsInPastPeriods))
			|INDEX BY
			|	Recorder,
			|	Lot,
			|	AccountingSection,
			|	ItemsLocationAttributes
			|;";
	EndIf;
	
	#EndRegion
	
	#Region RegisteredRecordsTimeAdjustmentTable
	
	QueryText = QueryText +
