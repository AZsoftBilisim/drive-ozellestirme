// Stage handlers.

Procedure Usage_BatchAndCostCalculation(HandlerParameters) Export
	
	CalculationParameters = HandlerParameters.CalculationParameters;
	CalculationPeriod    = CalculationParameters.RegistrationPeriod;
	
	// Let's check the cost accounting - the calculation is possible starting from the month preceding the start of accounting (from the moment of entering balances).
	If Not CalculationOfCostCached.CostCalculationIsPossible(BegOfMonth(CalculationPeriod)) Then
		MonthEndTransactionsServer.NoNeedToSetState(
			HandlerParameters,
			NStr("vi = 'Không có bản ghi kết chuyển theo biểu ghi giá vốn và chi phí khác.';
				|ru = 'Нет движений по регистрам себестоимости и прочих расходов.';
				|en = 'No records in registers of cost and other expenses.'; fa = 'No records in registers of cost and other expenses.';
				|it = 'Non ci sono movimenti nei registri dei costi di produzioni e altre spese.';
				|pl = 'Brak przepływów wg rejestrów kosztów własnych i innych wydatków.';
				|tr = 'Maliyet ve diğer gider kayıtlarında herhangi bir hareket bulunmamaktadır.'"));
		Return;
	EndIf;
	
	If HandlerParameters.Property("OnlyOneOrganization") And HandlerParameters.OnlyOneOrganization Then
		HandlerParameters.Data_Stage.CompanyArray = TMCommonUseClientServer.Array(CalculationParameters.CompanyArray);
	Else
		// We will add organizations connected by Intercampany and add information messages.
		HandlerParameters.Data_Stage.CompanyArray = CostCalculationAppliedAlgorithms.LinksOfOrganizationsUnderIntercampanyScheme(
			CalculationPeriod,
			CalculationParameters.CompanyArray);
	EndIf;
	
	CompanyArray = HandlerParameters.Data_Stage.CompanyArray;
	ArrayOfAdditionalOrganizations = New Array;
	
	For Each CurrentCompany In CompanyArray Do
		If CalculationParameters.CompanyArray.Find(CurrentCompany) = Undefined Then
			ArrayOfAdditionalOrganizations.Add(CurrentCompany);
		EndIf;
	EndDo;
	
	MonthEndTransactionsServer.IncreaseAmountOfProcessedDataForMeasurement(HandlerParameters, CompanyArray.Count());
	
	If ArrayOfAdditionalOrganizations.Count() > 0 Then
		
		TextAdditionalOrganizations = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Ngoài ra, sẽ thực hiện hạch toán đối với doanh nghiệp mà có liên quan theo sơ đồ Liên công ty: %1';
				|ru = 'Также будет выполнен расчет для организаций, связанных по схеме Интеркампани: %1';
				|en = 'Calculation will be also performed for companies connected under Intercompany: %1'; fa = 'Calculation will be also performed for companies connected under Intercompany: %1';
				|it = 'Verrà inoltre effettuato un calcolo per le organizzazioni collegate dallo schema Intercompany: %1';
				|pl = 'Również będzie wykonane obliczenia dla firm, związanych wg schematu Intercompany: %1';
				|tr = 'Şirketler arası şeması aracılığıyla bağlantılı iş yerleri için de bir hesaplama yapılacaktır: %1'", Common.DefaultLanguageCode()),
			CostCalculationAppliedAlgorithms.CalculatedCompanies(ArrayOfAdditionalOrganizations, ", ", True));
		
		MonthEndTransactionsServer.AddExplanatoryInformationToStep(
			HandlerParameters,
			TextAdditionalOrganizations,
			,
			,
			Enums.AccountingIssueSeverity.ImportantInformation);
		
	EndIf;
	
	MonthEndTransactionsServer.IncreaseAmountOfProcessedDataForMeasurement(HandlerParameters, CompanyArray.Count());
	
	If CostCalculationAppliedAlgorithms.CheckWhetherYouNeedToEnableDistributionOfAdditionalExpensesForDiscardedItemsSetting(CalculationParameters) Then
		
		RecommendationText = NStr("vi = 'Đã tìm thấy chi phí mà có thể ghi giảm vào hàng xuất của các kỳ trước.
			|Nên bật tùy chỉnh ""Phân bổ chi phí bổ sung cho hàng đã xuất"".';
			|ru = 'Обнаружены расходы, которые можно списать на выбытия прошлых периодов.
			|Рекомендуется включить настройку ""Распределение доп. расходов по выбывшим товарам"".';
			|en = 'Expenses which can be written off as outflows of previous periods are detected.
			|It is recommended that you enable the ""Allocation of additional expenses by disposed goods"" setting.'; fa = 'Expenses which can be written off as outflows of previous periods are detected.
			|It is recommended that you enable the ""Allocation of additional expenses by disposed goods"" setting.';
			|it = 'Trovate delle spese che si possono stornare sulle smobilitazioni dei periodi passati.
			|Si consiglia di attivare l''impostazione ""Ammortizzazione delle spese aggiuntive sui beni smobilitati"".';
			|pl = 'Wykryto rozchody, które mogą być wyksięgowane do zbyć minionych okresów.
			|Zalecane jest włączenie ustawienia ""Распределение доп. расходов по выбывшим товарам"".';
			|tr = 'Önceki dönem giderlerine kaydedilecek giderler belirlenmiştir.
			|""Elden çıkarılan ürünlere ek gider dağıt"" ayarının etkinleştirilmesi önerilmektedir.'", Common.DefaultLanguageCode());
		
		ActionDetails = MonthEndTransactionsServer.ActionDescription_OpenForm(
				Metadata.DataProcessors.TMAdministrationPanel.Forms.FinancialResultAndControlling.FullName());
		
		MonthEndTransactionsServer.AddExplanatoryInformationToStep(
			HandlerParameters,
			RecommendationText,
			,
			ActionDetails,
			Enums.AccountingIssueSeverity.UsefulTip);
		
	EndIf;
	
	StartOfSettlementPeriod = Max(
		CostCalculationAppliedAlgorithms.StartOfSettlementPeriod(CalculationPeriod, CompanyArray),
		BegOfMonth(BegOfMonth(Constants.CostAccountingStartDate.Get()) - 1));
	
	If StartOfSettlementPeriod <= CalculationPeriod Then
		
		HandlerParameters.Data_Stage.SettlementStartDate = StartOfSettlementPeriod;
		
		MonthEndTransactionsServer.SetStateFailed(
			HandlerParameters,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Cần tính lại mà bắt đầu từ kỳ %1.';
					|ru = 'Требуется пересчет начиная с периода %1.';
					|en = 'Recalculation is required starting from the period of %1.'; fa = 'Recalculation is required starting from the period of %1.';
					|it = 'È necessario il ricalcolo a partire dal periodo %1.';
					|pl = 'Potrzebne jest przeliczenie zaczynając od okresu %1.';
					|tr = 'Dönem %1''den başlayarak yeniden hesaplama gerektirir.'"),
				CostCalculationProtocol.PresentationOfCalculationPeriod(StartOfSettlementPeriod)));
		Return; // the parties are not relevant
		
	EndIf;
	
	MonthEndTransactionsServer.IncreaseAmountOfProcessedDataForMeasurement(HandlerParameters, 1);
	
	If CostCalculationAppliedAlgorithms.ThereAreIncorrectCostRegisteredRecords(CalculationPeriod, CompanyArray) Then
		
		MonthEndTransactionsServer.SetStateFailed(
			HandlerParameters,
			NStr("vi = 'Còn chưa tính lại kỳ trong kế toán theo lô, phiên bản 2.2.';
				|ru = 'Период еще не был пересчитан в партионном учете версии 2.2.';
				|en = 'Period has not been recalculated in lot accounting 2.2.'; fa = 'Period has not been recalculated in lot accounting 2.2.';
				|it = 'Il periodo non è ancora stato ricalcolato nella contabilità a lotti della versione 2.2.';
				|pl = 'Okres jeszcze nie został przeliczony w ewidencji wg partii wersji 2.2.';
				|tr = 'Dönem, lot muhasebesi sürüm 2.2''de henüz yeniden hesaplanmamıştır.'"));
		Return; // the period was not calculated in the batch accounting version 2.2
		
	EndIf;
	
	OrganizationsWithCostRegisteredRecords = CostCalculationAppliedAlgorithms.OrganizationsWithCostRegisteredRecords(
		CalculationPeriod,
		CompanyArray);
		
	If CostCalculationAppliedAlgorithms.ThereAreMandatoryAdjustmentsToBalances(CalculationPeriod) Then
		OrganizationsWithCostBalances = CostCalculationAppliedAlgorithms.OrganizationsWithCostBalances(
			CalculationPeriod,
			CompanyArray);
	Else
		OrganizationsWithCostBalances = Undefined;
	EndIf;
	
	MonthEndTransactionsServer.IncreaseAmountOfProcessedDataForMeasurement(HandlerParameters, OrganizationsWithCostRegisteredRecords.Count());
	
	If (ValueIsFilled(OrganizationsWithCostRegisteredRecords)
	 	And Not CostCalculationAppliedAlgorithms.ThereAreDocumentsForCalculatingCost(CalculationPeriod, OrganizationsWithCostRegisteredRecords))
	 Or (ValueIsFilled(OrganizationsWithCostBalances)
	 	And Not CostCalculationAppliedAlgorithms.ThereAreDocumentsForCalculatingCost(BegOfMonth(CalculationPeriod - 1), OrganizationsWithCostBalances)) Then
		
		MonthEndTransactionsServer.SetStateFailed(
			HandlerParameters,
			NStr("vi = 'Còn chưa thực hiện tính toán giá vốn trong kỳ này.';
				|ru = 'Расчет себестоимости в данном периоде еще не выполнялся.';
				|en = 'Cost has not been calculated in this period.'; fa = 'Cost has not been calculated in this period.';
				|it = 'La contabilizzazione del costo di produzione in questo periodo non è ancora stata effettuata.';
				|pl = 'Obliczenie kosztów własnych w danym okresie jeszcze nie było wykonywane.';
				|tr = 'Bu dönemde maliyet hesabı henüz gerçekleştirilmedi.'"),
			,
			,
			Enums.AccountingIssueSeverity.Warning);
		Return;
		
	EndIf;
	
	If HandlerParameters.CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.FinalClosing
	 And CostCalculationAppliedAlgorithms.ThereAreDocumentsOfPreliminaryCostCalculation(CalculationPeriod, 
	 	OrganizationsWithCostRegisteredRecords) Then
	 		
	 	MonthEndTransactionsServer.SetStateFailed(
			HandlerParameters,
			NStr("vi = 'Trong kỳ này chỉ thực hiện đóng tháng sơ bộ.';
				|ru = 'В данном периоде было выполнено только предварительное закрытие месяца.';
				|en = 'Only preliminary month-end closing has been performed in this period.'; fa = 'Only preliminary month-end closing has been performed in this period.';
				|it = 'In questo periodo è stata eseguita solo la chiusura preliminare del mese.';
				|pl = 'W niniejszym okresie było wykonane tylko wstępne zamknięcie miesiąca.';
				|tr = 'Bu dönemde sadece ay sonu kapanışı yapılmıştır.'"),
			,
			,
			Enums.AccountingIssueSeverity.Warning);
		Return;
		
