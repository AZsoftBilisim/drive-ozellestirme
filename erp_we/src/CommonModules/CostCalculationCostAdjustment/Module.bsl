Procedure CalculatingDifferenceFromPreviousCalculations(CalculationParameters)
	
	If CalculationParameters.AccountingPolicies.MovingAverage.UsedInCurPeriod.Count() = 0
	 And CalculationParameters.CompaniesWithDistributionOfDeviationsInPastPeriods.Count() = 0 Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "CalculatingDifferenceFromPreviousCalculations");

	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	MatchingTemporaryMovementTables = New Map;
	
	For Each KeyAndValue In CalculationParameters.RegisterRecords Do
		
		RegisterName = KeyAndValue.Key;
		ReceiverDescription = KeyAndValue.Value;
		
		If Not Metadata.Documents.CostCalculationRecorder.RegisterRecords.Contains(ReceiverDescription.RegisterMetadata)
		 Or CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, ReceiverDescription.RegisterCacheTableName) = 0 Then
			Continue;
		EndIf;
		
		SourceTableName = "TTSource" + RegisterName;
		DestinationTableName = "TTReceiver" + RegisterName;
		
		Query.Text =
		"SELECT
		|	TRUE AS NewRegisteredRecords_,
		|	T.Recorder,
		|	&ServiceFieldTypeOfRegisterRecorded AS RecordType,
		|	&CacheFieldsFromRegister,
		|	&ZeroRegisterResources
		|INTO RegisterRecordTablePreliminary
		|FROM
		|	RegisterCacheTableName AS T
		|	INNER JOIN Document.CostCalculationRecorder AS Filter
		|		ON T.Recorder = Filter.Ref
		|
		|UNION ALL
		|
		|SELECT
		|	FALSE AS NewRegisteredRecords_,
		|	VALUE(Document.CostCalculationRecorder.EmptyRef) AS Recorder,
		|	&RegisterRecordTypeField AS RecordType,
		|	&FieldsOfMainRegisterTable,
		|	&NegativeRegisterResources
		|FROM
		|	RegisterTableName  AS T
		|	INNER JOIN Document.CostCalculationRecorder AS Filter
		|		ON T.Recorder = Filter.Ref
		|WHERE
		|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
		|
		// Below the indexing fields are replaced by register indexes
		|INDEX BY NewRegisteredRecords_
		|;
		|
		|SELECT
		|	MAX(T.NewRegisteredRecords_) AS NewRegisteredRecords_,
		|	MAX(T.Recorder) AS Recorder,
		|	T.RecordType,
		|	&SelectingRegisterField,
		|	&AmountOfRegisterResources
		|INTO SourceTableName
		|FROM
		|	RegisterRecordTablePreliminary AS T
		|GROUP BY
		|	T.RecordType,
		|	&FieldsGrouping
		|HAVING
		|	MAX(T.NewRegisteredRecords_) = TRUE
		|	AND (&SelectingNonEmptyResources)
		|";
		
		// Replacement templates in the request text
		TextSelectionOfNonEmptyResources 		  = "";
		TextFieldGrouping 	   		  = "";
		TextOfRegisterCacheField			  = "";
		FieldTextOfMainRegisterTable  = "";
		TextSelectionCaseField	  	  = "";
		
		TextZeroRegisterResources		  = "";
		TextNegativeRegisterResources = "";
		TextAmountOfRegisterResources		  = "";
		
		TextFieldViewOfRegisteredRecording			  = "UNDEFINED";
		TextServiceTypeOfRegisteredRecords	  	  = "UNDEFINED";
		
		FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
			StrReplace(ReceiverDescription.RegisterCacheFields, "%1", "T."),
			",",
			True,
			True);
		ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
			StrReplace(ReceiverDescription.SelectionFieldsOfNonemptyMotions, "%1", "T."),
			",",
			True,
			True);
		ServiceFields = New Structure("Recorder");
		
		IDFields = New Structure("DocumentCalculation, DocumentRegisterRecords, MonthEndClosingMode");
		IDFields.Insert("CostDefiningMethod");
		IDFields.Insert("CostCalculationDate");
		
		For Each CurrentField In FieldArray Do
			
			CurrentFieldIsShort = StrReplace(CurrentField, "T.", "");
			
			If ServiceFields.Property(CurrentFieldIsShort) Then
				Continue;
			EndIf;
			
			ThisIsRegisterResource = (ArrayOfResources.Find(CurrentField) <> Undefined);
			
			If ThisIsRegisterResource Then
				
				// Resource
				TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
					+ ?(TextSelectionOfNonEmptyResources = "", "", "
					|	OR ") + "SUM(" + CurrentField + ") <> 0";
				TextZeroRegisterResources = TextZeroRegisterResources 
					+ ?(TextZeroRegisterResources = "", "", ",
					|	") + "0 AS " + CurrentFieldIsShort;
				TextNegativeRegisterResources = TextNegativeRegisterResources 
					+ ?(TextNegativeRegisterResources = "", "", ",
					|	") + "-" + CurrentField + " AS " + CurrentFieldIsShort;
				TextAmountOfRegisterResources = TextAmountOfRegisterResources 
					+ ?(TextAmountOfRegisterResources = "", "", ",
					|	") + "SUM(" + CurrentField + ") AS " + CurrentFieldIsShort;
				
			ElsIf CurrentFieldIsShort = "RecordType" Or CurrentFieldIsShort = "OfficialTypeOfMovementParish" Then
					
				TextFieldViewOfRegisteredRecording	  = "T.RecordType";
				TextServiceTypeOfRegisteredRecords =
					"CASE WHEN T.OfficialTypeOfMovementParish
					|		THEN VALUE(AccumulationRecordType.Receipt)
					|		ELSE VALUE(AccumulationRecordType.Expense)
					|	END";
				
			ElsIf IDFields.Property(CurrentFieldIsShort) Then

				TextOfRegisterCacheField = TextOfRegisterCacheField 
					+ ?(TextOfRegisterCacheField = "", "", ",
					|	") + CurrentField + " AS " + CurrentFieldIsShort;
				
				If CurrentFieldIsShort = "DocumentCalculation" Then
					FieldTextOfMainRegisterTable = FieldTextOfMainRegisterTable 
						+ ?(FieldTextOfMainRegisterTable = "", "", ",
						|	") + "VALUE(Document.CostCalculationRecorder.EmptyRef) AS " + CurrentFieldIsShort;
				Else
					FieldTextOfMainRegisterTable = FieldTextOfMainRegisterTable 
						+ ?(FieldTextOfMainRegisterTable = "", "", ",
						|	") + """"" AS " + CurrentFieldIsShort;
				EndIf;
				
				TextSelectionCaseField = TextSelectionCaseField 
					+ ?(TextSelectionCaseField = "", "", ",
					|	") + "MAX(" + CurrentField + ") AS " + CurrentFieldIsShort;
				
			Else
				
				// Measurement or props
				TextFieldGrouping = TextFieldGrouping 
					+ ?(TextFieldGrouping = "", "", ",
					|	") + CurrentField;
				TextOfRegisterCacheField = TextOfRegisterCacheField 
					+ ?(TextOfRegisterCacheField = "", "", ",
					|	") + CurrentField + " AS " + CurrentFieldIsShort;
				FieldTextOfMainRegisterTable = FieldTextOfMainRegisterTable 
					+ ?(FieldTextOfMainRegisterTable = "", "", ",
					|	") + CurrentField + " AS " + CurrentFieldIsShort;
				TextSelectionCaseField = TextSelectionCaseField 
					+ ?(TextSelectionCaseField = "", "", ",
					|	") + CurrentField;
				
			EndIf;
				
		EndDo;
		
		Query.Text = StrReplace(Query.Text, "&CacheFieldsFromRegister", TextOfRegisterCacheField);
		Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
		Query.Text = StrReplace(Query.Text, "&SelectingRegisterField", TextSelectionCaseField);
		
		Query.Text = StrReplace(Query.Text, "&AmountOfRegisterResources", TextAmountOfRegisterResources);
		Query.Text = StrReplace(Query.Text, "&ZeroRegisterResources", TextZeroRegisterResources);
		Query.Text = StrReplace(Query.Text, "&NegativeRegisterResources", TextNegativeRegisterResources);
		Query.Text = StrReplace(Query.Text, "&FieldsGrouping", TextFieldGrouping);
		Query.Text = StrReplace(Query.Text, "&SelectingNonEmptyResources", TextSelectionOfNonEmptyResources);
		Query.Text = StrReplace(Query.Text, "&RegisterRecordTypeField", TextFieldViewOfRegisteredRecording);
		Query.Text = StrReplace(Query.Text, "&ServiceFieldTypeOfRegisterRecorded", TextServiceTypeOfRegisteredRecords);
		If IsBlankString(ReceiverDescription.RegisterIndexes) Then
			Query.Text = StrReplace(Query.Text, "INDEX BY NewRegisteredRecords_", "INDEX BY" + " " + StrReplace(ReceiverDescription.RegisterDimensions, "%1", "T."));
		Else
			Query.Text = StrReplace(Query.Text, "INDEX BY NewRegisteredRecords_", "INDEX BY" + " " + StrReplace(ReceiverDescription.RegisterIndexes, "%1", "T."));
		EndIf;
		
		Query.Text = StrReplace(Query.Text, "SourceTableName", SourceTableName);
		Query.Text = StrReplace(Query.Text, "RegisterCacheTableName", ReceiverDescription.RegisterCacheTableName);
		Query.Text = StrReplace(Query.Text, "RegisterTableName", ReceiverDescription.FullRegisterName);
		
		CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
		
		CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
			CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
		
		CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
		
		FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
		CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
		
		CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
			CalculationParameters,
			FieldDescriptionTable,
			RegisterName,
			SourceTableName,
			DestinationTableName,,,,
			False);
		
		MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
		
		CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, "RegisterRecordTablePreliminary," + SourceTableName);
		
	EndDo;
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);	
		
EndProcedure

Procedure WriteOffDeviationsInCostOfItems(CalculationParameters)
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "WriteOffDeviationsInCostOfGoods_DataPreparation");
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"TTDataAdjustmentTable, TTDataAdjustmentTable_DeviationsInCostOfGoods,
		|WriteOffOfDeviationsOtherIncomeExpenses");
	
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextWriteOffDeviationsInCostOfGoodsDataPreparation(CalculationParameters));
	
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "WriteOffDeviationsInCostOfGoods_FormationOfRegisteredRecords");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	// Register-based Register Records are generated:
	// - Cost of goods
	// - Other expenses
	// - Other income
	MatchingTemporaryMovementTables = New Map;
	
	#Region InventoryCost
	
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTWriteOffOfDeviationsInventoryCosts";
	TemporaryTableNameSource = "TTDataAdjustmentTable";
	
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(CalculationParameters, ReceiverDescription, TemporaryTableNameSource);
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);

	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"BusinessOperation",
		"CASE WHEN TheseAreExpenses
		|		THEN VALUE(Enum.BusinessTransactions.GoodsValueVarianceExpenses)
		|	   WHEN TheseAreRevenues
		|		THEN VALUE(Enum.BusinessTransactions.GoodsValueVarianceIncome)
		|		ELSE VALUE(Enum.BusinessTransactions.ReverseProvisionsForImpairmentOfInventory)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"BusinessTransactionSetting",
		"CASE WHEN TheseAreExpenses
		|		THEN VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceExpenses)
		|	   WHEN TheseAreRevenues
		|		THEN VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceIncome)
		|		ELSE VALUE(Catalog.BusinessTransactionsSettings.ReverseProvisionsForImpairmentOfInventory)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"EntryType",
		"CASE WHEN TheseAreExpenses
		|		THEN VALUE(Enum.LotRecordTypes.GoodsCostVarianceForOtherExpenses)
		|	   WHEN TheseAreRevenues
		|		THEN VALUE(Enum.LotRecordTypes.CostVarianceForOtherIncome)
		|		ELSE VALUE(Enum.LotRecordTypes.EmptyRef)
		|	END");

	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"ExpenseItemOfWriteOff",
		"CASE WHEN TheseAreExpenses
		|		THEN ExpenseItem
		|		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"DimensionOfExpenses",
		"CASE WHEN TheseAreExpenses
		|		THEN Products
		|		ELSE UNDEFINED
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"IncomeItem",
		"CASE WHEN TheseAreRevenues
		|		THEN IncomeItem
		|		ELSE VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"DimensionOfRevenue",
		"CASE WHEN TheseAreRevenues
		|		THEN Products
		|		ELSE UNDEFINED
		|	END");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

	#EndRegion

	#Region GoodsCostVariances
	
	RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTWriteOffOfDeviationsDeviationsInCostOfGoods";
	TemporaryTableNameSource = "TTDataAdjustmentTable_DeviationsInCostOfGoods";
	
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(CalculationParameters, ReceiverDescription, TemporaryTableNameSource);
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);

	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"BusinessOperation",
		"CASE WHEN TheseAreExpenses
		|		THEN VALUE(Enum.BusinessTransactions.GoodsValueVarianceExpenses)
		|	   WHEN TheseAreRevenues
		|		THEN VALUE(Enum.BusinessTransactions.GoodsValueVarianceIncome)
		|		ELSE VALUE(Enum.BusinessTransactions.ReverseProvisionsForImpairmentOfInventory)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"BusinessTransactionSetting",
		"CASE WHEN TheseAreExpenses
		|		THEN VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceExpenses)
		|	   WHEN TheseAreRevenues
		|		THEN VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceIncome)
		|		ELSE VALUE(Catalog.BusinessTransactionsSettings.ReverseProvisionsForImpairmentOfInventory)
		|	END");

	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"ExpenseItemOfWriteOff",
		"CASE WHEN TheseAreExpenses
		|		THEN ExpenseItem
		|		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"DimensionOfExpenses",
		"CASE WHEN TheseAreExpenses
		|		THEN Products
		|		ELSE UNDEFINED
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"IncomeItem",
		"CASE WHEN TheseAreRevenues
		|		THEN IncomeItem
		|		ELSE VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"DimensionOfRevenue",
		"CASE WHEN TheseAreRevenues
		|		THEN Products
		|		ELSE UNDEFINED
		|	END");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

	#EndRegion

	#Region WriteOffOfDeviationsOtherIncomeExpenses
	
	Query.Text = "
	// Negative amounts of deviation in value will be attributed to other income
	|SELECT
	|	TRUE AS TheseAreRevenues,
	|	FALSE   AS TheseAreExpenses,
	|
	|	AdjustmentTable.Period                        AS Period,
	|	TRUE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Receipt)             AS RecordType,
	|	AdjustmentTable.Recorder              	   AS DocumentRegisterRecords,
	|	AdjustmentTable.Recorder               	   AS DocumentCalculation,
	|	AdjustmentTable.Recorder               	   AS Recorder,
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.LineOfBusiness       AS LineOfBusiness,
	|	AdjustmentTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	VALUE(Enum.BusinessTransactions.GoodsValueVarianceIncome) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceIncome) AS BusinessTransactionSetting,
	|
	|	AdjustmentTable.ExpenseItem                AS ExpenseItem,
	|	AdjustmentTable.Products 				   AS DimensionOfExpenses,
	|	AdjustmentTable.IncomeItem 				   AS IncomeItem,
	|	AdjustmentTable.Products 				   AS DimensionOfRevenue,
	|	AdjustmentTable.FinRecordID 	   AS FinRecordID,
	|
	|	(CASE 
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT < 0
	|			THEN -(AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT)
	|		ELSE 0 END) AS Sum,
	|	0 AS AmountExcludingVAT,
	|	(CASE 
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|			THEN -(AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl)
	|		ELSE 0 END) AS SumCompl,
	|	(CASE 
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|			THEN -(AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag)
	|		ELSE 0 END) AS SumMan,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	0 AS AITAmount
	|INTO WriteOffOfDeviationsOtherIncomeExpenses
	|FROM
	|	TTDataAdjustmentTable AS AdjustmentTable
	|WHERE
	|	 AdjustmentTable.AccountingSection IN (&BalanceSectionsOfAccounting)
	|
	|UNION ALL
	|
	// The positive amounts of the deviation in value will be attributed to other expenses
	|SELECT
	|	FALSE   AS TheseAreRevenues,
	|	TRUE AS TheseAreExpenses,
	|
	|	AdjustmentTable.Period                        AS Period,
	|	TRUE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Receipt)             AS RecordType,
	|	AdjustmentTable.Recorder              	   AS DocumentRegisterRecords,
	|	AdjustmentTable.Recorder               	   AS DocumentCalculation,
	|	AdjustmentTable.Recorder               	   AS Recorder,
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.LineOfBusiness       AS LineOfBusiness,
	|	AdjustmentTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	VALUE(Enum.BusinessTransactions.GoodsValueVarianceExpenses) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceExpenses) AS BusinessTransactionSetting,
	|
	|	AdjustmentTable.ExpenseItem                AS ExpenseItem,
	|	AdjustmentTable.Products 				   AS DimensionOfExpenses,
	|	AdjustmentTable.IncomeItem 				   AS IncomeItem,
	|	AdjustmentTable.Products 				   AS DimensionOfRevenue,
	|	AdjustmentTable.FinRecordID 	   AS FinRecordID,
	|
	|	(CASE 
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT > 0
	|			THEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS Sum,
	|	(CASE 
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT > 0
	|			THEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	(CASE 
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl > 0
	|			THEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl
	|		ELSE 0 END) AS SumCompl,
	|	(CASE 
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag > 0
	|			THEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag
	|		ELSE 0 END) AS SumMan,
	|	(CASE 
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl > 0
	|			THEN AdjustmentTable.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE 
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl > 0
	|			THEN AdjustmentTable.CostTD
	|		ELSE 0 END) AS CostTD,
	|	(CASE 
	|		WHEN AdjustmentTable.CostOfPersonalIncomeTax > 0
	|			THEN AdjustmentTable.CostOfPersonalIncomeTax
	|		ELSE 0 END) AS AITAmount
	|FROM
	|	TTDataAdjustmentTable AS AdjustmentTable
	|WHERE
	|	 AdjustmentTable.AccountingSection IN (&BalanceSectionsOfAccounting)
	|
	|UNION ALL
	|
	// Negative amounts of deviations in cost will be attributed to other income (from the register of "Deviations in the cost of goods")
	|SELECT
	|	TRUE AS TheseAreRevenues,
	|	FALSE   AS TheseAreExpenses,
	|
	|	AdjustmentTable.Period                        AS Period,
	|	TRUE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Receipt)             AS RecordType,
	|	AdjustmentTable.Recorder              	   AS DocumentRegisterRecords,
	|	AdjustmentTable.Recorder               	   AS DocumentCalculation,
	|	AdjustmentTable.Recorder               	   AS Recorder,
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.LineOfBusiness       AS LineOfBusiness,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ItemsLocationAttributes,
	|	VALUE(Enum.BusinessTransactions.GoodsValueVarianceIncome) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceIncome) AS BusinessTransactionSetting,
	|
	|	AdjustmentTable.ExpenseItem                AS ExpenseItem,
	|	AdjustmentTable.Products 				   AS DimensionOfExpenses,
	|	AdjustmentTable.IncomeItem 				   AS IncomeItem,
	|	AdjustmentTable.Products 				   AS DimensionOfRevenue,
	|	AdjustmentTable.FinRecordID 	   AS FinRecordID,
	|
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT < 0
	|			THEN -(AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT)
	|		ELSE 0 END) AS Sum,
	|	0 AS AmountExcludingVAT,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal < 0
	|			THEN -(AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal)
	|		ELSE 0 END) AS SumCompl,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag < 0
	|			THEN -(AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag)
	|		ELSE 0 END) AS SumMan,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	0 AS AITAmount
	|FROM
	|	TTDataAdjustmentTable_DeviationsInCostOfGoods AS AdjustmentTable
	|
	|UNION ALL
	|
	// Positive amounts of deviations in the cost will be attributed to other expenses (from the register "Deviations in the cost of goods")
	|SELECT
	|	FALSE   AS TheseAreRevenues,
	|	TRUE AS TheseAreExpenses,
	|
	|	AdjustmentTable.Period                        AS Period,
	|	TRUE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Receipt)             AS RecordType,
	|	AdjustmentTable.Recorder              	   AS DocumentRegisterRecords,
	|	AdjustmentTable.Recorder               	   AS DocumentCalculation,
	|	AdjustmentTable.Recorder               	   AS Recorder,
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.LineOfBusiness       AS LineOfBusiness,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ItemsLocationAttributes,
	|	VALUE(Enum.BusinessTransactions.GoodsValueVarianceExpenses) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceExpenses) AS BusinessTransactionSetting,
	|
	|	AdjustmentTable.ExpenseItem                AS ExpenseItem,
	|	AdjustmentTable.Products 				   AS DimensionOfExpenses,
	|	AdjustmentTable.IncomeItem 				   AS IncomeItem,
	|	AdjustmentTable.Products 				   AS DimensionOfRevenue,
	|	AdjustmentTable.FinRecordID 	   AS FinRecordID,
	|
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT > 0
	|			THEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT
	|		ELSE 0 END) AS Sum,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT > 0
	|			THEN AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal > 0
	|			THEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal
	|		ELSE 0 END) AS SumCompl,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag > 0
	|			THEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag
	|		ELSE 0 END) AS SumMan,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal > 0
	|			THEN AdjustmentTable.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE 
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal
	|		 - AdjustmentTable.PermanentDifference - AdjustmentTable.CostTD > 0
	|			THEN AdjustmentTable.CostTD
	|		ELSE 0 END) AS CostTD,
	|	(CASE 
	|		WHEN AdjustmentTable.AIT > 0
	|			THEN AdjustmentTable.AIT
	|		ELSE 0 END) AS AITAmount
	|FROM
	|	TTDataAdjustmentTable_DeviationsInCostOfGoods AS AdjustmentTable
	|;
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	#EndRegion

	#Region OtherIncome
	
	RegisterName = Metadata.AccumulationRegisters.OtherIncome.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTWriteOffOfDeviationsOtherIncome";
	TemporaryTableNameSource = "WriteOffOfDeviationsOtherIncomeExpenses";
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);

	ConditionWHERE = "TheseAreRevenues";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName, ConditionWHERE);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

	#EndRegion
	
	#Region OtherExpenses
	
	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTWriteOffOfDeviationsOtherExpenses";
	TemporaryTableNameSource = "WriteOffOfDeviationsOtherIncomeExpenses";
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);

	ConditionWHERE = "TheseAreExpenses";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName, ConditionWHERE);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

	#EndRegion

	#Region Revenue

	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.Recorder AS Recorder,
	// Dimensions
	|	T.ItemsLocationAttributes,
	|	UNDEFINED AS SalesOrder,
	|	DimensionPartner_.DimensionKey AS AccountingDimensionByPartners,
	|	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	|	(CASE
	|		WHEN T.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|		 AND NOT T.ItemsLocationAttributes.Products.TracedGoods
	|			THEN VALUE(Enum.InventoryTypes.OperationService)
	|		ELSE T.InventoryOwnerAttribute.InventoryType END) AS InventoryType,
	|	T.InventoryOwnerAttribute,
	|	T.AccountingSection,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.ItemsLocationAttributes.WarehouseArea AS Warehouse,
	// Resources
	|	T.ProvisionForImpairmentMan AS ProvisionForImpairmentMan,
	|	T.ProvisionForImpairmentLocal AS ProvisionForImpairmentLocal,
	// Attributes
	|	T.Recorder AS DocumentRegisterRecords,
	|	VALUE(Enum.BusinessTransactions.ReverseProvisionsForImpairmentOfInventory) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ReverseProvisionsForImpairmentOfInventory) AS BusinessTransactionSetting,
	|	T.FinRecordID
	|INTO WriteOffOfDeviationsRevenueAndCostReserves
	|FROM
	|	TTDataAdjustmentTable AS T
	|	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionPartner_
	|	ON (DimensionPartner_.Partner = VALUE(Catalog.Partners.EmptyRef))
	|		AND (DimensionPartner_.Organization = T.Organization)
	|		AND (DimensionPartner_.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	|		AND (DimensionPartner_.Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
	|		AND (DimensionPartner_.LineOfBusiness = T.LineOfBusiness)
	|WHERE
	|	T.ProvisionForImpairmentMan <> 0 OR T.ProvisionForImpairmentLocal <> 0
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.RevenueAndCOGS.Name);
	DescriptionOfTT.TTResultName = "TTWriteOffOfDeviationsRevenue";
	DescriptionOfTT.NameOfSourceTT = "WriteOffOfDeviationsRevenueAndCostReserves";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	#EndRegion
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
		"BatchesWithCorrectionsAndCorrections, TTDataAdjustmentTable,
		|WriteOffOfDeviationsOtherIncomeExpenses, WriteOffOfDeviationsRevenueAndCostReserves,
		|TTWriteOffOfDeviationsOtherIncome, TTWriteOffOfDeviationsOtherExpenses, TTWriteOffOfDeviationsRevenue");
	
EndProcedure

Function TextWriteOffDeviationsInCostOfGoodsDataPreparation(CalculationParameters)
	
	QueryText = "";
	
	#Region BatchesWithCorrectionsAndCorrections
	
	QueryText = QueryText + "
	|SELECT DISTINCT
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.Lot AS Lot,
	|	T.Organization AS Organization
	|INTO BatchesWithCorrectionsAndCorrections
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS T
	|WHERE
	|	T.EntryType IN (
	|		VALUE(Enum.LotRecordTypes.PurchaseAdjustment),
	|		VALUE(Enum.LotRecordTypes.CurrentPeriodCorrections),
	|		VALUE(Enum.LotRecordTypes.CorrectPreviousPeriodTransfer),
	|		VALUE(Enum.LotRecordTypes.ConsumptionReverseTransaction),
	|		VALUE(Enum.LotRecordTypes.AdditionPreviousPeriod))
	|	AND NOT T.Organization IN (&MediumSlipOrganizations)
	|
	|UNION ALL
	|
	// With medium-slip, cumulative Balances may occur due to a violation of the chronology of document entry.
	|SELECT DISTINCT
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.Lot AS Lot,
	|	T.Organization AS Organization
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS T
	|WHERE
	|	NOT T.OfficialTypeOfMovementParish
	|	AND T.Organization IN (&MediumSlipOrganizations)
	|
	// The indices must correspond to the indices of the table in the Calculation statistics and cost of goods described
	// in the function Calculation of cost and costalgorithms.Create a description of the Register() #Index area of the Register
	|INDEX BY
	|	ItemsLocationAttributes,
	|	Organization,
	|	Lot
	|;";
	
	#EndRegion
	
	#Region NonZeroCostBalances
	
	QueryText = QueryText + "
	|SELECT DISTINCT
	|	T.Organization AS Organization,
	|	Dimension.Products AS Products,
	|	Dimension.Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(Dimension.Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN Dimension.StorageLocation
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN Dimension.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation
	|
	|INTO NonZeroCostBalances
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS T
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON TTAccountingPoliciesOfFinancialAccounting.Organization = T.Organization
	|	INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON Dimension.Ref = T.ItemsLocationAttributes
	|WHERE
	|	T.Count <> 0
	|
	// The indices must correspond to the indices of the table in the calculation of the cost of the cost of the cost of goods described
	// in the function calculation of the cost of the costalgorithms.Create a description of the Register() #Index area of the Register
	|INDEX BY
	|	Products,
	|	Organization
	|;";
	
	#EndRegion
	
	#Region TTDataAdjustmentTable
	
	QueryText = QueryText + " 
	|SELECT
	|	&EndOfPeriod                        			   AS Period,
	|	FALSE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Expense)             AS RecordType,
	|	CostCalculationDocuments.Ref 			   AS Recorder,
	|
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	AdjustmentTable.AccountingSection 				   AS AccountingSection,
	|	AdjustmentTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	AdjustmentTable.Lot                        AS Lot,
	|	AdjustmentTable.LotVendorAttributes          AS LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType            AS VATActivityType,
	|	ISNULL(AdjustmentTable.ItemsLocationAttributes.Purpose.LineOfBusiness,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
    |
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) 				AS ExpenseItem,
	|	VALUE(ChartOfCharacteristicTypes.IncomeItems.GoodsValueVariance) 	AS IncomeItem,
	|	AdjustmentTable.ItemsLocationAttributes.Products 				AS Products,
	|	"""" AS FinRecordID,
	|
	|	FALSE AS TheseAreExpenses,
	|	TRUE AS TheseAreRevenues,
	|
	|	(CASE
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT < 0
	|			THEN AdjustmentTable.Cost
	|		ELSE 0 END) AS Cost,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|			THEN AdjustmentTable.CostExcludingVAT
	|		ELSE 0 END) AS CostExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.OffBalanceCost < 0
	|			THEN AdjustmentTable.OffBalanceCost
	|		ELSE 0 END) AS OffBalanceCost,
	|	(CASE
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT < 0
	|			THEN AdjustmentTable.AddExpensesForGoods
	|		ELSE 0 END) AS AddExpensesForGoods,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|			THEN AdjustmentTable.AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT < 0
	|			THEN AdjustmentTable.LaborCosts
	|		ELSE 0 END) AS LaborCosts,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|			THEN AdjustmentTable.ItemizedFixedCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|			THEN AdjustmentTable.ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|			THEN AdjustmentTable.ItemizedFixedCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|			THEN AdjustmentTable.ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|			THEN AdjustmentTable.LocalCost
	|		ELSE 0 END) AS LocalCost,
	|	(CASE
	|		WHEN AdjustmentTable.OffBalanceCostLocal < 0
	|			THEN AdjustmentTable.OffBalanceCostLocal
	|		ELSE 0 END) AS OffBalanceCostLocal,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|			THEN AdjustmentTable.AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|			THEN AdjustmentTable.LaborCostsLocal
	|		ELSE 0 END) AS LaborCostsLocal,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|			THEN AdjustmentTable.ItemizedFixedCostsCompl
	|		ELSE 0 END) AS ItemizedFixedCostsCompl,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|			THEN AdjustmentTable.ItemizedVariableCostsCompl
	|		ELSE 0 END) AS ItemizedVariableCostsCompl,
	|	(CASE
	|		WHEN AdjustmentTable.PermanentDifference > 0
	|			THEN AdjustmentTable.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE
	|		WHEN AdjustmentTable.CostTD > 0 // TA = AC - PD - TD, the sum of TA will be < 0
	|			THEN AdjustmentTable.CostTD
	|		ELSE 0 END) AS CostTD,
	|	(CASE
	|		WHEN AdjustmentTable.CostOfPersonalIncomeTax < 0
	|			THEN AdjustmentTable.CostOfPersonalIncomeTax
	|		ELSE 0 END) AS CostOfPersonalIncomeTax,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|			THEN AdjustmentTable.CostMan
	|		ELSE 0 END) AS CostMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|			THEN AdjustmentTable.AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|			THEN AdjustmentTable.LaborCostsMan
	|		ELSE 0 END) AS LaborCostsMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|			THEN AdjustmentTable.ItemizedFixedCostsManag
	|		ELSE 0 END) AS ItemizedFixedCostsManag,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|			THEN AdjustmentTable.ItemizedVariableCostsManag
	|		ELSE 0 END) AS ItemizedVariableCostsManag,
	// The restoration of reserves for impairment of inventories should be reflected in separate movements.
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan
	|
	|INTO TTDataAdjustmentTable
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS AdjustmentTable
	|	INNER JOIN BatchesWithCorrectionsAndCorrections AS Filter
	|		ON AdjustmentTable.ItemsLocationAttributes = Filter.ItemsLocationAttributes
	|		AND AdjustmentTable.InventoryOwnerAttribute = Filter.InventoryOwnerAttribute
	|		AND AdjustmentTable.Organization = Filter.Organization
	|		AND AdjustmentTable.Lot = Filter.Lot
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON CostCalculationDocuments.Organization = AdjustmentTable.Organization
	|WHERE
	|	AdjustmentTable.Count = 0
	|	AND (AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT < 0
	|		OR AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT < 0
	|		OR AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl < 0
	|		OR AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag < 0
	|		OR AdjustmentTable.OffBalanceCost < 0
	|		OR AdjustmentTable.CostTD > 0 // TA = AC - PD - TD, the sum of TA will be < 0
	|		OR AdjustmentTable.PermanentDifference > 0
	|		OR AdjustmentTable.CostOfPersonalIncomeTax < 0)
	|
	|UNION ALL
	|
	|SELECT
	|	&EndOfPeriod                        			   AS Period,
	|	FALSE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Expense)             AS RecordType,
	|	CostCalculationDocuments.Ref 			   AS Recorder,
	|
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	AdjustmentTable.AccountingSection 				   AS AccountingSection,
	|	AdjustmentTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	AdjustmentTable.Lot                        AS Lot,
	|	AdjustmentTable.LotVendorAttributes          AS LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType            AS VATActivityType,
	|	ISNULL(AdjustmentTable.ItemsLocationAttributes.Purpose.LineOfBusiness,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
    |
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.GoodsValueVariance) AS ExpenseItem,
	|	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)				 	AS IncomeItem,
	|	AdjustmentTable.ItemsLocationAttributes.Products 				AS Products,
	|	"""" AS FinRecordID,
	|
	|	TRUE AS TheseAreExpenses,
	|	FALSE AS TheseAreRevenues,
	|
	|	(CASE
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT >= 0
	|			THEN AdjustmentTable.Cost
	|		ELSE 0 END) AS Cost,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT >= 0
	|			THEN AdjustmentTable.CostExcludingVAT
	|		ELSE 0 END) AS CostExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.OffBalanceCost > 0
	|			THEN AdjustmentTable.OffBalanceCost
	|		ELSE 0 END) AS OffBalanceCost,
	|	(CASE
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT >= 0
	|			THEN AdjustmentTable.AddExpensesForGoods
	|		ELSE 0 END) AS AddExpensesForGoods,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT >= 0
	|			THEN AdjustmentTable.AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT >= 0
	|			THEN AdjustmentTable.LaborCosts
	|		ELSE 0 END) AS LaborCosts,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT >= 0
	|			THEN AdjustmentTable.ItemizedFixedCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT > 0
	|			THEN AdjustmentTable.ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT >= 0
	|			THEN AdjustmentTable.ItemizedFixedCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts
	|		 + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT >= 0
	|			THEN AdjustmentTable.ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl >= 0
	|			THEN AdjustmentTable.LocalCost
	|		ELSE 0 END) AS LocalCost,
	|	(CASE
	|		WHEN AdjustmentTable.OffBalanceCostLocal > 0
	|			THEN AdjustmentTable.OffBalanceCostLocal
	|		ELSE 0 END) AS OffBalanceCostLocal,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl >= 0
	|			THEN AdjustmentTable.AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl >= 0
	|			THEN AdjustmentTable.LaborCostsLocal
	|		ELSE 0 END) AS LaborCostsLocal,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl >= 0
	|			THEN AdjustmentTable.ItemizedFixedCostsCompl
	|		ELSE 0 END) AS ItemizedFixedCostsCompl,
	|	(CASE
	|		WHEN AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal
	|		 + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl >= 0
	|			THEN AdjustmentTable.ItemizedVariableCostsCompl
	|		ELSE 0 END) AS ItemizedVariableCostsCompl,
	|	(CASE
	|		WHEN AdjustmentTable.PermanentDifference < 0
	|			THEN AdjustmentTable.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE
	|		WHEN AdjustmentTable.CostTD < 0 // TA = AC - PD - TD, the sum of TA will be > 0
	|			THEN AdjustmentTable.CostTD
	|		ELSE 0 END) AS CostTD,
	|	(CASE
	|		WHEN AdjustmentTable.CostOfPersonalIncomeTax > 0
	|			THEN AdjustmentTable.CostOfPersonalIncomeTax
	|		ELSE 0 END) AS CostOfPersonalIncomeTax,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag >= 0
	|			THEN AdjustmentTable.CostMan
	|		ELSE 0 END) AS CostMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag >= 0
	|			THEN AdjustmentTable.AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag >= 0
	|			THEN AdjustmentTable.LaborCostsMan
	|		ELSE 0 END) AS LaborCostsMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag >= 0
	|			THEN AdjustmentTable.ItemizedFixedCostsManag
	|		ELSE 0 END) AS ItemizedFixedCostsManag,
	|	(CASE
	|		WHEN AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan
	|		 + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag >= 0
	|			THEN AdjustmentTable.ItemizedVariableCostsManag
	|		ELSE 0 END) AS ItemizedVariableCostsManag,
	// The restoration of reserves for impairment of inventories should be reflected in separate movements.
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS AdjustmentTable
	|	INNER JOIN BatchesWithCorrectionsAndCorrections AS Filter
	|		ON AdjustmentTable.ItemsLocationAttributes = Filter.ItemsLocationAttributes
	|		AND AdjustmentTable.InventoryOwnerAttribute = Filter.InventoryOwnerAttribute
	|		AND AdjustmentTable.Organization = Filter.Organization
	|		AND AdjustmentTable.Lot = Filter.Lot
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON CostCalculationDocuments.Organization = AdjustmentTable.Organization
	|WHERE
	|	AdjustmentTable.Count = 0
	|	AND (AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT >= 0
	|		OR AdjustmentTable.CostExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT + AdjustmentTable.LaborCosts + AdjustmentTable.ItemizedFixedCostsExcludingVAT + AdjustmentTable.ItemizedVariableCostsExcludingVAT >= 0
	|		OR AdjustmentTable.LocalCost + AdjustmentTable.AddExpensesLocal + AdjustmentTable.LaborCostsLocal + AdjustmentTable.ItemizedFixedCostsCompl + AdjustmentTable.ItemizedVariableCostsCompl >= 0
	|		OR AdjustmentTable.CostMan + AdjustmentTable.AddExpensesMan + AdjustmentTable.LaborCostsMan + AdjustmentTable.ItemizedFixedCostsManag + AdjustmentTable.ItemizedVariableCostsManag >= 0
	|		OR AdjustmentTable.OffBalanceCost > 0
	|		OR AdjustmentTable.OffBalanceCostLocal > 0
	|		OR AdjustmentTable.CostTD < 0 // TA = AC - PD - TD, the sum of TA will be > 0
	|		OR AdjustmentTable.PermanentDifference < 0
	|		OR AdjustmentTable.CostOfPersonalIncomeTax > 0)
	|";
	
	#EndRegion
	
	#Region TTDataTableAdjustments_RecoveryOfReserves
	
	// The restoration of reserves for impairment of inventories should be reflected in separate movements.
	QueryText = QueryText + "
	|UNION ALL
	|
	|SELECT
	|	&EndOfPeriod                        			   AS Period,
	|	FALSE 											   AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Expense)             AS RecordType,
	|	CostCalculationDocuments.Ref 			   AS Recorder,
	|
	|	AdjustmentTable.Organization                   AS Organization,
	|	AdjustmentTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	AdjustmentTable.AccountingSection 				   AS AccountingSection,
	|	AdjustmentTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	AdjustmentTable.Lot                        AS Lot,
	|	AdjustmentTable.LotVendorAttributes          AS LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType            AS VATActivityType,
	|	ISNULL(AdjustmentTable.ItemsLocationAttributes.Purpose.LineOfBusiness,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
    |
	|	UNDEFINED AS ExpenseItem,
	|	UNDEFINED AS IncomeItem,
	|	AdjustmentTable.ItemsLocationAttributes.Products AS Products,
	|	"""" AS FinRecordID,
	|
	|	FALSE AS TheseAreExpenses,
	|	FALSE AS TheseAreRevenues,
	|
	|	0 AS Cost,
	|	0 AS CostExcludingVAT,
	|	0 AS OffBalanceCost,
	|	0 AS AddExpensesForGoods,
	|	0 AS AdditionalExpensesExcludingVAT,
	|	0 AS LaborCosts,
	|	0 AS ItemizedFixedCostsIncludingVAT,
	|	0 AS ItemizedVariableCostsIncludingVAT,
	|	0 AS ItemizedFixedCostsExcludingVAT,
	|	0 AS ItemizedVariableCostsExcludingVAT,
	|	0 AS LocalCost,
	|	0 AS OffBalanceCostLocal,
	|	0 AS AddExpensesLocal,
	|	0 AS LaborCostsLocal,
	|	0 AS ItemizedFixedCostsCompl,
	|	0 AS ItemizedVariableCostsCompl,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	0 AS CostOfPersonalIncomeTax,
	|	0 AS CostMan,
	|	0 AS AddExpensesMan,
	|	0 AS LaborCostsMan,
	|	0 AS ItemizedFixedCostsManag,
	|	0 AS ItemizedVariableCostsManag,
	|	AdjustmentTable.ProvisionForImpairmentLocal,
	|	AdjustmentTable.ProvisionForImpairmentMan
	|
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS AdjustmentTable
	|	INNER JOIN BatchesWithCorrectionsAndCorrections AS Filter
	|		ON AdjustmentTable.ItemsLocationAttributes = Filter.ItemsLocationAttributes
	|		AND AdjustmentTable.Organization = Filter.Organization
	|		AND AdjustmentTable.Lot = Filter.Lot
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON CostCalculationDocuments.Organization = AdjustmentTable.Organization
	|WHERE
	|	AdjustmentTable.Count = 0
	|	AND (AdjustmentTable.ProvisionForImpairmentLocal <> 0
	|		OR AdjustmentTable.ProvisionForImpairmentMan <> 0)
	|;
	|";
	
	#EndRegion
	
	#Region TTDataAdjustmentTable_DeviationsInCostOfGoods
	
	QueryText = QueryText + " 
	|SELECT DISTINCT
	|	""1"" AS RequestSource,
	|	Balance.Organization AS Organization,
	|	Dimension.Products AS Products,
	|	Dimension.Characteristic AS Characteristic,
	|	Balance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(Dimension.Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN Dimension.StorageLocation
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN Dimension.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation
	|
	|INTO ZeroBalancesWithAdjustmentsAndCorrections
	|FROM
	|	TTDataAdjustmentTable AS Balance
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON Balance.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|	INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON Dimension.Ref = Balance.ItemsLocationAttributes
	|
	|UNION ALL
	|
	// Let's add analytics for which there are no Balances in the cost of goods.
	|SELECT DISTINCT
	|	""2"" AS RequestSource,
	|	AdjustingEntries.Organization AS Organization,
	|	Dimension.Products AS Products,
	|	Dimension.Characteristic AS Characteristic,
	|	AdjustingEntries.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(Dimension.Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN Dimension.StorageLocation
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN Dimension.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation
	|
	|FROM
	|	BatchesWithCorrectionsAndCorrections AS AdjustingEntries
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON AdjustingEntries.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|	INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON Dimension.Ref = AdjustingEntries.ItemsLocationAttributes
	|	LEFT JOIN TTDataAdjustmentTable AS TotalBalances
	|		ON TotalBalances.ItemsLocationAttributes = AdjustingEntries.ItemsLocationAttributes
	|		AND TotalBalances.InventoryOwnerAttribute = AdjustingEntries.InventoryOwnerAttribute
	|		AND TotalBalances.Organization = AdjustingEntries.Organization
	|		AND TotalBalances.Lot = AdjustingEntries.Lot
	|WHERE
	|	TotalBalances.Organization IS NULL
	|
	// The indices must correspond to the indices of the table in the calculation of the cost of the cost of the cost of goods described
	// in the function calculation of the cost of the costalgorithms.Create a description of the Register() #Index area of the Register
	|INDEX BY
	|	Products,
	|	Organization
	|;
	|SELECT
	|	&EndOfPeriod									AS Period,
	|	FALSE											AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Expense)			AS RecordType,
	|	CostCalculationDocuments.Ref 			AS Recorder,
	|
	|	AdjustmentTable.Organization				AS Organization,
	|	AdjustmentTable.Products				AS Products,
	|	AdjustmentTable.Characteristic				AS Characteristic,
	|	AdjustmentTable.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
	|	AdjustmentTable.LineOfBusiness	AS LineOfBusiness,
	|	AdjustmentTable.Department				AS Department,
	|	AdjustmentTable.StorageLocation				AS StorageLocation,
	|	AdjustmentTable.VariancePeriod			AS VariancePeriod,
	|
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) 				AS ExpenseItem,
	|	VALUE(ChartOfCharacteristicTypes.IncomeItems.GoodsValueVariance) 	AS IncomeItem,
	|	"""" AS FinRecordID,
	|
	|	FALSE AS TheseAreExpenses,
	|	TRUE AS TheseAreRevenues,
	|
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT < 0
	|			THEN AdjustmentTable.CostVariancesIncludingVAT
	|		ELSE 0 END) AS CostVariancesIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT < 0
	|			THEN AdjustmentTable.CostVariancesExcludingVAT
	|		ELSE 0 END) AS CostVariancesExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT < 0
	|			THEN AdjustmentTable.AdditionalExpensesIncludingVAT
	|		ELSE 0 END) AS AdditionalExpensesIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT < 0
	|			THEN AdjustmentTable.AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal < 0
	|			THEN AdjustmentTable.CostVariancesLocal
	|		ELSE 0 END) AS CostVariancesLocal,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal < 0
	|			THEN AdjustmentTable.AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal < 0
	|			THEN AdjustmentTable.VATLocal
	|		ELSE 0 END) AS VATLocal,
	|	(CASE
	|		WHEN AdjustmentTable.PermanentDifference > 0
	|			THEN AdjustmentTable.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE
	|		WHEN AdjustmentTable.CostTD > 0 // TA = AC - PD - TD, the sum of TA will be < 0
	|			THEN AdjustmentTable.CostTD
	|		ELSE 0 END) AS CostTD,
	|	(CASE
	|		WHEN AdjustmentTable.AIT < 0
	|			THEN AdjustmentTable.AIT
	|		ELSE 0 END) AS AIT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag < 0
	|			THEN AdjustmentTable.CostVariancesMgmt
	|		ELSE 0 END) AS CostVariancesMgmt,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag < 0
	|			THEN AdjustmentTable.AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag < 0
	|			THEN AdjustmentTable.VATManag
	|		ELSE 0 END) AS VATManag
	|
	|INTO TTDataAdjustmentTable_DeviationsInCostOfGoods
	|FROM
	|	TTCashSettlementBalancesDeviationsInCostOfGoods AS AdjustmentTable
	|
	|	INNER JOIN ZeroBalancesWithAdjustmentsAndCorrections AS Filter
	|		ON AdjustmentTable.Products = Filter.Products
	|		AND AdjustmentTable.Characteristic = Filter.Characteristic
	|		AND AdjustmentTable.InventoryOwnerAttribute = Filter.InventoryOwnerAttribute
	|		AND AdjustmentTable.Organization = Filter.Organization
	|		AND AdjustmentTable.LineOfBusiness = Filter.LineOfBusiness
	|		AND AdjustmentTable.Department = Filter.Department
	|		AND AdjustmentTable.StorageLocation = Filter.StorageLocation
	|
	|	LEFT JOIN NonZeroCostBalances AS NonzeroBalances
	|		ON AdjustmentTable.Products = NonzeroBalances.Products
	|		AND AdjustmentTable.Characteristic = NonzeroBalances.Characteristic
	|		AND AdjustmentTable.InventoryOwnerAttribute = NonzeroBalances.InventoryOwnerAttribute
	|		AND AdjustmentTable.Organization = NonzeroBalances.Organization
	|		AND AdjustmentTable.LineOfBusiness = NonzeroBalances.LineOfBusiness
	|		AND AdjustmentTable.Department = NonzeroBalances.Department
	|		AND AdjustmentTable.StorageLocation = NonzeroBalances.StorageLocation
	|
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON CostCalculationDocuments.Organization = AdjustmentTable.Organization
	|WHERE
	|	(AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT < 0
	|		OR AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT < 0
	|		OR AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal < 0
	|		OR AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag < 0
	|		OR AdjustmentTable.CostTD > 0 // TA = AC - PD - TD, the sum of TA will be < 0
	|		OR AdjustmentTable.PermanentDifference > 0
	|		OR AdjustmentTable.AIT < 0)
	|	AND NonzeroBalances.Organization IS NULL
	|
	|UNION ALL
	|
	|SELECT
	|	&EndOfPeriod									AS Period,
	|	FALSE											AS OfficialTypeOfMovementParish,
	|	VALUE(AccumulationRecordType.Expense)			AS RecordType,
	|	CostCalculationDocuments.Ref 			AS Recorder,
	|
	|	AdjustmentTable.Organization				AS Organization,
	|	AdjustmentTable.Products				AS Products,
	|	AdjustmentTable.Characteristic				AS Characteristic,
	|	AdjustmentTable.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
	|	AdjustmentTable.LineOfBusiness	AS LineOfBusiness,
	|	AdjustmentTable.Department				AS Department,
	|	AdjustmentTable.StorageLocation				AS StorageLocation,
	|	AdjustmentTable.VariancePeriod			AS VariancePeriod,
	|
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.GoodsValueVariance) AS ExpenseItem,
	|	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)				 	AS IncomeItem,
	|	"""" AS FinRecordID,
	|
	|	TRUE AS TheseAreExpenses,
	|	FALSE AS TheseAreRevenues,
	|
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT > 0
	|			THEN AdjustmentTable.CostVariancesIncludingVAT
	|		ELSE 0 END) AS CostVariancesIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT > 0
	|			THEN AdjustmentTable.CostVariancesExcludingVAT
	|		ELSE 0 END) AS CostVariancesExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT > 0
	|			THEN AdjustmentTable.AdditionalExpensesIncludingVAT
	|		ELSE 0 END) AS AdditionalExpensesIncludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT > 0
	|			THEN AdjustmentTable.AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal > 0
	|			THEN AdjustmentTable.CostVariancesLocal
	|		ELSE 0 END) AS CostVariancesLocal,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal > 0
	|			THEN AdjustmentTable.AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal > 0
	|			THEN AdjustmentTable.VATLocal
	|		ELSE 0 END) AS VATLocal,
	|	(CASE
	|		WHEN AdjustmentTable.PermanentDifference < 0
	|			THEN AdjustmentTable.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE
	|		WHEN AdjustmentTable.CostTD < 0 // TA = AC - PD - TD, the sum of TA will be > 0
	|			THEN AdjustmentTable.CostTD
	|		ELSE 0 END) AS CostTD,
	|	(CASE
	|		WHEN AdjustmentTable.AIT > 0
	|			THEN AdjustmentTable.AIT
	|		ELSE 0 END) AS AIT,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag > 0
	|			THEN AdjustmentTable.CostVariancesMgmt
	|		ELSE 0 END) AS CostVariancesMgmt,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag > 0
	|			THEN AdjustmentTable.AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE
	|		WHEN AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag > 0
	|			THEN AdjustmentTable.VATManag
	|		ELSE 0 END) AS VATManag
	|
	|FROM
	|	TTCashSettlementBalancesDeviationsInCostOfGoods AS AdjustmentTable
	|
	|	INNER JOIN ZeroBalancesWithAdjustmentsAndCorrections AS Filter
	|		ON AdjustmentTable.Products = Filter.Products
	|		AND AdjustmentTable.Characteristic = Filter.Characteristic
	|		AND AdjustmentTable.InventoryOwnerAttribute = Filter.InventoryOwnerAttribute
	|		AND AdjustmentTable.Organization = Filter.Organization
	|		AND AdjustmentTable.LineOfBusiness = Filter.LineOfBusiness
	|		AND AdjustmentTable.Department = Filter.Department
	|		AND AdjustmentTable.StorageLocation = Filter.StorageLocation
	|
	|	LEFT JOIN NonZeroCostBalances AS NonzeroBalances
	|		ON AdjustmentTable.Products = NonzeroBalances.Products
	|		AND AdjustmentTable.Characteristic = NonzeroBalances.Characteristic
	|		AND AdjustmentTable.InventoryOwnerAttribute = NonzeroBalances.InventoryOwnerAttribute
	|		AND AdjustmentTable.Organization = NonzeroBalances.Organization
	|		AND AdjustmentTable.LineOfBusiness = NonzeroBalances.LineOfBusiness
	|		AND AdjustmentTable.Department = NonzeroBalances.Department
	|		AND AdjustmentTable.StorageLocation = NonzeroBalances.StorageLocation
	|
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON CostCalculationDocuments.Organization = AdjustmentTable.Organization
	|WHERE
	|	(AdjustmentTable.CostVariancesIncludingVAT + AdjustmentTable.AdditionalExpensesIncludingVAT > 0
	|		OR AdjustmentTable.CostVariancesExcludingVAT + AdjustmentTable.AdditionalExpensesExcludingVAT > 0
	|		OR AdjustmentTable.CostVariancesLocal + AdjustmentTable.AddExpensesLocal + AdjustmentTable.VATLocal > 0
	|		OR AdjustmentTable.CostVariancesMgmt + AdjustmentTable.AddExpensesMan + AdjustmentTable.VATManag > 0
	|		OR AdjustmentTable.CostTD < 0 // TA = AC - PD - TD, the sum of TA will be > 0
	|		OR AdjustmentTable.PermanentDifference < 0
	|		OR AdjustmentTable.AIT > 0)
	|	AND NonzeroBalances.Organization IS NULL
	|;
	|";
	
	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

Procedure GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables, ConsumableRegisteredRecords = True)

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = "
	|Period, RecordType, Recorder, BusinessTransactionSetting, FinRecordID";

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	ParametersStructure = New Structure();
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	ConditionWHERE = "";
	// Fill in additional motion properties
	If ConsumableRegisteredRecords Then
		
		TempTableName = "TTOtherExpensesAdditionalExpensesExpenseRegisteredRecords";
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"OfficialTypeOfMovementParish", "FALSE");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"Organization", "Organization");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"Department", "Department");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"LineOfBusiness", "LineOfBusiness");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"ExpenseItem", "ExpenseItem");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"DimensionOfExpenses", "DimensionOfExpenses");
		// For VAT of the tax agent, the correspondence "Other expenses-Other expenses" is used, therefore, for such
		//	cases it is necessary to fill in the cor. part of the register, in other cases (for example, for correspondence
		//	The cost of goods - other expenses) the cor. part is not filled, since the movement should be only 1.
		TemplateForFillingInCorField = "CASE
		|		WHEN ItemsLocationAttributes = VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
		|		  OR ItemsLocationAttributes = UNDEFINED
		|		THEN %1
		|		ELSE UNDEFINED
		|	END";
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"CorExpenseItem", StrTemplate(TemplateForFillingInCorField, "CorExpenseItem"));
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"CorExpenditureDimension", StrTemplate(TemplateForFillingInCorField, "CorExpenditureDimension"));
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"DebitBusinessUnit", StrTemplate(TemplateForFillingInCorField, "DebitBusinessUnit"));
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"CorLineOfBusiness", StrTemplate(TemplateForFillingInCorField, "CorLineOfBusiness"));
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"BusinessOperation", "VALUE(Enum.BusinessTransactions.ExpenseAllocationToCost)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"BusinessTransactionSetting", "VALUE(Catalog.BusinessTransactionsSettings.ExpenseAllocationToCost)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"VariancePeriod", "CASE WHEN ReceiptPeriod < &BeginOfPeriod THEN ReceiptPeriod
			|	ELSE DATETIME(1,1,1) END");
		// No additional conditions (as in the expense) are required in the expenditure movement for the amount excluding VAT.
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"AmountExcludingVAT", "ItemizedVariableCostsExcludingVAT + ItemizedFixedCostsExcludingVAT + AdditionalExpensesExcludingVAT");

	Else
		
		TempTableName = "TTOtherExpensesAdditionalExpensesIncomingRegisteredRecords";
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"OfficialTypeOfMovementParish", "True");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"Organization", "CorCompany");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"Department", "DebitBusinessUnit");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"LineOfBusiness", "CorLineOfBusiness");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"ExpenseItem", "CorExpenseItem");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"DimensionOfExpenses", "CorExpenditureDimension");
			
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting",
			"CASE WHEN ItemsLocationAttributes = UNDEFINED
			|	THEN VALUE(Catalog.BusinessTransactionsSettings.ExpenseAllocationToCost)
			|	ELSE BusinessTransactionSetting END");
			
		// The conditions for the amount excluding VAT in the incoming Register Recorded must match the conditions in:
		// - See AdjustInventoryWriteOffCosts
		// - and called methods. See AdjustCostOfRefundsFromPreviousPeriods.
		// - See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_.
// -
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "
		|CASE
		|	WHEN CorExpenseItem.CostAllocationOptionManag IN (
		|			VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
		|			VALUE(Enum.CostAllocationOptions.OnOtherAssets)) THEN
		|		0
		|	ELSE
		|		ItemizedVariableCostsExcludingVAT + ItemizedFixedCostsExcludingVAT + AdditionalExpensesExcludingVAT
		|END");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"VariancePeriod", "CASE WHEN ReceiptPeriod < &BeginOfPeriod THEN ReceiptPeriod
			|	ELSE DATETIME(1,1,1) END");
		
		ConditionWHERE =
			"VALUETYPE(CorExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
			|	AND NOT CorExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)";
		
	EndIf;
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"Sum", "ItemizedVariableCostsIncludingVAT + ItemizedFixedCostsIncludingVAT + AddExpensesForGoods");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "
	|CASE
	|	WHEN NOT &CompanyManagementAccounting THEN
	|		0
	|	ELSE
	|		ItemizedVariableCostsManag + ItemizedFixedCostsManag + CostMan + AddExpensesMan
	|END");
	
	ParametersStructure.Insert("CompanyManagementAccounting", CalculationParameters.CompanyManagementAccounting);
	ParametersStructure.Insert("UseAccountingOfOtherIncomeExpensesInLocalAccounting", CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting);
	
	// SumCompl
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "
	|CASE
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting THEN
	|		0
	|	ELSE
	|		ItemizedVariableCostsCompl + ItemizedFixedCostsCompl + LocalCost + AddExpensesLocal
	|END");
	
	// PermanentDifference
	If ConsumableRegisteredRecords Then
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "
		|CASE
		|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting THEN
		|		0
		|	ELSE
		|		PermanentDifference
		|END");
	Else 
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "
		|CASE
		|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting THEN
		|		0
		// The Cost(PD) is only constant when the accepted article is distributed to the non-accepted one,
		// because for the original article that is not accepted, the cost is TA equal to 0. 
		|	WHEN NOT CorAcceptanceForTaxAccounting AND EnteredInTaxAccounting THEN
		|		CostInTaxAccounting
		|	ELSE
		|		PermanentDifference
		|END");
	EndIf;
	
	// CostTD
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "
	|CASE
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting THEN
	|		0
	|	ELSE
	|		CostTD
	|END");
	
	// AIT
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AITAmount", "
	|CASE
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting THEN
	|		0
	|	ELSE
	|		CostOfPersonalIncomeTax
	|END");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE, ParametersStructure);
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateRegisteredRecordsOtherAssetsLiabilitiesAdditionalExpensesByRequest(CalculationParameters, MatchingTemporaryMovementTables, ConsumableRegisteredRecords = True)

	RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name;
	
	CopiedFields = "
	|Period, Recorder";

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	ParametersStructure = New Structure();
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	// Fill in additional motion properties
	TempTableName = "TTOtherAssetsLiabilities";
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"OfficialTypeOfMovementParish", "TRUE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"Organization", "CorCompany");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"Department", "DebitBusinessUnit");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"LineOfBusiness", "CorLineOfBusiness");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"AssetRef", "CorArticleOfAssetsLiabilities");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
