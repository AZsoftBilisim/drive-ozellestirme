Procedure GenerateRegisteredRecordsOfDeviationsInCostOfGoodsAdditionalExpensesByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables)

	RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name;
	TempTableName = "TTOfRegisteredRecordedDeviationsInCostOfGoods";
	
	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.Recorder,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	// Dimensions
	|	T.Organization AS Organization,
	|	T.ItemsLocationAttributes.Products AS Products,
	|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CASE WHEN FinAccounting.ItemizeVariancesByLinesOfBusiness
	|		THEN T.ItemsLocationAttributes.Purpose.LineOfBusiness
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT FinAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.ItemsLocationAttributes.StorageLocation
	|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE WHEN FinAccounting.ItemizeVariancesByWarehousesStorageLocations
	|		THEN T.ItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation,
	|	BEGINOFPERIOD(T.ReceiptPeriod, MONTH) AS VariancePeriod,
	// Resources
	|	T.AddExpensesForGoods AS AdditionalExpensesIncludingVAT,
	|	T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
	|	T.AddExpensesLocal AS AddExpensesLocal,
	|	T.AddExpensesMan AS AddExpensesMan,
	|	0 AS VATLocal,
	|	0 AS VATManag,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	|	T.CostOfPersonalIncomeTax AS AIT,
	// Attributes
	|	T.BusinessOperation AS BusinessOperation,
	|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	T.FinRecordID AS FinRecordID
	|
	|INTO TTOfRegisteredRecordedDeviationsInCostOfGoodsPreliminary
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS FinAccounting
	|		ON T.Organization = FinAccounting.Organization
	|WHERE
	|	T.Organization IN (&MediumSlipOrganizations)
	|;
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTOfRegisteredRecordedDeviationsInCostOfGoodsPreliminary");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTOfRegisteredRecordedDeviationsInCostOfGoodsPreliminary", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure


#Region Description_GenerateRegisteredRecordsBasedOnDeviationsInCostOfGoods

// The procedure for forming a movement of deviations in the cost of goods () generates movements in the registers "Other income" and
// "Other expenses" for the amount of deviations in the cost of goods, works and services.
// 
// Deviations in the cost are formed when invoicing deliveries at the stage of "Invoicing deliveries".
// The initial data on deviations in the cost are generated in the procedure to fill in the estimated Delivery Invoice part() 
// #Cost deviation area.
// Deviations in the cost of goods may have the following types of records:
// - Deviations in the value of the invoice - if the invoice amount is less than the amount of the unfactured delivery.
//		Such deviations are reflected in the "Other income" register.
// - Deviations in the cost of the prochier expenditure - if the invoice amount is greater than the amount of the unfactured delivery.
//		Such deviations are reflected in the "Other expenses" register.
// Deviations in the invoicing of works and services written off as expenses are always reflected in the "Other expenses" register.
//
// For the purposes of separate accounting by type of activity VAT deviations in value are taken into account in the following procedures:
// - for expenses allocated to the cost of goods - in the procedure of text allocation of expenses()
// - for expenses allocated to the cost of production - in the procedure of textinitializationdistributionpartiationsfifo-sliding()
//	temporary table of VT parties and other DISTRIBUTIONS2_4

#EndRegion

Procedure GenerateRegisteredRecordsBasedOnDeviationsInCostOfGoods(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "GenerateRegisteredRecordsBasedOnDeviationsInCostOfGoods");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	MatchingTemporaryMovementTables = New Map;

	#Region DeviationsInValueOtherIncome
	
	Query.Text = "
	|SELECT
	|	DD.Period AS Period,
	|	DD.VariancePeriod AS AdjustmentPeriod_,
	|	DD.Recorder AS Recorder,
	// Dimensions
	|	DD.Organization,
	|	DD.Department,
	|	DD.CorLineOfBusiness AS LineOfBusiness,
	|	DD.IncomeItem,
	|	DD.DimensionOfRevenue,
	// Resources
	|	-(DD.Cost
	|		+ DD.AddExpensesForGoods
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsIncludingVAT
	|		+ DD.ItemizedVariableCostsIncludingVAT) AS Sum,
	|	-(DD.LocalCost
	|		+ DD.AddExpensesLocal
	|		+ DD.LaborCostsLocal
	|		+ DD.ItemizedFixedCostsCompl
	|		+ DD.ItemizedVariableCostsCompl
	|		+ DD.ProvisionForImpairmentLocal) AS SumCompl,
	|	-(DD.CostMan
	|		+ DD.AddExpensesMan
	|		+ DD.LaborCostsMan
	|		+ DD.ItemizedFixedCostsManag
	|		+ DD.ItemizedVariableCostsManag
	|		+ DD.ProvisionForImpairmentMan) AS SumMan,
	// Attributes
	|	DD.BusinessOperation,
	|	DD.RowID,
	|	DD.BusinessTransactionSetting,
	|	DD.FinRecordID,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END) AS DocumentCalculation,
	|	&MonthEndClosingMode AS MonthEndClosingMode
	|
	|INTO TTRegisteredRecordsOtherIncome
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = DD.Organization
	|WHERE
	|	DD.EntryType = VALUE(Enum.LotRecordTypes.CostVarianceForOtherIncome)
	|	AND DD.IncomeItem <> VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
	|	AND DD.LotCalculation
	|	AND NOT DD.ReversingEntry
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherIncome.Name, "DeviationsInCost");
	DescriptionOfTT.NameOfSourceTT = "TTRegisteredRecordsOtherIncome";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	#EndRegion
	
	#Region DeviationsInCostOtherExpenses
	
	Query.Text = "
	|SELECT
	|	DD.Period AS Period,
	|	DD.VariancePeriod AS VariancePeriod,
	|	DD.Recorder AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	// Dimensions
	|	DD.Organization,
	|	DD.Department,
	|	DD.CorLineOfBusiness AS LineOfBusiness,
	|	DD.ExpenseItemOfWriteOff AS ExpenseItem,
	|	DD.DimensionOfExpenses,
	// Resources
	|	(DD.Cost
	|		+ DD.AddExpensesForGoods
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsIncludingVAT
	|		+ DD.ItemizedVariableCostsIncludingVAT) AS Sum,
	|	(DD.CostExcludingVAT
	|		+ DD.AdditionalExpensesExcludingVAT
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsExcludingVAT
	|		+ DD.ItemizedVariableCostsExcludingVAT) AS AmountExcludingVAT,
	|	(DD.LocalCost
	|		+ DD.AddExpensesLocal
	|		+ DD.LaborCostsLocal
	|		+ DD.ItemizedFixedCostsCompl
	|		+ DD.ItemizedVariableCostsCompl
	|		+ DD.ProvisionForImpairmentLocal) AS SumCompl,
	|	(CASE
	|		WHEN NOT ISNULL(CAST(DD.ExpenseItemOfWriteOff AS ChartOfCharacteristicTypes.ExpenseItems).EnteredInTaxAccounting, TRUE)
	|			THEN DD.LocalCost
	|				+ DD.AddExpensesLocal
	|				+ DD.LaborCostsLocal
	|				+ DD.ItemizedFixedCostsCompl
	|				+ DD.ItemizedVariableCostsCompl
	|				+ DD.ProvisionForImpairmentLocal
	|		ELSE DD.PermanentDifference END) AS PermanentDifference,
	|	DD.CostTD AS CostTD,
	|	DD.CostOfPersonalIncomeTax AS AITAmount,
	|	(DD.CostMan
	|		+ DD.AddExpensesMan
	|		+ DD.LaborCostsMan
	|		+ DD.ItemizedFixedCostsManag
	|		+ DD.ItemizedVariableCostsManag
	|		+ DD.ProvisionForImpairmentMan) AS SumMan,
	// Attributes
	|	DD.BusinessOperation,
	|	DD.ItemsLocationAttributes,
	|	DD.DocumentRegisterRecords,
	|	DD.RowID,
	|	DD.BusinessTransactionSetting,
	|	DD.FinRecordID,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END) AS DocumentCalculation,
	|	&MonthEndClosingMode AS MonthEndClosingMode
	|
	|INTO TTOtherExpenses
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = DD.Organization
	|WHERE
	|	DD.EntryType = VALUE(Enum.LotRecordTypes.GoodsCostVarianceForOtherExpenses)
	|	AND DD.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	AND DD.LotCalculation
	|	AND NOT DD.ReversingEntry
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherExpenses.Name, "DeviationsInCost");
	DescriptionOfTT.NameOfSourceTT = "TTOtherExpenses";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	#EndRegion
	
	#Region DeviationsInCostItemIncomeExpenses

	Query.Text = "
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	// Dimensions
	|	DD.BusinessOperation,
	|	DD.Organization,
	|	DD.Department,
