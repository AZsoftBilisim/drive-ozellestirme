	|	
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalysisOfProductsWithoutAssignment
	|	ON AnalysisOfProductsWithoutAssignment.Products = DimensionOfProductItem.Products
	|		AND AnalysisOfProductsWithoutAssignment.Characteristic = DimensionOfProductItem.Characteristic
	|		AND AnalysisOfProductsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalysisOfProductsWithoutAssignment.Series = DimensionOfProductItem.Series
	|		AND AnalysisOfProductsWithoutAssignment.StorageLocation = DimensionOfProductItem.StorageLocation
	|		AND AnalysisOfProductsWithoutAssignment.ProductCostElement = DimensionOfProductItem.ProductCostElement
	|	
	|	LEFT JOIN Catalog.Products AS CatProducts
	|	ON CatProducts.Ref = DimensionOfProductItem.Products
	|	
	|	LEFT JOIN AITExpenseRecognitionSettings AS SettingsForRecognitionOfLBExpensesByBusinessUnit
	|	ON SettingsForRecognitionOfLBExpensesByBusinessUnit.ObjectOfSeparateAccountingAIT = AdjustmentTable.Department
	|		AND SettingsForRecognitionOfLBExpensesByBusinessUnit.Organization = AdjustmentTable.Organization
	|		AND SettingsForRecognitionOfLBExpensesByBusinessUnit.ExpensesAreIncludedInCost
	|
	|	LEFT JOIN AITExpenseRecognitionSettings AS SettingsForRecognitionOfExpensesLBDpoLineOfBusiness
	|	ON SettingsForRecognitionOfExpensesLBDpoLineOfBusiness.ObjectOfSeparateAccountingAIT = AdjustmentTable.CorLineOfBusiness
	|		AND SettingsForRecognitionOfExpensesLBDpoLineOfBusiness.Organization = AdjustmentTable.Organization
	|		AND SettingsForRecognitionOfExpensesLBDpoLineOfBusiness.ExpensesAreIncludedInCost
	|
