		|SELECT
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	(CASE
		|		WHEN T.TheseAreLeftovers THEN ENDOFPERIOD(T.Period, MONTH)
		|		ELSE T.Period END) AS Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		// Dimensions
		|	T.Organization,
		|	T.ItemsLocationAttributes,
		|	T.Products,
		|	T.AccountingSection,
		|	T.InventoryOwnerAttribute,
		|	T.Lot,
		|	T.LotVendorAttributes,
		|	T.FinancialAccountingDimension,
		|	T.VATActivityType,
		|
		// Attributes
		|	T.CorCompany,
		|	T.CorItemsLocationAttributes,
		|	T.CorNomenclature,
		|	T.CorAccountingSection,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLot,
		|	T.LotVendorAttributesCorr,
		|	T.CorControllingAttributes,
		|	T.CorVATActivityTypes,
		|
		|	T.AccountingDimensionByPartners,
		|	T.Department AS Department,
		|	T.CorLineOfBusiness,
		|	T.ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses,
		|	T.AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension,
		|	T.GLAccountSettings,
		|	T.BusinessOperation,
		|	T.BusinessTransactionSetting,
		|	T.FinRecordID,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffVariancesToAllocate)
		|			THEN VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods)
		|		ELSE VALUE(Enum.LotRecordTypes.Supplement) END) EntryType,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffVariancesToAllocate)
		|			THEN T.DeviationPeriodSource
		|		ELSE DATETIME(1,1,1) END) VariancePeriod,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		// Resources
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS AddExpensesForGoods,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal AS AddExpensesLocal,
		|	T.CostVariancesMgmt + T.AddExpensesMan AS AddExpensesMan,
		|	T.PermanentDifference,
		|	T.CostTD,
		|	T.AIT AS CostOfPersonalIncomeTax
		|
		|INTO TTOfRegisteredRecordsOfInventoryCosts
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	T.Products <> UNDEFINED
		|
		|UNION ALL
		|
		|SELECT
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		// Dimensions
		|	(CASE WHEN T.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
		|		THEN T.CorCompany
		|		ELSE T.Organization END) AS Organization,
		|	T.CorItemsLocationAttributes AS ItemsLocationAttributes,
		|	T.CorNomenclature AS Products,
		|	T.CorAccountingSection AS AccountingSection,
		|	T.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
		|	T.CorLot AS Lot,
		|	T.LotVendorAttributesCorr AS LotVendorAttributes,
		|	T.CorControllingAttributes AS FinancialAccountingDimension,
		|	T.CorVATActivityTypes AS VATActivityType,
		|
		// Attributes
		|	VALUE(Catalog.Companies.EmptyRef) AS CorCompany,
		|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS CorItemsLocationAttributes,
		|	VALUE(Catalog.Products.EmptyRef) AS CorNomenclature,
		|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS CorAccountingSection,
		|	VALUE(Catalog.InventoryKinds.EmptyRef) AS CorInventoryOwnerAttribute,
		|	UNDEFINED AS CorLot,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributesCorr,
		|	UNDEFINED AS CorControllingAttributes,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS CorVATActivityTypes,
		|
		|	VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef) AS AccountingDimensionByPartners,
		|	T.Department AS Department,
		|	T.CorLineOfBusiness,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AssetAndLiabilityItem,
		|	UNDEFINED AS AssetsLiabilitiesDimension,
		|	UNDEFINED AS GLAccountSettings,
		|	T.BusinessOperation,
		|	T.BusinessTransactionSetting,
		|	T.FinRecordID,
		|	VALUE(Enum.LotRecordTypes.Supplement) AS EntryType,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationToCost)
		|			THEN T.DeviationPeriodSource
		|		ELSE DATETIME(1,1,1) END) VariancePeriod,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS AddExpensesForGoods,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal AS AddExpensesLocal,
		|	T.CostVariancesMgmt + T.AddExpensesMan AS AddExpensesMan,
		|	T.PermanentDifference,
		|	T.CostTD,
		|	T.AIT AS CostOfPersonalIncomeTax
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	T.ThereIsCorPart
		|	AND T.CorNomenclature <> UNDEFINED
		|";
EndFunction

Function TextOfRegisteredRecordedRevenueTT() // RegisteredRecordedRevenueTT
	Return "
		|SELECT
		|	""1"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	T.Period,
		|	T.SourceNodeNumber,
		|
		|	RegisterRecords.ItemsLocationAttributes,
		|	RegisterRecords.SalesOrder,
		|	RegisterRecords.AccountingDimensionByPartners,
		|	RegisterRecords.Department,
		|	RegisterRecords.InventoryType,
		|	RegisterRecords.InventoryOwnerAttribute,
		|	RegisterRecords.AccountingSection,
		|	RegisterRecords.Lot,
		|	RegisterRecords.LotVendorAttributes,
		|	RegisterRecords.FinancialAccountingDimension,
		|	RegisterRecords.VATActivityType,
		|	RegisterRecords.Manager,
		|	RegisterRecords.Warehouse,
		|	RegisterRecords.Terms,
		|	RegisterRecords.Contract,
		|	RegisterRecords.BusinessOperation,
		|	RegisterRecords.SetAccountingDimension,
		|	RegisterRecords.CounterpartyLineOfBusiness,
		|	RegisterRecords.ProductLineOfBusiness,
		|
		|	RegisterRecords.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	RegisterRecords.VATTaxation,
		|	RegisterRecords.SourceOfProductFinancialAccountingGroup,
		|	RegisterRecords.SourceOfARAPFinancialAccountingGroup,
		|	T.DistributionPeriod AS AdjustmentPeriod_,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS AddExpensesForGoods,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS AddExpensesLocal,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS AddExpensesMan,
		|	0 AS SellingExpensesIncludingVAT,
		|	0 AS SellingExpensesExcludingVAT,
		|	0 AS SellingExpensesLocal,
		|	0 AS SellingExpensesMan,
		|	T.PermanentDifference,
		|	T.CostTD
		|
		|INTO RegisteredRecordedRevenueTT
		|FROM
		|	TTDisposalsForDeviations AS T
		|	INNER JOIN TTCashRevenueAndCostOfSales AS RegisterRecords
		|		ON RegisterRecords.AccountingDimensionByPartners = T.AccountingDimensionByPartners
		|		AND RegisterRecords.FinRecordID = T.FinRecordID
		|		AND RegisterRecords.BusinessTransactionSetting = T.BusinessTransactionSetting
		|		AND RegisterRecords.Lot = T.Lot
		|		AND RegisterRecords.LotVendorAttributes = T.LotVendorAttributes
		|		AND RegisterRecords.ReversingEntry = T.ReversingEntry
		|		AND T.ThisIsCurrentPeriod
		|		AND RegisterRecords.Count <> 0
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND NOT T.WriteOffDeviationsToCostOfGoodsSelling
		|	AND RegisterRecords.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries)
		|
		|UNION ALL
		|
		// Deviations in the cost of goods are reflected with the completed adjustment period.
		|SELECT
		|	""2"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	T.Period,
		|	T.SourceNodeNumber,
		|
		|	RegisterRecords.ItemsLocationAttributes,
		|	RegisterRecords.SalesOrder,
		|	RegisterRecords.AccountingDimensionByPartners,
		|	RegisterRecords.Department,
		|	RegisterRecords.InventoryType,
		|	RegisterRecords.InventoryOwnerAttribute,
		|	RegisterRecords.AccountingSection,
		|	RegisterRecords.Lot,
		|	RegisterRecords.LotVendorAttributes,
		|	RegisterRecords.FinancialAccountingDimension,
		|	RegisterRecords.VATActivityType,
		|	RegisterRecords.Manager,
		|	RegisterRecords.Warehouse,
		|	RegisterRecords.Terms,
		|	RegisterRecords.Contract,
		|	RegisterRecords.BusinessOperation,
		|	RegisterRecords.SetAccountingDimension,
		|	RegisterRecords.CounterpartyLineOfBusiness,
		|	RegisterRecords.ProductLineOfBusiness,
		|
		|	RegisterRecords.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	RegisterRecords.VATTaxation,
		|	RegisterRecords.SourceOfProductFinancialAccountingGroup,
		|	RegisterRecords.SourceOfARAPFinancialAccountingGroup,
		|	T.DistributionPeriod AS AdjustmentPeriod_,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|	
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesIncludingVAT END) AS AddExpensesForGoods,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesExcludingVAT END) AS AdditionalExpensesExcludingVAT,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesLocal + T.VATLocal END) AS AddExpensesLocal,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesMgmt  + T.VATManag END) AS AddExpensesMan,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesIncludingVAT END) AS SellingExpensesIncludingVAT,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesExcludingVAT END) AS SellingExpensesExcludingVAT,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesLocal + T.VATLocal END) AS SellingExpensesLocal,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.CostVariancesMgmt  + T.VATManag END) AS SellingExpensesMan,
		|	(CASE
		|		WHEN T.CostVariancesLocal <> 0
		|			THEN T.PermanentDifference
		|		ELSE 0 END) AS PermanentDifference,
		|	(CASE
		|		WHEN T.CostVariancesLocal <> 0
		|			THEN T.CostTD
		|		ELSE 0 END) AS CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|	INNER JOIN AccumulationRegister.RevenueAndCOGS AS RegisterRecords
		|		ON RegisterRecords.AccountingDimensionByPartners = T.AccountingDimensionByPartners
		|		AND RegisterRecords.FinRecordID = T.FinRecordID
		|		AND RegisterRecords.BusinessTransactionSetting = T.BusinessTransactionSetting
		|		AND RegisterRecords.Lot = T.Lot
		|		AND RegisterRecords.LotVendorAttributes = T.LotVendorAttributes
		|		AND RegisterRecords.ReversingEntry = T.ReversingEntry
		|		AND NOT T.ThisIsCurrentPeriod
		|		AND (RegisterRecords.Count <> 0 
		|			OR T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold))
		|		AND BEGINOFPERIOD(RegisterRecords.Period, MONTH) = T.DistributionPeriod
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND NOT T.WriteOffDeviationsToCostOfGoodsSelling
		|	AND RegisterRecords.Period BETWEEN &MinimumPastPeriod AND &EndOfPreviousPeriod
		|	AND RegisterRecords.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries)
		|
		|UNION ALL
		|
		// The amounts of additional expenses for goods are reflected with an empty adjustment period.
		|SELECT
		|	""3"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	T.Period,
		|	T.SourceNodeNumber,
		|
		|	RegisterRecords.ItemsLocationAttributes,
		|	RegisterRecords.SalesOrder,
		|	RegisterRecords.AccountingDimensionByPartners,
		|	RegisterRecords.Department,
		|	RegisterRecords.InventoryType,
		|	RegisterRecords.InventoryOwnerAttribute,
		|	RegisterRecords.AccountingSection,
		|	RegisterRecords.Lot,
		|	RegisterRecords.LotVendorAttributes,
		|	RegisterRecords.FinancialAccountingDimension,
		|	RegisterRecords.VATActivityType,
		|	RegisterRecords.Manager,
		|	RegisterRecords.Warehouse,
		|	RegisterRecords.Terms,
		|	RegisterRecords.Contract,
		|	RegisterRecords.BusinessOperation,
		|	RegisterRecords.SetAccountingDimension,
		|	RegisterRecords.CounterpartyLineOfBusiness,
		|	RegisterRecords.ProductLineOfBusiness,
		|
		|	RegisterRecords.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	RegisterRecords.VATTaxation,
		|	RegisterRecords.SourceOfProductFinancialAccountingGroup,
		|	RegisterRecords.SourceOfARAPFinancialAccountingGroup,
		|	DATETIME(1,1,1) AS AdjustmentPeriod_,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|	
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AdditionalExpensesIncludingVAT END) AS AddExpensesForGoods,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AdditionalExpensesExcludingVAT END) AS AdditionalExpensesExcludingVAT,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AddExpensesLocal END) AS AddExpensesLocal,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AddExpensesMan END) AS AddExpensesMan,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AdditionalExpensesIncludingVAT END) AS SellingExpensesIncludingVAT,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AdditionalExpensesExcludingVAT END) AS SellingExpensesExcludingVAT,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AddExpensesLocal END) AS SellingExpensesLocal,
		|	(CASE
		|		WHEN T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
		|			THEN 0
		|		ELSE T.AddExpensesMan END) AS SellingExpensesMan,
		|	(CASE
		|		WHEN T.CostVariancesLocal = 0
		|			THEN T.PermanentDifference
		|		ELSE 0 END) AS PermanentDifference,
		|	(CASE
		|		WHEN T.CostVariancesLocal = 0
		|			THEN T.CostTD
		|		ELSE 0 END) AS CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|	INNER JOIN AccumulationRegister.RevenueAndCOGS AS RegisterRecords
		|		ON RegisterRecords.AccountingDimensionByPartners = T.AccountingDimensionByPartners
		|		AND RegisterRecords.FinRecordID = T.FinRecordID
		|		AND RegisterRecords.BusinessTransactionSetting = T.BusinessTransactionSetting
		|		AND RegisterRecords.Lot = T.Lot
		|		AND RegisterRecords.LotVendorAttributes = T.LotVendorAttributes
		|		AND RegisterRecords.ReversingEntry = T.ReversingEntry
		|		AND NOT T.ThisIsCurrentPeriod
		|		AND (RegisterRecords.Count <> 0 
		|			OR T.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold))
		|		AND BEGINOFPERIOD(RegisterRecords.Period, MONTH) = T.DistributionPeriod
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND NOT T.WriteOffDeviationsToCostOfGoodsSelling
		|	AND RegisterRecords.Period BETWEEN &MinimumPastPeriod AND &EndOfPreviousPeriod
		|	AND RegisterRecords.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries)
		|
		|UNION ALL
		|
		// Write-off of deviations in manufactured products to the cost of goods sold.
		|SELECT
		|	""4"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	T.Period,
		|	T.SourceNodeNumber,
		|
		|	T.ItemsLocationAttributes,
		|	UNDEFINED AS SalesOrder,
		|	DimensionPartner_.DimensionKey AS AccountingDimensionByPartners,
		|	T.Department,
		|	ISNULL(CAST(T.InventoryOwnerAttribute AS Catalog.InventoryKinds).InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)) AS InventoryType,
		|	T.InventoryOwnerAttribute,
		|	T.AccountingSection,
		|	UNDEFINED AS Lot,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributes,
		|	UNDEFINED AS FinancialAccountingDimension,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATActivityType,
		|	VALUE(Catalog.Users.EmptyRef) AS Manager,
		|	T.StorageLocation AS Warehouse,
		|	VALUE(Catalog.TermsOfSale.EmptyRef) AS Terms,
		|	UNDEFINED AS Contract,
		|	T.BusinessOperation,
		|	VALUE(Catalog.KeysOfSetAccountingDimension.EmptyRef) AS SetAccountingDimension,
		|	T.LineOfBusiness AS CounterpartyLineOfBusiness,
		|	T.LineOfBusiness AS ProductLineOfBusiness,
		|
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATTaxation,
		|	UNDEFINED AS SourceOfProductFinancialAccountingGroup,
		|	VALUE(Catalog.ARAPObjects.EmptyRef) AS SourceOfARAPFinancialAccountingGroup,
		|	T.DistributionPeriod AS AdjustmentPeriod_,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	0 AS AddExpensesForGoods,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS AddExpensesLocal,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS AddExpensesMan,
		|	0 AS SellingExpensesIncludingVAT,
		|	0 AS SellingExpensesExcludingVAT,
		|	0 AS SellingExpensesLocal,
		|	0 AS SellingExpensesMan,
		|	T.PermanentDifference,
		|	T.CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|
		|	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionPartner_
		|	ON (DimensionPartner_.Partner = VALUE(Catalog.Partners.EmptyRef))
		|		AND (DimensionPartner_.Organization = T.Organization)
		|		AND (DimensionPartner_.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
		|		AND (DimensionPartner_.Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
		|		AND (DimensionPartner_.LineOfBusiness = T.LineOfBusiness)
		|WHERE
		|	T.WriteOffDeviationsToCostOfGoodsSelling
		|	AND (T.CostVariancesLocal <> 0 OR T.AddExpensesLocal <> 0 OR T.VATLocal <> 0
		|		OR T.CostVariancesMgmt <> 0 OR T.AddExpensesMan <> 0 OR T.VATManag <> 0)
		|";
EndFunction
	
Function TextTTOfRegisteredRecordedOtherExpenses() // TTOtherExpenses
	Return "
		// We form the Registered Recorded Receipt separately according to the upr, Local and TA, because there may be different options for the distribution of expenses.
		// The Receipt of Registered Recorded by management and regulated accounting.
		|SELECT
		|	""1"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	(CASE
		|		WHEN T.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
		|			THEN T.CorCompany
		|		ELSE T.Organization END) AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	T.CorExpenseItem AS ExpenseItem,
		|	T.CorExpenditureDimension AS DimensionOfExpenses,
		|
		|	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CorLineOfBusiness,
		|	VALUE(Catalog.BusinessStructure.EmptyRef) AS DebitBusinessUnit,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
		|	UNDEFINED AS CorExpenditureDimension,
		|	T.BusinessOperation,
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	DATETIME(1,1,1) AS VariancePeriod,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS Sum,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS AmountExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS SumCompl,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS SumMan,
		|	(CASE 
		|		WHEN NOT T.CorExpenseItem.EnteredInTaxAccounting
		|			THEN T.AddExpensesLocal + T.VATLocal
		|		ELSE 0 END) AS PermanentDifference,
		// The Additional expense amount in TA is reflected with an empty deviation period.
		// The sum TA = Additional expenses Regl + NDSRegl, so only the sum of deviations falls into the time difference 
		|	T.CostVariancesLocal  AS CostTD,
		|	0 AS AITAmount
		|
		|INTO TTOtherExpenses
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND T.CorExpenseItem <> UNDEFINED 
		|	AND T.CorExpenseItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		// The distribution of deviations between companies in management accounting is not supported.
		|	AND (T.CorCompany = VALUE(Catalog.Companies.EmptyRef)
		|		OR T.CorCompany = T.Organization)
		|
		|UNION ALL
		|
		// Tax Registered Recorded Receipts.
		|SELECT
		|	""2"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	(CASE
		|		WHEN T.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
		|			THEN T.CorCompany
		|		ELSE T.Organization END) AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	T.CorExpenseItem AS ExpenseItem,
		|	T.CorExpenditureDimension AS DimensionOfExpenses,
		|
		|	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CorLineOfBusiness,
		|	VALUE(Catalog.BusinessStructure.EmptyRef) AS DebitBusinessUnit,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
		|	UNDEFINED AS CorExpenditureDimension,
		|	T.BusinessOperation,
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	(CASE
		|		WHEN CAST(T.CorExpenseItem AS ChartOfCharacteristicTypes.ExpenseItems).CostAllocationOptionTax IN (
		|		 		VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
		|		 		VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly))
		|			THEN T.DistributionPeriod
		|		ELSE DATETIME(1,1,1) END) AS VariancePeriod,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	0 AS Sum,
		|	0 AS AmountExcludingVAT,
		|	0 AS SumCompl,
		|	0 AS SumMan,
		|	(CASE 
		|		WHEN NOT T.CorExpenseItem.EnteredInTaxAccounting
		|			THEN T.CostVariancesLocal - T.CostTD
		|		ELSE T.PermanentDifference END) AS PermanentDifference,
		// From the sum of the Cost(TD), we will subtract the Cost(TD) reflected in the Local accounting Registered Records.
		|	T.CostTD - T.CostVariancesLocal AS CostTD,
		|	T.AIT AS AITAmount
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND T.CorExpenseItem <> UNDEFINED 
		|	AND T.CorExpenseItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		// The distribution of deviations between companies in management accounting is not supported.
		|	AND (T.CorCompany = VALUE(Catalog.Companies.EmptyRef)
		|		OR T.CorCompany = T.Organization)
		|
		|UNION ALL
		|
		|SELECT
		|	""3"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.ExpenseItemOfWriteOff AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	(CASE
		|		WHEN T.ExpenseItemOfWriteOff <> T.CorExpenseItem
		|		 OR T.DimensionOfExpenses <> T.CorExpenditureDimension
		|			THEN T.CorExpenseItem
		|		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) END) AS CorExpenseItem,
		|	(CASE
		|		WHEN T.ExpenseItemOfWriteOff <> T.CorExpenseItem
		|		 OR T.DimensionOfExpenses <> T.CorExpenditureDimension
		|			THEN T.CorExpenditureDimension
		|		ELSE UNDEFINED END) AS CorExpenditureDimension,
		|	T.BusinessOperation,
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffVariancesToAllocate)
		|			THEN T.DeviationPeriodSource
		|		WHEN T.BusinessOperation IN (
		|				VALUE(Enum.BusinessTransactions.AllocationOfExpensesByLinesOfBusiness),
		|				VALUE(Enum.BusinessTransactions.AllocationOfNormalizedExpensesAsPerTA))
		|			THEN T.DistributionPeriod
		|		ELSE DATETIME(1,1,1) END) VariancePeriod,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT AS Sum,
		|	T.CostVariancesExcludingVAT AS AmountExcludingVAT,
		|	T.CostVariancesLocal + T.VATLocal AS SumCompl,
		|	T.CostVariancesMgmt + T.VATManag AS SumMan,
		|	T.PermanentDifference,
		|	T.CostTD,
		|	T.AIT AS AITAmount
		|FROM
		|	TTDisposalsForDeviations AS T
		|	LEFT JOIN TTNodesOtherExpensesUnfinishedProduction AS NodesSourcesOfUnfinishedProduction
		|		ON NodesSourcesOfUnfinishedProduction.NodeNumber = T.SourceNodeNumber
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND T.ExpenseItemOfWriteOff <> UNDEFINED 
		|	AND T.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	AND T.Products = UNDEFINED
		|	AND NodesSourcesOfUnfinishedProduction.NodeNumber IS NULL
		|
		|UNION ALL
		|
		// The expense of Registering Recorded for the amount of additional expenses.
		|SELECT
		|	""4"" AS RequestSource,
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.ExpenseItemOfWriteOff AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|
		|	T.CorLineOfBusiness AS CorLineOfBusiness,
		|	T.DebitBusinessUnit AS DebitBusinessUnit,
		|	(CASE
		|		WHEN T.ExpenseItemOfWriteOff <> T.CorExpenseItem
		|		 OR T.DimensionOfExpenses <> T.CorExpenditureDimension
		|			THEN T.CorExpenseItem
		|		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) END) AS CorExpenseItem,
		|	(CASE
		|		WHEN T.ExpenseItemOfWriteOff <> T.CorExpenseItem
		|		 OR T.DimensionOfExpenses <> T.CorExpenditureDimension
		|			THEN T.CorExpenditureDimension
		|		ELSE UNDEFINED END) AS CorExpenditureDimension,
		|	T.BusinessOperation,
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// For Registered Records with the amounts of additional expenses for goods, the deviation period is not filled in,
		// because the Additional expense amounts always relate to the current period.
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffVariancesToAllocate)
		|			THEN T.DeviationPeriodSource
		|		ELSE DATETIME(1,1,1) END) VariancePeriod,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.AdditionalExpensesIncludingVAT AS Sum,
		|	T.AdditionalExpensesExcludingVAT AS AmountExcludingVAT,
		|	T.AddExpensesLocal AS SumCompl,
		|	T.AddExpensesMan AS SumMan,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	0 AS AITAmount
		|FROM
		|	TTDisposalsForDeviations AS T
		|	LEFT JOIN TTNodesOtherExpensesUnfinishedProduction AS NodesSourcesOfUnfinishedProduction
		|		ON NodesSourcesOfUnfinishedProduction.NodeNumber = T.SourceNodeNumber
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND T.ExpenseItemOfWriteOff <> UNDEFINED 
		|	AND T.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	AND T.Products = UNDEFINED
		|	AND NodesSourcesOfUnfinishedProduction.NodeNumber IS NULL
		|";
EndFunction

Function TextOfTTRegisteredRecordsOtherAssetsLiabilities() // TTRegisteredRecordsOtherAssetsLiabilities
	Return "
		|SELECT
		|	""1"" AS RequestSource,
		|	T.Recorder,
		|	T.Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	T.AssetAndLiabilityItem AS AssetRef,
		|	T.AssetsLiabilitiesDimension AS Dimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
		|
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	(CASE
		|		WHEN T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT < 0 AND T.ReversingEntry
		|			THEN T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT
		|		ELSE 0 END) AS Sum,
		|	(CASE
		|		WHEN T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT < 0 AND T.ReversingEntry
		|			THEN T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT
		|		ELSE 0 END) AS AmountIncludingVAT,
		|	(CASE
		|		WHEN T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT < 0 AND T.ReversingEntry
		|			THEN T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT
		|		ELSE 0 END) AS AmountExcludingVAT,
		|	(CASE
		|		WHEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0 AND T.ReversingEntry
		|			THEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal
		|		ELSE 0 END) AS SumCompl,
		|	(CASE
		|		WHEN T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag < 0 AND T.ReversingEntry
		|			THEN T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag
		|		ELSE 0 END) AS SumMan,
		|	(CASE
		|		WHEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0 AND T.ReversingEntry
		|			THEN T.PermanentDifference
		|		ELSE 0 END) AS PermanentDifference,
		|	(CASE
		|		WHEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0 AND T.ReversingEntry
		|			THEN T.CostTD
		|		ELSE 0 END) AS CostTD
		|
		|INTO TTRegisteredRecordsOtherAssetsLiabilities
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND T.AssetAndLiabilityItem <> UNDEFINED 
		|	AND T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
		|	AND (
		|		(T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT > 0
		|		OR T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT > 0
		|		OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0
		|		OR T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag > 0)
		|		AND NOT T.ReversingEntry
		|		OR (T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT < 0
		|		OR T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT < 0
		|		OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0
		|		OR T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag < 0)
		|		AND T.ReversingEntry)
		|
		|UNION ALL
		|
		|SELECT
		|	""2"" AS RequestSource,
		|	T.Recorder,
		|	T.Period,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	T.AssetAndLiabilityItem AS AssetRef,
		|	T.AssetsLiabilitiesDimension AS Dimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Credit) AS DebitCredit,
		|
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	(CASE
		|		WHEN T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT > 0 AND T.ReversingEntry
		|			THEN -(T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT)
		|		ELSE 0 END) AS Sum,
		|	(CASE
		|		WHEN T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT > 0 AND T.ReversingEntry
		|			THEN -(T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT)
		|		ELSE 0 END) AS AmountIncludingVAT,
		|	(CASE
		|		WHEN T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT > 0 AND T.ReversingEntry 
		|			THEN -(T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT)
		|		ELSE 0 END) AS AmountExcludingVAT,
		|	(CASE
		|		WHEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0 AND T.ReversingEntry 
		|			THEN -(T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal)
		|		ELSE 0 END) AS SumCompl,
		|	(CASE
		|		WHEN T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag > 0 AND T.ReversingEntry 
		|			THEN -(T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag)
		|		ELSE 0 END) AS SumMan,
		|	(CASE
		|		WHEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0 AND T.ReversingEntry 
		|			THEN -T.PermanentDifference
		|		ELSE 0 END) AS PermanentDifference,
		|	(CASE
		|		WHEN T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0 AND NOT T.ReversingEntry
		|		 OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0 AND T.ReversingEntry 
		|			THEN -T.CostTD
		|		ELSE 0 END) AS CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND NOT T.ThereIsCorPart
		|	AND T.AssetAndLiabilityItem <> UNDEFINED 
		|	AND T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
		|	AND (
		|		(T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT < 0
		|		OR T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT < 0
		|		OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal < 0
		|		OR T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag < 0)
		|		AND NOT T.ReversingEntry
		|		OR (T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT > 0
		|		OR T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT > 0
		|		OR T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal > 0
		|		OR T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag > 0)
		|		AND T.ReversingEntry)
		|
		|UNION ALL
		|
		// Transfer to a branch (on the sender's side)
		|SELECT
		|	""3"" AS RequestSource,
		|	T.Recorder,
		|	T.Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting) AS AssetRef,
		|	T.CorCompany AS Dimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
		|
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS Sum,
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS AmountIncludingVAT,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS AmountExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS SumCompl,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS SumMan,
		|	T.PermanentDifference,
		|	T.CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND T.BusinessOperation IN (
		|		VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices),
		|		VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices),
		|		VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices))
		|
		|UNION ALL
		|
		// Transfer to a branch (on the recipient's side)
		|SELECT
		|	""4"" AS RequestSource,
		|	T.Recorder,
		|	T.Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.CorCompany AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting) AS AssetRef,
		|	T.Organization AS Dimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Credit) AS DebitCredit,
		|
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS Sum,
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS AmountIncludingVAT,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS AmountExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS SumCompl,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS SumMan,
		|	T.PermanentDifference,
		|	T.CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	NOT T.TheseAreLeftovers
		|	AND T.BusinessOperation IN (
		|		VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices),
		|		VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices),
		|		VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices))
		|
		|UNION ALL
		|
		// Distribution of expenses for the profitability&cost (to support correspondence on the Unified Plan)
		|SELECT
		|	""5"" AS RequestSource,
		|	T.Recorder,
		|	T.Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ProfitAndLoss) AS AssetRef,
		|	UNDEFINED AS Dimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
		|
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	0 AS Sum,
		|	0 AS AmountIncludingVAT,
		|	0 AS AmountExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS SumCompl,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS SumMan,
		|	0 AS PermanentDifference,
		|	0 AS CostTD
		|FROM
		|	TTDisposalsForDeviations AS T
		|WHERE
		|	T.BusinessOperation = VALUE(Enum.BusinessTransactions.AllocationOfExpensesByLinesOfBusiness)
		|";
	
EndFunction
	
Function	TextTTOfRegisteredRecordedOtherExpensesOfWorkInProgress() // TTOtherWorkInProgressExpenses
	Return "
		|SELECT
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.DebitBusinessUnit AS Department,
		|	T.CorLineOfBusiness AS LineOfBusiness,
		|	T.ExpenseItemOfWriteOff AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.CorLot AS ProductionLot,
		|	UNDEFINED AS ProductionOrder,
		|	0 AS RowCodeProducts,
		|	VALUE(Catalog.ProductionStages.EmptyRef) AS Stage,
		|	T.ProductCostElement AS ProductCostElement,
		|	T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
		|	CAST(T.CorLot AS Catalog.ProductionLots).ProductsGroup AS ProductsGroup,
		|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ProductsAccountingDimension,
		|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS AccountingSection,
		|	VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributesCorr,
		|
		|	T.BusinessOperation,
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS Cost,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS CostExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS LocalCost,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS CostMan,
		|	T.PermanentDifference,
		|	T.CostTD,
		|	T.AIT
		|
		|INTO TTOtherWorkInProgressExpenses
		|FROM
		|	TTDisposalsForDeviations AS T
		|	INNER JOIN TTNodesOtherExpensesUnfinishedProduction AS ReceiverNodes_
		|		ON ReceiverNodes_.NodeNumber = T.ReceiverNodeNumber
		|WHERE
		|	NOT T.TheseAreLeftovers
		|
		|UNION ALL
		|
		|SELECT
		|	T.Recorder,
		|	T.Recorder AS DocumentRegisterRecords,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	T.Period,
		|	T.SourceNodeNumber,
		|	T.ReceiverNodeNumber,
		|
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.ExpenseItemOfWriteOff AS ExpenseItem,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.Lot AS ProductionLot,
		|	UNDEFINED AS ProductionOrder,
		|	0 AS RowCodeProducts,
		|	VALUE(Catalog.ProductionStages.EmptyRef) AS Stage,
		|	T.ProductCostElement AS ProductCostElement,
		|	T.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
		|	CAST(T.Lot AS Catalog.ProductionLots).ProductsGroup AS ProductsGroup,
		|	T.CorItemsLocationAttributes AS ProductsAccountingDimension,
		|	T.CorAccountingSection AS AccountingSection,
		|	T.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
		|	T.LotVendorAttributesCorr AS LotVendorAttributesCorr,
		|
		|	T.BusinessOperation,
		|	T.FinRecordID,
		|	T.BusinessTransactionSetting,
		// The Storno attribute should not be filled in, because these are calculated RegisteredRecords, not reversed Registered Records of the source document.
		|	FALSE AS ReversingEntry,
		|
		|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT AS Cost,
		|	T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT AS CostExcludingVAT,
		|	T.CostVariancesLocal + T.AddExpensesLocal + T.VATLocal AS LocalCost,
		|	T.CostVariancesMgmt + T.AddExpensesMan  + T.VATManag AS CostMan,
		|	T.PermanentDifference,
		|	T.CostTD,
		|	T.AIT
		|FROM
		|	TTDisposalsForDeviations AS T
		|	INNER JOIN TTNodesOtherExpensesUnfinishedProduction AS SourceNodes
		|		ON SourceNodes.NodeNumber = T.SourceNodeNumber
		|WHERE
		|	NOT T.TheseAreLeftovers
		|";
EndFunction
	
#EndRegion

#Region StageProcedures_DistributeDeviationsInCostOfGoods
		
// Distribution of deviations in the cost of goods at the average sliding.
//
Procedure DistributeDeviationsInCostOfGoods(CalculationParameters)
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "DistributeDeviationsInCostOfGoods_StornoOfRegisteredRecords");

	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	#Region FormationOfStornoRegisteredRecords
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	#Region TTImplementationOfPastPeriods
	Query.Text = Query.Text + "
	|SELECT
	|	MIN(DD.Period) AS Period,
	|	DD.DocumentSource AS DocumentSalesOfGoodsAndServices,
	|	Register3.IBDocumentDate AS DateOfSourceDocument,
	|	DD.CorItemsLocationAttributes.Products AS Products,
	|	DD.CorItemsLocationAttributes.Characteristic AS Characteristic,
	|	DD.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	DD.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
	|	DD.DimensionOfExpenses AS DimensionOfExpenses,
	|	DD.BusinessOperation AS BusinessOperation,
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	MIN(DD.FinRecordID) AS FinRecordID,
	|	SUM(DD.Count) AS Count
	|
	|INTO TTImplementationOfPastPeriods
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	INNER JOIN InformationRegister.DocumentsRegistry AS Register3
	|		ON Register3.Ref = DD.DocumentSource
	|		AND NOT Register3.AdditionalRecord
	|WHERE
	|	DD.EntryType = VALUE(Enum.LotRecordTypes.PreviousPeriodReturn)
	|	AND DD.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	AND DD.Count > 0
	|	AND NOT DD.ReversingEntry
	|GROUP BY
	|	DD.DocumentSource,
	|	Register3.IBDocumentDate,
	|	DD.CorItemsLocationAttributes.Products,
	|	DD.CorItemsLocationAttributes.CHARACTERISTIC,
	|	DD.CorInventoryOwnerAttribute,
	|	DD.ExpenseItemOfWriteOff,
	|	DD.DimensionOfExpenses,
	|	DD.BusinessOperation,
	|	DD.BusinessTransactionSetting
	|
	|UNION ALL
	|
	|SELECT
	|	MIN(DD.Period) AS Period,
	|	SaleAdjustment.Ref AS DocumentSalesOfGoodsAndServices,
	|	Register3.IBDocumentDate AS DateOfSourceDocument,
	|	DD.CorItemsLocationAttributes.Products AS Products,
	|	DD.CorItemsLocationAttributes.Characteristic AS Characteristic,
	|	DD.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItemOfWriteOff,
	|	UNDEFINED AS DimensionOfExpenses,
	|	DD.BusinessOperation AS BusinessOperation,
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	MIN(DD.FinRecordID) AS FinRecordID,
	|	SUM(DD.Count) AS Count
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	INNER JOIN Document.SaleAdjustment AS SaleAdjustment
	|		ON SaleAdjustment.DocumentBasis = DD.DocumentSource
	|		AND NOT SaleAdjustment.Ref = DD.Recorder
	|		AND SaleAdjustment.Date < &BeginOfPeriod
	|	INNER JOIN InformationRegister.DocumentsRegistry AS Register3
	|		ON Register3.Ref = SaleAdjustment.Ref
	|		AND NOT Register3.AdditionalRecord
	|WHERE
	|	DD.EntryType = VALUE(Enum.LotRecordTypes.PreviousPeriodReturn)
	|	AND DD.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	AND DD.Count > 0
	|	AND NOT DD.ReversingEntry
	|GROUP BY
	|	SaleAdjustment.Ref,
	|	Register3.IBDocumentDate,
	|	DD.CorItemsLocationAttributes.Products,
	|	DD.CorItemsLocationAttributes.CHARACTERISTIC,
	|	DD.CorInventoryOwnerAttribute,
	|	DD.BusinessOperation,
	|	DD.BusinessTransactionSetting
	|
	|INDEX BY
	|	DocumentSalesOfGoodsAndServices
	|;";
	#EndRegion
	
	#Region CorrectedDocuments_
	
	Query.Text = Query.Text + CostCalculationFillingInformationAboutLots.TextCorrectedDocuments(); // tue Corrected documents
	Query.Text = Query.Text + Common.QueryBatchSeparator() + "
	|SELECT
	|	MIN(BEGINOFPERIOD(T.MinimumPeriod, MONTH)) AS MinimumPeriod
	|FROM (	
	|	SELECT
	|		MIN(T.DateOfDocumentBeingCancelled) AS MinimumPeriod
	|	FROM
	|		CorrectedDocuments_ AS T
	|	WHERE
	|		T.DateOfDocumentBeingCancelled <> DATETIME(1,1,1)
	|
	|	UNION ALL
	|
	|	SELECT
	|		MIN(T.DateOfSourceDocument) AS MinimumPeriod
	|	FROM
	|		TTImplementationOfPastPeriods AS T
	|	WHERE
	|		T.DateOfSourceDocument <> DATETIME(1,1,1)
	|	) AS T
	|";

	#EndRegion
	
	QueryResult = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,, True);
	Selection = QueryResult.Select();
	
	BeginOfPeriod = CalculationParameters.PayrollPeriod.BeginOfPeriod;
	If Selection.Next() Then
		MinimumPeriod = ?(ValueIsFilled(Selection.MinimumPeriod), Selection.MinimumPeriod, BeginOfPeriod);
	Else
		MinimumPeriod = BeginOfPeriod; 
	EndIf;
	
	AddlParameters = CalculationParameters.AdditionalStageRequestParameters;
	AddlParameters.Insert("MinimumPeriod", MinimumPeriod);
	AddlParameters.Insert("MinimumPastPeriod", Min(MinimumPeriod, CalculationParameters.PayrollPeriod.EndOfPreviousPeriod));
	
	Query.SetParameter("MinimumPeriod", AddlParameters.MinimumPeriod);
	Query.SetParameter("MinimumPastPeriod", AddlParameters.MinimumPastPeriod);
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"TTIsStornoOfDeviationsOfPreviousPeriod");
		
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextDistributeDeviationsInCostOfGoodsRefundsAndRegisteredRecordsStorno(CalculationParameters));
		
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
		
	#EndRegion
	
	CostCalculationLESSolution.PreparingDataToSolveCaseOfDeviationsInCostOfGoods(CalculationParameters);
	
	If CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, "TTNodesOfDeviations") = 0
	 And CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, "TTIsStornoOfDeviationsOfPreviousPeriod") = 0 Then
		
		NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
		CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);	
		
		Return;
		
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "DistributeDeviationsInCostOfGoods_SolutionSLE");
	
	#Region DataPreparationAndSLESolution
	
	RequestNodes = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(RequestNodes, CalculationParameters);
	
	#Region Nodes
	RequestNodes.Text =
	"SELECT
	|	T.NodeNumber,
	|	T.CostVariancesIncludingVAT,
	|	T.CostVariancesExcludingVAT,
	|	T.CostVariancesLocal,
	|	T.CostVariancesMgmt,
	|	T.AdditionalExpensesIncludingVAT,
	|	T.AdditionalExpensesExcludingVAT,
	|	T.AddExpensesLocal,
	|	T.AddExpensesMan,
	|	T.VATLocal,
	|	T.VATManag,
	|	T.PermanentDifference,
	|	T.CostInTaxAccounting,
	|	T.AIT
	|FROM
	|	TTNodesOfDeviations AS T
	|ORDER BY
	|	NodeNumber
	|";
	#EndRegion
	
	CommunicationRequest = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(CommunicationRequest, CalculationParameters);
	
	#Region Links
	CommunicationRequest.Text =
	"SELECT
	|	T.SourceNodeNumber AS SourceNodeNumber,
	|	T.ReceiverNodeNumber AS ReceiverNodeNumber,
	|	-T.NumberWithVAT AS WeightWithVAT,
	|	-T.QuantityWithoutVAT AS WeightWithoutVAT,
	|	-T.NumberOfLocal AS LocalWeight,
	|	-T.NumberOfTA AS WeightTA,
	|	-T.NumberOfMen AS ManSWeight
	|FROM
	|	DeviationTTCommunication AS T
	|
	|UNION ALL
	|
	|SELECT
	|	T.NodeNumber AS SourceNodeNumber,
	|	T.NodeNumber AS ReceiverNodeNumber,
	|	SUM(T.WeightWithVAT) AS WeightWithVAT,
	|	SUM(T.WeightWithoutVAT) AS WeightWithoutVAT,
	|	SUM(T.LocalWeight) AS LocalWeight,
	|	SUM(T.WeightTA) AS WeightTA,
	|	SUM(T.ManSWeight) AS ManSWeight
	|FROM (
	|	SELECT
	|		T.NodeNumber,
	|		T.NumberWithVAT AS WeightWithVAT,
	|		T.QuantityWithoutVAT AS WeightWithoutVAT,
	|		T.NumberOfLocal AS LocalWeight,
	|		T.NumberOfTA AS WeightTA,
	|		T.NumberOfMen AS ManSWeight
	|	FROM
	|		TTNodesOfDeviations AS T
	|
	|	UNION ALL
	|
	// We will reduce the initial number in the node during oncoming movements to the same node.
	// This is relevant when accounting for deviations in storage locations is disabled. 
	|	SELECT
	|		T.SourceNodeNumber,
	|		-T.NumberWithVAT AS WeightWithVAT,
	|		-T.QuantityWithoutVAT AS WeightWithoutVAT,
	|		-T.NumberOfLocal AS LocalWeight,
	|		-T.NumberOfTA AS WeightTA,
	|		-T.NumberOfMen AS ManSWeight
	|	FROM
	|		DeviationTTCommunicationPreliminary AS T
	|	WHERE
	|		T.SourceNodeNumber = T.ReceiverNodeNumber
	|	) AS T
	|GROUP BY
	|	T.NodeNumber
	|";
	#EndRegion
	
	#Region SolvingSLUCommonPart
	
	ExplanationForMeasurement = NStr("vi = 'Giải pháp cho chênh lệch';
									|ru = 'Решение для отклонений';
									|en = 'Solution for variances'; fa = 'Solution for variances';
									|it = 'Solution for variances';
									|pl = 'Solution for variances';
									|tr = 'Farklar için çözüm'", Common.DefaultLanguageCode());
	
	// adjusting the cost of nodes with zero weight
	SLEFieldStructure = New Structure;
	SLEFieldStructure.Insert("WeightWithVAT", "CostVariancesIncludingVAT, AdditionalExpensesIncludingVAT");
	SLEFieldStructure.Insert("WeightWithoutVAT", "CostVariancesExcludingVAT, AdditionalExpensesExcludingVAT");
	SLEFieldStructure.Insert("ManSWeight", "CostVariancesMgmt, AddExpensesMan, VATManag");
	SLEFieldStructure.Insert("LocalWeight", "CostVariancesLocal, AddExpensesLocal, VATLocal, PermanentDifference");
	SLEFieldStructure.Insert("WeightTA", "CostInTaxAccounting, AIT");

	CostCalculationAppliedAlgorithms.AdjustCostOfNodesSLEFromQueries(
		CalculationParameters,
		RequestNodes,
		"NodeNumber",
		CommunicationRequest,
		"SourceNodeNumber, ReceiverNodeNumber",
		SLEFieldStructure,
		ExplanationForMeasurement);
		
	MatrixOfNodes  = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, RequestNodes,,, True, ExplanationForMeasurement + ", " + NStr("vi = 'nút';
																																													|ru = 'узлы';
																																													|en = 'nodes'; fa = 'nodes';
																																													|it = 'nodi';
																																													|pl = 'węzły';
																																													|tr = 'üniteler'", Common.DefaultLanguageCode()));
	RelationshipMatrix = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, CommunicationRequest,,, True, ExplanationForMeasurement + ", " + NStr("vi = 'liên kết';
																																																|ru = 'связи';
																																																|en = 'links'; fa = 'links';
																																																|it = 'collegamenti';
																																																|pl = 'powiązania';
																																																|tr = 'bağlantılar'", Common.DefaultLanguageCode()));
	
	UploadFormat = TrimAll(Lower(CalculationParameters.UploadingCalculationData.FormatForSavingSLUData));
	DirectoryName = TrimAll(CalculationParameters.UploadingCalculationData.DirectoryForSavingSLUData);
 	If UploadFormat = "txt" And ValueIsFilled(DirectoryName) Then  
		
		DirectoryName = CommonClientServer.AddLastPathSeparator(DirectoryName);
			
		NodeTable_ = MatrixOfNodes.Unload();
		FileName = DirectoryName + "DataSourceOfNodes_DeviationsInCostOfGoods.txt";
		ValueToFile(FileName, NodeTable_);
			
		LinkTable = RelationshipMatrix.Unload();
		FileName = DirectoryName + "SourceOfDataLinks_DeviationsInCostOfGoods.txt";
		ValueToFile(FileName, LinkTable);
		
	EndIf;
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "CalculateSystemsOfLinearEquationsManWithVAT", ExplanationForMeasurement);
	SystemOfLinearEquationsCalculation = CostCalculationLESSolution.GetComponentToSolveSLU(CalculationParameters);
	
	SystemOfLinearEquationsCalculation.NodeDataSource = MatrixOfNodes;
	SystemOfLinearEquationsCalculation.RelationDataSource = RelationshipMatrix;
	
	// description of key columns
	SystemOfLinearEquationsCalculation.EquationsInNodesColumn = "NodeNumber";
	SystemOfLinearEquationsCalculation.EquationsInRelationsColumn = "ReceiverNodeNumber";
	SystemOfLinearEquationsCalculation.VariablesInRelationsColumn = "SourceNodeNumber";
	
	#EndRegion
	
	#Region SolutionSLU_ManagementAccountingWithVAT
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "CostVariancesIncludingVAT";
	SystemDetails.FactorsInRelationsColumn = "WeightWithVAT";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "AdditionalExpensesIncludingVAT";
	SystemDetails.FactorsInRelationsColumn = "WeightWithVAT";
	
	// Decision
	WithVATDecisionTable = SystemOfLinearEquationsCalculation.SolveSystemsOfLinearEquations(Not CalculationParameters.DisableGraphReduction);
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);

	// Loading solutions into a temporary table.
	SolutionColumnNames = "CostVariancesIncludingVAT, AdditionalExpensesIncludingVAT";
	
	SLULoadingParameters = CostCalculationAppliedAlgorithms.InitializeParametersForLoadingSLUSolution(SolutionColumnNames);
	SLULoadingParameters.NumberOfDigits = 31;
	SLULoadingParameters.ConsiderZeroSolutions = False;
	SLULoadingParameters.TempTableName = "WithVATDecisionTable";
	
	CostCalculationAppliedAlgorithms.LoadSLUSolutionIntoTemporaryTable(
		CalculationParameters,
		SLULoadingParameters,
		WithVATDecisionTable,
		ExplanationForMeasurement);
	
	#EndRegion
	
	#Region SolutionSLU_ManagementAccountingWithoutVAT
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "CalculateSystemsOfLinearManEquationsWithoutVAT", ExplanationForMeasurement);
	
	// reset for the next set of descriptions
	SystemOfLinearEquationsCalculation.SystemsDescription.Clear();
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "CostVariancesExcludingVAT";
	SystemDetails.FactorsInRelationsColumn = "WeightWithoutVAT";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "AdditionalExpensesExcludingVAT";
	SystemDetails.FactorsInRelationsColumn = "WeightWithoutVAT";
	
	// Decision
	TableOfSolutionsWithoutVAT = SystemOfLinearEquationsCalculation.SolveSystemsOfLinearEquations(Not CalculationParameters.DisableGraphReduction);
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
	// Loading solutions into a temporary table.
	SolutionColumnNames = "CostVariancesExcludingVAT, AdditionalExpensesExcludingVAT";
	
	SLULoadingParameters = CostCalculationAppliedAlgorithms.InitializeParametersForLoadingSLUSolution(SolutionColumnNames);
	SLULoadingParameters.NumberOfDigits = 31;
	SLULoadingParameters.ConsiderZeroSolutions = False;
	SLULoadingParameters.TempTableName = "TableOfSolutionsWithoutVAT";
	
	CostCalculationAppliedAlgorithms.LoadSLUSolutionIntoTemporaryTable(
		CalculationParameters,
		SLULoadingParameters,
		TableOfSolutionsWithoutVAT,
		ExplanationForMeasurement);
	
	#EndRegion
	
	#Region SolutionSLU_ManagementAccountingOfOrganizations
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "CalculateSystemsOfLinearManEquations", ExplanationForMeasurement);
	
	// reset for the next set of descriptions
	SystemOfLinearEquationsCalculation.SystemsDescription.Clear();
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "CostVariancesMgmt";
	SystemDetails.FactorsInRelationsColumn = "ManSWeight";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "AddExpensesMan";
	SystemDetails.FactorsInRelationsColumn = "ManSWeight";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "VATManag";
	SystemDetails.FactorsInRelationsColumn = "ManSWeight";
	
	// Decision
	ManSDecisionTable = SystemOfLinearEquationsCalculation.SolveSystemsOfLinearEquations(Not CalculationParameters.DisableGraphReduction);
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);

	// Loading solutions into a temporary table.
	SolutionColumnNames = "CostVariancesMgmt, AddExpensesMan, VATManag";
	
	SLULoadingParameters = CostCalculationAppliedAlgorithms.InitializeParametersForLoadingSLUSolution(SolutionColumnNames);
	SLULoadingParameters.NumberOfDigits = 31;
	SLULoadingParameters.ConsiderZeroSolutions = False;
	SLULoadingParameters.TempTableName = "ManSDecisionTable";
	
	CostCalculationAppliedAlgorithms.LoadSLUSolutionIntoTemporaryTable(
		CalculationParameters,
		SLULoadingParameters,
		ManSDecisionTable,
		ExplanationForMeasurement);
		
	#EndRegion
	
	#Region SolutionSLU_Local
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "CalculateLocalSystemsOfLinearEquations", ExplanationForMeasurement);
	
	// reset for the next set of descriptions
	SystemOfLinearEquationsCalculation.SystemsDescription.Clear();
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "CostVariancesLocal";
	SystemDetails.FactorsInRelationsColumn = "LocalWeight";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "AddExpensesLocal";
	SystemDetails.FactorsInRelationsColumn = "LocalWeight";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "VATLocal";
	SystemDetails.FactorsInRelationsColumn = "LocalWeight";
	
	// Decision
	LocalDecisionTable = SystemOfLinearEquationsCalculation.SolveSystemsOfLinearEquations(Not CalculationParameters.DisableGraphReduction);
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);

	// Loading solutions into a temporary table.
	SolutionColumnNames = "CostVariancesLocal, AddExpensesLocal, VATLocal";
	
	SLULoadingParameters = CostCalculationAppliedAlgorithms.InitializeParametersForLoadingSLUSolution(SolutionColumnNames);
	SLULoadingParameters.NumberOfDigits = 31;
	SLULoadingParameters.ConsiderZeroSolutions = False;
	SLULoadingParameters.TempTableName = "LocalDecisionTable";
	
	CostCalculationAppliedAlgorithms.LoadSLUSolutionIntoTemporaryTable(
		CalculationParameters,
		SLULoadingParameters,
		LocalDecisionTable,
		ExplanationForMeasurement);
		
	#EndRegion
	
	#Region SolutionSLU_NU
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "CalculateSystemsOfLinearEquationsTA", ExplanationForMeasurement);
	
	// reset for the next set of descriptions
	SystemOfLinearEquationsCalculation.SystemsDescription.Clear();
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "CostInTaxAccounting";
	SystemDetails.FactorsInRelationsColumn = "WeightTA";
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "AIT";
	SystemDetails.FactorsInRelationsColumn = "WeightTA";
	
	// Decision
	TASolutionTable = SystemOfLinearEquationsCalculation.SolveSystemsOfLinearEquations(Not CalculationParameters.DisableGraphReduction);
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);

	// Loading solutions into a temporary table.
	SolutionColumnNames = "CostInTaxAccounting, AIT";
	
	SLULoadingParameters = CostCalculationAppliedAlgorithms.InitializeParametersForLoadingSLUSolution(SolutionColumnNames);
	SLULoadingParameters.NumberOfDigits = 31;
	SLULoadingParameters.ConsiderZeroSolutions = False;
	SLULoadingParameters.TempTableName = "TASolutionTable";
	
	CostCalculationAppliedAlgorithms.LoadSLUSolutionIntoTemporaryTable(
		CalculationParameters,
		SLULoadingParameters,
		TASolutionTable,
		ExplanationForMeasurement);
		
	#EndRegion
	
	#Region Nodes_PermanentDifference
	RequestNodes.Text = "
	|SELECT TOP 0
	|	0 AS NodeNumber,
	|	0 AS PermanentDifference
	|
	|INTO InitialCostConstantDifference
	|
	|UNION ALL
	|
	|SELECT
	|	AdjustmentNodes.NodeNumber AS NodeNumber,
	|
	// The Cost(PD) of expenses that are not accepted for tax accounting.
	|	CAST(SUM(CASE
	|		WHEN ISNULL(NOT AdjustmentNodes.ExpenseItem.EnteredInTaxAccounting, FALSE)
	|			THEN ISNULL(DecisionTable.CostInTaxAccounting, 0)
	|				* ISNULL(WriteOffMovements.NumberOfTA, 0)
	|		ELSE 0 END) AS NUMBER(28,10)) AS PermanentDifference
	|FROM
	|	TTNodesAdjustmentsItemByItemUnfinishedProductionCosts AS AdjustmentNodes
	|	LEFT JOIN DeviationTTCommunication AS WriteOffMovements
	|		ON AdjustmentNodes.NodeNumber = WriteOffMovements.ReceiverNodeNumber
	|	LEFT JOIN TASolutionTable AS DecisionTable
	|		ON DecisionTable.NodeNumber = WriteOffMovements.SourceNodeNumber
	|WHERE
	|	AdjustmentNodes.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	AND NOT WriteOffMovements.ReceiverNodeNumber IS NULL
	|	AND NOT WriteOffMovements.SourceNodeNumber IS NULL
	|
	|GROUP BY
	|	AdjustmentNodes.NodeNumber
	|
	|UNION ALL
	|
	|SELECT
	|	AdjustmentNodes.NodeNumber AS NodeNumber,
	|
	// The Cost(PD) of expenses that are not accepted for tax accounting.
	|	CAST(SUM(CASE
	|		WHEN ISNULL(NOT AdjustmentNodes.ExpenseItem.EnteredInTaxAccounting, FALSE)
	|			THEN ISNULL(DecisionTable.CostInTaxAccounting, 0)
	|				* ISNULL(WriteOffMovements.NumberOfTA, 0)
	|		ELSE 0 END) AS NUMBER(28,10)) AS PermanentDifference
	|FROM
	|	AdditionalCostAdjustmentNodes AS AdjustmentNodes
	|	LEFT JOIN DeviationTTCommunication AS WriteOffMovements
	|		ON AdjustmentNodes.NodeNumber = WriteOffMovements.ReceiverNodeNumber
	|	LEFT JOIN TASolutionTable AS DecisionTable
	|		ON DecisionTable.NodeNumber = WriteOffMovements.SourceNodeNumber
	|WHERE
	|	NOT WriteOffMovements.ReceiverNodeNumber IS NULL
	|	AND NOT WriteOffMovements.SourceNodeNumber IS NULL
	|
	|GROUP BY
	|	AdjustmentNodes.NodeNumber
	|
	|INDEX BY
	|	NodeNumber
	|;
	|SELECT
	|	T.NodeNumber AS NodeNumber,
	|	CAST(ISNULL(T.PermanentDifference, 0)
	|		+ ISNULL(InitialCost_0.PermanentDifference, 0) AS NUMBER(28, 10)) AS PermanentDifference
	|FROM
	|	TTNodesOfDeviations AS T
	|	LEFT JOIN InitialCostConstantDifference AS InitialCost_0
	|		ON InitialCost_0.NodeNumber = T.NodeNumber
	|ORDER BY
	|	NodeNumber
	|";
	#EndRegion
	
	MatrixOfNodes  = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, RequestNodes,,, True, ExplanationForMeasurement + ", " + NStr("vi = 'nút';
																																													|ru = 'узлы';
																																													|en = 'nodes'; fa = 'nodes';
																																													|it = 'nodi';
																																													|pl = 'węzły';
																																													|tr = 'üniteler'", Common.DefaultLanguageCode()));
	SystemOfLinearEquationsCalculation.NodeDataSource = MatrixOfNodes;

	#Region SolutionSLU_ConstantDifference
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "CalculateLocalSystemsOfLinearEquations", ExplanationForMeasurement);
	
	// reset for the next set of descriptions
	SystemOfLinearEquationsCalculation.SystemsDescription.Clear();
	
	SystemDetails = SystemOfLinearEquationsCalculation.SystemsDescription.Add();
	SystemDetails.FactorsInNodesColumn = "PermanentDifference";
	SystemDetails.FactorsInRelationsColumn = "LocalWeight";
	
	// Decision
	TableOfPDSolutions = SystemOfLinearEquationsCalculation.SolveSystemsOfLinearEquations(Not CalculationParameters.DisableGraphReduction);
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);

	// Loading solutions into a temporary table.
	SolutionColumnNames = "PermanentDifference";
	
	SLULoadingParameters = CostCalculationAppliedAlgorithms.InitializeParametersForLoadingSLUSolution(SolutionColumnNames);
	SLULoadingParameters.NumberOfDigits = 31;
	SLULoadingParameters.ConsiderZeroSolutions = False;
	SLULoadingParameters.TempTableName = "TableOfPDSolutions";
	
	CostCalculationAppliedAlgorithms.LoadSLUSolutionIntoTemporaryTable(
		CalculationParameters,
		SLULoadingParameters,
		TableOfPDSolutions,
		ExplanationForMeasurement);
		
	#EndRegion
	
	#EndRegion

	DistributeDeviationsInCostOfGoods_FormationOfRegisteredRecorded(CalculationParameters);
	
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);	
		
EndProcedure

