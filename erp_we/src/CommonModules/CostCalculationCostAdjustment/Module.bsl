#Region UniversalProceduresForWorkingWithRegisteredRecords

// Adds a new row to the table of movements of the specified register and fills in the service fields.
// Made export for calling from the module of universal calculation mechanisms.
//
// Returns:
//	ValueTableRow - added row to the movement table
//
Function AddEntryToMovementTable(CalculationParameters, DestinationTable, MotionData,
			CopiedFields = Undefined, ServiceFields = Undefined) Export
			
	If CalculationParameters.RegisterRecords.Property(DestinationTable) Then
		ReceiverDescription = CalculationParameters.RegisterRecords[DestinationTable];
	Else
		ReceiverDescription = CalculationParameters.AuxiliaryTemporaryTables[DestinationTable];
	EndIf;
	
	// Let's add a record with a universal procedure, and then fill in the fields related only to the cost calculation
	Record = CostCalculationAppliedAlgorithms.AddEntryToMovementTable(
		CalculationParameters,
		ReceiverDescription,
		MotionData,
		CopiedFields);
	
	// Fill in the Registrar field from the mandatory property of the document movement of the data source.
	Record.Recorder = MotionData.DocumentRegisterRecords;
	
	// Fill in the empty registrar with the appropriate cost calculation document
	If ReceiverDescription.ThisIsRegisterDescription
	 And CalculationParameters.Debug.FixEmptyLogger And Not ValueIsFilled(Record.Recorder) Then
		
		CalculationDocumentsForOrganizations  = CalculationParameters.CalculationDocumentsForOrganizations; // Map
		PartnerAnalyticsOrganization = CalculationParameters.PartnerAnalyticsOrganization; // Map

		If ReceiverDescription.ThereIsACompany Then
			Record.Recorder = CalculationDocumentsForOrganizations.Get(MotionData.Organization);
		ElsIf ReceiverDescription.ThereAreAnalyticsPartners Then
			Record.Recorder = CalculationDocumentsForOrganizations.Get(
				PartnerAnalyticsOrganization.Get(MotionData.AccountingDimensionByPartners));
		EndIf;
		
		If ValueIsFilled(Record.Recorder) Then
			ErrorText = NStr("vi = 'Đã thiết lập chứng từ %1 bằng nguồn ghi của bản ghi kết chuyển của biểu ghi %2 thay vì %3,
				| mà nó không thể có bản ghi kết chuyển theo biểu ghi này.';
				|ru = 'Документ %1 установлен регистратором движения регистра %2 вместо %3,
				|который не может иметь движений по данному регистру.';
				|en = 'Document %1 is assigned as recorder for register %2 instead of %3
				|which cannot have records in this register.'; fa = 'Document %1 is assigned as recorder for register %2 instead of %3
				|which cannot have records in this register.';
				|it = 'Il documento %1 è stato impostato registratore dei movimenti del registro %2 al posto di %3
				| che non può avere movimenti sul dato registro.';
				|pl = 'Dokument %1 jest ustalony rejestratorem ruchu rejestru %2 zamiast %3.
				|który nie może mieć ruchów w tym rejestrze.';
				|tr = '%1 belgesi, bu kayıt üzerinde hareketleri olamayan %3 
				| yerine %2 kaydının hareket kaydı tarafından ayarlanır.'", Common.DefaultLanguageCode());
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText,
				Record.Recorder,
				DestinationTable,
				MotionData.DocumentRegisterRecords);
			WriteLogEvent(
				CostCalculationAppliedAlgorithms.NameOfErrorEventForLog(CalculationParameters),
				EventLogLevel.Warning,
				,
				,
				ErrorText);
		EndIf;
		
	EndIf;
	
	// If the registrar is not filled in, then we will remember the error information
	If ReceiverDescription.ThisIsRegisterDescription And Not ValueIsFilled(Record.Recorder) Then
		
		If Not ValueIsFilled(MotionData.DocumentRegisterRecords) Then
			// Error in requests - the required field of the document movement is not filled in.
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Chưa điền thuộc tính %1 đối với bản ghi kết chuyển theo biểu ghi ""%2""';
					|ru = 'Не заполнено свойство %1 для движения по регистру ""%2""';
					|en = '%1 property for ""%2"" register record is not filled in'; fa = '%1 property for ""%2"" register record is not filled in';
					|it = 'Non è impostata la proprietà %1 per il movimento sul registro ""%2""';
					|pl = 'Nie wypełniono właściwość %1 dla ruchu po rejestrze ""%2""';
					|tr = '""%2"" kaydı üzerindeki hareket için %1 özelliği doldurulmadı'", Common.DefaultLanguageCode()),
				"DocumentRegisterRecords",
				DestinationTable);
		Else
			// Error in metadata - the document is not a registrar for this register.
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Chứng từ ""%1"" không thể có bản ghi kết chuyển theo biểu ghi ""%2""';
					|ru = 'Документ ""%1"" не может иметь движений по регистру ""%2""';
					|en = 'The ""%1"" document cannot have records in the ""%2"" register'; fa = 'The ""%1"" document cannot have records in the ""%2"" register';
					|it = 'Il documento ""%1"" non può avere movimenti per il registro ""%2""';
					|pl = 'Dokument ""%1"" nie może mieć ruchów w rejestrze ""%2""';
					|tr = '""%1"" belgesinin ""%2"" kaydı üzerinde hareketleri olamaz'", Common.DefaultLanguageCode()),
				TrimAll(MotionData.DocumentRegisterRecords),
				DestinationTable);
		EndIf;
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenGeneratingRecordsInRegisters,
			ProtocolText_);
		
		If ReceiverDescription.ThereIsACompany Then
			OrganizationWithProblem = MotionData.Organization;
		ElsIf ReceiverDescription.ThereAreAnalyticsPartners Then
			PartnerAnalyticsOrganization = CalculationParameters.PartnerAnalyticsOrganization; // Map
			OrganizationWithProblem = PartnerAnalyticsOrganization.Get(MotionData.AccountingDimensionByPartners);
		Else
			OrganizationWithProblem = Undefined;
		EndIf;
			
		CostCalculationAppliedAlgorithms.RegisterCalculationExecutionProblem(
			CalculationParameters,
			OrganizationWithProblem,
			NStr("vi = 'Khi tạo các bản ghi kết chuyển, đã chuẩn đoán được lỗi';
				|ru = 'При формировании движений диагностированы ошибки';
				|en = 'Errors were found when generating the movements'; fa = 'Errors were found when generating the movements';
				|it = 'Durante la creazione dei movimenti sono stati diagnosticati degli errori';
				|pl = 'Podczas tworzenia ruchów zdiagnozowano błędy';
				|tr = 'Hareketlerin oluşumunda hatalar tespit edilmiştir'", Common.DefaultLanguageCode()),
			ProtocolText_,
			MotionData.DocumentRegisterRecords);
		
		For Each KeyAndValue In CalculationParameters.CalculationDocumentsForOrganizations Do
			// Fill in the registrar with an arbitrary "first" cost calculation document - so that the movements can be recorded.
			// The calculation will still eventually be completed with an error, but so you can get information about all the erroneous registrars.
			Record.Recorder = KeyAndValue.Key;
			Break;
		EndDo;

	EndIf;
	
	Return Record;
	
EndFunction

Procedure AddDescriptionOfFieldsForGeneratingRegisteredRecords(CalculationParameters, FieldDescriptionTable, ReceiverDescription, CopiedFields) Export
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, ReceiverDescription.RegisterName);
	
EndProcedure

