	|	Preliminary.LineOfBusiness AS LineOfBusiness,
	|	Preliminary.CorLineOfBusiness AS CorLineOfBusiness,
	|	Preliminary.DimensionOfExpenses AS DimensionOfExpenses,
	|	Preliminary.ExpenseItem AS ExpenseItem,
