	|		AND CorAITExpenseRecognitionSettings.Organization = AdjustmentTable.Organization
	|		AND CorAITExpenseRecognitionSettings.ExpensesAreIncludedInCost
	|
	|WHERE
	|	NOT AdjustmentTable.StornoReportOnCommission
	|
	|INDEX BY
	|	BusinessOperation
	|;";
	
