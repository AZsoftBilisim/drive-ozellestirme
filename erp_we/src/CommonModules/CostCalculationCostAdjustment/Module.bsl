// Supplements query properties with data specific to cost adjustments.
//
// Parameters:
//	Query - Query - Request to set parameters for
//	CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//
Procedure AddRequestProperties(Query, CalculationParameters) Export
	
	// The parameter "Average month" is used in the previous version of the calculation of the SLA in the functions of forming adjustment nodes. 
	EvaluationMethod = Undefined;
	CalculationParameters.Property("EvaluationMethod", EvaluationMethod);
	Query.SetParameter("AveragePerMonth", EvaluationMethod = Enums.InventoryValuationMethods.AveragePerMonth);
	
	// Parameters related only to cost calculation.
	Query.SetParameter("ErrorValueCostLocal", CalculationParameters.LESSolutionErrors.ErrorValueCostLocal);
	Query.SetParameter("ErrorValueCostOfMan", CalculationParameters.LESSolutionErrors.ErrorValueCostOfMan);
	Query.SetParameter("ValueOfErrorCostsRegl", CalculationParameters.LESSolutionErrors.ValueOfErrorCostsRegl);
	Query.SetParameter("ErrorValueManCosts", CalculationParameters.LESSolutionErrors.ErrorValueManCosts);
	Query.SetParameter("ErrorValueQuantity", CalculationParameters.LESSolutionErrors.ErrorValueQuantity);
	
	Query.SetParameter("FieldOverflowProtection", Pow(10, CalculationParameters.SolutionOfSLU.FieldOverflowProtection) - 1);
	
	// Selections for economic operations.
	Query.SetParameter("ArrayOfImplementationOperations", ArrayOfImplementationOperations());
	Query.SetParameter("ArrayOfOperationsRefundsForPastPeriods", ArrayOfOperationsRefundsForPastPeriods());
	Query.SetParameter("ArrayOfTransferOperations", ArrayOfProductTransferOperations());
	Query.SetParameter("ArrayOfReceiptOperations", ArrayOfExternalReceiptOperations());
	Query.SetParameter("ArrayOfOperationsExternalReceipt", ArrayOfOperationsForEstimatingBalanceOfGoodsByFIFO());
	Query.SetParameter("TypesOfExpensesNormalized", Enums.ExpenseKindsTA.RationingExpenses());
	// Determines what type of difference should be formed according to the cost calculation error item
	CostCalculationError = ChartsOfCharacteristicTypes.ExpenseItems.CostCalculationError;
	ErrorIsTakenInternally = True;
	ErrorIsTakenInternally = Common.ObjectAttributeValue(CostCalculationError, "EnteredInTaxAccounting");
	Query.SetParameter("ErrorIsTakenInternally", ErrorIsTakenInternally);
	
EndProcedure

