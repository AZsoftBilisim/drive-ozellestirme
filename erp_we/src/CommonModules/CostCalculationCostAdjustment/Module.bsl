		|	Releases.FinRecordID AS FinRecordID,
		|	&BeginOfPeriod AS DistributionPeriod,
		|	T.VariancePeriod AS DeviationPeriodSource,
		|	T.VariancePeriod AS ReceiverDeviationPeriod,
		|	FALSE AS ReversingEntry,
		|	FALSE AS WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	0 AS Count,
		|	CAST(T.ArcWeightWithVAT * SourceNodes.CostVariancesIncludingVAT AS NUMBER(31,2)) AS CostVariancesIncludingVAT,
		|	CAST(T.ArcWeightWithoutVAT * SourceNodes.CostVariancesExcludingVAT AS NUMBER(31,2)) AS CostVariancesExcludingVAT,
		|	CAST(T.ArcWeightLocal * SourceNodes.CostVariancesLocal AS NUMBER(31,2)) AS CostVariancesLocal,
		|	CAST(T.ArcWeightMan * SourceNodes.CostVariancesMgmt AS NUMBER(31,2)) AS CostVariancesMgmt,
		|	CAST(T.ArcWeightLocal * SourceNodes.VATLocal AS NUMBER(31,2)) AS VATLocal,
		|	CAST(T.ArcWeightMan * SourceNodes.VATManag AS NUMBER(31,2)) AS VATManag,
		|	CAST(T.ArcWeightWithVAT * SourceNodes.AdditionalExpensesIncludingVAT AS NUMBER(31,2)) AS AdditionalExpensesIncludingVAT,
		|	CAST(T.ArcWeightWithoutVAT * SourceNodes.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
		|	CAST(T.ArcWeightLocal * SourceNodes.AddExpensesLocal AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.ArcWeightMan * SourceNodes.AddExpensesMan AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.ArcWeightLocal * SourceNodes.PermanentDifference AS NUMBER(31,2)) AS PermanentDifference,
		|	CAST(T.WeightOfArcISTA * SourceNodes.CostTD AS NUMBER(31,2)) AS CostTD,
		|	CAST(T.WeightOfArcISTA * SourceNodes.AIT AS NUMBER(31,2)) AS AIT
		|FROM
		|	TTCommunicationsDistributionOfArticleByArticleForIssue AS T
		|	INNER JOIN TableOfSolutionsInDetail AS SourceNodes
		|		ON SourceNodes.NodeNumber = T.SourceNodeNumber
		|
		|	INNER JOIN TTNodesOfDeviations AS ReceiverNodes_
		|		ON ReceiverNodes_.Organization = T.CorCompany
		|		AND ReceiverNodes_.Products = T.CorNomenclature
		|		AND ReceiverNodes_.Characteristic = T.CorCharacteristics
		|		AND ReceiverNodes_.InventoryOwnerAttribute = T.CorInventoryOwnerAttribute
		|		AND ReceiverNodes_.LineOfBusiness = T.CorLineOfBusiness	
		|		AND ReceiverNodes_.Department = T.DebitBusinessUnit
		|		AND ReceiverNodes_.StorageLocation = T.BoxStorageLocation
		|		AND ReceiverNodes_.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
		|		AND ReceiverNodes_.DistributionPeriod = &BeginOfPeriod
		|
		|	INNER JOIN TTIssues AS Releases
		|		ON Releases.Organization = T.CorCompany
		|		AND Releases.Products = T.CorNomenclature
		|		AND Releases.Characteristic = T.CorCharacteristics
		|		AND Releases.InventoryOwnerAttribute = T.CorInventoryOwnerAttribute
		|		AND Releases.LineOfBusiness = T.CorLineOfBusiness	
		|		AND Releases.Department = T.DebitBusinessUnit
		|		AND Releases.StorageLocation = T.BoxStorageLocation
		|";
EndFunction
Function TextOfStornoRegisteredRecordsForCorrectionsOfPreviousPeriodIsMediumSliding()
	Return "
		// The formation of storno Registered Records for corrections of the previous period.
		|SELECT
		|	""TextOfStornoRegisteredRecordsForCorrectionsOfPreviousPeriodIsMediumSliding"" AS RequestSource,
		|	FALSE AS TheseAreLeftovers,
		|	TRUE AS ThisIsCurrentPeriod,
		|	T.ThereIsCorPart,
		|	-1 AS SourceNodeNumber,
		|	(CASE WHEN T.ThereIsCorPart THEN 0 ELSE -1 END) AS ReceiverNodeNumber,
		|	T.Recorder,
		|	T.Period,
		// Measurement of deviations
		|	T.Organization,
		|	T.Products,
		|	T.Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		// Cost measurements
		|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ItemsLocationAttributes,
		|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS AccountingSection,
		|	UNDEFINED AS Lot,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributes,
		|	UNDEFINED AS FinancialAccountingDimension,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATActivityType,
		// Cor Attributes of deviations
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
		// COR Cost Attributes
		|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS CorItemsLocationAttributes,
		|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS CorAccountingSection,
		|	UNDEFINED AS CorLot,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributesCorr,
		|	UNDEFINED AS CorControllingAttributes,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS CorVATActivityTypes,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	UNDEFINED AS ProductCostElement,
		|	UNDEFINED AS RuleOfCostAllocatingToProductionLots,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
		|	UNDEFINED AS CorExpenditureDimension,
		|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
		|
		|	T.GLAccountSettings AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		// The field Setting up the business operation should be filled in the same way as the request with the requester = ""1"".
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		 OR T.AssetAndLiabilityItem <> UNDEFINED
		|		 AND T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposesVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
		|		 AND T.WriteOffDeviationsToCostOfGoodsSelling
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferOfProductsFromProductionVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.ProductReleaseVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.IntercompanyConsumptionReportSubcontractingServicesDeliveredVariances)
		|		WHEN NOT T.ThereIsCorPart
		|		 AND T.ExpenseItemOfWriteOff <> UNDEFINED
		|		 AND T.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.WriteOffAsExpensesVariances)
		|		ELSE T.BusinessTransactionSetting END) AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	&BeginOfPeriod AS DistributionPeriod,
		|	T.VariancePeriod AS DeviationPeriodSource,
		|	T.VariancePeriod AS ReceiverDeviationPeriod,
		|	T.ReversingEntry AS ReversingEntry,
		|	FALSE AS WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	T.Character * T.Count AS Count,
		|	T.Character * T.CostVariancesIncludingVAT AS CostVariancesIncludingVAT,
		|	T.Character * T.CostVariancesExcludingVAT AS CostVariancesExcludingVAT,
		|	T.Character * T.CostVariancesLocal AS CostVariancesLocal,
		|	T.Character * T.CostVariancesMgmt AS CostVariancesMgmt,
		|	T.Character * T.VATLocal AS VATLocal,
		|	T.Character * T.VATManag AS VATManag,
		|	T.Character * T.AdditionalExpensesIncludingVAT AS AdditionalExpensesIncludingVAT,
		|	T.Character * T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
		|	T.Character * T.AddExpensesLocal AS AddExpensesLocal,
		|	T.Character * T.AddExpensesMan AS AddExpensesMan,
		|	T.Character * T.PermanentDifference AS PermanentDifference,
		|	T.Character * T.CostTD AS CostTD,
		|	T.Character * T.AIT AS AIT
		|FROM
		|	TTIsStornoOfDeviationsOfPreviousPeriod AS T
		|";
EndFunction
	
