	|	Preliminary.AcceptedVNU AS AcceptedVNU,
	|	Preliminary.ManufacturedProduct AS ManufacturedProduct,
	|	Preliminary.ItemVariant AS ItemVariant,
	|	Preliminary.ProductsGroup AS ProductsGroup,
	|	Preliminary.VATActivityType AS VATActivityType,
	|	Preliminary.CostAccountingSection AS CostAccountingSection,
