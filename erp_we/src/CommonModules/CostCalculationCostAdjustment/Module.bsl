	|			AND RegisterRecords.LineOfBusiness = IDs.LineOfBusiness
	|			AND RegisterRecords.BusinessOperation = IDs.BusinessOperation
	|INDEX BY
	|	RecNo
	|;
	|";
	
	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

