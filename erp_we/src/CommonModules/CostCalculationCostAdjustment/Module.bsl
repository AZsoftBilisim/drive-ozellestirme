		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany))
		|		THEN 0
		| 	WHEN NOT ThisIsTransferBetweenOrganizations AND WriteOffReserves
		|		THEN ProvisionForImpairmentLocal
		|	ELSE 0
		|	END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OffBalanceCostLocal", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "0"); 
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD",
		"CASE
		|	WHEN CostDefiningMethod = VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage)
		|		THEN 0
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany))
		|		THEN 0
		|	WHEN NOT ThisIsTransferBetweenOrganizations AND WriteOffReserves THEN ProvisionForImpairmentLocal
		|		ELSE 0
		|	END");
		
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostOfPersonalIncomeTax","0"); 
		
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AddExpensesLocal", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LaborCostsLocal", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedFixedCostsCompl", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedVariableCostsCompl", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentLocal", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostMan",
		"CASE
		|	WHEN CostDefiningMethod = VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage)
		|		THEN 0
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany))
		|		THEN 0
		|	WHEN NOT ThisIsTransferBetweenOrganizations AND WriteOffReserves
		|		THEN ProvisionForImpairmentMan
		|	ELSE 0
		|	END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AddExpensesMan", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LaborCostsMan", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedFixedCostsManag", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedVariableCostsManag", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentMan", "0");
	
	ConditionWHERE = ConditionWHERE + "
		|	AND (CASE
		|		WHEN NOT ThisIsTransferBetweenOrganizations 
		|		 AND WriteOffReserves 
		|		 AND ProvisionForImpairmentLocal <> 0 OR ProvisionForImpairmentMan <> 0 THEN TRUE
		|		ELSE FALSE END)
		|";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", NameOfTemporaryReservesTable, ConditionWHERE);
		
	MatchingTemporaryMovementTables.Insert(NameOfTemporaryReservesTable, RegisterName);
	
EndProcedure

Procedure GenerateTotalCostOfGoodsReverseInManAccountingRequest(CalculationParameters, MatchingTemporaryMovementTables)

	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	TempTableName = "TTCostOfGoodsReverseMan";
	
	CopiedFields = "
	|Period, Organization, AccountingSection,
	|BusinessOperation, DocumentRegisterRecords, Recorder, DocumentCalculation,
	|Department, DimensionOfExpenses, ExpenseItemOfWriteOff,
	|BusinessTransactionSetting, FinRecordID, GLAccountSettings,
	|Cost, CostExcludingVAT, AddExpensesForGoods, AdditionalExpensesExcludingVAT,
	|ProductCostElement, EntryType, DocumentSource, ReversingEntry,
	|LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT,
	|ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT";
	
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "CorCompany");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemsLocationAttributes", "CorItemsLocationAttributes");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "InventoryOwnerAttribute", "CorInventoryOwnerAttribute");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LocalCost", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostMan", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AccountingSection", "
	|CASE
	|	WHEN AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "AccountingSection") + "
	|END
	|");
	
	If CalculationParameters.BatchAccountingVersion22 Then
	
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Lot", "CorLot");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotVendorAttributes", "LotVendorAttributesCorr");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "FinancialAccountingDimension", "CorControllingAttributes");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "VATActivityType", "CorVATActivityTypes");
	
	Else // Lotaccounting is disabled or lot accounting is used 2.1.
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Lot", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotVendorAttributes",
			"VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "FinancialAccountingDimension",
			"UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "VATActivityType",
			 "VALUE(Enum.VATTaxationTypes.EmptyRef)");
		
	EndIf;
	
	ConditionWHERE = "
	|	BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomerLocalAccounting)
	|	OR BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorLocal)
	|";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE);
		
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateRegisteredRecordsOfDeviationsInCostOfGoodsByRequest(CalculationParameters, Query, TempTableName, MatchingTemporaryMovementTables)
	
	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	T.Organization,
	|	T.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.CorItemsLocationAttributes.Products AS Products,
	|	T.CorItemsLocationAttributes.Characteristic AS Characteristic,
	|	CASE WHEN FinAccounting.ItemizeVariancesByLinesOfBusiness
	|		THEN T.CorItemsLocationAttributes.Purpose.LineOfBusiness
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE WHEN FinAccounting.ItemizeVariancesByWarehousesStorageLocations
	|		THEN T.CorItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation,
	|	CASE
	|		WHEN NOT FinAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.CorItemsLocationAttributes.StorageLocation
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|			ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	&BeginOfPeriod AS VariancePeriod,
	|	&MonthEndClosingMode AS MonthEndClosingMode,
	|	T.ReversingEntry,
	|
	|	SUM(T.AmountIncludingVAT) 			AS CostVariancesIncludingVAT,
	|	SUM(T.AmountExcludingVAT) 		AS CostVariancesExcludingVAT,
	|	SUM(T.SumCompl)			AS CostVariancesLocal,
	|	SUM(T.SumMan)			AS CostVariancesMgmt,
	|	SUM(T.PermanentDifference)	AS PermanentDifference,
	|	SUM(T.CostTD)	AS CostTD,
	|	SUM(T.CostOfPersonalIncomeTax) 		AS AIT
	|INTO TTDeviationsInCostOfGoods
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS FinAccounting
	|		ON T.Organization = FinAccounting.Organization
	|WHERE
	|	T.Organization IN(&MediumSlipOrganizations)
	|	AND T.RecordType = VALUE(AccumulationRecordType.Expense)
	|	AND T.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
	|	AND T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
	|
	|GROUP BY
	|	T.Period,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.CorInventoryOwnerAttribute,
	|	T.CorItemsLocationAttributes.Products,
	|	T.CorItemsLocationAttributes.CHARACTERISTIC,
	|	CASE WHEN FinAccounting.ItemizeVariancesByLinesOfBusiness
	|		THEN T.CorItemsLocationAttributes.Purpose.LineOfBusiness
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END,
	|	CASE WHEN FinAccounting.ItemizeVariancesByWarehousesStorageLocations
	|		THEN T.CorItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END,
	|	CASE
	|		WHEN NOT FinAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.CorItemsLocationAttributes.StorageLocation
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|			ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END,
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.ReversingEntry
	|HAVING
	|	SUM(T.AmountIncludingVAT) <> 0
	|	OR SUM(T.AmountExcludingVAT) <> 0
	|	OR SUM(T.SumCompl) <> 0
	|	OR SUM(T.SumMan) <> 0
	|	OR SUM(T.PermanentDifference) <> 0
	|	OR SUM(T.CostTD) <> 0
	|	OR SUM(T.SumCompl) <> 0
	|	OR SUM(T.CostOfPersonalIncomeTax) <> 0
	|
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	T.Organization,
	|	T.CorInventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.CorItemsLocationAttributes.Products AS Products,
	|	T.CorItemsLocationAttributes.Characteristic AS Characteristic,
	|	CASE WHEN FinAccounting.ItemizeVariancesByLinesOfBusiness
	|		THEN T.CorItemsLocationAttributes.Purpose.LineOfBusiness
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE WHEN FinAccounting.ItemizeVariancesByWarehousesStorageLocations
	|		THEN T.CorItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation,
	|	CASE
	|		WHEN NOT FinAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.CorItemsLocationAttributes.StorageLocation
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|			ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	T.BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffOfInventoryImpairmentProvision) AS BusinessTransactionSetting,
	|	T.FinRecordID,
	|	&BeginOfPeriod AS VariancePeriod,
	|	&MonthEndClosingMode AS MonthEndClosingMode,
	|	T.ReversingEntry,
	|
	|	0 AS CostVariancesIncludingVAT,
	|	0 AS CostVariancesExcludingVAT,
	|	SUM(T.ProvisionForImpairmentLocal) AS CostVariancesLocal,
	|	SUM(T.ProvisionForImpairmentMan)  AS CostVariancesMgmt,
	|	0	AS PermanentDifference,
	|	SUM(T.ProvisionForImpairmentLocal) AS CostTD,
	|	0 AS AIT
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS FinAccounting
	|		ON T.Organization = FinAccounting.Organization
	|WHERE
	|	T.Organization IN(&MediumSlipOrganizations)
	|	AND T.RecordType = VALUE(AccumulationRecordType.Expense)
	|	AND NOT T.ThisIsTransferBetweenOrganizations
	|	AND T.WriteOffReserves
	|	AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
	|
	|GROUP BY
	|	T.Period,
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.CorInventoryOwnerAttribute,
	|	T.CorItemsLocationAttributes.Products,
	|	T.CorItemsLocationAttributes.CHARACTERISTIC,
	|	CASE WHEN FinAccounting.ItemizeVariancesByLinesOfBusiness
	|		THEN T.CorItemsLocationAttributes.Purpose.LineOfBusiness
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END,
	|	CASE WHEN FinAccounting.ItemizeVariancesByWarehousesStorageLocations
	|		THEN T.CorItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END,
	|	CASE
	|		WHEN NOT FinAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.CorItemsLocationAttributes.StorageLocation
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.CorItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|			ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END,
	|	T.BusinessOperation,
	|	T.FinRecordID,
	|	T.ReversingEntry
	|HAVING
	|	SUM(T.ProvisionForImpairmentLocal) <> 0
	|	OR SUM(T.ProvisionForImpairmentMan) <> 0
	|";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTDeviationsInCostOfGoods");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTDeviationsInCostOfGoods", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateRegisteredRecordsProductsIncomeExpensesQuery(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE,
			ThisIsIncome = False, BusinessOperation = Undefined, AmountAdjustmentStructure = Undefined)

	RegisterName = Metadata.AccumulationRegisters.RegisterRecordsProductsIncomeExpenses.Name;
	
	CopiedFields =
	"Period, BusinessOperation, Organization, Department,
	|ItemsLocationAttributes,Warehouse,InventoryType,InventoryOwnerAttribute,
	|SourceOfProductFinancialAccountingGroup, DocumentRegisterRecords, ReversingEntry";
	
	SumFields_ = "
	|Cost, CostExcludingVAT, AddExpensesForGoods, AdditionalExpensesExcludingVAT, LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT, ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, 
	|LocalCost, AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl, ItemizedVariableCostsCompl,
	|CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag,
	|OffBalanceCost, OffBalanceCostLocal,
	|PermanentDifference, CostTD,
	|VATLocal, VATManag, 
	|ProvisionForImpairmentLocal, ProvisionForImpairmentMan
	|";
	
	CopiedFields = CopiedFields + ", " + SumFields_;

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	WarehouseColumn = CostCalculationAppliedAlgorithms.TemporaryTableColumns(CalculationParameters, "RegisteredRecordsAdjustmentTable", False).Find("Warehouse");
	If Not WarehouseColumn = Undefined
		And WarehouseColumn.ValueType.ContainsType(Type("CatalogRef.CounterpartyContracts")) Then
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(
			FieldDescriptionTable,
			"Warehouse",
			"CASE
			|	WHEN VALUETYPE(Warehouse) = TYPE(Catalog.CounterpartyContracts)
			|		THEN CAST(Warehouse AS Catalog.CounterpartyContracts).Partner
			|	ELSE Warehouse
			|END");
		
	EndIf;
	
	If BusinessOperation <> Undefined Then
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation", "&BusinessOperation");
	EndIf;
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentLocal",
	"CASE
	|	WHEN WriteOffReserves THEN ProvisionForImpairmentLocal
	|	ELSE 0
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentMan",
	"CASE
	|	WHEN WriteOffReserves THEN ProvisionForImpairmentMan
	|	ELSE 0
	|END");
	
	If ThisIsIncome Then
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "IncomeAndExpenseItem",
			"CASE WHEN (AssetAndLiabilityItem IS NULL OR AssetAndLiabilityItem = UNDEFINED OR AssetAndLiabilityItem = VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
		    |	THEN IncomeItem
		    |	ELSE AssetAndLiabilityItem
		    |END");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DimensionOfRevenue", "DimensionOfRevenue");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProductLineOfBusiness", "LineOfBusiness");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LineOfBusinessItems", "CorLineOfBusiness");
		
	Else
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "IncomeAndExpenseItem",
			"CASE WHEN (AssetAndLiabilityItem IS NULL OR AssetAndLiabilityItem = UNDEFINED OR AssetAndLiabilityItem = VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
		    |	THEN ExpenseItemOfWriteOff
		    |	ELSE AssetAndLiabilityItem
		    |END");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DimensionOfExpenses", "DimensionOfExpenses");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LineOfBusinessItems", "CorLineOfBusiness");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProductLineOfBusiness", "
		|CASE
		|	WHEN " + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "BusinessOperation") 
					+ " = VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand) AND CorInventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
		|		CorLineOfBusiness
		|	ELSE
		|		LineOfBusiness
		|	END");
		
	EndIf;
	
	If AmountAdjustmentStructure <> Undefined Then
		
		FieldArray = StrSplit(SumFields_, ",");
		For Each Field In FieldArray Do
			
			MField = StrReplace(StrReplace(TrimAll(Field), Chars.LF, ""), Chars.Tab, "");
			NewField = AdjustSumFieldForProductMovementWithRequest(MField, AmountAdjustmentStructure);
			
			CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, MField, NewField);
			
		EndDo;
		
	EndIf;
	
	ParametersStructure = New Structure("BusinessOperation", BusinessOperation);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE, ParametersStructure);
			
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateProductsProductsMovementWithRequest(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE, TextBusinessTransaction)
	
	RegisterName = Metadata.AccumulationRegisters.RecordsProductsProducts.Name;
	
	CopiedFields =
	"Period, BusinessOperation, Organization,
	|ItemsLocationAttributes,Warehouse,InventoryType,InventoryOwnerAttribute,
	|CorItemsLocationAttributes,CorWarehouseCorCommissionAgentCorBusinessUnit,CorInventoryType,CorInventoryOwnerAttribute,
	|SourceOfProductFinancialAccountingGroup, CorSourceOfItemsFinancialAccountingGroup, DocumentRegisterRecords, CorCompany, ReversingEntry";

	SumFields_ = "
	|Cost, CostExcludingVAT, AddExpensesForGoods, AdditionalExpensesExcludingVAT, LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT, ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, 
	|LocalCost, AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl, ItemizedVariableCostsCompl,
	|CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag,
	|OffBalanceCost, OffBalanceCostLocal,
	|PermanentDifference, CostTD,
	|VATLocal, VATManag, 
	|ProvisionForImpairmentLocal, ProvisionForImpairmentMan
	|";
	
	CopiedFields = CopiedFields + ", " + SumFields_;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Department", "
	|CASE
	|	WHEN DocumentSubdivision <> VALUE(Catalog.BusinessStructure.EmptyRef)
	|		THEN DocumentSubdivision
	|	ELSE Department
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LineOfBusiness", "
	|CASE
	|	WHEN FALSE THEN UNDEFINED // for easy tag placement
	|	WHEN VALUETYPE(Lot) = TYPE(Catalog.ProductionLots)
	|		THEN CAST(Lot AS Catalog.ProductionLots).LineOfBusiness
	|	ELSE ItemsLocationAttributes.Purpose.LineOfBusiness END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorLineOfBusiness", "
	|CorItemsLocationAttributes.Purpose.LineOfBusiness");
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation", TextBusinessTransaction);
		
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "
	|CASE
	|	WHEN " + TextBusinessTransaction + " IN (VALUE(Enum.BusinessTransactions.InternalGoodsReceipt), VALUE(Enum.BusinessTransactions.InternalWorkReceipt)) THEN
	|		CorCompany
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "Organization") + "
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorCompany", "
	|CASE
	|	WHEN " + TextBusinessTransaction + " IN (VALUE(Enum.BusinessTransactions.InternalGoodsReceipt), 
	|												VALUE(Enum.BusinessTransactions.InternalWorkReceipt)) THEN
	|		Organization
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "CorCompany") + "
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "
	|CASE
	|	WHEN Warehouse REFS Catalog.Partners THEN
	|		Count
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "Count") + "
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorLineOfBusiness", "
	|CASE
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent) THEN
	|		LineOfBusiness
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "CorLineOfBusiness") + "
	|END");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE);
		
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateRegisteredRecordsForTurnoverRegistersOfAccountingManWithRequest(CalculationParameters, MatchingTemporaryMovementTables)
	
	TextIsNonZeroTotalSum = "
	|	CASE 
	|		WHEN AmountIncludingVAT <> 0 OR AmountExcludingVAT  <> 0 OR SumCompl  <> 0 OR SumMan <> 0
	|		 OR ProvisionForImpairmentLocal <> 0 OR ProvisionForImpairmentMan <> 0
	|			THEN TRUE
	|		ELSE
	|			FALSE
	|	END
	|";
	
	QueryCondition = TextIsNonZeroTotalSum + "
	|	AND BusinessOperation IN (
	|		VALUE(Enum.BusinessTransactions.GoodsConsumption),
	|		VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand),
	|		VALUE(Enum.BusinessTransactions.InventoryConsumptionReverseTransaction),
	|		VALUE(Enum.BusinessTransactions.TransferToFixedAssets),
	|		VALUE(Enum.BusinessTransactions.TransferToIntangibleAssetsAndRD),
	|		VALUE(Enum.BusinessTransactions.GoodsWriteOffAtToller),
	|		VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAtTheExpenseOfProvider),
	|		VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAsExpenses),
	|		VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
	|		VALUE(Enum.BusinessTransactions.TransferForOtherPurposes),
	|		VALUE(Enum.BusinessTransactions.TransferToOperation),
	|		VALUE(Enum.BusinessTransactions.CommissioningACAndTA),
	|		VALUE(Enum.BusinessTransactions.WriteOffReportFromCommissionAgent),
	|		VALUE(Enum.BusinessTransactions.MonthEndTransactions),
	|		VALUE(Enum.BusinessTransactions.WriteOffShortagesAtDepositorSExpense),
	|		VALUE(Enum.BusinessTransactions.WriteOffShortagesAtConsignorSExpense),
	|		VALUE(Enum.BusinessTransactions.RecognizeInventorySurplusForTheBenefitOfConsignor),
	|		VALUE(Enum.BusinessTransactions.RecognizeInventorySurplusForTheBenefitOfDepositor)
	|	)";

	GenerateRegisteredRecordsProductsIncomeExpensesQuery(CalculationParameters, "TTIncomeExpensesWriteOffOfGoods", MatchingTemporaryMovementTables, QueryCondition);
			
	QueryCondition = TextIsNonZeroTotalSum + "
	|	AND (
	|		(
	|			(
	|				BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices)
	|				OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices)
	|				OR BusinessOperation = VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices)
	|			)
	|			AND RecordType = VALUE(AccumulationRecordType.Expense)
	|		)
	|		
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnFromProduction)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfMaterialsFromProduction)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfMaterialsFromStoreroom)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnFromProcessingCompany2_5)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.IntercompanyCommissionReturn)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
	|		OR (BusinessOperation = VALUE(Enum.BusinessTransactions.ReceiptFromToller2_5)
	|			AND RecordType = VALUE(AccumulationRecordType.Expense))
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromStoreroom)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsAssignmentAdjustments)
	|		OR ((BusinessOperation = VALUE(Enum.BusinessTransactions.InventoryTransfer) OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProducts) OR BusinessOperation = VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBusinessUnits)) AND RecordType = VALUE(AccumulationRecordType.Expense))
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToProduction)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.MaterialTransferToProduction)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfMaterialsToStoreroom)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfGoodsToCommissionAgentInAnotherCompany)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToToller2_5)
	|		OR (BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsMisgrading) AND RecordType = VALUE(AccumulationRecordType.Expense))
	|		OR (BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsDamage) AND RecordType = VALUE(AccumulationRecordType.Expense))
	|		OR (BusinessOperation = VALUE(Enum.BusinessTransactions.SaleWithDeferredTransferOfTitle) AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit))
	|		OR (BusinessOperation = VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit)
	|			AND NOT AccountingSection IN (
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitReceivedByCommissionAgent),
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitTransferredToCommissionAgent)))
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.AssemblyFromComponents)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.DisassemblyIntoComponents)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnFromCustodian)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.ExpensingToProductionLots)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.RedemptionOfProviderGoods)
	|	)
	|
	|	AND NOT ((CorItemsLocationAttributes IS NULL OR CorItemsLocationAttributes = UNDEFINED OR CorItemsLocationAttributes = VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef))
	|		AND (
	|			BusinessOperation = VALUE(Enum.BusinessTransactions.AssemblyFromComponents)
	|			OR BusinessOperation = VALUE(Enum.BusinessTransactions.DisassemblyIntoComponents)
	|		 	OR BusinessOperation = VALUE(Enum.BusinessTransactions.SaleWithDeferredTransferOfTitle)
	|		 	OR BusinessOperation = VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit)
	|		)	
	|	)
	|	AND NOT EntryType = VALUE(Enum.LotRecordTypes.IncludeExciseInCost)
	|";
			
	GenerateProductsProductsMovementWithRequest(CalculationParameters
		,"TTMovementProductProductMovement"
		,MatchingTemporaryMovementTables
		,QueryCondition
		,"CASE
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.SaleWithDeferredTransferOfTitle),
		|			VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit)) THEN
		|		VALUE(Enum.BusinessTransactions.ShipmentWithDeferredTransferOfTitle)
		|	ELSE
		|		BusinessOperation
		|END");
				
	RequestConditionInternalReceiptOfGoods = QueryCondition + "
	|	AND (
	|		BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices)
	|		OR BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices)
	|	)";

	GenerateProductsProductsMovementWithRequest(CalculationParameters
		,"TTMovementProductsProductsInternalReceiptOfGoods"
		,MatchingTemporaryMovementTables
		,RequestConditionInternalReceiptOfGoods
		,"VALUE(Enum.BusinessTransactions.InternalGoodsReceipt)");
	
	RequestConditionInternalReceiptOfWorks = QueryCondition + "
	|	AND BusinessOperation = VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices)";

	GenerateProductsProductsMovementWithRequest(CalculationParameters
		,"TTMovementProductsProductsInternalWorkFlow"
		,MatchingTemporaryMovementTables
		,RequestConditionInternalReceiptOfWorks
		,"VALUE(Enum.BusinessTransactions.InternalWorkReceipt)");
	
	QueryCondition = "
	|	(FullAmountOfRevaluation > 0 OR SumCompl > 0 OR SumMan > 0)
	|	AND BusinessOperation IN (
	|			VALUE(Enum.BusinessTransactions.ReturnOfGoodsToVendor),
	|			VALUE(Enum.BusinessTransactions.IntercompanyGoodsReturn),
	|			VALUE(Enum.BusinessTransactions.GoodsMisgradingWithRevaluation),
	|			VALUE(Enum.BusinessTransactions.GoodsDamageRevaluation),
	|			VALUE(Enum.BusinessTransactions.SaleOfTransferredReturnablePackaging),
	|			VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransaction),
	|			VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse),
	|			VALUE(Enum.BusinessTransactions.GoodsLotsMisgrading))
	|";
	
	AmountAdjustmentStructure = New Structure();
	AmountAdjustmentStructure.Insert("CoefficientOfSumWithVAT", 1);
	AmountAdjustmentStructure.Insert("CoefficientOfAmountWithoutVAT", 1);
	AmountAdjustmentStructure.Insert("LocalSumCoefficient", 1);
	AmountAdjustmentStructure.Insert("ManSumRatio", 1);
	AmountAdjustmentStructure.Insert("CorSumRatio", 1);
	
	GenerateRegisteredRecordsProductsIncomeExpensesQuery(CalculationParameters, "TTIncomeExpensesExpensesFromRevaluationOfGoods", MatchingTemporaryMovementTables, QueryCondition, 
		False, 
		Enums.BusinessTransactions.ExpensesFromGoodsRevaluation, 
		AmountAdjustmentStructure);
	
	QueryCondition = "
	|	(FullAmountOfRevaluation < 0 OR (SumCompl + ProvisionForImpairmentLocal) < 0 OR (SumMan + ProvisionForImpairmentMan) < 0)
	|	AND BusinessOperation IN (
	|			VALUE(Enum.BusinessTransactions.ReturnOfGoodsToVendor),
	|			VALUE(Enum.BusinessTransactions.IntercompanyGoodsReturn),
	|			VALUE(Enum.BusinessTransactions.GoodsMisgradingWithRevaluation),
	|			VALUE(Enum.BusinessTransactions.GoodsDamageRevaluation),
	|			VALUE(Enum.BusinessTransactions.SaleOfTransferredReturnablePackaging),
	|			VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransaction),
	|			VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse),
	|			VALUE(Enum.BusinessTransactions.GoodsLotsMisgrading))
	|";
	
	AmountAdjustmentStructure = New Structure();
	AmountAdjustmentStructure.Insert("CoefficientOfSumWithVAT", -1);
	AmountAdjustmentStructure.Insert("CoefficientOfAmountWithoutVAT", -1);
	AmountAdjustmentStructure.Insert("LocalSumCoefficient", -1);
	AmountAdjustmentStructure.Insert("ManSumRatio", -1);
	AmountAdjustmentStructure.Insert("CorSumRatio", 1);
	
	GenerateRegisteredRecordsProductsIncomeExpensesQuery(CalculationParameters, "TTIncomeExpensesIncomeFromRevaluationOfGoods", MatchingTemporaryMovementTables, QueryCondition, 
		True, 
		Enums.BusinessTransactions.IncomeFromGoodsRevaluation, 
		AmountAdjustmentStructure);
	
EndProcedure

Function AdjustSumFieldForProductMovementWithRequest(Field, AmountAdjustmentStructure)
	
	FieldNamesWithVAT   = New Structure("Cost, AddExpensesForGoods, LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedVariableCostsIncludingVAT");
	FieldNamesWithoutVAT = New Structure("CostExcludingVAT, AdditionalExpensesExcludingVAT, ItemizedFixedCostsExcludingVAT, ItemizedVariableCostsExcludingVAT");
	LocalFieldNames   = New Structure("LocalCost, AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl, ItemizedVariableCostsCompl");
	ManFieldNames 	 = New Structure("CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag");
	
	ReducedValueFieldNames = New Structure("Cost, CostExcludingVAT");
	
	NewField = Field;
	
	If FieldNamesWithVAT.Property(Field) Then
		
		If ReducedValueFieldNames.Property(Field) Then
			NewField = "(" + Field + " - CorGrossInitialCostENT * " + Format(AmountAdjustmentStructure.CorSumRatio, "NDS=.; NZ=0; NG=0") + ") * " + Format(AmountAdjustmentStructure.CoefficientOfSumWithVAT, "NDS=.; NZ=0; NG=0");
		Else
			NewField = Field + " * " + Format(AmountAdjustmentStructure.CoefficientOfSumWithVAT, "NDS=.; NZ=0; NG=0");
		EndIf;
		
	ElsIf FieldNamesWithoutVAT.Property(Field) Then
		
		If ReducedValueFieldNames.Property(Field) Then
			NewField = "(" + Field + " - CorGrossInitialCostENT * " + Format(AmountAdjustmentStructure.CorSumRatio, "NDS=.; NZ=0; NG=0") + ") * " + Format(AmountAdjustmentStructure.CoefficientOfAmountWithoutVAT, "NDS=.; NZ=0; NG=0");
		Else
			NewField = Field + " * " + Format(AmountAdjustmentStructure.CoefficientOfAmountWithoutVAT, "NDS=.; NZ=0; NG=0");
		EndIf;
	
	ElsIf LocalFieldNames.Property(Field) Then
		
		NewField = Field + " * " + Format(AmountAdjustmentStructure.LocalSumCoefficient, "NDS=.; NZ=0; NG=0");
	
	ElsIf ManFieldNames.Property(Field) Then
		
		NewField = Field + " * " + Format(AmountAdjustmentStructure.ManSumRatio, "NDS=.; NZ=0; NG=0");
		
	EndIf;
		
	Return NewField;
	
EndFunction

Procedure GenerateRegisteredRecordsOtherAssetsLiabilitiesByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables)
	
	Query.Text = "
	|SELECT
	|	T.Period,
	|	(CASE
	|		WHEN (T.AmountIncludingVAT >= 0 AND NOT T.ReversingEntry) OR (T.AmountIncludingVAT < 0 AND T.ReversingEntry)
	|			THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense) END) AS RecordType,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.Organization,
	|	T.Department,
	|	T.CorLineOfBusiness AS LineOfBusiness,
	|	T.AssetAndLiabilityItem AS AssetRef,
	|	T.AssetsLiabilitiesDimension AS Dimension,
	// Resources
	|	(CASE
	|		WHEN (T.AmountIncludingVAT >= 0 AND NOT T.ReversingEntry) OR (T.AmountIncludingVAT < 0 AND T.ReversingEntry)
	|			THEN T.AmountIncludingVAT
	|			+ CASE WHEN T.ThisIsOutput THEN T.InitialCost_ ELSE 0 END
	|		ELSE -T.AmountIncludingVAT END) AS Sum,
	// Attributes
	|	T.ReversingEntry
	|
	|INTO TTMovementTableOtherAssetsLiabilities
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	|	AND T.AssetAndLiabilityItem REFS ChartOfCharacteristicTypes.AssetLiabilityItems
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name);
	DescriptionOfTT.NameOfSourceTT = "TTMovementTableOtherAssetsLiabilities";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
EndProcedure

Procedure GenerateRegisteredRecordsOnOtherAssetsLiabilitiesByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables)
	
	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.Organization,
	|	T.Department,
	|	T.CorLineOfBusiness AS LineOfBusiness,
	|	T.AssetAndLiabilityItem AS AssetRef,
	|	T.AssetsLiabilitiesDimension AS Dimension,
	|	T.GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
	// Resources
	|	(CASE
	|		WHEN T.AmountIncludingVAT > 0 AND NOT T.ReversingEntry OR T.AmountIncludingVAT < 0 AND T.ReversingEntry
	|			THEN T.AmountIncludingVAT
	|		ELSE 0 END) AS AmountIncludingVAT,
	|	(CASE
	|		WHEN T.AmountExcludingVAT > 0 AND NOT T.ReversingEntry OR T.AmountExcludingVAT < 0 AND T.ReversingEntry
	|			THEN T.AmountExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	(CASE
	|		WHEN T.SumCompl > 0 AND NOT T.ReversingEntry OR T.SumCompl < 0 AND T.ReversingEntry
	|			THEN T.SumCompl
	|		ELSE 0 END) AS SumCompl,
	|	(CASE
	|		WHEN T.SumMan > 0 AND NOT T.ReversingEntry OR T.SumMan < 0 AND T.ReversingEntry
	|			THEN T.SumMan
	|		ELSE 0 END) AS SumMan,
	|	(CASE
	|		WHEN T.SumCompl - T.PermanentDifference - T.CostTD > 0 AND NOT T.ReversingEntry
	|		 OR T.SumCompl - T.PermanentDifference - T.CostTD < 0 AND T.ReversingEntry
	|			THEN T.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE
	|		WHEN T.SumCompl - T.PermanentDifference - T.CostTD > 0 AND NOT T.ReversingEntry
	|		 OR T.SumCompl - T.PermanentDifference - T.CostTD < 0 AND T.ReversingEntry
	|			THEN T.CostTD
	|		ELSE 0 END) AS CostTD,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	T.ReversingEntry,
	|	T.BusinessTransactionSetting,
	|	CASE
	|		WHEN T.DocumentRegisterRecords REFS Document.AllocationOfOtherCosts
	|			THEN &IDOfUnusedFinRecord
	|		ELSE T.FinRecordID
	|	END AS FinRecordID
	|INTO TTTableOfRegisteredRecordsInOtherAssetsLiabilities
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	|	AND T.AssetAndLiabilityItem REFS ChartOfCharacteristicTypes.AssetLiabilityItems
	|	AND ((T.AmountIncludingVAT > 0 OR T.AmountExcludingVAT > 0 OR T.SumCompl > 0 OR T.SumMan > 0
	|			OR T.SumCompl - T.PermanentDifference - T.CostTD > 0)
	|		AND NOT T.ReversingEntry
	|		OR (T.AmountIncludingVAT < 0 OR T.AmountExcludingVAT < 0 OR T.SumCompl < 0 OR T.SumMan < 0
	|			OR T.SumCompl - T.PermanentDifference - T.CostTD < 0)
	|		AND T.ReversingEntry)
	|	AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
	|
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.Organization,
	|	T.Department,
	|	T.CorLineOfBusiness AS LineOfBusiness,
	|	T.AssetAndLiabilityItem AS AssetRef,
	|	T.AssetsLiabilitiesDimension AS Dimension,
	|	T.GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Credit) AS DebitCredit,
	// Resources
	|	(CASE
	|		WHEN T.AmountIncludingVAT < 0 AND NOT T.ReversingEntry OR T.AmountIncludingVAT > 0 AND T.ReversingEntry
	|			THEN -T.AmountIncludingVAT
	|		ELSE 0 END) AS AmountIncludingVAT,
	|	(CASE
	|		WHEN T.AmountExcludingVAT < 0 AND NOT T.ReversingEntry OR T.AmountExcludingVAT > 0 AND T.ReversingEntry 
	|			THEN -T.AmountExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	(CASE
	|		WHEN T.SumCompl < 0 AND NOT T.ReversingEntry OR T.SumCompl > 0 AND T.ReversingEntry 
	|			THEN -T.SumCompl
	|		ELSE 0 END) AS SumCompl,
	|	(CASE
	|		WHEN T.SumMan < 0 AND NOT T.ReversingEntry OR T.SumMan > 0 AND T.ReversingEntry 
	|			THEN -T.SumMan
	|		ELSE 0 END) AS SumMan,
	|	(CASE
	|		WHEN T.SumCompl - T.PermanentDifference - T.CostTD < 0 AND NOT T.ReversingEntry
	|		 OR T.SumCompl - T.PermanentDifference - T.CostTD > 0 AND T.ReversingEntry 
	|			THEN -T.PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE
	|		WHEN T.SumCompl - T.PermanentDifference - T.CostTD < 0 AND NOT T.ReversingEntry
	|		 OR T.SumCompl - T.PermanentDifference - T.CostTD > 0 AND T.ReversingEntry 
	|			THEN -T.CostTD
	|		ELSE 0 END) AS CostTD,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	T.ReversingEntry,
	|	T.BusinessTransactionSetting,
	|	CASE
	|		WHEN T.DocumentRegisterRecords REFS Document.AllocationOfOtherCosts
	|			THEN &IDOfUnusedFinRecord
	|		ELSE T.FinRecordID
	|	END AS FinRecordID
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	|	AND T.AssetAndLiabilityItem REFS ChartOfCharacteristicTypes.AssetLiabilityItems
	|	AND ((T.AmountIncludingVAT < 0 OR T.AmountExcludingVAT < 0 OR T.SumCompl < 0 OR T.SumMan < 0
	|			OR T.SumCompl - T.PermanentDifference - T.CostTD < 0)
	|		AND NOT T.ReversingEntry
	|		OR (T.AmountIncludingVAT > 0 OR T.AmountExcludingVAT > 0 OR T.SumCompl > 0 OR T.SumMan > 0
	|			OR T.SumCompl - T.PermanentDifference - T.CostTD > 0)
	|		AND T.ReversingEntry)
	|	AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
	|
	// Transfer to a branch (on the sender's side)
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.Organization,
	|	(CASE
	|		WHEN NOT T.ItemsLocationAttributes.WarehouseArea.Department IS NULL
	|			THEN T.ItemsLocationAttributes.WarehouseArea.Department
	|		ELSE T.ItemsLocationAttributes.Department END) AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting) AS AssetRef,
	|	T.CorCompany AS Dimension,
	|	T.GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
	// SResources
	|	T.AmountIncludingVAT AS AmountIncludingVAT,
	|	T.AmountExcludingVAT AS AmountExcludingVAT,
	|	T.SumCompl AS SumCompl,
	|	T.SumMan AS SumMan,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	T.ReversingEntry,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.BusinessOperation IN (
	|		VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices),
	|		VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices),
	|		VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices))
	|
	// Transfer to a branch (on the recipient's side)
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.CorCompany AS Organization,
	|	(CASE
	|		WHEN NOT T.ItemsLocationAttributes.WarehouseArea.Department IS NULL
	|			THEN T.ItemsLocationAttributes.WarehouseArea.Department
	|		ELSE T.ItemsLocationAttributes.Department END) AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting) AS AssetRef,
	|	T.Organization AS Dimension,
	|	T.GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Credit) AS DebitCredit,
	// Resources
	|	T.AmountIncludingVAT AS AmountIncludingVAT,
	|	T.AmountExcludingVAT AS AmountExcludingVAT,
	|	T.SumCompl AS SumCompl,
	|	T.SumMan AS SumMan,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	T.ReversingEntry,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.BusinessOperation IN (
	|		VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices),
	|		VALUE(Enum.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices),
	|		VALUE(Enum.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices))
	|";
	Query.SetParameter("IDOfUnusedFinRecord", DocumentsPosting.IDOfUnusedFinRecord());
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherAssetsAndLiabilitiesRecords.Name);
	DescriptionOfTT.NameOfSourceTT = "TTTableOfRegisteredRecordsInOtherAssetsLiabilities";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
EndProcedure

Procedure GenerateAllOtherExpensesInManAccountingByRequest(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE,
			StructureOfTextsOfSummaryIndicators)
			
	TextPrev = "CASE WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse) THEN -1 ELSE 1 END * ";
	TextAmount = TextPrev + StructureOfTextsOfSummaryIndicators.TextAmount;
	TextAmountWithoutVAT = TextPrev + StructureOfTextsOfSummaryIndicators.TextAmountWithoutVAT;
	TextOfSumOfMan = TextPrev + StructureOfTextsOfSummaryIndicators.TextOfSumOfMan;

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = "
	|Period, Organization, Department, DimensionOfExpenses, BusinessOperation,
	|ItemsLocationAttributes, ProductsGroup, DocumentRegisterRecords, ReversingEntry,
	|BusinessTransactionSetting, FinRecordID, DocumentCalculation";

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	ParametersStructure = New Structure();
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "Character * (" + TextAmount + ")");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItem", "ItemOfExpenditureWriteOffMan");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DimensionOfExpenses", "AnalysisOfManSExpenses");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LineOfBusiness", "CorLineOfBusiness");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "
	|CASE
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany) THEN
	|		CorCompany
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "Organization") + " 
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemsLocationAttributes", "
	|CASE
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse) THEN
	|		CorItemsLocationAttributes
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "ItemsLocationAttributes") + " 
	|END");

	// The conditions for the amount excluding VAT must match the conditions in:
	// - See GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest
	// - in the incoming Register Recorded. See AdjustCostOfRefundsFromPreviousPeriods.
	// - See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_.
// -
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "
	|CASE
	|	WHEN NOT CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|			VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|		THEN Character * (" + TextAmountWithoutVAT + ")
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "AmountExcludingVAT") + " 
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "
	|CASE
	|	WHEN NOT CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.OnOtherAssets) THEN
	|		CASE
	|			WHEN NOT &CompanyManagementAccounting OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany) THEN
	|				0
	|			WHEN CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost) AND NOT &VNAManagementIsUsed_2_4 THEN
	|				0
	|			ELSE
	|				Character * (" + TextOfSumOfMan + ")
	|		END
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "SumMan") + " 
	|END");
	
	ParametersStructure.Insert("CompanyManagementAccounting", CalculationParameters.CompanyManagementAccounting);
	ParametersStructure.Insert("VNAManagementIsUsed_2_4", CalculationParameters.VNAManagementIsUsed_2_4);
	ParametersStructure.Insert("UseAccountingOfOtherIncomeExpensesInLocalAccounting", CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE, ParametersStructure);
		
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
	// Traffic cor
	GenerateAllOtherExpensesByCorRequest(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE,
			TextAmount, TextAmountWithoutVAT, TextOfSumOfMan);
	
EndProcedure

Procedure GenerateAllOtherExpensesUsingRequest(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE,
			StructureOfTextsOfSummaryIndicators)
			
	TextPrev = "CASE WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse) THEN -1 ELSE 1 END * ";
	TextAmount = TextPrev + StructureOfTextsOfSummaryIndicators.TextAmount;
	TextAmountWithoutVAT = TextPrev + StructureOfTextsOfSummaryIndicators.TextAmountWithoutVAT;
	TextAmountRegl = TextPrev + StructureOfTextsOfSummaryIndicators.TextAmountRegl;
	TextOfSumOfMan = TextPrev + StructureOfTextsOfSummaryIndicators.TextOfSumOfMan;
	TextConstantDifference = TextPrev + StructureOfTextsOfSummaryIndicators.TextConstantDifference;
	TextTimeDifference = TextPrev + StructureOfTextsOfSummaryIndicators.TextTimeDifference;
	TextSumOfPersonalIncomeTax = TextPrev + StructureOfTextsOfSummaryIndicators.TextSumOfPersonalIncomeTax;

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = "
	|Period, Organization, Department, DimensionOfExpenses, BusinessOperation,
	|ItemsLocationAttributes, ProductsGroup, DocumentRegisterRecords, ReversingEntry,
	|BusinessTransactionSetting, FinRecordID, DocumentCalculation, VariancePeriod";

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	ParametersStructure = New Structure();
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "Character * (" + TextAmount + ")");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItem", "ExpenseItemOfWriteOff");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LineOfBusiness", "CorLineOfBusiness");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "
	|CASE
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany) THEN
	|		CorCompany
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "Organization") + " 
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemsLocationAttributes", "
	|CASE
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse) THEN
	|		CorItemsLocationAttributes
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "ItemsLocationAttributes") + " 
	|END");

	// The conditions for the amount excluding VAT must match the conditions in:
	// - See GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest
	// - in the incoming Register Recorded. See AdjustCostOfRefundsFromPreviousPeriods.
	// - See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_
// -
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "
	|CASE
	|	WHEN NOT CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|			VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|		THEN Character * (" + TextAmountWithoutVAT + ")
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "AmountExcludingVAT") + " 
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "
	|CASE
	|	WHEN NOT CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.OnOtherAssets) THEN
	|		CASE
	|			WHEN NOT &CompanyManagementAccounting OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany) THEN
	|				0
	|			WHEN CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost) AND NOT &VNAManagementIsUsed_2_4 THEN
	|				0
	|			ELSE
	|				Character * (" + TextOfSumOfMan + ")
	|		END
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "SumMan") + " 
	|END");
	
	ParametersStructure.Insert("CompanyManagementAccounting", CalculationParameters.CompanyManagementAccounting);
	ParametersStructure.Insert("VNAManagementIsUsed_2_4", CalculationParameters.VNAManagementIsUsed_2_4);
	ParametersStructure.Insert("UseAccountingOfOtherIncomeExpensesInLocalAccounting", CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting);
	
	// SumCompl
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "
	|CASE
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting
	| 		OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	| 		OR CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.OnOtherAssets)
	| 		OR (CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost) AND NOT &VNAManagementIsUsed_2_4) THEN
	|		0
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToOperation) THEN
	|		0
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.CommissioningACAndTA) THEN
	|		0
	|	ELSE
	|		Character * (" + TextAmountRegl + ")
	|END");
	
	// PermanentDifference
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "
	|CASE
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting
	| 		OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	| 		OR CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.OnOtherAssets)
	| 		OR (CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost) AND NOT &VNAManagementIsUsed_2_4) THEN
	|		0
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToOperation) THEN
	|		CASE 
	|			WHEN FALSE THEN 0 // for easy tag placement
	|			ELSE
	|				0
	|			END
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.CommissioningACAndTA) THEN
	|		0
	|	WHEN NOT EnteredInTaxAccounting THEN
	|		Character * (" + TextAmountRegl + ") - Character * (" + TextTimeDifference + ")
	|	ELSE
	|		Character * " + TextConstantDifference + "
	|END");
	
	// CostTD
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "
	|CASE
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting
	| 		OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	| 		OR CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.OnOtherAssets)
	| 		OR (CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost) AND NOT &VNAManagementIsUsed_2_4) THEN
	|		0
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToOperation) THEN
	|		CASE
	|			WHEN FALSE THEN 0 // for easy tag placement
	|			ELSE
	|				0
	|		END
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.CommissioningACAndTA) THEN
	|		0
	|	ELSE
	|		Character * (" + TextTimeDifference + ")
	|END");
	
	// AITAmount
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AITAmount", "
	|CASE
	|	WHEN NOT ISNULL(ExpenseItemOfWriteOff.RecognizedInAITExpenses, TRUE)
	|		THEN 0
	|	WHEN NOT &UseAccountingOfOtherIncomeExpensesInLocalAccounting
	| 		OR BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	| 		OR CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.OnOtherAssets)
	| 		OR (CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost) AND NOT &VNAManagementIsUsed_2_4) THEN
	|		0
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToOperation) THEN
	|		0
	|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.CommissioningACAndTA) THEN
	|		0
	|	ELSE
	|		Character * (" + TextSumOfPersonalIncomeTax + ")
	|END");
	
	ConditionWHERE = ConditionWHERE + "
		|	AND BusinessOperation <> VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)";
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE, ParametersStructure);
		
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
	// Reflection of write-off of reserves for impairment of inventories.
	NameOfTemporaryReservesTable = TempTableName + "Reserves";
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation", 
		"VALUE(Enum.BusinessTransactions.WriteOffOfInventoryImpairmentProvision)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting", 
		"VALUE(Catalog.BusinessTransactionsSettings.WriteOffOfInventoryImpairmentProvision)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "ProvisionForImpairmentMan");
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting Then
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "ProvisionForImpairmentLocal");
	EndIf;
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "ProvisionForImpairmentLocal");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AITAmount", "0");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", 
		NameOfTemporaryReservesTable, 
		ConditionWHERE + "
			|	AND NOT RestoreReserves
			|	AND BusinessOperation <> VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
			|"
		, 
		ParametersStructure);
		
	MatchingTemporaryMovementTables.Insert(NameOfTemporaryReservesTable, RegisterName);
	
	// Traffic cor
	GenerateAllOtherExpensesByCorRequest(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE,
			TextAmount, TextAmountWithoutVAT, TextOfSumOfMan);
	
EndProcedure

Procedure GenerateAllOtherExpensesByCorRequest(CalculationParameters, TempTableName, MatchingTemporaryMovementTables, ConditionWHERE,
			TextAmount, TextAmountWithoutVAT, TextOfSumOfMan)

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = "
	|Period, Organization, Department, DimensionOfExpenses, BusinessOperation,
	|ItemsLocationAttributes, ProductsGroup, DocumentRegisterRecords, ReversingEntry, DocumentCalculation";
	
	ConditionWHEREBalanced = ConditionWHERE + "
	|	AND (NOT CorCompany IS NULL AND CorCompany <> UNDEFINED AND CorCompany <> VALUE(Catalog.Companies.EmptyRef))
	|	AND CorCompany <> Organization
	|	AND BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	|";
	 
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	// ExpenseReversalInManAccounting
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "True");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItem", "ExpenseItemOfWriteOff");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "-(" + TextAmount + ")");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AITAmount", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation",
		"VALUE(Enum.BusinessTransactions.ExpenseReversalInManAccounting)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	// The conditions for the amount excluding VAT must match the conditions in:
	// - See GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest
	// - in the incoming Register Recorded. See AdjustCostOfRefundsFromPreviousPeriods.
	// - See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_.
// -
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "
	|CASE
	|	WHEN NOT CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|			VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|		THEN -Character * (" + TextAmountWithoutVAT + ")
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "AmountExcludingVAT") + " 
	|END");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName + "CorReversalOfMaExpenses", ConditionWHEREBalanced);
		
	MatchingTemporaryMovementTables.Insert(TempTableName + "CorReversalOfMaExpenses", RegisterName);
	
	// ExpenseRegistrationInManAccounting
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "True");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "CorCompany");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItem", "ExpenseItemOfWriteOff");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", TextAmount);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AITAmount", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	// The conditions for the amount excluding VAT must match the conditions in:
	// - See GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest
	// - in the incoming traffic. See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_.
// -
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "
	|CASE
	|	WHEN NOT CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|			VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|		THEN Character * (" + TextAmountWithoutVAT + ")
	|	ELSE
	|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "AmountExcludingVAT") + " 
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation",
		"VALUE(Enum.BusinessTransactions.ExpenseRegistrationInManAccounting)");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName + "CorRegistrationOfMaExpenses", ConditionWHEREBalanced);
		
	MatchingTemporaryMovementTables.Insert(TempTableName + "CorRegistrationOfMaExpenses", RegisterName);
	
	
	// Let's add movements in the "Assets and Liabilities" register.
	RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name;
	
	CopiedFields = "
	|Period, Organization, Department, LineOfBusiness";
	
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AssetRef", "VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ProfitAndLoss)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Dimension", "Organization");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "Character * (" + TextAmount + ")");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName + "OtherAssetsLiabilities_Receipt", ConditionWHEREBalanced);
		
	MatchingTemporaryMovementTables.Insert(TempTableName + "OtherAssetsLiabilities_Receipt", RegisterName);
	
	// Let's add a movement and fill in its basic properties
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Expense)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "FALSE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "CorCompany");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AssetRef", "VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ProfitAndLoss)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Dimension", "CorCompany");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "Character * (" + TextAmount + ")");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName + "OtherAssetsLiabilities_Expense", ConditionWHEREBalanced);
		
	MatchingTemporaryMovementTables.Insert(TempTableName + "OtherAssetsLiabilities_Expense", RegisterName);
	
EndProcedure

