	|UNION ALL
	|
	|SELECT
	|	RefundTable.Period                        AS Period,
	|	RefundTable.Recorder                   AS Recorder,
	|	RefundTable.Recorder                   AS DocumentRegisterRecords,
	|	RefundTable.DocumentCalculation               AS DocumentCalculation,
	|	RefundTable.RecordType                   AS RecordType,
	|	RefundTable.Organization                   AS Organization,
	|	RefundTable.CorCompany                AS CorCompany,
	|	RefundTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	RefundTable.AccountingSection                   AS AccountingSection,
	|	RefundTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	RefundTable.Lot                        AS Lot,
	|	RefundTable.LotVendorAttributes          AS LotVendorAttributes,
	|	RefundTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	RefundTable.VATActivityType            AS VATActivityType,
	|	RefundTable.InventoryType                    AS InventoryType,
	|	RefundTable.BusinessOperation         AS BusinessOperation,
	|	RefundTable.CorItemsLocationAttributes AS CorItemsLocationAttributes,
	|	RefundTable.CorAccountingSection                AS CorAccountingSection,
	|	RefundTable.CorInventoryOwnerAttribute                 AS CorInventoryOwnerAttribute,
	|	RefundTable.InventoryType                    AS CorInventoryType,
	|	RefundTable.AccountingDimensionByPartners     AS AccountingDimensionByPartners,
	|	RefundTable.SalesOrder                  AS SalesOrder,
	|	RefundTable.Department                 AS Department,
	|	RefundTable.ImplementationPeriod              AS ImplementationPeriod,
	|	RefundTable.DimensionOfRevenue              AS DimensionOfRevenue,
	|	RefundTable.IncomeItem                 AS IncomeItem,
	|	UNDEFINED                                   AS DimensionOfExpenses,
	|	UNDEFINED                                   AS ExpenseItemOfWriteOff,
	|	RefundTable.ProductsGroup               AS ProductsGroup,
	|	RefundTable.LineOfBusiness       AS LineOfBusiness,
	|	RefundTable.CorLineOfBusiness    AS CorLineOfBusiness,
	|	UNDEFINED                                   AS CostAllocationOptionManag,
	|	UNDEFINED                                   AS CostAllocationOptionLocal,
	|	FALSE                                           AS EnteredInTaxAccounting,
	|	UNDEFINED                                   AS AssetsLiabilitiesDimension,
	|	UNDEFINED                                   AS AssetAndLiabilityItem,
	|	RefundTable.RowID           AS RowID,
	|	RefundTable.RowCode                 	   AS RowCode,
	|	RefundTable.Manager                      AS Manager,
	|	RefundTable.Warehouse                         AS Warehouse,
	|	RefundTable.Terms                    AS Terms,
	|	RefundTable.Contract                       AS Contract,
	|	RefundTable.SetAccountingDimension         AS SetAccountingDimension,
	|	RefundTable.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	|	RefundTable.ProductLineOfBusiness AS ProductLineOfBusiness,
	|	RefundTable.VATTaxation            AS VATTaxation,
	|	RefundTable.ARAPCurrency          AS ARAPCurrency,
	|	RefundTable.DocumentCurrency               AS DocumentCurrency,
	|	RefundTable.SourceOfProductFinancialAccountingGroup       AS SourceOfProductFinancialAccountingGroup,
	|	RefundTable.SourceOfARAPFinancialAccountingGroup           AS SourceOfARAPFinancialAccountingGroup,
	|	RefundTable.SalePeriod                 AS SalePeriod,
	|	RefundTable.CorLot                     AS CorLot,
	|	RefundTable.LotVendorAttributesCorr       AS LotVendorAttributesCorr,
	|	RefundTable.CorControllingAttributes  AS CorControllingAttributes,
	|	RefundTable.CorVATActivityTypes         AS CorVATActivityTypes,
	|	RefundTable.VATLocal                       AS VATLocal,
	|	RefundTable.VATManag                        AS VATManag,
	|	RefundTable.ProductCostElement             AS ProductCostElement,
	|	RefundTable.EntryType                     AS EntryType,
	|	RefundTable.DocumentSource              AS DocumentSource,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceIncome) AS BusinessTransactionSetting,
	// Deviations in the cost are reflected by the ID of the document line.
	|	(CASE
	|		WHEN RefundTable.RowID <> """"
	|			THEN RefundTable.RowID
	|		ELSE RefundTable.FinRecordID END) AS FinRecordID,
	|	RefundTable.CostAccountingTransaction    AS CostAccountingTransaction,
	|	RefundTable.GLAccountSettings          AS GLAccountSettings,
	|	RefundTable.CostDefiningMethod AS CostDefiningMethod,
	|	FALSE                                           AS ReversingEntry,
	|	UNDEFINED                                   AS VATRate,
	|	0                                              AS CorGrossInitialCostENT,
	|	FALSE                                           AS ThisIsTransferBetweenOrganizations,
	|	FALSE                                           AS CorCompanyOnMediumSlip,
	|	FALSE                                           AS WriteOffReserves,
	|	RefundTable.BusinessOperation         AS ParishEconomicOperation,
	|	RefundTable.EntryType                     AS ParishRecordType,
	|	RefundTable.BusinessTransactionSetting AS ArrivalSettingUpBusinessOperation,
	|	RefundTable.CorItemsLocationAttributes  AS ArrivalOfCorAnalyticsAccountingProducts,
	|	RefundTable.ItemsLocationAttributes    AS AnalysisOfAccountingForProductRange,
	|	RefundTable.FinancialAccountingDimension     AS AnalysisOfFinancialAccountingIn,
	|
	|	(CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT >= 0
	|			THEN Cost
	|		ELSE 0 END) AS Cost,
	|	(CASE 
	|		WHEN CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT >= 0
	|			THEN CostExcludingVAT
	|		ELSE 0 END) AS CostExcludingVAT,
	|	(CASE 
	|		WHEN OffBalanceCost >= 0
	|			THEN OffBalanceCost
	|		ELSE 0 END) AS OffBalanceCost,
	|	(CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT >= 0
	|			THEN AddExpensesForGoods
	|		ELSE 0 END) AS AddExpensesForGoods,
	|	(CASE 
	|		WHEN CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT >= 0
	|			THEN AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
	|	(CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT >= 0
	|			THEN LaborCosts
	|		ELSE 0 END) AS LaborCosts,
	|	(CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT >= 0
	|			THEN ItemizedFixedCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsIncludingVAT,
	|	(CASE 
	|		WHEN CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT >= 0
	|			THEN ItemizedFixedCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsExcludingVAT,
	|	(CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT >= 0
	|			THEN ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsIncludingVAT,
	|	(CASE 
	|		WHEN CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT >= 0
	|			THEN ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsExcludingVAT,
	|
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN LocalCost
	|		ELSE 0 END) AS LocalCost,
	|	(CASE 
	|		WHEN OffBalanceCostLocal >= 0
	|			THEN OffBalanceCostLocal
	|		ELSE 0 END) AS OffBalanceCostLocal,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN PermanentDifference
	|		ELSE 0 END) AS PermanentDifference,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN CostTD
	|		ELSE 0 END) AS CostTD,
	|	0 AS CostOfPersonalIncomeTax,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN LaborCostsLocal
	|		ELSE 0 END) AS LaborCostsLocal,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN ItemizedFixedCostsCompl
	|		ELSE 0 END) AS ItemizedFixedCostsCompl,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			THEN ItemizedVariableCostsCompl
	|		ELSE 0 END) AS ItemizedVariableCostsCompl,
	|
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan >= 0
	|			THEN CostMan
	|		ELSE 0 END) AS CostMan,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan >= 0
	|			THEN AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan >= 0
	|			THEN LaborCostsMan
	|		ELSE 0 END) AS LaborCostsMan,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan >= 0
	|			THEN ItemizedFixedCostsManag
	|		ELSE 0 END) AS ItemizedFixedCostsManag,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan >= 0
	|			THEN ItemizedVariableCostsManag
	|		ELSE 0 END) AS ItemizedVariableCostsManag,
	|
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan
	|
	|FROM
	|	TTDataAdjustmentTable AS RefundTable
	|WHERE
	|	RefundTable.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnPackageFromCustomerOfPreviousPeriods)
	// Negative amounts of deviation in value will be attributed to other income
	|	AND (CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT >= 0
	|			OR CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT >= 0
	|			OR LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal >= 0
	|			OR CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan >= 0
	|			OR OffBalanceCost >= 0
	|			OR OffBalanceCostLocal >= 0
	|				THEN TRUE
	|		ELSE FALSE END)
	|";
#EndRegion

