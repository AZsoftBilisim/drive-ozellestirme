	|	Preliminary.DirectCostsTA,
	|	Preliminary.AcceptedVNU,
	|	Preliminary.ManufacturedProduct,
	|	Preliminary.ItemVariant,
	|	Preliminary.ProductsGroup,
	|	Preliminary.VATActivityType,
