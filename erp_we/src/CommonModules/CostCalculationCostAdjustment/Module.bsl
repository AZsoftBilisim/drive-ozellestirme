EndFunction

Function DescriptionOfFormationOfTemporaryTable(RegisterName, ResultPostfix = "", AddIds = False) Export
	
	ReturnStructure = New Structure;
	ReturnStructure.Insert("Name", RegisterName);
	ReturnStructure.Insert("TTResultName", "TT" + RegisterName + ResultPostfix);
	ReturnStructure.Insert("NameOfSourceTT", "TT" + ?(StrStartsWith(RegisterName, "RegisterRecords"), "", "RegisterRecords") + RegisterName);
	ReturnStructure.Insert("AddIds", AddIds);
	
	Return ReturnStructure;
	
EndFunction

