	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal < 0
	|			THEN AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal < 0
	|			THEN LaborCostsLocal
	|		ELSE 0 END) AS LaborCostsLocal,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal < 0
	|			THEN ItemizedFixedCostsCompl
	|		ELSE 0 END) AS ItemizedFixedCostsCompl,
	|	(CASE 
	|		WHEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal < 0
	|			THEN ItemizedVariableCostsCompl
	|		ELSE 0 END) AS ItemizedVariableCostsCompl,
	|
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan < 0
	|			THEN CostMan
	|		ELSE 0 END) AS CostMan,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan < 0
	|			THEN AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan < 0
	|			THEN LaborCostsMan
	|		ELSE 0 END) AS LaborCostsMan,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan < 0
	|			THEN ItemizedFixedCostsManag
	|		ELSE 0 END) AS ItemizedFixedCostsManag,
	|	(CASE 
	|		WHEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan < 0
	|			THEN ItemizedVariableCostsManag
	|		ELSE 0 END) AS ItemizedVariableCostsManag,
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan
	|
	|FROM
	|	TTDataAdjustmentTable AS RefundTable
	|WHERE
	|	RefundTable.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnPackageFromCustomerOfPreviousPeriods)
	// The positive amounts of the deviation in value will be attributed to other expenses
	|	AND (CASE 
	|		WHEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT < 0
	|			OR CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT < 0
	|			OR LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal < 0
	|			OR CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan < 0
	|			OR OffBalanceCost < 0
	|			OR OffBalanceCostLocal < 0
	|			OR CostOfPersonalIncomeTax < 0
	|				THEN TRUE
	|		ELSE FALSE END)
	|";
#EndRegion
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	QueryCondition = "
	|	BusinessOperation IN (
	|		VALUE(Enum.BusinessTransactions.InventoryConsumptionReverseTransaction)
	|	)";
	
	AmountAdjustmentStructure = New Structure();
	AmountAdjustmentStructure.Insert("CoefficientOfSumWithVAT", -1);
	AmountAdjustmentStructure.Insert("CoefficientOfAmountWithoutVAT", -1);
	AmountAdjustmentStructure.Insert("LocalSumCoefficient", -1);
	AmountAdjustmentStructure.Insert("ManSumRatio", -1);
	AmountAdjustmentStructure.Insert("CorSumRatio", 0);

	GenerateRegisteredRecordsProductsIncomeExpensesQuery(CalculationParameters, "TTIncomeExpensesReverseWriteOffOfGoods", 
		MatchingTemporaryMovementTables, QueryCondition, , , AmountAdjustmentStructure);

#Region InventoryCost
	
	TempTableName = "TTMovementRefundsOfPastPeriods";
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "RegisteredRecordsAdjustmentTable");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "RegisteredRecordsAdjustmentTable", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
	GenerateCorCostOfGoodsByRequest(CalculationParameters, MatchingTemporaryMovementTables);

#EndRegion

#Region RevenueAndCOGS

	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.Recorder,
	// Dimensions
	|	CASE WHEN T.ItemsLocationAttributes <> T.CorItemsLocationAttributes
	|		AND T.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
	|			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods)) 
	|		AND NOT T.CorItemsLocationAttributes IN (UNDEFINED, 
	|			VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)) THEN
	|		T.CorItemsLocationAttributes
	|	ELSE
	|		T.ItemsLocationAttributes
	|	END AS ItemsLocationAttributes,
	|	T.SalesOrder,
	|	T.AccountingDimensionByPartners,
	|	T.Department,
	|	T.InventoryType,
	|	T.InventoryOwnerAttribute,
	// The conditions for determining the accounting field must correspond to the textparty function for the handle()
	// of the general module for calculating the cost of filling in parties.
	|	(CASE
	|		WHEN T.ItemsLocationAttributes <> T.CorItemsLocationAttributes
	|		 AND T.BusinessOperation IN (
	|			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
	|			VALUE(Enum.BusinessTransactions.ReverseOfSaleReturnToAnotherWarehouse),
	|			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods)) 
	|		 AND NOT T.CorItemsLocationAttributes IN (UNDEFINED, VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef))
	|		 AND ISNULL(T.ItemsLocationAttributes.WarehouseArea.ShopFloorStockroom, FALSE)
	|		 	<> ISNULL(T.CorItemsLocationAttributes.WarehouseArea.ShopFloorStockroom, FALSE)
	|		THEN (CASE WHEN ISNULL(T.CorItemsLocationAttributes.WarehouseArea.ShopFloorStockroom, FALSE)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|			ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock) END)
	|	ELSE T.AccountingSection END)            AS AccountingSection,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.Manager,
	|	T.Warehouse,
	|	T.Terms,
	|	T.Contract,
	|	T.BusinessOperation,
	|	T.SetAccountingDimension,
	|	T.CounterpartyLineOfBusiness,
	|	T.ProductLineOfBusiness,
	// Resources
	|	-T.Cost AS Cost,
	|	-T.CostExcludingVAT AS CostExcludingVAT,
	|	-T.AddExpensesForGoods AS AddExpensesForGoods,
	|	-T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
	|	-T.CostMan AS CostMan,
	|	-T.LocalCost AS LocalCost,
	|	-T.OffBalanceCost AS OffBalanceCost,
	|	-T.OffBalanceCostLocal AS OffBalanceCostLocal,
	|	-T.PermanentDifference AS PermanentDifference,
	|	-T.AddExpensesMan AS AddExpensesMan,
	|	-T.AddExpensesLocal AS AddExpensesLocal,
	|	-T.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	|	-T.ItemizedFixedCostsExcludingVAT AS ItemizedFixedCostsExcludingVAT,
	|	-T.ItemizedFixedCostsManag AS ItemizedFixedCostsManag,
	|	-T.ItemizedFixedCostsCompl AS ItemizedFixedCostsCompl,
	|	-T.LaborCosts AS LaborCosts,
	|	-T.LaborCostsMan AS LaborCostsMan,
	|	-T.LaborCostsLocal AS LaborCostsLocal,
	|	-T.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	|	-T.ItemizedVariableCostsExcludingVAT AS ItemizedVariableCostsExcludingVAT,
	|	-T.ItemizedVariableCostsManag AS ItemizedVariableCostsManag,
	|	-T.ItemizedVariableCostsCompl AS ItemizedVariableCostsCompl,
	|	-T.CostTD AS CostTD,
	// Attributes
	|	T.Recorder AS DocumentRegisterRecords,
	|	T.VATTaxation,
	|	T.ARAPCurrency,
	|	T.DocumentCurrency,
	|	T.SourceOfProductFinancialAccountingGroup,
	|	T.SourceOfARAPFinancialAccountingGroup,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.VATRate
	|INTO TTCostOfSales
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	NOT T.BusinessOperation IN (
	|		VALUE(Enum.BusinessTransactions.InventoryConsumptionReverseTransaction),
	|		VALUE(Enum.BusinessTransactions.ReturnPackageFromCustomerOfPreviousPeriods),
	|		VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer))
	|";
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.RevenueAndCOGS.Name);
	DescriptionOfTT.TTResultName = "TTRegisteredRecordsCostOfSalesPastPeriodRefunds";
	DescriptionOfTT.NameOfSourceTT = "TTCostOfSales";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);

#EndRegion

#Region OtherIncome

	// Formation of other income when returning containers from the client
	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.Recorder,
	// Dimensions
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.IncomeItem,
	|	T.DimensionOfRevenue,
	// Resources
	|	(CASE
	|		WHEN T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT > 0
	|			THEN T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS Sum,
	|	(CASE
	|		WHEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl > 0
	|			THEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl
	|		ELSE 0 END) AS SumCompl,
	|	(CASE
	|		WHEN T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag > 0
	|			THEN T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag
	|		ELSE 0 END) AS SumMan,
	// Attributes
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|INTO TTRegisteredRecordsOtherIncome
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	&UseAccountingOfOtherIncomeExpenses
	|	AND T.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnPackageFromCustomerOfPreviousPeriods)
	|	AND (T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT > 0
	|		OR T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl > 0
	|		OR T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag > 0
	|		)
	|";
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherIncome.Name);
	DescriptionOfTT.TTResultName = "TTRegisteredRecordsReturnsOfPastPeriodsOtherIncome";
	DescriptionOfTT.NameOfSourceTT = "TTRegisteredRecordsOtherIncome";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);

#EndRegion

#Region OtherExpenses

	// Formation of other expenses when returning containers from the client
	Query.Text = "
	|SELECT
	|	T.Period,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	T.Recorder,
	// Dimensions
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItemOfWriteOff AS ExpenseItem,
	|	T.DimensionOfExpenses,
	// Details of the expense item
	|	T.CostAllocationOptionManag,
	|	T.CostAllocationOptionLocal,
	|	T.EnteredInTaxAccounting,
	// Resources
	|	-(CASE
	|		WHEN T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT < 0
	|			THEN T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS Sum,
	// The conditions for the amount excluding VAT must match the conditions in:
	// - See AdjustInventoryWriteOffCosts
	// - and called methods. See GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest
	// - See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_.
// in the incoming Register Recorded.
// -
	|	-(CASE
	|		WHEN T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT + T.LaborCosts + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT < 0
	|			THEN CASE
	|				WHEN NOT T.CostAllocationOptionManag IN (
	|						VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|						VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|					THEN T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT + T.LaborCosts + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT
	|				ELSE 0 END
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	-(CASE
	|		WHEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl < 0
	|			THEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl
	|		ELSE 0 END) AS SumCompl,
	|	-(CASE
	|		WHEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl < 0 AND T.EnteredInTaxAccounting
	|			THEN T.PermanentDifference
	|		WHEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl < 0 AND NOT T.EnteredInTaxAccounting
	|			THEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl + T.CostTD
	|		ELSE 0 END) AS PermanentDifference,
	|	-(CASE
	|		WHEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl < 0 AND T.EnteredInTaxAccounting
	|			THEN T.CostTD
	|		ELSE 0 END) AS CostTD,
	|	-(CASE
	|		WHEN T.CostOfPersonalIncomeTax < 0
	|			THEN T.CostOfPersonalIncomeTax
	|		ELSE 0 END) AS AITAmount,
	|	-(CASE
	|		WHEN T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag < 0
	|			THEN T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag
	|		ELSE 0 END) AS SumMan,
	// Attributes
	|	T.BusinessOperation,
	|	T.ItemsLocationAttributes,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.ImplementationPeriod AS VariancePeriod
	|
	|INTO TTOtherExpenses
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	&UseAccountingOfOtherIncomeExpenses
	|	AND T.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnPackageFromCustomerOfPreviousPeriods)
	|	AND (T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT < 0
	|		OR T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT + T.LaborCosts + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT < 0
	|		OR T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl < 0
	|		OR T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag < 0
	|		OR T.CostOfPersonalIncomeTax < 0
	|		)
	|
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	T.Recorder AS DocumentRegisterRecords,
	// Dimensions
	|	T.Organization,
	|	T.Department,
	|	T.CorLineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItemOfWriteOff,
	|	T.DimensionOfExpenses,
	// Details of the expense item
	|	T.CostAllocationOptionManag,
	|	T.CostAllocationOptionLocal,
	|	T.EnteredInTaxAccounting,
	// Resources
	|	-(T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT) AS Sum,
	// The conditions for the amount excluding VAT must match the conditions in:
	// - See AdjustInventoryWriteOffCosts
	// - and called methods. See GenerateRegisteredRecordsOtherExpensesAdditionalExpensesByRequest
	// - See AccumulationRegisters.OtherExpenses.QueryTextTableTTOtherExpenses_.
// in the incoming Register Recorded.
// -
	|	-(CASE
	|		WHEN NOT T.CostAllocationOptionManag IN (
	|				VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost),
	|				VALUE(Enum.CostAllocationOptions.OnOtherAssets))
	|			THEN T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT + T.LaborCosts + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	-(T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl) AS SumCompl,
	|	-(CASE
	|		WHEN NOT T.EnteredInTaxAccounting
	|			THEN T.LocalCost + T.AddExpensesLocal + T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl
	|		ELSE T.PermanentDifference END) AS PermanentDifference,
	|	-T.CostTD AS CostTD,
	|	-T.CostOfPersonalIncomeTax AS AITAmount,
	|	-(T.CostMan + T.AddExpensesMan + T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag) AS SumMan,
	// Attributes
	|	T.BusinessOperation,
	|	T.ItemsLocationAttributes,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.ImplementationPeriod AS VariancePeriod
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	&UseAccountingOfOtherIncomeExpenses
	|	AND T.BusinessOperation = VALUE(Enum.BusinessTransactions.InventoryConsumptionReverseTransaction)
	|";
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherExpenses.Name);
	DescriptionOfTT.TTResultName = "TTRegisteredRecordsRefundsOfPastPeriodsOtherExpenses";
	DescriptionOfTT.NameOfSourceTT = "TTOtherExpenses";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);

#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	ExistingTT = CostCalculationUniversalAlgorithms.ConnectLines(ExistingTT, 
		"StornoCommissionAgentSReports, TueDatesOfSourceDocuments");
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

// Performs the formation of cost RegisteredRecords for corrections of documents of past periods and returns of past periods in the Cur period. 
//
// Parameters:
//	CalculationParameters - Structure - cost calculation parameters
//
Procedure AdjustCostOfReverseCorrectedDocuments(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfReverseCorrectedDocuments");
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"TTCostRegisteredRecords, TTOfRegisteredRecordedDeviationsInCostOfGoods, 
		|TTCostOfSales, TTMovementPurchasingTable,
		|TTOtherWorkInProgressExpenses,
		|TTOtherExpenses, TTRegisteredRecordsOtherIncome, TTRegisteredRecordsOtherAssetsLiabilities, 
		|TTMovementProductsIncomeExpenses, TTMovementProductsProducts
		| ");
	
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextAdjustCostOfStornoOfRegisteredRecordsOfCorrectedDocuments(CalculationParameters));
	
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfStornoOfRegisteredRecordsOfCorrectedDocuments_FormationOfRegisteredRecords");
	
	MatchingTemporaryMovementTables = New Map;

#Region CorrectionCostOfGoods
	
	TempTableName = "TTCostOfReverseRegisteredRecords";
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TemporaryTableNameSource = "TTCostRegisteredRecords";
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

#Region GoodsCostVariances

	TempTableName = "TTOfRegisteredRecordedMovementIsTransferredToDeviationsInCostOfGoods";
	RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters,
		"TTOfRegisteredRecordedDeviationsInCostOfGoods");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTOfRegisteredRecordedDeviationsInCostOfGoods", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

#EndRegion

#Region CorrectionRevenueAndCostOfGoodsSold

	TempTableName = "TTRevenueAndCostOfGoodsSoldReverseRegisteredRecords";
	RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTCostOfSales");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTCostOfSales", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

#EndRegion

#Region CorrectionOfProcurement

	TempTableName = "TtOfPurchaseMovement";
	RegisterName = Metadata.AccumulationRegisters.Purchases.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTMovementPurchasingTable");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTMovementPurchasingTable", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

#EndRegion
#Region CorrectionOtherWorkInProgressExpenses

	TempTableName = "TTOtherWorkInProgressExpensesStornot";
	RegisterName = Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TemporaryTableNameSource = "TTOtherWorkInProgressExpenses";
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion
#Region CorrectionOtherExpenses

	TempTableName = "TTOtherExpensesStornot";
	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTOtherExpenses");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTOtherExpenses", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

#Region CorrectionOtherIncome

	TempTableName = "TTOtherIncomeStornow";
	RegisterName = Metadata.AccumulationRegisters.OtherIncome.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTRegisteredRecordsOtherIncome");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
