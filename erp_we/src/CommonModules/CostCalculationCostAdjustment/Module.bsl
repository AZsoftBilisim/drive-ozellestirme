// Service, stage 2.1, 3.18
Procedure FormOfMovementOtherExpensesVATWriteOff(CalculationParameters) Export
	
	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields =
		"Period, RecordType, BusinessOperation, Organization, ItemsLocationAttributes, LineOfBusiness, BusinessTransactionSetting,
		|Department, ExpenseItem, DimensionOfExpenses, DocumentRegisterRecords, FinRecordID, PermanentDifference, SumCompl, SumMan";
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	Lots.Period 														AS Period,
	|	VALUE(AccumulationRecordType.Receipt) 								AS RecordType,
	|	VALUE(Enum.BusinessTransactions.VATOnAcquiredAssetsWriteOff)	AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.VATOnAcquiredAssetsWriteOff)	AS BusinessTransactionSetting,
	|	Lots.Organization 													AS Organization,
	|	Lots.ItemsLocationAttributes 									AS ItemsLocationAttributes,
	|	ISNULL(CatAssignments.LineOfBusiness,
	|		VALUE(Catalog.Assignments.EmptyRef)) 					AS LineOfBusiness,
	// The division should be filled out similarly to the accounting of the RSRF.Get parties
	|	Lots.VATWriteOffDivision										AS Department,
	|	Lots.VATWriteOffItem 											AS ExpenseItem,
	|	Lots.DimensionVATWriteOff 										AS DimensionOfExpenses,
	|	Lots.Recorder 													AS DocumentRegisterRecords,
	|	Lots.FinRecordID										AS FinRecordID,
	|	SUM(CASE WHEN ISNULL(ExpenseItems.EnteredInTaxAccounting, TRUE)
	|			THEN 0
	|			ELSE Lots.VATDeduction_
	|		END)															AS PermanentDifference,
	|	SUM(Lots.VATDeduction_) 											AS SumCompl,
	|	SUM(Lots.WriteOffOfVATMan) 										AS SumMan
	|FROM
	|	TTParty AS Lots
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	|		ON Lots.ItemsLocationAttributes = DimensionOfProductItem.Ref
	|		LEFT JOIN Catalog.Assignments AS CatAssignments
	|		ON CatAssignments.Ref = DimensionOfProductItem.Purpose
	|		LEFT JOIN ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|		ON Lots.VATWriteOffItem = ExpenseItems.Ref
	|
	|GROUP BY
	|	Lots.Period,
	|	Lots.Organization,
	|	Lots.ItemsLocationAttributes,
	|	Lots.VATWriteOffDivision,
	|	ISNULL(CatAssignments.LineOfBusiness,
	|		VALUE(Catalog.Assignments.EmptyRef)),
	|	Lots.VATWriteOffItem,
	|	Lots.DimensionVATWriteOff,
	|	Lots.Recorder,
	|	Lots.FinRecordID
	|
	|HAVING
	|	SUM(Lots.VATDeduction_) <> 0
	|	OR SUM(Lots.WriteOffOfVATMan) <> 0
	|";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,,, RegisterName);
	
	While Selection.Next() Do
		// Let's add a movement and fill in its properties.
		AddEntryToMovementTable(CalculationParameters, RegisterName, Selection, CopiedFields);
	EndDo;
	
EndProcedure

// Service, stage 2.1, 3.1, 3.3, 3.14
Procedure RoadTrafficOtherExpenses(CalculationParameters, MotionData, AmountIndicators) Export

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = "
	|Period, Organization, Department, DimensionOfExpenses, BusinessOperation,
	|ItemsLocationAttributes, ProductsGroup, DocumentRegisterRecords, FinRecordID";
	
	If MotionData.Property("BusinessTransactionSetting") Then
		CopiedFields = CopiedFields + ", " + "BusinessTransactionSetting";
	EndIf;
	
	Sum = AmountIndicators.AmountIncludingVAT;
	AmountExcludingVAT = AmountIndicators.AmountExcludingVAT;
	SumCompl = AmountIndicators.SumCompl;
	SumMan = AmountIndicators.SumMan;
	PermanentDifference = AmountIndicators.PermanentDifference;
	CostTD = AmountIndicators.CostTD;
	AITAmount = AmountIndicators.AITAmount;

	// Let's add a movement and fill in its basic properties
	Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
	
	If MotionData.BusinessOperation = Enums.BusinessTransactions.InventoryConsumptionReverseTransaction
	 And BegOfMonth(MotionData.SalePeriod) < BegOfMonth(MotionData.Period) Then
		Character = -1;
	Else
		Character = 1;
	EndIf;
	
	// Fill in additional motion properties
	Record.RecordType       = AccumulationRecordType.Receipt;
	Record.Sum             = Character * Sum;
	Record.ExpenseItem    = MotionData.ExpenseItemOfWriteOff;
	Record.LineOfBusiness = MotionData.CorLineOfBusiness;
	If MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
		Record.Organization = MotionData.CorCompany;
	EndIf;
	If MotionData.CostAllocationOptionManag = Enums.CostAllocationOptions.ToProductionCosts Then
		Record.AmountExcludingVAT = Character * AmountExcludingVAT;
	EndIf;
	
	If Not MotionData.CostAllocationOptionManag = Enums.CostAllocationOptions.OnOtherAssets Then
		If Not CalculationParameters.CompanyManagementAccounting
		 Or MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
			Record.SumMan = 0;
		ElsIf MotionData.CostAllocationOptionManag = Enums.CostAllocationOptions.ToNonCurrentAssetCost
		 And Not CalculationParameters.VNAManagementIsUsed_2_4 Then
			Record.SumMan = 0;
		Else
			Record.SumMan = Character * SumMan;
		EndIf;
	EndIf;
	
	If Not CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting
	 Or MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsSaleToAnotherCompany
	 Or MotionData.CostAllocationOptionLocal = Enums.CostAllocationOptions.OnOtherAssets
	 Or (MotionData.CostAllocationOptionLocal = Enums.CostAllocationOptions.ToNonCurrentAssetCost
	 	And Not CalculationParameters.VNAManagementIsUsed_2_4) Then
		Record.SumCompl = 0;
		Record.PermanentDifference = 0;
		Record.CostTD = 0;
		Record.AITAmount = 0;
	Else
		If MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToOperation Then
			Record.SumCompl = 0;
			Record.AITAmount = 0;
		ElsIf MotionData.BusinessOperation = Enums.BusinessTransactions.CommissioningACAndTA Then
			Record.SumCompl = 0;
			Record.PermanentDifference = 0;
			Record.CostTD = 0;
			Record.AITAmount = 0;
		Else
			Record.SumCompl = Character * SumCompl;
			Record.PermanentDifference = ?(Not MotionData.EnteredInTaxAccounting, Character * SumCompl - Character * CostTD, Character * PermanentDifference);
			Record.CostTD  = Character * CostTD;
			Record.AITAmount  = Character * AITAmount;
		EndIf;
	EndIf;
	
	If ValueIsFilled(MotionData.CorCompany)
	 And MotionData.CorCompany <> MotionData.Organization
	 And MotionData.BusinessOperation <> Enums.BusinessTransactions.GoodsSaleToAnotherCompany Then
	 
		RecordingMan = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
		RecordingMan.ExpenseItem = MotionData.ExpenseItemOfWriteOff;
		RecordingMan.Sum = -Record.Sum;
		RecordingMan.SumMan = -Record.SumMan;
		RecordingMan.SumCompl = 0;
		RecordingMan.PermanentDifference = 0;
		RecordingMan.CostTD  = 0;
		RecordingMan.AITAmount  = 0;
		RecordingMan.BusinessOperation = Enums.BusinessTransactions.ExpenseReversalInManAccounting;
		
		RecordingMan = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
		RecordingMan.Organization = MotionData.CorCompany;
		RecordingMan.ExpenseItem = MotionData.ExpenseItemOfWriteOff;
		RecordingMan.Sum = Record.Sum;
		RecordingMan.SumMan = Record.SumMan;
		RecordingMan.SumCompl = 0;
		RecordingMan.PermanentDifference = 0;
		RecordingMan.CostTD  = 0;
		RecordingMan.AITAmount  = 0;
		RecordingMan.BusinessOperation = Enums.BusinessTransactions.ExpenseRegistrationInManAccounting;
		
		// Let's add movements in the "Assets and Liabilities" register.
		RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name;
	
		CopiedFields = "
		|Period, Organization, Department, LineOfBusiness";
		
		// Let's add a movement and fill in its basic properties
		Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
		
		// Fill in additional motion properties
		Record.RecordType = AccumulationRecordType.Receipt;
		Record.AssetRef      = ChartsOfCharacteristicTypes.AssetLiabilityItems.ProfitAndLoss;
		Record.Dimension   = MotionData.Organization;
		Record.Sum 	   = Character * Sum;
		
		// Let's add a movement and fill in its basic properties
		Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
		
		// Fill in additional motion properties
		Record.RecordType = AccumulationRecordType.Expense;
		Record.Organization = MotionData.CorCompany;
		Record.AssetRef      = ChartsOfCharacteristicTypes.AssetLiabilityItems.ProfitAndLoss;
		Record.Dimension   = MotionData.CorCompany;
		Record.Sum 	   = Character * Sum;
	 
	EndIf;
	
EndProcedure

