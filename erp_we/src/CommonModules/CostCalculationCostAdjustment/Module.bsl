#Region DistributionOfRevenueByLineOfBusiness

// Fills in the line of business of the counterparty in the movements of the document according to the register "Revenue and cost of sales".
//
// Parameters:
//	DocumentRef - DocumentRef - a link to the document for which you need to fill out the line of business in the revenue register.
//
Procedure RecordRevenueAmounts(DocumentRef) Export
	
	QueryFields = PrepareRequestFieldsForFillingInLinesOfBusiness();
	
	Query = PrepareRequestToFillInLinesOfBusiness(DocumentRef, QueryFields);
	
	If Query = Undefined Then
		Return;
	EndIf;
	
	Query.Text =
	"SELECT
	|	T.RecNo,
	|	RECORDAUTONUMBER() AS DistributionRecordNumber,
	|	CASE
	|		WHEN T.LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness
	|			THEN T.LineOfBusinessAllocationMethod
	|		ELSE
	|			ISNULL(Directions.Ref, VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN T.LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness
	|			THEN 1
	|		ELSE
	|			ISNULL(DistributionMethods.ZoomRatio, 1)
	|	END AS ZoomRatio
	|INTO TTCoefficientsPreliminary
	|FROM
	|	TTDistributionMethods AS T
	|	LEFT JOIN Catalog.AllocationMethodsByLinesOfBusiness.LinesOfBusiness AS DistributionMethods
	|		ON T.LineOfBusinessAllocationMethod = DistributionMethods.Ref
	|	LEFT JOIN Catalog.LinesOfBusiness AS Directions
	|		ON DistributionMethods.LineOfBusiness = Directions.Ref
	|		 AND Directions.IncomeAccounting
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.RecNo AS RecNo,
	|	MAX(T2.DistributionRecordNumber) AS EntryNumberForKopecks,
	|	T.LineOfBusiness,
	|	T.DistributionRecordNumber,
	|	CAST(CASE WHEN SUM(T.ZoomRatio) = 0
	|		THEN 0
	|		ELSE T.ZoomRatio / SUM(T2.ZoomRatio)
	|	END AS NUMBER (29,10)) AS ZoomRatio
	|INTO TTCoefficients
	|FROM
	|	TTCoefficientsPreliminary AS T
	|	LEFT JOIN TTCoefficientsPreliminary AS T2
	|		ON T.RecNo = T2.RecNo
	|GROUP BY
	|	T.RecNo,
	|	T.LineOfBusiness,
	|	T.DistributionRecordNumber,
	|	T.ZoomRatio
	|HAVING
	|	SUM(T.ZoomRatio) > 0
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.RecNo AS RecNo,
	|	Coefficients.DistributionRecordNumber,
	|	Coefficients.DistributionRecordNumber = Coefficients.EntryNumberForKopecks AS ForDeviations,
	|	Coefficients.LineOfBusiness AS LineOfBusiness,
	|	&TextOfShareOfSumFields
	|INTO TTDistributedRegisteredRecordedPreliminary
	|FROM
	|	TTInitialRegisteredRecorded AS T
	|	LEFT JOIN TTCoefficients AS Coefficients
	|		ON T.RecNo = Coefficients.RecNo
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.RecNo AS RecNo,
	|	&TextForRejectingSumFields
	|INTO TTOfDeviation
	|FROM
	|	TTInitialRegisteredRecorded AS T
	|	LEFT JOIN TTDistributedRegisteredRecordedPreliminary AS AmountsDistributed
	|		ON T.RecNo = AmountsDistributed.RecNo
	|GROUP BY
	|	T.RecNo
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Period AS Period,
	|	T.Recorder AS Recorder,
	|	&LineOfBusiness,
	|	&TextTotalsOfSumFields,
	|	&OtherFields
	|FROM
	|	TTInitialRegisteredRecorded AS T
	|	LEFT JOIN TTDistributedRegisteredRecordedPreliminary AS Distributed_RegisteredRecords
	|		ON T.RecNo = Distributed_RegisteredRecords.RecNo
	|	LEFT JOIN TTOfDeviation AS Variances
	|		ON T.RecNo = Variances.RecNo
	|ORDER BY
	|	T.RecNo,
	|	Distributed_RegisteredRecords.DistributionRecordNumber
	|";
	
	Query.Text = StrReplace(Query.Text, "&LineOfBusiness", "Distributed_RegisteredRecords.LineOfBusiness AS " + QueryFields.TextLineOfBusiness);
	Query.Text = StrReplace(Query.Text, "&SumFields_", QueryFields.TextSumFields);
	Query.Text = StrReplace(Query.Text, "&TextOfShareOfSumFields", QueryFields.TextOfShareOfSumFields);
	Query.Text = StrReplace(Query.Text, "&TextForRejectingSumFields", QueryFields.TextForRejectingSumFields);
	Query.Text = StrReplace(Query.Text, "&TextTotalsOfSumFields", QueryFields.TextTotalsOfSumFields);
	Query.Text = StrReplace(Query.Text, "&OtherFields", QueryFields.TextOtherFields);
	
	RegisterRecordTable = Query.Execute().Unload();
	
	RecordSet = AccumulationRegisters.RevenueAndCOGS.CreateRecordSet();
	RecordSet.AdditionalProperties.Insert("DeferredPosting");
	RecordSet.AdditionalProperties.Insert("ControlTables");
	RecordSet.AdditionalProperties.Insert("TempTablesManager", New TempTablesManager);
	RecordSet.Filter.Recorder.Set(DocumentRef);
	
	RecordSet.Load(RegisterRecordTable);
	
	RecordSet.Write();
	
EndProcedure

// Prepares a request to fill in the activities of the counterparty in the movements of the document in the register "Revenue and cost of sales".
//
// Parameters:
//	DocumentRef - DocumentRef - a link to the document for which you need to fill out the line of business in the revenue register.
//	QueryFields - See CostCalculationCostAdjustment.PrepareRequestFieldsForFillingInLinesOfBusiness 
//	ReportMode - Boolean - indicates whether the method is called from the "Revenue and cost of Sales" register form.
//
// Returns:
//	Query, Undefined - returns an undefined value if no allocation is required
//
Function PrepareRequestToFillInLinesOfBusiness(DocumentRef, QueryFields = Undefined, ReportMode = False) Export
	
	If QueryFields = Undefined Then
		QueryFields = PrepareRequestFieldsForFillingInLinesOfBusiness();
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	Query.SetParameter("DocumentRef", DocumentRef);
	Query.SetParameter("ReportMode", ReportMode);
	
	Query.Text =
	"SELECT
	|	T.LineNumber AS RecNo,
	|	(&ReportMode OR &LineOfBusiness = VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		AND NOT T.LotCalculation AND NOT T.CalculationOfCost AS FillInLineOfBusiness,
	|	T.Period AS Period,
	|	T.Recorder AS Recorder,
	|	T.ItemsLocationAttributes.Products AS Products,
	|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	CASE
	|		WHEN T.Warehouse REFS Catalog.Warehouses
	|		  AND T.Warehouse <> VALUE(Catalog.Warehouses.EmptyRef)
	|			THEN T.Warehouse
	|		WHEN T.ItemsLocationAttributes.StorageLocation REFS Catalog.Warehouses
	|		  AND T.ItemsLocationAttributes.StorageLocation <> VALUE(Catalog.Warehouses.EmptyRef)
	|			THEN T.ItemsLocationAttributes.StorageLocation
	|			ELSE VALUE(Catalog.Warehouses.EmptyRef)
	|	END AS WarehouseForDistribution,
	|	T.AccountingDimensionByPartners.Organization AS Organization,
	|	T.AccountingDimensionByPartners.Partner AS Partner,
	|	&LineOfBusiness AS LineOfBusiness,
	|	&SumFields_,
	|	&OtherFields
	|INTO TTInitialRegisteredRecorded
	|FROM
	|	AccumulationRegister.RevenueAndCOGS AS T
	|WHERE
	|	T.Recorder = &DocumentRef
	|
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT 
	|	MIN(T.Period) AS Period
	|FROM
	|	TTInitialRegisteredRecorded AS T
	|WHERE
	|	T.FillInLineOfBusiness
	|";
	
	Query.Text = StrReplace(Query.Text, "&LineOfBusiness", "T." + QueryFields.TextLineOfBusiness);
	Query.Text = StrReplace(Query.Text, "&SumFields_", QueryFields.TextSumFields);
	Query.Text = StrReplace(Query.Text, "&OtherFields", QueryFields.TextOtherFields);
	
	Selection = Query.Execute().Select();
	
	If Not Selection.Next() Or Not ValueIsFilled(Selection.Period) Then
		Return Undefined;
	EndIf;
	
	Query.SetParameter("Period", BegOfMonth(Selection.Period));
	
	Query.Text =
	"SELECT DISTINCT
	|	T.Organization
	|FROM
	|	TTInitialRegisteredRecorded AS T
	|";
	
	CompaniesForDistribution = Query.Execute().Unload().UnloadColumn("Organization"); // Array
	CompaniesForDistribution.Add(Catalogs.Companies.EmptyRef());
	
	Query.SetParameter("CompaniesForDistribution", CompaniesForDistribution);
	
	// A similar distribution logic is used in the distribution of hand-held activity directions()
	Query.Text =
	"SELECT
	|	T.LineOfBusinessAllocationMethod,
	|	T.Partner,
	|	T.Products,
	|	T.Warehouse,
	|	T.Department,
	|	T.Organization
	|INTO TTDistributionSettings
	|FROM
	|	InformationRegister.SetUpAllocationByLinesOfBusiness.SliceLast(
	|		&Period,
	|		Used
	|		AND Organization IN (&CompaniesForDistribution)
	|		AND ((LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness
	|			AND LineOfBusinessAllocationMethod <> VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|			)
	|		  OR
	|     			(LineOfBusinessAllocationMethod REFS Catalog.AllocationMethodsByLinesOfBusiness
	|    		 AND CAST(LineOfBusinessAllocationMethod AS Catalog.AllocationMethodsByLinesOfBusiness).AllocatedAccordingToRule = VALUE(Enum.AllocationRulesByLinesOfBusiness.InProportionToFactors))
	|  		  )
	|	) AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|   RevenueTable.RecNo,
	|	SettingUpDistribution.LineOfBusinessAllocationMethod AS LineOfBusinessAllocationMethod,
	|	CASE
	|		WHEN RevenueTable.Partner = SettingUpDistribution.Partner
	|			THEN 1000000
	|			ELSE 0
	|	END AS PartnerPriority,
	|	CASE
	|		WHEN RevenueTable.Partner <> SettingUpDistribution.Partner
	|		 AND RevenueTable.Partner = SegmentPartners.Partner
	|			THEN 100000
	|			ELSE 0
	|	END AS PriorityPartnerSegment,
	|	CASE
	|		WHEN RevenueTable.Products = SettingUpDistribution.Products
	|			THEN 10000
	|			ELSE 0
	|	END AS PriorityItem,
	|	CASE
	|		WHEN RevenueTable.Products <> SettingUpDistribution.Products
	|		 AND RevenueTable.Products = SegmentProducts.Products
	|			THEN 1000
	|			ELSE 0
	|	END AS PriorityInventorySegment,
	|	CASE
	|		WHEN RevenueTable.WarehouseForDistribution = SettingUpDistribution.Warehouse
	|			THEN 100
	|			ELSE 0
	|	END AS PriorityWarehouse,
	|	CASE
	|		WHEN RevenueTable.Department = SettingUpDistribution.Department
	|			THEN 10
	|			ELSE 0
	|	END AS PriorityDivision,
	|	CASE
	|		WHEN RevenueTable.Organization = SettingUpDistribution.Organization
	|			THEN 1
	|			ELSE 0
	|	END AS PriorityCompany,
	|
	|	SettingUpDistribution.Partner,
	|	SegmentPartners.Segment AS PartnerSegment,
	|	SettingUpDistribution.Products,
	|	SegmentProducts.Segment AS ProductSegment,
	|	SettingUpDistribution.Warehouse,
	|	SettingUpDistribution.Department,
	|	SettingUpDistribution.Organization
	|
	|INTO TTDistributionTableInDetail
	|FROM
	|	TTInitialRegisteredRecorded AS RevenueTable
	|	INNER JOIN TTDistributionSettings AS SettingUpDistribution
	|		ON  RevenueTable.FillInLineOfBusiness
	|			AND (RevenueTable.Organization = SettingUpDistribution.Organization
	|				OR SettingUpDistribution.Organization = VALUE(Catalog.Companies.EmptyRef))
	|			AND (RevenueTable.WarehouseForDistribution = SettingUpDistribution.Warehouse
	|				OR SettingUpDistribution.Warehouse = VALUE(Catalog.Warehouses.EmptyRef))
	|			AND (RevenueTable.Department = SettingUpDistribution.Department
	|				OR SettingUpDistribution.Department = VALUE(Catalog.BusinessStructure.EmptyRef))
	|
	|	LEFT JOIN InformationRegister.SegmentPartners AS SegmentPartners
	|		ON SegmentPartners.Segment = SettingUpDistribution.Partner
	|	LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
	|		ON SegmentProducts.Segment = SettingUpDistribution.Products
	|WHERE
	|	RevenueTable.FillInLineOfBusiness
	|	AND (RevenueTable.Partner              = SettingUpDistribution.Partner
	|		OR RevenueTable.Partner         = SegmentPartners.Partner
	|		OR SettingUpDistribution.Partner = UNDEFINED)
	|	AND (RevenueTable.Products              = SettingUpDistribution.Products
	|		OR (RevenueTable.Products        = SegmentProducts.Products
	|		  AND RevenueTable.Characteristic        = SegmentProducts.Characteristic)
	|		OR SettingUpDistribution.Products = UNDEFINED)
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|   T.RecNo,
	|	T.LineOfBusinessAllocationMethod,
	|	T.PartnerPriority + T.PriorityPartnerSegment + T.PriorityDivision
	|		+ T.PriorityItem + T.PriorityInventorySegment
	|		+ T.PriorityWarehouse + T.PriorityCompany AS Priority
	|INTO TTDistributionTable
	|FROM
	|	TTDistributionTableInDetail AS T
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.RecNo,
	|	MAX(T.Priority) AS Priority
	|INTO TTPrioritiesOfDistributionMethods
	|FROM
	|	TTDistributionTable AS T
	|GROUP BY
	|	T.RecNo
	|INDEX BY
	|	RecNo
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.RecNo,
	|	MAX(ISNULL(T.LineOfBusinessAllocationMethod, VALUE(Catalog.LinesOfBusiness.EmptyRef))) AS LineOfBusinessAllocationMethod
	|INTO TTDistributionMethods
	|FROM
	|	TTDistributionTable AS T
	|	INNER JOIN TTPrioritiesOfDistributionMethods AS Priorities
	|		ON T.RecNo = Priorities.RecNo
	|	 	 AND T.Priority = Priorities.Priority
	|GROUP BY
	|	T.RecNo
	|INDEX BY
	|	LineOfBusinessAllocationMethod
	|";
	
	Query.Execute();
	
	Return Query;
	
EndFunction

// Prepares the request fields for filling in the lines of business of the counterparty in the movements of the document according to the register "Revenue and cost of sales".
// 
// Returns:
//  Structure - Prepare The Request Fields For Filling In The Lines of Business:
// * TextLineOfBusiness - String - 
// * TextOtherFields - String - 
// * TextSumFields - String - 
// * TextOfShareOfSumFields - String - 
// * TextForRejectingSumFields - String - 
// * TextTotalsOfSumFields - String - 
Function PrepareRequestFieldsForFillingInLinesOfBusiness() Export
	
	QueryFields = New Structure;
	QueryFields.Insert("TextLineOfBusiness", "CounterpartyLineOfBusiness");
	QueryFields.Insert("TextOtherFields", "");
	QueryFields.Insert("TextSumFields", "");
	QueryFields.Insert("TextOfShareOfSumFields", "");
	QueryFields.Insert("TextForRejectingSumFields", "");
	QueryFields.Insert("TextTotalsOfSumFields", "");
	
	MetaRegister = Metadata.AccumulationRegisters.RevenueAndCOGS;
	
	For Each MetaField In MetaRegister.Dimensions Do
		
		If MetaField.Name = QueryFields.TextLineOfBusiness Then
			Continue;
		EndIf;
		
		QueryFields.TextOtherFields = QueryFields.TextOtherFields + ?(QueryFields.TextOtherFields = "", "", "," + Chars.LF) + "	T." + MetaField.Name;
		
	EndDo;
		
	For Each MetaField In MetaRegister.Resources Do
		
		NumberType = MetaField.Type.NumberQualifiers;
		
		QueryFields.TextSumFields = QueryFields.TextSumFields + ?(QueryFields.TextSumFields = "", "", ",") + Chars.LF + "	T." + MetaField.Name;
		QueryFields.TextOfShareOfSumFields = QueryFields.TextOfShareOfSumFields + ?(QueryFields.TextOfShareOfSumFields = "", "", ",") + Chars.LF
			+ "	CAST(T." + MetaField.Name + " * ISNULL(Coefficients.ZoomRatio, 1) AS NUMBER(" + TrimAll(NumberType.Digits) + ","
			+ TrimAll(NumberType.FractionDigits) + ")) AS " + MetaField.Name;
		QueryFields.TextForRejectingSumFields = QueryFields.TextForRejectingSumFields + ?(QueryFields.TextForRejectingSumFields = "", "", ",") + Chars.LF
			+ "	MAX(T." + MetaField.Name + ") - SUM(AmountsDistributed." + MetaField.Name + ") AS " + MetaField.Name;
		QueryFields.TextTotalsOfSumFields = QueryFields.TextTotalsOfSumFields + ?(QueryFields.TextTotalsOfSumFields = "", "", ",") + Chars.LF
			+ "	Distributed_RegisteredRecords." + MetaField.Name + " + CASE WHEN Distributed_RegisteredRecords.ForDeviations THEN Variances." + MetaField.Name + " ELSE 0 END AS " + MetaField.Name;
			
	EndDo;
	
	For Each MetaField In MetaRegister.Attributes Do
		
		If MetaField.Type.ContainsType(Type("Number")) Then
			
			NumberType = MetaField.Type.NumberQualifiers;
			
			QueryFields.TextSumFields = QueryFields.TextSumFields + ?(QueryFields.TextSumFields = "", "", ",") + Chars.LF + "	T." + MetaField.Name;
			QueryFields.TextOfShareOfSumFields = QueryFields.TextOfShareOfSumFields + ?(QueryFields.TextOfShareOfSumFields = "", "", ",") + Chars.LF
			+ "	CAST(T." + MetaField.Name + " * ISNULL(Coefficients.ZoomRatio, 1) AS NUMBER(" + TrimAll(NumberType.Digits) + ","
				+ TrimAll(NumberType.FractionDigits) + ")) AS " + MetaField.Name;
			QueryFields.TextForRejectingSumFields = QueryFields.TextForRejectingSumFields + ?(QueryFields.TextForRejectingSumFields = "", "", ",") + Chars.LF
				+ "	MAX(T." + MetaField.Name + ") - SUM(AmountsDistributed." + MetaField.Name + ") AS " + MetaField.Name;
			QueryFields.TextTotalsOfSumFields = QueryFields.TextTotalsOfSumFields + ?(QueryFields.TextTotalsOfSumFields = "", "", ",") + Chars.LF
				+ "	Distributed_RegisteredRecords." + MetaField.Name + " + CASE WHEN Distributed_RegisteredRecords.ForDeviations THEN Variances." + MetaField.Name + " ELSE 0 END AS " + MetaField.Name;
			
		Else
			QueryFields.TextOtherFields = QueryFields.TextOtherFields + ?(QueryFields.TextOtherFields = "", "", "," + Chars.LF) + "	T." + MetaField.Name;
		EndIf;
		
	EndDo;
		
	Return QueryFields;
	
EndFunction

