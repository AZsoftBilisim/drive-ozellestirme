	|			+ AdjustmentTable.ItemizedVariableCostsManag END) AS SumMan,
	|	AdjustmentTable.CostOfPersonalIncomeTax AS AITAmount,
	|	AdjustmentTable.Character AS Character
	|
	|INTO RegisteredRecordsAdjustmentTable
