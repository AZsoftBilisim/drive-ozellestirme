Function TextIsInitialCostOfVConstantDifferenceCostPD() // TT is the initial value of a constantresult
	// The query is used to display a temporary table of the initial value of the constant difference in external processing.
	Return "
		|SELECT TOP 0
		|	T.NodeNumber,
		|	T.PermanentDifference
		|INTO InitialCostIsCostPDResultIsConstantDifference
		|FROM
		|	InitialCostConstantDifference AS T
		|";
EndFunction
	
Function TextTableOfSolutionsInDetailMediumSliding() // TableOfSolutionsInDetail
	Return "
		|SELECT
		|	CAST(Nodes.NodeNumber AS NUMBER(31,0)) AS NodeNumber,
		|	Recorders.Ref AS Recorder,
		|	Nodes.VariancePeriod,
		|	Nodes.DistributionPeriod,
		|	Nodes.AccountingSection,
		|	Nodes.Organization,
		|	Nodes.Products,
		|	Nodes.Characteristic,
		|	Nodes.InventoryOwnerAttribute,
		|	Nodes.LineOfBusiness,
		|	Nodes.Department,
		|	Nodes.StorageLocation,
		|	ISNULL(ManSControlWithVAT.CostVariancesIncludingVAT, 0) AS CostVariancesIncludingVAT,
		|	ISNULL(ManagExcludingVAT.CostVariancesExcludingVAT, 0) AS CostVariancesExcludingVAT,
		|	ISNULL(Compl.CostVariancesLocal, 0) AS CostVariancesLocal,
		|	ISNULL(Man.CostVariancesMgmt, 0) AS CostVariancesMgmt,
		|	ISNULL(ManSControlWithVAT.AdditionalExpensesIncludingVAT, 0) AS AdditionalExpensesIncludingVAT,
		|	ISNULL(ManagExcludingVAT.AdditionalExpensesExcludingVAT, 0) AS AdditionalExpensesExcludingVAT,
		|	ISNULL(Compl.AddExpensesLocal, 0) AS AddExpensesLocal,
		|	ISNULL(Man.AddExpensesMan, 0) AS AddExpensesMan,
		|	ISNULL(Compl.VATLocal, 0) AS VATLocal,
		|	ISNULL(Man.VATManag, 0) AS VATManag,
		|	ISNULL(PD.PermanentDifference, 0) AS PermanentDifference,
		|	ISNULL(Compl.CostVariancesLocal, 0)
		|		+ ISNULL(Compl.AddExpensesLocal, 0)
		|		+ ISNULL(Compl.VATLocal, 0)
		|		- ISNULL(TA.CostInTaxAccounting, 0)
		|		- ISNULL(PD.PermanentDifference, 0) AS CostTD,
		|	ISNULL(TA.CostInTaxAccounting, 0) AS CostInTaxAccounting,
		|	ISNULL(TA.AIT, 0) AS AIT,
		|	(CASE
		|		WHEN Compl.NodeNumber IS NULL
		|		 AND ManSControlWithVAT.NodeNumber IS NULL
		|		 AND ManagExcludingVAT.NodeNumber IS NULL
		|		 AND Man.NodeNumber IS NULL
		|		 AND TA.NodeNumber IS NULL
		|		 AND PD.NodeNumber IS NULL
		|			THEN FALSE
		|		ELSE TRUE END) AS ThereIsCost
		|
		|INTO TableOfSolutionsInDetail
		|FROM
		|	TTNodesOfDeviations AS Nodes
		|	LEFT JOIN WithVATDecisionTable AS ManSControlWithVAT
		|		ON ManSControlWithVAT.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TableOfSolutionsWithoutVAT AS ManagExcludingVAT
		|		ON ManagExcludingVAT.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN ManSDecisionTable AS Man
		|		ON Man.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN LocalDecisionTable AS Compl
		|		ON Compl.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TASolutionTable AS TA
		|		ON TA.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TableOfPDSolutions AS PD
		|		ON PD.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TTCostCalculationRecorders AS Recorders
		|		ON Nodes.Organization = Recorders.Organization
		|
		|INDEX BY
		|	NodeNumber
		|";
EndFunction

Function TextTableOfSolutionsOtherExpensesInDetailMediumSlip() // TT of the resolution tablereferencesexternal links
	Return "	
		|SELECT
		|	CAST(Nodes.NodeNumber AS NUMBER(31,0)) AS NodeNumber,
		|	Recorders.Ref AS Recorder,
		|	Nodes.VariancePeriod,
		|	Nodes.DistributionPeriod,
		|
		|	Nodes.Organization AS Organization,
		|	Nodes.Department AS Department,
		|	Nodes.LineOfBusiness AS LineOfBusiness,
		|	Nodes.ExpenseItem AS ExpenseItem,
		|	Nodes.DimensionOfExpenses AS DimensionOfExpenses,
		|	Nodes.Lot AS Lot,
		|	Nodes.ThisIsUnfinishedPRODUCTION AS ThisIsUnfinishedPRODUCTION,
		|
		|	ISNULL(ManSControlWithVAT.CostVariancesIncludingVAT, 0) AS CostVariancesIncludingVAT,
		|	ISNULL(ManagExcludingVAT.CostVariancesExcludingVAT, 0) AS CostVariancesExcludingVAT,
		|	ISNULL(Compl.CostVariancesLocal, 0) AS CostVariancesLocal,
		|	ISNULL(Man.CostVariancesMgmt, 0) AS CostVariancesMgmt,
		|	ISNULL(ManSControlWithVAT.AdditionalExpensesIncludingVAT, 0) AS AdditionalExpensesIncludingVAT,
		|	ISNULL(ManagExcludingVAT.AdditionalExpensesExcludingVAT, 0) AS AdditionalExpensesExcludingVAT,
		|	ISNULL(Compl.AddExpensesLocal, 0) AS AddExpensesLocal,
		|	ISNULL(Man.AddExpensesMan, 0) AS AddExpensesMan,
		|	ISNULL(Compl.VATLocal, 0) AS VATLocal,
		|	ISNULL(Man.VATManag, 0) AS VATManag,
		|	ISNULL(TA.CostInTaxAccounting, 0) AS CostInTaxAccounting,
		|	ISNULL(PD.PermanentDifference, 0) AS PermanentDifference,
		|	ISNULL(TA.AIT, 0) AS AIT,
		|	(CASE
		|		WHEN Compl.NodeNumber IS NULL
		|		 AND ManSControlWithVAT.NodeNumber IS NULL
		|		 AND ManagExcludingVAT.NodeNumber IS NULL
		|		 AND Man.NodeNumber IS NULL
		|		 AND TA.NodeNumber IS NULL
		|		 AND PD.NodeNumber IS NULL
		|			THEN FALSE
		|		ELSE TRUE END) AS ThereIsCost
		|
		|INTO TableOfSolutionsOtherExpensesInDetail
		|FROM
		|	TTNodesOfDeviations AS Nodes
		|	LEFT JOIN WithVATDecisionTable AS ManSControlWithVAT
		|		ON ManSControlWithVAT.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TableOfSolutionsWithoutVAT AS ManagExcludingVAT
		|		ON ManagExcludingVAT.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN ManSDecisionTable AS Man
		|		ON Man.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN LocalDecisionTable AS Compl
		|		ON Compl.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TASolutionTable AS TA
		|		ON TA.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TableOfPDSolutions AS PD
		|		ON PD.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TTCostCalculationRecorders AS Recorders
		|		ON Nodes.Organization = Recorders.Organization
		|WHERE
		|	Nodes.ExpenseItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	AND Nodes.ExpenseItem <> UNDEFINED
		|	AND Nodes.Products = UNDEFINED
		|
		|INDEX BY
		|	Organization,
		|	Department,
		|	ExpenseItem
		|";
EndFunction
Function TextTTIssues() // TTIssues
	Return "
		|SELECT
		|	T.Organization,
		|	T.ItemsLocationAttributes.Products AS Products,
		|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
		|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		|	CASE
		|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
		|			THEN ISNULL(T.ItemsLocationAttributes.Purpose.LineOfBusiness,
		|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
		|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
		|	END AS LineOfBusiness,
		|	CASE
		|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
		|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
		|			THEN T.ItemsLocationAttributes.StorageLocation
		|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
		|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
		|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
		|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|	END AS Department,
		|	CASE
		|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
		|			THEN T.ItemsLocationAttributes.StorageLocation
		|		ELSE UNDEFINED
		|	END AS StorageLocation,
		|	MIN(T.Period) AS Period,
		|	MIN(T.FinRecordID) AS FinRecordID
		|
		|INTO TTIssues
		|FROM
		|	TTCashEstimatedTurnoverCostOfGoods AS T
		|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
		|		ON T.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
		|WHERE
		|	T.Organization IN (&MediumSlipOrganizations)
		|	AND T.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)
		|	AND T.BusinessOperation IN (
		|		VALUE(Enum.BusinessTransactions.ProductsRelease),
		|		VALUE(Enum.BusinessTransactions.ProductsReleaseToWarehouse),
		|		VALUE(Enum.BusinessTransactions.ProductsReleaseToBusinessUnit))
		|	AND T.OfficialTypeOfMovementParish
		|	AND T.Count <> 0
		|	AND &MonthEndClosingMode <> VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
		|
		|GROUP BY
		|	T.Organization,
		|	T.ItemsLocationAttributes.Products,
		|	T.ItemsLocationAttributes.CHARACTERISTIC,
		|	T.InventoryOwnerAttribute,
		|	CASE
		|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
		|			THEN ISNULL(T.ItemsLocationAttributes.Purpose.LineOfBusiness,
		|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
		|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
		|	END, // LineOfBusiness
		|	CASE
		|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
		|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
		|			THEN T.ItemsLocationAttributes.StorageLocation
		|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
		|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
		|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
		|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
		|	END, // Department
		|	CASE
		|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
		|			THEN T.ItemsLocationAttributes.StorageLocation
		|		ELSE UNDEFINED
		|	END // StorageLocation
		|";
EndFunction
Function TextTTIsIrrelevantToRegisteredRecordsPreliminary() // TTIrrelevantRegisteredRecordsPreliminary
	Return "
		|SELECT DISTINCT
		|	TRUE AS ThereAreRegisteredRecords,
		|	T.ThereIsCorPart,
		|	UNDEFINED AS Recorder,
		|	T.Period,
		// Dimensions
		|	T.Organization,
		|	T.Products,
		|	T.Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		|	DATETIME(1,1,1) AS VariancePeriod,
		// Cor Attributes
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		// The field Setting up an economic operation should be filled in the same way as the query textmovementsthe value of goods periods()
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		 OR T.AssetAndLiabilityItem <> UNDEFINED
		|		 AND T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposesVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
		|		 AND T.WriteOffDeviationsToCostOfGoodsSelling
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferOfProductsFromProductionVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.ProductReleaseVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.IntercompanyConsumptionReportSubcontractingServicesDeliveredVariances)
		|		WHEN NOT T.ThereIsCorPart
		|		 AND T.ExpenseItemOfWriteOff <> UNDEFINED
		|		 AND T.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.WriteOffAsExpensesVariances)
		|		ELSE T.BusinessTransactionSetting END) AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		// Resources
		|	0 AS Count,
		|	0 AS CostVariancesIncludingVAT,
		|	0 AS CostVariancesExcludingVAT,
		|	0 AS CostVariancesLocal,
		|	0 AS CostVariancesMgmt,
		|	0 AS AdditionalExpensesIncludingVAT,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	0 AS AddExpensesLocal,
		|	0 AS AddExpensesMan,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	0 AS AIT
		|
		|INTO TTIrrelevantRegisteredRecordsPreliminary
		|FROM
		|	TTRegisteredRecordsOfInventoryCostsByPeriodDetailed AS T
		|
		|UNION ALL
		|
		// Storno of Registered Recorded by the register of "Deviations in the value of goods." There are no such Registered Records in the table of movements of the highest values of goods periodsdetalnye
		|SELECT
		|	TRUE AS ThereAreRegisteredRecords,
		|	T.ThereIsCorPart,
		|	UNDEFINED AS Recorder,
		|	T.Period,
		// Dimensions
		|	T.Organization,
		|	T.Products,
		|	T.Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		|	T.VariancePeriod,
		// Cor Attributes
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		// The field Setting up the business operation should be filled in the same way as the request with the requester = ""1"".
		|	(CASE
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferForOtherPurposes)
		|		 OR T.AssetAndLiabilityItem <> UNDEFINED
		|		 AND T.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferForOtherPurposesVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
		|		 AND T.WriteOffDeviationsToCostOfGoodsSelling
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.TransferOfProductsFromProductionVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.ProductReleaseVariances)
		|		WHEN T.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredIntercompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.IntercompanyConsumptionReportSubcontractingServicesDeliveredVariances)
		|		WHEN NOT T.ThereIsCorPart
		|		 AND T.ExpenseItemOfWriteOff <> UNDEFINED
		|		 AND T.ExpenseItemOfWriteOff <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|		 AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
		|			THEN VALUE(Catalog.BusinessTransactionsSettings.WriteOffAsExpensesVariances)
		|		ELSE T.BusinessTransactionSetting END) AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	&BeginOfPeriod AS DistributionPeriod,
		// Resources
		|	0 AS Count,
		|	0 AS CostVariancesIncludingVAT,
		|	0 AS CostVariancesExcludingVAT,
		|	0 AS CostVariancesLocal,
		|	0 AS CostVariancesMgmt,
		|	0 AS AdditionalExpensesIncludingVAT,
		|	0 AS AdditionalExpensesExcludingVAT,
		|	0 AS AddExpensesLocal,
		|	0 AS AddExpensesMan,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	0 AS PermanentDifference,
		|	0 AS CostTD,
		|	0 AS AIT
		|FROM
		|	TTIsStornoOfDeviationsOfPreviousPeriod AS T
		|
		|UNION ALL
		|
		|SELECT
		|	FALSE AS ThereAreRegisteredRecords,
		|	CASE
		|		WHEN MotionCor.Recorder IS NULL
		|			THEN FALSE 
		|		ELSE TRUE END AS ThereIsCorPart,
		|	Recorders.Ref AS Recorder,
		|	T.Period,
		// Dimensions
		|	T.Organization,
		|	T.Products,
		|	T.Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		|	T.VariancePeriod,
		// Cor Attributes
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		// Resources
		|	-T.Count AS Count,
		|	-T.CostVariancesIncludingVAT AS CostVariancesIncludingVAT,
		|	-T.CostVariancesExcludingVAT AS CostVariancesExcludingVAT,
		|	-T.CostVariancesLocal AS CostVariancesLocal,
		|	-T.CostVariancesMgmt AS CostVariancesMgmt,
		|	-T.AdditionalExpensesIncludingVAT AS AdditionalExpensesIncludingVAT,
		|	-T.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
		|	-T.AddExpensesLocal AS AddExpensesLocal,
		|	-T.AddExpensesMan AS AddExpensesMan,
		|	-T.VATLocal AS VATLocal,
		|	-T.VATManag AS VATManag,
		|	-T.PermanentDifference AS PermanentDifference,
		|	-T.CostTD AS CostTD,
		|	-T.AIT AS AIT
		|FROM
		|	AccumulationRegister.GoodsCostVariances AS T
		|	LEFT JOIN TTCostCalculationRecorders AS Recorders
		|		ON T.Organization = Recorders.Organization
		|	LEFT JOIN AccumulationRegister.GoodsCostVariances AS MotionCor
		|		ON MotionCor.Recorder = T.Recorder
		|		AND MotionCor.Period = T.Period
		|		AND MotionCor.BusinessTransactionSetting = T.BusinessTransactionSetting
		|		AND MotionCor.FinRecordID = T.FinRecordID
		|		AND MotionCor.RecordType = VALUE(AccumulationRecordType.Receipt)
		|		AND MotionCor.CostVariancesIncludingVAT = T.CostVariancesIncludingVAT
		|		AND MotionCor.CostVariancesLocal = T.CostVariancesLocal
		|		AND MotionCor.AdditionalExpensesIncludingVAT = T.AdditionalExpensesIncludingVAT
		|		AND MotionCor.AddExpensesLocal = T.AddExpensesLocal
		|		AND MotionCor.VATLocal = T.VATLocal
		|		AND MotionCor.PermanentDifference = T.PermanentDifference
		|		AND MotionCor.CostTD = T.CostTD
		|WHERE
		|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
		|	AND T.Organization IN (&CompanyArray)
		|	AND T.RecordType = VALUE(AccumulationRecordType.Expense)
		|	AND T.Recorder REFS Document.CostCalculationRecorder
		|	AND NOT T.BusinessOperation IN (
		|		VALUE(Enum.BusinessTransactions.TransferOfVariancesInGoodsCost),
		|		VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold))
		// Storno Registered Recorded movements are excluded in the request for the formation of a temporary table in the movements of the highest values of the goods perioddetalal.
		|	AND NOT T.ReversingEntry
		|";
EndFunction
	
Function TextTTIsIrrelevantToRegisteredRecords() // TTIrrelevantRegisteredRecords
	Return "
		|SELECT DISTINCT
		|	MAX(T.ThereAreRegisteredRecords) AS ThereAreRegisteredRecords,
		|	MAX(T.ThereIsCorPart) AS ThereIsCorPart,
		|	MAX(T.Recorder) AS Recorder,
		|	MAX(T.Period) AS Period,
		// Dimensions
		|	T.Organization,
		|	T.Products,
		|	T.Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		|	MAX(T.VariancePeriod) AS VariancePeriod,
		// Cor Attributes
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
		// Other fields
		|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,
		|	T.ExpenseItemOfWriteOff AS ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses AS DimensionOfExpenses,
		|	T.AssetAndLiabilityItem AS AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
		|	T.GLAccountSettings AS GLAccountSettings,
		|	T.BusinessOperation AS BusinessOperation,
		|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
		|	T.FinRecordID AS FinRecordID,
		|	T.DistributionPeriod AS DistributionPeriod,
		// Resources
		|	SUM(T.Count) AS Count,
		|	SUM(T.CostVariancesIncludingVAT) AS CostVariancesIncludingVAT,
		|	SUM(T.CostVariancesExcludingVAT) AS CostVariancesExcludingVAT,
		|	SUM(T.CostVariancesLocal) AS CostVariancesLocal,
		|	SUM(T.CostVariancesMgmt) AS CostVariancesMgmt,
		|	SUM(T.VATLocal) AS VATLocal,
		|	SUM(T.VATManag) AS VATManag,
		|	SUM(T.AdditionalExpensesIncludingVAT) AS AdditionalExpensesIncludingVAT,
		|	SUM(T.AdditionalExpensesExcludingVAT) AS AdditionalExpensesExcludingVAT,
		|	SUM(T.AddExpensesLocal) AS AddExpensesLocal,
		|	SUM(T.AddExpensesMan) AS AddExpensesMan,
		|	SUM(T.PermanentDifference) AS PermanentDifference,
		|	SUM(T.CostTD) AS CostTD,
		|	SUM(T.AIT) AS AIT
		|
		|INTO TTIrrelevantRegisteredRecords
		|FROM
		|	TTIrrelevantRegisteredRecordsPreliminary AS T
		|
		|GROUP BY
		// Dimensions
		|	T.Organization,
		|	T.Products,
		|	T.Characteristic,
		|	T.InventoryOwnerAttribute,
		|	T.LineOfBusiness,
		|	T.Department,
		|	T.StorageLocation,
		// Cor Attributes
		|	T.CorCompany,
		|	T.CorNomenclature,
		|	T.CorCharacteristics,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorLineOfBusiness,
		|	T.DebitBusinessUnit,
		|	T.BoxStorageLocation,
		// Other fields
		|	T.AccountingDimensionByPartners,
		|	T.ExpenseItemOfWriteOff,
		|	T.DimensionOfExpenses,
		|	T.AssetAndLiabilityItem,
		|	T.AssetsLiabilitiesDimension,
		|	T.GLAccountSettings,
		|	T.BusinessOperation,
		|	T.BusinessTransactionSetting,
		|	T.FinRecordID,
		|	T.DistributionPeriod
		|HAVING
		|	MAX(T.ThereAreRegisteredRecords) = FALSE
		|	AND (SUM(T.CostVariancesIncludingVAT) <> 0
		|		OR SUM(T.CostVariancesExcludingVAT) <> 0
		|		OR SUM(T.CostVariancesLocal) <> 0
		|		OR SUM(T.CostVariancesMgmt) <> 0
		|		OR SUM(T.AdditionalExpensesIncludingVAT) <> 0
		|		OR SUM(T.AdditionalExpensesExcludingVAT) <> 0
		|		OR SUM(T.AddExpensesLocal) <> 0
		|		OR SUM(T.AddExpensesMan) <> 0
		|		OR SUM(T.VATLocal) <> 0
		|		OR SUM(T.VATManag) <> 0
		|		OR SUM(T.PermanentDifference) <> 0
		|		OR SUM(T.CostTD) <> 0
		|		OR SUM(T.AIT) <> 0)
		|";
EndFunction
	
Function TextDistributionOfDeviationsToBalancesMediumSlip()
	Return "
		|SELECT
