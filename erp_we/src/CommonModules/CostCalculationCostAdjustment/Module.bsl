Procedure ComplementStepsWithDataPreparationForFollowingSteps(StageList) Export
	
	StageList.Add("AdjustCostOfReverseCorrectedDocuments");
	StageList.Add("AdjustCostOfAdditionalExpenses_Stage1");
	StageList.Add("AdjustCostOfAdditionalExpenses_Stage2");
	StageList.Add("AdjustCostOfAdditionalExpenses_FormationOfRegisteredRecords");
	StageList.Add("AdjustCostOfPastPeriods");
	StageList.Add("StornoSuspendedProductionCosts");
	StageList.Add("AdjustCostOfWriteOffOfInventory_DataPreparation");
	StageList.Add("AdjustSalesCosts_DataPreparation");
	StageList.Add("WriteOffDeviationsInCostOfGoods_DataPreparation");
	StageList.Add("DistributeDeviationsInCostOfGoods_StornoOfRegisteredRecords");
	StageList.Add("DistributeDeviationsInCostOfGoods_FormationOfRegisteredRecorded");
	
EndProcedure

Procedure RequestTextForStageCalculation(StageName_, CalculationParameters, QueryText) Export
	
	If StageName_ = "AdjustCostOfReverseCorrectedDocuments" Then
		QueryText = TextAdjustCostOfStornoOfRegisteredRecordsOfCorrectedDocuments(CalculationParameters);
	ElsIf StageName_ = "AdjustCostOfAdditionalExpenses_Stage1" Then
		QueryText = TextAdjustCostOfAdditionalExpenses(True);
	ElsIf StageName_ = "AdjustCostOfAdditionalExpenses_Stage2" Then
		QueryText = TextAdjustCostOfAdditionalExpenses(False);
	ElsIf StageName_ = "AdjustCostOfAdditionalExpenses_FormationOfRegisteredRecords" Then
		QueryText = TextAdjustCostOfAdditionalExpensesFormationOfRegisteredRecords();
	ElsIf StageName_ = "AdjustCostOfPastPeriods" Then
		QueryText = TextToAdjustCostOfPastPeriods(CalculationParameters);
	ElsIf StageName_ = "StornoSuspendedProductionCosts" Then
		QueryText = TextOfStornoSuspendedProductionCostsExpense(CalculationParameters);
	ElsIf StageName_ = "AdjustCostOfWriteOffOfInventory_DataPreparation" Then
		QueryText = TextAdjustCostOfInventoryWriteOffPreparingData(CalculationParameters);
	ElsIf StageName_ = "AdjustSalesCosts_DataPreparation" Then
		QueryText = TextAdjustSalesCostsDataPreparation(CalculationParameters);
	ElsIf StageName_ = "WriteOffDeviationsInCostOfGoods_DataPreparation" Then
		QueryText = TextWriteOffDeviationsInCostOfGoodsDataPreparation(CalculationParameters);
	ElsIf StageName_ = "DistributeDeviationsInCostOfGoods_StornoOfRegisteredRecords" Then
		QueryText = TextDistributeDeviationsInCostOfGoodsRefundsAndRegisteredRecordsStorno(CalculationParameters);
	ElsIf StageName_ = "DistributeDeviationsInCostOfGoods_FormationOfRegisteredRecorded" Then
		QueryText = TextDistributeDeviationsInCostOfGoodsFormationOfRegisteredRecords(CalculationParameters);
	EndIf;
	
EndProcedure

