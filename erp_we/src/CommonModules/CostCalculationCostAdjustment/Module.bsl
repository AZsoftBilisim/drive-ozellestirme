// The formation of movements by registers is performed.
// List of outgoing registers See CalculationOfCost.OutgoingMechanismData
//
// Parameters:
//	StartupParameters - Structure - procedure start parameters 
//	CalculationParameters - Structure - the calculation parameters are generated in the calling mechanism.
//	DebugParameters - Structure - It is intended for redefining the properties of the structure of the calculation parameters of the same name.
//		For more information, see explanations in the calculation code of the highest values of the individual algorithms.initializeparameterscountparties to the parameterreferences. 
//
Procedure GenerateRegisteredRecordsByRegisters(StartupParameters, CalculationParameters, DebugParameters) Export
	
	If Not CalculationParameters.UseCostAccounting Then
		Return;
	EndIf;
	
	If DebugParameters = Undefined Then
		DebugParameters = New Structure; // to simplify further access to this property
	EndIf;
	
	StartupParameters.Insert("CostCalculationOnly", False);
	StartupParameters.Insert("ScheduledJob", False);
	StartupParameters.Insert("PreliminaryCalculation", False);
	
	// Initialize the calculation parameters
	InitializeGeneralCostCalculationParameters(StartupParameters, CalculationParameters, DebugParameters);
	
	// Generates Registered Records by registers:
	// - Cost of goods
	// - Other expenses
	// - Other income
	// - Nomenclature movementreferences
	// - Movement Nomenclature Nomenclature
	// - Other active arrays
	// - Deviations in the cost of goods
	AdjustInventoryWriteOffCosts(CalculationParameters);
		
	// Generates Registered Records by registers:
	// - Details of the cost of the product partyreferences
	VATCostCalculation.CalculationOfDeviationOfFIFOIssueMovingAverage(CalculationParameters);
	
	// Generates movements by registers:
	// - Cost of goods
	// - Other expenses
	// - Other non-consummate production costs
	AdjustCostOfWritingOffWorkInProgress22(CalculationParameters);
		
	// Generates movements by registers:
	// - Other expenses
	// - Reserve of current expenses
	AdjustCostOfWritingOffReservesForUpcomingExpenses(CalculationParameters);
		
	// Generates movements by registers:
	// - Other expenses
	// - Cost of goods
	AdjustCostOfAdditionalExpenses(CalculationParameters, False);
	
	// Generates movements by registers:
	// - Other expenses
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpenses Then
		AdjustCostOfOtherWriteOffOfWorkInProgress(CalculationParameters);
	EndIf;
				
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
		"TTValueOfWorkInProgress, TTValueOfWorkInProgressLocal,
		|FutureExpenseCommitments, ReserveMovementDocuments");
	// Generates movements by registers:
	// - Revenue and cost of sales
	// - Purchases
	AdjustCostOfSales(CalculationParameters);
		
	// Generates movements by registers:
	// - Revenue and cost of sales
	// - Other expenses
	// - Movementnotable income expenses
	CalculationOfCostLocalization.IncludeExcludeNDSVCostOfSales(CalculationParameters);
	
	
	// The stage of Formation of movements on the actual expenses of the NDT on the cost of goods and labor costs of Unfinished production.
	// For other expenses, movements are formed at the stage See GenerateRegisteredRecordsByRegistersFinancialResult
	// ,
	//
	// because they require data on cost calculation errors.
	// - Generates movements by registers:
	// - Cost of goods
	// - Labor costinecompleteness of production
// - Actual expenditures and productionsrealization (if expenses are recognized under the object of separate accounting of personal income tax)
	CalculationOfCostLocalization.ToFormRegisterRecordsOfActualExpensesOfLBDpoCostOfGoodsAndLaborCostsOfUnfinishedProduction(CalculationParameters);
	
	// Generates Registered Records by registers:
	// - Deviations in the value of goods
	// - Revenue and cost of sales
	// - Other expenses
	// - Other non-consummate production costs
	DistributeDeviationsInCostOfGoods(CalculationParameters);
	
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, "CostOfGNZP");
	
	// We record the movements (if the cost calculation is started independently, and not as a batch calculation stage)
	CostCalculationAppliedAlgorithms.RecordGeneratedRegisteredRecords(
		CalculationParameters,
		DebugParameters.CalculationProtocols);

EndProcedure
	
// The formation of movements by registers is performed.
// List of outgoing registers See CalculationOfCost.OutgoingMechanismData
//
// Parameters:
//	StartupParameters - Structure - procedure start parameters 
//	CalculationParameters - Structure - the calculation parameters are generated in the calling mechanism.
//	DebugParameters - Structure - It is intended for redefining the properties of the structure of the calculation parameters of the same name.
//		For more information, see explanations in the calculation code of the highest values of the individual algorithms.initializeparameterscountparties to the parameterreferences. 
//
Procedure GenerateRegisteredRecordsByRegistersFinancialResult(StartupParameters, CalculationParameters, DebugParameters) Export
	
	If Not CalculationParameters.UseCostAccounting Then
		Return;
	EndIf;
	
	If DebugParameters = Undefined Then
		DebugParameters = New Structure; // to simplify further access to this property
	EndIf;
	
	StartupParameters.Insert("CostCalculationOnly", False);
	StartupParameters.Insert("ScheduledJob", False);
	StartupParameters.Insert("PreliminaryCalculation", False);
	
	// Initialize the calculation parameters
	InitializeGeneralCostCalculationParameters(StartupParameters, CalculationParameters, DebugParameters);
	
	#Region AdjustingRegisterBalances
	
	// We perform the operations of adjusting the Balance of registers at the end of the calculated period:
	// - Write off the Balance of low-value MC
	// - write off the rounding errors of the calculation
	// - write off deviations in Cost that are not rounding errors
	
	
	If CalculationParameters.LESSolutionErrors.ErrorValueCostLocal > 0
	 Or CalculationParameters.LESSolutionErrors.ErrorValueCostOfMan > 0
	 Or CalculationParameters.LESSolutionErrors.ValueOfErrorCostsRegl > 0
	 Or CalculationParameters.LESSolutionErrors.ErrorValueManCosts > 0 Then
		// Generates movements by registers:
		// - Cost of goods
		// - Other expenses
		// - Other expenses of the perfected production
		// - Movementnotable income expenses
		// - Movementnomenclature Nomenclature
		WriteOffRoundingErrorsInCostCalculation(CalculationParameters);
	EndIf;

	// Generates Registered Records by registers:
	// - Cost of goods
	// - Other income
	// - Other expenses
	WriteOffDeviationsInCostOfItems(CalculationParameters);
	
	#EndRegion
	
	// AIT is the stage of Formation of Registered Records for actual expenses and other expenses.
	// It is made separately from the cost of goods and labor costs of Unfinished (See GenerateRegisteredRecordsByRegisters) 
	// production , 
	//
	// because for other expenses, data on cost calculation errors are needed.
	// - Generates Registered Records by registers:
	// - Other expenses
// - Actual expenditures and productionsrealization (if expenses are recognized under AIT separate accounting item)
	CalculationOfCostLocalization.GenerateRegisterRecordsForActualExpensesLBDpoAndOtherExpenses(CalculationParameters);
	
	// Generates deviations in the Registered Records in the registers relative to previous calculations
	CalculatingDifferenceFromPreviousCalculations(CalculationParameters);
	
	If CalculationParameters.FederalDistrict.GenerateFinancialResult Then
		// Generates movements by registers:
		// - Financial results
		DistributeRevenueByLineOfBusiness(CalculationParameters);
	EndIf;
	
	// Generates movements by registers:
	// - Other active arrays
	ReflectGainsAndLosses(CalculationParameters);
	
	// Stage Allocation of expenses for future periods
	// Generates movements by registers;
	// - Other expenses
	CostCalculationItemizedCosts.AllocateExpensesForFuturePeriods(CalculationParameters);
	
	If CalculationParameters.FederalDistrict.UseBalanceSheetStatement Then
		// Forms the movements of the management balance
		ReflectInManagementBalanceSheet(CalculationParameters);
	EndIf;
	
	// We record the movements (if the cost calculation is started independently, and not as a batch calculation stage)
	CostCalculationAppliedAlgorithms.RecordGeneratedRegisteredRecords(
		CalculationParameters,
		DebugParameters.CalculationProtocols);
	
EndProcedure

#EndRegion

