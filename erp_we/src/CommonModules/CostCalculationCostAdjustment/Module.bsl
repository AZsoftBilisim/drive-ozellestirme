	DescriptionOfTT.NameOfSourceTT = "TTRegisteredRecordsOtherAssetsLiabilities";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	#EndRegion
	
	#Region DeviationsInCostOfMovementOnOtherAssetsLiabilities
	
	Query.Text = "
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	// Dimensions
	|	DD.Organization,
	|	DD.Department,
	|	DD.CorLineOfBusiness AS LineOfBusiness,
	|	DD.AssetAndLiabilityItem AS AssetRef,
	|	DD.AssetsLiabilitiesDimension AS Dimension,
	|	DD.GLAccountSettings AS GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
	// Resources
	|	(DD.Cost
	|		+ DD.AddExpensesForGoods
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsIncludingVAT
	|		+ DD.ItemizedVariableCostsIncludingVAT) AS AmountIncludingVAT,
	|	(DD.CostExcludingVAT
	|		+ DD.AdditionalExpensesExcludingVAT
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsExcludingVAT
	|		+ DD.ItemizedVariableCostsExcludingVAT) AS AmountExcludingVAT,
	|	(DD.LocalCost
	|		+ DD.AddExpensesLocal
	|		+ DD.LaborCostsLocal
	|		+ DD.ItemizedFixedCostsCompl
	|		+ DD.ItemizedVariableCostsCompl
	|		+ DD.ProvisionForImpairmentLocal) AS SumCompl,
	|	(DD.CostMan
	|		+ DD.AddExpensesMan
	|		+ DD.LaborCostsMan
	|		+ DD.ItemizedFixedCostsManag
	|		+ DD.ItemizedVariableCostsManag
	|		+ DD.ProvisionForImpairmentMan) AS SumMan,
	// Attributes
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	DD.FinRecordID AS FinRecordID
	|
	|INTO TTRegisteredRecordsInOtherAssetsLiabilities
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|WHERE
	|	DD.EntryType = VALUE(Enum.LotRecordTypes.GoodsCostVarianceForOtherExpenses)
	|	AND DD.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	|	AND DD.ExpenseItemOfWriteOff = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	AND DD.LotCalculation
	|	AND NOT DD.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT
	|	DD.Period AS Period,
	|	DD.Recorder AS Recorder,
	// Dimensions
	|	DD.Organization,
	|	DD.Department,
	|	DD.CorLineOfBusiness AS LineOfBusiness,
	|	DD.AssetAndLiabilityItem AS AssetRef,
	|	DD.AssetsLiabilitiesDimension AS Dimension,
	|	DD.GLAccountSettings AS GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Credit) AS DebitCredit,
	// Resources
	|	-(DD.Cost
	|		+ DD.AddExpensesForGoods
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsIncludingVAT
	|		+ DD.ItemizedVariableCostsIncludingVAT) AS AmountIncludingVAT,
	|	-(DD.CostExcludingVAT
	|		+ DD.AdditionalExpensesExcludingVAT
	|		+ DD.LaborCosts
	|		+ DD.ItemizedFixedCostsExcludingVAT
	|		+ DD.ItemizedVariableCostsExcludingVAT) AS AmountExcludingVAT,
	|	-(DD.LocalCost
	|		+ DD.AddExpensesLocal
	|		+ DD.LaborCostsLocal
	|		+ DD.ItemizedFixedCostsCompl
	|		+ DD.ItemizedVariableCostsCompl
	|		+ DD.ProvisionForImpairmentLocal) AS SumCompl,
	|	-(DD.CostMan
	|		+ DD.AddExpensesMan
	|		+ DD.LaborCostsMan
	|		+ DD.ItemizedFixedCostsManag
	|		+ DD.ItemizedVariableCostsManag
	|		+ DD.ProvisionForImpairmentMan) AS SumMan,
	// Attributes
	|	DD.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	DD.FinRecordID AS FinRecordID
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|WHERE
	|	DD.EntryType = VALUE(Enum.LotRecordTypes.CostVarianceForOtherIncome)
	|	AND DD.AssetAndLiabilityItem <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	|	AND DD.IncomeItem = VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef)
	|	AND DD.LotCalculation
	|	AND NOT DD.ReversingEntry
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherAssetsAndLiabilitiesRecords.Name, "DeviationsInCost");
	DescriptionOfTT.NameOfSourceTT = "TTRegisteredRecordsInOtherAssetsLiabilities";

	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	#EndRegion
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);	
	
EndProcedure

// Stage 3.17
Procedure AdjustCostOfSales(CalculationParameters) Export

	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
#Region DataSelection
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustSalesCosts_DataPreparation");
	
	If StrFind(ExistingTT, "CorrectedDocuments_") = 0 Then 
		// tue Corrected documents
		Query.Text = CostCalculationFillingInformationAboutLots.TextCorrectedDocuments() + ";";
		CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	EndIf;
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"TTSales, TTCostPrice");
	
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextAdjustSalesCostsDataPreparation(CalculationParameters));
	
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
	
#EndRegion
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfSales_FormationOfRegisteredRecords");
	
#Region DataDistribution
	
	// Initializing the distribution
	LinkFields = "Period, Recorder, ItemsLocationAttributes, InventoryOwnerAttribute, Organization, AccountingSection, Lot, LotVendorAttributes,
		|FinancialAccountingDimension, VATActivityType, SalesOrder, AccountingDimensionByPartners, FinRecordID, Character, ReversingEntry";
	DistributionParameters = CostCalculationUniversalAlgorithms.InitializeDistributionParametersUsingReducedRemainderMethod(
		"TTCostPrice",
		"TTSales",
		LinkFields);
	
	RegisterDescription = CalculationParameters.RegisterRecords[Metadata.AccumulationRegisters.InventoryCost.Name]; // register description
	
	AllocatedResources = CostCalculationUniversalAlgorithms.RemoveElementsFromTemplateString(
		RegisterDescription.RegisterResources,
		"%1Count, %1CostOfPersonalIncomeTax");
	
	CostCalculationUniversalAlgorithms.InitializeNumericalDistributionFieldsUsingReducedRemainderMethod(
		DistributionParameters,
		StringFunctionsClientServer.SubstituteParametersToString(AllocatedResources, ""));
		
	OtherDatabaseFields = "Partner, Counterparty, Department, InventoryType, Manager, Warehouse, Terms, Contract, BusinessOperation,
		|VATTaxation, ARAPCurrency, DocumentCurrency, SourceOfProductFinancialAccountingGroup, SourceOfARAPFinancialAccountingGroup,
		|SetAccountingDimension, CounterpartyLineOfBusiness, ProductLineOfBusiness,
		|BusinessTransactionSetting, DocumentCalculation, VATRate, InventoryValuationMethod, AdjustmentPeriod_,
		// The original calculated amounts from the previous calculation.
		|InitialCost_, InitialValueWithoutVAT, InitialAdditionalExpenseAmount, InitialAdditionalExpensesAmountExcludingVAT, Initial_LaborCosts,
		|InitialLocalCost, InitialAdditionalExpensingLocal, InitialLaborCostsLocal,
		|InitialArticleByArticleConstantsWithVAT, OriginalItemizedFixedCostExclVAT, OriginalItemizedFixedLocal,
		|InitialArticleByArticleVariablesWithVAT, OriginalItemizedVariableExclVAT, OriginalItemizedVariableLocal,
		|InitialCostedPDDifferenceIsConstantOne, InitialCostTDOfTimeIsFollowing,
		|InitialOffBalanceCost, OriginalOffBalanceCostedLocal, InitialReserveForImpairmentOfLocal, InitialReserveForImpairmentOfMan,
		|InitialCostOfMan, InitialAdditionalExpensesManags, InitialLaborCostsManag, OriginalItemizedFixedMan, OriginalItemizedvariableSCostingManag";
	
	CostCalculationUniversalAlgorithms.InitializeOtherDistributionFieldsUsingReducedRemainderMethod(
		DistributionParameters,
		,
		OtherDatabaseFields);
		
	// We distribute
	CostCalculationUniversalAlgorithms.DistributeUsingReducedRemainderMethod(Query.TempTablesManager, DistributionParameters);
	
	// We will adjust the cost taking into account the initial calculated movements.
	Query.Text = "
	|SELECT
	|	T.KeyTI,
	|	T.TBKey,
	|	T.Period,
	|	T.Recorder,
	|	T.ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute,
	|	T.Organization,
	|	T.AccountingSection,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	T.SalesOrder,
	|	T.AccountingDimensionByPartners,
	|	T.FinRecordID,
	|	T.Character,
	|	T.ReversingEntry,
	|	T.VATRate,
	|	T.Partner,
	|	T.Counterparty,
	|	T.Department,
	|	T.InventoryType,
	|	T.Manager,
	|	T.Warehouse,
	|	T.Terms,
	|	T.Contract,
	|	T.BusinessOperation,
	|	T.VATTaxation,
	|	T.ARAPCurrency,
	|	T.DocumentCurrency,
	|	T.SourceOfProductFinancialAccountingGroup,
	|	T.SourceOfARAPFinancialAccountingGroup,
	|	T.SetAccountingDimension,
	|	T.CounterpartyLineOfBusiness,
	|	T.ProductLineOfBusiness,
	|	T.BusinessTransactionSetting,
	|	T.DocumentCalculation,
	|	T.InventoryValuationMethod,
	|	T.AdjustmentPeriod_,
	|	T.Count,
	|	T.Cost - T.InitialCost_										AS Cost,
	|	T.CostExcludingVAT - T.InitialValueWithoutVAT							AS CostExcludingVAT,
	|	T.OffBalanceCost - T.InitialOffBalanceCost				AS OffBalanceCost,
	|	T.AddExpensesForGoods - T.InitialAdditionalExpenseAmount										AS AddExpensesForGoods,
	|	T.AdditionalExpensesExcludingVAT - T.InitialAdditionalExpensesAmountExcludingVAT							AS AdditionalExpensesExcludingVAT,
	|	T.LaborCosts - T.Initial_LaborCosts									AS LaborCosts,
	|	T.ItemizedFixedCostsIncludingVAT - T.InitialArticleByArticleConstantsWithVAT		AS ItemizedFixedCostsIncludingVAT,
	|	T.ItemizedVariableCostsIncludingVAT - T.InitialArticleByArticleVariablesWithVAT		AS ItemizedVariableCostsIncludingVAT,
	|	T.ItemizedFixedCostsExcludingVAT - T.OriginalItemizedFixedCostExclVAT	AS ItemizedFixedCostsExcludingVAT,
	|	T.ItemizedVariableCostsExcludingVAT - T.OriginalItemizedVariableExclVAT	AS ItemizedVariableCostsExcludingVAT,
	|	T.LocalCost - T.InitialLocalCost								AS LocalCost,
	|	T.OffBalanceCostLocal - T.OriginalOffBalanceCostedLocal		AS OffBalanceCostLocal,
	|	T.AddExpensesLocal - T.InitialAdditionalExpensingLocal								AS AddExpensesLocal,
	|	T.LaborCostsLocal - T.InitialLaborCostsLocal							AS LaborCostsLocal,
	|	T.ItemizedFixedCostsCompl - T.OriginalItemizedFixedLocal		AS ItemizedFixedCostsCompl,
	|	T.ItemizedVariableCostsCompl - T.OriginalItemizedVariableLocal		AS ItemizedVariableCostsCompl,
	|	T.PermanentDifference - T.InitialCostedPDDifferenceIsConstantOne						AS PermanentDifference,
	|	T.CostTD - T.InitialCostTDOfTimeIsFollowing							AS CostTD,
	|	T.CostMan - T.InitialCostOfMan									AS CostMan,
	|	T.AddExpensesMan - T.InitialAdditionalExpensesManags								AS AddExpensesMan,
	|	T.LaborCostsMan - T.InitialLaborCostsManag							AS LaborCostsMan,
	|	T.ItemizedFixedCostsManag - T.OriginalItemizedFixedMan			AS ItemizedFixedCostsManag,
	|	T.ItemizedVariableCostsManag - T.OriginalItemizedvariableSCostingManag			AS ItemizedVariableCostsManag,
	|	T.ProvisionForImpairmentLocal - T.InitialReserveForImpairmentOfLocal			AS ProvisionForImpairmentLocal,
	|	T.ProvisionForImpairmentMan - T.InitialReserveForImpairmentOfMan			AS ProvisionForImpairmentMan
	|INTO TTDistributionResultIsFinal
	|FROM TTDistributionResult AS T
	|;";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
#EndRegion
	
	MatchingTemporaryMovementTables = New Map;
	
#Region RevenueAndCOGS
	
	TempTableName = "TTRegisteredRecordsRevenueAndCostOfSales";
	RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTDistributionResultIsFinal");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DocumentRegisterRecords", "Recorder");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "CostTD + ProvisionForImpairmentLocal");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentLocal", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentMan", 0);
	
	RegisterFields = StrSplit(StrReplace(Upper(RegisterDescription.RegisterResources), "%1", ""), ", ", False);
	For Each DescriptionOfRegisterField In FieldDescriptionTable Do
		
		If RegisterFields.Find(DescriptionOfRegisterField.Presentation) = Undefined Then
			Continue; // This is not a resource field - skip
		EndIf;
		
		If DescriptionOfRegisterField.Field = "0" Then
			Continue; // The resource field is not filled in from this request - we skip it
		EndIf;
		
		DescriptionOfRegisterField.Field = "CASE
		|	WHEN BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.ReverseOfSaleReturnToAnotherWarehouse)
		|	THEN -1 ELSE 1 END * (" + DescriptionOfRegisterField.Field + ")";
		
	EndDo;
	
	ConditionWHERE = "InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
		|OR AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductsRelease)";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTDistributionResultIsFinal", TempTableName, ConditionWHERE);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

#Region RevenueAndCostOfSales_WriteOffOfProvisionsForImpairmentOfInventories
	
	TempTableName = "TTRegisteredRecordsRevenueAndCostOfSales_WriteOffOfProvisions";
	RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTDistributionResultIsFinal");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DocumentRegisterRecords", "Recorder");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation", 
		"VALUE(Enum.BusinessTransactions.WriteOffOfInventoryImpairmentProvision)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting", 
		"VALUE(Catalog.BusinessTransactionsSettings.WriteOffOfInventoryImpairmentProvision)");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Cost", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostExcludingVAT", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AddExpensesForGoods", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AdditionalExpensesExcludingVAT", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostMan", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LocalCost", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OffBalanceCost", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OffBalanceCostLocal", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AddExpensesMan", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AddExpensesLocal", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedFixedCostsIncludingVAT", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedFixedCostsExcludingVAT", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedFixedCostsManag", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedFixedCostsCompl", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LaborCosts", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LaborCostsMan", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LaborCostsLocal", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedVariableCostsIncludingVAT", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedVariableCostsExcludingVAT", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedVariableCostsManag", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemizedVariableCostsCompl", 0);
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", 0);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTDistributionResultIsFinal", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

#Region Purchases

	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.Recorder,
	// Dimensions
	|	VALUE(Enum.BusinessTransactions.PurchaseFromAnotherCompany) AS BusinessOperation,
	|	T.Counterparty AS Organization,
	|	T.Department,
	|	T.Manager,
	|	T.ItemsLocationAttributes,
	|	T.Warehouse,
	|	T.InventoryType,
	|	T.InventoryOwnerAttribute,
	|	T.Partner,
	|	T.Organization AS Counterparty,
	|	T.Terms,
	|	T.Contract,
	// Resources
	|	T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT AS Cost,
	|	T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT + T.LaborCosts + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT AS CostExcludingVAT,
	// Attributes
	|	T.DocumentCurrency,
	|	T.ARAPCurrency,
	|	T.Recorder AS DocumentRegisterRecords,
	|	T.SourceOfProductFinancialAccountingGroup,
	|	T.SourceOfARAPFinancialAccountingGroup,
	|	T.ReversingEntry
	|INTO TTMovementPurchasingTable
	|FROM
	|	TTDistributionResultIsFinal AS T
	|WHERE
	|	T.BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
	|	AND T.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|";
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);

	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.Purchases.Name);
	DescriptionOfTT.NameOfSourceTT = "TTMovementPurchasingTable";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);

#EndRegion
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	ExistingTT = CostCalculationUniversalAlgorithms.ConnectLines(ExistingTT, "CorrectedDocuments_");
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);
	
EndProcedure

Function TextAdjustSalesCostsDataPreparation(CalculationParameters) Export
	
	QueryText = "";
	
	#Region TTAdjustmentTable
	QueryText = QueryText + "
	|SELECT
	|	Sales.Period                     AS Period,
	|	Sales.AdjustmentPeriod_        AS AdjustmentPeriod_,
	|	Sales.Recorder                AS Recorder,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END) AS DocumentCalculation,
	|	PartnerAnalytics_.Organization     AS Organization,
	|	Sales.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	Sales.SalesOrder               AS SalesOrder,
	|	Sales.AccountingDimensionByPartners  AS AccountingDimensionByPartners,
	|	PartnerAnalytics_.Partner         AS Partner,
	|	PartnerAnalytics_.Counterparty      AS Counterparty,
	|	Sales.Department              AS Department,
	|	Sales.InventoryType                 AS InventoryType,
	|	Sales.InventoryOwnerAttribute                 AS InventoryOwnerAttribute,
	|	Sales.Manager                   AS Manager,
	|	Sales.Warehouse                      AS Warehouse,
	|	Sales.Terms                 AS Terms,
	|	Sales.Contract                    AS Contract,
	|	Sales.BusinessOperation      AS BusinessOperation,
	|	Sales.VATTaxation         AS VATTaxation,
	|	Sales.ARAPCurrency       AS ARAPCurrency,
	|	Sales.DocumentCurrency            AS DocumentCurrency,
	|	Sales.SourceOfProductFinancialAccountingGroup    AS SourceOfProductFinancialAccountingGroup,
	|	Sales.SourceOfARAPFinancialAccountingGroup        AS SourceOfARAPFinancialAccountingGroup,
	|	Sales.SetAccountingDimension      AS SetAccountingDimension,
	|	Sales.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	|	Sales.ProductLineOfBusiness AS ProductLineOfBusiness,
	|	CASE WHEN &BatchAccountingVersion22 THEN
	|		Sales.AccountingSection
	|	WHEN Sales.BusinessOperation = VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit) 
	|		AND Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitReceivedByCommissionAgent)
	|	WHEN Sales.BusinessOperation = VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit) 
	|		AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitTransferredToCommissionAgent)
	|	WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
	|	WHEN Sales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleWithDeferredTransferOfTitle) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Partner) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Organization) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent)
	|	WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.OperationService)
	|	 OR Sales.InventoryType = VALUE(Enum.InventoryTypes.Work_5) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|	 AND ISNULL(Dimension.WarehouseArea.ShopFloorStockroom, FALSE) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	ELSE
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
	|	END AS AccountingSection,
	|	Sales.Lot 					   AS Lot,
	|	Sales.LotVendorAttributes 	   AS LotVendorAttributes,
	|	(CASE
	|		WHEN PartnerAnalytics_.Organization IN (&MediumSlipOrganizations)
	|			THEN UNDEFINED
	|		ELSE Sales.FinancialAccountingDimension END) AS FinancialAccountingDimension,
	|	(CASE
	|		WHEN &BatchAccountingVersion22 AND NOT PartnerAnalytics_.Organization IN (&MediumSlipOrganizations)
	|			THEN Sales.VATActivityType
	|		ELSE VALUE(Enum.VATTaxationTypes.EmptyRef)
	|	END) AS VATActivityType,
	|	Sales.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	(CASE
	|		WHEN &BatchAccountingVersion22 THEN Sales.FinRecordID
	|		ELSE """" END) AS FinRecordID,
	// For organizations on a medium-slip line, the Storno sign is not filled in, because Registered Records are generated under the service
	// document "Cost Calculation Registrar" and these are estimated Registered Records, and not storno Registered Records of the corrected document.
	|	(CASE
	|		WHEN PartnerAnalytics_.Organization IN (&MediumSlipOrganizations)
	|			THEN FALSE
	|		ELSE Sales.ReversingEntry END) AS ReversingEntry,
	|	Sales.VATRate AS VATRate,
	|	TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod AS InventoryValuationMethod,
	|	(CASE
	|		WHEN Sales.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.ReverseOfSale))
	|		 OR SUM(Sales.Count) < 0
	|			THEN -1
	|		ELSE 1 END) AS Character,
	|	Sales.CalculationOfCost AS CalculationOfCost,
	|	SUM(Sales.Count)          AS Count,
	// Initial estimated costs.
	|	SUM(Sales.Cost)					AS Cost,
	|	SUM(Sales.CostExcludingVAT)				AS CostExcludingVAT,
	|	SUM(Sales.LocalCost)				AS LocalCost,
	|	SUM(Sales.AddExpensesForGoods)					AS AddExpensesForGoods,
	|	SUM(Sales.AdditionalExpensesExcludingVAT)				AS AdditionalExpensesExcludingVAT,
	|	SUM(Sales.AddExpensesLocal)				AS AddExpensesLocal,
	|	SUM(Sales.LaborCosts)					AS LaborCosts,
	|	SUM(Sales.LaborCostsLocal)				AS LaborCostsLocal,
	|	SUM(Sales.ItemizedFixedCostsIncludingVAT)	AS ItemizedFixedCostsIncludingVAT,
	|	SUM(Sales.ItemizedFixedCostsExcludingVAT)	AS ItemizedFixedCostsExcludingVAT,
	|	SUM(Sales.ItemizedFixedCostsCompl)	AS ItemizedFixedCostsCompl,
	|	SUM(Sales.ItemizedVariableCostsIncludingVAT)	AS ItemizedVariableCostsIncludingVAT,
	|	SUM(Sales.ItemizedVariableCostsExcludingVAT)	AS ItemizedVariableCostsExcludingVAT,
	|	SUM(Sales.ItemizedVariableCostsCompl)	AS ItemizedVariableCostsCompl,
	|	SUM(Sales.PermanentDifference)			AS PermanentDifference,
	|	SUM(Sales.CostTD)				AS CostTD,
	|	SUM(Sales.OffBalanceCost)		AS OffBalanceCost,
	|	SUM(Sales.OffBalanceCostLocal)	AS OffBalanceCostLocal,
	|	SUM(Sales.ProvisionForImpairmentLocal)		AS ProvisionForImpairmentLocal,
	|	SUM(Sales.ProvisionForImpairmentMan)		AS ProvisionForImpairmentMan,
	|	SUM(Sales.CostMan)					AS CostMan,
	|	SUM(Sales.AddExpensesMan)				AS AddExpensesMan,
	|	SUM(Sales.LaborCostsMan)				AS LaborCostsMan,
	|	SUM(Sales.ItemizedFixedCostsManag)		AS ItemizedFixedCostsManag,
	|	SUM(Sales.ItemizedVariableCostsManag)		AS ItemizedVariableCostsManag
	|INTO TTAdjustmentTable
	|FROM
	|	TTCashEstimatedTurnoverRevenueAndCostOfSales AS Sales
	|	INNER JOIN TTPartnerAnalyticsSelection AS PartnerAnalytics_
	|		ON Sales.AccountingDimensionByPartners = PartnerAnalytics_.DimensionKey
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON PartnerAnalytics_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|	INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON Dimension.Ref = Sales.ItemsLocationAttributes
	|	LEFT JOIN CalculatedDocuments AS CalculatedDocuments
	|		ON CalculatedDocuments.Period = Sales.Period
	|		AND CalculatedDocuments.Recorder = Sales.Recorder
	|		AND &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = PartnerAnalytics_.Organization
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = Sales.Recorder
	|WHERE
	|	Sales.BusinessOperation IN (&ArrayOfImplementationOperations)
	// During the preliminary calculation, we exclude documents for which previously calculated movements are saved
	|	AND CalculatedDocuments.Recorder IS NULL
	// We exclude From The Registered Records of corrections and corrections of The previous period.
	// Such Registered Records have already been formed in the procedure for correcting the cost of roadmovementsrecorded documents() The area of correction of the cost of goods
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND Sales.ReversingEntry)
	|	
	|GROUP BY
	|	Sales.Period,
	|	Sales.AdjustmentPeriod_,
	|	Sales.Recorder,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END), // DocumentCalculation
	|	Sales.ItemsLocationAttributes,
	|	Sales.SalesOrder,
	|	Sales.AccountingDimensionByPartners,
	|	PartnerAnalytics_.Partner,
	|	PartnerAnalytics_.Counterparty,
	|	Sales.Department,
	|	Sales.InventoryType,
	|	Sales.InventoryOwnerAttribute,
	|	Sales.Manager,
	|	Sales.Warehouse,
	|	Sales.Terms,
	|	Sales.Contract,
	|	Sales.BusinessOperation,
	|	Sales.VATTaxation,
	|	Sales.ARAPCurrency,
	|	Sales.DocumentCurrency,
	|	Sales.SourceOfProductFinancialAccountingGroup,
	|	Sales.SourceOfARAPFinancialAccountingGroup,
	|	Sales.SetAccountingDimension,
	|	Sales.CounterpartyLineOfBusiness,
	|	Sales.ProductLineOfBusiness,
	|	PartnerAnalytics_.Organization,
	|	CASE WHEN &BatchAccountingVersion22 THEN
	|		Sales.AccountingSection
	|	WHEN Sales.BusinessOperation = VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit) 
	|		AND Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitReceivedByCommissionAgent)
	|	WHEN Sales.BusinessOperation = VALUE(Enum.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit) 
	|		AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitTransferredToCommissionAgent)
	|	WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
	|	WHEN Sales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleWithDeferredTransferOfTitle) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Partner) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Organization) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent)
	|	WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.OperationService)
	|	 OR Sales.InventoryType = VALUE(Enum.InventoryTypes.Work_5) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|	 AND ISNULL(Dimension.WarehouseArea.ShopFloorStockroom, FALSE) THEN
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|	ELSE
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
	|	END,
	|	Sales.Lot,
	|	Sales.LotVendorAttributes,
	|	(CASE
	|		WHEN PartnerAnalytics_.Organization IN (&MediumSlipOrganizations)
	|			THEN UNDEFINED
	|		ELSE Sales.FinancialAccountingDimension END), // FinancialAccountingDimension
	|	(CASE
	|		WHEN &BatchAccountingVersion22 AND NOT PartnerAnalytics_.Organization IN (&MediumSlipOrganizations)
	|			THEN Sales.VATActivityType
	|		ELSE VALUE(Enum.VATTaxationTypes.EmptyRef) END), // VATActivityType
	|	(CASE
	|		WHEN Sales.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.ReverseOfSale))
	|			THEN -1
	|		ELSE 1 END), // Character
	|	Sales.BusinessTransactionSetting,
	|	(CASE
	|		WHEN &BatchAccountingVersion22 THEN Sales.FinRecordID
	|		ELSE """" END),
	|	(CASE
	|		WHEN PartnerAnalytics_.Organization IN (&MediumSlipOrganizations)
	|			THEN FALSE
	|		ELSE Sales.ReversingEntry END),
	|	Sales.VATRate,
	|	TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod,
	|	Sales.CalculationOfCost
	|
	|HAVING
	|	SUM(Sales.Count) <> 0
	|;";
	#EndRegion
	
	#Region TTSalesRegistrars
	QueryText = QueryText + "
	|SELECT DISTINCT
	|	AdjustmentTable.Period,
	|	AdjustmentTable.Recorder AS Recorder,
	|	AdjustmentTable.DocumentCalculation
	|
	|INTO TTSalesRegistrars
	|FROM
	|	TTAdjustmentTable AS AdjustmentTable
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	AdjustmentTable.Period,
	|	CalculationLoggers.Ref AS Recorder,
	|	AdjustmentTable.DocumentCalculation
	|FROM
	|	TTAdjustmentTable AS AdjustmentTable
	|	INNER JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = AdjustmentTable.Organization
	|WHERE
	|	AdjustmentTable.Organization IN (&MediumSlipOrganizations)
	|;";
	#EndRegion
	
	#Region TTSales
	QueryText = QueryText + "
	|SELECT
	|	Sales.Period                     AS Period,
	|	Sales.AdjustmentPeriod_        AS AdjustmentPeriod_,
	|	(CASE
	|		WHEN Sales.Organization IN (&MediumSlipOrganizations)
	|			THEN CalculationLoggers.Ref
	|		ELSE Sales.Recorder END) AS Recorder,
	|	Sales.DocumentCalculation            AS DocumentCalculation,
	|	Sales.Organization                AS Organization,
	|	Sales.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	Sales.SalesOrder               AS SalesOrder,
	|	Sales.AccountingDimensionByPartners  AS AccountingDimensionByPartners,
	|	Sales.Partner                    AS Partner,
	|	Sales.Counterparty                 AS Counterparty,
	|	Sales.Department              AS Department,
	|	Sales.InventoryType                 AS InventoryType,
	|	Sales.InventoryOwnerAttribute                 AS InventoryOwnerAttribute,
	|	Sales.Manager                   AS Manager,
	|	Sales.Warehouse                      AS Warehouse,
	|	Sales.Terms                 AS Terms,
	|	Sales.Contract                    AS Contract,
	|	Sales.BusinessOperation      AS BusinessOperation,
	|	Sales.VATTaxation         AS VATTaxation,
	|	Sales.ARAPCurrency       AS ARAPCurrency,
	|	Sales.DocumentCurrency            AS DocumentCurrency,
	|	Sales.SourceOfProductFinancialAccountingGroup    AS SourceOfProductFinancialAccountingGroup,
	|	Sales.SourceOfARAPFinancialAccountingGroup        AS SourceOfARAPFinancialAccountingGroup,
	|	Sales.SetAccountingDimension      AS SetAccountingDimension,
	|	Sales.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	|	Sales.ProductLineOfBusiness AS ProductLineOfBusiness,
	|	Sales.AccountingSection				   AS AccountingSection,
	|	Sales.Lot 					   AS Lot,
	|	Sales.LotVendorAttributes 	   AS LotVendorAttributes,
	|	Sales.FinancialAccountingDimension  AS FinancialAccountingDimension,
	|	Sales.VATActivityType         AS VATActivityType,
	|	Sales.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	Sales.FinRecordID     AS FinRecordID,
	|	Sales.ReversingEntry                     AS ReversingEntry,
	|	Sales.VATRate                  AS VATRate,
	|	Sales.InventoryValuationMethod AS InventoryValuationMethod,
	|	Sales.Character                       AS Character,
	|	SUM(Sales.Count)          AS Count,
	// Initial estimated costs.
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.Cost
	|		ELSE 0
	|	END) AS InitialCost_,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.CostExcludingVAT
	|		ELSE 0
	|	END) AS InitialValueWithoutVAT,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.LocalCost
	|		ELSE 0
	|	END) AS InitialLocalCost,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.AddExpensesForGoods
	|		ELSE 0
	|	END) AS InitialAdditionalExpenseAmount,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.AdditionalExpensesExcludingVAT
	|		ELSE 0
	|	END) AS InitialAdditionalExpensesAmountExcludingVAT,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.AddExpensesLocal
	|		ELSE 0
	|	END) AS InitialAdditionalExpensingLocal,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.LaborCosts
	|		ELSE 0
	|	END) AS Initial_LaborCosts,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.LaborCostsLocal
	|		ELSE 0
	|	END) AS InitialLaborCostsLocal,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedFixedCostsIncludingVAT
	|		ELSE 0
	|	END) AS InitialArticleByArticleConstantsWithVAT,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedFixedCostsExcludingVAT
	|		ELSE 0
	|	END) AS OriginalItemizedFixedCostExclVAT,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedFixedCostsCompl
	|		ELSE 0
	|	END) AS OriginalItemizedFixedLocal,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedVariableCostsIncludingVAT
	|		ELSE 0
	|	END) AS InitialArticleByArticleVariablesWithVAT,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedVariableCostsExcludingVAT
	|		ELSE 0
	|	END) AS OriginalItemizedVariableExclVAT,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedVariableCostsCompl
	|		ELSE 0
	|	END) AS OriginalItemizedVariableLocal,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.PermanentDifference
	|		ELSE 0
	|	END) AS InitialCostedPDDifferenceIsConstantOne,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.CostTD
	|		ELSE 0
	|	END) AS InitialCostTDOfTimeIsFollowing,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.OffBalanceCost
	|		ELSE 0
	|	END) AS InitialOffBalanceCost,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.OffBalanceCostLocal
	|		ELSE 0
	|	END) AS OriginalOffBalanceCostedLocal,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ProvisionForImpairmentLocal
	|		ELSE 0
	|	END) AS InitialReserveForImpairmentOfLocal,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ProvisionForImpairmentMan
	|		ELSE 0
	|	END) AS InitialReserveForImpairmentOfMan,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.CostMan
	|		ELSE 0
	|	END) AS InitialCostOfMan,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.AddExpensesMan
	|		ELSE 0
	|	END) AS InitialAdditionalExpensesManags,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.LaborCostsMan
	|		ELSE 0
	|	END) AS InitialLaborCostsManag,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedFixedCostsManag
	|		ELSE 0
	|	END) AS OriginalItemizedFixedMan,
	|	SUM(CASE
	|		WHEN Sales.CalculationOfCost
	|		 AND Sales.InventoryType <> VALUE(Enum.InventoryTypes.ConsignedGoods)
	|			THEN Sales.ItemizedVariableCostsManag
	|		ELSE 0
	|	END) AS OriginalItemizedvariableSCostingManag
	|INTO TTSales
	|FROM
	|	TTAdjustmentTable AS Sales
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = Sales.Organization
	|GROUP BY
	|	Sales.Period,
	|	Sales.AdjustmentPeriod_,
	|	(CASE
	|		WHEN Sales.Organization IN (&MediumSlipOrganizations)
	|			THEN CalculationLoggers.Ref
	|		ELSE Sales.Recorder END),
	|	Sales.DocumentCalculation,
	|	Sales.Organization,
	|	Sales.ItemsLocationAttributes,
	|	Sales.SalesOrder,
	|	Sales.AccountingDimensionByPartners,
	|	Sales.Partner,
	|	Sales.Counterparty,
	|	Sales.Department,
	|	Sales.InventoryType,
	|	Sales.InventoryOwnerAttribute,
	|	Sales.Manager,
	|	Sales.Warehouse,
	|	Sales.Terms,
	|	Sales.Contract,
	|	Sales.BusinessOperation,
	|	Sales.VATTaxation,
	|	Sales.ARAPCurrency,
	|	Sales.DocumentCurrency,
	|	Sales.SourceOfProductFinancialAccountingGroup,
	|	Sales.SourceOfARAPFinancialAccountingGroup,
	|	Sales.SetAccountingDimension,
	|	Sales.CounterpartyLineOfBusiness,
	|	Sales.ProductLineOfBusiness,
	|	Sales.AccountingSection,
	|	Sales.Lot,
	|	Sales.LotVendorAttributes,
	|	Sales.FinancialAccountingDimension,
	|	Sales.VATActivityType,
	|	Sales.BusinessTransactionSetting,
	|	Sales.FinRecordID,
	|	Sales.ReversingEntry,
	|	Sales.VATRate,
	|	Sales.InventoryValuationMethod,
	|	Sales.Character
	|;";
	#EndRegion
	
	#Region TTCostPrice
	QueryText = QueryText + "
	|SELECT
	|	Cost_.Period,
	|	(CASE
	|		WHEN Cost_.Organization IN (&MediumSlipOrganizations)
	|			THEN CalculationLoggers.Ref
	|		ELSE Cost_.Recorder END) AS Recorder,
	|	CASE
	|		WHEN Cost_.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.ReverseOfSaleReturnToAnotherWarehouse),
	|				VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse))
	|		THEN Cost_.CorItemsLocationAttributes
	|		ELSE Cost_.ItemsLocationAttributes
	|	END AS ItemsLocationAttributes,
	|	Cost_.AccountingSection,
	|	Cost_.Lot,
	|	Cost_.LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension,
	|	Cost_.VATActivityType,
	// The condition for the Type of inventory field must be identical to the calculation of the cost of filling in the parties.Textpartiesfor pens
	|	(CASE
	|		WHEN ISNULL(Cost_.InventoryOwnerAttribute.InventoryType, UNDEFINED) = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider)
	|			THEN VALUE(Catalog.InventoryKinds.EmptyRef)
	|		ELSE Cost_.InventoryOwnerAttribute END) AS InventoryOwnerAttribute,
	|	Cost_.Organization,
	|	Cost_.SalesOrder,
	|	Cost_.AccountingDimensionByPartners,
	|	(CASE
	|		WHEN &BatchAccountingVersion22 THEN Cost_.FinRecordID
	|		ELSE """" END) AS FinRecordID,
	|	MIN(CASE
	|		WHEN Cost_.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.ReverseOfSaleReturnToAnotherWarehouse),
	|				VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse),
	|				VALUE(Enum.BusinessTransactions.ReverseOfSale))
	|		OR Cost_.Count < 0
	|			THEN -1
	|		ELSE 1 END) AS Character,
	// For organizations on a medium-slip line, the Storno sign is not filled in, because Registered Records are generated under the service
	// document "Cost Calculation Registrar" and these are estimated Registered Records, and not storno Registered Records of the corrected document.
	|	(CASE
	|		WHEN Cost_.Organization IN (&MediumSlipOrganizations)
	|			THEN FALSE
	|		ELSE Cost_.ReversingEntry END) AS ReversingEntry,
	|	SUM(Cost_.Count) AS Count,
	// For the cost fields, we take into account the "Cost calculation" attribute in order to exclude the standard cost reflected
	// during the document.  
	|	SUM(CASE WHEN Cost_.CalculationOfCost THEN Cost_.Cost ELSE 0 END) AS Cost,
	|	SUM(CASE WHEN Cost_.CalculationOfCost THEN Cost_.CostExcludingVAT ELSE 0 END) AS CostExcludingVAT,
	|	SUM(Cost_.AddExpensesForGoods) AS AddExpensesForGoods,
	|	SUM(Cost_.AdditionalExpensesExcludingVAT) AS AdditionalExpensesExcludingVAT,
	|	SUM(CASE WHEN Cost_.CalculationOfCost THEN Cost_.LocalCost ELSE 0 END) AS LocalCost,
	|	SUM(Cost_.PermanentDifference) AS PermanentDifference,
	|	SUM(Cost_.CostTD) AS CostTD,
	|	SUM(CASE
	|		WHEN Cost_.BusinessOperation IN(
	|				VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
	|				VALUE(Enum.BusinessTransactions.Subcontracting2_5),
	|				VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
	|				VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
	|				VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5))
	|			THEN 0
	|		ELSE Cost_.OffBalanceCost END) AS OffBalanceCost,
	|	SUM(Cost_.LaborCosts) AS LaborCosts,
	|	SUM(Cost_.ItemizedFixedCostsIncludingVAT) AS ItemizedFixedCostsIncludingVAT,
	|	SUM(Cost_.ItemizedVariableCostsIncludingVAT) AS ItemizedVariableCostsIncludingVAT,
	|	SUM(Cost_.ItemizedFixedCostsExcludingVAT) AS ItemizedFixedCostsExcludingVAT,
	|	SUM(Cost_.ItemizedVariableCostsExcludingVAT) AS ItemizedVariableCostsExcludingVAT,
	|	SUM(CASE
	|		WHEN Cost_.BusinessOperation IN(
	|				VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
	|				VALUE(Enum.BusinessTransactions.Subcontracting2_5),
	|				VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
	|				VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
	|				VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5))
	|			THEN 0
	|		ELSE Cost_.OffBalanceCostLocal END) AS OffBalanceCostLocal,
	|	SUM(Cost_.AddExpensesLocal) AS AddExpensesLocal,
	|	SUM(Cost_.LaborCostsLocal) AS LaborCostsLocal,
	|	SUM(Cost_.ItemizedFixedCostsCompl) AS ItemizedFixedCostsCompl,
	|	SUM(Cost_.ItemizedVariableCostsCompl) AS ItemizedVariableCostsCompl,
	|	SUM(Cost_.ProvisionForImpairmentLocal) AS ProvisionForImpairmentLocal,
	|	SUM(Cost_.ProvisionForImpairmentMan) AS ProvisionForImpairmentMan,
	|	SUM(CASE WHEN Cost_.CalculationOfCost THEN Cost_.CostMan ELSE 0 END) AS CostMan,
	|	SUM(Cost_.AddExpensesMan) AS AddExpensesMan,
	|	SUM(Cost_.LaborCostsMan) AS LaborCostsMan,
	|	SUM(Cost_.ItemizedFixedCostsManag) AS ItemizedFixedCostsManag,
	|	SUM(Cost_.ItemizedVariableCostsManag) AS ItemizedVariableCostsManag
	|INTO TTCostPrice
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS Cost_
	|	INNER JOIN TTSalesRegistrars AS SalesRegistrars
	|		ON SalesRegistrars.Period = Cost_.Period
	|		AND SalesRegistrars.Recorder = Cost_.Recorder
	|		AND (SalesRegistrars.DocumentCalculation = Cost_.DocumentCalculation
	|			OR NOT Cost_.CalculationOfCost) 
	|		AND (NOT Cost_.OfficialTypeOfMovementParish
	|			AND Cost_.BusinessOperation <> VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses)
	|			AND Cost_.BusinessOperation <> VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand)
	|				OR Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.ReverseOfSaleReturnToAnotherWarehouse)
	|				OR Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse))
	|		AND Cost_.BusinessOperation <> VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = Cost_.Organization
	|
	|GROUP BY
	|	Cost_.Period,
	|	(CASE
	|		WHEN Cost_.Organization IN (&MediumSlipOrganizations)
	|			THEN CalculationLoggers.Ref
	|		ELSE Cost_.Recorder END),
	|	CASE
	|		WHEN Cost_.BusinessOperation IN (
	|				VALUE(Enum.BusinessTransactions.ReverseOfSaleReturnToAnotherWarehouse),
	|				VALUE(Enum.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse))
	|		THEN Cost_.CorItemsLocationAttributes
	|		ELSE Cost_.ItemsLocationAttributes
	|	END,
	|	Cost_.AccountingSection,
	|	Cost_.Lot,
	|	Cost_.LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension,
	|	Cost_.VATActivityType,
	|	(CASE
	|		WHEN ISNULL(Cost_.InventoryOwnerAttribute.InventoryType, UNDEFINED) = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider)
	|			THEN VALUE(Catalog.InventoryKinds.EmptyRef)
	|		ELSE Cost_.InventoryOwnerAttribute END), // InventoryOwnerAttribute
	|	Cost_.Organization,
	|	Cost_.SalesOrder,
	|	Cost_.AccountingDimensionByPartners,
	|	(CASE
	|		WHEN &BatchAccountingVersion22 THEN Cost_.FinRecordID
	|		ELSE """" END),
	|	(CASE
	|		WHEN Cost_.Organization IN (&MediumSlipOrganizations)
	|			THEN FALSE
	|		ELSE Cost_.ReversingEntry END)
	|;";
	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

// Stage 3.18
//
// Parameters:
//	CalculationParameters - Structure - cost calculation parameters
//
Procedure GenerateYourSalesExpenses(CalculationParameters) Export

	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "GenerateYourSalesExpenses");
	
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing
	 And Not CalculationParameters.DistributionOfItemByItemSalesExpenses Then
		Return;
	EndIf;
	
	Query = New Query;
	
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text = "
	// When using the "Medium-sliding" valuation method, past FIN identifiers. records should be obtained by the movements 
	// of the documents "Registrar of cost calculation". For other cost estimation methods
	// , the financial record IDs are saved in the method 
	|SELECT
	|	DD.Organization AS Organization,
	|	DD.Department AS ExpensesBusinessUnit,
	|	DD.LineOfBusiness,
	|	DD.ExpenseItem AS ExpenseItem,
	|	DD.DimensionOfExpenses AS DimensionOfExpenses,
	|	DD.ItemsLocationAttributes,
	|	DD.ReversingEntry,
	|	MAX(DD.FinRecordID) AS FinRecordID
	|
	|INTO IdentifiersMediumSlip
	|FROM
	|	AccumulationRegister.OtherExpenses AS DD
	|
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON TTAccountingPoliciesOfFinancialAccounting.Organization = DD.Organization
	|WHERE
	|	DD.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND VALUETYPE(DD.Recorder) = TYPE(Document.CostCalculationRecorder)
	|	AND DD.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold)
	|	AND DD.Active
	|	AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|	AND TRUE IN (
	|			SELECT TOP 1
	|				TRUE
	|			FROM
	|				TTDistributionOfSalesExpenses AS Allocation
	|			WHERE
	|				DD.Organization = Allocation.Organization
	|				AND DD.Department = Allocation.ExpensesBusinessUnit
	|				AND DD.LineOfBusiness = Allocation.LineOfBusiness
	|				AND DD.ExpenseItem = Allocation.ExpenseItem
	|				AND DD.DimensionOfExpenses = Allocation.DimensionOfExpenses
	|			)
	|
	|GROUP BY
	|	DD.Organization,
	|	DD.Department,
	|	DD.LineOfBusiness,
	|	DD.ExpenseItem,
	|	DD.DimensionOfExpenses,
	|	DD.ItemsLocationAttributes,
	|	DD.ReversingEntry
	|
	|INDEX BY
	|	ExpenseItem,
	|	DimensionOfExpenses
	|;
	|SELECT
	|	ISNULL(CalculationLoggers.Ref, TTDistributionOfSalesExpenses.Recorder) AS Recorder,
	|	TTDistributionOfSalesExpenses.Organization,
	|	TTDistributionOfSalesExpenses.ExpensesBusinessUnit AS Department,
	|	TTDistributionOfSalesExpenses.LineOfBusiness,
	|	TTDistributionOfSalesExpenses.ExpenseItem AS ExpenseItem,
	|	TTDistributionOfSalesExpenses.DimensionOfExpenses AS DimensionOfExpenses,
	|	TTDistributionOfSalesExpenses.ItemsLocationAttributes,
	|	MIN(TTDistributionOfSalesExpenses.Period) AS Period,
	|	TTDistributionOfSalesExpenses.ReversingEntry,
	|	VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold) AS BusinessOperation,
	|	SUM(TTDistributionOfSalesExpenses.Sum) AS Sum,
	|	SUM(TTDistributionOfSalesExpenses.AmountExcludingVAT) AS AmountExcludingVAT,
	|	SUM(TTDistributionOfSalesExpenses.SumMan) AS SumMan,
	|	SUM(TTDistributionOfSalesExpenses.SumCompl) AS SumCompl,
	|	SUM(TTDistributionOfSalesExpenses.PermanentDifference) AS PermanentDifference,
	|	SUM(TTDistributionOfSalesExpenses.CostTD) AS CostTD
	|
	|INTO TTDistributionOfSalesExpenses_OtherExpenses
	|FROM
	|	TTDistributionOfSalesExpenses AS TTDistributionOfSalesExpenses
	|
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON TTDistributionOfSalesExpenses.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = TTDistributionOfSalesExpenses.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|
	|GROUP BY
	|	ISNULL(CalculationLoggers.Ref, TTDistributionOfSalesExpenses.Recorder),
	|	TTDistributionOfSalesExpenses.Organization,
	|	TTDistributionOfSalesExpenses.ExpensesBusinessUnit,
	|	TTDistributionOfSalesExpenses.LineOfBusiness,
	|	TTDistributionOfSalesExpenses.ExpenseItem,
	|	TTDistributionOfSalesExpenses.DimensionOfExpenses,
	|	TTDistributionOfSalesExpenses.ReversingEntry,
	|	TTDistributionOfSalesExpenses.ItemsLocationAttributes
	|
	|INDEX BY
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Recorder,
	|	Period
	|;
	|
	|SELECT
	|	MIN(TTDistributionOfSalesExpenses.Period) AS Period,
	|	ISNULL(CalculationLoggers.Ref, TTDistributionOfSalesExpenses.Recorder) AS Recorder,
	|	TTDistributionOfSalesExpenses.Organization,
	|	TTDistributionOfSalesExpenses.ItemsLocationAttributes,
	|	TTDistributionOfSalesExpenses.SalesOrder,
	|	TTDistributionOfSalesExpenses.AccountingDimensionByPartners,
	|	TTDistributionOfSalesExpenses.RevenueDivision AS Department,
	|	TTDistributionOfSalesExpenses.InventoryType,
	|	TTDistributionOfSalesExpenses.InventoryOwnerAttribute,
	|	TTDistributionOfSalesExpenses.AccountingSection,
	|	TTDistributionOfSalesExpenses.Lot,
	|	TTDistributionOfSalesExpenses.LotVendorAttributes,
	|	TTDistributionOfSalesExpenses.FinancialAccountingDimension,
	|	TTDistributionOfSalesExpenses.VATActivityType,
	|	TTDistributionOfSalesExpenses.Manager,
	|	TTDistributionOfSalesExpenses.Warehouse,
	|	TTDistributionOfSalesExpenses.Terms,
	|	TTDistributionOfSalesExpenses.Contract,
	|	TTDistributionOfSalesExpenses.SetAccountingDimension,
	|	TTDistributionOfSalesExpenses.CounterpartyLineOfBusiness,
	|	TTDistributionOfSalesExpenses.ProductLineOfBusiness,
	|	TTDistributionOfSalesExpenses.VATTaxation,
	|	TTDistributionOfSalesExpenses.ARAPCurrency,
	|	TTDistributionOfSalesExpenses.DocumentCurrency,
	|	TTDistributionOfSalesExpenses.SourceOfProductFinancialAccountingGroup,
	|	TTDistributionOfSalesExpenses.ReversingEntry,
	|	TTDistributionOfSalesExpenses.VATRate,
	|	TTDistributionOfSalesExpenses.ExpensesBusinessUnit,
	|	TTDistributionOfSalesExpenses.LineOfBusiness,
	|	TTDistributionOfSalesExpenses.ExpenseItem,
	|	TTDistributionOfSalesExpenses.DimensionOfExpenses,
	|	TRUE AS CalculationOfCost,
	|	FALSE AS LotCalculation,
	|	SUM(TTDistributionOfSalesExpenses.Sum) AS SellingExpensesIncludingVAT,
	|	SUM(TTDistributionOfSalesExpenses.AmountExcludingVAT) AS SellingExpensesExcludingVAT,
	|	SUM(TTDistributionOfSalesExpenses.SumMan) AS SellingExpensesMan,
	|	SUM(TTDistributionOfSalesExpenses.SumCompl) AS SellingExpensesLocal,
	|	SUM(TTDistributionOfSalesExpenses.PermanentDifference) AS PermanentDifference,
	|	SUM(TTDistributionOfSalesExpenses.CostTD) AS CostTD
	|
	|INTO TTDistributionOfSalesExpenses_RevenueAndCostOfGoodsSold
	|FROM
	|	TTDistributionOfSalesExpenses AS TTDistributionOfSalesExpenses
	|
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON TTDistributionOfSalesExpenses.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|	ON CalculationLoggers.Organization = TTDistributionOfSalesExpenses.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|
	|GROUP BY
	|	ISNULL(CalculationLoggers.Ref, TTDistributionOfSalesExpenses.Recorder),
	|	TTDistributionOfSalesExpenses.Organization,
	|	TTDistributionOfSalesExpenses.ItemsLocationAttributes,
	|	TTDistributionOfSalesExpenses.SalesOrder,
	|	TTDistributionOfSalesExpenses.AccountingDimensionByPartners,
	|	TTDistributionOfSalesExpenses.RevenueDivision,
	|	TTDistributionOfSalesExpenses.InventoryType,
	|	TTDistributionOfSalesExpenses.InventoryOwnerAttribute,
	|	TTDistributionOfSalesExpenses.AccountingSection,
	|	TTDistributionOfSalesExpenses.Lot,
	|	TTDistributionOfSalesExpenses.LotVendorAttributes,
	|	TTDistributionOfSalesExpenses.FinancialAccountingDimension,
	|	TTDistributionOfSalesExpenses.VATActivityType,
	|	TTDistributionOfSalesExpenses.Manager,
	|	TTDistributionOfSalesExpenses.Warehouse,
	|	TTDistributionOfSalesExpenses.Terms,
	|	TTDistributionOfSalesExpenses.Contract,
	|	TTDistributionOfSalesExpenses.SetAccountingDimension,
	|	TTDistributionOfSalesExpenses.CounterpartyLineOfBusiness,
	|	TTDistributionOfSalesExpenses.ProductLineOfBusiness,
	|	TTDistributionOfSalesExpenses.VATTaxation,
	|	TTDistributionOfSalesExpenses.ARAPCurrency,
	|	TTDistributionOfSalesExpenses.DocumentCurrency,
	|	TTDistributionOfSalesExpenses.SourceOfProductFinancialAccountingGroup,
	|	TTDistributionOfSalesExpenses.ReversingEntry,
	|	TTDistributionOfSalesExpenses.VATRate,
	|	TTDistributionOfSalesExpenses.ExpensesBusinessUnit,
	|	TTDistributionOfSalesExpenses.LineOfBusiness,
	|	TTDistributionOfSalesExpenses.ExpenseItem,
	|	TTDistributionOfSalesExpenses.DimensionOfExpenses
	|
	|INDEX BY
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Recorder,
	|	Period
	|;
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);

	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(
		CalculationParameters,
		CalculationParameters.RegisterRecords[Metadata.AccumulationRegisters.OtherExpenses.Name],
		"TTDistributionOfSalesExpenses_OtherExpenses");
	
	Query.Text = "
	|SELECT
	|	TTDistributionOfSalesExpenses.Organization,
	|	TTDistributionOfSalesExpenses.Department,
	|	TTDistributionOfSalesExpenses.LineOfBusiness,
	|	TTDistributionOfSalesExpenses.ExpenseItem,
	|	TTDistributionOfSalesExpenses.DimensionOfExpenses,
	|	TTDistributionOfSalesExpenses.ItemsLocationAttributes,
	|	TTDistributionOfSalesExpenses.Period,
	|	TTDistributionOfSalesExpenses.Recorder AS DocumentRegisterRecords,
	|	VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ExpenseAllocationOnCostOfGoodsSold) AS BusinessTransactionSetting,
	|	ISNULL(IdentifiersMediumSlip.FinRecordID,
	|		TTDistributionOfSalesExpenses.FinRecordID) AS FinRecordID,
	|	TTDistributionOfSalesExpenses.ReversingEntry,
	|	TRUE AS CalculationOfCost,
	|	TTDistributionOfSalesExpenses.Sum,
	|	TTDistributionOfSalesExpenses.AmountExcludingVAT,
	|	TTDistributionOfSalesExpenses.SumMan,
	|	TTDistributionOfSalesExpenses.SumCompl,
	|	TTDistributionOfSalesExpenses.PermanentDifference,
	|	TTDistributionOfSalesExpenses.CostTD
	|FROM
	|	TTDistributionOfSalesExpenses_OtherExpenses AS TTDistributionOfSalesExpenses
	|
	|	LEFT JOIN IdentifiersMediumSlip AS IdentifiersMediumSlip
	|		ON IdentifiersMediumSlip.Organization = TTDistributionOfSalesExpenses.Organization
	|		AND IdentifiersMediumSlip.ExpenseItem = TTDistributionOfSalesExpenses.ExpenseItem
	|		AND IdentifiersMediumSlip.DimensionOfExpenses = TTDistributionOfSalesExpenses.DimensionOfExpenses
	|		AND IdentifiersMediumSlip.ExpensesBusinessUnit = TTDistributionOfSalesExpenses.Department
	|		AND IdentifiersMediumSlip.LineOfBusiness = TTDistributionOfSalesExpenses.LineOfBusiness
	|		AND IdentifiersMediumSlip.ItemsLocationAttributes = TTDistributionOfSalesExpenses.ItemsLocationAttributes
	|		AND IdentifiersMediumSlip.ReversingEntry = TTDistributionOfSalesExpenses.ReversingEntry
	|;
	|
	|SELECT
	|	TTDistributionOfSalesExpenses.Period AS Period,
	|	TTDistributionOfSalesExpenses.Recorder AS DocumentRegisterRecords,
	|	TTDistributionOfSalesExpenses.ItemsLocationAttributes,
	|	TTDistributionOfSalesExpenses.SalesOrder,
	|	TTDistributionOfSalesExpenses.AccountingDimensionByPartners,
	|	TTDistributionOfSalesExpenses.Department,
	|	TTDistributionOfSalesExpenses.InventoryType,
	|	TTDistributionOfSalesExpenses.InventoryOwnerAttribute,
	|	TTDistributionOfSalesExpenses.AccountingSection,
	|	TTDistributionOfSalesExpenses.Lot,
	|	TTDistributionOfSalesExpenses.LotVendorAttributes,
	|	TTDistributionOfSalesExpenses.FinancialAccountingDimension,
	|	TTDistributionOfSalesExpenses.VATActivityType,
	|	TTDistributionOfSalesExpenses.Manager,
	|	TTDistributionOfSalesExpenses.Warehouse,
	|	TTDistributionOfSalesExpenses.Terms,
	|	TTDistributionOfSalesExpenses.Contract,
	|	VALUE(Enum.BusinessTransactions.ExpenseAllocationOnCostOfGoodsSold) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.ExpenseAllocationOnCostOfGoodsSold) AS BusinessTransactionSetting,
	|	TTDistributionOfSalesExpenses.SetAccountingDimension,
	|	TTDistributionOfSalesExpenses.CounterpartyLineOfBusiness,
	|	TTDistributionOfSalesExpenses.ProductLineOfBusiness,
	|	TTDistributionOfSalesExpenses.VATTaxation,
	|	TTDistributionOfSalesExpenses.ARAPCurrency,
	|	TTDistributionOfSalesExpenses.DocumentCurrency,
	|	TTDistributionOfSalesExpenses.SourceOfProductFinancialAccountingGroup,
	|	TTDistributionOfSalesExpenses.ReversingEntry,
	|	TTDistributionOfSalesExpenses.VATRate,
	|	TRUE AS CalculationOfCost,
	|	FALSE AS LotCalculation,
	|	TTDistributionOfSalesExpenses.SellingExpensesIncludingVAT,
	|	TTDistributionOfSalesExpenses.SellingExpensesExcludingVAT,
	|	TTDistributionOfSalesExpenses.SellingExpensesMan,
	|	TTDistributionOfSalesExpenses.SellingExpensesLocal,
	|	TTDistributionOfSalesExpenses.PermanentDifference,
	|	TTDistributionOfSalesExpenses.CostTD,
	|	ISNULL(IdentifiersMediumSlip.FinRecordID, 
	|		IDs.FinRecordID) AS FinRecordID
	|FROM
	|	TTDistributionOfSalesExpenses_RevenueAndCostOfGoodsSold AS TTDistributionOfSalesExpenses
	|
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON TTDistributionOfSalesExpenses.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|
	|	LEFT JOIN TTDistributionOfSalesExpenses_OtherExpenses AS IDs
	|	ON TTDistributionOfSalesExpenses.Recorder = IDs.Recorder
	|		AND TTDistributionOfSalesExpenses.Period = IDs.Period
	|		AND TTDistributionOfSalesExpenses.Organization = IDs.Organization
	|		AND TTDistributionOfSalesExpenses.ExpensesBusinessUnit = IDs.Department
	|		AND TTDistributionOfSalesExpenses.LineOfBusiness = IDs.LineOfBusiness
	|		AND TTDistributionOfSalesExpenses.ExpenseItem = IDs.ExpenseItem
	|		AND TTDistributionOfSalesExpenses.DimensionOfExpenses = IDs.DimensionOfExpenses
	|		AND TTDistributionOfSalesExpenses.ItemsLocationAttributes = IDs.ItemsLocationAttributes
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|
	|	LEFT JOIN IdentifiersMediumSlip AS IdentifiersMediumSlip
	|		ON IdentifiersMediumSlip.Organization = TTDistributionOfSalesExpenses.Organization
	|		AND IdentifiersMediumSlip.ExpenseItem = TTDistributionOfSalesExpenses.ExpenseItem
	|		AND IdentifiersMediumSlip.DimensionOfExpenses = TTDistributionOfSalesExpenses.DimensionOfExpenses
	|		AND IdentifiersMediumSlip.ExpensesBusinessUnit = TTDistributionOfSalesExpenses.ExpensesBusinessUnit
	|		AND IdentifiersMediumSlip.LineOfBusiness = TTDistributionOfSalesExpenses.LineOfBusiness
	|		AND IdentifiersMediumSlip.ItemsLocationAttributes = TTDistributionOfSalesExpenses.ItemsLocationAttributes
	|		AND IdentifiersMediumSlip.ReversingEntry = TTDistributionOfSalesExpenses.ReversingEntry
	|;
	|";
	
	Samples = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,
		True);
	
	SamplingOtherExpenses = Samples[0];
	SampleRevenue = Samples[1];

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = CostCalculationAppliedAlgorithms.CommonColumnsOfDataSourceAndReceiver(
		CalculationParameters,
		SamplingOtherExpenses,
		RegisterName);
	
	While SamplingOtherExpenses.Next() Do
		Record = AddEntryToMovementTable(CalculationParameters, RegisterName, SamplingOtherExpenses, CopiedFields);
		Record.RecordType = AccumulationRecordType.Expense;
	EndDo;
	
	RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name;
	
	CopiedFields = CostCalculationAppliedAlgorithms.CommonColumnsOfDataSourceAndReceiver(
		CalculationParameters,
		SampleRevenue,
		RegisterName);
	
	While SampleRevenue.Next() Do
		Record = AddEntryToMovementTable(CalculationParameters, RegisterName, SampleRevenue, CopiedFields);
	EndDo;
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);
	
EndProcedure

// Stage 3.19
Procedure WriteOffRoundingErrorsInCostCalculation(CalculationParameters) Export
	
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "WriteOffRoundingErrorsInCostCalculation");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	// We write off only those balances in which all the "sum" resources have values that fit within the margin of error. 
	// If at least one "sum" resource exceeds the margin of error, then we do not consider such a remainder to be a rounding error.
	// For the Other Expenses register, the approach is different: for it, the balance is checked for each resource separately.
	// If a resource falls within the margin of error, then we write off only it.
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	Query.Text = CostCalculationAppliedAlgorithms.QueryTextCompletedBatches();
	Query.Execute();
	MatchingTemporaryMovementTables = New Map;
	
#Region InventoryCost

	// Write-off of rounding errors in the inventory cost register
	// We will also create an empty temporary table for the second round of the other expenses for the UT - there will be no rounding errors in the Other Expenses register.
	Query.Text = "
	|SELECT DISTINCT
	|	DD.Organization,
	|	DD.ItemsLocationAttributes,
	|	DD.InventoryOwnerAttribute,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress) AS AccountingSection
	|INTO ThisIsReturnableWasteOfUnfinishedProduction
	|FROM
	|	AccumulationRegister.InventoryCost AS DD
	|WHERE
	|	DD.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND DD.RecordType = VALUE(AccumulationRecordType.Receipt)
	|	AND DD.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)
	|	AND DD.Count < 0
	|	AND VALUETYPE(DD.Recorder) IN (
	|		TYPE(Document.RecyclableWasteAllocation),
	|		TYPE(Document.BackflushProduction)
	|		,TYPE(Document.ProductionStage2_2)
	|		)
	|	AND DD.Organization IN (&CompanyArray)
	|	AND DD.Active
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|
	|	Cost_.Organization 					AS Organization,
	|	Cost_.ItemsLocationAttributes 	AS ItemsLocationAttributes,
	|	Cost_.AccountingSection 					AS AccountingSection,
	|	Cost_.InventoryOwnerAttribute 					AS InventoryOwnerAttribute,
	|	Cost_.Lot                        AS Lot,
	|	Cost_.LotVendorAttributes          AS LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	Cost_.VATActivityType            AS VATActivityType,
	|	CASE
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN Dimension.Department
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE Dimension.WarehouseArea.Department
	|	END 										AS Department,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.CostCalculationError)	AS ExpenseItemOfWriteOff,
	|	Dimension.Purpose.LineOfBusiness AS LineOfBusiness,
	|	(CASE
	|		WHEN FALSE THEN UNDEFINED // for easy tag placement
	|		WHEN NOT ThisIsReturnableWasteOfUnfinishedProduction.Organization IS NULL
	|			THEN VALUE(Enum.BusinessTransactions.RoundingErrorsWriteOffRecyclableWasteCostInProduction)
	|		ELSE VALUE(Enum.BusinessTransactions.WriteOffRoundingErrors) END) AS BusinessOperation,
	|	(CASE
	|		WHEN FALSE THEN UNDEFINED // for easy tag placement
	|		WHEN NOT ThisIsReturnableWasteOfUnfinishedProduction.Organization IS NULL
	|			THEN VALUE(Catalog.BusinessTransactionsSettings.RoundingErrorsWriteOffRecyclableWasteCostInProduction)
	|		ELSE VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) END) AS BusinessTransactionSetting,
	|	Cost_.Cost 					AS Cost,
	|	Cost_.CostExcludingVAT 				AS CostExcludingVAT,
	|	Cost_.AddExpensesForGoods 					AS AddExpensesForGoods,
	|	Cost_.AdditionalExpensesExcludingVAT 				AS AdditionalExpensesExcludingVAT,
	|	Cost_.LocalCost 				AS LocalCost,
	|	Cost_.PermanentDifference 			AS PermanentDifference,
	|	Cost_.CostTD 				AS CostTD,
	|	Cost_.CostOfPersonalIncomeTax					AS CostOfPersonalIncomeTax,
	|	Cost_.OffBalanceCost         AS OffBalanceCost,
	|	Cost_.LaborCosts       		    AS LaborCosts,
	|	Cost_.ItemizedFixedCostsIncludingVAT     AS ItemizedFixedCostsIncludingVAT,
	|	Cost_.ItemizedFixedCostsExcludingVAT   AS ItemizedFixedCostsExcludingVAT,
	|	Cost_.ItemizedVariableCostsIncludingVAT     AS ItemizedVariableCostsIncludingVAT,
	|	Cost_.ItemizedVariableCostsExcludingVAT   AS ItemizedVariableCostsExcludingVAT,
	|	Cost_.OffBalanceCostLocal     AS OffBalanceCostLocal,
	|	Cost_.AddExpensesLocal                AS AddExpensesLocal,
	|	Cost_.LaborCostsLocal              AS LaborCostsLocal,
	|	Cost_.ItemizedFixedCostsCompl     AS ItemizedFixedCostsCompl,
	|	Cost_.ItemizedVariableCostsCompl     AS ItemizedVariableCostsCompl,
	|	Cost_.CostMan     				AS CostMan,
	|	Cost_.AddExpensesMan     			AS AddExpensesMan,
	|	Cost_.LaborCostsMan     			AS LaborCostsMan,
	|	Cost_.ItemizedFixedCostsManag     	AS ItemizedFixedCostsManag,
	|	Cost_.ItemizedVariableCostsManag     	AS ItemizedVariableCostsManag,
	|	Cost_.ProvisionForImpairmentLocal      AS ProvisionForImpairmentLocal,
	|	Cost_.ProvisionForImpairmentMan       AS ProvisionForImpairmentMan
	|
	|INTO TTRoundingCostOfGoods
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS Cost_
	|		INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|			ON Cost_.Organization = CostCalculationDocuments.Organization
	|		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|			ON Dimension.Ref = Cost_.ItemsLocationAttributes
	|		LEFT JOIN ThisIsReturnableWasteOfUnfinishedProduction AS ThisIsReturnableWasteOfUnfinishedProduction
	|		ON ThisIsReturnableWasteOfUnfinishedProduction.Organization = Cost_.Organization
	|			AND ThisIsReturnableWasteOfUnfinishedProduction.ItemsLocationAttributes = Cost_.ItemsLocationAttributes
	|			AND ThisIsReturnableWasteOfUnfinishedProduction.InventoryOwnerAttribute = Cost_.InventoryOwnerAttribute
	|			AND ThisIsReturnableWasteOfUnfinishedProduction.AccountingSection = Cost_.AccountingSection
	//On changing conditions, you can also change the reverse condition in see Write off the most recent low-value data in the second statistic.
	|WHERE
	|	Cost_.Count = 0
	|	AND (Cost_.Cost BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.CostExcludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.AddExpensesForGoods BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.AdditionalExpensesExcludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.LocalCost BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.CostMan BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.PermanentDifference BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.CostTD BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.CostOfPersonalIncomeTax BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.OffBalanceCost BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.LaborCosts BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ItemizedFixedCostsIncludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ItemizedFixedCostsExcludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ItemizedVariableCostsIncludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ItemizedVariableCostsExcludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.OffBalanceCostLocal BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.AddExpensesLocal BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.LaborCostsLocal BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.ItemizedFixedCostsCompl BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.ItemizedVariableCostsCompl BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Cost_.CostMan BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.AddExpensesMan BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.LaborCostsMan BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ItemizedFixedCostsManag BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ItemizedVariableCostsManag BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ProvisionForImpairmentLocal BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Cost_.ProvisionForImpairmentMan BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|	)
	|
	|UNION ALL
	|
	|SELECT
	|	CostCalculationDocuments.Ref 		AS DocumentRegisterRecords,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|
	|	Cost_.Organization 					AS Organization,
	|	Cost_.ItemsLocationAttributes 	AS ItemsLocationAttributes,
	|	Cost_.AccountingSection 					AS AccountingSection,
	|	Cost_.InventoryOwnerAttribute 					AS InventoryOwnerAttribute,
	|	Cost_.Lot                        AS Lot,
	|	Cost_.LotVendorAttributes          AS LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	Cost_.VATActivityType            AS VATActivityType,
	|	CASE
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN Dimension.Department
	|		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(Dimension.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE Dimension.WarehouseArea.Department
	|	END 										AS Department,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.CostCalculationError)	AS ExpenseItemOfWriteOff,
	|	Dimension.Purpose.LineOfBusiness AS LineOfBusiness,
	|	VALUE(Enum.BusinessTransactions.WriteOffRoundingErrors) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|	(CASE
	|		WHEN Cost_.Cost BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.Cost
	|		ELSE 0 END) 							AS Cost,
	|	(CASE
	|		WHEN Cost_.CostExcludingVAT BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.CostExcludingVAT
	|		ELSE 0 END) 							AS CostExcludingVAT,
	|	(CASE
	|		WHEN Cost_.AddExpensesForGoods BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.AddExpensesForGoods
	|		ELSE 0 END) 							AS AddExpensesForGoods,
	|	(CASE
	|		WHEN Cost_.AdditionalExpensesExcludingVAT BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.AdditionalExpensesExcludingVAT
	|		ELSE 0 END) 							AS AdditionalExpensesExcludingVAT,
	|	(CASE
	|		WHEN Cost_.LocalCost BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.LocalCost
	|		ELSE 0 END) 							AS LocalCost,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	(CASE
	|		WHEN Cost_.CostOfPersonalIncomeTax BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.CostOfPersonalIncomeTax
	|		ELSE 0 END)							AS CostOfPersonalIncomeTax,
	|	(CASE
	|		WHEN Cost_.OffBalanceCost BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.OffBalanceCost
	|		ELSE 0 END) 							AS OffBalanceCost,
	|	(CASE
	|		WHEN Cost_.LaborCosts BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.LaborCosts
	|		ELSE 0 END) 							AS LaborCosts,
	|	(CASE
	|		WHEN Cost_.ItemizedFixedCostsIncludingVAT BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedFixedCostsIncludingVAT
	|		ELSE 0 END) 							AS ItemizedFixedCostsIncludingVAT,
	|	(CASE
	|		WHEN Cost_.ItemizedFixedCostsExcludingVAT BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedFixedCostsExcludingVAT
	|		ELSE 0 END) 							AS ItemizedFixedCostsExcludingVAT,
	|	(CASE
	|		WHEN Cost_.ItemizedVariableCostsIncludingVAT BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) 							AS ItemizedVariableCostsIncludingVAT,
	|	(CASE
	|		WHEN Cost_.ItemizedVariableCostsExcludingVAT BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) 							AS ItemizedVariableCostsExcludingVAT,
	|	(CASE
	|		WHEN Cost_.OffBalanceCostLocal BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.OffBalanceCostLocal
	|		ELSE 0 END) 							AS OffBalanceCostLocal,
	|	(CASE
	|		WHEN Cost_.AddExpensesLocal BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.AddExpensesLocal
	|		ELSE 0 END) 							AS AddExpensesLocal,
	|	(CASE
	|		WHEN Cost_.LaborCostsLocal BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.LaborCostsLocal
	|		ELSE 0 END) 							AS LaborCostsLocal,
	|	(CASE
	|		WHEN Cost_.ItemizedFixedCostsCompl BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedFixedCostsCompl
	|		ELSE 0 END) 							AS ItemizedFixedCostsCompl,
	|	(CASE
	|		WHEN Cost_.ItemizedVariableCostsCompl BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedVariableCostsCompl
	|		ELSE 0 END) 							AS ItemizedVariableCostsCompl,
	|	(CASE
	|		WHEN Cost_.CostMan BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.CostMan
	|		ELSE 0 END) 							AS CostMan,
	|	(CASE
	|		WHEN Cost_.AddExpensesMan BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.AddExpensesMan
	|		ELSE 0 END) 							AS AddExpensesMan,
	|	(CASE
	|		WHEN Cost_.LaborCostsMan BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.LaborCostsMan
	|		ELSE 0 END) 							AS LaborCostsMan,
	|	(CASE
	|		WHEN Cost_.ItemizedFixedCostsManag BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedFixedCostsManag
	|		ELSE 0 END) 							AS ItemizedFixedCostsManag,
	|	(CASE
	|		WHEN Cost_.ItemizedVariableCostsManag BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ItemizedVariableCostsManag
	|		ELSE 0 END) 							AS ItemizedVariableCostsManag,
	|	(CASE
	|		WHEN Cost_.ProvisionForImpairmentLocal BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ProvisionForImpairmentLocal
	|		ELSE 0 END) 							AS ProvisionForImpairmentLocal,
	|	(CASE
	|		WHEN Cost_.ProvisionForImpairmentMan BETWEEN -&ErrorValueCostOfMan AND 0 THEN Cost_.ProvisionForImpairmentMan
	|		ELSE 0 END) 							AS ProvisionForImpairmentMan
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS Cost_
	|		INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|			ON Cost_.Organization = CostCalculationDocuments.Organization
	|		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|			ON Dimension.Ref = Cost_.ItemsLocationAttributes
	|
	|WHERE
	|	Cost_.Count > 0
	|	AND (
	|		(Cost_.Cost
	|		+ Cost_.AddExpensesForGoods
	|		+ Cost_.LaborCosts
	|		+ Cost_.ItemizedFixedCostsIncludingVAT
	|		+ Cost_.ItemizedVariableCostsIncludingVAT) < 0
	|	OR (Cost_.CostExcludingVAT
	|		+ Cost_.AdditionalExpensesExcludingVAT
	|		+ Cost_.LaborCosts
	|		+ Cost_.ItemizedFixedCostsExcludingVAT
	|		+ Cost_.ItemizedVariableCostsExcludingVAT) < 0 
	|	OR (Cost_.LocalCost
	|		+ Cost_.AddExpensesLocal
	|		+ Cost_.LaborCostsLocal
	|		+ Cost_.ItemizedFixedCostsCompl
	|		+ Cost_.ItemizedVariableCostsCompl
	|		+ Cost_.ProvisionForImpairmentLocal) < 0
	|	OR (Cost_.CostMan
	|		+ Cost_.AddExpensesMan
	|		+ Cost_.LaborCostsMan
	|		+ Cost_.ItemizedFixedCostsManag
	|		+ Cost_.ItemizedVariableCostsManag
	|		+ Cost_.ProvisionForImpairmentMan) < 0
	|	OR Cost_.CostOfPersonalIncomeTax < 0
	|	)
	|	AND NOT Cost_.Lot IN (
	|			SELECT
	|				CompletedBatches.Lot AS Lot
	|			FROM
	|				CompletedBatches AS CompletedBatches)
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT TOP 0
	|	UNDEFINED AS Recorder,
	|	UNDEFINED AS Period,
	|	FALSE		 AS RecordType,
	|	UNDEFINED AS Organization,
	|	UNDEFINED AS Department,
	|	UNDEFINED AS ExpenseItem,
	|	UNDEFINED AS DimensionOfExpenses,
	|	UNDEFINED AS LineOfBusiness,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|	0 			 AS Sum,
	|	0 			 AS AmountExcludingVAT,
	|	0 			 AS SumCompl,
	|	0 			 AS SumMan,
	|	0 			 AS PermanentDifference,
	|	0 			 AS CostTD,
	|	0 			 AS AITAmount,
	|	""""         AS FinRecordID
	|INTO TTRoundingOtherExpenses
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT TOP 0
	|	UNDEFINED AS Recorder,
	|	UNDEFINED AS Period,
	|	FALSE         AS RecordType,
	|	UNDEFINED AS Organization,
	|	UNDEFINED AS Department,
	|	UNDEFINED AS ProductionLot,
	|	UNDEFINED AS ProductionOrder,
	|	UNDEFINED AS RowCodeProducts,
	|	UNDEFINED AS Stage,
	|	UNDEFINED AS ProductCostElement,
	|	UNDEFINED AS ExpenseItem,
	|	UNDEFINED AS DimensionOfExpenses,
	|	UNDEFINED AS ProductsGroup,
	|	UNDEFINED AS RuleOfCostAllocatingToProductionLots,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|	0            AS Cost,
	|	0            AS CostExcludingVAT,
	|	0            AS LocalCost,
	|	0            AS CostMan,
	|	0            AS PermanentDifference,
	|	0            AS CostTD,
	|	0            AS CostOfPersonalIncomeTax,
	|	0            AS CostShare,
	|	""""         AS FinRecordID
	|INTO TTRoundingOtherExpensesUnfinishedProduction
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT TOP 0
	|	UNDEFINED AS Recorder,
	|	UNDEFINED AS Period,
	|	FALSE         AS RecordType,
	|	UNDEFINED AS Organization,
	|	UNDEFINED AS Department,
	|	UNDEFINED AS ReserveKind,
	|	UNDEFINED AS LineOfBusiness,
	|	UNDEFINED AS ProvisionObject,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|	0            AS SumMan,
	|	0            AS SumCompl,
	|	0            AS AmountFA,
	|	""""         AS FinRecordID
	|INTO TTRoundingProvisionsForUpcomingExpenses
	|;
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.InventoryCost.Name,, True);
	DescriptionOfTT.TTResultName = "TTErrorCostOfGoods";
	DescriptionOfTT.NameOfSourceTT = "TTRoundingCostOfGoods";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);

#EndRegion

#Region GoodsCostVariances

	// Write-off of rounding errors in the Item value deviation register.
	Query.Text = "
	|SELECT DISTINCT
	|	Balance.Organization AS Organization,
	|	Balance.ItemsLocationAttributes.Products AS Products,
	|	Balance.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	Balance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(Balance.ItemsLocationAttributes.Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN Balance.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN Balance.ItemsLocationAttributes.StorageLocation
	|		WHEN Balance.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(Balance.ItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN Balance.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(Balance.ItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN Balance.ItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation
	|
	|INTO TTResiduesForDeviations
	|FROM
	|	TTCashSettlementBalancesCostOfGoods AS Balance
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON Balance.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|WHERE
	|	Balance.Count <> 0
	|INDEX BY
	|	Products,
	|	Organization
	|;
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|
	|	Variances.Organization 						AS Organization,
	|	Variances.Products						AS Products,
	|	Variances.Characteristic					AS Characteristic,
	|	Variances.InventoryOwnerAttribute 						AS InventoryOwnerAttribute,
	|	Variances.LineOfBusiness			AS LineOfBusiness,
	|	Variances.Department					AS Department,
	|	Variances.StorageLocation					AS StorageLocation,
	|	Variances.VariancePeriod					AS VariancePeriod,
	|
	|	VALUE(Enum.BusinessTransactions.WriteOffRoundingErrors) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|
	|	Variances.CostVariancesIncludingVAT			AS CostVariancesIncludingVAT,
	|	Variances.CostVariancesExcludingVAT		AS CostVariancesExcludingVAT,
	|	Variances.CostVariancesLocal			AS CostVariancesLocal,
	|	Variances.CostVariancesMgmt			AS CostVariancesMgmt,
	|	Variances.AdditionalExpensesIncludingVAT					AS AdditionalExpensesIncludingVAT,
	|	Variances.AdditionalExpensesExcludingVAT					AS AdditionalExpensesExcludingVAT,
	|	Variances.AddExpensesLocal					AS AddExpensesLocal,
	|	Variances.AddExpensesMan					AS AddExpensesMan,
	|	Variances.VATLocal							AS VATLocal,
	|	Variances.VATManag							AS VATManag,
	|	Variances.PermanentDifference				AS PermanentDifference,
	|	Variances.CostTD					AS CostTD,
	|	Variances.AIT AS							AIT
	|
	|INTO TTRoundingUpDeviationsInCOSTOfGoods
	|FROM
	|	TTCashSettlementBalancesDeviationsInCostOfGoods AS Variances
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON Variances.Organization = CostCalculationDocuments.Organization
	|	LEFT JOIN TTResiduesForDeviations AS Balance
	|		ON Variances.Organization = Balance.Organization
	|		AND Variances.Products = Balance.Products
	|		AND Variances.Characteristic = Balance.Characteristic
	|		AND Variances.InventoryOwnerAttribute = Balance.InventoryOwnerAttribute
	|		AND Variances.LineOfBusiness = Balance.LineOfBusiness
	|		AND Variances.Department = Balance.Department
	|		AND Variances.StorageLocation = Balance.StorageLocation
	|WHERE
	|	Balance.Organization IS NULL
	|	AND (Variances.CostVariancesIncludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Variances.CostVariancesExcludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Variances.CostVariancesLocal BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Variances.CostVariancesMgmt BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Variances.AdditionalExpensesIncludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Variances.AdditionalExpensesExcludingVAT BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Variances.AddExpensesLocal BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Variances.AddExpensesMan BETWEEN -&ErrorValueCostOfMan AND &ErrorValueCostOfMan
	|		AND Variances.PermanentDifference BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Variances.CostTD BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Variances.VATLocal BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Variances.VATManag BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|		AND Variances.AIT BETWEEN -&ErrorValueCostLocal AND &ErrorValueCostLocal
	|	)
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	TempTableName = "TTErrorOfDeviationInCostOfGoods";
	TemporaryTableNameSource = "TTRoundingUpDeviationsInCOSTOfGoods";
	
	CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(CalculationParameters, ReceiverDescription, TemporaryTableNameSource);
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, TemporaryTableNameSource);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, TemporaryTableNameSource, TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);

#EndRegion

#Region OtherExpenses

	// Write-off of rounding errors in the register of other expenses
	QueryTextAnalyticsOfRegisteredRecordsOfOtherExpenses =
	"DROP TTRoundingOtherExpenses
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	DistributionDetails.Organization 					AS Organization,
	|	DistributionDetails.Department 				AS Department,
	|	DistributionDetails.ExpenseItem 				AS ExpenseItem,
	|	DistributionDetails.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	DistributionDetails.LineOfBusiness 		AS LineOfBusiness,
	|	DistributionDetails.LocalAccounting
	|		AND NOT DistributionDetails.LeaveAsWIP
	|														AS DeductLocalAccountBalance,
	|	DistributionDetails.TaxAccounting
	|		AND NOT DistributionDetails.LeaveAsWIP
	|														AS WriteOffBalanceTA,
	|	DistributionDetails.ManagementAccounting
	|		AND NOT DistributionDetails.LeaveAsWIP
	|														AS WriteOffManBalance,
	|	DistributionDetails.AIT
	|		AND NOT DistributionDetails.LeaveAsWIP
	|														AS WriteOffBalanceOfPersonalIncomeTax
	|
	|INTO AnalyticsOfRegisteredRecordsOfOtherTimeExpenses
	|FROM
	|	Document.AllocationOfOtherCosts AS DistributionDetails
	|WHERE
	|	DistributionDetails.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND DistributionDetails.Posted
	|	AND DistributionDetails.ExpenseItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	AND DistributionDetails.AssignAllocationSetting <> 
	|		VALUE(Enum.AssignmentOfCostAllocationRules.ExpenseAllocationToFinancialResult)
	|
	|UNION
	|
	|SELECT DISTINCT
	|	DistributionDetails.Organization 					AS Organization,
	|	DistributionDetails.Department 				AS Department,
	|	Balance.ExpenseItem 								AS ExpenseItem,
	|	DistributionDetails.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	Balance.LineOfBusiness 					AS LineOfBusiness,
	|	DistributionDetails.LocalAccounting
	|		AND NOT DistributionDetails.LeaveAsWIP		AS DeductLocalAccountBalance,
	|	DistributionDetails.TaxAccounting
	|		AND NOT DistributionDetails.LeaveAsWIP		AS WriteOffBalanceTA,
	|	DistributionDetails.ManagementAccounting
	|		AND NOT DistributionDetails.LeaveAsWIP		AS WriteOffManBalance,
	|	DistributionDetails.AIT
	|		AND NOT DistributionDetails.LeaveAsWIP		AS WriteOffBalanceOfPersonalIncomeTax
	|FROM
	|	Document.AllocationOfOtherCosts AS DistributionDetails
	|	INNER JOIN TTCashSettlementBalancesOtherExpenses AS Balance
	|		ON	DistributionDetails.DimensionOfExpenses = Balance.DimensionOfExpenses
	|		AND	DistributionDetails.Department = Balance.Department
	|		AND	DistributionDetails.Organization = Balance.Organization
	|WHERE
	|	DistributionDetails.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND DistributionDetails.Posted
	|	AND DistributionDetails.ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	AND DistributionDetails.AssignAllocationSetting <> 
	|		VALUE(Enum.AssignmentOfCostAllocationRules.ExpenseAllocationToFinancialResult)
	|
	|UNION
	|
	|SELECT DISTINCT
	|	Turnovers.Organization 				AS Organization,
	|	Turnovers.Department 				AS Department,
	|	Turnovers.ExpenseItem 				AS ExpenseItem,
	|	Turnovers.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	Turnovers.LineOfBusiness 	AS LineOfBusiness,
	|	TRUE 								AS DeductLocalAccountBalance,
	|	TRUE 								AS WriteOffBalanceTA,
	|	TRUE 								AS WriteOffManBalance,
	|	FALSE 								AS WriteOffBalanceOfPersonalIncomeTax
	|FROM
	|	TTCashEstimatedTurnoverOtherExpenses AS Turnovers
	|WHERE
	|	Turnovers.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND Turnovers.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpenseWithCorrespondenceToProvisions)
	|
	|UNION
	|
	|SELECT
	|	Turnovers.Organization 					AS Organization,
	|	Turnovers.Department 					AS Department,
	|	Turnovers.ExpenseItem 					AS ExpenseItem,
	|	Turnovers.DimensionOfExpenses 				AS DimensionOfExpenses,
	|	Turnovers.LineOfBusiness 		AS LineOfBusiness,
	|	SUM(Turnovers.SumCompl) <> 0			AS DeductLocalAccountBalance,
	|	SUM(Turnovers.SumCompl
	|		- Turnovers.PermanentDifference
	|		- Turnovers.CostTD) <> 0 	AS WriteOffBalanceTA,
	|	SUM(Turnovers.Sum) <> 0
	|	 OR	SUM(Turnovers.AmountExcludingVAT) <> 0
	|	 OR	SUM(Turnovers.SumMan) <> 0	AS WriteOffManBalance,
	|	FALSE 									AS WriteOffBalanceOfPersonalIncomeTax
	|FROM
	|	TTCashEstimatedTurnoverOtherExpenses AS Turnovers
	|WHERE
	|	Turnovers.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND NOT Turnovers.OfficialTypeOfMovementParish
	|	AND VALUETYPE(Turnovers.Recorder) = TYPE(Document.CostCalculationRecorder)
	|GROUP BY
	|	Turnovers.Organization,
	|	Turnovers.Department,
	|	Turnovers.ExpenseItem,
	|	Turnovers.DimensionOfExpenses,
	|	Turnovers.LineOfBusiness
	|
	|UNION
	|
	|SELECT DISTINCT
	|	Balance.Organization 				AS Organization,
	|	Balance.Department 				AS Department,
	|	Balance.ExpenseItem 				AS ExpenseItem,
	|	Balance.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	Balance.LineOfBusiness 	AS LineOfBusiness,
	|	Balance.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToCostOfGoodsSold),
	|	Balance.ExpenseItem.CostAllocationOptionTax = VALUE(Enum.CostAllocationOptions.ToCostOfGoodsSold),
	|	Balance.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToCostOfGoodsSold),
	// There can be no cost of goods selling distribution option in the tax Code
	|	FALSE
	|FROM
	|	TTCashSettlementBalancesOtherExpenses AS Balance
	|WHERE
	|	Balance.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToCostOfGoodsSold)
	|	OR Balance.ExpenseItem.CostAllocationOptionTax = VALUE(Enum.CostAllocationOptions.ToCostOfGoodsSold)
	|	OR Balance.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToCostOfGoodsSold)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Analysts.Organization 					AS Organization,
	|	Analysts.Department 				AS Department,
	|	Analysts.ExpenseItem 				AS ExpenseItem,
	|	Analysts.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	Analysts.LineOfBusiness 		AS LineOfBusiness,
	|	MAX(Analysts.DeductLocalAccountBalance) AS DeductLocalAccountBalance,
	|	MAX(Analysts.WriteOffBalanceTA)	AS WriteOffBalanceTA,
	|	MAX(Analysts.WriteOffManBalance)	AS WriteOffManBalance,
	|	MAX(Analysts.WriteOffBalanceOfPersonalIncomeTax)	AS WriteOffBalanceOfPersonalIncomeTax
	|INTO AnalyticsOfRegisteredRecordsOfOtherExpenses
	|FROM
	|	AnalyticsOfRegisteredRecordsOfOtherTimeExpenses AS Analysts
	|
	|GROUP BY
	|	Analysts.Organization,
	|	Analysts.Department,
	|	Analysts.ExpenseItem,
	|	Analysts.DimensionOfExpenses,
	|	Analysts.LineOfBusiness
	|INDEX BY
	|	Analysts.ExpenseItem,
	|	Analysts.DimensionOfExpenses,
	|	Analysts.Department,
	|	Analysts.LineOfBusiness,
	|	Analysts.Organization
	|";
	
	
	// Let's add a table of options for the distribution of items of expenditure for AIT accounting
	QueryTextAIT = CalculationOfCostLocalization.AITSettingsQueryText("AnalyticsOfRegisteredRecordsOfOtherExpenses", 
																	"CostCalculationCostAdjustment_WriteOffRoundingErrorsOfCostCalculation",
																	CalculationParameters);
	
	QueryTextTTRoundingUpOtherExpenses = "
	|SELECT
	|	OtherExpenses.Organization 					AS Organization,
	|	OtherExpenses.Department 				AS Department,
	|	OtherExpenses.ExpenseItem 				AS ExpenseItem,
	|	OtherExpenses.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	OtherExpenses.LineOfBusiness 		AS LineOfBusiness,
	|
	|	CASE
	|		WHEN OtherExpenses.ExpenseItem.CostAllocationOptionManag IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		 AND ISNULL(Analysts.WriteOffManBalance, FALSE)
	|			THEN OtherExpenses.Sum
	|		ELSE 0
	|	END AS Sum,
	|	CASE
	|		WHEN OtherExpenses.ExpenseItem.CostAllocationOptionManag IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		 AND ISNULL(Analysts.WriteOffManBalance, FALSE)
	|			THEN OtherExpenses.AmountExcludingVAT
	|		ELSE 0
	|	END AS AmountExcludingVAT,
	|	CASE 
	|		WHEN OtherExpenses.ExpenseItem.CostAllocationOptionLocal IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		 AND ISNULL(Analysts.DeductLocalAccountBalance, FALSE)
	|			THEN OtherExpenses.SumCompl
	|		ELSE 0
	|	END AS SumCompl,
	
	|	CASE
	|		WHEN OtherExpenses.ExpenseItem.CostAllocationOptionManag IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		 AND ISNULL(Analysts.WriteOffManBalance, FALSE)
	|			THEN OtherExpenses.SumMan
	|		ELSE 0
	|	END AS SumMan,
	
	|	0 AS PermanentDifference,
	
	
	|	0 AS CostTD,
	|
	|	CASE
	|		WHEN ISNULL(AITArticleDistributionSettings.AITCostAllocationOption, 
	|			VALUE(Enum.CostAllocationOptions.EmptyRef)) IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		 AND ISNULL(Analysts.WriteOffBalanceOfPersonalIncomeTax, FALSE)
	|			THEN OtherExpenses.AITAmount
	|		ELSE 0
	|	END AS AITAmount
	|
	|INTO TTRoundingUpOtherexpensesTime
	|FROM
	|	TTCashSettlementBalancesOtherExpenses AS OtherExpenses
	|		LEFT JOIN AnalyticsOfRegisteredRecordsOfOtherExpenses AS Analysts
	|		ON OtherExpenses.Organization = Analysts.Organization
	|			AND OtherExpenses.Department = Analysts.Department
	|			AND OtherExpenses.ExpenseItem = Analysts.ExpenseItem
	|			AND OtherExpenses.DimensionOfExpenses = Analysts.DimensionOfExpenses
	|			AND OtherExpenses.LineOfBusiness = Analysts.LineOfBusiness
	|		LEFT JOIN AITArticleDistributionSettings AS AITArticleDistributionSettings
	|		ON OtherExpenses.ExpenseItem = AITArticleDistributionSettings.ExpenseItem
	|			AND &OtherExpenses_ObjectOfSeparateAccountingAIT = AITArticleDistributionSettings.ObjectOfSeparateAccountingAIT
	|			AND OtherExpenses.Organization = AITArticleDistributionSettings.Organization
	|WHERE
	|	OtherExpenses.ExpenseItem.CostAllocationOptionManag
	|		IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		AND ISNULL(Analysts.WriteOffManBalance, FALSE)
	|	OR OtherExpenses.ExpenseItem.CostAllocationOptionLocal
	|		IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		AND ISNULL(Analysts.DeductLocalAccountBalance, FALSE)
	|	OR OtherExpenses.ExpenseItem.CostAllocationOptionTax
	|		IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		AND ISNULL(Analysts.WriteOffBalanceTA, FALSE)
	|	OR ISNULL(AITArticleDistributionSettings.AITCostAllocationOption, VALUE(Enum.CostAllocationOptions.EmptyRef))
	|		IN (&AllocationOptionsForWritingOffRoundingErrors)
	|		AND ISNULL(Analysts.WriteOffBalanceOfPersonalIncomeTax, FALSE)
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|
	|	OtherExpenses.Organization 					AS Organization,
	|	OtherExpenses.Department 				AS Department,
	|	OtherExpenses.ExpenseItem 				AS ExpenseItem,
	|	OtherExpenses.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	OtherExpenses.LineOfBusiness 		AS LineOfBusiness,
	|	VALUE(Enum.BusinessTransactions.WriteOffRoundingErrors) AS BusinessOperation,
	|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|
	|	SUM(OtherExpenses.Sum)					AS Sum,
	|	SUM(OtherExpenses.AmountExcludingVAT)			AS AmountExcludingVAT,
	|	SUM(OtherExpenses.SumCompl)				AS SumCompl,
	|	SUM(OtherExpenses.SumMan)				AS SumMan,
	|	SUM(OtherExpenses.PermanentDifference)		AS PermanentDifference,
	|	SUM(OtherExpenses.CostTD)		AS CostTD,
	|	SUM(OtherExpenses.AITAmount)				AS AITAmount
	|INTO TTRoundingOtherExpenses
	|FROM
	|	TTRoundingUpOtherexpensesTime AS OtherExpenses
	|		INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|			ON OtherExpenses.Organization = CostCalculationDocuments.Organization
	|GROUP BY
	|	CostCalculationDocuments.Ref,
	|	OtherExpenses.Organization,
	|	OtherExpenses.Department,
	|	OtherExpenses.LineOfBusiness,
	|	OtherExpenses.ExpenseItem,
	|	OtherExpenses.DimensionOfExpenses
	|
	|HAVING
	|	SUM(OtherExpenses.Sum) BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|	AND SUM(OtherExpenses.AmountExcludingVAT) BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|	AND SUM(OtherExpenses.SumMan) BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|	AND SUM(OtherExpenses.SumCompl) BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	AND SUM(OtherExpenses.PermanentDifference) BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	AND SUM(OtherExpenses.CostTD) BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	AND SUM(OtherExpenses.AITAmount) BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|
	|INDEX BY
	|	Recorder
	|;
	|";
	
	QueryTexts = New Array;
	QueryTexts.Add(QueryTextAnalyticsOfRegisteredRecordsOfOtherExpenses);
	QueryTexts.Add(QueryTextAIT);
	QueryTexts.Add(QueryTextTTRoundingUpOtherExpenses);
	
	Query.Text = StrConcat(QueryTexts, TMCommonUse.RequestSeparatorInPacket_());
	
	CalculationOfCostLocalization.SubstituteAITTypeOfSeparateAccountingObjectInRequest(Query.Text, "OtherExpenses_ObjectOfSeparateAccountingAIT");
	
	AllocationOptionsForWritingOffRoundingErrors = New Array();
	AllocationOptionsForWritingOffRoundingErrors.Add(Enums.CostAllocationOptions.ToInventoryCost);
	AllocationOptionsForWritingOffRoundingErrors.Add(Enums.CostAllocationOptions.ToCostOfGoodsSold);
	AllocationOptionsForWritingOffRoundingErrors.Add(Enums.CostAllocationOptions.ToProductionCosts);
	AllocationOptionsForWritingOffRoundingErrors.Add(Enums.CostAllocationOptions.ToProductionCostDirect);
	AllocationOptionsForWritingOffRoundingErrors.Add(Enums.CostAllocationOptions.ToCostCenters);
	Query.Parameters.Insert("AllocationOptionsForWritingOffRoundingErrors", AllocationOptionsForWritingOffRoundingErrors);
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, 
		"AnalyticsOfRegisteredRecordsOfOtherTimeExpenses, AnalyticsOfRegisteredRecordsOfOtherExpenses,
		|AITArticleDistributionSettings
		|");
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherExpenses.Name,, True);
	DescriptionOfTT.TTResultName = "TTErrorOtherExpenses";
	DescriptionOfTT.NameOfSourceTT = "TTRoundingOtherExpenses";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion
#Region OtherWorkInProgressExpenses

	If CalculationParameters.MonthEndClosingMode <> Enums.MonthEndClosingModes.PreliminaryClosing Then

		// Write-off of rounding errors in the register of other non-consumable production
		Query.Text =
		"DROP TTRoundingOtherExpensesUnfinishedProduction
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	OtherExpensesOfUnfinishedProduction.ExpenseItem	AS ExpenseItem,
		|	OtherExpensesOfUnfinishedProduction.Organization	AS Organization,
		|	OtherExpensesOfUnfinishedProduction.ProductionLot	AS ProductionLot
		|
		|INTO PastProductionLotReferences
		|FROM
		|	TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS OtherExpensesOfUnfinishedProduction
		|	
		|	INNER JOIN Document.CostCalculationRecorder AS RegistrarOfCalculation
		|		ON RegistrarOfCalculation.Ref = OtherExpensesOfUnfinishedProduction.Recorder
		|WHERE
		|	NOT OtherExpensesOfUnfinishedProduction.OfficialTypeOfMovementParish
		|
		// The indexes must correspond to the indexes of the temporary table in the calculation stat of the prochierachievementnotesperformance
		// Described in the function to form the description of the register() #The index area of the register
		|INDEX BY
		|	ExpenseItem,
		|	Organization,
		|	ProductionLot
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CostCalculationDocuments.Ref	AS Recorder,
		|	&EndOfPeriod							AS Period,
		|	VALUE(AccumulationRecordType.Expense)	AS RecordType,
		|	OtherExpensesOfUnfinishedProduction.Organization			AS Organization,
		|	OtherExpensesOfUnfinishedProduction.Department			AS Department,
		|	OtherExpensesOfUnfinishedProduction.LineOfBusiness AS LineOfBusiness,
		|	OtherExpensesOfUnfinishedProduction.ProductionLot		AS ProductionLot,
		|	OtherExpensesOfUnfinishedProduction.ProductionOrder	AS ProductionOrder,
		|	OtherExpensesOfUnfinishedProduction.RowCodeProducts		AS RowCodeProducts,
		|	OtherExpensesOfUnfinishedProduction.Stage					AS Stage,
		|	OtherExpensesOfUnfinishedProduction.ProductCostElement		AS ProductCostElement,
		|	OtherExpensesOfUnfinishedProduction.ExpenseItem			AS ExpenseItem,
		|	OtherExpensesOfUnfinishedProduction.DimensionOfExpenses		AS DimensionOfExpenses,
		|	OtherExpensesOfUnfinishedProduction.ProductsGroup		AS ProductsGroup,
		|	OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
		|	VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
		|	OtherExpensesOfUnfinishedProduction.Cost				AS Cost,
		|	OtherExpensesOfUnfinishedProduction.CostExcludingVAT		AS CostExcludingVAT,
		|	OtherExpensesOfUnfinishedProduction.LocalCost			AS LocalCost,
		|	OtherExpensesOfUnfinishedProduction.CostMan			AS CostMan,
		|	OtherExpensesOfUnfinishedProduction.PermanentDifference		AS PermanentDifference,
		|	OtherExpensesOfUnfinishedProduction.CostTD		AS CostTD,
		|	OtherExpensesOfUnfinishedProduction.CostOfPersonalIncomeTax			AS CostOfPersonalIncomeTax,
		|	OtherExpensesOfUnfinishedProduction.CostShare			AS CostShare
		|INTO TTRoundingOtherExpensesUnfinishedProduction
		|FROM
		|	TTCashSettlementBalancesOtherWorkInProgressExpenses AS OtherExpensesOfUnfinishedProduction
		|		LEFT JOIN AnalystsOfExpenditureRegisteredRecordsOfItemByItemExpenses AS TurnoverOfExpenses
		|		ON OtherExpensesOfUnfinishedProduction.Organization = TurnoverOfExpenses.Organization
		|			AND OtherExpensesOfUnfinishedProduction.Department = TurnoverOfExpenses.Department
		|			AND OtherExpensesOfUnfinishedProduction.ExpenseItem = TurnoverOfExpenses.ExpenseItem
		|			AND OtherExpensesOfUnfinishedProduction.DimensionOfExpenses = TurnoverOfExpenses.DimensionOfExpenses
		|			AND OtherExpensesOfUnfinishedProduction.LineOfBusiness = TurnoverOfExpenses.LineOfBusiness
		|			AND OtherExpensesOfUnfinishedProduction.ProductionLot = TurnoverOfExpenses.ProductionLot
		|			AND OtherExpensesOfUnfinishedProduction.ProductionOrder = TurnoverOfExpenses.ProductionOrder
		|			AND OtherExpensesOfUnfinishedProduction.RowCodeProducts = TurnoverOfExpenses.RowCodeProducts
		|			AND OtherExpensesOfUnfinishedProduction.Stage = TurnoverOfExpenses.Stage
		|			AND OtherExpensesOfUnfinishedProduction.ProductCostElement = TurnoverOfExpenses.ProductCostElement
		|			AND OtherExpensesOfUnfinishedProduction.ProductsGroup = TurnoverOfExpenses.ProductsGroup
		|			AND OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = TurnoverOfExpenses.RuleOfCostAllocatingToProductionLots
		|
		|		LEFT JOIN TTCostCalculationDocuments AS CostCalculationDocuments
		|			ON OtherExpensesOfUnfinishedProduction.Organization = CostCalculationDocuments.Organization
		|		
		|		LEFT JOIN RemnantsOfDistributionBases AS Material_
		|		ON OtherExpensesOfUnfinishedProduction.Organization = Material_.Organization
		|			AND OtherExpensesOfUnfinishedProduction.Department = Material_.Department
		|			AND OtherExpensesOfUnfinishedProduction.ProductionLot = Material_.ProductionLot
		|			AND OtherExpensesOfUnfinishedProduction.ProductionOrder = Material_.ProductionOrder
		|			AND OtherExpensesOfUnfinishedProduction.RowCodeProducts = Material_.RowCodeProducts
		|			AND (CASE
		|				WHEN OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialCosts)
		|						OR OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialAndLaborCosts)
		|					THEN Material_.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialCosts)
		|				ELSE FALSE
		|			END)
		|		LEFT JOIN RemnantsOfDistributionBases AS LaborCosts
		|		ON OtherExpensesOfUnfinishedProduction.Organization = LaborCosts.Organization
		|			AND OtherExpensesOfUnfinishedProduction.Department = LaborCosts.Department
		|			AND OtherExpensesOfUnfinishedProduction.ProductionLot = LaborCosts.ProductionLot
		|			AND OtherExpensesOfUnfinishedProduction.ProductionOrder = LaborCosts.ProductionOrder
		|			AND OtherExpensesOfUnfinishedProduction.RowCodeProducts = LaborCosts.RowCodeProducts
		|			AND (CASE
		|				WHEN OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByLaborCosts)
		|						OR OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByMaterialAndLaborCosts)
		|					THEN LaborCosts.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByLaborCosts)
		|				ELSE FALSE
		|			END)	
		|		LEFT JOIN RemnantsOfDistributionBases AS ManufacturedProduct
		|		ON OtherExpensesOfUnfinishedProduction.Organization = ManufacturedProduct.Organization
		|			AND ManufacturedProduct.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
		|			AND OtherExpensesOfUnfinishedProduction.ProductionLot = ManufacturedProduct.ProductionLot
		|			AND OtherExpensesOfUnfinishedProduction.ProductionOrder = ManufacturedProduct.ProductionOrder
		|			AND OtherExpensesOfUnfinishedProduction.RowCodeProducts = ManufacturedProduct.RowCodeProducts
		|			AND (CASE
		|					WHEN OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.ByProductsIncludingFutureReleases)
		|						THEN ManufacturedProduct.RuleOfCostAllocatingToProductionLots = OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots
		|					ELSE FALSE
		|				END)
		|		LEFT JOIN RemnantsOfDistributionBases AS ManufacturedProduct21
		|		ON OtherExpensesOfUnfinishedProduction.Organization = ManufacturedProduct21.Organization
		|			AND ManufacturedProduct21.Department = VALUE(Catalog.BusinessStructure.EmptyRef)
		|			AND OtherExpensesOfUnfinishedProduction.ProductionLot = ManufacturedProduct21.ProductionLot
		|			AND OtherExpensesOfUnfinishedProduction.ProductionOrder = ManufacturedProduct21.ProductionOrder
		|			AND OtherExpensesOfUnfinishedProduction.RowCodeProducts = ManufacturedProduct21.RowCodeProducts
		|			AND (CASE
		|					WHEN OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots = VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef)
		|						THEN ManufacturedProduct21.RuleOfCostAllocatingToProductionLots = OtherExpensesOfUnfinishedProduction.RuleOfCostAllocatingToProductionLots
		|					ELSE FALSE
		|				END)
		|		LEFT JOIN CompletedBatches AS CompletedBatches
		|		ON OtherExpensesOfUnfinishedProduction.ProductionLot = CompletedBatches.Lot
		|
		|		LEFT JOIN PastProductionLotReferences AS PastLotReferences
		|		ON PastLotReferences.ExpenseItem = OtherExpensesOfUnfinishedProduction.ExpenseItem
		|			AND PastLotReferences.Organization = OtherExpensesOfUnfinishedProduction.Organization
		|			AND PastLotReferences.ProductionLot = OtherExpensesOfUnfinishedProduction.ProductionLot
		|WHERE
		|	OtherExpensesOfUnfinishedProduction.Cost BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
		|	AND OtherExpensesOfUnfinishedProduction.CostExcludingVAT BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
		|	AND OtherExpensesOfUnfinishedProduction.CostMan BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
		|	AND OtherExpensesOfUnfinishedProduction.LocalCost BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
		|	AND OtherExpensesOfUnfinishedProduction.PermanentDifference BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
		|	AND OtherExpensesOfUnfinishedProduction.CostTD BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
		|	AND OtherExpensesOfUnfinishedProduction.CostOfPersonalIncomeTax BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
		|	AND OtherExpensesOfUnfinishedProduction.CostShare BETWEEN -&ErrorValueQuantity AND &ErrorValueQuantity
		|	AND (NOT TurnoverOfExpenses.Organization IS NULL
		|		OR NOT CompletedBatches.Lot IS NULL
		|		OR NOT PastLotReferences.ProductionLot IS NULL
		|		OR NOT &BatchAccountingVersion22)
		|	AND ((NOT &BatchAccountingVersion22) 
		|		OR NOT PastLotReferences.ProductionLot IS NULL // for batches of previous periods, we write off all Balances
		|		OR (ISNULL(Material_.Balance, 0) + ISNULL(Material_.BalanceWithoutVAT, 0) + ISNULL(Material_.RemainderOfLocal, 0) + ISNULL(Material_.BalanceMan, 0)
		|			+ ISNULL(LaborCosts.Balance, 0) + ISNULL(LaborCosts.BalanceWithoutVAT, 0) + ISNULL(LaborCosts.RemainderOfLocal, 0) + ISNULL(LaborCosts.BalanceMan, 0) 
		|			+ ISNULL(ManufacturedProduct.Balance, 0) + ISNULL(ManufacturedProduct21.Balance, 0)) = 0)
		|INDEX BY
		|	Recorder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP AnalystsOfExpenditureRegisteredRecordsOfItemByItemExpenses
		|;
		|";
		
		CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
		
		DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name,, True);
		DescriptionOfTT.TTResultName = "TTErrorOtherCostsUnfinishedProduction";
		DescriptionOfTT.NameOfSourceTT = "TTRoundingOtherExpensesUnfinishedProduction";
		
		GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	EndIf;
	
#EndRegion

#Region FutureExpenseCommitments

	If CalculationParameters.MonthEndClosingMode <> Enums.MonthEndClosingModes.PreliminaryClosing Then

		// Write-off of rounding errors in the Reserve register of current expenditures
		Query.Text =
		"DROP TTRoundingProvisionsForUpcomingExpenses
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|SELECT
		|	CostCalculationDocuments.Ref		AS Recorder,
		|	&EndOfPeriod								AS Period,
		|	VALUE(AccumulationRecordType.Receipt)		AS RecordType,
		|
		|	Reserves.Organization							AS Organization,
		|	Reserves.ReserveKind							AS ReserveKind,
		|	Reserves.LineOfBusiness				AS LineOfBusiness,
		|	Reserves.ProvisionObject					AS ProvisionObject,
		|	Reserves.ProvisionObject.BusinessUnitWriteOffs AS Department,
		|
		|	CASE WHEN Reserves.SumMan BETWEEN 0 AND &ErrorValueManCosts
		|		THEN - Reserves.SumMan
		|		ELSE 0
		|	END										AS SumMan,
		|	CASE WHEN Reserves.SumCompl BETWEEN 0 AND &ValueOfErrorCostsRegl
		|		THEN - Reserves.SumCompl
		|		ELSE 0
		|	END										AS SumCompl,
		|	CASE WHEN Reserves.AmountFA BETWEEN 0 AND &ValueOfErrorCostsRegl
		|		THEN - Reserves.AmountFA
		|		ELSE 0
		|	END										AS AmountFA
		|INTO TTRoundingProvisionsForUpcomingExpenses
		|FROM
		|	TTCashSettlementBalancesProvisionsForFutureExpenses AS Reserves
		|		LEFT JOIN TTCostCalculationDocuments AS CostCalculationDocuments
		|			ON Reserves.Organization = CostCalculationDocuments.Organization
		|
		|WHERE
		|	(Reserves.SumMan BETWEEN 0 AND &ErrorValueManCosts
		|		OR Reserves.SumCompl BETWEEN 0 AND &ValueOfErrorCostsRegl
		|		OR Reserves.AmountFA BETWEEN 0 AND &ValueOfErrorCostsRegl)
		|INDEX BY
		|	Recorder
		|";
		
		CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
		
		DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.FutureExpenseCommitments.Name,, True);
		DescriptionOfTT.TTResultName = "TTMarginOfErrorProvisionsForUpcomingExpenses";
		DescriptionOfTT.NameOfSourceTT = "TTRoundingProvisionsForUpcomingExpenses";
		
		GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	EndIf;
	
#EndRegion
#Region OtherExpenses_MotionCor

	// Formation of cor. movements in the register of other expenses
	Query.Text =
	"SELECT
	|	T.Recorder 																	AS Recorder,
	|	&EndOfPeriod 																	AS Period,
	|	VALUE(AccumulationRecordType.Receipt) 											AS RecordType,
	|	T.Organization 																	AS Organization,
	|	T.Department																	AS Department,
	|	T.LineOfBusiness														AS LineOfBusiness,
	|	ArticleOfError.Ref														AS ExpenseItem,
	|	T.FinRecordID														AS FinRecordID,
	|	VALUE(Enum.BusinessTransactions.WriteOffRoundingErrors)			AS BusinessOperation,
	|	T.BusinessTransactionSetting												AS BusinessTransactionSetting,
	|	SUM(T.Sum) 																	AS Sum,
	|	SUM(T.SumCompl) 																AS SumCompl,
	|	SUM(CASE
	|		WHEN NOT &ErrorIsTakenInternally
	|			THEN T.SumCompl - T.CostTD
	|		ELSE T.PermanentDifference END)											AS PermanentDifference,
	|	SUM(T.CostTD)														AS CostTD,
	|	SUM(T.AITAmount) 																AS AITAmount,
	|	SUM(T.SumMan) 																AS SumMan
	|INTO TTCorOtherExpenses
	|FROM
	|	(SELECT
	|		T.Recorder 				 	 AS Recorder,
	|		T.Organization 					 AS Organization,
	|		T.Department 				 AS Department,
	|		T.LineOfBusiness 		 AS LineOfBusiness,
	|		T.FinRecordID		 AS FinRecordID,
	|		T.BusinessTransactionSetting AS BusinessTransactionSetting,
	|		T.Cost
	|			+ T.AddExpensesForGoods
	|			+ T.LaborCosts
	|			+ T.ItemizedFixedCostsIncludingVAT
	|			+ T.ItemizedVariableCostsIncludingVAT AS Sum,
	|		T.LocalCost
	|			+ T.AddExpensesLocal
	|			+ T.LaborCostsLocal
	|			+ T.ItemizedFixedCostsCompl
	|			+ T.ItemizedVariableCostsCompl
	|			+ T.ProvisionForImpairmentLocal AS SumCompl,
	|		T.PermanentDifference,
	|		T.CostTD,
	|		T.CostOfPersonalIncomeTax AS AITAmount,
	|		T.CostMan
	|			+ T.AddExpensesMan
	|			+ T.LaborCostsMan
	|			+ T.ItemizedFixedCostsManag
	|			+ T.ItemizedVariableCostsManag
	|			+ T.ProvisionForImpairmentMan AS SumMan
	|	FROM
	|		TTRoundingCostOfGoods AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		T.Recorder 				 	 AS Recorder,
	|		T.Organization 					 AS Organization,
	|		T.Department 				 AS Department,
	|		T.LineOfBusiness 		 AS LineOfBusiness,
	|		T.FinRecordID		 AS FinRecordID,
	|		T.BusinessTransactionSetting AS BusinessTransactionSetting,
	|		T.CostVariancesIncludingVAT
	|			+ T.AdditionalExpensesIncludingVAT AS Sum,
	|		T.CostVariancesLocal
	|			+ T.AddExpensesLocal
	|			+ T.VATLocal AS SumCompl,
	|		T.PermanentDifference,
	|		T.CostTD,
	|		T.AIT AS AITAmount,
	|		T.CostVariancesMgmt
	|			+ T.AddExpensesMan
	|			+ T.VATManag AS SumMan
	|	FROM
	|		TTRoundingUpDeviationsInCOSTOfGoods AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Recorder,
	|		T.Organization,
	|		T.Department,
	|		T.LineOfBusiness,
	|		T.FinRecordID,
	|		T.BusinessTransactionSetting,
	|		T.Sum,
	|		T.SumCompl,
	|		CASE
	|			WHEN &ErrorIsTakenInternally THEN T.PermanentDifference
	|			ELSE T.SumCompl - T.CostTD END AS PermanentDifference,
	|		T.CostTD AS CostTD,
	|		T.AITAmount,
	|		T.SumMan
	|	FROM
	|		TTRoundingOtherExpenses AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Recorder,
	|		T.Organization,
	|		T.Department,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef),
	|		T.FinRecordID,
	|		T.BusinessTransactionSetting,
	|		T.Cost,
	|		T.LocalCost,
	|		CASE
	|			WHEN &ErrorIsTakenInternally THEN T.PermanentDifference
	|			ELSE T.LocalCost - T.CostTD END AS PermanentDifference,
	|		T.CostTD AS CostTD,
	|		T.CostOfPersonalIncomeTax AS AITAmount,
	|		T.CostMan
	|	FROM
	|		TTRoundingOtherExpensesUnfinishedProduction AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Recorder,
	|		T.Organization,
	|		T.Department,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef),
	|		T.FinRecordID,
	|		VALUE(Catalog.BusinessTransactionsSettings.WriteOffRoundingErrors) AS BusinessTransactionSetting,
	|		T.SumMan,
	|		T.SumCompl,
	|		CASE WHEN &ErrorIsTakenInternally THEN 0 ELSE T.SumCompl END,
	|		CASE WHEN &ErrorIsTakenInternally THEN T.SumCompl - T.AmountFA ELSE 0 END,
	|		0 AS AITAmount,
	|		T.SumMan
	|	FROM
	|		TTRoundingProvisionsForUpcomingExpenses AS T) AS T
	|
	|	INNER JOIN ChartOfCharacteristicTypes.ExpenseItems AS ArticleOfError
	|		ON ArticleOfError.Ref = VALUE(ChartOfCharacteristicTypes.ExpenseItems.CostCalculationError)
	|
	|GROUP BY
	|	T.Recorder,
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	ArticleOfError.Ref,
	|	T.FinRecordID,
	|	T.BusinessTransactionSetting
	|
	|HAVING
	|	SUM(T.Sum) <> 0
	|	OR SUM(T.SumCompl) <> 0
	|	OR SUM(T.PermanentDifference) <> 0
	|	OR SUM(T.CostTD) <> 0
	|	OR SUM(T.AITAmount) <> 0
	|	OR SUM(T.SumMan) <> 0
	|";
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherExpenses.Name);
	DescriptionOfTT.TTResultName = "TTErrorCorOtherExpenses";
	DescriptionOfTT.NameOfSourceTT = "TTCorOtherExpenses";
		
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);

	MatchingTemporaryMovementTables = New Map;
	
#Region OtherMaterialsOverheadsForAllocationChangeOfAccountingPolicy

	// Write-off of the Balance of production items when changing the accounting policy from FIFO to average.
	// When accounting for the average, such articles are not supported.
	Query.Text = "
	|SELECT TOP 0
	|	T.Ref,
	|	0 AS ManSCoefficient,
	|	0 AS LocalCoefficient
	|INTO TTItemsOfProductionCostsChangeOfPolicy
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS T
	|INDEX BY
	|	Ref
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument,
	|	T.LotVendorAttributes,
	|	T.LineOfBusiness,
	|	T.ItemsLocationAttributes,
	|	T.VATActivityType,
	|	T.Cost * Filter.ManSCoefficient AS Cost,
	|	T.CostExcludingVAT * Filter.ManSCoefficient AS CostExcludingVAT,
	|	T.LocalCost * Filter.LocalCoefficient AS LocalCost,
	|	T.VATLocal * Filter.LocalCoefficient AS VATLocal,
	|	T.PermanentDifference * Filter.LocalCoefficient AS PermanentDifference,
	|	T.CostTD * Filter.LocalCoefficient AS CostTD,
	|	T.VATManag * Filter.ManSCoefficient AS VATManag
	|INTO TTBalanceOfMaterialOverheadsForAllocationChangeOfPolicy
	|FROM
	|	TTCashSettlementBalancesForOtherExpenses AS T
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON T.Organization = CostCalculationDocuments.Organization
	|   INNER JOIN TTItemsOfProductionCostsChangeOfPolicy AS Filter
	|       ON T.ExpenseItem = Filter.Ref
	|WHERE
	|	&BatchAccountingVersion22
	|   AND T.Organization IN (&SFIFOOrganizationsMovingAverageInPreviousPeriod)
	|   AND NOT T.Organization IN (&SFIFOOrganizationsSliding)
	|
	|UNION
	|
	// When accounting on a medium-sliding basis, items allocated to cost and production in batches of other expenses are not yet supported.
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument,
	|	T.LotVendorAttributes,
	|	T.LineOfBusiness,
	|	T.ItemsLocationAttributes,
	|	T.VATActivityType,
	|	T.Cost * Filter.ManSCoefficient AS Cost,
	|	T.CostExcludingVAT * Filter.ManSCoefficient AS CostExcludingVAT,
	|	T.LocalCost * Filter.LocalCoefficient AS LocalCost,
	|	T.VATLocal * Filter.LocalCoefficient AS VATLocal,
	|	T.PermanentDifference * Filter.LocalCoefficient AS PermanentDifference,
	|	T.CostTD * Filter.LocalCoefficient AS CostTD,
	|	T.VATManag * Filter.ManSCoefficient AS VATManag
	|FROM
	|	TTCashSettlementBalancesForOtherExpenses AS T
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON T.Organization = CostCalculationDocuments.Organization
	|   INNER JOIN TTCostItemsForOtherBatches AS Filter
	|       ON T.ExpenseItem = Filter.Ref
	|WHERE
	|	&BatchAccountingVersion22
	|   AND NOT T.Organization IN (&OrganizationsAverageMovingAverageInLastPeriod)
	|   AND T.Organization IN (&MediumSlipOrganizations)
	|";

	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name,, True);
	DescriptionOfTT.TTResultName = "TTOfMaterialOverheadsForAllocationPolicyChange";
	DescriptionOfTT.NameOfSourceTT = "TTBalanceOfMaterialOverheadsForAllocationChangeOfPolicy";
		
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);

	MatchingTemporaryMovementTables = New Map;

#Region LotsOfOtherExpensesExpandedBalance

	// Write-off of the expanded balance in the register of parties and other expenses
	Query.Text = "
	|SELECT
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument,
	|	CAST(T.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	|	T.ItemsLocationAttributes,
	|	T.VATActivityType,
	|	T.Cost,
	|	T.CostExcludingVAT,
	|	T.LocalCost,
	|	T.VATLocal,
	|	T.PermanentDifference,
	|	T.CostTD,
	|	T.VATManag
	|INTO TTBalanceOfOtherExpensesFull
	|FROM
	|	TTCashSettlementBalancesForOtherExpenses AS T
	|WHERE
	|	&BatchAccountingVersion22
	|	AND (T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|		OR T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation))
	|INDEX BY
	|	Organization,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Department,
	|	LineOfBusiness
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	SUM(T.Cost) AS Cost,
	|	SUM(T.CostExcludingVAT) AS CostExcludingVAT,
	|	SUM(T.LocalCost) AS LocalCost,
	|	SUM(T.VATLocal) AS VATLocal,
	|	SUM(T.PermanentDifference) AS PermanentDifference,
	|	SUM(T.CostTD) AS CostTD,
	|	SUM(T.VATManag) AS VATManag
	|INTO TTBalanceOfBatchOfOtherExpensesRolledUp
	|FROM
	|	TTBalanceOfOtherExpensesFull AS T
	|GROUP BY
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses
	|HAVING
	|	(SUM(T.Cost) <> 0 AND T.ExpenseItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.VATOfTaxAgent))
	|	OR SUM(T.CostExcludingVAT) <> 0
	|	OR SUM(T.LocalCost) <> 0
	|INDEX BY
	|	Organization,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Department,
	|	LineOfBusiness
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	SUM(T.CostBalance) AS Cost,
	|	SUM(T.CostExcludingVATBalance) AS CostExcludingVAT,
	|	SUM(T.LocalCostBalance) AS LocalCost,
	|	SUM(T.VATLocalBalance) AS VATLocal,
	|	SUM(T.PermanentDifferenceBalance) AS PermanentDifference,
	|	SUM(T.CostTDBalance) AS CostTD,
	|	SUM(T.VATManagBalance) AS VATManag
	|INTO TTInitialBalanceOfBatchOfOtherExpenses
	|FROM
	|	AccumulationRegister.ItemisedExpensesLots.Balance(&BorderEndOfPreviousPeriod,
	|		(Organization, Department, LineOfBusiness, ExpenseItem, DimensionOfExpenses)
	|			IN (SELECT Organization, Department, LineOfBusiness, ExpenseItem, DimensionOfExpenses FROM TTBalanceOfBatchOfOtherExpensesRolledUp)) AS T
	|GROUP BY
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses
	|INDEX BY
	|	Organization,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Department,
	|	LineOfBusiness
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses
	|INTO TTRevolutionsAccordingToDocuments
	|FROM
	|	TTCashEstimatedTurnoverAndOtherExpenses AS T
	|WHERE
	|	NOT VALUETYPE(T.Recorder) IN
	|		(TYPE(Document.InventoryCostCalculation),
	|		 TYPE(Document.RegisterAdjustment),
	|		 TYPE(Document.OtherIncomeExpenses))
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses
	|INTO TTBalanceOtherExpensesFull
	|FROM
	|	TTCashSettlementBalancesOtherExpenses AS T
	|WHERE
	|	&BatchAccountingVersion22
	|	AND (T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|		 AND (T.Sum <> 0 OR T.AmountExcludingVAT <> 0)
	|		OR T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|		 AND (T.SumCompl <> 0))
	|INDEX BY
	|	Organization,
	|	ExpenseItem,
	|	DimensionOfExpenses,
	|	Department,
	|	LineOfBusiness
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument,
	|	T.LotVendorAttributes,
	|	T.ItemsLocationAttributes,
	|	T.VATActivityType,
	|	T.VATActivityType AS VATTaxation,
	// To exclude Register Records from VAT and transaction mechanisms
	|	VALUE(Enum.LotRecordTypes.Estimated) AS EntryType,
	|	VALUE(Catalog.BusinessTransactionsSettings.ExpenseAllocationToCost) AS BusinessTransactionSetting,
	|	T.Cost,
	|	T.CostExcludingVAT,
	|	T.LocalCost,
	|	T.VATLocal,
	|	T.PermanentDifference,
	|	T.CostTD,
	|	T.VATManag
	|INTO TTWriteOffOfExpandedBalanceOfLotsOfOtherExpenses
	|FROM
	|	TTBalanceOfOtherExpensesFull AS T
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON T.Organization = CostCalculationDocuments.Organization
	|	LEFT JOIN TTBalanceOfBatchOfOtherExpensesRolledUp AS Filter1
	|		ON T.ExpenseItem = Filter1.ExpenseItem
	|		 AND  T.DimensionOfExpenses = Filter1.DimensionOfExpenses
	|		 AND  T.Department = Filter1.Department
	|		 AND  T.Organization = Filter1.Organization
	|		 AND  T.LineOfBusiness = Filter1.LineOfBusiness
	|	LEFT JOIN TTBalanceOtherExpensesFull AS Filter2
	|		ON T.ExpenseItem = Filter2.ExpenseItem
	|		 AND  T.DimensionOfExpenses = Filter2.DimensionOfExpenses
	|		 AND  T.Department = Filter2.Department
	|		 AND  T.Organization = Filter2.Organization
	|		 AND  T.LineOfBusiness = Filter2.LineOfBusiness
	|WHERE
	|	(Filter1.ExpenseItem IS NULL
	|	 OR (Filter1.Cost BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|	 	  AND Filter1.CostExcludingVAT BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|	 	  AND Filter1.LocalCost BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	 	  AND Filter1.VATLocal BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	 	  AND Filter1.PermanentDifference BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	 	  AND Filter1.CostTD BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|	 	  AND Filter1.VATManag BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts)
	|	 OR (Filter1.LocalCost = -Filter1.VATLocal
	|		  AND Filter1.Cost = 0
	|		  AND Filter1.CostExcludingVAT = 0))
	|	AND Filter2.ExpenseItem IS NULL
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	// we write off the Balance by lots of other expenses in the following case:
	//	- there are Balances on lots of other expenses
	//  - there are "rolled up" Balances on lots of other expenses (i.e. the problem is not in the differences in movements according to the receipt document)
	//  - there are no Balances of other expenses
	//  - there are no initial Balances in batches of other expenses
	//	- movements in the Cur period for batches of other expenses are available only for official documents
	//  , i.e. if the Balances of batches of other expenses arose in the Cur period due to movements of official documents,
	//  despite the fact that the register of other expenses is closed, then such Balances can be written off.
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument,
	|	T.LotVendorAttributes,
	|	T.ItemsLocationAttributes,
	|	T.VATActivityType,
	|	T.VATActivityType AS VATTaxation,
	|	VALUE(Enum.LotRecordTypes.Estimated) AS EntryType,
	|	T.Cost,
	|	T.CostExcludingVAT,
	|	T.LocalCost,
	|	T.VATLocal,
	|	T.PermanentDifference,
	|	T.CostTD,
	|	T.VATManag
	|INTO TTWriteOffOfBalancesOnOfficialDocuments
	|FROM
	|	TTBalanceOfOtherExpensesFull AS T
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON T.Organization = CostCalculationDocuments.Organization
	|	LEFT JOIN TTBalanceOfBatchOfOtherExpensesRolledUp AS Filter1
	|		ON T.ExpenseItem = Filter1.ExpenseItem
	|		 AND  T.DimensionOfExpenses = Filter1.DimensionOfExpenses
	|		 AND  T.Department = Filter1.Department
	|		 AND  T.Organization = Filter1.Organization
	|		 AND  T.LineOfBusiness = Filter1.LineOfBusiness
	|	LEFT JOIN TTBalanceOtherExpensesFull AS Filter2
	|		ON T.ExpenseItem = Filter2.ExpenseItem
	|		 AND  T.DimensionOfExpenses = Filter2.DimensionOfExpenses
	|		 AND  T.Department = Filter2.Department
	|		 AND  T.Organization = Filter2.Organization
	|		 AND  T.LineOfBusiness = Filter2.LineOfBusiness
	|	LEFT JOIN TTInitialBalanceOfBatchOfOtherExpenses AS Filter3
	|		ON T.ExpenseItem = Filter3.ExpenseItem
	|		 AND  T.DimensionOfExpenses = Filter3.DimensionOfExpenses
	|		 AND  T.Department = Filter3.Department
	|		 AND  T.Organization = Filter3.Organization
	|		 AND  T.LineOfBusiness = Filter3.LineOfBusiness
	|	LEFT JOIN TTRevolutionsAccordingToDocuments AS Filter4
	|		ON T.ExpenseItem = Filter4.ExpenseItem
	|		 AND  T.DimensionOfExpenses = Filter4.DimensionOfExpenses
	|		 AND  T.Department = Filter4.Department
	|		 AND  T.Organization = Filter4.Organization
	|		 AND  T.LineOfBusiness = Filter4.LineOfBusiness
	|WHERE
	|	NOT Filter1.ExpenseItem IS NULL
	|	AND Filter2.ExpenseItem IS NULL
	|	AND Filter3.ExpenseItem IS NULL
	|	AND Filter4.ExpenseItem IS NULL
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Recorder,
	|	T.Period,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	|	T.LotVendorAttributes.Counterparty AS Vendor,
	|	CASE WHEN VALUETYPE(T.ExpenseReceiptDocument) IN (&TypesOfBatchDocuments)
	|		THEN T.ExpenseReceiptDocument
	|		ELSE UNDEFINED
	|	END AS ExpenseReceiptDocument,
	|	T.VATActivityType,
	|	T.LotVendorAttributes.AssetTaxClass AS AssetTaxClass,
	|	T.LotVendorAttributes.VATRate AS VATRate,
	|	T.LocalCost AS LocalCost,
	|	T.VATLocal AS VATLocal,
	|	T.VATManag AS VATManag
	|INTO TTRoundingUpLotsVATForAllocation
	|FROM
	|	TTWriteOffOfExpandedBalanceOfLotsOfOtherExpenses AS T
	|WHERE
	|	T.VATActivityType = VALUE(Enum.VATTaxationTypes.DeterminedByAllocation)
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	// Lots of other expenses, expanded balance
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name,, True);
	DescriptionOfTT.TTResultName = "TTExpandedBalanceOfLotsOfOtherExpenses";
	DescriptionOfTT.NameOfSourceTT = "TTWriteOffOfExpandedBalanceOfLotsOfOtherExpenses";
		
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	// lots of other expenses, Balances on official documents
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name,, True);
	DescriptionOfTT.TTResultName = "ServiceBalancesOfLotsOfOtherExpensesTT";
	DescriptionOfTT.NameOfSourceTT = "TTWriteOffOfBalancesOnOfficialDocuments";
		
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	
#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);

	MatchingTemporaryMovementTables = New Map;
	
#Region ItemisedExpensesLots

	// Write-off of rounding errors in the batch register of other expenses
	Query.Text = "
	|SELECT
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument AS ExpenseReceiptDocument,
	|	T.LotVendorAttributes AS LotVendorAttributes,
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.VATActivityType AS VATActivityType,
	|
	|	CASE WHEN T.Cost BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|		AND T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.Cost
	|		ELSE 0
	|	END AS Cost,
	|	CASE WHEN T.CostExcludingVAT BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|		AND T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.CostExcludingVAT
	|		ELSE 0
	|	END AS CostExcludingVAT,
	|	CASE WHEN T.LocalCost BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|		AND T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.LocalCost
	|		ELSE 0
	|	END AS LocalCost,
	|	CASE WHEN T.VATLocal BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|		AND T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.VATLocal
	|		ELSE 0
	|	END AS VATLocal,
	|	CASE WHEN T.PermanentDifference BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|		AND T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.PermanentDifference
	|		ELSE 0
	|	END AS PermanentDifference,
	|	CASE WHEN T.CostTD BETWEEN -&ValueOfErrorCostsRegl AND &ValueOfErrorCostsRegl
	|		AND T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.CostTD
	|		ELSE 0
	|	END AS CostTD,
	|	CASE WHEN T.VATManag BETWEEN -&ErrorValueManCosts AND &ErrorValueManCosts
	|		AND T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		THEN T.VATManag
	|		ELSE 0
	|	END AS VATManag
	|INTO TTBatchBalancesOfOtherExpenses
	|FROM
	|	TTCashSettlementBalancesForOtherExpenses AS T
	|WHERE
	|	&BatchAccountingVersion22
	|	AND (T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|		OR T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation))
	|INDEX BY
	|	ExpenseItem,
	|	Department,
	|	Organization
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	MAX(CASE
	|		WHEN T.ExpenseItem.CostAllocationOptionManag IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 	  AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|				THEN CASE WHEN T.Sum <> 0 OR T.AmountExcludingVAT <> 0 OR T.SumMan <> 0 THEN FALSE ELSE TRUE END
	|				ELSE FALSE
	|		END) AS WriteOffMan,
	|	MAX(CASE
	|		WHEN T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 	  AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|				THEN CASE WHEN T.SumCompl <> 0 THEN FALSE ELSE TRUE END
	|				ELSE FALSE
	|		END) AS WriteOffLocalControl,
	|	MAX(CASE
	|		WHEN T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 	  AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|				THEN CASE WHEN T.PermanentDifference <> 0 THEN FALSE ELSE TRUE END
	|				ELSE FALSE
	|		END) AS WriteOffPD,
	|	MAX(CASE
	|		WHEN T.ExpenseItem.CostAllocationOptionLocal IN (
	|			VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|			VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|		 	  AND T.ExpenseItem.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|				THEN CASE WHEN T.CostTD <> 0 THEN FALSE ELSE TRUE END
	|				ELSE FALSE
	|		END) AS WriteOffTD
	|INTO TTBalancesOtherExpenses
	|FROM
	|	TTCashSettlementBalancesOtherExpenses AS T
	|WHERE
	|	&BatchAccountingVersion22
	|GROUP BY
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses
	|INDEX BY
	|	ExpenseItem,
	|	Department,
	|	Organization
	|;
	|//////////////////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CostCalculationDocuments.Ref 		AS Recorder,
	|	&EndOfPeriod								AS Period,
	|	VALUE(AccumulationRecordType.Expense)		AS RecordType,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension AS AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument AS ExpenseReceiptDocument,
	|	T.LotVendorAttributes AS LotVendorAttributes,
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.VATActivityType AS VATActivityType,
	|	T.VATActivityType AS VATTaxation,
	|	VALUE(Enum.LotRecordTypes.Estimated) AS EntryType,
	|	CASE WHEN ISNULL(Filter.WriteOffMan, TRUE) THEN T.Cost ELSE 0 END AS Cost,
	|	CASE WHEN ISNULL(Filter.WriteOffMan, TRUE) THEN T.CostExcludingVAT ELSE 0 END AS CostExcludingVAT,
	|	CASE WHEN ISNULL(Filter.WriteOffMan, TRUE) THEN T.VATManag ELSE 0 END AS VATManag,
	|	CASE WHEN ISNULL(Filter.WriteOffLocalControl, TRUE) THEN T.LocalCost ELSE 0 END AS LocalCost,
	|	CASE WHEN ISNULL(Filter.WriteOffLocalControl, TRUE) THEN T.VATLocal ELSE 0 END AS VATLocal,
	|	CASE WHEN ISNULL(Filter.WriteOffPD, TRUE) THEN T.PermanentDifference ELSE 0 END AS PermanentDifference,
	|	CASE WHEN ISNULL(Filter.WriteOffTD, TRUE) THEN T.CostTD ELSE 0 END AS CostTD
	|INTO TTRoundingUpBatchOfOtherExpenses
	|FROM
	|	TTBatchBalancesOfOtherExpenses AS T
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON T.Organization = CostCalculationDocuments.Organization
	|	LEFT JOIN TTBalancesOtherExpenses AS Filter
	|		ON T.ExpenseItem = Filter.ExpenseItem
	|		AND T.Department = Filter.Department
	|		AND T.Organization = Filter.Organization
	|		AND T.DimensionOfExpenses = Filter.DimensionOfExpenses
	|		AND T.LineOfBusiness = Filter.LineOfBusiness
	|WHERE
	|	CASE WHEN ISNULL(Filter.WriteOffMan, TRUE) THEN T.Cost ELSE 0 END <> 0
	|		OR CASE WHEN ISNULL(Filter.WriteOffMan, TRUE) THEN T.CostExcludingVAT ELSE 0 END <> 0
	|		OR CASE WHEN ISNULL(Filter.WriteOffMan, TRUE) THEN T.VATManag ELSE 0 END <> 0
	|		OR CASE WHEN ISNULL(Filter.WriteOffLocalControl, TRUE) THEN T.LocalCost ELSE 0 END <> 0
	|		OR CASE WHEN ISNULL(Filter.WriteOffLocalControl, TRUE) THEN T.VATLocal ELSE 0 END <> 0
	|		OR CASE WHEN ISNULL(Filter.WriteOffPD, TRUE) THEN T.PermanentDifference ELSE 0 END <> 0
	|		OR CASE WHEN ISNULL(Filter.WriteOffTD, TRUE) THEN T.CostTD ELSE 0 END <> 0
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name,, True);
	DescriptionOfTT.TTResultName = "TTErrorForOtherExpenses";
	DescriptionOfTT.NameOfSourceTT = "TTRoundingUpBatchOfOtherExpenses";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);

#Region NegotiableRegistersOfManAccounting
 
	// Adjustment of movements according to the turnover registers of management accounting.
	Query.Text =
	"SELECT
	|	&EndOfPeriod 					AS Period,
	|	VALUE(Enum.BusinessTransactions.MonthEndTransactions) AS BusinessOperation,
	|	T.DocumentRegisterRecords 				AS DocumentRegisterRecords,
	|	T.Organization 					AS Organization,
	|	T.Department 				AS Department,
	|	T.ItemsLocationAttributes 	AS ItemsLocationAttributes,
	|	T.LineOfBusiness		AS LineOfBusiness,
	|	T.LineOfBusiness		AS CorLineOfBusiness,
	|	T.Warehouse 						AS Warehouse,
	|	T.InventoryType 					AS InventoryType,
	|	T.InventoryOwnerAttribute 					AS InventoryOwnerAttribute,
	|	T.ExpenseItemOfWriteOff 		AS ExpenseItemOfWriteOff,
	|	T.DimensionOfExpenses 			AS DimensionOfExpenses,
	|	T.SourceOfProductFinancialAccountingGroup		AS SourceOfProductFinancialAccountingGroup,
	|	SUM(T.Cost) 				AS Cost,
	|	SUM(T.CostExcludingVAT) 		AS CostExcludingVAT,
	|	SUM(T.LocalCost) 			AS LocalCost,
	|	SUM(T.CostMan) 			AS CostMan
	|FROM
	|	(SELECT
	|		T.Recorder	 											AS DocumentRegisterRecords,
	|		T.Organization 												AS Organization,
	|		UNDEFINED 												AS Department,
	|		T.LineOfBusiness									AS LineOfBusiness,
	|		T.ItemsLocationAttributes 								AS ItemsLocationAttributes,
	|		DimensionOfProductItem.StorageLocation							AS Warehouse,
	|		T.InventoryOwnerAttribute.InventoryType 									AS InventoryType,
	|		T.InventoryOwnerAttribute 												AS InventoryOwnerAttribute,
	|		VALUE(ChartOfCharacteristicTypes.ExpenseItems.CostCalculationError) AS ExpenseItemOfWriteOff,
	|		UNDEFINED 												AS DimensionOfExpenses,
	|		CASE
	|			WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|				THEN T.InventoryOwnerAttribute
	|			ELSE DimensionOfProductItem.Products
	|		END 														AS SourceOfProductFinancialAccountingGroup,
	|		-(T.Cost + T.AddExpensesForGoods)								AS Cost,
	|		-(T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT)					AS CostExcludingVAT,
	|		-T.LocalCost 											AS LocalCost,
	|		-T.CostMan 											AS CostMan
	|	FROM
	|		TTRoundingCostOfGoods AS T
	|			LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	|			ON T.ItemsLocationAttributes = DimensionOfProductItem.Ref
	|	
	|	UNION ALL
	|
	|	SELECT
	|		T.Recorder	 											AS DocumentRegisterRecords,
	|		T.Organization 												AS Organization,
	|		T.Department 											AS Department,
	|		T.LineOfBusiness									AS LineOfBusiness,
	|		UNDEFINED				 								AS ItemsLocationAttributes,
	|		T.StorageLocation												AS Warehouse,
	|		T.InventoryOwnerAttribute.InventoryType 									AS InventoryType,
	|		T.InventoryOwnerAttribute 												AS InventoryOwnerAttribute,
	|		VALUE(ChartOfCharacteristicTypes.ExpenseItems.CostCalculationError) AS ExpenseItemOfWriteOff,
	|		UNDEFINED 												AS DimensionOfExpenses,
	|		CASE
	|			WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|				THEN T.InventoryOwnerAttribute
	|			ELSE T.Products
	|		END 														AS SourceOfProductFinancialAccountingGroup,
	|		-(T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT)			AS Cost,
	|		-(T.CostVariancesExcludingVAT + T.AdditionalExpensesExcludingVAT)		AS CostExcludingVAT,
	|		-(T.CostVariancesLocal + T.AddExpensesLocal)			AS LocalCost,
	|		-(T.CostVariancesMgmt + T.AddExpensesMan)				AS CostMan
	|	FROM
	|		TTRoundingUpDeviationsInCOSTOfGoods AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Recorder	 											AS DocumentRegisterRecords,
	|		T.Organization 												AS Organization,
	|		T.Department 											AS Department,
	|		T.LineOfBusiness									AS LineOfBusiness,
	|		UNDEFINED 												AS ItemsLocationAttributes,
	|		UNDEFINED 												AS Warehouse,
	|		UNDEFINED 												AS InventoryType,
	|		UNDEFINED 												AS InventoryOwnerAttribute,
	|		T.ExpenseItem 											AS IncomeAndExpenseItem,
	|		T.DimensionOfExpenses 										AS DimensionOfExpenses,
	|		UNDEFINED 												AS SourceOfProductFinancialAccountingGroup,
	|		-T.Sum 													AS Cost,
	|		-T.AmountExcludingVAT 												AS CostExcludingVAT,
	|		-T.SumCompl 												AS LocalCost,
	|		-T.SumMan 												AS CostMan
	|	FROM
	|		TTRoundingOtherExpenses AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Recorder	 											AS DocumentRegisterRecords,
	|		T.Organization 												AS Organization,
	|		T.Department 											AS Department,
	|		VALUE(Catalog.LinesOfBusiness.EmptyRef)	AS LineOfBusiness,
	|		UNDEFINED 												AS ItemsLocationAttributes,
	|		UNDEFINED 												AS Warehouse,
	|		UNDEFINED 												AS InventoryType,
	|		UNDEFINED 												AS InventoryOwnerAttribute,
	|		T.ExpenseItem 											AS IncomeAndExpenseItem,
	|		T.DimensionOfExpenses 										AS DimensionOfExpenses,
	|		UNDEFINED 												AS SourceOfProductFinancialAccountingGroup,
	|		-T.Cost												AS Cost,
	|		-T.CostExcludingVAT											AS CostExcludingVAT,
	|		-T.LocalCost											AS LocalCost,
	|		-T.CostMan												AS CostMan
	|	FROM
	|		TTRoundingOtherExpensesUnfinishedProduction AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Recorder	 											AS DocumentRegisterRecords,
	|		T.Organization 												AS Organization,
	|		UNDEFINED 												AS Department,
	|		T.LineOfBusiness									AS LineOfBusiness,
	|		UNDEFINED 												AS ItemsLocationAttributes,
	|		UNDEFINED 												AS Warehouse,
	|		UNDEFINED 												AS InventoryType,
	|		UNDEFINED 												AS InventoryOwnerAttribute,
	|		VALUE(ChartOfCharacteristicTypes.ExpenseItems.CostCalculationError) AS IncomeAndExpenseItem,
	|		UNDEFINED 												AS DimensionOfExpenses,
	|		UNDEFINED 												AS SourceOfProductFinancialAccountingGroup,
	|		T.Sum 													AS Cost,
	|		0 															AS CostExcludingVAT,
	|		0 															AS LocalCost,
	|		0 															AS CostMan
	|	FROM
	|		TTCorOtherExpenses AS T) AS T
	|
	|GROUP BY
	|	T.DocumentRegisterRecords,
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ItemsLocationAttributes,
	|	T.Warehouse,
	|	T.InventoryType,
	|	T.InventoryOwnerAttribute,
	|	T.ExpenseItemOfWriteOff,
	|	T.DimensionOfExpenses,
	|	T.SourceOfProductFinancialAccountingGroup
	|
	|HAVING
	|	(SUM(T.Cost) <> 0
	|		OR SUM(T.CostExcludingVAT) <> 0
	|		OR SUM(T.LocalCost) <> 0
	|		OR SUM(T.CostMan) <> 0)";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,,, NStr("vi = 'Biểu ghi kế toán quản trị';
																																	|ru = 'Регистры упр. учета';
																																	|en = 'Management accounting ledgers'; fa = 'Management accounting ledgers';
																																	|it = 'Registri contabilità gestionale';
																																	|pl = 'Rejestry ewidencji zarządczej';
																																	|tr = 'Yönetim muhasebesi kayıtları'", Common.DefaultLanguageCode()));
	
	While Selection.Next() Do
		GenerateRegisteredRecordsAccordingToTurnoverRegistersOfAccountingMan(CalculationParameters, Selection);
	EndDo;

#EndRegion
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

// Stage 4.1
// The procedure performs the distribution of revenue and cost of sales lines of business.
// In case of batch accounting, 2.2 line of business in the revenue register is filled in to record the sum of the pens() - deferred additional verification of the document.  
//
// Parameters:
// CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//
Procedure DistributeRevenueByLineOfBusiness(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "DistributeRevenueByLineOfBusiness");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	RevenueAndCost.Department             		 AS Department,
	|	DimensionByPartners.Organization                		 AS Organization,
	|	DimensionByPartners.Partner                    		 AS Partner,
	|	RevenueAndCost.CounterpartyLineOfBusiness AS LineOfBusiness,
	|	DimensionOfProductItem.Products              		 AS Products,
	|	DimensionOfProductItem.Characteristic              		 AS Characteristic,
	|	CASE
	|		WHEN RevenueAndCost.Warehouse REFS Catalog.Warehouses
	|		  AND RevenueAndCost.Warehouse <> VALUE(Catalog.Warehouses.EmptyRef)
	|			THEN RevenueAndCost.Warehouse
	|		WHEN DimensionOfProductItem.StorageLocation REFS Catalog.Warehouses
	|		  AND DimensionOfProductItem.StorageLocation <> VALUE(Catalog.Warehouses.EmptyRef)
	|			THEN DimensionOfProductItem.StorageLocation
	|			ELSE VALUE(Catalog.Warehouses.EmptyRef)
	|	END 													 AS Warehouse,
	|	VALUE(ChartOfCharacteristicTypes.IncomeItems.SalesRevenue) AS IncomeItem,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.SaleCost) AS ExpenseItem,
	|	SUM(RevenueAndCost.RevenueAmount)				 AS RevenueAmount,
	|	SUM(RevenueAndCost.Cost
	|		+ RevenueAndCost.AddExpensesForGoods
	|		+ RevenueAndCost.ItemizedFixedCostsIncludingVAT
	|		+ RevenueAndCost.ItemizedVariableCostsIncludingVAT
	|		+ RevenueAndCost.LaborCosts
	|		+ RevenueAndCost.SellingExpensesIncludingVAT) AS Cost_
	|INTO TTRevenueTable
	|FROM
	|	TTCashEstimatedTurnoverRevenueAndCostOfSales AS RevenueAndCost
	|		INNER JOIN TTPartnerAnalyticsSelection AS DimensionByPartners
	|			ON RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	|			ON RevenueAndCost.ItemsLocationAttributes = DimensionOfProductItem.Ref
	|WHERE
	|	RevenueAndCost.InventoryType IN
	|		(VALUE(Enum.InventoryTypes.OwnGoods),
	|		 VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|		 VALUE(Enum.InventoryTypes.OperationService))
	|
	|GROUP BY
	|	RevenueAndCost.Department,
	|	DimensionByPartners.Organization,
	|	DimensionByPartners.Partner,
	|	RevenueAndCost.CounterpartyLineOfBusiness,
	|	DimensionOfProductItem.Products,
	|	DimensionOfProductItem.Characteristic,
	|	CASE
	|		WHEN RevenueAndCost.Warehouse REFS Catalog.Warehouses
	|		  AND RevenueAndCost.Warehouse <> VALUE(Catalog.Warehouses.EmptyRef)
	|			THEN RevenueAndCost.Warehouse
	|		WHEN DimensionOfProductItem.StorageLocation REFS Catalog.Warehouses
	|		  AND DimensionOfProductItem.StorageLocation <> VALUE(Catalog.Warehouses.EmptyRef)
	|			THEN DimensionOfProductItem.StorageLocation
	|			ELSE VALUE(Catalog.Warehouses.EmptyRef)
	|	END
	|
	|HAVING
	|	SUM(RevenueAndCost.RevenueAmount) <> 0
	|	OR SUM(RevenueAndCost.Cost
	|		+ RevenueAndCost.AddExpensesForGoods
	|		+ RevenueAndCost.ItemizedFixedCostsIncludingVAT
	|		+ RevenueAndCost.ItemizedVariableCostsIncludingVAT
	|		+ RevenueAndCost.LaborCosts
	|		+ RevenueAndCost.SellingExpensesIncludingVAT) <> 0
	|
	|UNION ALL
	|
	|SELECT
	|	RevenueServicesAndAssets.Department                                  AS Department,
	|	RevenueServicesAndAssets.Organization                                    AS Organization,
	|	RevenueServicesAndAssets.Partner                                        AS Partner,
	|	RevenueServicesAndAssets.LineOfBusiness                        AS LineOfBusiness,
	|	UNDEFINED                                                 AS Products,
	|	UNDEFINED              		 							 AS Characteristic,
	|	UNDEFINED												 AS Warehouse,
	|	RevenueServicesAndAssets.IncomeItem                                  AS IncomeItem,
	|	UNDEFINED                                                 AS ExpenseItem,
	|	SUM(RevenueServicesAndAssets.RevenueExcludingVATManag + RevenueServicesAndAssets.VATManag) AS RevenueAmount,
	|	0                                                            AS Cost_
	|FROM
	|	AccumulationRegister.RevenueServicesAndAssets AS RevenueServicesAndAssets
	|WHERE
	|	RevenueServicesAndAssets.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND RevenueServicesAndAssets.Organization IN (&CompanyArray)
	|	AND RevenueServicesAndAssets.Active
	|GROUP BY
	|	RevenueServicesAndAssets.Department,
	|	RevenueServicesAndAssets.Organization,
	|	RevenueServicesAndAssets.Partner,
	|	RevenueServicesAndAssets.LineOfBusiness,
	|	RevenueServicesAndAssets.IncomeItem
	|
	|HAVING
	|	SUM(RevenueServicesAndAssets.RevenueExcludingVATManag + RevenueServicesAndAssets.VATManag) <> 0
	|
	|INDEX BY
	|	LineOfBusiness
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	T.Organization
	|FROM
	|	TTRevenueTable AS T
	|";
	
	QueryResult = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	
	CompaniesForDistribution = QueryResult.Unload().UnloadColumn("Organization"); // Array
	CompaniesForDistribution.Add(Catalogs.Companies.EmptyRef());
	
	Query.SetParameter("CompaniesForDistribution", CompaniesForDistribution);
	
	Query.Text =
	"SELECT
	|	T.LineOfBusinessAllocationMethod,
	|	T.Partner,
	|	T.Products,
	|	T.Warehouse,
	|	T.Department,
	|	T.Organization
	|INTO TTDistributionSettings
	|FROM
	|	InformationRegister.SetUpAllocationByLinesOfBusiness.SliceLast(
	|		&EndOfPeriod,
	|		Used
	|		AND Organization IN (&CompaniesForDistribution)
	|		AND ((LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness
	|			AND LineOfBusinessAllocationMethod <> VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|			)
	|		  OR
	|     			(LineOfBusinessAllocationMethod REFS Catalog.AllocationMethodsByLinesOfBusiness
	|    		 AND CAST(LineOfBusinessAllocationMethod AS Catalog.AllocationMethodsByLinesOfBusiness).AllocatedAccordingToRule = VALUE(Enum.AllocationRulesByLinesOfBusiness.InProportionToFactors))
	|  		  )
	|	) AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RevenueTable.Department               AS Department,
	|	RevenueTable.Organization                 AS Organization,
	|	RevenueTable.Products                AS Products,
	|	RevenueTable.Characteristic              AS Characteristic,
	|	RevenueTable.Warehouse              		   AS Warehouse,
	|	RevenueTable.Partner                     AS Partner,
	|	RevenueTable.LineOfBusiness     AS LineOfBusiness,
	|	RevenueTable.IncomeItem               AS IncomeItem,
	|	RevenueTable.ExpenseItem              AS ExpenseItem,
	|	RevenueTable.RevenueAmount                AS RevenueAmount,
	|	RevenueTable.Cost_               AS Cost_,
	|	ISNULL(SettingUpDistribution.LineOfBusinessAllocationMethod, VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusinessAllocationMethod,
	|	CASE
	|		WHEN RevenueTable.Partner = SettingUpDistribution.Partner
	|			THEN 1000000
	|		WHEN RevenueTable.Partner = SegmentPartners.Partner
	|			THEN 100000
	|			ELSE 0
	|	END + CASE
	|		WHEN RevenueTable.Products = SettingUpDistribution.Products
	|			THEN 10000
	|		WHEN RevenueTable.Products = SegmentProducts.Products
	|			THEN 1000
	|			ELSE 0
	|	END + CASE
	|		WHEN RevenueTable.Warehouse = SettingUpDistribution.Warehouse
	|			THEN 100
	|			ELSE 0
	|	END + CASE
	|		WHEN RevenueTable.Department = SettingUpDistribution.Department
	|			THEN 10
	|			ELSE 0
	|	END + CASE
	|		WHEN RevenueTable.Organization = SettingUpDistribution.Organization
	|			THEN 1
	|			ELSE 0
	|	END AS Priority
	|INTO TTDistributionTable
	|FROM
	|	TTRevenueTable AS RevenueTable
	|	LEFT JOIN TTDistributionSettings AS SettingUpDistribution
	|		ON RevenueTable.LineOfBusiness = VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|			AND (RevenueTable.Organization = SettingUpDistribution.Organization
	|				OR SettingUpDistribution.Organization = VALUE(Catalog.Companies.EmptyRef))
	|			AND (RevenueTable.Warehouse = SettingUpDistribution.Warehouse
	|				OR SettingUpDistribution.Warehouse = VALUE(Catalog.Warehouses.EmptyRef))
	|			AND (RevenueTable.Department = SettingUpDistribution.Department
	|				OR SettingUpDistribution.Department = VALUE(Catalog.BusinessStructure.EmptyRef))
	|
	|	LEFT JOIN InformationRegister.SegmentPartners AS SegmentPartners
	|		ON SegmentPartners.Segment = SettingUpDistribution.Partner
	|	LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
	|		ON SegmentProducts.Segment = SettingUpDistribution.Products
	|WHERE
	|	(RevenueTable.Partner              = SettingUpDistribution.Partner
	|		OR RevenueTable.Partner         = SegmentPartners.Partner
	|		OR ISNULL(SettingUpDistribution.Partner, UNDEFINED) = UNDEFINED)
	|	AND (RevenueTable.Products              = SettingUpDistribution.Products
	|		OR (RevenueTable.Products        = SegmentProducts.Products
	|		  AND RevenueTable.Characteristic        = SegmentProducts.Characteristic)
	|		OR ISNULL(SettingUpDistribution.Products, UNDEFINED) = UNDEFINED)
	|
	|INDEX BY
	|	Organization,
	|	Partner,
	|	Department,
	|	Products,
	|	Characteristic,
	|	Warehouse
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	CostCalculationDocuments.Ref 								 AS DocumentRegisterRecords,
	|	&EndOfPeriod                                                        AS Period,
	|	FinancialResultsTable.Organization                             AS Organization,
	|	FinancialResultsTable.Department                           AS Department,
	|	FinancialResultsTable.IncomeItem                           AS IncomeItem,
	|	FinancialResultsTable.ExpenseItem                          AS ExpenseItem,
	|	FinancialResultsTable.LineOfBusinessAllocationMethod                     AS LineOfBusinessAllocationMethod,
	|	SUM(FinancialResultsTable.RevenueAmount)                     AS RevenueAmount,
	|	SUM(FinancialResultsTable.Cost_)                    AS Cost_,
	|	CASE
	|		WHEN FinancialResultsTable.LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness THEN
	|			FinancialResultsTable.LineOfBusinessAllocationMethod
	|		ELSE
	|			DistributionMethods.LineOfBusiness
	|	END                                                                AS LineOfBusiness,
	|	CASE
	|		WHEN FinancialResultsTable.LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness THEN
	|			1
	|		ELSE
	|			ISNULL(DistributionMethods.ZoomRatio, 1)
	|	END                                                                AS DistributionCoefficient
	|
	|FROM (
	|	SELECT
	|		DistributionTable_1.Organization                   AS Organization,
	|		DistributionTable_1.Department                 AS Department,
	|		DistributionTable_1.IncomeItem                 AS IncomeItem,
	|		DistributionTable_1.ExpenseItem                AS ExpenseItem,
	|		SUM(DistributionTable_1.RevenueAmount)           AS RevenueAmount,
	|		SUM(DistributionTable_1.Cost_)          AS Cost_,
	|		ISNULL(DistributionTable_1.LineOfBusinessAllocationMethod, UNDEFINED) AS LineOfBusinessAllocationMethod
	|	FROM
	|		TTDistributionTable AS DistributionTable_1
	|
	|	WHERE
	|		DistributionTable_1.LineOfBusiness = VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|		AND DistributionTable_1.Priority IN
	|				(SELECT
	|					MAX(Tab.Priority) AS Priority
	|				FROM
	|					TTDistributionTable AS Tab
	|				WHERE
	|					Tab.Organization			= DistributionTable_1.Organization
	|					AND Tab.Partner			= DistributionTable_1.Partner
	|					AND Tab.Department		= DistributionTable_1.Department
	|					AND Tab.Products		= DistributionTable_1.Products
	|					AND Tab.Characteristic	= DistributionTable_1.Characteristic
	|					AND Tab.Warehouse         	= DistributionTable_1.Warehouse)
	|	
	|	GROUP BY
	|		DistributionTable_1.Organization,
	|		DistributionTable_1.Department,
	|		DistributionTable_1.IncomeItem,
	|		DistributionTable_1.ExpenseItem,
	|		ISNULL(DistributionTable_1.LineOfBusinessAllocationMethod, UNDEFINED)
	|
	|	UNION ALL
	|
	|	SELECT
	|		DistributionTable_1.Organization                   AS Organization,
	|		DistributionTable_1.Department                 AS Department,
	|		DistributionTable_1.IncomeItem                 AS IncomeItem,
	|		DistributionTable_1.ExpenseItem                AS ExpenseItem,
	|		SUM(DistributionTable_1.RevenueAmount)           AS RevenueAmount,
	|		SUM(DistributionTable_1.Cost_)          AS Cost_,
	|		DistributionTable_1.LineOfBusiness       AS LineOfBusinessAllocationMethod
	|	FROM
	|		TTDistributionTable AS DistributionTable_1
	|
	|	WHERE
	|		DistributionTable_1.LineOfBusiness <> VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|
	|	GROUP BY
	|		DistributionTable_1.Organization,
	|		DistributionTable_1.Department,
	|		DistributionTable_1.IncomeItem,
	|		DistributionTable_1.ExpenseItem,
	|		DistributionTable_1.LineOfBusiness
	|
	|	) AS FinancialResultsTable
	|
	|	LEFT JOIN
	|		Catalog.AllocationMethodsByLinesOfBusiness.LinesOfBusiness AS DistributionMethods
	|		ON FinancialResultsTable.LineOfBusinessAllocationMethod = DistributionMethods.Ref
	|
	|	LEFT JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON FinancialResultsTable.Organization = CostCalculationDocuments.Organization
	|	
	|GROUP BY
	|	CostCalculationDocuments.Ref,
	|	FinancialResultsTable.Organization,
	|	FinancialResultsTable.Department,
	|	FinancialResultsTable.IncomeItem,
	|	FinancialResultsTable.ExpenseItem,
	|	FinancialResultsTable.LineOfBusinessAllocationMethod,
	|	CASE
	|		WHEN FinancialResultsTable.LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness THEN
	|			FinancialResultsTable.LineOfBusinessAllocationMethod
	|		ELSE
	|			DistributionMethods.LineOfBusiness
	|	END,
	|	CASE
	|		WHEN FinancialResultsTable.LineOfBusinessAllocationMethod REFS Catalog.LinesOfBusiness THEN
	|			1
	|		ELSE
	|			ISNULL(DistributionMethods.ZoomRatio, 1)
	|	END
	|
	|TOTALS
	|	MAX(RevenueAmount),
	|	MAX(Cost_),
	|	SUM(DistributionCoefficient)
	|
	|BY
	|	Organization,
	|	Department,
	|	IncomeItem,
	|	LineOfBusinessAllocationMethod
	|";
	
	RegisterName = Metadata.AccumulationRegisters.FinancialResults.Name;
	
	QueryResult = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	SampleOrganization = QueryResult.Select(QueryResultIteration.ByGroups, "Organization");
	
	While SampleOrganization.Next() Do
		
		SampleDivision = SampleOrganization.Select(QueryResultIteration.ByGroups, "Department");
		
		While SampleDivision.Next() Do
			
			SelectionArticle = SampleDivision.Select(QueryResultIteration.ByGroups, "IncomeItem");
			While SelectionArticle.Next() Do
			
				SamplingMethodsOfDistribution = SelectionArticle.Select(QueryResultIteration.ByGroups, "LineOfBusinessAllocationMethod");
				While SamplingMethodsOfDistribution.Next() Do
					
					TotalShares            = SamplingMethodsOfDistribution.DistributionCoefficient;
					ExpenseForAllocation = SamplingMethodsOfDistribution.Cost_;
					RevenuesToBeDistributed  = SamplingMethodsOfDistribution.RevenueAmount;
					
					DetailsSelection = SamplingMethodsOfDistribution.Select(QueryResultIteration.Linear);
					
					CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
						CalculationParameters,
						DetailsSelection.Count());
					
					CopiedFields = "Period, Organization, Department, LineOfBusiness, LineOfBusinessAllocationMethod";
					
					While DetailsSelection.Next() Do
	
						If TotalShares <> 0 Then
							Expenses = Round(ExpenseForAllocation * DetailsSelection.DistributionCoefficient / TotalShares,
											2, RoundMode.Round15as20);
						Else
							Expenses = 0;
						EndIf;
	
						If TotalShares <> 0 Then
							Income = Round(RevenuesToBeDistributed * DetailsSelection.DistributionCoefficient / TotalShares,
											2, RoundMode.Round15as20);
						Else
							Income = 0;
						EndIf;
	
						ExpenseForAllocation = ExpenseForAllocation - Expenses;
						RevenuesToBeDistributed  = RevenuesToBeDistributed  - Income;
						TotalShares            = TotalShares            - DetailsSelection.DistributionCoefficient;
	
						// Formation of movements based on the financial result.
						MotionData = New Structure(CopiedFields + ", DocumentRegisterRecords");
						CurrentFields    = CopiedFields;
						
						FillPropertyValues(MotionData, DetailsSelection);
						
						If Income <> 0 Then
							MotionData.Insert("Income", 		 Income);
							MotionData.Insert("IncomeItem", DetailsSelection.IncomeItem);
							CurrentFields = CurrentFields + ", Income, IncomeItem";
						EndIf;
	
						If Expenses <> 0 Then
							MotionData.Insert("Expenses", 		  Expenses);
							MotionData.Insert("ExpenseItem", DetailsSelection.ExpenseItem);
							CurrentFields = CurrentFields + ", Expenses, ExpenseItem";
						EndIf;
						
						AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CurrentFields);
						
					EndDo;
					
				EndDo;
				
			EndDo;
			
		EndDo;
		
	EndDo;

	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
		"TTRevenueTable, TTDistributionTable");
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);

EndProcedure

// Step 4.3
Procedure ReflectGainsAndLosses(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "ReflectGainsAndLosses");
	
	TempTableManager = CostCalculationAppliedAlgorithms.GetTTManagerFromContainer(CalculationParameters);
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	If TempTableManager.Tables.Find("CorrectedDocuments_") = Undefined Then 
		Query.Text = CostCalculationFillingInformationAboutLots.TextCorrectedDocuments() + "; ";
	EndIf;
	
	Query.Text = Query.Text + " 
	|SELECT
	|	RevenueAndCost.Recorder 							AS Recorder,
	|	RevenueAndCost.Period 								AS Period,
	|	RevenueAndCost.AccountingDimensionByPartners				AS AccountingDimensionByPartners,
	|	RevenueAndCost.ItemsLocationAttributes			AS ItemsLocationAttributes,
	|	RevenueAndCost.CounterpartyLineOfBusiness	AS CounterpartyLineOfBusiness,
	|	RevenueAndCost.ProductLineOfBusiness	AS ProductLineOfBusiness,
	|	RevenueAndCost.Department	AS Department,
	|	RevenueAndCost.ReversingEntry		AS ReversingEntry,
	|	RevenueAndCost.InventoryType	AS InventoryType,
	|	RevenueAndCost.RevenueAmount	AS RevenueAmount,
	|	RevenueAndCost.Cost		AS Cost,
	|	RevenueAndCost.AddExpensesForGoods	AS AddExpensesForGoods,
	|	RevenueAndCost.LaborCosts	AS LaborCosts,
	|	RevenueAndCost.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	|	RevenueAndCost.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	|	RevenueAndCost.SellingExpensesIncludingVAT AS SellingExpensesIncludingVAT,
	|	RevenueAndCost.ExciseAmountInCurrencyMgmt AS ExciseAmountInCurrencyMgmt,
	|	RevenueAndCost.LotCalculation AS LotCalculation,
	|	RevenueAndCost.BusinessOperation AS BusinessOperation
	|
	|INTO TTPreliminaryTurnoverRevenueAndCostOfGoodsSold
	|FROM
	|	TTCashEstimatedTurnoverRevenueAndCostOfSales AS RevenueAndCost
	|		LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|			ON CorrectedDocuments_.Recorder = RevenueAndCost.Recorder
	|WHERE
	|	VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.OBEntrySalesForPastPeriods)
	// We exclude From The Registered Records of corrections and corrections of The previous period.
	// Such Registered Records have already been formed in the procedure for correcting the cost of roadmovementsrecorded documents() The area of correction of the cost of goods
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND RevenueAndCost.ReversingEntry)
	|
	|INDEX BY
	|	AccountingDimensionByPartners
	|;
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) 			AS RecordType,
	|	RevenueAndCost.DocumentRegisterRecords			AS DocumentRegisterRecords,
	|	RevenueAndCost.Period					AS Period,
	|	RevenueAndCost.Organization				AS Organization,
	|	RevenueAndCost.Department				AS Department,
	|	RevenueAndCost.LineOfBusiness 	AS LineOfBusiness,
	|	RevenueAndCost.ReversingEntry					AS ReversingEntry,
	|	SUM(RevenueAndCost.Sum)				AS Sum
	|INTO TTIntermediateTable1
	|FROM
	|	(SELECT
	|		RevenueAndCost.Recorder 							AS DocumentRegisterRecords,
	|		RevenueAndCost.Period 								AS Period,
	|		DimensionByPartners.Organization                			AS Organization,
	|		RevenueAndCost.CounterpartyLineOfBusiness 	AS LineOfBusiness,
	|		RevenueAndCost.Department							AS Department,
	|		RevenueAndCost.ReversingEntry								AS ReversingEntry,
	|		CASE WHEN RevenueAndCost.InventoryType IN (
	|			VALUE(Enum.InventoryTypes.OwnGoods),
	|			VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|			VALUE(Enum.InventoryTypes.OperationService))
	|		THEN
	|			RevenueAndCost.RevenueAmount
	|		ELSE
	|			0
	|		END 														AS Sum
	|	FROM
	|		TTPreliminaryTurnoverRevenueAndCostOfGoodsSold AS RevenueAndCost
	|			INNER JOIN TTPartnerAnalyticsSelection AS DimensionByPartners
	|				ON RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|	) AS RevenueAndCost
	|
	|GROUP BY
	|	RevenueAndCost.DocumentRegisterRecords,
	|	RevenueAndCost.Period,
	|	RevenueAndCost.Organization,
	|	RevenueAndCost.Department,
	|	RevenueAndCost.LineOfBusiness,
	|	RevenueAndCost.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) 			AS RecordType,
	|	RevenueAndCost.DocumentRegisterRecords			AS DocumentRegisterRecords,
	|	RevenueAndCost.Period					AS Period,
	|	RevenueAndCost.Organization				AS Organization,
	|	RevenueAndCost.Department				AS Department,
	|	RevenueAndCost.LineOfBusiness 	AS LineOfBusiness,
	|	RevenueAndCost.ReversingEntry					AS ReversingEntry,
	|	SUM(RevenueAndCost.Sum)				AS Sum
	|FROM
	|	(SELECT
	|		RevenueAndCost.Recorder 						  AS DocumentRegisterRecords,
	|		RevenueAndCost.Period 							  AS Period,
	|		DimensionByPartners.Organization 						  AS Organization,
	|		RevenueAndCost.Department						  AS Department,
	|		RevenueAndCost.ProductLineOfBusiness AS LineOfBusiness,
	|		RevenueAndCost.ReversingEntry							  AS ReversingEntry,
	|		CASE WHEN RevenueAndCost.InventoryType IN (
	|			VALUE(Enum.InventoryTypes.OwnGoods),
	|			VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|			VALUE(Enum.InventoryTypes.OperationService))
	|		THEN
	|			RevenueAndCost.Cost
	|			+ RevenueAndCost.AddExpensesForGoods
	|			+ RevenueAndCost.LaborCosts
	|			+ RevenueAndCost.ItemizedFixedCostsIncludingVAT
	|			+ RevenueAndCost.ItemizedVariableCostsIncludingVAT
	|			+ RevenueAndCost.SellingExpensesIncludingVAT
	|			+ RevenueAndCost.ExciseAmountInCurrencyMgmt
	|		ELSE
	|			RevenueAndCost.AddExpensesForGoods
	|			+ RevenueAndCost.SellingExpensesIncludingVAT
	|		END 													  AS Sum
	|	FROM
	|		TTPreliminaryTurnoverRevenueAndCostOfGoodsSold AS RevenueAndCost
	|			INNER JOIN TTPartnerAnalyticsSelection AS DimensionByPartners
	|				ON RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|	) AS RevenueAndCost
	|
	|GROUP BY
	|	RevenueAndCost.DocumentRegisterRecords,
	|	RevenueAndCost.Period,
	|	RevenueAndCost.Organization,
	|	RevenueAndCost.Department,
	|	RevenueAndCost.LineOfBusiness,
	|	RevenueAndCost.ReversingEntry
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) 			AS RecordType,
	|	RevenueAndCost.DocumentRegisterRecords			AS DocumentRegisterRecords,
	|	RevenueAndCost.Period					AS Period,
	|	RevenueAndCost.Counterparty				AS Organization,
	|	RevenueAndCost.Department				AS Department,
	|	RevenueAndCost.LineOfBusiness	AS LineOfBusiness,
	|	RevenueAndCost.ReversingEntry					AS ReversingEntry,
	|	SUM(RevenueAndCost.Sum)				AS Sum
	|INTO TTIntermediateTable2
	|FROM
	|	(SELECT
	|		RevenueAndCost.Recorder 							AS DocumentRegisterRecords,
	|		RevenueAndCost.Period					  			AS Period,
	|		DimensionByPartners.Counterparty                				AS Counterparty,
	|		RevenueAndCost.Department							AS Department,
	|		RevenueAndCost.CounterpartyLineOfBusiness 	AS LineOfBusiness,
	|		RevenueAndCost.ReversingEntry								AS ReversingEntry,
	|		RevenueAndCost.RevenueAmount							AS Sum
	|	FROM
	|		TTPreliminaryTurnoverRevenueAndCostOfGoodsSold AS RevenueAndCost
	|		INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
	|			ON
	|				RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|				AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	|				AND DimensionByPartners.Counterparty REFS Catalog.Companies
	|				AND DimensionByPartners.Counterparty <> VALUE(Catalog.Companies.EmptyRef)
	|
	|	WHERE
	|		RevenueAndCost.InventoryType IN (
	|			VALUE(Enum.InventoryTypes.OperationService),
	|			VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|			VALUE(Enum.InventoryTypes.OwnGoods))
	|		AND CAST(RevenueAndCost.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Products.ItemsType
	|			<> VALUE(Enum.ItemsTypes.OperationService)
	|		AND DimensionByPartners.Counterparty IN (&CompanyArray)
	|		AND NOT RevenueAndCost.LotCalculation
	|		AND RevenueAndCost.BusinessOperation <> VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|		AND VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.IntercompanyGoodsReturn)
	// For organizations on a medium-moving Customer invoices-Intercompany, the cost of the document is reflected in the document,
	// so there is no profit or loss for the recipient.
	|		AND NOT DimensionByPartners.Counterparty IN (&MediumSlipOrganizations)
	|   ) AS RevenueAndCost
	|
	|GROUP BY
	|	RevenueAndCost.DocumentRegisterRecords,
	|	RevenueAndCost.Period,
	|	RevenueAndCost.Counterparty,
	|	RevenueAndCost.Department,
	|	RevenueAndCost.LineOfBusiness,
	|	RevenueAndCost.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) 			AS RecordType,
	|	RevenueAndCost.DocumentRegisterRecords			AS DocumentRegisterRecords,
	|	RevenueAndCost.Period					AS Period,
	|	RevenueAndCost.Counterparty				AS Organization,
	|	RevenueAndCost.Department				AS Department,
	|	RevenueAndCost.LineOfBusiness	AS LineOfBusiness,
	|	RevenueAndCost.ReversingEntry					AS ReversingEntry,
	|	SUM(RevenueAndCost.Sum)				AS Sum
	|FROM
	|	(SELECT
	|		RevenueAndCost.Recorder 							AS DocumentRegisterRecords,
	|		RevenueAndCost.Period					  			AS Period,
	|		DimensionByPartners.Counterparty                				AS Counterparty,
	|		RevenueAndCost.Department							AS Department,
	|		RevenueAndCost.ProductLineOfBusiness 	AS LineOfBusiness,
	|		RevenueAndCost.ReversingEntry								AS ReversingEntry,
	|		RevenueAndCost.Cost
	|			+ RevenueAndCost.AddExpensesForGoods 
	|			+ RevenueAndCost.LaborCosts
	|			+ RevenueAndCost.ItemizedFixedCostsIncludingVAT
	|			+ RevenueAndCost.ItemizedVariableCostsIncludingVAT
	|			+ RevenueAndCost.SellingExpensesIncludingVAT
	|			+ RevenueAndCost.ExciseAmountInCurrencyMgmt AS Sum
	|	FROM
	|		TTPreliminaryTurnoverRevenueAndCostOfGoodsSold AS RevenueAndCost
	|		INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
	|			ON
	|				RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|				AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	|				AND DimensionByPartners.Counterparty REFS Catalog.Companies
	|				AND DimensionByPartners.Counterparty <> VALUE(Catalog.Companies.EmptyRef)
	|
	|	WHERE
	|		RevenueAndCost.InventoryType IN (
	|			VALUE(Enum.InventoryTypes.OperationService),
	|			VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|			VALUE(Enum.InventoryTypes.OwnGoods))
	|		AND DimensionByPartners.Counterparty IN (&CompanyArray)
	|		AND NOT RevenueAndCost.LotCalculation
	|		AND RevenueAndCost.BusinessOperation <> VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|		AND VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.IntercompanyGoodsReturn)
	// For organizations on a medium-moving Customer invoices-Intercompany, the cost of the document is reflected in the document,
	// so there is no profit or loss for the recipient.
	|		AND NOT DimensionByPartners.Counterparty IN (&MediumSlipOrganizations)
	|	) AS RevenueAndCost
	|
	|GROUP BY
	|	RevenueAndCost.DocumentRegisterRecords,
	|	RevenueAndCost.Period,
	|	RevenueAndCost.Counterparty,
	|	RevenueAndCost.Department,
	|	RevenueAndCost.LineOfBusiness,
	|	RevenueAndCost.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) 			AS RecordType,
	|	RevenueAndCost.DocumentRegisterRecords			AS DocumentRegisterRecords,
	|	RevenueAndCost.Period					AS Period,
	|	RevenueAndCost.Counterparty				AS Organization,
	|	RevenueAndCost.Department				AS Department,
	|	RevenueAndCost.LineOfBusiness	AS LineOfBusiness,
	|	RevenueAndCost.ReversingEntry					AS ReversingEntry,
	|	SUM(RevenueAndCost.Sum)				AS Sum
	|FROM
	|	(SELECT
	|		RevenueAndCost.Recorder 							AS DocumentRegisterRecords,
	|		RevenueAndCost.Period					  			AS Period,
	|		DimensionByPartners.Counterparty                				AS Counterparty,
	|		RevenueAndCost.Department							AS Department,
	|		RevenueAndCost.CounterpartyLineOfBusiness 	AS LineOfBusiness,
	|		RevenueAndCost.ReversingEntry								AS ReversingEntry,
	|		RevenueAndCost.RevenueAmount							AS Sum
	|	FROM
	|		AccumulationRegister.RevenueAndCOGS AS RevenueAndCost
	|		INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
	|			ON
	|				RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|				AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	|				AND DimensionByPartners.Counterparty REFS Catalog.Companies
	|				AND DimensionByPartners.Counterparty <> VALUE(Catalog.Companies.EmptyRef)
	|
	|	WHERE
	|		RevenueAndCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND RevenueAndCost.Active
	|		AND RevenueAndCost.InventoryType IN (
	|			VALUE(Enum.InventoryTypes.OperationService),
	|			VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|			VALUE(Enum.InventoryTypes.OwnGoods))
	|		AND RevenueAndCost.ItemsLocationAttributes.Products.ItemsType
	|			<> VALUE(Enum.ItemsTypes.OperationService)
	|		AND DimensionByPartners.Counterparty IN (&CompanyArray)
	|		AND NOT DimensionByPartners.Organization IN (&CompanyArray)
	|		AND NOT RevenueAndCost.LotCalculation
	|		AND RevenueAndCost.BusinessOperation <> VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|		AND VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.OBEntrySalesForPastPeriods)
	|		AND VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.IntercompanyGoodsReturn)
	// For organizations on a medium-moving Customer invoices-Intercompany, the cost of the document is reflected in the document,
	// so there is no profit or loss for the recipient.
	|		AND NOT DimensionByPartners.Counterparty IN (&MediumSlipOrganizations)
	|   ) AS RevenueAndCost
	|
	|GROUP BY
	|	RevenueAndCost.DocumentRegisterRecords,
	|	RevenueAndCost.Period,
	|	RevenueAndCost.Counterparty,
	|	RevenueAndCost.Department,
	|	RevenueAndCost.LineOfBusiness,
	|	RevenueAndCost.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) 			AS RecordType,
	|	RevenueAndCost.DocumentRegisterRecords			AS DocumentRegisterRecords,
	|	RevenueAndCost.Period					AS Period,
	|	RevenueAndCost.Counterparty				AS Organization,
	|	RevenueAndCost.Department				AS Department,
	|	RevenueAndCost.LineOfBusiness	AS LineOfBusiness,
	|	RevenueAndCost.ReversingEntry					AS ReversingEntry,
	|	SUM(RevenueAndCost.Sum)				AS Sum
	|FROM
	|	(SELECT
	|		RevenueAndCost.Recorder 							AS DocumentRegisterRecords,
	|		RevenueAndCost.Period					  			AS Period,
	|		DimensionByPartners.Counterparty                				AS Counterparty,
	|		RevenueAndCost.Department							AS Department,
	|		RevenueAndCost.ProductLineOfBusiness 	AS LineOfBusiness,
	|		RevenueAndCost.ReversingEntry								AS ReversingEntry,
	|		RevenueAndCost.Cost
	|			+ RevenueAndCost.AddExpensesForGoods
	|			+ RevenueAndCost.LaborCosts
	|			+ RevenueAndCost.ItemizedFixedCostsIncludingVAT
	|			+ RevenueAndCost.ItemizedVariableCostsIncludingVAT
	|			+ RevenueAndCost.SellingExpensesIncludingVAT AS Sum
	|	FROM
	|		AccumulationRegister.RevenueAndCOGS AS RevenueAndCost
	|		INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
	|			ON
	|				RevenueAndCost.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	|				AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	|				AND DimensionByPartners.Counterparty REFS Catalog.Companies
	|				AND DimensionByPartners.Counterparty <> VALUE(Catalog.Companies.EmptyRef)
	|
	|	WHERE
	|		RevenueAndCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND RevenueAndCost.Active
	|		AND RevenueAndCost.InventoryType IN (
	|			VALUE(Enum.InventoryTypes.OperationService),
	|			VALUE(Enum.InventoryTypes.SubcontractorProducts),
	|			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
	|			VALUE(Enum.InventoryTypes.OwnGoods))
	|		AND DimensionByPartners.Counterparty IN (&CompanyArray)
	|		AND NOT DimensionByPartners.Organization IN (&CompanyArray)
	|		AND NOT RevenueAndCost.LotCalculation
	|		AND RevenueAndCost.BusinessOperation <> VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|		AND VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.OBEntrySalesForPastPeriods)
	|		AND VALUETYPE(RevenueAndCost.Recorder) <> TYPE(Document.IntercompanyGoodsReturn)
	// For organizations on a medium-moving Customer invoices-Intercompany, the cost of the document is reflected in the document,
	// so there is no profit or loss for the recipient.
	|		AND NOT DimensionByPartners.Counterparty IN (&MediumSlipOrganizations)
	|   ) AS RevenueAndCost
	|
	|GROUP BY
	|	RevenueAndCost.DocumentRegisterRecords,
	|	RevenueAndCost.Period,
	|	RevenueAndCost.Counterparty,
	|	RevenueAndCost.Department,
	|	RevenueAndCost.LineOfBusiness,
	|	RevenueAndCost.ReversingEntry
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense)	 AS RecordType,
	|	OtherIncome.Recorder				 AS DocumentRegisterRecords,
	|	OtherIncome.Period						 AS Period,
	|	OtherIncome.Organization				 AS Organization,
	|	OtherIncome.Department				 AS Department,
	|	OtherIncome.LineOfBusiness	 AS LineOfBusiness,
	|	OtherIncome.ReversingEntry						 AS ReversingEntry,
	|	SUM(OtherIncome.Sum)				 AS Sum
	|INTO TTIntermediateTable3
	|FROM
	|	TTCashEstimatedTurnoverOtherIncome AS OtherIncome
	|WHERE
	|	NOT &GenerateFinancialResult
	|	AND OtherIncome.CalculationOfCost
	|	AND OtherIncome.Sum < 0
	|
	|GROUP BY
	|	OtherIncome.Recorder,
	|	OtherIncome.Period,
	|	OtherIncome.Organization,
	|	OtherIncome.Department,
	|	OtherIncome.LineOfBusiness,
	|	OtherIncome.ReversingEntry
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt)	  AS RecordType,
	|	OtherExpenses.Recorder				  AS DocumentRegisterRecords,
	|	OtherExpenses.Period					  AS Period,
	|	OtherExpenses.Organization				  AS Organization,
	|	OtherExpenses.Department				  AS Department,
	|	OtherExpenses.LineOfBusiness	  AS LineOfBusiness,
	|	OtherExpenses.ReversingEntry					  AS ReversingEntry,
	|	SUM(OtherExpenses.Sum) 			      AS Sum
	|INTO TTIntermediateTable4
	|FROM
	|	TTCashEstimatedTurnoverOtherExpenses AS OtherExpenses
	|WHERE
	|	NOT &GenerateFinancialResult
	|	AND OtherExpenses.CalculationOfCost
	|	AND NOT OtherExpenses.OfficialTypeOfMovementParish
	|	AND OtherExpenses.ExpenseItem.CostAllocationOptionManag IN (
	|		VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
	|		VALUE(Enum.CostAllocationOptions.ToCurrentPeriodExpensesDirectly))
	|
	|GROUP BY
	|	OtherExpenses.Recorder,
	|	OtherExpenses.Period,
	|	OtherExpenses.Organization,
	|	OtherExpenses.Department,
	|	OtherExpenses.LineOfBusiness,
	|	OtherExpenses.ReversingEntry
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense)	  AS RecordType,
	|	RevenueServicesAndAssets.Recorder				  AS DocumentRegisterRecords,
	|	RevenueServicesAndAssets.Period					  AS Period,
	|	RevenueServicesAndAssets.Organization				  AS Organization,
	|	RevenueServicesAndAssets.Department				  AS Department,
	|	RevenueServicesAndAssets.LineOfBusiness	  AS LineOfBusiness,
	|	RevenueServicesAndAssets.ReversingEntry					  AS ReversingEntry,
	|	SUM(RevenueServicesAndAssets.RevenueExcludingVATManag + RevenueServicesAndAssets.VATManag) AS Sum
	|INTO TTIntermediateTable5
	|FROM
	|	AccumulationRegister.RevenueServicesAndAssets AS RevenueServicesAndAssets
	|WHERE
	|	RevenueServicesAndAssets.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND RevenueServicesAndAssets.Active
	|	AND RevenueServicesAndAssets.Organization IN (&CompanyArray)
	|
	|GROUP BY
	|	RevenueServicesAndAssets.Recorder,
	|	RevenueServicesAndAssets.Period,
	|	RevenueServicesAndAssets.Organization,
	|	RevenueServicesAndAssets.Department,
	|	RevenueServicesAndAssets.LineOfBusiness,
	|	RevenueServicesAndAssets.ReversingEntry
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	MovementData.DocumentRegisterRecords 	 								  AS DocumentRegisterRecords,
	|	MovementData.Period				 								  AS Period,
	|	MovementData.Organization			 								  AS Organization,
	|	MovementData.Department			 							  AS Department,
	|	UNDEFINED			 											  AS Dimension,
	|	MovementData.LineOfBusiness			 					  AS LineOfBusiness,
	|	MovementData.RecordType			 								  AS RecordType,
	|	MovementData.ReversingEntry												  AS ReversingEntry,
	|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ProfitAndLoss) AS AssetRef,
	|	SUM(MovementData.Sum)			 								  AS Sum
	|INTO TTDataForFormationOfRegisteredRecords
	|FROM
	|
	|	(SELECT
	|		T.DocumentRegisterRecords						AS DocumentRegisterRecords,
	|		T.Period								AS Period,
	|		T.RecordType 							AS RecordType,
	|		T.Organization							AS Organization,
	|		T.Department							AS Department,
	|		T.LineOfBusiness				AS LineOfBusiness,
	|		T.ReversingEntry								AS ReversingEntry,
	|		T.Sum									AS Sum
	|	FROM
	|		TTIntermediateTable1 AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		T.DocumentRegisterRecords						AS DocumentRegisterRecords,
	|		T.Period								AS Period,
	|		T.RecordType 							AS RecordType,
	|		T.Organization							AS Organization,
	|		T.Department							AS Department,
	|		T.LineOfBusiness				AS LineOfBusiness,
	|		T.ReversingEntry								AS ReversingEntry,
	|		T.Sum									AS Sum
	|	FROM
	|		TTIntermediateTable2 AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		T.DocumentRegisterRecords						AS DocumentRegisterRecords,
	|		T.Period								AS Period,
	|		T.RecordType 							AS RecordType,
	|		T.Organization							AS Organization,
	|		T.Department							AS Department,
	|		T.LineOfBusiness				AS LineOfBusiness,
	|		T.ReversingEntry								AS ReversingEntry,
	|		T.Sum									AS Sum
	|	FROM
	|		TTIntermediateTable3 AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		T.DocumentRegisterRecords						AS DocumentRegisterRecords,
	|		T.Period								AS Period,
	|		T.RecordType 							AS RecordType,
	|		T.Organization							AS Organization,
	|		T.Department							AS Department,
	|		T.LineOfBusiness				AS LineOfBusiness,
	|		T.ReversingEntry								AS ReversingEntry,
	|		T.Sum									AS Sum
	|	FROM
	|		TTIntermediateTable4 AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		T.DocumentRegisterRecords						AS DocumentRegisterRecords,
	|		T.Period								AS Period,
	|		T.RecordType 							AS RecordType,
	|		T.Organization							AS Organization,
	|		T.Department							AS Department,
	|		T.LineOfBusiness				AS LineOfBusiness,
	|		T.ReversingEntry								AS ReversingEntry,
	|		T.Sum									AS Sum
	|	FROM
	|		TTIntermediateTable5 AS T
	|
	|	) AS MovementData
	|
	|GROUP BY
	|	MovementData.DocumentRegisterRecords,
	|	MovementData.Period,
	|	MovementData.Organization,
	|	MovementData.Department,
	|	MovementData.LineOfBusiness,
	|	MovementData.RecordType,
	|	MovementData.ReversingEntry
	|
	|HAVING
	|	SUM(MovementData.Sum) <> 0
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTDataForFormationOfRegisteredRecords");
	
	CostCalculationAppliedAlgorithms.GenerateRegisteredRecordsByRegisterBasedOnTemporaryTableData(
		CalculationParameters,
		Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name,
		"TTDataForFormationOfRegisteredRecords",
		True);
		
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
		"TTIntermediateTable1, TTIntermediateTable2, TTIntermediateTable3, TTIntermediateTable4,
		| TTIntermediateTable5, TTPreliminaryTurnoverRevenueAndCostOfGoodsSold");
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);
	
EndProcedure

// Stage 4.4
Procedure ReflectInManagementBalanceSheet(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "ReflectInManagementBalanceSheet");
	
	// We will supplement the list of modified documents with documents of non-current assets.
	// For the received list of documents, we will establish a sign of the need for re-reflection in accounting.
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	#Region CorrectedDocuments_
	Query.Text = CostCalculationFillingInformationAboutLots.TextCorrectedDocuments(); // tue Corrected documents
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	#EndRegion
	
	#Region TextOfManagementBalanceRequest
	Query.Text =
	"SELECT DISTINCT
	|	CompanyGoods.DimensionOfExpenses AS Object
	|INTO TTNonCurrentAssets
	|FROM
	|	AccumulationRegister.CompanyGoods AS CompanyGoods
	|WHERE
	|	CompanyGoods.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND CompanyGoods.Active
	|	AND CompanyGoods.ExpenseItem.CostAllocationOptionManag
	|		= VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|	AND CompanyGoods.Organization IN(&CompanyArray)
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	InventoryCost.DimensionOfExpenses
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS InventoryCost
	|WHERE
	|	InventoryCost.ExpenseItemOfWriteOff.CostAllocationOptionManag
	|		= VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CASE WHEN T.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END AS RecordType,
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.AccountingSection AS AccountingSection,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.CorInventoryOwnerAttribute AS CorInventoryOwnerAttribute,
	|	T.CorLineOfBusiness AS CorLineOfBusiness,
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.Cost AS Cost,
	|	T.AddExpensesForGoods AS AddExpensesForGoods,
	|	T.LaborCosts AS LaborCosts,
	|	T.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	|	T.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	|	T.CalculationOfCost AS CalculationOfCost,
	|	T.LotCalculation AS LotCalculation,
	|	T.ReversingEntry AS ReversingEntry
	|INTO TTCostPrice
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS T
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = T.Recorder
	|WHERE
	|	T.Cost + T.AddExpensesForGoods + T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT <> 0
	// We exclude From The Registered Records of corrections and corrections of The previous period.
	// Such Registered Records have already been formed in the procedure for correcting the value of the movement of corrected documents() Correction area of the activity
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND T.ReversingEntry)
	|
	|INDEX BY
	|	InventoryOwnerAttribute,
	|	ItemsLocationAttributes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CASE WHEN T.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END AS RecordType,
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.DebitBusinessUnit AS DebitBusinessUnit,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.CorInventoryOwnerAttribute AS CorInventoryOwnerAttribute,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.CorLineOfBusiness AS CorLineOfBusiness,
	|	T.CostVariancesIncludingVAT AS CostVariancesIncludingVAT,
	|	T.AdditionalExpensesIncludingVAT AS AdditionalExpensesIncludingVAT,
	|	T.CalculationOfCost AS CalculationOfCost,
	|	T.LotCalculation AS LotCalculation,
	|	T.ReversingEntry AS ReversingEntry
	|INTO TTDeviationsInCostOfGoods
	|FROM
	|	TTCacheEstimatedTurnoverDeviationsInCostOfGoods AS T
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = T.Recorder
	|WHERE
	|	T.CostVariancesIncludingVAT + T.AdditionalExpensesIncludingVAT <> 0
	// We exclude the storno Registered Records of corrections and adjustments of the previous period.
	// Such Registered Records have already been formed in the function of the textdistribution of the value of the goods of the return of the historical movement().
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND T.ReversingEntry)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.CalculationOfCost AS CalculationOfCost,
	|	T.ReversingEntry AS ReversingEntry,
	|	T.Sum AS Sum
	|INTO TTOtherIncome
	|FROM
	|	TTCashEstimatedTurnoverOtherIncome AS T
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = T.Recorder
	|WHERE
	|	T.Sum <> 0
	// We exclude From The Registered Records of corrections and corrections of The previous period.
	// Such Registered Records have already been formed in the procedure for correcting the value of the movement of corrected documents() Correction area of the activity
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND T.ReversingEntry)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CASE WHEN T.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END AS RecordType,
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	T.CalculationOfCost AS CalculationOfCost,
	|	T.LotCalculation AS LotCalculation,
	|	T.ReversingEntry AS ReversingEntry,
	|	T.BusinessOperation AS BusinessOperation,
	|	T.Sum AS Sum,
	|	T.SumMan AS SumMan
	|INTO TTOtherExpenses_
	|FROM
	|	TTCashEstimatedTurnoverOtherExpenses AS T
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = T.Recorder
	|WHERE
	|	T.Sum <> 0
	// We exclude From The Registered Records of corrections and corrections of The previous period.
	// Such Registered Records have already been formed in the procedure for correcting the value of the movement of corrected documents() Correction area of the activity
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND T.ReversingEntry)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CASE WHEN T.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END AS RecordType,
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.ProductionOrder AS ProductionOrder,
	|	T.ProductionLot AS ProductionLot,
	|	T.LotCalculation AS LotCalculation,
	|	T.ReversingEntry AS ReversingEntry,
	|	T.Cost AS Cost
	|INTO TTLaborCostsUnfinishedProduction
	|FROM
	|	TTCashEstimatedTurnoverWorkInProgress AS T
	|WHERE
	|	T.Cost <> 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CASE WHEN T.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END AS RecordType,
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.ProductionOrder AS ProductionOrder,
	|	T.ProductionLot AS ProductionLot,
	|	T.ReleaseLotDimension AS ReleaseLotDimension,
	|	T.CalculationOfCost AS CalculationOfCost,
	|	T.LotCalculation AS LotCalculation,
	|	T.ReversingEntry AS ReversingEntry,
	|	T.Cost AS Cost
	|INTO TTOtherExpensesUnfinishedProduction
	|FROM
	|	TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS T
	|	LEFT JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = T.Recorder
	|WHERE
	|	T.Cost <> 0
	// We exclude From The Registered Records of corrections and corrections of The previous period.
	// Such Registered Records have already been formed in the procedure for correcting the value of the movement of corrected documents() Correction area of the activity
	|	AND NOT (NOT CorrectedDocuments_.DateOfDocumentBeingCancelled IS NULL
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|		AND T.ReversingEntry)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CASE WHEN T.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END AS RecordType,
	|	T.Recorder AS Recorder,
	|	T.Period AS Period,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.AssetRef AS AssetRef,
	|	T.Dimension AS Dimension,
	|	T.Sum AS Sum,
	|	T.SourceKind AS SourceKind,
	|	T.Source AS Source,
	|	T.CalculationOfCost AS CalculationOfCost,
	|	T.LotCalculation AS LotCalculation,
	|	T.ReversingEntry AS ReversingEntry
	|INTO TTAssetsLiabilities
	|FROM
	|	TTCashSettlementTurnoverOtherAssetsLiabilities AS T
	|WHERE
	|	T.Sum <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	DocumentsToBeReflected.Ref AS Recorder
	|INTO DocumentsToBeReflected
	|FROM
	|	(
	|	SELECT DISTINCT
	|		InventoryCost.Recorder AS Ref
	|	FROM
	|		TTCashEstimatedTurnoverCostOfGoods AS InventoryCost
	|	WHERE
	|		NOT(InventoryCost.Recorder REFS Document.InventoryCostCalculation)
	|
	|	UNION ALL
	|
	|	SELECT DISTINCT
	|		GoodsCostVariances.Recorder AS Ref
	|	FROM
	|		TTCacheEstimatedTurnoverDeviationsInCostOfGoods AS GoodsCostVariances
	|	WHERE
	|		NOT (GoodsCostVariances.Recorder REFS Document.InventoryCostCalculation)
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		LaborCostsOfUnfinishedProduction.Recorder
	|	FROM
	|		TTCashEstimatedTurnoverWorkInProgress AS LaborCostsOfUnfinishedProduction
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		OtherExpensesOfUnfinishedProduction.Recorder
	|	FROM
	|		TTCashEstimatedTurnoverOtherWorkInProgressExpenses AS OtherExpensesOfUnfinishedProduction
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		OtherAssetsLiabilities.Recorder
	|	FROM
	|		TTCashOtherAssetsLiabilities AS OtherAssetsLiabilities
	|	WHERE
	|		OtherAssetsLiabilities.Organization IN(&CompanyArray)
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		OtherIncome.Recorder
	|	FROM
	|		TTCashOtherIncome AS OtherIncome
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		OtherExpenses.Recorder
	|	FROM
	|		TTCashOtherExpenses AS OtherExpenses
	|
	|) AS DocumentsToBeReflected
	|
	|INDEX BY
	|	Recorder
	|";
	#EndRegion
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "DocumentsToBeReflected");
	
	If CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, "DocumentsToBeReflected") > 0 Then
		
		// Let's pass the temporary table to the document reflection
		MotionParameters = New Structure;
		MotionParameters.Insert("TypeOfDeferredCalculation", Enums.MovementSourcesKinds.CalculationOfCost);
		MotionParameters.Insert("DocumentsToBeReflected",   CalculationParameters.TempTablesManager);
		MotionParameters.Insert("Period", CalculationParameters.PayrollPeriod.BeginOfPeriod);
		MotionParameters.Insert("NameOfTemporaryResultTable", "TTMovementAssetsLiabilities");
		
		RequestRegisteredRecords = ManagementAccountingPostingServer.RequestRegisteredRecordsOfAssetsLiabilities(MotionParameters);
		
		#Region SubtractOnlineRegisteredRecords
		SubtractionText = 
		"SELECT
		|	T.RecordType AS RecordType,
		|	T.Recorder AS Recorder,
		|	T.Period AS Period,
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.AssetRef AS AssetRef,
		|	T.Dimension AS Dimension,
		|	T.Sum AS Sum,
		|	T.SourceKind AS SourceKind,
		|	T.Source AS Source,
		|	T.ReversingEntry AS ReversingEntry,
		|	T.CalculationOfCost AS CalculationOfCost
		|INTO TTGroupingAssetsLiabilities
		|FROM
		|	TTMovementAssetsLiabilities AS T
		|
		|UNION ALL
		|
		|SELECT
		|	CASE WHEN T.OfficialTypeOfMovementParish
		|		THEN VALUE(AccumulationRecordType.Receipt)
		|		ELSE VALUE(AccumulationRecordType.Expense)
		|	END AS RecordType,
		|	T.Recorder AS Recorder,
		|	T.Period AS Period,
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.AssetRef AS AssetRef,
		|	T.Dimension AS Dimension,
		|	-T.Sum AS Sum,
		|	T.SourceKind AS SourceKind,
		|	T.Source AS Source,
		|	T.ReversingEntry AS ReversingEntry,
		|	T.CalculationOfCost AS CalculationOfCost
		|FROM
		|	TTCashSettlementTurnoverOtherAssetsLiabilities AS T
		|	INNER JOIN DocumentsToBeReflected AS DocumentsToBeReflected
		|	ON T.Recorder = DocumentsToBeReflected.Recorder
		|WHERE
		|	T.Sum <> 0
		|	AND NOT T.LotCalculation
		|	AND NOT T.CalculationOfCost
		|	AND T.SourceKind = VALUE(Enum.MovementSourcesKinds.CalculationOfCost)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.RecordType AS RecordType,
		|	T.Recorder AS Recorder,
		|	T.Period AS Period,
		|	T.Organization AS Organization,
		|	T.Department AS Department,
		|	T.LineOfBusiness AS LineOfBusiness,
		|	T.AssetRef AS AssetRef,
		|	T.Dimension AS Dimension,
		|	SUM(T.Sum) AS Sum,
		|	T.SourceKind AS SourceKind,
		|	T.Source AS Source,
		|	T.ReversingEntry AS ReversingEntry,
		|	MIN(T.CalculationOfCost) AS CalculationOfCost,
		|	T.Recorder AS DocumentRegisterRecords
		|INTO TTDataForFormationOfRegisteredRecords
		|FROM
		|	TTGroupingAssetsLiabilities AS T
		|
		|GROUP BY
		|	T.RecordType,
		|	T.Recorder,
		|	T.Period,
		|	T.Organization,
		|	T.Department,
		|	T.LineOfBusiness,
		|	T.AssetRef,
		|	T.Dimension,
		|	T.SourceKind,
		|	T.Source,
		|	T.ReversingEntry
		|
		|HAVING
		|	SUM(T.Sum) <> 0";
		RequestRegisteredRecords.Text = RequestRegisteredRecords.Text + SubtractionText;
		#EndRegion
		
		CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, RequestRegisteredRecords, True, "TTDataForFormationOfRegisteredRecords");
		
		CostCalculationAppliedAlgorithms.GenerateRegisteredRecordsByRegisterBasedOnTemporaryTableData(
			CalculationParameters,
			Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name,
			"TTDataForFormationOfRegisteredRecords",
			True);
		
		CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters,
			RequestRegisteredRecords.Parameters.TemporaryTableNames);
		
	EndIf;
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecords(CalculationParameters);
	
EndProcedure

#EndRegion

#Region QueriesTexts

Function SetBitDepthOfNumbersInRequestText(CalculationParameters, QueryText) Export
	
	// In queries that perform calculations in temporary tables, we will set the maximum possible bit depth.
	
	OldBitDepth 			  = 28;
	OldFractionalBitRate = 10;
	NewBitDepth 			  = CalculationParameters.SolutionOfSLU.BitDepthForCalculations;
	NewBitDepthOfFractionalPart  = OldFractionalBitRate;
	DescriptionOfMoneyField 		  = TMCommonUse.BitDepthOfMoneyField();
	
	If DescriptionOfMoneyField.Digits - DescriptionOfMoneyField.FractionDigits > 13 Then
		
		// We will reduce the bit depth of the fractional part during the calculation.
		// We will not change the total bit depth set in the settings, so as not to cause a field overflow error.
		MeasurementOfBitDepth = DescriptionOfMoneyField.Digits - DescriptionOfMoneyField.FractionDigits - 13;
		NewBitDepthOfFractionalPart = Max(NewBitDepthOfFractionalPart - MeasurementOfBitDepth, 0);
		
	EndIf;
	
	If OldBitDepth <> NewBitDepth Or OldFractionalBitRate <> NewBitDepthOfFractionalPart Then
		
		TextBitDepth = "(" + TrimAll(NewBitDepth) + "," + TrimAll(NewBitDepthOfFractionalPart) + ")";
		
		QueryText = StrReplace(QueryText, "(28,10)", TextBitDepth);
		QueryText = StrReplace(QueryText, "(28, 10)", TextBitDepth); // with a space
		QueryText = StrReplace(QueryText, "(28,	10)", TextBitDepth); // with tabulation
		
	EndIf;
	
	Return QueryText;
	
EndFunction

