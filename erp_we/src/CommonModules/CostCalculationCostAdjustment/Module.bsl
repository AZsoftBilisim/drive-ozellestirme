	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Expense)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "FALSE");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation", 
		"VALUE(Enum.BusinessTransactions.ProductsRelease)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting", 
		"VALUE(Catalog.BusinessTransactionsSettings.ProductsRelease)");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Department", "SourceDivision");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "AmountIncludingVAT");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "AmountExcludingVAT");
			
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting Then
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "SumCompl");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "PermanentDifference");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "CostTD");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AITAmount", "AITAmount");

	EndIf;
	
	If CalculationParameters.CompanyManagementAccounting Then
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag");
		
	EndIf;
	
	ConditionWHERE = "RecordType = VALUE(AccumulationRecordType.Receipt) AND NOT ThisIsAdjustment";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE);
		
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
	// Reflection of the time difference when VAT is included/excluded in the cost.
	TempTableName = "TTOtherExpensesInclusionExclusionOfVAT";
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation", 
		"VALUE(Enum.BusinessTransactions.InclusionExclusionOfVATInCost)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting", 
		"VALUE(Catalog.BusinessTransactionsSettings.IncludeVATInCostExpenses)");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Sum", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AmountExcludingVAT", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumMan", "0");
	
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting Then
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SumCompl", "0");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "PermanentDifference", "-PermanentDifference");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostTD", "-CostTD");
		
	EndIf;
	
	ConditionWHERE = "RecordType = VALUE(AccumulationRecordType.Receipt)
	|AND ThisIsAdjustment
	|AND ISNULL(ExpenseItem.EnteredInTaxAccounting, FALSE)
	|AND (PermanentDifference <> 0 OR CostTD <> 0)";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE);
		
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

// Service, stage 2.4, 3.16
Procedure CashFlowsOtherExpensesOtherWriteOffOfUnfinishedProduction(CalculationParameters, MotionData) Export

	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	
	CopiedFields = "
	|Period, Organization, Department, ExpenseItem, DimensionOfExpenses, LineOfBusiness, 
	|AllocationBase,
	|BusinessOperation, DocumentRegisterRecords, RowID, BusinessTransactionSetting, FinRecordID";
	
	// Expenditure on the original article
	
	// Let's add a movement and fill in its basic properties
	Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
	
	// Fill in additional motion properties
	Record.RecordType = AccumulationRecordType.Expense;
	Record.CorExpenseItem = MotionData.ExpenseItemRecipient;
	Record.DebitBusinessUnit = MotionData.DebitBusinessUnit;
	Record.CorExpenditureDimension = MotionData.ExpensesDimensionRecipient;
	Record.CorLineOfBusiness 	 = MotionData.CorLineOfBusiness;
	
	Record.Sum 			 = MotionData.Cost + MotionData.AddExpensesForGoods;
	Record.AmountExcludingVAT 		 = MotionData.CostExcludingVAT + MotionData.AdditionalExpensesExcludingVAT;
	If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting Then
		Record.SumCompl 		 = MotionData.LocalCost;
		Record.PermanentDifference = MotionData.PermanentDifference;
		Record.CostTD  = MotionData.CostTD;
		Record.AITAmount 		 = MotionData.CostOfPersonalIncomeTax;
	EndIf;
	If CalculationParameters.CompanyManagementAccounting Then
		Record.SumMan = MotionData.CostMan;
	EndIf;
	
	// The arrival of a new article.
	If ValueIsFilled(MotionData.ExpenseItemRecipient) Then
	
		// Let's add a movement and fill in its basic properties
		Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
		
		// Fill in additional motion properties
		Record.RecordType 		 = AccumulationRecordType.Receipt;
		Record.Department	= MotionData.DebitBusinessUnit;
		Record.LineOfBusiness 	 = MotionData.CorLineOfBusiness;
		Record.ExpenseItem 	 = MotionData.ExpenseItemRecipient;
		Record.DimensionOfExpenses = MotionData.ExpensesDimensionRecipient;
		Record.CorExpenseItem = MotionData.ExpenseItem;
		Record.DebitBusinessUnit = MotionData.Department;
		Record.CorExpenditureDimension = MotionData.DimensionOfExpenses;
		Record.CorLineOfBusiness 	 = MotionData.LineOfBusiness;
		
		Record.Sum 			 = MotionData.Cost + MotionData.AddExpensesForGoods;
		Record.AmountExcludingVAT 		 = ?(MotionData.ExcludeValueWithoutVAT, 0, 
			MotionData.CostExcludingVAT + MotionData.AdditionalExpensesExcludingVAT);
		If CalculationParameters.FederalDistrict.UseAccountingOfOtherIncomeExpensesInLocalAccounting Then
			Record.SumCompl 		 = MotionData.LocalCost;
			Record.PermanentDifference = ?(MotionData.AcceptanceOfCCPWhenDebiting,
										MotionData.PermanentDifference,
										MotionData.LocalCost);
			Record.CostTD  = ?(MotionData.AcceptanceOfCCPWhenDebiting,
										MotionData.CostTD,
										0);
			Record.AITAmount 	 = MotionData.CostOfPersonalIncomeTax;
		EndIf;
		If CalculationParameters.CompanyManagementAccounting Then
			Record.SumMan = MotionData.CostMan;
		EndIf;
	ElsIf ValueIsFilled(MotionData.AssetAndLiabilityItem) Then
		CashFlowsOtherAssetsLiabilities(CalculationParameters, MotionData, MotionData.Cost + MotionData.AddExpensesForGoods);
	EndIf;
	
EndProcedure

