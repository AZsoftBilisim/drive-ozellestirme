// Stage 9 (calling the cost calculation mechanism)
//
Procedure AdjustmentOfCostOfRefundsOfCorrectionsOfPastPeriods(StartupParameters, CalculationParameters, DebugParameters) Export
	
	If Not CalculationParameters.UseCostAccounting Then
		Return;
	EndIf;
	
	// Initialize the calculation parameters
	InitializeGeneralCostCalculationParameters(StartupParameters, CalculationParameters, DebugParameters);
	
	// Generates movements by registers (if the actual calculation is performed):
	// - Cost of goods
	// - Revenue and cost of sales
	// - Other expenses
	// - Other income
	// - Movementnotable income expenses
	// - Movementnomenclature Nomenclature
	AdjustCostOfRefundsFromPreviousPeriods(CalculationParameters);
	
	// Generates movements by registers:
	// - Cost of goods
	// - Other expenses
	// - Other income
	// - Movementnotable income expenses
	// - Movementnomenclature Nomenclature
	AdjustCostOfReverseCorrectedDocuments(CalculationParameters);
	
	// The stage of saving the movements of the document "Allocation of expenses for future periods" to the cache.
	// Generates movements by registers:
	// - Other expenses
	PreparingDataForOtherExpenses(CalculationParameters);
	
	SaveCostCalculationRegisteredRecordsOfCalculatedDocuments(CalculationParameters);
	
	If CalculationParameters.BatchCalculationStarted Then
			
		// Return to the batch calculation mechanism from the cost calculation
		CostCalculationAppliedAlgorithms.CostCalculationMechanismIsPerformed(CalculationParameters, False);
			
		// We will restore all settlement caches of balances and turnover for all organizations
		CostCalculationAppliedAlgorithms.UpdateCalculatedRegisterCaches_(CalculationParameters);
		
	EndIf;
		
EndProcedure

// Stage of saving the movements of the document "distribution of expenses for future periods" to the cache.
//
Procedure PreparingDataForOtherExpenses(CalculationParameters) Export

	If CalculationParameters.PreliminaryCalculation Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "PreparingDataForOtherExpenses");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	Query.Text =
	"SELECT
	|	T.Period,
	|	T.RecordType,
	|	T.Recorder,
	|	T.Organization,
	|	T.Department,
	|	T.LineOfBusiness,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.Sum,
	|	T.AmountExcludingVAT,
	|	T.SumCompl,
	|	T.SumMan,
	|	T.PermanentDifference,
	|	T.CostTD,
	|	T.AITAmount,
	|	T.DebitBusinessUnit,
	|	T.CorLineOfBusiness,
	|	T.CorExpenseItem,
	|	T.CorExpenditureDimension,
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|
	|INTO TTOtherExpenses
	|FROM
	|	AccumulationRegister.OtherExpenses AS T
	|	INNER JOIN Document.DeferredExpensesAllocation AS Allocation
	|		ON Allocation.Ref = T.Recorder 
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN (&CompanyArray)
	|	AND T.Active
	|	AND Allocation.Date < &BeginOfPeriod
	|	AND (T.LotCalculation OR T.CalculationOfCost)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Period,
	|	T.Recorder,
	|	T.RecordType,
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.AssetsLiabilitiesDimension,
	|	T.ExpenseReceiptDocument,
	|	T.LotVendorAttributes,
	|	T.LineOfBusiness,
	|	T.ItemsLocationAttributes,
	|	T.VATActivityType,
	|	T.Cost,
	|	T.CostExcludingVAT,
	|	T.LocalCost,
	|	T.VATLocal,
	|	T.PermanentDifference,
	|	T.CostTD,
	|	T.VATManag,
	|	T.VATTaxation,
	|	T.DocumentSalesOfGoodsAndServices,
	|	T.ExpenseItem_,
	|	T.ExpensesPostingDimension,
	|	T.BasePeriod,
	|	T.RowID,
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.ReversingEntry,
	|	T.CorExpenseItem,
	|	T.CorExpenditureDimension,
	|	T.DebitBusinessUnit,
	|	T.CorLineOfBusiness,
	|	T.SourceKind,
	|	T.CorGroupOfManufacturedProducts
	|INTO TTMovementAndOtherExpenses
	|FROM
	|	AccumulationRegister.ItemisedExpensesLots AS T
	|		INNER JOIN Document.DeferredExpensesAllocation AS Allocation
	|		ON Allocation.Ref = T.Recorder
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN(&CompanyArray)
	|	AND T.Active
	|	AND Allocation.Date < &BeginOfPeriod
	|	AND (T.LotCalculation OR T.CalculationOfCost)";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	MatchingTemporaryMovementTables = New Map;
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherExpenses.Name, "RBP");
	DescriptionOfTT.NameOfSourceTT = "TTOtherExpenses";
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name, "RBP");
	DescriptionOfTT.NameOfSourceTT = "TTMovementAndOtherExpenses";
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

// Stage 3.3
// Adjusts the cost of refunds from previous periods
// The returns of past periods include incoming movements in the cost register with a business transaction from the array of operationsreferences of past periods ()
// The Difference between returns of past periods and returns of the Cur Period is the method of determining the cost of the refund
// the cost must be taken from the period from the period of the primary document.
// - if the document source (primary document) is filled out in the return movement, then the cost is taken from the movements of this document
//	= if the primary document is in the period when there was no batch accounting 2.2, then when connecting to the cost table, the connection is not performed for the batch accounting fields 2.2
//	= if the primary document is in the batch accounting period 2.2, then the connection is performed for all fields
// - if the document source is not filled in, then the cost is taken from the register of information on the cost of goods for the period of realization
// 	= for a refund based on the commission agent's report, the period of implementation is filled in not in the return movements, but using the Commission agent's Turnout report table
// In addition to the cost of the returned product, additional costs attributed to this product must be refunded.
// The amounts of additional expenses are stored in the table of total expenditures of the previous periods
//
// The peculiarity of filling in the fields of activity and corviddeactivity:
// these fields in the return movement must be filled in exactly the same way as in the primary document.
// The initial values of these fields are determined in the procedure for calculating the cost of filling in the parties.The textrealizations of the past two months()
// and from this data are substituted into the return movements
// (also see calculation of the cost of filling parties.Fill in the estimated partyusebest value of goods, source Past, receiver return past periods)
//
// Special feature of VAT inclusion/exclusion:
// in addition to VAT inclusion/exclusion in expenditure movements, it is necessary to reverse this operation in the movements of the refund document.
// The cancellation of VAT inclusion/exclusion must be performed using the same registers as in the primary document.
//
Procedure AdjustCostOfRefundsFromPreviousPeriods(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfRefundsFromPreviousPeriods");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	MatchingTemporaryMovementTables = New Map;

#Region DataRequest
	
	Query.Text = "
	|SELECT
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	PartnerAnalytics_.Organization AS Organization,
	|	SUM(DD.Count) AS Count,
	|	MAX(Costs_2.Period) AS Period
	|INTO StornoCommissionAgentSReports
	|FROM
	|	TTCashEstimatedTurnoverRevenueAndCostOfSales AS DD
	|	INNER JOIN Catalog.DimensionKeysOfAccountingByPartners AS PartnerAnalytics_
	|	ON DD.AccountingDimensionByPartners = PartnerAnalytics_.Ref
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON PartnerAnalytics_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|	INNER JOIN InformationRegister.GoodsCost AS Costs_2
	|		ON Costs_2.Period < &BeginOfPeriod
	|		AND Costs_2.ItemsLocationAttributes = DD.ItemsLocationAttributes
	|		AND Costs_2.AccountingSection = DD.AccountingSection
	|		AND Costs_2.InventoryOwnerAttribute = DD.InventoryOwnerAttribute
	|		AND Costs_2.Organization = PartnerAnalytics_.Organization
	|WHERE
	|	DD.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|GROUP BY
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	PartnerAnalytics_.Organization
	|HAVING
	|	SUM(DD.Count) < 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	Cost_.DocumentSource AS Ref
	|INTO TTImplementationOfPastPeriods
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS Cost_
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON Cost_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|WHERE
	|	Cost_.OfficialTypeOfMovementParish
	|	AND Cost_.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	AND Cost_.DocumentSource <> UNDEFINED
	// For the "Reverse" entries, the cost is determined in the procedure to adjust the cost of the movement of the corrected documents() 
	|	AND NOT Cost_.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	Cost_.DocumentSource AS Ref
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS Cost_
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON Cost_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|	LEFT JOIN InformationRegister.DocumentsRegistry AS Register3
	|	ON Register3.Ref = Cost_.DocumentSource
	|		AND Cost_.DocumentSource <> UNDEFINED
	|		AND (NOT Register3.AdditionalRecord OR Register3.RefType IN (&DocumentsWithTwoOrganizations))
	|WHERE
	|	NOT Cost_.OfficialTypeOfMovementParish
	|	AND Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|	AND Cost_.EntryType = VALUE(Enum.LotRecordTypes.ReturnWithoutSourceDocument)
	|	AND Cost_.DocumentSource <> UNDEFINED
	|	AND Register3.IBDocumentDate < &BeginOfPeriod
	// The data sampling conditions must match the functions
	// - See CostCalculationLESSolution.TextTT_Adjustments_MaterialAndLaborCosts
	// - Adjust the value of the inventory write-down()
	|
	|INDEX BY
	|	Ref
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	Cost_.Recorder                         AS Ref,
	|	Cost_.ItemsLocationAttributes          AS ItemsLocationAttributes,
	|	Cost_.AccountingSection                         AS AccountingSection,
	|	Cost_.InventoryOwnerAttribute                          AS InventoryOwnerAttribute,
	|	Cost_.Organization               		  AS Organization,
	|	Cost_.Lot                          	  AS Lot,
	|	Cost_.LotVendorAttributes                AS LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension           AS FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &BatchAccountingVersion22
	|		 OR Cost_.Period < &DateOfMigrationToBatchAccounting22
	|			THEN VALUE(Enum.VATTaxationTypes.EmptyRef)
	|		WHEN Cost_.CorVATActivityTypes = VALUE(Enum.VATTaxationTypes.EmptyRef)
	|			THEN Cost_.VATActivityType
	|		ELSE Cost_.CorVATActivityTypes
	|	END                                             AS VATActivityType,
	|
	|	SUM(Cost_.Count)                   AS Count,
	|	SUM(Cost_.Cost)                    AS Cost,
	|	SUM(Cost_.CostExcludingVAT)              AS CostExcludingVAT,
	|	SUM(Cost_.OffBalanceCost)        AS OffBalanceCost,
	|	SUM(Cost_.AddExpensesForGoods)             	  AS AddExpensesForGoods,
	|	SUM(Cost_.AdditionalExpensesExcludingVAT)       	  AS AdditionalExpensesExcludingVAT,
	|	SUM(Cost_.LaborCosts)       		  AS LaborCosts,
	|	SUM(Cost_.ItemizedFixedCostsIncludingVAT)    AS ItemizedFixedCostsIncludingVAT,
	|	SUM(Cost_.ItemizedFixedCostsExcludingVAT)  AS ItemizedFixedCostsExcludingVAT,
	|	SUM(Cost_.ItemizedVariableCostsIncludingVAT)    AS ItemizedVariableCostsIncludingVAT,
	|	SUM(Cost_.ItemizedVariableCostsExcludingVAT)  AS ItemizedVariableCostsExcludingVAT,
	|	SUM(Cost_.LocalCost)                AS LocalCost,
	|	SUM(Cost_.OffBalanceCostLocal)    AS OffBalanceCostLocal,
	|	SUM(Cost_.PermanentDifference)            AS PermanentDifference,
	|	SUM(Cost_.CostTD)             AS CostTD,
	|	SUM(Cost_.CostOfPersonalIncomeTax)                 AS CostOfPersonalIncomeTax,
	|	SUM(Cost_.AddExpensesLocal)               AS AddExpensesLocal,
	|	SUM(Cost_.LaborCostsLocal)             AS LaborCostsLocal,
	|	SUM(Cost_.ItemizedFixedCostsCompl)    AS ItemizedFixedCostsCompl,
	|	SUM(Cost_.ItemizedVariableCostsCompl)    AS ItemizedVariableCostsCompl,
	|	SUM(Cost_.CostMan)    			  AS CostMan,
	|	SUM(Cost_.AddExpensesMan)    			  AS AddExpensesMan,
	|	SUM(Cost_.LaborCostsMan)    		  AS LaborCostsMan,
	|	SUM(Cost_.ItemizedFixedCostsManag)     AS ItemizedFixedCostsManag,
	|	SUM(Cost_.ItemizedVariableCostsManag)     AS ItemizedVariableCostsManag
	|INTO TTAmountsOfRealizationsOfPastPeriods
	|FROM
	|	AccumulationRegister.InventoryCost AS Cost_
	|	INNER JOIN TTImplementationOfPastPeriods AS Sales
	|		ON Sales.Ref = Cost_.Recorder
	|WHERE
	|	Cost_.Period < &BeginOfPeriod
	|	AND Cost_.Organization IN(&CompanyArray)
	|	AND Cost_.RecordType = VALUE(AccumulationRecordType.Expense)
	|	AND Cost_.Active
	|
	|GROUP BY
	|	Cost_.Recorder,
	|	Cost_.ItemsLocationAttributes,
	|	Cost_.AccountingSection,
	|	Cost_.InventoryOwnerAttribute,
	|	Cost_.Organization,
	|	Cost_.Lot,
	|	Cost_.LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension,
	|	CASE
	|		WHEN NOT &BatchAccountingVersion22
	|		 OR Cost_.Period < &DateOfMigrationToBatchAccounting22
	|			THEN VALUE(Enum.VATTaxationTypes.EmptyRef)
	|		WHEN Cost_.CorVATActivityTypes = VALUE(Enum.VATTaxationTypes.EmptyRef)
	|			THEN Cost_.VATActivityType
	|		ELSE Cost_.CorVATActivityTypes
	|	END
	|
	|HAVING
	|	SUM(Cost_.Count) <> 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SaleCost.DocumentRegisterRecords                  AS Ref,
	|	SaleCost.ItemsLocationAttributes        AS ItemsLocationAttributes,
	|	SaleCost.AccountingSection                       AS AccountingSection,
	|	SaleCost.InventoryOwnerAttribute                        AS InventoryOwnerAttribute,
	|	SaleCost.Organization               		  AS Organization,
	|	SaleCost.Lot                            AS Lot,
	|	SaleCost.LotVendorAttributes              AS LotVendorAttributes,
	|	SaleCost.FinancialAccountingDimension         AS FinancialAccountingDimension,
	|	SaleCost.VATActivityType                AS VATActivityType,
	|
	|	SUM(SaleCost.AddExpensesForGoods)             	  AS AddExpensesForGoods,
	|	SUM(SaleCost.AdditionalExpensesExcludingVAT)       	  AS AdditionalExpensesExcludingVAT,
	|	SUM(SaleCost.AddExpensesLocal)             AS AddExpensesLocal,
	|	SUM(SaleCost.AddExpensesMan)    		  AS AddExpensesMan
	|
	|INTO TTAmountsOfAdditionalExpensesOfPreviousPeriods
	|FROM (
	|	SELECT
	|		SaleCost.DocumentRegisterRecords,
	|		SaleCost.ItemsLocationAttributes,
	|		SaleCost.AccountingSection,
	|		SaleCost.InventoryOwnerAttribute,
	|		PartnerAnalytics_.Organization,
	|		SaleCost.Lot,
	|		SaleCost.LotVendorAttributes,
	|		SaleCost.FinancialAccountingDimension,
	|		SaleCost.VATActivityType,
	|
	|		SaleCost.AddExpensesForGoods,
	|		SaleCost.AdditionalExpensesExcludingVAT,
	|		SaleCost.AddExpensesLocal,
	|		SaleCost.AddExpensesMan
	|	FROM
	|		AccumulationRegister.RevenueAndCOGS AS SaleCost
	|		INNER JOIN Catalog.DimensionKeysOfAccountingByPartners AS PartnerAnalytics_
	|			ON SaleCost.AccountingDimensionByPartners = PartnerAnalytics_.Ref
	|		INNER JOIN TTImplementationOfPastPeriods AS Sales
	|			ON Sales.Ref = SaleCost.DocumentRegisterRecords
	|	WHERE
	|		SaleCost.Period < &BeginOfPeriod
	|		AND PartnerAnalytics_.Organization IN(&CompanyArray)
	|		AND SaleCost.LotCalculation
	|		AND SaleCost.Active
	|
	|	UNION ALL
	|	SELECT
	|		SaleCost.DocumentRegisterRecords,
	|		SaleCost.ItemsLocationAttributes,
	|		SaleCost.AccountingSection,
	|		SaleCost.InventoryOwnerAttribute,
	|		PartnerAnalytics_.Organization,
	|		SaleCost.Lot,
	|		SaleCost.LotVendorAttributes,
	|		SaleCost.FinancialAccountingDimension,
	|		SaleCost.VATActivityType,
	|
	|		SaleCost.AddExpensesForGoods,
	|		SaleCost.AdditionalExpensesExcludingVAT,
	|		SaleCost.AddExpensesLocal,
	|		SaleCost.AddExpensesMan
	|	FROM
	|		TTCashEstimatedTurnoverRevenueAndCostOfSales AS SaleCost
	|		INNER JOIN Catalog.DimensionKeysOfAccountingByPartners AS PartnerAnalytics_
	|			ON SaleCost.AccountingDimensionByPartners = PartnerAnalytics_.Ref
	|		INNER JOIN TTImplementationOfPastPeriods AS Sales
	|			ON Sales.Ref = SaleCost.DocumentRegisterRecords
	|	WHERE
	|		SaleCost.LotCalculation
	|
	|	) AS SaleCost
	|GROUP BY
	|	SaleCost.DocumentRegisterRecords,
	|	SaleCost.ItemsLocationAttributes,
	|	SaleCost.AccountingSection,
	|	SaleCost.InventoryOwnerAttribute,
	|	SaleCost.Organization,
	|	SaleCost.Lot,
	|	SaleCost.LotVendorAttributes,
	|	SaleCost.FinancialAccountingDimension,
	|	SaleCost.VATActivityType
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Revenue.Recorder,
	|	Revenue.ItemsLocationAttributes,
	|	CatInventoryLocationAttributeKeys.Products AS Products,
	|	CatInventoryLocationAttributeKeys.Characteristic AS Characteristic,
	|	CatInventoryLocationAttributeKeys.Series AS Series,
	|	CatInventoryLocationAttributeKeys.Purpose AS Purpose,
	|	Revenue.InventoryOwnerAttribute,
	|	Revenue.SalesOrder,
	|	MAX(Revenue.Terms) AS Terms,
	|	MAX(Revenue.Manager) AS Manager,
	|	MAX(Revenue.Warehouse) AS Warehouse,
	|	MAX(Revenue.SetAccountingDimension) AS SetAccountingDimension,
	|	MAX(Revenue.CounterpartyLineOfBusiness) AS CounterpartyLineOfBusiness,
	|	MAX(Revenue.ProductLineOfBusiness) AS ProductLineOfBusiness,
	|	MAX(Revenue.VATTaxation) AS VATTaxation,
	|	MAX(Revenue.ARAPCurrency) AS ARAPCurrency,
	|	MAX(Revenue.DocumentCurrency) AS DocumentCurrency,
	|	MAX(Revenue.Contract) AS Contract,
	|	MAX(Revenue.SourceOfProductFinancialAccountingGroup) AS SourceOfProductFinancialAccountingGroup,
	|	MAX(Revenue.SourceOfARAPFinancialAccountingGroup) AS SourceOfARAPFinancialAccountingGroup,
	|	MAX(Revenue.VATRate) AS VATRate
	|INTO RevenueDetails
	|FROM
	|	TTCashEstimatedTurnoverRevenueAndCostOfSales AS Revenue
	|	INNER JOIN Catalog.DimensionKeysOfAccountingByPartners AS PartnerAnalytics_
	|	ON Revenue.AccountingDimensionByPartners = PartnerAnalytics_.Ref
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON PartnerAnalytics_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS CatInventoryLocationAttributeKeys
	|		ON Revenue.ItemsLocationAttributes = CatInventoryLocationAttributeKeys.Ref
	|WHERE
	|	Revenue.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|GROUP BY
	|	Revenue.Recorder,
	|	Revenue.ItemsLocationAttributes,
	|	Revenue.InventoryOwnerAttribute,
	|	Revenue.SalesOrder,
	|	CatInventoryLocationAttributeKeys.Products,
	|	CatInventoryLocationAttributeKeys.Characteristic,
	|	CatInventoryLocationAttributeKeys.Series,
	|	CatInventoryLocationAttributeKeys.Purpose
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RegisterRecords.Recorder,
	|	RegisterRecords.ItemsLocationAttributes,
	|	RegisterRecords.InventoryOwnerAttribute,
	|	MAX(RegisterRecords.Warehouse) AS Warehouse,
	|	MAX(RegisterRecords.SourceOfProductFinancialAccountingGroup) AS SourceOfProductFinancialAccountingGroup
	|INTO DetailsOfMovementProductsIncomeExpenses
	|FROM
	|	AccumulationRegister.RegisterRecordsProductsIncomeExpenses AS RegisterRecords
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON RegisterRecords.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|WHERE
	|	RegisterRecords.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND RegisterRecords.Organization IN(&CompanyArray)
	|	AND RegisterRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.InventoryConsumptionReverseTransaction)
	|	AND NOT RegisterRecords.CalculationOfCost
	|	AND RegisterRecords.Active
	|GROUP BY
	|	RegisterRecords.Recorder,
	|	RegisterRecords.ItemsLocationAttributes,
	|	RegisterRecords.InventoryOwnerAttribute
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Register3.Ref AS Ref,
	|	MAX(Register3.IBDocumentDate) AS IBDocumentDate
	|
	|INTO TueDatesOfSourceDocuments
	|FROM (
	|	SELECT
	|		Register3.Ref AS Ref,
	|		Register3.IBDocumentDate
	|	FROM
	|		TTCashEstimatedTurnoverCostOfGoods AS CostAccounting_
	|		INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON CostAccounting_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|			AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|		INNER JOIN InformationRegister.DocumentsRegistry AS Register3
	|		ON Register3.Ref = CostAccounting_.DocumentSource
	|			AND CostAccounting_.DocumentSource <> UNDEFINED
	|			AND (NOT Register3.AdditionalRecord OR Register3.RefType IN (&DocumentsWithTwoOrganizations))
	|	WHERE
	|		NOT CostAccounting_.OfficialTypeOfMovementParish
	|		AND CostAccounting_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|		AND CostAccounting_.EntryType = VALUE(Enum.LotRecordTypes.ReturnWithoutSourceDocument)
	|
	|	UNION ALL
	|
	|	SELECT
	|		Register3.Ref AS Ref,
	|		Register3.IBDocumentDate
	|	FROM
	|		TTCashEstimatedTurnoverCostOfGoods AS CostAccounting_
	|		INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON CostAccounting_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|			AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|		INNER JOIN InformationRegister.DocumentsRegistry AS Register3
	|		ON Register3.Ref = CostAccounting_.DocumentSource
	|			AND CostAccounting_.DocumentSource <> UNDEFINED
	|			AND (NOT Register3.AdditionalRecord OR Register3.RefType IN (&DocumentsWithTwoOrganizations))
	|	WHERE
	|		CostAccounting_.ReversingEntry
	|		AND CostAccounting_.EntryType IN (
	|			VALUE(Enum.LotRecordTypes.PurchaseAdjustment),
	|			VALUE(Enum.LotRecordTypes.ProductCostConsumptionPastPeriodReverseTransaction))
	|	) AS Register3
	|GROUP BY
	|	Register3.Ref
	|
	|INDEX BY
	|	Ref
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Cost_.Period                              AS Period,
	|	Cost_.Recorder                         AS Recorder,
	|	CASE WHEN Cost_.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END                   						  AS RecordType,
	|	Cost_.ItemsLocationAttributes          AS ItemsLocationAttributes,
	|	Cost_.AccountingSection                         AS AccountingSection,
	|	Cost_.InventoryOwnerAttribute                          AS InventoryOwnerAttribute,
	|	Cost_.InventoryOwnerAttribute.InventoryType               AS InventoryType,
	|	Cost_.Lot                          	  AS Lot,
	|	Cost_.LotVendorAttributes                AS LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension           AS FinancialAccountingDimension,
	|	Cost_.VATActivityType                  AS VATActivityType,
	|	(CASE
	|		WHEN Cost_.CorVATActivityTypes = VALUE(Enum.VATTaxationTypes.EmptyRef)
	|			THEN Cost_.VATActivityType
	|		ELSE Cost_.CorVATActivityTypes
	|	END)                                            AS CorVATActivityTypes,
	|
	// The cor. part may contain data on the original sales analytics (if the return goes to another warehouse)
	|	CASE WHEN Cost_.CorInventoryOwnerAttribute <> VALUE(Catalog.InventoryKinds.EmptyRef)
	|	 AND Cost_.BusinessOperation <> VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod) THEN
	|			Cost_.CorInventoryOwnerAttribute
	|		ELSE
	|			Cost_.InventoryOwnerAttribute
	|	END                                             AS TypesOfStocksForPrice,
	// The cor. part may contain data on the original form of sales stocks (in case of return of goods sold by Intercampany)
	|	CASE WHEN Cost_.CorItemsLocationAttributes <> VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
	|	 AND Cost_.BusinessOperation <> VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod) THEN
	|			Cost_.CorItemsLocationAttributes
	|		ELSE
	|			Cost_.ItemsLocationAttributes
	|	END                                             AS ProductAnalysisForPrices,
	|
	|	SUM(Cost_.Count)                   AS Count,
	|
	|	SUM(Cost_.Cost)                    AS Cost,
	|	SUM(Cost_.CostExcludingVAT)              AS CostExcludingVAT,
	|	SUM(Cost_.OffBalanceCost)        AS OffBalanceCost,
	|
	|	SUM(Cost_.AddExpensesForGoods)             	  AS AddExpensesForGoods,
	|	SUM(Cost_.AdditionalExpensesExcludingVAT)       	  AS AdditionalExpensesExcludingVAT,
	|	SUM(Cost_.LaborCosts)       		  AS LaborCosts,
	|	SUM(Cost_.ItemizedFixedCostsIncludingVAT)	  AS ItemizedFixedCostsIncludingVAT,
	|	SUM(Cost_.ItemizedFixedCostsExcludingVAT)  AS ItemizedFixedCostsExcludingVAT,
	|	SUM(Cost_.ItemizedVariableCostsIncludingVAT)	  AS ItemizedVariableCostsIncludingVAT,
	|	SUM(Cost_.ItemizedVariableCostsExcludingVAT)  AS ItemizedVariableCostsExcludingVAT,
	|
	|	SUM(Cost_.LocalCost)                AS LocalCost,
	|	SUM(Cost_.OffBalanceCostLocal)    AS OffBalanceCostLocal,
	|
	|	SUM(Cost_.PermanentDifference)            AS PermanentDifference,
	|	SUM(Cost_.CostTD)             AS CostTD,
	|
	|	SUM(Cost_.CostOfPersonalIncomeTax)                 AS CostOfPersonalIncomeTax,
	|
	|	SUM(Cost_.AddExpensesLocal)               AS AddExpensesLocal,
	|	SUM(Cost_.LaborCostsLocal)             AS LaborCostsLocal,
	|	SUM(Cost_.ItemizedFixedCostsCompl)	  AS ItemizedFixedCostsCompl,
	|	SUM(Cost_.ItemizedVariableCostsCompl)	  AS ItemizedVariableCostsCompl,
	
	|	SUM(Cost_.CostMan)	  			  AS CostMan,
	|	SUM(Cost_.AddExpensesMan)	  			  AS AddExpensesMan,
	|	SUM(Cost_.LaborCostsMan)	  		  AS LaborCostsMan,
	|	SUM(Cost_.ItemizedFixedCostsManag)	  AS ItemizedFixedCostsManag,
	|	SUM(Cost_.ItemizedVariableCostsManag)	  AS ItemizedVariableCostsManag,
	|
	|	Cost_.BusinessOperation               AS BusinessOperation,
	|	Cost_.CorItemsLocationAttributes       AS CorItemsLocationAttributes,
	|	Cost_.CorAccountingSection                      AS CorAccountingSection,
	|	Cost_.CorInventoryOwnerAttribute                       AS CorInventoryOwnerAttribute,
	|	Cost_.CorInventoryOwnerAttribute.InventoryType            AS CorInventoryType,
	|	Cost_.AccountingDimensionByPartners           AS AccountingDimensionByPartners,
	|	Cost_.SalesOrder                        AS SalesOrder,
	|	Cost_.Department                       AS Department,
	|	Cost_.Organization                         AS Organization,
	|	Cost_.CorCompany                      AS CorCompany,
	|	Cost_.SalePeriod                       AS SalePeriod,
	|	ISNULL(StornoCommissionAgentSReports.Period,
	|		BEGINOFPERIOD(Cost_.SalePeriod, MONTH)) AS ImplementationPeriod,
	|	Cost_.DimensionOfExpenses                   AS DimensionOfExpenses,
	|	Cost_.ExpenseItemOfWriteOff              AS ExpenseItemOfWriteOff,
	|	Cost_.IncomeItem                       AS IncomeItem,
	|	Cost_.DimensionOfRevenue                    AS DimensionOfRevenue,
	|	Cost_.ProductsGroup                     AS ProductsGroup,
	|	Cost_.RowID                 AS RowID,
	|	Cost_.RowCode                 		  AS RowCode,
	|	Cost_.CorLot                 		  AS CorLot,
	|	Cost_.LotVendorAttributesCorr             AS LotVendorAttributesCorr,
	|	Cost_.CorControllingAttributes        AS CorControllingAttributes,
	|	Cost_.VATLocal                 			  AS VATLocal,
	|	Cost_.VATManag                 			  AS VATManag,
	|	Cost_.ProductCostElement                   AS ProductCostElement,
	|	Cost_.EntryType                 		  AS EntryType,
	|	Cost_.DocumentSource                 	  AS DocumentSource,
	|	Cost_.CorLineOfBusiness          AS CorLineOfBusiness,
	|	Cost_.BusinessTransactionSetting      AS BusinessTransactionSetting,
	|	Cost_.FinRecordID              AS FinRecordID,
	|	Cost_.CostAccountingTransaction          AS CostAccountingTransaction,
	|	Cost_.GLAccountSettings                AS GLAccountSettings,
	|	Cost_.CostDefiningMethod      AS CostDefiningMethod,
	|	ISNULL(RevenueDetails.Terms, UNDEFINED) AS Terms,
	|	ISNULL(RevenueDetails.Manager, UNDEFINED) AS Manager,
	|	(CASE
	|		WHEN NOT InventoryConsumptionReverseTransaction.Warehouse IS NULL
	|			THEN DetailsOfMovementProductsIncomeExpenses.Warehouse
	|		ELSE ISNULL(RevenueDetails.Warehouse, UNDEFINED) END) AS Warehouse,
	|	ISNULL(RevenueDetails.SetAccountingDimension, UNDEFINED) AS SetAccountingDimension,
	|	ISNULL(RevenueDetails.CounterpartyLineOfBusiness, UNDEFINED) AS CounterpartyLineOfBusiness,
	|	ISNULL(RevenueDetails.ProductLineOfBusiness, UNDEFINED) AS ProductLineOfBusiness,
	|	ISNULL(RevenueDetails.VATTaxation, UNDEFINED) AS VATTaxation,
	|	ISNULL(RevenueDetails.Contract, UNDEFINED) AS Contract,
	|	ISNULL(RevenueDetails.ARAPCurrency, UNDEFINED) AS ARAPCurrency,
	|	ISNULL(RevenueDetails.DocumentCurrency, UNDEFINED) AS DocumentCurrency,
	|	(CASE
	|		WHEN NOT InventoryConsumptionReverseTransaction.Warehouse IS NULL
	|			THEN DetailsOfMovementProductsIncomeExpenses.SourceOfProductFinancialAccountingGroup
	|		ELSE ISNULL(RevenueDetails.SourceOfProductFinancialAccountingGroup, UNDEFINED) END) AS SourceOfProductFinancialAccountingGroup,
	|	ISNULL(RevenueDetails.SourceOfARAPFinancialAccountingGroup, UNDEFINED) AS SourceOfARAPFinancialAccountingGroup,
	|
	|	CASE WHEN Cost_.DocumentSource <> UNDEFINED
	|	  AND Cost_.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	  AND (NOT &BatchAccountingVersion22 OR Cost_.SalePeriod < &DateOfMigrationToBatchAccounting22)
	|		THEN TRUE
	|		ELSE FALSE
	|	END											  AS AtSellingPrice,
	|	CASE WHEN Cost_.DocumentSource <> UNDEFINED
	|	  AND Cost_.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	  AND &BatchAccountingVersion22
	|	  AND Cost_.SalePeriod > &DateOfMigrationToBatchAccounting22
	|		THEN TRUE
	|		ELSE FALSE
	|	END											  AS AtSellingPrice22,
	|	ISNULL(RevenueDetails.VATRate, UNDEFINED) AS VATRate
	|INTO TTRefundsFromPreviousPeriods
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS Cost_
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON Cost_.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|	LEFT JOIN Document.OtherGoodsRecordingAsReceived AS InventoryConsumptionReverseTransaction
	|		ON InventoryConsumptionReverseTransaction.Ref = Cost_.Recorder
	|	LEFT JOIN StornoCommissionAgentSReports AS StornoCommissionAgentSReports
	|		ON StornoCommissionAgentSReports.ItemsLocationAttributes = Cost_.ItemsLocationAttributes
	|		AND StornoCommissionAgentSReports.AccountingSection = Cost_.AccountingSection
	|		AND StornoCommissionAgentSReports.InventoryOwnerAttribute = Cost_.InventoryOwnerAttribute
	|		AND StornoCommissionAgentSReports.Organization = Cost_.Organization
	|		AND Cost_.Count < 0
	|		AND Cost_.DocumentSource = UNDEFINED
	|	LEFT JOIN RevenueDetails AS RevenueDetails
	|		ON RevenueDetails.Recorder = Cost_.Recorder
	|		AND RevenueDetails.ItemsLocationAttributes = Cost_.CorItemsLocationAttributes
	|		AND (RevenueDetails.InventoryOwnerAttribute = Cost_.InventoryOwnerAttribute
	|			OR RevenueDetails.InventoryOwnerAttribute = VALUE(Catalog.InventoryKinds.EmptyRef))
	|		AND RevenueDetails.SalesOrder = Cost_.SalesOrder
	|	LEFT JOIN DetailsOfMovementProductsIncomeExpenses AS DetailsOfMovementProductsIncomeExpenses
	|		ON DetailsOfMovementProductsIncomeExpenses.Recorder = Cost_.Recorder
	|		AND DetailsOfMovementProductsIncomeExpenses.ItemsLocationAttributes = Cost_.ItemsLocationAttributes
	|		AND DetailsOfMovementProductsIncomeExpenses.InventoryOwnerAttribute = Cost_.InventoryOwnerAttribute
	|	LEFT JOIN TueDatesOfSourceDocuments AS Register3
	|		ON Register3.Ref = Cost_.DocumentSource
	|	LEFT JOIN CalculatedDocuments AS CalculatedDocuments
	|		ON CalculatedDocuments.Period = Cost_.Period
	|		AND CalculatedDocuments.Recorder = Cost_.Recorder
	|WHERE
	|	((Cost_.OfficialTypeOfMovementParish
	|		AND Cost_.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods))
	|		OR (Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|			AND NOT StornoCommissionAgentSReports.Period IS NULL)
	|		OR (NOT Cost_.OfficialTypeOfMovementParish
	|			AND Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|			AND Cost_.EntryType = VALUE(Enum.LotRecordTypes.ReturnWithoutSourceDocument)
	|			AND Cost_.DocumentSource <> UNDEFINED
	|			AND Register3.IBDocumentDate < &BeginOfPeriod)
	|		OR (NOT Cost_.OfficialTypeOfMovementParish
	|			AND Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
	|			AND Cost_.EntryType = VALUE(Enum.LotRecordTypes.ReturnWithoutSourceDocument)
	|			AND Cost_.DocumentSource = UNDEFINED
	// The period of realization must be filled in so that the sum movements for the return are formed
	|			AND ISNULL(StornoCommissionAgentSReports.Period,
	|				BEGINOFPERIOD(Cost_.SalePeriod, MONTH)) <> DATETIME(1,1,1,0,0,0)
	|			AND Cost_.SalePeriod < &BeginOfPeriod)
	|	)
	|	AND NOT Cost_.CalculationOfCost
	// For the "Reverse" entries, the cost is determined in the procedure to adjust the cost of the movement of the corrected documents() 
	|	AND NOT Cost_.ReversingEntry
	// During the preliminary calculation, we exclude documents for which previously calculated movements are saved
	|	AND CalculatedDocuments.Recorder IS NULL
	|	
	|GROUP BY
	|	Cost_.Period,
	|	CASE WHEN Cost_.OfficialTypeOfMovementParish
	|		THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END,
	|	Cost_.AccountingSection,
	|	Cost_.InventoryOwnerAttribute,
	|	Cost_.InventoryOwnerAttribute.InventoryType,
	|	Cost_.Department,
	|	Cost_.ItemsLocationAttributes,
	|	Cost_.Lot,
	|	Cost_.LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension,
	|	Cost_.VATActivityType,
	|	(CASE
	|		WHEN Cost_.CorVATActivityTypes = VALUE(Enum.VATTaxationTypes.EmptyRef)
	|			THEN Cost_.VATActivityType
	|		ELSE Cost_.CorVATActivityTypes
	|	END),
	|	CASE WHEN Cost_.CorItemsLocationAttributes <> VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
	|		THEN Cost_.CorItemsLocationAttributes
	|	ELSE Cost_.ItemsLocationAttributes END,
	|	CASE WHEN Cost_.CorInventoryOwnerAttribute <> VALUE(Catalog.InventoryKinds.EmptyRef) THEN
	|			Cost_.CorInventoryOwnerAttribute
	|		ELSE
	|			Cost_.InventoryOwnerAttribute
	|	END,
	|	Cost_.CorItemsLocationAttributes,
	|	Cost_.SalesOrder,
	|	Cost_.AccountingDimensionByPartners,
	|	Cost_.BusinessOperation,
	|	Cost_.CorAccountingSection,
	|	Cost_.CorInventoryOwnerAttribute,
	|	Cost_.CorInventoryOwnerAttribute.InventoryType,
	|	Cost_.SalePeriod,
	|	ISNULL(StornoCommissionAgentSReports.Period,
	|		BEGINOFPERIOD(Cost_.SalePeriod, MONTH)),
	|	Cost_.Organization,
	|	Cost_.CorCompany,
	|	Cost_.DimensionOfExpenses,
	|	Cost_.ExpenseItemOfWriteOff,
	|	Cost_.IncomeItem,
	|	Cost_.DimensionOfRevenue,
	|	Cost_.ProductsGroup,
	|	Cost_.Recorder,
	|	Cost_.RowID,
	|	Cost_.RowCode,
	|	Cost_.CorLot,
	|	Cost_.LotVendorAttributesCorr,
	|	Cost_.CorControllingAttributes,
	|	Cost_.VATLocal,
	|	Cost_.VATManag,
	|	Cost_.ProductCostElement,
	|	Cost_.EntryType,
	|	Cost_.DocumentSource,
	|	Cost_.CorLineOfBusiness,
	|	Cost_.BusinessTransactionSetting,
	|	Cost_.FinRecordID,
	|	Cost_.CostAccountingTransaction,
	|	Cost_.GLAccountSettings,
	|	Cost_.CostDefiningMethod,
	|	ISNULL(RevenueDetails.Terms, UNDEFINED),
	|	ISNULL(RevenueDetails.Manager, UNDEFINED),
	|	(CASE
	|		WHEN NOT InventoryConsumptionReverseTransaction.Warehouse IS NULL
	|			THEN DetailsOfMovementProductsIncomeExpenses.Warehouse
	|		ELSE ISNULL(RevenueDetails.Warehouse, UNDEFINED) END), // Warehouse
	|	ISNULL(RevenueDetails.SetAccountingDimension, UNDEFINED),
	|	ISNULL(RevenueDetails.CounterpartyLineOfBusiness, UNDEFINED),
	|	ISNULL(RevenueDetails.ProductLineOfBusiness, UNDEFINED),
	|	ISNULL(RevenueDetails.VATTaxation, UNDEFINED),
	|	ISNULL(RevenueDetails.Contract, UNDEFINED),
	|	ISNULL(RevenueDetails.ARAPCurrency, UNDEFINED),
	|	ISNULL(RevenueDetails.DocumentCurrency, UNDEFINED),
	|	(CASE
	|		WHEN NOT InventoryConsumptionReverseTransaction.Warehouse IS NULL
	|			THEN DetailsOfMovementProductsIncomeExpenses.SourceOfProductFinancialAccountingGroup
	|		ELSE ISNULL(RevenueDetails.SourceOfProductFinancialAccountingGroup, UNDEFINED) END), // SourceOfProductFinancialAccountingGroup
	|	ISNULL(RevenueDetails.SourceOfARAPFinancialAccountingGroup, UNDEFINED),
	|	CASE WHEN Cost_.DocumentSource <> UNDEFINED
	|	  AND Cost_.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	  AND (NOT &BatchAccountingVersion22 OR Cost_.SalePeriod < &DateOfMigrationToBatchAccounting22)
	|		THEN TRUE
	|		ELSE FALSE
	|	END,
	|	CASE WHEN Cost_.DocumentSource <> UNDEFINED
	|	  AND Cost_.BusinessOperation IN (&ArrayOfOperationsRefundsForPastPeriods)
	|	  AND &BatchAccountingVersion22
	|	  AND Cost_.SalePeriod > &DateOfMigrationToBatchAccounting22
	|		THEN TRUE
	|		ELSE FALSE
	|	END,
	|	ISNULL(RevenueDetails.VATRate, UNDEFINED)
	|;";
	#EndRegion
	
#Region TTDataAdjustmentTable
	Query.Text = Query.Text + "
	|SELECT
	|	RefundTable.Period                        AS Period,
	|	RefundTable.Recorder                   AS Recorder,
	|	RefundTable.Recorder                   AS DocumentRegisterRecords,
	|	(CASE
	|		WHEN &MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|		 OR NOT &HighlightDeviationsInCostOfFinalCalculation
	|			THEN VALUE(Document.CostCalculationRecorder.EmptyRef)
	|		ELSE ISNULL(CalculationLoggers.Ref,
	|			VALUE(Document.CostCalculationRecorder.EmptyRef)) END) AS DocumentCalculation,
	|	RefundTable.RecordType                   AS RecordType,
	|	RefundTable.Organization                   AS Organization,
	|	RefundTable.CorCompany                AS CorCompany,
	|	RefundTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	RefundTable.AccountingSection                   AS AccountingSection,
	|	RefundTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	RefundTable.Lot                        AS Lot,
	|	RefundTable.LotVendorAttributes          AS LotVendorAttributes,
	|	RefundTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	RefundTable.VATActivityType            AS VATActivityType,
	|	(CASE
	|		WHEN Dimension.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|		 AND NOT Dimension.Products.TracedGoods
	|			THEN VALUE(Enum.InventoryTypes.OperationService)
	|		ELSE ISNULL(RefundTable.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods)) END) AS InventoryType,
	|	RefundTable.BusinessOperation         AS BusinessOperation,
	|	RefundTable.CorItemsLocationAttributes AS CorItemsLocationAttributes,
	|	RefundTable.CorAccountingSection                AS CorAccountingSection,
	|	RefundTable.CorInventoryOwnerAttribute                 AS CorInventoryOwnerAttribute,
	|	RefundTable.InventoryType                    AS CorInventoryType,
	|	RefundTable.AccountingDimensionByPartners     AS AccountingDimensionByPartners,
	|	RefundTable.SalesOrder                  AS SalesOrder,
	|	RefundTable.Department                 AS Department,
	|	RefundTable.ImplementationPeriod              AS ImplementationPeriod,
	|	RefundTable.DimensionOfRevenue              AS DimensionOfRevenue,
	|	RefundTable.IncomeItem                 AS IncomeItem,
	|	RefundTable.DimensionOfExpenses             AS DimensionOfExpenses,
	|	RefundTable.ExpenseItemOfWriteOff        AS ExpenseItemOfWriteOff,
	|	RefundTable.ProductsGroup               AS ProductsGroup,
	|	ISNULL(Assignments.LineOfBusiness, VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	|	RefundTable.CorLineOfBusiness    AS CorLineOfBusiness,
	|	ISNULL(ExpenseItems.CostAllocationOptionManag, UNDEFINED) AS CostAllocationOptionManag,
	|	ISNULL(ExpenseItems.CostAllocationOptionLocal, UNDEFINED) AS CostAllocationOptionLocal,
	|	ISNULL(ExpenseItems.EnteredInTaxAccounting, FALSE) AS EnteredInTaxAccounting,
	|	UNDEFINED                                   AS AssetsLiabilitiesDimension,
	|	UNDEFINED                                   AS AssetAndLiabilityItem,
	|	RefundTable.RowID           AS RowID,
	|	RefundTable.RowCode                 	   AS RowCode,
	|	RefundTable.Manager                      AS Manager,
	|	RefundTable.Warehouse                         AS Warehouse,
	|	RefundTable.Terms                    AS Terms,
	|	RefundTable.Contract                       AS Contract,
	|	RefundTable.SetAccountingDimension         AS SetAccountingDimension,
	|	RefundTable.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	|	RefundTable.ProductLineOfBusiness AS ProductLineOfBusiness,
	|	RefundTable.VATTaxation            AS VATTaxation,
	|	RefundTable.ARAPCurrency          AS ARAPCurrency,
	|	RefundTable.DocumentCurrency               AS DocumentCurrency,
	|	RefundTable.SourceOfProductFinancialAccountingGroup       AS SourceOfProductFinancialAccountingGroup,
	|	RefundTable.SourceOfARAPFinancialAccountingGroup           AS SourceOfARAPFinancialAccountingGroup,
	|	RefundTable.SalePeriod                 AS SalePeriod,
	|	RefundTable.CorLot                     AS CorLot,
	|	RefundTable.LotVendorAttributesCorr       AS LotVendorAttributesCorr,
	|	RefundTable.CorControllingAttributes  AS CorControllingAttributes,
	|	RefundTable.CorVATActivityTypes         AS CorVATActivityTypes,
	|	RefundTable.VATLocal                       AS VATLocal,
	|	RefundTable.VATManag                        AS VATManag,
	|	RefundTable.ProductCostElement             AS ProductCostElement,
	|	RefundTable.EntryType                     AS EntryType,
	|	RefundTable.DocumentSource              AS DocumentSource,
	|	RefundTable.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	RefundTable.FinRecordID        AS FinRecordID,
	|	RefundTable.CostAccountingTransaction    AS CostAccountingTransaction,
	|	RefundTable.GLAccountSettings          AS GLAccountSettings,
	|	RefundTable.CostDefiningMethod AS CostDefiningMethod,
	|	FALSE                                           AS ReversingEntry,
	|	RefundTable.VATRate                     AS VATRate,
	|	0                                              AS CorGrossInitialCostENT,
	|
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.Cost / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.Cost / CostOfSales22.Count
	|			ELSE GoodsCost.Cost
	|		END * RefundTable.Count
	|		- RefundTable.Cost AS NUMBER(31,2)) 							AS Cost,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.CostExcludingVAT / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.CostExcludingVAT / CostOfSales22.Count
	|			ELSE GoodsCost.CostExcludingVAT
	|		END * RefundTable.Count
	|		- RefundTable.CostExcludingVAT AS NUMBER(31,2)) 					AS CostExcludingVAT,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.OffBalanceCost / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.OffBalanceCost / CostOfSales22.Count
	|			ELSE GoodsCost.OffBalanceCost
	|		END * RefundTable.Count
	|		- RefundTable.OffBalanceCost AS NUMBER(31,2)) 				AS OffBalanceCost,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.AddExpensesForGoods / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN (CostOfSales22.AddExpensesForGoods + ISNULL(AmountsOfAdditionalExpenses.AddExpensesForGoods, 0)) / CostOfSales22.Count
	|			ELSE GoodsCost.AdditionalExpenseCost
	|		END * RefundTable.Count
	|		- RefundTable.AddExpensesForGoods AS NUMBER(31,2)) 						AS AddExpensesForGoods,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.AdditionalExpensesExcludingVAT / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN (CostOfSales22.AdditionalExpensesExcludingVAT + ISNULL(AmountsOfAdditionalExpenses.AdditionalExpensesExcludingVAT, 0)) / CostOfSales22.Count
	|			ELSE GoodsCost.AdditionalExpensesCostExcludingVAT
	|		END * RefundTable.Count
	|		- RefundTable.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) 					AS AdditionalExpensesExcludingVAT,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.LaborCosts / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.LaborCosts / CostOfSales22.Count
	|			ELSE GoodsCost.LaborCosts
	|		END * RefundTable.Count
	|		- RefundTable.LaborCosts AS NUMBER(31,2)) 						AS LaborCosts,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedFixedCostsIncludingVAT / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedFixedCostsIncludingVAT / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedFixedCostsIncludingVAT
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedFixedCostsIncludingVAT AS NUMBER(31,2)) 			AS ItemizedFixedCostsIncludingVAT,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedFixedCostsExcludingVAT / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedFixedCostsExcludingVAT / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedFixedCostsExcludingVAT
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedFixedCostsExcludingVAT AS NUMBER(31,2)) 		AS ItemizedFixedCostsExcludingVAT,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedVariableCostsIncludingVAT / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedVariableCostsIncludingVAT / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedVariableCostsIncludingVAT
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedVariableCostsIncludingVAT AS NUMBER(31,2)) 			AS ItemizedVariableCostsIncludingVAT,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedVariableCostsExcludingVAT / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedVariableCostsExcludingVAT / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedVariableCostsExcludingVAT
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedVariableCostsExcludingVAT AS NUMBER(31,2)) 		AS ItemizedVariableCostsExcludingVAT,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.LocalCost / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.LocalCost / CostOfSales22.Count
	|			ELSE GoodsCost.LocalCost
	|		END * RefundTable.Count
	|		- RefundTable.LocalCost AS NUMBER(31,2)) 						AS LocalCost,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.OffBalanceCostLocal / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.OffBalanceCostLocal / CostOfSales22.Count
	|			ELSE GoodsCost.OffBalanceCostLocal
	|		END * RefundTable.Count
	|		- RefundTable.OffBalanceCostLocal AS NUMBER(31,2)) 			AS OffBalanceCostLocal,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.PermanentDifference / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.PermanentDifference / CostOfSales22.Count
	|			ELSE GoodsCost.PermanentDifference
	|		END * RefundTable.Count
	|		- RefundTable.PermanentDifference AS NUMBER(31,2)) 					AS PermanentDifference,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.CostTD / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.CostTD / CostOfSales22.Count
	|			ELSE GoodsCost.CostTD
	|		END * RefundTable.Count
	|		- RefundTable.CostTD AS NUMBER(31,2)) 					AS CostTD,
	|	CAST(CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.CostOfPersonalIncomeTax / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.CostOfPersonalIncomeTax / CostOfSales22.Count
	|			ELSE GoodsCost.CostOfPersonalIncomeTax
	|		END * RefundTable.Count
	|		- RefundTable.CostOfPersonalIncomeTax AS NUMBER(31,2)) 						AS CostOfPersonalIncomeTax,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.AddExpensesLocal / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN (CostOfSales22.AddExpensesLocal + ISNULL(AmountsOfAdditionalExpenses.AddExpensesLocal, 0)) / CostOfSales22.Count
	|			ELSE GoodsCost.AddExpensesLocal
	|		END * RefundTable.Count
	|		- RefundTable.AddExpensesLocal AS NUMBER(31,2)) 					AS AddExpensesLocal,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.LaborCostsLocal / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.LaborCostsLocal / CostOfSales22.Count
	|			ELSE GoodsCost.LaborCostsLocal
	|		END * RefundTable.Count
	|		- RefundTable.LaborCostsLocal AS NUMBER(31,2)) 					AS LaborCostsLocal,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedFixedCostsCompl / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedFixedCostsCompl / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedFixedCostsCompl
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedFixedCostsCompl AS NUMBER(31,2)) 			AS ItemizedFixedCostsCompl,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedVariableCostsCompl / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedVariableCostsCompl / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedVariableCostsCompl
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedVariableCostsCompl AS NUMBER(31,2)) 			AS ItemizedVariableCostsCompl,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.CostMan / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.CostMan / CostOfSales22.Count
	|			ELSE GoodsCost.CostMan
	|		END * RefundTable.Count
	|		- RefundTable.CostMan AS NUMBER(31,2)) 						AS CostMan,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.AddExpensesMan / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN (CostOfSales22.AddExpensesMan + ISNULL(AmountsOfAdditionalExpenses.AddExpensesMan, 0)) / CostOfSales22.Count
	|			ELSE GoodsCost.AddExpensesMan
	|		END * RefundTable.Count
	|		- RefundTable.AddExpensesMan AS NUMBER(31,2)) 						AS AddExpensesMan,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.LaborCostsMan / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.LaborCostsMan / CostOfSales22.Count
	|			ELSE GoodsCost.LaborCostsMan
	|		END * RefundTable.Count
	|		- RefundTable.LaborCostsMan AS NUMBER(31,2)) 					AS LaborCostsMan,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedFixedCostsManag / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedFixedCostsManag / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedFixedCostsManag
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedFixedCostsManag AS NUMBER(31,2)) 			AS ItemizedFixedCostsManag,
	|	CAST(
	|		CASE WHEN RefundTable.AtSellingPrice AND NOT CostOfSales.Ref IS NULL
	|			THEN CostOfSales.ItemizedVariableCostsManag / CostOfSales.Count
	|		WHEN RefundTable.AtSellingPrice22 AND NOT CostOfSales22.Ref IS NULL
	|			THEN CostOfSales22.ItemizedVariableCostsManag / CostOfSales22.Count
	|			ELSE GoodsCost.ItemizedVariableCostsManag
	|		END * RefundTable.Count
	|		- RefundTable.ItemizedVariableCostsManag AS NUMBER(31,2)) 			AS ItemizedVariableCostsManag,
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan
	|
	|INTO TTDataAdjustmentTable
	|FROM
	|	TTRefundsFromPreviousPeriods AS RefundTable
	|	LEFT JOIN TTAmountsOfRealizationsOfPastPeriods AS CostOfSales
	|		ON RefundTable.AtSellingPrice
	|			AND RefundTable.DocumentSource          	= CostOfSales.Ref
	|			AND RefundTable.ProductAnalysisForPrices = CostOfSales.ItemsLocationAttributes
	|			AND (RefundTable.TypesOfStocksForPrice        	= CostOfSales.InventoryOwnerAttribute
	|				OR CostOfSales.InventoryOwnerAttribute = VALUE(Catalog.InventoryKinds.EmptyRef))
	|			AND RefundTable.Organization               	= CostOfSales.Organization
	|	LEFT JOIN TTAmountsOfRealizationsOfPastPeriods AS CostOfSales22
	|		ON RefundTable.AtSellingPrice22
	|			AND RefundTable.DocumentSource          	= CostOfSales22.Ref
	|			AND RefundTable.ProductAnalysisForPrices = CostOfSales22.ItemsLocationAttributes
	|			AND (RefundTable.TypesOfStocksForPrice        	= CostOfSales22.InventoryOwnerAttribute
	|				OR CostOfSales22.InventoryOwnerAttribute = VALUE(Catalog.InventoryKinds.EmptyRef))
	|			AND RefundTable.Organization               	= CostOfSales22.Organization
	|			AND RefundTable.Lot               		= CostOfSales22.Lot
	|			AND RefundTable.LotVendorAttributes         = CostOfSales22.LotVendorAttributes
	|			AND RefundTable.FinancialAccountingDimension    = CostOfSales22.FinancialAccountingDimension
	|			AND RefundTable.CorVATActivityTypes        = CostOfSales22.VATActivityType
	|	LEFT JOIN TTAmountsOfAdditionalExpensesOfPreviousPeriods AS AmountsOfAdditionalExpenses
	|		ON RefundTable.DocumentSource          		= AmountsOfAdditionalExpenses.Ref
	|			AND RefundTable.ProductAnalysisForPrices = AmountsOfAdditionalExpenses.ItemsLocationAttributes
	|			AND (RefundTable.TypesOfStocksForPrice        	= AmountsOfAdditionalExpenses.InventoryOwnerAttribute
	|				OR AmountsOfAdditionalExpenses.InventoryOwnerAttribute = VALUE(Catalog.InventoryKinds.EmptyRef))
	|			AND RefundTable.Organization               	= AmountsOfAdditionalExpenses.Organization
	|			AND RefundTable.Lot               		= AmountsOfAdditionalExpenses.Lot
	|			AND RefundTable.LotVendorAttributes         = AmountsOfAdditionalExpenses.LotVendorAttributes
	|			AND RefundTable.FinancialAccountingDimension    = AmountsOfAdditionalExpenses.FinancialAccountingDimension
	|			AND RefundTable.CorVATActivityTypes        = AmountsOfAdditionalExpenses.VATActivityType
	|	LEFT JOIN InformationRegister.GoodsCost AS GoodsCost
	|		ON RefundTable.ImplementationPeriod          		= GoodsCost.Period
	|			AND RefundTable.ProductAnalysisForPrices = GoodsCost.ItemsLocationAttributes
	|			AND (RefundTable.TypesOfStocksForPrice        	= GoodsCost.InventoryOwnerAttribute
	|				OR GoodsCost.InventoryOwnerAttribute = VALUE(Catalog.InventoryKinds.EmptyRef))
	|			AND RefundTable.Organization               	= GoodsCost.Organization
	|			AND RefundTable.AccountingSection               	= GoodsCost.AccountingSection
	|			AND RefundTable.Lot = UNDEFINED
	|	LEFT JOIN ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|		ON RefundTable.ExpenseItemOfWriteOff = ExpenseItems.Ref
	|
	|	INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON RefundTable.ItemsLocationAttributes = Dimension.Ref
	|
	|	LEFT JOIN Catalog.Assignments AS Assignments
	|		ON Assignments.Ref = Dimension.Purpose
	|
	|	LEFT JOIN TTCostCalculationRecorders AS CalculationLoggers
	|		ON CalculationLoggers.Organization = RefundTable.Organization
	|WHERE
	|	(RefundTable.AtSellingPrice AND CostOfSales.Ref IS NOT NULL)
	|		OR (RefundTable.AtSellingPrice22 AND CostOfSales22.Ref IS NOT NULL)
	|		OR (NOT RefundTable.AtSellingPrice AND GoodsCost.Period IS NOT NULL)
	|		OR (NOT RefundTable.AtSellingPrice22 AND GoodsCost.Period IS NOT NULL)
	|;";
#EndRegion

#Region RegisteredRecordsAdjustmentTable
	Query.Text = Query.Text + "
	|SELECT
	|	RefundTable.Period                        AS Period,
	|	RefundTable.Recorder                   AS Recorder,
	|	RefundTable.Recorder                   AS DocumentRegisterRecords,
	|	RefundTable.DocumentCalculation               AS DocumentCalculation,
	|	RefundTable.RecordType                   AS RecordType,
	|	RefundTable.Organization                   AS Organization,
	|	RefundTable.CorCompany                AS CorCompany,
	|	RefundTable.ItemsLocationAttributes    AS ItemsLocationAttributes,
	|	RefundTable.AccountingSection                   AS AccountingSection,
	|	RefundTable.InventoryOwnerAttribute                    AS InventoryOwnerAttribute,
	|	RefundTable.Lot                        AS Lot,
	|	RefundTable.LotVendorAttributes          AS LotVendorAttributes,
	|	RefundTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	RefundTable.VATActivityType            AS VATActivityType,
	|	RefundTable.InventoryType                    AS InventoryType,
	|	RefundTable.BusinessOperation         AS BusinessOperation,
	|	RefundTable.CorItemsLocationAttributes AS CorItemsLocationAttributes,
	|	RefundTable.CorAccountingSection                AS CorAccountingSection,
	|	RefundTable.CorInventoryOwnerAttribute                 AS CorInventoryOwnerAttribute,
	|	RefundTable.InventoryType                    AS CorInventoryType,
	|	RefundTable.AccountingDimensionByPartners     AS AccountingDimensionByPartners,
	|	RefundTable.SalesOrder                  AS SalesOrder,
