	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateRegisterRecordsForOtherAssetsLiabilitiesAdditionalExpensesAmountByRequest(CalculationParameters, Query, MatchingTemporaryMovementTables)
	
	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.Recorder,
	// Dimensions
	|	T.CorCompany AS Organization,
	|	T.DebitBusinessUnit AS Department,
	|	T.CorLineOfBusiness AS LineOfBusiness,
	|	T.CorArticleOfAssetsLiabilities AS AssetRef,
	|	T.CorDimensionOfAssetsLiabilities AS Dimension,
	|	T.CorSettingUpAccountingAccounts AS GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
	// Resources
	|	T.AddExpensesForGoods + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT AS AmountIncludingVAT,
	|	T.AdditionalExpensesExcludingVAT + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT AS AmountExcludingVAT,
	|	T.LocalCost + T.AddExpensesLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl AS SumCompl,
	|	T.CostMan + T.AddExpensesMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag AS SumMan,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	// Attributes
	|	T.Recorder AS DocumentRegisterRecords,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|
	|INTO TTTableOfRegisteredRecordsInOtherAssetsLiabilities
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.CorArticleOfAssetsLiabilities <> VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)
	|	AND T.CorArticleOfAssetsLiabilities REFS ChartOfCharacteristicTypes.AssetLiabilityItems
	|
	// Transfer to a branch (on the sender's side)
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.Recorder AS Recorder,
	// Dimensions
	|	T.Organization,
	|	CASE
	|		WHEN NOT T.ItemsLocationAttributes.WarehouseArea.Department IS NULL
	|		THEN T.ItemsLocationAttributes.WarehouseArea.Department
	|		ELSE T.ItemsLocationAttributes.Department
	|	END AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting) AS AssetRef,
	|	T.CorCompany AS Dimension,
	|	VALUE(Catalog.OtherTransactionsGLAccountsSettings.EmptyRef) AS GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Debit) AS DebitCredit,
	// Resources
	|	T.AddExpensesForGoods + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT AS AmountIncludingVAT,
	|	T.AdditionalExpensesExcludingVAT + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT AS AmountExcludingVAT,
	|	T.AddExpensesLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl AS SumCompl,
	|	T.AddExpensesMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag AS SumMan,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	VALUE(Catalog.BusinessTransactionsSettings.TransferOfGoodsBetweenBranchOffices) AS BusinessTransactionSetting,
	|	T.FinRecordID
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.TransferBetweenOrganizations
	|
	// Transfer to a branch (on the recipient's side)
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.Recorder AS Recorder,
	// Dimensions
	|	T.CorCompany AS Organization,
	|	CASE
	|		WHEN NOT T.ItemsLocationAttributes.WarehouseArea.Department IS NULL
	|		THEN T.ItemsLocationAttributes.WarehouseArea.Department
	|		ELSE T.ItemsLocationAttributes.Department
	|	END AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting) AS AssetRef,
	|	T.Organization AS Dimension,
	|	VALUE(Catalog.OtherTransactionsGLAccountsSettings.EmptyRef) AS GLAccountSettings,
	|	VALUE(Enum.RecordKindsOfOtherAssetsAndLiabilities.Credit) AS DebitCredit,
	// Resources
	|	T.AddExpensesForGoods + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT AS AmountIncludingVAT,
	|	T.AdditionalExpensesExcludingVAT + T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT AS AmountExcludingVAT,
	|	T.AddExpensesLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl AS SumCompl,
	|	T.AddExpensesMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag AS SumMan,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	VALUE(Catalog.BusinessTransactionsSettings.TransferOfGoodsBetweenBranchOffices) AS BusinessTransactionSetting,
	|	T.FinRecordID
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|WHERE
	|	T.TransferBetweenOrganizations
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.AccumulationRegisters.OtherAssetsAndLiabilitiesRecords.Name);
	DescriptionOfTT.NameOfSourceTT = "TTTableOfRegisteredRecordsInOtherAssetsLiabilities";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
EndProcedure

Procedure GenerateTotalCostOfGoodsAndAdditionalExpensesWithRequest(CalculationParameters, MatchingTemporaryMovementTables, ConsumableRegisteredRecords = False)
	
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	If ConsumableRegisteredRecords Then
		TempTableName = "TTCostOfGoods_AdditionalExpensesExpense";
		NameOfTemporaryTableCor = "TTInventoryCost_AdditionalExpensesCorExpense";
	Else
		TempTableName = "TTCostOfGoods_AdditionalExpensesArrival";
		NameOfTemporaryTableCor = "TTInventoryCost_AdditionalExpensesCorReceipt";
	EndIf;
	
	// The Cor. cost is not included in the list of fields.
	CopiedFields = "
	|Period, Recorder, ItemsLocationAttributes, AccountingSection, InventoryOwnerAttribute, Organization, BusinessOperation,
	|BusinessTransactionSetting, FinRecordID, Lot, LotVendorAttributes, FinancialAccountingDimension,
	|VATActivityType, EntryType, DocumentRegisterRecords,
	|LocalCost, CostMan,
	|PermanentDifference, CostTD, AddExpensesForGoods, AdditionalExpensesExcludingVAT, AddExpensesLocal, AddExpensesMan,
	|ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, ItemizedVariableCostsCompl, ItemizedVariableCostsManag,
	|ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT, ItemizedFixedCostsCompl, ItemizedFixedCostsManag,
	|CostOfPersonalIncomeTax";
	
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);

	TableOfDescriptionOfCorFields = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(TableOfDescriptionOfCorFields, CopiedFields);
	
	If ConsumableRegisteredRecords Then
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "FALSE");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Expense)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "CorCompany");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItemOfWriteOff", "CorExpenseItem");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DimensionOfExpenses", "CorExpenditureDimension");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Department", "DebitBusinessUnit");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AssetAndLiabilityItem", "CorArticleOfAssetsLiabilities");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AssetsLiabilitiesDimension", "CorDimensionOfAssetsLiabilities");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "GLAccountSettings", "CorSettingUpAccountingAccounts");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorLineOfBusiness", "CorLineOfBusiness");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AccountingDimensionByPartners", "AccountingDimensionByPartners");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SalesOrder", "SalesOrder");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"EntryType", "CASE WHEN TransferBetweenOrganizations THEN VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods) ELSE EntryType END");
		
		// Movementetovars between branches, Receipt
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "OfficialTypeOfMovementParish", "TRUE");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "Organization", "CorCompany");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "ExpenseItemOfWriteOff", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "DimensionOfExpenses", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "AssetAndLiabilityItem", "VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "AssetsLiabilitiesDimension", "Organization");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "GLAccountSettings", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "CorLineOfBusiness", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields,
			"EntryType", "VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields,
			"BusinessOperation", "VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields,
			"BusinessTransactionSetting", "VALUE(Catalog.BusinessTransactionsSettings.TransferOfGoodsBetweenBranchOffices)");
		
	Else
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", "Organization");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItemOfWriteOff", "ExpenseItem");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DimensionOfExpenses", "DimensionOfExpenses");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Department", "Department");
		// The AnalyticaCcounTiNgpartner and Customer Order in Motion Arrival fields are filled in only with the "Monthly Average" assessment method.
		// These fields are used in the Text Allocation of expenses() function of the general module for
		// calculating the cost of the Index in the request for the formation of a temporary table of vtbasdistribution of expenses of non-parties.  
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AccountingDimensionByPartners",
			"CASE WHEN Organization IN (&OrganizationsMonthlyAverage) THEN AccountingDimensionByPartners
			|	ELSE VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef) END");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "SalesOrder",
			"CASE WHEN Organization IN (&OrganizationsMonthlyAverage) THEN SalesOrder
			|	ELSE UNDEFINED END");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"EntryType", "CASE WHEN TransferBetweenOrganizations THEN VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods) ELSE EntryType END");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"BusinessOperation", "VALUE(Enum.BusinessTransactions.ExpenseAllocationToCost)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"BusinessTransactionSetting", "VALUE(Catalog.BusinessTransactionsSettings.ExpenseAllocationToCost)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
			"VariancePeriod", "CASE
			|	WHEN Organization IN (&CompaniesWithDistributionOfDeviationsInPastPeriods)
			|	 AND ReceiptPeriod < &BeginOfPeriod THEN ReceiptPeriod
			|	ELSE DATETIME(1,1,1) END");
		
		// Movementetovars between vehicles, expense
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "OfficialTypeOfMovementParish", "FALSE");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "RecordType", "VALUE(AccumulationRecordType.Expense)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "Organization", "Organization");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "CorCompany", "CorCompany");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "ExpenseItemOfWriteOff", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "DimensionOfExpenses", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "AssetAndLiabilityItem", "VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.BranchOfficeARAPAccounting)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields, "AssetsLiabilitiesDimension", "CorCompany");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields,
			"EntryType", "VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields,
			"BusinessOperation", "VALUE(Enum.BusinessTransactions.TransferOfGoodsBetweenBranchOffices)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(TableOfDescriptionOfCorFields,
			"BusinessTransactionSetting", "VALUE(Catalog.BusinessTransactionsSettings.TransferOfGoodsBetweenBranchOffices)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "VariancePeriod",
			"CASE WHEN ReceiptPeriod < &BeginOfPeriod THEN ReceiptPeriod
			|	ELSE DATETIME(1,1,1) END");
		
	EndIf;
	
	ConditionWHERE = "NOT ItemsLocationAttributes = UNDEFINED AND NOT Organization IN (&MediumSlipOrganizations)";
	
	If ConsumableRegisteredRecords Then
		// To fill in the selection fields, see In the calculation of the cost of the state expenses.Indicators of the base distribution of receivers of past periods()
		ConditionWHERE = ConditionWHERE + 
			" AND (NOT (CorExpenseItem IN (UNDEFINED, VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef))
			|		AND CorArticleOfAssetsLiabilities IN (UNDEFINED, VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))))
			|	OR (NOT AccountingDimensionByPartners IS NULL
			|		AND VALUETYPE(AccountingDimensionByPartners) = TYPE(Catalog.DimensionKeysOfAccountingByPartners)
			|		AND AccountingDimensionByPartners <> VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef))";
	EndIf;

	CorConditionWHERE = "NOT ItemsLocationAttributes = UNDEFINED AND TransferBetweenOrganizations
		// With the methods of cost estimation, the FIFO and the Average monthly VAT taxation is filled in, with the Average Sliding One, it is empty.
		|	AND VATActivityType <> VALUE(Enum.VATTaxationTypes.EmptyRef)";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE);
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, TableOfDescriptionOfCorFields, RegisterName,
		"RegisteredRecordsAdjustmentTable", NameOfTemporaryTableCor, CorConditionWHERE);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	MatchingTemporaryMovementTables.Insert(NameOfTemporaryTableCor, RegisterName);
	
EndProcedure

Procedure GenerateFollowingProductsIncomeAndExpensesQuery(CalculationParameters, MatchingTemporaryMovementTables)

	RegisterName = Metadata.AccumulationRegisters.RegisterRecordsProductsIncomeExpenses.Name;
	
	CopiedFields = "
	|Period, Recorder, ItemsLocationAttributes, InventoryOwnerAttribute, InventoryType,
	|SourceOfProductFinancialAccountingGroup, AddExpensesForGoods, AdditionalExpensesExcludingVAT, AddExpensesMan, AddExpensesLocal,
	|ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT, ItemizedFixedCostsManag, ItemizedFixedCostsCompl,
	|ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, ItemizedVariableCostsManag, ItemizedVariableCostsCompl,
	|PermanentDifference, CostTD";

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	ParametersStructure = New Structure();
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	// Fill in additional motion properties
		
	TempTableName = "TTMovementProductsIncomeExpenses";
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"Organization", "CorCompany");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Department",
	"CASE WHEN VALUETYPE(CorExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	| AND NOT CorExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	THEN DebitBusinessUnit
	|	ELSE Department END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"ProductLineOfBusiness", 
			"ISNULL(ItemsLocationAttributes.Purpose.LineOfBusiness,
			|	VALUE(Catalog.LinesOfBusiness.EmptyRef))");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"Warehouse", "ItemsLocationAttributes.StorageLocation");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "IncomeAndExpenseItem",
	"CASE WHEN VALUETYPE(CorExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	| AND NOT CorExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	THEN CorExpenseItem
	|	ELSE ExpenseItem END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DimensionOfExpenses",
	"CASE WHEN VALUETYPE(CorExpenseItem) = TYPE(ChartOfCharacteristicTypes.ExpenseItems)
	| AND NOT CorExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|	THEN CorExpenditureDimension
	|	ELSE DimensionOfExpenses END");
		
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"DocumentRegisterRecords", "Recorder");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"BusinessOperation", "VALUE(Enum.BusinessTransactions.ExpenseAllocationToCost)");
		
	ConditionWHERE =
		"BusinessOperation <> VALUE(Enum.BusinessTransactions.VATIsAccruedByTaxAgent)
		|AND BusinessOperation <> VALUE(Enum.BusinessTransactions.EmptyRef)
		|AND BusinessOperation <> UNDEFINED
		|";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE, ParametersStructure);
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

