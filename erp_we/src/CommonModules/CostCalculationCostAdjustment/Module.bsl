Procedure GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables) Export
	
	ReceiverDescription = CalculationParameters.RegisterRecords[DescriptionOfTT.Name];
	
	If DescriptionOfTT.AddIds Then
		CostCalculationAppliedAlgorithms.AddIDsToTemporaryTable(CalculationParameters, ReceiverDescription, DescriptionOfTT.NameOfSourceTT);
	EndIf;
	
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, DescriptionOfTT.NameOfSourceTT);
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		DescriptionOfTT.Name, DescriptionOfTT.NameOfSourceTT, DescriptionOfTT.TTResultName);
	
	MatchingTemporaryMovementTables.Insert(DescriptionOfTT.TTResultName, DescriptionOfTT.Name);
	
EndProcedure

