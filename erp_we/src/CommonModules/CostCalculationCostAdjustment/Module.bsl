		|	ReceiverNodes_.InventoryOwnerAttribute AS CorInventoryOwnerAttribute,
		|	ReceiverNodes_.LineOfBusiness AS CorLineOfBusiness,
		|	ReceiverNodes_.Department AS DebitBusinessUnit,
		|	ReceiverNodes_.StorageLocation AS BoxStorageLocation,
		// COR Cost Attributes
		|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS CorItemsLocationAttributes,
		|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS CorAccountingSection,
		|	UNDEFINED AS CorLot,
		|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributesCorr,
		|	UNDEFINED AS CorControllingAttributes,
		|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS CorVATActivityTypes,
		// Other fields
		|	VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef) AS AccountingDimensionByPartners,
		|	UNDEFINED AS ProductCostElement,
		|	UNDEFINED AS RuleOfCostAllocatingToProductionLots,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItemOfWriteOff,
		|	UNDEFINED AS DimensionOfExpenses,
		|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS CorExpenseItem,
		|	UNDEFINED AS CorExpenditureDimension,
		|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AssetAndLiabilityItem,
		|	UNDEFINED AS AssetsLiabilitiesDimension,
		|	UNDEFINED AS GLAccountSettings,
		|	VALUE(Enum.BusinessTransactions.TransferOfVariancesInGoodsCost) AS BusinessOperation,
		|	VALUE(Catalog.BusinessTransactionsSettings.EmptyRef) AS BusinessTransactionSetting,
		|	&IDOfUnusedFinRecord AS FinRecordID,
		|	T.PeriodOfDistributionReceiver AS DistributionPeriod,
		|	SourceNodes.VariancePeriod AS DeviationPeriodSource,
		|	ReceiverNodes_.VariancePeriod AS ReceiverDeviationPeriod,
		|	FALSE AS ReversingEntry,
		|	FALSE AS WriteOffDeviationsToCostOfGoodsSelling,
		// Resources
		|	T.Count AS Count,
		|	CAST(T.Count * SourceNodes.CostVariancesIncludingVAT AS NUMBER(31,2)) AS CostVariancesIncludingVAT,
		|	CAST(T.Count * SourceNodes.CostVariancesExcludingVAT AS NUMBER(31,2)) AS CostVariancesExcludingVAT,
		|	CAST(T.Count * SourceNodes.CostVariancesLocal AS NUMBER(31,2)) AS CostVariancesLocal,
		|	CAST(T.Count * SourceNodes.CostVariancesMgmt AS NUMBER(31,2)) AS CostVariancesMgmt,
		|	CAST(T.Count * SourceNodes.VATLocal AS NUMBER(31,2)) AS VATLocal,
		|	CAST(T.Count * SourceNodes.VATManag AS NUMBER(31,2)) AS VATManag,
		|	CAST(T.Count * SourceNodes.AdditionalExpensesIncludingVAT AS NUMBER(31,2)) AS AdditionalExpensesIncludingVAT,
		|	CAST(T.Count * SourceNodes.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
		|	CAST(T.Count * SourceNodes.AddExpensesLocal AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.Count * SourceNodes.AddExpensesMan AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.Count * SourceNodes.PermanentDifference AS NUMBER(31,2)) AS PermanentDifference,
		|	CAST(T.Count * SourceNodes.CostTD AS NUMBER(31,2)) AS CostTD,
		|	CAST(T.Count * SourceNodes.AIT AS NUMBER(31,2)) AS AIT
		|
		|FROM
		|	DeviationTTCommunication AS T
		|	INNER JOIN TableOfSolutionsInDetail AS SourceNodes
		|		ON SourceNodes.NodeNumber = T.SourceNodeNumber
		|	INNER JOIN TableOfSolutionsInDetail AS ReceiverNodes_
		|		ON ReceiverNodes_.NodeNumber = T.ReceiverNodeNumber
		|WHERE
		|	T.TheseAreLeftovers
		|	AND SourceNodes.ThereIsCost
		|";
EndFunction
