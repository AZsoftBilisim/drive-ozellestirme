	|			THEN AdjustmentTable.Products
	|		ELSE AdjustmentTable.ManRevenueAnalytics END) AS ManRevenueAnalytics,
	|	AdjustmentTable.AssetAndLiabilityItem         AS AssetAndLiabilityItem,
	|	AdjustmentTable.AssetsLiabilitiesDimension      AS AssetsLiabilitiesDimension,
	|	AdjustmentTable.RowID           AS RowID,
	|	AdjustmentTable.RowCode                     AS RowCode,
	|	AdjustmentTable.SalePeriod                 AS SalePeriod,
	|	AdjustmentTable.ProductsGroup               AS ProductsGroup,
	|	AdjustmentTable.StornoReportOnCommission		   AS StornoReportOnCommission,
	|	AdjustmentTable.Lot                        AS Lot,
	|	AdjustmentTable.LotVendorAttributes          AS LotVendorAttributes,
	|	AdjustmentTable.FinancialAccountingDimension     AS FinancialAccountingDimension,
	|	AdjustmentTable.VATActivityType            AS VATActivityType,
	|	AdjustmentTable.CorLot                 	   AS CorLot,
	|	AdjustmentTable.LotVendorAttributesCorr       AS LotVendorAttributesCorr,
	|	AdjustmentTable.CorControllingAttributes  AS CorControllingAttributes,
	|	AdjustmentTable.CorVATActivityTypes         AS CorVATActivityTypes,
	|	AdjustmentTable.ProductCostElement             AS ProductCostElement,
	|	(CASE
	|		WHEN AdjustmentTable.EntryType = VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|			THEN VALUE(Enum.LotRecordTypes.CostVarianceForOtherIncome)
	|		ELSE AdjustmentTable.EntryType END)    AS EntryType,
	|	AdjustmentTable.DocumentSource              AS DocumentSource,
	|	(CASE
	|		WHEN AdjustmentTable.EntryType = VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|			THEN FALSE
	|		ELSE AdjustmentTable.ReversingEntry END)       AS ReversingEntry,
	|	VALUE(Catalog.BusinessTransactionsSettings.GoodsValueVarianceIncome) AS BusinessTransactionSetting,
	// Deviations in the cost are reflected by the ID of the document line.
	|	(CASE
	|		WHEN AdjustmentTable.RowID <> """"
	|			THEN AdjustmentTable.RowID
	|		ELSE AdjustmentTable.FinRecordID END) AS FinRecordID,
	|	AdjustmentTable.GLAccountSettings          AS GLAccountSettings,
	|	AdjustmentTable.CostAccountingTransaction    AS CostAccountingTransaction,
	|	AdjustmentTable.CostDefiningMethod AS CostDefiningMethod,
	|	AdjustmentTable.RestoreReserves        AS RestoreReserves,
	|	AdjustmentTable.ParishEconomicOperation   AS ParishEconomicOperation,
	|	AdjustmentTable.ParishRecordType               AS ParishRecordType,
	|	AdjustmentTable.ArrivalSettingUpBusinessOperation AS ArrivalSettingUpBusinessOperation,
	|	AdjustmentTable.ArrivalOfCorAnalyticsAccountingProducts  AS ArrivalOfCorAnalyticsAccountingProducts,
	|	
	|	AdjustmentTable.DocumentSubdivision AS DocumentSubdivision,
	|	AdjustmentTable.SourceOfProductFinancialAccountingGroup AS SourceOfProductFinancialAccountingGroup,
	|	AdjustmentTable.CorSourceOfItemsFinancialAccountingGroup AS CorSourceOfItemsFinancialAccountingGroup,
	|	AdjustmentTable.ThisIsTransferBetweenOrganizations AS ThisIsTransferBetweenOrganizations,
	|	AdjustmentTable.CorCompanyOnMediumSlip AS CorCompanyOnMediumSlip,
	|	AdjustmentTable.CorGrossInitialCostENT                  AS CorGrossInitialCostENT,
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			THEN Cost
	|		ELSE 0 END) AS Cost,
	|	(CASE 
	|		WHEN SignIsReversed * OffBalanceCost < 0
	|			THEN OffBalanceCost
	|		ELSE 0 END) AS OffBalanceCost,
	|	(CASE 
	|		WHEN SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) < 0
	|			THEN CostExcludingVAT
	|		ELSE 0 END) AS CostExcludingVAT,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	(CASE 
	|		WHEN SignIsReversed * CostOfPersonalIncomeTax < 0
	|			THEN CostOfPersonalIncomeTax
	|		ELSE 0 END) AS CostOfPersonalIncomeTax,
	|
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			THEN AddExpensesForGoods
	|		ELSE 0 END) AS AddExpensesForGoods,
	|	(CASE 
	|		WHEN SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) < 0
	|			THEN AdditionalExpensesExcludingVAT
	|		ELSE 0 END) AS AdditionalExpensesExcludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			THEN LaborCosts
	|		ELSE 0 END) AS LaborCosts,
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			THEN ItemizedFixedCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsIncludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) < 0
	|			THEN ItemizedFixedCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedFixedCostsExcludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			THEN ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsIncludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) < 0
	|			THEN ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS ItemizedVariableCostsExcludingVAT,
	|
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN AddExpensesLocal
	|		ELSE 0 END) AS AddExpensesLocal,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN LaborCostsLocal
	|		ELSE 0 END) AS LaborCostsLocal,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN ItemizedFixedCostsCompl
	|		ELSE 0 END) AS ItemizedFixedCostsCompl,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN ItemizedVariableCostsCompl
	|		ELSE 0 END) AS ItemizedVariableCostsCompl,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN LocalCost
	|		ELSE 0 END) AS LocalCost,
	|	(CASE 
	|		WHEN SignIsReversed * OffBalanceCostLocal < 0
	|			THEN OffBalanceCostLocal
	|		ELSE 0 END) AS OffBalanceCostLocal,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN ProvisionForImpairmentLocal
	|		ELSE 0 END) AS ProvisionForImpairmentLocal,
	|
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN CostMan
	|		ELSE 0 END) AS CostMan,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN LaborCostsMan
	|		ELSE 0 END) AS LaborCostsMan,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN ItemizedFixedCostsManag
	|		ELSE 0 END) AS ItemizedFixedCostsManag,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN ItemizedVariableCostsManag
	|		ELSE 0 END) AS ItemizedVariableCostsManag,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN ProvisionForImpairmentMan
	|		ELSE 0 END) AS ProvisionForImpairmentMan,
	|
	|	0 AS VATLocal,
	|	0 AS VATManag,
	|	AdjustmentTable.InitialCost_ AS InitialCost_,
	|	AdjustmentTable.InitialValueWithoutVAT AS InitialValueWithoutVAT,
	|	AdjustmentTable.InitialLocalCost AS InitialLocalCost,
	|	AdjustmentTable.InitialCostOfMan AS InitialCostOfMan,
	|	AdjustmentTable.Count AS Count,
	|
	|	AdjustmentTable.ThisIsOutput AS ThisIsOutput,
	|	AdjustmentTable.ThisIsReturnBetweenOrganizations AS ThisIsReturnBetweenOrganizations,
	|	AdjustmentTable.WriteOffReserves,
	|	AdjustmentTable.CalculationIsNotCompleted,
	|	
	|	(AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|	+ AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT)
	|	- AdjustmentTable.CorGrossInitialCostENT AS FullAmountOfRevaluation,
	|
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			THEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS AmountIncludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) < 0
	|			THEN CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			THEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl
	|		ELSE 0 END) AS SumCompl,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			THEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag
	|		ELSE 0 END) AS SumMan,
	|	0 AS AITAmount,
	|	AdjustmentTable.Character AS Character
	|FROM
	|	TTDataAdjustmentTable AS AdjustmentTable
	|WHERE
	|	(AdjustmentTable.BusinessOperation IN (&BusinessTransactionsAdjustmentTables)
	|	 AND AdjustmentTable.AccountingSection IN (&BalanceSectionsOfAccounting)
	|		OR AdjustmentTable.BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsLotsMisgrading)
	|		OR AdjustmentTable.EntryType = VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|			AND AdjustmentTable.BusinessOperation <> VALUE(Enum.BusinessTransactions.PostingOfReleaseTargetCost)
	|		OR AdjustmentTable.CostAccountingTransaction = VALUE(Enum.CostAccountingTransactions.DisposalAtFixedCost)
	|	 		AND (AdjustmentTable.AccountingSection IN (&BalanceSectionsOfAccounting)
	|				OR AdjustmentTable.InventoryType = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider))
	|	)
	// Negative amounts of deviations in value or positive amounts of deviations for reverse movements will be attributed to other income.
	|	AND (CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) < 0
	|			OR SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) < 0
	|			OR SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) < 0
	|			OR SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) < 0
	|			OR SignIsReversed * OffBalanceCost < 0
	|			OR SignIsReversed * OffBalanceCostLocal < 0
	|			OR SignIsReversed * CostOfPersonalIncomeTax < 0
	|				THEN TRUE
	|		ELSE FALSE END)
	|";
	#EndRegion
	
	#Region RegisteredRecordsTableAdjustments_OtherExpenses
	
