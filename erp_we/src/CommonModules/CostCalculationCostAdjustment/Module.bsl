#Region Allocation_Cost

// Service, stage 2.1, 2.2, 3.1, 3.18
Procedure DistributeCost(RecordingDistribution, RemainderLine, Selection, Val QuantityToDistribution) Export
	
	BalanceAmounts 	= GetSummaryDistributionMetrics(RemainderLine);
	AmountsToBeDebited 	= GetSummaryDistributionMetrics();
	
	If QuantityToDistribution >= RemainderLine.Count Then
		
		FillPropertyValues(AmountsToBeDebited, BalanceAmounts);
		
		QuantityToDistribution = QuantityToDistribution - RemainderLine.Count;
		QuantityToWriteOff	     = RemainderLine.Count;
		

	ElsIf QuantityToDistribution < RemainderLine.Count Then
		
		For Each KeyAndValue In BalanceAmounts Do
			
			AmountsToBeDebited[KeyAndValue.Key] =
				Round((QuantityToDistribution * BalanceAmounts[KeyAndValue.Key] / RemainderLine.Count), 2);
				
			BalanceAmounts[KeyAndValue.Key] = BalanceAmounts[KeyAndValue.Key] - AmountsToBeDebited[KeyAndValue.Key];
				
		EndDo;
		
		QuantityToWriteOff		 = QuantityToDistribution;
		QuantityToDistribution = 0;
		RemainderLine.Count = RemainderLine.Count - QuantityToWriteOff;
		
	EndIf;
	
	FillPropertyValues(RecordingDistribution, Selection);
	
	If Selection.InitialQuantity_ < 0 Then
		
		For Each KeyAndValue In AmountsToBeDebited Do
			
			AmountsToBeDebited[KeyAndValue.Key] = -AmountsToBeDebited[KeyAndValue.Key];
				
		EndDo;
		
		RecordingDistribution.Count = -QuantityToWriteOff;
		
	Else
		
		SampleAmounts = GetSummaryDistributionMetrics(Selection);
		
		For Each KeyAndValue In AmountsToBeDebited Do
			
			AmountsToBeDebited[KeyAndValue.Key] = AmountsToBeDebited[KeyAndValue.Key] - SampleAmounts[KeyAndValue.Key];
				
		EndDo;
		
		RecordingDistribution.Count = QuantityToWriteOff;
		
	EndIf;
	
	FillPropertyValues(RecordingDistribution, AmountsToBeDebited);
	FillPropertyValues(RemainderLine, BalanceAmounts);
	
EndProcedure

// Service, stage 2.1, 3.1
Procedure SupplementDistributionAmounts(RecordingDistribution, DistributionAmounts) Export
	
	RecordAmounts 	= GetSummaryDistributionMetrics(RecordingDistribution);
	SupplementAmounts = GetSummaryDistributionMetrics(DistributionAmounts);
	
	For Each KeyAndValue In RecordAmounts Do
		If RecordAmounts[KeyAndValue.Key] <> Undefined Then
			RecordAmounts[KeyAndValue.Key] =
				RecordAmounts[KeyAndValue.Key] + SupplementAmounts[KeyAndValue.Key];
		EndIf;
	EndDo;
	
	FillPropertyValues(RecordingDistribution, RecordAmounts);
	
EndProcedure

Function GetSummaryDistributionMetrics(FillingData = Undefined)
	
	SumData = New Structure;
	SumData.Insert("Cost", 			  	0);
	SumData.Insert("CostExcludingVAT", 		  	0);
	SumData.Insert("OffBalanceCost", 	0);
	SumData.Insert("AddExpensesForGoods", 	  		  	0);
	SumData.Insert("AdditionalExpensesExcludingVAT", 	  	0);
	SumData.Insert("LocalCost", 		  	0);
	SumData.Insert("AddExpensesLocal", 		  	0);
	SumData.Insert("OffBalanceCostLocal",0);
	SumData.Insert("VATLocal", 			    	0);
	SumData.Insert("PermanentDifference", 		0);
	SumData.Insert("CostTD", 		0);
	SumData.Insert("CostOfPersonalIncomeTax", 			0);
	SumData.Insert("CostMan", 		  	0);
	SumData.Insert("AddExpensesMan",  		  	0);
	SumData.Insert("VATManag",	 			    0);
	SumData.Insert("ItemizedFixedCostsCompl",0);
	SumData.Insert("ItemizedVariableCostsCompl",0);
	SumData.Insert("ItemizedFixedCostsManag", 0);
	SumData.Insert("ItemizedVariableCostsManag",	0);
	
	If FillingData <> Undefined Then
		FillPropertyValues(SumData, FillingData);
	EndIf;
	
	Return SumData;
	
EndFunction

