	|	VALUE(Catalog.KeysOfSetAccountingDimension.EmptyRef) AS SetAccountingDimension,
	|	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CounterpartyLineOfBusiness,
	|	T.ItemsLocationAttributes.Purpose.LineOfBusiness AS ProductLineOfBusiness,
	// Resources
	|	0 AS Count,
	|	0 AS RevenueAmount,
	|	0 AS RevenueAmountExcludingVAT,
	|	0 AS Cost,
	|	0 AS CostExcludingVAT,
	|	0 AS AddExpensesForGoods,
	|	0 AS AdditionalExpensesExcludingVAT,
	|	0 AS CostMan,
	|	0 AS LocalCost,
	|	0 AS OffBalanceCost,
	|	0 AS OffBalanceCostLocal,
	|	0 AS RevenueAmountExclVATLocal,
	|	0 AS PermanentDifference,
	|	0 AS AddExpensesMan,
	|	0 AS AddExpensesLocal,
	|	0 AS ItemizedFixedCostsIncludingVAT,
	|	0 AS ItemizedFixedCostsExcludingVAT,
	|	0 AS ItemizedFixedCostsManag,
	|	0 AS ItemizedFixedCostsCompl,
	|	0 AS LaborCosts,
	|	0 AS LaborCostsMan,
	|	0 AS LaborCostsLocal,
	|	0 AS ItemizedVariableCostsIncludingVAT,
	|	0 AS ItemizedVariableCostsExcludingVAT,
	|	0 AS ItemizedVariableCostsManag,
	|	0 AS ItemizedVariableCostsCompl,
	|	0 AS CostTD,
	|	0 AS RevenueAmountIncludingVATLocal,
	|	0 AS ManualDiscount,
	|	0 AS DiscountMarkupAmount,
	|	0 AS SellingExpensesIncludingVAT,
	|	0 AS SellingExpensesExcludingVAT,
	|	0 AS SellingExpensesMan,
	|	0 AS SellingExpensesLocal,
	|	T.ProvisionForImpairmentMan AS ProvisionForImpairmentMan,
	|	T.ProvisionForImpairmentLocal AS ProvisionForImpairmentLocal,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATTaxation,  //Taxationsends,
	|	VALUE(Catalog.Currencies.EmptyRef) AS ARAPCurrency,
	|	VALUE(Catalog.Currencies.EmptyRef) AS DocumentCurrency,
	|	UNDEFINED AS SourceOfProductFinancialAccountingGroup,
	|	VALUE(Catalog.ARAPObjects.EmptyRef) AS SourceOfARAPFinancialAccountingGroup,
	|	VALUE(Catalog.BusinessTransactionsSettings.ReverseProvisionsForImpairmentOfInventory) AS BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.ReversingEntry
	|
	|INTO TTTableOfRegisteredRecordedRevenueAndCostReservesAndDeviations
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionPartner_
	|	ON (DimensionPartner_.Partner = VALUE(Catalog.Partners.EmptyRef))
	|		AND (DimensionPartner_.Organization = T.Organization)
	|		AND (DimensionPartner_.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	|		AND (DimensionPartner_.Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
	|		AND (DimensionPartner_.LineOfBusiness = T.LineOfBusiness)
	|WHERE
	|	T.RestoreReserves
	|	AND (T.ProvisionForImpairmentMan <> 0 OR T.ProvisionForImpairmentLocal <> 0)
	|	AND VALUETYPE(T.DocumentRegisterRecords) IN (&TypesOfRevenueRecorders)
	|
	|UNION ALL
	|
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.ItemsLocationAttributes,
	|	T.SalesOrder,
	|	DimensionPartner_.DimensionKey AS AccountingDimensionByPartners,
	|	T.Department,
	|	(CASE
	|		WHEN T.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|		 AND NOT T.ItemsLocationAttributes.Products.TracedGoods
	|			THEN VALUE(Enum.InventoryTypes.OperationService)
	|		ELSE T.InventoryType END) AS InventoryType,
	|	T.InventoryOwnerAttribute,
	|	T.AccountingSection,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType,
	|	VALUE(Catalog.Users.EmptyRef) AS Manager,
	|	T.Warehouse,
	|	VALUE(Catalog.TermsOfSale.EmptyRef) AS Terms,
	|	UNDEFINED AS Contract,
	|	T.BusinessOperation AS BusinessOperation,
	|	VALUE(Catalog.KeysOfSetAccountingDimension.EmptyRef) AS SetAccountingDimension,
	|	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CounterpartyLineOfBusiness,
	|	T.ItemsLocationAttributes.Purpose.LineOfBusiness AS ProductLineOfBusiness,
	// Resources
	|	0 AS Count,
	|	0 AS RevenueAmount,
	|	0 AS RevenueAmountExcludingVAT,
	|	0 AS Cost,
	|	0 AS CostExcludingVAT,
	|	0 AS AddExpensesForGoods,
	|	0 AS AdditionalExpensesExcludingVAT,
	|	0 AS CostMan,
	|	0 AS LocalCost,
	|	0 AS OffBalanceCost,
	|	0 AS OffBalanceCostLocal,
	|	0 AS RevenueAmountExclVATLocal,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.SumMan AS AddExpensesMan,
	|	T.SumCompl AS AddExpensesLocal,
	|	0 AS ItemizedFixedCostsIncludingVAT,
	|	0 AS ItemizedFixedCostsExcludingVAT,
	|	0 AS ItemizedFixedCostsManag,
	|	0 AS ItemizedFixedCostsCompl,
	|	0 AS LaborCosts,
	|	0 AS LaborCostsMan,
	|	0 AS LaborCostsLocal,
	|	0 AS ItemizedVariableCostsIncludingVAT,
	|	0 AS ItemizedVariableCostsExcludingVAT,
	|	0 AS ItemizedVariableCostsManag,
	|	0 AS ItemizedVariableCostsCompl,
	|	T.SumCompl - T.PermanentDifference AS CostTD,
	|	0 AS RevenueAmountIncludingVATLocal,
	|	0 AS ManualDiscount,
	|	0 AS DiscountMarkupAmount,
	|	0 AS SellingExpensesIncludingVAT,
	|	0 AS SellingExpensesExcludingVAT,
	|	0 AS SellingExpensesMan,
	|	0 AS SellingExpensesLocal,
	|	0 AS ProvisionForImpairmentMan,
	|	0 AS ProvisionForImpairmentLocal,
	// Attributes
	|	T.DocumentRegisterRecords,
	|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATTaxation,  //Taxationsends,
	|	VALUE(Catalog.Currencies.EmptyRef) AS ARAPCurrency,
	|	VALUE(Catalog.Currencies.EmptyRef) AS DocumentCurrency,
	|	UNDEFINED AS SourceOfProductFinancialAccountingGroup,
	|	VALUE(Catalog.ARAPObjects.EmptyRef) AS SourceOfARAPFinancialAccountingGroup,
	|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	T.FinRecordID,
	|	T.ReversingEntry
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionPartner_
	|	ON (DimensionPartner_.Partner = VALUE(Catalog.Partners.EmptyRef))
	|		AND (DimensionPartner_.Organization = T.Organization)
	|		AND (DimensionPartner_.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	|		AND (DimensionPartner_.Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
	|		AND (DimensionPartner_.LineOfBusiness = T.LineOfBusiness)
	// The conditions for data sampling must correspond to the procedure for creating an Analyst key for partners().
	|WHERE
	|	T.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
	|	AND (T.SumCompl<> 0 OR T.ProvisionForImpairmentLocal <> 0 OR T.SumMan <> 0 OR T.ProvisionForImpairmentMan <> 0)
	|";
	
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTTableOfRegisteredRecordedRevenueAndCostReservesAndDeviations");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTTableOfRegisteredRecordedRevenueAndCostReservesAndDeviations", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure CreateAnalyticsKeysForPartners(CalculationParameters, Query)
	
	Query.Text = "
	|SELECT DISTINCT
	|	T.Organization AS Organization,
	|	T.LineOfBusiness AS LineOfBusiness
	|
	|INTO TTAnalytics
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	// The conditions for data sampling must correspond to the procedure for creating a handshake and the cost of selling a request().
	|WHERE
	|	T.BusinessOperation = VALUE(Enum.BusinessTransactions.WriteOffOfVariancesToCostOfGoodsSold)
	|	AND (T.SumCompl<> 0 OR T.ProvisionForImpairmentLocal <> 0 OR T.SumMan <> 0 OR T.ProvisionForImpairmentMan <> 0)
	|
	|INDEX BY
	|	Organization,
	|	LineOfBusiness
	|;
	|SELECT
	|	T.Organization AS Organization,
	|	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	|	VALUE(Catalog.Counterparties.EmptyRef) AS Counterparty,
	|	VALUE(Catalog.CounterpartyContracts.EmptyRef) AS Contract,
	|	T.LineOfBusiness AS LineOfBusiness
	|FROM
	|	TTAnalytics AS T
	|		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS DimensionPartner_
	|		ON (DimensionPartner_.Partner = VALUE(Catalog.Partners.EmptyRef))
	|		AND (DimensionPartner_.Organization = T.Organization)
	|		AND (DimensionPartner_.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	|		AND (DimensionPartner_.Contract = VALUE(Catalog.CounterpartyContracts.EmptyRef))
	|		AND (DimensionPartner_.LineOfBusiness = T.LineOfBusiness)
	|WHERE
	|	DimensionPartner_.DimensionKey IS NULL
	|";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	While Selection.Next() Do
		InformationRegisters.AccountingDimensionByPartners.CreateAnalyticsKey(Selection);
	EndDo;
	
EndProcedure

Procedure GenerateTotalCostOfInventoryItemInOperationByRequest(CalculationParameters, Query, TempTableName, MatchingTemporaryMovementTables)
	
	Query.Text = "
	|SELECT
	|	T.Period,
	|	T.DocumentRegisterRecords AS Recorder,
	// Dimensions
	|	T.Organization,
	|	TransfersToOperation.Products AS Products,
	|	TransfersToOperation.Characteristic AS Characteristic,
	|	CASE
	|		WHEN TransfersToOperation.BatchesIndicationStatusRecipient = 20
	|			THEN TransfersToOperation.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	TransfersToOperation.AssetID,
	|	TransfersToOperation.Lot,
	|	T.RowID,
	// Resources
	|	T.Count AS Count,
	|	T.SumMan AS CostMan,
	|	T.SumCompl AS LocalCost
	// Attributes
	|	
	|INTO TTTableCostOfTMTSVOperation
	|FROM
	|	RegisteredRecordsAdjustmentTable AS T
	|	INNER JOIN Document.InventoryConsumption.Goods AS TransfersToOperation
	|		ON T.DocumentRegisterRecords = TransfersToOperation.Ref
	|		AND T.RowID = TransfersToOperation.RowID
	|WHERE
	|	CAST(T.DocumentRegisterRecords AS Document.InventoryConsumption).BusinessOperation IN(
	|		VALUE(Enum.BusinessTransactions.TransferToOperation),
	|		VALUE(Enum.BusinessTransactions.CommissioningACAndTA))
	|";
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	DescriptionOfTT = DescriptionOfFormationOfTemporaryTable(Metadata.InformationRegisters.CostOfInventoryInOperation.Name);
	DescriptionOfTT.TTResultName = TempTableName;
	DescriptionOfTT.NameOfSourceTT = "TTTableCostOfTMTSVOperation";
	
	GenerateTTBasedOnSource(DescriptionOfTT, CalculationParameters, MatchingTemporaryMovementTables);
	
EndProcedure

// Stage 3.15
Procedure AdjustCostOfWritingOffWorkInProgress22(CalculationParameters)
	
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "AdjustCostOfWritingOffWorkInProgress");
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	#Region Releases
	Query.Text = CostCalculationLESSolution.TextTTIssues() + Common.QueryBatchSeparator();
	#EndRegion
	
	#Region TTAdjustmentTable
	Query.Text = Query.Text + "
	|SELECT
	|			RegisterRecords.Period
	|	AS Period,
	|	RegisterRecords.RecordType AS RecordType,
	|	RegisterRecords.Recorder AS DocumentRegisterRecords,
	|	RegisterRecords.Organization AS Organization,
	|	RegisterRecords.ProductionLot AS ProductionLot,
	// for parishes, the cost is formed without taking into account batches, batch accounting analysts, product groups, calculation articles, attribution rules,
	// and for expenses - in the context of these fields
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN VALUE(Catalog.ProductionLots.EmptyRef)
	|		ELSE 
	|			RegisterRecords.DocumentOfProductionIssue
	|	END AS Lot,
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN UNDEFINED
	|		ELSE 
	|			RegisterRecords.ReleaseLotDimension
	|	END AS LotVendorAttributes,
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN VALUE(Catalog.ProductCostElements.EmptyRef)
	|		ELSE 
	|			RegisterRecords.ProductCostElement
	|	END AS ArticleOfCostCalculation,
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
	|		ELSE 
	|			RegisterRecords.ProductsGroup
	|	END AS CostProductionGroup,
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN VALUE(Enum.RulesOfCostAllocationToProductCost.EmptyRef)
	|		ELSE 
	|			RegisterRecords.RuleOfCostAllocatingToProductionLots
	|	END AS RuleOfAttributionToIssueOfValue,
	|	RegisterRecords.ProductionOrder AS ProductionOrder,
	|	RegisterRecords.RowCodeProducts AS RowCodeProducts,
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN 0
	|		ELSE
	|			RegisterRecords.RowCodeProducts
	|	END AS LineCodeOutputForValue,
	|	RegisterRecords.Stage AS Stage,
	|	RegisterRecords.ProductCostElement AS ProductCostElement,
	|	(CASE
	|		WHEN &KeepRecordsOfInventoryCostByAssignments THEN RegisterRecords.ProductsAccountingDimension
	|		ELSE AnalyticsOfProductsWithoutDestination.DimensionKey END) AS ProductsAccountingDimension,
	|	RegisterRecords.LotVendorAttributesCorr AS LotVendorAttributesCorr,
	|	RegisterRecords.AccountingSection AS AccountingSection,
	|	RegisterRecords.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	RegisterRecords.ProductsAccountingDimension.Purpose AS Purpose,
	|	RegisterRecords.Department AS Department,
	// for parishes, the original expense division is selected, and for expenses, the division to which the expense is attributed
	|	CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN Allocation.Department
	|		ELSE RegisterRecords.Department
	|	END AS DivisionOfValue,
	|	RegisterRecords.CorLineOfBusiness AS LineOfBusiness,
	|	RegisterRecords.LineOfBusiness AS CorLineOfBusiness,
	|	RegisterRecords.DimensionOfExpenses AS DimensionOfExpenses,
	|	RegisterRecords.ExpenseItem AS ExpenseItem,
	|	CASE 
	|		WHEN Allocation.ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|			THEN TTOvz.CostAllocationOptionLocal
	|		ELSE RegisterRecords.ExpenseItem.CostAllocationOptionLocal
	|	END IN (
	|		VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|		VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|	) AS DirectCostsLocal,
	|	CASE 
	|		WHEN Allocation.ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
	|			THEN TTOvz.CostAllocationOptionTax
	|		ELSE RegisterRecords.ExpenseItem.CostAllocationOptionTax
	|	END IN (
	|		VALUE(Enum.CostAllocationOptions.ToProductionCosts), 
	|		VALUE(Enum.CostAllocationOptions.ToProductionCostDirect)
	|	) AS DirectCostsTA,
	|	RegisterRecords.ExpenseItem.EnteredInTaxAccounting AS AcceptedVNU,
	|	RegisterRecords.ManufacturedProduct AS ManufacturedProduct,
	|	RegisterRecords.ItemVariant AS ItemVariant,
	|	RegisterRecords.ProductsGroup AS ProductsGroup,
	|	RegisterRecords.VATActivityType,
	|	CASE 
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
	|		ELSE VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)
	|	END AS CostAccountingSection,
	|	RegisterRecords.DocumentOfProductionIssue AS DocumentOfProductionIssue,
	|	RegisterRecords.ReleaseLotDimension AS ReleaseLotDimension,
	|	RegisterRecords.RuleOfCostAllocatingToProductionLots AS RuleOfCostAllocatingToProductionLots,
	// For parishes, the quantity is an indicator of the party's membership, and for expenses, it is an indicator of the issue's membership
	|	RegisterRecords.CostShare AS CostShare,
	|	CAST(CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN RegisterRecords.IndicatorOfAllocationToLot
	|		ELSE RegisterRecords.IndicatorOfAllocationToIssue
	|	END AS NUMBER(28,10)) AS Count,
	|	CAST(CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN RegisterRecords.IndicatorOfAllocationToLotExcludingVAT
	|		ELSE RegisterRecords.IndicatorOfAttributionToOutputWithoutVAT
	|	END AS NUMBER(28,10)) AS QuantityWithoutVAT,
	|	CAST(CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN RegisterRecords.IndicatorOfAllocationToLotCompl
	|		ELSE RegisterRecords.LocalIssueAttributionRate
	|	END AS NUMBER(28,10)) AS NumberOfLocal,
	|	CAST(CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN RegisterRecords.RateOfAssignmentToBatchIsTA
	|		ELSE RegisterRecords.IndicatorOfAttributionToIssueIsTA
	|	END AS NUMBER(28,10)) AS NumberOfTA,
	|	CAST(CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN RegisterRecords.IndicatorOfAllocationToLotManag
	|		ELSE RegisterRecords.IndicatorOfAssignmentToIssueOfMan
	|	END AS NUMBER(28,10)) AS NumberOfMen,
	|	CAST(CASE
	|		WHEN RegisterRecords.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN RegisterRecords.IndicatorOfAttributionToPartyNDD
	|		ELSE RegisterRecords.IndicatorOfAttributionToIssueOfPersonalIncomeTax
	|	END AS NUMBER(28,10)) AS NumberOfPersonalData
	|INTO TTAdjustmentTableWithoutIDs_Preliminary
	|FROM
	|	TTOtherWorkInProgressExpenses__ AS RegisterRecords
	|	LEFT JOIN Document.AllocationOfOtherCosts AS Allocation
	|		ON RegisterRecords.Recorder = Allocation.Ref
	|	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|		ON Dimension.Ref = RegisterRecords.ProductsAccountingDimension
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsOfProductsWithoutDestination
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsOfProductsWithoutDestination.Products = Dimension.Products
	|		AND AnalyticsOfProductsWithoutDestination.Characteristic = Dimension.Characteristic
	|		AND AnalyticsOfProductsWithoutDestination.Series = Dimension.Series
	|		AND AnalyticsOfProductsWithoutDestination.StorageLocation = Dimension.StorageLocation
	|		AND AnalyticsOfProductsWithoutDestination.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsOfProductsWithoutDestination.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|
