Function TextToAdjustCostOfPastPeriods(CalculationParameters)
	
	TextsOfTTDisposalsForDeviations = New Array;
	TextsOfTTDisposalsForDeviations.Add(TextDescriptionOfDataForTTDisposalsForDeviations()); // TT vtbytyad for worship
	TextsOfTTDisposalsForDeviations.Add(TextOfRegisteredRecordsOfInventoryCostsByPeriod());
	TextsOfTTDisposalsForDeviations.Add(TextWriteOffOfDeviationsToCostOfGoodsSold());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfExpensesForInventoryCosts());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfExpensesForProductionLotReferences());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfExpensesForProfitabilityAndCostsEtc());
	TextsOfTTDisposalsForDeviations.Add(TextWriteOffOfDistributionDeviations());
	TextsOfTTDisposalsForDeviations.Add(TextWriteOffOfDeviationsOfOtherExpensesForDistribution());
	TextsOfTTDisposalsForDeviations.Add(TextCorrectionOfDeviationsThatDoNotCorrespondToOtherExpenses());
	TextOfTTOfWithdrawalForDeviations = StrConcat(TextsOfTTDisposalsForDeviations, Common.UnionAllText());
	TextOfTTOfWithdrawalForDeviations = TextOfTTOfWithdrawalForDeviations + "
	|INDEX BY
	|	SourceNodeNumber
	|";
	
	QueriesTexts = New Array;
	QueriesTexts.Add(TextTableOfSolutionsInDetail()); // TableOfSolutionsInDetail
	QueriesTexts.Add(TextTableOfDecisionsOtherExpensesInDetail()); // TT of the resolution tablereferencesexternal links
	QueriesTexts.Add(TextTTOfIrrelevantRegisteredRecordsOtherExpensesPreliminary()); // TTIrrelevantRegisteredRecordsOtherExpensesPreliminary
	QueriesTexts.Add(TextTTOfIrrelevantRegisteredRecordsOtherExpenses()); // TTIrrelevantRegisteredRecordsOtherExpenses
	QueriesTexts.Add(TextOfTTOfWithdrawalForDeviations); // TTDisposalsForDeviations
	QueriesTexts.Add(TextOfTTOfRegisteredRecordsOfInventoryCosts()); // TTOfRegisteredRecordsOfInventoryCosts
	QueriesTexts.Add(TextOfRegisteredRecordedRevenueTT()); // RegisteredRecordedRevenueTT
	QueriesTexts.Add(TextTTOfRegisteredRecordedOtherExpenses()); // TTOtherExpenses
	QueriesTexts.Add(TextOfTTRegisteredRecordsOtherAssetsLiabilities()); // TTRegisteredRecordsOtherAssetsLiabilities
	
	QueriesTexts.Add(TextTTOfRegisteredRecordedOtherExpensesOfWorkInProgress()); // TTOtherWorkInProgressExpenses
	
	QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());	
	If CalculationParameters <> Undefined Then
		QueryText = SetBitDepthOfNumbersInRequestText(CalculationParameters, QueryText);
	EndIf;
	
	Return QueryText;
	
EndFunction	

// ... formation of temporary tables

Function TextTableOfSolutionsInDetail() // TT tableresolution Details
	Return "	
		|SELECT
		|	CAST(Nodes.NodeNumber AS NUMBER(31,0)) AS NodeNumber,
		|	Recorders.Ref AS Recorder,
		|	Nodes.VariancePeriod,
		|	Nodes.DistributionPeriod,
		|
		|	Nodes.ItemsLocationAttributes AS ItemsLocationAttributes,
		|	Nodes.AccountingSection AS AccountingSection,
		|	Nodes.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		|	Nodes.Organization AS Organization,
		|	Nodes.Lot AS Lot,
		|	Nodes.LotVendorAttributes AS LotVendorAttributes,
		|	Nodes.FinancialAccountingDimension AS FinancialAccountingDimension,
		|	Nodes.VATActivityType AS VATActivityType,
		|
		|	ISNULL(DecisionTable.CostVariancesIncludingVAT, 0) AS CostVariancesIncludingVAT,
		|	ISNULL(DecisionTable.CostVariancesExcludingVAT, 0) AS CostVariancesExcludingVAT,
		|	ISNULL(DecisionTable.CostVariancesLocal, 0) AS CostVariancesLocal,
		|	ISNULL(DecisionTable.CostVariancesMgmt, 0) AS CostVariancesMgmt,
		|	0 AS VATLocal,
		|	0 AS VATManag,
		|	ISNULL(DecisionTable.AdditionalExpensesIncludingVAT, 0) AS AdditionalExpensesIncludingVAT,
		|	ISNULL(DecisionTable.AdditionalExpensesExcludingVAT, 0) AS AdditionalExpensesExcludingVAT,
		|	ISNULL(DecisionTable.AddExpensesLocal, 0) AS AddExpensesLocal,
		|	ISNULL(DecisionTable.AddExpensesMan, 0) AS AddExpensesMan,
		|	ISNULL(DecisionTable.PermanentDifference, 0) AS PermanentDifference,
		|	ISNULL(DecisionTable.CostTD, 0) AS CostTD,
		|	ISNULL(DecisionTable.AIT, 0) AS AIT,
		|	(NOT DecisionTable.NodeNumber IS NULL) AS ThereIsCost
		|
		|INTO TableOfSolutionsInDetail
		|FROM
		|	TTNodesOfDeviations AS Nodes
		|	LEFT JOIN TTDecisionTable_LastPeriod AS DecisionTable
		|		ON DecisionTable.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TTCostCalculationRecorders AS Recorders
		|		ON Nodes.Organization = Recorders.Organization
		|WHERE
		|	Nodes.ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	AND Nodes.Products <> UNDEFINED
		|
		|INDEX BY
		|	NodeNumber
		|";
EndFunction

Function TextTableOfDecisionsOtherExpensesInDetail() // TT of the resolution tablereferencesexternal links
	Return "	
		|SELECT
		|	CAST(Nodes.NodeNumber AS NUMBER(31,0)) AS NodeNumber,
		|	Recorders.Ref AS Recorder,
		|	Nodes.VariancePeriod,
		|	Nodes.DistributionPeriod,
		|
		|	Nodes.Organization AS Organization,
		|	Nodes.Department AS Department,
		|	Nodes.LineOfBusiness AS LineOfBusiness,
		|	Nodes.ExpenseItem AS ExpenseItem,
		|	Nodes.DimensionOfExpenses AS DimensionOfExpenses,
		|	Nodes.Lot AS Lot,
		|	Nodes.ThisIsUnfinishedPRODUCTION AS ThisIsUnfinishedPRODUCTION,
		|
		|	ISNULL(DecisionTable.CostVariancesIncludingVAT, 0) AS CostVariancesIncludingVAT,
		|	ISNULL(DecisionTable.CostVariancesExcludingVAT, 0) AS CostVariancesExcludingVAT,
		|	ISNULL(DecisionTable.CostVariancesLocal, 0) AS CostVariancesLocal,
		|	ISNULL(DecisionTable.CostVariancesMgmt, 0) AS CostVariancesMgmt,
		|	ISNULL(DecisionTable.AdditionalExpensesIncludingVAT, 0) AS AdditionalExpensesIncludingVAT,
		|	ISNULL(DecisionTable.AdditionalExpensesExcludingVAT, 0) AS AdditionalExpensesExcludingVAT,
		|	ISNULL(DecisionTable.AddExpensesLocal, 0) AS AddExpensesLocal,
		|	ISNULL(DecisionTable.AddExpensesMan, 0) AS AddExpensesMan,
		|	ISNULL(DecisionTable.CostInTaxAccounting, 0) AS CostInTaxAccounting,
		|	ISNULL(DecisionTable.PermanentDifference, 0) AS PermanentDifference,
		|	ISNULL(DecisionTable.AIT, 0) AS AIT,
		|	(NOT DecisionTable.NodeNumber IS NULL) AS ThereIsCost
		|
		|INTO TableOfSolutionsOtherExpensesInDetail
		|FROM
		|	TTNodesOfDeviations AS Nodes
		|	LEFT JOIN TTDecisionTable_LastPeriod AS DecisionTable
		|		ON DecisionTable.NodeNumber = Nodes.NodeNumber
		|	LEFT JOIN TTCostCalculationRecorders AS Recorders
		|		ON Nodes.Organization = Recorders.Organization
		|WHERE
		|	Nodes.ExpenseItem <> VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		|	AND Nodes.ExpenseItem <> UNDEFINED
		|	AND Nodes.Products = UNDEFINED
		|
		|INDEX BY
		|	Organization,
		|	Department,
		|	ExpenseItem
		|";
EndFunction

