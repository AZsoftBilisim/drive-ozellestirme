Procedure GenerateCorAndCostOfGoods(CalculationParameters, MotionData, InterimCost = False) Export
	
	If InterimCost Then
		DestinationTable = "TTIntermediateCostOfGoods";
	Else
		DestinationTable = Metadata.AccumulationRegisters.InventoryCost.Name;
	EndIf;
	
	CopiedFields = "
	|Period, BusinessOperation, DocumentRegisterRecords, RowID,
	|Department, ProductsGroup,
	|Cost, OffBalanceCost, CostExcludingVAT, AddExpensesForGoods, AdditionalExpensesExcludingVAT,
	|LocalCost, OffBalanceCostLocal, PermanentDifference, CostTD, CostOfPersonalIncomeTax,
	|ProductCostElement, EntryType, DocumentSource, FinRecordID, ReversingEntry,
	|BusinessTransactionSetting,
	|LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT,
	|AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl,
	|ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, ItemizedVariableCostsCompl,
	|CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag, VATManag";
	
	If MotionData.Property("BusinessTransactionSetting") Then
		CopiedFields = CopiedFields + ", " + "BusinessTransactionSetting";
	EndIf;
	
	// Let's add a movement and fill in its basic properties
	Record = AddEntryToMovementTable(CalculationParameters, DestinationTable, MotionData, CopiedFields);
	
	// Fill in additional motion properties
	Record.RecordType                = AccumulationRecordType.Receipt;
	Record.ItemsLocationAttributes = MotionData.CorItemsLocationAttributes;
	Record.AccountingSection                = MotionData.CorAccountingSection;
	Record.InventoryOwnerAttribute                 = MotionData.CorInventoryOwnerAttribute;
	Record.Organization                = ?(ValueIsFilled(MotionData.CorCompany), MotionData.CorCompany, MotionData.Organization);
	Record.Count 				  = 0;
	
	Record.Lot                 	  = MotionData.CorLot;
	If ValueIsFilled(MotionData.CorLot) Then
		Record.LotVendorAttributes   = MotionData.LotVendorAttributesCorr;
	EndIf;
	
	If CalculationParameters.BatchAccountingVersion22 Then
		Record.FinancialAccountingDimension = MotionData.CorControllingAttributes;
		Record.VATActivityType   	 = MotionData.CorVATActivityTypes;
		If MotionData.BusinessOperation = Enums.BusinessTransactions.ProductsRelease Then
			If TypeOf(MotionData.FinancialAccountingDimension) = Type("CatalogRef.AnalyticalInventoryGroups") Then
				Record.CorControllingAttributes = MotionData.FinancialAccountingDimension;
			Else
				Record.CorControllingAttributes = Catalogs.AnalyticalInventoryGroups.EmptyRef();
			EndIf;
			Record.ProductsGroup = MotionData.FinancialAccountingDimension;
		EndIf;
		If TypeOf(MotionData.DocumentRegisterRecords) = Type("DocumentRef.RecyclableWasteAllocation")
			And Record.RecordType = AccumulationRecordType.Receipt
			And Record.AccountingSection = Enums.SectionsOfInventoryCostAccounting.WorkInProgress Then
			Record.CorItemsLocationAttributes	= MotionData.AnalysisOfAccountingForProductRange;
			Record.CorControllingAttributes		= MotionData.AnalysisOfFinancialAccountingIn;
		EndIf;
	EndIf;
	If Record.AccountingSection = Enums.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping Then
		Record.CorInventoryOwnerAttribute             = MotionData.CorInventoryOwnerAttribute;
	EndIf;

	If MotionData.ThisIsTransferBetweenOrganizations Then
		
		Record.LocalCost = 0;
		Record.OffBalanceCostLocal = 0;
		Record.PermanentDifference = 0;
		Record.CostTD = 0;
		Record.CostOfPersonalIncomeTax = 0;
		
		Record.AddExpensesLocal = 0;
		Record.LaborCostsLocal = 0;
		Record.ItemizedFixedCostsCompl = 0;
		Record.ItemizedVariableCostsCompl = 0;
		
		Record.CostMan = 0;
		Record.AddExpensesMan = 0;
		Record.LaborCostsMan = 0;
		Record.ItemizedFixedCostsManag = 0;
		Record.ItemizedVariableCostsManag = 0;
		
	ElsIf MotionData.VATLocal <> 0 Or MotionData.VATManag <> 0 Then // this is not a transfer
		
		CopiedFields = " Period, BusinessOperation, DocumentRegisterRecords, RowID, Department, Organization,
			|ProductCostElement, EntryType, DocumentSource";
		
		// Let's add a movement and fill in its basic properties
		Record = AddEntryToMovementTable(CalculationParameters, DestinationTable, MotionData, CopiedFields);
		
		// Fill in additional motion properties
		Record.RecordType 				  	 = AccumulationRecordType.Receipt;
		Record.ItemsLocationAttributes 	 = MotionData.CorItemsLocationAttributes;
		Record.AccountingSection 				  	 = MotionData.CorAccountingSection;
		Record.InventoryOwnerAttribute 				  	 = MotionData.CorInventoryOwnerAttribute;
		Record.Organization                	 = ?(ValueIsFilled(MotionData.CorCompany), MotionData.CorCompany, MotionData.Organization);
		
		Record.Lot                 	     = MotionData.CorLot;
		Record.LotVendorAttributes   	     = MotionData.LotVendorAttributesCorr;
		
		If CalculationParameters.BatchAccountingVersion22 Then
			Record.FinancialAccountingDimension = MotionData.CorControllingAttributes;
			Record.VATActivityType   	 = MotionData.CorVATActivityTypes;
			If MotionData.BusinessOperation = Enums.BusinessTransactions.ProductsRelease Then
				If TypeOf(MotionData.FinancialAccountingDimension) = Type("CatalogRef.AnalyticalInventoryGroups") Then
					Record.CorControllingAttributes = MotionData.FinancialAccountingDimension;
				Else
					Record.CorControllingAttributes = Catalogs.AnalyticalInventoryGroups.EmptyRef();
				EndIf;
				Record.ProductsGroup = MotionData.FinancialAccountingDimension;
			EndIf;
		EndIf;
		
		Record.LocalCost 			  	 = MotionData.VATLocal;
		Record.CostMan 			  	 = MotionData.VATManag;
		Record.CostOfPersonalIncomeTax 			  	 = MotionData.VATLocal;
		
	EndIf;

EndProcedure

