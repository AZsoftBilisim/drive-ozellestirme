		|	CAST(T.ArcWeightItemByItemCostsWithoutVAT * SourceNodes.AdditionalExpensesExcludingVAT AS NUMBER(31,2)) AS AdditionalExpensesExcludingVAT,
		|	CAST(T.ArcWeightItemByItemLocalCosts * SourceNodes.AddExpensesLocal AS NUMBER(31,2)) AS AddExpensesLocal,
		|	CAST(T.ArcWeightItemByItemManCosts * SourceNodes.AddExpensesMan AS NUMBER(31,2)) AS AddExpensesMan,
		|	CAST(T.ArcWeightItemByItemLocalCosts * SourceNodes.PermanentDifference AS NUMBER(31,2)) AS PermanentDifference,
		|	CAST(T.ArcWeightItemByItemCostsTA * SourceNodes.CostTD AS NUMBER(31,2)) AS CostTD,
