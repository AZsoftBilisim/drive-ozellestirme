	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTRegisteredRecordsOtherAssetsLiabilities", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

#Region CorrectionOfMovementProductItemsIncomeExpenses

	TempTableName = "TTRegisteredRecordsProductRangeRevenuesExpensesReverseRegisteredRecords";
	RegisterName = Metadata.AccumulationRegisters.RegisterRecordsProductsIncomeExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTMovementProductsIncomeExpenses");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTMovementProductsIncomeExpenses", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

#Region MotionCorrectionProductsProducts

	TempTableName = "TTMotionProductProductReverseMotion";
	RegisterName = Metadata.AccumulationRegisters.RecordsProductsProducts.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	CopiedFields = CostCalculationUniversalAlgorithms.GetColumnNamesOfTemporaryTableByString(CalculationParameters, "TTMovementProductsProducts");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, 
		RegisterName, "TTMovementProductsProducts", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	// We will destroy unnecessary temporary tables.
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);
	
EndProcedure

Function TextAdjustCostOfStornoOfRegisteredRecordsOfCorrectedDocuments(CalculationParameters)
	
	QueryText = "";

	#Region CorrectedDocuments_
	QueryText = QueryText + CostCalculationFillingInformationAboutLots.TextCorrectedDocuments() // tue Corrected documents
		+ Common.QueryBatchSeparator();
	#EndRegion

	#Region CorrectionCostOfGoods // TTCostRegisteredRecords

	// Filling in the fields must correspond to the function of calculating the cost of filling in the parties.The text of the movement of the corrected documents of the past period()
	// Fields: Registrar, Period, Record type, Document source
	QueryText = QueryText + "
	|SELECT
	|	(CASE
	|		WHEN DD.EntryType = VALUE(Enum.LotRecordTypes.CostAllocationToProductionLots)
	|			THEN VALUE(Enum.LotRecordTypes.ProductCostConsumptionPastPeriodReverseTransaction)
	|		WHEN DD.EntryType = VALUE(Enum.LotRecordTypes.Supplement)
	|			THEN VALUE(Enum.LotRecordTypes.AdditionPreviousPeriod)
	|		WHEN DD.EntryType = VALUE(Enum.LotRecordTypes.PreviousPeriodReturn)
	|			THEN VALUE(Enum.LotRecordTypes.ReverseOfPreviousPeriodsReturn)
	|		WHEN DD.EntryType IN (
	|				VALUE(Enum.LotRecordTypes.AddExpensesLotIsSpecified),
	|				VALUE(Enum.LotRecordTypes.AddExpensesLotIsNotSpecified))
	|			THEN VALUE(Enum.LotRecordTypes.DebitNoteForPreviousPeriod)
	|		WHEN DD.RecordType = VALUE(AccumulationRecordType.Receipt)
	|		    AND DD.EntryType IN (
	|				VALUE(Enum.LotRecordTypes.Move),
	|				VALUE(Enum.LotRecordTypes.TransferOnAssignmentBasis))
	|			THEN VALUE(Enum.LotRecordTypes.CorrectPreviousPeriodTransfer)
	|		WHEN DD.RecordType = VALUE(AccumulationRecordType.Receipt)
	|		 AND NOT DD.EntryType = VALUE(Enum.LotRecordTypes.Consumption)
	|		 OR DD.EntryType = VALUE(Enum.LotRecordTypes.Lot)
	|			THEN VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|		ELSE VALUE(Enum.LotRecordTypes.PreviousPeriodCorrections) END) AS EntryType,
	|	CorrectedDocuments_.Period AS Period,
	|	CorrectedDocuments_.Recorder AS Recorder,
	|	DD.RecordType,
	// Dimensions
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	DD.Organization,
	|	CASE
	|		WHEN DD.Organization IN (&SFIFOOrganizationsSliding)
	|			OR VALUETYPE(DD.Lot) = TYPE(Catalog.ProductionLots)
	|			OR DD.AccountingSection IN (
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries),
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors))
	|		THEN DD.Lot
	|		ELSE UNDEFINED
	|	END AS Lot,
	|	CASE
	|		WHEN DD.Organization IN (&SFIFOOrganizationsSliding)
	|			OR VALUETYPE(DD.Lot) = TYPE(Catalog.ProductionLots)
	|			OR DD.AccountingSection IN (
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries),
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors))
	|		THEN DD.LotVendorAttributes
	|		ELSE VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)
	|	END AS LotVendorAttributes,
	|	DD.FinancialAccountingDimension,
	|	DD.VATActivityType,
	// Resources
	|	-DD.Cost AS Cost,
	|	-DD.CostExcludingVAT AS CostExcludingVAT,
	|	-DD.OffBalanceCost AS OffBalanceCost,
	|	-DD.CostMan AS CostMan,
	|	-DD.AddExpensesMan AS AddExpensesMan,
	|	-DD.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	|	-DD.ItemizedVariableCostsExcludingVAT AS ItemizedVariableCostsExcludingVAT,
	|	-DD.LaborCostsMan AS LaborCostsMan,
	|	-DD.ItemizedFixedCostsManag AS ItemizedFixedCostsManag,
	|	-DD.ItemizedVariableCostsManag AS ItemizedVariableCostsManag,
	|	-DD.AddExpensesForGoods AS AddExpensesForGoods,
	|	-DD.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
	|	-DD.LaborCosts AS LaborCosts,
	|	-DD.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	|	-DD.ItemizedFixedCostsExcludingVAT AS ItemizedFixedCostsExcludingVAT,
	|	-DD.LocalCost AS LocalCost,
	|	-DD.OffBalanceCostLocal AS OffBalanceCostLocal,
	|	-DD.PermanentDifference AS PermanentDifference,
	|	-DD.CostTD AS CostTD,
	|	-DD.CostOfPersonalIncomeTax AS CostOfPersonalIncomeTax,
	|	-DD.AddExpensesLocal AS AddExpensesLocal,
	|	-DD.LaborCostsLocal AS LaborCostsLocal,
	|	-DD.ItemizedFixedCostsCompl AS ItemizedFixedCostsCompl,
	|	-DD.ItemizedVariableCostsCompl AS ItemizedVariableCostsCompl,
	|	-DD.ProvisionForImpairmentLocal AS ProvisionForImpairmentLocal,
	|	-DD.ProvisionForImpairmentMan AS ProvisionForImpairmentMan,
	// Attributes
	|	DD.BusinessOperation,
	|	DD.CorItemsLocationAttributes,
	|	DD.CorAccountingSection,
	|	DD.CorInventoryOwnerAttribute,
	|	DD.CorCompany,
	|	DD.CorGrossInitialCostENT,
	|	DD.AccountingDimensionByPartners,
	|	DD.SalesOrder,
	|	DD.Department,
	|	DD.DimensionOfExpenses,
	|	DD.ExpenseItemOfWriteOff,
	|	DD.IncomeItem,
	|	DD.DimensionOfRevenue,
	|	DD.SalePeriod,
	|	DD.AssetAndLiabilityItem,
	|	DD.AssetsLiabilitiesDimension,
	|	CorrectedDocuments_.Recorder AS DocumentRegisterRecords,
	|	DD.RowID,
	|	DD.FinRecordID,
	|	DD.ProductsGroup,
	|	DD.CorLot,
	|	DD.LotVendorAttributesCorr,
	|	DD.CorControllingAttributes,
	|	DD.CorVATActivityTypes,
	|	-DD.VATManag AS VATManag,
	|	-DD.VATLocal AS VATLocal,
	|	DD.ProductCostElement,
	|	DD.Recorder AS DocumentSource,
	|	DD.CorLineOfBusiness,
	|	DD.RowCode,
	|	DD.BusinessTransactionSetting,
	|	TRUE AS ReversingEntry
	|INTO TTCostRegisteredRecords
	|FROM
	|	AccumulationRegister.InventoryCost AS DD
	|
	|	INNER JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|	ON CorrectedDocuments_.ReversedDocument = DD.Recorder
	|	
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|	ON DD.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|	AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|WHERE
	|	DD.Organization IN (&CompanyArray)
	|	AND DD.Period < &BeginOfPeriod
	|	AND DD.Active
	|	AND DD.CalculationOfCost
	|	AND NOT (&BatchAccountingWasUsedBeforeSwitchingToVersion22 = TRUE // the parameter value can be UNDEFINED
	|		AND DD.Period < &DateOfMigrationToBatchAccounting22)
	|	AND NOT DD.ReversingEntry
	|
	|UNION ALL
	|
	|SELECT
	|	(CASE
	|		WHEN DD.EntryType = VALUE(Enum.LotRecordTypes.PreviousPeriodReturn)
	|			THEN VALUE(Enum.LotRecordTypes.ReverseOfPreviousPeriodsReturn)
	|		WHEN DD.OfficialTypeOfMovementParish
	|			THEN VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|		ELSE VALUE(Enum.LotRecordTypes.PreviousPeriodCorrections) END) AS EntryType,
	|	CorrectedDocuments_.Period AS Period,
	|	CorrectedDocuments_.Recorder AS Recorder,
	|	(CASE
	|		WHEN DD.OfficialTypeOfMovementParish THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense) END) AS RecordType,
	// Dimensions
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	DD.Organization,
	|	DD.Lot,
	|	DD.LotVendorAttributes,
	|	DD.FinancialAccountingDimension,
	|	DD.VATActivityType,
	// Resources
	|	-DD.Cost AS Cost,
	|	-DD.CostExcludingVAT AS CostExcludingVAT,
	|	-DD.OffBalanceCost AS OffBalanceCost,
	|	-DD.CostMan AS CostMan,
	|	-DD.AddExpensesMan AS AddExpensesMan,
	|	-DD.ItemizedVariableCostsIncludingVAT AS ItemizedVariableCostsIncludingVAT,
	|	-DD.ItemizedVariableCostsExcludingVAT AS ItemizedVariableCostsExcludingVAT,
	|	-DD.LaborCostsMan AS LaborCostsMan,
	|	-DD.ItemizedFixedCostsManag AS ItemizedFixedCostsManag,
	|	-DD.ItemizedVariableCostsManag AS ItemizedVariableCostsManag,
	|	-DD.AddExpensesForGoods AS AddExpensesForGoods,
	|	-DD.AdditionalExpensesExcludingVAT AS AdditionalExpensesExcludingVAT,
	|	-DD.LaborCosts AS LaborCosts,
	|	-DD.ItemizedFixedCostsIncludingVAT AS ItemizedFixedCostsIncludingVAT,
	|	-DD.ItemizedFixedCostsExcludingVAT AS ItemizedFixedCostsExcludingVAT,
	|	-DD.LocalCost AS LocalCost,
	|	-DD.OffBalanceCostLocal AS OffBalanceCostLocal,
	|	-DD.PermanentDifference AS PermanentDifference,
	|	-DD.CostTD AS CostTD,
	|	-DD.CostOfPersonalIncomeTax AS CostOfPersonalIncomeTax,
	|	-DD.AddExpensesLocal AS AddExpensesLocal,
	|	-DD.LaborCostsLocal AS LaborCostsLocal,
	|	-DD.ItemizedFixedCostsCompl AS ItemizedFixedCostsCompl,
	|	-DD.ItemizedVariableCostsCompl AS ItemizedVariableCostsCompl,
	|	-DD.ProvisionForImpairmentLocal AS ProvisionForImpairmentLocal,
	|	-DD.ProvisionForImpairmentMan AS ProvisionForImpairmentMan,
	// Attributes
	|	DD.BusinessOperation,
	|	DD.CorItemsLocationAttributes,
	|	DD.CorAccountingSection,
	|	DD.CorInventoryOwnerAttribute,
	|	DD.CorCompany,
	|	DD.CorGrossInitialCostENT,
	|	DD.AccountingDimensionByPartners,
	|	DD.SalesOrder,
	|	DD.Department,
	|	DD.DimensionOfExpenses,
	|	DD.ExpenseItemOfWriteOff,
	|	DD.IncomeItem,
	|	DD.DimensionOfRevenue,
	|	DD.SalePeriod,
	|	DD.AssetAndLiabilityItem,
	|	DD.AssetsLiabilitiesDimension,
	|	CorrectedDocuments_.Recorder AS DocumentRegisterRecords,
	|	DD.RowID,
	|	DD.FinRecordID,
	|	DD.ProductsGroup,
	|	DD.CorLot,
	|	DD.LotVendorAttributesCorr,
	|	DD.CorControllingAttributes,
	|	DD.CorVATActivityTypes,
	|	-DD.VATManag AS VATManag,
	|	-DD.VATLocal AS VATLocal,
	|	DD.ProductCostElement,
	|	DD.Recorder AS DocumentSource,
	|	DD.CorLineOfBusiness,
	|	DD.RowCode,
	|	DD.BusinessTransactionSetting,
	|	TRUE AS ReversingEntry
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	
	|	INNER JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|	ON CorrectedDocuments_.ReversedDocument = DD.Recorder
	|	
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON DD.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|		AND TTAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.MovingAverage)
	|WHERE
	|	DD.CalculationOfCost
	|	AND NOT DD.ReversingEntry
	|
	|UNION ALL
	|
	// With an average sliding amount of additional expenses, labor costs and item-by-item expenses, it is necessary to transfer
	// to the register "Deviations in the cost of goods".
	// Such amounts may arise when correcting or side-by-side documents reflected before the transition
	// to an average sliding value.
	|SELECT
	|	VALUE(Enum.LotRecordTypes.Supplement) AS EntryType,
	|	&EndOfPeriod										AS Period,
	|	CostCalculationDocuments.Ref 				AS Recorder,
	|	VALUE(AccumulationRecordType.Expense)				AS RecordType,
	|	
	// Dimensions
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	DD.Organization,
	|	DD.Lot,
	|	DD.LotVendorAttributes,
	|	DD.FinancialAccountingDimension,
	|	DD.VATActivityType,
	// Resources
	|	0 AS Cost,
	|	0 AS CostExcludingVAT,
	|	0 AS OffBalanceCost,
	|	0 AS CostMan,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.AddExpensesMan
	|		ELSE DD.AddExpensesMan END) AS AddExpensesMan,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedVariableCostsIncludingVAT
	|		ELSE DD.ItemizedVariableCostsIncludingVAT END) AS ItemizedVariableCostsIncludingVAT,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedVariableCostsExcludingVAT
	|		ELSE DD.ItemizedVariableCostsExcludingVAT END) AS ItemizedVariableCostsExcludingVAT,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.LaborCostsMan
	|		ELSE DD.LaborCostsMan END) AS LaborCostsMan,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedFixedCostsManag
	|		ELSE DD.ItemizedFixedCostsManag END) AS ItemizedFixedCostsManag,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedVariableCostsManag
	|		ELSE DD.ItemizedVariableCostsManag END) AS ItemizedVariableCostsManag,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.AddExpensesForGoods
	|		ELSE DD.AddExpensesForGoods END) AS AddExpensesForGoods,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.AdditionalExpensesExcludingVAT
	|		ELSE DD.AdditionalExpensesExcludingVAT END) AS AdditionalExpensesExcludingVAT,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.LaborCosts
	|		ELSE DD.LaborCosts END) AS LaborCosts,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedFixedCostsIncludingVAT
	|		ELSE DD.ItemizedFixedCostsIncludingVAT END) AS ItemizedFixedCostsIncludingVAT,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedFixedCostsExcludingVAT
	|		ELSE DD.ItemizedFixedCostsExcludingVAT END) AS ItemizedFixedCostsExcludingVAT,
	|	0 AS LocalCost,
	|	0 AS OffBalanceCostLocal,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.PermanentDifference
	|		ELSE DD.PermanentDifference END) AS PermanentDifference,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.CostTD
	|		ELSE DD.CostTD END) AS CostTD,
	|	0 AS CostOfPersonalIncomeTax,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.AddExpensesLocal
	|		ELSE DD.AddExpensesLocal END) AS AddExpensesLocal,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.LaborCostsLocal
	|		ELSE DD.LaborCostsLocal END) AS LaborCostsLocal,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedFixedCostsCompl
	|		ELSE DD.ItemizedFixedCostsCompl END) AS ItemizedFixedCostsCompl,
	|	SUM(CASE
	|		WHEN NOT DD.OfficialTypeOfMovementParish THEN -DD.ItemizedVariableCostsCompl
	|		ELSE DD.ItemizedVariableCostsCompl END) AS ItemizedVariableCostsCompl,
	|	0 AS ProvisionForImpairmentLocal,
	|	0 AS ProvisionForImpairmentMan,
	// Attributes
	|	VALUE(Enum.BusinessTransactions.InternalChangingPriceEvaluationMethod) AS BusinessOperation,
	|	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS CorItemsLocationAttributes,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS CorAccountingSection,
	|	VALUE(Catalog.InventoryKinds.EmptyRef) AS CorInventoryOwnerAttribute,
	|	VALUE(Catalog.Companies.EmptyRef) AS CorCompany,
	|	0 AS CorGrossInitialCostENT,
	|	VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef) AS AccountingDimensionByPartners,
	|	UNDEFINED AS SalesOrder,
	|	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	|	UNDEFINED AS DimensionOfExpenses,
	|	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItemOfWriteOff,
	|	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	|	UNDEFINED AS DimensionOfRevenue,
	|	DATETIME(1,1,1) AS SalePeriod,
	|	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AssetAndLiabilityItem,
	|	UNDEFINED AS AssetsLiabilitiesDimension,
	|	CostCalculationDocuments.Ref AS DocumentRegisterRecords,
	|	"""" AS RowID,
	|	MAX(DD.FinRecordID) AS FinRecordID,
	|	VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef) AS ProductsGroup,
	|	UNDEFINED AS CorLot,
	|	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributesCorr,
	|	UNDEFINED AS CorControllingAttributes,
	|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS CorVATActivityTypes,
	|	0 AS VATManag,
	|	0 AS VATLocal,
	|	UNDEFINED AS ProductCostElement,
	|	UNDEFINED AS DocumentSource,
	|	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS CorLineOfBusiness,
	|	0 AS RowCode,
	|	VALUE(Catalog.BusinessTransactionsSettings.InternalChangingPriceEvaluationMethod) AS BusinessTransactionSetting,
	|	FALSE AS ReversingEntry
	|FROM
	|	TTCashEstimatedTurnoverCostOfGoods AS DD
	|	INNER JOIN CorrectedDocuments_ AS CorrectedDocuments_
	|		ON CorrectedDocuments_.Recorder = DD.Recorder
	|		AND CorrectedDocuments_.DateOfDocumentBeingCancelled < &BeginOfPeriod
	|	INNER JOIN TTCostCalculationDocuments AS CostCalculationDocuments
	|		ON DD.Organization = CostCalculationDocuments.Organization
	|WHERE
	|	DD.Organization IN (&MediumSlipOrganizations)
	|	AND DD.ReversingEntry
	|	AND (DD.AddExpensesForGoods <> 0 OR DD.AdditionalExpensesExcludingVAT <> 0 OR DD.LaborCosts <> 0
	|		OR DD.ItemizedFixedCostsIncludingVAT <> 0 OR DD.ItemizedVariableCostsIncludingVAT <> 0
	|		OR DD.ItemizedFixedCostsExcludingVAT <> 0 OR DD.ItemizedVariableCostsExcludingVAT <> 0
	|		OR DD.AddExpensesLocal <> 0 OR DD.LaborCostsLocal <> 0
	|		OR DD.ItemizedFixedCostsCompl <> 0 OR DD.ItemizedVariableCostsCompl <> 0
	|		OR DD.PermanentDifference <> 0 OR DD.CostTD <> 0		
	|		OR DD.AddExpensesMan <> 0 OR DD.LaborCostsMan <> 0
	|		OR DD.ItemizedFixedCostsManag <> 0 OR DD.ItemizedVariableCostsManag <> 0
	|		)
	|
	|GROUP BY
	|	CostCalculationDocuments.Ref,
	|	DD.ItemsLocationAttributes,
	|	DD.AccountingSection,
	|	DD.InventoryOwnerAttribute,
	|	DD.Organization,
	|	DD.Lot,
	|	DD.LotVendorAttributes,
	|	DD.FinancialAccountingDimension,
	|	DD.VATActivityType
	|
	|INDEX BY
	|	Recorder
	|;";
	#EndRegion

	#Region GoodsCostVariances // TTOfRegisteredRecordedDeviationsInCostOfGoods
	QueryText = QueryText + "
	|SELECT
	|	T.Period AS Period,
	|	T.Recorder AS Recorder,
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	// Dimensions
	|	T.Organization,
	|	CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Products AS Products,
	|	CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation
	|		WHEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation AS Catalog.Warehouses).Department
	|		WHEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation,
	|	&BeginOfPeriod AS VariancePeriod,
	|	T.BusinessOperation AS BusinessOperation,
	|	T.BusinessTransactionSetting AS BusinessTransactionSetting,
	|	T.FinRecordID AS FinRecordID,
	|
	|	SUM(T.LaborCosts + T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT) AS CostVariancesIncludingVAT,
	|	SUM(T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT) AS CostVariancesExcludingVAT,
	|	SUM(T.LaborCostsLocal + T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl) AS CostVariancesLocal,
	|	SUM(T.LaborCostsMan + T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag) AS CostVariancesMgmt,
	|	SUM(T.AddExpensesForGoods) AS AdditionalExpensesIncludingVAT,
	|	SUM(T.AdditionalExpensesExcludingVAT) AS AdditionalExpensesExcludingVAT,
	|	SUM(T.AddExpensesLocal) AS AddExpensesLocal,
	|	SUM(T.AddExpensesMan) AS AddExpensesMan,
	|	SUM(T.PermanentDifference) AS PermanentDifference,
	|	SUM(T.CostTD) AS CostTD
	|
	|INTO TTOfRegisteredRecordedDeviationsInCostOfGoods
	|FROM
	|	TTCostRegisteredRecords AS T
	|	INNER JOIN TTAccountingPoliciesOfFinancialAccounting AS TTAccountingPoliciesOfFinancialAccounting
	|		ON T.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization
	|WHERE
	|	T.BusinessOperation = VALUE(Enum.BusinessTransactions.InternalChangingPriceEvaluationMethod)
	|
	|GROUP BY
	|	T.Period,
	|	T.Recorder,
	|	T.Organization,
	|	CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Products,
	|	CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Characteristic,
	|	T.InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END, // LineOfBusiness
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation
	|		WHEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation AS Catalog.Warehouses).Department
	|		WHEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END, // Department
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN CAST(T.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation
	|		ELSE UNDEFINED
	|	END, // StorageLocation
	|	T.BusinessOperation,
	|	T.BusinessTransactionSetting,
	|	T.FinRecordID
	|;";
