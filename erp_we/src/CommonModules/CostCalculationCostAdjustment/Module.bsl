// Service, stage 2.1, 3.3, 3.14, 3.19
Procedure GenerateRegisteredRecordsAccordingToTurnoverRegistersOfAccountingMan(CalculationParameters, MotionData) Export
	
	SumData = GetSummaryIndicatorsOfProductMovement(MotionData);
	
	If SumData.ThereIsNonZeroTotalSum Then
		
		// Formation of Nomenclature - Income movements\Expenses.
		If MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsConsumption
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsConsumptionOnDemand
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToFixedAssets
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToIntangibleAssetsAndRD
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsWriteOffAtToller
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferForOtherPurposes
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToOperation
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.WriteOffReportFromCommissionAgent
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.MonthEndTransactions
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.WriteOffShortagesAtDepositorSExpense
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.RecognizeInventorySurplusForTheBenefitOfConsignor
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.RecognizeInventorySurplusForTheBenefitOfDepositor Then
			
			FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData, SumData);
			
		EndIf;
		
		If MotionData.BusinessOperation = Enums.BusinessTransactions.InventoryConsumptionReverseTransaction Then
			
			If CalculationParameters.Property("EvaluationMethod")
			 And CalculationParameters.EvaluationMethod = Enums.InventoryValuationMethods.FIFORollingValuation Then
				
				FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData, SumData);
				
			Else
				
				AdjustedAmounts = AdjustSumOfProductMovementIndicators(SumData, -1, -1, -1, -1, 0);
				
				FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData, AdjustedAmounts);
				
			EndIf;
			
		EndIf;
		
		// Formation of movements Nomenclature - Nomenclature.
		If ((MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfGoodsBetweenBranchOffices
				Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices
				Or MotionData.BusinessOperation = Enums.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices)
				And MotionData.RecordType = AccumulationRecordType.Expense)
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnFromProduction
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnOfMaterialsFromProduction
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnOfMaterialsFromStoreroom
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnFromProcessingCompany2_5
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.IntercompanyCommissionReturn
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ProductsRelease
			Or (MotionData.BusinessOperation = Enums.BusinessTransactions.ReceiptFromToller2_5
				And MotionData.RecordType = AccumulationRecordType.Expense)
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfProductsFromProduction
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfProductsFromStoreroom
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsAssignmentAdjustments
			Or ((MotionData.BusinessOperation = Enums.BusinessTransactions.InventoryTransfer
				Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfSemiFinishedProducts
				Or MotionData.BusinessOperation = Enums.BusinessTransactions.WorkAcceptanceAndTransferBetweenBusinessUnits)
				And MotionData.RecordType = AccumulationRecordType.Expense)
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToProduction
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.MaterialTransferToProduction
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfMaterialsToStoreroom
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfGoodsToCommissionAgentInAnotherCompany
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToToller2_5
			Or (MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsMisgrading
				And MotionData.RecordType = AccumulationRecordType.Expense)
			Or (MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsDamage
				And MotionData.RecordType = AccumulationRecordType.Expense)
			Or (MotionData.BusinessOperation = Enums.BusinessTransactions.SaleWithDeferredTransferOfTitle
				And MotionData.AccountingSection <> Enums.SectionsOfInventoryCostAccounting.GoodsInTransit)
			Or (MotionData.BusinessOperation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit
				And MotionData.AccountingSection <> Enums.SectionsOfInventoryCostAccounting.GoodsInTransitTransferredToCommissionAgent)
			Or (MotionData.BusinessOperation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit
				And MotionData.AccountingSection <> Enums.SectionsOfInventoryCostAccounting.GoodsInTransitReceivedByCommissionAgent)
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.AssemblyFromComponents
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.DisassemblyIntoComponents
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUUninvoicedDelivery
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ImportReceiptFromGoodsInTransit
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferToStorageWithRightOfSale
			Or MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnFromCustodian Then
			
			FormOfMovementProductsProducts(CalculationParameters, MotionData, SumData,
				?(MotionData.BusinessOperation = Enums.BusinessTransactions.SaleWithDeferredTransferOfTitle
				Or MotionData.BusinessOperation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit,
					Enums.BusinessTransactions.ShipmentWithDeferredTransferOfTitle,
					Undefined));
			
			If MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfGoodsBetweenBranchOffices
				Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferOfSemiFinishedProductsBetweenBranchOffices Then
				FormOfMovementProductsProducts(CalculationParameters, MotionData, SumData,
					Enums.BusinessTransactions.InternalGoodsReceipt);
			ElsIf MotionData.BusinessOperation = Enums.BusinessTransactions.WorkAcceptanceAndTransferBetweenBranchOffices Then
				FormOfMovementProductsProducts(CalculationParameters, MotionData, SumData,
					Enums.BusinessTransactions.InternalWorkReceipt);
			EndIf;
			
		EndIf;
		
	EndIf;
	
	// Formation of other income/expenses during the re-sorting.
	If MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsMisgradingWithRevaluation Then

		If SumData.FullAmountOfRevaluation > 0 Then 
			
			AdjustedAmounts = AdjustSumOfProductMovementIndicators(SumData, 1, 1, 1, 1, 1);
			
			FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData,
				AdjustedAmounts,
				False,
				Enums.BusinessTransactions.ExpensesFromGoodsRevaluation);
			
		ElsIf SumData.FullAmountOfRevaluation < 0 Then
			
			AdjustedAmounts = AdjustSumOfProductMovementIndicators(SumData, -1, 1, -1, -1, 1);
			
			FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData,
				AdjustedAmounts,
				True,
				Enums.BusinessTransactions.IncomeFromGoodsRevaluation);
			
		EndIf;
		
	EndIf;
	
	// Formation of other expenses in case of damage.
	If MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsDamageRevaluation Then
		
		If SumData.FullAmountOfRevaluation <> 0 Then
			
			AdjustedAmounts = AdjustSumOfProductMovementIndicators(SumData, 1, 1, 1, 1, 1);
			
			FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData,
				AdjustedAmounts,
				False,
				Enums.BusinessTransactions.ExpensesFromGoodsRevaluation);
			
		EndIf;
		
	EndIf;
	
	// Formation of other income/expenses arising from the revaluation of goods.
	If (MotionData.BusinessOperation = Enums.BusinessTransactions.ReturnOfGoodsToVendor
			And MotionData.CorGrossInitialCostENT <> 0)
		Or MotionData.BusinessOperation = Enums.BusinessTransactions.SaleOfTransferredReturnablePackaging
		Or MotionData.BusinessOperation = Enums.BusinessTransactions.IntercompanyGoodsReturn
		Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferredPackageReverseTransactionReturnToAnotherWarehouse
		Or MotionData.BusinessOperation = Enums.BusinessTransactions.TransferredPackageReverseTransaction Then
		
		If MotionData.BusinessOperation = Enums.BusinessTransactions.IntercompanyGoodsReturn Then
			AdjustedAmounts = AdjustSumOfProductMovementIndicators(SumData, 0, 0, 1, 1, 0);
		Else
			AdjustedAmounts = AdjustSumOfProductMovementIndicators(SumData, 1, 1, 1, 1, 0);
		EndIf;
		
		If AdjustedAmounts.FullAmountWithVAT > 0
		 Or AdjustedAmounts.FullLocalAmount > 0
		 Or AdjustedAmounts.FullAmountOfMan > 0 Then 

			FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData,
				AdjustedAmounts,
				False,
				Enums.BusinessTransactions.ExpensesFromGoodsRevaluation);
			
		ElsIf AdjustedAmounts.FullAmountWithVAT < 0
		 Or AdjustedAmounts.FullLocalAmount < 0
		 Or AdjustedAmounts.FullAmountOfMan < 0 Then 
			
			AdjustedAmounts = AdjustSumOfProductMovementIndicators(AdjustedAmounts, -1, -1, -1, -1, 0);
			
			FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData,
				AdjustedAmounts,
				True,
				Enums.BusinessTransactions.IncomeFromGoodsRevaluation);
			
		EndIf;
		
	EndIf;
	
EndProcedure

// Service, stage 2.1, 3.3, 3.14 (formatmovementsreferencesexternal Links)
Procedure FormOfMovementProductsIncomeExpenses(CalculationParameters, MotionData, SumData,
			ThisIsIncome = False, BusinessOperation = Undefined)

	RegisterName = Metadata.AccumulationRegisters.RegisterRecordsProductsIncomeExpenses.Name;
	
	CopiedFields =
	"Period, BusinessOperation, Organization, Department,
	|ItemsLocationAttributes,Warehouse,InventoryType,InventoryOwnerAttribute,
	|SourceOfProductFinancialAccountingGroup, DocumentRegisterRecords";
	
	// Let's add a movement and fill in its basic properties
	Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
	
	// Fill in additional motion properties.
	FillPropertyValues(Record, SumData);
	
	If BusinessOperation <> Undefined Then
		Record.BusinessOperation = BusinessOperation;
	EndIf;
	
	If ThisIsIncome Then
		Record.IncomeAndExpenseItem = MotionData.IncomeItem;
		Record.DimensionOfRevenue 	 = MotionData.DimensionOfRevenue;
		Record.ProductLineOfBusiness = MotionData.LineOfBusiness;
		Record.LineOfBusinessItems = MotionData.CorLineOfBusiness;
	Else
		Record.IncomeAndExpenseItem = MotionData.ExpenseItemOfWriteOff;
		Record.DimensionOfExpenses 	 = MotionData.DimensionOfExpenses;
		Record.ProductLineOfBusiness = MotionData.LineOfBusiness;
		Record.LineOfBusinessItems = MotionData.CorLineOfBusiness;
		If MotionData.BusinessOperation = Enums.BusinessTransactions.GoodsConsumptionOnDemand
			And MotionData.CorInventoryType = Enums.InventoryTypes.ConsignedGoods Then
			Record.ProductLineOfBusiness = MotionData.CorLineOfBusiness;
		EndIf;
	EndIf;
	
EndProcedure

// Service, stage 2.1, 3.3, 3.14 (formatmovementsreferencesexternal Links)
Procedure FormOfMovementProductsProducts(CalculationParameters, MotionData, SumData, BusinessOperation)
	
	If Not ValueIsFilled(MotionData.CorItemsLocationAttributes)
	 And (MotionData.BusinessOperation = Enums.BusinessTransactions.AssemblyFromComponents
		Or MotionData.BusinessOperation = Enums.BusinessTransactions.DisassemblyIntoComponents
	 	Or MotionData.BusinessOperation = Enums.BusinessTransactions.SaleWithDeferredTransferOfTitle
	 	Or MotionData.BusinessOperation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit) Then
		Return;
	EndIf;
	
	RegisterName = Metadata.AccumulationRegisters.RecordsProductsProducts.Name;
	
	CopiedFields =
	"Period, BusinessOperation, Organization, Department,
	|ItemsLocationAttributes,Warehouse,InventoryType,InventoryOwnerAttribute,LineOfBusiness,
	|CorItemsLocationAttributes,CorWarehouseCorCommissionAgentCorBusinessUnit,CorInventoryType,CorInventoryOwnerAttribute,CorLineOfBusiness,
	|SourceOfProductFinancialAccountingGroup, CorSourceOfItemsFinancialAccountingGroup, DocumentRegisterRecords, CorCompany";

	// Let's add a movement and fill in its basic properties
	Record = AddEntryToMovementTable(CalculationParameters, RegisterName, MotionData, CopiedFields);
	
	// Fill in additional motion properties.
	FillPropertyValues(Record, SumData);
	
	If BusinessOperation <> Undefined Then
		Record.BusinessOperation = BusinessOperation;
		If Record.BusinessOperation = Enums.BusinessTransactions.InternalGoodsReceipt
			Or Record.BusinessOperation = Enums.BusinessTransactions.InternalWorkReceipt Then
			Record.Organization    = MotionData.CorCompany;
			Record.CorCompany = MotionData.Organization;
		EndIf;
	EndIf;
	
	If TypeOf(MotionData.Warehouse) = Type("CatalogRef.Partners") Then
		Record.Count = MotionData.Count;
	EndIf;
	
	If Record.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent Then
		Record.CorLineOfBusiness = MotionData.LineOfBusiness;
	EndIf;
	
EndProcedure

// Service, stage 2.1, 3.18
Procedure GenerateRegisteredRecordsProductsIncomeExpensesVATWriteOff(CalculationParameters) Export
	
	RegisterName = Metadata.AccumulationRegisters.RegisterRecordsProductsIncomeExpenses.Name;
	
	CopiedFields = "Period, BusinessOperation, Organization,
	|ProductLineOfBusiness, LineOfBusinessItems, ItemsLocationAttributes,
	|Warehouse, Department, IncomeAndExpenseItem, DimensionOfExpenses, InventoryOwnerAttribute, InventoryType,
	|SourceOfProductFinancialAccountingGroup, DocumentRegisterRecords, LocalCost, CostMan";
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	Lots.Period 														AS Period,
	|	VALUE(Enum.BusinessTransactions.VATOnAcquiredAssetsWriteOff) 	AS BusinessOperation,
	|	Lots.Organization 													AS Organization,
	|	CatAssignments.LineOfBusiness 								AS ProductLineOfBusiness,
	|	CatAssignments.LineOfBusiness 								AS LineOfBusinessItems,
	|	Lots.ItemsLocationAttributes 									AS ItemsLocationAttributes,
	|	DimensionOfProductItem.StorageLocation									AS Warehouse,
	|	CASE
	|		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN DimensionOfProductItem.Department
	|		ELSE ISNULL(CatWarehouses.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
	|	END 																AS Department,
	|	Lots.VATWriteOffItem 											AS IncomeAndExpenseItem,
	|	Lots.DimensionVATWriteOff 										AS DimensionOfExpenses,
	|	Lots.InventoryOwnerAttribute													AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|		 AND NOT CatProducts.TracedGoods
	|			THEN VALUE(Enum.InventoryTypes.OperationService)
	|		ELSE ISNULL(CatInventoryKinds.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods))
	|	END 																AS InventoryType,
	|	CASE WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|		THEN Lots.InventoryOwnerAttribute
	|		ELSE DimensionOfProductItem.Products
	|	END 																AS SourceOfProductFinancialAccountingGroup,
	|	Lots.Recorder 													AS DocumentRegisterRecords,
	|	SUM(Lots.VATDeduction_) 											AS LocalCost,
	|	SUM(Lots.WriteOffOfVATMan) 										AS CostMan
	|FROM
	|	TTParty AS Lots
	|		LEFT JOIN Catalog.InventoryKinds AS CatInventoryKinds
	|		ON Lots.InventoryOwnerAttribute = CatInventoryKinds.Ref
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	|			LEFT JOIN Catalog.Warehouses AS CatWarehouses
	|			ON DimensionOfProductItem.WarehouseArea = CatWarehouses.Ref
	|			LEFT JOIN Catalog.Products AS CatProducts
	|			ON DimensionOfProductItem.Products = CatProducts.Ref
	|		ON Lots.ItemsLocationAttributes = DimensionOfProductItem.Ref
	|		LEFT JOIN Catalog.Assignments AS CatAssignments
	|		ON CatAssignments.Ref = DimensionOfProductItem.Purpose
	|
	|GROUP BY
	|	Lots.Period,
	|	Lots.Organization,
	|	Lots.ItemsLocationAttributes,
	|	DimensionOfProductItem.StorageLocation,
	|	CASE
	|		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN DimensionOfProductItem.Department
	|		ELSE ISNULL(CatWarehouses.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
	|	END,
	|	CatAssignments.LineOfBusiness,
	|	Lots.VATWriteOffItem,
	|	Lots.DimensionVATWriteOff,
	|	Lots.InventoryOwnerAttribute,
	|	CASE
	|		WHEN CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|		 AND NOT CatProducts.TracedGoods
	|			THEN VALUE(Enum.InventoryTypes.OperationService)
	|	ELSE
	|		ISNULL(CatInventoryKinds.InventoryType, VALUE(Enum.InventoryTypes.OwnGoods))
	|	END, // InventoryType
	|	Lots.Recorder,
	|	CASE WHEN &GenerateInventoryOwnerAttributesByFinancialAccountingGroups
	|		THEN Lots.InventoryOwnerAttribute
	|		ELSE DimensionOfProductItem.Products
	|	END
	|
	|HAVING
	|	SUM(Lots.VATDeduction_) <> 0
	|	OR SUM(Lots.WriteOffOfVATMan) <> 0
	|
	|ORDER BY
	|	Recorder";
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,,, RegisterName);
	
	While Selection.Next() Do
		// Let's add a movement and fill in its properties.
		AddEntryToMovementTable(CalculationParameters, RegisterName, Selection, CopiedFields);
	EndDo;
	
EndProcedure

Function GetSummaryIndicatorsOfProductMovement(FillingData)
	
	SumData = New Structure;
	SumData.Insert("Cost", 			  		0);
	SumData.Insert("CostExcludingVAT", 		  		0);
	SumData.Insert("AddExpensesForGoods", 	  		  		0);
	SumData.Insert("AdditionalExpensesExcludingVAT", 	  		0);
	SumData.Insert("LaborCosts", 		  		0);
	SumData.Insert("ItemizedFixedCostsIncludingVAT", 	0);
	SumData.Insert("ItemizedFixedCostsExcludingVAT", 	0);
	SumData.Insert("ItemizedVariableCostsIncludingVAT", 	0);
	SumData.Insert("ItemizedVariableCostsExcludingVAT", 	0);
	SumData.Insert("LocalCost", 		  		0);
	SumData.Insert("AddExpensesLocal", 		  		0);
	SumData.Insert("LaborCostsLocal", 	  		0);
	SumData.Insert("ItemizedFixedCostsCompl", 	0);
	SumData.Insert("ItemizedVariableCostsCompl", 	0);
	SumData.Insert("CostMan", 		  		0);
	SumData.Insert("AddExpensesMan", 		  		0);
	SumData.Insert("LaborCostsMan", 		  		0);
	SumData.Insert("ItemizedFixedCostsManag", 	0);
	SumData.Insert("ItemizedVariableCostsManag", 	0);
	SumData.Insert("OffBalanceCost", 		0);
	SumData.Insert("OffBalanceCostLocal", 	0);
	SumData.Insert("PermanentDifference", 			0);
	SumData.Insert("CostTD", 			0);
	SumData.Insert("VATLocal", 			    		0);
	SumData.Insert("VATManag",	 			    	0);
	SumData.Insert("CorGrossInitialCostENT", 			    0);
	
	FillPropertyValues(SumData, FillingData);
	
	FillInTotalTrafficTotals(SumData);
	
	SumData.Insert("FullAmountOfRevaluation", SumData.FullAmountWithVAT - SumData.CorGrossInitialCostENT);
		
	Return SumData;
	
EndFunction

Function AdjustSumOfProductMovementIndicators(SumData,
			CoefficientOfSumWithVAT, CoefficientOfAmountWithoutVAT, LocalSumCoefficient, ManSumRatio, CorSumRatio)
	
	FieldNamesWithVAT   = New Structure("Cost, AddExpensesForGoods, LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedVariableCostsIncludingVAT");
	FieldNamesWithoutVAT = New Structure("CostExcludingVAT, AdditionalExpensesExcludingVAT, ItemizedFixedCostsExcludingVAT, ItemizedVariableCostsExcludingVAT");
	LocalFieldNames   = New Structure("LocalCost, AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl, ItemizedVariableCostsCompl");
	ManFieldNames 	 = New Structure("CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag");
	
	ReducedValueFieldNames = New Structure("Cost, CostExcludingVAT");
	
	AdjustedAmounts = New Structure;
	
	For Each KeyAndValue In SumData Do
		
		If FieldNamesWithVAT.Property(KeyAndValue.Key) Then
			
			If ReducedValueFieldNames.Property(KeyAndValue.Key) Then
				AdjustedAmounts.Insert(KeyAndValue.Key,
					(KeyAndValue.Value - SumData.CorGrossInitialCostENT * CorSumRatio) * CoefficientOfSumWithVAT);
			Else
				AdjustedAmounts.Insert(KeyAndValue.Key, KeyAndValue.Value * CoefficientOfSumWithVAT);
			EndIf;
			
		ElsIf FieldNamesWithoutVAT.Property(KeyAndValue.Key) Then
			
			If ReducedValueFieldNames.Property(KeyAndValue.Key) Then
				AdjustedAmounts.Insert(KeyAndValue.Key,
					(KeyAndValue.Value - SumData.CorGrossInitialCostENT * CorSumRatio) * CoefficientOfAmountWithoutVAT);
			Else
				AdjustedAmounts.Insert(KeyAndValue.Key, KeyAndValue.Value * CoefficientOfAmountWithoutVAT);
			EndIf;
		
		ElsIf LocalFieldNames.Property(KeyAndValue.Key) Then
			
			AdjustedAmounts.Insert(KeyAndValue.Key, KeyAndValue.Value * LocalSumCoefficient);
		
		ElsIf ManFieldNames.Property(KeyAndValue.Key) Then
			
			AdjustedAmounts.Insert(KeyAndValue.Key, KeyAndValue.Value * ManSumRatio);
			
		Else
			
			AdjustedAmounts.Insert(KeyAndValue.Key, KeyAndValue.Value);
			
		EndIf;
		
	EndDo;
	
	FillInTotalTrafficTotals(AdjustedAmounts);
	
	Return AdjustedAmounts;
	
EndFunction

Procedure FillInTotalTrafficTotals(SumData)
	
	SumData.Insert("FullAmountWithVAT",
		SumData.Cost + SumData.AddExpensesForGoods + SumData.LaborCosts
		+ SumData.ItemizedFixedCostsIncludingVAT + SumData.ItemizedVariableCostsIncludingVAT);
	SumData.Insert("FullAmountWithoutVAT",
		SumData.CostExcludingVAT + SumData.AdditionalExpensesExcludingVAT + SumData.LaborCosts
		+ SumData.ItemizedFixedCostsExcludingVAT + SumData.ItemizedVariableCostsExcludingVAT);
	SumData.Insert("FullLocalAmount",
		SumData.LocalCost + SumData.AddExpensesLocal + SumData.LaborCostsLocal
		+ SumData.ItemizedFixedCostsCompl + SumData.ItemizedVariableCostsCompl);
	SumData.Insert("FullAmountOfMan",
		SumData.CostMan + SumData.AddExpensesMan + SumData.LaborCostsMan
		+ SumData.ItemizedFixedCostsManag + SumData.ItemizedVariableCostsManag);
	
	SumData.Insert("ThereIsNonZeroTotalSum",
		SumData.FullAmountWithVAT <> 0
		Or SumData.FullAmountWithoutVAT <> 0
		Or SumData.FullLocalAmount <> 0
		Or SumData.FullAmountOfMan <> 0);
	
EndProcedure

