							|pl = 'Organizacje';
							|tr = 'İş yerleri'", Common.DefaultLanguageCode()) + ": "
		+ CostCalculationAppliedAlgorithms.CalculatedCompanies(CalculationParameters.CompanyArray, ", ", True);
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, ProtocolString);
	
	CostCalculationAppliedAlgorithms.ClearTemporaryTable(CalculationParameters, "TTIntermediateCostOfGoods");
	
