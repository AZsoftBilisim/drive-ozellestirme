	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN CostMan
	|		ELSE 0 END) AS CostMan,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN AddExpensesMan
	|		ELSE 0 END) AS AddExpensesMan,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN LaborCostsMan
	|		ELSE 0 END) AS LaborCostsMan,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN ItemizedFixedCostsManag
	|		ELSE 0 END) AS ItemizedFixedCostsManag,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN ItemizedVariableCostsManag
	|		ELSE 0 END) AS ItemizedVariableCostsManag,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN ProvisionForImpairmentMan
	|		ELSE 0 END) AS ProvisionForImpairmentMan,
	|
	|	0 AS VATLocal,
	|	0 AS VATManag,
	|	AdjustmentTable.InitialCost_ AS InitialCost_,
	|	AdjustmentTable.InitialValueWithoutVAT AS InitialValueWithoutVAT,
	|	AdjustmentTable.InitialLocalCost AS InitialLocalCost,
	|	AdjustmentTable.InitialCostOfMan AS InitialCostOfMan,
	|	AdjustmentTable.Count AS Count,
	|
	|	AdjustmentTable.ThisIsOutput AS ThisIsOutput,
	|	AdjustmentTable.ThisIsReturnBetweenOrganizations AS ThisIsReturnBetweenOrganizations,
	|	AdjustmentTable.WriteOffReserves,
	|	AdjustmentTable.CalculationIsNotCompleted,
	|	
	|	(AdjustmentTable.Cost + AdjustmentTable.AddExpensesForGoods + AdjustmentTable.LaborCosts
	|	+ AdjustmentTable.ItemizedFixedCostsIncludingVAT + AdjustmentTable.ItemizedVariableCostsIncludingVAT)
	|	- AdjustmentTable.CorGrossInitialCostENT AS FullAmountOfRevaluation,
	|
	|	(CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) >= 0
	|			THEN Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT
	|		ELSE 0 END) AS AmountIncludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) >= 0
	|			THEN CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT
	|		ELSE 0 END) AS AmountExcludingVAT,
	|	(CASE 
	|		WHEN SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) >= 0
	|			THEN LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl
	|		ELSE 0 END) AS SumCompl,
	|	(CASE 
	|		WHEN SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			THEN CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag
	|		ELSE 0 END) AS SumMan,
	|	(CASE 
	|		WHEN SignIsReversed * CostOfPersonalIncomeTax >= 0
	|			THEN CostOfPersonalIncomeTax
	|		ELSE 0 END) AS AITAmount,
	|	AdjustmentTable.Character AS Character
	|FROM
	|	TTDataAdjustmentTable AS AdjustmentTable
	|WHERE
	|	(AdjustmentTable.BusinessOperation IN (&BusinessTransactionsAdjustmentTables)
	|	 AND AdjustmentTable.AccountingSection IN (&BalanceSectionsOfAccounting)
	|		OR AdjustmentTable.BusinessOperation = VALUE(Enum.BusinessTransactions.GoodsLotsMisgrading)
	|		OR AdjustmentTable.EntryType = VALUE(Enum.LotRecordTypes.PurchaseAdjustment)
	|			AND AdjustmentTable.BusinessOperation <> VALUE(Enum.BusinessTransactions.PostingOfReleaseTargetCost)
	|		OR AdjustmentTable.CostAccountingTransaction = VALUE(Enum.CostAccountingTransactions.DisposalAtFixedCost)
	|	 		AND (AdjustmentTable.AccountingSection IN (&BalanceSectionsOfAccounting)
	|				OR AdjustmentTable.InventoryType = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider))
	|	)
	// Positive amounts of deviation in value or negative amounts of deviation for Reverse movements will be Attributed to OtherExpenses.
	|	AND (CASE 
	|		WHEN SignIsReversed * (Cost + AddExpensesForGoods + LaborCosts + ItemizedFixedCostsIncludingVAT + ItemizedVariableCostsIncludingVAT) >= 0
	|			OR SignIsReversed * (CostExcludingVAT + AdditionalExpensesExcludingVAT + LaborCosts + ItemizedFixedCostsExcludingVAT + ItemizedVariableCostsExcludingVAT) >= 0
	|			OR SignIsReversed * (LocalCost + AddExpensesLocal + LaborCostsLocal + ItemizedFixedCostsCompl + ItemizedVariableCostsCompl + ProvisionForImpairmentLocal) >= 0
	|			OR SignIsReversed * (CostMan + AddExpensesMan + LaborCostsMan + ItemizedFixedCostsManag + ItemizedVariableCostsManag + ProvisionForImpairmentMan) >= 0
	|			OR SignIsReversed * OffBalanceCost > 0
	|			OR SignIsReversed * OffBalanceCostLocal > 0
	|			OR SignIsReversed * CostOfPersonalIncomeTax > 0
	|				THEN TRUE
	|		ELSE FALSE END)
	|
	|INDEX BY
	|	BusinessOperation
	|;
	|";
	
	#EndRegion
	
	Return TrimAll(QueryText);
	
EndFunction

Procedure GenerateTotalCostOfGoodsWithRequest(CalculationParameters, MatchingTemporaryMovementTables)
	
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	TempTableName = "TTCostOfGoods_";
	
	// The Cor. cost is not included in the list of fields.
	CopiedFields = "
	|Period, ItemsLocationAttributes, AccountingSection, InventoryOwnerAttribute, Organization,
	|BusinessOperation, DocumentCalculation,
	|CorItemsLocationAttributes, CorAccountingSection, CorInventoryOwnerAttribute,CorCompany,
	|AccountingDimensionByPartners, SalesOrder,
	|Department, DimensionOfExpenses, ExpenseItemOfWriteOff, IncomeItem, DimensionOfRevenue,
	|AssetAndLiabilityItem, AssetsLiabilitiesDimension,
	|RowID, RowCode, DocumentRegisterRecords, SalePeriod, ProductsGroup,
	|CorLineOfBusiness,
	|Cost, CostExcludingVAT, OffBalanceCost, AddExpensesForGoods, AdditionalExpensesExcludingVAT,
	|PermanentDifference, CostTD, LocalCost, OffBalanceCostLocal,
	|CostOfPersonalIncomeTax,
	|CorLot, LotVendorAttributesCorr, CorControllingAttributes, CorVATActivityTypes,
	|VATLocal, VATManag, ProductCostElement, EntryType, DocumentSource, ReversingEntry,
	|BusinessTransactionSetting, FinRecordID, GLAccountSettings, CalculationIsNotCompleted,
	|CostAccountingTransaction, CostDefiningMethod
	|";
	
	If CalculationParameters.BatchAccountingVersion22 Then
		CopiedFields = CopiedFields + ",
		|Lot, LotVendorAttributes, FinancialAccountingDimension, VATActivityType,
		|LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT,
		|AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl,
		|ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, ItemizedVariableCostsCompl,
		|CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag,
		|ProvisionForImpairmentLocal, ProvisionForImpairmentMan,
		|";
	EndIf;

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentLocal",
	"CASE
	|	WHEN NOT WriteOffReserves THEN ProvisionForImpairmentLocal
	|	ELSE 0
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentMan",
	"CASE
	|	WHEN NOT WriteOffReserves THEN ProvisionForImpairmentMan
	|	ELSE 0
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "RecordType");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateRegisteredRecordsCostOfGoodsWriteOffReservesByRequest(CalculationParameters, MatchingTemporaryMovementTables)
	
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	TempTableName = "TTCostOfGoodsReserves";
	
	CopiedFields = "
	|Period, ItemsLocationAttributes, AccountingSection, InventoryOwnerAttribute, Organization,
	|BusinessOperation, DocumentCalculation,
	|CorItemsLocationAttributes, CorInventoryOwnerAttribute, CorCompany,
	|AccountingDimensionByPartners, SalesOrder,
	|Department, DimensionOfExpenses, ExpenseItemOfWriteOff, IncomeItem, DimensionOfRevenue,
	|AssetAndLiabilityItem, AssetsLiabilitiesDimension,
	|RowID, RowCode, DocumentRegisterRecords, SalePeriod, ProductsGroup,
	|CorLineOfBusiness,
	|CorLot, LotVendorAttributesCorr, CorControllingAttributes, CorVATActivityTypes,
	|ProductCostElement, EntryType, DocumentSource, ReversingEntry,
	|BusinessTransactionSetting, FinRecordID, GLAccountSettings,
	|CostAccountingTransaction, CostDefiningMethod,
	|Lot, LotVendorAttributes, FinancialAccountingDimension, VATActivityType,
	|ProvisionForImpairmentLocal, ProvisionForImpairmentMan
	|";
	
	If CalculationParameters.RegisterRecords.Property(RegisterName) Then
		ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	Else
		ReceiverDescription = CalculationParameters.AuxiliaryTemporaryTables[RegisterName];
	EndIf;
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorAccountingSection", "
	|CASE
	|	WHEN BusinessOperation IN (
	|			VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany),
	|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
	|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
	|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
	|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
	|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5)
	|			)
	|		THEN UNDEFINED
	|	ELSE
	|		CorAccountingSection
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentLocal",
	"CASE
	|	WHEN WriteOffReserves THEN ProvisionForImpairmentLocal
	|	ELSE 0
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProvisionForImpairmentMan",
	"CASE
	|	WHEN WriteOffReserves THEN ProvisionForImpairmentMan
	|	ELSE 0
	|END");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "0");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "RecordType");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessOperation",
	"CASE
	|	WHEN RestoreReserves THEN VALUE(Enum.BusinessTransactions.ReverseProvisionsForImpairmentOfInventory)
	|	ELSE VALUE(Enum.BusinessTransactions.WriteOffOfInventoryImpairmentProvision)
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting",
	"CASE
	|	WHEN RestoreReserves THEN VALUE(Catalog.BusinessTransactionsSettings.ReverseProvisionsForImpairmentOfInventory)
	|	ELSE VALUE(Catalog.BusinessTransactionsSettings.WriteOffOfInventoryImpairmentProvision)
	|END");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ExpenseItemOfWriteOff",
	"CASE
	|	WHEN RestoreReserves THEN UNDEFINED
	|	ELSE ExpenseItemOfWriteOff
	|END");
	
	ConditionWHERE = "
	|	WriteOffReserves
	|	AND (ProvisionForImpairmentLocal <> 0 OR ProvisionForImpairmentMan <> 0)
	|";
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName,
		"RegisteredRecordsAdjustmentTable", TempTableName, ConditionWHERE);
	
	MatchingTemporaryMovementTables.Insert(TempTableName, RegisterName);
	
EndProcedure

Procedure GenerateCorCostOfGoodsByRequest(CalculationParameters, MatchingTemporaryMovementTables)
	
	RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name;
	TempTableName = "TTCostOfGoods_Balanced";
	
	CopiedFields = "
	|Period, DocumentRegisterRecords, RowID, ReversingEntry,
	|Department, ProductsGroup, DocumentCalculation,
	|Cost, OffBalanceCost, CostExcludingVAT, AddExpensesForGoods, AdditionalExpensesExcludingVAT,
	|LocalCost, OffBalanceCostLocal, PermanentDifference, CostTD,
	|CostOfPersonalIncomeTax,
	|FinRecordID, GLAccountSettings,
	|CostAccountingTransaction, CostDefiningMethod";
	If CalculationParameters.BatchAccountingVersion22 Then
		CopiedFields = CopiedFields + ",
		|ProductCostElement,
		|LaborCosts, ItemizedFixedCostsIncludingVAT, ItemizedFixedCostsExcludingVAT,
		|AddExpensesLocal, LaborCostsLocal, ItemizedFixedCostsCompl,
		|ItemizedVariableCostsIncludingVAT, ItemizedVariableCostsExcludingVAT, ItemizedVariableCostsCompl,
		|CostMan, AddExpensesMan, LaborCostsMan, ItemizedFixedCostsManag, ItemizedVariableCostsManag, VATManag
		|ProvisionForImpairmentLocal, ProvisionForImpairmentMan";
	EndIf;
	
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName);
	
	// Fill in additional motion properties
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "RecordType", "VALUE(AccumulationRecordType.Receipt)");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "TRUE");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ItemsLocationAttributes", "CorItemsLocationAttributes");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AccountingSection", "CorAccountingSection");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "InventoryOwnerAttribute", "CorInventoryOwnerAttribute");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable,
		"BusinessOperation",
		"
		|CASE
		|	WHEN DocumentRegisterRecords REFS Document.ConsumptionReportSubcontractingServicesDeliveredIntercompany
		|			AND CostAccountingTransaction = VALUE(Enum.CostAccountingTransactions.SaleOfGoodsAndServices)
		|			AND AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts)
		|			AND CorCompany REFS Catalog.Companies
		|			AND NOT CorCompany = VALUE(Catalog.Companies.EmptyRef)
		|		THEN BusinessOperation
		|	ELSE 
		|		ParishEconomicOperation
		|END
		|");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "EntryType", "ParishRecordType");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "BusinessTransactionSetting", "ArrivalSettingUpBusinessOperation");
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "MonthEndClosingMode", "&MonthEndClosingMode");
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Organization", 
			"CASE 
			|	WHEN CorCompany IS NULL OR CorCompany = UNDEFINED 
			|		OR CorCompany = VALUE(Catalog.Companies.EmptyRef) THEN 
			|		Organization 
			|	ELSE 
			|		CorCompany 
			|END"); 
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Count", "0");
	
	If CalculationParameters.BatchAccountingVersion22 Then
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Lot", "CorLot");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotVendorAttributes", "LotVendorAttributesCorr");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "FinancialAccountingDimension", "CorControllingAttributes");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "VATActivityType", "CorVATActivityTypes");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorVATActivityTypes", "VATActivityType");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorControllingAttributes", "
		|CASE 
		|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease) THEN
		|		CASE 
		|			WHEN FinancialAccountingDimension REFS Catalog.AnalyticalInventoryGroups THEN
		|				FinancialAccountingDimension
		|			ELSE
		|				VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef)
		|		END
		|	ELSE
		|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "FinancialAccountingDimension") + "
		|END");
				
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "ProductsGroup", "
		|CASE 
		|	WHEN BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease)
		|	 AND EntryType <> VALUE(Enum.LotRecordTypes.ProductionIssue) THEN
		|		CorControllingAttributes
		|	ELSE
		|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "ProductsGroup") + "
		|END");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorItemsLocationAttributes", "
		|CASE 
		|	WHEN DocumentRegisterRecords REFS Document.RecyclableWasteAllocation
		|		AND CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress) THEN
		|		AnalysisOfAccountingForProductRange
		|	ELSE
		|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "ArrivalOfCorAnalyticsAccountingProducts") + "
		|END");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CorControllingAttributes", "
		|CASE 
		|	WHEN DocumentRegisterRecords REFS Document.RecyclableWasteAllocation
		|		AND CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress) THEN
		|		AnalysisOfFinancialAccountingIn
		|	ELSE
		|		" + CostCalculationAppliedAlgorithms.GetRequestFieldValue(FieldDescriptionTable, "FinancialAccountingDimension") + "
		|END");
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "FinRecordID", "
		// In the document "Report to the giver", the expenditure movement in the register of "Cost of goods" corresponds to the register of "In-hand and cost of sales"
		// by the identifier of the fin record and setting up the household account of the transaction by book values.
		// There should be a separate correspondence on the off-balance sheet value.
		// But due to the absence of a separate movement at off-balance sheet cost, the ID of the fin entry in the incoming movement
		// is filled in with a service identifier to disable unnecessary correspondence of incoming and outgoing movement at cost.
		|CASE 
		|	WHEN InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider)
		|	 AND CorInventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider)
		|		THEN &IDOfUnusedFinRecord
		|	WHEN CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.VendorManagedInventoryToRegisterWriteOff)
		|		THEN &IDOfUnusedFinRecord
		|	ELSE
		|		FinRecordID
		|END");
		
	Else // Lotaccounting is disabled or lot accounting is used 2.1.
		
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Lot", "UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotVendorAttributes",
			"VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "FinancialAccountingDimension",
			"UNDEFINED");
		CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "VATActivityType",
			 "VALUE(Enum.VATTaxationTypes.EmptyRef)");
		
	EndIf;
	
	// Amounts in the currency of management accounting.
	
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Cost",
		"CASE
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod))
		|	  OR CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.VendorManagedInventoryToRegisterWriteOff) THEN 0
		|	WHEN ThisIsTransferBetweenOrganizations AND CorCompanyOnMediumSlip THEN 0
		|	ELSE Cost END");
		
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CostExcludingVAT",
		"CASE
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod))
		|	  OR CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.VendorManagedInventoryToRegisterWriteOff) THEN 0
		|	WHEN ThisIsTransferBetweenOrganizations AND CorCompanyOnMediumSlip THEN 0
		|	ELSE CostExcludingVAT END");
		
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AddExpensesForGoods",
		"CASE
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod))
		|	  OR CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.VendorManagedInventoryToRegisterWriteOff) THEN 0
		|	WHEN ThisIsTransferBetweenOrganizations AND CorCompanyOnMediumSlip THEN 0
		|	ELSE AddExpensesForGoods END");
			
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "AdditionalExpensesExcludingVAT",
		"CASE
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.ConsumptionReportSubcontractingServicesDeliveredWriteOffAsExpenses),
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProviderAdjustmentOfPastPeriod))
		|	  OR CorAccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.VendorManagedInventoryToRegisterWriteOff) THEN 0
		|	WHEN ThisIsTransferBetweenOrganizations AND CorCompanyOnMediumSlip THEN 0
		|	ELSE AdditionalExpensesExcludingVAT END");
			
	CostCalculationAppliedAlgorithms.ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LaborCosts",
		"CASE
		|	WHEN BusinessOperation IN (
		|			VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
		|			VALUE(Enum.BusinessTransactions.Subcontracting2_5),
		|			VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
		|			VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
