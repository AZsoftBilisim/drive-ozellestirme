#Region StageProcedures_DistributeDeviationsInCostOfGoods_RegisterRecordedFormation

// The formation of Registered Records for deviations in the cost of goods.
//
// Parameters:
//	CalculationParameters - Structure - cost calculation parameters
//
Procedure DistributeDeviationsInCostOfGoods_FormationOfRegisteredRecorded(CalculationParameters)
	
	ExistingTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters);
	
	#Region MinimumPeriods
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	Query.Text = CostCalculationLESSolution.TextMinimumPeriods();
	
	QueryResult = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,, True);
	Selection = QueryResult.Select();
	
	BeginOfPeriod = CalculationParameters.PayrollPeriod.BeginOfPeriod;
	If Selection.Next() Then
		MinimumPeriod = ?(ValueIsFilled(Selection.MinimumPeriod), Selection.MinimumPeriod, BeginOfPeriod);
	Else
		MinimumPeriod = BeginOfPeriod; 
	EndIf;
	
	AddlParameters = CalculationParameters.AdditionalStageRequestParameters;
	AddlParameters.Insert("MinimumPastPeriod", Min(MinimumPeriod, CalculationParameters.PayrollPeriod.EndOfPreviousPeriod));
	
	#EndRegion
	
	#Region IDsTable
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	Query.Text = "
	|SELECT DISTINCT
	|	T.SourceNodeNumber,
	|	T.ReceiverNodeNumber
	|FROM
	|	DeviationTTCommunication AS T
	|	INNER JOIN AdditionalCostAdjustmentNodes AS SourceNodes
	|		ON SourceNodes.NodeNumber = T.SourceNodeNumber
	|";
	
	IDsTable = New ValueTable;
	IDsTable.Columns.Add("Id", Common.StringTypeDetails(36));
	IDsTable.Columns.Add("SourceNodeNumber", Common.TypeDescriptionNumber(31));
	IDsTable.Columns.Add("ReceiverNodeNumber", Common.TypeDescriptionNumber(31));
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	While Selection.Next() Do
		NewRow = IDsTable.Add();
		NewRow.Id = New UUID;
		NewRow.SourceNodeNumber = Selection.SourceNodeNumber;
		NewRow.ReceiverNodeNumber = Selection.ReceiverNodeNumber;
	EndDo;
	
	Query.Text = "
	|SELECT
	|	IDsTable.Id AS Id,
	|	IDsTable.SourceNodeNumber AS SourceNodeNumber,
	|	IDsTable.ReceiverNodeNumber AS ReceiverNodeNumber
	|
	|INTO IDsTable
	|FROM
	|	&IDsTable AS IDsTable
	|
	|INDEX BY SETS
	|(
	|	(SourceNodeNumber,	ReceiverNodeNumber),
	|	(ReceiverNodeNumber, SourceNodeNumber)
	|)
	|";
	Query.SetParameter("IDsTable", IDsTable);
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	#EndRegion
	
	#Region FormationOfRegisteredRecords
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "DistributeDeviationsInCostOfGoods_FormationOfRegisteredRecorded");
	
	// 1. Initialization of the data structure of the data preparation stage.
	CostCalculationAppliedAlgorithms.InitializeDataPreparationForFollowingSteps(
		CalculationParameters,
		"TTOfRegisteredRecordedDeviation, RegisteredRecordedRevenueTT, TTOtherExpenses, 
		|TTOtherWorkInProgressExpenses, TTRegisteredRecordsOtherAssetsLiabilities");
		
	// 2. Formation of temporary tables.
	CostCalculationAppliedAlgorithms.PrepareDataForFollowingSteps(
		CalculationParameters,
		TextDistributeDeviationsInCostOfGoodsFormationOfRegisteredRecords(CalculationParameters));
		
	// 3. We are completing the data preparation stage. 
	CostCalculationAppliedAlgorithms.CompleteDataPreparationForNextSteps(CalculationParameters);
		
	#EndRegion
	
	MatchingTemporaryMovementTables = New Map;
	
	#Region SavingRegisteredRecords_DeviationsInCostOfGoods
	
	RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	SourceTableName = "TTOfRegisteredRecordedDeviation";
	DestinationTableName = "TTDeviationData";
	
	CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
		CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		SourceTableName,
		DestinationTableName);
	
	MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
	
	#EndRegion
	
	#Region PreservationOfRegisteredRecords_RevenueAndCostOfGoodsSold
	
	RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	SourceTableName = "RegisteredRecordedRevenueTT";
	DestinationTableName = "TT_DataRevenue";
	
	CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
		CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		SourceTableName,
		DestinationTableName);
	
	MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
	
	#EndRegion

	#Region MaintainingRegisteredRecords_OtherExpenses
	
	RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	SourceTableName = "TTOtherExpenses";
	DestinationTableName = "TTDataOtherExpenses";
	
	CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
		CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		SourceTableName,
		DestinationTableName);
	
	MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
	
	#EndRegion

	#Region PreservationOfRegisteredRecords_OtherExpensesOfWorkInProgress
	
	RegisterName = Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	SourceTableName = "TTOtherWorkInProgressExpenses";
	DestinationTableName = "TTDataOtherExpensesOfWorkInProgress";
	
	CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
		CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		SourceTableName,
		DestinationTableName);
	
	MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
	
	#EndRegion

	#Region PreservationOfRegisteredRecords_OtherAssetsLiabilities
	
	RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	SourceTableName = "TTRegisteredRecordsOtherAssetsLiabilities";
	DestinationTableName = "TTDataOtherAssetsLiabilities";
	
	CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
		CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		SourceTableName,
		DestinationTableName);
	
	MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
	
	RegisterName = Metadata.AccumulationRegisters.OtherAssetsAndLiabilitiesRecords.Name;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	SourceTableName = "TTRegisteredRecordsOtherAssetsLiabilities";
	DestinationTableName = "TTRegisteredRecordsForOtherAssetsLiabilities";
	
	CopiedFields = CostCalculationAppliedAlgorithms.GetColumnNamesAsString(
		CostCalculationAppliedAlgorithms.UnloadTemporaryTable(CalculationParameters, SourceTableName, 0));
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(CopiedFields, "");
	
	FieldDescriptionTable = CostCalculationAppliedAlgorithms.GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	CostCalculationAppliedAlgorithms.CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CostCalculationAppliedAlgorithms.MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		SourceTableName,
		DestinationTableName);
	
	MatchingTemporaryMovementTables.Insert(DestinationTableName, RegisterName);
	
	#EndRegion

	CostCalculationAppliedAlgorithms.CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables);
	
	NewTT = CostCalculationAppliedAlgorithms.GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	CostCalculationAppliedAlgorithms.DestroyTemporaryTables(CalculationParameters, NewTT);	
		
EndProcedure

// Request texts

// ... general

Function TextDistributeDeviationsInCostOfGoodsFormationOfRegisteredRecords(CalculationParameters)
	
	TextsOfTTDisposalsForDeviations = New Array;
	TextsOfTTDisposalsForDeviations.Add(TextDescriptionOfDataForTTDisposalsForDeviations()); // TT vtbytyad for worship
	TextsOfTTDisposalsForDeviations.Add(TextOfRegisteredRecordsOfInventoryCostsByPeriod());
	TextsOfTTDisposalsForDeviations.Add(TextWriteOffOfDeviationsToCostOfGoodsSold());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfDeviationsToBalancesMediumSlip());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfExpensesForProductionLotReferences()); // Uses vtmovementprochierachievementoperiod, the table of resolutionprochierachievementdetally
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfExpensesForProductionLotReferencesCurrentPeriod());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfOutputCostsForCurrentPeriod());
	TextsOfTTDisposalsForDeviations.Add(TextDistributionOfExpensesForInventoryCostsLastPeriod());
	TextsOfTTDisposalsForDeviations.Add(TextOfStornoRegisteredRecordsForCorrectionsOfPreviousPeriodIsMediumSliding());
	TextsOfTTDisposalsForDeviations.Add(TextTransferOfRemainingDeviationsToCurrentPeriodAverageSliding());
	TextsOfTTDisposalsForDeviations.Add(TextCorrectionOfDeviationsThatDoNotCorrespondToCostIsMediumSlip());
	TextsOfTTDisposalsForDeviations.Add(TextCorrectionOfDeviationsThatDoNotCorrespondToOtherExpenses());
	TextOfTTOfWithdrawalForDeviations = StrConcat(TextsOfTTDisposalsForDeviations, Common.UnionAllText());
	TextOfTTOfWithdrawalForDeviations = TextOfTTOfWithdrawalForDeviations + "
	|INDEX BY
	|	SourceNodeNumber
	|";
	
	QueriesTexts = New Array;
	QueriesTexts.Add(TextIsInitialCostOfVConstantDifferenceCostPD()); // TT is the initial value of a constantresult
	QueriesTexts.Add(TextTableOfSolutionsInDetailMediumSliding()); // TableOfSolutionsInDetail
	QueriesTexts.Add(TextTableOfSolutionsOtherExpensesInDetailMediumSlip()); // TT of the resolution tablereferencesexternal links
	
	QueriesTexts.Add(TextTTIssues()); // TTIssues
	
	QueriesTexts.Add(TextTTIsIrrelevantToRegisteredRecordsPreliminary()); // TTIrrelevantRegisteredRecordsPreliminary
	QueriesTexts.Add(TextTTIsIrrelevantToRegisteredRecords()); // TTIrrelevantRegisteredRecords
	QueriesTexts.Add(TextTTOfIrrelevantRegisteredRecordsOtherExpensesPreliminary()); // TTIrrelevantRegisteredRecordsOtherExpensesPreliminary
	QueriesTexts.Add(TextTTOfIrrelevantRegisteredRecordsOtherExpenses()); // TTIrrelevantRegisteredRecordsOtherExpenses
	QueriesTexts.Add(TextOfTTOfWithdrawalForDeviations); // TTDisposalsForDeviations
	QueriesTexts.Add(TextOfTTOfRegisteredRecordedDeviation()); // TTOfRegisteredRecordedDeviation
	QueriesTexts.Add(TextOfRegisteredRecordedRevenueTT()); // RegisteredRecordedRevenueTT
	QueriesTexts.Add(TextTTOfRegisteredRecordedOtherExpenses()); // TTOtherExpenses
	QueriesTexts.Add(TextOfTTRegisteredRecordsOtherAssetsLiabilities()); // TTRegisteredRecordsOtherAssetsLiabilities
	
	QueriesTexts.Add(TextTTOfRegisteredRecordedOtherExpensesOfWorkInProgress()); // TTOtherWorkInProgressExpenses
	
	QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());	
	If CalculationParameters <> Undefined Then
		QueryText = SetBitDepthOfNumbersInRequestText(CalculationParameters, QueryText);
	EndIf;
	
	Return QueryText;
	
EndFunction	

