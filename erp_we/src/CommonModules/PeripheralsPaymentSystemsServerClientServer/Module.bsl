
#Region Public

// Fills in the structure of the map parameters. 
//
// Returns:
//  Structure
Function MapParameters() Export;
	
	Result = New Structure();
	
	Result.Insert("FromLastOperation");
	Result.Insert("CardNumber");    // String - Masked card number.
	Result.Insert("HashCardNumber"); // String - PAN cards are hashed using the SHA256 algorithm. 
	Result.Insert("CardType");      // String - Card type (VISA,MasterCard).
	Result.Insert("OwnMap");     // Boolean - Bank card that provides acquiring services.
	
	Return Result;
	
EndFunction

// Fills in the structure of getting map parameters.
//
// Returns:
//  Structure
//
Function ParametersGettingMapParameters() Export;
	
	Result = New Structure();
	Result.Insert("FromLastOperation", False); 
	Result.Insert("QrCardAttributes"); // string,optional - scanned qr code from the cardholder's mobile device, which contains the emv Attributes of the card or token.  
	Return Result;
	
EndFunction

// Fills in the structure of parameters for executing an acquiring operation.
//
// Returns:
//  Structure
//
Function ParametersOfAcquiringOperation() Export;
	
	Result = New Structure();
	Result.Insert("DocumentBasis");// String,Optional - Definable type.The basis of the fiscal operationibpo.
	Result.Insert("TransactionType");    // String,Required - Transaction type.   
	Result.Insert("QrCardAttributes"); // string,optional - scanned qr code from the cardholder's mobile device, which contains the emv Attributes of the card or token.  
	Result.Insert("TransactionAmount", 0); // Number, Required - The amount of the operation.     
	Result.Insert("AmountOfOriginalTransaction", 0); // A number, Optionally the sum of the original operation.     
	Result.Insert("AmountOfCash", 0); // Number, Optional - The amount of cash issued.
	Result.Insert("MerchantSNumber");    // Integer, Optional - The merchant's number available for this acquiring terminal.
	Result.Insert("CardNumber");       // String, Optional - Masked card number.
	Result.Insert("ReceiptNumber");        // String, Optional - Receipt number.
	Result.Insert("POSTerminalReceiptNumber");      // String,Optional - The receipt number of the acquiring terminal.
	Result.Insert("ReferenceNumber");   // String,Optional - Unique transaction code RRN.
	Result.Insert("AuthorizationCode");   // String,Optional - Transaction authorization code.
	Result.Insert("SlipReceiptText");    // String,Optional - The text of the receipt generated by the Acquiring Software.  
	Result.Insert("UseBiometrics", False); // Boolean,Optional - It is allowed to use biometrics of operation.
	Result.Insert("TypeOfPaymentAtTerminalCode", 0);  // Number, Optional - the code of the type of payment at the terminal.
	Result.Insert("PaymentKindOnTerminal");        // Enumeration.Type of payment in the terminal, Optional - Type of payment at the terminal.
	// Parameters for performing an acquiring of operation with an electronic certificate.
	Result.Insert("AmountOfElectronicCertificate", 0); // Number, Required - The amount of the operation due to electronic certificates.
	Result.Insert("AmountOfOwnFunds"    , 0);  // Number, Required - The amount of the operation at the expense of own funds on the card.
	Result.Insert("CartID");            // String,Optional - Basket ID is passed – A unique identifier of the operation in the FES NSPK.        
	// Basket ID of the payment operation in the FES NSPK. Required for a refund operation without a card within the Cur business day.
	Result.Insert("IdOfPaymentTransactionBucket"); // String,Optional -Basket ID of the payment Operation in the FES NSPK.      
	Result.Insert("QueryID");             // String,Optional - Unique identifier of the request to the acquiring terminal.
	Result.Insert("FiscalTransactionID");  // String,Optional - Unique identifier of the fiscal transaction.
	Result.Insert("UsePrintingDevice", True);  // Boolean,Optional - defines the use of the printing device when performing a fiscal Operation.
	// Extension
	Result.Insert("HashCardNumber"); // A string, Optionally a PAN card hashed using the SHA256 algorithm. 
	Return Result;
	
EndFunction

// Fills in the structure of the parameters of the acquisition operation performed.
//
// Returns:
//  Structure
//
Function ParametersOfAcquisitionOperationPerformed() Export;
	
	Result = New Structure();
	Result.Insert("TransactionType");    // String,Required - Transaction type.   
	Result.Insert("MerchantSNumber");    // Integer, Optional - The merchant's number available for this acquiring terminal.
	Result.Insert("CardNumber");       // String, Optional - Masked card number.
	Result.Insert("HashCardNumber");    // A string, Optionally a hash of the card number. 
	Result.Insert("TransactionAmount", 0); // Number, Required - The amount of the operation.     
	Result.Insert("AmountOfCash", 0); // Number, Optional - The amount of cash issued.
	Result.Insert("AmountOfElectronicCertificate", 0); // Number, Optional - The amount of the transaction due to electronic certificates.
	Result.Insert("AmountOfOwnFunds"     , 0); // Number, Optional - The amount of the transaction at the expense of own funds on the card.
	Result.Insert("ReferenceNumber");   // String,Optional Reference number.   
	Result.Insert("AuthorizationCode");   // String,Optional Authorization code.           
	Result.Insert("DateTime");        // Date, Optional - Date and time of transaction initialization, contains the local date and time of transaction initialization	   
	Result.Insert("EndCode");    // Number,Optional - Additional End code of operation.     
	Result.Insert("PaymentSystemId");     // String,Optional - Unique identifier of the payment system through which the transaction was performed of operation.   
	Result.Insert("BankTransactionID"); // String,Optional - A unique identifier of a banking transaction generated on the side of the issuing bank.
	
	Return Result;
	
EndFunction

// Checks that the QR code in the Base64 string format is a Consumer-Presented QR 
//
// Parameters:
//  QRCode - String
//
// Returns:
//  Boolean
Function TheseAreQrCardAttributes(Val QRCode) Export
	
	// Functional requirements for the cash terminal module (POI) for transaction processing
	// Checking that the QR code in the Base64 string format starts with "hQVDUFY" (version and format indicator).
	Result = StrStartsWith(QRCode,  "hQVDUFY"); //@NON-NLS-1 @NON-NLS-2
	Return Result;
	
EndFunction

Function TypesOfCashRegisterPaymentSystem() Export
	
	Result = New Map();
	
	Result.Insert("InstantPayments" , PredefinedValue("Enum.TypesOfCashRegisterPaymentSystem.InstantPayments"));
	Result.Insert("NSPKCertificate"         , PredefinedValue("Enum.TypesOfCashRegisterPaymentSystem.NSPKCertificate"));
	Result.Insert("YooKassa"                 , PredefinedValue("Enum.TypesOfCashRegisterPaymentSystem.YooKassa"));
	
	Return Result;
	
EndFunction

// Returns the default slip receipt text  
//
// Parameters:
//  SlipReceiptParameters - Structure - Slip receipt Parameters:
//    * AuthorizationCode - String
//    * CardNumber - String
//    * POSTerminalReceiptNumber - String
//    * ReferenceNumber - String
//    * TransactionAmount - Number
//    * SlipReceiptText - String
//  ShortSlipCheck - Boolean - generate the text of a short slip receipt
// 
// Returns:
//  String - The text of the check slip
//
Function TextOfSlipReceiptByDefault(SlipReceiptParameters, ShortSlipCheck = True) Export
	
	If SlipReceiptParameters.Result Then
		Text = NStr("vi = 'GIAO DỊCH THANH TOÁN';
					|ru = 'ПЛАТЕЖНАЯ ОПЕРАЦИЯ';
					|en = 'PAYMENT TRANSACTION'; fa = 'PAYMENT TRANSACTION';
					|it = 'OPERAZIONE DI PAGAMENTO';
					|pl = 'OPERACJA PŁATNICZA';
					|tr = 'ÖDEME İŞLEMİ'") + Chars.LF;
		Text = Text + StrTemplate(NStr("vi = 'Mã đăng nhập: %1';
										|ru = 'Код авторизации: %1';
										|en = 'Authorization code: %1'; fa = 'Authorization code: %1';
										|it = 'Codice di autorizzazione: %1';
										|pl = 'Kod autoryzacyjny: %1';
										|tr = 'Doğrulama Kodu: %1'"), SlipReceiptParameters.AuthorizationCode) + Chars.LF;
		Text = Text + StrTemplate(NStr("vi = 'Số thẻ: %1';
										|ru = 'Номер карты: %1';
										|en = 'Card number: %1'; fa = 'Card number: %1';
										|it = 'Numero carta: %1';
										|pl = 'Numer karty: %1';
										|tr = 'Kart Numarası: %1'"),     SlipReceiptParameters.CardNumber)     + Chars.LF;
		Text = Text + StrTemplate(NStr("vi = 'Số phiếu trên thiết bị thanh toán thẻ: %1';
										|ru = 'Номер чека ЭТ: %1';
										|en = 'POS terminal receipt number: %1'; fa = 'POS terminal receipt number: %1';
										|it = 'Numero assegno terminale di autorizzazione: %1';
										|pl = 'Numer paragonu TA: %1';
										|tr = 'ET Fiş Numarası: %1'"),   SlipReceiptParameters.POSTerminalReceiptNumber)    + Chars.LF;
		Text = Text + StrTemplate(NStr("vi = 'Số tham chiếu: %1';
										|ru = 'Ссылочный номер: %1';
										|en = 'Reference number: %1'; fa = 'Reference number: %1';
										|it = 'Numero di collegamento: %1';
										|pl = 'Numer referencyjny: %1';
										|tr = 'Referans Numarası: %1'"), SlipReceiptParameters.ReferenceNumber) + Chars.LF;
		If SlipReceiptParameters.Property("TransactionAmount") Then
			Text = Text + StrTemplate(NStr("vi = 'Số tiền: %1';
											|ru = 'Сумма: %1';
											|en = 'Amount: %1'; fa = 'Amount: %1';
											|it = 'Importo: %1';
											|pl = 'Kwota: %1';
											|tr = 'Tutar: %1'"), SlipReceiptParameters.TransactionAmount) + Chars.LF;
		EndIf;
		If Not ShortSlipCheck And SlipReceiptParameters.Property("SlipReceiptText") Then
			Text = Text + SlipReceiptParameters.SlipReceiptText;
		EndIf;
	Else
		Text = NStr("vi = 'GIAO DỊCH BỊ TỪ CHỐI';
					|ru = 'ОПЕРАЦИЯ ОТКЛОНЕНА';
					|en = 'TRANSACTION IS REJECTED'; fa = 'TRANSACTION IS REJECTED';
					|it = 'OPERAZIONE RIFIUTATA';
					|pl = 'OPERACJA ZOSTAŁA ODRZUCONA';
					|tr = 'İŞLEM REDDEDİLDİ'") + Chars.LF;  
		Text = Text + SlipReceiptParameters.ErrorDescription;
	EndIf;
	
	Return Text;    
	
EndFunction

