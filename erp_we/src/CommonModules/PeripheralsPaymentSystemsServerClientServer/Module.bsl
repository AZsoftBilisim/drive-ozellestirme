#Region Private

#If Not WebClient Then

// Get the xmlpackage for the operation.
// 
// Parameters:
//  OperationParametersList - Structure - Parameters
// 
// Returns:
//  String - Get the Xmlpackage for the operation
//
Function GetXMLPacketForOperation(OperationParametersList) Export

	XMLWriter = New XMLWriter();
	XMLWriter.SetString("UTF-8");
	XMLWriter.WriteXMLDeclaration();
	XMLWriter.WriteStartElement("OperationParameters");     
	
	MerchantSNumber  = ?(OperationParametersList.MerchantSNumber <> Undefined, OperationParametersList.MerchantSNumber, 0);

	XMLWriter.WriteAttribute("MerchantNumber", XMLString(MerchantSNumber)); 
	If Not IsBlankString(OperationParametersList.QrCardAttributes) Then
		XMLWriter.WriteAttribute("ConsumerPresentedQR",  XMLString(OperationParametersList.QrCardAttributes)); 
	EndIf;
	
	UseBiometrics = ?(OperationParametersList.UseBiometrics <> Undefined, OperationParametersList.UseBiometrics, False);
	XMLWriter.WriteAttribute("UseBiometrics", ?(UseBiometrics, "1", "0")); 
	
	If Not ValueIsFilled(OperationParametersList.PaymentKindOnTerminal) Then
		TypeOfPaymentToTerminalCode = OperationParametersList.TypeOfPaymentAtTerminalCode;
	Else
		TypeOfPaymentToTerminalCode = PaymentTypeCodeAtTerminal(OperationParametersList.PaymentKindOnTerminal);
	EndIf;
	XMLWriter.WriteAttribute("AuthorizationType", XMLString(TypeOfPaymentToTerminalCode)); 
	
	TransactionAmount  = ?(OperationParametersList.TransactionAmount <> Undefined, OperationParametersList.TransactionAmount, 0);
	XMLWriter.WriteAttribute("Amount", XMLString(TransactionAmount));
	
	AmountOfCash  = ?(OperationParametersList.AmountOfCash <> Undefined, OperationParametersList.AmountOfCash, 0);
	XMLWriter.WriteAttribute("AmountCash", XMLString(AmountOfCash));
	
	AmountOfOriginalTransaction = ?(OperationParametersList.AmountOfOriginalTransaction <> Undefined, OperationParametersList.AmountOfOriginalTransaction, 0);
	XMLWriter.WriteAttribute("AmountOriginalTransaction", XMLString(AmountOfOriginalTransaction));
	
	CardNumber = ?(OperationParametersList.CardNumber <> Undefined, OperationParametersList.CardNumber, "");
	If Not IsBlankString(CardNumber) Then
		XMLWriter.WriteAttribute("CardNumber", XMLString(CardNumber));
	EndIf;         
	
	HashCardNumber = ?(OperationParametersList.HashCardNumber <> Undefined, OperationParametersList.HashCardNumber, "");
	If Not IsBlankString(HashCardNumber) Then
		XMLWriter.WriteAttribute("CardNumberHash", XMLString(HashCardNumber));
	EndIf;         
	
	CartID = ?(OperationParametersList.CartID <> Undefined, OperationParametersList.CartID, "");   
	If Not IsBlankString(CartID) Then
		XMLWriter.WriteAttribute("BasketID", XMLString(CartID));
	EndIf;         
	
	AmountOfElectronicCertificate = ?(OperationParametersList.AmountOfElectronicCertificate <> Undefined, OperationParametersList.AmountOfElectronicCertificate, 0);
	XMLWriter.WriteAttribute("ElectronicCertificateAmount", XMLString(AmountOfElectronicCertificate));

	AmountOfOwnFunds = ?(OperationParametersList.AmountOfOwnFunds <> Undefined, OperationParametersList.AmountOfOwnFunds, 0);
	XMLWriter.WriteAttribute("OwnFundsAmount", XMLString(AmountOfOwnFunds));
	
	ReceiptNumber = ?(OperationParametersList.ReceiptNumber <> Undefined, OperationParametersList.ReceiptNumber, "");
	If Not IsBlankString(ReceiptNumber) Then
		XMLWriter.WriteAttribute("ReceiptNumber", XMLString(ReceiptNumber));
	EndIf;
	
	ReferenceNumber = ?(OperationParametersList.ReferenceNumber <> Undefined, OperationParametersList.ReferenceNumber, "");    
	If Not IsBlankString(ReferenceNumber) Then
		XMLWriter.WriteAttribute("RRNCode", XMLString(ReferenceNumber));
	EndIf;   
	
	AuthorizationCode = ?(OperationParametersList.AuthorizationCode <> Undefined, OperationParametersList.AuthorizationCode, "");
	If Not IsBlankString(AuthorizationCode) Then
		XMLWriter.WriteAttribute("AuthorizationCode", XMLString(AuthorizationCode));
	EndIf;                            
	
	XMLWriter.WriteEndElement();
	Return XMLWriter.Close();
	
EndFunction  

#EndIf

// Payment type code on the terminal.
// 
// Parameters:    
//   PaymentKind_ -  EnumRef.PaymentKindOnTerminal - Type Of Payment At The Terminal
// Returns:
//   Number - Payment Type Code   
//                                
Function PaymentTypeCodeAtTerminal(PaymentKind_) Export    
	
#If Server Or ThickClientOrdinaryApplication Or ExternalConnection Then
	Return PeripheralsPaymentSystemsServer.PaymentTypeCodeAtTerminal(PaymentKind_);
#Else
	Return PeripheralsPaymentSystemsServerClient.PaymentTypeCodeAtTerminal(PaymentKind_);
#EndIf
	
EndFunction    

