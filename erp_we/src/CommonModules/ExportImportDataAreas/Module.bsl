#Region Private

Function ImportCurrentArea(Val Archive, BackupType, RefsMap, ImportParameters)
	
	UploadUsers = ImportParameters.UploadUsers;
	UserMatching = ImportParameters.UserMatching;
	ExtensionData_ = ImportParameters.ExtensionData_;
	SkipExtensionsRestoring = ImportParameters.SkipExtensionsRestoring;
	ResultStorageAddress_ = ImportParameters.ResultStorageAddress_;
	ThreadsCount = ImportParameters.ThreadsCount;
	TotalObjectCount = ImportParameters.TotalObjectCount;
	
	ImportingParametersInternal = New Structure();
	If ImportParameters.StateID <> Undefined Then
		ImportingParametersInternal.Insert("JobKind", ImportParameters.JobKind);
		ImportingParametersInternal.Insert("StateID", ImportParameters.StateID);
	EndIf;
	
	If SkipExtensionsRestoring <> Undefined Then
		ImportingParametersInternal.Insert("SkipExtensionsRestoring", SkipExtensionsRestoring);
	EndIf;
	
	If ResultStorageAddress_ <> Undefined Then
		ImportingParametersInternal.Insert("ResultStorageAddress_", ResultStorageAddress_);
	EndIf;
	
	If ThreadsCount > 0 Then
		ImportingParametersInternal.Insert("ThreadsCount", ThreadsCount);
	EndIf;
	
	If TotalObjectCount > 0 Then
		ImportingParametersInternal.Insert("TotalObjectCount", TotalObjectCount);
	EndIf;
	
	If SaaSOperations.DataSeparationEnabled() Then
		UploadUsers = False;
		UploadUserSettings_ = False;
	Else
		UploadUsers = UploadUsers;
		UploadUserSettings_ = UploadUsers;
	EndIf;
	
	ImportingParametersInternal.Insert("ApplicationKind", ImportParameters.ApplicationKind);
	ImportingParametersInternal.Insert("UploadUsers", UploadUsers);
	ImportingParametersInternal.Insert("UploadUserSettings_", UploadUserSettings_);
	ImportingParametersInternal.Insert("CollapseSeparatedUsers", ImportParameters.CollapseElementsInUsersCatalog);

	If UserMatching <> Undefined Then
		ImportingParametersInternal.Insert("UserMatching", UserMatching);
	EndIf;

	If ExtensionData_ <> Undefined Then
		ImportingParametersInternal.Insert("ExtensionData_", ExtensionData_);
	EndIf;
	
	ImportingParametersInternal.Insert("BackupType", BackupType);
	ImportingParametersInternal.Insert("UserMappingIsRequired", 
		Not BackupType = ExportImportDataInternal.BackupTypeFull());
	
	If RefsMap <> Undefined Then
		ImportingParametersInternal.Insert("RefsMap", RefsMap);
	EndIf;
	
	ImportingParametersInternal.Insert(
		"ClientSessionNumber",
		ExportImportDataInternal.ClientSessionNumberFromParameters(ImportParameters));
	
	ExportImportDataInternal.CheckParametersOfParallelExportImportData(ImportingParametersInternal, True);
	
	Return ExportImportData.DownloadCurAreaDataFromArchive(Archive, ImportingParametersInternal);
	
EndFunction

Procedure PlaceImportingResultInTemporaryStorage(ImportParameters, ImportResult1)
	ResultStorageAddress_ = Undefined;
	If ImportParameters = Undefined 
		Or Not ImportParameters.Property("ResultStorageAddress_", ResultStorageAddress_) Then
		Return;
	EndIf;
	PutToTempStorage(ImportResult1, ResultStorageAddress_);
EndProcedure

