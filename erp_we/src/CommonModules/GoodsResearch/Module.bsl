#Region Other

Function RequestTextAvailableProductProperties(OnlyValidOnes = True, ProductPropertiesAvailable = True, AvailablePropertiesCharacteristics = True)
	
	QueryTexts = New Array();
	
	QueryTexts.Add(
	"SELECT
	|	VALUE(Catalog.ItemKinds.EmptyRef)                             AS Kind,
	|	VALUE(ChartOfCharacteristicTypes.AdditionalAttributesAndInfo.EmptyRef) AS Property
	|WHERE
	|	FALSE
	|");
	
	If ProductPropertiesAvailable Then
		
		// Additional details common to the nomenclature
		QueryTexts.Add(
		"SELECT
		|	ItemKinds.Ref AS Kind,
		|	PropertiesTable.Property AS Property
		|FROM
		|	Catalog.ItemKinds AS ItemKinds
		|		INNER JOIN Catalog.AdditionalAttributesAndInfoSets.AdditionalAttributes AS PropertiesTable
		|		ON TRUE
		|WHERE
		|	ItemKinds.Ref IN (&ItemKinds)
		|	AND PropertiesTable.Ref = &Set_Catalog_Products_Overall
		|	AND &OnlyValidOnes");
		
		// Additional details of the type of nomenclature
		QueryTexts.Add(
		"SELECT
		|	ItemKinds.Ref AS Kind,
		|	PropertiesTable.Property AS Property
		|FROM
		|	Catalog.ItemKinds AS ItemKinds
		|		INNER JOIN Catalog.AdditionalAttributesAndInfoSets.AdditionalAttributes AS PropertiesTable
		|		ON ItemKinds.PropertiesSet = PropertiesTable.Ref
		|WHERE
		|	ItemKinds.Ref IN (&ItemKinds)
		|	AND &OnlyValidOnes");
		
	EndIf;
	
	If AvailablePropertiesCharacteristics Then
	
		// Additional details are common to all characteristics
		QueryTexts.Add(
		"SELECT
		|	ItemKinds.Ref AS Kind,
		|	PropertiesTable.Property AS Property
		|FROM
		|	Catalog.ItemKinds AS ItemKinds
		|		INNER JOIN Catalog.AdditionalAttributesAndInfoSets.AdditionalAttributes AS PropertiesTable
		|		ON TRUE
		|WHERE
		|	ItemKinds.Ref IN (&ItemKinds) 
		|	AND ItemKinds.UseCharacteristics
		|	AND PropertiesTable.Ref = &Set_Catalog_ItemsCharacteristics_Overall
		|	AND &OnlyValidOnes");
		
		// Additional details of the characteristics of the type of nomenclature
		QueryTexts.Add(
		"SELECT
		|	ItemKinds.Ref AS Kind,
		|	PropertiesTable.Property AS Property
		|FROM
		|	Catalog.ItemKinds AS ItemKinds
		|		INNER JOIN Catalog.AdditionalAttributesAndInfoSets.AdditionalAttributes AS PropertiesTable
		|		ON (CASE
		|				WHEN ItemKinds.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
		|					THEN ItemKinds.ItemVariantsOwner.CharacteristicsPropertySet
		|				ELSE ItemKinds.CharacteristicsPropertySet
		|			END = PropertiesTable.Ref)
		|WHERE
		|	ItemKinds.Ref IN(&ItemKinds)
		|	AND &OnlyValidOnes");
	
	EndIf;
	
	QueryText = StrConcat(QueryTexts, Chars.LF + " UNION " + Chars.LF);
	
	If OnlyValidOnes Then
		QueryText = StrReplace(QueryText, "AND &OnlyValidOnes", "AND NOT PropertiesTable.DeletionMark");
	Else
		QueryText = StrReplace(QueryText, "AND &OnlyValidOnes", "");
	EndIf;
	
	QueryText = StrReplace("
	|SELECT
	|	T.Kind                                     AS Kind,
	|	T.Property                                AS Property,
	|	PRESENTATION(T.Property)                 AS Presentation,
	|	T.Property.ValueType                    AS ValueType,
	|	T.Property.AdditionalValuesOwner AS AdditionalValuesOwner,
	|	T.Property.DeletionMark                AS DeletionMark,
	|	&IdentifierExpression                  AS Id
	|FROM
	|	&QueryText AS T", "&QueryText", "(" + QueryText + ")");
	
	MDAdditionalBankingDetails = Metadata.ChartsOfCharacteristicTypes.AdditionalAttributesAndInfo;
	IdentifierExpression = ProcessingOfFormulas.ExpressionOfFullFeatureID(MDAdditionalBankingDetails, False);
	IdentifierExpression = StrReplace(IdentifierExpression, "%TableName%", "T.Property");
	QueryText = StrReplace(QueryText, "&IdentifierExpression", IdentifierExpression);
	
	Return QueryText;
	
EndFunction

// Returns whether to use series for items
//
// Parameters:
//  Products - DefinedType.Products, Undefined - Link to the item item.
//  
// Returns:
//  Boolean - indicates whether the series is used for the item.
//
Function UsingSeries(Products) Export
	
	Use = False;
	If Not GetFunctionalOption("UseItemsBatch") Then
		Use = False;
	ElsIf Products = Undefined Then
		Use = True;
	ElsIf Not ValueIsFilled(Products) Then
		Use = False;
	Else
		Query = New Query;
		Query.SetParameter("Products", Products);
		Query.Text = "
		|SELECT
		|	CASE
		|		WHEN
		|			Products.BatchOwner <> VALUE(Catalog.ItemKinds.EmptyRef)
		|		THEN
		|			Products.BatchOwner.KeepAccountingByBatch
		|		WHEN
		|			Products.ProductKind <> VALUE(Catalog.ItemKinds.EmptyRef)
		|		THEN
		|			Products.ProductKind.KeepAccountingByBatch
		|		ELSE
		|			FALSE
		|	END AS IndicationOfUseOfBatches
		|FROM
		|	Catalog.Products AS Products
		|WHERE
		|	Products.Ref = &Products
		|	AND Products.ProductKind.BatchAccountingPolicies.BatchAccountingPolicy.PolicyType <> VALUE(Enum.TypesOfBatchSpecificationPolicies.ReferenceBatchSpecification)";
		
		Selection = Query.Execute().Select();
		Use = False;
		If Selection.Next() Then
			Use = Selection.IndicationOfUseOfBatches;
		EndIf;
	EndIf;
	Return Use;
	
EndFunction

// Returns a list of studies for which no item quality control certificates were issued
//
// Parameters:
//  ListOfStudies - Array of DocumentRef.GoodsQualityResearch - list of studies.
//  RequestForControl - DocumentRef.RequestForGoodsQualityControl
//  
// Returns:
//  Array of DocumentRef.GoodsQualityResearch
//
Function ListOfStudiesWithCompletedQualityControlCertificates(ListOfStudies, RequestForControl) Export

	Query = New Query;
	Query.SetParameter("ListOfStudies", ListOfStudies);
	Query.SetParameter("DocumentBasis", RequestForControl);
	Query.Text =
	"SELECT DISTINCT
	|	GoodsQualityControlCertificateResearchResults.ResearchProject AS ResearchProject
	|INTO ResearchInExistingActsOfControl
	|FROM
	|	Document.GoodsQualityControlCertificate.ResearchResults AS GoodsQualityControlCertificateResearchResults
	|WHERE
	|	GoodsQualityControlCertificateResearchResults.Ref.DocumentBasis = &DocumentBasis
	|	AND GoodsQualityControlCertificateResearchResults.Ref.Posted = TRUE
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResearchInExistingActsOfControl.ResearchProject AS ResearchProject
	|FROM
	|	ResearchInExistingActsOfControl AS ResearchInExistingActsOfControl
	|WHERE
	|	ResearchInExistingActsOfControl.ResearchProject IN (&ListOfStudies)";

	Return Query.Execute().Unload().UnloadColumn("ResearchProject");

EndFunction

// Returns a list of studies created based on the Control Request
//
// Parameters:
//  RequestForControl - DocumentRef.RequestForGoodsQualityControl
//  
// Returns:
//  Array of DocumentRef.GoodsQualityResearch
//
Function ListOfStudiesOnApplicationForControl(RequestForControl) Export
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	GoodsQualityResearch.Ref AS Ref
	|FROM
	|	Document.GoodsQualityResearch AS GoodsQualityResearch
	|WHERE
	|	GoodsQualityResearch.RequestForControl = &ControlRequests
	|	AND GoodsQualityResearch.Completed = TRUE
	|	AND GoodsQualityResearch.Posted = TRUE";
	
	Query.SetParameter("ControlRequests", RequestForControl);
	
	Return Query.Execute().Unload().UnloadColumn("Ref");

EndFunction

// Calculates the current State of the quality control application
//
// Parameters:
//	RequestForGoodsQualityControl - DocumentRef.RequestForGoodsQualityControl - Document whose state needs to be calculated
//  
// Returns:
//  EnumRef.StatesOfResearchRequests
//
Function CalculateStateOfControlApplication(RequestForGoodsQualityControl) Export
	
	StateOfApplication = Enums.StatesOfResearchRequests.EmptyRef();
	
	If ValueIsFilled(RequestForGoodsQualityControl) Then
	
		SetPrivilegedMode(True);
		
		QueryText = "SELECT
		|	CASE
		|		WHEN NOT DocumentRequestForGoodsQualityControl.Posted
		|			THEN VALUE(Enum.StatesOfResearchRequests.EmptyRef)
		|		ELSE ISNULL(RequestStatesForQualityControl.State,
		|			VALUE(Enum.StatesOfResearchRequests.Completed_))
		|	END AS State
		|FROM
		|	Document.RequestForGoodsQualityControl AS DocumentRequestForGoodsQualityControl
		|		LEFT JOIN InformationRegister.RequestStatesForQualityControl AS RequestStatesForQualityControl
		|		ON RequestStatesForQualityControl.Request = DocumentRequestForGoodsQualityControl.Ref
		|WHERE
		|	DocumentRequestForGoodsQualityControl.Ref = &RequestForGoodsQualityControl";
		
		Query = New Query;
		Query.Text = QueryText;
		
		Query.SetParameter("RequestForGoodsQualityControl", RequestForGoodsQualityControl);
		
		Selection = Query.Execute().Select();
		If Selection.Next() Then
			StateOfApplication = Selection.State;
		EndIf;
		
	EndIf;
	
	Return StateOfApplication
	
EndFunction

// Returns a list of quality indicators for the specified type of verification selected from product research maps.
// The first 7 unique values are selected by descending date.
// 
// Parameters:
//   CheckKind - String - type of verification for selecting quality indicators
//
// Returns:
//   ValueList of String - List of quality indicators
Function IndicatorGetSelectionList(CheckKind) Export
	
	ChoiceList = New ValueList;
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT TOP 7
	|	GoodsResearchSheets.QualityIndicator AS QualityIndicator,
	|	GoodsResearchSheets.Ref.Date AS Date
	|FROM
	|	Catalog.GoodsResearchSheets.Checks AS GoodsResearchSheets
	|WHERE
	|	GoodsResearchSheets.CheckKind = &CheckKind
	|
	|ORDER BY
	|	Date DESC";

	Query.SetParameter("CheckKind", CheckKind);
	Selection = Query.Execute().Select();

	While Selection.Next() Do
		ChoiceList.Add(Selection.QualityIndicator);
	EndDo;

	Return ChoiceList;
	
EndFunction

