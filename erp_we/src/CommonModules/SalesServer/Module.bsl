// Returns the largest of the advance dates in the PM line payment Stages
//
// Parameters:
//	PaymentScheduleSteps - FormDataCollection - the stages of payment, in which you want to calculate the date of the advance.
//
// Returns:
//	Date - The maximum advance date, if there are no advance dates, is an empty date.
//
Function MaximumAdvancePaymentDate(PaymentScheduleSteps) Export
	
	MaxAdvanceDate = '00010101';
	
	For Each CurStage In PaymentScheduleSteps Do
		
		If CurStage.PaymentOption = Enums.CustomerPaymentControlOptions.PrepaymentBeforeShipment
			Or CurStage.PaymentOption = Enums.CustomerPaymentControlOptions.PrepaymentBeforeProvision Then
			
			MaxAdvanceDate = Max(MaxAdvanceDate, CurStage.PaymentDate);
			
		EndIf;
		
	EndDo;

	Return MaxAdvanceDate;
	
EndFunction

// Creating an address selection list for a form element based on the recipient's contact information.
//
// Parameters:
//  AddressItem - FormField - field to fill in the list of addresses in the selection list.
//  AddresseeLink - CatalogRef.Companies, CatalogRef.Partners - link to the information security object for getting addresses.
//  ClearList_ - Boolean - indicates that the list must be cleared before filling in.
//  Date - Date
//
Procedure FillInAddressSelectionList(AddressItem, AddresseeLink, ClearList_ = True, Date = Undefined) Export
	
	If ClearList_ Then
		AddressItem.ChoiceList.Clear();
	EndIf;
	
	ObjectsArray = New Array;
	ObjectsArray.Add(AddresseeLink);
	
	Addresses = ContactsManager.ObjectsContactInformation(
		ObjectsArray, 
		Enums.ContactInformationTypes.Address,
		,
		Date);
	
	For Each Address In Addresses Do
		AddressItem.ChoiceList.Add(Address.Presentation, String(Address.Kind) + ": " + Address.Presentation);
	EndDo;
	
EndProcedure

// Re-fills the invoice for orders
//
// Parameters:
// 		Object - FormDataStructure - refillable invoice.
//
// Returns:
// 		Boolean - "True" if the invoice is overfilled.
//
Function ReFillInvoiceForOrders(Object) Export
	
	RefType = TypeOf(Object.Ref);
	
	ThisIsImplementation =
		Not RefType = Type("DocumentRef.TransferOfGoodsToBailee")
		And Not RefType = Type("DocumentRef.GoodsShipmentFromStorage")
		And Not RefType = Type("DocumentRef.GoodsShipmentToCustomer");
		
	InvoiceManager = Common.ObjectManagerByRef(Object.Ref);
	TableOfShipmentOrders = Object.Goods.Unload(,"SalesOrder");
	
	ArrayOfShipmentOrders = TableOfShipmentOrders.UnloadColumn("SalesOrder");
	ArrayOfShipmentOrders.Add(Object.Ref);
	
	ShipmentStatus = GetStateOfActualShipment(ArrayOfShipmentOrders);
	
	If Not ShipmentStatus.ThereAreShippedGoods Then
		Text = NStr("vi = 'Chưa bắt đầu giao hàng theo chứng từ này!';
					|ru = 'По данному документу не начата отгрузка!';
					|en = 'Shipment has not started for this document.'; fa = 'Shipment has not started for this document.';
					|it = 'Secondo questo documento la fase spedizione non è cominciata!';
					|pl = 'W niniejszym dokumencie, nie rozpoczęto wysyłki!';
					|tr = 'Bu belge için sevkiyat başlatılmadı!'");
		CommonClientServer.MessageToUser(Text);
		Return New Structure("HasChanges, ShipmentStatus", False, ShipmentStatus);
	EndIf;
	
	StructureOfActionsWithModifiedStrings = New Structure;
	StructureOfActionsWithModifiedStrings.Insert("RecalculateAmount");
	
	ThereAreAttributesToReturnMultiTurnContainer = CommonClientServer.HasAttributeOrObjectProperty(Object, "ToReturnReusablePackage");
	If ThisIsImplementation Then
		StructureOfRecalculationOfAmount = BatchProcessingOfTablePartClientServer.ParametersForConvertingAmountOfNDSVToTS(Object);
		NamesOfDependentProps = "Sum,VATAmount,AmountIncludingVAT" + ?(ThisIsImplementation, ",DiscountMarkupAmount,ManualDiscount", "");
		DependentDetails = New Structure("WithoutReusablePackages", NamesOfDependentProps);
	
		StructureOfActionsWithModifiedStrings.Insert("RecalculateVATAmount", StructureOfRecalculationOfAmount);
		StructureOfActionsWithModifiedStrings.Insert("RecalculateAmountWithVAT", StructureOfRecalculationOfAmount);
	
		StructureOfActionsWithModifiedStrings.Insert("RecalculateAmountTakingIntoAccountManualDiscount", New Structure("Clear", False));
		StructureOfActionsWithModifiedStrings.Insert("RecalculateAmountTakingIntoAccountAutomaticDiscount",
								New Structure("Clear", True));
		StructureOfActionsWithModifiedStrings.Insert("FillInDuplicateDependentDetails", DependentDetails);
		StructureOfActionsWithModifiedStrings.Insert("ClearAmountOfSettlements");
			
		If ThereAreAttributesToReturnMultiTurnContainer Then
			StructureOfActionsWithModifiedStrings.Insert("FillInNoReturnContainerAttribute", Object.ToReturnReusablePackage);
		EndIf;
	EndIf;
	
	StructureOfActionsWithAddedStrings = New Structure;
	StructureOfActionsWithAddedStrings.Insert("FillInProductTypeAttribute_", New Structure("Products", "ItemsType"));
	StructureOfActionsWithAddedStrings.Insert("FillInDuplicateDependentDetails", DependentDetails);
	StructureOfActionsWithAddedStrings.Insert("FillInFeatureAttribute",
		New Structure("Products", "ItemVariantsAreUsed"));
	StructureOfActionsWithAddedStrings.Insert("FillInArticleAttribute", New Structure("Products", "SKU"));
	
	If ThereAreAttributesToReturnMultiTurnContainer Then
		StructureOfActionsWithAddedStrings.Insert("FillInNoReturnContainerAttribute", Object.ToReturnReusablePackage);
	EndIf;
	
	If ThisIsImplementation Then
		If ThereAreAttributesToReturnMultiTurnContainer Then
			StructureOfActionsWithAddedStrings.Insert("FillInVATRateForReturnableContainers", Object.ToReturnReusablePackage);
		EndIf;
		StructureOfActionsWithAddedStrings.Insert("FillInVATRate",
								BatchProcessingOfTablePartClientServer.ParametersForFillingInVATRate(Object));
		StructureOfActionsWithAddedStrings.Insert("RecalculateAmountOverOrder",
								New Structure("ImplementationReceiptByOrder, PackageDepositIsRequired",
										Object.OrderSales, Object.PackageDepositIsRequired));
	EndIf;
	
	ParametersStructure = SalesServer.StructureOfDocumentToFillInForActualShipment();
	
	FillPropertyValues(ParametersStructure, Object);
	FillPropertyValues(ParametersStructure, ShipmentStatus);
	ParametersStructure.ArrayOfShipmentOrders = ArrayOfShipmentOrders;
	ParametersStructure.OrderIsOrder = ArrayOfShipmentOrders.Count()>0;
	
	ParametersStructure.Insert("StructureOfActionsWithModifiedStrings", StructureOfActionsWithModifiedStrings);
	ParametersStructure.Insert("StructureOfActionsWithAddedStrings", StructureOfActionsWithAddedStrings);
	ParametersStructure.Insert("WarehouseInTablePart", True);
	ParametersStructure.Insert("PaddingLines", True);
	ParametersStructure.Insert("SeriesSpecificationParameters", ProductsServer.SeriesSpecificationParameters(Object, InvoiceManager));;
	
	If Object.Property("OrderSales") Then
		ParametersStructure.Insert("FillWithUnassembledGoods", Not Object.OrderSales);
	ElsIf Object.Property("TransferByOrders") Then
		ParametersStructure.Insert("FillWithUnassembledGoods", Not Object.TransferByOrders);
	Else
		ParametersStructure.Insert("FillWithUnassembledGoods", False);
	EndIf;
	
	HasChanges = SalesServer.FillInByActualShipment(Object, ParametersStructure);
	ShipmentStatus.ThereAreUnassembledGoods = ParametersStructure.FillWithUnassembledGoods And ShipmentStatus.ThereAreUnassembledGoods;
	
	Return New Structure("HasChanges, ShipmentStatus", HasChanges, ShipmentStatus);
	
EndFunction

// This function returns the status of the actual document shipment
//
// Parameters:
// 		ShippingDocuments - Array - Links to documents-orders for shipment.
//
// Returns:
// 		Structure:
// 			* ThereAreShippedGoods - Boolean
// 			* ThereAreUnassembledGoods - Boolean
//
Function GetStateOfActualShipment(ShippingDocuments) Export
	
	SetPrivilegedMode(True);
	
	Query = New Query(
	"SELECT
	|	ISNULL(SUM(GoodsForShipmentTurnover.ToShipExpense),0)
	|	+ ISNULL(SUM(GoodsForShipmentTurnover.AssembledReceipt),0)  AS Count,
	|	ISNULL(SUM(GoodsForShipmentTurnover.AssemblyInProgressReceipt),0) AS NumberInProgress
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers( &MinDate, &MaxDate,
	|		, DocumentShipments IN (&ShippingDocuments)) AS GoodsForShipmentTurnover");
	Query.SetParameter("ShippingDocuments", ShippingDocuments);
	
	SpeedLimits = TMCommonUse.BoundariesOfRegisterTurns("GoodsForIssue",
																"DocumentShipments IN (&ShippingDocuments)",
																Query.Parameters);
	
	Query.SetParameter("MinDate",   SpeedLimits.MinDate);
	Query.SetParameter("MaxDate",  SpeedLimits.MaxDate);
	
	Selection = Query.Execute().Select();
	ThereIsSelection = Selection.Next();
	
	ShipmentStatus = New Structure(
		"ThereAreShippedGoods, ThereAreUnassembledGoods",
		(ThereIsSelection And Selection.Count > 0),
		(ThereIsSelection And Selection.NumberInProgress > 0));
	
	SetPrivilegedMode(False);
	
	Return ShipmentStatus;
	
EndFunction

