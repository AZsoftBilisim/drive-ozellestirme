				|	DocumentSales.Contract                        AS Contract,
				|	DocumentSales.AmountARAP            AS AmountARAP,
				|	DocumentSales.Terms.PaymentSchedule        AS PaymentSchedule,
				|	NULL                                           AS BusinessOperation,
				|	TRUE                                         AS NotShipInInstallments,
				|	DATETIME(1,1,1)                               AS ApprovalDate,
				|	DocumentSales.Date                           AS DateOfShipment,
				|	FALSE                                           AS ThisIsOrder,
				|	DocumentSales.InvoiceByOrders                   AS InvoiceForOrders,
				|	NULL                                           AS PaymentDate,
				|	DocumentSales.Counterparty                     AS Counterparty,
				|	DocumentSales.DocumentAmount                 AS DocumentAmount,
				|	NULL                                           AS PricesKind,
				|	NULL                                           AS Warehouse,
				|	DocumentSales.PaymentMethod                    AS PaymentMethod,
				|	DocumentSales.ForeignCurrencyTransaction                  AS ForeignCurrencyTransaction,
				|	DocumentSales.ARAPObjectSettings                AS ARAPObjectSettings,
				|	DocumentSales.ARAPCurrency           AS ARAPCurrency,
				|	NULL                                           AS Frequent,
				|	NULL                                           AS Standard_,
				|	NULL                                           AS Period,
				|	NULL                                           AS NumberOfPeriods,
				|	NULL                                           AS UsedInSalesRepresentativesWork,
				|	NULL                                           AS PartnersSegment,
				|	NULL                                           AS ProductSegment,
				|	NULL                                           AS ValidityStartDate,
				|	NULL                                           AS ValidityEndDate,
				|	NULL                                           AS DeliveryPeriodDays,
				|	NULL                                           AS AvailableToExternalUsers,
				|	DocumentSales.Date                           AS DateOfTransferOfTitleToGoods,
				|	NULL                                           AS ReusablePackageReturnCycleLength,
				|	DocumentSales.Department                  AS Department
				|";
				
		EndIf;
			
		QueryText = QueryText + "
			|SELECT
			|	DocumentSales.Partner                                   AS Partner,
			|	DocumentSales.Currency                                    AS Currency,
			|	DocumentSales.PriceIncludesVAT                           AS PriceIncludesVAT,
			|	DocumentSales.Date                                      AS Date,
			|	DocumentSales.Organization                               AS Organization"
			+ ?(IsBlankString(TemporaryText), "", ", " + TemporaryText) + "
			|INTO
			|	TemporaryTableSalesDocument
			|FROM
			|" + TableName + " AS DocumentSales
			|WHERE
			|	DocumentSales.Ref = &DocumentSales
			|;
			|";
		
		QueryOptions.Insert("DocumentSales", DocumentSales);
		
	Else

		QueryText = QueryText + "
			|SELECT
			|	DocumentSales.Partner                                       AS Partner,
			|	DocumentSales.Counterparty                                    AS Counterparty,
			|	DocumentSales.Currency                                        AS Currency,
			|	DocumentSales.ARAPCurrency                          AS ARAPCurrency,
			|	DocumentSales.PriceIncludesVAT                               AS PriceIncludesVAT,
			|	DocumentSales.VATTaxation                            AS VATTaxation,
			|	DocumentSales.Terms                                    AS Terms,
			|	DocumentSales.Date                                          AS Date,
			|	DocumentSales.PricesKind                                        AS PricesKind,
			|	DocumentSales.Organization                                   AS Organization,
			|	DocumentSales.Warehouse                                         AS Warehouse,
			|	DocumentSales.WarehouseForReceipt                              AS WarehouseForReceipt,
			|	DocumentSales.Department                                 AS Department,
			|	DocumentSales.PaymentSchedule                                  AS PaymentSchedule,
			|	DocumentSales.PaymentMethod                                   AS PaymentMethod,
			|	DocumentSales.ForeignCurrencyTransaction                                 AS ForeignCurrencyTransaction,
			|	DocumentSales.Calendar                                     AS Calendar,
			|	DocumentSales.PaymentDate                                   AS PaymentDate,
			|	DocumentSales.Frequent                                    AS Frequent,
			|	DocumentSales.Standard_                                       AS Standard_,
			|	DocumentSales.Period                                        AS Period,
			|	DocumentSales.NumberOfPeriods                            AS NumberOfPeriods,
			|	DocumentSales.UsedInSalesRepresentativesWork     AS UsedInSalesRepresentativesWork,
			|	DocumentSales.PartnersSegment                              AS PartnersSegment,
			|	DocumentSales.ProductSegment                           AS ProductSegment,
			|	DocumentSales.ValidityStartDate                            AS ValidityStartDate,
			|	DocumentSales.ValidityEndDate                         AS ValidityEndDate,
			|	DocumentSales.DeliveryPeriodDays                                  AS DeliveryPeriodDays,
			|	DocumentSales.BusinessOperation                         AS BusinessOperation,
			|	DocumentSales.LineOfBusiness                       AS LineOfBusiness,
			|	DocumentSales.DocumentAmount                                AS DocumentAmount,
			|	DocumentSales.NotShipInInstallments                            AS NotShipInInstallments,
			|	DocumentSales.ApprovalDate                              AS ApprovalDate,
			|	DocumentSales.DateOfShipment                                  AS DateOfShipment,
			|	DocumentSales.ThisIsOrder                                      AS ThisIsOrder,
			|	DocumentSales.InvoiceForOrders                            AS InvoiceForOrders,
			|	FALSE                                                          AS OrderSales,
			|	FALSE                                                          AS InvoiceByOrders,
			|	DocumentSales.PercentRateOfManualDiscount                           AS PercentRateOfManualDiscount,
			|	DocumentSales.MaximumPercentageForManualMarkup                          AS MaximumPercentageForManualMarkup,
			|	DocumentSales.LimitDiscountAdjustments                      AS LimitDiscountAdjustments,
			|	DocumentSales.AvailableToExternalUsers                  AS AvailableToExternalUsers,
			|	DocumentSales.ContractsAreUsed              AS ContractsAreUsed,
			|	DocumentSales.Contract                                       AS Contract,
			|	DocumentSales.Status                                        AS Status,
			|	DocumentSales.AmountARAP                           AS AmountARAP,
			|	DocumentSales.CalculatePackageReturnDateAccordingToCalendar       AS CalculatePackageReturnDateAccordingToCalendar,
			|	DocumentSales.ScheduleOfPackageReturn                         AS ScheduleOfPackageReturn,
			|	DocumentSales.ReusablePackageReturnCycleLength                AS ReusablePackageReturnCycleLength,
			|	DocumentSales.ARAPObjectSettings                               AS ARAPObjectSettings,
			|	DocumentSales.PlanningScenario                          AS PlanningScenario,
			|	DocumentSales.DateOfTransferOfTitleToGoods                AS DateOfTransferOfTitleToGoods,
			|	DocumentSales.SaleWithDeferredTransferOfTitleIsAllowed AS SaleWithDeferredTransferOfTitleIsAllowed,
			|	DocumentSales.MinimumOrderAmount                        AS MinimumOrderAmount,
			|	DocumentSales.PlanProfile                                      AS PlanProfile
			|INTO
			|	TemporaryTableSalesDocument
			|FROM
			|	&DocumentSales AS DocumentSales
			|;
			|";
			
		// We will form the necessary columns of the table of the header of the sales document
			
		TypeCurrency = New TypeDescription("CatalogRef.Currencies");
		BooleanType = New TypeDescription("Boolean");
		NumberType  = New TypeDescription("Number");
		DateType   = New TypeDescription("Date");
		
		ArrayOfStatusTypes = New Array;
		ArrayOfStatusTypes.Add(Type("EnumRef.SalesOrderStatuses"));
		ArrayOfStatusTypes.Add(Type("EnumRef.StatusesOfRequestsForReturnOfGoodsFromCustomers"));
		ArrayOfStatusTypes.Add(Type("EnumRef.StatusesOfCustomerInvoices"));
		
		DocumentTable = New ValueTable();
		DocumentTable.Columns.Add("Partner",                                       New TypeDescription("CatalogRef.Partners"));
		DocumentTable.Columns.Add("Counterparty",                                    New TypeDescription("CatalogRef.Counterparties"));
		DocumentTable.Columns.Add("Currency",                                        TypeCurrency);
		DocumentTable.Columns.Add("ARAPCurrency",                          TypeCurrency);
		DocumentTable.Columns.Add("PriceIncludesVAT",                               BooleanType);
		DocumentTable.Columns.Add("VATTaxation",                            New TypeDescription("EnumRef.VATTaxationTypes"));
		DocumentTable.Columns.Add("BusinessOperation",                         New TypeDescription("EnumRef.BusinessTransactions"));
		DocumentTable.Columns.Add("Date",                                          DateType);
		DocumentTable.Columns.Add("PricesKind",                                        New TypeDescription("CatalogRef.TypesOfPrices"));
		DocumentTable.Columns.Add("Organization",                                   New TypeDescription("CatalogRef.Companies"));
		DocumentTable.Columns.Add("Warehouse",                                         New TypeDescription("CatalogRef.Warehouses"));
		DocumentTable.Columns.Add("WarehouseForReceipt",                              New TypeDescription("CatalogRef.Warehouses"));
		DocumentTable.Columns.Add("Department",                                 New TypeDescription("CatalogRef.BusinessStructure"));
		DocumentTable.Columns.Add("Terms",                                    New TypeDescription("CatalogRef.TermsOfSale"));
		DocumentTable.Columns.Add("PaymentSchedule",                                  New TypeDescription("CatalogRef.PaymentSchedules"));
		DocumentTable.Columns.Add("PaymentMethod",                                   New TypeDescription("EnumRef.PaymentForms"));
		DocumentTable.Columns.Add("ForeignCurrencyTransaction",                                 BooleanType);
		DocumentTable.Columns.Add("Calendar",                                     New TypeDescription("CatalogRef.BusinessCalendars"));
		DocumentTable.Columns.Add("PaymentDate",                                   DateType);
		DocumentTable.Columns.Add("ProductSegment",                           New TypeDescription("CatalogRef.ProductSegments"));
		DocumentTable.Columns.Add("VATRate",                                     New TypeDescription("CatalogRef.VATRates"));
		DocumentTable.Columns.Add("Frequent",                                    BooleanType);
		DocumentTable.Columns.Add("Standard_",                                       BooleanType);
		DocumentTable.Columns.Add("Period",                                        New TypeDescription("EnumRef.Periodicity"));
		DocumentTable.Columns.Add("NumberOfPeriods",                            NumberType);
		DocumentTable.Columns.Add("UsedInSalesRepresentativesWork",     BooleanType);
		DocumentTable.Columns.Add("PartnersSegment",                              New TypeDescription("CatalogRef.PartnersSegments"));
		DocumentTable.Columns.Add("ValidityStartDate",                            DateType);
		DocumentTable.Columns.Add("ValidityEndDate",                         DateType);
		DocumentTable.Columns.Add("DeliveryPeriodDays",                                  NumberType);
		DocumentTable.Columns.Add("DocumentAmount",                                NumberType);
		DocumentTable.Columns.Add("DateOfShipment",                                  DateType);
		DocumentTable.Columns.Add("ApprovalDate",                              DateType);
		DocumentTable.Columns.Add("NotShipInInstallments",                            BooleanType);
		DocumentTable.Columns.Add("ThisIsOrder",                                      BooleanType);
		DocumentTable.Columns.Add("InvoiceForOrders",                            BooleanType);
		DocumentTable.Columns.Add("InvoiceByOrders",                                  BooleanType);
		DocumentTable.Columns.Add("OrderSales",                           BooleanType);
		DocumentTable.Columns.Add("PercentRateOfManualDiscount",                           NumberType);
		DocumentTable.Columns.Add("MaximumPercentageForManualMarkup",                          NumberType);
		DocumentTable.Columns.Add("LimitDiscountAdjustments",                      BooleanType);
		DocumentTable.Columns.Add("AvailableToExternalUsers",                  BooleanType);
		DocumentTable.Columns.Add("ContractsAreUsed",              BooleanType);
		DocumentTable.Columns.Add("Contract",                                       New TypeDescription("CatalogRef.CounterpartyContracts"));
		DocumentTable.Columns.Add("Status",                                        New TypeDescription(ArrayOfStatusTypes));
		DocumentTable.Columns.Add("AmountARAP",                           NumberType);
		DocumentTable.Columns.Add("MinimumOrderAmount",                        NumberType);
		DocumentTable.Columns.Add("CalculatePackageReturnDateAccordingToCalendar",       BooleanType);
		DocumentTable.Columns.Add("ScheduleOfPackageReturn",                         New TypeDescription("CatalogRef.BusinessCalendars"));
		DocumentTable.Columns.Add("ReusablePackageReturnCycleLength",                NumberType);
		DocumentTable.Columns.Add("ARAPObjectSettings",                               New TypeDescription("EnumRef.ARAPObjectSettings"));
		DocumentTable.Columns.Add("PlanningScenario",                          New TypeDescription("CatalogRef.SalesOperationsPlanningScenarios"));
		DocumentTable.Columns.Add("DateOfTransferOfTitleToGoods",                DateType);
		DocumentTable.Columns.Add("SaleWithDeferredTransferOfTitleIsAllowed", BooleanType);
		DocumentTable.Columns.Add("PlanProfile",                                      New TypeDescription("CatalogRef.PlanProfiles"));
		DocumentTable.Columns.Add("LineOfBusiness",                       New TypeDescription("CatalogRef.LinesOfBusiness"));
		
		// Add a line and fill in the values from the header of the document
		
		NewRow = DocumentTable.Add();
		FillPropertyValues(NewRow, DocumentSales);
		
		If TypeOf(DocumentSales.Ref) = Type("DocumentRef.CashRegisterReceiptReturn") Then
			// We will update the division for the refund check, since this Attribute is not in the header of the document.
			NewRow.Department = Common.ObjectAttributeValue(DocumentSales.CashRegister, "Department");
		EndIf;
		
		TabularSectionName = "PaymentScheduleSteps";
		If TypeOf(DocumentSales) = Type("FormDataStructure") Then
			MetadataOfDocument = DocumentSales.Ref.Metadata();
		Else
			MetadataOfDocument = DocumentSales.Metadata();
		EndIf;
		If MetadataOfDocument.TabularSections.Find(TabularSectionName) <> Undefined
			And MetadataOfDocument.TabularSections[TabularSectionName].Attributes.Find("PaymentDate") <> Undefined Then
			
			If DocumentSales[TabularSectionName].Count() > 0 Then
				TableOfPayment = DocumentSales[TabularSectionName].Unload(,"PaymentDate");
				TableOfPayment.Sort("PaymentDate Desc");
				FillPropertyValues(NewRow, TableOfPayment[0]);
			EndIf; 
			
		EndIf;
		
		NewRow.InvoiceForOrders = NewRow.InvoiceByOrders
			Or NewRow.OrderSales;
		
		NewRow.ThisIsOrder = TypeOf(DocumentSales.Ref) = Type("DocumentRef.SalesOrder")
			Or TypeOf(DocumentSales.Ref) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer");
		
		QueryOptions.Insert("DocumentSales", DocumentTable);
		
	EndIf;

EndProcedure

// Generates a request to the PM for the document and puts It in a temporary table
//
// Parameters:
// QueryText           - String - text string to which you want to add the query text
// QueryOptions       - Structure - structure containing request parameters
// DocumentSales        - DocumentObject, DocumentRef - document to make a request for
// TableName             - String - name of the document table to be queried
// ConsiderDiscountsMarkups - Boolean - flag that determines whether discounts and mark-UPS are available in the document being checked
// ByReference_               - Boolean - flag if True check is performed by reference to the object.
// UsePriceChecks - Boolean - flag if True for some queries added pricing structures.
//
Procedure GenerateTemporaryTableProductsQueryOfSalesDocument(QueryText,
	                                                               QueryOptions,
	                                                               DocumentSales,
	                                                               TableName,
	                                                               ConsiderDiscountsMarkups,
	                                                               ByReference_ = False,
	                                                               UsePriceChecks,
	                                                               CheckName = "")
	TabularSectionName = "Goods";
	AdditionalTablePartName = "";
	ColumnNamesInTablePart = "";
	TabularSectionPresentation    = "Goods";
	PresentationOfAdditionalTabularPart = "";
	
	If TypeOf(DocumentSales) = Type("DataProcessorObject.SalesWizard") Then
		
		QueryText = QueryText + "
			|SELECT
			|	Goods.ProductsInSet               AS ProductsInSet,
			|	Goods.ItemVariantOfSet             AS ItemVariantOfSet,
			|	Goods.LineNumber                      AS LineNumber,
			|	Goods.Products                     AS Products,
			|	Goods.Characteristic                   AS Characteristic,
			|	Goods.Price                             AS Price,
			|	Goods.Sum                            AS Sum,
			|	Goods.VATAmount                         AS VATAmount,
			|	Goods.PriceKind                          AS PriceKind,
			|	Goods.Package                         AS Package,
			|	Goods.VATRate                        AS VATRate,
			|	Goods.ConnectionKey                        AS ConnectionKey,
			|	Goods.PercentRateOfAutomaticDiscountMarkup      AS PercentRateOfAutomaticDiscountMarkup,
			|	Goods.DiscountMarkupAmount        AS DiscountMarkupAmount,
			|	Goods.PercentRateOfManualDiscount              AS PercentRateOfManualDiscount,
			|	Goods.ManualDiscount                AS ManualDiscount,
			|	CASE
			|		WHEN Goods.NumberOfPackages <> 0
			|			THEN Goods.Sum / Goods.NumberOfPackages
			|		ELSE Goods.Sum / Goods.NumberOfPackagesDueToReturn
			|	END AS DiscountedPrice_,
			|	Goods.DateOfShipment                     AS DateOfShipment,
			|	FALSE                                    AS Canceled,
			|	Goods.Warehouse                            AS Warehouse,
			|	Goods.Department                    AS Department,
			|	Goods.DeliveryPeriodDays                     AS DeliveryPeriodDays,
			|	0                                       AS RowCode,
			|	Goods.Count                       AS Count,
			|	Goods.NumberOfPackages               AS NumberOfPackages,
			|	Goods.SupplyOption               AS SupplyOption,
			|	FALSE                                    AS CheckFillingErrorsDeliveryTime
			|INTO
			|	TemporaryTableOfGoods_Preliminary
			|FROM
			|	&TableName AS Goods
			|WHERE &FilterCriterion
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT &PreparingTemporaryTablesSets
			|;
			|";
			
		TabularSectionName = "Goods";
		ColumnsNames = "LineNumber,
			|ProductsInSet,
			|ItemVariantOfSet,
			|Products,
			|Characteristic,
			|Count,
			|NumberOfPackages,
			|QuantityForReturn,
			|NumberOfPackagesDueToReturn,
			|Price,
			|Sum,
			|PriceKind,
			|Package,
			|VATAmount,
			|VATRate,
			|ConnectionKey,
			|PercentRateOfAutomaticDiscountMarkup,
			|DiscountMarkupAmount,
			|PercentRateOfManualDiscount,
			|ManualDiscount,
			|DateOfShipment,
			|Warehouse,
			|Department,
			|SupplyOption,
			|DeliveryPeriodDays";
		
	ElsIf TableName = "Catalog.TermsOfSale" Then
	
		QueryText = QueryText + "
			|SELECT
			|	FALSE                  AS TheseAreComponents,
			|	FALSE                  AS IsRecordsSet,
			|	VALUE(Catalog.Products.EmptyRef) AS ProductsInSet,
			|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS ItemVariantOfSet,
			|	Goods.LineNumber    AS LineNumber,
			|	Goods.Products   AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	Goods.Price           AS Price,
			|	Goods.PriceKind        AS PriceKind,
			|	Goods.Package       AS Package,
			|	Goods.Price           AS DiscountedPrice_,
			|	Goods.DeliveryPeriodDays   AS DeliveryPeriodDays,
			|	0                     AS RowCode,
			|	TRUE                AS CheckFillingErrorsDeliveryTime
			|INTO
			|	TemporaryTableOfGoods_Preliminary
			|FROM
			|	&TableName AS Goods
			|WHERE &FilterCriterion
			|INDEX BY
			|	Products,
			|	Characteristic
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	Table.TheseAreComponents     AS TheseAreComponents,
			|	Table.IsRecordsSet             AS IsRecordsSet,
			|	Table.ProductsInSet   AS ProductsInSet,
			|	Table.ItemVariantOfSet AS ItemVariantOfSet,
			|	Table.LineNumber          AS LineNumber,
			|	Table.Products         AS Products,
			|	Table.Characteristic       AS Characteristic,
			|	&TextOfPricingFields,
			|	Table.Price                 AS Price,
			|	Table.PriceKind              AS PriceKind,
			|	Table.Package             AS Package,
			|	Table.Price                 AS DiscountedPrice_,
			|	Table.DeliveryPeriodDays         AS DeliveryPeriodDays,
			|	Table.RowCode            AS RowCode,
			|	Table.CheckFillingErrorsDeliveryTime AS CheckFillingErrorsDeliveryTime
			|INTO
			|	TemporaryTableOfGoods_
			|FROM
			|	TemporaryTableOfGoods_Preliminary AS Table
			|		LEFT JOIN Catalog.ItemKinds AS ItemKinds
			|			ON ItemKinds.Ref = Table.Products.ProductKind
			|
			|;
			|";
			
		TabularSectionName = "Goods";
		ColumnsNames = "LineNumber,
			|Products,
			|Characteristic,
			|Price,
			|PriceKind,
			|Package,
			|DeliveryPeriodDays";
		
	ElsIf TableName = "Document.JobForSalesRepresentative" Then
		
		QueryText = QueryText + "
			|SELECT
			|	Goods.LineNumber    AS LineNumber,
			|	Goods.Products   AS Products,
			|	Goods.Characteristic AS Characteristic,
			|	Goods.Price           AS Price,
			|	Goods.Sum          AS Sum,
			|	Goods.PriceKind        AS PriceKind,
			|	Goods.Package       AS Package,
			|	Goods.VATRate      AS VATRate,
			|	Goods.VATAmount       AS VATAmount,
			|	Goods.Price           AS DiscountedPrice_,
			|	0                     AS DeliveryPeriodDays,
			|	0                     AS RowCode,
			|	FALSE                  AS CheckFillingErrorsDeliveryTime
			|INTO
			|	TemporaryTableOfGoods_
			|FROM
			|	&TableName AS Goods
			|WHERE &FilterCriterion
			|INDEX BY
			|	Products,
			|	Characteristic
			|;
			|";
			
		TabularSectionName = "Goods";
		ColumnsNames = "LineNumber,
			|Products,
			|Characteristic,
			|Price,
			|Sum,
			|PriceKind,
			|Package,
			|VATAmount,
			|VATRate";
			
	ElsIf TableName = "Document.SalesOrder" Then
		
		QueryText = QueryText + "
			|SELECT
			|	Goods.ProductsInSet               AS ProductsInSet,
			|	Goods.ItemVariantOfSet             AS ItemVariantOfSet,
			|	Goods.LineNumber                      AS LineNumber,
			|	Goods.Products                     AS Products,
			|	Goods.Characteristic                   AS Characteristic,
			|	Goods.Price                             AS Price,
			|	Goods.Sum                            AS Sum,
			|	Goods.PriceKind                          AS PriceKind,
			|	Goods.Package                         AS Package,
			|	Goods.VATRate                        AS VATRate,
			|	Goods.VATAmount                         AS VATAmount,
			|	Goods.ConnectionKey                        AS ConnectionKey,
			|	Goods.PercentRateOfAutomaticDiscountMarkup      AS PercentRateOfAutomaticDiscountMarkup,
			|	Goods.DiscountMarkupAmount        AS DiscountMarkupAmount,
			|	Goods.PercentRateOfManualDiscount              AS PercentRateOfManualDiscount,
			|	Goods.ManualDiscount                AS ManualDiscount,
			|	Goods.Sum / Goods.NumberOfPackages AS DiscountedPrice_,
			|	Goods.DateOfShipment                     AS DateOfShipment,
			|	Goods.Canceled                         AS Canceled,
			|	Goods.Warehouse                            AS Warehouse,
			|	Goods.Department                    AS Department,
			|	Goods.DeliveryPeriodDays                     AS DeliveryPeriodDays,
			|	Goods.RowCode                        AS RowCode,
			|	Goods.Count                       AS Count,
			|	Goods.NumberOfPackages               AS NumberOfPackages,
			|	Goods.SupplyOption               AS SupplyOption,
			|	FALSE                                    AS CheckFillingErrorsDeliveryTime,
			|	Goods.PartnerProducts             AS PartnerProducts
			|INTO
			|	TemporaryTableOfGoods_Preliminary
			|FROM
			|	&TableName AS Goods
			|WHERE &FilterCriterion
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT &PreparingTemporaryTablesSets
			|;
			|";
			
		TabularSectionName = "Goods";
		ColumnsNames = "LineNumber,
			|ProductsInSet,
			|ItemVariantOfSet,
			|Count,
			|NumberOfPackages,
			|Products,
			|Characteristic,
			|Price,
			|Sum,
			|PriceKind,
			|Package,
			|VATRate,
			|VATAmount,
			|ConnectionKey,
			|PercentRateOfAutomaticDiscountMarkup,
			|DiscountMarkupAmount,
			|PercentRateOfManualDiscount,
			|ManualDiscount,
			|DateOfShipment,
			|Canceled,
			|Warehouse,
			|Department,
			|DeliveryPeriodDays,
			|SupplyOption,
			|RowCode,
			|PartnerProducts";
			
	ElsIf TableName = "Document.MaterialProviderOrder2_5" Then
		
		QueryText = QueryText + "
		|SELECT
		|	Goods.LineNumber                                      AS LineNumber,
		|	Goods.Products                                     AS Products,
		|	Goods.Characteristic                                   AS Characteristic,
		|	Goods.Package                                         AS Package,
		|	Goods.Canceled                                         AS Canceled,
		|	Goods.SupplyOption                               AS SupplyOption,
		|	VALUE(Enum.ActionsOnMaterialsToSubcontract.EmptyRef) AS Action,
		|	Goods.Warehouse                                            AS Warehouse,
		|	Goods.RowCode                                        AS RowCode,
		|	Goods.AmountIncludingVAT                                        AS AmountIncludingVAT
		|
		|INTO TT_Goods
		|
		|FROM
		|	&TableName AS Goods
		|WHERE &FilterCriterion
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.LineNumber                                      AS LineNumber,
		|	Goods.Products                                     AS Products,
		|	Goods.Characteristic                                   AS Characteristic,
		|	Goods.Package                                         AS Package,
		|	Goods.Canceled                                         AS Canceled,
		|	VALUE(Enum.SupplyOptions.EmptyRef) AS SupplyOption,
		|	Goods.Action                                         AS Action,
		|	Goods.Warehouse                                            AS Warehouse,
		|	Goods.RowCode                                        AS RowCode
		|
		|INTO TT_AdditionalProducts
		|
		|FROM
		|	&AdditionalTableName AS Goods
		|WHERE &FilterCriterion
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Goods.LineNumber   AS LineNumber,
		|	Goods.Products  AS Products,
		|	Goods.Department AS Department
		|	
		|INTO TemporaryTableOfGoods_Preliminary
		|
		|FROM
		|	&TableName AS Goods
		|WHERE &FilterCriterion
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	&TabularSectionName              AS TSName,
		|	&TabularSectionPresentation    AS PresentationOfTS,
		|	Goods.LineNumber              AS LineNumber,
		|	Goods.Products             AS Products,
		|	Goods.Characteristic           AS Characteristic,
		|	Goods.Package                 AS Package,
		|	Goods.Canceled                 AS Canceled,
		|	Goods.SupplyOption       AS SupplyOption,
		|	Goods.Action                 AS Action,
		|	Goods.Warehouse                    AS Warehouse,
		|	Goods.RowCode                AS RowCode,
		|	FALSE                            AS CheckFillingErrorsDeliveryTime
		|
		|INTO TemporaryTableOfGoods_
		|
		|FROM
		|	TT_Goods AS Goods
		|
		|UNION ALL
		|
		|SELECT
