		|	TRUE
		|WHERE
		|	TemporaryTableOfGoods_.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OwnGoods),VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND TemporaryTableSalesDocument.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
		|;
		|";
	
