// Generates a query for items in the "Warehouses" directory and places them in a temporary table
// To the correct warehouses are:
// 		- The warehouse is equal to the warehouse agreement
// 		- Warehouses that are part of the agreement warehouse hierarchy.
//
Procedure GenerateRequestTemporaryTableWarehousesCorrectByAgreement(QueryText)
	
	QueryText = QueryText + "
	|SELECT
	|	Warehouses.Ref AS Warehouse
	|INTO WarehousesAreCorrectByAgreement
	|FROM
	|	Catalog.Warehouses AS Warehouses
	|
	|	INNER JOIN
	|		TemporaryTableSalesDocument AS TemporaryDocumentTable
	|
	|	ON
	|		TRUE
	|
	|	INNER JOIN
	|		Catalog.TermsOfSale AS TermsOfSale
	|	ON
	|		TemporaryDocumentTable.Terms = TermsOfSale.Ref
	|		AND TermsOfSale.Warehouse IS NOT NULL
	|		AND TermsOfSale.Warehouse <> VALUE(Catalog.Warehouses.EmptyRef)
	|
	|WHERE
	|	Warehouses.Ref IN HIERARCHY
	|			(SELECT
	|				TemporaryDocumentTable.Terms.Warehouse
	|			FROM
	|				TemporaryTableSalesDocument AS TemporaryDocumentTable)
	|;
	|";
	
EndProcedure

// Puts into a temporary table, the specified amount of settlement by the implementation.
// If necessary, calculates the amount of mutual settlements for containers.
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestTemporaryTableOfSettlementAmounts(QueryText)
	
	QueryText = QueryText + "
	|SELECT
	|	MAX(&SumOfMutualSettlementsOfRealization) - 
	|		CASE 
	|			WHEN MAX(&DepositAmountNotSpecified) = TRUE
	|				THEN ISNULL(SUM(Tara.AmountARAP), 0)
	|			ELSE MAX(&AmountOfCollateralForImplementation)
	|		END AS AmountToPay,
	|	CASE 
	|		WHEN MAX(&DepositAmountNotSpecified) = TRUE
	|			THEN ISNULL(SUM(Tara.AmountARAP), 0)
	|		ELSE MAX(&AmountOfCollateralForImplementation)
	|	END AS PackageDepositValue
	|INTO TemporaryTableOfSettlementAmounts
	|FROM
	|	TemporaryTableSalesDocument AS TemporaryTableSalesDocument
	|	
	|	LEFT JOIN TemporaryTableOfGoods_Preliminary AS Tara
	|	ON Tara.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|		AND &PackageDepositIsRequired
	|;
	|";
	
EndProcedure

