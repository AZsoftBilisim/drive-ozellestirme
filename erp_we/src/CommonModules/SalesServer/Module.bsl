	|WHERE
	|	CASE
	|		WHEN TemporaryTableSalesDocument.LineOfBusiness = VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|			THEN FALSE
	|		WHEN NOT TemporaryTableSalesDocument.LineOfBusiness.IncomeAccounting
	|				OR NOT TemporaryTableSalesDocument.LineOfBusiness.CostAccounting
	|				THEN TRUE
	|		ELSE FALSE
	|	END
	|;
	|";
	
EndProcedure

// Generates a request to check whether the client's order can be used for Agency purchase, depending on the separation option
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestToVerifyPossibilityOfUsingClientSOrderAccordingToSeparationOption(QueryText)
	
	QueryText = QueryText + "SELECT
	|	CASE
	|		WHEN Constants.OptionOfGoodsAssignmentInSales = VALUE(Enum.OptionsOfGoodsAssignmentInSales.Contract)
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ThereAreErrorsInUsingClientSOrderForAgencyPurchase
	|FROM
	|	Constants AS Constants
	|WHERE
	|	CASE
	|		WHEN Constants.OptionOfGoodsAssignmentInSales = VALUE(Enum.OptionsOfGoodsAssignmentInSales.Contract)
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|;
	|";
	
EndProcedure

