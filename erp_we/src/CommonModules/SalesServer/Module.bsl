// The function returns an indication whether the document requisite "Enablecheats".
// Used to determine whether to send a link when filling out the price type.
//
// Parameters:
//   Document - DocumentRef - The document being checked.
//
// Returns:
//   Boolean - a sign of the presence in the document of the props "Price includes".
//
Function InDocumentYouMustFillInPriceIncludesVATAttribute(Document)
	
	Result = True;
	
	If Document = Undefined Then
		Result = False;
	Else
		MetadataObjectName = Document.Metadata().FullName();
		ObjectMetadata = Metadata.FindByFullName(MetadataObjectName);
		
		If ObjectMetadata = Undefined 
			Or Not Common.HasObjectAttribute("PriceIncludesVAT", ObjectMetadata) Then
				Result = False;
		EndIf;
	EndIf;
	
	Return Result;
	
EndFunction

