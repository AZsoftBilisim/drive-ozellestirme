// Generates a request to check the correctness of the number of payment stages in the agreement
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectnessOfNumberOfPaymentStagesOfAgreement(QueryText)
	
		QueryText = QueryText + "
			|SELECT
			|	CASE
			|		WHEN SUM(NestedQuery.NumberOfStagesOfAgreement) <> SUM(NestedQuery.NumberOfFoundationAgreementStages)
			|			THEN TRUE
			|		ELSE FALSE
			|	END AS ThereAreErrorsInFillingOutPaymentStagesOfAgreement,
			|	SUM(NestedQuery.NumberOfStagesOfAgreement) AS NumberOfStagesOfAgreement,
			|	SUM(NestedQuery.NumberOfFoundationAgreementStages) AS NumberOfFoundationAgreementStages
			|FROM
			|	(SELECT
			|		COUNT(DISTINCT StagesOfAgreement_.LineNumber) AS NumberOfStagesOfAgreement,
			|		NULL AS NumberOfFoundationAgreementStages
			|	FROM
			|		TemporaryTablePaymentStepsTerms AS StagesOfAgreement_
			|	
			|	UNION
			|	
			|	SELECT
			|		NULL AS NumberOfStagesOfAgreement,
			|		COUNT(DISTINCT FoundationAgreementStages.LineNumber) AS NumberOfFoundationAgreementStages
			|	FROM
			|		TemporaryTableStagesOfPaymentAgreementGrounds AS FoundationAgreementStages
			|	) AS NestedQuery
			|;
			|";
			
EndProcedure

// Generates a request to check whether the payment stages are filled in correctly in the agreement
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectnessOfPaymentStagesOfAgreement(QueryText)
	
		QueryText = QueryText + "
			|SELECT
			|	CASE
			|		WHEN TemplateStages.LineNumber IS NULL 
			|			THEN TRUE
			|		ELSE FALSE
			|	END AS TemplateStageIsMissing,
			|	DocumentStages.LineNumber AS LineNumber,
			|	DocumentStages.PaymentOption AS PaymentOption,
			|	DocumentStages.Move AS Move,
			|	DocumentStages.PaymentPercentage AS PaymentPercentage,
			|	
			|	CASE WHEN &PackageDepositIsRequired THEN
			|		DocumentStages.PackageDepositPercentage
			|	ELSE
			|		0
			|	END AS PackageDepositPercentage,
			|	
			|	TemplateStages.LineNumber AS TemplateLineNumber,
			|	TemplateStages.PaymentOption AS TemplatePaymentOption,
			|	TemplateStages.PaymentPercentage AS TemplatePaymentPercentage,
			|	
			|	CASE WHEN &PackageDepositIsRequired THEN
			|		TemplateStages.PackageDepositPercentage
			|	ELSE
			|		0
			|	END AS PercentageOfDepositForContainerOfTemplate,
			|	
			|	TemplateStages.Move AS TemplateShift,
			|	CASE
			|		WHEN DocumentStages.PaymentOption <> TemplateStages.PaymentOption
			|			THEN TRUE
			|		ELSE FALSE
			|	END AS ThereAreErrorsInFillingOutPaymentOption
			|FROM
			|	TemporaryTablePaymentStepsTerms AS DocumentStages
			|		LEFT JOIN Catalog.TermsOfSale.PaymentScheduleSteps AS TemplateStages
			|		ON DocumentStages.LineNumber = TemplateStages.LineNumber
			|			AND TemplateStages.Ref IN (SELECT TemporaryTableSalesDocument.Terms AS Terms FROM TemporaryTableSalesDocument AS TemporaryTableSalesDocument)
			|ORDER BY
			|	LineNumber
			|;
			|";

EndProcedure

// Generates checks to control the completion of the order shipment
// and to control the completion of the order calculations.
//
// Parameters:
// ControlledOrder - DocumentRef.SalesOrder, DocumentRef.RequestForReturnOfGoodsFromCustomer - controlled document.
// Cancel - Boolean - the opt-Out parameter.
//
Procedure PerformOrderControlAfterConducting(ControlledOrder, Cancel) Export
	
	Query = New Query;
	Query.Text = "
	|SELECT
	|	SalesOrdersData.ReferenceOrder AS SalesOrder
	|FROM
	|	#ShipmentOrdersTurnoverExpanded AS SalesOrdersData
	|WHERE
	|	&MonitorShipment
	|	AND (SalesOrdersData.ForRegistrationQuantityTurnover -
	|		SalesOrdersData.IssuedQuantityTurnover) <> 0
	|	AND (&ConditionSalesOrderStatus)
	|	AND (&ConditionSalesOrderBusinessTransaction)
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsForIssueBalance.DocumentShipments AS SalesOrder
	|FROM
	|	AccumulationRegister.GoodsForIssue.Balance(, 
	|			DocumentShipments = &Ref) AS GoodsForIssueBalance
	|WHERE
	|	&MonitorShipment
	|	AND (GoodsForIssueBalance.ToShipBalance + GoodsForIssueBalance.AssembledBalance) <> 0
	|	AND &ShippingDocumentSelectionCondition
	|;
	|
	|SELECT
	|	SalesOrdersData.ARAPObject AS ARAPObject,
	|	SalesOrdersData.ReferenceOrder AS SalesOrder
	|INTO TemporaryTableOfARAPObjects
	|FROM
	|	(SELECT
	|		ARAPObjects.Ref AS ARAPObject,
	|		ARAPObjects.Object AS ReferenceOrder
	|	FROM
	|		Catalog.ARAPObjects AS ARAPObjects
	|	WHERE
	|		ARAPObjects.Object = &Ref
	|		AND NOT ARAPObjects.DeletionMark) AS SalesOrdersData
	|WHERE
	|	(&ConditionSalesOrderStatus)
	|	AND (&ConditionSalesOrderBusinessTransaction)
	|;
	|
	|SELECT
	|	CustomersARAPAccountingBalance.Currency AS Currency,
	|	CustomersARAPAccountingBalance.AmountDueBalance AS AmountDueBalance
	|FROM
	|	AccumulationRegister.CustomersARAPAccounting.Balance(, 
	|			ARAPObject IN
	|				(SELECT
	|					TemporaryTableOfARAPObjects.ARAPObject
	|				FROM	TemporaryTableOfARAPObjects)
	|	) AS CustomersARAPAccountingBalance
	|		
	|WHERE
	|	&MonitorCalculations
	|	AND CustomersARAPAccountingBalance.AmountDueBalance > 0
	|";
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.ConditionText =
		"ReferenceOrder = &Ref";
	TableFormationParameters.Group = "ReferenceOrder";
	TableFormationParameters.Indicators = "Ordered, ToRegister, Issued_1";
	TableFormationParameters.Resources = "Count";
	
	ShipmentOrdersTurnoverExpanded =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	Query.Text = StrReplace(Query.Text,
		"#ShipmentOrdersTurnoverExpanded",
		ShipmentOrdersTurnoverExpanded);
	
	MonitorShipment = GetFunctionalOption("DoNotCloseSalesOrdersWithoutCompleteShipment");
	MonitorCalculations  = GetFunctionalOption("DoNotCloseSalesOrdersWithoutCompletePayment");
	
	If TypeOf(ControlledOrder) = Type("DocumentRef.SalesOrder") Then
		
		ConditionSalesOrderStatus = "
		|   CAST(SalesOrdersData.ReferenceOrder AS Document.SalesOrder).Status = VALUE(Enum.SalesOrderStatuses.Closed)"; 

		ConditionSalesOrderBusinessTransaction = "
		|   CAST(SalesOrdersData.ReferenceOrder AS Document.SalesOrder).BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
		| AND CAST(SalesOrdersData.ReferenceOrder AS Document.SalesOrder).BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale)";
		
		ConditionShippingDocument = "
		|   CAST(GoodsForIssueBalance.DocumentShipments AS Document.SalesOrder).Status = VALUE(Enum.SalesOrderStatuses.Closed)
		| AND CAST(GoodsForIssueBalance.DocumentShipments AS Document.SalesOrder).BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
		| AND CAST(GoodsForIssueBalance.DocumentShipments AS Document.SalesOrder).BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale)";

	ElsIf TypeOf(ControlledOrder) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then

		ConditionSalesOrderStatus = "
		|   CAST(SalesOrdersData.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).Status = VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.Executed)";

		ConditionSalesOrderBusinessTransaction = "
		|   CAST(SalesOrdersData.ReferenceOrder AS Document.RequestForReturnOfGoodsFromCustomer).BusinessOperation <> VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent)";

		ConditionShippingDocument = "
		|   CAST(GoodsForIssueBalance.DocumentShipments AS Document.RequestForReturnOfGoodsFromCustomer).Status = VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.Executed)
		| AND CAST(GoodsForIssueBalance.DocumentShipments AS Document.RequestForReturnOfGoodsFromCustomer).BusinessOperation <> VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent)";
	
	Else
		 ConditionSalesOrderStatus                = "FALSE";
		 ConditionSalesOrderBusinessTransaction = "FALSE";
		 ConditionShippingDocument                  = "TRUE";
	EndIf;
	
	Query.Text           = StrReplace(Query.Text, "&ConditionSalesOrderStatus", ConditionSalesOrderStatus);
	Query.Text           = StrReplace(Query.Text, "&ConditionSalesOrderBusinessTransaction", ConditionSalesOrderBusinessTransaction);
	Query.Text           = StrReplace(Query.Text, "&ShippingDocumentSelectionCondition", ConditionShippingDocument);
	
	Query.SetParameter("Ref", ControlledOrder);
	Query.SetParameter("MonitorShipment", MonitorShipment);
	Query.SetParameter("MonitorCalculations", MonitorCalculations);
	Result = Query.ExecuteBatch(); 
	
	SampleShipment = Result[0].Select();
	SampleCalculations_  = Result[2].Select();
	
	If SampleShipment.Next() Then 
		If TypeOf(ControlledOrder) = Type("DocumentRef.SalesOrder") Then
			ErrorText = NStr("vi = 'Chứng từ ""%OrderDocument%"" chưa được lập đầy đủ.
			|Chỉ có thể đóng đơn hàng với các dòng đã lập chứng từ/đã hủy bỏ toàn bộ';
			|ru = 'Документ ""%OrderDocument%"" оформлен не полностью.
			|Закрытие заказа возможно только с полностью оформленными/отмененными строками';
			|en = 'The ""%OrderDocument%"" document is registered incompletely.
			|Order can be closed only with lines fully registered/cancelled'; fa = 'The ""%OrderDocument%"" document is registered incompletely.
			|Order can be closed only with lines fully registered/cancelled';
			|it = 'The ""%OrderDocument%"" document is registered incompletely.
			|Order can be closed only with lines fully registered/cancelled';
			|pl = 'The ""%OrderDocument%"" document is registered incompletely.
			|Order can be closed only with lines fully registered/cancelled';
			|tr = '""%OrderDocument%"" belgesi tam olarak oluşturulmadı.
			|Bir siparişin kapatılması yalnızca tamamen oluşturulan/iptal edilen satırlarla mümkündür'");
		ElsIf TypeOf(ControlledOrder) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
			ErrorText = NStr("vi = 'Hàng hóa thay thế theo chứng từ ""%OrderDocument%"" đã được lập chứng từ không đầy đủ.
			|Chỉ có thể kết chuyển lại giấy đề nghị có trạng thái ""Đã thực hiện"" với các dòng đã giao/đã hủy toàn bộ';
			|ru = 'Заменяющие товары по документу ""%OrderDocument%"" оформлены не полностью.
			|Заявка может быть переведена в статус ""Выполнена"" только с полностью оформленными/отмененными строками';
			|en = 'Exchange goods for the ""%OrderDocument%"" document are not registered fully.
			|The request can be set to the ""Completed"" status only with fully registered/cancelled lines'; fa = 'Exchange goods for the ""%OrderDocument%"" document are not registered fully.
			|The request can be set to the ""Completed"" status only with fully registered/cancelled lines';
			|it = 'Exchange goods for the ""%OrderDocument%"" document are not registered fully.
			|The request can be set to the ""Completed"" status only with fully registered/cancelled lines';
			|pl = 'Exchange goods for the ""%OrderDocument%"" document are not registered fully.
			|The request can be set to the ""Completed"" status only with fully registered/cancelled lines';
			|tr = '""%OrderDocument%"" belgesi altındaki ikame ürünler tam olarak oluşturulamadı.
			|Bir sipariş, yalnızca tamamen oluşturuldu/iptal edildi satırlarla ""Tamamlandı"" durumuna aktarılabilir'");
		EndIf;
		
		ErrorText = StrReplace(ErrorText, "%OrderDocument%", ControlledOrder);
		
		ReportErrorToUser(
				ErrorText,
				ControlledOrder,
				,
				Cancel);
	EndIf;
	
	If SampleCalculations_.Next() Then 
		If TypeOf(ControlledOrder) = Type("DocumentRef.SalesOrder") Then
			ErrorText = NStr("vi = 'Chưa hoàn thành thanh toán theo đơn hàng ""%OrderDocument%"".
			|Để đóng đơn hàng, cần thanh toán %AmountToPay% %Currency%.
			|Chỉ có thể đóng đơn hàng với các dòng đã thanh toán/hủy bỏ toàn bộ';
			|ru = 'Расчеты по документу ""%OrderDocument%"" не завершены.
			|Для закрытия заказа требуется оплата %AmountToPay% %Currency%.
			|Закрытие заказа возможно только с полностью оплаченными/отмененными строками';
			|en = 'Settlements against the ""%OrderDocument%"" document are not completed.
			|To close the order, payment is required: %AmountToPay% %Currency%.
			|You can close the order only with fully paid/canceled lines'; fa = 'Settlements against the ""%OrderDocument%"" document are not completed.
			|To close the order, payment is required: %AmountToPay% %Currency%.
			|You can close the order only with fully paid/canceled lines';
			|it = 'I calcoli relativi al documento ""%OrderDocument%"" non sono completi.
			|Per la chiusura dell''ordine è necessario il pagamento %AmountToPay% %Currency%. 
			| La chiusura dell''ordine è possibile solamente se le voci sono completamente pagate/eliminate.';
			|pl = 'Obliczenia wg dokumentu ""%OrderDocument%"" nie są zakończone.
			|W celu zamknięcia zamówienia jest konieczna płatność %AmountToPay% %Currency%.
			|Zamknięcie zamówienia jest możliwe tylko z całkowicie opłaconymi/anulowanymi wierszami';
			|tr = '""%OrderDocument%"" belgesindeki ödemeler tamamlanmadı.
			|Bir siparişi kapatmak için %AmountToPay% %Currency% ödenmesi gerekiyor.
			|Bir siparişin kapatılması yalnızca tamamen ödenen/iptal edilen satırlarla mümkündür'");
		ElsIf TypeOf(ControlledOrder) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
			ErrorText = NStr("vi = 'Chưa hoàn thành thanh toán theo chứng từ ""%OrderDocument%"". Cần thanh toán %AmountToPay% %Currency%.
			|Chỉ có thể kết chuyển lại giấy đề nghị ở trạng thái ""Đã thực hiện"" với các dòng đã thanh toán/đã hủy toàn bộ';
			|ru = 'Расчеты по документу ""%OrderDocument%"" не завершены. Требуется оплата %AmountToPay% %Currency%.
			|Заявка может быть переведена в статус ""Выполнена"" только с полностью оплаченными/отмененными строками';
			|en = 'Settlements for the ""%OrderDocument%"" document are not completed. Payment is required: %AmountToPay% %Currency%.
			|The request can be transferred to the ""Completed"" status only with fully paid/canceled lines'; fa = 'Settlements for the ""%OrderDocument%"" document are not completed. Payment is required: %AmountToPay% %Currency%.
			|The request can be transferred to the ""Completed"" status only with fully paid/canceled lines';
			|it = 'I calcoli relativi al documento ""%OrderDocument% non sono completi. È richiesto il pagamento di %AmountToPay% %Currency%. 
			|La richiesta può passare allo stato ""Completata"" soltanto se le righe sono completamente pagate/cancellate';
			|pl = 'Obliczenia dla dokumentu ""%OrderDocument%"" nie są zakończone. Wymagana jest płatność %AmountToPay%%Currency%. 
			|Wniosek może zostać przeniesiony do statusu ""Wykonany"" tylko z w pełni opłaconymi/anulowanymi wierszami';
			|tr = '""%OrderDocument%"" belgesi için mutabakatlar tamamlanmadı. Ödeme gerekli %AmountToPay% %Currency%.
			|Sipariş yalnızca tamamen ödenmiş/iptal edilmiş satırlarda ""Tamamlandı"" durumuna aktarılabilir'");
		EndIf;
		
		ErrorText = StrReplace(ErrorText, "%OrderDocument%",        ControlledOrder);
		ErrorText = StrReplace(ErrorText, "%AmountToPay%", String(SampleCalculations_.AmountDueBalance));
		ErrorText = StrReplace(ErrorText, "%Currency%",       String(SampleCalculations_.Currency));
		
		ReportErrorToUser(
			ErrorText,
			ControlledOrder,
			,
			Cancel);
	EndIf;
	
EndProcedure

// Generates the request text for monitoring the completion of the order shipment
// and for monitoring the completion of the order calculations.
//
//	Returns:
//		String - generated request text
//
Function RequestTextOrderControlAfterExecution() Export
	
	QueryText =
	"SELECT
	|	ARAPObjects.Ref AS ARAPObject,
	|	ARAPObjects.Object AS Object
	|INTO ObjectsOfCalculationsControlOfOrderAfterCarryingOut
	|FROM Catalog.ARAPObjects AS ARAPObjects
	|WHERE
	|	ARAPObjects.Object IN (&DocumentsArray)
	|	AND NOT ARAPObjects.DeletionMark
	|;
	|SELECT DISTINCT
	|	ClosingControl.SalesOrder AS SalesOrder
	|INTO
	|	TTOrderBalances_
	|FROM (SELECT
	|	References.ReferenceOrder AS SalesOrder
	|FROM
	|	#ShipmentOrdersTurnoverExpanded AS References
	|WHERE
	|	&MonitorShipment
	|	AND ((References.OrderedQuantityTurnover -
	|		References.IssuedQuantityTurnover) > 0
	|		OR (References.ForRegistrationQuantityTurnover -
	|			References.IssuedQuantityTurnover) > 0)
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsForIssueBalance.DocumentShipments AS SalesOrder
	|FROM
	|	AccumulationRegister.GoodsForIssue.Balance(, 
	|			DocumentShipments IN (&DocumentsArray)
	|			AND CASE
	|				WHEN VALUETYPE(DocumentShipments) = TYPE(Document.SalesOrder)
	|					THEN CAST(DocumentShipments AS Document.SalesOrder).Status = VALUE(Enum.SalesOrderStatuses.Closed)
	|							AND CAST(DocumentShipments AS Document.SalesOrder).BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
	|							AND CAST(DocumentShipments AS Document.SalesOrder).BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale)
	|				ELSE CASE
	|						WHEN VALUETYPE(DocumentShipments) = TYPE(Document.RequestForReturnOfGoodsFromCustomer)
	|							THEN CAST(DocumentShipments AS Document.RequestForReturnOfGoodsFromCustomer).Status = VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.Executed)
	|								AND CAST(DocumentShipments AS Document.RequestForReturnOfGoodsFromCustomer).BusinessOperation <> VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent)
	|						ELSE TRUE
	|				END
	|			END
	|	) AS GoodsForIssueBalance
	|WHERE
	|	&MonitorShipment
	|	AND (GoodsForIssueBalance.ToShipBalance + GoodsForIssueBalance.AssembledBalance) > 0
	|
	|UNION ALL
	|
	|SELECT
	|	ARAPObjects.Object AS SalesOrder
	|FROM
	|	AccumulationRegister.CustomersARAPAccounting.Balance(, 
	|			ARAPObject IN (SELECT ARAPObject FROM ObjectsOfCalculationsControlOfOrderAfterCarryingOut)
	|			AND (&Status = VALUE(Enum.SalesOrderStatuses.Closed)
	|				OR &Status = VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.Executed))
	|	) AS CustomersARAPAccountingBalance
	|	INNER JOIN ObjectsOfCalculationsControlOfOrderAfterCarryingOut AS ARAPObjects
	|		ON ARAPObjects.ARAPObject = CustomersARAPAccountingBalance.ARAPObject
	|WHERE
	|	&MonitorCalculations
	|	AND CustomersARAPAccountingBalance.AmountDueBalance > 0
	|	AND (ARAPObjects.Object.BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
	|		AND ARAPObjects.Object.BusinessOperation <> VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale)
	|		AND ARAPObjects.Object.BusinessOperation <> VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent))
	|		AND ARAPObjects.Object.ARAPObjectSettings <> VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)) AS ClosingControl
	|;";
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.ConditionText =
		"ReferenceOrder IN (&DocumentsArray)
		|		AND &Status IN (VALUE(Enum.SalesOrderStatuses.Closed),
		|			VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.Executed))
		|		AND ReferenceOrder.BusinessOperation NOT IN (VALUE(Enum.BusinessTransactions.TransferToCommissionAgent),
		|			VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale),
		|			VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent))";
	TableFormationParameters.Group = "ReferenceOrder";
	TableFormationParameters.Indicators = "Ordered, ToRegister, Issued_1";
	TableFormationParameters.Resources = "Count";
	
	ShipmentOrdersTurnoverExpanded =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	QueryText = StrReplace(QueryText,
		"#ShipmentOrdersTurnoverExpanded",
		ShipmentOrdersTurnoverExpanded);
	
	Return QueryText;
	
EndFunction

// Generates the request text for checking the warehouse occupancy in the giver's Order
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectnessOfFillingWarehouseInGiverSOrder(QueryText)
	
	QueryText = QueryText +
	"SELECT
	|	ISNULL(MAX(ThereAreErrorsFillingWarehouse), FALSE) AS ThereAreErrorsFillingWarehouse,
	|	ISNULL(MAX(ThereAreErrorsFillingWarehouses), FALSE) AS ThereAreErrorsFillingWarehouses
	|
	|FROM
	|
	|(SELECT TOP 1
	|	TRUE AS ThereAreErrorsFillingWarehouse,
	|	FALSE AS ThereAreErrorsFillingWarehouses
	|
	|FROM
	|	TemporaryTableOfGoods_ AS Goods
	|
	|WHERE
	|	Goods.TSName = ""ManufacturedProduct""
	|	AND NOT Goods.Canceled
	|	AND NOT Goods.SupplyOption = VALUE(Enum.SupplyOptions.NotRequired)
	|	AND Goods.Products.ItemsType IN(
	|		VALUE(Enum.ItemsTypes.OwnGoods),
	|		VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND Goods.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
	|
	|UNION
	|
	|SELECT TOP 1
	|	FALSE AS ThereAreErrorsFillingWarehouse,
	|	TRUE AS ThereAreErrorsFillingWarehouses
	|
	|FROM
	|	TemporaryTableOfGoods_ AS Goods
	|
	|	LEFT JOIN TemporaryTableSalesDocument AS Sales
	|	ON TRUE
	|
	|WHERE
	|	Goods.TSName = ""UsedMaterials""
	|	AND NOT Goods.Canceled
	|	AND NOT Goods.Action = VALUE(Enum.ActionsOnMaterialsToSubcontract.UseAvailable)
	|	AND Sales.WarehouseForReceipt = VALUE(Catalog.Warehouses.EmptyRef)
	|
	|) AS NestedQuery
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
EndProcedure

// Generates the request text to check whether the "Warehouse" details are filled in the rows of the table parts of the giver's Order
// Verification should only be performed if:
// 		- the document header contains the "Warehouse" details for PM " Products";
// 		- in the header of the document, the "warehouse Access" details for PM "Materials"are filled in.
//
Procedure GenerateRequestForCorrectnessOfFillingWarehousesInTablePartOfGoodsOfGiverSOrder(QueryText)
	
	QueryText = QueryText + 
	"SELECT
	|	Goods.LineNumber AS LineNumber,
	|	Goods.TSName AS TSName,
	|	Goods.PresentationOfTS AS PresentationOfTS
	|
	|FROM
	|	TemporaryTableOfGoods_ AS Goods
	|
	|	LEFT JOIN
	|		TemporaryTableSalesDocument AS Sales
	|	ON
	|		TRUE
	|
	|WHERE
	|	Goods.TSName = ""ManufacturedProduct""
	|	AND Sales.Warehouse.IsFolder
	|	AND Sales.Warehouse <> VALUE(Catalog.Warehouses.EmptyRef)
	|	AND Goods.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
	|	AND Goods.Products.ItemsType IN (
	|								VALUE(Enum.ItemsTypes.OwnGoods),
	|								VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND NOT Goods.Canceled
	|	AND NOT Goods.SupplyOption = VALUE(Enum.SupplyOptions.NotRequired)
	|
	|UNION
	|
	|SELECT
	|	Goods.LineNumber AS LineNumber,
	|	Goods.TSName AS TSName,
	|	Goods.PresentationOfTS AS PresentationOfTS
	|
	|FROM
	|	TemporaryTableOfGoods_ AS Goods
	|
	|	LEFT JOIN
	|		TemporaryTableSalesDocument AS Sales
	|	ON
	|		TRUE
	|
	|WHERE
	|	Goods.TSName = ""UsedMaterials""
	|	AND Sales.WarehouseForReceipt.IsFolder
	|	AND Sales.WarehouseForReceipt <> VALUE(Catalog.Warehouses.EmptyRef)
	|	AND Goods.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
	|	AND Goods.Products.ItemsType IN (
	|								VALUE(Enum.ItemsTypes.OwnGoods),
	|								VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND NOT Goods.Canceled
	|	AND NOT Goods.Action = VALUE(Enum.ActionsOnMaterialsToSubcontract.UseAvailable)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
EndProcedure

