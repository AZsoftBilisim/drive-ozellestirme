// This is an agreement on a new commission.
// 
// Parameters:
//  Terms - CatalogRef.TermsOfSale
// 
// Returns:
//  Boolean - This Is The Agreement On The New Commission
Function ThisIsAgreementOnNewCommission(Terms) Export
	
	Result = False;
	
	SetPrivilegedMode(True);

	If ValueIsFilled(Terms) Then
		DetailsOfAgreement = Common.ObjectAttributesValues(Terms, "ConsignmentSales25, BusinessOperation");
		
		Result = DetailsOfAgreement.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent
			And DetailsOfAgreement.ConsignmentSales25;
		
	EndIf;

	SetPrivilegedMode(False);
	
	Return Result;
	
EndFunction

