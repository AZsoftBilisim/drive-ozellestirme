	OutputToReport = (ArrayOfDeviations <> Undefined);
	
	If Selection.Next() And Selection.ThereAreErrorsMatchingPrepaymentAmountToPaymentSchedule Then
		
		ErrorText = NStr("vi = 'Số tiền trả trước không bằng với số tiền đã tính theo lịch biểu thanh toán trong thỏa thuận %AmountOfAdvancePaymentAccordingToSchedule%';
						|ru = 'Сумма предоплаты не соответствует сумме, рассчитанной по графику оплаты соглашения %AmountOfAdvancePaymentAccordingToSchedule%';
						|en = 'Prepayment amount does not correspond to the amount calculated by payment schedule under agreement %AmountOfAdvancePaymentAccordingToSchedule%'; fa = 'Prepayment amount does not correspond to the amount calculated by payment schedule under agreement %AmountOfAdvancePaymentAccordingToSchedule%';
