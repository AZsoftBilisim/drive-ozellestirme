// Generates a request to check whether the VAT amount is correct depending on the VAT rate
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
// QueryOptions       - Structure - structure containing request parameters
//
Procedure GenerateRequestForCorrectVATAmount(QueryText, QueryOptions)
	
	QueryOptions.Insert("TaxationWithoutVAT_", VATAccountingERPClientServer.TypesOfTaxationThatHideVATDetails());
	QueryText = QueryText + 
	"SELECT
	|	TemporaryTableOfGoods_.LineNumber AS LineNumber,
	|	TemporaryTableOfGoods_.ProductsInSet AS ProductsInSet,
	|	TemporaryTableOfGoods_.ItemVariantOfSet AS ItemVariantOfSet,
	|	TemporaryTableOfGoods_.VATAmount AS VATAmount,
	|	TemporaryTableOfGoods_.VATRate AS VATRate,
	|	TemporaryTableSalesDocument.Currency AS Currency,
	|	CASE
	|		WHEN TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SubjectToVATFromPriceDifference) THEN
	|			FALSE
	|		WHEN TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SubjectToVATAtCustomer) THEN
	|			CASE TemporaryTableOfGoods_.VATAmount
	|				WHEN 0 THEN FALSE
	|				ELSE TRUE
	|			END
	|		WHEN TemporaryTableOfGoods_.VATRate.Rate1 > 0
	|			THEN CASE
	|					WHEN TemporaryTableSalesDocument.PriceIncludesVAT
	|						THEN CASE TemporaryTableOfGoods_.VATAmount - (CAST(TemporaryTableOfGoods_.Sum * (TemporaryTableOfGoods_.VATRate.Rate1 / 100) / ((TemporaryTableOfGoods_.VATRate.Rate1 + 100) / 100) AS NUMBER(31, 2)))
	|								WHEN 0
	|									THEN FALSE
	|								WHEN 0.01
	|									THEN FALSE
	|								WHEN -0.01
	|									THEN FALSE
	|								ELSE TRUE
	|							END
	|					ELSE CASE TemporaryTableOfGoods_.VATAmount - (CAST(TemporaryTableOfGoods_.Sum * (TemporaryTableOfGoods_.VATRate.Rate1 / 100) AS NUMBER(31, 2)))
	|							WHEN 0
	|								THEN FALSE
	|							WHEN 0.01
	|								THEN FALSE
	|							WHEN -0.01
	|								THEN FALSE
	|							ELSE TRUE
	|						END
	|				END
	|		ELSE FALSE
	|	END AS ThereAreErrorsVATAmount,
	|	CASE
	|		WHEN TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SubjectToVATAtCustomer) THEN
	|			0
	|		WHEN TemporaryTableOfGoods_.VATRate.Rate1 > 0
	|			THEN CASE
	|					WHEN TemporaryTableSalesDocument.PriceIncludesVAT
	|						THEN CAST(TemporaryTableOfGoods_.Sum * (TemporaryTableOfGoods_.VATRate.Rate1 / 100) / ((TemporaryTableOfGoods_.VATRate.Rate1 + 100) / 100) AS NUMBER(31, 2))
	|					ELSE CAST(TemporaryTableOfGoods_.Sum * (TemporaryTableOfGoods_.VATRate.Rate1 / 100) AS NUMBER(31, 2))
	|				END
	|		ELSE 0
	|	END AS VATAmountCalculated
	|FROM
	|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
	|		LEFT JOIN TemporaryTableSalesDocument AS TemporaryTableSalesDocument
	|		ON (TRUE)
	|WHERE
	|	NOT TemporaryTableSalesDocument.VATTaxation IN (&TaxationWithoutVAT_)
	|	AND CASE
	|			WHEN TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SubjectToVATFromPriceDifference) THEN
	|				FALSE
	|			WHEN TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SubjectToVATAtCustomer) THEN
	|				CASE TemporaryTableOfGoods_.VATAmount
	|				WHEN 0 THEN FALSE
	|				ELSE TRUE
	|			END
	|			WHEN TemporaryTableOfGoods_.VATRate.Rate1 > 0
	|				THEN CASE
	|						WHEN TemporaryTableSalesDocument.PriceIncludesVAT
	|							THEN CASE TemporaryTableOfGoods_.VATAmount - (CAST(TemporaryTableOfGoods_.Sum * (TemporaryTableOfGoods_.VATRate.Rate1 / 100) / ((TemporaryTableOfGoods_.VATRate.Rate1 + 100) / 100) AS NUMBER(31, 2)))
	|									WHEN 0
	|										THEN FALSE
	|									WHEN 0.01
	|										THEN FALSE
	|									WHEN -0.01
	|										THEN FALSE
	|									ELSE TRUE
	|								END
	|						ELSE CASE TemporaryTableOfGoods_.VATAmount - (CAST(TemporaryTableOfGoods_.Sum * (TemporaryTableOfGoods_.VATRate.Rate1 / 100) AS NUMBER(31, 2)))
	|								WHEN 0
	|									THEN FALSE
	|								WHEN 0.01
	|									THEN FALSE
	|								WHEN -0.01
	|									THEN FALSE
	|								ELSE TRUE
	|							END
	|					END
	|			ELSE FALSE
	|		END
	|;
	|";

EndProcedure

// Generates a request for checking the VAT rate depending on taxation.
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectnessOfSpecifyingSalesVATRate(QueryText)
	
	QueryText = QueryText
		+ "SELECT
		|	TemporaryTableOfGoods_.LineNumber AS LineNumber,
		|	TemporaryTableSalesDocument.VATTaxation AS VATTaxation,
		|	TemporaryTableOfGoods_.VATRate AS SelectedVATRate,
		|	CASE
		|		WHEN TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|			AND &ReturnOfMultiTurnContainers
		|			AND TemporaryTableOfGoods_.VATRate <> VALUE(Catalog.VATRates.EXCLUDINGVAT)
		|			THEN VALUE(Catalog.VATRates.EXCLUDINGVAT)
		|		WHEN TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
		|			AND TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
		|			AND TemporaryTableOfGoods_.VATRate <> ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
		|				VALUE(Catalog.VATRates.EmptyRef)))
		|			THEN ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))
		|		ELSE
		|			UNDEFINED
		|	END AS CorrectVATRate
		|FROM
		|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
		|	
		|	LEFT JOIN
		|		TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|	ON (TRUE)
		|	
		|	LEFT JOIN
		|		Catalog.VATRates.VATTaxationTypes AS VATRates
		|	ON
		|		VATRates.VATTaxationType = TemporaryTableSalesDocument.VATTaxation
		|		AND VATRates.Ref = TemporaryTableOfGoods_.VATRate
		|
		|	LEFT JOIN
		|		InformationRegister.ProductsVATRates.SliceLast(&DateOfReceiptOfVATRates,
		|			Products IN (SELECT Table.Products FROM TemporaryTableOfGoods_ AS Table)
		|	 		AND Country = &RegistrationCountry
		|		) AS ProductsVATRates
		|	ON
		|		TemporaryTableOfGoods_.Products = ProductsVATRates.Products
		|
		|	LEFT JOIN
		|		InformationRegister.BasicVATRates.SliceLast(&DateOfReceiptOfVATRates, Country = &RegistrationCountry) AS BasicVATRates
		|	ON
		|		TRUE
		|WHERE
		|	CASE
		|		WHEN TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|				AND &ReturnOfMultiTurnContainers
		|				AND TemporaryTableOfGoods_.VATRate <> VALUE(Catalog.VATRates.EXCLUDINGVAT)
		|			THEN TRUE
		|		WHEN TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
		|				AND TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
		|				AND TemporaryTableOfGoods_.VATRate <> ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
		|					VALUE(Catalog.VATRates.EmptyRef)))
		|			THEN TRUE
		|		WHEN VATRates.Ref IS NULL
		|			THEN TRUE
		|		ELSE FALSE
		|	END
		|;
		|";
	
EndProcedure

// Generates a request to verify the indication of the VAT rate for CO 2.5
// , depending on taxation and the option of specifying the rate in the price type.
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectnessOfSpecifyingSalesVATRate25(QueryText)
	
	QueryText = QueryText +
	"SELECT
	|	GoodsTable.LineNumber AS LineNumber,
	|	GoodsTable.PriceKind AS PriceKind,
	|	GoodsTable.Products AS Products,
	|	GoodsTable.Characteristic AS Characteristic,
	|	GoodsTable.Package AS Package,
	|	ISNULL(CASE
	|		WHEN TableOfProductTypes.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
	|			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	|		ELSE CharacteristicTable.ItemsCharacteristicForPricing
	|	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	|	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	|	CASE
	|		WHEN TableOfProductTypes.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
	|				OR (TableOfProductTypes.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.Use)
	|					AND PackingTableEI.Owner = VALUE(Catalog.PackagingGroups.BasicUnitsOfMeasure))
	|			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|		ELSE GoodsTable.Package
	|	END AS PricingPackage,
	|	TableTypesOfPrices.OptionForSpecifyingVATRates AS OptionForSpecifyingVATRates
	|INTO TempTableOfTSONomenclature
	|FROM
	|	TemporaryTableOfGoods_ AS GoodsTable
	|LEFT JOIN
	|	Catalog.Products AS ProductsTable
	|ON
	|	GoodsTable.Products = ProductsTable.Ref
	|LEFT JOIN
	|	Catalog.ItemsCharacteristics AS CharacteristicTable
	|ON
	|	GoodsTable.Characteristic = CharacteristicTable.Ref
	|LEFT JOIN
	|	Catalog.ItemKinds AS TableOfProductTypes
	|ON
	|	ProductsTable.ProductKind = TableOfProductTypes.Ref
	|LEFT JOIN
	|	Catalog.TypesOfPrices AS TableTypesOfPrices
	|ON
	|	GoodsTable.PriceKind = TableTypesOfPrices.Ref
	|LEFT JOIN
	|	Catalog.PackagesAndUnitsOfMeasure AS PackingTableEI
	|ON
	|	GoodsTable.Package = PackingTableEI.Ref
	|WHERE
	|	GoodsTable.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
	|	AND TableTypesOfPrices.OptionForSpecifyingVATRates <> VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.EmptyRef)
	|	AND NOT TableTypesOfPrices.UseForRetailSalesToCustomers
	|	AND (TableTypesOfPrices.UseForWholesaleToCustomers OR TableTypesOfPrices.UseForIntercompanySales)
	|INDEX BY
	|	Products,
	|	PricingVariant,
	|	PricingBatch,
	|	PricingPackage,
	|	PriceKind
	|////////////////////////////////////////////////
	|;
	|SELECT
	|	Price_Table.Products AS Products,
	|	Price_Table.PricingVariant AS PricingVariant,
	|	Price_Table.PricingBatch AS PricingBatch,
	|	Price_Table.PricingPackage AS PricingPackage,
	|	Price_Table.PriceKind AS PriceKind,
	|	Price_Table.Package AS Package,
	|	Price_Table.Currency AS Currency,
	|	Price_Table.VATRate AS VATRate
	|INTO TempTableOfPriceOfItemOfCentralOffice
	|FROM
	|	InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&DateOfReceiptOfVATRates, DAY),
	|		(Products, PricingVariant, PricingBatch, PricingPackage, PriceKind) IN
	|			(SELECT
	|				ProductsTable.Products,
	|				ProductsTable.PricingVariant,
	|				ProductsTable.PricingBatch,
	|				ProductsTable.PricingPackage,
	|				ProductsTable.PriceKind
	|			FROM
	|				TempTableOfTSONomenclature AS ProductsTable)
	|	) AS Price_Table
	|INDEX BY
	|	Products,
	|	PricingVariant,
	|	PricingBatch,
	|	PricingPackage,
	|	PriceKind
	|////////////////////////////////////////////////
	|;
	|SELECT
	|	ProductsTable.LineNumber AS LineNumber,
	|	ProductsTable.PriceKind AS PriceKind,
	|	ProductsTable.Products AS Products,
	|	ProductsTable.Characteristic AS Characteristic,
	|	ProductsTable.Package AS Package,
	|	ProductsTable.OptionForSpecifyingVATRates AS OptionForSpecifyingVATRates,
	|	ISNULL(ItemsPrices.VATRate, VALUE(Catalog.VATRates.EmptyRef)) AS VATRate
	|INTO TempTableOfCentralBankPrices
	|FROM
	|	TempTableOfTSONomenclature AS ProductsTable
	|LEFT JOIN
	|	TempTableOfPriceOfItemOfCentralOffice AS ItemsPrices
	|ON
	|	ProductsTable.Products = ItemsPrices.Products
	|	AND ProductsTable.PricingVariant = ItemsPrices.PricingVariant
	|	AND ProductsTable.PricingBatch = ItemsPrices.PricingBatch
	|	AND ProductsTable.PricingPackage = ItemsPrices.PricingPackage
	|	AND ProductsTable.PriceKind = ItemsPrices.PriceKind
	|////////////////////////////////////////////////
	|;
	|SELECT
	|	TemporaryTableOfGoods_.LineNumber AS LineNumber,
	|	TemporaryTableSalesDocument.VATTaxation AS VATTaxation,
	|	TemporaryTableOfGoods_.VATRate AS SelectedVATRate,
	|	CASE
	|		WHEN TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND &ReturnOfMultiTurnContainers
	|				AND TemporaryTableOfGoods_.VATRate <> VALUE(Catalog.VATRates.EXCLUDINGVAT)
	|			THEN VALUE(Catalog.VATRates.EXCLUDINGVAT)
	|		WHEN (TableOfPricesOfCentral.OptionForSpecifyingVATRates IS NULL
	|				OR TableOfPricesOfCentral.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.NotSpecifiedVATRates))
	|				AND TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	|				AND TemporaryTableOfGoods_.VATRate <> ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
	|					VALUE(Catalog.VATRates.EmptyRef)))
	|			THEN ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))
	|		WHEN TableOfPricesOfCentral.OptionForSpecifyingVATRates <> VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.NotSpecifiedVATRates)
	|				AND TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	|				AND TemporaryTableOfGoods_.VATRate <> ISNULL(TableOfPricesOfCentral.VATRate, VALUE(Catalog.VATRates.EmptyRef))
	|			THEN ISNULL(TableOfPricesOfCentral.VATRate, VALUE(Catalog.VATRates.EmptyRef))
	|		ELSE
	|			UNDEFINED
	|	END AS CorrectVATRate
	|FROM
	|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
	|	
	|	LEFT JOIN
	|		TemporaryTableSalesDocument AS TemporaryTableSalesDocument
	|	ON (TRUE)
	|	
	|	LEFT JOIN
	|		Catalog.VATRates.VATTaxationTypes AS VATRates
	|	ON
	|		VATRates.VATTaxationType = TemporaryTableSalesDocument.VATTaxation
	|		AND VATRates.Ref = TemporaryTableOfGoods_.VATRate
	|
	|	LEFT JOIN
	|		InformationRegister.ProductsVATRates.SliceLast(&DateOfReceiptOfVATRates,
	|			Products IN (SELECT Table.Products FROM TemporaryTableOfGoods_ AS Table)
	| 			AND Country = &RegistrationCountry
	|		) AS ProductsVATRates
	|	ON
	|		TemporaryTableOfGoods_.Products = ProductsVATRates.Products
	|
	|	LEFT JOIN
	|		InformationRegister.BasicVATRates.SliceLast(&DateOfReceiptOfVATRates, Country = &RegistrationCountry) AS BasicVATRates
	|	ON
	|		TRUE
	|	LEFT JOIN
	|		TempTableOfCentralBankPrices AS TableOfPricesOfCentral
	|	ON
	|		TemporaryTableOfGoods_.LineNumber = TableOfPricesOfCentral.LineNumber
	|		AND TemporaryTableOfGoods_.PriceKind = TableOfPricesOfCentral.PriceKind
	|		AND TemporaryTableOfGoods_.Products = TableOfPricesOfCentral.Products
	|		AND TemporaryTableOfGoods_.Characteristic = TableOfPricesOfCentral.Characteristic
	|		AND TemporaryTableOfGoods_.Package = TableOfPricesOfCentral.Package
	|WHERE
	|	CASE
	|		WHEN TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND &ReturnOfMultiTurnContainers
	|				AND TemporaryTableOfGoods_.VATRate <> VALUE(Catalog.VATRates.EXCLUDINGVAT)
	|			THEN TRUE
	|		WHEN (TableOfPricesOfCentral.OptionForSpecifyingVATRates IS NULL
	|				OR TableOfPricesOfCentral.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.NotSpecifiedVATRates))
	|				AND TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	|				AND TemporaryTableOfGoods_.VATRate <> ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
	|					VALUE(Catalog.VATRates.EmptyRef)))
	|			THEN TRUE
	|		WHEN TableOfPricesOfCentral.OptionForSpecifyingVATRates <> VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.NotSpecifiedVATRates)
	|				AND TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)
	|				AND TemporaryTableSalesDocument.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	|				AND TemporaryTableOfGoods_.VATRate <> ISNULL(TableOfPricesOfCentral.VATRate, VALUE(Catalog.VATRates.EmptyRef))
	|			THEN TRUE
	|		WHEN VATRates.Ref IS NULL
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|;
	|";
	
EndProcedure

// Generates a request to check the correctness of the VAT amount depending on the amount when VAT is included in the price
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectAmountAndVATAmount(QueryText)
	
	QueryText = QueryText + "SELECT
	|	TemporaryTableOfGoods_.LineNumber AS LineNumber,
	|	TemporaryTableOfGoods_.ProductsInSet AS ProductsInSet,
	|	TemporaryTableOfGoods_.ItemVariantOfSet AS ItemVariantOfSet,
	|	TemporaryTableOfGoods_.Sum AS Sum,
	|	TemporaryTableOfGoods_.VATAmount AS VATAmount,
	|	TemporaryTableOfGoods_.VATRate AS VATRate,
	|	TemporaryTableSalesDocument.Currency AS Currency,
	|	CASE
	|		WHEN TemporaryTableOfGoods_.Sum < 0 AND TemporaryTableOfGoods_.Sum - TemporaryTableOfGoods_.VATAmount <= 0
	|			THEN FALSE
	|		WHEN TemporaryTableOfGoods_.Sum >= 0 AND TemporaryTableOfGoods_.Sum - TemporaryTableOfGoods_.VATAmount >= 0
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS ThereAreErrorsVATAmount
	|FROM
	|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
	|		LEFT JOIN TemporaryTableSalesDocument AS TemporaryTableSalesDocument
	|		ON (TRUE)
	|WHERE
	|	CASE
	|		WHEN TemporaryTableOfGoods_.Sum < 0 AND TemporaryTableOfGoods_.Sum - TemporaryTableOfGoods_.VATAmount <= 0
	|			THEN FALSE
	|		WHEN TemporaryTableOfGoods_.Sum >= 0 AND TemporaryTableOfGoods_.Sum - TemporaryTableOfGoods_.VATAmount >= 0
	|			THEN FALSE
	|		ELSE TRUE
	|	END
	|;
	|";
	
EndProcedure

// Generates the request text to check whether manual discounts and markups are allowed
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestWhetherManualDiscountsAndSurchargesAreAcceptable(QueryText)
	
	QueryText = QueryText + "SELECT
	                              |	TemporaryTableOfGoods_.IsRecordsSet AS IsRecordsSet,
	                              |	TemporaryTableOfGoods_.TheseAreComponents AS TheseAreComponents,
	                              |	TemporaryTableOfGoods_.ProductsInSet AS ProductsInSet,
	                              |	TemporaryTableOfGoods_.ItemVariantOfSet AS ItemVariantOfSet,
	                              |	TemporaryTableOfGoods_.LineNumber AS LineNumber,
	                              |	CASE
	                              |		WHEN TemporaryTableOfGoods_.PercentRateOfManualDiscount > 0
	                              |				AND TemporaryTableOfGoods_.PercentRateOfManualDiscount > TemporaryTableLimitingManualDiscounts.PercentRateOfManualDiscount
	                              |			THEN TRUE
	                              |		ELSE FALSE
	                              |	END AS ThereAreErrorsFillingManualDiscount,
	                              |	CASE
	                              |		WHEN TemporaryTableOfGoods_.PercentRateOfManualDiscount < 0
	                              |				AND -TemporaryTableOfGoods_.PercentRateOfManualDiscount > TemporaryTableLimitingManualDiscounts.MaximumPercentageForManualMarkup
	                              |			THEN TRUE
	                              |		ELSE FALSE
	                              |	END AS ThereAreErrorsFillingManualMarkUp,
	                              |	TemporaryTableLimitingManualDiscounts.PercentRateOfManualDiscount AS MaximumAmountOfManualDiscount,
	                              |	TemporaryTableLimitingManualDiscounts.MaximumPercentageForManualMarkup AS MaximumAmountOfManualMarkUp
								  |FROM
	                              |	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
	                              |		LEFT JOIN TemporaryTableLimitingManualDiscounts AS TemporaryTableLimitingManualDiscounts
	                              |		ON (TemporaryTableOfGoods_.Products.PriceGroup = TemporaryTableLimitingManualDiscounts.PriceGroup
	                              |				OR NOT TemporaryTableOfGoods_.Products.PriceGroup IN
	                              |							(SELECT
	                              |								T.PriceGroup
	                              |							FROM
	                              |								TemporaryTableLimitingManualDiscounts AS T)
	                              |					AND TemporaryTableLimitingManualDiscounts.PriceGroup = VALUE(Catalog.PriceGroups.EmptyRef))
	                              |WHERE
	                              |	TemporaryTableOfGoods_.PercentRateOfManualDiscount <> 0
	                              |	AND (TemporaryTableOfGoods_.RowCode = 0
	                              |			OR &NotCheckLineCode)
	                              |	AND NOT TemporaryTableOfGoods_.Canceled
	                              |
	                              |ORDER BY
	                              |	LineNumber
								  |;
								  |";
	
EndProcedure

Procedure GenerateRequestThatMatchesPrepaymentAmountToPaymentSchedule(QueryText)
	
	QueryText = QueryText + "
		|SELECT
		|	CASE
		|		WHEN
		|			CAST(
		|				CASE
		|					WHEN MAX(SettlementsAmounts.AmountToPay) > 0
		|						THEN SUM(Data_PaymentSchedule.PaymentPercentage) / 100 * MAX(SettlementsAmounts.AmountToPay)
		|					ELSE 0
		|				END + 
		|				CASE
		|					WHEN MAX(SettlementsAmounts.PackageDepositValue) > 0
		|						THEN SUM(Data_PaymentSchedule.PackageDepositPercentage) / 100 * MAX(SettlementsAmounts.PackageDepositValue)
		|					ELSE 0
		|				END AS NUMBER(31,2))
		|					<> SUM(TimeTableStagesOfPaymentSchedule.PaymentAmount)
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsMatchingPrepaymentAmountToPaymentSchedule,
		|	CAST(
		|		CASE
		|			WHEN MAX(SettlementsAmounts.AmountToPay) > 0
		|				THEN SUM(Data_PaymentSchedule.PaymentPercentage) / 100 * MAX(SettlementsAmounts.AmountToPay)
		|			ELSE 0
		|		END + 
		|		CASE
		|			WHEN MAX(SettlementsAmounts.PackageDepositValue) > 0
		|				THEN SUM(Data_PaymentSchedule.PackageDepositPercentage) / 100 * MAX(SettlementsAmounts.PackageDepositValue)
		|			ELSE 0
		|		END AS NUMBER(31,2)) AS AmountOfAdvancePaymentAccordingToSchedule
		|
		|FROM
		|	Catalog.TermsOfSale.PaymentScheduleSteps AS Data_PaymentSchedule
		|
		|	INNER JOIN
		|		TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|	ON
		|		Data_PaymentSchedule.Ref = TemporaryTableSalesDocument.Terms
		|
		|	INNER JOIN
		|		TimeTableStagesOfPaymentSchedule AS TimeTableStagesOfPaymentSchedule
		|	ON
		|		TimeTableStagesOfPaymentSchedule.PaymentOption IN 
		|			(VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeProvision),
		|			VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeShipment))
		|	
		|	INNER JOIN 
		|		TemporaryTableOfSettlementAmounts AS SettlementsAmounts ON TRUE
		|	
		|
		|WHERE
		|	&UseStatusesOfGoodsServicesSales
		|	AND Data_PaymentSchedule.Ref.PaymentSchedule = VALUE(Catalog.PaymentSchedules.EmptyRef)
		|	AND (Data_PaymentSchedule.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeProvision)
		|	OR Data_PaymentSchedule.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeShipment))
		|
		|UNION ALL
		|
		|SELECT
		|	CASE
		|		WHEN
		|			CAST(
		|			CASE
		|				WHEN MAX(SettlementsAmounts.AmountToPay) > 0
		|					THEN SUM(Data_PaymentSchedule.PaymentPercentage) / 100 * MAX(SettlementsAmounts.AmountToPay)
		|				ELSE 0
		|			END + 
		|			CASE
		|				WHEN MAX(SettlementsAmounts.PackageDepositValue) > 0
		|					THEN SUM(Data_PaymentSchedule.PackageDepositPercentage) / 100 * MAX(SettlementsAmounts.PackageDepositValue)
		|				ELSE 0
		|			END AS NUMBER(31,2))
		|				<> MAX(TimeTableStagesOfPaymentSchedule.PaymentAmount)
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsMatchingPrepaymentAmountToPaymentSchedule,
		|	CAST(
		|		CASE
		|			WHEN MAX(SettlementsAmounts.AmountToPay) > 0
		|				THEN SUM(Data_PaymentSchedule.PaymentPercentage) / 100 * MAX(SettlementsAmounts.AmountToPay)
		|			ELSE 0
		|		END + 
		|		CASE
		|			WHEN MAX(SettlementsAmounts.PackageDepositValue) > 0
		|				THEN SUM(Data_PaymentSchedule.PackageDepositPercentage) / 100 * MAX(SettlementsAmounts.PackageDepositValue)
		|			ELSE 0
		|		END AS NUMBER(31,2)) AS AmountOfAdvancePaymentAccordingToSchedule
		|
		|FROM
		|	Catalog.PaymentSchedules.Stages AS Data_PaymentSchedule
		|
		|	INNER JOIN
		|		Catalog.TermsOfSale AS TheseAgreements
		|		
		|		INNER JOIN
		|			TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|		ON
		|			TheseAgreements.Ref = TemporaryTableSalesDocument.Terms
		|		
		|	ON
		|		Data_PaymentSchedule.Ref = TheseAgreements.PaymentSchedule
		|
		|	INNER JOIN
		|		TemporaryTableOfSettlementAmounts AS SettlementsAmounts ON TRUE
		|
		|	INNER JOIN
		|		TimeTableStagesOfPaymentSchedule AS TimeTableStagesOfPaymentSchedule
		|	ON
		|		TimeTableStagesOfPaymentSchedule.PaymentOption IN 
		|			(VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeProvision),
		|			VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeShipment))
		|
		|WHERE
		|	&UseStatusesOfGoodsServicesSales
		|	AND (Data_PaymentSchedule.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeProvision)
		|	OR Data_PaymentSchedule.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeShipment))
		|
		|;
		|";
	
EndProcedure


// Generates the request text to check whether prices are filled in in the document
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestToFillInPrices(QueryText)
	
	QueryText = QueryText + "
		|SELECT
		|	TemporaryTableOfGoods_.SourceLineNumber AS LineNumber,
		|	CASE
		|		WHEN
		|			TemporaryTableOfGoods_.Sum = 0
		|		THEN 
		|			CASE 
		|				WHEN &ReturnOfMultiTurnContainers AND NOT &PackageDepositIsRequired
		|					AND TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage) THEN
		|					
		|					FALSE
		|				ELSE
		|					TRUE
		|			END
		|		ELSE
		|			FALSE
		|	END                                            AS ThereAreErrorsFillingAmounts,
		|	CASE
		|		WHEN
		|			TemporaryTableOfGoods_.Price = 0
		|		THEN 
		|			CASE 
		|				WHEN &ReturnOfMultiTurnContainers AND NOT &PackageDepositIsRequired
		|					AND TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage) THEN
		|					
		|					FALSE
		|				ELSE
		|					TRUE
		|			END
		|		ELSE
		|			FALSE
		|	END                                            AS ThereAreErrorsFillingPrices
		|FROM
		|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
		|WHERE
		|	NOT TemporaryTableOfGoods_.IsRecordsSet
		|ORDER BY
		|	LineNumber ASC
		|;
		|";
	
EndProcedure
	
// Generates the request text to check whether prices are filled in in the document "customer acceptance Certificate".
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure FormRequestForPriceFillingControlAct(QueryText)
	
	QueryText = QueryText + "
		|SELECT
		|	TemporaryTableOfGoods_.SourceLineNumber AS LineNumber,
		|	CASE
		|		WHEN
		|			TemporaryTableOfGoods_.Price = 0
		|		THEN 
		|			CASE 
		|				WHEN &ReturnOfMultiTurnContainers AND NOT &PackageDepositIsRequired
		|					AND TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage) THEN
		|					
		|					FALSE
		|				ELSE
		|					TRUE
		|			END
		|		ELSE
		|			FALSE
		|	END                                            AS ThereAreErrorsFillingPrices,
		|	FALSE AS ThereAreErrorsFillingAmounts
		|FROM
		|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
		|WHERE
		|	NOT TemporaryTableOfGoods_.IsRecordsSet
		|ORDER BY
