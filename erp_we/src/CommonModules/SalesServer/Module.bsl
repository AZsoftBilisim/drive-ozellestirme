//
// Returns:
//  Boolean - indicates that it is necessary to set a bid without SDS.
//
Function BusinessTransactionWithRateWithoutVAT(BusinessOperation) Export
	
	OperationArray = New Array();
	OperationArray.Add(Enums.BusinessTransactions.ReceivingForStorageWithRightOfSale);
	OperationArray.Add(Enums.BusinessTransactions.TransferToCommissionAgent);
	OperationArray.Add(Enums.BusinessTransactions.ReturnFromCommissionAgent);
	OperationArray.Add(Enums.BusinessTransactions.TransferToStorageWithRightOfSale);
	OperationArray.Add(Enums.BusinessTransactions.ReturnFromCustodian);
	OperationArray.Add(Enums.BusinessTransactions.TransferOfGoodsToCommissionAgentInAnotherCompany);
	
	OperationWithoutVAT = OperationArray.Find(BusinessOperation) <> Undefined;
	
	Return OperationWithoutVAT;
	
EndFunction

// Establishes the procedure for settlements between organizations depending on the selected Contracts with the intermediary.
//
// Parameters:
//  DocumentObject - DocumentObject.CustomerInvoiceIntercompany,
//  	Document object.Return of Goods between organizations,
//  	Document object.Report of the Commission between organizations,
//  	Document object.The report of the Commission about the organization's description is the object of the document.
//
Procedure EstablishProcedureForSettlementsBetweenOrganizations(DocumentObject) Export
	
	If ValueIsFilled(DocumentObject.SalesContract)
		And ValueIsFilled(DocumentObject.PurchasingContract) Then
		
		ArrayOfContracts = New Array;
		ArrayOfContracts.Add(DocumentObject.SalesContract);
		ArrayOfContracts.Add(DocumentObject.PurchasingContract);
		
		CalculationProcedures = Common.ObjectsAttributeValue(ArrayOfContracts, "ARAPObjectSettings");
		
		If CalculationProcedures.Get(DocumentObject.SalesContract) = Enums.ARAPObjectSettings.ByCounterpartyContracts
			And CalculationProcedures.Get(DocumentObject.SalesContract) = CalculationProcedures.Get(DocumentObject.PurchasingContract) Then
			ProcedureForCalculatingDocument = Enums.ARAPObjectSettings.ByCounterpartyContracts;
		Else
			ProcedureForCalculatingDocument = Enums.ARAPObjectSettings.ByARAPDocuments;
		EndIf;
		
		If DocumentObject.ARAPObjectSettings <> ProcedureForCalculatingDocument Then
			DocumentObject.ARAPObjectSettings = ProcedureForCalculatingDocument;
		EndIf;
			
	EndIf;
	
EndProcedure

// Splits an array of documents into parts for which the availability of settlement objects and payment schedules is provided or not provided.
//
// Parameters:
// 	DocumentsArray - Array of DocumentRef
//
// Returns:
// 	Structure:
// 		* DocumentsWithCalculationObjects - Array
// 		* DocumentsWithoutCalculationObjects - Array
//
Function DocumentsBasedOnAvailabilityOfSettlementObjects(DocumentsArray) Export
	
	Result = New Structure;
	Result.Insert("DocumentsWithCalculationObjects", New Array());
	Result.Insert("DocumentsWithoutCalculationObjects", New Array());
	
	For Each Document In DocumentsArray Do // - DocumentRef.GoodsShipmentToCustomer, DocumentRef.SourceDocument -
		
		If TypeOf(Document) = Type("DocumentRef.GoodsShipmentToCustomer")
			Or TypeOf(Document) = Type("DocumentRef.SourceDocument")
				And Common.ObjectAttributeValue(Document, "SourceDocumentType") =
				Enums.SourceDocumentTypes.GoodsShipmentToCustomer Then
			
			If Result.DocumentsWithoutCalculationObjects.Find(Document) = Undefined Then
				Result.DocumentsWithoutCalculationObjects.Add(Document);
			EndIf;
			
		ElsIf TypeOf(Document) = Type("DocumentRef.SalesOrder")
			Or TypeOf(Document) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
			
			If Result.DocumentsWithCalculationObjects.Find(Document) = Undefined Then
				Result.DocumentsWithCalculationObjects.Add(Document);
			EndIf;
			
		EndIf;
		
	EndDo;
	
	Return Result;
	
EndFunction

// Returns an indication that all goods
// are shipped on the same date according to the specified shipment order, as well as the date of shipment.
//
// Parameters:
// 	DocumentSales - DocumentRef.CustomerInvoice
//
// Returns:
// 	Structure:
// 		* ShipmentByOneDate - Boolean
// 		* DateOfShipment - Date
// 		* MessageText - String
//
Function GetParametersOfChainOfSalesDocuments(DocumentSales) Export
	
	Result = New Structure;
	Result.Insert("ShipmentByOneDate", False);
	Result.Insert("DateOfShipment", Date(1, 1, 1));
	Result.Insert("MessageText", "");
	
	Query = New Query;
	Query.SetParameter("DocumentSales", DocumentSales);
	Query.Text =
	"SELECT DISTINCT
	|	GoodsTable.SalesOrder AS SalesOrder
	|INTO TableOfShipmentOrders
	|FROM
	|	Document.CustomerInvoice.Goods AS GoodsTable
	|WHERE
	|	GoodsTable.Ref = &DocumentSales
	|INDEX BY
	|	SalesOrder
	|;
	|
	|SELECT DISTINCT
	|	RegisterRecordTable.Recorder AS Recorder
	|FROM
	|	AccumulationRegister.ShipmentAndReturnReferences AS RegisterRecordTable
	|WHERE
	|	RegisterRecordTable.ReferenceOrder IN
	|		(SELECT
	|			TableOfShipmentOrders.SalesOrder AS SalesOrder
	|		FROM
	|			TableOfShipmentOrders AS TableOfShipmentOrders)
	|	AND VALUETYPE(RegisterRecordTable.Recorder) IN
	|		(TYPE(Document.GoodsShipmentToCustomer), TYPE(Document.SourceDocument))
	|;
	|
	|SELECT
	|	ShippingOrdersTurnover.ReferenceOrder AS ReferenceOrder
	|FROM
	|	#ShipmentOrdersTurnoverExpanded AS ShippingOrdersTurnover
	|WHERE
	|	ShippingOrdersTurnover.QuantityToBeShippedTurnover >
	|	ShippingOrdersTurnover.ShippedQuantityTurnover";
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.ConditionText =
		"ReferenceOrder IN
		|		(SELECT
		|			TableOfShipmentOrders.SalesOrder AS SalesOrder
		|		FROM
		|			TableOfShipmentOrders AS TableOfShipmentOrders)";
	TableFormationParameters.Group = "ReferenceOrder";
	TableFormationParameters.Indicators = "ToShip, Shipped";
	TableFormationParameters.Resources = "Count";
	
	ShipmentOrdersTurnoverExpanded =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	Query.Text = StrReplace(Query.Text,
		"#ShipmentOrdersTurnoverExpanded",
		ShipmentOrdersTurnoverExpanded);
	
	QueryResults = Query.ExecuteBatch();
	
	ShipmentDocumentsTable = QueryResults[QueryResults.UBound() - 1].Unload();
	If ShipmentDocumentsTable.Count() = 0 Then
		
		Result.MessageText = StrTemplate(
			NStr("vi = 'Không tìm thấy hàng hóa đã giao theo chứng từ %1.';
				|ru = 'Не найдены отгруженные товары по документу %1.';
				|en = 'Shipped goods of the ""%1"" document are not found.'; fa = 'Shipped goods of the ""%1"" document are not found.';
				|it = 'Shipped goods of the ""%1"" document are not found.';
				|pl = 'Shipped goods of the ""%1"" document are not found.';
				|tr = '%1 belgesine göre sevk edilen ürünler bulunamadı.'"),
			DocumentSales);
		
	ElsIf ShipmentDocumentsTable.Count() > 1 Then
		
		Result.MessageText = StrTemplate(
			NStr("vi = 'Hàng hóa theo chứng từ %1 đã giao bởi nhiều chứng từ khác nhau.';
				|ru = 'Товары по документу %1 были отгружены разными документами.';
				|en = 'Goods from the ""%1"" document were shipped by different documents.'; fa = 'Goods from the ""%1"" document were shipped by different documents.';
				|it = 'Goods from the ""%1"" document were shipped by different documents.';
				|pl = 'Goods from the ""%1"" document were shipped by different documents.';
				|tr = '%1 belgesine göre ürünler, farklı belgelerle sevk edildi.'"),
			DocumentSales);
		
	Else
		
		ResultOfRemainingShippedItems = QueryResults[QueryResults.UBound()];
		If ResultOfRemainingShippedItems.IsEmpty() Then
			
			Result.ShipmentByOneDate = True;
			
			DocumentShipments = ShipmentDocumentsTable.Get(0).Recorder;
			If TypeOf(DocumentShipments) = Type("DocumentRef.SalesOrder") Then
				
				Result.DateOfShipment = Common.ObjectAttributeValue(
					DocumentShipments,
					"DateOfShipment");
				
			ElsIf TypeOf(DocumentShipments) = Type("DocumentRef.GoodsShipmentToCustomer")
				Or TypeOf(DocumentShipments) = Type("DocumentRef.SourceDocument") Then
				
				Result.DateOfShipment = BegOfDay(
					Common.ObjectAttributeValue(
						DocumentShipments,
						"Date"));
				
			EndIf;
			
		Else
			
			Result.MessageText = StrTemplate(
				NStr("vi = 'Theo chứng từ %1 đã giao không phải tất cả hàng hóa.';
					|ru = 'По документу %1 были отгружены не все товары.';
					|en = 'Not all goods are shipped under the ""%1"" document.'; fa = 'Not all goods are shipped under the ""%1"" document.';
					|it = 'Not all goods are shipped under the ""%1"" document.';
					|pl = 'Not all goods are shipped under the ""%1"" document.';
					|tr = 'Tüm ürünler, %1 belgesine göre gönderilmedi.'"),
				DocumentSales);
			
		EndIf;
		
	EndIf;
	
	Return Result;
	
EndFunction

// Returns the condition that the order type matches the type of sales documents.
//
// Parameters:
// 	TextOfOrderField - String - a request field containing a link to the order.
//
// Returns:
// 	String
//
Function TextOfConditionIsSalesDocument(TextOfOrderField) Export
	
	Return StrTemplate(
		"(VALUETYPE(%1) = TYPE(Document.GoodsShipmentToCustomer)
		|	OR VALUETYPE(%1) = TYPE(Document.SaleAdjustment)
		|	OR VALUETYPE(%1) = TYPE(Document.RequestForReturnOfGoodsFromCustomer)
		|	OR VALUETYPE(%1) = TYPE(Document.SalesOrder)
		|		AND CAST(%1 AS Document.SalesOrder).BusinessOperation NOT IN
		|			(VALUE(Enum.BusinessTransactions.TransferToCommissionAgent),
		|			VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale))
		|	OR VALUETYPE(%1) = TYPE(Document.SourceDocument)
		|		AND CAST(%1 AS Document.SourceDocument).SourceDocumentType =
		|			VALUE(Enum.SourceDocumentTypes.GoodsShipmentToCustomer))", // @query-part
		TextOfOrderField);
	
EndFunction

#Region BatchProcessingOfTableParts

// Adds a request to the request package to get the data required to fill in the sales conditions.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - Structure
//
Procedure CompleteQueryTextAndFillInSalesConditions(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var ActionParameters;
	
	YouNeedToPerformFollowingActions = BatchProcessingOfTablePartServer.YouNeedToPerformAction("FillIn_TermsOfSales",
		StructureOfActions,
		CachedValues,
		ActionParameters);
	
	If YouNeedToPerformFollowingActions Then
		
		If Not CachedValues.Property("UsePriceManagementSystem25") Then
			
			RequestDate_ = ?(ValueIsFilled(ActionParameters.Date),
				ActionParameters.Date,
				CurrentSessionDate());
			
			CachedValues.Insert("UsePriceManagementSystem25",
				PriceManagementSystemServerCall.UsePriceManagementSystem25(RequestDate_));
			
		EndIf;
		
		If CachedValues.UsePriceManagementSystem25 Then
			ListOfRequests = QueryTextsSalesConditions25BatchProcessing(False, ActionParameters, CachedValues);
		Else
			
			ColumnsNames = EnterprisePricesFillingServer.ColumnNamesOfTemporaryProductTable();
			If BatchProcessingOfTablePartServer.ThereIsColumnInDataSource("Package", CachedValues) Then
				ColumnsNames.ColumnNamePackaging = "Package";
			EndIf;
			
			ListOfRequests = QueryTextsSalesConditionsBatchProcessing(False, ColumnsNames);
			
		EndIf;
		
		For Each ListItem In ListOfRequests Do
			QueryDetails.QueriesTexts.Add(ListItem.Value, ListItem.Presentation);
		EndDo;
		
		QueryDetails.QueryOptions.Insert("Terms", ActionParameters.Terms);
		QueryDetails.QueryOptions.Insert("Partner", ActionParameters.Partner);
		QueryDetails.QueryOptions.Insert("Contract", ActionParameters.Contract);
		QueryDetails.QueryOptions.Insert("ThisIsSaleToEndCustomer", ActionParameters.ThisIsSaleToEndCustomer);
		QueryDetails.QueryOptions.Insert("BaseCurrency", SettingsValueCached.DefaultBaseCurrency());
		QueryDetails.QueryOptions.Insert("Currency", ActionParameters.Currency);
		QueryDetails.QueryOptions.Insert("Date", ActionParameters.Date);
			
	EndIf;
	
	YouNeedToPerformFollowingActions = BatchProcessingOfTablePartServer.YouNeedToPerformAction("FillInTermsOfServiceSales",
		StructureOfActions,
		CachedValues,
		ActionParameters);
		
	If YouNeedToPerformFollowingActions Then
		
		If Not CachedValues.Property("UsePriceManagementSystem25") Then
			
			RequestDate_ = ?(ValueIsFilled(ActionParameters.Date),
				ActionParameters.Date,
				CurrentSessionDate());
			
			CachedValues.Insert("UsePriceManagementSystem25",
				PriceManagementSystemServerCall.UsePriceManagementSystem25(RequestDate_));
			
		EndIf;
		
		If CachedValues.UsePriceManagementSystem25 Then
			ListOfRequests = QueryTextsSalesConditions25BatchProcessing(True, ActionParameters, CachedValues);
		Else
			ListOfRequests = QueryTextsSalesConditionsBatchProcessing(True);
		EndIf;
		
		For Each ListItem In ListOfRequests Do
			QueryDetails.QueriesTexts.Add(ListItem.Value, ListItem.Presentation);
		EndDo;
		
		QueryDetails.QueryOptions.Insert("Terms", ActionParameters.Terms);
		QueryDetails.QueryOptions.Insert("Partner", ActionParameters.Partner);
		QueryDetails.QueryOptions.Insert("Contract", ActionParameters.Contract);
		QueryDetails.QueryOptions.Insert("ThisIsSaleToEndCustomer", ActionParameters.ThisIsSaleToEndCustomer);
		QueryDetails.QueryOptions.Insert("BaseCurrency", SettingsValueCached.DefaultBaseCurrency());
		QueryDetails.QueryOptions.Insert("Currency", ActionParameters.Currency);
		QueryDetails.QueryOptions.Insert("Date", ActionParameters.Date);
		
	EndIf;
	
EndProcedure

