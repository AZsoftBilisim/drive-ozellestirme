				|must be included in the ""%ProductSegment%"" inventory segment specified in the agreement';
				|it = 'L''articolo ""%Products%"" con caratteristica ""%Characteristic%"" 
				|deve fare parte del segmento degli articoli ""%ProductSegment%"" definito nell''accordo';
				|pl = 'Pozycja ""%Products%"" z cechami ""%Characteristic%"" 
				| musi należeć do segmentu nomenklatury ""%ProductSegment%"", zdefiniowanego w umowie';
				|tr = '""%Characteristic%"" 
				| özelliğine sahip ""%Products%"" öğesi, sözleşmede tanımlanan ""%ProductSegment%"" öğesi segmentinde yer almalıdır'");
				ErrorText = StrReplace(ErrorText, "%Products%",        Selection.Products);
				ErrorText = StrReplace(ErrorText, "%Characteristic%",      Selection.Characteristic);
				ErrorText = StrReplace(ErrorText, "%ProductSegment%", Selection.ProductSegment);

			Else

				ErrorText = NStr("vi = 'Mặt hàng ""%Products%""
				| phải thuộc phân khúc mặt hàng ""%ProductSegment%"" được xác định trong thỏa thuận';
				|ru = 'Номенклатура ""%Products%""
				| должна входить в сегмент номенклатуры ""%ProductSegment%"", определенный в соглашении';
				|en = 'Items ""%Products%""
				|should be included in the ""%ProductSegment%"" inventory segment specified in the agreement'; fa = 'Items ""%Products%""
				|should be included in the ""%ProductSegment%"" inventory segment specified in the agreement';
				|it = 'L''articolo ""%Products%""
				| deve fare parte del segmento degli articoli ""%ProductSegment%"" definito nell''accordo';
				|pl = 'Nomenklatura ""%Products%""
				| musi być zawarta w segmencie nomenklaturowym ""%ProductSegment%"", określonym w umowie';
				|tr = '""%Products%""
				| öğesi, sözleşmede tanımlanan ""%ProductSegment%"" kalem segmentine dahil edilmelidir'");
				ErrorText = StrReplace(ErrorText,"%Products%",        Selection.Products);
				ErrorText = StrReplace(ErrorText,"%ProductSegment%", Selection.ProductSegment);

			EndIf;
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "OwnGoods", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					CommonClientServer.PathToTabularSection(TSName, Selection.LineNumber, "Products"),
					Cancel);
			EndIf;
			
		EndDo;
		
	EndIf;

EndProcedure

// Displays error messages about matching a partner to a partner segment
//
// Parameters:
// Selection          - QueryResultSelection - sampling from the query result
// DocumentSales  - DocumentObject - The object for which you want to show error messages
// Cancel            - Boolean - Flag for refusing to carry out the document
// ArrayOfDeviations - Array - An array of disabilities.
//
Procedure ReportErrorsWhetherPartnerBelongsToPartnerSegment(Val Selection,
	                                                               Val DocumentSales,
	                                                               Cancel,
	                                                               ArrayOfDeviations = Undefined)
	OutputToReport = (ArrayOfDeviations <> Undefined);
	
	If GetFunctionalOption("UsePartnersSegments") And Selection.Next() Then
		If Selection.ThereAreErrorsFillingSegment Then
			
			ErrorText = NStr("vi = 'Bạn hàng cần phải đưa vào phân khúc bạn hàng ""%PartnersSegment%"" mà được xác định trong thỏa thuận chung';
							|ru = 'Партнер должен входить в сегмент партнеров ""%PartnersSegment%"", определенный в типовом соглашении';
							|en = 'Partner should be included in partner segment ""%PartnersSegment%"" determined in the standard agreement'; fa = 'Partner should be included in partner segment ""%PartnersSegment%"" determined in the standard agreement';
							|it = 'Il partner deve fare parte del segmento dei partner ""%PartnersSegment%"" definito nel modello di accordo';
							|pl = 'Partner musi należeć do segmentu partnerskiego ""%PartnersSegment%"", zgodnie z definicją w umowie modelowej';
							|tr = 'İş ortağı, standart sözleşmede tanımlanan ""%PartnersSegment%"" iş ortağı segmentine dahil edilmelidir'");
			ErrorText = StrReplace(ErrorText, "%PartnersSegment%", Selection.PartnersSegment); 
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddHeaderDeviationToArrayOfDeviations(NStr("vi = 'Bạn hàng';
																										|ru = 'Партнер';
																										|en = 'Partner'; fa = 'شریک تجاری';
																										|it = 'Partner';
																										|pl = 'Partner';
																										|tr = 'İş ortağı'"), ErrorText, ArrayOfDeviations);
			Else
				ReportErrorToUser(
					ErrorText,
					DocumentSales,
					"Partner",
					Cancel);
			EndIf;
			
		EndIf;
		
	EndIf;

EndProcedure

// Displays error messages about the correctness of filling in the payment schedule stages
//
// Parameters:
// Selection           - QueryResultSelection - sampling from the query result
// DocumentSales   - DocumentObject - The object for which you want to show error messages
// Cancel             - Boolean - Flag for refusing to carry out the document
// DeviationTree  - ValueTree - A tree with deviations of the table part from the sales conditions.
//
Procedure ReportErrorsCorrectnessOfPaymentScheduleStages(Val Selection,
	                                                       Val DocumentSales,
	                                                       Cancel,
	                                                       DeviationTree = Undefined,
															ArrayOfDeviations = Undefined)
	
	DefaultGraph = New ValueTable();
	DefaultGraph.Columns.Add("PaymentOption");
	DefaultGraph.Columns.Add("CalculateFrom");
	DefaultGraph.Columns.Add("PaymentDate", Common.DateTypeDetails(DateFractions.Date));
	DefaultGraph.Columns.Add("PaymentPercentage");
	DefaultGraph.Columns.Add("PaymentAmount");
	DefaultGraph.Columns.Add("PackageDepositPercentage");
	DefaultGraph.Columns.Add("PackageDepositValue");
	DefaultGraph.Columns.Add("Move");
	DefaultGraph.Columns.Add("Formula");
	
	If Selection.Next() Then
		FillParameters = PaymentStepsServer.ParametersForFillingInPaymentStages();
		FillParameters.TheseAreSettlementsWithCustomers       = True;
		FillParameters.InvoiceForOrders         = False;
		FillParameters.ARAPObjectSettings            = Selection.ARAPObjectSettings;
		FillParameters.ThisIsOrder                   = Selection.ThisIsOrder;
		FillParameters.OrderDate                 = ?(Selection.ThisIsOrder,Selection.Date,Date(1,1,1));
		FillParameters.ApprovalDate           = Selection.ApprovalDate;
		FillParameters.PayAmount                    = 100; 
		
		If Not Selection.ThisIsOrder Then
			FillParameters.DateOfShipment = Selection.Date;
			FillParameters.PackageDepositValue = ?(Selection.PackageDepositPercentage <> 0,100,0);
		ElsIf Selection.NotShipInInstallments Then
			FillParameters.DateOfShipment = ?(ValueIsFilled(Selection.DateOfShipment), Selection.DateOfShipment, Selection.Date);
			FillParameters.PackageDepositValue = 0;
		Else
			ManagerOfDocument = Common.ObjectManagerByRef(DocumentSales.Ref);
			SettlementParameters_ = ManagerOfDocument.SettlementParameters_(DocumentSales);
			If TypeOf(SettlementParameters_) = Type("Array") Then
				ParametersStructure = SettlementParameters_[0];
			Else
				ParametersStructure = SettlementParameters_;
			EndIf;
			GoodsTable = ARAPAccountingServer.TableOfOrderAmounts(DocumentSales, ParametersStructure);
			FillParameters.TabularSection = GoodsTable;
			FillParameters.PackageDepositValue = GoodsTable.Total("PackageDepositValue");
			FillParameters.PayAmount       = GoodsTable.Total("PaymentAmount");
		EndIf;
		FillParameters.DateOfTransferOfTitleToGoods = Selection.DateOfTransferOfTitleToGoods;
		FillParameters.Terms                     = Selection.Terms;
		
		FillParameters.AgreementScheduleIsFilledIn       = PaymentStepsServerCall.AgreementScheduleIsFilledIn(Selection.Terms);
		FillParameters.PaymentSchedule                   = Selection.PaymentSchedule;
		FillParameters.Calendar                      = Selection.Calendar;
		FillParameters.ThereIsDateOfTransferOfOwnership = ValueIsFilled(Selection.DateOfTransferOfTitleToGoods) And BegOfDay(Selection.Date) <> BegOfDay(Selection.DateOfTransferOfTitleToGoods);
		FillParameters.ThisIsTransferOfOwnership2_5 = Selection.ThisIsTransferOfOwnership2_5;
		
		PaymentStepsServer.FillInPaymentStages(DefaultGraph, FillParameters);
	EndIf;
	
	InterestAmount = 0;
	AmountOfTemplateSInterest = 0;
	AmountOfCollateralInterest = 0;
	AmountOfTemplateSCollateralInterest = 0;
	
	Selection.Reset();
	OutputToReport = (DeviationTree <> Undefined);
	
	If Selection.Count() <> DefaultGraph.Count() Then
			
		ErrorText = NStr("vi = 'Số lượng giai đoạn thanh toán trong chứng từ (%NumberOfDocumentStages%) phải trùng với số lượng giai đoạn trong lịch biểu (%NumberOfScheduleStages%)';
						|ru = 'Количество этапов оплаты в документе (%NumberOfDocumentStages%) должно совпадать с количеством этапов в графике (%NumberOfScheduleStages%)';
						|en = 'The number of payment milestones in the (%NumberOfDocumentStages%) document must match the number of stages in the (%NumberOfScheduleStages%) schedule'; fa = 'The number of payment milestones in the (%NumberOfDocumentStages%) document must match the number of stages in the (%NumberOfScheduleStages%) schedule';
						|it = 'La quantità delle fasi di pagamento nel documento (%NumberOfDocumentStages%) deve coincidere con la quantità di fasi nel grafico (%NumberOfScheduleStages%)';
						|pl = 'Ilość etapów płatności w dokumencie (%NumberOfDocumentStages%) powinna zgadzać się z ilością etapów w harmonogramie (%NumberOfScheduleStages%)';
						|tr = 'Belgedeki ödeme aşaması sayısı (%NumberOfDocumentStages%) programdaki aşama sayısıyla (%NumberOfScheduleStages%) eşleşmelidir'");
		ErrorText = StrReplace(ErrorText, "%NumberOfDocumentStages%", Selection.Count());
		ErrorText = StrReplace(ErrorText, "%NumberOfScheduleStages%",   DefaultGraph.Count());
		
		If OutputToReport Then
			Reports.VariancesFromSalesTermsAndConditions.AddHeaderDeviationToArrayOfDeviations(NStr("vi = 'Các giai đoạn thanh toán';
																									|ru = 'Этапы оплаты';
																									|en = 'Payment milestones'; fa = 'مراحل پرداخت';
																									|it = 'Fasi del pagamento';
																									|pl = 'Etapy płatności';
																									|tr = 'Ödeme aşamaları'"), ErrorText, ArrayOfDeviations);
		Else
			ReportErrorToUser(
				ErrorText,
				DocumentSales,
				"PaymentStepsText",
				Cancel);
		EndIf;
	EndIf;
	
	Cnt = 0;
	While Selection.Next() Do
		
		If Not Selection.ThereAreErrorsFillingStagesOfPaymentSchedule Or DefaultGraph.Count()-1 < Cnt Then
			Return;
		EndIf;
		
		DefaultPlotLine = DefaultGraph[Cnt];
		
		LineNumber = Selection.LineNumber;
		ErrorAddress = " " + NStr("vi = 'trong dòng %LineNumber% của danh sách ""Giai đoạn thanh toán""';
									|ru = 'в строке %LineNumber% списка ""Этапы оплаты""';
									|en = 'in line %LineNumber% of the ""Payment milestones"" list'; fa = 'in line %LineNumber% of the ""Payment milestones"" list';
									|it = 'nella riga  %LineNumber% dell''elenco ""Fasi di pagamento""';
									|pl = 'w wierszu %LineNumber% listy ""Этапы оплаты""';
									|tr = '""Ödeme Aşamaları"" listesinin %LineNumber% satırında'");
		ErrorAddress = StrReplace(ErrorAddress, "%LineNumber%", LineNumber);

		If DefaultPlotLine.PaymentOption <> Selection.PaymentOption Then

			ErrorText = NStr("vi = 'Phương án kiểm soát khác với giá trị trong lịch biểu thanh toán ""%TemplatePaymentOption%""';
							|ru = 'Вариант контроля отличается от значения в графике оплаты ""%TemplatePaymentOption%""';
							|en = 'Control option differs from the value in the ""%TemplatePaymentOption%"" payment schedule'; fa = 'Control option differs from the value in the ""%TemplatePaymentOption%"" payment schedule';
							|it = 'La variante di controllo differisce dal valore nel grafico di pagamento ""%TemplatePaymentOption%""';
							|pl = 'Wariant kontroli różni się od wartości w harmonogramie płatności ""%TemplatePaymentOption%""';
							|tr = 'Kontrol seçeneği, ""%TemplatePaymentOption%"" ödeme programındaki değerden farklı'");
			ErrorText = StrReplace(ErrorText, "%TemplatePaymentOption%", DefaultPlotLine.PaymentOption); 
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PaymentOption", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"PaymentStepsText",
					Cancel);
			EndIf;
		EndIf;
		
		If DefaultPlotLine.PaymentDate < Selection.PaymentDate Then
			
			ErrorText = NStr("vi = 'Ngày thanh toán không được lớn hơn ngày trong lịch thanh toán ""%TemplatePaymentDate%""';
							|ru = 'Дата платежа должна быть не больше, чем в графике оплаты ""%TemplatePaymentDate%""';
							|en = 'Payment date must not be greater than the date in payment schedule ""%TemplatePaymentDate%""'; fa = 'Payment date must not be greater than the date in payment schedule ""%TemplatePaymentDate%""';
							|it = 'La data di pagamento non deve essere successiva a quanto indicato nel calendario dei pagamenti ""%TemplatePaymentDate%""';
							|pl = 'Data płatności nie może być większa niż w harmonogramie płatności ""%TemplatePaymentDate%""';
							|tr = 'Ödeme tarihi, ""%TemplatePaymentDate%"" ödeme planından önce olmamalıdır'");
			ErrorText = StrReplace(ErrorText, "%TemplatePaymentDate%", Format(DefaultPlotLine.PaymentDate, "DLF=DD")); 
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PaymentDate", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"PaymentStepsText",
					Cancel);
			EndIf;
		EndIf;
		
		// Checking for payment percentage deviations
		InterestAmount = InterestAmount + Selection.PaymentPercentage;
		AmountOfTemplateSInterest = AmountOfTemplateSInterest + DefaultPlotLine.PaymentPercentage;
		If InterestAmount < AmountOfTemplateSInterest Then
			
			ErrorText = NStr("vi = 'Tiền lãi cho đến lần thanh toán tiếp theo trong lịch biểu (""%PaymentPercentage%%"") không được thấp hơn lãi suất theo lịch của thỏa thuận (""%TemplatePaymentPercentage%"")';
							|ru = 'Проценты до следующего платежа по графику (""%PaymentPercentage%%"") не должны быть меньше процентов по графику соглашения (""%TemplatePaymentPercentage%%"")';
							|en = 'Interest before the next payment on schedule (""%PaymentPercentage%%"") cannot be less than the interest under the agreement schedule (""%TemplatePaymentPercentage%%"")'; fa = 'Interest before the next payment on schedule (""%PaymentPercentage%%"") cannot be less than the interest under the agreement schedule (""%TemplatePaymentPercentage%%"")';
							|it = 'Gli interessi fino al prossimo pagamento in base al calendario (""%PaymentPercentage%%"") non devono essere inferiori agli interessi secondo il calendario dell''accordo (""%TemplatePaymentPercentage%%"")';
							|pl = 'Odsetki do następnej płatności zgodnie z harmonogramem (""%PaymentPercentage%%"") nie mogą być niższe niż odsetki zgodnie z harmonogramem umowy (""%TemplatePaymentPercentage%%"")';
							|tr = 'Plana göre bir sonraki ödemeye kadar olan faizler (""%PaymentPercentage%%""), anlaşma planına göre faizlerden (""%TemplatePaymentPercentage%%"") az olmamalıdır'");
			ErrorText = StrReplace(ErrorText, "%PaymentPercentage%", InterestAmount);
			ErrorText = StrReplace(ErrorText, "%TemplatePaymentPercentage%", AmountOfTemplateSInterest);
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PaymentPercentage", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"PaymentStepsText",
					Cancel);
			EndIf;
		EndIf;
		
		AmountOfCollateralInterest = AmountOfCollateralInterest + Selection.PackageDepositPercentage;
		AmountOfTemplateSCollateralInterest = AmountOfTemplateSCollateralInterest + DefaultPlotLine.PackageDepositPercentage;
		If AmountOfCollateralInterest < AmountOfTemplateSCollateralInterest Then
			
			ErrorText = NStr("vi = 'Tỷ lệ phần trăm của tài sản thế chấp cho container cho đến lần thanh toán tiếp theo trong lịch biểu (""%PackageDepositPercentage%"") không được thấp hơn tỷ lệ phần trăm của lịch biểu của thỏa thuận (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|ru = 'Проценты залога за тару до следующего платежа по графику (""%PackageDepositPercentage%%"") не должны быть меньше процентов по графику соглашения (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|en = 'Packaging deposit interest accrued until the next scheduled payment (""%PackageDepositPercentage%%"") cannot be less than the interest accrued under the agreement schedule (""%PercentageOfDepositForContainerOfTemplate%%"")'; fa = 'Packaging deposit interest accrued until the next scheduled payment (""%PackageDepositPercentage%%"") cannot be less than the interest accrued under the agreement schedule (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|it = 'Gli interessi della cauzione per l''imballaggio fino al prossimo pagamento previsto dal calendario (""%PackageDepositPercentage%%"") non devono essere inferiori agli interessi previsti dal calendario dell''accordo (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|pl = 'Oprocentowanie marży za opakowanie do następnej płatności w harmonogramie (""%PackageDepositPercentage%%"") nie może być niższe niż odsetki wynikające z harmonogramu umowy (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|tr = 'Plana göre bir sonraki ödemeye kadar depozito yüzdeleri (""%PackageDepositPercentage%%""), anlaşma planına göre yüzdelerden (""%PercentageOfDepositForContainerOfTemplate%%"") az olmamalıdır'");
			ErrorText = StrReplace(ErrorText, "%PackageDepositPercentage%", AmountOfCollateralInterest);
			ErrorText = StrReplace(ErrorText, "%PercentageOfDepositForContainerOfTemplate%", AmountOfTemplateSCollateralInterest);
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PackageDepositPercentage", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"PaymentStepsText",
					Cancel);
			EndIf;
		EndIf;
		
		Cnt = Cnt + 1 ;
		
	EndDo;

EndProcedure

// Displays error messages when the sales document prices fall within the acceptable range.
//
// Parameters:
// Selection          - QueryResultSelection - sampling from the query result
// DocumentSales  - DocumentObject - The object for which you want to show error messages
// Cancel            - Boolean - Flag for refusing to carry out the document
// UseDiscountsMarkups - Boolean - Whether to use discounts
// DeviationTree  - ValueTree - A tree with deviations of the table part from the sales conditions.
//
Procedure ReportErrorsWhenPricesFallWithinAcceptableRange(Val Selection,
	                                                       Val DocumentSales,
	                                                       Cancel,
	                                                       UseDiscountsMarkups,
	                                                       DeviationTree = Undefined)
	
	TableName        = Common.TableNameByRef(DocumentSales.Ref);
	TSName             = GetNameOfTablePart(TableName);
	PresentationOfTS   = GetPresentationOfTablePart(TableName);
	
	OutputToReport = (DeviationTree <> Undefined);

	While Selection.Next() Do
		LineNumber = Selection.LineNumber;
		
		ErrorAddress = " " + NStr("vi = 'trong dòng %LineNumber% danh sách ""%PresentationOfTS%""';
									|ru = 'в строке %LineNumber% списка ""%PresentationOfTS%""';
									|en = 'in line %LineNumber% of the ""%PresentationOfTS%"" list'; fa = 'in line %LineNumber% of the ""%PresentationOfTS%"" list';
									|it = 'nella riga %LineNumber% dell''elenco ""%PresentationOfTS%""';
									|pl = 'w wierszu %LineNumber% listy ""%PresentationOfTS%""';
									|tr = '""%PresentationOfTS%"" listesinin %LineNumber% satırında'");
		ErrorAddress = StrReplace(ErrorAddress, "%LineNumber%",     LineNumber);
		ErrorAddress = StrReplace(ErrorAddress, "%PresentationOfTS%", PresentationOfTS);
		
		If Selection.ThereAreErrorsMinimumAllowablePrice Then

			If ValueIsFilled(Selection.Characteristic) Then

				If UseDiscountsMarkups Then
					ErrorText = NStr("vi = 'Đơn giá có tính chiết khấu (phụ thu) đối với mặt hàng ""%Products%"" có đặc tính ""%Characteristic%"" không được nhỏ hơn đơn giá tối thiểu được phép ""%MinimumAllowablePrice%%PriceCurrency%""';
									|ru = 'Цена с учетом скидки (наценки) на номенклатуру ""%Products%"" с характеристикой ""%Characteristic%"" не должна быть ниже минимально допустимой цены ""%MinimumAllowablePrice% %PriceCurrency%""';
									|en = 'Price with discount (markup) for variant ""%Characteristic%"" of item ""%Products%"" should not be less than minimum allowable price ""%MinimumAllowablePrice% %PriceCurrency%""'; fa = 'Price with discount (markup) for variant ""%Characteristic%"" of item ""%Products%"" should not be less than minimum allowable price ""%MinimumAllowablePrice% %PriceCurrency%""';
									|it = 'Il prezzo dell''articolo ""%Products%"" con sconto (maggiorazione) e caratteristica ""%Characteristic%"" non deve essere inferiore al prezzo minimo ammissibile ""%MinimumAllowablePrice% %PriceCurrency%""';
									|pl = 'Cena ze zniżką (marża) na pozycję ""%Products%"" z cechami ""%Characteristic%"" nie może być niższa od minimalnej akceptowalnej ceny ""%MinimumAllowablePrice%%PriceCurrency%""';
									|tr = '""%Characteristic%"" özelliğine sahip ""%Products%"" öğesinin indirim/zam dikkate alınarak fiyat, izin verilen minimum fiyat olan ""%MinimumAllowablePrice% %PriceCurrency%"" değerinden düşük olmamalıdır'");
				Else
					ErrorText = NStr("vi = 'Đơn giá đối với mặt hàng ""%Products%"" có đặc tính ""%Characteristic%"" không được nhỏ hơn đơn giá theo thỏa thuận ""%MinimumAllowablePrice% %PriceCurrency%""';
									|ru = 'Цена на номенклатуру ""%Products%"" с характеристикой ""%Characteristic%"" не должна быть ниже минимально допустимой цены ""%MinimumAllowablePrice% %PriceCurrency%""';
									|en = 'Price for variant ""%Characteristic%"" of item ""%Products%"" should not be lower than minimum allowable price ""%MinimumAllowablePrice% %PriceCurrency%""'; fa = 'Price for variant ""%Characteristic%"" of item ""%Products%"" should not be lower than minimum allowable price ""%MinimumAllowablePrice% %PriceCurrency%""';
									|it = 'Il prezzo dell''articolo ""%Products%""  con caratteristica  ""%Characteristic%"" non deve essere inferiore al prezzo minimo ammissibile ""%MinimumAllowablePrice% %PriceCurrency%""';
									|pl = 'Cena na pozycję ""%Products%"" o charakterystyce ""%Characteristic%"" nie może być niższa od minimalnej akceptowalnej ceny ""%MinimumAllowablePrice%%PriceCurrency%""';
									|tr = '""%Characteristic%"" özelliğine sahip ""%Products%"" öğesinin fiyatı, izin verilen minimum fiyat olan ""%MinimumAllowablePrice% %PriceCurrency%"" değerinden düşük olmamalıdır'");
				EndIf;
				
				ErrorText = StrReplace(ErrorText, "%Products%",             Selection.Products);
				ErrorText = StrReplace(ErrorText, "%Characteristic%",           Selection.Characteristic);  
				ErrorText = StrReplace(ErrorText, "%MinimumAllowablePrice%", Selection.MinimumAllowablePrice);
				ErrorText = StrReplace(ErrorText, "%PriceCurrency%",               Selection.PriceCurrency);

			Else

				If UseDiscountsMarkups Then
					ErrorText = NStr("vi = 'Đơn giá có tính chiết khấu (phụ thu) đối với mặt hàng ""%Products%"" không được nhỏ hơn đơn giá được phép tối thiểu ""%MinimumAllowablePrice% %PriceCurrency%""';
									|ru = 'Цена с учетом скидки (наценки) на номенклатуру ""%Products%"" не должна быть ниже минимально допустимой цены ""%MinimumAllowablePrice% %PriceCurrency%""';
									|en = 'Price with discount (markup) for the ""%Products%"" items should not be less than minimum allowable price ""%MinimumAllowablePrice% %PriceCurrency%""'; fa = 'Price with discount (markup) for the ""%Products%"" items should not be less than minimum allowable price ""%MinimumAllowablePrice% %PriceCurrency%""';
									|it = 'Il prezzo dell''articolo ""%Products%"" con sconto (maggiorazione) non deve essere inferiore al prezzo minimo ammissibile ""%MinimumAllowablePrice% %PriceCurrency%""';
									|pl = 'Cena z rabatem (marżą) na nomenklaturę ""%Products%"" nie powinna być poniżej minimalnej akceptowalnej ceny ""%MinimumAllowablePrice%%PriceCurrency%""';
									|tr = '""%Products%"" öğesi için indirim/zam dikkate alındığında fiyat, ""%MinimumAllowablePrice% %PriceCurrency%"" izin verilen minimum fiyattan düşük olmamalıdır.'");
				Else
