						|pl = 'Wartość przedpłaty nie odpowiada kwocie obliczonej zgodnie z harmonogramem płatności umowy %AmountOfAdvancePaymentAccordingToSchedule%';
						|tr = 'Ön ödeme tutarı, anlaşmanın ödeme planına göre hesaplanan tutara uygun gelmiyor %AmountOfAdvancePaymentAccordingToSchedule%'");
		ErrorText = StrReplace(ErrorText, "%AmountOfAdvancePaymentAccordingToSchedule%", Format(Selection.AmountOfAdvancePaymentAccordingToSchedule, "NFD=2; NZ=0,00"));
		
		If OutputToReport Then
			Reports.VariancesFromSalesTermsAndConditions.AddHeaderDeviationToArrayOfDeviations(NStr("vi = 'Trả trước';
