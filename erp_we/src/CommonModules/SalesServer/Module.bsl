#Region Sets

Function GenerateQueryTextTemporaryTablesSets()
	
	QueryText =
	"SELECT
	|	MIN(Table.LineNumber)   AS LineNumber,
	|	MIN(Table.RowCode)     AS RowCode,
	|	MIN(Table.ConnectionKey)     AS ConnectionKey,
	|	Table.ProductsInSet     AS ProductsInSet,
	|	Table.ItemVariantOfSet   AS ItemVariantOfSet,
	|	SUM(Table.Sum)           AS Sum,
	|	SUM(Table.VATAmount)        AS VATAmount,
	|	MAX(Table.PriceKind)      AS MaximumPriceType,
	|	MIN(Table.PriceKind)       AS MinimumPriceType,
	|	MAX(Table.VATRate)    AS MaximumVATRate,
	|	MIN(Table.VATRate)     AS MinimumVATRate_,
	|	MAX(Table.PercentRateOfAutomaticDiscountMarkup) AS PercentRateOfAutomaticDiscountMarkup,
	|	SUM(Table.DiscountMarkupAmount)   AS DiscountMarkupAmount,
	|	MAX(Table.PercentRateOfManualDiscount)      AS PercentRateOfManualDiscount,
	|	SUM(Table.ManualDiscount)           AS ManualDiscount
	|INTO TemporaryTableSetsPreparation
	|FROM
	|	TemporaryTableOfGoods_Preliminary AS Table
	|	
	|		LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
	|		ON ProductKitConfigurations.Owner = Table.ProductsInSet
	|		AND ProductKitConfigurations.Characteristic = Table.ItemVariantOfSet
	|		AND ProductKitConfigurations.Main
	|WHERE
	|	ProductKitConfigurations.SetPricingOption IN (VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices),
	|	                                                             VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares))
	|
	|GROUP BY
	|	Table.ProductsInSet,
	|	Table.ItemVariantOfSet
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Table.ProductsInSet                     AS ProductsInSet,
	|	Table.ItemVariantOfSet                   AS ItemVariantOfSet,
	|	SUM(CASE WHEN ISNULL(Components.Count, 0) <> 0 THEN
	|		Table.Count / Components.Count
	|	ELSE
	|		1
	|	END) AS Count
	|INTO TemporaryTableSetsOptional
	|FROM
	|	TemporaryTableOfGoods_Preliminary AS Table
	|	
	|		LEFT JOIN Catalog.ProductKitConfigurations AS ProductKitConfigurations
	|		ON ProductKitConfigurations.Owner = Table.ProductsInSet
	|		AND ProductKitConfigurations.Characteristic = Table.ItemVariantOfSet
	|		AND ProductKitConfigurations.Main
	|	
	|		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS Components
	|		ON Components.Ref                                   = ProductKitConfigurations.Ref
	|		 AND Components.Ref.ProductsOfMainComponent   = Table.Products
	|		 AND Components.Ref.MainComponentCharacteristic = Table.Characteristic
	|		 AND Components.Products                             = Table.Products
	|		 AND Components.Characteristic                           = Table.Characteristic
	|WHERE
	|	ProductKitConfigurations.SetPricingOption IN (VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices),
	|	                                                             VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares))
	|	AND NOT Components.Count IS NULL
	|GROUP BY
	|	Table.ProductsInSet,
	|	Table.ItemVariantOfSet
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Table.ProductsInSet                                  AS ProductsInSet,
	|	Table.ItemVariantOfSet                                AS ItemVariantOfSet,
	|	Table.ConnectionKey                                           AS ConnectionKey,
	|	Table.LineNumber                                         AS LineNumber,
	|	Table.RowCode                                           AS RowCode,
	|	ISNULL(TemporaryTableSetsOptional.Count, 1) AS NumberOfPackages,
	|	ISNULL(TemporaryTableSetsOptional.Count, 1) AS Count,
	|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)      AS Package,
	|	VALUE(Catalog.Warehouses.EmptyRef)                    AS Warehouse,
	|	CASE WHEN Table.MaximumPriceType = Table.MinimumPriceType THEN
	|		Table.MaximumPriceType
	|	ELSE
	|		VALUE(Catalog.TypesOfPrices.EmptyRef)
	|	END AS PriceKind,
	|	CASE WHEN Table.MaximumVATRate = Table.MinimumVATRate_ THEN
	|		Table.MaximumVATRate
	|	ELSE
	|		VALUE(Catalog.VATRates.EmptyRef)
	|	END AS VATRate,
	|	Table.VATAmount AS VATAmount,
	|	Table.Sum AS Sum,
	|	(Table.Sum + Table.ManualDiscount + Table.DiscountMarkupAmount) / ISNULL(TemporaryTableSetsOptional.Count, 1) AS Price,
	|	(Table.Sum) / ISNULL(TemporaryTableSetsOptional.Count, 1)                                                                 AS DiscountedPrice_,
	|	Table.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
	|	Table.DiscountMarkupAmount   AS DiscountMarkupAmount,
	|	Table.PercentRateOfManualDiscount         AS PercentRateOfManualDiscount,
	|	Table.ManualDiscount           AS ManualDiscount
	|	
	|INTO TemporaryTableSets
	|FROM
	|	TemporaryTableSetsPreparation AS Table
	|		LEFT JOIN TemporaryTableSetsOptional AS TemporaryTableSetsOptional
	|		ON Table.ProductsInSet = TemporaryTableSetsOptional.ProductsInSet
	|		AND Table.ItemVariantOfSet = TemporaryTableSetsOptional.ItemVariantOfSet
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	
	|	Table.ProductsInSet               AS ProductsInSet,
	|	Table.ItemVariantOfSet             AS ItemVariantOfSet,
	|	Table.IsRecordsSet                         AS IsRecordsSet,
	|	Table.TheseAreComponents                 AS TheseAreComponents,
	|	Table.LineNumber                      AS LineNumber,
	|	Table.SourceLineNumber              AS SourceLineNumber,
	|	Table.Products                     AS Products,
	|	Table.Characteristic                   AS Characteristic,
	|	&TextOfPricingFields,
	|	Table.Price                             AS Price,
	|	Table.Sum                            AS Sum,
	|	Table.PriceKind                          AS PriceKind,
	|	Table.Package                         AS Package,
	|	Table.VATRate                        AS VATRate,
	|	Table.VATAmount                         AS VATAmount,
	|	Table.ConnectionKey                        AS ConnectionKey,
	|	Table.PercentRateOfAutomaticDiscountMarkup      AS PercentRateOfAutomaticDiscountMarkup,
	|	Table.DiscountMarkupAmount        AS DiscountMarkupAmount,
	|	Table.PercentRateOfManualDiscount              AS PercentRateOfManualDiscount,
	|	Table.ManualDiscount                AS ManualDiscount,
	|	Table.DiscountedPrice_                    AS DiscountedPrice_,
	|	Table.DateOfShipment                     AS DateOfShipment,
	|	Table.Canceled                         AS Canceled,
	|	Table.Warehouse                            AS Warehouse,
	|	Table.DeliveryPeriodDays                     AS DeliveryPeriodDays,
	|	Table.RowCode                        AS RowCode,
	|	Table.SupplyOption               AS SupplyOption,
	|	Table.CheckFillingErrorsDeliveryTime AS CheckFillingErrorsDeliveryTime,
	|	Table.PartnerProducts             AS ProductCrossReference
	|INTO TemporaryTableOfGoods_
	|FROM (
	|
	|	SELECT
	|		Table.ProductsInSet,
	|		Table.ItemVariantOfSet,
	|	
	|		CASE WHEN ISNULL(TemporaryTableSets.LineNumber, 0) <> 0 THEN
	|			TRUE
	|		ELSE
	|			FALSE
	|		END AS TheseAreComponents,
	|		FALSE AS IsRecordsSet,
	|		CASE WHEN ISNULL(TemporaryTableSets.LineNumber, 0) <> 0 THEN
	|			TemporaryTableSets.LineNumber
	|		ELSE
	|			Table.LineNumber
	|		END AS LineNumber,
	|		
	|		Table.LineNumber                      AS SourceLineNumber,
	|		Table.Products                     AS Products,
	|		Table.Characteristic                   AS Characteristic,
	|		Table.Price                             AS Price,
	|		Table.Sum                            AS Sum,
	|		Table.PriceKind                          AS PriceKind,
	|		Table.Package                         AS Package,
	|		Table.VATRate                        AS VATRate,
	|		Table.VATAmount                         AS VATAmount,
	|		Table.ConnectionKey                        AS ConnectionKey,
	|		Table.PercentRateOfAutomaticDiscountMarkup      AS PercentRateOfAutomaticDiscountMarkup,
	|		Table.DiscountMarkupAmount        AS DiscountMarkupAmount,
	|		Table.PercentRateOfManualDiscount              AS PercentRateOfManualDiscount,
	|		Table.ManualDiscount                AS ManualDiscount,
	|		Table.DiscountedPrice_                    AS DiscountedPrice_,
	|		Table.DateOfShipment                     AS DateOfShipment,
	|		Table.Canceled                         AS Canceled,
	|		Table.Warehouse                            AS Warehouse,
	|		Table.DeliveryPeriodDays                     AS DeliveryPeriodDays,
	|		Table.RowCode                        AS RowCode,
	|		Table.SupplyOption               AS SupplyOption,
	|		Table.CheckFillingErrorsDeliveryTime AS CheckFillingErrorsDeliveryTime,
	|		&PartnerProducts                    AS PartnerProducts
	|	FROM
	|		TemporaryTableOfGoods_Preliminary AS Table
	|			LEFT JOIN TemporaryTableSets AS TemporaryTableSets
	|			ON TemporaryTableSets.ProductsInSet = Table.ProductsInSet
	|			 AND TemporaryTableSets.ItemVariantOfSet = Table.ItemVariantOfSet
	|	
	|	UNION ALL
	|	
	|	SELECT
	|	
	|		Table.ProductsInSet               AS ProductsInSet,
	|		Table.ItemVariantOfSet             AS ItemVariantOfSet,
	|		FALSE                                     AS TheseAreComponents,
	|		TRUE                                   AS IsRecordsSet,
	|		Table.LineNumber                      AS LineNumber,
	|		Table.LineNumber                      AS SourceLineNumber,
	|		Table.ProductsInSet               AS Products,
	|		Table.ItemVariantOfSet             AS Characteristic,
	|		Table.Price                             AS Price,
	|		Table.Sum                            AS Sum,
	|		Table.PriceKind                          AS PriceKind,
	|		Table.Package                         AS Package,
	|		Table.VATRate                        AS VATRate,
	|		Table.VATAmount                         AS VATAmount,
	|		Table.ConnectionKey                        AS ConnectionKey,
	|		Table.PercentRateOfAutomaticDiscountMarkup      AS PercentRateOfAutomaticDiscountMarkup,
	|		Table.DiscountMarkupAmount        AS DiscountMarkupAmount,
	|		Table.PercentRateOfManualDiscount              AS PercentRateOfManualDiscount,
	|		Table.ManualDiscount                AS ManualDiscount,
	|		Table.DiscountedPrice_                    AS DiscountedPrice_,
	|		DATETIME(1,1,1)                         AS DateOfShipment,
	|		FALSE                                     AS Canceled,
	|		Table.Warehouse                            AS Warehouse,
	|		DATETIME(1,1,1)                         AS DeliveryPeriodDays,
	|		Table.RowCode                        AS RowCode,
	|		VALUE(Enum.SupplyOptions.EmptyRef) AS SupplyOption,
	|		FALSE                                     AS CheckFillingErrorsDeliveryTime,
	|		VALUE(Catalog.ProductCrossReferences.EmptyRef) AS PartnerProducts
	|	FROM
	|		TemporaryTableSets AS Table
	|) AS Table
	|
	|		LEFT JOIN Catalog.ItemKinds AS ItemKinds
	|			ON ItemKinds.Ref = Table.Products.ProductKind
	|
	|INDEX BY
	|	Table.Products,
	|	Table.Characteristic
	|";
	
	Return QueryText;
	
EndFunction

