// Generates a request to check whether there are duplicates in the PM Products of the sales document
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForDuplicateItemsInSalesDocument(QueryText)
	
	QueryText = QueryText + "
		|SELECT
		|	MAX(DocumentGoods.LineNumber)    AS LineNumber,
		|	DocumentGoods.Products             AS Products,
		|	DocumentGoods.Characteristic           AS Characteristic
		|FROM
		|	TemporaryTableOfGoods_ AS DocumentGoods
		|GROUP BY
		|	DocumentGoods.Products,
		|	DocumentGoods.Characteristic
		|HAVING 
		|	COUNT (*) > 1
		|;
		|";

EndProcedure

// Generates a request to check whether there are duplicates in the PM price Group of the sales document.
//
