// Generates a request to check the PM Products of the sales document
//
// Parameters:
// QueryText - String - text string to which you want to add the query text
// TableName   - String - the table name of the document to which you want to generate a validation request.
// UsePriceChecks - Boolean - true, use the new pricing.
//
Procedure GenerateRequestProductsForSale(QueryText, TableName, UsePriceChecks)

	QueryText = QueryText + "
		|SELECT
		|	&ThisIsConvention                              AS ThisIsConvention,
		|	TemporaryTableOfGoods_.LineNumber          AS LineNumber,
		|	TemporaryTableOfGoods_.IsRecordsSet             AS IsRecordsSet,
		|	TemporaryTableOfGoods_.TheseAreComponents     AS TheseAreComponents,
		|	TemporaryTableOfGoods_.ProductsInSet   AS ProductsInSet,
		|	TemporaryTableOfGoods_.ItemVariantOfSet AS ItemVariantOfSet,
		|	TemporaryTableOfGoods_.Products         AS Products,
		|	TemporaryTableOfGoods_.Characteristic       AS Characteristic,
		|	TemporaryTableOfGoods_.Price                 AS Price,
		|	AgreementHeader_.ConsignmentSales25       AS ConsignmentSales25,
		|	CASE
		|		WHEN
		|			(AgreementGoods.Products IS NOT NULL)
		|		THEN
		|			CAST(ISNULL(AgreementGoods.Price,0)
		|			/ ISNULL(&QueryTextPackagingFactor1,1)
		|			* CASE
		|				WHEN
		|					TemporaryTableOfGoods_.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|				THEN
		|					&QueryTextPackagingFactor2
		|				ELSE
		|					1
		|			END
		|			* CASE
		|				WHEN
		|					AgreementHeader_.Currency <> TemporaryTableSalesDocument.Currency
		|				THEN
		|					CASE
		|						WHEN ISNULL(CurrencyExchangeRatesForSale.CourseDenominator, 0) > 0
		|							AND ISNULL(CurrencyExchangeRatesForSale.CourseNumerator, 0) > 0
		|							AND ISNULL(ExchangeRatesOfAgreement_.CourseDenominator, 0) > 0
		|							AND ISNULL(ExchangeRatesOfAgreement_.CourseNumerator, 0) > 0
		|						THEN
		|							(ExchangeRatesOfAgreement_.CourseNumerator * CurrencyExchangeRatesForSale.CourseDenominator)
		|							/ (CurrencyExchangeRatesForSale.CourseNumerator * ExchangeRatesOfAgreement_.CourseDenominator)
		|						ELSE
		|							0
		|					END
		|				ELSE
		|					1
		|			END AS NUMBER(31,2))
		|		ELSE
		|			0
		|	END AS PriceAgreement,
		|
		|	&AgreementPriceVerificationFields,
		|	ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
		|		VALUE(Catalog.VATRates.EmptyRef))) AS VATRateProducts,
		|	CASE
		|		WHEN ISNULL(AgreementGoods.Price,0) = 0
		|			AND TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage) 
		|			AND &ReturnOfMultiTurnContainers
		|		THEN
		|			FALSE
		|		WHEN (AgreementGoods.Products IS NOT NULL) AND
		|		AgreementGoods.Price > 0 AND
		|		TemporaryTableOfGoods_.Price <
		|		CAST(ISNULL(AgreementGoods.Price,0)
		|		/ ISNULL(&QueryTextPackagingFactor1,1)
		|			* CASE
		|				WHEN
		|					TemporaryTableOfGoods_.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|				THEN
		|					&QueryTextPackagingFactor2
		|				ELSE
		|					1
		|			END
		|			* CASE
		|				WHEN
		|					AgreementHeader_.Currency <> TemporaryTableSalesDocument.Currency
		|				THEN
		|					CASE
		|						WHEN ISNULL(CurrencyExchangeRatesForSale.CourseDenominator, 0) > 0
		|							AND ISNULL(CurrencyExchangeRatesForSale.CourseNumerator, 0) > 0
		|							AND ISNULL(ExchangeRatesOfAgreement_.CourseDenominator, 0) > 0
		|							AND ISNULL(ExchangeRatesOfAgreement_.CourseNumerator, 0) > 0
		|						THEN 
		|							(ExchangeRatesOfAgreement_.CourseNumerator * CurrencyExchangeRatesForSale.CourseDenominator)
		|							/ (CurrencyExchangeRatesForSale.CourseNumerator * ExchangeRatesOfAgreement_.CourseDenominator)
		|						ELSE
		|							0
		|					END
		|				ELSE
		|					1
		|			END AS NUMBER(31,2))
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsInFillingInPrice
		|FROM
		|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
		|LEFT JOIN
		|	TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|ON
		|	TRUE
		|
		// CONNECTIONS TO A TRADE AGREEMENT
		|
		|		LEFT JOIN
		|			Catalog.TermsOfSale AS AgreementHeader_
		|		ON
		|			TemporaryTableSalesDocument.Terms = AgreementHeader_.Ref
		|
		|		" + QueryTextOfConnectionTableProductsOfSalesDocument(UsePriceChecks) + "
		|
		|/////////////////////////////////////////////////////////////////////////////
		// CONNECTIONS WITH VAT RATES
		|
		|		LEFT JOIN
		|			InformationRegister.ProductsVATRates.SliceLast(&DATE,
		|				Products IN (SELECT Table.Products FROM TemporaryTableOfGoods_ AS Table)
		| 				AND Country = &RegistrationCountry) AS ProductsVATRates
		|		ON
		|			TemporaryTableOfGoods_.Products = ProductsVATRates.Products
		|		
		|		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&DATE, Country = &RegistrationCountry) AS BasicVATRates
		|		ON
		|			TRUE
		|
		|/////////////////////////////////////////////////////////////////////////////
		// CONNECTIONS WITH CURRENCY EXCHANGE RATES
		|
		|		LEFT JOIN
		|			TemporaryTableCurrencyExchangeRates AS CurrencyExchangeRatesForSale
		|		ON
		|			TemporaryTableSalesDocument.Currency = CurrencyExchangeRatesForSale.Currency
		|
		|		LEFT JOIN
		|			TemporaryTableCurrencyExchangeRates AS ExchangeRatesOfAgreement_
		|		ON
		|			AgreementHeader_.Currency = ExchangeRatesOfAgreement_.Currency
		|" + ?(TableName = "Document.CustomerInvoice"
				Or TableName = "Document.TransferOfGoodsToBailee","
		|WHERE
		|	TemporaryTableOfGoods_.RowCode = 0", "") + "
		|ORDER BY
		|	LineNumber ASC
		|;
		|";
		
	QueryText = StrReplace(QueryText,
		"&AgreementPriceVerificationFields",
		RequestTextOfVerificationFieldProductsOfSalesDocument(UsePriceChecks));

	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor1",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"AgreementGoods.Package",
		"AgreementGoods.Products"));
		
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor2",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"TemporaryTableOfGoods_.Package",
		"TemporaryTableOfGoods_.Products"));
		
EndProcedure

// The request text of the goods verification field of the sales document.
// 
// Parameters:
//  UsePriceManagementSystem25 - Undefined, Boolean - Pricing is used25
// 
// Returns:
//  String - Request text of the verification field products of the sales document
Function RequestTextOfVerificationFieldProductsOfSalesDocument(UsePriceManagementSystem25 = Undefined) Export
	
	If UsePriceManagementSystem25 = Undefined Then
		UsePriceManagementSystem25 = PriceManagementSystemServerCall.UsePriceManagementSystem25();
	EndIf;
	
	If UsePriceManagementSystem25 Then
		QueryText = 
		"CASE
		|
		 // THE TYPE OF PRICE AND THE PRICE ARE NOT DEFINED IN THE AGREEMENT
		|
		|		WHEN
		|			AgreementHeader_.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			AND SpecialPriceType = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			AND (TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage) 
		|				OR (NOT &ReturnOfMultiTurnContainers 
		|					AND TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)))
		|		THEN
		|			TRUE
		|
		|
		 // THE TYPE OF PRICES IN THE PM OF THE GOODS DOCUMENT IS COMPARED WITH THE TYPE OF PRICES IN THE HEADER OF THE AGREEMENT
		|
		|		WHEN NOT (AgreementHeader_.PricesKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			AND TemporaryTableOfGoods_.PriceKind = AgreementHeader_.PricesKind
		|			OR AgreementHeader_.SpecialPriceType <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			AND TemporaryTableOfGoods_.PriceKind = AgreementHeader_.SpecialPriceType)
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingPriceView,
		|
		|	CASE
		|
		 // THE DELIVERY TIME IS NOT CHECKED
		|		WHEN
		|			NOT TemporaryTableOfGoods_.CheckFillingErrorsDeliveryTime
		|		THEN
		|			FALSE
		|
		 // THE DELIVERY PERIOD IS NOT DEFINED IN THE AGREEMENT
		|
		|		WHEN
		|			AgreementHeader_.DeliveryPeriodDays = 0
		|			
		|		THEN
		|			FALSE
		|
		 // THE DELIVERY TIME IN THE PM OF THE DOCUMENT IS COMPARED WITH THE DELIVERY TIME IN THE HEADER OF THE AGREEMENT
		|
		|		WHEN AgreementHeader_.DeliveryPeriodDays <> 0
		|			AND TemporaryTableOfGoods_.DeliveryPeriodDays < AgreementHeader_.DeliveryPeriodDays
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingDeliveryTime,
		|	AgreementHeader_.DeliveryPeriodDays AS DeliveryTimeAgreement,
		|
		|	TemporaryTableOfGoods_.PriceKind AS PriceKind,
		|	CASE
		|		WHEN AgreementGoods.PriceKind IS NULL
		|		THEN
		|			AgreementHeader_.PricesKind
		|		ELSE
		|			AgreementGoods.PriceKind 
		|		END AS TypeOfPriceAgreement";
	Else
		QueryText = 
		"CASE
		|
		 // THE TYPE OF PRICE AND THE PRICE ARE NOT DEFINED IN THE AGREEMENT
		|
		|		WHEN
		|			AgreementHeader_.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			AND (AgreementGoods.PriceKind IS NULL
		|			OR AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef))
		|			AND (AgreementPriceGroups.PricesKind IS NULL
		|			OR AgreementPriceGroups.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef))
		|			AND (AgreementGoods.Products IS NULL
		|			OR AgreementGoods.Price = 0)
		|			AND (TemporaryTableOfGoods_.Products.ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage) 
		|				OR (NOT &ReturnOfMultiTurnContainers 
		|					AND TemporaryTableOfGoods_.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)))
		|		THEN
		|			TRUE
		|
		 // THE TYPE OF PRICE IN PM OF THE DOCUMENT GOODS ARE COMPARED WITH THE TYPE OF PRICES IN PM AGREEMENTS PRICE GROUPS
		|
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef) OR AgreementGoods.PriceKind IS NULL)
		|			AND AgreementPriceGroups.PricesKind IS NOT NULL
		|			AND TemporaryTableOfGoods_.PriceKind <> AgreementPriceGroups.PricesKind
		|		THEN
		|			TRUE
		|
		 // THE TYPE OF PRICE IN PM OF THE DOCUMENT IS COMPARED WITH THE TYPE OF PRICE IN PM OF THE AGREEMENT GOODS
		|
		|		WHEN (AgreementGoods.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef) AND AgreementGoods.PriceKind IS NOT NULL)
		|			AND TemporaryTableOfGoods_.PriceKind <> AgreementGoods.PriceKind
		|		THEN
		|			TRUE
		|
		 // THE TYPE OF PRICES IN THE PM OF THE GOODS DOCUMENT IS COMPARED WITH THE TYPE OF PRICES IN THE HEADER OF THE AGREEMENT
		|
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef) OR AgreementGoods.PriceKind IS NULL)
		|			AND AgreementPriceGroups.PricesKind IS NULL
		|			AND AgreementHeader_.PricesKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			AND TemporaryTableOfGoods_.PriceKind <> AgreementHeader_.PricesKind
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingPriceView,
		|
		|	CASE
		|
		 // THE DELIVERY TIME IS NOT CHECKED
		|		WHEN
		|			NOT TemporaryTableOfGoods_.CheckFillingErrorsDeliveryTime
		|		THEN
		|			FALSE
		|
		 // THE DELIVERY PERIOD IS NOT DEFINED IN THE AGREEMENT
		|
		|		WHEN
		|			AgreementHeader_.DeliveryPeriodDays = 0
		|			AND (AgreementGoods.DeliveryPeriodDays IS NULL
		|			OR AgreementGoods.DeliveryPeriodDays = 0)
		|			AND (AgreementPriceGroups.DeliveryPeriodDays IS NULL
		|			OR AgreementPriceGroups.DeliveryPeriodDays = 0)
		|			
		|		THEN
		|			FALSE
		|
		 // THE DELIVERY TIME IN PM OF THE DOCUMENT IS COMPARED WITH THE DELIVERY TIME IN PM OF THE AGREEMENT PRICE GROUPS
		|
		|		WHEN (AgreementGoods.DeliveryPeriodDays IS NULL OR AgreementGoods.DeliveryPeriodDays = 0)
		|			AND AgreementPriceGroups.DeliveryPeriodDays IS NOT NULL AND AgreementPriceGroups.DeliveryPeriodDays > 0
		|			AND TemporaryTableOfGoods_.DeliveryPeriodDays < AgreementPriceGroups.DeliveryPeriodDays
		|		THEN
		|			TRUE
		|
		 // THE DELIVERY TIME IN PM OF THE DOCUMENT IS COMPARED WITH THE DELIVERY TIME IN PM OF THE GOODS AGREEMENT
		|
		|		WHEN (AgreementGoods.DeliveryPeriodDays IS NOT NULL AND AgreementGoods.DeliveryPeriodDays > 0)
		|			AND TemporaryTableOfGoods_.DeliveryPeriodDays < AgreementGoods.DeliveryPeriodDays
		|		THEN
		|			TRUE
		|
		 // THE DELIVERY TIME IN THE PM OF THE DOCUMENT IS COMPARED WITH THE DELIVERY TIME IN THE HEADER OF THE AGREEMENT
		|
		|		WHEN (AgreementGoods.DeliveryPeriodDays IS NULL OR AgreementGoods.DeliveryPeriodDays = 0)
		|			AND (AgreementPriceGroups.DeliveryPeriodDays IS NULL OR AgreementPriceGroups.DeliveryPeriodDays = 0)
		|			AND AgreementHeader_.DeliveryPeriodDays <> 0
		|			AND TemporaryTableOfGoods_.DeliveryPeriodDays < AgreementHeader_.DeliveryPeriodDays
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingDeliveryTime,
		|	CASE
		|		WHEN (AgreementGoods.DeliveryPeriodDays IS NULL
		|			OR AgreementGoods.DeliveryPeriodDays = 0)
		|			AND AgreementPriceGroups.DeliveryPeriodDays IS NOT NULL
		|			AND AgreementPriceGroups.DeliveryPeriodDays > 0
		|		THEN
		|			AgreementPriceGroups.DeliveryPeriodDays
		|		WHEN (AgreementGoods.DeliveryPeriodDays IS NULL
		|			OR AgreementGoods.DeliveryPeriodDays = 0)
		|			AND (AgreementPriceGroups.DeliveryPeriodDays IS NULL
		|			OR AgreementPriceGroups.DeliveryPeriodDays = 0)
		|		THEN
		|			AgreementHeader_.DeliveryPeriodDays
		|		ELSE
		|			AgreementGoods.DeliveryPeriodDays
		|	END AS DeliveryTimeAgreement,
		|
		|	TemporaryTableOfGoods_.PriceKind AS PriceKind,
		|	CASE
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			OR AgreementGoods.PriceKind IS NULL)
		|			AND AgreementPriceGroups.PricesKind IS NOT NULL
		|		THEN
		|			AgreementPriceGroups.PricesKind
		|		WHEN	(AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			OR AgreementGoods.PriceKind IS NULL)
		|			AND AgreementPriceGroups.PricesKind IS NULL
		|		THEN
		|			AgreementHeader_.PricesKind
		|		ELSE
		|			AgreementGoods.PriceKind
		|	END AS TypeOfPriceAgreement";
	EndIf;

	Return QueryText;
	
EndFunction

// The query text of the goods connection table of the sales document.
// 
// Parameters:
//  UsePriceManagementSystem25 - Undefined, Boolean - Pricing is used25
// 
// Returns:
//  String - Query text of the connection table products of the sales document
Function QueryTextOfConnectionTableProductsOfSalesDocument(UsePriceManagementSystem25 = Undefined) Export
	
	If UsePriceManagementSystem25 = Undefined Then
		UsePriceManagementSystem25 = PriceManagementSystemServerCall.UsePriceManagementSystem25();
	EndIf;
	
	If UsePriceManagementSystem25 Then
		QueryText = 
		"LEFT JOIN
		|			Catalog.ItemKinds AS ItemKinds
		|		ON ItemKinds.Ref = TemporaryTableOfGoods_.Products.ProductKind
		|
		|		LEFT JOIN
		|			InformationRegister.ItemsPrices25.SliceLast(&DATE, (Products, PricingVariant, PricingBatch, PricingPackage) IN 
		|			(SELECT DISTINCT
		|				T.Products,
		|				T.PricingVariant,
		|				T.PricingBatch,
		|				T.PricingPackage
		|			FROM TemporaryTableOfGoods_ AS T)) AS AgreementGoods
		|		ON
		|			AgreementHeader_.SpecialPriceType = AgreementGoods.PriceKind
		|			AND TemporaryTableOfGoods_.Products = AgreementGoods.Products
		|			AND TemporaryTableOfGoods_.PricingVariant = AgreementGoods.PricingVariant
		|			AND TemporaryTableOfGoods_.PricingBatch = AgreementGoods.PricingBatch
		|			AND TemporaryTableOfGoods_.PricingPackage = AgreementGoods.PricingPackage";
	Else
		QueryText = 
		"LEFT JOIN
		|			Catalog.TermsOfSale.Goods AS AgreementGoods
		|		ON
		|			TemporaryTableSalesDocument.Terms = AgreementGoods.Ref
		|			AND TemporaryTableOfGoods_.Products = AgreementGoods.Products
		|			AND TemporaryTableOfGoods_.Characteristic = AgreementGoods.Characteristic
		|
		|		LEFT JOIN
		|			Catalog.TermsOfSale.PriceGroups AS AgreementPriceGroups
		|		ON
		|			TemporaryTableSalesDocument.Terms = AgreementPriceGroups.Ref
		|			AND TemporaryTableOfGoods_.Products.PriceGroup = AgreementPriceGroups.PriceGroup";
	EndIf;

	Return QueryText;
	
EndFunction

// Generates a request to check whether the PM price Group meets the sales conditions
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateQueryThatMatchesProductPriceGroupsToSalesConditions(QueryText)

	QueryText = QueryText + "
		|SELECT
		|	DocumentSales.PriceGroup   AS PriceGroup,
		|	DocumentSales.PricesKind          AS PricesKind,
		|	Terms.PriceGroup        AS PriceGroupAgreement,
		|	Terms.PercentRateOfManualDiscount  AS PercentageManualDiscountAgreement,
		|	Terms.MaximumPercentageForManualMarkup AS PercentageManualMarkUpAgreement,
		|	Terms.PricesKind               AS PriceTypeAgreement,
		|	Terms.DeliveryPeriodDays         AS DeliveryTimeAgreement,
		|	CASE
		|		WHEN Terms.PriceGroup IS NULL
		|			THEN
		|				TRUE
		|			ELSE
		|				FALSE
		|	END AS ThereAreErrorsFillingInPriceGroups,
		|	CASE
		|		WHEN Terms.PricesKind IS NOT NULL AND
		|			DocumentSales.PricesKind <> Terms.PricesKind
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingViewPrices,
		
		|	CASE
		|		WHEN Terms.PercentRateOfManualDiscount IS NOT NULL AND
		|			DocumentSales.PercentRateOfManualDiscount > Terms.PercentRateOfManualDiscount
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingManualDiscount,
		|	CASE
		|		WHEN Terms.MaximumPercentageForManualMarkup IS NOT NULL AND
		|			DocumentSales.MaximumPercentageForManualMarkup > Terms.MaximumPercentageForManualMarkup
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingManualMarkUp,
		
		|	CASE
		|		WHEN Terms.DeliveryPeriodDays IS NOT NULL AND
		|			Terms.DeliveryPeriodDays <> 0 AND
		|			DocumentSales.DeliveryPeriodDays < Terms.DeliveryPeriodDays
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingDeliveryTime,
		
		|	DocumentSales.LineNumber AS LineNumber
		|FROM
		|	TemporaryTablePriceGroups AS DocumentSales
		|LEFT JOIN
		|	Catalog.TermsOfSale.PriceGroups AS Terms
		|ON 
		|	DocumentSales.PriceGroup = Terms.PriceGroup
		|	AND Terms.Ref IN
		|			(SELECT
		|				TemporaryTableSalesDocument.Terms AS Terms
		|			FROM
		|				TemporaryTableSalesDocument AS TemporaryTableSalesDocument)
		|ORDER BY
		|	LineNumber ASC
		|;
		|";

EndProcedure

// Generates a request to check whether products belong to the item segment
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure CreateQueryWhetherProductsBelongToProductSegment(QueryText)

	QueryText = QueryText + "
		|SELECT
		|	NestedQuery.LineNumber                         AS LineNumber,
		|	NestedQuery.Products                        AS Products,
		|	NestedQuery.Characteristic                      AS Characteristic,
		|	NestedQuery.SegmentProducts                AS SegmentProducts,
		|	NestedQuery.CharacteristicsOfSegmentProducts  AS CharacteristicsOfSegmentProducts,
		|	NestedQuery.ProductSegment                 AS ProductSegment
		|FROM
		|(SELECT
		|	DocumentGoods.LineNumber                          AS LineNumber,
		|	DocumentGoods.Products                         AS Products,
		|	DocumentGoods.Characteristic                       AS Characteristic,
		|	SegmentProducts.Products                   AS SegmentProducts,
		|	SegmentProducts.Characteristic                 AS CharacteristicsOfSegmentProducts,
		|	CASE
		|		WHEN
		|			&ThisIsConvention
		|		THEN
		|			TemporaryTableSalesDocument.ProductSegment
		|		ELSE
		|			CustomerTermsOfSales.ProductSegment
		|	END AS ProductSegment
		|FROM
		|	TemporaryTableOfGoods_ AS DocumentGoods
		|
		|LEFT JOIN
		|	TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|ON
		|	TRUE
		|
		|LEFT JOIN
		|	Catalog.TermsOfSale AS CustomerTermsOfSales
		|ON
		|	CustomerTermsOfSales.Ref = TemporaryTableSalesDocument.Terms
		|
		|LEFT JOIN
		|	InformationRegister.SegmentProducts AS SegmentProducts
		|ON
		|	DocumentGoods.Products = SegmentProducts.Products
		|	AND DocumentGoods.Characteristic = SegmentProducts.Characteristic
		|	AND SegmentProducts.Segment = 
		|	CASE
		|		WHEN
		|			&ThisIsConvention
		|		THEN
		|			TemporaryTableSalesDocument.ProductSegment
		|		ELSE
		|			CustomerTermsOfSales.ProductSegment
		|	END
		|	AND
		|	CASE
		|		WHEN
		|			&ThisIsConvention
		|		THEN
		|			TemporaryTableSalesDocument.ProductSegment
		|		ELSE
		|			CustomerTermsOfSales.ProductSegment
		|	END <> VALUE(Catalog.ProductSegments.EmptyRef)
		|) AS NestedQuery
		|WHERE
		|	NestedQuery.ProductSegment <> VALUE(Catalog.ProductSegments.EmptyRef) AND
		|	(NestedQuery.SegmentProducts IS NULL
		|	OR NestedQuery.CharacteristicsOfSegmentProducts IS NULL)
		|ORDER BY
		|	LineNumber ASC
		|;
		|";

EndProcedure

// Generates a request to check whether the partner belongs to the partner segment
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateQueryWhetherPartnerBelongsToPartnerSegment(QueryText)

	QueryText = QueryText + "
		|SELECT
		|	CustomerTermsOfSales.PartnersSegment        AS PartnersSegment,
		|	CASE
		|		WHEN
		|			CustomerTermsOfSales.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
		|		THEN
		|			FALSE
		|		WHEN
		|			SegmentPartners.Partner IS NULL
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsFillingSegment
		|FROM
		|	TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|
		|LEFT JOIN
		|	Catalog.TermsOfSale AS CustomerTermsOfSales
		|ON
		|	CustomerTermsOfSales.Ref = TemporaryTableSalesDocument.Terms
		|
		|LEFT JOIN
		|	InformationRegister.SegmentPartners            AS SegmentPartners
		|ON
		|	SegmentPartners.Segment = CustomerTermsOfSales.PartnersSegment
		|	AND SegmentPartners.Partner = TemporaryTableSalesDocument.Partner
		|;
		|";
	
EndProcedure

// Generates a request to check whether the payment schedule stages are filled in correctly
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForCorrectnessOfPaymentScheduleStages(QueryText, QueryOptions)
	
		QueryText = QueryText + "
			|SELECT
			|	CASE
			|		WHEN TemporaryTableSalesDocument.DocumentAmount = 0
			|				OR CASE WHEN &ScheduleInAgreement
			|						THEN ISNULL(TemporaryTableSalesDocument.Terms.PaymentSchedule, VALUE(Catalog.PaymentSchedules.EmptyRef))
			|						ELSE TemporaryTableSalesDocument.PaymentSchedule
			|					END = VALUE(Catalog.PaymentSchedules.EmptyRef)
			|					AND TemporaryTableSalesDocument.Terms = VALUE(Catalog.TermsOfSale.EmptyRef)
			|			THEN FALSE
			|		ELSE TRUE
			|	END AS ThereAreErrorsFillingStagesOfPaymentSchedule,
			|	
			|	CASE WHEN &ScheduleInAgreement
			|		THEN TemporaryTableSalesDocument.Terms.PaymentSchedule
			|		ELSE  TemporaryTableSalesDocument.PaymentSchedule
			|	END AS PaymentSchedule,
			|	TemporaryTableSalesDocument.Terms AS Terms,
			|	TemporaryTableSalesDocument.Date AS Date,
			|	TemporaryTableSalesDocument.DateOfShipment AS DateOfShipment,
			|	TemporaryTableSalesDocument.DateOfTransferOfTitleToGoods AS DateOfTransferOfTitleToGoods,
			|	ISNULL(TemporaryTableSalesDocument.BusinessOperation, UNDEFINED) = VALUE(Enum.BusinessTransactions.TransferOfTitleToGoods) AS ThisIsTransferOfOwnership2_5,
			|	TemporaryTableSalesDocument.ApprovalDate AS ApprovalDate,
			|	TemporaryTableSalesDocument.InvoiceForOrders AS InvoiceForOrders,
			|	TemporaryTableSalesDocument.ARAPObjectSettings AS ARAPObjectSettings,
			|	TemporaryTableSalesDocument.ThisIsOrder AS ThisIsOrder,
			|	TemporaryTableSalesDocument.NotShipInInstallments AS NotShipInInstallments,
			|
			|	CASE WHEN TemporaryTableSalesDocument.Terms <> VALUE(Catalog.TermsOfSale.EmptyRef)
			|		THEN TemporaryTableSalesDocument.Terms.Calendar
			|		ELSE TemporaryTableSalesDocument.PaymentSchedule.Calendar
			|	END AS Calendar,
			|	
			|	DocumentStages.LineNumber       AS LineNumber,
			|	DocumentStages.PaymentOption     AS PaymentOption,
			|	DocumentStages.CalculateFrom    AS CalculateFrom,
			|	DocumentStages.Move             AS Move,
			|	DocumentStages.PaymentDate       AS PaymentDate,
			|	DocumentStages.PaymentPercentage    AS PaymentPercentage,
			|	
			|	CASE WHEN &PackageDepositIsRequired THEN
			|		DocumentStages.PackageDepositPercentage
			|	ELSE
			|		0
			|	END                            AS PackageDepositPercentage
			|FROM
			|	TimeTableStagesOfPaymentSchedule AS DocumentStages
			|		LEFT JOIN TemporaryTableSalesDocument AS TemporaryTableSalesDocument
			|		ON (TRUE)
			|;
			|";
	
EndProcedure

// Generates a request to check whether the prices of the sales document are within the acceptable range.
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
// UsePriceChecks - Boolean - true, use the new pricing.
//
Procedure GenerateRequestForPricesInAcceptableRange(QueryText, UsePriceChecks)

	QueryText = QueryText + "
		|SELECT
		|	NestedQuery.LineNumber                 AS LineNumber,
		|	NestedQuery.Products                AS Products,
		|	NestedQuery.Characteristic              AS Characteristic,
		|	NestedQuery.PriceCurrency                  AS PriceCurrency,
		|	NestedQuery.Price                        AS Price,
		|	NestedQuery.MinimumAllowablePrice    AS MinimumAllowablePrice,
		|	NestedQuery.MaximumAllowablePrice   AS MaximumAllowablePrice,
		|	CASE
		|		WHEN
		|			NOT ThereIsNoMinimumPrice
		|			AND NestedQuery.Price < NestedQuery.MinimumAllowablePrice
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsMinimumAllowablePrice,
		|	CASE
		|		WHEN
		|			NOT ThereIsNoMaximumPrice
		|			AND NestedQuery.Price > NestedQuery.MaximumAllowablePrice
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereAreErrorsMaximumAllowablePrice
		|FROM (
		|SELECT
		|	TemporaryTableOfGoods_.LineNumber          AS LineNumber,
		|	TemporaryTableOfGoods_.Products         AS Products,
		|	TemporaryTableOfGoods_.Characteristic       AS Characteristic,
		|	TemporaryTableSalesDocument.Currency      AS PriceCurrency,
		|	TemporaryTableOfGoods_.DiscountedPrice_        AS Price,
		|	CASE
		|		WHEN
		|			MinimumPricesOfCrossSectionProductRange.Price IS NULL
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereIsNoMinimumPrice,
		|	CASE
		|		WHEN
		|			MaximumPricesOfCrossSectionProductRange.Price IS NULL
		|		THEN
		|			TRUE
		|		ELSE
		|			FALSE
		|	END AS ThereIsNoMaximumPrice,
		|	CAST(ISNULL(MinimumPricesOfCrossSectionProductRange.Price,0)
		|		/ ISNULL(&QueryTextPackagingFactor1,1)
		|			* CASE
		|				WHEN
		|					TemporaryTableOfGoods_.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|				THEN
		|					&QueryTextPackagingFactor2
		|				ELSE
		|					1
		|			END
		|			* CASE
		|				WHEN
		|					MinimumPricesOfCrossSectionProductRange.Currency <> TemporaryTableSalesDocument.Currency
		|				THEN
		|					CASE
		|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
		|							AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
		|							AND ISNULL(MinimumPriceCurrencyRates.CourseDenominator, 0) > 0
		|							AND ISNULL(MinimumPriceCurrencyRates.CourseNumerator, 0) > 0
		|						THEN 
		|							(MinimumPriceCurrencyRates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|							/ (CurrencyRatesPrices.CourseNumerator * MinimumPriceCurrencyRates.CourseDenominator)
		|						ELSE
		|							0
		|					END
		|				ELSE 
		|					1
		|				END AS NUMBER(31,2))
		|	AS MinimumAllowablePrice,
		|	CAST(ISNULL(MaximumPricesOfCrossSectionProductRange.Price,0)
		|		/ ISNULL(&QueryTextPackagingFactor3,1)
		|			* CASE 
		|				WHEN 
		|					TemporaryTableOfGoods_.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|				THEN
		|					&QueryTextPackagingFactor2
		|				ELSE
		|					1
		|			END
		|			* CASE
		|				WHEN
		|					MaximumPricesOfCrossSectionProductRange.Currency <> TemporaryTableSalesDocument.Currency
		|				THEN
		|					CASE
		|						WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
		|							AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
		|							AND ISNULL(MaximumPriceCurrencyRates.CourseDenominator, 0) > 0
		|							AND ISNULL(MaximumPriceCurrencyRates.CourseNumerator, 0) > 0
		|						THEN 
		|							(MaximumPriceCurrencyRates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
		|							/ (CurrencyRatesPrices.CourseNumerator * MaximumPriceCurrencyRates.CourseDenominator)
		|						ELSE
		|							0
		|					END
		|				ELSE 
		|					1
		|			END AS NUMBER(31,2))
		|	AS MaximumAllowablePrice
		|
		|FROM
		|	TemporaryTableOfGoods_ AS TemporaryTableOfGoods_
		|
		|		LEFT JOIN
		|			TemporaryTableSalesDocument AS TemporaryTableSalesDocument
		|		ON
		|			TRUE
		|
		|		LEFT JOIN
		|			TemporaryTableCurrencyExchangeRates AS CurrencyRatesPrices
		|		ON
		|			TemporaryTableSalesDocument.Currency = CurrencyRatesPrices.Currency
		|
		|/////////////////////////////////////////////////////////////////////////////
		// CONNECTIONS WITH MINIMUM ALLOWABLE PRICES
		|
		|		LEFT JOIN
		|			&MinimumPricesOfCrossSectionProductRange AS MinimumPricesOfCrossSectionProductRange
		|		ON 
		|			&ConditionOfJoiningMinimumPricesOfNomenclatureIsSliceOfLatter
		|
		|		LEFT JOIN
		|			TemporaryTableCurrencyExchangeRates AS MinimumPriceCurrencyRates
		|		ON
		|			MinimumPricesOfCrossSectionProductRange.Currency = MinimumPriceCurrencyRates.Currency
		|
		|/////////////////////////////////////////////////////////////////////////////
		|
		|		LEFT JOIN
		|			&MaximumPricesOfCrossSectionProductRange AS MaximumPricesOfCrossSectionProductRange
		|		ON 
		|			&ConditionOfUnionIsMaximumPricesOfNomenclatureSliceOfLatter
		|
		|		LEFT JOIN
		|			TemporaryTableCurrencyExchangeRates AS MaximumPriceCurrencyRates
		|		ON
		|			MaximumPricesOfCrossSectionProductRange.Currency = MaximumPriceCurrencyRates.Currency
		|
		|WHERE
		|	TemporaryTableOfGoods_.Price > 0
		|	AND (TemporaryTableOfGoods_.RowCode = 0 OR &NotCheckLineCode)
		|) AS NestedQuery
		|ORDER BY
		|	LineNumber ASC
		|;
		|";
	
	QueryText = StrReplace(QueryText,
		"&MinimumPricesOfCrossSectionProductRange",
		PriceManagementSystemClientServer.QueryTextInformationRegisterItemsPrices(
							"TemporaryTableOfGoods_",
							,
							New Structure("Constant", Metadata.Constants.KindOfMinimumAllowableSellingPrices.Name),
							UsePriceChecks));

	QueryText = StrReplace(QueryText,
		"&ConditionOfJoiningMinimumPricesOfNomenclatureIsSliceOfLatter",
		PriceManagementSystemClientServer.RequestTextInformationRegisterItemPricesConnectionCondition(
		"TemporaryTableOfGoods_",
		"MinimumPricesOfCrossSectionProductRange",
		,
		UsePriceChecks));

	QueryText = StrReplace(QueryText,
		"&MaximumPricesOfCrossSectionProductRange",
		PriceManagementSystemClientServer.QueryTextInformationRegisterItemsPrices(
							"TemporaryTableOfGoods_",
							,
							New Structure("Constant", Metadata.Constants.KindOfMaximumAllowableSellingPrices.Name),
							UsePriceChecks));

	QueryText = StrReplace(QueryText,
		"&ConditionOfUnionIsMaximumPricesOfNomenclatureSliceOfLatter",
		PriceManagementSystemClientServer.RequestTextInformationRegisterItemPricesConnectionCondition(
		"TemporaryTableOfGoods_",
		"MaximumPricesOfCrossSectionProductRange",
		,
		UsePriceChecks));

	QueryText = StrReplace(QueryText, "&SourceOfGoods", "TemporaryTableOfGoods_");
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor1",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"MinimumPricesOfCrossSectionProductRange.Package",
		"MinimumPricesOfCrossSectionProductRange.Products"));
		
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor2",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"TemporaryTableOfGoods_.Package",
		"TemporaryTableOfGoods_.Products"));
		
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor3",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"MaximumPricesOfCrossSectionProductRange.Package",
		"MaximumPricesOfCrossSectionProductRange.Products"));
		
EndProcedure

