Function GetQueryTextForTemporaryTableOfDebitedItems(TableName)
	
	QueryText = "
	|SELECT
	|	Table.LineNumber AS LineNumber,
	|	Table.Products AS Products,
	|	Table.Characteristic AS Characteristic,
	|	Table.Purpose AS Purpose
	|INTO TableNameParameter
	|FROM
	|	&Table AS Table
	|;
	|";
	
	QueryText = StrReplace(QueryText, "TableNameParameter", TableName);
	
	Return QueryText;
	
EndFunction

// Returns the query text for the temporary product cost table by line numbers.
//
// Parameters:
// 		TableName - String - Name string for a temporary table
// 		NameOfTemporaryProductTable - String - Name string of the temporary product table.
//
// Returns:
// 		String - The text of the temporary table query.
//
Function GetQueryTextOfTemporaryCostTable(TableName, NameOfTemporaryProductTable)
	
	QueryText = "
	|SELECT
	|	TemporaryTableOfGoods.LineNumber,
	|	TemporaryTableOfGoods.Products,
	|	TemporaryTableOfGoods.Characteristic,
	|	TemporaryTableOfGoods.Purpose,
	|	Dimension.DimensionKey AS DimensionKeyOfProductAccounting
	|INTO TableOfProductsWithAnalyticsKeys
	|FROM 
	|	&NameOfTemporaryProductTable AS TemporaryTableOfGoods
	|		INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
	|		ON Dimension.Products = TemporaryTableOfGoods.Products
	|			AND Dimension.Characteristic = TemporaryTableOfGoods.Characteristic
	|			AND Dimension.Purpose = TemporaryTableOfGoods.Purpose
	|			AND Dimension.StorageLocation = &Warehouse
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	ItemsPrices.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	ItemsPrices.Cost,
	|	ItemsPrices.AdditionalExpenseCost,
	|	ItemsPrices.OffBalanceCost,
	|	ItemsPrices.CostExcludingVAT,
	|	ItemsPrices.AdditionalExpensesCostExcludingVAT,
	|	ItemsPrices.LaborCosts,
	|	ItemsPrices.ItemizedFixedCostsIncludingVAT,
	|	ItemsPrices.ItemizedVariableCostsIncludingVAT,
	|	ItemsPrices.ItemizedFixedCostsExcludingVAT,
	|	ItemsPrices.ItemizedVariableCostsExcludingVAT,
	|	ItemsPrices.LocalCost,
	|	ItemsPrices.OffBalanceCostLocal,
	|	ItemsPrices.AddExpensesLocal,
	|	ItemsPrices.LaborCostsLocal,
	|	ItemsPrices.ItemizedFixedCostsCompl,
	|	ItemsPrices.ItemizedVariableCostsCompl,
	|	ItemsPrices.PermanentDifference,
	|	ItemsPrices.CostTD,
	|	ItemsPrices.CostMan,
	|	ItemsPrices.AddExpensesMan,
	|	ItemsPrices.LaborCostsMan,
	|	ItemsPrices.ItemizedFixedCostsManag,
	|	ItemsPrices.ItemizedVariableCostsManag
	|INTO TTProductPrices
	|FROM
	|	InformationRegister.GoodsCost.SliceLast(
	|			ENDOFPERIOD(&Date, DAY),
	|			(ItemsLocationAttributes, Organization) IN
	|				(SELECT
	|					Table.DimensionKeyOfProductAccounting,
	|					&Organization
	|				FROM
	|					TableOfProductsWithAnalyticsKeys AS Table)) AS ItemsPrices
	|
	|INDEX BY
	|	ItemsLocationAttributes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	RelativeExchangeRatesSliceLast.Currency AS Currency,
	|	RelativeExchangeRatesSliceLast.CourseNumerator AS CourseNumerator,
	|	RelativeExchangeRatesSliceLast.CourseDenominator AS CourseDenominator
	|INTO
	|	TTExchangeRates
	|FROM
	|	InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS
	|		RelativeExchangeRatesSliceLast
	|
	|INDEX BY
	|	Currency
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT ALLOWED
	|		TableOfProductsWithAnalyticsKeys.LineNumber AS LineNumber,
	|		CAST(AVG(ISNULL(ItemsPrices.Cost, 0)
	|						 + ISNULL(ItemsPrices.AdditionalExpenseCost, 0)
	|						 + ISNULL(ItemsPrices.LaborCosts, 0)
	|						 + ISNULL(ItemsPrices.ItemizedFixedCostsIncludingVAT, 0)
	|						 + ISNULL(ItemsPrices.ItemizedVariableCostsIncludingVAT, 0)) AS NUMBER(31,2)) 
	|		* MAX(CASE
	|			WHEN &Currency <> CurrencyOfMan.Value
	|				THEN CASE
	|						WHEN ISNULL(ExchangeRatePrices.CourseDenominator, 0) > 0
	|							AND ISNULL(ExchangeRatePrices.CourseNumerator, 0) > 0
	|							AND ISNULL(DocumentExchangeRate.CourseDenominator, 0) > 0
	|							AND ISNULL(DocumentExchangeRate.CourseNumerator, 0) > 0
	|						THEN 
	|							(ExchangeRatePrices.CourseNumerator * DocumentExchangeRate.CourseDenominator)
	|							/ (DocumentExchangeRate.CourseNumerator * ExchangeRatePrices.CourseDenominator)
	|						ELSE 0
	|					END
	|			ELSE 1
	|		END) AS Price,
	|		CAST(AVG(ISNULL(ItemsPrices.CostExcludingVAT, 0)
	|						 + ISNULL(ItemsPrices.AdditionalExpensesCostExcludingVAT, 0)
	|						 + ISNULL(ItemsPrices.LaborCosts, 0)
	|						 + ISNULL(ItemsPrices.ItemizedFixedCostsExcludingVAT, 0)
	|						 + ISNULL(ItemsPrices.ItemizedVariableCostsExcludingVAT, 0)) AS NUMBER(31,2)) 
	|		* MAX(CASE
	|			WHEN &Currency <> CurrencyOfMan.Value
	|				THEN CASE
	|						WHEN ISNULL(ExchangeRatePrices.CourseDenominator, 0) > 0
	|							AND ISNULL(ExchangeRatePrices.CourseNumerator, 0) > 0
	|							AND ISNULL(DocumentExchangeRate.CourseDenominator, 0) > 0
	|							AND ISNULL(DocumentExchangeRate.CourseNumerator, 0) > 0
	|						THEN 
	|							(ExchangeRatePrices.CourseNumerator * DocumentExchangeRate.CourseDenominator)
	|							/ (DocumentExchangeRate.CourseNumerator * ExchangeRatePrices.CourseDenominator)
	|						ELSE 0
	|					END
	|			ELSE 1
	|		END) AS PriceWithoutVAT,
	|		CAST(AVG(ISNULL(ItemsPrices.OffBalanceCost, 0)) AS NUMBER(31,2))
	|		* MAX(CASE
	|			WHEN &Currency <> CurrencyOfMan.Value
	|				THEN CASE
	|						WHEN ISNULL(ExchangeRatePrices.CourseDenominator, 0) > 0
	|							AND ISNULL(ExchangeRatePrices.CourseNumerator, 0) > 0
	|							AND ISNULL(DocumentExchangeRate.CourseDenominator, 0) > 0
	|							AND ISNULL(DocumentExchangeRate.CourseNumerator, 0) > 0
	|						THEN 
	|							(ExchangeRatePrices.CourseNumerator * DocumentExchangeRate.CourseDenominator)
	|							/ (DocumentExchangeRate.CourseNumerator * ExchangeRatePrices.CourseDenominator)
	|						ELSE 0
	|					END
	|			ELSE 1
	|		END) AS PriceOffBalance
	|INTO TableNameParameter
	|FROM
	|	TableOfProductsWithAnalyticsKeys AS TableOfProductsWithAnalyticsKeys
	|		LEFT JOIN TTProductPrices AS ItemsPrices
	|		ON TableOfProductsWithAnalyticsKeys.DimensionKeyOfProductAccounting = ItemsPrices.ItemsLocationAttributes
	|		LEFT JOIN TTExchangeRates AS DocumentExchangeRate
	|		ON DocumentExchangeRate.Currency = &Currency
	|		LEFT JOIN Constant.ManagementAccountingCurrency AS CurrencyOfMan
	|		ON (TRUE)
	|		LEFT JOIN TTExchangeRates AS ExchangeRatePrices
	|		ON ExchangeRatePrices.Currency = CurrencyOfMan.Value
	|		
	|GROUP BY 
	|TableOfProductsWithAnalyticsKeys.LineNumber;
	|";
	
	QueryText = StrReplace(QueryText, "&NameOfTemporaryProductTable", NameOfTemporaryProductTable);
	QueryText = StrReplace(QueryText, "TableNameParameter", TableName);
	
	Return QueryText;
	
EndFunction

