//
// Parameters:
// Selection         - QueryResultSelection - sampling from the query result
// DocumentSales - DocumentObject - The object for which you want to show error messages
// Cancel           - Boolean - Flag for refusing to carry out the document
// DeviationTree  - ValueTree - A tree with deviations of the table part from the sales conditions.
//
Procedure ReportErrorsAcceptanceOfManualDiscountsMargins(Val Selection,
	                                                       Val DocumentSales,
	                                                       Cancel,
	                                                       DeviationTree = Undefined)
	
	TableName        = Common.TableNameByRef(DocumentSales.Ref);
	TSName             = GetNameOfTablePart(TableName);
	PresentationOfTS   = GetPresentationOfTablePart(TableName);
	
	OutputToReport = (DeviationTree <> Undefined);
	
	While Selection.Next() Do
		
		If (Selection.TheseAreComponents)  Then
			Continue;
		EndIf;
		
		LineNumber = Selection.LineNumber;
		ErrorAddress = " " + NStr("vi = 'trong dòng %LineNumber% danh sách ""%PresentationOfTS%""';
									|ru = 'в строке %LineNumber% списка ""%PresentationOfTS%""';
									|en = 'in line %LineNumber% of the ""%PresentationOfTS%"" list'; fa = 'in line %LineNumber% of the ""%PresentationOfTS%"" list';
									|it = 'nella riga %LineNumber% dell''elenco ""%PresentationOfTS%""';
									|pl = 'w wierszu %LineNumber% listy ""%PresentationOfTS%""';
									|tr = '""%PresentationOfTS%"" listesinin %LineNumber% satırında'");
		ErrorAddress = StrReplace(ErrorAddress, "%LineNumber%",     LineNumber);
		ErrorAddress = StrReplace(ErrorAddress, "%PresentationOfTS%", PresentationOfTS);
		
		If Selection.ThereAreErrorsFillingManualDiscount Then
		
			If Selection.IsRecordsSet Then
				ErrorText = NStr("vi = 'Chiết khấu thủ công cho bộ vượt chiết khấu tối đa được phép ""%MaximumAmountOfManualDiscount% %""';
								|ru = 'Ручная скидка на набор превышает максимально допустимую скидку ""%MaximumAmountOfManualDiscount% %""';
								|en = 'Discount adjustment for the set exceeds maximum allowed discount ""%MaximumAmountOfManualDiscount% %""'; fa = 'Discount adjustment for the set exceeds maximum allowed discount ""%MaximumAmountOfManualDiscount% %""';
								|it = 'Lo sconto manuale sul set supera lo sconto massimo ammissibile ""%MaximumAmountOfManualDiscount% %""';
								|pl = 'Ręczna marża dla zestawu przekracza maksymalną dopuszczalną wartość rabatu ""%MaximumAmountOfManualDiscount% %""';
								|tr = 'Küme için indirim düzeltmesi, mümkün maksimum ""%MaximumAmountOfManualDiscount%%"" indirimini aşıyor'");
			Else
				ErrorText = NStr("vi = 'Chiết khấu thủ công vượt chiết khấu được phép tối đa ""%MaximumAmountOfManualDiscount% %""';
								|ru = 'Ручная скидка превышает максимально допустимую скидку ""%MaximumAmountOfManualDiscount% %""';
								|en = 'Discount adjustment exceeds maximum allowed discount ""%MaximumAmountOfManualDiscount% %""'; fa = 'Discount adjustment exceeds maximum allowed discount ""%MaximumAmountOfManualDiscount% %""';
								|it = 'Lo sconto manuale superare lo sconto massimo ammissibile ""%MaximumAmountOfManualDiscount% %""';
								|pl = 'Ręczna marża przekracza maksymalną dopuszczalną wartość rabatu ""%MaximumAmountOfManualDiscount% %""';
								|tr = 'İndirim düzeltmesi, mümkün maksimum indirim olan ""%MaximumAmountOfManualDiscount% %""yi aşıyor'");
			EndIf;
			
			ErrorText = StrReplace(ErrorText, "%MaximumAmountOfManualDiscount%", Selection.MaximumAmountOfManualDiscount);
			ErrorText = StrReplace(ErrorText, "%LineNumber%",                   Selection.LineNumber);
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PercentRateOfManualDiscount", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					CommonClientServer.PathToTabularSection(TSName, Selection.LineNumber,"PercentRateOfManualDiscount"),
					Cancel);
			EndIf;
			
		ElsIf Selection.ThereAreErrorsFillingManualMarkUp Then
			
			If Selection.IsRecordsSet Then
				ErrorText = NStr("vi = 'Phụ thu thủ công cho bộ vượt phụ thu tối đa được phép ""%MaximumAmountOfManualMarkUp% %""';
								|ru = 'Ручная наценка на набор превышает максимально допустимую наценку ""%MaximumAmountOfManualMarkUp% %""';
								|en = 'Manual markup for the set is greater than maximum allowed markup ""%MaximumAmountOfManualMarkUp% %""'; fa = 'Manual markup for the set is greater than maximum allowed markup ""%MaximumAmountOfManualMarkUp% %""';
								|it = 'La maggiorazione manuale del set supera la maggiorazione massima ammissibile ""%MaximumAmountOfManualMarkUp% %""';
								|pl = 'Ręczna marża dla zestawu przekracza maksymalną dopuszczalną marżę ""%MaximumAmountOfManualMarkUp% %""';
								|tr = 'Kümedeki manuel zam, ""%MaximumAmountOfManualMarkUp%%"" mümkün maksimum zamı aşıyor'");
			Else
				ErrorText = NStr("vi = 'Phụ thu thủ công vượt phụ thu được phép tối đa ""%MaximumAmountOfManualMarkUp% %""';
								|ru = 'Ручная наценка превышает максимально допустимую наценку ""%MaximumAmountOfManualMarkUp% %""';
								|en = 'Manual markup exceeds maximum allowed markup ""%MaximumAmountOfManualMarkUp% %""'; fa = 'Manual markup exceeds maximum allowed markup ""%MaximumAmountOfManualMarkUp% %""';
								|it = 'La maggiorazione manuale supera la maggiorazione massima ammissibile ""%MaximumAmountOfManualMarkUp% %""';
								|pl = 'Ręczna marża przekracza maksymalną dopuszczalną marżę ""%MaximumAmountOfManualMarkUp% %""';
								|tr = 'Manuel zam, mümkün maksimum zamı ""%MaximumAmountOfManualMarkUp%%"" aşıyor'");
			EndIf;
			
			ErrorText = StrReplace(ErrorText, "%MaximumAmountOfManualMarkUp%", Selection.MaximumAmountOfManualMarkUp);
			ErrorText = StrReplace(ErrorText, "%LineNumber%",                    Selection.LineNumber);
			
			If OutputToReport Then
