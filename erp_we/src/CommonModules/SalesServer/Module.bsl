	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
	|				OR ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|			THEN ReferenceOrder.CarrierPartner
	|		ELSE VALUE(Catalog.Partners.EmptyRef)
	|	END AS CarrierPartner,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod <> VALUE(Enum.TransportMethods.SelfPickup)
	|			OR ReferenceOrder.DeliveryAddress <> """"
	|			THEN ReferenceOrder.DeliveryAddress
	|		ELSE """"
	|	END AS DeliveryAddress,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
	|				OR ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|			THEN ReferenceOrder.DeliveryAddressOfCarrier
	|		ELSE """"
	|	END AS DeliveryAddressOfCarrier,
	|
	|	ReferenceOrder.ToReturnReusablePackage AS ToReturnReusablePackage,
	|	ReferenceOrder.ReusablePackageReturnCycleLength AS ReusablePackageReturnCycleLength,
	|	ReferenceOrder.PackageDepositIsRequired AS PackageDepositIsRequired,
	|	VALUE(Catalog.BusinessCalendars.EmptyRef)AS ScheduleOfPackageReturn,
	|	FALSE AS CalculatePackageReturnDateAccordingToCalendar,
	|	ReferenceOrder.LineOfBusiness AS LineOfBusiness,
	|	ReferenceOrder.ARAPObjectSettings AS ARAPObjectSettings,
	|	ReferenceOrder.ThisIsOrderAsInvoice AS ThisIsOrderAsInvoice
	|INTO TT_References
	|FROM
	|	Document.SalesOrder AS ReferenceOrder
	|INNER JOIN
	|	Document.SalesOrder.Goods AS CustomerOrderGoods
	|ON
	|	ReferenceOrder.Ref = CustomerOrderGoods.Ref
	|LEFT JOIN
	|	Catalog.Warehouses AS Warehouses
	|ON
