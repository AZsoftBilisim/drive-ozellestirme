	|	CASE
	|		WHEN Warehouses.IsFolder
	|			AND Warehouses.SelectGroup = VALUE(Enum.SelectWarehouseGroup.AllowInOrders)
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS WarehouseInOrderHeader,
	|	ReferenceOrder.Department AS Department,
	|	ReferenceOrder.BusinessOperation AS BusinessOperation,
	|	CustomerOrderGoods.Count AS ToRegisterBalance,
	|	ReferenceOrder.Currency AS ARAPCurrency,
	|	ReferenceOrder.VATTaxation AS VATTaxation,
	|	ReferenceOrder.PriceIncludesVAT AS PriceIncludesVAT,
	|	CustomerOrderGoods.Products.SaleRegistrationOption AS SaleRegistrationOption,
