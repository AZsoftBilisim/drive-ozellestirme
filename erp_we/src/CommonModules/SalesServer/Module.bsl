// Defines the business transaction of sale for the business transaction of return
//
// Parameters:
//   BusinessOperationRefund - EnumRef.BusinessTransactions - business operation of the refund.
//
// Returns:
//   EnumRef.BusinessTransactions - business operation of implementation.
//
Function GetBusinessOfOperationOfImplementationOfRefund(Val BusinessOperationRefund) Export
	
	If BusinessOperationRefund = Enums.BusinessTransactions.ReturnOfGoodsFromCustomer
	 Or Not ValueIsFilled(BusinessOperationRefund) Then
		Return Enums.BusinessTransactions.SaleToCustomer;
	ElsIf BusinessOperationRefund = Enums.BusinessTransactions.ReturnFromCommissionAgent Then
		Return Enums.BusinessTransactions.TransferToCommissionAgent;
	ElsIf BusinessOperationRefund = Enums.BusinessTransactions.ReturnFromCustodian Then
		Return Enums.BusinessTransactions.TransferToStorageWithRightOfSale;
	EndIf;
	
EndFunction

