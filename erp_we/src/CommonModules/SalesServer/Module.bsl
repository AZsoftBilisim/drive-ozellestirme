	Result.Insert("ReferenceArray");
	Result.Insert("Organization", Catalogs.Companies.EmptyRef());
	Result.Insert("CashAccount", Catalogs.CashAccounts.EmptyRef());
	Result.Insert("HasErrors");

	Return Result;
	
EndFunction

