// The function returns the request text for implementation documents and orders.
// Used when entering a line for selecting an expense item analysis.
//
// Returns:
//   String - the text of the request for implementation documents and orders.
//
Function GETRequestTextImplementationDocuments()
	
	QueryText =
	// When changing the request text, it is necessary to change
	// the request for the dynamic list of the form "General forms.Electionalitikiraskhodov".
	"SELECT TOP 51
	|	DocumentsRegistry.Ref					AS Ref,
	|	PRESENTATION(DocumentsRegistry.Ref)	AS RepresentationOfTheReference,
	|	DocumentsRegistry.IBDocumentDate		AS Date,
	|	DocumentsRegistry.IBDocumentNumber		AS Number,
	|	DocumentsRegistry.Organization			AS Organization,
	|	DocumentsRegistry.Partner				AS Partner,
	|	DocumentsRegistry.Counterparty				AS Counterparty,
	|	DocumentsRegistry.Sum					AS Sum,
	|	DocumentsRegistry.Currency					AS Currency,
	|	VALUETYPE(DocumentsRegistry.Ref)	AS Type,
	|	CASE
	|		WHEN DocumentsRegistry.Posted
	|			THEN 0
	|		WHEN DocumentsRegistry.DeletionMark
	|			THEN 1
	|		ELSE 2
	|	END									AS DocumentState
	|FROM
	|	InformationRegister.DocumentsRegistry AS DocumentsRegistry
	|
	|	LEFT JOIN Document.CustomerInvoice AS CustomerInvoice
	|		ON DocumentsRegistry.Ref = CustomerInvoice.Ref
	|
	|	LEFT JOIN Document.CustomerInvoiceServices AS CustomerInvoiceServices
	|		ON DocumentsRegistry.Ref = CustomerInvoiceServices.Ref
	|
	|WHERE
	|	DocumentsRegistry.RefType IN (&RefsTypes)
	|	AND DocumentsRegistry.AdditionalRecord = FALSE
	|	AND NOT DocumentsRegistry.BusinessOperation IN (VALUE(Enum.BusinessTransactions.TransferToCommissionAgent),
	|												VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent))
	|	AND ISNULL(CustomerInvoice.SalesOrder, ISNULL(CustomerInvoiceServices.SalesOrder, UNDEFINED))
	|		IN (UNDEFINED, VALUE(Document.SalesOrder.EmptyRef))
	|	AND DocumentsRegistry.IBDocumentNumber LIKE &SearchString
	|";
	
	Return QueryText;
	
EndFunction

