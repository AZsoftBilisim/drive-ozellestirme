#Region ProceduresForInitializingSalesRules

// Returns the structure of sales terms for a trade agreement.
//
// Parameters:
// 	Terms - CatalogRef.TermsOfSale - link to the agreement with the client
// 	ConsiderWarehouseGroups - Boolean
// 	ExcludeWarehouseGroupsAvailableInOrders - Boolean
//
// Returns:
// 	Structure - A structure that includes sales conditions.
//
Function GetTermsAndConditionsOfSale(Val Terms,
	                          Val ConsiderWarehouseGroups=False,
	                          Val ExcludeWarehouseGroupsAvailableInOrders=False) Export
	
	Query = New Query(
		"SELECT
		|	CustomerTermsOfSales.Ref                                      AS Terms,
		|	CustomerTermsOfSales.Partner                                     AS Partner,
		|	CustomerTermsOfSales.Counterparty                                  AS Counterparty,
		|	CustomerTermsOfSales.ContactPerson                              AS ContactPerson,
		|	CustomerTermsOfSales.Organization                                 AS Organization,
		|	CustomerTermsOfSales.Currency                                      AS Currency,
		|	CASE 
		|		WHEN CustomerTermsOfSales.ContractsAreUsed
		|			THEN CustomerTermsOfSales.Currency
		|		ELSE CustomerTermsOfSales.ARAPCurrency
		|	END                                                           AS ARAPCurrency,
		|	CASE
		|		WHEN &UsePaymentSchedules
		|			THEN CustomerTermsOfSales.PaymentSchedule
		|		ELSE VALUE(Catalog.PaymentSchedules.EmptyRef)
		|	END                                                           AS PaymentSchedule,
		|	CASE
		|		WHEN &UsePaymentSchedules
		|			THEN CustomerTermsOfSales.PaymentSchedule.PaymentMethod
		|		ELSE CustomerTermsOfSales.PaymentMethod
		|	END                                                           AS PaymentMethod,
		|	CustomerTermsOfSales.ForeignCurrencyTransaction                               AS ForeignCurrencyTransaction,
		|	CustomerTermsOfSales.FinancialAccountingGroup                      AS FinancialAccountingGroup,
		|	CustomerTermsOfSales.CashFlowItem               AS CashFlowItem,
		|	CustomerTermsOfSales.DocumentAmount                              AS DocumentAmount,
		|	CustomerTermsOfSales.Frequent                                  AS Frequent,
		|	CustomerTermsOfSales.Period                                      AS Period,
		|	CustomerTermsOfSales.NumberOfPeriods                          AS NumberOfPeriods,
		|	CustomerTermsOfSales.DeliveryPeriodDays                                AS DeliveryPeriodDays,
		|	CustomerTermsOfSales.PricesKind                                      AS PricesKind,
		|	CustomerTermsOfSales.PriceIncludesVAT                             AS PriceIncludesVAT,
		|	CustomerTermsOfSales.UsedInSalesRepresentativesWork   AS UsedInSalesRepresentativesWork,
		|	CASE
		|		WHEN NOT CustomerTermsOfSales.Warehouse.IsFolder
		|			THEN CustomerTermsOfSales.Warehouse
		|		WHEN CustomerTermsOfSales.Warehouse.IsFolder
		|				AND &ConsiderWarehouseGroups
		|				AND CustomerTermsOfSales.Warehouse.SelectGroup IN (&SelectWarehouseGroup)
		|			THEN CustomerTermsOfSales.Warehouse
		|		ELSE VALUE(Catalog.Warehouses.EmptyRef)
		|	END AS Warehouse,
		|	CustomerTermsOfSales.ProductSegment                           AS ProductSegment,
		|	CustomerTermsOfSales.Standard_                                       AS Standard_,
		|	CustomerTermsOfSales.ValidityStartDate                            AS ValidityStartDate,
		|	CustomerTermsOfSales.ValidityEndDate                         AS ValidityEndDate,
		|	CustomerTermsOfSales.BusinessOperation                         AS BusinessOperation,
		|	CustomerTermsOfSales.CommissionFeeCalculationMethod                   AS CommissionFeeCalculationMethod,
		|	CustomerTermsOfSales.RemunerationPercentage                         AS RemunerationPercentage,
		|	CustomerTermsOfSales.KeepCommissionFee                        AS KeepCommissionFee,
		|	CustomerTermsOfSales.LimitDiscountAdjustments                      AS LimitDiscountAdjustments,
		|	CustomerTermsOfSales.PercentRateOfManualDiscount                           AS PercentRateOfManualDiscount,
		|	CustomerTermsOfSales.MaximumPercentageForManualMarkup                          AS MaximumPercentageForManualMarkup,
		|	CustomerTermsOfSales.ContractsAreUsed              AS ContractsAreUsed,
		|	CustomerTermsOfSales.ARAPObjectSettings                               AS ARAPObjectSettings,
		|	CustomerTermsOfSales.AvailableToExternalUsers                  AS AvailableToExternalUsers,
		|	CustomerTermsOfSales.Status                                        AS AgreementStatus,
		|	CustomerTermsOfSales.ReturnReusablePackage                  AS ReturnReusablePackage,
		|	CustomerTermsOfSales.ReusablePackageReturnCycleLength                AS ReusablePackageReturnCycleLength,
		|	CustomerTermsOfSales.CalculatePackageReturnDateAccordingToCalendar       AS CalculatePackageReturnDateAccordingToCalendar,
		|	CustomerTermsOfSales.ScheduleOfPackageReturn                         AS ScheduleOfPackageReturn,
		|	CustomerTermsOfSales.PackageDepositIsRequired                          AS PackageDepositIsRequired,
		|	CustomerTermsOfSales.SaleWithDeferredTransferOfTitleIsAllowed AS SaleWithDeferredTransferOfTitleIsAllowed,
		|	CustomerTermsOfSales.DeadlineOfTransferOfTitleToGoods                AS DeadlineOfTransferOfTitleToGoods,
		|	CustomerTermsOfSales.EnableAssigmentSupplyForOrders                 AS EnableAssigmentSupplyForOrders,
		|	CustomerTermsOfSales.Calendar                                     AS Calendar,
		|	CustomerTermsOfSales.OrderFrequency                                 AS OrderFrequency,
		|	CustomerTermsOfSales.MinimumOrderAmount                        AS MinimumOrderAmount,
		|	CustomerTermsOfSales.LineOfBusiness                       AS LineOfBusiness,
		|	CustomerTermsOfSales.CommissionAgentUsesInventoryAccountingByProductBatchID                    AS CommissionAgentUsesInventoryAccountingByProductBatchID,
		|	CustomerTermsOfSales.ConsignmentSales25                         AS NewCommissionScheme
		|
		|FROM
		|	Catalog.TermsOfSale AS CustomerTermsOfSales
		|WHERE
		|	CustomerTermsOfSales.Ref = &Terms");
	
		Query.SetParameter("Terms",                Terms);
		Query.SetParameter("SelectWarehouseGroup",        Catalogs.Warehouses.OptionsForSelectingWarehouseGroup(ExcludeWarehouseGroupsAvailableInOrders));
		Query.SetParameter("ConsiderWarehouseGroups",    ConsiderWarehouseGroups);
		Query.SetParameter("UsePaymentSchedules", GetFunctionalOption("UsePaymentSchedules"));
		
		QueryResult = Query.Execute();
		Selection          = QueryResult.Select();
		
		Selection.Next();
		
		AttributesStructure1 = SalesConditionsTemplate();
		FillPropertyValues(AttributesStructure1, Selection);
		
		If Not GetFunctionalOption("UseCustomerContracts") Then
			AttributesStructure1.Insert("ContractsAreUsed", False);
		EndIf;
		
		Return AttributesStructure1;

EndFunction

// Returns the structure of sales terms by partner.
//
// Parameters:
//	Partner           - CatalogRef.Partners - to the partner for whom you need to get the terms of sale.
//	FilterParameters   - Structure - contains parameters for selecting an agreement.
//	CustomerAgreementsAreApplicable - Boolean - a sign of the applicability of agreements.
//
// Returns:
//	Structure, Undefined - contains the default sales conditions.
//
Function GetDefaultSalesTerms(
			Val Partner = Undefined, FilterParameters = Undefined, CustomerAgreementsAreApplicable = True) Export
	
	AttributesStructure1 = SalesConditionsTemplate();
	
	ToUseTermsOfSales = GetFunctionalOption("ToUseTermsOfSales")
									   And CustomerAgreementsAreApplicable;
	UseCustomerContracts	 = GetFunctionalOption("UseCustomerContracts");
	
	If ToUseTermsOfSales Then
		
		// Let's take into account the option of using agreements
		UseStandardTermsOfSalesWithCustomers        = GetFunctionalOption("UseStandardTermsOfSalesWithCustomers");
		UseCustomerTermsOfSales = GetFunctionalOption("UseCustomerTermsOfSales");
		
		OnlyStandard = UseStandardTermsOfSalesWithCustomers And Not UseCustomerTermsOfSales;
		OnlyPersonal = Not UseStandardTermsOfSalesWithCustomers And UseCustomerTermsOfSales;
		
		AllSelectionParameters = New Structure();
		AllSelectionParameters.Insert("OnlyStandard",                           OnlyStandard);
		AllSelectionParameters.Insert("OnlyPersonal",                    OnlyPersonal);
		AllSelectionParameters.Insert("OnlyUsedBySalesRepresentative",             False);
		AllSelectionParameters.Insert("ConsiderWarehouseGroups",                  False);
		AllSelectionParameters.Insert("ExcludeWarehouseGroupsAvailableInOrders", False);
		AllSelectionParameters.Insert("BusinessTransactions",                   Undefined);
		AllSelectionParameters.Insert("SelectedAgreement",                     Catalogs.TermsOfSale.EmptyRef());
		AllSelectionParameters.Insert("ConsignmentSales25",                   Undefined);
		AllSelectionParameters.Insert("ShipmentWithDeferredTransferOfTitle25", False);
		AllSelectionParameters.Insert("Currency",                                  Undefined);
		
		If FilterParameters <> Undefined Then
			FillPropertyValues(AllSelectionParameters, FilterParameters);
		EndIf;
		
		QueryText = "
			|SELECT ALLOWED TOP 2
			|	CustomerTermsOfSales.Ref                                      AS Terms,
			|	CustomerTermsOfSales.Standard_                                     AS Standard_,
			|	CustomerTermsOfSales.Partner                                     AS Partner,
			|	CustomerTermsOfSales.Counterparty                                  AS Counterparty,
			|	CustomerTermsOfSales.ContactPerson                              AS ContactPerson,
			|	CustomerTermsOfSales.Organization                                 AS Organization,
			|	CustomerTermsOfSales.Currency                                      AS Currency,
			|	CASE 
			|		WHEN CustomerTermsOfSales.ContractsAreUsed
			|			THEN CustomerTermsOfSales.Currency
			|		ELSE CustomerTermsOfSales.ARAPCurrency
			|	END                                                           AS ARAPCurrency,
			|	CASE
			|		WHEN &UsePaymentSchedules
			|			THEN CustomerTermsOfSales.PaymentSchedule
			|		ELSE VALUE(Catalog.PaymentSchedules.EmptyRef)
			|	END                                                             AS PaymentSchedule,
			|	CASE
			|		WHEN &UsePaymentSchedules
			|			THEN CustomerTermsOfSales.PaymentSchedule.PaymentMethod
			|		ELSE CustomerTermsOfSales.PaymentMethod
			|	END                                                           AS PaymentMethod,
			|	CustomerTermsOfSales.ForeignCurrencyTransaction                               AS ForeignCurrencyTransaction,
			|	CustomerTermsOfSales.DocumentAmount                              AS DocumentAmount,
			|	CustomerTermsOfSales.Frequent                                  AS Frequent,
			|	CustomerTermsOfSales.Period                                      AS Period,
			|	CustomerTermsOfSales.NumberOfPeriods                          AS NumberOfPeriods,
			|	CustomerTermsOfSales.DeliveryPeriodDays                                AS DeliveryPeriodDays,
			|	CustomerTermsOfSales.PricesKind                                      AS PricesKind,
			|	CustomerTermsOfSales.PriceIncludesVAT                             AS PriceIncludesVAT,
			|	CustomerTermsOfSales.UsedInSalesRepresentativesWork   AS UsedInSalesRepresentativesWork,
			|	CASE
			|		WHEN
			|			NOT CustomerTermsOfSales.Warehouse.IsFolder
			|		THEN
			|			CustomerTermsOfSales.Warehouse
			|		WHEN
			|			CustomerTermsOfSales.Warehouse.IsFolder
			|			AND &ConsiderWarehouseGroups
			|			AND CustomerTermsOfSales.Warehouse.SelectGroup IN (&SelectWarehouseGroup)
			|		THEN
			|			CustomerTermsOfSales.Warehouse
			|		ELSE
			|			VALUE(Catalog.Warehouses.EmptyRef)
			|	END AS Warehouse,
			|	CustomerTermsOfSales.ProductSegment                         AS ProductSegment,
			|	CustomerTermsOfSales.ValidityStartDate                          AS ValidityStartDate,
			|	CustomerTermsOfSales.ValidityEndDate                       AS ValidityEndDate,
			|	CustomerTermsOfSales.BusinessOperation                       AS BusinessOperation,
			|	CustomerTermsOfSales.LimitDiscountAdjustments                    AS LimitDiscountAdjustments,
			|	CustomerTermsOfSales.PercentRateOfManualDiscount                         AS PercentRateOfManualDiscount,
			|	CustomerTermsOfSales.MaximumPercentageForManualMarkup                        AS MaximumPercentageForManualMarkup,
			|	CustomerTermsOfSales.CommissionFeeCalculationMethod                 AS CommissionFeeCalculationMethod,
			|	CustomerTermsOfSales.RemunerationPercentage                       AS RemunerationPercentage,
			|	CustomerTermsOfSales.KeepCommissionFee                      AS KeepCommissionFee,
			|	CustomerTermsOfSales.ContractsAreUsed            AS ContractsAreUsed,
			|	CustomerTermsOfSales.ARAPObjectSettings                             AS ARAPObjectSettings,
			|	CustomerTermsOfSales.FinancialAccountingGroup                      AS FinancialAccountingGroup,
			|	CustomerTermsOfSales.CashFlowItem               AS CashFlowItem,
			|	CustomerTermsOfSales.AvailableToExternalUsers                AS AvailableToExternalUsers,
			|	CustomerTermsOfSales.Status                                      AS AgreementStatus,
			|	CustomerTermsOfSales.ReturnReusablePackage                AS ReturnReusablePackage,
			|	CustomerTermsOfSales.ReusablePackageReturnCycleLength              AS ReusablePackageReturnCycleLength,
			|	CustomerTermsOfSales.CalculatePackageReturnDateAccordingToCalendar     AS CalculatePackageReturnDateAccordingToCalendar,
			|	CustomerTermsOfSales.ScheduleOfPackageReturn                       AS ScheduleOfPackageReturn,
			|	CustomerTermsOfSales.PackageDepositIsRequired                        AS PackageDepositIsRequired,
			|	CustomerTermsOfSales.EnableAssigmentSupplyForOrders               AS EnableAssigmentSupplyForOrders,
			|	CustomerTermsOfSales.SaleWithDeferredTransferOfTitleIsAllowed AS SaleWithDeferredTransferOfTitleIsAllowed,
			|	CustomerTermsOfSales.Calendar                                   AS Calendar,
			|	CustomerTermsOfSales.OrderFrequency                               AS OrderFrequency,
			|	CustomerTermsOfSales.MinimumOrderAmount                      AS MinimumOrderAmount,
			|	CustomerTermsOfSales.LineOfBusiness                     AS LineOfBusiness,
			|	CustomerTermsOfSales.CommissionAgentUsesInventoryAccountingByProductBatchID                  AS CommissionAgentUsesInventoryAccountingByProductBatchID,
			|	CustomerTermsOfSales.ConsignmentSales25                       AS NewCommissionScheme
			|FROM
			|	Catalog.TermsOfSale AS CustomerTermsOfSales
			|WHERE
			|	NOT CustomerTermsOfSales.DeletionMark AND
			|	CustomerTermsOfSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			|	AND CustomerTermsOfSales.Standard_
			|	AND NOT &OnlyPersonal
			|	AND (NOT &SelectionByOperation
			|		OR CustomerTermsOfSales.BusinessOperation IN(&BusinessTransactions))
			|	AND &OnlyUsedBySalesRepresentative
			|	AND CASE
			|		WHEN &FilterConsignmentSales25
			|			AND &FilterShipmentWithDeferredTransferOfTitle25
			|			THEN &ConditionFee25
			|				OR &ConditionShipmentWithoutPPS25
			|				OR CustomerTermsOfSales.BusinessOperation IN
			|				(VALUE(Enum.BusinessTransactions.DeliveryForPrincipal),
			|				VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale))
			|		WHEN &FilterConsignmentSales25
			|			THEN &ConditionFee25
			|		WHEN &FilterShipmentWithDeferredTransferOfTitle25
			|			THEN &ConditionShipmentWithoutPPS25
			|		ELSE TRUE
			|	END
			|	AND ((NOT &FilterCurrency)
			|			OR CustomerTermsOfSales.Currency = &Currency)
			|	AND &ReplacementText1
			|AND &ReplacementText2
			|;
			|
			|SELECT ALLOWED
			|	CustomerTermsOfSales.Ref                                      AS Terms,
			|	CustomerTermsOfSales.Standard_                                     AS Standard_,
			|	CustomerTermsOfSales.Partner                                     AS Partner,
			|	CustomerTermsOfSales.Counterparty                                  AS Counterparty,
			|	CustomerTermsOfSales.ContactPerson                              AS ContactPerson,
			|	CustomerTermsOfSales.Organization                                 AS Organization,
			|	CustomerTermsOfSales.Currency                                      AS Currency,
			|	CASE 
			|		WHEN CustomerTermsOfSales.ContractsAreUsed
			|			THEN CustomerTermsOfSales.Currency
			|		ELSE CustomerTermsOfSales.ARAPCurrency
			|	END                                                           AS ARAPCurrency,
			|	CASE
			|		WHEN &UsePaymentSchedules
			|			THEN CustomerTermsOfSales.PaymentSchedule
			|		ELSE VALUE(Catalog.PaymentSchedules.EmptyRef)
			|	END                                                           AS PaymentSchedule,
			|	CASE
			|		WHEN &UsePaymentSchedules
			|			THEN CustomerTermsOfSales.PaymentSchedule.PaymentMethod
			|		ELSE CustomerTermsOfSales.PaymentMethod
			|	END                                                           AS PaymentMethod,
			|	CustomerTermsOfSales.ForeignCurrencyTransaction                               AS ForeignCurrencyTransaction,
			|	CustomerTermsOfSales.DocumentAmount                              AS DocumentAmount,
			|	CustomerTermsOfSales.Frequent                                  AS Frequent,
			|	CustomerTermsOfSales.Period                                      AS Period,
			|	CustomerTermsOfSales.NumberOfPeriods                          AS NumberOfPeriods,
			|	CustomerTermsOfSales.DeliveryPeriodDays                                AS DeliveryPeriodDays,
			|	CustomerTermsOfSales.PricesKind                                      AS PricesKind,
			|	CustomerTermsOfSales.PriceIncludesVAT                             AS PriceIncludesVAT,
			|	CustomerTermsOfSales.UsedInSalesRepresentativesWork   AS UsedInSalesRepresentativesWork,
			|	CASE
			|		WHEN
			|			NOT CustomerTermsOfSales.Warehouse.IsFolder
			|		THEN
			|			CustomerTermsOfSales.Warehouse
			|		WHEN
			|			CustomerTermsOfSales.Warehouse.IsFolder
			|			AND &ConsiderWarehouseGroups
			|			AND CustomerTermsOfSales.Warehouse.SelectGroup IN (&SelectWarehouseGroup)
			|		THEN
			|			CustomerTermsOfSales.Warehouse
			|		ELSE
			|			VALUE(Catalog.Warehouses.EmptyRef)
			|	END AS Warehouse,
			|	CustomerTermsOfSales.ProductSegment                         AS ProductSegment,
			|	CustomerTermsOfSales.ValidityStartDate                          AS ValidityStartDate,
			|	CustomerTermsOfSales.ValidityEndDate                       AS ValidityEndDate,
			|	CustomerTermsOfSales.BusinessOperation                       AS BusinessOperation,
			|	CustomerTermsOfSales.LimitDiscountAdjustments                    AS LimitDiscountAdjustments,
			|	CustomerTermsOfSales.PercentRateOfManualDiscount                         AS PercentRateOfManualDiscount,
			|	CustomerTermsOfSales.MaximumPercentageForManualMarkup                        AS MaximumPercentageForManualMarkup,
			|	CustomerTermsOfSales.CommissionFeeCalculationMethod                 AS CommissionFeeCalculationMethod,
			|	CustomerTermsOfSales.RemunerationPercentage                       AS RemunerationPercentage,
			|	CustomerTermsOfSales.KeepCommissionFee                      AS KeepCommissionFee,
			|	CustomerTermsOfSales.ContractsAreUsed            AS ContractsAreUsed,
			|	CustomerTermsOfSales.ARAPObjectSettings                             AS ARAPObjectSettings,
			|	CustomerTermsOfSales.FinancialAccountingGroup                      AS FinancialAccountingGroup,
			|	CustomerTermsOfSales.CashFlowItem               AS CashFlowItem,
			|	CustomerTermsOfSales.AvailableToExternalUsers                AS AvailableToExternalUsers,
			|	CustomerTermsOfSales.Status                                      AS AgreementStatus,
			|	CustomerTermsOfSales.ReturnReusablePackage                AS ReturnReusablePackage,
			|	CustomerTermsOfSales.ReusablePackageReturnCycleLength              AS ReusablePackageReturnCycleLength,
			|	CustomerTermsOfSales.CalculatePackageReturnDateAccordingToCalendar     AS CalculatePackageReturnDateAccordingToCalendar,
			|	CustomerTermsOfSales.ScheduleOfPackageReturn                       AS ScheduleOfPackageReturn,
			|	CustomerTermsOfSales.PackageDepositIsRequired                        AS PackageDepositIsRequired,
			|	CustomerTermsOfSales.EnableAssigmentSupplyForOrders               AS EnableAssigmentSupplyForOrders,
			|	CustomerTermsOfSales.SaleWithDeferredTransferOfTitleIsAllowed AS SaleWithDeferredTransferOfTitleIsAllowed,
			|	CustomerTermsOfSales.Calendar                                   AS Calendar,
			|	CustomerTermsOfSales.OrderFrequency                               AS OrderFrequency,
			|	CustomerTermsOfSales.MinimumOrderAmount                      AS MinimumOrderAmount,
			|	CustomerTermsOfSales.LineOfBusiness                     AS LineOfBusiness,
			|	CustomerTermsOfSales.CommissionAgentUsesInventoryAccountingByProductBatchID                  AS CommissionAgentUsesInventoryAccountingByProductBatchID,
			|	CustomerTermsOfSales.ConsignmentSales25                       AS NewCommissionScheme
			|FROM
			|	Catalog.TermsOfSale AS CustomerTermsOfSales
			|WHERE
			|	NOT CustomerTermsOfSales.DeletionMark
			|	AND CustomerTermsOfSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid) 
			|	AND CustomerTermsOfSales.Ref = &SelectedAgreement
			|	AND (NOT &SelectionByOperation
			|		OR CustomerTermsOfSales.BusinessOperation IN(&BusinessTransactions))
			|	AND ((NOT &FilterConsignmentSales25)
			|			OR CustomerTermsOfSales.ConsignmentSales25 = &ConsignmentSales25)
			|	AND (NOT &FilterShipmentWithDeferredTransferOfTitle25
			|		OR CustomerTermsOfSales.SaleWithDeferredTransferOfTitleIsAllowed
			|			AND NOT &UseCustomerContracts
			|				OR CustomerTermsOfSales.ContractsAreUsed)
			|	AND ((NOT &FilterCurrency)
			|			OR CustomerTermsOfSales.Currency = &Currency)
			|	AND (CustomerTermsOfSales.Partner = &Partner OR 
			|	&ReplacementText3)
			|	AND &OnlyUsedBySalesRepresentative
			|";
		
		QueryText = StrReplace(QueryText, "AND &ReplacementText1", ?(Not ValueIsFilled(Partner),
			"AND CustomerTermsOfSales.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef) ", 
			"AND (CustomerTermsOfSales.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
			|		OR CustomerTermsOfSales.PartnersSegment IN
			|			(SELECT
			|				SegmentPartners.Segment
			|			FROM
			|				InformationRegister.SegmentPartners AS SegmentPartners
			|			WHERE
			|				SegmentPartners.Partner = &Partner))
			|"));
			
		QueryText = StrReplace(QueryText, "AND &ReplacementText2", ?(AllSelectionParameters.OnlyStandard Or Not ValueIsFilled(Partner),"","
			|
			|UNION ALL
			|
			|SELECT TOP 2
			|	CustomerTermsOfSales.Ref                                      AS Terms,
			|	CustomerTermsOfSales.Standard_                                     AS Standard_,
			|	CustomerTermsOfSales.Partner                                     AS Partner,
			|	CustomerTermsOfSales.Counterparty                                  AS Counterparty,
			|	CustomerTermsOfSales.ContactPerson                              AS ContactPerson,
			|	CustomerTermsOfSales.Organization                                 AS Organization,
			|	CustomerTermsOfSales.Currency                                      AS Currency,
			|	CASE 
			|		WHEN CustomerTermsOfSales.ContractsAreUsed
			|			THEN CustomerTermsOfSales.Currency
			|		ELSE CustomerTermsOfSales.ARAPCurrency
			|	END                                                           AS ARAPCurrency,
			|	CASE
			|		WHEN &UsePaymentSchedules
			|			THEN CustomerTermsOfSales.PaymentSchedule
			|		ELSE VALUE(Catalog.PaymentSchedules.EmptyRef)
			|	END                                                             AS PaymentSchedule,
			|	CASE
			|		WHEN &UsePaymentSchedules
			|			THEN CustomerTermsOfSales.PaymentSchedule.PaymentMethod
			|		ELSE CustomerTermsOfSales.PaymentMethod
			|	END                                                           AS PaymentMethod,
			|	CustomerTermsOfSales.ForeignCurrencyTransaction                               AS ForeignCurrencyTransaction,
			|	CustomerTermsOfSales.DocumentAmount                              AS DocumentAmount,
			|	CustomerTermsOfSales.Frequent                                  AS Frequent,
			|	CustomerTermsOfSales.Period                                      AS Period,
			|	CustomerTermsOfSales.NumberOfPeriods                          AS NumberOfPeriods,
			|	CustomerTermsOfSales.DeliveryPeriodDays                                AS DeliveryPeriodDays,
			|	CustomerTermsOfSales.PricesKind                                      AS PricesKind,
			|	CustomerTermsOfSales.PriceIncludesVAT                             AS PriceIncludesVAT,
			|	CustomerTermsOfSales.UsedInSalesRepresentativesWork   AS UsedInSalesRepresentativesWork,
			|	CASE
			|		WHEN
			|			NOT CustomerTermsOfSales.Warehouse.IsFolder
			|		THEN
			|			CustomerTermsOfSales.Warehouse
			|		WHEN
			|			CustomerTermsOfSales.Warehouse.IsFolder
			|			AND &ConsiderWarehouseGroups
			|			AND CustomerTermsOfSales.Warehouse.SelectGroup IN (&SelectWarehouseGroup)
			|		THEN
			|			CustomerTermsOfSales.Warehouse
			|		ELSE
			|			VALUE(Catalog.Warehouses.EmptyRef)
			|	END AS Warehouse,
			|	CustomerTermsOfSales.ProductSegment                         AS ProductSegment,
			|	CustomerTermsOfSales.ValidityStartDate                          AS ValidityStartDate,
			|	CustomerTermsOfSales.ValidityEndDate                       AS ValidityEndDate,
			|	CustomerTermsOfSales.BusinessOperation                       AS BusinessOperation,
			|	CustomerTermsOfSales.LimitDiscountAdjustments                    AS LimitDiscountAdjustments,
			|	CustomerTermsOfSales.PercentRateOfManualDiscount                         AS PercentRateOfManualDiscount,
			|	CustomerTermsOfSales.MaximumPercentageForManualMarkup                        AS MaximumPercentageForManualMarkup,
			|	CustomerTermsOfSales.CommissionFeeCalculationMethod                 AS CommissionFeeCalculationMethod,
			|	CustomerTermsOfSales.RemunerationPercentage                       AS RemunerationPercentage,
			|	CustomerTermsOfSales.KeepCommissionFee                      AS KeepCommissionFee,
			|	CustomerTermsOfSales.ContractsAreUsed            AS ContractsAreUsed,
			|	CustomerTermsOfSales.ARAPObjectSettings                             AS ARAPObjectSettings,
			|	CustomerTermsOfSales.FinancialAccountingGroup                      AS FinancialAccountingGroup,
			|	CustomerTermsOfSales.CashFlowItem               AS CashFlowItem,
			|	CustomerTermsOfSales.AvailableToExternalUsers                AS AvailableToExternalUsers,
			|	CustomerTermsOfSales.Status                                      AS AgreementStatus,
			|	CustomerTermsOfSales.ReturnReusablePackage                AS ReturnReusablePackage,
			|	CustomerTermsOfSales.ReusablePackageReturnCycleLength              AS ReusablePackageReturnCycleLength,
			|	CustomerTermsOfSales.CalculatePackageReturnDateAccordingToCalendar     AS CalculatePackageReturnDateAccordingToCalendar,
			|	CustomerTermsOfSales.ScheduleOfPackageReturn                       AS ScheduleOfPackageReturn,
			|	CustomerTermsOfSales.PackageDepositIsRequired                        AS PackageDepositIsRequired,
			|	CustomerTermsOfSales.EnableAssigmentSupplyForOrders               AS EnableAssigmentSupplyForOrders,
			|	CustomerTermsOfSales.SaleWithDeferredTransferOfTitleIsAllowed AS SaleWithDeferredTransferOfTitleIsAllowed,
			|	CustomerTermsOfSales.Calendar                                   AS Calendar,
			|	CustomerTermsOfSales.OrderFrequency                               AS OrderFrequency,
			|	CustomerTermsOfSales.MinimumOrderAmount                      AS MinimumOrderAmount,
			|	CustomerTermsOfSales.LineOfBusiness                     AS LineOfBusiness,
			|	CustomerTermsOfSales.CommissionAgentUsesInventoryAccountingByProductBatchID                  AS CommissionAgentUsesInventoryAccountingByProductBatchID,
			|	CustomerTermsOfSales.ConsignmentSales25                       AS NewCommissionScheme
			|FROM
			|	Catalog.TermsOfSale AS CustomerTermsOfSales
			|WHERE
			|	NOT CustomerTermsOfSales.DeletionMark
			|	AND CustomerTermsOfSales.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
			|	AND NOT CustomerTermsOfSales.Standard_
			|	AND NOT &OnlyStandard
			|	AND (NOT &SelectionByOperation
			|		OR CustomerTermsOfSales.BusinessOperation IN(&BusinessTransactions))
			|	AND CASE
			|		WHEN &FilterConsignmentSales25
			|			AND &FilterShipmentWithDeferredTransferOfTitle25
			|			THEN &ConditionFee25
			|				OR &ConditionShipmentWithoutPPS25
			|				OR CustomerTermsOfSales.BusinessOperation IN
			|				(VALUE(Enum.BusinessTransactions.DeliveryForPrincipal),
			|				VALUE(Enum.BusinessTransactions.TransferToStorageWithRightOfSale))
			|		WHEN &FilterConsignmentSales25
			|			THEN &ConditionFee25
			|		WHEN &FilterShipmentWithDeferredTransferOfTitle25
			|			THEN &ConditionShipmentWithoutPPS25
			|		ELSE TRUE
			|	END
			|	AND ((NOT &FilterCurrency)
			|			OR CustomerTermsOfSales.Currency = &Currency)
			|	AND &OnlyUsedBySalesRepresentative
			|	AND CustomerTermsOfSales.Partner = &Partner
			|ORDER BY
			|	Standard_ ASC
			|"));
		
		QueryText = StrReplace(QueryText, "&ReplacementText3", ?(Not ValueIsFilled(Partner),"CustomerTermsOfSales.Standard_ AND CustomerTermsOfSales.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)", "
			|
			|	CustomerTermsOfSales.Standard_ AND (CustomerTermsOfSales.PartnersSegment = VALUE(Catalog.PartnersSegments.EmptyRef)
			|		OR CustomerTermsOfSales.PartnersSegment IN
			|			(SELECT
			|				SegmentPartners.Segment
			|			FROM
			|				InformationRegister.SegmentPartners AS SegmentPartners
			|			WHERE
			|				SegmentPartners.Partner = &Partner))"));
		
		QueryText = StrReplace(QueryText, "AND &OnlyUsedBySalesRepresentative", ?(AllSelectionParameters.OnlyUsedBySalesRepresentative,"AND CustomerTermsOfSales.UsedInSalesRepresentativesWork ",""));
		
		QueryText = StrReplace(QueryText,
			"&ConditionFee25",
			"(NOT &ConsignmentSales25
			|	OR CustomerTermsOfSales.ConsignmentSales25)");
		
		QueryText = StrReplace(QueryText,
			"&ConditionShipmentWithoutPPS25",
			"(CustomerTermsOfSales.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomer)
			|	AND CustomerTermsOfSales.SaleWithDeferredTransferOfTitleIsAllowed
			|	AND CustomerTermsOfSales.ContractsAreUsed)");
		
		Query = New Query(QueryText);
		
		Query.SetParameter("Partner",                Partner);
		Query.SetParameter("SelectWarehouseGroup",     Catalogs.Warehouses.OptionsForSelectingWarehouseGroup(AllSelectionParameters.ExcludeWarehouseGroupsAvailableInOrders));
		Query.SetParameter("SelectionByOperation",        AllSelectionParameters.BusinessTransactions <> Undefined);
		Query.SetParameter("BusinessTransactions",  AllSelectionParameters.BusinessTransactions);
		Query.SetParameter("ConsiderWarehouseGroups", AllSelectionParameters.ConsiderWarehouseGroups);
		Query.SetParameter("OnlyStandard",          AllSelectionParameters.OnlyStandard);
		Query.SetParameter("OnlyPersonal",   AllSelectionParameters.OnlyPersonal);
		Query.SetParameter("SelectedAgreement",    AllSelectionParameters.SelectedAgreement);
		Query.SetParameter("FilterConsignmentSales25", ValueIsFilled(AllSelectionParameters.ConsignmentSales25));
		Query.SetParameter("ConsignmentSales25",  AllSelectionParameters.ConsignmentSales25);
		If Not ValueIsFilled(AllSelectionParameters.ConsignmentSales25) Then
			Query.SetParameter("ConsignmentSales25", False);
		EndIf;
		Query.SetParameter("FilterCurrency",            AllSelectionParameters.Currency <> Undefined);
		Query.SetParameter("Currency",                 AllSelectionParameters.Currency);
		
		Query.SetParameter("UsePaymentSchedules", GetFunctionalOption("UsePaymentSchedules"));
		Query.SetParameter("UseCustomerContracts", UseCustomerContracts);
		
		Query.SetParameter("FilterShipmentWithDeferredTransferOfTitle25",
									AllSelectionParameters.ShipmentWithDeferredTransferOfTitle25 = True);
		
		QueryResult = Query.ExecuteBatch();
		
		// If no agreement is found, we return it Indefinitely 
		If QueryResult[0].IsEmpty() Then
			Return Undefined;
		EndIf;
		
		Selection = QueryResult[0].Select();
		
		FoundAgreement = Undefined;
		
		// If there is one agreement in the sample, we use it
		If Selection.Count() = 1 Then
			
			Selection.Next();
			FoundAgreement = Selection.Terms;
			
		EndIf;
		
		// If only standard agreements are needed, further checks do not make sense.
		If FoundAgreement = Undefined And Not AllSelectionParameters.OnlyStandard Then
			
			// There are two or more agreements in the sample
			Selection.Next();
			
			FirstAgreement        = Selection.Terms;
			FirstAgreementIsTypical = Selection.Standard_;
			
			Selection.Next();
			
			SecondAgreementIsTypical = Selection.Standard_;
			
			Selection.Reset();
			Selection.Next();
			
			// If there are two agreements of different types in the sample, we use an individual one
			If FirstAgreementIsTypical <> SecondAgreementIsTypical Then
				FoundAgreement = FirstAgreement;
			EndIf;
		EndIf;
		
		If FoundAgreement = Undefined Then
			If Not QueryResult[1].IsEmpty() Then
				Selection = QueryResult[1].Select();
				Selection.Next();
				FoundAgreement = Selection.Terms;
			EndIf;
		EndIf;
		
		If FoundAgreement <> Undefined Then
			FillPropertyValues(AttributesStructure1, Selection);
		Else
			FillPropertyValues(AttributesStructure1, Catalogs.TermsOfSale.EmptyRef())
		EndIf;
		If Not UseCustomerContracts Then
			AttributesStructure1.Insert("ContractsAreUsed", UseCustomerContracts);
		EndIf;
		
	Else //conventions are not used
		
		FillPropertyValues(AttributesStructure1, Catalogs.TermsOfSale.EmptyRef());
		SelectingTypeOfPrices          = New Structure("UseWhileSellingToCustomers", True);
		
		AllSelectionParameters = New Structure;
		AllSelectionParameters.Insert("EmptyDocumentLink", Undefined);
		If FilterParameters <> Undefined Then
			FillPropertyValues(AllSelectionParameters, FilterParameters);
		EndIf;
		
		DocumentLinkForStatistics = ?(InDocumentYouMustFillInPriceIncludesVATAttribute(AllSelectionParameters.EmptyDocumentLink) = True,
		                                 AllSelectionParameters.EmptyDocumentLink, Undefined);
		
		DetailsOfDefaultPrice = Catalogs.TypesOfPrices.PriceTypeAndPriceIncludesVATAttributeByDefault(
			SelectingTypeOfPrices, DocumentLinkForStatistics);
		FillPropertyValues(AttributesStructure1, DetailsOfDefaultPrice);
		
		AttributesStructure1.Insert("ARAPObjectSettings",                               Enums.ARAPObjectSettings.ByOrders);
		AttributesStructure1.Insert("ContractsAreUsed",              UseCustomerContracts);
		AttributesStructure1.Insert("SaleWithDeferredTransferOfTitleIsAllowed",
			GetFunctionalOption("UseShipmentWithDeferredTransferOfTitle2_0"));
		AttributesStructure1.Insert("NewCommissionScheme", 
				GetFunctionalOption("UseSalesCommission"));
		
	EndIf;
	
	Return AttributesStructure1;

EndFunction

// Returns the date of the last stage on the schedule.
//
// Parameters:
//   DocumentDate       - Date - the date from which you want to get the latest date on the schedule.
//   PaymentSchedule        - CatalogRef.PaymentSchedules - link to the payment schedule.
//   CustomerTermsOfSales - CatalogRef.TermsOfSale - link to the agreement with the client.
//
// Returns:
//   Number - The last date on the schedule, taking into account the calendar.
//
Function GetLatestDateOnSchedule(Val DocumentDate, Val PaymentSchedule,  Val CustomerTermsOfSales) Export
	
	If Not ValueIsFilled(DocumentDate) Then
		DocumentDate = CurrentSessionDate();
	EndIf;
	
	If ValueIsFilled(PaymentSchedule) Then
		Query = New Query("
			|SELECT
			|	MAX(PaymentScheduleSteps.Move)  AS Move,
			|	PaymentScheduleSteps.Ref.Calendar AS Calendar,
			|	BEGINOFPERIOD(DATEADD(&DocumentDate,DAY,ISNULL(MAX(PaymentScheduleSteps.Move),0)),DAY) AS PaymentDate
			|	
			|FROM
			|	Catalog.PaymentSchedules.Stages AS PaymentScheduleSteps
			|WHERE
			|	PaymentScheduleSteps.Ref = &PaymentSchedule
			|	AND (PaymentScheduleSteps.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.CreditPlanned)
			|		OR PaymentScheduleSteps.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.CreditAfterShipment))
			|
			|GROUP BY
			|	PaymentScheduleSteps.Ref
			|");
			
		Query.SetParameter("PaymentSchedule",  PaymentSchedule);
		
	ElsIf ValueIsFilled(CustomerTermsOfSales) Then
		Query = New Query(
			"SELECT
			|	MAX(PaymentScheduleSteps.Move) AS Move,
			|	PaymentScheduleSteps.Ref.Calendar AS Calendar,
			|	BEGINOFPERIOD(DATEADD(&DocumentDate, DAY, ISNULL(MAX(PaymentScheduleSteps.Move), 0)), DAY) AS PaymentDate
			|FROM
			|	Catalog.TermsOfSale.PaymentScheduleSteps AS PaymentScheduleSteps
			|WHERE
			|	PaymentScheduleSteps.Ref = &CustomerTermsOfSales
			|	AND (PaymentScheduleSteps.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.CreditPlanned)
			|		OR PaymentScheduleSteps.PaymentOption = VALUE(Enum.CustomerPaymentControlOptions.CreditAfterShipment))
			|
			|GROUP BY
			|	PaymentScheduleSteps.Ref
			|");
			
		Query.SetParameter("CustomerTermsOfSales", CustomerTermsOfSales);
	Else
		Return Undefined;
	EndIf;
	
	Query.SetParameter("DocumentDate", DocumentDate);

	QueryResult = Query.Execute();
	If QueryResult.IsEmpty() Then
		Return Undefined;
	EndIf;
	
	Selection = QueryResult.Select();
	Selection.Next();
	Calendar = Selection.Calendar;
	
	If ValueIsFilled(Calendar) Then
		PaymentDate = CalendarSchedules.DateByCalendar(Calendar, DocumentDate, Selection.Move);
	Else
		PaymentDate = Selection.PaymentDate;
	EndIf;
	
	Return PaymentDate;
	
EndFunction

