// Returns the base document based on the specified search fields. It is used when the reference to the base is placed
// in different Attributes (including the Attributes of the table part).
// 
// Parameters:
//     Object - DocumentObject, FormDataStructure - The properties specified in the search fields must be present.
//         Document Description - Documentlink property is required if the Search field parameter is not passed.
//     SearchFields - String - The properties of the object are separated by commas in order of priority
//         . If a Boolean field is specified, the value of which is False, the function will return Undefined,
//         for example, "ActPoZakazam" for the Act of work performed. At least one field must be of reference type.
//         You can specify a table field, for example, "Products.Client's order".
// 
// Returns:
//     DocumentRef, Undefined - document Foundation.
//
Function DocumentBasis(Object, SearchFields = "") Export
	
	DocumentBasis = Undefined;
	
	SearchFieldsCollection = StringFunctionsClientServer.SplitStringIntoSubstringsArray(SearchFields, ",",, True);
	
	For Each Name In SearchFieldsCollection Do
		
		TabularSectionAttribute = StrFind(Name, ".") > 0;
		
		// If the name contains a dot "Products.Customer's order", we are looking for the basis document in the "Products" table.
		// If the document is based on several orders, then we return it Indefinitely
		If TabularSectionAttribute Then
			
			TableNameAttributeName = StringFunctionsClientServer.SplitStringIntoSubstringsArray(Name, ".");
			TableName = TableNameAttributeName[0];
			AttributeName = TableNameAttributeName[1];
			
			Basis1 = New Map();
			
			For Each String In Object[TableName] Do
				If ValueIsFilled(String[AttributeName]) Then
					Basis1.Insert(String[AttributeName]);
				EndIf;
			EndDo;
			
			If Basis1.Count() = 1 Then
				For Each Item In Basis1 Do
					DocumentBasis = Item.Key;
				EndDo;
			Else
				DocumentBasis = Undefined;
			EndIf;
			
		// If the Attribute with the Boolean type is False, it follows that the document has no basis
		ElsIf TypeOf(Object[Name]) = Type("Boolean") And Not Object[Name] Then
			DocumentBasis = Undefined;
			Break;
			
		// If there is a Attribute with the Boolean type and it is True, we continue the crawl
		ElsIf TypeOf(Object[Name]) = Type("Boolean") And Object[Name] Then
			Continue;
		
		// In general, we fill out the document base from the specified Attributes
		ElsIf ValueIsFilled(Object[Name]) Then
			DocumentBasis = Object[Name];
			Break;
		EndIf;
		
	EndDo;
	
	Return DocumentBasis;
	
EndFunction

#Region ServiceProceduresAndFillingFunctionsForShipment

// Returns a standard structure for filling in the document for the actual shipment.
//
// Returns:
//   Structure - contains the data of the document to be filled in for the actual shipment:
// 		* AdvancedWarehousingOnShipment - Boolean -
// 		* OrderNameWH - String -
// 		* StructureOfActionsWithAddedStrings - Structure -
// 		* StructureOfActionsWithModifiedStrings - Structure -
// 		* SeriesSpecificationParameters - Structure -
// 		* FillWithUnassembledGoods - Boolean -
// 		* ThereAreUnassembledGoods - Boolean -
// 		* ThereAreShippedGoods - Boolean -
// 		* SalesInExcessOfOrder - Boolean -
// 		* PaddingLines - Boolean -
// 		* OrderIsOrder - Boolean -
// 		* WarehouseInTablePart - Boolean -
// 		* Warehouse - CatalogRef.Warehouses -
// 		* Goods - TabularSection -
// 		* Date - Date -
// 		* ArrayOfShipmentOrders - Undefined -
// 		* Ref - Undefined -
// 
Function StructureOfDocumentToFillInForActualShipment() Export
	
	DocumentStructure = New Structure; 
	DocumentStructure.Insert("Ref", Undefined); 
	DocumentStructure.Insert("ArrayOfShipmentOrders", Undefined); 
	DocumentStructure.Insert("Date", Undefined); 
	DocumentStructure.Insert("Goods", Undefined); 
	DocumentStructure.Insert("Warehouse", Undefined); 
	DocumentStructure.Insert("WarehouseInTablePart", False); 
	DocumentStructure.Insert("OrderIsOrder", False); 
	DocumentStructure.Insert("PaddingLines", False); 
	DocumentStructure.Insert("SalesInExcessOfOrder", False); 
	DocumentStructure.Insert("ThereAreShippedGoods", False); 
	DocumentStructure.Insert("ThereAreUnassembledGoods", False); 
	DocumentStructure.Insert("FillWithUnassembledGoods", False); 
	DocumentStructure.Insert("SeriesSpecificationParameters", New Structure); 
	DocumentStructure.Insert("StructureOfActionsWithModifiedStrings", New Structure); 
	DocumentStructure.Insert("StructureOfActionsWithAddedStrings", New Structure); 
	DocumentStructure.Insert("OrderNameWH", "SalesOrder"); 
	DocumentStructure.Insert("AdvancedWarehousingOnShipment", False); 

	Return DocumentStructure;
	
EndFunction

// Fills in the table parts of the document for the actual shipment.
//
// Parameters:
// 		DocumentObject_ - FormDataStructure - Document object to fill in
// 		StructureOfShipmentDocument - See StructureOfDocumentToFillInForActualShipment
//
// Returns:
// 		Boolean - True if the table parts are overfilled.
//
Function FillInByActualShipment(DocumentObject_, StructureOfShipmentDocument) Export
	
	Var QueryResultStructure;
	
	// If there are no shipped or unassembled goods, then you do not need to fill out the document.
	If Not (StructureOfShipmentDocument.ThereAreShippedGoods
		Or (StructureOfShipmentDocument.FillWithUnassembledGoods And StructureOfShipmentDocument.ThereAreUnassembledGoods)) Then
		Return False;
	EndIf;
	
	StructureOfDocumentToFillIn = StructureOfDocumentToFillInForActualShipment();
	TMCommonUseClientServer.SupplementStructure(StructureOfDocumentToFillIn, StructureOfShipmentDocument, True);
	
	// Get data about shipped and reserved goods.
	
	SetPrivilegedMode(True);
	
	ProductColumns_ = "LineNumber, Products, Characteristic, Package, Series, Purpose" + 
		?(StructureOfDocumentToFillIn.WarehouseInTablePart, ", Warehouse", "");
	
	TableTSGoods = StructureOfDocumentToFillIn.Goods.Unload(, ProductColumns_);
	
	If Not StructureOfDocumentToFillIn.WarehouseInTablePart Then
		TableTSGoods.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
		TableTSGoods.FillValues(StructureOfDocumentToFillIn.Warehouse, "Warehouse");
	EndIf;

	DateOfCalculation = ?(ValueIsFilled(StructureOfDocumentToFillIn.Date), StructureOfDocumentToFillIn.Date, CurrentSessionDate());
	
	StructureOfDocumentToFillIn.AdvancedWarehousingOnShipment = WarehousesServer.ThereIsOrderWarehouseForShipment(, DateOfCalculation, StructureOfDocumentToFillIn.Warehouse);
	
	Query = New Query(RequestTextForActualShipment(StructureOfDocumentToFillIn, QueryResultStructure));
	
	If StructureOfDocumentToFillIn.ArrayOfShipmentOrders <> Undefined Then
		Query.SetParameter("ShippingDocuments", StructureOfDocumentToFillIn.ArrayOfShipmentOrders);
	Else
		Query.SetParameter("ShippingDocuments", StructureOfDocumentToFillIn.Ref);
	EndIf;
	
	Query.SetParameter("Date",                          DateOfCalculation);
	Query.SetParameter("Warehouse",                         StructureOfDocumentToFillIn.Warehouse);
	Query.SetParameter("FillWithUnassembledGoods", StructureOfDocumentToFillIn.FillWithUnassembledGoods);
	Query.SetParameter("Goods",                        TableTSGoods);
	Query.SetParameter("Invoice",                     StructureOfDocumentToFillIn.Ref);
	
	SpeedLimits = TMCommonUse.BoundariesOfRegisterTurns("GoodsForIssue",
																"DocumentShipments IN (&ShippingDocuments)",
																Query.Parameters);
	
	Query.SetParameter("InitialGoodsForShipment",   SpeedLimits.MinDate);
	Query.SetParameter("ConPeriodGoodsReadyForShipment",  SpeedLimits.MaxDate);
	
	SpeedLimits = TMCommonUse.BoundariesOfRegisterTurns("ShipmentAndReturnReferences",
																"ReferenceOrder IN (&ShippingDocuments)",
																Query.Parameters);
	
	Query.SetParameter("InitialCustomerOrders",   SpeedLimits.MinDate);
	Query.SetParameter("ConPeriodCustomerOrders",  SpeedLimits.MaxDate);
	
	SpeedLimits = TMCommonUse.BoundariesOfRegisterTurns("ShipmentAndReturnReferences",
																"ReferenceOrder IN (&ShippingDocuments)AND RowCode<>0",
																Query.Parameters);
	
	Query.SetParameter("InitialOSTAndOBCustomerOrders",   SpeedLimits.MinDate);
	Query.SetParameter("ConPeriodCustomerOrdersOSTAndOB",   SpeedLimits.MaxDate);
	
	QueryResult = Query.ExecuteBatch();
	If QueryResult[QueryResultStructure.GoodsForIssue].IsEmpty() Then
		SetPrivilegedMode(False);
		Return False;
	EndIf;
	
	ShippedGoods_ = New ValueTable;
	ShippedGoods_.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	ShippedGoods_.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	ShippedGoods_.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	ShippedGoods_.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	ShippedGoods_.Columns.Add("Count", TMCommonUse.DescriptionOfQuantitativeFieldType());
	If StructureOfDocumentToFillIn.OrderIsOrder Then
		ArrayOfOrderTypes = New Array;
		ArrayOfOrderTypes.Add(Type("DocumentRef.SalesOrder"));
		ArrayOfOrderTypes.Add(Type("DocumentRef.RequestForReturnOfGoodsFromCustomer"));
		ArrayOfOrderTypes.Add(Type("DocumentRef.SubcontractOrder2_5"));
		ArrayOfOrderTypes.Add(Type("DocumentRef.MaterialProviderOrder2_5"));
		ShippedGoods_.Columns.Add(StructureOfDocumentToFillIn.OrderNameWH, New TypeDescription(ArrayOfOrderTypes));
		ShippedGoods_.Columns.Add("RowCode", New TypeDescription("Number", New NumberQualifiers(10, 0)));
	EndIf;
	
	GoodsForIssue = QueryResult[QueryResultStructure.GoodsForIssue].Select();
	
	While GoodsForIssue.Next() Do
		TBLString = ShippedGoods_.Add();
		FillPropertyValues(TBLString, GoodsForIssue);
		
		TBLString.Count = GoodsForIssue.QuantityToShip_;
		If StructureOfDocumentToFillIn.OrderIsOrder Then
			TBLString[StructureOfDocumentToFillIn.OrderNameWH] = GoodsForIssue.DocumentShipments;
		EndIf;
	EndDo;
	
	SearchFields = "Products, Characteristic, Series" + 
		?(StructureOfDocumentToFillIn.WarehouseInTablePart, ", Warehouse", "") + 
		?(StructureOfDocumentToFillIn.OrderIsOrder, ", RowCode," + StructureOfDocumentToFillIn.OrderNameWH, "");
	SearchStructureForProductsForRegistration = New Structure(SearchFields);
	
	ShippedLinesForLineCodes = New ValueTable;
	ShippedLinesForLineCodes.Columns.Add("TableRow");
	ShippedLinesForLineCodes.Columns.Add("RowCode");
	
	ThisIsTransferOfGoods = TypeOf(StructureOfDocumentToFillIn.Ref) = Type("DocumentRef.TransferOfGoodsToBailee");
	ThisIsImplementation = TypeOf(StructureOfDocumentToFillIn.Ref) = Type("DocumentRef.CustomerInvoice");
	ThisIsShipment = TypeOf(StructureOfDocumentToFillIn.Ref) = Type("DocumentRef.GoodsShipmentToCustomer");
	GoodsForRegistration = QueryResult[QueryResultStructure.GoodsForRegistration].Unload();
	For Each TBLString In GoodsForRegistration Do
		FillPropertyValues(SearchStructureForProductsForRegistration, TBLString);
		SearchStructureForProductsForRegistration.RowCode = 0;
		
		RowsArray = ShippedGoods_.FindRows(SearchStructureForProductsForRegistration);
		If RowsArray.Count() > 0 Then
			ShippedLine_ = RowsArray.Get(0);
			
			Difference = 0;
			If ShippedLine_.Count >= TBLString.Count Then
				Difference = ShippedLine_.Count - TBLString.Count;
			EndIf;
			
			If Difference > 0 Then
				NewString = ShippedGoods_.Add();
				FillPropertyValues(NewString, ShippedLine_);
				NewString.Count = Difference;
				If StructureOfDocumentToFillIn.OrderIsOrder
					And (ThisIsTransferOfGoods Or ThisIsImplementation Or ThisIsShipment) Then
					
					// If more has been shipped than completed, then a new row (tables of shipped goods) with a difference
					// is saved in the table of values of shipped orders for line codes. This is necessary in order not to
					// immediately fill in the line code in a new line. In the order and the invoice, the same product could
					// be in different lines (with different line codes), for example, if the shipment dates are different.
					// And if a new line (with a difference) has a line code filled in here, then it (a line with a difference)
					// will not be found later, when the cycle reaches a line with the same decorated product (StrokaTbl),
					// but with a different line code.
					// If there is only one line with such a product, and more were shipped, then the line code below will be filled in.
					NewLineForLineCodes = ShippedLinesForLineCodes.Add();
					NewLineForLineCodes.TableRow = NewString;
					NewLineForLineCodes.RowCode = TBLString.RowCode;
					
				EndIf;
				ShippedLine_.Count = TBLString.Count;
			EndIf;
			
			ShippedLine_.RowCode = TBLString.RowCode;
			
		EndIf;
		
	EndDo;
	
	For Each StringForLineCodes In ShippedLinesForLineCodes Do
		If StringForLineCodes.TableRow.RowCode = 0 Then
			StringForLineCodes.TableRow.RowCode = StringForLineCodes.RowCode;
		EndIf;
	EndDo;
	
	// Remember the product data before the change.
	TSGoods = StructureOfDocumentToFillIn.Goods;
	
	FillingStructure = New Structure;
	FillingStructure.Insert("Count", 0);
	FillingStructure.Insert("NumberOfPackages", 0);
	FillingStructure.Insert("Sum", 0);
	FillingStructure.Insert("VATAmount", 0);
	FillingStructure.Insert("AmountIncludingVAT", 0);
	FillingStructure.Insert("AmountARAP", 0);
	
	MatchingNumberInRowsBeforeChange = New Map;
	ComplianceOfPackingCoefficients         = New Map;
	
	Goods = QueryResult[QueryResultStructure.Goods].Select();
	While Goods.Next() Do
		
		StringTSGoods = TSGoods[Goods.LineNumber - 1];
		
		ComplianceOfPackingCoefficients.Insert(StringTSGoods.Package, Goods.PackagingFactor);
		MatchingNumberInRowsBeforeChange.Insert(StringTSGoods, StringTSGoods.Count);
		
		FillPropertyValues(StringTSGoods, FillingStructure);
		
	EndDo;
	
	ComplianceOfPackingCoefficients.Insert(Catalogs.PackagesAndUnitsOfMeasure.EmptyRef(), 1);
	
	// Transfer data on the goods actually shipped to the PM "Goods".
	
	SearchStructureForTSProducts = New Structure(SearchFields);
	
	AddedRows = New Map;
	ModifiedRows  = New Map;
	GoodsFromOrders     = QueryResult[QueryResultStructure.GoodsFromOrders].Unload();
	OrderOrder = StructureOfDocumentToFillIn.OrderIsOrder;
	
	If OrderOrder And StructureOfDocumentToFillIn.OrderNameWH = "SalesOrder" Then
		AdditionalOrderTables = AdditionalOrderTables(StructureOfDocumentToFillIn.ArrayOfShipmentOrders, DocumentObject_.Currency);
	EndIf;
	
	// If you have shipped more than indicated in the line for the product in the invoice, this amount will go in a new line,
	//	if it is permissible to supplement the lines.
	// If the invoice is on the Order and it is permissible to supplement the lines, then all the added lines will be in excess of the order.
	For Each TBLString In ShippedGoods_ Do
		
		LastProcessedLine = Undefined;
		
		QuantityToShip_ = TBLString.Count;
		
		FillPropertyValues(SearchStructureForTSProducts, TBLString);
		ArrayOfTSRows = TSGoods.FindRows(SearchStructureForTSProducts);
		
		For Each StringTSGoods In ArrayOfTSRows Do
			
			LastProcessedLine = ?(AddedRows.Get(StringTSGoods) <> Undefined, LastProcessedLine, StringTSGoods);
			
			QuantityBeforeChange_ = ?(MatchingNumberInRowsBeforeChange[StringTSGoods] = Undefined, 0, MatchingNumberInRowsBeforeChange[StringTSGoods]);
			Count = QuantityBeforeChange_ - StringTSGoods.Count;
			
			If Count < 0 Then
				Break
			EndIf;
			
			QuantityToShip_ = QuantityToShip_ - Count;
			
			If QuantityToShip_ < 0 Then
				Count = Count + QuantityToShip_;
				QuantityToShip_ = 0;
			EndIf;
			
			StringTSGoods.Count = StringTSGoods.Count + Count;
			
			ModifiedRows.Insert(StringTSGoods);
			
		EndDo;
		
		If QuantityToShip_ > 0 Then
			
			If LastProcessedLine <> Undefined Then
				
				LastProcessedLine.Count = LastProcessedLine.Count + QuantityToShip_;
				QuantityToShip_ = 0;
				ModifiedRows.Insert(LastProcessedLine);
				
				HasChanges = True;
				
			ElsIf StructureOfDocumentToFillIn.PaddingLines Then
				
				If OrderOrder And StructureOfDocumentToFillIn.OrderNameWH = "SalesOrder" Then
					NewRow = FillInLineByClientSOrder(SearchStructureForTSProducts, 
						QuantityToShip_,
						DocumentObject_, 
						GoodsFromOrders,
						AdditionalOrderTables);
				Else
					NewRow = TSGoods.Add();
					FillPropertyValues(NewRow, SearchStructureForTSProducts);
					NewRow.Count = QuantityToShip_;
					NewRow.NumberOfPackages = QuantityToShip_;
				EndIf;
				
				AddedRows.Insert(NewRow);
				
				QuantityToShip_ = 0;
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
	// Perform an additional. processing of modified or added rows.
	
	// ... delete the PM lines "Products" whose quantity is 0.
	ArrayOfTSRows = TSGoods.FindRows(New Structure("Count", 0));
	For Each TBLString In ArrayOfTSRows Do
		TSGoods.Delete(TBLString);
	EndDo;
	
	// ... recalculate the number of packages in the PM "Goods" lines.
	CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
	RowsToProcess = New Array();
	
	For Each String In ModifiedRows Do
		StringTSGoods = String.Key;
		StringTSGoods.NumberOfPackages = StringTSGoods.Count / ComplianceOfPackingCoefficients[StringTSGoods.Package];
		RowsToProcess.Add(StringTSGoods);
	EndDo;
	
	BatchProcessingOfTablePartServer.ProcessTSStrings(
		RowsToProcess,
		StructureOfDocumentToFillIn.StructureOfActionsWithModifiedStrings,
		StructureOfDocumentToFillIn.Goods,
		CachedValues);
	
	// ... check the characteristics of the item by owner in the PM "Goods" lines.
	CachedValues = BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues();
	RowsToProcess = New Array();
	
	For Each String In AddedRows Do
		StringTSGoods = String.Key;
		StructureOfDocumentToFillIn.StructureOfActionsWithAddedStrings.Insert("CheckCharacteristicsByOwner", StringTSGoods.Characteristic);
		RowsToProcess.Add(StringTSGoods);
	EndDo;
	
	BatchProcessingOfTablePartServer.ProcessTSStrings(
		RowsToProcess,
		StructureOfDocumentToFillIn.StructureOfActionsWithAddedStrings,
		StructureOfDocumentToFillIn.Goods,
		CachedValues);
	
	// ... to re-fill barcodes of packages
	If QueryResultStructure.Property("PackageBarcodes")
		And CommonClientServer.HasAttributeOrObjectProperty(DocumentObject_,"PackageBarcodes") Then
	
		PackageBarcodes = QueryResult[QueryResultStructure.PackageBarcodes].Unload();
		If PackageBarcodes.Count() > 0 Then

			DocumentObject_.PackageBarcodes.Load(PackageBarcodes);

		EndIf; 
		
	EndIf;
	
	// ... fill in the series indication statuses in the document.
	ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject_, StructureOfDocumentToFillIn.SeriesSpecificationParameters);
	
	SetPrivilegedMode(False);
	
	HasChanges = (ModifiedRows.Count() > 0) Or (AddedRows.Count() > 0) Or (TSGoods.Count() = 0);
	
	Return HasChanges;
	
EndFunction

#EndRegion

#Region ProceduresForCheckingCorrectnessOfFillingInDocuments

// The parameter structure is returned, which is used to form an array of checks See CheckCorrectnessOfSalesDocument.
//
// Parameters:
//  DocumentSales  - See CheckCorrectnessOfSalesDocument.DocumentSales
//  TableName - String -
//  TSName - String
//  PresentationOfTS - String
//
// Returns:
//  Structure of KeyAndValue -
//
Function ParametersForCheckingCorrectnessOfFillingOutSalesDocument(DocumentSales, TableName, TSName, PresentationOfTS) Export
	
	ParametersForCheckingCorrectnessOfFilling = New Structure;
	ParametersForCheckingCorrectnessOfFilling.Insert("DocumentSales", DocumentSales);
	ParametersForCheckingCorrectnessOfFilling.Insert("DocumentType", TypeOf(DocumentSales.Ref));
	ParametersForCheckingCorrectnessOfFilling.Insert("TableName", TableName);
	ParametersForCheckingCorrectnessOfFilling.Insert("TSName", TSName);
	ParametersForCheckingCorrectnessOfFilling.Insert("PresentationOfTS", PresentationOfTS);
	ParametersForCheckingCorrectnessOfFilling.Insert("PresentationOfWarehouseField", Undefined);
	ParametersForCheckingCorrectnessOfFilling.Insert("ConsiderDiscountsMarkups", False);	
	ParametersForCheckingCorrectnessOfFilling.Insert("CheckDiscountsCalculated", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseManualDiscounts", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseAutomaticDiscounts", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseAdvancedFeaturesOfSalesOrder", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("ToUseTermsOfSales", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePartnersProducts", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePriceChecks", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseUserRestrictions", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseRestrictionsOnAgreements", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePriceGroups", False);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePriceManagementSystem25", False);
	
	Return ParametersForCheckingCorrectnessOfFilling;
EndFunction

// Checks the correctness of filling in the sales document in accordance with the array of checks
// by executing a batch of requests. Is called from the procedure of the document "Obrabatyvaniya".
//
// Parameters:
//  DocumentSales  - DocumentObject, DataProcessorObject.SalesWizard, CatalogObject.TermsOfSale - 
// 										The object for which you want to audit.
//  Cancel - Boolean - flag for refusing to carry out the document.
//
Procedure CheckCorrectnessOfSalesDocument(Val DocumentSales, Cancel) Export
	
	// If the document has already been filled in incorrectly, we will not fulfill requests
	If Cancel Then
		Return;
	EndIf;
	
	If TMCommonUseClientServer.AnExternalUserIsAuthorized() Then
		Return;
	EndIf;
	
	DocumentAttributes = New Structure("Date, DateOfShipment, NotShipInInstallments, Organization, ThisIsOrderAsInvoice");
	FillPropertyValues(DocumentAttributes, DocumentSales);
		
	// Let's check the availability of roles
	VarianceFromSalesTermsAndConditions = UserRightsCached.VarianceFromSalesTermsAndConditions();
	SalesInExcessOfOrder     = UserRightsCached.SalesInExcessOfOrder();
	
	SetPrivilegedMode(True);
	
	// Let's check whether it is necessary to check the range of acceptable prices
	KindOfMaximumAllowableSellingPrices = Constants.KindOfMaximumAllowableSellingPrices.Get();
	KindOfMinimumAllowableSellingPrices  = Constants.KindOfMinimumAllowableSellingPrices.Get();
	CheckPriceRange               = ValueIsFilled(KindOfMaximumAllowableSellingPrices) Or ValueIsFilled(KindOfMinimumAllowableSellingPrices);
	
	// Fill in the array of necessary checks depending on the type of document
	ChecksArray    = New Array();
	DocumentType      = TypeOf(DocumentSales);
	TableName        = Common.TableNameByRef(DocumentSales.Ref);
	
	// Date Of Receipt Of VAT Rates
	DateOfReceiptOfVATRates = DocumentAttributes.Date;
	If ValueIsFilled(DocumentAttributes.DateOfShipment)
		And DocumentAttributes.NotShipInInstallments <> Undefined
		And DocumentAttributes.NotShipInInstallments
		And (DocumentType = Type("DataProcessorObject.SalesWizard")
			Or DocumentType = Type("DocumentObject.SalesOrder")
			Or DocumentType = Type("DocumentObject.RequestForReturnOfGoodsFromCustomer")) Then
			
		DateOfReceiptOfVATRates = DocumentAttributes.DateOfShipment;
		
	EndIf;
	
	If DocumentType = Type("DataProcessorObject.SalesWizard") Then
		
		VariantOfRegistrationOfDocumentsOfSalesAssistant = DocumentSales.DocumentCreationOption;
		PossibleOptions = Enums.OptionsOfRegisteringSalesDocuments;
		
		If VariantOfRegistrationOfDocumentsOfSalesAssistant = PossibleOptions.SalesOrder
			Or VariantOfRegistrationOfDocumentsOfSalesAssistant = PossibleOptions.OrderTransfer
			Or VariantOfRegistrationOfDocumentsOfSalesAssistant = PossibleOptions.SalesOrderCustomerInvoice Then
			TableName = Common.TableNameByRef(Documents.SalesOrder.EmptyRef());
		ElsIf VariantOfRegistrationOfDocumentsOfSalesAssistant = PossibleOptions.TransferOfGoodsToBailee Then
			TableName = Common.TableNameByRef(Documents.TransferOfGoodsToBailee.EmptyRef());
		ElsIf VariantOfRegistrationOfDocumentsOfSalesAssistant = PossibleOptions.CustomerInvoice Then
			TableName = Common.TableNameByRef(Documents.CustomerInvoice.EmptyRef());
		EndIf; 
		
	EndIf; 
	TSName             = GetNameOfTablePart(TableName);
	PresentationOfTS   = GetPresentationOfTablePart(TableName);
	If TableName = "Document.ReportToMaterialProvider2_5"
		And (DocumentSales.BusinessOperation = Enums.BusinessTransactions.ReportToMaterialProvider2_5
			Or DocumentSales.BusinessOperation = Enums.BusinessTransactions.Subcontracting2_5
			Or DocumentSales.BusinessOperation = Enums.BusinessTransactions.RepairProductsFromProvidedMaterials2_5) Then
		PresentationOfTS = NStr("ru = 'Выпускаемая продукция';
								|vi = 'Released products';
								|en = 'Released products'; fa = 'محصولات تولیدشده';
								|it = 'Prodotti in fabbricazione';
								|pl = 'Wypuszczana produkcja';
								|tr = 'İmal edilen ürünler'");
	ElsIf TableName = "Document.ReportToMaterialProvider2_5"
		And (DocumentSales.BusinessOperation = Enums.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5
			Or DocumentSales.BusinessOperation = Enums.BusinessTransactions.PerformRMUsingProvidedMaterials2_5) Then
		PresentationOfTS = NStr("ru = 'Выполняемые работы';
								|vi = 'Works to perform';
								|en = 'Works to perform'; fa = 'کارهای قابل انجام';
								|it = 'Works to perform';
								|pl = 'Works to perform';
								|tr = 'Yapılan işler'");
	EndIf;
	ApprovedIn1CDocumentManagement = False;
	
	// IntegrationWith1CDocumentManagementSubsystem
	// Let's check the possibility and status of approval through 1C:Document flow
	ApprovalVia1CDocumentFlow =
		(Constants.UseIntegrationWith1CDocumentManagement.Get()
			Or Constants.UseIntegrationWith1CDocumentManagement3.Get())
		And Constants.UseApprovalThrough1CDocumentManagement.Get();
	If ApprovalVia1CDocumentFlow And
			(DocumentType = Type("DocumentObject.SalesOrder") Or
				DocumentType = Type("DocumentObject.CommercialProposalForCustomer") Or
				DocumentType = Type("DocumentObject.RequestForReturnOfGoodsFromCustomer") Or
				DocumentType = Type("CatalogObject.TermsOfSale")) Then
		ApprovedIn1CDocumentManagement = IntegrationWith1CDocumentManagementCore.ApprovedIn1CDocumentManagement(
			DocumentSales.Ref);
	EndIf;
	// End IntegrationWith1CDocumentManagementSubsystem
	
	AllLinesAreCanceled = False;
	TransferOperations_ = GoodsTransferOperations();
	OperationsForReturningTransferredGoods = OperationsForReturningTransferredGoods();
	
	If DocumentType = Type("DocumentObject.SalesOrder") Then
		
		AllLinesAreCanceled = TMCommonUse.AllLinesAreCanceled(DocumentSales, "Goods", "Canceled");
		
		NeedToAgree_                            = Not (AllLinesAreCanceled Or VarianceFromSalesTermsAndConditions Or DocumentSales.Approved Or ApprovedIn1CDocumentManagement);
		If DocumentSales.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent Then
			YouNeedToAgreeOnManualDiscountsForUsers = False;
			UseDiscounts                          = False;
		Else
			YouNeedToAgreeOnManualDiscountsForUsers = Not (AllLinesAreCanceled Or VarianceFromSalesTermsAndConditions Or DocumentSales.Approved Or ApprovedIn1CDocumentManagement);
			UseDiscounts                          = True;
		EndIf;
		
	ElsIf DocumentType = Type("DocumentObject.MaterialProviderOrder2_5") Then
		
		AllLinesAreCanceled = TMCommonUse.AllLinesAreCanceled(DocumentSales, "ManufacturedProduct", "Canceled");
		AllLinesAreCanceled =
			AllLinesAreCanceled And TMCommonUse.AllLinesAreCanceled(DocumentSales, "UsedMaterials", "Canceled");
		
		NeedToAgree_                            = Not (AllLinesAreCanceled Or VarianceFromSalesTermsAndConditions);
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.ReportToMaterialProvider2_5") Then
		
		NeedToAgree_                            = False;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.SubcontractOrder2_5") Then
		
		AllLinesAreCanceled = TMCommonUse.AllLinesAreCanceled(DocumentSales, "ManufacturedProducts", "Canceled");
		AllLinesAreCanceled =
			AllLinesAreCanceled
			And TMCommonUse.AllLinesAreCanceled(
				DocumentSales,
				"SideAndIntermediateRelease",
				"Canceled");
		AllLinesAreCanceled =
			AllLinesAreCanceled
			And TMCommonUse.AllLinesAreCanceled(
				DocumentSales,
				"SupplyWithMaterialsAndWorks",
				"Canceled");
		AllLinesAreCanceled =
			AllLinesAreCanceled
			And TMCommonUse.AllLinesAreCanceled(
				DocumentSales,
				"Services",
				"Canceled");
		
		NeedToAgree_                            = False;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
		
	
	ElsIf DocumentType = Type("DocumentObject.GoodsShipmentToCustomer") Then
	
		NeedToAgree_                            = False;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.GoodsReceiptFromCustomer") Then
	
		NeedToAgree_                            = False;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.TransferOfGoodsToBailee") Then
		
		NeedToAgree_                            = Not VarianceFromSalesTermsAndConditions;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.RedemptionOfGoodsByCustodian") Then
		
		NeedToAgree_                            = Not VarianceFromSalesTermsAndConditions;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.WriteOffOfShippedGoods") Then
		
		NeedToAgree_                            = Not VarianceFromSalesTermsAndConditions;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.RecognitionOfStockSurplusShippedToCustomer") Then
		
		NeedToAgree_                            = Not VarianceFromSalesTermsAndConditions;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
	ElsIf DocumentType = Type("DocumentObject.ReceiptOfGoodsFromCustodian") Then
		
		NeedToAgree_                            = Not VarianceFromSalesTermsAndConditions;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
		
	ElsIf DocumentType = Type("DocumentObject.RequestForReturnOfGoodsFromCustomer") Then
		
		AllLinesAreCanceled = TMCommonUse.AllLinesAreCanceled(DocumentSales, "SubstituteGoods", "Canceled");
		
		NeedToAgree_                            = Not (AllLinesAreCanceled Or VarianceFromSalesTermsAndConditions Or DocumentSales.Approved Or ApprovedIn1CDocumentManagement);
		YouNeedToAgreeOnManualDiscountsForUsers = Not (AllLinesAreCanceled Or VarianceFromSalesTermsAndConditions Or DocumentSales.Approved Or ApprovedIn1CDocumentManagement);
		UseDiscounts                          = True;
		
	ElsIf DocumentType = Type("DocumentObject.DiscrepancyReportFollowingShipment")
		Or DocumentType = Type("DocumentObject.DiscrepancyReportFollowingReceipt") Then
		
		NeedToAgree_                            = False;
		YouNeedToAgreeOnManualDiscountsForUsers = False;
		UseDiscounts                          = False;
		
	ElsIf DocumentType <> Type("DocumentObject.JobForSalesRepresentative")
	        And DocumentType <> Type("DocumentObject.ReturnOfGoodsFromCustomer")
	        And DocumentType <> Type("DocumentObject.CashRegisterReceipt")
			And DocumentType <> Type("DocumentObject.ReceiptOfCashRegisterAdjustment")
	        And DocumentType <> Type("DataProcessorObject.SalesWizard") Then
		
		NeedToAgree_                            = Not (VarianceFromSalesTermsAndConditions Or DocumentSales.Approved Or ApprovedIn1CDocumentManagement);
		YouNeedToAgreeOnManualDiscountsForUsers = Not (VarianceFromSalesTermsAndConditions Or DocumentSales.Approved Or ApprovedIn1CDocumentManagement);
		UseDiscounts                          = True;
		
	ElsIf DocumentType = Type("DocumentObject.CashRegisterReceipt") Then
		
		NeedToAgree_                            = False;
		YouNeedToAgreeOnManualDiscountsForUsers = Not VarianceFromSalesTermsAndConditions;
		UseDiscounts                          = True;
		
	Else
		
		NeedToAgree_                            = Not VarianceFromSalesTermsAndConditions;
		YouNeedToAgreeOnManualDiscountsForUsers = Not VarianceFromSalesTermsAndConditions;
		UseDiscounts                          = True;
		
	EndIf;
	
	CheckDiscountsCalculated = False;
	ReturnOfMultiTurnContainers = False;
	PackageDepositIsRequired = False;
	SumOfMutualSettlementsOfRealization = 0;
	AmountOfCollateralForImplementation = 0;
	PresentationOfWarehouseField = NStr("vi = 'Kho bãi';
										|ru = 'Склад';
										|en = 'Warehouse'; fa = 'Warehouse';
										|it = 'Склад';
										|pl = 'Magazyn';
										|tr = 'Ambar'");
	
	// Let's check whether it is necessary to check discounts and margins
	UseAutomaticDiscounts             = GetFunctionalOption("UseDiscountsMarkupsInSales");
	UseManualDiscounts                     = GetFunctionalOption("UseDiscountAdjustmentsInSales");
	CheckDiscountsMarkups                       = UseAutomaticDiscounts Or UseManualDiscounts;
	UseSeparateAccountingByTaxation  =
		AccountingPoliciesTaxSettingsCached.SeparateAccountingOfGoodsByVATTaxation(DocumentAttributes.Organization, DocumentAttributes.Date);
	UsePriceGroups                    = GetFunctionalOption("UsePriceGroups");
	UseUserRestrictions       = GetFunctionalOption("UseLimitsForDiscountAdjustmentsInSalesByUsers")
	                                               And YouNeedToAgreeOnManualDiscountsForUsers
	                                               And UseDiscounts;
	UseRestrictionsOnAgreements         = GetFunctionalOption("UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales")
	                                               And NeedToAgree_
	                                               And UseDiscounts;
	LimitDiscountAdjustments                     = UseManualDiscounts And (UseUserRestrictions Or UseRestrictionsOnAgreements);
	UseBusinessUnits                    = GetFunctionalOption("UseBusinessUnits");
	
	// Let's check whether it is necessary to prohibit the closing of orders without full shipment/payment
	UseAdvancedFeaturesOfSalesOrder = ?(DocumentAttributes.ThisIsOrderAsInvoice = Undefined,
					GetFunctionalOption("UseAdvancedFeaturesOfSalesOrder"),
					Not DocumentAttributes.ThisIsOrderAsInvoice);
	
	
	ControlPaymentsOfGivers2_5			= GetFunctionalOption("DoNotCloseMaterialProviderOrdersWithoutCompletePayment2_5");
	ControlOfShipmentOfGiverSOrder2_5			= GetFunctionalOption("DoNotCloseMaterialProviderOrdersWithoutCompleteFulfillment2_5");
	UseStatusesOfMaterialProviderOrders2_5		= GetFunctionalOption("UseStatusesOfMaterialProviderOrders2_5");
	ToUseTermsOfSales = GetFunctionalOption("ToUseTermsOfSales");
	
	UsePartnersProducts   = GetFunctionalOption("UsePartnersProducts");
	UsePriceManagementSystem25       = PriceManagementSystemServerCall.UsePriceManagementSystem25(DocumentSales.Date);
	
	// SALES ASSISTANT
	If DocumentType = Type("DataProcessorObject.SalesWizard") Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ReturnOfMultiTurnContainers = DocumentSales.ToReturnReusablePackage;
		PackageDepositIsRequired = DocumentSales.PackageDepositIsRequired;
		
		If Not (DocumentSales.DocumentCreationOption = Enums.OptionsOfRegisteringSalesDocuments.OrderTransfer
			Or DocumentSales.DocumentCreationOption = Enums.OptionsOfRegisteringSalesDocuments.TransferOfGoodsToBailee) Then
				
				ChecksArray.Add("CorrectSelectionOfProductsForVATTaxation");
				ChecksArray.Add("CorrectnessOfAmountAndAmountOfVAT");
				
		EndIf;
		
		// SALES ASSISTANT - CUSTOMER ORDER
		
		If DocumentSales.DocumentCreationOption = Enums.OptionsOfRegisteringSalesDocuments.SalesOrder
			Or DocumentSales.DocumentCreationOption = Enums.OptionsOfRegisteringSalesDocuments.OrderTransfer
			Or DocumentSales.DocumentCreationOption = Enums.OptionsOfRegisteringSalesDocuments.SalesOrderCustomerInvoice Then
			
			If UseAdvancedFeaturesOfSalesOrder
				Or DocumentSales.DocumentCreationOption <> Enums.OptionsOfRegisteringSalesDocuments.SalesOrder Then
				ChecksArray.Add("CorrectFillingOfWarehouse");
				ChecksArray.Add("CorrectFillingOfWarehouseInProductsTabularSection");
			EndIf;
			
			If UseBusinessUnits Then
				ChecksArray.Add("CorrectFillingOfDivisionInTablePart");
			EndIf;
			
			If NeedToAgree_
				And (DocumentSales.SalesOrderStatus <> Enums.SalesOrderStatuses.NotApproved
					Or Not UseAdvancedFeaturesOfSalesOrder) Then
				
				If Not DocumentSales.DocumentCreationOption = Enums.OptionsOfRegisteringSalesDocuments.OrderTransfer Then
					
					If UsePriceManagementSystem25 Then
						ChecksArray.Add("TempTableOfTSONomenclature");
						ChecksArray.Add("TempTableOfPriceOfItemOfCentralOffice");
						ChecksArray.Add("TempTableOfCentralBankPrices");
					EndIf;
					
					ChecksArray.Add("CorrectIndicationOfVATRate");
					ChecksArray.Add("CorrectVATAmount");
				EndIf;
				
				ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
				
				If ToUseTermsOfSales Then
					ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
					ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
					ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
					ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
					ChecksArray.Add("WhetherProductsBelongToProductSegment");
				EndIf;
				
				If CheckPriceRange Then
					ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
				EndIf;
			
				// Verification of the correctness of the payment stages is carried out only for
				// orders in which not all lines have been canceled and in which the payment schedule is specified.
				
				If TransferOperations_.Find(DocumentSales.BusinessOperation) = Undefined
					And DocumentSales.DocumentAmount <> 0 Then
					
					ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
					ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
					
				EndIf;
				
				If UseAutomaticDiscounts
					And Not DocumentSales.DiscountsAreCalculated
					And TransferOperations_.Find(DocumentSales.BusinessOperation) = Undefined Then
					
					CheckDiscountsCalculated = True;
					
				EndIf;
				
			EndIf;
			
			PresentationOfWarehouseField = NStr("vi = 'Người gửi';
												|ru = 'Отправитель';
												|en = 'Sender'; fa = 'فرستنده';
												|it = 'Отправитель';
												|pl = 'Nadawca';
												|tr = 'Gönderici'");
			
