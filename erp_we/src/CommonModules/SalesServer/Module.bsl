				EndIf;
				
			EndIf;
			
			If LineProducts_.Count <= FoundRow.Count Then
				
				LineProducts_.DocumentSalesOfGoodsAndServices = FoundRow.DocumentSalesOfGoodsAndServices;
				FoundRow.Count = FoundRow.Count - LineProducts_.Count;
				FoundRow.NumberOfPackages = FoundRow.NumberOfPackages - LineProducts_.NumberOfPackages;
				
				If ConversionOfPriceIntoCurrencyIsRequired Then
					LineProducts_.Price = ProcessingOfExchangeRatesTM.ConvertAtRate(
						FoundRow.Price,
						ExchangeRateOfSales,
						ExchangeRateOfReturn);
				Else
					LineProducts_.Price = FoundRow.Price;
				EndIf;
				
				If FoundRow.Count = 0 Then
					QueryResult.Delete(FoundRow);
				EndIf;
				
			Else
				
				LineProducts_.DocumentSalesOfGoodsAndServices = FoundRow.DocumentSalesOfGoodsAndServices;
				If ConversionOfPriceIntoCurrencyIsRequired Then
					LineProducts_.Price = ProcessingOfExchangeRatesTM.ConvertAtRate(
						FoundRow.Price,
						ExchangeRateOfSales,
						ExchangeRateOfReturn);
				Else
					LineProducts_.Price = FoundRow.Price;
				EndIf;
				
				AddedRow = TabularPartOfReturn.Add();
				FillPropertyValues(AddedRow, LineProducts_, ,"RowCode, DocumentSalesOfGoodsAndServices");
				AddedRow.NumberOfPackages = LineProducts_.NumberOfPackages -  FoundRow.NumberOfPackages;
				AddedRow.Count = LineProducts_.Count - FoundRow.Count;
				LineProducts_.NumberOfPackages = FoundRow.NumberOfPackages;
				LineProducts_.Count = FoundRow.Count;
				QueryResult.Delete(FoundRow);
				
			EndIf;
			Break;
		EndDo;
		If FoundRows.Count() = 0 Then
			LineProducts_.DocumentSalesOfGoodsAndServices = Documents.CustomerInvoice.EmptyRef();
			LineProducts_.Price = 0;
		EndIf;
	EndDo;
		
	StructureOfRecalculationOfAmount = BatchProcessingOfTablePartClientServer.ParametersForConvertingAmountOfNDSVToTS(DocumentReturnPolicy);
	
	StructureOfActions = New Structure;
	StructureOfActions.Insert("RecalculateVATAmount", StructureOfRecalculationOfAmount);
	StructureOfActions.Insert("RecalculateAmountWithVAT", StructureOfRecalculationOfAmount);
	StructureOfActions.Insert("RecalculateAmount");
	If TypeOf(DocumentReturnPolicy.Ref) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
		If TypeOf(DocumentReturnPolicy) <> Type("DocumentObject.RequestForReturnOfGoodsFromCustomer") Then
			StructureOfActions.Insert(
				"FillInDuplicateDependentDetails", 
				New Structure("CanceledWithoutReusablePackages", "Sum, VATAmount, AmountIncludingVAT"));
		EndIf; 
	ElsIf TypeOf(DocumentReturnPolicy) = Type("DocumentObject.ReturnOfGoodsFromCustomer") Then
	Else
		StructureOfActions.Insert("FillInMethodForDeterminingCost", Enums.WaysToCalculateReturnCost.FromCurrentDocument);
		StructureOfActions.Insert("FillInCostDeterminationMethodWithLine", CostDeterminationParameters(DocumentReturnPolicy));
	EndIf;
	BatchProcessingOfTablePartServer.TreatTS(TabularPartOfReturn, StructureOfActions, Undefined);

EndProcedure

// Updates information about the number of implementation documents in the table part of the return document.
//
// Parameters:
//		SalesList - ValueList - List of values containing a list of implementation documents
//		ImplementationInHeader - Undefined - Link to the implementation document in the document header
//		CaptionTitle - String - Label containing information about the number of implementation documents
//		FormItems - FormItems - Elements of the return document form
//		ColumnInTablePart - Undefined - Column of the table part containing implementation documents
//		TabularSection - TabularSection - Table part of the return document
//		ImplementationNameInTablePart - String - Name of the column with implementation documents in the table part.
//		
Procedure UpdateInformationOnImplementationsInForm(SalesList,
	                                            ImplementationInHeader,
	                                            CaptionTitle,
	                                            FormItems,
	                                            ColumnInTablePart,
	                                            Val TabularSection,
	                                            Val ImplementationNameInTablePart) Export
	
	SalesList.Clear();
	For Each CurRow In TabularSection Do
		If ValueIsFilled(CurRow[ImplementationNameInTablePart]) And SalesList.FindByValue(CurRow[ImplementationNameInTablePart]) = Undefined Then
			SalesList.Add(CurRow[ImplementationNameInTablePart]);
		EndIf;
	EndDo;
	
	If SalesList.Count() = 1 Then
		ImplementationInHeader = SalesList[0].Value;
	EndIf;
	
	If SalesList.Count() > 1 Then
		CaptionTitle = StrReplace(
			NStr("vi = 'Tất cả chứng từ: %NumberOfImplementations%';
				|ru = 'Всего документов: %NumberOfImplementations%';
				|en = 'Total documents: %NumberOfImplementations%'; fa = 'Total documents: %NumberOfImplementations%';
				|it = 'Totale documenti: %NumberOfImplementations%';
				|pl = 'Razm dokumentów: %NumberOfImplementations%';
				|tr = 'Toplam belgeler: %NumberOfImplementations%'"), "%NumberOfImplementations%",
			SalesList.Count());
		ImplementationInHeader = Undefined;
	EndIf;
	
	If SalesList.Count() < 1 Then
		ImplementationInHeader = Undefined;
	EndIf;
	
	If SalesList.Count() <= 1 Then
		FormItems.SalePages.CurrentPage = FormItems.PageSales;
	Else
		FormItems.SalePages.CurrentPage = FormItems.SalesPage;
	EndIf;
	
EndProcedure

// Fills in the document for the return of goods on the KKM receipt
//
// Parameters:
//		DocumentReturnPolicy - DocumentObject.RequestForReturnOfGoodsFromCustomer, DocumentObject.ReturnOfGoodsFromCustomer - 
//		TableName - String - Name of the Products table.
Procedure FillInReturnedItemsByReceipt(DocumentReturnPolicy, TableName) Export
	
	TableOfCheckedProducts = DocumentReturnPolicy[TableName].Unload();
	
	Query = New Query;
	
	Query.Text =
	"SELECT ALLOWED TOP 1
	|	ISNULL(RetailSalesReport.Ref, VALUE(Document.RetailSalesReport.EmptyRef)) AS DocumentSalesOfGoodsAndServices,
	|	CASE WHEN ISNULL(RetailSalesReport.Ref, VALUE(Document.RetailSalesReport.EmptyRef)) = VALUE(Document.RetailSalesReport.EmptyRef)
	|		THEN VALUE(Enum.WaysToCalculateReturnCost.FromCurrentDocument) 
	|		ELSE VALUE(Enum.WaysToCalculateReturnCost.FromSalesDocument)
	|	END AS CostDefiningMethod,
	|	CashRegisterReceipts.Ref AS Ref,
	|	CashRegisterReceipts.Warehouse AS Warehouse,
	|	CashRegisterReceipts.Date AS SaleDate,
	|	CashRegisterReceipts.Number AS SalesNumber,
	|	CashRegisterReceipts.Currency AS CurrencyOfImplementation,
	|	CashRegisterReceipts.PriceIncludesVAT AS PriceIncludesVAT,
	|	CashRegisterReceipts.Partner AS Partner
	|INTO CRReceiptData
	|FROM Document.CashRegisterReceipt AS CashRegisterReceipts
	|	LEFT JOIN Document.RetailSalesReport AS RetailSalesReport
	|	ON CashRegisterReceipts.CashRegisterShift = RetailSalesReport.CashRegisterShift
	|		AND CashRegisterReceipts.VATTaxation = &VATTaxation
	|		AND CashRegisterReceipts.Organization = &Organization
	|WHERE
	|	CashRegisterReceipts.Ref = &CashRegisterReceipt
	|	AND CashRegisterReceipts.VATTaxation = &VATTaxation
	|	AND CashRegisterReceipts.Posted
	|	AND CashRegisterReceipts.Organization = &Organization
	|;
	|
	|SELECT ALLOWED
	|	CashRegisterReceiptGoods.Ref AS CashRegisterReceipt,
	|	CashRegisterReceiptGoods.ProductsInSet AS ProductsInSet,
	|	CashRegisterReceiptGoods.ItemVariantOfSet AS ItemVariantOfSet,
	|	CashRegisterReceiptGoods.Products AS Products,
	|	CashRegisterReceiptGoods.Characteristic AS Characteristic,
	|	CashRegisterReceiptGoods.Series AS Series,
	|   CashRegisterReceiptGoods.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	CashRegisterReceiptGoods.Package AS Package,
	|	SUM(CashRegisterReceiptGoods.NumberOfPackages) AS NumberOfPackages,
	|	SUM(CashRegisterReceiptGoods.Count) AS Count,
	|	CashRegisterReceiptGoods.Price AS Price,
	|	SUM(CashRegisterReceiptGoods.Sum) AS Sum,
	|	CashRegisterReceiptGoods.VATRate AS VATRate,
	|	SUM(CashRegisterReceiptGoods.VATAmount) AS VATAmount,
	|	CashRegisterReceiptGoods.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
	|	SUM(CashRegisterReceiptGoods.DiscountMarkupAmount) AS DiscountMarkupAmount,
	|	CashRegisterReceiptGoods.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
	|	SUM(CashRegisterReceiptGoods.ManualDiscount) AS ManualDiscount
	|INTO ProductsSold
	|FROM
	|	Document.CashRegisterReceipt.Goods AS CashRegisterReceiptGoods
	|	INNER JOIN CRReceiptData AS CRReceiptData
	|	ON CRReceiptData.Ref = CashRegisterReceiptGoods.Ref
	|WHERE
	|	CashRegisterReceiptGoods.Products.ItemsType IN
	|		(VALUE(Enum.ItemsTypes.OwnGoods),VALUE(Enum.ItemsTypes.ReusablePackage))
	|
	|GROUP BY
	|	CashRegisterReceiptGoods.Ref,
	|	CashRegisterReceiptGoods.ProductsInSet,
	|	CashRegisterReceiptGoods.ItemVariantOfSet,
	|	CashRegisterReceiptGoods.Products,
	|	CashRegisterReceiptGoods.Characteristic,
	|	CashRegisterReceiptGoods.Series,
	|   CashRegisterReceiptGoods.BatchesIndicationStatus,
	|	CashRegisterReceiptGoods.Package,
	|	CashRegisterReceiptGoods.Price,
	|	CashRegisterReceiptGoods.VATRate,
	|	CashRegisterReceiptGoods.PercentRateOfAutomaticDiscountMarkup,
	|	CashRegisterReceiptGoods.PercentRateOfManualDiscount
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	CashRegisterReceiptReturnProducts.Ref.CashRegisterReceipt AS CashRegisterReceipt,
	|	CashRegisterReceiptReturnProducts.ProductsInSet AS ProductsInSet,
	|	CashRegisterReceiptReturnProducts.ItemVariantOfSet AS ItemVariantOfSet,
	|	CashRegisterReceiptReturnProducts.Products AS Products,
	|	CashRegisterReceiptReturnProducts.Characteristic AS Characteristic,
	|	CashRegisterReceiptReturnProducts.Series AS Series,
	|   CashRegisterReceiptReturnProducts.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	CashRegisterReceiptReturnProducts.Package AS Package,
	|	SUM(CashRegisterReceiptReturnProducts.NumberOfPackages) AS NumberOfPackages,
	|	SUM(CashRegisterReceiptReturnProducts.Count) AS Count,
	|	CashRegisterReceiptReturnProducts.Price AS Price,
	|	SUM(CashRegisterReceiptReturnProducts.Sum) AS Sum,
	|	CashRegisterReceiptReturnProducts.VATRate AS VATRate,
	|	SUM(CashRegisterReceiptReturnProducts.VATAmount) AS VATAmount
	|INTO GoodsReceiptCashRegisterReturn
	|FROM
	|	Document.CashRegisterReceiptReturn.Goods AS CashRegisterReceiptReturnProducts
	|WHERE
	|	CashRegisterReceiptReturnProducts.Ref.CashRegisterReceipt = &CashRegisterReceipt
	|	AND CashRegisterReceiptReturnProducts.Ref.Posted
	|	AND CashRegisterReceiptReturnProducts.NumberOfPackages <> 0
	|	AND CashRegisterReceiptReturnProducts.Products.ItemsType IN
	|		(VALUE(Enum.ItemsTypes.OwnGoods),VALUE(Enum.ItemsTypes.ReusablePackage))
	|
	|GROUP BY
	|	CashRegisterReceiptReturnProducts.Package,
	|	CashRegisterReceiptReturnProducts.ProductsInSet,
	|	CashRegisterReceiptReturnProducts.ItemVariantOfSet,
	|	CashRegisterReceiptReturnProducts.Products,
	|	CashRegisterReceiptReturnProducts.VATRate,
	|	CashRegisterReceiptReturnProducts.Ref,
	|	CashRegisterReceiptReturnProducts.Characteristic,
	|	CashRegisterReceiptReturnProducts.Series,
	|	CashRegisterReceiptReturnProducts.BatchesIndicationStatus,
	|	CashRegisterReceiptReturnProducts.Price
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	RefundProducts.ProductsInSet,
	|	RefundProducts.ItemVariantOfSet,
	|	RefundProducts.Products,
	|	RefundProducts.Characteristic,
	|	RefundProducts.Series,
	|	RefundProducts.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	SUM(RefundProducts.NumberOfPackages) AS NumberOfPackages,
	|	SUM(RefundProducts.Count) AS Count,
	|	RefundProducts.DocumentSalesOfGoodsAndServices,
	|	RefundProducts.Ref.CashRegisterReceipt AS CashRegisterReceipt,
	|	SUM(RefundProducts.Sum) AS Sum,
	|	SUM(RefundProducts.VATAmount) AS VATAmount,
	|	SUM(RefundProducts.AmountIncludingVAT) AS AmountIncludingVAT
	|INTO RefundProducts
	|FROM
	| Document.ReturnOfGoodsFromCustomer.Goods AS RefundProducts
	|WHERE
	|	RefundProducts.Ref.Posted
	|	AND RefundProducts.Ref.CashRegisterReceipt = &CashRegisterReceipt
	|	AND RefundProducts.Ref <> &DocumentReturnPolicy
	|
	|GROUP BY
	|	RefundProducts.ProductsInSet,
	|	RefundProducts.ItemVariantOfSet,
	|	RefundProducts.Products,
	|	RefundProducts.Characteristic,
	|	RefundProducts.Series,
	|	RefundProducts.BatchesIndicationStatus,
	|	RefundProducts.DocumentSalesOfGoodsAndServices,
	|	RefundProducts.Ref.CashRegisterReceipt
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	CRReceiptData.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
	|	CRReceiptData.CostDefiningMethod AS CostDefiningMethod,
	|	ProductsSold.ProductsInSet,
	|	ProductsSold.ItemVariantOfSet,
	|	ProductsSold.Products AS Products,
	|	ProductsSold.Characteristic AS Characteristic,
	|	ProductsSold.Series AS Series,
	|   ProductsSold.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	ProductsSold.Package AS Package,
	|	CASE
	|		WHEN ProductsSold.Package IS NULL 
	|				OR ProductsSold.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN ProductsSold.Count - ISNULL(RefundProducts.Count, 0) - ISNULL(GoodsReceiptCashRegisterReturn.Count, 0)
	|		ELSE (ProductsSold.Count - ISNULL(RefundProducts.Count, 0) - ISNULL(GoodsReceiptCashRegisterReturn.Count, 0)) / &QueryTextPackagingFactor
	|	END AS NumberOfPackages,
	|	ProductsSold.Count - ISNULL(RefundProducts.Count, 0) - ISNULL(GoodsReceiptCashRegisterReturn.Count, 0) AS Count,
	|	CASE
	|		WHEN ProductsSold.Count - ISNULL(RefundProducts.Count, 0) - ISNULL(GoodsReceiptCashRegisterReturn.Count, 0) = 0
	|			THEN ProductsSold.Price
	|		ELSE CASE
	|				WHEN ProductsSold.Package IS NULL 
	|						OR ProductsSold.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|					THEN ProductsSold.Sum / ProductsSold.Count
	|				ELSE ProductsSold.Sum / (ProductsSold.Count / &QueryTextPackagingFactor)
	|			END
	|	END AS Price,
	|	ProductsSold.Sum - ISNULL(RefundProducts.Sum, 0) - ISNULL(GoodsReceiptCashRegisterReturn.Sum, 0) AS Sum,
	|	ProductsSold.VATRate AS VATRate,
	|	ProductsSold.VATAmount - ISNULL(RefundProducts.VATAmount, 0) - ISNULL(GoodsReceiptCashRegisterReturn.VATAmount, 0) AS VATAmount,
	|	ProductsSold.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
	|	ProductsSold.DiscountMarkupAmount AS DiscountMarkupAmount,
	|	ProductsSold.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
	|	ProductsSold.ManualDiscount AS ManualDiscount,
	|	CRReceiptData.SaleDate AS SaleDate,
	|	CRReceiptData.SalesNumber AS SalesNumber,
	|	CRReceiptData.CurrencyOfImplementation AS CurrencyOfImplementation,
	|	CRReceiptData.PriceIncludesVAT AS PriceIncludesVAT,
	|	CRReceiptData.Partner AS Partner,
	|	CRReceiptData.Warehouse AS Warehouse
	|FROM
	|	ProductsSold AS ProductsSold
	|		LEFT JOIN CRReceiptData AS CRReceiptData
	|		ON ProductsSold.CashRegisterReceipt = CRReceiptData.Ref
	|		LEFT JOIN GoodsReceiptCashRegisterReturn AS GoodsReceiptCashRegisterReturn
	|		ON ProductsSold.CashRegisterReceipt = GoodsReceiptCashRegisterReturn.CashRegisterReceipt
	|			AND ProductsSold.ProductsInSet = GoodsReceiptCashRegisterReturn.ProductsInSet
	|			AND ProductsSold.ItemVariantOfSet = GoodsReceiptCashRegisterReturn.ItemVariantOfSet
	|			AND ProductsSold.Products = GoodsReceiptCashRegisterReturn.Products
	|			AND ProductsSold.Characteristic = GoodsReceiptCashRegisterReturn.Characteristic
	|			AND ProductsSold.Series = GoodsReceiptCashRegisterReturn.Series
	|		LEFT JOIN RefundProducts AS RefundProducts
	|		ON ProductsSold.CashRegisterReceipt = RefundProducts.CashRegisterReceipt
	|			AND ProductsSold.ProductsInSet = RefundProducts.ProductsInSet
	|			AND ProductsSold.ItemVariantOfSet = RefundProducts.ItemVariantOfSet
	|			AND ProductsSold.Products = RefundProducts.Products
	|			AND ProductsSold.Characteristic = RefundProducts.Characteristic
	|			AND ProductsSold.Series = RefundProducts.Series
	|WHERE
	|	ProductsSold.Count - ISNULL(RefundProducts.Count, 0) - ISNULL(GoodsReceiptCashRegisterReturn.Count, 0) > 0
	|
	|ORDER BY
	|	SaleDate DESC,
	|	Products,
	|	Characteristic,
	|	Series,
	|	Price,
	|	ManualDiscount,
	|	Partner
	|";
	
	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"ProductsSold.Package",
		"ProductsSold.Products"));
		
	Query.SetParameter("VATTaxation", DocumentReturnPolicy.VATTaxation);
	Query.SetParameter("Organization", DocumentReturnPolicy.Organization);
	Query.SetParameter("CashRegisterReceipt", DocumentReturnPolicy.CashRegisterReceipt);
	Query.SetParameter("DocumentReturnPolicy", DocumentReturnPolicy.Ref);
	
	QueryResult = Query.Execute();
	Selection = QueryResult.Select();
	
	While Selection.Next() Do
		
		NewRow = DocumentReturnPolicy[TableName].Add();
		FillPropertyValues(NewRow, Selection);
		
		If DocumentReturnPolicy.Currency <> Selection.CurrencyOfImplementation Then
			BaseCurrency = SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(DocumentReturnPolicy.Organization);
			NewCurrencyRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(DocumentReturnPolicy.Currency, DocumentReturnPolicy.Date, BaseCurrency);
			OldCurrencyRate = ProcessingOfExchangeRatesTM.GetCurrencyRate(Selection.CurrencyOfImplementation, DocumentReturnPolicy.Date, BaseCurrency);
			
			NewRow.Price = ProcessingOfExchangeRatesTM.ConvertAtRate(
				NewRow.Price,
				OldCurrencyRate,
				NewCurrencyRate);
			
			PriceManagementSystem.RecalculateAmountsInRow(
				NewRow,
				False,
				True,
				False,
				DocumentReturnPolicy.PriceIncludesVAT);
				
		Else
			
			NewRow.AmountIncludingVAT = NewRow.Sum + ?(DocumentReturnPolicy.PriceIncludesVAT, 0, NewRow.VATAmount);
			
		EndIf;
		
	EndDo;
		
EndProcedure

// Controls the display of the debt limit in the document form
//
// Parameters:
//	Contract           - CatalogRef.CounterpartyContracts - Agreement specified in the document
//	Date              - Date - Date on which the amount of overdue debt is calculated
//	Text             - String - Details that are assigned to the text string about the balance of the allowed credit
//	TextVisibility   - Boolean - Details that are assigned the visibility value of the line about the allowed credit balance
//	TextColor        - StyleColors - Details that are assigned the color value of the line about the balance of the allowed credit
//	ImageVisibility - Boolean - Details that are assigned the visibility value of the image about the shipment ban.
//
Procedure UpdateDebtLimit(Contract, Date, Text, TextVisibility, TextColor, ImageVisibility) Export
	
	If AccessRight("Read", Metadata.Catalogs.CounterpartyContracts)
		And AccessRight("Read", Metadata.AccumulationRegisters.CustomersARAPAccounting) Then
		
		ContractData = New Structure; 
		ContractData.Insert("LimitDebtAmount", False); 
		ContractData.Insert("AllowableAmountPayable", 0); 
		ContractData.Insert("ARAPCurrency", Undefined); 
		ContractData.Insert("ShipmentIsProhibitedInCaseOfARAPOverdue", False); 
		
		If ValueIsFilled(Contract) Then
			
			Query = New Query("SELECT ALLOWED
			|	CounterpartyContracts.LimitDebtAmount AS LimitDebtAmount,
			|	CounterpartyContracts.AllowableAmountPayable AS AllowableAmountPayable,
			|	CounterpartyContracts.ARAPCurrency AS ARAPCurrency,
			|	CounterpartyContracts.ShipmentIsProhibitedInCaseOfARAPOverdue AS ShipmentIsProhibitedInCaseOfARAPOverdue
			|FROM
			|	Catalog.CounterpartyContracts AS CounterpartyContracts
			|WHERE
			|	CounterpartyContracts.Ref = &Contract");
			
			Query.SetParameter("Contract", Contract);
			
			Selection = Query.Execute().Select();
			If Selection.Next() Then
				ContractData = Selection;
			EndIf;
			
		EndIf;
		
		AmountExceeded = False;
		If ContractData.LimitDebtAmount Then
			RemainingAllowedCredit = RemainingAllowedCredit(Contract, ContractData.AllowableAmountPayable);
			AmountExceeded = RemainingAllowedCredit < 0;
		EndIf;
		
		DeadlineExceeded = False;
		If ContractData.ShipmentIsProhibitedInCaseOfARAPOverdue Then
			AmountOfOverdueDebt = AmountOfOverdueDebt(Contract, Date);
			DeadlineExceeded = AmountOfOverdueDebt > 0;
		EndIf;
		
		If AmountExceeded Or DeadlineExceeded Then
			Text = NStr("vi = 'Cấm giao hàng';
						|ru = 'Отгрузка запрещена';
						|en = 'Shipment is prohibited'; fa = 'ارسال ممنوع است';
						|it = 'Spedizione vietata';
						|pl = 'Wysyłka zabroniona';
						|tr = 'Sevkiyat yasaklandı'");
			TextColor = WebColors.FireBrick;
			TextVisibility = True;
			ImageVisibility = True;
		ElsIf ContractData.LimitDebtAmount Then
			Text = NStr("vi = 'Số dư trả sau được phép:';
						|ru = 'Остаток допустимого кредита:';
						|en = 'Allowed credit balance:'; fa = 'Allowed credit balance:';
						|it = 'Saldo del credito disponibile:';
						|pl = 'Reszta dopuszczalnego kredytu:';
						|tr = 'Mevcut kredi bakiyesi:'") + " " + Format(RemainingAllowedCredit, "NFD=2; NZ=0,00") + " " + String(ContractData.ARAPCurrency);
			TextColor = StyleColors.HyperlinkColor;
			TextVisibility = True;
			ImageVisibility = False;
		Else
			Text = "";
			TextVisibility = False;
			ImageVisibility = False;
		EndIf;
		
	Else
		
		Text = "";
		TextVisibility = False;
		ImageVisibility = False;
		
	EndIf;
	
EndProcedure

// Generates a temporary table containing the coefficients of packages for the product table.
// 
// Parameters:
//  TempTablesManager - TempTablesManager - A temporary table manager containing a table of product tables with fields:
// Link,
// Number lines,
// Nomenclature,
// Packaging,
// Number of packages,
// Quantity.
//  ProductTableName_ - String - Name of the product table
Procedure PutTemporaryTableOfPackingCoefficients(TempTablesManager, ProductTableName_ = "TableOfGoods") Export
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text = TextOfTemporaryTableOfPackageCoefficients(ProductTableName_);
		
	Query.Execute();
	
EndProcedure

// The text of the temporary table of packing coefficients.
// 
// Parameters:
//  ProductTableName_ - String - Name of the product table
// 
// Returns:
//  String - Text Of The Temporary Table Of Package Coefficients
Function TextOfTemporaryTableOfPackageCoefficients(ProductTableName_ = "TableOfGoods") Export
	
	QueryText = "
	|SELECT
	|	TableOfGoods.Products,
	|	TableOfGoods.Package AS Package,
	|	ProductPackages.Owner AS Owner,
	|	MIN(CASE
	|			WHEN ProductPackages.Ref IS NULL 
	|				THEN 1
	|			ELSE &QueryTextPackagingFactor1
	|		END) AS ZoomRatio
	|INTO Packages
	|FROM
	|	&ProductTableName_ AS TableOfGoods
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
	|		ON ProductPackages.Owner = 
	|			CASE
	|				WHEN TableOfGoods.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
	|					THEN TableOfGoods.Products
	|				WHEN TableOfGoods.Products.PackagingGroup <> VALUE(Catalog.PackagingGroups.EmptyRef)
	|					THEN TableOfGoods.Products.PackagingGroup
	|				ELSE FALSE
	|			END
	|WHERE
	|	NOT ProductPackages.DeletionMark
	|	AND TableOfGoods.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|
	|GROUP BY
	|	TableOfGoods.Products,
	|	TableOfGoods.Package,
	|	ProductPackages.Owner
	|
	|UNION ALL
	|
	|SELECT
	|	TableOfGoods.Products,
	|	TableOfGoods.Package AS Package,
	|	ProductPackages.Owner AS Owner,
	|	MIN(CASE
	|			WHEN ProductPackages.Ref IS NULL 
	|				THEN 1
	|			ELSE &QueryTextPackagingFactor1
	|		END) AS ZoomRatio
	|FROM
	|	&ProductTableName_ AS TableOfGoods
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
	|		ON ProductPackages.Owner = TableOfGoods.Package.Owner
	|WHERE
	|	NOT ProductPackages.DeletionMark
	|	AND TableOfGoods.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|
	|GROUP BY
	|	TableOfGoods.Products,
	|	TableOfGoods.Package,
	|	ProductPackages.Owner
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Packages.Products,
	|	Packages.Package AS Package,
	|	&QueryTextPackagingFactor2 AS PackagingFactor,
	|	MIN(ProductPackages.Ref) AS NestedPackaging,
	|	MIN(&QueryTextPackagingFactor3) AS NestedPackingRatio
	|INTO NestedPackages
	|FROM
	|	Packages AS Packages
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
	|		ON Packages.Owner = ProductPackages.Owner
	|			AND Packages.ZoomRatio = &QueryTextPackagingFactor3
	|WHERE
	|	ProductPackages.Parent = Packages.Package
	|
	|GROUP BY
	|	Packages.Products,
	|	Packages.Package,
	|	&QueryTextPackagingFactor2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	TableOfGoods.Products,
	|	TableOfGoods.NumberOfPackages,
	|	TableOfGoods.Count,
	|	TableOfGoods.Package,
	|	TableOfGoods.LineNumber,
	|	CASE
	|		WHEN NestedPackages.NestedPackaging IS NULL 
	|			THEN CASE
	|					WHEN TableOfGoods.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|						THEN 1
	|					ELSE &QueryTextPackagingFactor4
	|				END
	|		ELSE NestedPackages.PackagingFactor
	|	END AS PackagingFactor,
	|	CASE
	|		WHEN NestedPackages.NestedPackaging IS NULL 
	|			THEN CASE
	|					WHEN TableOfGoods.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|						THEN 1
	|					ELSE &QueryTextPackagingFactor4
	|				END
	|		ELSE NestedPackages.NestedPackingRatio
	|	END AS NestedPackingRatio,
	|	CASE
	|		WHEN NestedPackages.NestedPackaging IS NULL 
	|			THEN CASE
	|					WHEN TableOfGoods.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|						THEN TableOfGoods.Products.UnitOfMeasure
	|					ELSE TableOfGoods.Package
	|				END
	|		ELSE NestedPackages.NestedPackaging
	|	END AS PackageKind,
	|	TableOfGoods.Ref AS Ref
	|INTO PackingFactors
	|FROM
	|	&ProductTableName_ AS TableOfGoods
	|		LEFT JOIN NestedPackages AS NestedPackages
	|		ON TableOfGoods.Products = NestedPackages.Products
	|			AND TableOfGoods.Package = NestedPackages.Package
	|INDEX BY
	|	Ref,
	|	LineNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Packages
	|;
	|/////////////////////////////////////////////////////////////////////////////
	|DROP NestedPackages
	|";
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor1",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"ProductPackages",
		"TableOfGoods.Products"));
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor2",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"Packages.Package",
		"Packages.Products"));
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor3",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"ProductPackages",
		"Packages.Products"));
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor4",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"TableOfGoods.Package",
		"TableOfGoods.Products"));
		
	QueryText = StrReplace(QueryText, "&ProductTableName_", ProductTableName_);
	
	Return QueryText;
	
EndFunction

// Changes the details associated with the partner when the partner changes
//
// Parameters:
//	Object           - DocumentObject - The sales document.
//
Procedure PartnerOnChange(Object) Export
	
	If Object.Partner <> Common.ObjectAttributeValue(Object.GoodsRecipient, "Partner") Then
		Object.GoodsRecipient = Undefined;
		Object.GoodsRecipientBankAccount = Undefined;
	EndIf;
	If Not ValueIsFilled(Object.CounterpartyBankAccount) Or Object.Counterparty <>
			Common.ObjectAttributeValue(Object.CounterpartyBankAccount, "Owner") Then
		ParametersOfAccount = CashServer.ParametersForFillingInCounterpartySBankAccount(Object.Counterparty);
		Object.CounterpartyBankAccount =
			CashServer.GetDefaultCounterpartyBankAccount(ParametersOfAccount);
	EndIf;
	
EndProcedure

