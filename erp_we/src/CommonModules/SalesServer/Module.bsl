// Retrieves all available contracts for the passed parameters
//
// Parameters:
// 		CurContract - CatalogRef.CounterpartyContracts - Link to the current agreement
// 		Partner - CatalogRef.Partners - Business partner of the company to which sales are made;
//		Counterparty - CatalogRef.Counterparties - Counterparty with whom the contract is concluded;
//		Organization - CatalogRef.Companies - The organization of the enterprise on whose behalf the contract is concluded;
//		BusinessTransactions - EnumRef.BusinessTransactions, Array - One or more business transactions (contract type);
//		ARAPCurrency - CatalogRef.Currencies - Currency of mutual settlements with the partner under the agreement;
//		Terms - CatalogRef.TermsOfSale - If the order is not specified, it will be obtained from the agreement with the client.
// 
// Returns:
// 		Array - array of available contracts.
//
Function GetAvailableContracts(
	CurContract,
	Partner,
	Counterparty,
	Organization,
	BusinessTransactions = Undefined,
	ARAPCurrency = Undefined,
	Terms = Undefined) Export
	
	Query = New Query(
		"SELECT ALLOWED
		|	CounterpartyContracts.Ref,
		|	CASE
		|		WHEN &CurContract = CounterpartyContracts.Ref
		|			THEN 1
		|		ELSE 0
		|	END AS Order
		|FROM
		|	Catalog.CounterpartyContracts AS CounterpartyContracts
		|		INNER JOIN InformationRegister.PartnerHierarchy AS PartnerHierarchy
		|		ON CounterpartyContracts.Partner = PartnerHierarchy.Parent
		|		AND PartnerHierarchy.Partner = &Partner
		|WHERE
		|	(NOT CounterpartyContracts.DeletionMark)
		|	AND CounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
		|	AND CounterpartyContracts.Counterparty = &Counterparty
		|	AND CounterpartyContracts.Organization = &Organization
		|	AND ((NOT &FilterBusinessOperation)
		|	OR CounterpartyContracts.BusinessOperation IN (&BusinessOperation))
		|	AND ((NOT &FilterARAPCurrency)
		|	OR CounterpartyContracts.ARAPCurrency = &ARAPCurrency)
		|ORDER BY
		|	Order DESC");
	Query.SetParameter("CurContract", CurContract);
	Query.SetParameter("Partner", Partner);
	Query.SetParameter("Counterparty", Counterparty);
	Query.SetParameter("Organization", Organization);
	Query.SetParameter("FilterBusinessOperation", BusinessTransactions <> Undefined);
	Query.SetParameter("BusinessOperation", BusinessTransactions);
	Query.SetParameter("FilterARAPCurrency", ARAPCurrency <> Undefined);
	Query.SetParameter("ARAPCurrency", ARAPCurrency);
	Query.SetParameter("FilterTerms", Terms <> Undefined);
	Query.SetParameter("Terms", ?(Terms=Undefined, Catalogs.TermsOfSale.EmptyRef(), Terms));
	
	Result = Query.Execute();
	If Result.IsEmpty() Then
		Return New Array;
	Else 
		Return Result.Unload().UnloadColumn("Ref");
	EndIf;
	
EndFunction

// Checks for adjustments and invoices entered based on the document being modified.
//
// Parameters:
// Ref - DocumentRef - Document to change
// Basis - DocumentRef - The basis for the adjustments
// ThereAreAdjustingEntries - Boolean - Return parameter. Indicates whether the document being modified has any adjustments.
//
// Returns:
//		EnumRef.AdjustingEntryTypes - the type of adjustment, if any.
//
Function CheckForAdjustments(Ref, Basis, ThereAreAdjustingEntries) Export
	
	SetPrivilegedMode(True);
	
	Query = New Query("
	|SELECT TOP 1
	|	DocumentData.Ref AS Adjusting,
	|	DocumentData.Ref.AdjustingEntryType AS AdjustingEntryType,	
	|	DocumentData.PointInTime AS PointInTime
	|FROM
	|	Document.SaleAdjustment AS DocumentData
	|WHERE
	|	DocumentData.DocumentBasis = &Basis
	|	AND (DocumentData.Posted
	|	OR DocumentData.Ref = &Ref)
	|	
	|UNION ALL
	|
	|SELECT TOP 1
	|	DocumentData.Ref AS Adjusting,
	|	DocumentData.Ref.AdjustingEntryType AS AdjustingEntryType,	
	|	DocumentData.Ref.PointInTime AS PointInTime
	|FROM
	|	Document.SaleAdjustment.ARAPAdjustment AS DocumentData
	|WHERE
	|	DocumentData.DocumentSalesOfGoodsAndServices = &Basis
	|	AND DocumentData.Ref.Posted
	|
	|ORDER BY
	|	PointInTime DESC
	|");
	Query.SetParameter("Basis", Basis);
	Query.SetParameter("Ref", Ref);
	
	QueryResult = Query.Execute();
	
	If TypeOf(Ref) = Type("DocumentRef.SaleAdjustment") Then
		Selection = QueryResult.Select();
		Selection.Next();
		ThereAreAdjustingEntries = ValueIsFilled(Selection.Adjusting) And Selection.Adjusting <> Ref;
		AdjustingEntryType = ?(ThereAreAdjustingEntries, Selection.AdjustingEntryType, Enums.AdjustingEntryTypes.EmptyRef());
	Else
		ThereAreAdjustingEntries = Not QueryResult.IsEmpty();
		Selection = QueryResult.Select();
		If Selection.Next() Then
			AdjustingEntryType = Selection.AdjustingEntryType;			
		Else		
			AdjustingEntryType = Enums.AdjustingEntryTypes.EmptyRef();
		EndIf;
	EndIf;	
	
	Return AdjustingEntryType;
	
EndFunction

// Fills in the sales and price documents in the table part of the refund documents
//
// Parameters:
//		DocumentReturnPolicy - DocumentObject.RequestForReturnOfGoodsFromCustomer, DocumentObject.ReturnOfGoodsFromCustomer - 
//		TableName - String - Name of the Products table
Procedure FillInSalesAndPrices(DocumentReturnPolicy, TableName) Export
	Query = New Query;
	
	TableOfCheckedGoods = DocumentReturnPolicy[TableName].Unload();
	TabularPartOfReturn    = DocumentReturnPolicy[TableName];
	
	ReturnFromRetailCustomer = (DocumentReturnPolicy.BusinessOperation = Enums.BusinessTransactions.ReturnFromRetailCustomer);
	ThereIsRightToTara = AccessRight("Read", Metadata.AccumulationRegisters.TransferredReturnablePackaging);
	ReturnDate = ?(ValueIsFilled(DocumentReturnPolicy.Date),DocumentReturnPolicy.Date,CurrentSessionDate());
	
	If Not ReturnFromRetailCustomer Then
		Query.Text = 
		"SELECT ALLOWED
		|	ReturnOfGoodsFromCustomerGoods.Products,
		|	ReturnOfGoodsFromCustomerGoods.Characteristic,
		|	ReturnOfGoodsFromCustomerGoods.Series,
		|	ReturnOfGoodsFromCustomerGoods.Purpose,
		|	ReturnOfGoodsFromCustomerGoods.NumberOfPackages,
		|	ReturnOfGoodsFromCustomerGoods.Package,
		|	ReturnOfGoodsFromCustomerGoods.Count
		|INTO ProductsToFillIn
		|FROM
		|	&GoodsTable AS ReturnOfGoodsFromCustomerGoods
		|
		|INDEX BY
		|	ReturnOfGoodsFromCustomerGoods.Products,
		|	ReturnOfGoodsFromCustomerGoods.Characteristic,
		|	ReturnOfGoodsFromCustomerGoods.Series,
		|	ReturnOfGoodsFromCustomerGoods.Purpose
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED DISTINCT
		|	SalesOfGoodsServicesGoods.Ref AS Ref
		|INTO SaleDocuments
		|FROM
		|	ProductsToFillIn AS ProductsToFillIn
		|		LEFT JOIN Document.CustomerInvoice.Goods AS SalesOfGoodsServicesGoods
		|		ON ProductsToFillIn.Products = SalesOfGoodsServicesGoods.Products
		|			AND ProductsToFillIn.Characteristic = SalesOfGoodsServicesGoods.Characteristic
		|			AND ProductsToFillIn.Series = SalesOfGoodsServicesGoods.Series
		|			AND ProductsToFillIn.Purpose = SalesOfGoodsServicesGoods.Purpose
		|WHERE
		|	SalesOfGoodsServicesGoods.Ref.Posted
		|	AND SalesOfGoodsServicesGoods.Ref.Status = VALUE(Enum.StatusesOfCustomerInvoices.Shipped)
		|	AND SalesOfGoodsServicesGoods.Ref.Counterparty = &Counterparty
		|	AND SalesOfGoodsServicesGoods.Ref.Organization = &Organization
		|	AND CASE
		|		WHEN NOT &ToUseTermsOfSales
		|			THEN TRUE
		|		ELSE SalesOfGoodsServicesGoods.Ref.Terms = &Terms
		|	END
		|	AND SalesOfGoodsServicesGoods.Ref.VATTaxation = &VATTaxation
		|	AND SalesOfGoodsServicesGoods.Ref.Partner = &Partner
		|	AND SalesOfGoodsServicesGoods.Ref.Date <= &ReturnDate
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	MAX(SaleAdjustment.Date) AS Date,
		|	SaleDocuments.Ref AS ImplementationReference
		|INTO AdjustmentData
		|FROM
		|	SaleDocuments AS SaleDocuments
		|		LEFT JOIN Document.SaleAdjustment AS SaleAdjustment
		|		ON (SaleAdjustment.DocumentBasis = SaleDocuments.Ref)
		|WHERE
		|	SaleAdjustment.Posted
		|	AND NOT SaleAdjustment.AdjustmentKind IN 
		|		(VALUE(Enum.BusinessTransactions.SaleOfOverdeliveredGoods), 
		|			VALUE(Enum.BusinessTransactions.ReturnOfUnderdeliveredGoods))
		|
		|GROUP BY
		|	SaleDocuments.Ref
		|
		|INDEX BY
		|	ImplementationReference
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	MAX(SaleAdjustment.Ref) AS Ref,
		|	MAX(SaleAdjustment.Ref.Date) AS Date,
		|	SaleAdjustment.Ref.DocumentBasis AS ImplementationReference
		|INTO LastAdjustmentData
		|FROM
		|	Document.SaleAdjustment AS SaleAdjustment
		|WHERE
		|	(SaleAdjustment.Ref.DocumentBasis, SaleAdjustment.Ref.Date) IN
		|			(SELECT
		|				AdjustmentData.ImplementationReference AS ImplementationReference,
		|				AdjustmentData.Date AS Date
		|			FROM
		|				AdjustmentData)
		|
		|GROUP BY
		|	SaleAdjustment.Ref.DocumentBasis
		|
		|INDEX BY
		|	Ref,
		|	ImplementationReference
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED DISTINCT
		|	CASE
		|		WHEN LastAdjustmentData.Ref IS NULL 
		|			THEN SaleDocuments.Ref
		|		ELSE LastAdjustmentData.Ref
		|	END AS Ref
		|INTO ReferencesToImplementations
		|FROM
		|	SaleDocuments AS SaleDocuments
		|		LEFT JOIN LastAdjustmentData AS LastAdjustmentData
		|		ON SaleDocuments.Ref = LastAdjustmentData.ImplementationReference
		|
		|INDEX BY
		|	Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT ALLOWED
		|	GoodsTable.Products AS Products,
		|	GoodsTable.Characteristic AS Characteristic,
		|	GoodsTable.Series AS Series,
		|	GoodsTable.Purpose AS Purpose,
		|	SUM(GoodsTable.NumberOfPackages) AS NumberOfPackages,
		|	SUM(GoodsTable.Count) AS Count,
		|	GoodsTable.Price,
		|	GoodsTable.Package,
		|	SUM(GoodsTable.Sum) AS Sum,
		|	SUM(GoodsTable.ManualDiscount) AS ManualDiscount,
		|	SUM(GoodsTable.DiscountMarkupAmount) AS DiscountMarkupAmount,
		|	GoodsTable.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
		|	GoodsTable.ImplementationDocumentCurrency AS ImplementationDocumentCurrency
		|INTO ImplementationData
		|FROM
		|	(SELECT 
		|	SaleAdjustmentGoods.Products AS Products,
		|	SaleAdjustmentGoods.Characteristic AS Characteristic,
		|	SaleAdjustmentGoods.Series AS Series,
		|	SaleAdjustmentGoods.Purpose AS Purpose,
		|	SaleAdjustmentGoods.NumberOfPackages,
		|	SaleAdjustmentGoods.Count,
		|	SaleAdjustmentGoods.Price,
		|	SaleAdjustmentGoods.Package,
		|	SaleAdjustmentGoods.Sum,
		|	0 AS ManualDiscount,
		|	0 AS DiscountMarkupAmount,
		|	SaleAdjustment.DocumentBasis AS DocumentSalesOfGoodsAndServices,
		|	CASE
		|		WHEN SaleAdjustment.DocumentBasis REFS Document.CustomerInvoice
		|			THEN CAST(SaleAdjustment.DocumentBasis AS Document.CustomerInvoice).Currency
		|		WHEN SaleAdjustment.DocumentBasis REFS Document.SourceDocument
		|			THEN CAST(SaleAdjustment.DocumentBasis AS Document.SourceDocument).Currency
		|		WHEN SaleAdjustment.DocumentBasis REFS Document.CustomerInvoiceServicesAndAssets
		|			THEN CAST(SaleAdjustment.DocumentBasis AS Document.CustomerInvoiceServicesAndAssets).Currency
		|		WHEN SaleAdjustment.DocumentBasis REFS Document.CustomerInvoiceServices
		|			THEN CAST(SaleAdjustment.DocumentBasis AS Document.CustomerInvoiceServices).Currency
		|		WHEN SaleAdjustment.DocumentBasis REFS Document.ReportToMaterialProvider2_5
		|			THEN CAST(SaleAdjustment.DocumentBasis AS Document.ReportToMaterialProvider2_5).Currency
		|	END AS ImplementationDocumentCurrency
		|FROM
		|	ReferencesToImplementations AS ReferencesToImplementations
		|		INNER JOIN Document.SaleAdjustment.Goods AS SaleAdjustmentGoods
		|		ON (SaleAdjustmentGoods.Ref = ReferencesToImplementations.Ref)
		|		INNER JOIN Document.SaleAdjustment AS SaleAdjustment
		|		ON (SaleAdjustment.Ref = ReferencesToImplementations.Ref)
		|
		|UNION ALL
		|
		|SELECT
		|	SalesOfGoodsServicesGoods.Products,
		|	SalesOfGoodsServicesGoods.Characteristic,
		|	SalesOfGoodsServicesGoods.Series,
		|	SalesOfGoodsServicesGoods.Purpose,
		|	SalesOfGoodsServicesGoods.NumberOfPackages,
		|	SalesOfGoodsServicesGoods.Count,
		|	CASE
