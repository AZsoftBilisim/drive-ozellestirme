// The Salesserver module contains procedures and functions for
// verifying the correctness of sales documents and for processing the entered data.
//
////////////////////////////////////////////////////////////////////////////////
//

#Region Public

// Defines a business return operation for a business sale operation
//
// Parameters:
//   EconomicOperationImplementation - EnumRef.BusinessTransactions - business operation of implementation.
//
// Returns:
//   EnumRef.BusinessTransactions - business operation of the refund.
//
Function GetRefundTransactionForSale(Val EconomicOperationImplementation) Export
	
	If EconomicOperationImplementation = Enums.BusinessTransactions.SaleToCustomer
	 Or Not ValueIsFilled(EconomicOperationImplementation) Then
		Return Enums.BusinessTransactions.ReturnOfGoodsFromCustomer;
	ElsIf EconomicOperationImplementation = Enums.BusinessTransactions.SaleWithDeferredTransferOfTitle Then
		Return Enums.BusinessTransactions.ReturnOfGoodsFromCustomer;
	ElsIf EconomicOperationImplementation = Enums.BusinessTransactions.TransferOfTitleToGoods Then
		Return Enums.BusinessTransactions.ReturnOfGoodsFromCustomer;
	ElsIf EconomicOperationImplementation = Enums.BusinessTransactions.TransferToCommissionAgent Then
		Return Enums.BusinessTransactions.ReturnFromCommissionAgent;
	ElsIf EconomicOperationImplementation = Enums.BusinessTransactions.TransferToStorageWithRightOfSale Then
		Return Enums.BusinessTransactions.ReturnFromCustodian;
	ElsIf EconomicOperationImplementation = Enums.BusinessTransactions.SalesViaCommissionAgent Then
		Return Enums.BusinessTransactions.ReturnOfGoodsViaCommissionAgent;
	ElsIf EconomicOperationImplementation = Enums.BusinessTransactions.SalesViaCommissionAgentGoodsInTransit Then
		Return Enums.BusinessTransactions.ReturnOfGoodsViaCommissionAgent;
	EndIf;
	
EndFunction

// Defines the business transaction of the agreement for the return business transaction.
//
// Parameters:
//   BusinessOperationRefund - EnumRef.BusinessTransactions - business operation of the refund.
//
// Returns:
//   EnumRef.BusinessTransactions - business transaction of the agreement.
//
Function GetBusinessTransactionOfRefundAgreement(Val BusinessOperationRefund) Export
	
	If BusinessOperationRefund = Enums.BusinessTransactions.ReturnOfGoodsFromCustomer 
		Or BusinessOperationRefund = Enums.BusinessTransactions.ReturnFromRetailCustomer
		Or Not ValueIsFilled(BusinessOperationRefund) Then
			Return Enums.BusinessTransactions.SaleToCustomer;
		ElsIf BusinessOperationRefund = Enums.BusinessTransactions.ReturnFromCommissionAgent Then
			Return Enums.BusinessTransactions.TransferToCommissionAgent;
		ElsIf BusinessOperationRefund = Enums.BusinessTransactions.ReturnOfGoodsViaCommissionAgent Then
			Return Enums.BusinessTransactions.SalesViaCommissionAgent;
		ElsIf BusinessOperationRefund = Enums.BusinessTransactions.ReturnFromCustodian Then
			Return Enums.BusinessTransactions.TransferToStorageWithRightOfSale;
	EndIf;
	
EndFunction

// Corrects lines that had not been issued a bill of lading or the shipment or there are discrepancies in measuring goods.
//
// Parameters:
// 		ParametersStructure - See OrdersServer.OrderLineAdjustmentStructure
//
// Returns:
// 		Structure - with properties:
// 		*	RowsCount - Number - Number of canceled / adjusted rows
// 		*	VarianceAmount - Number - The amount of increase in the order due to exceeding the shipment of measured goods.
//
Function AdjustOrderLines(ParametersStructure) Export
	
	NumberOfCanceledLines = 0;
	AdjustmentSum = 0;
	
	DocumentSales              = ParametersStructure.DocumentObject;
	CancellationReason                = ParametersStructure.CancellationReason;
	CancelUnprocessedLines = ParametersStructure.CancelUnprocessedLines;
	CorrectMeasuringGoods  = ParametersStructure.CorrectMeasuringGoods;
	GoodsTable                = DocumentSales[ParametersStructure.TabularSectionName];
	
	UseAllowableDeviationOfMeasuringGoodsShipmentReceiving =
		GetFunctionalOption("UseAllowableDeviationOfMeasuringGoodsShipmentReceiving");
	
	ReturnStructure = New Structure("RowsCount, AdjustmentSum",0,0);
	
	If UseAllowableDeviationOfMeasuringGoodsShipmentReceiving Then
		AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
			Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
		ReasonForCancellationOfMeasuredGoods =
			Catalogs.ReasonsForSaleOrderCancellation.VarianceOnDimensionalGoodsShipment;
	Else
		AllowableDeviationOfMeasuringGoodsShipmentAndReceiving = 0;
		CorrectMeasuringGoods = False;
	EndIf;
	
	If Not CorrectMeasuringGoods And Not CancelUnprocessedLines Then
		Return ReturnStructure;
	EndIf;
	
	PropertiesOfCanceledRow = New Structure("Canceled, CancellationReason, BatchesIndicationStatus", True, CancellationReason, 0);
	
	If Not ParametersStructure.CheckBalance And CancelUnprocessedLines Then
		For N1 = 0 To GoodsTable.Count() - 1 Do
			If Not GoodsTable[N1].Canceled Then
				FillPropertyValues(GoodsTable[N1], PropertiesOfCanceledRow);
				NumberOfCanceledLines = NumberOfCanceledLines + 1;
			EndIf;
		EndDo;
		ReturnStructure.RowsCount = NumberOfCanceledLines;
		Return ReturnStructure;
	EndIf;
	
	WarehouseInRows = (Type("DocumentRef.SalesOrder") = TypeOf(DocumentSales.Ref));
	OrderWarehouse   = Undefined;
	If Not WarehouseInRows Then
		OrderWarehouse = Common.ObjectAttributeValue(DocumentSales.Ref, "Warehouse");
	EndIf; 
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	CAST(GoodsTable.LineNumber AS NUMBER) AS LineNumber,
	|	CAST(GoodsTable.RowCode AS NUMBER) AS RowCode,
	|	CAST(GoodsTable.Products AS Catalog.Products) AS Products,
	|	CAST(GoodsTable.Characteristic AS Catalog.ItemsCharacteristics) AS Characteristic,
	|	CAST(GoodsTable.Series AS Catalog.ItemsBatches) AS Series,
	|	&OrderWarehouse AS Warehouse,
	|	CAST(GoodsTable.Package AS Catalog.PackagesAndUnitsOfMeasure) AS Package,
	|	CAST(GoodsTable.Count AS NUMBER) AS Count,
	|	CAST(GoodsTable.AmountIncludingVAT AS NUMBER) AS AmountIncludingVAT,
	|	CAST(GoodsTable.Canceled AS BOOLEAN) AS Canceled,
	|	CAST(GoodsTable.SupplyOption AS Enum.SupplyOptions) AS SupplyOption,
	|	CAST(GoodsTable.WithAssignment AS BOOLEAN) AS WithAssignment,
	|	&SalesOrder AS SalesOrder
	|INTO GoodsTable
	|FROM
	|	&GoodsTable AS GoodsTable
	|WHERE
	|	GoodsTable.Canceled = FALSE
	|
	|INDEX BY
	|	RowCode
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Turnovers.Products AS Products,
	|	Turnovers.Characteristic AS Characteristic,
	|	Turnovers.Warehouse AS Warehouse,
	|	Turnovers.Series AS Series,
	|	Turnovers.RowCode AS RowCode,
	|	SUM(Turnovers.QuantityToBeShippedTurnover -
	|		Turnovers.ShippedQuantityTurnover) AS ToShipClosingBalance,
	|	SUM(Turnovers.QuantityToBeShippedTurnover) AS ToShipReceipt,
	|	SUM(Turnovers.ShippedQuantityTurnover) AS ToShipExpense,
	|	SUM(Turnovers.ShippedAmountTurnover) AS SumExpense,
	|	SUM(Turnovers.AmountToBeShippedTurnover -
	|		Turnovers.ShippedAmountTurnover) AS SumClosingBalance
	|INTO TTCustomerOrdersBalancesTurnover
	|FROM
	|	#ShipmentOrdersTurnoverExpanded AS Turnovers
	|GROUP BY
	|	Turnovers.Products,
	|	Turnovers.Characteristic,
	|	Turnovers.Warehouse,
	|	Turnovers.Series,
	|	Turnovers.RowCode
	|HAVING
	|	SUM(Turnovers.QuantityToBeShippedTurnover -
	|		Turnovers.ShippedQuantityTurnover) <> 0
	|	OR SUM(Turnovers.QuantityToBeShippedTurnover) <> 0
	|	OR SUM(Turnovers.ShippedQuantityTurnover) <> 0
	|	OR SUM(Turnovers.ShippedAmountTurnover) <> 0
	|	OR SUM(Turnovers.AmountToBeShippedTurnover -
	|		Turnovers.ShippedAmountTurnover) <> 0
	|
	|INDEX BY
	|	Products,
	|	Characteristic,
	|	Warehouse,
	|	Series,
	|	RowCode
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsTable.Products                       AS Products,
	|	GoodsTable.Characteristic                     AS Characteristic,
	|	GoodsTable.Warehouse                              AS Warehouse,
	|	GoodsTable.Series                              AS Series,
	|	GoodsTable.Package                           AS Package,
	|	GoodsTable.RowCode                          AS RowCode,
	|	CASE WHEN GoodsTable.WithAssignment THEN
	|			GoodsTable.SalesOrder.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END                                            AS Purpose,
	|	SUM(GoodsTable.AmountIncludingVAT)                   AS AmountIncludingVAT,
	|	SUM(GoodsTable.Count)                  AS Count
	|INTO TTTableOfGoodsForInspection
	|FROM
	|	GoodsTable AS GoodsTable
	|WHERE
	|	NOT GoodsTable.SalesOrder.Status IN (VALUE(Enum.SalesOrderStatuses.NotApproved),
	|							VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.NotAgreedUpon),
	|							VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.ForReturn),
	|							VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.IsRejected))
	|	AND GoodsTable.SupplyOption = VALUE(Enum.SupplyOptions.Ship)
	|GROUP BY 
	|	GoodsTable.Products,
	|	GoodsTable.Characteristic,
	|	GoodsTable.Warehouse,
	|	GoodsTable.Series,
	|	GoodsTable.Package,
	|	GoodsTable.RowCode,
	|	CASE WHEN GoodsTable.WithAssignment THEN
	|			GoodsTable.SalesOrder.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END,
	|	GoodsTable.SalesOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsTable.Products                                         AS Products,
	|	GoodsTable.Characteristic                                       AS Characteristic,
	|	GoodsTable.Warehouse                                                AS Warehouse,
	|	GoodsTable.RowCode                                            AS RowCode,
	|	GoodsTable.Purpose                                           AS Purpose,
	|	ISNULL(&QueryTextPackagingFactor, 1)                      AS PackagingFactor,
	|	GoodsTable.Count                                           AS Count,
	|	GoodsTable.AmountIncludingVAT                                            AS AmountIncludingVAT,
	|	GoodsTable.Count - SalesOrdersBalance.ToShipExpense   AS ToRegisterBalance,
	|	SalesOrdersBalance.ToShipReceipt                              AS ToRegisterReceipt,
	|	SalesOrdersBalance.ToShipExpense                              AS ToRegisterExpense,
	|	GoodsTable.AmountIncludingVAT - SalesOrdersBalance.SumExpense        AS SumBalance,
	|	CASE WHEN GoodsTable.Count > SalesOrdersBalance.ToShipReceipt THEN
	|			GoodsTable.Count - SalesOrdersBalance.ToShipReceipt
	|		ELSE 0
	|	END                                                              AS QuantityInExcessOfIssued,
	|	SalesOrdersBalance.Series                                        AS Series,
	|	GoodsTable.Products.UnitOfMeasure                        AS BasicUnitOfMeasurement
	|INTO TTGoodsToCancel
	|FROM
	|	TTTableOfGoodsForInspection AS GoodsTable
	|		INNER JOIN TTCustomerOrdersBalancesTurnover AS SalesOrdersBalance
	|				ON GoodsTable.Products = SalesOrdersBalance.Products
	|				AND GoodsTable.Characteristic = SalesOrdersBalance.Characteristic
	|				AND GoodsTable.Warehouse = SalesOrdersBalance.Warehouse
	|				AND GoodsTable.Series = SalesOrdersBalance.Series
	|				AND GoodsTable.RowCode = SalesOrdersBalance.RowCode
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForCancellation.Products                       AS Products,
	|	GoodsForCancellation.Characteristic                     AS Characteristic,
	|	GoodsForCancellation.Warehouse                              AS Warehouse,
	|	CASE
	|		WHEN GoodsForCancellation.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
	|				AND &Date >= GoodsForCancellation.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue
	|			THEN TRUE
	|		ELSE FALSE
	|	END                     AS AdvancedWarehousingOnShipment,
	|	GoodsForCancellation.Series                              AS Series,
	|	GoodsForCancellation.RowCode                          AS RowCode,
	|	GoodsForCancellation.Purpose                         AS Purpose,
	|	GoodsForCancellation.BasicUnitOfMeasurement            AS BasicUnitOfMeasurement,
	|	SUM(GoodsForCancellation.Count)                  AS Count,
	|	SUM(GoodsForCancellation.AmountIncludingVAT)                   AS AmountIncludingVAT,
	|	SUM(GoodsForCancellation.ToRegisterBalance)          AS ToRegisterBalance,
	|	SUM(GoodsForCancellation.ToRegisterExpense)           AS Shipped,
	|	SUM(GoodsForCancellation.SumBalance)                AS SumBalance,
	|	SUM(GoodsForCancellation.QuantityInExcessOfIssued) AS QuantityInExcessOfIssued,
	|	CASE 
	|		WHEN GoodsForCancellation.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
	|			THEN SUM(GoodsForCancellation.ToRegisterReceipt * (&AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100))
	|		ELSE 0
	|	END AS AllowableVariance
	|	
	|FROM
	|	TTGoodsToCancel AS GoodsForCancellation
	|GROUP BY
	|	GoodsForCancellation.Products,
	|	GoodsForCancellation.Characteristic,
	|	GoodsForCancellation.Warehouse,
	|	GoodsForCancellation.Series,
	|	GoodsForCancellation.RowCode,
	|	GoodsForCancellation.Purpose,
	|	GoodsForCancellation.BasicUnitOfMeasurement,
	|	CASE
	|		WHEN GoodsForCancellation.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
	|				AND &Date >= GoodsForCancellation.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	GoodsTable.LineNumber AS LineNumber,
	|	GoodsTable.RowCode AS RowCode,
	|	GoodsTable.Count AS Count,
	|	0,
	|	0,
	|	0,
	|	UNDEFINED,
	|	GoodsTable.Products.UnitOfMeasure
	|FROM
	|	GoodsTable AS GoodsTable
	|WHERE
	|	GoodsTable.SalesOrder.Status IN (VALUE(Enum.SalesOrderStatuses.NotApproved),
	|							VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.NotAgreedUpon),
	|							VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.ForReturn),
	|							VALUE(Enum.StatusesOfRequestsForReturnOfGoodsFromCustomers.IsRejected))
	|	OR GoodsTable.SupplyOption <> VALUE(Enum.SupplyOptions.Ship)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Shipments.Products   AS Products,
	|	Shipments.Characteristic AS Characteristic,
	|	Shipments.Series          AS Series,
	|	Shipments.Purpose     AS Purpose,
	|	Shipments.Warehouse          AS Warehouse,
	|	CASE 
	|		WHEN NOT Shipments.AdvancedWarehousingOnShipment
	|			THEN Shipments.Issued_1
	|		ELSE Shipments.Shipped
	|	END                                AS Count,
	|	0                                    AS AllowableVariance
	|FROM (SELECT
	|		Shipments.Products     AS Products,
	|		Shipments.Characteristic   AS Characteristic,
	|		Shipments.Series            AS Series,
	|		Shipments.Purpose       AS Purpose,
	|		Shipments.Warehouse            AS Warehouse,
	|		CASE
	|			WHEN Shipments.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
	|					AND &Date >= Shipments.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue
	|				THEN TRUE
	|			ELSE FALSE
	|		END                     AS AdvancedWarehousingOnShipment,
	|		SUM(Shipments.Issued_1) AS Issued_1,
	|		CASE
	|			WHEN SUM(Shipments.ToShipmentInExcessOfOrder) >= SUM(Shipments.Shipped)
	|				THEN 0
	|			ELSE SUM(Shipments.Shipped) - SUM(Shipments.ToShipmentInExcessOfOrder)
	|		END AS Shipped
	|	FROM (SELECT
	|			Balance.Products                          AS Products,
	|			Balance.Characteristic                        AS Characteristic,
	|			Balance.Series                                 AS Series,
	|			Balance.Purpose                            AS Purpose,
	|			Balance.Warehouse                                 AS Warehouse,
	|			Balance.ToRegisterExpense                     AS Issued_1,
	|			- Balance.ToRegisterReceipt                   AS ToShipmentInExcessOfOrder,
	|			0                                             AS Shipped
	|		FROM
	|			TTGoodsToCancel AS Balance
	|		WHERE NOT Balance.Products.ItemsType IN(
	|				VALUE(Enum.ItemsTypes.OperationService),
	|				VALUE(Enum.ItemsTypes.Work_5))
	|		
	|		UNION ALL
	|		
	|		SELECT
	|			GoodsForIssueBalance.Products                                         AS Products,
	|			GoodsForIssueBalance.Characteristic                                       AS Characteristic,
	|			GoodsForIssueBalance.Series                                                AS Series,
	|			GoodsForIssueBalance.Purpose                                           AS Purpose,
	|			GoodsForIssueBalance.Warehouse                                                AS Warehouse,
	|			0                                                                           AS Issued_1,
	|			GoodsForIssueBalance.ToShipReceipt                                      AS ToShipmentInExcessOfOrder,
	|			GoodsForIssueBalance.ToShipExpense + GoodsForIssueBalance.AssembledReceipt
	|				+ GoodsForIssueBalance.AssemblyInProgressReceipt                               AS Shipped
	|		FROM
	|			AccumulationRegister.GoodsForIssue.BalanceAndTurnovers(,,,,
	|				DocumentShipments = &SalesOrder) AS GoodsForIssueBalance) AS Shipments
	|	GROUP BY
	|		Shipments.Products,
	|		Shipments.Characteristic,
	|		Shipments.Series,
	|		Shipments.Purpose,
	|		CASE
	|			WHEN Shipments.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
	|					AND &Date >= Shipments.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue
	|				THEN TRUE
	|			ELSE FALSE
	|		END,
	|		Shipments.Warehouse
	|		) AS Shipments
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsForIssue.Products   AS Products,
	|	GoodsForIssue.Characteristic AS Characteristic,
	|	GoodsForIssue.Series          AS Series,
	|	GoodsForIssue.Purpose     AS Purpose,
	|	GoodsForIssue.Warehouse          AS Warehouse,
	|	0,
	|	SUM(GoodsForIssue.ToRegisterReceipt * (&AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100))
	|FROM
	|	TTGoodsToCancel AS GoodsForIssue
	|WHERE
	|	GoodsForIssue.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
	|GROUP BY
	|	GoodsForIssue.Products,
	|	GoodsForIssue.Characteristic,
	|	GoodsForIssue.Series,
	|	GoodsForIssue.Purpose,
	|	GoodsForIssue.Warehouse
	|
	|UNION ALL
	|
	|SELECT
	|	SalesOrdersBalance.Products AS Products,
	|	SalesOrdersBalance.Characteristic AS Characteristic,
	|	SalesOrdersBalance.Series AS Series,
	|	SalesOrdersBalance.Purpose        AS Purpose,
	|	SalesOrdersBalance.Warehouse AS Warehouse,
	|	SalesOrdersBalance.ToRegisterExpense AS Count,
	|	0 AS AllowableVariance
	|FROM
	|	TTGoodsToCancel AS SalesOrdersBalance
	|WHERE
	|	SalesOrdersBalance.Products.ItemsType IN(
	|				VALUE(Enum.ItemsTypes.OperationService),
	|				VALUE(Enum.ItemsTypes.Work_5))";
		
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.BeginOfPeriod = "&InitialCustomerOrders";
	TableFormationParameters.EndOfPeriod = "&ConPeriodCustomerOrders";
	TableFormationParameters.ConditionText =
		"ReferenceOrder = &SalesOrder
		|		AND RowCode <> 0";
	TableFormationParameters.Group = "Products, Characteristic, Warehouse, Series, RowCode";
	TableFormationParameters.Indicators = "ToShip, Shipped";
	TableFormationParameters.Resources = "Count, Sum";
	
	ShipmentOrdersTurnoverExpanded =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	Query.Text = StrReplace(Query.Text,
		"#ShipmentOrdersTurnoverExpanded",
		ShipmentOrdersTurnoverExpanded);
	
	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"GoodsTable.Package",
		"GoodsTable.Products"));
		
	Query.SetParameter("SalesOrder", DocumentSales.Ref);
	Query.SetParameter("Date", DocumentSales.Date);
	
	If WarehouseInRows Then
		Query.SetParameter("GoodsTable",
			GoodsTable.Unload(,"LineNumber, RowCode, Products, Characteristic,
			| Series, Warehouse, Package, Count, AmountIncludingVAT, Canceled, SupplyOption, WithAssignment"));
		Query.Text = StrReplace(Query.Text,"&OrderWarehouse","CAST(GoodsTable.Warehouse AS Catalog.Warehouses)");
	Else
		Query.SetParameter("GoodsTable",
			GoodsTable.Unload(,"LineNumber, RowCode, Products, Characteristic,
				| Series, Package, Count, AmountIncludingVAT, Canceled, SupplyOption, WithAssignment"));
		Query.SetParameter("OrderWarehouse", OrderWarehouse);
	EndIf;
	
	Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving", AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
	Query.SetParameter("DimensionalTypesOfUnits", Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
	
	SpeedLimits = TMCommonUse.BoundariesOfRegisterTurns("GoodsForIssue",
																"DocumentShipments = &SalesOrder",
																Query.Parameters);
	
	Query.SetParameter("InitialGoodsForShipment", SpeedLimits.MinDate);
	Query.SetParameter("ConPeriodGoodsReadyForShipment", SpeedLimits.MaxDate);
	
	SpeedLimits = TMCommonUse.BoundariesOfRegisterTurns("ShipmentAndReturnReferences",
																"ReferenceOrder = &SalesOrder",
																Query.Parameters);
	
	Query.SetParameter("InitialCustomerOrders", SpeedLimits.MinDate);
	Query.SetParameter("ConPeriodCustomerOrders", SpeedLimits.MaxDate);
	
	SetPrivilegedMode(True);
	ResultsPackage = Query.ExecuteBatch();
	SetPrivilegedMode(False);
	If ResultsPackage[3].IsEmpty() Then
		Return ReturnStructure;
	EndIf;
	
	Selection  = ResultsPackage[4].Select();
	SelectingCancellationsWithoutChecks  = ResultsPackage[5].Select();
	ShippedGoods_ = ResultsPackage[6].Unload(); // ValueTable
	ShippedGoods_.GroupBy("Products, Characteristic, Series, Purpose, Warehouse","Count, AllowableVariance");
	ShippedGoods_.Indexes.Add("Products, Characteristic, Series, Purpose");
	
	// Canceling lines
	
	While SelectingCancellationsWithoutChecks.Next() Do
		
		String = GoodsTable[SelectingCancellationsWithoutChecks.LineNumber-1];
			
		FillPropertyValues(String, PropertiesOfCanceledRow);
		NumberOfCanceledLines = NumberOfCanceledLines + 1;
			
		Continue;
			
	EndDo;
	
	RowsToProcess = New Array;
	ProcessedRowsAmountBeforeAdjustment = New Map;
	
	StructureOfRecalculationOfAmount = BatchProcessingOfTablePartClientServer.ParametersForConvertingAmountOfNDSVToTS(DocumentSales);
	StructureOfActions = New Structure;
	StructureOfActions.Insert("RecalculateNumberOfUnits");
	StructureOfActions.Insert("RecalculateVATAmount", StructureOfRecalculationOfAmount);
	StructureOfActions.Insert("RecalculateAmountWithVAT", StructureOfRecalculationOfAmount);
	StructureOfActions.Insert("RecalculateAmount");
	StructureOfActions.Insert("RecalculateAmountOfManualDiscount");
	StructureOfActions.Insert("RecalculateAmountOfAutomaticDiscount");
	StructureOfActions.Insert("RecalculateAmountTakingIntoAccountManualDiscount", New Structure("Clear", False));
	StructureOfActions.Insert("RecalculateAmountTakingIntoAccountAutomaticDiscount", New Structure("Clear", False));
	
	While Selection.Next() Do
		
	    SearchParameters = New Structure;
		SearchParameters.Insert("Products", Selection.Products);
		SearchParameters.Insert("Characteristic", Selection.Characteristic);
		SearchParameters.Insert("Series", Selection.Series);
		SearchParameters.Insert("Purpose", Selection.Purpose);

		If WarehouseInRows Then
			SearchParameters.Insert("Warehouse", Selection.Warehouse);
		EndIf;
			
		ShippedQuantity_ = 0;
		AllowableVariance  = 0;
		ShippedLine     = Undefined;
		
		FoundRows = ShippedGoods_.FindRows(SearchParameters);
		If FoundRows.Count() > 0 Then
			ShippedLine = FoundRows[0];
			If Selection.AdvancedWarehousingOnShipment Then
				ShippedQuantity_ = ShippedLine.Count;
				AllowableVariance = ShippedLine.AllowableVariance;
			Else
				ShippedQuantity_ = Selection.Shipped;
				AllowableVariance = Selection.AllowableVariance;
			EndIf;
		EndIf;
		
		If Selection.Count > ShippedQuantity_ Then
			CancelQuantity = Min(Selection.ToRegisterBalance, Selection.Count - ShippedQuantity_);
			If ShippedLine <> Undefined Then
				If ShippedLine.Count > (Selection.Count - Selection.QuantityInExcessOfIssued - Selection.ToRegisterBalance) Then
					ShippedLine.Count = ShippedLine.Count - (Selection.Count - Selection.QuantityInExcessOfIssued - Selection.ToRegisterBalance);
				Else
					ShippedLine.Count = 0;
				EndIf;
			EndIf;
		Else
			ShippedLine.Count = ShippedLine.Count - Selection.Count;
			CancelQuantity = Selection.ToRegisterBalance;
		EndIf;
		CancelAmount = Selection.AmountIncludingVAT / Selection.Count * CancelQuantity;
		
		If CancelQuantity > 0 And CancelQuantity <= AllowableVariance Then
			CurReasonForCancellation = ReasonForCancellationOfMeasuredGoods;
			DeviationWithinDelta = True;
			ShippedLine.AllowableVariance = ShippedLine.AllowableVariance - CancelQuantity;
		Else
			CurReasonForCancellation = CancellationReason;
			DeviationWithinDelta = False;
		EndIf;
		
		If (Not CancelUnprocessedLines And Not DeviationWithinDelta)Then
			CancelQuantity = 0;
		EndIf;
		
		SearchParameters.Delete("Purpose");
		SearchParameters.Insert("Canceled", False);
		SearchParameters.Insert("RowCode", Selection.RowCode);
		
		OrderLines_ = GoodsTable.FindRows(SearchParameters);
		
		SumOfRows = 0;
		For Each Page1 In OrderLines_ Do
			SumOfRows = SumOfRows + Page1.AmountIncludingVAT;
		EndDo;
		
		For Cnt = 0 To OrderLines_.Count()-1 Do
			
			String = OrderLines_[Cnt];
			
			If CancelQuantity = 0 Then
				Break;
			EndIf;
			
			RowCoefficient = String.AmountIncludingVAT / ?(SumOfRows=0,1,SumOfRows);
			
			AmountBeforeAdjustment = String.AmountIncludingVAT;
			
			CancelInCur = ?(Cnt = OrderLines_.Count()-1, CancelQuantity, CancelQuantity * RowCoefficient);
			CurOfSaleAmount = ?(Cnt = OrderLines_.Count()-1, CancelAmount, CancelAmount * RowCoefficient);
			CancelQuantity = CancelQuantity - CancelInCur;
			CancelAmount = CancelAmount - CurOfSaleAmount;
			
			If CancelInCur >= String.Count Then
				
				FillPropertyValues(String, PropertiesOfCanceledRow);
				String.CancellationReason = CurReasonForCancellation;
				
				AdjustmentSum = AdjustmentSum - String.AmountIncludingVAT;
				
			ElsIf CancelInCur > 0 Then
				
				PackagingFactor = String.Count / String.NumberOfPackages;
				
				NewRow = GoodsTable.Add();
				FillPropertyValues(NewRow, String);
				FillPropertyValues(NewRow, PropertiesOfCanceledRow);
				
				NewRow.CancellationReason = CurReasonForCancellation;
				
				NewRow.RowCode = 0;
				
				NewRow.Count         = CancelInCur;
				NewRow.NumberOfPackages = CancelInCur / PackagingFactor;
				NewRow.AmountIncludingVAT          = CurOfSaleAmount;
				
				String.Count         = String.Count - CancelInCur;
				String.NumberOfPackages = String.NumberOfPackages - NewRow.NumberOfPackages;
				String.AmountIncludingVAT          = String.AmountIncludingVAT - CurOfSaleAmount;
				
				CachedValues = Undefined;
				
				RowsToProcess.Add(String);
				RowsToProcess.Add(NewRow);
				ProcessedRowsAmountBeforeAdjustment.Insert(String, AmountBeforeAdjustment);
				
			Else
				
				Continue;
				
			EndIf;
			
			NumberOfCanceledLines = NumberOfCanceledLines + 1;
			
		EndDo;
		
	EndDo;
	
	BatchProcessingOfTablePartServer.ProcessTSStrings(
		RowsToProcess,
		StructureOfActions,
		GoodsTable,
		CachedValues);
		
	// We calculate the correction sum after recalculating the SUMSNDS in batch processing 
	For Each String In RowsToProcess Do
		AmountBeforeAdjustment = ProcessedRowsAmountBeforeAdjustment.Get(String);
		If AmountBeforeAdjustment <> Undefined Then
			AdjustmentSum = AdjustmentSum - (AmountBeforeAdjustment - String.AmountIncludingVAT);
		EndIf;
	EndDo;
	
	// We adjust in plus
	
	If CorrectMeasuringGoods Then
		
		RowsToProcess = New Array;
		ProcessedRowsAmountBeforeAdjustment = New Map;
		
		StructureOfActions = New Structure;
		StructureOfActions.Insert("RecalculateAmountOfManualDiscount");
		StructureOfActions.Insert("RecalculateAmountOfAutomaticDiscount");
		
		Selection.Reset();
		
		While Selection.Next() Do
			
			If WarehouseInRows Then
				SearchParameters = New Structure("Products, Characteristic, Series, Purpose, Warehouse, ");
				SearchParameters.Warehouse = ?(WarehouseInRows, Selection.Warehouse, OrderWarehouse);
			Else
				SearchParameters = New Structure("Products, Characteristic, Series, Purpose");
			EndIf;
			
			FillPropertyValues(SearchParameters,Selection);
			
			FoundRows = ShippedGoods_.FindRows(SearchParameters);
			If FoundRows.Count() > 0 
				And FoundRows[0].Count > 0 Then
				ShippedLine = FoundRows[0];
				ShippedOverLine = ShippedLine.Count;
			Else
				Continue;
			EndIf;
			
			If Selection.ToRegisterBalance < 0 And ShippedOverLine > 0 Then
				
				QuantityReissued = -Selection.ToRegisterBalance;
				AmountReissued = -Selection.SumBalance;
				
				If QuantityReissued >= ShippedOverLine Then
					ShippedLine.Count = 0;
					QuantityAdd = ShippedOverLine;
					AddAmount_ = ?(QuantityReissued * AmountReissued > 0, Round(QuantityAdd / QuantityReissued * AmountReissued, 2), 0);
				Else
					ShippedLine.Count = ShippedLine.Count - QuantityReissued;
					QuantityAdd = QuantityReissued;
					AddAmount_ = AmountReissued;
				EndIf;
				
				SearchParameters.Delete("Purpose");
				SearchParameters.Insert("Canceled", False);
				SearchParameters.Insert("RowCode", Selection.RowCode);
				
				OrderLines_ = GoodsTable.FindRows(SearchParameters);
				
				If OrderLines_.Count() > 0 Then
					
					SumOfRows = 0;
					For Each Page1 In OrderLines_ Do
						SumOfRows = SumOfRows + Page1.AmountIncludingVAT;
					EndDo;
					
					For Cnt = 0 To OrderLines_.Count()-1 Do
						String = OrderLines_[Cnt];
						
						RowCoefficient = String.AmountIncludingVAT / SumOfRows;
						
						PackagingFactor = String.Count / String.NumberOfPackages;
						
						AddToCur = ?(Cnt = OrderLines_.Count()-1, QuantityAdd, QuantityAdd * RowCoefficient);
						AmountAddToCur = ?(Cnt = OrderLines_.Count()-1, AddAmount_, AddAmount_ * RowCoefficient);
						QuantityAdd = QuantityAdd - AddToCur;
						AddAmount_ = AddAmount_ - AmountAddToCur;
						
						AmountBeforeAdjustment = String.AmountIncludingVAT;
						QuantityBeforeAdjustment = String.Count;
						
						String.Count         = String.Count + AddToCur;
						String.AmountIncludingVAT          = String.AmountIncludingVAT  + AmountAddToCur;
						
						String.VATAmount           = String.VATAmount/QuantityBeforeAdjustment * String.Count;
						String.Sum              = ?(DocumentSales.PriceIncludesVAT, String.AmountIncludingVAT, String.AmountIncludingVAT-String.VATAmount);
						
						String.NumberOfPackages = String.Count / PackagingFactor;
						
						StructureOfRecalculationOfAmount = New Structure;
						StructureOfRecalculationOfAmount.Insert("PriceIncludesVAT", DocumentSales.PriceIncludesVAT);
						
						// If there is a remainder left in the packages when recalculating, add the line
						
						If String.NumberOfPackages * PackagingFactor > String.Count Then
							
							SumOfNewLine      = String.Sum/String.NumberOfPackages ;
							NewLineVATAmount   = String.VATAmount/String.NumberOfPackages ;
							SumWithVATOfNewLine  = String.AmountIncludingVAT/String.NumberOfPackages ;
							NumberOfNewLine = String.NumberOfPackages * PackagingFactor - String.Count + PackagingFactor;
							
							String.NumberOfPackages = String.NumberOfPackages - 1;
							String.Count = String.NumberOfPackages * PackagingFactor;
							
							String.VATAmount = String.VATAmount - NewLineVATAmount;
							String.Sum = String.Sum - SumOfNewLine;
							String.AmountIncludingVAT = String.AmountIncludingVAT - SumWithVATOfNewLine;
							
						ElsIf String.NumberOfPackages * PackagingFactor < String.Count Then
							
							NumberOfNewLine = String.Count - String.NumberOfPackages * PackagingFactor;
							
							SumOfNewLine      = String.Sum/String.Count * NumberOfNewLine;
							NewLineVATAmount   = String.VATAmount/String.Count * NumberOfNewLine;
							SumWithVATOfNewLine  = String.AmountIncludingVAT/String.Count * NumberOfNewLine;
							
							String.Count = String.NumberOfPackages * PackagingFactor;
							String.VATAmount   = String.VATAmount - NewLineVATAmount;
							String.Sum      = String.Sum - SumOfNewLine;
							String.AmountIncludingVAT  = String.AmountIncludingVAT - SumWithVATOfNewLine;
							
						Else
							
							NumberOfNewLine = 0;
							
						EndIf;
						
						RowsToProcess.Add(String);
						
						If NumberOfNewLine > 0 Then
							NwRw = GoodsTable.Add();
							FillPropertyValues(NwRw,String);
							NwRw.RowCode = 0;
							NwRw.Count = NumberOfNewLine;
							NwRw.NumberOfPackages = NumberOfNewLine;
							NwRw.Package = Selection.BasicUnitOfMeasurement;
							
							NwRw.Price = String.Price / PackagingFactor;
							NwRw.Sum = SumOfNewLine;
							NwRw.VATAmount = NewLineVATAmount;
							NwRw.AmountIncludingVAT = SumWithVATOfNewLine;
							
							RowsToProcess.Add(NwRw);
							
							AdjustmentSum = AdjustmentSum + NwRw.AmountIncludingVAT;
						EndIf;
						
						ProcessedRowsAmountBeforeAdjustment.Insert(String, AmountBeforeAdjustment);
						
					EndDo;
				EndIf;
				
			EndIf;
			
		EndDo;
		
		BatchProcessingOfTablePartServer.ProcessTSStrings(
			RowsToProcess,
			StructureOfActions,
			GoodsTable,
			Undefined);
		
		// We calculate the correction sum after recalculating the SUMSNDS in batch processing 
		For Each String In RowsToProcess Do
			AmountBeforeAdjustment = ProcessedRowsAmountBeforeAdjustment.Get(String);
			If AmountBeforeAdjustment <> Undefined Then
				AdjustmentSum = AdjustmentSum + (String.AmountIncludingVAT - AmountBeforeAdjustment);
			EndIf;
		EndDo;
		
	EndIf;
	
	ReturnStructure.RowsCount    = NumberOfCanceledLines;
	ReturnStructure.AdjustmentSum = ?(AdjustmentSum < 0, 0, AdjustmentSum);
	
	Return ReturnStructure;
	
EndFunction

// Defines the name of the table part for the document.
//
// Parameters:
//   TableName - String - document name.
//
// Returns:
//   String - The name of the tabular part of the document.
//
Function GetNameOfTablePart(TableName) Export
	
	If TableName = "Document.RequestForReturnOfGoodsFromCustomer" Then
		TSName = "SubstituteGoods";
	ElsIf TableName = "Document.CustomerInvoiceServices" Then
		TSName = "Services";
	ElsIf TableName = "Document.ReportToMaterialProvider2_5" Then
		TSName = "ManufacturedProduct";
	Else
		TSName = "Goods";
	EndIf;
	
	Return TSName;
	
EndFunction

