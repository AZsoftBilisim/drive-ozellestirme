// The procedure converts the document amount to a new currency.
//
// Parameters:
// Object           - FormDataStructure - Current document
// OldCurrency     - CatalogRef.Currencies - The source currency
// NewCurrency      - CatalogRef.Currencies - New currency
// ThereIsSaleAmount - Boolean - indicates whether the total Sales column is present in the table part
// ThereIsVATSaleAmount - Boolean - indicates whether the total sales column Is present in the table part.
//
Procedure ConvertDocumentAmountToCurrency(Object, Val OldCurrency, Val NewCurrency, Val ThereIsSaleAmount = True, Val ThereIsVATSaleAmount = False) Export

	StructureOfOldCurrencyRates = ProcessingOfExchangeRatesTM.GetCurrencyRate(OldCurrency, Object.Date);
	StructureOfNewCurrencyRates  = ProcessingOfExchangeRatesTM.GetCurrencyRate(NewCurrency, Object.Date);
	
	TotalAmount_5 = Object.Goods.Total("Sum");
	If ThereIsSaleAmount Then
		TotalSalesAmount = Object.Goods.Total("SalesAmount");
	Else
		TotalSalesAmount = 0;
	EndIf;
	
	NewAmount = ProcessingOfExchangeRatesTM.ConvertAtRate(
		TotalAmount_5,
		StructureOfOldCurrencyRates,
		StructureOfNewCurrencyRates);
	
	NewSaleAmount = ProcessingOfExchangeRatesTM.ConvertAtRate(
		TotalSalesAmount,
		StructureOfOldCurrencyRates,
		StructureOfNewCurrencyRates);
	
	If TotalAmount_5 <> 0 Or TotalSalesAmount <> 0 Then
	
		For Each TableRow In Object.Goods Do
			
			If TotalAmount_5 <> 0 Then
				TableRow.Sum = Round(NewAmount * TableRow.Sum / TotalAmount_5, 2, 1);
				TableRow.Price = ?(TableRow.NumberOfPackages <> 0, Round(TableRow.Sum / TableRow.NumberOfPackages, 2, 1), 0);
				TableRow.VATAmount = PriceManagementSystemClientServer.CalculateVATAmount(TableRow.Sum, TableRow.VATRate, Object.PriceIncludesVAT);
				TableRow.AmountIncludingVAT = TableRow.Sum + ?(Object.PriceIncludesVAT, 0, TableRow.VATAmount);
			EndIf;
			
			If TotalSalesAmount <> 0 Then
				TableRow.SalesAmount = Round(NewSaleAmount * TableRow.SalesAmount / TotalSalesAmount, 2, 1);
				TableRow.SellingPrice = ?(TableRow.NumberOfPackages <> 0, Round(TableRow.SalesAmount / TableRow.NumberOfPackages, 2, 1), 0);
				TableRow.CommissionAmount = 0;
				If ThereIsVATSaleAmount Then
					TableRow.AmountSalesVAT = PriceManagementSystemClientServer.CalculateVATAmount(TableRow.SalesAmount, TableRow.VATRate, True);
				EndIf;
			EndIf;
			
		EndDo;
		
		If Object.Property("CommissionAmount") Then
			Object.CommissionAmount = 0;
			Object.AmountVATRemuneration = 0;
		EndIf;
		
	EndIf;
	
	If Object.Property("PaymentScheduleSteps") Then
		
		TotalAmountOfPaymentStages = Object.PaymentScheduleSteps.Total("PaymentAmount");
		If TotalAmountOfPaymentStages <> 0 Then
			
			For Each TableRow In Object.PaymentScheduleSteps Do
				TableRow.PaymentAmount = Round(NewSaleAmount * TableRow.PaymentAmount / TotalAmountOfPaymentStages, 2, 1);
			EndDo;
			
		EndIf;
		
	EndIf;
	
EndProcedure

// The procedure converts the document amount to a new currency.
//
// Parameters:
// DocumentObject - FormDataStructure - a document where you need to fill in the amount of the advance and prepayment.
//
Procedure FillInAdvancePrepaymentAmounts(DocumentObject) Export
	
	StepsTable = DocumentObject.PaymentScheduleSteps.Unload();
	If StepsTable.Columns.Find("PackageDepositValue") = Undefined Then
		StepsTable.Columns.Add("PackageDepositValue", TMCommonUse.MoneyFieldTypeDescription());
	EndIf;
	StepsTable.GroupBy("PaymentOption", "PaymentAmount,PackageDepositValue");
	
	AdvanceLineBeforeCollateral = StepsTable.Find(Enums.CustomerPaymentControlOptions.PrepaymentBeforeProvision, "PaymentOption");
	
	If AdvanceLineBeforeCollateral = Undefined Then
		
		DocumentObject.AmountPrepaymentBeforeGoodsIssue = 0;
		
	Else
		
		DocumentObject.AmountPrepaymentBeforeGoodsIssue = AdvanceLineBeforeCollateral.PaymentAmount + AdvanceLineBeforeCollateral.PackageDepositValue;
		
	EndIf;
	
	PrepaymentLineBeforeShipment = StepsTable.Find(Enums.CustomerPaymentControlOptions.PrepaymentBeforeShipment, "PaymentOption");
	
	If PrepaymentLineBeforeShipment = Undefined Then
		
		DocumentObject.AmountOfPrepaymentBeforeShipment = 0;
		
	Else
		
		DocumentObject.AmountOfPrepaymentBeforeShipment = PrepaymentLineBeforeShipment.PaymentAmount + PrepaymentLineBeforeShipment.PackageDepositValue;
		
	EndIf;

EndProcedure

