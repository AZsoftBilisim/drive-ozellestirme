						|ru = 'Количество этапов оплаты в индивидуальном соглашении (%NumberOfStagesOfAgreement%) должно совпадать с количеством этапов в типовом соглашении (%NumberOfFoundationAgreementStages%)';
						|en = 'Number of payment milestones in the individual agreement (%NumberOfStagesOfAgreement%) should be the same as in the standard agreement (%NumberOfFoundationAgreementStages%)'; fa = 'Number of payment milestones in the individual agreement (%NumberOfStagesOfAgreement%) should be the same as in the standard agreement (%NumberOfFoundationAgreementStages%)';
						|it = 'Il numero di fasi del pagamento nell''accordo individuale (%NumberOfStagesOfAgreement%) deve coincidere con il numero di fasi del modello di accordo (%NumberOfFoundationAgreementStages%)';
						|pl = 'Ilość etapów płatności w pojedynczej umowie (%NumberOfStagesOfAgreement%) musi pokrywać się z ilością etapów standardowej umowy (%NumberOfFoundationAgreementStages%)';
						|tr = 'Özelleştirilmiş anlaşmadaki ödeme aşamalarının sayısı (%NumberOfStagesOfAgreement%) standart anlaşmadaki aşama sayısıyla (%NumberOfFoundationAgreementStages%) eşleşmelidir'");
		ErrorText = StrReplace(ErrorText, "%NumberOfStagesOfAgreement%", Selection.NumberOfStagesOfAgreement);
		ErrorText = StrReplace(ErrorText, "%NumberOfFoundationAgreementStages%",   Selection.NumberOfFoundationAgreementStages);
		
		If OutputToReport Then
			Reports.VariancesFromSalesTermsAndConditions.AddHeaderDeviationToArrayOfDeviations(NStr("vi = 'Các giai đoạn thanh toán';
																									|ru = 'Этапы оплаты';
																									|en = 'Payment milestones'; fa = 'مراحل پرداخت';
																									|it = 'Fasi del pagamento';
																									|pl = 'Etapy płatności';
																									|tr = 'Ödeme aşamaları'"), ErrorText, ArrayOfDeviations);
		Else
			ReportErrorToUser(
				ErrorText,
				DocumentSales,
				"TransferToPaymentCommand",
				Cancel);
		EndIf;
	EndIf;

EndProcedure

// Displays error messages about the correctness of filling in the payment schedule stages
//
// Parameters:
// Selection          - QueryResultSelection - sampling from the query result
// DocumentSales  - DocumentObject - The object for which you want to show error messages
// Cancel            - Boolean - Flag for refusing to carry out the document
// DeviationTree  - ValueTree - A tree with deviations of the table part from the sales conditions.
//
Procedure ReportErrorsCorrectnessOfPaymentStagesInAgreement(Val Selection,
	                                                          Val DocumentSales,
	                                                          Cancel,
	                                                          DeviationTree = Undefined)

	InterestAmount = 0;
	AmountOfTemplateSInterest = 0;
	AmountOfCollateralInterest = 0;
	AmountOfTemplateSCollateralInterest = 0;
	OutputToReport = (DeviationTree <> Undefined);
	
	While Selection.Next() Do
		LineNumber = Selection.LineNumber;
		If Selection.TemplateStageIsMissing Then
			Continue;
		EndIf;
		
		ErrorAddress = " " + NStr("vi = 'trong dòng %LineNumber% của danh sách các bước thanh toán';
									|ru = 'в строке %LineNumber% списка ""Этапы оплаты""';
									|en = 'in line %LineNumber% of the ""Payment milestones"" list'; fa = 'in line %LineNumber% of the ""Payment milestones"" list';
									|it = 'nella riga  %LineNumber% dell''elenco ""Fasi di pagamento""';
									|pl = 'w wierszu %LineNumber% listy ""Этапы оплаты""';
									|tr = '""Ödeme Aşamaları"" listesinin %LineNumber% satırında'");
		ErrorAddress = StrReplace(ErrorAddress, "%LineNumber%", LineNumber);

		If Selection.ThereAreErrorsInFillingOutPaymentOption Then

			ErrorText = NStr("vi = 'Phương án thanh toán khác với giá trị trong lịch thanh toán ""%TemplatePaymentOption%""';
							|ru = 'Вариант оплаты отличается от значения в графике оплаты ""%TemplatePaymentOption%""';
							|en = 'Payment terms differ from terms in schedule %TemplatePaymentOption%'; fa = 'Payment terms differ from terms in schedule %TemplatePaymentOption%';
							|it = 'La variante di pagamento differisce dal valore nel grafico di pagamento ""%TemplatePaymentOption%""';
							|pl = 'Wariant płatności różni się od wartości w harmonogramie płatności ""%TemplatePaymentOption%""';
							|tr = 'Ödeme seçeneği, ""%TemplatePaymentOption%"" ödeme planındaki değerden farklı'");
			ErrorText = StrReplace(ErrorText, "%TemplatePaymentOption%", Selection.TemplatePaymentOption); 
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PaymentOption", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"TransferToPaymentCommand",
					Cancel);
			EndIf;
		EndIf;
		
		If Selection.TemplateShift < Selection.Move Then

			ErrorText = NStr("vi = 'Thời hạn không được nhiều hơn trong thỏa thuận tiêu chuẩn ""%TemplateShift%""';
							|ru = 'Срок должен быть не больше, чем в типовом соглашении ""%TemplateShift%""';
							|en = 'Period cannot be greater than in the ""%TemplateShift%"" standard agreement'; fa = 'Period cannot be greater than in the ""%TemplateShift%"" standard agreement';
							|it = 'Il termine non deve essere successivo a quanto indicato nel modello di accordo ""%TemplateShift%""';
							|pl = 'Termin nie powinien być dłuższy niż standardowa umowa ""%TemplateShift%""';
							|tr = 'Terim, ""%TemplateShift%"" standart sözleşmede olandan daha fazla olmamalıdır'");
			ErrorText = StrReplace(ErrorText, "%TemplateShift%", Selection.TemplateShift); 
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "Move", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"TransferToPaymentCommand",
					Cancel);
			EndIf;
		EndIf;
		
		// Checking for payment percentage deviations
		InterestAmount = InterestAmount + Selection.PaymentPercentage;
		AmountOfTemplateSInterest = AmountOfTemplateSInterest + Selection.TemplatePaymentPercentage;
		If InterestAmount < AmountOfTemplateSInterest Then
			
			ErrorText = NStr("vi = 'Tiền lãi cho đến lần thanh toán tiếp theo theo lịch biểu (""%PaymentPercentage%%"") không được thấp hơn lãi suất theo thỏa thuận (""%TemplatePaymentPercentage%%"")';
							|ru = 'Проценты до следующего платежа по графику (""%PaymentPercentage%%"") не должны быть меньше процентов по соглашению (""%TemplatePaymentPercentage%%"")';
							|en = 'Interest before the next payment on schedule (""%PaymentPercentage%%"") cannot be less than the interest under the agreement (""%TemplatePaymentPercentage%%"")'; fa = 'Interest before the next payment on schedule (""%PaymentPercentage%%"") cannot be less than the interest under the agreement (""%TemplatePaymentPercentage%%"")';
							|it = 'Gli interessi fino al prossimo pagamento in base al calendario (""%PaymentPercentage%%"") non devono essere inferiori agli interessi previsti dall''accordo (""%TemplatePaymentPercentage%%"")';
							|pl = 'Odsetki do następnej płatności zgodnie z harmonogramem (""%PaymentPercentage%%"") nie mogą być niższe niż odsetki wg umowy (""%TemplatePaymentPercentage%%"")';
							|tr = 'Plana göre bir sonraki ödemeye kadar olan faiz (""%PaymentPercentage%%""), anlaşma kapsamındaki faizden (""%TemplatePaymentPercentage%%"") az olmamalıdır'");
			ErrorText = StrReplace(ErrorText, "%PaymentPercentage%", InterestAmount);
			ErrorText = StrReplace(ErrorText, "%TemplatePaymentPercentage%", AmountOfTemplateSInterest);
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PaymentPercentage", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"TransferToPaymentCommand",
					Cancel);
			EndIf;
		EndIf;
		
		AmountOfCollateralInterest = AmountOfCollateralInterest + Selection.PackageDepositPercentage;
		AmountOfTemplateSCollateralInterest = AmountOfTemplateSCollateralInterest + Selection.PercentageOfDepositForContainerOfTemplate;
		If AmountOfCollateralInterest < AmountOfTemplateSCollateralInterest Then
			
			ErrorText = NStr("vi = 'Tỷ lệ phần trăm thế chấp bao bì đến lần thanh toán tiếp theo theo lịch biểu (""%PackageDepositPercentage%%"") không được thấp hơn tỷ lệ phần trăm của thỏa thuận (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|ru = 'Проценты залога за тару до следующего платежа по графику (""%PackageDepositPercentage%%"") не должны быть меньше процентов по соглашению (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|en = 'Packaging deposit interest accrued until the next scheduled payment (""%PackageDepositPercentage%%"") cannot be less than the interest accrued under the agreement (""%PercentageOfDepositForContainerOfTemplate%%"")'; fa = 'Packaging deposit interest accrued until the next scheduled payment (""%PackageDepositPercentage%%"") cannot be less than the interest accrued under the agreement (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|it = 'Gli interessi del cauzione per l''imballaggio fino al prossimo pagamento previsto dal calendario (""%PackageDepositPercentage%%"") non devono essere inferiori agli interessi previsti dall''accordo (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|pl = 'Oprocentowanie marży za opakowanie do następnej płatności w harmonogramie (""%PackageDepositPercentage%%"") nie może być niższe niż odsetki wynikające z umowy (""%PercentageOfDepositForContainerOfTemplate%%"")';
							|tr = 'Plana göre bir sonraki ödemeye kadar ambalaj için depozito faizi (""%PackageDepositPercentage%%""), anlaşma kapsamındaki faizden (""%PercentageOfDepositForContainerOfTemplate%%"") az olmamalıdır'");
			ErrorText = StrReplace(ErrorText, "%PackageDepositPercentage%", InterestAmount);
			ErrorText = StrReplace(ErrorText, "%PercentageOfDepositForContainerOfTemplate%", AmountOfTemplateSInterest);
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "PackageDepositPercentage", ErrorText, DeviationTree);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					"TransferToPaymentCommand",
					Cancel);
			EndIf;
		EndIf;
		
	EndDo;

EndProcedure

// Displays error messages about the correctness of filling in the returned items.
//
// Parameters:
//	ErrorsTable - ValueTable - a table containing information about errors in the correctness of filling in returned items.
//	RefundByReceipt - Boolean - indicates a refund by receipt.
//
Procedure ReportErrorsInCorrectnessOfReturnedProducts(Val ErrorsTable, RefundByReceipt)
	
	For Each ErrorString In ErrorsTable Do
		If ValueIsFilled(ErrorString.DocumentSalesOfGoodsAndServices)
			And TypeOf(ErrorString.DocumentSalesOfGoodsAndServices) = Type("DocumentRef.TransferOfGoodsToBailee")
			And Common.ObjectAttributeValue(ErrorString.DocumentSalesOfGoodsAndServices, "BusinessOperation") = Enums.BusinessTransactions.TransferToCommissionAgent Then
			
			ErrorMessage = NStr("vi = 'Trả lại theo mặt hàng %Products%%Characteristic%%Series%%Purpose% vượt quá số lượng hàng hóa đã chuyển giao đi ký gửi theo chứng từ %SalesNumber% là %Count% %UnitOfMeasure%';
								|ru = 'Возврат по номенклатуре %Products%%Characteristic%%Series%%Purpose% превышает количество переданных товаров на комиссию по документу %SalesNumber% на %Count% %UnitOfMeasure%';
								|en = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity of goods transferred to the commission agent under the %SalesNumber% document by %Count% %UnitOfMeasure%'; fa = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity of goods transferred to the commission agent under the %SalesNumber% document by %Count% %UnitOfMeasure%';
								|it = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity of goods transferred to the commission agent under the %SalesNumber% document by %Count% %UnitOfMeasure%';
								|pl = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity of goods transferred to the commission agent under the %SalesNumber% document by %Count% %UnitOfMeasure%';
								|tr = 'Öğeye göre iade %Products%%Characteristic%%Series%%Purpose%, belge için komisyon tarafından aktarılan ürün sayısını aşıyor %SalesNumber%, %Count% %UnitOfMeasure%'");
			
		Else
			ErrorMessage = NStr("vi = 'Trả lại theo mặt hàng %Products%%Characteristic%%Series%%Purpose% vượt quá số lượng hàng hóa được bán theo chứng từ bán hàng %DocumentType%%SalesNumber% với %Count% %UnitOfMeasure%';
								|ru = 'Возврат по номенклатуре %Products%%Characteristic%%Series%%Purpose% превышает количество реализованных товаров по %DocumentType% %SalesNumber% на %Count% %UnitOfMeasure%';
								|en = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity sold under %DocumentType% %SalesNumber% by %Count% %UnitOfMeasure%'; fa = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity sold under %DocumentType% %SalesNumber% by %Count% %UnitOfMeasure%';
								|it = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity sold under %DocumentType% %SalesNumber% by %Count% %UnitOfMeasure%';
								|pl = 'Return of the %Products%%Characteristic%%Series%%Purpose% item exceeds the quantity sold under %DocumentType% %SalesNumber% by %Count% %UnitOfMeasure%';
								|tr = '%Products%%Characteristic%%Series%%Purpose% öğeleri üzerinden yapılan iadeler, %DocumentType% %SalesNumber% bazında satılan ürün sayısını %Count% %UnitOfMeasure% oranında aşmaktadır '");
		EndIf;
		
		If ErrorString.Count < 0 Then
			ErrorMessage = StrReplace(ErrorMessage, "%Products%", ErrorString.Products);
			
			If ValueIsFilled(ErrorString.Characteristic) Then
				ErrorMessage = StrReplace(ErrorMessage,
												"%Characteristic%", " \ " + ErrorString.Characteristic);
			Else
				ErrorMessage = StrReplace(ErrorMessage, "%Characteristic%", "");
			EndIf;
			
			If ValueIsFilled(ErrorString.Series) Then
				ErrorMessage = StrReplace(ErrorMessage,
												"%Series%", " \ " + ErrorString.Series);
			Else
				ErrorMessage = StrReplace(ErrorMessage, "%Series%", "");
			EndIf;
			
			If RefundByReceipt Then
				ErrorMessage = StrReplace(ErrorMessage, "%DocumentType%", NStr("vi = 'phiếu tính tiền';
																				|ru = 'чеку ККМ';
																				|en = 'receipt'; fa = 'receipt';
																				|it = 'allo scontrino fiscale';
																				|pl = 'paragonu kasy fiskalnej';
																				|tr = 'YK faturasına'"));
				ErrorMessage = StrReplace(ErrorMessage, "%Purpose%", "");
			Else
				ErrorMessage = StrReplace(ErrorMessage, "%DocumentType%", NStr("vi = 'chứng từ bán hàng';
																				|ru = 'документу продажи';
																				|en = 'sales document'; fa = 'sales document';
																				|it = 'al documento di vendita';
																				|pl = 'dokument sprzedaży';
																				|tr = 'satış belgesine'"));
				
				If ValueIsFilled(ErrorString.Purpose) Then
					ErrorMessage = StrReplace(ErrorMessage, "%Purpose%", " \ " + ErrorString.Purpose);
				Else
					ErrorMessage = StrReplace(ErrorMessage, "%Purpose%", "");
				EndIf;
			EndIf;
			
			ErrorMessage = StrReplace(ErrorMessage, "%Count%",			-ErrorString.Count);
			ErrorMessage = StrReplace(ErrorMessage, "%UnitOfMeasure%",	ErrorString.UnitOfMeasure);
			ErrorMessage = StrReplace(ErrorMessage, "%SalesNumber%",		ErrorString.SalesNumber);
			
			Common.MessageToUser(ErrorMessage);
		EndIf;
	EndDo;
	
EndProcedure

// Displays error messages about the correctness of filling in the prepayment amount
