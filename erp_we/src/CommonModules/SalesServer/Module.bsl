// Displays error messages in the PM Products of the sales document
//
// Parameters:
// Selection           - QueryResultSelection - sampling from the query result
// DocumentSales   - DocumentObject - The object for which you want to show error messages
// Cancel             - Boolean - Flag for refusing to carry out the document
// DeviationTree  - ValueTree - A tree with deviations of the table part from the sales conditions.
//
Procedure ReportErrorsInSalesDocument(Val Selection,
	                                              Val DocumentSales,
	                                              Cancel,
	                                              DeviationTree = Undefined)
	
	TableName        = Common.TableNameByRef(DocumentSales.Ref);
	TSName             = GetNameOfTablePart(TableName);
	PresentationOfTS   = GetPresentationOfTablePart(TableName);
	
	OutputToReport = (DeviationTree <> Undefined);
	
	UsePriceManagementSystem25 = PriceManagementSystemServerCall.UsePriceManagementSystem25(DocumentSales.Date);
	
	While Selection.Next() Do
		LineNumber = Selection.LineNumber;
		ErrorAddress = " " + NStr("vi = 'trong dòng %LineNumber% danh sách ""%PresentationOfTS%""';
									|ru = 'в строке %LineNumber% списка ""%PresentationOfTS%""';
									|en = 'in line %LineNumber% of the ""%PresentationOfTS%"" list'; fa = 'in line %LineNumber% of the ""%PresentationOfTS%"" list';
									|it = 'nella riga %LineNumber% dell''elenco ""%PresentationOfTS%""';
									|pl = 'w wierszu %LineNumber% listy ""%PresentationOfTS%""';
									|tr = '""%PresentationOfTS%"" listesinin %LineNumber% satırında'");
		ErrorAddress = StrReplace(ErrorAddress, "%LineNumber%",     LineNumber);
		ErrorAddress = StrReplace(ErrorAddress, "%PresentationOfTS%", PresentationOfTS);

		If Selection.ThereAreErrorsInFillingInPrice Then
			
			If (Selection.TheseAreComponents)  Then
				Continue;
			EndIf;
			
			If Selection.IsRecordsSet Then
				If Selection.ThisIsConvention Then
					ErrorText = NStr("vi = 'Đơn giá tập hợp không được nhỏ hơn đơn giá đã ấn định trong thỏa thuận chung ""%PriceAgreement%""';
									|ru = 'Цена набора должна быть не ниже фиксированной цены в типовом соглашении ""%PriceAgreement%""';
									|en = 'Set price should not be less than the fixed price in the ""%PriceAgreement%"" standard agreement'; fa = 'Set price should not be less than the fixed price in the ""%PriceAgreement%"" standard agreement';
									|it = 'Il prezzo del set non deve essere inferiore al prezzo stabilito nel modello di accordo ""%PriceAgreement%""';
									|pl = 'Cena zestawu nie może być niższa niż cena stała w umowie modelowej ""%PriceAgreement%""';
									|tr = 'Küme fiyatı, ""%PriceAgreement%"" standart anlaşmadaki sabit fiyattan düşük olmamalıdır'");
				Else
					ErrorText = NStr("vi = 'Đơn giá tập hợp không được nhỏ hơn đơn giá đã ấn định trong thỏa thuận ""%PriceAgreement%""';
									|ru = 'Цена набора должна быть не ниже фиксированной цены в соглашении ""%PriceAgreement%""';
									|en = 'Set price should not be less than the fixed price in the ""%PriceAgreement%"" agreement'; fa = 'Set price should not be less than the fixed price in the ""%PriceAgreement%"" agreement';
									|it = 'Il prezzo del set non deve essere inferiore al prezzo stabilito nell''accordo ""%PriceAgreement%""';
									|pl = 'Cena zestawu nie może być niższa niż cena ustalona w umowie ""%PriceAgreement%""';
									|tr = 'Küme fiyatı, ""%PriceAgreement%"" anlaşmadaki sabit fiyattan düşük olmamalıdır'");
				EndIf;
			Else
				If Selection.ThisIsConvention Then
					ErrorText = NStr("vi = 'Đơn giá không được thấp hơn đơn giá đã ghi trong thỏa thuận chung ""%PriceAgreement%""';
									|ru = 'Цена должна быть не ниже фиксированной цены в типовом соглашении ""%PriceAgreement%""';
									|en = 'Price should not be less than the fixed price in the ""%PriceAgreement%"" standard agreement'; fa = 'Price should not be less than the fixed price in the ""%PriceAgreement%"" standard agreement';
									|it = 'Il prezzo deve essere inferiore al prezzo stabilito nel modello di accordo ""%PriceAgreement%""';
									|pl = 'Cena nie może być niższa niż stała cena w umowie modelowej ""%PriceAgreement%""';
									|tr = 'Fiyat, ""%PriceAgreement%"" standart anlaşmadaki sabit fiyattan düşük olmamalıdır'");
				Else
					ErrorText = NStr("vi = 'Đơn giá không được thấp hơn đơn giá đã ghi trong thỏa thuận ""%PriceAgreement%""';
									|ru = 'Цена должна быть не ниже фиксированной цены в соглашении ""%PriceAgreement%""';
									|en = 'Price should not be less than the fixed price in the ""%PriceAgreement%"" agreement'; fa = 'Price should not be less than the fixed price in the ""%PriceAgreement%"" agreement';
									|it = 'Il prezzo deve essere inferiore al prezzo stabilito nell''accordo ""%PriceAgreement%""';
									|pl = 'Cena nie może być niższa niż cena ustalona w umowie ""%PriceAgreement%""';
									|tr = 'Fiyat, ""%PriceAgreement%"" anlaşmadaki sabit fiyattan düşük olmamalıdır'");
				EndIf;
			EndIf;
			
			ErrorText = StrReplace(ErrorText, "%PriceAgreement%", Format(Selection.PriceAgreement,"NFD=2"));
			
			If OutputToReport Then
				Reports.VariancesFromSalesTermsAndConditions.AddRowDeviationToDeviationTree(LineNumber, "Price", ErrorText, DeviationTree, Selection.IsRecordsSet, Selection.Price);
			Else
				ReportErrorToUser(
					ErrorText + ErrorAddress,
					DocumentSales,
					CommonClientServer.PathToTabularSection(TSName, Selection.LineNumber, "Price"),
					Cancel);
			EndIf;
