	|WHERE
	|	ReferenceOrder.Ref IN (&AnArrayOfOrders)
	|	AND CustomerOrderGoods.Products.SaleRegistrationOption = VALUE(Enum.SalesRegistrationOptions.CustomerInvoice)
	|
	|UNION ALL
	|
	|SELECT
	|	ReferenceOrder.Ref AS Ref,
	|	ReferenceOrder.Partner AS Partner,
	|	ReferenceOrder.Counterparty AS Counterparty,
	|	ReferenceOrder.Contract AS Contract,
	|	ReferenceOrder.Organization AS Organization,
	|	ReferenceOrder.Terms AS Terms,
	|	ReferenceOrder.SalesOpportunity AS SalesOpportunity,
	|	ReferenceOrder.Warehouse AS Warehouse,
	|	CASE
	|		WHEN Warehouses.IsFolder
	|			AND Warehouses.SelectGroup = VALUE(Enum.SelectWarehouseGroup.AllowInOrders)
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS WarehouseInOrderHeader,
	|	ReferenceOrder.Department AS Department,
	|	ReferenceOrder.BusinessOperation AS BusinessOperation,
	|	RequestForReturnOfGoods_.Count AS ToRegisterBalance,
	|	ReferenceOrder.Currency AS ARAPCurrency,
	|	ReferenceOrder.VATTaxation AS VATTaxation,
	|	ReferenceOrder.PriceIncludesVAT AS PriceIncludesVAT,
	|	RequestForReturnOfGoods_.Products.SaleRegistrationOption AS SaleRegistrationOption,
	|	ReferenceOrder.DeliveryMethod AS DeliveryMethod,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
	|				OR ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|			THEN ReferenceOrder.CarrierPartner
	|		ELSE VALUE(Catalog.Partners.EmptyRef)
	|	END AS CarrierPartner,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod <> VALUE(Enum.TransportMethods.SelfPickup)
	|			OR ReferenceOrder.DeliveryAddress <> """"
	|			THEN ReferenceOrder.DeliveryAddress
	|		ELSE """"
	|	END AS DeliveryAddress,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
	|				OR ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|			THEN ReferenceOrder.DeliveryAddressOfCarrier
	|		ELSE """"
	|	END AS DeliveryAddressOfCarrier,
	|
	|	ReferenceOrder.ToReturnReusablePackage AS ToReturnReusablePackage,
	|	ReferenceOrder.ReusablePackageReturnCycleLength AS ReusablePackageReturnCycleLength,
	|	ReferenceOrder.PackageDepositIsRequired AS PackageDepositIsRequired,
	|	VALUE(Catalog.BusinessCalendars.EmptyRef)AS ScheduleOfPackageReturn,
	|	FALSE AS CalculatePackageReturnDateAccordingToCalendar,
	|	ReferenceOrder.LineOfBusiness AS LineOfBusiness,
	|	ReferenceOrder.ARAPObjectSettings AS ARAPObjectSettings,
	|	ReferenceOrder.ThisIsOrderAsInvoice AS ThisIsOrderAsInvoice
	|FROM
	|	Document.RequestForReturnOfGoodsFromCustomer AS ReferenceOrder
	|INNER JOIN
	|	Document.RequestForReturnOfGoodsFromCustomer.SubstituteGoods AS RequestForReturnOfGoods_
	|ON
	|	ReferenceOrder.Ref = RequestForReturnOfGoods_.Ref
	|LEFT JOIN
	|	Catalog.Warehouses AS Warehouses
	|ON
	|	ReferenceOrder.Warehouse = Warehouses.Ref
	|WHERE
	|	ReferenceOrder.Ref IN (&ArrayOfReturnRequests)
	|	AND RequestForReturnOfGoods_.Products.SaleRegistrationOption = VALUE(Enum.SalesRegistrationOptions.CustomerInvoice)
	|
	|UNION ALL
	|
	|SELECT
	|	ReferenceOrder.Ref AS Ref,
	|	ReferenceOrder.Partner AS Partner,
	|	ReferenceOrder.Counterparty AS Counterparty,
	|	ReferenceOrder.Contract AS Contract,
	|	ReferenceOrder.Organization AS Organization,
	|	ReferenceOrder.Terms AS Terms,
	|	ReferenceOrder.SalesOpportunity AS SalesOpportunity,
	|	ReferenceOrder.Warehouse AS Warehouse,
	|	CASE
	|		WHEN Warehouses.IsFolder
	|			AND Warehouses.SelectGroup = VALUE(Enum.SelectWarehouseGroup.AllowInOrders)
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS WarehouseInOrderHeader,
	|	ReferenceOrder.Department AS Department,
	|	ReferenceOrder.BusinessOperation AS BusinessOperation,
	|	ShippingGoods.Count AS ToRegisterBalance,
	|	ReferenceOrder.Currency AS ARAPCurrency,
	|	ReferenceOrder.VATTaxation AS VATTaxation,
	|	TRUE AS PriceIncludesVAT,
	|	ShippingGoods.Products.SaleRegistrationOption AS SaleRegistrationOption,
	|	ReferenceOrder.DeliveryMethod AS DeliveryMethod,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
	|				OR ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|			THEN ReferenceOrder.CarrierPartner
	|		ELSE VALUE(Catalog.Partners.EmptyRef)
	|	END AS CarrierPartner,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod <> VALUE(Enum.TransportMethods.SelfPickup)
	|			OR ReferenceOrder.DeliveryAddress <> """"
	|			THEN ReferenceOrder.DeliveryAddress
	|		ELSE """"
	|	END AS DeliveryAddress,
	|	CASE
	|		WHEN ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
	|				OR ReferenceOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|			THEN ReferenceOrder.DeliveryAddressOfCarrier
	|		ELSE """"
	|	END AS DeliveryAddressOfCarrier,
	|
	|	FALSE AS ToReturnReusablePackage,
	|	FALSE AS ReusablePackageReturnCycleLength,
	|	FALSE AS PackageDepositIsRequired,
	|	VALUE(Catalog.BusinessCalendars.EmptyRef)AS ScheduleOfPackageReturn,
	|	FALSE AS CalculatePackageReturnDateAccordingToCalendar,
	|	ReferenceOrder.LineOfBusiness AS LineOfBusiness,
	|	FALSE AS ARAPObjectSettings,
	|	FALSE AS ThisIsOrderAsInvoice
	|FROM
	|	Document.GoodsShipmentToCustomer AS ReferenceOrder
	|INNER JOIN
	|	Document.GoodsShipmentToCustomer.Goods AS ShippingGoods
	|ON
	|	ReferenceOrder.Ref = ShippingGoods.Ref
	|LEFT JOIN
	|	Catalog.Warehouses AS Warehouses
	|ON
	|	ReferenceOrder.Warehouse = Warehouses.Ref
	|WHERE
	|	ReferenceOrder.Ref IN (&ArrayOfShipments)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	References.Ref AS Ref,
	|	References.Partner AS Partner,
	|	References.Counterparty AS Counterparty,
	|	References.Contract AS Contract,
	|	References.Organization AS Organization,
	|	References.Terms AS Terms,
	|	References.SalesOpportunity AS SalesOpportunity,
	|	References.Warehouse AS Warehouse,
	|	References.Department AS Department,
	|	CASE
	|		WHEN References.WarehouseInOrderHeader
	|			THEN References.Warehouse
	|		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	|	END AS OriginWarehouse,
	|	NOT References.WarehouseInOrderHeader AS ItIsForbiddenToSelectWarehouseGroup,
	|	References.BusinessOperation AS BusinessOperation,
	|	SUM(References.ToRegisterBalance) AS ToRegisterBalance,
	|	References.ARAPCurrency AS ARAPCurrency,
	|	References.VATTaxation AS VATTaxation,
	|	References.PriceIncludesVAT AS PriceIncludesVAT,
	|	References.SaleRegistrationOption AS SaleRegistrationOption,
	|	References.DeliveryMethod AS DeliveryMethod,
	|	References.CarrierPartner AS CarrierPartner,
	|	References.DeliveryAddress AS DeliveryAddress,
	|	References.DeliveryAddressOfCarrier AS DeliveryAddressOfCarrier,
	|	References.ToReturnReusablePackage AS ToReturnReusablePackage,
	|	References.ReusablePackageReturnCycleLength AS ReusablePackageReturnCycleLength,
	|	References.PackageDepositIsRequired AS PackageDepositIsRequired,
	|	References.ScheduleOfPackageReturn AS ScheduleOfPackageReturn,
	|	References.CalculatePackageReturnDateAccordingToCalendar AS CalculatePackageReturnDateAccordingToCalendar,
	|	References.LineOfBusiness AS LineOfBusiness,
	|	References.ARAPObjectSettings AS ARAPObjectSettings,
	|	References.ThisIsOrderAsInvoice AS ThisIsOrderAsInvoice,
	|	1 AS InvoiceStatus
	|FROM
	|	TT_References AS References
	|GROUP BY
	|	References.Ref,
	|	References.Partner,
	|	References.Counterparty,
	|	References.Contract,
	|	References.Organization,
	|	References.Terms,
	|	References.SalesOpportunity,
	|	References.Warehouse,
	|	References.Department,
	|	References.WarehouseInOrderHeader,
	|	References.BusinessOperation,
	|	References.ARAPCurrency,
	|	References.VATTaxation,
	|	References.PriceIncludesVAT,
	|	References.SaleRegistrationOption,
	|	References.DeliveryMethod,
	|	References.CarrierPartner,
	|	References.DeliveryAddress,
	|	References.DeliveryAddressOfCarrier,
	|	References.ToReturnReusablePackage,
	|	References.ReusablePackageReturnCycleLength,
	|	References.PackageDepositIsRequired,
	|	References.ScheduleOfPackageReturn,
	|	References.CalculatePackageReturnDateAccordingToCalendar,
	|	References.LineOfBusiness,
	|	References.ARAPObjectSettings,
	|	References.ThisIsOrderAsInvoice
	|";

	Return QueryText;
	
EndFunction

Function ThereIsInvoice(DocumentsByTypesOfInvoices)
	
	For Each Table In DocumentsByTypesOfInvoices Do
		For Each String In Table Do
			// Status "1" - the invoice has not been created. The remaining states imply the presence of an invoice, or an invoice without an order.
			If String.InvoiceStatus <> 1 Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	
	Return False;
	
EndFunction

Function ThereSWarrant(DocumentsByTypesOfInvoices)
	
	For Each Table In DocumentsByTypesOfInvoices Do
		For Each String In Table Do
			// Status "1" - the order has not been created. The remaining states imply the presence of an order, or that an order is not required
			// (state 4).
			If String.NoteState <> 1 Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	
	Return False;
	
EndFunction

Function ThereIsOrder(DocumentsByTypesOfInvoices)
	
	For Each Table In DocumentsByTypesOfInvoices Do
		For Each String In Table Do
			If TypeOf(String.Ref)= Type("DocumentRef.SalesOrder")
				Or TypeOf(String.Ref) = Type("DocumentRef.MaterialProviderOrder2_5")
				Or TypeOf(String.Ref)= Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	
	Return False;
	
EndFunction

// Exclude orders with invoices.
// 
// Parameters:
//  DocumentsByTypesOfInvoices - Array - Documents by invoice type
//  ErrorList - Array - List of errors
Procedure ExcludeOrdersWithInvoices(DocumentsByTypesOfInvoices, ErrorList)
	
	InitialQuantity = DocumentsByTypesOfInvoices.Count();
	For N1 = 1 To InitialQuantity Do
		IndexOf = InitialQuantity - N1;
		Table = DocumentsByTypesOfInvoices[IndexOf];
		
		Exclude = False;
		For Each TableRow In Table Do
			
			If TableRow.InvoiceStatus <> 1 Then
				Exclude = True;
				Break;
			EndIf;
			
		EndDo;
		
		If Exclude Then
			
			For Each String In Table Do
				ErrorText = NStr("vi = 'Đối với đơn hàng %1, giao dịch chưa được hoàn thành, vì đã có hóa đơn cho các đơn hàng đã chọn.';
								|ru = 'Для распоряжения %1 действие не выполнено, так как по выбранным распоряжениям уже имеются накладные.';
								|en = 'Action is not performed for the %1 reference as invoices for the selected references already exist.'; fa = 'Action is not performed for the %1 reference as invoices for the selected references already exist.';
								|it = 'Per la disposizione %1 l''azione non è eseguita, in quanto per le disposizioni selezionate vi sono già le bolle.';
								|pl = 'Dla zamówienia %1 działanie nie powiodło się, ponieważ w wybranych zamówieniach już są faktury.';
								|tr = '%1 emri için eylem gerçekleştirilmez çünkü seçilen emirler için zaten irsaliyeler vardır.'");
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref);
				AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
			EndDo;
			
			DocumentsByTypesOfInvoices.Delete(IndexOf);
			
		EndIf;
		
	EndDo;
	
EndProcedure

Function MetadataOfTransactionInvoice(OperationParametersList)
	
	OrderOperation = OperationParametersList.BusinessOperation;
	
	InvoiceMetadata = Metadata.Documents.CustomerInvoice;
	If OrderOperation = Enums.BusinessTransactions.TransferToStorageWithRightOfSale Then
		InvoiceMetadata = Metadata.Documents.TransferOfGoodsToBailee;
	ElsIf OrderOperation = Enums.BusinessTransactions.TransferToToller2_5 Then
		InvoiceMetadata = Metadata.Documents.TransferOfGoodsToBailee;
	EndIf;
	
	If OrderOperation = Enums.BusinessTransactions.DeliveryForPrincipal Then
		InvoiceMetadata = Metadata.Documents.GoodsShipmentFromStorage;
	ElsIf OrderOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5 Then
		InvoiceMetadata = Metadata.Documents.GoodsShipmentFromStorage;
	EndIf;
	
	If OrderOperation = Enums.BusinessTransactions.TransferToCommissionAgent
		And OperationParametersList.Contract.ConsignmentSales25 Then
		InvoiceMetadata = Metadata.Documents.TransferOfGoodsToBailee;
	EndIf;

	Return InvoiceMetadata;
	
EndFunction

Function FillItOutUsingFillInForm(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList, DocumentName = "")
	
	CreatedDocuments = New ValueList();
	
	DocumentsTable = DocumentsByTypesOfInvoices[0];
	SelectedRow  = DocumentsTable[0];
	
	If ValueIsFilled(DocumentName) Then
		InvoiceMetadata = Metadata.Documents[DocumentName];
	Else
		InvoiceMetadata = MetadataOfTransactionInvoice(SelectedRow);
		DocumentName        = InvoiceMetadata.Name;
	EndIf;
	
	If AccessRight("Insert", InvoiceMetadata)
		Or AccessRight("Update", InvoiceMetadata) Then
		
		ReferencesArrray   = DocumentsTable.UnloadColumn("Ref");
		HeaderAttributes = New Structure;
		
		If SalesServerCall.GenerateImplementationFillInData(ReferencesArrray, DocumentName, HeaderAttributes) Then
			FormSettings = SettingsOfInvoiceReissueForm(DocumentName);
			
			FormParameters = New Structure;
			FormParameters.Insert("Orders",         ReferencesArrray);
			FormParameters.Insert("Warehouse",          HeaderAttributes.Warehouse);
			FormParameters.Insert("HeaderAttributes", HeaderAttributes);
			FormParameters.Insert("FormSettings", FormSettings);
			
			FormParametersAndName = New Structure("HasErrors, FormName, Parameters");
			FormParametersAndName.HasErrors = False;
			FormParametersAndName.FormName   = "CommonForm.ReregisterInvoicesByReferences";
			FormParametersAndName.Parameters  = FormParameters;
		Else
			FormParametersAndName = New Structure;
		EndIf;
		
		Return FormParametersAndName;
		
	Else
		AccessError = NStr("vi = 'Không có quyền thêm / thay đổi hóa đơn';
							|ru = 'Нет прав на добавление/изменение накладной';
							|en = 'No rights to add/change the invoice'; fa = 'No rights to add/change the invoice';
							|it = 'Nessun diritto per aggiungere / modificare la fattura';
							|pl = 'Brak uprawnień do dodawania / modyfikowania faktury';
							|tr = 'İrsaliye ekleme/değiştirme hakkı yok'");
		AddUserError(ErrorList,
			"Object.ListReferencesForRegistration",
			AccessError);
		
		Return New Structure(); // No rights
	EndIf;
	
EndFunction

Function IssueInvoiceAccordingToTable(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList)
	
	CreatedDocuments = New Array;
	
	DocumentsTable = DocumentsByTypesOfInvoices[0];
	SelectedRow  = DocumentsTable[0];
	
	InvoiceMetadata = MetadataOfTransactionInvoice(SelectedRow);
	InvoiceName        = InvoiceMetadata.Name;
		
	FormSettings = New Structure();
	FormParameters = New Structure();
	
	Orders = DocumentsTable.UnloadColumn("Ref");
	TheStructureOfTheSearch = StructureOfMeaningfulProps();
	
	OrdersWaybills = New Array();
	For Each ReferenceOrder In Orders Do
		
		TypeOfGNPOrder = TypeOf(ReferenceOrder);
		
		If TypeOfGNPOrder = Type("DocumentRef.ReturnOfGoodsFromCustomer")
			Or TypeOfGNPOrder = Type("DocumentRef.ReceiptOfGoodsFromCustodian")
			Or TypeOfGNPOrder = Type("DocumentRef.CustomerInvoice")
			Or TypeOfGNPOrder = Type("DocumentRef.TransferOfGoodsToBailee")
			Or TypeOfGNPOrder = Type("DocumentRef.GoodsShipmentFromStorage")
			  And SelectedRow.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
			Then
			
			OrdersWaybills.Add(ReferenceOrder);
			
			Break;
			
		EndIf;
		
	EndDo;
	
	Cancel = False;
	If GenerationParameters.ByNotes And OrdersWaybills.Count() > 0 Then
		// For existing orders-invoices, the header of the document is not refilled
		RefillableInvoice = OrdersWaybills[0];
		FillingValues = New Structure("FillByWarehouseDocument, AnArrayOfOrders", True, Orders);
		
		FormParameters.Insert("FillByWarehouseDocument", GenerationParameters.ByNotes);
		FormParameters.Insert("AnArrayOfOrders", Orders);
		FormSettings.Insert("FormName", "Document." + InvoiceName + ".Form.DocumentForm");
		
		// To display a message about the number of documents created
		CreatedDocuments.Add(PredefinedValue("Document." + InvoiceMetadata.Name + ".EmptyRef"));
	Else
		
		FillPropertyValues(TheStructureOfTheSearch, SelectedRow);
		If SelectedRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice
		 Or SelectedRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer
		 Or SelectedRow.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
		Then
			If SelectedRow.ItIsForbiddenToSelectWarehouseGroup Then
				FormParameters.Insert("OriginWarehouse", SelectedRow.Warehouse);
			Else
				FormParameters.Insert("OriginWarehouse", GenerationParameters.Warehouse);
			EndIf;
			FormParameters.Insert("SaleRegistrationOption", SelectedRow.SaleRegistrationOption);

			DesignParameters = New Structure("ByOrders, ByNotes", Not GenerationParameters.ByNotes, GenerationParameters.ByNotes);
			If GenerationParameters.Property("CheckWarehouses") Then
				DesignParameters.Insert("CheckWarehouses", GenerationParameters.CheckWarehouses);
			EndIf;
			FormParameters.Insert("DesignParameters", DesignParameters);
		Else
			InvoiceName = "CustomerInvoiceServices";
		EndIf;
		
		DetailsOfOrder = GetOrderDetails(Orders);
		HeaderAttributes = New Structure();
		TMCommonUseClientServer.SupplementStructure(HeaderAttributes, TheStructureOfTheSearch, True);
		TMCommonUseClientServer.SupplementStructure(HeaderAttributes, DetailsOfOrder, True);
		
		FormParameters.Insert("HeaderAttributes",    HeaderAttributes);
		FormParameters.Insert("DocumentBasis", Orders);
		
		If GenerationParameters.CreateSalesDocument Then
			CreateSalesDocument_(TheStructureOfTheSearch, FormParameters, CreatedDocuments, GenerationParameters);
			
			HasErrors = False;
			For Each Item In CreatedDocuments Do
				If Item.Property("HasErrors") And Item.HasErrors = True Then
					HasErrors = True;
					Break;
				EndIf; 
			EndDo; 
			
			If GenerationParameters.DoNotOpenFormOfCreatedDocument And Not HasErrors Then
				FormSettings.Insert("DocumentPrintingMode", True);
			Else
				FormSettings.Insert("FormName", "DataProcessor.LogOfSalesDocuments.Form.FormCreatedDocuments");
				
				Owner = Users.AuthorizedUser();
				SetPrivilegedMode(True);
				Common.WriteDataToSecureStorage(Owner, CreatedDocuments, "FormCreatedSalesDocuments");
				SetPrivilegedMode(False);
			EndIf; 
		Else
			FormSettings.Insert("FormName", "Document." + InvoiceName + ".Form.DocumentForm");
			
			// To display a message about the number of documents created
			CreatedDocuments.Add(PredefinedValue("Document." + InvoiceMetadata.Name + ".EmptyRef"));
		EndIf;
		
	EndIf;
	
	FormParameters.Insert("CreatedDocuments", CreatedDocuments);
	
	ParametersWithBase = New Structure("Basis", FormParameters);
	
	If ValueIsFilled(RefillableInvoice) Then
		ParametersWithBase.Insert("FillingValues", FillingValues);
		ParametersWithBase.Insert("Key", RefillableInvoice);
	EndIf;
	
	FormSettings.Insert("Parameters", ParametersWithBase);
	
	If Cancel Then
		Return Undefined;
	Else
		Return FormSettings;
	EndIf;
	
EndFunction

Function ArrangeShipmentOfItemsAccordingToTable(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList, 
				DocumentName, BusinessOperation = Undefined)
	
	CreatedDocuments = New Array;
	
	DocumentsTable = DocumentsByTypesOfInvoices[0];
	SelectedRow  = DocumentsTable[0];
	
	FormSettings = New Structure();
	FormParameters = New Structure();
	
	If ValueIsFilled(BusinessOperation) Then
		FormParameters.Insert("BusinessOperation", BusinessOperation);
	EndIf;
	
	Orders = DocumentsTable.UnloadColumn("Ref");
	TheStructureOfTheSearch = StructureOfMeaningfulProps();
	TheStructureOfTheSearch.Insert("ThisIsOrderAsInvoice", False);
	
	OrdersWaybills = New Array();
	For Each ReferenceOrder In Orders Do
		
		TypeOfGNPOrder = TypeOf(ReferenceOrder);
		If TypeOfGNPOrder = Type("DocumentRef.GoodsShipmentToCustomer") Then
			OrdersWaybills.Add(ReferenceOrder);
			Break;
		EndIf;
	EndDo;
	
	Cancel = False;
	If GenerationParameters.ByNotes And OrdersWaybills.Count() > 0 Then
		// For existing orders-invoices, the header of the document is not refilled
		RefillableInvoice = OrdersWaybills[0];
		FillingValues = New Structure("FillByWarehouseDocument, AnArrayOfOrders", True, Orders);
		
		FormParameters.Insert("FillByWarehouseDocument", GenerationParameters.ByNotes);
		FormParameters.Insert("AnArrayOfOrders", Orders);
		
		// To display a message about the number of documents created
		CreatedDocuments.Add(PredefinedValue("Document." + DocumentName + ".EmptyRef"));
	Else
		
		FillPropertyValues(TheStructureOfTheSearch, SelectedRow);
		If SelectedRow.ItIsForbiddenToSelectWarehouseGroup Then
			FormParameters.Insert("OriginWarehouse", SelectedRow.Warehouse);
		Else
			FormParameters.Insert("OriginWarehouse", GenerationParameters.Warehouse);
		EndIf;
		
		DesignParameters = New Structure("ByOrders, ByNotes", Not GenerationParameters.ByNotes, GenerationParameters.ByNotes);
		If GenerationParameters.Property("CheckWarehouses") Then
			DesignParameters.Insert("CheckWarehouses", GenerationParameters.CheckWarehouses);
		EndIf;
		FormParameters.Insert("DesignParameters", DesignParameters);
		FormParameters.Insert("FillByWarehouseDocument", GenerationParameters.ByNotes);
		
		HeaderAttributes = New Structure();
		DetailsOfOrder = GetOrderDetails(Orders);
		TMCommonUseClientServer.SupplementStructure(HeaderAttributes, DetailsOfOrder, True);
		TMCommonUseClientServer.SupplementStructure(HeaderAttributes, TheStructureOfTheSearch, True);
		
		FormParameters.Insert("HeaderAttributes", HeaderAttributes);
		FormParameters.Insert("DocumentBasis", Orders);
		
		If GenerationParameters.CreateSalesDocument Then
			CreateSalesDocument_(TheStructureOfTheSearch, FormParameters, CreatedDocuments, GenerationParameters);
			
			HasErrors = False;
			For Each Item In CreatedDocuments Do
				If Item.Property("HasErrors") And Item.HasErrors = True Then
					HasErrors = True;
					Break;
				EndIf; 
			EndDo; 
			
			If GenerationParameters.DoNotOpenFormOfCreatedDocument And Not HasErrors Then
				FormSettings.Insert("DocumentPrintingMode", True);
			Else
				FormSettings.Insert("FormName", "DataProcessor.LogOfSalesDocuments.Form.FormCreatedDocuments");
				
				Owner = Users.AuthorizedUser();
				SetPrivilegedMode(True);
				Common.WriteDataToSecureStorage(Owner, CreatedDocuments, "FormCreatedSalesDocuments");
				SetPrivilegedMode(False);
			EndIf; 
		Else
			FormSettings.Insert("FormName", "Document." + DocumentName + ".Form.DocumentForm");
			
			// To display a message about the number of documents created
			CreatedDocuments.Add(PredefinedValue("Document." + DocumentName + ".EmptyRef"));
		EndIf;
	EndIf;
		
	FormParameters.Insert("CreatedDocuments", CreatedDocuments);
	ParametersWithBase = New Structure("Basis", FormParameters);
	
	If ValueIsFilled(RefillableInvoice) Then
		ParametersWithBase.Insert("FillingValues", FillingValues);
		ParametersWithBase.Insert("Key", RefillableInvoice);
	EndIf;
	
	FormSettings.Insert("Parameters", ParametersWithBase);
	
	If Cancel Then
		Return Undefined;
	Else
		Return FormSettings;
	EndIf;
	
EndFunction

