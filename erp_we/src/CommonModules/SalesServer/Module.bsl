// Fills in the selection data during auto-selection of Analytics based on the entered text.
//
// Parameters:
//  ChoiceData - ValueList - List of values to fill in.
//  Text - String - Text entered in the field.
//
Procedure FillInExpenseAnalyticsSelectionData(ChoiceData, Text) Export
	
	Query = New Query;
	Query.Text = GETRequestTextImplementationDocuments();
	Query.SetParameter("SearchString", Text + "%");
	Query.SetParameter("RefsTypes", TypesOfReferencesImplementationDocuments());
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		ChoiceData.Add(
			New Structure("Value, DeletionMark",
				Selection.Ref,
				(Selection.DocumentState = 1)),
			Selection.RepresentationOfTheReference);
	EndDo;
	
EndProcedure

// The function returns an array of metadata object IDs
// corresponding to implementation documents.
// Used in " General Forms.Vibrantlifeministries".
// 
// Parameters:
//	ToSelectExpenseAnalytics - Boolean - calling a function from the expense analytics selection form
//
// Returns:
//   Array - array of identifiers of metadata objects.
//
Function TypesOfReferencesImplementationDocuments(ToSelectExpenseAnalytics = False) Export
	
	RefsTypes = New Array;
	If AccessRight("Read", Metadata.Documents.CustomerInvoice) Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.CustomerInvoice));
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.CustomerInvoiceServicesAndAssets) Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.CustomerInvoiceServicesAndAssets));
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.CustomerInvoiceServices) Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.CustomerInvoiceServices));
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.SalesOrder)
		And GetFunctionalOption("UseSalesOrders") Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.SalesOrder));
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.RequestForReturnOfGoodsFromCustomer)
		And GetFunctionalOption("UseRequestsForReturnOfGoodsFromCustomers") Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.RequestForReturnOfGoodsFromCustomer));
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.TransferOfGoodsToBailee)
		And Not ToSelectExpenseAnalytics
		And GetFunctionalOption("UseTransferToCustodyWithRightOfSale") Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.TransferOfGoodsToBailee));
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.GoodsShipmentToCustomer)
		And GetFunctionalOption("UseShipmentWithDeferredTransferOfTitle2_5") Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.GoodsShipmentToCustomer));
	EndIf;
	
	
	If AccessRight("Read", Metadata.Documents.MaterialProviderOrder2_5)
		And GetFunctionalOption("UseMaterialProviderOrder2_5") Then
		RefsTypes.Add(Common.MetadataObjectID(Metadata.Documents.MaterialProviderOrder2_5));
	EndIf;
	Return RefsTypes;
	
EndFunction

