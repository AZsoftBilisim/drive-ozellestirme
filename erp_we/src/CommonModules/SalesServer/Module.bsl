				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
		
		If DocumentSales.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent
			And NeedReplacementGoods Then
			If ChecksArray.Find("TemporaryTableOfGoods_") = Undefined Then
				
				ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
				ChecksArray.Add("TemporaryTableSetsPreparation");
				ChecksArray.Add("TemporaryTableSetsOptional");
				ChecksArray.Add("TemporaryTableSets");
				ChecksArray.Add("TemporaryTableOfGoods_");
				
			EndIf;
			ChecksArray.Add("AvailabilityOfServicesWorks");
		EndIf;
		
		If OperationsForReturningTransferredGoods.Find(DocumentSales.BusinessOperation) <> Undefined Then
			ChecksArray.Add("AvailabilityOfServicesWorks");
			ChecksArray.Add("AvailabilityOfAlcoholicBeverages");
		EndIf;
	
	// ASSIGNMENT TO A SALES REPRESENTATIVE
	
	ElsIf TableName = "Document.JobForSalesRepresentative" Then
		ReturnOfMultiTurnContainers = DocumentSales.ToReturnReusablePackage;
		PackageDepositIsRequired = DocumentSales.PackageDepositIsRequired;
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		If Not VarianceFromSalesTermsAndConditions And ToUseTermsOfSales Then
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
		EndIf;
		
		ChecksArray.Add("TemporaryTableOfGoods_");
		ChecksArray.Add("CorrectSelectionOfProductsForVATTaxation");
			
		If TransferOperations_.Find(DocumentSales.BusinessOperation) <> Undefined Then
			ChecksArray.Add("AvailabilityOfServicesWorks");
		EndIf;
			
	// Report of completed works
	
	ElsIf TableName = "Document.CustomerInvoiceServices" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		If CheckDiscountsCalculated And
			UseAutomaticDiscounts And
			Not DocumentSales.DiscountsAreCalculated Then
			CheckDiscountsCalculated = True;
		EndIf;
		
		ChecksArray.Add("CorrectnessOfAmountAndAmountOfVAT");
		If UseBusinessUnits Then
			ChecksArray.Add("CorrectFillingOfDivisionInTablePart");
		EndIf;
		
		If Not DocumentSales.InvoiceByOrders And NeedToAgree_ Then
			
			If UsePriceManagementSystem25 Then
				ChecksArray.Add("TempTableOfTSONomenclature");
				ChecksArray.Add("TempTableOfPriceOfItemOfCentralOffice");
				ChecksArray.Add("TempTableOfCentralBankPrices");
			EndIf;
			
			ChecksArray.Add("CorrectIndicationOfVATRate");
			ChecksArray.Add("CorrectVATAmount");
			ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
			
			If ToUseTermsOfSales Then
				ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
				ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
				ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
				ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
				ChecksArray.Add("WhetherProductsBelongToProductSegment");
			EndIf;
			
			If CheckPriceRange Then
				ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
			EndIf;
			
		EndIf;
		
		If NeedToAgree_ And ToUseTermsOfSales Then
			ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
			ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
		EndIf;
		
		If LimitDiscountAdjustments Then
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");

		EndIf;
		
	// Return of goods from customer
	
	ElsIf TableName = "Document.ReturnOfGoodsFromCustomer" Then
		
		If DocumentSales.BusinessOperation <> Enums.BusinessTransactions.ReturnFromCommissionAgent Then
			ChecksArray.Add("TemporaryTableSalesDocument");
			
			ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
			ChecksArray.Add("TemporaryTableSetsPreparation");
			ChecksArray.Add("TemporaryTableSetsOptional");
			ChecksArray.Add("TemporaryTableSets");
			ChecksArray.Add("TemporaryTableOfGoods_");

			ChecksArray.Add("CorrectFillingOfWarehouseInProductsTabularSection");
			
			ChecksArray.Add("PriceFillingControl");
			ChecksArray.Add("CorrectnessOfAmountAndAmountOfVAT");
		EndIf;
		
		ReturnOfMultiTurnContainers = DocumentSales.ReusablePackageReturn;
		PackageDepositIsRequired = DocumentSales.DepositForPackageIsRequired;
		
	ElsIf TableName = "Document.ReceiptOfGoodsFromCustodian" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("AvailabilityOfServicesWorks");
		ChecksArray.Add("AvailabilityOfAlcoholicBeverages");

	ElsIf TableName = "Document.GoodsReceiptFromCustomer" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("CorrectFillingOfWarehouse");
		ChecksArray.Add("CorrectFillingOfWarehouseInProductsTabularSection");
		
	ElsIf TableName = "Document.RedemptionOfGoodsByCustodian" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("AvailabilityOfServicesWorks");
		ChecksArray.Add("AvailabilityOfAlcoholicBeverages");
		
	ElsIf TableName = "Document.WriteOffOfShippedGoods" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("AvailabilityOfServicesWorks");
		ChecksArray.Add("AvailabilityOfAlcoholicBeverages");
		
		If DocumentSales.BusinessOperation =
			Enums.BusinessTransactions.WriteOffOfShippedGoods Then
			
			ChecksArray.Add("CorrectFillingOfWarehouse");
			ChecksArray.Add("CorrectFillingOfWarehouseInProductsTabularSection");
			
		EndIf;
		
	ElsIf TableName = "Document.RecognitionOfStockSurplusShippedToCustomer" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("AvailabilityOfServicesWorks");
		ChecksArray.Add("AvailabilityOfAlcoholicBeverages");
		
	// CERTIFICATE OF DISCREPANCIES AFTER ACCEPTANCE
	
	ElsIf TableName = "Document.DiscrepancyReportFollowingReceipt" Then
		
		If OperationsForReturningTransferredGoods.Find(DocumentSales.BusinessOperation) = Undefined Then
			ChecksArray.Add("TemporaryTableSalesDocument");
			
			ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
			ChecksArray.Add("TemporaryTableSetsPreparation");
			ChecksArray.Add("TemporaryTableSetsOptional");
			ChecksArray.Add("TemporaryTableSets");
			ChecksArray.Add("TemporaryTableOfGoods_");
			
			Query = New Query;
			Query.Text = "
			|SELECT
			|	MAX(ReturnOfGoodsFromCustomer.ReusablePackageReturn) AS ToReturnReusablePackage,
			|	MAX(ReturnOfGoodsFromCustomer.DepositForPackageIsRequired)             AS PackageDepositIsRequired
			|FROM
			|	Document.ReturnOfGoodsFromCustomer AS ReturnOfGoodsFromCustomer
			|WHERE
			|	ReturnOfGoodsFromCustomer.Ref IN(&ArrayOfBases)";
			
			Query.SetParameter("ArrayOfBases", DocumentSales.Goods.UnloadColumn("DocumentBasis"));
			
			Selection = Query.Execute().Select();
			
			If Selection.Next() Then
				ReturnOfMultiTurnContainers = Selection.ToReturnReusablePackage;
				PackageDepositIsRequired      = Selection.PackageDepositIsRequired;
			EndIf;
			
			ChecksArray.Add("ControlOfFillingPricesAct");
		EndIf;
		
	// CERTIFICATE OF DISCREPANCIES AFTER SHIPMENT
		
	ElsIf TableName = "Document.DiscrepancyReportFollowingShipment" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		If DocumentSales.Status <> Enums.StatusesOfDiscrepancyReport.NotApproved Then
			ChecksArray.Add("CorrectFillingOfWarehouseInProductsTabularSection");
		EndIf;
		
		If Not DocumentSales.BusinessOperation = Enums.BusinessTransactions.TransferToStorageWithRightOfSale
			And Not DocumentSales.BusinessOperation = Enums.BusinessTransactions.TransferToToller2_5
			And Not DocumentSales.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent Then
			
			ChecksArray.Add("CorrectSelectionOfProductsForVATTaxation");
			ChecksArray.Add("ControlOfFillingPricesAct");
			
		EndIf;
		
		If Not TMCommonUseClientServer.AnExternalUserIsAuthorized() Then
			
			Query = New Query;
			Query.Text = "
			|SELECT
			|	MAX(CustomerInvoice.ToReturnReusablePackage) AS ToReturnReusablePackage,
			|	MAX(CustomerInvoice.PackageDepositIsRequired) AS PackageDepositIsRequired
			|FROM
			|	Document.CustomerInvoice AS CustomerInvoice
			|WHERE
			|	CustomerInvoice.Ref IN(&ArrayOfImplementations)
			|
			|UNION ALL
			|
			|SELECT
			|	MAX(GoodsHandover.ToReturnReusablePackage) AS ToReturnReusablePackage,
			|	FALSE AS PackageDepositIsRequired
			|FROM
			|	Document.TransferOfGoodsToBailee AS GoodsHandover
			|WHERE
			|	GoodsHandover.Ref IN(&ArrayOfImplementations)
			|";
			
			Query.SetParameter("ArrayOfImplementations", DocumentSales.Goods.UnloadColumn("SaleOfGoodsAndServices"));
			
			Selection = Query.Execute().Select();
			
			If Selection.Next() Then
				ReturnOfMultiTurnContainers = Selection.ToReturnReusablePackage;
				PackageDepositIsRequired      = Selection.PackageDepositIsRequired;
			EndIf;
			
		EndIf;
		
		If TransferOperations_.Find(DocumentSales.BusinessOperation) <> Undefined Then
			ChecksArray.Add("AvailabilityOfServicesWorks");
		EndIf;
		
		If UseBusinessUnits 
			And TransferOperations_.Find(DocumentSales.BusinessOperation) = Undefined Then
			ChecksArray.Add("CorrectFillingOfDivisionInTablePart");
		EndIf;

	// Cash register RECEIPT
		
	ElsIf TableName = "Document.CashRegisterReceipt" Then
		
		If LimitDiscountAdjustments Then
			
			ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
			ChecksArray.Add("TemporaryTableSetsPreparation");
			ChecksArray.Add("TemporaryTableSetsOptional");
			ChecksArray.Add("TemporaryTableSets");
			ChecksArray.Add("TemporaryTableOfGoods_");
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
		
	// ADJUSTMENT OF IMPLEMENTATION
	
	ElsIf TableName = "Document.SaleAdjustment" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		WarehouseInspection = True;
		
		If TypeOf(DocumentSales.DocumentBasis) = Type("DocumentRef.CustomerInvoice") Then
			DocumentBasisBusinessOperation = Common.ObjectAttributeValue(DocumentSales.DocumentBasis, "BusinessOperation");
			If ConsignmentSalesServer.SalesViaCommissionAgent(DocumentBasisBusinessOperation)
				Or DocumentBasisBusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods
				Then
				
				WarehouseInspection = False;
			EndIf;
		EndIf;
		If TypeOf(DocumentSales.DocumentBasis) = Type("DocumentRef.ReportToMaterialProvider2_5") Then
			DocumentBasisBusinessOperation = Common.ObjectAttributeValue(DocumentSales.DocumentBasis, "BusinessOperation");
			If DocumentBasisBusinessOperation = Enums.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5
				Or DocumentBasisBusinessOperation = Enums.BusinessTransactions.PerformRMUsingProvidedMaterials2_5 Then
				WarehouseInspection = False;
			EndIf;
		EndIf;
		If WarehouseInspection Then
			ChecksArray.Add("CorrectFillingOfWarehouse");
			ChecksArray.Add("CorrectFillingOfWarehouseInProductsTabularSection");
			If UseBusinessUnits Then
				ChecksArray.Add("CorrectFillingOfDivisionInTablePart");
			EndIf;
		EndIf;
		
		ChecksArray.Add("CorrectSelectionOfProductsForVATTaxation");
		If Not TypeOf(DocumentSales.DocumentBasis) = Type("DocumentRef.ReportToMaterialProvider2_5") Then
			ChecksArray.Add("PriceFillingControl");
			ChecksArray.Add("CorrectnessOfAmountAndAmountOfVAT");
		EndIf;
		If TypeOf(DocumentSales.DocumentBasis) = Type("DocumentRef.CustomerInvoice") Then
			ReturnOfMultiTurnContainers = Common.ObjectAttributeValue(DocumentSales.DocumentBasis, "ToReturnReusablePackage");
			PackageDepositIsRequired = Common.ObjectAttributeValue(DocumentSales.DocumentBasis, "PackageDepositIsRequired");
		EndIf;
		
		PresentationOfWarehouseField = NStr("vi = 'Người gửi';
											|ru = 'Отправитель';
											|en = 'Sender'; fa = 'فرستنده';
											|it = 'Отправитель';
											|pl = 'Nadawca';
											|tr = 'Gönderici'");
		
	Else
		
		SetPrivilegedMode(False);
		Return;
		
	EndIf;
	
	NotCheckLineCode = Not (DocumentType = Type("DocumentObject.CustomerInvoice")
		Or DocumentType = Type("DocumentObject.TransferOfGoodsToBailee"));

	ConsiderDiscountsMarkups = Not ((TableName = "Catalog.TermsOfSale") 
		Or (TableName = "Document.JobForSalesRepresentative")
		Or (TableName = "Document.ReturnOfGoodsFromCustomer"));
	
	GroupOfUsersWithSalesSettings = SalesSettingsForUsersServer.GetUserSGroupWithSalesSettingsForUser(
		Users.AuthorizedUser(), 
		"DiscountsMarkups");
	UsePriceChecks = UsePriceManagementSystem25
		And (ChecksArray.Find("EntryOfPricesIntoAcceptableRange") <> Undefined
			Or ChecksArray.Find("ComplianceOfGoodsWithSalesConditions") <> Undefined);
	
	ParametersForCheckingCorrectnessOfFilling = ParametersForCheckingCorrectnessOfFillingOutSalesDocument(DocumentSales, TableName, TSName, PresentationOfTS);
	ParametersForCheckingCorrectnessOfFilling.Insert("ConsiderDiscountsMarkups", ConsiderDiscountsMarkups);	
	ParametersForCheckingCorrectnessOfFilling.Insert("CheckDiscountsCalculated", CheckDiscountsCalculated);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseManualDiscounts", UseManualDiscounts);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseAutomaticDiscounts", UseAutomaticDiscounts);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseAdvancedFeaturesOfSalesOrder", UseAdvancedFeaturesOfSalesOrder);
	ParametersForCheckingCorrectnessOfFilling.Insert("ToUseTermsOfSales", ToUseTermsOfSales);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePartnersProducts", UsePartnersProducts);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePriceChecks", UsePriceChecks);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseUserRestrictions", UseUserRestrictions);
	ParametersForCheckingCorrectnessOfFilling.Insert("UseRestrictionsOnAgreements", UseRestrictionsOnAgreements);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePriceGroups", UsePriceGroups);
	ParametersForCheckingCorrectnessOfFilling.Insert("PresentationOfWarehouseField", PresentationOfWarehouseField);
	ParametersForCheckingCorrectnessOfFilling.Insert("UsePriceManagementSystem25", UsePriceManagementSystem25);
	
	SalesServerLocalization.CompleteArrayOfChecksOnCorrectnessOfFillingOutSalesDocument(ChecksArray, ParametersForCheckingCorrectnessOfFilling);
	
	// Let's form the text of the request for the necessary checks in accordance with the array of checks
	QueryText = "";
	QueryOptions = New Structure();
		
	QueryOptions.Insert("Date",					DocumentSales.Date);
	QueryOptions.Insert("DateOfReceiptOfVATRates", DateOfReceiptOfVATRates);
	QueryOptions.Insert("ThisIsConvention", DocumentType = Type("CatalogObject.TermsOfSale"));
	QueryOptions.Insert("Ref",        DocumentSales.Ref);
	QueryOptions.Insert("User",  Users.AuthorizedUser());
	QueryOptions.Insert("UsePaymentSchedules", GetFunctionalOption("UsePaymentSchedules"));
	QueryOptions.Insert("UseStatusesOfGoodsServicesSales", GetFunctionalOption("UseStatusesOfGoodsServicesSales"));
	QueryOptions.Insert("ReturnOfMultiTurnContainers", ReturnOfMultiTurnContainers);
	QueryOptions.Insert("PackageDepositIsRequired", PackageDepositIsRequired);
	QueryOptions.Insert("SumOfMutualSettlementsOfRealization", SumOfMutualSettlementsOfRealization);
	QueryOptions.Insert("AmountOfCollateralForImplementation", AmountOfCollateralForImplementation);
	QueryOptions.Insert("DepositAmountNotSpecified", False);
	QueryOptions.Insert("NotCheckLineCode", NotCheckLineCode);
	QueryOptions.Insert("ToUseTermsOfSales", ToUseTermsOfSales);
	QueryOptions.Insert("RegistrationCountry", SettingsValueClientServerCached.CountryOfOrganizationRegistration(
		Common.ObjectAttributeValue(DocumentSales.Ref, "Organization")));
	QueryOptions.Insert("ScheduleInAgreement", DocumentType = Type("DocumentObject.CustomerInvoiceServices")
	                                               Or DocumentType = Type("DocumentObject.CustomerInvoice"));
		
	If UseRestrictionsOnAgreements Then
		QueryOptions.Insert("CustomerTermsOfSales", DocumentSales.Terms);
	EndIf;

	QueryOptions.Insert("UsersGroup", GroupOfUsersWithSalesSettings);
	
	GenerateQueryTextToVerifyThatSalesDocumentIsFilledInCorrectly(QueryText, QueryOptions, ChecksArray, ParametersForCheckingCorrectnessOfFilling);
		
	If Not ValueIsFilled(QueryText) Then
		SetPrivilegedMode(False);
		Return;
	EndIf;

	Query = New Query(QueryText);
	
	For Each QueryParameter In QueryOptions Do
		Query.SetParameter(QueryParameter.Key, QueryParameter.Value);
	EndDo;
	
	ResultsArray = Query.ExecuteBatch(); 
	
	// We will inform the user about the verification results for each query result	
	ReportErrorsInCheckingCorrectnessOfSalesDocument(ChecksArray, ResultsArray, ParametersForCheckingCorrectnessOfFilling, Cancel);
	
	SetPrivilegedMode(False);

EndProcedure

// Generates the Query Text for performing checks.
//
// Parameters:
//  QueryText - String
//  QueryOptions - Structure of KeyAndValue - request parameters
//  ChecksArray - Array of String
//  ParametersForCheckingCorrectnessOfFilling - See ParametersForCheckingCorrectnessOfFillingOutSalesDocument
//
Procedure GenerateQueryTextToVerifyThatSalesDocumentIsFilledInCorrectly(QueryText, QueryOptions, ChecksArray, ParametersForCheckingCorrectnessOfFilling) Export
	
	DocumentSales = ParametersForCheckingCorrectnessOfFilling.DocumentSales;
	TableName = ParametersForCheckingCorrectnessOfFilling.TableName;
	ConsiderDiscountsMarkups = ParametersForCheckingCorrectnessOfFilling.ConsiderDiscountsMarkups;
	UsePriceChecks = ParametersForCheckingCorrectnessOfFilling.UsePriceChecks;
	UsePriceGroups = ParametersForCheckingCorrectnessOfFilling.UsePriceGroups;
	UseUserRestrictions = ParametersForCheckingCorrectnessOfFilling.UseUserRestrictions;
	UseRestrictionsOnAgreements = ParametersForCheckingCorrectnessOfFilling.UseRestrictionsOnAgreements;
	UsePriceManagementSystem25 = ParametersForCheckingCorrectnessOfFilling.UsePriceManagementSystem25;
	
	For Each CurItem In ChecksArray Do

		If CurItem = "TemporaryTableSalesDocument" Then
		
			CreateQueryTemporaryTableSalesDocumentHeader(QueryText, QueryOptions, DocumentSales);
		
		ElsIf CurItem = "TemporaryTableOfGoods_" Then
			
			GenerateTemporaryTableProductsQueryOfSalesDocument(QueryText, 
																		QueryOptions, 
																		DocumentSales, 
																		TableName, 
																		ConsiderDiscountsMarkups, 
																		,
																		UsePriceChecks);

		ElsIf CurItem = "TempTableGoodsFromReturnedGoodsReturnOfGoodsRequestsFromCustomer" Then
			
			GenerateTemporaryTableProductsQueryOfSalesDocument(QueryText, 
																		QueryOptions, 
																		DocumentSales, 
																		TableName, 
																		ConsiderDiscountsMarkups, 
																		,
																		UsePriceChecks,
																		CurItem);

		ElsIf CurItem = "TemporaryTablePriceGroups" Then
		
			CreateQueryTemporaryTablePriceGroupsOfSalesDocument(QueryText, QueryOptions, DocumentSales);
		
		ElsIf CurItem = "TimeTableStagesOfPaymentSchedule" Then
		
			GenerateQueryTemporaryTablePaymentStagesOfSalesDocument(QueryText, QueryOptions, DocumentSales);
			
		ElsIf CurItem = "TemporaryTableCurrencyExchangeRates" Then
			
			GenerateQueryTemporaryTableCurrencyExchangeRates(QueryText, QueryOptions, DocumentSales);
			
		ElsIf CurItem = "TemporaryTableWarehousesCorrectByAgreement" Then
			
			GenerateRequestTemporaryTableWarehousesCorrectByAgreement(QueryText);
			
		ElsIf CurItem = "ComplianceOfHeaderWithSalesConditions" Then
			
			GenerateSalesDocumentHeaderRequest(QueryText, TableName);
			
		ElsIf CurItem = "DuplicatesOfProducts" Then
			
			GenerateRequestForDuplicateItemsInSalesDocument(QueryText);
			
		ElsIf CurItem = "ComplianceOfGoodsWithSalesConditions" Then
			
			GenerateRequestProductsForSale(QueryText, TableName, UsePriceChecks);
			
		ElsIf CurItem = "DuplicatesOfPriceGroups" Then
			
			GenerateRequestForDuplicatesOfPriceGroupsInSalesDocument(QueryText);
			
		ElsIf CurItem = "CorrespondenceBetweenPriceGroupsAndSalesConditions" Then
			
			GenerateQueryThatMatchesProductPriceGroupsToSalesConditions(QueryText);
			
		ElsIf CurItem = "WhetherProductsBelongToProductSegment" Then
			
			CreateQueryWhetherProductsBelongToProductSegment(QueryText);
			
		ElsIf CurItem = "PartnerSAffiliationToPartnerSegment" Then
			
			GenerateQueryWhetherPartnerBelongsToPartnerSegment(QueryText);
			
		ElsIf CurItem = "CorrectnessOfPaymentScheduleStages" Then
			
			GenerateRequestForCorrectnessOfPaymentScheduleStages(QueryText, QueryOptions);
			
		ElsIf CurItem = "EntryOfPricesIntoAcceptableRange" Then
			
			GenerateRequestForPricesInAcceptableRange(QueryText, UsePriceChecks);
			
		ElsIf CurItem = "AvailabilityOfServicesWorks" Then
			
			GenerateRequestForAvailabilityOfServicesWorksInSalesDocument(QueryText);
			
		ElsIf CurItem = "AvailabilityOfTareServices" Then
			
			GenerateRequestForAvailabilityOfContainerServicesInSalesDocument(QueryText);
		ElsIf CurItem = "CorrectFillingOfWarehouseInGiverSOrder" Then
			
			GenerateRequestForCorrectnessOfFillingWarehouseInGiverSOrder(QueryText);
			
		ElsIf CurItem = "CorrectFillingOfWarehouseInTablePartOfGoodsOfGiverSOrder" Then
			
			GenerateRequestForCorrectnessOfFillingWarehousesInTablePartOfGoodsOfGiverSOrder(QueryText);
		ElsIf CurItem = "CorrectFillingOfWarehouse" Then
			
			GenerateRequestWhetherWarehouseIsFilledInCorrectly(QueryText);
			
		ElsIf CurItem = "CorrectFillingOfWarehouseInCustomerSOrder" Then
			
			GenerateRequestWhetherWarehouseIsFilledInCorrectlyInClientSOrder(QueryText);
			
		ElsIf CurItem = "CorrectFillingOfWarehouseInProductsTabularSection" Then
			
			GenerateRequestForCorrectFillingOfWarehousesInProductsTabularSection(QueryText, TableName);
			
		ElsIf CurItem = "CorrectFillingOfDivisionInTablePart" Then
			
			ToFormRequestForCorrectnessOfFillingInDivisionsInTabularPartOfGoods(QueryText, TableName);
			
		ElsIf CurItem = "TemporaryTableLimitingManualDiscountsForAUserGroup" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableLimitingManualDiscountsUserGroups(QueryText);
			
		ElsIf CurItem = "TemporaryTableManualDiscountRestrictionsUserGroupRestrictions" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableRestrictionOfManualDiscountsRestrictionsOnUserGroups(QueryText, UsePriceGroups);
			
		ElsIf CurItem = "TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions" Then
			
			SalesSettingsForUsersServer.CreateTemporaryTableQueryLimitingManualDiscountsRestrictionsOnGroupsAndUsers(QueryText, UsePriceGroups);
			
		ElsIf CurItem = "TemporaryTableLimitationOfManualDiscountsGeneralRestrictions" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableManualDiscountRestrictionGeneralRestrictions(QueryText, UsePriceGroups, UseUserRestrictions, UseRestrictionsOnAgreements);
			
		ElsIf CurItem = "TemporaryTableLimitingManualDiscounts" Then
			
			SalesSettingsForUsersServer.CreateRequestTemporaryTableLimitingManualDiscounts(QueryText);
			
		ElsIf CurItem = "ToleranceForManualMarkUpDiscounts" Then
			
			GenerateRequestWhetherManualDiscountsAndSurchargesAreAcceptable(QueryText);
			
		ElsIf CurItem = "TemporaryTablePaymentStepsTermsStandard" Then
			
			GenerateRequestTemporaryTableStagesOfPaymentOfStandardAgreement(QueryText, QueryOptions, DocumentSales);
			
		ElsIf CurItem = "TemporaryTableStagesOfPaymentOfIndividualAgreement" Then
			
			CreateRequestTemporaryTablePaymentStagesAgreementIndividual(QueryText, QueryOptions, DocumentSales);
			
		ElsIf CurItem = "CorrectnessOfPaymentStagesOfAgreement" Then
			
			GenerateRequestForCorrectnessOfPaymentStagesOfAgreement(QueryText);
			
		ElsIf CurItem = "NumberOfPaymentStagesIsCorrect" Then
			
			GenerateRequestForCorrectnessOfNumberOfPaymentStagesOfAgreement(QueryText);
			
		ElsIf CurItem = "TemporaryTableOfSettlementAmounts" Then
			
			GenerateRequestTemporaryTableOfSettlementAmounts(QueryText);
			
		ElsIf CurItem = "ComplianceOfPrepaymentAmountWithPaymentSchedule" Then
			
			GenerateRequestThatMatchesPrepaymentAmountToPaymentSchedule(QueryText);
		ElsIf CurItem = "ControlOfCompletionOfCalculations" Then
			
			GenerateRequestForPaymentCompletionControl(QueryText);
			
		ElsIf CurItem = "ControlOfShipmentCompletion" Then
			
			GenerateRequestMonitoringShipmentCompletion(QueryText);
			
		ElsIf CurItem = "ControlOfShipmentCompletion2_5" Then
			
			GenerateRequestMonitoringShipmentCompletion2_5(QueryText);
		ElsIf CurItem = "PriceFillingControl" Then
			
			GenerateRequestToFillInPrices(QueryText);
			
		ElsIf CurItem = "ControlOfFillingPricesAct" Then
			
			FormRequestForPriceFillingControlAct(QueryText);
			
		ElsIf CurItem = "ReportDesignControl2_5" Then
		
			GenerateRequestControlDesignOfReports2_5(QueryText)
		ElsIf CurItem = "ControlOfFillingOfPricesTakingIntoAccountCancelledOnes" Then
			
			CreateRequestToControlFillingInPricesBasedOnCanceledPrices(QueryText);
			
		ElsIf CurItem = "AvailabilityOfAlcoholicBeverages" Then
			
			GenerateRequestForPresenceOfAlcoholicBeveragesInSalesDocument(QueryText);
			
		ElsIf CurItem = "CorrectFillingInOfPartnerProducts" Then
			
			PartnersProductsServer.GenerateRequestForFillingInPartnerProductListCorrectly(QueryText, QueryOptions);

		ElsIf CurItem = "CorrectVATAmount" Then
			
			GenerateRequestForCorrectVATAmount(QueryText, QueryOptions);
		
		ElsIf CurItem = "CorrectIndicationOfVATRate" Then
		
			If UsePriceManagementSystem25 Then
				GenerateRequestForCorrectnessOfSpecifyingSalesVATRate25(QueryText);
			Else
				GenerateRequestForCorrectnessOfSpecifyingSalesVATRate(QueryText);
			EndIf;
		
		ElsIf CurItem = "CorrectnessOfAmountAndAmountOfVAT" Then
			
			GenerateRequestForCorrectAmountAndVATAmount(QueryText);
			
		ElsIf CurItem = "CorrectSelectionOfProductsForVATTaxation" Then
			QueryText = QueryText 
				+ VATAccountingERP.TextOfRequestCorrectnessOfSelectionOfProductsForTaxationOfVATSales(QueryOptions);
				
		ElsIf CurItem = "DirectionOfActivityOnAccountingOfDOHSAndExpenses" Then
			
			GenerateRequestForVerificationOfDirectionOfActivityForAccountingForIncomeAndExpenses(QueryText);
			
		ElsIf CurItem = "UsingOrderToClientAccordingToSeparationOption" Then
			
			GenerateRequestToVerifyPossibilityOfUsingClientSOrderAccordingToSeparationOption(QueryText);
			
		EndIf;
		
		SalesServerLocalization.CompleteRequestsForVerificationOfCorrectnessOfFillingOutSalesDocument(
					CurItem,
					QueryText, 
					QueryOptions, 
					ParametersForCheckingCorrectnessOfFilling);
					
	EndDo;

EndProcedure

// Displays an error message when checking the correctness of the sales document.
//
// Parameters:
//  ChecksArray - Array of String -
//  ResultsArray - Array of QueryResult
//  ParametersForCheckingCorrectnessOfFilling - See ParametersForCheckingCorrectnessOfFillingOutSalesDocument
//  Cancel - Boolean
//
Procedure ReportErrorsInCheckingCorrectnessOfSalesDocument(ChecksArray, ResultsArray, ParametersForCheckingCorrectnessOfFilling, Cancel) Export
	
	DocumentSales = ParametersForCheckingCorrectnessOfFilling.DocumentSales;
	TableName = ParametersForCheckingCorrectnessOfFilling.TableName;
	TSName = ParametersForCheckingCorrectnessOfFilling.TSName;
	PresentationOfTS = ParametersForCheckingCorrectnessOfFilling.PresentationOfTS;
	PresentationOfWarehouseField = ParametersForCheckingCorrectnessOfFilling.PresentationOfWarehouseField;

	CheckDiscountsCalculated = ParametersForCheckingCorrectnessOfFilling.CheckDiscountsCalculated;
	UseManualDiscounts = ParametersForCheckingCorrectnessOfFilling.UseManualDiscounts;
	UseAutomaticDiscounts = ParametersForCheckingCorrectnessOfFilling.UseAutomaticDiscounts;
	UseAdvancedFeaturesOfSalesOrder = ParametersForCheckingCorrectnessOfFilling.UseAdvancedFeaturesOfSalesOrder;
	
	If CheckDiscountsCalculated Then
		ReportErrorsDiscountsNotCalculated(DocumentSales, Cancel);
	EndIf;
	
	ImpossibleToHoldWithoutApproval = False;
	For CurIndex__ = 0 To ResultsArray.Count()-1 Do
		
		Selection = ResultsArray[CurIndex__].Select();
		
		If ChecksArray[CurIndex__] = "ComplianceOfHeaderWithSalesConditions" Then
			
			ReportErrorsSalesDocumentHeader(Selection,DocumentSales,ImpossibleToHoldWithoutApproval);
			
		ElsIf ChecksArray[CurIndex__] = "DuplicatesOfProducts" Then
			
			ReportErrorsIfThereAreDuplicatesOfProductsInSalesDocument(Selection, DocumentSales, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "ComplianceOfGoodsWithSalesConditions" Then
			
			ReportErrorsInSalesDocument(Selection, DocumentSales, ImpossibleToHoldWithoutApproval);

		ElsIf ChecksArray[CurIndex__] = "DuplicatesOfPriceGroups" Then

			ReportErrorsDuplicatePriceGroupsInSalesDocument(Selection, DocumentSales, Cancel);

		ElsIf ChecksArray[CurIndex__] = "CorrespondenceBetweenPriceGroupsAndSalesConditions" Then

			ReportErrorsThatProductPriceGroupsMeetSalesConditions(Selection, DocumentSales, ImpossibleToHoldWithoutApproval);

		ElsIf ChecksArray[CurIndex__] = "WhetherProductsBelongToProductSegment" Then

			ReportErrorsWhetherProductsBelongToProductSegment(Selection, DocumentSales, ImpossibleToHoldWithoutApproval);

		ElsIf ChecksArray[CurIndex__] = "PartnerSAffiliationToPartnerSegment" Then
			
			ReportErrorsWhetherPartnerBelongsToPartnerSegment(Selection, DocumentSales, ImpossibleToHoldWithoutApproval);

		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfPaymentScheduleStages" Then

			ReportErrorsCorrectnessOfPaymentScheduleStages(Selection, DocumentSales, ImpossibleToHoldWithoutApproval);

		ElsIf ChecksArray[CurIndex__] = "EntryOfPricesIntoAcceptableRange" Then

			ReportErrorsWhenPricesFallWithinAcceptableRange(Selection, DocumentSales, ImpossibleToHoldWithoutApproval, UseManualDiscounts Or UseAutomaticDiscounts);

		ElsIf ChecksArray[CurIndex__] = "AvailabilityOfServicesWorks" Then

			ReportErrorsAvailabilityOfServicesWorksInSalesDocument(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);

		ElsIf ChecksArray[CurIndex__] = "AvailabilityOfTareServices" Then

			ReportErrorsAvailabilityOfPackagingServicesInSalesDocument(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);

		ElsIf ChecksArray[CurIndex__] = "AvailabilityOfAlcoholicBeverages" Then

			ReportErrorsPresenceOfAlcoholicBeveragesInSalesDocument(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);

		ElsIf ChecksArray[CurIndex__] = "ToleranceForManualMarkUpDiscounts" Then

			ReportErrorsAcceptanceOfManualDiscountsMargins(Selection, DocumentSales, Cancel);
		ElsIf ChecksArray[CurIndex__] = "CorrectFillingOfWarehouseInGiverSOrder" Then
			
			ReportErrorsCorrectFillingOfGiverSOrderWarehouse(Selection, DocumentSales, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "CorrectFillingOfWarehouseInTablePartOfGoodsOfGiverSOrder" Then
			
			ReportErrorsCorrectnessOfFillingInWarehouseInTableSectionGoodsOfGiverSOrder(Selection, DocumentSales, Cancel);
		ElsIf ChecksArray[CurIndex__] = "CorrectFillingOfWarehouse"
			Or ChecksArray[CurIndex__] = "CorrectFillingOfWarehouseInCustomerSOrder" Then

			ReportErrorsCorrectWarehouseFilling(Selection, DocumentSales, Cancel);

		ElsIf ChecksArray[CurIndex__] = "CorrectFillingOfWarehouseInProductsTabularSection" Then
			
			If ParametersForCheckingCorrectnessOfFilling.TableName = "Document.ReturnOfGoodsFromCustomer" Then
				
				PresentationOfWarehouseField = NStr("vi = 'Người nhận';
													|ru = 'Получатель';
													|en = 'Customer'; fa = 'مشتری';
													|it = 'Получатель';
													|pl = 'Odbiorca';
													|tr = 'Alıcı'")
				
			ElsIf ParametersForCheckingCorrectnessOfFilling.TableName = "Document.RequestForReturnOfGoodsFromCustomer" Then
				
				PresentationOfWarehouseField = NStr("vi = 'Người gửi';
													|ru = 'Отправитель';
													|en = 'Sender'; fa = 'فرستنده';
													|it = 'Отправитель';
													|pl = 'Sender';
													|tr = 'Gönderici'")
				
			EndIf;	
			
			ReportErrorsInFillingOutWarehouseCorrectlyInProductsTabularSection(Selection, DocumentSales, Cancel, PresentationOfWarehouseField);
		
		ElsIf ChecksArray[CurIndex__] = "CorrectFillingOfDivisionInTablePart" Then

			ReportErrorsCorrectnessOfFillingInDivisionInTabularPartOfGoods(Selection, DocumentSales, Cancel);

		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfPaymentStagesOfAgreement" Then

			ReportErrorsCorrectnessOfPaymentStagesInAgreement(Selection, DocumentSales, ImpossibleToHoldWithoutApproval);

		ElsIf ChecksArray[CurIndex__] = "NumberOfPaymentStagesIsCorrect" Then

			ReportErrorsCorrectnessOfNumberOfPaymentStagesInAgreement(Selection, DocumentSales, Cancel);

		ElsIf ChecksArray[CurIndex__] = "ComplianceOfPrepaymentAmountWithPaymentSchedule" Then

			ReportErrorsThatPrepaymentAmountMatchesPaymentSchedule(Selection, DocumentSales, Cancel);
		ElsIf ChecksArray[CurIndex__] = "ControlOfCompletionOfCalculations" Then

			ReportErrorsMonitoringCompletionOfCalculations(Selection, DocumentSales, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "ControlOfShipmentCompletion" Then

			ReportErrorsMonitoringShipmentCompletion(Selection, DocumentSales, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "ControlOfShipmentCompletion2_5" Then
			
			ReportErrorsMonitoringShipmentCompletion(Selection, DocumentSales, Cancel);

		ElsIf ChecksArray[CurIndex__] = "ReportDesignControl" Then
			
			ReportErrorsReportDesignControl(Selection, DocumentSales, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "ReportDesignControl2_5" Then
			
			ReportErrorsReportDesignControl(Selection, DocumentSales, Cancel);
		ElsIf ChecksArray[CurIndex__] = "PriceFillingControl" 
			Or ChecksArray[CurIndex__] = "ControlOfFillingOfPricesTakingIntoAccountCancelledOnes"
			Or ChecksArray[CurIndex__] = "ControlOfFillingPricesAct" Then

			ReportErrorsPriceFillingControl(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "CorrectFillingInOfPartnerProducts" Then
			
			PartnersProductsServer.ReportErrorsCorrectFillingOfPartnerProducts(Selection, DocumentSales, Cancel);

		ElsIf ChecksArray[CurIndex__] = "CorrectVATAmount" Then 
		
			ReportErrorsCorrectnessOfVATAmount(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);
		
		ElsIf ChecksArray[CurIndex__] = "CorrectIndicationOfVATRate" Then
		
			ReportErrorsCorrectnessOfSpecifyingSalesVATRate(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);
		
		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfAmountAndAmountOfVAT" Then 
		
			ReportErrorsCorrectnessOfAmountAndVATAmount(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);
			
		ElsIf  ChecksArray[CurIndex__] = "CorrectSelectionOfProductsForVATTaxation" Then

			VATAccountingERP.ReportErrorsCorrectSelectionOfProductsForVATSales(Selection, DocumentSales, TSName, PresentationOfTS, Cancel);

		ElsIf ChecksArray[CurIndex__] = "DirectionOfActivityOnAccountingOfDOHSAndExpenses" Then
			
			ReportErrorInChoosingBusinessLine(Selection, DocumentSales, Cancel);
			
		ElsIf ChecksArray[CurIndex__] = "UsingOrderToClientAccordingToSeparationOption" Then
			
			ReportErrorInPossibilityOfUsingCustomerSOrder(Selection, DocumentSales, Cancel);
			
		EndIf;
		SalesServerLocalization.ReportErrorsInCheckingCorrectnessOfSalesDocument(
				ChecksArray[CurIndex__], Selection, ParametersForCheckingCorrectnessOfFilling, Cancel);
				
	EndDo;
	
	If ImpossibleToHoldWithoutApproval Then
		ErrorText = NStr("vi = 'Không đủ quyền để làm sai lệch với điều kiện bán hàng.';
						|ru = 'Недостаточно прав на отклонение от условий продаж.';
						|en = 'Insufficient rights to deviate from sales terms and conditions.'; fa = 'Insufficient rights to deviate from sales terms and conditions.';
						|it = 'Недостаточно прав на отклонение от условий продаж.';
						|pl = 'Nie masz wystarczających uprawnień na odstępstwo od warunków sprzedaży.';
						|tr = 'Satış şartlarından sapmak için yetersiz erişim yetkileri.'");
		
		If (TableName = "Document.SalesOrder"
			Or TableName = "Document.RequestForReturnOfGoodsFromCustomer") And UseAdvancedFeaturesOfSalesOrder Then
				ErrorText = ErrorText + " " + NStr("vi = 'Cần kết chuyển chứng từ với trạng thái ""Cần thống nhất"".';
													|ru = 'Документ необходимо провести в статусе ""На согласовании"".';
													|en = 'Post the document in the ""Pending approval"" status.'; fa = 'Post the document in the ""Pending approval"" status.';
													|it = 'Документ необходимо провести в статусе ""На согласовании"".';
													|pl = 'Dokument należy zatwierdzić w statusie ""Na uzgodnienie"".';
													|tr = 'Belge ""Onay bekliyor"" durumunda kaydedilmelidir.'");
		EndIf;
		
		ReportErrorToUser(
			ErrorText,
			DocumentSales,
			,
			Cancel);
	EndIf;
	
EndProcedure

// Checks the correctness of filling in the sales document in accordance with the array of checks
// by executing a batch of requests. Is called from the procedure of the document "Obrabatyvaniya".
//
// Parameters:
// 	DocumentSales                      - DocumentRef - Document to be checked for
// 	ThereAreVariancesFromPriceConditions       - Boolean - Indication of deviation from price conditions
// 	ThereAreVariancesFromFinancialConditions    - Boolean - Indication of deviation from financial conditions
// 	ThereAreVariancesFromLogisticConditions - Boolean - The sign of deviation from the logistic conditions
//
Procedure CheckNeedToAgreeOnTermsOfSale(Val DocumentSales,
	                                                       ThereAreVariancesFromPriceConditions,
	                                                       ThereAreVariancesFromFinancialConditions,
	                                                       ThereAreVariancesFromLogisticConditions) Export
	
	SetPrivilegedMode(True);
	
	// Let's check whether it is necessary to check the range of acceptable prices
	KindOfMaximumAllowableSellingPrices = Constants.KindOfMaximumAllowableSellingPrices.Get();
	KindOfMinimumAllowableSellingPrices  = Constants.KindOfMinimumAllowableSellingPrices.Get();
	CheckPriceRange               = ValueIsFilled(KindOfMaximumAllowableSellingPrices) Or ValueIsFilled(KindOfMinimumAllowableSellingPrices);
	
	// Let's check whether it is necessary to check discounts and margins
	UseAutomaticDiscounts = GetFunctionalOption("UseDiscountsMarkupsInSales");
	UseManualDiscounts         = GetFunctionalOption("UseDiscountAdjustmentsInSales");
	CheckDiscountsMarkups           = UseAutomaticDiscounts Or UseManualDiscounts;
	UsePriceGroups                    = GetFunctionalOption("UsePriceGroups");
	UseUserRestrictions = GetFunctionalOption("UseLimitsForDiscountAdjustmentsInSalesByUsers");
	UseRestrictionsOnAgreements         = GetFunctionalOption("UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales");
	LimitDiscountAdjustments          = UseManualDiscounts And (UseUserRestrictions Or UseRestrictionsOnAgreements);
	ToUseTermsOfSales  = GetFunctionalOption("ToUseTermsOfSales");
	
	// Fill in the array of necessary checks depending on the type of document
	ChecksArray  = New Array();
	DocumentType      = TypeOf(DocumentSales);
	TableName = DocumentSales.Metadata().FullName();
	
	RequestByHeader = New Query("
		|SELECT
		|	DocumentSales.Date AS Date,
		|	UNDEFINED AS DateOfShipment,
		|	FALSE AS NotShipInInstallments,
		|	FALSE AS Standard_
		|FROM
		|	&TableName AS DocumentSales
		|WHERE
		|	DocumentSales.Ref = &DocumentSales
		|");
	
	If TableName = "Catalog.TermsOfSale" Then
		RequestByHeader.Text = StrReplace(RequestByHeader.Text, "FALSE AS Standard_", "DocumentSales.Standard_ AS Standard_");
	EndIf;
	
	If DocumentType = Type("DocumentRef.SalesOrder")
			Or DocumentType = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
		RequestByHeader.Text = StrReplace(RequestByHeader.Text, "UNDEFINED AS DateOfShipment", "DocumentSales.DateOfShipment AS DateOfShipment");
		RequestByHeader.Text = StrReplace(RequestByHeader.Text, "FALSE AS NotShipInInstallments", "DocumentSales.NotShipInInstallments AS NotShipInInstallments");
	EndIf;
	RequestByHeader.Text = StrReplace(RequestByHeader.Text, "&TableName", TableName);
	
	RequestByHeader.SetParameter("DocumentSales", DocumentSales);
	SelectionByHeader = RequestByHeader.Execute().Select();
	SelectionByHeader.Next();
	
	ReturnOfMultiTurnContainers = False;
	PackageDepositIsRequired = False;
	
	// Date Of Receipt Of VAT Rates
	DateOfReceiptOfVATRates = SelectionByHeader.Date;
	If SelectionByHeader.NotShipInInstallments And ValueIsFilled(SelectionByHeader.DateOfShipment) Then			
		DateOfReceiptOfVATRates = SelectionByHeader.DateOfShipment;
	EndIf;
	UsePriceManagementSystem25 = PriceManagementSystemServerCall.UsePriceManagementSystem25(SelectionByHeader.Date);
	
	// AGREEMENT WITH THE CLIENT
	
	If TableName = "Catalog.TermsOfSale" Then
		
		If Not SelectionByHeader.Standard_ Then
		
			ChecksArray.Add("TemporaryTableSalesDocument");
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("TemporaryTablePaymentStepsTermsStandard");
			ChecksArray.Add("TemporaryTableStagesOfPaymentOfIndividualAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
			ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
			ChecksArray.Add("TemporaryTableOfGoods_");
			ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
			ChecksArray.Add("CorrectnessOfPaymentStagesOfAgreement");
			ChecksArray.Add("NumberOfPaymentStagesIsCorrect");
			
			DetailsOfSalesDocument = Common.ObjectAttributesValues(DocumentSales, "ReturnReusablePackage, PackageDepositIsRequired");
			ReturnOfMultiTurnContainers = DetailsOfSalesDocument.ReturnReusablePackage;
			PackageDepositIsRequired = DetailsOfSalesDocument.PackageDepositIsRequired;
			
			If CheckPriceRange Then
				ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
			EndIf;
			
			ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
			
			UsePriceGroups = GetFunctionalOption("UsePriceGroups");
			
			If UsePriceGroups Then
				
				ChecksArray.Add("TemporaryTablePriceGroups");
				ChecksArray.Add("CorrespondenceBetweenPriceGroupsAndSalesConditions");
			
			EndIf;
			
		EndIf;
			
	// Sales order
	
	ElsIf TableName = "Document.SalesOrder" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		ChecksArray.Add("CorrectnessOfAmountAndAmountOfVAT");

		If UsePriceManagementSystem25 Then
			ChecksArray.Add("TempTableOfTSONomenclature");
			ChecksArray.Add("TempTableOfPriceOfItemOfCentralOffice");
			ChecksArray.Add("TempTableOfCentralBankPrices");
		EndIf;
		ChecksArray.Add("CorrectIndicationOfVATRate");
		ChecksArray.Add("CorrectVATAmount");
		ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
		
		DetailsOfSalesDocument = Common.ObjectAttributesValues(DocumentSales, "ToReturnReusablePackage, PackageDepositIsRequired");
		ReturnOfMultiTurnContainers = DetailsOfSalesDocument.ToReturnReusablePackage;
		PackageDepositIsRequired = DetailsOfSalesDocument.PackageDepositIsRequired;
		
		If ToUseTermsOfSales Then
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
			ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
		EndIf;
		
		If LimitDiscountAdjustments Then
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
			
		If CheckPriceRange Then
			ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
		EndIf;
		
		ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
		ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
		
	// Request for return of goods from the client
	
	ElsIf TableName = "Document.RequestForReturnOfGoodsFromCustomer" Then
		
		DetailsOfSalesDocument = Common.ObjectAttributesValues(DocumentSales, "CompensationMethod, ToReturnReusablePackage, PackageDepositIsRequired");
		NeedReplacementGoods = DetailsOfSalesDocument.CompensationMethod = Enums.CompensationMethodsForReturnsOfGoods.ToSubstituteGoods;
		ReturnOfMultiTurnContainers = DetailsOfSalesDocument.ToReturnReusablePackage;
		PackageDepositIsRequired = DetailsOfSalesDocument.PackageDepositIsRequired;
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		If NeedReplacementGoods Then
			
			If UsePriceManagementSystem25 Then
				ChecksArray.Add("TempTableOfTSONomenclature");
				ChecksArray.Add("TempTableOfPriceOfItemOfCentralOffice");
				ChecksArray.Add("TempTableOfCentralBankPrices");
			EndIf;

			ChecksArray.Add("CorrectIndicationOfVATRate");
			ChecksArray.Add("CorrectVATAmount");
		EndIf;
		
		ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
		
		If ToUseTermsOfSales Then
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
			ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
		EndIf;
		
		If LimitDiscountAdjustments Then
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
			
		If CheckPriceRange Then
			ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
		EndIf;
		
		ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
		ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
		
	Else
		
		SetPrivilegedMode(False);
		Return;
		
	EndIf;
	
	ConsiderDiscountsMarkups = Not ((TableName = "Catalog.TermsOfSale") Or (TableName = "Document.JobForSalesRepresentative"));
	
	// Let's form the text of the request for the necessary checks in accordance with the array of checks

	QueryText     = "";
	QueryOptions = New Structure();
	
	NotCheckLineCode = Not (DocumentType = Type("DocumentObject.CustomerInvoice")
				Or DocumentType = Type("DocumentObject.TransferOfGoodsToBailee"));
	
	QueryOptions.Insert("Date", SelectionByHeader.Date);
	QueryOptions.Insert("DateOfReceiptOfVATRates", DateOfReceiptOfVATRates);
	QueryOptions.Insert("ThisIsConvention", TableName = "Catalog.TermsOfSale");
	QueryOptions.Insert("User",  Users.CurrentUser());
	QueryOptions.Insert("UsePaymentSchedules", GetFunctionalOption("UsePaymentSchedules"));
	QueryOptions.Insert("ReturnOfMultiTurnContainers", ReturnOfMultiTurnContainers);
	QueryOptions.Insert("PackageDepositIsRequired", PackageDepositIsRequired);
	QueryOptions.Insert("NotCheckLineCode", NotCheckLineCode);
	QueryOptions.Insert("ToUseTermsOfSales", ToUseTermsOfSales);
	QueryOptions.Insert("RegistrationCountry", SettingsValueClientServerCached.CountryOfOrganizationRegistration(
		Common.ObjectAttributeValue(DocumentSales, "Organization")));
	QueryOptions.Insert("ScheduleInAgreement", DocumentType = Type("DocumentObject.CustomerInvoiceServices")
	                                               Or DocumentType = Type("DocumentObject.CustomerInvoice"));
	
	If UseRestrictionsOnAgreements Then
		QueryOptions.Insert("CustomerTermsOfSales", Common.ObjectAttributeValue(DocumentSales, "Terms"));
	EndIf;
	
	GroupOfUsersWithSalesSettings = SalesSettingsForUsersServer.GetUserSGroupWithSalesSettingsForUser(
		Users.CurrentUser(), 
		"DiscountsMarkups"
	);
	QueryOptions.Insert("UsersGroup", GroupOfUsersWithSalesSettings);
	
	ByReference_ = True;
	
	UsePriceChecks = UsePriceManagementSystem25 
		And (ChecksArray.Find("EntryOfPricesIntoAcceptableRange") <> Undefined
			Or ChecksArray.Find("ComplianceOfGoodsWithSalesConditions") <> Undefined);
	
	For Each CurItem In ChecksArray Do

		If CurItem = "TemporaryTableSalesDocument" Then
		
			CreateQueryTemporaryTableSalesDocumentHeader(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
		
		ElsIf CurItem = "TemporaryTableOfGoods_" Then
		
			GenerateTemporaryTableProductsQueryOfSalesDocument(QueryText, 
																		QueryOptions, 
																		DocumentSales, 
																		TableName, 
																		ConsiderDiscountsMarkups, 
																		ByReference_,
																		UsePriceChecks);
		
		ElsIf CurItem = "TemporaryTablePriceGroups" Then
		
			CreateQueryTemporaryTablePriceGroupsOfSalesDocument(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
		
		ElsIf CurItem = "TimeTableStagesOfPaymentSchedule" Then
		
			GenerateQueryTemporaryTablePaymentStagesOfSalesDocument(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
			
		ElsIf CurItem = "TemporaryTableCurrencyExchangeRates" Then
			
			GenerateQueryTemporaryTableCurrencyExchangeRates(QueryText, QueryOptions, DocumentSales);
			
		ElsIf CurItem = "TemporaryTableWarehousesCorrectByAgreement" Then
			
			GenerateRequestTemporaryTableWarehousesCorrectByAgreement(QueryText);
			
		ElsIf CurItem = "ComplianceOfHeaderWithSalesConditions" Then
			
			GenerateSalesDocumentHeaderRequest(QueryText, TableName);

		ElsIf CurItem = "ComplianceOfGoodsWithSalesConditions" Then

			GenerateRequestProductsForSale(QueryText, TableName, UsePriceChecks);

		ElsIf CurItem = "CorrespondenceBetweenPriceGroupsAndSalesConditions" Then

			GenerateQueryThatMatchesProductPriceGroupsToSalesConditions(QueryText);

		ElsIf CurItem = "CorrectnessOfPaymentScheduleStages" Then

			GenerateRequestForCorrectnessOfPaymentScheduleStages(QueryText, QueryOptions);

		ElsIf CurItem = "EntryOfPricesIntoAcceptableRange" Then

			GenerateRequestForPricesInAcceptableRange(QueryText, UsePriceChecks);

		ElsIf  CurItem = "TemporaryTableLimitingManualDiscountsForAUserGroup" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableLimitingManualDiscountsUserGroups(QueryText);
			
		ElsIf  CurItem = "TemporaryTableManualDiscountRestrictionsUserGroupRestrictions" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableRestrictionOfManualDiscountsRestrictionsOnUserGroups(QueryText, UsePriceGroups);
			
		ElsIf  CurItem = "TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions" Then
			
			SalesSettingsForUsersServer.CreateTemporaryTableQueryLimitingManualDiscountsRestrictionsOnGroupsAndUsers(QueryText, UsePriceGroups);
			
		ElsIf  CurItem = "TemporaryTableLimitationOfManualDiscountsGeneralRestrictions" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableManualDiscountRestrictionGeneralRestrictions(QueryText, UsePriceGroups, UseUserRestrictions, UseRestrictionsOnAgreements);
			
		ElsIf  CurItem = "TemporaryTableLimitingManualDiscounts" Then
			
			SalesSettingsForUsersServer.CreateRequestTemporaryTableLimitingManualDiscounts(QueryText);
			
		ElsIf CurItem = "ToleranceForManualMarkUpDiscounts" Then
			
			GenerateRequestWhetherManualDiscountsAndSurchargesAreAcceptable(QueryText);
			
		ElsIf CurItem = "TemporaryTablePaymentStepsTermsStandard" Then
			
			GenerateRequestTemporaryTableStagesOfPaymentOfStandardAgreement(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
			
		ElsIf CurItem = "TemporaryTableStagesOfPaymentOfIndividualAgreement" Then
			
			CreateRequestTemporaryTablePaymentStagesAgreementIndividual(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
			
		ElsIf CurItem = "CorrectnessOfPaymentStagesOfAgreement" Then
			
			GenerateRequestForCorrectnessOfPaymentStagesOfAgreement(QueryText);
			
		ElsIf CurItem = "NumberOfPaymentStagesIsCorrect" Then
			
			GenerateRequestForCorrectnessOfNumberOfPaymentStagesOfAgreement(QueryText);
		
		ElsIf CurItem = "CorrectVATAmount" Then
			
			GenerateRequestForCorrectVATAmount(QueryText, QueryOptions);
		
		ElsIf CurItem = "CorrectIndicationOfVATRate" Then
		
			If UsePriceManagementSystem25 Then
				GenerateRequestForCorrectnessOfSpecifyingSalesVATRate25(QueryText);
			Else
				GenerateRequestForCorrectnessOfSpecifyingSalesVATRate(QueryText);
			EndIf;
		
		ElsIf CurItem = "CorrectnessOfAmountAndAmountOfVAT" Then
			
			GenerateRequestForCorrectAmountAndVATAmount(QueryText);
			
		EndIf;

	EndDo;
	
	If Not ValueIsFilled(QueryText) Then
		SetPrivilegedMode(False);
		Return;
	EndIf;

	Query = New Query(QueryText);
	
	For Each QueryParameter In QueryOptions Do
		Query.SetParameter(QueryParameter.Key, QueryParameter.Value);
	EndDo;
	
	ResultsArray = Query.ExecuteBatch(); 

	// We will inform the user about the verification results for each query result

	For CurIndex__ = 0 To ResultsArray.Count()-1 Do

		Selection = ResultsArray[CurIndex__].Select();

		If ChecksArray[CurIndex__] = "ComplianceOfHeaderWithSalesConditions" Then

			If ThereAreVariancesFromPriceConditions And ThereAreVariancesFromFinancialConditions And ThereAreVariancesFromLogisticConditions Then
				Continue;
			EndIf;

			If Selection.Next() Then

				If Selection.ThereAreErrorsInFillingInCurrency Or
					Selection.ThereAreErrorsInFillingOutCurrencyOfMutualSettlements Or
					Selection.ThereAreErrorsFillingViewPrices Or
					Selection.ThereAreErrorsInFillingPriceIncludesVAT Or
					Selection.ThereAreErrorsFillingPercentageOfManualDiscount Or
					Selection.ThereAreErrorsFillingPercentageManualMarkUp Then
					
					ThereAreVariancesFromPriceConditions = True;
					
				EndIf;
					
				If Selection.ThereAreErrorsFillingPaymentSchedule Or
					Selection.ThereAreErrorsFillingOutPaymentForm_ Or
					Selection.ThereAreErrorsInFillingOutPaymentForm Or
					Selection.ThereAreErrorsFillingCalendar Then

					ThereAreVariancesFromFinancialConditions = True;
					
				EndIf;

				If Selection.ThereAreErrorsFillingWarehouse Or
					Selection.ThereAreErrorsFillingDeliveryTime Then
					
					ThereAreVariancesFromLogisticConditions = True;
					
				EndIf;

			EndIf;
			
		ElsIf ChecksArray[CurIndex__] = "ComplianceOfGoodsWithSalesConditions" Then

			If ThereAreVariancesFromPriceConditions Then
				Continue;
			EndIf;
			
			While Selection.Next() Do

				If Selection.ThereAreErrorsInFillingInPrice Or
					(Selection.ThereAreErrorsFillingPriceView And Selection.PriceAgreement = 0) Then
					
					ThereAreVariancesFromPriceConditions = True;
					Continue;
				
				EndIf;

			EndDo;

		ElsIf ChecksArray[CurIndex__] = "CorrespondenceBetweenPriceGroupsAndSalesConditions" Then

			If ThereAreVariancesFromPriceConditions Then
				Continue;
			EndIf;
			
			While Selection.Next() Do

				If Selection.ThereAreErrorsFillingInPriceGroups
					Or Selection.ThereAreErrorsFillingViewPrices
					Or Selection.ThereAreErrorsFillingManualDiscount
					Or Selection.ThereAreErrorsFillingManualMarkUp Then
					
					ThereAreVariancesFromPriceConditions = True;
					Continue;
					
				EndIf;

			EndDo;

		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfPaymentScheduleStages" Then

			If ThereAreVariancesFromFinancialConditions Then
				Continue;
			EndIf;
			
			DefaultGraph = New ValueTable();
			DefaultGraph.Columns.Add("PaymentOption");
			DefaultGraph.Columns.Add("CalculateFrom");
			DefaultGraph.Columns.Add("PaymentDate");
			DefaultGraph.Columns.Add("PaymentPercentage");
			DefaultGraph.Columns.Add("PaymentAmount");
			DefaultGraph.Columns.Add("PackageDepositPercentage");
			DefaultGraph.Columns.Add("PackageDepositValue");
			DefaultGraph.Columns.Add("Move");
			DefaultGraph.Columns.Add("Formula");
			
			If Selection.Next() 
				And Not Selection.InvoiceForOrders Then
				FillParameters = PaymentStepsServer.ParametersForFillingInPaymentStages();
				FillParameters.TheseAreSettlementsWithCustomers             = True;
				FillParameters.InvoiceForOrders               = False;
				FillParameters.ARAPObjectSettings                  = Selection.ARAPObjectSettings;
				FillParameters.ThisIsOrder                         = Selection.ThisIsOrder;
				FillParameters.OrderDate                       = ?(Selection.ThisIsOrder,Selection.Date,Date(1,1,1));
				FillParameters.ApprovalDate                 = Selection.ApprovalDate;
				If Selection.NotShipInInstallments Then
					FillParameters.DateOfShipment = Selection.DateOfShipment;
					ThereIsDeposit = False;
				Else
					GoodsTable = Common.ObjectManagerByRef(DocumentSales).OrderAmounts(DocumentSales);
					FillParameters.DateOfShipment = GoodsTable;
					ThereIsDeposit = GoodsTable.Total("PackageDepositValue") <> 0;
				EndIf;
				FillParameters.DateOfTransferOfTitleToGoods  = Selection.DateOfTransferOfTitleToGoods;
				FillParameters.ThisIsTransferOfOwnership2_5 = Selection.ThisIsTransferOfOwnership2_5;
				FillParameters.Terms                      = Selection.Terms;
				FillParameters.AgreementScheduleIsFilledIn        = PaymentStepsServerCall.AgreementScheduleIsFilledIn(Selection.Terms);
				FillParameters.PaymentSchedule                    = Selection.PaymentSchedule;
				FillParameters.Calendar                       = Selection.Calendar;
				FillParameters.PackageDepositValue               = ?(ThereIsDeposit,100,0);
				FillParameters.PayAmount                     = 100;
				FillParameters.ThereIsDateOfTransferOfOwnership = ValueIsFilled(Selection.DateOfTransferOfTitleToGoods);
				PaymentStepsServer.FillInPaymentStages(DefaultGraph, FillParameters);
			EndIf;
			
			InterestAmount = 0;
			AmountOfTemplateSInterest = 0;
			AmountOfCollateralInterest = 0;
			AmountOfTemplateSCollateralInterest = 0;
			Selection.Reset();
			Cnt = 0;
			While Selection.Next() Do
				
				If Not Selection.ThereAreErrorsFillingStagesOfPaymentSchedule Then
					Break;
				EndIf;
				
				DefaultPlotLine = DefaultGraph[Cnt];
				
				If DefaultPlotLine.PaymentDate < Selection.PaymentDate Then
					
					ThereAreVariancesFromFinancialConditions = True;
					Break;
				
				EndIf;
				
				// Checking for payment percentage deviations
				InterestAmount = InterestAmount + Selection.PaymentPercentage;
				AmountOfTemplateSInterest = AmountOfTemplateSInterest + DefaultPlotLine.PaymentPercentage;
				If InterestAmount < AmountOfTemplateSInterest Then
					
					ThereAreVariancesFromFinancialConditions = True;
					Break;
					
				EndIf;
				
				// Verification of deviations in the interest of the deposit for the container
				AmountOfCollateralInterest = AmountOfCollateralInterest + Selection.PackageDepositPercentage;
				AmountOfTemplateSCollateralInterest = AmountOfTemplateSCollateralInterest + DefaultPlotLine.PackageDepositPercentage;
				If AmountOfCollateralInterest < AmountOfTemplateSCollateralInterest Then
					
					ThereAreVariancesFromFinancialConditions = True;
					Break;
					
				EndIf;
				Cnt = Cnt + 1 ;
			EndDo;
			
		ElsIf ChecksArray[CurIndex__] = "EntryOfPricesIntoAcceptableRange" Then

			If ThereAreVariancesFromPriceConditions Then
				Continue;
			EndIf;
			
			While Selection.Next() Do
				If Selection.ThereAreErrorsMinimumAllowablePrice Or
					Selection.ThereAreErrorsMaximumAllowablePrice Then
					
					ThereAreVariancesFromPriceConditions = True;
					Break;
					
				EndIf;
			EndDo;
			
		ElsIf ChecksArray[CurIndex__] = "ToleranceForManualMarkUpDiscounts" Then
			
			If ThereAreVariancesFromPriceConditions Then
				Continue;
			EndIf;
			
			If Selection.Next() Then
				ThereAreVariancesFromPriceConditions = True;
			EndIf;
			
		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfPaymentStagesOfAgreement" Then
			If ThereAreVariancesFromFinancialConditions Then
				Continue;
			EndIf;
			
			InterestAmount = 0;
			AmountOfTemplateSInterest = 0;
			AmountOfCollateralInterest = 0;
			AmountOfTemplateSCollateralInterest = 0;
			
			While Selection.Next() Do
				
				If Selection.TemplateStageIsMissing Then
					Continue;
				EndIf;
				
				If Selection.ThereAreErrorsInFillingOutPaymentOption Or
					Selection.TemplateShift < Selection.Move Then
					
					ThereAreVariancesFromFinancialConditions = True;
					Break;
					
				EndIf;

				InterestAmount = InterestAmount + Selection.PaymentPercentage;
				AmountOfTemplateSInterest = AmountOfTemplateSInterest + Selection.TemplatePaymentPercentage;
				If InterestAmount < AmountOfTemplateSInterest Then
					
					ThereAreVariancesFromFinancialConditions = True;
					Break;
					
				EndIf;
				
				AmountOfCollateralInterest = AmountOfCollateralInterest + Selection.PackageDepositPercentage;
				AmountOfTemplateSCollateralInterest = AmountOfTemplateSCollateralInterest + Selection.PercentageOfDepositForContainerOfTemplate;
				If InterestAmount < AmountOfTemplateSInterest Then
					
					ThereAreVariancesFromFinancialConditions = True;
					Break;
					
				EndIf;
			EndDo;
		
		ElsIf ChecksArray[CurIndex__] = "NumberOfPaymentStagesIsCorrect" Then
			
			If ThereAreVariancesFromFinancialConditions Then
				Continue;
			EndIf;
			
			While Selection.Next() Do
				If Selection.ThereAreErrorsInFillingOutPaymentStagesOfAgreement Then
						ThereAreVariancesFromFinancialConditions = True;
						Break;
				EndIf;
			EndDo;
			
		ElsIf ChecksArray[CurIndex__] = "CorrectVATAmount" 
			Or ChecksArray[CurIndex__] = "CorrectnessOfAmountAndAmountOfVAT" Then
			
			While Selection.Next() Do
				If ThereAreVariancesFromPriceConditions Then
					Continue;
				EndIf;
				
				If Selection.ThereAreErrorsVATAmount Then
					ThereAreVariancesFromPriceConditions = True;
				EndIf;
			EndDo;
			
		ElsIf ChecksArray[CurIndex__] = "CorrectIndicationOfVATRate" Then
			
			While Selection.Next() Do
				ThereAreVariancesFromPriceConditions = True;
			EndDo;
			
		EndIf;
		
	EndDo;
	
	SetPrivilegedMode(False);
	
EndProcedure

// Checks the correctness of filling in the return document in accordance 
// with the goods sold, taking into account adjustments.
// Is called from the procedure of the document "Obrabatyvaniya".
//
// Parameters:
// 	DocumentSales          - DocumentObject - The object for which you want to audit
// 	TableName               - String - Name of the Products table
// 	Cancel                    - Boolean - Flag for refusing to carry out the document
// 	TableOfCheckedProducts - ValueTable
//
Procedure CheckCorrectnessOfReturnedProducts(Val DocumentSales, TableName, Cancel, TableOfCheckedProducts = Undefined) Export
	
	If TableOfCheckedProducts = Undefined Then
		If TableName = "ReturnedGoods" Then
			FilterParameters = New Structure("Canceled", False); 
			TableOfCheckedProducts = DocumentSales[TableName].Unload(FilterParameters);
		Else
			TableOfCheckedProducts = DocumentSales[TableName].Unload();
		EndIf;
		
		GroupFields		= "Products,Characteristic,Series,Purpose,DocumentSalesOfGoodsAndServices,BatchesIndicationStatus";
		SummationFields	= "Count, NumberOfPackages";
		
		TableOfCheckedProducts.GroupBy(GroupFields, SummationFields);
	EndIf;
	
	RefundByReceipt = TypeOf(DocumentSales) <> Type("DocumentRef.DiscrepancyReportFollowingReceipt")
					And ValueIsFilled(DocumentSales.CashRegisterReceipt);
	
	If TableOfCheckedProducts.Count() > 0 Then
		
		If Not RefundByReceipt Then
			Query = New Query;
			
			If TypeOf(DocumentSales) = Type("DocumentRef.DiscrepancyReportFollowingReceipt") Then
				Query.Text = "
				|SELECT
				|	CAST(GoodsTable.Products AS Catalog.Products) AS Products,
				|	GoodsTable.Characteristic AS Characteristic,
				|	CASE
				|		WHEN GoodsTable.BatchesIndicationStatus = 14
				|			THEN GoodsTable.Series
				|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
				|	END AS Series,
				|	GoodsTable.Purpose AS Purpose,
				|	CAST(GoodsTable.DocumentSalesOfGoodsAndServices AS Document.CustomerInvoice) AS DocumentSalesOfGoodsAndServices,
				|	GoodsTable.NumberOfPackagesAccordingToAct - GoodsTable.NumberOfPackagesBase AS NumberOfPackages,
				|	(GoodsTable.NumberOfPackagesAccordingToAct - GoodsTable.NumberOfPackagesBase) * GoodsTable.PackagingFactor AS Count
				|INTO InspectedGoods
				|FROM
				|	&TableOfCheckedProducts AS GoodsTable
				|WHERE
				|	NOT GoodsTable.DocumentSalesOfGoodsAndServices IN(UNDEFINED, VALUE(Document.CustomerInvoice.EmptyRef),
				|		VALUE(Document.TransferOfGoodsToBailee.EmptyRef))
				|	AND GoodsTable.NumberOfPackagesAccordingToAct - GoodsTable.NumberOfPackagesBase > 0";
			Else
				Query.Text = 
				"SELECT
				|	ReturnOfGoodsFromCustomerGoods.Products		AS Products,
				|	ReturnOfGoodsFromCustomerGoods.Characteristic	AS Characteristic,
				|	ReturnOfGoodsFromCustomerGoods.Purpose		AS Purpose,
				|	CASE
				|		WHEN ReturnOfGoodsFromCustomerGoods.BatchesIndicationStatus IN (14, 18)
				|			THEN ReturnOfGoodsFromCustomerGoods.Series
				|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
				|	END											AS Series,
				|	ReturnOfGoodsFromCustomerGoods.Count		AS Count,
				|	ReturnOfGoodsFromCustomerGoods.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices
				|INTO CheckedProductsFromTable
				|FROM
				|	&TableOfCheckedProducts AS ReturnOfGoodsFromCustomerGoods
				|WHERE
				|	NOT ReturnOfGoodsFromCustomerGoods.DocumentSalesOfGoodsAndServices IN (
				|			UNDEFINED,
				|			VALUE(Document.CustomerInvoice.EmptyRef),
				|			VALUE(Document.RetailSalesReport.EmptyRef),
				|			VALUE(Document.TransferOfGoodsToBailee.EmptyRef)
				|		)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	ReturnOfGoodsFromCustomerGoods.Products		AS Products,
				|	ReturnOfGoodsFromCustomerGoods.Characteristic	AS Characteristic,
				|	ReturnOfGoodsFromCustomerGoods.Purpose		AS Purpose,
				|	ReturnOfGoodsFromCustomerGoods.Series				AS Series,
				|	ReturnOfGoodsFromCustomerGoods.Count		AS Count,
				|	ReturnOfGoodsFromCustomerGoods.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices
				|INTO InspectedGoods
				|FROM
				|	CheckedProductsFromTable AS ReturnOfGoodsFromCustomerGoods
				|
				|WHERE
				|	NOT (ReturnOfGoodsFromCustomerGoods.DocumentSalesOfGoodsAndServices REFS Document.CustomerInvoice
				|		AND CAST(ReturnOfGoodsFromCustomerGoods.DocumentSalesOfGoodsAndServices AS Document.CustomerInvoice).ToReturnReusablePackage
				|		AND CAST(ReturnOfGoodsFromCustomerGoods.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
				|	)
				|
				|INDEX BY
				|	Products,
				|	Characteristic,
				|	Series";
				
			EndIf;
			
			Query.Text = Query.Text + Common.QueryBatchSeparator() + 
			"SELECT
			|	MAX(SaleAdjustment.Date)	AS Date,
			|	InspectedGoods.DocumentSalesOfGoodsAndServices	AS ImplementationReference
			|INTO AdjustmentData
			|FROM
			|	InspectedGoods AS InspectedGoods
			|		LEFT JOIN Document.SaleAdjustment AS SaleAdjustment
			|		ON SaleAdjustment.DocumentBasis = InspectedGoods.DocumentSalesOfGoodsAndServices
			|		
			|		LEFT JOIN InformationRegister.DocumentsRegistry AS RegisterOfDocumentsStorno
			|		ON SaleAdjustment.Ref = RegisterOfDocumentsStorno.ReversedDocument
			|			AND RegisterOfDocumentsStorno.Posted
			|			AND NOT RegisterOfDocumentsStorno.AdditionalRecord
			|WHERE
			|	SaleAdjustment.Posted
			|	AND RegisterOfDocumentsStorno.Ref IS NULL
			|	AND NOT SaleAdjustment.AdjustmentKind IN (
			|			VALUE(Enum.BusinessTransactions.SaleOfOverdeliveredGoods),
			|			VALUE(Enum.BusinessTransactions.ReturnOfUnderdeliveredGoods)
			|		)
			|
			|GROUP BY
			|	InspectedGoods.DocumentSalesOfGoodsAndServices
			|
			|INDEX BY
			|	ImplementationReference
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	MAX(SaleAdjustment.Ref)			AS Ref,
			|	MAX(SaleAdjustment.Ref.Date)		AS Date,
			|	SaleAdjustment.Ref.DocumentBasis	AS ImplementationReference
			|INTO LastAdjustmentData
			|FROM
			|	Document.SaleAdjustment AS SaleAdjustment
			|WHERE
			|	(SaleAdjustment.Ref.DocumentBasis, SaleAdjustment.Date) IN
			|			(SELECT
			|				AdjustmentData.ImplementationReference AS ImplementationReference,
			|				AdjustmentData.Date AS Date
			|			FROM
			|				AdjustmentData)
			|
			|GROUP BY
			|	SaleAdjustment.Ref.DocumentBasis
			|
			|INDEX BY
			|	Ref,
			|	ImplementationReference
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT DISTINCT
			|	CASE
			|		WHEN LastAdjustmentData.Ref IS NULL
			|			THEN InspectedGoods.DocumentSalesOfGoodsAndServices
			|		ELSE LastAdjustmentData.Ref
			|	END AS Ref
			|INTO ReferencesToImplementations
			|FROM
			|	InspectedGoods AS InspectedGoods
			|		LEFT JOIN LastAdjustmentData AS LastAdjustmentData
			|		ON InspectedGoods.DocumentSalesOfGoodsAndServices = LastAdjustmentData.ImplementationReference
			|
			|INDEX BY
			|	Ref
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	DocumentGoods.Products		AS Products,
			|	DocumentGoods.Characteristic		AS Characteristic,
			|	DocumentGoods.Purpose			AS Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END								AS Series,
			|	SUM(DocumentGoods.Count)	AS Count,
			|	HeaderData_.DocumentBasis		AS DocumentSalesOfGoodsAndServices
			|INTO ImplementationData
			|FROM
			|	Document.SaleAdjustment.Goods AS DocumentGoods
			|		LEFT JOIN Document.SaleAdjustment AS HeaderData_
			|		ON DocumentGoods.Ref = HeaderData_.Ref
			|
			|WHERE
			|	HeaderData_.Posted
			|	AND (DocumentGoods.Products, DocumentGoods.Characteristic) IN
			|			(SELECT DISTINCT
			|				InspectedGoods.Products		AS Products,
			|				InspectedGoods.Characteristic	AS Characteristic
			|			FROM
			|				InspectedGoods AS InspectedGoods)
			|	AND DocumentGoods.Ref IN
			|			(SELECT
			|				ReferencesToImplementations.Ref AS Ref
			|			FROM
			|				ReferencesToImplementations AS ReferencesToImplementations)
			|
			|GROUP BY
			|	DocumentGoods.Products,
			|	DocumentGoods.Characteristic,
			|	DocumentGoods.Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END,
			|	HeaderData_.DocumentBasis
			|
			|UNION
			|
			|SELECT
			|	DocumentGoods.Products		AS Products,
			|	DocumentGoods.Characteristic		AS Characteristic,
			|	DocumentGoods.Purpose			AS Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END								AS Series,
			|	SUM(DocumentGoods.Count)	AS Count,
			|	HeaderData_.Ref					AS DocumentSalesOfGoodsAndServices
			|FROM
			|	Document.CustomerInvoice.Goods AS DocumentGoods
			|		LEFT JOIN Document.CustomerInvoice AS HeaderData_
			|		ON DocumentGoods.Ref = HeaderData_.Ref
			|		
			|		LEFT JOIN InformationRegister.DocumentsRegistry AS RegisterOfDocumentsStorno
			|		ON DocumentGoods.Ref = RegisterOfDocumentsStorno.ReversedDocument
			|			AND RegisterOfDocumentsStorno.Posted
			|			AND NOT RegisterOfDocumentsStorno.AdditionalRecord
			|
			|WHERE
			|	HeaderData_.Posted
			|	AND RegisterOfDocumentsStorno.Ref IS NULL
			|	AND (DocumentGoods.Products, DocumentGoods.Characteristic) IN
			|			(SELECT DISTINCT
			|				InspectedGoods.Products		AS Products,
			|				InspectedGoods.Characteristic	AS Characteristic
			|			FROM
			|				InspectedGoods AS InspectedGoods)
			|	AND DocumentGoods.Ref IN
			|			(SELECT
			|				ReferencesToImplementations.Ref AS Ref
			|			FROM
			|				ReferencesToImplementations AS ReferencesToImplementations)
			|
			|GROUP BY
			|	DocumentGoods.Products,
			|	DocumentGoods.Characteristic,
			|	DocumentGoods.Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END,
			|	HeaderData_.Ref
			|
			|UNION
			|
			|SELECT
			|	DocumentGoods.Products		AS Products,
			|	DocumentGoods.Characteristic		AS Characteristic,
			|	DocumentGoods.Purpose			AS Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END								AS Series,
			|	SUM(DocumentGoods.Count)	AS Count,
			|	HeaderData_.Ref					AS DocumentSalesOfGoodsAndServices
			|FROM
			|	Document.TransferOfGoodsToBailee.Goods AS DocumentGoods
			|		LEFT JOIN Document.TransferOfGoodsToBailee AS HeaderData_
			|		ON DocumentGoods.Ref = HeaderData_.Ref
			|WHERE
			|	HeaderData_.Posted
			|	AND (DocumentGoods.Products, DocumentGoods.Characteristic) IN
			|			(SELECT DISTINCT
			|				InspectedGoods.Products		AS Products,
			|				InspectedGoods.Characteristic	AS Characteristic
			|			FROM
			|				InspectedGoods AS InspectedGoods)
			|	AND DocumentGoods.Ref IN
			|			(SELECT
			|				ReferencesToImplementations.Ref AS Ref
			|			FROM
			|				ReferencesToImplementations AS ReferencesToImplementations)
			|
			|GROUP BY
			|	DocumentGoods.Products,
			|	DocumentGoods.Characteristic,
			|	DocumentGoods.Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END,
			|	HeaderData_.Ref
			|
			|UNION
			|
			|SELECT
			|	DocumentGoods.Products		AS Products,
			|	DocumentGoods.Characteristic		AS Characteristic,
			|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus = 14
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END								AS Series,
			|	SUM(DocumentGoods.Count)	AS Count,
			|	HeaderData_.Ref					AS DocumentSalesOfGoodsAndServices
			|FROM
			|	Document.RetailSalesReport.Goods AS DocumentGoods
			|		LEFT JOIN Document.RetailSalesReport AS HeaderData_
			|		ON DocumentGoods.Ref = HeaderData_.Ref
			|		
			|		LEFT JOIN InformationRegister.DocumentsRegistry AS RegisterOfDocumentsStorno
			|		ON DocumentGoods.Ref = RegisterOfDocumentsStorno.ReversedDocument
			|			AND RegisterOfDocumentsStorno.Posted
			|			AND NOT RegisterOfDocumentsStorno.AdditionalRecord
			|WHERE
			|	HeaderData_.Posted
			|	AND (DocumentGoods.Products, DocumentGoods.Characteristic) IN
			|			(SELECT DISTINCT
			|				InspectedGoods.Products		AS Products,
			|				InspectedGoods.Characteristic	AS Characteristic
			|			FROM
			|				InspectedGoods AS InspectedGoods)
			|	AND DocumentGoods.Ref IN
			|			(SELECT
			|				ReferencesToImplementations.Ref AS Ref
			|			FROM
			|				ReferencesToImplementations AS ReferencesToImplementations)
			|	AND RegisterOfDocumentsStorno.Ref IS NULL
			|
			|GROUP BY
			|	DocumentGoods.Products,
			|	DocumentGoods.Characteristic,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus = 14
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END,
			|	HeaderData_.Ref
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	Purpose,
			|	Series,
			|	DocumentSalesOfGoodsAndServices
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	DocumentGoods.Products	AS Products,
			|	DocumentGoods.Characteristic	AS Characteristic,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END							AS Series,
			|	DocumentGoods.Purpose		AS Purpose,
			|	SUM(DocumentGoods.Count) AS Count,
			|	HeaderData_.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices
			|INTO ReturnDocumentData
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.Goods AS DocumentGoods
			|		LEFT JOIN Document.ReturnOfGoodsFromCustomer AS HeaderData_
			|		ON DocumentGoods.Ref = HeaderData_.Ref
			|		
			|		LEFT JOIN InformationRegister.DocumentsRegistry AS RegisterOfDocumentsStorno
			|		ON DocumentGoods.Ref = RegisterOfDocumentsStorno.ReversedDocument
			|			AND RegisterOfDocumentsStorno.Posted
			|			AND NOT RegisterOfDocumentsStorno.AdditionalRecord
			|WHERE
			|	HeaderData_.Posted
			|	AND RegisterOfDocumentsStorno.Ref IS NULL
			|	AND DocumentGoods.Ref <> &ThisReturnLink
			|	AND HeaderData_.RequestForReturnOfGoodsFromCustomer <> &ThisReturnLink
			|	AND (DocumentGoods.DocumentSalesOfGoodsAndServices, DocumentGoods.Products, DocumentGoods.Characteristic) IN
			|			(SELECT DISTINCT
			|				InspectedGoods.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices,
			|				InspectedGoods.Products			AS Products,
			|				InspectedGoods.Characteristic		AS Characteristic
			|			FROM
			|				InspectedGoods AS InspectedGoods)
			|
			|GROUP BY
			|	DocumentGoods.Products,
			|	DocumentGoods.Characteristic,
			|	CASE
			|		WHEN DocumentGoods.BatchesIndicationStatus IN (14, 18)
			|			THEN DocumentGoods.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END,
			|	DocumentGoods.Purpose,
			|	HeaderData_.DocumentSalesOfGoodsAndServices
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	Purpose,
			|	Series,
			|	DocumentSalesOfGoodsAndServices
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	InspectedGoods.Products			AS Products,
			|	InspectedGoods.Characteristic		AS Characteristic,
			|	SUM(InspectedGoods.Count)		AS Count,
			|	InspectedGoods.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices
			|INTO InspectedGoodsWithoutDestination
			|FROM
			|	InspectedGoods AS InspectedGoods
			|
			|GROUP BY
			|	InspectedGoods.Products,
			|	InspectedGoods.Characteristic,
			|	InspectedGoods.DocumentSalesOfGoodsAndServices
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	DocumentSalesOfGoodsAndServices
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	RefundProducts.Products		AS Products,
			|	RefundProducts.Characteristic		AS Characteristic,
			|	SUM(RefundProducts.Count)	AS Count,
			|	RefundProducts.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices
			|INTO ReturnDataWithoutAssignment
			|FROM
			|	ReturnDocumentData AS RefundProducts
			|
			|GROUP BY
			|	RefundProducts.Products,
			|	RefundProducts.Characteristic,
			|	RefundProducts.DocumentSalesOfGoodsAndServices
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	DocumentSalesOfGoodsAndServices
			|	
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	ImplementationData.Products		AS Products,
			|	ImplementationData.Characteristic		AS Characteristic,
			|	SUM(ImplementationData.Count)	AS Count,
			|	ImplementationData.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices
			|INTO ImplementationDataWithoutAssignment
			|FROM
			|	ImplementationData AS ImplementationData
			|
			|GROUP BY
			|	ImplementationData.Products,
			|	ImplementationData.Characteristic,
			|	ImplementationData.DocumentSalesOfGoodsAndServices
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	DocumentSalesOfGoodsAndServices
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	ImplementationData.Products		AS Products,
			|	ImplementationData.Characteristic		AS Characteristic,
			|	ImplementationData.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices,
			|	ISNULL(ImplementationData.Count, 0) - ISNULL(ReturnData.Count, 0) - ISNULL(InspectedGoods.Count, 0) AS Count
			|INTO OverallBalance
			|FROM
			|	ImplementationDataWithoutAssignment AS ImplementationData
			|		LEFT JOIN InspectedGoodsWithoutDestination AS InspectedGoods
			|		ON ImplementationData.DocumentSalesOfGoodsAndServices = InspectedGoods.DocumentSalesOfGoodsAndServices
			|			AND ImplementationData.Products = InspectedGoods.Products
			|			AND ImplementationData.Characteristic = InspectedGoods.Characteristic
			|		
			|		LEFT JOIN ReturnDataWithoutAssignment AS ReturnData
			|		ON ImplementationData.DocumentSalesOfGoodsAndServices = ReturnData.DocumentSalesOfGoodsAndServices
			|			AND ImplementationData.Products = ReturnData.Products
			|			AND ImplementationData.Characteristic = ReturnData.Characteristic
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	ImplementationData.Products		AS Products,
			|	ImplementationData.Characteristic		AS Characteristic,
			|	ImplementationData.Purpose			AS Purpose,
			|	ImplementationData.Series				AS Series,
			|	ImplementationData.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices,
			|	ISNULL(ImplementationData.Count, 0) - ISNULL(ReturnDocumentData.Count, 0) - ISNULL(InspectedGoods.Count, 0) AS Count
			|INTO BalancesAsIntended
			|FROM
			|	ImplementationData AS ImplementationData
			|		LEFT JOIN ReturnDocumentData AS ReturnDocumentData
			|		ON ImplementationData.DocumentSalesOfGoodsAndServices = ReturnDocumentData.DocumentSalesOfGoodsAndServices
			|			AND ImplementationData.Products = ReturnDocumentData.Products
			|			AND ImplementationData.Characteristic = ReturnDocumentData.Characteristic
			|			AND ImplementationData.Purpose = ReturnDocumentData.Purpose
			|			AND ImplementationData.Series = ReturnDocumentData.Series
			|		
			|		LEFT JOIN InspectedGoods AS InspectedGoods
			|		ON ImplementationData.DocumentSalesOfGoodsAndServices = InspectedGoods.DocumentSalesOfGoodsAndServices
			|			AND ImplementationData.Products = InspectedGoods.Products
			|			AND ImplementationData.Characteristic = InspectedGoods.Characteristic
			|			AND ImplementationData.Purpose = InspectedGoods.Purpose
			|			AND ImplementationData.Series = InspectedGoods.Series
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	Purpose,
			|	Series,
			|	DocumentSalesOfGoodsAndServices
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	InspectedGoods.Products			AS Products,
			|	InspectedGoods.Characteristic		AS Characteristic,
			|	CASE
			|		WHEN NOT OverallBalance.Count IS NULL
			|				AND OverallBalance.Count >= 0
			|			THEN InspectedGoods.Purpose
			|		ELSE VALUE(Catalog.Assignments.EmptyRef)
			|	END									AS Purpose,
			|	InspectedGoods.Series					AS Series,
			|	MAX(CASE
			|				WHEN ISNULL(OverallBalance.Count, 0) = 0
			|						AND BalancesAsIntended.Count IS NULL
			|					THEN -InspectedGoods.Count
			|				WHEN ISNULL(OverallBalance.Count, 0) < ISNULL(BalancesAsIntended.Count, 0)
			|					THEN ISNULL(OverallBalance.Count, 0)
			|				ELSE ISNULL(BalancesAsIntended.Count, 0)
			|			END)							AS Count,
			|	InspectedGoods.DocumentSalesOfGoodsAndServices	AS DocumentSalesOfGoodsAndServices,
			|	InspectedGoods.Products.UnitOfMeasure AS UnitOfMeasure,
			|	InspectedGoods.DocumentSalesOfGoodsAndServices.Number AS SalesNumber
			|FROM
			|	InspectedGoods AS InspectedGoods
			|		LEFT JOIN OverallBalance AS OverallBalance
			|		ON OverallBalance.DocumentSalesOfGoodsAndServices = InspectedGoods.DocumentSalesOfGoodsAndServices
			|			AND OverallBalance.Products = InspectedGoods.Products
			|			AND OverallBalance.Characteristic = InspectedGoods.Characteristic
			|		
			|		LEFT JOIN BalancesAsIntended AS BalancesAsIntended
			|		ON BalancesAsIntended.DocumentSalesOfGoodsAndServices = InspectedGoods.DocumentSalesOfGoodsAndServices
			|			AND BalancesAsIntended.Products = InspectedGoods.Products
			|			AND BalancesAsIntended.Characteristic = InspectedGoods.Characteristic
			|			AND BalancesAsIntended.Series = InspectedGoods.Series
			|			AND BalancesAsIntended.Purpose = InspectedGoods.Purpose
			|			AND NOT InspectedGoods.Purpose = VALUE(Catalog.Assignments.EmptyRef)
			|			
			|		LEFT JOIN Catalog.Products AS CatalogProducts
			|		ON InspectedGoods.Products = CatalogProducts.Ref
			|WHERE
			|	(OverallBalance.Count < 0
			|		OR OverallBalance.Count IS NULL
			|		OR NOT InspectedGoods.Purpose = VALUE(Catalog.Assignments.EmptyRef)
			|			AND (BalancesAsIntended.Count < 0
			|				OR BalancesAsIntended.Count IS NULL))
			|
			|GROUP BY
			|	InspectedGoods.Products,
			|	InspectedGoods.Characteristic,
			|	CASE
			|		WHEN NOT OverallBalance.Count IS NULL
			|				AND OverallBalance.Count >= 0
			|			THEN InspectedGoods.Purpose
			|		ELSE VALUE(Catalog.Assignments.EmptyRef)
			|	END,
			|	InspectedGoods.Series,
			|	InspectedGoods.DocumentSalesOfGoodsAndServices";
			
			Query.SetParameter("TableOfCheckedProducts",	TableOfCheckedProducts);
			Query.SetParameter("ThisReturnLink",			DocumentSales.Ref);
		Else
			Query = New Query;
			Query.Text = 
			"SELECT
			|	ReturnOfGoodsFromCustomerGoods.Products AS Products,
			|	ReturnOfGoodsFromCustomerGoods.Characteristic AS Characteristic,
			|	ReturnOfGoodsFromCustomerGoods.Series AS Series,
			|	ReturnOfGoodsFromCustomerGoods.Count
			|INTO ProductsToFillIn
			|FROM
			|	&GoodsTable AS ReturnOfGoodsFromCustomerGoods
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	Series
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CashRegisterReceiptGoods.Ref.CashRegisterShift AS CashRegisterShift,
			|	CashRegisterReceiptGoods.Ref AS DocumentSalesOfGoodsAndServices,
			|	CashRegisterReceiptGoods.Products AS Products,
			|	CashRegisterReceiptGoods.Characteristic AS Characteristic,
			|	CashRegisterReceiptGoods.Series AS Series,
			|	SUM(CashRegisterReceiptGoods.Count) AS Count,
			|	CashRegisterReceiptGoods.Ref.Date AS SaleDate
			|INTO CashRegisterReceipts
			|FROM
			|	Document.CashRegisterReceipt.Goods AS CashRegisterReceiptGoods
			|WHERE
			|	CashRegisterReceiptGoods.Ref.Posted
			|	AND CashRegisterReceiptGoods.Ref = &CashRegisterReceipt
			|
			|GROUP BY
			|	CashRegisterReceiptGoods.Ref,
			|	CashRegisterReceiptGoods.Products,
			|	CashRegisterReceiptGoods.Characteristic,
			|	CashRegisterReceiptGoods.Series
			|
			|INDEX BY
			|	DocumentSalesOfGoodsAndServices,
			|	CashRegisterShift,
			|	Products,
			|	Characteristic,
			|	Series
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CashRegisterReceiptReturnProducts.Ref AS DocumentSalesOfGoodsAndServices,
			|	CashRegisterReceiptReturnProducts.Products AS Products,
			|	CashRegisterReceiptReturnProducts.Characteristic AS Characteristic,
			|	CashRegisterReceiptReturnProducts.Series AS Series,
			|	SUM(CashRegisterReceiptReturnProducts.Count) AS Count,
			|	CashRegisterReceiptReturnProducts.Ref.Date AS SaleDate
			|INTO CashRegisterReceiptsRefund
			|FROM
			|	Document.CashRegisterReceiptReturn.Goods AS CashRegisterReceiptReturnProducts
			|WHERE
			|	CashRegisterReceiptReturnProducts.Ref.Posted
			|	AND CashRegisterReceiptReturnProducts.Ref.CashRegisterShift IN (SELECT CashRegisterShift FROM CashRegisterReceipts)
			|	AND CashRegisterReceiptReturnProducts.NumberOfPackages <> 0
			|
			|GROUP BY
			|	CashRegisterReceiptReturnProducts.Ref,
			|	CashRegisterReceiptReturnProducts.Products,
			|	CashRegisterReceiptReturnProducts.Characteristic,
			|	CashRegisterReceiptReturnProducts.Series,
			|	CashRegisterReceiptReturnProducts.Ref.Date
			|
			|INDEX BY
			|	DocumentSalesOfGoodsAndServices,
			|	Products,
			|	Characteristic,
			|	Series
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	TableOfCheckedProducts.Products AS Products,
			|	TableOfCheckedProducts.Characteristic AS Characteristic,
			|	TableOfCheckedProducts.Series AS Series,
			|	SUM(TableOfCheckedProducts.Count) AS Count,
			|	TableOfCheckedProducts.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
			|	TableOfCheckedProducts.Ref
			|INTO ReturnData
			|FROM
			|	Document.ReturnOfGoodsFromCustomer.Goods AS TableOfCheckedProducts
			|		LEFT JOIN InformationRegister.DocumentsRegistry AS RegisterOfDocumentsStorno
			|		ON TableOfCheckedProducts.Ref = RegisterOfDocumentsStorno.ReversedDocument
			|			AND RegisterOfDocumentsStorno.Posted
			|			AND NOT RegisterOfDocumentsStorno.AdditionalRecord
			|WHERE
			|	TableOfCheckedProducts.Ref.Posted
			|	AND TableOfCheckedProducts.Ref <> &DocumentReturnPolicy
			|	AND TableOfCheckedProducts.Ref.RequestForReturnOfGoodsFromCustomer <> &DocumentReturnPolicy
			|	AND TableOfCheckedProducts.Ref.CashRegisterReceipt = &CashRegisterReceipt
			|	AND RegisterOfDocumentsStorno.Ref IS NULL
			|	
			|GROUP BY
			|	TableOfCheckedProducts.Products,
			|	TableOfCheckedProducts.Characteristic,
			|	TableOfCheckedProducts.Series,
			|	TableOfCheckedProducts.DocumentSalesOfGoodsAndServices,
			|	TableOfCheckedProducts.Ref
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	Series,
			|	DocumentSalesOfGoodsAndServices
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	CashRegisterReceipts.DocumentSalesOfGoodsAndServices AS DocumentSalesOfGoodsAndServices,
			|	CashRegisterReceipts.Products AS Products,
			|	CashRegisterReceipts.Characteristic AS Characteristic,
			|	CashRegisterReceipts.Series AS Series,
			|	ISNULL(CashRegisterReceipts.Count, 0) - ISNULL(ProductsToFillIn.Count, 0) - ISNULL(ReturnData.Count, 0) - ISNULL(CashRegisterReceiptsRefund.Count, 0) AS Count,
			|	CashRegisterReceipts.SaleDate AS SaleDate,
			|	CashRegisterReceipts.Products.UnitOfMeasure AS UnitOfMeasure,
			|	CashRegisterReceipts.DocumentSalesOfGoodsAndServices.Number AS SalesNumber
			|FROM
			|	ProductsToFillIn AS ProductsToFillIn
			|		LEFT JOIN CashRegisterReceipts AS CashRegisterReceipts
			|			LEFT JOIN CashRegisterReceiptsRefund AS CashRegisterReceiptsRefund
			|			ON CashRegisterReceipts.DocumentSalesOfGoodsAndServices = CashRegisterReceiptsRefund.DocumentSalesOfGoodsAndServices.CashRegisterReceipt
			|				AND CashRegisterReceipts.Products = CashRegisterReceiptsRefund.Products
			|				AND CashRegisterReceipts.Characteristic = CashRegisterReceiptsRefund.Characteristic
			|				AND CashRegisterReceipts.Series = CashRegisterReceiptsRefund.Series
			|			LEFT JOIN ReturnData AS ReturnData
			|			ON CashRegisterReceipts.DocumentSalesOfGoodsAndServices = ReturnData.Ref.CashRegisterReceipt
			|				AND CashRegisterReceipts.Products = ReturnData.Products
			|				AND CashRegisterReceipts.Characteristic = ReturnData.Characteristic
			|				AND CashRegisterReceipts.Series = ReturnData.Series
			|			LEFT JOIN Document.RetailSalesReport AS RetailSalesReport
			|			ON CashRegisterReceipts.DocumentSalesOfGoodsAndServices.CashRegisterShift = RetailSalesReport.CashRegisterShift
			|		ON ProductsToFillIn.Products = CashRegisterReceipts.Products
			|			AND ProductsToFillIn.Characteristic = CashRegisterReceipts.Characteristic
			|			AND ProductsToFillIn.Series = CashRegisterReceipts.Series
			|WHERE
			|	ISNULL(CashRegisterReceipts.Count, 0) - ISNULL(ProductsToFillIn.Count, 0) - ISNULL(ReturnData.Count, 0) - ISNULL(CashRegisterReceiptsRefund.Count, 0) < 0
			|	AND CashRegisterReceipts.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
			|
			|ORDER BY
			|	SaleDate DESC";
			
			Query.SetParameter("GoodsTable",		TableOfCheckedProducts);
			Query.SetParameter("DocumentReturnPolicy",	DocumentSales.Ref);
			Query.SetParameter("CashRegisterReceipt",				DocumentSales.CashRegisterReceipt);
		EndIf;
		
		SetPrivilegedMode(True);
		Result = Query.Execute().Unload();
		SetPrivilegedMode(False);
		
		If Result.Count() > 0 Then
			Cancel = True;
			
			ReportErrorsInCorrectnessOfReturnedProducts(Result, RefundByReceipt);
		EndIf;
		
	EndIf;
	
EndProcedure

// Generates a report "deviations from the terms and conditions of sale" by performing the set of requests. 
// 
// Parameters:
// DocumentSales - DocumentObject -Document to be checked for
// ReportTable - SpreadsheetDocument - Table document of the report.
//
Procedure GenerateReportDeviationsFromSalesConditions(Val DocumentSales, ReportTable) Export
	
	SetPrivilegedMode(True);
	
	// Let's check whether it is necessary to check the range of acceptable prices
	KindOfMaximumAllowableSellingPrices = Constants.KindOfMaximumAllowableSellingPrices.Get();
	KindOfMinimumAllowableSellingPrices  = Constants.KindOfMinimumAllowableSellingPrices.Get();
	CheckPriceRange               = ValueIsFilled(KindOfMaximumAllowableSellingPrices) Or ValueIsFilled(KindOfMinimumAllowableSellingPrices);
	
	// Fill in the array of necessary checks depending on the type of document
	ChecksArray          = New Array();
	DocumentType            = TypeOf(DocumentSales);
	TableName              = Common.TableNameByRef(DocumentSales);
	TSName                   = GetNameOfTablePart(TableName);
	PresentationOfTS         = GetPresentationOfTablePart(TableName);
	GoodsTransferOperations = GoodsTransferOperations();
	OperationsForReturningTransferredGoods = OperationsForReturningTransferredGoods();
	
	QueryTextByHeader = "
		|SELECT
		|	DocumentSales.Date AS Date,
		|	DocumentSales.Terms AS Terms,
		|	&ReplacementText1,
		|	&ReplacementText2,
		|	&ReplacementText3,
		|	&ReplacementText4,
		|	&ReplacementText5,
		|	&ReplacementText6
		|FROM
		|	&TableName AS DocumentSales
		|WHERE
		|	DocumentSales.Ref = &DocumentSales
		|";
	
	QueryTextByHeader = StrReplace(QueryTextByHeader, "&TableName", TableName);
	
	QueryTextByHeader = StrReplace(QueryTextByHeader, "&ReplacementText1,", ?(TableName = "Document.SalesOrder" Or TableName = "Document.RequestForReturnOfGoodsFromCustomer","
		|	DocumentSales.PaymentSchedule AS PaymentSchedule,
		|	DocumentSales.DocumentAmount AS DocumentAmount,
		|","
		|	NULL AS PaymentSchedule,
		|	0 AS DocumentAmount,
		|"));

	QueryTextByHeader = StrReplace(QueryTextByHeader, "&ReplacementText2,", ?(TableName = "Document.JobForSalesRepresentative","
		|	NULL AS ARAPObjectSettings,
		|","
		|	DocumentSales.ARAPObjectSettings AS ARAPObjectSettings,
		|"));

	QueryTextByHeader = StrReplace(QueryTextByHeader, "&ReplacementText3,", ?(TableName = "Document.RequestForReturnOfGoodsFromCustomer","
		|	DocumentSales.CompensationMethod AS CompensationMethod,
		|	DocumentSales.ReplacementAmount AS ReplacementAmount,
		|","
		|	NULL AS CompensationMethod,
		|	0 AS ReplacementAmount,
		|"));
	
	QueryTextByHeader = StrReplace(QueryTextByHeader, "&ReplacementText4,", ?(TableName = "Document.CustomerInvoiceServices","
		|	NULL AS BusinessOperation,
		|	FALSE AS PackageDepositIsRequired,
		|	DocumentSales.InvoiceByOrders AS InvoiceByOrders,
		|","
		|	DocumentSales.BusinessOperation AS BusinessOperation,
		|	DocumentSales.PackageDepositIsRequired AS PackageDepositIsRequired,
		|	FALSE AS InvoiceByOrders,
		|"));
	
	QueryTextByHeader = StrReplace(QueryTextByHeader, "&ReplacementText5,", ?(TableName = "Document.CustomerInvoice","
		|	DocumentSales.AmountARAP AS AmountARAP,
		|	DocumentSales.OrderSales AS OrderSales,
		|","
		|	0 AS AmountARAP,
		|	FALSE AS OrderSales,
		|"));
	
	QueryTextByHeader = StrReplace(QueryTextByHeader, "&ReplacementText6", ?(TableName = "Catalog.TermsOfSale","
		|	DocumentSales.Standard_ AS Standard_,
		|	DocumentSales.Standard_ AS ProductSegment,
		|	DocumentSales.ReturnReusablePackage AS ReturnOfMultiTurnContainers
		|","
		|	FALSE AS Standard_,
		|	NULL AS ProductSegment,
		|" + ?(TableName = "Document.CustomerInvoiceServices","
		|	FALSE AS ReturnOfMultiTurnContainers
		|","
		|	DocumentSales.ToReturnReusablePackage AS ReturnOfMultiTurnContainers
		|")));
	
	RequestByHeader = New Query(QueryTextByHeader);
	
	RequestByHeader.SetParameter("DocumentSales", DocumentSales);
	SelectionByHeader = RequestByHeader.Execute().Select();
	SelectionByHeader.Next();
	
	// Let's check whether it is necessary to check discounts and margins
	UseAutomaticDiscounts             = GetFunctionalOption("UseDiscountsMarkupsInSales");
	UseManualDiscounts                     = GetFunctionalOption("UseDiscountAdjustmentsInSales");
	CheckDiscountsMarkups                       = UseAutomaticDiscounts Or UseManualDiscounts;	
	UsePriceGroups                    = GetFunctionalOption("UsePriceGroups");
	
	UseUserRestrictions       = GetFunctionalOption("UseLimitsForDiscountAdjustmentsInSalesByUsers");
	UseRestrictionsOnAgreements         = GetFunctionalOption("UseLimitsForDiscountAdjustmentsInSalesByTermsOfSales");
	LimitDiscountAdjustments                     = UseManualDiscounts And (UseUserRestrictions Or UseRestrictionsOnAgreements);
	
	UseAdvancedFeaturesOfSalesOrder = GetFunctionalOption("UseAdvancedFeaturesOfSalesOrder");
	
	ToUseTermsOfSales = GetFunctionalOption("ToUseTermsOfSales");
	
	// AGREEMENT WITH THE CLIENT
	If TableName = "Catalog.TermsOfSale" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");

		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		If CheckPriceRange Or Not SelectionByHeader.Standard_ Then
			ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
		EndIf;
		
		If Not SelectionByHeader.Standard_ Then
			
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
			ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
			ChecksArray.Add("TemporaryTablePaymentStepsTermsStandard");
			ChecksArray.Add("TemporaryTableStagesOfPaymentOfIndividualAgreement");
			ChecksArray.Add("CorrectnessOfPaymentStagesOfAgreement");
			ChecksArray.Add("NumberOfPaymentStagesIsCorrect");
			If UsePriceGroups Then
				ChecksArray.Add("TemporaryTablePriceGroups");
				ChecksArray.Add("CorrespondenceBetweenPriceGroupsAndSalesConditions");
			EndIf;
			ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
		EndIf;
		
		If ValueIsFilled(SelectionByHeader.ProductSegment) Then
			ChecksArray.Add("WhetherProductsBelongToProductSegment");
		EndIf;
		
		If CheckPriceRange Then
			ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
		EndIf;
		
	// Sales order
	
	ElsIf TableName = "Document.SalesOrder" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		If ToUseTermsOfSales Then
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
			ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
			ChecksArray.Add("WhetherProductsBelongToProductSegment");
		EndIf;
		ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
		ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
		
		If CheckPriceRange Then
			ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
		EndIf;
	
		// Verification of the correctness of the payment stages is carried out only for
		// orders in which not all lines have been canceled and in which the payment schedule is specified.
		
		If GoodsTransferOperations.Find(SelectionByHeader.BusinessOperation) = Undefined
			And SelectionByHeader.DocumentAmount <> 0 Then
			
			If SelectionByHeader.ARAPObjectSettings <> Enums.ARAPObjectSettings.ByARAPDocuments Then
				ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
				ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
			EndIf;
			
		EndIf;
		
		If LimitDiscountAdjustments
			And GoodsTransferOperations.Find(SelectionByHeader.BusinessOperation) = Undefined Then
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
		
	// Sales of goods and services
	
	ElsIf TableName = "Document.CustomerInvoice" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
		
		If Not SelectionByHeader.OrderSales Then
			
			If ToUseTermsOfSales Then
				ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
				ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
				ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
				ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
				ChecksArray.Add("WhetherProductsBelongToProductSegment");
			EndIf;
			If CheckPriceRange Then
				ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
			EndIf;
		EndIf;
		
		If (Not SelectionByHeader.OrderSales Or SelectionByHeader.ARAPObjectSettings = Enums.ARAPObjectSettings.ByARAPDocuments)
			And ToUseTermsOfSales Then
			
			If SelectionByHeader.BusinessOperation <> Enums.BusinessTransactions.TransferToCommissionAgent Then
				
				ChecksArray.Add("TemporaryTableOfSettlementAmounts");
				ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
				ChecksArray.Add("ComplianceOfPrepaymentAmountWithPaymentSchedule");
				ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
			
			EndIf;
			
		EndIf;
		
		If LimitDiscountAdjustments And SelectionByHeader.BusinessOperation <> Enums.BusinessTransactions.TransferToCommissionAgent Then
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
			
		EndIf;
		
	// Request for return of goods from the client
	
	ElsIf TableName = "Document.RequestForReturnOfGoodsFromCustomer" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		ChecksArray.Add("TemporaryTableCurrencyExchangeRates");

		NeedReplacementGoods = SelectionByHeader.CompensationMethod = Enums.CompensationMethodsForReturnsOfGoods.ToSubstituteGoods;
		
		If ToUseTermsOfSales Then
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
			ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
			If NeedReplacementGoods Then
				ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
				ChecksArray.Add("WhetherProductsBelongToProductSegment");
			EndIf;
		EndIf;
		If NeedReplacementGoods And CheckPriceRange Then
			ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
		EndIf;
	
		// Verification of the correctness of the payment stages is carried out only for
		// applications in which not all lines are canceled and in which the payment schedule is specified.
		If OperationsForReturningTransferredGoods.Find(SelectionByHeader.BusinessOperation) = Undefined
			And SelectionByHeader.ReplacementAmount > 0
			And SelectionByHeader.DocumentAmount <> 0
			And SelectionByHeader.ARAPObjectSettings <> Enums.ARAPObjectSettings.ByARAPDocuments
			And NeedReplacementGoods Then
			
			ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
			ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
			
		EndIf;
		
		If LimitDiscountAdjustments
			And SelectionByHeader.BusinessOperation <> Enums.BusinessTransactions.TransferToCommissionAgent
			And NeedReplacementGoods Then
			
				If UseUserRestrictions Then
					ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
					ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
					ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
					ChecksArray.Add("PriceGroups");
					ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
					ChecksArray.Add("TableOfConstraints");
				EndIf;
				
				ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
				ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
				ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
		
	// ASSIGNMENT TO A SALES REPRESENTATIVE
	
	ElsIf TableName = "Document.JobForSalesRepresentative" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		If ToUseTermsOfSales Then
			ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
			ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
		EndIf;
			
	// Report of completed works
	
	ElsIf TableName = "Document.CustomerInvoiceServices" Then
		
		ChecksArray.Add("TemporaryTableSalesDocument");
		
		ChecksArray.Add("TemporaryTableOfGoods_Preliminary");
		ChecksArray.Add("TemporaryTableSetsPreparation");
		ChecksArray.Add("TemporaryTableSetsOptional");
		ChecksArray.Add("TemporaryTableSets");
		ChecksArray.Add("TemporaryTableOfGoods_");
		
		If Not SelectionByHeader.InvoiceByOrders Then
			
			ChecksArray.Add("TemporaryTableCurrencyExchangeRates");
			
			If ToUseTermsOfSales Then
				ChecksArray.Add("TemporaryTableWarehousesCorrectByAgreement");
				ChecksArray.Add("ComplianceOfHeaderWithSalesConditions");
				ChecksArray.Add("ComplianceOfGoodsWithSalesConditions");
				ChecksArray.Add("PartnerSAffiliationToPartnerSegment");
				ChecksArray.Add("WhetherProductsBelongToProductSegment");
			EndIf;
			
			If CheckPriceRange Then
				ChecksArray.Add("EntryOfPricesIntoAcceptableRange");
			EndIf;
			
		EndIf;
		
		If ToUseTermsOfSales Then
			ChecksArray.Add("TimeTableStagesOfPaymentSchedule");
			ChecksArray.Add("CorrectnessOfPaymentScheduleStages");
		EndIf;
		
		If LimitDiscountAdjustments Then
			
			If UseUserRestrictions Then
				ChecksArray.Add("TemporaryTableLimitingManualDiscountsForAUserGroup");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsUserGroupRestrictions");
				ChecksArray.Add("TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions");
				ChecksArray.Add("PriceGroups");
				ChecksArray.Add("LimitingManualDiscountsByGroupsAndUsers");
				ChecksArray.Add("TableOfConstraints");
			EndIf;
			
			ChecksArray.Add("TemporaryTableLimitationOfManualDiscountsGeneralRestrictions");
			ChecksArray.Add("TemporaryTableLimitingManualDiscounts");
			ChecksArray.Add("ToleranceForManualMarkUpDiscounts");
				
		EndIf;
		
	Else
		
		SetPrivilegedMode(False);
		Return;
		
	EndIf;
	
	ConsiderDiscountsMarkups = Not ((TableName = "Catalog.TermsOfSale") 
		Or (TableName = "Document.JobForSalesRepresentative")
		Or (TableName = "Document.ReturnOfGoodsFromCustomer"));
	
	// Let's form the text of the request for the necessary checks in accordance with the array of checks

	QueryText     = "";
	QueryOptions = New Structure();
	
	QueryOptions.Insert("Date",          SelectionByHeader.Date);
	QueryOptions.Insert("ThisIsConvention", DocumentType = Type("CatalogObject.TermsOfSale"));
	QueryOptions.Insert("Ref",        DocumentSales);
	QueryOptions.Insert("User",  Users.AuthorizedUser());
	QueryOptions.Insert("UsePaymentSchedules", GetFunctionalOption("UsePaymentSchedules"));
	QueryOptions.Insert("UseStatusesOfGoodsServicesSales", GetFunctionalOption("UseStatusesOfGoodsServicesSales"));
	QueryOptions.Insert("ReturnOfMultiTurnContainers", SelectionByHeader.ReturnOfMultiTurnContainers);
	QueryOptions.Insert("PackageDepositIsRequired", SelectionByHeader.PackageDepositIsRequired);
	QueryOptions.Insert("SumOfMutualSettlementsOfRealization", SelectionByHeader.AmountARAP);
	QueryOptions.Insert("AmountOfCollateralForImplementation", 0);
	QueryOptions.Insert("DepositAmountNotSpecified", True);
	QueryOptions.Insert("NotCheckLineCode", DocumentType <> Type("DocumentObject.CustomerInvoice"));
	QueryOptions.Insert("ToUseTermsOfSales", ToUseTermsOfSales);
	QueryOptions.Insert("RegistrationCountry", SettingsValueClientServerCached.CountryOfOrganizationRegistration(
		Common.ObjectAttributeValue(DocumentSales.Ref, "Organization")));
	QueryOptions.Insert("ScheduleInAgreement", DocumentType = Type("DocumentObject.CustomerInvoiceServices")
	                                               Or DocumentType = Type("DocumentObject.CustomerInvoice"));
	
	If UseRestrictionsOnAgreements Then
		QueryOptions.Insert("CustomerTermsOfSales", SelectionByHeader.Terms);
	EndIf;
	
	GroupOfUsersWithSalesSettings = SalesSettingsForUsersServer.GetUserSGroupWithSalesSettingsForUser(
		Users.AuthorizedUser(), 
		"DiscountsMarkups"
	);
	QueryOptions.Insert("UsersGroup", GroupOfUsersWithSalesSettings);

	ByReference_ = True;
	
	UsePriceChecks = PriceManagementSystemServerCall.UsePriceManagementSystem25(SelectionByHeader.Date) 
		And (ChecksArray.Find("EntryOfPricesIntoAcceptableRange") <> Undefined
			Or ChecksArray.Find("ComplianceOfGoodsWithSalesConditions") <> Undefined);
	
	For Each CurItem In ChecksArray Do

		If CurItem = "TemporaryTableSalesDocument" Then
		
			CreateQueryTemporaryTableSalesDocumentHeader(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
		
		ElsIf CurItem = "TemporaryTableOfGoods_" Then
		
			GenerateTemporaryTableProductsQueryOfSalesDocument(QueryText, 
																		QueryOptions, 
																		DocumentSales, 
																		TableName, 
																		ConsiderDiscountsMarkups, 
																		ByReference_,
																		UsePriceChecks);
		
		ElsIf CurItem = "TemporaryTablePriceGroups" Then
		
			CreateQueryTemporaryTablePriceGroupsOfSalesDocument(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
		
		ElsIf CurItem = "TimeTableStagesOfPaymentSchedule" Then
		
			GenerateQueryTemporaryTablePaymentStagesOfSalesDocument(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
			
		ElsIf CurItem = "TemporaryTableCurrencyExchangeRates" Then
			
			GenerateQueryTemporaryTableCurrencyExchangeRates(QueryText, QueryOptions, DocumentSales);
			
		ElsIf CurItem = "TemporaryTableWarehousesCorrectByAgreement" Then
			
			GenerateRequestTemporaryTableWarehousesCorrectByAgreement(QueryText);
			
		ElsIf CurItem = "ComplianceOfHeaderWithSalesConditions" Then
			
			GenerateSalesDocumentHeaderRequest(QueryText, TableName);
			
		ElsIf CurItem = "ComplianceOfGoodsWithSalesConditions" Then
			
			GenerateRequestProductsForSale(QueryText, TableName, UsePriceChecks);
			
		ElsIf CurItem = "CorrespondenceBetweenPriceGroupsAndSalesConditions" Then
			
			GenerateQueryThatMatchesProductPriceGroupsToSalesConditions(QueryText);
			
		ElsIf CurItem = "WhetherProductsBelongToProductSegment" Then
			
			CreateQueryWhetherProductsBelongToProductSegment(QueryText);
			
		ElsIf CurItem = "PartnerSAffiliationToPartnerSegment" Then
			
			GenerateQueryWhetherPartnerBelongsToPartnerSegment(QueryText);
			
		ElsIf CurItem = "CorrectnessOfPaymentScheduleStages" Then
			
			GenerateRequestForCorrectnessOfPaymentScheduleStages(QueryText, QueryOptions);
			
		ElsIf CurItem = "EntryOfPricesIntoAcceptableRange" Then
			
			GenerateRequestForPricesInAcceptableRange(QueryText, UsePriceChecks);
			
		ElsIf  CurItem = "TemporaryTableLimitingManualDiscountsForAUserGroup" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableLimitingManualDiscountsUserGroups(QueryText);
			
		ElsIf  CurItem = "TemporaryTableManualDiscountRestrictionsUserGroupRestrictions" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableRestrictionOfManualDiscountsRestrictionsOnUserGroups(QueryText, UsePriceGroups);
			
		ElsIf  CurItem = "TemporaryTableManualDiscountRestrictionsGroupAndUserRestrictions" Then
			
			SalesSettingsForUsersServer.CreateTemporaryTableQueryLimitingManualDiscountsRestrictionsOnGroupsAndUsers(QueryText, UsePriceGroups);
			
		ElsIf  CurItem = "TemporaryTableLimitationOfManualDiscountsGeneralRestrictions" Then
			
			SalesSettingsForUsersServer.CreateQueryTemporaryTableManualDiscountRestrictionGeneralRestrictions(QueryText, UsePriceGroups, UseUserRestrictions, UseRestrictionsOnAgreements);
			
		ElsIf  CurItem = "TemporaryTableLimitingManualDiscounts" Then
			
			SalesSettingsForUsersServer.CreateRequestTemporaryTableLimitingManualDiscounts(QueryText);
			
		ElsIf CurItem = "ToleranceForManualMarkUpDiscounts" Then
			
			GenerateRequestWhetherManualDiscountsAndSurchargesAreAcceptable(QueryText);
			
		ElsIf CurItem = "TemporaryTablePaymentStepsTermsStandard" Then
			
			GenerateRequestTemporaryTableStagesOfPaymentOfStandardAgreement(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
			
		ElsIf CurItem = "TemporaryTableStagesOfPaymentOfIndividualAgreement" Then
			
			CreateRequestTemporaryTablePaymentStagesAgreementIndividual(QueryText, QueryOptions, DocumentSales, ByReference_, TableName);
			
		ElsIf CurItem = "CorrectnessOfPaymentStagesOfAgreement" Then
			
			GenerateRequestForCorrectnessOfPaymentStagesOfAgreement(QueryText);
			
		ElsIf CurItem = "NumberOfPaymentStagesIsCorrect" Then
			
			GenerateRequestForCorrectnessOfNumberOfPaymentStagesOfAgreement(QueryText);
			
		ElsIf CurItem = "TemporaryTableOfSettlementAmounts" Then
			
			GenerateRequestTemporaryTableOfSettlementAmounts(QueryText);
			
		ElsIf CurItem = "ComplianceOfPrepaymentAmountWithPaymentSchedule" Then
			
			GenerateRequestThatMatchesPrepaymentAmountToPaymentSchedule(QueryText);
			
		EndIf;
		
	EndDo;
	
	If Not ValueIsFilled(QueryText) Then
		SetPrivilegedMode(False);
		Return;
	EndIf;

	Query = New Query(QueryText);
	
	For Each QueryParameter In QueryOptions Do
		Query.SetParameter(QueryParameter.Key, QueryParameter.Value);
	EndDo;
	
	ResultsArray = Query.ExecuteBatch(); 
	
	ArrayOfHeaderDeviations         = New Array;
	ArrayOfDeviationsDiscountsMargins = New Array;
	DeviationTreeGoods        = Reports.VariancesFromSalesTermsAndConditions.InitializeRejectionTree();
	PriceGroupDeviationTree      = Reports.VariancesFromSalesTermsAndConditions.InitializeRejectionTree();
	DeviationTreePaymentStages   = Reports.VariancesFromSalesTermsAndConditions.InitializeRejectionTree();
	
	For CurIndex__ = 0 To ResultsArray.Count()-1 Do
		
		Selection = ResultsArray[CurIndex__].Select();
		
		If ChecksArray[CurIndex__] = "ComplianceOfHeaderWithSalesConditions" Then
			
			ReportErrorsSalesDocumentHeader(Selection,DocumentSales,False,ArrayOfHeaderDeviations);
			
		ElsIf ChecksArray[CurIndex__] = "ComplianceOfGoodsWithSalesConditions" Then
		
			ReportErrorsInSalesDocument(Selection,DocumentSales,False,DeviationTreeGoods);
			
		ElsIf ChecksArray[CurIndex__] = "CorrespondenceBetweenPriceGroupsAndSalesConditions" Then
			
			ReportErrorsThatProductPriceGroupsMeetSalesConditions(Selection, DocumentSales, False, PriceGroupDeviationTree);
			
		ElsIf ChecksArray[CurIndex__] = "WhetherProductsBelongToProductSegment" Then
			
			ReportErrorsWhetherProductsBelongToProductSegment(Selection, DocumentSales, False, DeviationTreeGoods);
			
		ElsIf ChecksArray[CurIndex__] = "PartnerSAffiliationToPartnerSegment" Then
			
			ReportErrorsWhetherPartnerBelongsToPartnerSegment(Selection, DocumentSales, False, ArrayOfHeaderDeviations);
			
		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfPaymentScheduleStages" Then
			
			ReportErrorsCorrectnessOfPaymentScheduleStages(Selection, DocumentSales, False, DeviationTreePaymentStages, ArrayOfHeaderDeviations);
			
		ElsIf ChecksArray[CurIndex__] = "EntryOfPricesIntoAcceptableRange" Then
			
			ReportErrorsWhenPricesFallWithinAcceptableRange(Selection, DocumentSales, False, CheckDiscountsMarkups, DeviationTreeGoods);
			
		ElsIf ChecksArray[CurIndex__] = "ToleranceForManualMarkUpDiscounts" Then
			
			ReportErrorsAcceptanceOfManualDiscountsMargins(Selection, DocumentSales,False,DeviationTreeGoods);
			
		ElsIf ChecksArray[CurIndex__] = "CorrectnessOfPaymentStagesOfAgreement" Then
			
			ReportErrorsCorrectnessOfPaymentStagesInAgreement(Selection, DocumentSales, False, DeviationTreePaymentStages);
			
		ElsIf ChecksArray[CurIndex__] = "NumberOfPaymentStagesIsCorrect" Then
			
			ReportErrorsCorrectnessOfNumberOfPaymentStagesInAgreement(Selection, DocumentSales, False, ArrayOfHeaderDeviations);
			
		ElsIf ChecksArray[CurIndex__] = "ComplianceOfPrepaymentAmountWithPaymentSchedule" Then
			ReportErrorsThatPrepaymentAmountMatchesPaymentSchedule(Selection, DocumentSales, False, ArrayOfHeaderDeviations);
		EndIf;
	
	EndDo;
	ThereAreVariances = ArrayOfHeaderDeviations.Count() > 0 
		Or PriceGroupDeviationTree.Rows.Count() > 0 
		Or DeviationTreeGoods.Rows.Count() > 0 
		Or DeviationTreePaymentStages.Rows.Count() > 0
		Or ArrayOfDeviationsDiscountsMargins.Count() > 0;
	
	Reports.VariancesFromSalesTermsAndConditions.OutputReportHeader(ReportTable, ThereAreVariances);
	
	If ArrayOfHeaderDeviations.Count() > 0 Then
		Reports.VariancesFromSalesTermsAndConditions.DisplayDeviationsInHeaderArea(ArrayOfHeaderDeviations, ReportTable);
	EndIf;
	
	If PriceGroupDeviationTree.Rows.Count() > 0 Then
		Reports.VariancesFromSalesTermsAndConditions.DisplayComplianceOfProductPriceGroupsWithSalesConditions(DocumentSales, PriceGroupDeviationTree, ReportTable);
	EndIf;
	
	If DeviationTreeGoods.Rows.Count() > 0 Then
		Reports.VariancesFromSalesTermsAndConditions.DisplayAllProductsForSale(DocumentSales, DeviationTreeGoods, ReportTable);
	EndIf;
	
	If DeviationTreePaymentStages.Rows.Count() > 0 Then
		Reports.VariancesFromSalesTermsAndConditions.DisplayAllStagesOfPaymentAndSales(DocumentSales, DeviationTreePaymentStages, ReportTable);
	EndIf;
	
	If ArrayOfDeviationsDiscountsMargins.Count() > 0 Then
		Reports.VariancesFromSalesTermsAndConditions.DisplayDeviationsDiscountsMargins(ArrayOfDeviationsDiscountsMargins, ReportTable);
	EndIf;
	
	SetPrivilegedMode(False);
	
EndProcedure

// Checks whether a document can be entered based on an agreement, depending on the business transaction.
//
// Parameters:
//	DocumentName       - String - name of the document that valid operations are defined for.
//	AgreementOperation - EnumRef.BusinessTransactions - business transaction of the agreement.
//
Procedure CheckPossibilityOfEnteringOnBasisOfAgreement(DocumentName, AgreementOperation) Export
	
	DocumentOperations = TMCommonUse.PermissibleBusinessOperationsOfDocument(DocumentName);
	
	If DocumentOperations.Find(AgreementOperation) = Undefined Then
		ErrorText = NStr("vi = 'Không thể nhập chứng từ trên cơ sở thỏa thuận với giao dịch ""%Operation%"".';
						|ru = 'Нельзя выполнить ввод документа на основании соглашения с операцией ""%Operation%"".';
						|en = 'Cannot generate the document based on the agreement with the ""%Operation%"" transaction.'; fa = 'Cannot generate the document based on the agreement with the ""%Operation%"" transaction.';
						|it = 'Non è possibile inserire un documento sulla base di un accordo con un affare ""%Operation%"".';
						|pl = 'Nie można wprowadzić dokumentu na podstawie umowy z operacją ""%Operation%"".';
						|tr = '""%Operation%"" işlemi ile yapılan anlaşmaya göre belge girişi gerçekleştirilmedi.'");
		ErrorText = StrReplace(ErrorText, "%Operation%", AgreementOperation);
		
		Raise ErrorText;
	EndIf
	
EndProcedure

// Returns the text of the remainder control error.
//
// Parameters:
// 	RegistrationOption - EnumRef.SalesRegistrationOptions
//
// Returns:
//  String - Balance control error text
//
Function ErrorTextNoProductsAvailableForShipment(RegistrationOption) Export
	
	If RegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer Then
		ErrorText = NStr("vi = 'Để bắt đầu quy trình giao hàng, hãy chắc chắn rằng, đối với dịch vụ với phương án tạo là ""%1"" có chỉ định thao tác ""Cần giao hàng"".';
						|ru = 'Для начала процесса отгрузки убедитесь, что для услуг с вариантом оформления ""%1"" указано действие ""Отгрузить"".';
						|en = 'To start shipment, make sure the ""Ship"" action is specified for services with the ""%1"" registration option.'; fa = 'To start shipment, make sure the ""Ship"" action is specified for services with the ""%1"" registration option.';
						|it = 'Для начала процесса отгрузки убедитесь, что для услуг с вариантом оформления ""%1"" указано действие ""Отгрузить"".';
						|pl = 'To start shipment, make sure the ""Ship"" action is specified for services with the ""%1"" registration option.';
