			|					OR SalesOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
			|				THEN SalesOrder.CarrierPartner
			|			ELSE VALUE(Catalog.Partners.EmptyRef)
			|		END AS CarrierPartner,
			|		CASE
			|			WHEN SalesOrder.DeliveryMethod <> VALUE(Enum.TransportMethods.SelfPickup)
			|				OR SalesOrder.DeliveryAddress <> """"
			|				THEN SalesOrder.DeliveryAddress
			|			ELSE """"
			|		END AS DeliveryAddress,
			|		CASE
			|			WHEN SalesOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrier)
			|					OR SalesOrder.DeliveryMethod = VALUE(Enum.TransportMethods.ByCarrierToAddress)
			|				THEN SalesOrder.DeliveryAddressOfCarrier
			|			ELSE """"
			|		END AS DeliveryAddressOfCarrier,
			|		SalesOrder.Ref AS SalesOrder,
			|		SalesOrder.ToReturnReusablePackage AS ToReturnReusablePackage,
			|		SalesOrder.ReusablePackageReturnCycleLength AS ReusablePackageReturnCycleLength,
			|		SalesOrder.PackageDepositIsRequired AS PackageDepositIsRequired,
			|		CASE
			|			WHEN &ToUseTermsOfSales
			|				THEN SalesOrder.Terms.ScheduleOfPackageReturn
			|			ELSE VALUE(Catalog.BusinessCalendars.EmptyRef)
			|		END AS ScheduleOfPackageReturn,
			|		CASE
			|			WHEN &ToUseTermsOfSales
			|				THEN SalesOrder.Terms.CalculatePackageReturnDateAccordingToCalendar
			|			ELSE FALSE
			|		END AS CalculatePackageReturnDateAccordingToCalendar,
			|		SalesOrder.LineOfBusiness AS LineOfBusiness,
			|		SalesOrder.ARAPObjectSettings AS ARAPObjectSettings
			|	FROM
			|		TTCustomerOrders AS SalesOrder
			|		INNER JOIN Document.SalesOrder.Goods AS CustomerOrderGoods
			|			ON SalesOrder.Ref = CustomerOrderGoods.Ref
			|			AND (SalesOrder.WarehouseInOrderHeader OR SalesOrder.Warehouse = CustomerOrderGoods.Warehouse)
			|	WHERE
			|		(NOT &UseWarehouseSelection
			|			OR SalesOrder.Warehouse IN(&Warehouse, VALUE(Catalog.Warehouses.EmptyRef)))
			|		AND CustomerOrderGoods.Products.SaleRegistrationOption IN (&ArrayOfDesignOptions)
			|		AND CASE
			|			WHEN &ArrangeShipment = TRUE
			|				THEN CustomerOrderGoods.Products.ItemsType IN (
			|						VALUE(Enum.ItemsTypes.OwnGoods),
			|						VALUE(Enum.ItemsTypes.Set))
			|			ELSE TRUE
			|		END
			|		AND SalesOrder.ThisIsOrderAsInvoice
			|");
		
	EndIf;
	
	QueryText = StrConcat(QueryTexts, Common.QueryBatchSeparator());
	QueryText =
		StrReplace(
			QueryText,
			"&TextsOfOrderForRegistration",
			"(" + StrConcat(TextsOfOrderForRegistration, TMCommonUse.QuerySeparatorInJoin()) + ")");
	
	Return QueryText;
	
EndFunction

Function QueryTextForSignificantAttributesOfShipmentOrders()

	QueryText = 
	"SELECT ALLOWED DISTINCT
	|	ReferenceOrder.Ref AS Ref,
	|	ReferenceOrder.Partner AS Partner,
	|	ReferenceOrder.Counterparty AS Counterparty,
	|	ReferenceOrder.Contract AS Contract,
	|	ReferenceOrder.Organization AS Organization,
	|	ReferenceOrder.Terms AS Terms,
	|	ReferenceOrder.SalesOpportunity AS SalesOpportunity,
