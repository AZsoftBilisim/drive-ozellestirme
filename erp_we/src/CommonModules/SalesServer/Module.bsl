// Returns the structure for the responsible person of the specified warehouse
// If the warehouse is a group, returns the values
// 		used in the last document of the specified Manager with the specified warehouse.
//
// Parameters:
// 		Warehouse - CatalogRef.Warehouses - Warehouse / group of warehouses
//
// Returns:
// 		Undefined, Structure - structure with fields: 
// 		* EmployeeResponsible - CatalogRef.Persons - Responsible person
// 		* ResponsiblePosition - String - Position of the responsible person
//
Function GetWarehouseManager(Warehouse) Export
	
	If Not ValueIsFilled(Warehouse) Then
		Return Undefined;
	EndIf;
	
	If Not Catalogs.Warehouses.IsFolder(Warehouse) Then
		StructureOfResponsible = SettingsValueCached.GetWarehouseManager(Warehouse);
		If StructureOfResponsible <> Undefined Then
			Return StructureOfResponsible;
		EndIf;
	EndIf;

	Return Undefined;
	
EndFunction

// Searches for a valid contract with a counterparty using the specified details.
// If one valid contract is found, it returns a link to it, otherwise it returns an empty link.
//
// Parameters:
//   Object                  - DocumentObject - The object from which the main parameters for the search will be taken.
//   BusinessTransactions   - EnumRef.BusinessTransactions, Array - One or more business
//                             transactions (contract type).
//   ARAPCurrency    - CatalogRef.Currencies - Currency of mutual settlements with the partner under the agreement.
//   LineOfBusiness - CatalogRef.LinesOfBusiness - The direction of the desired agreement.
//                             If not specified, the search is performed in all directions.
//   ConsignmentSales25   - Boolean - The attribute of attributing the contract to commission sales version 2.5.
//                             If not specified, the attribute is ignored.
// 
// Returns:
//   CatalogRef.CounterpartyContracts  - the default counterparty agreement.
//
Function GetDefaultContract(
	Object,
	BusinessTransactions,
	ARAPCurrency = Undefined,
	LineOfBusiness = Undefined,
	ConsignmentSales25 = Undefined
	) Export
	
	If Not GetFunctionalOption("UseCustomerContracts") Then
		Return Catalogs.CounterpartyContracts.EmptyRef();
	EndIf;
	
	If GetFunctionalOption("ToUseTermsOfSales")
		And TMCommonUseClientServer.HasObjectAttribute(Object, "Terms") Then 
		
		CounterpartyContactsAreUsedAccordingToAgreement = ValueIsFilled(Object.Terms)
			And Common.ObjectAttributeValue(Object.Terms, "ContractsAreUsed");
		
		If Not CounterpartyContactsAreUsedAccordingToAgreement Then
			Return Catalogs.CounterpartyContracts.EmptyRef();
		EndIf;
		
	EndIf;
	
	PartnerList = New ValueList;
	PartnersAndCounterparties.FillInListOfPartnersWithParents(Object.Partner, PartnerList);
	
	Query = New Query("
	|SELECT
	|	CounterpartyContracts.Ref,
	|	CounterpartyContracts.Partner,
	|	CounterpartyContracts.ItIsAllowedToWorkWithSubsidiaryPartners
	|
	|FROM
	|	Catalog.CounterpartyContracts AS CounterpartyContracts
	|
	|WHERE
	|	(NOT CounterpartyContracts.DeletionMark)
	|	AND CounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
	|	AND CounterpartyContracts.Partner IN (&PartnerList)
	|	AND CounterpartyContracts.Counterparty = &Counterparty
	|	AND CounterpartyContracts.Organization = &Organization
	|	AND ((NOT &FilterBusinessOperation)
	|			OR CounterpartyContracts.BusinessOperation IN (&BusinessOperation))
	|	AND ((NOT &FilterARAPCurrency)
	|			OR CounterpartyContracts.ARAPCurrency = &ARAPCurrency)
	|	AND CounterpartyContracts.Ref = &CurContract
	|	AND ((NOT &FilterLineOfBusiness)
	|			OR CounterpartyContracts.LineOfBusiness = &LineOfBusiness)
	|	AND ((NOT &FilterConsignmentSales25)
	|			OR CounterpartyContracts.ConsignmentSales25 = &ConsignmentSales25);
	|
	|SELECT ALLOWED TOP 2
	|	CounterpartyContracts.Ref,
	|	CounterpartyContracts.Partner,
	|	CounterpartyContracts.ItIsAllowedToWorkWithSubsidiaryPartners
	|
	|FROM
	|	Catalog.CounterpartyContracts AS CounterpartyContracts
	|
	|WHERE
	|	(NOT CounterpartyContracts.DeletionMark)
	|	AND CounterpartyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
	|	AND CounterpartyContracts.Partner IN (&PartnerList)
	|	AND CounterpartyContracts.Counterparty = &Counterparty
	|	AND CounterpartyContracts.Organization = &Organization
	|	AND ((NOT &FilterBusinessOperation)
	|			OR CounterpartyContracts.BusinessOperation IN (&BusinessOperation))
	|	AND ((NOT &FilterARAPCurrency)
	|			OR CounterpartyContracts.ARAPCurrency = &ARAPCurrency)
	|	AND ((NOT &FilterLineOfBusiness)
	|			OR CounterpartyContracts.LineOfBusiness = &LineOfBusiness)
	|	AND ((NOT &FilterConsignmentSales25)
	|			OR CounterpartyContracts.ConsignmentSales25 = &ConsignmentSales25)
	|");
	Query.SetParameter("CurContract", Object.Contract);
	Query.SetParameter("PartnerList", PartnerList);
	Query.SetParameter("Counterparty", Object.Counterparty);
	Query.SetParameter("Organization", Object.Organization);
	Query.SetParameter("FilterBusinessOperation", ValueIsFilled(BusinessTransactions));
	Query.SetParameter("BusinessOperation", BusinessTransactions);
	Query.SetParameter("FilterARAPCurrency", ValueIsFilled(ARAPCurrency));
	Query.SetParameter("ARAPCurrency", ARAPCurrency);
	Query.SetParameter("FilterLineOfBusiness", LineOfBusiness <> Undefined
		And GetFunctionalOption("UseIncomeAccountingByLinesOfBusiness"));
	Query.SetParameter("LineOfBusiness",LineOfBusiness);
	Query.SetParameter("FilterConsignmentSales25", ValueIsFilled(ConsignmentSales25));
	Query.SetParameter("ConsignmentSales25", ConsignmentSales25);
	
	ResultsArray = Query.ExecuteBatch();
	
	AgreementPartner = Catalogs.Partners.EmptyRef();
	ItIsAllowedToWorkWithSubsidiaryPartners = False;
	If Not ResultsArray[0].IsEmpty() Then
		
		Selection = ResultsArray[0].Select();
		Selection.Next();
		
		DefaultContract = Selection.Ref;
		
		AgreementPartner = Selection.Partner;
		ItIsAllowedToWorkWithSubsidiaryPartners = Selection.ItIsAllowedToWorkWithSubsidiaryPartners;
		
	Else
		Selection = ResultsArray[1].Select();
		
		If Not Selection.Next() Then
			DefaultContract = Catalogs.CounterpartyContracts.EmptyRef();
		ElsIf Selection.Count() = 1 Then
			DefaultContract = Selection.Ref;	
			AgreementPartner = Selection.Partner;
			ItIsAllowedToWorkWithSubsidiaryPartners = Selection.ItIsAllowedToWorkWithSubsidiaryPartners;
		Else
			DefaultContract = Catalogs.CounterpartyContracts.EmptyRef();
		EndIf;
	EndIf;
	
	If Not ItIsAllowedToWorkWithSubsidiaryPartners And AgreementPartner <> Object.Partner Then
		DefaultContract = Catalogs.CounterpartyContracts.EmptyRef();	
	EndIf;
	
	Return DefaultContract;
	
EndFunction

// Searches for a valid contract between organizations using the specified details.
// If one valid contract is found, it returns a link to it, otherwise it returns an empty link.
//
// Parameters:
//	Object					- DocumentObject - the document object from which the main parameters for the search will be taken.
//	Business Operations - enumerationslink.Type of agreements between organizations,
//								Array - value or multiple values of contract types.
//	ContractType				- EnumRef.TypesOfIntercompanyContracts - 
//	ARAPCurrency	- CatalogRef.Currencies - the currency of mutual settlements between organizations.
//	LineOfBusiness	- CatalogRef.LinesOfBusiness - The direction of activity of the desired contract.
//																			If not specified, then the search is conducted
//																			in all directions.
// 
// Returns:
//	CatalogRef.IntercompanyContracts - the default agreement.
//
Function GetDefaultAgreementBetweenOrganizations(Object,
													ContractType,
													ARAPCurrency = Undefined,
													LineOfBusiness = Undefined) Export
	
	DefaultContract = Catalogs.IntercompanyContracts.EmptyRef();
	
	If Not GetFunctionalOption("UseIntercompanyContracts") Then
		Return DefaultContract;
	EndIf;
	
	Query = New Query;
	Query.Text =
	"SELECT ALLOWED
	|	IntercompanyContracts.Ref AS Ref
	|FROM
	|	Catalog.IntercompanyContracts AS IntercompanyContracts
	|
	|WHERE
	|	IntercompanyContracts.Ref = &Ref
	|	AND NOT IntercompanyContracts.DeletionMark
	|	AND IntercompanyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
	|	AND IntercompanyContracts.Organization = &Organization
	|	AND IntercompanyContracts.CompanyRecipient = &CompanyRecipient
	|	AND (NOT &FilterContractType
	|		OR IntercompanyContracts.ContractType IN (&ContractType))
	|	AND (NOT &FilterARAPCurrency
	|		OR IntercompanyContracts.ARAPCurrency = &ARAPCurrency)
	|	AND (NOT &FilterLineOfBusiness
	|		OR IntercompanyContracts.LineOfBusiness = &LineOfBusiness)
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////// 1
	|SELECT ALLOWED TOP 2
	|	IntercompanyContracts.Ref AS Ref
	|FROM
	|	Catalog.IntercompanyContracts AS IntercompanyContracts
	|
	|WHERE
	|	NOT IntercompanyContracts.DeletionMark
	|	AND IntercompanyContracts.Status = VALUE(Enum.CounterpartyContractStatuses.Valid)
	|	AND IntercompanyContracts.Organization = &Organization
	|	AND IntercompanyContracts.CompanyRecipient = &CompanyRecipient
	|	AND (NOT &FilterContractType
	|		OR IntercompanyContracts.ContractType IN (&ContractType))
	|	AND (NOT &FilterARAPCurrency
	|		OR IntercompanyContracts.ARAPCurrency = &ARAPCurrency)
	|	AND (NOT &FilterLineOfBusiness
	|		OR IntercompanyContracts.LineOfBusiness = &LineOfBusiness)";
	
	FilterContractType = ValueIsFilled(ContractType);
	FilterARAPCurrency = ValueIsFilled(ARAPCurrency);
	FilterLineOfBusiness = LineOfBusiness <> Undefined
									And GetFunctionalOption("UseIncomeAccountingByLinesOfBusiness");
	
	Query.SetParameter("Ref",							Object.Contract);
	Query.SetParameter("Organization",					Object.Organization);
	Query.SetParameter("CompanyRecipient",			Object.CompanyRecipient);
	Query.SetParameter("FilterContractType",				FilterContractType);
	Query.SetParameter("ContractType",					ContractType);
	Query.SetParameter("FilterARAPCurrency",		FilterARAPCurrency);
	Query.SetParameter("ARAPCurrency",			ARAPCurrency);
	Query.SetParameter("FilterLineOfBusiness",	FilterLineOfBusiness);
	Query.SetParameter("LineOfBusiness",		LineOfBusiness);
	
	QueryResult = Query.ExecuteBatch();
	
	If Not QueryResult[0].IsEmpty() Then
		Selection = QueryResult[0].Select();
		Selection.Next();
		
		DefaultContract = Selection.Ref;
	Else
		Selection = QueryResult[1].Select();
		Selection.Next();
	
		If Selection.Count() Then
			DefaultContract = Selection.Ref;
		EndIf;
	EndIf;
	
	Return DefaultContract;
	
EndFunction

// Sets the availability and visibility properties of the contract details depending on the agreement data.
//
// Parameters:
//	Object				- FormDataStructure					- The document object for which you are configuring the properties of the contract.
//	ElementAvailability	- Boolean								- Indicates whether the availability property of the Contract element is used on the document form.
//	ItemVisibility	- Boolean								- Indicates whether the visibility property of the Contract element is used on the document form.
//	Contract				- CatalogRef.CounterpartyContracts	- A contract document.
//
Procedure SetContractAvailability(Object, ElementAvailability, ItemVisibility, Contract = Undefined) Export
	
	UsePartnersAsCounterparties = GetFunctionalOption("UsePartnersAsCounterparties");
	ContractsAreUsed     = GetFunctionalOption("UseCustomerContracts");
	
	InfluenceFieldsFilledIn = ValueIsFilled(Object.Partner)
							And (ValueIsFilled(Object.Counterparty)
								Or UsePartnersAsCounterparties)
							And ValueIsFilled(Object.Organization);
	
	If GetFunctionalOption("ToUseTermsOfSales") Then
		
		TransactionAgreementsAreUsed = Object.Property("BusinessOperation")
											And TransactionsUsingCounterpartyAgreements().Find(Object.BusinessOperation) <> Undefined;
		
		InfluenceFieldsFilledIn = InfluenceFieldsFilledIn
								And (ValueIsFilled(Object.Terms)
									Or TransactionAgreementsAreUsed);
		
		SetPrivilegedMode(True);
		ContractsAreUsed = ContractsAreUsed
											And ((ValueIsFilled(Object.Terms)
												And Common.ObjectAttributeValue(Object.Terms, "ContractsAreUsed"))
											Or TransactionAgreementsAreUsed);
		SetPrivilegedMode(False);
		
	EndIf;
	
	ElementAvailability = InfluenceFieldsFilledIn
							And ContractsAreUsed;
	ItemVisibility   = ContractsAreUsed;
	
	If Not ElementAvailability
		And ValueIsFilled(Object.Contract) Then
		
		Object.Contract = Catalogs.CounterpartyContracts.EmptyRef();
		
	EndIf;
	
EndProcedure

// The procedure sets the blank mark depending on the system settings.
