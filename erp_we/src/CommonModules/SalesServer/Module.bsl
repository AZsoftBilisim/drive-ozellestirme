	|			THEN MAX(SalesOrder.CompensationMethod)
	|		ELSE VALUE(Enum.CompensationMethodsForReturnsOfGoods.EmptyRef)
	|	END AS CompensationMethod,
	|	CASE
	|		WHEN COUNT(DISTINCT SalesOrder.ReturnOfSpoiledGoods) = 1
	|			THEN MAX(SalesOrder.ReturnOfSpoiledGoods)
	|		ELSE FALSE
	|	END AS ReturnOfSpoiledGoods,
	|	CASE
	|		WHEN COUNT(DISTINCT SalesOrder.UISStateContractStep) = 1
	|			THEN MAX(SalesOrder.UISStateContractStep)
	|		ELSE UNDEFINED
	|	END AS UISStateContractStep,
	|	CASE
	|		WHEN COUNT(DISTINCT SalesOrder.ThisIsOrderAsInvoice) = 1
	|			THEN MAX(SalesOrder.ThisIsOrderAsInvoice)
	|		ELSE FALSE
	|	END AS ThisIsOrderAsInvoice
	|INTO TTHeaderDetails
	|FROM
	|	TTDataSources AS SalesOrder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT TOP 1
	|	DocumentHeader.BankAccount AS BankAccount,
	|	DocumentHeader.CounterpartyBankAccount AS CounterpartyBankAccount,
	|	DocumentHeader.Shipper AS Shipper,
	|	DocumentHeader.GoodsRecipient AS GoodsRecipient,
	|	DocumentHeader.ShipperBankAccount AS ShipperBankAccount,
	|	DocumentHeader.GoodsRecipientBankAccount AS GoodsRecipientBankAccount,
	|	DocumentHeader.CashAccount AS CashAccount,
	|	DocumentHeader.PaymentMethod AS PaymentMethod,
	|	CASE
	|		WHEN DocumentHeader.DeliveryAddressFieldValues
	|			THEN OrderHeader_.DeliveryAddressFieldValues
	|		ELSE """"
	|	END AS DeliveryAddressFieldValues,
	|	CASE
	|		WHEN DocumentHeader.DeliveryAddressOfCarrierFieldValues
	|			THEN OrderHeader_.DeliveryAddressOfCarrierFieldValues
	|		ELSE """"
	|	END AS DeliveryAddressOfCarrierFieldValues,
	|	DocumentHeader.DeliveryZone AS DeliveryZone,
	|	DocumentHeader.DeliveryTimeFrom AS DeliveryTimeFrom,
	|	DocumentHeader.DeliveryTimeTo AS DeliveryTimeTo,
	|	CASE
	|		WHEN DocumentHeader.AdditionalDeliveryInformation
	|			THEN OrderHeader_.AdditionalDeliveryInformation
	|		ELSE """"
	|	END AS AdditionalDeliveryInformation,
	|	DocumentHeader.PriceIncludesVAT AS PriceIncludesVAT,
	|	DocumentHeader.VATTaxation AS VATTaxation,
	|	DocumentHeader.Contract AS Contract,
	|	ISNULL(DocumentHeader.Contract.ConsignmentSales25, FALSE) AS ConsignmentSales25,
	|	DocumentHeader.Terms AS Terms,
	|	DocumentHeader.ContactPerson AS ContactPerson,
	|	DocumentHeader.CompensationMethod AS CompensationMethod,
	|	DocumentHeader.ReturnOfSpoiledGoods AS ReturnOfSpoiledGoods,
	|	DocumentHeader.UISStateContractStep AS UISStateContractStep,
	|	DocumentHeader.ThisIsOrderAsInvoice AS ThisIsOrderAsInvoice
	|FROM
	|	TTHeaderDetails AS DocumentHeader
	|		LEFT JOIN TTDataSources AS OrderHeader_
	|		ON DocumentHeader.PaymentMethod = OrderHeader_.PaymentMethod
	|";
	
	QueriesTexts = New Array();
	QueriesTexts.Add(QueryTextDataSources);
	QueriesTexts.Add(QueryText);
	
	Query = New Query();
	Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	Query.SetParameter("ReferenceArray", ReferenceArray);
	QueryResult = Query.Execute();
	Selection = QueryResult.Select();
	Selection.Next();
	AttributesStructure1 = New Structure;
	For Each Column In QueryResult.Columns Do
		ColumnName = Column.Name;
		AttributesStructure1.Insert(ColumnName, Selection[ColumnName]);
	EndDo;
	
	Return AttributesStructure1;
	
EndFunction

Procedure CreateSalesDocument_(DocumentFields, BasisParameters, DocumentsArray, GenerationParameters) Export
	
	InvoiceManager = Documents.CustomerInvoice;
	
	CreateSalesDocument			= GenerationParameters.CreateSalesDocument;
	CreateCashAccountReceiptNote		= GenerationParameters.CreateCashAccountReceiptNote;
	CreateNewDocument				= GenerationParameters.CreateNewDocument;
	ArrangeShipment					= GenerationParameters.ArrangeShipment;
	NewDocumentName					= GenerationParameters.NewDocumentName;
	
	DiscountsAreCalculated	= True;
	Print			= False;
	
	If	ValueIsFilled(NewDocumentName)
			And (CreateNewDocument Or ArrangeShipment) Then
		
		// Transfer Of Ownership
		If NewDocumentName = "CustomerInvoice" Then
			NewDocument = Documents.CustomerInvoice.CreateDocument();
		Else
			InvoiceManager = Documents[NewDocumentName];
			NewDocument = Documents[NewDocumentName].CreateDocument();
			DiscountsAreCalculated = False;
			CreateCashAccountReceiptNote = False;
		EndIf;
		
	ElsIf DocumentFields.BusinessOperation = Enums.BusinessTransactions.ReturnOfGoodsFromCustomer Then
		
		InvoiceManager = Documents.ReturnOfGoodsFromCustomer;
		NewDocument = Documents.ReturnOfGoodsFromCustomer.CreateDocument();
		
	ElsIf DocumentFields.BusinessOperation = Enums.BusinessTransactions.TransferToStorageWithRightOfSale Then
		
		InvoiceManager = Documents.TransferOfGoodsToBailee;
		NewDocument = Documents.TransferOfGoodsToBailee.CreateDocument();
		
		Print = GenerationParameters.PrintTheTransferOfGoodsToBailee;
	ElsIf DocumentFields.BusinessOperation = Enums.BusinessTransactions.TransferToToller2_5 Then
		
		InvoiceManager = Documents.TransferOfGoodsToBailee;
		NewDocument = Documents.TransferOfGoodsToBailee.CreateDocument();
		
		Print = GenerationParameters.PrintTheTransferOfGoodsToBailee;
	ElsIf DocumentFields.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent 
		And DocumentFields.Contract.ConsignmentSales25 Then
		InvoiceManager = Documents.TransferOfGoodsToBailee;
		NewDocument = Documents.TransferOfGoodsToBailee.CreateDocument();

	ElsIf DocumentFields.BusinessOperation = Enums.BusinessTransactions.ReturnFromCustodian Then
		
		InvoiceManager = Documents.ReceiptOfGoodsFromCustodian;
		NewDocument = Documents.ReceiptOfGoodsFromCustodian.CreateDocument();
		
	ElsIf DocumentFields.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent Then
		
		If BasisParameters.HeaderAttributes.ConsignmentSales25 Then
			InvoiceManager = Documents.ReceiptOfGoodsFromCustodian;
		Else
			InvoiceManager = Documents.ReturnOfGoodsFromCustomer;
		EndIf;
		NewDocument = InvoiceManager.CreateDocument();
		
	ElsIf DocumentFields.BusinessOperation =  Enums.BusinessTransactions.DeliveryForPrincipal Then
		
		InvoiceManager = Documents.GoodsShipmentFromStorage;
		NewDocument = Documents.GoodsShipmentFromStorage.CreateDocument();
	ElsIf DocumentFields.BusinessOperation =  Enums.BusinessTransactions.TransferToMaterialProvider2_5 Then
		
		InvoiceManager = Documents.GoodsShipmentFromStorage;
		NewDocument = Documents.GoodsShipmentFromStorage.CreateDocument();
	ElsIf DocumentFields.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice Then
		
		NewDocument = Documents.CustomerInvoice.CreateDocument();
		NewDocument.Status = Enums.StatusesOfCustomerInvoices.Shipped;
		NewDocument.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice;
		
		Print = GenerationParameters.PrintCustomerInvoice;
	
	ElsIf DocumentFields.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer Then
		
		NewDocument = Documents.CustomerInvoice.CreateDocument();
		NewDocument.Status = Enums.StatusesOfCustomerInvoices.Shipped;
		NewDocument.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer;
		
		Print = GenerationParameters.PrintCustomerInvoice;
		
	Else
		
		NewDocument = Documents.CustomerInvoiceServices.CreateDocument();
		Print = GenerationParameters.PrintCustomerInvoiceWorksAndServices;
		
	EndIf;
	
	TypeOfNewDocument = TypeOf(NewDocument);
	If TypeOfNewDocument = Type("DocumentObject.CustomerInvoice") Or TypeOfNewDocument = Type("DocumentObject.GoodsShipmentToCustomer") Then
		DocumentName = NewDocument.Metadata().Name;
		
		ValidOperations = TMCommonUse.PermissibleBusinessOperationsOfDocument(DocumentName);
		If	ValueIsFilled(ValidOperations)
				And ValidOperations.Find(DocumentFields.BusinessOperation) = Undefined Then
			
			MessageText = NStr("vi = 'Không thể lập chứng từ ""%1""trên cơ sở lệnh có giao dịch ""%2"".';
								|ru = 'Невозможно оформить документ ""%1"" на основании распоряжения с операцией ""%2"".';
								|en = 'Cannot register the ""%1"" document based on the reference with the ""%2"" transaction.'; fa = 'Cannot register the ""%1"" document based on the reference with the ""%2"" transaction.';
								|it = 'Cannot register the ""%1"" document based on the reference with the ""%2"" transaction.';
								|pl = 'Cannot register the ""%1"" document based on the reference with the ""%2"" transaction.';
								|tr = '""%1"" belgesini ""%2"" işlemiyle siparişe göre düzenlemek mümkün değil.'");
			MessageText = StrTemplate(MessageText,
									Metadata.Documents[DocumentName].Synonym,
									DocumentFields.BusinessOperation);
			
			If GetCurrentInfoBaseSession().GetBackgroundJob() <> Undefined Then
				Raise MessageText;
			EndIf;
			Common.MessageToUser(MessageText);

			Return;

		EndIf;
	EndIf;
	
	NewDocument.Date = CurrentSessionDate();
	NewDocument.Fill(BasisParameters);
	
	If	DiscountsAreCalculated
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.ReturnOfGoodsFromCustomer
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.ReturnFromCommissionAgent
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.TransferToStorageWithRightOfSale
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.TransferToToller2_5
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.TransferToCommissionAgent
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.ReturnFromCustodian
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.TransferToMaterialProvider2_5
			And DocumentFields.BusinessOperation <> Enums.BusinessTransactions.DeliveryForPrincipal Then
		NewDocument.DiscountsAreCalculated = True;
	EndIf;
	
	If Not DocumentFields.BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods
		And (DocumentFields.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice
			Or DocumentFields.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer)
		Or DocumentFields.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
	Then
		SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(NewDocument, InvoiceManager);
		ProductsServer.FillInStatusesForSpecifyingSeries(NewDocument, SeriesSpecificationParameters);
	EndIf;
	
	DocumentPosted = False;
	
	NewDocument.Write(DocumentWriteMode.Write);
	
	NewDocumentStructure = NewlyCreatedDocument();
	FillPropertyValues(NewDocumentStructure, NewDocument);
	NewDocumentStructure.Document 			= NewDocument.Ref;
	NewDocumentStructure.ReferenceArray 	= BasisParameters.DocumentBasis;
	
	If NewDocument.CheckFilling() Then
		
		PostDocument = CreateSalesDocument;
		PostDocument = PostDocument
						   Or DocumentFields.BusinessOperation =  Enums.BusinessTransactions.TransferToMaterialProvider2_5;
		If PostDocument Then
			Try
				NewDocument.AdditionalProperties.Insert("WriteMode", DocumentWriteMode.Posting);
				NewDocument.Write(DocumentWriteMode.Posting);
				DocumentPosted = True;
				NewDocumentStructure.Posted 			= True;
				NewDocumentStructure.Print 			= Print;
			Except
				NewDocumentStructure.Posted 			= False;
				NewDocumentStructure.HasErrors 			= True;
				
				ErrorText = NStr("vi = 'Đã kết chuyển chứng từ %1 bị lỗi';
								|ru = 'Проведение документа %1 завершено с ошибкой';
								|en = 'An error occurred when posting document %1'; fa = 'An error occurred when posting document %1';
								|it = 'La pubblicazione del documento %1 è stata eseguita con errori';
								|pl = 'Zatwierdzenie dokumentu %1 zostało zakończone z błędem';
								|tr = 'Belge kaydetme %1 hata ile tamamlandı'");
				ErrorText = StrTemplate(ErrorText, NewDocument);
				WriteLogEvent(ErrorText,
							EventLogLevel.Error,,,
							DetailErrorDescription(ErrorInfo()));
			EndTry;
		Else
			Print = False;
			NewDocumentStructure.Posted 			= False;
			NewDocumentStructure.Print 			= Print;
		EndIf;
		
		
		If CreateCashAccountReceiptNote And DocumentPosted Then
			CreatePaymentDocument(NewDocument.Ref, DocumentsArray, GenerationParameters, BasisParameters.DocumentBasis);
		EndIf;
		
	Else
		NewDocumentStructure.HasErrors 			= True;
	EndIf;
	
	DocumentsArray.Add(NewDocumentStructure);
	
EndProcedure

Procedure CreatePaymentDocument(DocumentBasis, DocumentsArray, GenerationParameters, ReferenceArray = Undefined) Export
	
	NewDocument = Documents.CashAccountReceiptNote.CreateDocument();
	NewDocument.Fill(DocumentBasis);
	NewDocument.Date = CurrentSessionDate();
	
	If NewDocument.DocumentAmount = 0 Then
		Return;
	EndIf; 
	
	If ReferenceArray = Undefined Then
		ReferenceArray = New Array;
		ReferenceArray.Add(DocumentBasis);
	EndIf;
	
	NewDocument.Write(DocumentWriteMode.Write);
	
	NewDocumentStructure = NewlyCreatedDocument();
	FillPropertyValues(NewDocumentStructure, NewDocument);
	NewDocumentStructure.Document 			= NewDocument.Ref;
	NewDocumentStructure.ReferenceArray 	= ReferenceArray;
	
	If NewDocument.CheckFilling() Then
		Try
			NewDocument.Write(DocumentWriteMode.Posting);
			NewDocumentStructure.Posted 			= True;
			NewDocumentStructure.Print 			= GenerationParameters.PrintCashAccountReceiptNote;
		Except
			NewDocumentStructure.Posted 			= False;
			NewDocumentStructure.HasErrors 			= True;

			ErrorText = NStr("vi = 'Đã kết chuyển chứng từ %1 bị lỗi';
							|ru = 'Проведение документа %1 завершено с ошибкой';
							|en = 'An error occurred when posting document %1'; fa = 'An error occurred when posting document %1';
							|it = 'La pubblicazione del documento %1 è stata eseguita con errori';
							|pl = 'Zatwierdzenie dokumentu %1 zostało zakończone z błędem';
							|tr = 'Belge kaydetme %1 hata ile tamamlandı'");
			ErrorText = StrTemplate(ErrorText, NewDocument);
			WriteLogEvent(ErrorText,
						EventLogLevel.Error,,,
						DetailErrorDescription(ErrorInfo()));
		EndTry;
	Else
		NewDocumentStructure.Posted 			= False;
		NewDocumentStructure.HasErrors 			= True;
	EndIf;
	
	DocumentsArray.Add(NewDocumentStructure);
	
EndProcedure

// Returns a table of connected equipment in the context of cash registers and organizations
// 
// Parameters:
// 	CreatedDocuments - Array of Structure - Where:
// 		* Document - DocumentRef
// 		* Posted - Boolean
// 		* HasErrors - Boolean
// 		* ReferenceArray - Array of DocumentRef
// 		* Organization - CatalogRef.Companies
// 		* CashAccount - CatalogRef.CashAccounts
// 	EquipmentTable - FormDataCollection
// 	
Procedure GetConnectedHardware(CreatedDocuments, EquipmentTable) Export
	
	SearchTable = New ValueTable;
	SearchTable.Columns.Add("Organization");
	SearchTable.Columns.Add("CashAccount");
	For Each Item In CreatedDocuments Do
		If Item.Posted Then
			NewRow = SearchTable.Add();
			NewRow.Organization = Item.Organization;
			NewRow.CashAccount = Item.CashAccount;
		EndIf;
	EndDo;
	
	SearchTable.GroupBy("Organization,CashAccount");
	
	For Each String In SearchTable Do
		
		TheStructureOfTheSearch = New Structure();
		TheStructureOfTheSearch.Insert("Organization", String.Organization);
		TheStructureOfTheSearch.Insert("RetailFacility", String.CashAccount);
		
		ArrayOfEquipment = GeneratingFiscalChecksServer.ConnectedReceiptPrintingEquipment(TheStructureOfTheSearch);
		For Each Item In ArrayOfEquipment Do
			NewRow = EquipmentTable.Add();
			NewRow.Organization = String.Organization;
			NewRow.CashAccount = String.CashAccount;
			FillPropertyValues(NewRow, Item);
		EndDo;
		
	EndDo;
	
EndProcedure

// Convert a match to a table of values.
// 
// Parameters:
//  ComplianceWithOrders - Map - Compliance With Orders:
// * Key - DocumentRef.SalesOrder -
// * Value - Structure -:
// ** InvoiceStatus - Number -
// ** NoteState - Number -
// 
// Returns:
//  ValueTable - Convert A Match To A Table Of Values:
// * Key - Array - 
// * InvoiceStatus - Number -
// * NoteState - Number -
Function ConvertMatchToTableOfValues(ComplianceWithOrders)
	
	TypesArray = New Array;
	TypesArray.Add(Type("DocumentRef.SalesOrder"));
	TypesArray.Add(Type("DocumentRef.GoodsShipmentToCustomer"));
	TypesArray.Add(Type("DocumentRef.RequestForReturnOfGoodsFromCustomer"));
	TypesArray.Add(Type("DocumentRef.SubcontractOrder2_5"));
	TypesArray.Add(Type("DocumentRef.MaterialProviderOrder2_5"));
	ValueTable = New ValueTable;
	ValueTable.Columns.Add("Key", New TypeDescription(TypesArray));
	ValueTable.Columns.Add("InvoiceStatus", New TypeDescription("Number"));
	ValueTable.Columns.Add("NoteState", New TypeDescription("Number"));
	
	TheOrdersTable = New ValueTable;
	TheOrdersTable.Columns.Add("Key", New TypeDescription(TypesArray));
	TheOrdersTable.Columns.Add("InvoiceStatus", New TypeDescription("Number"));
	TheOrdersTable.Columns.Add("NoteState", New TypeDescription("Number"));
	TheOrdersTable.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	
	For Each KeyAndValue In ComplianceWithOrders Do
		
		Var_Key = KeyAndValue.Key;
		
		If TypeOf(Var_Key) = Type("Structure") Then
			
			SelectionByOrderAndWarehouse = New Structure();
			SelectionByOrderAndWarehouse.Insert("Key", Var_Key.DocumentBasis);
			SelectionByOrderAndWarehouse.Insert("Warehouse", Var_Key.Warehouse);
			
			FoundRows = TheOrdersTable.FindRows(SelectionByOrderAndWarehouse);
			If FoundRows.Count() = 0 Then
				NewRow = TheOrdersTable.Add();
				NewRow.Key = Var_Key.DocumentBasis;
				NewRow.Warehouse = Var_Key.Warehouse;
				NewRow.InvoiceStatus = KeyAndValue.Value.InvoiceStatus;
				NewRow.NoteState = KeyAndValue.Value.NoteState;
			EndIf;
			
		Else
			
			NewRow = ValueTable.Add();
			NewRow.Key = KeyAndValue.Key;
			NewRow.InvoiceStatus = KeyAndValue.Value.InvoiceStatus;
			NewRow.NoteState = KeyAndValue.Value.NoteState;

		EndIf;
		
	EndDo;
	
	TablesByDocuments = New Structure();
	TablesByDocuments.Insert("TableOfOrders", ValueTable);
	TablesByDocuments.Insert("TheOrdersTable", TheOrdersTable);
	
	Return TablesByDocuments;
	
EndFunction

// Convert matching shipments to a table of values.
// 
// Parameters:
//  ComplianceWithOrders - Map - Compliance With Orders:
// * Key - DocumentRef.SalesOrder -
// * Value - Structure -:
// ** InvoiceStatus - Number -
// ** NoteState - Number -
// 
// Returns:
//  ValueTable - Convert A Match To A Table Of Values:
// * Key - Array - 
// * InvoiceStatus - Number -
// * NoteState - Number -
Function ConvertMatchingShipmentsToTableOfValues(ComplianceWithOrders)
	
	TypesArray = New Array;
	TypesArray.Add(Type("DocumentRef.SalesOrder"));
	TypesArray.Add(Type("DocumentRef.RequestForReturnOfGoodsFromCustomer"));
	TypesArray.Add(Type("DocumentRef.GoodsShipmentToCustomer"));
	
	TheOrdersTable = New ValueTable;
	TheOrdersTable.Columns.Add("Key", New TypeDescription(TypesArray));
	TheOrdersTable.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	
	TableOfReturnRequests = New ValueTable;
	TableOfReturnRequests.Columns.Add("Key", New TypeDescription(TypesArray));
	TableOfReturnRequests.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	
	ShipmentTable = New ValueTable;
	ShipmentTable.Columns.Add("Key", New TypeDescription(TypesArray));
	ShipmentTable.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	
	For Each KeyAndValue In ComplianceWithOrders Do
		
		Var_Key = KeyAndValue.Key;
		If TypeOf(Var_Key) = Type("DocumentRef.SalesOrder") Then
			NewRow = TheOrdersTable.Add();
		ElsIf TypeOf(Var_Key) = Type("DocumentRef.RequestForReturnOfGoodsFromCustomer") Then
			NewRow = TableOfReturnRequests.Add();
		Else
			NewRow = ShipmentTable.Add();
		EndIf;
		NewRow.Key = KeyAndValue.Key;
		NewRow.Warehouse = Var_Key.Warehouse;
		
	EndDo;
	
	TablesByDocuments = New Structure();
	TablesByDocuments.Insert("TheOrdersTable", TheOrdersTable);
	TablesByDocuments.Insert("TableOfReturnRequests", TableOfReturnRequests);
	TablesByDocuments.Insert("ShipmentTable", ShipmentTable);
	
	Return TablesByDocuments;
	
EndFunction

// Returns:
// 	Structure - Where:
// * HasErrors - Boolean
// * CashAccount - CatalogRef.CashAccounts
