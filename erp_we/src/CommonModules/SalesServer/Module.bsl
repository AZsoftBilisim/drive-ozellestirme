						|tr = 'Mülkiyet hakkı transferi olmadan sevkiyat'"), ErrorText, ArrayOfDeviations);
			EndIf;
		EndIf;
		
		If Selection.ThereAreErrorsMinimumOrderAmount Then
			
			If Selection.ThisIsConvention Then
				ErrorText = NStr("vi = 'Số tiền đặt hàng tối thiểu không được khác với giá trị trong thỏa thuận chung ""%MinimumOrderAmount% %Currency%""';
								|ru = 'Минимальная сумма заказа не должна отличаться от значения в типовом соглашении ""%MinimumOrderAmount% %Currency%""';
