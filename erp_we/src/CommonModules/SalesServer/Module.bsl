#Region ProceduresAndFunctionsForCalculatingPricesAndDiscountsInSalesDocuments

// Fills in the "Price" detail in the product table part
//
// Parameters:
// 		TabularSection - FormDataCollection, TabularSection - Product table part of the document
// 		SelectedRows - Array - Array of selected rows
// 		FillParameters - Structure - Structure of filling parameters:
// 			* Date 					- Date - Document date (Required)
// 			* Currency 				- CatalogRef.Currencies - Document currency (Required)
// 			* Terms 			- CatalogRef.TermsOfSale - if the parameter is omitted, 
// 									then the "view Price" parameter must be filled in (Required).
// 			* PriceKind 				- CatalogRef.TypesOfPrices - if the parameter is omitted, 
// 									then the "Agreement" parameter must be filled in (Required).
// 			* PopulationFields		- String - A string listing the fields to fill in in the table (Optional)
// 									Default value: "Price" 
// 									Additional fields: "view Prices, delivery Terms, Bids".
// 			* ColumnsByValue		- Structure - Structure to pass as a parameter "column Value" 
// 									to the function "General purpose".Unload Table Of Values" (Optional).
// 			* OtherColumnNames	- Structure - Structure for passing the "new column Names" parameter to the "General Purpose" 
// 									function.Unload Table Of Values" (Optional).
// 		StructureOfActions - Structure - The standard structure of actions with strings 
// 									for calling the "Batch processing of the table part of the server.Process the Strokutch."
// 		CachedValues - Structure - The structure of the cached values.
// 		
// Returns:
//   Boolean - True if the prices are successfully filled.
//
Function FillInPricesByCosts(TabularSection, SelectedRows, FillParameters, StructureOfActions = Undefined, CachedValues = Undefined) Export
	
	PricesAreFilledOut = False;
	
	If FillParameters = Undefined Then
		Raise NStr("vi = 'Chưa chỉ ra tham số điền';
					|ru = 'Параметры заполнения не указаны';
					|en = 'Filling parameters are not specified'; fa = 'Filling parameters are not specified';
					|it = 'Parametri di compilazione non indicati';
					|pl = 'Parametry wypełnienia nie są wskazane';
					|tr = 'Doldurma parametreleri belirtilmedi'");
	EndIf;
	
	// Getting the default parameter structure
	Parameters = New Structure(
		"PopulationFields,  OtherColumnNames",
		"Price", New Structure);
	TMCommonUseClientServer.SupplementStructure(Parameters, FillParameters, True);
	
	// Checking incoming data
	If Not Parameters.Property("Date") 
		Or Not Parameters.Property("Organization") 
		Or Not Parameters.Property("Currency") 
		Or Not Parameters.Property("Warehouse") Then
		
		Raise NStr("vi = 'Trong tham số điền cần chỉ ra ""Ngày"", ""Doanh nghiệp"", ""Kho bãi""';
					|ru = 'В параметрах заполнения должны быть указаны ""Дата"", ""Организация"", ""Склад""';
					|en = 'Specify ""Date"", ""Company"" and ""Warehouse"" in the population parameters'; fa = 'Specify ""Date"", ""Company"" and ""Warehouse"" in the population parameters';
					|it = 'Nei parametri di compilazione devono essere indicati ""Data"", ""Azienda"", ""Magazzino""';
					|pl = 'W ustawieniach wypełnienia muszą być podane ""Data"", ""Firma"", ""Magazyn""';
					|tr = 'Doldurma parametreleri ""Tarih"", ""İş yeri"", ""Ambar"" içermelidir'");
		
	EndIf;
	
	// Getting the upload by the tabular part
	Table = TMCommonUse.ExportValuesTable(
		TabularSection,
		SelectedRows,
		"LineNumber, Products, Characteristic, Purpose",
		Undefined,
		Parameters.OtherColumnNames);
	
	// Receiving a request
	Query = New Query;
	Query.SetParameter("Date", ?(ValueIsFilled(Parameters.Date), Parameters.Date, CurrentSessionDate()));
	Query.SetParameter("Table", Table);
	Query.SetParameter("Organization", Parameters.Organization);
	Query.SetParameter("Currency", Parameters.Currency);
	Query.SetParameter("Warehouse", Parameters.Warehouse);
	Query.SetParameter("BaseCurrency", SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Parameters.Organization));

	Query.Text = Query.Text + GetQueryTextForTemporaryTableOfDebitedItems("TTTableItemsDebited");
	
	Query.Text = Query.Text + GetQueryTextOfTemporaryCostTable("TTCostTable_", "TTTableItemsDebited");
	Query.Text = Query.Text + "
	|SELECT
	|	TTTableItemsDebited.LineNumber AS LineNumber,
	|	&TTCostTablePrice AS Price,
	|	TTCostTable_.PriceOffBalance AS PriceOffBalance
	|FROM
	|	TTTableItemsDebited AS TTTableItemsDebited
	|		LEFT JOIN TTCostTable_ AS TTCostTable_
	|		ON (TTCostTable_.LineNumber = TTTableItemsDebited.LineNumber)";
	
	If FillParameters.Property("EXCLUDINGVAT") 
			And FillParameters.EXCLUDINGVAT = True Then
		Query.Text = StrReplace(Query.Text, "&TTCostTablePrice", "TTCostTable_.PriceWithoutVAT" );
	Else
		Query.Text = StrReplace(Query.Text, "&TTCostTablePrice", "TTCostTable_.Price" );
	EndIf;
	
	QueryResult = Query.Execute();
	If QueryResult.IsEmpty() Then
		Return PricesAreFilledOut;
	EndIf;
	
	RowsToProcess = New Array;
	
	FillingStructure = New Structure(Parameters.PopulationFields);
	Selection = QueryResult.Select();
	While Selection.Next() Do
		FillPropertyValues(FillingStructure, Selection);
		TSRow = TabularSection[Selection.LineNumber - 1];
		FillPropertyValues(TSRow, FillingStructure);
		RowsToProcess.Add(TSRow);
	EndDo;
	
	If StructureOfActions <> Undefined Then
		BatchProcessingOfTablePartServer.ProcessTSStrings(
			RowsToProcess,
			StructureOfActions,
			TabularSection,
			CachedValues);
	EndIf;
	
	Return True;
	
EndFunction

