Procedure AddFormationParameters(GenerationParameters)
	
	GenerationParameters.Insert("UseSaleByMultipleOrders", GetFunctionalOption("UseSaleByMultipleOrders"));
	GenerationParameters.Insert("UseCustomerInvoicesForSeveralOrders", GetFunctionalOption("UseCustomerInvoicesForSeveralOrders"));
	GenerationParameters.Insert("FiscalizationIsAvailable", RetailSalesServerCall.FiscalizationIsAvailable()); 
	GenerationParameters.Insert("UseAdvancedFeaturesOfSalesOrder", GetFunctionalOption("UseAdvancedFeaturesOfSalesOrder")); 
	GenerationParameters.Insert(
		"UseReportToMaterialProviderBySeveralOrders2_5",
		GetFunctionalOption("UseReportToMaterialProviderBySeveralOrders2_5"));
EndProcedure

Procedure SupplementStructureOfOrders(ComplianceWithOrders, GenerationParameters)

	ReferenceArray = New Array;
	TableOrderWarehouse = New ValueTable();
	TableOrderWarehouse.Columns.Add("OrderDocument", New TypeDescription("DocumentRef.SalesOrder"));
	TableOrderWarehouse.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	TextOfInternalTable = "";
	
	For Each KeyAndValue In ComplianceWithOrders Do
		Var_Key = KeyAndValue.Key;
		If TypeOf(Var_Key) = Type("Structure") Then
			NewRow = TableOrderWarehouse.Add();
			NewRow.OrderDocument = Var_Key.DocumentBasis;
			NewRow.Warehouse = Var_Key.Warehouse;
		Else
			ReferenceArray.Add(KeyAndValue.Key);
		EndIf;
	EndDo;

	QueryTexts = New Array;
	
	If AccessRight("Read", Metadata.Documents.SalesOrder) Then
		QueryTexts.Add(
			"SELECT
			|	SalesOrder.Ref AS Ref,
			|	SalesOrder.Posted AS Posted,
			|	SalesOrder.CashAccount AS CashAccount,
			|	SalesOrder.Organization AS Organization,
			|	SalesOrder.Warehouse AS Warehouse
			|FROM
			|	Document.SalesOrder AS SalesOrder
			|WHERE
			|	SalesOrder.Ref IN(&DocumentsList)
			|");
		If TableOrderWarehouse.Count() > 0 Then
			TextOfInternalTable = "SELECT DISTINCT
				|	TableOrderWarehouse.OrderDocument  AS OrderDocument,
				|	TableOrderWarehouse.Warehouse   AS Warehouse
				|INTO TableOrderWarehouse
				|FROM
				|	&TableOrderWarehouse AS TableOrderWarehouse
				|;";
			QueryTexts.Add(
				"SELECT
				|	SalesOrder.Ref AS Ref,
				|	SalesOrder.Posted AS Posted,
				|	SalesOrder.CashAccount AS CashAccount,
				|	SalesOrder.Organization AS Organization,
				|	TableOrderWarehouse.Warehouse  AS Warehouse
				|FROM
				|	Document.SalesOrder AS SalesOrder
				|	INNER JOIN TableOrderWarehouse AS TableOrderWarehouse
				|		ON TableOrderWarehouse.OrderDocument = SalesOrder.Ref
				|");
		EndIf;
	
	EndIf;
	
	If AccessRight("Read", Metadata.Documents.RequestForReturnOfGoodsFromCustomer) Then
		QueryTexts.Add(
			"SELECT
			|	SalesOrder.Ref AS Ref,
			|	SalesOrder.Posted AS Posted,
			|	SalesOrder.CashAccount AS CashAccount,
			|	SalesOrder.Organization AS Organization,
			|	SalesOrder.Warehouse AS Warehouse
			|FROM
			|	Document.RequestForReturnOfGoodsFromCustomer AS SalesOrder
			|WHERE
			|	SalesOrder.Ref IN(&DocumentsList)
			|");
	EndIf;
	If AccessRight("Read", Metadata.Documents.SubcontractOrder2_5) Then
		QueryTexts.Add(
			"SELECT
			|	SalesOrder.Ref AS Ref,
			|	SalesOrder.Posted AS Posted,
			|	SalesOrder.CashAccount AS CashAccount,
			|	SalesOrder.Organization AS Organization,
			|	SalesOrder.MaterialsWarehouse AS Warehouse
			|FROM
			|	Document.SubcontractOrder2_5 AS SalesOrder
			|WHERE
			|	SalesOrder.Ref IN(&DocumentsList)
			|");
	EndIf;
	If AccessRight("Read", Metadata.Documents.MaterialProviderOrder2_5) Then
		QueryTexts.Add(
			"SELECT
			|	MaterialProviderOrder2_5.Ref      AS Ref,
			|	MaterialProviderOrder2_5.Posted    AS Posted,
			|	MaterialProviderOrder2_5.CashAccount       AS CashAccount,
			|	MaterialProviderOrder2_5.Organization AS Organization,
			|	MaterialProviderOrder2_5.Warehouse       AS Warehouse
			|FROM
			|	Document.MaterialProviderOrder2_5 AS MaterialProviderOrder2_5
			|WHERE
			|	MaterialProviderOrder2_5.Ref IN(&DocumentsList)
			|");
	EndIf;
	TableDocuments = Undefined;
	If Not QueryTexts.Count() = 0 Then
		
		Query = New Query;
		
		Query.Text = TextOfInternalTable + StrConcat(QueryTexts, TMCommonUse.QuerySeparatorInJoin());
		RequestSchemes.SetSelectionOfAllowedRecords(Query, True);
		
		Query.SetParameter("DocumentsList", ReferenceArray);
		Query.SetParameter("TableOrderWarehouse", TableOrderWarehouse);
		
		TableDocuments = Query.Execute().Unload();
		
	EndIf;
	
	For Each KeyAndValue In ComplianceWithOrders Do
		
		KeyAndValue.Value.Insert("Posted",		False);
		KeyAndValue.Value.Insert("CashAccount",		Catalogs.CashAccounts.EmptyRef());
		KeyAndValue.Value.Insert("Organization",	Catalogs.Companies.EmptyRef());
		KeyAndValue.Value.Insert("Warehouse", 		Catalogs.Warehouses.EmptyRef());
		
		If Not TableDocuments = Undefined Then
			
			Var_Key = KeyAndValue.Key;
			If TypeOf(Var_Key) = Type("Structure") Then
				SelectionByOrderAndWarehouse = New Structure();
				SelectionByOrderAndWarehouse.Insert("Ref", Var_Key.DocumentBasis);
				SelectionByOrderAndWarehouse.Insert("Warehouse", Var_Key.Warehouse);
				
				ArrayOfFoundStrings = TableDocuments.FindRows(SelectionByOrderAndWarehouse);
				FoundRow = ?(ArrayOfFoundStrings.Count() > 0, ArrayOfFoundStrings[0], Undefined );
			Else
				FoundRow = TableDocuments.Find(Var_Key, "Ref");
			EndIf;
			
			If FoundRow = Undefined Then
				Continue;
			EndIf;
			
			KeyAndValue.Value.Posted		= FoundRow.Posted;
			KeyAndValue.Value.CashAccount		= FoundRow.CashAccount;
			KeyAndValue.Value.Organization	= FoundRow.Organization;
			KeyAndValue.Value.Warehouse		= FoundRow.Warehouse;
		
		EndIf;
	
	EndDo;
	
	FiscalizationIsRequired = False;
	If GenerationParameters.FiscalizationIsAvailable Then
		For Each KeyAndValue In ComplianceWithOrders Do
			
			FiscalizationByWarehouseIsAllowed =
				WarehousesServer.FiscalizationByWarehouseIsAllowed(
					KeyAndValue.Value.Warehouse,
					GenerationParameters.IssueAFiscalReceipt);
			
			KeyAndValue.Value.Insert("Fiscalize",  FiscalizationByWarehouseIsAllowed);
			FiscalizationIsRequired = FiscalizationByWarehouseIsAllowed Or FiscalizationIsRequired;
			
		EndDo;
	EndIf;
	
	GenerationParameters.Insert("FiscalizationIsRequired", FiscalizationIsRequired);
	
EndProcedure

// Complements the data structure according to orders and the transmitted formation parameters.
// 
// Parameters:
// 		ComplianceWithOrders - See SalesClient.InitializeOrders
// 		GenerationParameters - See SalesServer.NewParametersForDesignOfSetOfDocuments
// 	
Procedure ToSupplementStructureOfOrdersAndFormationParameters(ComplianceWithOrders, GenerationParameters) Export

	If Not (GenerationParameters.Property("ParametersUpdated") And GenerationParameters.ParametersUpdated = True) Then 
		AddFormationParameters(GenerationParameters);
		SupplementStructureOfOrders(ComplianceWithOrders, GenerationParameters);
		GenerationParameters.Insert("ParametersUpdated", True);
	EndIf;
	
EndProcedure

// Starts a background task for generating documents based on the passed structure
// 
// Parameters:
// 	ParametersStructure - See IssueInvoiceOnServer
// 	GenerationParameters - See NewParametersForDesignOfSetOfDocuments
// 	CurPackageNumber - Number - Number of the package whose documents need to be generated
// 	
// Returns:
// 	Structure - Where:
// * Status - String
// * JobID - UUID
// * ResultAddress - String
// * AdditionalResultAddress - String
// * BriefErrorDescription - String
// * DetailErrorDescription - String
// * Messages - FixedArray
//
Function IssueNumberOfInvoicesAccordingToTablesCall(ParametersStructure, GenerationParameters, CurPackageNumber = 0) Export
	
	JobDescription = NStr("vi = 'Lập chứng từ bán hàng';
							|ru = 'Оформление документов продажи';
							|en = 'Register sales documents'; fa = 'Register sales documents';
							|it = 'La formalizzazione dei documenti di vendita';
							|pl = 'Rejestracja dokumentów sprzedaży';
							|tr = 'Satış belgelerinin düzenlenmesi'");
	MethodToExecute = "SalesServer.RegisterInvoices";
	
	ArrangeShipment = False;
	If GenerationParameters.Property("ArrangeShipment") Then
		ArrangeShipment = GenerationParameters.ArrangeShipment;
	EndIf;
		
	If ArrangeShipment Then
		JobDescription = NStr("vi = 'Lập chứng từ giao hàng';
								|ru = 'Оформление документов отгрузки товаров';
								|en = 'Register goods shipping documents'; fa = 'Register goods shipping documents';
								|it = 'Register goods shipping documents';
								|pl = 'Register goods shipping documents';
								|tr = 'Ürün sevkiyat belgelerinin oluşturulması'");
		MethodToExecute = "SalesServer.IssueShipmentDocuments";
	EndIf;
	
	ExecutionParameters = TimeConsumingOperations.BackgroundExecutionParameters(GenerationParameters.UUID);
	ExecutionParameters.BackgroundJobDescription = JobDescription;
	
	StorageAddress = ParametersStructure.AddressDocumentsByInvoiceType;
	DocumentsByTypesOfInvoices = GetFromTempStorage(StorageAddress);
	
	ParametersStructure.Insert("GenerationParameters", GenerationParameters);
	ParametersStructure.Insert("CurPackageNumber", CurPackageNumber);
	
	// Starting a background job is complicated by the fact that between sessions (between the main thread and the background job)
	// it is not possible to transfer the address to the storage, so we pass the original table of values and make sure
	// that it does not get back to the client.
	
	StructureOfParametersToPassToBackground = Common.CopyRecursive(ParametersStructure);
	StructureOfParametersToPassToBackground.Insert("DocumentsByTypesOfInvoices", DocumentsByTypesOfInvoices);
	
	Result = TimeConsumingOperations.ExecuteInBackground( // directly launching the task
		MethodToExecute,
		StructureOfParametersToPassToBackground,
		ExecutionParameters);
		
	// We supplement the structure with parameters filled in the background.
	CommonClientServer.SupplementStructure(
		ParametersStructure,
		StructureOfParametersToPassToBackground,
		True);
	ParametersStructure.Delete("DocumentsByTypesOfInvoices");
	
	Return Result;
	
EndFunction

Procedure CreateInvoicesAccordingToTables(DocumentGenerationParameters)
	
	DocumentsByTypesOfInvoices 							= DocumentGenerationParameters.DocumentsByTypesOfInvoices;
	GenerationParameters 								= DocumentGenerationParameters.GenerationParameters;
	CurPackageNumber									= DocumentGenerationParameters.CurPackageNumber;
	
	UseSaleByMultipleOrders 			= GenerationParameters.UseSaleByMultipleOrders;
	UseCustomerInvoicesForSeveralOrders = GenerationParameters.UseCustomerInvoicesForSeveralOrders;
	
	DocumentGenerationParameters.Insert("FormName", GenerationParameters.NameOfFormCreatedDocuments);
	
	FormParameters = New Structure;
	CreatedDocuments = New Array;
	
	TheStructureOfTheSearch = StructureOfMeaningfulProps();
	
	For Each Table In DocumentsByTypesOfInvoices Do
		
		FirstRow = Table[0];
		
		If Not CurPackageNumber = Undefined And Not FirstRow.PackageNumber = CurPackageNumber Then
			Continue;
		EndIf;
		
		If FirstRow.InvoiceStatus > 0 Then
			
			ThereIsVariantOfRegistrationOfSales = Table.Columns.Find("SaleRegistrationOption") <> Undefined;
			
			ReferencesArrray = Table.UnloadColumn("Ref");
			BasisParameters = New Structure();
			FillPropertyValues(TheStructureOfTheSearch, FirstRow);
			If ThereIsVariantOfRegistrationOfSales
				And (FirstRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice
					Or FirstRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer)
				Or FirstRow.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
			Then
				BasisParameters.Insert("OriginWarehouse", FirstRow.Warehouse);
				BasisParameters.Insert("SaleRegistrationOption", FirstRow.SaleRegistrationOption);
	
				DesignParameters = New Structure("ByOrders, ByNotes", Not GenerationParameters.ByNotes, GenerationParameters.ByNotes);
				If GenerationParameters.Property("CheckWarehouses") Then
					DesignParameters.Insert("CheckWarehouses", GenerationParameters.CheckWarehouses);
				EndIf;
				BasisParameters.Insert("DesignParameters", DesignParameters);
			EndIf;
			
			If ThereIsVariantOfRegistrationOfSales
				And (
				((FirstRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice
						Or FirstRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer)
					And UseSaleByMultipleOrders)
				Or (FirstRow.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoiceServices
					And UseCustomerInvoicesForSeveralOrders))
				Or (FirstRow.BusinessOperation = Enums.BusinessTransactions.ReturnOfGoodsFromCustomer
					Or FirstRow.BusinessOperation = Enums.BusinessTransactions.ReturnFromCommissionAgent
					Or FirstRow.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
					Or FirstRow.BusinessOperation = Enums.BusinessTransactions.ReturnFromCustodian) Then
				
				DetailsOfOrder = GetOrderDetails(ReferencesArrray);
				HeaderAttributes = New Structure();
				TMCommonUseClientServer.SupplementStructure(HeaderAttributes, TheStructureOfTheSearch, True);
				TMCommonUseClientServer.SupplementStructure(HeaderAttributes, DetailsOfOrder, True);
				
				BasisParameters.Insert("HeaderAttributes",    HeaderAttributes);
				BasisParameters.Insert("DocumentBasis", ReferencesArrray);
				
				BasisParameters.Insert("AnArrayOfOrders",     ReferencesArrray);
				BasisParameters.Insert("FillByWarehouseDocument", GenerationParameters.ByNotes);
				
				CreateSalesDocument_(TheStructureOfTheSearch, BasisParameters, CreatedDocuments, GenerationParameters);
				
			Else
				
				For Each CurItem In ReferencesArrray Do
					BasisParameters.Insert("DocumentBasis", CurItem);
					CreateSalesDocument_(TheStructureOfTheSearch, BasisParameters, CreatedDocuments, GenerationParameters);
				EndDo;
				
			EndIf;
		EndIf;
	EndDo;
	ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
	
	FormParameters.Insert("CreatedDocuments", CreatedDocuments);
	
	//Parameters of the "General form.The form of the created documents"
	FormParameters.Insert("VisibleColumns");
	FormParameters.Insert("UpdateEvents");
	
	GenerationParameters.Property("VisibleColumns",	FormParameters.VisibleColumns);
	GenerationParameters.Property("UpdateEvents", FormParameters.UpdateEvents);
	
	DocumentGenerationParameters.Insert("Parameters", FormParameters);
	DocumentGenerationParameters.Delete("DocumentsByTypesOfInvoices");
	
	If GenerationParameters.DoNotOpenFormOfCreatedDocument Then
		DocumentGenerationParameters.Insert("DocumentPrintingMode", True);
	EndIf;
	
	Messages = GetUserMessages(True);
	For Each Message In Messages Do
		AddUserError(DocumentGenerationParameters.ErrorList, 
			Message.DataKey, String(Message.DataKey) + ": " + Message.Text);
	EndDo;
	
	Owner = Users.AuthorizedUser();
	SetPrivilegedMode(True);
	ProtectedData = Common.ReadDataFromSecureStorage(Owner, "FormCreatedSalesDocuments");
	If Not ProtectedData = Undefined Then
		For Each Item In ProtectedData.Parameters.CreatedDocuments Do
			CreatedDocuments.Add(Item);
		EndDo;
	EndIf;
	Common.WriteDataToSecureStorage(Owner, DocumentGenerationParameters, "FormCreatedSalesDocuments");
	SetPrivilegedMode(False);
	
EndProcedure

Procedure RegisterInvoices(Parameters, ResultAddress) Export
	
	CreateInvoicesAccordingToTables(Parameters);
	PutToTempStorage(Parameters, ResultAddress);
	
EndProcedure

Procedure ToIssueShipmentDocumentsAccordingToTables(DocumentGenerationParameters)
	
	DocumentsByTypesOfInvoices 							= DocumentGenerationParameters.DocumentsByTypesOfInvoices;
	GenerationParameters 								= DocumentGenerationParameters.GenerationParameters;
	CurPackageNumber									= DocumentGenerationParameters.CurPackageNumber;
	
	UseSaleByMultipleOrders 			= GenerationParameters.UseSaleByMultipleOrders;
	UseCustomerInvoicesForSeveralOrders = GenerationParameters.UseCustomerInvoicesForSeveralOrders;
	
	DocumentGenerationParameters.Insert("FormName", GenerationParameters.NameOfFormCreatedDocuments);
	
	FormParameters = New Structure;
	CreatedDocuments = New Array;
	
	TheStructureOfTheSearch = StructureOfMeaningfulProps();
	TheStructureOfTheSearch.Insert("ThisIsOrderAsInvoice", False);
	
	For Each Table In DocumentsByTypesOfInvoices Do
		
		FirstRow = Table[0];
		
		If Not CurPackageNumber = Undefined And Not FirstRow.PackageNumber = CurPackageNumber Then
			Continue;
		EndIf;
		
		If FirstRow.InvoiceStatus > 0 Then
			
			ThereIsVariantOfRegistrationOfSales = Table.Columns.Find("SaleRegistrationOption") <> Undefined;
			
			ReferencesArrray = Table.UnloadColumn("Ref");
			BasisParameters = New Structure();
			FillPropertyValues(TheStructureOfTheSearch, FirstRow);
			If ThereIsVariantOfRegistrationOfSales Then
				BasisParameters.Insert("OriginWarehouse", FirstRow.Warehouse);
				BasisParameters.Insert("SaleRegistrationOption", FirstRow.SaleRegistrationOption);
	
				DesignParameters = New Structure("ByOrders, ByNotes", Not GenerationParameters.ByNotes, GenerationParameters.ByNotes);
				If GenerationParameters.Property("CheckWarehouses") Then
					DesignParameters.Insert("CheckWarehouses", GenerationParameters.CheckWarehouses);
				EndIf;
				BasisParameters.Insert("DesignParameters", DesignParameters);
				
				DetailsOfOrder = GetOrderDetails(ReferencesArrray);
				HeaderAttributes = New Structure();
				TMCommonUseClientServer.SupplementStructure(HeaderAttributes, DetailsOfOrder, True);
				TMCommonUseClientServer.SupplementStructure(HeaderAttributes, TheStructureOfTheSearch, True);
				
				BasisParameters.Insert("HeaderAttributes",    HeaderAttributes);
				BasisParameters.Insert("FillByWarehouseDocument", GenerationParameters.ByNotes);
			EndIf;
			
			CustomerOrdersOnly = True;
			For Each CurItem In ReferencesArrray Do
				If Not TypeOf(CurItem) = Type("DocumentRef.SalesOrder") Then
					CustomerOrdersOnly = False;
					Break;
				EndIf;
			EndDo;
			
			If ThereIsVariantOfRegistrationOfSales
				And (	UseSaleByMultipleOrders
					Or (CustomerOrdersOnly And Not GenerationParameters.NewDocumentName = "CustomerInvoice")) Then 

				BasisParameters.Insert("DocumentBasis", ReferencesArrray);
				BasisParameters.Insert("AnArrayOfOrders",     ReferencesArrray);
				
				CreateSalesDocument_(TheStructureOfTheSearch, BasisParameters, CreatedDocuments, GenerationParameters);
				
			Else
				
				For Each CurItem In ReferencesArrray Do
					BasisParameters.Insert("DocumentBasis", CommonClientServer.ValueInArray(CurItem));
					CreateSalesDocument_(TheStructureOfTheSearch, BasisParameters, CreatedDocuments, GenerationParameters);
				EndDo;
				
			EndIf;
		EndIf;
	EndDo;
	ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
	
	FormParameters.Insert("CreatedDocuments", CreatedDocuments);
	
	//Parameters of the "General form.The form of the created documents"
	FormParameters.Insert("VisibleColumns");
	FormParameters.Insert("UpdateEvents");
	
	GenerationParameters.Property("VisibleColumns",	FormParameters.VisibleColumns);
	GenerationParameters.Property("UpdateEvents", FormParameters.UpdateEvents);
	
	DocumentGenerationParameters.Insert("Parameters", FormParameters);
	DocumentGenerationParameters.Delete("DocumentsByTypesOfInvoices");
	
	If GenerationParameters.DoNotOpenFormOfCreatedDocument Then
		DocumentGenerationParameters.Insert("DocumentPrintingMode", True);
	EndIf;
	
	Messages = GetUserMessages(True);
	For Each Message In Messages Do
		AddUserError(DocumentGenerationParameters.ErrorList, 
			Message.DataKey, String(Message.DataKey) + ": " + Message.Text);
	EndDo;
	
	Owner = Users.AuthorizedUser();
	SetPrivilegedMode(True);
	ProtectedData = Common.ReadDataFromSecureStorage(Owner, "FormCreatedSalesDocuments");
	If Not ProtectedData = Undefined Then
		For Each Item In ProtectedData.Parameters.CreatedDocuments Do
			CreatedDocuments.Add(Item);
		EndDo;
	EndIf;
	Common.WriteDataToSecureStorage(Owner, DocumentGenerationParameters, "FormCreatedSalesDocuments");
	SetPrivilegedMode(False);
	
EndProcedure

Procedure IssueShipmentDocuments(Parameters, ResultAddress) Export
	
	ToIssueShipmentDocumentsAccordingToTables(Parameters);
	PutToTempStorage(Parameters, ResultAddress);
	
EndProcedure

// Divide orders by full invoice names.
// 
// Parameters:
//  TableOfOrders - ValueTable- TableOfOrders:
//		* Key - Array
//		* InvoiceStatus - Number -
//		* NoteState - Number -
//  TableOfOrdersByWarehouse - ValueTable - TableOfOrdersByWarehouse:
//		* Key - Array
//		* Warehouse - CatalogRef.Warehouses -
//		* InvoiceStatus - Number -
//		* NoteState - Number -
//  GenerationParameters - Structure - formation parameters:
//		* DoNotOpenFormOfCreatedDocument - Boolean -
//		* CreateTaxInvoice - Boolean -
//		* IssueAFiscalReceipt - Boolean -
//		* CreateCashAccountReceiptNote - Boolean -
//		* CreateSalesDocument - Boolean -
//		* PrintTheTransferOfGoodsToBailee - Boolean -
//		* PrintCashAccountReceiptNote - Boolean -
//		* PrintCustomerInvoice - Boolean -
//		* PrintCustomerInvoiceWorksAndServices - Boolean -
//		* TheDesignSettingsAreSaved - Boolean -
//		* NoteState - String -
//		* InvoiceStatus - String -
//		* Warehouse - CatalogRef.Warehouses -
//		* Organization - CatalogRef.Companies -
//  ErrorList- Array - List of errors
//  NumberOfPackages_ - Number - Number of packages
//  ArrangeShipment - Boolean - The sign of the shipment of goods
// 
// Returns:
//  Array - Split orders by full invoice names
Function SplitOrdersByFullInvoiceNames(TableOfOrders, TableOfOrdersByWarehouse, GenerationParameters,
												ErrorList, NumberOfPackages_, ArrangeShipment = False)
	
	CurrentKeys = StructureOfMeaningfulProps();
	
	SplitTableTemplate = SplitTableTemplate_();
	
	Query = New Query;
	Query.Text = RequestTextForSignificantOrderDetails();
	
	Query.SetParameter("ReferencesArrray",                     TableOfOrders.UnloadColumn("Key"));
	Query.SetParameter("UseWarehouseSelection",        ValueIsFilled(GenerationParameters.Warehouse));
	Query.SetParameter("Warehouse",                            GenerationParameters.Warehouse);
	Query.SetParameter("ToUseTermsOfSales", GetFunctionalOption("ToUseTermsOfSales"));
	Query.SetParameter("ByNotes",                        GenerationParameters.ByNotes);
	Query.SetParameter("ArrangeShipment",                 ArrangeShipment);
	Query.SetParameter("StateTable",                 TableOfOrders);
	Query.SetParameter("UseAdvancedFeaturesOfSalesOrder",
			GenerationParameters.UseAdvancedFeaturesOfSalesOrder);
	Query.SetParameter("TheOrdersTable", TableOfOrdersByWarehouse);
	
	UseCustomerContracts = GetFunctionalOption("UseCustomerContracts");
	Query.SetParameter("UseCustomerContracts", UseCustomerContracts);
	
	ArrayOfDesignOptions = New Array();
	ArrayOfDesignOptions.Add(Enums.SalesRegistrationOptions.CustomerInvoice);
	If ArrangeShipment = False Then
		ArrayOfDesignOptions.Add(Enums.SalesRegistrationOptions.DeedOfTransfer);
	EndIf;
	Query.SetParameter("ArrayOfDesignOptions", ArrayOfDesignOptions);
	
	QueryResult = Query.Execute();
	
	ArrayOfTables = New Array();
	If QueryResult.IsEmpty() Then
		Return ArrayOfTables;
	EndIf;
	
	Upload0 = QueryResult.Unload(); // See SplitTableTemplate_
	
	SplitTable = Undefined;
	BatchMode = TableOfOrders.Count() > 1;
	PreviousErroneousLink = Undefined;
	
	For Each String In Upload0 Do
		
		ErrorText = "";
		AbortStringProcessing = False;
		
		If BatchMode
			And (TypeOf(String.Ref)= Type("DocumentRef.CustomerInvoice")
				Or TypeOf(String.Ref)= Type("DocumentRef.GoodsShipmentFromStorage")
				  And String.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
				Or TypeOf(String.Ref)= Type("DocumentRef.TransferOfGoodsToBailee")) Then
			
			ErrorText = NStr("vi = 'Không thể điền lại hóa đơn %1 cùng với các lệnh khác. Hãy chọn từng lệnh.';
							|ru = 'Невозможно перезаполнить накладную %1 вместе с другими распоряжениями. Выберите распоряжение отдельно.';
							|en = 'Cannot refill the %1 invoice with other references. Select a reference separately.'; fa = 'Cannot refill the %1 invoice with other references. Select a reference separately.';
							|it = 'Non è possibile ricompilare la bolla %1 insieme alle altre disposizioni. Selezionare una disposizione separata.';
							|pl = 'Nie można ponownie wypełnić fakturę %1 wraz z innymi zamówieniami. Wybierz zamówienie oddzielnie.';
							|tr = '%1 faturası diğer siparişlerle birlikte doldurulamıyor. Ayrı bir sipariş seç.'");
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref);
			
			AbortStringProcessing = True;
			
		ElsIf GenerationParameters.ByNotes Then
			
			If String.NoteState = 0 Then
				
				ErrorText = NStr("vi = 'Đối với lệnh %1 không thể điền lại hóa đơn giao hàng, bởi vì có nhiều lệnh tương ứng với hóa đơn.';
								|ru = 'Для распоряжения %1 невозможно перезаполнить накладную по отгрузке, т.к. ордера соответствуют накладным.';
								|en = 'Cannot refill a shipment document for the %1 reference as the notes correspond to the shipment documents.'; fa = 'Cannot refill a shipment document for the %1 reference as the notes correspond to the shipment documents.';
								|it = 'Per la disposizione %1 non è possibile ricompilare la bolla di spedizione, poiché i mandati corrispondono alle bolle.';
								|pl = 'Dla zamówienia %1 nie jest możliwa ponowna rejestracja faktury po wysyłce, ponieważ zlecenia pokrywają się z fakturami.';
								|tr = '%1 siparişi için sevkiyat faturasını yeniden doldurmak mümkün değil çünkü siparişler faturalara uygun.'");
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref);
				
				AbortStringProcessing = True;
				
			ElsIf String.NoteState = 4 Then
				
				ErrorText = NStr("vi = 'Không thể lập hóa đơn giao hàng đối với lệnh %1, bởi vì kho ""%2"" không sử dụng sơ đồ hai pha.';
								|ru = 'Для распоряжения %1 невозможно оформить накладную по отгрузке, т.к. склад ""%2"" не использует ордерную схему.';
								|en = 'Cannot register a shipment document for the ""%1"" reference, as the ""%2"" warehouse does not use the warehouse management.'; fa = 'Cannot register a shipment document for the ""%1"" reference, as the ""%2"" warehouse does not use the warehouse management.';
								|it = 'Cannot register a shipment document for the ""%1"" reference, as the ""%2"" warehouse does not use the warehouse management.';
								|pl = 'Cannot register a shipment document for the ""%1"" reference, as the ""%2"" warehouse does not use the warehouse management.';
								|tr = '%1 siparişi için sevkiyat faturası düzenlemek mümkün değil çünkü ambar ""%2"", emir şeması kullanmıyor.'");
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref, String.Warehouse);
				
				AbortStringProcessing = True;
				
			EndIf;
			
		Else // execution by orders
			
			If TypeOf(String.Ref)= Type("DocumentRef.CustomerInvoice")
					Or TypeOf(String.Ref)= Type("DocumentRef.GoodsShipmentFromStorage")
					  And String.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
					Or TypeOf(String.Ref)= Type("DocumentRef.TransferOfGoodsToBailee")
				Then
				
				ErrorText = NStr("vi = 'Lệnh %1 là hóa đơn. Đối với hóa đơn, không thể lập đơn hàng.';
								|ru = 'Распоряжение %1 является накладной. Для накладных оформление по заказам не доступно.';
								|en = 'Reference %1 is an invoice. Registration against orders is not available for invoices.'; fa = 'Reference %1 is an invoice. Registration against orders is not available for invoices.';
								|it = 'La disposizione %1 è una bolla. Per le bolle non è disponibile la formalizzazione per ordini.';
								|pl = 'Zamówienie %1 jest fakturą. Dla faktur rejestracja po zamówieniach nie jest dostępna.';
								|tr = 'Sipariş %1 bir faturadır. Faturalar için sipariş düzenleme mevcut değildir.'");
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref);
				AbortStringProcessing = True;
				
			ElsIf ArrangeShipment = True And String.TransferOfTitleToGoods = False Then
				
				ErrorText = NStr("vi = 'Không thể giao hàng đối với lệnh %1. Đã chọn thỏa thuận, đồng thời tắt tính năng giao hàng mà chưa chuyển giao quyền sở hữu.';
								|ru = 'Для распоряжения %1 невозможна отгрузка товаров. Выбрано соглашение с отключенной возможностью отгрузки без перехода права собственности.';
								|en = 'Cannot ship goods for the ""%1"" reference. An agreement with disabled shipment without transfer of title to goods is selected.'; fa = 'Cannot ship goods for the ""%1"" reference. An agreement with disabled shipment without transfer of title to goods is selected.';
								|it = 'Cannot ship goods for the ""%1"" reference. An agreement with disabled shipment without transfer of title to goods is selected.';
								|pl = 'Cannot ship goods for the ""%1"" reference. An agreement with disabled shipment without transfer of title to goods is selected.';
								|tr = '%1 siparişi için ürün sevkiyatı yapılamamaktadır. Mülkiyet hakkı devri devre dışı bırakılmaksızın sevkiyat seçeneği olan bir anlaşma seçilidir.'");
				If Not UseCustomerContracts Then
					ErrorText = NStr("vi = 'Không thể giao hàng đối với lệnh %1. Chưa bật tùy chọn sử dụng hợp đồng với khách hàng.';
									|ru = 'Для распоряжения %1 невозможна отгрузка товаров. Не включена опция использования договоров с клиентами.';
									|en = 'Cannot ship goods under the %1 reference. Contracts with customers are not enabled.'; fa = 'Cannot ship goods under the %1 reference. Contracts with customers are not enabled.';
									|it = 'Cannot ship goods under the %1 reference. Contracts with customers are not enabled.';
									|pl = 'Cannot ship goods under the %1 reference. Contracts with customers are not enabled.';
									|tr = '%1 siparişi için ürün sevkiyatı yapılamaz. Müşteri sözleşmelerinin kullanılması seçeneği etkinleştirilmedi.'");
				EndIf;
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref);
				AbortStringProcessing = True;
				
			ElsIf String.InvoiceStatus = 0 Then
				
				ErrorText = NStr("vi = 'Một hóa đơn đã được tạo cho lệnh %1';
								|ru = 'Для распоряжения %1 уже создана накладная';
								|en = 'An invoice has already been created for the %1 reference'; fa = 'An invoice has already been created for the %1 reference';
								|it = 'Per la disposizione %1 è già creata una bolla';
								|pl = 'Dla zamówienia %1 została już utworzona faktura';
								|tr = '%1 emri için irsaliye artık oluşturuldu.'");
				If ArrangeShipment = True Then
					ErrorText = NStr("vi = 'Đối với lệnh %1 đã tạo chứng từ giao hàng';
									|ru = 'Для распоряжения %1 уже создана отгрузка';
									|en = 'A shipment is already created for the ""%1"" reference'; fa = 'A shipment is already created for the ""%1"" reference';
									|it = 'A shipment is already created for the ""%1"" reference';
									|pl = 'A shipment is already created for the ""%1"" reference';
									|tr = '%1 siparişi için hali hazırda sevkiyat oluşturulmuş'");
				EndIf;
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, String.Ref);
				AbortStringProcessing = True;
				
			EndIf;
			
		EndIf;
		
		If Not IsBlankString(ErrorText)
			And PreviousErroneousLink <> String.Ref Then
			AddUserError(ErrorList, "Object.ListReferencesForRegistration",ErrorText);
			PreviousErroneousLink = String.Ref;
			ErrorText = "";
		EndIf;
		
		If AbortStringProcessing Then
			Continue;
		EndIf;
		
		// Creating a new table in the following cases:
		// 1. The table has never been created yet
		// 2. It is forbidden to group several orders into one invoice
		// 3. The order is an invoice or the key fields are different (for example,
		//	orders with different warehouses cannot be grouped into one invoice)
		If SplitTable = Undefined 
			Or ((Not GenerationParameters.UseSaleByMultipleOrders
				And String.BusinessOperation <> Enums.BusinessTransactions.TransferToMaterialProvider2_5
				And (String.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoice
				Or String.SaleRegistrationOption = Enums.SalesRegistrationOptions.DeedOfTransfer)))
			Or (Not GenerationParameters.UseCustomerInvoicesForSeveralOrders
				And String.BusinessOperation <> Enums.BusinessTransactions.TransferToMaterialProvider2_5
				And String.SaleRegistrationOption = Enums.SalesRegistrationOptions.CustomerInvoiceServices)
			Or Not GenerationParameters.UseReportToMaterialProviderBySeveralOrders2_5
			  And String.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
			Or String.Partner <> CurrentKeys.Partner
			Or String.Counterparty <> CurrentKeys.Counterparty
			Or String.Contract <> CurrentKeys.Contract
			Or String.Organization <> CurrentKeys.Organization
			Or String.Terms <> CurrentKeys.Terms
			Or String.SalesOpportunity <> CurrentKeys.SalesOpportunity
			Or String.Warehouse <> CurrentKeys.Warehouse
			Or String.Department <> CurrentKeys.Department
			Or String.OriginWarehouse <> CurrentKeys.OriginWarehouse
			Or String.BusinessOperation <> CurrentKeys.BusinessOperation
			Or String.ARAPCurrency <> CurrentKeys.ARAPCurrency
			Or String.VATTaxation <> CurrentKeys.VATTaxation
			Or String.PriceIncludesVAT <> CurrentKeys.PriceIncludesVAT
			Or String.ItIsForbiddenToSelectWarehouseGroup <> CurrentKeys.ItIsForbiddenToSelectWarehouseGroup
			Or String.SaleRegistrationOption <> CurrentKeys.SaleRegistrationOption
			Or String.DeliveryMethod <> CurrentKeys.DeliveryMethod
			Or String.CarrierPartner <> CurrentKeys.CarrierPartner
			Or String.DeliveryAddress <> CurrentKeys.DeliveryAddress
			Or String.DeliveryAddressOfCarrier <> CurrentKeys.DeliveryAddressOfCarrier
			Or String.ToReturnReusablePackage <> CurrentKeys.ToReturnReusablePackage
			Or String.ReusablePackageReturnCycleLength <> CurrentKeys.ReusablePackageReturnCycleLength
			Or String.PackageDepositIsRequired <> CurrentKeys.PackageDepositIsRequired
			Or String.ScheduleOfPackageReturn <> CurrentKeys.ScheduleOfPackageReturn
			Or String.CalculatePackageReturnDateAccordingToCalendar <> CurrentKeys.CalculatePackageReturnDateAccordingToCalendar
			Or String.LineOfBusiness <> CurrentKeys.LineOfBusiness 
			Or String.ARAPObjectSettings <> CurrentKeys.ARAPObjectSettings Then
			
			SplitTable = SplitTableTemplate.Copy();
			ArrayOfTables.Add(SplitTable); // Passing a reference to the current table to the array
			
			FillPropertyValues(CurrentKeys, String);
		EndIf;
		
		NewRow = SplitTable.Add();
		FillPropertyValues(NewRow, String);
		
	EndDo;
	
	PackageNumber = 0;
	ComplianceOfOrdersWithPackageNumbers = New Map;
	AssignedPackageNumbers = Undefined;
	For Each ItemTable In ArrayOfTables Do
		For Each RowItem In ItemTable Do
			AssignedPackageNumbers = ComplianceOfOrdersWithPackageNumbers.Get(RowItem.Ref);
			If Not AssignedPackageNumbers = Undefined Then
				Break;
			EndIf;
		EndDo;
		If AssignedPackageNumbers = Undefined Then
			PackageNumber = PackageNumber + 1;
		EndIf;
		For Each RowItem In ItemTable Do
			RowItem.PackageNumber = ?(AssignedPackageNumbers = Undefined, PackageNumber, AssignedPackageNumbers);
			ComplianceOfOrdersWithPackageNumbers.Insert(RowItem.Ref, RowItem.PackageNumber);
		EndDo;
	EndDo;
	NumberOfPackages_ = PackageNumber;
	
	Return ArrayOfTables;
	
EndFunction

// Attributes of Orders and Shipments.
// 
// Parameters:
//  TablesByDocuments - Structure - A structure containing document tables:
//  	* TheOrdersTable - ValueTable - TheOrdersTable:
//			** Key - Array of TypeDescription
//			** Warehouse - CatalogRef.Warehouses -
//  	* TableOfReturnRequests - ValueTable - ShipmentTable:
//			** Key - Array of TypeDescription
//			** Warehouse - CatalogRef.Warehouses -
//  	* ShipmentTable - ValueTable - ShipmentTable:
//			** Key - Array of TypeDescription
//			** Warehouse - CatalogRef.Warehouses -
//  GenerationParameters - See NewParametersForDesignOfSetOfDocuments.
//  ErrorList - Array of UserMessage - error list.
//  NumberOfPackages_ - Number - Number of packages.
//  BusinessOperation - EnumRef.BusinessTransactions - business operation of the document.
//  
// Returns:
//  Array of See SplitTableTemplate_.
Function SplitShipmentOrdersByName(TablesByDocuments, GenerationParameters, ErrorList, NumberOfPackages_, BusinessOperation)
	
	CurrentKeys = StructureOfMeaningfulProps();
	SplitTableTemplate = SplitTableTemplate_();
	
	Query = New Query;
	Query.Text = QueryTextForSignificantAttributesOfShipmentOrders();
	
	TheOrdersTable = TablesByDocuments.TheOrdersTable;
	TableOfReturnRequests = TablesByDocuments.TableOfReturnRequests;
	ShipmentTable = TablesByDocuments.ShipmentTable;
	
	Query.SetParameter("AnArrayOfOrders", TheOrdersTable.UnloadColumn("Key"));
	Query.SetParameter("ArrayOfReturnRequests", TableOfReturnRequests.UnloadColumn("Key"));
	Query.SetParameter("ArrayOfShipments", ShipmentTable.UnloadColumn("Key"));
		
	QueryResult = Query.Execute();
	
	ArrayOfTables = New Array();
	If QueryResult.IsEmpty() Then
		Return ArrayOfTables;
	EndIf;
	
	DataTable = QueryResult.Unload(); // See SplitTableTemplate_
	SplitTable = Undefined;
	
	For Each String In DataTable Do
	
		// Creating a new table in the following cases:
		// 1. The table has never been created yet
		// 2. It is forbidden to group several orders into one implementation of service products
		// 3. The order is an invoice or the key fields differ (for example,
		//	orders with different warehouses cannot be grouped into one invoice)
		If SplitTable = Undefined
			Or (Not GenerationParameters.UseSaleByMultipleOrders
				And GenerationParameters.NewDocumentName = "CustomerInvoice")
			Or String.Partner <> CurrentKeys.Partner
			Or String.Counterparty <> CurrentKeys.Counterparty
			Or String.Contract <> CurrentKeys.Contract
			Or String.Organization <> CurrentKeys.Organization
			Or String.Terms <> CurrentKeys.Terms
			Or String.SalesOpportunity <> CurrentKeys.SalesOpportunity
			Or String.Warehouse <> CurrentKeys.Warehouse
			Or String.Department <> CurrentKeys.Department
			Or String.OriginWarehouse <> CurrentKeys.OriginWarehouse
			Or String.BusinessOperation <> CurrentKeys.BusinessOperation
			Or String.ARAPCurrency <> CurrentKeys.ARAPCurrency
			Or String.VATTaxation <> CurrentKeys.VATTaxation
			Or String.PriceIncludesVAT <> CurrentKeys.PriceIncludesVAT
			Or String.ItIsForbiddenToSelectWarehouseGroup <> CurrentKeys.ItIsForbiddenToSelectWarehouseGroup
			Or String.SaleRegistrationOption <> CurrentKeys.SaleRegistrationOption
			Or String.DeliveryMethod <> CurrentKeys.DeliveryMethod
			Or String.CarrierPartner <> CurrentKeys.CarrierPartner
			Or String.DeliveryAddress <> CurrentKeys.DeliveryAddress
			Or String.DeliveryAddressOfCarrier <> CurrentKeys.DeliveryAddressOfCarrier
			Or String.ToReturnReusablePackage <> CurrentKeys.ToReturnReusablePackage
			Or String.ReusablePackageReturnCycleLength <> CurrentKeys.ReusablePackageReturnCycleLength
			Or String.PackageDepositIsRequired <> CurrentKeys.PackageDepositIsRequired
			Or String.ScheduleOfPackageReturn <> CurrentKeys.ScheduleOfPackageReturn
			Or String.CalculatePackageReturnDateAccordingToCalendar <> CurrentKeys.CalculatePackageReturnDateAccordingToCalendar
			Or String.LineOfBusiness <> CurrentKeys.LineOfBusiness 
			Or String.ARAPObjectSettings <> CurrentKeys.ARAPObjectSettings Then
				
			SplitTable = SplitTableTemplate.Copy();
			ArrayOfTables.Add(SplitTable); // Passing a reference to the current table to the array
			FillPropertyValues(CurrentKeys, String);
		EndIf;
		
		NewRow = SplitTable.Add();
		FillPropertyValues(NewRow, String);
		NewRow.BusinessOperation = BusinessOperation;
		
	EndDo;
	
	PackageNumber = 0;
	ComplianceOfOrdersWithPackageNumbers = New Map;
	AssignedPackageNumbers = Undefined;
	For Each ItemTable In ArrayOfTables Do
		For Each RowItem In ItemTable Do
			AssignedPackageNumbers = ComplianceOfOrdersWithPackageNumbers.Get(RowItem.Ref);
			If Not AssignedPackageNumbers = Undefined Then
				Break;
			EndIf;
		EndDo;
		If AssignedPackageNumbers = Undefined Then
			PackageNumber = PackageNumber + 1;
		EndIf;
		For Each RowItem In ItemTable Do
			RowItem.PackageNumber = ?(AssignedPackageNumbers = Undefined, PackageNumber, AssignedPackageNumbers);
			ComplianceOfOrdersWithPackageNumbers.Insert(RowItem.Ref, RowItem.PackageNumber);
		EndDo;
	EndDo;
	NumberOfPackages_ = PackageNumber;
		
	Return ArrayOfTables;
	
EndFunction

