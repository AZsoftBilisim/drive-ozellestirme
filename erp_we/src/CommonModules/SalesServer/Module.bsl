// Generates a request to monitor the completion of calculations for the order
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForPaymentCompletionControl(QueryText)

	QueryText = QueryText + "
		|SELECT
		|	CASE
		|		WHEN ISNULL(CustomersARAPAccountingBalance.AmountDueBalance, 0) <= 0
		|			THEN FALSE
		|		ELSE TRUE
		|	END AS ThereAreIncompleteCalculations,
		|	CustomersARAPAccountingBalance.Currency AS Currency,
		|	CustomersARAPAccountingBalance.AmountDueBalance AS AmountDueBalance
		|FROM
		|	AccumulationRegister.CustomersARAPAccounting.Balance(, ARAPObject.Object = &Ref) AS CustomersARAPAccountingBalance
		|;
		|";
		
EndProcedure

// Generates a request to monitor the completion of the order shipment
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestMonitoringShipmentCompletion(QueryText)
	
	QueryTextTurnoverTable = "
		|SELECT
		|	(Turnovers.OrderedQuantityTurnover -
		|		Turnovers.IssuedQuantityTurnover) > 0
		|		OR (Turnovers.ForRegistrationQuantityTurnover -
		|			Turnovers.IssuedQuantityTurnover) > 0 AS ThereIsUnfinishedShipment
		|FROM
		|	#ShipmentOrdersTurnoverExpanded AS Turnovers
		|;
		|";
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.ConditionText =
		"ReferenceOrder = &Ref";
	TableFormationParameters.Group = "ReferenceOrder";
	TableFormationParameters.Indicators = "Ordered, ToRegister, Issued_1";
	TableFormationParameters.Resources = "Count";
	
	ShipmentOrdersTurnoverExpanded =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	QueryTextTurnoverTable = StrReplace(QueryTextTurnoverTable,
		"#ShipmentOrdersTurnoverExpanded",
		ShipmentOrdersTurnoverExpanded);
	
	QueryText = QueryText + QueryTextTurnoverTable;
	
EndProcedure

// Generates a request to control the End of the shipment by order of the giver (2.5)
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestMonitoringShipmentCompletion2_5(QueryText)

	QueryTextTurnoverTable = "
		|SELECT
		|	(Turnovers.OrderedQuantityTurnover -
		|		Turnovers.IssuedQuantityTurnover) > 0
		|		OR (Turnovers.ForRegistrationQuantityTurnover -
		|			Turnovers.IssuedQuantityTurnover) > 0 AS ThereIsUnfinishedShipment
		|FROM
		|	#ShipmentOrdersTurnoverExpanded AS Turnovers
		|;
		|";
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.ConditionText =
		"ReferenceOrder = &Ref
		|		AND NOT RowCode IN
		|			(SELECT
		|				GiverSOrder2_5Products.RowCode
		|			FROM
		|				TT_Goods AS GiverSOrder2_5Products
		|			WHERE
		|				GiverSOrder2_5Products.Canceled)";
	TableFormationParameters.Group = "ReferenceOrder";
	TableFormationParameters.Indicators = "Ordered, ToRegister, Issued_1";
	TableFormationParameters.Resources = "Count";
	
	ShipmentOrdersTurnoverExpanded =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	QueryTextTurnoverTable = StrReplace(QueryTextTurnoverTable,
		"#ShipmentOrdersTurnoverExpanded",
		ShipmentOrdersTurnoverExpanded);
	
	QueryText = QueryText + QueryTextTurnoverTable;
	
EndProcedure


// Generates a request to control the End of reporting (2.5) on the order of the giver (2.5)
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestControlDesignOfReports2_5(QueryText)

	QueryText = QueryText + "
		|SELECT
		|	Data.Currency AS Currency,
		|	SUM(Data.Sum) AS Sum,
		|	SUM(Data.Sum) > 0 AS ThereAreUnformattedReports
		|FROM
		|	(SELECT
		|		MaterialProviderOrder2_5.Currency             AS Currency,
		|		GiverSOrder2_5Products.AmountIncludingVAT AS Sum
		|	FROM
		|		Document.MaterialProviderOrder2_5 AS MaterialProviderOrder2_5
		|			LEFT JOIN TT_Goods AS GiverSOrder2_5Products
		|			ON (TRUE)
		|	WHERE
		|		MaterialProviderOrder2_5.Ref = &Ref
		|		AND MaterialProviderOrder2_5.Posted
		|		AND NOT GiverSOrder2_5Products.Canceled
		|
		|	UNION ALL
		|
		|	SELECT
		|		ReportToMaterialProvider2_5ManufacturedProduct.MaterialProviderOrder.Currency AS Currency,
		|		-ReportToMaterialProvider2_5ManufacturedProduct.AmountARAP AS Sum
		|	FROM
		|		Document.ReportToMaterialProvider2_5.ManufacturedProduct AS ReportToMaterialProvider2_5ManufacturedProduct
		|	WHERE
		|		ReportToMaterialProvider2_5ManufacturedProduct.MaterialProviderOrder = &Ref
		|		AND ReportToMaterialProvider2_5ManufacturedProduct.Ref.Posted) AS Data
		|
		|	INNER JOIN
		|		TemporaryTableSalesDocument AS Document
		|	ON
		|		TRUE
		|GROUP BY
		|	Data.Currency
		|;
		|";
	
EndProcedure
// Generates a request to verify the correctness of specifying the direction of Agency purchasing activities
//
// Parameters:
// QueryText - String - text string to which you want to add the query text.
//
Procedure GenerateRequestForVerificationOfDirectionOfActivityForAccountingForIncomeAndExpenses(QueryText)
	
	QueryText = QueryText + "SELECT
	|	CASE
	|		WHEN TemporaryTableSalesDocument.LineOfBusiness = VALUE(Catalog.LinesOfBusiness.EmptyRef)
