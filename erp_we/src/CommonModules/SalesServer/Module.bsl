// Places data on documents created on the basis of temporary storage.
// 
// Parameters:
//  Parameters - Structure - Procedure call parameters.
//  StorageAddress - String - the address of the temporary storage.
Procedure TextsOfDocumentFieldsBasedOnInRepository(Parameters, StorageAddress) Export
	
	ResultData = GetDocumentsBasedOn(Parameters.DocumentRef);
	DocumentsBasedOn = Parameters.DocumentsBasedOn;
	
	TextsFieldsDocumentsBasedOn = New ValueList;
	
	GenerateTextsOfDocumentFieldsBasedOn("", TextsFieldsDocumentsBasedOn, DocumentsBasedOn,
		Parameters.DocumentsList, ResultData);

	ResultData = New Structure;
	ResultData.Insert("TextsFieldsDocumentsBasedOn", TextsFieldsDocumentsBasedOn);
	ResultData.Insert("DocumentsBasedOn", DocumentsBasedOn);

	PutToTempStorage(ResultData, StorageAddress);
	
EndProcedure
	
Function GetDocumentsBasedOn(DocumentRef) Export
	
	ARAPObject = Undefined;
	
	Query = New Query;
	Query.SetParameter("FilterCriteriaValue", DocumentRef);
	Query.Text =
	"SELECT ALLOWED
	|	ARAPObjects.Ref AS CalculationObjectsLink
	|FROM
	|	Catalog.ARAPObjects AS ARAPObjects
	|WHERE
	|	ARAPObjects.Object = &FilterCriteriaValue
	|	AND NOT ARAPObjects.DeletionMark";
	
	QueryResult = Query.Execute();
	If Not QueryResult.IsEmpty() Then
		
		Selection = QueryResult.Select();
		Selection.Next();
		ARAPObject = Selection.CalculationObjectsLink;
		
	EndIf;
	
	Query = New Query;
	Query.SetParameter("ARAPObject", ARAPObject);
	Query.SetParameter("FilterCriteriaValue", DocumentRef);
	Query.Text =
	"SELECT ALLOWED
	|	RelatedDocuments.Ref AS Ref
	|FROM
	|	FilterCriterion.RelatedDocuments(&FilterCriteriaValue) AS RelatedDocuments
	|;
	|
	|SELECT ALLOWED
	|	RelatedDocuments.Ref AS Ref
	|FROM
	|	FilterCriterion.RelatedDocuments(&ARAPObject) AS RelatedDocuments";
	
	AllLinks = New Array;
	AllTypes = New Array;
	AllTypes.Add(TypeOf(DocumentRef));
	
	PackageResult = Query.ExecuteBatch();
	For Each ElemResult In PackageResult Do
		
		Selection = ElemResult.Select();
		While Selection.Next() Do
			
			If Not ValueIsFilled(Selection.Ref)
				Or AllLinks.Find(Selection.Ref) <> Undefined Then
				Continue;
			EndIf;
			
			AllLinks.Add(Selection.Ref);
			RefType = TypeOf(Selection.Ref);
			
			If AllTypes.Find(RefType) = Undefined Then
				AllTypes.Add(RefType);
			EndIf;
			
		EndDo;
		
	EndDo;
	
	RefsTable = New ValueTable;
	RefsTable.Columns.Add("Ref", New TypeDescription(AllTypes));
	
	For Each Itm In AllLinks Do
		
		NewString = RefsTable.Add();
		NewString.Ref = Itm;
		
	EndDo;
	
	SeparateBusinessOperations = New Array;
	SeparateBusinessOperations.Add(Enums.BusinessTransactions.TransferOfTitleToGoods);
	
	Query.SetParameter("AllLinks", RefsTable);
	Query.SetParameter("SeparateBusinessOperations", SeparateBusinessOperations);
	Query.Text =
	"SELECT
	|	CAST(AllLinks.Ref AS Document.SalesOrder) AS Ref
	|INTO AllLinks
	|FROM
	|	&AllLinks AS AllLinks
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	VALUETYPE(AllLinks.Ref) AS Type,
	|	AllLinks.Ref AS Ref,
	|	AllLinks.Ref.Date AS Date,
	|	AllLinks.Ref.Number AS Number,
	|	CASE
	|		WHEN AllLinks.Ref.BusinessOperation IN (&SeparateBusinessOperations)
	|			THEN AllLinks.Ref.BusinessOperation
	|		ELSE VALUE(Enum.BusinessTransactions.EmptyRef)
	|	END AS BusinessOperation
	|INTO DocumentsByType_
	|FROM
	|	AllLinks AS AllLinks
	|WHERE
	|	AllLinks.Ref.Posted
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DocumentsByType_.Type AS Type,
	|	DocumentsByType_.Ref AS Ref,
	|	DocumentsByType_.Number AS Number,
	|	DocumentsByType_.Date AS Date,
	|	DocumentsByType_.BusinessOperation AS BusinessOperation
	|FROM
	|	DocumentsByType_ AS DocumentsByType_
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DocumentsByType_.Type AS Type,
	|	DocumentsByType_.Ref AS Ref,
	|	DocumentsByType_.Number AS Number,
	|	DocumentsByType_.Date AS Date,
	|	DocumentsByType_.BusinessOperation AS BusinessOperation
	|FROM
	|	DocumentsByType_ AS DocumentsByType_
	|TOTALS
	|BY
	|	Type,
	|	BusinessOperation";
	
	Query.Text = StrReplace(Query.Text,
		"CAST(AllLinks.Ref AS Document.SalesOrder)",
		"AllLinks.Ref");
	
	QueryResult = Query.ExecuteBatch();
	
	ResultData = New Structure;
	ResultData.Insert("UploadingDocuments",
		QueryResult[QueryResult.UBound() - 1].Unload());
	ResultData.Insert("UploadingDocumentsByType",
		QueryResult[QueryResult.UBound()].Unload(QueryResultIteration.ByGroups));
	
	Return ResultData;
	
EndFunction

// Generates an array of texts generated based on documents
//
// Parameters:
// 	ResultAddress - String
// 	TextsFieldsDocumentsBasedOn - Array of FormattedString
// 	DocumentsBasedOn - ValueList - The list where the found documents will be placed
// 	ListOfDocumentTypesForRegistration - ValueList - List of document types that can be processed
//  ResultData - Undefined, Structure - Result Data:
// * UploadingDocumentsByType - ValueTable, ValueTree -
// * UploadingDocuments - ValueTable -
// 
Procedure GenerateTextsOfDocumentFieldsBasedOn(ResultAddress,
	TextsFieldsDocumentsBasedOn,
	DocumentsBasedOn,
	ListOfDocumentTypesForRegistration,
	ResultData = Undefined) Export
	
	If ResultData = Undefined Then
		ResultData = GetFromTempStorage(ResultAddress);
		DeleteFromTempStorage(ResultAddress);
	EndIf;
	
	If ResultData = Undefined 
		Or Not ResultData.Property("UploadingDocumentsByType")
		Or Not ResultData.Property("UploadingDocuments") Then
		Return;
	EndIf;
	
	UploadingDocumentsByType = ResultData.UploadingDocumentsByType;
	UploadingDocuments = ResultData.UploadingDocuments;
	
	For Each DocumentTypeForRegistration In ListOfDocumentTypesForRegistration Do
		
		TypesFound = UploadingDocuments.FindRows(DocumentTypeForRegistration.Value);
		If TypesFound.Count() = 0 Then
			
			NewRow = UploadingDocumentsByType.Rows.Add();
			NewRow.Type = DocumentTypeForRegistration.Value.Type;
			NewRow.BusinessOperation = DocumentTypeForRegistration.Value.BusinessOperation;
			
		EndIf;
		
	EndDo;
	
	UploadingDocumentsByType.Rows.Sort("Type, BusinessOperation");
	
	TypesOfDocumentsForRegistration = New Array();
	For Each ListItem In ListOfDocumentTypesForRegistration Do
		TypesOfDocumentsForRegistration.Add(ListItem.Value.Type);
	EndDo;
	
	NumberOfDocumentsByType = 0;
	For Each Document In UploadingDocuments Do
		
		If TypesOfDocumentsForRegistration.Find(Document.Type) <> Undefined Then
			NumberOfDocumentsByType = NumberOfDocumentsByType + 1;
		EndIf;
		
	EndDo;
	
	ListOfAvailableDocumentTypesForRegistration = New ValueList;
	
	For Each DocumentTypeForRegistration In ListOfDocumentTypesForRegistration Do
		
		DocumentMetadataObject = Metadata.FindByType(DocumentTypeForRegistration.Value.Type);
		If DocumentMetadataObject <> Undefined
			And AccessRight("Insert", Metadata.Documents[DocumentMetadataObject.Name]) Then
			ListOfAvailableDocumentTypesForRegistration.Add(DocumentTypeForRegistration.Value);
		EndIf;
		
	EndDo;
	
	Separator = "&";
	PartsOfFormattedString = New Array;
	
	If NumberOfDocumentsByType = 0
		And ListOfAvailableDocumentTypesForRegistration.Count() > 1 Then
		
		// let's form an inscription about the kit
		PartsOfFormattedString.Add(New FormattedString(NStr("vi = 'Lập bộ chứng từ';
															|ru = 'Оформить комплект документов';
															|en = 'Issue a document set'; fa = 'Issue a document set';
															|it = 'Registrare kit documenti';
															|pl = 'Utwórz komplet dokumentów';
															|tr = 'Belge setini düzenle'"),,,,
			"IssueSet" + Separator));
		
		PartsOfFormattedString.Add(New FormattedString(" ("));
		
		DocumentsCount = 0;
		
		For Each DocumentTypeForRegistration In ListOfAvailableDocumentTypesForRegistration Do
			
			DocumentMetadataObject = Metadata.FindByType(DocumentTypeForRegistration.Value.Type);
			DocumentsCount = DocumentsCount + 1;
			
			DocumentNames_ = GetAbbreviatedDocumentNames(DocumentTypeForRegistration.Value);
			
			If ValueIsFilled(DocumentTypeForRegistration.Value.BusinessOperation) Then
				
				BusinessTransactionName =
					Metadata.Enums.BusinessTransactions.FullName()
					+ "."
					+ XMLString(DocumentTypeForRegistration.Value.BusinessOperation);
				
			Else
				BusinessTransactionName = "";
			EndIf;
			
			PartsOfFormattedString.Add(New FormattedString(DocumentNames_.AccusativeCase,,,,
				"ApplyAppearance" + Separator
					+ DocumentMetadataObject.FullName()
					+ ?(ValueIsFilled(BusinessTransactionName),
						Separator + BusinessTransactionName,
						"")));
				
			If DocumentsCount < ListOfAvailableDocumentTypesForRegistration.Count() Then
				PartsOfFormattedString.Add(New FormattedString(", "));
			EndIf;
			
		EndDo;
		
		PartsOfFormattedString.Add(New FormattedString(")"));
		
	Else
		
		// let's form the labels separately
		For Each DocumentsByType_ In UploadingDocumentsByType.Rows Do
			
			If TypesOfDocumentsForRegistration.Find(DocumentsByType_.Type) = Undefined Then
				Continue;
			EndIf;
			
			DocumentMetadataObject = Metadata.FindByType(DocumentsByType_.Type);
			If DocumentMetadataObject = Undefined Then
				Continue;
			EndIf;
			
			If Not AccessRight("Read", Metadata.Documents[DocumentMetadataObject.Name]) Then
				Continue;
			EndIf;
			
			If DocumentsByType_.Rows.Count() = 0 Then
				
				DocumentNames_ = GetAbbreviatedDocumentNames(DocumentsByType_);
				
				If Not AccessRight("Insert", Metadata.Documents[DocumentMetadataObject.Name]) Then
					Continue;
				EndIf;
				
				FormatText_ = NStr("vi = 'Lập %1';
									|ru = 'Оформить %1';
									|en = 'Register %1'; fa = 'Register %1';
									|it = 'Registrare %1';
									|pl = 'Sporządzić %1';
									|tr = 'Düzenle %1'");
				FormatText_ = StrTemplate(FormatText_, DocumentNames_.AccusativeCase);
				
				If ValueIsFilled(DocumentsByType_.BusinessOperation) Then
					
					BusinessTransactionName =
						Metadata.Enums.BusinessTransactions.FullName()
						+ "."
						+ XMLString(DocumentsByType_.BusinessOperation);
					
				Else
					BusinessTransactionName = "";
				EndIf;
				
				PartsOfFormattedString.Add(New FormattedString(FormatText_,,,,
					"ApplyAppearance" + Separator
					+ DocumentMetadataObject.FullName()
					+ ?(ValueIsFilled(BusinessTransactionName),
						Separator + BusinessTransactionName,
						"")));
				
				PartsOfFormattedString.Add(New FormattedString("  "));
				
			Else
				
				For Each OFOperationDocuments In DocumentsByType_.Rows Do
					
					DocumentNames_ = GetAbbreviatedDocumentNames(OFOperationDocuments);
					
					If ValueIsFilled(OFOperationDocuments.BusinessOperation) Then
						
						BusinessTransactionName =
							Metadata.Enums.BusinessTransactions.FullName()
							+ "."
							+ XMLString(OFOperationDocuments.BusinessOperation);
						
					Else
						BusinessTransactionName = "";
					EndIf;
					
					DocumentsOnOperationOfLine = OFOperationDocuments.Rows;
					
					If DocumentsOnOperationOfLine.Count() = 0 Then
						
						If Not AccessRight("Insert", Metadata.Documents[DocumentMetadataObject.Name]) Then
							Continue;
						EndIf;
						
						FormatText_ = NStr("vi = 'Lập %1';
											|ru = 'Оформить %1';
											|en = 'Register %1'; fa = 'Register %1';
											|it = 'Registrare %1';
											|pl = 'Sporządzić %1';
											|tr = 'Düzenle %1'");
						FormatText_ = StrTemplate(FormatText_, DocumentNames_.AccusativeCase);
						
						PartsOfFormattedString.Add(New FormattedString(FormatText_,,,,
							"ApplyAppearance" + Separator
							+ DocumentMetadataObject.FullName()
							+ ?(ValueIsFilled(BusinessTransactionName),
								Separator + BusinessTransactionName,
								"")));
						
					ElsIf DocumentsOnOperationOfLine.Count() = 1 Then
							
						DocumentsBasedOn.Add(DocumentsOnOperationOfLine[0].Ref); 
						
						PresentationOfDocument = TMCommonUseClientServer.GenerateDocumentTitle(
							DocumentsOnOperationOfLine[0],
							DocumentNames_.Abbreviated_);
						
						PartsOfFormattedString.Add(New FormattedString(PresentationOfDocument,,,,
							"OpenDocument" + Separator + GetURL(DocumentsOnOperationOfLine[0].Ref)));
					
					ElsIf DocumentsOnOperationOfLine.Count() > 1 Then
					
						For Each Document In DocumentsOnOperationOfLine Do
							DocumentsBasedOn.Add(Document.Ref);
						EndDo;
						
						HyperlinkText = DocumentNames_.PluralForm
							+ Chars.NBSp
							+ "("
							+ String(DocumentsOnOperationOfLine.Count())
							+ ")";
							
						PartsOfFormattedString.Add(New FormattedString(HyperlinkText,,,,
							"OpenList" + Separator + DocumentMetadataObject.FullName()));
						
					EndIf;
					
					PartsOfFormattedString.Add(New FormattedString("  "));
					
				EndDo;
				
			EndIf;
			
		EndDo;
		
	EndIf;
	
	TextsFieldsDocumentsBasedOn.Add(PartsOfFormattedString);
	
EndProcedure

// The function generates parameters for the mass output in words.
// For example, in the form of " Twenty-three t. three hundred and forty-three kg.".
//
// Parameters:
//  Weight - Number
//  TonConversionFactor - Number
//
// Returns:
//  Structure:
//  * Format - String
//  * ZoomRatio - Number
//
Function MassParametersInWords(Weight, TonConversionFactor) Export
	
	TonWeight = Weight * TonConversionFactor;
	If TonWeight >= 1 Then
		ZoomRatio = 1;
		StringFormat = "t, t, t, railroad, kg, kg, kg, m, " + ?(Round(TonWeight) = TonWeight, "0", "3");
	ElsIf TonWeight * 1000 >= 1 Then
		ZoomRatio = 1000;
		StringFormat = "kg, kg, kg, m, g, g, g, m, " + ?(Round(TonWeight * ZoomRatio) = TonWeight * ZoomRatio, "0", "3");
	Else
		ZoomRatio = 1000000;
		StringFormat = "g, g, g, m, g, g, g, m, 0";
	EndIf;
	
	Return New Structure("Format, ZoomRatio", StringFormat, ZoomRatio*TonConversionFactor);
	
EndFunction

// Returns the percentage of increase, taking into account the presence of negative values.
//
// Parameters:
//	PreviousValue - Number
//	CurrentValue - Number
//
// Returns:
//	Number
//
Function IncreasePercentage(PreviousValue, CurrentValue) Export
	
	Result = 0;
	
	If PreviousValue = CurrentValue Then
		Result = 0;
	ElsIf CurrentValue = 0 And PreviousValue < 0 Then
		Result = 100;
	ElsIf CurrentValue = 0 Then
		Result = -100;
	ElsIf CurrentValue < 0 And PreviousValue = 0 Then
		Result = -100;
	ElsIf PreviousValue = 0 Then
		Result = 100;
	Else
		Result = (CurrentValue - PreviousValue) / ?(PreviousValue > 0, PreviousValue, -PreviousValue) * 100;
	EndIf;
	
	Return Result;
	
EndFunction

// This is a Contract For a new commission.
// 
// Parameters:
//  Contract - CatalogRef.CounterpartyContracts
// 
