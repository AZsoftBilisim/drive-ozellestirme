Function AdditionalOrderTables(ArrayOfCustomersOrders, Currency)
	
	TableStructure = New Structure("DiscountsOrderMargins, OrderDetails_, TableOfExchangeRates, StructureOfNewCurrencyRates");
	
	Query = New Query;
	Query.SetParameter("ArrayOfCustomersOrders", ArrayOfCustomersOrders);
	Query.SetParameter("DocumentCurrency",       Currency);
	
	// Getting a discount/mark-up table
	Query.Text =
	"SELECT
	|	DiscountsMarkups.Ref AS SalesOrder,
	|	DiscountsMarkups.ConnectionKey AS ConnectionKey,
	|	DiscountsMarkups.DiscountMarkup AS DiscountMarkup,
	|	DiscountsMarkups.Sum AS Sum
	|FROM
	|	Document.SalesOrder.DiscountsMarkups AS DiscountsMarkups
	|WHERE
	|	DiscountsMarkups.Ref IN (&ArrayOfCustomersOrders)
	|
	|UNION ALL
	|
	|SELECT
	|	DiscountsMarkups.Ref AS SalesOrder,
	|	DiscountsMarkups.ConnectionKey AS ConnectionKey,
	|	DiscountsMarkups.DiscountMarkup AS DiscountMarkup,
	|	DiscountsMarkups.Sum AS Sum
	|FROM
	|	Document.RequestForReturnOfGoodsFromCustomer.DiscountsMarkups AS DiscountsMarkups
	|WHERE
	|	DiscountsMarkups.Ref IN (&ArrayOfCustomersOrders)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	BEGINOFPERIOD(TheOrdersTable.Date, DAY) AS Date,
	|	TheOrdersTable.Ref AS SalesOrder,
	|	TheOrdersTable.Currency AS Currency,
	|	TheOrdersTable.PriceIncludesVAT AS PriceIncludesVAT,
	|	CASE
	|		WHEN TheOrdersTable.Currency <> &DocumentCurrency
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ConvertToDocumentCurrency
	|FROM
	|	Document.SalesOrder AS TheOrdersTable
	|WHERE
	|	TheOrdersTable.Ref IN(&ArrayOfCustomersOrders)
	|
	|UNION ALL
	|
	|SELECT
	|	BEGINOFPERIOD(TheOrdersTable.Date, DAY),
	|	TheOrdersTable.Ref,
	|	TheOrdersTable.Currency,
	|	TheOrdersTable.PriceIncludesVAT,
	|	CASE
	|		WHEN TheOrdersTable.Currency <> &DocumentCurrency
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|FROM
	|	Document.RequestForReturnOfGoodsFromCustomer AS TheOrdersTable
	|WHERE
	|	TheOrdersTable.Ref IN(&ArrayOfCustomersOrders)
	|
	|UNION ALL
	|
	|SELECT
	|	BEGINOFPERIOD(TheOrdersTable.Date, DAY) AS Date,
	|	TheOrdersTable.Ref AS SalesOrder,
	|	TheOrdersTable.Currency AS Currency,
	|	FALSE AS PriceIncludesVAT,
	|	CASE
	|		WHEN TheOrdersTable.Currency <> &DocumentCurrency
	|			THEN TRUE
	|		ELSE FALSE
	|	END AS ConvertToDocumentCurrency
	|FROM
	|	Document.SubcontractOrder2_5 AS TheOrdersTable
	|WHERE
	|	TheOrdersTable.Ref IN(&ArrayOfCustomersOrders)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	BEGINOFPERIOD(CombinedOrderTable.Date, DAY) AS Date,
	|	CombinedOrderTable.Currency AS Currency,
	|	CombinedOrderTable.Organization AS Organization
	|FROM
	|	(SELECT
	|		BEGINOFPERIOD(TheOrdersTable.Date, DAY) AS Date,
	|		TheOrdersTable.Currency AS Currency,
	|		TheOrdersTable.Organization
	|	FROM
	|		Document.SalesOrder AS TheOrdersTable
	|	WHERE
	|		TheOrdersTable.Ref IN (&ArrayOfCustomersOrders)
	|		AND TheOrdersTable.Currency <> &DocumentCurrency
	|
	|	UNION ALL
	|
	|	SELECT
	|		BEGINOFPERIOD(TheOrdersTable.Date, DAY),
	|		TheOrdersTable.Currency,
	|		TheOrdersTable.Organization
	|	FROM
	|		Document.RequestForReturnOfGoodsFromCustomer AS TheOrdersTable
	|	WHERE
	|		TheOrdersTable.Ref IN (&ArrayOfCustomersOrders)
	|		AND TheOrdersTable.Currency <> &DocumentCurrency
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		BEGINOFPERIOD(TheOrdersTable.Date, DAY),
	|		TheOrdersTable.Currency,
	|		TheOrdersTable.Organization
	|	FROM
	|		Document.SubcontractOrder2_5 AS TheOrdersTable
	|	WHERE
	|		TheOrdersTable.Ref IN(&ArrayOfCustomersOrders)
	|		AND TheOrdersTable.Currency <> &DocumentCurrency
	|
	|	) AS CombinedOrderTable";
	
	QueryResult = Query.ExecuteBatch(); 
	TableStructure.DiscountsOrderMargins = QueryResult[0].Unload();
	TableStructure.OrderDetails_ = QueryResult[1].Select();
	
	TableOfExchangeRates = New ValueTable;
	TableOfExchangeRates.Columns.Add("Currency", New TypeDescription("CatalogRef.Currencies"));
	TableOfExchangeRates.Columns.Add("Date", New TypeDescription("Date"));
	TableOfExchangeRates.Columns.Add("CourseNumerator", New TypeDescription("Number"));
	TableOfExchangeRates.Columns.Add("CourseDenominator", New TypeDescription("Number"));
	
	Selection = QueryResult[2].Select();
	
	While Selection.Next() Do
		
		NewRow = TableOfExchangeRates.Add();
		FillPropertyValues(NewRow, Selection);
		
		Currency_Rates = ProcessingOfExchangeRatesTM.GetCurrencyRate(Selection.Currency, Selection.Date,
						SettingsValueCached.CurrencyOfOrganizationSRegulatedAccounting(Selection.Organization));
		NewRow.CourseNumerator = Currency_Rates.CourseNumerator;
		NewRow.CourseDenominator = Currency_Rates.CourseDenominator;
		
	EndDo;
	
	If TableOfExchangeRates.Count() > 0 Then
		StructureOfNewCurrencyRates = ProcessingOfExchangeRatesTM.GetCurrencyRate(Currency, CurrentSessionDate());
	EndIf;
	TableStructure.TableOfExchangeRates = TableOfExchangeRates;
	TableStructure.StructureOfNewCurrencyRates = StructureOfNewCurrencyRates;
	
	Return TableStructure
	
EndFunction

// Parameters:
// 	DocumentObject_ - FormDataStructure, DocumentObject - 
// 	
Function FillInLineByClientSOrder(SearchStructureForTSProducts, QuantityToShip_, DocumentObject_, GoodsFromOrders, AdditionalOrderTables)
	
	ThisIsImplementation = Not (TypeOf(DocumentObject_.Ref) = Type("DocumentRef.TransferOfGoodsToBailee"));
	ThisIsImplementation = ThisIsImplementation And Not TypeOf(DocumentObject_.Ref) = Type("DocumentRef.GoodsShipmentFromStorage");
	DiscountsOrderMargins = AdditionalOrderTables.DiscountsOrderMargins;
	OrderDetails_ = AdditionalOrderTables.OrderDetails_;
	TableOfExchangeRates = AdditionalOrderTables.TableOfExchangeRates;
	StructureOfNewCurrencyRates = AdditionalOrderTables.StructureOfNewCurrencyRates;
	
	NewRow = DocumentObject_.Goods.Add();
	ExcludeProperties_ = "Count";
	
	FoundRows = GoodsFromOrders.FindRows(SearchStructureForTSProducts);
	If FoundRows.Count()>0 Then
		
		FoundRow = FoundRows.Get(0);
		
		RecalculateAmounts = (QuantityToShip_ <> FoundRow.QuantityInOrder);
		If RecalculateAmounts Then
			
			ExcludeProperties_ = ExcludeProperties_ + ", Sum";
			
			If NewRow.Property("VATAmount") Then
				ExcludeProperties_ = ExcludeProperties_ + ", VATAmount";
			EndIf;
			
			If NewRow.Property("DiscountMarkupAmount") Then
				ExcludeProperties_ = ExcludeProperties_ + ", DiscountMarkupAmount, ManualDiscount";
			EndIf;
			
		EndIf;
		
		FillPropertyValues(NewRow, FoundRow, , ExcludeProperties_);
		
		NewRow.Count = QuantityToShip_;
		NewRow.NumberOfPackages = QuantityToShip_ / FoundRow.ZoomRatio;;
		
		If ThisIsImplementation
			And RecalculateAmounts Then
			NewRow.AmountARAP = NewRow.AmountARAP * QuantityToShip_ / FoundRow.Count;
			NewRow.AmountIncludingVAT = NewRow.AmountARAP;
		EndIf;
		
		OrderDetails_.Reset();
		OrderFound = OrderDetails_.FindNext(NewRow.SalesOrder, "SalesOrder");
		
		FilterParameters = New Structure("Currency,Date", OrderDetails_.Currency, OrderDetails_.Date);
		CurrencyExchangeRate = TableOfExchangeRates.FindRows(FilterParameters);
		
		If OrderFound And OrderDetails_.ConvertToDocumentCurrency Then
			
			If CurrencyExchangeRate.Count() = 1 Then
			
				NewRow.Price = ProcessingOfExchangeRatesTM.ConvertAtRate(
					NewRow.Price,
					CurrencyExchangeRate[0],
					StructureOfNewCurrencyRates);
				NewRow.AmountIncludingVAT = ProcessingOfExchangeRatesTM.ConvertAtRate(
					NewRow.AmountIncludingVAT,
					CurrencyExchangeRate[0],
					StructureOfNewCurrencyRates);
				RecalculateAmounts = True;
			EndIf;
			
		EndIf;
		
		DiscountConversionRate = ?(ThisIsImplementation And RecalculateAmounts,
						NewRow.Count / ?(FoundRow.QuantityInOrder <> 0, FoundRow.QuantityInOrder, 1),
						1);
		
		If DiscountConversionRate <> 1 Then
			NewRow.DiscountMarkupAmount = Round(FoundRow.DiscountMarkupAmount * DiscountConversionRate,2);
			NewRow.ManualDiscount = Round(FoundRow.ManualDiscount * DiscountConversionRate,2);
		EndIf;
		
		If OrderFound And RecalculateAmounts Then
			
			PriceManagementSystem.RecalculateAmountsInRowWithVAT(
				NewRow,
				OrderDetails_.PriceIncludesVAT,
				False,
				False,
				OrderDetails_.ConvertToDocumentCurrency);
				
			If ThisIsImplementation
				And OrderFound
				And OrderDetails_.ConvertToDocumentCurrency
				And CurrencyExchangeRate.Count() = 1 Then
				
				NewRow.DiscountMarkupAmount = ProcessingOfExchangeRatesTM.ConvertAtRate(
					NewRow.DiscountMarkupAmount,
					CurrencyExchangeRate[0],
					StructureOfNewCurrencyRates);
				NewRow.ManualDiscount = ProcessingOfExchangeRatesTM.ConvertAtRate(
					NewRow.ManualDiscount,
					CurrencyExchangeRate[0],
					StructureOfNewCurrencyRates);
				
			EndIf;
			
		EndIf;
		
		If ThisIsImplementation Then
			// Formation of the tabular part of discounts
			AmountForAllocation = NewRow.DiscountMarkupAmount;
			
			If NewRow.ConnectionKey <> 0 Then
				For Each OrderDiscountsRow In DiscountsOrderMargins.FindRows(New Structure("SalesOrder,ConnectionKey", NewRow.SalesOrder, NewRow.ConnectionKey)) Do
					
					DiscountsRow = DocumentObject_.DiscountsMarkups.Add();
					FillPropertyValues(DiscountsRow, OrderDiscountsRow);
					DiscountsRow.Sum = DiscountConversionRate * DiscountsRow.Sum;
					
					If OrderFound And OrderDetails_.ConvertToDocumentCurrency And CurrencyExchangeRate.Count() > 0 Then
						DiscountsRow.Sum = ProcessingOfExchangeRatesTM.ConvertAtRate(
							DiscountsRow.Sum,
							CurrencyExchangeRate[0],
							StructureOfNewCurrencyRates);
						AmountForAllocation = AmountForAllocation - DiscountsRow.Sum;
					EndIf;
					
				EndDo;
			EndIf;
			
			If OrderFound And OrderDetails_.ConvertToDocumentCurrency And AmountForAllocation <> 0 Then
				DiscountsRow.Sum = DiscountsRow.Sum + AmountForAllocation;
			EndIf;
			
		EndIf;
		
	EndIf;
	
	Return NewRow;
	
EndFunction

