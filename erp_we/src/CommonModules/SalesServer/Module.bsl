// Adds a request to the request package to fill in the data of the counterparty for the purchase document when processing 
// rows in the table part.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure CompleteQueryTextWithDataOnPurchaseDocument(StructureOfActions, QueryDetails, CachedValues) Export
	
	If BatchProcessingOfTablePartServer.YouNeedToPerformAction(
		"FillInDataOnPurchaseDocumentInReportToPurchasingCommittee",
		StructureOfActions,
		CachedValues) Then
	
		QueryText = "
			|SELECT ALLOWED
			|	DataSource.IdOfTTRow AS IdOfTTRow,
			|	CASE 
			|		WHEN &ConditionByType THEN DataSource.Counterparty
			|	END AS Counterparty
			|FROM
			|	TTDataSource AS DataSource";
		
		TypesOfDocumentsInPurchaseDocumentColumn = BatchProcessingOfTablePartServer.ColumnTypeInDataSource("DocumentAcquisitions", CachedValues).Types();
		
		ExpressByTypes = New Array();
		
		If TypesOfDocumentsInPurchaseDocumentColumn.Find(Type("DocumentRef.ReturnOfGoodsToVendor")) <> Undefined Then
			ExpressByTypes.Add("		WHEN VALUETYPE(DataSource.DocumentAcquisitions) = TYPE(Document.ReturnOfGoodsToVendor) THEN
										|			CAST(DataSource.DocumentAcquisitions AS Document.ReturnOfGoodsToVendor).Counterparty
										|");
		EndIf;
		
		If TypesOfDocumentsInPurchaseDocumentColumn.Find(Type("DocumentRef.PurchaseAdjustment")) <> Undefined Then
			ExpressByTypes.Add("		WHEN VALUETYPE(DataSource.DocumentAcquisitions) = TYPE(Document.PurchaseAdjustment) THEN
										|			CAST(DataSource.DocumentAcquisitions AS Document.PurchaseAdjustment).Counterparty
										|");
		EndIf;
		
		If TypesOfDocumentsInPurchaseDocumentColumn.Find(Type("DocumentRef.VendorInvoice")) <> Undefined Then
			ExpressByTypes.Add("		WHEN VALUETYPE(DataSource.DocumentAcquisitions) = TYPE(Document.VendorInvoice) THEN
										|			CAST(DataSource.DocumentAcquisitions AS Document.VendorInvoice).Counterparty
										|");
		EndIf;
		
		PartOfRequest  = StrConcat(ExpressByTypes, Chars.LF);
		QueryText = StrReplace(QueryText, "WHEN &ConditionByType THEN DataSource.Counterparty", PartOfRequest);
		
		QueryDetails.QueriesTexts.Add(QueryText, "DataOnPurchaseDocument");
		
	EndIf;
	
EndProcedure

// Adds a request to the request package to fill in the Selection Price type field when processing rows in the table part.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure CompleteTextFillingInPriceType(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var StructureOfActionParameters;
	
	If BatchProcessingOfTablePartServer.YouNeedToPerformAction(
			"CheckFillInPriceView",
			StructureOfActions,
			CachedValues,
			StructureOfActionParameters) Then
		
		FilterConditions = New Array;
		NumberOfParameters = 0;
		
		For Each Condition In StructureOfActionParameters.FilterParameters Do
			
			If Condition.Value = Undefined Then
				Continue;
			EndIf;
			
			FilterConditions.Add("TypesOfPrices." + Condition.Key + " IN (&VALUE" + NumberOfParameters + ")");
			QueryDetails.QueryOptions.Insert("Value" + NumberOfParameters, Condition.Value);
			NumberOfParameters = NumberOfParameters + 1;
			
		EndDo;
	
		QueryText = "
			|SELECT
			|	DataSource.IdOfTTRow AS IdOfTTRow,
			|	ISNULL(TypesOfPrices.Ref, &DefaultPriceType) AS PriceKind
			|FROM
			|	TTDataSource AS DataSource
			|	LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
			|	ON &PriceType_Field = TypesOfPrices.Ref
			|		AND &ReplacingSelectionCondition
			|";
		
		ReplacingSelectionCondition = StrConcat(FilterConditions, " And ");
		QueryText = StrReplace(QueryText, "&ReplacingSelectionCondition", ReplacingSelectionCondition);
		
		ColumnNamePriceType = "PriceKind";
		If TypeOf(StructureOfActionParameters.PriceKind) = Type("String")
				And ValueIsFilled(StructureOfActionParameters.PriceKind) Then
			ColumnNamePriceType = StructureOfActionParameters.PriceKind;
			QueryText = StrReplace(QueryText, "&PriceType_Field", "DataSource." + ColumnNamePriceType);
		Else
			QueryDetails.QueryOptions.Insert("PriceType_Field", StructureOfActionParameters.PriceKind);
		EndIf;
		
		QueryDetails.QueryOptions.Insert("DefaultPriceType", StructureOfActionParameters.DefaultPriceType);
		
		QueryDetails.QueriesTexts.Add(QueryText, "TypesOfPrices");
		
	EndIf;
	
EndProcedure

// Returns a structure with a description of parameters for entering a document based on.
//
// Returns:
// 	Structure - Structure:
// 		* Type - Type - Document type.
// 		* BusinessOperation - EnumRef.BusinessTransactions - The operation of the document.
//
Function NewDocumentInputParametersBasedOn()
	
	Result = New Structure;
	Result.Insert("Type", Undefined);
	Result.Insert("BusinessOperation", Enums.BusinessTransactions.EmptyRef());
	
	Return Result;
	
EndFunction

Function ListOfNavigationLinkDocumentTypes(Object, ConsignmentSales25)

	DocumentsList = New ValueList;
	
	ObjectAttributes = Common.ObjectAttributesValues(Object,
		"BusinessOperation, ARAPObjectSettings, PaymentMethod");
	
	UseShipmentWithDeferredTransferOfTitle =
		GetFunctionalOption("UseShipmentWithDeferredTransferOfTitle2_5");
	
	If UseShipmentWithDeferredTransferOfTitle Then
		
		ToUseTermsOfSales = GetFunctionalOption("ToUseTermsOfSales");
		If ToUseTermsOfSales Then
			
			SetPrivilegedMode(True);
			
			Terms = Common.ObjectAttributeValue(Object, "Terms");
			If ValueIsFilled(Terms) Then
		
				UseShipmentWithDeferredTransferOfTitle =
					Common.ObjectAttributeValue(
						Terms,
						"SaleWithDeferredTransferOfTitleIsAllowed");
			
			EndIf;
			
			SetPrivilegedMode(False);
			
		EndIf;
		
	EndIf;
	
	If ObjectAttributes.BusinessOperation = Enums.BusinessTransactions.SaleToCustomer Then
		
		If UseShipmentWithDeferredTransferOfTitle Then
			
			NewOperation = NewDocumentInputParametersBasedOn();
			NewOperation.Type = Type("DocumentRef.GoodsShipmentToCustomer");
			DocumentsList.Add(NewOperation);
			
			NewOperation = NewDocumentInputParametersBasedOn();
			NewOperation.Type = Type("DocumentRef.CustomerInvoice");
			NewOperation.BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods;
			DocumentsList.Add(NewOperation);
			
		EndIf;
		
		NewOperation = NewDocumentInputParametersBasedOn();
		NewOperation.Type = Type("DocumentRef.CustomerInvoiceServices");
		DocumentsList.Add(NewOperation);
		
		NewOperation = NewDocumentInputParametersBasedOn();
		NewOperation.Type = Type("DocumentRef.CustomerInvoice");
		DocumentsList.Add(NewOperation);
		
		If ObjectAttributes.ARAPObjectSettings = Enums.ARAPObjectSettings.ByOrders 
			And (ObjectAttributes.PaymentMethod = Enums.PaymentForms.CashAccountPayment_ 
				Or ObjectAttributes.PaymentMethod = Enums.PaymentForms.EmptyRef()) Then
					
			NewOperation = NewDocumentInputParametersBasedOn();
			NewOperation.Type = Type("DocumentRef.CashAccountReceiptNote");
			DocumentsList.Add(NewOperation);
			
		EndIf;
		
	ElsIf ObjectAttributes.BusinessOperation = Enums.BusinessTransactions.TransferToStorageWithRightOfSale Then
		
		NewOperation = NewDocumentInputParametersBasedOn();
		NewOperation.Type = Type("DocumentRef.TransferOfGoodsToBailee");
		DocumentsList.Add(NewOperation);
		
	ElsIf ObjectAttributes.BusinessOperation = Enums.BusinessTransactions.ShipGoodsReceivedFromStorageWithRightOfSale Then
		
		NewOperation = NewDocumentInputParametersBasedOn();
		NewOperation.Type = Type("DocumentRef.GoodsShipmentFromStorage");
		DocumentsList.Add(NewOperation);
		
	ElsIf ObjectAttributes.BusinessOperation = Enums.BusinessTransactions.TransferToCommissionAgent 
		And ConsignmentSales25 Then
			
		NewOperation = NewDocumentInputParametersBasedOn();
		NewOperation.Type = Type("DocumentRef.TransferOfGoodsToBailee");
		DocumentsList.Add(NewOperation);
		
	EndIf;
	
	Return DocumentsList;
	
EndFunction

