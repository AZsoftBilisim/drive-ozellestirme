// Adds a new user error to the error list for further submission using
// the Saleslient procedure.Report errors to the user ().
// it is Designed to accumulate a list of errors and then process this list before displaying
// it to the user. 
//
// Parameters:
//   Object - AnyRef,
//            Anyobject - the object where the error was detected,
//            String-description of the object where the error was detected.
//   ErrorText - String - message text.
//   ErrorField - String  - Full name of the prop where the error was detected.
//
Procedure AddUserError(
		Errors,
		Object,
		ErrorText,
		ErrorField="")
	
	If Errors = Undefined Then
		Errors = New Array;
	EndIf;
	
	Error = ObjectMessage(ErrorText, Object, ErrorField);
	
	Errors.Add(Error);
	
EndProcedure

// Returns an error message about filling in the object's details.
//
// Parameters:
//   Text  - String      - message text.
//   Object - AnyRef,
//            Anyobject - the object where the error was detected,
//            String-description of the object where the error was detected.
//   Field   - String      - Full name of the prop where the error was detected.
//
// Returns:
//   UserMessage - error message.
//
Function ObjectMessage(Text, Object, Field = "") Export
	Message = New UserMessage;
	Message.Text = Text;
	Message.Field = Field;
	
	If TypeOf(Object) = Type("String") Then
		Message.DataPath = Object;
	Else
		Message.DataKey = Object;
	EndIf;
	
	Return Message;
EndFunction

