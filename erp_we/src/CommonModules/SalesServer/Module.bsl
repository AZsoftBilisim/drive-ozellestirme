Function RequestTextForSignificantOrderDetails()
	
	RightOfAccessCustomerOrder = AccessRight("Read", Metadata.Documents.SalesOrder);
	
	QueryTexts         = New Array;
	RequestTextsForTTOrders = New Array;
	RequestTextsOrders   = New Array;
	
	QueryTexts.Add(
	"SELECT
	|	TheOrdersTable.Key AS Ref,
	|	TheOrdersTable.Warehouse AS Warehouse
	|INTO
	|	TTOrdersByWarehouse
	|FROM
	|	&TheOrdersTable AS TheOrdersTable
	|
	|INDEX BY
	|	Ref,
	|	Warehouse
	|");
	
	RequestTextsForTTOrders.Add(
	"SELECT ALLOWED
	|	TheOrdersTable.Ref AS Ref,
	|	TheOrdersTable.Warehouse AS Warehouse
	|INTO TTOfOrders
	|FROM
	|	TTOrdersByWarehouse AS TheOrdersTable
	|");
		
	If RightOfAccessCustomerOrder Then
		
		RequestTextsForTTOrders.Add(
		"SELECT
		|	CustomerOrderGoods.Ref AS Ref,
		|	CustomerOrderGoods.Warehouse AS Warehouse
		|FROM
		|	Document.SalesOrder.Goods AS CustomerOrderGoods
		|	
		|	INNER JOIN Document.SalesOrder AS SalesOrder
		|	ON CustomerOrderGoods.Ref = SalesOrder.Ref
		|	
		|	LEFT JOIN Catalog.Warehouses AS Warehouses
		|	ON SalesOrder.Warehouse = Warehouses.Ref
		|
		|WHERE CustomerOrderGoods.Ref IN (&ReferencesArrray)
		|	AND Warehouses.IsFolder
		|	AND Warehouses.SelectGroup = VALUE(Enum.SelectWarehouseGroup.AllowInOrders)
		|	AND (NOT &UseWarehouseSelection
		|		OR CustomerOrderGoods.Warehouse IN(&Warehouse, VALUE(Catalog.Warehouses.EmptyRef)))
		|");
		
		RequestTextsOrders.Add(
			"SELECT ALLOWED DISTINCT
			|	SalesOrder.Ref AS Ref,
			|	SalesOrder.Partner AS Partner,
			|	SalesOrder.Counterparty AS Counterparty,
			|	SalesOrder.Contract AS Contract,
			|	SalesOrder.Organization AS Organization,
			|	SalesOrder.Terms AS Terms,
			|	SalesOrder.SalesOpportunity AS SalesOpportunity,
			|	SalesOrder.Warehouse AS Warehouse,
			|	CASE
			|		WHEN Warehouses.IsFolder
			|			AND Warehouses.SelectGroup = VALUE(Enum.SelectWarehouseGroup.AllowInOrders)
			|			THEN FALSE
			|		ELSE TRUE
			|	END AS WarehouseInOrderHeader,
			|	SalesOrder.Department AS Department,
			|	SalesOrder.Currency AS Currency,
			|	SalesOrder.VATTaxation AS VATTaxation,
			|	SalesOrder.PriceIncludesVAT AS PriceIncludesVAT,
			|	SalesOrder.DeliveryMethod AS DeliveryMethod,
			|	SalesOrder.ToReturnReusablePackage AS ToReturnReusablePackage,
			|	SalesOrder.ReusablePackageReturnCycleLength AS ReusablePackageReturnCycleLength,
			|	SalesOrder.PackageDepositIsRequired AS PackageDepositIsRequired,
			|	SalesOrder.LineOfBusiness AS LineOfBusiness,
			|	SalesOrder.ARAPObjectSettings AS ARAPObjectSettings,
			|	SalesOrder.BusinessOperation AS BusinessOperation,
			|	SalesOrder.CarrierPartner AS CarrierPartner,
			|	SalesOrder.DeliveryAddress AS DeliveryAddress,
			|	SalesOrder.DeliveryAddressOfCarrier AS DeliveryAddressOfCarrier,
			|	SalesOrder.ThisIsOrderAsInvoice AS ThisIsOrderAsInvoice
			|INTO TTCustomerOrders
			|FROM
			|	Document.SalesOrder AS SalesOrder
			|		LEFT JOIN Catalog.Warehouses AS Warehouses
			|			ON SalesOrder.Warehouse = Warehouses.Ref
			|WHERE
