Function DescriptionOfSourceOfFillingInSalesConditions(ActionParameters)
	
	If ThisIsContractForNewCommission(ActionParameters.Contract) Then
		SourceOfFilling = ActionParameters.Contract;
	ElsIf ValueIsFilled(ActionParameters.Terms) Then
		SourceOfFilling = ActionParameters.Terms;
	Else
		SourceOfFilling = ActionParameters.Partner;
	EndIf;
	
	ReturnValue = New Structure;
	ReturnValue.Insert("SourceOfFilling", SourceOfFilling);
	ReturnValue.Insert("TypeOfFillingSource", TypeOf(SourceOfFilling));
	
	Return ReturnValue;
	
EndFunction

Function TextOfSalesTermsAndConditionsSourceRequest(DescriptionOfFillingSource)
	
	If DescriptionOfFillingSource.TypeOfFillingSource = Type("CatalogRef.TermsOfSale") Then
		
		QueryText =
		"SELECT
		|	TermsOfSale.SpecialPriceType AS PriceKind,
		|	1 AS Priority
		|FROM
		|	Catalog.TermsOfSale AS TermsOfSale
		|WHERE
		|	TermsOfSale.Ref = &Terms
		|
		|UNION ALL
		|
		|SELECT
		|	TermsOfSale.PricesKind,
		|	2
		|FROM
		|	Catalog.TermsOfSale AS TermsOfSale
		|WHERE
		|	TermsOfSale.Ref = &Terms"; // @query-part
		
	ElsIf DescriptionOfFillingSource.TypeOfFillingSource = Type("CatalogRef.CounterpartyContracts") Then
		
		// Commission sales. The price type is determined by the Contract:
		QueryText =
		"SELECT
		|	CounterpartyContracts.SalesPriceType AS PriceKind,
		|	1 AS Priority
		|FROM
		|	Catalog.CounterpartyContracts AS CounterpartyContracts
		|WHERE
		|	CounterpartyContracts.Ref = &Contract
		|	AND &ThisIsSaleToEndCustomer
		|
		|UNION ALL
		|
		|SELECT
		|	CounterpartyContracts.PriceTypeAccountingPriceType AS PriceKind,
		|	2 AS Priority
		|FROM
		|	Catalog.CounterpartyContracts AS CounterpartyContracts
		|WHERE
		|	CounterpartyContracts.Ref = &Contract
		|	AND NOT &ThisIsSaleToEndCustomer"; // @query-part
		
	Else
		
		QueryText =
		"SELECT
		|	Partners.SpecialPriceType AS PriceKind,
		|	1 AS Priority
		|FROM
		|	Catalog.Partners AS Partners
		|WHERE
		|	Partners.Ref = &Partner
		|
		|UNION ALL
		|
		|SELECT
		|	Partners.PricesKind,
		|	2
		|FROM
		|	Catalog.Partners AS Partners
		|WHERE
		|	Partners.Ref = &Partner"; // @query-part
		
	EndIf;
	
	Return QueryText;
	
EndFunction

Function QueryTextPathToSourcePriceTypeFieldSalesConditions(DescriptionOfFillingSource)
	
	If DescriptionOfFillingSource.TypeOfFillingSource = Type("CatalogRef.Partners") Then
		
		QueryText = 
		"CASE
		|		WHEN TemporaryTableTypesOfPrices.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		OR TemporaryTableTypesOfPrices.PriceKind IS NULL
		|			THEN FilterTable.PriceKind
		|		ELSE TemporaryTableTypesOfPrices.PriceKind
		|	END"; // @query-part
		 
	Else // For Agreements and Contracts, the same algorithm for obtaining
		
		QueryText = "TemporaryTableTypesOfPrices.PriceKind"; // @query-part
		
	EndIf;
	
	Return QueryText;

EndFunction

Function QueryTextsSalesConditionsBatchProcessing(SalesConditionsForServices, ColumnsNames = Undefined)
	
	Result = New ValueList;
	
	If SalesConditionsForServices Then
		
		QueryText =
		"SELECT ALLOWED
		|	TTDataSource.IdOfTTRow AS IdOfTTRow,
		|	TTDataSource.Products AS Products,
		|	TTDataSource.Characteristic AS Characteristic,
		|	AgreementHeader_.Currency AS Currency,
		|	CASE
		|		WHEN ISNULL(AgreementHeader_.ConsignmentSales25, FALSE)
		|			THEN CASE
		|					WHEN CounterpartyContracts.Ref IS NULL
		|						THEN VALUE(Catalog.TypesOfPrices.EmptyRef)
		|					WHEN &ThisIsSaleToEndCustomer
		|						THEN CounterpartyContracts.SalesPriceType
		|					ELSE CounterpartyContracts.PriceTypeAccountingPriceType
		|				END
		|		WHEN ISNULL(AgreementGoods.Price, 0) > 0
		|			THEN VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		WHEN AgreementGoods.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		AND AgreementGoods.PriceKind IS NOT NULL
		|			THEN AgreementGoods.PriceKind
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		OR AgreementGoods.PriceKind IS NULL)
		|		AND AgreementPriceGroups.PricesKind IS NOT NULL
		|		AND AgreementPriceGroups.PricesKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			THEN AgreementPriceGroups.PricesKind
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		OR AgreementGoods.PriceKind IS NULL)
		|		AND (AgreementPriceGroups.PricesKind IS NULL
		|		OR AgreementPriceGroups.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef))
		|		AND AgreementHeader_.PricesKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			THEN AgreementHeader_.PricesKind
		|	END AS PriceKind,
		|	ISNULL(AgreementGoods.Price, 0) AS Price
		|INTO TemporaryTableTypesOfPrices
		|FROM
		|	TTDataSource AS TTDataSource
		|		LEFT JOIN Catalog.TermsOfSale AS AgreementHeader_
		|		ON (AgreementHeader_.Ref = &Terms)
		|		LEFT JOIN Catalog.Products AS CatalogProducts
		|		ON TTDataSource.Products = CatalogProducts.Ref
		|		LEFT JOIN Catalog.TermsOfSale.Goods AS AgreementGoods
		|		ON (AgreementHeader_.Ref = AgreementGoods.Ref)
		|		AND TTDataSource.Products = AgreementGoods.Products
		|		AND TTDataSource.Characteristic = AgreementGoods.Characteristic
		|		LEFT JOIN Catalog.TermsOfSale.PriceGroups AS AgreementPriceGroups
		|		ON (AgreementHeader_.Ref = AgreementPriceGroups.Ref)
		|		AND (CatalogProducts.Ref.PriceGroup = AgreementPriceGroups.PriceGroup)
		|		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		|		ON (CounterpartyContracts.Ref = &Contract)
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	PriceKind";
		
		Result.Add(QueryText, "TemporaryTableTypesOfPrices");
		
		QueryText =
		"SELECT
		|	Currency AS Currency,
		|	CourseNumerator AS CourseNumerator,
		|	CourseDenominator AS CourseDenominator
		|INTO TableOfExchangeRates
		|FROM
		|	InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS CurrencyRatesPrices
		|
		|INDEX BY
		|	Currency";
		
		Result.Add(QueryText, "TableOfExchangeRates");
		
		QueryText =
		"SELECT ALLOWED
		|	Products AS Products,
		|	Characteristic AS Characteristic,
		|	PriceKind AS PriceKind,
		|	Price AS Price,
		|	Package AS Package,
		|	Currency AS Currency
		|INTO TempTableOfItemPrices
		|FROM
		|	InformationRegister.ItemsPrices.SliceLast(ENDOFPERIOD(&Date, DAY), (Products, Characteristic, PriceKind) IN
		|		(SELECT
		|			TemporaryTableTypesOfPrices.Products,
		|			TemporaryTableTypesOfPrices.Characteristic,
		|			TemporaryTableTypesOfPrices.PriceKind
		|		FROM
		|			TemporaryTableTypesOfPrices AS TemporaryTableTypesOfPrices)) AS TableOfPricesCrossSectionOfLatest
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	PriceKind";
		
		Result.Add(QueryText, "TempTableOfItemPrices");
		
		QueryText =
		"SELECT ALLOWED
		|	TemporaryTableTypesOfPrices.IdOfTTRow AS IdOfTTRow,
		|	TemporaryTableTypesOfPrices.Currency AS Currency,
		|	TemporaryTableTypesOfPrices.PriceKind AS PriceKind,
		|	CASE
		|		WHEN TemporaryTableTypesOfPrices.Price > 0
		|			THEN TemporaryTableTypesOfPrices.Price * CASE
		|				WHEN &Currency <> TemporaryTableTypesOfPrices.Currency
		|					THEN CASE
		|						WHEN ISNULL(CutRatesAgreementCurrency.CourseDenominator, 0) > 0
		|						AND ISNULL(CutRatesAgreementCurrency.CourseNumerator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseDenominator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseNumerator, 0) > 0
		|							THEN CutRatesAgreementCurrency.CourseNumerator * CrossSectionRatesDocumentCurrency.CourseDenominator /
		|								(CrossSectionRatesDocumentCurrency.CourseNumerator * CutRatesAgreementCurrency.CourseDenominator)
		|						ELSE 0
		|					END
		|				ELSE 1
		|			END
		|		WHEN TemporaryTableTypesOfPrices.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		AND ISNULL(ItemPricesCrossSectionOfTheLatest.Price, 0) > 0
		|			THEN ItemPricesCrossSectionOfTheLatest.Price * CASE
		|				WHEN &Currency <> ItemPricesCrossSectionOfTheLatest.Currency
		|					THEN CASE
		|						WHEN ISNULL(RatesCutCurrencyPrices.CourseDenominator, 0) > 0
		|						AND ISNULL(RatesCutCurrencyPrices.CourseNumerator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseDenominator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseNumerator, 0) > 0
		|							THEN RatesCutCurrencyPrices.CourseNumerator * CrossSectionRatesDocumentCurrency.CourseDenominator /
		|								(CrossSectionRatesDocumentCurrency.CourseNumerator * RatesCutCurrencyPrices.CourseDenominator)
		|						ELSE 0
		|					END
		|				ELSE 1
		|			END
		|		ELSE 0
		|	END AS Price
		|FROM
		|	TemporaryTableTypesOfPrices AS TemporaryTableTypesOfPrices
		|		LEFT JOIN TempTableOfItemPrices AS ItemPricesCrossSectionOfTheLatest
		|		ON TemporaryTableTypesOfPrices.Products = ItemPricesCrossSectionOfTheLatest.Products
		|		AND TemporaryTableTypesOfPrices.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic
		|		AND TemporaryTableTypesOfPrices.PriceKind = ItemPricesCrossSectionOfTheLatest.PriceKind
		|		LEFT JOIN TableOfExchangeRates AS RatesCutCurrencyPrices
		|		ON (RatesCutCurrencyPrices.Currency = ItemPricesCrossSectionOfTheLatest.Currency)
		|		LEFT JOIN TableOfExchangeRates AS CrossSectionRatesDocumentCurrency
		|		ON CrossSectionRatesDocumentCurrency.Currency = &Currency
		|		LEFT JOIN TableOfExchangeRates AS CutRatesAgreementCurrency
		|		ON (CutRatesAgreementCurrency.Currency = TemporaryTableTypesOfPrices.Currency)";
		
		Result.Add(QueryText, "FillIn_TermsOfSales");
		
	Else
		
		QueryText =
		"SELECT ALLOWED
		|	TTDataSource.IdOfTTRow AS IdOfTTRow,
		|	TTDataSource.Products AS Products,
		|	TTDataSource.Characteristic AS Characteristic,
		|	AgreementHeader_.Currency AS Currency,
		|	CASE
		|		WHEN ISNULL(AgreementHeader_.ConsignmentSales25, FALSE)
		|			THEN CASE
		|					WHEN CounterpartyContracts.Ref IS NULL
		|						THEN VALUE(Catalog.TypesOfPrices.EmptyRef)
		|					WHEN &ThisIsSaleToEndCustomer
		|						THEN CounterpartyContracts.SalesPriceType
		|					ELSE CounterpartyContracts.PriceTypeAccountingPriceType
		|				END
		|		WHEN ISNULL(AgreementGoods.Price, 0) > 0
		|			THEN VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		WHEN AgreementGoods.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		AND AgreementGoods.PriceKind IS NOT NULL
		|			THEN AgreementGoods.PriceKind
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		OR AgreementGoods.PriceKind IS NULL)
		|		AND AgreementPriceGroups.PricesKind IS NOT NULL
		|		AND AgreementPriceGroups.PricesKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			THEN AgreementPriceGroups.PricesKind
		|		WHEN (AgreementGoods.PriceKind = VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		OR AgreementGoods.PriceKind IS NULL)
		|		AND (AgreementPriceGroups.PricesKind IS NULL
		|		OR AgreementPriceGroups.PricesKind = VALUE(Catalog.TypesOfPrices.EmptyRef))
		|		AND AgreementHeader_.PricesKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|			THEN AgreementHeader_.PricesKind
		|	END AS PriceKind,
		|	ISNULL(AgreementGoods.Price, 0) AS Price,
		|	&TextOfPackagingUnitField AS Package,
		|	&QueryTextPackagingFactor3 AS PackingRatioOfAgreement,
		|	CASE
		|		WHEN ISNULL(AgreementGoods.DeliveryPeriodDays, 0) > 0
		|			THEN AgreementGoods.DeliveryPeriodDays
		|		ELSE CASE
		|			WHEN ISNULL(AgreementPriceGroups.DeliveryPeriodDays, 0) > 0
		|				THEN AgreementPriceGroups.DeliveryPeriodDays
		|			ELSE AgreementHeader_.DeliveryPeriodDays
		|		END
		|	END AS DeliveryPeriodDays
		|INTO TemporaryTableTypesOfPrices
		|FROM
		|	TTDataSource AS TTDataSource
		|		LEFT JOIN Catalog.TermsOfSale AS AgreementHeader_
		|		ON (AgreementHeader_.Ref = &Terms)
		|		LEFT JOIN Catalog.Products AS CatalogProducts
		|		ON TTDataSource.Products = CatalogProducts.Ref
		|		LEFT JOIN Catalog.TermsOfSale.Goods AS AgreementGoods
		|		ON (AgreementHeader_.Ref = AgreementGoods.Ref)
		|		AND TTDataSource.Products = AgreementGoods.Products
		|		AND TTDataSource.Characteristic = AgreementGoods.Characteristic
		|		LEFT JOIN Catalog.TermsOfSale.PriceGroups AS AgreementPriceGroups
		|		ON (AgreementHeader_.Ref = AgreementPriceGroups.Ref)
		|		AND (CatalogProducts.Ref.PriceGroup = AgreementPriceGroups.PriceGroup)
		|		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		|		ON (CounterpartyContracts.Ref = &Contract)";
		
		If ValueIsFilled(ColumnsNames.ColumnNamePackaging) Then
			TextOfPackagingUnitField = StrTemplate("TTDataSource.%1", ColumnsNames.ColumnNamePackaging);
		Else
			TextOfPackagingUnitField = "AgreementGoods.Package";
		EndIf;
		
		QueryText = StrReplace(QueryText,
			"&TextOfPackagingUnitField",
			TextOfPackagingUnitField);
		
		QueryText = StrReplace(QueryText,
			"&QueryTextPackagingFactor3",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
				TextOfPackagingUnitField,
				"AgreementGoods.Products"));
		
		Result.Add(QueryText, "TemporaryTableTypesOfPrices");
		
		QueryText =
		"SELECT
		|	CurrencyRatesPrices.Currency AS Currency,
		|	CurrencyRatesPrices.CourseNumerator AS CourseNumerator,
		|	CurrencyRatesPrices.CourseDenominator AS CourseDenominator
		|INTO TableOfExchangeRates
		|FROM
		|	InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS CurrencyRatesPrices
		|
		|INDEX BY
		|	Currency";
		
		Result.Add(QueryText, "TableOfExchangeRates");
		
		QueryText =
		"SELECT ALLOWED
		|	TableOfPricesCrossSectionOfLatest.Products AS Products,
		|	TableOfPricesCrossSectionOfLatest.Characteristic AS Characteristic,
		|	TableOfPricesCrossSectionOfLatest.PriceKind AS PriceKind,
		|	TableOfPricesCrossSectionOfLatest.Price AS Price,
		|	TableOfPricesCrossSectionOfLatest.Package AS Package,
		|	TableOfPricesCrossSectionOfLatest.Currency AS Currency
		|INTO TempTableOfItemPrices
		|FROM
		|	InformationRegister.ItemsPrices.SliceLast(ENDOFPERIOD(&Date, DAY), (Products, Characteristic, PriceKind) IN
		|		(SELECT
		|			TemporaryTableTypesOfPrices.Products,
		|			TemporaryTableTypesOfPrices.Characteristic,
		|			TemporaryTableTypesOfPrices.PriceKind
		|		FROM
		|			TemporaryTableTypesOfPrices AS TemporaryTableTypesOfPrices)) AS TableOfPricesCrossSectionOfLatest
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	PriceKind";
		
		Result.Add(QueryText, "TempTableOfItemPrices");
		
		QueryText =
		"SELECT ALLOWED
		|	TemporaryTableTypesOfPrices.IdOfTTRow AS IdOfTTRow,
		|	TemporaryTableTypesOfPrices.Currency AS Currency,
		|	TemporaryTableTypesOfPrices.PriceKind AS PriceKind,
		|	CASE
		|		WHEN TemporaryTableTypesOfPrices.Price > 0
		|			THEN CASE
		|				WHEN TemporaryTableTypesOfPrices.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|					THEN &QueryTextPackagingFactor1
		|				ELSE 1
		|			END * TemporaryTableTypesOfPrices.Price / ISNULL(TemporaryTableTypesOfPrices.PackingRatioOfAgreement, 1) * CASE
		|				WHEN &Currency <> TemporaryTableTypesOfPrices.Currency
		|					THEN CASE
		|						WHEN ISNULL(CutRatesAgreementCurrency.CourseDenominator, 0) > 0
		|						AND ISNULL(CutRatesAgreementCurrency.CourseNumerator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseDenominator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseNumerator, 0) > 0
		|							THEN CutRatesAgreementCurrency.CourseNumerator * CrossSectionRatesDocumentCurrency.CourseDenominator /
		|								(CrossSectionRatesDocumentCurrency.CourseNumerator * CutRatesAgreementCurrency.CourseDenominator)
		|						ELSE 0
		|					END
		|				ELSE 1
		|			END
		|		WHEN TemporaryTableTypesOfPrices.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
		|		AND ISNULL(ItemPricesCrossSectionOfTheLatest.Price, 0) > 0
		|			THEN CASE
		|				WHEN TemporaryTableTypesOfPrices.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|					THEN &QueryTextPackagingFactor1
		|				ELSE 1
		|			END * ItemPricesCrossSectionOfTheLatest.Price / ISNULL(&QueryTextPackagingFactor2, 1) * CASE
		|				WHEN &Currency <> ItemPricesCrossSectionOfTheLatest.Currency
		|					THEN CASE
		|						WHEN ISNULL(RatesCutCurrencyPrices.CourseDenominator, 0) > 0
		|						AND ISNULL(RatesCutCurrencyPrices.CourseNumerator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseDenominator, 0) > 0
		|						AND ISNULL(CrossSectionRatesDocumentCurrency.CourseNumerator, 0) > 0
		|							THEN RatesCutCurrencyPrices.CourseNumerator * CrossSectionRatesDocumentCurrency.CourseDenominator /
		|								(CrossSectionRatesDocumentCurrency.CourseNumerator * RatesCutCurrencyPrices.CourseDenominator)
		|						ELSE 0
		|					END
		|				ELSE 1
		|			END
		|		ELSE 0
		|	END AS Price,
		|	TemporaryTableTypesOfPrices.DeliveryPeriodDays AS DeliveryPeriodDays
		|FROM
		|	TemporaryTableTypesOfPrices AS TemporaryTableTypesOfPrices
		|		LEFT JOIN TempTableOfItemPrices AS ItemPricesCrossSectionOfTheLatest
		|		ON TemporaryTableTypesOfPrices.Products = ItemPricesCrossSectionOfTheLatest.Products
		|		AND TemporaryTableTypesOfPrices.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic
		|		AND TemporaryTableTypesOfPrices.PriceKind = ItemPricesCrossSectionOfTheLatest.PriceKind
		|		LEFT JOIN TableOfExchangeRates AS RatesCutCurrencyPrices
		|		ON (RatesCutCurrencyPrices.Currency = ItemPricesCrossSectionOfTheLatest.Currency)
		|		LEFT JOIN TableOfExchangeRates AS CrossSectionRatesDocumentCurrency
		|		ON CrossSectionRatesDocumentCurrency.Currency = &Currency
		|		LEFT JOIN TableOfExchangeRates AS CutRatesAgreementCurrency
		|		ON (CutRatesAgreementCurrency.Currency = TemporaryTableTypesOfPrices.Currency)";
			
		QueryText = StrReplace(QueryText,
			"&QueryTextPackagingFactor1",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
				"CAST(TemporaryTableTypesOfPrices.Package AS Catalog.PackagesAndUnitsOfMeasure)",
				"CAST(TemporaryTableTypesOfPrices.Products AS Catalog.Products)"));
		
		QueryText = StrReplace(QueryText,
			"&QueryTextPackagingFactor2",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
				"ItemPricesCrossSectionOfTheLatest.Package",
				"ItemPricesCrossSectionOfTheLatest.Products"));
		
		Result.Add(QueryText, "FillIn_TermsOfSales");
		
	EndIf;
	
	Return Result;
	
EndFunction

Function QueryTextsSalesConditions25BatchProcessing(SalesConditionsForServices, ActionParameters, CachedValues)
	
	Result = New ValueList;
	
	If SalesConditionsForServices Then
		
		QueryText =
		"SELECT ALLOWED
		|	GoodsTable.IdOfTTRow AS IdOfTTRow,
		|	&PriceTypeField AS PriceKind,
		|	GoodsTable.Products AS Products,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
		|	ISNULL(CASE
		|		WHEN TableOfProductTypes.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
		|			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		|		ELSE CharacteristicTable.ItemsCharacteristicForPricing
		|	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
		|	ISNULL(CASE
		|		WHEN TableOfProductTypes.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
		|			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		|		ELSE TableOfSeries.ItemsBatchForPricing
		|	END, VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)) AS PricingBatch,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage
		|INTO TableProductsDOP
		|FROM
		|	TTDataSource AS GoodsTable
		|		LEFT JOIN Catalog.Products AS ProductsTable
		|		ON GoodsTable.Products = ProductsTable.Ref
		|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicTable
		|		ON GoodsTable.Characteristic = CharacteristicTable.Ref
		|		LEFT JOIN Catalog.ItemsBatches AS TableOfSeries
		|		ON &FieldSeries = TableOfSeries.Ref
		|		LEFT JOIN Catalog.ItemKinds AS TableOfProductTypes
		|		ON ProductsTable.ProductKind = TableOfProductTypes.Ref
		|
		|INDEX BY
		|	Products,
		|	PricingVariant,
		|	PricingBatch,
		|	PricingPackage,
		|	PriceKind";
		
	Else
		
		QueryText =
		"SELECT ALLOWED
		|	GoodsTable.IdOfTTRow AS IdOfTTRow,
		|	&PriceTypeField AS PriceKind,
		|	GoodsTable.Products AS Products,
		|	GoodsTable.Package AS Package,
		|	ISNULL(CASE
		|		WHEN TableOfProductTypes.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
		|			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		|		ELSE CharacteristicTable.ItemsCharacteristicForPricing
		|	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
		|	ISNULL(CASE
		|		WHEN TableOfProductTypes.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
		|			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		|		ELSE TableOfSeries.ItemsBatchForPricing
		|	END, VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)) AS  PricingBatch,
		|	CASE
		|		WHEN
		|			TableOfProductTypes.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
		|			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|		ELSE GoodsTable.Package
		|	END AS PricingPackage
		|INTO TableProductsDOP
		|FROM
		|	TTDataSource AS GoodsTable
		|		LEFT JOIN Catalog.Products AS ProductsTable
		|		ON GoodsTable.Products = ProductsTable.Ref
		|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicTable
		|		ON GoodsTable.Characteristic = CharacteristicTable.Ref
		|		LEFT JOIN Catalog.ItemsBatches AS TableOfSeries
		|		ON &FieldSeries = TableOfSeries.Ref
		|		LEFT JOIN Catalog.ItemKinds AS TableOfProductTypes
		|		ON ProductsTable.ProductKind = TableOfProductTypes.Ref
		|
		|INDEX BY
		|	Products,
		|	PricingVariant,
		|	PricingBatch,
		|	PricingPackage,
		|	PriceKind";
		
	EndIf;
	
	If BatchProcessingOfTablePartServer.ThereIsColumnInDataSource("PriceKind", CachedValues) Then
		PriceTypeField = "GoodsTable.PriceKind";
	Else
		PriceTypeField = "VALUE(Catalog.TypesOfPrices.EmptyRef)";
	EndIf;
	
	QueryText = StrReplace(QueryText,
		"&PriceTypeField",
		PriceTypeField);
	
	If BatchProcessingOfTablePartServer.ThereIsColumnInDataSource("Series", CachedValues) Then
		FieldSeries = "GoodsTable.Series";
	Else
		FieldSeries = "VALUE(Catalog.ItemsBatches.EmptyRef)";
	EndIf;
	
	QueryText = StrReplace(QueryText,
		"&FieldSeries",
		FieldSeries);
	
	Result.Add(QueryText, "TableProductsDOP");
	
	QueryText =
	"SELECT
	|	NestedQuery.PriceKind AS PriceKind,
	|	MIN(NestedQuery.Priority) AS Priority
	|INTO TemporaryTableTypesOfPrices
	|FROM
	|	&TextOfSalesTermsAndConditionsSourceRequest AS NestedQuery
	|WHERE
	|	NestedQuery.PriceKind <> VALUE(Catalog.TypesOfPrices.EmptyRef)
	|GROUP BY
	|	NestedQuery.PriceKind";
	
	DescriptionOfFillingSource = DescriptionOfSourceOfFillingInSalesConditions(ActionParameters);
	
	TextOfSalesTermsAndConditionsSourceRequest = StrTemplate(
		"(%1)",
		TextOfSalesTermsAndConditionsSourceRequest(DescriptionOfFillingSource));
	
	QueryText = StrReplace(QueryText,
		"&TextOfSalesTermsAndConditionsSourceRequest",
		TextOfSalesTermsAndConditionsSourceRequest);
	
	Result.Add(QueryText, "TemporaryTableTypesOfPrices");
	
	QueryText = 
	"SELECT
	|	ISNULL(MAX(TemporaryTableTypesOfPrices.Priority), 0) + 1 AS Value
	|INTO LowPriorityShift
	|FROM
	|	TemporaryTableTypesOfPrices AS TemporaryTableTypesOfPrices";
	Result.Add(QueryText, "LowPriorityShift");
	
	QueryText =
	"SELECT
	|	FilterTable.IdOfTTRow AS IdOfTTRow,
	|	FilterTable.Products AS Products,
	|	FilterTable.Package AS Package,
	|	FilterTable.PricingVariant AS PricingVariant,
	|	FilterTable.PricingBatch AS PricingBatch,
	|	FilterTable.PricingPackage AS PricingPackage,
	|	&ValueOfSourcePriceType AS PriceKind,
	|	ISNULL(MIN(TemporaryTableTypesOfPrices.Priority), 0) AS Priority
	|INTO FilterTable
	|FROM
	|	TableProductsDOP AS FilterTable
	|		LEFT JOIN TemporaryTableTypesOfPrices AS TemporaryTableTypesOfPrices
	|		ON (TRUE)
	|GROUP BY
	|	FilterTable.IdOfTTRow,
	|	FilterTable.Products,
	|	FilterTable.Package,
	|	FilterTable.PricingVariant,
	|	FilterTable.PricingBatch,
	|	FilterTable.PricingPackage,
	|	&ValueOfSourcePriceType
	|
	|INDEX BY
	|	IdOfTTRow,
	|	Products,
	|	Package,
	|	PricingVariant,
	|	PricingBatch,
	|	PricingPackage,
	|	PriceKind";
	
	QueryText = StrReplace(QueryText,
		"&ValueOfSourcePriceType",
		QueryTextPathToSourcePriceTypeFieldSalesConditions(DescriptionOfFillingSource));
	
	Result.Add(QueryText, "FilterTable");
	
	QueryText =
	"SELECT
	|	CurrencyRatesPrices.Currency AS Currency,
	|	CurrencyRatesPrices.CourseNumerator AS CourseNumerator,
	|	CurrencyRatesPrices.CourseDenominator AS CourseDenominator
	|INTO TableOfExchangeRates
	|FROM
	|	InformationRegister.RelativeExchangeRates.SliceLast(&Date, BaseCurrency = &BaseCurrency) AS CurrencyRatesPrices
	|
	|INDEX BY
	|	Currency";
	
	Result.Add(QueryText, "TableOfExchangeRates");
	
	QueryText =
	"SELECT ALLOWED
	|	Price_Table.Products AS Products,
	|	Price_Table.PricingVariant AS PricingVariant,
	|	Price_Table.PricingBatch AS PricingBatch,
	|	Price_Table.Package AS Package,
	|	Price_Table.PricingPackage AS PricingPackage,
	|	Price_Table.PriceKind AS PriceKind,
	|	Price_Table.Currency AS Currency,
	|	Price_Table.Price AS Price
	|INTO ItemPricesCrossSectionOfTheLatest
	|FROM
	|	InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&Date, DAY), (Products, PricingVariant, PricingBatch,
	|		PricingPackage, PriceKind) IN
	|		(SELECT
	|			FilterTable.Products,
	|			FilterTable.PricingVariant,
	|			FilterTable.PricingBatch,
	|			FilterTable.PricingPackage,
	|			FilterTable.PriceKind
	|		FROM
	|			FilterTable AS FilterTable)) AS Price_Table
	|
	|INDEX BY
	|	Products,
	|	PricingVariant,
	|	PricingBatch,
	|	PricingPackage,
	|	PriceKind";
	
	Result.Add(QueryText, "ItemPricesCrossSectionOfTheLatest");
	
	QueryText =
	"SELECT ALLOWED
	|	FilterTable.IdOfTTRow AS IdOfTTRow,
	|	ISNULL(&QueryTextPackagingFactor1, 1) * ISNULL(ItemPricesCrossSectionOfTheLatest.Price, 0) /
	|		ISNULL(&QueryTextPackagingFactor2, 1) * CASE
	|		WHEN &Currency <> ItemPricesCrossSectionOfTheLatest.Currency
	|			THEN CASE
	|				WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) > 0
	|				AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) > 0
	|				AND ISNULL(Currency_Rates.CourseDenominator, 0) > 0
	|				AND ISNULL(Currency_Rates.CourseNumerator, 0) > 0
	|					THEN CurrencyRatesPrices.CourseNumerator * Currency_Rates.CourseDenominator / (Currency_Rates.CourseNumerator *
	|						CurrencyRatesPrices.CourseDenominator)
	|				ELSE 0
	|			END
	|		ELSE 1
	|	END AS Price,
	|	FilterTable.PriceKind AS PriceKind,
	|	FilterTable.Products AS Products,
	|	FilterTable.PricingVariant AS PricingVariant,
	|	FilterTable.PricingBatch AS PricingBatch,
	|	FilterTable.PricingPackage AS PricingPackage,
	|	FilterTable.Priority
	|	// If the price is not found, then you need to fill in the price type and the empty price. Such filling should have a lower priority of filling
	|		+ CASE WHEN ItemPricesCrossSectionOfTheLatest.Products IS NULL THEN 
	|			LowPriorityShift.Value 
	|		ELSE
	|			0
	|		END AS Priority
	|INTO ResultTable2
	|FROM
	|	FilterTable AS FilterTable
	|		LEFT JOIN ItemPricesCrossSectionOfTheLatest AS ItemPricesCrossSectionOfTheLatest
	|		ON FilterTable.Products = ItemPricesCrossSectionOfTheLatest.Products
	|		AND FilterTable.PricingVariant = ItemPricesCrossSectionOfTheLatest.PricingVariant
	|		AND FilterTable.PricingBatch = ItemPricesCrossSectionOfTheLatest.PricingBatch
	|		AND FilterTable.PricingPackage = ItemPricesCrossSectionOfTheLatest.PricingPackage
	|		AND FilterTable.PriceKind = ItemPricesCrossSectionOfTheLatest.PriceKind
	|		LEFT JOIN TableOfExchangeRates AS CurrencyRatesPrices
	|		ON ItemPricesCrossSectionOfTheLatest.Currency = CurrencyRatesPrices.Currency
	|		LEFT JOIN TableOfExchangeRates AS Currency_Rates
	|		ON Currency_Rates.Currency = &Currency
	|		LEFT JOIN LowPriorityShift AS LowPriorityShift
	|		ON TRUE
	|
	|INDEX BY
	|	IdOfTTRow,
	|	Products,
	|	PricingVariant,
	|	PricingBatch,
	|	PricingPackage,
	|	PriceKind";
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor1",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"CAST(FilterTable.Package AS Catalog.PackagesAndUnitsOfMeasure)",
			"CAST(FilterTable.Products AS Catalog.Products)"));
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor2",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"ItemPricesCrossSectionOfTheLatest.Package",
			"ItemPricesCrossSectionOfTheLatest.Products"));
		
	Result.Add(QueryText, "ResultTable2");
	
	QueryText =
	"SELECT
	|	ResultTable2.IdOfTTRow AS IdOfTTRow,
	|	MIN(ResultTable2.Priority) AS Priority
	|INTO ResultTablePriorities
	|FROM
	|	ResultTable2 AS ResultTable2
	|GROUP BY
	|	ResultTable2.IdOfTTRow
	|
	|INDEX BY
	|	IdOfTTRow";
	
	Result.Add(QueryText, "ResultTablePriorities");
	
	QueryText =
	"SELECT
	|	ResultTable2.IdOfTTRow AS IdOfTTRow,
	|	ResultTable2.PriceKind AS PriceKind,
	|	ResultTable2.Price AS Price
	|INTO FillIn_TermsOfSalesPreliminary
	|FROM
	|	ResultTable2 AS ResultTable2
	|WHERE
	|	(ResultTable2.IdOfTTRow, ResultTable2.Priority) IN
	|		(SELECT
	|			Priorities.IdOfTTRow AS IdOfTTRow,
	|			Priorities.Priority AS Priority
	|		FROM
	|			ResultTablePriorities AS Priorities)
	|
	|INDEX BY
	|	IdOfTTRow";
	
	Result.Add(QueryText, "FillIn_TermsOfSalesPreliminary");
	
	QueryText =
	"SELECT
	|	TTDataSource.IdOfTTRow AS IdOfTTRow,
	|	ISNULL(TablePreliminary.PriceKind, VALUE(Catalog.TypesOfPrices.EmptyRef)) AS PriceKind,
	|	ISNULL(TablePreliminary.Price, 0) AS Price
	|FROM
	|	TTDataSource AS TTDataSource
	|		LEFT JOIN FillIn_TermsOfSalesPreliminary AS TablePreliminary
	|		ON TTDataSource.IdOfTTRow = TablePreliminary.IdOfTTRow";
	
	Result.Add(QueryText, "FillIn_TermsOfSales");
	
	Return Result;
	
EndFunction

