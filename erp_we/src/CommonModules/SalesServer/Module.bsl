			ErrorAddress = StrReplace(ErrorAddress, "%PresentationOfTS%", PresentationOfTS);

			If ValueIsFilled(Selection.Characteristic) Then

				ErrorText = NStr("vi = 'Mặt hàng ""%Products%"" với đặc tính ""%Characteristic%"" 
				| phải thuộc phân khúc mặt hàng ""%ProductSegment%"" xác định trong thỏa thuận';
