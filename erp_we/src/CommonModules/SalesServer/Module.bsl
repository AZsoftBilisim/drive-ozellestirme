Function ThisIsContractForNewCommission(Contract) Export
	
	SetPrivilegedMode(True);

	Result = ValueIsFilled(Contract)
		And Common.ObjectAttributeValue(Contract, "ConsignmentSales25");

	SetPrivilegedMode(False);
		
	Return Result;
	
