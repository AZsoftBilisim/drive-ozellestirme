// Returns the request text for filling in the table parts of documents for the actual shipment.
//	
//	Parameters:
//		QueryResultStructure - Structure - variable that the structure of query results is written to.
//
// Returns:
//		String - query text.
//
Function RequestTextForActualShipment(StructureOfDocumentToFillIn, QueryResultStructure = Undefined)
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.BeginOfPeriod = "&InitialCustomerOrders";
	TableFormationParameters.EndOfPeriod = "&ConPeriodCustomerOrders";
	TableFormationParameters.Periodicity = "Recorder";
	TableFormationParameters.ConditionText =
		"ReferenceOrder IN (&ShippingDocuments)";
	TableFormationParameters.Group = "Recorder, ReferenceOrder, Products, Characteristic, RowCode, Warehouse, Series";
	TableFormationParameters.Indicators = "Shipped";
	TableFormationParameters.Resources = "Count";
	TableFormationParameters.Indexes = "ReferenceOrder, Products, Characteristic, RowCode";
	TableFormationParameters.TempTableName = "TT_ShipmentOrdersTurnoverExpanded1";
	
	TT_ShipmentOrdersTurnoverExpanded1 =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.BeginOfPeriod = "&InitialOSTAndOBCustomerOrders";
	TableFormationParameters.EndOfPeriod = "&ConPeriodCustomerOrdersOSTAndOB";
	TableFormationParameters.ConditionText =
		"ReferenceOrder IN (&ShippingDocuments)
		|		AND RowCode <> 0";
	TableFormationParameters.Group = "";
	TableFormationParameters.Indicators = "ToShip, Shipped";
	TableFormationParameters.Resources = "Count, Sum";
	TableFormationParameters.Indexes = "ReferenceOrder, Products, Characteristic, RowCode";
	TableFormationParameters.TempTableName = "TT_ShipmentOrdersTurnoverExpanded2";
	
	TT_ShipmentOrdersTurnoverExpanded2 =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	TableFormationParameters = AccumulationRegisters.ShipmentAndReturnReferences.NewParametersForCreatingExpandedTable();
	TableFormationParameters.BeginOfPeriod = "&InitialOSTAndOBCustomerOrders";
	TableFormationParameters.EndOfPeriod = "&ConPeriodCustomerOrdersOSTAndOB";
	TableFormationParameters.Periodicity = "Recorder";
	TableFormationParameters.ConditionText =
		"ReferenceOrder IN (&ShippingDocuments)
		|		AND RowCode <> 0";
	TableFormationParameters.Group = "Recorder, ReferenceOrder, Products, Characteristic, RowCode, Warehouse, Series";
	TableFormationParameters.Indicators = "Shipped";
	TableFormationParameters.Resources = "Count, Sum";
	TableFormationParameters.Indexes = "ReferenceOrder, Products, Characteristic, RowCode";
	TableFormationParameters.TempTableName = "TT_ShipmentOrdersTurnoverExpanded3";
	
	TT_ShipmentOrdersTurnoverExpanded3 =
		AccumulationRegisters.ShipmentAndReturnReferences.QueryTextExpandedTable(
			TableFormationParameters);
	
	QueryText = 
	"SELECT
	|	CAST(Goods.LineNumber AS NUMBER) AS LineNumber,
	|	CAST(Goods.Products AS Catalog.Products) AS Products,
	|	CAST(Goods.Characteristic AS Catalog.ItemsCharacteristics) AS Characteristic,
	|	CAST(Goods.Package AS Catalog.PackagesAndUnitsOfMeasure) AS Package,
	|	CAST(Goods.Warehouse AS Catalog.Warehouses) AS Warehouse,
	|	CAST(Goods.Series AS Catalog.ItemsBatches) AS Series,
	|	CAST(Goods.Purpose AS Catalog.Assignments) AS Purpose
	|INTO TT_ProductsToRequest
	|FROM
	|	&Goods AS Goods
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.LineNumber AS LineNumber,
	|	Goods.Products AS Products,
	|	Goods.Characteristic AS Characteristic,
	|	Goods.Package AS Package,
	|	Goods.Warehouse AS Warehouse,
	|	Goods.Series AS Series,
	|	Goods.Purpose AS Purpose
	|INTO TT_Goods
	|FROM
	|	TT_ProductsToRequest AS Goods
	|WHERE
	|	Goods.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND ISNULL(Goods.Warehouse.UseWarehouseManagemantSystemForGoodsIssue, FALSE)
	|	AND &Date >= ISNULL(Goods.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue, DATETIME(1, 1, 1))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForShipmentTurnover.DocumentShipments AS DocumentShipments,
	|	GoodsForShipmentTurnover.Series AS Series,
	|	GoodsForShipmentTurnover.Purpose AS Purpose,
	|	GoodsForShipmentTurnover.Products AS Products,
	|	GoodsForShipmentTurnover.Characteristic AS Characteristic,
	|	GoodsForShipmentTurnover.Warehouse AS Warehouse,
	|	CASE
	|		WHEN &FillWithUnassembledGoods
	|			THEN SUM(GoodsForShipmentTurnover.AssemblyInProgressReceipt)
	|		ELSE 0
	|	END + SUM(GoodsForShipmentTurnover.ToShipExpense) + SUM(GoodsForShipmentTurnover.AssembledReceipt) AS QuantityToShip_,
	|	CAST(GoodsForShipmentTurnover.Recorder AS Document.GoodsIssueNote) AS WarehouseDocument
	|INTO TTGoodsForShipment
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers(&InitialGoodsForShipment, &ConPeriodGoodsReadyForShipment , Recorder, DocumentShipments IN (&ShippingDocuments)) AS GoodsForShipmentTurnover
	|WHERE
	|	ISNULL(GoodsForShipmentTurnover.Warehouse.UseWarehouseManagemantSystemForGoodsIssue, FALSE)
	|	AND &Date >= ISNULL(GoodsForShipmentTurnover.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue, DATETIME(1, 1, 1))
	|
	|GROUP BY
	|	GoodsForShipmentTurnover.DocumentShipments,
	|	GoodsForShipmentTurnover.Products,
	|	GoodsForShipmentTurnover.Characteristic,
	|	GoodsForShipmentTurnover.Series,
	|	GoodsForShipmentTurnover.Purpose,
	|	CAST(GoodsForShipmentTurnover.Recorder AS Document.GoodsIssueNote),
	|	GoodsForShipmentTurnover.Warehouse
	|
	|HAVING
	|	CASE
	|		WHEN &FillWithUnassembledGoods
	|			THEN SUM(GoodsForShipmentTurnover.AssemblyInProgressReceipt)
	|		ELSE 0
	|	END + SUM(GoodsForShipmentTurnover.ToShipExpense) + SUM(GoodsForShipmentTurnover.AssembledReceipt) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" +
	TT_ShipmentOrdersTurnoverExpanded1 +
	Common.QueryBatchSeparator() + "
	|SELECT
	|	OrdersBalance.ReferenceOrder AS SalesOrder,
	|	OrdersBalance.Products AS Products,
	|	OrdersBalance.Characteristic AS Characteristic,
	|	OrdersBalance.Warehouse AS Warehouse,
	|	OrdersBalance.Series AS Series,
	|	CASE
	|		WHEN OrderingProducts.WithAssignment THEN
	|			OrderingProducts.Ref.Purpose
	|		WHEN OrderGoodsReplacement.WithAssignment THEN
	|			OrderGoodsReplacement.Ref.Purpose
	|		WHEN ISNULL(GiverSOrder2_5Products.WithAssignment, FALSE)
	|			THEN GiverSOrder2_5Products.Ref.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END AS Purpose,
	|	SUM(OrdersBalance.ShippedQuantityTurnover) AS QuantityInInvoices
	|INTO TTGoodsInInvoices
	|FROM
	|	TT_ShipmentOrdersTurnoverExpanded1 AS OrdersBalance
	|		LEFT JOIN Document.SalesOrder.Goods AS OrderingProducts
	|		ON OrdersBalance.Products = OrderingProducts.Products
	|			AND OrdersBalance.Characteristic = OrderingProducts.Characteristic
	|			AND OrdersBalance.RowCode = OrderingProducts.RowCode
	|			AND OrdersBalance.ReferenceOrder = OrderingProducts.Ref
	|		LEFT JOIN Document.RequestForReturnOfGoodsFromCustomer.SubstituteGoods AS OrderGoodsReplacement
	|		ON OrdersBalance.Products = OrderGoodsReplacement.Products
	|			AND OrdersBalance.Characteristic = OrderGoodsReplacement.Characteristic
	|			AND OrdersBalance.RowCode = OrderGoodsReplacement.RowCode
	|			AND OrdersBalance.ReferenceOrder = OrderGoodsReplacement.Ref
	|		LEFT JOIN Document.MaterialProviderOrder2_5.ManufacturedProduct AS GiverSOrder2_5Products
	|		ON OrdersBalance.Products   = GiverSOrder2_5Products.Products
	|		 AND OrdersBalance.Characteristic = GiverSOrder2_5Products.Characteristic
	|		 AND OrdersBalance.RowCode      = GiverSOrder2_5Products.RowCode
	|		 AND OrdersBalance.ReferenceOrder   = GiverSOrder2_5Products.Ref
	|WHERE
	|	OrdersBalance.Recorder <> &Invoice
	|	AND ISNULL(ReferenceOrder.Warehouse.UseWarehouseManagemantSystemForGoodsIssue, FALSE)
	|	AND &Date >= ISNULL(ReferenceOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue, DATETIME(1, 1, 1))
	|	AND (GiverSOrder2_5Products.Ref IS NULL OR NOT GiverSOrder2_5Products.Canceled)
	|
	|GROUP BY
	|	OrdersBalance.ReferenceOrder,
	|	OrdersBalance.Products,
	|	OrdersBalance.Characteristic,
	|	OrdersBalance.Warehouse,
	|	OrdersBalance.Series,
	|	CASE
	|		WHEN OrderingProducts.WithAssignment THEN
	|			OrderingProducts.Ref.Purpose
	|		WHEN OrderGoodsReplacement.WithAssignment THEN
	|			OrderGoodsReplacement.Ref.Purpose
	|		WHEN ISNULL(GiverSOrder2_5Products.WithAssignment, FALSE)
	|			THEN GiverSOrder2_5Products.Ref.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END
	|
	|HAVING
