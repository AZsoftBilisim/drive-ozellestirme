#Region ProceduresForGeneratingRequestsToVerifyComplianceOfDocumentsWithSalesConditions

// Generates a request to check the header of the sales document
//
// Parameters:
// QueryText - String - text string to which you want to add the query text
// TableName   - String - the table name of the document to which you want to generate a validation request.
//
Procedure GenerateSalesDocumentHeaderRequest(QueryText, TableName)

	QueryText = QueryText + "
	|SELECT
	|	CASE
	|		WHEN CustomerTermsOfSales.Partner IS NOT NULL AND
	|			CustomerTermsOfSales.Standard_ = FALSE AND
	|			DocumentSales.Partner <> CustomerTermsOfSales.Partner
	|		THEN
	|			TRUE
	|		ELSE
	|			FALSE
	|	END AS ThereAreErrorsInFillingOutPartner,
	|	CASE
	|		WHEN CustomerTermsOfSales.Status IS NOT NULL AND
	|			CustomerTermsOfSales.Status = VALUE(Enum.StatusesOfTermsOfSales.NotApproved)
	|		THEN
	|			TRUE
	|		ELSE
	|			FALSE
	|	END AS ThereAreErrorsAgreementStatus,
	|	CASE
	|		WHEN CustomerTermsOfSales.Organization IS NOT NULL AND
	|			CustomerTermsOfSales.Organization <> VALUE(Catalog.Companies.EmptyRef) AND
	|			DocumentSales.Organization <> CustomerTermsOfSales.Organization
	|		THEN
	|			TRUE
	|		ELSE
	|			FALSE
	|	END AS ThereAreErrorsInFillingOutOrganization,
	|	&ReplacementText13,
	|	ISNULL(CustomerTermsOfSales.Warehouse.IsFolder, FALSE) AS WarehouseAgreementIsGroup,
	|	&ReplacementText1,
	|	&ReplacementText2,
	|	&ReplacementText3,
	|	FALSE AS ThereAreErrorsPaymentDate,
	|	&ReplacementText4,
	|
	|	// Checks for trade agreements only
	|
	|	&ReplacementText5,
	|
	|	// Checks for agreements only
	|
	|	&ReplacementText6,
	|	&ReplacementText7,
	|	&ReplacementText8,
	|	&ReplacementText9,
	|	DocumentSales.Terms,
	|	CustomerTermsOfSales.Partner                                 AS PartnerAgreement_1,
	|	CustomerTermsOfSales.MinimumOrderAmount                  AS MinimumOrderAmount,
	|	CustomerTermsOfSales.Counterparty                              AS CounterpartyTerms,
	|	CustomerTermsOfSales.Organization                             AS OrganizationAgreement,
	|	DocumentSales.Currency                                      AS Currency,
	|	DocumentSales.Date                                        AS Date,
	|	DocumentSales.DocumentAmount                              AS DocumentAmount,
	|	CustomerTermsOfSales.Currency                                  AS CurrencyAgreement,
	|	&ReplacementText10,
	|	&ReplacementText11,
	|	CustomerTermsOfSales.Warehouse                                   AS WarehouseAgreement,
	|	CustomerTermsOfSales.PricesKind                                  AS PriceTypeAgreement,
	|	CustomerTermsOfSales.PriceIncludesVAT                         AS PriceIncludesVATAgreement,
	|	CustomerTermsOfSales.BusinessOperation                   AS BusinessTransactionAgreement,
	|	&ReplacementText12,
	|	CustomerTermsOfSales.Status                                  AS StatusAgreement,
	|	CustomerTermsOfSales.ValidityStartDate                      AS StartDateOfAgreement,
	|	CustomerTermsOfSales.ValidityEndDate                   AS ExpirationDateOfAgreement,
	|	CustomerTermsOfSales.PaymentSchedule                            AS PaymentScheduleAgreement,
	|	CustomerTermsOfSales.ReusablePackageReturnCycleLength          AS ReusablePackageReturnCycleLength,
	|	CustomerTermsOfSales.CalculatePackageReturnDateAccordingToCalendar AS CalculatePackageReturnDateAccordingToCalendar,
	|	CustomerTermsOfSales.ContractsAreUsed        AS ContractsAreUsed,
	|	&ThisIsConvention                                              AS ThisIsConvention,
	|	&ReturnOfMultiTurnContainers                                  AS ReturnOfMultiTurnContainers
	|FROM
	|	TemporaryTableSalesDocument           AS DocumentSales
	|LEFT JOIN
	|	Catalog.TermsOfSale              AS CustomerTermsOfSales
	|ON
	|	DocumentSales.Terms = CustomerTermsOfSales.Ref
	|LEFT JOIN
	|	WarehousesAreCorrectByAgreement AS WarehousesAreCorrectByAgreement
	|ON 
	|	DocumentSales.Warehouse = WarehousesAreCorrectByAgreement.Warehouse
	|;
	|";
	
	//replacing query variables
	QueryText = StrReplace(QueryText, "&ReplacementText1,", ?(TableName = "Document.CustomerInvoiceServices","
	|	FALSE AS ThereAreErrorsFillingWarehouse,
	|	FALSE AS ThereAreFillingErrorsToReturnMultiTurnContainer,
	|	FALSE AS ThereAreFillingErrorsDepositForContainerIsRequired,
	|","
	|	CASE
	|		WHEN CustomerTermsOfSales.Warehouse IS NOT NULL
	|			AND CustomerTermsOfSales.Warehouse <> VALUE(Catalog.Warehouses.EmptyRef)
	|			AND WarehousesAreCorrectByAgreement.Warehouse IS NULL
	|		THEN TRUE
	|		ELSE FALSE
	|	END AS ThereAreErrorsFillingWarehouse,
	|	CASE
	|		WHEN CustomerTermsOfSales.ReturnReusablePackage <> &ReturnOfMultiTurnContainers
	|			AND DocumentSales.BusinessOperation <> VALUE(Enum.BusinessTransactions.ReturnFromRetailCustomer)
	|		THEN TRUE
	|		ELSE FALSE
	|	END AS ThereAreFillingErrorsToReturnMultiTurnContainer,
