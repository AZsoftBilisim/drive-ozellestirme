																									|en = 'Prepayment'; fa = 'پیش‌پرداخت';
																									|it = 'Prepagamento';
																									|pl = 'Prepayment';
																									|tr = 'Ön ödeme'"), ErrorText, ArrayOfDeviations);
		Else
			ReportErrorToUser(
				ErrorText,
				DocumentSales,
				"TransferToPaymentCommand",
				Cancel);
		EndIf;
	EndIf;

EndProcedure

