#Region FormationOfSetOfDocuments

// Forms the structure of document tables based on the transmitted orders and parameters
// 
// Parameters:
// 		ComplianceWithOrders - See SalesClient.InitializeOrders
// 		GenerationParameters - See NewParametersForDesignOfSetOfDocuments
// 		
// Returns:
// 		Structure
//
Function ArrangeShipmentATServer(ComplianceWithOrders, GenerationParameters) Export

	Var ErrorList, NumberOfPackages_;
	
	DeleteDataFromSecureStorage("FormCreatedSalesDocuments");
	
	DocumentName = "";
	BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods;
		
	FormParameters = New Structure();
	FormParameters.Insert("IssueNumberOfInvoices", False);
	FormParameters.Insert("AddressDocumentsByInvoiceType", Undefined);
	
	ToSupplementStructureOfOrdersAndFormationParameters(ComplianceWithOrders, GenerationParameters);
		
	// the "To shipment" list
	If	GenerationParameters.NameOfShipmentCommand = "ArrangeShipmentByOrders"
			Or GenerationParameters.NameOfShipmentCommand = "ArrangeShipmentByOrder" Then
	
		DocumentName = "GoodsShipmentToCustomer";
		GenerationParameters.NewDocumentName = DocumentName;
		TablesByDocuments = ConvertMatchToTableOfValues(ComplianceWithOrders);	
		
		// Breakdown of selected documents into groups
		DocumentsByTypesOfInvoices = SplitOrdersByFullInvoiceNames(TablesByDocuments.TableOfOrders,
			TablesByDocuments.TheOrdersTable, GenerationParameters, ErrorList, NumberOfPackages_, True);
	
		If DocumentsByTypesOfInvoices.Count() > 0 Then
			If GenerationParameters.ByNotes Then
				
				// If one document is selected and there is at least one invoice, the invoice re-filling form opens.
				// If there are no invoices and the documents can be grouped into one invoice, a new invoice form opens.
				// If there are no invoices and the documents cannot be grouped, the form of the list of created invoices opens.
				
				ThereIsInvoice = ThereIsInvoice(DocumentsByTypesOfInvoices);
				ThereSWarrant     = ThereSWarrant(DocumentsByTypesOfInvoices);
				ThereIsOrder     = ThereIsOrder(DocumentsByTypesOfInvoices);
				
				TotalTables = DocumentsByTypesOfInvoices.Count();
				If TotalTables > 1 Then
				
				ElsIf DocumentsByTypesOfInvoices.Count() = 1 Then
				
					// Checking for invoices
					// If the current order is an order and there are invoices for it, open the re-filling form.
					If ThereIsInvoice And ThereIsOrder Then
						// Opening the re-filling form
						FormParameters = FillItOutUsingFillInForm(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList, DocumentName);
					Else
						// When trying to fill out an invoice for a missing order, we will issue an error
						If ThereIsInvoice And Not ThereSWarrant Then
							ErrorText = NStr("vi = 'Không thể lập chứng từ giao hàng vì chưa tạo lệnh nào.';
											|ru = 'Недоступно оформление по отгрузке, так как не создано ни одного ордера.';
											|en = 'Cannot register shipment as no note is created.'; fa = 'Cannot register shipment as no note is created.';
											|it = 'La formalizzazione per la spedizione non è disponibile, in quanto non è stato creato alcun mandato.';
											|pl = 'Rejestracja po wysyłce jest niedostępna, ponieważ nie utworzono żadnego zlecenia.';
											|tr = 'Hiçbir emir oluşturulmadığı için sevkiyat yoluyla düzenleme mevcut değil.'");
							AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
						Else
							// If this order is an invoice, or an order without an invoice - opening the invoice form, existing or new.
							FormParameters = ArrangeShipmentOfItemsAccordingToTable(DocumentsByTypesOfInvoices,
									 GenerationParameters, ErrorList, DocumentName, BusinessOperation);
						EndIf;
					EndIf;
					
				EndIf;
		
			Else
				// When placing Orders, a new shipment is always created
				
				If DocumentsByTypesOfInvoices.Count() > 1 Then
					// Batch
					FormParameters.IssueNumberOfInvoices = True;
					StorageAddress = PutToTempStorage(DocumentsByTypesOfInvoices, GenerationParameters.UUID);
					FormParameters.AddressDocumentsByInvoiceType = StorageAddress;
					
				ElsIf DocumentsByTypesOfInvoices.Count() = 1 Then
					// Individually
					FormParameters = ArrangeShipmentOfItemsAccordingToTable(DocumentsByTypesOfInvoices,
								 GenerationParameters, ErrorList, DocumentName, BusinessOperation);
				EndIf;
			
			EndIf;
		ElsIf	ComplianceWithOrders.Count() > 1 Or (DocumentsByTypesOfInvoices.Count() = 0
					And Not ValueIsFilled(ErrorList)) Then
		
			// Errors occurred when processing documents in batch mode
			ErrorText = NStr("vi = 'Chưa chọn chứng từ nào mà có thể lập chứng từ %1';
							|ru = 'Не выбрано ни одного документа, который можно было бы оформить %1';
							|en = 'No document which could be registered is selected %1'; fa = 'No document which could be registered is selected %1';
							|it = 'Non è stato selezionato alcun documento da formalizzare %1';
							|pl = 'Nie wybrano ani jednego dokumentu, który można byłoby zarejestrować %1';
							|tr = 'Düzenlenmek üzere hiçbir belge seçilmemiştir %1'");
			If GenerationParameters.ByNotes Then
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, NStr("vi = 'theo giao hàng';
																									|ru = 'по отгрузке';
																									|en = 'by shipment'; fa = 'by shipment';
																									|it = 'per la spedizione';
																									|pl = 'wg wysyłki';
																									|tr = 'sevkiyata göre'"));
			Else
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, NStr("vi = 'theo đơn hàng';
																									|ru = 'по заказам';
																									|en = 'on orders'; fa = 'on orders';
																									|it = 'per ordini';
																									|pl = 'wg zamówień';
																									|tr = 'siparişlere ilişkin'"));
			EndIf;
			AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
		EndIf;
		
	// List of "To transfer ownership"
	Else
		If GenerationParameters.NameOfShipmentCommand <> "ToIssueTransferOfOwnership" Then
			GenerationParameters.CreateSalesDocument = False;
		EndIf;
		GenerationParameters.CreateTaxInvoice = False;
		CommandOnlyShipments = False;
		
		// Transfer Of Ownership
		If GenerationParameters.NameOfShipmentCommand = "ToIssueTransferOfOwnership" Then
			DocumentName = "CustomerInvoice";
			CommandOnlyShipments = True;
			BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods;
		
		// Certificate of discrepancy after shipment
		ElsIf GenerationParameters.NameOfShipmentCommand = "IssueCertificateOfDiscrepancyAfterShipment" Then
			DocumentName = "DiscrepancyReportFollowingShipment";
			BusinessOperation = Enums.BusinessTransactions.TransferOfTitleToGoods;
			
		// Shipment correction	
		ElsIf GenerationParameters.NameOfShipmentCommand = "IssueShipmentCorrection" Then
			DocumentName = "GoodsShipmentToCustomer";
			BusinessOperation = Enums.BusinessTransactions.GoodsShipmentToCustomer;
		
		// Receipt of goods	
		ElsIf GenerationParameters.NameOfShipmentCommand = "RegisterGoodsReceipt" Then
			DocumentName = "GoodsReceiptFromCustomer";
			BusinessOperation = Enums.BusinessTransactions.GoodsReceiptFromCustomer;
		
		// Registration of surpluses	
		ElsIf GenerationParameters.NameOfShipmentCommand = "RegisterRegistrationOfSurpluses" Then
			DocumentName = "RecognitionOfStockSurplusShippedToCustomer";
			BusinessOperation = Enums.BusinessTransactions.RecognitionOfStockSurplusShippedToCustomer;
			
		// Write-Off of Shortages	
		ElsIf GenerationParameters.NameOfShipmentCommand = "IssueWriteOffOfShortages" Then
			DocumentName = "WriteOffOfShippedGoods";
			BusinessOperation = Enums.BusinessTransactions.WriteOffOfShippedGoods;
			
		EndIf;
		
		If ValueIsFilled(DocumentName) Then
			GenerationParameters.NewDocumentName = DocumentName;
			TablesByDocuments = ConvertMatchingShipmentsToTableOfValues(ComplianceWithOrders);
			
			// Breakdown of selected documents into groups
			DocumentsArray = SplitShipmentOrdersByName(TablesByDocuments, GenerationParameters,
																ErrorList, NumberOfPackages_, BusinessOperation);
			
			If DocumentsArray.Count() > 1 Then
				// Batch
				FormParameters.IssueNumberOfInvoices = True;
				StorageAddress = PutToTempStorage(DocumentsArray, GenerationParameters.UUID);
				FormParameters.AddressDocumentsByInvoiceType = StorageAddress;
				
			ElsIf DocumentsArray.Count() = 1 Then
				// Individually
				FormParameters = ArrangeShipmentOfItemsAccordingToTable(DocumentsArray, GenerationParameters, 
						ErrorList, DocumentName, BusinessOperation);
						
			ElsIf	ComplianceWithOrders.Count() > 1
						Or (Not ValueIsFilled(DocumentsArray) And Not ValueIsFilled(ErrorList)) Then
			
				// Errors occurred during the paperwork
				ErrorText = NStr("vi = 'Chưa chọn chứng từ nào mà có thể lập chứng từ %1';
								|ru = 'Не выбрано ни одного документа, который можно было бы оформить %1';
								|en = 'No document which could be registered is selected %1'; fa = 'No document which could be registered is selected %1';
								|it = 'Non è stato selezionato alcun documento da formalizzare %1';
								|pl = 'Nie wybrano ani jednego dokumentu, który można byłoby zarejestrować %1';
								|tr = 'Düzenlenmek üzere hiçbir belge seçilmemiştir %1'");
				If CommandOnlyShipments Then
					ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, NStr("vi = 'theo giao hàng';
																										|ru = 'по отгрузкам';
																										|en = 'by shipments'; fa = 'by shipments';
																										|it = 'by shipments';
																										|pl = 'by shipments';
																										|tr = 'sevkiyatlara göre'"));
				Else
					ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, NStr("vi = 'theo đơn hàng hoặc giao hàng';
																										|ru = 'по заказам или отгрузкам';
																										|en = 'by orders or shipments'; fa = 'by orders or shipments';
																										|it = 'by orders or shipments';
																										|pl = 'by orders or shipments';
																										|tr = 'siparişlere veya sevkiyatlara göre'"));
				EndIf;
				AddUserError(ErrorList, "Object.ListForTransferOfOwnership", ErrorText);
			EndIf;
		EndIf;
		
	EndIf;
	
	If Not ValueIsFilled(FormParameters) Then
		FormParameters = New Structure();
	EndIf;
	
	Messages = GetUserMessages(True);
	For Each Message In Messages Do
		AddUserError(ErrorList, Message.DataKey, String(Message.DataKey) + ": " + Message.Text);
	EndDo;
	
	FormParameters.Insert("ErrorList", ErrorList);
	FormParameters.Insert("NumberOfPackages_", NumberOfPackages_);
	
	Return FormParameters;

EndFunction

// Forms the structure of document tables based on the transmitted orders and parameters
// 
// Parameters:
// 		ComplianceWithOrders - See SalesClient.InitializeOrders
// 		GenerationParameters - See NewParametersForDesignOfSetOfDocuments
// 		
// Returns:
// 		Structure
//
Function IssueInvoiceOnServer(ComplianceWithOrders, GenerationParameters) Export
	
	Var ErrorList, NumberOfPackages_;
	
	DeleteDataFromSecureStorage("FormCreatedSalesDocuments");
	
	FormParameters = New Structure();
	FormParameters.Insert("IssueNumberOfInvoices", False);
	FormParameters.Insert("AddressDocumentsByInvoiceType", Undefined);
	
	ToSupplementStructureOfOrdersAndFormationParameters(ComplianceWithOrders, GenerationParameters);
	
	TablesByDocuments = ConvertMatchToTableOfValues(ComplianceWithOrders);
	
	// Breakdown of selected documents into groups
	DocumentsByTypesOfInvoices = SplitOrdersByFullInvoiceNames(TablesByDocuments.TableOfOrders,
		TablesByDocuments.TheOrdersTable, GenerationParameters, ErrorList, NumberOfPackages_);
	
	If DocumentsByTypesOfInvoices.Count() > 0 Then
		If GenerationParameters.ByNotes Then
			
			// If one document is selected and there is at least one invoice, the invoice re-filling form opens.
			// If there are no invoices and the documents can be grouped into one invoice, a new invoice form opens.
			// If there are no invoices and the documents cannot be grouped, the form of the list of created invoices opens.
			
			ThereIsInvoice = ThereIsInvoice(DocumentsByTypesOfInvoices);
			ThereSWarrant     = ThereSWarrant(DocumentsByTypesOfInvoices);
			ThereIsOrder     = ThereIsOrder(DocumentsByTypesOfInvoices);
			
			TotalTables = DocumentsByTypesOfInvoices.Count();
			If TotalTables > 1 Then
				
				If ThereIsInvoice Then
					// Batch with the exclusion of invoices and a message about the excluded documents
					// of the Order-invoices are excluded, because they must be processed individually - it is impossible to enter a new invoice 
					// according to the order-invoice.
					
					ExcludeOrdersWithInvoices(DocumentsByTypesOfInvoices, ErrorList);
					TablesLeft = DocumentsByTypesOfInvoices.Count();
					If TablesLeft > 0 Then
						FormParameters.IssueNumberOfInvoices = True;
						StorageAddress = PutToTempStorage(DocumentsByTypesOfInvoices, GenerationParameters.UUID);
						FormParameters.AddressDocumentsByInvoiceType = StorageAddress;
					EndIf;
					
					If TablesLeft = 0 Then
						ErrorText = NStr("vi = 'Chưa thực hiện giao dịch.';
										|ru = 'Операция не выполнена.';
										|en = 'Operation failed.'; fa = 'Operation failed.';
										|it = 'Operazione non è eseguita.';
										|pl = 'Operacja nie powiodła się.';
										|tr = 'İşlem tamamlanmadı.'");
						AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
					ElsIf TotalTables <> TablesLeft Then
						ErrorText = NStr("vi = 'Giao dịch đã thực hiện bị lỗi.';
										|ru = 'Операция выполнена с ошибками.';
										|en = 'Operation is completed with errors.'; fa = 'Operation is completed with errors.';
										|it = 'Operazione eseguita con errori.';
										|pl = 'Operacja zakończona z błędami.';
										|tr = 'İşlem hatalarla tamamlandı'");
						AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
					EndIf;
					
				Else
					// Batch if there are no invoices
					FormParameters.IssueNumberOfInvoices = True;
					StorageAddress = PutToTempStorage(DocumentsByTypesOfInvoices, GenerationParameters.UUID);
					FormParameters.AddressDocumentsByInvoiceType = StorageAddress;
				EndIf;
				
			ElsIf DocumentsByTypesOfInvoices.Count() = 1 Then
				// Individually
				
				// Checking for invoices
				// If the current order is an order and there are invoices for it, open the re-filling form.
				If ThereIsInvoice And ThereIsOrder Then
					// Opening the re-filling form
					FormParameters = FillItOutUsingFillInForm(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList);
				Else
					// When trying to fill out an invoice for a missing order, we will issue an error
					If ThereIsInvoice And Not ThereSWarrant Then
						ErrorText = NStr("vi = 'Không thể lập chứng từ giao hàng vì chưa tạo lệnh nào.';
										|ru = 'Недоступно оформление по отгрузке, так как не создано ни одного ордера.';
										|en = 'Cannot register shipment as no note is created.'; fa = 'Cannot register shipment as no note is created.';
										|it = 'La formalizzazione per la spedizione non è disponibile, in quanto non è stato creato alcun mandato.';
										|pl = 'Rejestracja po wysyłce jest niedostępna, ponieważ nie utworzono żadnego zlecenia.';
										|tr = 'Hiçbir emir oluşturulmadığı için sevkiyat yoluyla düzenleme mevcut değil.'");
						AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
					Else
						// If this order is an invoice, or an order without an invoice - opening the invoice form, existing or new.
						FormParameters = IssueInvoiceAccordingToTable(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList);
					EndIf;
				EndIf;
				
			EndIf;
			
		Else
			
			// When placing orders, a new invoice is always created
			
			// The form of the created invoice opens, if the key fields of the selected lines match, and
			// the functional option allows Otherwise, a form with a list of created invoices opens.
			
			If DocumentsByTypesOfInvoices.Count() > 1 Then
				// Batch
				FormParameters.IssueNumberOfInvoices = True;
				StorageAddress = PutToTempStorage(DocumentsByTypesOfInvoices, GenerationParameters.UUID);
				FormParameters.AddressDocumentsByInvoiceType = StorageAddress;
			ElsIf DocumentsByTypesOfInvoices.Count() = 1 Then
				// Individually
				FormParameters = IssueInvoiceAccordingToTable(DocumentsByTypesOfInvoices, GenerationParameters, ErrorList);
			EndIf;
			
		EndIf;
	ElsIf ComplianceWithOrders.Count() > 1 
		Or (DocumentsByTypesOfInvoices.Count() = 0 And Not ValueIsFilled(ErrorList)) Then
		
		// Errors occurred when processing documents in batch mode
		
		ErrorText = NStr("vi = 'Chưa chọn chứng từ nào mà có thể lập chứng từ %1';
						|ru = 'Не выбрано ни одного документа, который можно было бы оформить %1';
						|en = 'No document which could be registered is selected %1'; fa = 'No document which could be registered is selected %1';
						|it = 'Non è stato selezionato alcun documento da formalizzare %1';
						|pl = 'Nie wybrano ani jednego dokumentu, który można byłoby zarejestrować %1';
						|tr = 'Düzenlenebilecek hiçbir belge seçilmedi %1'");
		
		If GenerationParameters.ByNotes Then
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, NStr("vi = 'theo giao hàng';
																								|ru = 'по отгрузке';
																								|en = 'by shipment'; fa = 'by shipment';
																								|it = 'per la spedizione';
																								|pl = 'wg wysyłki';
																								|tr = 'sevkiyata göre'"));
		Else
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(ErrorText, NStr("vi = 'theo đơn hàng';
																								|ru = 'по заказам';
																								|en = 'on orders'; fa = 'on orders';
																								|it = 'per ordini';
																								|pl = 'wg zamówień';
																								|tr = 'siparişlere göre'"));
		EndIf;
		
		AddUserError(ErrorList, "Object.ListReferencesForRegistration", ErrorText);
		
	EndIf;
	
	If Not ValueIsFilled(FormParameters) Then
		FormParameters = New Structure();
	EndIf;
	
	Messages = GetUserMessages(True);
	
	For Each Message In Messages Do
		AddUserError(ErrorList, Message.DataKey, String(Message.DataKey) + ": " + Message.Text);
	EndDo;
	
	FormParameters.Insert("ErrorList", ErrorList);
	FormParameters.Insert("NumberOfPackages_", NumberOfPackages_);
	
	Return FormParameters;
	
EndFunction

