// Generates a request to the PM of the document's price Group and places it in a temporary table
//
// Parameters:
// QueryText     - String -  text string to which you want to add the query text
// QueryOptions - Structure - structure containing request parameters
// DocumentSales  - DocumentObject, DocumentRef - document to make a request for
// ByReference_         - Boolean - flag if True check is performed by reference to an object
// TableName       - String - name of the document table to be queried.
//
Procedure CreateQueryTemporaryTablePriceGroupsOfSalesDocument(QueryText,
	                                                                      QueryOptions,
	                                                                      DocumentSales,
	                                                                      ByReference_ = False,
	                                                                      TableName = "")
	
	If ByReference_ Then
		
		QueryText = QueryText + "
			|SELECT
			|	PriceGroups.LineNumber          AS LineNumber,
			|	PriceGroups.PriceGroup        AS PriceGroup,
			|	PriceGroups.PricesKind               AS PricesKind,
			|	PriceGroups.PercentRateOfManualDiscount  AS PercentRateOfManualDiscount,
			|	PriceGroups.MaximumPercentageForManualMarkup AS MaximumPercentageForManualMarkup,
			|	PriceGroups.DeliveryPeriodDays         AS DeliveryPeriodDays
			|INTO
			|	TemporaryTablePriceGroups
			|FROM
			|	&NameOfPriceGroupsTable AS PriceGroups
			|WHERE
			|	PriceGroups.Ref = &DocumentSales
			|INDEX BY
			|	PriceGroup
			|;
			|";
			
		QueryText = StrReplace(QueryText, "&NameOfPriceGroupsTable", "" + TableName + ".PriceGroups");
		
		QueryOptions.Insert("DocumentSales", DocumentSales);
			
	Else
		
		QueryText = QueryText + "
			|SELECT
			|	PriceGroups.LineNumber          AS LineNumber,
			|	PriceGroups.PriceGroup        AS PriceGroup,
			|	PriceGroups.PricesKind               AS PricesKind,
			|	PriceGroups.PercentRateOfManualDiscount  AS PercentRateOfManualDiscount,
			|	PriceGroups.MaximumPercentageForManualMarkup AS MaximumPercentageForManualMarkup,
			|	PriceGroups.DeliveryPeriodDays         AS DeliveryPeriodDays
			|INTO
			|	TemporaryTablePriceGroups
			|FROM
			|	&PriceGroups AS PriceGroups
			|INDEX BY
			|	PriceGroup
			|;
			|";
			
		QueryOptions.Insert("PriceGroups", DocumentSales.PriceGroups.Unload(,"LineNumber,PriceGroup,PricesKind, PercentRateOfManualDiscount, MaximumPercentageForManualMarkup, DeliveryPeriodDays"));
			
	EndIf;

EndProcedure

// Generates a request to the PM Stages of payment of the document and puts it in a temporary table
//
// Parameters:
// QueryText     - String - text string to which you want to add the query text
// QueryOptions - Structure - structure containing request parameters
// DocumentSales  - DocumentObject, DocumentRef - document to make a request for
// ByReference_         - Boolean - flag if True check is performed by reference to an object
// TableName       - String - name of the document table to be queried.
//
Procedure GenerateQueryTemporaryTablePaymentStagesOfSalesDocument(QueryText,
	                                                                    QueryOptions,
	                                                                    DocumentSales,
	                                                                    ByReference_ = False,
	                                                                    TableName = "")

	If ByReference_ Then
		
		ThereIsMetadataOfDepositForContainer = TableName = "Catalog.PaymentSchedules"
			Or TableName = "Catalog.TermsOfSale"
			Or TableName = "Document.JobForSalesRepresentative"
			Or TableName = "Document.SalesOrder"
			Or TableName = "Document.CustomerInvoice"
			Or TableName = "Document.RequestForReturnOfGoodsFromCustomer";
		
		QueryText = QueryText + "
			|SELECT
			|	PaymentScheduleSteps.LineNumber     AS LineNumber,
			|	PaymentScheduleSteps.PaymentOption   AS PaymentOption,
			|	PaymentScheduleSteps.CalculateFrom  AS CalculateFrom,
			|	PaymentScheduleSteps.Move           AS Move,
			|	PaymentScheduleSteps.PaymentDate     AS PaymentDate,
			|	PaymentScheduleSteps.PaymentPercentage  AS PaymentPercentage,
			|	PaymentScheduleSteps.PaymentAmount    AS PaymentAmount,
			|	&ThereIsMetadataOfDepositForContainer
			|INTO
			|	TimeTableStagesOfPaymentSchedule
			|FROM
			|	&NameOfPaymentScheduleStagesTable AS PaymentScheduleSteps
			|WHERE
			|	PaymentScheduleSteps.Ref = &DocumentSales
			|INDEX BY
			|	LineNumber
			|;
			|";
			
			QueryText = StrReplace(QueryText, "&NameOfPaymentScheduleStagesTable", "" + TableName + ".PaymentScheduleSteps");
			
			QueryText = StrReplace(QueryText, "&ThereIsMetadataOfDepositForContainer", ?(ThereIsMetadataOfDepositForContainer,
				"PaymentScheduleSteps.PackageDepositPercentage AS PackageDepositPercentage,
				|	PaymentScheduleSteps.PackageDepositValue AS PackageDepositValue",
				"0 AS PackageDepositPercentage,
				|0 AS PackageDepositValue"));
			
			QueryOptions.Insert("DocumentSales", DocumentSales);
		
	Else
		
		QueryText = QueryText + "
			|SELECT
			|	PaymentScheduleSteps.LineNumber         AS LineNumber,
			|	PaymentScheduleSteps.PaymentOption       AS PaymentOption,
			|	PaymentScheduleSteps.CalculateFrom      AS CalculateFrom,
			|	PaymentScheduleSteps.Move               AS Move,
			|	PaymentScheduleSteps.PaymentDate         AS PaymentDate,
			|	PaymentScheduleSteps.PaymentPercentage      AS PaymentPercentage,
			|	PaymentScheduleSteps.PaymentPercentage      AS PaymentAmount,
			|	PaymentScheduleSteps.PackageDepositPercentage AS PackageDepositPercentage,
			|	PaymentScheduleSteps.PaymentPercentage      AS PackageDepositValue
			|INTO
			|	TimeTableStagesOfPaymentSchedule
			|FROM
			|	&PaymentScheduleSteps AS PaymentScheduleSteps
			|;
			|";
		
		StepsTable = DocumentSales.PaymentScheduleSteps.Unload();
		If StepsTable.Columns.Find("PackageDepositPercentage") = Undefined Then
			StepsTable.Columns.Add("PackageDepositPercentage", TMCommonUse.MoneyFieldTypeDescription());
		EndIf;
		QueryOptions.Insert("PaymentScheduleSteps", StepsTable);
		
	EndIf;
		
EndProcedure

