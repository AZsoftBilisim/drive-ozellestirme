// A redefined structure (See ProvisionInDocumentsClientServer.ProvisionOptionAndFlagAreSeparateByDefault)
// based on the Status and
// agreement of the sales document.
// 
// Parameters:
//   Terms - CatalogRef.TermsOfSale - agreement with the client of the sales document.
//   Status - EnumRef.SalesOrderStatuses, EnumRef.StatusesOfRequestsForReturnOfGoodsFromCustomers -
//            status of the sales document.
//   DefaultOptionAndFlag - Structure
//    *Support options - Enum link.Support Options - the default security option.
//    *Separate - Boolean - the need to use a separate scheme by default.
//   UseAdvancedFeaturesOfSalesOrder - Boolean, Undefined - indicates whether the document uses advanced order features.
//
// Returns:
//  Undefined, Structure - The Provision Option And Flag Are Separate By Default:
// * OwnGoods - Structure -:
// ** SupplyOption - EnumRef.SupplyOptions -
// ** WithAssignment - Boolean -
// * ReusablePackage - Structure -:
// ** SupplyOption - EnumRef.SupplyOptions -
// ** WithAssignment - Boolean -
// * Work_5 - Structure -:
// ** SupplyOption - EnumRef.SupplyOptions -
// ** WithAssignment - Boolean -
// * OperationService - Structure -:
// ** SupplyOption - EnumRef.SupplyOptions -
// ** WithAssignment - Boolean -
Function ProvisionOptionAndFlagAreSeparateByDefault(Terms, Status, DefaultOptionAndFlag = Undefined,
	UseAdvancedFeaturesOfSalesOrder = Undefined) Export
	
	If UseAdvancedFeaturesOfSalesOrder = Undefined Then
		UseAdvancedFeaturesOfSalesOrder = GetFunctionalOption("UseAdvancedFeaturesOfSalesOrder");
	EndIf;
	
	Ship            = Enums.SupplyOptions.Ship;
	ToReserve_        = Enums.SupplyOptions.FromWarehouse;
	NotProvide       = Enums.SupplyOptions.NotRequired;
	ReserveAsReceived = Enums.SupplyOptions.ReserveAsReceived;
	
	ShipStatuses = New Array;
	ShipStatuses.Add(Enums.SalesOrderStatuses.ToShip);
	ShipStatuses.Add(Enums.SalesOrderStatuses.Closed);
	ShipStatuses.Add(Enums.StatusesOfRequestsForReturnOfGoodsFromCustomers.ToShip);
	ShipStatuses.Add(Enums.StatusesOfRequestsForReturnOfGoodsFromCustomers.Executed);
	
	StatusesFromWarehouse = New Array;
	StatusesFromWarehouse.Add(Enums.SalesOrderStatuses.ToSupply);
	StatusesFromWarehouse.Add(Enums.StatusesOfRequestsForReturnOfGoodsFromCustomers.ToSupply);
	
	NoStatusesRequired = New Array;
	NoStatusesRequired.Add(Enums.SalesOrderStatuses.NotApproved);
	NoStatusesRequired.Add(Enums.StatusesOfRequestsForReturnOfGoodsFromCustomers.NotAgreedUpon);
	NoStatusesRequired.Add(Enums.StatusesOfRequestsForReturnOfGoodsFromCustomers.ForReturn);
	NoStatusesRequired.Add(Enums.StatusesOfRequestsForReturnOfGoodsFromCustomers.IsRejected);
	
	Result = Undefined;
	
	// The structure of the security options should be initialized only if it is necessary to completely redefine the rules used
	// when filling in by default. If the security option for each type of nomenclature is known and rigidly specified.
	If DefaultOptionAndFlag <> Undefined Then
		
		DefaultOption = DefaultOptionAndFlag.SupplyOption;
		FlagDefault = DefaultOptionAndFlag.WithAssignment;
		
		WithAssignment = False;
		FillInSeparately = Common.ObjectAttributeValue(Terms, "EnableAssigmentSupplyForOrders");
		If FillInSeparately = True Then
			WithAssignment = True;
		EndIf;
		If FlagDefault = True Then
			WithAssignment = True;
		EndIf;
		
		Result = ProvisionInDocumentsClientServer.ProvisionOptionAndFlagAreSeparateByDefault(WithAssignment);
		
		If DefaultOption = Ship Then
			
			Result.OwnGoods.SupplyOption  = Ship;
			Result.Tara.SupplyOption   = Ship;
			Result.Work_5.SupplyOption = Ship;
			Result.OperationService.SupplyOption = Ship;
			
		ElsIf DefaultOption = ToReserve_ Then
			
			Result.OwnGoods.SupplyOption  = ToReserve_;
			Result.Tara.SupplyOption   = ToReserve_;
			// Works and services remain by default (To provide or Not to provide).
			
		ElsIf DefaultOption = ReserveAsReceived Then
			
			Result.OwnGoods.SupplyOption  = ReserveAsReceived;
			Result.Tara.SupplyOption   = ReserveAsReceived;
			// Works and services remain by default (To provide or Not to provide).
			
		ElsIf DefaultOption = NotProvide Then
			
			Result.OwnGoods.SupplyOption  = NotProvide;
			Result.Tara.SupplyOption   = NotProvide;
			// Works and services remain by default (To provide or Not to provide).
			
		EndIf;
		
		If FlagDefault = Undefined Then // the flag must be received regularly for each individual item
			Result.OwnGoods.WithAssignment = Undefined;
			Result.Work_5.WithAssignment = Undefined;
		EndIf;
		
		
	ElsIf GetFunctionalOption("UseShipmentByRowsInSalesOrder")
		And UseAdvancedFeaturesOfSalesOrder Then
		
		FillInSeparately = Common.ObjectAttributeValue(Terms, "EnableAssigmentSupplyForOrders");
		If FillInSeparately = True Then
			
			Result = ProvisionInDocumentsClientServer.ProvisionOptionAndFlagAreSeparateByDefault(True);
			
		EndIf;
		
	Else
		
		Result = ProvisionInDocumentsClientServer.ProvisionOptionAndFlagAreSeparateByDefault(False);
		If ShipStatuses.Find(Status) <> Undefined Then
			
			Result.OwnGoods.SupplyOption              = Ship;
			Result.Tara.SupplyOption               = Ship;
			Result.Work_5.SupplyOption             = Ship;
			Result.OperationService.SupplyOption             = Ship;
			
		ElsIf StatusesFromWarehouse.Find(Status) <> Undefined Then
			
			Result.OwnGoods.SupplyOption              = ToReserve_;
			Result.Tara.SupplyOption               = ToReserve_;
			// Works and services remain by default (Not to provide).
			
		ElsIf NoStatusesRequired.Find(Status) <> Undefined Then
			
			Result.OwnGoods.SupplyOption              = NotProvide;
			Result.Tara.SupplyOption               = NotProvide;
			// Works and services remain by default (Not to provide).
			
		EndIf;
		
	EndIf;
	
	Return Result;
	
EndFunction

