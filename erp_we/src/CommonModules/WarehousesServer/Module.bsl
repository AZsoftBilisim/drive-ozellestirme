		If TypeOf(Warehouses) = Type("Array") And Warehouses.Count() = 0 Then
			Query.SetParameter("Warehouses", Warehouse);
		EndIf;
		Query.SetParameter("Date", CheckDate);
		
		Return Not Query.Execute().IsEmpty();
		
