// Returns the build and delivery settings for the warehouse.
//
//	Parameters:
//		Warehouse - CatalogRef.Warehouses - link to the "Warehouses" reference list item"
//		Date - Date - which is checked for delivery support by their couriers
//
//	Returns:
//		Structure, Undefined - the structure of the settings values, if the settings are not specified, then returns.
//
Function WarehouseSettingsForAssemblyAndDelivery(Warehouse, Date = Undefined) Export
	
	If Not ValueIsFilled(Warehouse) Then
		Return Undefined;
	EndIf;
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	Warehouses.Ref AS Ref,
		|	CASE
		|		WHEN ISNULL(HistoryOfChange.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = VALUE(Catalog.StoreFormats.EmptyRef)
		|			THEN Warehouses.StoreSupportsDeliveryByOwnCouriers
		|					AND Warehouses.StartDateOfDeliveryByOwnCouriers <= &Date
		|		ELSE HistoryOfChange.StoreFormat.StoreSupportsDeliveryByOwnCouriers
		|	END AS StoreSupportsDeliveryByOwnCouriers,
		|	CASE
		|		WHEN ISNULL(HistoryOfChange.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = VALUE(Catalog.StoreFormats.EmptyRef)
		|			THEN Warehouses.StoreSupportsOrderAssembly
		|					AND Warehouses.OrderAssemblyStartDate <= &Date
		|		ELSE HistoryOfChange.StoreFormat.StoreSupportsOrderAssembly
		|	END AS StoreSupportsOrderAssembly,
		|	ISNULL(HistoryOfChange.StoreFormat.MethodOfSalesCreatingWhenAssemblingOrders, Warehouses.MethodOfSalesCreatingWhenAssemblingOrders) AS MethodOfSalesCreatingWhenAssemblingOrders,
		|	ISNULL(HistoryOfChange.StoreFormat.MethodOfFiscalizationUponDelivery, Warehouses.MethodOfFiscalizationUponDelivery) AS MethodOfFiscalizationUponDelivery,
		|	ISNULL(HistoryOfChange.StoreFormat.AssemblyAndDeliveryIsDoneBySameEmployee, Warehouses.AssemblyAndDeliveryIsDoneBySameEmployee) AS AssemblyAndDeliveryIsDoneBySameEmployee,
		|	ISNULL(HistoryOfChange.StoreFormat.CouriersCanAssignOrdersToThemselves, Warehouses.CouriersCanAssignOrdersToThemselves) AS CouriersCanAssignOrdersToThemselves,
		|	ISNULL(HistoryOfChange.StoreFormat.PickersCanAssignJobsToThemselves, Warehouses.PickersCanAssignJobsToThemselves) AS PickersCanAssignJobsToThemselves,
		|	ISNULL(HistoryOfChange.StoreFormat.StandardOrderDeliveryTime, Warehouses.StandardOrderDeliveryTime) AS StandardOrderDeliveryTime,
		|	ISNULL(HistoryOfChange.StoreFormat.CouriersUsePOSTerminals, Warehouses.CouriersUsePOSTerminals) AS CouriersUsePOSTerminals,
		|	ISNULL(HistoryOfChange.StoreFormat.CouriersUseAutonomousCREs, Warehouses.CouriersUseAutonomousCREs) AS CouriersUseAutonomousCREs,
		|	ISNULL(HistoryOfChange.StoreFormat.GroupingOfGoods, Warehouses.GroupingOfGoods) AS GroupingOfGoods
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(&Date, Warehouse = &Warehouse) AS HistoryOfChange
		|		ON (HistoryOfChange.Warehouse = Warehouses.Ref)
		|WHERE
		|	Warehouses.Ref = &Warehouse
		|	AND Warehouses.UseWarehouseManagemantSystemForGoodsIssue = FALSE
		|	AND Warehouses.IsFolder = FALSE";
	
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Date",
		?(ValueIsFilled(Date),Date,CurrentSessionDate()));
		
	SetPrivilegedMode(True);
	Result = Query.Execute();
	SetPrivilegedMode(False);
	
	If Result.IsEmpty() Then
		Return Undefined;
	Else
		Return Common.ValueTableRowToStructure(Result.Unload()[0]);
	EndIf;
	
EndFunction

