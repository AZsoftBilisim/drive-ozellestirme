// Adds a request to the request package to get the data needed to fill in the warehouse field when processing rows 
// in the table part.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure CompleteQueryTextCheckFillOutWarehouse(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var ActionParameters;
	
	If BatchProcessingOfTablePartServer.YouNeedToPerformAction(
			"CheckFillWarehouse",
			StructureOfActions,
			CachedValues,
			ActionParameters) Then
	
		WarehouseGroup_ = False;
		If ActionParameters.Property("WarehouseGroup_") Then
			WarehouseGroup_ = ActionParameters.WarehouseGroup_;
		EndIf;
		
		DefaultWarehouse = PredefinedValue("Catalog.Warehouses.EmptyRef");
		If TypeOf(ActionParameters) = Type("Structure")
			And ActionParameters.Property("DefaultWarehouse") Then
			DefaultWarehouse = ActionParameters.DefaultWarehouse;
		EndIf;
		
		GroupOfWarehouses = PredefinedValue("Catalog.Warehouses.EmptyRef");
		If TypeOf(ActionParameters) = Type("Structure")
			And ActionParameters.Property("WarehouseGroupLink") Then
			GroupOfWarehouses = ActionParameters.WarehouseGroupLink;
		EndIf;
		
		WarehouseFieldName = "DataSource.Warehouse";
		If TypeOf(ActionParameters) = Type("Structure")
			And ActionParameters.Property("WarehouseFieldName") Then
			WarehouseFieldName = "DataSource." + ActionParameters.WarehouseFieldName;
		EndIf;
		
		WarehouseGroupLinkFilledIn = ActionParameters.Property("WarehouseGroupLink")
			And ValueIsFilled(ActionParameters.WarehouseGroupLink);
		
		QueryText =
		"SELECT ALLOWED
		|	DataSource.IdOfTTRow AS IdOfTTRow,
		|	&ItemTypeField AS ItemsType,
		|	&WarehouseGroup_
		|		AND &WarehouseGroupLinkFilledIn
		|		AND &ItemTypeField IN(
		|				VALUE(Enum.ItemsTypes.OwnGoods),
		|				VALUE(Enum.ItemsTypes.ReusablePackage))
		|		AND &WarehouseFieldName <> VALUE(Catalog.Warehouses.EmptyRef)
		|		AND NOT (&WarehouseFieldName IN HIERARCHY (&GroupOfWarehouses)) AS ClearWarehouse
		|FROM
		|	TTDataSource AS DataSource
		|";
		
		If BatchProcessingOfTablePartServer.ThereIsColumnInDataSource(
			"ItemsType", CachedValues) Then
			QueryText = StrReplace(QueryText, "&ItemTypeField", "DataSource.ItemsType"); // @query-part-2
		Else
			QueryText = StrReplace(QueryText, "&ItemTypeField", "DataSource.Products.ItemsType"); // @query-part-2
		EndIf;
		
		QueryText = StrReplace(QueryText, "&WarehouseFieldName", WarehouseFieldName);
		
		QueryDetails.QueriesTexts.Add(QueryText,         "CheckFillWarehouse");
		QueryDetails.QueryOptions.Insert("WarehouseGroup_",      WarehouseGroup_);
		QueryDetails.QueryOptions.Insert("GroupOfWarehouses",    GroupOfWarehouses);
		QueryDetails.QueryOptions.Insert("WarehouseGroupLinkFilledIn", WarehouseGroupLinkFilledIn);
		
	EndIf;
	
EndProcedure

// Adds a request to a batch of requests to get the data needed to fill in the attribute of using
// an address warehouse when batch processing rows of table parts.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure CompleteQueryTextUseBinLocationSystem(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var ParametersAddressStorageIsUsed;
	
	If BatchProcessingOfTablePartServer.YouNeedToPerformAction(
			"FillInAddressStorageAttribute",
			StructureOfActions,
			CachedValues,
			ParametersAddressStorageIsUsed) Then
		
		DocumentDate = Undefined;
		
		If ParametersAddressStorageIsUsed <> Undefined Then
			ParametersAddressStorageIsUsed.Property("Date", DocumentDate);
		EndIf;
		
		If Not ValueIsFilled(DocumentDate) Then
			DocumentDate = CurrentSessionDate();
		EndIf;
		
		QueryText = 
			"SELECT
			|	DataSource.IdOfTTRow AS IdOfTTRow,
			|	NOT SettingsOfBinLocationWarehouses.Warehouse IS NULL AS UseBinLocationWarehousing 
			|FROM
			|	TTDataSource AS DataSource
			|	LEFT JOIN InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOfBinLocationWarehouses
			|		ON SettingsOfBinLocationWarehouses.UseBinLocationWarehousing
			|		AND SettingsOfBinLocationWarehouses.StartDateOfUsingWarehouseBinSystem <= &DateAddressWarehousesWereSetUp
			|		AND SettingsOfBinLocationWarehouses.Warehouse = DataSource.Warehouse
			|		AND SettingsOfBinLocationWarehouses.Premise = DataSource.Premise
			|		AND (NOT DataSource.Premise = VALUE(Catalog.Warerooms.EmptyRef)
			|				OR (NOT SettingsOfBinLocationWarehouses.Warehouse.UseWarerooms
			|					OR &DateAddressWarehousesWereSetUp < SettingsOfBinLocationWarehouses.Warehouse.StartDateOfWareroomUse))";
			
		QueryDetails.QueriesTexts.Add(QueryText, "WhetherBinLocationSystemIsAddressBasedStorage");
		QueryDetails.QueryOptions.Insert("DateAddressWarehousesWereSetUp", DocumentDate);
		
	EndIf;
	
EndProcedure

// Adds a request to a batch of requests to get the data needed to fill in the indication of the use
// of storage facilities during batch processing of rows of table parts.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure AddQueryTextToUseStorageFacilities(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var ParametersUsedByPremises;
	
	If BatchProcessingOfTablePartServer.YouNeedToPerformAction(
			"FillInSpaceUsageAttribute",
			StructureOfActions,
			CachedValues,
			ParametersUsedByPremises) Then
		
		DocumentDate = Undefined;
		
		If Not ParametersUsedByPremises = Undefined Then
			ParametersUsedByPremises.Property("Date", DocumentDate);
		EndIf;
		
		If Not ValueIsFilled(DocumentDate) Then
			DocumentDate = CurrentSessionDate();
		EndIf;
		
		QueryText = 
			"SELECT
			|	DataSource.IdOfTTRow AS IdOfTTRow,
			|	ISNULL(Warehouses.UseWarerooms, FALSE) AND
			|		(&DateOfVerificationOfUseOfPremises >= 
			|			ISNULL(Warehouses.StartDateOfWareroomUse, DATETIME(1, 1, 1))) AS UseWarerooms
			|FROM
			|	TTDataSource AS DataSource
			|	LEFT JOIN Catalog.Warehouses AS Warehouses
			|		ON Warehouses.Ref = DataSource.Warehouse";
			
		QueryDetails.QueriesTexts.Add(QueryText, "IndicationOfUseOfPremises");
		QueryDetails.QueryOptions.Insert("DateOfVerificationOfUseOfPremises", DocumentDate);
		QueryDetails.PrivilegedMode = True;
		
	EndIf;
	
EndProcedure

// Adds a request to the request package to get the data needed to fill the room 
// with the largest Balance by item, characteristic and warehouse in the row of the tabular part of the document.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure CompleteQueryTextAndFillInRoom(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var ActionStructureParameter;
	
	If BatchProcessingOfTablePartServer.YouNeedToPerformAction(
			"FillRoom",
			StructureOfActions,
			CachedValues,
			ActionStructureParameter) Then
		
		Warehouse = ActionStructureParameter.Warehouse;
		
		QueryText = "SELECT
			|	ProductStockBalance.Products AS Products,
			|	ProductStockBalance.Characteristic AS Characteristic,
			|	ProductStockBalance.Premise AS Premise,
			|	ProductStockBalance.InStockBalance AS InStockBalance
			|INTO GoodsInTTWarehousesBalance
			|FROM
			|	AccumulationRegister.ProductStock.Balance(
			|			,
			|			(Products, Characteristic, Warehouse) IN
			|				(SELECT
			|					DataSource.Products AS Products,
			|					DataSource.Characteristic AS Characteristic,
			|					&Warehouse_FillRoom AS Warehouse
			|				FROM
			|					TTDataSource AS DataSource)) AS ProductStockBalance
			|
			|INDEX BY
			|	Products,
			|	Characteristic";
			
		QueryDetails.QueriesTexts.Add(QueryText, "GoodsInTTWarehousesBalance");
			
		QueryText = "SELECT
			|	ProductStockBalance.Products AS Products,
			|	ProductStockBalance.Characteristic AS Characteristic,
			|	MAX(ProductStockBalance.InStockBalance) AS InStockBalance
			|INTO GoodsInWarehousesBalanceMaximum
			|FROM
			|	GoodsInTTWarehousesBalance AS ProductStockBalance
			|
			|GROUP BY
			|	ProductStockBalance.Products,
			|	ProductStockBalance.Characteristic
			|
			|INDEX BY
			|	Products,
			|	Characteristic";
			
		QueryDetails.QueriesTexts.Add(QueryText, "GoodsInWarehousesBalanceMaximum");
			
		QueryText = "SELECT
			|	DataSource.IdOfTTRow AS IdOfTTRow,
			|	DataSource.Products AS Products,
			|	DataSource.Characteristic AS Characteristic,
			|	ISNULL(ProductStockBalance.Premise, VALUE(Catalog.Warerooms.EmptyRef)) AS Premise
			|FROM
			|	TTDataSource AS DataSource
			|		LEFT JOIN GoodsInWarehousesBalanceMaximum AS GoodsInWarehousesBalanceMaximum
			|		ON DataSource.Products = GoodsInWarehousesBalanceMaximum.Products
			|			AND DataSource.Characteristic = GoodsInWarehousesBalanceMaximum.Characteristic
			|		LEFT JOIN GoodsInTTWarehousesBalance AS ProductStockBalance
			|		ON DataSource.Products = ProductStockBalance.Products
			|			AND DataSource.Characteristic = ProductStockBalance.Characteristic
			|			AND (GoodsInWarehousesBalanceMaximum.InStockBalance = ProductStockBalance.InStockBalance)";
			
		QueryDetails.QueriesTexts.Add(QueryText, "FillRoom");
		QueryDetails.QueryOptions.Insert("Warehouse_FillRoom", Warehouse);
		
	EndIf;
	
EndProcedure

#EndRegion

#Region CalculationOfDocumentStates

// The procedure calculates the status of selection orders.
//
// Parameters:
//	Warehouse - CatalogRef.Warehouses - warehouse;
//	Premise - CatalogRef.Warerooms - warehouse;
//	PickingReferences - ValueTable - the table of values in which the results of the calculation of States are placed. Columns:
//			* ReferenceOrder - DocumentRef - document-order;
//			* DateOfShipment - Date - date of shipment;
//			* Priority - CatalogRef.Priorities - priority for production;
//			* DocumentType - Type - document type;
//			* Number - String - document number;
//			* ShippingZone - CatalogRef.StorageBins - the shipping area;
//			* Comment - String - comment;
//			* State - EnumRef.StatesOfGoodsPickingReferences - status of the selection order;
//			* PictureIndex - Number - the index of the image row from the collection of pictures Podchinennymi.
//	DisplayingDetails - Boolean - indicates that the list of expense orders for the transportation task is currently displayed
//	TransportationJob - DocumentRef.TransportationJob - the task of transportation, which is now displayed debit orders.
//		This document is added to the very beginning of the table of Dispositionsreferences.
//	SelectionState - String - status of the order for the selection of goods.
//
Procedure CalculateStatesOfOrdersForSelection(Warehouse, Premise, PickingReferences, DisplayingDetails, TransportationJob, SelectionState) Export
	
	AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
		Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|			THEN GoodsIssueNote.TransportationJob
	|		ELSE GoodsIssueNote.Ref
	|	END AS ReferenceOrder,
	|	GoodsIssueNote.Ref AS Ref,
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|				AND NOT &UsedDelivery25
	|			THEN GoodsIssueNote.TransportationJob.PlanTripStartTime
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|				AND &UsedDelivery25
	|			THEN GoodsIssueNote.TransportationJob.DateOfDeparture
	|		ELSE GoodsIssueNote.DateOfShipment
	|	END AS DateOfShipment,
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|			THEN GoodsIssueNote.TransportationJob.Priority.AddlOrderingAttribute
	|		ELSE GoodsIssueNote.Priority.AddlOrderingAttribute
	|	END AS Priority,
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|			THEN GoodsIssueNote.TransportationJob.Priority
	|		ELSE GoodsIssueNote.Priority
	|	END AS PriorityLink,
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|			THEN GoodsIssueNote.TransportationJob.Number
	|		ELSE GoodsIssueNote.Number
	|	END AS Number,
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|			THEN VALUE(Catalog.StorageBins.EmptyRef)
	|		ELSE GoodsIssueNote.ShippingZone
	|	END AS ShippingZone,
	|	CASE
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|				AND VALUETYPE(GoodsIssueNote.TransportationJob) = TYPE(Document.TransportationJob)
	|			THEN CAST(GoodsIssueNote.TransportationJob.AdditionalInformation AS STRING(100))
	|		WHEN GoodsIssueNote.ShipmentUnderTransportationJob
	|				AND GoodsIssueNote.Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|				AND NOT &DisplayingDetails
	|				AND VALUETYPE(GoodsIssueNote.TransportationJob) = TYPE(Document.Trip)
	|			THEN CAST(GoodsIssueNote.TransportationJob.Comment AS STRING(100))
	|		ELSE CAST(GoodsIssueNote.Comment AS STRING(100))
	|	END AS Comment
	|INTO PickingReferences
	|FROM
	|	Document.GoodsIssueNote AS GoodsIssueNote
	|WHERE
	|	(NOT &DisplayingDetails
	|			OR GoodsIssueNote.TransportationJob = &TransportationJob)
	|	AND GoodsIssueNote.Warehouse = &Warehouse
	|	AND GoodsIssueNote.Premise = &Premise
	|	AND GoodsIssueNote.Posted
	|	AND GoodsIssueNote.Status = VALUE(Enum.GoodsIssueNoteStatuses.ForPicking)
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsTransferNote.Ref,
	|	GoodsTransferNote.Ref,
	|	GoodsTransferNote.DateOfShipment,
	|	GoodsTransferNote.Priority.AddlOrderingAttribute,
	|	GoodsTransferNote.Priority,
	|	GoodsTransferNote.Number,
	|	GoodsTransferNote.ShippingZone,
	|	CAST(GoodsTransferNote.Comment AS STRING(100))
	|FROM
	|	Document.GoodsTransferNote AS GoodsTransferNote
	|WHERE
	|	NOT &DisplayingDetails
	|	AND GoodsTransferNote.Warehouse = &Warehouse
	|	AND GoodsTransferNote.SenderWareroom = &Premise
	|	AND GoodsTransferNote.Posted
	|	AND GoodsTransferNote.Status = VALUE(Enum.TransferNoteStatuses.ForPicking)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	PickingReferences.ReferenceOrder AS ReferenceOrder,
	|	FALSE AS SelectedFromSpendingOrders
	|INTO TTOrdersUngrouped
	|FROM
	|	PickingReferences AS PickingReferences
	|WHERE
	|	NOT PickingReferences.ReferenceOrder REFS Document.TransportationJob
	|	AND NOT PickingReferences.ReferenceOrder REFS Document.Trip
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsIssueNote.Ref,
	|	TRUE AS SelectedFromSpendingOrders
	|FROM
	|	Document.GoodsIssueNote AS GoodsIssueNote
	|		INNER JOIN PickingReferences AS PickingReferences
	|		ON GoodsIssueNote.TransportationJob = PickingReferences.ReferenceOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	TT_Orders.ReferenceOrder AS ReferenceOrder
	|INTO TTOrders_
	|FROM
	|	TTOrdersUngrouped AS TT_Orders
	|GROUP BY
	|	TT_Orders.ReferenceOrder
	|INDEX BY
	|	ReferenceOrder
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	TT_Orders.ReferenceOrder AS ReferenceOrder
	|INTO TTOrdersGoodsInTasks
	|FROM
	|	TTOrdersUngrouped AS TT_Orders
	|WHERE
	|	NOT TT_Orders.SelectedFromSpendingOrders
	|	OR (TT_Orders.SelectedFromSpendingOrders
	|			AND NOT &DisplayingDetails)
	|
	|GROUP BY
	|	TT_Orders.ReferenceOrder
	|INDEX BY
	|	ReferenceOrder
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP TTOrdersUngrouped
	|";
	
	Query.Text = Query.Text + 
	";
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		
		Query.Text = Query.Text + Chars.LF + 
		"SELECT
		|	GoodsForSelectionTurnover.Products AS Products,
		|	GoodsForSelectionTurnover.Characteristic AS Characteristic,
		|	GoodsForSelectionTurnover.Purpose AS Purpose,
		|	GoodsForSelectionTurnover.Series AS Series,
		|	CASE
		|		WHEN NOT &DisplayingDetails
		|				AND GoodsForSelectionTurnover.ReferenceOrder REFS Document.GoodsIssueNote
		|				AND CAST(GoodsForSelectionTurnover.ReferenceOrder AS Document.GoodsIssueNote).ShipmentUnderTransportationJob
		|				AND CAST(GoodsForSelectionTurnover.ReferenceOrder AS Document.GoodsIssueNote).Warehouse.StartShipmentOnceDeliveryOrderIsCreated
		|			THEN CAST(GoodsForSelectionTurnover.ReferenceOrder AS Document.GoodsIssueNote).TransportationJob
		|		ELSE GoodsForSelectionTurnover.ReferenceOrder
		|	END AS ReferenceOrder,
		|	GoodsForSelectionTurnover.CargoItem AS CargoItem,
		|	GoodsForSelectionTurnover.ForPickingReceipt AS Count
		|INTO GoodsForSelectionTurnoverWithoutProductLocations
		|FROM
		|	AccumulationRegister.GoodsForPicking.Turnovers(
		|			,
		|			,
		|			,
		|			ReferenceOrder IN
		|				(SELECT
		|					TTOrders_.ReferenceOrder
		|				FROM
		|					TTOrders_ AS TTOrders_)) AS GoodsForSelectionTurnover
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsForSelectionTurnoverWithoutProductLocations.Products AS Products,
		|	GoodsForSelectionTurnoverWithoutProductLocations.Characteristic AS Characteristic,
		|	GoodsForSelectionTurnoverWithoutProductLocations.Purpose AS Purpose,
		|	GoodsForSelectionTurnoverWithoutProductLocations.Series AS Series,
		|	GoodsForSelectionTurnoverWithoutProductLocations.ReferenceOrder AS ReferenceOrder,
		|	GoodsForSelectionTurnoverWithoutProductLocations.Count * ISNULL(PackagesAndUnitsOfMeasure.NumberOfPackages, 1) AS Count,
		|	ISNULL(PackagesAndUnitsOfMeasure.Ref, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS CargoItem
		|INTO GoodsForSelectionTurnover
		|FROM
		|	GoodsForSelectionTurnoverWithoutProductLocations AS GoodsForSelectionTurnoverWithoutProductLocations
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		|		ON (CASE
		|				WHEN GoodsForSelectionTurnoverWithoutProductLocations.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
		|					THEN PackagesAndUnitsOfMeasure.Owner = GoodsForSelectionTurnoverWithoutProductLocations.Products
		|				WHEN GoodsForSelectionTurnoverWithoutProductLocations.Products.PackagingGroup <> VALUE(Catalog.PackagingGroups.EmptyRef)
		|					THEN PackagesAndUnitsOfMeasure.Owner = GoodsForSelectionTurnoverWithoutProductLocations.Products.PackagingGroup
		|				ELSE FALSE
		|			END)
		|			AND (PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem))
		|			AND (GoodsForSelectionTurnoverWithoutProductLocations.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef))";
		
		Query.Text = Query.Text + ";";
		
	EndIf;
	
	Query.Text = Query.Text + Chars.LF + 
	"SELECT
	|	CASE
	|		WHEN NOT &DisplayingDetails
	|				AND GoodsForPickingBalance.ReferenceOrder REFS Document.GoodsIssueNote
	|				AND CAST(GoodsForPickingBalance.ReferenceOrder AS Document.GoodsIssueNote).ShipmentUnderTransportationJob
	|				AND CAST(GoodsForPickingBalance.ReferenceOrder AS Document.GoodsIssueNote).Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|			THEN CAST(GoodsForPickingBalance.ReferenceOrder AS Document.GoodsIssueNote).TransportationJob
	|		ELSE GoodsForPickingBalance.ReferenceOrder
	|	END AS ReferenceOrder,
	|	GoodsForPickingBalance.Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.Series,
	|	GoodsForPickingBalance.CargoItem,
	|	GoodsForPickingBalance.ForPickingBalance AS ForPickingBalance,
	|	GoodsForPickingBalance.BeingPickedBalance AS BeingPickedBalance,
	|	GoodsForPickingBalance.PickedBalance AS PickedBalance
	|INTO GoodsToBeSelectedLeftoversWithoutItems
	|FROM
	|	AccumulationRegister.GoodsForPicking.Balance(
	|			,
	|			ReferenceOrder IN
	|				(SELECT
	|					TTOrders_.ReferenceOrder
	|				FROM
	|					TTOrders_ AS TTOrders_)) AS GoodsForPickingBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPickingBalance.ReferenceOrder,
	|	GoodsForPickingBalance.Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.Series,
	|	ISNULL(PackagesAndUnitsOfMeasure.Ref, GoodsForPickingBalance.CargoItem) AS CargoItem,
	|	SUM(GoodsForPickingBalance.ForPickingBalance * ISNULL(PackagesAndUnitsOfMeasure.NumberOfPackages, 1)) AS ForPickingBalance,
	|	SUM(GoodsForPickingBalance.BeingPickedBalance * ISNULL(PackagesAndUnitsOfMeasure.NumberOfPackages, 1)) AS BeingPickedBalance,
	|	SUM(GoodsForPickingBalance.PickedBalance * ISNULL(PackagesAndUnitsOfMeasure.NumberOfPackages, 1)) AS PickedBalance
	|INTO GoodsForPickingBalance
	|FROM
	|	GoodsToBeSelectedLeftoversWithoutItems AS GoodsForPickingBalance
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		ON (CASE
	|				WHEN GoodsForPickingBalance.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
	|					THEN PackagesAndUnitsOfMeasure.Owner = GoodsForPickingBalance.Products
	|				WHEN GoodsForPickingBalance.Products.PackagingGroup <> VALUE(Catalog.PackagingGroups.EmptyRef)
	|					THEN PackagesAndUnitsOfMeasure.Owner = GoodsForPickingBalance.Products.PackagingGroup
	|				ELSE FALSE
	|			END)
	|			AND (PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem))
	|			AND (GoodsForPickingBalance.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef))
	|
	|GROUP BY
	|	GoodsForPickingBalance.Series,
	|	GoodsForPickingBalance.Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.ReferenceOrder,
	|	ISNULL(PackagesAndUnitsOfMeasure.Ref, GoodsForPickingBalance.CargoItem)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SelectionProductPlacementProductsSelection.Products,
	|	SelectionProductPlacementProductsSelection.Characteristic,
	|	SelectionProductPlacementProductsSelection.Purpose,
	|	CASE
	|		WHEN SelectionProductPlacementProductsSelection.BatchesIndicationStatus IN (6, 8, 10, 14)
	|			THEN SelectionProductPlacementProductsSelection.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	SUM(CASE
	|			WHEN ISNULL(SelectionProductPlacementProductsSelection.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|				THEN SelectionProductPlacementProductsSelection.NumberOfPackages
	|			ELSE SelectionProductPlacementProductsSelection.Count
	|		END) AS CountPlan,
	|	SUM(CASE
	|			WHEN ISNULL(SelectionProductPlacementProductsSelection.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|				THEN SelectionProductPlacementProductsSelection.NumberOfPackagesPicked
	|			ELSE SelectionProductPlacementProductsSelection.CountPicked
	|		END) AS CountPicked,
	|	CASE
	|		WHEN NOT &DisplayingDetails
	|				AND SelectionProductPlacementProductsSelection.Ref.ReferenceOrder REFS Document.GoodsIssueNote
	|				AND CAST(SelectionProductPlacementProductsSelection.Ref.ReferenceOrder AS Document.GoodsIssueNote).ShipmentUnderTransportationJob
	|				AND CAST(SelectionProductPlacementProductsSelection.Ref.ReferenceOrder AS Document.GoodsIssueNote).Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|			THEN CAST(SelectionProductPlacementProductsSelection.Ref.ReferenceOrder AS Document.GoodsIssueNote).TransportationJob
	|		ELSE SelectionProductPlacementProductsSelection.Ref.ReferenceOrder
	|	END AS ReferenceOrder,
	|	CASE
	|		WHEN ISNULL(SelectionProductPlacementProductsSelection.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|			THEN SelectionProductPlacementProductsSelection.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS CargoItem
	|INTO ProductsInTasks
	|FROM
	|	Document.GoodsPickingPlacement.GoodsFilter AS SelectionProductPlacementProductsSelection
	|		INNER JOIN TTOrdersGoodsInTasks AS TTOrders_
	|		ON SelectionProductPlacementProductsSelection.Ref.ReferenceOrder = TTOrders_.ReferenceOrder
	|
	|WHERE
	|	SelectionProductPlacementProductsSelection.Ref.Posted
	|
	|GROUP BY
	|	SelectionProductPlacementProductsSelection.Characteristic,
	|	CASE
	|		WHEN SelectionProductPlacementProductsSelection.BatchesIndicationStatus IN (6, 8, 10, 14)
	|			THEN SelectionProductPlacementProductsSelection.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END,
	|	SelectionProductPlacementProductsSelection.Products,
	|	SelectionProductPlacementProductsSelection.Purpose,
	|	CASE
	|		WHEN NOT &DisplayingDetails
	|				AND SelectionProductPlacementProductsSelection.Ref.ReferenceOrder REFS Document.GoodsIssueNote
	|				AND CAST(SelectionProductPlacementProductsSelection.Ref.ReferenceOrder AS Document.GoodsIssueNote).ShipmentUnderTransportationJob
	|				AND CAST(SelectionProductPlacementProductsSelection.Ref.ReferenceOrder AS Document.GoodsIssueNote).Warehouse.StartShipmentOnceDeliveryOrderIsCreated
	|			THEN CAST(SelectionProductPlacementProductsSelection.Ref.ReferenceOrder AS Document.GoodsIssueNote).TransportationJob
	|		ELSE SelectionProductPlacementProductsSelection.Ref.ReferenceOrder
	|	END,
	|	CASE
	|		WHEN ISNULL(SelectionProductPlacementProductsSelection.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|			THEN SelectionProductPlacementProductsSelection.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END
	|
	|INDEX BY
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series,
	|	CargoItem
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPickingBalance.ReferenceOrder,
	|	GoodsForPickingBalance.Products AS Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.Series,
	|	GoodsForPickingBalance.CargoItem,
	|	GoodsForPickingBalance.ForPickingBalance - GoodsForPickingBalance.PickedBalance - GoodsForPickingBalance.BeingPickedBalance AS Count,
	|	CASE
	|		WHEN &ConditionStateReadyForVerification
	|			THEN 0
	|		WHEN &ConditionStateInProgress
	|			THEN 1
	|		WHEN GoodsForPickingBalance.ForPickingBalance <= ProductsInTasks.CountPlan
	|			THEN 2
	|		ELSE 100
	|	END AS State,
	|	PickingReferences.DateOfShipment,
	|	PickingReferences.Priority
	|INTO StatesForSelectedGoods
	|FROM
	|	GoodsForPickingBalance AS GoodsForPickingBalance
	|		LEFT JOIN ProductsInTasks AS ProductsInTasks
	|		ON GoodsForPickingBalance.ReferenceOrder = ProductsInTasks.ReferenceOrder
	|			AND GoodsForPickingBalance.Products = ProductsInTasks.Products
	|			AND GoodsForPickingBalance.Characteristic = ProductsInTasks.Characteristic
	|			AND GoodsForPickingBalance.Purpose = ProductsInTasks.Purpose
	|			AND GoodsForPickingBalance.Series = ProductsInTasks.Series
	|			AND GoodsForPickingBalance.CargoItem = ProductsInTasks.CargoItem
	|		INNER JOIN PickingReferences AS PickingReferences
	|		ON GoodsForPickingBalance.ReferenceOrder = PickingReferences.ReferenceOrder
	|WHERE &ConditionGoodsForSelection
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductStates.ReferenceOrder                AS ReferenceOrder,
	|	ProductStates.Products                AS Products,
	|	ProductStates.Characteristic              AS Characteristic,
	|	ProductStates.Purpose                  AS Purpose,
	|	ProductStates.Series                       AS Series,
	|	SUM(ProductStates.Count)           AS Count,
	|	ProductStates.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	ProductStates.DateOfShipment                AS DateOfShipment,
	|	ProductStates.Priority                   AS Priority
	|INTO ProductsTable
	|FROM
	|	(SELECT
	|		ProductStates.ReferenceOrder                 AS ReferenceOrder,
	|		ProductStates.Products                 AS Products,
	|		ProductStates.Characteristic               AS Characteristic,
	|		ProductStates.Purpose                   AS Purpose,
	|		ProductStates.Series                        AS Series,
	|		ProductStates.Count                   AS Count,
	|		ProductStates.Products.WarehouseGroup AS WarehouseGroupOfProducts,
	|		ProductStates.DateOfShipment                 AS DateOfShipment,
	|		ProductStates.Priority                    AS Priority
	|	FROM
	|		StatesForSelectedGoods AS ProductStates
	|	WHERE
	|		ProductStates.State = 100
	|		AND ProductStates.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ProductStates.ReferenceOrder                 AS ReferenceOrder,
	|		ProductStates.Products                 AS Products,
	|		ProductStates.Characteristic               AS Characteristic,
	|		ProductStates.Purpose                   AS Purpose,
	|		ProductStates.Series                        AS Series,
	|		MIN(
	|			CASE
	|				WHEN ProductStates.Count / Packages.NumberOfPackages -
	|						CAST(ProductStates.Count / Packages.NumberOfPackages AS NUMBER(12, 0)) >= 0
	|					THEN CAST(ProductStates.Count / Packages.NumberOfPackages AS NUMBER(12, 0))
	|				ELSE
	|					CAST(ProductStates.Count / Packages.NumberOfPackages AS NUMBER(12, 0)) - 1
	|			END)                                      AS Count,
	|		ProductStates.Products.WarehouseGroup AS WarehouseGroupOfProducts,
	|		ProductStates.DateOfShipment                 AS DateOfShipment,
	|		ProductStates.Priority                    AS Priority
	|	FROM
	|		StatesForSelectedGoods AS ProductStates
	|			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS Packages
	|			ON ProductStates.CargoItem = Packages.Ref
	|	WHERE
	|		ProductStates.State = 100
	|		AND ProductStates.CargoItem <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	GROUP BY
	|		ProductStates.ReferenceOrder,
	|		ProductStates.Products,
	|		ProductStates.Characteristic,
	|		ProductStates.Purpose,
	|		ProductStates.Series,
	|		ProductStates.DateOfShipment,
	|		ProductStates.Priority) AS ProductStates
	|
	|GROUP BY
	|	ProductStates.ReferenceOrder,
	|	ProductStates.Products,
	|	ProductStates.Characteristic,
	|	ProductStates.Purpose,
	|	ProductStates.Series,
	|	ProductStates.WarehouseGroupOfProducts,
	|	ProductStates.DateOfShipment,
	|	ProductStates.Priority";
	
	If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		
		ConditionGoodsForSelection = "
		|		INNER JOIN GoodsForSelectionTurnover AS GoodsForSelectionTurnover
		|		ON GoodsForPickingBalance.ReferenceOrder = GoodsForSelectionTurnover.ReferenceOrder
		|			AND GoodsForPickingBalance.Products = GoodsForSelectionTurnover.Products
		|			AND GoodsForPickingBalance.Characteristic = GoodsForSelectionTurnover.Characteristic
		|			AND GoodsForPickingBalance.Purpose = GoodsForSelectionTurnover.Purpose
		|			AND GoodsForPickingBalance.Series = GoodsForSelectionTurnover.Series
		|			AND GoodsForPickingBalance.CargoItem = GoodsForSelectionTurnover.CargoItem";
		
		Query.Text = StrReplace(Query.Text,"WHERE &ConditionGoodsForSelection", ConditionGoodsForSelection);
		Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
			AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
		Query.SetParameter("DimensionalTypesOfUnits",
			Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
		
		ConditionStateReadyForVerification = 
			"GoodsForPickingBalance.ForPickingBalance <= GoodsForPickingBalance.PickedBalance + CASE
			|			WHEN GoodsForPickingBalance.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
			|				THEN &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * ISNULL(GoodsForSelectionTurnover.Count,0)
			|			ELSE 0
			|		END";
		Query.Text = StrReplace(Query.Text,"&ConditionStateReadyForVerification", ConditionStateReadyForVerification);
		
		ConditionStateInProgress = 
			"GoodsForPickingBalance.ForPickingBalance <= GoodsForPickingBalance.PickedBalance + GoodsForPickingBalance.BeingPickedBalance
			|		+ CASE
			|			WHEN GoodsForPickingBalance.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
			|				THEN &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * ISNULL(GoodsForSelectionTurnover.Count,0)
			|			ELSE 0
			|		END";
		Query.Text = StrReplace(Query.Text,"&ConditionStateInProgress", ConditionStateInProgress);
		
	Else
		
		ConditionStateReadyForVerification = "GoodsForPickingBalance.ForPickingBalance <= GoodsForPickingBalance.PickedBalance";
		Query.Text = StrReplace(Query.Text,"&ConditionStateReadyForVerification", ConditionStateReadyForVerification);
		
		ConditionStateInProgress = 
			"GoodsForPickingBalance.ForPickingBalance <= GoodsForPickingBalance.PickedBalance + GoodsForPickingBalance.BeingPickedBalance";
		Query.Text = StrReplace(Query.Text,"&ConditionStateInProgress", ConditionStateInProgress);
		
		Query.Text = StrReplace(Query.Text,"WHERE &ConditionGoodsForSelection", "");
		
	EndIf;
	
	TempTablesManager = New TempTablesManager;
	
	Query.TempTablesManager = TempTablesManager;
	Query.SetParameter("Warehouse", Warehouse);
	Query.SetParameter("Premise", Premise);
	Query.SetParameter("DisplayingDetails", DisplayingDetails);
	Query.SetParameter("TransportationJob", TransportationJob);
	Query.SetParameter("UsedDelivery25", GoodsDeliveryClientServer.UsedDelivery25());
	
	Result = Query.ExecuteBatch();
	
	ThereAreUnfulfilledOrders = Result[Result.UBound()].Unload()[0].Count > 0;
	
	If ThereAreUnfulfilledOrders Then
		
		CalculateShortageOfPackagesForSelectionByOrder(TempTablesManager, Warehouse, Premise);
		
		Query = New Query;
		Query.TempTablesManager = TempTablesManager;
		Query.Text =
		"SELECT
		|	ProductStates.ReferenceOrder,
		|	MAX(ProductStates.State) AS State
		|INTO StatesByOrders
		|FROM
		|	(SELECT
		|		ProductStates.ReferenceOrder AS ReferenceOrder,
		|		ProductStates.State AS State
		|	FROM
		|		StatesForSelectedGoods AS ProductStates
		|	WHERE
		|		ProductStates.State <> 100
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		ProductStates.ReferenceOrder,
		|		ProductStates.State
		|	FROM
		|		StatesOfGoodsForSelection AS ProductStates) AS ProductStates
		|
		|GROUP BY
		|	ProductStates.ReferenceOrder";
		Query.Execute();
		
	Else
		
		Query = New Query;
		Query.TempTablesManager = TempTablesManager;
		Query.Text =
		"SELECT
		|	StatesForSelectedGoods.ReferenceOrder,
		|	MAX(StatesForSelectedGoods.State) AS State
		|INTO StatesByOrders
		|FROM
		|	StatesForSelectedGoods AS StatesForSelectedGoods
		|
		|GROUP BY
		|	StatesForSelectedGoods.ReferenceOrder";
		
		Query.Execute();
		
	EndIf;
		
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT DISTINCT
	|	PickingReferences.ReferenceOrder,
	|	PRESENTATION(VALUETYPE(PickingReferences.ReferenceOrder)) AS DocumentType,
	|	PickingReferences.DateOfShipment,
	|	PickingReferences.PriorityLink AS Priority,
	|	PickingReferences.Number,
	|	PickingReferences.ShippingZone,
	|	PickingReferences.Comment,
	|	CASE
	|		WHEN ISNULL(StatesByOrders.State, 100) = 0
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.ReadyForCheck)
	|		WHEN ISNULL(StatesByOrders.State, 100) = 1
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.DuringExecution)
	|		WHEN ISNULL(StatesByOrders.State, 100) = 2
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.ExecutedWithErrors)
	|		WHEN ISNULL(StatesByOrders.State, 100) = 3
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.ToJobGeneration)
	|		WHEN ISNULL(StatesByOrders.State, 100) = 4
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.PlacementOrReplenishmentIsInProgress)
	|		WHEN ISNULL(StatesByOrders.State, 100) = 5
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.PendingPlacement)
	|		WHEN ISNULL(StatesByOrders.State, 100) = 6
	|			THEN VALUE(Enum.StatesOfGoodsPickingReferences.ReplenishmentIsRequired)
	|		ELSE VALUE(Enum.StatesOfGoodsPickingReferences.EmptyRef)
	|	END AS State,
	|	CASE
	|		WHEN PickingReferences.ReferenceOrder REFS Document.TransportationJob
	|				AND &DisplayingDetails
	|			THEN 2
	|		WHEN PickingReferences.ReferenceOrder REFS Document.Trip
	|				AND &DisplayingDetails
	|			THEN 2
	|		WHEN PickingReferences.ReferenceOrder REFS Document.TransportationJob
	|				AND NOT &DisplayingDetails
	|			THEN 1
	|		WHEN PickingReferences.ReferenceOrder REFS Document.Trip
	|				AND NOT &DisplayingDetails
	|			THEN 1
	|		WHEN &DisplayingDetails
	|			THEN 3
	|		ELSE 0
	|	END AS PictureIndex
	|FROM
	|	PickingReferences AS PickingReferences
	|		LEFT JOIN StatesByOrders AS StatesByOrders
	|		ON PickingReferences.ReferenceOrder = StatesByOrders.ReferenceOrder
	|WHERE
	|	CASE
	|			WHEN ISNULL(StatesByOrders.State, 100) = 0
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.ReadyForCheck)
	|			WHEN ISNULL(StatesByOrders.State, 100) = 1
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.DuringExecution)
	|			WHEN ISNULL(StatesByOrders.State, 100) = 2
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.ExecutedWithErrors)
	|			WHEN ISNULL(StatesByOrders.State, 100) = 3
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.ToJobGeneration)
	|			WHEN ISNULL(StatesByOrders.State, 100) = 4
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.PlacementOrReplenishmentIsInProgress)
	|			WHEN ISNULL(StatesByOrders.State, 100) = 5
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.PendingPlacement)
	|			WHEN ISNULL(StatesByOrders.State, 100) = 6
	|				THEN VALUE(Enum.StatesOfGoodsPickingReferences.ReplenishmentIsRequired)
	|			ELSE VALUE(Enum.StatesOfGoodsPickingReferences.EmptyRef)
	|		END IN (&States1)
	|
	|ORDER BY
	|	BEGINOFPERIOD(PickingReferences.DateOfShipment, DAY),
	|	PickingReferences.PriorityLink,
	|	PickingReferences.DateOfShipment";
	
	States1 = New Array;
	If SelectionState = "" Then
		For Each Value In Enums.StatesOfGoodsPickingReferences Do 
			States1.Add(Value);
		EndDo;
	Else
		States1.Add(Enums.StatesOfGoodsPickingReferences[SelectionState]);
	EndIf;
	Query.SetParameter("States1", States1);			
	
	Query.SetParameter("DisplayingDetails", DisplayingDetails);
	
	PickingReferences.Load(Query.Execute().Unload());
	
	If DisplayingDetails Then
		NewRow = PickingReferences.Insert(0);
		NewRow.PictureIndex = 2;
		NewRow.ReferenceOrder = TransportationJob;
		NewRow.DocumentType = String(TypeOf(TransportationJob));
	EndIf;
	
EndProcedure

#EndRegion

#Region CreatingWarehouseDocuments

// Creates and edits spending orders for the warehouse for the recipient of goods, if the amount for the resources
// of the Accumulation register of Goods to ship is not equal to 0.
//
// Parameters:
//	Parameters - See ParametersForReissuingSpendingOrders.
//
// Returns:
//	Structure - a structure with the following properties:
//		*ExecutedOrders - ValueTable - a table containing links to orders and descriptions of actions performed with them:
//			** ExpenseOrder - DocumentRef.GoodsIssueNote -
//			** Number - String -
//			** DateOfShipment - Date -
//			** Warehouse - CatalogRef.Warehouses -
//			** Premise - CatalogRef.Warerooms -
//			** Action - String -
//		*HasError - Boolean - error flag.
//
Function ReissueSpendingOrders(Parameters) Export
	
	SetPrivilegedMode(True);
	Common.OnStartExecuteScheduledJob();
	
	ExecutedOrders = New ValueTable;
	ExecutedOrders.Columns.Add("ExpenseOrder",	New TypeDescription("DocumentRef.GoodsIssueNote"));
	ExecutedOrders.Columns.Add("Number",				New TypeDescription("String"));
	ExecutedOrders.Columns.Add("DateOfShipment",		New TypeDescription("Date"));
	ExecutedOrders.Columns.Add("Warehouse",				New TypeDescription("CatalogRef.Warehouses"));
	ExecutedOrders.Columns.Add("Premise",			New TypeDescription("CatalogRef.Warerooms"));
	ExecutedOrders.Columns.Add("Action",			New TypeDescription("String"));
	
	OrderRecorded	= False;
	HasError		= False;
	CurrentDate		= CurrentSessionDate();
	
	StartShipmentOnceDeliveryOrderIsCreated = WarehousesServer.StartShipmentOnceDeliveryOrderIsCreated(Parameters.Warehouse);
	InvoicesFirst = Constants.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.Get() = Enums.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.InvoicesFirst;
	
	If Not Parameters.Property("CreatedSpendingOrders") Then
		MergeOrdersForCurDate(Parameters, CurrentDate, ExecutedOrders);
	EndIf;
	
	StructureOfGoodsForExecutionOfExpenditureOrders = CalculateGoodsForIssuingSpendingOrders(
													Parameters,
													StartShipmentOnceDeliveryOrderIsCreated,
													InvoicesFirst);
	
	TreeGoodsForShipment	= StructureOfGoodsForExecutionOfExpenditureOrders.TreeGoodsForShipment;
	ProductsReadyForAssembly			= StructureOfGoodsForExecutionOfExpenditureOrders.ProductsReadyForAssembly;
	
	If Not Parameters.Property("CreatedSpendingOrders") Then
		ReduceNumberOfOrders(ProductsReadyForAssembly, ExecutedOrders, OrderRecorded);
	EndIf;
	
	RequestProductTable = GoodsToShipForReissueOfExpenditureOrders(
										TMCommonUse.TreeData(TreeGoodsForShipment, 7));
	RequestProductTable = DistributeNegativeNumbers(RequestProductTable);
	
	Query = New Query;
	Query.Text = QueryTextWarehouseOperationDocumentType() +
	"SELECT
	|	CASE
	|		WHEN ProductsTable.ShipmentUnderTransportationJob
	|				AND VALUETYPE(ProductsTable.TransportationJob) = TYPE(Document.Trip)
	|			THEN ProductsTable.Period
	|		WHEN &CurrentDate > ProductsTable.Period
	|			THEN &CurrentDate
	|		ELSE ProductsTable.Period
	|	END												AS DateOfShipment,
	|	ProductsTable.Warehouse							AS Warehouse,
	|	ProductsTable.DocumentShipments				AS DocumentShipments,
	|	ProductsTable.Recipient						AS Recipient,
	|	ProductsTable.Products					AS Products,
	|	ProductsTable.Characteristic					AS Characteristic,
	|	ProductsTable.Purpose						AS Purpose,
	|	ProductsTable.ControlledLotReference			AS ControlledLotReference,
	|	ProductsTable.Series							AS Series,
	|	ProductsTable.Count						AS Count,
	|	ProductsTable.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	ProductsTable.TransportationJob				AS TransportationJob,
	|	ProductsTable.AllowableVariance			AS AllowableVariance
	|INTO RequestProductTable
	|FROM
	|	&RequestProductTable AS ProductsTable
	|WHERE
	|	ProductsTable.Count > ProductsTable.AllowableVariance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsTable.Warehouse					AS Warehouse,
	|	ProductsTable.Products			AS Products,
	|	ProductsTable.Characteristic			AS Characteristic,
	|	ProductsTable.Purpose				AS Purpose,
	|	ProductsTable.ControlledLotReference	AS ControlledLotReference,
	|	ProductsTable.Series					AS Series,
	|	SUM(ProductsTable.Count)		AS Count
	|INTO ProductsTable
	|FROM
	|	RequestProductTable AS ProductsTable
	|
	|GROUP BY
	|	ProductsTable.Warehouse,
	|	ProductsTable.Characteristic,
	|	ProductsTable.Products,
	|	ProductsTable.Series,
	|	ProductsTable.Purpose,
	|	ProductsTable.ControlledLotReference
	|
	|INDEX BY
	|	Warehouse,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsTable.DateOfShipment					AS DateOfShipment,
	|	ProductsTable.Warehouse							AS Warehouse,
	|	ProductsTable.DocumentShipments				AS ReferenceOrder,
	|	CASE
	|		WHEN ISNULL(CAST(ProductsTable.DocumentShipments AS Document.SalesOrder).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				OR ISNULL(CAST(ProductsTable.DocumentShipments AS Document.TransferOfGoodsToBailee).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				OR ISNULL(CAST(ProductsTable.DocumentShipments AS Document.GoodsShipmentToCustomer).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				OR ISNULL(CAST(ProductsTable.DocumentShipments AS Document.CustomerInvoice).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|			THEN ProductsTable.DocumentShipments
	// Limit, one spending order per controlled Lot reference.
	|		WHEN ProductsTable.ControlledLotReference <> VALUE(Catalog.ControlledLots.EmptyRef)
	|			THEN ProductsTable.DocumentShipments
	|		ELSE UNDEFINED
	|	END												AS OrderGrouping,
	|	WarehouseOperationDocumentType.WarehouseOperation		AS WarehouseOperation,
	|	ProductsTable.Recipient						AS Recipient,
	|	ProductsTable.Products					AS Products,
	|	ISNULL(ProductData_1.Description, """")		AS NomenclatureName,
	|	CASE
	|		WHEN ProductData_1.UnitOfMeasure IS NULL
	|			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|		ELSE ProductData_1.UnitOfMeasure
	|	END												AS UnitOfMeasure,
	|	ProductsTable.Characteristic					AS Characteristic,
	|	ISNULL(TheseCharacteristics.Description, """")	AS CharacteristicName,
	|	ProductsTable.Purpose						AS Purpose,
	|	ProductsTable.ControlledLotReference			AS ControlledLotReference,
	|	ProductsTable.Series							AS Series,
	|	SUM(ProductsTable.Count)				AS Count,
	|	ProductsTable.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	ProductsTable.TransportationJob				AS TransportationJob,
	|	ProductsTable.AllowableVariance			AS AllowableVariance
	|FROM
	|	RequestProductTable AS ProductsTable
	|		LEFT JOIN WarehouseOperationDocumentType AS WarehouseOperationDocumentType
	|		ON VALUETYPE(ProductsTable.DocumentShipments) = WarehouseOperationDocumentType.Type
	|			AND CASE
	|				WHEN ProductsTable.DocumentShipments REFS Document.ByAssemblyDisassemblyOrder
	|					THEN CAST(ProductsTable.DocumentShipments AS Document.ByAssemblyDisassemblyOrder).BusinessOperation
	|				WHEN ProductsTable.DocumentShipments REFS Document.AssemblyFromComponents
	|					THEN CAST(ProductsTable.DocumentShipments AS Document.AssemblyFromComponents).BusinessOperation
	|				WHEN ProductsTable.DocumentShipments REFS Document.GoodsShipmentFromStorage
	|					THEN CAST(ProductsTable.DocumentShipments AS Document.GoodsShipmentFromStorage).BusinessOperation
	|				ELSE UNDEFINED
	|			END = WarehouseOperationDocumentType.BusinessOperation
	|		
	|		LEFT JOIN Catalog.Products AS ProductData_1
	|		ON ProductsTable.Products = ProductData_1.Ref
	|		
	|		LEFT JOIN Catalog.ItemsCharacteristics AS TheseCharacteristics
	|		ON ProductsTable.Characteristic = TheseCharacteristics.Ref
	|
	|GROUP BY
	|	ProductsTable.DateOfShipment,
	|	ProductsTable.Warehouse,
	|	ProductsTable.DocumentShipments,
	|	CASE
	|		WHEN ISNULL(CAST(ProductsTable.DocumentShipments AS Document.SalesOrder).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				OR ISNULL(CAST(ProductsTable.DocumentShipments AS Document.TransferOfGoodsToBailee).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				OR ISNULL(CAST(ProductsTable.DocumentShipments AS Document.GoodsShipmentToCustomer).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				OR ISNULL(CAST(ProductsTable.DocumentShipments AS Document.CustomerInvoice).Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|			THEN ProductsTable.DocumentShipments
	|		WHEN ProductsTable.ControlledLotReference <> VALUE(Catalog.ControlledLots.EmptyRef)
	|			THEN ProductsTable.DocumentShipments
	|		ELSE UNDEFINED
	|	END,
	|	WarehouseOperationDocumentType.WarehouseOperation,
	|	ProductsTable.Recipient,
	|	ProductsTable.Products,
	|	ISNULL(ProductData_1.Description, """"),
	|	CASE
	|		WHEN ProductData_1.UnitOfMeasure IS NULL
	|			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|		ELSE ProductData_1.UnitOfMeasure
	|	END,
	|	ProductsTable.Characteristic,
	|	ISNULL(TheseCharacteristics.Description, """"),
	|	ProductsTable.Purpose,
	|	ProductsTable.ControlledLotReference,
	|	ProductsTable.Series,
	|	ProductsTable.ShipmentUnderTransportationJob,
	|	ProductsTable.TransportationJob,
	|	ProductsTable.AllowableVariance
	|
	|ORDER BY
	|	NomenclatureName,
	|	CharacteristicName,
	|	DateOfShipment
	|
	|TOTALS BY
	|	ShipmentUnderTransportationJob,
	|	TransportationJob,
	|	Warehouse,
	|	Recipient,
	|	OrderGrouping,
	|	DateOfShipment,
	|	WarehouseOperation
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductStockBalance.Warehouse					AS Warehouse,
	|	ProductStockBalance.Premise				AS Premise,
	|	ProductStockBalance.Products				AS Products,
	|	ProductStockBalance.Characteristic			AS Characteristic,
	|	ProductStockBalance.Purpose				AS Purpose,
	|	ProductStockBalance.ControlledLotReference		AS ControlledLotReference,
	|	ProductsTable.Series						AS Series,
	|	SUM(0)										AS RoomRating,
	|	SUM(0)										AS TotalCount1,
	|	SUM(0)										AS AmountInBaseSpent,
	|	SUM(ProductStockBalance.InStockBalance
	|		- ProductStockBalance.ToShipBalance) AS FreeBalanceInBasic
	|FROM
	|	AccumulationRegister.ProductStock.Balance(
	|			,
	|			(Warehouse, Products, Characteristic, Purpose, ControlledLotReference) IN
	|				(SELECT DISTINCT
	|					ProductsTable.Warehouse,
	|					ProductsTable.Products,
	|					ProductsTable.Characteristic,
	|					ProductsTable.Purpose,
	|					ProductsTable.ControlledLotReference
	|				FROM
	|					ProductsTable AS ProductsTable)
	|			AND (&ByAllWarerooms
	|				OR Premise = &Premise)
	|	
	|	) AS ProductStockBalance
	|		INNER JOIN ProductsTable AS ProductsTable
	|		ON ProductStockBalance.Warehouse = ProductsTable.Warehouse
	|			AND ProductStockBalance.Products = ProductsTable.Products
	|			AND ProductStockBalance.Characteristic = ProductsTable.Characteristic
	|			AND ProductStockBalance.Purpose = ProductsTable.Purpose
	|			AND ProductStockBalance.ControlledLotReference = ProductsTable.ControlledLotReference
	|			AND (ProductStockBalance.Series = ProductsTable.Series
	|				OR ProductsTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef))
	|
	|GROUP BY
	|	ProductStockBalance.Warehouse,
	|	ProductStockBalance.Premise,
	|	ProductStockBalance.Products,
	|	ProductStockBalance.Characteristic,
	|	ProductStockBalance.Purpose,
	|	ProductStockBalance.ControlledLotReference,
	|	ProductsTable.Series
	|
	|HAVING
	|	SUM(ProductStockBalance.InStockBalance - ProductStockBalance.ToShipBalance) > 0
	|
	|ORDER BY
	|	ProductStockBalance.Products.Description,
	|	ProductStockBalance.Characteristic.Description
	|
	|TOTALS
	|	SUM(RoomRating),
	|	SUM(TotalCount1)
	|BY
	|	Premise";
	
	Query.SetParameter("CurrentDate", CurrentDate);
	Query.SetParameter("Premise", Parameters.Premise);
	Query.SetParameter("ByAllWarerooms", Not ValueIsFilled(Parameters.Premise));
	Query.SetParameter("RequestProductTable", RequestProductTable);
	
	ResultsArray = Query.ExecuteBatch();
	
	ProductTree		= ResultsArray[3].Unload(QueryResultIteration.ByGroups); // ValueTree -
	TreeByRoom	= ResultsArray[4].Unload(QueryResultIteration.ByGroups); // ValueTree -
	
	SearchParameterNames= "Warehouse, Premise, ShippingZone, Recipient, OrderGrouping,
		|ShipmentReferences, WarehouseOperation, DateOfShipment, CurrentDate, ShipmentUnderTransportationJob,
		|TransportationJob, ControlledLotReference";
	SpendingOrderSearchParameters = New Structure(SearchParameterNames);
	
	NamesOfSelectionByRoom	= "Products, Characteristic, Purpose, ControlledLotReference, Series";
	SelectionByRoom		= New Structure(NamesOfSelectionByRoom);
	
	GoodsSelectionNames	= "Warehouse, Products, Characteristic, Purpose, Series";
	FilterOfProducts_		= New Structure(GoodsSelectionNames);
	
	NamesOfSelectionOfGoodsByOrder	= "ReferenceOrder, Products, Characteristic, Purpose, Series";
	SelectionOfGoodsByOrder			= New Structure(NamesOfSelectionOfGoodsByOrder);
	
	ErrorsTable = RequestProductTable.CopyColumns("Warehouse, Products, Characteristic, Purpose,
		|ControlledLotReference, Series, Count");
	ErrorsTable.Columns.Add("UnitOfMeasure", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	
	For Each LevelShipmentByTransportTask In ProductTree.Rows Do	
		For Each TransportTaskLevel In LevelShipmentByTransportTask.Rows Do
			
			If ValueIsFilled(Parameters.TransportationJob) Then
				TransportationJob = Parameters.TransportationJob;
			Else
				TransportationJob = TransportTaskLevel.TransportationJob;
			EndIf;
			
			For Each WarehouseLevel In TransportTaskLevel.Rows Do 
				
				For Each RecipientLevel In WarehouseLevel.Rows Do
					
					For Each LevelOrder In RecipientLevel.Rows Do
					
						For Each LevelShipmentDate In LevelOrder.Rows Do
							
							For Each WarehouseOperationLevel In LevelShipmentDate.Rows Do
								
								ProductsTable = WarehouseOperationLevel.Rows;
								
								AllQuantityIsIssuedOnPremises = False;
								
								// If there are no residues at all on the premises
								If TreeByRoom.Rows.Count() = 0 Then
									For Each String In ProductsTable Do
										ErrorTableRow = ErrorsTable.Add();
										FillPropertyValues(ErrorTableRow,String);
									EndDo;
									
									Break;
								EndIf;
								
								ArrayOfBestRooms = New Array;
								UsePremises = WarehousesServer.UseWarerooms(
															WarehouseOperationLevel.Warehouse,
															WarehouseOperationLevel.DateOfShipment,
															True);
								
								// 1. We rank the premises by the sum of the degree of collection of each position.
								// 2. Create a document for the best room.
								// 3. From the quantity to be shipped, we subtract the quantity already included in the document.
								// 4. For all rooms, except the best, we conduct a ranking
								// (because the number in each position could decrease, the rating of the room could change).
								
								While ProductsTable.Count() > 0 Do
									
									// The rating indicated in the lines by room needs to be cleared:
									// - when did you switch to the new order
									// - when you have chosen the goods of the best premises and you need to recalculate the rating of the remaining premises.
									YouNeedToZeroRatingOfRowsByRoom = True;
									
									// If there are no residues at all on the premises
									If TreeByRoom.Rows.Count() = 0 Then
										Break;
									EndIf;
									
									TotalCount1 = ProductsTable.Total("Count");
									OrderPremises = New Map;
									PremisesGoods = New Map;
									
									For Each RowOfTables In ProductsTable Do
										
										For Each RowRoom In TreeByRoom.Rows Do
											
											If UsePremises
												And Not ValueIsFilled(RowRoom.Premise) Then
												
												Continue;
												
											EndIf;
											
											If YouNeedToZeroRatingOfRowsByRoom Then
												RowRoom.TotalCount1	= 0;
												RowRoom.RoomRating	= 0;
											EndIf;
											
											If ArrayOfBestRooms.Find(RowRoom.Premise) <> Undefined Then
												Continue;
											EndIf;
											
											DocumentObject	= OrderPremises.Get(RowRoom.Premise);
											ProductsInOrder_	= PremisesGoods.Get(RowRoom.Premise);
											
											If DocumentObject = Undefined Then
												FillPropertyValues(
													SpendingOrderSearchParameters,
													WarehouseOperationLevel,
													"Warehouse, Recipient, OrderGrouping, WarehouseOperation,
													|DateOfShipment, ShipmentUnderTransportationJob");
												FillPropertyValues(
													SpendingOrderSearchParameters,
													Parameters,
													"ShippingZone, ShipmentReferences");
												
												SpendingOrderSearchParameters.Premise = RowRoom.Premise;
												SpendingOrderSearchParameters.CurrentDate = CurrentDate;
												SpendingOrderSearchParameters.TransportationJob = TransportationJob;
												SpendingOrderSearchParameters.ControlledLotReference = RowOfTables.ControlledLotReference;
												
												If Parameters.Property("CreatedSpendingOrders") Then
													String = Parameters.CreatedSpendingOrders.Find(False, "WasUsed");
													If Not String = Undefined Then
														DocumentObject = FillOutSpendingOrderForGoods(
																			SpendingOrderSearchParameters,
																			String.DocumentObject);
														
														String.WasUsed = True;
													Else 
														DocumentObject = FillOutSpendingOrderForGoods(
																			SpendingOrderSearchParameters,
																			Documents.GoodsIssueNote.CreateDocument());
													EndIf;
												Else
													DocumentObject = GetOrderObject(SpendingOrderSearchParameters);
												EndIf;
												
												OrderPremises.Insert(RowRoom.Premise, DocumentObject);
												
												ProductsInOrder_ = DocumentObject.GoodsByReferences.UnloadColumns();
												PremisesGoods.Insert(RowRoom.Premise, ProductsInOrder_);
												
											EndIf;
											
											FillPropertyValues(SelectionByRoom, RowOfTables);
											
											RowsArray = RowRoom.Rows.FindRows(SelectionByRoom);
											
											If RowsArray.Count() = 0 Then
												Continue;
											EndIf;
											
											Products = RowsArray[0];
											
											QuantityPerDocument = Min(Products.FreeBalanceInBasic - Products.AmountInBaseSpent, RowOfTables.Count);
											
											If QuantityPerDocument = 0 Then
												Continue;
											EndIf;
											
											NewProductLine = DocumentObject.GoodsByReferences.Add();
											FillPropertyValues(NewProductLine, RowOfTables);
											NewProductLine.Count = QuantityPerDocument;
											
											NewLineProductsInOrder = ProductsInOrder_.Add();
											FillPropertyValues(NewLineProductsInOrder, NewProductLine);
											
											// We do not immediately reduce the free balance, because if the room is not the best, we will not take it from it.
											Products.AmountInBaseSpent = Products.AmountInBaseSpent
												+ QuantityPerDocument;
											
											RowRoom.TotalCount1 = RowRoom.TotalCount1
												+ QuantityPerDocument;
											
											// Strtable.The quantity is not equal to zero: it is checked in the query and when the quantity is reduced in the table of the Nomenclature table.
											RowRoom.RoomRating = RowRoom.RoomRating
												+ QuantityPerDocument / RowOfTables.Count;
											
										EndDo;
										
										YouNeedToZeroRatingOfRowsByRoom = False;
										
									EndDo;
									
									TreeByRoom.Rows.Sort("RoomRating DESC, TotalCount1 DESC");
									
									BestRoom = TreeByRoom.Rows[0];
									
									If UsePremises
										And Not ValueIsFilled(BestRoom.Premise) Then
										
										If TreeByRoom.Rows.Count() > 1 Then
											BestRoom = TreeByRoom.Rows[1];
										Else
											Break;
										EndIf;
										
									EndIf;
									
									// If there is no remainder in the premises for this order
									If BestRoom.RoomRating = 0 Then
										Break;
									EndIf;
									
									DocumentObject = OrderPremises[BestRoom.Premise];
									
									If Parameters.Property("CreatedSpendingOrders") Then
										// We clear the goods in the orders for the non-best premises
										For Each Page1 In TreeByRoom.Rows Do
											If Not Page1 = BestRoom Then 
												String = Parameters.CreatedSpendingOrders.Find(OrderPremises[Page1.Premise], "DocumentObject");
												
												If Not String = Undefined Then
													String.WasUsed = False;
													String.DocumentObject.GoodsByReferences.Clear();
												EndIf;
											EndIf;
										EndDo;
									EndIf;
									
									ProductsInOrder_ = PremisesGoods[BestRoom.Premise];
									
									If DocumentObject.GoodsByReferences.Count() > 0 Then
										Object_New = Not DocumentObject.Posted;
										
										If Not WriteOrderObject(DocumentObject, Parameters.BackgroundJob) Then
											HasError = True;
										EndIf;
										
										If Not HasError
											And DocumentObject.Posted Then
											
											If Object_New Then
												ExecutedOrdersLine = ExecutedOrders.Add();
												FillPropertyValues(ExecutedOrdersLine, DocumentObject);
												
												ExecutedOrdersLine.ExpenseOrder	= DocumentObject.Ref;
												ExecutedOrdersLine.Action		= NStr("vi = 'Tạo mới';
																						|ru = 'Создан новый';
																						|en = 'New is created'; fa = 'New is created';
																						|it = 'Creato nuovo';
																						|pl = 'Stworzony nowy';
																						|tr = 'Yenisi oluşturuldu'");
											Else
												If ExecutedOrders.Find(DocumentObject.Ref, "ExpenseOrder") = Undefined Then
													ExecutedOrdersLine = ExecutedOrders.Add();
													FillPropertyValues(ExecutedOrdersLine, DocumentObject);
													
													ExecutedOrdersLine.ExpenseOrder	= DocumentObject.Ref;
													ExecutedOrdersLine.Action		= NStr("vi = 'Tạo lại';
																							|ru = 'Переоформлен';
																							|en = 'Reregister'; fa = 'Reregister';
																							|it = 'Emesso nuovamente';
																							|pl = 'Reregister';
																							|tr = 'Yeniden düzenlendi'");
												EndIf;
											EndIf;
											
										EndIf;
										
										OrderRecorded = True;
									EndIf;
									
									// If not the last line by recipient, warehouse, date of shipment and scl. operation,
									// then in the best room it is necessary to reduce the free balance.
									If ProductTree.Rows.Count() - 1 > ProductTree.Rows.IndexOf(WarehouseOperationLevel) Then
										
										// The room is selected - you can reduce the free balance
										For Each RowProducts_ In ProductsInOrder_ Do
											FillPropertyValues(FilterOfProducts_, RowProducts_);
											FilterOfProducts_.Warehouse = WarehouseOperationLevel.Warehouse;
											
											ProductsRow = BestRoom.Rows.FindRows(FilterOfProducts_);
											
											If ProductsRow.Count() > 0 Then
												Products = ProductsRow[0];
												Products.FreeBalanceInBasic = Products.FreeBalanceInBasic
													- Products.AmountInBaseSpent;
												Products.AmountInBaseSpent = 0;
												
												// To search faster in the future, delete the empty string
												If Products.FreeBalanceInBasic = 0 Then 
													BestRoom.Rows.Delete(Products);
												EndIf;
												
											EndIf;
											
										EndDo;
										
									EndIf;
									
									// Cleaning up the amount of waste spent
									For Each RowsByRoom In TreeByRoom.Rows Do
										For Each Rows In RowsByRoom.Rows Do
											Rows.AmountInBaseSpent = 0;
										EndDo;
										If BestRoom <> RowsByRoom Then
											RowsByRoom.TotalCount1  = 0;
											RowsByRoom.RoomRating = 0;
										EndIf;
									EndDo;
									
									If BestRoom.TotalCount1 = TotalCount1 Then
										AllQuantityIsIssuedOnPremises = True;
									EndIf;
									
									If BestRoom.TotalCount1 = TotalCount1
										Or BestRoom.TotalCount1 = 0
										Or ArrayOfBestRooms.Count() = TreeByRoom.Rows.Count() Then
										
										// If we have collected it completely,
										// or we have not collected it at all, we interrupt the cycle along the lines of the order
										// or we have sorted through all the rooms.
										BestRoom.TotalCount1   = 0;
										BestRoom.RoomRating  = 0;
										
										Break;
										
									Else
										BestRoom.TotalCount1   = 0;
										BestRoom.RoomRating  = 0;
										
										ProductsInOrder_.GroupBy(NamesOfSelectionOfGoodsByOrder, "Count");
										
										For Each RowOfTables In ProductsInOrder_ Do
											FillPropertyValues(SelectionOfGoodsByOrder, RowOfTables);
											
											RowsInProductTable = ProductsTable.FindRows(SelectionOfGoodsByOrder);
											
											If RowsInProductTable.Count() = 0 Then
												Continue;
											EndIf;
											
											RowOfProductTable = RowsInProductTable[0];
											RowOfProductTable.Count = RowOfProductTable.Count - RowOfTables.Count;
											
											If RowOfProductTable.Count <= RowOfProductTable.AllowableVariance Then
												ProductsTable.Delete(RowOfProductTable);
											EndIf;
											
										EndDo;
										
									EndIf;
									
									ArrayOfBestRooms.Add(BestRoom.Premise);
									
									// If there are no goods in the room, it can be removed from the room tree
									If BestRoom.Rows.Count() = 0 Then
										TreeByRoom.Rows.Delete(BestRoom);
									EndIf;
									
								EndDo;
								
								If Not AllQuantityIsIssuedOnPremises Then
									For Each String In ProductsTable Do
										ErrorTableRow = ErrorsTable.Add();
										FillPropertyValues(ErrorTableRow, String);
									EndDo;
								EndIf;
								
							EndDo;
						EndDo;
					EndDo;
				EndDo;
			EndDo;
		EndDo;
	EndDo;
	
	If Not OrderRecorded
		And ErrorsTable.Count() = 0 Then
		
		HasError = True;
		
		If ValueIsFilled(Parameters.Recipient) Then
			MessageText = NStr("vi = 'Chưa tạo phiếu xuất kho theo lệnh giao hàng đối với người nhận ""%Recipient%"" và kho bãi ""%Warehouse%"". Có thể có các nguyên nhân:
			|- tất cả hàng hóa đang (đã) tập hợp %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|ru = 'Расходные ордера по распоряжениям на отгрузку для получателя ""%Recipient%"" и склада ""%Warehouse%"" не созданы. Возможные причины:
			|- все товары уже собираются (собраны)%InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|en = 'Goods issues under shipment references for the ""%Recipient%"" recipient and the ""%Warehouse%"" warehouse are not created. Possible reasons:
			|- All goods are already being assembled (have been assembled) %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.'; fa = 'Goods issues under shipment references for the ""%Recipient%"" recipient and the ""%Warehouse%"" warehouse are not created. Possible reasons:
			|- All goods are already being assembled (have been assembled) %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|it = 'I mandati di pagamento in base alle disposizioni di spedizione per il destinatario ""%Recipient%"" e magazzino ""%Warehouse%"" non sono stati creati. Possibili cause:
			|- tutte le merci sono già in fase di assemblaggio (assemblate)%InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|pl = 'Zlecenia wydania wg zamówień na wysyłkę do odbiorcy ""%Recipient%"" i magazynu ""%Warehouse%"" nie zostały utworzone. Możliwe przyczyny:
			|- wszystkie wiersze pozycji już są zbierane (zebrane) %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|tr = '""%Recipient%"" alıcısı ve ""%Warehouse%"" ambarı için ambar çıkış fişleri oluşturulmadı. Olası nedenleri:
			|- tüm ürünler zaten toplanıyor (toplanmış)%InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.'");
			MessageText = StrReplace(MessageText, "%Recipient%", String(Parameters.Recipient));
		Else
			MessageText = NStr("vi = 'Chưa tạo phiếu xuất kho theo lệnh giao hàng đối với kho bãi ""%Warehouse%"". Có thể có các nguyên nhân:
			|- tất cả hàng hóa đang (đã) tập hợp %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|ru = 'Расходные ордера по распоряжениям на отгрузку для склада ""%Warehouse%"" не созданы. Возможные причины:
			|- все товары уже собираются (собраны)%InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|en = 'Goods issues under shipment references for the ""%Warehouse%"" warehouse are not created. Possible reasons:
			|- All goods are already being assembled (have been assembled) %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.'; fa = 'Goods issues under shipment references for the ""%Warehouse%"" warehouse are not created. Possible reasons:
			|- All goods are already being assembled (have been assembled) %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|it = 'I mandati di pagamento in base alle disposizioni di spedizione per il magazzino ""%Warehouse%"" non sono stati creati. Possibili cause:
			|- tutte le merci sono già in fase di assemblaggio (assemblate)%InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|pl = 'Zlecenia wydania wg zamówień na wysyłkę do magazynu ""%Warehouse%"" nie zostały utworzone. Możliwe przyczyny:
			|- wszystkie wiersze pozycji już są zbierane (zebrane) %InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.';
			|tr = '""%Warehouse%"" ambarı için sevkiyat talimatı kapsamındaki ambar çıkış fişleri oluşturulmadı. Olası nedenler:
			|- tüm ürünler zaten toplanmış (monte edilmiş)%InvoicesFirst%%StartShipmentOnceDeliveryOrderIsCreated%.'");
		EndIf;
		
		MessageText = StrReplace(MessageText, "%Warehouse%", String(Parameters.Warehouse));
		
		If InvoicesFirst Then
			MessageText = StrReplace(MessageText, "%InvoicesFirst%", NStr("vi = ';
			|- chưa lập hóa đơn';
			|ru = ';
			|- не оформлены накладные';
			|en = ';
			|- invoices are not created'; fa = ';
			|- invoices are not created';
			|it = ';
			|- lettere di vettura non emesse';
			|pl = ';
			|- deklaracje celne nie są zatwierdzone';
			|tr = ';
			|- hiçbir irsaliye düzenlenmemiştir'"));
		Else
			MessageText = StrReplace(MessageText, "%InvoicesFirst%", "");
		EndIf;
		
		If StartShipmentOnceDeliveryOrderIsCreated Then
			
			If GoodsDeliveryClientServer.UsedDelivery20() Then
				
				ErrorAddition = NStr("vi = ';
										|- chưa tạo nhiệm vụ vận chuyển';
										|ru = ';
										|- не оформлены задания на перевозку';
										|en = ';
										|- Itineraries are not registered'; fa = ';
										|- Itineraries are not registered';
										|it = ';
										|- incarichi di trasporto non emessi';
										|pl = ';
										|- zadania przewozowe nie są zatwierdzone';
										|tr = ';
										|- taşıma planı düzenlenmemiştir'");
				
			Else
				
				ErrorAddition = NStr("ru = ';
										|- не оформлены рейсы';
										|vi = ';
										|- Trips are not registered';
										|en = ';
										|- Trips are not registered'; fa = ';
										|- Trips are not registered';
										|it = ';
										|- Trips are not registered';
										|pl = ';
										|- Trips are not registered';
										|tr = ';
										| - seferler oluşturulmamış'");
				
			EndIf;
			
		Else
			
			ErrorAddition = "";
			
		EndIf;
		
		MessageText = StrReplace(
			MessageText,
			"%StartShipmentOnceDeliveryOrderIsCreated%",
			ErrorAddition);
		
		Common.MessageToUser(MessageText);
		
	ElsIf ErrorsTable.Count() > 0 Then	
		
		HasError = True;
		
		MessageTemplate = NStr("ru = 'Номенклатура %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		|Недостаточно для отгрузки на складе ""%Warehouse%"" %Count% %Unit%';
		|vi = 'Item %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		|Not enough for shipment in the %Warehouse% warehouse %Count% %Unit%';
		|en = 'Item %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		|Not enough for shipment in the %Warehouse% warehouse %Count% %Unit%'; fa = 'Item %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		|Not enough for shipment in the %Warehouse% warehouse %Count% %Unit%';
		|it = 'Item %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		|Not enough for shipment in the %Warehouse% warehouse %Count% %Unit%';
		|pl = 'Item %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		|Not enough for shipment in the %Warehouse% warehouse %Count% %Unit%';
		|tr = 'Öğe %ProductsCharacteristic% %Purpose% %ControlledLotReference%
		| ""%Warehouse%"" ambarında sevkiyat için yetersiz %Count% %Unit%'");
		
		ErrorsTable.GroupBy("Warehouse, Products, Characteristic, Purpose, ControlledLotReference, Series,
								|UnitOfMeasure","Count");
		
		For Each StringError In ErrorsTable Do
			ProductPresentation = ProductsClientServer.ProductPresentation(
											StringError.Products,
											StringError.Characteristic,
											StringError.Series);
			Purpose = ?(ValueIsFilled(StringError.Purpose), "(" + String(StringError.Purpose) + ")", "");
			ControlledLotReference = ?(ValueIsFilled(StringError.ControlledLotReference),
									"(" + String(StringError.ControlledLotReference) + ")",
									"");
			
			MessageText = StrReplace(MessageTemplate, "%ProductsCharacteristic%", ProductPresentation);
			MessageText = StrReplace(MessageText, "%Warehouse%", String(StringError.Warehouse));
			MessageText = StrReplace(MessageText, "%Count%", String(StringError.Count));
			MessageText = StrReplace(MessageText, "%Unit%", String(StringError.UnitOfMeasure));
			MessageText = StrReplace(MessageText, "%Purpose%", Purpose);
			MessageText = StrReplace(MessageText, "%ControlledLotReference%", ControlledLotReference);
			
			Common.MessageToUser(MessageText);
		EndDo;
		
	EndIf;
	
	Return New Structure("ExecutedOrders, HasError", ExecutedOrders, HasError);
	
EndFunction

// Procedure creates jobs at the repackaging, which have movement in the selection
// 
// Parameters:
//  ParametersStructure	 - Structure	 - a structure that has the following keys:
//  	*Warehouse - CatalogRef.Warehouses - link to the warehouse that is specified in the expense orders;
//  	*Premise - CatalogRef.Warerooms - a link to a room that is specified in the expense orders,
//  		or an empty link in the "Storage rooms" directory";
//  	*ByAllReferences - Boolean - True if you create orders for all orders
//  		False if executed according to the instructions specified in the array of Extensions parameter;
//  	*ReferenceArray - Array - array of links to spending orders that need to be used to create selection tasks,
//  		optional parameter if the parameter for all orders = True;
//  	*WarehouseZone - CatalogRef.WarehouseZones - link to the work area for which selection tasks will be generated;
//  	*CustomizeGenerationByWorkAreas - String - possible values:
//  		of "Fight against the working stages", "At the same working stage", "No fight against the working stages";
//  	*LimitByVolume - Boolean - setting the work area;
//  	*LimitByWeight - Boolean - setting the work area;
//  	*LimitationByVolume - Number - setting the work area;
//  	*LimitationByWeight - Number - setting the work area;
//  	*Performer - CatalogRef.Users - link to the system user that will be specified in the created selection tasks,
//  		optional parameter;
Procedure CreateRepackagingJobs(ParametersStructure) Export
	
	Warehouse = ParametersStructure.Warehouse;
	Premise = ParametersStructure.Premise;
	
	WarehouseZone = ParametersStructure.WarehouseZone;
	CustomizeGenerationByWorkAreas = ParametersStructure.CustomizeGenerationByWorkAreas;
	
	LimitByWeight = ParametersStructure.LimitByWeight;
	LimitationByWeight = ParametersStructure.LimitationByWeight;
	
	LimitByVolume = ParametersStructure.LimitByVolume;
	LimitationByVolume = ParametersStructure.LimitationByVolume;
	
	ReferenceArray = ParametersStructure.ReferenceArray;
	ByAllReferences = ParametersStructure.ByAllReferences;
	
	Performer = ParametersStructure.Performer;
	
	AllRefsType = Documents.AllRefsType();
	
	IndexOf = ReferenceArray.Count();
	While IndexOf > 0 Do
		
		IndexOf = IndexOf - 1;
		ReferenceOrder = ReferenceArray[IndexOf];
		If Not AllRefsType.Types().Find(TypeOf(ReferenceOrder)) <> Undefined Then
			ReferenceArray.Delete(IndexOf);
		EndIf;
		
	EndDo;
	
	If ReferenceArray.Count() = 0
		And Not ByAllReferences Then
		
		MessageText = NStr("vi = 'Không có vị trí chọn đã tách riêng.';
							|ru = 'Нет выделенных распоряжений на отбор.';
							|en = 'No selected references for selection.'; fa = 'No selected references for selection.';
							|it = 'Nessuna disposizione di selezione selezionata.';
							|pl = 'Nie ma zaznaczonych zamówień dla filtru.';
							|tr = 'Seçilen filtre siparişleri mevcut değil'");
		Common.MessageToUser(MessageText);
		Return;
		
	EndIf;
	
	If ByAllReferences Then
		
		Query = New Query;
		Query.SetParameter("Warehouse", Warehouse);
		Query.SetParameter("Premise", Premise);
		Query.SetParameter("ReferenceArray", ReferenceArray);
		Query.SetParameter("ByAllReferences", ByAllReferences);
		Query.Text =
		"SELECT
		|	GoodsForPickingBalance.ReferenceOrder AS ReferenceOrder
		|INTO TableOfOrders
		|FROM
		|	AccumulationRegister.GoodsForPicking.Balance(, ReferenceOrder.Warehouse = &Warehouse
		|	AND (&ByAllReferences
		|	OR ReferenceOrder IN (&ReferenceArray)
		|	OR ReferenceOrder IN
		|		(SELECT
		|			TransportationTask.ReferenceOrder
		|		FROM
		|			Document.TransportationJob.References AS TransportationTask
		|		WHERE
		|			TransportationTask.Ref IN (&ReferenceArray)))) AS GoodsForPickingBalance
		|WHERE
		|	GoodsForPickingBalance.ForPickingBalance - GoodsForPickingBalance.BeingPickedBalance -
		|		GoodsForPickingBalance.PickedBalance > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TableOfOrders.ReferenceOrder
		|FROM
		|	TableOfOrders
		|WHERE
		|	TRUE IN
		|		(SELECT TOP 1
		|			TRUE
		|		FROM
		|			Document.GoodsIssueNote
		|		WHERE
		|			Ref = TableOfOrders.ReferenceOrder
		|			AND Premise = &Premise)
		|	OR TRUE IN
		|		(SELECT TOP 1
		|			TRUE
		|		FROM
		|			Document.GoodsTransferNote
		|		WHERE
		|			Ref = TableOfOrders.ReferenceOrder
		|			AND SenderWareroom = &Premise)";
		
		PickingReferences = Query.Execute().Unload();
		ReferenceArray = PickingReferences.UnloadColumn("ReferenceOrder");
		
	EndIf;
	
	Manager = New TempTablesManager;
	
	RemainingGoodsForSelection(Manager, ReferenceArray, Warehouse, Premise);
	
	// We will get a table with a breakdown of the nomenclature of all orders by storage cells,
	// and then we will divide it by tasks, taking into account the maximum volume and weight.
	
	ReturnStructure = SelectProductFromCells(Manager, Warehouse, Premise);
	
	ThereIsNotSelectedProduct = ?(ReturnStructure.ErrorsTable.Count() > 0, True, False);
	If ThereIsNotSelectedProduct Then
		
		TaskGenerationParameters = ParametersForGeneratingFeedTasks(True); // By Selection Orders
		TaskGenerationParameters.CustomizeGenerationByWorkAreas = CustomizeGenerationByWorkAreas;
		TaskGenerationParameters.WarehouseZone = WarehouseZone;
		TaskGenerationParameters.LimitationByWeight = LimitationByWeight;
		TaskGenerationParameters.LimitationByVolume = LimitationByVolume;
		TaskGenerationParameters.LimitByVolume = LimitByVolume;
		TaskGenerationParameters.LimitByWeight = LimitByWeight;
		TaskGenerationParameters.Performer = Performer;
		TaskGenerationParameters.BySelectionOrders = ReferenceArray;
		
		MessageText = PerformZboRechargeOnServer(Warehouse, Premise, TaskGenerationParameters);
		If Not IsBlankString(MessageText) Then
			CommonClientServer.MessageToUser(MessageText);
		EndIf;
		
	Else
		
		MessageText = NStr("vi = 'Không cần đóng gói lại';
							|ru = 'Переупаковка не требуется';
							|en = 'Repackaging is not required'; fa = 'Repackaging is not required';
							|it = 'Il reimballaggio non è richiesto';
							|pl = 'Przepakowywanie nie jest wymagane';
							|tr = 'Yeniden paketlemeye gerek yok'");
		CommonClientServer.MessageToUser(MessageText);
		
	EndIf;
	
EndProcedure

// The procedure creates selection tasks that have movements in the selection
//
// Parameters:
//  ParametersStructure	 - Structure	 - a structure that has the following keys:
//  	*Warehouse - CatalogRef.Warehouses - link to the warehouse that is specified in the expense orders;
//  	*Premise - CatalogRef.Warerooms - a link to a room that is specified in the expense orders,
//  		or an empty link in the "Storage rooms" directory";
//  	*ByAllReferences - Boolean - True if you create orders for all orders
//  		False if executed according to the instructions specified in the array of Extensions parameter;
//  	*ReferenceArray - Array - array of links to spending orders that need to be used to create selection tasks,
//  		optional parameter if the parameter for all orders = True;
//  	*WarehouseZone - CatalogRef.WarehouseZones - link to the work area for which selection tasks will be generated;
//  	*CustomizeGenerationByWorkAreas - String - possible values:
//  		of "Fight against the working stages", "At the same working stage", "No fight against the working stages";
//  	*LimitByVolume - Boolean - setting the work area;
//  	*LimitByWeight - Boolean - setting the work area;
//  	*LimitationByVolume - Number - setting the work area;
//  	*LimitationByWeight - Number - setting the work area;
//  	*Performer - CatalogRef.Users - link to the system user that will be specified in the created selection tasks,
//  		optional parameter;
//  	*ActionInCaseOfShortageOfPackages - Number - it can take the following values:
//	  		0 - create only selection tasks	
// 		 	1 - create selection and repackaging tasks
//  		2 - create only repackaging jobs.
//
Procedure CreatePickingJobs(ParametersStructure) Export
	
	Common.OnStartExecuteScheduledJob(Metadata.ScheduledJobs.CreatePickingJobs);
	
	Warehouse = ParametersStructure.Warehouse;
	Premise = ParametersStructure.Premise;
	WarehouseZone = ParametersStructure.WarehouseZone;
	CustomizeGenerationByWorkAreas = ParametersStructure.CustomizeGenerationByWorkAreas;
	LimitationByWeight = ParametersStructure.LimitationByWeight;
	LimitationByVolume = ParametersStructure.LimitationByVolume;
	LimitByVolume = ParametersStructure.LimitByVolume;
	LimitByWeight = ParametersStructure.LimitByWeight;
	ByAllReferences = ParametersStructure.ByAllReferences;
	ActionInCaseOfShortageOfPackages = ParametersStructure.ActionInCaseOfShortageOfPackages;
	ReferenceArray = ParametersStructure.ReferenceArray;	
	Performer = ParametersStructure.Performer;
	
	AllRefsType = Documents.AllRefsType();
	
	IndexOf = ReferenceArray.Count();
	While IndexOf > 0 Do
		
		IndexOf = IndexOf - 1;
		ReferenceOrder = ReferenceArray[IndexOf];
		If Not AllRefsType.Types().Find(TypeOf(ReferenceOrder)) <> Undefined Then
			ReferenceArray.Delete(IndexOf);
		EndIf;
		
	EndDo;
	
	If ReferenceArray.Count() = 0
		And Not ByAllReferences Then
		
		MessageText = NStr("vi = 'Không có vị trí chọn đã tách riêng.';
							|ru = 'Нет выделенных распоряжений на отбор.';
							|en = 'No selected references for selection.'; fa = 'No selected references for selection.';
							|it = 'Nessuna disposizione di selezione selezionata.';
							|pl = 'Nie ma zaznaczonych zamówień dla filtru.';
							|tr = 'Seçilen filtre siparişleri mevcut değil'");
		Common.MessageToUser(MessageText);
		Return;
		
	EndIf;
	
	If ByAllReferences Then
		
		AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
		AdditionalParameters.TempTableName = "TTBlockedReadyForSelection";
		
		// Checking blocked data
		TempTablesManager = New TempTablesManager;
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(Undefined,
			"AccumulationRegister.GoodsForPicking", "ReferenceOrder", TempTablesManager, AdditionalParameters
		);
		
		Query = New Query;
		Query.TempTablesManager = TempTablesManager;
		Query.SetParameter("Warehouse", Warehouse);
		Query.SetParameter("Premise", Premise);
		Query.SetParameter("ReferenceArray", ReferenceArray);
		Query.SetParameter("ByAllReferences", ByAllReferences);
		Query.Text =
		"SELECT
		|	GoodsForPickingBalance.ReferenceOrder AS ReferenceOrder,
		|	GoodsForPickingBalance.Products,
		|	GoodsForPickingBalance.Characteristic,
		|	GoodsForPickingBalance.Purpose,
		|	GoodsForPickingBalance.Series,
		|	GoodsForPickingBalance.CargoItem,
		|	GoodsForPickingBalance.ForPickingBalance,
		|	GoodsForPickingBalance.BeingPickedBalance,
		|	GoodsForPickingBalance.PickedBalance
		|INTO GoodsForPickingBalance
		|FROM
		|	AccumulationRegister.GoodsForPicking.Balance(, ReferenceOrder.Warehouse = &Warehouse
		|	AND NOT ReferenceOrder IN
		|		(SELECT
		|			TTBlockedReadyForSelection.ReferenceOrder
		|		FROM
		|			TTBlockedReadyForSelection AS TTBlockedReadyForSelection)) AS GoodsForPickingBalance
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsForPickingBalance.ReferenceOrder
		|INTO TableOfOrders
		|FROM
		|	GoodsForPickingBalance AS GoodsForPickingBalance
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		|		ON (CASE
		|			WHEN
		|				GoodsForPickingBalance.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
		|				THEN PackagesAndUnitsOfMeasure.Owner = GoodsForPickingBalance.Products
		|			WHEN GoodsForPickingBalance.Products.PackagingGroup <> VALUE(Catalog.PackagingGroups.EmptyRef)
		|				THEN PackagesAndUnitsOfMeasure.Owner = GoodsForPickingBalance.Products.PackagingGroup
		|			ELSE FALSE
		|		END)
		|		AND (PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem))
		|		AND (GoodsForPickingBalance.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef))
		|GROUP BY
		|	GoodsForPickingBalance.ReferenceOrder,
		|	GoodsForPickingBalance.Products,
		|	GoodsForPickingBalance.Characteristic,
		|	GoodsForPickingBalance.Purpose,
		|	GoodsForPickingBalance.Series,
		|	GoodsForPickingBalance.CargoItem
		|HAVING
		|	SUM(CASE
		|		WHEN PackagesAndUnitsOfMeasure.Ref IS NULL
		|			THEN GoodsForPickingBalance.ForPickingBalance
		|		ELSE GoodsForPickingBalance.ForPickingBalance * PackagesAndUnitsOfMeasure.NumberOfPackages
		|	END) - SUM(CASE
		|		WHEN PackagesAndUnitsOfMeasure.Ref IS NULL
		|			THEN GoodsForPickingBalance.BeingPickedBalance
		|		ELSE GoodsForPickingBalance.BeingPickedBalance * PackagesAndUnitsOfMeasure.NumberOfPackages
		|	END) - SUM(CASE
		|		WHEN PackagesAndUnitsOfMeasure.Ref IS NULL
		|			THEN GoodsForPickingBalance.PickedBalance
		|		ELSE GoodsForPickingBalance.PickedBalance * PackagesAndUnitsOfMeasure.NumberOfPackages
		|	END) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TableOfOrders.ReferenceOrder
		|FROM
		|	TableOfOrders
		|WHERE
		|	TRUE IN
		|		(SELECT TOP 1
		|			TRUE
		|		FROM
		|			Document.GoodsIssueNote
		|		WHERE
		|			Ref = TableOfOrders.ReferenceOrder
		|			AND Premise = &Premise)
		|	OR TRUE IN
		|		(SELECT TOP 1
		|			TRUE
		|		FROM
		|			Document.GoodsTransferNote
		|		WHERE
		|			Ref = TableOfOrders.ReferenceOrder
		|			AND SenderWareroom = &Premise)";
		
		PickingReferences = Query.Execute().Unload();
		ReferenceArray = PickingReferences.UnloadColumn("ReferenceOrder");
		
	EndIf;
	
	Manager = New TempTablesManager;
	
	RemainingGoodsForSelection(Manager, ReferenceArray, Warehouse, Premise);
	
	// We will get a table with a breakdown of the nomenclature of all orders by storage cells,
	// and then we will divide it by tasks, taking into account the maximum volume and weight.
	
	StructureOfData = SelectProductFromCells(Manager, Warehouse, Premise);
	
	If ActionInCaseOfShortageOfPackages = 0 Then
		
		CreateSelectionTasksBasedOnOrders(ParametersStructure, StructureOfData);
	
	ElsIf ActionInCaseOfShortageOfPackages = 1 Then 
		
		CreateSelectionTasksBasedOnOrders(ParametersStructure, StructureOfData);
		
		If StructureOfData.ErrorsTable.Count() > 0 Then
			
			StructureOfData.ResultsTable.Clear();
			TaskGenerationParameters = ParametersForGeneratingFeedTasks(True);
			TaskGenerationParameters.CustomizeGenerationByWorkAreas = CustomizeGenerationByWorkAreas;
			TaskGenerationParameters.WarehouseZone = WarehouseZone;
			TaskGenerationParameters.LimitationByWeight = LimitationByWeight;
			TaskGenerationParameters.LimitationByVolume = LimitationByVolume;
			TaskGenerationParameters.LimitByVolume = LimitByVolume;
			TaskGenerationParameters.LimitByWeight = LimitByWeight;			
			TaskGenerationParameters.Performer = Performer;
			TaskGenerationParameters.BySelectionOrders = ReferenceArray;
			
			MessageText = PerformZboRechargeOnServer(Warehouse, Premise, TaskGenerationParameters);
			If Not IsBlankString(MessageText) Then
				CommonClientServer.MessageToUser(MessageText);
			EndIf;
			
		EndIf;
		
	ElsIf ActionInCaseOfShortageOfPackages = 2 Then
		
		If StructureOfData.ErrorsTable.Count() > 0 Then
			TaskGenerationParameters = ParametersForGeneratingFeedTasks(True);
			TaskGenerationParameters.CustomizeGenerationByWorkAreas = CustomizeGenerationByWorkAreas;
			TaskGenerationParameters.WarehouseZone = WarehouseZone;
			TaskGenerationParameters.LimitationByWeight = LimitationByWeight;
			TaskGenerationParameters.LimitationByVolume = LimitationByVolume;
			TaskGenerationParameters.LimitByVolume = LimitByVolume;
			TaskGenerationParameters.LimitByWeight = LimitByWeight;			
			TaskGenerationParameters.Performer = Performer;
			TaskGenerationParameters.BySelectionOrders = ReferenceArray;
			
			MessageText = PerformZboRechargeOnServer(Warehouse, Premise, TaskGenerationParameters);
			If Not IsBlankString(MessageText) Then
				CommonClientServer.MessageToUser(MessageText);
			EndIf;
			
		Else
			
			CreateSelectionTasksBasedOnOrders(ParametersStructure, StructureOfData);
		
		EndIf;
		
	EndIf;
	
EndProcedure

// The procedure in the temporary table Manager passed through the parameters puts the tables "Tablesatovarnyemestakotboru"
// and "Tablesanomenklatura"there. The "table of inventory items" stores the items that remain to be selected.
// The "nomenclature table" stores the entire nomenclature that remains to be selected.
//
// Parameters:
//  Manager	 - TempTablesManager - The Manager where the temporary tables "tabletsthe inventory list" and "nomenclature Table" will be placed" 
//  References - Array, DocumentRef.GoodsIssueNote, DocumentRef.GoodsTransferNote -
//                 orders based on which the selection of products will be created
//  Warehouse		 - CatalogRef.Warehouses - warehouse from an order or workplace
//  Premise	 - CatalogRef.Warerooms - a room from an office or workplace.
//
Procedure RemainingGoodsForSelection(Manager, References, Warehouse, Premise) Export 
	
	ReferenceArray = New Array();	
	If TypeOf(References) = Type("Array") Then
		ReferenceArray = References;
	ElsIf Documents.AllRefsType().ContainsType(TypeOf(References)) Then 
		ReferenceArray.Add(References);
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = Manager;
	
	Query.SetParameter("ReferenceArray", ReferenceArray);
	Query.SetParameter("Warehouse", Warehouse);
	Query.SetParameter("Premise", Premise);
	Query.Text =
	"SELECT
	|	GoodsForPickingBalance.Products AS Products,
	|	GoodsForPickingBalance.Characteristic AS Characteristic,
	|	GoodsForPickingBalance.Purpose AS Purpose,
	|	GoodsForPickingBalance.Series AS Series,
	|	GoodsForPickingBalance.CargoItem,
	|	GoodsForPickingBalance.ReferenceOrder AS ReferenceOrder,
	|	GoodsForPickingBalance.ForPickingBalance,
	|	GoodsForPickingBalance.BeingPickedBalance,
	|	GoodsForPickingBalance.PickedBalance
	|INTO GoodsToBeSelectedUnfilteredResidues
	|FROM
	|	AccumulationRegister.GoodsForPicking.Balance(
	|			,
	|			ReferenceOrder IN (&ReferenceArray)
	|				OR ReferenceOrder.TransportationJob IN (&ReferenceArray)) AS GoodsForPickingBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPickingBalance.Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.Series,
	|	GoodsForPickingBalance.CargoItem,
	|	GoodsForPickingBalance.ReferenceOrder,
	|	GoodsForPickingBalance.ForPickingBalance,
	|	GoodsForPickingBalance.BeingPickedBalance,
	|	GoodsForPickingBalance.PickedBalance
	|INTO ProductsForSelectionProductLocations
	|FROM
	|	GoodsToBeSelectedUnfilteredResidues AS GoodsForPickingBalance
	|WHERE
	|	ISNULL(GoodsForPickingBalance.CargoItem.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPickingBalance.Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.Series,
	|	GoodsForPickingBalance.CargoItem,
	|	GoodsForPickingBalance.ReferenceOrder,
	|	GoodsForPickingBalance.ForPickingBalance,
	|	GoodsForPickingBalance.BeingPickedBalance,
	|	GoodsForPickingBalance.PickedBalance
	|INTO GoodsForPicking
	|FROM
	|	GoodsToBeSelectedUnfilteredResidues AS GoodsForPickingBalance
	|WHERE
	|	ISNULL(GoodsForPickingBalance.CargoItem.PackageType, UNDEFINED) <> VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	ProductsForSelectionProductLocations.Products AS Products,
	|	ProductsForSelectionProductLocations.Characteristic AS Characteristic,
	|	ProductsForSelectionProductLocations.Purpose AS Purpose,
	|	ProductsForSelectionProductLocations.Series AS Series,
	|	ProductsForSelectionProductLocations.ReferenceOrder AS ReferenceOrder,
	|	PackagesAndUnitsOfMeasure.Ref AS CargoItem,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages
	|INTO AllProductItems
	|FROM
	|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		INNER JOIN ProductsForSelectionProductLocations AS ProductsForSelectionProductLocations
	|		ON PackagesAndUnitsOfMeasure.Owner = ProductsForSelectionProductLocations.Products.PackagingGroup
	|WHERE
	|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	AND NOT PackagesAndUnitsOfMeasure.DeletionMark
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	ProductsForSelectionProductLocations.Products,
	|	ProductsForSelectionProductLocations.Characteristic,
	|	ProductsForSelectionProductLocations.Purpose,
	|	ProductsForSelectionProductLocations.Series,
	|	ProductsForSelectionProductLocations.ReferenceOrder,
	|	PackagesAndUnitsOfMeasure.Ref,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages
	|FROM
	|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		INNER JOIN ProductsForSelectionProductLocations AS ProductsForSelectionProductLocations
	|		ON PackagesAndUnitsOfMeasure.Owner = ProductsForSelectionProductLocations.Products
	|WHERE
	|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	AND NOT PackagesAndUnitsOfMeasure.DeletionMark
	|
	|INDEX BY
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	AllProductItems.Products AS Products,
	|	AllProductItems.Characteristic AS Characteristic,
	|	AllProductItems.Purpose AS Purpose,
	|	AllProductItems.Series AS Series,
	|	AllProductItems.ReferenceOrder AS ReferenceOrder,
	|	AllProductItems.CargoItem,
	|	AllProductItems.NumberOfPackages,
	|	ISNULL(ProductsForSelectionProductLocations.ForPickingBalance, 0) AS ForPickingBalance,
	|	ISNULL(ProductsForSelectionProductLocations.BeingPickedBalance, 0) AS BeingPickedBalance,
	|	ISNULL(ProductsForSelectionProductLocations.PickedBalance, 0) AS PickedBalance
	|INTO AllProductItemsWithQuantity
	|FROM
	|	AllProductItems AS AllProductItems
	|		LEFT JOIN ProductsForSelectionProductLocations AS ProductsForSelectionProductLocations
	|		ON AllProductItems.ReferenceOrder = ProductsForSelectionProductLocations.ReferenceOrder
	|			AND AllProductItems.Products = ProductsForSelectionProductLocations.Products
	|			AND AllProductItems.Characteristic = ProductsForSelectionProductLocations.Characteristic
	|			AND AllProductItems.Purpose = ProductsForSelectionProductLocations.Purpose
	|			AND AllProductItems.Series = ProductsForSelectionProductLocations.Series
	|			AND AllProductItems.CargoItem = ProductsForSelectionProductLocations.CargoItem
	|
	|INDEX BY
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	AllProductItemsWithQuantity.Products AS Products,
	|	AllProductItemsWithQuantity.Characteristic AS Characteristic,
	|	AllProductItemsWithQuantity.Purpose AS Purpose,
	|	AllProductItemsWithQuantity.Series AS Series,
	|	AllProductItemsWithQuantity.ReferenceOrder AS ReferenceOrder,
	|	MAX(CASE
	|			WHEN (AllProductItemsWithQuantity.BeingPickedBalance + AllProductItemsWithQuantity.PickedBalance) / AllProductItemsWithQuantity.NumberOfPackages - (CAST((AllProductItemsWithQuantity.BeingPickedBalance + AllProductItemsWithQuantity.PickedBalance) / AllProductItemsWithQuantity.NumberOfPackages AS NUMBER(12, 0))) <= 0
	|				THEN CAST((AllProductItemsWithQuantity.BeingPickedBalance + AllProductItemsWithQuantity.PickedBalance) / AllProductItemsWithQuantity.NumberOfPackages AS NUMBER(12, 0))
	|			ELSE (CAST((AllProductItemsWithQuantity.BeingPickedBalance + AllProductItemsWithQuantity.PickedBalance) / AllProductItemsWithQuantity.NumberOfPackages AS NUMBER(12, 0))) + 1
	|		END) AS QuantitySelectedSelected
	|INTO SetsOfProductLocations
	|FROM
	|	AllProductItemsWithQuantity AS AllProductItemsWithQuantity
	|
	|GROUP BY
	|	AllProductItemsWithQuantity.Products,
	|	AllProductItemsWithQuantity.Characteristic,
	|	AllProductItemsWithQuantity.Purpose,
	|	AllProductItemsWithQuantity.Series,
	|	AllProductItemsWithQuantity.ReferenceOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPicking.Products,
	|	GoodsForPicking.Characteristic,
	|	GoodsForPicking.Purpose,
	|	GoodsForPicking.Series,
	|	GoodsForPicking.ReferenceOrder,
	|	GoodsForPicking.ReferenceOrder.DateOfShipment AS DateOfShipment,
	|	GoodsForPicking.ReferenceOrder.Priority.AddlOrderingAttribute AS Priority,
	|	GoodsForPicking.Products.WarehouseGroup AS WarehouseGroupOfProducts,
	|	GoodsForPicking.ForPickingBalance - GoodsForPicking.BeingPickedBalance - GoodsForPicking.PickedBalance - ISNULL(SetsOfProductLocations.QuantitySelectedSelected, 0) AS Count
	|INTO TableSelectionRequirements
	|FROM
	|	GoodsForPicking AS GoodsForPicking
	|		LEFT JOIN SetsOfProductLocations AS SetsOfProductLocations
	|		ON GoodsForPicking.ReferenceOrder = SetsOfProductLocations.ReferenceOrder
	|			AND GoodsForPicking.Products = SetsOfProductLocations.Products
	|			AND GoodsForPicking.Characteristic = SetsOfProductLocations.Characteristic
	|			AND GoodsForPicking.Purpose = SetsOfProductLocations.Purpose
	|			AND GoodsForPicking.Series = SetsOfProductLocations.Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPicking.Products,
	|	GoodsForPicking.Characteristic,
	|	GoodsForPicking.Purpose,
	|	GoodsForPicking.Series,
	|	GoodsForPicking.ReferenceOrder,
	|	AllProductItemsWithQuantity.CargoItem AS CargoItem,
	|	SetsOfProductLocations.QuantitySelectedSelected * AllProductItemsWithQuantity.NumberOfPackages - AllProductItemsWithQuantity.BeingPickedBalance - AllProductItemsWithQuantity.PickedBalance AS Count,
	|	GoodsForPicking.ReferenceOrder.DateOfShipment AS DateOfShipment,
	|	GoodsForPicking.ReferenceOrder.Priority.AddlOrderingAttribute AS Priority,
	|	GoodsForPicking.Products.WarehouseGroup AS WarehouseGroupOfProducts
	|INTO TableCommodityPlacesForSelection
	|FROM
	|	GoodsForPicking AS GoodsForPicking
	|		INNER JOIN SetsOfProductLocations AS SetsOfProductLocations
	|		ON GoodsForPicking.ReferenceOrder = SetsOfProductLocations.ReferenceOrder
	|			AND GoodsForPicking.Products = SetsOfProductLocations.Products
	|			AND GoodsForPicking.Characteristic = SetsOfProductLocations.Characteristic
	|			AND GoodsForPicking.Purpose = SetsOfProductLocations.Purpose
	|			AND GoodsForPicking.Series = SetsOfProductLocations.Series
	|		INNER JOIN AllProductItemsWithQuantity AS AllProductItemsWithQuantity
	|		ON GoodsForPicking.ReferenceOrder = AllProductItemsWithQuantity.ReferenceOrder
	|			AND GoodsForPicking.Products = AllProductItemsWithQuantity.Products
	|			AND GoodsForPicking.Characteristic = AllProductItemsWithQuantity.Characteristic
	|			AND GoodsForPicking.Purpose = AllProductItemsWithQuantity.Purpose
	|			AND GoodsForPicking.Series = AllProductItemsWithQuantity.Series
	|WHERE
	|	SetsOfProductLocations.QuantitySelectedSelected * AllProductItemsWithQuantity.NumberOfPackages - AllProductItemsWithQuantity.BeingPickedBalance - AllProductItemsWithQuantity.PickedBalance > 0";
	
	Query.Text = Query.Text + ";" + Chars.LF;
	
	AllowableDeviationOfMeasuringGoodsShipmentAndReceiving = Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		 Query.Text = Query.Text + 
		 "SELECT
		 |	GoodsForSelectionTurnover.ReferenceOrder AS ReferenceOrder,
		 |	GoodsForSelectionTurnover.Products AS Products,
		 |	GoodsForSelectionTurnover.Characteristic AS Characteristic,
		 |	GoodsForSelectionTurnover.Purpose AS Purpose,
		 |	GoodsForSelectionTurnover.Series AS Series,
		 |	GoodsForSelectionTurnover.ForPickingReceipt AS ForPickingReceipt
		 |INTO GoodsForSelectionTurnover
		 |FROM
		 |	AccumulationRegister.GoodsForPicking.Turnovers(
		 |			,
		 |			,
		 |			,
		 |			ReferenceOrder IN (&ReferenceArray)
		 |				OR ReferenceOrder.TransportationJob IN (&ReferenceArray)) AS GoodsForSelectionTurnover
		 |
		 |INDEX BY
		 |	ReferenceOrder,
		 |	Products,
		 |	Characteristic,
		 |	Purpose,
		 |	Series
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |SELECT
		 |	TableSelectionRequirements.Products AS Products,
		 |	TableSelectionRequirements.Characteristic AS Characteristic,
		 |	TableSelectionRequirements.Purpose AS Purpose,
		 |	TableSelectionRequirements.Series AS Series,
		 |	TableSelectionRequirements.ReferenceOrder AS ReferenceOrder,
		 |	TableSelectionRequirements.Count AS Count,
		 |	TableSelectionRequirements.DateOfShipment AS DateOfShipment,
		 |	TableSelectionRequirements.Priority AS Priority,
		 |	TableSelectionRequirements.WarehouseGroupOfProducts AS WarehouseGroupOfProducts
		 |INTO ProductsTable
		 |FROM
		 |	TableSelectionRequirements AS TableSelectionRequirements
		 |		INNER JOIN GoodsForSelectionTurnover AS GoodsForSelectionTurnover
		 |		ON TableSelectionRequirements.ReferenceOrder = GoodsForSelectionTurnover.ReferenceOrder
		 |			AND TableSelectionRequirements.Products = GoodsForSelectionTurnover.Products
		 |			AND TableSelectionRequirements.Characteristic = GoodsForSelectionTurnover.Characteristic
		 |			AND TableSelectionRequirements.Purpose = GoodsForSelectionTurnover.Purpose
		 |			AND TableSelectionRequirements.Series = GoodsForSelectionTurnover.Series
		 |WHERE
		 |	TableSelectionRequirements.Count > CASE
		 |			WHEN TableSelectionRequirements.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
		 |				THEN &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * ISNULL(GoodsForSelectionTurnover.ForPickingReceipt, 0)
		 |			ELSE 0
		 |		END";
		
		Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
			AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
		Query.SetParameter("DimensionalTypesOfUnits",
			Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
		
	Else
		
		Query.Text = Query.Text + 
		"SELECT
		|	TableSelectionRequirements.Products AS Products,
		|	TableSelectionRequirements.Characteristic AS Characteristic,
		|	TableSelectionRequirements.Purpose AS Purpose,
		|	TableSelectionRequirements.Series AS Series,
		|	TableSelectionRequirements.ReferenceOrder AS ReferenceOrder,
		|	TableSelectionRequirements.Count AS Count,
		|	TableSelectionRequirements.DateOfShipment AS DateOfShipment,
		|	TableSelectionRequirements.Priority AS Priority,
		|	TableSelectionRequirements.WarehouseGroupOfProducts AS WarehouseGroupOfProducts
		|INTO ProductsTable
		|FROM
		|	TableSelectionRequirements AS TableSelectionRequirements
		|WHERE
		|	TableSelectionRequirements.Count > 0";
		
	EndIf;
	
	Query.Text = Query.Text + ";" + Chars.LF + 
	"DROP GoodsToBeSelectedUnfilteredResidues
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ProductsForSelectionProductLocations
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP GoodsForPicking
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP AllProductItems
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP AllProductItemsWithQuantity
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP SetsOfProductLocations
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TableSelectionRequirements";
	
	ResultsArray = Query.ExecuteBatch();
	
