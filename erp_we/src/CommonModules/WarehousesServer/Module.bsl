Function ThereArePlacementErrors(Job_GoodsTransfer)
	
	Return ValueIsFilled(Job_GoodsTransfer.GoodsPlacement.Find(Catalogs.StorageBins.EmptyRef(), "Cell"));
	
EndFunction

Procedure DeleteLinesWithPlacementErrors(Job_GoodsTransfer, PlacementErrors)
	
	Query = New Query;
	Query.Text = 
	"SELECT
	|	GoodsFilter.Count,
	|	GoodsFilter.NumberOfPackages,
	|	GoodsFilter.Products AS Products,
	|	GoodsFilter.Package AS Package,
	|	GoodsFilter.Characteristic AS Characteristic,
	|	GoodsFilter.Purpose AS Purpose,
	|	GoodsFilter.Cell,
	|	GoodsFilter.PackageVolume,
	|	GoodsFilter.PackageWeight,
	|	GoodsFilter.Series AS Series
	|INTO TT_GoodsFilter
	|FROM
	|	&GoodsFilter AS GoodsFilter
	|
	|INDEX BY
	|	Products,
	|	Package,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsPlacement.Count,
	|	GoodsPlacement.NumberOfPackages,
	|	GoodsPlacement.Products AS Products,
	|	GoodsPlacement.Package AS Package,
	|	GoodsPlacement.Characteristic AS Characteristic,
	|	GoodsPlacement.Purpose AS Purpose,
	|	GoodsPlacement.Cell,
	|	GoodsPlacement.PackageVolume,
	|	GoodsPlacement.PackageWeight,
	|	GoodsPlacement.Series AS Series
	|INTO TT_GoodsPlacement
	|FROM
	|	&GoodsPlacement AS GoodsPlacement
	|
	|INDEX BY
	|	Products,
	|	Package,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TT_GoodsFilter.Count,
	|	TT_GoodsFilter.NumberOfPackages,
	|	TT_GoodsFilter.Products AS Products,
	|	TT_GoodsFilter.Package AS Package,
	|	TT_GoodsFilter.Characteristic AS Characteristic,
	|	TT_GoodsFilter.Purpose AS Purpose,
	|	TT_GoodsFilter.Cell AS Cell,
	|	CAST(TT_GoodsFilter.Cell AS Catalog.StorageBins).TabIndex AS TabIndex,
	|	CAST(TT_GoodsFilter.Cell AS Catalog.StorageBins).Code AS Code,
	|	TT_GoodsFilter.PackageVolume,
	|	TT_GoodsFilter.PackageWeight,
	|	TT_GoodsFilter.Series AS Series,
	|	ISNULL(TT_GoodsPlacement.Count, 0) AS QuantityToDelete,
	|	ISNULL(TT_GoodsPlacement.NumberOfPackages, 0) AS NumberOfPackagesToRemove
	|FROM
	|	TT_GoodsFilter AS TT_GoodsFilter
	|		LEFT JOIN TT_GoodsPlacement AS TT_GoodsPlacement
	|		ON TT_GoodsFilter.Products = TT_GoodsPlacement.Products
	|			AND TT_GoodsFilter.Package = TT_GoodsPlacement.Package
	|			AND TT_GoodsFilter.Characteristic = TT_GoodsPlacement.Characteristic
	|			AND TT_GoodsFilter.Purpose = TT_GoodsPlacement.Purpose
	|			AND TT_GoodsFilter.Series = TT_GoodsPlacement.Series
	|			AND (TT_GoodsPlacement.Cell = VALUE(Catalog.StorageBins.EmptyRef))
	|			AND (CAST(TT_GoodsPlacement.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods))
	|WHERE
	|	CAST(TT_GoodsFilter.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|
	|ORDER BY
	|	CAST(TT_GoodsFilter.Cell AS Catalog.StorageBins).TabIndex DESC,
	|	CAST(TT_GoodsFilter.Cell AS Catalog.StorageBins).Code DESC
	|TOTALS
	|	MAX(QuantityToDelete),
	|	MAX(NumberOfPackagesToRemove)
	|BY
	|	Products,
	|	Package,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TT_GoodsPlacement.Count,
	|	TT_GoodsPlacement.NumberOfPackages,
	|	TT_GoodsPlacement.Products,
	|	TT_GoodsPlacement.Package,
	|	TT_GoodsPlacement.Characteristic,
	|	TT_GoodsPlacement.Purpose,
	|	TT_GoodsPlacement.Cell,
	|	TT_GoodsPlacement.PackageVolume,
	|	TT_GoodsPlacement.PackageWeight,
	|	TT_GoodsPlacement.Series
	|FROM
	|	TT_GoodsPlacement AS TT_GoodsPlacement
	|WHERE
	|	TT_GoodsPlacement.Cell <> VALUE(Catalog.StorageBins.EmptyRef)";
	
	Query.SetParameter("GoodsFilter", Job_GoodsTransfer.GoodsFilter.Unload());
	Query.SetParameter("GoodsPlacement", Job_GoodsTransfer.GoodsPlacement.Unload());
	QueryResult = Query.ExecuteBatch();
	
	Table_Selection = New ValueTable;
	For Each Column In QueryResult[2].Columns Do
		Table_Selection.Columns.Add(Column.Name, Column.ValueType);
	EndDo;
	
	SelectionOfProducts = QueryResult[2].Select(QueryResultIteration.ByGroups);
	While SelectionOfProducts.Next() Do
		SamplePackaging = SelectionOfProducts.Select(QueryResultIteration.ByGroups);
		While SamplePackaging.Next() Do
			SampleCharacteristics = SamplePackaging.Select(QueryResultIteration.ByGroups);
			While SampleCharacteristics.Next() Do
				SelectionAssignment = SampleCharacteristics.Select(QueryResultIteration.ByGroups);
				While SelectionAssignment.Next() Do
					SampleSeries = SelectionAssignment.Select(QueryResultIteration.ByGroups);
					While SampleSeries.Next() Do
							
						QuantityToDelete = SampleSeries.QuantityToDelete;
						NumberOfPackagesToRemove = SampleSeries.NumberOfPackagesToRemove;
						
						SelectionDetailRecords = SampleSeries.Select();
						While SelectionDetailRecords.Next() Do
							
							StringSelection_ = Table_Selection.Add();
							FillPropertyValues(StringSelection_, SelectionDetailRecords);
							
							If NumberOfPackagesToRemove Then
								
								Count = Min(SelectionDetailRecords.Count, QuantityToDelete);
								NumberOfPackages = Min(SelectionDetailRecords.NumberOfPackages, NumberOfPackagesToRemove);
								
								StringSelection_.Count = StringSelection_.Count - Count;
								StringSelection_.NumberOfPackages = StringSelection_.NumberOfPackages - NumberOfPackages;
								
								MessageTemplate = NStr(
									"vi = 'Không thể tìm vị trí cho [Count] [Package] của mục [Products] được chọn từ ô [Cell].';
									|ru = 'Не удалось подобрать размещение для [Count] [Package] номенклатуры [Products], отобранной из ячейки [Cell].';
									|en = 'Cannot put away items picked from storage bin [Cell]: [Products],[Count] [Package].'; fa = 'Cannot put away items picked from storage bin [Cell]: [Products],[Count] [Package].';
									|it = 'Impossibile trovare un collocamento per [Count] [Package] gli articoli [Products] selezionati dalla cella [Cell].';
									|pl = 'Nie udało się dobrać umieszczenie dla [Count] [Package] nomenklatury [Products], wybranej z komórki [Cell].';
									|tr = '[Cell] hücresinden örneklenen [Products] öğesinin [Count] [Package] yerleşimi seçilemedi.'");
								StructureOfMessageParameters = New Structure;
								StructureOfMessageParameters.Insert("Products", 
									ProductsClientServer.ProductPresentation(
										SelectionDetailRecords.Products, 
										SelectionDetailRecords.Characteristic,
										, 
										SelectionDetailRecords.Series,
										SelectionDetailRecords.Purpose));
								StructureOfMessageParameters.Insert("Cell", String(SelectionDetailRecords.Cell));
								StructureOfMessageParameters.Insert("Count", String(NumberOfPackages));
								StructureOfMessageParameters.Insert("Package", String(SelectionDetailRecords.Package));
								MessageText = StringFunctionsClientServer.InsertParametersIntoString(MessageTemplate, StructureOfMessageParameters);
								PlacementErrors.Add(MessageText);
								
								QuantityToDelete = QuantityToDelete - Count;
								NumberOfPackagesToRemove = NumberOfPackagesToRemove - NumberOfPackages;
								
							EndIf;
							
							If Not StringSelection_.NumberOfPackages Then
								Table_Selection.Delete(StringSelection_);
							EndIf;
							
						EndDo;
					EndDo;
				EndDo;
			EndDo;
		EndDo;
	EndDo;
	
	Table_Selection.Sort("TabIndex Asc, Code Asc");
	Job_GoodsTransfer.GoodsFilter.Load(Table_Selection);
	Job_GoodsTransfer.GoodsPlacement.Load(QueryResult[3].Unload());
	
EndProcedure

// Returns:
// 	Array of DocumentObject.GoodsPickingPlacement
// 
Function CreateObjectsForMovingTasks(Val TaskIds, Val TableGoodsToMove, Val CreationParameters)
	
	MovementTasks = New Array;
	
	FillingData = New Structure;
	FillingData.Insert("OperationKind", Enums.OperationKindsOfGoodsPlacementPicking.Move);
	FillingData.Insert("Premise", CreationParameters.Premise);
	FillingData.Insert("Warehouse", CreationParameters.Warehouse);
	FillingData.Insert("WarehouseZone");
	
	For Each JobID In TaskIds Do
		TheStructureOfTheSearch = New Structure("JobID", JobID);
		RowsReadyToMove = TableGoodsToMove.FindRows(TheStructureOfTheSearch);
		If RowsReadyToMove.Count() Then
			FillingData.WarehouseZone = RowsReadyToMove[0].WarehouseZone;
			Job_GoodsTransfer = Documents.GoodsPickingPlacement.CreateDocument();
			Job_GoodsTransfer.Fill(FillingData);
			For Each ProductsToMoveLine In RowsReadyToMove Do
				FillPropertyValues(Job_GoodsTransfer.GoodsFilter.Add(), ProductsToMoveLine);
			EndDo;
			MovementTasks.Add(Job_GoodsTransfer);
		EndIf;
	EndDo;
	Return MovementTasks;

EndFunction

Procedure DistributeGoodsToMoveByTasks(Val QueryResult, TaskIds, TableGoodsToMove)
	
	VeryLargeNumber = 9999999999;
	JobID = Undefined;
	
	SampleWorkArea = QueryResult[21].Select();
	SelectionDetailRecords = QueryResult[22].Select();
	
	While SampleWorkArea.Next() Do
		
		JobID = New UUID;
		TaskIds.Add(JobID);
		
		MaximumVolume_ = ?(SampleWorkArea.LimitByVolume, SampleWorkArea.LimitationByVolume, VeryLargeNumber);
		MaximumWeight = ?(SampleWorkArea.LimitByWeight, SampleWorkArea.LimitationByWeight, VeryLargeNumber);
		AvailableMemorySize = MaximumVolume_;
		AvailableWeight_ = MaximumWeight;
		
		While SelectionDetailRecords.FindNext(SampleWorkArea.WarehouseZone, "WarehouseZone") Do
			
			NumberOfPackagesToBeDistributed = SelectionDetailRecords.NumberOfPackages;
			AllowedNumberOfPackagesInEmptyTask =
				Min(?(SelectionDetailRecords.PackageWeight, 	MaximumWeight   / SelectionDetailRecords.PackageWeight,   VeryLargeNumber), 
					?(SelectionDetailRecords.PackageVolume, MaximumVolume_ / SelectionDetailRecords.PackageVolume, VeryLargeNumber));
					
			If ValueIsFilled(SelectionDetailRecords.Package) Then
				AllowedNumberOfPackagesInEmptyTask = Int(AllowedNumberOfPackagesInEmptyTask);
			EndIf;
			
			While NumberOfPackagesToBeDistributed >= 1 
				Or (Not ValueIsFilled(SelectionDetailRecords.Package) And NumberOfPackagesToBeDistributed > 0) Do
				
				PermissibleNumberOfPackages =
					Min(?(SelectionDetailRecords.PackageWeight, 	AvailableWeight_   / SelectionDetailRecords.PackageWeight,   VeryLargeNumber), 
						?(SelectionDetailRecords.PackageVolume, AvailableMemorySize / SelectionDetailRecords.PackageVolume, VeryLargeNumber));
						
				If ValueIsFilled(SelectionDetailRecords.Package) Then
					PermissibleNumberOfPackages = Int(PermissibleNumberOfPackages);
				EndIf;
						
				If Not PermissibleNumberOfPackages Then
					If AllowedNumberOfPackagesInEmptyTask = 0 Then
						// We add at least one package, even if there is an excess of weight or volume
						PermissibleNumberOfPackages = 1;
						AvailableMemorySize = SelectionDetailRecords.PackageVolume;
						AvailableWeight_ = SelectionDetailRecords.PackageWeight;
					Else
						PermissibleNumberOfPackages = AllowedNumberOfPackagesInEmptyTask;
						AvailableMemorySize = MaximumVolume_;
						AvailableWeight_ = MaximumWeight;
					EndIf;
					JobID = Undefined; // in any case, a new task
				EndIf;
					
				If Not ValueIsFilled(JobID) Then
					JobID = New UUID;
					TaskIds.Add(JobID);
				EndIf;
				
				ProductsToMoveLine = TableGoodsToMove.Add();
				FillPropertyValues(ProductsToMoveLine, SelectionDetailRecords);
				ProductsToMoveLine.JobID = JobID;
				
				NumberOfPackages = Min(NumberOfPackagesToBeDistributed, PermissibleNumberOfPackages);
				ProductsToMoveLine.NumberOfPackages = NumberOfPackages;
				ProductsToMoveLine.Count = NumberOfPackages * ProductsToMoveLine.PackagingFactor;
				NumberOfPackagesToBeDistributed = NumberOfPackagesToBeDistributed - NumberOfPackages;
						
				AvailableWeight_ = AvailableWeight_ - ProductsToMoveLine.PackageWeight * ProductsToMoveLine.NumberOfPackages;
				AvailableMemorySize = AvailableMemorySize - ProductsToMoveLine.PackageVolume * ProductsToMoveLine.NumberOfPackages;
					
			EndDo;
		EndDo;
	EndDo;

EndProcedure

Function RequestMovingAccordingToRulesForPlacingSeparateProducts(Val CreationParameters)
	
	Var Query;
	
	Query = New Query(
	"SELECT
	|	Products.Ref AS Ref
	|INTO ReusablePackage
	|FROM
	|	Catalog.Products AS Products
	|WHERE
	|	Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	StorageBins.Ref AS Ref
	|INTO SharedStorageCells
	|FROM
	|	Catalog.StorageBins AS StorageBins
	|WHERE
	|	StorageBins.Owner = &Warehouse
	|	AND StorageBins.Premise = &Premise
	|	AND NOT StorageBins.StorageArea.SeparateStorageArea
	|	AND (StorageBins.WarehouseZone = &WarehouseZone
	|			OR NOT &UseSelectionByWorkArea)
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	StorageBins.Ref AS Ref
	|INTO SeparateStorageCells
	|FROM
	|	Catalog.StorageBins AS StorageBins
	|WHERE
	|	StorageBins.Owner = &Warehouse
	|	AND StorageBins.Premise = &Premise
	|	AND StorageBins.StorageArea.SeparateStorageArea
	|	AND (StorageBins.WarehouseZone = &WarehouseZone
	|			OR NOT &UseSelectionByWorkArea)
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Products.Ref AS Ref
	|INTO GoodsForSeparateStorage
	|FROM
	|	Catalog.Products AS Products
	|		INNER JOIN Catalog.WarehouseGroupsOfItems AS WarehouseGroupsOfItems
	|		ON Products.WarehouseGroup = WarehouseGroupsOfItems.Ref
	|			AND (Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods))
	|			AND (NOT WarehouseGroupsOfItems.PhysicallyDifferentFromAssignment)
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	ResiduesInCells.Cell,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.InStockBalance - ResiduesInCells.ForPickingBalance AS NumberOfPackages
	|INTO SeparateGoodsInSeparateCellsBalances
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Cell IN
	|					(SELECT
	|						SeparateStorageCells.Ref
	|					FROM
	|						SeparateStorageCells AS SeparateStorageCells)
	|				AND Purpose <> VALUE(Catalog.Assignments.EmptyRef)
	|				AND NOT Products IN
	|						(SELECT
	|							ReusablePackage.Ref
	|						FROM
	|							ReusablePackage AS ReusablePackage)) AS ResiduesInCells
	|
	|INDEX BY
	|	ResiduesInCells.Cell,
	|	ResiduesInCells.Purpose
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResiduesInCells.Cell AS Cell
	|INTO CellsWithMultipleAssignments
	|FROM
	|	SeparateGoodsInSeparateCellsBalances AS ResiduesInCells
	|
	|GROUP BY
	|	ResiduesInCells.Cell
	|
	|HAVING
	|	COUNT(DISTINCT ResiduesInCells.Purpose) > 1
	|
	|INDEX BY
	|	Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SeparateGoodsInSeparateCellsBalances.Cell AS Cell,
	|	SeparateGoodsInSeparateCellsBalances.Purpose AS Purpose,
	|	COUNT(DISTINCT SeparateGoodsInSeparateCellsBalances.Products) AS Count
	|INTO NumberOfDifferentProductsByPurpose
	|FROM
	|	SeparateGoodsInSeparateCellsBalances AS SeparateGoodsInSeparateCellsBalances
	|		INNER JOIN CellsWithMultipleAssignments AS CellsWithMultipleAssignments
	|		ON SeparateGoodsInSeparateCellsBalances.Cell = CellsWithMultipleAssignments.Cell
	|
	|GROUP BY
	|	SeparateGoodsInSeparateCellsBalances.Cell,
	|	SeparateGoodsInSeparateCellsBalances.Purpose
	|
	|INDEX BY
	|	SeparateGoodsInSeparateCellsBalances.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NumberOfDifferentProductsByPurpose.Cell AS Cell,
	|	MAX(NumberOfDifferentProductsByPurpose.Count) AS Max
	|INTO MaximumOfVariousProductsForPurposes
	|FROM
	|	NumberOfDifferentProductsByPurpose AS NumberOfDifferentProductsByPurpose
	|
	|GROUP BY
	|	NumberOfDifferentProductsByPurpose.Cell
	|
	|INDEX BY
	|	NumberOfDifferentProductsByPurpose.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	NumberOfDifferentProductsByPurpose.Cell AS Cell,
	|	MAX(NumberOfDifferentProductsByPurpose.Purpose) AS Purpose
	|INTO AssignmentsNeedToBeLeft
	|FROM
	|	NumberOfDifferentProductsByPurpose AS NumberOfDifferentProductsByPurpose
	|		INNER JOIN MaximumOfVariousProductsForPurposes AS MaximumOfVariousProductsForPurposes
	|		ON NumberOfDifferentProductsByPurpose.Cell = MaximumOfVariousProductsForPurposes.Cell
	|			AND NumberOfDifferentProductsByPurpose.Count = MaximumOfVariousProductsForPurposes.Max
	|
	|GROUP BY
	|	NumberOfDifferentProductsByPurpose.Cell
	|
	|INDEX BY
	|	Cell,
	|	Purpose
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	ResiduesInCells.Cell,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.InStockBalance - ResiduesInCells.ForPickingBalance AS NumberOfPackages
	|INTO GoodsToMovePreliminary
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Cell IN
	|					(SELECT
	|						SeparateStorageCells.Ref
	|					FROM
	|						SeparateStorageCells AS SeparateStorageCells)
	|				AND Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|				AND NOT Products IN
	|						(SELECT
	|							ReusablePackage.Ref
	|						FROM
	|							ReusablePackage)) AS ResiduesInCells
	|
	|UNION ALL
	|
	|SELECT
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	ResiduesInCells.Cell,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.InStockBalance - ResiduesInCells.ForPickingBalance
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Products IN
	|					(SELECT
	|						GoodsForSeparateStorage.Ref
	|					FROM
	|						GoodsForSeparateStorage AS GoodsForSeparateStorage)
	|				AND Cell IN
	|					(SELECT
	|						SharedStorageCells.Ref
	|					FROM
	|						SharedStorageCells AS SharedStorageCells)
	|				AND Purpose <> VALUE(Catalog.Assignments.EmptyRef)) AS ResiduesInCells
	|
	|UNION ALL
	|
	|SELECT
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	ResiduesInCells.Cell,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.NumberOfPackages
	|FROM
	|	SeparateGoodsInSeparateCellsBalances AS ResiduesInCells
	|		INNER JOIN CellsWithMultipleAssignments AS CellsWithMultipleAssignments
	|		ON ResiduesInCells.Cell = CellsWithMultipleAssignments.Cell
	|		LEFT JOIN AssignmentsNeedToBeLeft AS AssignmentsNeedToBeLeft
	|		ON ResiduesInCells.Cell = AssignmentsNeedToBeLeft.Cell
	|			AND ResiduesInCells.Purpose = AssignmentsNeedToBeLeft.Purpose
	|WHERE
	|	AssignmentsNeedToBeLeft.Purpose IS NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ReusablePackage
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP SharedStorageCells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP SeparateStorageCells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP GoodsForSeparateStorage
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP SeparateGoodsInSeparateCellsBalances
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP CellsWithMultipleAssignments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP NumberOfDifferentProductsByPurpose
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP MaximumOfVariousProductsForPurposes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP AssignmentsNeedToBeLeft
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	&TextWorkArea AS WarehouseZone,
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	ResiduesInCells.Cell,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.NumberOfPackages,
	|	CASE
	|		WHEN ResiduesInCells.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN 1
	|		ELSE &QueryTextPackagingFactor
	|	END AS PackagingFactor,
	|	&QueryTextWeight AS PackageWeight,
	|	&QueryTextVolumeM3 AS PackageVolume
	|INTO GoodsToMove
	|FROM
	|	(SELECT
	|		GoodsToMoveWithSeriesPolicies.Products AS Products,
	|		GoodsToMoveWithSeriesPolicies.Characteristic AS Characteristic,
	|		GoodsToMoveWithSeriesPolicies.Series AS Series,
	|		GoodsToMoveWithSeriesPolicies.Purpose AS Purpose,
	|		GoodsToMoveWithSeriesPolicies.Cell AS Cell,
	|		GoodsToMoveWithSeriesPolicies.Package AS Package,
	|		SUM(GoodsToMoveWithSeriesPolicies.NumberOfPackages) AS NumberOfPackages
	|	FROM
	|		(SELECT
	|			GoodsToMovePreliminary.Products AS Products,
	|			GoodsToMovePreliminary.Characteristic AS Characteristic,
	|			CASE
	|				WHEN BatchAccountingPolicies.Ref IS NULL
	|					THEN UNDEFINED
	|				WHEN BatchAccountingPolicies.BatchAccountingPolicy.SpecifyWhenPlanningPicking
	|						OR BatchAccountingPolicies.BatchAccountingPolicy.SpecifyWhenPlanningShipment
	|					THEN GoodsToMovePreliminary.Series
	|				ELSE UNDEFINED
	|			END AS Series,
	|			GoodsToMovePreliminary.Purpose AS Purpose,
	|			GoodsToMovePreliminary.Cell AS Cell,
	|			GoodsToMovePreliminary.Package AS Package,
	|			GoodsToMovePreliminary.NumberOfPackages AS NumberOfPackages
	|		FROM
	|			GoodsToMovePreliminary AS GoodsToMovePreliminary
	|				LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS BatchAccountingPolicies
	|				ON GoodsToMovePreliminary.Products.ProductKind = BatchAccountingPolicies.Ref
	|					AND (BatchAccountingPolicies.Warehouse = &Warehouse)) AS GoodsToMoveWithSeriesPolicies
	|	
	|	GROUP BY
	|		GoodsToMoveWithSeriesPolicies.Products,
	|		GoodsToMoveWithSeriesPolicies.Characteristic,
	|		GoodsToMoveWithSeriesPolicies.Series,
	|		GoodsToMoveWithSeriesPolicies.Purpose,
	|		GoodsToMoveWithSeriesPolicies.Cell,
	|		GoodsToMoveWithSeriesPolicies.Package) AS ResiduesInCells
	|WHERE
	|	ResiduesInCells.NumberOfPackages > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP GoodsToMovePreliminary
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	GoodsToMove.WarehouseZone,
	|	CASE
	|		WHEN &UsePartitioningByWorkSections
	|			THEN ISNULL(WarehouseZones.LimitByWeight, FALSE)
	|		ELSE &LimitByWeight
	|	END AS LimitByWeight,
	|	CASE
	|		WHEN &UsePartitioningByWorkSections
	|			THEN ISNULL(WarehouseZones.LimitationByWeight, 0)
	|		ELSE &LimitationByWeight
	|	END AS LimitationByWeight,
	|	CASE
	|		WHEN &UsePartitioningByWorkSections
	|			THEN ISNULL(WarehouseZones.LimitByVolume, FALSE)
	|		ELSE &LimitByVolume
	|	END AS LimitByVolume,
	|	CASE
	|		WHEN &UsePartitioningByWorkSections
	|			THEN ISNULL(WarehouseZones.LimitationByVolume, 0)
	|		ELSE &LimitationByVolume
	|	END AS LimitationByVolume
	|FROM
	|	GoodsToMove AS GoodsToMove
	|		LEFT JOIN Catalog.WarehouseZones AS WarehouseZones
	|		ON GoodsToMove.WarehouseZone = WarehouseZones.Ref
	|
	|ORDER BY
	|	GoodsToMove.WarehouseZone
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsToMove.WarehouseZone,
	|	GoodsToMove.Products,
	|	GoodsToMove.Characteristic,
	|	GoodsToMove.Series,
	|	GoodsToMove.Purpose,
	|	GoodsToMove.Cell,
	|	GoodsToMove.Package,
	|	GoodsToMove.NumberOfPackages,
	|	GoodsToMove.PackagingFactor,
	|	GoodsToMove.PackageWeight,
	|	GoodsToMove.PackageVolume
	|FROM
	|	GoodsToMove AS GoodsToMove
	|
	|ORDER BY
	|	GoodsToMove.WarehouseZone,
	|	GoodsToMove.Cell.TabIndex,
	|	GoodsToMove.Cell.Code,
	|	GoodsToMove.Products");
	
	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"ResiduesInCells.Package",
			"ResiduesInCells.Products"));
	
	Query.Text = StrReplace(Query.Text, 
		"&QueryTextWeight", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight(
			"ResiduesInCells.Package", 
			"ResiduesInCells.Products", 
			False));
	
	Query.Text = StrReplace(Query.Text, 
		"&QueryTextVolumeM3",
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume(
			"ResiduesInCells.Package", 
			"ResiduesInCells.Products", 
			False));
	
	Query.Text = StrReplace(Query.Text, 
		"&TextWorkArea",
		?(CreationParameters.CustomizeGenerationByWorkAreas = "GroupByWarehouseZones",
			"ResiduesInCells.Cell.WarehouseZone",
			"UNDEFINED"));
	
	Query.SetParameter("Warehouse", 					CreationParameters.Warehouse);
	Query.SetParameter("Premise", 				CreationParameters.Premise);
	Query.SetParameter("WarehouseZone", 		CreationParameters.WarehouseZone);
	Query.SetParameter("LimitByVolume", 	CreationParameters.LimitByVolume);
	Query.SetParameter("LimitByWeight", 	CreationParameters.LimitByWeight);
	Query.SetParameter("LimitationByVolume", 	CreationParameters.LimitationByVolume);
	Query.SetParameter("LimitationByWeight", 		CreationParameters.LimitationByWeight);
	Query.SetParameter("UseSelectionByWorkArea", 
		CreationParameters.CustomizeGenerationByWorkAreas = "ByASingleWarehouseZone");
	Query.SetParameter("UsePartitioningByWorkSections", 
		CreationParameters.CustomizeGenerationByWorkAreas = "GroupByWarehouseZones");
	Return Query;

EndFunction

Procedure SupplementContainerWithTsAndMoveOnIsolation(Job_GoodsTransfer, ErrorsTareResidue = Undefined)
	
	If Not GetFunctionalOption("UseReusablePackage") Then
		Return;
	EndIf;	
	
	Query = New Query;
	Query.Text =
		"SELECT
		|	Table_Selection.Products AS Products,
		|	Table_Selection.Characteristic AS Characteristic,
		|	Table_Selection.Purpose,
		|	Table_Selection.Package AS Package,
		|	Table_Selection.Series AS Series,
		|	Table_Selection.Cell AS Cell,
		|	Table_Selection.NumberOfPackages,
		|	Table_Selection.Count,
		|	Table_Selection.PackageWeight,
		|	Table_Selection.PackageVolume
		|INTO Table_Selection
		|FROM
		|	&Table_Selection AS Table_Selection
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	Package,
		|	Series,
		|	Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.TaraProducts AS Products,
		|	NestedQuery.TaraCharacteristic AS Characteristic,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	NestedQuery.Cell AS Cell,
		|	NestedQuery.TabIndex AS TabIndex,
		|	NestedQuery.Code AS Code,
		|	SUM(NestedQuery.NumberOfContainers) AS Count,
		|	SUM(NestedQuery.NumberOfContainers) AS NumberOfPackages
		|INTO SelectedContainers_
		|FROM
		|	(SELECT
		|		Table_Selection.NumberOfPackages * RepackagingOptions.Count AS NumberOfContainers,
		|		Table_Selection.Cell AS Cell,
		|		CAST(Table_Selection.Cell AS Catalog.StorageBins).TabIndex AS TabIndex,
		|		CAST(Table_Selection.Cell AS Catalog.StorageBins).Code AS Code,
		|		RepackagingOptions.Package.ReusablePackageItems AS TaraProducts,
		|		RepackagingOptions.Package.ReusablePackageVariant AS TaraCharacteristic,
		|		FALSE AS PackagingIsDeliveredInContainers
		|	FROM
		|		Table_Selection AS Table_Selection
		|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
		|			ON Table_Selection.Package = RepackagingOptions.Source
		|	WHERE
		|		RepackagingOptions.Package.SuppliedInReusablePackage
		|		AND CAST(Table_Selection.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|		AND Table_Selection.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		Table_Selection.NumberOfPackages,
		|		Table_Selection.Cell,
		|		CAST(Table_Selection.Cell AS Catalog.StorageBins).TabIndex,
		|		CAST(Table_Selection.Cell AS Catalog.StorageBins).Code,
		|		CAST(Table_Selection.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageItems,
		|		CAST(Table_Selection.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageVariant,
		|		TRUE
		|	FROM
		|		Table_Selection AS Table_Selection
		|	WHERE
		|		CAST(Table_Selection.Package AS Catalog.PackagesAndUnitsOfMeasure).SuppliedInReusablePackage
		|		AND CAST(Table_Selection.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)) AS NestedQuery
		|
		|GROUP BY
		|	NestedQuery.TaraProducts,
		|	NestedQuery.TaraCharacteristic,
		|	NestedQuery.Cell,
		|	NestedQuery.TabIndex,
		|	NestedQuery.Code
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	Package,
		|	Series,
		|	Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsInStorageBinsBalance.Products AS Products,
		|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
		|	GoodsInStorageBinsBalance.Package AS Package,
		|	GoodsInStorageBinsBalance.Series AS Series,
		|	GoodsInStorageBinsBalance.Cell AS Cell,
		|	GoodsInStorageBinsBalance.InStockBalance,
		|	GoodsInStorageBinsBalance.ForPickingBalance
		|INTO TaraBalancePreliminary
		|FROM
		|	AccumulationRegister.GoodsInStorageBins.Balance(
		|			,
		|			(Products, Characteristic, Series, Package, Cell) IN
		|				(SELECT
		|					SelectedContainers_.Products,
		|					SelectedContainers_.Characteristic,
		|					SelectedContainers_.Series,
		|					SelectedContainers_.Package,
		|					SelectedContainers_.Cell
		|				FROM
		|					SelectedContainers_)) AS GoodsInStorageBinsBalance
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	Package,
		|	Series,
		|	Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	SelectedContainers_.Products,
		|	SelectedContainers_.Characteristic,
		|	SelectedContainers_.Purpose,
		|	SelectedContainers_.Cell,
		|	SelectedContainers_.TabIndex AS TabIndex,
		|	SelectedContainers_.Code AS Code,
		|	SelectedContainers_.Count,
		|	SelectedContainers_.NumberOfPackages,
		|	ISNULL(TaraBalancePreliminary.InStockBalance, 0) - ISNULL(TaraBalancePreliminary.ForPickingBalance, 0) AS AvailableStock
		|INTO TaraBalance
		|FROM
		|	SelectedContainers_ AS SelectedContainers_
		|		LEFT JOIN TaraBalancePreliminary AS TaraBalancePreliminary
		|		ON SelectedContainers_.Products = TaraBalancePreliminary.Products
		|			AND SelectedContainers_.Characteristic = TaraBalancePreliminary.Characteristic
		|			AND SelectedContainers_.Package = TaraBalancePreliminary.Package
		|			AND SelectedContainers_.Series = TaraBalancePreliminary.Series
		|			AND SelectedContainers_.Cell = TaraBalancePreliminary.Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	TaraBalance.Cell
		|INTO CellsAndContainers
		|FROM
		|	TaraBalance AS TaraBalance
		|WHERE
		|	TaraBalance.AvailableStock - TaraBalance.NumberOfPackages < 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	Table_Selection.Products,
		|	Table_Selection.Characteristic,
		|	Table_Selection.Package,
		|	Table_Selection.Series,
		|	Table_Selection.Purpose,
		|	Table_Selection.Cell,
		|	CAST(Table_Selection.Cell AS Catalog.StorageBins).TabIndex AS TabIndex,
		|	CAST(Table_Selection.Cell AS Catalog.StorageBins).Code AS Code,
		|	Table_Selection.NumberOfPackages,
		|	Table_Selection.Count,
		|	Table_Selection.PackageWeight,
		|	Table_Selection.PackageVolume
		|FROM
		|	Table_Selection AS Table_Selection
		|WHERE
		|	NOT Table_Selection.Cell IN
		|				(SELECT
		|					CellsAndContainers.Cell
		|				FROM
		|					CellsAndContainers AS CellsAndContainers)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TaraBalance.Products,
		|	TaraBalance.Characteristic,
		|	TaraBalance.Purpose,
		|	TaraBalance.Cell,
		|	TaraBalance.TabIndex,
		|	TaraBalance.Code,
		|	TaraBalance.Count,
		|	TaraBalance.NumberOfPackages,
		|	TaraBalance.AvailableStock
		|FROM
		|	TaraBalance AS TaraBalance
		|WHERE
		|	TaraBalance.AvailableStock - TaraBalance.NumberOfPackages >= 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TaraBalance.Products,
		|	TaraBalance.Characteristic,
		|	TaraBalance.Cell,
		|	TaraBalance.NumberOfPackages - TaraBalance.AvailableStock AS QuantityIsNotEnough,
		|	TaraBalance.Products.UnitOfMeasure AS UnitOfMeasure
		|FROM
		|	TaraBalance AS TaraBalance
		|WHERE
		|	TaraBalance.AvailableStock - TaraBalance.NumberOfPackages < 0
		|	AND &GetRemainingTareErrors";
	
	TableTSSelection = Job_GoodsTransfer.GoodsFilter.Unload();
	Query.SetParameter("Table_Selection", TableTSSelection);
	Query.SetParameter("GetRemainingTareErrors", ErrorsTareResidue <> Undefined);
	
	QueryResults = Query.ExecuteBatch();
	
	Table_Selection = QueryResults[5].Unload();
	
	FlowTableFromCells = TableTSSelection.CopyColumns(
		"Products, Characteristic, Purpose, Series, Package, Cell, NumberOfPackages");
	FlowTableFromCells.Indexes.Add("Cell, Products, Package, Characteristic, Series");
	
	SamplingByContainer = QueryResults[6].Select();
	RowFilter = New Structure("Cell, Products, Package, Characteristic, Purpose, Series");
	
	While SamplingByContainer.Next() Do
		FillPropertyValues(RowFilter, SamplingByContainer);
		
		ArrayOfFoundStrings = FlowTableFromCells.FindRows(RowFilter);
		
		If ArrayOfFoundStrings.Count() = 0 Then
			ExpenseLine = FlowTableFromCells.Add();
			FillPropertyValues(ExpenseLine, RowFilter);
			ExpenseLine.NumberOfPackages = SamplingByContainer.AvailableStock;
		Else
			ExpenseLine = ArrayOfFoundStrings[0];
		EndIf;
		
		StringSelection_ = Table_Selection.Add();
		FillPropertyValues(StringSelection_, SamplingByContainer);
		QuantityToBeSelected = StringSelection_.NumberOfPackages;
		
		StringSelection_.NumberOfPackages = Min(ExpenseLine.NumberOfPackages, SamplingByContainer.NumberOfPackages);
		StringSelection_.Count         = StringSelection_.NumberOfPackages;
		
		ExpenseLine.NumberOfPackages = ExpenseLine.NumberOfPackages - StringSelection_.NumberOfPackages; 
		
	EndDo;	
	
	If SamplingByContainer.Count() Then
		Table_Selection.Sort("TabIndex Asc, Code Asc");
		Job_GoodsTransfer.GoodsFilter.Load(Table_Selection);
	EndIf;
	
	SamplingInsufficientContainers = QueryResults[7].Select();
	While SamplingInsufficientContainers.Next() Do
		MessageTemplate = NStr(
			"vi = 'Không thể chọn vị trí cho hàng hóa trong ô [Cell], không đủ [Tara]. Không đủ [Count] [UnitOfMeasure].';
			|ru = 'Не удалось подобрать размещения для товаров в ячейке [Cell], недостаточное количество тары [Tara]. Не хватает [Count] [UnitOfMeasure].';
			|en = 'Cannot pick location for goods in bin [Cell], not enough package [Tara]. Not enough [Count] [UnitOfMeasure].'; fa = 'Cannot pick location for goods in bin [Cell], not enough package [Tara]. Not enough [Count] [UnitOfMeasure].';
			|it = 'Impossibile trovare i collocamenti per le merci nella cella [Cell], imballaggio insufficiente [Tara]. Mancano [Count] [UnitOfMeasure].';
			|pl = 'Nie udało się dobrać umieszczenia dla towarów w komórce [Cell], niedostateczna ilość opakowania [Tara]. Nie wystarcza [Count] [UnitOfMeasure].';
			|tr = 'Hücredeki [Cell] öğeler için yerleşimler bulunamadı, yetersiz ambalaj miktarı [Tara]. Yetersiz [Count] [UnitOfMeasure].'");
		StructureOfMessageParameters = New Structure;
		StructureOfMessageParameters.Insert("Cell", String(SamplingInsufficientContainers.Cell));
		StructureOfMessageParameters.Insert("Tara",
			ProductsClientServer.ProductPresentation(
				SamplingInsufficientContainers.Products, 
				SamplingInsufficientContainers.Characteristic));
		StructureOfMessageParameters.Insert("Count", String(SamplingInsufficientContainers.QuantityIsNotEnough));
		StructureOfMessageParameters.Insert("UnitOfMeasure", String(SamplingInsufficientContainers.UnitOfMeasure));
		MessageText = StringFunctionsClientServer.InsertParametersIntoString(MessageTemplate, StructureOfMessageParameters);
		ErrorsTareResidue.Add(MessageText);
	EndDo;
	
EndProcedure

Procedure SupplementContainerWithTsAndMoveAlongSeparation(Job_GoodsTransfer)
	
	If Not GetFunctionalOption("UseReusablePackage") Then
		Return;
	EndIf;	
	
	Query = New Query;
	Query.Text =
		"SELECT
		|	TablePlacement.Products AS Products,
		|	TablePlacement.Characteristic AS Characteristic,
		|	TablePlacement.Purpose,
		|	TablePlacement.Package AS Package,
		|	TablePlacement.Series AS Series,
		|	TablePlacement.Cell AS Cell,
		|	TablePlacement.NumberOfPackages,
		|	TablePlacement.Count,
		|	TablePlacement.PackageWeight,
		|	TablePlacement.PackageVolume
		|INTO TablePlacement
		|FROM
		|	&TablePlacement AS TablePlacement
		|
		|INDEX BY
		|	Package
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.TaraProducts AS Products,
		|	NestedQuery.TaraCharacteristic AS Characteristic,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	NestedQuery.Cell AS Cell,
		|	NestedQuery.TabIndex AS TabIndex,
		|	NestedQuery.Code AS Code,
		|	SUM(NestedQuery.NumberOfContainers) AS Count,
		|	SUM(NestedQuery.NumberOfContainers) AS NumberOfPackages,
		|	0 AS PackageWeight,
		|	0 AS PackageVolume
		|FROM
		|	(SELECT
		|		TablePlacement.NumberOfPackages * RepackagingOptions.Count AS NumberOfContainers,
		|		TablePlacement.Cell AS Cell,
		|		CAST(TablePlacement.Cell AS Catalog.StorageBins).TabIndex AS TabIndex,
		|		CAST(TablePlacement.Cell AS Catalog.StorageBins).Code AS Code,
		|		RepackagingOptions.Package.ReusablePackageItems AS TaraProducts,
		|		RepackagingOptions.Package.ReusablePackageVariant AS TaraCharacteristic,
		|		FALSE AS PackagingIsDeliveredInContainers
		|	FROM
		|		TablePlacement AS TablePlacement
		|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
		|			ON TablePlacement.Package = RepackagingOptions.Source
		|	WHERE
		|		RepackagingOptions.Package.SuppliedInReusablePackage
		|		AND CAST(TablePlacement.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|		AND TablePlacement.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		TablePlacement.NumberOfPackages,
		|		TablePlacement.Cell,
		|		CAST(TablePlacement.Cell AS Catalog.StorageBins).TabIndex,
		|		CAST(TablePlacement.Cell AS Catalog.StorageBins).Code,
		|		CAST(TablePlacement.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageItems,
		|		CAST(TablePlacement.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageVariant,
		|		TRUE
		|	FROM
		|		TablePlacement AS TablePlacement
		|	WHERE
		|		CAST(TablePlacement.Package AS Catalog.PackagesAndUnitsOfMeasure).SuppliedInReusablePackage
		|		AND CAST(TablePlacement.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)) AS NestedQuery
		|
		|GROUP BY
		|	NestedQuery.TaraProducts,
		|	NestedQuery.TaraCharacteristic,
		|	NestedQuery.Cell,
		|	NestedQuery.TabIndex,
		|	NestedQuery.Code
		|
		|UNION ALL
		|
		|SELECT
		|	TablePlacement.Products,
		|	TablePlacement.Characteristic,
		|	TablePlacement.Package,
		|	TablePlacement.Series,
		|	TablePlacement.Purpose,
		|	TablePlacement.Cell,
		|	CAST(TablePlacement.Cell AS Catalog.StorageBins).TabIndex,
		|	CAST(TablePlacement.Cell AS Catalog.StorageBins).Code,
		|	TablePlacement.Count,
		|	TablePlacement.NumberOfPackages,
		|	TablePlacement.PackageWeight,
		|	TablePlacement.PackageVolume
		|FROM
		|	TablePlacement AS TablePlacement
		|WHERE
		|	CAST(TablePlacement.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|
		|ORDER BY
		|	TabIndex,
		|	Code";
	
	Query.SetParameter("TablePlacement", Job_GoodsTransfer.GoodsPlacement.Unload());
	Job_GoodsTransfer.GoodsPlacement.Load(Query.Execute().Unload());
	
EndProcedure

