// Returns the resolution of the fiscal warehouse
//
// Parameters:
// 	Warehouse - CatalogRef.Warehouses
// 	PersonalSettings_ - Boolean - personalize the fiscal
// 	Date - Date
// 	
// Returns:
// 	Boolean
Function FiscalizationByWarehouseIsAllowed(Warehouse, PersonalSettings_, Date = Undefined) Export
	
	Result = False;
	
	If Not ValueIsFilled(Warehouse) Then
		Return Result;
	EndIf;
	
	WarehouseSettings = WarehouseSettingsForAssemblyAndDelivery(Warehouse, Date);
	
	WarehouseDetails_ = GeneralPurposeTMServerCall.ObjectAttributesValues(Warehouse, "IsFolder");
	
	If WarehouseSettings = Undefined Then
		Return WarehouseDetails_.IsFolder And PersonalSettings_;
	EndIf;
	
	WarehouseFiscalizationIsAllowed = Not WarehouseDetails_.IsFolder 
			And (WarehouseSettings.StoreSupportsOrderAssembly Or WarehouseSettings.StoreSupportsDeliveryByOwnCouriers);
	WarehouseFiscalizationDuringImplementation = (WarehouseSettings.MethodOfFiscalizationUponDelivery = PredefinedValue("Enum.MethodsOfFiscalizationUponDelivery.UponCreatingOfCustomerInvoice"));
	
	If WarehouseFiscalizationIsAllowed And WarehouseFiscalizationDuringImplementation
		Or Not WarehouseFiscalizationIsAllowed And PersonalSettings_ Then
		Result = True;
	EndIf; 
	
	Return Result;
	
EndFunction

// Gets the build and delivery statuses of orders required to assign orders to the courier. 
//
