Function GetTsOfMetadataObject(MetadataObject, TSName)
	
	TSObject_ = MetadataObject.TabularSections.Find(TSName);
	
	If TSObject_ = Undefined Then
		ErrorTemplate	= NStr("vi = 'Đã tìm thấy tùy chỉnh không chính xác - không tồn tại phần bảng %1 của đối tượng metadata %2';
								|ru = 'Обнаружены не правильные настройки - не существует табличной части %1 объекта метаданных %2';
								|en = 'Incorrect settings were found - there is no table %1 of metadata object %2'; fa = 'Incorrect settings were found - there is no table %1 of metadata object %2';
								|it = 'Sono state rilevate impostazioni non corrette - non esiste la parte tabellare %1 dell''oggetto metadati %2';
