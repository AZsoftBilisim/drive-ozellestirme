Function DataRequestTextShippedProducts(TableName)
	
	QueryText = 
	"SELECT
	|	DocumentData.Ref				AS Ref,
	|	DocumentData.Period				AS Period,
	|	DocumentData.Warehouse				AS Warehouse,
	|	DocumentData.Premise			AS Premise,
	|	DocumentData.Products		AS Products,
	|	DocumentData.Characteristic		AS Characteristic,
	|	DocumentData.Purpose			AS Purpose,
	|	DocumentData.ControlledLotReference AS ControlledLotReference,
	|	DocumentData.Series				AS Series,
	|	DocumentData.BatchesIndicationStatus	AS BatchesIndicationStatus,
	|	DocumentData.Count			AS Count,
	|	DocumentData.Action			AS Action,
	|	DocumentData.ForAssembly				AS ForAssembly,
	|	DocumentData.AssemblyInProgress			AS AssemblyInProgress,
	|	DocumentData.Assembled				AS Assembled,
	|	DocumentData.ToShip			AS ToShip,
	|	&UseBinLocationWarehousing		AS UseBinLocationWarehousing,
	|	&ThisIsAProduct							AS ThisIsAProduct
	|INTO TTDataName
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&PackageType <> VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|
	|UNION ALL
	|
	|SELECT
	|	DocumentDataWithoutPackaging.Ref				AS Ref,
	|	DocumentData.Period							AS Period,
	|	DocumentData.Warehouse							AS Warehouse,
	|	DocumentData.Premise						AS Premise,
	|	DocumentDataWithoutPackaging.Products			AS Products,
	|	DocumentDataWithoutPackaging.Characteristic		AS Characteristic,
	|	DocumentDataWithoutPackaging.Purpose			AS Purpose,
	|	DocumentDataWithoutPackaging.ControlledLotReference AS ControlledLotReference,
	|	DocumentDataWithoutPackaging.Series				AS Series,
	|	DocumentDataWithoutPackaging.BatchesIndicationStatus	AS BatchesIndicationStatus,
	|	SUM(DocumentData.Count)				AS Count,
	|	DocumentDataWithoutPackaging.Action				AS Action,
	|	DocumentData.ForAssembly							AS ForAssembly,
	|	DocumentData.AssemblyInProgress						AS AssemblyInProgress,
	|	DocumentData.Assembled							AS Assembled,
	|	DocumentData.ToShip						AS ToShip,
	|	&UseBinLocationWarehousing					AS UseBinLocationWarehousing,
	|	&ThisIsAProduct										AS ThisIsAProduct
	|FROM
	|	(SELECT
	|		DocumentData.Ref				AS Ref,
	|		DocumentData.Products		AS Products,
	|		DocumentData.Characteristic		AS Characteristic,
	|		DocumentData.Purpose			AS Purpose,
	|		DocumentData.ControlledLotReference AS ControlledLotReference,
	|		MAX(DocumentData.Package)	AS Package,
	|		DocumentData.Series				AS Series,
	|		DocumentData.BatchesIndicationStatus	AS BatchesIndicationStatus,
	|		DocumentData.Action			AS Action
	|	FROM
	|		#DocumentData AS DocumentData
	|	
	|	WHERE
	|		&PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	
	|	GROUP BY
	|		DocumentData.Ref,
	|		DocumentData.Products,
	|		DocumentData.Characteristic,
	|		DocumentData.Purpose,
	|		DocumentData.ControlledLotReference,
	|		DocumentData.Series,
	|		DocumentData.BatchesIndicationStatus,
	|		DocumentData.Action
	|	
	|	) AS DocumentDataWithoutPackaging
	|		INNER JOIN #DocumentData AS DocumentData
	|		ON DocumentDataWithoutPackaging.Ref = DocumentData.Ref
	|			AND DocumentDataWithoutPackaging.Products = DocumentData.Products
	|			AND DocumentDataWithoutPackaging.Characteristic = DocumentData.Characteristic
	|			AND DocumentDataWithoutPackaging.Purpose = DocumentData.Purpose
	|			AND DocumentDataWithoutPackaging.ControlledLotReference = DocumentData.ControlledLotReference
	|			AND DocumentDataWithoutPackaging.Series = DocumentData.Series
	|			AND DocumentDataWithoutPackaging.Package = DocumentData.Package
	|			AND DocumentDataWithoutPackaging.Action = DocumentData.Action
	|
	|GROUP BY
	|	DocumentDataWithoutPackaging.Ref,
	|	DocumentData.Period,
	|	DocumentData.Warehouse,
	|	DocumentData.Premise,
	|	DocumentDataWithoutPackaging.Products,
	|	DocumentDataWithoutPackaging.Characteristic,
	|	DocumentDataWithoutPackaging.Purpose,
	|	DocumentDataWithoutPackaging.ControlledLotReference,
	|	DocumentDataWithoutPackaging.Series,
	|	DocumentDataWithoutPackaging.BatchesIndicationStatus,
	|	DocumentDataWithoutPackaging.Action,
	|	DocumentData.ForAssembly,
	|	DocumentData.AssemblyInProgress,
	|	DocumentData.Assembled,
	|	DocumentData.ToShip,
	|	&UseBinLocationWarehousing,
	|	&ThisIsAProduct";
	
	QueryText = StrReplace(QueryText, "TTDataName", TableName);
	
	Return QueryText;
	
EndFunction

Function ParametersOfDocumentDataRequestText(OperationName, DataSource = "DocumentData", ServicesAndWorksAreCountedInRegisteredRecords = False)
	
	QueryOptions = New Structure;
	ShippingOperations = ShippingOperations();
	AcceptanceOperations = AcceptanceOperations();
	
	QueryOptions.Insert("RecordTypeReceipt", "VALUE(AccumulationRecordType.Receipt)");
	QueryOptions.Insert("RecordTypeExpense", "VALUE(AccumulationRecordType.Expense)");
	
	#Region ShippingOperations
	If ShippingOperations.Find(OperationName) <> Undefined Then
		
		If OperationName = "ShipGoodsFromWarehouse_" Then
			DocumentShipments = "DocumentData.OrderDocument";
		Else
			DocumentShipments = 
			"CASE
			|		WHEN DocumentData.OrderDocument <> UNDEFINED
			|			THEN DocumentData.OrderDocument 
			|		ELSE
			|			CASE
			|				WHEN DocumentData.ShipmentByOrder
			|					THEN DocumentData.OrderDocument 
			|				WHEN DocumentData.Patch
			|					THEN DocumentData.CorrectedDocument
			|				ELSE DocumentData.Invoice
			|			END
			|	END";
		EndIf;
		
		Purpose = 
		"CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END";
		
		If OperationName = "ReflectReserve"
			Or OperationName = "ScheduleShipmentOfGoods" Then
			
			Series = 
			"CASE
			|		WHEN NOT DocumentData.ThisIsAnInvoice
			|				OR DocumentData.BatchesIndicationStatus IN(10, 14)
			|			THEN DocumentData.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END";
			
		ElsIf OperationName = "ArrangeShipmentOfGoods"
			Or OperationName = "ShipGoodsFromWarehouse_" Then
			
			Series = 
			"CASE
			|		WHEN DocumentData.BatchesIndicationStatus IN(10, 14)
			|			THEN DocumentData.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END";
			
		EndIf;
		
		PackageType = "ISNULL(DocumentData.Package.PackageType, UNDEFINED)";
		
		MeasuredValueType = "ISNULL(DocumentData.Package.MeasuredValueType, UNDEFINED)";
		
		CargoItem = 
		"CASE
		|		WHEN ISNULL(DocumentData.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|			THEN DocumentData.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END";
		
		UseAdvancedWarehousing = 
		"CASE
		|		WHEN DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
		|				AND DocumentData.Period >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue
		|			THEN TRUE
		|		ELSE FALSE
		|	END";
		
		OrderSchemeIsUsedUponReceipt =
		"	(DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
		|		AND DocumentData.Period >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)";
		
		OrderSchemeIsUsedWhenReflectingSurplusShortages =
		"	(DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.Period >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages)";
		
		UseBinLocationWarehousing = 
		"CASE
		|		WHEN DocumentData.Warehouse.UseWarerooms
		|				AND DocumentData.Period >= DocumentData.Warehouse.StartDateOfWareroomUse
		|			THEN CASE
		|					WHEN DocumentData.Premise.UseBinLocationWarehousing
		|							AND DocumentData.Period >= DocumentData.Premise.StartDateOfUsingWarehouseBinSystem
		|						THEN TRUE
		|					ELSE FALSE
		|				END
		|		ELSE CASE
		|				WHEN DocumentData.Warehouse.UseBinLocationWarehousing
		|						AND DocumentData.Period >= DocumentData.Warehouse.StartDateOfUsingWarehouseBinSystem
		|					THEN TRUE
		|				ELSE FALSE
		|			END
		|	END";
		
		DocumentShipments				= StrReplace(DocumentShipments,				"DocumentData", DataSource);
		Purpose						= StrReplace(Purpose,					"DocumentData", DataSource);
		Series							= StrReplace(Series,						"DocumentData", DataSource);
		PackageType						= StrReplace(PackageType,					"DocumentData", DataSource);
		MeasuredValueType			= StrReplace(MeasuredValueType,		"DocumentData", DataSource);
		CargoItem					= StrReplace(CargoItem,				"DocumentData", DataSource);
		UseAdvancedWarehousing		= StrReplace(UseAdvancedWarehousing,	"DocumentData", DataSource);
		UseBinLocationWarehousing	= StrReplace(UseBinLocationWarehousing,	"DocumentData", DataSource);
		OrderSchemeIsUsedUponReceipt	= StrReplace(OrderSchemeIsUsedUponReceipt,	"OrderSchemeIsUsedUponReceipt", DataSource);
		OrderSchemeIsUsedWhenReflectingSurplusShortages	= StrReplace(OrderSchemeIsUsedWhenReflectingSurplusShortages,	"DocumentData", DataSource);
		
		QueryOptions.Insert("DocumentShipments",				DocumentShipments);
		QueryOptions.Insert("Purpose",						Purpose);
		QueryOptions.Insert("Series",							Series);
		QueryOptions.Insert("PackageType",					PackageType);
		QueryOptions.Insert("MeasuredValueType",			MeasuredValueType);
		QueryOptions.Insert("CargoItem",					CargoItem);
		QueryOptions.Insert("UseAdvancedWarehousing",		UseAdvancedWarehousing);
		QueryOptions.Insert("UseBinLocationWarehousing",	UseBinLocationWarehousing);
		QueryOptions.Insert("OrderSchemeIsUsedUponReceipt", OrderSchemeIsUsedUponReceipt);
		QueryOptions.Insert("OrderSchemeIsUsedWhenReflectingSurplusShortages", OrderSchemeIsUsedWhenReflectingSurplusShortages);
		
	EndIf;
	#EndRegion
	
	#Region AcceptanceOperations

	If AcceptanceOperations.Find(OperationName) <> Undefined Then
		
		AdditionalConnections = "";
	
		Purpose =
		"	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END";
		
		OrderSchemeIsUsedUponReceipt =
		"	(DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)";
		
		OrderSchemeIsUsedWhenReflectingSurplusShortages =
		"	(DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages)";
		
		InvoiceIsOrder = 
		"	DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)";
		
		InvoiceForServicesIsOrder = 
		"	DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)";
		
		UninvoicedReceiptDocumentIsUsed =
		"	CASE
		|		WHEN DocumentData.BusinessOperation IN(VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit),
		|														VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit),
		|														VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt),
		|														VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery),
		|														VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit),
		|														VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit),
		|														VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery),
		|														VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery),
		|														VALUE(Enum.BusinessTransactions.ImportGoodsInTransit),
		|														VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit),
		|														VALUE(Enum.BusinessTransactions.GoodsReceiptFromCustomer))
		|			THEN TRUE
		|		ELSE FALSE
		|	END";
		
		ByContractsAfterInvoices = 
		"	DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices),
		|											 VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))";
		
		UnderContractsForServicesAfterInvoices = 
		"	DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices),
		|											 VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))";		
		
		ContractIsOrder = 
		"	DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|											 VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		|											 VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices),
		|											 VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|											 VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		|											 VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices))";
		
		OdnohodovkaReceiptDocument =
		// Calculation of the Document access field
		// By agreement:
		"	CASE 
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|				AND DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|															VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices))
		|			OR DocumentData.ThisIsAnInvoice
		|				AND DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|														  VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		|														  VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))
		|		THEN
		|			DocumentData.Terms
		|
		// Under contracts:
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|				AND DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices))
		|			OR DocumentData.ThisIsAnInvoice
		|				AND DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices))
		|		THEN
		|			DocumentData.Contract
		|
		// If the order is divided by a bill of Lading and it is an order, it means an order:
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			DocumentData.OrderDocument
		|
		// If the order is divided by a bill of Lading and it is a bill of lading and a post-order, it means an order:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ReceiptUnderOrders
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			DocumentData.OrderDocument
		|		
		// If the order is divided by a waybill and it is a waybill and not an order, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND NOT DocumentData.ReceiptUnderOrders
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			CASE
		|				WHEN DocumentData.Patch THEN
		|					DocumentData.CorrectedDocument
		|				ELSE
		|					DocumentData.Invoice
		|			END
		|
		// If it is divided by a bill of lading and it is a bill of lading, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			CASE
		|				WHEN DocumentData.Patch THEN
		|					DocumentData.CorrectedDocument
		|				ELSE
		|					DocumentData.Invoice
		|			END
		|
		// If it is separated by a bill of lading and this order - such a combination of settings makes sense only for individual
		// documents, in general, the value calculated here will not be moved by registers, because it will be cut
		// off by the Bill of Lading parameter.
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			DocumentData.OrderDocument
		|
		// Wrong combination of settings:
		|		ELSE
		|			UNDEFINED
		|	END";
		
		DocumentOfReceiptOfOneWayServices =
		// Calculation of the Document access field
		// By agreement:
		"	CASE 
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|				AND DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|															VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices))
		|			OR DocumentData.ThisIsAnInvoice
		|				AND DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|														  VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		|														  VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))
		|		THEN
		|			DocumentData.Terms
		|
		// Under contracts:
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|				AND DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices))
		|			OR DocumentData.ThisIsAnInvoice
		|				AND DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices))
		|		THEN
		|			DocumentData.Contract
		|
		// If the order is divided by a bill of Lading and it is an order, it means an order:
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			DocumentData.OrderDocument
		|
		// If the order is divided by a bill of Lading and it is a bill of lading and a post-order, it means an order:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ReceiptUnderOrders
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			DocumentData.OrderDocument
		|		
		// If the order is divided by a waybill and it is a waybill and not an order, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND NOT DocumentData.ReceiptUnderOrders
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			CASE
		|				WHEN DocumentData.Patch THEN
		|					DocumentData.CorrectedDocument
		|				ELSE
		|					DocumentData.Invoice
		|			END
		|
		// If it is divided by a bill of lading and it is a bill of lading, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			CASE
		|				WHEN DocumentData.Patch THEN
		|					DocumentData.CorrectedDocument
		|				ELSE
		|					DocumentData.Invoice
		|			END
		|
		// If it is separated by a bill of lading and this order - such a combination of settings makes sense only for individual
		// documents, in general, the value calculated here will not be moved by registers, because it will be cut
		// off by the Bill of Lading parameter.
		|		WHEN NOT DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			DocumentData.OrderDocument
		|
		// Wrong combination of settings:
		|		ELSE
		|			UNDEFINED
		|	END";		
		RequirementsForRegistrationOfInvoicesByOrder = 
		"	CASE
		|		WHEN DocumentData.BatchesIndicationStatus = 14
		|			AND DocumentData.BusinessOperation IN
		|			(VALUE(Enum.BusinessTransactions.ReturnFromCustodian),
		|			VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent))
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END";
		
		Series =
		"	CASE
		|		WHEN NOT DocumentData.Series IS NULL
		|			AND DocumentData.Series <> VALUE(Catalog.ItemsBatches.EmptyRef)
		|		THEN DocumentData.Series
		|		WHEN NOT SeriesData_.Series IS NULL
		|			AND SeriesData_.Series <> VALUE(Catalog.ItemsBatches.EmptyRef)
		|		THEN SeriesData_.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END";
		
		Count =
		"	CASE
		|		WHEN NOT SeriesData_.Series IS NULL
		|			AND SeriesData_.Series <> VALUE(Catalog.ItemsBatches.EmptyRef)
		|		THEN SeriesData_.Count
		|		ELSE DocumentData.Count
		|	END";
		
		DocumentOfReceiptOfTwoWayConsignmentNote =
		"	CASE
		|		WHEN DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices))
		|		THEN
		|			DocumentData.Contract
		|		WHEN DocumentData.GoodsReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|														VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))
		|		THEN
		|			DocumentData.Terms
		// If the order is divided by a waybill and it is a waybill and not an order, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND NOT DocumentData.ReceiptUnderOrders
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			DocumentData.Invoice
		|
		// If it is divided by a bill of lading and it is a bill of lading, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.GoodsReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			DocumentData.Invoice
		|		ELSE
		|			DocumentData.OrderDocument
		|	END";
		
		DocumentOfReceiptOfInvoiceOfTwoWayService =
		"	CASE
		|		WHEN DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices))
		|		THEN
		|			DocumentData.Contract
		|		WHEN DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|														VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))
		|		THEN
		|			DocumentData.Terms
		// If the order is divided by a waybill and it is a waybill and not an order, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND NOT DocumentData.ReceiptUnderOrders
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			DocumentData.Invoice
		|
		// If it is divided by a bill of lading and it is a bill of lading, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			DocumentData.Invoice
		|		ELSE
		|			DocumentData.OrderDocument
		|	END";		
		
		AmountToBeProcessedForReceiptByOrder =
		"	CASE
		|		WHEN DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices)) 
		|			AND DocumentData.Contract.PurchaseRegistrationOption = VALUE(Enum.PurchaseRegistrationOptions.NotSeparate)
		|		THEN
		|			DocumentData.Count
		|		WHEN DocumentData.ServiceReceiptOption IN (VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|														VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		|														VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))
		|		THEN
		|			0
		// If the order is divided by a waybill and it is a waybill and not an order, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND NOT DocumentData.ReceiptUnderOrders
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices)
		|		THEN
		|			0
		|
		// If it is divided by a bill of lading and it is a bill of lading, it means an invoice:
		|		WHEN DocumentData.ThisIsAnInvoice
		|			AND DocumentData.ServiceReceiptOption = VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly)
		|		THEN
		|			0
		|		ELSE
		|			0
		|	END";
		
		TwoWayEconomicOperation = 
		"	CASE
		|		WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit)
		|			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorGoodsInTransit)
		|		WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery)
		|			THEN VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt)
		|		WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit)
		|			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit)
		|		WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)
		|			THEN VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
		|		WHEN DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit)
		|			THEN VALUE(Enum.BusinessTransactions.ImportGoodsInTransit)
		|		ELSE
		|			DocumentData.BusinessOperation
		|	END";
		
		AdditionalConnections = AdditionalConnections
			+"
			|	LEFT JOIN Catalog.CounterpartyContracts AS ContractData
			|	ON DocumentData.Contract = ContractData.Ref";
		
		AdditionalConnections				= StrReplace(AdditionalConnections,			"DocumentData", DataSource);
		Purpose								= StrReplace(Purpose,						"DocumentData", DataSource);
		RequirementsForRegistrationOfInvoicesByOrder = StrReplace(RequirementsForRegistrationOfInvoicesByOrder, "DocumentData", DataSource);
		Series									= StrReplace(Series,							"DocumentData", DataSource);
		Count								= StrReplace(Count,						"DocumentData", DataSource);
		OdnohodovkaReceiptDocument			= StrReplace(OdnohodovkaReceiptDocument,	"DocumentData", DataSource);
		DocumentOfReceiptOfOneWayServices		= StrReplace(DocumentOfReceiptOfOneWayServices,	"DocumentData", DataSource);
		ContractIsOrder			= StrReplace(ContractIsOrder,		"DocumentData", DataSource);
		ByContractsAfterInvoices				= StrReplace(ByContractsAfterInvoices,		"DocumentData", DataSource);
		UnderContractsForServicesAfterInvoices		= StrReplace(UnderContractsForServicesAfterInvoices, "DocumentData", DataSource);
		UninvoicedReceiptDocumentIsUsed	= StrReplace(UninvoicedReceiptDocumentIsUsed, "DocumentData", DataSource);
		InvoiceIsOrder			= StrReplace(InvoiceIsOrder,	"DocumentData", DataSource);
		InvoiceForServicesIsOrder	= StrReplace(InvoiceForServicesIsOrder,	"DocumentData", DataSource);
		OrderSchemeIsUsedUponReceipt	= StrReplace(OrderSchemeIsUsedUponReceipt,	"DocumentData", DataSource);
		OrderSchemeIsUsedWhenReflectingSurplusShortages 
			= StrReplace(OrderSchemeIsUsedWhenReflectingSurplusShortages, "DocumentData", DataSource);
		DocumentOfReceiptOfTwoWayConsignmentNote	= StrReplace(DocumentOfReceiptOfTwoWayConsignmentNote,	"DocumentData", DataSource);
		DocumentOfReceiptOfInvoiceOfTwoWayService = StrReplace(DocumentOfReceiptOfInvoiceOfTwoWayService,	"DocumentData", DataSource);
		TwoWayEconomicOperation		= StrReplace(TwoWayEconomicOperation,	"DocumentData", DataSource);
		
		QueryOptions.Insert("AdditionalConnections",					AdditionalConnections);
		QueryOptions.Insert("Purpose",									Purpose);
		QueryOptions.Insert("RequirementsForRegistrationOfInvoicesByOrder",	RequirementsForRegistrationOfInvoicesByOrder);
		QueryOptions.Insert("Series",										Series);
		QueryOptions.Insert("Count",									Count);
		QueryOptions.Insert("OdnohodovkaReceiptDocument",				OdnohodovkaReceiptDocument);
		QueryOptions.Insert("ContractIsOrder",				ContractIsOrder);
		QueryOptions.Insert("ByContractsAfterInvoices",					ByContractsAfterInvoices);
		QueryOptions.Insert("UninvoicedReceiptDocumentIsUsed",		UninvoicedReceiptDocumentIsUsed);
		QueryOptions.Insert("InvoiceIsOrder",				InvoiceIsOrder);
		QueryOptions.Insert("OrderSchemeIsUsedUponReceipt",	OrderSchemeIsUsedUponReceipt);
		QueryOptions.Insert("OrderSchemeIsUsedWhenReflectingSurplusShortages", OrderSchemeIsUsedWhenReflectingSurplusShortages);
		QueryOptions.Insert("DocumentOfReceiptOfTwoWayConsignmentNote",	DocumentOfReceiptOfTwoWayConsignmentNote);	
		QueryOptions.Insert("TwoWayEconomicOperation", 			TwoWayEconomicOperation);
		
		If ServicesAndWorksAreCountedInRegisteredRecords Then
			QueryOptions.Insert("DocumentOfReceiptOfOneWayServices",		DocumentOfReceiptOfOneWayServices);
			QueryOptions.Insert("UnderContractsForServicesAfterInvoices",			UnderContractsForServicesAfterInvoices);
			QueryOptions.Insert("InvoiceForServicesIsOrder",	InvoiceForServicesIsOrder);
			QueryOptions.Insert("DocumentOfReceiptOfInvoiceOfTwoWayService", DocumentOfReceiptOfInvoiceOfTwoWayService);
			QueryOptions.Insert("AmountToBeProcessedForReceiptByOrder",	AmountToBeProcessedForReceiptByOrder);
		Else
			QueryOptions.Insert("DocumentOfReceiptOfOneWayServices",		OdnohodovkaReceiptDocument);
			QueryOptions.Insert("UnderContractsForServicesAfterInvoices",			ByContractsAfterInvoices);
			QueryOptions.Insert("InvoiceForServicesIsOrder",	InvoiceIsOrder);
			QueryOptions.Insert("DocumentOfReceiptOfInvoiceOfTwoWayService", DocumentOfReceiptOfTwoWayConsignmentNote);
			QueryOptions.Insert("AmountToBeProcessedForReceiptByOrder",	"0");
		EndIf;
		
		If OperationName = "ToIssuePurchaseOfGoodsOnDvukhodovka" Then
			
			ReflectUnfacturedDeliveriesOfServicesAndWorks = 
			"DocumentData.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
			|											,VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt))
			|AND ContractData.OptionForRegisteringServiceReceiptDocuments = VALUE(Enum.OptionsForRegisteringServiceDocuments.ReceiptOfServicesIsInvoiced)";
			
			ReflectUnfacturedDeliveriesOfServicesAndWorks = StrReplace(ReflectUnfacturedDeliveriesOfServicesAndWorks, "DocumentData", DataSource);
			QueryOptions.Insert("ReflectUnfacturedDeliveriesOfServicesAndWorks", ReflectUnfacturedDeliveriesOfServicesAndWorks);
			
		EndIf;
		
	EndIf;

	#EndRegion
	
	ThisIsAProduct = 
	"CASE
	|		WHEN DocumentData.Products.ItemsType IN(
	|				VALUE(Enum.ItemsTypes.OwnGoods),
	|				VALUE(Enum.ItemsTypes.ReusablePackage))
	|			THEN TRUE
	|		ELSE FALSE
	|	END";
	ThisIsAProduct = StrReplace(ThisIsAProduct, "DocumentData", DataSource);
	
	QueryOptions.Insert("ThisIsAProduct", ThisIsAProduct);
	
	Return QueryOptions;
	
EndFunction

Function ParametersOfConnectionConditionOfSTCHSeries()
	
	ConnectionParameters = New Structure;
	ConnectionParameters.Insert("SynonymForTSProducts", "DocumentData");
	ConnectionParameters.Insert("SynonymForTSSeries", "SeriesData_");
	ConnectionParameters.Insert("FieldsTSGoods", Undefined);
	ConnectionParameters.Insert("RedefinedConnectionFields", New Map);
	
	Return ConnectionParameters;
	
EndFunction

Function StchSeriesConnectionCondition(MetadataObject, TSSeriesName, ConnectionParameters = Undefined)
	
	TSSetOfSeries = GetTsOfMetadataObject(MetadataObject, TSSeriesName);
	
	If ConnectionParameters = Undefined Then
		ConnectionParameters = ParametersOfConnectionConditionOfSTCHSeries();
	EndIf;
	
	AttributesToExclude = New Array;
	AttributesToExclude.Add("Series");
	AttributesToExclude.Add("Count");
	AttributesToExclude.Add("CountByDocument");
	AttributesToExclude.Add("QuantityToAllocateAccordingToRule");
	
	SynonymForTSProducts	= ConnectionParameters.SynonymForTSProducts;
	SynonymForTSSeries	= ConnectionParameters.SynonymForTSSeries;
	FieldsTSGoods	= ConnectionParameters.FieldsTSGoods;
	RedefinedConnectionFields	= ConnectionParameters.RedefinedConnectionFields;
	
	ConditionsForJoiningTables = New Array;
	
	For Each TSProps In TSSetOfSeries.Attributes Do
		If AttributesToExclude.Find(TSProps.Name) <> Undefined Then
			Continue;
		EndIf;
		// The PM Goods may not have the props that are available in the PM Series. Such details are skipped.
		If FieldsTSGoods <> Undefined
			And FieldsTSGoods.Find(TSProps.Name) = Undefined Then
			
			Continue;
			
		EndIf;
		
		OverriddenField = RedefinedConnectionFields.Get(TSProps.Name);
		
		If FieldsTSGoods <> Undefined
			And OverriddenField <> Undefined
			And FieldsTSGoods.Find(OverriddenField) <> Undefined Then
			
			// The condition is generated based on the specified settings for the composition of the TS Goods Attributes and the redefinition of the aliases
			// of the TS Series Attributes.
			ConnectionCondition = SynonymForTSProducts + "." + OverriddenField + " = " + SynonymForTSSeries + "." + TSProps.Name;
			
		ElsIf FieldsTSGoods = Undefined
			And OverriddenField <> Undefined Then
			
			// The condition is formed based on the standard set of TS Goods Attributes for the item and redefinition
			// of aliases for TS Series Attributes.
			ConnectionCondition = SynonymForTSProducts + "." + OverriddenField + " = " + SynonymForTSSeries + "." + TSProps.Name
			
		Else
			ConnectionCondition = SynonymForTSProducts + "." + TSProps.Name + " = " + SynonymForTSSeries + "." + TSProps.Name;
		EndIf;
		
		ConditionsForJoiningTables.Add(ConnectionCondition);
	EndDo;
	
	ConnectionSeparator = "
		|			AND ";
	ConditionForJoiningTables = StrConcat(ConditionsForJoiningTables, ConnectionSeparator);
	
	Return ConditionForJoiningTables;
	
EndFunction

// Prepares final document reflection requests for warehouse registers:
// - Goods in warehouses
// - Product access.
//
// Parameters:
//  Query - Query - Request for document reflection.
//  QueryTexts - ValueList of String - List of document reflection request texts.
// 	Registers - Undefined, Structure, String - List of registers to reflect.
//  QueryTextDocument_ - String - The text of the document data selection request containing the following required fields:
//     * Ref                - DocumentRef - Link to the current document.
//     * OrderDocument                 - DocumentRef - Link to the order. If there are no such details, you should pass
//                               Undefined. The invoice cannot pass a link to itself.
//     * Invoice             - DocumentRef - Link to the invoice. If the current document is an order, it should
//                               be passed Undefined. The invoice passes a link to itself.
//     * Date                  - Date - Date of receipt of the product.
//     * Contract               - CatalogRef.CounterpartyContracts - Contract with the supplier, can be used
//                               as an access Document. If there are no such details, or if the document cannot
//                               be accepted under the contract, you should send it Undefined.
//     * Terms            - CatalogRef.TermsOfPurchaseFromVendors - Agreement with the supplier, can be used
//                               as an access Document. If there are no such details, or if the document cannot
//                               be accepted under the agreement, it should be passed Undefined.
//     * GoodsReceiptOption - EnumRef.GoodsReceiptOptions - the document Attribute of the same name, if 
//                               there is no such Attribute, should be passed Indefinitely.
//     * Warehouse                 - CatalogRef.Warehouses - The warehouse where the product will be delivered.
//     * Sender           - DefinedType.SenderRecipientOfGoods - where the product is expected to arrive from.
//     * BusinessOperation - EnumRef.BusinessTransactions - eponymous document details.
//     * Products          - CatalogRef.Products - Nomenclature.
//     * Characteristic        - CatalogRef.ItemsCharacteristics - characteristic.
//     * Purpose            - CatalogRef.Assignments - purpose.
//     * ToControlQuality - Boolean - If incoming goods are subject to quality control, then it is True, otherwise it is False.
//     * RecordOfAPreviouslyReceivedLot - Boolean - If a product arrives that has previously arrived at another warehouse and is under quality control, then it is True, otherwise it is False.
//     * ControlledLotReference - CatalogRef.ControlledLots - A link to a party that was received earlier (if the movement parameter of the party that received it = True), otherwise it is undefined or an empty link. 
//     * BatchesIndicationStatus   - Number - Service field of the table part, if there is no such detail, pass 0.
//     * ExceedingOrder           - Boolean - Service field for invoices, which is set to true if the invoice is for
//                               an order, and the line has a sign that it is not linked to the order, for example, line Code = 0.
//     * Series                 - CatalogRef.ItemsBatches - The series, if there are no such details, should be passed Undefined.
//     * Count            - Number - Quantity.
//     * ReceiptUnderOrders  - Boolean - Indicates that the current document is an order invoice.
//     * ThisIsAnInvoice          - Boolean - Indicates that the current document is an invoice.
//     * ThisIsAdjustmentInsideInvoice - Boolean - Indicates that the invoice line is making a negative receipt.
//  MetadataObject - MetadataObjectDocument - metadata object of the current document.
//  MethodParameters - See ParametersOfModularHolding
//
Procedure IssueReceiptOfGoodsOnOneWayBasisInternal(Query,
													QueryTexts,
													Registers,
													QueryTextDocument_,
													MetadataObject,
													MethodParameters)
	
	TSSeriesName = MethodParameters.TSSeriesName;
	SynonymForDocumentTable = MethodParameters.SynonymForDocumentTable;
	ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder 
		= MethodParameters.ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder;
	SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages 
		= MethodParameters.SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages;
	
	QueryTextTTGoods =
	"SELECT
	|	DocumentData.Ref					AS Ref,
	|	DocumentData.Patch				AS Patch,
	|	DocumentData.CorrectedDocument	AS CorrectedDocument,
	|	DocumentData.OrderDocument					AS OrderDocument,
	|	DocumentData.Invoice				AS Invoice,
	|	DocumentData.Contract					AS Contract,
	|	DocumentData.Terms				AS Terms,
	|	DocumentData.GoodsReceiptOption	AS GoodsReceiptOption,
	|	DocumentData.Sender				AS Sender,
	|	DocumentData.BusinessOperation	AS BusinessOperation,
	|	DocumentData.ExceedingOrder				AS ExceedingOrder,
	|	DocumentData.ReceiptUnderOrders	AS ReceiptUnderOrders,
	|	DocumentData.ThisIsAnInvoice			AS ThisIsAnInvoice,
	|	DocumentData.Date					AS Date,
	|	DocumentData.Products			AS Products,
	|	DocumentData.Characteristic			AS Characteristic,
	|	&Purpose								AS Purpose,
	|	CASE
	|		WHEN DocumentData.ToControlQuality
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END AS ControlledLotReference,
	|	CASE
	|		WHEN DocumentData.ToControlQuality AND DocumentData.RecordOfAPreviouslyReceivedLot
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END AS ControlledLotReferenceItemsToBeReceived,
	|	DocumentData.BatchesIndicationStatus		AS BatchesIndicationStatus,
	|	DocumentData.Series					AS Series,
	|	DocumentData.Warehouse					AS Warehouse,
	|	&AdditionalSelectionFields,
	|	SUM(DocumentData.Count)		AS Count,
	|	MAX(DocumentData.ThisIsAdjustmentInsideInvoice) AS ThisIsAdjustmentInsideInvoice
	|INTO TTGoodsIssueReceiptOfGoodsOnOneWayBasis
	|FROM
	|	#DocumentData AS DocumentData
	|WHERE
	|	DocumentData.Count <> 0
	|
	|GROUP BY
	|	DocumentData.Ref,
	|	DocumentData.Patch,
	|	DocumentData.CorrectedDocument,
	|	DocumentData.OrderDocument,
	|	DocumentData.Invoice,
	|	DocumentData.Contract,
	|	DocumentData.Terms,
	|	DocumentData.GoodsReceiptOption,
	|	DocumentData.Sender,
	|	DocumentData.BusinessOperation,
	|	DocumentData.ExceedingOrder,
	|	DocumentData.ReceiptUnderOrders,
	|	DocumentData.ThisIsAnInvoice,
	|	DocumentData.Date,
	|	DocumentData.Products,
	|	DocumentData.Characteristic,
	|	&Purpose,
	|	CASE
	|		WHEN DocumentData.ToControlQuality
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END,
	|	CASE
	|		WHEN DocumentData.ToControlQuality AND DocumentData.RecordOfAPreviouslyReceivedLot
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END,
	|	DocumentData.Series,
	|	DocumentData.BatchesIndicationStatus,
	|	&AdditionalDimensionFields,
	|	DocumentData.Warehouse";
	
	QueryOptions = ParametersOfDocumentDataRequestText("CreateReceiptOfGoodsOnOneWayBasis",
															SynonymForDocumentTable);
	
	FillInRequestTextParameters(QueryTextTTGoods, QueryOptions);
	
	AdditionalSelectionFields		= New Array;
	AdditionalDimensionFields	= New Array;
	
	TemplateForSubstitutionOfAdditionalSelectionFields		= "DocumentData.%1 AS %1";
	TemplateForSubstitutingAdditionalDimensionFields	= "DocumentData.%1";
	
	// The fields of the collection selection of additional connection fields by series must be without an alias,
	// because duplications with the required fields of the data source are possible.
	For Each Field In MethodParameters.AdditionalSeriesConnectionFields Do
		AdditionalSelectionFields.Add(StrTemplate(TemplateForSubstitutingAdditionalDimensionFields, Field));
		AdditionalDimensionFields.Add(StrTemplate(TemplateForSubstitutingAdditionalDimensionFields, Field));
	EndDo;
	
	For Each KeyAndValue In MethodParameters.RedefinedSeriesConnectionFields Do
		If Not ValueIsFilled(KeyAndValue.Value) Then
			Continue;
		EndIf;
		
		AdditionalSelectionFields.Add(StrTemplate(TemplateForSubstitutionOfAdditionalSelectionFields, KeyAndValue.Value));
		AdditionalDimensionFields.Add(StrTemplate(TemplateForSubstitutingAdditionalDimensionFields, KeyAndValue.Value));
	EndDo;
	
	FieldSeparator = ",
		|	";
	
	TextOfSubstitutionOfAdditionalSelectionFields		= StrConcat(AdditionalSelectionFields, FieldSeparator);
	TextOfSubstitutionOfAdditionalDimensionFields	= StrConcat(AdditionalDimensionFields, FieldSeparator);
	
	If AdditionalSelectionFields.Count() > 0 Then
		QueryTextTTGoods = StrReplace(QueryTextTTGoods,
											"&AdditionalSelectionFields",
											TextOfSubstitutionOfAdditionalSelectionFields);
		QueryTextTTGoods = StrReplace(QueryTextTTGoods,
											"&AdditionalDimensionFields",
											TextOfSubstitutionOfAdditionalDimensionFields);
	Else
		QueryTextTTGoods = StrReplace(QueryTextTTGoods, "&AdditionalSelectionFields,", "");
		QueryTextTTGoods = StrReplace(QueryTextTTGoods, "&AdditionalDimensionFields,", "");
	EndIf;
	
	QueryTextTTGoods = StrReplace(QueryTextTTGoods, "DocumentData", SynonymForDocumentTable);
	
	TemporaryTableQueryTexts_ = New Structure;
	TemporaryTableQueryTexts_.Insert("TTGoodsIssueReceiptOfGoodsOnOneWayBasis", QueryTextTTGoods);
	
	If TSSeriesName <> "" Then
		
		RequestTextTTProductsWithoutOrder =
		"SELECT
		|	DocumentData.Ref					AS Ref,
		|	DocumentData.Date					AS Date,
		|	DocumentData.Products			AS Products,
		|	DocumentData.Characteristic			AS Characteristic,
		|	&Purpose								AS Purpose,
		|	CASE
		|		WHEN DocumentData.ToControlQuality
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReference,
		|	DocumentData.BatchesIndicationStatus		AS BatchesIndicationStatus,
		|	DocumentData.Series					AS Series,
		|	DocumentData.Warehouse					AS Warehouse,
		|	&AdditionalSelectionFields,
		|	SUM(DocumentData.Count)		AS Count,
		|	MAX(DocumentData.ThisIsAdjustmentInsideInvoice) AS ThisIsAdjustmentInsideInvoice
		|INTO TTProductsWithoutOrderIssueReceiptOfGoodsOnOdnohodovka
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	DocumentData.Count <> 0
		|
		|GROUP BY
		|	DocumentData.Ref,
		|	DocumentData.Date,
		|	DocumentData.Products,
		|	DocumentData.Characteristic,
		|	&Purpose,
		// When in a document for the same item with a batch in a separate tabular part
		// there are lines with the Check Quality attribute set and with the reset one.
		// In the tabular part of the batches there should be a Controlled Lot reference field and a connection should be organized using this field.
		// Otherwise, an error is returned in the processing of the fill check. 
		|	CASE
		|		WHEN DocumentData.ToControlQuality
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END,
		|	DocumentData.Series,
		|	DocumentData.BatchesIndicationStatus,
		|	&AdditionalDimensionFields,
		|	DocumentData.Warehouse";
		
		FillInRequestTextParameters(RequestTextTTProductsWithoutOrder, QueryOptions);
		If MethodParameters.AdditionalSeriesConnectionFields.Count() > 0 Then
			RequestTextTTProductsWithoutOrder = StrReplace(RequestTextTTProductsWithoutOrder,
														"&AdditionalSelectionFields",
														TextOfSubstitutionOfAdditionalSelectionFields);
			RequestTextTTProductsWithoutOrder = StrReplace(RequestTextTTProductsWithoutOrder,
														"&AdditionalDimensionFields",
														TextOfSubstitutionOfAdditionalDimensionFields);
		Else
			RequestTextTTProductsWithoutOrder = StrReplace(RequestTextTTProductsWithoutOrder,
														"&AdditionalSelectionFields,",
														"");
			RequestTextTTProductsWithoutOrder = StrReplace(RequestTextTTProductsWithoutOrder,
														"&AdditionalDimensionFields,",
														"");
		EndIf;
		
		RequestTextTTProductsWithoutOrder = StrReplace(RequestTextTTProductsWithoutOrder, "DocumentData", SynonymForDocumentTable);
		TemporaryTableQueryTexts_.Insert("TTProductsWithoutOrderIssueReceiptOfGoodsOnOdnohodovka", RequestTextTTProductsWithoutOrder);
		
		QueryTextTTSetOfSeries =
		"SELECT
		|	DocumentData.Ref					AS Ref,
		|	DocumentData.Date					AS Date,
		|	DocumentData.Products			AS Products,
		|	DocumentData.Characteristic			AS Characteristic,
		|	&Purpose								AS Purpose,
		|	DocumentData.ControlledLotReference    AS ControlledLotReference,
		|	MAX(DocumentData.BatchesIndicationStatus) AS BatchesIndicationStatus,
		|	&Series									AS Series,
		|	DocumentData.Series					AS TSSeriesGoods,
		|	DocumentData.Warehouse					AS Warehouse,
		|	MAX(&Count)					AS Count,
		|	MAX(DocumentData.ThisIsAdjustmentInsideInvoice) AS ThisIsAdjustmentInsideInvoice
		|INTO TTSeriesIssueReceiptOfGoodsOnOdnohodovka
		|FROM
		|	TTProductsWithoutOrderIssueReceiptOfGoodsOnOdnohodovka AS DocumentData
		|		INNER JOIN TSSeriesName AS SeriesData_
		|		ON DocumentData.Ref = SeriesData_.Ref
		|			AND &ConditionForJoiningTables
		|
		|WHERE
		|	&Count <> 0
		|
		|GROUP BY
		|	DocumentData.Ref,
		|	DocumentData.Date,
		|	SeriesData_.LineNumber,
		|	DocumentData.Products,
		|	DocumentData.Characteristic,
		|	&Purpose,
		|	DocumentData.ControlledLotReference,
		|	&Series,
		|	DocumentData.Series,
		|	&AdditionalDimensionFields,
		|	DocumentData.Warehouse";
		
		ListOfDimensionFields = New Array;
		ListOfDimensionFields.Add("Ref");
		ListOfDimensionFields.Add("Date");
		ListOfDimensionFields.Add("Products");
		ListOfDimensionFields.Add("Characteristic");
		ListOfDimensionFields.Add("Purpose");
		ListOfDimensionFields.Add("ControlledLotReference");
		ListOfDimensionFields.Add("BatchesIndicationStatus");
		ListOfDimensionFields.Add("Series");
		ListOfDimensionFields.Add("TSSeriesGoods");
		ListOfDimensionFields.Add("Warehouse");
		
		For Each Field In MethodParameters.AdditionalSeriesConnectionFields Do
			ListOfDimensionFields.Add(Field);
		EndDo;
		
		For Each KeyAndValue In MethodParameters.RedefinedSeriesConnectionFields Do
			If Not ValueIsFilled(KeyAndValue.Value) Then
				Continue;
			EndIf;
			
			ListOfDimensionFields.Add(KeyAndValue.Value);
		EndDo;
		
		ParametersOfConnectionConditions = ParametersOfConnectionConditionOfSTCHSeries();
		ParametersOfConnectionConditions.FieldsTSGoods = ListOfDimensionFields;
		ParametersOfConnectionConditions.RedefinedConnectionFields = MethodParameters.RedefinedSeriesConnectionFields;
		
		ConnectionCondition = StchSeriesConnectionCondition(MetadataObject, TSSeriesName, ParametersOfConnectionConditions);
		
		QueryTextTTSetOfSeries = StrReplace(QueryTextTTSetOfSeries,
											"&ConditionForJoiningTables",
											ConnectionCondition);
		QueryTextTTSetOfSeries = StrReplace(QueryTextTTSetOfSeries,
											"TSSeriesName",
											MetadataObject.FullName() + "." + TSSeriesName);
		
		FillInRequestTextParameters(QueryTextTTSetOfSeries, QueryOptions);
		
		If AdditionalSelectionFields.Count() > 0 Then
			QueryTextTTSetOfSeries = StrReplace(QueryTextTTSetOfSeries,
												"&AdditionalDimensionFields",
												TextOfSubstitutionOfAdditionalDimensionFields);
		Else
			QueryTextTTSetOfSeries = StrReplace(QueryTextTTSetOfSeries, "&AdditionalDimensionFields,", "");
		EndIf;
		
		For Each KeyValue In MethodParameters.SubstitutionOfSeriesFields Do
			QueryTextTTSetOfSeries = StrReplace(QueryTextTTSetOfSeries, KeyValue.Key, KeyValue.Value);
		EndDo;
		
		QueryTextTTSetOfSeries = StrReplace(QueryTextTTSetOfSeries, "DocumentData", SynonymForDocumentTable);
		
		TemporaryTableQueryTexts_.Insert("TTSeriesIssueReceiptOfGoodsOnOdnohodovka", QueryTextTTSetOfSeries);
		
		RequestTextTemplateForProductsInWarehouses =
		"SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref               AS Recorder,
		|	DocumentData.Date                 AS Period,
		|	DocumentData.Products         AS Products,
		|	DocumentData.Characteristic       AS Characteristic,
		|	DocumentData.Purpose           AS Purpose,
		|	DocumentData.ControlledLotReference AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN(4, 6, 8, 10, 14, 20)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                AS Series,
		|	DocumentData.Warehouse                AS Warehouse,
		|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
		|	DocumentData.Count           AS InStock,
		|	0                                    AS ToShip,
		|	FALSE                                 AS ToControlBalance
		|FROM
		|	TTGoodsIssueReceiptOfGoodsOnOneWayBasis AS DocumentData
		|WHERE
		|	(NOT DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10)
		|		OR DocumentData.Series <> VALUE(Catalog.ItemsBatches.EmptyRef))
		|	AND (NOT (&OrderSchemeIsUsedUponReceipt)
		|		OR DocumentData.Count < 0
		|			AND DocumentData.ThisIsAdjustmentInsideInvoice)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND &SelectionByOrderOfSurplusShortages
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref               AS Recorder,
		|	DocumentData.Date                 AS Period,
		|	DocumentData.Products         AS Products,
		|	DocumentData.Characteristic       AS Characteristic,
		|	DocumentData.Purpose           AS Purpose,
		|	DocumentData.ControlledLotReference AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN(4, 6, 8, 10)
		|			THEN  DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                AS Series,
		|	DocumentData.Warehouse                AS Warehouse,
		|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
		|	DocumentData.Count           AS InStock,
		|	0                                    AS ToShip,
		|	FALSE                                 AS ToControlBalance
		|FROM
		|	TTSeriesIssueReceiptOfGoodsOnOdnohodovka AS DocumentData
		|
		|WHERE
		|	(NOT (&OrderSchemeIsUsedUponReceipt)
		|		OR DocumentData.Count < 0
		|			AND DocumentData.ThisIsAdjustmentInsideInvoice)
		|	AND DocumentData.BatchesIndicationStatus IN(4, 6, 8, 10)
		|	AND DocumentData.TSSeriesGoods = VALUE(Catalog.ItemsBatches.EmptyRef)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND &SelectionByOrderOfSurplusShortages
		|";
		
	Else
		
		RequestTextTemplateForProductsInWarehouses = 
		"SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref               AS Recorder,
		|	DocumentData.Date                 AS Period,
		|	DocumentData.Products         AS Products,
		|	DocumentData.Characteristic       AS Characteristic,
		|	DocumentData.Purpose           AS Purpose,
		|	DocumentData.ControlledLotReference AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14, 20)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                AS Series,
		|	DocumentData.Warehouse                AS Warehouse,
		|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
		|	DocumentData.Count           AS InStock,
		|	0                                    AS ToShip,
		|	FALSE                                 AS ToControlBalance
		|FROM
		|	TTGoodsIssueReceiptOfGoodsOnOneWayBasis AS DocumentData
		|WHERE
		|	(NOT (&OrderSchemeIsUsedUponReceipt)
		|		OR DocumentData.Count < 0
		|			AND DocumentData.ThisIsAdjustmentInsideInvoice)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND &SelectionByOrderOfSurplusShortages
		|";
		
	EndIf;
	
	TemplateForGoodsToReceiveRequestText =
	"SELECT
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	|	DocumentData.Ref                 AS Recorder,
	|	DocumentData.Date                   AS Period,
	|	DocumentData.OrderDocument                  AS DocumentInflow,
	|	DocumentData.Products           AS Products,
	|	DocumentData.Characteristic         AS Characteristic,
	|	DocumentData.Purpose             AS Purpose,
	|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
	|	DocumentData.Warehouse                  AS Warehouse,
	|	DocumentData.Sender            AS Sender,
	|	DocumentData.BusinessOperation  AS BusinessOperation,
	|	&RequirementsForRegistrationOfInvoicesByOrder AS Series,
	|	DocumentData.Count             AS ToRegisterInvoicesByReference,
	|	0                                      AS ToRegisterReceiptsByReference,
	// Not used, needed for adapted text.
	|	0                                      AS ToRegisterReceiptsByInvoices,
	|	0                                      AS ToRegisterGoodsReceipts,
	|	0                                      AS GoodsReceiptNotesToRegister
	|FROM
	|	TTGoodsIssueReceiptOfGoodsOnOneWayBasis AS DocumentData
	|WHERE
	|	DocumentData.ThisIsAnInvoice
	|	AND DocumentData.ReceiptUnderOrders
	|	AND NOT DocumentData.ExceedingOrder
	|	AND DocumentData.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND DocumentData.Count <> 0
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	|	DocumentData.Ref                 AS Recorder,
	|	DocumentData.Date                   AS Period,
	|	CASE
	|		WHEN (&ContractIsOrder
	|				OR NOT DocumentData.ReceiptUnderOrders
	|				OR DocumentData.ExceedingOrder)
	|			THEN &OdnohodovkaReceiptDocument
	|		ELSE DocumentData.OrderDocument
	|	END                                  AS DocumentInflow,
	|	DocumentData.Products           AS Products,
	|	DocumentData.Characteristic         AS Characteristic,
	|	DocumentData.Purpose             AS Purpose,
	|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
	|	DocumentData.Warehouse                  AS Warehouse,
	|	DocumentData.Sender            AS Sender,
	|	DocumentData.BusinessOperation  AS BusinessOperation,
	|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	|	0                                      AS ToRegisterInvoicesByReference,
	|	DocumentData.Count             AS ToRegisterReceiptsByReference,
	// Not used, needed for adapted text.
	|	0                                      AS ToRegisterReceiptsByInvoices,
	|	0                                      AS ToRegisterGoodsReceipts,
	|	0                                      AS GoodsReceiptNotesToRegister
	|FROM
	|	TTGoodsIssueReceiptOfGoodsOnOneWayBasis AS DocumentData
	|WHERE
	|	DocumentData.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND DocumentData.Count <> 0
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	|	DocumentData.Ref                 AS Recorder,
	|	DocumentData.Date                   AS Period,
	|	&OdnohodovkaReceiptDocument        AS DocumentInflow,
	|	DocumentData.Products           AS Products,
	|	DocumentData.Characteristic         AS Characteristic,
	|	DocumentData.Purpose             AS Purpose,
	|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
	|	DocumentData.Warehouse                  AS Warehouse,
	|	DocumentData.Sender            AS Sender,
	|	DocumentData.BusinessOperation  AS BusinessOperation,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (14, 18, 20) THEN
	|			DocumentData.Series
	|		ELSE
	|			VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END                                  AS Series,
	|	0                                      AS ToRegisterInvoicesByReference,
	|	0                                      AS ToRegisterReceiptsByReference,
	// Not used, needed for adapted text.
	|	0                                      AS ToRegisterReceiptsByInvoices,
	|	DocumentData.Count             AS ToRegisterGoodsReceipts,
	|	0                                      AS GoodsReceiptNotesToRegister
	|FROM
	|	TTGoodsIssueReceiptOfGoodsOnOneWayBasis AS DocumentData
	|WHERE
	|	&OrderSchemeIsUsedUponReceipt
	|	AND DocumentData.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage))
	|	AND DocumentData.Count <> 0";
	
	If Not ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder Then
		TemplateForGoodsToReceiveRequestText = StrReplace(TemplateForGoodsToReceiveRequestText, "&RequirementsForRegistrationOfInvoicesByOrder",
			"VALUE(Catalog.ItemsBatches.EmptyRef)");
	EndIf;
	If SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages Then
		RequestTextTemplateForProductsInWarehouses = StrReplace(RequestTextTemplateForProductsInWarehouses, 
		"&SelectionByOrderOfSurplusShortages", "&OrderSchemeIsUsedWhenReflectingSurplusShortages");
	Else
		RequestTextTemplateForProductsInWarehouses = StrReplace(RequestTextTemplateForProductsInWarehouses, 
		"&SelectionByOrderOfSurplusShortages", "TRUE");
	EndIf;
	
	FillInRequestTextParameters(RequestTextTemplateForProductsInWarehouses,		QueryOptions);
	FillInRequestTextParameters(TemplateForGoodsToReceiveRequestText,	QueryOptions);
	
	RequestTextTemplateForProductsInWarehouses		= StrReplace(RequestTextTemplateForProductsInWarehouses,
															"DocumentData",
															SynonymForDocumentTable);
	TemplateForGoodsToReceiveRequestText	= StrReplace(TemplateForGoodsToReceiveRequestText,
															"DocumentData",
															SynonymForDocumentTable);
	
	ReflectionTemplateTexts = New Structure;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("ProductStock", Registers) Then
		ReflectionTemplateTexts.Insert("ProductStock", RequestTextTemplateForProductsInWarehouses);
	EndIf;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsToReceive", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsToReceive", TemplateForGoodsToReceiveRequestText);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure(SynonymForDocumentTable, QueryTextDocument_);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests,
															TemporaryTableQueryTexts_);
	
EndProcedure

Procedure IssueSurplusShortagesInWarehouseInternal(Query, QueryTexts, Registers,
		QueryTextDocument_, SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt = False)

	ReflectionTemplateTexts = New Structure();
	TextsOfDocumentDataRequests = New Structure();
	TemporaryTableQueryTexts_ = New Structure();

	TextsOfDocumentDataRequests.Insert("DocumentData", QueryTextDocument_);

	RequestTextTemplateForProductsInWarehouses = "";
	TemplateForTextOfGoodsRequestForRegistrationOfSurplusShortages = "";
	If SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt Then
		RequestTextTemplateForProductsInWarehouses = "SELECT
			|	CASE
			|		WHEN DocumentData.Count > 0
			|			THEN VALUE(AccumulationRecordType.Receipt)
			|		ELSE VALUE(AccumulationRecordType.Expense)
			|	END				AS RecordType,
			|	DocumentData.Ref			AS Recorder,
			|	DocumentData.Date			AS Period,
			|	DocumentData.Products	AS Products,
			|	DocumentData.Characteristic	AS Characteristic,
			|	CASE
			|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
			|			THEN DocumentData.Purpose
			|		ELSE VALUE(Catalog.Assignments.EmptyRef)
			|	END							AS Purpose,
			|	DocumentData.ControlledLotReference AS ControlledLotReference,
			|	CASE
			|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
			|			THEN DocumentData.Series
			|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
			|	END							AS Series,
			|	DocumentData.Warehouse			AS Warehouse,
			|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
			|	CASE
			|		WHEN
			|			DocumentData.Count < 0
			|			THEN 
			|				-DocumentData.Count
			|			ELSE
			|				DocumentData.Count
			|	END							AS InStock,
			|	0								AS ToShip,
			|	FALSE							AS ToControlBalance
			|FROM
			|	#DocumentData AS DocumentData
			|WHERE
			|	(
			|	((DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
			|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
			|		AND DocumentData.ItIsAllowedToReflectBalanceOnOrderWarehouse)
			|	OR
			|	( NOT (DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
			|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
			|		AND DocumentData.ItIsAllowedToReflectBalanceForNonOrderWarehouse)
			|	)
			|	AND NOT (DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
			|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages)
			|	AND DocumentData.Products.ItemsType IN
			|			(VALUE(Enum.ItemsTypes.OwnGoods),
			|			 VALUE(Enum.ItemsTypes.ReusablePackage))";
		
		TemplateForTextOfGoodsRequestForRegistrationOfSurplusShortages =
		"SELECT
		|	CASE
		|		WHEN DocumentData.Count > 0
		|			THEN VALUE(AccumulationRecordType.Expense) 
		|		ELSE VALUE(AccumulationRecordType.Receipt) 
		|	END							AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Date			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END							AS Purpose,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus = 14
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END							AS Series,
		|	CASE
		|		WHEN
		|			DocumentData.Count < 0
		|			THEN
		|				-DocumentData.Count
		|			ELSE
		|				DocumentData.Count
		|	END							AS ToCertificateRegistration
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt
		|		AND DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.ItIsAllowedToReflectBalanceOnOrderWarehouse
		|	OR
		|	DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND NOT DocumentData.ItIsAllowedToReflectBalanceOnOrderWarehouse";
		
	Else
		RequestTextTemplateForProductsInWarehouses = "SELECT
		|	CASE
		|		WHEN DocumentData.Count > 0
		|			THEN VALUE(AccumulationRecordType.Receipt)
		|		ELSE VALUE(AccumulationRecordType.Expense)
		|	END				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Date			AS Period,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END							AS Purpose,
		|	DocumentData.ControlledLotReference AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END							AS Series,
		|	DocumentData.Warehouse			AS Warehouse,
		|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
		|	CASE
		|		WHEN
		|			DocumentData.Count < 0
		|			THEN 
		|				-DocumentData.Count
		|			ELSE
		|				DocumentData.Count
		|	END							AS InStock,
		|	0								AS ToShip,
		|	FALSE							AS ToControlBalance
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	NOT (DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))";
		
		TemplateForTextOfGoodsRequestForRegistrationOfSurplusShortages =
		"SELECT
		|	CASE
		|		WHEN DocumentData.Count > 0
		|			THEN VALUE(AccumulationRecordType.Expense) 
		|		ELSE VALUE(AccumulationRecordType.Receipt) 
		|	END							AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Date			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END							AS Purpose,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus = 14
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END							AS Series,
		|	CASE
		|		WHEN
		|			DocumentData.Count < 0
		|			THEN
		|				-DocumentData.Count
		|			ELSE
		|				DocumentData.Count
		|	END							AS ToCertificateRegistration
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	DocumentData.Warehouse.UseWarehouseManagemantSystemForGoodsSurplusesShortages
		|		AND DocumentData.Date >= DocumentData.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages";
		
	EndIf;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForRegistrationOfSurplusesAndShortages", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForRegistrationOfSurplusesAndShortages", TemplateForTextOfGoodsRequestForRegistrationOfSurplusShortages);
	EndIf;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("ProductStock", Registers) Then
		ReflectionTemplateTexts.Insert("ProductStock", RequestTextTemplateForProductsInWarehouses);
	EndIf;
	
	DocumentsPosting.AddDocumentReflectionRequest(Query, QueryTexts, ReflectionTemplateTexts, TextsOfDocumentDataRequests, TemporaryTableQueryTexts_);
	
EndProcedure

Procedure IssueShipmentOfGoodsInternal(Query,
									QueryTexts,
									Registers,
									TextOfDocumentDataRequest,
									ParametersOfModularHolding)
	
	MetadataObject = ParametersOfModularHolding.MetadataObject;
	TSSeriesName = ParametersOfModularHolding.TSSeriesName;
	SynonymForDocumentTS = ParametersOfModularHolding.SynonymForDocumentTable;
	SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt = ParametersOfModularHolding.SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt;
	SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages = ParametersOfModularHolding.SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages;
	
	If SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt
		And SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages Then
	TemplateForGoodsForShipmentRequestText =
		// Registration of shipment from a non-border warehouse by waybill on the basis of an order (expense for "COtgruzke"
		// and "Co-registration").
		"SELECT
		|	&RecordTypeExpense						AS RecordType,
		|	DocumentData.Ref					AS Recorder,
		|	DocumentData.Period					AS Period,
		|	DocumentData.Warehouse					AS Warehouse,
		|	DocumentData.Recipient				AS Recipient,
		|	&DocumentShipments						AS DocumentShipments,
		|	DocumentData.Products			AS Products,
		|	DocumentData.Characteristic			AS Characteristic,
		|	&Purpose								AS Purpose,
		|	DocumentData.ControlledLotReference	AS ControlledLotReference,
		|	&Series									AS Series,
		|	0										AS InReserve,
		|	DocumentData.Count				AS ToShip,
		|	DocumentData.Count				AS ToRegister,
		|	0										AS ForAssembly,
		|	0										AS AssemblyInProgress,
		|	0										AS Assembled
		|FROM
		|	#DocumentData AS DocumentData
		|
		|WHERE
		|	&ThisIsAProduct
