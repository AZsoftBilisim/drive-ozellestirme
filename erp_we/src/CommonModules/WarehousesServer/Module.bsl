Function DistributeNegativeNumbers(RequestProductTable)
	
	Query = New Query;
	Query.Text = 
	"SELECT
	|	ProductsTable.Period							AS Period,
	|	ProductsTable.Warehouse							AS Warehouse,
	|	ProductsTable.DocumentShipments				AS DocumentShipments,
	|	ProductsTable.Recipient						AS Recipient,
	|	ProductsTable.Products					AS Products,
	|	ProductsTable.Characteristic					AS Characteristic,
	|	ProductsTable.Purpose						AS Purpose,
	|	ProductsTable.ControlledLotReference			AS ControlledLotReference,
	|	ProductsTable.Series							AS Series,
	|	ProductsTable.Count						AS Count,
	|	ProductsTable.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	ProductsTable.TransportationJob				AS TransportationJob,
	|	ProductsTable.AllowableVariance			AS AllowableVariance
	|INTO RequestProductTable
	|FROM
	|	&RequestProductTable AS ProductsTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsTable.Period							AS Period,
	|	ProductsTable.Warehouse							AS Warehouse,
	|	ProductsTable.DocumentShipments				AS DocumentShipments,
	|	ProductsTable.Recipient						AS Recipient,
	|	ProductsTable.Products					AS Products,
	|	ProductsTable.Characteristic					AS Characteristic,
	|	ProductsTable.Purpose						AS Purpose,
	|	ProductsTable.ControlledLotReference			AS ControlledLotReference,
	|	ProductsTable.Series							AS Series,
	|	ProductsTable.Count						AS Count,
	|	ProductsTable.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	ProductsTable.TransportationJob				AS TransportationJob,
	|	ProductsTable.AllowableVariance			AS AllowableVariance
	|FROM
	|	RequestProductTable AS ProductsTable
	|WHERE
	|	ProductsTable.Count > 0
	|
	|ORDER BY
	|	ProductsTable.Period DESC
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsTable.Period							AS Period,
	|	ProductsTable.Warehouse							AS Warehouse,
	|	ProductsTable.DocumentShipments				AS DocumentShipments,
	|	ProductsTable.Recipient						AS Recipient,
	|	ProductsTable.Products					AS Products,
	|	ProductsTable.Characteristic					AS Characteristic,
	|	ProductsTable.Purpose						AS Purpose,
	|	ProductsTable.ControlledLotReference			AS ControlledLotReference,
	|	ProductsTable.Series							AS Series,
	|	ProductsTable.Count						AS Count,
	|	ProductsTable.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	ProductsTable.TransportationJob				AS TransportationJob,
	|	ProductsTable.AllowableVariance			AS AllowableVariance
	|FROM
	|	RequestProductTable AS ProductsTable
	|WHERE
	|	ProductsTable.Count < 0";
	
	Query.SetParameter("RequestProductTable", RequestProductTable);
	
	Result = Query.ExecuteBatch();
	
	If Result[2].IsEmpty() Then
		Return RequestProductTable;
	Else
		
		ResourceNames	= "Warehouse, Recipient, DocumentShipments, Products, Characteristic, Purpose,
							|ControlledLotReference, Series, ShipmentUnderTransportationJob, TransportationJob";
		SearchData	= New Structure(ResourceNames);
		
		NegativeQuantity = Result[2].Unload();
		PositiveQuantity = Result[1].Unload();
		PositiveQuantity.Indexes.Add(ResourceNames);
		
		For Each NegativeString In NegativeQuantity Do
			
			FillPropertyValues(SearchData, NegativeString);
			PositiveLines = PositiveQuantity.FindRows(SearchData);
			
			QuantityToDecrease = -NegativeString.Count;
			
			For Each PositiveString In PositiveLines Do
				
				CanBeReduced = ?(PositiveString.Count >= QuantityToDecrease,
									QuantityToDecrease,
									PositiveString.Count);
				
				PositiveString.Count = PositiveString.Count - CanBeReduced;
				
				QuantityToDecrease = QuantityToDecrease - CanBeReduced;
				
				If QuantityToDecrease = 0 Then
					Break;
				EndIf;
				
			EndDo;
			
			If QuantityToDecrease = 0 Then
				Continue;
			EndIf;
			
		EndDo;
		
		Return PositiveQuantity;
		
	EndIf;
	
EndFunction

// Combines goods from orders that have a shipment date less than the current date.
//
Procedure MergeOrdersForCurDate(Parameters, CurrentDate, ExecutedOrders)
	
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT
	|	GoodsTable.Ref				AS Ref,
	|	DocumentTable.Warehouse				AS Warehouse,
	|	DocumentTable.Premise			AS Premise,
	|	CASE
	|		WHEN DocumentTable.Recipient IN (&EmptyRecipient)
	|			THEN GoodsTable.ReferenceOrder
	|		ELSE DocumentTable.Recipient
	|	END								AS Recipient,
	|	CASE
	|		WHEN GoodsTable.ReferenceOrder REFS Document.SalesOrder
	|				OR GoodsTable.ReferenceOrder REFS Document.TransferOfGoodsToBailee
	|				OR GoodsTable.ReferenceOrder REFS Document.GoodsShipmentToCustomer
	|				OR GoodsTable.ReferenceOrder REFS Document.CustomerInvoice
	|			THEN CASE
	|				WHEN ISNULL(GoodsTable.ReferenceOrder.Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|					THEN GoodsTable.ReferenceOrder
	|				ELSE UNDEFINED
	|			END
	|		ELSE UNDEFINED
	|	END								AS OrderGrouping,
	|	DocumentTable.TransportationJob	AS TransportationJob,
	|	DocumentTable.DateOfShipment		AS DateOfShipment
	|FROM
	|	Document.GoodsIssueNote.GoodsByReferences AS GoodsTable
	|		INNER JOIN Document.GoodsIssueNote AS DocumentTable
	|		ON GoodsTable.Ref = DocumentTable.Ref
	|
	|WHERE
	|	DocumentTable.Posted
	|	AND DocumentTable.Warehouse = &Warehouse
	|	AND DocumentTable.Recipient = &Recipient
	|	AND DocumentTable.DateOfShipment <= &CurrentDate
	|	AND (NOT &RoomIsFull
	|		OR DocumentTable.Premise = &Premise)
	|	AND (&ByAllReferences
	|		OR GoodsTable.ReferenceOrder IN (&ShipmentReferences))
	|	AND (NOT &TransportationTaskCompleted
	|		OR DocumentTable.TransportationJob = &TransportationJob)
	|	AND DocumentTable.Status = VALUE(Enum.GoodsIssueNoteStatuses.Prepared)
	|
	|ORDER BY
	|	TransportationJob,
	|	Recipient,
	|	OrderGrouping,
	|	Warehouse,
	|	Premise,
	|	DateOfShipment DESC";
	
	Query.SetParameter("CurrentDate",					CurrentDate);
	Query.SetParameter("Warehouse",							Parameters.Warehouse);
	Query.SetParameter("Recipient",						Parameters.Recipient);
	Query.SetParameter("EmptyRecipient",				EmptyReceiverSender());
	Query.SetParameter("Premise",						Parameters.Premise);
	Query.SetParameter("RoomIsFull",				ValueIsFilled(Parameters.Premise));
	Query.SetParameter("ByAllReferences",			Parameters.ShipmentReferences.Count() = 0);
	Query.SetParameter("ShipmentReferences",			Parameters.ShipmentReferences);
	Query.SetParameter("TransportationTaskCompleted",	ValueIsFilled(Parameters.TransportationJob));
	Query.SetParameter("TransportationJob",				Parameters.TransportationJob);
	
	Selection = Query.Execute().Select();
	
	While Selection.NextByFieldValue("TransportationJob") Do
		While Selection.NextByFieldValue("Recipient") Do
			While Selection.NextByFieldValue("OrderGrouping") Do
				While Selection.NextByFieldValue("Warehouse") Do
					While Selection.NextByFieldValue("Premise") Do
						// We determine which order we will put everything
						// in, we put everything in the most senior order by the date of shipment.
						CurOrderObject = Undefined;
						
						If Selection.Next() Then
							BeginTransaction();
							
							Try
								DataLock = New DataLock;
								DataLockItem = DataLock.Add("Document.GoodsIssueNote");
								DataLockItem.SetValue("Ref", Selection.Ref);
								DataLockItem.Mode = DataLockMode.Exclusive;
								DataLock.Lock();
								
								CurOrderObject = Selection.Ref.GetObject(); // DocumentObject.GoodsIssueNote
								
								If CurOrderObject <> Undefined Then
									
									While Selection.Next() Do
										
										DataLock = New DataLock;
										DataLockItem = DataLock.Add("Document.GoodsIssueNote");
										DataLockItem.SetValue("Ref", Selection.Ref);
										DataLockItem.Mode = DataLockMode.Exclusive;
										DataLock.Lock();
										
										SpendingOrderObject  = Selection.Ref.GetObject(); // DocumentObject -
										
										GoodsByReferences = SpendingOrderObject.GoodsByReferences.Unload();
										For Each String In GoodsByReferences Do
											NewRow = CurOrderObject.GoodsByReferences.Add();
											FillPropertyValues(NewRow, String);
										EndDo;
										
										ShippedGoods = SpendingOrderObject.ShippedGoods.Unload();
										For Each String In ShippedGoods Do
											NewRow = CurOrderObject.ShippedGoods.Add();
											FillPropertyValues(NewRow, String);
										EndDo;
										
										Result = Common.RefsToObjectFound(Selection.Ref);
										If Result Then
											SpendingOrderObject.SetDeletionMark(True);
										Else
											SpendingOrderObject.Delete();
										EndIf;
									EndDo;
									
									DocumentChanged = CurOrderObject.Modified();
									
									If CurOrderObject.ShipmentUnderTransportationJob
										And TypeOf(CurOrderObject.TransportationJob) = Type("DocumentRef.Trip") Then
										
										// Flight orders always inherit the date of shipment from the flight.
										
									ElsIf DocumentChanged Then
										// The search for an order when reissuing will be carried out provided that the date
										// may not have been updated.
										CurOrderObject.DateOfShipment = CurrentDate;
									EndIf;
									
									If DocumentChanged Then
										CurOrderObject.Write(DocumentWriteMode.Posting);
										
										ExecutedOrdersLine = ExecutedOrders.Add();
										FillPropertyValues(ExecutedOrdersLine, CurOrderObject);
										ExecutedOrdersLine.ExpenseOrder = CurOrderObject.Ref;
										ExecutedOrdersLine.Action = "Reregister";
									EndIf;
									
								EndIf;
								
								CommitTransaction();
							Except
								RollbackTransaction();
								
								WriteLogEvent(
									NStr("ru = 'Объединение расходных ордеров на актуальную дату';
										|vi = 'Merge goods issues as of the current date';
										|en = 'Merge goods issues as of the current date'; fa = 'Merge goods issues as of the current date';
										|it = 'Merge goods issues as of the current date';
										|pl = 'Merge goods issues as of the current date';
										|tr = 'Ambar çıkış fişlerinin güncel tarihte birleştirilmesi'"),
									EventLogLevel.Error,
									,
									,
									ErrorProcessing.DetailErrorDescription(ErrorInfo()));
								
								Raise;
							EndTry;
						
						EndIf;
					EndDo;
				EndDo;
			EndDo;
		EndDo;
	EndDo;
	
EndProcedure

// Reduces the quantity in the prepared expenditure orders if the quantity of goods to ship has decreased
// by order.
//
// Parameters:
//	ProductsReadyForAssembly - ValueTable - A table containing information about the goods to be collected.
//	ExecutedOrders - ValueTable - a table containing information about completed spending orders.
//	OrderRecorded - Boolean - indicates whether the document is reflected in accounting.
//
Procedure ReduceNumberOfOrders(ProductsReadyForAssembly, ExecutedOrders, OrderRecorded)
	
	QueriesTexts = New Array;
	
	QueryText = 
	"SELECT
	|	ProductsReadyForAssembly.Period						AS Period,
	|	ProductsReadyForAssembly.DocumentShipments				AS DocumentShipments,
	|	ProductsReadyForAssembly.Recipient					AS Recipient,
	|	ProductsReadyForAssembly.Warehouse							AS Warehouse,
	|	ProductsReadyForAssembly.Products					AS Products,
	|	ProductsReadyForAssembly.Characteristic				AS Characteristic,
	|	ProductsReadyForAssembly.Purpose					AS Purpose,
	|	ProductsReadyForAssembly.Series							AS Series,
	|	ProductsReadyForAssembly.Count					AS Count,
	|	ProductsReadyForAssembly.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	ProductsReadyForAssembly.TransportationJob			AS TransportationJob
	|INTO ProductsReadyForAssembly
	|FROM
	|	&ProductsReadyForAssembly AS ProductsReadyForAssembly
	|
	|INDEX BY
	|	Period,
	|	Warehouse,
	|	Recipient,
	|	DocumentShipments,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series,
	|	TransportationJob";
	QueriesTexts.Add(QueryText);
	
	If Not GoodsDeliveryClientServer.UsedDelivery()
		Or GoodsDeliveryClientServer.UsedDelivery20() Then
		
		QueryText = QueryTextReduceNumberOfDeliveryOrdersBy20();
		
	Else
		QueryText = QueryTextReduceNumberOfDeliveryOrdersBy25();
	EndIf;
	
	QueriesTexts.Add(QueryText);
	
	Query = New Query;
	Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	Query.SetParameter("ProductsReadyForAssembly", ProductsReadyForAssembly);
	Query.SetParameter("EmptyRecipient", EmptyReceiverSender());
	Query.SetParameter("EmptyItinerary", EmptyItinerary());
	
	Selection = Query.Execute().Select(QueryResultIteration.ByGroups);
	
	While Selection.NextByFieldValue("Ref") Do
		BeginTransaction();
		
		Try
			DataLock = New DataLock;
			DataLockItem = DataLock.Add("Document.GoodsIssueNote");
			DataLockItem.SetValue("Ref", Selection.Ref);
			DataLockItem.Mode = DataLockMode.Exclusive;
			DataLock.Lock();
			
			GoodsIssueNote  = Selection.Ref.GetObject();
			
			Goods = GoodsIssueNote.GoodsByReferences;
			
			While Selection.Next() Do
				If Goods.Count() = 0 Then
					Break;
				EndIf;
				
				LineProducts_ = Goods[Selection.LineNumber - 1];
				LineProducts_.Count = LineProducts_.Count - Selection.Count;
				
				If LineProducts_.Count <= 0 Then
					Goods.Delete(Selection.LineNumber - 1);
				EndIf;
			EndDo;
			
			If Goods.Count() > 0 Then
				GoodsIssueNote.Fill(Undefined);
				GoodsIssueNote.Write(DocumentWriteMode.Posting);
				
				ExecutedOrdersLine = ExecutedOrders.Add();
				FillPropertyValues(ExecutedOrdersLine, GoodsIssueNote);
				
				ExecutedOrdersLine.ExpenseOrder = Selection.Ref;
				ExecutedOrdersLine.Action = "Reregister";
			Else
				Result = Common.RefsToObjectFound(Selection.Ref);
				GoodsIssueNote = Selection.Ref.GetObject();
				
				If Result Then
					GoodsIssueNote.SetDeletionMark(True);
				Else
					GoodsIssueNote.Delete();
				EndIf;
				
				ExecutedOrdersLine = ExecutedOrders.Add();
				FillPropertyValues(ExecutedOrdersLine, GoodsIssueNote);
				
				ExecutedOrdersLine.ExpenseOrder = Selection.Ref;
				ExecutedOrdersLine.Action = "Removed";
			EndIf;
			
			OrderRecorded = True;
			
			CommitTransaction();
		Except
			RollbackTransaction();
			
			WriteLogEvent(
				NStr("ru = 'Переоформление подготовленных расходных ордеров';
					|vi = 'Reregister the prepared goods issues';
					|en = 'Reregister the prepared goods issues'; fa = 'Reregister the prepared goods issues';
					|it = 'Reregister the prepared goods issues';
					|pl = 'Reregister the prepared goods issues';
					|tr = 'Hazırlanan ambar çıkış fişlerinin yeniden düzenlenmesi'"),
				EventLogLevel.Error,
				,
				,
				ErrorProcessing.DetailErrorDescription(ErrorInfo()));
			
			Raise;
		EndTry;
		
	EndDo;
	
EndProcedure

