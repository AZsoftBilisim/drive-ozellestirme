// Gets the warehouses available to the employee for work. 
//
// Parameters:
//  Employee	 - 	CatalogRef.Persons - the employee for whom you need to get warehouses.
//  EmployeeType	 - 	String - name of the employee type from the list (courier, collector, dispatcher).
// 
// Returns:
//  Array - an array of links to warehouses.
//
Function AvailableEmployeeWarehousesByEmployeeType(Employee, EmployeeType) Export
	
	Query = New Query();
	Query.Text = "SELECT ALLOWED
	               |	StoreEmployees.Warehouse AS Warehouse
	               |FROM
	               |	InformationRegister.StoreEmployees AS StoreEmployees
	               |		LEFT JOIN Catalog.Warehouses AS Warehouses
	               |		ON StoreEmployees.Warehouse = Warehouses.Ref
	               |		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(&Date, ) AS HistoryOfChange
	               |		ON (HistoryOfChange.Warehouse = Warehouses.Ref)
	               |WHERE
	               |	(Warehouses.UseWarehouseManagemantSystemForGoodsIssue = FALSE
	               |				AND CASE
	               |					WHEN ISNULL(HistoryOfChange.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)) = VALUE(Catalog.StoreFormats.EmptyRef)
	               |						THEN Warehouses.StoreSupportsDeliveryByOwnCouriers
	               |								AND Warehouses.StartDateOfDeliveryByOwnCouriers <= &Date
	               |					ELSE HistoryOfChange.StoreFormat.StoreSupportsDeliveryByOwnCouriers
	               |				END
	               |				AND Warehouses.IsFolder = FALSE
	               |				AND StoreEmployees.Employee = &Employee
	               |				AND (StoreEmployees.Courier
	               |					AND &ThisIsCourier)
	               |			OR StoreEmployees.Picker
	               |				AND &ThisIsPicker
	               |			OR StoreEmployees.Dispatcher
	               |				AND &ThisIsDispatcher)";
	
	Query.SetParameter("Date", CurrentSessionDate());
	Query.SetParameter("Employee", Employee);
	Query.SetParameter("ThisIsCourier", Lower(EmployeeType) = "courier");
	Query.SetParameter("ThisIsPicker", Lower(EmployeeType) = "picker");
	Query.SetParameter("ThisIsDispatcher", Lower(EmployeeType) = "dispatcher");
	
	Return Query.Execute().Unload().UnloadColumn("Warehouse");
	
EndFunction

