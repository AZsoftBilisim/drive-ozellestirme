#Region WritingToRegisters

// Procedure for generating movements in the "state of cell recalculations" register.
//
// Parameters:
//	Ref - DocumentRef.InventoryRecount - link to the document 
//	Status - EnumRef.InventoryRecountStatuses - document status
//	Cancel - Boolean - indicates that the document was rejected.
//
Procedure ReflectStatesOfCellRecalculations(Ref, Status, Cancel) Export
	
	If Cancel Then
		Return;
	EndIf;
		
	If Not ValueIsFilled(Ref) Then
		Return;
	EndIf;
	
	DocumentPropertyValues = Common.ObjectAttributesValues(Ref, "Warehouse, Premise, Date");
	BinLocationWarehousingIsUsed = WarehousesServer.UseBinLocationWarehousing(
		DocumentPropertyValues.Warehouse, DocumentPropertyValues.Premise, DocumentPropertyValues.Date);
	If Not BinLocationWarehousingIsUsed Then
		Return;
	EndIf;

	TableOfCellRecalculationStates = New ValueTable;
		
	ObjectManager 				= Common.ObjectManagerByRef(Ref);
	TableOfCellRecalculationStates = ObjectManager.TableOfCellRecalculationStates(Ref, Status);
	
	Block = New DataLock;
	LockItem = Block.Add("InformationRegister.BinRecountStates");
	LockItem.DataSource = TableOfCellRecalculationStates;
	LockItem.UseFromDataSource("Cell", "Cell");
	Block.Lock();

	For Each TableRow In TableOfCellRecalculationStates Do

		Set = InformationRegisters.BinRecountStates.CreateRecordSet();
		Set.Filter.Cell.Set(TableRow.Cell);
		Set.Read();
		
		If Set.Count() > 0 Then
			SetRow = Set[0];
		Else
			SetRow = Set.Add();
			SetRow.Cell = TableRow.Cell;
		EndIf;
		
		NeedToWrite = False;
		
		// Recalculation is required and no later recalculations have been carried out in the cell 
		If TableRow.State = Enums.BinRecountStates.RecountIsRequired
			And SetRow.LastRecalculationDate <= TableRow.DocumentDate Then
			
			SetRow.State = Enums.BinRecountStates.RecountIsRequired;
			
			NeedToWrite = True;
			
		// The recalculation has been performed and no later recalculations have been carried out in the cell
		ElsIf TableRow.State = Enums.BinRecountStates.RecalculationIsCompleted
			And SetRow.LastRecalculationDate <= TableRow.DocumentDate Then
			
			SetRow.LastRecalculationDate = TableRow.DocumentDate;
			SetRow.State = Enums.BinRecountStates.RecalculationIsCompleted;
			
			NeedToWrite = True;
			
		EndIf;
		
		If NeedToWrite Then
			Set.Write(True);	
		EndIf;
		
	EndDo;
	
EndProcedure

#EndRegion

// Constructor of additional parameters of the modular drawing methods.
// 
// Returns:
// 	Structure - Structure of filling parameters:
// 		* TSSeriesName - String - name of the PM Series of the current document (if any).
// 		* SynonymForDocumentTable - String - Synonym of the main table in the text of the document query, if different from
//												the default value.
// 		* AdditionalSeriesConnectionFields - Array of String - an array of additional Attributes that are 
//												available in both TS Goods and TS Series.
// 		* RedefinedSeriesConnectionFields - Map of KeyAndValue - list of Attributes of the goods tabular part to be redefined and their aliases in the data source request:
// 			** Key - String - the name of the Attribute of the goods tabular part that is being redefined, for example, the item;
// 			** Value - String - The alias of the Attribute in the data source of the modular execution request, for example, the nomenclature for the connection.
// 		* SubstitutionOfSeriesFields - Map of KeyAndValue - list of redefined fields in the table part of the query series and substitution values:
// 			** Key - String - The name of the field to be redefined in the table part of the query series, which must have an alias for the data source - Data series, for example, Data series.Quantity;
// 			** Value - String - the value of substitution, for example, given series.The quantities of the document are the series data.Quantity.
// 		* MetadataObject				- MetadataObject, Undefined	- the metadata object of the registrar document.
// 										It is filled in if the document includes a tabular part that stores information about the series of goods.
// 		* SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt - Boolean - informs the operation that it is necessary to use
// 																previously defined, special selections by order.
// 		* SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages - Boolean - informs the operation that it is necessary to use
// 																previously defined, special selections by order.
// 		* ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder - Boolean - notifies the operation that
// 											movement is allowed with the indication of the series according to the resource of the co-formation of the waybill.
// 		* ServicesAndWorksAreCountedInRegisteredRecords - Boolean - Take into account the works and services in the dmizhenii register of goods to access
// 		* ThisIsDiscrepancyReport - Boolean - informs the operation that it is necessary to use previously defined, special 
// 																selections based on the use of the discrepancy report.
//
Function ParametersOfModularHolding() Export
	
	Structure = New Structure();
	
	Structure.Insert("TSSeriesName", "");
	Structure.Insert("SynonymForDocumentTable", "DataSource");
	Structure.Insert("AdditionalSeriesConnectionFields", New Array);
	Structure.Insert("RedefinedSeriesConnectionFields", New Map);
	Structure.Insert("SubstitutionOfSeriesFields", New Map);
	Structure.Insert("MetadataObject", Undefined);
	
	Structure.Insert("SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt", False);
	Structure.Insert("SelectionIsRequiredAccordingToOrderOfWarehouseToReflectSurplusShortages", False);
	Structure.Insert("ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder", False);
	Structure.Insert("ServicesAndWorksAreCountedInRegisteredRecords", False);
	
	Structure.Insert("ThisIsDiscrepancyReport", False);
	Structure.Insert("ThisIsReceiptOfServicesToUnit", False);
	
	Return Structure;
	
EndFunction

