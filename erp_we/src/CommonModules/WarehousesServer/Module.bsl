//		* DocumentStatus - EnumRef.GoodsIssueNoteStatuses, EnumRef.TransferNoteStatuses - 
//				passed if Status change = True is the Status of the document to be set.
//
Function ParametersForFillingOrdersWithSelectedGoods() Export
	
	Structure = New Structure;
	Structure.Insert("FillMode");
	Structure.Insert("DocumentsArray");
	Structure.Insert("DocumentObject");
