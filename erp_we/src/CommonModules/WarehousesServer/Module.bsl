#Region FillingWarehousesInTabularPartsOfDocuments

// Fills in warehouses in the tabular part of the document.
//
// Parameters:
//	Warehouse - CatalogRef.Warehouses - The warehouse selected in the header of the document;
//	WarehouseGroup_ - Boolean - Flag that can be used to determine that the warehouse group is selected in the document header;
//	Goods - DocumentTabularSection.PurchaseOrder.Goods - Item table of the document;
//	ExcludeGroupsAvailableInOrders - Boolean - True - indicates that the group of warehouses available in orders is excluded;
//	ChargeToExpensesField - String - a field with the "charge to expenses" attribute.
//
Procedure FillInWarehousesInTablePart(Val Warehouse, Val WarehouseGroup_, Goods, ExcludeGroupsAvailableInOrders, ChargeToExpensesField = "") Export
	
	If WarehouseGroup_ Then
		
		WarehouseArray = New Array();
		
		For Each CurRow In Goods Do
			
			If ValueIsFilled(CurRow.Warehouse)
				And WarehouseArray.Find(CurRow.Warehouse) = Undefined Then
				WarehouseArray.Add(CurRow.Warehouse);
			EndIf;
			
		EndDo;
		
		If WarehouseArray.Count() > 0 Then
			
			Query = New Query("
				|SELECT ALLOWED
				|	Warehouses.Ref AS Warehouse
				|FROM
				|	Catalog.Warehouses AS Warehouses
				|WHERE
				|	Warehouses.Ref IN (&Warehouses)
				|	AND ((Warehouses.Ref NOT IN HIERARCHY (&Warehouse))
				|	OR Warehouses.SelectGroup NOT IN (&SelectWarehouseGroup))
				|");
			
			Query.SetParameter("Warehouses", WarehouseArray);
			Query.SetParameter("Warehouse",  Warehouse);
			
			SelectWarehouseGroup = New Array();
			SelectWarehouseGroup.Add(Enums.SelectWarehouseGroup.AllowInOrdersAndInvoices);
			If Not ExcludeGroupsAvailableInOrders Then
				SelectWarehouseGroup.Add(Enums.SelectWarehouseGroup.AllowInOrders);
			EndIf;
			Query.SetParameter("SelectWarehouseGroup", SelectWarehouseGroup);
			QueryResult = Query.Execute();
			
			If QueryResult.IsEmpty() Then
				Return;
			EndIf;
			
			Selection = QueryResult.Select();
			
			For Each CurRow In Goods Do
				If ValueIsFilled(CurRow.Warehouse) Then
					If Selection.FindNext(CurRow.Warehouse, "Warehouse") Then
						CurRow.Warehouse = Catalogs.Warehouses.EmptyRef();
					EndIf;
					Selection.Reset();
				EndIf;
			EndDo;
			
		EndIf;
		
	Else
		
		ArrayOfProducts_2 = New Array();
		
		For Each CurRow In Goods Do
			
			If ValueIsFilled(CurRow.Products)
				And ArrayOfProducts_2.Find(CurRow.Products) = Undefined Then
				ArrayOfProducts_2.Add(CurRow.Products);
			EndIf;
			
		EndDo;
		
		Query = New Query("
			|SELECT ALLOWED
			|	Products.Ref AS Products
			|FROM
			|	Catalog.Products AS Products
			|WHERE
			|	Products.Ref IN (&Goods)
			|	AND Products.ItemsType NOT IN (VALUE(Enum.ItemsTypes.OwnGoods),VALUE(Enum.ItemsTypes.ReusablePackage))
			|");
			
		Query.SetParameter("Goods", ArrayOfProducts_2);
		Selection = Query.Execute().Select();
		
		For Each CurRow In Goods Do
			
			Selection.Reset();
			If Selection.FindNext(CurRow.Products, "Products") Then
				Continue;
			EndIf;
			
			If ChargeToExpensesField <> ""
				And CurRow[ChargeToExpensesField] = True Then
				Continue;
			EndIf;
			
			If CurRow.Warehouse <> Warehouse Then
				CurRow.Warehouse = Warehouse;
			EndIf;
			
		EndDo;
		
	EndIf;
	
EndProcedure

// The function fills in the "Warehouse" details in the selected rows of the table part
// The warehouse details must be filled in only in lines with the item type " Enumeration.Types of nomenclature.Product".
//
// Parameters:
// 		TabularSection - FormDataCollection - Table part of the form for filling in the goods details
// 		SelectedRows - Array - Array of selected rows in the table part
// 		FillingWarehouse - CatalogRef.Warehouses - Warehouse for filling in the "Warehouse" details of the table part
// 		CheckLineCode - Boolean - Flag need to check the line code
// 		WriteOffColumnForExpenses - String - column of the "Charge to expenses" attribute.
//
// Returns:
// 		Number - The number of filled lines.
//
Function FillInWarehousesInSelectedLines(TabularSection, SelectedRows, FillingWarehouse, CheckLineCode = False, WriteOffColumnForExpenses = "") Export
	
	FilledRows = 0;
	
	For Each CurRow In SelectedRows Do
		
		TableRow = TabularSection.FindByID(CurRow);
		
		If (CheckLineCode And ValueIsFilled(TableRow.RowCode))
			Or (WriteOffColumnForExpenses <> "" And TableRow[WriteOffColumnForExpenses]) Then
			Continue;
		EndIf;
		
		If TableRow.ItemsType = Enums.ItemsTypes.OwnGoods
			Or TableRow.ItemsType =  Enums.ItemsTypes.ReusablePackage Then
			
			TableRow.Warehouse = FillingWarehouse;
			FilledRows = FilledRows + 1;
			
		EndIf;
		
	EndDo;
	
	Return FilledRows;
	
EndFunction

// Fills in the form's service details with data about the number of warehouses used in the table part of the document.
//
//  Parameters:
//   TabPart - FormDataCollection - table with the "warehouse" and "Canceled" columns (optional).
//   TableWarehouses_ - FormDataCollection - service details of the form to fill in.
//   WarehouseGroup_ - Boolean - indicates whether different warehouses are used in the document.
//   ThereIsCancellationOfLines - Boolean - True if the tab Part contains the "Canceled" column.
//
Procedure WhenChangingWarehouseInTablePart(TabPart, TableWarehouses_, WarehouseGroup_, ThereIsCancellationOfLines = True) Export
	
	TableWarehouses_.Clear();
	
	If Not WarehouseGroup_ Then
		Return;
	EndIf;
	
	Warehouses = New Map();
	
	For Each TabSectionRow In TabPart Do
		
		If ValueIsFilled(TabSectionRow.Warehouse) And (Not ThereIsCancellationOfLines Or Not TabSectionRow.Canceled) Then
			
			NumberOfWarehouses = Warehouses.Get(TabSectionRow.Warehouse);
			
			If NumberOfWarehouses = Undefined Then
				NumberOfWarehouses = 0;
			EndIf;
			
			Warehouses.Insert(TabSectionRow.Warehouse, NumberOfWarehouses + 1);
			
		EndIf;
		
	EndDo;
	
	For Each Item In Warehouses Do
		
		NewRow = TableWarehouses_.Add();
		NewRow.Warehouse = Item.Key;
		NewRow.RowsCount = Item.Value;
		
	EndDo;
	
EndProcedure

