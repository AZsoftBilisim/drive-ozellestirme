#Region Recharge

// This function starts feeding quick selection zones by "Warehouse"and " Room".
//
// Parameters:
// 		Warehouse - CatalogRef.Warehouses - The warehouse where the recharge will be performed
// 		Premise - CatalogRef.Warerooms - The room where the recharge will be performed
// 		TaskGenerationParameters - Structure - parameters that will be used to split repackaging tasks.
//
// Returns:
// 		String - error message.
//
Function PerformZboRechargeOnServer(Warehouse, Premise, TaskGenerationParameters) Export
	
	TempTablesManager = New TempTablesManager;
	
	// Checking blocked data
	If Not TaskGenerationParameters.Property("BySelectionOrders") Then
		
		AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
		AdditionalParameters.TempTableName = "TTBlockedGoodsForShipment";
		
		TempTableManager = New TempTablesManager;
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(Undefined,
			"AccumulationRegister.GoodsForIssue", "Warehouse", TempTableManager, AdditionalParameters);
		
		AdditionalParameters.TempTableName = "TTBlockedGoodsInWarehouses";
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(Undefined,
			"AccumulationRegister.ProductStock", "Warehouse", TempTableManager, AdditionalParameters);
			
		Query = New Query;
		Query.TempTablesManager = TempTableManager;
		Query.Text = 
		"SELECT
		|	TTBlockedGoodsForShipment.Warehouse
		|FROM
		|	TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment
		|WHERE
		|	TTBlockedGoodsForShipment.Warehouse = &Warehouse
		|
		|UNION ALL
		|
		|SELECT
		|	TTBlockedGoodsInWarehouses.Warehouse
		|FROM
		|	TTBlockedGoodsInWarehouses AS TTBlockedGoodsInWarehouses
		|WHERE
		|	TTBlockedGoodsInWarehouses.Warehouse = &Warehouse";
		Query.SetParameter("Warehouse", Warehouse);
		If Not Query.Execute().IsEmpty() Then
			Return "";
		EndIf;
		
	EndIf;
		
	CreateTableOfPackagesByCurOrders(Warehouse, Premise, TempTablesManager, TaskGenerationParameters);
	
	ThereIsNeedForPackages = GenerateTableOfPackagingNeeds(Warehouse, Premise, TempTablesManager, TaskGenerationParameters); 	
		
	If ThereIsNeedForPackages Then
		
		TablesForTasks = CreateTablesForTasks(Warehouse,Premise, TempTablesManager);
		
		If TablesForTasks <> Undefined Then
			SplitByTasks(Warehouse, Premise, TablesForTasks, TaskGenerationParameters);
			Return "";
		Else
			MessageText = NStr("vi = 'Chưa tạo nhiệm vụ (có thể là đối với bộ đóng gói chưa tùy chỉnh quy tắc đóng gói lại hoặc quy tắc sắp xếp).';
								|ru = 'Задания не сформированы (возможно для упаковок не настроены правила переупаковки или правила размещения).';
								|en = 'Jobs are not generated (repackaging or put-away rules might not be configured for packaging units).'; fa = 'Jobs are not generated (repackaging or put-away rules might not be configured for packaging units).';
								|it = 'Task non generati (è possibile che le regole di reimballaggio o le regole di posizionamento non siano configurate per imballaggi).';
								|pl = 'Zadania nie są formowane (możliwe, że reguły przepakowywania lub reguły umieszczania nie są skonfigurowane dla pakietów).';
								|tr = 'Görevler oluşturulmadı (belki de paketleme üniteleri için yeniden paketleme kuralları veya yerleştirme kuralları ayarlanmadı).'");
			Return MessageText;
		EndIf;
	Else
		MessageText = NStr("vi = 'Chưa tạo nhiệm vụ (có thể là trong ô cất giữ không đủ hàng để giao hoặc không cần tiếp nhận thêm).';
							|ru = 'Задания не сформированы (возможно в ячейках хранения не достаточно товаров для отгрузки или подпитка не требуется).';
							|en = 'Jobs are not generated (products for shipment might be not enough in storage bins, or replenishment is not required).'; fa = 'Jobs are not generated (products for shipment might be not enough in storage bins, or replenishment is not required).';
							|it = 'Task non generati (probabilmente non ci sono abbastanza merci nelle celle di stoccaggio per la spedizione o l''approvvigionamento non è richiesto).';
							|pl = 'Zadania nie są formowane (możliwe, że w komórkach magazynowych nie ma wystarczającej ilości towarów do wysyłki lub nie jest wymagane ponowne ładowanie).';
							|tr = 'Görevler oluşturulmadı (belki de depolama hücrelerinde sevkiyat için yeterli ürün yoktur veya stok yenileme gerekli değildir).'");
		Return MessageText;
	EndIf;
	
EndFunction

// The function generates a query based on a temporary table.
//
// Parameters:
//	TempTablesManager - TempTablesManager - temporary query table Manager;
//	TempTableName - String - name of the temporary table.
//
//
// Returns:
//	ValueTable - the result of selecting a temporary table from the temporary table manager.
Function ShowTemporaryTable(TempTablesManager,TempTableName) Export

	QueryText = "
	|SELECT
	|	*
	|FROM
	|	TempTableName
	|";
	
	Query = New Query;
	Query.Text = StrReplace(QueryText, "TempTableName", TempTableName);
	Query.TempTablesManager = TempTablesManager;
	
	Return Query.Execute().Unload();
	
EndFunction 

// Method of routine assignment of calculation of indicators for predicting the consumption of Packages.
// Calculates a forecast for the consumption of packages, which is then used for pre-emptive recharge.
//
// Parameters:
//	Warehouse - CatalogRef.Warehouses - warehouse for which the forecast of package consumption is calculated;
//	Premise - CatalogRef.Warerooms - the storage area for which the forecast is calculated.
//
Procedure ForecastOfConsumptionOfPackages(Warehouse, Premise) Export
	
	Common.OnStartExecuteScheduledJob(Metadata.ScheduledJobs.CalculationOfPackageConsumptionForecast);
	
	If IsBlankString(UserName()) Then
		SetPrivilegedMode(True);
	EndIf;
	
	If Not ValueIsFilled(Warehouse)
	 Or (UseWarerooms(Warehouse)	And Not ValueIsFilled(Premise)) Then
		Return;
	EndIf;
	
	LogParameters = New Structure("EventGroup_, Metadata, Data");
	LogParameters.EventGroup_ = NStr("vi = 'Tính toán chỉ tiêu dự báo chi phí đóng gói (khởi động theo lịch biểu)';
									|ru = 'Расчет показателей прогноза расхода упаковок (запуск по расписанию)';
									|en = 'Calculation of packaging units consumption forecast indicators (start on schedule)'; fa = 'Calculation of packaging units consumption forecast indicators (start on schedule)';
									|it = 'Calcolo degli indici di previsione del consumo di imballaggi (avvio in base alla pianificazione)';
									|pl = 'Obliczanie wskaźników prognozowanego rozchodu pakietów (uruchamianie według harmonogramu)';
									|tr = 'Paketleme üniteleri gider tahmin göstergelerinin hesaplanması (programa göre başlatma)'");
	If UseWarerooms(Warehouse) Then
		LogParameters.Metadata    = Premise.Metadata();
		LogParameters.Data        = Premise;
	Else
		LogParameters.Metadata    = Warehouse.Metadata();
		LogParameters.Data        = Warehouse;
	EndIf;
	
	TMCommonUse.LogReportToUser(
		LogParameters,
		EventLogLevel.Note,
		NStr("vi = 'Khởi động';
			|ru = 'Запуск';
			|en = 'Start'; fa = 'شروع';
			|it = 'Avvio';
			|pl = 'Start';
			|tr = 'Başlangıc'"));
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	SettingsOfBinLocationWarehouses.Warehouse,
	|	SettingsOfBinLocationWarehouses.Premise,
	|	SettingsOfBinLocationWarehouses.AnalysisDepth,
	|	SettingsOfBinLocationWarehouses.MinimumProbabilityOfShipment,
	|	SettingsOfBinLocationWarehouses.ServiceLevelOfClassXPackages,
	|	SettingsOfBinLocationWarehouses.ServiceLevelOfClassYPackages,
	|	SettingsOfBinLocationWarehouses.ServiceLevelOfClassZPackages,
	|	SettingsOfBinLocationWarehouses.ForecastPackageConsumption
	|FROM
	|	InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOfBinLocationWarehouses
	|WHERE
	|	SettingsOfBinLocationWarehouses.Warehouse = &Warehouse
	|	AND SettingsOfBinLocationWarehouses.Premise = &Premise";
	
	Query.SetParameter("Warehouse",     Warehouse);
	Query.SetParameter("Premise", Premise);
	
	RechargeSettings = Query.Execute().Select();
	
	If Not RechargeSettings.Next()
	 Or Not RechargeSettings.ForecastPackageConsumption Then
		TMCommonUse.LogReportToUser(
			LogParameters,
			EventLogLevel.Warning,
			NStr("vi = 'Kết thúc';
				|ru = 'Завершение';
				|en = 'End'; fa = 'پایان';
				|it = 'Completamento';
				|pl = 'End';
				|tr = 'Tamamlama'"),
			NStr("vi = 'Chưa xác định các tùy chỉnh dự báo xuất đóng gói.';
				|ru = 'Не заданы настройки прогноза расхода упаковок.';
				|en = 'Packaging units consumption forecast is not set up.'; fa = 'Packaging units consumption forecast is not set up.';
				|it = 'Le impostazioni per la previsione del consumo di imballaggi non sono specificate.';
				|pl = 'Ustawienia prognozy rozchodu pakietu nie zostały określone.';
				|tr = 'Paketleme üniteleri gider tahmin ayarları belirlenmedi.'"));
		Return;
	EndIf;
	
	Try
		PerformCalculationOfIndicatorsForForecastAndClassificationOfPackages(RechargeSettings);
	Except
		TMCommonUse.LogReportToUser(
			LogParameters,
			EventLogLevel.Error,
			NStr("vi = 'Kết thúc';
				|ru = 'Завершение';
				|en = 'End'; fa = 'پایان';
				|it = 'Completamento';
				|pl = 'End';
				|tr = 'Tamamlama'"),
			NStr("vi = 'Lỗi tính toán chỉ tiêu dự báo.';
				|ru = 'Ошибка расчета показателей прогноза.';
				|en = 'An error occurred while calculating forecast indicators.'; fa = 'An error occurred while calculating forecast indicators.';
				|it = 'Errore nel calcolo degli indici di previsione.';
				|pl = 'Błąd obliczania wskaźników prognozy.';
				|tr = 'Tahmin göstergelerinin hesaplanmasında hata.'"),
			ErrorInfo());
		Return;
	EndTry;
	
	TMCommonUse.LogReportToUser(
		LogParameters,
		EventLogLevel.Note,
		NStr("vi = 'Kết thúc';
			|ru = 'Завершение';
			|en = 'End'; fa = 'پایان';
			|it = 'Completamento';
			|pl = 'End';
			|tr = 'Tamamlama'"),
		NStr("vi = 'Đã cập nhật các chỉ tiêu dự báo xuất đóng gói.';
			|ru = 'Показатели прогноза расхода упаковок обновлены.';
			|en = 'Indicators of packaging units consumption forecast are updated.'; fa = 'Indicators of packaging units consumption forecast are updated.';
			|it = 'Gli Indici di previsione del consumo di imballaggi sono aggiornati.';
			|pl = 'Zaktualizowano wskaźniki prognozy rozchodu pakietów.';
			|tr = 'Paketleme üniteleri tüketiminin tahminine yönelik göstergeler güncellendi.'"));
	
EndProcedure

