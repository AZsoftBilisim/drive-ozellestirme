// Returns a collection of all possible empty links of the defined type of sender and receiver of goods.
//
// Returns:
//	Array of AnyRef - a collection of all possible empty links of the defined type of sender and receiver of goods.
//
Function EmptyReceiverSender() Export 
	
	ArrayOfEmptyValues_ = New Array;
	
	For Each TypeRecipientSender In Metadata.DefinedTypes.SenderRecipientOfGoods.Type.Types() Do
		DocumentRef = New (TypeRecipientSender);
		ArrayOfEmptyValues_.Add(DocumentRef);		
	EndDo;
	
	ArrayOfEmptyValues_.Add(Undefined);
	
	Return ArrayOfEmptyValues_;
	
EndFunction

