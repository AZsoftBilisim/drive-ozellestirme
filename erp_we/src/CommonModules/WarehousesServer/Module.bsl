#Region ProceduresAndFunctionsOfFillingOutDocuments

Procedure CompleteReFillingWithSelectedProducts(ObjectToProcess,
													 FillParameters,
													 ArrayOfChangedDocuments)
																
	If TypeOf(ObjectToProcess.Ref) = Type("DocumentRef.GoodsIssueNote") Then
		
		If FillParameters.StatusChange Then
			ObjectToProcess.Status = PredefinedValue("Enum.GoodsIssueNoteStatuses." + FillParameters.DocumentStatus);
			Documents.GoodsIssueNote.FillInActionInLines(ObjectToProcess);
		EndIf;
		
		ObjectToProcess.TotalNumberOfPackageItems = PackingListsServer.NumberOfSeatsWH(ObjectToProcess.ShippedGoods);
		
		SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(ObjectToProcess, Documents.GoodsIssueNote);
		ProductsServer.FillInStatusesForSpecifyingSeries(ObjectToProcess,SeriesSpecificationParameters.ShippedGoods);
		
		ProductsServer.FillInActionOnCompletenessOfProductPlaces(ObjectToProcess);
		
		Documents.GoodsIssueNote.ChangeGoodsAccordingToOrdersForShippedGoods(ObjectToProcess, False, True);
		ProductsServer.FillInStatusesForSpecifyingSeries(ObjectToProcess,SeriesSpecificationParameters.GoodsByReferences);

	Else
		
		If FillParameters.StatusChange Then
			ObjectToProcess.Status = PredefinedValue("Enum.TransferNoteStatuses." + FillParameters.DocumentStatus); 
			Documents.GoodsTransferNote.FillInActionInLines(ObjectToProcess);
		EndIf;
		
		SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(ObjectToProcess, Documents.GoodsTransferNote);
		ProductsServer.FillInStatusesForSpecifyingSeries(ObjectToProcess,SeriesSpecificationParameters);
		
		ProductsServer.FillInActionOnCompletenessOfProductPlaces(ObjectToProcess);

	EndIf;
	
	If FillParameters.FillMode = "Plural_" Then
		If ObjectToProcess.CheckFilling() Then
			Try
				ObjectToProcess.Write(DocumentWriteMode.Posting);
				ArrayOfChangedDocuments.Add(ObjectToProcess.Ref);
			Except
				CommonClientServer.MessageToUser(BriefErrorDescription(ErrorInfo()));
			EndTry;
		EndIf;
	Else
		ArrayOfChangedDocuments.Add(ObjectToProcess.Ref);
	EndIf;

EndProcedure

