Procedure SubtractTableFromTree(Tree, DeductibleTables, StartShipmentOnceDeliveryOrderIsCreated)
	
	FilterAttributes						= "Warehouse, Recipient, DocumentShipments, Products, Characteristic,
											|Purpose, ControlledLotReference, Series";
	AttributesOfSelectionByPeriod			= FilterAttributes + ", ShipmentPeriod";
	AttributesOfSelectionWithTask			= FilterAttributes + ", TransportationJob";
	AttributesOfSelectionForPeriodWithTask	= AttributesOfSelectionByPeriod + ", TransportationJob";
	
	Filter					= New Structure(FilterAttributes);
	FilterByPeriod			= New Structure(AttributesOfSelectionByPeriod);
	SelectionWithTask			= New Structure(AttributesOfSelectionWithTask);
	SelectionByPeriodWithTask	= New Structure(AttributesOfSelectionForPeriodWithTask);
	
	For Each TransportTaskLevel In Tree.Rows Do
		For Each ShippingDocumentLevel In TransportTaskLevel.Rows Do
			For Each LevelProducts In ShippingDocumentLevel.Rows Do
				For Each LevelCharacteristics In LevelProducts.Rows  Do
					For Each LevelAssignment In LevelCharacteristics.Rows Do
						For Each LevelControlledLotReference In LevelAssignment.Rows Do
							For Each LevelSeries In LevelControlledLotReference.Rows Do
								
								GoodsTable = LevelSeries.Rows;
								
								If Not StartShipmentOnceDeliveryOrderIsCreated
									Or (GoodsDeliveryClientServer.UsedDelivery20()
										And Not ValueIsFilled(TransportTaskLevel.TransportationJob)) Then
									
									MainFilter		= FilterByPeriod;
									AdditionalSelection	= Filter;
									
								Else
									MainFilter		= SelectionByPeriodWithTask;
									AdditionalSelection	= SelectionWithTask;
								EndIf;
								
								FillPropertyValues(AdditionalSelection, GoodsTable[0]);
								
								For Each SubtractionTable In DeductibleTables Do
									DistributeGoodsByPeriod(GoodsTable, SubtractionTable, MainFilter);
									
									NumbrOfRows = GoodsTable.Count();
									
									If NumbrOfRows = 0 Then
										Break;
									ElsIf NumbrOfRows = 1 Then
										DistributeGoodsFromTopToBottom(GoodsTable, SubtractionTable, AdditionalSelection);
									Else
										DistributeGoodsFromBottomToTop(GoodsTable, SubtractionTable, AdditionalSelection);
									EndIf;
								EndDo
								
							EndDo;
						EndDo;
					EndDo;
				EndDo;
			EndDo;
		EndDo;
	EndDo;
	
EndProcedure

Procedure DistributeGoodsByPeriod(GoodsTable, SubtractedTable, TheStructureOfTheSearch)
	
	TableRowsToDelete				= New Array;
	RowsOfSubtractedTableToDelete	= New Array;
	
	For Each LineProducts_ In GoodsTable Do
		RowsOfSubtractedTableToDelete.Clear();
		
		If LineProducts_.Count > 0 Then
			FillPropertyValues(TheStructureOfTheSearch, LineProducts_);
			TheStructureOfTheSearch.ShipmentPeriod = LineProducts_.Period;
			
			RowsArray = SubtractedTable.FindRows(TheStructureOfTheSearch);
			
			For Each SubtractedString In RowsArray Do 
				SubtractLines(LineProducts_, SubtractedString, RowsOfSubtractedTableToDelete);
			EndDo;
		EndIf;
		
		If LineProducts_.Count = 0 Then
			TableRowsToDelete.Add(LineProducts_);
		EndIf;
		
		RemovingEmptyRowsFromTable(SubtractedTable, RowsOfSubtractedTableToDelete);
	EndDo;
	
	RemovingEmptyRowsFromTable(GoodsTable, TableRowsToDelete);
	
EndProcedure

Procedure DistributeGoodsFromTopToBottom(GoodsTable, SubtractedTable, TheStructureOfTheSearch)
	
	TableIndex	= GoodsTable.Count() - 1;
	RowsArray		= SubtractedTable.FindRows(TheStructureOfTheSearch);
	
	TableRowsToDelete				= New Array;
	RowsOfSubtractedTableToDelete	= New Array;
	
	While TableIndex >= 0 Do
		RowsOfSubtractedTableToDelete.Clear();
		
		IndexOf			= RowsArray.UBound();
		RowOfProduct	= GoodsTable[TableIndex];
		
		While IndexOf >= 0
			And RowOfProduct.Count > 0 Do
			
			SubtractLines(RowOfProduct, RowsArray[IndexOf], RowsOfSubtractedTableToDelete);
			
			IndexOf = IndexOf - 1;
			
		EndDo;
		
		If RowOfProduct.Count = 0 Then
			TableRowsToDelete.Add(RowOfProduct);
		EndIf;
		
		// Deleting distributed rows.
		For Each RowToDelete In RowsOfSubtractedTableToDelete Do
			RowsArray.Delete(RowsArray.Find(RowToDelete));
			SubtractedTable.Delete(RowToDelete);
		EndDo;
		
		TableIndex = TableIndex - 1;
	EndDo;
	
	RemovingEmptyRowsFromTable(GoodsTable, TableRowsToDelete);
	
EndProcedure

Procedure DistributeGoodsFromBottomToTop(GoodsTable, SubtractedTable, TheStructureOfTheSearch)
	
	TableIndex	= 0;
	RowsArray		= SubtractedTable.FindRows(TheStructureOfTheSearch);
	
	TableRowsToDelete				= New Array;
	RowsOfSubtractedTableToDelete	= New Array;
	
	TableRowsCount = GoodsTable.Count();
	
	While TableIndex < TableRowsCount Do 
		RowsOfSubtractedTableToDelete.Clear();
		
		IndexOf			= 0;
		RowOfProduct	= GoodsTable[TableIndex];
		RowsCount	= RowsArray.Count();
		
		While IndexOf < RowsCount
			And RowOfProduct.Count > 0  Do
			
			SubtractLines(RowOfProduct, RowsArray[IndexOf], RowsOfSubtractedTableToDelete);
			
			IndexOf = IndexOf + 1;
			
		EndDo;
		
		If RowOfProduct.Count = 0 Then
			TableRowsToDelete.Add(RowOfProduct);
		EndIf;
		
		// Deleting distributed rows.
		For Each RowToDelete In RowsOfSubtractedTableToDelete Do
			RowsArray.Delete(RowsArray.Find(RowToDelete));
			SubtractedTable.Delete(RowToDelete);
		EndDo;
		
		TableIndex = TableIndex + 1;
	EndDo;
	
	RemovingEmptyRowsFromTable(GoodsTable, TableRowsToDelete);
	
EndProcedure

Procedure SubtractLines(RowOfProduct, SubtractedString, RowsOfSubtractedTableToDelete)
	
	QuantityDistributed = Min(RowOfProduct.Count, SubtractedString.Count);
	
	RowOfProduct.Count		= RowOfProduct.Count - QuantityDistributed;
	SubtractedString.Count	= SubtractedString.Count - QuantityDistributed;
	
	// These lines are distributed - we will delete them later.
	If SubtractedString.Count = 0 Then
		RowsOfSubtractedTableToDelete.Add(SubtractedString);
	EndIf;
	
EndProcedure

Procedure RemovingEmptyRowsFromTable(Table, LinesToDelete)
	
	For Each RowToDelete In LinesToDelete Do
		Table.Delete(RowToDelete);
	EndDo;
	
EndProcedure

Function GetOrderObject(SpendingOrderSearchParameters)
	
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT
	|	DocumentData.Ref			AS Ref,
	|	DocumentData.DataVersion	AS DataVersion
	|FROM
	|	Document.GoodsIssueNote.GoodsByReferences AS OrdersOfGoods
	|		INNER JOIN Document.GoodsIssueNote AS DocumentData
	|		ON OrdersOfGoods.Ref = DocumentData.Ref
	|
	|WHERE
	|	DocumentData.Posted
	|	AND DocumentData.Warehouse = &Warehouse
	|	AND DocumentData.Premise = &Premise
	|	AND &SelectionConditionByShipmentDate
	|	AND DocumentData.WarehouseOperation = &WarehouseOperation
	|	AND DocumentData.Status = VALUE(Enum.GoodsIssueNoteStatuses.Prepared)
	|	AND (DocumentData.Recipient = &Recipient
	|		OR (DocumentData.Recipient IN (&EmptyRecipient)
	|			AND OrdersOfGoods.ReferenceOrder = &Recipient))
	|	AND (&ForAllShippingZones
	|		OR DocumentData.ShippingZone = &ShippingZone)
	|	AND (&ByAllReferences
	|			OR OrdersOfGoods.ReferenceOrder IN (&ShipmentReferences))
	|	AND (NOT &ShipmentUnderTransportationJob
	|		OR DocumentData.TransportationJob IN (&TransportationJob))
	|	AND (OrdersOfGoods.ReferenceOrder IN (&OrderGrouping)
	|		OR &WithoutGroupingByOrders
	|			AND CASE
	|				WHEN OrdersOfGoods.ReferenceOrder REFS Document.SalesOrder
	|						OR OrdersOfGoods.ReferenceOrder REFS Document.TransferOfGoodsToBailee
	|						OR OrdersOfGoods.ReferenceOrder REFS Document.GoodsShipmentToCustomer
	|						OR OrdersOfGoods.ReferenceOrder REFS Document.CustomerInvoice
	|					THEN NOT ISNULL(OrdersOfGoods.ReferenceOrder.Terms.SplitGoodsIssueNotesByReferences, FALSE)
	|				ELSE TRUE
	|			END)";
	
	For Each KeyAndValue In SpendingOrderSearchParameters Do
		Query.SetParameter(KeyAndValue.Key, KeyAndValue.Value);
	EndDo;
	
	FilterByShipmentDate	= True;
	DateOfShipment		= SpendingOrderSearchParameters.DateOfShipment;
	
	If Not (SpendingOrderSearchParameters.ShipmentUnderTransportationJob
		And TypeOf(SpendingOrderSearchParameters.TransportationJob) = Type("DocumentRef.Trip")) Then
		
		If SpendingOrderSearchParameters.CurrentDate >= SpendingOrderSearchParameters.DateOfShipment Then
			// When combining spending orders on the current date, the shipment date is not updated
			// if the information about the composite product has not changed.
			// Therefore, the search is carried out by orders that are not actualized by the date of shipment.
			FilterByShipmentDate	= False;
			DateOfShipment		= SpendingOrderSearchParameters.CurrentDate;
		EndIf;
		
	EndIf;
	
	TransportationJob = ?(ValueIsFilled(SpendingOrderSearchParameters.TransportationJob),
							SpendingOrderSearchParameters.TransportationJob,
							EmptyItinerary());
	
	Query.SetParameter("DateOfShipment", DateOfShipment);
	Query.SetParameter("TransportationJob", TransportationJob);
	Query.SetParameter("EmptyRecipient", EmptyReceiverSender());
	Query.SetParameter("ByAllReferences",
		SpendingOrderSearchParameters.ShipmentReferences.Count() = 0);
	Query.SetParameter("WithoutGroupingByOrders",
		Not ValueIsFilled(SpendingOrderSearchParameters.OrderGrouping));
	Query.SetParameter("ForAllShippingZones", Not ValueIsFilled(SpendingOrderSearchParameters.ShippingZone));
	
	If Not GoodsDeliveryClientServer.UsedDelivery()
		Or GoodsDeliveryClientServer.UsedDelivery20() Then
		
		Query.SetParameter("ShipmentUnderTransportationJob", SpendingOrderSearchParameters.ShipmentUnderTransportationJob);
		
	Else
		// In delivery 2.5, there may be one order for both delivery and self-pickup.
		// Therefore, the condition in the request should always be superimposed on the parameter TasktraNsPortation
		Query.SetParameter("ShipmentUnderTransportationJob", True);
	EndIf;
	
	SelectionConditionByShipmentDate = ?(FilterByShipmentDate,
									"DocumentData.DateOfShipment = &DateOfShipment",
									"DocumentData.DateOfShipment <= &DateOfShipment");
	
	Query.Text = StrReplace(Query.Text, "&SelectionConditionByShipmentDate", SelectionConditionByShipmentDate);
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		DocumentObject = Selection.Ref.GetObject();
		DocumentObject.Lock();
		
		// Updating the date of shipment in case the product composition did not change when combining orders.
		DocumentObject.DateOfShipment = DateOfShipment;
	Else
		DocumentObject = Documents.GoodsIssueNote.CreateDocument();
		FillOutSpendingOrderForGoods(SpendingOrderSearchParameters, DocumentObject);
	EndIf;
	
	Return DocumentObject;
	
EndFunction

Function FillOutSpendingOrderForGoods(ParametersForFillingExpenseOrder, DocumentObject)
	
	DocumentObject.GoodsByReferences.Clear();
	DocumentObject.ShippedGoods.Clear();
	
	FillPropertyValues(DocumentObject, ParametersForFillingExpenseOrder);
	
	DocumentObject.Date = ParametersForFillingExpenseOrder.CurrentDate;

	If ParametersForFillingExpenseOrder.ShipmentUnderTransportationJob
		And TypeOf(ParametersForFillingExpenseOrder.TransportationJob) = Type("DocumentRef.Trip") Then
		
		DocumentObject.DateOfShipment = ParametersForFillingExpenseOrder.DateOfShipment;
		
	Else
		
		DocumentObject.DateOfShipment = Max(ParametersForFillingExpenseOrder.CurrentDate,
											ParametersForFillingExpenseOrder.DateOfShipment);
		
	EndIf;
	
	If Metadata.DefinedTypes.SenderRecipientOfGoods.Type.ContainsType(TypeOf(ParametersForFillingExpenseOrder.Recipient)) Then
		DocumentObject.Recipient = ParametersForFillingExpenseOrder.Recipient;
	Else
		DocumentObject.Recipient = Catalogs.BusinessStructure.EmptyRef();
	EndIf;
	
	If GoodsDeliveryClientServer.UsedDelivery20()
		And ParametersForFillingExpenseOrder.ShipmentUnderTransportationJob Then
		
		DocumentObject.DeliveryProcedure = GoodsDelivery.DeliveryOrderInTransportOrder(
											DocumentObject.TransportationJob,
											ParametersForFillingExpenseOrder.Recipient);
		
	EndIf;
	
	Return DocumentObject;
	
EndFunction

// Parameters:
//	DocumentObject - DocumentObject.GoodsIssueNote
//	BackgroundJob - Boolean
//
// Returns:
//	Boolean - 
//
Function WriteOrderObject(DocumentObject, BackgroundJob)
	
	HasError = False;
	
	DocumentObject.GoodsByReferences.GroupBy("ReferenceOrder, Products, Characteristic, Purpose, Series", "Count");
	DocumentObject.Fill(Undefined);
	
	Try
		DocumentObject.Write(DocumentWriteMode.Posting);
	Except
		
		If BackgroundJob Then
			MessageText = NStr("ru = 'Не удалось записать расходный ордер %1 фоновым заданием по причине: %2';
								|vi = 'Cannot save a goods issue note using the %1 background job. Reason: %2';
								|en = 'Cannot save a goods issue note using the %1 background job. Reason: %2'; fa = 'Cannot save a goods issue note using the %1 background job. Reason: %2';
								|it = 'Cannot save a goods issue note using the %1 background job. Reason: %2';
								|pl = 'Cannot save a goods issue note using the %1 background job. Reason: %2';
								|tr = '%1 nolu ambar çıkış fişi arka plan göreviyle şu nedenle kaydedilemedi: %2'");
			MessageText = StrTemplate(MessageText,
										String(DocumentObject.Ref),
										ErrorProcessing.DetailErrorDescription(ErrorInfo()));
			
			WriteLogEvent(
				NStr("ru = 'Оформление расходных ордеров';
					|vi = 'Create goods issues';
					|en = 'Create goods issues'; fa = 'ایجاد حواله‌های انبار';
					|it = 'Emissione dei mandati di pagamento';
					|pl = 'Sporządzanie zleceń wydania';
					|tr = 'Ambar çıkış fişlerinin düzenlenmesi'"),
				EventLogLevel.Warning,
				Metadata.Documents.GoodsIssueNote,
				DocumentObject.Ref,
				MessageText);
		Else
			Common.MessageToUser(ErrorProcessing.BriefErrorDescription(ErrorInfo()));
		EndIf;
			
		HasError = True;
		
	EndTry;
	
	Return Not HasError;
	
EndFunction

Function EmptyItinerary()
	
	BlankValues = New Array;
	BlankValues.Add(Undefined);
	
	If Not GoodsDeliveryClientServer.UsedDelivery()
		Or GoodsDeliveryClientServer.UsedDelivery20() Then
		
		BlankValues.Add(Documents.TransportationJob.EmptyRef());
		
	Else
		BlankValues.Add(Documents.Trip.EmptyRef());
	EndIf;
	
	Return BlankValues;
	
EndFunction

