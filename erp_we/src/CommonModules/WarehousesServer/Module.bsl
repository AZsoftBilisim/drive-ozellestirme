//  Query - Query - Request for document reflection.
//  QueryTexts - ValueList - List of document reflection request texts.
// 	Registers - Undefined, Structure, String - List of registers to reflect.
//  QueryTextDocument_ - String - The text of the document data selection request containing the following required fields:
//     * Ref                - DocumentRef - Link to the current document
//     * Date                  - Date - Date of receipt of the goods
//     * Warehouse                 - CatalogRef.Warehouses - 
//     * Products          - CatalogRef.Products - 
//     * Characteristic        - CatalogRef.ItemsCharacteristics - 
//     * Purpose            - CatalogRef.Assignments - 
//     * ControlledLotReference  - CatalogRef.ControlledLots - controlled batch, for which the surplus/shortage is registered.
//     * BatchesIndicationStatus   - Number -
//     * Series                 - CatalogRef.ItemsBatches -
//     * Count            - Number - a negative value indicates that a shortage is being reflected
//
Procedure IssueSurplusShortagesInWarehouse(Query, QueryTexts, Registers,
		QueryTextDocument_) Export

	IssueSurplusShortagesInWarehouseInternal(Query, QueryTexts, Registers,
		QueryTextDocument_);
	
EndProcedure

