Procedure CreateMovementOfGoodsBySeparation(Val CreationParameters)
	
	// if the IB is being updated
	If Not InfobaseUpdate.DataProcessingCompleted(Undefined, "AccumulationRegister.GoodsInStorageBins", Undefined) Then
		Return;
	EndIf;
	
	Query = RequestMovingAccordingToRulesForPlacingSeparateProducts(CreationParameters);
	
	Result = Query.ExecuteBatch(); 
	
	TaskIds = New Array;
	
	TableGoodsToMove = New ValueTable;
	For Each Column In Result[22].Columns Do
		TableGoodsToMove.Columns.Add(Column.Name, Column.ValueType);
	EndDo;
	TableGoodsToMove.Columns.Add("JobID", New TypeDescription("UUID"));
	TableGoodsToMove.Columns.Add("Count", TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative));
	
	DistributeGoodsToMoveByTasks(Result, TaskIds, TableGoodsToMove);
	
	TableGoodsToMove.Indexes.Add("JobID");
	
	MovementTasks = CreateObjectsForMovingTasks(TaskIds, TableGoodsToMove, CreationParameters);
	
	NumberOfTasksCreated = 0;
	For Each Job_GoodsTransfer In MovementTasks Do
		
		PlacementErrors = New Array;
		ErrorsTareResidue = New Array;
		
		SupplementContainerWithTsAndMoveOnIsolation(Job_GoodsTransfer, ErrorsTareResidue);
		GoodsFilter = Job_GoodsTransfer.GoodsFilter.Unload();
		GoodsFilter.GroupBy(
			"Products, Characteristic, Purpose, Package, Series, PackageVolume, PackageWeight, BatchesIndicationStatus",
			"Count, NumberOfPackages");
		Job_GoodsTransfer.GoodsPlacement.Load(GoodsFilter);
		
		Job_GoodsTransfer.PlaceProducts("GoodsPlacement");
		
		If ThereArePlacementErrors(Job_GoodsTransfer) Then
			DeleteLinesWithPlacementErrors(Job_GoodsTransfer, PlacementErrors);
			SupplementContainerWithTsAndMoveOnIsolation(Job_GoodsTransfer);
			SupplementContainerWithTsAndMoveAlongSeparation(Job_GoodsTransfer);
		EndIf;
		
		If Job_GoodsTransfer.GoodsFilter.Count() Then

			SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(Job_GoodsTransfer, Documents.GoodsPickingPlacement);
			ProductsServer.FillInStatusesForSpecifyingSeries(Job_GoodsTransfer, SeriesSpecificationParameters.Filter);
			ProductsServer.FillInStatusesForSpecifyingSeries(Job_GoodsTransfer, SeriesSpecificationParameters.Location);
			
			Try
				
				Job_GoodsTransfer.Write(DocumentWriteMode.Posting);
				
			Except
			
				Comment = NStr("vi = 'Không thể tạo nhiệm vụ điều chuyển do nguyên nhân: %Error% 
					|%UserMessages%';
					|ru = 'Не удалось создать задание на перемещение по причине: %Error% 
					|%UserMessages%';
					|en = 'Cannot create a transfer job. Reason: %Error% 
					|%UserMessages%'; fa = 'Cannot create a transfer job. Reason: %Error% 
					|%UserMessages%';
					|it = 'Impossibile creare il task di trasferimento di movimento a causa di: %Error% 
					|%UserMessages%';
					|pl = 'Nie udało się utworzyć zadania ruchu z powodu: %Error% 
					|%UserMessages%';
					|tr = 'Bu nedenle bir transfer görevi oluşturulamadı: %Error% 
					|%UserMessages%'",
					CommonClientServer.DefaultLanguageCode());
					
				Comment = StrReplace(Comment, "%Error%", 
					DetailErrorDescription(ErrorInfo()));
					
				UserMessages = GetUserMessages(True);	
				MessageTexts_ = New Array;
				For Each Message In UserMessages Do
					MessageTexts_.Add(Message.Text);
				EndDo;
				
				Comment = StrReplace(Comment, "%UserMessages%", 
					StrConcat(MessageTexts_, Chars.LF));
				
				WriteLogEvent(
					NStr("vi = 'Tự động tạo nhiệm vụ điều chuyển';
						|ru = 'Автоматическое создание заданий на перемещение';
						|en = 'Automatic creation of transfer jobs'; fa = 'Automatic creation of transfer jobs';
						|it = 'Creazione automatica di task per il trasferimento';
						|pl = 'Automatyczne tworzenie zadań do przeniesienia';
						|tr = 'Transfer görevlerinin otomatik olarak oluşturulması'",
						CommonClientServer.DefaultLanguageCode()),
					EventLogLevel.Error,
					Metadata.ScheduledJobs.CreateTransferJobs,
					,
					Comment);
					
				CommonClientServer.MessageToUser(Comment);
						
			EndTry;
			
			NumberOfTasksCreated = NumberOfTasksCreated + 1;
			
		EndIf;
			
		If ErrorsTareResidue.Count() Then
		
			Comment = NStr("vi = '%ErrorsTareResidue%';
							|ru = '%ErrorsTareResidue%';
							|en = '%ErrorsTareResidue%'; fa = '%ErrorsTareResidue%';
							|it = '%ErrorsTareResidue%';
							|pl = '%ErrorsTareResidue%';
							|tr = '%ErrorsTareResidue%'",
				CommonClientServer.DefaultLanguageCode());
				
			Comment = StrReplace(Comment, "%ErrorsTareResidue%", 
				StrConcat(ErrorsTareResidue, Chars.LF));
				
			WriteLogEvent(
				NStr("vi = 'Tự động tạo nhiệm vụ điều chuyển';
					|ru = 'Автоматическое создание заданий на перемещение';
					|en = 'Automatic creation of transfer jobs'; fa = 'Automatic creation of transfer jobs';
					|it = 'Creazione automatica di task per il trasferimento';
					|pl = 'Automatyczne tworzenie zadań do przeniesienia';
					|tr = 'Transfer görevlerinin otomatik olarak oluşturulması'",
					CommonClientServer.DefaultLanguageCode()),
				EventLogLevel.Error,
				Metadata.ScheduledJobs.CreateTransferJobs,
				,
				Comment);
				
		EndIf;
		
		If PlacementErrors.Count() Then
		
			Comment = NStr("vi = '%PlacementErrors%
				|Hãy kiểm tra quy tắc sắp xếp.';
				|ru = '%PlacementErrors%
				|Проверьте правила размещения.';
				|en = '%PlacementErrors%
				|Check rules for put-away.'; fa = '%PlacementErrors%
				|Check rules for put-away.';
				|it = '%PlacementErrors%
				|Verifica le regole di collocamento.';
				|pl = '%PlacementErrors%
				|Sprawdź zasady rozmieszczenia.';
				|tr = '%PlacementErrors%
				|Yerleştirme kurallarını kontrol et.'",
				CommonClientServer.DefaultLanguageCode());
				
			Comment = StrReplace(Comment, "%PlacementErrors%", 
				StrConcat(PlacementErrors, Chars.LF));
			
			WriteLogEvent(
				NStr("vi = 'Tự động tạo nhiệm vụ điều chuyển';
					|ru = 'Автоматическое создание заданий на перемещение';
					|en = 'Automatic creation of transfer jobs'; fa = 'Automatic creation of transfer jobs';
					|it = 'Creazione automatica di task per il trasferimento';
					|pl = 'Automatyczne tworzenie zadań do przeniesienia';
					|tr = 'Transfer görevlerinin otomatik olarak oluşturulması'",
					CommonClientServer.DefaultLanguageCode()),
				EventLogLevel.Error,
				Metadata.ScheduledJobs.CreateTransferJobs,
				,
				Comment);
				
		EndIf;
		
	EndDo;
	
	If NumberOfTasksCreated Then
		
		Comment = NStr("vi = '%Created% %JobsCount% điều chuyển.';
						|ru = '%Created% %JobsCount% на перемещение.';
						|en = '%Created% %JobsCount% to transfer.'; fa = '%Created% %JobsCount% to transfer.';
						|it = '%Created% %JobsCount% per il trasferimento.';
						|pl = '%Created% %JobsCount% na przeniesienie.';
						|tr = '%Created% %JobsCount% transfer için.'", 
			CommonClientServer.DefaultLanguageCode());
		
		Comment = StrReplace(
			Comment, 
			"%JobsCount%", 
			StringFunctionsClientServer.NumberInDigitsUnitOfMeasurementInWords(
				NumberOfTasksCreated,
				"job, jobs, oftasks",
				True));
				
		Comment = StrReplace(
			Comment, 
			"%Created%",
			?(NumberOfTasksCreated = 1,
				"CreatedOn",
				"Created"));
				
		WriteLogEvent(
			NStr("vi = 'Tự động tạo nhiệm vụ điều chuyển';
				|ru = 'Автоматическое создание заданий на перемещение';
				|en = 'Automatic creation of transfer jobs'; fa = 'Automatic creation of transfer jobs';
				|it = 'Creazione automatica di task per il trasferimento';
				|pl = 'Automatyczne tworzenie zadań do przeniesienia';
				|tr = 'Transfer görevlerinin otomatik olarak oluşturulması'",
				CommonClientServer.DefaultLanguageCode()),
			EventLogLevel.Information,
			Metadata.ScheduledJobs.CreateTransferJobs,
			,
			Comment);
			
		CommonClientServer.MessageToUser(Comment);
		
	Else
		
		Comment = NStr("vi = 'Chưa tạo nhiệm vụ (không thể tạo hoặc không nên điều chuyển).';
