		JobTitle = TrimAll(WarehouseOrPosition);
	Else
		JobTitle = TrimAll(Common.ObjectAttributeValue(WarehouseOrPosition, "CurrentPositionOfTheResponsiblePerson"));
	EndIf;
	
	Return ?(ValueIsFilled(JobTitle), JobTitle, NStr("vi = 'Thủ kho';
													|ru = 'Кладовщик';
													|en = 'Warehouse keeper'; fa = 'انباردار';
													|it = 'Magazziniere';
													|pl = 'Warehouse keeper';
													|tr = 'Ambar sorumlusu'", Common.DefaultLanguageCode()));
	
EndFunction

// Complements the request text for forming printed forms MX-1, MX-3
//
// Parameters:
//	Query - Query - the request being executed.
//
Procedure AddRequestTextForPrintedFormsMX1X3(Query) Export
	
	UsePriceManagementSystem25 = PriceManagementSystemServerCall.UsePriceManagementSystem25();
	If UsePriceManagementSystem25 Then
		DateOfMigrationToPriceManagementSystem25 = PriceManagementSystemServerCall.DateOfTransitionToPricingVersion25();
	EndIf;

	QueryText = "
	|SELECT
	|	Goods.Ref AS Ref,
	|	Goods.LineNumber AS LineNumber,
	|	ItemsPrices.PriceKind AS PriceKind,
	|	ItemsPrices.Products AS Products,
	|	ItemsPrices.Characteristic AS Characteristic,
	|	MAX(ItemsPrices.Period) AS Period
	|INTO ProductPricePeriods
	|FROM
	|	TTProducts_1 AS Goods
	|		INNER JOIN InformationRegister.ItemsPrices AS ItemsPrices
	|		ON Goods.PriceKind = ItemsPrices.PriceKind
	|			AND Goods.Products = ItemsPrices.Products
	|			AND Goods.Characteristic = ItemsPrices.Characteristic
	|			AND Goods.DateOfPriceReceipt >= ItemsPrices.Period
	|			AND Goods.PriceCurrency = ItemsPrices.Currency
	|			AND CASE WHEN &UsePriceManagementSystem25 THEN Goods.DateOfPriceReceipt < &DateOfMigrationToPriceManagementSystem25 ELSE TRUE END
	|
	|GROUP BY
	|	Goods.Ref,
	|	Goods.LineNumber,
	|	ItemsPrices.PriceKind,
	|	ItemsPrices.Products,
	|	ItemsPrices.Characteristic
	|;
	|
	|SELECT
	|	Goods.Ref AS Ref,
	|	Goods.LineNumber AS LineNumber,
	|	Goods.Products AS Products,
	|	Goods.Characteristic AS Characteristic,
	|	Goods.Package AS Package,
	|	Goods.PriceKind AS PriceKind,
	|	Goods.DateOfPriceReceipt AS DateOfPriceReceipt,
	|	Goods.PriceCurrency AS PriceCurrency,
	|	ISNULL(CASE
	|			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
	|				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
	|			ELSE CharacteristicTable.ItemsCharacteristicForPricing
	|		END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	|	ISNULL(CASE
	|			WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
	|				THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
	|			ELSE TableOfSeries.ItemsBatchForPricing
	|		END, VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)) AS PricingBatch,
	|	CASE
	|		WHEN ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
	|			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|		ELSE Goods.Package
	|	END AS PricingPackage,
	|	Goods.NumberOfPackages AS NumberOfPackages
	|INTO GoodsAttributes25
	|FROM
	|	TTProducts_1 AS Goods
	|		INNER JOIN Catalog.Products AS ProductsTable
	|		ON Goods.Products = ProductsTable.Ref
	|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicTable
	|		ON Goods.Characteristic = CharacteristicTable.Ref
	|		LEFT JOIN Catalog.ItemsBatches AS TableOfSeries
	|		ON Goods.Series = TableOfSeries.Ref
	|		LEFT JOIN Catalog.ItemKinds AS ItemKinds
	|		ON (ItemKinds.Ref = ProductsTable.ProductKind)
	|;
	|
	|SELECT
	|	Goods.Ref AS Ref,
	|	Goods.LineNumber AS LineNumber,
	|	ItemsPrices.PriceKind AS PriceKind,
	|	ItemsPrices.Products AS Products,
	|	ItemsPrices.PricingVariant AS PricingVariant,
	|	ItemsPrices.PricingBatch AS PricingBatch,
	|	ItemsPrices.PricingPackage AS PricingPackage,
	|	MAX(ItemsPrices.Period) AS Period
	|INTO ProductPricePeriods25
	|FROM
	|	GoodsAttributes25 AS Goods
	|		INNER JOIN InformationRegister.ItemsPrices25 AS ItemsPrices
	|		ON Goods.PriceKind = ItemsPrices.PriceKind
	|			AND Goods.Products = ItemsPrices.Products
	|			AND Goods.PricingVariant = ItemsPrices.PricingVariant
	|			AND Goods.PricingBatch = ItemsPrices.PricingBatch
	|			AND Goods.PricingPackage = ItemsPrices.PricingPackage
	|			AND Goods.DateOfPriceReceipt >= ItemsPrices.Period
	|			AND Goods.PriceCurrency = ItemsPrices.Currency
	|			AND &UsePriceManagementSystem25
	|			AND Goods.DateOfPriceReceipt >= &DateOfMigrationToPriceManagementSystem25
	|
	|GROUP BY
	|	Goods.Ref,
	|	Goods.LineNumber,
	|	ItemsPrices.PriceKind,
	|	ItemsPrices.Products,
	|	ItemsPrices.PricingVariant,
	|	ItemsPrices.PricingBatch,
	|	ItemsPrices.PricingPackage
	|;
	|
	|SELECT
	|	InventoryKinds.Ref AS Ref,
	|	GoodsCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	GoodsCost.Organization AS Organization,
	|	GoodsCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	MAX(GoodsCost.Period) AS Period
	|INTO PeriodsOfCostOfGoods
	|FROM
	|	TTTypesOfStocks AS InventoryKinds
	|		INNER JOIN InformationRegister.GoodsCost AS GoodsCost
	|		ON InventoryKinds.ItemsLocationAttributes = GoodsCost.ItemsLocationAttributes
	|			AND InventoryKinds.Organization = GoodsCost.Organization
	|			AND InventoryKinds.InventoryOwnerAttribute = GoodsCost.InventoryOwnerAttribute
	|			AND InventoryKinds.DateOfPriceReceipt >= GoodsCost.Period
	|			AND (InventoryKinds.PreliminaryCalculation)
	|
	|GROUP BY
	|	InventoryKinds.Ref,
	|	GoodsCost.InventoryOwnerAttribute,
	|	GoodsCost.Organization,
	|	GoodsCost.ItemsLocationAttributes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductPricePeriods.Ref AS Ref,
	|	ProductPricePeriods.LineNumber AS LineNumber,
	|	ItemsPrices.Price AS Price,
	|	ItemsPrices.Package AS Package
	|INTO PricesByPriceTypes
	|FROM
	|	ProductPricePeriods AS ProductPricePeriods
	|		INNER JOIN InformationRegister.ItemsPrices AS ItemsPrices
	|		ON ProductPricePeriods.Period = ItemsPrices.Period
	|			AND ProductPricePeriods.PriceKind = ItemsPrices.PriceKind
	|			AND ProductPricePeriods.Products = ItemsPrices.Products
	|			AND ProductPricePeriods.Characteristic = ItemsPrices.Characteristic
	|
	|UNION ALL
	|
	|SELECT
	|	ProductPricePeriods.Ref,
	|	ProductPricePeriods.LineNumber,
	|	ItemsPrices.Price,
	|	ItemsPrices.Package
	|FROM
	|	ProductPricePeriods25 AS ProductPricePeriods
	|		INNER JOIN InformationRegister.ItemsPrices25 AS ItemsPrices
	|		ON ProductPricePeriods.Period = ItemsPrices.Period
	|			AND ProductPricePeriods.PriceKind = ItemsPrices.PriceKind
	|			AND ProductPricePeriods.Products = ItemsPrices.Products
	|			AND ProductPricePeriods.PricingVariant = ItemsPrices.PricingVariant
	|			AND ProductPricePeriods.PricingBatch = ItemsPrices.PricingBatch
	|			AND ProductPricePeriods.PricingPackage = ItemsPrices.PricingPackage
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PeriodsOfCostOfGoods.Ref,
	|	GoodsCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	GoodsCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	GoodsCost.Organization AS Organization,
	|	(GoodsCost.LocalCost
	|		+ GoodsCost.AddExpensesLocal
	|		+ GoodsCost.LaborCostsLocal
	|		+ GoodsCost.ItemizedFixedCostsCompl
	|		+ GoodsCost.ItemizedVariableCostsCompl) AS Cost
	|INTO PricesAtCostPriceInAdvance
	|FROM
	|	PeriodsOfCostOfGoods AS PeriodsOfCostOfGoods
	|		INNER JOIN InformationRegister.GoodsCost AS GoodsCost
	|		ON PeriodsOfCostOfGoods.ItemsLocationAttributes = GoodsCost.ItemsLocationAttributes
	|			AND PeriodsOfCostOfGoods.Organization = GoodsCost.Organization
	|			AND PeriodsOfCostOfGoods.Period = GoodsCost.Period
	|			AND PeriodsOfCostOfGoods.InventoryOwnerAttribute = GoodsCost.InventoryOwnerAttribute
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InventoryKinds.Ref AS Ref,
	|	InventoryCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	InventoryCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	InventoryCost.Organization AS Organization,
	|	SUM(InventoryCost.Count) AS Count,
	|	SUM(InventoryCost.LocalCost
	|		+ InventoryCost.AddExpensesLocal
	|		+ InventoryCost.LaborCostsLocal
	|		+ InventoryCost.ItemizedFixedCostsCompl
	|		+ InventoryCost.ItemizedVariableCostsCompl
	|	) AS Cost
	|INTO PricesAtCost
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|		INNER JOIN TTTypesOfStocks AS InventoryKinds
	|		ON (InventoryKinds.Ref = InventoryCost.DocumentRegisterRecords
	|				OR InventoryKinds.Ref = InventoryCost.Recorder)
	|			AND (InventoryKinds.ItemsLocationAttributes = InventoryCost.ItemsLocationAttributes)
	|			AND (InventoryKinds.Organization = InventoryCost.Organization)
	|			AND (InventoryKinds.InventoryOwnerAttribute = InventoryCost.InventoryOwnerAttribute)
	|			AND (NOT InventoryKinds.PreliminaryCalculation)
	|
	|GROUP BY
	|	InventoryKinds.Ref,
	|	InventoryCost.ItemsLocationAttributes,
	|	InventoryCost.InventoryOwnerAttribute,
	|	InventoryCost.Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Header.Ref AS Ref,
	|	Header.Organization AS Organization,
	|	Header.PriceCurrency AS PriceCurrency,
	|	MAX(ExchangeRates.Period) AS RatePeriod
	|INTO DocumentExchangeRates_
	|FROM
	|	TTHeader AS Header
	|		INNER JOIN Catalog.Companies AS CompanyTable
	|		ON Header.Organization = CompanyTable.Ref
	|		LEFT JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
	|		ON Header.PriceCurrency = ExchangeRates.Currency
	|		AND ExchangeRates.BaseCurrency = CompanyTable.LocalAccountingCurrency
	|		AND Header.Date >= ExchangeRates.Period
	|		AND ExchangeRates.CourseDenominator <> 0
	|GROUP BY
	|	Header.Ref,
	|	Header.Organization,
	|	Header.PriceCurrency
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	TTHeader.Ref AS Ref,
	|	TTHeader.Number AS Number,
	|	TTHeader.Date AS Date,
	|	TTHeader.DocumentDate AS DocumentDate,
	|	TTHeader.DateOfReceiptOfCostPrice AS DateOfReceiptOfCostPrice,
	|	TTHeader.Organization AS Organization
	|FROM
	|	TTHeader AS TTHeader
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TTHeader.Ref AS Ref,
	|	TTHeader.PreliminaryCalculation AS PreliminaryCalculation,
	|	Warehouses.SourseOfInformationAboutPricesForPrinting AS SourseOfInformationAboutPricesForPrinting,
	|	PRESENTATION(TTHeader.Warehouse) AS WarehousePresentation_,
	|	TTHeader.Warehouse AS Warehouse,
	|	TTHeader.PriceKind AS PriceKind,
	|	TTHeader.PriceCurrency AS PriceCurrency,
	|	PRESENTATION(Warehouses.Department) AS DivisionRepresentation,
	|	Warehouses.Depository AS Depository,
	|	CASE
	|		WHEN Warehouses.CustodyUntilCalledFor
	|			THEN &PreRequirements
	|		ELSE Warehouses.CustodyPeriod
	|	END AS ShelfLife,
	|	Warehouses.SpecialNotes AS SpecialNotes,
	|	Warehouses.GoodsStorageConditions AS StorageConditions,
	|	Warehouses.CurrentPositionOfTheResponsiblePerson AS PositionMOL,
	|	Warehouses.CurrentEmployeeInChargeTypes AS FinanciallyLiablePerson
	|FROM
	|	TTHeader AS TTHeader
	|		LEFT JOIN Catalog.Warehouses AS Warehouses
	|		ON TTHeader.Warehouse = Warehouses.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Goods.Ref AS Ref,
	|	Goods.Warehouse AS Warehouse,
	|	CASE
	|		WHEN &ColumnOfCodes = ""SKU""
	|			THEN ProductsTable.SKU
	|		ELSE ProductsTable.Code
	|	END AS ProductsCode,
	|	Goods.LineNumber AS LineNumber,
	|	ProductsTable.Ref AS Products,
	|	ProductsTable.DescriptionFull AS ProductPresentation,
	|	CharacteristicTable.DescriptionFull AS CharacteristicPresentation,
	|	Goods.UnitOfMeasurementName AS UnitOfMeasurementName,
	|	Goods.UnitOfMeasureCode AS UnitOfMeasureCode,
	|	Goods.NumberOfPackages AS Count,
	|	Goods.PackageKind AS PackageKind,
	|	CAST(ISNULL(Prices.Price, 0) * ISNULL(ExchangeRates.CourseNumerator, 0) / ISNULL(ExchangeRates.CourseDenominator, 1) / ISNULL(&QueryTextPackagingFactor, 1) * Goods.Count AS NUMBER(31,2)) AS Sum,
	|	CASE
	|		WHEN Goods.NumberOfPackages = 0
	|			THEN CAST(ISNULL(Prices.Price, 0) * ISNULL(ExchangeRates.CourseNumerator, 0) / ISNULL(ExchangeRates.CourseDenominator, 1) / ISNULL(&QueryTextPackagingFactor, 1) * Goods.Count AS NUMBER(31,2))
	|		ELSE CAST(ISNULL(Prices.Price, 0) * ISNULL(ExchangeRates.CourseNumerator, 0) / ISNULL(ExchangeRates.CourseDenominator, 1) / ISNULL(&QueryTextPackagingFactor, 1) * Goods.Count / Goods.NumberOfPackages AS NUMBER(31,2))
	|	END AS Price
	|FROM
	|	TTProducts_1 AS Goods
	|		INNER JOIN Catalog.Products AS ProductsTable
	|		ON Goods.Products = ProductsTable.Ref
	|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicTable
	|		ON Goods.Characteristic = CharacteristicTable.Ref
	|		LEFT JOIN PricesByPriceTypes AS Prices
	|		ON Goods.Ref = Prices.Ref
	|		AND Goods.LineNumber = Prices.LineNumber
	|		INNER JOIN DocumentExchangeRates_ AS DocumentExchangeRates_
	|		ON Goods.Ref = DocumentExchangeRates_.Ref
	|		INNER JOIN Catalog.Companies AS CompanyTable
	|		ON DocumentExchangeRates_.Organization = CompanyTable.Ref
	|		LEFT JOIN InformationRegister.RelativeExchangeRates AS ExchangeRates
	|		ON DocumentExchangeRates_.RatePeriod = ExchangeRates.Period
	|		AND Goods.PriceCurrency = ExchangeRates.Currency
	|		AND ExchangeRates.BaseCurrency = CompanyTable.LocalAccountingCurrency
	|		AND ExchangeRates.CourseDenominator <> 0
	|
	|UNION ALL
	|
	|SELECT
	|	InventoryKinds.Ref,
	|	InventoryKinds.Warehouse,
	|	CASE
	|		WHEN &ColumnOfCodes = ""SKU""
	|			THEN ProductsTable.SKU
	|		ELSE ProductsTable.Code
	|	END,
	|	InventoryKinds.LineNumber,
	|	ProductsTable.Ref,
	|	ProductsTable.DescriptionFull,
	|	CharacteristicTable.DescriptionFull,
	|	InventoryKinds.UnitOfMeasurementName,
	|	InventoryKinds.UnitOfMeasureCode,
	|	InventoryKinds.NumberOfPackages,
	|	InventoryKinds.PackageKind,
	|	CAST(CASE
	|			WHEN NOT Prices.Cost IS NULL
	|				THEN Prices.Cost / CASE
	|						WHEN Prices.Count = 0
	|							THEN 1
	|						ELSE Prices.Count
	|					END
	|			ELSE PricesArePreliminary.Cost
	|		END * CASE
	|			WHEN InventoryKinds.NumberOfPackages = 0
	|				THEN 1
	|			ELSE InventoryKinds.NumberOfPackages
	|		END AS NUMBER(31, 2)),
	|	CAST(CASE
	|			WHEN NOT Prices.Cost IS NULL
	|				THEN Prices.Cost / CASE
	|						WHEN Prices.Count = 0
	|							THEN 1
	|						ELSE Prices.Count
	|					END
	|			ELSE PricesArePreliminary.Cost
	|		END AS NUMBER(31, 2))
	|FROM
	|	TTTypesOfStocks AS InventoryKinds
	|		INNER JOIN Catalog.Products AS ProductsTable
	|		ON InventoryKinds.Products = ProductsTable.Ref
	|		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicTable
	|		ON InventoryKinds.Characteristic = CharacteristicTable.Ref
	|		LEFT JOIN PricesAtCostPriceInAdvance AS PricesArePreliminary
	|		ON InventoryKinds.Ref = PricesArePreliminary.Ref
	|			AND InventoryKinds.ItemsLocationAttributes = PricesArePreliminary.ItemsLocationAttributes
	|			AND InventoryKinds.Organization = PricesArePreliminary.Organization
	|			AND InventoryKinds.InventoryOwnerAttribute = PricesArePreliminary.InventoryOwnerAttribute
	|		LEFT JOIN PricesAtCost AS Prices
	|		ON InventoryKinds.Ref = Prices.Ref
	|			AND InventoryKinds.ItemsLocationAttributes = Prices.ItemsLocationAttributes
	|			AND InventoryKinds.Organization = Prices.Organization
	|			AND InventoryKinds.InventoryOwnerAttribute = Prices.InventoryOwnerAttribute
	|
	|ORDER BY
	|	Ref,
	|	Warehouse,
	|	LineNumber,
	|	Products,
	|	CharacteristicPresentation,
	|	PackageKind
	|
	|TOTALS BY
	|	Ref,
	|	Warehouse
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DocumentData.Ref						AS Ref,
	|	PRESENTATION(DocumentData.Ref)		AS RefPresentation,
	|	DocumentData.Organization					AS Organization,
	|	PRESENTATION(DocumentData.Organization)	AS OrganizationPresentation,
	|	DocumentData.Warehouse						AS Warehouse,
	|	PRESENTATION(DocumentData.Warehouse)		AS WarehousePresentation,
	|	DocumentData.CustodyWarehouse	AS CustodyWarehouse,
	|	DocumentData.CompanyDepositor	AS CompanyDepositor
	|FROM
	|	DocumentData AS DocumentData
	|		LEFT JOIN TTHeader AS TTHeader
	|		ON DocumentData.Ref = TTHeader.Ref
	|
	|WHERE
	|	TTHeader.Ref IS NULL
	|;
	|";
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"Prices.Package",
		"Goods.Products"));
	
	Query.Text = Query.Text + QueryText;
	Query.SetParameter("PreRequirements", NStr("vi = 'theo yêu cầu';
												|ru = 'до востребования';
												|en = 'until called for'; fa = 'تا زمان درخواست';
												|it = 'fermo posta';
												|pl = 'poste restante';
												|tr = 'postrestant öncesi'"));
	Query.SetParameter("DateOfMigrationToPriceManagementSystem25", DateOfMigrationToPriceManagementSystem25);
	Query.SetParameter("UsePriceManagementSystem25", UsePriceManagementSystem25);
	
EndProcedure

