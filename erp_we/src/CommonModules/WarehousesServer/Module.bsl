// The procedure is to Check the filling of the cells in the PM, when processing the padding verification
//
// Parameters:
//  Object	- DocumentObject  - document to check the filling of cells in the PM 
//  		- ClientApplicationForm - the object in the TS of which you want to check the filling of the cells must contain:
//				* Ref - DocumentRef
//  			* Warehouse - CatalogRef.Warehouses
//  			* Premise - CatalogRef.Warerooms
//  NotCheckedAttributeArray - Array - array of details that don't need to be checked by platform verification
//	Cancel - Boolean - failure to continue the operation
//	CheckParameters - See WarehousesServer.ParametersForCheckingCellFilling
//
Procedure CheckFillingOfCells(Object, NotCheckedAttributeArray, Cancel, CheckParameters = Undefined)Export
		
	If CheckParameters = Undefined Then
		CheckParameters = ParametersForCheckingCellFilling();
	EndIf;
	
	TSName                 = CheckParameters.TSName;
	OutputLineNumbers   = CheckParameters.OutputLineNumbers;
	
	NotCheckedAttributeArray.Add(TSName+".Cell");
		
	DataKey = TMCommonUse.DataKeyForMessageToUser(Object);
	
	Query = New Query;
	QueryText =
	"SELECT
	|	TableOfGoods.LineNumber,
	|	TableOfGoods.Warehouse AS Warehouse,
	|	TableOfGoods.Premise AS Premise,
	|	TableOfGoods.Cell AS Cell
	|INTO LinesWithErrors
	|FROM
	|	&TableOfGoods AS TableOfGoods
	|WHERE
	|	TableOfGoods.Cell = VALUE(Catalog.StorageBins.EmptyRef)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	LinesWithErrors.LineNumber
	|FROM
	|	LinesWithErrors AS LinesWithErrors
	|WHERE
	|	CASE
	|			WHEN CAST(LinesWithErrors.Warehouse AS Catalog.Warehouses).UseWarerooms
	|					AND &Period >= CAST(LinesWithErrors.Warehouse AS Catalog.Warehouses).StartDateOfWareroomUse
	|				THEN CASE
	|						WHEN CAST(LinesWithErrors.Premise AS Catalog.Warerooms).UseBinLocationWarehousing
	|								AND &Period >= CAST(LinesWithErrors.Premise AS Catalog.Warerooms).StartDateOfUsingWarehouseBinSystem
	|							THEN TRUE
	|						ELSE FALSE
	|					END
	|			ELSE CASE
	|					WHEN CAST(LinesWithErrors.Warehouse AS Catalog.Warehouses).UseBinLocationWarehousing
	|							AND &Period >= CAST(LinesWithErrors.Warehouse AS Catalog.Warehouses).StartDateOfUsingWarehouseBinSystem
	|						THEN TRUE
	|					ELSE FALSE
	|				END
	|		END";
		
	Query.Text = QueryText;
	
	Query.SetParameter("Period", Object.Date);
	Query.SetParameter(
			"TableOfGoods", 
			Object[TSName].Unload(, "LineNumber,Warehouse,Premise,Cell"));
	
	If OutputLineNumbers Then
		MessageTemplate = NStr("vi = 'Chưa điền cột ""%Cell%"" tại dòng %LineNumber% trong danh sách ""%GoodsTable%"".';
								|ru = 'Не заполнена колонка ""%Cell%"" в строке %LineNumber% списка ""%GoodsTable%"".';
								|en = 'The ""%Cell%"" column is not filled in line %LineNumber% of the ""%GoodsTable%"" list.'; fa = 'The ""%Cell%"" column is not filled in line %LineNumber% of the ""%GoodsTable%"" list.';
								|it = 'Non è compilata la colonna ""%Cell%"" nella riga %LineNumber% dell''elenco ""%GoodsTable%"".';
								|pl = 'Niewypełniona kolumna ""%Cell%"" w wierszu %LineNumber% na liście ""%GoodsTable%"".';
								|tr = '""%GoodsTable%"" listesinin %LineNumber% satırındaki ""%Cell%"" sütunu doldurulmadı.'");
	Else
		MessageTemplate = NStr("vi = 'Chưa điền cột ""%Cell%"" trong danh sách ""%GoodsTable%"".';
								|ru = 'Не заполнена колонка ""%Cell%"" в списке ""%GoodsTable%"".';
								|en = 'Column ""%Cell%"" in list ""%GoodsTable%"" is not filled in.'; fa = 'Column ""%Cell%"" in list ""%GoodsTable%"" is not filled in.';
								|it = 'Non è compilata la colonna ""%Cell%"" nell''elenco ""%GoodsTable%"".';
								|pl = 'Niewypełniona kolumna ""%Cell%"" w wierszu ""%GoodsTable%"".';
								|tr = '""%GoodsTable%"" listesindeki ""%Cell%"" sütunu doldurulmadı.'");
	EndIf;
	
	Selection = Query.Execute().Select();
	
	If TypeOf(Object) <> Type("ClientApplicationForm") Then
		ObjectMetadata = Object.Metadata();
	Else
		ObjectMetadata = Object.Ref.Metadata();
	EndIf;
	
	PresentationOfTS              = ObjectMetadata.TabularSections[TSName].Synonym;
	PresentationOfPropsCell = ObjectMetadata.TabularSections[TSName].Attributes.Cell.Synonym;
	
	While Selection.Next() Do
		
		// Only the row numbers where adr. storage is used should remain in the selection, but the cell is not filled.
			
		MessageText = StrReplace(MessageTemplate, "%Cell%", PresentationOfPropsCell);
		MessageText = StrReplace(MessageText, "%GoodsTable%", PresentationOfTS);
		MessageText = StrReplace(MessageText, "%LineNumber%", Selection.LineNumber);
		
		Field = CommonClientServer.PathToTabularSection(TSName, Selection.LineNumber, "Cell");
		
		CommonClientServer.MessageToUser(MessageText,DataKey,Field,"Object",Cancel);
				
	EndDo;
	
EndProcedure

