// The procedure creates a job on the conversion
//	Parameters:
//		GenerationParameters_ - Structure - a structure that has the following keys:
//			*RecountByFilling - Boolean - only cells with leftovers,
//			*RecountBySpecialConditions - Boolean - selection of cells according to special conditions (see recalculation of storage cells, recalculation of periodicity adjustment, recalculation of cells with negative values)
//			*DoubtfulBinRecount - Boolean - select cells that were marked as questionable or that had a selection error
//			*RecountByFrequencySettings - Boolean - select cells for which it is time to recalculate,
//			*RecalculationByCellsWithNegativeResiduals - Boolean - select cells that have negative balances,
//			*Filter_Settings - DataCompositionSettingsComposer - stores settings for the selection of goods,
//			*SplitByWorkArea - Boolean - True if you want the created recalculations to be divided into work sections,
//			*SplitByNumberOfCells - Boolean - True, if necessary, for each recalculation there was a certain number of cells,
//			*NumberOfCellsInTheTask - Number - relevant if you break down the number of cells = True
Procedure CreateTasksForRecalculatingProducts(GenerationParameters_) Export
	
	Common.OnStartExecuteScheduledJob(Metadata.ScheduledJobs.CreateGoodsRecountJobs);
	
	NumberOfTasksCreated = Documents.InventoryRecount.CreateJobs(GenerationParameters_);
	
	RowOfWarehousesWithQuantity = StringFunctionsClientServer.NumberInDigitsUnitOfMeasurementInWords(
		NumberOfTasksCreated, NStr("vi = 'nhiệm vụ, nhiệm vụ, nhiệm vụ';
									|ru = 'задание,задания,заданий';
									|en = 'job, jobs, jobs'; fa = 'job, jobs, jobs';
									|it = 'task,task,task';
									|pl = 'zadanie,zadania,zadań';
									|tr = 'görev,görev,görev'"));
	MessageString = NStr("vi = 'Đã tạo %RowOfWarehousesWithQuantity% kiểm đếm.';
						|ru = 'Создано %RowOfWarehousesWithQuantity% на пересчет.';
						|en = '%RowOfWarehousesWithQuantity% is created for recount.'; fa = '%RowOfWarehousesWithQuantity% is created for recount.';
						|it = 'Generati %RowOfWarehousesWithQuantity% per il ricalcolo.';
						|pl = 'Utworzono %RowOfWarehousesWithQuantity% do ponownego przeliczenia.';
						|tr = 'Yeniden hesaplama %RowOfWarehousesWithQuantity% için oluşturuldu.'");
	MessageString = StrReplace(MessageString, "%RowOfWarehousesWithQuantity%", RowOfWarehousesWithQuantity);
	
	CommonClientServer.MessageToUser(MessageString);
	
EndProcedure

