			|Available inventory in the cell %3 is exceeded by %4 %5';
			|it = 'Articoli %1 %2
			|Superato saldo libero nella cella %3 per %4 %5';
			|pl = 'Nomenklatura %1 %2
			|Przekroczono wolny ostatek w komórce %3 o %4 %5';
			|tr = 'Öğe %1 %2
			| %3 hücresindeki serbest bakiye %4 %5 oranında aşıldı'");
		
		For Each ErrorString In ControlResults.ErrorsOccurInCells Do
			
			ProductPresentation = ProductsClientServer.ProductPresentation(ErrorString.Products,
				ErrorString.Characteristic,, ErrorString.Series);
			Purpose = ?(ValueIsFilled(ErrorString.Purpose), "(" + String(ErrorString.Purpose) + ")", "");
			
			MessageText = StrTemplate(MessageTemplate, ProductPresentation, Purpose,
