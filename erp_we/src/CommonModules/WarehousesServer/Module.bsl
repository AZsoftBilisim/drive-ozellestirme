// Supplements the texts of the request for the document with the texts of accounting for the actual shipment of goods from a retail warehouse.
// The operation generates movements in the inventory accumulation register.
//
// Parameters:
//	Query						- Query			- request to reflect the document in accounting.
//	QueryTexts				- ValueList	- collection of request texts for document reflection in accounting.
//	Registers					- Structure, String, Undefined - a collection of registers to reflect the document in accounting.
//	TextOfDocumentDataRequest	- String			- the text of the document data request.
//		Composition of selection fields:
//			* Ref				- DocumentRef								- link of the Registrar document.
//			* Period				- Date											- date when the operation was reflected.
//			* Warehouse					- CatalogRef.Warehouses						- the warehouse from which the goods are shipped.
//			* Products			- CatalogRef.Products					- the product being shipped.
//			* Characteristic		- CatalogRef.ItemsCharacteristics	- characteristics of the product being shipped.
//			* Series					- CatalogRef.ItemsBatches			- a series of goods to be shipped.
//			* BatchesIndicationStatus	- Number											- the status of the series indication.
//			* Count			- Number											- quantity of the product to be shipped.
//			* GoodsReturn			- Boolean										- True - indicates that the product is being returned.
//	MetadataObject			- MetadataObject,
//									Undefined - the metadata object of the Registrar document.
//														Filled in if the document includes a table part that stores information about product series.
//  MethodParameters - See ParametersOfModularHolding
//
Procedure ArrangeShipmentAtRetail(Query,
									QueryTexts,
									Registers,
									TextOfDocumentDataRequest,
									MetadataObject = Undefined,
									MethodParameters) Export
									
	TSSeriesName = MethodParameters.TSSeriesName;
	SynonymForDocumentTS = MethodParameters.SynonymForDocumentTable;
									
	RequestTextTTProductsCollapsed = 
	"SELECT
	|	DocumentData.Ref				AS Ref,
	|	DocumentData.Period				AS Period,
	|	DocumentData.Warehouse				AS Warehouse,
	|	DocumentData.Premise			AS Premise,
	|	DocumentData.Products		AS Products,
	|	DocumentData.Characteristic		AS Characteristic,
	|	DocumentData.Series				AS Series,
	|	DocumentData.BatchesIndicationStatus	AS BatchesIndicationStatus,
	|	&AdditionalFields,	
	|	SUM(DocumentData.Count)	AS Count,
	|	DocumentData.GoodsReturn		AS GoodsReturn
	|INTO TTGoodsRolledToArrangeShipmentToRetail
	|FROM
	|	#DocumentData AS DocumentData
	|
	|GROUP BY
	|	DocumentData.Ref,
	|	DocumentData.Period,
	|	DocumentData.Warehouse,
	|	DocumentData.Premise,
	|	DocumentData.Products,
	|	DocumentData.Characteristic,
	|	DocumentData.Series,
	|	DocumentData.BatchesIndicationStatus,
	|	&AdditionalFields,	
	|	DocumentData.GoodsReturn";
	
	QueryOptions = ParametersOfDocumentDataRequestText("ArrangeShipmentAtRetail");
	
	FillInRequestTextParameters(RequestTextTTProductsCollapsed, QueryOptions);
	
	TextForSubstitutingAdditionalFields = "";
	For Each Field In MethodParameters.AdditionalSeriesConnectionFields Do
		TextForSubstitutingAdditionalFields = TextForSubstitutingAdditionalFields + ", " + "DocumentData." + Field + Chars.LF;
	EndDo;
	TextForSubstitutingAdditionalFields = Mid(TextForSubstitutingAdditionalFields, 2);
	
	If MethodParameters.AdditionalSeriesConnectionFields.Count() > 0 Then
		RequestTextTTProductsCollapsed = StrReplace(RequestTextTTProductsCollapsed, "&AdditionalFields", TextForSubstitutingAdditionalFields);
	Else
		RequestTextTTProductsCollapsed = StrReplace(RequestTextTTProductsCollapsed, "&AdditionalFields,", "");
	EndIf;
	
	RequestTextTTProductsCollapsed = StrReplace(RequestTextTTProductsCollapsed, "DocumentData", SynonymForDocumentTS);
	
	TemporaryTableQueryTexts_ = New Structure;
	TemporaryTableQueryTexts_.Insert("TTGoodsRolledToArrangeShipmentToRetail", RequestTextTTProductsCollapsed);
	
	If IsBlankString(TSSeriesName) Then
		
		QueryTextTemplate2 = 
		// Write-off of goods from the warehouse (cash expense).
		"SELECT
		|	&RecordTypeExpense				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Period			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Premise		AS Premise,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	DocumentData.Series			AS Series,
		|	DocumentData.Count		AS InStock,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN(6, 8, 10, 14)
		|			THEN TRUE
		|		ELSE FALSE
		|	END							AS ToControlBalance
		|FROM
		|	TTGoodsRolledToArrangeShipmentToRetail AS DocumentData
		|
		|WHERE
		|	&ThisIsAProduct
		|	AND DocumentData.Count <> 0
		|	AND NOT DocumentData.GoodsReturn
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		// The receipt of goods to the warehouse (arrival by "cash").
		|SELECT
		|	&RecordTypeReceipt				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Period			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Premise		AS Premise,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	DocumentData.Series			AS Series,
		|	DocumentData.Count		AS InStock,
		|	FALSE							AS ToControlBalance
		|FROM
		|	TTGoodsRolledToArrangeShipmentToRetail AS DocumentData
		|
		|WHERE
		|	&ThisIsAProduct
		|	AND DocumentData.Count <> 0
		|	AND DocumentData.GoodsReturn
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))";
		
	Else
		
		QueryTextTemplate2 = 
		// Write-off of goods from the warehouse (cash expense).
		"SELECT
		|	&RecordTypeExpense				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Period			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Premise		AS Premise,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	DocumentData.Series			AS Series,
		|	DocumentData.Count		AS InStock,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN(10, 14)
		|			THEN TRUE
		|		ELSE FALSE
		|	END							AS ToControlBalance
		|FROM
		|	TTGoodsRolledToArrangeShipmentToRetail AS DocumentData
		|
		|WHERE
		|	&ThisIsAProduct
		|	AND DocumentData.Count <> 0
		|	AND NOT DocumentData.GoodsReturn
		|	AND (NOT DocumentData.BatchesIndicationStatus IN(4, 6, 8)
		|		OR DocumentData.Series <> VALUE(Catalog.ItemsBatches.EmptyRef))
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		|SELECT
		|	&RecordTypeExpense				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Period			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Premise		AS Premise,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	SeriesData_.Series				AS Series,
		|	SUM(SeriesData_.Count)	AS InStock,
		|	CASE
		|		WHEN MAX(DocumentData.BatchesIndicationStatus) IN(6, 8)
		|			THEN TRUE
		|		ELSE FALSE
		|	END							AS ToControlBalance
		|FROM
		|	TTGoodsRolledToArrangeShipmentToRetail AS DocumentData
		|		INNER JOIN &TSSeriesName AS SeriesData_
		|		ON DocumentData.Ref = SeriesData_.Ref
		|			AND &ConditionForJoiningTables
		|
		|WHERE
		|	&ThisIsAProduct
		|	AND NOT DocumentData.GoodsReturn
		|	AND SeriesData_.Count <> 0
		|	AND DocumentData.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|GROUP BY
		|	DocumentData.Ref,
		|	DocumentData.Period,
		|	DocumentData.Warehouse,
		|	DocumentData.Premise,
		|	DocumentData.Products,
		|	DocumentData.Characteristic,
		|	SeriesData_.Series
		|
		|HAVING
		|	MAX(DocumentData.BatchesIndicationStatus) IN(4, 6, 8)
		|
		|UNION ALL
		|
		// The receipt of goods to the warehouse (arrival by "cash").
		|SELECT
		|	&RecordTypeReceipt				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Period			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Premise		AS Premise,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	DocumentData.Series			AS Series,
		|	DocumentData.Count		AS InStock,
		|	FALSE							AS ToControlBalance
		|FROM
		|	TTGoodsRolledToArrangeShipmentToRetail AS DocumentData
		|
		|WHERE
		|	&ThisIsAProduct
		|	AND DocumentData.GoodsReturn
		|	AND DocumentData.Count <> 0
		|	AND (NOT DocumentData.BatchesIndicationStatus IN(4, 6, 8, 10)
		|		OR DocumentData.Series <> VALUE(Catalog.ItemsBatches.EmptyRef))
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		|SELECT
		|	&RecordTypeReceipt				AS RecordType,
		|	DocumentData.Ref			AS Recorder,
		|	DocumentData.Period			AS Period,
		|	DocumentData.Warehouse			AS Warehouse,
		|	DocumentData.Premise		AS Premise,
		|	DocumentData.Products	AS Products,
		|	DocumentData.Characteristic	AS Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	SeriesData_.Series				AS Series,
		|	SUM(SeriesData_.Count)	AS InStock,
		|	FALSE							AS ToControlBalance
		|FROM
		|	TTGoodsRolledToArrangeShipmentToRetail AS DocumentData
		|		INNER JOIN &TSSeriesName AS SeriesData_
		|		ON DocumentData.Ref = SeriesData_.Ref
		|			AND &ConditionForJoiningTables
		|
		|WHERE
		|	&ThisIsAProduct
		|	AND DocumentData.GoodsReturn
		|	AND SeriesData_.Count <> 0
		|	AND DocumentData.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|GROUP BY
		|	DocumentData.Ref,
		|	DocumentData.Period,
		|	DocumentData.Warehouse,
		|	DocumentData.Premise,
		|	DocumentData.Products,
		|	DocumentData.Characteristic,
		|	SeriesData_.Series
		|
		|HAVING
		|	MAX(DocumentData.BatchesIndicationStatus) IN(4, 6, 8, 10)";
		
		ConnectionCondition = StchSeriesConnectionCondition(MetadataObject, TSSeriesName);
		
		QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "&ConditionForJoiningTables", ConnectionCondition);
		QueryTextTemplate2 = StrReplace(QueryTextTemplate2,
							"&TSSeriesName",
							MetadataObject.FullName() + "." + TSSeriesName);
		
	EndIf;
	
	FillInRequestTextParameters(QueryTextTemplate2, QueryOptions);
	
	QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "DocumentData", SynonymForDocumentTS);
	
	ReflectionTemplateTexts = New Structure;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("ProductStock", Registers) Then
		ReflectionTemplateTexts.Insert("ProductStock", QueryTextTemplate2);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure(SynonymForDocumentTS, TextOfDocumentDataRequest);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests,
															TemporaryTableQueryTexts_);
	
EndProcedure

// Supplements the texts of the document request with texts that reflect the facts of actual shipment of goods from the warehouse,
// planning the selection and write-off of goods from storage cells, as well as recording unloaded goods in the shipping zone in address storage warehouses.
// The operation generates movements in the registers of accumulation of goods in the Shipment, goods in the Warehouse, goods in the Collection and goods in the Cells.
//
// Parameters:
//	Query						- Query			- request to reflect the document in accounting.
//	QueryTexts				- ValueList	- collection of request texts for document reflection in accounting.
//	Registers					- Structure, String, Undefined - a collection of registers to reflect the document in accounting.
//	TextOfDocumentDataRequest	- String			- the text of the document data request.
//		Composition of selection fields:
//			* Ref				- DocumentRef								- link of the Registrar document.
//			* Period				- Date											- date when the operation was reflected.
//			* OrderDocument					- DocumentRef,
//										Undefined - link to the order document.
//																						If the field is empty, you must specify the default value.
//																						The default value is "UNDEFINED".
//			* TransportationJob	- DocumentRef.TransportationJob,
//										Undefined - a transportation task that is used for shipment of goods.
//																						The default value is "VALUE(Document.Sadanandanagar.Empty link)".
//			* Recipient			- DefinedType.SenderRecipientOfGoods
//										Undefined - recipient of the goods being shipped.
//																						The default value is "UNDEFINED".
//			* Warehouse					- CatalogRef.Warehouses						- the warehouse from which the goods are shipped.
//			* Premise				- CatalogRef.Warerooms			- warehouse from which goods are shipped.
//																						The default value is "VALUE(Guide.Storage facilities.Empty link)".
//			* Cell				- CatalogRef.StorageBins				- area for shipping goods from the warehouse.
//																						The default value is "VALUE(Guide.Storage cells.Empty link)".
//			* Products			- CatalogRef.Products					- the product being shipped.
//			* Characteristic		- CatalogRef.ItemsCharacteristics	- characteristics of the product being shipped.
//			* Purpose			- CatalogRef.Assignments					- the purpose for which the product is shipped.
//			* ControlledLotReference  - CatalogRef.ControlledLots, Undefined - the controlled Lot reference, the item of which is being shipped.
//			* Package				- CatalogRef.PackagesAndUnitsOfMeasure		- packaging of the product being shipped.
//			* Series					- CatalogRef.ItemsBatches			- a series of goods to be shipped.
//			* BatchesIndicationStatus	- Number											- the status of the series indication.
//			* Count			- Number											- quantity of the product to be shipped.
//			* NumberOfPackages	- Number											- the number of packages of the product being shipped.
//			* Action				- EnumRef.ActionsWithGoodsIssueNoteRows
//																					- the action to be performed with the product.
//																						The default value is "VALUE(Enumeration.Actionsbuildingorder loading.Empty link)".
//			* ForAssembly				- Boolean										- True - indicates that the document is ready to be assembled.
//			* AssemblyInProgress			- Boolean										- True - indicates that the document is used for assembling products.
//			* Assembled				- Boolean										- True - indicates that the document contains the goods being shipped.
//			* ToShip				- Boolean										- True - indicates that the document was used for shipment of goods.
//	ToControlBalance	- Undefined, Boolean - if True, the control will be performed when the Ship action is in the final Status.
//
Procedure ShipGoodsFromWarehouse_(Query, QueryTexts, Registers, TextOfDocumentDataRequest, ToControlBalance = Undefined) Export
	
	QueryTextShippedGoods = DataRequestTextShippedProducts("TTShippedGoods");
	
	TemplateForGoodsForShipmentRequestText = 
	// Planning the assembly of goods in the warehouse (arrival by "KSborka").
	"SELECT
	|	&RecordTypeReceipt						AS RecordType,
	|	DocumentData.Ref					AS Recorder,
	|	DocumentData.Period					AS Period,
	|	DocumentData.Warehouse					AS Warehouse,
	|	DocumentData.Recipient				AS Recipient,
	|	&DocumentShipments						AS DocumentShipments,
	|	DocumentData.TransportationJob		AS TransportationJob,
	|	DocumentData.Products			AS Products,
	|	DocumentData.Characteristic			AS Characteristic,
	|	DocumentData.Purpose				AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series									AS Series,
	|	DocumentData.Count				AS ForAssembly,
	|	0										AS AssemblyInProgress,
	|	0										AS Assembled,
	|	0										AS ToShip
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.ForAssembly
	|	AND &DocumentShipments <> UNDEFINED
	|
	|UNION ALL
	|
	// Assembly of goods in the warehouse (arrival by "Going").
	|SELECT
	|	&RecordTypeReceipt						AS RecordType,
	|	DocumentData.Ref					AS Recorder,
	|	DocumentData.Period					AS Period,
	|	DocumentData.Warehouse					AS Warehouse,
	|	DocumentData.Recipient				AS Recipient,
	|	&DocumentShipments						AS DocumentShipments,
	|	DocumentData.TransportationJob		AS TransportationJob,
	|	DocumentData.Products			AS Products,
	|	DocumentData.Characteristic			AS Characteristic,
	|	DocumentData.Purpose				AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series									AS Series,
	|	0										AS ForAssembly,
	|	DocumentData.Count				AS AssemblyInProgress,
	|	0										AS Assembled,
	|	0										AS ToShip
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.AssemblyInProgress
	|	AND &DocumentShipments <> UNDEFINED
	|
	|UNION ALL
	|
	// Inspection of the collected goods before shipment from the warehouse (expense for "Collected").
	|SELECT
	|	&RecordTypeReceipt						AS RecordType,
	|	DocumentData.Ref					AS Recorder,
	|	DocumentData.Period					AS Period,
	|	DocumentData.Warehouse					AS Warehouse,
	|	DocumentData.Recipient				AS Recipient,
	|	&DocumentShipments						AS DocumentShipments,
	|	DocumentData.TransportationJob		AS TransportationJob,
	|	DocumentData.Products			AS Products,
	|	DocumentData.Characteristic			AS Characteristic,
	|	DocumentData.Purpose				AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series									AS Series,
	|	0										AS ForAssembly,
	|	0										AS AssemblyInProgress,
	|	DocumentData.Count				AS Assembled,
	|	0										AS ToShip
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.Assembled
	|	AND &DocumentShipments <> UNDEFINED
	|
	|UNION ALL
	|
	// Shipment of goods from the warehouse (the expense of "COtgruzke").
	|SELECT
	|	&RecordTypeExpense						AS RecordType,
	|	DocumentData.Ref					AS Recorder,
	|	DocumentData.Period					AS Period,
	|	DocumentData.Warehouse					AS Warehouse,
	|	DocumentData.Recipient				AS Recipient,
	|	&DocumentShipments						AS DocumentShipments,
	|	DocumentData.TransportationJob		AS TransportationJob,
	|	DocumentData.Products			AS Products,
	|	DocumentData.Characteristic			AS Characteristic,
	|	DocumentData.Purpose				AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series									AS Series,
	|	0										AS ForAssembly,
	|	0										AS AssemblyInProgress,
	|	0										AS Assembled,
	|	DocumentData.Count				AS ToShip
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.ToShip
	|	AND &DocumentShipments <> UNDEFINED";
	
	ToControlBalanceOverridable = ?(ToControlBalance = True, "TRUE", "FALSE");
	RequestTextTemplateForProductsInWarehouses = 
	// Write-off of goods from the warehouse (cash expense).
	"SELECT
	|	&RecordTypeExpense						AS RecordType,
	|	ProductStock.Ref					AS Recorder,
	|	ProductStock.Period					AS Period,
	|	ProductStock.Products			AS Products,
	|	ProductStock.Characteristic			AS Characteristic,
	|	ProductStock.Purpose				AS Purpose,
	|	ProductStock.ControlledLotReference 	AS ControlledLotReference,
	|	CASE
	|		WHEN ProductStock.BatchesIndicationStatus IN(4, 6, 8, 10, 14)
	|			THEN ProductStock.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END									AS Series,
	|	ProductStock.Warehouse					AS Warehouse,
	|	ProductStock.Premise				AS Premise,
	|	ProductStock.Count				AS InStock,
	|	0										AS ToShip,
	|	&ToControlBalanceOverridable	AS ToControlBalance
	|FROM
	|	TTShippedGoods AS ProductStock
	|
	|WHERE
	|	ProductStock.ThisIsAProduct
	|	AND ProductStock.ToShip
	|	AND ProductStock.Action = VALUE(Enum.ActionsWithGoodsIssueNoteRows.Ship)
	|	AND ProductStock.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			 VALUE(Enum.ItemsTypes.ReusablePackage))
	|
	|UNION ALL
	|
	// Preparation of goods for shipment from the warehouse (arrival by "COtgruzke").
	|SELECT
	|	&RecordTypeReceipt						AS RecordType,
	|	ProductStock.Ref					AS Recorder,
	|	ProductStock.Period					AS Period,
	|	ProductStock.Products			AS Products,
	|	ProductStock.Characteristic			AS Characteristic,
	|	ProductStock.Purpose				AS Purpose,
	|	ProductStock.ControlledLotReference 	AS ControlledLotReference,
	|	CASE
	|		WHEN ProductStock.BatchesIndicationStatus IN(6, 8, 10, 14)
	|			THEN ProductStock.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END									AS Series,
	|	ProductStock.Warehouse					AS Warehouse,
	|	ProductStock.Premise				AS Premise,
	|	0										AS InStock,
	|	ProductStock.Count				AS ToShip,
	|	TRUE									AS ToControlBalance
	|FROM
	|	TTShippedGoods AS ProductStock
	|
	|WHERE
	|	ProductStock.ThisIsAProduct
	|	AND NOT ProductStock.ToShip
	|	AND ProductStock.Action IN(VALUE(Enum.ActionsWithGoodsIssueNoteRows.Pick),
	|								VALUE(Enum.ActionsWithGoodsIssueNoteRows.Ship))
	|	AND ProductStock.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			 VALUE(Enum.ItemsTypes.ReusablePackage))";
	RequestTextTemplateForProductsInWarehouses = StrReplace(
		RequestTextTemplateForProductsInWarehouses,
		"&ToControlBalanceOverridable",
		ToControlBalanceOverridable);
	
	TemplateForProductsForSelectionQueryText = 
	// Write-off of selected goods from a warehouse using address storage (expense for "Selected").
	"SELECT
	|	&RecordTypeExpense				AS RecordType,
	|	DocumentData.Ref			AS Recorder,
	|	DocumentData.Period			AS Period,
	|	DocumentData.Ref			AS ReferenceOrder,
	|	DocumentData.Products	AS Products,
	|	DocumentData.Characteristic	AS Characteristic,
	|	DocumentData.Purpose		AS Purpose,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN(6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END							AS Series,
	|	&CargoItem					AS CargoItem,
	|	0								AS ForPicking,
	|	CASE
	|		WHEN &PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|			THEN DocumentData.NumberOfPackages
	|		ELSE DocumentData.Count
	|	END							AS Picked
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND &UseBinLocationWarehousing
	|	AND DocumentData.Action = VALUE(Enum.ActionsWithGoodsIssueNoteRows.Ship)
	|
	|UNION ALL
	|
	// Registration of the selection of goods from a warehouse using address storage (arrival by "Kotbor").
	|SELECT
	|	&RecordTypeReceipt				AS RecordType,
	|	GoodsForPicking.Ref			AS Recorder,
	|	GoodsForPicking.Period			AS Period,
	|	GoodsForPicking.Ref			AS ReferenceOrder,
	|	GoodsForPicking.Products		AS Products,
	|	GoodsForPicking.Characteristic	AS Characteristic,
	|	GoodsForPicking.Purpose		AS Purpose,
	|	CASE
	|		WHEN GoodsForPicking.BatchesIndicationStatus IN(6, 8, 10, 14)
	|			THEN GoodsForPicking.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END							AS Series,
	|	&DefaultPackaging			AS CargoItem,
	|	GoodsForPicking.Count		AS ForPicking,
	|	0								AS Picked
	|FROM
	|	TTShippedGoods AS GoodsForPicking
	|
	|WHERE
	|	GoodsForPicking.ThisIsAProduct
	|	AND GoodsForPicking.UseBinLocationWarehousing
	|	AND NOT GoodsForPicking.ForAssembly
	|	AND GoodsForPicking.Action = VALUE(Enum.ActionsWithGoodsIssueNoteRows.Pick)
	|
	|UNION ALL
	|
	// Receipt of unloaded goods from a warehouse using address storage (arrival by "Selected").
	|SELECT
	|	&RecordTypeReceipt				AS RecordType,
	|	DocumentData.Ref			AS Recorder,
	|	DocumentData.Period			AS Period,
	|	DocumentData.Ref			AS ReferenceOrder,
	|	DocumentData.Products	AS Products,
	|	DocumentData.Characteristic	AS Characteristic,
	|	DocumentData.Purpose		AS Purpose,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN(6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END							AS Series,
	|	&CargoItem					AS CargoItem,
	|	0								AS ForPicking,
	|	CASE
	|		WHEN &PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|			THEN -DocumentData.NumberOfPackages
	|		ELSE -DocumentData.Count
	|	END							AS Picked
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND &UseBinLocationWarehousing
	|	AND DocumentData.Action = VALUE(Enum.ActionsWithGoodsIssueNoteRows.DoNotShip)";
	
	QueryTextTemplateProductsInCells = 
	// Receipt of unloaded goods from a warehouse using address storage to the receiving area
	// (arrival by "cash").
	"SELECT
	|	&RecordTypeReceipt AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Period AS Period,
	|	DocumentData.Cell AS Cell,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	DocumentData.Purpose AS Purpose,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	CASE
	|		WHEN &MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
	|			THEN DocumentData.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS Package,
	|	CASE
	|		WHEN &MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
	|			THEN DocumentData.NumberOfPackages
	|		ELSE DocumentData.Count
	|	END AS InStock,
	|	0 AS ForPlacement
	|FROM
	|	#DocumentData AS DocumentData
	|WHERE
	|	&ThisIsAProduct
	|	AND &UseBinLocationWarehousing
	|	AND DocumentData.Action = VALUE(Enum.ActionsWithGoodsIssueNoteRows.DoNotShip)
	|	AND CAST(DocumentData.Cell AS
	|		Catalog.StorageBins).StorageBinType = VALUE(Enum.TypesOfStorageCells.Shipment)
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Period AS Period,
	|	DocumentData.Cell AS Cell,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	DocumentData.Purpose AS Purpose,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	CASE
	|		WHEN &MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
	|			THEN DocumentData.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS Package,
	|	CASE
	|		WHEN &MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
	|			THEN DocumentData.NumberOfPackages
	|		ELSE DocumentData.Count
	|	END AS InStock,
	|	0 AS ForPlacement
	|FROM
	|	#DocumentData AS DocumentData
	|WHERE
	|	&ThisIsAProduct
	|	AND &UseBinLocationWarehousing
	|	AND DocumentData.ToShip
	|	AND DocumentData.Action = VALUE(Enum.ActionsWithGoodsIssueNoteRows.Ship)
	|	AND CAST(DocumentData.Cell AS
	|		Catalog.StorageBins).StorageBinType = VALUE(Enum.TypesOfStorageCells.ShipmentIncludingBalances)";
	
	QueryOptions = ParametersOfDocumentDataRequestText("ShipGoodsFromWarehouse_");
	FillInRequestTextParameters(QueryTextShippedGoods,		QueryOptions);
	FillInRequestTextParameters(TemplateForGoodsForShipmentRequestText,	QueryOptions);
	FillInRequestTextParameters(RequestTextTemplateForProductsInWarehouses,	QueryOptions);
	FillInRequestTextParameters(TemplateForProductsForSelectionQueryText,	QueryOptions);
	FillInRequestTextParameters(QueryTextTemplateProductsInCells,	QueryOptions);
	
	TemplateForProductsForSelectionQueryText = StrReplace(TemplateForProductsForSelectionQueryText,
													"&DefaultPackaging",
													"VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)");
	
	ReflectionTemplateTexts = New Structure;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForIssue", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForIssue", TemplateForGoodsForShipmentRequestText);
	EndIf;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("ProductStock", Registers) Then
		ReflectionTemplateTexts.Insert("ProductStock", RequestTextTemplateForProductsInWarehouses);
	EndIf;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForPicking", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForPicking", TemplateForProductsForSelectionQueryText);
	EndIf;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsInStorageBins", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsInStorageBins", QueryTextTemplateProductsInCells);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure("DocumentData",		TextOfDocumentDataRequest);
	TemporaryTableQueryTexts_ = New Structure("TTShippedGoods",	QueryTextShippedGoods);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests,
															TemporaryTableQueryTexts_);
	
EndProcedure

