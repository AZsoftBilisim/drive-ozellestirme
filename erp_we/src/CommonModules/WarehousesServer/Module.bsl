						|en = 'Jobs are not generated (cannot generate or transfer is not required).'; fa = 'Jobs are not generated (cannot generate or transfer is not required).';
						|it = 'Task non generati (impossibile generare o il trasferimento non è richiesto).';
						|pl = 'Zadania nie zostały utworzone (nie udało się utworzyć lub przemieszczenie nie jest wymagane).';
						|tr = 'Görevler oluşturulmadı (oluşturulamadı veya transfer gerekli değil).'", 
			CommonClientServer.DefaultLanguageCode());
		
		WriteLogEvent(
			NStr("vi = 'Tự động tạo nhiệm vụ điều chuyển';
				|ru = 'Автоматическое создание заданий на перемещение';
				|en = 'Automatic creation of transfer jobs'; fa = 'Automatic creation of transfer jobs';
				|it = 'Creazione automatica di task per il trasferimento';
				|pl = 'Automatyczne tworzenie zadań do przeniesienia';
