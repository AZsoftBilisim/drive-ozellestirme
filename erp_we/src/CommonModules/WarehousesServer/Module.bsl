EndFunction

// Fills orders with products selected from the cells
//
// Parameters:
//  FillParameters	 - See ParametersForFillingOrdersWithSelectedGoods
//  Modified	 - Boolean	 - required if called from a document form. True if the document's PM was re-filled.
// 
// Returns:
//  Array - (Document link) - documents modified by the procedure.
//
Function FillOrders_WithSelectedProducts(FillParameters, Modified = False) Export
	
	ArrayOfChangedDocuments = New Array;
	
	If FillParameters.FillMode <> "Plural_" Then	
		FillParameters.DocumentsArray = New Array;
		FillParameters.DocumentsArray.Add(FillParameters.DocumentObject.Ref);
	EndIf;
	
	MarkedProductsAreUsed = WarehousesLocalization.MarkedProductsAreUsed();
	
	// We check that the conditions for re-filling are met
	// We calculate the number of containers specified in the orders. If there are fewer containers in the orders, it means that it needs
	// to be added to the document as unloaded
	// We take everything that is selected according to the tasks, subtract the surpluses and shortages identified during the check, subtract the lines that
	// are marked in the order as "Ship" or "Do not ship" - we will not fill them in. Ideally, after that
	// , only what needs to be transferred to the order will remain instead of the "Select" order lines. But there is a problem - in the lines "To ship" and
	// "Not to Ship" could change the packaging. If this was done in the processing of the check, there will be a reversal document
	// "Reflection of the results of the check", but if it is simply changed in the document, there will be a discrepancy. The packages that
	// were indicated in the orders will be with a minus, while there will be more selected packages. In a simple case (i.e., when
	// the wrong goods are re-selected, in which the packaging was changed in this way), the lines with discrepancies will coincide in terms of quantity in
	// basic units - such terms simply need to be excluded. In a more complex case, re-filling the order will not work.
	
	QueryText =
	"SELECT
	|	NestedQuery.ReferenceOrder AS ReferenceOrder,
	|	MAX(NestedQuery.ThereAreOutstandingTasks) AS ThereAreOutstandingTasks,
	|	MAX(NestedQuery.NotAllSelected) AS NotAllSelected,
	|	MIN(NestedQuery.NoSelected) AS NoSelected
	|INTO Errors
	|FROM
	|	(SELECT
	|		GoodsForPickingBalance.ReferenceOrder AS ReferenceOrder,
	|		GoodsForPickingBalance.Products AS Products,
	|		GoodsForPickingBalance.Characteristic AS Characteristic,
	|		GoodsForPickingBalance.Purpose AS Purpose,
	|		GoodsForPickingBalance.Series AS Series,
	|		CASE
	|			WHEN GoodsForPickingBalance.BeingPickedBalance <> 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS ThereAreOutstandingTasks,
	|		CASE
	|			WHEN GoodsForPickingBalance.ForPickingBalance > GoodsForPickingBalance.PickedBalance
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NotAllSelected,
	|		CASE
	|			WHEN GoodsForPickingBalance.PickedBalance = 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS NoSelected
	|	FROM
	|		AccumulationRegister.GoodsForPicking.Balance(, ReferenceOrder IN (&DocumentsArray)) AS GoodsForPickingBalance
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		GoodsForPicking.Recorder,
	|		NULL,
	|		NULL,
	|		NULL,
	|		NULL,
	|		FALSE,
	|		FALSE,
	|		MIN(CASE
	|				WHEN GoodsForPicking.RecordType = VALUE(AccumulationRecordType.Expense)
	|						AND GoodsForPicking.Picked > 0
	|					THEN FALSE
	|				ELSE TRUE
	|			END)
	|	FROM
	|		AccumulationRegister.GoodsForPicking AS GoodsForPicking
	|	WHERE
	|		GoodsForPicking.Recorder IN(&DocumentsArray)
	|	
	|	GROUP BY
	|		GoodsForPicking.Recorder) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.ReferenceOrder
	|
	|HAVING
	|	(MAX(NestedQuery.ThereAreOutstandingTasks) = TRUE
	|		OR &StatusChange
	|			AND MAX(NestedQuery.NotAllSelected) = TRUE
	|		OR MIN(NestedQuery.NoSelected) = TRUE)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Errors.ReferenceOrder AS ReferenceOrder,
	|	Errors.ThereAreOutstandingTasks AS ThereAreOutstandingTasks,
	|	Errors.NotAllSelected AS NotAllSelected,
	|	Errors.NoSelected AS NoSelected
	|FROM
	|	Errors AS Errors
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.Ref AS Ref
	|INTO References
	|FROM
	|	(SELECT
	|		GoodsIssueNote.Ref AS Ref
	|	FROM
	|		Document.GoodsIssueNote AS GoodsIssueNote
	|	WHERE
	|		GoodsIssueNote.Ref IN(&DocumentsArray)
	|	
	|	GROUP BY
	|		GoodsIssueNote.Ref
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		GoodsTransferNote.Ref
	|	FROM
	|		Document.GoodsTransferNote AS GoodsTransferNote
	|	WHERE
	|		GoodsTransferNote.Ref IN(&DocumentsArray)) AS NestedQuery
	|		LEFT JOIN Errors AS Errors
	|		ON NestedQuery.Ref = Errors.ReferenceOrder
	|WHERE
	|	Errors.ReferenceOrder IS NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TaraByOrder.Ref AS ExpenseOrder,
	|	TaraByOrder.Products AS Products,
	|	TaraByOrder.Characteristic AS Characteristic,
	|	SUM(TaraByOrder.Count) AS Count
	|INTO TaraByOrder
	|FROM
	|	Document.GoodsIssueNote.GoodsByReferences AS TaraByOrder
	|WHERE
	|	TaraByOrder.Ref IN
	|			(SELECT
	|				References.Ref
	|			FROM
	|				References)
	|	AND TaraByOrder.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|
	|GROUP BY
	|	TaraByOrder.Products,
	|	TaraByOrder.Characteristic,
	|	TaraByOrder.Ref
	|
	|UNION ALL
	|
	|SELECT
	|	TaraByOrder.Ref,
	|	TaraByOrder.Products,
	|	TaraByOrder.Characteristic,
	|	SUM(TaraByOrder.Count)
	|FROM
	|	Document.GoodsTransferNote.ShippedGoods AS TaraByOrder
	|WHERE
	|	TaraByOrder.Ref IN
	|			(SELECT
	|				References.Ref
	|			FROM
	|				References)
	|	AND TaraByOrder.Products.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|
	|GROUP BY
	|	TaraByOrder.Products,
	|	TaraByOrder.Characteristic,
	|	TaraByOrder.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.Filter AS Filter,
	|	NestedQuery.Products AS Products,
	|	NestedQuery.Products.ItemsType AS ItemsType,
	|	NestedQuery.Characteristic AS Characteristic,
	|	NestedQuery.Purpose AS Purpose,
	|	NestedQuery.Package AS Package,
	|	NestedQuery.Series AS Series,
	|	SUM(NestedQuery.Count) AS Count,
	|	SUM(NestedQuery.NumberOfPackages) AS NumberOfPackages,
	|	NestedQuery.ReferenceOrder AS ReferenceOrder
	|INTO TDProductsWithPackagingDiscrepancies
	|FROM
	|	(SELECT
	|		GoodsFilter.Ref AS Filter,
	|		GoodsFilter.Products AS Products,
	|		GoodsFilter.Characteristic AS Characteristic,
	|		GoodsFilter.Purpose AS Purpose,
	|		GoodsFilter.Package AS Package,
	|		GoodsFilter.Series AS Series,
	|		GoodsFilter.CountPicked AS Count,
	|		GoodsFilter.NumberOfPackagesPicked AS NumberOfPackages,
	|		GoodsFilter.Ref.ReferenceOrder AS ReferenceOrder
	|	FROM
	|		Document.GoodsPickingPlacement.GoodsFilter AS GoodsFilter
	|	WHERE
	|		GoodsFilter.Ref.Posted
	|		AND GoodsFilter.Ref.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Filter)
	|		AND GoodsFilter.Ref.ReferenceOrder IN
	|				(SELECT
	|					References.Ref
	|				FROM
	|					References)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		NULL,
	|		SurplusesShortages.Products,
	|		SurplusesShortages.Characteristic,
	|		SurplusesShortages.Purpose,
	|		SurplusesShortages.Package,
	|		SurplusesShortages.Series,
	|		CASE
	|			WHEN SurplusesShortages.OperationKind = VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.RecordShortage)
	|				THEN -SurplusesShortages.Count
	|			ELSE SurplusesShortages.Count
	|		END,
	|		CASE
	|			WHEN SurplusesShortages.OperationKind = VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.RecordShortage)
	|				THEN -SurplusesShortages.NumberOfPackages
	|			ELSE SurplusesShortages.NumberOfPackages
	|		END,
	|		SurplusesShortages.Ref.WarehouseDocument
	|	FROM
	|		Document.InventoryAdjustmentGoodsShipmentOrder.Goods AS SurplusesShortages
	|	WHERE
	|		SurplusesShortages.Ref.Posted
	|		AND SurplusesShortages.Ref.WarehouseDocument IN
	|				(SELECT
	|					References.Ref
	|				FROM
	|					References)
	|		AND (SurplusesShortages.OperationKind = VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.RecordShortage)
	|				OR SurplusesShortages.OperationKind = VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.RecordSurplus))
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		NULL,
	|		SurplusesShortages.Products,
	|		SurplusesShortages.Characteristic,
	|		SurplusesShortages.Purpose,
	|		SurplusesShortages.Package,
	|		SurplusesShortages.Series,
	|		-SurplusesShortages.Count,
	|		-SurplusesShortages.NumberOfPackages,
	|		SurplusesShortages.Ref.WarehouseDocument
	|	FROM
	|		Document.InventoryAdjustmentGoodsShipmentOrder.Goods AS SurplusesShortages
	|	WHERE
	|		SurplusesShortages.Ref.Posted
	|		AND SurplusesShortages.Ref.WarehouseDocument IN
	|				(SELECT
	|					References.Ref
	|				FROM
	|					References)
	|		AND SurplusesShortages.OperationKind = VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.MoveToOtherNote)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		NULL,
	|		SurplusesShortages.Products,
	|		SurplusesShortages.Characteristic,
	|		SurplusesShortages.Purpose,
	|		SurplusesShortages.Package,
	|		SurplusesShortages.Series,
	|		SurplusesShortages.Count,
	|		SurplusesShortages.NumberOfPackages,
	|		SurplusesShortages.Ref.RecipientNote
	|	FROM
	|		Document.InventoryAdjustmentGoodsShipmentOrder.Goods AS SurplusesShortages
	|	WHERE
	|		SurplusesShortages.Ref.Posted
	|		AND SurplusesShortages.Ref.RecipientNote IN
	|				(SELECT
	|					References.Ref
	|				FROM
	|					References)
	|		AND SurplusesShortages.OperationKind = VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.MoveToOtherNote)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		NULL,
	|		SpendingOrderGoods.Products,
	|		SpendingOrderGoods.Characteristic,
	|		SpendingOrderGoods.Purpose,
	|		SpendingOrderGoods.Package,
	|		CASE
	|			WHEN SpendingOrderGoods.BatchesIndicationStatus IN (1, 2)
	|				THEN VALUE(Catalog.ItemsBatches.EmptyRef)
	|			ELSE SpendingOrderGoods.Series
	|		END,
	|		-SpendingOrderGoods.Count,
	|		-SpendingOrderGoods.NumberOfPackages,
	|		SpendingOrderGoods.Ref
	|	FROM
	|		Document.GoodsIssueNote.ShippedGoods AS SpendingOrderGoods
	|	WHERE
	|		SpendingOrderGoods.Ref IN
	|				(SELECT
	|					References.Ref
	|				FROM
	|					References)
	|		AND SpendingOrderGoods.Action IN (VALUE(Enum.ActionsWithGoodsIssueNoteRows.Ship), VALUE(Enum.ActionsWithGoodsIssueNoteRows.DoNotShip))
	|		AND NOT SpendingOrderGoods.ThisIsAPackingList
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		NULL,
	|		OrderToMoveGoods_.Products,
	|		OrderToMoveGoods_.Characteristic,
	|		OrderToMoveGoods_.Purpose,
	|		OrderToMoveGoods_.Package,
	|		CASE
	|			WHEN OrderToMoveGoods_.BatchesIndicationStatus IN (1, 2)
	|				THEN VALUE(Catalog.ItemsBatches.EmptyRef)
	|			ELSE OrderToMoveGoods_.Series
	|		END,
	|		-OrderToMoveGoods_.Count,
	|		-OrderToMoveGoods_.NumberOfPackages,
	|		OrderToMoveGoods_.Ref
	|	FROM
	|		Document.GoodsTransferNote.ShippedGoods AS OrderToMoveGoods_
	|	WHERE
	|		OrderToMoveGoods_.Ref IN
	|				(SELECT
	|					References.Ref
	|				FROM
	|					References)
	|		AND OrderToMoveGoods_.Action IN (VALUE(Enum.ActionsWithGoodsIssueNoteRows.Ship), VALUE(Enum.ActionsWithGoodsIssueNoteRows.DoNotShip))) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.Series,
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Purpose,
	|	NestedQuery.Package,
	|	NestedQuery.ReferenceOrder,
	|	NestedQuery.Products.ItemsType,
	|	NestedQuery.Filter
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsWithPackagingDiscrepancies.Products AS Products,
	|	ProductsWithPackagingDiscrepancies.ItemsType AS ItemsType,
	|	ProductsWithPackagingDiscrepancies.Characteristic AS Characteristic,
	|	ProductsWithPackagingDiscrepancies.Purpose AS Purpose,
	|	ProductsWithPackagingDiscrepancies.Package AS Package,
	|	ProductsWithPackagingDiscrepancies.Series AS Series,
	|	SUM(ProductsWithPackagingDiscrepancies.Count) AS Count,
	|	SUM(ProductsWithPackagingDiscrepancies.NumberOfPackages) AS NumberOfPackages,
	|	ProductsWithPackagingDiscrepancies.ReferenceOrder AS ReferenceOrder
	|INTO ProductsWithPackagingDiscrepancies
	|FROM
	|	TDProductsWithPackagingDiscrepancies AS ProductsWithPackagingDiscrepancies
	|
	|GROUP BY
	|	ProductsWithPackagingDiscrepancies.Package,
	|	ProductsWithPackagingDiscrepancies.Products,
	|	ProductsWithPackagingDiscrepancies.ItemsType,
	|	ProductsWithPackagingDiscrepancies.ReferenceOrder,
	|	ProductsWithPackagingDiscrepancies.Purpose,
	|	ProductsWithPackagingDiscrepancies.Characteristic,
	|	ProductsWithPackagingDiscrepancies.Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DiscrepanciesInPackages.Products AS Products,
	|	DiscrepanciesInPackages.Characteristic AS Characteristic,
	|	DiscrepanciesInPackages.Purpose AS Purpose,
	|	DiscrepanciesInPackages.Series AS Series,
	|	DiscrepanciesInPackages.ReferenceOrder AS ReferenceOrder,
	|	SUM(DiscrepanciesInPackages.Count) AS Count
	|INTO StornoDiscrepanciesOnPackages
	|FROM
	|	(SELECT
	|		ProductsAreInSelection.Products AS Products,
	|		ProductsAreInSelection.Characteristic AS Characteristic,
	|		ProductsAreInSelection.Purpose AS Purpose,
	|		ProductsAreInSelection.Series AS Series,
	|		ProductsAreInSelection.Count AS Count,
	|		ProductsAreInSelection.ReferenceOrder AS ReferenceOrder
	|	FROM
	|		ProductsWithPackagingDiscrepancies AS ProductsAreInSelection
	|	WHERE
	|		ProductsAreInSelection.Count > 0
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ProductsNotInSelection.Products,
	|		ProductsNotInSelection.Characteristic,
	|		ProductsNotInSelection.Purpose,
	|		ProductsNotInSelection.Series,
	|		ProductsNotInSelection.Count,
	|		ProductsNotInSelection.ReferenceOrder
	|	FROM
	|		ProductsWithPackagingDiscrepancies AS ProductsNotInSelection
	|	WHERE
	|		ProductsNotInSelection.Count < 0) AS DiscrepanciesInPackages
	|
	|GROUP BY
	|	DiscrepanciesInPackages.Purpose,
	|	DiscrepanciesInPackages.ReferenceOrder,
	|	DiscrepanciesInPackages.Products,
	|	DiscrepanciesInPackages.Characteristic,
	|	DiscrepanciesInPackages.Series
	|
	|HAVING
	|	SUM(DiscrepanciesInPackages.Count) = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsWithPackagingDiscrepancies.Products AS Products,
	|	ProductsWithPackagingDiscrepancies.ItemsType AS ItemsType,
	|	ProductsWithPackagingDiscrepancies.Characteristic AS Characteristic,
	|	ProductsWithPackagingDiscrepancies.Purpose AS Purpose,
	|	ProductsWithPackagingDiscrepancies.Package AS Package,
	|	ProductsWithPackagingDiscrepancies.Series AS Series,
	|	ProductsWithPackagingDiscrepancies.Count AS Count,
	|	ProductsWithPackagingDiscrepancies.NumberOfPackages AS NumberOfPackages,
	|	ProductsWithPackagingDiscrepancies.ReferenceOrder AS ReferenceOrder
	|INTO SelectionResult_
	|FROM
	|	ProductsWithPackagingDiscrepancies AS ProductsWithPackagingDiscrepancies
	|		LEFT JOIN StornoDiscrepanciesOnPackages AS StornoDiscrepanciesOnPackages
	|		ON ProductsWithPackagingDiscrepancies.Products = StornoDiscrepanciesOnPackages.Products
	|			AND ProductsWithPackagingDiscrepancies.Characteristic = StornoDiscrepanciesOnPackages.Characteristic
	|			AND ProductsWithPackagingDiscrepancies.Purpose = StornoDiscrepanciesOnPackages.Purpose
	|			AND ProductsWithPackagingDiscrepancies.Series = StornoDiscrepanciesOnPackages.Series
	|			AND ProductsWithPackagingDiscrepancies.ReferenceOrder = StornoDiscrepanciesOnPackages.ReferenceOrder
	|WHERE
	|	StornoDiscrepanciesOnPackages.Products IS NULL
	|	AND ProductsWithPackagingDiscrepancies.Count > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SelectionResult_.Products AS Products,
	|	SelectionResult_.ItemsType AS ItemsType,
	|	SelectionResult_.Characteristic AS Characteristic,
	|	SelectionResult_.Purpose AS Purpose,
	|	SelectionResult_.Package AS Package,
	|	SelectionResult_.Series AS Series,
	|	ISNULL(TaraByOrder.Count, 0) AS NumberOfContainersAvailable,
	|	SelectionResult_.Count AS Count,
	|	SelectionResult_.NumberOfPackages AS NumberOfPackages,
	|	SelectionResult_.ReferenceOrder AS ReferenceOrder
	|FROM
	|	SelectionResult_ AS SelectionResult_
	|		LEFT JOIN TaraByOrder AS TaraByOrder
	|		ON SelectionResult_.Products = TaraByOrder.Products
	|			AND SelectionResult_.Characteristic = TaraByOrder.Characteristic
	|			AND SelectionResult_.ReferenceOrder = TaraByOrder.ExpenseOrder
	|		LEFT JOIN Catalog.Products AS CatalogProducts
	|		ON SelectionResult_.Products = CatalogProducts.Ref
	|		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
	|		ON SelectionResult_.Characteristic = ItemsCharacteristics.Ref
	|		LEFT JOIN Catalog.Assignments AS Assignments
	|		ON SelectionResult_.Purpose = Assignments.Ref
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
	|		ON SelectionResult_.Package = ProductPackages.Ref
	|		LEFT JOIN Catalog.ItemsBatches AS ItemsBatches
	|		ON SelectionResult_.Series = ItemsBatches.Ref
	|
	|ORDER BY
	|	ReferenceOrder,
	|	CatalogProducts.ItemsType.Order,
	|	CatalogProducts.Description,
	|	ItemsCharacteristics.Description,
	|	Assignments.Description,
	|	&QueryTextPackagingFactor DESC,
	|	ItemsBatches.ValidUntil_,
	|	ItemsBatches.Number";
	
	If MarkedProductsAreUsed Then
		QueryText = QueryText + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsPickingPlacementPackageBarcodes.Ref AS Filter,
		|	GoodsPickingPlacementPackageBarcodes.PackageBarcode.Products AS Products,
		|	GoodsPickingPlacementPackageBarcodes.PackageBarcode.Characteristic AS Characteristic,
		|	GoodsPickingPlacementPackageBarcodes.PackageBarcode.Series AS Series,
		|	GoodsPickingPlacementPackageBarcodes.PackageBarcode AS PackageBarcode
		|INTO StampsInSelections
		|FROM
		|	Document.GoodsPickingPlacement.PackageBarcodes AS GoodsPickingPlacementPackageBarcodes
		|WHERE
		|	GoodsPickingPlacementPackageBarcodes.Ref IN
		|			(SELECT
		|				TDProductsWithPackagingDiscrepancies.Filter
		|			FROM
		|				TDProductsWithPackagingDiscrepancies)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ProductsWithPackagingDiscrepancies.ReferenceOrder AS ReferenceOrder,
		|	ProductsWithPackagingDiscrepancies.Products AS Products,
		|	ProductsWithPackagingDiscrepancies.Characteristic AS Characteristic,
		|	ProductsWithPackagingDiscrepancies.Series AS Series,
		|	ProductsWithPackagingDiscrepancies.Purpose AS Purpose,
		|	ProductsWithPackagingDiscrepancies.Filter AS Filter,
		|	StampsInSelections.PackageBarcode AS PackageBarcode
		|FROM
		|	TDProductsWithPackagingDiscrepancies AS ProductsWithPackagingDiscrepancies
		|		INNER JOIN StampsInSelections AS StampsInSelections
		|		ON ProductsWithPackagingDiscrepancies.Filter = StampsInSelections.Filter
		|			AND ProductsWithPackagingDiscrepancies.Products = StampsInSelections.Products
		|			AND ProductsWithPackagingDiscrepancies.Characteristic = StampsInSelections.Characteristic
		|			AND ProductsWithPackagingDiscrepancies.Series = StampsInSelections.Series
		|
		|ORDER BY
		|	ReferenceOrder,
		|	Filter,
		|	Products,
		|	Characteristic,
		|	Series,
		|	PackageBarcode";
	EndIf; 
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"ProductPackages", Undefined));
		
	Query = New Query;
	Query.Text = QueryText;

	Query.SetParameter("DocumentsArray", FillParameters.DocumentsArray);
	Query.SetParameter("StatusChange", FillParameters.StatusChange);
	
	QueryResults = Query.ExecuteBatch(); 
	
	ErrorSampling = QueryResults[1].Select();
	
	While ErrorSampling.Next() Do
		
		If FillParameters.StatusChange Then
			If ErrorSampling.ThereAreOutstandingTasks Then
				MessageText = NStr("vi = 'Theo lệnh ""%ReferenceOrder%"" có nhiệm vụ chưa được thực hiện đối với phễu lọc, cho nên không thể chuyển nó sang trạng thái ""%Status%""';
									|ru = 'По распоряжению ""%ReferenceOrder%"" есть невыполненные задания на отбор, поэтому его нельзя перевести в статус ""%Status%""';
									|en = 'There are incomplete picking jobs for the ""%ReferenceOrder%"" reference, that is why its status cannot be changed to ""%Status%""'; fa = 'There are incomplete picking jobs for the ""%ReferenceOrder%"" reference, that is why its status cannot be changed to ""%Status%""';
									|it = 'Esistono i task in sospeso per la selezione in base alla disposizione ""%ReferenceOrder%"" che di conseguenza non può essere trasferita allo stato ""%Status%""';
									|pl = 'W zamówieniu ""%ReferenceOrder%"" są zaległe zlecenia do selekcji, dlatego nie można ich przenieść na status ""%Status%""';
									|tr = '""%ReferenceOrder%"" siparişinin bekleyen filtre görevleri vardır, bu nedenle ""%Status%"" durumuna taşınamaz'");
			ElsIf ErrorSampling.NoSelected Then
				MessageText = NStr("vi = 'Theo lệnh ""%ReferenceOrder%"" không có hàng hóa đã lấy ra, cho nên không thể chuyển nó sang trạng thái ""%Status%""';
									|ru = 'По распоряжению ""%ReferenceOrder%"" нет отобранных товаров, поэтому его нельзя перевести в статус ""%Status%""';
									|en = 'There are no picked goods for the ""%ReferenceOrder%"" reference, that is why it cannot be transferred to the ""%Status%"" status'; fa = 'There are no picked goods for the ""%ReferenceOrder%"" reference, that is why it cannot be transferred to the ""%Status%"" status';
									|it = 'Non ci sono le merci selezionate in base alla disposizione ""%ReferenceOrder%"" che di conseguenza non può essere trasferita allo stato ""%Status%""';
									|pl = 'W zamówieniu ""%ReferenceOrder%"" nie ma wybranych towarów, więc nie można go przenieść na status ""%Status%""';
									|tr = '""%ReferenceOrder%"" siparişi için seçilen ürün yok, bu nedenle ""%Status%"" durumuna aktarılamıyor'");
			Else
				// If it's just a status change, then you can't reduce the amount in the order			
				MessageText = NStr("vi = 'Theo lệnh ""%ReferenceOrder%"" lấy ra không phải tất cả hàng hóa, cho nên không thể chuyển nó sang trạng thái ""%Status%""';
									|ru = 'По распоряжению ""%ReferenceOrder%"" отобраны не все товары, поэтому его нельзя перевести в статус ""%Status%""';
									|en = 'Not all goods are picked for the ""%ReferenceOrder%"" reference, that is why it cannot be transferred to the ""%Status%"" status'; fa = 'Not all goods are picked for the ""%ReferenceOrder%"" reference, that is why it cannot be transferred to the ""%Status%"" status';
									|it = 'Non tutte le merci sono state selezionate in base alla disposizione ""%ReferenceOrder%"" che di conseguenza non può essere trasferita allo stato ""%Status%""';
									|pl = 'W zamówieniu ""%ReferenceOrder%"" nie ma wybranych wszystkich towarów, więc nie można go przenieść na status ""%Status%""';
									|tr = '""%ReferenceOrder%"" siparişi için tüm ürünler seçilmemiştir, bu nedenle ""%Status%"" durumuna aktarılamaz'");
			EndIf;
			
			If TypeOf(FillParameters.DocumentStatus) = Type("String") Then
				If TypeOf(ErrorSampling.ReferenceOrder) = Type("DocumentRef.GoodsIssueNote") Then
					MessageText = StrReplace(MessageText,"%Status%",Enums.GoodsIssueNoteStatuses[FillParameters.DocumentStatus]);
				Else
					MessageText = StrReplace(MessageText,"%Status%",Enums.TransferNoteStatuses[FillParameters.DocumentStatus]);
				EndIf;
			Else
				MessageText = StrReplace(MessageText,"%Status%",FillParameters.DocumentStatus);
			EndIf;	
			
		Else
			If ErrorSampling.NoSelected Then
				MessageText = NStr("vi = 'Theo lệnh ""%ReferenceOrder%"" không có các hàng hóa đã chọn, do đó không cần điền lại chứng từ bởi các hàng hóa đã chọn.';
									|ru = 'По распоряжению ""%ReferenceOrder%"" нет отобранных товаров, поэтому документ нельзя перезаполнить отобранными товарами.';
									|en = 'There are no picked goods for the ""%ReferenceOrder%"" reference, that is why the document cannot be refilled with the picked goods.'; fa = 'There are no picked goods for the ""%ReferenceOrder%"" reference, that is why the document cannot be refilled with the picked goods.';
									|it = 'Non ci sono le merci selezionate in base alla disposizione ""%ReferenceOrder%"" per questo il documento non può essere ricompilato con le merci selezionate.';
									|pl = 'W zamówieniu ""%ReferenceOrder%"" nie ma wybranych towarów, więc dokument nie można wypełnić ponownie według wybranych towarów.';
									|tr = '""%ReferenceOrder%"" siparişi için seçilen ürün yok, bu nedenle belge seçilen ürünler yeniden doldurulamaz.'");
			Else
				MessageText = NStr("vi = 'Theo lệnh ""%ReferenceOrder%"" có nhiệm vụ lấy ra chưa thực hiện, do đó không nên điền lại chứng từ bằng các hàng hóa đã chọn.';
									|ru = 'По распоряжению ""%ReferenceOrder%"" есть невыполненные задания на отбор, поэтому документ нельзя перезаполнить отобранными товарами.';
									|en = 'There are incomplete picking jobs for the ""%ReferenceOrder%"" reference, that is why the document cannot be refilled with the picked goods.'; fa = 'There are incomplete picking jobs for the ""%ReferenceOrder%"" reference, that is why the document cannot be refilled with the picked goods.';
									|it = 'Ci sono dei task per la selezione non completati in base alla disposizione ""%ReferenceOrder%"" per questo il documento non può essere ricompilato con le merci selezionate.';
									|pl = 'W zamówieniu ""%ReferenceOrder%"" są niewykonane zadania do filtru, więc dokument nie można wypełnić ponownie wybranymi wierszami pozycji.';
									|tr = '""%ReferenceOrder%"" siparişinin yerine getirilmemiş seçim görevleri vardır, bu nedenle belge seçilen ürünlerle yeniden doldurulamaz.'");
			EndIf;
		EndIf;
		
		MessageText = StrReplace(MessageText,"%ReferenceOrder%",ErrorSampling.ReferenceOrder);
		CommonClientServer.MessageToUser(MessageText);
		FillParameters.DocumentsArray.Delete(FillParameters.DocumentsArray.Find(ErrorSampling.ReferenceOrder));
		
	EndDo;
	
	If FillParameters.DocumentsArray.Count() = 0 Then
		Return ArrayOfChangedDocuments;
	EndIf;

	SamplingResults = QueryResults[8].Select();
	If MarkedProductsAreUsed Then
		ShippedStamps   = QueryResults[10].Unload();
	EndIf; 
	
	ObjectToProcess = Undefined;
	
	While SamplingResults.Next() Do
		
		If ObjectToProcess = Undefined
			Or ObjectToProcess.Ref <> SamplingResults.ReferenceOrder Then
			
			If ObjectToProcess <> Undefined Then
				
				CompleteReFillingWithSelectedProducts(ObjectToProcess,
																	FillParameters,
																	ArrayOfChangedDocuments);
				ObjectToProcess = Undefined;
				
			EndIf;	
			
			If FillParameters.FillMode = "Plural_" Then	
				
				Try
					ObjectToProcess = SamplingResults.ReferenceOrder.GetObject(); // DocumentObject.GoodsIssueNote, DocumentObject.GoodsTransferNote
					ObjectToProcess.Lock();
				Except
					CommonClientServer.MessageToUser(BriefErrorDescription(ErrorInfo()));
					Continue;
				EndTry;
				
			Else
				
				ObjectToProcess = FillParameters.DocumentObject;
				
			EndIf;
			
			LinesToDelete = ObjectToProcess.ShippedGoods.FindRows(New Structure("Action", Enums.ActionsWithGoodsIssueNoteRows.Pick));
			
			For Each ArrRow In LinesToDelete Do
				ObjectToProcess.ShippedGoods.Delete(ArrRow);
			EndDo;
			
			If MarkedProductsAreUsed
				And CommonClientServer.HasAttributeOrObjectProperty(ObjectToProcess, "PackageBarcodes") Then
				ObjectToProcess.PackageBarcodes.Clear();
			EndIf;		
	
		EndIf;		
		
		RowOfGoods = ObjectToProcess.ShippedGoods.Add();
		FillPropertyValues(RowOfGoods, SamplingResults); 
		RowOfGoods.Action = Enums.ActionsWithGoodsIssueNoteRows.Pick;
		
		// we fill in the data on brands
		If MarkedProductsAreUsed
			And CommonClientServer.HasAttributeOrObjectProperty(ObjectToProcess, "PackageBarcodes") Then
			FoundShippedStamps = Undefined; 
			If Not ShippedStamps = Undefined Then
				SearchParameters = New Structure("ReferenceOrder, Products, Characteristic, Series, Purpose");
				FillPropertyValues(SearchParameters, SamplingResults);
				FoundShippedStamps = ShippedStamps.FindRows(SearchParameters);
			EndIf; 
			
			If RowOfGoods.NumberOfPackages > 0 And Not FoundShippedStamps = Undefined Then
				ItRemainsToDistributeStamps = RowOfGoods.NumberOfPackages;
				For Each Brand In FoundShippedStamps Do
					If ItRemainsToDistributeStamps = 0 Then
						Break;
					EndIf; 
					
					TabLineOfBrand = ObjectToProcess.PackageBarcodes.Add();
					TabLineOfBrand.PackageBarcode = Brand.PackageBarcode;
					
					ItRemainsToDistributeStamps = ItRemainsToDistributeStamps  - 1;
					ShippedStamps.Delete(Brand);
				EndDo; 
			EndIf; 
		EndIf; 

		// More was taken than was in the order (this may be when the goods are stored in a container, but the container is not available, i.e.
		// we do not ship the container) In this case, we add an unloaded string to the amount of excess.
		// According to the container in the tasks of the series can not be specified, the accounting of packages by container is not maintained.
		If SamplingResults.Count > SamplingResults.NumberOfContainersAvailable
			And SamplingResults.ItemsType = Enums.ItemsTypes.ReusablePackage Then
			
			QuantityNotToShip = SamplingResults.Count - SamplingResults.NumberOfContainersAvailable;
			
			RowOfGoods.Count         = QuantityNotToShip;
			RowOfGoods.NumberOfPackages = QuantityNotToShip;
			If TypeOf(ObjectToProcess.Ref) = Type("DocumentRef.GoodsIssueNote") Then
				// The rule is valid only for an expense order - with a transfer order, you need to move the entire container.
				RowOfGoods.Action = Enums.ActionsWithGoodsIssueNoteRows.DoNotShip;
			Else
				RowOfGoods.Action = Enums.ActionsWithGoodsIssueNoteRows.Pick;
			EndIf;
			
			If QuantityNotToShip <>  SamplingResults.Count  Then
				RowOfGoods = ObjectToProcess.ShippedGoods.Add();
				FillPropertyValues(RowOfGoods, SamplingResults); 
				RowOfGoods.Count         = SamplingResults.Count - QuantityNotToShip;
				RowOfGoods.NumberOfPackages = SamplingResults.Count - QuantityNotToShip;
				RowOfGoods.Action = Enums.ActionsWithGoodsIssueNoteRows.Pick;
			
			EndIf;
		EndIf;
		
	EndDo;
	
	If ObjectToProcess <> Undefined Then
		CompleteReFillingWithSelectedProducts(ObjectToProcess, FillParameters, ArrayOfChangedDocuments);
		
		Modified = True;
	EndIf;
	
	If FillParameters.StatusChange Then
		
		ArrayOfDocumentsToChange = CommonClientServer.ArraysDifference(FillParameters.DocumentsArray,
																					ArrayOfChangedDocuments);
		
		For Each ArrRow In ArrayOfDocumentsToChange Do
			
			ObjectToProcess = ArrRow.GetObject();
			
			If FillParameters.FillMode = "Plural_" Then
				Try
					ObjectToProcess.Lock();
				Except
					CommonClientServer.MessageToUser(BriefErrorDescription(ErrorInfo()));
					
					Continue;
				EndTry;
			EndIf;
			
			CompleteReFillingWithSelectedProducts(ObjectToProcess, FillParameters, ArrayOfChangedDocuments);
			
			Modified = True;
			
		EndDo;
		
	EndIf;
	
	Return ArrayOfChangedDocuments;

EndFunction

// Returns the room with the largest remaining balance
//	
//	Parameters:
//		Parameters - Structure - the structure by which the premises are searched:
//			* Products - CatalogRef.Products
//			* Characteristic - CatalogRef.ItemsCharacteristics
//			* Warehouse - CatalogRef.Warehouses
//	Returns:
//		CatalogRef.Warerooms - the room on which there is the largest remainder.
//
Function RoomForProducts(Parameters) Export
	
	Query = New Query;
	Query.SetParameter("Products", Parameters.Products);
	Query.SetParameter("Characteristic", Parameters.Characteristic);
	Query.SetParameter("Warehouse", Parameters.Warehouse);
	Query.Text =
	"SELECT TOP 1
	|	ProductStockBalance.Premise AS Premise
	|FROM
	|	AccumulationRegister.ProductStock.Balance(, Products = &Products
	|	AND Characteristic = &Characteristic
	|	AND Warehouse = &Warehouse) AS ProductStockBalance
	|
	|ORDER BY
	|	InStockBalance DESC";
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		Result = Selection.Premise;
	Else
		Result = Catalogs.Warerooms.EmptyRef();
	EndIf;
	
	Return Result;
	
EndFunction

// Adds a request to the request package to get the data needed to fill in the sign of using 
// an order warehouse when processing rows in the table part.
//
// Parameters:
//  StructureOfActions - See BatchProcessingOfTablePartServer.ProcessTSStrings.StructureOfActions
//  QueryDetails - See BatchProcessingOfTablePartServer.QueryDetails
//  CachedValues - See BatchProcessingOfTablePartClientServer.GetStructureOfCachedValues
//
Procedure AddOrderWarehouseAttributeToQueryText(StructureOfActions, QueryDetails, CachedValues) Export
	
	Var ActionParameters;
	
	If Not BatchProcessingOfTablePartServer.YouNeedToPerformAction(
			"FillInOrderWarehouseAttribute",
			StructureOfActions,
			CachedValues) Then
		Return;
	EndIf;
	
	WarehouseFieldName = "Warehouse"; 
	
	If TypeOf(ActionParameters) = Type("Structure")
		And ActionParameters.Property("WarehouseFieldName") Then
		WarehouseFieldName = ActionParameters.WarehouseFieldName;
	EndIf;

	QueryText = "
		|SELECT ALLOWED
		|	DataSource.IdOfTTRow AS IdOfTTRow,
		|	CatWarehouses.UseWarehouseManagemantSystemForGoodsSurplusesShortages AS UseWarehouseManagemantSystemForGoodsSurplusesShortages,
		|	CatWarehouses.StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages AS StartDateOfWarehouseManagemantSystemForGoodsSurplusesShortages
		|FROM
		|	TTDataSource AS DataSource
		|	LEFT JOIN Catalog.Warehouses AS CatWarehouses
		|		ON &WarehouseField = CatWarehouses.Ref";
	
	QueryText = StrReplace(QueryText, "&WarehouseField", "DataSource." + WarehouseFieldName);
	
	QueryDetails.QueriesTexts.Add(QueryText, "FlagOfOrderWarehouse");
	
EndProcedure

