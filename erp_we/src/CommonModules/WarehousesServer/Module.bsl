// Prepares final document reflection requests for warehouse registers:
// -  Tourinclude
// - Product availability
//
// Parameters:
//  Query - Query - Request for document reflection.
//  QueryTexts - ValueList - List of document reflection request texts.
// 	Registers - Undefined, Structure, String - List of registers to reflect.
//  QueryTextDocument_ - String - The text of the document data selection request containing the following required fields:
//     * Ref                - DocumentRef - Link to the current document.
//     * OrderDocument                 - DocumentRef - Link to the order. If there are no such details, you should pass
//                               Undefined. The invoice cannot pass a link to itself.
//     * Invoice             - DocumentRef - Link to the invoice. If the current document is an order, it should
//                               be passed Undefined. The invoice passes a link to itself.
//     * Date                  - Date - Date of receipt of the product.
//     * Contract               - CatalogRef.CounterpartyContracts - Contract with the supplier, can be used
//                               as an access Document. If there are no such details, or if the document cannot
//                               be accepted under the contract, you should send it Undefined.
//     * Terms            - CatalogRef.TermsOfPurchaseFromVendors - Agreement with the supplier, can be used
//                               as an access Document. If there are no such details, or if the document cannot
//                               be accepted under the agreement, it should be passed Undefined.
//     * GoodsReceiptOption - EnumRef.GoodsReceiptOptions - the document's eponymous detail, if 
//                               there is no such detail, should be passed Undefined
//	   * DiscrepanciesKind		   - EnumRef.DiscrepanciesKindOfReceiptsPurchases - Type of Discrepancies
//     * Warehouse                 - CatalogRef.Warehouses - The warehouse where the product will be delivered. 
//     * Sender           - DefinedType.SenderRecipientOfGoods - where the product is expected to arrive from.
//     * BusinessOperation - EnumRef.BusinessTransactions - eponymous document details.
//     * Products          - CatalogRef.Products - Nomenclature.
//     * Characteristic        - CatalogRef.ItemsCharacteristics - characteristic.
//     * Purpose            - CatalogRef.Assignments - purpose.
//     * ToControlQuality - Boolean - If the received goods are subject to quality control, then it is True, otherwise it is False.
//     * RecordOfAPreviouslyReceivedLot - Boolean - If the goods that were previously delivered to another warehouse and are under quality control have arrived at the warehouse, then it is True, otherwise it is False.
//     * ControlledLotReference - CatalogRef.ControlledLots - A link to a party that was received earlier (if the movement parameter of the party that received it = True), otherwise it is undefined or an empty link. 
//     * BatchesIndicationStatus   - Number - Service field of the table part, if there is no such detail, pass 0.
//     * ExceedingOrder           - Boolean - Service field for invoices, which is set to true if the invoice is for
//                               an order, and the line has a sign that it is not linked to the order, for example, line Code = 0.
//     * Series                 - CatalogRef.ItemsBatches - The series, if there are no such details, should be passed Undefined.
//     * Count            - Number - Quantity.
//     * ReceiptUnderOrders  - Boolean - Indicates that the current document is an order invoice.
//     * ThisIsAnInvoice          - Boolean - Indicates that the current document is an invoice.
//  MetadataObject - MetadataObjectDocument - metadata object of the current document.
//  SynonymForDocumentTable - String - Synonym of the main table in the text of the document Request, if different from
//                                     the default value.
//
Procedure IssueWriteOffOfDiscrepanciesInTwoWay(Query,
													QueryTexts,
													Registers,
													QueryTextDocument_,
													MetadataObject,
													SynonymForDocumentTable = "DataSource") Export
	
	TemplateForGoodsToReceiveRequestText =
	// 1.
	"SELECT
	|	CASE 
	|		WHEN DocumentData.DiscrepanciesKind =
	|				VALUE(Enum.DiscrepanciesKindOfReceiptsPurchases.Overdelivery)
	|			THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END								   AS RecordType,
	|	DocumentData.Ref                 AS Recorder,
	|	DocumentData.Date                   AS Period,
	|	&DocumentOfReceiptOfTwoWayConsignmentNote AS DocumentInflow,
	|	DocumentData.Products           AS Products,
	|	DocumentData.Characteristic         AS Characteristic,
	|	&Purpose                            AS Purpose,
	|	CASE
	|		WHEN DocumentData.ToControlQuality AND DocumentData.RecordOfAPreviouslyReceivedLot
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END AS ControlledLotReference,
	|	DocumentData.Warehouse                  AS Warehouse,
	|	DocumentData.Sender            AS Sender,
	|	&TwoWayEconomicOperation      AS BusinessOperation,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus = 18
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END                                  AS Series,
	// Not used, needed for adapted text.
	|	0                                      AS ToRegisterInvoicesByReference,
	|	0                                      AS ToRegisterReceiptsByReference,
	|	DocumentData.Count             AS ToRegisterReceiptsByInvoices,
	|	0                                      AS ToRegisterGoodsReceipts,
	// Not used, needed for adapted text.
	|	0                                      AS GoodsReceiptNotesToRegister
	|FROM
	|	#DocumentData AS DocumentData
	|	,&AdditionalConnections
	|WHERE
	|	&UninvoicedReceiptDocumentIsUsed
	|	AND DocumentData.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage),
	|			VALUE(Enum.ItemsTypes.OperationService),
	|			VALUE(Enum.ItemsTypes.Work_5))
	|
	|UNION ALL
	| 
	// 2.
	|SELECT
	|	CASE 
	|		WHEN DocumentData.DiscrepanciesKind =
	|				VALUE(Enum.DiscrepanciesKindOfReceiptsPurchases.Overdelivery)
	|			THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END								   AS RecordType,
	|	DocumentData.Ref                 AS Recorder,
	|	DocumentData.Date                   AS Period,
	|	CASE
	|		WHEN (&ContractIsOrder
	|				OR NOT DocumentData.ReceiptUnderOrders)
	|				AND NOT &ByContractsAfterInvoices
	|			THEN &DocumentOfReceiptOfTwoWayConsignmentNote
	|		ELSE DocumentData.OrderDocument
	|	END                                  AS DocumentInflow,
	|	DocumentData.Products           AS Products,
	|	DocumentData.Characteristic         AS Characteristic,
	|	&Purpose                            AS Purpose,
	|	CASE
	|		WHEN DocumentData.ToControlQuality AND DocumentData.RecordOfAPreviouslyReceivedLot
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END AS ControlledLotReference,
	|	DocumentData.Warehouse                  AS Warehouse,
	|	DocumentData.Sender            AS Sender,
	|	&TwoWayEconomicOperation      AS BusinessOperation,
	|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	// Not used, needed for adapted text.
	|	0                                      AS ToRegisterInvoicesByReference,
	|	DocumentData.Count             AS ToRegisterReceiptsByReference,
	|	0                                      AS ToRegisterReceiptsByInvoices,
	|	0                                      AS ToRegisterGoodsReceipts,
	// Not used, needed for adapted text.
	|	0                                      AS GoodsReceiptNotesToRegister
	|FROM
	|	#DocumentData AS DocumentData
	|	,&AdditionalConnections
	|WHERE
	// All cases except those that are taken into account in request number 2.
	|	NOT (NOT &UninvoicedReceiptDocumentIsUsed
	|		AND &InvoiceIsOrder)
	|	AND DocumentData.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage),
	|			VALUE(Enum.ItemsTypes.OperationService),
	|			VALUE(Enum.ItemsTypes.Work_5))
	|
	|UNION ALL
	|
	// 3.
	|SELECT
	|	CASE
	|		WHEN DocumentData.DiscrepanciesKind =
	|				VALUE(Enum.DiscrepanciesKindOfReceiptsPurchases.Overdelivery)
	|			THEN VALUE(AccumulationRecordType.Receipt)
	|		ELSE VALUE(AccumulationRecordType.Expense)
	|	END								   AS RecordType,
	|	DocumentData.Ref                 AS Recorder,
	|	DocumentData.Date                   AS Period,
	|	CASE
	|		WHEN (&ContractIsOrder
	|				OR &InvoiceIsOrder
	|				OR NOT DocumentData.ReceiptUnderOrders)
	|			THEN &DocumentOfReceiptOfTwoWayConsignmentNote
	|		ELSE DocumentData.OrderDocument
	|	END                                  AS DocumentInflow,
	|	DocumentData.Products           AS Products,
	|	DocumentData.Characteristic         AS Characteristic,
	|	&Purpose                            AS Purpose,
	|	CASE
	|		WHEN DocumentData.ToControlQuality AND DocumentData.RecordOfAPreviouslyReceivedLot
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END AS ControlledLotReference,
	|	DocumentData.Warehouse                  AS Warehouse,
	|	DocumentData.Sender            AS Sender,
	|	&TwoWayEconomicOperation      AS BusinessOperation,
	|	VALUE(Catalog.ItemsBatches.EmptyRef)	AS Series,
	// Not used, needed for adapted text.
	|	0                                      AS ToRegisterInvoicesByReference,
	|	0                                      AS ToRegisterReceiptsByReference,
	|	0                                      AS ToRegisterReceiptsByInvoices,
	|	0						               AS ToRegisterGoodsReceipts,
	// Not used, needed for adapted text.
	|	DocumentData.Count             AS GoodsReceiptNotesToRegister
	|FROM
	|	#DocumentData AS DocumentData
	|	,&AdditionalConnections
	|WHERE
	|	&OrderSchemeIsUsedUponReceipt
	|	AND DocumentData.Products.ItemsType IN
	|			(VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage),
	|			VALUE(Enum.ItemsTypes.OperationService),
	|			VALUE(Enum.ItemsTypes.Work_5))
	// When a two-way is used in documents where there is no special second waybill, for example, for the Assembly of goods,
	// (not by order), then this movement is done in the operation to formalize the acquisition of goods in a two-way
	|	AND &UninvoicedReceiptDocumentIsUsed
	|";
	
	QueryOptions = ParametersOfDocumentDataRequestText("ToIssueReceiptOfGoodsOnDvukhodovka",
															SynonymForDocumentTable);
	
	FillInRequestTextParameters(TemplateForGoodsToReceiveRequestText,	QueryOptions);
	
	TemplateForGoodsToReceiveRequestText	= StrReplace(TemplateForGoodsToReceiveRequestText,
															"DocumentData",
															SynonymForDocumentTable);
	
	ReflectionTemplateTexts = New Structure;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsToReceive", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsToReceive", TemplateForGoodsToReceiveRequestText);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure(SynonymForDocumentTable, QueryTextDocument_);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests);
	
EndProcedure

// Prepares final document reflection requests for warehouse registers:
// -  Tourinclude
// - Tovaryformleniyuizlishkovnedostach
// - Goods in cells
//
// The movements opened by this operation will be closed further by the operation Formalizlishkinedostachinasklade
//
// Parameters:
//  Query - Query - Request for document reflection.
//  QueryTexts - ValueList - List of document reflection request texts.
// 	Registers - Undefined, Structure, String - List of registers to reflect.
//  QueryTextDocument_ - String - The text of the document data selection request containing the following required fields:
//     * Ref                - DocumentRef - Link to the current document
//     * Date                  - Date - Date of receipt of the goods
//     * Warehouse                 - CatalogRef.Warehouses - 
//     * Premise             - CatalogRef.Warerooms -
//     * Cell                - CatalogRef.StorageBins - 
//     * Products          - CatalogRef.Products - 
//     * Characteristic        - CatalogRef.ItemsCharacteristics - 
//     * Purpose            - CatalogRef.Assignments - 
//     * ControlledLotReference  - CatalogRef.ControlledLots - the controlled Lot reference for which the surplus/shortage is registered.
//     * BatchesIndicationStatus   - Number -
//     * Series                 - CatalogRef.ItemsBatches -
//     * Package              - CatalogRef.PackagesAndUnitsOfMeasure -
//     * Count            - Number - a negative value indicates that a shortage is being reflected
//     * NumberOfPackages    - Number - a negative value indicates that a shortage is being reflected
//     * RemainderChanges     - Boolean - indicates that the operation changes the product balance by register
//                                        Tourinclude and Tovarischah
//
Procedure RegisterSurplusShortagesInWarehouse(Query, QueryTexts,
		Registers, QueryTextDocument_) Export

	ReflectionTemplateTexts = New Structure();
	TextsOfDocumentDataRequests = New Structure();
	TemporaryTableQueryTexts_ = New Structure();

	TextsOfDocumentDataRequests.Insert("DocumentData", QueryTextDocument_);

	RequestTextTTRegisterSurplusShortageInStock = 
		"SELECT
		|	DocumentData.Ref              AS Ref,
		|	DocumentData.Date                AS Date,
		|	DocumentData.Warehouse               AS Warehouse,
		|	DocumentData.Premise           AS Premise,
		|	DocumentData.Cell              AS Cell,
		|	DocumentData.Products        AS Products,
		|	DocumentData.Characteristic      AS Characteristic,
		|	DocumentData.Purpose          AS Purpose,
		|	DocumentData.ControlledLotReference AS ControlledLotReference,
		|	DocumentData.Series               AS Series,
		|	DocumentData.Package            AS Package,
		|	CASE
		|		WHEN
		|			DocumentData.Count < 0
		|			THEN 
		|				-DocumentData.Count
		|			ELSE
		|				DocumentData.Count
		|	END                               AS Count,
		|	CASE
		|		WHEN
		|			DocumentData.NumberOfPackages < 0
		|			THEN 
		|				-DocumentData.NumberOfPackages
		|			ELSE
		|				DocumentData.NumberOfPackages
		|	END                               AS NumberOfPackages,
		|	DocumentData.BatchesIndicationStatus AS BatchesIndicationStatus,
		|	DocumentData.Count > 0      AS ItSOverkill,
		|	DocumentData.Count < 0      AS ThisIsShortage_,
		|	DocumentData.RemainderChanges   AS RemainderChanges
		|INTO TTRegisterSurplusShortageInStock
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	NOT ISNULL(DocumentData.Package.PackageType, UNDEFINED)
		|		= VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|
		|UNION ALL
		|
		|SELECT
		|	DimensionData_.Ref          AS Ref,
		|	DocumentData.Date              AS Date,
		|	DocumentData.Warehouse             AS Warehouse,
		|	DocumentData.Premise         AS Premise,
		|	DocumentData.Cell            AS Cell,
		|	DimensionData_.Products    AS Products,
		|	DimensionData_.Characteristic  AS Characteristic,
		|	DimensionData_.Purpose      AS Purpose,
		|	DimensionData_.ControlledLotReference AS ControlledLotReference,
		|	DimensionData_.Series           AS Series,
		|	DimensionData_.Package        AS Package,
		|	CASE
		|		WHEN DocumentData.Count < 0
		|			THEN 
		|				-DocumentData.Count
		|			ELSE
		|				DocumentData.Count
		|	END                             AS Count,
		|	CASE
		|		WHEN DocumentData.NumberOfPackages < 0
		|			THEN 
		|				-DocumentData.NumberOfPackages
		|			ELSE
		|				DocumentData.NumberOfPackages
		|	END                             AS NumberOfPackages,
		|	DimensionData_.BatchesIndicationStatus AS BatchesIndicationStatus,
		|	DocumentData.Count > 0    AS ItSOverkill,
		|	DocumentData.Count < 0    AS ThisIsShortage_,
		|	DocumentData.RemainderChanges AS RemainderChanges
		|FROM
		|	(SELECT
		|		DocumentData.Ref         AS Ref,
		|		DocumentData.Products   AS Products,
		|		DocumentData.Characteristic AS Characteristic,
		|		DocumentData.Purpose     AS Purpose,
		|		DocumentData.ControlledLotReference AS ControlledLotReference,
		|		DocumentData.Series          AS Series,
		|		MAX(DocumentData.Package) AS Package,
		|		DocumentData.BatchesIndicationStatus AS BatchesIndicationStatus
		|	FROM
		|		#DocumentData AS DocumentData
		|	WHERE
		|		ISNULL(DocumentData.Package.PackageType, UNDEFINED)
		|			= VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|	
		|	GROUP BY
		|		DocumentData.Ref,
		|		DocumentData.Products,
		|		DocumentData.Characteristic,
		|		DocumentData.Purpose,
		|		DocumentData.ControlledLotReference,
		|		DocumentData.Series,
		|		DocumentData.BatchesIndicationStatus
		|
		|		) AS DimensionData_
		|
		|		INNER JOIN #DocumentData AS DocumentData
		|		ON DimensionData_.Ref            = DocumentData.Ref
		|			AND DimensionData_.Products   = DocumentData.Products
		|			AND DimensionData_.Characteristic = DocumentData.Characteristic
		|			AND DimensionData_.Series          = DocumentData.Series
		|			AND DimensionData_.Purpose     = DocumentData.Purpose
		|			AND DimensionData_.ControlledLotReference = DocumentData.ControlledLotReference
		|			AND DimensionData_.Package       = DocumentData.Package
		|";

	TemporaryTableQueryTexts_.Insert("TTRegisterSurplusShortageInStock", RequestTextTTRegisterSurplusShortageInStock);

	TemplateForTextOfGoodsRequestForRegistrationOfSurplusShortages = 
		"SELECT
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus = 14
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.Count             AS ToCertificateRegistration
		|FROM
		|	TTRegisterSurplusShortageInStock AS DocumentData
		|WHERE
		|	DocumentData.ThisIsShortage_
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus = 14
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.Count             AS ToCertificateRegistration
		|FROM
		|	TTRegisterSurplusShortageInStock AS DocumentData
		|WHERE
		|	DocumentData.ItSOverkill
		|";

	RequestTextTemplateForProductsInWarehouses = 
		"SELECT
		|	CASE
		|		WHEN DocumentData.ItSOverkill
		|			THEN VALUE(AccumulationRecordType.Receipt) 
		|		ELSE VALUE(AccumulationRecordType.Expense) 
		|	END                                  AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	DocumentData.ControlledLotReference   AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Premise              AS Premise,
		|	DocumentData.Count             AS InStock,
		|	0                                      AS ToShip,
		|	CASE
		|		WHEN NOT DocumentData.ItSOverkill
		|			  AND DocumentData.BatchesIndicationStatus IN (6, 8, 10, 14)
		|			THEN TRUE
		|		ELSE FALSE
		|	END							       AS ToControlBalance
		|FROM
		|	TTRegisterSurplusShortageInStock AS DocumentData
		|WHERE
		|	DocumentData.RemainderChanges
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|";

	QueryTextTemplateProductsInCells = 
		"SELECT
		|	CASE
		|		WHEN DocumentData.Count > 0
		|			THEN VALUE(AccumulationRecordType.Receipt) 
		|		ELSE VALUE(AccumulationRecordType.Expense) 
		|	END                                  AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Cell                 AS Cell,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentData.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS Package,
		|	CASE
		|		WHEN DocumentData.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN
		|				CASE
		|					WHEN DocumentData.NumberOfPackages < 0
		|						THEN 
		|							-DocumentData.NumberOfPackages
		|						ELSE
		|							DocumentData.NumberOfPackages
		|				END
		|			ELSE
		|				CASE
		|					WHEN DocumentData.Count < 0
		|						THEN 
		|							-DocumentData.Count
		|						ELSE
		|							DocumentData.Count
		|				END
		|	END                                  AS InStock,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose
		|FROM
		|	#DocumentData AS DocumentData
		|	INNER JOIN InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOfBinLocationWarehouses
		|	ON SettingsOfBinLocationWarehouses.UseBinLocationWarehousing
		|		AND SettingsOfBinLocationWarehouses.StartDateOfUsingWarehouseBinSystem <= DocumentData.Date
		|		AND SettingsOfBinLocationWarehouses.Warehouse = DocumentData.Warehouse
		|		AND SettingsOfBinLocationWarehouses.Premise = DocumentData.Premise
		|		AND (NOT DocumentData.Premise = VALUE(Catalog.Warerooms.EmptyRef)
		|			OR (NOT SettingsOfBinLocationWarehouses.Warehouse.UseWarerooms
		|				OR DocumentData.Date < SettingsOfBinLocationWarehouses.Warehouse.StartDateOfWareroomUse))
		|WHERE
		|	DocumentData.RemainderChanges
		|";
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForRegistrationOfSurplusesAndShortages", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForRegistrationOfSurplusesAndShortages", TemplateForTextOfGoodsRequestForRegistrationOfSurplusShortages);
	EndIf;
	If DocumentsPosting.RequiresTableForRegisteredRecords("ProductStock", Registers) Then
		ReflectionTemplateTexts.Insert("ProductStock", RequestTextTemplateForProductsInWarehouses);
	EndIf;
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsInStorageBins", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsInStorageBins", QueryTextTemplateProductsInCells);
	EndIf;

	DocumentsPosting.AddDocumentReflectionRequest(Query, QueryTexts, ReflectionTemplateTexts, TextsOfDocumentDataRequests, TemporaryTableQueryTexts_);

EndProcedure

