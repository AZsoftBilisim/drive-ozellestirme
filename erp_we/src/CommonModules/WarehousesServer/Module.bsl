// Determines whether series are used in the warehouse. For a warehouse group, determines whether series are used in subordinate warehouses.
//
// Parameters:
//  Warehouse					 - CatalogRef.Warehouses	 - a warehouse or group of warehouses for which you want to specify the use of a series
//  WarehouseCanBeGroup	 - Boolean					 - indicates that a group can be passed in the first parameter.
// 
// Returns:
//  Structure - a structure with the following keys:
//  *UseItemsBatch - Boolean
//  *UseCostAccountingByBatches - Boolean
//
Function UseOfSeriesInStock(Warehouse, WarehouseCanBeGroup) Export
	
	ReturnStructure = New Structure;
	ReturnStructure.Insert("UseItemsBatch", False);
	ReturnStructure.Insert("UseCostAccountingByBatches", False);
	
	If Not ValueIsFilled(Warehouse) Then
		Return ReturnStructure;
	EndIf;
	
	If WarehouseCanBeGroup Then
		
		Query = New Query;
		Query.Text =
		"SELECT ALLOWED
		|	MAX(Warehouses.UseItemsBatch) AS UseItemsBatch,
		|	MAX(Warehouses.UseCostAccountingByBatches) AS UseCostAccountingByBatches
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|WHERE
		|	NOT Warehouses.IsFolder
		|	AND (Warehouses.Ref IN HIERARCHY (&Warehouse)
		|			OR Warehouses.Ref = &Warehouse)
		|
		|HAVING
		|	NOT MAX(Warehouses.UseItemsBatch) IS NULL ";
		
		Query.SetParameter("Warehouse",Warehouse);
		
		Selection = Query.Execute().Select();
		
		If Selection.Next() Then
			FillPropertyValues(ReturnStructure, Selection);
		EndIf;
		
	Else
		
		FOParameters = New Structure("Warehouse", Warehouse);
		
		ReturnStructure.UseItemsBatch  = GetFunctionalOption("UseItemsBatchWarehouse", FOParameters); 
		ReturnStructure.UseCostAccountingByBatches = GetFunctionalOption("UseCostAccountingByBatchesWarehouse", FOParameters);
		
	EndIf;
	
	Return ReturnStructure;
	
EndFunction

// Determines whether the series accounting policy values for the warehouse are set in at least one item type.
//
// Parameters:
//  Warehouse	 - CatalogRef.Warehouses	 - the warehouse for which policies are defined.
// 
// Returns:
//  Structure - a structure with the following keys:
//  	* SpecifyWhenPlanningShipment - Boolean
//  	* UseCostAccountingByBatches - Boolean
//
Function UseOfSeriesInStockAccordingToAccountingPolicies(Warehouse) Export
	
	ReturnStructure = New Structure;
	ReturnStructure.Insert("SpecifyWhenPlanningShipment", False);
	ReturnStructure.Insert("UseCostAccountingByBatches", False);
	
	Query = New Query;
	Query.Text = "SELECT ALLOWED
	|	MAX(BatchAccountingPolicies.SpecifyWhenPlanningShipment) AS SpecifyWhenPlanningShipment,
	|	MAX(BatchAccountingPolicies.UseCostAccountingByBatches) AS UseCostAccountingByBatches,
	|	Warehouses.UseItemsBatch AS UseItemsBatch
	|FROM
	|	Catalog.Warehouses AS Warehouses
	|		LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS TypesOfProductPolicyAccountingSeries
	|		ON (TypesOfProductPolicyAccountingSeries.Warehouse = Warehouses.Ref)
	|		LEFT JOIN Catalog.BatchAccountingPolicies AS BatchAccountingPolicies
	|		ON (TypesOfProductPolicyAccountingSeries.BatchAccountingPolicy = BatchAccountingPolicies.Ref)
	|WHERE
	|	TypesOfProductPolicyAccountingSeries.Warehouse = &Warehouse
	|
	|GROUP BY
	|	Warehouses.UseItemsBatch";
	
	Query.SetParameter("Warehouse", Warehouse);
	
	Selection = Query.Execute().Select();
	
	If  Selection.Next() Then
		If Selection.UseItemsBatch Then
			FillPropertyValues(ReturnStructure, Selection);
		EndIf;
	EndIf;
	
	Return ReturnStructure;
	
EndFunction

// Determines whether the division uses series
//
// Parameters:
