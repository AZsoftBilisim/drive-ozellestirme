#Region FilterLocation

Procedure CheckPrepareProductPlacementParameters(TempTablesManager, Warehouse, Premise, SourceCell, Cancel)
	// In the process of preparing the table
	// - we will request all the necessary values of the details
	// - if there are packages supplied in multi-turn containers, then we will subtract the container from the nomenclature table,
	//  in the amount necessary for the placement of packages. The placement algorithm will add this amount
	//	automatically, regardless of whether the container was in the original nomenclature table, or it was not.
	//  We will leave in the table only the containers that are placed in excess of the quantity required for packages
	//	- so this is the placement of an empty container
	// - we will also subtract the container, which, if after its placement in the cell from which we place, the container will
	//  not be enough for the packages that are there.
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	ProductsTable.Products,
	|	ProductsTable.Characteristic,
	|	ProductsTable.Package,
	|	ProductsTable.Series,
	|	ProductsTable.Purpose,
	|	CASE
	|		WHEN ProductsTable.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.NumberOfPieces)
	|			THEN CAST(ProductsTable.NumberOfPackages - 0.5 AS NUMBER(15, 0))
	|		ELSE ProductsTable.NumberOfPackages
	|	END AS NumberOfPackages
	|INTO TableOfProductsRounding
	|FROM
	|	ProductsTable AS ProductsTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsInStorageBinsBalance.Package AS Package,
	|	GoodsInStorageBinsBalance.Purpose AS Purpose,
	|	CAST(GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance AS NUMBER(15, 0)) AS NumberOfPackages
	|INTO OutstandingBalances_
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Cell = &SourceCell
	|				AND NOT (Products, Characteristic, Purpose) IN
	|						(SELECT
	|							Table.Products,
	|							Table.Characteristic,
	|							Table.Purpose
	|						FROM
	|							ProductsTable AS Table)
	|				AND Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)) AS GoodsInStorageBinsBalance
	|WHERE
	|	GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SUM(NestedQuery.NumberOfContainers) AS NumberOfContainers,
	|	NestedQuery.TaraProducts,
	|	NestedQuery.TaraCharacteristic AS TaraCharacteristic
	|INTO PackagingContainers
	|FROM
	|	(SELECT
	|		ProductsTable.NumberOfPackages * RepackagingOptions.Count AS NumberOfContainers,
	|		RepackagingOptions.Package.ReusablePackageItems AS TaraProducts,
	|		RepackagingOptions.Package.ReusablePackageVariant AS TaraCharacteristic
	|	FROM
	|		TableOfProductsRounding AS ProductsTable
	|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|			ON ProductsTable.Package = RepackagingOptions.Source
	|	WHERE
	|		RepackagingOptions.Package.SuppliedInReusablePackage
	|		AND CAST(ProductsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|		AND ProductsTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ProductsTable.NumberOfPackages,
	|		CAST(ProductsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageItems,
	|		CAST(ProductsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageVariant
	|	FROM
	|		TableOfProductsRounding AS ProductsTable
	|	WHERE
	|		CAST(ProductsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).SuppliedInReusablePackage
	|		AND CAST(ProductsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ProductsTable.NumberOfPackages * RepackagingOptions.Count,
	|		RepackagingOptions.Package.ReusablePackageItems,
	|		RepackagingOptions.Package.ReusablePackageVariant
	|	FROM
	|		OutstandingBalances_ AS ProductsTable
	|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|			ON ProductsTable.Package = RepackagingOptions.Source
	|	WHERE
	|		RepackagingOptions.Package.SuppliedInReusablePackage
	|		AND ProductsTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		OutstandingBalances_.NumberOfPackages,
	|		OutstandingBalances_.Package.ReusablePackageItems,
	|		OutstandingBalances_.Package.ReusablePackageVariant
	|	FROM
	|		OutstandingBalances_ AS OutstandingBalances_
	|	WHERE
	|		CAST(OutstandingBalances_.Package AS Catalog.PackagesAndUnitsOfMeasure).SuppliedInReusablePackage) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.TaraProducts,
	|	NestedQuery.TaraCharacteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Package,
	|	NestedQuery.Series,
	|	NestedQuery.Purpose,
	|	SUM(NestedQuery.NumberOfPackages) AS NumberOfPackages
	|INTO RequestProductTable
	|FROM
	|	(SELECT
	|		ProductsTable.Products AS Products,
	|		ProductsTable.Characteristic AS Characteristic,
	|		CASE
	|			WHEN ISNULL(CAST(ProductsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).MeasuredValueType, FALSE) = VALUE(Enum.TypesOfMeasuredValues.Package)
	|				THEN ProductsTable.Package
	|			ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|		END AS Package,
	|		ProductsTable.Series AS Series,
	|		ProductsTable.Purpose AS Purpose,
	|		ProductsTable.NumberOfPackages AS NumberOfPackages
	|	FROM
	|		TableOfProductsRounding AS ProductsTable
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		PackagingContainers.TaraProducts,
	|		PackagingContainers.TaraCharacteristic,
	|		VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	|		VALUE(Catalog.ItemsBatches.EmptyRef),
	|		VALUE(Catalog.Assignments.EmptyRef),
	|		-PackagingContainers.NumberOfContainers
	|	FROM
	|		PackagingContainers AS PackagingContainers) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Purpose,
	|	NestedQuery.Package,
	|	NestedQuery.Series
	|
	|HAVING
	|	SUM(NestedQuery.NumberOfPackages) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RequestProductTable.Products,
	|	RequestProductTable.Characteristic,
	|	RequestProductTable.Purpose,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN ISNULL(WarehouseGroupsOfItems.PhysicallyDifferentFromAssignment, FALSE)
	|		ELSE FALSE
	|	END AS PhysicallyDifferentFromAssignment,
	|	ISNULL(WarehouseGroupsOfItems.LimitByWeight, TRUE) AS LimitByWeight,
	|	ISNULL(WarehouseGroupsOfItems.LimitByVolume, TRUE) AS LimitByVolume,
	|	RequestProductTable.Series,
	|	RequestProductTable.Package,
	|	RequestProductTable.NumberOfPackages,
	|	CAST(RequestProductTable.Products AS Catalog.Products).WarehouseGroup AS WarehouseGroupOfProducts,
	|	CAST(RequestProductTable.Products AS Catalog.Products).ItemsType AS ItemsType,
	|	CAST(RequestProductTable.Products AS Catalog.Products).UsePackages AS UsePackages,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).Dimensionless
	|		ELSE FALSE
	|	END AS Dimensionless,
	|	&QueryTextPackageWeight AS Weight,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).Height * CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).HeightUnitOfMeasure.Numerator / CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).HeightUnitOfMeasure.Denominator
	|		ELSE 0
	|	END AS Height,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).Depth * CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).DepthUnitOfMeasure.Numerator / CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).DepthUnitOfMeasure.Denominator
	|		ELSE 0
	|	END AS Depth,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).Width * CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).WidthUnitOfMeasure.Numerator / CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).WidthUnitOfMeasure.Denominator
	|		ELSE 0
	|	END AS Width,
	|	&QueryTextPackageVolume AS VolumeM3,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure).WarehouseGroup
	|		ELSE VALUE(Catalog.WarehousePackageGroups.EmptyRef)
	|	END AS WarehouseGroupOfPackages,
	|	CASE
	|		WHEN RequestProductTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN &QueryTextPackagingFactor
	|		ELSE 1
	|	END AS QuantityPerPackage,
	|	ISNULL(CAST(RequestProductTable.Series AS Catalog.ItemsBatches).ValidUntil_, DATETIME(1, 1, 1, 0, 0, 0)) AS ValidUntil_,
	|	ISNULL(BatchAccountingPolicies.BatchAccountingPolicy.BatchesAccountingByFEFO, FALSE) AS BatchesAccountingByFEFO
	|INTO ExtendedTableOfProducts
	|FROM
	|	RequestProductTable AS RequestProductTable
	|		LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS BatchAccountingPolicies
	|		ON (CAST(RequestProductTable.Products AS Catalog.Products).ProductKind = BatchAccountingPolicies.Ref)
	|			AND (BatchAccountingPolicies.Warehouse = &Warehouse)
	|		LEFT JOIN Catalog.WarehouseGroupsOfItems AS WarehouseGroupsOfItems
	|		ON (CAST(RequestProductTable.Products AS Catalog.Products).WarehouseGroup = WarehouseGroupsOfItems.Ref)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	ExtendedTableOfProducts.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	ExtendedTableOfProducts.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	PRESENTATION(ExtendedTableOfProducts.WarehouseGroupOfPackages) AS WarehouseGroupOfPackagesPresentation,
	|	PRESENTATION(ExtendedTableOfProducts.WarehouseGroupOfProducts) AS WarehouseGroupOfProductsPresentation
	|FROM
	|	ExtendedTableOfProducts AS ExtendedTableOfProducts
	|		LEFT JOIN InformationRegister.GoodsPlacementRules AS GoodsPlacementRules
	|		ON (ExtendedTableOfProducts.WarehouseGroupOfProducts = GoodsPlacementRules.WarehouseGroupOfProducts
	|					AND ExtendedTableOfProducts.WarehouseGroupOfPackages = GoodsPlacementRules.WarehouseGroupOfPackages
	|				OR ExtendedTableOfProducts.WarehouseGroupOfProducts = GoodsPlacementRules.WarehouseGroupOfProducts
	|					AND GoodsPlacementRules.WarehouseGroupOfPackages = VALUE(Catalog.WarehousePackageGroups.EmptyRef)
	|				OR GoodsPlacementRules.WarehouseGroupOfProducts = VALUE(Catalog.WarehouseGroupsOfItems.EmptyRef)
	|					AND ExtendedTableOfProducts.WarehouseGroupOfPackages = GoodsPlacementRules.WarehouseGroupOfPackages
	|				OR GoodsPlacementRules.WarehouseGroupOfProducts = VALUE(Catalog.WarehouseGroupsOfItems.EmptyRef)
	|					AND GoodsPlacementRules.WarehouseGroupOfPackages = VALUE(Catalog.WarehousePackageGroups.EmptyRef))
	|			AND (GoodsPlacementRules.Premise = &Premise)
	|			AND (GoodsPlacementRules.Warehouse = &Warehouse)
	|WHERE
	|	GoodsPlacementRules.StorageArea IS NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	ExtendedTableOfProducts.Products AS Products,
	|	ExtendedTableOfProducts.Package AS Package,
	|	ExtendedTableOfProducts.UsePackages AS UsePackages,
	|	PRESENTATION(ExtendedTableOfProducts.Products) AS ProductsPresentation,
	|	PRESENTATION(ExtendedTableOfProducts.Series) AS SeriesPresentation,
	|	PRESENTATION(ExtendedTableOfProducts.Package) AS PackagePresentation
	|FROM
	|	ExtendedTableOfProducts AS ExtendedTableOfProducts
	|WHERE
	|	(ExtendedTableOfProducts.LimitByWeight
	|				AND ExtendedTableOfProducts.Weight = 0
	|			OR ExtendedTableOfProducts.LimitByVolume
	|				AND NOT ExtendedTableOfProducts.Dimensionless
	|				AND (ExtendedTableOfProducts.VolumeM3 = 0
	|					OR ExtendedTableOfProducts.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|						AND (ExtendedTableOfProducts.Height = 0
	|							OR ExtendedTableOfProducts.Width = 0
	|							OR ExtendedTableOfProducts.Depth = 0)))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ProductsTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP RequestProductTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP PackagingContainers";	
	
	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure)", Undefined));
		
		
	Query.Text = StrReplace(
		Query.Text,
		"&QueryTextPackageWeight",
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure)", "CAST(RequestProductTable.Products AS Catalog.Products)", False));
		
	Query.Text = StrReplace(
		Query.Text,
		"&QueryTextPackageVolume",
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("CAST(RequestProductTable.Package AS Catalog.PackagesAndUnitsOfMeasure)", "CAST(RequestProductTable.Products AS Catalog.Products)", False));
		
	Query.SetParameter("Warehouse", Warehouse);      
	Query.SetParameter("Premise", Premise);
	Query.SetParameter("SourceCell", SourceCell);
	
	Result = Query.ExecuteBatch(); 
	
	Selection = Result[5].Select();
	
	MessageTextTemplate = NStr("vi = 'Đối với nhóm mặt hàng theo kho ""%WarehouseGroupOfProducts%"" 
	                          		|và nhóm đóng gói theo kho ""%WarehouseGroupOfPackages%"" chưa đặt quy tắc xếp vào';
	                          		|ru = 'Для складской группы номенклатуры ""%WarehouseGroupOfProducts%"" 
	                          		|и складской группы упаковок ""%WarehouseGroupOfPackages%"" не задано правило размещения';
	                          		|en = 'Put-away rule for a warehouse group of the ""%WarehouseGroupOfProducts%"" items
	                          		|and the ""%WarehouseGroupOfPackages%"" warehouse group of packaging units is not specified'; fa = 'Put-away rule for a warehouse group of the ""%WarehouseGroupOfProducts%"" items
	                          		|and the ""%WarehouseGroupOfPackages%"" warehouse group of packaging units is not specified';
	                          		|it = 'Per il gruppo di magazzino degli articoli ""%WarehouseGroupOfProducts%"" 
	                          		|e gruppo di magazzino degli imballaggi ""%WarehouseGroupOfPackages%"" non è impostata la regola di collocamento.';
	                          		|pl = 'Dla grupy magazynowej nomenklatury ""%WarehouseGroupOfProducts%"" 
	                          		|oraz grupy magazynowej opakowań ""%WarehouseGroupOfPackages%"" nie została podana zasada umieszczenia';
	                          		|tr = 'Öğe ambar grubu için ""%WarehouseGroupOfProducts%"" 
	                          		|"" %WarehouseGroupOfPackages%"" ambar paketleme ünitesi için yerleştirme kuralı ayarlanmadı'");
	
	While Selection.Next() Do
		
		MessageText = StrReplace(MessageTextTemplate,"%WarehouseGroupOfProducts%",TrimAll(Selection.WarehouseGroupOfProductsPresentation));
		MessageText = StrReplace(MessageText,"%WarehouseGroupOfPackages%",TrimAll(Selection.WarehouseGroupOfPackagesPresentation));
		
		CommonClientServer.MessageToUser(MessageText,,,,Cancel);
		
	EndDo;
	
	Selection = Result[6].Select();
	
	While Selection.Next() Do
		
		If ValueIsFilled(Selection.Package) Then
			MessageTextTemplate = NStr("vi = 'Đối với bộ đóng gói ""%Package%"" của mặt hàng ""%Products%"" chưa đặt đặc tính trọng lượng kích thước.';
										|ru = 'Для упаковки ""%Package%"" номенклатуры ""%Products%"" не заданы весо-размерные характеристики.';
										|en = 'Weight and dimension values are not specified for the ""%Package%"" packaging unit of the ""%Products%"" items.'; fa = 'Weight and dimension values are not specified for the ""%Package%"" packaging unit of the ""%Products%"" items.';
										|it = 'Per l''imballaggio ""%Package%"" degli articoli ""%Products%"" non sono specificate le caratteristiche di peso e dimensioni.';
										|pl = 'Dla opakowania ""%Package%"" nomenklatury ""%Products%"" nie zostały podane cechy wagi i wymiarów.';
										|tr = '""%Products%"" ürününün ""%Package%"" paketleme ünitesi için hiçbir ağırlık ve boyut varyantı belirlenmedi.'");
		Else
			MessageTextTemplate = NStr("vi = 'Đối với mặt hàng ""%Products%"" chưa đặt trọng lượng và (hoặc) khối lượng.';
										|ru = 'Для номенклатуры ""%Products%"" не заданы вес и(или) объем.';
										|en = 'Weight and(or) volume are not specified for the ""%Products%"" items.'; fa = 'Weight and(or) volume are not specified for the ""%Products%"" items.';
										|it = 'Per gli articoli ""%Products%"" non sono stati impostati il peso e(o) il volume.';
										|pl = 'Dla nomenklatury ""%Products%"" nie zostały podane waga i(lub) objętość.';
										|tr = 'Ağırlık ve/veya hacim ""%Products%"" öğesi için ayarlanmadı.'");
		EndIf;
		
		MessageText = StrReplace(MessageTextTemplate,"%Package%",TrimAll(Selection.PackagePresentation));
		MessageText = StrReplace(MessageText,"%Products%",TrimAll(Selection.ProductsPresentation));
		
		CommonClientServer.MessageToUser(MessageText,,,,Cancel);

	EndDo;
	
EndProcedure

// Supplements the source table with the packaging specified in the packages.
//
// Parameters:
//  ResultsTable	 - ValueTable - contains the following columns:
//  	*	Products	 - CatalogRef.Products
//  	*	Characteristic	 - CatalogRef.ItemsCharacteristics
//  	*	Purpose		 - CatalogRef.Assignments
//  	*	Series			 - CatalogRef.ItemsBatches
//  	*	Package		 - CatalogRef.PackagesAndUnitsOfMeasure
//  	*	Cell			 - CatalogRef.StorageBins
//  	*	NumberOfPackages - Number
//  	*	Count		 - Number
//  	*	PackageWeight		 - Number - the weight of the added items will be zero, since the tare weight must be taken into account in the package weight
//  	*	PackageVolume	 - Number - the volume of added items will be zero, because the volume of the container must be taken into account in the volume of the package
//  	*	Code				 - String - cell code
//  	*	WarehouseZone	 - CatalogRef.WarehouseZones
//
Procedure AddMultiTurnContainerToPlacementTable(ResultsTable) Export
	
	If Not GetFunctionalOption("UseReusablePackage") Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	ResultsTable.Products,
	|	ResultsTable.Characteristic,
	|	ResultsTable.Purpose,
	|	ResultsTable.Series,
	|	ResultsTable.Package,
	|	ResultsTable.Cell,
	|	ResultsTable.NumberOfPackages,
	|	ResultsTable.Count,
	|	ResultsTable.PackageWeight,
	|	ResultsTable.PackageVolume,
	|	ResultsTable.TabIndex,
	|	ResultsTable.Code,
	|	ResultsTable.WarehouseZone
	|INTO ResultsTableWithoutGrouping
	|FROM
	|	&ResultsTable AS ResultsTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResultsTable.Products,
	|	ResultsTable.Characteristic,
	|	ResultsTable.Purpose,
	|	ResultsTable.Series,
	|	ResultsTable.Package,
	|	ResultsTable.Cell,
	|	SUM(ResultsTable.NumberOfPackages) AS NumberOfPackages,
	|	SUM(ResultsTable.Count) AS Count,
	|	ResultsTable.PackageWeight,
	|	ResultsTable.PackageVolume,
	|	ResultsTable.TabIndex,
	|	ResultsTable.Code,
	|	ResultsTable.WarehouseZone
	|INTO ResultsTable
	|FROM
	|	ResultsTableWithoutGrouping AS ResultsTable
	|
	|GROUP BY
	|	ResultsTable.Package,
	|	ResultsTable.PackageWeight,
	|	ResultsTable.PackageVolume,
	|	ResultsTable.Purpose,
	|	ResultsTable.Cell,
	|	ResultsTable.Code,
	|	ResultsTable.Characteristic,
	|	ResultsTable.Products,
	|	ResultsTable.Series,
	|	ResultsTable.TabIndex,
	|	ResultsTable.WarehouseZone
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.TaraProducts AS TaraProducts,
	|	NestedQuery.TaraCharacteristic AS TaraCharacteristic,
	|	NestedQuery.Cell AS Cell,
	|	NestedQuery.TabIndex,
	|	NestedQuery.Code,
	|	NestedQuery.WarehouseZone,
	|	SUM(NestedQuery.NumberOfContainers) AS NumberOfContainers
	|INTO PackagingContainers
	|FROM
	|	(SELECT
	|		ResultsTable.NumberOfPackages * RepackagingOptions.Count AS NumberOfContainers,
	|		ResultsTable.Cell AS Cell,
	|		ResultsTable.TabIndex AS TabIndex,
	|		ResultsTable.Code AS Code,
	|		ResultsTable.WarehouseZone AS WarehouseZone,                      
	|		RepackagingOptions.Package.ReusablePackageItems AS TaraProducts,
	|		RepackagingOptions.Package.ReusablePackageVariant AS TaraCharacteristic
	|	FROM
	|		ResultsTable AS ResultsTable
	|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|			ON ResultsTable.Package = RepackagingOptions.Source
	|	WHERE
	|		RepackagingOptions.Package.SuppliedInReusablePackage
	|		AND CAST(ResultsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|		AND ResultsTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ResultsTable.NumberOfPackages,
	|		ResultsTable.Cell,
	|		ResultsTable.TabIndex,
	|		ResultsTable.Code,
	|		ResultsTable.WarehouseZone,
	|		CAST(ResultsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageItems,
	|		CAST(ResultsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageVariant
	|	FROM
	|		ResultsTable AS ResultsTable
	|	WHERE
	|		CAST(ResultsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).SuppliedInReusablePackage
	|		AND CAST(ResultsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.TaraProducts,
	|	NestedQuery.TaraCharacteristic,
	|	NestedQuery.Cell,
	|	NestedQuery.TabIndex,
	|	NestedQuery.Code,
	|	NestedQuery.WarehouseZone
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Purpose,
	|	NestedQuery.Series,
	|	NestedQuery.Package,
	|	SUM(NestedQuery.NumberOfPackages) AS NumberOfPackages,
	|	SUM(NestedQuery.Count) AS Count,
	|	NestedQuery.PackageWeight,
	|	NestedQuery.PackageVolume,
	|	NestedQuery.Cell,
	|	NestedQuery.TabIndex,
	|	NestedQuery.Code,
	|	NestedQuery.WarehouseZone
	|FROM
	|	(SELECT
	|		ResultsTable.Products AS Products,
	|		ResultsTable.Characteristic AS Characteristic,
	|		ResultsTable.Purpose,
	|		ResultsTable.Series AS Series,
	|		ResultsTable.Package AS Package,
	|		ResultsTable.NumberOfPackages AS NumberOfPackages,
	|		ResultsTable.Count AS Count,
	|		ResultsTable.PackageWeight AS PackageWeight,
	|		ResultsTable.PackageVolume AS PackageVolume,
	|		ResultsTable.Cell AS Cell,
	|		ResultsTable.TabIndex AS TabIndex,
	|		ResultsTable.Code AS Code,
	|		ResultsTable.WarehouseZone AS WarehouseZone
	|	FROM
	|		ResultsTable AS ResultsTable
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		PackagingContainers.TaraProducts,
	|		PackagingContainers.TaraCharacteristic,
	|		VALUE(Catalog.Assignments.EmptyRef),
	|		VALUE(Catalog.ItemsBatches.EmptyRef),
	|		VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef),
	|		PackagingContainers.NumberOfContainers,
	|		PackagingContainers.NumberOfContainers,
	|		0,
	|		0,
	|		PackagingContainers.Cell,
	|		PackagingContainers.TabIndex,
	|		PackagingContainers.Code,
	|		PackagingContainers.WarehouseZone
	|	FROM
	|		PackagingContainers AS PackagingContainers) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Purpose,
	|	NestedQuery.Series,
	|	NestedQuery.Package,
	|	NestedQuery.PackageWeight,
	|	NestedQuery.PackageVolume,
	|	NestedQuery.Cell,
	|	NestedQuery.TabIndex,
	|	NestedQuery.Code,
	|	NestedQuery.WarehouseZone";
	
	Query.SetParameter("ResultsTable", ResultsTable);
	
	ResultsTable = Query.Execute().Unload(); 
	
EndProcedure

// Parameters:
// 	TempTablesManager - TempTablesManager - 
// 	TableStructure - See PlaceGoodsInCells
// 	SelectionBySeries - QueryResultSelection - 
// 	ArrayOfPlots - Array - 
// 	NumberOfPackages - Number - 
Procedure PlaceProductPosition(TempTablesManager, TableStructure, SelectionBySeries, ArrayOfPlots, NumberOfPackages)
		
	ByFEFO = SelectionBySeries.BatchesAccountingByFEFO;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	
	TextStrategyPriority =
	"CASE	
	|	WHEN VALUE(Catalog.Assignments.EmptyRef) <> &Purpose AND CellPool.SeparateStorageArea		 
	|		THEN CASE
	|				WHEN ResiduesInCells.Cell IS NULL
	|					THEN 1 			
	|			 	ELSE CASE
	|						WHEN ResiduesInCells.ThereIsNecessaryAppointment
	|							THEN 0
	|						ELSE &BrokenMonotowarity
	|					  END
	|			  END			
	|		ELSE CASE
	|			WHEN ResiduesInCells.Cell IS NULL 
	|				THEN CASE
	|						WHEN CellPool.StrictlySingleProductBins 
	|							THEN 1
	|						ELSE CellPool.PriorityOfPlacementIntoEmptyBins
	|					  END
	|			ELSE CASE		 
	|					WHEN CellPool.SingleProductDescription = VALUE(Enum.SingleProductDescription.RemainingGoodsByShelfLives)
	|						THEN CASE
	|								WHEN ResiduesInCells.ThereIsNecessaryProductRange
	|										AND ResiduesInCells.NumberOfDifferentProductsInCell = 1 
	|										AND ResiduesInCells.NumberOfProducts_ <= 1
	|									THEN CASE
	|											WHEN CellPool.StrictlySingleProductBins 
	|												THEN 0
	|       	                           		ELSE CellPool.PriorityOfPlacementIntoSingleProductBins
	|									  	  END
	|								ELSE CASE
	|										WHEN CellPool.StrictlySingleProductBins 
	|											THEN &BrokenMonotowarity
	|           	                        ELSE CASE									
	|											  	WHEN ResiduesInCells.ThereIsNecessaryProductRange
	|													THEN CellPool.PriorityOfPlacementIntoMixedStorageBins
	|												ELSE CellPool.PriorityOfPlacementIntoBinsWithOtherGoodsOfKind
	|									 		  END
	|									  END				
	|							   END
	|					ELSE CASE
	|							WHEN CellPool.SingleProductDescription = VALUE(Enum.SingleProductDescription.ByItemVariant)
	|								THEN
	|									CASE
	|										WHEN ResiduesInCells.ThereIsNecessaryProductAndCharacteristics
	|												AND ResiduesInCells.NumberOfDifferentProductsInCell = 1
	|												AND ResiduesInCells.NumberOfProducts_ <= 1
	|												AND ResiduesInCells.NumberOfDifferentCharacteristicsPerCell = 1
	|												AND ResiduesInCells.NumberOfCharacteristics <= 1
	|											THEN CASE
	|													WHEN CellPool.StrictlySingleProductBins 
	|														THEN 0
	|           	                       				ELSE CellPool.PriorityOfPlacementIntoSingleProductBins
	|									  	 		  END
	|										ELSE CASE
	|												WHEN CellPool.StrictlySingleProductBins 
	|													THEN &BrokenMonotowarity
	|                              			     	ELSE CASE									
	|													  	WHEN ResiduesInCells.ThereIsNecessaryProductAndCharacteristics
	|															THEN CellPool.PriorityOfPlacementIntoMixedStorageBins
	|														ELSE CellPool.PriorityOfPlacementIntoBinsWithOtherGoodsOfKind
	|									 				  END
	|											  END				
	|									END
	|								ELSE
	|									CASE
	|										WHEN ResiduesInCells.ThereIsNecessaryProductAndCharacteristicsAndSeries
	|												AND ResiduesInCells.NumberOfDifferentProductsInCell = 1
	|												AND ResiduesInCells.NumberOfProducts_ <= 1
	|												AND ResiduesInCells.NumberOfDifferentCharacteristicsPerCell = 1
	|												AND ResiduesInCells.NumberOfCharacteristics <= 1
	|												AND ResiduesInCells.NumberOfDifferentSeriesPerCell = 1
	|												AND ResiduesInCells.SeriesCount <= 1
	|											THEN CASE
	|													WHEN CellPool.StrictlySingleProductBins 
	|														THEN 0
	|                   	               				ELSE CellPool.PriorityOfPlacementIntoSingleProductBins
	|									  	 		  END
	|										ELSE CASE
	|												WHEN CellPool.StrictlySingleProductBins 
	|													THEN &BrokenMonotowarity
	| 	                             		     	ELSE CASE									
	|													  	WHEN ResiduesInCells.ThereIsNecessaryProductAndCharacteristicsAndSeries
	|															THEN CellPool.PriorityOfPlacementIntoMixedStorageBins
	|														ELSE CellPool.PriorityOfPlacementIntoBinsWithOtherGoodsOfKind
	|									 				  END
	|											  END				
	|									END
	|						END
	|			END
	|	END
	|END";
	
	QueryText = 
	"SELECT
	|	CellTable.Cell AS Cell,
	|	CellTable.FreeVolume_ - ISNULL(CellFillingTable.VolumeM3, 0) AS FreeVolume_,
	|	CellTable.FreeWeight - ISNULL(CellFillingTable.Weight, 0) AS FreeWeight,
	|	CellTable.NotLimitedByCarryingCapacity AS NotLimitedByCarryingCapacity,
	|	CellTable.NotLimitedByDimensions AS NotLimitedByDimensions,
	|	CellTable.TabIndex AS TabIndex,
	|	CellTable.WarehouseZone AS WarehouseZone,                                         
	|	CellTable.AreaPriority AS AreaPriority,
	|	CellTable.SeparateStorageArea AS SeparateStorageArea,
	|	CellTable.PriorityOfPlacementIntoEmptyBins AS PriorityOfPlacementIntoEmptyBins,
	|	CellTable.PriorityOfPlacementIntoSingleProductBins AS PriorityOfPlacementIntoSingleProductBins,
	|	CellTable.PriorityOfPlacementIntoMixedStorageBins AS PriorityOfPlacementIntoMixedStorageBins,
	|	CellTable.PriorityOfPlacementIntoBinsWithOtherGoodsOfKind AS PriorityOfPlacementIntoBinsWithOtherGoodsOfKind,
	|	CellTable.AvailabilityLevel AS AvailabilityLevel,
	|	CellTable.Code AS Code,   
	|	CellTable.RecalculationStatus AS RecalculationStatus,
	|	CellTable.SingleProductDescription AS SingleProductDescription,   
	|	CellTable.StrictlySingleProductBins AS StrictlySingleProductBins
	|INTO CellPool
	|FROM
	|	CellTable AS CellTable
	|		LEFT JOIN CellFillingTable AS CellFillingTable
	|		ON CellTable.Cell = CellFillingTable.Cell
	|WHERE
	|	CellTable.WarehouseGroupOfProducts = &WarehouseGroupOfProducts
	|	AND CellTable.WarehouseGroupOfPackages = &WarehouseGroupOfPackages
	// All cells from the separate storage area and cells from the regular storage area are available for the placement of goods for the destination
	// , but only for goods whose property physically differs from the destination = True.
	| 	AND (CASE
	|		WHEN VALUE(Catalog.Assignments.EmptyRef) = &Purpose 
	|			THEN NOT CellTable.SeparateStorageArea
	|		ELSE
	|			CASE WHEN CellTable.SeparateStorageArea  
	|					THEN TRUE
	|			ELSE CellTable.PhysicallyDifferentFromAssignment
	|			END
	|		END)				
	|	AND (CellTable.NotLimitedByDimensions
	|			OR NOT &LimitByVolume
	|			OR CellTable.Width >= &Width
	|				AND CellTable.Depth >= &Depth
	|				AND CellTable.Height >= &Height
	|				AND CellTable.FreeVolume_ - ISNULL(CellFillingTable.VolumeM3, 0) >= &VolumeM3)
	|	AND (CellTable.NotLimitedByCarryingCapacity
	|			OR NOT &LimitByWeight
	|			OR CellTable.FreeWeight - ISNULL(CellFillingTable.Weight, 0) >= &Weight)
	|	AND CASE
	|			WHEN &Dimensionless
	|				THEN CellTable.NotLimitedByDimensions
	|			ELSE TRUE
	|		END
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ItemsInBalancesCellsWithResults.Cell AS Cell,
	|	MAX(CASE
	|			WHEN ItemsInBalancesCellsWithResults.Products = &Products
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS ThereIsNecessaryProductRange,
	|	MAX(CASE
	|			WHEN ItemsInBalancesCellsWithResults.Characteristic = &Characteristic
	|					AND ItemsInBalancesCellsWithResults.Products = &Products
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS ThereIsNecessaryProductAndCharacteristics,
	|	MAX(CASE
	|			WHEN ItemsInBalancesCellsWithResults.Characteristic = &Characteristic
	|					AND ItemsInBalancesCellsWithResults.Products = &Products
	|					AND ItemsInBalancesCellsWithResults.Series = &Series
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS ThereIsNecessaryProductAndCharacteristicsAndSeries,
	|	COUNT(DISTINCT ItemsInBalancesCellsWithResults.Products) AS NumberOfDifferentProductsInCell,
	|	COUNT(DISTINCT ItemsInBalancesCellsWithResults.Characteristic) AS NumberOfDifferentCharacteristicsPerCell,
	|	COUNT(DISTINCT ItemsInBalancesCellsWithResults.Series) AS NumberOfDifferentSeriesPerCell,
	|	MIN(ItemsInBalancesCellsWithResults.NewNomenclature) AS NewNomenclature,
	|	MIN(ItemsInBalancesCellsWithResults.NewProductsOrCharacteristics) AS NewProductsOrCharacteristics,
	|	MIN(ItemsInBalancesCellsWithResults.NewProductsOrCharacteristics) AS NewProductOrFeatureOrSeries,
	|	MAX(CASE
	|			WHEN ItemsInBalancesCellsWithResults.Purpose = &Purpose
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS ThereIsNecessaryAppointment,
	|	MAX(CASE
	|				WHEN ItemsInBalancesCellsWithResults.SeparateStorageArea
	|				THEN CASE
	|						WHEN ItemsInBalancesCellsWithResults.Purpose <> VALUE(Catalog.Assignments.EmptyRef)
	|							AND ItemsInBalancesCellsWithResults.Purpose <> &Purpose
	|						THEN TRUE
	|						ELSE FALSE
	|					  END	
	|				ELSE FALSE
	|			END) AS CellForDifferentPurpose
	|INTO ResiduesInCellsWithoutQuantity
	|FROM
	|	(SELECT
	|		GoodsInStorageBinsBalance.Cell AS Cell,
	|		GoodsInStorageBinsBalance.Products AS Products,
	|		GoodsInStorageBinsBalance.Characteristic AS Characteristic,
	|		GoodsInStorageBinsBalance.Series AS Series,
	|		TRUE AS NewNomenclature,
	|		TRUE AS NewProductsOrCharacteristics,
	|		TRUE AS NewProductOrFeatureOrSeries,
	// I do not take into account the purpose in the cells of non-isolated storage. There, this sign does not affect anything.
	|		CASE
	|			WHEN CellPool.SeparateStorageArea
	|				THEN GoodsInStorageBinsBalance.Purpose
	|			ELSE VALUE(Catalog.Assignments.EmptyRef)
	|		END AS Purpose,
	|		CellPool.SeparateStorageArea AS SeparateStorageArea
	|	FROM
	|		CellPool AS CellPool
	|			INNER JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
	|			ON CellPool.Cell = GoodsInStorageBinsBalance.Cell
	|	WHERE
	|		GoodsInStorageBinsBalance.Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		CellFillingTable.Cell,
	|		ISNULL(TableOfPlacedProducts.Products, VALUE(Catalog.Products.EmptyRef)),
	|		ISNULL(TableOfPlacedProducts.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)),
	|		ISNULL(TableOfPlacedProducts.Series, VALUE(Catalog.ItemsBatches.EmptyRef)),
	|		CASE
	|			WHEN ISNULL(TableOfPlacedProducts.Products, VALUE(Catalog.Products.EmptyRef)) <> &Products
	|				THEN TRUE
	|			ELSE FALSE
	|		END,
	|		CASE
	|			WHEN ISNULL(TableOfPlacedProducts.Products, VALUE(Catalog.Products.EmptyRef)) <> &Products
	|					OR ISNULL(TableOfPlacedProducts.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) <> &Characteristic
	|				THEN TRUE
	|			ELSE FALSE
	|		END,
	|		CASE
	|			WHEN ISNULL(TableOfPlacedProducts.Products, VALUE(Catalog.Products.EmptyRef)) <> &Products
	|					OR ISNULL(TableOfPlacedProducts.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) <> &Characteristic
	|					OR ISNULL(TableOfPlacedProducts.Series, VALUE(Catalog.ItemsBatches.EmptyRef)) <> &Series
	|				THEN TRUE
	|			ELSE FALSE
	|		END,
	|		CASE
	|			WHEN VALUE(Catalog.Assignments.EmptyRef) <> &Purpose AND CellPool.SeparateStorageArea
	|				THEN CellFillingTable.Purpose
	|			ELSE VALUE(Catalog.Assignments.EmptyRef)
	|		END AS Purpose,
	|		CellPool.SeparateStorageArea  
	|	FROM
	|		CellFillingTable AS CellFillingTable
	|			INNER JOIN CellPool AS CellPool
	|			ON (CellPool.Cell = CellFillingTable.Cell)
	|			LEFT JOIN TableOfPlacedProducts AS TableOfPlacedProducts
	|			ON (TableOfPlacedProducts.Cell = CellFillingTable.Cell)) AS ItemsInBalancesCellsWithResults
	|
	|GROUP BY
	|	ItemsInBalancesCellsWithResults.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResiduesInCellsWithoutQuantity.Cell,
	|	ResiduesInCellsWithoutQuantity.ThereIsNecessaryProductRange,
	|	ResiduesInCellsWithoutQuantity.ThereIsNecessaryProductAndCharacteristics,
	|	ResiduesInCellsWithoutQuantity.ThereIsNecessaryProductAndCharacteristicsAndSeries,
	|	ResiduesInCellsWithoutQuantity.NumberOfDifferentProductsInCell,
	|	ResiduesInCellsWithoutQuantity.NumberOfDifferentCharacteristicsPerCell,
	|	ResiduesInCellsWithoutQuantity.NumberOfDifferentSeriesPerCell,
	|	ISNULL(CellFillingTable.NumberOfProducts_,0) AS NumberOfProducts_,
	|	ISNULL(CellFillingTable.NumberOfCharacteristics,0) AS NumberOfCharacteristics,
	|	ISNULL(CellFillingTable.SeriesCount,0) AS SeriesCount,
	|	ResiduesInCellsWithoutQuantity.NewNomenclature,
	|	ResiduesInCellsWithoutQuantity.NewProductsOrCharacteristics,
	|	ResiduesInCellsWithoutQuantity.NewProductOrFeatureOrSeries,
	|	ResiduesInCellsWithoutQuantity.ThereIsNecessaryAppointment,
	|	ResiduesInCellsWithoutQuantity.CellForDifferentPurpose 
	|INTO ResiduesInCells
	|FROM
	|	ResiduesInCellsWithoutQuantity AS ResiduesInCellsWithoutQuantity
	|		LEFT JOIN CellFillingTable AS CellFillingTable
	|		ON ResiduesInCellsWithoutQuantity.Cell = CellFillingTable.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// since it is guaranteed
	// that at least one package can be placed in each cell, it is enough to choose the number
	// of cells equal to the number of packages.
	|SELECT &QueryTextSelectFirstRecords,
	|	CellPool.Cell AS Cell,
	|	CellPool.Code AS Code,
	|	CellPool.FreeVolume_,
	|	CASE
	|		WHEN CellPool.SeparateStorageArea
	|			THEN -CellPool.FreeVolume_
	|		ELSE CellPool.FreeVolume_
	|	END FreeVolumeOrder,
	|	CellPool.FreeWeight,
	|	CellPool.SeparateStorageArea,
	|	CellPool.AreaPriority,
	|	CellPool.NotLimitedByCarryingCapacity,
	|	CellPool.NotLimitedByDimensions,
	|	CellPool.TabIndex AS TabIndex,
	|	CellPool.WarehouseZone AS WarehouseZone,
	|	CellPool.AvailabilityLevel AS AvailabilityLevel,
	|	ISNULL(ResiduesInCells.NewNomenclature, TRUE) AS NewNomenclature,
	|	ISNULL(ResiduesInCells.NewProductsOrCharacteristics, TRUE) AS NewProductsOrCharacteristics,
	|	ISNULL(ResiduesInCells.NewProductOrFeatureOrSeries, TRUE) AS NewProductOrFeatureOrSeries,
	|	&ByFEFOParameter1,
	|	&TextStrategyPriority AS StrategyPriority,
	|	ISNULL(ResiduesInCells.ThereIsNecessaryAppointment, FALSE) AS ThereIsNecessaryAppointment
	|FROM
	|	CellPool AS CellPool
	|		LEFT JOIN ResiduesInCells AS ResiduesInCells
	|		ON CellPool.Cell = ResiduesInCells.Cell
	|		,&ByFEFOParameter2
	|WHERE 
	|	&TextStrategyPriority <> &BrokenMonotowarity
	|	AND NOT ISNULL(ResiduesInCells.CellForDifferentPurpose, FALSE)
	|ORDER BY
	|	CellPool.RecalculationStatus,
	|	CellPool.AreaPriority,
	|	StrategyPriority,
	|	&ByFEFOParameter3,
	|	AvailabilityLevel,
	// Ordering by free volume:
	// - descending for cells from the normal storage area;
	// In the field of conventional storage, such sorting manages to minimize the number of cells in which
	// the placed goods can fit. - ascending (descending with a minus sign) for cells from the separate storage area;
	// In the field of separate storage, such sorting manages to minimize the total number of cells/space
	// occupied for the purpose.
	|	FreeVolumeOrder DESC,
	|	TabIndex,
	|	Code
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP CellPool
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ResiduesInCells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ResiduesInCellsWithoutQuantity";
	
	BrokenMonotowarity = 10;//this number is obviously more than the priority of any strategy
	
	QueryText = StrReplace(QueryText, "&TextStrategyPriority", TextStrategyPriority);
	
	If ValueIsFilled(SelectionBySeries.Package) Then
		QuantityForSelection = ?(Int(NumberOfPackages) > 0,
										Round(NumberOfPackages),
										1);
		QueryText = StrReplace(QueryText, "&QueryTextSelectFirstRecords,",
			"TOP " + Format(QuantityForSelection,"NG=")); //@query-part-2
	Else
		QueryText = StrReplace(QueryText, "&QueryTextSelectFirstRecords,", "");
	EndIf;

	If ByFEFO Then
		QueryText = StrReplace(QueryText, "&ByFEFOParameter1,", "ISNULL(MaximumShelfLifeInCells.ValidUntil_, DATETIME(1, 1, 1, 0, 0, 0)) AS ValidUntil_,"); //@Query-part-2
		QueryText = StrReplace(QueryText, ",&ByFEFOParameter2", "		LEFT JOIN MaximumShelfLifeInCells AS MaximumShelfLifeInCells
									|		ON (MaximumShelfLifeInCells.Products = &Products)
									|			AND (MaximumShelfLifeInCells.Characteristic = &Characteristic)
									|			AND CellPool.Cell = MaximumShelfLifeInCells.Cell"); //@Query-part-2
		QueryText = StrReplace(QueryText, "&ByFEFOParameter3,", "ValidUntil_,");
	Else	
		QueryText = StrReplace(QueryText, "&ByFEFOParameter1,", "");
		QueryText = StrReplace(QueryText, ",&ByFEFOParameter2", "");
		QueryText = StrReplace(QueryText, "&ByFEFOParameter3,", "");
	EndIf;

	Query.Text = QueryText;
	
	Query.SetParameter("BrokenMonotowarity",BrokenMonotowarity);
	
	Query.SetParameter("WarehouseGroupOfProducts",SelectionBySeries.WarehouseGroupOfProducts);
	Query.SetParameter("Products",SelectionBySeries.Products);
	Query.SetParameter("Characteristic",SelectionBySeries.Characteristic);
	Query.SetParameter("Purpose",SelectionBySeries.Purpose);
	Query.SetParameter("Series",SelectionBySeries.Series);
	Query.SetParameter("WarehouseGroupOfPackages",SelectionBySeries.WarehouseGroupOfPackages);
	
	// If the package does not fit in size, then the cell is not needed
	Query.SetParameter("Width",SelectionBySeries.Width);
	Query.SetParameter("Depth",SelectionBySeries.Depth);
	Query.SetParameter("Height",SelectionBySeries.Height);
	
	// If at least one package does not fit into a cell by weight or volume, then the cell is not needed.
	If ValueIsFilled(SelectionBySeries.Package) Then
		Query.SetParameter("Weight",SelectionBySeries.Weight);
		Query.SetParameter("VolumeM3",SelectionBySeries.VolumeM3);
	Else
		Query.SetParameter("Weight",SelectionBySeries.Weight/1000);
		Query.SetParameter("VolumeM3",SelectionBySeries.VolumeM3/1000);
	EndIf;
	Query.SetParameter("LimitByWeight",SelectionBySeries.LimitByWeight);
	Query.SetParameter("LimitByVolume",SelectionBySeries.LimitByVolume);
	
	// Dimensionless packages can only be placed in cells of unlimited dimensions
	Query.SetParameter("Dimensionless",SelectionBySeries.Dimensionless);
	
	RequestPackage = Query.ExecuteBatch(); 
	
	CellSelection = RequestPackage[3].Select();
	
	VeryLargeNumber = 99999999999;
	
	QuantityToBePlaced = SelectionBySeries.NumberOfPackages;
	
	While CellSelection.Next()
		And QuantityToBePlaced > 0 Do
		
		FullnessLine = TableStructure.CellFillingTable.Find(CellSelection.Cell, "Cell");
		
		If FullnessLine = Undefined Then
			// Let's add a row to the fullness table, because we will put at least one package in any case.
			FullnessLine 				= TableStructure.CellFillingTable.Add();
			
			FullnessLine.Cell 			= CellSelection.Cell;
			FullnessLine.VolumeM3 			= 0;
			FullnessLine.Weight  			= 0;
			
			// Fill in the assignment for cells from the separate storage area
			If SelectionBySeries.Purpose <> Catalogs.Assignments.EmptyRef() 
				And CellSelection.SeparateStorageArea Then
					FullnessLine.Purpose = SelectionBySeries.Purpose;
			EndIf;	
			
			WarehouseZone = ArrayOfPlots.Find(CellSelection.WarehouseZone);
			
			If WarehouseZone = Undefined Then
				ArrayOfPlots.Add(CellSelection.WarehouseZone);
			EndIf;
			
		EndIf;
		
		If CellSelection.NotLimitedByDimensions Or Not SelectionBySeries.LimitByVolume Then
			TotalWillFitInCellByVolume = VeryLargeNumber;
		ElsIf ValueIsFilled(SelectionBySeries.Package) Then
			TotalWillFitInCellByVolume = Int(CellSelection.FreeVolume_/SelectionBySeries.VolumeM3);
		Else
			TotalWillFitInCellByVolume = Round(CellSelection.FreeVolume_/SelectionBySeries.VolumeM3,3,RoundMode.Round15as10);
			If QuantityToBePlaced < TotalWillFitInCellByVolume + 0.001 Then
				TotalWillFitInCellByVolume = QuantityToBePlaced;
			Else
				TotalWillFitInCellByVolume = Int(CellSelection.FreeVolume_/SelectionBySeries.VolumeM3);
			EndIf;
		EndIf;
		
		If CellSelection.NotLimitedByCarryingCapacity Or Not SelectionBySeries.LimitByWeight Then
			TotalWillFitInCellByWeight = VeryLargeNumber;
		ElsIf ValueIsFilled(SelectionBySeries.Package) Then
			TotalWillFitInCellByWeight = Int(CellSelection.FreeWeight/SelectionBySeries.Weight);
		Else
			TotalWillFitInCellByWeight = Round(CellSelection.FreeWeight/SelectionBySeries.Weight,3,RoundMode.Round15as10);
			If QuantityToBePlaced < TotalWillFitInCellByWeight + 0.001 Then
				TotalWillFitInCellByWeight = QuantityToBePlaced;
			Else
				TotalWillFitInCellByWeight = Int(CellSelection.FreeWeight/SelectionBySeries.Weight);
			EndIf;
		EndIf;
		
		If TotalWillFitInCellByVolume > 0
			And TotalWillFitInCellByWeight > 0 Then
			
			QuantityToCell = Min(TotalWillFitInCellByVolume,TotalWillFitInCellByWeight,QuantityToBePlaced);
			
			ResultString1 = TableStructure.ResultsTable.Add();
			FillPropertyValues(ResultString1,CellSelection);
			FillPropertyValues(ResultString1,SelectionBySeries);
			ResultString1.NumberOfPackages 	= QuantityToCell;
			ResultString1.Count			 	= QuantityToCell * SelectionBySeries.QuantityPerPackage;
			ResultString1.PackageVolume = SelectionBySeries.VolumeM3;
			ResultString1.PackageWeight   = SelectionBySeries.Weight;
			
			NewRowOfTableOfUsedCells	= TableStructure.TableOfPlacedProducts.Add();
			NewRowOfTableOfUsedCells.Cell 		   = CellSelection.Cell;
			NewRowOfTableOfUsedCells.Products   = SelectionBySeries.Products;
			NewRowOfTableOfUsedCells.Characteristic = SelectionBySeries.Characteristic;
			NewRowOfTableOfUsedCells.Series		   = SelectionBySeries.Series;
			
			FullnessLine.VolumeM3 = FullnessLine.VolumeM3 + QuantityToCell*SelectionBySeries.VolumeM3;
			FullnessLine.Weight   = FullnessLine.Weight + QuantityToCell*SelectionBySeries.Weight;
			
			If CellSelection.NewNomenclature Then
				FullnessLine.NumberOfProducts_ = FullnessLine.NumberOfProducts_ + 1;
			EndIf;
			
			If CellSelection.NewProductsOrCharacteristics Then
				FullnessLine.NumberOfCharacteristics = FullnessLine.NumberOfCharacteristics + 1;
			EndIf;
			
			If CellSelection.NewProductOrFeatureOrSeries Then
				FullnessLine.SeriesCount = FullnessLine.SeriesCount + 1;
			EndIf;
			
			QuantityToBePlaced = QuantityToBePlaced - QuantityToCell;
			
			TotalWillFitInCellByVolume = TotalWillFitInCellByVolume - QuantityToCell;
			TotalWillFitInCellByWeight   = TotalWillFitInCellByWeight - QuantityToCell;
			
		EndIf;
		
	EndDo;
	
	If QuantityToBePlaced > 0 Then
		ErrorString = TableStructure.ErrorsTable.Add();
		FillPropertyValues(ErrorString,SelectionBySeries);
		ErrorString.NumberOfPackages = QuantityToBePlaced;
		ErrorString.Count			= QuantityToBePlaced * SelectionBySeries.QuantityPerPackage;
	EndIf;
	
	UpdateTemporaryTables(TempTablesManager, TableStructure.CellFillingTable, TableStructure.TableOfPlacedProducts);
	
EndProcedure

Procedure UpdateTemporaryTables(TempTablesManager, CellFillingTable, TableOfPlacedProducts)
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"DROP CellFillingTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Table.Cell AS Cell,
	|	Table.VolumeM3 AS VolumeM3,
	|	Table.Weight AS Weight,
	|	Table.NumberOfProducts_ AS NumberOfProducts_,
	|	Table.NumberOfCharacteristics AS NumberOfCharacteristics,
	|	Table.SeriesCount AS SeriesCount,
	|	Table.Purpose AS Purpose
	|INTO CellFillingTable
	|FROM
	|	&CellFillingTable AS Table
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TableOfPlacedProducts
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Table.Cell AS Cell,
	|	Table.Products AS Products,
	|	Table.Characteristic AS Characteristic,
	|	Table.Series AS Series
	|INTO TableOfPlacedProducts
	|FROM
	|	&TableOfPlacedProducts AS Table";

	Query.SetParameter("CellFillingTable",CellFillingTable);
	Query.SetParameter("TableOfPlacedProducts",TableOfPlacedProducts);

	Query.ExecuteBatch();
	
EndProcedure

Procedure PrepareTableOfProductsForSelection(TempTablesManager)
	
	// We will exclude multi-turn containers from the selection
	// in order to first select the goods, and then supplement the selected goods with containers.
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text = 
	"SELECT
	|	ProductsTable.Products,
	|	ProductsTable.Characteristic,
	|	ProductsTable.Purpose,
	|	ProductsTable.Series,
	|	ProductsTable.ReferenceOrder,
	|	ProductsTable.DateOfShipment,
	|	ProductsTable.Priority,
	|	ProductsTable.Count,
	|	CAST(ProductsTable.Products AS Catalog.Products).WarehouseGroup AS WarehouseGroupOfProducts
	|INTO ExtendedTableOfProducts
	|FROM
	|	ProductsTable AS ProductsTable
	|WHERE
	|	CAST(ProductsTable.Products AS Catalog.Products).ItemsType <> VALUE(Enum.ItemsTypes.ReusablePackage)";	
	
	Query.Execute();
	
EndProcedure

// Constructor function 
// 
// Returns:
// 	Structure - Contains:
// 		* FlowTableFromCells - ValueTable - Contains:
// 			** Products - CatalogRef.Products
// 			** Characteristic - CatalogRef.ItemsCharacteristics
// 			** Purpose - CatalogRef.Assignments
// 			** Series - CatalogRef.ItemsBatches
// 			** Package - CatalogRef.PackagesAndUnitsOfMeasure
// 			** Cell - CatalogRef.StorageBins
// 			** NumberOfPackages - Number
// 		* ArrayOfPlots - Array
// 		* ErrorsTable - ValueTable - Contains:
// 			** Products - CatalogRef.Products
// 			** ReferenceOrder - DocumentRef.GoodsIssueNote, DocumentRef.GoodsTransferNote - 
// 			** Package - CatalogRef.PackagesAndUnitsOfMeasure
// 			** Characteristic - CatalogRef.ItemsCharacteristics
// 			** Purpose - CatalogRef.Assignments
// 			** Series - CatalogRef.ItemsBatches
// 			** Count - Number
// 			** NumberOfPackages - Number
// 		* ResultsTable - ValueTable - Contains:
// 			** Products - CatalogRef.Products
// 			** ReferenceOrder - DocumentRef.GoodsIssueNote, DocumentRef.GoodsTransferNote - 
// 			** Package - CatalogRef.PackagesAndUnitsOfMeasure
// 			** Characteristic - CatalogRef.ItemsCharacteristics
// 			** Purpose - CatalogRef.Assignments
// 			** Series - CatalogRef.ItemsBatches
//			** Cell - CatalogRef.StorageBins
// 			** Count - Number
// 			** NumberOfPackages - Number
//			** PackageWeight - Number
//			** PackageVolume - Number
//			** TabIndex - Number
//			** Code - Number
//			** WarehouseZone - CatalogRef.WarehouseZones
//			** KeyToCommunicatingWithTare - Number
// 
Function TableStructureOfProductSelectionAlgorithm()
	
	NumberType15_3 = TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative);
	
	ResultsTable = New ValueTable;
	ResultsTable.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	ResultsTable.Columns.Add("ReferenceOrder", Metadata.AccumulationRegisters.GoodsForPicking.Dimensions.ReferenceOrder.Type);
	ResultsTable.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	ResultsTable.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	ResultsTable.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));	
	ResultsTable.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	ResultsTable.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));
	ResultsTable.Columns.Add("NumberOfPackages", NumberType15_3);
	ResultsTable.Columns.Add("Count", NumberType15_3);
	ResultsTable.Columns.Add("PackageWeight", NumberType15_3);
	ResultsTable.Columns.Add("PackageVolume", New TypeDescription("Number",,,New NumberQualifiers(18,6,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("TabIndex", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("Code", New TypeDescription("String",,New StringQualifiers(19,AllowedLength.Fixed)));
	ResultsTable.Columns.Add("WarehouseZone", New TypeDescription(New TypeDescription("CatalogRef.WarehouseZones")));
	ResultsTable.Columns.Add("KeyToCommunicatingWithTare", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	
	ResultsTable.Indexes.Add("KeyToCommunicatingWithTare");
	
	FlowTableFromCells = New ValueTable;
	FlowTableFromCells.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	FlowTableFromCells.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	FlowTableFromCells.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	FlowTableFromCells.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	FlowTableFromCells.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	FlowTableFromCells.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));
	FlowTableFromCells.Columns.Add("NumberOfPackages", NumberType15_3);
	
	FlowTableFromCells.Indexes.Add("Cell,Products,Package,Characteristic,Purpose,Series");
	
	ErrorsTable = New ValueTable;
	ErrorsTable.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	ErrorsTable.Columns.Add("ReferenceOrder", Metadata.AccumulationRegisters.GoodsForPicking.Dimensions.ReferenceOrder.Type);
	ErrorsTable.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	ErrorsTable.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	ErrorsTable.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	ErrorsTable.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	ErrorsTable.Columns.Add("Count", NumberType15_3);
	ErrorsTable.Columns.Add("NumberOfPackages", NumberType15_3);
	
	ArrayOfPlots = New Array;
	
	ReturnStructure = New Structure;
	ReturnStructure.Insert("ResultsTable",ResultsTable);
	ReturnStructure.Insert("ErrorsTable",ErrorsTable);
	ReturnStructure.Insert("ArrayOfPlots",ArrayOfPlots);
	ReturnStructure.Insert("FlowTableFromCells",FlowTableFromCells);
	
	Return ReturnStructure;
	
EndFunction

Procedure SelectCellsForSelection(TempTablesManager, Warehouse, Premise, TableStructure, TareSelection)
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	// In the query, all cells for which there are residues are selected and the cells are sorted according to the rules.
	
	If TareSelection Then
		QueryText = 
		"SELECT
		|	GoodsInStorageBinsBalance.Products AS Products,
		|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
		|	GoodsInStorageBinsBalance.Purpose AS Purpose,
		|	GoodsInStorageBinsBalance.Package AS Package,
		|	GoodsInStorageBinsBalance.Cell AS Cell,
		|	GoodsInStorageBinsBalance.InStockBalance  AS InStockBalance,
		|	GoodsInStorageBinsBalance.ForPickingBalance  AS ForPickingBalance
		|INTO ProductsInBalancesCellsForQuery
		|FROM
		|	AccumulationRegister.GoodsInStorageBins.Balance(
		|			,
		|			(Products, Characteristic, Purpose) IN
		|					(SELECT
		|						ProductsTable.Products AS Products,
		|						ProductsTable.Characteristic AS Characteristic,
		|						ProductsTable.Purpose AS Purpose
		|					FROM
		|						ExtendedTableOfProducts AS ProductsTable)
		|				AND Cell IN
		|					(SELECT
		|						CatCells.Ref AS StorageBin
		|					FROM
		|						Catalog.StorageBins AS CatCells
		|							LEFT JOIN InformationRegister.StorageBinsLocks AS CellLocks
		|							ON
		|								CatCells.Ref = CellLocks.Cell
		|									AND (CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Full)
		|										OR CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Filter))
		|					WHERE
		|						CellLocks.LockType IS NULL 
		|						AND CatCells.Premise = &Premise
		|						AND CatCells.Owner = &Warehouse
		|						AND NOT CatCells.IsFolder
		|						AND (CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
		|							OR CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Archive)))) AS GoodsInStorageBinsBalance
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsInStorageBinsBalance.Cell,
		|	GoodsInStorageBinsBalance.Package,
		|	GoodsInStorageBinsBalance.Purpose,
		|	GoodsInStorageBinsBalance.InStockBalance AS InStock,
		|	GoodsInStorageBinsBalance.ForPickingBalance AS ForPicking
		|INTO RemnantsOfPackagesInContainers
		|FROM
		|	AccumulationRegister.GoodsInStorageBins.Balance(
		|			,
		|			Cell IN
		|					(SELECT
		|						ProductsInBalancesCellsForQuery.Cell
		|					FROM
		|						ProductsInBalancesCellsForQuery AS ProductsInBalancesCellsForQuery)
		|				AND Package.SuppliedInReusablePackage) AS GoodsInStorageBinsBalance
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.Cell,
		|	NestedQuery.Products AS Products,
		|	NestedQuery.Characteristic AS Characteristic,
		|	NestedQuery.Purpose AS Purpose,
		|	SUM(NestedQuery.InStock) AS InStock,
		|	SUM(NestedQuery.ForPicking) AS ForPicking
		|INTO ContainersForGoods
		|FROM
		|	(SELECT
		|		RemnantsOfPackagesInContainers.Cell AS Cell,
		|		RemnantsOfPackagesInContainers.Package.ReusablePackageItems AS Products,
		|		RemnantsOfPackagesInContainers.Package.ReusablePackageVariant AS Characteristic,
		|		RemnantsOfPackagesInContainers.Purpose AS Purpose,
		|		RemnantsOfPackagesInContainers.InStock AS InStock,
		|		RemnantsOfPackagesInContainers.ForPicking AS ForPicking
		|	FROM
		|		RemnantsOfPackagesInContainers AS RemnantsOfPackagesInContainers
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		RemnantsOfPackagesInContainers.Cell,
		|		RepackagingOptions.Package.ReusablePackageItems,
		|		RepackagingOptions.Package.ReusablePackageVariant,
		|		RemnantsOfPackagesInContainers.Purpose,
		|		RemnantsOfPackagesInContainers.InStock * RepackagingOptions.Count,
		|		RemnantsOfPackagesInContainers.ForPicking * RepackagingOptions.Count
		|	FROM
		|		RemnantsOfPackagesInContainers AS RemnantsOfPackagesInContainers
		|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
		|			ON RemnantsOfPackagesInContainers.Package = RepackagingOptions.Source) AS NestedQuery
		|
		|GROUP BY
		|	NestedQuery.Products,
		|	NestedQuery.Characteristic,
		|	NestedQuery.Purpose,
		|	NestedQuery.Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	NestedQuery.Products,
		|	NestedQuery.Characteristic,
		|	NestedQuery.Purpose,
		|	NestedQuery.Cell,
		|	SUM(NestedQuery.InStockBalance) AS InStockBalance,
		|	SUM(NestedQuery.ForPickingBalance) AS ForPickingBalance,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	NestedQuery.Cell.Code AS Code,
		|	NestedQuery.Cell.AvailabilityLevel AS AvailabilityLevel,
		|	NestedQuery.Cell.WarehouseZone AS WarehouseZone,
		|	NestedQuery.Cell.TabIndex AS TabIndex,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
		|	1 AS QuantityPerPackage,
		|	&QueryTextPackageWeight AS Weight,
		|	VALUE(Catalog.WarehousePackageGroups.EmptyRef) AS WarehouseGroupOfPackages,
		|	&QueryTextPackageVolume AS VolumeM3,
		|	FALSE AS Dimensionless,
		|	NestedQuery.Cell.StorageArea.PriorityOfPickingFromSingleProductBins AS PriorityOfPickingFromSingleProductBins,
		|	NestedQuery.Cell.StorageArea.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
		|	NestedQuery.Cell.StorageArea.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
		|	NestedQuery.Cell.StorageArea.SingleProductDescription AS SingleProductDescription,
		|	NestedQuery.Cell.StorageArea.StrictlySingleProductBins AS StrictlySingleProductBins,
		|	NestedQuery.Cell.StorageArea AS StorageArea
		|INTO GoodsInStorageBinsBalance
		|FROM
		|	(SELECT
		|		ProductsInBalancesCellsForQuery.Products AS Products,
		|		ProductsInBalancesCellsForQuery.Characteristic AS Characteristic,
		|		ProductsInBalancesCellsForQuery.Purpose AS Purpose,
		|		ProductsInBalancesCellsForQuery.Cell AS Cell,
		|	ProductsInBalancesCellsForQuery.InStockBalance AS InStockBalance,
		|	ProductsInBalancesCellsForQuery.ForPickingBalance AS ForPickingBalance
		|	FROM
		|		ProductsInBalancesCellsForQuery AS ProductsInBalancesCellsForQuery
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		ContainersForGoods.Products,
		|		ContainersForGoods.Characteristic,
		|		ContainersForGoods.Purpose,
		|		ContainersForGoods.Cell,
		|		-ContainersForGoods.InStock,
		|		-ContainersForGoods.ForPicking
		|	FROM
		|		ContainersForGoods AS ContainersForGoods) AS NestedQuery
		|
		|GROUP BY
		|	NestedQuery.Products,
		|	NestedQuery.Characteristic,
		|	NestedQuery.Purpose,
		|	NestedQuery.Cell,
		|	NestedQuery.Cell.Code,
		|	NestedQuery.Cell.AvailabilityLevel,
		|	NestedQuery.Cell.WarehouseZone,
		|	NestedQuery.Cell.TabIndex,
		|	&QueryTextPackageWeight,
		|	&QueryTextPackageVolume,
		|	NestedQuery.Cell.StorageArea.PriorityOfPickingFromSingleProductBins,
		|	NestedQuery.Cell.StorageArea.PriorityOfPickingFromMixedStorageBins,
		|	NestedQuery.Cell.StorageArea.PriorityOfPickingAgainstRemainingStock,
		|	NestedQuery.Cell.StorageArea.SingleProductDescription,
		|	NestedQuery.Cell.StorageArea.StrictlySingleProductBins,		
		|	NestedQuery.Cell.StorageArea
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP ProductsInBalancesCellsForQuery
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP RemnantsOfPackagesInContainers
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP ContainersForGoods";
		
		QueryText = StrReplace(QueryText, "&QueryTextPackageWeight", 
			Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("NestedQuery.Products.UnitOfMeasure", "NestedQuery.Products", False) );
		QueryText = StrReplace(QueryText, "&QueryTextPackageVolume", 
			Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("NestedQuery.Products.UnitOfMeasure", "NestedQuery.Products", False));
		
	Else
		
		QueryText =
		"SELECT
		|	GoodsInStorageBinsBalance.Products AS Products,
		|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
		|	GoodsInStorageBinsBalance.Purpose AS Purpose,
		|	GoodsInStorageBinsBalance.Cell AS Cell,
		|	GoodsInStorageBinsBalance.InStockBalance AS InStockBalance,
		|	GoodsInStorageBinsBalance.ForPickingBalance AS ForPickingBalance,
		|	GoodsInStorageBinsBalance.Series AS Series,
		|	GoodsInStorageBinsBalance.Cell.Code AS Code,
		|	GoodsInStorageBinsBalance.Cell.AvailabilityLevel AS AvailabilityLevel,
		|	GoodsInStorageBinsBalance.Cell.WarehouseZone AS WarehouseZone,
		|	GoodsInStorageBinsBalance.Cell.TabIndex AS TabIndex,
		|	GoodsInStorageBinsBalance.Package AS Package,
		|	ISNULL(&QueryTextPackagingFactor, 1) AS QuantityPerPackage,
		|	&QueryTextPackageWeight AS Weight,
		|	ISNULL(GoodsInStorageBinsBalance.Package.WarehouseGroup, VALUE(Catalog.WarehousePackageGroups.EmptyRef)) AS WarehouseGroupOfPackages,
		|	&QueryTextPackageVolume AS VolumeM3,
		|	ISNULL(GoodsInStorageBinsBalance.Package.Dimensionless, FALSE) AS Dimensionless,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromSingleProductBins AS PriorityOfPickingFromSingleProductBins,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.SingleProductDescription AS SingleProductDescription,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.StrictlySingleProductBins AS StrictlySingleProductBins,
		|	GoodsInStorageBinsBalance.Cell.StorageArea AS StorageArea
		|INTO GoodsInStorageBinsBalance
		|FROM
		|	AccumulationRegister.GoodsInStorageBins.Balance(
		|			,
		|			(Products, Characteristic, Purpose) IN
		|					(SELECT
		|						ProductsTable.Products AS Products,
		|						ProductsTable.Characteristic AS Characteristic,
		|						ProductsTable.Purpose AS Purpose
		|					FROM
		|						ExtendedTableOfProducts AS ProductsTable)
		|				AND Cell IN
		|					(SELECT
		|						CatCells.Ref AS StorageBin
		|					FROM
		|						Catalog.StorageBins AS CatCells
		|							LEFT JOIN InformationRegister.StorageBinsLocks AS CellLocks
		|							ON
		|								CatCells.Ref = CellLocks.Cell
		|									AND (CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Full)
		|										OR CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Filter))
		|					WHERE
		|						CellLocks.LockType IS NULL
		|						AND CatCells.Premise = &Premise
		|						AND CatCells.Owner = &Warehouse
		|						AND NOT CatCells.IsFolder
		|						AND (CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
		|							OR CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Archive)))) AS GoodsInStorageBinsBalance
		|WHERE
		|	ISNULL(GoodsInStorageBinsBalance.Package.PackageType, UNDEFINED) <> VALUE(Enum.TypesOfItemsPackages.CargoItem)";
		
		QueryText = StrReplace(QueryText, "&QueryTextPackageWeight", 
			Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
		QueryText = StrReplace(QueryText, "&QueryTextPackageVolume", 
			Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
		
	EndIf;
	QueryText = 	QueryText + ";" + Chars.LF + 
	"SELECT DISTINCT
	|	ProductsTable.Products AS Products,
	|	ProductsTable.Characteristic AS Characteristic,
	|	ProductsTable.Purpose AS Purpose,
	|	ProductsTable.Series AS Series,
	|	ProductsTable.ReferenceOrder AS ReferenceOrder,
	|	ProductsTable.DateOfShipment AS DateOfShipment,
	|	ProductsTable.Priority AS Priority,
	|	ProductsTable.Count AS Count,
	|	ProductsTable.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	GoodsInStorageBinsBalance.Cell AS Cell,
	|	GoodsInStorageBinsBalance.Code AS Code,
	|	SUM(ISNULL(GoodsInStorageBinsBalance.InStockBalance, 0) - ISNULL(GoodsInStorageBinsBalance.ForPickingBalance, 0)) AS AvailableStock,
	|	ISNULL(GoodsInStorageBinsBalance.AvailabilityLevel, 9999999999) AS AvailabilityLevel,
	|	GoodsInStorageBinsBalance.WarehouseZone AS WarehouseZone,
	|	GoodsInStorageBinsBalance.TabIndex AS TabIndex,
	|	GoodsInStorageBinsBalance.Package AS Package,
	|	GoodsInStorageBinsBalance.QuantityPerPackage AS QuantityPerPackage,
	|	GoodsInStorageBinsBalance.Weight AS Weight,
	|	GoodsInStorageBinsBalance.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	GoodsInStorageBinsBalance.VolumeM3 AS VolumeM3,
	|	GoodsInStorageBinsBalance.Dimensionless AS Dimensionless,
	|	GoodsInStorageBinsBalance.PriorityOfPickingFromSingleProductBins AS PriorityOfPickingFromSingleProductBins,
	|	GoodsInStorageBinsBalance.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
	|	GoodsInStorageBinsBalance.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
	|	GoodsInStorageBinsBalance.SingleProductDescription AS SingleProductDescription,
	|	GoodsInStorageBinsBalance.StrictlySingleProductBins AS StrictlySingleProductBins,
	|	GoodsInStorageBinsBalance.StorageArea AS StorageArea
	|INTO CellPool
	|FROM
	|	ExtendedTableOfProducts AS ProductsTable
	|		LEFT JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
	|		ON ProductsTable.Products = GoodsInStorageBinsBalance.Products
	|			AND ProductsTable.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|			AND ProductsTable.Purpose = GoodsInStorageBinsBalance.Purpose
	|			AND (CASE
	|				WHEN ProductsTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|					THEN TRUE
	|				ELSE ProductsTable.Series = GoodsInStorageBinsBalance.Series
	|			END)
	|
	|GROUP BY
	|	ProductsTable.Products,
	|	ProductsTable.Characteristic,
	|	ProductsTable.Purpose,
	|	ProductsTable.Series,
	|	ProductsTable.ReferenceOrder,
	|	ProductsTable.DateOfShipment,
	|	ProductsTable.Priority,
	|	GoodsInStorageBinsBalance.Code,
	|	ProductsTable.WarehouseGroupOfProducts,
	|	GoodsInStorageBinsBalance.Cell,
	|	ProductsTable.Count,
	|	GoodsInStorageBinsBalance.WarehouseZone,
	|	GoodsInStorageBinsBalance.TabIndex,
	|	GoodsInStorageBinsBalance.Weight,
	|	GoodsInStorageBinsBalance.Package,
	|	GoodsInStorageBinsBalance.Dimensionless,
	|	GoodsInStorageBinsBalance.WarehouseGroupOfPackages,
	|	GoodsInStorageBinsBalance.VolumeM3,
	|	GoodsInStorageBinsBalance.PriorityOfPickingFromSingleProductBins,
	|	GoodsInStorageBinsBalance.QuantityPerPackage,
	|	GoodsInStorageBinsBalance.PriorityOfPickingFromMixedStorageBins,
	|	GoodsInStorageBinsBalance.StorageArea,
	|	GoodsInStorageBinsBalance.PriorityOfPickingAgainstRemainingStock,
	|	GoodsInStorageBinsBalance.SingleProductDescription,
	|	GoodsInStorageBinsBalance.StrictlySingleProductBins,
	|	ISNULL(GoodsInStorageBinsBalance.AvailabilityLevel, 9999999999)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CellPool.Cell AS Cell,
	|	CellPool.Products AS Products,
	|	CellPool.Characteristic,
	|	CellPool.Purpose,
	|	CellPool.Series,
	|	CASE
	|		WHEN CellPool.Products = GoodsInStorageBinsBalance.Products
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS ThereIsAnotherProduct,
	|	CASE
	|		WHEN CellPool.Products = GoodsInStorageBinsBalance.Products
	|				AND CellPool.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS IsThereAnotherProductOrCharacteristic,
	|	CASE
	|		WHEN CellPool.Products = GoodsInStorageBinsBalance.Products
	|				AND CellPool.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|				AND CellPool.Series = GoodsInStorageBinsBalance.Series
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS IsThereAnotherProductOrFeatureOrSeries
	|INTO OtherProductsInCells
	|FROM
	|	CellPool AS CellPool
	|		INNER JOIN AccumulationRegister.GoodsInStorageBins.Balance(
	|				,
	|				Cell IN
	|					(SELECT DISTINCT
	|						CellPool.Cell
	|					FROM
	|						CellPool AS CellPool)) AS GoodsInStorageBinsBalance
	|		ON CellPool.Cell = GoodsInStorageBinsBalance.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherProductsInCells.Products,
	|	OtherProductsInCells.Cell,
	|	MAX(OtherProductsInCells.ThereIsAnotherProduct) AS ThereIsAnotherProduct
	|INTO Products_In_Cells
	|FROM
	|	OtherProductsInCells AS OtherProductsInCells
	|
	|GROUP BY
	|	OtherProductsInCells.Products,
	|	OtherProductsInCells.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherProductsInCells.Products,
	|	OtherProductsInCells.Cell,
	|	OtherProductsInCells.Characteristic,
	|	MAX(OtherProductsInCells.IsThereAnotherProductOrCharacteristic) AS IsThereAnotherProductOrCharacteristic
	|INTO ProductsAndCharacteristicsInCells
	|FROM
	|	OtherProductsInCells AS OtherProductsInCells
	|
	|GROUP BY
	|	OtherProductsInCells.Products,
	|	OtherProductsInCells.Cell,
	|	OtherProductsInCells.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherProductsInCells.Products,
	|	OtherProductsInCells.Cell,
	|	OtherProductsInCells.Characteristic,
	|	MAX(OtherProductsInCells.IsThereAnotherProductOrFeatureOrSeries) AS IsThereAnotherProductOrFeatureOrSeries,
	|	OtherProductsInCells.Series
	|INTO ProductsAndCharacteristicsAndSeriesInCells
	|FROM
	|	OtherProductsInCells AS OtherProductsInCells
	|
	|GROUP BY
	|	OtherProductsInCells.Products,
	|	OtherProductsInCells.Cell,
	|	OtherProductsInCells.Characteristic,
	|	OtherProductsInCells.Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CellPool.Products AS Products,
	|	CellPool.Characteristic AS Characteristic,
	|	CellPool.Purpose AS Purpose,
	|	CellPool.Series AS Series,
	|	CellPool.ReferenceOrder AS ReferenceOrder,
	|	CellPool.Count AS Count,
	|	CellPool.Cell AS Cell,
	|	CellPool.AvailableStock AS AvailableStock,
	|	CellPool.WarehouseZone AS WarehouseZone,
	|	CellPool.TabIndex AS TabIndex,
	|	CellPool.Code AS Code,
	|	CellPool.Package AS Package,
	|	CellPool.QuantityPerPackage AS QuantityPerPackage,
	|	CellPool.Weight AS Weight,
	|	CellPool.VolumeM3 AS VolumeM3,
	|	CASE
	|		WHEN CellPool.AvailableStock <= CellPool.Count / CellPool.QuantityPerPackage
	|			THEN CellPool.PriorityOfPickingAgainstRemainingStock
	|		ELSE CASE
	|				WHEN CellPool.SingleProductDescription = VALUE(Enum.SingleProductDescription.RemainingGoodsByShelfLives)
	|					THEN CASE
	|							WHEN NOT Products_In_Cells.ThereIsAnotherProduct
	|								THEN CellPool.PriorityOfPickingFromSingleProductBins
	|							ELSE CellPool.PriorityOfPickingFromMixedStorageBins
	|						END
	|				ELSE CASE
	|						WHEN CellPool.SingleProductDescription = VALUE(Enum.SingleProductDescription.ByItemVariant)
	|							THEN CASE
	|									WHEN NOT ProductsAndCharacteristicsInCells.IsThereAnotherProductOrCharacteristic
	|										THEN CellPool.PriorityOfPickingFromSingleProductBins
	|									ELSE CellPool.PriorityOfPickingFromMixedStorageBins
	|								END
	|						ELSE CASE
	|								WHEN NOT ProductsAndCharacteristicsAndSeriesInCells.IsThereAnotherProductOrFeatureOrSeries
	|									THEN CellPool.PriorityOfPickingFromSingleProductBins
	|								ELSE CellPool.PriorityOfPickingFromMixedStorageBins
	|							END
	|					END
	|			END
	|	END AS StrategyPriority,
	|	CASE
	|		WHEN GoodsPlacementRules.StorageArea IS NULL 
	|			THEN 1000
	|		ELSE GoodsPlacementRules.Priority
	|	END AS AreaPriority
	|FROM
	|	CellPool AS CellPool
	|		LEFT JOIN Products_In_Cells AS Products_In_Cells
	|		ON CellPool.Products = Products_In_Cells.Products
	|			AND CellPool.Cell = Products_In_Cells.Cell
	|		LEFT JOIN InformationRegister.GoodsPlacementRules AS GoodsPlacementRules
	|		ON CellPool.WarehouseGroupOfProducts = GoodsPlacementRules.WarehouseGroupOfProducts
	|			AND CellPool.WarehouseGroupOfPackages = GoodsPlacementRules.WarehouseGroupOfPackages
	|			AND CellPool.StorageArea = GoodsPlacementRules.StorageArea
	|			AND (GoodsPlacementRules.Premise = &Premise)
	|			AND (GoodsPlacementRules.Warehouse = &Warehouse)
	|		LEFT JOIN ProductsAndCharacteristicsInCells AS ProductsAndCharacteristicsInCells
	|		ON CellPool.Products = ProductsAndCharacteristicsInCells.Products
	|			AND CellPool.Cell = ProductsAndCharacteristicsInCells.Cell
	|			AND CellPool.Characteristic = ProductsAndCharacteristicsInCells.Characteristic
	|		LEFT JOIN ProductsAndCharacteristicsAndSeriesInCells AS ProductsAndCharacteristicsAndSeriesInCells
	|		ON CellPool.Cell = ProductsAndCharacteristicsAndSeriesInCells.Cell
	|			AND CellPool.Products = ProductsAndCharacteristicsAndSeriesInCells.Products
	|			AND CellPool.Characteristic = ProductsAndCharacteristicsAndSeriesInCells.Characteristic
	|			AND CellPool.Series = ProductsAndCharacteristicsAndSeriesInCells.Series
	|		LEFT JOIN InformationRegister.BinRecountStates AS BinRecountStates
	|		ON CellPool.Cell = BinRecountStates.Cell
	|			AND (BinRecountStates.State = VALUE(Enum.BinRecountStates.RecountIsRequired))
	|
	|ORDER BY
	|	BEGINOFPERIOD(CellPool.DateOfShipment, DAY),
	|	CellPool.Priority DESC,
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series,
	|	ISNULL(BinRecountStates.State, VALUE(Enum.BinRecountStates.EmptyRef)),
	|	AreaPriority DESC,
	|	QuantityPerPackage DESC,
	|	StrategyPriority,
	|	AvailableStock,
	|	CellPool.AvailabilityLevel,
	|	TabIndex,
	|	Code
	|TOTALS BY
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ProductsAndCharacteristicsAndSeriesInCells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ProductsAndCharacteristicsInCells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Products_In_Cells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP OtherProductsInCells
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP CellPool
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP GoodsInStorageBinsBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ExtendedTableOfProducts";
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"GoodsInStorageBinsBalance.Package", Undefined));

	Query.Text = QueryText;
	
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",Premise);
	
	SetPrivilegedMode(True);
	SamplingByOrders = Query.Execute().Select(QueryResultIteration.ByGroups);
	SetPrivilegedMode(False);
	
	SelectingRowsFromFlowTableFromCells = New Structure("Cell,Products,Package,Characteristic,Purpose,Series");
	
	While SamplingByOrders.Next() Do                  
		
		SelectionByProductType_ =  SamplingByOrders.Select(QueryResultIteration.ByGroups); 
		
		While SelectionByProductType_.Next() Do
			
			SelectionByCharacteristics = SelectionByProductType_.Select(QueryResultIteration.ByGroups);
			
			While SelectionByCharacteristics.Next() Do
				
				SelectionByDestination = SelectionByCharacteristics.Select(QueryResultIteration.ByGroups);
				
				While SelectionByDestination.Next() Do
					
					SelectionBySeries = SelectionByDestination.Select(QueryResultIteration.ByGroups);
					
					While SelectionBySeries.Next() Do  
							
						//Details_3
						CellSelection = SelectionBySeries.Select(QueryResultIteration.ByGroups);
						
						QuantityToBeSelected = Undefined;
						
						While CellSelection.Next() Do
															
							If QuantityToBeSelected = Undefined Then
								
								QuantityToBeSelected = CellSelection.Count;
								
							EndIf;
							
							If ValueIsFilled(CellSelection.Package)
								And QuantityToBeSelected < CellSelection.QuantityPerPackage Then
								Continue;
							EndIf;
							
							// If the cell is filled, it means that there is a remainder in the right package, 
							// otherwise the table of residues would not be connected to the table of nomenclature.
							If ValueIsFilled(CellSelection.Cell)
								And CellSelection.AvailableStock > 0 Then
								
								FillPropertyValues(SelectingRowsFromFlowTableFromCells, CellSelection);
								
								ArrayOfFoundStrings = TableStructure.FlowTableFromCells.FindRows(SelectingRowsFromFlowTableFromCells);
								
								If ArrayOfFoundStrings.Count() = 0 Then
									ExpenseLine 						= TableStructure.FlowTableFromCells.Add();
									FillPropertyValues(ExpenseLine, SelectingRowsFromFlowTableFromCells);
									
									ExpenseLine.NumberOfPackages 	= CellSelection.AvailableStock;
									
									WarehouseZone = TableStructure.ArrayOfPlots.Find(CellSelection.WarehouseZone);
									If WarehouseZone = Undefined Then
										TableStructure.ArrayOfPlots.Add(CellSelection.WarehouseZone);
									EndIf;
								Else
									ExpenseLine = ArrayOfFoundStrings[0];
								EndIf;
								
								If ValueIsFilled(CellSelection.Package) Then
									QuantityFromCell = Min(Int(QuantityToBeSelected/CellSelection.QuantityPerPackage),ExpenseLine.NumberOfPackages);
								Else
									QuantityFromCell = Min(QuantityToBeSelected,ExpenseLine.NumberOfPackages);
								EndIf;
								
								If QuantityFromCell > 0 Then
									ResultString1 = TableStructure.ResultsTable.Add();
									FillPropertyValues(ResultString1, CellSelection);
									ResultString1.NumberOfPackages = QuantityFromCell;
									ResultString1.Count         = QuantityFromCell * CellSelection.QuantityPerPackage;
									ResultString1.PackageVolume		= CellSelection.VolumeM3;
									ResultString1.PackageWeight		= CellSelection.Weight;
									
									ResultString1.KeyToCommunicatingWithTare = TableStructure.ResultsTable.Count();
									
									ExpenseLine.NumberOfPackages = ExpenseLine.NumberOfPackages - QuantityFromCell; 
									QuantityToBeSelected = QuantityToBeSelected - QuantityFromCell * CellSelection.QuantityPerPackage;
								EndIf;						
								
							EndIf;
							
							If QuantityToBeSelected = 0 Then
								
								Break;
								
							EndIf;
							
						EndDo;
						
						If QuantityToBeSelected <> 0 Then
							
							ErrorString = TableStructure.ErrorsTable.Add();
							FillPropertyValues(ErrorString, SelectionBySeries);
							ErrorString.Count = QuantityToBeSelected;
							
						EndIf;	
						
					EndDo;
											
				EndDo;
				
			EndDo;
			
		EndDo;
		
	EndDo;	
	
	If Not TareSelection
		And TempTablesManager.Tables.Find("TableCommodityPlacesForSelection") <> Undefined // MRM does not work with commodity items.
		And (TMCommonUse.ShowTemporaryTable(TempTablesManager, "TableCommodityPlacesForSelection").Count() <> 0
			Or TableStructure.ErrorsTable.Count() <> 0) Then
	
		QueryText =
		"SELECT
		|	ExternalTable.ReferenceOrder AS ReferenceOrder,
		|	ExternalTable.Products AS Products,
		|	ExternalTable.Characteristic AS Characteristic,
		|	ExternalTable.Purpose AS Purpose,
		|	ExternalTable.Series AS Series,
		|	ExternalTable.Package AS Package,
		|	ExternalTable.Count AS Count
		|INTO ErrorsTable
		|FROM
		|	&ErrorsTable AS ExternalTable
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ErrorsTable.ReferenceOrder AS ReferenceOrder,
		|	ISNULL(ProductsTable.Ref, VALUE(Catalog.Products.EmptyRef)) AS Products,
		|	ISNULL(ProductsTable.WarehouseGroup, VALUE(Catalog.WarehouseGroupsOfItems.EmptyRef)) AS
		|		WarehouseGroupOfProducts,
		|	ErrorsTable.Characteristic AS Characteristic,
		|	ErrorsTable.Purpose AS Purpose,
		|	ErrorsTable.Series AS Series,
		|	ISNULL(PackingTable_.Ref, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS Package,
		|	ErrorsTable.Count AS Count
		|INTO TableOfUnallocated
		|FROM
		|	ErrorsTable AS ErrorsTable
		|		LEFT JOIN Catalog.Products AS ProductsTable
		|		ON ErrorsTable.Products = ProductsTable.Ref
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackingTable_
		|		ON ErrorsTable.Package = PackingTable_.Ref
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TableOfUnallocated.ReferenceOrder,
		|	TableOfUnallocated.Products,
		|	TableOfUnallocated.Characteristic,
		|	TableOfUnallocated.Purpose,
		|	TableOfUnallocated.Series,
		|	TableOfUnallocated.WarehouseGroupOfProducts,
		|	TableOfUnallocated.Count * ISNULL(&QueryTextPackagingFactor, 1) *
		|		PackagesAndUnitsOfMeasure.NumberOfPackages AS Count,
		|	PackagesAndUnitsOfMeasure.Ref AS CargoItem
		|INTO ErrorTableProductLocations
		|FROM
		|	TableOfUnallocated AS TableOfUnallocated
		|		INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		|		ON TableOfUnallocated.Products = PackagesAndUnitsOfMeasure.Owner
		|WHERE
		|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|	AND NOT PackagesAndUnitsOfMeasure.DeletionMark
		|
		|UNION ALL
		|
		|SELECT
		|	TableOfUnallocated.ReferenceOrder,
		|	TableOfUnallocated.Products,
		|	TableOfUnallocated.Characteristic,
		|	TableOfUnallocated.Purpose,
		|	TableOfUnallocated.Series,
		|	TableOfUnallocated.WarehouseGroupOfProducts,
		|	TableOfUnallocated.Count * ISNULL(&QueryTextPackagingFactor, 1) *
		|		PackagesAndUnitsOfMeasure.NumberOfPackages,
		|	PackagesAndUnitsOfMeasure.Ref
		|FROM
		|	TableOfUnallocated AS TableOfUnallocated
		|		INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		|		ON TableOfUnallocated.Products.PackagingGroup = PackagesAndUnitsOfMeasure.Owner
		|WHERE
		|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|	AND NOT PackagesAndUnitsOfMeasure.DeletionMark
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ErrorTableProductLocations.ReferenceOrder,
		|	ErrorTableProductLocations.Products,
		|	ErrorTableProductLocations.Characteristic,
		|	ErrorTableProductLocations.Purpose,
		|	ErrorTableProductLocations.Series,
		|	ErrorTableProductLocations.WarehouseGroupOfProducts,
		|	ErrorTableProductLocations.Count,
		|	ErrorTableProductLocations.CargoItem AS CargoItem
		|INTO ProductItemsTable
		|FROM
		|	ErrorTableProductLocations AS ErrorTableProductLocations
		|
		|UNION ALL
		|
		|SELECT
		|	TableCommodityPlacesForSelection.ReferenceOrder,
		|	TableCommodityPlacesForSelection.Products,
		|	TableCommodityPlacesForSelection.Characteristic,
		|	TableCommodityPlacesForSelection.Purpose,
		|	TableCommodityPlacesForSelection.Series,
		|	TableCommodityPlacesForSelection.WarehouseGroupOfProducts,
		|	TableCommodityPlacesForSelection.Count,
		|	TableCommodityPlacesForSelection.CargoItem
		|FROM
		|	TableCommodityPlacesForSelection AS TableCommodityPlacesForSelection
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsInStorageBinsBalance.Products AS Products,
		|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
		|	GoodsInStorageBinsBalance.Purpose AS Purpose,
		|	GoodsInStorageBinsBalance.Cell AS Cell,
		|	GoodsInStorageBinsBalance.InStockBalance AS InStockBalance,
		|	GoodsInStorageBinsBalance.ForPickingBalance AS ForPickingBalance,
		|	GoodsInStorageBinsBalance.Series AS Series,
		|	GoodsInStorageBinsBalance.Cell.Code AS Code,
		|	GoodsInStorageBinsBalance.Cell.AvailabilityLevel AS AvailabilityLevel,
		|	GoodsInStorageBinsBalance.Cell.WarehouseZone AS WarehouseZone,
		|	GoodsInStorageBinsBalance.Cell.TabIndex AS TabIndex,
		|	GoodsInStorageBinsBalance.Package AS Package,
		|	&QueryTextPackageWeight AS Weight,
		|	ISNULL(GoodsInStorageBinsBalance.Package.WarehouseGroup,
		|		VALUE(Catalog.WarehousePackageGroups.EmptyRef)) AS WarehouseGroupOfPackages,
		|	&QueryTextPackageVolume AS VolumeM3,
		|	ISNULL(GoodsInStorageBinsBalance.Package.Dimensionless, FALSE) AS Dimensionless,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromSingleProductBins AS
		|		PriorityOfPickingFromSingleProductBins,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.SingleProductDescription AS SingleProductDescription,
		|	GoodsInStorageBinsBalance.Cell.StorageArea.StrictlySingleProductBins AS StrictlySingleProductBins,
		|	GoodsInStorageBinsBalance.Cell.StorageArea AS StorageArea
		|INTO GoodsInStorageBinsBalance
		|FROM
		|	AccumulationRegister.GoodsInStorageBins.Balance(, (Products, Characteristic, Purpose, Package) IN
		|		(SELECT
		|			ProductsTable.Products AS Products,
		|			ProductsTable.Characteristic AS Characteristic,
		|			ProductsTable.Purpose AS Purpose,
		|			ProductsTable.CargoItem AS Package
		|		FROM
		|			ProductItemsTable AS ProductsTable)
		|	AND Cell IN
		|		(SELECT
		|			CatCells.Ref AS StorageBin
		|		FROM
		|			Catalog.StorageBins AS CatCells
		|				LEFT JOIN InformationRegister.StorageBinsLocks AS CellLocks
		|				ON CatCells.Ref = CellLocks.Cell
		|				AND (CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Full)
		|				OR CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Filter))
		|		WHERE
		|			CellLocks.LockType IS NULL
		|			AND CatCells.Premise = &Premise
		|			AND CatCells.Owner = &Warehouse
		|			AND NOT CatCells.IsFolder
		|			AND (CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
		|			OR CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Archive)))) AS GoodsInStorageBinsBalance
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	ProductsTable.Products AS Products,
		|	ProductsTable.Characteristic AS Characteristic,
		|	ProductsTable.Purpose AS Purpose,
		|	ProductsTable.Series AS Series,
		|	ProductsTable.ReferenceOrder AS ReferenceOrder,
		|	ProductsTable.Count AS Count,
		|	ProductsTable.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
		|	GoodsInStorageBinsBalance.Cell AS Cell,
		|	GoodsInStorageBinsBalance.Code AS Code,
		|	SUM(ISNULL(GoodsInStorageBinsBalance.InStockBalance, 0) - ISNULL(GoodsInStorageBinsBalance.ForPickingBalance, 0)) AS
		|		AvailableStock,
		|	ISNULL(GoodsInStorageBinsBalance.AvailabilityLevel, 9999999999) AS AvailabilityLevel,
		|	GoodsInStorageBinsBalance.WarehouseZone AS WarehouseZone,
		|	GoodsInStorageBinsBalance.TabIndex AS TabIndex,
		|	ISNULL(GoodsInStorageBinsBalance.Package, ProductsTable.CargoItem) AS Package,
		|	GoodsInStorageBinsBalance.Weight AS Weight,
		|	GoodsInStorageBinsBalance.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
		|	GoodsInStorageBinsBalance.VolumeM3 AS VolumeM3,
		|	GoodsInStorageBinsBalance.Dimensionless AS Dimensionless,
		|	GoodsInStorageBinsBalance.PriorityOfPickingFromSingleProductBins AS PriorityOfPickingFromSingleProductBins,
		|	GoodsInStorageBinsBalance.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
		|	GoodsInStorageBinsBalance.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
		|	GoodsInStorageBinsBalance.SingleProductDescription AS SingleProductDescription,
		|	GoodsInStorageBinsBalance.StrictlySingleProductBins AS StrictlySingleProductBins,
		|	GoodsInStorageBinsBalance.StorageArea AS StorageArea
		|INTO CellPool
		|FROM
		|	ProductItemsTable AS ProductsTable
		|		LEFT JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
		|		ON ProductsTable.Products = GoodsInStorageBinsBalance.Products
		|		AND ProductsTable.Characteristic = GoodsInStorageBinsBalance.Characteristic
		|		AND ProductsTable.Purpose = GoodsInStorageBinsBalance.Purpose
		|		AND (CASE
		|			WHEN ProductsTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		|				THEN TRUE
		|			ELSE ProductsTable.Series = GoodsInStorageBinsBalance.Series
		|		END)
		|		AND ProductsTable.CargoItem = GoodsInStorageBinsBalance.Package
		|GROUP BY
		|	ProductsTable.Products,
		|	ProductsTable.Characteristic,
		|	ProductsTable.Purpose,
		|	ProductsTable.Series,
		|	ProductsTable.ReferenceOrder,
		|	GoodsInStorageBinsBalance.Code,
		|	ProductsTable.WarehouseGroupOfProducts,
		|	GoodsInStorageBinsBalance.Cell,
		|	ProductsTable.Count,
		|	GoodsInStorageBinsBalance.WarehouseZone,
		|	GoodsInStorageBinsBalance.TabIndex,
		|	GoodsInStorageBinsBalance.Weight,
		|	ISNULL(GoodsInStorageBinsBalance.Package, ProductsTable.CargoItem),
		|	GoodsInStorageBinsBalance.Dimensionless,
		|	GoodsInStorageBinsBalance.WarehouseGroupOfPackages,
		|	GoodsInStorageBinsBalance.VolumeM3,
		|	GoodsInStorageBinsBalance.PriorityOfPickingFromSingleProductBins,
		|	GoodsInStorageBinsBalance.PriorityOfPickingFromMixedStorageBins,
		|	GoodsInStorageBinsBalance.StorageArea,
		|	GoodsInStorageBinsBalance.PriorityOfPickingAgainstRemainingStock,
		|	GoodsInStorageBinsBalance.SingleProductDescription,
		|	GoodsInStorageBinsBalance.StrictlySingleProductBins,
		|	ISNULL(GoodsInStorageBinsBalance.AvailabilityLevel, 9999999999)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CellPool.Cell AS Cell,
		|	CellPool.Products AS Products,
		|	CellPool.Characteristic,
		|	CellPool.Purpose,
		|	CellPool.Series,
		|	CASE
		|		WHEN CellPool.Products = GoodsInStorageBinsBalance.Products
		|			THEN FALSE
		|		ELSE TRUE
		|	END AS ThereIsAnotherProduct,
		|	CASE
		|		WHEN CellPool.Products = GoodsInStorageBinsBalance.Products
		|		AND CellPool.Characteristic = GoodsInStorageBinsBalance.Characteristic
		|			THEN FALSE
		|		ELSE TRUE
		|	END AS IsThereAnotherProductOrCharacteristic,
		|	CASE
		|		WHEN CellPool.Products = GoodsInStorageBinsBalance.Products
		|		AND CellPool.Characteristic = GoodsInStorageBinsBalance.Characteristic
		|		AND CellPool.Series = GoodsInStorageBinsBalance.Series
		|			THEN FALSE
		|		ELSE TRUE
		|	END AS IsThereAnotherProductOrFeatureOrSeries
		|INTO OtherProductsInCells
		|FROM
		|	CellPool AS CellPool
		|		INNER JOIN AccumulationRegister.GoodsInStorageBins.Balance(, Cell IN
		|			(SELECT DISTINCT
		|				CellPool.Cell
		|			FROM
		|				CellPool AS CellPool)) AS GoodsInStorageBinsBalance
		|		ON CellPool.Cell = GoodsInStorageBinsBalance.Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	OtherProductsInCells.Products,
		|	OtherProductsInCells.Cell,
		|	MAX(OtherProductsInCells.ThereIsAnotherProduct) AS ThereIsAnotherProduct
		|INTO Products_In_Cells
		|FROM
		|	OtherProductsInCells AS OtherProductsInCells
		|GROUP BY
		|	OtherProductsInCells.Products,
		|	OtherProductsInCells.Cell
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	OtherProductsInCells.Products,
		|	OtherProductsInCells.Cell,
		|	OtherProductsInCells.Characteristic,
		|	MAX(OtherProductsInCells.IsThereAnotherProductOrCharacteristic) AS IsThereAnotherProductOrCharacteristic
		|INTO ProductsAndCharacteristicsInCells
		|FROM
		|	OtherProductsInCells AS OtherProductsInCells
		|GROUP BY
		|	OtherProductsInCells.Products,
		|	OtherProductsInCells.Cell,
		|	OtherProductsInCells.Characteristic
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	OtherProductsInCells.Products,
		|	OtherProductsInCells.Cell,
		|	OtherProductsInCells.Characteristic,
		|	MAX(OtherProductsInCells.IsThereAnotherProductOrFeatureOrSeries) AS
		|		IsThereAnotherProductOrFeatureOrSeries,
		|	OtherProductsInCells.Series
		|INTO ProductsAndCharacteristicsAndSeriesInCells
		|FROM
		|	OtherProductsInCells AS OtherProductsInCells
		|GROUP BY
		|	OtherProductsInCells.Products,
		|	OtherProductsInCells.Cell,
		|	OtherProductsInCells.Characteristic,
		|	OtherProductsInCells.Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CellPool.Products AS Products,
		|	CellPool.Characteristic AS Characteristic,
		|	CellPool.Purpose AS Purpose,
		|	CellPool.Series AS Series,
		|	CellPool.ReferenceOrder AS ReferenceOrder,
		|	CellPool.Count AS Count,
		|	CellPool.Cell AS Cell,
		|	CellPool.AvailableStock AS AvailableStock,
		|	CellPool.WarehouseZone AS WarehouseZone,
		|	CellPool.TabIndex AS TabIndex,
		|	CellPool.Code AS Code,
		|	CellPool.Package AS Package,
		|	CellPool.Package.NumberOfPackages AS QuantityIncluded,
		|	CellPool.Weight AS Weight,
		|	CellPool.VolumeM3 AS VolumeM3,
		|	CASE
		|		WHEN CellPool.AvailableStock <= CellPool.Count
		|			THEN CellPool.PriorityOfPickingAgainstRemainingStock
		|		ELSE CASE
		|			WHEN CellPool.SingleProductDescription = VALUE(Enum.SingleProductDescription.RemainingGoodsByShelfLives)
		|				THEN CASE
		|					WHEN NOT Products_In_Cells.ThereIsAnotherProduct
		|						THEN CellPool.PriorityOfPickingFromSingleProductBins
		|					ELSE CellPool.PriorityOfPickingFromMixedStorageBins
		|				END
		|			ELSE CASE
		|				WHEN CellPool.SingleProductDescription = VALUE(Enum.SingleProductDescription.ByItemVariant)
		|					THEN CASE
		|						WHEN NOT ProductsAndCharacteristicsInCells.IsThereAnotherProductOrCharacteristic
		|							THEN CellPool.PriorityOfPickingFromSingleProductBins
		|						ELSE CellPool.PriorityOfPickingFromMixedStorageBins
		|					END
		|				ELSE CASE
		|					WHEN NOT ProductsAndCharacteristicsAndSeriesInCells.IsThereAnotherProductOrFeatureOrSeries
		|						THEN CellPool.PriorityOfPickingFromSingleProductBins
		|					ELSE CellPool.PriorityOfPickingFromMixedStorageBins
		|				END
		|			END
		|		END
		|	END AS StrategyPriority,
		|	CASE
		|		WHEN GoodsPlacementRules.StorageArea IS NULL
		|			THEN 1000
		|		ELSE GoodsPlacementRules.Priority
		|	END AS AreaPriority
		|FROM
		|	CellPool AS CellPool
		|		LEFT JOIN Products_In_Cells AS Products_In_Cells
		|		ON CellPool.Products = Products_In_Cells.Products
		|		AND CellPool.Cell = Products_In_Cells.Cell
		|		LEFT JOIN InformationRegister.GoodsPlacementRules AS GoodsPlacementRules
		|		ON CellPool.WarehouseGroupOfProducts = GoodsPlacementRules.WarehouseGroupOfProducts
		|		AND CellPool.WarehouseGroupOfPackages = GoodsPlacementRules.WarehouseGroupOfPackages
		|		AND (GoodsPlacementRules.Premise = &Premise)
		|		AND (GoodsPlacementRules.Warehouse = &Warehouse)
		|		LEFT JOIN ProductsAndCharacteristicsInCells AS ProductsAndCharacteristicsInCells
		|		ON CellPool.Products = ProductsAndCharacteristicsInCells.Products
		|		AND CellPool.Cell = ProductsAndCharacteristicsInCells.Cell
		|		AND CellPool.Characteristic = ProductsAndCharacteristicsInCells.Characteristic
		|		LEFT JOIN ProductsAndCharacteristicsAndSeriesInCells AS ProductsAndCharacteristicsAndSeriesInCells
		|		ON CellPool.Cell = ProductsAndCharacteristicsAndSeriesInCells.Cell
		|		AND CellPool.Products = ProductsAndCharacteristicsAndSeriesInCells.Products
		|		AND CellPool.Characteristic = ProductsAndCharacteristicsAndSeriesInCells.Characteristic
		|		AND CellPool.Series = ProductsAndCharacteristicsAndSeriesInCells.Series
		|		LEFT JOIN InformationRegister.BinRecountStates AS BinRecountStates
		|		ON CellPool.Cell = BinRecountStates.Cell
		|		AND (BinRecountStates.State = VALUE(Enum.BinRecountStates.RecountIsRequired))
		|
		|ORDER BY
		|	ISNULL(BinRecountStates.State, VALUE(Enum.BinRecountStates.EmptyRef)),
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	Series,
		|	AreaPriority DESC,
		|	StrategyPriority,
		|	CellPool.AvailabilityLevel,
		|	TabIndex,
		|	Code
		|TOTALS
		|BY
		|	ReferenceOrder,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	Series,
		|	Package
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TableOfUnallocated.ReferenceOrder,
		|	TableOfUnallocated.Products,
		|	TableOfUnallocated.WarehouseGroupOfProducts,
		|	TableOfUnallocated.Characteristic,
		|	TableOfUnallocated.Purpose,
		|	TableOfUnallocated.Series,
		|	TableOfUnallocated.Package,
		|	TableOfUnallocated.Count
		|FROM
		|	TableOfUnallocated AS TableOfUnallocated
		|		LEFT JOIN ErrorTableProductLocations AS ErrorTableProductLocations
		|		ON TableOfUnallocated.Products = ErrorTableProductLocations.Products
		|		AND TableOfUnallocated.ReferenceOrder = ErrorTableProductLocations.ReferenceOrder
		|WHERE
		|	ErrorTableProductLocations.Products IS NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP ProductsAndCharacteristicsAndSeriesInCells
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP ProductsAndCharacteristicsInCells
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP Products_In_Cells
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP OtherProductsInCells
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP CellPool
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP GoodsInStorageBinsBalance
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP ProductItemsTable";
		
		QueryText = StrReplace(QueryText,
			"&QueryTextPackagingFactor",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"TableOfUnallocated.Package", "TableOfUnallocated.Products"));
			
		QueryText = StrReplace(QueryText, "&QueryTextPackageWeight", 
			Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
		QueryText = StrReplace(QueryText, "&QueryTextPackageVolume", 
			Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
		
		Query = New Query;
		Query.TempTablesManager = TempTablesManager;
		Query.Text = QueryText;
		
		Query.SetParameter("ErrorsTable", TableStructure.ErrorsTable.Copy());
		Query.SetParameter("Warehouse",Warehouse);
		Query.SetParameter("Premise",Premise);
		
		TableStructure.ErrorsTable.Clear();
		
		SetPrivilegedMode(True);
		ResultsArray = Query.ExecuteBatch();
		SetPrivilegedMode(False);
		
		ErrorsTable = ResultsArray[11].Unload();
		
		SamplingByOrders = ResultsArray[10].Select(QueryResultIteration.ByGroups);
		While SamplingByOrders.Next() Do
			
			SelectionByProductType_ =  SamplingByOrders.Select(QueryResultIteration.ByGroups); 
			While SelectionByProductType_.Next() Do
				
				SelectionByCharacteristics = SelectionByProductType_.Select(QueryResultIteration.ByGroups);
				While SelectionByCharacteristics.Next() Do
					
					SelectionByDestination = SelectionByCharacteristics.Select(QueryResultIteration.ByGroups);
					While SelectionByDestination.Next() Do
						
						SelectionBySeries = SelectionByDestination.Select(QueryResultIteration.ByGroups);
						While SelectionBySeries.Next() Do 
								
							SampleByPackage = SelectionBySeries.Select(QueryResultIteration.ByGroups);
							While SampleByPackage.Next() Do 
								
								QuantityToBeSelected = Undefined;
								
								//Details_3
								CellSelection = SampleByPackage.Select(QueryResultIteration.ByGroups);
								While CellSelection.Next() Do
									
									If QuantityToBeSelected = Undefined Then
										
										QuantityToBeSelected = CellSelection.Count;
										
									EndIf;
									
									// If the cell is filled, it means that there is a remainder in the right package, 
									// otherwise the table of residues would not be connected to the table of nomenclature.
									If ValueIsFilled(CellSelection.Cell)
										And CellSelection.AvailableStock > 0 Then
										
										SelectingRowsFromFlowTableFromCells = New Structure("Cell,Products,Package,Characteristic,Purpose,Series");
										FillPropertyValues(SelectingRowsFromFlowTableFromCells, CellSelection);
										
										ArrayOfFoundStrings = TableStructure.FlowTableFromCells.FindRows(SelectingRowsFromFlowTableFromCells);
										
										If ArrayOfFoundStrings.Count() = 0 Then
											ExpenseLine 						= TableStructure.FlowTableFromCells.Add();
											FillPropertyValues(ExpenseLine, SelectingRowsFromFlowTableFromCells);
											
											ExpenseLine.NumberOfPackages 	= CellSelection.AvailableStock;
											
											WarehouseZone = TableStructure.ArrayOfPlots.Find(CellSelection.WarehouseZone);
											If WarehouseZone = Undefined Then
												TableStructure.ArrayOfPlots.Add(CellSelection.WarehouseZone);
											EndIf;
										Else
											ExpenseLine = ArrayOfFoundStrings[0];
										EndIf;
										
										QuantityFromCell = Min(QuantityToBeSelected, ExpenseLine.NumberOfPackages);
										
										If QuantityFromCell > 0 Then
											ResultString1 = TableStructure.ResultsTable.Add();
											FillPropertyValues(ResultString1, CellSelection);
											ResultString1.NumberOfPackages = QuantityFromCell;
											ResultString1.Count         = QuantityFromCell / CellSelection.QuantityIncluded;
											ResultString1.PackageVolume		= CellSelection.VolumeM3;
											ResultString1.PackageWeight		= CellSelection.Weight;
											
											ResultString1.KeyToCommunicatingWithTare = TableStructure.ResultsTable.Count();
											
											ExpenseLine.NumberOfPackages = ExpenseLine.NumberOfPackages - QuantityFromCell; 
											QuantityToBeSelected = QuantityToBeSelected - QuantityFromCell;
										EndIf;						
										
									EndIf;
									
									If QuantityToBeSelected = 0 Then
										
										Break;
										
									EndIf;
									
								EndDo;
								
								If QuantityToBeSelected <> 0 Then
									
									ErrorString = TableStructure.ErrorsTable.Add();
									FillPropertyValues(ErrorString, SampleByPackage);
									ErrorString.Count = QuantityToBeSelected / SampleByPackage.QuantityIncluded;
									ErrorString.NumberOfPackages = QuantityToBeSelected;
									
								EndIf;	
								
							EndDo;
							
						EndDo;
						
					EndDo;
					
				EndDo;
				
			EndDo;
			
		EndDo;
		
		CommonClientServer.SupplementTable(ErrorsTable, TableStructure.ErrorsTable);
	
	EndIf;
	
EndProcedure

Function SupplementSelectionTableWithMultiTurnContainer(TempTablesManager, TableStructure, SelectEmptyContainers)
	
	If Not GetFunctionalOption("UseReusablePackage") Then
		Return False;
	EndIf;	
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	ResultsTable.Products,
	|	ResultsTable.ReferenceOrder,
	|	ResultsTable.Package,
	|	ResultsTable.Characteristic,
	|	ResultsTable.Purpose,
	|	ResultsTable.Series,
	|	ResultsTable.Cell,
	|	ResultsTable.NumberOfPackages,
	|	ResultsTable.Count,
	|	ResultsTable.PackageWeight,
	|	ResultsTable.PackageVolume,
	|	ResultsTable.TabIndex,
	|	ResultsTable.Code,
	|	ResultsTable.WarehouseZone,
	|	ResultsTable.KeyToCommunicatingWithTare
	|INTO ResultsTable
	|FROM
	|	&ResultsTable AS ResultsTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.TaraProducts AS Products,
	|	NestedQuery.TaraCharacteristic AS Characteristic,
	|	NestedQuery.Cell AS Cell,
	|	NestedQuery.TabIndex AS TabIndex,
	|	NestedQuery.Code AS Code,
	|	NestedQuery.WarehouseZone AS WarehouseZone,
	|	NestedQuery.ReferenceOrder AS ReferenceOrder,
	|	SUM(NestedQuery.NumberOfContainers) AS Count,
	|	SUM(NestedQuery.NumberOfContainers) AS NumberOfPackages,
	|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	|	VALUE(Catalog.Assignments.EmptyRef)  AS Purpose,
	|	NestedQuery.PackagingIsDeliveredInContainers,
	|	NestedQuery.KeyToCommunicatingWithTare
	|INTO SelectedContainers_
	|FROM
	|	(SELECT
	|		ResultsTable.ReferenceOrder AS ReferenceOrder,
	|		ResultsTable.NumberOfPackages * RepackagingOptions.Count AS NumberOfContainers,
	|		ResultsTable.Cell AS Cell,
	|		ResultsTable.TabIndex AS TabIndex,
	|		ResultsTable.Code AS Code,
	|		ResultsTable.WarehouseZone AS WarehouseZone,
	|		RepackagingOptions.Package.ReusablePackageItems AS TaraProducts,
	|		RepackagingOptions.Package.ReusablePackageVariant AS TaraCharacteristic,
	|		FALSE AS PackagingIsDeliveredInContainers,
	|		ResultsTable.KeyToCommunicatingWithTare AS KeyToCommunicatingWithTare
	|	FROM
	|		ResultsTable AS ResultsTable
	|			INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|			ON ResultsTable.Package = RepackagingOptions.Source
	|	WHERE
	|		RepackagingOptions.Package.SuppliedInReusablePackage
	|		AND CAST(ResultsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
	|		AND ResultsTable.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ResultsTable.ReferenceOrder,
	|		ResultsTable.NumberOfPackages,
	|		ResultsTable.Cell,
	|		ResultsTable.TabIndex,
	|		ResultsTable.Code,
	|		ResultsTable.WarehouseZone,
	|		CAST(ResultsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageItems,
	|		CAST(ResultsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).ReusablePackageVariant,
	|		TRUE,
	|		ResultsTable.KeyToCommunicatingWithTare AS KeyToCommunicatingWithTare
	|	FROM
	|		ResultsTable AS ResultsTable
	|	WHERE
	|		CAST(ResultsTable.Package AS Catalog.PackagesAndUnitsOfMeasure).SuppliedInReusablePackage
	|		AND CAST(ResultsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.ReferenceOrder,
	|	NestedQuery.TaraProducts,
	|	NestedQuery.TaraCharacteristic,
	|	NestedQuery.Cell,
	|	NestedQuery.TabIndex,
	|	NestedQuery.Code,
	|	NestedQuery.WarehouseZone,
	|	NestedQuery.PackagingIsDeliveredInContainers,
	|	NestedQuery.KeyToCommunicatingWithTare
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SelectedContainers_.Products,
	|	SelectedContainers_.Characteristic,
	|	SelectedContainers_.Purpose,
	|	SelectedContainers_.Cell,
	|	SelectedContainers_.TabIndex,
	|	SelectedContainers_.Code,
	|	SelectedContainers_.WarehouseZone,
	|	SelectedContainers_.ReferenceOrder,
	|	SelectedContainers_.Count,
	|	SelectedContainers_.NumberOfPackages,
	|	SelectedContainers_.PackagingIsDeliveredInContainers,
	|	SelectedContainers_.KeyToCommunicatingWithTare,
	|	ISNULL(GoodsInStorageBinsBalance.InStockBalance, 0) - ISNULL(GoodsInStorageBinsBalance.ForPickingBalance, 0) AS AvailableStock
	|FROM
	|	SelectedContainers_ AS SelectedContainers_
	|		LEFT JOIN AccumulationRegister.GoodsInStorageBins.Balance(
	|				,
	|				(Cell, Products, Characteristic, Series, Package) IN
	|					(SELECT
	|						SelectedContainers_.Cell,
	|						SelectedContainers_.Products,
	|						SelectedContainers_.Characteristic,
	|						SelectedContainers_.Series,
	|						SelectedContainers_.Package
	|					FROM
	|						SelectedContainers_)) AS GoodsInStorageBinsBalance
	|		ON SelectedContainers_.Products = GoodsInStorageBinsBalance.Products
	|			AND SelectedContainers_.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|			AND SelectedContainers_.Package = GoodsInStorageBinsBalance.Package
	|			AND SelectedContainers_.Series = GoodsInStorageBinsBalance.Series
	|			AND SelectedContainers_.Cell = GoodsInStorageBinsBalance.Cell
	|WHERE
	|	ISNULL(GoodsInStorageBinsBalance.InStockBalance, 0) - ISNULL(GoodsInStorageBinsBalance.ForPickingBalance, 0) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	If SelectEmptyContainers Then
		Query.Text = Query.Text + "
		|SELECT
		|	NestedQuery.Products,
		|	NestedQuery.Characteristic,
		|	VALUE(Catalog.Assignments.EmptyRef)  AS Purpose,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	NestedQuery.ReferenceOrder,
		|	MAX(NestedQuery.DateOfShipment) AS DateOfShipment,
		|	MAX(NestedQuery.Priority) AS Priority,
		|	SUM(NestedQuery.Count) AS Count,
		|	CAST(NestedQuery.Products AS Catalog.Products).WarehouseGroup AS WarehouseGroupOfProducts,
		|	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS CargoItem
		|INTO ExtendedTableOfProducts
		|FROM
		|	(SELECT
		|		ProductsTable.Products AS Products,
		|		ProductsTable.Characteristic AS Characteristic,
		|		ProductsTable.ReferenceOrder AS ReferenceOrder,
		|		ProductsTable.DateOfShipment AS DateOfShipment,
		|		ProductsTable.Priority AS Priority,
		|		ProductsTable.Count AS Count
		|	FROM
		|		ProductsTable AS ProductsTable
		|	WHERE
		|		CAST(ProductsTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		SelectedContainers_.Products,
		|		SelectedContainers_.Characteristic,
		|		SelectedContainers_.ReferenceOrder,
		|		DATETIME(1, 1, 1),
		|		0,
		|		-SelectedContainers_.Count
		|	FROM
		|		SelectedContainers_ AS SelectedContainers_) AS NestedQuery
		|
		|GROUP BY
		|	NestedQuery.Products,
		|	NestedQuery.Characteristic,
		|	NestedQuery.ReferenceOrder
		|
		|HAVING
		|	SUM(NestedQuery.Count) > 0";	
	EndIf;
	Query.SetParameter("ResultsTable", TableStructure.ResultsTable);
	
	QueryResults = Query.ExecuteBatch(); 
	
	TableStructure.FlowTableFromCells.Clear();
	
	// We will add a return container from the cells from which we take the goods.
	// Since there may be a task for selecting empty containers, we will save the container consumption
	// in the flow table from the cells.
	
	SamplingByContainer = QueryResults[2].Select();
	
	RowFilter = New Structure("Cell,Products,Package,Characteristic,Purpose,Series");
	
	While SamplingByContainer.Next() Do
		FillPropertyValues(RowFilter, SamplingByContainer);
		
		ArrayOfFoundStrings = TableStructure.FlowTableFromCells.FindRows(RowFilter);
		
		If ArrayOfFoundStrings.Count() = 0 Then
			ExpenseLine 						= TableStructure.FlowTableFromCells.Add();
			FillPropertyValues(ExpenseLine, RowFilter);
			
			ExpenseLine.NumberOfPackages 	= SamplingByContainer.AvailableStock;
		Else
			ExpenseLine = ArrayOfFoundStrings[0];
		EndIf;
		
		ResultString1 = TableStructure.ResultsTable.Add();
		FillPropertyValues(ResultString1, SamplingByContainer);
		NumberOfPackagesToBeSelected = ResultString1.NumberOfPackages;
		QuantityToBeSelected = ResultString1.Count;
		
		ResultString1.NumberOfPackages = Min(ExpenseLine.NumberOfPackages, SamplingByContainer.NumberOfPackages);
		ResultString1.Count         = ResultString1.NumberOfPackages;
		
		ExpenseLine.NumberOfPackages = ExpenseLine.NumberOfPackages - ResultString1.NumberOfPackages; 
		
		If TableStructure.Property("PlacementTable") 
			And SamplingByContainer.PackagingIsDeliveredInContainers Then
			AssignmentRow2 = TableStructure.PlacementTable.Add();
			FillPropertyValues(AssignmentRow2, ResultString1);
		EndIf;
		
		If QuantityToBeSelected > ResultString1.NumberOfPackages Then
			
			ErrorString = TableStructure.ErrorsTable.Add();
			FillPropertyValues(ErrorString, SamplingByContainer);
			ErrorString.Count = QuantityToBeSelected - ResultString1.Count;
			ErrorString.NumberOfPackages = NumberOfPackagesToBeSelected - ResultString1.NumberOfPackages;
			
		EndIf;
	EndDo;
	
	If SelectEmptyContainers Then
		ExtendedTableOfProducts = QueryResults[3].Select();
		ExtendedTableOfProducts.Next();
		
		// If there is a selection of empty containers, then we will run the usual selection algorithm for it
		If ExtendedTableOfProducts.Count > 0 Then 
			Return True;	
		Else
			Return False;
		EndIf;
	Else
		Return False;
	EndIf;	
	
EndFunction

