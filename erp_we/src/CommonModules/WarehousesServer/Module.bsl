#Region SelectionAndPlacement

// The procedure creates a table of product placement in storage cells.
// The current version of the algorithm takes into account:
// - cell locks;
// - priority storage areas for each package of each item;
// - levels of availability of cells;
// - size control (the cell does not contain a product that is larger than it in any size (unless the cell
// 	is unlimited in size);
// - control of the occupied volume in the cell, taking into account the already stored product, the product to be placed, and the product processed by the algorithm
// 	(for unlimited cells, it is not controlled);
// - control of the occupied weight in the cell, taking into account the already stored goods, the goods to be placed and the goods processed by the algorithm
// 	(for cells with unlimited load capacity, it is not controlled);
// - dimensionless packages can only be placed in cells that are unlimited in size.
//
// Parameters:
//  TempTablesManager	 - TempTablesManager - temporary table Manager for a query that created an item pool for placement
//  	  the procedure does not delete temporary tables managed by the Manager
//  Warehouse					 -  CatalogRef.Warehouses - the warehouse where you want to place the product
//  Premise				 - 	CatalogRef.Warerooms - the storage room where the cells are located, if you use the division
//  	  of storage addresses by room, if you do not use it, you must pass an empty link.
//  	  
//  WarehouseZone			 - CatalogRef.WarehouseZones - cells will be selected according to the placement rules,
//																taking into account all priorities, and then restricted to the transferred section.
//																If an empty link is passed, the section restrictions will not apply
//  SourceCell			 - CatalogRef.StorageBins	 - the cell from which the products are placed. Transmitted when it
//																is a receiving or shipping area. It is necessary to calculate the amount of free
//																containers in the cell and NOT place the container that is needed for the goods lying in the cell. 
//  CheckError			 - Boolean - returned flag for whether there was an error checking whether the parameters for the item being placed were filled in correctly 
//  SupplementWithMultiTurnContainers - Boolean - for the specified packages, the specified container will be added
//  
// Returns:
//   Structure - a structure with the following keys:
//	* ResultsTable - ValueTable - selected by the cell placement algorithm:
//		** Products - CatalogRef.Products - 
//		** Package - CatalogRef.PackagesAndUnitsOfMeasure - 
//		** Cell - CatalogRef.StorageBins - 
//		** Characteristic - CatalogRef.ItemsCharacteristics - 
//		** Purpose - CatalogRef.Assignments - 
//		** Series - CatalogRef.ItemsBatches - 
//		** NumberOfPackages - Number - 
//		** Count - Number - 
//		** PackageWeight - Number - 
//		** PackageVolume - Number -
//		** TabIndex - Number - 
//		** Code - Number - 
//		** WarehouseZone - CatalogRef.WarehouseZones - 
//	* ErrorsTable - ValueTable - Goods for which it was not possible to find the cells for placement:
//		** Products - CatalogRef.Products - 
//		** Package - CatalogRef.PackagesAndUnitsOfMeasure - 
//		** Characteristic - CatalogRef.ItemsCharacteristics - 
//		** Series - CatalogRef.ItemsBatches - 
//		** NumberOfPackages - Number - 
//		** Count - Number - 
//		** Purpose - CatalogRef.Assignments - 
//  * ArrayOfPlots - Array of CatalogRef.WarehouseZones - array of links to the work sections of the selected cells.
//
Function PlaceGoodsInCells(TempTablesManager, Warehouse, Premise, WarehouseZone,
			SourceCell, CheckError, SupplementWithMultiTurnContainers = True) Export
	
	CheckPrepareProductPlacementParameters(TempTablesManager,Warehouse, Premise, SourceCell, CheckError);
	
	If CheckError Then
		Return Undefined;
	EndIf;
	
	ResultsTable = New ValueTable;
	ResultsTable.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	ResultsTable.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	ResultsTable.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));
	ResultsTable.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	ResultsTable.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	ResultsTable.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	ResultsTable.Columns.Add("NumberOfPackages", TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative));
	ResultsTable.Columns.Add("Count", TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative));
	ResultsTable.Columns.Add("PackageWeight", New TypeDescription("Number",New NumberQualifiers(15,3,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("PackageVolume", New TypeDescription("Number",New NumberQualifiers(18,6,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("TabIndex", New TypeDescription("Number",New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("Code", New TypeDescription("String",,New StringQualifiers(19,AllowedLength.Fixed)));
	ResultsTable.Columns.Add("WarehouseZone", New TypeDescription(New TypeDescription("CatalogRef.WarehouseZones")));
	
	ErrorsTable = New ValueTable;
	ErrorsTable.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	ErrorsTable.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	ErrorsTable.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	ErrorsTable.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	ErrorsTable.Columns.Add("NumberOfPackages", New TypeDescription("Number",,,New NumberQualifiers(15,3,AllowedSign.Any)));
	ErrorsTable.Columns.Add("Count", New TypeDescription("Number",,,New NumberQualifiers(15,3,AllowedSign.Any)));
	ErrorsTable.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	
	CellFillingTable = New ValueTable;
	CellFillingTable.Columns.Add("SeriesCount", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	CellFillingTable.Columns.Add("NumberOfCharacteristics", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	CellFillingTable.Columns.Add("NumberOfProducts_", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	CellFillingTable.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));
	CellFillingTable.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	CellFillingTable.Columns.Add("VolumeM3", New TypeDescription("Number",,,New NumberQualifiers(15,3,AllowedSign.Nonnegative)));
	CellFillingTable.Columns.Add("Weight", New TypeDescription("Number",,,New NumberQualifiers(15,3,AllowedSign.Nonnegative)));

	CellFillingTable.Indexes.Add("Cell");
	
	TableOfPlacedProducts = New ValueTable;
	TableOfPlacedProducts.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));	
	TableOfPlacedProducts.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));	
	TableOfPlacedProducts.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));	
	TableOfPlacedProducts.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));	
	
	ArrayOfPlots = New Array;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	QueryText = 
	"SELECT
	|	Table.Products AS Products,
	|	Table.Package AS Package,
	|	Table.Series AS Series,
	|	Table.BatchesAccountingByFEFO AS BatchesAccountingByFEFO,
	|	Table.NumberOfPackages AS NumberOfPackages,
	|	Table.Characteristic AS Characteristic,
	|	Table.Purpose AS Purpose,
	|	Table.PhysicallyDifferentFromAssignment,
	|	Table.LimitByWeight,
	|	Table.LimitByVolume,
	|	Table.Height AS Height,
	|	Table.Width AS Width,
	|	Table.Depth AS Depth,
	|	Table.VolumeM3 AS VolumeM3,
	|	Table.Dimensionless AS Dimensionless,
	|	Table.Weight AS Weight,
	|	Table.ValidUntil_ AS ValidUntil_,
	|	Table.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	Table.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	Table.QuantityPerPackage AS QuantityPerPackage
	|FROM
	|	ExtendedTableOfProducts AS Table
	|
	|ORDER BY
	|   BatchesAccountingByFEFO,
	|	Products.Description,
	|	Characteristic.Description,
	|	ValidUntil_,
	|	Package.Description
	|
	|TOTALS BY
	|	Purpose,
	|	Products,
	|	Package,
	|	Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	GoodsPlacementRules.StorageArea AS StorageArea,
	|	ProductsTable.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	ProductsTable.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	CASE  
	|		WHEN GoodsPlacementRules.StorageArea.SeparateStorageArea THEN
	|			GoodsPlacementRules.Priority
	|		ELSE 
	|			GoodsPlacementRules.Priority + 1000
	|	END AS AreaPriority,
	|	GoodsPlacementRules.StorageArea.SeparateStorageArea AS SeparateStorageArea,
	|	ProductsTable.PhysicallyDifferentFromAssignment AS PhysicallyDifferentFromAssignment
	|INTO StorageAreasOfWarehouseGroups
	|FROM
	|	ExtendedTableOfProducts AS ProductsTable
	|		INNER JOIN InformationRegister.GoodsPlacementRules AS GoodsPlacementRules
	|		ON ProductsTable.WarehouseGroupOfProducts = GoodsPlacementRules.WarehouseGroupOfProducts
	|					AND ProductsTable.WarehouseGroupOfPackages = GoodsPlacementRules.WarehouseGroupOfPackages
	|WHERE
	|	GoodsPlacementRules.Warehouse = &Warehouse
	|	AND GoodsPlacementRules.Premise = &Premise
	// If the product is not placed for the purpose, then only the storage areas of non-isolated storage are available. 
	|	AND (CASE WHEN ProductsTable.Purpose = VALUE(Catalog.Assignments.EmptyRef) THEN
	|				NOT GoodsPlacementRules.StorageArea.SeparateStorageArea
	|		ELSE CASE WHEN ProductsTable.PhysicallyDifferentFromAssignment THEN
	|					TRUE
	|			 ELSE GoodsPlacementRules.StorageArea.SeparateStorageArea
	|			 END
	|	END)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CatCells.Ref AS Cell,
	|	StorageAreasOfWarehouseGroups.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	StorageAreasOfWarehouseGroups.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	MIN(StorageAreasOfWarehouseGroups.AreaPriority) AS AreaPriority,
	|	MIN(StorageAreasOfWarehouseGroups.SeparateStorageArea) AS SeparateStorageArea,
	|	MIN(StorageAreasOfWarehouseGroups.PhysicallyDifferentFromAssignment) AS PhysicallyDifferentFromAssignment
	|INTO TableOfCellsForQuery
	|FROM
	|	StorageAreasOfWarehouseGroups AS StorageAreasOfWarehouseGroups
	|		INNER JOIN Catalog.StorageBins AS CatCells
	|		ON (CatCells.StorageArea = StorageAreasOfWarehouseGroups.StorageArea)
	|		LEFT JOIN InformationRegister.StorageBinsLocks AS CellLocks
	|		ON (CatCells.Ref = CellLocks.Cell)
	|			AND (CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Full)
	|				OR CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Location))
	|WHERE
	|	CellLocks.LockType IS NULL 
	|	AND CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
	|	AND (NOT CatCells.IsFolder)
	|	AND (NOT CatCells.DeletionMark)
	|	AND (CatCells.Owner = &Warehouse)
	|	AND (CatCells.Premise = &Premise)
	|
	|GROUP BY
	|	CatCells.Ref,
	|	StorageAreasOfWarehouseGroups.WarehouseGroupOfProducts,
	|	StorageAreasOfWarehouseGroups.WarehouseGroupOfPackages
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsInStorageBinsBalance.Cell AS Cell,
	|	SUM((GoodsInStorageBinsBalance.InStockBalance + GoodsInStorageBinsBalance.ForPlacementBalance) * &QueryTextPackageVolume) AS OccupiedVolume,
	|	SUM((GoodsInStorageBinsBalance.InStockBalance + GoodsInStorageBinsBalance.ForPlacementBalance) * &QueryTextPackageWeight) AS BusyWeight
	|INTO RequestByOccupiedVolumeWeight
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Cell IN
	|				(SELECT
	|					TableOfCellsForQuery.Cell
	|				FROM
	|					TableOfCellsForQuery AS TableOfCellsForQuery)) AS GoodsInStorageBinsBalance
	|
	|GROUP BY
	|	GoodsInStorageBinsBalance.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TableOfCellsForQuery.Cell AS Cell,
	|	TableOfCellsForQuery.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	TableOfCellsForQuery.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	TableOfCellsForQuery.AreaPriority AS AreaPriority,
	|	TableOfCellsForQuery.SeparateStorageArea AS SeparateStorageArea,
	|	TableOfCellsForQuery.PhysicallyDifferentFromAssignment AS PhysicallyDifferentFromAssignment,
	|	TableOfCellsForQuery.Cell.AvailabilityLevel AS AvailabilityLevel,
	|	TableOfCellsForQuery.Cell.TabIndex AS TabIndex,
	|	TableOfCellsForQuery.Cell.WarehouseZone AS WarehouseZone,
	|	TableOfCellsForQuery.Cell.Code AS Code,
	|	TableOfCellsForQuery.Cell.StandardSize.VolumeM3 * (TableOfCellsForQuery.Cell.StandardSize.VolumeUnitOfMeasure.Numerator/TableOfCellsForQuery.Cell.StandardSize.VolumeUnitOfMeasure.Denominator) * TableOfCellsForQuery.Cell.MaximumFillingRateByVolume / 100 - ISNULL(RequestByOccupiedVolumeWeight.OccupiedVolume, 0) AS FreeVolume_,
	|	TableOfCellsForQuery.Cell.StandardSize.CarryingCapacity * (TableOfCellsForQuery.Cell.StandardSize.WeightUnitOfMeasure.Numerator/TableOfCellsForQuery.Cell.StandardSize.WeightUnitOfMeasure.Denominator) * TableOfCellsForQuery.Cell.MaximumFillingRateByWeight / 100 - ISNULL(RequestByOccupiedVolumeWeight.BusyWeight, 0) AS FreeWeight,
	|	TableOfCellsForQuery.Cell.StandardSize.Width*TableOfCellsForQuery.Cell.StandardSize.WidthUnitOfMeasure.Numerator/TableOfCellsForQuery.Cell.StandardSize.WidthUnitOfMeasure.Denominator AS Width,
	|	TableOfCellsForQuery.Cell.StandardSize.Depth*TableOfCellsForQuery.Cell.StandardSize.DepthUnitOfMeasure.Numerator/TableOfCellsForQuery.Cell.StandardSize.DepthUnitOfMeasure.Denominator AS Depth,
	|	TableOfCellsForQuery.Cell.StandardSize.Height*TableOfCellsForQuery.Cell.StandardSize.HeightUnitOfMeasure.Numerator/TableOfCellsForQuery.Cell.StandardSize.HeightUnitOfMeasure.Denominator AS Height,
	|	TableOfCellsForQuery.Cell.StandardSize.NotLimitedByCarryingCapacity AS NotLimitedByCarryingCapacity,
	|	TableOfCellsForQuery.Cell.StandardSize.NotLimitedByDimensions AS NotLimitedByDimensions,
	|	TableOfCellsForQuery.Cell.StorageArea.PriorityOfPlacementIntoEmptyBins AS PriorityOfPlacementIntoEmptyBins,
	|	TableOfCellsForQuery.Cell.StorageArea.PriorityOfPlacementIntoSingleProductBins AS PriorityOfPlacementIntoSingleProductBins,
	|	TableOfCellsForQuery.Cell.StorageArea.PriorityOfPlacementIntoMixedStorageBins AS PriorityOfPlacementIntoMixedStorageBins,
	|	TableOfCellsForQuery.Cell.StorageArea.PriorityOfPlacementIntoBinsWithOtherGoodsOfKind AS PriorityOfPlacementIntoBinsWithOtherGoodsOfKind,
	|	TableOfCellsForQuery.Cell.StorageArea.SingleProductDescription AS SingleProductDescription,
	|	TableOfCellsForQuery.Cell.StorageArea.StrictlySingleProductBins AS StrictlySingleProductBins,
	|	ISNULL(BinRecountStates.State, VALUE(Enum.BinRecountStates.EmptyRef)) AS RecalculationStatus 
	|INTO CellTable
	|FROM
	|	TableOfCellsForQuery AS TableOfCellsForQuery
	|		LEFT JOIN RequestByOccupiedVolumeWeight AS RequestByOccupiedVolumeWeight
	|		ON TableOfCellsForQuery.Cell = RequestByOccupiedVolumeWeight.Cell
	|		LEFT JOIN InformationRegister.BinRecountStates AS BinRecountStates
	|		ON TableOfCellsForQuery.Cell = BinRecountStates.Cell
	|			AND (BinRecountStates.State = VALUE(Enum.BinRecountStates.RecountIsRequired))
	|WHERE
	|	(TableOfCellsForQuery.Cell.StandardSize.VolumeM3 * TableOfCellsForQuery.Cell.MaximumFillingRateByVolume / 100 - ISNULL(RequestByOccupiedVolumeWeight.OccupiedVolume, 0) > 0
	|			OR TableOfCellsForQuery.Cell.StandardSize.NotLimitedByDimensions)
	|	AND (TableOfCellsForQuery.Cell.StandardSize.CarryingCapacity * TableOfCellsForQuery.Cell.MaximumFillingRateByWeight / 100 - ISNULL(RequestByOccupiedVolumeWeight.BusyWeight, 0) > 0
	|			OR TableOfCellsForQuery.Cell.StandardSize.NotLimitedByCarryingCapacity)
	|
	|INDEX BY
	|	Cell,
	|	WarehouseGroupOfProducts,
	|	WarehouseGroupOfPackages,
	|	NotLimitedByCarryingCapacity,
	|	NotLimitedByDimensions,
	|	SeparateStorageArea,
	|	PhysicallyDifferentFromAssignment,
	|	Width,
	|	Depth,
	|	Height,
	|	FreeVolume_,
	|	FreeWeight,
	|	AreaPriority,
	|	RecalculationStatus,
	|	WarehouseZone,
	|	AvailabilityLevel,
	|	TabIndex,
	|	StrictlySingleProductBins,
	|	SingleProductDescription,
	|	Code,
	|	PriorityOfPlacementIntoBinsWithOtherGoodsOfKind,
	|	PriorityOfPlacementIntoMixedStorageBins,
	|	PriorityOfPlacementIntoEmptyBins,
	|	PriorityOfPlacementIntoSingleProductBins
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsInStorageBinsBalance.Products AS Products,
	|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
	|	GoodsInStorageBinsBalance.Purpose AS Purpose,
	|	GoodsInStorageBinsBalance.Series AS Series,
	|	GoodsInStorageBinsBalance.Cell AS Cell
	|INTO GoodsInStorageBinsBalance
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Cell IN
	|				(SELECT
	|					CellTable.Cell
	|				FROM
	|					CellTable AS CellTable)) AS GoodsInStorageBinsBalance
	|
	|INDEX BY
	|	Cell,
	|	Products
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsInStorageBinsBalance.Products AS Products,
	|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
	|	MAX(GoodsInStorageBinsBalance.Series.ValidUntil_) AS ValidUntil_,
	|	GoodsInStorageBinsBalance.Cell AS Cell
	|INTO MaximumShelfLifeInCells
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			(Products, Characteristic) IN
	|					(SELECT
	|						ProductsTable.Products,
	|						ProductsTable.Characteristic
	|					FROM
	|						ExtendedTableOfProducts AS ProductsTable
	|					WHERE
	|						ProductsTable.BatchesAccountingByFEFO)
	|				AND Cell IN
	|					(SELECT
	|						CellTable.Cell
	|					FROM
	|						CellTable AS CellTable)) AS GoodsInStorageBinsBalance
	|
	|GROUP BY
	|	GoodsInStorageBinsBalance.Products,
	|	GoodsInStorageBinsBalance.Characteristic,
	|	GoodsInStorageBinsBalance.Cell
	|
	|INDEX BY
	|	Products,
	|	Characteristic,
	|	Cell,
	|	ValidUntil_
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TableOfCellsForQuery
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP StorageAreasOfWarehouseGroups
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP RequestByOccupiedVolumeWeight
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	VALUE(Catalog.StorageBins.EmptyRef) AS Cell,
	|	0 AS VolumeM3,
	|	0 AS Weight,
	|	0 AS NumberOfProducts_,
	|	0 AS NumberOfCharacteristics,
	|	0 AS SeriesCount,
	|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose
	|INTO CellFillingTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	VALUE(Catalog.StorageBins.EmptyRef) AS Cell,
	|	VALUE(Catalog.Products.EmptyRef) AS Products,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series
	|INTO TableOfPlacedProducts";
	
	QueryText = StrReplace(QueryText, "&QueryTextPackageWeight", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
	QueryText = StrReplace(QueryText, "&QueryTextPackageVolume", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
	
	Query.Text = QueryText;
	
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",Premise); 
		
	ResultsArray = Query.ExecuteBatch();
	
	Result = ResultsArray[0]; // QueryResult
	
	SelectionByDestination = Result.Select(QueryResultIteration.ByGroups);
	
	While SelectionByDestination.Next() Do
		
		SelectionByProductType_ = SelectionByDestination.Select(QueryResultIteration.ByGroups);
		
		While SelectionByProductType_.Next() Do
			
			SampleByPackage = SelectionByProductType_.Select(QueryResultIteration.ByGroups);
			
			While SampleByPackage.Next() Do
				
				SelectionByCharacteristics = SampleByPackage.Select(QueryResultIteration.ByGroups);
				
				While SelectionByCharacteristics.Next() Do
					
					SelectionBySeries = SelectionByCharacteristics.Select(QueryResultIteration.ByGroups);
					
					While SelectionBySeries.Next() Do
						
						NumberOfPackages = SelectionBySeries.NumberOfPackages;
						
						StructureOfProductPlacementAlgorithmTables = StructureOfProductPlacementAlgorithmTables();
						StructureOfProductPlacementAlgorithmTables.ResultsTable = ResultsTable;
						StructureOfProductPlacementAlgorithmTables.ErrorsTable = ErrorsTable;
						StructureOfProductPlacementAlgorithmTables.CellFillingTable = CellFillingTable;
						StructureOfProductPlacementAlgorithmTables.TableOfPlacedProducts = TableOfPlacedProducts;
						
						PlaceProductPosition(TempTablesManager, StructureOfProductPlacementAlgorithmTables, SelectionBySeries, ArrayOfPlots, NumberOfPackages);
						
					EndDo;
					
				EndDo;
				
			EndDo;
			
		EndDo;
		
	EndDo;
	
	// Select products by work area
	If ValueIsFilled(WarehouseZone) Then
		SelectionByWorkingArea = New Structure("WarehouseZone",WarehouseZone);
		ResultsTable = ResultsTable.Copy(SelectionByWorkingArea);
	EndIf;
	
	If SupplementWithMultiTurnContainers Then
		AddMultiTurnContainerToPlacementTable(ResultsTable);
	EndIf;
	
	// Addition of the error table by the container for the balance of the container removed during the check.
	Query = New Query;
	QueryText = 
	"SELECT
	|	ErrorsTable.Products,
	|	ErrorsTable.Characteristic,
	|	ErrorsTable.Purpose,
	|	ErrorsTable.Series,
	|	CAST(ErrorsTable.Package AS Catalog.PackagesAndUnitsOfMeasure) AS Package,
	|	CAST(VALUE(Catalog.StorageBins.EmptyRef) AS Catalog.StorageBins) AS Cell,
	|	ErrorsTable.NumberOfPackages,
	|	ErrorsTable.Count
	|INTO ErrorsTable
	|FROM
	|	&ErrorsTable AS ErrorsTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ErrorsTable.Products,
	|	ErrorsTable.Characteristic,
	|	ErrorsTable.Purpose,
	|	ErrorsTable.Series,
	|	ErrorsTable.Package,
	|	ErrorsTable.Cell,
	|	ErrorsTable.NumberOfPackages,
	|	ErrorsTable.Count,
	|	&QueryTextPackageWeight AS PackageWeight,
	|	&QueryTextPackageVolume AS PackageVolume,
	|	ErrorsTable.Cell.TabIndex AS TabIndex,
	|	ErrorsTable.Cell.Code AS Code,
	|	ErrorsTable.Cell.WarehouseZone AS WarehouseZone
	|FROM
	|	ErrorsTable AS ErrorsTable";
	
	QueryText = StrReplace(QueryText, "&QueryTextPackageWeight", Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("ErrorsTable.Package", "ErrorsTable.Products", False));
	QueryText = StrReplace(QueryText, "&QueryTextPackageVolume", Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("ErrorsTable.Package", "ErrorsTable.Products", False));
	Query.Text = QueryText;
	
	Query.SetParameter("ErrorsTable",ErrorsTable);
	ErrorsTable = Query.Execute().Unload();
	
	If SupplementWithMultiTurnContainers Then
		AddMultiTurnContainerToPlacementTable(ErrorsTable);
	EndIf;
	
	ResultsTable.Sort("TabIndex,Code");
	
	ReturnStructure = New Structure;
	ReturnStructure.Insert("ResultsTable",ResultsTable);
	ReturnStructure.Insert("ErrorsTable",ErrorsTable);
	ReturnStructure.Insert("ArrayOfPlots",ArrayOfPlots);
	
	Return ReturnStructure;
	
EndFunction

// The procedure creates a table of product selection from storage cells.
// The current version of the algorithm takes into account:
//	- cell locks;
//	- levels of availability of cells;
//	- the remains of the product of the desired characteristics in the required packaging in the cell.
//
// Parameters:
//	TempTablesManager - TempTablesManager - temporary table Manager for the query that created the item pool for placement.
//		This procedure does not delete temporary tables managed by the Manager.
//	Warehouse - CatalogRef.Warehouses - the warehouse where you want to place the product.
//	Premise - CatalogRef.Warerooms - the storage room where the cells are located, if you use the division
//		of storage addresses by room, if you do not use it, you must pass an empty link.
//
// Returns:
//	Structure - See TableStructureOfProductSelectionAlgorithm
//
Function SelectProductFromCells(TempTablesManager, Warehouse, Premise) Export
	
	TableStructureOfProductSelectionAlgorithm = TableStructureOfProductSelectionAlgorithm();
	
	If Not Users.IsFullUser(Undefined) Then
		
		Query = New Query;
		Query.Text =
		"SELECT ALLOWED
		|	Warehouses.Ref
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|WHERE
		|	Warehouses.Ref = &Warehouse";
		
		Query.SetParameter("Warehouse", Warehouse);
		
		If Query.Execute().IsEmpty() Then
			TableStructureOfProductSelectionAlgorithm.Delete("FlowTableFromCells");
			
			Return TableStructureOfProductSelectionAlgorithm;
		EndIf;
		
	EndIf;
	
	PrepareTableOfProductsForSelection(TempTablesManager);
	
	SelectCellsForSelection(TempTablesManager, Warehouse, Premise, TableStructureOfProductSelectionAlgorithm, False);
	
	ThereIsEmptyContainer = SupplementSelectionTableWithMultiTurnContainer(TempTablesManager, TableStructureOfProductSelectionAlgorithm, True);
	
	// If there is a selection of empty containers, then we will run the usual selection algorithm for it
	If ThereIsEmptyContainer Then
		SelectCellsForSelection(TempTablesManager, Warehouse, Premise, TableStructureOfProductSelectionAlgorithm, True);
	EndIf;
	
	TableStructureOfProductSelectionAlgorithm.ResultsTable.Sort("ReferenceOrder, TabIndex, Code, KeyToCommunicatingWithTare, Package Desc", New CompareValues);
	TableStructureOfProductSelectionAlgorithm.Delete("FlowTableFromCells");
	
	Return TableStructureOfProductSelectionAlgorithm;
	
EndFunction

// The function returns a table of packages used for the item.
//
// Parameters:
//	Products - CatalogRef.Products - item to get a list of packages for;
//	BasicAtBeginning - Boolean - True-indicates whether packages are sorted in the table;
//	WarehouseGroup - CatalogRef.WarehousePackageGroups - warehouse group of packages.
//
// Returns:
//	ValueTable - a table of values with the following columns:
//		* Package				- CatalogRef.PackagesAndUnitsOfMeasure - item packaging;
//		* ZoomRatio			- Number - packing ratio relative to the item storage unit;
//		* NumberOfPackages 	- Number - filled in 0;
//		* Count			- Number - 0 is filled in.
//
Function GetPacking(Products, BasicAtBeginning = False, WarehouseGroup = Undefined) Export
	
	Query = New Query;
	Query.SetParameter("Products", Products);
	Query.SetParameter("PackagingGroup", Common.ObjectAttributeValue(Products, "PackagingGroup"));
	
	Query.Text = 
	"SELECT
	|	CatPackagingProducts.Ref AS Package,
	|	&QueryTextPackagingFactor AS ZoomRatio,
	|	0 AS Count,
	|	0 AS NumberOfPackages,
	|	CatPackagingProducts.WarehouseGroup
	|FROM
	|	Catalog.PackagesAndUnitsOfMeasure AS CatPackagingProducts
	|WHERE
	|	(CatPackagingProducts.Owner = &Products
	|			OR CatPackagingProducts.Owner = &PackagingGroup)
	|	AND NOT CatPackagingProducts.DeletionMark
	|	AND (&WarehouseGroup = UNDEFINED
	|			OR CatPackagingProducts.WarehouseGroup = &WarehouseGroup)
	|	AND CatPackagingProducts.PackageType <> VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|
	|ORDER BY
	|	ZoomRatio DESC";
	
	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"CatPackagingProducts", Undefined));
		
	If BasicAtBeginning Then
		Query.Text = StrReplace(Query.Text, " DESC", "");
	EndIf;
	
	Query.SetParameter("WarehouseGroup", WarehouseGroup );
	
	Return Query.Execute().Unload();
EndFunction

// The procedure implements an algorithm for optimal distribution of goods by packages.
//  Modifies the parameter of the packing Table by filling in the columns "quantity of Packages"and " Quantity".
//
// Parameters:
//  PackingTable_		 - ValueTable	 - Packing Table:
//  	* Package				- CatalogRef.PackagesAndUnitsOfMeasure - item packaging;
//  	* ZoomRatio			- Number - packing ratio relative to the item storage unit;
//  	* NumberOfPackages 	- Number - number of item packages;
//  	* Count			- Number - the number of items in storage units.
//  RequiredQuantity	 - Number			 - the number of items to distribute.
//
Procedure BreakUpByPackages(PackingTable_, Val RequiredQuantity) Export
	
	QuantityLeft = RequiredQuantity;
	For Each LineT In PackingTable_ Do
		
		If Not QuantityLeft Then 
			LineT.NumberOfPackages = 0; 
			LineT.Count = 0;
			Continue 
		EndIf;

		
		LineT.NumberOfPackages = Int(QuantityLeft / LineT.ZoomRatio);
		QuantityLeft = QuantityLeft % LineT.ZoomRatio;
		LineT.Count = LineT.NumberOfPackages * LineT.ZoomRatio;
		
	EndDo;

EndProcedure

