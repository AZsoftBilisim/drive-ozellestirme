	MethodParameters = ParametersOfModularHolding();
	MethodParameters.SynonymForDocumentTable = SynonymForDocumentTable;
	
	ScheduleArrivalOfGoodsInternal(Query,
		QueryTexts,
		Registers,
		QueryTextDocument_,
		MethodParameters,
		ServicesAndWorksAreCountedInRegisteredRecords);
		
EndProcedure

