EndFunction

Function QueryTextBalanceGoodsInWarehouses()
	
	QueryText =
	"SELECT DISTINCT
	|	GoodsForIssue.Warehouse			AS Warehouse,
	|	GoodsForIssue.Products	AS Products,
	|	GoodsForIssue.Characteristic	AS Characteristic,
	|	GoodsForIssue.Purpose		AS Purpose,
	|	GoodsForIssue.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssue.Series			AS Series
	|INTO TableOfNomenclatureSelection
	|FROM
	|	RemainingGoodsForShipment AS GoodsForIssue
	|
	|INDEX BY
	|	Warehouse,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductStock.Warehouse			AS Warehouse,
	|	ProductStock.Products	AS Products,
	|	ProductStock.Characteristic	AS Characteristic,
	|	ProductStock.Purpose		AS Purpose,
	|	ProductStock.ControlledLotReference AS ControlledLotReference,
	|	BalancesForShipment.Series			AS Series
	|INTO BalanceGoodsInWarehouses
	|FROM
	|	AccumulationRegister.ProductStock.Balance(
	|			,
	|			NOT Warehouse IN
	|					(SELECT
	|						TTBlockedGoodsInWarehouses.Warehouse
	|					FROM
	|						TTBlockedGoodsInWarehouses AS TTBlockedGoodsInWarehouses)
	|			AND (Warehouse, Products, Characteristic, Purpose, ControlledLotReference) IN
	|					(SELECT DISTINCT
	|						BalancesForShipment.Warehouse,
	|						BalancesForShipment.Products,
	|						BalancesForShipment.Characteristic,
	|						BalancesForShipment.Purpose,
	|						BalancesForShipment.ControlledLotReference
	|					FROM
	|						TableOfNomenclatureSelection AS BalancesForShipment)
	|	) AS ProductStock
	|		INNER JOIN TableOfNomenclatureSelection AS BalancesForShipment
	|		ON ProductStock.Warehouse = BalancesForShipment.Warehouse
	|			AND ProductStock.Products = BalancesForShipment.Products
	|			AND ProductStock.Characteristic = BalancesForShipment.Characteristic
	|			AND ProductStock.Purpose = BalancesForShipment.Purpose
	|			AND ProductStock.ControlledLotReference = BalancesForShipment.ControlledLotReference
	|			AND (ProductStock.Series = BalancesForShipment.Series
	|				OR BalancesForShipment.Series = VALUE(Catalog.ItemsBatches.EmptyRef))
	|
	|GROUP BY
	|	ProductStock.Warehouse,
	|	ProductStock.Products,
	|	ProductStock.Characteristic,
	|	ProductStock.Purpose,
	|	ProductStock.ControlledLotReference,
	|	BalancesForShipment.Series
	|
	|HAVING
	|	SUM(ProductStock.InStockBalance - ProductStock.ToShipBalance) > 0
	|
	|INDEX BY
	|	Warehouse,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series";
	
	Return QueryText;
	
EndFunction

Function QueryTextNeedToReissueSpendingOrders(ThisIsTemporaryTable = True)
	
	If ThisIsTemporaryTable Then
		QueryText =
		"SELECT DISTINCT
		|	GoodsForIssue.Warehouse		AS Warehouse,
		|	GoodsForIssue.Recipient	AS Recipient
		|INTO NeedForOrders
		|FROM
		|	RemainingGoodsForShipment AS GoodsForIssue
		|		INNER JOIN BalanceGoodsInWarehouses AS ProductStock
		|		ON GoodsForIssue.Warehouse = ProductStock.Warehouse
		|			AND GoodsForIssue.Products = ProductStock.Products
		|			AND GoodsForIssue.Characteristic = ProductStock.Characteristic
		|			AND GoodsForIssue.Purpose = ProductStock.Purpose
		|			AND GoodsForIssue.ControlledLotReference = ProductStock.ControlledLotReference
		|			AND GoodsForIssue.Series = ProductStock.Series
		|
		|INDEX BY
		|	Warehouse,
		|	Recipient";
	Else
		QueryText =
		"SELECT DISTINCT
		|	GoodsForIssue.Warehouse		AS Warehouse,
		|	GoodsForIssue.Recipient	AS Recipient
		|FROM
		|	RemainingGoodsForShipment AS GoodsForIssue
		|		INNER JOIN BalanceGoodsInWarehouses AS ProductStock
		|		ON GoodsForIssue.Warehouse = ProductStock.Warehouse
		|			AND GoodsForIssue.Products = ProductStock.Products
		|			AND GoodsForIssue.Characteristic = ProductStock.Characteristic
		|			AND GoodsForIssue.Purpose = ProductStock.Purpose
		|			AND GoodsForIssue.ControlledLotReference = ProductStock.ControlledLotReference
		|			AND GoodsForIssue.Series = ProductStock.Series";
	EndIf;
	
	Return QueryText;
	
EndFunction

Function QueryTextGoodsIssueNoteReregistrationQueue()
	
	QueryText =
	"SELECT
	|	NeedForOrders.Warehouse		AS Warehouse,
	|	NeedForOrders.Recipient	AS Recipient
	|FROM
	|	NeedForOrders AS NeedForOrders
	|		LEFT JOIN InformationRegister.GoodsIssueNoteReregistrationQueue AS GoodsIssueNoteReregistrationQueue
	|		ON NeedForOrders.Warehouse = GoodsIssueNoteReregistrationQueue.Warehouse
	|			AND NeedForOrders.Recipient = GoodsIssueNoteReregistrationQueue.Recipient
	|WHERE
	|	GoodsIssueNoteReregistrationQueue.Warehouse IS NULL";
	
	Return QueryText;
	
EndFunction

Function QueryTextForDeletedQueueEntries()
	
	QueryText =
	"SELECT
	|	GoodsIssueNoteReregistrationQueue.Warehouse			AS Warehouse,
	|	GoodsIssueNoteReregistrationQueue.Recipient	AS Recipient
	|FROM
	|	InformationRegister.GoodsIssueNoteReregistrationQueue AS GoodsIssueNoteReregistrationQueue
	|		LEFT JOIN NeedForOrders AS NeedForOrders
	|		ON GoodsIssueNoteReregistrationQueue.Warehouse = NeedForOrders.Warehouse
	|			AND GoodsIssueNoteReregistrationQueue.Recipient = NeedForOrders.Recipient
	|WHERE
	|	GoodsIssueNoteReregistrationQueue.Warehouse = &Warehouse
	|	AND NeedForOrders.Warehouse IS NULL";
	
	Return QueryText;
	
EndFunction

// Returns the text of the request that receives information about warehouse operations by document type.
//
// Returns:
//	String - query text.
//
Function QueryTextWarehouseOperationDocumentType() Export
	
	QueryText =
	"SELECT
	|	VALUE(Enum.WarehouseTransactions.ShipmentToCustomer) AS WarehouseOperation,
	|	TYPE(Document.CustomerInvoice) AS Type,
	|	UNDEFINED AS BusinessOperation
