Procedure AddToFormationQueueCorrectionOfSurplusShortagesByProductLocations(Warehouse, Premise, Recorder = Undefined) Export
	
	Block = New DataLock;
	LockItem = Block.Add("InformationRegister.InventoryAdjustmentSurplusesAndShortagesGenerationQueue");
	LockItem.Mode = DataLockMode.Exclusive;
	LockItem.SetValue("Warehouse",Warehouse);
	LockItem.SetValue("Premise",Premise);
	Block.Lock();		
	
	QueueRecordset = InformationRegisters.InventoryAdjustmentSurplusesAndShortagesGenerationQueue.CreateRecordSet();
	
	QueueRecordset.Filter.Warehouse.Set(Warehouse);
	QueueRecordset.Filter.Premise.Set(Premise);
	
	QueueRecordset.Read();
	
	If QueueRecordset.Count() = 0 Then
		
		QueueRecording = QueueRecordset.Add();
		
		QueueRecording.Warehouse = Warehouse;
		QueueRecording.Premise = Premise;
		
		Try
			QueueRecordset.Write();
		Except
			
			If ValueIsFilled(Recorder) Then
				MessageText = NStr("vi = 'Không thể kết chuyển chứng từ: %Ref% do: %Cause%';
									|ru = 'Не удалось выполнить проведение документа: %Ref% по причине: %Cause%';
									|en = 'Cannot post document: %Ref%. Reason: %Cause%'; fa = 'Cannot post document: %Ref%. Reason: %Cause%';
									|it = 'Impossibile registrare il documento: %Ref% a causa: %Cause%';
									|pl = 'Nie można wykonać zaksięgowanie dokumentu: %Ref% z powodu: %Cause%';
									|tr = '%Cause% nedeniyle %Ref% belge kaydı gerçekleştirilemedi'");
				MessageText = StrReplace(MessageText, "%Ref%", Recorder);
				MessageText = StrReplace(MessageText, "%Cause%", DetailErrorDescription(ErrorInfo()));
				WriteLogEvent(InfobaseUpdate.EventLogEvent(),
					EventLogLevel.Error, Recorder.Metadata(), Recorder, MessageText);
			Else
				MessageText = NStr("vi = 'Không thể tạo trình tự điều chỉnh hàng thừa và hàng thiếu trong kho %Warehouse% và vị trí %Premise%.';
									|ru = 'Не удалось сформировать очередь корректировок излишков и недостач по товарным местам по складу %Warehouse% и помещение %Premise%.';
									|en = 'Cannot generate ""Inventory adjustment — Surpluses and shortages"" document queue for warehouse %Warehouse% and wareroom %Premise%.'; fa = 'Cannot generate ""Inventory adjustment — Surpluses and shortages"" document queue for warehouse %Warehouse% and wareroom %Premise%.';
									|it = 'Impossibile generare la coda di correzioni di eccedenze e ammanchi delle merci per il magazzino %Warehouse% e locale %Premise%.';
									|pl = 'Nie udało się utworzyć kolejkę zapisów korygujących nadwyżek i niedoborów dla miejsc towarowych na magazynie %Warehouse% i lokalu %Premise%.';
									|tr = '%Warehouse% ambarı ve %Premise% depolama alanı tarafından kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin bir sırasını oluşturmak mümkün değildi.'");
				MessageText = StrReplace(MessageText, "%Warehouse%", Warehouse);
				MessageText = StrReplace(MessageText, "%Premise%", Premise);
				WriteLogEvent(InfobaseUpdate.EventLogEvent(),
					EventLogLevel.Error,,, MessageText);
			EndIf;
			
			Raise;
			
		EndTry;
		
		ParametersStructure = New Structure("Warehouse, Premise", Warehouse, Premise);
		StartingBackgroundFormationOfAdjustmentsForSurplusShortagesInProductLocations(ParametersStructure);
		
	EndIf;
	
EndProcedure

Procedure StartingBackgroundFormationOfAdjustmentsForSurplusShortagesInProductLocations(ParametersStructure) Export
	
	If Common.FileInfobase() Then
		GenerateAdjustmentsForSurplusShortagesByProductLocations(New Structure("ParametersStructure",ParametersStructure));	
	Else
		JobDescription = NStr("vi = 'Tạo điều chỉnh hàng thừa và hàng thiếu theo các chỗ hàng hóa trong Kho - %Warehouse%; Vị trí - %Premise%';
