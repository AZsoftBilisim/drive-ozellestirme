								|ru = 'В ячейку %1 запрещено размещать товары нескольких назначений';
								|en = 'Cannot place goods with several assignments to the cell %1'; fa = 'Cannot place goods with several assignments to the cell %1';
								|it = 'All''interno della cella %1 è vietato collocare merci di vario utilizzo';
								|pl = 'Do komórki %1 zabrania się umieszczanie towarów o kilku przeznaczeniach';
								|tr = 'Birden fazla atamaya yönelik ürünlerin %1 hücresine yerleştirilmesi yasaktır'");
		
		For Each ErrorString In ControlResults.MultipleAssignmentsInSeparateCells Do
			MessageText = StrTemplate(MessageTemplate, ErrorString.Cell);
