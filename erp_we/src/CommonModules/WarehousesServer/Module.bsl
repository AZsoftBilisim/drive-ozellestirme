Function GenerateAdjustmentsForSurplusShortagesByProductLocations(JobParameters) Export
	
	Warehouse = JobParameters.ParametersStructure.Warehouse;
	Premise = JobParameters.ParametersStructure.Premise;
	If JobParameters.Property("ErrorsCount") Then
		
		MaximumNumberOfErrors = 3;
		
		If JobParameters.ErrorsCount >= MaximumNumberOfErrors Then
			
			DefaultLanguageCode = CommonClientServer.DefaultLanguageCode();
			
			MessageText = NStr("vi = 'Đã dừng tạo các điều chỉnh hàng thừa và hàng thiếu theo các nơi hàng hóa theo Kho bãi - %Warehouse%; Vị trí - %Premise%. Đối với thông tin bổ sung, hãy chuyển đến danh sách kiểm đến hàng hóa. Số lượng thử không thành công: %ErrorsCount%';
								|ru = 'Формирование корректировок излишков и недостач по товарным местам остановлено по Складу - %Warehouse%; Помещению - %Premise%. Для дополнительной информации перейдите к списку пересчетов товаров. Количество неудачных попыток: %ErrorsCount%';
								|en = 'Generation of ""Inventory adjustment — Surpluses and shortages"" documents is stopped for Warehouse - %Warehouse%; Wareroom - %Premise%. Go to the inventory count list for details. Number of failed attempts: %ErrorsCount%'; fa = 'Generation of ""Inventory adjustment — Surpluses and shortages"" documents is stopped for Warehouse - %Warehouse%; Wareroom - %Premise%. Go to the inventory count list for details. Number of failed attempts: %ErrorsCount%';
								|it = 'La generazione di correzioni di eccedenze e ammanchi delle merci per il magazzino - %Warehouse% e locale - %Premise% è stata sospesa. Per ulteriori informazioni vai all''elenco di ricalcolo delle merci.Numero di tentativi falliti: %ErrorsCount%';
								|pl = 'Tworzenie zapisów korygujących nadwyżek i niedoborów dla miejsc towarowych zostało wstrzymane dla Magazynu - %Warehouse%; Lokalu - %Premise%. Aby uzyskać dodatkową informację przejdź do listy przeliczania towarów. Ilość nieudanych prób: %ErrorsCount%';
								|tr = 'Kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin oluşturulması Ambar - %Warehouse%; Depolama alanı - %Premise% için durdurulur. Daha fazla bilgi için stok sayımı listesine git. Başarısız deneme sayısı: %ErrorsCount%'");
			MessageText = StrReplace(MessageText, "%Warehouse%", Warehouse);
			MessageText = StrReplace(MessageText, "%Premise%", Premise);
			MessageText = StrReplace(MessageText, "%ErrorsCount%", JobParameters.ErrorsCount);
			
			WriteLogEvent(NStr("vi = 'Tạo điều chỉnh hàng thừa và hàng thiếu theo các chỗ hàng hóa';
								|ru = 'Формирование корректировок излишков и недостач по товарным местам';
								|en = 'Generation of ""Inventory adjustment — Surpluses and shortages"" documents'; fa = 'Generation of ""Inventory adjustment — Surpluses and shortages"" documents';
								|it = 'Generazione di correzioni di eccedenze e ammanchi delle merci';
								|pl = 'Tworzenie zapisów korygujących nadwyżki i niedoborów miejsc towarowych';
								|tr = 'Kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin oluşturulması'", DefaultLanguageCode),
				EventLogLevel.Error, , ,
				MessageText);
			
			Return True;
		EndIf;
	Else
		JobParameters.Insert("ErrorsCount", 0);
	EndIf;
	
	SetPrivilegedMode(True);
	
	HasError = False;
	
	If CheckWhetherThereAreEntriesInQueueForMakingAdjustmentsToSurplusesAndShortagesForProductLocations(JobParameters)
		And JobParameters.SurplusesShortages.Count() > 0 Then
		
		DocumentObject = Documents.InventoryAdjustmentSurplusesAndShortages.CreateDocument();
		
		DocumentObject.Warehouse     = JobParameters.ParametersStructure.Warehouse;
		DocumentObject.Premise = JobParameters.ParametersStructure.Premise;
		DocumentObject.Date      = CurrentSessionDate();
		
		DocumentObject.Goods.Load(JobParameters.SurplusesShortages);
		
		SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(DocumentObject, Documents.InventoryAdjustmentSurplusesAndShortages);
		ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters);
		
		Try
			DocumentObject.Write(DocumentWriteMode.Posting);
			ProvisionInDocumentsServer.CheckToRunBackgroundInventoryAllocationJob();
		Except
			
			HasError = True;
			
			MessageText = NStr("vi = 'Không thể ghi lại điều chỉnh hàng thừa và hàng thiếu theo các chỗ hàng hóa bởi nhiệm vụ nền theo nguyên nhân: %Cause%';
								|ru = 'Не удалось записать корректировку излишков и недостач по товарным местам фоновым заданием по причине: %Cause%';
								|en = 'Cannot save ""Inventory adjustment — Surpluses and shortages"" document using the background job. Reason: %Cause%'; fa = 'Cannot save ""Inventory adjustment — Surpluses and shortages"" document using the background job. Reason: %Cause%';
								|it = 'Impossibile registrare la correzione di  di eccedenze e ammanchi delle merci come un task in background a causa di: %Cause%';
								|pl = 'Nie udało się zapisać zadaniem w tle zapis korygujący nadwyżek i niedoborów dla miejsc towarowych z powodu: %Cause%';
								|tr = 'Arka plan işi ile stok düzeltmesi - fazlalıklar ve eksiklikler şu nedenle kaydedilemedi: %Cause%'");
			MessageText = StrReplace(MessageText, "%Document%", DocumentObject.Ref);
			MessageText = StrReplace(MessageText, "%Cause%", DetailErrorDescription(ErrorInfo()));
			WriteLogEvent(InfobaseUpdate.EventLogEvent(),
				EventLogLevel.Warning,
				Metadata.Documents.GoodsIssueNote,
				DocumentObject.Ref,
				MessageText);
			
		EndTry;
		
	EndIf;	
	
	If HasError Then
		DefaultLanguageCode = CommonClientServer.DefaultLanguageCode();
		JobParameters.ErrorsCount = JobParameters.ErrorsCount + 1;
		
		MessageText = NStr("vi = 'Có lỗi khi tạo điều chỉnh hàng thừa và hàng thiếu theo các chỗ hàng hóa. Kho bãi: %Warehouse%; Vị trí: %Premise%. Số lượng thử: %ErrorsCount%';
							|ru = 'Есть ошибки при оформлении корректировок излишков и недостач по товарным местам. Склад: %Warehouse%; Помещение: %Premise%. Количество попыток: %ErrorsCount%';
							|en = 'Errors occurred when registering ""Inventory adjustment — Surpluses and shortages"" document. Warehouse: %Warehouse%; Wareroom: %Premise%. Number of attempts: %ErrorsCount%'; fa = 'Errors occurred when registering ""Inventory adjustment — Surpluses and shortages"" document. Warehouse: %Warehouse%; Wareroom: %Premise%. Number of attempts: %ErrorsCount%';
							|it = 'Si sono verificati degli errori durante la registrazione delle correzioni di eccedenze e ammanchi delle merci. Magazzino: %Warehouse%; Locale: %Premise%. Numero di tentativi: %ErrorsCount%';
							|pl = 'Podczas tworzenia zapisu korygującego nadwyżek oraz niedoborów po miejscach towarowych wystąpiły błędy. Magazyn: %Warehouse%; Lokal: %Premise%. Ilość prób: %ErrorsCount%';
							|tr = 'Kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin işlenmesinde hatalar var. Ambar: %Warehouse%; Alan: %Premise%. Deneme sayısı: %ErrorsCount%'");
		MessageText = StrReplace(MessageText, "%Warehouse%", Warehouse);
		MessageText = StrReplace(MessageText, "%Premise%", Premise);
		MessageText = StrReplace(MessageText, "%ErrorsCount%", JobParameters.ErrorsCount);
		
		WriteLogEvent(NStr("vi = 'Tạo nền điều chỉnh hàng thừa và hàng thiếu theo chỗ hàng hóa';
							|ru = 'Фоновое оформление корректировок излишков и недостач по товарным местам';
							|en = 'Background registration of ""Inventory adjustment — Surpluses and shortages"" documents'; fa = 'Background registration of ""Inventory adjustment — Surpluses and shortages"" documents';
							|it = 'Registrazione delle correzioni di eccedenze e ammanchi delle merci in background';
							|pl = 'Tworzenie w tle zapisów korygujących nadwyżek i niedoborów dla miejsc towarowych';
							|tr = 'Kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin arka planda düzenlenmesi'", DefaultLanguageCode),
			EventLogLevel.Error, , ,
			MessageText);
	EndIf;
		
	If CheckWhetherThereAreEntriesInQueueForMakingAdjustmentsToSurplusesAndShortagesForProductLocations(JobParameters) Then
		GenerateAdjustmentsForSurplusShortagesByProductLocations(JobParameters);
	Else
		Return False;
	EndIf;	
	
EndFunction

Function CheckWhetherThereAreEntriesInQueueForMakingAdjustmentsToSurplusesAndShortagesForProductLocations(JobParameters)
	
	ThereAreEntriesInQueue = True;
	Warehouse = JobParameters.ParametersStructure.Warehouse;
	Premise = JobParameters.ParametersStructure.Premise;
	
	OpenSeparateTransaction = Not TransactionActive();
	
	If OpenSeparateTransaction Then
		BeginTransaction();
	EndIf;
		
	Try
		
		Block = New DataLock;
		
		LockItem = Block.Add("InformationRegister.InventoryAdjustmentSurplusesAndShortagesGenerationQueue");
		LockItem.Mode = DataLockMode.Exclusive;
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.SetValue("Premise", Premise);
		
		LockItem = Block.Add("AccumulationRegister.CargoItemsForRecordingSurplusesAndShortages");
		LockItem.Mode = DataLockMode.Shared;
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.SetValue("Premise", Premise);
		
		Block.Lock();
		
		QueryTexts = New ValueList;
		
		QueryText =
		"SELECT
		|	ProductLocationsBalance.Warehouse,
		|	ProductLocationsBalance.Premise,
		|	ProductLocationsBalance.Products,
		|	ProductLocationsBalance.Characteristic,
		|	ProductLocationsBalance.Purpose,
		|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
		|	ProductLocationsBalance.Series,
		|	ProductLocationsBalance.CargoItem,
		|	ProductLocationsBalance.CountBalance
		|INTO TTGoodsPlacesBalances
		|FROM
		|	AccumulationRegister.CargoItemsForRecordingSurplusesAndShortages.Balance(
		|			,
		|			Warehouse = &Warehouse
		|				AND Premise = &Premise) AS ProductLocationsBalance";
		
		QueryTexts.Add(QueryText, "TTGoodsPlacesBalances");	
		QueryTextTTCargoItemsForRecordingSurplusesAndShortages(QueryTexts, True);
		
		Query = New Query;
		Query.SetParameter("Warehouse", JobParameters.ParametersStructure.Warehouse);
		Query.SetParameter("Premise", JobParameters.ParametersStructure.Premise);
		
		SurplusesShortages = 	TMCommonUse.UploadResultsOfQuery(Query,QueryTexts,,True).TTCommodityPlacesToReflectSurplusShortages;
		JobParameters.Insert("SurplusesShortages", SurplusesShortages);
		
		If SurplusesShortages.Count() = 0 Then
			
			RecordSet = InformationRegisters.InventoryAdjustmentSurplusesAndShortagesGenerationQueue.CreateRecordSet();
			RecordSet.Filter.Warehouse.Set(Warehouse);
			RecordSet.Filter.Premise.Set(Premise);
			
			RecordSet.Write();
			
			ThereAreEntriesInQueue = False;
			
			If OpenSeparateTransaction Then
				CommitTransaction();
			EndIf;
		ElsIf OpenSeparateTransaction Then
			RollbackTransaction();
		EndIf;
		
	Except
		
		If OpenSeparateTransaction Then
			RollbackTransaction();
		EndIf;
		
		ThereAreEntriesInQueue = True;
		JobParameters.ErrorsCount = JobParameters.ErrorsCount + 1;
		
		DefaultLanguageCode = CommonClientServer.DefaultLanguageCode();
		MessageText = NStr("vi = 'Không thể tạo điều chỉnh hàng thừa và hàng thiếu theo các chỗ hàng hóa theo Kho bãi - %Warehouse%; Vị trí - %Premise%';
							|ru = 'Не удалось выполнить оформление корректировок излишков и недостач по товарным местам по Складу - %Warehouse%; Помещение - %Premise%';
							|en = 'Cannot register ""Inventory adjustment — Surpluses and shortages"" documents for Warehouse - %Warehouse%; Wareroom - %Premise%'; fa = 'Cannot register ""Inventory adjustment — Surpluses and shortages"" documents for Warehouse - %Warehouse%; Wareroom - %Premise%';
							|it = 'Impossibile registrare le correzioni di eccedenze e ammanchi delle merci per il Magazzino - %Warehouse%; Locale - %Premise%';
							|pl = 'Nie powiodło się tworzenie zapisów korygujących nadwyżek i niedoborów dla miejsc towarowych dla Magazynu - %Warehouse%;Lokal - %Premise%';
							|tr = 'Ambar - %Warehouse%; Depolama alanı - %Premise% için kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmeleri düzenlenemedi'",
			DefaultLanguageCode);
		
		MessageText = StrReplace(MessageText, "%Warehouse%", Warehouse);
		MessageText = StrReplace(MessageText, "%Premise%", Premise);
		
		WriteLogEvent(NStr("vi = 'Tạo nền điều chỉnh hàng thừa và hàng thiếu theo các chỗ hàng hóa';
							|ru = 'Фоновое оформление корректировок излишков и недостач по товарным местам';
							|en = 'Background registration of ""Inventory adjustment — Surpluses and shortages"" documents'; fa = 'Background registration of ""Inventory adjustment — Surpluses and shortages"" documents';
							|it = 'Registrazione delle correzioni di eccedenze e ammanchi delle merci in background';
							|pl = 'Tworzenie w tle zapisów korygujących nadwyżek i niedoborów dla miejsc towarowych';
							|tr = 'Kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin arka planda düzenlenmesi'", DefaultLanguageCode),
			EventLogLevel.Error, , ,
			MessageText);
		
	EndTry;
	
	Return ThereAreEntriesInQueue;
	
EndFunction

Function QueryTextTTCargoItemsForRecordingSurplusesAndShortages(QueryTexts, SubstringData = False) Export
	
	If Not DocumentsPosting.ThereIsQueryTable("TTProductItems", QueryTexts) Then
		QueryTextTTProductItemsLocations(QueryTexts);
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable("TTSetsOnCommodityRequirementsForReflectionOfSurplusShortages", QueryTexts) Then
		QueryTextTTSetsOnCommodityRequirementsForReflectionOfSurplusShortages(QueryTexts);
	EndIf;
		
	QueryText =
	"SELECT
	|	KitsForRegistration.Products,
	|	KitsForRegistration.Characteristic,
	|	KitsForRegistration.Purpose,
	|	KitsForRegistration.ControlledLotReference,
	|	KitsForRegistration.Series,
	|	KitsForRegistration.OperationKind,
	|	KitsForRegistration.KitCount AS Count,
	|	ProductItemsLocations.CargoItem AS Package,
	|	KitsForRegistration.KitCount * ProductItemsLocations.NumberOfSeats AS NumberOfPackages
	|INTO TTCommodityPlacesToReflectSurplusShortages
	|FROM
	|	TTSetsOnCommodityRequirementsForReflectionOfSurplusShortages AS KitsForRegistration
	|		INNER JOIN TTProductItems AS ProductItemsLocations
	|		ON KitsForRegistration.Products = ProductItemsLocations.Products
	|			AND KitsForRegistration.Characteristic = ProductItemsLocations.Characteristic
	|			AND KitsForRegistration.Purpose = ProductItemsLocations.Purpose
	|			AND KitsForRegistration.ControlledLotReference = ProductItemsLocations.ControlledLotReference
	|			AND KitsForRegistration.Series = ProductItemsLocations.Series";
	
	If SubstringData Then
		QueryText = StrReplace(QueryText, "INTO TTCommodityPlacesToReflectSurplusShortages", "");
	EndIf;
		
	QueryTexts.Add(QueryText, "TTCommodityPlacesToReflectSurplusShortages");	
	
	Return QueryText;
	
EndFunction

Function QueryTextTTProductItemsLocations(QueryTexts)
	
	If Not DocumentsPosting.ThereIsQueryTable("TTGoodsPlacesBalances", QueryTexts) Then
		ExceptionText = NStr("vi = 'Lỗi gọi ra hàm %Couples1%: trong truy vấn chưa bổ sung bảng %Couples2%';
							|ru = 'Ошибка вызова функции %Couples1%: в запрос не добавлена таблица %Couples2%';
							|en = 'An error occurred when calling the %Couples1% function: the %Couples2% table is not added to the request.'; fa = 'An error occurred when calling the %Couples1% function: the %Couples2% table is not added to the request.';
							|it = 'Errore di chiamata della funzione СкладыСервер.%Couples1%: alla query non è aggiunta la tabella %Couples2%';
							|pl = 'Niepowodzenie wywołania funkcji %Couples1%: do zapytania nie dodano tabeli %Couples2%';
							|tr = '%Couples1% işlevi çağrılırken hata oluştu: %Couples2% tablosu sorguya eklenmedi'");
		ExceptionText = StrReplace(ExceptionText, "%Couples2%", "TTGoodsPlacesBalances()");
		ExceptionText = StrReplace(ExceptionText, "%Couples1%", "WarehousesServer.QueryTextTTProductItemsLocations");
	EndIf;
	
	TableName = "TTProductItems";
	
	QueryText = 
	"SELECT DISTINCT
	|	ProductLocationsBalance.Warehouse,
	|	ProductLocationsBalance.Premise,
	|	ProductLocationsBalance.Products,
	|	ProductLocationsBalance.Characteristic,
	|	ProductLocationsBalance.Purpose,
	|	ProductLocationsBalance.ControlledLotReference,
	|	ProductLocationsBalance.Series,
	|	PackagesAndUnitsOfMeasure.Ref AS CargoItem,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages AS NumberOfSeats
	|INTO TTProductItems
	|FROM
	|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		INNER JOIN TTGoodsPlacesBalances AS ProductLocationsBalance
	|		ON (PackagesAndUnitsOfMeasure.Owner = CASE
	|				WHEN ProductLocationsBalance.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
	|					THEN ProductLocationsBalance.Products.Ref
	|				ELSE ProductLocationsBalance.Products.PackagingGroup
	|			END)
	|WHERE
	|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)";
	
	QueryTexts.Add(QueryText, TableName);
	
	Return QueryText;	
	
EndFunction

Function QueryTextTTSetsOnCommodityRequirementsForReflectionOfSurplusShortages(QueryTexts) Export
	
	If Not DocumentsPosting.ThereIsQueryTable("TTGoodsPlacesBalances", QueryTexts) Then
		ExceptionText = NStr("vi = 'Lỗi gọi ra hàm %Couples1%: trong truy vấn chưa bổ sung bảng %Couples2%';
							|ru = 'Ошибка вызова функции %Couples1%: в запрос не добавлена таблица %Couples2%';
							|en = 'An error occurred when calling the %Couples1% function: the %Couples2% table is not added to the request.'; fa = 'An error occurred when calling the %Couples1% function: the %Couples2% table is not added to the request.';
							|it = 'Errore di chiamata della funzione СкладыСервер.%Couples1%: alla query non è aggiunta la tabella %Couples2%';
							|pl = 'Niepowodzenie wywołania funkcji %Couples1%: do zapytania nie dodano tabeli %Couples2%';
							|tr = '%Couples1% işlevi çağrılırken hata oluştu: %Couples2% tablosu sorguya eklenmedi'");
		ExceptionText = StrReplace(ExceptionText, "%Couples2%", "TTGoodsPlacesBalances");
		ExceptionText = StrReplace(ExceptionText, "%Couples1%", "WarehousesServer.TTSetsOnCommodityRequirementsForReflectionOfSurplusShortages()");
	EndIf;
	
	If Not DocumentsPosting.ThereIsQueryTable("TTProductItems", QueryTexts) Then
		QueryTextTTProductItemsLocations(QueryTexts);
	EndIf;
	
	TableName = "TTSetsOnCommodityRequirementsForReflectionOfSurplusShortages";
	
	QueryText = 
	"SELECT
	|	ProductItemsLocations.Warehouse AS Warehouse,
	|	ProductItemsLocations.Premise AS Premise,
	|	ProductItemsLocations.Products AS Products,
	|	ProductItemsLocations.Characteristic AS Characteristic,
	|	ProductItemsLocations.Purpose AS Purpose,
	|	ProductItemsLocations.ControlledLotReference AS ControlledLotReference,
	|	ProductItemsLocations.Series AS Series,
	|	VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.RecordSurplus) AS OperationKind,
	|	MIN(CASE
	|			WHEN (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) - ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats <= 0
	|				THEN CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))
	|			ELSE (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) - 1
	|		END) AS KitCount
	|INTO TTSetsOnCommodityRequirementsForReflectionOfSurplusShortages
	|FROM
	|	TTProductItems AS ProductItemsLocations
	|		LEFT JOIN TTGoodsPlacesBalances AS ProductLocationsBalance
	|		ON ProductItemsLocations.Warehouse = ProductLocationsBalance.Warehouse
	|			AND ProductItemsLocations.Premise = ProductLocationsBalance.Premise
	|			AND ProductItemsLocations.Products = ProductLocationsBalance.Products
	|			AND ProductItemsLocations.Characteristic = ProductLocationsBalance.Characteristic
	|			AND ProductItemsLocations.Purpose = ProductLocationsBalance.Purpose
	|			AND ProductItemsLocations.ControlledLotReference = ProductLocationsBalance.ControlledLotReference
	|			AND ProductItemsLocations.Series = ProductLocationsBalance.Series
	|			AND ProductItemsLocations.CargoItem = ProductLocationsBalance.CargoItem
	|			AND (ProductLocationsBalance.CountBalance > 0)
	|
	|GROUP BY
	|	ProductItemsLocations.Series,
	|	ProductItemsLocations.Purpose,
	|	ProductItemsLocations.ControlledLotReference,
	|	ProductItemsLocations.Premise,
	|	ProductItemsLocations.Characteristic,
	|	ProductItemsLocations.Warehouse,
	|	ProductItemsLocations.Products
	|
	|HAVING
	|	MIN(CASE
	|			WHEN (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) - ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats <= 0
	|				THEN CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))
	|			ELSE (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) - 1
	|		END) > 0
	|
	|UNION ALL
	|
	|SELECT
	|	ProductItemsLocations.Warehouse,
	|	ProductItemsLocations.Premise,
	|	ProductItemsLocations.Products,
	|	ProductItemsLocations.Characteristic,
	|	ProductItemsLocations.Purpose,
	|	ProductItemsLocations.ControlledLotReference,
	|	ProductItemsLocations.Series,
	|	VALUE(Enum.OperationKindsOfStockBalanceAdjustingEntries.RecordShortage),
	|	-MIN(CASE
	|			WHEN (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) - ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats > 0
	|				THEN CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))- 1
	|			ELSE (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) 
	|		END)
	|FROM
	|	TTProductItems AS ProductItemsLocations
	|		LEFT JOIN TTGoodsPlacesBalances AS ProductLocationsBalance
	|		ON ProductItemsLocations.Warehouse = ProductLocationsBalance.Warehouse
	|			AND ProductItemsLocations.Premise = ProductLocationsBalance.Premise
	|			AND ProductItemsLocations.Products = ProductLocationsBalance.Products
	|			AND ProductItemsLocations.Characteristic = ProductLocationsBalance.Characteristic
	|			AND ProductItemsLocations.Purpose = ProductLocationsBalance.Purpose
	|			AND ProductItemsLocations.ControlledLotReference = ProductLocationsBalance.ControlledLotReference
	|			AND ProductItemsLocations.Series = ProductLocationsBalance.Series
	|			AND ProductItemsLocations.CargoItem = ProductLocationsBalance.CargoItem
	|			AND (ProductLocationsBalance.CountBalance < 0)
	|
	|GROUP BY
	|	ProductItemsLocations.Series,
	|	ProductItemsLocations.Purpose,
	|	ProductItemsLocations.ControlledLotReference,
	|	ProductItemsLocations.Premise,
	|	ProductItemsLocations.Characteristic,
	|	ProductItemsLocations.Warehouse,
	|	ProductItemsLocations.Products
	|
	|HAVING
	|	-MIN(CASE
	|			WHEN (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) - ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats > 0
	|				THEN CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))- 1
	|			ELSE (CAST(ISNULL(ProductLocationsBalance.CountBalance, 0) / ProductItemsLocations.NumberOfSeats AS NUMBER(12, 0))) 
	|		END)> 0";	
		
	QueryTexts.Add(QueryText, TableName);
	
	Return QueryText;
	
EndFunction

Function GenerateAdjustmentsForSurplusShortagesByProductLocationsForAllWarehousePremises(Warehouse) Export

	Premises = PremisesForWhichThereIsNoBackgroundTaskForFormationOfAdjustmentsForSurplusShortagesInCommodityPlaces(Warehouse);
	HasError = False;
	For Each Premise In Premises Do
		
		JobParameters = New Structure;
		ParametersStructure = New Structure;
		
		ParametersStructure.Insert("Warehouse", Warehouse);
		ParametersStructure.Insert("Premise", Premise);
		
		JobParameters.Insert("ParametersStructure", ParametersStructure);
		
		HasError = GenerateAdjustmentsForSurplusShortagesByProductLocations(JobParameters)
			Or HasError;
	EndDo;
	
	Return HasError;
	
EndFunction

Function ThereArePremisesForWhichThereIsNoBackgroundTaskForFormationOfAdjustmentsForSurplusShortagesInCommodityPlaces(Warehouse) Export
	
	Return PremisesForWhichThereIsNoBackgroundTaskForFormationOfAdjustmentsForSurplusShortagesInCommodityPlaces(Warehouse).Count() > 0;
	
EndFunction

Function PremisesForWhichThereIsNoBackgroundTaskForFormationOfAdjustmentsForSurplusShortagesInCommodityPlaces(Warehouse)
	
	SetPrivilegedMode(True);
	BeginTransaction();
	Result = New Array;
	Block = New DataLock;
		
	LockItem = Block.Add("InformationRegister.InventoryAdjustmentSurplusesAndShortagesGenerationQueue");
	LockItem.Mode = DataLockMode.Shared;
	LockItem.SetValue("Warehouse", Warehouse);
		
	Try
		
		Block.Lock();
		
		
	Except
		
		RollbackTransaction();
		
		DefaultLanguageCode = CommonClientServer.DefaultLanguageCode();
		MessageText = NStr("vi = 'Không thể phong tỏa biểu ghi thông tin %Register% theo kho bãi ""%Warehouse%"" để kiểm tra hoạt động của nhiệm vụ thường kỳ do nguyên nhân: %Cause%';
							|ru = 'Не удалось заблокировать регистр сведений %Register% по складу ""%Warehouse%"" для проверки работы фоновых заданий по причине: %Cause%';
							|en = 'Cannot lock the %Register% information register for warehouse %Warehouse% to check background jobs. Reason: %Cause%'; fa = 'Cannot lock the %Register% information register for warehouse %Warehouse% to check background jobs. Reason: %Cause%';
							|it = 'Impossibile bloccare il registro delle informazioni %Register% relative al magazzino ""%Warehouse%"" per verificare il funzionamento dei task in background a causa: %Cause%';
							|pl = 'Nie udało się zablokować rejestr informacji %Register% dla magazynu ""%Warehouse%"" aby sprawdzić pracę zadań w tle z powodu: %Cause%';
							|tr = 'Arka plan işlerinin çalışmasını kontrol etmek için ""%Warehouse%"" ambarı için %Register% bilgi kaydetme kilitlenemedi çünkü: %Cause%'",
			DefaultLanguageCode);
		
		MessageText = StrReplace(MessageText, "%Register%", "InventoryAdjustmentSurplusesAndShortagesGenerationQueue");
		MessageText = StrReplace(MessageText, "%Warehouse%", Warehouse);
		MessageText = StrReplace(MessageText, "%Cause%", DetailErrorDescription(ErrorInfo()));
		
		WriteLogEvent(InfobaseUpdate.EventLogEvent(),
			EventLogLevel.Error, , ,
			MessageText);
		
		Return Result;
		
	EndTry;
	
	Query = New Query;
	Query.Text = 
	"SELECT
	|	InventoryAdjustmentSurplusesAndShortagesGenerationQueue.Warehouse,
	|	InventoryAdjustmentSurplusesAndShortagesGenerationQueue.Premise
	|FROM
	|	InformationRegister.InventoryAdjustmentSurplusesAndShortagesGenerationQueue AS InventoryAdjustmentSurplusesAndShortagesGenerationQueue
	|WHERE
	|	InventoryAdjustmentSurplusesAndShortagesGenerationQueue.Warehouse = &Warehouse";
	Query.SetParameter("Warehouse", Warehouse);
	
	Selection = Query.Execute().Select();
	
	While Selection.Next() Do
		Var_Key = "FormationOfAdjustmentsForSurplusShortagesInCommodityPlaces"
		+ String(Selection.Warehouse.UUID())
		+ String(Selection.Premise.UUID());
		
		Filter = New Structure();
		Filter.Insert("Key", Var_Key);
		Filter.Insert("State", BackgroundJobState.Active);
		
		ActiveTasks = BackgroundJobs.GetBackgroundJobs(Filter);
		
		If ActiveTasks.Count() = 0 Then
			Result.Add(Selection.Premise);
		EndIf;
		
	EndDo;
	
	RollbackTransaction();
		
	Return Result;
	
EndFunction

