#Region WarehouseSettingsValues

// Returns whether the warehouse is used for storage facilities.
//
//	Parameters:
//		Warehouse - CatalogRef.Warehouses - link to the "Warehouses" reference list item"
//		Date - Date - for which the use of the order scheme is checked during shipment
//		ConsiderDate - Boolean - indicates whether to take into account the start date of storage space use.
//
//	Returns:
//		Boolean - a sign of the use of storage facilities.
//
Function UseWarerooms(Warehouse, Date = Undefined, ConsiderDate = True) Export
	
	If Not ValueIsFilled(Warehouse) Then
		Return False;
	EndIf;
	
	If Not ConsiderDate Then
		Return GetFunctionalOption("UseWarerooms", New Structure("Warehouse",Warehouse));
	EndIf;
	
	CheckDate = ?(ValueIsFilled(Date), Date, CurrentSessionDate());
	SetPrivilegedMode(True);
	ParametersStructure = Common.ObjectAttributesValues(Warehouse, "UseWarerooms, StartDateOfWareroomUse");
	SetPrivilegedMode(False);
	
	Return ParametersStructure.UseWarerooms And (CheckDate >= ParametersStructure.StartDateOfWareroomUse);
	
EndFunction

// The function returns whether the reference placement of products in cells is used in the warehouse (room).
//
// Parameters:
//  Warehouse			 - CatalogRef.Warehouses - link to the "Warehouses" reference list item
//  Premise		 - CatalogRef.Warerooms - link to the "Storage rooms" reference list item"
//  Date			 - Date - the date on which the use of reference placement of products in cells is checked
//  ConsiderDate	 - Boolean - indicates whether the date should be taken into account.
// 
// Returns:
//  Boolean - indication of the use of address storage for reference.
//
Function UseBinLocationWarehousingForInformation(Warehouse, Premise, Date = Undefined, ConsiderDate = True) Export
	
	If Not ValueIsFilled(Warehouse) Then
		Return False;
	EndIf;
	If Not ConsiderDate Then
		ParametersStructure = New Structure("Warehouse,Premise",Warehouse,Premise);
		Return GetFunctionalOption("UseBinLocationWarehousingForInformation", ParametersStructure);
	EndIf;
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	1 AS Field1
		|FROM
		|	InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOfBinLocationWarehouses
		|WHERE
		|	SettingsOfBinLocationWarehouses.UseBinLocationWarehousingForInformation
		|	AND (NOT SettingsOfBinLocationWarehouses.UseBinLocationWarehousing
		|			OR SettingsOfBinLocationWarehouses.StartDateOfUsingWarehouseBinSystem > &Date)
		|	AND SettingsOfBinLocationWarehouses.Warehouse = &Warehouse
		|	AND SettingsOfBinLocationWarehouses.Premise = &Premise
		|	AND (NOT &Premise = VALUE(Catalog.Warerooms.EmptyRef)
		|			OR (NOT SettingsOfBinLocationWarehouses.Warehouse.UseWarerooms
		|				OR &Date < SettingsOfBinLocationWarehouses.Warehouse.StartDateOfWareroomUse))";
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",
		?(ValueIsFilled(Premise),Premise,Catalogs.Warerooms.EmptyRef()));
	Query.SetParameter("Date",
		?(ValueIsFilled(Date),Date,CurrentSessionDate()));
	
	Return Not Query.Execute().IsEmpty();
	
EndFunction

