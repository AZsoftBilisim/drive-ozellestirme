// Checks the use of cells in PM according to the rules for placing separate products
// 
// Parameters:
//  Object	- DocumentObject - the document in the PM of which you need to check the filling of premises. 
//  		- ClientApplicationForm - the object, in the TS of which it is necessary to check the occupancy of the premises, must contain:
//				* Ref - DocumentRef
//  			* Cell - CatalogRef.StorageBins
//  			* Products - CatalogRef.Products
//  			* Purpose - CatalogRef.Assignments
//	Cancel - Boolean - failure to continue the operation
//	TSName - String - the name of the table you want to check.
Procedure CheckUseOfCellsAccordingToSeparationRules(Object, Cancel, TSName) Export
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	TableTS.LineNumber,
		|	TableTS.Cell,
		|	TableTS.Products,
		|	TableTS.Purpose
		|INTO TableTS
		|FROM
		|	&TableTS AS TableTS
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TableTS.LineNumber,
		|	TableTS.Cell
		|FROM
		|	TableTS AS TableTS
		|		INNER JOIN Catalog.StorageBins AS StorageBins
		|		ON TableTS.Cell = StorageBins.Ref
		|WHERE
		|	StorageBins.StorageArea.ControlQuantityOfAssignmentsInBins
		|	AND StorageBins.StorageArea.SeparateStorageArea
		|	AND TableTS.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		|	AND CAST(TableTS.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)";
		
	Query.SetParameter("TableTS", 
		Object[TSName].Unload(, "LineNumber, Cell, Products, Purpose"));
	QueryResult = Query.Execute();
	
	SelectionDetailRecords = QueryResult.Select();
	
	MessageTemplate = NStr("vi = 'Trong dòng %LineNumber% của danh sách ""%GoodsTable%"" trong ô %Cell%, không được phép đặt hàng mà không có đích.';
							|ru = 'В строке %LineNumber% списка ""%GoodsTable%"" в ячейку %Cell% запрещено размещать товары без назначения.';
							|en = 'Goods without assignment cannot be placed in the %Cell% bin in line %LineNumber% of the ""%GoodsTable%"" list.'; fa = 'Goods without assignment cannot be placed in the %Cell% bin in line %LineNumber% of the ""%GoodsTable%"" list.';
							|it = 'Non è consentito collocare le merci senza un''assegnazione nella riga %LineNumber% dell''elenco  ""%GoodsTable%"" nella cella %Cell%.';
							|pl = 'W wierszu %LineNumber% listy ""%GoodsTable%"" w pozycji %Cell% zabronione jest umieszczanie towarów bez przeznaczenia.';
							|tr = '""%GoodsTable%"" listesinin %LineNumber% satırındaki atanmamış öğelerin %Cell% hücresine yerleştirilmesi yasaktır.'");
	
	If TypeOf(Object) <> Type("ClientApplicationForm") Then
		ObjectMetadata = Object.Ref.Metadata();
	Else
		ObjectMetadata = Object.Metadata();
	EndIf;
	
	PresentationOfTS = ObjectMetadata.TabularSections[TSName].Synonym;
	DataKey = TMCommonUse.DataKeyForMessageToUser(Object);
	
	While SelectionDetailRecords.Next() Do
		
		MessageText = StrReplace(MessageTemplate, "%Cell%", SelectionDetailRecords.Cell);
		MessageText = StrReplace(MessageText, "%GoodsTable%", PresentationOfTS);
		MessageText = StrReplace(MessageText, "%LineNumber%", SelectionDetailRecords.LineNumber);
		
		Field = CommonClientServer.PathToTabularSection(TSName, SelectionDetailRecords.LineNumber, "Premise");
		
		CommonClientServer.MessageToUser(MessageText, DataKey, Field, "Object", Cancel);
		
	EndDo;

EndProcedure

