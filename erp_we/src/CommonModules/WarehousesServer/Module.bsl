#Region Private

#Region CalculationOfDocumentStates

Procedure CalculateShortageOfPackagesForSelectionByOrder(TempTablesManager, Warehouse, Premise)
	
	TypeProducts = New TypeDescription("CatalogRef.Products");
	TypeCharacteristic = New TypeDescription("CatalogRef.ItemsCharacteristics");
	TypeSeries = New TypeDescription("CatalogRef.ItemsBatches");
	TypePurpose = New TypeDescription("CatalogRef.Assignments");
	NumberType15_3 = TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative);
	
	FlowTableFromCells = New ValueTable;
	FlowTableFromCells.Columns.Add("Products", TypeProducts);
	FlowTableFromCells.Columns.Add("Characteristic", TypeCharacteristic);
	FlowTableFromCells.Columns.Add("Purpose", TypePurpose);
	FlowTableFromCells.Columns.Add("Series", TypeSeries);
	FlowTableFromCells.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	FlowTableFromCells.Columns.Add("AvailableStock", NumberType15_3);
	FlowTableFromCells.Columns.Add("Expected_", NumberType15_3);
	FlowTableFromCells.Columns.Add("InAcceptance", NumberType15_3);
	
	FlowTableFromCells.Indexes.Add("Products,Characteristic,Purpose,Series,Package");
	
	StateTable = New ValueTable;
	StateTable.Columns.Add("Products", TypeProducts);
	StateTable.Columns.Add("ReferenceOrder", New TypeDescription("DocumentRef.GoodsIssueNote,DocumentRef.GoodsTransferNote,DocumentRef.TransportationJob,DocumentRef.Trip"));
	StateTable.Columns.Add("Characteristic", TypeCharacteristic);
	StateTable.Columns.Add("Purpose", TypePurpose);
	StateTable.Columns.Add("Series", TypeSeries);
	StateTable.Columns.Add("State", New TypeDescription("Number",,,New NumberQualifiers(5,0,AllowedSign.Nonnegative)));
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	
	QueryText =
	"SELECT
	|	GoodsInStorageBinsBalance.Products,
	|	GoodsInStorageBinsBalance.Characteristic,
	|	GoodsInStorageBinsBalance.Purpose,
	|	GoodsInStorageBinsBalance.Series,
	|	GoodsInStorageBinsBalance.Package,
	|	GoodsInStorageBinsBalance.Package.PackageType AS PackageType,
	|	SUM(CASE
	|			WHEN GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Receiving)
	|				THEN 0
	|			ELSE GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance
	|		END) AS AvailableStock,
	|	SUM(CASE
	|			WHEN GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Receiving)
	|				THEN 0
	|			ELSE GoodsInStorageBinsBalance.ForPlacementBalance
	|		END) AS Expected_,
	|	SUM(CASE
	|			WHEN GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Receiving)
	|				THEN GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance
	|			ELSE 0
	|		END) AS InAcceptance
	|INTO GoodsInStorageBinsBalance
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			(Products, Characteristic, Purpose) IN
	|					(SELECT
	|						ProductsTable.Products AS Products,
	|						ProductsTable.Characteristic AS Characteristic,
	|						ProductsTable.Purpose AS Purpose
	|					FROM
	|						ProductsTable AS ProductsTable)
	|				AND Cell IN
	|					(SELECT
	|						CatCells.Ref AS StorageBin
	|					FROM
	|						Catalog.StorageBins AS CatCells
	|							LEFT JOIN InformationRegister.StorageBinsLocks AS CellLocks
	|							ON
	|								CatCells.Ref = CellLocks.Cell
	|									AND (CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Full)
	|										OR CellLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Filter))
	|					WHERE
	|						CellLocks.LockType IS NULL 
	|						AND CatCells.Premise = &Premise
	|						AND CatCells.Owner = &Warehouse
	|						AND NOT CatCells.IsFolder
	|						AND (CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
	|							OR CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Archive)
	|							OR CatCells.StorageBinType = VALUE(Enum.TypesOfStorageCells.Receiving)))) AS GoodsInStorageBinsBalance
	|
	|GROUP BY
	|	GoodsInStorageBinsBalance.Characteristic,
	|	GoodsInStorageBinsBalance.Purpose,
	|	GoodsInStorageBinsBalance.Series,
	|	GoodsInStorageBinsBalance.Package,
	|	GoodsInStorageBinsBalance.Products,
	|	GoodsInStorageBinsBalance.Package.PackageType
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	PackagesAndUnitsOfMeasure.Ref AS CargoItem,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages,
	|	GoodsInStorageBinsBalance.Products,
	|	GoodsInStorageBinsBalance.Characteristic,
	|	GoodsInStorageBinsBalance.Purpose,
	|	GoodsInStorageBinsBalance.Series
	|INTO ProductLocations
	|FROM
	|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		INNER JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
	|		ON PackagesAndUnitsOfMeasure.Owner = GoodsInStorageBinsBalance.Products
	|WHERE
	|	ISNULL(PackagesAndUnitsOfMeasure.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	AND ISNULL(GoodsInStorageBinsBalance.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	AND NOT PackagesAndUnitsOfMeasure.DeletionMark
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	PackagesAndUnitsOfMeasure.Ref,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages,
	|	GoodsInStorageBinsBalance.Products,
	|	GoodsInStorageBinsBalance.Characteristic,
	|	GoodsInStorageBinsBalance.Purpose,
	|	GoodsInStorageBinsBalance.Series
	|FROM
	|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		INNER JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
	|		ON PackagesAndUnitsOfMeasure.Owner = GoodsInStorageBinsBalance.Products.PackagingGroup
	|WHERE
	|	ISNULL(PackagesAndUnitsOfMeasure.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	AND ISNULL(GoodsInStorageBinsBalance.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	AND NOT PackagesAndUnitsOfMeasure.DeletionMark
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductLocations.Products,
	|	ProductLocations.Characteristic,
	|	ProductLocations.Purpose,
	|	ProductLocations.Series,
	|	ProductLocations.NumberOfPackages,
	|	ISNULL(GoodsInStorageBinsBalance.AvailableStock, 0) AS AvailableStock,
	|	ISNULL(GoodsInStorageBinsBalance.Expected_, 0) AS Expected_,
	|	ISNULL(GoodsInStorageBinsBalance.InAcceptance, 0) AS InAcceptance
	|INTO ProductsInCellsBalancesSets
	|FROM
	|	ProductLocations AS ProductLocations
	|		LEFT JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
	|		ON ProductLocations.Products = GoodsInStorageBinsBalance.Products
	|			AND ProductLocations.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|			AND ProductLocations.Purpose = GoodsInStorageBinsBalance.Purpose
	|			AND ProductLocations.Series = GoodsInStorageBinsBalance.Series
	|WHERE
	|	ISNULL(GoodsInStorageBinsBalance.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsInCellsBalancesSets.Products,
	|	ProductsInCellsBalancesSets.Characteristic,
	|	ProductsInCellsBalancesSets.Purpose,
	|	ProductsInCellsBalancesSets.Series,
	|	MIN(CASE
	|			WHEN ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages - (CAST(ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) >= 0
	|				THEN CAST(ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))
	|			ELSE (CAST(ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) - 1
	|		END) AS AvailableStock,
	|	MIN(CASE
	|			WHEN ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages - (CAST(ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) >= 0
	|				THEN CAST(ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))
	|			ELSE (CAST(ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) - 1
	|		END) AS Expected_,
	|	MIN(CASE
	|			WHEN ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages - (CAST(ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) >= 0
	|				THEN CAST(ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))
	|			ELSE (CAST(ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) - 1
	|		END) AS InAcceptance
	|INTO ProductsInCellsLeftoverSets
	|FROM
	|	ProductsInCellsBalancesSets AS ProductsInCellsBalancesSets
	|
	|GROUP BY
	|	ProductsInCellsBalancesSets.Products,
	|	ProductsInCellsBalancesSets.Characteristic,
	|	ProductsInCellsBalancesSets.Purpose,
	|	ProductsInCellsBalancesSets.Series
	|
	|HAVING
	|	(MIN(CASE
	|				WHEN ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages - (CAST(ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) >= 0
	|					THEN CAST(ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))
	|				ELSE (CAST(ProductsInCellsBalancesSets.AvailableStock / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) - 1
	|			END) <> 0
	|		OR MIN(CASE
	|				WHEN ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages - (CAST(ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) >= 0
	|					THEN CAST(ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))
	|				ELSE (CAST(ProductsInCellsBalancesSets.Expected_ / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) - 1
	|			END) <> 0
	|		OR MIN(CASE
	|				WHEN ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages - (CAST(ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) >= 0
	|					THEN CAST(ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))
	|				ELSE (CAST(ProductsInCellsBalancesSets.InAcceptance / ProductsInCellsBalancesSets.NumberOfPackages AS NUMBER(12, 0))) - 1
	|			END) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InternalTable.Products AS Products,
	|	InternalTable.Characteristic AS Characteristic,
	|	InternalTable.Purpose AS Purpose,
	|	InternalTable.Series AS Series,
	|	InternalTable.ReferenceOrder AS ReferenceOrder,
	|	InternalTable.DateOfShipment,
	|	InternalTable.Priority,
	|	InternalTable.Count,
	|	InternalTable.AvailableStock,
	|	InternalTable.Expected_,
	|	InternalTable.InAcceptance,
	|	InternalTable.Package,
	|	InternalTable.QuantityPerPackage
	|FROM
	|	(SELECT
	|		ProductsTable.Products AS Products,
	|		ProductsTable.Characteristic AS Characteristic,
	|		ProductsTable.Purpose AS Purpose,
	|		ProductsTable.Series AS Series,
	|		ProductsTable.ReferenceOrder AS ReferenceOrder,
	|		ProductsTable.DateOfShipment AS DateOfShipment,
	|		ProductsTable.Priority AS Priority,
	|		ProductsTable.Count AS Count,
	|		SUM(ISNULL(GoodsInStorageBinsBalance.AvailableStock, 0)) AS AvailableStock,
	|		SUM(ISNULL(GoodsInStorageBinsBalance.Expected_, 0)) AS Expected_,
	|		ISNULL(GoodsInStorageBinsBalance.InAcceptance, 0) AS InAcceptance,
	|		VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS Package,
	|		1 AS QuantityPerPackage
	|	FROM
	|		ProductsTable AS ProductsTable
	|			LEFT JOIN ProductsInCellsBalancesSets AS GoodsInStorageBinsBalance
	|			ON ProductsTable.Products = GoodsInStorageBinsBalance.Products
	|				AND ProductsTable.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|				AND ProductsTable.Purpose = GoodsInStorageBinsBalance.Purpose
	|				AND (CASE
	|					WHEN ProductsTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|						THEN TRUE
	|					ELSE ProductsTable.Series = GoodsInStorageBinsBalance.Series
	|				END)
	|	
	|	GROUP BY
	|		ProductsTable.Characteristic,
	|		ProductsTable.DateOfShipment,
	|		ProductsTable.Priority,
	|		ProductsTable.Products,
	|		ProductsTable.Purpose,
	|		ProductsTable.Series,
	|		ProductsTable.ReferenceOrder,
	|		ProductsTable.Count,
	|		ISNULL(GoodsInStorageBinsBalance.InAcceptance, 0)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ProductsTable.Products,
	|		ProductsTable.Characteristic,
	|		ProductsTable.Purpose,
	|		ProductsTable.Series,
	|		ProductsTable.ReferenceOrder,
	|		ProductsTable.DateOfShipment,
	|		ProductsTable.Priority,
	|		ProductsTable.Count,
	|		SUM(ISNULL(GoodsInStorageBinsBalance.AvailableStock, 0)),
	|		SUM(ISNULL(GoodsInStorageBinsBalance.Expected_, 0)),
	|		ISNULL(GoodsInStorageBinsBalance.InAcceptance, 0),
	|		ISNULL(GoodsInStorageBinsBalance.Package, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)),
	|		ISNULL(&QueryTextPackagingFactor, 1)
	|	FROM
	|		ProductsTable AS ProductsTable
	|			LEFT JOIN GoodsInStorageBinsBalance AS GoodsInStorageBinsBalance
	|			ON ProductsTable.Products = GoodsInStorageBinsBalance.Products
	|				AND ProductsTable.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|				AND ProductsTable.Purpose = GoodsInStorageBinsBalance.Purpose
	|				AND (CASE
	|					WHEN ProductsTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|						THEN TRUE
	|					ELSE ProductsTable.Series = GoodsInStorageBinsBalance.Series
	|				END)
	|				AND (GoodsInStorageBinsBalance.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|					OR ISNULL(&QueryTextPackagingFactor, 0) <= ProductsTable.Count)
	|	WHERE
	|		ISNULL(GoodsInStorageBinsBalance.PackageType, UNDEFINED) <> VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|	
	|	GROUP BY
	|		ProductsTable.Characteristic,
	|		ProductsTable.DateOfShipment,
	|		ProductsTable.Priority,
	|		ProductsTable.Products,
	|		ProductsTable.Purpose,
	|		ProductsTable.Series,
	|		ProductsTable.ReferenceOrder,
	|		ProductsTable.Count,
	|		GoodsInStorageBinsBalance.Package,
	|		ISNULL(GoodsInStorageBinsBalance.InAcceptance, 0)) AS InternalTable
	|
	|ORDER BY
	|	BEGINOFPERIOD(InternalTable.DateOfShipment, DAY),
	|	InternalTable.Priority,
	|	InternalTable.DateOfShipment,
	|	InternalTable.ReferenceOrder,
	|	InternalTable.Products,
	|	InternalTable.Characteristic,
	|	InternalTable.Purpose,
	|	InternalTable.Series,
	|	InternalTable.QuantityPerPackage DESC
	|TOTALS BY
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series";
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"GoodsInStorageBinsBalance.Package", Undefined));
	
	Query.Text = QueryText;
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",Premise);
	
	SamplingByOrders = Query.Execute().Select(QueryResultIteration.ByGroups);
	
	While SamplingByOrders.Next() Do
		
		SelectionByProductType_ =  SamplingByOrders.Select(QueryResultIteration.ByGroups); 
		
		FilterStructure1 = New Structure("Products,Package,Purpose,Characteristic,Series");
		
		While SelectionByProductType_.Next() Do
			
			SelectionByCharacteristics = SelectionByProductType_.Select(QueryResultIteration.ByGroups);
			
			While SelectionByCharacteristics.Next() Do
				
				SelectionByAppointment = SelectionByCharacteristics.Select(QueryResultIteration.ByGroups);
				
				While SelectionByAppointment.Next() Do
					
					SelectionBySeries = SelectionByAppointment.Select(QueryResultIteration.ByGroups);
					
					While SelectionBySeries.Next() Do 
						
						Selection = SelectionBySeries.Select(QueryResultIteration.ByGroups);
						
						QuantityToBeSelected = Undefined;
						TakenFrom = "Location";
						
						While Selection.Next() Do
							
							If QuantityToBeSelected = Undefined Then
								
								QuantityToBeSelected = Selection.Count;
								
							EndIf;
							
							If Selection.AvailableStock > 0
								Or Selection.Expected_ > 0
								Or Selection.InAcceptance > 0 Then
								
								FillPropertyValues(FilterStructure1, Selection);
								
								ArrayOfFoundStrings = FlowTableFromCells.FindRows(FilterStructure1);
								
								If ArrayOfFoundStrings.Count() = 0 Then
									ExpenseLine 						= FlowTableFromCells.Add();
									FillPropertyValues(ExpenseLine, Selection);
								Else
									ExpenseLine = ArrayOfFoundStrings[0];
								EndIf;
								
								If ExpenseLine.AvailableStock > 0 Then 
									
									If ValueIsFilled(Selection.Package) Then
										QuantityAtDisposal = Min(Int(QuantityToBeSelected/Selection.QuantityPerPackage),ExpenseLine.AvailableStock);
									Else
										QuantityAtDisposal = Min(QuantityToBeSelected/Selection.QuantityPerPackage,ExpenseLine.AvailableStock);
									EndIf;
									
									If QuantityAtDisposal > 0 Then
										ExpenseLine.AvailableStock = ExpenseLine.AvailableStock - QuantityAtDisposal; 
										QuantityToBeSelected = QuantityToBeSelected - QuantityAtDisposal * Selection.QuantityPerPackage;
									EndIf;
									
								EndIf;
								
								If Selection.Expected_ > 0
									And QuantityToBeSelected > 0 Then
									
									If ValueIsFilled(Selection.Package) Then
										QuantityAtDisposal = Min(Int(QuantityToBeSelected/Selection.QuantityPerPackage),ExpenseLine.Expected_);
									Else
										QuantityAtDisposal = Min(QuantityToBeSelected/Selection.QuantityPerPackage,ExpenseLine.Expected_);
									EndIf;
									
									If QuantityAtDisposal > 0 Then
										ExpenseLine.Expected_ = ExpenseLine.Expected_ - QuantityAtDisposal; 
										QuantityToBeSelected = QuantityToBeSelected - QuantityAtDisposal * Selection.QuantityPerPackage;
										
										TakenFrom = "Expected";
									EndIf;
								EndIf;
								
								If Selection.InAcceptance > 0
									And QuantityToBeSelected > 0 Then
									
									If ValueIsFilled(Selection.Package) Then
										QuantityAtDisposal = Min(Int(QuantityToBeSelected/Selection.QuantityPerPackage),ExpenseLine.InAcceptance);
									Else
										QuantityAtDisposal = Min(QuantityToBeSelected/Selection.QuantityPerPackage,ExpenseLine.InAcceptance);
									EndIf;
									
									If QuantityAtDisposal > 0 Then
										ExpenseLine.InAcceptance = ExpenseLine.InAcceptance - QuantityAtDisposal; 
										QuantityToBeSelected = QuantityToBeSelected - QuantityAtDisposal * Selection.QuantityPerPackage;
										
										TakenFrom = "Receiving";
									EndIf;
								EndIf;
								
							EndIf;
							
							If QuantityToBeSelected = 0 Then
								StatusBar = StateTable.Add();
								FillPropertyValues(StatusBar, SelectionBySeries);
								If TakenFrom = "Location" Then
									StatusBar.State = 3;
								ElsIf TakenFrom = "Expected" Then
									StatusBar.State = 4;
								ElsIf TakenFrom = "Receiving" Then
									StatusBar.State = 5;
								EndIf;
								
								Break;
								
							EndIf;
							
						EndDo;
						
						If QuantityToBeSelected <> 0 Then
							
							StatusBar = StateTable.Add();
							FillPropertyValues(StatusBar, SelectionBySeries);
							StatusBar.State = 6;				
							
						EndIf;	
						
					EndDo;
					
				EndDo;
				
			EndDo;
			
		EndDo;
		
	EndDo;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	StateTable.Products AS Products,
	|	StateTable.ReferenceOrder AS ReferenceOrder,
	|	StateTable.Characteristic AS Characteristic,
	|	StateTable.Purpose AS Purpose,
	|	StateTable.Series AS Series,
	|	StateTable.State AS State
	|INTO StatesOfGoodsForSelection
	|FROM
	|	&StateTable AS StateTable";
	
	Query.SetParameter("StateTable", StateTable);
	Query.Execute();
	
EndProcedure

#EndRegion

#Region Recharge

Function GenerateTableOfPackagingNeeds(Warehouse, Premise, TempTablesManager, TaskGenerationParameters)
	
	// Formation of Goods for Placement.  Max(Prognostication,prognostication of history)
	// Selection of Goods for unpacking (Reduction of the need for packages for which there are no rules for placement in Areas and
	// an attempt to unpack them and an increase in the need for smaller packages).
	QueryText = "";
	If Not TaskGenerationParameters.Property("BySelectionOrders") Then
		QueryText = 
		"SELECT
		|	ForecastsAssociation.Products AS Products,
		|	ForecastsAssociation.Characteristic AS Characteristic,
		|	ForecastsAssociation.Purpose AS Purpose,
		|	ForecastsAssociation.Series AS Series,
		|	ForecastsAssociation.Package AS Package,
		|	MAX(ForecastsAssociation.NumberOfPackages) AS NumberOfPackages,
		|	MAX(ForecastsAssociation.Count) AS Count
		|INTO ReadyToRechargeForRequest
		|FROM
		|	(SELECT
		|		PackingByOrder.Products AS Products,
		|		PackingByOrder.Characteristic AS Characteristic,
		|		PackingByOrder.Purpose AS Purpose,
		|		PackingByOrder.Series AS Series,
		|		PackingByOrder.NumberOfPackages AS NumberOfPackages,
		|		PackingByOrder.Count AS Count,
		|		PackingByOrder.Package AS Package
		|	FROM
		|		PackingByOrder AS PackingByOrder
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		PackageConsumptionForecasts.Products,
		|		PackageConsumptionForecasts.Characteristic,
		|		VALUE(Catalog.Assignments.EmptyRef),
		|		PackageConsumptionForecasts.Series,
		|		CASE
		|			WHEN PackageConsumptionForecasts.AssignedByUser
		|				THEN PackageConsumptionForecasts.StandardStockLevel
		|			WHEN PackageConsumptionForecasts.ShipmentProbabilityWithinDay >= SettingsOfBinLocationWarehouses.MinimumProbabilityOfShipment
		|				THEN CASE
		|						WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.XClass)
		|							THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassXPackages.Order, 0) * 0.2
		|						WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.YClass)
		|							THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassYPackages.Order, 0) * 0.2
		|						WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.ZClass)
		|							THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassZPackages.Order, 0) * 0.2
		|						ELSE 0
		|					END
		|			ELSE 0
		|		END,
		|		CASE
		|			WHEN PackageConsumptionForecasts.AssignedByUser
		|				THEN PackageConsumptionForecasts.StandardStockLevel
		|			WHEN PackageConsumptionForecasts.ShipmentProbabilityWithinDay >= SettingsOfBinLocationWarehouses.MinimumProbabilityOfShipment
		|				THEN CASE
		|						WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.XClass)
		|							THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassXPackages.Order, 0) * 0.2
		|						WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.YClass)
		|							THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassYPackages.Order, 0) * 0.2
		|						WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.ZClass)
		|							THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassZPackages.Order, 0) * 0.2
		|						ELSE 0
		|					END
		|			ELSE 0
		|		END * &QueryTextPackagingFactor1,
		|		PackageConsumptionForecasts.Package
		|	FROM
		|		InformationRegister.PackageConsumptionForecasts AS PackageConsumptionForecasts
		|			INNER JOIN InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOfBinLocationWarehouses
		|			ON PackageConsumptionForecasts.Warehouse = SettingsOfBinLocationWarehouses.Warehouse
		|				AND PackageConsumptionForecasts.Premise = SettingsOfBinLocationWarehouses.Premise
		|	WHERE
		|		PackageConsumptionForecasts.Warehouse = &Warehouse
		|		AND PackageConsumptionForecasts.Premise = &Premise
		|		AND CASE
		|				WHEN PackageConsumptionForecasts.AssignedByUser
		|					THEN PackageConsumptionForecasts.StandardStockLevel
		|				WHEN PackageConsumptionForecasts.ShipmentProbabilityWithinDay >= SettingsOfBinLocationWarehouses.MinimumProbabilityOfShipment
		|					THEN CASE
		|							WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.XClass)
		|								THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassXPackages.Order, 0) * 0.2
		|							WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.YClass)
		|								THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassXPackages.Order, 0) * 0.2
		|							WHEN PackageConsumptionForecasts.Class = VALUE(Enum.XYZClassification.ZClass)
		|								THEN PackageConsumptionForecasts.AverageDailyConsumption + PackageConsumptionForecasts.RootMeanSquareVariance * ISNULL(SettingsOfBinLocationWarehouses.ServiceLevelOfClassXPackages.Order, 0) * 0.2
		|							ELSE 0
		|						END
		|				ELSE 0
		|			END > 0) AS ForecastsAssociation
		|
		|GROUP BY
		|	ForecastsAssociation.Series,
		|	ForecastsAssociation.Products,
		|	ForecastsAssociation.Purpose,
		|	ForecastsAssociation.Package,
		|	ForecastsAssociation.Characteristic
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|"
	EndIf;
	
	QueryText = QueryText +
	"SELECT DISTINCT
	|	ReadyToRechargeForRequest.Products,
	|	ReadyToRechargeForRequest.Products.WarehouseGroup AS WarehouseGroupOfProducts,
	|	ReadyToRechargeForRequest.Characteristic,
	|	ReadyToRechargeForRequest.Series,
	|	ReadyToRechargeForRequest.Purpose,
	|	ReadyToRechargeForRequest.Package AS RequiredPackaging_,
	|	ISNULL(ReadyToRechargeForRequest.Package.WarehouseGroup,
	|		VALUE(Catalog.WarehousePackageGroups.EmptyRef)) AS WarehouseGroupOfRequiredPackaging,
	|	ISNULL(&QueryTextPackagingFactor2, 1) AS ZoomRatio,
	|	ReadyToRechargeForRequest.Count,
	|	ReadyToRechargeForRequest.NumberOfPackages,
	|	ISNULL(RepackagingOptions.Package, VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS
	|		SmallerPackaging,
	|	CASE
	|		WHEN RepackagingOptions.Package IS NULL
	|			THEN 0
	|		ELSE ISNULL(&QueryTextPackagingFactor3, 1)
	|	END AS ShallowPackingRatio,
	|	CASE
	|		WHEN RepackagingOptions.Package IS NULL
	|			THEN VALUE(Catalog.WarehousePackageGroups.EmptyRef)
	|		ELSE RepackagingOptions.Package.WarehouseGroup
	|	END AS SmallPackingWarehouseGroup,
	|	ISNULL(RepackagingOptions.Count, 0) AS ConversionFactorToFinePackaging
	|INTO PackagingForRechargeWithUnpackingOptions
	|FROM
	|	ReadyToRechargeForRequest AS ReadyToRechargeForRequest
	|		LEFT JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|		ON ReadyToRechargeForRequest.Package = RepackagingOptions.Source
	|		AND (ReadyToRechargeForRequest.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	PackagingForRechargeWithUnpackingOptions.Products,
	|	PackagingForRechargeWithUnpackingOptions.Characteristic,
	|	PackagingForRechargeWithUnpackingOptions.Series,
	|	PackagingForRechargeWithUnpackingOptions.Purpose,
	|	PackagingForRechargeWithUnpackingOptions.RequiredPackaging_,
	|	CASE
	|		WHEN RulesForPlacingRequiredPackaging.StorageArea IS NULL
	|			THEN CASE
	|				WHEN RulesForPlacingSmallerPackages.StorageArea IS NULL
	|					THEN NULL
	|				ELSE PackagingForRechargeWithUnpackingOptions.SmallerPackaging
	|			END
	|		ELSE PackagingForRechargeWithUnpackingOptions.RequiredPackaging_
	|	END AS PackingToRecharge,
	|	CASE
	|		WHEN RulesForPlacingRequiredPackaging.StorageArea IS NULL
	|			THEN CASE
	|				WHEN RulesForPlacingSmallerPackages.StorageArea IS NULL
	|					THEN 0
	|				ELSE PackagingForRechargeWithUnpackingOptions.NumberOfPackages *
	|					PackagingForRechargeWithUnpackingOptions.ConversionFactorToFinePackaging
	|			END
	|		ELSE PackagingForRechargeWithUnpackingOptions.NumberOfPackages
	|	END AS NumberOfPackagesToRecharge,
	|	CASE
	|		WHEN RulesForPlacingRequiredPackaging.StorageArea IS NULL
	|			THEN CASE
	|				WHEN RulesForPlacingSmallerPackages.StorageArea IS NULL
	|					THEN NULL
	|				ELSE PackagingForRechargeWithUnpackingOptions.ShallowPackingRatio
	|			END
	|		ELSE PackagingForRechargeWithUnpackingOptions.ZoomRatio
	|	END AS Priority
	|INTO RankingOfUnpackingOptions
	|FROM
	|	PackagingForRechargeWithUnpackingOptions AS PackagingForRechargeWithUnpackingOptions
	|		LEFT JOIN InformationRegister.GoodsPlacementRules AS RulesForPlacingRequiredPackaging
	|		ON PackagingForRechargeWithUnpackingOptions.WarehouseGroupOfProducts = RulesForPlacingRequiredPackaging.WarehouseGroupOfProducts
	|		AND
	|			PackagingForRechargeWithUnpackingOptions.WarehouseGroupOfRequiredPackaging = RulesForPlacingRequiredPackaging.WarehouseGroupOfPackages
	|		AND (RulesForPlacingRequiredPackaging.Warehouse = &Warehouse)
	|		AND (RulesForPlacingRequiredPackaging.Premise = &Premise)
	|		LEFT JOIN InformationRegister.GoodsPlacementRules AS RulesForPlacingSmallerPackages
	|		ON PackagingForRechargeWithUnpackingOptions.WarehouseGroupOfProducts = RulesForPlacingSmallerPackages.WarehouseGroupOfProducts
	|		AND
	|			PackagingForRechargeWithUnpackingOptions.SmallPackingWarehouseGroup = RulesForPlacingSmallerPackages.WarehouseGroupOfPackages
	|		AND (RulesForPlacingSmallerPackages.Warehouse = &Warehouse)
	|		AND (RulesForPlacingSmallerPackages.Premise = &Premise)
	|WHERE
	|	NOT CASE
	|		WHEN RulesForPlacingRequiredPackaging.StorageArea IS NULL
	|			THEN CASE
	|				WHEN RulesForPlacingSmallerPackages.StorageArea IS NULL
	|					THEN NULL
	|				ELSE PackagingForRechargeWithUnpackingOptions.SmallerPackaging
	|			END
	|		ELSE PackagingForRechargeWithUnpackingOptions.RequiredPackaging_
	|	END IS NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RankingOfUnpackingOptions.Products,
	|	RankingOfUnpackingOptions.Characteristic,
	|	RankingOfUnpackingOptions.Series,
	|	RankingOfUnpackingOptions.Purpose,
	|	RankingOfUnpackingOptions.RequiredPackaging_,
	|	MAX(RankingOfUnpackingOptions.Priority) AS Priority
	|INTO MaximumRepackagingRank
	|FROM
	|	RankingOfUnpackingOptions AS RankingOfUnpackingOptions
	|GROUP BY
	|	RankingOfUnpackingOptions.Products,
	|	RankingOfUnpackingOptions.Characteristic,
	|	RankingOfUnpackingOptions.Series,
	|	RankingOfUnpackingOptions.Purpose,
	|	RankingOfUnpackingOptions.RequiredPackaging_
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RankingOfUnpackingOptions.Products,
	|	RankingOfUnpackingOptions.Characteristic,
	|	RankingOfUnpackingOptions.Series,
	|	RankingOfUnpackingOptions.Purpose,
	|	RankingOfUnpackingOptions.PackingToRecharge AS Package,
	|	SUM(RankingOfUnpackingOptions.NumberOfPackagesToRecharge) AS NumberOfPackages
	|INTO PreparationForRecharge
	|FROM
	|	RankingOfUnpackingOptions AS RankingOfUnpackingOptions
	|		INNER JOIN MaximumRepackagingRank AS MaximumRepackagingRank
	|		ON RankingOfUnpackingOptions.Products = MaximumRepackagingRank.Products
	|		AND RankingOfUnpackingOptions.Characteristic = MaximumRepackagingRank.Characteristic
	|		AND RankingOfUnpackingOptions.Series = MaximumRepackagingRank.Series
	|		AND RankingOfUnpackingOptions.Purpose = MaximumRepackagingRank.Purpose
	|		AND RankingOfUnpackingOptions.RequiredPackaging_ = MaximumRepackagingRank.RequiredPackaging_
	|		AND RankingOfUnpackingOptions.Priority = MaximumRepackagingRank.Priority
	|GROUP BY
	|	RankingOfUnpackingOptions.Products,
	|	RankingOfUnpackingOptions.PackingToRecharge,
	|	RankingOfUnpackingOptions.Characteristic,
	|	RankingOfUnpackingOptions.Series,
	|	RankingOfUnpackingOptions.Purpose
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	RepackagingOptions.Package,
	|	RepackagingOptions.Source,
	|	PreparationForRecharge.Products,
	|	PreparationForRecharge.Characteristic,
	|	PreparationForRecharge.Series,
	|	PreparationForRecharge.Purpose,
	|	PreparationForRecharge.NumberOfPackages
	|INTO SourcesOfPackagesToRecharge
	|FROM
	|	PreparationForRecharge AS PreparationForRecharge
	|		INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|		ON PreparationForRecharge.Package = RepackagingOptions.Package
	|WHERE
	|	RepackagingOptions.Source <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|
	|UNION ALL
	|
	|SELECT
	|	PreparationForRecharge.Package,
	|	PreparationForRecharge.Package,
	|	PreparationForRecharge.Products,
	|	PreparationForRecharge.Characteristic,
	|	PreparationForRecharge.Series,
	|	PreparationForRecharge.Purpose,
	|	PreparationForRecharge.NumberOfPackages
	|FROM
	|	PreparationForRecharge AS PreparationForRecharge
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	SourcesOfPackagesToRecharge.Products,
	|	SourcesOfPackagesToRecharge.Characteristic,
	|	SourcesOfPackagesToRecharge.Series,
	|	SourcesOfPackagesToRecharge.Purpose
	|INTO GoodsToRecharge
	|FROM
	|	SourcesOfPackagesToRecharge AS SourcesOfPackagesToRecharge
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	StorageBins.Ref
	|INTO NotBlockedBins
	|FROM
	|	Catalog.StorageBins AS StorageBins
	|		LEFT JOIN InformationRegister.StorageBinsLocks AS StorageBinsLocks
	|		ON StorageBins.Ref = StorageBinsLocks.Cell
	|		AND (StorageBinsLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Full)
	|		OR StorageBinsLocks.LockType = VALUE(Enum.TypesOfWarehouseBinLocks.Filter))
	|WHERE
	|	(StorageBins.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
	|	OR StorageBins.StorageBinType = VALUE(Enum.TypesOfStorageCells.Archive))
	|	AND StorageBinsLocks.Cell IS NULL
	|	AND StorageBins.Owner = &Warehouse
	|	AND StorageBins.Premise = &Premise
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsToRecharge.Products,
	|	GoodsToRecharge.Characteristic,
	|	GoodsToRecharge.Series,
	|	GoodsToRecharge.Purpose,
	|	GoodsInStorageBinsBalance.Package,
	|	ISNULL(&QueryTextPackagingFactor4, 1) AS QuantityPerPackage,
	|	ISNULL(GoodsInStorageBinsBalance.Package.WarehouseGroup,
	|		VALUE(Catalog.WarehouseGroupsOfItems.EmptyRef)) AS WarehouseGroupOfPackages,
	|	SUM(GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance) AS Balance,
	|	SUM(GoodsInStorageBinsBalance.ForPlacementBalance) AS Expected_,
	|	GoodsInStorageBinsBalance.Cell,
	|	GoodsInStorageBinsBalance.Cell.AvailabilityLevel AS AvailabilityLevel,
	|	GoodsInStorageBinsBalance.Cell.TabIndex AS TabIndex,
	|	GoodsInStorageBinsBalance.Cell.WarehouseZone AS WarehouseZone,
	|	GoodsInStorageBinsBalance.Cell.Code AS Code,
	|	GoodsInStorageBinsBalance.Cell.StorageArea AS StorageArea,
	|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromSingleProductBins AS
	|		PriorityOfPickingFromSingleProductBins,
	|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
	|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
	|	&QueryTextPackageWeight1 AS Weight,
	|	&QueryTextPackageVolume1 AS VolumeM3
	|INTO ResiduesInCells
	|FROM
	|	GoodsToRecharge AS GoodsToRecharge
	|		INNER JOIN AccumulationRegister.GoodsInStorageBins.Balance(, Cell IN
	|			(SELECT
	|				NotBlockedBins.Ref AS Cell
	|			FROM
	|				NotBlockedBins AS NotBlockedBins)
	|		AND (Products, Characteristic) IN
	|			(SELECT
	|				GoodsToRecharge.Products,
	|				GoodsToRecharge.Characteristic
	|			FROM
	|				GoodsToRecharge AS GoodsToRecharge)) AS GoodsInStorageBinsBalance
	|		ON GoodsToRecharge.Products = GoodsInStorageBinsBalance.Products
	|		AND GoodsToRecharge.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|		AND GoodsToRecharge.Purpose = GoodsInStorageBinsBalance.Purpose
	|		AND (CASE
	|			WHEN GoodsToRecharge.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|				THEN TRUE
	|			ELSE GoodsToRecharge.Series = GoodsInStorageBinsBalance.Series
	|		END)
	|GROUP BY
	|	GoodsToRecharge.Products,
	|	GoodsToRecharge.Characteristic,
	|	GoodsToRecharge.Purpose,
	|	GoodsToRecharge.Series,
	|	GoodsInStorageBinsBalance.Package,
	|	GoodsInStorageBinsBalance.Cell,
	|	GoodsInStorageBinsBalance.Cell.AvailabilityLevel,
	|	GoodsInStorageBinsBalance.Cell.TabIndex,
	|	GoodsInStorageBinsBalance.Cell.Code,
	|	GoodsInStorageBinsBalance.Cell.StorageArea,
	|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromSingleProductBins,
	|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingFromMixedStorageBins,
	|	GoodsInStorageBinsBalance.Cell.StorageArea.PriorityOfPickingAgainstRemainingStock,
	|	ISNULL(GoodsInStorageBinsBalance.Package.WarehouseGroup,
	|		VALUE(Catalog.WarehouseGroupsOfItems.EmptyRef)),
	|	GoodsInStorageBinsBalance.Cell.WarehouseZone,
	|	&QueryTextPackageWeight1,
	|	&QueryTextPackageVolume1,
	|	ISNULL(&QueryTextPackagingFactor4, 1)
	|HAVING
	|	(SUM(GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance) > 0
	|	OR SUM(GoodsInStorageBinsBalance.ForPlacementBalance) > 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	SUM(ResiduesInCells.Balance) AS Balance,
	|	SUM(ResiduesInCells.Expected_) AS Expected_,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.QuantityPerPackage,
	|	ResiduesInCells.Weight,
	|	ResiduesInCells.VolumeM3
	|INTO LeftoverPackages
	|FROM
	|	ResiduesInCells AS ResiduesInCells
	|GROUP BY
	|	ResiduesInCells.Products,
	|	ResiduesInCells.Characteristic,
	|	ResiduesInCells.Package,
	|	ResiduesInCells.Series,
	|	ResiduesInCells.Purpose,
	|	ResiduesInCells.QuantityPerPackage,
	|	ResiduesInCells.Weight,
	|	ResiduesInCells.VolumeM3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	SourcesOfPackagesToRecharge.Package,
	|	SourcesOfPackagesToRecharge.Products,
	|	SourcesOfPackagesToRecharge.Characteristic,
	|	SourcesOfPackagesToRecharge.Series,
	|	SourcesOfPackagesToRecharge.Purpose,
	|	SourcesOfPackagesToRecharge.NumberOfPackages
	|INTO PackagesForRechargeThatHaveSomethingToTake
	|FROM
	|	SourcesOfPackagesToRecharge AS SourcesOfPackagesToRecharge
	|		INNER JOIN LeftoverPackages AS PackageResiduesOfOriginalPackages
	|		ON SourcesOfPackagesToRecharge.Products = PackageResiduesOfOriginalPackages.Products
	|		AND SourcesOfPackagesToRecharge.Characteristic = PackageResiduesOfOriginalPackages.Characteristic
	|		AND SourcesOfPackagesToRecharge.Series = PackageResiduesOfOriginalPackages.Series
	|		AND SourcesOfPackagesToRecharge.Purpose = PackageResiduesOfOriginalPackages.Purpose
	|		AND SourcesOfPackagesToRecharge.Source = PackageResiduesOfOriginalPackages.Package
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PackagesForRechargeThatHaveSomethingToTake.Package,
	|	ISNULL(&QueryTextPackagingFactor5, 1) AS ZoomRatio,
	|	PackagesForRechargeThatHaveSomethingToTake.Products,
	|	PackagesForRechargeThatHaveSomethingToTake.Characteristic,
	|	PackagesForRechargeThatHaveSomethingToTake.Series,
	|	PackagesForRechargeThatHaveSomethingToTake.Purpose,
	|	CASE
	|		WHEN PackagesForRechargeThatHaveSomethingToTake.Package <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|			THEN CAST(PackagesForRechargeThatHaveSomethingToTake.NumberOfPackages - ISNULL(LeftoverPackages.Balance, 0) -
	|				ISNULL(LeftoverPackages.Expected_, 0) AS NUMBER(15, 0))
	|		ELSE PackagesForRechargeThatHaveSomethingToTake.NumberOfPackages - ISNULL(LeftoverPackages.Balance, 0) -
	|			ISNULL(LeftoverPackages.Expected_, 0)
	|	END AS Count,
	|	&QueryTextPackageWeight2 AS Weight,
	|	&QueryTextPackageVolume2 AS VolumeM3
	|INTO NeedForPackagingUnitsAllPackagingunits
	|FROM
	|	PackagesForRechargeThatHaveSomethingToTake AS PackagesForRechargeThatHaveSomethingToTake
	|		LEFT JOIN LeftoverPackages AS LeftoverPackages
	|		ON PackagesForRechargeThatHaveSomethingToTake.Package = LeftoverPackages.Package
	|		AND PackagesForRechargeThatHaveSomethingToTake.Products = LeftoverPackages.Products
	|		AND PackagesForRechargeThatHaveSomethingToTake.Characteristic = LeftoverPackages.Characteristic
	|		AND PackagesForRechargeThatHaveSomethingToTake.Series = LeftoverPackages.Series
	|		AND PackagesForRechargeThatHaveSomethingToTake.Purpose = LeftoverPackages.Purpose
	|WHERE
	|	PackagesForRechargeThatHaveSomethingToTake.NumberOfPackages - ISNULL(LeftoverPackages.Balance, 0) -
	|		ISNULL(LeftoverPackages.Expected_, 0) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Package AS Package,
	|	ZoomRatio AS ZoomRatio,
	|	Products AS Products,
	|	Characteristic AS Characteristic,
	|	Series AS Series,
	|	Purpose AS Purpose,
	|	Count AS Count,
	|	Weight AS Weight,
	|	VolumeM3 AS VolumeM3
	|INTO NeedForPackaging
	|FROM
	|	NeedForPackagingUnitsAllPackagingunits AS NeedForPackagingUnitsAllPackagingunits
	|WHERE
	|	(Products, Characteristic, Series, Purpose, ZoomRatio, Package) IN
	|		(SELECT
	|			Products,
	|			Characteristic,
	|			Series,
	|			Purpose,
	|			ZoomRatio,
	|			MAX(Package) AS Package
	|		FROM
	|			NeedForPackagingUnitsAllPackagingunits
	|		GROUP BY
	|			Products,
	|			Characteristic,
	|			Series,
	|			Purpose,
	|			ZoomRatio)";
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor1",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"PackageConsumptionForecasts.Package", Undefined));
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor2",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"ReadyToRechargeForRequest.Package", Undefined));
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor3",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"RepackagingOptions.Package", Undefined));
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor4",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"GoodsInStorageBinsBalance.Package", Undefined));
	
	QueryText = StrReplace(QueryText,
		"&QueryTextPackagingFactor5",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"PackagesForRechargeThatHaveSomethingToTake.Package", Undefined));
		
	QueryText = StrReplace(
		QueryText, 
		"&QueryTextPackageWeight1", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
		
	QueryText = StrReplace(
		QueryText, 
		"&QueryTextPackageVolume1", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("GoodsInStorageBinsBalance.Package", "GoodsInStorageBinsBalance.Products", False));
		
	QueryText = StrReplace(
		QueryText, 
		"&QueryTextPackageWeight2", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight("PackagesForRechargeThatHaveSomethingToTake.Package", "PackagesForRechargeThatHaveSomethingToTake.Products", False));
		
	QueryText = StrReplace(
		QueryText, 
		"&QueryTextPackageVolume2", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume("PackagesForRechargeThatHaveSomethingToTake.Package", "PackagesForRechargeThatHaveSomethingToTake.Products", False));

	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text = QueryText;

	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",Premise);
	
	QueryResults = Query.ExecuteBatch();
	
	Return QueryResults[QueryResults.UBound()].Unload()[0].Count > 0;
	
EndFunction

// Constructor function
// 
// Returns:
// 	ValueTable - LongDesc:
// * Products - CatalogRef.Products -
// * Characteristic - CatalogRef.ItemsCharacteristics -
// * Series - CatalogRef.ItemsBatches -
// * Purpose - CatalogRef.Assignments -
// * Package - CatalogRef.PackagesAndUnitsOfMeasure -
// * ZoomRatio - Number -
// * Count - Number -
// * NumberOfPackages - Number -
// * PackageWeight - Number -
// * PackageVolume - Number -
// * Cell - CatalogRef.StorageBins -
// * Code - String -
// * WarehouseZone - CatalogRef.WarehouseZones -
// * TabIndex - Number -
// * SelectionRowIndex - Number -
// * WithSurpluses - Boolean -
// * KeyToCommunicatingWithTare - Number -
//
Function NewSelectionTable()
	
	NumberType15_3 = TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative);
	
	Result = New ValueTable;
	Result.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	Result.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	Result.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	Result.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	Result.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	Result.Columns.Add("ZoomRatio", NumberType15_3);
	Result.Columns.Add("Count", NumberType15_3);
	Result.Columns.Add("NumberOfPackages", NumberType15_3);
	Result.Columns.Add("PackageWeight", NumberType15_3);
	Result.Columns.Add("PackageVolume", New TypeDescription("Number",,,New NumberQualifiers(18,6,AllowedSign.Nonnegative)));
	Result.Columns.Add("Cell",New TypeDescription ("CatalogRef.StorageBins"));
	Result.Columns.Add("Code", New TypeDescription("String",,New StringQualifiers(20)));
	Result.Columns.Add("WarehouseZone", New TypeDescription("CatalogRef.WarehouseZones"));
	Result.Columns.Add("TabIndex", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	Result.Columns.Add("SelectionRowIndex", NumberType15_3);
	Result.Columns.Add("WithSurpluses", New TypeDescription("Boolean"));
	Result.Columns.Add("KeyToCommunicatingWithTare", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));

	Return Result;
	
EndFunction

// LongDesc
// 
// Parameters:
// 	Warehouse - CatalogRef.Warehouses - LongDesc
// 	Premise - CatalogRef.Warerooms - LongDesc
// 	TempTableManager - TempTablesManager - LongDesc
// Returns:
// 	Structure, Undefined - LongDesc:
// * PlacementTable - ValueTable -
Function CreateTablesForTasks(Warehouse, Premise, TempTableManager)
	
	NumberType15_3 = TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative);
	
	PlacementTablePreliminary = New ValueTable;
	PlacementTablePreliminary.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	PlacementTablePreliminary.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	PlacementTablePreliminary.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	PlacementTablePreliminary.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	PlacementTablePreliminary.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	PlacementTablePreliminary.Columns.Add("ZoomRatio", NumberType15_3);
	PlacementTablePreliminary.Columns.Add("Count", NumberType15_3);
	PlacementTablePreliminary.Columns.Add("SelectionRowIndex", NumberType15_3);
	PlacementTablePreliminary.Columns.Add("Surplus", New TypeDescription("Boolean"));
	PlacementTablePreliminary.Columns.Add("WithSurpluses", New TypeDescription("Boolean"));
	PlacementTablePreliminary.Columns.Add("Quantity_Received", NumberType15_3);
	PlacementTablePreliminary.Columns.Add("PackageWeight", NumberType15_3);
	PlacementTablePreliminary.Columns.Add("PackageVolume", New TypeDescription("Number",,,New NumberQualifiers(18,6,AllowedSign.Nonnegative)));
	PlacementTablePreliminary.Columns.Add("Placed", New TypeDescription("Boolean"));
	
	FilterTable = NewSelectionTable();
	SelectionRowIndex = 0;
	
	// We limit the packages from which we satisfy the need in order to achieve minimal surpluses from unpacked packages.	
	Query = New Query;
	Query.TempTablesManager = TempTableManager;
	Query.Text =
	"SELECT DISTINCT
	|	NeedForPackaging.Products AS Products,
	|	NeedForPackaging.Characteristic AS Characteristic,
	|	NeedForPackaging.Series AS Series,
	|	NeedForPackaging.Purpose AS Purpose,
	|	RepackagingOptions.MaximumPackageInABranch AS MaximumPackageInABranch,
	|	NeedForPackaging.Package AS Package,
	|	NeedForPackaging.ZoomRatio AS ZoomRatio,
	|	NeedForPackaging.Count AS NumberOfPackages,
	|	NeedForPackaging.Weight AS PackageWeight,
	|	NeedForPackaging.VolumeM3 AS PackageVolume,
	|	NeedForPackaging.Count * NeedForPackaging.ZoomRatio AS Count
	|INTO RequiredProductsByBranch
	|FROM
	|	NeedForPackaging AS NeedForPackaging
	|		INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|		ON NeedForPackaging.Package = RepackagingOptions.Package
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	LeftoverPackages.Products AS Products,
	|	LeftoverPackages.Characteristic AS Characteristic,
	|	LeftoverPackages.Series AS Series,
	|	LeftoverPackages.Purpose AS Purpose,
	|	RepackagingOptions.MaximumPackageInABranch AS MaximumPackageInABranch,
	|	LeftoverPackages.Package,
	|	LeftoverPackages.ZoomRatio AS ZoomRatio,
	|	LeftoverPackages.AvailableStock AS NumberOfPackages,
	|	LeftoverPackages.Weight AS PackageWeight,
	|	LeftoverPackages.VolumeM3 AS PackageVolume,
	|	FALSE AS Surplus,
	|	-1 AS SelectionRowIndex,
	|	&QueryTextPackagingFactor AS MaximumPackingInBranchCoefficient
	|INTO RemnantsOfPackagesOnBranches
	|FROM
	|	(SELECT
	|		LeftoverPackages.Products AS Products,
	|		LeftoverPackages.Characteristic AS Characteristic,
	|		LeftoverPackages.Series AS Series,
	|		LeftoverPackages.Purpose AS Purpose,
	|		LeftoverPackages.Package AS Package,
	|		LeftoverPackages.QuantityPerPackage AS ZoomRatio,
	|		LeftoverPackages.Balance AS AvailableStock,
	|		LeftoverPackages.Weight AS Weight,
	|		LeftoverPackages.VolumeM3 AS VolumeM3
	|	FROM
	|		NeedForPackaging AS NeedForPackaging
	|			LEFT JOIN LeftoverPackages AS LeftoverPackages
	|			ON NeedForPackaging.Products = LeftoverPackages.Products
	|				AND NeedForPackaging.Characteristic = LeftoverPackages.Characteristic
	|				AND NeedForPackaging.Series = LeftoverPackages.Series
	|				AND NeedForPackaging.Purpose = LeftoverPackages.Purpose
	|	WHERE
	|		LeftoverPackages.Balance > 0) AS LeftoverPackages
	|		INNER JOIN InformationRegister.RepackagingOptions AS RepackagingOptions
	|		ON LeftoverPackages.Package = RepackagingOptions.Package
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RemnantsOfPackagesOnBranches.MaximumPackageInABranch,
	|	MAX(RemnantsOfPackagesOnBranches.ZoomRatio) AS MaximumRemainderRatioInBranch,
	|	RemnantsOfPackagesOnBranches.MaximumPackingInBranchCoefficient,
	|	RemnantsOfPackagesOnBranches.Products,
	|	RemnantsOfPackagesOnBranches.Characteristic,
	|	RemnantsOfPackagesOnBranches.Series,
	|	RemnantsOfPackagesOnBranches.Purpose
	|INTO MaximumRemainderRatio
	|FROM
	|	RemnantsOfPackagesOnBranches AS RemnantsOfPackagesOnBranches
	|
	|GROUP BY
	|	RemnantsOfPackagesOnBranches.MaximumPackageInABranch,
	|	RemnantsOfPackagesOnBranches.MaximumPackingInBranchCoefficient,
	|	RemnantsOfPackagesOnBranches.Series,
	|	RemnantsOfPackagesOnBranches.Purpose,
	|	RemnantsOfPackagesOnBranches.Characteristic,
	|	RemnantsOfPackagesOnBranches.Products
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ISNULL(RequiredProductsByBranch.Products, VALUE(Catalog.Products.EmptyRef)) AS Products,
	|	ISNULL(RequiredProductsByBranch.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	|	ISNULL(RequiredProductsByBranch.Series, VALUE(Catalog.ItemsBatches.EmptyRef)) AS Series,
	|	ISNULL(RequiredProductsByBranch.Purpose, VALUE(Catalog.Assignments.EmptyRef)) AS Purpose,
	|	RequiredProductsByBranch.MaximumPackageInABranch,
	|	RequiredProductsByBranch.Package,
	|	ISNULL(RequiredProductsByBranch.ZoomRatio, 1) AS ZoomRatio,
	|	RequiredProductsByBranch.NumberOfPackages,
	|	RequiredProductsByBranch.PackageWeight,
	|	RequiredProductsByBranch.PackageVolume,
	|	RequiredProductsByBranch.Count,
	|	MaximumRemainderRatio.MaximumRemainderRatioInBranch AS MaximumRemainderRatioInBranch,
	|	MaximumRemainderRatio.MaximumPackingInBranchCoefficient AS MaximumPackingInBranchCoefficient
	|FROM
	|	MaximumRemainderRatio AS MaximumRemainderRatio
	|		LEFT JOIN RequiredProductsByBranch AS RequiredProductsByBranch
	|		ON MaximumRemainderRatio.MaximumPackageInABranch = RequiredProductsByBranch.MaximumPackageInABranch
	|			AND MaximumRemainderRatio.Products = RequiredProductsByBranch.Products
	|			AND MaximumRemainderRatio.Characteristic = RequiredProductsByBranch.Characteristic
	|			AND MaximumRemainderRatio.Series = RequiredProductsByBranch.Series
	|			AND MaximumRemainderRatio.Purpose = RequiredProductsByBranch.Purpose
	|
	|ORDER BY
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series,
	|	MaximumRemainderRatioInBranch DESC,
	|	MaximumPackingInBranchCoefficient DESC,
	|	ZoomRatio DESC
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	RemnantsOfPackagesOnBranches.Products AS Products,
	|	RemnantsOfPackagesOnBranches.Characteristic AS Characteristic,
	|	RemnantsOfPackagesOnBranches.Series AS Series,
	|	RemnantsOfPackagesOnBranches.Purpose AS Purpose,
	|	RemnantsOfPackagesOnBranches.MaximumPackageInABranch,
	|	RemnantsOfPackagesOnBranches.Package,
	|	RemnantsOfPackagesOnBranches.ZoomRatio AS ZoomRatio,
	|	RemnantsOfPackagesOnBranches.NumberOfPackages,
	|	RemnantsOfPackagesOnBranches.PackageWeight,
	|	RemnantsOfPackagesOnBranches.PackageVolume,
	|	RemnantsOfPackagesOnBranches.Surplus,
	|	RemnantsOfPackagesOnBranches.SelectionRowIndex,
	|	RemnantsOfPackagesOnBranches.MaximumPackingInBranchCoefficient AS MaximumPackingInBranchCoefficient
	|FROM
	|	RemnantsOfPackagesOnBranches AS RemnantsOfPackagesOnBranches
	|
	|ORDER BY
	|	Products,
	|	Characteristic,
	|	Series,
	|	Purpose,
	|	MaximumPackingInBranchCoefficient DESC,
	|	ZoomRatio DESC";

	Query.Text = StrReplace(Query.Text,
		"&QueryTextPackagingFactor",
		Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
		"RepackagingOptions.MaximumPackageInABranch", Undefined));
		
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",Premise);
	QueryResult = Query.ExecuteBatch(); 
	
	RequiredProductsByBranch = QueryResult[3].Unload();
	RequiredProductsByBranch.Indexes.Add("Products,Characteristic,Purpose,Series,Package");
	RequiredProductsByBranch.Indexes.Add("Products,Characteristic,Purpose,Series,MaximumPackageInABranch");
	RequiredProductsByBranch.Sort("Products,Characteristic,Purpose,Series,ZoomRatio Desc");
	AvailableProducts = QueryResult[4].Unload();
	
	AvailableProductsInBranch = AvailableProducts.CopyColumns();

	SelectionRowIndex = 0;
	CurMaxPackingInBranches = Undefined;
	CurrentProducts = Undefined;
	CurrentCharacteristic = Undefined;
	CurSeries_ = Undefined;
	CurAssignment = Undefined;
	
	AvailableAtLevel = New Map;
	
	For Each LineOfRequiredProducts In RequiredProductsByBranch Do 
		
		// Formation of the selected sub-branch for this branch
		If LineOfRequiredProducts.MaximumPackageInABranch <> CurMaxPackingInBranches Or
			LineOfRequiredProducts.Products <> CurrentProducts Or
			LineOfRequiredProducts.Characteristic <> CurrentCharacteristic Or
			LineOfRequiredProducts.Series <> CurSeries_ Or
			LineOfRequiredProducts.Purpose <> CurAssignment Then 
			
			// Adjusting balances
			For Each RowOfAvailableProductsInBranch In AvailableProductsInBranch Do 
				Filter = New Structure();
				Filter.Insert("Products",RowOfAvailableProductsInBranch.Products);
				Filter.Insert("Characteristic",RowOfAvailableProductsInBranch.Characteristic);
				Filter.Insert("Series",RowOfAvailableProductsInBranch.Series);
				Filter.Insert("Purpose",RowOfAvailableProductsInBranch.Purpose);
				Filter.Insert("Package",RowOfAvailableProductsInBranch.Package);
				Filter.Insert("SelectionRowIndex",RowOfAvailableProductsInBranch.SelectionRowIndex);
				Rows = AvailableProducts.FindRows(Filter);
				
				If Rows.Count() = 0 Then
					// Transferring surpluses to the table of Available Goods
					NewRow = AvailableProducts.Add();
					FillPropertyValues(NewRow,RowOfAvailableProductsInBranch);
					Continue;
				EndIf;
				
				For Each String In Rows Do
					If RowOfAvailableProductsInBranch.NumberOfPackages = 0 Then
						AvailableProducts.Delete(String);
						Continue;
					EndIf;
					String.NumberOfPackages = RowOfAvailableProductsInBranch.NumberOfPackages;
				EndDo;
			EndDo;
			
			CurMaxPackingInBranches = LineOfRequiredProducts.MaximumPackageInABranch;
			CurrentProducts= LineOfRequiredProducts.Products;
			CurrentCharacteristic = LineOfRequiredProducts.Characteristic;
			CurSeries_ = LineOfRequiredProducts.Series;
			CurAssignment = LineOfRequiredProducts.Purpose;
			
			AvailableProductsInBranch.Clear();
			Filter = New Structure();
			Filter.Insert("Products",CurrentProducts);
			Filter.Insert("Characteristic",CurrentCharacteristic);
			Filter.Insert("Series",CurSeries_);
			Filter.Insert("Purpose",CurAssignment);
			Filter.Insert("MaximumPackageInABranch",CurMaxPackingInBranches);
			Rows = AvailableProducts.FindRows(Filter);
			If Rows.Count() = 0 Then
				Continue;
			EndIf;
			For Each String In Rows Do
				// Checking the exclusion of moving goods of the same size (weight).
				If String.ZoomRatio > LineOfRequiredProducts.ZoomRatio
					Or LineOfRequiredProducts.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef() Then
					NewRow = AvailableProductsInBranch.Add();
					FillPropertyValues(NewRow,String);
				EndIf;
			EndDo;
			
			If AvailableProductsInBranch.Count() = 0 Then
				CurMaxPackingInBranches = Undefined;
				Continue;
			EndIf;
			
		EndIf;
		
		If LineOfRequiredProducts.Count = 0 Then
			Continue;
		EndIf;
		
		QuantityIsAvailable = 0;
		For Each LineOfAvailableProducts In  AvailableProductsInBranch Do
			If LineOfAvailableProducts.ZoomRatio > LineOfRequiredProducts.ZoomRatio
				Or LineOfRequiredProducts.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef() Then
				QuantityIsAvailable =  QuantityIsAvailable + LineOfAvailableProducts.ZoomRatio * LineOfAvailableProducts.NumberOfPackages; 
			Else 
				Break;
			EndIf;
		EndDo;
		
		For Each LineOfAvailableProducts In  AvailableProductsInBranch Do
			If LineOfAvailableProducts.ZoomRatio >= LineOfRequiredProducts.ZoomRatio
				Or LineOfRequiredProducts.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef() Then
				QuantityIsAvailableByHierarchyBelow = QuantityIsAvailable - LineOfAvailableProducts.ZoomRatio*LineOfAvailableProducts.NumberOfPackages;
				QuantityIsAvailable = QuantityIsAvailableByHierarchyBelow;
				
				// Selection and placement (no excess)
				NumberOfPackagesPicked = Int(LineOfRequiredProducts.Count/LineOfAvailableProducts.ZoomRatio);
				
				If LineOfRequiredProducts.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef() Then
					NumberOfPackagesPicked =?(NumberOfPackagesPicked - LineOfRequiredProducts.Count/LineOfAvailableProducts.ZoomRatio < 0,
												  NumberOfPackagesPicked + 1,
												  0); 
				EndIf;
				
				If NumberOfPackagesPicked>0 Then 
					
					If NumberOfPackagesPicked>=LineOfAvailableProducts.NumberOfPackages Then
						NumberOfPackagesPicked = LineOfAvailableProducts.NumberOfPackages;
						LineOfAvailableProducts.NumberOfPackages = 0;
					Else
						LineOfAvailableProducts.NumberOfPackages = LineOfAvailableProducts.NumberOfPackages - NumberOfPackagesPicked;	
					EndIf;
					
					// Reducing the required amount
					LineOfRequiredProducts.Count = LineOfRequiredProducts.Count - NumberOfPackagesPicked*LineOfAvailableProducts.ZoomRatio;
					If LineOfRequiredProducts.Count < 0 Then
						LineOfRequiredProducts.Count = 0;
					EndIf;
					
					LineOfRequiredProducts.NumberOfPackages = LineOfRequiredProducts.Count/LineOfRequiredProducts.ZoomRatio;
					
					// Adding packages for placement 
					NewRow = PlacementTablePreliminary.Add();
					FillPropertyValues(NewRow,LineOfRequiredProducts);
					NewRow.Count = NumberOfPackagesPicked*LineOfAvailableProducts.ZoomRatio/LineOfRequiredProducts.ZoomRatio;
					NewRow.Surplus = False;
					NewRow.WithSurpluses = LineOfAvailableProducts.Surplus;
					If LineOfAvailableProducts.Surplus Then
						NewRow.SelectionRowIndex = LineOfAvailableProducts.SelectionRowIndex;
					Else
						NewRow.SelectionRowIndex = SelectionRowIndex;
					EndIf;
					
					// Adding packages for selection
					If Not LineOfAvailableProducts.Surplus Then
						NewRow = FilterTable.Add();
						FillPropertyValues(NewRow,LineOfAvailableProducts);
						NewRow.NumberOfPackages = NumberOfPackagesPicked;
						NewRow.Count = NumberOfPackagesPicked*LineOfAvailableProducts.ZoomRatio;	
						NewRow.WithSurpluses = LineOfAvailableProducts.Surplus;
						NewRow.SelectionRowIndex = SelectionRowIndex;
						NewRow.KeyToCommunicatingWithTare = FilterTable.Count();
						SelectionRowIndex = SelectionRowIndex + 1;
					EndIf;
					
					// Checking the demand satisfaction of all packages
					If LineOfRequiredProducts.Count=0 Then
						Break;
					EndIf;
					
				EndIf;
				
				If QuantityIsAvailableByHierarchyBelow <LineOfRequiredProducts.Count And LineOfAvailableProducts.NumberOfPackages > 0 Then
					// Adding packages for placement 
					NewRow = PlacementTablePreliminary.Add();
					FillPropertyValues(NewRow,LineOfRequiredProducts);
					NewRow.Count = LineOfRequiredProducts.NumberOfPackages;
					NewRow.Surplus = False;
					NewRow.WithSurpluses = True;
					If LineOfAvailableProducts.Surplus Then
						NewRow.SelectionRowIndex = LineOfAvailableProducts.SelectionRowIndex;
					Else
						NewRow.SelectionRowIndex = SelectionRowIndex;
					EndIf;
					
					// Adding surpluses to the Available products (if they are not used, then they will all fall into the placement).
					NewRow = AvailableProductsInBranch.Add();
					FillPropertyValues(NewRow,LineOfRequiredProducts);
					NewRow.SelectionRowIndex = SelectionRowIndex;
					NewRow.NumberOfPackages = LineOfAvailableProducts.ZoomRatio/LineOfRequiredProducts.ZoomRatio - LineOfRequiredProducts.NumberOfPackages;	
					NewRow.Surplus = True;
					If LineOfAvailableProducts.Surplus Then
						NewRow.SelectionRowIndex = LineOfAvailableProducts.SelectionRowIndex;
					Else
						NewRow.SelectionRowIndex = SelectionRowIndex;
					EndIf;
					
					AvailableProductsInBranch.Sort("ZoomRatio Desc, Surplus Desc");
					
					// Adding packages for selection
					If Not LineOfAvailableProducts.Surplus Then	
						NewRow = FilterTable.Add();
						FillPropertyValues(NewRow,LineOfAvailableProducts);
						NewRow.NumberOfPackages = 1;
						NewRow.Count = LineOfAvailableProducts.ZoomRatio;
						NewRow.WithSurpluses = True;
						NewRow.SelectionRowIndex = SelectionRowIndex;
						NewRow.KeyToCommunicatingWithTare = FilterTable.Count();
						SelectionRowIndex = SelectionRowIndex + 1;
					EndIf;
					
					// Reducing the need for packages
					LineOfRequiredProducts.Count = 0;
					LineOfRequiredProducts.NumberOfPackages = 0;
					
					// Reducing the number of available packages
					LineOfAvailableProducts.NumberOfPackages = LineOfAvailableProducts.NumberOfPackages - 1;
					
					Break;
				EndIf;
				
			EndIf;
		EndDo;
		
		// Reducing the need
		Filter = New Structure();
		Filter.Insert("Products",LineOfRequiredProducts.Products);
		Filter.Insert("Characteristic",LineOfRequiredProducts.Characteristic);
		Filter.Insert("Purpose",LineOfRequiredProducts.Purpose);
		Filter.Insert("Series",LineOfRequiredProducts.Series);
		Filter.Insert("Package",LineOfRequiredProducts.Package);
		Rows = RequiredProductsByBranch.FindRows(Filter);
		For Each String In Rows Do
			String.Count = LineOfRequiredProducts.Count;
			String.NumberOfPackages = LineOfRequiredProducts.NumberOfPackages;
		EndDo;
		
	EndDo;
	
	// Transfer of unselected surpluses to the placement table
	Filter = New Structure();
	Filter.Insert("Surplus",True);
	Rows = AvailableProducts.FindRows(Filter);
	For Each String In Rows Do
		If String.NumberOfPackages>0 Then  
			// Adding packages for placement 
			NewRow = PlacementTablePreliminary.Add();
			FillPropertyValues(NewRow,String);
			NewRow.Count = String.NumberOfPackages;
			NewRow.Surplus = True;
			NewRow.WithSurpluses = True;
		EndIf;
	EndDo;
	Rows = AvailableProductsInBranch.FindRows(Filter);
	For Each String In Rows Do
		If String.NumberOfPackages>0 Then
			// Adding packages for placement
			NewRow = PlacementTablePreliminary.Add();
			FillPropertyValues(NewRow,String);
			NewRow.Count = String.NumberOfPackages;
			NewRow.Surplus = True;
			NewRow.WithSurpluses = True;
		EndIf;
	EndDo;
	
	// Selection of cells from which you can take the necessary packages
	ResultsTable = SelectCellsForSelectionTable(Warehouse, Premise, FilterTable, TempTableManager);

	// Linking the rows of the placement table based on the results of the selection of source cells
	// , because one row of the selection table can be selected from several cells.
	
	PlacementTablePreliminary.Sort("WithSurpluses Asc, ZoomRatio Desc");
	FilterTable.Indexes.Add("Products,Characteristic,Purpose,Series,Package,Cell");
	For Each ResultTableRow In ResultsTable Do
		
		Filter = New Structure();
		Filter.Insert("Products",ResultTableRow.Products);
		Filter.Insert("Characteristic",ResultTableRow.Characteristic);
		Filter.Insert("Purpose",ResultTableRow.Purpose);
		Filter.Insert("Series",ResultTableRow.Series);
		Filter.Insert("Package",ResultTableRow.Package);
		Filter.Insert("Cell",Catalogs.StorageBins.EmptyRef());
		FilterRows = FilterTable.FindRows(Filter); 
		For Each FIlterRow In FilterRows Do
			NumberOfPackages = Min(FIlterRow.NumberOfPackages,ResultTableRow.NumberOfPackages);
			ResultTableRow.NumberOfPackages = ResultTableRow.NumberOfPackages - NumberOfPackages;
			
			If NumberOfPackages >= FIlterRow.NumberOfPackages Then
				FIlterRow.Cell = ResultTableRow.Cell;
				FIlterRow.Code = ResultTableRow.Code;
				FIlterRow.TabIndex = ResultTableRow.TabIndex;
				FIlterRow.WarehouseZone = ResultTableRow.WarehouseZone;
				FIlterRow.PackageWeight = ResultTableRow.PackageWeight;
				FIlterRow.PackageVolume = ResultTableRow.PackageVolume;
				
				If ResultTableRow.NumberOfPackages = 0 Then
					Break;
				EndIf;
			Else
				
				If NumberOfPackages = 0 Then
					If ResultTableRow.NumberOfPackages = 0 Then
						Break;
					Else
						Continue;
					EndIf;
				EndIf;
				
				FIlterRow.NumberOfPackages = FIlterRow.NumberOfPackages - NumberOfPackages;
				FIlterRow.Count = FIlterRow.Count - NumberOfPackages*FIlterRow.ZoomRatio;
				
				NewRow = FilterTable.Add();
				FillPropertyValues(NewRow,FIlterRow);
				NewRow.NumberOfPackages = NumberOfPackages;
				NewRow.Count = NumberOfPackages*FIlterRow.ZoomRatio ;
				NewRow.SelectionRowIndex = SelectionRowIndex;
				NewRow.Cell = ResultTableRow.Cell;
				NewRow.Code = ResultTableRow.Code;
				NewRow.TabIndex = ResultTableRow.TabIndex;
				NewRow.WarehouseZone = ResultTableRow.WarehouseZone;
				NewRow.PackageWeight = ResultTableRow.PackageWeight;
				NewRow.PackageVolume = ResultTableRow.PackageVolume;
				NewRow.KeyToCommunicatingWithTare = FilterTable.Count();
				
				Count = NewRow.Count;
				Filter = New Structure();
				Filter.Insert("SelectionRowIndex",FIlterRow.SelectionRowIndex);
				PlacementLines = PlacementTablePreliminary.FindRows(Filter);
				For Each AssignmentRow2 In PlacementLines Do
					NumberOfPackages = Min(AssignmentRow2.Count,Count/AssignmentRow2.ZoomRatio);
					Count = Count - NumberOfPackages*AssignmentRow2.ZoomRatio;
					If NumberOfPackages >= AssignmentRow2.Count Then
						AssignmentRow2.SelectionRowIndex = SelectionRowIndex;
					Else
						AssignmentRow2.Count = AssignmentRow2.Count - NumberOfPackages;
						
						NewRow = PlacementTablePreliminary.Add();
						FillPropertyValues(NewRow,AssignmentRow2);
						NewRow.Count = NumberOfPackages;
						NewRow.SelectionRowIndex = SelectionRowIndex;
					EndIf;
					
					If Count = 0 Then
						Break;
					EndIf;
					
				EndDo;
				
				SelectionRowIndex = SelectionRowIndex + 1;
			EndIf;
			
		EndDo;
		
	EndDo;
	
	// Selection of cells in which you can put the required packages
	For Each RowOfPlacementTable In PlacementTablePreliminary Do
		RowOfPlacementTable.Placed = False;
		Filter = New Structure("SelectionRowIndex",RowOfPlacementTable.SelectionRowIndex);
		FIlterRow = FilterTable.Find(RowOfPlacementTable.SelectionRowIndex,"SelectionRowIndex");
		RowOfPlacementTable.Quantity_Received = FIlterRow.NumberOfPackages;		
	EndDo;
	
	Structure = SelectCellsToPlace(PlacementTablePreliminary,FilterTable,Warehouse,Premise);
	
	Return Structure;
	
EndFunction

Function SelectCellsForSelectionTable(Warehouse, Premise, FilterTable, TemporaryTableManager_)
	
	NumberType15_3 = TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative);
	
	ResultsTable = New ValueTable;
	ResultsTable.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	ResultsTable.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	ResultsTable.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	ResultsTable.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	ResultsTable.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	ResultsTable.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));
	ResultsTable.Columns.Add("NumberOfPackages", NumberType15_3);
	ResultsTable.Columns.Add("Count", NumberType15_3);
	ResultsTable.Columns.Add("PackageWeight", NumberType15_3);
	ResultsTable.Columns.Add("PackageVolume", New TypeDescription("Number",,,New NumberQualifiers(18,6,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("TabIndex", New TypeDescription("Number",,,New NumberQualifiers(6,0,AllowedSign.Nonnegative)));
	ResultsTable.Columns.Add("WarehouseZone", New TypeDescription(New TypeDescription("CatalogRef.WarehouseZones")));
	ResultsTable.Columns.Add("Code", New TypeDescription("String,",,New StringQualifiers(20)));
	ResultsTable.Columns.Add("SelectionRowIndex", NumberType15_3);
	
	FlowTableFromCells = New ValueTable;
	FlowTableFromCells.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	FlowTableFromCells.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	FlowTableFromCells.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	FlowTableFromCells.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	FlowTableFromCells.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	FlowTableFromCells.Columns.Add("Cell", New TypeDescription("CatalogRef.StorageBins"));
	FlowTableFromCells.Columns.Add("NumberOfPackages", NumberType15_3);
	
	FlowTableFromCells.Indexes.Add("Cell,Products,Package,Characteristic,Purpose,Series");
	
	Query = New Query;
	Query.TempTablesManager = TemporaryTableManager_;
	// In the query, all cells for which there are residues are selected and the cells are sorted according to the rules.
	QueryText =
	"SELECT
	|	CAST(FilterTable.Products AS Catalog.Products) AS Products,
	|	FilterTable.Characteristic AS Characteristic,
	|	FilterTable.Series AS Series,
	|	FilterTable.Purpose AS Purpose,
	|	FilterTable.Package AS Package,
	|	FilterTable.NumberOfPackages AS Count,
	|	FilterTable.SelectionRowIndex AS SelectionRowIndex
	|INTO FilterTable
	|FROM
	|	&FilterTable AS FilterTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	FilterTable.Products,
	|	FilterTable.Characteristic,
	|	FilterTable.Series,
	|	FilterTable.Purpose,
	|	FilterTable.Package,
	|	SUM(FilterTable.Count) AS Count,
	|	FilterTable.Products.WarehouseGroup AS WarehouseGroupOfProducts,
	|	FilterTable.SelectionRowIndex
	|INTO ProductsTable
	|FROM
	|	FilterTable AS FilterTable
	|
	|GROUP BY
	|	FilterTable.Package,
	|	FilterTable.Characteristic,
	|	FilterTable.Products,
	|	FilterTable.Series,
	|	FilterTable.Purpose,
	|	FilterTable.Products.WarehouseGroup,
	|	FilterTable.SelectionRowIndex
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	ProductsTable.Products AS Products,
	|	ProductsTable.Characteristic AS Characteristic,
	|	ProductsTable.Series AS Series,
	|	ProductsTable.Purpose AS Purpose,
	|	ProductsTable.Count AS Count,
	|	ProductsTable.WarehouseGroupOfProducts AS WarehouseGroupOfProducts,
	|	ProductsTable.SelectionRowIndex,
	|	GoodsInStorageBinsBalance.Cell AS Cell,
	|	GoodsInStorageBinsBalance.Code AS Code,
	|	ISNULL(GoodsInStorageBinsBalance.Balance, 0) AS AvailableStock,
	|	ISNULL(GoodsInStorageBinsBalance.AvailabilityLevel, 9999999999) AS AvailabilityLevel,
	|	GoodsInStorageBinsBalance.WarehouseZone AS WarehouseZone,
	|	GoodsInStorageBinsBalance.TabIndex AS TabIndex,
	|	GoodsInStorageBinsBalance.Package AS Package,
	|	GoodsInStorageBinsBalance.Weight AS Weight,
	|	GoodsInStorageBinsBalance.VolumeM3 AS VolumeM3,
	|	GoodsInStorageBinsBalance.QuantityPerPackage AS QuantityPerPackage,
	|	GoodsInStorageBinsBalance.WarehouseGroupOfPackages AS WarehouseGroupOfPackages,
	|	GoodsInStorageBinsBalance.PriorityOfPickingFromSingleProductBins AS PriorityOfPickingFromSingleProductBins,
	|	GoodsInStorageBinsBalance.PriorityOfPickingFromMixedStorageBins AS PriorityOfPickingFromMixedStorageBins,
	|	GoodsInStorageBinsBalance.PriorityOfPickingAgainstRemainingStock AS PriorityOfPickingAgainstRemainingStock,
	|	GoodsInStorageBinsBalance.StorageArea AS StorageArea
	|INTO CellPool
	|FROM
	|	ProductsTable AS ProductsTable
	|		LEFT JOIN ResiduesInCells AS GoodsInStorageBinsBalance
	|		ON ProductsTable.Products = GoodsInStorageBinsBalance.Products
	|			AND ProductsTable.Characteristic = GoodsInStorageBinsBalance.Characteristic
	|			AND ProductsTable.Purpose = GoodsInStorageBinsBalance.Purpose
	|			AND (CASE
	|				WHEN ProductsTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|					THEN TRUE
	|				ELSE ProductsTable.Series = GoodsInStorageBinsBalance.Series
	|			END)
	|			AND (GoodsInStorageBinsBalance.Package = ProductsTable.Package)
	|			AND (GoodsInStorageBinsBalance.Balance > 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsInStorageBinsBalance.Products AS Products,
	|	GoodsInStorageBinsBalance.Cell AS Cell
	|INTO AllProductsInCell
	|FROM
	|	AccumulationRegister.GoodsInStorageBins.Balance(
	|			,
	|			Cell IN
	|				(SELECT DISTINCT
	|					CellPool.Cell
	|				FROM
	|					CellPool AS CellPool)) AS GoodsInStorageBinsBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CellPool.Products AS Products,
	|	CellPool.Cell AS Cell,
	|	MIN(CASE
	|			WHEN CellPool.Products = AllProductsInCell.Products
	|				THEN TRUE
	|			ELSE FALSE
	|		END) AS ThereIsAnotherProduct
	|INTO Products_In_Cells
	|FROM
	|	CellPool AS CellPool
	|		INNER JOIN AllProductsInCell AS AllProductsInCell
	|		ON CellPool.Cell = AllProductsInCell.Cell
	|
	|GROUP BY
	|	CellPool.Products,
	|	CellPool.Cell
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	CellPool.Products AS Products,
	|	CellPool.Characteristic AS Characteristic,
	|	CellPool.Series AS Series,
	|	CellPool.Purpose AS Purpose,
	|	CellPool.Count AS Count,
	|	CellPool.Cell AS Cell,
	|	CellPool.SelectionRowIndex,
	|	CellPool.AvailableStock AS AvailableStock,
	|	CellPool.WarehouseZone AS WarehouseZone,
	|	CellPool.TabIndex AS TabIndex,
	|	CellPool.Package AS Package,
	|	CellPool.QuantityPerPackage AS QuantityPerPackage,
	|	CASE
	|		WHEN CellPool.AvailableStock <= CellPool.Count / CellPool.QuantityPerPackage
	|			THEN CellPool.PriorityOfPickingAgainstRemainingStock
	|		ELSE CASE
	|				WHEN NOT Products_In_Cells.ThereIsAnotherProduct
	|					THEN CellPool.PriorityOfPickingFromSingleProductBins
	|				ELSE CellPool.PriorityOfPickingFromMixedStorageBins
	|			END
	|	END AS StrategyPriority,
	|	CASE
	|		WHEN GoodsPlacementRules.StorageArea IS NULL 
	|			THEN 1000
	|		ELSE GoodsPlacementRules.Priority
	|	END AS AreaPriority,
	|	CellPool.AvailabilityLevel,
	|	CellPool.Code,
	|	CellPool.Weight,
	|	CellPool.VolumeM3
	|INTO ProductsInCellsTotal
	|FROM
	|	CellPool AS CellPool
	|		LEFT JOIN Products_In_Cells AS Products_In_Cells
	|		ON CellPool.Products = Products_In_Cells.Products
	|			AND CellPool.Cell = Products_In_Cells.Cell
	|		LEFT JOIN InformationRegister.GoodsPlacementRules AS GoodsPlacementRules
	|		ON CellPool.WarehouseGroupOfProducts = GoodsPlacementRules.WarehouseGroupOfProducts
	|			AND CellPool.WarehouseGroupOfPackages = GoodsPlacementRules.WarehouseGroupOfPackages
	|			AND CellPool.StorageArea = GoodsPlacementRules.StorageArea
	|			AND (GoodsPlacementRules.Premise = &Premise)
	|			AND (GoodsPlacementRules.Warehouse = &Warehouse)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductsInCellsTotal.Products AS Products,
	|	ProductsInCellsTotal.Characteristic AS Characteristic,
	|	ProductsInCellsTotal.Series AS Series,
	|	ProductsInCellsTotal.Purpose AS Purpose,
	|	ProductsInCellsTotal.Count,
	|	ProductsInCellsTotal.Cell,
	|	ProductsInCellsTotal.SelectionRowIndex,
	|	ProductsInCellsTotal.AvailableStock,
	|	ProductsInCellsTotal.WarehouseZone AS WarehouseZone,
	|	ProductsInCellsTotal.TabIndex AS TabIndex,
	|	ProductsInCellsTotal.Package AS Package,
	|	ProductsInCellsTotal.QuantityPerPackage AS QuantityPerPackage,
	|	ProductsInCellsTotal.StrategyPriority AS StrategyPriority,
	|	ProductsInCellsTotal.AreaPriority AS AreaPriority,
	|	ProductsInCellsTotal.AvailabilityLevel,
	|	ProductsInCellsTotal.Code AS Code,
	|	ProductsInCellsTotal.Weight,
	|	ProductsInCellsTotal.VolumeM3,
	|	ISNULL(BinRecountStates.State, VALUE(Enum.BinRecountStates.EmptyRef)) AS RecalculationStatus
	|FROM
	|	ProductsInCellsTotal AS ProductsInCellsTotal
	|		LEFT JOIN InformationRegister.BinRecountStates AS BinRecountStates
	|		ON ProductsInCellsTotal.Cell = BinRecountStates.Cell
	|			AND (BinRecountStates.State = VALUE(Enum.BinRecountStates.RecountIsRequired))
	|
	|ORDER BY
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series,
	|	RecalculationStatus,
	|	AreaPriority DESC,
	|	QuantityPerPackage DESC,
	|	StrategyPriority,
	|	AvailabilityLevel,
	|	TabIndex,
	|	WarehouseZone,
	|	Code
	|TOTALS BY
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series AS Series,
	|	SelectionRowIndex,
	|	Package";
	
	Query.Text = QueryText;
	
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",Premise);
	Query.SetParameter("FilterTable",FilterTable);  
	
	SelectionByProductType_ =  Query.Execute().Select(QueryResultIteration.ByGroups); 
	
	While SelectionByProductType_.Next() Do
		
		SelectionByCharacteristics = SelectionByProductType_.Select(QueryResultIteration.ByGroups);
		
		While SelectionByCharacteristics.Next() Do
			
			SelectionByAppointment = SelectionByCharacteristics.Select(QueryResultIteration.ByGroups);
			
			While SelectionByAppointment.Next() Do
				
				SelectionBySeries = SelectionByAppointment.Select(QueryResultIteration.ByGroups);
				
				While SelectionBySeries.Next() Do 
					
					SamplingBySelectionRowIndex = SelectionBySeries.Select(QueryResultIteration.ByGroups);
					
					While SamplingBySelectionRowIndex.Next() Do
						
						SampleByPackage = SamplingBySelectionRowIndex.Select(QueryResultIteration.ByGroups);
						
						While SampleByPackage.Next() Do
							
							//Details_3
							CellSelection = SampleByPackage.Select(QueryResultIteration.ByGroups);
							
							QuantityToBeSelected = Undefined;
							
							While CellSelection.Next() Do
								
								If QuantityToBeSelected = Undefined Then
									
									QuantityToBeSelected = CellSelection.Count;
									
								EndIf;
								
								// If the cell is filled, it means that there is a remainder in the right package, 
								// otherwise the table of residues would not be connected to the table of nomenclature.
								If ValueIsFilled(CellSelection.Cell) Then
									
									Filter = New Structure;
									
									Filter.Insert("Cell", CellSelection.Cell);
									Filter.Insert("Products", CellSelection.Products);
									Filter.Insert("Package", CellSelection.Package);
									Filter.Insert("Characteristic", CellSelection.Characteristic);
									Filter.Insert("Purpose", CellSelection.Purpose);
									Filter.Insert("Series", CellSelection.Series);
									
									ArrayOfFoundStrings = FlowTableFromCells.FindRows(Filter);
									
									If ArrayOfFoundStrings.Count() = 0 Then
										ExpenseLine 						= FlowTableFromCells.Add();
										ExpenseLine.Cell 				= CellSelection.Cell;
										ExpenseLine.Products 			= CellSelection.Products;
										ExpenseLine.Package 				= CellSelection.Package;
										ExpenseLine.Characteristic 		= CellSelection.Characteristic;
										ExpenseLine.Purpose 			= CellSelection.Purpose;
										ExpenseLine.Series         		= CellSelection.Series;
										ExpenseLine.NumberOfPackages 	= CellSelection.AvailableStock;
									Else
										ExpenseLine = ArrayOfFoundStrings[0];
									EndIf;
									
									QuantityFromCell = Min(QuantityToBeSelected,ExpenseLine.NumberOfPackages);
									
									If QuantityFromCell > 0 Then
										ResultString1 = ResultsTable.Add();
										FillPropertyValues(ResultString1, CellSelection);
										ResultString1.NumberOfPackages = QuantityFromCell;
										ResultString1.Count         = QuantityFromCell * CellSelection.QuantityPerPackage;
										ResultString1.PackageVolume		= CellSelection.VolumeM3;
										ResultString1.PackageWeight		= CellSelection.Weight;
										
										ExpenseLine.NumberOfPackages = ExpenseLine.NumberOfPackages - QuantityFromCell; 
										QuantityToBeSelected = QuantityToBeSelected - QuantityFromCell;
									EndIf;
									
								EndIf;
								
								If QuantityToBeSelected = 0 Then
									
									Break;
									
								EndIf;
								
							EndDo;
						EndDo;
					EndDo;
				EndDo;
			EndDo;
			
		EndDo;
		
	EndDo;
	Return ResultsTable;
EndFunction

// Returns:
// 	Structure - Contains:
//	* PlacementTable - ValueTable - Contains:
//		** Products - CatalogRef.Products - 
//		** Package - CatalogRef.PackagesAndUnitsOfMeasure - 
//		** Cell - CatalogRef.StorageBins - 
//		** Characteristic - CatalogRef.ItemsCharacteristics - 
//		** Purpose - CatalogRef.Assignments - 
//		** Series - CatalogRef.ItemsBatches - 
//		** NumberOfPackages - Number - 
//		** Count - Number - 
//		** PackageWeight - Number - 
//		** PackageVolume - Number -
//		** TabIndex - Number - 
//		** Code - Number - 
//		** WarehouseZone - CatalogRef.WarehouseZones - 
//		** SelectionRowIndex - Number - 
//		** Surplus - Boolean - 
//		** WithSurpluses - Boolean - 
//		** Quantity_Received - Number - 
//	* FilterTable - See NewSelectionTable
// 
Function SelectCellsToPlace(PlacementTablePreliminary,FilterTable,Warehouse,Premise)

	PlacementTablePreliminary.Sort("WithSurpluses Asc,Surplus Asc,Quantity_Received Asc");	
	PlacementTablePreliminary.Indexes.Add("Placed,Products,Characteristic,Purpose,Series,Package");

	Query = New Query;
	Manager = New TempTablesManager;
	Query.TempTablesManager = Manager;
	Query.Text = 
	"SELECT
	|	CAST(PlacementTablePreliminary.Products AS Catalog.Products) AS Products,
	|	PlacementTablePreliminary.Characteristic,
	|	CAST(PlacementTablePreliminary.Series AS Catalog.ItemsBatches) AS Series,
	|	CAST(PlacementTablePreliminary.Package AS Catalog.PackagesAndUnitsOfMeasure) AS Package,
	|	CAST(PlacementTablePreliminary.Purpose AS Catalog.Assignments) AS Purpose,
	|	PlacementTablePreliminary.Count AS NumberOfPackages
	|INTO PlacementTablePreliminary
	|FROM
	|	&PlacementTablePreliminary AS PlacementTablePreliminary
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PlacementTablePreliminary.Products,
	|	PlacementTablePreliminary.Package AS Package,
	|	PlacementTablePreliminary.Characteristic AS Characteristic,
	|	PlacementTablePreliminary.Series,
	|	PlacementTablePreliminary.Purpose,
	|	SUM(CASE
	|			WHEN PlacementTablePreliminary.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.NumberOfPieces)
	|				THEN CAST(PlacementTablePreliminary.NumberOfPackages - 0.5 AS NUMBER(15, 0))
	|			ELSE PlacementTablePreliminary.NumberOfPackages
	|		END) AS NumberOfPackages
	|INTO ProductsTable
	|FROM
	|	PlacementTablePreliminary AS PlacementTablePreliminary
	|
	|GROUP BY
	|	PlacementTablePreliminary.Package,
	|	PlacementTablePreliminary.Characteristic,
	|	PlacementTablePreliminary.Series,
	|	PlacementTablePreliminary.Purpose,
	|	PlacementTablePreliminary.Products";
	
	Query.SetParameter("PlacementTablePreliminary",PlacementTablePreliminary);

	ProductsTable = Query.Execute();
	
	ReturnStructure = PlaceGoodsInCells(Manager,Warehouse,Premise,Catalogs.WarehouseZones.EmptyRef(),Catalogs.StorageBins.EmptyRef(), False);
	If ReturnStructure = Undefined Then
		Return Undefined;
	EndIf;	
	
	ResultsTable = ReturnStructure.ResultsTable;
	ErrorsTable = ReturnStructure.ErrorsTable;
	
	NumberType15_3 = TMCommonUse.DescriptionOfQuantitativeFieldType(AllowedSign.Nonnegative);
	
	PlacementTable = New ValueTable;
	PlacementTable = ResultsTable.CopyColumns();
	PlacementTable.Columns.Add("SelectionRowIndex", NumberType15_3);
	PlacementTable.Columns.Add("Surplus", New TypeDescription("Boolean"));
	PlacementTable.Columns.Add("WithSurpluses", New TypeDescription("Boolean"));
	PlacementTable.Columns.Add("Quantity_Received", NumberType15_3);
	PlacementTable.Indexes.Add("SelectionRowIndex");
	
	SelectionRowIndex = FilterTable.Count();
	
	For Each ResultString1 In ResultsTable Do
		
		Filter = New Structure;
		Filter.Insert("Products",ResultString1.Products);
		Filter.Insert("Characteristic",ResultString1.Characteristic);
		Filter.Insert("Purpose",ResultString1.Purpose);
		Filter.Insert("Series",ResultString1.Series);
		Filter.Insert("Package",ResultString1.Package);
		Filter.Insert("Placed",False);
		
		Rows = PlacementTablePreliminary.FindRows(Filter);
		NumberOfPackages = ResultString1.NumberOfPackages;

		For Each String In Rows Do
			
			If NumberOfPackages = 0 Then
				Break;
			EndIf;
			
			NumberOfReductionPackages = Min(NumberOfPackages,String.Count);
			
			String.Count = String.Count - NumberOfReductionPackages; 
			NumberOfPackages = NumberOfPackages - NumberOfReductionPackages;
			
			If String.Count>0 Then
				NewRow = PlacementTable.Add();
				FillPropertyValues(NewRow,String);
				FillPropertyValues(NewRow,ResultString1);
				NewRow.NumberOfPackages = NumberOfReductionPackages;
				NewRow.Count = NumberOfReductionPackages*String.ZoomRatio;
				NewRow.SelectionRowIndex = String.SelectionRowIndex;
				NewRow.Quantity_Received = String.Quantity_Received;
				NewRow.Surplus = String.Surplus;
				NewRow.WithSurpluses = String.WithSurpluses;
			ElsIf String.Count=0 Then	
				NewRow = PlacementTable.Add();
				FillPropertyValues(NewRow,String);
				FillPropertyValues(NewRow,ResultString1);
				NewRow.NumberOfPackages = NumberOfReductionPackages;
				NewRow.Count = NumberOfReductionPackages*String.ZoomRatio;
				NewRow.SelectionRowIndex = String.SelectionRowIndex;
				NewRow.Quantity_Received = String.Quantity_Received;
				NewRow.Surplus = String.Surplus;
				NewRow.WithSurpluses = String.WithSurpluses;
				String.Placed = True;
			EndIf;	
						
		EndDo;			
			
	EndDo; 

	// Reduction of unmarked goods in the selection, placement and query tables.

	If ErrorsTable.Count()>0 Then	
		
		PlacementTable.Sort("WithSurpluses Desc,Surplus Desc,Quantity_Received Desc");
		
		For Each RowOfNDZTable In PlacementTablePreliminary.FindRows(New Structure("Placed",False)) Do 
					
			LineTBefore = FilterTable.Find(RowOfNDZTable.SelectionRowIndex,"SelectionRowIndex");
			If LineTBefore = Undefined Then
				Continue;
			EndIf;	
			AmountOfRemainder = RowOfNDZTable.Count*RowOfNDZTable.ZoomRatio;
			NumberOfSelectionReduction = LineTBefore.Count - AmountOfRemainder;
			RemainingNumberOfPackages = Int(NumberOfSelectionReduction/LineTBefore.ZoomRatio);
			QuantityOfReduction = LineTBefore.Count - LineTBefore.ZoomRatio*RemainingNumberOfPackages;
			Diff = QuantityOfReduction-AmountOfRemainder;
			
			If RemainingNumberOfPackages = 0 Then
				For Each RowOfTablesSize In PlacementTable.FindRows(New Structure("SelectionRowIndex",RowOfNDZTable.SelectionRowIndex)) Do
					PlacementTable.Delete(RowOfTablesSize);	
				EndDo;	
				FilterTable.Delete(LineTBefore);
				Continue;
			Else
				LineTBefore.NumberOfPackages = RemainingNumberOfPackages;
				LineTBefore.Count = LineTBefore.Count - QuantityOfReduction ;
			EndIf;		
			
			PlacementTableRows = PlacementTable.FindRows(New Structure("SelectionRowIndex",RowOfNDZTable.SelectionRowIndex));
			
			For Each RowOfPlacementTable In PlacementTableRows Do
				
				ZoomRatio = RowOfPlacementTable.Count/ RowOfPlacementTable.NumberOfPackages;
				RemainingNumberOfPackages = Int((RowOfPlacementTable.Count - Diff)/ZoomRatio);
				
				If RemainingNumberOfPackages <= 0 Then
					Diff = Diff - RowOfPlacementTable.Count;
					PlacementTable.Delete(RowOfPlacementTable);									
				Else;
					RowOfPlacementTable.NumberOfPackages = RemainingNumberOfPackages;
					RowOfPlacementTable.Count = RowOfPlacementTable.Count - Diff;
					Break;
				EndIf;
					
			EndDo;
			
		EndDo;	
				
	EndIf;
	
	// Prepare the selection table for splitting by tasks
	FilterTable.Sort("TabIndex Asc,Code Asc");
	FilterTable.Indexes.Add("WarehouseZone");
	
	If FilterTable.Count()>0 Then
		Structure = New Structure;
		Structure.Insert("FilterTable", FilterTable);
		Structure.Insert("PlacementTable", PlacementTable);
		Return Structure
	Else 
		Return Undefined;
	EndIf;
			
EndFunction

Procedure SplitByTasks(Warehouse, Premise, TablesForTasks, TaskGenerationParameters)
			
	TaskPlacementTable = TablesForTasks.PlacementTable.CopyColumns();
	TaskSelectionTable = TablesForTasks.FilterTable.CopyColumns();
	
	If TaskGenerationParameters.CustomizeGenerationByWorkAreas = "GroupByWarehouseZones" Then
		                          
		RequestPlots = New Query;
		RequestPlots.Text = "SELECT
		|	WarehouseZones.Ref AS WarehouseZone,
		|	WarehouseZones.LimitByWeight,
		|	WarehouseZones.LimitationByWeight,
		|	WarehouseZones.LimitByVolume,
		|	WarehouseZones.LimitationByVolume
		|FROM
		|	Catalog.WarehouseZones AS WarehouseZones
		|WHERE
		|	WarehouseZones.Owner = &Warehouse
		|	AND WarehouseZones.Premise = &Premise";
		
		RequestPlots.SetParameter("Warehouse",Warehouse);
		RequestPlots.SetParameter("Premise",Premise);
		
		TableOfWorkPlots = RequestPlots.Execute().Unload();
		
		NewRow = TableOfWorkPlots.Add();
		NewRow.WarehouseZone = Catalogs.WarehouseZones.EmptyRef();
		NewRow.LimitByVolume = False;
		NewRow.LimitByWeight = False;	
		
	Else	
		TableOfWorkPlots = New ValueTable;
		TableOfWorkPlots.Columns.Add("WarehouseZone", New TypeDescription("CatalogRef.WarehouseZones"));
		NewRow = TableOfWorkPlots.Add();
		If TaskGenerationParameters.CustomizeGenerationByWorkAreas = "WithoutBreakdownByWarehouseZones" Then
			NewRow.WarehouseZone = Catalogs.WarehouseZones.EmptyRef();
		Else
			NewRow.WarehouseZone = TaskGenerationParameters.WarehouseZone;
		EndIf;
	EndIf;
	
	VeryLargeNumber = 9999999999;
	
	For Each WorkingSectionLine In TableOfWorkPlots Do
				
		If TaskGenerationParameters.CustomizeGenerationByWorkAreas = "GroupByWarehouseZones" Then						
			LimitVolume = ?(WorkingSectionLine.LimitByVolume, WorkingSectionLine.LimitationByVolume, VeryLargeNumber);
			LimitWeight = ?(WorkingSectionLine.LimitByWeight, WorkingSectionLine.LimitationByWeight, VeryLargeNumber);						
		Else
			LimitVolume = ?(TaskGenerationParameters.LimitByVolume, TaskGenerationParameters.LimitationByVolume, VeryLargeNumber);
			LimitWeight = ?(TaskGenerationParameters.LimitByWeight, TaskGenerationParameters.LimitationByWeight, VeryLargeNumber);						
		EndIf;
		
		If TaskGenerationParameters.CustomizeGenerationByWorkAreas <> "WithoutBreakdownByWarehouseZones" Then			
			SelectionTableRows = TablesForTasks.FilterTable.FindRows(New Structure("WarehouseZone",WorkingSectionLine.WarehouseZone));			
		Else			
			SelectionTableRows = TablesForTasks.FilterTable;		
		EndIf;
		
		Weight_Total = 0;
		TotalVolume_ = 0;
		CurWeight = 0;
		CurVolume = 0;
		
		JobObject = NewDocumentReplenishmentTask(Warehouse, Premise, TaskGenerationParameters.Performer, WorkingSectionLine.WarehouseZone);
		
		For Each SelectionTableRow In SelectionTableRows Do
			
			While SelectionTableRow.NumberOfPackages>0 Do
						
				If (SelectionTableRow.PackageWeight + Weight_Total > LimitWeight 
					Or SelectionTableRow.PackageVolume + TotalVolume_ > LimitVolume)
					And TaskSelectionTable.Count()>0  Then
					
					FillInAndCompleteRechargeTask(JobObject, TaskSelectionTable, TaskPlacementTable);
					TaskPlacementTable = TablesForTasks.PlacementTable.CopyColumns();
					TaskSelectionTable = TablesForTasks.FilterTable.CopyColumns();
					JobObject = NewDocumentReplenishmentTask(Warehouse,
																	Premise,
																	TaskGenerationParameters.Performer,
																	WorkingSectionLine.WarehouseZone);	
					Weight_Total = 0;
					TotalVolume_ = 0;
					
				EndIf;  
					
				If SelectionTableRow.PackageWeight >= LimitWeight
					Or SelectionTableRow.PackageVolume >= LimitVolume  Then
					NumberOfPackagesPerSelection = 1;
					Count = SelectionTableRow.ZoomRatio;
				Else
					AvailableWeight_ = LimitWeight - Weight_Total;
					AvailableMemorySize = LimitVolume - TotalVolume_;
					
					If SelectionTableRow.PackageWeight = 0 Then
						NumberOfPackagesPerSampleByWeight = VeryLargeNumber;
					Else
						NumberOfPackagesPerSampleByWeight = Int(AvailableWeight_/SelectionTableRow.PackageWeight);
					EndIf;
					
					If SelectionTableRow.PackageVolume = 0 Then
						NumberOfPackagesPerSampleByVolume = VeryLargeNumber;
                    Else
						NumberOfPackagesPerSampleByVolume = Int(AvailableMemorySize/SelectionTableRow.PackageVolume);
					EndIf;

					NumberOfPackagesPerSelection = Min(Min(NumberOfPackagesPerSampleByWeight,NumberOfPackagesPerSampleByVolume),
													SelectionTableRow.NumberOfPackages);
					Count = NumberOfPackagesPerSelection*SelectionTableRow.ZoomRatio;
				EndIf;	

				SelectionTableRow.NumberOfPackages = SelectionTableRow.NumberOfPackages - NumberOfPackagesPerSelection;
				SelectionTableRow.Count = SelectionTableRow.Count - Count;
				
				NewRow = TaskSelectionTable.Add();
				FillPropertyValues(NewRow,SelectionTableRow);
				NewRow.NumberOfPackages = NumberOfPackagesPerSelection;
				NewRow.Count = Count;
				
				PlacementTableRows = TablesForTasks.PlacementTable.FindRows(New Structure("SelectionRowIndex",
																						  SelectionTableRow.SelectionRowIndex)); 
				For Each RowOfPlacementTable In PlacementTableRows Do
					ZoomRatio = (RowOfPlacementTable.Count/RowOfPlacementTable.NumberOfPackages);
					If RowOfPlacementTable.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef() Then
						NumberOfPlacementPackages = Count;
					Else
						NumberOfPlacementPackages = Int(Count/ZoomRatio);
					EndIf;
					NumberOfPlacementPackages = Min(NumberOfPlacementPackages,RowOfPlacementTable.NumberOfPackages);
					
					NewRow = TaskPlacementTable.Add();
					FillPropertyValues(NewRow,RowOfPlacementTable);
					NewRow.NumberOfPackages = NumberOfPlacementPackages;
					NewRow.Count = NumberOfPlacementPackages*ZoomRatio;
					
					If NumberOfPlacementPackages = RowOfPlacementTable.NumberOfPackages Then
						TablesForTasks.PlacementTable.Delete(RowOfPlacementTable);
					Else
						RowOfPlacementTable.NumberOfPackages = RowOfPlacementTable.NumberOfPackages - NumberOfPlacementPackages;
						RowOfPlacementTable.Count = RowOfPlacementTable.Count - NumberOfPlacementPackages*ZoomRatio;
					EndIf;
					
					Count = Count - NumberOfPlacementPackages*ZoomRatio;
					
					If Count=0 Then
						Break;
					EndIf;
					
				EndDo;
				
				Weight_Total = Weight_Total + SelectionTableRow.PackageWeight * NumberOfPackagesPerSelection;
				TotalVolume_ = TotalVolume_ + SelectionTableRow.PackageVolume * NumberOfPackagesPerSelection;
								
			EndDo;
			
		EndDo;
		
		If TaskSelectionTable.Count()>0 Then
			FillInAndCompleteRechargeTask(JobObject, TaskSelectionTable, TaskPlacementTable);
			TaskSelectionTable.Clear();
			TaskPlacementTable.Clear();			
			JobObject = NewDocumentReplenishmentTask(Warehouse, Premise, TaskGenerationParameters.Performer, WorkingSectionLine.WarehouseZone);			
		EndIf;	
				
	EndDo;	
	
EndProcedure

Function NewDocumentReplenishmentTask(Warehouse, Premise, Performer, WarehouseZone)
	
	JobObject               = Documents.GoodsPickingPlacement.CreateDocument();
	JobObject.Warehouse         = Warehouse;
	JobObject.Date          = CurrentSessionDate();
	JobObject.OperationKind   = Enums.OperationKindsOfGoodsPlacementPicking.Move;
	JobObject.Premise     = Premise; 
	JobObject.Status        = Enums.StatusesOfGoodsPickingPlacement.Prepared2;
	JobObject.EmployeeResponsible = Users.CurrentUser();
	
	If Performer<>Undefined Then
		JobObject.Performer = Performer;
	EndIf;
	
	JobObject.WarehouseZone = WarehouseZone;
	
	Return JobObject;
	
EndFunction

Procedure FillInAndCompleteRechargeTask(JobObject, FilterTable, PlacementTable)
	
	// Check if the placement goes to the same cell as the selection, then the task status can be set to completed.
	PlacementAndSelectionInDifferentCells = False;
	For Each FilterRows In FilterTable Do
		Filter = New Structure();
		Filter.Insert("SelectionRowIndex",FilterRows.SelectionRowIndex);
		PlacementLines = PlacementTable.FindRows(Filter);
		For Each AssignmentRow2 In PlacementLines Do
			If AssignmentRow2.Cell <> FilterRows.Cell Then
				PlacementAndSelectionInDifferentCells = True;
			EndIf;
		EndDo;
	EndDo;
	
	If Not PlacementAndSelectionInDifferentCells Then
		JobObject.Status = Enums.StatusesOfGoodsPickingPlacement.CompletedWithoutErrors;
	EndIf;
	
	AddTareToTaskTables(JobObject.Warehouse, JobObject.Premise, PlacementTable, FilterTable);

	FilterTable.GroupBy("Products, Characteristic, Purpose, Series,Package, PackageWeight, PackageVolume, Cell,
		|WarehouseZone, TabIndex, Code","NumberOfPackages,Count");
	PlacementTable.GroupBy("Products, Characteristic, Purpose, Series, Package, PackageWeight, PackageVolume, Cell,
		|TabIndex, Code, WarehouseZone","NumberOfPackages,Count");

	PlacementTable.Sort("TabIndex Asc,Code Asc");
	FilterTable.Sort("TabIndex Asc,Code Asc");
	
	For Each String In PlacementTable Do
		NewRow = JobObject.GoodsPlacement.Add();
		FillPropertyValues(NewRow,String);
		NewRow.NumberOfPackagesPlaced = String.NumberOfPackages;
		NewRow.CountPlaced = String.Count;
	EndDo;
	
	For Each String In FilterTable Do
		NewRow = JobObject.GoodsFilter.Add();
		FillPropertyValues(NewRow,String);
		NewRow.NumberOfPackagesPicked = String.NumberOfPackages;
		NewRow.CountPicked = String.Count;
	EndDo;			
	
	SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(JobObject, Documents.GoodsPickingPlacement);
	ProductsServer.FillInStatusesForSpecifyingSeries(JobObject, SeriesSpecificationParameters.Location);
	ProductsServer.FillInStatusesForSpecifyingSeries(JobObject, SeriesSpecificationParameters.Filter);
	ErrorCheckingSeriesFilling = False;
	
	SeriesFillCheckParameters = ProductsServer.SeriesFillCheckParameters();
	SeriesFillCheckParameters.IssueMessages = False;
	
	ProductsServer.CheckSeriesCompletion(JobObject, SeriesSpecificationParameters.Location, ErrorCheckingSeriesFilling,, SeriesFillCheckParameters);
	If Not ErrorCheckingSeriesFilling Then
		ProductsServer.CheckSeriesCompletion(JobObject, SeriesSpecificationParameters.Filter, ErrorCheckingSeriesFilling,, SeriesFillCheckParameters);
	EndIf;
	If ErrorCheckingSeriesFilling Then
		JobObject.Status = Enums.StatusesOfGoodsPickingPlacement.Prepared2;
		ProductsServer.FillInStatusesForSpecifyingSeries(JobObject, SeriesSpecificationParameters.Location);
		ProductsServer.FillInStatusesForSpecifyingSeries(JobObject, SeriesSpecificationParameters.Filter);
	EndIf;

	JobObject.Write(DocumentWriteMode.Write);
	Try
		JobObject.Write(DocumentWriteMode.Posting);
	Except
		CommonClientServer.MessageToUser(NStr("vi = 'Lỗi:';
												|ru = 'Ошибка:';
												|en = 'Error:'; fa = 'Error:';
												|it = 'Errore:';
												|pl = 'Error:';
												|tr = 'Hata:'")+ErrorDescription());
	EndTry;
	
EndProcedure

Procedure CreateTableOfPackagesByCurOrders(Warehouse, Premise, TempTablesManager, TaskGenerationParameters)
	
	BySelectionOrders = TaskGenerationParameters.Property("BySelectionOrders");
	
	AllowableDeviationOfMeasuringGoodsShipmentAndReceiving = Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	If BySelectionOrders Then
		
		AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
		AdditionalParameters.TempTableName = "TTBlockedReadyForSelection";
		
		TempTableManager = New TempTablesManager;
		
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(Undefined,
			"AccumulationRegister.GoodsForPicking", "ReferenceOrder", TempTableManager, AdditionalParameters);
		
		Query = New Query;
		Query.TempTablesManager = TempTableManager;
		
		Query.Text = 
		"SELECT
		|	Goods.Ref AS Products
		|
		|INTO TTProducts_1
		|FROM
		|	Catalog.Products AS Goods
		|WHERE
		|	NOT Goods.DeletionMark
		|	AND Goods.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsIssueNote.Ref AS ReferenceOrder
		|
		|INTO TTOrders_
		|FROM
		|	Document.GoodsIssueNote AS GoodsIssueNote
		|WHERE
		|	GoodsIssueNote.Ref IN(&PickingReferences)
		|
		|UNION ALL
		|
		|SELECT
		|	GoodsTransferNote.Ref AS ReferenceOrder
		|FROM
		|	Document.GoodsTransferNote AS GoodsTransferNote
		|WHERE
		|	GoodsTransferNote.Ref IN(&PickingReferences)
		|
		|UNION ALL
		|
		|SELECT
		|	GoodsIssueNote.Ref AS ReferenceOrder
		|FROM
		|	Document.GoodsIssueNote AS GoodsIssueNote
		|WHERE
		|	GoodsIssueNote.Posted
		|	AND GoodsIssueNote.Warehouse = &Warehouse
		|	AND GoodsIssueNote.Premise = &Premise
		|	AND GoodsIssueNote.ShipmentUnderTransportationJob
		|	AND GoodsIssueNote.TransportationJob IN(&PickingReferences)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////";
		
		If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
			
			Query.Text = Query.Text + "
			|SELECT
			|	GoodsForSelectionTurnover.ReferenceOrder   AS ReferenceOrder,
			|	GoodsForSelectionTurnover.Products   AS Products,
			|	GoodsForSelectionTurnover.Characteristic AS Characteristic,
			|	GoodsForSelectionTurnover.Purpose     AS Purpose,
			|	GoodsForSelectionTurnover.Series          AS Series,
			|	GoodsForSelectionTurnover.ForPickingReceipt  AS Count
			|INTO GoodsForSelectionTurnover
			|FROM
			|	AccumulationRegister.GoodsForPicking.Turnovers(
			|			,
			|			,
			|			,
			|			ReferenceOrder IN
			|					(SELECT
			|						TTOrders_.ReferenceOrder
			|					FROM
			|						TTOrders_ AS TTOrders_)
			|			AND NOT ReferenceOrder IN
			|					(SELECT
			|						TTBlockedReadyForSelection.ReferenceOrder
			|					FROM
			|						TTBlockedReadyForSelection AS TTBlockedReadyForSelection)
			|			AND Products IN
			|					(SELECT
			|						TTProducts_1.Products
			|					FROM
			|						TTProducts_1 AS TTProducts_1)) AS GoodsForSelectionTurnover
			|
			|INDEX BY
			|	Products,
			|	Characteristic,
			|	Purpose,
			|	Series
			|;
			|
			|///////////////////////////////////////////////////////////////////";
			
		EndIf;
		
		Query.Text = Query.Text + "
		|SELECT
		|	GoodsForPickingBalance.ReferenceOrder   AS ReferenceOrder,
		|	&Warehouse                              AS Warehouse,
		|	&Premise                          AS Premise,
		|	GoodsForPickingBalance.Products   AS Products,
		|	CASE
		|		WHEN GoodsForPickingBalance.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
		|			THEN GoodsForPickingBalance.Products
		|		ELSE GoodsForPickingBalance.Products.PackagingGroup
		|	END                               AS PackageOwner_,
		|	CASE
		|		WHEN GoodsForPickingBalance.Products.UnitOfMeasure.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.NumberOfPieces)
		|			THEN FALSE
		|		ELSE TRUE
		|	END                               AS DimensionalUnitOfMeasurement,
		|	GoodsForPickingBalance.Characteristic AS Characteristic,
		|	GoodsForPickingBalance.Purpose     AS Purpose,
		|	GoodsForPickingBalance.Series          AS Series,
		|	GoodsForPickingBalance.ForPickingBalance - GoodsForPickingBalance.BeingPickedBalance - GoodsForPickingBalance.PickedBalance AS Count
		|INTO GoodsForPicking
		|FROM
		|	AccumulationRegister.GoodsForPicking.Balance(
		|			,
		|			ReferenceOrder IN
		|					(SELECT
		|						TTOrders_.ReferenceOrder
		|					FROM
		|						TTOrders_ AS TTOrders_)
		|			AND NOT ReferenceOrder IN
		|					(SELECT
		|						TTBlockedReadyForSelection.ReferenceOrder
		|					FROM
		|						TTBlockedReadyForSelection AS TTBlockedReadyForSelection)
		|			AND Products IN
		|					(SELECT
		|						TTProducts_1.Products
		|					FROM
		|						TTProducts_1 AS TTProducts_1)) AS GoodsForPickingBalance
		|WHERE &ConditionGoodsForSelection
		|
		|INDEX BY
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////";
		
		Query.Text = Query.Text + "
		|SELECT
		|	GoodsForPicking.ReferenceOrder,
		|	GoodsForPicking.Warehouse,
		|	GoodsForPicking.Premise,
		|	GoodsForPicking.Products,
		|	GoodsForPicking.DimensionalUnitOfMeasurement,
		|	GoodsForPicking.Characteristic,
		|	GoodsForPicking.Purpose,
		|	GoodsForPicking.Series,
		|	ProductPackages.Ref AS Package,
		|	ISNULL(&QueryTextPackagingFactor, 1) AS QuantityPerPackage,
		|	GoodsForPicking.Count AS Count
		|FROM
		|	GoodsForPicking AS GoodsForPicking
		|		INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		|		ON GoodsForPicking.PackageOwner_ = ProductPackages.Owner
		|WHERE
		|	NOT ProductPackages.DeletionMark
		|
		|ORDER BY
		|	GoodsForPicking.ReferenceOrder,
		|	GoodsForPicking.Warehouse,
		|	GoodsForPicking.Premise,
		|	GoodsForPicking.Products,
		|	GoodsForPicking.Characteristic,
		|	GoodsForPicking.Series,
		|	GoodsForPicking.Purpose,
		|	QuantityPerPackage DESC,
		|	Package
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTProducts_1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTOrders_
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP GoodsForPicking";
		
		Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient("ProductPackages", Undefined)
		);
		
		If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
			ConditionGoodsForSelection = "
			|		LEFT JOIN GoodsForSelectionTurnover AS GoodsForSaleTurnover
			|		ON GoodsForPickingBalance.ReferenceOrder = GoodsForSaleTurnover.ReferenceOrder
			|			AND GoodsForPickingBalance.Products = GoodsForSaleTurnover.Products
			|			AND GoodsForPickingBalance.Characteristic = GoodsForSaleTurnover.Characteristic
			|			AND GoodsForPickingBalance.Purpose = GoodsForSaleTurnover.Purpose
			|			AND GoodsForPickingBalance.Series = GoodsForSaleTurnover.Series
			|WHERE
			|	GoodsForPickingBalance.ForPickingBalance - GoodsForPickingBalance.PickedBalance - GoodsForPickingBalance.BeingPickedBalance
			|	> CASE
			|			WHEN GoodsForPickingBalance.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
			|				THEN &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * ISNULL(GoodsForSaleTurnover.Count,0)
			|			ELSE 0
			|		END";
			
			Query.Text = StrReplace(Query.Text,"WHERE &ConditionGoodsForSelection", ConditionGoodsForSelection);
			
			Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
				AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
			Query.SetParameter("DimensionalTypesOfUnits",
				Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
		Else
			ConditionGoodsForSelection = "GoodsForPickingBalance.ForPickingBalance - GoodsForPickingBalance.BeingPickedBalance
									| - GoodsForPickingBalance.PickedBalance > 0";
			
			Query.Text = StrReplace(Query.Text,"&ConditionGoodsForSelection", ConditionGoodsForSelection);
		EndIf;
		
		Query.SetParameter("PickingReferences", TaskGenerationParameters.BySelectionOrders);
	Else
		
		Query = New Query;
		
		If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
			
			Query.Text = "
			|SELECT
			|	Goods.Ref AS Products
			|
			|INTO TTProducts_1
			|FROM
			|	Catalog.Products AS Goods
			|WHERE
			|	NOT Goods.DeletionMark
			|	AND Goods.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	GoodsForShipmentTurnover.Products     AS Products,
			|	GoodsForShipmentTurnover.Characteristic   AS Characteristic,
			|	GoodsForShipmentTurnover.Purpose       AS Purpose,
			|	GoodsForShipmentTurnover.Series            AS Series,
			|	GoodsForShipmentTurnover.DocumentShipments AS DocumentShipments,
			|	GoodsForShipmentTurnover.Warehouse            AS Warehouse,
			|	GoodsForShipmentTurnover.ToShipReceipt  AS Count
			|
			|INTO GoodsForShipmentTurnover
			|FROM
			|	AccumulationRegister.GoodsForIssue.Turnovers(
			|			,
			|			,
			|			,
			|			Warehouse = &Warehouse
			|			AND Products IN
			|				(SELECT
			|					TTProducts_1.Products
			|				FROM
			|					TTProducts_1 AS TTProducts_1)) AS GoodsForShipmentTurnover
			|;
			|
			|///////////////////////////////////////////////////////////////////";
			
		EndIf;
		
		Query.Text = Query.Text + "
		|SELECT
		|	GoodsForIssueBalance.Products AS Products,
		|	GoodsForIssueBalance.Characteristic AS Characteristic,
		|	GoodsForIssueBalance.Series AS Series,
		|	GoodsForIssueBalance.DocumentShipments AS ReferenceOrder,
		|	GoodsForIssueBalance.ToShipBalance AS Count,
		|	CASE
		|		WHEN GoodsForIssueBalance.Products.PackagingGroup
		|				= VALUE(Catalog.PackagingGroups.SpecialForItem)
		|			THEN GoodsForIssueBalance.Products
		|		ELSE GoodsForIssueBalance.Products.PackagingGroup
		|	END AS PackageOwner_,
		|	CASE
		|		WHEN GoodsForIssueBalance.Products.UnitOfMeasure.MeasuredValueType
		|				= VALUE(Enum.TypesOfMeasuredValues.NumberOfPieces)
		|			THEN FALSE
		|		ELSE TRUE
		|	END AS DimensionalUnitOfMeasurement,
		|	GoodsForIssueBalance.Warehouse,
		|	&Premise AS Premise,
		|	GoodsForIssueBalance.Purpose
		|INTO GoodsToBeShippedForRequest
		|FROM
		|	AccumulationRegister.GoodsForIssue.Balance(
		|			&DateOfShipment,
		|			Warehouse = &Warehouse
		|				AND Products.ItemsType = VALUE(Enum.ItemsTypes.OwnGoods)) AS GoodsForIssueBalance
		|WHERE &ConditionGoodsForSelection
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	ProductStockBalance.Products,
		|	ProductStockBalance.Characteristic,
		|	ProductStockBalance.Warehouse,
		|	ProductStockBalance.Premise,
		|	ProductStockBalance.InStockBalance,
		|	ProductStockBalance.ToShipBalance,
		|	ProductStockBalance.Series,
		|	ProductStockBalance.Purpose
		|INTO RemnantsOfGoodsInRoom
		|FROM
		|	AccumulationRegister.ProductStock.Balance(
		|			,
		|			(Warehouse, Premise, Products, Characteristic) IN
		|				(SELECT
		|					GoodsForIssue.Warehouse,
		|					GoodsForIssue.Premise,
		|					GoodsForIssue.Products,
		|					GoodsForIssue.Characteristic
		|				FROM
		|					GoodsToBeShippedForRequest AS GoodsForIssue)) AS ProductStockBalance
		|WHERE
		|	ProductStockBalance.InStockBalance > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	GoodsForIssue.Products,
		|	GoodsForIssue.DimensionalUnitOfMeasurement,
		|	GoodsForIssue.Characteristic,
		|	RemnantsOfGoodsInRoom.Series,
		|	GoodsForIssue.ReferenceOrder,
		|	GoodsForIssue.Count,
		|	GoodsForIssue.PackageOwner_,
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Premise,
		|	GoodsForIssue.Purpose
		|INTO GoodsForIssue
		|FROM
		|	GoodsToBeShippedForRequest AS GoodsForIssue
		|		INNER JOIN RemnantsOfGoodsInRoom AS RemnantsOfGoodsInRoom
		|		ON GoodsForIssue.Products = RemnantsOfGoodsInRoom.Products
		|			AND GoodsForIssue.Characteristic = RemnantsOfGoodsInRoom.Characteristic
		|			AND GoodsForIssue.Warehouse = RemnantsOfGoodsInRoom.Warehouse
		|			AND GoodsForIssue.Premise = RemnantsOfGoodsInRoom.Premise
		|			AND (GoodsForIssue.Series = RemnantsOfGoodsInRoom.Series
		|				OR GoodsForIssue.Series = VALUE(Catalog.ItemsBatches.EmptyRef))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsForIssue.ReferenceOrder,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.DimensionalUnitOfMeasurement,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Series,
		|	GoodsForIssue.Count,
		|	ProductPackages.Ref AS Package,
		|	&QueryTextPackagingFactor AS QuantityPerPackage,
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Premise,
		|	GoodsForIssue.Purpose
		|FROM
		|	GoodsForIssue AS GoodsForIssue
		|		INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
		|		ON GoodsForIssue.PackageOwner_ = ProductPackages.Owner
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		|		ON GoodsForIssue.PackageOwner_ = PackagesAndUnitsOfMeasure.Owner
		|		AND PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|WHERE
		|	NOT ProductPackages.DeletionMark
		|	AND PackagesAndUnitsOfMeasure.Ref IS NULL
		|
		|ORDER BY
		|	GoodsForIssue.ReferenceOrder,
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Premise,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Series,
		|	GoodsForIssue.Purpose,
		|	QuantityPerPackage DESC,
		|	Package
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP GoodsToBeShippedForRequest
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP RemnantsOfGoodsInRoom
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP GoodsForIssue";
		
		Query.SetParameter("DateOfShipment", EndOfDay(CurrentSessionDate() + 86400));
		
		Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"ProductPackages", Undefined));
		
		If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
			ConditionGoodsForSelection = "
			|		INNER JOIN GoodsForShipmentTurnover AS GoodsForShipmentTurnover
			|		ON GoodsForIssueBalance.DocumentShipments = GoodsForShipmentTurnover.DocumentShipments
			|			AND GoodsForIssueBalance.Products = GoodsForShipmentTurnover.Products
			|			AND GoodsForIssueBalance.Characteristic = GoodsForShipmentTurnover.Characteristic
			|			AND GoodsForIssueBalance.Purpose = GoodsForShipmentTurnover.Purpose
			|			AND GoodsForIssueBalance.Series = GoodsForShipmentTurnover.Series
			|			AND GoodsForIssueBalance.Warehouse = GoodsForShipmentTurnover.Warehouse
			|WHERE
			|	GoodsForIssueBalance.ToShipBalance > CASE
			|			WHEN GoodsForIssueBalance.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
			|				THEN &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * GoodsForShipmentTurnover.Count
			|			ELSE 0
			|		END";
			
			Query.Text = StrReplace(Query.Text,"WHERE &ConditionGoodsForSelection", ConditionGoodsForSelection);
			Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
			Query.SetParameter("DimensionalTypesOfUnits", Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
		Else
			ConditionGoodsForSelection = "GoodsForIssueBalance.ToShipBalance > 0";
			Query.Text = StrReplace(Query.Text,"&ConditionGoodsForSelection", ConditionGoodsForSelection);
		EndIf;
		
	EndIf;	
	Query.SetParameter("Warehouse", Warehouse);
	Query.SetParameter("Premise", Premise);
			
	TableOfRequiredPackages = New ValueTable;
	TableOfRequiredPackages.Columns.Add("Count", TMCommonUse.GetDescriptionOfNumberTypes(15,3));
	TableOfRequiredPackages.Columns.Add("QuantityPerPackage", TMCommonUse.GetDescriptionOfNumberTypes(15,3));
	TableOfRequiredPackages.Columns.Add("NumberOfPackages", TMCommonUse.GetDescriptionOfNumberTypes(15,3));
	TableOfRequiredPackages.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	TableOfRequiredPackages.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	TableOfRequiredPackages.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	TableOfRequiredPackages.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	TableOfRequiredPackages.Columns.Add("Premise", New TypeDescription("CatalogRef.Warerooms"));
	TableOfRequiredPackages.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	TableOfRequiredPackages.Columns.Add("Purpose", New TypeDescription("CatalogRef.Assignments"));
	TableOfRequiredPackages.Columns.Add("Period", New TypeDescription("Date"));
	
	TechnicalOrder = Undefined;
	CurProducts = Undefined;
	CurCharacteristic = Undefined;
	CurWarehouse = Undefined;
	CurRoom = Undefined;
	CurSeries = Undefined;
	CurPeriod = Undefined;
	CurPurpose = Undefined;
	Count = 0;
	DimensionalUnitOfMeasurement = False;
	
	SampleByPackage = Query.Execute().Select();
	While SampleByPackage.Next() Do
		
		If SampleByPackage.Products <> CurProducts Or 
			SampleByPackage.ReferenceOrder <> TechnicalOrder Or
			SampleByPackage.Characteristic <> CurCharacteristic Or
			SampleByPackage.Warehouse <> CurWarehouse Or
			SampleByPackage.Premise <> CurRoom Or
			SampleByPackage.Series <> CurSeries Or
			SampleByPackage.Purpose <> CurPurpose Then
			
			If Count<>0 And DimensionalUnitOfMeasurement Then
				NewRow = TableOfRequiredPackages.Add();
				NewRow.Products = CurProducts;
				NewRow.Characteristic = CurCharacteristic;
				NewRow.Warehouse = CurWarehouse;
				NewRow.Premise = CurRoom;
				NewRow.Series = CurSeries;
				NewRow.Purpose = CurPurpose;
				
				NewRow.Count = Count;
				NewRow.NumberOfPackages = Count;
				NewRow.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef();
			EndIf;
			
			TechnicalOrder             = SampleByPackage.ReferenceOrder;
			CurProducts             = SampleByPackage.Products;
			DimensionalUnitOfMeasurement      = SampleByPackage.DimensionalUnitOfMeasurement;
			CurCharacteristic           = SampleByPackage.Characteristic;
			CurWarehouse                    = SampleByPackage.Warehouse;
			CurRoom                = SampleByPackage.Premise;
			CurSeries                    = SampleByPackage.Series;
			CurPurpose               = SampleByPackage.Purpose;
			Count = SampleByPackage.Count;
			
		EndIf;
		
		QuantityPerDocument = Int(Count / SampleByPackage.QuantityPerPackage);
		
		If QuantityPerDocument > 0 Then
			
			NewRow = TableOfRequiredPackages.Add();
			FillPropertyValues(NewRow, SampleByPackage);
			
			NewRow.Count = QuantityPerDocument * SampleByPackage.QuantityPerPackage;
			NewRow.NumberOfPackages = QuantityPerDocument;
			Count = Count - QuantityPerDocument * SampleByPackage.QuantityPerPackage;
			
		EndIf;
		
	EndDo;
	
	If Count<>0 And SampleByPackage.DimensionalUnitOfMeasurement Then
		NewRow = TableOfRequiredPackages.Add();
		FillPropertyValues(NewRow, SampleByPackage);
		NewRow.Count = Count;
		NewRow.NumberOfPackages = Count;
		NewRow.Package = Catalogs.PackagesAndUnitsOfMeasure.EmptyRef();
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	PackingByOrder.Products AS Products,
	|	PackingByOrder.Characteristic AS Characteristic,
	|	PackingByOrder.Package AS Package,
	|	PackingByOrder.Series AS Series,
	|	PackingByOrder.QuantityPerPackage AS QuantityPerPackage,
	|	PackingByOrder.Count AS Count,
	|	PackingByOrder.NumberOfPackages AS NumberOfPackages,
	|	PackingByOrder.Warehouse AS Warehouse,
	|	PackingByOrder.Premise AS Premise,
	|	PackingByOrder.Purpose AS Purpose
	|INTO ForGroupingPackagesByOrder
	|FROM
	|	&TableOfPackagesByCurOrders AS PackingByOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PackingOnOrdersForRequest.Products,
	|	PackingOnOrdersForRequest.Characteristic,
	|	PackingOnOrdersForRequest.Package,
	|	PackingOnOrdersForRequest.Series,
	|	SUM(PackingOnOrdersForRequest.Count) AS Count,
	|	SUM(PackingOnOrdersForRequest.NumberOfPackages) AS NumberOfPackages,
	|	PackingOnOrdersForRequest.Warehouse,
	|	PackingOnOrdersForRequest.Premise,
	|	PackingOnOrdersForRequest.Purpose
	|INTO PackingByOrder
	|FROM
	|	ForGroupingPackagesByOrder AS PackingOnOrdersForRequest
	|
	|GROUP BY
	|	PackingOnOrdersForRequest.Characteristic,
	|	PackingOnOrdersForRequest.Purpose,
	|	PackingOnOrdersForRequest.Package,
	|	PackingOnOrdersForRequest.QuantityPerPackage,
	|	PackingOnOrdersForRequest.Series,
	|	PackingOnOrdersForRequest.Products,
	|	PackingOnOrdersForRequest.Warehouse,
	|	PackingOnOrdersForRequest.Premise
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP ForGroupingPackagesByOrder";
	
	If BySelectionOrders Then
		Query.Text = StrReplace(Query.Text, "INTO PackingByOrder", "INTO ReadyToRechargeForRequest");
	EndIf;
	
	Query.SetParameter("TableOfPackagesByCurOrders",TableOfRequiredPackages);
	Query.Execute();
	
EndProcedure

Procedure AddTareToTaskTables(Warehouse, Premise, PlacementTable, FilterTable)
	// 1. Let's add a container to the selection table
	// 2. Then we will distribute the containers by packages in the placement table
	// 3. We will place the remaining containers according to the rules of placement.
	
	TempTablesManager = New TempTablesManager;
	TableStructureOfProductSelectionAlgorithm = TableStructureOfProductSelectionAlgorithm();
	FilterTable.Columns.Add("ReferenceOrder", New TypeDescription("String",,New StringQualifiers(1)));
	
	TableStructureOfProductSelectionAlgorithm.ResultsTable = FilterTable;
	TableStructureOfProductSelectionAlgorithm.Insert("PlacementTable",PlacementTable);
	
	SupplementSelectionTableWithMultiTurnContainer(TempTablesManager, TableStructureOfProductSelectionAlgorithm, False);
	
	AddMultiTurnContainerToPlacementTable(PlacementTable);
	
	TempTablesManager = New TempTablesManager;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	FilterTable.Products,
	|	FilterTable.Package,
	|	FilterTable.Characteristic,
	|	FilterTable.Purpose,
	|	FilterTable.Series,
	|	FilterTable.NumberOfPackages
	|INTO FilterTable
	|FROM
	|	&FilterTable AS FilterTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PlacementTable.Products,
	|	PlacementTable.Package,
	|	PlacementTable.Characteristic,
	|	PlacementTable.Purpose,
	|	PlacementTable.Series,
	|	PlacementTable.NumberOfPackages
	|INTO PlacementTable
	|FROM
	|	&PlacementTable AS PlacementTable
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NestedQuery.Products,
	|	NestedQuery.Package,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Purpose,
	|	NestedQuery.Series,
	|	SUM(NestedQuery.NumberOfPackages) AS NumberOfPackages
	|INTO ProductsTable
	|FROM
	|	(SELECT
	|		FilterTable.Products AS Products,
	|		FilterTable.Package AS Package,
	|		FilterTable.Characteristic AS Characteristic,
	|		FilterTable.Purpose AS Purpose,
	|		FilterTable.Series AS Series,
	|		FilterTable.NumberOfPackages AS NumberOfPackages
	|	FROM
	|		FilterTable AS FilterTable
	|	WHERE
	|		CAST(FilterTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		PlacementTable.Products,
	|		PlacementTable.Package,
	|		PlacementTable.Characteristic,
	|		PlacementTable.Purpose,
	|		PlacementTable.Series,
	|		-PlacementTable.NumberOfPackages
	|	FROM
	|		PlacementTable AS PlacementTable
	|	WHERE
	|		CAST(PlacementTable.Products AS Catalog.Products).ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.Products,
	|	NestedQuery.Package,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Purpose,
	|	NestedQuery.Series
	|
	|HAVING
	|	SUM(NestedQuery.NumberOfPackages) > 0";

	Query.SetParameter("FilterTable", TableStructureOfProductSelectionAlgorithm.ResultsTable);
	Query.SetParameter("PlacementTable", PlacementTable);
	
	QueryResult = Query.ExecuteBatch();
	
	If QueryResult[2].Unload()[0].Count > 0 Then
		PlacementResult = PlaceGoodsInCells(TempTablesManager, Warehouse, Premise, Catalogs.WarehouseZones.EmptyRef(), Catalogs.StorageBins.EmptyRef(), False);
		TMCommonUse.AddRowsToTable(PlacementTable,PlacementResult.ResultsTable);
	EndIf;
	
EndProcedure

Procedure PerformCalculationOfIndicatorsForForecastAndClassificationOfPackages(RechargeSettings)
	
	SetPrivilegedMode(True);
	
	ClassificationPeriod = Enums.Periodicity.Day;
	NumberOfClassificationPeriods = RechargeSettings.AnalysisDepth;
	ClassificationPeriod = Enums.Periodicity.Day;
	
	Period = TMCommonUseClientServer.ExtendedPeriod(CurrentSessionDate() + 86400, ClassificationPeriod, - NumberOfClassificationPeriods);
	
	AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
	AdditionalParameters.TempTableName = "TTBlockedReadyForSelection";
	
	// Checking blocked data
	TempTablesManager = New TempTablesManager;
	InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(Undefined,
		"AccumulationRegister.GoodsForPicking", "ReferenceOrder", TempTablesManager, AdditionalParameters);
		
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text = 
	"SELECT TOP 1
	|	TTBlockedReadyForSelection.ReferenceOrder
	|FROM
	|	AccumulationRegister.GoodsForPicking AS GoodsForPicking
	|		INNER JOIN TTBlockedReadyForSelection AS TTBlockedReadyForSelection
	|		ON GoodsForPicking.ReferenceOrder = TTBlockedReadyForSelection.ReferenceOrder
	|WHERE
	|	GoodsForPicking.ReferenceOrder.Warehouse = &Warehouse";
	Query.SetParameter("Warehouse", RechargeSettings.Warehouse);
	DataIsNotBlocked = Query.Execute().IsEmpty();
	
	If DataIsNotBlocked Then
		CreateTableOfPackagesByShipmentHistory(RechargeSettings.Warehouse, RechargeSettings.Premise, Period, TempTablesManager);
		
		PerformPerformXYZClassificationOfPackages(Period, TempTablesManager);
		
		CalculatePackageConsumptionForecastIndicators(Period, TempTablesManager);
		
		WriteForecastIndicatorsToRegister(RechargeSettings.Warehouse, RechargeSettings.Premise, TempTablesManager);
	EndIf;

EndProcedure

Procedure CreateTableOfPackagesByShipmentHistory(Warehouse, Premise, Period, TempTablesManager)
	
	Query = New Query;
	Query.Text = 
	"SELECT
	|	GoodsIssueNote.Ref AS DocumentShipments,
	|	GoodsIssueNote.Warehouse,
	|	GoodsIssueNote.Premise,
	|	GoodsIssueNote.DateOfShipment
	|INTO TableOfOrders
	|FROM
	|	Document.GoodsIssueNote AS GoodsIssueNote
	|WHERE
	|	GoodsIssueNote.DateOfShipment BETWEEN &StartDate AND &EndDate
	|	AND GoodsIssueNote.Posted
	|	AND GoodsIssueNote.Warehouse = &Warehouse
	|	AND GoodsIssueNote.Premise = &Premise
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsTransferNote.Ref,
	|	GoodsTransferNote.Warehouse,
	|	GoodsTransferNote.SenderWareroom,
	|	GoodsTransferNote.DateOfShipment
	|FROM
	|	Document.GoodsTransferNote AS GoodsTransferNote
	|WHERE
	|	GoodsTransferNote.DateOfShipment BETWEEN &StartDate AND &EndDate
	|	AND GoodsTransferNote.Posted
	|	AND GoodsTransferNote.Warehouse = &Warehouse
	|	AND GoodsTransferNote.SenderWareroom = &Premise
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForSelectionTurnover.ReferenceOrder,
	|	GoodsForSelectionTurnover.Products,
	|	GoodsForSelectionTurnover.Characteristic,
	|	GoodsForSelectionTurnover.Series,
	|	SUM(GoodsForSelectionTurnover.PickedExpense + GoodsForSelectionTurnover.ForPickingReceipt) AS Count,
	|	CASE
	|		WHEN GoodsForSelectionTurnover.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
	|			THEN GoodsForSelectionTurnover.Products
	|		ELSE GoodsForSelectionTurnover.Products.PackagingGroup
	|	END AS PackageOwner_,
	|	TableOfOrders.Warehouse,
	|	TableOfOrders.Premise,
	|	TableOfOrders.DateOfShipment
	|INTO SelectedGoodItems
	|FROM
	|	AccumulationRegister.GoodsForPicking.Turnovers(
	|			,
	|			,
	|			,
	|			ReferenceOrder IN
	|					(SELECT
	|						TableOfOrders.DocumentShipments AS ReferenceOrder
	|					FROM
	|						TableOfOrders AS TableOfOrders)
	|				AND Purpose = VALUE(Catalog.Assignments.EmptyRef)) AS GoodsForSelectionTurnover
	|		LEFT JOIN Catalog.ItemKinds.BatchAccountingPolicies AS TypesOfProductPolicyAccountingSeries
	|		ON GoodsForSelectionTurnover.Products.ProductKind = TypesOfProductPolicyAccountingSeries.Ref
	|			AND (TypesOfProductPolicyAccountingSeries.Warehouse = &Warehouse)
	|		LEFT JOIN TableOfOrders AS TableOfOrders
	|		ON GoodsForSelectionTurnover.ReferenceOrder = TableOfOrders.DocumentShipments
	|
	|GROUP BY
	|	GoodsForSelectionTurnover.ReferenceOrder,
	|	GoodsForSelectionTurnover.Products,
	|	GoodsForSelectionTurnover.Characteristic,
	|	GoodsForSelectionTurnover.Series,
	|	TableOfOrders.Warehouse,
	|	TableOfOrders.Premise,
	|	TableOfOrders.DateOfShipment,
	|	CASE
	|		WHEN GoodsForSelectionTurnover.Products.PackagingGroup = VALUE(Catalog.PackagingGroups.SpecialForItem)
	|			THEN GoodsForSelectionTurnover.Products
	|		ELSE GoodsForSelectionTurnover.Products.PackagingGroup
	|	END
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SelectedGoodItems.ReferenceOrder,
	|	SelectedGoodItems.Products,
	|	SelectedGoodItems.Characteristic,
	|	SelectedGoodItems.Series,
	|	SelectedGoodItems.Count,
	|	ProductPackages.Ref AS Package,
	|	&QueryTextPackagingFactor AS QuantityPerPackage,
	|	SelectedGoodItems.Warehouse,
	|	SelectedGoodItems.Premise,
	|	BEGINOFPERIOD(SelectedGoodItems.DateOfShipment, DAY) AS Period
	|FROM
	|	SelectedGoodItems AS SelectedGoodItems
	|		INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS ProductPackages
	|		ON SelectedGoodItems.PackageOwner_ = ProductPackages.Owner
	|
	|ORDER BY
	|	SelectedGoodItems.ReferenceOrder,
	|	SelectedGoodItems.Warehouse,
	|	SelectedGoodItems.Premise,
	|	SelectedGoodItems.Products,
	|	SelectedGoodItems.Characteristic,
	|	SelectedGoodItems.Series,
	|	QuantityPerPackage DESC,
	|	Package";
	
	Query.Text = StrReplace(Query.Text,
			"&QueryTextPackagingFactor",
			Catalogs.PackagesAndUnitsOfMeasure.RequestTextForPackingCoefficient(
			"ProductPackages", Undefined));
			
	Query.SetParameter("StartDate", Period.StartDate);
	Query.SetParameter("EndDate", EndOfDay(Period.EndDate));
	Query.SetParameter("Warehouse", Warehouse);
	Query.SetParameter("Premise", Premise);
			
	TableOfRequiredPackages = New ValueTable;
	TableOfRequiredPackages.Columns.Add("Count", TMCommonUse.GetDescriptionOfNumberTypes(15,2));
	TableOfRequiredPackages.Columns.Add("NumberOfPackages", TMCommonUse.GetDescriptionOfNumberTypes(15,2));
	TableOfRequiredPackages.Columns.Add("QuantityPerPackage", TMCommonUse.GetDescriptionOfNumberTypes(15,2));
	TableOfRequiredPackages.Columns.Add("Package", New TypeDescription("CatalogRef.PackagesAndUnitsOfMeasure"));
	TableOfRequiredPackages.Columns.Add("Products", New TypeDescription("CatalogRef.Products"));
	TableOfRequiredPackages.Columns.Add("Characteristic", New TypeDescription("CatalogRef.ItemsCharacteristics"));
	TableOfRequiredPackages.Columns.Add("Warehouse", New TypeDescription("CatalogRef.Warehouses"));
	TableOfRequiredPackages.Columns.Add("Premise", New TypeDescription("CatalogRef.Warerooms"));
	TableOfRequiredPackages.Columns.Add("Series", New TypeDescription("CatalogRef.ItemsBatches"));
	TableOfRequiredPackages.Columns.Add("Period", New TypeDescription("Date"));
	
	TechnicalOrder = Undefined;
	CurProducts = Undefined;
	CurCharacteristic = Undefined;
	CurWarehouse = Undefined;
	CurRoom = Undefined;
	CurSeries = Undefined;
	CurPeriod = Undefined;
	Count = 0;
	
	SampleByPackage = Query.Execute().Select();
	While SampleByPackage.Next() Do
		
		If SampleByPackage.Products <> CurProducts Or 
			SampleByPackage.ReferenceOrder <> TechnicalOrder Or
			SampleByPackage.Characteristic <> CurCharacteristic Or
			SampleByPackage.Warehouse <> CurWarehouse Or
			SampleByPackage.Premise <> CurRoom Or
			SampleByPackage.Period <> CurPeriod Or
			SampleByPackage.Series <> CurSeries Then
			
			TechnicalOrder             = SampleByPackage.ReferenceOrder;
			CurProducts             = SampleByPackage.Products;
			CurCharacteristic           = SampleByPackage.Characteristic;
			CurWarehouse                    = SampleByPackage.Warehouse;
			CurRoom                = SampleByPackage.Premise;
			CurSeries                    = SampleByPackage.Series;
			CurPeriod                   = SampleByPackage.Period;			
			Count = SampleByPackage.Count;
			
		EndIf;
		
		QuantityPerDocument = Int(Count / SampleByPackage.QuantityPerPackage);
		
		If QuantityPerDocument > 0 Then
			
			NewRow = TableOfRequiredPackages.Add();
			NewRow.Count = QuantityPerDocument * SampleByPackage.QuantityPerPackage;
			NewRow.NumberOfPackages = QuantityPerDocument;
			NewRow.Package = SampleByPackage.Package;
			NewRow.Products = SampleByPackage.Products;
			NewRow.Characteristic = SampleByPackage.Characteristic;
			NewRow.Warehouse = SampleByPackage.Warehouse;
			NewRow.Premise = SampleByPackage.Premise;
			NewRow.Series = SampleByPackage.Series;
			NewRow.Period = SampleByPackage.Period;
			NewRow.QuantityPerPackage = SampleByPackage.QuantityPerPackage;
			
			Count = Count - QuantityPerDocument * SampleByPackage.QuantityPerPackage;
			
		EndIf;
		
	EndDo;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text  =
	"SELECT
	|	PackingTable_.Products,
	|	PackingTable_.Characteristic,
	|	PackingTable_.Series,
	|	PackingTable_.Package,
	|	PackingTable_.NumberOfPackages,
	|	PackingTable_.QuantityPerPackage,
	|	PackingTable_.Warehouse,
	|	PackingTable_.Premise,
	|	PackingTable_.Period
	|INTO PackingTableForRequest
	|FROM
	|	&PackingTable_ AS PackingTable_
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PackingTableForRequest.Products,
	|	PackingTableForRequest.Characteristic,
	|	PackingTableForRequest.Series,
	|	PackingTableForRequest.Package,
	|	PackingTableForRequest.QuantityPerPackage,
	|	SUM(PackingTableForRequest.NumberOfPackages) AS NumberOfPackages,
	|	PackingTableForRequest.Warehouse,
	|	PackingTableForRequest.Premise,
	|	PackingTableForRequest.Period AS Period
	|INTO PackingTable_
	|FROM
	|	PackingTableForRequest AS PackingTableForRequest
	|
	|GROUP BY
	|	PackingTableForRequest.Products,
	|	PackingTableForRequest.QuantityPerPackage,
	|	PackingTableForRequest.Characteristic,
	|	PackingTableForRequest.Series,
	|	PackingTableForRequest.Package,
	|	PackingTableForRequest.Warehouse,
	|	PackingTableForRequest.Premise,
	|	PackingTableForRequest.Period
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP PackingTableForRequest";
	
	Query.SetParameter("PackingTable_", TableOfRequiredPackages);
	Query.Execute();
	
EndProcedure		

Procedure PerformPerformXYZClassificationOfPackages(Period, TempTablesManager)
	
	DataSource = New Structure;
	DataSource.Insert("DataSource",DataSourceForXYZClassification(Period, TempTablesManager));
	DataSource.Insert("BeginOfPeriod",Period.StartDate);
	DataSource.Insert("PeriodEnding",Period.EndDate);
		
	ClassificationResult = Classification.PerformXYZClassification(DataSource,
																	"NumberOfPackages", "Warehouse, Premise, Products, Characteristic, Series, Package");
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	ClassificationResult.Products,
	|	ClassificationResult.Characteristic,
	|	ClassificationResult.Series,
	|	ClassificationResult.Package,
	|	ClassificationResult.Warehouse,
	|	ClassificationResult.Premise,
	|	ClassificationResult.Class
	|INTO ClassificationResult
	|FROM
	|	&ClassificationResult AS ClassificationResult;";
	
	Query.SetParameter("ClassificationResult", ClassificationResult);
	Query.Execute();
	
EndProcedure

Function DataSourceForXYZClassification(Period, TempTablesManager)
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text = 
	"SELECT
	|	0 AS ClassificationSeparator,
	|	DataForClassification.Products AS Products,
	|	DataForClassification.Characteristic AS Characteristic,
	|	DataForClassification.Series AS Series,
	|	DataForClassification.Package AS Package,
	|	DataForClassification.NumberOfPackages AS NumberOfPackages,
	|	DataForClassification.Warehouse AS Warehouse,
	|	DataForClassification.Premise AS Premise,
	|	CAST(DataForClassification.Period AS DATE) AS Period
	|FROM
	|	PackingTable_ AS DataForClassification
	|
	|ORDER BY
	|	DataForClassification.Warehouse,
	|	DataForClassification.Premise
	|TOTALS
	|	MAX(ClassificationSeparator),
	|	SUM(NumberOfPackages)
	|BY
	|	Warehouse,
	|	Premise,
	|	Products,
	|	Characteristic,
	|	Series,
	|	Package,
	|	Period PERIODS(DAY, &BeginOfPeriod, &PeriodEnding)";
	
	Query.SetParameter("BeginOfPeriod", Period.StartDate);
	Query.SetParameter("PeriodEnding", Period.EndDate);
	
	Return Query.Execute();
		
EndFunction

Procedure CalculatePackageConsumptionForecastIndicators(Period, TempTablesManager)
	
	TableOfDates = New ValueTable;
	TableOfDates.Columns.Add("Period", New TypeDescription("Date"));
	
	DateFromPeriod = BegOfDay(Period.StartDate);
	
	While DateFromPeriod <= BegOfDay(Period.EndDate) Do 
		NewRow = TableOfDates.Add();
		NewRow.Period = DateFromPeriod;
		DateFromPeriod = DateFromPeriod + 86400;
	EndDo;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	PackingTable_.Products,
	|	PackingTable_.Characteristic,
	|	PackingTable_.Series,
	|	PackingTable_.Package,
	|	PackingTable_.QuantityPerPackage,
	|	SUM(PackingTable_.NumberOfPackages) AS NumberOfPackages,
	|	PackingTable_.Warehouse,
	|	PackingTable_.Premise,
	|	COUNT(DISTINCT PackingTable_.Period) AS NumberOfDaysWithExpense
	|INTO TableOfPackagesWithoutPeriods
	|FROM
	|	PackingTable_ AS PackingTable_
	|
	|GROUP BY
	|	PackingTable_.Package,
	|	PackingTable_.QuantityPerPackage,
	|	PackingTable_.Products,
	|	PackingTable_.Characteristic,
	|	PackingTable_.Series,
	|	PackingTable_.Warehouse,
	|	PackingTable_.Premise
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TableOfDates.Period
	|INTO TableOfDates
	|FROM
	|	&TableOfDates AS TableOfDates
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	SUM(BalancesAndTurnoverOfGoods.InStockClosingBalance) AS Count,
	|	BalancesAndTurnoverOfGoods.Products,
	|	BalancesAndTurnoverOfGoods.Characteristic,
	|	TableOfPackagesWithoutPeriods.Series,
	|	BalancesAndTurnoverOfGoods.Period,
	|	BalancesAndTurnoverOfGoods.Warehouse,
	|	BalancesAndTurnoverOfGoods.Premise
	|INTO BalancesAndTurnoverOfGoods
	|FROM
	|	AccumulationRegister.ProductStock.BalanceAndTurnovers(
	|			&StartDate,
	|			&EndDate,
	|			Day,
	|			RegisterRecordsAndPeriodBoundaries,
	|			(Warehouse, Premise, Products, Characteristic) IN
	|				(SELECT
	|					PackingTable_.Warehouse,
	|					PackingTable_.Premise,
	|					PackingTable_.Products,
	|					PackingTable_.Characteristic
	|				FROM
	|					TableOfPackagesWithoutPeriods AS PackingTable_)) AS BalancesAndTurnoverOfGoods
	|		INNER JOIN TableOfPackagesWithoutPeriods AS TableOfPackagesWithoutPeriods
	|		ON BalancesAndTurnoverOfGoods.Products = TableOfPackagesWithoutPeriods.Products
	|			AND BalancesAndTurnoverOfGoods.Characteristic = TableOfPackagesWithoutPeriods.Characteristic
	|			AND BalancesAndTurnoverOfGoods.Warehouse = TableOfPackagesWithoutPeriods.Warehouse
	|			AND BalancesAndTurnoverOfGoods.Premise = TableOfPackagesWithoutPeriods.Premise
	|			AND (BalancesAndTurnoverOfGoods.Series = TableOfPackagesWithoutPeriods.Series
	|				OR TableOfPackagesWithoutPeriods.Series = VALUE(Catalog.ItemsBatches.EmptyRef))
	|
	|GROUP BY
	|	TableOfPackagesWithoutPeriods.Series,
	|	BalancesAndTurnoverOfGoods.Characteristic,
	|	BalancesAndTurnoverOfGoods.Products,
	|	BalancesAndTurnoverOfGoods.Period,
	|	BalancesAndTurnoverOfGoods.Warehouse,
	|	BalancesAndTurnoverOfGoods.Premise
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	LeftoverPackages.Count,
	|	LeftoverPackages.Products,
	|	LeftoverPackages.Characteristic,
	|	LeftoverPackages.Series,
	|	LeftoverPackages.Warehouse,
	|	LeftoverPackages.Premise,
	|	TableOfDates.Period,
	|	MIN(LeftoverPackages.Period) AS PeriodInTableOfRevolutions
	|INTO PeriodsOfGoodsBalances
	|FROM
	|	TableOfDates AS TableOfDates
	|		INNER JOIN BalancesAndTurnoverOfGoods AS LeftoverPackages
	|		ON TableOfDates.Period >= LeftoverPackages.Period
	|
	|GROUP BY
	|	LeftoverPackages.Series,
	|	LeftoverPackages.Products,
	|	TableOfDates.Period,
	|	LeftoverPackages.Characteristic,
	|	LeftoverPackages.Premise,
	|	LeftoverPackages.Warehouse,
	|	LeftoverPackages.Count
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	BalancesAndTurnoverOfGoods.Products,
	|	BalancesAndTurnoverOfGoods.Characteristic,
	|	BalancesAndTurnoverOfGoods.Series,
	|	BalancesAndTurnoverOfGoods.Warehouse,
	|	BalancesAndTurnoverOfGoods.Premise,
	|	BalancesAndTurnoverOfGoods.Count,
	|	PeriodsOfGoodsBalances.Period
	|INTO ProductBalancesByDay
	|FROM
	|	BalancesAndTurnoverOfGoods AS BalancesAndTurnoverOfGoods
	|		INNER JOIN PeriodsOfGoodsBalances AS PeriodsOfGoodsBalances
	|		ON BalancesAndTurnoverOfGoods.Products = PeriodsOfGoodsBalances.Products
	|			AND BalancesAndTurnoverOfGoods.Characteristic = PeriodsOfGoodsBalances.Characteristic
	|			AND BalancesAndTurnoverOfGoods.Series = PeriodsOfGoodsBalances.Series
	|			AND BalancesAndTurnoverOfGoods.Warehouse = PeriodsOfGoodsBalances.Warehouse
	|			AND BalancesAndTurnoverOfGoods.Premise = PeriodsOfGoodsBalances.Premise
	|			AND BalancesAndTurnoverOfGoods.Period = PeriodsOfGoodsBalances.PeriodInTableOfRevolutions
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TableOfPackagesWithoutPeriods.Products,
	|	TableOfPackagesWithoutPeriods.Characteristic,
	|	TableOfPackagesWithoutPeriods.Series,
	|	TableOfPackagesWithoutPeriods.Package,
	|	TableOfPackagesWithoutPeriods.NumberOfPackages,
	|	TableOfPackagesWithoutPeriods.Warehouse,
	|	TableOfPackagesWithoutPeriods.Premise,
	|	COUNT(DISTINCT ProductBalancesByDay.Period) AS NumberOfDaysRemaining
	|INTO TableNumberOfDaysWithBalance
	|FROM
	|	TableOfPackagesWithoutPeriods AS TableOfPackagesWithoutPeriods
	|		INNER JOIN ProductBalancesByDay AS ProductBalancesByDay
	|		ON TableOfPackagesWithoutPeriods.Products = ProductBalancesByDay.Products
	|			AND TableOfPackagesWithoutPeriods.Characteristic = ProductBalancesByDay.Characteristic
	|			AND TableOfPackagesWithoutPeriods.Series = ProductBalancesByDay.Series
	|			AND TableOfPackagesWithoutPeriods.Warehouse = ProductBalancesByDay.Warehouse
	|			AND TableOfPackagesWithoutPeriods.Premise = ProductBalancesByDay.Premise
	|WHERE
	|	ProductBalancesByDay.Count > TableOfPackagesWithoutPeriods.QuantityPerPackage
	|
	|GROUP BY
	|	TableOfPackagesWithoutPeriods.Package,
	|	TableOfPackagesWithoutPeriods.NumberOfPackages,
	|	TableOfPackagesWithoutPeriods.Series,
	|	TableOfPackagesWithoutPeriods.Products,
	|	TableOfPackagesWithoutPeriods.Premise,
	|	TableOfPackagesWithoutPeriods.Warehouse,
	|	TableOfPackagesWithoutPeriods.Characteristic
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TableOfPackagesWithoutPeriods.Products,
	|	TableOfPackagesWithoutPeriods.Characteristic,
	|	TableOfPackagesWithoutPeriods.Series,
	|	TableOfPackagesWithoutPeriods.Package,
	|	TableOfPackagesWithoutPeriods.QuantityPerPackage,
	|	TableOfPackagesWithoutPeriods.NumberOfPackages,
	|	TableOfPackagesWithoutPeriods.Warehouse,
	|	TableOfPackagesWithoutPeriods.Premise,
	|	TableOfPackagesWithoutPeriods.NumberOfDaysWithExpense,
	|	CASE
	|		WHEN ISNULL(TableNumberOfDaysWithBalance.NumberOfDaysRemaining, 0) = 0
	|			THEN 0
	|		ELSE TableOfPackagesWithoutPeriods.NumberOfDaysWithExpense / TableNumberOfDaysWithBalance.NumberOfDaysRemaining
	|	END * 100 AS ShipmentProbabilityWithinDay,
	|	TableOfPackagesWithoutPeriods.NumberOfPackages / TableOfPackagesWithoutPeriods.NumberOfDaysWithExpense AS AverageDailyConsumption
	|INTO TableOfAverageDailyConsumption
	|FROM
	|	TableOfPackagesWithoutPeriods AS TableOfPackagesWithoutPeriods
	|		LEFT JOIN TableNumberOfDaysWithBalance AS TableNumberOfDaysWithBalance
	|		ON TableOfPackagesWithoutPeriods.Products = TableNumberOfDaysWithBalance.Products
	|			AND TableOfPackagesWithoutPeriods.Characteristic = TableNumberOfDaysWithBalance.Characteristic
	|			AND TableOfPackagesWithoutPeriods.Series = TableNumberOfDaysWithBalance.Series
	|			AND TableOfPackagesWithoutPeriods.Package = TableNumberOfDaysWithBalance.Package
	|			AND TableOfPackagesWithoutPeriods.Warehouse = TableNumberOfDaysWithBalance.Warehouse
	|			AND TableOfPackagesWithoutPeriods.Premise = TableNumberOfDaysWithBalance.Premise
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	PackingTable_.Products,
	|	PackingTable_.Characteristic,
	|	PackingTable_.Series,
	|	PackingTable_.Package,
	|	PackingTable_.Warehouse,
	|	PackingTable_.Premise,
	|	SUM((PackingTable_.NumberOfPackages - TableOfAverageDailyConsumption.AverageDailyConsumption) * (PackingTable_.NumberOfPackages - TableOfAverageDailyConsumption.AverageDailyConsumption) / CASE
	|			WHEN TableOfAverageDailyConsumption.NumberOfDaysWithExpense < 2
	|				THEN 1
	|			ELSE TableOfAverageDailyConsumption.NumberOfDaysWithExpense - 1
	|		END) AS Variance,
	|	TableOfAverageDailyConsumption.AverageDailyConsumption,
	|	TableOfAverageDailyConsumption.ShipmentProbabilityWithinDay
	|FROM
	|	PackingTable_ AS PackingTable_
	|		INNER JOIN TableOfAverageDailyConsumption AS TableOfAverageDailyConsumption
	|		ON PackingTable_.Products = TableOfAverageDailyConsumption.Products
	|			AND PackingTable_.Characteristic = TableOfAverageDailyConsumption.Characteristic
	|			AND PackingTable_.Package = TableOfAverageDailyConsumption.Package
	|			AND PackingTable_.Series = TableOfAverageDailyConsumption.Series
	|			AND PackingTable_.Warehouse = TableOfAverageDailyConsumption.Warehouse
	|			AND PackingTable_.Premise = TableOfAverageDailyConsumption.Premise
	|
	|GROUP BY
	|	PackingTable_.Package,
	|	PackingTable_.Products,
	|	PackingTable_.Premise,
	|	PackingTable_.Series,
	|	PackingTable_.Characteristic,
	|	PackingTable_.Warehouse,
	|	TableOfAverageDailyConsumption.AverageDailyConsumption,
	|	TableOfAverageDailyConsumption.ShipmentProbabilityWithinDay";
	
	Query.SetParameter("TableOfDates", TableOfDates);
	Query.SetParameter("StartDate", Period.StartDate);
	Query.SetParameter("EndDate", Period.EndDate);
	
	TableOfIndicators = Query.Execute().Unload();
	
	TableOfIndicators.Columns.Add("RootMeanSquareVariance", TMCommonUse.GetDescriptionOfNumberTypes(15,2));
 
	For Each RowOfTables In TableOfIndicators Do
		RowOfTables.RootMeanSquareVariance = Sqrt(RowOfTables.Variance);	
	EndDo;
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	ForecastIndicators.Products,
	|	ForecastIndicators.Characteristic,
	|	ForecastIndicators.Series,
	|	ForecastIndicators.Package,
	|	ForecastIndicators.Warehouse,
	|	ForecastIndicators.Premise,
	|	ForecastIndicators.AverageDailyConsumption,
	|	ForecastIndicators.RootMeanSquareVariance,
	|	ForecastIndicators.ShipmentProbabilityWithinDay
	|INTO ForecastIndicators
	|FROM
	|	&ForecastIndicators AS ForecastIndicators";
	
	Query.SetParameter("ForecastIndicators", TableOfIndicators);
	Query.Execute();
		
EndProcedure

Procedure WriteForecastIndicatorsToRegister(Warehouse, Premise, TempTablesManager)
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	Query.Text =
	"SELECT
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Series,
	|	NestedQuery.Package,
	|	NestedQuery.Warehouse,
	|	NestedQuery.Premise,
	|	MAX(NestedQuery.AverageDailyConsumption) AS AverageDailyConsumption,
	|	MAX(NestedQuery.RootMeanSquareVariance) AS RootMeanSquareVariance,
	|	MAX(NestedQuery.ShipmentProbabilityWithinDay) AS ShipmentProbabilityWithinDay,
	|	MAX(NestedQuery.AssignedByUser) AS AssignedByUser,
	|	MAX(NestedQuery.StandardStockLevel) AS StandardStockLevel,
	|	MAX(NestedQuery.Class) AS Class
	|FROM
	|	(SELECT
	|		ClassificationResult.Products AS Products,
	|		ClassificationResult.Characteristic AS Characteristic,
	|		ClassificationResult.Series AS Series,
	|		ClassificationResult.Package AS Package,
	|		ClassificationResult.Warehouse AS Warehouse,
	|		ClassificationResult.Premise AS Premise,
	|		0 AS AverageDailyConsumption,
	|		0 AS RootMeanSquareVariance,
	|		0 AS ShipmentProbabilityWithinDay,
	|		FALSE AS AssignedByUser,
	|		0 AS StandardStockLevel,
	|		ClassificationResult.Class AS Class
	|	FROM
	|		ClassificationResult AS ClassificationResult
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ForecastIndicators.Products,
	|		ForecastIndicators.Characteristic,
	|		ForecastIndicators.Series,
	|		ForecastIndicators.Package,
	|		ForecastIndicators.Warehouse,
	|		ForecastIndicators.Premise,
	|		ForecastIndicators.AverageDailyConsumption,
	|		ForecastIndicators.RootMeanSquareVariance,
	|		ForecastIndicators.ShipmentProbabilityWithinDay,
	|		FALSE,
	|		0,
	|		VALUE(Enum.XYZClassification.EmptyRef)
	|	FROM
	|		ForecastIndicators AS ForecastIndicators
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		PackageConsumptionForecasts.Products,
	|		PackageConsumptionForecasts.Characteristic,
	|		PackageConsumptionForecasts.Series,
	|		PackageConsumptionForecasts.Package,
	|		PackageConsumptionForecasts.Warehouse,
	|		PackageConsumptionForecasts.Premise,
	|		0,
	|		0,
	|		0,
	|		TRUE,
	|		PackageConsumptionForecasts.StandardStockLevel,
	|		VALUE(Enum.XYZClassification.EmptyRef)
	|	FROM
	|		InformationRegister.PackageConsumptionForecasts AS PackageConsumptionForecasts
	|	WHERE
	|		PackageConsumptionForecasts.AssignedByUser
	|		AND PackageConsumptionForecasts.Warehouse = &Warehouse
	|		AND PackageConsumptionForecasts.Premise = &Premise) AS NestedQuery
	|
	|GROUP BY
	|	NestedQuery.Products,
	|	NestedQuery.Characteristic,
	|	NestedQuery.Series,
	|	NestedQuery.Package,
	|	NestedQuery.Warehouse,
	|	NestedQuery.Premise";
	
	Query.SetParameter("Warehouse", Warehouse);
	Query.SetParameter("Premise", Premise);
	
	Set = InformationRegisters.PackageConsumptionForecasts.CreateRecordSet();
	Set.Filter.Warehouse.Set(Warehouse);
	Set.Filter.Premise.Set(Premise);
	
	Set.Load(Query.Execute().Unload());
	
	Set.Write();
	
EndProcedure

