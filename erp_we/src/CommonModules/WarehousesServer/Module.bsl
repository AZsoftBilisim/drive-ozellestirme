#Region FillInChecks

// The procedure checks the order by the specified type. if the warehouse is not ordered, a message is displayed to the user.
//
// Parameters:
//  Warehouse			 - CatalogRef.Warehouses	 - link to the warehouse that is being checked for ordering;
//  Date			 - Date						 - the date on which the order is checked;
//  TypeOfOrderScheme - String					 - possible values: "pre-display and re-display", "pre-Load","pre-Access".
//  Cancel			 - Boolean					 - the parameter returns False if the check is not passed.
//
Procedure CheckWarehouseOrder(Warehouse, Date, TypeOfOrderScheme, Cancel) Export
	PropsNameWarehouse = "Object.Warehouse";
	MessageText = NStr("vi = 'Trong kho bãi %Warehouse% tại ngày %Date% không sử dụng sơ đồ hai pha %TypeOfOrderScheme%. Hãy chọn kho khác';
						|ru = 'На складе %Warehouse% на %Date% не используется ордерная схема %TypeOfOrderScheme%. Выберите другой склад';
						|en = 'Warehouse management %TypeOfOrderScheme% is not enabled in warehouse ""%Warehouse%"" as of %Date%. Select another warehouse'; fa = 'Warehouse management %TypeOfOrderScheme% is not enabled in warehouse ""%Warehouse%"" as of %Date%. Select another warehouse';
						|it = 'Nel magazzino %Warehouse% alla %Date% non viene utilizzata lo schema dei mandati %TypeOfOrderScheme%. Seleziona un altro magazzino';
						|pl = 'Na magazynie %Warehouse% na %Date% nie jest używany schemat zleceniowy %TypeOfOrderScheme%. Wybierz inny magazyn';
						|tr = '%Date% üzerindeki %Warehouse% ambar şeması %TypeOfOrderScheme% kullanılmıyor. Başka bir ambar seç'");
	MessageText = StrReplace(MessageText,"%Warehouse%",Warehouse);
	MessageText = StrReplace(MessageText,"%Date%",Format(Date,"DLF=D"));
	If TypeOfOrderScheme = "WhenReflectingSurplusShortages"
			And Not UseWarehouseManagemantSystemForGoodsSurplusesShortages(Warehouse, Date) Then
		MessageText = StrReplace(MessageText,"%TypeOfOrderScheme%",NStr("vi = 'khi phản ánh thặng dư, thiếu hụt, tái tổ hợp và hư hỏng';
																		|ru = 'при отражении излишков, недостач, пересортицы и порчи';
																		|en = 'on recording surpluses, shortages, stock reclass, and damage'; fa = 'on recording surpluses, shortages, stock reclass, and damage';
																		|it = 'nella visualizzazione delle eccedenze, ammanchi, differenze inventariali e deterioramento';
																		|pl = 'Podczas odzwierciedlenia nadwyżki, niedoboru, zmiany gatunku oraz uszkodzenia';
																		|tr = 'fazlalıklar, eksiklikler, yeniden sınıflandırmalar ve stok kalite değişiklikleri yansıtılırken'"));
		CommonClientServer.MessageToUser(MessageText,,PropsNameWarehouse,,Cancel);
	ElsIf TypeOfOrderScheme = "OnShipment"
			And Not UseWarehouseManagemantSystemForGoodsIssue(Warehouse, Date) Then
		MessageText = StrReplace(MessageText,"%TypeOfOrderScheme%",NStr("vi = 'khi xuất hàng';
																		|ru = 'при отгрузке';
																		|en = 'on shipment'; fa = 'on shipment';
																		|it = 'alla spedizione';
																		|pl = 'przy wysyłce';
																		|tr = 'Sevkiyat sırasında'"));
		CommonClientServer.MessageToUser(MessageText,,PropsNameWarehouse,,Cancel);
	ElsIf TypeOfOrderScheme = "OnReceipt"
		And Not UseWarehouseManagemantSystemForGoodsReceipt(Warehouse, Date) Then
