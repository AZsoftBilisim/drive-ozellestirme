Procedure CreateSelectionTasksBasedOnOrders(ParametersStructure, StructureOfData)
	
	Warehouse = ParametersStructure.Warehouse;
	Premise = ParametersStructure.Premise;
	WarehouseZone = ParametersStructure.WarehouseZone;
	CustomizeGenerationByWorkAreas = ParametersStructure.CustomizeGenerationByWorkAreas;
	LimitationByWeight = ParametersStructure.LimitationByWeight;
	LimitationByVolume = ParametersStructure.LimitationByVolume;
	LimitByVolume = ParametersStructure.LimitByVolume;
	LimitByWeight = ParametersStructure.LimitByWeight;
	
	If ParametersStructure.Property("Performer") Then
		Performer = ParametersStructure.Performer;
	Else 
		Performer = Catalogs.Users.EmptyRef();
	EndIf;
	
	OrdersTasks = New Map;
	
	If StructureOfData.ResultsTable.Count() > 0 Then
		
		If CustomizeGenerationByWorkAreas = "GroupByWarehouseZones" Then
			
			RequestPlots = New Query;
			RequestPlots.Text = "SELECT
			|	WarehouseZones.Ref AS WarehouseZone,
			|	WarehouseZones.LimitByWeight AS LimitByWeight,
			|	WarehouseZones.LimitationByWeight AS LimitationByWeight,
			|	WarehouseZones.LimitByVolume AS LimitByVolume,
			|	WarehouseZones.LimitationByVolume AS LimitationByVolume
			|FROM
			|	Catalog.WarehouseZones AS WarehouseZones
			|WHERE
			|	WarehouseZones.Owner = &Warehouse
			|	AND WarehouseZones.Premise = &Premise";
			
			RequestPlots.SetParameter("Warehouse",Warehouse);
			RequestPlots.SetParameter("Premise",Premise);
			
			TableOfWorkPlots = RequestPlots.Execute().Unload();
			
			NewRow = TableOfWorkPlots.Add();
			NewRow.WarehouseZone = Catalogs.WarehouseZones.EmptyRef();
			NewRow.LimitByVolume = False;
			NewRow.LimitByWeight = False;
			
		Else	
			TableOfWorkPlots = New ValueTable;
			TableOfWorkPlots.Columns.Add("WarehouseZone", New TypeDescription("CatalogRef.WarehouseZones"));
			NewRow = TableOfWorkPlots.Add();
			If CustomizeGenerationByWorkAreas = "WithoutBreakdownByWarehouseZones" Then
				NewRow.WarehouseZone = Catalogs.WarehouseZones.EmptyRef();
			Else
				NewRow.WarehouseZone = WarehouseZone;
			EndIf;
			
		EndIf;
		
		ImpossibleSet = 9999999999;
		
		For Each WorkingSectionLine In TableOfWorkPlots Do
			
			If CustomizeGenerationByWorkAreas = "GroupByWarehouseZones" Then						
				MaximumVolume_ = ?(WorkingSectionLine.LimitByVolume, WorkingSectionLine.LimitationByVolume, ImpossibleSet);
				MaximumWeight = ?(WorkingSectionLine.LimitByWeight, WorkingSectionLine.LimitationByWeight, ImpossibleSet);						
			Else
				MaximumVolume_ = ?(LimitByVolume, LimitationByVolume, ImpossibleSet);
				MaximumWeight = ?(LimitByWeight, LimitationByWeight, ImpossibleSet);						
			EndIf;
			
			If CustomizeGenerationByWorkAreas <> "WithoutBreakdownByWarehouseZones" Then			
				ResultTable2 = StructureOfData.ResultsTable.FindRows(New Structure("WarehouseZone",WorkingSectionLine.WarehouseZone));			
			Else			
				ResultTable2 = StructureOfData.ResultsTable;
			EndIf;			
			
			// Splitting by weight and volume. Agreements:
			//  - if the weight (volume) of one line is greater than the limits, a separate document is created,
			//		the weight (volume) of which will be greater than the maximum
			//	- splitting by weight (volume) is not optimal, because preserving the order of traversal is more priority
			//			(it's better to have more tasks, but each one can be bypassed faster).
			
			CurrentOrder 	  = Undefined;
			FormByOrder = True;
			SkipContainer = 0;
			KeyToCommunicatingWithTareLast = 0;
			
			// We go first to the result, because in it the rows are ordered by traversal
			For Each RowOfTables In ResultTable2 Do
				
				If CurrentOrder <> RowOfTables.ReferenceOrder Then
					
					CurrentOrder = RowOfTables.ReferenceOrder;
					FormByOrder = True;
					
					If Not ValueIsFilled(Common.ObjectAttributeValue(CurrentOrder, "ShippingZone")) Then
						
						FormByOrder = False;
						
						MessageText = NStr("vi = 'Trong lệnh %AtYourDisposal% chưa chỉ ra vùng giao hàng.
						|Cần chỉ ra vùng giao hàng khi tùy chỉnh tạo nhiệm vụ lấy ra hàng hóa.';
						|ru = 'В распоряжении %AtYourDisposal% не указана зона отгрузки.
						|Необходимо указать зону отгрузки при настройке формирования заданий на отбор товаров.';
						|en = 'Outbound area is not specified in the %AtYourDisposal% reference.
						|Specify an outbound area when you set up generation of goods picking jobs.'; fa = 'Outbound area is not specified in the %AtYourDisposal% reference.
						|Specify an outbound area when you set up generation of goods picking jobs.';
						|it = 'Nella disposizione %AtYourDisposal% non è stata specificata l''area di spedizione.
						|È necessario indicare l''area di spedizione quando vengono impostate i task per la selezione delle merci.';
						|pl = 'W zamówieniu %AtYourDisposal% nie została podana strefa wysyłki.
						|Należy podać strefę wysyłki podczas konfigurowania utworzenia zadań na wybór towarów.';
						|tr = 'Sevkiyat bölgesi %AtYourDisposal% siparişinde belirtilmemiştir.
						|Ürünlerin seçimi için görevlerin oluşturulması sırasında sevkiyat bölgesinin belirtilmesi gerekir.'");
						
						MessageText = StrReplace(MessageText,"%AtYourDisposal%",CurrentOrder);
						
						CommonClientServer.MessageToUser(MessageText);
						
					EndIf;
					
					If FormByOrder Then
						
						DocumentStructure = OrdersTasks[CurrentOrder];
						
						If DocumentStructure = Undefined Then
							
							DocumentStructure = New Structure;
							DocumentStructure.Insert("DocumentObject", NewTaskObject_(CurrentOrder,WorkingSectionLine.WarehouseZone, Warehouse, Premise, Performer));
							DocumentStructure.Insert("VolumeM3", 0);
							DocumentStructure.Insert("Weight", 0);
							
							OrdersTasks.Insert(CurrentOrder,DocumentStructure);
							
						ElsIf CustomizeGenerationByWorkAreas = "GroupByWarehouseZones" Then
							
							DocumentStructure.VolumeM3    = 0;
							DocumentStructure.Weight	  = 0;
							DocumentStructure.DocumentObject = NewTaskObject_(CurrentOrder,WorkingSectionLine.WarehouseZone, Warehouse, Premise, Performer);
							
						EndIf;
						
					EndIf;
				EndIf;
				
				If Not FormByOrder Then
					Continue;
				EndIf;
				
				If SkipContainer = RowOfTables.KeyToCommunicatingWithTare Then
					Continue;
				EndIf;
				
				SkipContainer = 0;
				
				If (RowOfTables.PackageVolume*RowOfTables.NumberOfPackages > MaximumVolume_
					Or  RowOfTables.PackageWeight*RowOfTables.NumberOfPackages > MaximumWeight) Then
					
					DocumentObject = NewTaskObject_(RowOfTables.ReferenceOrder,WorkingSectionLine.WarehouseZone, Warehouse, Premise, Performer);
					
					For Each TableRows In ResultTable2 Do
						
						If TableRows.KeyToCommunicatingWithTare = RowOfTables.KeyToCommunicatingWithTare Then
							NewRow = DocumentObject.GoodsFilter.Add();
							FillPropertyValues(NewRow,RowOfTables);
						EndIf;
						
					EndDo;
					
					SkipContainer = RowOfTables.KeyToCommunicatingWithTare;
					
					WriteTaskObject(DocumentObject);
					
				Else
					
					If KeyToCommunicatingWithTareLast <> RowOfTables.KeyToCommunicatingWithTare 
						And (OrdersTasks[RowOfTables.ReferenceOrder].VolumeM3 + RowOfTables.PackageVolume*RowOfTables.NumberOfPackages) > MaximumVolume_
						Or (OrdersTasks[RowOfTables.ReferenceOrder].Weight + RowOfTables.PackageWeight*RowOfTables.NumberOfPackages) > MaximumWeight Then
						
						WriteTaskObject(OrdersTasks[RowOfTables.ReferenceOrder].DocumentObject);
						//
						OrdersTasks[RowOfTables.ReferenceOrder].VolumeM3    = 0;
						OrdersTasks[RowOfTables.ReferenceOrder].Weight	  = 0;
						OrdersTasks[RowOfTables.ReferenceOrder].DocumentObject = NewTaskObject_(RowOfTables.ReferenceOrder,WorkingSectionLine.WarehouseZone, Warehouse, Premise, Performer);
						
					EndIf;
					
					DocumentObjectGoodsSelection = OrdersTasks[RowOfTables.ReferenceOrder].DocumentObject.GoodsFilter; // DocumentTabularSection.GoodsPickingPlacement.GoodsFilter
					NewRow = DocumentObjectGoodsSelection.Add();
					FillPropertyValues(NewRow,RowOfTables);
					
					OrdersTasks[RowOfTables.ReferenceOrder].VolumeM3 = OrdersTasks[RowOfTables.ReferenceOrder].VolumeM3
																	+ RowOfTables.PackageVolume*RowOfTables.NumberOfPackages;
					OrdersTasks[RowOfTables.ReferenceOrder].Weight	= OrdersTasks[RowOfTables.ReferenceOrder].Weight 
																	+ RowOfTables.PackageWeight*RowOfTables.NumberOfPackages;
					
				EndIf;
				
				KeyToCommunicatingWithTare = RowOfTables.KeyToCommunicatingWithTare;
				
			EndDo;
			
			For Each RowDoc In OrdersTasks Do
				
				If RowDoc.Value.DocumentObject.GoodsFilter.Count() > 0 Then
					
					WriteTaskObject(RowDoc.Value.DocumentObject)
					
				EndIf;
				
			EndDo;
		EndDo;		
	Else
		MessageText = NStr("vi = 'Không thể thực hiện nhiệm vụ lấy ra hàng hóa theo quy tắc lấy ra.';
							|ru = 'Не удалось сформировать задания на отбор товаров согласно правилам отбора.';
							|en = 'Cannot generate goods picking jobs according to the picking rules.'; fa = 'Cannot generate goods picking jobs according to the picking rules.';
							|it = 'Impossibile generare i task per la selezione delle merci secondo le regole di selezione.';
							|pl = 'Nie udało się utworzyć zadania na wybór towarów zgodnie z zasadami wyboru.';
							|tr = 'Filtre kurallarına göre ürün filtre görevleri oluşturulamadı.'");
		
		CommonClientServer.MessageToUser(MessageText);
	EndIf;
EndProcedure

Procedure WriteTaskObject(DocumentObject)
	Try
		
		If DocumentObject.CheckFilling() Then
			SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(DocumentObject, Documents.GoodsPickingPlacement);
			ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.Filter);
			If DocumentObject.OperationKind = Enums.OperationKindsOfGoodsPlacementPicking.Move Then
				ProductsServer.FillInStatusesForSpecifyingSeries(DocumentObject, SeriesSpecificationParameters.Location);
			EndIf;
			DocumentObject.Write(DocumentWriteMode.Posting);
			
		EndIf;
	Except
		CommonClientServer.MessageToUser(BriefErrorDescription(ErrorInfo()));
	EndTry;
EndProcedure

Function NewTaskObject_(ReferenceOrder,WarehouseZone, Warehouse, Premise, Performer)
	
	DocumentObject = Documents.GoodsPickingPlacement.CreateDocument();
	DocumentObject.Date 				= CurrentSessionDate();
	DocumentObject.Status 				= Enums.StatusesOfGoodsPickingPlacement.Prepared2;
	DocumentObject.Warehouse 				= Warehouse;
	DocumentObject.Premise 			= Premise;
	
	If ReferenceOrder = Undefined Then
		DocumentObject.OperationKind 			= Enums.OperationKindsOfGoodsPlacementPicking.Move;
	Else 
		DocumentObject.OperationKind 			= Enums.OperationKindsOfGoodsPlacementPicking.Filter;
		DocumentObject.ShippingZone		 	= Common.ObjectAttributeValue(ReferenceOrder, "ShippingZone");
		DocumentObject.ReferenceOrder			= ReferenceOrder;
	EndIf;
	
	DocumentObject.EmployeeResponsible 	= Users.CurrentUser();
	If ValueIsFilled(Performer) Then
		DocumentObject.Performer 	= Performer;
	EndIf;
	
	DocumentObject.WarehouseZone 	= WarehouseZone;
		
	Return DocumentObject;
	
EndFunction

// Starts the background queue formation of the information register and reissues the spending orders when changing
// the system settings of the order of formation of spending orders.
//
Procedure StartingQueueFormationAndReissuingSpendingOrders() Export
	
	SetPrivilegedMode(True);
	
	If Common.FileInfobase() Then
		PerformBackgroundQueueFormationAndReissueOfSpendingOrders();
	Else
		Var_Key = "FormationOfQueueForReissuingSpendingOrders";
		
		Filter = New Structure;
		Filter.Insert("Key", Var_Key);
		Filter.Insert("State", BackgroundJobState.Active);
		
		ActiveTasks = BackgroundJobs.GetBackgroundJobs(Filter);
		
		If ActiveTasks.Count() > 0 Then
			Return;
		EndIf;
		
		ExportProcedureName = "WarehousesServer.PerformBackgroundQueueFormationAndReissueOfSpendingOrders";
		ExportProcedureParameters = New Array;
		
		JobParameters = New Array;
		JobParameters.Add(ExportProcedureName);
		JobParameters.Add(ExportProcedureParameters);
		
		JobDescription = NStr("vi = 'Tạo hàng đợi tạo lại phiếu xuất.';
								|ru = 'Формирование очереди переоформления расходных ордеров.';
								|en = 'Generation of queue of goods issue note reregistration.'; fa = 'Generation of queue of goods issue note reregistration.';
								|it = 'Generazione della coda per il rinnovo dei mandati di pagamento.';
								|pl = 'Tworzenie kolejki na ponowne wydanie zleceń rozchodowych.';
								|tr = 'Ambar çıkış fişlerinin yeniden düzenlenmesi için bir sıra oluşturulması.'");
		
		BackgroundJobs.Execute("Common.ExecuteConfigurationMethod",
								JobParameters,
								Var_Key,
								JobDescription);
	EndIf;
	
EndProcedure

// Performs the formation of the information register queue and the reissue of spending orders when changing
// the system settings for the formation of spending orders in the background.
//
Procedure PerformBackgroundQueueFormationAndReissueOfSpendingOrders() Export
	
	RecordsToAdd = Undefined;
	
	RequestTextParameters = ParametersOfQueueQueryText();
	RequestTextParameters.ShipAfterShipmentTask = True;
	RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
		Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	DimensionalTypesOfUnits	= Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits();
	ProcedureForProcessingDocuments	= Constants.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.Get();
	IssueInvoicesFirst	= 
		ProcedureForProcessingDocuments = Enums.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.InvoicesFirst;
	
	BeginTransaction();
	
	Try
		Block = New DataLock;
		
		LockItem = Block.Add("InformationRegister.GoodsIssueNoteReregistrationQueue");
		
		LockItem = Block.Add("AccumulationRegister.GoodsForIssue");
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("AccumulationRegister.ProductStock");
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("InformationRegister.GoodsToDeliver");
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("InformationRegister.StatesAndDetailsOfDelivery");
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("Document.TransportationJob");
		LockItem.Mode = DataLockMode.Shared;
		
		Block.Lock();
		
		TempTableManager = New TempTablesManager;
		
		AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
		AdditionalParameters.TempTableName = "TTBlockedGoodsForShipment";
		
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
			Undefined, "AccumulationRegister.GoodsForIssue", "DocumentShipments", TempTableManager, AdditionalParameters);
		
		AdditionalParameters.TempTableName = "TTBlockedGoodsInWarehouses";
		
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
			Undefined, "AccumulationRegister.ProductStock", "Warehouse", TempTableManager, AdditionalParameters);
		
		AdditionalParameters.TempTableName = "TTTransportTaskBlocked";
		
		InfobaseUpdate.CreateTemporaryTableOfDataProhibitedFromReadingAndEditing(
			Undefined, "Document.TransportationJob", TempTableManager, AdditionalParameters);
		
		Query = New Query;
		Query.TempTablesManager = TempTableManager;
		Query.Text = QueueFormationQueryText(RequestTextParameters);
		
		Query.SetParameter("IssueInvoicesFirst", IssueInvoicesFirst);
		Query.SetParameter("DimensionalTypesOfUnits", DimensionalTypesOfUnits);
		Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
			RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
		Query.SetParameter("UseTransportationJobsForDeliveryAccountingByCarriers",
			GetFunctionalOption("UseTransportationJobsForDeliveryAccountingByCarriers"));
		
		RecordsToAdd = Query.Execute().Unload();
		
		If RecordsToAdd.Count() > 0 Then
			RecordSet = InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
			RecordSet.Load(RecordsToAdd);
			RecordSet.Write(ReplacementMode.Append);
		EndIf;
		
		CommitTransaction();
	Except
		RollbackTransaction();
		
		EventName = NStr("ru = 'Обновление очереди переоформления расходных ордеров';
						|vi = 'Update queue of goods issue reregistration';
						|en = 'Update queue of goods issue reregistration'; fa = 'Update queue of goods issue reregistration';
						|it = 'Update queue of goods issue reregistration';
						|pl = 'Update queue of goods issue reregistration';
						|tr = 'Çıkış fişlerini yeniden düzenleme kuyruğu güncellemesi'",
						Common.DefaultLanguageCode());
		
		MessageText = NStr("vi = 'Không thể cập nhật thứ tự tạo lại các phiếu xuất kho do: %1';
							|ru = 'Не удалось обновить очередь переоформления расходных ордеров по причине: %1';
							|en = 'Cannot update the queue of goods issue reregistration. Reason: %1'; fa = 'Cannot update the queue of goods issue reregistration. Reason: %1';
							|it = 'Cannot update the queue of goods issue reregistration. Reason: %1';
							|pl = 'Cannot update the queue of goods issue reregistration. Reason: %1';
							|tr = 'Ambar çıkış fişlerini yeniden düzenleme kuyruğu şu nedenden dolayı güncellenemedi: %1'");
		MessageText = StrTemplate(MessageText, ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		WriteLogEvent(EventName, EventLogLevel.Error, , , MessageText);
		
		Raise;
	EndTry;
	
	If RecordsToAdd <> Undefined Then
		FilterJobs = New Structure("Warehouse, Recipient");
		
		For Each QueueRecording In RecordsToAdd Do
			FillPropertyValues(FilterJobs, QueueRecording);
			
			ParametersStructure = New Structure("ParametersStructure", FilterJobs);
			
			PerformBackgroundReissueOfSpendingOrders(ParametersStructure);
		EndDo;
	EndIf;
	
EndProcedure

// Launches background reissue of spending orders when documents are reflected in accounting.
//
// Parameters:
//	ParametersStructure - Structure - a collection containing the following properties:
//		* Warehouse - CatalogRef.Warehouses - the warehouse for which the task is being performed.
//		* Recipient - CatalogRef.BusinessStructure, CatalogRef.Partners, CatalogRef.Warehouses - the recipient of the goods.
//
Procedure StartingBackgroundReissueOfSpendingOrders(ParametersStructure) Export
	
	If Common.FileInfobase() Then
		PerformBackgroundReissueOfSpendingOrders(New Structure("ParametersStructure", ParametersStructure));
	Else
		StartingExecutionOfBackgroundReissueOfExpenseOrdersFragment(ParametersStructure);
	EndIf;
	
EndProcedure

// Launches background reissue of spending orders when documents are reflected in accounting.
//
// Parameters:
//	ParametersStructure - Structure - a collection containing the following properties:
//		* Warehouse - CatalogRef.Warehouses - the warehouse for which the task is being performed.
//		* Recipient - CatalogRef.BusinessStructure, CatalogRef.Partners, CatalogRef.Warehouses - the recipient of the goods.
//
Procedure StartingExecutionOfBackgroundReissueOfExpenseOrdersFragment(ParametersStructure)
	
	Var_Key = "ReissuingSpendingOrders"
			+ String(ParametersStructure.Warehouse.UUID())
			+ String(ParametersStructure.Recipient.UUID());
	
	Filter = New Structure;
	Filter.Insert("Key", Var_Key);
	Filter.Insert("State", BackgroundJobState.Active);
	
	ActiveTasks = BackgroundJobs.GetBackgroundJobs(Filter);
	
	If ActiveTasks.Count() > 0 Then
		Return;
	EndIf;
	
	ExportProcedureName = "WarehousesServer.PerformBackgroundReissueOfSpendingOrders";
	
	ExportProcedureParameters = New Array;
	ExportProcedureParameters.Add(New Structure("ParametersStructure", ParametersStructure));
	
	JobParameters = New Array;
	JobParameters.Add(ExportProcedureName);
	JobParameters.Add(ExportProcedureParameters);
	
	JobDescription = NStr("vi = 'Tạo lại phiếu xuất kho theo Kho - %1; Người nhận - %2';
							|ru = 'Переоформление расходных ордеров по Складу - %1; Получателю - %2';
							|en = 'Reregister goods issue notes of Warehouse - %1. Recipient - %2'; fa = 'Reregister goods issue notes of Warehouse - %1. Recipient - %2';
							|it = 'Reregister goods issue notes of Warehouse - %1. Recipient - %2';
							|pl = 'Reregister goods issue notes of Warehouse - %1. Recipient - %2';
							|tr = 'Ambar çıkış fişlerinin yeniden düzenlenmesi: Depo - %1 ; Alıcı - %2'");
	JobDescription = StrTemplate(JobDescription,
									String(ParametersStructure.Warehouse),
									String(ParametersStructure.Recipient));
	
	BackgroundJobs.Execute("Common.ExecuteConfigurationMethod", JobParameters, Var_Key, JobDescription);
	
EndProcedure

// Event subscription that triggers background reissue of spending orders.
//
// Parameters:
//	Source - DocumentObject - the document that initialized the event.
//	Cancel - Boolean - indicates that the recording was rejected.
//	PostingMode - DocumentPostingMode - the mode of the document.
//
Procedure InCaseOfCancellationOfShipmentDocumentsProcessingOf(Source, Cancel, PostingMode) Export
	
	WhenStatusOfShipmentDocumentsChanges(Source);
	
EndProcedure

// Event subscription that triggers background reissue of spending orders.
//
// Parameters:
//	Source - DocumentObject - the document that initialized the event.
//	Cancel - Boolean - indicates that the recording was rejected.
//	PostingMode - DocumentPostingMode - the mode of the document.
//
Procedure WhenCarryingOutDocumentsOfShipmentProcessingOfCarryingOut(Source, Cancel, PostingMode) Export
	
	WhenStatusOfShipmentDocumentsChanges(Source);
	
EndProcedure

Procedure WhenStatusOfShipmentDocumentsChanges(Source)
	
	TheModeOfGeneratingSpendingOrdersAutomatically = Constants.GoodsIssueNoteGenerationMode.Get()
		= Enums.GoodsIssueNoteGenerationModes.Automatically;
	
	If Not TheModeOfGeneratingSpendingOrdersAutomatically Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.Text = 
	"SELECT
	|	GoodsIssueNoteReregistrationQueue.Warehouse AS Warehouse,
	|	GoodsIssueNoteReregistrationQueue.Recipient AS Recipient
	|FROM
	|	InformationRegister.GoodsIssueNoteReregistrationQueue AS GoodsIssueNoteReregistrationQueue";
	
	Selection = Query.Execute().Select();
	
	ParametersStructure = New Structure("Warehouse, Recipient");
	
	While Selection.Next() Do
		FillPropertyValues(ParametersStructure, Selection);
		StartingExecutionOfBackgroundReissueOfExpenseOrdersFragment(ParametersStructure);
	EndDo;
	
EndProcedure

// Performs the reissue of spending orders.
//
// Parameters:
//	JobParameters - Structure - a collection containing the following task completion parameters:
//		* ParametersStructure - Structure - a collection containing the following properties:
//			** Warehouse - CatalogRef.Warehouses - the warehouse for which the task is being performed.
//			** Recipient - CatalogRef.BusinessStructure, CatalogRef.Partners, CatalogRef.Warehouses - the recipient of the goods.
//
Procedure PerformBackgroundReissueOfSpendingOrders(JobParameters) Export
	
	Warehouse		= JobParameters.ParametersStructure.Warehouse;
	Recipient	= JobParameters.ParametersStructure.Recipient;
	
	If JobParameters.Property("ErrorsCount") Then
		If JobParameters.ErrorsCount >= 3 Then
			MessageText = NStr("vi = 'Đã dừng tạo lại phiếu xuất kho theo nhiệm vụ nền - %1; Người nhận - %2. Để biết thêm thông tin, hãy đến địa điểm giao hàng. Số lần thử thất bại: %3.';
								|ru = 'Фоновое переоформление расходных ордеров остановлено по Складу - %1; Получателю - %2. Для дополнительной информации перейдите в рабочее место отгрузки. Количество неудачных попыток: %3.';
								|en = 'Background reregistration of goods issue notes is stopped for Warehouse - %1. Recipient - %2. Go to shipment workplace for details. Number of failed attempts: %3.'; fa = 'Background reregistration of goods issue notes is stopped for Warehouse - %1. Recipient - %2. Go to shipment workplace for details. Number of failed attempts: %3.';
								|it = 'Background reregistration of goods issue notes is stopped for Warehouse - %1. Recipient - %2. Go to shipment workplace for details. Number of failed attempts: %3.';
								|pl = 'Background reregistration of goods issue notes is stopped for Warehouse - %1. Recipient - %2. Go to shipment workplace for details. Number of failed attempts: %3.';
								|tr = 'Ambar çıkış fişlerinin arka planda yeniden düzenlenmesi durduruldu: Depo - %1 ; Alıcı - %2 . Ek bilgi için sevkiyat çalışma alanına gidin. Başarısız deneme sayısı: %3.'");
			MessageText = StrTemplate(MessageText,
										String(Warehouse),
										String(Recipient),
										JobParameters.ErrorsCount);
			
			WriteLogEvent(NStr("vi = 'Tạo lại phiếu xuất kho theo nhiệm vụ nền';
								|ru = 'Фоновое переоформление расходных ордеров';
								|en = 'Background reregistration of goods issue notes'; fa = 'Background reregistration of goods issue notes';
								|it = 'Rinnovo dei mandati di pagamento in background';
								|pl = 'Kontekstowa realizacja orderów wydatków';
								|tr = 'Ambar çıkış fişlerinin arka planda yeniden düzenlenmesi'"),
									EventLogLevel.Error,
									,
									,
									MessageText);
			Return;
		EndIf;
	Else
		JobParameters.Insert("ErrorsCount", 0);
	EndIf;
	
	SetPrivilegedMode(True);
	
	ParametersForCreatingSpendingOrders = ParametersForReissuingSpendingOrders();
	ParametersForCreatingSpendingOrders.Warehouse = Warehouse;
	ParametersForCreatingSpendingOrders.Recipient = Recipient;
	ParametersForCreatingSpendingOrders.BackgroundJob = True;
	
	HasError = ReissueSpendingOrders(ParametersForCreatingSpendingOrders).HasError;
	
	If HasError Then
		JobParameters.ErrorsCount = JobParameters.ErrorsCount + 1;
		
		MessageText = NStr("vi = 'Có lỗi khi tạo lại phiếu xuất kho. Kho bãi: %1; Người nhận: %2. Số lượng lần thử: %3.';
							|ru = 'Есть ошибки при переоформлении расходных ордеров. Склад: %1; Получатель: %2. Количество попыток: %3.';
							|en = 'There are errors when reregistering the goods issue notes. Warehouse: %1. Recipient: %2. Number of attempts: %3.'; fa = 'There are errors when reregistering the goods issue notes. Warehouse: %1. Recipient: %2. Number of attempts: %3.';
							|it = 'There are errors when reregistering the goods issue notes. Warehouse: %1. Recipient: %2. Number of attempts: %3.';
							|pl = 'There are errors when reregistering the goods issue notes. Warehouse: %1. Recipient: %2. Number of attempts: %3.';
							|tr = '%1 ambarı ve %2 alıcısı için ambar çıkış fişleri kuyruğu şu nedenden dolayı oluşturulamadı: %3'");
		MessageText = StrTemplate(MessageText,
									String(Warehouse),
									String(Recipient),
									JobParameters.ErrorsCount);
		
		WriteLogEvent(NStr("vi = 'Tạo lại phiếu xuất kho theo nhiệm vụ nền';
							|ru = 'Фоновое переоформление расходных ордеров';
							|en = 'Background reregistration of goods issue notes'; fa = 'Background reregistration of goods issue notes';
							|it = 'Rinnovo dei mandati di pagamento in background';
							|pl = 'Kontekstowa realizacja orderów wydatków';
							|tr = 'Ambar çıkış fişlerinin arka planda yeniden düzenlenmesi'"),
								EventLogLevel.Error,
								,
								,
								MessageText);
	EndIf;
	
	If CheckForEntriesInQueue(JobParameters) Then
		PerformBackgroundReissueOfSpendingOrders(JobParameters);
	EndIf;
	
EndProcedure

Function CheckForEntriesInQueue(JobParameters)
	
	ThereAreEntriesInQueue = True;
	
	Warehouse		= JobParameters.ParametersStructure.Warehouse;
	Recipient	= JobParameters.ParametersStructure.Recipient;
	
	NoExternalTransaction = Not TransactionActive();
	
	If NoExternalTransaction Then
		BeginTransaction();
	EndIf;
	
	Try
		Block = New DataLock;
		
		LockItem = Block.Add("InformationRegister.GoodsIssueNoteReregistrationQueue");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.SetValue("Recipient", Recipient);
		
		LockItem = Block.Add("AccumulationRegister.GoodsForIssue");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.SetValue("Recipient", Recipient);
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("AccumulationRegister.ProductStock");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("InformationRegister.GoodsToDeliver");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("InformationRegister.StatesAndDetailsOfDelivery");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("Document.TransportationJob");
		LockItem.Mode = DataLockMode.Shared;
		
		Block.Lock();
		
		If Not YouNeedToReissueSpendingOrders(Warehouse, Recipient) Then
			RecordSet = InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
			RecordSet.Filter.Warehouse.Set(Warehouse);
			RecordSet.Filter.Recipient.Set(Recipient);
			
			RecordSet.Write();
			
			ThereAreEntriesInQueue = False;
		EndIf;
		
		If NoExternalTransaction Then
			CommitTransaction();
		EndIf;
	Except
		If NoExternalTransaction Then
			RollbackTransaction();
		EndIf;
		
		ThereAreEntriesInQueue = True;
		JobParameters.ErrorsCount = JobParameters.ErrorsCount + 1;
		
		MessageText = NStr("vi = 'Không thể tạo trình tự phiếu xuất theo kho bãi %1 và người nhận %2 do: %3';
							|ru = 'Не удалось сформировать очередь расходных ордеров по складу %1 и получателю %2 по причине: %3';
							|en = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3'; fa = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3';
							|it = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3';
							|pl = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3';
							|tr = '%1 ambarı ve %2 alıcısına göre ambar çıkış fişleri kuyruğu şu nedenden dolayı oluşturulamadı: %3'");
		MessageText = StrTemplate(MessageText,
									String(Warehouse),
									String(Recipient),
									ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		WriteLogEvent(InfobaseUpdate.EventLogEvent(),
								EventLogLevel.Error,
								,
								,
								MessageText);
		
		If Not NoExternalTransaction Then
			Raise;
		EndIf;
	EndTry;
	
	Return ThereAreEntriesInQueue;
	
EndFunction

// Performs verification of the need to reissue spending orders.
//
// Parameters:
//	Warehouse - CatalogRef.Warehouses - the warehouse to check for.
//	Recipient - CatalogRef.BusinessStructure, CatalogRef.Partners, CatalogRef.Warehouses - the recipient of the goods.
//
// Returns:
//	Boolean - a sign of the need to reissue spending orders.
//
Function YouNeedToReissueSpendingOrders(Warehouse, Recipient) Export
	
	RecordSetIsEmpty	= InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
	RecipientsOfGoods	= RecordSetIsEmpty.UnloadColumns("Warehouse, Recipient");
	
	NewRow = RecipientsOfGoods.Add();
	NewRow.Warehouse = Warehouse;
	NewRow.Recipient = Recipient;
	
	DataForQueueFormation = DataForFormingQueueForReissuingSpendingOrders(RecipientsOfGoods);
	
	Return DataForQueueFormation.Count() > 0;
	
EndFunction

// Returns a table containing data for forming a queue for reissuing spending orders.
//
// Parameters:
//	RecipientsOfGoods - ValueTable - a table containing information about the recipients of goods for which it is necessary
//											to check the possibility of shipping goods from the warehouse.
//
// Returns:
//	ValueTable:
//		* Warehouse - CatalogRef.Warehouses - the warehouse from which the goods are shipped.
//		* Recipient - CatalogRef.BusinessStructure, CatalogRef.Partners, CatalogRef.Warehouses - the recipient of the goods.
//
Function DataForFormingQueueForReissuingSpendingOrders(RecipientsOfGoods) Export
	
	TempTableManager = New TempTablesManager;
	
	AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
	AdditionalParameters.TempTableName = "TTBlockedGoodsForShipment";
	
	InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
		Undefined, "AccumulationRegister.GoodsForIssue", "DocumentShipments", TempTableManager, AdditionalParameters);
	
	AdditionalParameters.TempTableName = "TTBlockedGoodsInWarehouses";
	
	InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
		Undefined, "AccumulationRegister.ProductStock", "Warehouse", TempTableManager, AdditionalParameters);
	
	Query = New Query;
	Query.TempTablesManager = TempTableManager;
	Query.Text =
	"SELECT
	|	TableOfRecipients.Warehouse		AS Warehouse,
	|	TableOfRecipients.Recipient	AS Recipient
	|INTO TTRecipientTable
	|FROM
	|	&TableOfRecipients AS TableOfRecipients
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TableOfRecipients.Warehouse		AS Warehouse,
	|	TableOfRecipients.Recipient	AS Recipient,
	|	CASE
	|		WHEN CatalogWarehouses.StartShipmentOnceDeliveryOrderIsCreated IS NULL
	|			THEN FALSE
	|		ELSE CatalogWarehouses.StartShipmentOnceDeliveryOrderIsCreated
	|	END							AS ShipAfterShipmentTask
	|INTO TableOfRecipients
	|FROM
	|	TTRecipientTable AS TableOfRecipients
	|		INNER JOIN Catalog.Warehouses CatalogWarehouses
	|		ON TableOfRecipients.Warehouse = CatalogWarehouses.Ref
	|
	|WHERE
	|	CatalogWarehouses.UseWarehouseManagemantSystemForGoodsIssue
	|
	|INDEX BY
	|	Warehouse,
	|	Recipient";
	
	Query.SetParameter("TableOfRecipients", RecipientsOfGoods);
	
	QueryResult = Query.ExecuteBatchWithIntermediateData();
	ExtendedRecipientTable = QueryResult[QueryResult.UBound()].Unload();
	
	If ExtendedRecipientTable.Count() = 0 Then
		RecordSetIsEmpty		= InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
		DataForRenewal = RecordSetIsEmpty.UnloadColumns("Warehouse, Recipient");
		
		Return DataForRenewal;
	Else
		ExtendedRecipientTable.Indexes.Add("ShipAfterShipmentTask");
	EndIf;
	
	RequestTextParameters = ParametersOfQueueQueryText();
	RequestTextParameters.ReissuingQueue = False;
	RequestTextParameters.ShipAfterShipmentTask =
		ExtendedRecipientTable.Find(True, "ShipAfterShipmentTask") <> Undefined;
	RequestTextParameters.ShipWithoutTaskForTransportation =
		ExtendedRecipientTable.Find(False, "ShipAfterShipmentTask") <> Undefined;
	RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
		Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	If RequestTextParameters.ShipAfterShipmentTask Then
		
		If GoodsDeliveryClientServer.UsedDelivery20() Then
			
			AdditionalParameters.TempTableName = "TTTransportTaskBlocked";
			
			InfobaseUpdate.CreateTemporaryTableOfDataProhibitedFromReadingAndEditing(
				Undefined, "Document.TransportationJob", TempTableManager, AdditionalParameters);
			
		Else
			
			AdditionalParameters.TempTableName = "DeliveryIsBlockedOnTT";
			InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
				Undefined,
				"AccumulationRegister.Delivery",
				"ReferenceOrder",
				TempTableManager,
				AdditionalParameters);
			
		EndIf;
		
	EndIf;
	
	DimensionalTypesOfUnits	= Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits();
	ProcedureForProcessingDocuments	= Constants.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.Get();
	IssueInvoicesFirst	=
		ProcedureForProcessingDocuments = Enums.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.InvoicesFirst;
	
	Query.Text = QueryTextDataForQueueFormation(RequestTextParameters);
	
	Query.SetParameter("IssueInvoicesFirst", IssueInvoicesFirst);
	Query.SetParameter("DimensionalTypesOfUnits", DimensionalTypesOfUnits);
	Query.SetParameter("GoodsForIssue",
		AccumulationRegisters.GoodsForIssue.CreateRecordSet().UnloadColumns());
	Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
		RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
	Query.SetParameter("UseTransportationJobsForDeliveryAccountingByCarriers",
		GetFunctionalOption("UseTransportationJobsForDeliveryAccountingByCarriers"));
	
	QueryResult = Query.Execute();
	
	If QueryResult.IsEmpty() Then
		RecordSetIsEmpty		= InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
		DataForRenewal = RecordSetIsEmpty.UnloadColumns("Warehouse, Recipient");
	Else
		DataForRenewal = QueryResult.Unload();
	EndIf;
	
	Return DataForRenewal;
	
EndFunction

// Returns a collection containing information about recipients of goods for which there are no background tasks for reissuing
// spending orders.
// The register of information of the queue for reissuing spending orders is also being updated.
//
// Parameters:
//	Warehouse - CatalogRef.Warehouses - the warehouse for which the operation is performed.
//	QueueHasBeenUpdated - Boolean - a sign of updating the register of information in the queue for reissuing spending orders.
//
// Returns:
//	Array of CatalogRef - a collection containing information about recipients of goods for which there are no background tasks
//								for reissuing spending orders.
//
Function RecipientsForWhichThereIsNoBackgroundTaskForReissuingOrders(Warehouse, QueueHasBeenUpdated) Export
	
	SetPrivilegedMode(True);
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	GoodsIssueNoteReregistrationQueue.Recipient
	|FROM
	|	InformationRegister.GoodsIssueNoteReregistrationQueue AS GoodsIssueNoteReregistrationQueue
	|WHERE
	|	GoodsIssueNoteReregistrationQueue.Warehouse = &Warehouse
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TRUE AS ShipAfterShipmentTask
	|FROM
	|	Catalog.Warehouses CatalogWarehouses
	|
	|WHERE
	|	CatalogWarehouses.Ref = &Warehouse
	|	AND CatalogWarehouses.StartShipmentOnceDeliveryOrderIsCreated";
	
	Query.SetParameter("Warehouse", Warehouse);
	
	QueryResult = Query.ExecuteBatch();
	VerifiableRecipients = QueryResult[QueryResult.UBound() - 1].Unload().UnloadColumn("Recipient");
	
	ThereAreTransactionErrors = False;
	RecipientsWithoutTasks = New Array;
	
	RequestTextParameters = ParametersOfQueueQueryText();
	RequestTextParameters.ReRegistrationOfWarehouseQueue = True;
	RequestTextParameters.ShipAfterShipmentTask = Not QueryResult[QueryResult.UBound()].IsEmpty();
	RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
		Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	DimensionalTypesOfUnits	= Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits();
	ProcedureForProcessingDocuments	= Constants.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.Get();
	IssueInvoicesFirst	= 
		ProcedureForProcessingDocuments = Enums.ProcedureOfInvoiceAndGoodsIssueNoteRegistration.InvoicesFirst;
	
	BeginTransaction();
	
	Try
		Block = New DataLock;
		
		LockItem = Block.Add("InformationRegister.GoodsIssueNoteReregistrationQueue");
		LockItem.SetValue("Warehouse", Warehouse);
		
		LockItem = Block.Add("AccumulationRegister.GoodsForIssue");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.Mode = DataLockMode.Shared;
		
		LockItem = Block.Add("AccumulationRegister.ProductStock");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.Mode = DataLockMode.Shared;
		
		If RequestTextParameters.ShipAfterShipmentTask Then
			LockItem = Block.Add("InformationRegister.GoodsToDeliver");
			LockItem.SetValue("Warehouse", Warehouse);
			LockItem.Mode = DataLockMode.Shared;
			
			LockItem = Block.Add("InformationRegister.StatesAndDetailsOfDelivery");
			LockItem.SetValue("Warehouse", Warehouse);
			LockItem.Mode = DataLockMode.Shared;
			
			LockItem = Block.Add("Document.TransportationJob");
			LockItem.Mode = DataLockMode.Shared;
		EndIf;
		
		Block.Lock();
		
		TempTableManager = New TempTablesManager;
		
		AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
		AdditionalParameters.TempTableName = "TTBlockedGoodsForShipment";
		
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
			Undefined, "AccumulationRegister.GoodsForIssue", "DocumentShipments", TempTableManager, AdditionalParameters);
		
		AdditionalParameters.TempTableName = "TTBlockedGoodsInWarehouses";
		
		InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
			Undefined, "AccumulationRegister.ProductStock", "Warehouse", TempTableManager, AdditionalParameters);
		
		If RequestTextParameters.ShipAfterShipmentTask Then
			
			If GoodsDeliveryClientServer.UsedDelivery20() Then
			
				AdditionalParameters.TempTableName = "TTTransportTaskBlocked";
				
				InfobaseUpdate.CreateTemporaryTableOfDataProhibitedFromReadingAndEditing(
					Undefined, "Document.TransportationJob", TempTableManager, AdditionalParameters);
				
			Else
				
				AdditionalParameters.TempTableName = "DeliveryIsBlockedOnTT";
				InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
					Undefined,
					"AccumulationRegister.Delivery",
					"ReferenceOrder",
					TempTableManager,
					AdditionalParameters);
				
			EndIf;
			
		EndIf;
		
		Query.TempTablesManager = TempTableManager;
		Query.Text = QueueFormationQueryText(RequestTextParameters)
			+ Common.QueryBatchSeparator()
			+ QueryTextForDeletedQueueEntries();
		
		Query.SetParameter("IssueInvoicesFirst", IssueInvoicesFirst);
		Query.SetParameter("DimensionalTypesOfUnits", DimensionalTypesOfUnits);
		Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
			RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
		Query.SetParameter("UseTransportationJobsForDeliveryAccountingByCarriers",
			GetFunctionalOption("UseTransportationJobsForDeliveryAccountingByCarriers"));
		
		QueryResult	= Query.ExecuteBatch();
		RecordsToDelete		= QueryResult[QueryResult.UBound()].Unload();
		RecordsToAdd	= QueryResult[QueryResult.UBound() - 1].Unload();
		
		If RecordsToDelete.Count() > 0 Then
			RecordSet = InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
			RecordSet.Load(RecordsToDelete);
			RecordSet.Write(ReplacementMode.Delete);
		EndIf;
		
		If RecordsToAdd.Count() > 0 Then
			RecordSet = InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
			RecordSet.Load(RecordsToAdd);
			RecordSet.Write(ReplacementMode.Append);
		EndIf;
		
		CommitTransaction();
	Except
		RollbackTransaction();
		
		ThereAreTransactionErrors = True;
		
		EventName = NStr("ru = 'Обновление очереди переоформления расходных ордеров';
						|vi = 'Update queue of goods issue reregistration';
						|en = 'Update queue of goods issue reregistration'; fa = 'Update queue of goods issue reregistration';
						|it = 'Update queue of goods issue reregistration';
						|pl = 'Update queue of goods issue reregistration';
						|tr = 'Çıkış fişlerini yeniden düzenleme kuyruğu güncellemesi'",
						Common.DefaultLanguageCode());
		
		MessageText = NStr("vi = 'Không thể cập nhật thứ tự tạo lại các phiếu xuất kho theo Kho bãi - %1 do: %2';
							|ru = 'Не удалось обновить очередь переоформления расходных ордеров по Складу - %1 по причине: %2';
							|en = 'Cannot update the queue of goods issue reregistration for the ""%1"" warehouse. Reason: %2'; fa = 'Cannot update the queue of goods issue reregistration for the ""%1"" warehouse. Reason: %2';
							|it = 'Cannot update the queue of goods issue reregistration for the ""%1"" warehouse. Reason: %2';
							|pl = 'Cannot update the queue of goods issue reregistration for the ""%1"" warehouse. Reason: %2';
							|tr = 'Ambar - %1 için ambar çıkış fişlerinin yeniden düzenleme kuyruğu şu nedenden dolayı güncellenemedi: %2'");
		MessageText = StrTemplate(MessageText,
									String(Warehouse),
									ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		WriteLogEvent(EventName, EventLogLevel.Error, , , MessageText);
	EndTry;
	
	If Not ThereAreTransactionErrors Then
		FilterOfTasks = New Structure("Key, State", "", BackgroundJobState.Active);
		
		For Each Recipient In VerifiableRecipients Do
			If RecordsToDelete.Find(Recipient, "Recipient") <> Undefined Then
				Continue;
			EndIf;
			
			FilterOfTasks.Key	= "ReissuingSpendingOrders"
									+ String(Warehouse.UUID())
									+ String(Recipient.UUID());
			ActiveTasks		= BackgroundJobs.GetBackgroundJobs(FilterOfTasks);
			
			If ActiveTasks.Count() = 0 Then
				RecipientsWithoutTasks.Add(Recipient);
			EndIf;
		EndDo;
		
		If RecordsToAdd.Count() > 0 Then
			QueueHasBeenUpdated = RecordsToDelete.Count() = 0;
			
			CommonClientServer.SupplementArray(RecipientsWithoutTasks,
														RecordsToAdd.UnloadColumn("Recipient"));
		EndIf;
	EndIf;
	
	Return RecipientsWithoutTasks;
	
EndFunction

Function ParametersOfQueueQueryText()
	
	RequestTextParameters = New Structure;
	RequestTextParameters.Insert("ReissuingQueue", True);
	RequestTextParameters.Insert("ReRegistrationOfWarehouseQueue", False);
	RequestTextParameters.Insert("ShipAfterShipmentTask", False);
	RequestTextParameters.Insert("ShipWithoutTaskForTransportation", False);
	RequestTextParameters.Insert("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving", 0);
	
	Return RequestTextParameters;
	
EndFunction

Function QueryTextDataForQueueFormation(RequestTextParameters)
	
	QueriesTexts = New Array;
	
	If RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		QueriesTexts.Add(QueryTextTTGoodsForExecutionOfExpenditureOrders());
	EndIf;
	
	QueriesTexts.Add(QueryTextRemainingGoodsForShipment(RequestTextParameters));
	QueriesTexts.Add(QueryTextBalanceGoodsInWarehouses());
	QueriesTexts.Add(QueryTextNeedToReissueSpendingOrders(False));
	
	QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	ConditionSelectionByWarehouse =
	"(Warehouse, Recipient) IN
	|					(SELECT
	|						TableOfRecipients.Warehouse,
	|						TableOfRecipients.Recipient
	|					FROM
	|						TableOfRecipients AS TableOfRecipients)";
	
	QueryText = StrReplace(QueryText, "&FilterByWarehouse1", ConditionSelectionByWarehouse);
	
	ConditionSelectionByWarehouse =
	"(Warehouse, Recipient) IN
	|					(SELECT
	|						TableOfRecipients.Warehouse,
	|						TableOfRecipients.Recipient
	|					FROM
	|						TableOfRecipients AS TableOfRecipients
	|					WHERE
	|						TableOfRecipients.ShipAfterShipmentTask)";
	
	QueryText = StrReplace(QueryText, "&WarehouseSelectionByTask", ConditionSelectionByWarehouse);
	
	If GoodsDeliveryClientServer.UsedDelivery25() Then
		
		ConditionSelectionByWarehouseForDelivery =
		"(Sender) IN
		|	(SELECT
		|		TableOfRecipients.Warehouse AS Sender
		|	FROM
		|		TableOfRecipients AS TableOfRecipients
		|	WHERE
		|		TableOfRecipients.ShipAfterShipmentTask)";
		
		QueryText = StrReplace(QueryText, "&SelectionDelivery25ByWarehouseOnAssignment", ConditionSelectionByWarehouseForDelivery);
		
	EndIf;
	
	ConditionSelectionByWarehouse =
	"(Warehouse, Recipient) IN
	|					(SELECT
	|						TableOfRecipients.Warehouse,
	|						TableOfRecipients.Recipient
	|					FROM
	|						TableOfRecipients AS TableOfRecipients
	|					WHERE
	|						NOT TableOfRecipients.ShipAfterShipmentTask)";
	
	QueryText = StrReplace(QueryText, "&SelectionByWarehouseWithoutTask", ConditionSelectionByWarehouse);
	
	If RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		ConditionAcceptableDeviation = "(Warehouse, DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series) IN
		|				(SELECT
		|					Table.Warehouse,
		|					Table.DocumentShipments,
		|					Table.Products,
		|					Table.Characteristic,
		|					Table.Purpose,
		|					Table.ControlledLotReference,
		|					Table.Series
		|				FROM
		|					TTGoodsForExecutionOfExpenditureOrders AS Table)"
	Else
		ConditionAcceptableDeviation = "TRUE";
	EndIf;
	
	QueryText = StrReplace(QueryText, "&ConditionAcceptableDeviation", ConditionAcceptableDeviation);
	
	Return QueryText;
	
EndFunction

Function QueueFormationQueryText(RequestTextParameters)
	
	QueriesTexts = New Array;
	
	If RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		QueriesTexts.Add(QueryTextTTGoodsForExecutionOfExpenditureOrders());
	EndIf;
	
	QueriesTexts.Add(QueryTextRemainingGoodsForShipment(RequestTextParameters));
	QueriesTexts.Add(QueryTextBalanceGoodsInWarehouses());
	QueriesTexts.Add(QueryTextNeedToReissueSpendingOrders());
	QueriesTexts.Add(QueryTextGoodsIssueNoteReregistrationQueue());
	
	QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	If RequestTextParameters.ReRegistrationOfWarehouseQueue Then
		
		ConditionSelectionByWarehouse = "Warehouse = &Warehouse";
		ConditionSelectionByWarehouseDelivery25 = "Sender = &Warehouse";
		
	Else
		
		ConditionSelectionByWarehouse = "TRUE";
		ConditionSelectionByWarehouseDelivery25 = "TRUE";
		
	EndIf;
	
	QueryText = StrReplace(QueryText, "&FilterByWarehouse1", ConditionSelectionByWarehouse);
	QueryText = StrReplace(QueryText, "&WarehouseSelectionDelivery25", ConditionSelectionByWarehouseDelivery25);
	
	If RequestTextParameters.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		ConditionAcceptableDeviation = "(Warehouse, DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series) IN
		|				(SELECT
		|					Table.Warehouse,
		|					Table.DocumentShipments,
		|					Table.Products,
		|					Table.Characteristic,
		|					Table.Purpose,
		|					Table.ControlledLotReference,
		|					Table.Series
		|				FROM
		|					TTGoodsForExecutionOfExpenditureOrders AS Table)"
	Else
		ConditionAcceptableDeviation = "TRUE";
	EndIf;
	
	QueryText = StrReplace(QueryText, "&ConditionAcceptableDeviation", ConditionAcceptableDeviation);
	
	Return QueryText;
	
EndFunction

Function QueryTextTTGoodsForExecutionOfExpenditureOrders()
	
	QueryText =
	"SELECT
	|	TableOfRevolutions.Warehouse				AS Warehouse,
	|	TableOfRevolutions.DocumentShipments	AS DocumentShipments,
	|	TableOfRevolutions.Products		AS Products,
	|	ISNULL(UnitData.MeasuredValueType, UNDEFINED) AS MeasuredValueType,
	|	TableOfRevolutions.Characteristic		AS Characteristic,
	|	TableOfRevolutions.Purpose			AS Purpose,
	|	TableOfRevolutions.ControlledLotReference AS ControlledLotReference,
	|	TableOfRevolutions.Series				AS Series,
	|	TableOfRevolutions.ToShipReceipt		AS Count
	|INTO TableOfRevolutions
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers(
	|			,
	|			,
	|			,
	|			&FilterByWarehouse1
	|			AND NOT DocumentShipments IN
	|					(SELECT
	|						TTBlockedGoodsForShipment.DocumentShipments
	|					FROM
	|						TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment)
	|	) AS TableOfRevolutions
	|		LEFT JOIN Catalog.Products AS ProductData_1
	|		ON TableOfRevolutions.Products = ProductData_1.Ref
	|		
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS UnitData
	|		ON ProductData_1.UnitOfMeasure = UnitData.Ref
	|
	|INDEX BY
	|	Warehouse,
	|	DocumentShipments,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	BalanceTable.Warehouse				AS Warehouse,
	|	BalanceTable.DocumentShipments	AS DocumentShipments,
	|	BalanceTable.Products		AS Products,
	|	BalanceTable.Characteristic		AS Characteristic,
	|	BalanceTable.Purpose			AS Purpose,
	|	BalanceTable.ControlledLotReference AS ControlledLotReference,
	|	BalanceTable.Series				AS Series
	|INTO TTGoodsForExecutionOfExpenditureOrders
	|FROM
	|	AccumulationRegister.GoodsForIssue.Balance(
	|			,
	|			&FilterByWarehouse1
	|			AND (DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series) IN
	|					(SELECT DISTINCT
	|						FilterTable.DocumentShipments,
	|						FilterTable.Products,
	|						FilterTable.Characteristic,
	|						FilterTable.Purpose,
	|						FilterTable.ControlledLotReference,
	|						FilterTable.Series
	|					FROM
	|						TableOfRevolutions AS FilterTable)
	|	) AS BalanceTable
	|		INNER JOIN TableOfRevolutions AS TableOfRevolutions
	|		ON BalanceTable.Warehouse = TableOfRevolutions.Warehouse
	|			AND BalanceTable.DocumentShipments = TableOfRevolutions.DocumentShipments
	|			AND BalanceTable.Products = TableOfRevolutions.Products
	|			AND BalanceTable.Characteristic = TableOfRevolutions.Characteristic
	|			AND BalanceTable.Purpose = TableOfRevolutions.Purpose
	|			AND BalanceTable.ControlledLotReference = TableOfRevolutions.ControlledLotReference
	|			AND BalanceTable.Series = TableOfRevolutions.Series
	|
	|WHERE
	|	BalanceTable.ToShipBalance > CASE
	|			WHEN TableOfRevolutions.MeasuredValueType IN (&DimensionalTypesOfUnits)
	|				THEN TableOfRevolutions.Count * &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100
	|			ELSE 0
	|		END
	|
	|INDEX BY
	|	Warehouse,
	|	DocumentShipments,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series";
	
	Return QueryText;
	
EndFunction

Function QueryTextRemainingGoodsForShipment(RequestTextParameters)
	
	If RequestTextParameters.ReissuingQueue Then
		If RequestTextParameters.ShipAfterShipmentTask Then
			QueryText = QueryTextBalancesOfGoodsToShipToWarehousesWithTransportationTasks();
		Else
			QueryText = QueryTextBalancesOfGoodsToShipToWarehousesWithoutTransportationTasks()
		EndIf;
	Else
		QueriesTexts = New Array;
		
		If RequestTextParameters.ShipAfterShipmentTask Then
			QueryText = QueryTextBalancesOfGoodsToShipToWarehousesWithTransportationTasks(
							"BalanceOfGoodsToShipOnAssignments");
		Else
			QueryText = QueryTextBalanceOfGoodsToShipWithSuffix("BalanceOfGoodsToShipOnAssignments");
		EndIf;
		
		QueriesTexts.Add(QueryText);
		
		If RequestTextParameters.ShipWithoutTaskForTransportation Then
			QueryText = QueryTextBalancesOfGoodsToShipToWarehousesWithoutTransportationTasks(
							"BalanceOfGoodsToShipWithoutTasks");
		Else
			QueryText = QueryTextBalanceOfGoodsToShipWithSuffix("BalanceOfGoodsToShipWithoutTasks");
		EndIf;
		
		QueriesTexts.Add(QueryText);
		
		QueryText =
		"SELECT DISTINCT
		|	GoodsForIssue.Warehouse			AS Warehouse,
		|	GoodsForIssue.Recipient		AS Recipient,
		|	GoodsForIssue.Products	AS Products,
		|	GoodsForIssue.Characteristic	AS Characteristic,
		|	GoodsForIssue.Purpose		AS Purpose,
		|	GoodsForIssue.ControlledLotReference AS ControlledLotReference,
		|	GoodsForIssue.Series			AS Series
		|INTO RemainingGoodsForShipment
		|FROM
		|	BalanceOfGoodsToShipOnAssignments AS GoodsForIssue
		|
		|UNION ALL
		|
		|SELECT DISTINCT
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Recipient,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Purpose,
		|	GoodsForIssue.ControlledLotReference,
		|	GoodsForIssue.Series
		|FROM
		|	BalanceOfGoodsToShipWithoutTasks AS GoodsForIssue
		|
		|INDEX BY
		|	Warehouse,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series";
		
		QueriesTexts.Add(QueryText);
		
		QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	EndIf;
	
	Return QueryText;
	
EndFunction

Function QueryTextGoodsBalancesToBeShippedToWarehousesWithTransportationDeliveryTasks25(TTName)
	
	QueryText =
	"SELECT DISTINCT
	|	BlockedDocuments.DocumentShipments AS DocumentShipments
	|INTO TTBlockedShipmentDocuments
	|FROM
	|	(SELECT
	|		DeliveryIsBlockedOnTT.ReferenceOrder AS DocumentShipments
	|	FROM
	|		DeliveryIsBlockedOnTT AS DeliveryIsBlockedOnTT
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTBlockedGoodsForShipment.DocumentShipments
	|	FROM
	|		TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment) AS BlockedDocuments
	|
	|INDEX BY
	|	DocumentShipments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DeliveryTurnover.Sender AS Warehouse,
	|	ISNULL(FinalLeverageWithoutDeliveryOrder.Recipient, FinalLeverageOnDeliveryOrder.Recipient) AS Recipient,
	|	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	|	DeliveryTurnover.Products AS Products,
	|	DeliveryTurnover.Characteristic AS Characteristic,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.Purpose, PrimaryDataOnDeliveryOrder.Purpose) AS Purpose,
	|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
	|	DeliveryTurnover.Series AS Series,
	|	SUM(DeliveryTurnover.ToDeliverTurnover) AS ToDeliver,
	|	SUM(DeliveryTurnover.ForAssemblyTurnover) AS ItRemainsForAssembly
	|INTO TTDeliveryData
	|FROM
	|	AccumulationRegister.Delivery.Turnovers(
	|			,
	|			,
	|			,
	|			&WarehouseSelectionDelivery25
	|				AND Arm = 1
	|				AND DeliveryType = VALUE(Enum.DeliveryTypes.OutgoingInfo)
	|				AND DeliveryMethod <> VALUE(Enum.TransportMethods25.SelfPickup)
	|				AND NOT ReferenceOrder IN
	|						(SELECT
	|							BlockedShipmentDocuments.DocumentShipments AS DocumentShipments
	|						FROM
	|							TTBlockedShipmentDocuments AS BlockedShipmentDocuments)) AS DeliveryTurnover
	|		LEFT JOIN AccumulationRegister.Delivery AS PrimaryDataWithoutDeliveryOrder
	|		ON DeliveryTurnover.ReferenceOrder = PrimaryDataWithoutDeliveryOrder.ReferenceOrder
	|			AND (NOT DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND DeliveryTurnover.PlanningDocument = PrimaryDataWithoutDeliveryOrder.PlanningDocument
	|			AND DeliveryTurnover.RowCode = PrimaryDataWithoutDeliveryOrder.RowCode
	|			AND (PrimaryDataWithoutDeliveryOrder.PrimaryRegisterRecord)
	|		LEFT JOIN AccumulationRegister.Delivery AS PrimaryDataOnDeliveryOrder
	|		ON DeliveryTurnover.ReferenceOrder = PrimaryDataOnDeliveryOrder.ReferenceOrder
	|			AND (DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND (PrimaryDataOnDeliveryOrder.PlanningDocument = UNDEFINED)
	|			AND DeliveryTurnover.RowCode = PrimaryDataOnDeliveryOrder.RowCode
	|			AND (PrimaryDataOnDeliveryOrder.PrimaryRegisterRecord)
	|		LEFT JOIN AccumulationRegister.Delivery AS FinalLeverageWithoutDeliveryOrder
	|		ON DeliveryTurnover.ReferenceOrder = FinalLeverageWithoutDeliveryOrder.ReferenceOrder
	|			AND (NOT DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND DeliveryTurnover.PlanningDocument = FinalLeverageWithoutDeliveryOrder.PlanningDocument
	|			AND DeliveryTurnover.RowCode = FinalLeverageWithoutDeliveryOrder.RowCode
	|			AND (FinalLeverageWithoutDeliveryOrder.ThisIsFinalArm)
	|			AND (FinalLeverageWithoutDeliveryOrder.OperationLevel IN (10, 15))
	|		LEFT JOIN AccumulationRegister.Delivery AS FinalLeverageOnDeliveryOrder
	|		ON DeliveryTurnover.ReferenceOrder = FinalLeverageOnDeliveryOrder.ReferenceOrder
	|			AND (DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND (FinalLeverageOnDeliveryOrder.PlanningDocument = UNDEFINED)
	|			AND DeliveryTurnover.RowCode = FinalLeverageOnDeliveryOrder.RowCode
	|			AND (FinalLeverageOnDeliveryOrder.ThisIsFinalArm)
	|			AND (FinalLeverageOnDeliveryOrder.OperationLevel IN (10, 15))
	|
	|GROUP BY
	|	ISNULL(FinalLeverageWithoutDeliveryOrder.Recipient, FinalLeverageOnDeliveryOrder.Recipient),
	|	DeliveryTurnover.Sender,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.Purpose, PrimaryDataOnDeliveryOrder.Purpose),
	|	DeliveryTurnover.Series,
	|	DeliveryTurnover.ReferenceOrder,
	|	DeliveryTurnover.Characteristic,
	|	DeliveryTurnover.Products
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsToShipWithoutDelivery.Warehouse AS Warehouse,
	|	GoodsToShipWithoutDelivery.Recipient AS Recipient,
	|	GoodsToShipWithoutDelivery.DocumentShipments AS DocumentShipments,
	|	GoodsToShipWithoutDelivery.Products AS Products,
	|	GoodsToShipWithoutDelivery.Characteristic AS Characteristic,
	|	GoodsToShipWithoutDelivery.Purpose AS Purpose,
	|	GoodsToShipWithoutDelivery.ControlledLotReference AS ControlledLotReference,
	|	GoodsToShipWithoutDelivery.Series AS Series,
	|	SUM(GoodsToShipWithoutDelivery.QuantityToShip) AS QuantityToShip
	|INTO TTGoodsForShipmentReceipt
	|FROM
	|	(SELECT
	|		GoodsForShipmentTurnover.Warehouse AS Warehouse,
	|		GoodsForShipmentTurnover.Recipient AS Recipient,
	|		GoodsForShipmentTurnover.DocumentShipments AS DocumentShipments,
	|		GoodsForShipmentTurnover.Products AS Products,
	|		GoodsForShipmentTurnover.Characteristic AS Characteristic,
	|		GoodsForShipmentTurnover.Purpose AS Purpose,
	|		GoodsForShipmentTurnover.ControlledLotReference AS ControlledLotReference,
	|		GoodsForShipmentTurnover.Series AS Series,
	|		CASE
	|			WHEN GoodsForShipmentTurnover.ToShipExpense < 0
	|				THEN -GoodsForShipmentTurnover.ToShipExpense
	|			ELSE GoodsForShipmentTurnover.ToShipReceipt
	|		END AS QuantityToShip
	|	FROM
	|		AccumulationRegister.GoodsForIssue.Turnovers(
	|				,
	|				,
	|				,
	|				&FilterByWarehouse1
	|					AND NOT DocumentShipments IN
	|							(SELECT
	|								BlockedShipmentDocuments.DocumentShipments AS DocumentShipments
	|							FROM
	|								TTBlockedShipmentDocuments AS BlockedShipmentDocuments)
	|					AND &ConditionAcceptableDeviation) AS GoodsForShipmentTurnover
	|	WHERE
	|		CASE
	|				WHEN GoodsForShipmentTurnover.ToShipExpense < 0
	|					THEN -GoodsForShipmentTurnover.ToShipExpense
	|				ELSE GoodsForShipmentTurnover.ToShipReceipt
	|			END <> 0
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTDeliveryData.Warehouse,
	|		TTDeliveryData.Recipient,
	|		TTDeliveryData.ReferenceOrder,
	|		TTDeliveryData.Products,
	|		TTDeliveryData.Characteristic,
	|		TTDeliveryData.Purpose,
	|		TTDeliveryData.ControlledLotReference,
	|		TTDeliveryData.Series,
	|		-TTDeliveryData.ToDeliver + TTDeliveryData.ItRemainsForAssembly
	|	FROM
	|		TTDeliveryData AS TTDeliveryData) AS GoodsToShipWithoutDelivery
	|
	|GROUP BY
	|	GoodsToShipWithoutDelivery.Warehouse,
	|	GoodsToShipWithoutDelivery.Recipient,
	|	GoodsToShipWithoutDelivery.DocumentShipments,
	|	GoodsToShipWithoutDelivery.Products,
	|	GoodsToShipWithoutDelivery.Characteristic,
	|	GoodsToShipWithoutDelivery.Purpose,
	|	GoodsToShipWithoutDelivery.ControlledLotReference,
	|	GoodsToShipWithoutDelivery.Series
	|
	|HAVING
	|	SUM(GoodsToShipWithoutDelivery.QuantityToShip) <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForShipmentTurnover.Warehouse AS Warehouse,
	|	GoodsForShipmentTurnover.Recipient AS Recipient,
	|	GoodsForShipmentTurnover.DocumentShipments AS DocumentShipments,
	|	GoodsForShipmentTurnover.Products AS Products,
	|	GoodsForShipmentTurnover.Characteristic AS Characteristic,
	|	GoodsForShipmentTurnover.Purpose AS Purpose,
	|	GoodsForShipmentTurnover.ControlledLotReference AS ControlledLotReference,
	|	GoodsForShipmentTurnover.Series AS Series,
	|	GoodsForShipmentTurnover.ToShipExpense AS Count
	|INTO TTGoodsForShipmentExpense
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers(
	|			,
	|			,
	|			,
	|			&FilterByWarehouse1
	|				AND NOT DocumentShipments IN
	|						(SELECT
	|							BlockedShipmentDocuments.DocumentShipments AS DocumentShipments
	|						FROM
	|							TTBlockedShipmentDocuments AS BlockedShipmentDocuments)
	|				AND &ConditionAcceptableDeviation) AS GoodsForShipmentTurnover
	|WHERE
	|	GoodsForShipmentTurnover.ToShipExpense > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssueBalance.Warehouse AS Warehouse,
	|	GoodsForIssueBalance.Recipient AS Recipient,
	|	GoodsForIssueBalance.DocumentShipments AS DocumentShipments,
	|	GoodsForIssueBalance.Products AS Products,
	|	GoodsForIssueBalance.Characteristic AS Characteristic,
	|	GoodsForIssueBalance.Purpose AS Purpose,
	|	GoodsForIssueBalance.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssueBalance.Series AS Series,
	|	GoodsForIssueBalance.ForAssemblyBalance AS ForAssemblyBalance,
	|	GoodsForIssueBalance.AssemblyInProgressBalance + GoodsForIssueBalance.AssembledBalance AS CollectedRemainderIsCollected
	|INTO TTGoodsInProcessOfShipment
	|FROM
	|	AccumulationRegister.GoodsForIssue.Balance(
	|			,
	|			&FilterByWarehouse1
	|				AND NOT DocumentShipments IN
	|						(SELECT
	|							BlockedShipmentDocuments.DocumentShipments AS DocumentShipments
	|						FROM
	|							TTBlockedShipmentDocuments AS BlockedShipmentDocuments)
	|				AND &ConditionAcceptableDeviation) AS GoodsForIssueBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Data.Warehouse AS Warehouse,
	|	Data.Recipient AS Recipient,
	|	Data.DocumentShipments AS DocumentShipments,
	|	Data.Products AS Products,
	|	Data.Characteristic AS Characteristic,
	|	Data.Purpose AS Purpose,
	|	Data.ControlledLotReference AS ControlledLotReference,
	|	Data.Series AS Series,
	|	SUM(Data.ToShipReceipt) AS ToShipReceipt,
	|	SUM(Data.ToShipExpense) AS ToShipExpense,
	|	SUM(Data.CollectedRemainderIsCollected) AS CollectedRemainderIsCollected,
	|	SUM(Data.ForAssemblyBalance) AS ForAssemblyBalance
	|INTO RemainingGoodsForShipment
	|FROM
	|	(SELECT
	|		TTGoodsForShipmentExpense.Warehouse AS Warehouse,
	|		TTGoodsForShipmentExpense.Recipient AS Recipient,
	|		TTGoodsForShipmentExpense.DocumentShipments AS DocumentShipments,
	|		TTGoodsForShipmentExpense.Products AS Products,
	|		TTGoodsForShipmentExpense.Characteristic AS Characteristic,
	|		TTGoodsForShipmentExpense.Purpose AS Purpose,
	|		TTGoodsForShipmentExpense.ControlledLotReference AS ControlledLotReference,
	|		TTGoodsForShipmentExpense.Series AS Series,
	|		0 AS ToShipReceipt,
	|		TTGoodsForShipmentExpense.Count AS ToShipExpense,
	|		0 AS CollectedRemainderIsCollected,
	|		0 AS ForAssemblyBalance
	|	FROM
	|		TTGoodsForShipmentExpense AS TTGoodsForShipmentExpense
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTGoodsInProcessOfShipment.Warehouse,
	|		TTGoodsInProcessOfShipment.Recipient,
	|		TTGoodsInProcessOfShipment.DocumentShipments,
	|		TTGoodsInProcessOfShipment.Products,
	|		TTGoodsInProcessOfShipment.Characteristic,
	|		TTGoodsInProcessOfShipment.Purpose,
	|		TTGoodsInProcessOfShipment.ControlledLotReference,
	|		TTGoodsInProcessOfShipment.Series,
	|		0,
	|		0,
	|		TTGoodsInProcessOfShipment.CollectedRemainderIsCollected,
	|		TTGoodsInProcessOfShipment.ForAssemblyBalance
	|	FROM
	|		TTGoodsInProcessOfShipment AS TTGoodsInProcessOfShipment
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTGoodsForShipmentReceipt.Warehouse,
	|		TTGoodsForShipmentReceipt.Recipient,
	|		TTGoodsForShipmentReceipt.DocumentShipments,
	|		TTGoodsForShipmentReceipt.Products,
	|		TTGoodsForShipmentReceipt.Characteristic,
	|		TTGoodsForShipmentReceipt.Purpose,
	|		TTGoodsForShipmentReceipt.ControlledLotReference,
	|		TTGoodsForShipmentReceipt.Series,
	|		TTGoodsForShipmentReceipt.QuantityToShip,
	|		0,
	|		0,
	|		0
	|	FROM
	|		TTGoodsForShipmentReceipt AS TTGoodsForShipmentReceipt) AS Data
	|
	|GROUP BY
	|	Data.Warehouse,
	|	Data.Recipient,
	|	Data.DocumentShipments,
	|	Data.Products,
	|	Data.Characteristic,
	|	Data.Purpose,
	|	Data.ControlledLotReference,
	|	Data.Series
	|
	|HAVING
	|	(SUM(Data.ForAssemblyBalance) > 0
	|			AND SUM(Data.ToShipReceipt - Data.ToShipExpense - Data.CollectedRemainderIsCollected) < SUM(Data.ForAssemblyBalance)
	|		OR SUM(Data.ToShipReceipt - Data.ToShipExpense - Data.CollectedRemainderIsCollected) > SUM(Data.ForAssemblyBalance))";
	
	If Not IsBlankString(TTName) Then
		
		QueryText = StrReplace(QueryText, "RemainingGoodsForShipment", TTName);
		QueryText = StrReplace(QueryText, "&FilterByWarehouse1", "&WarehouseSelectionByTask");
		QueryText = StrReplace(QueryText, "&WarehouseSelectionDelivery25", "&SelectionDelivery25ByWarehouseOnAssignment");
		
	Else
		
		QueryText = QueryText + "
		|
		|INDEX BY
		|	Warehouse,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series";
		
	EndIf;
	
	Return QueryText;
	
EndFunction

Function QueryTextBalancesOfGoodsToShipToWarehousesWithTransportationTasks(TTName = "")
	
	If GoodsDeliveryClientServer.UsedDelivery25() Then
		
		QueryText = QueryTextGoodsBalancesToBeShippedToWarehousesWithTransportationDeliveryTasks25(TTName);
		Return QueryText;
		
	EndIf;
	
	QueryText =
	"SELECT
	|	CASE
	|		WHEN WaybillGoods.Ref.OrderSales
	|			THEN WaybillGoods.SalesOrder
	|		ELSE WaybillGoods.Ref
	|	END AS DocumentShipments
	|INTO BlockedShipmentDocumentsForTransportationOrder
	|FROM
	|	Document.TransportationJob.References AS TransportationTask
	|		INNER JOIN TTTransportTaskBlocked AS TTTransportTasks
	|		ON TransportationTask.Ref = TTTransportTasks.Ref
	|		
	|		INNER JOIN Document.CustomerInvoice.Goods AS WaybillGoods
	|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
	|
	|UNION ALL
	|
	|SELECT
	|	CASE
	|		WHEN WaybillGoods.Ref.TransferAgainstOrders
	|			THEN WaybillGoods.TransferOrder
	|		ELSE WaybillGoods.Ref
	|	END
	|FROM
	|	Document.TransportationJob.References AS TransportationTask
	|		INNER JOIN TTTransportTaskBlocked AS TTTransportTasks
	|		ON TransportationTask.Ref = TTTransportTasks.Ref
	|		
	|		INNER JOIN Document.InventoryTransfer.Goods AS WaybillGoods
	|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
	|
	|
	|UNION ALL
	|
	|SELECT
	|	WaybillGoods.SalesOrder
	|FROM
	|	Document.TransportationJob.References AS TransportationTask
	|		INNER JOIN TTTransportTaskBlocked AS TTTransportTasks
	|		ON TransportationTask.Ref = TTTransportTasks.Ref
	|		
	|		INNER JOIN Document.GoodsShipmentFromStorage.Goods AS WaybillGoods
	|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
	|WHERE
	|	WaybillGoods.Ref.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToMaterialProvider2_5)
	|
	|UNION ALL
	|
	|SELECT
	|	CASE
	|		WHEN WaybillGoods.Ref.TransferByOrders
	|			THEN WaybillGoods.SalesOrder
	|		ELSE WaybillGoods.Ref
	|	END AS DocumentShipments
	|FROM
	|	Document.TransportationJob.References AS TransportationTask
	|		INNER JOIN TTTransportTaskBlocked AS TTTransportTasks
	|		ON TransportationTask.Ref = TTTransportTasks.Ref
	|		
	|		INNER JOIN Document.TransferOfGoodsToBailee.Goods AS WaybillGoods
	|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
	|
	|UNION ALL
	|
	|SELECT
	|	CASE
	|		WHEN WaybillGoods.Ref.ShipmentByOrders
	|			THEN WaybillGoods.SalesOrder
	|		ELSE WaybillGoods.Ref
	|	END AS DocumentShipments
	|FROM
	|	Document.TransportationJob.References AS TransportationTask
	|		INNER JOIN TTTransportTaskBlocked AS TTTransportTasks
	|		ON TransportationTask.Ref = TTTransportTasks.Ref
	|		
	|		INNER JOIN Document.GoodsShipmentToCustomer.Goods AS WaybillGoods
	|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	NestedQuery.DocumentShipments AS DocumentShipments
	|INTO BlockedShipmentDocuments
	|FROM
	|	(SELECT
	|		ShippingDocuments.DocumentShipments AS DocumentShipments
	|	FROM
	|		BlockedShipmentDocumentsForTransportationOrder AS ShippingDocuments
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTBlockedGoodsForShipment.DocumentShipments
	|	FROM
	|		TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment) AS NestedQuery
	|
	|INDEX BY
	|	DocumentShipments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForShipmentTurnover.Warehouse			AS Warehouse,
	|	GoodsForShipmentTurnover.Recipient		AS Recipient,
	|	GoodsForShipmentTurnover.DocumentShipments	AS DocumentShipments,
	|	GoodsForShipmentTurnover.Products		AS Products,
	|	GoodsForShipmentTurnover.Characteristic	AS Characteristic,
	|	GoodsForShipmentTurnover.Purpose		AS Purpose,
	|	GoodsForShipmentTurnover.ControlledLotReference AS ControlledLotReference,
	|	GoodsForShipmentTurnover.Series			AS Series,
	|	SUM(CASE
	|		WHEN GoodsForShipmentTurnover.ToShipExpense < 0
	|			THEN -GoodsForShipmentTurnover.ToShipExpense
	|		ELSE CASE
	|				WHEN &IssueInvoicesFirst
	|					THEN GoodsForShipmentTurnover.ToShipReceipt - GoodsForShipmentTurnover.ToRegisterReceipt
	|				ELSE GoodsForShipmentTurnover.ToShipReceipt
	|			END
	|	END)									AS QuantityToShip,
	|	CASE
	|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
	|					(VALUE(Enum.TransportMethods.ToCustomer),
	|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|					)
	|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
	|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
	|						(VALUE(Enum.TransportMethods.ByCarrier),
	|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
	|						)
	|					)
	|			THEN TRUE
	|		ELSE FALSE
	|	END									AS ShipmentUnderTransportationJob
	|INTO GoodsForIssue
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers(
	|			,
	|			,
	|			,
	|			&FilterByWarehouse1
	|			AND NOT DocumentShipments IN
	|					(SELECT
	|						TTBlockedGoodsForShipment.DocumentShipments
	|					FROM
	|						BlockedShipmentDocuments AS TTBlockedGoodsForShipment)
	|			AND &ConditionAcceptableDeviation
	|	) AS GoodsForShipmentTurnover
	|		LEFT JOIN InformationRegister.StatesAndDetailsOfDelivery AS StatesAndDetailsOfDelivery
	|		ON StatesAndDetailsOfDelivery.Warehouse = GoodsForShipmentTurnover.Warehouse
	|			AND StatesAndDetailsOfDelivery.ReferenceOrder = GoodsForShipmentTurnover.DocumentShipments
	|
	|WHERE
	|	CASE
	|		WHEN GoodsForShipmentTurnover.ToShipExpense < 0
	|			THEN -GoodsForShipmentTurnover.ToShipExpense
	|		ELSE CASE
	|				WHEN &IssueInvoicesFirst
	|					THEN GoodsForShipmentTurnover.ToShipReceipt - GoodsForShipmentTurnover.ToRegisterReceipt
	|				ELSE GoodsForShipmentTurnover.ToShipReceipt
	|			END
	|	END <> 0
	|
	|GROUP BY
	|	GoodsForShipmentTurnover.Warehouse,
	|	GoodsForShipmentTurnover.Recipient,
	|	GoodsForShipmentTurnover.Products,
	|	GoodsForShipmentTurnover.DocumentShipments,
	|	GoodsForShipmentTurnover.Characteristic,
	|	GoodsForShipmentTurnover.Purpose,
	|	GoodsForShipmentTurnover.ControlledLotReference,
	|	GoodsForShipmentTurnover.Series,
	|	CASE
	|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
	|					(VALUE(Enum.TransportMethods.ToCustomer),
	|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|					)
	|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
	|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
	|						(VALUE(Enum.TransportMethods.ByCarrier),
	|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
	|						)
	|					)
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsForShipmentTurnover.Warehouse					AS Warehouse,
	|	GoodsForShipmentTurnover.Recipient				AS Recipient,
	|	GoodsForShipmentTurnover.DocumentShipments			AS DocumentShipments,
	|	GoodsForShipmentTurnover.Products				AS Products,
	|	GoodsForShipmentTurnover.Characteristic			AS Characteristic,
	|	GoodsForShipmentTurnover.Purpose				AS Purpose,
	|	GoodsForShipmentTurnover.ControlledLotReference		AS ControlledLotReference,
	|	GoodsForShipmentTurnover.Series					AS Series,
	|	SUM(GoodsForShipmentTurnover.ToRegisterExpense)	AS QuantityToShip,
	|	CASE
	|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
	|					(VALUE(Enum.TransportMethods.ToCustomer),
	|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|					)
	|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
	|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
	|						(VALUE(Enum.TransportMethods.ByCarrier),
	|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
	|						)
	|					)
	|			THEN TRUE
	|		ELSE FALSE
	|	END											AS ShipmentUnderTransportationJob
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers(
	|			,
	|			,
	|			,
	|			&FilterByWarehouse1
	|			AND NOT DocumentShipments IN
	|					(SELECT
	|						TTBlockedGoodsForShipment.DocumentShipments
	|					FROM
	|						BlockedShipmentDocuments AS TTBlockedGoodsForShipment)
	|			AND &ConditionAcceptableDeviation
	|	) AS GoodsForShipmentTurnover
	|		LEFT JOIN InformationRegister.StatesAndDetailsOfDelivery AS StatesAndDetailsOfDelivery
	|		ON StatesAndDetailsOfDelivery.Warehouse = GoodsForShipmentTurnover.Warehouse
	|			AND StatesAndDetailsOfDelivery.ReferenceOrder = GoodsForShipmentTurnover.DocumentShipments
	|
	|WHERE
	|	&IssueInvoicesFirst
	|	AND GoodsForShipmentTurnover.ToRegisterExpense <> 0
	|
	|GROUP BY
	|	GoodsForShipmentTurnover.Warehouse,
	|	GoodsForShipmentTurnover.Recipient,
	|	GoodsForShipmentTurnover.Products,
	|	GoodsForShipmentTurnover.DocumentShipments,
	|	GoodsForShipmentTurnover.Characteristic,
	|	GoodsForShipmentTurnover.Purpose,
	|	GoodsForShipmentTurnover.ControlledLotReference,
	|	GoodsForShipmentTurnover.Series,
	|	CASE
	|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
	|					(VALUE(Enum.TransportMethods.ToCustomer),
	|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
	|					)
	|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
	|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
	|						(VALUE(Enum.TransportMethods.ByCarrier),
	|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
	|						)
	|					)
	|			THEN TRUE
	|		ELSE FALSE
	|	END
	|
	|INDEX BY
	|	Warehouse,
	|	DocumentShipments,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssue.Warehouse				AS Warehouse,
	|	GoodsForIssue.Recipient			AS Recipient,
	|	GoodsForIssue.DocumentShipments	AS DocumentShipments,
	|	GoodsForIssue.Products		AS Products,
	|	GoodsForIssue.Characteristic		AS Characteristic,
	|	GoodsForIssue.Purpose			AS Purpose,
	|	GoodsForIssue.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssue.Series				AS Series,
	|	GoodsForIssue.QuantityToShip	AS QuantityToShip,
	|	SUM(CASE
	|			WHEN NOT GoodsForIssue.ShipmentUnderTransportationJob
	|					OR GoodsToDeliver.AllGoods
	|				THEN GoodsForIssue.QuantityToShip
	|			ELSE CASE
	|					WHEN GoodsForIssue.QuantityToShip >= GoodsToDeliver.Count
	|						THEN GoodsToDeliver.Count
	|					ELSE GoodsForIssue.QuantityToShip
	|				END
	|		END)							AS Count
	|INTO GoodsForShipmentAndDelivery
	|FROM
	|	GoodsForIssue AS GoodsForIssue
	|		LEFT JOIN InformationRegister.GoodsToDeliver AS GoodsToDeliver
	|		ON GoodsForIssue.DocumentShipments = GoodsToDeliver.ReferenceOrder
	|			AND GoodsForIssue.Warehouse = GoodsToDeliver.Warehouse
	|			AND (GoodsForIssue.Products = GoodsToDeliver.Products
	|					AND GoodsForIssue.Characteristic = GoodsToDeliver.Characteristic
	|					AND GoodsForIssue.Purpose = GoodsToDeliver.Purpose
	|					AND GoodsForIssue.Series = GoodsToDeliver.Series
	|				OR GoodsToDeliver.AllGoods)
	|			AND GoodsToDeliver.TransportationJob.Posted
	|			AND GoodsToDeliver.TransportationJob.Status <> VALUE(Enum.StatusesOfTransportationJobs.BeingGenerated)
	|			AND GoodsForIssue.ShipmentUnderTransportationJob
	|WHERE
	|	NOT (GoodsForIssue.ShipmentUnderTransportationJob
	|		AND GoodsToDeliver.TransportationJob IS NULL)
	|
	|GROUP BY
	|	GoodsForIssue.Warehouse,
	|	GoodsForIssue.Recipient,
	|	GoodsForIssue.DocumentShipments,
	|	GoodsForIssue.Products,
	|	GoodsForIssue.Characteristic,
	|	GoodsForIssue.Purpose,
	|	GoodsForIssue.ControlledLotReference,
	|	GoodsForIssue.Series,
	|	GoodsForIssue.QuantityToShip
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssue.Warehouse				AS Warehouse,
	|	GoodsForIssue.Recipient			AS Recipient,
	|	GoodsForIssue.DocumentShipments	AS DocumentShipments,
	|	GoodsForIssue.Products		AS Products,
	|	GoodsForIssue.Characteristic		AS Characteristic,
	|	GoodsForIssue.Purpose			AS Purpose,
	|	GoodsForIssue.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssue.Series				AS Series,
	|	GoodsForIssue.ToShipExpense		AS Count
	|INTO GoodsForIssueExpense
	|FROM
	|	AccumulationRegister.GoodsForIssue.Turnovers(
	|			,
	|			,
	|			,
	|			&FilterByWarehouse1
	|			AND NOT DocumentShipments IN
	|					(SELECT
	|						TTBlockedGoodsForShipment.DocumentShipments
	|					FROM
	|						BlockedShipmentDocuments AS TTBlockedGoodsForShipment)
	|			AND &ConditionAcceptableDeviation) AS GoodsForIssue
	|
	|WHERE
	|	GoodsForIssue.ToShipExpense > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssueBalance.Warehouse			AS Warehouse,
	|	GoodsForIssueBalance.Recipient		AS Recipient,
	|	GoodsForIssueBalance.DocumentShipments	AS DocumentShipments,
	|	GoodsForIssueBalance.Products		AS Products,
	|	GoodsForIssueBalance.Characteristic	AS Characteristic,
	|	GoodsForIssueBalance.Purpose		AS Purpose,
	|	GoodsForIssueBalance.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssueBalance.Series			AS Series,
	|	GoodsForIssueBalance.ForAssemblyBalance	AS ForAssemblyBalance,
	|	GoodsForIssueBalance.AssemblyInProgressBalance + GoodsForIssueBalance.AssembledBalance AS CollectedRemainderIsCollected
	|INTO GoodsBeingShipped
	|FROM
	|	AccumulationRegister.GoodsForIssue.Balance(
	|			,
	|			&FilterByWarehouse1
	|			AND NOT DocumentShipments IN
	|					(SELECT
	|						TTBlockedGoodsForShipment.DocumentShipments
	|					FROM
	|						BlockedShipmentDocuments AS TTBlockedGoodsForShipment)
	|			AND &ConditionAcceptableDeviation) AS GoodsForIssueBalance
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssueBalance.Warehouse			AS Warehouse,
	|	GoodsForIssueBalance.Recipient		AS Recipient,
	|	GoodsForIssueBalance.DocumentShipments	AS DocumentShipments,
	|	GoodsForIssueBalance.Products		AS Products,
	|	GoodsForIssueBalance.Characteristic	AS Characteristic,
	|	GoodsForIssueBalance.Purpose		AS Purpose,
	|	GoodsForIssueBalance.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssueBalance.Series			AS Series
	|INTO RemainingGoodsForShipment
	|FROM
	|	(SELECT
	|		GoodsForShipmentAndDelivery.Warehouse				AS Warehouse,
	|		GoodsForShipmentAndDelivery.Recipient			AS Recipient,
	|		GoodsForShipmentAndDelivery.DocumentShipments	AS DocumentShipments,
	|		GoodsForShipmentAndDelivery.Products		AS Products,
	|		GoodsForShipmentAndDelivery.Characteristic		AS Characteristic,
	|		GoodsForShipmentAndDelivery.Purpose			AS Purpose,
	|		GoodsForShipmentAndDelivery.ControlledLotReference AS ControlledLotReference,
	|		GoodsForShipmentAndDelivery.Series				AS Series,
	|		CASE
	|			WHEN GoodsForShipmentAndDelivery.Count < GoodsForShipmentAndDelivery.QuantityToShip
	|				THEN GoodsForShipmentAndDelivery.Count
	|			ELSE GoodsForShipmentAndDelivery.QuantityToShip
	|		END										AS ToShipReceipt,
	|		0											AS ToShipExpense,
	|		0											AS CollectedRemainderIsCollected,
	|		0											AS ForAssemblyBalance
	|	FROM
	|		GoodsForShipmentAndDelivery AS GoodsForShipmentAndDelivery
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		GoodsForIssueExpense.Warehouse,
	|		GoodsForIssueExpense.Recipient,
	|		GoodsForIssueExpense.DocumentShipments,
	|		GoodsForIssueExpense.Products,
	|		GoodsForIssueExpense.Characteristic,
	|		GoodsForIssueExpense.Purpose,
	|		GoodsForIssueExpense.ControlledLotReference,
	|		GoodsForIssueExpense.Series,
	|		0,
	|		GoodsForIssueExpense.Count,
	|		0,
	|		0
	|	FROM
	|		GoodsForIssueExpense AS GoodsForIssueExpense
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		GoodsBeingShipped.Warehouse,
	|		GoodsBeingShipped.Recipient,
	|		GoodsBeingShipped.DocumentShipments,
	|		GoodsBeingShipped.Products,
	|		GoodsBeingShipped.Characteristic,
	|		GoodsBeingShipped.Purpose,
	|		GoodsBeingShipped.ControlledLotReference,
	|		GoodsBeingShipped.Series,
	|		0,
	|		0,
	|		GoodsBeingShipped.CollectedRemainderIsCollected,
	|		GoodsBeingShipped.ForAssemblyBalance
	|	FROM
	|		GoodsBeingShipped AS GoodsBeingShipped
	|	
	|	) AS GoodsForIssueBalance
	|
	|GROUP BY
	|	GoodsForIssueBalance.Warehouse,
	|	GoodsForIssueBalance.Recipient,
	|	GoodsForIssueBalance.DocumentShipments,
	|	GoodsForIssueBalance.Products,
	|	GoodsForIssueBalance.Characteristic,
	|	GoodsForIssueBalance.Purpose,
	|	GoodsForIssueBalance.ControlledLotReference,
	|	GoodsForIssueBalance.Series
	|
	|HAVING
	|	(SUM(GoodsForIssueBalance.ForAssemblyBalance) > 0
	|		AND SUM(GoodsForIssueBalance.ToShipReceipt - GoodsForIssueBalance.ToShipExpense - GoodsForIssueBalance.CollectedRemainderIsCollected) < SUM(GoodsForIssueBalance.ForAssemblyBalance))
	|	OR SUM(GoodsForIssueBalance.ToShipReceipt - GoodsForIssueBalance.ToShipExpense - GoodsForIssueBalance.CollectedRemainderIsCollected) > SUM(GoodsForIssueBalance.ForAssemblyBalance)";
	
	If Not IsBlankString(TTName) Then
		QueryText = StrReplace(QueryText, "RemainingGoodsForShipment", TTName);
		QueryText = StrReplace(QueryText, "&FilterByWarehouse1", "&WarehouseSelectionByTask");
	Else
		QueryText = QueryText + "
		|
		|INDEX BY
		|	Warehouse,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series";
	EndIf;
	
	Return QueryText;
	
EndFunction

Function QueryTextBalancesOfGoodsToShipToWarehousesWithoutTransportationTasks(TTName = "")
	
	QueryText =
	"SELECT
	|	GoodsForIssueBalance.Warehouse			AS Warehouse,
	|	GoodsForIssueBalance.Recipient		AS Recipient,
	|	GoodsForIssueBalance.DocumentShipments	AS DocumentShipments,
	|	GoodsForIssueBalance.Products		AS Products,
	|	GoodsForIssueBalance.Characteristic	AS Characteristic,
	|	GoodsForIssueBalance.Purpose		AS Purpose,
	|	GoodsForIssueBalance.ControlledLotReference AS ControlledLotReference,
	|	GoodsForIssueBalance.Series			AS Series
	|INTO RemainingGoodsForShipment
	|FROM
	|	AccumulationRegister.GoodsForIssue.Balance(
	|			,
	|			&FilterByWarehouse1
	|			AND NOT DocumentShipments IN
	|					(SELECT
	|						TTBlockedGoodsForShipment.DocumentShipments
	|					FROM
	|						TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment)
	|			AND &ConditionAcceptableDeviation) AS GoodsForIssueBalance
	|
	|WHERE
	|	(&IssueInvoicesFirst
	|			AND GoodsForIssueBalance.ToShipBalance - GoodsForIssueBalance.ToRegisterBalance - GoodsForIssueBalance.AssemblyInProgressBalance - GoodsForIssueBalance.AssembledBalance > GoodsForIssueBalance.ForAssemblyBalance
	|		OR NOT &IssueInvoicesFirst
	|			AND GoodsForIssueBalance.ToShipBalance - GoodsForIssueBalance.AssemblyInProgressBalance - GoodsForIssueBalance.AssembledBalance > GoodsForIssueBalance.ForAssemblyBalance)
	|	OR GoodsForIssueBalance.ForAssemblyBalance > 0
	|		AND (&IssueInvoicesFirst
	|				AND GoodsForIssueBalance.ToShipBalance - GoodsForIssueBalance.ToRegisterBalance - GoodsForIssueBalance.AssemblyInProgressBalance - GoodsForIssueBalance.AssembledBalance < GoodsForIssueBalance.ForAssemblyBalance
	|			OR NOT &IssueInvoicesFirst
	|				AND GoodsForIssueBalance.ToShipBalance - GoodsForIssueBalance.AssemblyInProgressBalance - GoodsForIssueBalance.AssembledBalance < GoodsForIssueBalance.ForAssemblyBalance)";
	
	If Not IsBlankString(TTName) Then
		QueryText = StrReplace(QueryText, "RemainingGoodsForShipment", TTName);
		QueryText = StrReplace(QueryText, "&FilterByWarehouse1", "&SelectionByWarehouseWithoutTask");
	Else
		QueryText = QueryText + "
		|
		|INDEX BY
		|	Warehouse,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series";
	EndIf;
	
	Return QueryText;
	
EndFunction

Function QueryTextBalanceOfGoodsToShipWithSuffix(TTName)
	
	QueryText =
	"SELECT
	|	GoodsForIssue.Warehouse				AS Warehouse,
	|	GoodsForIssue.Recipient			AS Recipient,
	|	GoodsForIssue.DocumentShipments	AS DocumentShipments,
	|	GoodsForIssue.Products		AS Products,
