// The procedure sets the conditional design for the Division field in the item's PM.
//
// Parameters:
//  Form - ClientApplicationForm - Form for conditional registration
//  TabularSectionName - String
//  ThereIsWarehouseInTablePart - Boolean
//
Procedure EstablishConditionalAppearanceOfVTCHDivision(Form, TabularSectionName = "Goods", ThereIsWarehouseInTablePart = True, PrefixObject = "Object.") Export

	TypesOfNomenclatureWithUnitAnalytics = SalesServer.TypesOfNomenclatureWithUnitAnalytics();
	
	ConditionalAppearance = Form.ConditionalAppearance;
	Items = Form.Items;
	
	DivisionFormField = Items[TabularSectionName+"Department"]; // FormField
	If ThereIsWarehouseInTablePart Then
		WarehouseFormField = Items[TabularSectionName+"Warehouse"]; // FormField
	EndIf;
	
	// Setting the mark of an unfilled division, if the Work

	Item = ConditionalAppearance.Items.Add();

	ItemField = Item.Fields.Items.Add();
	ItemField.Field = New DataCompositionField(DivisionFormField.Name);

	ItemFilter = Item.Filter.Items.Add(Type("DataCompositionFilterItem"));
	ItemFilter.LeftValue = New DataCompositionField(PrefixObject + TabularSectionName+".Department");
	ItemFilter.ComparisonType = DataCompositionComparisonType.NotFilled;
	
	ItemFilter = Item.Filter.Items.Add(Type("DataCompositionFilterItem"));
	ItemFilter.LeftValue = New DataCompositionField(PrefixObject + TabularSectionName+".ItemsType");
	ItemFilter.ComparisonType = DataCompositionComparisonType.InList;
	ItemFilter.RightValue = TypesOfNomenclatureWithUnitAnalytics;
	
	ItemFilter = Item.Filter.Items.Add(Type("DataCompositionFilterItem"));
	ItemFilter.LeftValue = New DataCompositionField("SalesViaCommissionAgent");
	ItemFilter.ComparisonType = DataCompositionComparisonType.NotEqual;
	ItemFilter.RightValue = True;
		
		Item.Appearance.SetParameterValue("MarkIncomplete", True);
		
	// Registration of the warehouse and division
	// disabling the visibility of the warehouse, if the work or service.

	If ThereIsWarehouseInTablePart Then
		
		Item = ConditionalAppearance.Items.Add();

		ItemField = Item.Fields.Items.Add();
		ItemField.Field = New DataCompositionField(WarehouseFormField.Name);

		ItemFilter = Item.Filter.Items.Add(Type("DataCompositionFilterItem"));
		ItemFilter.LeftValue = New DataCompositionField(PrefixObject + TabularSectionName+".ItemsType");
		ItemFilter.ComparisonType = DataCompositionComparisonType.InList;
		ItemFilter.RightValue = TypesOfNomenclatureWithUnitAnalytics;

		Item.Appearance.SetParameterValue("Visible", False);
		
	EndIf;
	
	// disabling the visibility of the unit if NOT Working

	If ThereIsWarehouseInTablePart Then
		
		Item = ConditionalAppearance.Items.Add();

		ItemField = Item.Fields.Items.Add();
		ItemField.Field = New DataCompositionField(DivisionFormField.Name);

		FilterGroup = Item.Filter.Items.Add(Type("DataCompositionFilterItemGroup"));
		FilterGroup.GroupType = DataCompositionFilterItemsGroupType.AndGroup;

		ItemFilter = FilterGroup.Items.Add(Type("DataCompositionFilterItem"));
		ItemFilter.LeftValue = New DataCompositionField(PrefixObject + TabularSectionName+".ItemsType");
		ItemFilter.ComparisonType = DataCompositionComparisonType.NotInList;
		ItemFilter.RightValue = TypesOfNomenclatureWithUnitAnalytics;

		ItemFilter = FilterGroup.Items.Add(Type("DataCompositionFilterItem"));
		ItemFilter.LeftValue = New DataCompositionField("WarehouseGroup_");
		ItemFilter.ComparisonType = DataCompositionComparisonType.Equal;
		ItemFilter.RightValue = True;
		
		Item.Appearance.SetParameterValue("Visible", False);

	EndIf;
	
	// explanatory inscription for the division, if the warehouses are not in the tabular part

	Item = ConditionalAppearance.Items.Add();

	ItemField = Item.Fields.Items.Add();
	ItemField.Field = New DataCompositionField(DivisionFormField.Name);

	ItemFilter = Item.Filter.Items.Add(Type("DataCompositionFilterItem"));
	ItemFilter.LeftValue = New DataCompositionField(PrefixObject + TabularSectionName+".ItemsType");
	ItemFilter.ComparisonType = DataCompositionComparisonType.NotInList;
	ItemFilter.RightValue = TypesOfNomenclatureWithUnitAnalytics;

	If ThereIsWarehouseInTablePart Then
		ItemFilter = Item.Filter.Items.Add(Type("DataCompositionFilterItem"));
		ItemFilter.LeftValue = New DataCompositionField("WarehouseGroup_");
		ItemFilter.ComparisonType = DataCompositionComparisonType.Equal;
		ItemFilter.RightValue = False;
	EndIf;
	
	Item.Appearance.SetParameterValue("ReadOnly", True);
	Item.Appearance.SetParameterValue("Text", NStr("vi = '<dành cho công việc>';
													|ru = '<для работ>';
													|en = '<for works>'; fa = '<for works>';
													|it = '<per i lavori>';
													|pl = '<dla robót>';
													|tr = '<iş için>'"));
	Item.Appearance.SetParameterValue("TextColor", StyleColors.InaccessibleCellTextColor);
	
EndProcedure
 
