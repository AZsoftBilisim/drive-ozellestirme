//  Array - array of status values.
//
Function StatusesOfCanceledOrders() Export
	
	StatusesList = New Array();
	StatusesList.Add(Enums.AssemblyAndDeliveryStatuses.RolledBack_);

	Return StatusesList;
	
EndFunction

