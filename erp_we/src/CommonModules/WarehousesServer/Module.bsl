Function CalculateGoodsForIssuingSpendingOrders(Parameters, StartShipmentOnceDeliveryOrderIsCreated, IssueInvoicesFirst)
	
	TempTableManager = New TempTablesManager;
	
	AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
	AdditionalParameters.TempTableName = "TTBlockedGoodsForShipment";
	
	InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
		Undefined, "AccumulationRegister.GoodsForIssue", "DocumentShipments", TempTableManager, AdditionalParameters);
	
	AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
		Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
	
	QueriesTexts = New Array;
	
	If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		QueryText =
		"SELECT
		|	TableOfRevolutions.Warehouse					AS Warehouse,
		|	TableOfRevolutions.DocumentShipments		AS DocumentShipments,
		|	TableOfRevolutions.Products			AS Products,
		|	CASE
		|		WHEN UnitData.MeasuredValueType IS NULL
		|			THEN UNDEFINED
		|		ELSE UnitData.MeasuredValueType
		|	END									AS MeasuredValueType,
		|	TableOfRevolutions.Characteristic			AS Characteristic,
		|	TableOfRevolutions.Purpose				AS Purpose,
		|	TableOfRevolutions.ControlledLotReference	AS ControlledLotReference,
		|	TableOfRevolutions.Series					AS Series,
		|	TableOfRevolutions.ToShipReceipt			AS Count
		|INTO TableOfRevolutions
		|FROM
		|	AccumulationRegister.GoodsForIssue.Turnovers(
		|			,
		|			,
		|			,
		|			Warehouse = &Warehouse
		|			AND Recipient = &Recipient
		|			AND (&ByAllReferences
		|				OR DocumentShipments IN (&ShipmentReferences))
		|			AND NOT DocumentShipments IN
		|					(SELECT
		|						TTBlockedGoodsForShipment.DocumentShipments
		|					FROM
		|						TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment)
		|	) AS TableOfRevolutions
		|		LEFT JOIN Catalog.Products AS ProductData_1
		|		ON TableOfRevolutions.Products = ProductData_1.Ref
		|		
		|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS UnitData
		|		ON ProductData_1.UnitOfMeasure = UnitData.Ref
		|
		|INDEX BY
		|	Warehouse,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	BalanceTable.Warehouse					AS Warehouse,
		|	BalanceTable.DocumentShipments		AS DocumentShipments,
		|	BalanceTable.Products			AS Products,
		|	BalanceTable.Characteristic			AS Characteristic,
		|	BalanceTable.Purpose				AS Purpose,
		|	BalanceTable.ControlledLotReference	AS ControlledLotReference,
		|	BalanceTable.Series					AS Series,
		|	CASE
		|		WHEN TableOfRevolutions.MeasuredValueType IN (&DimensionalTypesOfUnits)
		|			THEN TableOfRevolutions.Count * &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100
		|		ELSE 0
		|	END									AS AllowableVariance
		|INTO TTGoodsForExecutionOfExpenditureOrders
		|FROM
		|	AccumulationRegister.GoodsForIssue.Balance(
		|			,
		|			Recipient = &Recipient
		|			AND (Warehouse, DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series) IN
		|					(SELECT DISTINCT
		|						FilterTable.Warehouse,
		|						FilterTable.DocumentShipments,
		|						FilterTable.Products,
		|						FilterTable.Characteristic,
		|						FilterTable.Purpose,
		|						FilterTable.ControlledLotReference,
		|						FilterTable.Series
		|					FROM
		|						TableOfRevolutions AS FilterTable)
		|	) AS BalanceTable
		|		INNER JOIN TableOfRevolutions AS TableOfRevolutions
		|		ON BalanceTable.Warehouse = TableOfRevolutions.Warehouse
		|			AND BalanceTable.DocumentShipments = TableOfRevolutions.DocumentShipments
		|			AND BalanceTable.Products = TableOfRevolutions.Products
		|			AND BalanceTable.Characteristic = TableOfRevolutions.Characteristic
		|			AND BalanceTable.Purpose = TableOfRevolutions.Purpose
		|			AND BalanceTable.ControlledLotReference = TableOfRevolutions.ControlledLotReference
		|			AND BalanceTable.Series = TableOfRevolutions.Series
		|
		|WHERE
		|	BalanceTable.ToShipBalance > CASE
		|			WHEN TableOfRevolutions.MeasuredValueType IN (&DimensionalTypesOfUnits)
		|				THEN TableOfRevolutions.Count * &AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100
		|			ELSE 0
		|		END
		|
		|INDEX BY
		|	Warehouse,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series";
		QueriesTexts.Add(QueryText);
	EndIf;
	
	If Not StartShipmentOnceDeliveryOrderIsCreated Then
		
		#Region NotStartShipmentOnceDeliveryOrderIsCreated
		
		QueryText =
		// GoodsToBeShippedAndProcessed
		"SELECT
		|	GoodsForIssue.Warehouse								AS Warehouse,
		|	CASE
		|		WHEN GoodsForIssue.Recipient IN (&EmptyRecipient)
		|			THEN GoodsForIssue.DocumentShipments
		|		ELSE GoodsForIssue.Recipient
		|	END												AS Recipient,
		|	GoodsForIssue.DocumentShipments					AS DocumentShipments,
		|	GoodsForIssue.Products						AS Products,
		|	GoodsForIssue.Characteristic						AS Characteristic,
		|	GoodsForIssue.Purpose							AS Purpose,
		|	GoodsForIssue.ControlledLotReference				AS ControlledLotReference,
		|	GoodsForIssue.Series								AS Series
		|INTO GoodsForIssueBalance
		|FROM
		|	AccumulationRegister.GoodsForIssue.Balance(
		|			,
		|			Warehouse = &Warehouse
		|			AND Recipient = &Recipient
		|			AND (&ByAllReferences
		|				OR DocumentShipments IN (&ShipmentReferences))
		|			AND NOT DocumentShipments IN
		|					(SELECT
		|						TTBlockedGoodsForShipment.DocumentShipments
		|					FROM
		|						TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment)
		|			AND &ConditionAcceptableDeviation
		|	
		|	) AS GoodsForIssue
		|
		|WHERE
		|	CASE
		|		WHEN &IssueInvoicesFirst
		|			THEN GoodsForIssue.ToShipBalance - GoodsForIssue.ToRegisterBalance
		|					- GoodsForIssue.AssemblyInProgressBalance - GoodsForIssue.AssembledBalance
		|					- GoodsForIssue.ForAssemblyBalance
		|		ELSE GoodsForIssue.ToShipBalance - GoodsForIssue.AssemblyInProgressBalance
		|				- GoodsForIssue.AssembledBalance - GoodsForIssue.ForAssemblyBalance
		|	END <> 0
		|
		|INDEX BY
		|	Warehouse,
		|	Recipient,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// GoodsForShipmentTurnover
		|SELECT
		|	GoodsForIssue.Period								AS Period,
		|	GoodsForIssue.Warehouse								AS Warehouse,
		|	CASE
		|		WHEN GoodsForIssue.Recipient IN (&EmptyRecipient)
		|			THEN GoodsForIssue.DocumentShipments
		|		ELSE GoodsForIssue.Recipient
		|	END												AS Recipient,
		|	GoodsForIssue.DocumentShipments					AS DocumentShipments,
		|	GoodsForIssue.Products						AS Products,
		|	GoodsForIssue.Characteristic						AS Characteristic,
		|	GoodsForIssue.Purpose							AS Purpose,
		|	GoodsForIssue.ControlledLotReference				AS ControlledLotReference,
		|	GoodsForIssue.Series								AS Series,
		|	CASE
		|		WHEN GoodsForIssue.ToShipExpense < 0
		|			THEN -GoodsForIssue.ToShipExpense
		|		ELSE CASE
		|				WHEN &IssueInvoicesFirst
		|					THEN GoodsForIssue.ToShipReceipt - GoodsForIssue.ToRegisterReceipt
		|				ELSE GoodsForIssue.ToShipReceipt
		|			END
		|	END												AS QuantityToShipReceipt,
		|	CASE
		|		WHEN &IssueInvoicesFirst
		|			THEN GoodsForIssue.ToRegisterExpense
		|		ELSE 0
		|	END												AS QuantityToRegisterExpense,
		|	GoodsForIssue.ToShipExpense						AS QuantityToShipExpense,
		|	GoodsForIssue.ForAssemblyReceipt						AS QuantityToBuildReceipt,
		|	GoodsForIssue.AssemblyInProgressReceipt
		|		+ GoodsForIssue.AssembledReceipt					AS QuantityInAssemblyReceipt,
		|	CASE
		|		WHEN &UsedDelivery25
		|			THEN FALSE
		|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
		|					(VALUE(Enum.TransportMethods.ToCustomer),
		|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
		|					)
		|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
		|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
		|						(VALUE(Enum.TransportMethods.ByCarrier),
		|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
		|						)
		|					)
		|			THEN TRUE
		|		ELSE FALSE
		|	END												AS ShipmentUnderTransportationJob,
		|	UNDEFINED										AS TransportationJob
		|INTO GoodsForShipmentTurnover
		|FROM
		|	AccumulationRegister.GoodsForIssue.Turnovers(
		|			,
		|			,
		|			Day,
		|			Warehouse = &Warehouse
		|			AND Recipient = &Recipient
		|			AND (&ByAllReferences
		|				OR DocumentShipments IN (&ShipmentReferences))
		|			AND NOT DocumentShipments IN
		|					(SELECT
		|						TTBlockedGoodsForShipment.DocumentShipments
		|					FROM
		|						TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment)
		|			AND &ConditionAcceptableDeviation
		|	
		|	) AS GoodsForIssue
		|		LEFT JOIN InformationRegister.StatesAndDetailsOfDelivery AS StatesAndDetailsOfDelivery
		|		ON GoodsForIssue.Warehouse = StatesAndDetailsOfDelivery.Warehouse
		|			AND GoodsForIssue.DocumentShipments = StatesAndDetailsOfDelivery.ReferenceOrder
		|			AND NOT &UsedDelivery25
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// The product is a cargo receipt/Merchandise Formationspend
		|SELECT
		|	GoodsForIssue.Period							AS Period,
		|	GoodsForIssue.Warehouse							AS Warehouse,
		|	GoodsForIssue.Recipient						AS Recipient,
		|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|	GoodsForIssue.Products					AS Products,
		|	GoodsForIssue.Characteristic					AS Characteristic,
		|	GoodsForIssue.Purpose						AS Purpose,
		|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|	GoodsForIssue.Series							AS Series,
		|	SUM(GoodsForIssue.Count)				AS Count,
		|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
		|	GoodsForIssue.TransportationJob				AS TransportationJob
		|INTO TTGoodsForShipment
		|FROM
		|	(SELECT
		|		GoodsForIssue.Period							AS Period,
		|		GoodsForIssue.Warehouse							AS Warehouse,
		|		GoodsForIssue.Recipient						AS Recipient,
		|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|		GoodsForIssue.Products					AS Products,
		|		GoodsForIssue.Characteristic					AS Characteristic,
		|		GoodsForIssue.Purpose						AS Purpose,
		|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|		GoodsForIssue.Series							AS Series,
		|		GoodsForIssue.QuantityToShipReceipt		AS Count,
		|		GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
		|		GoodsForIssue.TransportationJob				AS TransportationJob
		|	FROM
		|		GoodsForShipmentTurnover AS GoodsForIssue
		|	WHERE
		|		GoodsForIssue.QuantityToShipReceipt <> 0
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		GoodsForIssue.Period							AS Period,
		|		GoodsForIssue.Warehouse							AS Warehouse,
		|		GoodsForIssue.Recipient						AS Recipient,
		|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|		GoodsForIssue.Products					AS Products,
		|		GoodsForIssue.Characteristic					AS Characteristic,
		|		GoodsForIssue.Purpose						AS Purpose,
		|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|		GoodsForIssue.Series							AS Series,
		|		GoodsForIssue.QuantityToRegisterExpense		AS Count,
		|		GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
		|		GoodsForIssue.TransportationJob				AS TransportationJob
		|	FROM
		|		GoodsForShipmentTurnover AS GoodsForIssue
		|	WHERE
		|		GoodsForIssue.QuantityToRegisterExpense <> 0
		|	
		|	) AS GoodsForIssue
		|		INNER JOIN GoodsForIssueBalance AS GoodsForIssueBalance
		|		ON GoodsForIssue.Warehouse = GoodsForIssueBalance.Warehouse
		|			AND GoodsForIssue.Recipient = GoodsForIssueBalance.Recipient
		|			AND GoodsForIssue.DocumentShipments = GoodsForIssueBalance.DocumentShipments
		|			AND GoodsForIssue.Products = GoodsForIssueBalance.Products
		|			AND GoodsForIssue.Characteristic = GoodsForIssueBalance.Characteristic
		|			AND GoodsForIssue.Purpose = GoodsForIssueBalance.Purpose
		|			AND GoodsForIssue.ControlledLotReference = GoodsForIssueBalance.ControlledLotReference
		|			AND GoodsForIssue.Series = GoodsForIssueBalance.Series
		|
		|GROUP BY
		|	GoodsForIssue.Period,
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Recipient,
		|	GoodsForIssue.DocumentShipments,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Purpose,
		|	GoodsForIssue.ControlledLotReference,
		|	GoodsForIssue.Series,
		|	GoodsForIssue.ShipmentUnderTransportationJob,
		|	GoodsForIssue.TransportationJob
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsForIssue.Period							AS Period,
		|	GoodsForIssue.Warehouse							AS Warehouse,
		|	GoodsForIssue.Recipient						AS Recipient,
		|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|	GoodsForIssue.Products					AS Products,
		|	GoodsForIssue.Characteristic					AS Characteristic,
		|	GoodsForIssue.Purpose						AS Purpose,
		|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|	GoodsForIssue.Series							AS Series,
		|	GoodsForIssue.Count						AS Count,
		|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
		|	GoodsForIssue.TransportationJob				AS TransportationJob,
		|	&AcceptableDeviationValue					AS AllowableVariance
		|INTO GoodsForIssue
		|FROM
		|	TTGoodsForShipment AS GoodsForIssue
		|		,&SVTCompoundOfPermissibleDeviations AS T
		|
		|INDEX BY
		|	Period,
		|	Warehouse,
		|	Recipient,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTGoodsForShipment
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// Cotgruzkerreferences/Collecting a sign-in + Collecting a sign-in
		|SELECT
		|	GoodsForIssue.Period							AS Period,
		|	GoodsForIssue.Warehouse							AS Warehouse,
		|	GoodsForIssue.Recipient						AS Recipient,
		|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|	GoodsForIssue.Products					AS Products,
		|	GoodsForIssue.Characteristic					AS Characteristic,
		|	GoodsForIssue.Purpose						AS Purpose,
		|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|	GoodsForIssue.Series							AS Series,
		|	SUM(GoodsForIssue.Count)				AS Count
		|INTO GoodsToBeDeducted
		|FROM
		|	(SELECT
		|		GoodsForIssue.Period							AS Period,
		|		GoodsForIssue.Warehouse							AS Warehouse,
		|		GoodsForIssue.Recipient						AS Recipient,
		|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|		GoodsForIssue.Products					AS Products,
		|		GoodsForIssue.Characteristic					AS Characteristic,
		|		GoodsForIssue.Purpose						AS Purpose,
		|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|		GoodsForIssue.Series							AS Series,
		|		GoodsForIssue.QuantityToShipExpense		AS Count
		|	FROM
		|		GoodsForShipmentTurnover AS GoodsForIssue
		|	WHERE
		|		GoodsForIssue.QuantityToShipExpense > 0
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		GoodsForIssue.Period							AS Period,
		|		GoodsForIssue.Warehouse							AS Warehouse,
		|		GoodsForIssue.Recipient						AS Recipient,
		|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|		GoodsForIssue.Products					AS Products,
		|		GoodsForIssue.Characteristic					AS Characteristic,
		|		GoodsForIssue.Purpose						AS Purpose,
		|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|		GoodsForIssue.Series							AS Series,
		|		GoodsForIssue.QuantityInAssemblyReceipt			AS Count
		|	FROM
		|		GoodsForShipmentTurnover AS GoodsForIssue
		|	WHERE
		|		GoodsForIssue.QuantityInAssemblyReceipt > 0
		|	
		|	) GoodsForIssue
		|		INNER JOIN GoodsForIssueBalance AS GoodsForIssueBalance
		|		ON GoodsForIssue.Warehouse = GoodsForIssueBalance.Warehouse
		|			AND GoodsForIssue.Recipient = GoodsForIssueBalance.Recipient
		|			AND GoodsForIssue.DocumentShipments = GoodsForIssueBalance.DocumentShipments
		|			AND GoodsForIssue.Products = GoodsForIssueBalance.Products
		|			AND GoodsForIssue.Characteristic = GoodsForIssueBalance.Characteristic
		|			AND GoodsForIssue.Purpose = GoodsForIssueBalance.Purpose
		|			AND GoodsForIssue.ControlledLotReference = GoodsForIssueBalance.ControlledLotReference
		|			AND GoodsForIssue.Series = GoodsForIssueBalance.Series
		|
		|GROUP BY
		|	GoodsForIssue.Period,
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Recipient,
		|	GoodsForIssue.DocumentShipments,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Purpose,
		|	GoodsForIssue.ControlledLotReference,
		|	GoodsForIssue.Series
		|
		|INDEX BY
		|	Period,
		|	Warehouse,
		|	Recipient,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// ForAssemblyReceipt
		|SELECT
		|	GoodsForIssue.Period					AS Period,
		|	GoodsForIssue.Warehouse					AS Warehouse,
		|	GoodsForIssue.Recipient				AS Recipient,
		|	GoodsForIssue.DocumentShipments		AS DocumentShipments,
		|	GoodsForIssue.Products			AS Products,
		|	GoodsForIssue.Characteristic			AS Characteristic,
		|	GoodsForIssue.Purpose				AS Purpose,
		|	GoodsForIssue.ControlledLotReference	AS ControlledLotReference,
		|	GoodsForIssue.Series					AS Series,
		|	GoodsForIssue.QuantityToBuildReceipt	AS Count,
		|	GoodsForIssue.TransportationJob		AS TransportationJob
		|INTO ProductsReadyForAssembly
		|FROM
		|	GoodsForShipmentTurnover AS GoodsForIssue
		|		INNER JOIN GoodsForIssueBalance AS GoodsForIssueBalance
		|		ON GoodsForIssue.Warehouse = GoodsForIssueBalance.Warehouse
		|			AND GoodsForIssue.Recipient = GoodsForIssueBalance.Recipient
		|			AND GoodsForIssue.DocumentShipments = GoodsForIssueBalance.DocumentShipments
		|			AND GoodsForIssue.Products = GoodsForIssueBalance.Products
		|			AND GoodsForIssue.Characteristic = GoodsForIssueBalance.Characteristic
		|			AND GoodsForIssue.Purpose = GoodsForIssueBalance.Purpose
		|			AND GoodsForIssue.ControlledLotReference = GoodsForIssueBalance.ControlledLotReference
		|			AND GoodsForIssue.Series = GoodsForIssueBalance.Series
		|
		|WHERE
		|	GoodsForIssue.QuantityToBuildReceipt > 0
		|
		|INDEX BY
		|	Period,
		|	Warehouse,
		|	Recipient,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	GoodsForIssue.Period							AS Period,
		|	GoodsForIssue.Warehouse							AS Warehouse,
		|	GoodsForIssue.Recipient						AS Recipient,
		|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|	GoodsForIssue.Products					AS Products,
		|	GoodsForIssue.Characteristic					AS Characteristic,
		|	GoodsForIssue.Purpose						AS Purpose,
		|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|	GoodsForIssue.Series							AS Series,
		|	GoodsForIssue.Count						AS Count,
		|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
		|	GoodsForIssue.TransportationJob				AS TransportationJob,
		|	GoodsForIssue.AllowableVariance			AS AllowableVariance
		|FROM
		|	GoodsForIssue AS GoodsForIssue
		|
		|ORDER BY
		|	Period
		|
		|TOTALS BY
		|	TransportationJob,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	TTProducts_1.Period					AS Period,
		|	TTProducts_1.Warehouse					AS Warehouse,
		|	TTProducts_1.Recipient				AS Recipient,
		|	TTProducts_1.DocumentShipments		AS DocumentShipments,
		|	TTProducts_1.Products			AS Products,
		|	TTProducts_1.Characteristic			AS Characteristic,
		|	TTProducts_1.Purpose				AS Purpose,
		|	TTProducts_1.ControlledLotReference	AS ControlledLotReference,
		|	TTProducts_1.Series					AS Series,
		|	GoodsToBeDeducted.Count		AS Count,
		|	TTProducts_1.ShipmentPeriod			AS ShipmentPeriod
		|FROM
		|	(SELECT
		|		GoodsToBeDeducted.Period					AS Period,
		|		GoodsToBeDeducted.Warehouse					AS Warehouse,
		|		GoodsToBeDeducted.Recipient				AS Recipient,
		|		GoodsToBeDeducted.DocumentShipments		AS DocumentShipments,
		|		GoodsToBeDeducted.Products			AS Products,
		|		GoodsToBeDeducted.Characteristic			AS Characteristic,
		|		GoodsToBeDeducted.Purpose				AS Purpose,
		|		GoodsToBeDeducted.ControlledLotReference	AS ControlledLotReference,
		|		GoodsToBeDeducted.Series					AS Series,
		|		MAX(CASE
		|			WHEN GoodsForIssue.Period IS NULL
		|				THEN GoodsToBeDeducted.Period
		|			ELSE GoodsForIssue.Period
		|		END)									AS ShipmentPeriod
		|	FROM
		|		GoodsToBeDeducted AS GoodsToBeDeducted
		|			LEFT JOIN GoodsForIssue AS GoodsForIssue
		|			ON GoodsToBeDeducted.Warehouse = GoodsForIssue.Warehouse
		|				AND GoodsToBeDeducted.Recipient = GoodsForIssue.Recipient
		|				AND GoodsToBeDeducted.DocumentShipments = GoodsForIssue.DocumentShipments
		|				AND GoodsToBeDeducted.Products = GoodsForIssue.Products
		|				AND GoodsToBeDeducted.Characteristic = GoodsForIssue.Characteristic
		|				AND GoodsToBeDeducted.Purpose = GoodsForIssue.Purpose
		|				AND GoodsToBeDeducted.ControlledLotReference = GoodsForIssue.ControlledLotReference
		|				AND GoodsToBeDeducted.Series = GoodsForIssue.Series
		|				AND GoodsToBeDeducted.Period >= GoodsForIssue.Period
		|	
		|	GROUP BY
		|		GoodsToBeDeducted.Period,
		|		GoodsToBeDeducted.Warehouse,
		|		GoodsToBeDeducted.Recipient,
		|		GoodsToBeDeducted.DocumentShipments,
		|		GoodsToBeDeducted.Products,
		|		GoodsToBeDeducted.Characteristic,
		|		GoodsToBeDeducted.Purpose,
		|		GoodsToBeDeducted.ControlledLotReference,
		|		GoodsToBeDeducted.Series
		|	
		|	) AS TTProducts_1
		|		INNER JOIN GoodsToBeDeducted AS GoodsToBeDeducted
		|		ON TTProducts_1.Warehouse = GoodsToBeDeducted.Warehouse
		|			AND TTProducts_1.Recipient = GoodsToBeDeducted.Recipient
		|			AND TTProducts_1.DocumentShipments = GoodsToBeDeducted.DocumentShipments
		|			AND TTProducts_1.Products = GoodsToBeDeducted.Products
		|			AND TTProducts_1.Characteristic = GoodsToBeDeducted.Characteristic
		|			AND TTProducts_1.Purpose = GoodsToBeDeducted.Purpose
		|			AND TTProducts_1.ControlledLotReference = GoodsToBeDeducted.ControlledLotReference
		|			AND TTProducts_1.Series = GoodsToBeDeducted.Series
		|			AND TTProducts_1.Period = GoodsToBeDeducted.Period
