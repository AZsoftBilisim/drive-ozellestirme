		|	TTProducts_1.Characteristic			AS Characteristic,
		|	TTProducts_1.Purpose				AS Purpose,
		|	TTProducts_1.ControlledLotReference	AS ControlledLotReference,
		|	TTProducts_1.Series					AS Series,
		|	ProductsReadyForAssembly.Count		AS Count,
		|	TTProducts_1.ShipmentPeriod			AS ShipmentPeriod,
		|	FALSE							AS ShipmentUnderTransportationJob,
		|	TTProducts_1.TransportationJob		AS TransportationJob
		|FROM
		|	(SELECT
		|		ProductsReadyForAssembly.Period				AS Period,
		|		ProductsReadyForAssembly.Warehouse					AS Warehouse,
		|		ProductsReadyForAssembly.Recipient			AS Recipient,
		|		ProductsReadyForAssembly.DocumentShipments		AS DocumentShipments,
		|		ProductsReadyForAssembly.Products			AS Products,
		|		ProductsReadyForAssembly.Characteristic		AS Characteristic,
		|		ProductsReadyForAssembly.Purpose			AS Purpose,
		|		ProductsReadyForAssembly.ControlledLotReference	AS ControlledLotReference,
		|		ProductsReadyForAssembly.Series					AS Series,
		|		MAX(CASE
		|			WHEN GoodsForIssue.Period IS NULL
		|				THEN ProductsReadyForAssembly.Period
		|			ELSE GoodsForIssue.Period
		|		END)									AS ShipmentPeriod,
		|		ProductsReadyForAssembly.TransportationJob		AS TransportationJob
		|	FROM
		|		ProductsReadyForAssembly AS ProductsReadyForAssembly
		|			LEFT JOIN GoodsForIssue AS GoodsForIssue
		|			ON ProductsReadyForAssembly.Warehouse = GoodsForIssue.Warehouse
		|				AND ProductsReadyForAssembly.Recipient = GoodsForIssue.Recipient
		|				AND ProductsReadyForAssembly.DocumentShipments = GoodsForIssue.DocumentShipments
		|				AND ProductsReadyForAssembly.Products = GoodsForIssue.Products
		|				AND ProductsReadyForAssembly.Characteristic = GoodsForIssue.Characteristic
		|				AND ProductsReadyForAssembly.Purpose = GoodsForIssue.Purpose
		|				AND ProductsReadyForAssembly.ControlledLotReference = GoodsForIssue.ControlledLotReference
		|				AND ProductsReadyForAssembly.Series = GoodsForIssue.Series
		|				AND ProductsReadyForAssembly.Period >= GoodsForIssue.Period
		|	
		|	GROUP BY
		|		ProductsReadyForAssembly.Period,
		|		ProductsReadyForAssembly.Recipient,
		|		ProductsReadyForAssembly.Warehouse,
		|		ProductsReadyForAssembly.DocumentShipments,
		|		ProductsReadyForAssembly.Products,
		|		ProductsReadyForAssembly.Characteristic,
		|		ProductsReadyForAssembly.Purpose,
		|		ProductsReadyForAssembly.ControlledLotReference,
		|		ProductsReadyForAssembly.Series,
		|		ProductsReadyForAssembly.TransportationJob
		|	
		|	) AS TTProducts_1
		|		INNER JOIN ProductsReadyForAssembly AS ProductsReadyForAssembly
		|		ON TTProducts_1.Warehouse = ProductsReadyForAssembly.Warehouse
		|			AND TTProducts_1.Recipient = ProductsReadyForAssembly.Recipient
		|			AND TTProducts_1.DocumentShipments = ProductsReadyForAssembly.DocumentShipments
		|			AND TTProducts_1.Products = ProductsReadyForAssembly.Products
		|			AND TTProducts_1.Characteristic = ProductsReadyForAssembly.Characteristic
		|			AND TTProducts_1.Purpose = ProductsReadyForAssembly.Purpose
		|			AND TTProducts_1.ControlledLotReference = ProductsReadyForAssembly.ControlledLotReference
		|			AND TTProducts_1.Series = ProductsReadyForAssembly.Series
		|			AND TTProducts_1.Period = ProductsReadyForAssembly.Period
		|
		|ORDER BY
		|	ShipmentPeriod,
		|	Period";
		QueriesTexts.Add(QueryText);
		
