//     * ItIsAllowedToReflectBalanceForNonOrderWarehouse - Boolean - for joint selection by household.operations and orders.
//
Procedure ArrangeSurplusShortagesInWarehouseWithSelectionByOrder(Query, QueryTexts, Registers,
