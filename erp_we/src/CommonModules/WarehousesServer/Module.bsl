Procedure PerformBackgroundChangesToStatusOfSpendingOrdersForSentTransportationTask(TransportationJob) Export
	
	MessageTemplate = NStr("ru = 'Не удалось обработать %1 фоновым заданием изменения статуса по причине: %2';
							|vi = 'Cannot process %1 using a status changing background job. Reason: %2';
							|en = 'Cannot process %1 using a status changing background job. Reason: %2'; fa = 'Cannot process %1 using a status changing background job. Reason: %2';
							|it = 'Cannot process %1 using a status changing background job. Reason: %2';
							|pl = 'Cannot process %1 using a status changing background job. Reason: %2';
							|tr = 'Durum değişikliği arka plan görevi ile %1 işlenemedi, sebep: %2'");
	
	Query = New Query;
	
	If GoodsDeliveryClientServer.UsedDelivery25() Then
		
		EventName = NStr("ru = 'Фоновые задание изменения статуса ордеров при отправке рейса';
						|vi = 'Background job for changing a note status when starting a trip';
						|en = 'Background job for changing a note status when starting a trip'; fa = 'Background job for changing a note status when starting a trip';
						|it = 'Background job for changing a note status when starting a trip';
						|pl = 'Background job for changing a note status when starting a trip';
						|tr = 'Seferin gönderilmesinde fişlerin durum değişikliği arka plan görevi'", Common.DefaultLanguageCode());
		
		QueryText =
		"SELECT
		|	GoodsIssueNote.Ref AS Ref,
		|	GoodsIssueNote.Presentation AS Presentation
		|FROM
		|	Document.GoodsIssueNote AS GoodsIssueNote
		|WHERE
		|	GoodsIssueNote.TransportationJob = &TransportationJob
		|	AND GoodsIssueNote.Status = VALUE(Enum.GoodsIssueNoteStatuses.ToShip)
		|	AND GoodsIssueNote.Posted
		|	AND CAST(GoodsIssueNote.TransportationJob AS Document.Trip).Posted
		|	AND (CAST(GoodsIssueNote.TransportationJob AS Document.Trip).Status = VALUE(Enum.TripStatuses.Shipped_5)
		|	OR CAST(GoodsIssueNote.TransportationJob AS Document.Trip).Status = VALUE(Enum.TripStatuses.Completed))";
		
	Else
		
		EventName = NStr("ru = 'Фоновые задание изменения статуса ордеров при отправке задания на перевозку';
						|vi = 'Background job for changing a note status when starting an itinerary';
						|en = 'Background job for changing a note status when starting an itinerary'; fa = 'Background job for changing a note status when starting an itinerary';
						|it = 'Background job for changing a note status when starting an itinerary';
						|pl = 'Background job for changing a note status when starting an itinerary';
						|tr = 'Taşıma görevinin gönderilmesinde fişlerin durum değişikliği arka plan görevi'", Common.DefaultLanguageCode());
		
		QueryText =
		"SELECT
		|	GoodsIssueNote.Ref AS Ref,
		|	GoodsIssueNote.Presentation AS Presentation
		|FROM
		|	Document.GoodsIssueNote AS GoodsIssueNote
		|WHERE
		|	GoodsIssueNote.TransportationJob = &TransportationJob
		|	AND GoodsIssueNote.Status = VALUE(Enum.GoodsIssueNoteStatuses.ToShip)
		|	AND GoodsIssueNote.Posted
		|	AND CAST(GoodsIssueNote.TransportationJob AS Document.TransportationJob).Posted
		|	AND (CAST(GoodsIssueNote.TransportationJob AS Document.TransportationJob).Status = VALUE(Enum.StatusesOfTransportationJobs.Closed)
		|	OR CAST(GoodsIssueNote.TransportationJob AS Document.TransportationJob).Status = VALUE(Enum.StatusesOfTransportationJobs.Sent))";
		
	EndIf;
	
	Query.Text = QueryText; 
	Query.SetParameter("TransportationJob", TransportationJob);
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		
		DocumentPresentation = Selection.Presentation;
		SpendingOrderLink = Selection.Ref; // DocumentRef.GoodsIssueNote
		
		BeginTransaction();
		
		Try
			
			Block = New DataLock;
			
			LockItem = Block.Add("Document.GoodsIssueNote");
			LockItem.SetValue("Ref", SpendingOrderLink);
			Block.Lock();
			
			SpendingOrderObject = SpendingOrderLink.GetObject();
			SpendingOrderObject.Status = Enums.GoodsIssueNoteStatuses.Shipped_;
			SpendingOrderObject.DateOfShipment = BegOfDay(CurrentSessionDate());
			SpendingOrderObject.Write(DocumentWriteMode.Posting);
			
			CommitTransaction();
			
		Except
			
			RollbackTransaction();
			
			Cause = ErrorProcessing.DetailErrorDescription(ErrorInfo());
			
			MessageText = StringFunctionsClientServer.SubstituteParametersToString(
				MessageTemplate,
				DocumentPresentation,
				Cause);
			
			WriteLogEvent(EventName,
				EventLogLevel.Warning,
				Metadata.Documents.GoodsIssueNote,
				SpendingOrderLink,
				MessageText);
			
		EndTry;
		
	EndDo;
	
EndProcedure

// Updates the data in the information register of the queue for reissuing spending orders.
// If necessary, it launches a background task for reissuing spending orders.
//
// Parameters:
//	Warehouse - CatalogRef.Warehouses - the warehouse to check for.
//	Recipient - CatalogRef.BusinessStructure, CatalogRef.Partners, CatalogRef.Warehouses - the recipient of the goods.
//	Recorder - AnyRef, Undefined - the document that is being reflected in accounting.
//	GenerateExpenseOrders - Boolean - indicates whether the background task for reissuing spending orders has been started.
//
Procedure AddToQueueForFormingSpendingOrders(Warehouse, Recipient, Recorder = Undefined, GenerateExpenseOrders = True) Export
	
	Try
		Block = New DataLock;
		
		LockItem = Block.Add("InformationRegister.GoodsIssueNoteReregistrationQueue");
		LockItem.SetValue("Warehouse", Warehouse);
		LockItem.SetValue("Recipient", Recipient);
		
		Block.Lock();
		
		RecordSet = InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
		RecordSet.Filter.Warehouse.Set(Warehouse);
		RecordSet.Filter.Recipient.Set(Recipient);
		
		RecordSet.Read();
		
		If RecordSet.Count() = 0 Then
			NewRecord = RecordSet.Add();
			NewRecord.Warehouse = Warehouse;
			NewRecord.Recipient = Recipient;
			
			RecordSet.Write();
		EndIf;
	Except
		If ValueIsFilled(Recorder) Then
			MessageText = NStr("vi = 'Không thể kết chuyển chứng từ: %1 do: %2';
								|ru = 'Не удалось выполнить проведение документа: %1 по причине: %2';
								|en = 'Cannot post document: %1. Reason: %2'; fa = 'Cannot post document: %1. Reason: %2';
								|it = 'Не удалось выполнить проведение документа: %1 по причине: %2';
								|pl = 'Cannot post document: %1. Reason: %2';
								|tr = '%2 nedeniyle %1 belge kaydı gerçekleştirilemedi'");
			MessageText = StrTemplate(MessageText,
										String(Recorder),
										ErrorProcessing.DetailErrorDescription(ErrorInfo()));
			
			WriteLogEvent(InfobaseUpdate.EventLogEvent(),
										EventLogLevel.Error,
										Recorder.Metadata(),
										Recorder,
										MessageText);
		Else
			MessageText = NStr("vi = 'Không thể tạo trình tự phiếu xuất theo kho bãi %1 và người nhận %2 do: %3';
								|ru = 'Не удалось сформировать очередь расходных ордеров по складу %1 и получателю %2 по причине: %3';
								|en = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3'; fa = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3';
								|it = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3';
								|pl = 'Cannot generate goods issue notes queue by the %1 warehouse and recipient %2. Reason: %3';
								|tr = '%1 ambarı ve %2 alıcısına göre ambar çıkış fişleri kuyruğu şu nedenden dolayı oluşturulamadı: %3'");
			MessageText = StrTemplate(MessageText,
										String(Warehouse),
										String(Recipient),
										ErrorProcessing.DetailErrorDescription(ErrorInfo()));
			
			WriteLogEvent(InfobaseUpdate.EventLogEvent(),
									EventLogLevel.Error,
									,
									,
									MessageText);
		EndIf;
		
		Raise;
	EndTry;
	
	If GenerateExpenseOrders Then
		ParametersStructure = New Structure("Warehouse, Recipient", Warehouse, Recipient);
		
		StartingBackgroundReissueOfSpendingOrders(ParametersStructure);
	EndIf;
	
EndProcedure

// Updates the data in the information register of the queue for reissuing spending orders.
//
// Parameters:
//	RecipientsOfGoods - ValueTable - a table containing information for updating the register.
//	Recorder - DocumentRef - the document that is being reflected in accounting.
//
Procedure UpdateQueueForFormationOfSpendingOrders(RecipientsOfGoods, Recorder) Export
	
	Try
		Block = New DataLock;
		
		LockItem = Block.Add("InformationRegister.GoodsIssueNoteReregistrationQueue");
		LockItem.DataSource = RecipientsOfGoods;
		
		LockItem.UseFromDataSource("Warehouse",		"Warehouse");
		LockItem.UseFromDataSource("Recipient",	"Recipient");
		
		Block.Lock();
		
		RecordSet = InformationRegisters.GoodsIssueNoteReregistrationQueue.CreateRecordSet();
		RecordSet.Load(RecipientsOfGoods);
		RecordSet.Write(ReplacementMode.Merge);
	Except
		MessageText = NStr("vi = 'Không thể kết chuyển chứng từ: %1 do: %2';
							|ru = 'Не удалось выполнить проведение документа: %1 по причине: %2';
							|en = 'Cannot post document: %1. Reason: %2'; fa = 'Cannot post document: %1. Reason: %2';
							|it = 'Не удалось выполнить проведение документа: %1 по причине: %2';
							|pl = 'Cannot post document: %1. Reason: %2';
							|tr = '%2 nedeniyle %1 belge kaydı gerçekleştirilemedi'");
		MessageText = StrTemplate(MessageText,
									String(Recorder),
									ErrorProcessing.DetailErrorDescription(ErrorInfo()));
		
		WriteLogEvent(InfobaseUpdate.EventLogEvent(),
									EventLogLevel.Error,
									Recorder.Metadata(),
									Recorder,
									MessageText);
		
		Raise;
	EndTry;
	
EndProcedure

