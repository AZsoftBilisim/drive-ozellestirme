		|WHERE
		|	SettingsOfBinLocationWarehouses.UseBinLocationWarehousing
		|	AND SettingsOfBinLocationWarehouses.StartDateOfUsingWarehouseBinSystem <= &Date
		|	AND SettingsOfBinLocationWarehouses.Warehouse = &Warehouse
		|	AND SettingsOfBinLocationWarehouses.Premise = &Premise
		|	AND (NOT &Premise = VALUE(Catalog.Warerooms.EmptyRef)
		|			OR (NOT SettingsOfBinLocationWarehouses.Warehouse.UseWarerooms
		|				OR &Date < SettingsOfBinLocationWarehouses.Warehouse.StartDateOfWareroomUse))";
	Query.SetParameter("Warehouse",Warehouse);
	Query.SetParameter("Premise",
		?(ValueIsFilled(Premise),Premise,Catalogs.Warerooms.EmptyRef()));
	Query.SetParameter("Date",
		?(ValueIsFilled(Date),Date,CurrentSessionDate()));
	
	Return Not Query.Execute().IsEmpty();
EndFunction

// The function returns whether the order scheme is used in the warehouse during shipment.
//
// Parameters:
//	Warehouse	 - CatalogRef.Warehouses - link to the "Warehouses" directory element.
//	Date	 - Date - the date on which the order scheme is checked for use during shipment.
//
// Returns:
//	Boolean - a sign of the use of the order scheme during shipment.
//
Function UseWarehouseManagemantSystemForGoodsIssue(Warehouse, Date = Undefined) Export
	
	If Not ValueIsFilled(Warehouse) Then
		Return False;
	EndIf;
	
	CheckDate	= ?(ValueIsFilled(Date), Date, CurrentSessionDate());
	AttributesNames	= "UseWarehouseManagemantSystemForGoodsIssue, StartDateOfWarehouseManagemantSystemForGoodsIssue";
	WarehouseDetails	= Common.ObjectAttributesValues(Warehouse, AttributesNames, True);
	
	UseAdvancedWarehousing = ValueIsFilled(WarehouseDetails.UseWarehouseManagemantSystemForGoodsIssue)
								And WarehouseDetails.UseWarehouseManagemantSystemForGoodsIssue
								And WarehouseDetails.StartDateOfWarehouseManagemantSystemForGoodsIssue <> Undefined
								And WarehouseDetails.StartDateOfWarehouseManagemantSystemForGoodsIssue <= CheckDate;
	
	Return UseAdvancedWarehousing;
	
EndFunction

// The function returns whether the order scheme is used in the warehouse on receipt.
//
// Parameters:
//	Warehouse			 - CatalogRef.Warehouses - link to the "Warehouses" directory element.
//	Date			 - Date - the date on which the use of the order scheme is checked for receipt.
//	MaybeGroup	 - Boolean - group attribute.
//
// Returns:
//	Boolean - a sign of the use of the order scheme upon receipt.
//
Function UseWarehouseManagemantSystemForGoodsReceipt(Warehouse, Date = Undefined, MaybeGroup = False) Export
	
	If Not ValueIsFilled(Warehouse)
		Or TypeOf(Warehouse) = Type("CatalogRef.BusinessStructure") Then
		
		Return False;
		
	EndIf;
	
	CheckDate = ?(ValueIsFilled(Date), Date, CurrentSessionDate());
	
	If MaybeGroup Then
		
		Query = New Query;
		Query.Text =
		"SELECT ALLOWED
		|	MIN(Warehouses.UseWarehouseManagemantSystemForGoodsReceipt) AS UseWarehouseManagemantSystemForGoodsReceipt
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|WHERE
		|	NOT Warehouses.IsFolder
		|	AND (Warehouses.Ref IN HIERARCHY (&Warehouse)
		|		OR Warehouses.Ref = &Warehouse)
		|	AND Warehouses.StartDateOfWarehouseManagemantSystemForGoodsReceipt <= &Date";
		
		Query.SetParameter("Date",	CheckDate);
		Query.SetParameter("Warehouse",	Warehouse);
		
		Selection = Query.Execute().Select();
		Selection.Next();
		
		If ValueIsFilled(Selection.UseWarehouseManagemantSystemForGoodsReceipt) Then
			Return Selection.UseWarehouseManagemantSystemForGoodsReceipt;
		Else
			Return False;
		EndIf;
		
	Else
		
		CheckDate	= ?(ValueIsFilled(Date), Date, CurrentSessionDate());
		AttributesNames	= "UseWarehouseManagemantSystemForGoodsReceipt, StartDateOfWarehouseManagemantSystemForGoodsReceipt";
		WarehouseDetails	= Common.ObjectAttributesValues(Warehouse, AttributesNames, True);
		
		UseAdvancedWarehousing = ValueIsFilled(WarehouseDetails.UseWarehouseManagemantSystemForGoodsReceipt)
									And WarehouseDetails.UseWarehouseManagemantSystemForGoodsReceipt
									And WarehouseDetails.StartDateOfWarehouseManagemantSystemForGoodsReceipt <> Undefined
									And WarehouseDetails.StartDateOfWarehouseManagemantSystemForGoodsReceipt <= CheckDate;
		
		Return UseAdvancedWarehousing;
		
	EndIf;
	
EndFunction

