	|				(SELECT
	|					Goods.Period				AS Period,
	|					Goods.Warehouse				AS Warehouse,
	|					Goods.Recipient			AS Recipient,
	|					Goods.DocumentShipments		AS DocumentShipments,
	|					Goods.Products			AS Products,
	|					Goods.Characteristic		AS Characteristic,
	|					Goods.Purpose			AS Purpose,
	|					Goods.ControlledLotReference	AS ControlledLotReference,
	|					Goods.Series				AS Series,
	|					Goods.TransportationJob	AS TransportationJob
	|				FROM
	|					GoodsToBeAssembledByTask AS Goods
	|				)
	|	
	|	GROUP BY
	|		ProductsReadyForAssembly.Period,
	|		ProductsReadyForAssembly.Warehouse,
	|		ProductsReadyForAssembly.Recipient,
	|		ProductsReadyForAssembly.DocumentShipments,
	|		ProductsReadyForAssembly.Products,
	|		ProductsReadyForAssembly.Characteristic,
	|		ProductsReadyForAssembly.Purpose,
	|		ProductsReadyForAssembly.ControlledLotReference,
	|		ProductsReadyForAssembly.Series,
	|		ProductsReadyForAssembly.ShipmentUnderTransportationJob,
	|		ProductsReadyForAssembly.TransportationJob
	|	
	|	) AS TTProducts_1
	|		INNER JOIN ProductsReadyForAssembly AS ProductsReadyForAssembly
	|		ON TTProducts_1.Warehouse = ProductsReadyForAssembly.Warehouse
	|			AND TTProducts_1.Recipient = ProductsReadyForAssembly.Recipient
	|			AND TTProducts_1.DocumentShipments = ProductsReadyForAssembly.DocumentShipments
	|			AND TTProducts_1.Products = ProductsReadyForAssembly.Products
	|			AND TTProducts_1.Characteristic = ProductsReadyForAssembly.Characteristic
	|			AND TTProducts_1.Purpose = ProductsReadyForAssembly.Purpose
	|			AND TTProducts_1.ControlledLotReference = ProductsReadyForAssembly.ControlledLotReference
	|			AND TTProducts_1.Series = ProductsReadyForAssembly.Series
	|			AND TTProducts_1.Period = ProductsReadyForAssembly.Period
	|			AND TTProducts_1.TransportationJob = ProductsReadyForAssembly.TransportationJob
	|
	|ORDER BY
	|	ShipmentPeriod,
	|	Period";
	
	Return QueryText;
	
EndFunction

Procedure DistributeGoodsToShipAccordingToTasksForTransportation(TreeGoodsForShipment)
	
	LinesToDelete = New Array;
	QuantityToBeDeliveredAccordingToTransportationOrder = New Map;
	
	For Each LevelShipmentByTransportTask In TreeGoodsForShipment.Rows Do
		
		If Not LevelShipmentByTransportTask.ShipmentUnderTransportationJob Then
			Continue;
		EndIf;
		
		For Each RecipientLevel In LevelShipmentByTransportTask.Rows Do
			For Each ShippingDocumentLevel In RecipientLevel.Rows Do
				For Each LevelProducts In ShippingDocumentLevel.Rows Do
					For Each LevelCharacteristics In LevelProducts.Rows  Do
						For Each LevelAssignment In LevelCharacteristics.Rows Do
							For Each LevelControlledLotReference In LevelAssignment.Rows Do
								For Each LevelSeries In LevelControlledLotReference.Rows Do
									
									QuantityToBeDeliveredAccordingToTransportationOrder.Clear();
									
									For Each LevelQuantityToShipment In LevelSeries.Rows Do 
										
										QuantityToShip = LevelQuantityToShipment.Count;
										
										For Each TransportTaskLevel In LevelQuantityToShipment.Rows Do
											For Each String In TransportTaskLevel.Rows Do
												
												If QuantityToShip = 0 Then
													AddressOfLineToDelete = New Array;
													AddressOfLineToDelete.Add(String);
													AddressOfLineToDelete.Add(TransportTaskLevel);
													AddressOfLineToDelete.Add(LevelQuantityToShipment);
													AddressOfLineToDelete.Add(LevelSeries);
													AddressOfLineToDelete.Add(LevelAssignment);
													AddressOfLineToDelete.Add(LevelControlledLotReference);
													AddressOfLineToDelete.Add(LevelCharacteristics);
													AddressOfLineToDelete.Add(LevelProducts);
													AddressOfLineToDelete.Add(ShippingDocumentLevel);
													AddressOfLineToDelete.Add(RecipientLevel);
													AddressOfLineToDelete.Add(LevelShipmentByTransportTask);
													AddressOfLineToDelete.Add(TreeGoodsForShipment);
													
													LinesToDelete.Add(AddressOfLineToDelete);
													
													Continue;
												EndIf;
												
												If String.AllGoods Then
													QuantityToDelivery = QuantityToShip;
												Else
													
													QuantityToDeliveryConsumed = QuantityToBeDeliveredAccordingToTransportationOrder.Get(String.TransportationJob);
													QuantityToDeliveryConsumed = ?(QuantityToDeliveryConsumed = Undefined,
																							0,
																							QuantityToDeliveryConsumed);
													
													QuantityToDelivery = String.QuantityToDelivery - QuantityToDeliveryConsumed;
													QuantityToDelivery = Min(QuantityToShip, QuantityToDelivery);
													
													If QuantityToDelivery > 0 Then
														QuantityToBeDeliveredAccordingToTransportationOrder.Insert(
															String.TransportationJob,
															QuantityToDelivery + QuantityToDeliveryConsumed);
													Else
														AddressOfLineToDelete = New Array;
														AddressOfLineToDelete.Add(String);
														AddressOfLineToDelete.Add(TransportTaskLevel);
														AddressOfLineToDelete.Add(LevelQuantityToShipment);
														AddressOfLineToDelete.Add(LevelSeries);
														AddressOfLineToDelete.Add(LevelAssignment);
														AddressOfLineToDelete.Add(LevelControlledLotReference);
														AddressOfLineToDelete.Add(LevelCharacteristics);
														AddressOfLineToDelete.Add(LevelProducts);
														AddressOfLineToDelete.Add(ShippingDocumentLevel);
														AddressOfLineToDelete.Add(RecipientLevel);
														AddressOfLineToDelete.Add(LevelShipmentByTransportTask);
														AddressOfLineToDelete.Add(TreeGoodsForShipment);
														
														LinesToDelete.Add(AddressOfLineToDelete);
														
														Continue;
													EndIf;
													
												EndIf;
												
												String.Count = QuantityToDelivery;
												
												QuantityToShip = QuantityToShip - QuantityToDelivery;
											EndDo;
										EndDo;
										
									EndDo;
									
								EndDo;
							EndDo;
						EndDo;
					EndDo;
				EndDo;
			EndDo;
		EndDo;
		
	EndDo;
	
	For Each AddressToDelete In LinesToDelete Do
		// The last element of the array is not processed because it is a reference to the root of the tree.
		levels = AddressToDelete.UBound() - 1;
		
		For IndexOf = 0 To levels Do
			CurrentRow	= AddressToDelete[IndexOf];
			Parent		= AddressToDelete[IndexOf + 1]; // ValueTreeRow -
			
			If IndexOf = 0 Then
				Parent.Rows.Delete(CurrentRow);
			ElsIf CurrentRow.Rows.Count() = 0 Then
				// Deleting an empty parent.
				Parent.Rows.Delete(CurrentRow);
			EndIf;
		EndDo;
	EndDo;
	
EndProcedure

