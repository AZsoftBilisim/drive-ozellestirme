Function AdditionalAnalyticsBalanceControlErrors(ErrorString)
	
	Texts = New Array();
	If ValueIsFilled(ErrorString.Purpose) Then
		Texts.Add(String(ErrorString.Purpose));
	EndIf;
	If ValueIsFilled(ErrorString.ControlledLotReference) Then
		Texts.Add(String(ErrorString.ControlledLotReference));
	EndIf;
	AdditionalAnalytics = ?(Texts.Count() = 0, "", StrTemplate("(%1)", StrConcat(Texts, ", ")));
	Return AdditionalAnalytics;
	
EndFunction

