Procedure FillInRequestTextParameters(QueryText, QueryOptions)
	
	For Each QueryParameter In QueryOptions Do
		QueryText = StrReplace(QueryText, ",&" + QueryParameter.Key, QueryParameter.Value);
		QueryText = StrReplace(QueryText, "&" + QueryParameter.Key, QueryParameter.Value);
	EndDo;
	
EndProcedure

