#Region CheckingWhetherStatusCanBeChanged

// Checks whether the status of the shipment order can be changed to the "pending verification"status. 
// If all products are selected for the order, the order will be included in the result array.
//
// Parameters:
//  Orders_3	 - 	Array, DocumentRef.GoodsIssueNote, DocumentRef.GoodsTransferNote -  a link to an order or an array of links to orders.
// 
// Returns:
//  Array - an array of links to orders that can be converted to the status "For verification".
//
Function CheckOrdersForStatusChanges(Orders_3) Export
	
	ArrayOfOrders = New Array;
	
	If TypeOf(Orders_3) <> Type("Array") Then
		ArrayOfOrders.Add(Orders_3);
	Else
		ArrayOfOrders = Orders_3;
	EndIf;
	
	Query = New Query;
	Query.Text = 
	"SELECT
	|	GoodsForPickingBalance.ReferenceOrder AS ReferenceOrder,
	|	GoodsForPickingBalance.Products AS Products,
	|	GoodsForPickingBalance.Characteristic AS Characteristic,
	|	GoodsForPickingBalance.Purpose AS Purpose,
	|	GoodsForPickingBalance.Series AS Series,
	|	GoodsForPickingBalance.CargoItem AS CargoItem,
	|	GoodsForPickingBalance.ForPickingBalance AS ForPickingBalance,
	|	GoodsForPickingBalance.PickedBalance AS PickedBalance
	|INTO GoodsForPickingBalance
	|FROM
	|	AccumulationRegister.GoodsForPicking.Balance(, ReferenceOrder IN (&ArrayOfOrders)) AS GoodsForPickingBalance
	|
	|INDEX BY
	|	ReferenceOrder,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForPickingBalance.ReferenceOrder,
	|	GoodsForPickingBalance.Products,
	|	GoodsForPickingBalance.Characteristic,
	|	GoodsForPickingBalance.Purpose,
	|	GoodsForPickingBalance.Series,
	|	GoodsForPickingBalance.ForPickingBalance - GoodsForPickingBalance.PickedBalance AS Count
	|INTO GoodsUnassembledSets
	|FROM
	|	GoodsForPickingBalance AS GoodsForPickingBalance
	|WHERE
	|	GoodsForPickingBalance.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	GoodsForPickingBalance.Products AS Products,
	|	PackagesAndUnitsOfMeasure.Ref AS CargoItem,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages AS NumberOfPackages
	|INTO ProductsWithProductLocations
	|FROM
	|	GoodsForPickingBalance AS GoodsForPickingBalance
	|		INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		ON GoodsForPickingBalance.Products = PackagesAndUnitsOfMeasure.Owner
	|WHERE
	|	NOT PackagesAndUnitsOfMeasure.DeletionMark
	|	AND PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|
	|UNION ALL
	|
	|SELECT
	|	GoodsForPickingBalance.Products,
	|	PackagesAndUnitsOfMeasure.Ref,
	|	PackagesAndUnitsOfMeasure.NumberOfPackages
	|FROM
	|	GoodsForPickingBalance AS GoodsForPickingBalance
	|		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
	|		ON GoodsForPickingBalance.Products.PackagingGroup = PackagesAndUnitsOfMeasure.Owner
	|WHERE
	|	NOT PackagesAndUnitsOfMeasure.DeletionMark
	|	AND PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	InternalTable.ReferenceOrder AS WarehouseDocument,
	|	PRESENTATION(InternalTable.ReferenceOrder) AS WarehouseDocumentPresentation
	|FROM
	|	(SELECT
	|		GoodsUnassembledSets.ReferenceOrder AS ReferenceOrder,
	|		GoodsUnassembledSets.Products AS Products,
	|		GoodsUnassembledSets.Characteristic AS Characteristic,
	|		GoodsUnassembledSets.Purpose AS Purpose,
	|		GoodsUnassembledSets.Series AS Series,
	|		GoodsUnassembledSets.Count * ProductsWithProductLocations.NumberOfPackages - ISNULL(GoodsForPickingBalance.PickedBalance, 0) AS Count,
	|		ProductsWithProductLocations.CargoItem AS CargoItem
	|	FROM
	|		GoodsUnassembledSets AS GoodsUnassembledSets
	|			INNER JOIN ProductsWithProductLocations AS ProductsWithProductLocations
	|			ON GoodsUnassembledSets.Products = ProductsWithProductLocations.Products
	|			LEFT JOIN GoodsForPickingBalance AS GoodsForPickingBalance
	|			ON GoodsUnassembledSets.ReferenceOrder = GoodsForPickingBalance.ReferenceOrder
	|				AND GoodsUnassembledSets.Products = GoodsForPickingBalance.Products
	|				AND GoodsUnassembledSets.Characteristic = GoodsForPickingBalance.Characteristic
	|				AND GoodsUnassembledSets.Purpose = GoodsForPickingBalance.Purpose
	|				AND GoodsUnassembledSets.Series = GoodsForPickingBalance.Series
	|				AND (ProductsWithProductLocations.CargoItem = GoodsForPickingBalance.CargoItem)
	|	WHERE
	|		ISNULL(GoodsForPickingBalance.CargoItem, UNDEFINED) <> VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		GoodsUnassembledSets.ReferenceOrder,
	|		GoodsUnassembledSets.Products,
	|		GoodsUnassembledSets.Characteristic,
	|		GoodsUnassembledSets.Purpose,
	|		GoodsUnassembledSets.Series,
	|		GoodsUnassembledSets.Count,
	|		VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	FROM
	|		GoodsUnassembledSets AS GoodsUnassembledSets
	|			LEFT JOIN ProductsWithProductLocations AS ProductsWithProductLocations
	|			ON GoodsUnassembledSets.Products = ProductsWithProductLocations.Products
	|	WHERE
	|		ProductsWithProductLocations.Products IS NULL) AS InternalTable
	|WHERE
	|	InternalTable.Count > 0";
	
	Query.SetParameter("ArrayOfOrders", ArrayOfOrders);
	Selection = Query.Execute().Select();
	
	MessageTemplate = NStr("vi = 'Thay đổi trạng thái của chứng từ ""%WarehouseDocument%"" là không thể, bởi vì lựa chọn hàng hóa theo đơn đặt hàng chưa được hoàn thành. Bạn phải hoàn thành tất cả các lựa chọn hoặc giảm số lượng hàng hóa trong đơn hàng.';
							|ru = 'Изменение статуса документа ""%WarehouseDocument%"" невозможно, т.к. не завершен отбор товаров по ордеру. Необходимо выполнить все отборы либо уменьшить количество товаров в ордере.';
							|en = 'Cannot change the ""%WarehouseDocument%"" document status as the goods selection by the note is not complete. Wait until the selection is complete, or reduce the goods quantity in the note.'; fa = 'Cannot change the ""%WarehouseDocument%"" document status as the goods selection by the note is not complete. Wait until the selection is complete, or reduce the goods quantity in the note.';
							|it = 'Impossibile modificare lo stato del documento ""%WarehouseDocument%"" poiché non è terminata la selezione di merci in base al mandato. È necessario effettuare tutte le selezioni o diminuire la quantità di merci nel mandato.';
							|pl = 'Zmiana statusu dokumentu ""%WarehouseDocument%"" nie jest możliwa, ponieważ nie ukończono wyboru towarów na podstawie zlecenia. Należy wykonać wszystkie wybory lub zmniejszyć ilość towarów w zamówieniu.';
							|tr = 'Emirdeki ürünlerin seçimi tamamlanmadığı için ""%WarehouseDocument%"" belgesinin durumu değiştirilemez. Tüm filtreleri gerçekleştirmek veya emirdeki ürün sayısını azaltmak gerekir.'");
	
	While Selection.Next() Do
		MessageText = StrReplace(MessageTemplate, "%WarehouseDocument%", Selection.WarehouseDocumentPresentation);
		CommonClientServer.MessageToUser(MessageText);
		IndexOf = ArrayOfOrders.Find(Selection.WarehouseDocument);
		If IndexOf <> Undefined Then
			ArrayOfOrders.Delete(IndexOf);
		EndIf;
	EndDo;
	
	Return ArrayOfOrders;
	
EndFunction

