		|		
		|		INNER JOIN Document.TransferOfGoodsToBailee.Goods AS WaybillGoods
		|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
		|
		|UNION ALL
		|
		|SELECT
		|	CASE
		|		WHEN WaybillGoods.Ref.ShipmentByOrders
		|			THEN WaybillGoods.SalesOrder
		|		ELSE WaybillGoods.Ref
		|	END AS DocumentShipments
		|FROM
		|	Document.TransportationJob.References AS TransportationTask
		|		INNER JOIN TTTransportTaskBlocked AS TTTransportTasks
		|		ON TransportationTask.Ref = TTTransportTasks.Ref
		|		
		|		INNER JOIN Document.GoodsShipmentToCustomer.Goods AS WaybillGoods
		|		ON WaybillGoods.Ref = TransportationTask.ReferenceOrder
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	NestedQuery.DocumentShipments AS DocumentShipments
		|INTO BlockedShipmentDocuments
		|FROM
		|	(SELECT
		|		ShippingDocuments.DocumentShipments AS DocumentShipments
		|	FROM
		|		BlockedShipmentDocumentsForTransportationOrder AS ShippingDocuments
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		TTBlockedGoodsForShipment.DocumentShipments
		|	FROM
		|		TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment) AS NestedQuery
		|
		|INDEX BY
		|	DocumentShipments
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// GoodsForShipmentTurnover
		|SELECT
		|	BEGINOFPERIOD(GoodsForIssue.Period, DAY)			AS Period,
		|	GoodsForIssue.Warehouse								AS Warehouse,
		|	CASE
		|		WHEN GoodsForIssue.Recipient IN (&EmptyRecipient)
		|			THEN GoodsForIssue.DocumentShipments
		|		ELSE GoodsForIssue.Recipient
		|	END												AS Recipient,
		|	GoodsForIssue.DocumentShipments					AS DocumentShipments,
		|	GoodsForIssue.Products						AS Products,
		|	GoodsForIssue.Characteristic						AS Characteristic,
		|	GoodsForIssue.Purpose							AS Purpose,
		|	GoodsForIssue.ControlledLotReference				AS ControlledLotReference,
		|	GoodsForIssue.Series								AS Series,
		|	SUM(CASE
		|		WHEN GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Expense)
		|				AND GoodsForIssue.ToShip < 0
		|			THEN -GoodsForIssue.ToShip
		|		WHEN GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Receipt)
		|			THEN CASE
		|				WHEN &IssueInvoicesFirst
		|					THEN GoodsForIssue.ToShip - GoodsForIssue.ToRegister
		|				ELSE GoodsForIssue.ToShip
		|			END
		|		ELSE 0
		|	END)												AS QuantityToShipReceipt,
		|	SUM(CASE
		|		WHEN &IssueInvoicesFirst
		|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Expense)
		|			THEN GoodsForIssue.ToRegister
		|		ELSE 0
		|	END)												AS QuantityToRegisterExpense,
		|	SUM(CASE
		|		WHEN (NOT &TransportationTaskCompleted
		|					OR GoodsForIssue.TransportationJob = &TransportationJob)
		|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Expense)
		|			THEN GoodsForIssue.ToShip
		|		ELSE 0
		|	END)												AS QuantityToShipExpense,
		|	SUM(CASE
		|		WHEN (NOT &TransportationTaskCompleted
		|					OR GoodsForIssue.TransportationJob = &TransportationJob)
		|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Receipt)
		|			THEN GoodsForIssue.ForAssembly
		|		ELSE 0
		|	END)												AS QuantityToBuildReceipt,
		|	SUM(CASE
		|		WHEN (NOT &TransportationTaskCompleted
		|					OR GoodsForIssue.TransportationJob = &TransportationJob)
		|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Receipt)
		|			THEN GoodsForIssue.AssemblyInProgress + GoodsForIssue.Assembled
		|		ELSE 0
		|	END)												AS QuantityInAssemblyReceipt,
		|	CASE
		|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
		|					(VALUE(Enum.TransportMethods.ToCustomer),
		|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
		|					)
		|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
		|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
		|						(VALUE(Enum.TransportMethods.ByCarrier),
		|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
		|						)
		|					)
		|			THEN TRUE
		|		ELSE FALSE
		|	END												AS ShipmentUnderTransportationJob,
		|	CASE
		|		WHEN VALUETYPE(GoodsForIssue.TransportationJob) = TYPE(Document.TransportationJob)
		|				AND GoodsForIssue.TransportationJob <> VALUE(Document.TransportationJob.EmptyRef)
		|			THEN GoodsForIssue.TransportationJob
		|		ELSE UNDEFINED
		|	END												AS TransportationJob
		|INTO GoodsForShipmentTurnover
		|FROM
		|	AccumulationRegister.GoodsForIssue AS GoodsForIssue
		|		LEFT JOIN BlockedShipmentDocuments AS BlockedShipmentDocuments
		|		ON GoodsForIssue.DocumentShipments = BlockedShipmentDocuments.DocumentShipments
		|		
		|		LEFT JOIN InformationRegister.StatesAndDetailsOfDelivery AS StatesAndDetailsOfDelivery
		|		ON GoodsForIssue.Warehouse = StatesAndDetailsOfDelivery.Warehouse
		|			AND GoodsForIssue.DocumentShipments = StatesAndDetailsOfDelivery.ReferenceOrder
		|
		|WHERE
		|	GoodsForIssue.Warehouse = &Warehouse
		|	AND GoodsForIssue.Recipient = &Recipient
		|	AND (&ByAllReferences
		|		OR GoodsForIssue.DocumentShipments IN (&ShipmentReferences))
		|	AND BlockedShipmentDocuments.DocumentShipments IS NULL
		|
		|GROUP BY
		|	BEGINOFPERIOD(GoodsForIssue.Period, DAY),
		|	GoodsForIssue.Warehouse,
		|	CASE
		|		WHEN GoodsForIssue.Recipient IN (&EmptyRecipient)
		|			THEN GoodsForIssue.DocumentShipments
		|		ELSE GoodsForIssue.Recipient
		|	END,
		|	GoodsForIssue.DocumentShipments,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Purpose,
		|	GoodsForIssue.ControlledLotReference,
		|	GoodsForIssue.Series,
		|	CASE
		|		WHEN StatesAndDetailsOfDelivery.DeliveryMethod IN
		|					(VALUE(Enum.TransportMethods.ToCustomer),
		|					VALUE(Enum.TransportMethods.ByCarrierToAddress)
		|					)
		|				OR (&UseTransportationJobsForDeliveryAccountingByCarriers
		|					AND StatesAndDetailsOfDelivery.DeliveryMethod IN
		|						(VALUE(Enum.TransportMethods.ByCarrier),
		|						VALUE(Enum.TransportMethods.ToCustomerIsDefinedByTransportationCompany)
		|						)
		|					)
		|			THEN TRUE
		|		ELSE FALSE
		|	END,
		|	CASE
		|		WHEN VALUETYPE(GoodsForIssue.TransportationJob) = TYPE(Document.TransportationJob)
		|				AND GoodsForIssue.TransportationJob <> VALUE(Document.TransportationJob.EmptyRef)
		|			THEN GoodsForIssue.TransportationJob
		|		ELSE UNDEFINED
		|	END
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// The product is a cargo receipt/Merchandise Formationspend
		|SELECT
		|	GoodsForIssue.Period							AS Period,
		|	GoodsForIssue.Warehouse							AS Warehouse,
		|	GoodsForIssue.Recipient						AS Recipient,
		|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|	GoodsForIssue.Products					AS Products,
		|	GoodsForIssue.Characteristic					AS Characteristic,
		|	GoodsForIssue.Purpose						AS Purpose,
		|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|	GoodsForIssue.Series							AS Series,
		|	SUM(GoodsForIssue.Count)				AS Count,
		|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob
		|INTO TTGoodsForShipment
		|FROM
		|	(SELECT
		|		GoodsForIssue.Period							AS Period,
		|		GoodsForIssue.Warehouse							AS Warehouse,
		|		GoodsForIssue.Recipient						AS Recipient,
		|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|		GoodsForIssue.Products					AS Products,
		|		GoodsForIssue.Characteristic					AS Characteristic,
		|		GoodsForIssue.Purpose						AS Purpose,
		|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|		GoodsForIssue.Series							AS Series,
		|		GoodsForIssue.QuantityToShipReceipt		AS Count,
		|		GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob
		|	FROM
		|		GoodsForShipmentTurnover AS GoodsForIssue
		|	WHERE
		|		GoodsForIssue.QuantityToShipReceipt <> 0
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		GoodsForIssue.Period							AS Period,
		|		GoodsForIssue.Warehouse							AS Warehouse,
		|		GoodsForIssue.Recipient						AS Recipient,
		|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|		GoodsForIssue.Products					AS Products,
		|		GoodsForIssue.Characteristic					AS Characteristic,
		|		GoodsForIssue.Purpose						AS Purpose,
		|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|		GoodsForIssue.Series							AS Series,
		|		GoodsForIssue.QuantityToRegisterExpense		AS Count,
		|		GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob
		|	FROM
		|		GoodsForShipmentTurnover AS GoodsForIssue
		|	WHERE
		|		GoodsForIssue.QuantityToRegisterExpense <> 0
		|	
		|	) AS GoodsForIssue
		|
		|GROUP BY
		|	GoodsForIssue.Period,
		|	GoodsForIssue.Warehouse,
		|	GoodsForIssue.Recipient,
		|	GoodsForIssue.DocumentShipments,
		|	GoodsForIssue.Products,
		|	GoodsForIssue.Characteristic,
		|	GoodsForIssue.Purpose,
		|	GoodsForIssue.ControlledLotReference,
		|	GoodsForIssue.Series,
		|	GoodsForIssue.ShipmentUnderTransportationJob
		|
		|HAVING
		|	SUM(GoodsForIssue.Count) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		// The product is a cargo receipt/Merchandise Formationspend
		|SELECT
		|	GoodsForIssue.Period							AS Period,
		|	GoodsForIssue.Warehouse							AS Warehouse,
		|	GoodsForIssue.Recipient						AS Recipient,
		|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
		|	GoodsForIssue.Products					AS Products,
		|	GoodsForIssue.Characteristic					AS Characteristic,
		|	GoodsForIssue.Purpose						AS Purpose,
		|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
		|	GoodsForIssue.Series							AS Series,
		|	GoodsForIssue.Count						AS Count,
		|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
		|	&AcceptableDeviationValue					AS AllowableVariance
		|INTO GoodsForIssue
		|FROM
		|	TTGoodsForShipment AS GoodsForIssue
		|		,&SVTCompoundOfPermissibleDeviations AS T
		|
		|INDEX BY
		|	Warehouse,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	Series
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTGoodsForShipment
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	CASE
		|		WHEN GoodsForIssue.ShipmentUnderTransportationJob
		|				AND ISNULL(GoodsToDeliver.TransportationJob, VALUE(Document.TransportationJob.EmptyRef)) <> VALUE(Document.TransportationJob.EmptyRef)
		|			THEN BEGINOFPERIOD(GoodsToDeliver.TransportationJob.PlanTripStartTime, DAY)
		|		ELSE GoodsForIssue.Period
		|	END										AS Period,
		|	GoodsForIssue.Warehouse						AS Warehouse,
		|	GoodsForIssue.Recipient					AS Recipient,
		|	GoodsForIssue.DocumentShipments			AS DocumentShipments,
		|	GoodsForIssue.Products				AS Products,
		|	GoodsForIssue.Characteristic				AS Characteristic,
		|	GoodsForIssue.Purpose					AS Purpose,
		|	GoodsForIssue.ControlledLotReference		AS ControlledLotReference,
		|	GoodsForIssue.Series						AS Series,
		|	GoodsForIssue.Count					AS Count,
		|	CASE
		|		WHEN GoodsForIssue.ShipmentUnderTransportationJob
		|				AND ISNULL(GoodsToDeliver.TransportationJob, VALUE(Document.TransportationJob.EmptyRef)) <> VALUE(Document.TransportationJob.EmptyRef)
		|			THEN TRUE
		|		ELSE FALSE
		|	END										AS ShipmentUnderTransportationJob,
		|	CASE
		|		WHEN GoodsToDeliver.TransportationJob IS NULL
		|			THEN UNDEFINED
		|		WHEN GoodsToDeliver.TransportationJob = VALUE(Document.TransportationJob.EmptyRef)
		|			THEN UNDEFINED
		|		ELSE GoodsToDeliver.TransportationJob
		|	END										AS TransportationJob,
		|	GoodsForIssue.AllowableVariance		AS AllowableVariance,
		|	ISNULL(GoodsToDeliver.AllGoods, FALSE)	AS AllGoods,
		|	ISNULL(GoodsToDeliver.Count, 0)		AS QuantityToDelivery
		|FROM
		|	GoodsForIssue AS GoodsForIssue
		|		LEFT JOIN InformationRegister.GoodsToDeliver AS GoodsToDeliver
		|		ON GoodsForIssue.Warehouse = GoodsToDeliver.Warehouse
		|			AND GoodsForIssue.DocumentShipments = GoodsToDeliver.ReferenceOrder
		|			AND (GoodsForIssue.Products = GoodsToDeliver.Products
		|					AND GoodsForIssue.Characteristic = GoodsToDeliver.Characteristic
		|					AND GoodsForIssue.Purpose = GoodsToDeliver.Purpose
		|					AND GoodsForIssue.Series = GoodsToDeliver.Series
		|				OR GoodsToDeliver.AllGoods)
		|			AND GoodsToDeliver.TransportationJob.Posted
		|			AND (GoodsToDeliver.TransportationJob = VALUE(Document.TransportationJob.EmptyRef)
		|				OR GoodsToDeliver.TransportationJob.Status <> VALUE(Enum.StatusesOfTransportationJobs.BeingGenerated))
		|			AND GoodsForIssue.ShipmentUnderTransportationJob
		|			AND (NOT &TransportationTaskCompleted
		|				OR GoodsToDeliver.TransportationJob = &TransportationJob)
		|
		|WHERE
		|	NOT (GoodsForIssue.ShipmentUnderTransportationJob
		|		AND GoodsToDeliver.TransportationJob IS NULL)
		|
		|TOTALS BY
		|	ShipmentUnderTransportationJob,
		|	Recipient,
		|	DocumentShipments,
		|	Products,
		|	Characteristic,
		|	Purpose,
		|	ControlledLotReference,
		|	Series,
		|	GoodsForIssue.Count,
		|	TransportationJob
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP GoodsForIssue";
		QueriesTexts.Add(QueryText);
		
		#EndRegion
		
	Else // Delivery25
		
		CalculateGoodsForExecutionOfExpenditureOrdersDelivery25(AdditionalParameters, TempTableManager, QueriesTexts);
		
	EndIf;
	
	If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
		ConditionAcceptableDeviation =
		"(Warehouse, DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series) IN
		|				(SELECT
		|					Table.Warehouse,
		|					Table.DocumentShipments,
		|					Table.Products,
		|					Table.Characteristic,
		|					Table.Purpose,
		|					Table.ControlledLotReference,
		|					Table.Series
		|				FROM
		|					TTGoodsForExecutionOfExpenditureOrders AS Table)";
		
		SVTCompoundOfPermissibleDeviations =
		"INNER JOIN TTGoodsForExecutionOfExpenditureOrders AS TTGoodsForExecutionOfExpenditureOrders
		|		ON GoodsForIssue.Warehouse = TTGoodsForExecutionOfExpenditureOrders.Warehouse
		|			AND GoodsForIssue.DocumentShipments = TTGoodsForExecutionOfExpenditureOrders.DocumentShipments
		|			AND GoodsForIssue.Products = TTGoodsForExecutionOfExpenditureOrders.Products
		|			AND GoodsForIssue.Characteristic = TTGoodsForExecutionOfExpenditureOrders.Characteristic
		|			AND GoodsForIssue.Purpose = TTGoodsForExecutionOfExpenditureOrders.Purpose
		|			AND GoodsForIssue.ControlledLotReference = TTGoodsForExecutionOfExpenditureOrders.ControlledLotReference
		|			AND GoodsForIssue.Series = TTGoodsForExecutionOfExpenditureOrders.Series";
		
		ConnectionOfGoodsToDeliverySVTPermissibleDeviations =
		"INNER JOIN TTGoodsForExecutionOfExpenditureOrders AS TTGoodsForExecutionOfExpenditureOrders
		|		ON GoodsForIssue.Warehouse = TTGoodsForExecutionOfExpenditureOrders.Warehouse
		|			AND GoodsForIssue.DocumentShipments = TTGoodsForExecutionOfExpenditureOrders.DocumentShipments
		|			AND GoodsForIssue.Products = TTGoodsForExecutionOfExpenditureOrders.Products
		|			AND GoodsForIssue.Characteristic = TTGoodsForExecutionOfExpenditureOrders.Characteristic
		|			AND GoodsForIssue.Purpose = TTGoodsForExecutionOfExpenditureOrders.Purpose
		|			AND GoodsForIssue.Series = TTGoodsForExecutionOfExpenditureOrders.Series";
		
		AcceptableDeviationValue = "TTGoodsForExecutionOfExpenditureOrders.AllowableVariance";
	Else
		ConditionAcceptableDeviation = "TRUE";
		SVTCompoundOfPermissibleDeviations = "";
		ConnectionOfGoodsToDeliverySVTPermissibleDeviations = "";
		AcceptableDeviationValue = 0;
	EndIf;
	
	QueryText = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	
	QueryText = StrReplace(QueryText, "&ConditionAcceptableDeviation", ConditionAcceptableDeviation);
	QueryText = StrReplace(QueryText,
								",&SVTCompoundOfPermissibleDeviations AS T",
								SVTCompoundOfPermissibleDeviations);
	QueryText = StrReplace(QueryText,
								",&ConnectionOfGoodsToDeliverySVTPermissibleDeviations AS T",
								ConnectionOfGoodsToDeliverySVTPermissibleDeviations);
	QueryText = StrReplace(QueryText, "&AcceptableDeviationValue", AcceptableDeviationValue);
	
	Query = New Query;
	Query.TempTablesManager = TempTableManager;
	Query.Text = QueryText;
	
	Query.SetParameter("Warehouse", Parameters.Warehouse);
	Query.SetParameter("Recipient", Parameters.Recipient);
	Query.SetParameter("EmptyRecipient", EmptyReceiverSender());
	Query.SetParameter("IssueInvoicesFirst", IssueInvoicesFirst);
	Query.SetParameter("ByAllReferences", Parameters.ShipmentReferences.Count() = 0);
	Query.SetParameter("ShipmentReferences", Parameters.ShipmentReferences);
	Query.SetParameter("TransportationTaskCompleted", ValueIsFilled(Parameters.TransportationJob));
	Query.SetParameter("TransportationJob", Parameters.TransportationJob);
	Query.SetParameter("UsedDelivery25", GoodsDeliveryClientServer.UsedDelivery25());
	Query.SetParameter("DimensionalTypesOfUnits",
		Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
	Query.SetParameter("StartShipmentOnceDeliveryOrderIsCreated",
		StartShipmentOnceDeliveryOrderIsCreated);
	Query.SetParameter("UseTransportationJobsForDeliveryAccountingByCarriers",
		GetFunctionalOption("UseTransportationJobsForDeliveryAccountingByCarriers"));
	Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
		AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
	
	ResultsArray	= Query.ExecuteBatch();
	PacketBoundary		= ResultsArray.UBound();
	
	If StartShipmentOnceDeliveryOrderIsCreated
		And GoodsDeliveryClientServer.UsedDelivery20() Then
		
		TreeGoodsForShipment = ResultsArray[PacketBoundary - 1].Unload(QueryResultIteration.ByGroups);
		
		DistributeGoodsToShipAccordingToTasksForTransportation(TreeGoodsForShipment);
		
		Query.Text = QueryTextOfShipmentSupplementAfterTaskForTransportationIsFormed20();
		Query.SetParameter("GoodsForIssue",
			GoodsToShipForReissueOfExpenditureOrders(TMCommonUse.TreeData(TreeGoodsForShipment)));
		
		ResultsArray	= Query.ExecuteBatch();
		PacketBoundary		= ResultsArray.UBound();
		
	EndIf;
	
	TreeGoodsForShipment	= ResultsArray[PacketBoundary - 2].Unload(QueryResultIteration.ByGroups);
	GoodsSpent	= TableForCalculatingGoodsForIssuingSpendingOrders(
								ResultsArray[PacketBoundary - 1].Unload(),
								StartShipmentOnceDeliveryOrderIsCreated);
	ProductsReadyForAssembly			= TableForCalculatingGoodsForIssuingSpendingOrders(
								ResultsArray[PacketBoundary].Unload());
	
	If Not (ProductsReadyForAssembly.Count() = 0
		And GoodsSpent.Count() = 0) Then
		
		Filter			= "Warehouse, Recipient, DocumentShipments, Products, Characteristic, Purpose,
							|ControlledLotReference, Series";
		FilterByPeriod	= Filter + ", ShipmentPeriod";
		
		GoodsSpent.Indexes.Add(Filter);
		GoodsSpent.Indexes.Add(FilterByPeriod);
		
		ProductsReadyForAssembly.Indexes.Add(Filter);
		ProductsReadyForAssembly.Indexes.Add(FilterByPeriod);
		
		If StartShipmentOnceDeliveryOrderIsCreated Then
			Filter			= Filter + ", TransportationJob";
			FilterByPeriod	= FilterByPeriod + ", TransportationJob";
			
			GoodsSpent.Indexes.Add(Filter);
			GoodsSpent.Indexes.Add(FilterByPeriod);
			
			ProductsReadyForAssembly.Indexes.Add(Filter);
			ProductsReadyForAssembly.Indexes.Add(FilterByPeriod);
		EndIf;
		
		DeductibleTables = New Array;
		DeductibleTables.Add(GoodsSpent);
		DeductibleTables.Add(ProductsReadyForAssembly);
		
		SubtractTableFromTree(TreeGoodsForShipment, DeductibleTables, StartShipmentOnceDeliveryOrderIsCreated);
		
	EndIf;
	
	DataForExecutionOfSpendingOrders = New Structure;
	DataForExecutionOfSpendingOrders.Insert("TreeGoodsForShipment", TreeGoodsForShipment);
	DataForExecutionOfSpendingOrders.Insert("ProductsReadyForAssembly", ProductsReadyForAssembly);
	
	Return DataForExecutionOfSpendingOrders;
	
EndFunction

Procedure CalculateGoodsForExecutionOfExpenditureOrdersDelivery25(AdditionalParameters, TempTableManager, QueriesTexts)
	
	AdditionalParameters = InfobaseUpdate.AdditionalProcessingDataSelectionParameters();
	
	AdditionalParameters.TempTableName = "DeliveryIsBlockedOnTT";
	InfobaseUpdate.CreateTemporaryTableOfLockedDimensionValues(
		Undefined,
		"AccumulationRegister.Delivery",
		"ReferenceOrder",
		TempTableManager,
		AdditionalParameters);
	
	QueryText =
	"SELECT DISTINCT
	|	BlockedDocuments.DocumentShipments AS DocumentShipments
	|INTO BlockedShipmentDocuments
	|FROM
	|	(SELECT
	|		DeliveryIsBlockedOnTT.ReferenceOrder AS DocumentShipments
	|	FROM
	|		DeliveryIsBlockedOnTT AS DeliveryIsBlockedOnTT
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTBlockedGoodsForShipment.DocumentShipments
	|	FROM
	|		TTBlockedGoodsForShipment AS TTBlockedGoodsForShipment) AS BlockedDocuments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.SourceShipmentDate, PrimaryDataOnDeliveryOrder.SourceShipmentDate) AS PrimaryShipmentDate,
	|	DeliveryTurnover.DateOfShipment AS FinalShipmentDate,
	|	CASE
	|		WHEN DocumentsRegistry.Partner IS NULL
	|			THEN DeliveryTurnover.ReferenceOrder
	|		WHEN DocumentsRegistry.Partner IN (&EmptyRecipient)
	|			THEN DeliveryTurnover.ReferenceOrder
	|		ELSE DocumentsRegistry.Partner
	|	END AS Recipient,
	|	DeliveryTurnover.Products AS Products,
	|	DeliveryTurnover.Characteristic AS Characteristic,
	|	DeliveryTurnover.Series AS Series,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.Purpose, PrimaryDataOnDeliveryOrder.Purpose) AS Purpose,
	|	SUM(DeliveryTurnover.ToDeliverTurnover) AS ToDeliver
	|INTO TTToDelivery
	|FROM
	|	AccumulationRegister.Delivery.Turnovers(
	|			,
	|			,
	|			,
	|			Sender = &Warehouse
	|				AND (ReferenceOrder IN (&ShipmentReferences)
	|					OR &ByAllReferences)
	|				AND NOT ReferenceOrder IN
	|						(SELECT
	|							BlockedShipmentDocuments.DocumentShipments
	|						FROM
	|							BlockedShipmentDocuments AS BlockedShipmentDocuments)
	|				AND DeliveryMethod <> VALUE(Enum.TransportMethods25.SelfPickup)
	|				AND Arm = 1) AS DeliveryTurnover
	|		LEFT JOIN AccumulationRegister.Delivery AS PrimaryDataWithoutDeliveryOrder
	|		ON DeliveryTurnover.ReferenceOrder = PrimaryDataWithoutDeliveryOrder.ReferenceOrder
	|			AND (NOT DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND DeliveryTurnover.PlanningDocument = PrimaryDataWithoutDeliveryOrder.PlanningDocument
	|			AND DeliveryTurnover.RowCode = PrimaryDataWithoutDeliveryOrder.RowCode
	|			AND (PrimaryDataWithoutDeliveryOrder.PrimaryRegisterRecord)
	|		LEFT JOIN AccumulationRegister.Delivery AS PrimaryDataOnDeliveryOrder
	|		ON (DeliveryTurnover.ReferenceOrder = PrimaryDataOnDeliveryOrder.ReferenceOrder)
	|			AND (DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND (PrimaryDataOnDeliveryOrder.PlanningDocument = UNDEFINED)
	|			AND (DeliveryTurnover.RowCode = PrimaryDataOnDeliveryOrder.RowCode)
	|			AND (PrimaryDataOnDeliveryOrder.PrimaryRegisterRecord)
	|		INNER JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	|		ON DeliveryTurnover.ReferenceOrder = DocumentsRegistry.Ref
	|			AND (NOT DocumentsRegistry.AdditionalRecord)
	|			AND (DocumentsRegistry.Partner = &Recipient)
	|WHERE
	|	DeliveryTurnover.ToDeliverTurnover > 0
	|
	|GROUP BY
	|	DeliveryTurnover.Series,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.SourceShipmentDate, PrimaryDataOnDeliveryOrder.SourceShipmentDate),
	|	DeliveryTurnover.Products,
	|	DeliveryTurnover.Characteristic,
	|	DeliveryTurnover.DateOfShipment,
	|	CASE
	|		WHEN DocumentsRegistry.Partner IS NULL
	|			THEN DeliveryTurnover.ReferenceOrder
	|		WHEN DocumentsRegistry.Partner IN (&EmptyRecipient)
	|			THEN DeliveryTurnover.ReferenceOrder
	|		ELSE DocumentsRegistry.Partner
	|	END,
	|	DeliveryTurnover.ReferenceOrder,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.Purpose, PrimaryDataOnDeliveryOrder.Purpose)
	|
	|INDEX BY
	|	ReferenceOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DeliveryTurnover.Trip AS Trip,
	|	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.SourceShipmentDate, PrimaryDataOnDeliveryOrder.SourceShipmentDate) AS PrimaryShipmentDate,
	|	DeliveryTurnover.DateOfShipment AS FinalShipmentDate,
	|	CASE
	|		WHEN DocumentsRegistry.Partner IS NULL
	|			THEN DeliveryTurnover.ReferenceOrder
	|		WHEN DocumentsRegistry.Partner IN (&EmptyRecipient)
	|			THEN DeliveryTurnover.ReferenceOrder
	|		ELSE DocumentsRegistry.Partner
	|	END AS Recipient,
	|	DeliveryTurnover.Products AS Products,
	|	DeliveryTurnover.Characteristic AS Characteristic,
	|	DeliveryTurnover.Series AS Series,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.Purpose, PrimaryDataOnDeliveryOrder.Purpose) AS Purpose,
	|	SUM(DeliveryTurnover.ForAssemblyTurnover) AS ForAssembly,
	|	DeliveryTurnover.Sender AS Sender
	|INTO TTToKitForTrip
	|FROM
	|	AccumulationRegister.Delivery.Turnovers(
	|			,
	|			,
	|			,
	|			Sender = &Warehouse
	|				AND (ReferenceOrder IN (&ShipmentReferences)
	|					OR &ByAllReferences)
	|				AND NOT ReferenceOrder IN
	|						(SELECT
	|							BlockedShipmentDocuments.DocumentShipments
	|						FROM
	|							BlockedShipmentDocuments AS BlockedShipmentDocuments)
	|				AND DeliveryMethod <> VALUE(Enum.TransportMethods25.SelfPickup)
	|				AND Arm = 1) AS DeliveryTurnover
	|		LEFT JOIN AccumulationRegister.Delivery AS PrimaryDataWithoutDeliveryOrder
	|		ON DeliveryTurnover.ReferenceOrder = PrimaryDataWithoutDeliveryOrder.ReferenceOrder
	|			AND (NOT DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND DeliveryTurnover.PlanningDocument = PrimaryDataWithoutDeliveryOrder.PlanningDocument
	|			AND DeliveryTurnover.RowCode = PrimaryDataWithoutDeliveryOrder.RowCode
	|			AND (PrimaryDataWithoutDeliveryOrder.PrimaryRegisterRecord)
	|		LEFT JOIN AccumulationRegister.Delivery AS PrimaryDataOnDeliveryOrder
	|		ON (DeliveryTurnover.ReferenceOrder = PrimaryDataOnDeliveryOrder.ReferenceOrder)
	|			AND (DeliveryTurnover.PlanningDocument REFS Document.DeliveryOrder)
	|			AND (PrimaryDataOnDeliveryOrder.PlanningDocument = UNDEFINED)
	|			AND (DeliveryTurnover.RowCode = PrimaryDataOnDeliveryOrder.RowCode)
	|			AND (PrimaryDataOnDeliveryOrder.PrimaryRegisterRecord)
	|		INNER JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	|		ON DeliveryTurnover.ReferenceOrder = DocumentsRegistry.Ref
	|			AND (NOT DocumentsRegistry.AdditionalRecord)
	|			AND (DocumentsRegistry.Partner = &Recipient)
	|WHERE
	|	DeliveryTurnover.ForAssemblyTurnover > 0
	|
	|GROUP BY
	|	CASE
	|		WHEN DocumentsRegistry.Partner IS NULL
	|			THEN DeliveryTurnover.ReferenceOrder
	|		WHEN DocumentsRegistry.Partner IN (&EmptyRecipient)
	|			THEN DeliveryTurnover.ReferenceOrder
	|		ELSE DocumentsRegistry.Partner
	|	END,
	|	DeliveryTurnover.Sender,
	|	DeliveryTurnover.Products,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.SourceShipmentDate, PrimaryDataOnDeliveryOrder.SourceShipmentDate),
	|	DeliveryTurnover.Characteristic,
	|	DeliveryTurnover.DateOfShipment,
	|	DeliveryTurnover.Trip,
	|	ISNULL(PrimaryDataWithoutDeliveryOrder.Purpose, PrimaryDataOnDeliveryOrder.Purpose),
	|	DeliveryTurnover.ReferenceOrder,
	|	DeliveryTurnover.Series
	|
	|INDEX BY
	|	ReferenceOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DataToBeShipped.DocumentShipments AS DocumentShipments,
	|	DataToBeShipped.Period AS Period,
	|	DataToBeShipped.Recipient AS Recipient,
	|	DataToBeShipped.Warehouse AS Warehouse,
	|	DataToBeShipped.Products AS Products,
	|	DataToBeShipped.Characteristic AS Characteristic,
	|	DataToBeShipped.Series AS Series,
	|	DataToBeShipped.Purpose AS Purpose,
	|	VALUE(Catalog.ControlledLots.EmptyRef) AS ControlledLotReference,
	|	SUM(DataToBeShipped.QuantityToShip) AS Count,
	|	DataToBeShipped.ShipmentUnderTransportationJob AS ShipmentUnderTransportationJob,
	|	CASE
	|		WHEN DataToBeShipped.ShipmentUnderTransportationJob
	|			THEN DataToBeShipped.TransportationJob
	|		ELSE UNDEFINED
	|	END AS TransportationJob
	|INTO GoodsToDeliver
	|FROM
	|	(SELECT
	|		GoodsForShipmentTurnover.DocumentShipments AS DocumentShipments,
	|		GoodsForShipmentTurnover.Period AS Period,
	|		CASE
	|			WHEN GoodsForShipmentTurnover.Recipient IN (&EmptyRecipient)
	|				THEN GoodsForShipmentTurnover.DocumentShipments
	|			ELSE GoodsForShipmentTurnover.Recipient
	|		END AS Recipient,
	|		GoodsForShipmentTurnover.Warehouse AS Warehouse,
	|		GoodsForShipmentTurnover.Products AS Products,
	|		GoodsForShipmentTurnover.Characteristic AS Characteristic,
	|		GoodsForShipmentTurnover.Series AS Series,
	|		GoodsForShipmentTurnover.Purpose AS Purpose,
	|		MAX(GoodsForShipmentTurnover.ToShipReceipt) - SUM(ISNULL(TTToDelivery.ToDeliver, 0)) AS QuantityToShip,
	|		0 AS QuantityToDelivery,
	|		FALSE AS ShipmentUnderTransportationJob,
	|		UNDEFINED AS TransportationJob
	|	FROM
	|		AccumulationRegister.GoodsForIssue.Turnovers(
	|				,
	|				,
	|				Day,
	|				Warehouse = &Warehouse
	|				AND Recipient = &Recipient
	|				AND (&ByAllReferences
	|					OR DocumentShipments IN (&ShipmentReferences))
	|				AND NOT DocumentShipments IN
	|						(SELECT
	|							BlockedShipmentDocuments.DocumentShipments
	|						FROM
	|							BlockedShipmentDocuments AS BlockedShipmentDocuments)
	|				AND &ConditionAcceptableDeviation) AS GoodsForShipmentTurnover
	|			LEFT JOIN TTToDelivery AS TTToDelivery
	|			ON GoodsForShipmentTurnover.DocumentShipments = TTToDelivery.ReferenceOrder
	|				AND GoodsForShipmentTurnover.Products = TTToDelivery.Products
	|				AND GoodsForShipmentTurnover.Characteristic = TTToDelivery.Characteristic
	|				AND GoodsForShipmentTurnover.Series = TTToDelivery.Series
	|				AND GoodsForShipmentTurnover.Purpose = TTToDelivery.Purpose
	|				AND GoodsForShipmentTurnover.Period = TTToDelivery.PrimaryShipmentDate
	|	
	|	GROUP BY
	|		GoodsForShipmentTurnover.DocumentShipments,
	|		GoodsForShipmentTurnover.Period,
	|		CASE
	|			WHEN GoodsForShipmentTurnover.Recipient IN (&EmptyRecipient)
	|				THEN GoodsForShipmentTurnover.DocumentShipments
	|			ELSE GoodsForShipmentTurnover.Recipient
	|		END,
	|		GoodsForShipmentTurnover.Warehouse,
	|		GoodsForShipmentTurnover.Products,
	|		GoodsForShipmentTurnover.Characteristic,
	|		GoodsForShipmentTurnover.Series,
	|		GoodsForShipmentTurnover.Purpose
	|	
	|	HAVING
	|		MAX(GoodsForShipmentTurnover.ToShipReceipt) - SUM(ISNULL(TTToDelivery.ToDeliver, 0)) <> 0
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		TTToKitForTrip.ReferenceOrder,
	|		TTToKitForTrip.FinalShipmentDate,
	|		TTToKitForTrip.Recipient,
	|		TTToKitForTrip.Sender,
	|		TTToKitForTrip.Products,
	|		TTToKitForTrip.Characteristic,
	|		TTToKitForTrip.Series,
	|		TTToKitForTrip.Purpose,
	|		TTToKitForTrip.ForAssembly,
	|		TTToKitForTrip.ForAssembly,
	|		TRUE,
	|		CASE
	|			WHEN TTToKitForTrip.Trip = VALUE(Document.Trip.EmptyRef)
	|				THEN UNDEFINED
	|			ELSE TTToKitForTrip.Trip
	|		END
	|	FROM
	|		TTToKitForTrip AS TTToKitForTrip
	|	WHERE
	|		(&ByAllReferences
	|			OR &TransportationTaskCompleted)) AS DataToBeShipped
	|WHERE
	|	(NOT &TransportationTaskCompleted
	|		OR DataToBeShipped.TransportationJob = &TransportationJob)
	|
	|GROUP BY
	|	DataToBeShipped.Characteristic,
	|	DataToBeShipped.Products,
	|	DataToBeShipped.Warehouse,
	|	DataToBeShipped.DocumentShipments,
	|	DataToBeShipped.Period,
	|	DataToBeShipped.Recipient,
	|	DataToBeShipped.Series,
	|	DataToBeShipped.ShipmentUnderTransportationJob,
	|	DataToBeShipped.Purpose,
	|	VALUE(Catalog.ControlledLots.EmptyRef),
	|	CASE
	|		WHEN DataToBeShipped.ShipmentUnderTransportationJob
	|			THEN DataToBeShipped.TransportationJob
	|		ELSE UNDEFINED
	|	END
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTToDelivery
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTToKitForTrip";
	QueriesTexts.Add(QueryText);
	
	QueryText = QueryTextOfShipmentSupplementAfterTaskForTransportationIsFormed25();
	QueriesTexts.Add(QueryText);
	
EndProcedure

Function QueryTextOfShipmentSupplementAfterTaskForTransportationIsFormed25()
	
	Result =
	"SELECT
	|	GoodsForIssue.Period							AS Period,
	|	GoodsForIssue.Warehouse							AS Warehouse,
	|	GoodsForIssue.Recipient						AS Recipient,
	|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|	GoodsForIssue.Products					AS Products,
	|	GoodsForIssue.Characteristic					AS Characteristic,
	|	GoodsForIssue.Purpose						AS Purpose,
	|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|	GoodsForIssue.Series							AS Series,
	|	GoodsForIssue.Count						AS Count,
	|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	GoodsForIssue.TransportationJob				AS TransportationJob,
	|	&AcceptableDeviationValue					AS AllowableVariance
	|INTO TTGoodsForShipment
	|FROM
	|	GoodsToDeliver AS GoodsForIssue
	|		,&ConnectionOfGoodsToDeliverySVTPermissibleDeviations AS T
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssue.Period							AS Period,
	|	GoodsForIssue.Warehouse							AS Warehouse,
	|	GoodsForIssue.Recipient						AS Recipient,
	|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|	GoodsForIssue.Products					AS Products,
	|	GoodsForIssue.Characteristic					AS Characteristic,
	|	GoodsForIssue.Purpose						AS Purpose,
	|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|	GoodsForIssue.Series							AS Series,
	|	GoodsForIssue.Count						AS Count,
	|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	GoodsForIssue.TransportationJob				AS TransportationJob,
	|	MAX(GoodsForIssue.AllowableVariance)	AS AllowableVariance
	|INTO GoodsForIssue
	|FROM
	|	TTGoodsForShipment AS GoodsForIssue
	|
	|GROUP BY
	|	GoodsForIssue.Period,
	|	GoodsForIssue.Warehouse,
	|	GoodsForIssue.Recipient,
	|	GoodsForIssue.DocumentShipments,
	|	GoodsForIssue.Products,
	|	GoodsForIssue.Characteristic,
	|	GoodsForIssue.Purpose,
	|	GoodsForIssue.ControlledLotReference,
	|	GoodsForIssue.Series,
	|	GoodsForIssue.Count,
	|	GoodsForIssue.ShipmentUnderTransportationJob,
	|	GoodsForIssue.TransportationJob
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP GoodsToDeliver
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTGoodsForShipment
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// GoodsForShipmentTurnover
	|SELECT
	|	BEGINOFPERIOD(GoodsForIssue.Period, DAY)	AS Period,
	|	GoodsForIssue.Warehouse						AS Warehouse,
	|	CASE
	|		WHEN GoodsForIssue.Recipient IN (&EmptyRecipient)
	|			THEN GoodsForIssue.DocumentShipments
	|		ELSE GoodsForIssue.Recipient
	|	END										AS Recipient,
	|	GoodsForIssue.DocumentShipments			AS DocumentShipments,
	|	GoodsForIssue.Products				AS Products,
	|	GoodsForIssue.Characteristic				AS Characteristic,
	|	GoodsForIssue.Purpose					AS Purpose,
	|	GoodsForIssue.ControlledLotReference		AS ControlledLotReference,
	|	GoodsForIssue.Series						AS Series,
	|	SUM(CASE
	|		WHEN (NOT &TransportationTaskCompleted
	|					OR GoodsForIssue.TransportationJob = &TransportationJob)
	|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Expense)
	|			THEN GoodsForIssue.ToShip
	|		ELSE 0
	|	END)										AS QuantityToShipExpense,
	|	SUM(CASE
	|		WHEN (NOT &TransportationTaskCompleted
	|					OR GoodsForIssue.TransportationJob = &TransportationJob)
	|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN GoodsForIssue.ForAssembly
	|		ELSE 0
	|	END)										AS QuantityToBuildReceipt,
	|	SUM(CASE
	|		WHEN (NOT &TransportationTaskCompleted
	|					OR GoodsForIssue.TransportationJob = &TransportationJob)
	|				AND GoodsForIssue.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN GoodsForIssue.AssemblyInProgress + GoodsForIssue.Assembled
	|		ELSE 0
	|	END)										AS QuantityInAssemblyReceipt,
	|	CASE
	|		WHEN VALUETYPE(GoodsForIssue.TransportationJob) = TYPE(Document.Trip)
	|				AND GoodsForIssue.TransportationJob <> VALUE(Document.Trip.EmptyRef)
	|			THEN TRUE
	|		ELSE FALSE
	|	END										AS ShipmentUnderTransportationJob,
	|	CASE
	|		WHEN VALUETYPE(GoodsForIssue.TransportationJob) = TYPE(Document.Trip)
	|				AND GoodsForIssue.TransportationJob <> VALUE(Document.Trip.EmptyRef)
	|			THEN GoodsForIssue.TransportationJob
	|		ELSE UNDEFINED
	|	END										AS TransportationJob
	|INTO GoodsForShipmentTurnover
	|FROM
	|	AccumulationRegister.GoodsForIssue AS GoodsForIssue
	|		LEFT JOIN BlockedShipmentDocuments AS BlockedShipmentDocuments
	|		ON GoodsForIssue.DocumentShipments = BlockedShipmentDocuments.DocumentShipments
	|
	|WHERE
	|	GoodsForIssue.Warehouse = &Warehouse
	|	AND GoodsForIssue.Recipient = &Recipient
	|	AND (&ByAllReferences
	|		OR GoodsForIssue.DocumentShipments IN (&ShipmentReferences))
	|	AND BlockedShipmentDocuments.DocumentShipments IS NULL
	|
	|GROUP BY
	|	BEGINOFPERIOD(GoodsForIssue.Period, DAY),
	|	GoodsForIssue.Warehouse,
	|	CASE
	|		WHEN GoodsForIssue.Recipient IN (&EmptyRecipient)
	|			THEN GoodsForIssue.DocumentShipments
	|		ELSE GoodsForIssue.Recipient
	|	END,
	|	GoodsForIssue.DocumentShipments,
	|	GoodsForIssue.Products,
	|	GoodsForIssue.Characteristic,
	|	GoodsForIssue.Purpose,
	|	GoodsForIssue.ControlledLotReference,
	|	GoodsForIssue.Series,
	|	CASE
	|		WHEN VALUETYPE(GoodsForIssue.TransportationJob) = TYPE(Document.Trip)
	|				AND GoodsForIssue.TransportationJob <> VALUE(Document.Trip.EmptyRef)
	|			THEN TRUE
	|		ELSE FALSE
	|	END,
	|	CASE
	|		WHEN VALUETYPE(GoodsForIssue.TransportationJob) = TYPE(Document.Trip)
	|				AND GoodsForIssue.TransportationJob <> VALUE(Document.Trip.EmptyRef)
	|			THEN GoodsForIssue.TransportationJob
	|		ELSE UNDEFINED
	|	END
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Cotgruzkerreferences/Collecting a sign-in + Collecting a sign-in
	|SELECT
	|	GoodsForIssue.Period							AS Period,
	|	GoodsForIssue.Warehouse							AS Warehouse,
	|	GoodsForIssue.Recipient						AS Recipient,
	|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|	GoodsForIssue.Products					AS Products,
	|	GoodsForIssue.Characteristic					AS Characteristic,
	|	GoodsForIssue.Purpose						AS Purpose,
	|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|	GoodsForIssue.Series							AS Series,
	|	SUM(GoodsForIssue.Count)				AS Count,
	|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	CASE
	|		WHEN GoodsForIssue.ShipmentUnderTransportationJob
	|			THEN GoodsForIssue.TransportationJob
	|		ELSE UNDEFINED
	|	END											AS TransportationJob
	|INTO GoodsToBeDeducted
	|FROM
	|	(SELECT
	|		GoodsForIssue.Period							AS Period,
	|		GoodsForIssue.Warehouse							AS Warehouse,
	|		GoodsForIssue.Recipient						AS Recipient,
	|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|		GoodsForIssue.Products					AS Products,
	|		GoodsForIssue.Characteristic					AS Characteristic,
	|		GoodsForIssue.Purpose						AS Purpose,
	|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|		GoodsForIssue.Series							AS Series,
	|		GoodsForIssue.QuantityToShipExpense		AS Count,
	|		GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|		GoodsForIssue.TransportationJob				AS TransportationJob
	|	FROM
	|		GoodsForShipmentTurnover AS GoodsForIssue
	|	WHERE
	|		GoodsForIssue.QuantityToShipExpense > 0
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		GoodsForIssue.Period							AS Period,
	|		GoodsForIssue.Warehouse							AS Warehouse,
	|		GoodsForIssue.Recipient						AS Recipient,
	|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|		GoodsForIssue.Products					AS Products,
	|		GoodsForIssue.Characteristic					AS Characteristic,
	|		GoodsForIssue.Purpose						AS Purpose,
	|		GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|		GoodsForIssue.Series							AS Series,
	|		GoodsForIssue.QuantityInAssemblyReceipt			AS Count,
	|		GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|		GoodsForIssue.TransportationJob				AS TransportationJob
	|	FROM
	|		GoodsForShipmentTurnover AS GoodsForIssue
	|	WHERE
	|		GoodsForIssue.QuantityInAssemblyReceipt > 0
	|	
	|	) GoodsForIssue
	|
	|GROUP BY
	|	GoodsForIssue.Period,
	|	GoodsForIssue.Warehouse,
	|	GoodsForIssue.Recipient,
	|	GoodsForIssue.DocumentShipments,
	|	GoodsForIssue.Products,
	|	GoodsForIssue.Characteristic,
	|	GoodsForIssue.Purpose,
	|	GoodsForIssue.ControlledLotReference,
	|	GoodsForIssue.Series,
	|	GoodsForIssue.ShipmentUnderTransportationJob,
	|	CASE
	|		WHEN GoodsForIssue.ShipmentUnderTransportationJob
	|			THEN GoodsForIssue.TransportationJob
	|		ELSE UNDEFINED
	|	END
	|
	|INDEX BY
	|	Period,
	|	Warehouse,
	|	Recipient,
	|	DocumentShipments,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series,
	|	TransportationJob
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// ForAssemblyReceipt
	|SELECT
	|	GoodsForIssue.Period							AS Period,
	|	GoodsForIssue.Warehouse							AS Warehouse,
	|	GoodsForIssue.Recipient						AS Recipient,
	|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|	GoodsForIssue.Products					AS Products,
	|	GoodsForIssue.Characteristic					AS Characteristic,
	|	GoodsForIssue.Purpose						AS Purpose,
	|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|	GoodsForIssue.Series							AS Series,
	|	GoodsForIssue.QuantityToBuildReceipt			AS Count,
	|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	CASE
	|		WHEN GoodsForIssue.ShipmentUnderTransportationJob
	|			THEN GoodsForIssue.TransportationJob
	|		ELSE UNDEFINED
	|	END											AS TransportationJob
	|INTO ProductsReadyForAssembly
	|FROM
	|	GoodsForShipmentTurnover AS GoodsForIssue
	|
	|WHERE
	|	GoodsForIssue.QuantityToBuildReceipt > 0
	|
	|INDEX BY
	|	Period,
	|	Warehouse,
	|	Recipient,
	|	DocumentShipments,
	|	Products,
	|	Characteristic,
	|	Purpose,
	|	ControlledLotReference,
	|	Series,
	|	TransportationJob
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	GoodsForIssue.Warehouse							AS Warehouse,
	|	GoodsForIssue.Recipient						AS Recipient,
	|	GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|	GoodsForIssue.Products					AS Products,
	|	GoodsForIssue.Characteristic					AS Characteristic,
	|	GoodsForIssue.Purpose						AS Purpose,
	|	GoodsForIssue.ControlledLotReference			AS ControlledLotReference,
	|	GoodsForIssue.Series							AS Series,
	|	GoodsForIssue.ShipmentUnderTransportationJob	AS ShipmentUnderTransportationJob,
	|	GoodsForIssue.TransportationJob				AS TransportationJob
	|INTO GoodsForIssueBalance
	|FROM
	|	(SELECT
	|		GoodsForIssue.Warehouse							AS Warehouse,
	|		GoodsForIssue.Recipient						AS Recipient,
	|		GoodsForIssue.DocumentShipments				AS DocumentShipments,
	|		GoodsForIssue.Products					AS Products,
	|		GoodsForIssue.Characteristic					AS Characteristic,
	|		GoodsForIssue.Purpose						AS Purpose,
