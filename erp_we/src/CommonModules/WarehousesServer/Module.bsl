								|en = 'Generate ""Inventory adjustment — Surpluses and shortages"" documents for Warehouse - %Warehouse%; Wareroom - %Premise%'; fa = 'Generate ""Inventory adjustment — Surpluses and shortages"" documents for Warehouse - %Warehouse%; Wareroom - %Premise%';
								|it = 'Generazione di correzioni di eccedenze e ammanchi delle merci per il magazzino - %Warehouse% e locale - %Premise%';
								|pl = 'Tworzenie zapisów korygujących nadwyżek i niedoborów dla miejsc towarowych na magazynie - %Warehouse%; Lokalu - %Premise%';
								|tr = 'Ambar - %Warehouse%; Depolama alanı- %Premise% tarafından kargo paketlerine göre fazlalıklar ve eksiklikler düzeltmelerinin oluşturulması'");
		JobDescription = StrReplace(JobDescription, "%Warehouse%", ParametersStructure.Warehouse);
		JobDescription = StrReplace(JobDescription, "%Premise%", ParametersStructure.Premise);
		
		ExportProcedureName = "WarehousesServer.GenerateAdjustmentsForSurplusShortagesByProductLocations";
		         
		ExportProcedureParameters = New Array();
		ExportProcedureParameters.Add(New Structure("ParametersStructure", ParametersStructure));
		
		JobParameters = New Array();
		JobParameters.Add(ExportProcedureName);
		JobParameters.Add(ExportProcedureParameters);
		
		Var_Key = "FormationOfAdjustmentsForSurplusShortagesInCommodityPlaces"
				+ String(ParametersStructure.Warehouse.UUID())
				+ String(ParametersStructure.Premise.UUID());
				
		Filter = New Structure();
		Filter.Insert("Key", Var_Key);
		Filter.Insert("State", BackgroundJobState.Active);
		
		ActiveTasks = BackgroundJobs.GetBackgroundJobs(Filter);
		
		If ActiveTasks.Count() > 0 Then
			Return;
		EndIf;
		
		BackgroundJobs.Execute("Common.ExecuteConfigurationMethod", JobParameters, Var_Key, JobDescription);
