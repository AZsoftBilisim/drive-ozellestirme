Procedure TakeItemToInternalWarehouse(Query, QueryTexts, Registers,
		QueryTextDocument_, MethodParameters)

	ReflectionTemplateTexts = New Structure();
	TextsOfDocumentDataRequests = New Structure();
	TemporaryTableQueryTexts_ = New Structure();

	TextsOfDocumentDataRequests.Insert(MethodParameters.SynonymForDocumentTable, QueryTextDocument_);
	ThisIsDiscrepancyReport = MethodParameters.ThisIsDiscrepancyReport;

	RequestTextTtToTakeGoodsToWarehouse = "SELECT
		|	DocumentData.Ref              AS Ref,
		|	DocumentData.Cell              AS Cell,
		|	DocumentData.Premise           AS Premise,
		|	DocumentData.Warehouse               AS Warehouse,
		|	DocumentData.Date                AS Date,
		|	DocumentData.Sender         AS Sender,
		|	DocumentData.ReferenceOrder        AS ReferenceOrder,
		|	DocumentData.Products        AS Products,
		|	DocumentData.Characteristic      AS Characteristic,
		|	DocumentData.Purpose          AS Purpose,
		|	CASE
		|		WHEN DocumentData.ToControlQuality
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.ToControlQuality AND DocumentData.RecordOfAPreviouslyReceivedLot
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReferenceItemsToBeReceived,
		|	DocumentData.Package            AS Package,
		|	DocumentData.Series               AS Series,
		|	DocumentData.BatchesIndicationStatus AS BatchesIndicationStatus,
		|	DocumentData.Count          AS Count,
		|	DocumentData.NumberOfPackages  AS NumberOfPackages,
		|	DocumentData.Accepted              AS Accepted,
		|	DocumentData.Accepts         AS Accepts,
		|	DocumentData.ThisIsAcceptanceWithoutOrder AS ThisIsAcceptanceWithoutOrder,
		|	DocumentData.BusinessOperation AS BusinessOperation
		|INTO TTTakeGoodsToWarehouse
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	NOT ISNULL(DocumentData.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|
		|UNION ALL
		|
		|SELECT
		|	GroupingTable.Ref              AS Ref,
		|	DocumentData.Cell                 AS Cell,
		|	DocumentData.Premise              AS Premise,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Date                   AS Date,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.ReferenceOrder           AS ReferenceOrder,
		|	GroupingTable.Products        AS Products,
		|	GroupingTable.Characteristic      AS Characteristic,
		|	GroupingTable.Purpose          AS Purpose,
		|	CASE
		|		WHEN GroupingTable.ToControlQuality
		|			THEN GroupingTable.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReference,
		|	CASE
		|		WHEN GroupingTable.ToControlQuality AND GroupingTable.RecordOfAPreviouslyReceivedLot
		|			THEN GroupingTable.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReferenceItemsToBeReceived,
		|	GroupingTable.Package            AS Package,
		|	GroupingTable.Series               AS Series,
		|	GroupingTable.BatchesIndicationStatus AS BatchesIndicationStatus,
		|	DocumentData.Count             AS Count,
		|	DocumentData.NumberOfPackages     AS NumberOfPackages,
		|	DocumentData.Accepted                 AS Accepted,
		|	DocumentData.Accepts            AS Accepts,
		|	DocumentData.ThisIsAcceptanceWithoutOrder AS ThisIsAcceptanceWithoutOrder,
		|	DocumentData.BusinessOperation AS BusinessOperation
		|FROM
		|	(SELECT
		|		DocumentData.Ref         AS Ref,
		|		DocumentData.Products   AS Products,
		|		DocumentData.Characteristic AS Characteristic,
		|		DocumentData.Purpose     AS Purpose,
		|		DocumentData.ToControlQuality AS ToControlQuality,
		|		DocumentData.RecordOfAPreviouslyReceivedLot AS RecordOfAPreviouslyReceivedLot,
		|		DocumentData.ControlledLotReference AS ControlledLotReference,
		|		DocumentData.Series          AS Series,
		|		MAX(DocumentData.Package) AS Package,
		|		DocumentData.BatchesIndicationStatus AS BatchesIndicationStatus
		|	FROM
		|		#DocumentData AS DocumentData
		|	WHERE
		|		ISNULL(DocumentData.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem)
		|	
		|	GROUP BY
		|		DocumentData.Ref,
		|		DocumentData.Products,
		|		DocumentData.Characteristic,
		|		DocumentData.Purpose,
		|		DocumentData.ToControlQuality,
		|		DocumentData.RecordOfAPreviouslyReceivedLot,
		|		DocumentData.ControlledLotReference,
		|		DocumentData.Series,
		|		DocumentData.BatchesIndicationStatus
		|
		|		) AS GroupingTable
		|		INNER JOIN #DocumentData AS DocumentData
		|		ON GroupingTable.Ref            = DocumentData.Ref
		|			AND GroupingTable.Products   = DocumentData.Products
		|			AND GroupingTable.Characteristic = DocumentData.Characteristic
		|			AND GroupingTable.Series          = DocumentData.Series
		|			AND GroupingTable.Purpose     = DocumentData.Purpose
		|			AND GroupingTable.Package       = DocumentData.Package
		|			AND GroupingTable.ToControlQuality = DocumentData.ToControlQuality
		|			AND GroupingTable.RecordOfAPreviouslyReceivedLot = DocumentData.RecordOfAPreviouslyReceivedLot
		|			AND GroupingTable.ControlledLotReference = DocumentData.ControlledLotReference
		|";

	RequestTextTtToTakeGoodsToWarehouse = StrReplace(RequestTextTtToTakeGoodsToWarehouse, "DocumentData", MethodParameters.SynonymForDocumentTable);
	TemporaryTableQueryTexts_.Insert("TTTakeGoodsToWarehouse", RequestTextTtToTakeGoodsToWarehouse);

	TemplateForGoodsToReceiveRequestText = "SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	DocumentData.Purpose             AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.ReferenceOrder           AS DocumentInflow,
		|	DocumentData.Count             AS Accepts,
		|	0                                      AS GoodsReceiptNotesToRegister,
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS ToRegisterReceiptsByReference,
		|	0                                      AS ToRegisterReceiptsByInvoices,
		|	DocumentData.BusinessOperation  AS BusinessOperation
		|FROM
		|	TTTakeGoodsToWarehouse AS DocumentData
		|WHERE
		|	&OrderSchemeIsUsedUponReceipt
		|	AND NOT DocumentData.Products = VALUE(Catalog.Products.EmptyRef)
		|	AND DocumentData.Accepts
		|	AND NOT DocumentData.ThisIsAcceptanceWithoutOrder
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	DocumentData.Purpose             AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.ReferenceOrder           AS DocumentInflow,
		|	0                                      AS Accepts,
		|	DocumentData.Count             AS GoodsReceiptNotesToRegister,
		|	0                                      AS ToRegisterGoodsReceipts,
		|	CASE
		|		WHEN &ThisIsDiscrepancyReport AND &UninvoicedReceiptDocumentIsUsed
		|			THEN DocumentData.Count
		|		ELSE 0
		|	END                                  AS ToRegisterReceiptsByReference,
		|	CASE
		|		WHEN &ThisIsDiscrepancyReport AND &UninvoicedReceiptDocumentIsUsed
		|			THEN DocumentData.Count
		|		ELSE 0
		|	END                                  AS ToRegisterReceiptsByInvoices,
		|	DocumentData.BusinessOperation  AS BusinessOperation
		|FROM
		|	TTTakeGoodsToWarehouse AS DocumentData
		|WHERE
		|	&OrderSchemeIsUsedUponReceipt
		|	AND DocumentData.Accepted
		|	AND NOT DocumentData.ThisIsAcceptanceWithoutOrder
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (14, 18)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.ReferenceOrder           AS DocumentInflow,
		|	0                                      AS Accepts,
		|	0                                      AS GoodsReceiptNotesToRegister,
		|	DocumentData.Count             AS ToRegisterGoodsReceipts,
		|	0                                      AS ToRegisterReceiptsByReference,
		|	0                                      AS ToRegisterReceiptsByInvoices,
		|	DocumentData.BusinessOperation  AS BusinessOperation
		|FROM
		|	TTTakeGoodsToWarehouse AS DocumentData
		|WHERE
		|	&OrderSchemeIsUsedUponReceipt
		|	AND NOT &ThisIsDiscrepancyReport
		|	AND DocumentData.Accepted
		|	AND NOT DocumentData.ThisIsAcceptanceWithoutOrder
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (14, 18)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.ReferenceOrder           AS DocumentInflow,
		|	0                                      AS Accepts,
		|	0                                      AS GoodsReceiptNotesToRegister,
		|	CASE
		|		WHEN NOT &UninvoicedReceiptDocumentIsUsed
		|			THEN DocumentData.Count
		|		ELSE 0
		|	END                                  AS ToRegisterGoodsReceipts,
		|	0                                      AS ToRegisterReceiptsByReference,
		|	0                                      AS ToRegisterReceiptsByInvoices,
		|	DocumentData.BusinessOperation  AS BusinessOperation
		|FROM
		|	TTTakeGoodsToWarehouse AS DocumentData
		|WHERE
		|	&OrderSchemeIsUsedUponReceipt
		|	AND &ThisIsDiscrepancyReport
		| AND NOT &UninvoicedReceiptDocumentIsUsed
		|	AND DocumentData.Accepted
		|	AND NOT DocumentData.ThisIsAcceptanceWithoutOrder
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|";

	RequestTextTemplateForProductsInWarehouses = "SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	DocumentData.ControlledLotReference AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Premise              AS Premise,
		|	DocumentData.Count             AS InStock,
		|	0                                      AS ToShip,
		|	FALSE                                   AS ToControlBalance
		|FROM
		|	TTTakeGoodsToWarehouse AS DocumentData
		|WHERE
		|	DocumentData.Accepted
		|	AND &ConditionsForOrderForAct
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|";

	QueryTextTemplateProductsInCells = "SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Cell                 AS Cell,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentData.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS Package,
		|	CASE
		|		WHEN DocumentData.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentData.NumberOfPackages
		|		ELSE DocumentData.Count
		|	END                                  AS InStock,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose
		|FROM
		|	#DocumentData AS DocumentData
		|	INNER JOIN InformationRegister.SettingsOfBinLocationWarehouses AS SettingsOfBinLocationWarehouses
		|	ON SettingsOfBinLocationWarehouses.UseBinLocationWarehousing
		|		AND SettingsOfBinLocationWarehouses.StartDateOfUsingWarehouseBinSystem <= DocumentData.Date
		|		AND SettingsOfBinLocationWarehouses.Warehouse = DocumentData.Warehouse
		|		AND SettingsOfBinLocationWarehouses.Premise = DocumentData.Premise
		|		AND (NOT DocumentData.Premise = VALUE(Catalog.Warerooms.EmptyRef)
		|			OR (NOT SettingsOfBinLocationWarehouses.Warehouse.UseWarerooms
		|				OR DocumentData.Date < SettingsOfBinLocationWarehouses.Warehouse.StartDateOfWareroomUse))
		|WHERE
		|	DocumentData.Accepted
		|";
	
	TemplateForGoodsToReceiveRequestText = StrReplace(TemplateForGoodsToReceiveRequestText, "DocumentData", MethodParameters.SynonymForDocumentTable);
	RequestTextTemplateForProductsInWarehouses = StrReplace(RequestTextTemplateForProductsInWarehouses, "DocumentData", MethodParameters.SynonymForDocumentTable);
	QueryTextTemplateProductsInCells = StrReplace(QueryTextTemplateProductsInCells, "DocumentData", MethodParameters.SynonymForDocumentTable);
	
	If ThisIsDiscrepancyReport Then
		TemplateForGoodsToReceiveRequestText = StrReplace(TemplateForGoodsToReceiveRequestText, "&ThisIsDiscrepancyReport",
			"TRUE");
		
		OrderConditionsForReport = "NOT &OrderSchemeIsUsedUponReceipt";
		RequestTextTemplateForProductsInWarehouses = StrReplace(RequestTextTemplateForProductsInWarehouses, "&ConditionsForOrderForAct", OrderConditionsForReport);
	Else
		TemplateForGoodsToReceiveRequestText = StrReplace(TemplateForGoodsToReceiveRequestText, "&ThisIsDiscrepancyReport",
			"FALSE");
		RequestTextTemplateForProductsInWarehouses = StrReplace(RequestTextTemplateForProductsInWarehouses, "&ConditionsForOrderForAct", "TRUE");
	EndIf;
	
	QueryOptions = ParametersOfDocumentDataRequestText("TakeGoodsToWarehouse", MethodParameters.SynonymForDocumentTable);
	FillInRequestTextParameters(TemplateForGoodsToReceiveRequestText, QueryOptions);
	FillInRequestTextParameters(RequestTextTemplateForProductsInWarehouses, QueryOptions);

	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsToReceive", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsToReceive", TemplateForGoodsToReceiveRequestText);
	EndIf;
	If DocumentsPosting.RequiresTableForRegisteredRecords("ProductStock", Registers) Then
		ReflectionTemplateTexts.Insert("ProductStock", RequestTextTemplateForProductsInWarehouses);
	EndIf;
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsInStorageBins", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsInStorageBins", QueryTextTemplateProductsInCells);
	EndIf;

	DocumentsPosting.AddDocumentReflectionRequest(Query, QueryTexts, ReflectionTemplateTexts, TextsOfDocumentDataRequests, TemporaryTableQueryTexts_);

EndProcedure

