// Function name of the warehouse field in the document.
//
// Parameters:
//  DocumentName - String	 - document name.
// 
// Returns:
//  String - the name of the warehouse field in the document.
//
Function NameOfWarehouseFieldByDocumentName(DocumentName) Export
	
	ManagerOfDocument = Documents[DocumentName];
	AttributesStructure1 = New Structure(ManagerOfDocument.NamesOfDetailsForFillingInParametersForSpecifyingSeries());
	SeriesSpecificationParameters = ManagerOfDocument.SeriesSpecificationParameters(AttributesStructure1);
	If SeriesSpecificationParameters.Property("WarehouseFieldName") Then
		WarehouseFieldName = SeriesSpecificationParameters.WarehouseFieldName;
	Else
		For Each KeyAndValue In SeriesSpecificationParameters Do
			WarehouseFieldName = KeyAndValue.Value.WarehouseFieldName;
			Break;
		EndDo;
	EndIf;
	
	Return WarehouseFieldName;
	
EndFunction

// Generates a list with subordinate warehouses, including the transferred one
//
// Parameters:
//  Warehouse	 - CatalogRef.Warehouses - the warehouse that the list is generated for.
// 
// Returns:
//  ValueList - a list with subordinate warehouses.
//
Function ListOfSubordinateWarehouses(Warehouse) Export
	
	List = New ValueList;
	
	If ValueIsFilled(Warehouse) Then
		QueryText =
		"SELECT ALLOWED
		|	Warehouses.Ref
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|WHERE
		|	Warehouses.Ref IN HIERARCHY(&Warehouse)
		|	AND (NOT Warehouses.IsFolder
		|			OR &ConditionForWarehouseGroup)";
		
		If GetFunctionalOption("UseWarehousesInTabularSectionsOfPurchaseDocuments") Then
			QueryText = StrReplace(QueryText, "&ConditionForWarehouseGroup",
				"Warehouses.SelectGroup = VALUE(Enum.SelectWarehouseGroup.AllowInOrdersAndInvoices)");
		Else
			QueryText = StrReplace(QueryText, "&ConditionForWarehouseGroup", "False");
		EndIf;
		Query = New Query(QueryText);
		Query.SetParameter("Warehouse", Warehouse);
		
		List.LoadValues(Query.Execute().Unload().UnloadColumn("Ref"));
	EndIf;
	
	Return List;
	
EndFunction

// Returns the name of the item grouping details
//
// Parameters:
//  Warehouse - CatalogRef.Warehouses - The warehouse where you want to find out the grouping of products.
// 
// Returns:
//  String - the name of the props of the directory Nomenclature.
Function GroupingOfGoods(Warehouse) Export
	
	Query = New Query;
	Query.Text = 
		"SELECT
		|	CASE
		|		WHEN HistoryOfChangesToStoreFormatsCrossSection.StoreFormat IS NULL
		|			THEN Warehouses.GroupingOfGoods
		|		ELSE ISNULL(HistoryOfChangesToStoreFormatsCrossSection.StoreFormat.GroupingOfGoods, ""Parent"")
		|	END AS Group
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|		LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast AS HistoryOfChangesToStoreFormatsCrossSection
		|		ON Warehouses.Ref = HistoryOfChangesToStoreFormatsCrossSection.Warehouse
		|WHERE
		|	Warehouses.Ref = &Warehouse";
	
	Query.SetParameter("Warehouse", Warehouse);
	
	QueryResult = Query.Execute();
	
	If QueryResult.IsEmpty() Then
		Return "Parent";
	EndIf;
	
	Selection = QueryResult.Select();
	While Selection.Next() Do
		If Selection.Group = "" Then
			Return "Parent";
		Else
			Return Selection.Group;
		EndIf;
	EndDo;
	
EndFunction

