EndProcedure

// Prepares final document reflection requests for warehouse registers:
// - Product selection
// - Goods in cells
//
// Parameters:
//  Query - Query - Request for document reflection.
//  QueryTexts - ValueList - List of document reflection request texts.
// 	Registers - Undefined, Structure, String - List of registers to reflect.
//  QueryTextDocument_ - String - The text of the document data selection request containing the following required fields:
//     * Ref                - DocumentRef - Link to the current document
//     * Date                  - Date - Date of receipt of the goods
//     * ReferenceOrder          - DocumentRef.GoodsIssueNote, DocumentRef.GoodsTransferNote - 
//     * Cell                - CatalogRef.StorageBins -
//     * Products          - CatalogRef.Products - 
//     * Characteristic        - CatalogRef.ItemsCharacteristics - 
//     * Purpose            - CatalogRef.Assignments - 
//     * Series                 - CatalogRef.ItemsBatches -
//     * Package              - CatalogRef.PackagesAndUnitsOfMeasure -
//     * Count            - Number - 
//     * NumberOfPackages    - Number - 
//     * BatchesIndicationStatus   - Number -
//     * Picked              - Boolean - Indicates that the product was selected from the cell (otherwise - in the selection process).
//     * IsFilter              - Boolean - Indicates that this is a selection operation (otherwise, it is a placement operation).
//     * ThisIsReflectionOfCells     - Boolean - Indicates that operations are being performed on cells (disabling this feature
//                                        may be necessary to generate movements only on the PH of the product Selection).
//
Procedure PickUpProducts(Query, QueryTexts, Registers,
		QueryTextDocument_) Export

	ReflectionTemplateTexts = New Structure();
	TextsOfDocumentDataRequests = New Structure();
	TemporaryTableQueryTexts_ = New Structure();

	TextsOfDocumentDataRequests.Insert("DocumentData", QueryTextDocument_);
	QueryTextTTPickUpProducts = "
		|SELECT
		|	DocumentData.Ref              AS Ref,
		|	DocumentData.Date                AS Date,
		|	DocumentData.ReferenceOrder        AS ReferenceOrder,
		|	DocumentData.Cell              AS Cell,
		|	DocumentData.Products        AS Products,
		|	DocumentData.Characteristic      AS Characteristic,
		|	DocumentData.Purpose          AS Purpose,
		|	DocumentData.Series               AS Series,
		|	DocumentData.Package            AS Package,
		|	DocumentData.Count          AS Count,
		|	DocumentData.NumberOfPackages  AS NumberOfPackages,
		|	DocumentData.BatchesIndicationStatus AS BatchesIndicationStatus,
		|	DocumentData.Picked            AS Picked,
		|	DocumentData.IsFilter            AS IsFilter,
		|	DocumentData.ThisIsReflectionOfCells   AS ThisIsReflectionOfCells,
		|	ISNULL(DocumentData.Package.PackageType, UNDEFINED) = VALUE(Enum.TypesOfItemsPackages.CargoItem) AS ItIsACargoItem,
		|	ISNULL(DocumentData.Package.MeasuredValueType, UNDEFINED) = VALUE(Enum.TypesOfMeasuredValues.Package) AS ThisIsPackaging
		|INTO TTSelectProducts
		|FROM
		|	#DocumentData AS DocumentData
		|";

	TemporaryTableQueryTexts_.Insert("TTSelectProducts", QueryTextTTPickUpProducts);

	TemplateForProductsForSelectionQueryText = "SELECT
		|	DocumentData.Date                   AS Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.ReferenceOrder           AS ReferenceOrder,
		|	CASE
		|		WHEN DocumentData.ItIsACargoItem
		|			THEN DocumentData.NumberOfPackages
		|		ELSE DocumentData.Count
		|	END                                  AS BeingPicked,
		|	0                                      AS Picked,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	CASE
		|		WHEN DocumentData.ItIsACargoItem
		|			THEN DocumentData.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS CargoItem
		|FROM
		|	TTSelectProducts AS DocumentData
		|WHERE
		|	NOT DocumentData.Picked
		|	AND DocumentData.IsFilter
		|	AND DocumentData.Count > 0
		|
		|UNION ALL
		|
		|SELECT
		|	DocumentData.Date                   AS Period,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.ReferenceOrder           AS ReferenceOrder,
		|	0                                      AS BeingPicked,
		|	CASE
		|		WHEN DocumentData.ItIsACargoItem
		|			THEN DocumentData.NumberOfPackages
		|		ELSE DocumentData.Count
		|	END                                  AS Picked,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	CASE
		|		WHEN DocumentData.ItIsACargoItem
		|			THEN DocumentData.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS CargoItem
		|FROM
		|	TTSelectProducts AS DocumentData
		|WHERE
		|	DocumentData.Picked
		|	AND DocumentData.IsFilter
		|	AND DocumentData.Count > 0
		|
		|UNION ALL
		|
		|SELECT
		|	DocumentData.Date                   AS Period,
		|	VALUE(AccumulationRecordType.Expense) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatus IN (6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.ReferenceOrder           AS ReferenceOrder,
		|	0                                      AS BeingPicked,
		|	CASE
		|		WHEN DocumentData.ItIsACargoItem
		|			THEN -DocumentData.NumberOfPackages
		|		ELSE -DocumentData.Count
		|	END                                  AS Picked,
		|	CASE
		|		WHEN ISNULL(DocumentData.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentData.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose,
		|	CASE
		|		WHEN DocumentData.ItIsACargoItem
		|			THEN DocumentData.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS CargoItem
		|FROM
		|	TTSelectProducts AS DocumentData
		|WHERE
		|	DocumentData.Picked
		|	AND DocumentData.IsFilter
		|	AND DocumentData.Count < 0
		|";

	QueryTextTemplateProductsInCells = "SELECT
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Date AS Period,
	|	DocumentData.Cell AS Cell,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS Package,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN -DocumentData.NumberOfPackages
	|		ELSE -DocumentData.Count
	|	END AS InStock,
	|	0 AS ForPicking,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	CASE
	|		WHEN ISNULL(AssignmentsTable.RecordsInWarehouseRegisters, FALSE)
	|			THEN DocumentData.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END AS Purpose
	|FROM
	|	TTSelectProducts AS DocumentData
	|		LEFT JOIN Catalog.Assignments AS AssignmentsTable
	|		ON DocumentData.Purpose = AssignmentsTable.Ref
	|WHERE
	|	DocumentData.Picked
	|	AND DocumentData.Count < 0
	|	AND DocumentData.ThisIsReflectionOfCells
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Date AS Period,
	|	DocumentData.Ref.ShippingZone AS Cell,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS Package,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.NumberOfPackages
	|		ELSE DocumentData.Count
	|	END AS InStock,
	|	0 AS ForPicking,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	CASE
	|		WHEN ISNULL(AssignmentsTable.RecordsInWarehouseRegisters, FALSE)
	|			THEN DocumentData.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END AS Purpose
	|FROM
	|	TTSelectProducts AS DocumentData
	|		LEFT JOIN Catalog.Assignments AS AssignmentsTable
	|		ON DocumentData.Purpose = AssignmentsTable.Ref
	|WHERE
	|	DocumentData.Picked
	|	AND DocumentData.IsFilter
	|	AND DocumentData.Ref.ShippingZone <> VALUE(Enum.TypesOfStorageCells.EmptyRef)
	|	AND CAST(DocumentData.Ref.ShippingZone AS
	|		Catalog.StorageBins).StorageBinType = VALUE(Enum.TypesOfStorageCells.ShipmentIncludingBalances)
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Date AS Period,
	|	DocumentData.Cell AS Cell,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS Package,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.NumberOfPackages
	|		ELSE DocumentData.Count
	|	END AS InStock,
	|	0 AS ForPicking,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	CASE
	|		WHEN ISNULL(AssignmentsTable.RecordsInWarehouseRegisters, FALSE)
	|			THEN DocumentData.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END AS Purpose
	|FROM
	|	TTSelectProducts AS DocumentData
	|		LEFT JOIN Catalog.Assignments AS AssignmentsTable
	|		ON DocumentData.Purpose = AssignmentsTable.Ref
	|WHERE
	|	DocumentData.Picked
	|	AND DocumentData.Count > 0
	|	AND DocumentData.ThisIsReflectionOfCells
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Date AS Period,
	|	DocumentData.Cell AS Cell,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.Package
	|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	|	END AS Package,
	|	0 AS InStock,
	|	CASE
	|		WHEN DocumentData.ThisIsPackaging
	|			THEN DocumentData.NumberOfPackages
	|		ELSE DocumentData.Count
	|	END AS ForPicking,
	|	CASE
	|		WHEN DocumentData.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
	|			THEN DocumentData.Series
	|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
	|	END AS Series,
	|	CASE
	|		WHEN ISNULL(AssignmentsTable.RecordsInWarehouseRegisters, FALSE)
	|			THEN DocumentData.Purpose
	|		ELSE VALUE(Catalog.Assignments.EmptyRef)
	|	END AS Purpose
	|FROM
	|	TTSelectProducts AS DocumentData
	|		LEFT JOIN Catalog.Assignments AS AssignmentsTable
	|		ON DocumentData.Purpose = AssignmentsTable.Ref
	|WHERE
	|	NOT DocumentData.Picked
	|	AND DocumentData.Count > 0
	|	AND DocumentData.ThisIsReflectionOfCells" + "
	|
	|";	
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForPicking", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForPicking", TemplateForProductsForSelectionQueryText);
	EndIf;
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsInStorageBins", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsInStorageBins", QueryTextTemplateProductsInCells);
	EndIf;

	DocumentsPosting.AddDocumentReflectionRequest(Query, QueryTexts, ReflectionTemplateTexts, TextsOfDocumentDataRequests, TemporaryTableQueryTexts_);

EndProcedure

// Prepares final document reflection requests for warehouse registers:
// - Goods in cells
//
// Parameters:
//  Query - Query - Request for document reflection.
//  QueryTexts - ValueList - List of document reflection request texts.
// 	Registers - Undefined, Structure, String - List of registers to reflect.
//  QueryTextDocument_ - String - The text of the document data selection request containing the following required fields:
//     * Ref                - DocumentRef - Link to the current document
//     * Date                  - Date - Date of receipt of the goods
//     * Warehouse                 - CatalogRef.Warehouses -
//     * Cell                - CatalogRef.StorageBins -
//     * Products          - CatalogRef.Products - 
//     * Characteristic        - CatalogRef.ItemsCharacteristics - 
//     * Purpose            - CatalogRef.Assignments - 
//     * Series                 - CatalogRef.ItemsBatches -
//     * Package              - CatalogRef.PackagesAndUnitsOfMeasure -
//     * Count            - Number -
//     * NumberOfPackages    - Number -
//     * BatchesIndicationStatus   - Number -
//     * Reserved         - Boolean - Indicates that the product is reserved in the cell of the acceptance zone for
//                                        subsequent placement.
//     * TakePlaces           - Boolean - Indicates that the product is in the process of being placed.
//     * Placed             - Boolean - Indicates that the product has been placed.
//
Procedure PlaceProducts(Query, QueryTexts, Registers,
		QueryTextDocument_) Export

	ReflectionTemplateTexts = New Structure();
	TextsOfDocumentDataRequests = New Structure();

	TextsOfDocumentDataRequests.Insert("DocumentDataIsStoredInCells", QueryTextDocument_);

	QueryTextTemplateProductsInCells = "SELECT
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Count > 0
		|			THEN VALUE(AccumulationRecordType.Receipt) 
		|		ELSE VALUE(AccumulationRecordType.Expense)
		|	END                                                AS RecordType,
		|	DocumentDataIsStoredInCells.Ref                 AS Recorder,
		|	DocumentDataIsStoredInCells.Date                   AS Period,
		|	DocumentDataIsStoredInCells.Cell                 AS Cell,
		|	DocumentDataIsStoredInCells.Products           AS Products,
		|	DocumentDataIsStoredInCells.Characteristic         AS Characteristic,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentDataIsStoredInCells.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS Package,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Count > 0
		|			THEN
		|				CASE
		|					WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|						THEN DocumentDataIsStoredInCells.NumberOfPackages
		|					ELSE DocumentDataIsStoredInCells.Count
		|				END
		|		ELSE
		|				CASE
		|					WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|						THEN -DocumentDataIsStoredInCells.NumberOfPackages
		|					ELSE -DocumentDataIsStoredInCells.Count
		|				END
		|	END                                  AS InStock,
		|	0                                      AS ForPicking,
		|	0                                      AS ForPlacement,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentDataIsStoredInCells.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentDataIsStoredInCells.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentDataIsStoredInCells.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose
		|FROM
		|	#DocumentDataIsStoredInCells AS DocumentDataIsStoredInCells
		|WHERE
		|	DocumentDataIsStoredInCells.Placed
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt)       AS RecordType,
		|	DocumentDataIsStoredInCells.Ref         AS Recorder,
		|	DocumentDataIsStoredInCells.Date           AS Period,
		|	DocumentDataIsStoredInCells.Cell         AS Cell,
		|	DocumentDataIsStoredInCells.Products   AS Products,
		|	DocumentDataIsStoredInCells.Characteristic AS Characteristic,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentDataIsStoredInCells.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS Package,
		|	0                                      AS InStock,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentDataIsStoredInCells.NumberOfPackages
		|		ELSE DocumentDataIsStoredInCells.Count
		|	END                                  AS ForPicking,
		|	0                                      AS ForPlacement,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentDataIsStoredInCells.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentDataIsStoredInCells.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentDataIsStoredInCells.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose
		|FROM
		|	#DocumentDataIsStoredInCells AS DocumentDataIsStoredInCells
		|WHERE
		|	DocumentDataIsStoredInCells.Reserved
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt)       AS RecordType,
		|	DocumentDataIsStoredInCells.Ref         AS Recorder,
		|	DocumentDataIsStoredInCells.Date           AS Period,
		|	DocumentDataIsStoredInCells.Cell         AS Cell,
		|	DocumentDataIsStoredInCells.Products   AS Products,
		|	DocumentDataIsStoredInCells.Characteristic AS Characteristic,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentDataIsStoredInCells.Package
		|		ELSE VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		|	END                                  AS Package,
		|	0                                      AS InStock,
		|	0                                      AS ForPicking,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.Package.MeasuredValueType = VALUE(Enum.TypesOfMeasuredValues.Package)
		|			THEN DocumentDataIsStoredInCells.NumberOfPackages
		|		ELSE DocumentDataIsStoredInCells.Count
		|	END                                  AS ForPlacement,
		|	CASE
		|		WHEN DocumentDataIsStoredInCells.BatchesIndicationStatus IN (4, 6, 8, 10, 14)
		|			THEN DocumentDataIsStoredInCells.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	CASE
		|		WHEN ISNULL(DocumentDataIsStoredInCells.Purpose.RecordsInWarehouseRegisters, FALSE)
		|			THEN DocumentDataIsStoredInCells.Purpose
		|		ELSE VALUE(Catalog.Assignments.EmptyRef)
		|	END                                  AS Purpose
		|FROM
		|	#DocumentDataIsStoredInCells AS DocumentDataIsStoredInCells
		|WHERE
		|	DocumentDataIsStoredInCells.TakePlaces
		|";
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsInStorageBins", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsInStorageBins", QueryTextTemplateProductsInCells);
	EndIf;
	
	DocumentsPosting.AddDocumentReflectionRequest(Query, QueryTexts, ReflectionTemplateTexts, TextsOfDocumentDataRequests);

EndProcedure

// Supplements the texts of the document request with the text that reflects the fact of reserving goods in the warehouse.
// The operation generates movements in the inventory accumulation register for the product Shipment.
//
// Parameters:
//	Query						- Query			- request to reflect the document in accounting.
//	QueryTexts				- ValueList	- collection of request texts for document reflection in accounting.
//	Registers					- Structure, String, Undefined - a collection of registers to reflect the document in accounting.
//	TextOfDocumentDataRequest	- String			- the text of the document data request.
//		Composition of selection fields:
//			* Ref				- DocumentRef								- link of the Registrar document.
//			* Period				- Date											- date when the operation was reflected.
//			* OrderDocument					- DocumentRef,
//										Undefined - link to the order document.
//																						If the field is empty, you must specify the default value.
//																						The default value is "UNDEFINED".
//			* Recipient			- DefinedType.SenderRecipientOfGoods	- recipient of the goods being shipped.
//			* Warehouse					- CatalogRef.Warehouses						- the warehouse from which you plan to ship the goods.
//			* Products			- CatalogRef.Products					- the product being shipped.
//			* Characteristic		- CatalogRef.ItemsCharacteristics	- characteristics of the product being shipped.
//			* Purpose			- CatalogRef.Assignments					- the purpose for which the product is shipped.
//			* ControlledLotReference  - CatalogRef.ControlledLots			- the controlled Lot reference, the item of which is being shipped.
//			* Series					- CatalogRef.ItemsBatches			- a series of goods to be shipped.
//			* BatchesIndicationStatus	- Number											- the status of the series indication.
//			* Count			- Number											- quantity of the product to be shipped.
//			* ExceedingOrder			- Boolean										- True - indicates that
//																						a larger quantity of goods is being shipped on the invoice based on the order than
//																						specified in the order.
//			* Canceled				- Boolean										- True - indicates that you do not need to ship the product by order.
//																						The default value is "FALSE".
//			* ThisIsAnInvoice			- Boolean										- True - indicates that the document is an invoice.
//			* ShipmentByOrder		- Boolean										- True - indicates that the shipment is being made by order.
//																						The default value is "FALSE".
//
Procedure ReflectReserve(Query, QueryTexts, Registers, TextOfDocumentDataRequest) Export
	
	QueryTextTemplate2 = 
	// Planning of the reserve for shipment (arrival by "VReserva").
	"SELECT
	|	&RecordTypeReceipt AS RecordType,
	|	DocumentData.Ref AS Recorder,
	|	DocumentData.Period AS Period,
	|	DocumentData.Warehouse AS Warehouse,
	|	DocumentData.Recipient AS Recipient,
	|	&DocumentShipments AS DocumentShipments,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	&Purpose AS Purpose,
	|	DocumentData.ControlledLotReference AS ControlledLotReference,
	|	&Series AS Series,
	|	DocumentData.Count AS InReserve,
	|	0 AS ToShip,
	|	0 AS ToRegister,
	|	0 AS ForAssembly,
	|	0 AS AssemblyInProgress,
	|	0 AS Assembled
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND NOT DocumentData.Canceled
	|	AND (NOT DocumentData.ThisIsAnInvoice
	|		OR ((DocumentData.ThisIsAnInvoice
	|				AND NOT DocumentData.ShipmentByOrder)
	|			OR DocumentData.ExceedingOrder))";
	
	QueryOptions = ParametersOfDocumentDataRequestText("ReflectReserve");
	FillInRequestTextParameters(QueryTextTemplate2, QueryOptions);
	
	ReflectionTemplateTexts = New Structure;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForIssue", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForIssue", QueryTextTemplate2);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure("DocumentData", TextOfDocumentDataRequest);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests,);
	
EndProcedure

// Supplements the texts of the request for the document with the text of the fact of planning the shipment of goods from the warehouse.
// The operation generates movements in the inventory accumulation register for the product Shipment.
//
// Parameters:
//	Query						- Query			- request to reflect the document in accounting.
//	QueryTexts				- ValueList of String	- collection of request texts for document reflection in accounting.
//	Registers					- Structure, String, Undefined - a collection of registers to reflect the document in accounting.
//	TextOfDocumentDataRequest	- String			- The Query Text of the document data with the following selection fields:
//			* Ref				- DocumentRef								- link of the Registrar document.
//			* Period				- Date											- date when the operation was reflected.
//			* OrderDocument					- DocumentRef,
//										Undefined - link to the order document.
//																						If the field is empty, you must specify the default value.
//																						The default value is "UNDEFINED".
//			* Recipient			- DefinedType.SenderRecipientOfGoods	- recipient of the goods being shipped.
//			* Warehouse					- CatalogRef.Warehouses						- the warehouse from which you plan to ship the goods.
//			* Products			- CatalogRef.Products					- the product being shipped.
//			* Characteristic		- CatalogRef.ItemsCharacteristics	- characteristics of the product being shipped.
//			* Purpose			- CatalogRef.Assignments					- the purpose for which the product is shipped.
//			* ControlledLotReference  - CatalogRef.ControlledLots			- the controlled Lot reference, the item of which is being shipped.
//			* Series					- CatalogRef.ItemsBatches			- a series of goods to be shipped.
//			* BatchesIndicationStatus	- Number											- the status of the series indication.
//			* Count			- Number											- quantity of the product to be shipped.
//			* ExceedingOrder			- Boolean										- True - indicates that
//																						a larger quantity of goods is being shipped on the invoice based on the order than
//																						specified in the order.
//			* Canceled				- Boolean										- True - indicates that you do not need to ship the product by order.
//																						The default value is "FALSE".
//			* ThisIsAnInvoice			- Boolean										- True - indicates that the document is an invoice.
//			* ShipmentByOrder		- Boolean										- True - indicates that the shipment is being made by order.
//																						The default value is "FALSE".
//
Procedure ScheduleShipmentOfGoods(Query, QueryTexts, Registers, TextOfDocumentDataRequest) Export
	
	QueryTextTemplate2 = 
	// Planning of shipment by order (arrival by "COtgruzke" and "Co-registration").
	"SELECT
	|	&RecordTypeReceipt 						AS RecordType,
	|	DocumentData.Ref 					AS Recorder,
	|	DocumentData.Period 					AS Period,
	|	DocumentData.Warehouse 					AS Warehouse,
	|	DocumentData.Recipient 				AS Recipient,
	|	&DocumentShipments 						AS DocumentShipments,
	|	DocumentData.Products 			AS Products,
	|	DocumentData.Characteristic 			AS Characteristic,
	|	&Purpose 							AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series 									AS Series,
	|	0 										AS InReserve,
	|	DocumentData.Count 				AS ToShip,
	|	DocumentData.Count 				AS ToRegister,
	|	0 										AS ForAssembly,
	|	0 										AS AssemblyInProgress,
	|	0 										AS Assembled
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND NOT DocumentData.Canceled
	|	AND NOT DocumentData.ThisIsAnInvoice
	|
	|UNION ALL
	|
	// Planning of shipment by waybill without an order from the order warehouse (arrival by "COtgruzke").
	|SELECT
	|	&RecordTypeReceipt 						AS RecordType,
	|	DocumentData.Ref 					AS Recorder,
	|	DocumentData.Period 					AS Period,
	|	DocumentData.Warehouse 					AS Warehouse,
	|	DocumentData.Recipient 				AS Recipient,
	|	&DocumentShipments 						AS DocumentShipments,
	|	DocumentData.Products 			AS Products,
	|	DocumentData.Characteristic 			AS Characteristic,
	|	&Purpose 							AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series 									AS Series,
	|	0 										AS InReserve,
	|	DocumentData.Count 				AS ToShip,
	|	DocumentData.Count 				AS ToRegister,
	|	0 										AS ForAssembly,
	|	0 										AS AssemblyInProgress,
	|	0 										AS Assembled
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.ThisIsAnInvoice
	|	AND NOT DocumentData.ShipmentByOrder
	|	AND &UseAdvancedWarehousing
	|
	|UNION ALL
	|
	// Planning of shipment by waybill in excess of the order (arrival by "COtgruzke" and "Co-registration").
	|SELECT
	|	&RecordTypeReceipt 						AS RecordType,
	|	DocumentData.Ref 					AS Recorder,
	|	DocumentData.Period 					AS Period,
	|	DocumentData.Warehouse 					AS Warehouse,
	|	DocumentData.Recipient 				AS Recipient,
	|	&DocumentShipments 						AS DocumentShipments,
	|	DocumentData.Products 			AS Products,
	|	DocumentData.Characteristic 			AS Characteristic,
	|	&Purpose 							AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series 									AS Series,
	|	0 										AS InReserve,
	|	DocumentData.Count 				AS ToShip,
	|	DocumentData.Count 				AS ToRegister,
	|	0 										AS ForAssembly,
	|	0 										AS AssemblyInProgress,
	|	0 										AS Assembled
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.ThisIsAnInvoice
	|	AND DocumentData.ShipmentByOrder
	|	AND DocumentData.ExceedingOrder
	|
	|UNION ALL
	|
	// Planning of shipment by waybill without an order in a non-standard warehouse for delivery (arrival by "COtgruzke").
	|SELECT
	|	&RecordTypeReceipt 						AS RecordType,
	|	DocumentData.Ref 					AS Recorder,
	|	DocumentData.Period 					AS Period,
	|	DocumentData.Warehouse 					AS Warehouse,
	|	DocumentData.Recipient 				AS Recipient,
	|	&DocumentShipments 						AS DocumentShipments,
	|	DocumentData.Products 			AS Products,
	|	DocumentData.Characteristic 			AS Characteristic,
	|	&Purpose 							AS Purpose,
	|	DocumentData.ControlledLotReference 	AS ControlledLotReference,
	|	&Series 									AS Series,
	|	0 										AS InReserve,
	|	DocumentData.Count 				AS ToShip,
	|	DocumentData.Count 				AS ToRegister,
	|	0 										AS ForAssembly,
	|	0 										AS AssemblyInProgress,
	|	0 										AS Assembled
	|FROM
	|	#DocumentData AS DocumentData
	|
	|WHERE
	|	&ThisIsAProduct
	|	AND DocumentData.ThisIsAnInvoice
	|	AND NOT DocumentData.ShipmentByOrder
	|	AND NOT &UseAdvancedWarehousing";
	
	QueryOptions = ParametersOfDocumentDataRequestText("ScheduleShipmentOfGoods");
	FillInRequestTextParameters(QueryTextTemplate2, QueryOptions);
	
	ReflectionTemplateTexts = New Structure;
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsForIssue", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsForIssue", QueryTextTemplate2);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure("DocumentData", TextOfDocumentDataRequest);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests);
	
EndProcedure

// Supplements the texts of the request for the document with the texts that reflect the registration of the shipment of goods from the warehouse
// and the actual shipment from a non-registered warehouse.
// The operation generates movements in the registers of accumulation of goods on Shipment and goods in Warehouses.
//
// Parameters:
//	Query						- Query			- request to reflect the document in accounting.
//	QueryTexts				- ValueList	- collection of request texts for document reflection in accounting.
//	Registers					- Structure, String, Undefined - a collection of registers to reflect the document in accounting.
//	TextOfDocumentDataRequest	- String			- the text of the document data request.
//		Composition of selection fields:
//			* Ref				- DocumentRef								- link of the Registrar document.
//			* Period				- Date											- date when the operation was reflected.
//			* OrderDocument					- DocumentRef,
//										Undefined - link to the order document.
//																						If the field is empty, you must specify the default value.
//																						The default value is "UNDEFINED".
//			* Recipient			- DefinedType.SenderRecipientOfGoods	- recipient of the goods being shipped.
//			* Warehouse					- CatalogRef.Warehouses						- the warehouse where the shipment of goods is processed.
//			* Products			- CatalogRef.Products					- the product being shipped.
//			* Characteristic		- CatalogRef.ItemsCharacteristics	- characteristics of the product being shipped.
//			* Purpose			- CatalogRef.Assignments					- the purpose for which the product is shipped.
//			* ControlledLotReference  - CatalogRef.ControlledLots, Undefined - the controlled Lot reference, the item of which is shipped
