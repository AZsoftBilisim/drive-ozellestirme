Function ThereIsOrderWarehouseForShipment(Warehouses = Undefined, Date = Undefined, Warehouse = Undefined) Export
	
	If Not GetFunctionalOption("UseWarehouseManagementSystem") Then
		Return False;
	EndIf;
	
