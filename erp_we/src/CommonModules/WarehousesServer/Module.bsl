		ReflectionTemplateTexts.Insert("ProductStock", RequestTextTemplateForProductsInWarehouses);
	EndIf;
	
	TextsOfDocumentDataRequests = New Structure(SynonymForDocumentTS, TextOfDocumentDataRequest);
	
	DocumentsPosting.AddDocumentReflectionRequest(Query,
															QueryTexts,
															ReflectionTemplateTexts,
															TextsOfDocumentDataRequests);
	
EndProcedure

Procedure ScheduleArrivalOfGoodsInternal(Query, QueryTexts, Registers,
		QueryTextDocument_, MethodParameters, ServicesAndWorksAreCountedInRegisteredRecords = False)
	
	SynonymForDocumentTable = MethodParameters.SynonymForDocumentTable;
	ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder 
		= MethodParameters.ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder;
	ThisIsDiscrepancyReport = MethodParameters.ThisIsDiscrepancyReport;
	
	TemporaryTableQueryTexts_ = New Structure();
	
	QueryTextTTGoods = 
	"SELECT
	|	DocumentData.Ref AS Ref,
	|	DocumentData.Patch AS Patch,
	|	DocumentData.CorrectedDocument AS CorrectedDocument,
	|	DocumentData.OrderDocument AS OrderDocument,
	|	DocumentData.Invoice AS Invoice,
	|	DocumentData.Contract AS Contract,
	|	DocumentData.Terms AS Terms,
	|	DocumentData.GoodsReceiptOption AS GoodsReceiptOption,
	|	&ServiceReceiptOption AS ServiceReceiptOption,
	|	DocumentData.Sender AS Sender,
	|	DocumentData.BusinessOperation AS BusinessOperation,
	|	DocumentData.ExceedingOrder AS ExceedingOrder,
	|	DocumentData.ReceiptUnderOrders AS ReceiptUnderOrders,
	|	DocumentData.ThisIsAnInvoice AS ThisIsAnInvoice,
	|	DocumentData.Date AS Date,
	|	DocumentData.Products AS Products,
	|	DocumentData.Characteristic AS Characteristic,
	|	&Purpose AS Purpose,
	|	CASE
	|		WHEN DocumentData.RecordOfAPreviouslyReceivedLot AND DocumentData.ToControlQuality
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END AS ControlledLotReferenceItemsToBeReceived,
	|	DocumentData.BatchesIndicationStatus AS BatchesIndicationStatus,
	|	DocumentData.Series AS Series,
	|	DocumentData.Warehouse AS Warehouse,
	|	SUM(DocumentData.Count) AS Count
	|INTO TTGoodsScheduleArrivalOfGoods
	|FROM
	|	#DocumentData AS DocumentData
	|
	|GROUP BY
	|	DocumentData.Ref,
	|	DocumentData.Patch,
	|	DocumentData.CorrectedDocument,
	|	DocumentData.OrderDocument,
	|	DocumentData.Invoice,
	|	DocumentData.Contract,
	|	DocumentData.Terms,
	|	DocumentData.GoodsReceiptOption,
	|	&ServiceReceiptOption,
	|	DocumentData.Sender,
	|	DocumentData.BusinessOperation,
	|	DocumentData.ExceedingOrder,
	|	DocumentData.ReceiptUnderOrders,
	|	DocumentData.ThisIsAnInvoice,
	|	DocumentData.Date,
	|	DocumentData.Products,
	|	DocumentData.Characteristic,
	|	&Purpose,
	|	CASE
	|		WHEN DocumentData.RecordOfAPreviouslyReceivedLot AND DocumentData.ToControlQuality
	|			THEN DocumentData.ControlledLotReference
	|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
	|	END,
	|	DocumentData.BatchesIndicationStatus,
	|	DocumentData.Series,
	|	DocumentData.Warehouse";
	
	QueryOptions = ParametersOfDocumentDataRequestText("ScheduleGoodsReceipt", SynonymForDocumentTable, 
		ServicesAndWorksAreCountedInRegisteredRecords);
	
	FillInRequestTextParameters(QueryTextTTGoods, QueryOptions);
	
	If ServicesAndWorksAreCountedInRegisteredRecords Then
		QueryTextTTGoods = StrReplace(QueryTextTTGoods, "&ServiceReceiptOption", "DocumentData.ServiceReceiptOption");
	Else
		QueryTextTTGoods = StrReplace(QueryTextTTGoods, "&ServiceReceiptOption", "UNDEFINED");
	EndIf;
	
	QueryTextTTGoods = StrReplace(QueryTextTTGoods, "DocumentData", SynonymForDocumentTable);
	
	TemporaryTableQueryTexts_.Insert("TTGoodsScheduleArrivalOfGoods", QueryTextTTGoods);
	
	QueryTextTemplate2 =
		"SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.OrderDocument                  AS DocumentInflow,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	&RequirementsForRegistrationOfInvoicesByOrder AS Series,
		|	DocumentData.Count             AS ToRegisterInvoicesByReference,
		|	0                                      AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	NOT DocumentData.ThisIsAnInvoice
		// Redundant condition for the Act of discrepancies after the move.
		|	AND NOT DocumentData.ExceedingOrder
		|	AND DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OwnGoods),
		|		 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND DocumentData.Count <> 0
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	
		|	CASE
		|		WHEN DocumentData.GoodsReceiptOption IN(
		|				VALUE(Enum.GoodsReceiptOptions.GoodsReceiptWithoutReferenceToOrdersAndInvoicesAllowed),
		|				VALUE(Enum.GoodsReceiptOptions.NotDividedByOrdersAndInvoices),
		// only for one-way traffic, in two-way traffic the order does not make a Receipt
		|				VALUE(Enum.GoodsReceiptOptions.NotSeparatedByInvoices))
		|			THEN DocumentData.Terms
		|		WHEN DocumentData.GoodsReceiptOption IN(
		|				VALUE(Enum.GoodsReceiptOptions.UnderContractsWithoutOrdersAndInvoices),
		|				VALUE(Enum.GoodsReceiptOptions.ByContractsAfterOrdersOrInvoices),
		// only for one-way traffic, in two-way traffic the order does not make a Receipt
		|				VALUE(Enum.GoodsReceiptOptions.ByContractsAfterInvoices))
		|			THEN DocumentData.Contract
		|		WHEN DocumentData.GoodsReceiptOption IN(
		|			VALUE(Enum.GoodsReceiptOptions.DividedByOrdersAndInvoices),
		// only for one-way traffic, in two-way traffic the order does not make a Receipt. A feature, since the RegisterRecorded makes an order, the receipt document cannot be a bill of lading.
		|			VALUE(Enum.GoodsReceiptOptions.SplitByInvoicesOnly),
		// in some documents, the Product Acceptance option field is not filled in
		|			VALUE(Enum.GoodsReceiptOptions.EmptyRef),
		// in some documents, there is no option field for accepting products
		|			UNDEFINED)
		|		THEN DocumentData.OrderDocument
		|	END AS DocumentInflow,
		|	
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	0                                      AS ToRegisterInvoicesByReference,
		|	DocumentData.Count             AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OwnGoods),
		|		 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND NOT DocumentData.ThisIsAnInvoice
		|	AND NOT (&UninvoicedReceiptDocumentIsUsed
		|			AND (&InvoiceIsOrder OR &ByContractsAfterInvoices))
		// Redundant condition, needed only for the Act of discrepancies after the move.
		|	AND NOT DocumentData.ReceiptUnderOrders
		|	AND DocumentData.Count <> 0
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	CASE
		|		WHEN &OdnohodovkaReceiptDocument <> UNDEFINED
		|			THEN
		|				&OdnohodovkaReceiptDocument
		|			ELSE
		|				DocumentData.Invoice
		|	END                                  AS DocumentInflow,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	0                                      AS ToRegisterInvoicesByReference,
		|	DocumentData.Count             AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OwnGoods),
		|		 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND 
		|		(DocumentData.ThisIsAnInvoice
		|		 AND &UninvoicedReceiptDocumentIsUsed
		|		 AND (&InvoiceIsOrder
		|			OR DocumentData.ExceedingOrder
		|			OR NOT DocumentData.ReceiptUnderOrders
		|			OR &ByContractsAfterInvoices))
		|		OR
		|		(
		// To take into account the situation when two-way is used in documents where there is no special second invoice,
		// for example, for Assembling goods (not on order). And also for invoices not on order with one-pass.
		|		NOT &UninvoicedReceiptDocumentIsUsed
		|		AND DocumentData.ThisIsAnInvoice
		|		AND (DocumentData.ExceedingOrder
		|			OR NOT DocumentData.ReceiptUnderOrders)
		|		AND DocumentData.Products.ItemsType IN
		|				(VALUE(Enum.ItemsTypes.OwnGoods),
		|				 VALUE(Enum.ItemsTypes.ReusablePackage))
		|		)
		|	AND DocumentData.Count <> 0
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	&OdnohodovkaReceiptDocument        AS DocumentInflow,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	0                                      AS ToRegisterInvoicesByReference,
		|	0                                      AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	DocumentData.Count             AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OwnGoods),
		|		 VALUE(Enum.ItemsTypes.ReusablePackage))
		|	AND &OrderSchemeIsUsedUponReceipt
		|	AND (NOT DocumentData.ThisIsAnInvoice
		|		AND &OdnohodovkaReceiptDocument <> UNDEFINED
		|		AND NOT &InvoiceIsOrder
		|	  OR
		|		DocumentData.ThisIsAnInvoice
		|		AND (&InvoiceIsOrder
		|			OR DocumentData.ExceedingOrder
		|			OR NOT DocumentData.ReceiptUnderOrders
		|			OR &ByContractsAfterInvoices)
		// For the act of discrepancies after the move.
		|	  OR
		|		(
		|			&ThisIsDiscrepancyReport
		|			AND NOT DocumentData.ThisIsAnInvoice
		|			AND &OdnohodovkaReceiptDocument <> UNDEFINED
		|			AND &InvoiceIsOrder
		|		)
		|	)
		|	AND DocumentData.Count <> 0
		|
		|UNION ALL
		|
		// Works and services
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.OrderDocument                  AS DocumentInflow,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	&RequirementsForRegistrationOfInvoicesByOrder AS Series,
		|	DocumentData.Count             AS ToRegisterInvoicesByReference,
		|	0                                      AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	NOT DocumentData.ThisIsAnInvoice
		// Redundant condition for the Act of discrepancies after the move.
		|	AND NOT DocumentData.ExceedingOrder
		|	AND DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OperationService),
		|		 VALUE(Enum.ItemsTypes.Work_5))
		|	AND &ServicesAndWorksAreCountedInRegisteredRecords
		|	AND DocumentData.Count <> 0
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	CASE
		|		WHEN &DocumentOfReceiptOfOneWayServices <> UNDEFINED
		|			THEN
		|				&DocumentOfReceiptOfOneWayServices
		|			ELSE
		|				DocumentData.OrderDocument
		|	END                                  AS DocumentInflow,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	0                                      AS ToRegisterInvoicesByReference,
		|	DocumentData.Count             AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.OperationService),
		|		 VALUE(Enum.ItemsTypes.Work_5))
		|	AND &ServicesAndWorksAreCountedInRegisteredRecords
		|	AND NOT DocumentData.ThisIsAnInvoice
		|	AND NOT &InvoiceForServicesIsOrder
		|	AND NOT &UnderContractsForServicesAfterInvoices
		// Redundant condition, needed only for the Act of discrepancies after the move.
		|	AND NOT DocumentData.ReceiptUnderOrders
		|	AND DocumentData.Count <> 0
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	CASE
		|		WHEN &DocumentOfReceiptOfOneWayServices <> UNDEFINED
		|			THEN
		|				&DocumentOfReceiptOfOneWayServices
		|			ELSE
		|				DocumentData.Invoice
		|	END                                  AS DocumentInflow,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	DocumentData.ControlledLotReferenceItemsToBeReceived AS ControlledLotReference,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	DocumentData.Sender            AS Sender,
		|	DocumentData.BusinessOperation  AS BusinessOperation,
		|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		|	0                                      AS ToRegisterInvoicesByReference,
		|	DocumentData.Count             AS ToRegisterReceiptsByReference,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterReceiptsByInvoices,
		// Not used, needed for adapted text.
		|	0                                      AS ToRegisterGoodsReceipts,
		|	0                                      AS GoodsReceiptNotesToRegister
		|FROM
		|	TTGoodsScheduleArrivalOfGoods AS DocumentData
		|	,&AdditionalConnections
		|WHERE
		|	DocumentData.Products.ItemsType IN
		|		(VALUE(Enum.ItemsTypes.Work_5),
		|		 VALUE(Enum.ItemsTypes.OperationService))
		|	AND &ServicesAndWorksAreCountedInRegisteredRecords
		|	AND 
		|		(DocumentData.ThisIsAnInvoice
		|		 AND (&InvoiceForServicesIsOrder
		|			OR DocumentData.ExceedingOrder
		|			OR NOT DocumentData.ReceiptUnderOrders
		|			OR &UnderContractsForServicesAfterInvoices))
		|	AND DocumentData.Count <> 0
		|";
	
	If Not ItIsRequiredToTakeIntoAccountRequirementsForIssuingInvoicesByOrder Then
		QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "&RequirementsForRegistrationOfInvoicesByOrder",
			"VALUE(Catalog.ItemsBatches.EmptyRef)");
	EndIf;
	If ThisIsDiscrepancyReport Then
		QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "&ThisIsDiscrepancyReport",
			"TRUE");
	Else
		QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "&ThisIsDiscrepancyReport",
			"FALSE");
	EndIf;
	
	QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "DocumentData", SynonymForDocumentTable);
	
	If ServicesAndWorksAreCountedInRegisteredRecords Then
		
		TextOfConditionsForReflectingWorksAndServices = 
		"(DocumentData.Contract.OptionForRegisteringServiceReceiptDocuments IN (VALUE(Enum.OptionsForRegisteringServiceDocuments.ReceiptOfServicesIsInvoiced), 
		|	VALUE(Enum.OptionsForRegisteringServiceDocuments.ReceiptOfServicesIsReversed))
		|	AND DocumentData.BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt),
		|										VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)))";
		TextOfConditionsForReflectingWorksAndServices = StrReplace(TextOfConditionsForReflectingWorksAndServices, "DocumentData", SynonymForDocumentTable);
		
		QueryOptions.Insert("ServicesAndWorksAreCountedInRegisteredRecords", TextOfConditionsForReflectingWorksAndServices);
		
	Else
		
		QueryOptions.Insert("ServicesAndWorksAreCountedInRegisteredRecords", "FALSE");
		
	EndIf;
	
	FillInRequestTextParameters(QueryTextTemplate2, QueryOptions);
	
	ReflectionTemplateTexts = New Structure();
	
	If DocumentsPosting.RequiresTableForRegisteredRecords("GoodsToReceive", Registers) Then
		ReflectionTemplateTexts.Insert("GoodsToReceive", QueryTextTemplate2);
	EndIf;

	TextsOfDocumentDataRequests = New Structure(SynonymForDocumentTable, QueryTextDocument_);
	DocumentsPosting.AddDocumentReflectionRequest(Query, QueryTexts, ReflectionTemplateTexts, TextsOfDocumentDataRequests, TemporaryTableQueryTexts_);

EndProcedure

Procedure ToIssueReceiptOfGoodsOnTwoWayInternal(Query,
													QueryTexts,
													Registers,
													QueryTextDocument_,
													MetadataObject,
													MethodParameters,
													SelectionIsRequiredBasedOnOrderOfWarehouseUponReceipt = False)
	
	TSSeriesName = MethodParameters.TSSeriesName;
	SynonymForDocumentTable = MethodParameters.SynonymForDocumentTable;
	ServicesAndWorksAreCountedInRegisteredRecords = MethodParameters.ServicesAndWorksAreCountedInRegisteredRecords;
	
	If TSSeriesName <> "" Then
		
		RequestTextTemplateForProductsInWarehouses =
		"SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	CASE
		|		WHEN DocumentData.ToControlQuality
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatusInWarehouses IN(4, 6, 8, 10, 14)
		|			THEN DocumentData.Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
		|	DocumentData.Count             AS InStock,
		|	0                                      AS ToShip,
		|	FALSE                                   AS ToControlBalance
		|FROM
		|	#DocumentData AS DocumentData
		|WHERE
		|	NOT (&OrderSchemeIsUsedUponReceipt)
		|	AND (NOT DocumentData.BatchesIndicationStatusInWarehouses IN(4, 6, 8, 10)
		|		OR DocumentData.Series <> VALUE(Catalog.ItemsBatches.EmptyRef))
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	DocumentData.Ref                 AS Recorder,
		|	DocumentData.Date                   AS Period,
		|	DocumentData.Products           AS Products,
		|	DocumentData.Characteristic         AS Characteristic,
		|	&Purpose                            AS Purpose,
		|	CASE
		|		WHEN DocumentData.ToControlQuality
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END AS ControlledLotReference,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatusInWarehouses IN(4, 6, 8, 10)
		|			THEN &Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END                                  AS Series,
		|	DocumentData.Warehouse                  AS Warehouse,
		|	VALUE(Catalog.Warerooms.EmptyRef) AS Premise,
		|	MAX(&Count)                  AS InStock,
		|	0                                      AS ToShip,
		|	FALSE                                   AS ToControlBalance
		|FROM
		|	#DocumentData AS DocumentData
		|		INNER JOIN &TSSeriesName AS SeriesData_
		|		ON DocumentData.Ref = SeriesData_.Ref
		|			AND &ConditionForJoiningTables
		|
		|WHERE
		|	NOT (&OrderSchemeIsUsedUponReceipt)
		|	AND DocumentData.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		|	AND DocumentData.Products.ItemsType IN
		|			(VALUE(Enum.ItemsTypes.OwnGoods),
		|			 VALUE(Enum.ItemsTypes.ReusablePackage))
		|
		|GROUP BY
		|	SeriesData_.LineNumber,
		|	DocumentData.Ref,
		|	DocumentData.Date,
		|	DocumentData.Products,
		|	DocumentData.Characteristic,
		|	DocumentData.BatchesIndicationStatusInWarehouses,
		|	&Purpose,
		|	CASE
		|		WHEN DocumentData.ToControlQuality
		|			THEN DocumentData.ControlledLotReference
		|		ELSE VALUE(Catalog.ControlledLots.EmptyRef)
		|	END,
		|	DocumentData.Warehouse,
		|	CASE
		|		WHEN DocumentData.BatchesIndicationStatusInWarehouses IN(4, 6, 8, 10)
		|			THEN &Series
		|		ELSE VALUE(Catalog.ItemsBatches.EmptyRef)
		|	END
		|
		|HAVING
