	Else
		
		CheckDate = ?(ValueIsFilled(Date), Date, CurrentSessionDate());
		Query = New Query;
		Query.Text = 
		"SELECT ALLOWED TOP 1
		|	Warehouses.Ref
		|FROM
		|	Catalog.Warehouses AS Warehouses
		|WHERE
		|	Warehouses.Ref IN HIERARCHY(&Warehouses)
		|	AND Warehouses.UseWarehouseManagemantSystemForGoodsIssue
