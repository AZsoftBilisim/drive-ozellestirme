#Region Public

#Region Posting

// Generates parameters for conducting a document on the registers of the accounting mechanism through the General mechanism of conducting.
//
// Parameters:
//  Document - DocumentObject - recordable document
//  Properties - See DocumentsPosting.DocumentProperties
//
// Returns:
//  Structure - See DocumentsPosting.ParametersOfAccountingMechanism
//
Function ParametersForHoldingDocument(Document, Properties) Export
	
	Parameters = DocumentsPosting.ParametersOfAccountingMechanism();
	
	AdditionalDocuments_ = New Structure;
	DocumentsPostingLocalization.FillInLocalDocumentsOfMovementOfGoods(AdditionalDocuments_);
	
	// Posting
	If Properties.WriteMode = DocumentWriteMode.Posting Then
		
		DocumentType = TypeOf(Document);
		
		Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.ProductStock);
		Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.GoodsForRegistrationOfSurplusesAndShortages);
		Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.CargoItemsForRecordingSurplusesAndShortages);
		If DocumentType <> Type("DocumentObject.ProductionCostAllocation") Then
		If DocumentType <> Type("DocumentObject.GoodsTransferNote") Then
			Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.GoodsToReceive);
			Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.GoodsForIssue);
		EndIf;
		EndIf;
		Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.GoodsInStorageBins);
		Parameters.SubordinateRegisters.Add(Metadata.AccumulationRegisters.GoodsForPicking);
		Parameters.SubordinateRegisters.Add(Metadata.InformationRegisters.StorageBinsLocks);
		
	EndIf;
	
	// Control
	If Properties.WriteMode <> DocumentWriteMode.Write Then
		
		Parameters.TaskControlRegisters.Add(Metadata.AccumulationRegisters.CargoItemsForRecordingSurplusesAndShortages);
		Parameters.TaskControlRegisters.Add(Metadata.AccumulationRegisters.GoodsToReceive);
		
		DocumentType = TypeOf(Document);
		
		#Region ProductStock
		
		If DocumentType = Type("DocumentObject.InventoryConsumption")
			Or DocumentType = Type("DocumentObject.ReturnOfGoodsToVendor")
			Or DocumentType = Type("DocumentObject.MovementOfProductsAndMaterials")
				And Not Document.BusinessOperation = Enums.BusinessTransactions.TransferOfProductsFromStoreroom
			Or DocumentType = Type("DocumentObject.MovementOfProductsAndMaterials")
				And Not UserRightsCached.AllowRetroactiveReleaseRegistration()
			
			
			Or DocumentType = Type("DocumentObject.GoodsShipmentFromStorage")
				And Not Document.BusinessOperation = Enums.BusinessTransactions.TransferToMaterialProvider2_5
			Or DocumentType = Type("DocumentObject.GoodsShipmentFromStorage")
				And Not UserRightsCached.DisableControlOfManufacturedProductTransferToProvider()
			Or DocumentType = Type("DocumentObject.TransferOfGoodsToBailee")
			Or DocumentType = Type("DocumentObject.GoodsShipmentToCustomer")
			Or DocumentType = Type("DocumentObject.RetailSalesReport")
			Or DocumentType = Type("DocumentObject.RetailReturnsReport")
			Or DocumentType = Type("DocumentObject.InventoryTransfer")
			Or DocumentType = Type("DocumentObject.CustomerInvoice")
			Or DocumentType = Type("DocumentObject.GoodsShortageNote")
			Or DocumentType = Type("DocumentObject.GoodsMisgradingNote")
			Or DocumentType = Type("DocumentObject.DamageNote") 
			Or (AdditionalDocuments_.Property("ControlRegistersOfChanges")
				And AdditionalDocuments_.ControlRegistersOfChanges.Property("ProductStock")
				And AdditionalDocuments_.ControlRegistersOfChanges.ProductStock.Find(DocumentType)<>Undefined)
			Then
			
			ManagerOfDocument = Documents[Document.Metadata().Name];
			SeriesAreUsed_ = ProductsServer.SeriesSpecificationParameters(Document, ManagerOfDocument).UseItemsBatch;
			
		ElsIf DocumentType = Type("DocumentObject.AssemblyFromComponents") Then
			SeriesSpecificationParameters =  ProductsServer.SeriesSpecificationParameters(Document, Documents.AssemblyFromComponents);
			SeriesAreUsed_ = SeriesSpecificationParameters.TS.UseItemsBatch
				Or SeriesSpecificationParameters.Header.UseItemsBatch;
		ElsIf DocumentType = Type("DocumentObject.BackflushProduction") Then
			SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(Document, Documents.BackflushProduction);
			SeriesAreUsed_ = SeriesSpecificationParameters.MaterialsAndWorks.UseItemsBatch;
		ElsIf DocumentType = Type("DocumentObject.ProductionStage2_2")
			And Not ProductionManagement.BatchFormationOfStagesIsPerformed(Document) Then
			SeriesSpecificationParameters = ProductsServer.SeriesSpecificationParameters(Document, Documents.ProductionStage2_2);
			SeriesAreUsed_ = SeriesSpecificationParameters.SupplyWithMaterialsAndWorks.UseItemsBatch;
		Else
			SeriesAreUsed_ = False;
		EndIf;
		
		If Properties.WriteMode = DocumentWriteMode.Posting
			And (DocumentType = Type("DocumentObject.InventoryAssignmentAdjustment")
				Or DocumentType = Type("DocumentObject.RequestForGoodsQualityControl")
				Or DocumentType = Type("DocumentObject.SaleAdjustment")
				Or DocumentType = Type("DocumentObject.CashRegisterReceipt")
				Or DocumentType = Type("DocumentObject.CashRegisterReceiptReturn")
				Or DocumentType = Type("DocumentObject.ReceiptOfCashRegisterAdjustment")
				Or SeriesAreUsed_)
			Or DocumentType = Type("DocumentObject.GoodsTransferNote") Then
			
			Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.ProductStock);
			
		EndIf;
		
		#EndRegion
		
		#Region GoodsForIssue
		
		DocumentsForControl = DocumentsForControlOfGoodsOfOrganizations();
		
		If DocumentsForControl.Find(DocumentType) <> Undefined Then
			ControlAllowed = True;
			If DocumentType = Type("DocumentObject.MovementOfProductsAndMaterials")
				And Not (Document.BusinessOperation = Enums.BusinessTransactions.MaterialTransferToProduction
					Or Document.BusinessOperation = Enums.BusinessTransactions.TransferOfMaterialsToStoreroom) Then
				ControlAllowed = False;
			EndIf;
			If Document.AdditionalProperties.Property("ChangeBasedOnActOfDiscrepancies")
				And Document.AdditionalProperties.ChangeBasedOnActOfDiscrepancies Then
				ControlAllowed = False;
			EndIf;
			
			If ControlAllowed Then
				Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.GoodsForIssue);
			EndIf;
		EndIf;
		
		#EndRegion
		
		If DocumentType = Type("DocumentObject.GoodsIssueNote")
			And Not Document.AdditionalProperties.Property("DisableMonitoringWhenConducting")
			And (Properties.WriteMode = DocumentWriteMode.Posting
				Or Properties.WriteMode = DocumentWriteMode.UndoPosting) Then
			
			Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.GoodsForIssue);
			Document.RegisterRecords.GoodsForIssue.AdditionalProperties.Insert(
				"ProhibitControlOfMovementOfGoodsForShipmentChangeSummary", True);
			
			If Document.Status = Enums.GoodsIssueNoteStatuses.ForPicking
				Or Document.Status = Enums.GoodsIssueNoteStatuses.Prepared Then
				Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.ProductStock);
			EndIf;
			
		EndIf;
		
		If DocumentType = Type("DocumentObject.InventoryAssignmentAdjustment")
				And Document.AdditionalProperties.Property("BinLocationWarehousingIsUsed")
			Or DocumentType = Type("DocumentObject.GoodsPickingPlacement")
				And Not Document.AdditionalProperties.Property("CarryingOutOfMRMWarehouseWorker")
				And (Document.Status = Enums.StatusesOfGoodsPickingPlacement.InProgress
					Or Document.Status = Enums.StatusesOfGoodsPickingPlacement.Prepared2) Then
			Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.GoodsInStorageBins);
		EndIf;
		
		If (DocumentType = Type("DocumentObject.GoodsIssueNote")
				Or DocumentType = Type("DocumentObject.GoodsTransferNote"))
				And Common.ObjectAttributeValue(Document.ShippingZone, "StorageBinType") =
					Enums.TypesOfStorageCells.ShipmentIncludingBalances
			Or DocumentType = Type("DocumentObject.GoodsPickingPlacement")
				And (Document.Status = Enums.StatusesOfGoodsPickingPlacement.DoneWithErrors
					Or Document.Status = Enums.StatusesOfGoodsPickingPlacement.CompletedWithoutErrors) Then
			
			Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.GoodsInStorageBins);
			Document.RegisterRecords.GoodsInStorageBins.Write = True;
			
		EndIf;
		
		If DocumentType = Type("DocumentObject.GoodsTransferNote")
			Or DocumentType = Type("DocumentObject.GoodsPickingPlacement")
			Or DocumentType = Type("DocumentObject.GoodsIssueNote")
				And Not Document.AdditionalProperties.Property("DisableMonitoringWhenConducting")
				And WarehousesServer.UseBinLocationWarehousing(Document.Warehouse, Document.Premise, Document.DateOfShipment) Then
			Parameters.ControlRegistersOfChanges.Add(Metadata.AccumulationRegisters.GoodsForPicking);
		EndIf;
		
	EndIf;
	
	Return Parameters;
	
EndFunction

// Returns the text of the queries to reverse the movements when correcting documents
// 
// Parameters:
// 	MetadataOfDocument - MetadataObjectDocument - Metadata of the document that is being held.
// 
// Returns:
// 	Map - Correspondence of the full register name to the text of the reversal request
//
Function TextsOfCancellationRequests(MetadataOfDocument) Export
	
	DocumentRegisterRecords = MetadataOfDocument.RegisterRecords;

	QueriesTexts = New Map();
	
	RegisterMetadata = Metadata.AccumulationRegisters.ProductStock;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	RegisterMetadata = Metadata.AccumulationRegisters.GoodsToReceive;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	RegisterMetadata = Metadata.AccumulationRegisters.GoodsForIssue;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	RegisterMetadata = Metadata.AccumulationRegisters.GoodsForRegistrationOfSurplusesAndShortages;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	RegisterMetadata = Metadata.AccumulationRegisters.GoodsInStorageBins;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	RegisterMetadata = Metadata.AccumulationRegisters.GoodsForPicking;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	RegisterMetadata = Metadata.AccumulationRegisters.CargoItemsForRecordingSurplusesAndShortages;
	If DocumentRegisterRecords.Contains(RegisterMetadata) Then
		QueriesTexts.Insert(RegisterMetadata.FullName(),
			DocumentsPosting.TextOfReversingRequest(
				RegisterMetadata, MetadataOfDocument));
	EndIf;
	
	
	Return QueriesTexts;
	
EndFunction

// Complements the request text of the mechanism for checking the ban date by the table of changes.
// 
// Parameters:
// 	Query - Query - used for setting request parameters.
// 
// Returns:
//	Map - matching the names of the register change tables and query texts.
//	
Function QueryTextsMonitoringBanDateBasedOnChangesTable(Query) Export

	MatchingQueryTexts = New Map();
	Return MatchingQueryTexts;
	
EndFunction

// Procedure for generating movements based on subordinate registers of the address warehouse.
//
// Parameters:
//	TablesForRegisteredRecords - Structure - document data tables
//	RegisterRecords - RegisterRecordsCollection - collection of document movement record sets
//	Cancel - Boolean - indicates that the document was rejected.
//
Procedure ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, Cancel) Export
	
	If Cancel Then
		Return;
	EndIf;
	
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "ProductStock");
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "GoodsToReceive");
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "GoodsForIssue");
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "GoodsForRegistrationOfSurplusesAndShortages");
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "CargoItemsForRecordingSurplusesAndShortages");
	
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "GoodsInStorageBins");
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "GoodsForPicking");
	DocumentsPosting.ReflectRegisteredRecords(TablesForRegisteredRecords, RegisterRecords, "StorageBinsLocks");
	
EndProcedure

// Forms the text of the requests for control changes, the recorded movements of the registers.
//
// Parameters:
//  Query - Query - a query that stores the parameters used in the query list
//  QueryTexts - ValueList - list of query texts and their names.
//  Document - DocumentObject - a recordable document.
//
Procedure InitializeChangeControlData(Query, QueryTexts, Document) Export
	
	#Region ProductStock
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsInWarehousesChange") Then
		
		QueryText =
			"SELECT
			|	ProductStockBalance.Products AS Products,
			|	ProductStockBalance.Characteristic AS Characteristic,
			|	ProductStockBalance.Purpose AS Purpose,
			|	ProductStockBalance.ControlledLotReference AS ControlledLotReference,
			|	ProductStockBalance.Warehouse AS Warehouse,
			|	ProductStockBalance.Products.UnitOfMeasure AS UnitOfMeasure,
			|	ProductStockBalance.Premise AS Premise,
			|	ChangesTable.Series AS Series,
			|	SUM(ProductStockBalance.InStockBalance - ProductStockBalance.ToShipBalance) AS Count
			|FROM
			|	MovementOfGoodsInWarehousesChange AS ChangesTable
			|		INNER JOIN AccumulationRegister.ProductStock.Balance(
			|				,
			|				(Products, Characteristic, Purpose, ControlledLotReference, Warehouse, Premise) IN
			|					(SELECT
			|						Table.Products,
			|						Table.Characteristic,
			|						Table.Purpose,
			|						Table.ControlledLotReference,
			|						Table.Warehouse,
			|						Table.Premise
			|					FROM
			|						MovementOfGoodsInWarehousesChange AS Table)) AS ProductStockBalance
			|		ON ChangesTable.Products = ProductStockBalance.Products
			|			AND ChangesTable.Characteristic = ProductStockBalance.Characteristic
			|			AND ChangesTable.Purpose = ProductStockBalance.Purpose
			|			AND ChangesTable.ControlledLotReference = ProductStockBalance.ControlledLotReference
			|			AND ChangesTable.Warehouse = ProductStockBalance.Warehouse
			|			AND ChangesTable.Premise = ProductStockBalance.Premise
			|			AND (CASE
			|				WHEN ChangesTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
			|					THEN TRUE
			|				ELSE ChangesTable.Series = ProductStockBalance.Series
			|			END)
			|
			|GROUP BY
			|	ProductStockBalance.Products,
			|	ProductStockBalance.Characteristic,
			|	ProductStockBalance.Purpose,
			|	ProductStockBalance.ControlledLotReference,
			|	ProductStockBalance.Warehouse,
			|	ProductStockBalance.Products.UnitOfMeasure,
			|	ProductStockBalance.Premise,
			|	ChangesTable.Series
			|
			|HAVING
			|	SUM(ProductStockBalance.InStockBalance - ProductStockBalance.ToShipBalance) < 0";
		
		QueryTexts.Add(QueryText, "ErrorsGoodsInWarehouses");
		
	EndIf;
	
	#EndRegion
	
	#Region GoodsForIssue
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "RegisteredRecordsGoodsForIssueUpdate") Then
		
		AllowableDeviationOfMeasuringGoodsShipmentAndReceiving =
			Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
		
		QueryText =
			"SELECT
			|	BalanceTable.DocumentShipments AS DocumentShipments,
			|	BalanceTable.Products AS Products,
			|	BalanceTable.Products.UnitOfMeasure AS UnitOfMeasure,
			|	BalanceTable.Characteristic AS Characteristic,
			|	BalanceTable.Purpose AS Purpose,
			|	BalanceTable.ControlledLotReference AS ControlledLotReference,
			|	BalanceTable.Series AS Series,
			|	BalanceTable.Recipient AS Recipient,
			|	BalanceTable.Warehouse AS Warehouse,
			|	BalanceTable.ToShipBalance - BalanceTable.AssemblyInProgressBalance - BalanceTable.AssembledBalance AS Count
			|FROM
			|	AccumulationRegister.GoodsForIssue.Balance(,
			|			(DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series, Recipient, Warehouse) IN
			|				(SELECT
			|					Table.DocumentShipments,
			|					Table.Products,
			|					Table.Characteristic,
			|					Table.Purpose,
			|					Table.ControlledLotReference,
			|					Table.Series,
			|					Table.Recipient,
			|					Table.Warehouse
			|				FROM
			|					RegisteredRecordsGoodsForIssueUpdate AS Table)) AS BalanceTable";
		
		If AllowableDeviationOfMeasuringGoodsShipmentAndReceiving <> 0 Then
			
			QueryText = QueryText + "
			|		LEFT JOIN AccumulationRegister.GoodsForIssue.Turnovers(
			|				,
			|				,
			|				,
			|				(DocumentShipments, Products, Characteristic, Purpose, ControlledLotReference, Series, Warehouse) IN
			|					(SELECT
			|						Table.DocumentShipments,
			|						Table.Products,
			|						Table.Characteristic,
			|						Table.Purpose,
			|						Table.ControlledLotReference,
			|						Table.Series,
			|						Table.Warehouse
			|					FROM
			|						RegisteredRecordsGoodsForIssueUpdate AS Table)) AS TableOfRevolutions
			|		ON BalanceTable.DocumentShipments = TableOfRevolutions.DocumentShipments
			|			AND BalanceTable.Products = TableOfRevolutions.Products
			|			AND BalanceTable.Characteristic = TableOfRevolutions.Characteristic
			|			AND BalanceTable.Purpose = TableOfRevolutions.Purpose
			|			AND BalanceTable.ControlledLotReference = TableOfRevolutions.ControlledLotReference
			|			AND BalanceTable.Series = TableOfRevolutions.Series
			|			AND BalanceTable.Warehouse = TableOfRevolutions.Warehouse
			|WHERE
			|	BalanceTable.ToShipBalance - BalanceTable.AssemblyInProgressBalance - BalanceTable.AssembledBalance < CASE
			|			WHEN BalanceTable.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
			|				THEN -&AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * TableOfRevolutions.ToShipReceipt
			|			ELSE 0
			|		END";
			
			Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving",
				AllowableDeviationOfMeasuringGoodsShipmentAndReceiving);
			Query.SetParameter("DimensionalTypesOfUnits",
				Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
			
		Else
			
			QueryText = QueryText + "
			|WHERE
			|	BalanceTable.ToShipBalance - BalanceTable.AssemblyInProgressBalance - BalanceTable.AssembledBalance < 0";
			
		EndIf;
		
		QueryTexts.Add(QueryText, "ReadyGoodsForShipment");
		
	EndIf;
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsForShipmentChangeInSummary") Then
		
		QueryTextBalance =
		"SELECT
		|	T.Products         AS Products,
		|	T.Characteristic       AS Characteristic,
		|	T.Purpose           AS Purpose,
		|	T.ControlledLotReference AS ControlledLotReference,
		|	T.Warehouse                AS Warehouse,
		|	T.Series                AS Series,
		|	-T.InReserveBalance - T.ToShipBalance AS Count,
		|	0                AS BalanceBeforeChange
		|FROM
		|	AccumulationRegister.GoodsForIssue.Balance(
		|			,
		|			(Products, Characteristic, Purpose, ControlledLotReference, Warehouse, Series) IN
		|				(SELECT
		|					T.Products,
		|					T.Characteristic,
		|					T.Purpose,
		|					T.ControlledLotReference,
		|					T.Warehouse,
		|					T.Series
		|				FROM
		|					MovementOfGoodsForShipmentChangeInSummary AS T)) AS T
		|UNION ALL
		|
		|SELECT
		|	T.Products         AS Products,
		|	T.Characteristic       AS Characteristic,
		|	T.Purpose           AS Purpose,
		|	T.ControlledLotReference AS ControlledLotReference,
		|	T.Warehouse                AS Warehouse,
		|	T.Series                AS Series,
		|	T.InStockBalance      AS Count,
		|	T.InStockBalance      AS BalanceBeforeChange
		|FROM
		|	AccumulationRegister.ProductStock.Balance(
		|			,
		|			(Products, Characteristic, Purpose, ControlledLotReference, Warehouse, Series) IN
		|				(SELECT
		|					T.Products,
		|					T.Characteristic,
		|					T.Purpose,
		|					T.ControlledLotReference,
		|					T.Warehouse,
		|					T.Series
		|				FROM
		|					MovementOfGoodsForShipmentChangeInSummary AS T)) AS T";
		
		If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsInWarehousesChange") Then
			
			QueryTextBalance = QueryTextBalance + Common.UnionAllText() + "
				|SELECT
				|	T.Products         AS Products,
				|	T.Characteristic       AS Characteristic,
				|	T.Purpose           AS Purpose,
				|	T.ControlledLotReference AS ControlledLotReference,
				|	T.Warehouse                AS Warehouse,
				|	T.Series                AS Series,
				|	0                      AS Count,
				|	T.InStockUpdate    AS BalanceBeforeChange
				|FROM
				|	RegisteredRecordedProductStockChangesSummary AS T
				|		INNER JOIN MovementOfGoodsForShipmentChangeInSummary AS RegisteredRecordsGoodsForIssue
				|		ON T.Products = RegisteredRecordsGoodsForIssue.Products
				|			AND T.Characteristic = RegisteredRecordsGoodsForIssue.Characteristic
				|			AND T.Purpose = RegisteredRecordsGoodsForIssue.Purpose
				|			AND T.ControlledLotReference = RegisteredRecordsGoodsForIssue.ControlledLotReference
				|			AND T.Warehouse = RegisteredRecordsGoodsForIssue.Warehouse
				|			AND T.Series = RegisteredRecordsGoodsForIssue.Series";
			
		EndIf;
		
		QueryText =
		"SELECT
		|	Balance.Products                   AS Products,
		|	Balance.Products.UnitOfMeasure  AS UnitOfMeasure,
		|	Balance.Characteristic                 AS Characteristic,
		|	Balance.Purpose                     AS Purpose,
		|	Balance.ControlledLotReference           AS ControlledLotReference,
		|	Balance.Warehouse                          AS Warehouse,
		|	Balance.Series                          AS Series,
		|	SUM(Balance.Count)              AS Count
		|FROM
		|	&QueryTextBalance AS Balance
		|
		|GROUP BY
		|	Balance.Products,
		|	Balance.Characteristic,
		|	Balance.Purpose,
		|	Balance.ControlledLotReference,
		|	Balance.Warehouse,
		|	Balance.Series
		|
		|HAVING
		|	SUM(Balance.Count) < 0
		|	AND SUM(Balance.BalanceBeforeChange) >= 0";
		
		QueryTextBalance = StrTemplate("(%1)", QueryTextBalance);
		QueryText = StrReplace(QueryText, "&QueryTextBalance", QueryTextBalance);
		
		QueryTexts.Add(QueryText, "ErrorsGoodsForShipmentSummary");
		
	EndIf;
	
	#EndRegion
	
	#Region GoodsInStorageBins
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsInCellsChange") Then
		
		QueryTexts.Add(
			"SELECT DISTINCT
			|	CatProducts.Ref
			|INTO TTMultiTurnPackaging
			|FROM
			|	Catalog.Products AS CatProducts
			|WHERE
			|	CatProducts.ItemsType = VALUE(Enum.ItemsTypes.ReusablePackage)");
		
		QueryTexts.Add(
			"SELECT DISTINCT
			|	StorageBins.Ref AS Ref
			|INTO TTCellsControlIsolation
			|FROM
			|	Catalog.StorageBins AS StorageBins
			|		INNER JOIN Catalog.StorageAreas AS StorageAreas
			|		ON StorageBins.StorageArea = StorageAreas.Ref
			|		INNER JOIN MovementOfGoodsInCellsChange AS MovementOfGoodsInCellsChange
			|		ON StorageBins.Ref = MovementOfGoodsInCellsChange.Cell
			|WHERE
			|	StorageAreas.ControlQuantityOfAssignmentsInBins
			|	AND MovementOfGoodsInCellsChange.ForPlacementUpdate < 0
			|
			|INDEX BY
			|	Ref");
		
		QueryText =
			"SELECT
			|	GoodsInStorageBinsBalance.Products AS Products,
			|	GoodsInStorageBinsBalance.Characteristic AS Characteristic,
			|	GoodsInStorageBinsBalance.Purpose AS Purpose,
			|	CASE
			|		WHEN GoodsInStorageBinsBalance.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			|			THEN
			|				GoodsInStorageBinsBalance.Products.UnitOfMeasure
			|			ELSE
			|				GoodsInStorageBinsBalance.Package
			|		END AS Package,
			|	ChangesTable.Series AS Series,
			|	GoodsInStorageBinsBalance.Cell AS Cell,
			|	SUM(GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance) AS Count
			|FROM
			|	MovementOfGoodsInCellsChange AS ChangesTable
			|		INNER JOIN AccumulationRegister.GoodsInStorageBins.Balance(
			|				,
			|				(Products, Characteristic, Purpose, Package, Cell) IN
			|					(SELECT
			|						Table.Products,
			|						Table.Characteristic,
			|						Table.Purpose,
			|						Table.Package,
			|						Table.Cell
			|					FROM
			|						MovementOfGoodsInCellsChange AS Table)) AS GoodsInStorageBinsBalance
			|		ON ChangesTable.Products = GoodsInStorageBinsBalance.Products
			|			AND ChangesTable.Characteristic = GoodsInStorageBinsBalance.Characteristic
			|			AND ChangesTable.Purpose = GoodsInStorageBinsBalance.Purpose
			|			AND ChangesTable.Package = GoodsInStorageBinsBalance.Package
			|			AND ChangesTable.Cell = GoodsInStorageBinsBalance.Cell
			|			AND (CASE
			|				WHEN ChangesTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
			|					THEN TRUE
			|				ELSE ChangesTable.Series = GoodsInStorageBinsBalance.Series
			|			END)
			|
			|GROUP BY
			|	GoodsInStorageBinsBalance.Products,
			|	GoodsInStorageBinsBalance.Characteristic,
			|	GoodsInStorageBinsBalance.Purpose,
			|	GoodsInStorageBinsBalance.Package,
			|	ChangesTable.Series,
			|	GoodsInStorageBinsBalance.Cell
			|
			|HAVING
			|	SUM(GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance) < 0";
		
		QueryTexts.Add(QueryText, "ErrorsOccurInCells");
		
		QueryText =
			"SELECT
			|	GoodsInStorageBinsBalance.Cell
			|FROM
			|	AccumulationRegister.GoodsInStorageBins.Balance(
			|			,
			|			Cell IN
			|					(SELECT
			|						TTCellsControlIsolation.Ref
			|					FROM
			|						TTCellsControlIsolation AS TTCellsControlIsolation)
			|				AND NOT Products IN
			|						(SELECT
			|							TTMultiTurnPackaging.Ref
			|						FROM
			|							TTMultiTurnPackaging AS TTMultiTurnPackaging)
			|				AND Purpose <> VALUE(Catalog.Assignments.EmptyRef)) AS GoodsInStorageBinsBalance
			|WHERE
			|	GoodsInStorageBinsBalance.InStockBalance - GoodsInStorageBinsBalance.ForPickingBalance + GoodsInStorageBinsBalance.ForPlacementBalance > 0
			|
			|GROUP BY
			|	GoodsInStorageBinsBalance.Cell
			|
			|HAVING
			|	COUNT(DISTINCT GoodsInStorageBinsBalance.Purpose) > 1";
		
		QueryTexts.Add(QueryText, "MultipleAssignmentsInSeparateCells");
		
	EndIf;
	
	#EndRegion
	
	#Region GoodsForPicking
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsToSelectionChange") Then
		
		QueryTexts.Add(
			"SELECT DISTINCT
			|	MovementOfGoodsToSelectionChange.ReferenceOrder,
			|	MovementOfGoodsToSelectionChange.Products,
			|	MovementOfGoodsToSelectionChange.Characteristic,
			|	MovementOfGoodsToSelectionChange.Purpose,
			|	MovementOfGoodsToSelectionChange.Series,
			|	PackagesAndUnitsOfMeasure.Ref AS CargoItem,
			|	PackagesAndUnitsOfMeasure.NumberOfPackages
			|INTO ProductItemsLocations
			|FROM
			|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
			|		INNER JOIN MovementOfGoodsToSelectionChange AS MovementOfGoodsToSelectionChange
			|		ON PackagesAndUnitsOfMeasure.Owner = MovementOfGoodsToSelectionChange.Products
			|WHERE
			|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)
			|
			|UNION ALL
			|
			|SELECT DISTINCT
			|	MovementOfGoodsToSelectionChange.ReferenceOrder,
			|	MovementOfGoodsToSelectionChange.Products,
			|	MovementOfGoodsToSelectionChange.Characteristic,
			|	MovementOfGoodsToSelectionChange.Purpose,
			|	MovementOfGoodsToSelectionChange.Series,
			|	PackagesAndUnitsOfMeasure.Ref,
			|	PackagesAndUnitsOfMeasure.NumberOfPackages
			|FROM
			|	Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
			|		INNER JOIN MovementOfGoodsToSelectionChange AS MovementOfGoodsToSelectionChange
			|		ON PackagesAndUnitsOfMeasure.Owner = MovementOfGoodsToSelectionChange.Products.PackagingGroup
			|WHERE
			|	PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem)");
		
		PermissibleDeviationOfMeasuredGoods = Constants.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Get();
		
		If PermissibleDeviationOfMeasuredGoods <> 0 Then
			
			QueryTexts.Add(
				"SELECT
				|	GoodsForSelectionTurnover.ReferenceOrder AS ReferenceOrder,
				|	GoodsForSelectionTurnover.Products AS Products,
				|	GoodsForSelectionTurnover.Characteristic AS Characteristic,
				|	GoodsForSelectionTurnover.Purpose AS Purpose,
				|	GoodsForSelectionTurnover.Series AS Series,
				|	GoodsForSelectionTurnover.CargoItem AS CargoItem,
				|	SUM(GoodsForSelectionTurnover.ForPickingReceipt) AS Count
				|INTO TemporaryTableTurnoverTableWithProductLocations
				|FROM
				|	AccumulationRegister.GoodsForPicking.Turnovers(
				|			,
				|			,
				|			,
				|			(ReferenceOrder, Products, Characteristic, Purpose, Series) IN
				|				(SELECT
				|					Table.ReferenceOrder,
				|					Table.Products,
				|					Table.Characteristic,
				|					Table.Purpose,
				|					Table.Series
				|				FROM
				|					MovementOfGoodsToSelectionChange AS Table)) AS GoodsForSelectionTurnover
				|
				|GROUP BY
				|	GoodsForSelectionTurnover.ReferenceOrder,
				|	GoodsForSelectionTurnover.Products,
				|	GoodsForSelectionTurnover.Characteristic,
				|	GoodsForSelectionTurnover.Purpose,
				|	GoodsForSelectionTurnover.Series,
				|	GoodsForSelectionTurnover.CargoItem");
			
			QueryTexts.Add(
				"SELECT
				|	InternalTable.ReferenceOrder,
				|	InternalTable.Products,
				|	InternalTable.Characteristic,
				|	InternalTable.Purpose,
				|	InternalTable.Series,
				|	SUM(InternalTable.Count) AS Count
				|INTO TimeTableRevTable
				|FROM
				|	(SELECT
				|		ProductItemsLocations.ReferenceOrder AS ReferenceOrder,
				|		ProductItemsLocations.Products AS Products,
				|		ProductItemsLocations.Characteristic AS Characteristic,
				|		ProductItemsLocations.Purpose AS Purpose,
				|		ProductItemsLocations.Series AS Series,
				|		MIN(CASE
				|				WHEN ISNULL(TemporaryTableTurnoverTableWithProductLocations.Count, 0) / ProductItemsLocations.CargoItem.NumberOfPackages - (CAST(ISNULL(TemporaryTableTurnoverTableWithProductLocations.Count, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) >= 0
				|					THEN CAST(ISNULL(TemporaryTableTurnoverTableWithProductLocations.Count, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))
				|				ELSE (CAST(ISNULL(TemporaryTableTurnoverTableWithProductLocations.Count, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) - 1
				|			END) AS Count
				|	FROM
				|		ProductItemsLocations AS ProductItemsLocations
				|			LEFT JOIN TemporaryTableTurnoverTableWithProductLocations AS TemporaryTableTurnoverTableWithProductLocations
				|			ON ProductItemsLocations.ReferenceOrder = TemporaryTableTurnoverTableWithProductLocations.ReferenceOrder
				|				AND ProductItemsLocations.Products = TemporaryTableTurnoverTableWithProductLocations.Products
				|				AND ProductItemsLocations.Characteristic = TemporaryTableTurnoverTableWithProductLocations.Characteristic
				|				AND ProductItemsLocations.Purpose = TemporaryTableTurnoverTableWithProductLocations.Purpose
				|				AND ProductItemsLocations.Series = TemporaryTableTurnoverTableWithProductLocations.Series
				|				AND ProductItemsLocations.CargoItem = TemporaryTableTurnoverTableWithProductLocations.CargoItem
				|	
				|	GROUP BY
				|		ProductItemsLocations.ReferenceOrder,
				|		ProductItemsLocations.Products,
				|		ProductItemsLocations.Characteristic,
				|		ProductItemsLocations.Purpose,
				|		ProductItemsLocations.Series
				|	
				|	UNION ALL
				|	
				|	SELECT
				|		TemporaryTableTurnoverTableWithProductLocations.ReferenceOrder,
				|		TemporaryTableTurnoverTableWithProductLocations.Products,
				|		TemporaryTableTurnoverTableWithProductLocations.Characteristic,
				|		TemporaryTableTurnoverTableWithProductLocations.Purpose,
				|		TemporaryTableTurnoverTableWithProductLocations.Series,
				|		TemporaryTableTurnoverTableWithProductLocations.Count
				|	FROM
				|		TemporaryTableTurnoverTableWithProductLocations AS TemporaryTableTurnoverTableWithProductLocations
				|	WHERE
				|		ISNULL(TemporaryTableTurnoverTableWithProductLocations.CargoItem.PackageType, UNDEFINED) <> VALUE(Enum.TypesOfItemsPackages.CargoItem)) AS InternalTable
				|
				|GROUP BY
				|	InternalTable.ReferenceOrder,
				|	InternalTable.Products,
				|	InternalTable.Characteristic,
				|	InternalTable.Purpose,
				|	InternalTable.Series");
			
		EndIf;
		
		QueryTexts.Add(
			"SELECT
			|	GoodsForPickingBalance.ReferenceOrder AS ReferenceOrder,
			|	GoodsForPickingBalance.Products AS Products,
			|	GoodsForPickingBalance.Characteristic AS Characteristic,
			|	GoodsForPickingBalance.Purpose AS Purpose,
			|	GoodsForPickingBalance.Series AS Series,
			|	GoodsForPickingBalance.CargoItem AS CargoItem,
			|	SUM(GoodsForPickingBalance.ForPickingBalance) AS ForPickingBalance,
			|	SUM(GoodsForPickingBalance.BeingPickedBalance) AS BeingPickedBalance,
			|	SUM(GoodsForPickingBalance.PickedBalance) AS PickedBalance
			|INTO TemporaryTableTableOfBalancesWithProductLocations
			|FROM
			|	AccumulationRegister.GoodsForPicking.Balance(
			|			,
			|			(ReferenceOrder, Products, Characteristic, Purpose, Series) IN
			|				(SELECT
			|					Table.ReferenceOrder,
			|					Table.Products,
			|					Table.Characteristic,
			|					Table.Purpose,
			|					Table.Series
			|				FROM
			|					MovementOfGoodsToSelectionChange AS Table)) AS GoodsForPickingBalance
			|
			|GROUP BY
			|	GoodsForPickingBalance.ReferenceOrder,
			|	GoodsForPickingBalance.Products,
			|	GoodsForPickingBalance.Characteristic,
			|	GoodsForPickingBalance.Purpose,
			|	GoodsForPickingBalance.Series,
			|	GoodsForPickingBalance.CargoItem");
			
		QueryTexts.Add(
			"SELECT
			|	InternalTable.ReferenceOrder,
			|	InternalTable.Products,
			|	InternalTable.Characteristic,
			|	InternalTable.Purpose,
			|	InternalTable.Series,
			|	SUM(InternalTable.ForPickingBalance) AS ForPickingBalance,
			|	SUM(InternalTable.BeingPickedBalance) AS BeingPickedBalance,
			|	SUM(InternalTable.PickedBalance) AS PickedBalance
			|INTO TemporaryTableTableOfBalances
			|FROM
			|	(SELECT
			|		ProductItemsLocations.ReferenceOrder AS ReferenceOrder,
			|		ProductItemsLocations.Products AS Products,
			|		ProductItemsLocations.Characteristic AS Characteristic,
			|		ProductItemsLocations.Purpose AS Purpose,
			|		ProductItemsLocations.Series AS Series,
			|		MIN(CASE
			|				WHEN ISNULL(TemporaryTableTableOfBalancesWithProductLocations.ForPickingBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages - (CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.ForPickingBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) >= 0
			|					THEN CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.ForPickingBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))
			|				ELSE (CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.ForPickingBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) - 1
			|			END) AS ForPickingBalance,
			|		MIN(CASE
			|				WHEN ISNULL(TemporaryTableTableOfBalancesWithProductLocations.BeingPickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages - (CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.BeingPickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) >= 0
			|					THEN CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.BeingPickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))
			|				ELSE (CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.BeingPickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) - 1
			|			END) AS BeingPickedBalance,
			|		MIN(CASE
			|				WHEN ISNULL(TemporaryTableTableOfBalancesWithProductLocations.PickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages - (CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.PickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) >= 0
			|					THEN CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.PickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))
			|				ELSE (CAST(ISNULL(TemporaryTableTableOfBalancesWithProductLocations.PickedBalance, 0) / ProductItemsLocations.CargoItem.NumberOfPackages AS NUMBER(12, 0))) - 1
			|			END) AS PickedBalance
			|	FROM
			|		ProductItemsLocations AS ProductItemsLocations
			|			LEFT JOIN TemporaryTableTableOfBalancesWithProductLocations AS TemporaryTableTableOfBalancesWithProductLocations
			|			ON ProductItemsLocations.ReferenceOrder = TemporaryTableTableOfBalancesWithProductLocations.ReferenceOrder
			|				AND ProductItemsLocations.Products = TemporaryTableTableOfBalancesWithProductLocations.Products
			|				AND ProductItemsLocations.Characteristic = TemporaryTableTableOfBalancesWithProductLocations.Characteristic
			|				AND ProductItemsLocations.Purpose = TemporaryTableTableOfBalancesWithProductLocations.Purpose
			|				AND ProductItemsLocations.Series = TemporaryTableTableOfBalancesWithProductLocations.Series
			|				AND ProductItemsLocations.CargoItem = TemporaryTableTableOfBalancesWithProductLocations.CargoItem
			|	
			|	GROUP BY
			|		ProductItemsLocations.ReferenceOrder,
			|		ProductItemsLocations.Products,
			|		ProductItemsLocations.Characteristic,
			|		ProductItemsLocations.Purpose,
			|		ProductItemsLocations.Series
			|	
			|	UNION ALL
			|	
			|	SELECT
			|		TemporaryTableTableOfBalancesWithProductLocations.ReferenceOrder,
			|		TemporaryTableTableOfBalancesWithProductLocations.Products,
			|		TemporaryTableTableOfBalancesWithProductLocations.Characteristic,
			|		TemporaryTableTableOfBalancesWithProductLocations.Purpose,
			|		TemporaryTableTableOfBalancesWithProductLocations.Series,
			|		TemporaryTableTableOfBalancesWithProductLocations.ForPickingBalance,
			|		TemporaryTableTableOfBalancesWithProductLocations.BeingPickedBalance,
			|		TemporaryTableTableOfBalancesWithProductLocations.PickedBalance
			|	FROM
			|		TemporaryTableTableOfBalancesWithProductLocations AS TemporaryTableTableOfBalancesWithProductLocations
			|	WHERE
			|		TemporaryTableTableOfBalancesWithProductLocations.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS InternalTable
			|
			|GROUP BY
			|	InternalTable.ReferenceOrder,
			|	InternalTable.Products,
			|	InternalTable.Characteristic,
			|	InternalTable.Purpose,
			|	InternalTable.Series");
		
		If PermissibleDeviationOfMeasuredGoods <> 0 Then
			
			QueryText =
				"SELECT
				|	BalanceTable.ReferenceOrder,
				|	BalanceTable.Products,
				|	BalanceTable.Characteristic,
				|	BalanceTable.Purpose,
				|	BalanceTable.Series,
				|	BalanceTable.Products.UnitOfMeasure AS UnitOfMeasure,
				|	BalanceTable.ForPickingBalance - BalanceTable.PickedBalance - BalanceTable.BeingPickedBalance AS Count,
				|	BalanceTable.PickedBalance AS CountPicked
				|FROM
				|	TemporaryTableTableOfBalances AS BalanceTable
				|		LEFT JOIN TimeTableRevTable AS TableOfRevolutions
				|		ON BalanceTable.ReferenceOrder = TableOfRevolutions.ReferenceOrder
				|			AND BalanceTable.Products = TableOfRevolutions.Products
				|			AND BalanceTable.Characteristic = TableOfRevolutions.Characteristic
				|			AND BalanceTable.Purpose = TableOfRevolutions.Purpose
				|			AND BalanceTable.Series = TableOfRevolutions.Series
				|WHERE
				|	(BalanceTable.ForPickingBalance - BalanceTable.PickedBalance - BalanceTable.BeingPickedBalance < CASE
				|				WHEN BalanceTable.Products.UnitOfMeasure.MeasuredValueType IN (&DimensionalTypesOfUnits)
				|					THEN -&AllowableDeviationOfMeasuringGoodsShipmentAndReceiving / 100 * ISNULL(TableOfRevolutions.Count, 0)
				|				ELSE 0
				|			END
				|			OR BalanceTable.PickedBalance < 0
				|			OR CASE
				|				WHEN BalanceTable.ForPickingBalance = 0
				|					THEN BalanceTable.PickedBalance <> 0
				|				ELSE FALSE
				|			END)";
			
			Query.SetParameter("AllowableDeviationOfMeasuringGoodsShipmentAndReceiving", PermissibleDeviationOfMeasuredGoods);
			Query.SetParameter("DimensionalTypesOfUnits", Catalogs.PackagesAndUnitsOfMeasure.DimensionalTypesOfUnits());
			
		Else
			
			QueryText = 
				"SELECT
				|	BalanceTable.ReferenceOrder,
				|	BalanceTable.Products,
				|	BalanceTable.Characteristic,
				|	BalanceTable.Purpose,
				|	BalanceTable.Series,
				|	BalanceTable.Products.UnitOfMeasure AS UnitOfMeasure,
				|	BalanceTable.ForPickingBalance - BalanceTable.PickedBalance - BalanceTable.BeingPickedBalance AS Count,
				|	BalanceTable.PickedBalance AS CountPicked
				|FROM
				|	TemporaryTableTableOfBalances AS BalanceTable
				|WHERE
				|	(BalanceTable.ForPickingBalance - BalanceTable.PickedBalance - BalanceTable.BeingPickedBalance < 0
				|			OR BalanceTable.PickedBalance < 0)";
			
		EndIf;
		
		QueryTexts.Add(QueryText, "ErrorsAreReadyForSelection");
		
	EndIf;
	
	#EndRegion
	
EndProcedure

// Displays messages to the user if there are errors in monitoring changes to recorded register movements.
//
// Parameters:
//  ControlResults - Structure - table with the results of the control changes
//  Document - DocumentObject - recordable document
//  Cancel - Boolean - indicates that the document was rejected.
//
Procedure ReportChangeControlResults(ControlResults, Document, Cancel) Export
	
	#Region ProductStock
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsInWarehousesChange") Then
		
		MessageTemplate = NStr("vi = 'Mặt hàng %1 %2
			|Vượt quá số dư hiện thời trong kho ""%3"" là %4 %5';
			|ru = 'Номенклатура %1 %2
			|Превышен оперативный складской остаток на складе ""%3"" на %4 %5';
			|en = 'Items %1%2
			|Exceeded operational stock balance in the warehouse ""%3"" by %4 %5'; fa = 'Items %1%2
			|Exceeded operational stock balance in the warehouse ""%3"" by %4 %5';
			|it = 'Articoli %1 %2
			|Superamento del saldo di magazzino in magazzino ""%3"" per %4 %5';
			|pl = 'Nomenklatura %1 %2
			|Przekroczono saldo operacyjne  na magazynie ""%3"" o %4 %5';
			|tr = 'Öğe %1 %2
			|""%3"" ambarındaki operasyonel stok bakiyesi %4 %5 oranında aşıldı'");
		
		For Each ErrorString In ControlResults.ErrorsGoodsInWarehouses Do
			
			ProductPresentation	= ProductsClientServer.ProductPresentation(ErrorString.Products,
																							ErrorString.Characteristic,
																							,
																							ErrorString.Series);
			
			AdditionalAnalytics = AdditionalAnalyticsBalanceControlErrors(ErrorString);
			Warehouse = GetWarehousePresentation(ErrorString.Warehouse, ErrorString.Premise);
			
			MessageText = StrTemplate(MessageTemplate,
										ProductPresentation,
										AdditionalAnalytics,
										Warehouse,
										-ErrorString.Count,
										ErrorString.UnitOfMeasure);
			
			CommonClientServer.MessageToUser(MessageText, Document, , , Cancel);
			
		EndDo;
		
	EndIf;
	
	#EndRegion
	
	#Region GoodsForIssue
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "RegisteredRecordsGoodsForIssueUpdate") Then
		
		If TMCommonUseClientServer.HasObjectAttribute(Document, "Status")
			And Document.Status = Enums.GoodsIssueNoteStatuses.ForPicking Then 
			MessageTemplate = NStr("vi = 'Mặt hàng %1 %2
			|Dự tính giao hàng từ kho %3 lớn hơn số lượng trong lệnh giao hàng là %4 %5';
			|ru = 'Номенклатура %1 %2
			|Планируется к отгрузке со склада %3 больше, чем указано в распоряжении на отгрузку, на %4 %5';
			|en = 'Items %1%2
			|The number of items planned to ship from the warehouse %3 is greater than specified in the shipment reference by %4 %5'; fa = 'Items %1%2
			|The number of items planned to ship from the warehouse %3 is greater than specified in the shipment reference by %4 %5';
			|it = 'Articoli %1 %2
			|Si prevede di spedire dal magazzino  %3 una quantità maggiore rispetto a quella indicata nella disposizione sulla spedizione per %4 %5';
			|pl = 'Pozycja %1 %2
			|Planuje się do wysyłki z magazynu %3 więcej, niż podano w zamówieniu do wysyłki o %4 %5';
			|tr = 'Öğe %1 %2
			|Ambardan sevk edilmesi planlanan %3 sevkiyat emrinde belirtilenden daha fazla %4 %5'");
		Else
			MessageTemplate = NStr("vi = 'Mặt hàng %1 %2
			|Đã giao %3 lớn hơn số lượng trong lệnh giao hàng là %4 %5';
			|ru = 'Номенклатура %1 %2
			|Отгружено со склада %3 больше, чем указано в распоряжении на отгрузку, на %4 %5';
			|en = 'Items %1%2
			|Shipped from the warehouse %5 more than specified in the shipping reference, on %3 %4'; fa = 'Items %1%2
			|Shipped from the warehouse %5 more than specified in the shipping reference, on %3 %4';
			|it = 'Articoli %1 %2
			|Spedita dal magazzino %3 una quantità maggiore rispetto a quella indicata nella disposizione sulla spedizione per %4 %5';
			|pl = 'Pozycja %1 %2
			|Wysłano z magazynu %3  więcej, niż podano w zamówieniu do wysyłki o %4 %5';
			|tr = 'Öğe %1 %2
			|Sevkiyat siparişinde belirtilenden %3 daha fazla stoktan %4 %5 oranında sevk edildi'");
		EndIf;
		
		For Each ErrorString In ControlResults.ReadyGoodsForShipment Do
			
			ProductPresentation = ProductsClientServer.ProductPresentation(ErrorString.Products,
				ErrorString.Characteristic,, ErrorString.Series);
			AdditionalAnalytics = AdditionalAnalyticsBalanceControlErrors(ErrorString);
			
			MessageText = StrTemplate(MessageTemplate, ProductPresentation, AdditionalAnalytics,
				ErrorString.Warehouse, -ErrorString.Count ,ErrorString.UnitOfMeasure);
			
			CommonClientServer.MessageToUser(MessageText, Document,,, Cancel);
			
		EndDo;
		
	EndIf;
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsForShipmentChangeInSummary") Then
		
		MessageTemplate = NStr("ru = 'Товар %1 %2
			|Недостаточно для отгрузки %3 %4';
			|vi = 'Product item %1 %2
			|Not enough for shipment %3 %4';
			|en = 'Product item %1 %2
			|Not enough for shipment %3 %4'; fa = 'Product item %1 %2
			|Not enough for shipment %3 %4';
			|it = 'Product item %1 %2
			|Not enough for shipment %3 %4';
			|pl = 'Product item %1 %2
			|Not enough for shipment %3 %4';
			|tr = 'Ürün %1 %2
			|sevkiyat için yetersiz %3%4'");
		
		For Each ErrorString In ControlResults.ErrorsGoodsForShipmentSummary Do
			
			ProductPresentation = ProductsClientServer.ProductPresentation(ErrorString.Products,
				ErrorString.Characteristic,, ErrorString.Series);
			
			AdditionalAnalytics = AdditionalAnalyticsBalanceControlErrors(ErrorString);
			
			MessageText = StrTemplate(MessageTemplate, ProductPresentation, AdditionalAnalytics,
				-ErrorString.Count, ErrorString.UnitOfMeasure);
			
			CommonClientServer.MessageToUser(MessageText, Document,,, Cancel);
			
		EndDo;
		
	EndIf;
	
	#EndRegion
	
	#Region GoodsInStorageBins
	
	If DocumentsPosting.ThereAreRecordsInTable(Document, "MovementOfGoodsInCellsChange") Then
		
