// Checks whether shared data was changed for any data area.
Function HasChangesOfAccessRestrictionParameters()
	
	SetPrivilegedMode(True);
	
	Parameters = New Array;
	Parameters.Add("StandardSubsystems.AccessManagement.RoleRightMetadataObjects");
	Parameters.Add("StandardSubsystems.AccessManagement.SuppliedProfilesDescription");
	Parameters.Add("StandardSubsystems.AccessManagement.AccessGroupPredefinedProfiles");
	
	If Not IsRecordLevelRestrictionDisabled() Then
		Parameters.Add("StandardSubsystems.AccessManagement.RightsForObjectsRightsSettingsAvailable");
		Parameters.Add("StandardSubsystems.AccessManagement.GroupAndAccessValueTypes");
		Parameters.Add("StandardSubsystems.AccessManagement.AccessRestrictionTextsVersion");
	EndIf;
	
	For Each Parameter In Parameters Do
		
		LastChanges = StandardSubsystemsServer.ApplicationParameterChanges(Parameter);
		
		If LastChanges = Undefined
		 Or LastChanges.Count() > 0 Then
			
			Return True;
		EndIf;
		
	EndDo;
	
	Return False;
	
EndFunction


// For the AccessRights and AccessRightsSimplified forms.
//
// Parameters:
//  Form - ClientApplicationForm:
//
Procedure FillInUserRoles(Form) Export
	
	User    = Form.Parameters.User;
	ReadRoles = Form.ReadRoles;
	
	Query = New Query;
	Query.SetParameter("User", User);
	
	If TypeOf(User) = Type("CatalogRef.Users")
	 Or TypeOf(User) = Type("CatalogRef.ExternalUsers") Then
		
		Query.Text =
		"SELECT DISTINCT 
		|	Roles.Role AS Role
		|FROM
		|	Catalog.AccessGroupProfiles.Roles AS Roles
		|		INNER JOIN Catalog.AccessGroups.Users AS AccessGroups_Users
		|			INNER JOIN InformationRegister.UserGroupCompositions AS UserGroupCompositions
		|			ON (UserGroupCompositions.User = &User)
		|				AND (UserGroupCompositions.UsersGroup = AccessGroups_Users.User)
		|				AND (NOT AccessGroups_Users.Ref.DeletionMark)
		|		ON Roles.Ref = AccessGroups_Users.Ref.Profile
		|			AND (NOT Roles.Ref.DeletionMark)";
	Else
		// User group or External user group.
		Query.Text =
		"SELECT DISTINCT
		|	Roles.Role AS Role
		|FROM
		|	Catalog.AccessGroupProfiles.Roles AS Roles
		|		INNER JOIN Catalog.AccessGroups.Users AS AccessGroups_Users
		|		ON (AccessGroups_Users.User = &User)
		|			AND (NOT AccessGroups_Users.Ref.DeletionMark)
		|			AND Roles.Ref = AccessGroups_Users.Ref.Profile
		|			AND (NOT Roles.Ref.DeletionMark)";
	EndIf;
	
	ProcessRolesInterface(Form, "FillRoles", Query.Execute().Unload());
	
	Filter = New Structure("Role", "FullAccess");
	If ReadRoles.FindRows(Filter).Count() > 0 Then
		OriginalReadRoles = ReadRoles.Unload(, "Role");
		
		ReadRoles.Clear();
		ReadRoles.Add().Role = "FullAccess";
		
		StandardExtensionRoles = AccessManagementInternalCached.DescriptionStandardRolesSessionExtensions().SessionRoles;
		PossibleAdministratorRoles = New Map(StandardExtensionRoles.AdditionalAdministratorRoles);
		PossibleAdministratorRoles.Insert("SystemAdministrator", True);
		PossibleAdministratorRoles.Insert("InteractiveOpenExtReportsAndDataProcessors", True);
		
		For Each RoleDetails In PossibleAdministratorRoles Do
			Filter = New Structure("Role", RoleDetails.Key);
			If OriginalReadRoles.FindRows(Filter).Count() > 0 Then
				ReadRoles.Add().Role = RoleDetails.Key;
			EndIf;
		EndDo;
	EndIf;
	
EndProcedure

// For the AccessRights form, for the FillUserRoles procedure.
//
// Parameters:
//  Form - ClientApplicationForm
//  Action - See UsersInternal.ProcessRolesInterface.Action
//  MainParameter - Arbitrary
//
Procedure ProcessRolesInterface(Form, Action, MainParameter = Undefined) Export
	
	User    = Form.Parameters.User;
	ReadRoles = Form.ReadRoles;
	
	ActionParameters = New Structure;
	ActionParameters.Insert("MainParameter", MainParameter);
	ActionParameters.Insert("Form",            Form);
	ActionParameters.Insert("RolesCollection",   ReadRoles);
	
	If TypeOf(User) = Type("CatalogRef.Users")
	   And Users.IsFullUser(User, False, False) Then
		
		RolesAssignment = "ForAdministrators";
		
	ElsIf TypeOf(User) = Type("CatalogRef.ExternalUsers")
	      Or TypeOf(User) = Type("CatalogRef.ExternalUsersGroups") Then
		
		RolesAssignment = "ForExternalUsers";
	Else
		RolesAssignment = "ForUsers";
	EndIf;
	
	ActionParameters.Insert("RolesAssignment", RolesAssignment);
	ActionParameters.Insert("WithoutUpdatingRolesTree", True);
	
	UsersInternal.ProcessRolesInterface(Action, ActionParameters);
	
EndProcedure

// For the AccessRights and AccessRightsSimplified forms.
//
// Parameters:
//  Form - ClientApplicationForm
//
// Returns:
//  ValueList:
//    * Value - String - Role name.
//
Function UserRolesForRolesRightsReport(Form) Export
	
	RolesList = New ValueList;
	For Each CollectionRow In Form.ReadRoles Do
		RoleMetadata = Metadata.Roles.Find(CollectionRow.Role);
		If RoleMetadata = Undefined Then
			Continue;
		EndIf;
		RolesList.Add(RoleMetadata.Name, RoleMetadata.Synonym);
	EndDo;
	
	RolesList.SortByPresentation();
	
	Return RolesList;
	
EndFunction

