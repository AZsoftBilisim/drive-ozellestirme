#Region AccessUpdateProgressUpdate

// Returns:
//  Structure:
//   * ListsRows    - Map
//   * ListsOnForm    - Map
//   * ListsProperties  - Map
//   * KeysCount - Number
//   * LatestUpdateDate - Date
//   * ItemsByListsCount     - See NewQuantityByTables
//   * AccessKeysByListsCount - See NewQuantityByTables
//
Function NewStorableProgressUpdateData() Export
	
	StoredData = New Structure;
	StoredData.Insert("ListsRows",    New Map);
	StoredData.Insert("ListsOnForm",    New Map);
	StoredData.Insert("ListsProperties",  New Map);
	StoredData.Insert("KeysCount", 0);
	StoredData.Insert("LatestUpdateDate", '00010101');
	StoredData.Insert("ItemsByListsCount",     NewQuantityByTables());
	StoredData.Insert("AccessKeysByListsCount", NewQuantityByTables());
	
	Return StoredData;
	
EndFunction

// Parameters:
//  Context - Structure:
//   * Version - Number
//   * StoredData - See NewStorableProgressUpdateData
//   * CalculateByDataAmount - Boolean
//   * ShowProcessedLists - Boolean
//   * IsRepeatedProgressUpdate - Boolean
//   * UpdatedTotal - Number
//   * ProgressUpdatePeriod - Number
//   * ProgressAutoUpdate - Boolean
//   * AddedRows - Array
//   * DeletedRows - Map
//   * ModifiedRows - Map
//   * AccessUpdateInProgress - Boolean
//  
//  ResultAddress - String
//
Procedure UpdateProgressInBackground(Context, ResultAddress) Export
	
	ErrorText = Undefined;
	
	If Context.Property("Version") And Context.Version = 1 Then
		Try
			RefreshProgressBar(Context);
		Except
			ErrorInfo = ErrorInfo();
			If Not StandardSubsystemsServer.ThisErrorRequirementRestartSession(ErrorInfo) Then
				Raise;
			EndIf;
			ErrorText = ErrorProcessing.BriefErrorDescription(ErrorInfo);
		EndTry;
	Else
		ErrorText = NStr("vi = 'Đã cập nhật phiên bản ứng dụng, hãy khởi động lại phiên làm việc client.';
						|ru = 'Версия приложения обновлена, перезапустите клиентский сеанс.';
						|en = 'The app version is updated. Restart the app.'; fa = 'The app version is updated. Restart the app.';
						|it = 'Версия приложения обновлена, перезапустите клиентский сеанс.';
						|pl = 'The app version is updated. Restart the app.';
						|tr = 'Uygulama sürümü güncellendi, istemci oturumunu yeniden başlatın.'");
	EndIf;
	
	If ErrorText <> Undefined Then
		Context.Insert("ErrorInfo", StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Không thể cập nhật tiến trình do nguyên nhân:
			           |%1';
			           |ru = 'Не удалось обновить прогресс по причине:
			           |%1';
			           |en = 'Cannot update the progress bar. Reason:
			           |%1'; fa = 'Cannot update the progress bar. Reason:
			           |%1';
			           |it = 'Не удалось обновить прогресс по причине:
			           |%1';
			           |pl = 'Cannot update the progress bar. Reason:
			           |%1';
			           |tr = 'Şu nedenle ilerleme güncellenemedi:
			           |%1'"), ErrorText));
	EndIf;
	
	PutToTempStorage(Context, ResultAddress);
	
EndProcedure

// For the procedure, update the programfone.
Procedure RefreshProgressBar(TheFormContext)
	
	ProgressUpdateStartDate = CurrentSessionDate();
	TimeConsumingOperations.ReportProgress(0); // Update progress.
	
	Context = ContextOfProgressUpdate(TheFormContext);
	If Not Context.IsRepeatedProgressUpdate Then
		// In particular, it is reset on change to calculate the amount of data.
		Context.StoredData.LatestUpdateDate = '00010101';
		
	EndIf;
	If Not Context.CalculateByDataAmount Then
		Context.StoredData.KeysCount = 0;
		Context.StoredData.ItemsByListsCount     = NewQuantityByTables();
		Context.StoredData.AccessKeysByListsCount = NewQuantityByTables();
	EndIf;
	
	ListsWithAccessKeys = New Map;
	LinesWithChanges     = New Map;
	
	AddMissingRowsOfListsWithAccessKeys(Context, ListsWithAccessKeys, LinesWithChanges);
	
	AllUpdateLists = AllUpdateLists();
	
	AddMissingRowsOfUpdatedLists(Context, AllUpdateLists, LinesWithChanges);
	
	HiddenLists = New Map;
	UpdateListRows(Context, AllUpdateLists, ListsWithAccessKeys,
		HiddenLists, LinesWithChanges);
	
	QueryResults = ResultsOfAccessUpdateStateRequest(LinesWithChanges,
		Context.StoredData.LatestUpdateDate,
		Context.CalculateByDataAmount);
	Context.StoredData.LatestUpdateDate = ProgressUpdateStartDate;
	
	If Context.CalculateByDataAmount Then
		FillInParametersOfListUpdateTask(Context, QueryResults[4],
			"LastUpdatedItem", "LastUpdatedItemForExtrenalUsers");
		FillInParametersOfListUpdateTask(Context, QueryResults[5],
			"LastUpdatedAccessKey", "LastUpdatedAccessKeyForExtrenalUsers");
	EndIf;
	
	FillInFractionsOfProcessedElementsOfUpdatedLists(Context, QueryResults[1], LinesWithChanges);
	FillInSharesOfProcessedAccessKeysForUpdatedLists(Context, QueryResults[3], LinesWithChanges);
	
	UpdatedTotal = 100;
	If Context.CalculateByDataAmount Then
		AddLinesToUpdateNumberOfAccessKeys(Context, QueryResults[6]);
		CalculateUpdatedByDataCountTotal(Context, UpdatedTotal);
	Else
		CalculateTotalUpdatedByShares(Context, UpdatedTotal);
	EndIf;
	If UpdatedTotal > 100 Then
		UpdatedTotal = 100;
	EndIf;
	UpdatedTotal = Int(UpdatedTotal);
	
	FillInChangesForForm(TheFormContext, UpdatedTotal,
		HiddenLists, ProgressUpdateStartDate);
	
EndProcedure

// Parameters:
//  TheFormContext - See UpdateProgressInBackground.Context
//
// Returns:
//  Structure:
//   * IsRepeatedProgressUpdate - Boolean
//   * ShowProcessedLists - Boolean
//   * CalculateByDataAmount - Boolean
//   * StoredData - See NewStorableProgressUpdateData
//   * ActiveParameters - See ActiveAccessRestrictionParameters
//   * ElementsCountUpdateStrings - Map
//   * AccessKeysCountUpdateStrings - Map
//   * TablesTypesByNames - Map of KeyAndValue:
//      ** Key - String
//      ** Value - See TablesTypeProperties
//
Function ContextOfProgressUpdate(TheFormContext)
	
	Result = New Structure;
	Result.Insert("IsRepeatedProgressUpdate",         TheFormContext.IsRepeatedProgressUpdate);
	Result.Insert("ShowProcessedLists",            TheFormContext.ShowProcessedLists);
	Result.Insert("CalculateByDataAmount",          TheFormContext.CalculateByDataAmount);
	Result.Insert("StoredData",                          TheFormContext.StoredData);
	Result.Insert("ActiveParameters",                    Undefined);
	Result.Insert("ElementsCountUpdateStrings",     New Map);
	Result.Insert("AccessKeysCountUpdateStrings", New Map);
	Result.Insert("TablesTypesByNames",
		AccessManagementInternalCached.LanguageSyntax().TablesTypes.ByNames);
	
	Return Result;
	
EndFunction

// For the procedure, update the progress.
Procedure AddMissingRowsOfListsWithAccessKeys(Context, ListsWithAccessKeys, LinesWithChanges)
	
	ListsWithAccessKeys = ListsWithAccessKeys(Context.ActiveParameters);
	ListsRows = Context.StoredData.ListsRows;
	
	For Each KeyAndValue In ListsWithAccessKeys Do
		List = KeyAndValue.Key;
		TableProperties = KeyAndValue.Value;
		ListLine = ListsRows.Get(List);
		MetadataObject = Common.MetadataObjectByFullName(TableProperties.TableName);
		TableName = ?(MetadataObject = Undefined, "", MetadataObject.FullName());
		
		If ListLine = Undefined Then
			AddNewListRow(Context, List, TableName, LinesWithChanges, TableProperties);
			
		ElsIf ListLine.TableName <> TableName Then
			ListProperties = Context.StoredData.ListsProperties.Get(ListLine.List);
			ListProperties.IsReferenceType = ThisIsReferenceListType(TableName, Context);
			UpdateValueInRow(ListLine.TableName, TableName, ListLine);
			ListProperties.VersionOfRestriction = TableProperties.VersionOfRestriction;
			FillPropertyValues(ListProperties.AvailabilityOfAccessKeys, TableProperties.AvailabilityOfAccessKeys);
			LinesWithChanges.Insert(ListLine);
		EndIf;
	EndDo;
	
EndProcedure

// For the procedure, update the progress.
Function AllUpdateLists()
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	AllUpdateLists.List AS List,
	|	MAX(AllUpdateLists.UpdatingItemsForUsers) AS UpdatingItemsForUsers,
	|	MAX(AllUpdateLists.UpdatingItemsForExternalUsers) AS UpdatingItemsForExternalUsers,
	|	MAX(AllUpdateLists.UpdatingAccessKeysForUsers) AS UpdatingAccessKeysForUsers,
	|	MAX(AllUpdateLists.UpdatingAccessKeysForExternalUsers) AS UpdatingAccessKeysForExternalUsers
	|FROM
	|	(SELECT DISTINCT
	|		DataAccessKeysUpdate.List AS List,
	|		NOT DataAccessKeysUpdate.ForExternalUsers AS UpdatingItemsForUsers,
	|		DataAccessKeysUpdate.ForExternalUsers AS UpdatingItemsForExternalUsers,
	|		FALSE AS UpdatingAccessKeysForUsers,
	|		FALSE AS UpdatingAccessKeysForExternalUsers
	|	FROM
	|		InformationRegister.DataAccessKeysUpdate AS DataAccessKeysUpdate
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		UsersAccessKeysUpdate.List,
	|		FALSE,
	|		FALSE,
	|		NOT UsersAccessKeysUpdate.ForExternalUsers,
	|		UsersAccessKeysUpdate.ForExternalUsers
	|	FROM
	|		InformationRegister.UsersAccessKeysUpdate AS UsersAccessKeysUpdate) AS AllUpdateLists
	|
	|GROUP BY
	|	AllUpdateLists.List";
	
	Return Query.Execute().Unload();
	
EndFunction

// For the procedure, update the progress.
Function ResultsOfAccessUpdateStateRequest(LinesWithChanges, LatestUpdateDate, CalculateByDataAmount)
	
	ListsWithChanges = New Array;
	For Each KeyAndValue In LinesWithChanges Do
		ListsWithChanges.Add(KeyAndValue.Key.List);
	EndDo;
	
	Query = New Query;
	Query.SetParameter("ListsWithChanges", ListsWithChanges);
	Query.SetParameter("MaxDate", MaxDateOnContinue());
	Query.SetParameter("LatestUpdateDate", LatestUpdateDate);
	Query.SetParameter("BlankUUID",
		CommonClientServer.BlankUUID());
	
	QueriesTexts = New Array;
	
	QueriesTexts.Add(
	"SELECT DISTINCT
	|	EditedLists.List AS List
	|INTO ModifiedListsOfDataAccessKeys
	|FROM
	|	(SELECT DISTINCT
	|		UpdateKeys.List AS List
	|	FROM
	|		InformationRegister.DataAccessKeysUpdate AS UpdateKeys
	|	WHERE
	|		UpdateKeys.RegisterRecordChangeDate >= &LatestUpdateDate
	|		AND UpdateKeys.List <> UNDEFINED
	|	
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		UpdateKeys.List
	|	FROM
	|		InformationRegister.DataAccessKeysUpdate AS UpdateKeys
	|	WHERE
	|		UpdateKeys.List IN(&ListsWithChanges)) AS EditedLists
	|
	|INDEX BY
	|	List
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	UpdateKeys.List AS List,
	|	UpdateKeys.ForExternalUsers AS ForExternalUsers,
	|	UpdateKeys.UniqueKey = &BlankUUID AS IsMainRecord,
	|	MAX(UpdateKeys.JobSize) AS JobSize,
	|	MAX(UpdateKeys.RegisterRecordChangeDate) AS MaxChangeDate,
	|	MIN(UpdateKeys.RegisterRecordChangeDate) AS MinChangeDate
	|FROM
	|	ModifiedListsOfDataAccessKeys AS EditedLists
	|		INNER JOIN InformationRegister.DataAccessKeysUpdate AS UpdateKeys
	|		ON (UpdateKeys.List = EditedLists.List)
	|
	|GROUP BY
	|	UpdateKeys.List,
	|	UpdateKeys.ForExternalUsers,
	|	UpdateKeys.UniqueKey = &BlankUUID
	|TOTALS BY
	|	List,
	|	ForExternalUsers");
	
	QueriesTexts.Add(StrReplace(StrReplace(QueriesTexts[0],
			"ModifiedListsOfDataAccessKeys",
			"ModifiedListsOfUserAccessKeys"),
		"InformationRegister.DataAccessKeysUpdate",
		"InformationRegister.UsersAccessKeysUpdate"));
	
	If CalculateByDataAmount Then
		QueriesTexts.Add(
		"SELECT
		|	UpdateKeys.List AS List,
		|	UpdateKeys.ForExternalUsers AS ForExternalUsers,
		|	UpdateKeys.JobParameters AS JobParameters
		|FROM
		|	ModifiedListsOfDataAccessKeys AS EditedLists
		|		INNER JOIN InformationRegister.DataAccessKeysUpdate AS UpdateKeys
		|		ON (UpdateKeys.List = EditedLists.List)
		|			AND (UpdateKeys.UniqueKey = &BlankUUID)
		|TOTALS BY
		|	List");
		
		QueriesTexts.Add(StrReplace(StrReplace(QueriesTexts[2],
				"ModifiedListsOfDataAccessKeys",
				"ModifiedListsOfUserAccessKeys"),
			"InformationRegister.DataAccessKeysUpdate",
			"InformationRegister.UsersAccessKeysUpdate"));
		
		QueriesTexts.Add(
		"SELECT
		|	COUNT(*) AS Count
		|FROM
		|	Catalog.AccessKeys AS AccessKeys");
	EndIf;
	
	Query.Text = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	Return Query.ExecuteBatch();
	
EndFunction

// For the procedure, update the progress.
Procedure AddMissingRowsOfUpdatedLists(Context, AllUpdateLists, LinesWithChanges)
	
	ListsRows = Context.StoredData.ListsRows;
	CaseIdParametersOfHowExtensionVersionsWork =
		InternalID(ListForPlanningTheUpdateOfTheRightsCalculationCache());
	
	NewLists = New Array;
	For Each UpdateList1 In AllUpdateLists Do
		If Not ValueIsFilled(UpdateList1.List)
		 Or UpdateList1.List = CaseIdParametersOfHowExtensionVersionsWork Then
			Continue;
		EndIf;
		ListLine = ListsRows.Get(UpdateList1.List);
		If ListLine = Undefined Then
			NewLists.Add(UpdateList1.List);
		EndIf;
	EndDo;
	
	If Not ValueIsFilled(NewLists) Then
		Return;
	EndIf;
	
	MetadataObjectsByIDs = Common.MetadataObjectsByIDs(NewLists, False);
	For Each NewList In NewLists Do
		MetadataObject = MetadataObjectsByIDs.Get(NewList);
		If MetadataObject = Undefined Then
			Continue;
		ElsIf TypeOf(MetadataObject) = Type("MetadataObject") Then
			TableName = MetadataObject.FullName();
		Else
			TableName = "";
		EndIf;
		AddNewListRow(Context, NewList, TableName, LinesWithChanges);
	EndDo;
	
EndProcedure

// For the procedure, update the progress.
Procedure UpdateListRows(Context, AllUpdateLists, ListsWithAccessKeys,
			HiddenLists, LinesWithChanges)
	
	ListsRows            = Context.StoredData.ListsRows;
	ListsProperties          = Context.StoredData.ListsProperties;
	ListsRestrictionsVersions = Context.ActiveParameters.ListsRestrictionsVersions;
	
	LinesToDelete = New Array;
	For Each KeyAndValue In ListsRows Do
		ListLine = KeyAndValue.Value;
		UpdateList1 = AllUpdateLists.Find(ListLine.List, "List");
		
		If UpdateList1 = Undefined
		   And ListsWithAccessKeys.Get(ListLine.List) = Undefined Then
			
			LinesToDelete.Add(ListLine);
			Continue;
		EndIf;
		
		If UpdateList1 = Undefined
		   And Not Context.ShowProcessedLists
		 Or Not ValueIsFilled(ListLine.TableName) Then
			
			HiddenLists.Insert(ListLine.List, True);
		EndIf;
		
		ListProperties = ListsProperties.Get(ListLine.List);
		VersionOfRestriction = ListsRestrictionsVersions.Get(ListLine.TableName);
		If ListProperties.VersionOfRestriction <> VersionOfRestriction Then
			ListProperties.VersionOfRestriction = VersionOfRestriction;
			FillPropertyValues(ListProperties.AvailabilityOfAccessKeys,
				AvailabilityOfTableAccessKeys(ListLine.TableName, Context.ActiveParameters));
			LinesWithChanges.Insert(ListLine);
		EndIf;
		
		ResetListProperties(ListLine, LinesWithChanges, UpdateList1, "UpdatingItemsForUsers",
			ListProperties.ItemsUpdateJobSize,
			ListProperties.LastUpdatedItem,
			ListLine.ProcessedUsersItemsShare);
		
		ResetListProperties(ListLine, LinesWithChanges, UpdateList1, "UpdatingItemsForExternalUsers",
			ListProperties.ExternalUsersItemsUpdateJobSize,
			ListProperties.LastUpdatedItemForExtrenalUsers,
			ListLine.ProcessedExternalUsersItemsShare);
		
		ResetListProperties(ListLine, LinesWithChanges, UpdateList1, "UpdatingAccessKeysForUsers",
			ListProperties.AccessKeysUpdateJobSize,
			ListProperties.LastUpdatedAccessKey,
			ListLine.ProcessedUsersAccessKeysShare);
		
		ResetListProperties(ListLine, LinesWithChanges, UpdateList1, "UpdatingAccessKeysForExternalUsers",
			ListProperties.ExternalUsersAccessKeysUpdateJobSize,
			ListProperties.LastUpdatedAccessKeyForExtrenalUsers,
			ListLine.ProcessedExternalUsersAccessKeysShare);
		
		If UpdateList1 = Undefined Then
			UpdateValueInRow(ListLine.LatestUpdate, '00010101', ListLine);
			UpdateValueInRow(ListLine.FirstUpdateSchedule, MaxDate(), ListLine);
		EndIf;
	EndDo;
	
	If Not ValueIsFilled(LinesToDelete) Then
		Return;
	EndIf;
	
	ItemsByListsCount     = Context.StoredData.ItemsByListsCount;
	AccessKeysByListsCount = Context.StoredData.AccessKeysByListsCount;
	
	For Each RowToDelete In LinesToDelete Do
		ListsRows.Delete(RowToDelete.List);
		ListsProperties.Delete(RowToDelete.List);
		If Context.CalculateByDataAmount Then
			ItemsByListsCount.Delete(RowToDelete.List);
			AccessKeysByListsCount.Delete(RowToDelete.List);
		EndIf;
	EndDo;
	
EndProcedure

// For the procedure, update the progress.
Procedure FillInParametersOfListUpdateTask(Context, QueryResult,
			JobParametersFieldName, NameOfTaskParametersFieldForExternalUsers)
	
	ListsProperties = Context.StoredData.ListsProperties;
	
	SelectionByLists = QueryResult.Select(QueryResultIteration.ByGroups);
	While SelectionByLists.Next() Do
		ListProperties = ListsProperties.Get(SelectionByLists.List);
		If ListProperties = Undefined Then
			Continue;
		EndIf;
		SelectionByUsersKinds = SelectionByLists.Select();
		While SelectionByUsersKinds.Next() Do
			If SelectionByUsersKinds.ForExternalUsers Then
				FieldName = NameOfTaskParametersFieldForExternalUsers;
			Else
				FieldName = JobParametersFieldName;
			EndIf;
			If ListProperties[FieldName] <> True Then
				ListProperties[FieldName] = SelectionByUsersKinds.JobParameters;
			EndIf;
		EndDo;
	EndDo;
	
EndProcedure

// For the procedure, update the progress.
Procedure FillInFractionsOfProcessedElementsOfUpdatedLists(Context, QueryResult, LinesWithChanges)
	
	ListsRows   = Context.StoredData.ListsRows;
	ListsProperties = Context.StoredData.ListsProperties;
	
	ItemUpdateLines = New Map(New FixedMap(LinesWithChanges));
	ItemsUpdateLists = QueryResult.Unload(QueryResultIteration.ByGroups);
	
	For Each UpdateDetails1 In ItemsUpdateLists.Rows Do
		ListLine = ListsRows.Get(UpdateDetails1.List);
		If ListLine = Undefined Then
			Continue;
		EndIf;
		ListProperties = ListsProperties.Get(ListLine.List);
		FillProcessedShares(ListLine, UpdateDetails1, ListProperties, True);
		ItemUpdateLines.Insert(ListLine);
	EndDo;
	
	For Each KeyAndValue In ItemUpdateLines Do
		ListLine = KeyAndValue.Key;
		ListProperties = ListsProperties.Get(ListLine.List);
		UpdateItemProcessing(ListLine, ListProperties);
		If Context.CalculateByDataAmount Then
			Context.ElementsCountUpdateStrings.Insert(ListLine, ListLine.List);
		Else
			Processed = ProcessedByShares(ListLine.ProcessedUsersItemsShare,
				ListLine.ProcessedExternalUsersItemsShare, ListProperties.ProcessingOfElements);
			UpdateValueInRow(ListLine.ItemsProcessed, Processed, ListLine);
			ResetItemsCount(ListLine, ListProperties);
		EndIf;
	EndDo;
	
EndProcedure

// For the procedure, update the progress.
Procedure FillInSharesOfProcessedAccessKeysForUpdatedLists(Context, QueryResult, LinesWithChanges)
	
	ListsRows   = Context.StoredData.ListsRows;
	ListsProperties = Context.StoredData.ListsProperties;
	
	UpdateLinesForAccessKeys = New Map(New FixedMap(LinesWithChanges));
	AccessKeysUpdateLists = QueryResult.Unload(QueryResultIteration.ByGroups);
	
	For Each UpdateDetails1 In AccessKeysUpdateLists.Rows Do
		ListLine = ListsRows.Get(UpdateDetails1.List);
		If ListLine = Undefined Then
			Continue;
		EndIf;
		ListProperties = ListsProperties.Get(ListLine.List);
		FillProcessedShares(ListLine, UpdateDetails1, ListProperties, False);
		UpdateLinesForAccessKeys.Insert(ListLine);
	EndDo;
	
	For Each KeyAndValue In UpdateLinesForAccessKeys Do
		ListLine = KeyAndValue.Key;
		ListProperties = ListsProperties.Get(ListLine.List);
		UpdateAccessKeyProcessing(ListProperties);
		If Context.CalculateByDataAmount Then
			Context.AccessKeysCountUpdateStrings.Insert(ListLine, ListLine.List);
		Else
			Processed = ProcessedByShares(ListLine.ProcessedUsersAccessKeysShare,
				ListLine.ProcessedExternalUsersAccessKeysShare, ListProperties.ProcessingOfAccessKeys);
			UpdateValueInRow(ListLine.AccessKeysProcessed, Processed, ListLine);
			ResetAccessKeysCount(ListLine, ListProperties);
		EndIf;
	EndDo;
	
EndProcedure

// For the procedure, update the progress.
Procedure AddLinesToUpdateNumberOfAccessKeys(Context, QueryResult)
	
	ListsRows = Context.StoredData.ListsRows;
	KeysCount = QueryResult.Unload()[0].Count;
	
	If Context.IsRepeatedProgressUpdate
	   And Context.StoredData.KeysCount <> KeysCount Then
		
		For Each KeysAndValue In ListsRows Do
			ListLine = KeysAndValue.Value;
			Context.AccessKeysCountUpdateStrings.Insert(ListLine, ListLine.List);
		EndDo;
	EndIf;
	
	Context.StoredData.KeysCount = KeysCount;
	
EndProcedure

// For the procedure, update the progress.
Procedure CalculateTotalUpdatedByShares(Context, TotalUpdated)
	
	ListsRows   = Context.StoredData.ListsRows;
	ListsProperties = Context.StoredData.ListsProperties;
	
	CountTotal = 0;
	UpdatedTotal = 0;
	ProcessingIsPlanned = False;
	
	For Each KeyAndValue In ListsRows Do
		ListLine = KeyAndValue.Value;
		ListProperties = ListsProperties.Get(ListLine.List);
		
		AddMetricsByShare(CountTotal, UpdatedTotal, ProcessingIsPlanned,
			ListProperties.ProcessingOfElements, ListLine.ItemsProcessed);
		
		AddMetricsByShare(CountTotal, UpdatedTotal, ProcessingIsPlanned,
			ListProperties.ProcessingOfAccessKeys, ListLine.AccessKeysProcessed);
	EndDo;
	
	If CountTotal > 0 Then
		TotalUpdated = UpdatedTotal / CountTotal;
	EndIf;
	
	RefineResultOfEverythingUpdated(TotalUpdated, ProcessingIsPlanned);
	
EndProcedure

// For the procedure, update the progress.
Procedure FillInChangesForForm(Context, UpdatedTotal,
			HiddenLists, ProgressUpdateStartDate)
	
	Context.UpdatedTotal = UpdatedTotal;
	
	ListsOnForm = Context.StoredData.ListsOnForm;
	ListsRows = Context.StoredData.ListsRows;
	
	For Each KeyAndValue In ListsOnForm Do
		If ListsRows.Get(KeyAndValue.Key) = Undefined
		 Or HiddenLists.Get(KeyAndValue.Key) <> Undefined Then
			Context.DeletedRows.Insert(KeyAndValue.Key, True);
		EndIf;
	EndDo;
	For Each KeyAndValue In Context.DeletedRows Do
		ListsOnForm.Delete(KeyAndValue.Key);
	EndDo;
	
	For Each KeyAndValue In ListsRows Do
		List = KeyAndValue.Key;
		If HiddenLists.Get(List) <> Undefined Then
			Continue;
		EndIf;
		ListLine = KeyAndValue.Value;
		VersionOfLineOnForm = ListsOnForm.Get(List);
		
		If VersionOfLineOnForm = Undefined Then
			ListsOnForm.Insert(List, ListLine.StringVersion);
			Context.AddedRows.Add(ListLine);
			
		ElsIf VersionOfLineOnForm <> ListLine.StringVersion Then
			ListsOnForm.Insert(List, ListLine.StringVersion);
			Context.ModifiedRows.Insert(List, ListLine);
		EndIf;
	EndDo;
	
	// Adjusting the auto-update in the form.
	UpdateTime = CurrentSessionDate() - ProgressUpdateStartDate;
	
	If Context.IsRepeatedProgressUpdate
	   And UpdateTime > Context.ProgressUpdatePeriod Then
		
		Context.ProgressUpdatePeriod = UpdateTime;
	Else
		Context.Delete("ProgressUpdatePeriod");
	EndIf;
	
	If Not Context.IsRepeatedProgressUpdate And UpdateTime > 60 Then
		Context.ProgressAutoUpdate = False;
	Else
		Context.Delete("ProgressAutoUpdate");
	EndIf;
	
EndProcedure

// For procedures to fill in the fields of processed elements of renewable lists and
// Fill in the fields of processed keys for accessing renewable lists.
//
Procedure FillProcessedShares(ListLine, UpdateDetails1, ListProperties, IsItemsProcessing)
	
	For Each UpdateProperties In UpdateDetails1.Rows Do
		If IsItemsProcessing Then
			If UpdateProperties.ForExternalUsers Then
				JobSizeFieldName    = "ExternalUsersItemsUpdateJobSize";
				JobParametersFieldName = "LastUpdatedItemForExtrenalUsers";
				ShareFieldName              = "ProcessedExternalUsersItemsShare";
			Else
				JobSizeFieldName    = "ItemsUpdateJobSize";
				JobParametersFieldName = "LastUpdatedItem";
				ShareFieldName              = "ProcessedUsersItemsShare";
			EndIf;
		Else
			If UpdateProperties.ForExternalUsers Then
				JobSizeFieldName    = "ExternalUsersAccessKeysUpdateJobSize";
				JobParametersFieldName = "LastUpdatedAccessKeyForExtrenalUsers";
				ShareFieldName              = "ProcessedExternalUsersAccessKeysShare";
			Else
				JobSizeFieldName    = "AccessKeysUpdateJobSize";
				JobParametersFieldName = "LastUpdatedAccessKey";
				ShareFieldName              = "ProcessedUsersAccessKeysShare";
			EndIf;
		EndIf;
		MainRecordJobSize = ListProperties[JobSizeFieldName];
		NewRecordsJobSize = 0;
		For Each JobProperties In UpdateProperties.Rows Do
			If JobProperties.IsMainRecord Then
				If JobProperties.MaxChangeDate > ListLine.LatestUpdate Then
					UpdateValueInRow(ListLine.LatestUpdate,
						JobProperties.MaxChangeDate, ListLine);
				EndIf;
				MainRecordJobSize = JobProperties.JobSize;
			Else
				If JobProperties.MinChangeDate < ListLine.FirstUpdateSchedule Then
					UpdateValueInRow(ListLine.FirstUpdateSchedule,
						JobProperties.MinChangeDate, ListLine);
				EndIf;
				NewRecordsJobSize = JobProperties.JobSize;
			EndIf;
		EndDo;
		ListProperties[JobSizeFieldName] = MainRecordJobSize;
		If NewRecordsJobSize >= MainRecordJobSize Then
			ListProperties[JobParametersFieldName] = True;
			CurrentJobSize = NewRecordsJobSize;
		Else
			CurrentJobSize = MainRecordJobSize;
			If ListProperties[JobParametersFieldName] = True Then
				ListProperties[JobParametersFieldName] = Null;
			EndIf;
		EndIf;
		If CurrentJobSize = 1 Then
			ListLine[ShareFieldName] = 0.99;
		ElsIf CurrentJobSize = 2 Then
			ListLine[ShareFieldName] = 0.90;
		Else
			ListLine[ShareFieldName] = 0.00;
		EndIf;
	EndDo;
	
EndProcedure

// For procedures to fill in the fields of processed elements of renewable lists and
// Fill in the fields of processed keys for accessing renewable lists.
//
Function ProcessedByShares(ProcessedShareForUsers, ProcessedShareForExternalUsers, ListProcessing)
	
	If ListProcessing.ForUsers
	   And ListProcessing.ForExternalUsers Then
		
		Processed = Int((  ProcessedShareForUsers
		                  + ProcessedShareForExternalUsers) / 2 * 100);
		
	ElsIf ListProcessing.ForUsers Then
		Processed = Int(ProcessedShareForUsers * 100);
		
	ElsIf ListProcessing.ForExternalUsers Then
		Processed = Int(ProcessedShareForExternalUsers * 100);
	Else
		Processed = 100;
	EndIf;
	
	RefineResultProcessed(ListProcessing, Processed);
	
	Return Processed;
	
EndFunction

// For processing procedures by fields, update the processing by fields.
Procedure RefineResultProcessed(ListProcessing, Processed, Count = 0, ProcessedItemsCount = 0)
	
	If Not ListProcessing.ForUsers
	   And Not ListProcessing.ForExternalUsers Then
		
		Count = "";
		ProcessedItemsCount = "";
		
		If ListProcessing.PlannedForUsers
		 Or ListProcessing.ScheduledForExternalUsers Then
			Processed = 99;
		Else
			Processed = "";
		EndIf;
		
	ElsIf Processed = 100
	        And (    ListProcessing.PlannedForUsers
	           Or ListProcessing.ScheduledForExternalUsers) Then
		
		Processed = 99;
	EndIf;
	
EndProcedure

// For the procedure, calculate all the updated fields.
Procedure AddMetricsByShare(CountTotal, UpdatedTotal, ProcessingIsPlanned, ListProcessing, Processed)
	
	If ListProcessing.ForUsers
	 Or ListProcessing.ForExternalUsers Then
		
		CountTotal = CountTotal + ?(ListProcessing.ForUsers, 1, 0);
		CountTotal = CountTotal + ?(ListProcessing.ForExternalUsers, 1, 0);
		
		UpdatedTotal = UpdatedTotal + ?(ListProcessing.ForUsers, Processed, 0);
		UpdatedTotal = UpdatedTotal + ?(ListProcessing.ForExternalUsers, Processed, 0);
		
	ElsIf ListProcessing.PlannedForUsers
	      Or ListProcessing.ScheduledForExternalUsers Then
		
		ProcessingIsPlanned = True;
	EndIf;
	
EndProcedure

// For procedures, calculate all the updated fields, calculate all the updated data quantities.
Procedure RefineResultOfEverythingUpdated(UpdatedTotal, ProcessingIsPlanned)
	
	If ProcessingIsPlanned And UpdatedTotal >= 100 Then
		UpdatedTotal = 99;
	EndIf;
	
EndProcedure

// For the procedure, update the list of lists.
Procedure ResetListProperties(ListLine, LinesWithChanges, UpdateList1, NameOfListUpdateField,
			JobSize, LastUpdatedItem, PercentageOfProcessedItems)
	
	If UpdateList1 <> Undefined
	   And UpdateList1[NameOfListUpdateField] Then
		Return;
	EndIf;
	
	HasChanges = False;
	If JobSize <> 0 Then
		JobSize = 0;
		HasChanges = True;
	EndIf;
	
	If LastUpdatedItem <> Null Then
		LastUpdatedItem = Null;
		HasChanges = True;
	EndIf;
	
	If PercentageOfProcessedItems <> 1 Then
		PercentageOfProcessedItems = 1;
		HasChanges = True;
	EndIf;
	
	If HasChanges Then
		LinesWithChanges.Insert(ListLine);
	EndIf;
	
EndProcedure

Procedure ResetItemsCount(ListLine, ListProperties)
	
	Value = ?(  Not ListProperties.ProcessingOfElements.ForUsers
	             And Not ListProperties.ProcessingOfElements.ForExternalUsers, "", 0);
	
	UpdateValueInRow(ListLine.ItemCount, Value, ListLine);
	UpdateValueInRow(ListLine.ProcessedItemsCount, Value, ListLine);
	UpdateValueInRow(ListLine.ItemsForUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.ItemsForExternalUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.RemainingItemsForUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.LeftlUsersItemsShare, 0, ListLine);
	UpdateValueInRow(ListLine.RemainingItemsForExternalUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.LeftExternalUsersItemsShare, 0, ListLine);
	
EndProcedure

Procedure ResetAccessKeysCount(ListLine, ListProperties)
	
	Value = ?(  Not ListProperties.ProcessingOfAccessKeys.ForUsers
	             And Not ListProperties.ProcessingOfAccessKeys.ForExternalUsers, "", 0);
	
	UpdateValueInRow(ListLine.AccessKeysCount, Value, ListLine);
	UpdateValueInRow(ListLine.ProcessedAccessKeysCount, Value, ListLine);
	UpdateValueInRow(ListLine.AccessKeysForUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.AccessKeysForExternalUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.RemainingAccessKeysForUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.LeftUsersAccessKeysShare, 0, ListLine);
	UpdateValueInRow(ListLine.RemainingAccessKeysForExternalUsersCount, 0, ListLine);
	UpdateValueInRow(ListLine.LeftExternalUsersAccessKeysShare, 0, ListLine);
	
EndProcedure

// For procedures, add the remaining check-out access key and
// Add the remaining three renewable lists.
//
Procedure AddNewListRow(Context, List, TableName, LinesWithChanges, TableProperties = Undefined)
	
	ListLine = New Structure;
	ListLine.Insert("List", List);
	ListLine.Insert("ListPresentation", String(List));
	ListLine.Insert("TableName", TableName);
	ListLine.Insert("ItemsProcessed", 0);
	ListLine.Insert("AccessKeysProcessed", 0);
	ListLine.Insert("ItemCount", 0);
	ListLine.Insert("AccessKeysCount", 0);
	ListLine.Insert("ProcessedItemsCount", 0);
	ListLine.Insert("ProcessedAccessKeysCount", 0);
	ListLine.Insert("LatestUpdate", '00010101');
	ListLine.Insert("FirstUpdateSchedule", MaxDate());
	ListLine.Insert("StringVersion", New UUID);
	
	ListLine.Insert("ItemsForUsersCount", 0);
	ListLine.Insert("ProcessedUsersItemsShare", 1);
	ListLine.Insert("ItemsForExternalUsersCount", 0);
	ListLine.Insert("ProcessedExternalUsersItemsShare", 1);
	ListLine.Insert("AccessKeysForUsersCount", 0);
	ListLine.Insert("ProcessedUsersAccessKeysShare", 1);
	ListLine.Insert("AccessKeysForExternalUsersCount", 0);
	ListLine.Insert("ProcessedExternalUsersAccessKeysShare", 1);
	
	ListLine.Insert("RemainingItemsForUsersCount", 0);
	ListLine.Insert("LeftlUsersItemsShare", 0);
	ListLine.Insert("RemainingItemsForExternalUsersCount", 0);
	ListLine.Insert("LeftExternalUsersItemsShare", 0);
	ListLine.Insert("RemainingAccessKeysForUsersCount", 0);
	ListLine.Insert("LeftUsersAccessKeysShare", 0);
	ListLine.Insert("RemainingAccessKeysForExternalUsersCount", 0);
	ListLine.Insert("LeftExternalUsersAccessKeysShare", 0);
	
	Context.StoredData.ListsRows.Insert(List, ListLine);
	LinesWithChanges.Insert(ListLine);
	
	If TableProperties = Undefined Then
		VersionOfRestriction    = Context.ActiveParameters.ListsRestrictionsVersions.Get(TableName);
		AvailabilityOfAccessKeys = AvailabilityOfTableAccessKeys(TableName, Context.ActiveParameters);
	Else
		VersionOfRestriction    = TableProperties.VersionOfRestriction;
		AvailabilityOfAccessKeys = TableProperties.AvailabilityOfAccessKeys;
	EndIf;
	
	Properties = New Structure;
	Properties.Insert("List",                 List);
	Properties.Insert("VersionOfRestriction",      VersionOfRestriction);
	Properties.Insert("AvailabilityOfAccessKeys",   AvailabilityOfAccessKeys);
	Properties.Insert("ProcessingOfElements",     ProcessingForTable(AvailabilityOfAccessKeys));
	Properties.Insert("ProcessingOfAccessKeys", ProcessingForTable(AvailabilityOfAccessKeys));
	Properties.Insert("IsReferenceType",        ThisIsReferenceListType(TableName, Context));
	
	Properties.Insert("ItemsUpdateJobSize", 0);
	Properties.Insert("LastUpdatedItem", Null);
	Properties.Insert("AccessKeysUpdateJobSize", 0);
	Properties.Insert("LastUpdatedAccessKey", Null);
	
	Properties.Insert("ExternalUsersItemsUpdateJobSize", 0);
	Properties.Insert("LastUpdatedItemForExtrenalUsers", Null);
	Properties.Insert("ExternalUsersAccessKeysUpdateJobSize", 0);
	Properties.Insert("LastUpdatedAccessKeyForExtrenalUsers", Null);
	
	Context.StoredData.ListsProperties.Insert(List, Properties);
	
EndProcedure

// For procedures, add a new line to the list, add the remaining line to the list of access keys.
Function ThisIsReferenceListType(TableName, Context)
	
	If Not ValueIsFilled(TableName) Then
		Return False;
	EndIf;
	
	NameContent = StrSplit(TableName, ".", False);
	TypeProperties = Context.TablesTypesByNames.Get(Upper(NameContent[0]));
	If TypeProperties = Undefined Then
		Return False;
	EndIf;
	
	Return TypeProperties.IsReferenceType;
	
EndFunction

// Parameters:
//  TableName - String
//  ActiveParameters - See ActiveAccessRestrictionParameters
//
// Returns:
//  Structure:
//   * ForUsers - Boolean
//   * ForExternalUsers - Boolean
//
Function AvailabilityOfTableAccessKeys(TableName, ActiveParameters)
	
	VersionOfRestriction = ActiveParameters.ListsRestrictionsVersions.Get(TableName);
	
	Result = New Structure;
	Result.Insert("ForUsers",        ValueIsFilled(StrGetLine(VersionOfRestriction, 1)));
	Result.Insert("ForExternalUsers", ValueIsFilled(StrGetLine(VersionOfRestriction, 2)));
	
	Properties = New Structure("AdditionalContext");
	FillPropertyValues(Properties, ActiveParameters);
	If TypeOf(Properties.AdditionalContext) <> Type("FixedStructure")
	   And TypeOf(Properties.AdditionalContext) <> Type("Structure") Then
		Return Result;
	EndIf;
	AdditionalContext = New Structure("ForUsers, ForExternalUsers");
	FillPropertyValues(AdditionalContext, Properties.AdditionalContext);
	
	CheckAvailabilityOfAccessKeys(Result.ForUsers,
		TableName, AdditionalContext.ForUsers);
	
	CheckAvailabilityOfAccessKeys(Result.ForExternalUsers,
		TableName, AdditionalContext.ForExternalUsers);
	
	Return Result;
	
EndFunction

// Parameters:
//  AvailabilityOfKeys - Boolean
//  TableName - String
//  ContextForTypeOfUsers - Structure:
//   * ListRestrictionsProperties - Map of KeyAndValue:
//      ** Key     - String - full name of the list
//      ** Value - See NewListRestrictionProperties
//
Procedure CheckAvailabilityOfAccessKeys(AvailabilityOfKeys, TableName, ContextForTypeOfUsers)
	
	If TypeOf(ContextForTypeOfUsers) <> Type("FixedStructure")
	   And TypeOf(ContextForTypeOfUsers) <> Type("Structure") Then
		Return;
	EndIf;
	
	Properties = New Structure("ListRestrictionsProperties, ListsWithKeysRecordForDependentListsWithoutKeys");
	FillPropertyValues(Properties, ContextForTypeOfUsers);
	
	If TypeOf(Properties.ListsWithKeysRecordForDependentListsWithoutKeys) <> Type("FixedMap")
	   And TypeOf(Properties.ListsWithKeysRecordForDependentListsWithoutKeys) <> Type("Map")
	 Or Properties.ListsWithKeysRecordForDependentListsWithoutKeys.Get(TableName) <> Undefined Then
		AvailabilityOfKeys = True;
		Return;
	EndIf;
	
	If TypeOf(Properties.ListRestrictionsProperties) <> Type("FixedMap")
	   And TypeOf(Properties.ListRestrictionsProperties) <> Type("Map") Then
		Return;
	EndIf;
	
	RestrictionProperties = Properties.ListRestrictionsProperties.Get(TableName);
	If TypeOf(RestrictionProperties) <> Type("FixedStructure")
	   And TypeOf(RestrictionProperties) <> Type("Structure") Then
		Return;
	EndIf;
	
	If RestrictionProperties.AccessDenied
	 Or RestrictionProperties.OwnerField <> Undefined
	   And Not RestrictionProperties.OwnerField.Disabled Then
		AvailabilityOfKeys = False;
	EndIf;
	
EndProcedure

// Parameters:
//  AvailabilityOfAccessKeys - See AvailabilityOfTableAccessKeys
//
// Returns:
//  Structure:
//   * ForUsers - Boolean
//   * ForExternalUsers - Boolean
//   * PlannedForUsers - Boolean
//   * ScheduledForExternalUsers - Boolean
//
Function ProcessingForTable(AvailabilityOfAccessKeys)
	
	Result = New Structure;
	Result.Insert("ForUsers",        AvailabilityOfAccessKeys.ForUsers);
	Result.Insert("ForExternalUsers", AvailabilityOfAccessKeys.ForExternalUsers);
	Result.Insert("PlannedForUsers",        False);
	Result.Insert("ScheduledForExternalUsers", False);
	
	Return Result;
	
EndFunction

// For procedures, update the list of lists and
// Fill in the fields of processed elements of renewable lists.
//
Procedure UpdateItemProcessing(ListLine, ListProperties)
	
	ListProperties.ProcessingOfElements.PlannedForUsers =
		   ListProperties.ItemsUpdateJobSize <> 0
		Or ListProperties.LastUpdatedItem = True;
	
	ListProperties.ProcessingOfElements.ForUsers =
		ListProperties.AvailabilityOfAccessKeys.ForUsers
		Or ListLine.TableName = "Catalog.SetsOfAccessGroups"
		  And ListProperties.ProcessingOfElements.PlannedForUsers;
	
	
	ListProperties.ProcessingOfElements.ScheduledForExternalUsers =
		    ListProperties.ExternalUsersItemsUpdateJobSize <> 0
		Or ListProperties.LastUpdatedItemForExtrenalUsers = True;
	
	ListProperties.ProcessingOfElements.ForExternalUsers =
		ListProperties.AvailabilityOfAccessKeys.ForExternalUsers
		Or ListLine.TableName = "Catalog.SetsOfAccessGroups"
		  And ListProperties.ProcessingOfElements.ScheduledForExternalUsers;
	
EndProcedure

// For procedures, update the list of lists and
// Fill in the fields of processed elements of renewable lists.
//
Procedure UpdateAccessKeyProcessing(ListProperties)
	
	ListProperties.ProcessingOfAccessKeys.PlannedForUsers =
		    ListProperties.AccessKeysUpdateJobSize <> 0
		Or ListProperties.LastUpdatedAccessKey = True;
	
	ListProperties.ProcessingOfAccessKeys.ForUsers =
		ListProperties.AvailabilityOfAccessKeys.ForUsers;
	
	
	ListProperties.ProcessingOfAccessKeys.ScheduledForExternalUsers =
		    ListProperties.ExternalUsersAccessKeysUpdateJobSize <> 0
		Or ListProperties.LastUpdatedAccessKeyForExtrenalUsers = True;
	
	ListProperties.ProcessingOfAccessKeys.ForExternalUsers =
		ListProperties.AvailabilityOfAccessKeys.ForExternalUsers;
	
EndProcedure

// Parameters:
//  Context - See ContextOfProgressUpdate
//  All Updated - Number
//
Procedure CalculateUpdatedByDataCountTotal(Context, TotalUpdated)
	
	ItemsByListsCount     = Context.StoredData.ItemsByListsCount;
	AccessKeysByListsCount = Context.StoredData.AccessKeysByListsCount;
	ListsRows                    = Context.StoredData.ListsRows;
	ListsProperties                  = Context.StoredData.ListsProperties;
	
	For Each KeyAndValue In ListsRows Do
		ListLine = KeyAndValue.Value;
		If ItemsByListsCount.Get(ListLine.List) = Undefined Then
			Context.ElementsCountUpdateStrings.Insert(ListLine, ListLine.List);
		EndIf;
		If AccessKeysByListsCount.Get(ListLine.List) = Undefined Then
			Context.AccessKeysCountUpdateStrings.Insert(ListLine, ListLine.List);
		EndIf;
	EndDo;
	
	UpdateItemsAndAccessKeysCount(Context);
	
	ProcessingIsPlanned = False;
	TotalItemsCount     = 0;
	TotalAccessKeysCount = 0;
	UpdatedItemsTotal      = 0;
	UpdatedAccessKeysTotal  = 0;
	
	For Each KeyAndValue In ListsRows Do
		ListLine = KeyAndValue.Value;
		ListProperties = ListsProperties.Get(KeyAndValue.Key);
		
		AddMetricsByQuantity(TotalItemsCount, UpdatedItemsTotal, ProcessingIsPlanned,
			ItemsByListsCount.Get(ListLine.List),
			ListProperties.ProcessingOfElements, ListLine.ItemsProcessed);
		
		AddMetricsByQuantity(TotalAccessKeysCount, UpdatedAccessKeysTotal, ProcessingIsPlanned,
			AccessKeysByListsCount.Get(ListLine.List),
			ListProperties.ProcessingOfAccessKeys, ListLine.AccessKeysProcessed);
	EndDo;
	
	TotalUpdatedItems = ?(TotalItemsCount = 0, 100,
		UpdatedItemsTotal / TotalItemsCount);
	
	TotalUpdatedAccessKeys = ?(TotalAccessKeysCount = 0, 100,
		UpdatedAccessKeysTotal / TotalAccessKeysCount);
	
	TotalUpdated = (TotalUpdatedItems + TotalUpdatedAccessKeys) / 2;
	
	RefineResultOfEverythingUpdated(TotalUpdated, ProcessingIsPlanned);
	
EndProcedure

// For the procedure, calculate all the updated data quantities.
Procedure AddMetricsByQuantity(CommonCount, UpdatedTotal, ProcessingIsPlanned,
			QuantityForTable, ListProcessing, Processed)
		
	If ListProcessing.ForUsers
	 Or ListProcessing.ForExternalUsers Then
		
		Count = ?(ListProcessing.ForUsers,        QuantityForTable.ForUsers, 0)
		           + ?(ListProcessing.ForExternalUsers, QuantityForTable.ForExternalUsers, 0);
		
		CommonCount = CommonCount + Count;
		UpdatedTotal  = UpdatedTotal + Processed * Count;
		
	ElsIf ListProcessing.PlannedForUsers
	      Or ListProcessing.ScheduledForExternalUsers Then
		
		ProcessingIsPlanned = True;
	EndIf;
	
EndProcedure

// For the procedure, calculate all the updated data quantities.
Procedure UpdateItemsAndAccessKeysCount(Context)
	
	QueryDetails = New Structure("Query, QueryPackageTexts", New Query, New Array);
	IndexOf = 0;
	For Each KeyAndValue In Context.ElementsCountUpdateStrings Do
		ListLine = KeyAndValue.Key;
		AddItemsCountQueryText(QueryDetails, ListLine, IndexOf, Context, False);
		AddItemsCountQueryText(QueryDetails, ListLine, IndexOf, Context, True);
		AddQueryTextOfRemainingItemsCount(QueryDetails, ListLine, IndexOf, Context, False);
		AddQueryTextOfRemainingItemsCount(QueryDetails, ListLine, IndexOf, Context, True);
	EndDo;
	For Each KeyAndValue In Context.AccessKeysCountUpdateStrings Do
		ListLine = KeyAndValue.Key;
		AddQueryTextOfAccessKeysCount(QueryDetails, ListLine, IndexOf, Context, False);
		AddQueryTextOfAccessKeysCount(QueryDetails, ListLine, IndexOf, Context, True);
		AddQueryTextOfRemainingAccessKeysCount(QueryDetails, ListLine, IndexOf, Context, False);
		AddQueryTextOfRemainingAccessKeysCount(QueryDetails, ListLine, IndexOf, Context, True);
	EndDo;
	
	If QueryDetails.QueryPackageTexts.Count() = 0 Then
		Return;
	EndIf;
	
	QueryResults = ExecuteQueriesPackageByParts(QueryDetails);

	ItemsByListsCount     = Context.StoredData.ItemsByListsCount;
	AccessKeysByListsCount = Context.StoredData.AccessKeysByListsCount;
	ListsProperties                  = Context.StoredData.ListsProperties;
	
	IndexOf = 0;
	For Each KeyAndValue In Context.ElementsCountUpdateStrings Do
		ListLine = KeyAndValue.Key;
		ListProperties = ListsProperties.Get(ListLine.List);
		
		Selection = QueryResults[IndexOf].Select();
		ListLine.ItemsForUsersCount = ?(Selection.Next(), Selection.Count, 0);
		IndexOf = IndexOf + 1;
		
		Selection2 = QueryResults[IndexOf].Select();
		ListLine.ItemsForExternalUsersCount = ?(Not Selection2.Next(), 0,
			?(Selection2.Count = -2, Selection.Count, Selection2.Count));
		IndexOf = IndexOf + 1;
		
		ItemsByListsCount.Insert(ListLine.List, NewQuantityForTable(
			ListLine.ItemsForUsersCount,
			ListLine.ItemsForExternalUsersCount));
		
		UpdateNumberOfRemaining(QueryResults[IndexOf],
			ListProperties.LastUpdatedItem,
			ListLine.RemainingItemsForUsersCount,
			ListLine.ItemsForUsersCount,
			ListLine.LeftlUsersItemsShare,
			ListLine.ProcessedUsersItemsShare);
		IndexOf = IndexOf + 1;
		
		UpdateNumberOfRemaining(QueryResults[IndexOf],
			ListProperties.LastUpdatedItemForExtrenalUsers,
			ListLine.RemainingItemsForExternalUsersCount,
			ListLine.ItemsForExternalUsersCount,
			ListLine.LeftExternalUsersItemsShare,
			ListLine.ProcessedExternalUsersItemsShare);
		IndexOf = IndexOf + 1;
		
		UpdateProcessedByQuantity(ListLine, ListProperties, True,
			ListLine.ItemsForUsersCount,
			ListLine.ItemsForExternalUsersCount,
			ListLine.RemainingItemsForUsersCount,
			ListLine.RemainingItemsForExternalUsersCount);
	EndDo;
	
	For Each KeyAndValue In Context.AccessKeysCountUpdateStrings Do
		ListLine = KeyAndValue.Key;
		ListProperties = ListsProperties.Get(ListLine.List);
		
		Selection = QueryResults[IndexOf].Select();
		ListLine.AccessKeysForUsersCount = ?(Selection.Next(), Selection.Count, 0);
		IndexOf = IndexOf + 1;
		
		Selection = QueryResults[IndexOf].Select();
		ListLine.AccessKeysForExternalUsersCount = ?(Selection.Next(), Selection.Count, 0);
		IndexOf = IndexOf + 1;
		
		AccessKeysByListsCount.Insert(ListLine.List, NewQuantityForTable(
			ListLine.AccessKeysForUsersCount,
			ListLine.AccessKeysForExternalUsersCount));
		
		UpdateNumberOfRemaining(QueryResults[IndexOf],
			ListProperties.LastUpdatedAccessKey,
			ListLine.RemainingAccessKeysForUsersCount,
			ListLine.AccessKeysForUsersCount,
			ListLine.LeftUsersAccessKeysShare,
			ListLine.ProcessedUsersAccessKeysShare);
		IndexOf = IndexOf + 1;
		
		UpdateNumberOfRemaining(QueryResults[IndexOf],
			ListProperties.LastUpdatedAccessKeyForExtrenalUsers,
			ListLine.RemainingAccessKeysForExternalUsersCount,
			ListLine.AccessKeysForExternalUsersCount,
			ListLine.LeftExternalUsersAccessKeysShare,
			ListLine.ProcessedExternalUsersAccessKeysShare);
		IndexOf = IndexOf + 1;
		
		UpdateProcessedByQuantity(ListLine, ListProperties, False,
			ListLine.AccessKeysForUsersCount,
			ListLine.AccessKeysForExternalUsersCount,
			ListLine.RemainingAccessKeysForUsersCount,
			ListLine.RemainingAccessKeysForExternalUsersCount);
	EndDo;
	
EndProcedure

// Returns:
//  Map of KeyAndValue:
//   * Key - See Common.MetadataObjectIDs
//   * Value - See NewQuantityForTable
//
Function NewQuantityByTables()
	
	Return New Map;
	
EndFunction

// Parameters:
//  ForUsers        - Number
//  ForExternalUsers - Number
//
// Returns:
//  Structure:
//   * ForUsers        - Number
//   * ForExternalUsers - Number
//
Function NewQuantityForTable(ForUsers, ForExternalUsers)
	
	Result = New Structure;
	Result.Insert("ForUsers",        ForUsers);
	Result.Insert("ForExternalUsers", ForExternalUsers);
	
	Return Result;
	
EndFunction

// For the procedure, update the number of elements and key access.
Procedure UpdateNumberOfRemaining(QueryResult, IsLastUpdated,
			RemainingCount, Count, RemainingPortion, ProcessedPortion)
	
	If Count = 0 Then
		RemainingCount = 0;
		RemainingPortion = 0;
		Return;
	EndIf;
	
	If IsLastUpdated = Null Or IsLastUpdated = True Then
		NewRemainingCount = -1;
	Else
		Selection = QueryResult.Select();
		NewRemainingCount = ?(Selection.Next(), Selection.Count, 0);
	EndIf;
	
	If NewRemainingCount = -1 Then
		RemainingPortion = 0;
		NewRemainingCount = 0;
	EndIf;
	
	If TypeOf(NewRemainingCount) = Type("Number") Then
		RemainingCount = Int(Count * (1 - ProcessedPortion - RemainingPortion) + 0.99)
			+ Int(NewRemainingCount * RemainingPortion);
	EndIf;
	
EndProcedure

// For the procedure, update the number of elements and key access.
Procedure UpdateProcessedByQuantity(ListLine, ListProperties, IsItemsProcessing,
			QuantityForUsers, QuantityForExternalUsers,
			NumberOfRemainingForUsers, NumberOfRemainingForExternalUsers)
	
	NumberOfProcessedForUsers =
		QuantityForUsers - NumberOfRemainingForUsers;
	
	NumberOfProcessedForExternalUsers =
		QuantityForExternalUsers - NumberOfRemainingForExternalUsers;
	
	ListProcessing = ?(IsItemsProcessing,
		ListProperties.ProcessingOfElements, ListProperties.ProcessingOfAccessKeys);
	
	Count =
		  ?(ListProcessing.ForUsers,        QuantityForUsers, 0)
		+ ?(ListProcessing.ForExternalUsers, QuantityForExternalUsers, 0);
	ProcessedItemsCount =
		  ?(ListProcessing.ForUsers,        NumberOfProcessedForUsers, 0)
		+ ?(ListProcessing.ForExternalUsers, NumberOfProcessedForExternalUsers, 0);
		
	If IsItemsProcessing
	   And ListProperties.IsReferenceType
	   And ListProcessing.ForUsers
	   And ListProcessing.ForExternalUsers Then
		
		Count             = Int(Count / 2);
		ProcessedItemsCount = Int(ProcessedItemsCount / 2);
	EndIf;
	
	If ProcessedItemsCount > Count Then
		ProcessedItemsCount = Count;
	EndIf;
	
	Processed = ?(Count = 0, 100, Int(ProcessedItemsCount / Count * 100));
	
	RefineResultProcessed(ListProcessing, Processed, Count, ProcessedItemsCount);
	
	If IsItemsProcessing Then
		UpdateValueInRow(ListLine.ItemCount, Count, ListLine);
		UpdateValueInRow(ListLine.ProcessedItemsCount, ProcessedItemsCount, ListLine);
		UpdateValueInRow(ListLine.ItemsProcessed, Processed, ListLine);
	Else
		UpdateValueInRow(ListLine.AccessKeysCount, Count, ListLine);
		UpdateValueInRow(ListLine.ProcessedAccessKeysCount, ProcessedItemsCount, ListLine);
		UpdateValueInRow(ListLine.AccessKeysProcessed, Processed, ListLine);
	EndIf;
	
EndProcedure

// Returns:
//  Array of QueryResult
//
Function ExecuteQueriesPackageByParts(QueryDetails)
	
	QueriesPackageResults = New Array;
	
	QueriesBatchTexts = New Array;
	For Each QueryText In QueryDetails.QueryPackageTexts Do
		If QueriesBatchTexts.Count() = 200 Then
			// @skip-check query-in-loop - Batch data processing
			AddQueryResults(QueriesPackageResults, QueriesBatchTexts, QueryDetails);
			QueriesBatchTexts = New Array;
		EndIf;
		QueriesBatchTexts.Add(QueryText);
	EndDo;
	AddQueryResults(QueriesPackageResults, QueriesBatchTexts, QueryDetails);
	
	Return QueriesPackageResults;
	
EndFunction

// For the procedure, execute a package of requests to the frequencies.
Procedure AddQueryResults(QueriesPackageResults, QueriesBatchTexts, QueryDetails)
	
	Query = QueryDetails.Query;
	
	Query.Text = StrConcat(QueriesBatchTexts, Common.QueryBatchSeparator());
	QueryResults = Query.ExecuteBatch();
	Query.Text = "";
	
	For Each QueryResult In QueryResults Do
		QueriesPackageResults.Add(QueryResult);
	EndDo;
	
EndProcedure

Procedure UpdateValueInRow(PreviousValue2, NewValue, ListLine)
	
	If PreviousValue2 = NewValue Then
		Return;
	EndIf;
	PreviousValue2 = NewValue;
	ListLine.StringVersion = New UUID;
	
EndProcedure

Procedure AddItemsCountQueryText(QueryDetails, ListLine, IndexOf,
			Context, ForExternalUsers)
	
	ListProperties = Context.StoredData.ListsProperties.Get(ListLine.List);
	HasDataProcessor = Not ForExternalUsers And ListProperties.ProcessingOfElements.ForUsers
	               Or ForExternalUsers And ListProperties.ProcessingOfElements.ForExternalUsers;
	
	If ValueIsFilled(ListLine.TableName)
	   And HasDataProcessor Then
		
		If ListLine.TableName = "Catalog.SetsOfAccessGroups" Then
			QueryText =
			"SELECT
			|	COUNT(*) AS Count
			|FROM
			|	Catalog.SetsOfAccessGroups AS CurrentTable
			|WHERE
			|	CurrentTable.ForExternalUsers = &ForExternalUsers";
			QueryText = StrReplace(QueryText, "&ForExternalUsers",
				?(ForExternalUsers, "TRUE", "FALSE"));
			
		ElsIf Not ListProperties.IsReferenceType Then
			QueryText = RegisterItemsCountQueryText(Context, ListLine, ForExternalUsers);
			
		ElsIf Not ForExternalUsers Then
			QueryText =
			"SELECT
			|	COUNT(*) AS Count
			|FROM
			|	&CurrentTable AS CurrentTable";
		Else
			QueryText =
			"SELECT
			|	-2 AS Count";
		EndIf;
		QueryText = StrReplace(QueryText, "&CurrentTable", ListLine.TableName);
	Else
		QueryText =
		"SELECT
		|	0 AS Count";
	EndIf;
	
	QueryDetails.QueryPackageTexts.Add(QueryText);
	IndexOf = IndexOf + 1;
	
EndProcedure

// For the procedure, add a text of a number of elements.
Function RegisterItemsCountQueryText(Context, ListLine, ForExternalUsers)
	
	If ForExternalUsers Then
		AdditionalContext = Context.ActiveParameters.AdditionalContext.ForExternalUsers;
	Else
		AdditionalContext = Context.ActiveParameters.AdditionalContext.ForUsers;
	EndIf;
	RestrictionProperties = AdditionalContext.ListRestrictionsProperties.Get(ListLine.TableName);
	
	If RestrictionProperties = Undefined
	 Or RestrictionProperties.BasicFields = Undefined
	 Or RestrictionProperties.BasicFields.UsedItems.Count() = 0 Then
	
		Return
		"SELECT
		|	0 AS Count";
	EndIf;
	
	SelectionFields = "";
	For Each FieldName In RestrictionProperties.BasicFields.UsedItems Do
		SelectionFields = SelectionFields + ?(SelectionFields = "", "", ",
		|		") + "CurrentTable." + FieldName;
	EndDo;
	
	If RestrictionProperties.BasicFields.UsedItems.Count() = 1 Then
		QueryText =
		"SELECT
		|	COUNT(DISTINCT &SelectionFields) AS Count
		|FROM
		|	&CurrentTable AS CurrentTable";
	Else
		QueryText =
		"SELECT
		|	COUNT(*) AS Count
		|FROM
		|	(SELECT DISTINCT
		|		&SelectionFields AS SelectionFields
		|	FROM
		|		&CurrentTable AS CurrentTable) AS Combinations";
		SelectionFields = TextWithIndent(SelectionFields, "	");
	EndIf;
	
	QueryText = StrReplace(QueryText, "&SelectionFields", SelectionFields);
	
	Return QueryText;
	
EndFunction

Procedure AddQueryTextOfRemainingItemsCount(QueryDetails, ListLine, IndexOf,
			Context, ForExternalUsers)
	
	ListProperties = Context.StoredData.ListsProperties.Get(ListLine.List);
	ListsWithDate   = Context.ActiveParameters.ListsWithDate;
	TableName     = ListLine.TableName;
	HasDataProcessor  = Not ForExternalUsers And ListProperties.ProcessingOfElements.ForUsers
	                Or ForExternalUsers And ListProperties.ProcessingOfElements.ForExternalUsers;
	
	If ValueIsFilled(TableName)
	   And HasDataProcessor Then
		
		NameContent = StrSplit(TableName, ".", False);
		TypeProperties = Context.TablesTypesByNames.Get(Upper(NameContent[0]));
	Else
		ListProperties = Undefined;
	EndIf;
	
	If ListProperties = Undefined Then
		JobParameters = Undefined;
		
	ElsIf ForExternalUsers Then
		JobParameters = ListProperties.LastUpdatedItemForExtrenalUsers;
	Else
		JobParameters = ListProperties.LastUpdatedItem;
	EndIf;
	
	If TypeOf(JobParameters) <> Type("ValueStorage") Then
		QueryText =
		"SELECT
		|	UNDEFINED AS Count";
	Else
		ItemsCountShares = New Structure("Processed2, Left1", 0, 1);
		JobParameters = JobParameters.Get();
		
		If TypeOf(JobParameters) = Type("Structure")
		   And JobParameters.Property("LastUpdatedItem")
		   And TypeOf(JobParameters.LastUpdatedItem) = Type("Structure")
		   And JobParameters.LastUpdatedItem.Property("DataKeyKind")
		   And DataKeyKindOrder(JobParameters.LastUpdatedItem.DataKeyKind) <> Undefined
		   And JobParameters.LastUpdatedItem.Property("DataKey")
		   And JobParameters.LastUpdatedItem.Property("ProcessObsoleteItems")
		   And TypeOf(JobParameters.LastUpdatedItem.ProcessObsoleteItems) = Type("Boolean") Then
			
			LastUpdatedItem = JobParameters.LastUpdatedItem;
		Else
			LastUpdatedItem = New Structure;
			LastUpdatedItem.Insert("DataKeyKind", "DataItemsWithObsoleteKeys");
			LastUpdatedItem.Insert("DataKey");
		EndIf;
		
		FilterCriterion = "";
		If ListProperties.IsReferenceType Then
			DataKey = LastUpdatedItem.DataKey;
			If ListsWithDate.Get(TableName) <> Undefined Then
				
				If LastUpdatedItem.Property("Date")
				   And TypeOf(LastUpdatedItem.Date) = Type("Date") Then
					
					ParameterName = "LastDate" + Format(IndexOf, "NG=");
					FilterCriterion = "CurrentTable.Date <= &" + ParameterName;
					QueryDetails.Query.SetParameter(ParameterName, LastUpdatedItem.Date);
				EndIf;
				
			ElsIf ValueIsFilled(DataKey) Then
				MetadataObject = Metadata.FindByType(TypeOf(DataKey));
				If MetadataObject <> Undefined
				   And MetadataObject.FullName() = TableName Then
					
					ParameterName = "LastRef" + Format(IndexOf, "NG=");
					FilterCriterion = "CurrentTable.Ref > &" + ParameterName;
					QueryDetails.Query.SetParameter(ParameterName, DataKey);
				EndIf;
			EndIf;
			If ValueIsFilled(FilterCriterion) Then
				QueryText =
				"SELECT
				|	COUNT(*) AS Count
				|FROM
				|	&CurrentTable AS CurrentTable
				|WHERE
				|	&FilterCriterion";
				QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
			Else
				QueryText =
				"SELECT
				|	-1 AS Count";
			EndIf;
			FillSharesRefTypeItemsCount(ItemsCountShares,
				LastUpdatedItem, TableName);
		Else
			If ForExternalUsers Then
				AdditionalContext = Context.ActiveParameters.AdditionalContext.ForExternalUsers;
			Else
				AdditionalContext = Context.ActiveParameters.AdditionalContext.ForUsers;
			EndIf;
			RestrictionProperties = AdditionalContext.ListRestrictionsProperties.Get(TableName);
			
			If RestrictionProperties <> Undefined Then
				AccessOptionsUsed = AdditionalContext.BasicAccessOptions.Get(TableName);
				If AccessOptionsUsed = Undefined Then
					RestrictionProperties = Undefined;
				Else
					RestrictionProperties = New Structure(RestrictionProperties);
					RestrictionProperties.Insert("AccessOption", AccessOptionsUsed[0].AccessOption);
				EndIf;
			EndIf;
			
			FillRegisterItemsCountShares(ItemsCountShares,
				LastUpdatedItem, RestrictionProperties);
			
			QueryText = QueryTextOfRemainingRegisterItemsCount(QueryDetails, ListLine, IndexOf,
				ForExternalUsers, LastUpdatedItem, RestrictionProperties, TypeProperties);
		EndIf;
		QueryText = StrReplace(QueryText, "&CurrentTable", TableName);
		
		If ForExternalUsers Then
			ListLine.ProcessedExternalUsersItemsShare = ItemsCountShares.Processed2;
			ListLine.LeftExternalUsersItemsShare   = ItemsCountShares.Left1;
		Else
			ListLine.ProcessedUsersItemsShare = ItemsCountShares.Processed2;
			ListLine.LeftlUsersItemsShare   = ItemsCountShares.Left1;
		EndIf;
	EndIf;
	
	QueryDetails.QueryPackageTexts.Add(QueryText);
	IndexOf = IndexOf + 1;
	
EndProcedure

// For the procedure, add a text asking for the number of elements that have been added.
Procedure FillSharesRefTypeItemsCount(ItemsCountShares, Item, TableName)
	
	If TableName = "Catalog.SetsOfAccessGroups" Then
		If Item.DataKeyKind = "NewSingleUserSets" Then
			
			ItemsCountShares.Processed2 = 0.0;
			ItemsCountShares.Left1   = 0.1;
			
		ElsIf Item.DataKeyKind = "AccessGroupsSetsAssignedToUsers" Then
			
			ItemsCountShares.Processed2 = 0.1;
			ItemsCountShares.Left1   = 0.1;
			
		ElsIf Item.DataKeyKind = "UserGroupSetsAssignedToUsers" Then
			
			ItemsCountShares.Processed2 = 0.2;
			ItemsCountShares.Left1   = 0.1;
			
		ElsIf Item.DataKeyKind = "NewGroupsSetsWithObsoleteRights" Then
			
			ItemsCountShares.Processed2 = 0.3;
			ItemsCountShares.Left1   = 0.2;
			
		ElsIf Item.DataKeyKind = "GroupSetsAllowedForUsers" Then
			
			ItemsCountShares.Processed2 = 0.5;
			ItemsCountShares.Left1   = 0.1;
			
		ElsIf Item.DataKeyKind = "GroupsSetsWithObsoleteRights" Then
			
			ItemsCountShares.Processed2 = 0.6;
			ItemsCountShares.Left1   = 0.3;
			
		Else // ObsoleteItems.
			ItemsCountShares.Processed2 = 0.9;
			ItemsCountShares.Left1   = 0.1;
		EndIf;
		Return;
	EndIf;
	
	If Item.DataKeyKind = "ItemsWithObsoleteKeys" Then
		ItemsCountShares.Processed2 = 0.0;
		ItemsCountShares.Left1   = 0.9;
	Else // ObsoleteItems.
		ItemsCountShares.Processed2 = 0.9;
		ItemsCountShares.Left1   = 0.1;
	EndIf;
	
EndProcedure

// For the procedure, add a text asking for the number of elements that have been added.
Function QueryTextOfRemainingRegisterItemsCount(QueryDetails, ListLine, IndexOf,
			ForExternalUsers, LastUpdatedItem, RestrictionProperties, TypeProperties)
	
	DataKeyKind = LastUpdatedItem.DataKeyKind;
	DataKey     = LastUpdatedItem.DataKey;
	
	If RestrictionProperties = Undefined
	 Or RestrictionProperties.BasicFields = Undefined
	 Or RestrictionProperties.BasicFields.UsedItems.Count() = 0
	 Or TypeOf(DataKey) <> Type("Structure")
	 Or DataKeyKind = "ItemsWithoutKeysByPeriod"
	   And (Not LastUpdatedItem.Property("Date")
	      Or TypeOf(LastUpdatedItem.Date) <> Type("Date"))
	 Or DataKeyKind = "ItemsWithoutKeysByFieldValues"
	   And RestrictionProperties.BasicFields.UsedItems.Count() <> DataKey.Count()
	 Or DataKeyKind <> "ItemsWithoutKeysByPeriod"
	   And DataKeyKind <> "ItemsWithoutKeysByFieldValues"
	   And RestrictionProperties.BasicFields.UsedItems.Count() > DataKey.Count() Then
	
		Return
		"SELECT
		|	-1 AS Count";
	EndIf;
	
	SelectionFields = "";
	FilterCriterion = "";
	ConnectionCondition = "";
	
	If ValueIsFilled(RestrictionProperties.SeparateKeysRegisterName) Then
		KeysRegisterName = RestrictionProperties.SeparateKeysRegisterName;
	Else
		KeysRegisterName = "AccessKeysForRegisters";
		ParameterName = "RegisterID" + Format(IndexOf, "NG=");
		ConnectionCondition = "(AccessKeysForRegisters.Register = &" + ParameterName + ")";
		QueryDetails.Query.SetParameter(ParameterName, ListLine.List);
	EndIf;
	
	BasicFields = RestrictionProperties.BasicFields;
	FilterByUsersType = XMLString(RestrictionProperties.AccessOption);
	ConnectionCondition = ConnectionCondition + ?(ConnectionCondition = "", "", "
	|			AND ") + "(AccessKeysForRegisters.AccessOption = " + FilterByUsersType + ")"; // @query-part-3
	
	FieldNumber = 1;
	For Each FieldName In BasicFields.UsedItems Do
		FieldNameInDataKey = StrTemplate("Field%1", FieldNumber);
		ParameterName = FieldName + Format(IndexOf, "NG=");
		
		ConnectionCondition = ConnectionCondition + ?(ConnectionCondition = "", "", "
		|			AND ") + StrTemplate("(AccessKeysForRegisters.Field%1 = CurrentTable.%2)", FieldNumber, FieldName); // @query-part-3
		
		Filter = "";
		For CurrentIndex = 0 To FieldNumber - 2 Do
			CurrentFieldName = BasicFields.UsedItems[CurrentIndex];
			CurrentParameterName = CurrentFieldName + Format(IndexOf, "NG=");
			Filter = Filter + ?(Filter = "", "", "
			|	AND ") + "CurrentTable." + CurrentFieldName + " = &" + CurrentParameterName; // @query-part-3
		EndDo;
		Filter = Filter + ?(Filter = "", "", "
		|	AND ") + "CurrentTable." + FieldName + " > &" + ParameterName; // @query-part-3
		
		FilterCriterion = FilterCriterion + ?(FieldNumber = 1, ?(BasicFields.UsedItems.Count() > 1, "(", "") + Filter, "
		|		OR " + TextWithIndent(Filter, "		")); // @query-part-3
	
		If DataKey.Property(FieldNameInDataKey) Then
			QueryDetails.Query.SetParameter(ParameterName, DataKey[FieldNameInDataKey]);
		Else
			QueryDetails.Query.SetParameter(ParameterName, Undefined);
		EndIf;
		SelectionFields = SelectionFields + ?(SelectionFields = "", "", ",
		|	") + "CurrentTable." + FieldName;
		FieldNumber = FieldNumber + 1;
	EndDo;
	
	If BasicFields.UsedItems.Count() > 1 Then
		FilterCriterion  = FilterCriterion  + ")";
	EndIf;
	
	If DataKeyKind = "ItemsWithoutKeysByPeriod" Then
		PeriodFieldName = ?(TypeProperties.CollectionName = "CalculationRegisters", "RegistrationPeriod", "Period");
		ParameterName = PeriodFieldName + Format(IndexOf, "NG=");
		FilterCriterion = "(CurrentTable." + PeriodFieldName + " < &" + ParameterName + "
		|	OR CurrentTable." 
		+ PeriodFieldName + " = &" + ParameterName + "
		|		AND " + TextWithIndent(FilterCriterion, "	") + ")"; // @query-part-3, @query-part-5
		QueryDetails.Query.SetParameter(ParameterName, LastUpdatedItem.Date);
	EndIf;
	
	If RestrictionProperties.BasicFields.UsedItems.Count() = 1 Then
		QueryText =
		"SELECT
		|	COUNT(DISTINCT &SelectionFields) AS Count
		|FROM
		|	&CurrentTable AS CurrentTable
		|		LEFT JOIN CurrentList AS AccessKeysForRegisters
		|		ON (&ConnectionCondition)
		|WHERE
		|	&FilterCriterion
		|	AND AccessKeysForRegisters.AccessOption IS NULL";
	Else
		QueryText =
		"SELECT
		|	COUNT(*) AS Count
		|FROM
		|	(SELECT DISTINCT
		|		&SelectionFields AS SelectionFields
		|	FROM
		|		&CurrentTable AS CurrentTable
		|			LEFT JOIN CurrentList AS AccessKeysForRegisters
		|			ON (&ConnectionCondition)
		|	WHERE
		|		&FilterCriterion
		|		AND AccessKeysForRegisters.AccessOption IS NULL) AS Combinations";
		SelectionFields    = TextWithIndent(SelectionFields, "	");
		FilterCriterion = TextWithIndent(FilterCriterion, "	");
	EndIf;
	
	QueryText = StrReplace(QueryText, "(&ConnectionCondition)", ConnectionCondition);
	QueryText = StrReplace(QueryText, "&SelectionFields",    SelectionFields);
	QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
	QueryText = StrReplace(QueryText, "CurrentList", "InformationRegister." + KeysRegisterName);
	
	Return QueryText;
	
EndFunction

// For the procedure, add a text asking for the number of elements that have been added.
Procedure FillRegisterItemsCountShares(ItemsCountShares, Item, RestrictionProperties)
	
	If Item.DataKeyKind = "ItemsWithObsoleteKeys" Then
		
		ItemsCountShares.Processed2 = 0.0;
		ItemsCountShares.Left1   = 0.5;
		
	ElsIf Item.DataKeyKind = "ItemsWithoutKeysByFieldValues"
	      Or Item.DataKeyKind = "ItemsWithoutKeysByPeriod" Then
		
		ItemsCountShares.Processed2 = 0.5;
		ItemsCountShares.Left1   = 0.4;
		
	ElsIf Item.DataKeyKind = "ObsoleteItems" Then
		
		If RestrictionProperties <> Undefined
		   And ValueIsFilled(RestrictionProperties.SeparateKeysRegisterName) Then
			
			ItemsCountShares.Processed2 = 0.90;
			ItemsCountShares.Left1   = 0.09;
		Else
			ItemsCountShares.Processed2 = 0.9;
			ItemsCountShares.Left1   = 0.1;
		EndIf;
		
	Else // InvalidItems or InvalidItemsInCommonRegister.
		ItemsCountShares.Processed2 = 0.99;
		ItemsCountShares.Left1   = 0.01;
	EndIf;
	
EndProcedure

Procedure AddQueryTextOfAccessKeysCount(QueryDetails, ListLine, IndexOf,
			Context, ForExternalUsers)
	
	ListProperties = Context.StoredData.ListsProperties.Get(ListLine.List);
	HasDataProcessor  = Not ForExternalUsers And ListProperties.ProcessingOfAccessKeys.ForUsers
	                Or ForExternalUsers And ListProperties.ProcessingOfAccessKeys.ForExternalUsers;
	
	If ValueIsFilled(ListLine.TableName)
	   And HasDataProcessor Then
	
		QueryText =
		"SELECT
		|	COUNT(AccessKeys.Ref) AS Count
		|FROM
		|	Catalog.AccessKeys AS AccessKeys
		|WHERE
		|	AccessKeys.List = &List
		|	AND AccessKeys.ForExternalUsers = FALSE";
		
		ParameterName = "KeysList" + Format(IndexOf, "NG=");
		QueryText = StrReplace(QueryText, "&List", "&" + ParameterName);
		QueryDetails.Query.SetParameter(ParameterName, ListLine.List);
		
		If ForExternalUsers Then
			QueryText = StrReplace(QueryText, "FALSE", "TRUE");
		EndIf;
	Else
		QueryText =
		"SELECT
		|	0 AS Count";
	EndIf;
	
	QueryDetails.QueryPackageTexts.Add(QueryText);
	IndexOf = IndexOf + 1;
	
EndProcedure

Procedure AddQueryTextOfRemainingAccessKeysCount(QueryDetails, ListLine, IndexOf,
			Context, ForExternalUsers)
	
	ListProperties = Context.StoredData.ListsProperties.Get(ListLine.List);
	HasDataProcessor  = Not ForExternalUsers And ListProperties.ProcessingOfAccessKeys.ForUsers
	                Or ForExternalUsers And ListProperties.ProcessingOfAccessKeys.ForExternalUsers;
	
	If Not ValueIsFilled(ListLine.TableName)
	 Or Not HasDataProcessor Then
		
		JobParameters = Undefined;
		
	ElsIf ForExternalUsers Then
		JobParameters = ListProperties.LastUpdatedAccessKeyForExtrenalUsers;
	Else
		JobParameters = ListProperties.LastUpdatedAccessKey;
	EndIf;
	
	If TypeOf(JobParameters) <> Type("ValueStorage") Then
		QueryText =
		"SELECT
		|	UNDEFINED AS Count";
	Else
		AccessKeysCountShares = New Structure("Processed2, Left1", 0, 1);
		JobParameters = JobParameters.Get();
		
		If TypeOf(JobParameters) = Type("Structure")
		   And JobParameters.Property("LastUpdatedItem")
		   And TypeOf(JobParameters.LastUpdatedItem) = Type("Structure")
		   And JobParameters.LastUpdatedItem.Property("DataKeyKind")
		   And DataKeyKindOrder(JobParameters.LastUpdatedItem.DataKeyKind) <> Undefined
		   And JobParameters.LastUpdatedItem.Property("DataKey") Then
			
			LastAccessKey = JobParameters.LastUpdatedItem.DataKey;
			FillAccessKeysCountShares(AccessKeysCountShares,
				JobParameters.LastUpdatedItem);
		EndIf;
		FilterCriterion = "";
		If TypeOf(LastAccessKey) = Type("CatalogRef.AccessKeys") Then
			ParameterName = "ProcessedKeysList" + Format(IndexOf, "NG=");
			FilterCriterion = "AccessKeys.List = &" + ParameterName;
			QueryDetails.Query.SetParameter(ParameterName, ListLine.List);
			
			FilterCriterion = FilterCriterion + "
			|	AND AccessKeys.ForExternalUsers = " + ?(ForExternalUsers, "TRUE", "FALSE"); // @query-part-1
			
			ParameterName = "LastAccessKey" + Format(IndexOf, "NG=");
			FilterCriterion = FilterCriterion + "
			|	AND AccessKeys.Ref > &" + ParameterName; // @query-part-1
			QueryDetails.Query.SetParameter(ParameterName, LastAccessKey);
		EndIf;
		
		If ValueIsFilled(FilterCriterion) Then
			QueryText =
			"SELECT
			|	COUNT(*) AS Count
			|FROM
			|	Catalog.AccessKeys AS AccessKeys
			|WHERE
			|	&FilterCriterion";
			QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
		Else
			QueryText =
			"SELECT
			|	-1 AS Count";
		EndIf;
		
		If ForExternalUsers Then
			ListLine.ProcessedExternalUsersAccessKeysShare = AccessKeysCountShares.Processed2;
			ListLine.LeftExternalUsersAccessKeysShare   = AccessKeysCountShares.Left1;
		Else
			ListLine.ProcessedUsersAccessKeysShare = AccessKeysCountShares.Processed2;
			ListLine.LeftUsersAccessKeysShare   = AccessKeysCountShares.Left1;
		EndIf;
	EndIf;
	
	QueryDetails.QueryPackageTexts.Add(QueryText);
	IndexOf = IndexOf + 1;
	
EndProcedure

// For the procedure, add a text asking for the number of keys that are available.
Procedure FillAccessKeysCountShares(AccessKeysCountShares, Item)
	
	If Item.DataKeyKind = "ItemsWithObsoleteRights" Then
		AccessKeysCountShares.Processed2 = 0.0;
		AccessKeysCountShares.Left1   = 0.9;
	Else // ObsoleteItems.
		AccessKeysCountShares.Processed2 = 0.9;
		AccessKeysCountShares.Left1   = 0.1;
	EndIf;
	
EndProcedure

// Parameters:
//  ActiveParameters - See ActiveAccessRestrictionParameters
//  AddService - Boolean
//
// Returns:
//  Map of KeyAndValue:
//   * Key - CatalogRef.MetadataObjectIDs
//          - CatalogRef.ExtensionObjectIDs
//   * 
//      ** Table Name - String
//      ** Available Key Access - See AvailabilityOfTableAccessKeys
//      ** The version of the restriction is a string
//
Function ListsWithAccessKeys(ActiveParameters = Undefined, AddService = False) Export
	
	ActiveParameters = ActiveAccessRestrictionParameters(Undefined, Undefined, False);
	
	AvailabilityOfKeysByTables = New Map;
	ListsRestrictionsVersions = New Map(ActiveParameters.ListsRestrictionsVersions);
	
	Tables = New Array;
	For Each VersionDetails In ListsRestrictionsVersions Do
		AvailabilityOfAccessKeys = AvailabilityOfTableAccessKeys(VersionDetails.Key, ActiveParameters);
		If Not AvailabilityOfAccessKeys.ForUsers
		   And Not AvailabilityOfAccessKeys.ForExternalUsers Then
			Continue;
		EndIf;
		AvailabilityOfKeysByTables.Insert(VersionDetails.Key, AvailabilityOfAccessKeys);
		Tables.Add(VersionDetails.Key);
	EndDo;
	
	If AddService Then
		TableName = "Catalog.SetsOfAccessGroups";
		Tables.Add(TableName);
		ListsRestrictionsVersions.Insert(TableName, True);
		AvailabilityOfKeysByTables.Insert(TableName,
			New Structure("ForUsers, ForExternalUsers", True, False));
		
		TableName = "InformationRegister.AccessRestrictionParameters";
		Tables.Add(TableName);
		ListsRestrictionsVersions.Insert(TableName, True);
		AvailabilityOfKeysByTables.Insert(TableName,
			New Structure("ForUsers, ForExternalUsers", True, False));
	EndIf;
	
	ListsWithAccessKeys = New Map;
	ListsIDs = Common.MetadataObjectIDs(Tables, False);
	
	For Each KeyAndValue In ListsIDs Do
		TableName = KeyAndValue.Key;
		Properties = New Structure;
		Properties.Insert("TableName", TableName);
		Properties.Insert("AvailabilityOfAccessKeys", AvailabilityOfKeysByTables.Get(TableName));
		Properties.Insert("VersionOfRestriction", ListsRestrictionsVersions.Get(TableName));
		ListsWithAccessKeys.Insert(KeyAndValue.Value, Properties);
	EndDo;
	
	Return ListsWithAccessKeys;
	
EndFunction

Function CurrentDateAtServer() Export
	
	// ACC:143-off - No.643.2.1. "CurrentDate" is required instead of "CurrentSessionDate"
	// as the current date is used for logging.
	Return CurrentDate();
	// ACC:143-on
	
EndFunction

