				           |pl = 'Typ grup wartości ""%1"" już jest określony dla rodzaju dostępu ""%2"".
				           |Dla rodzaju dostępu""%3"" nie można go określić.';
				           |tr = '""%2"" türü, ""
				           |"" erişim türü için değer türü olarak belirlendi. %1 Erişim türü için ""%3"" belirtilemez.'");
		EndIf;
	Else
		If IntersectionCheck Then
			ErrorDescription =
				NStr("vi = 'Kiểu ""%1"" được chỉ định làm kiểu nhóm giá trị cho loại truy cập ""%2"".
				           |Đối với dạng truy cập ""%3"" nó không thể chỉ định là kiểu giá trị.';
				           |ru = 'Тип ""%1"" указан, как тип групп значений, для вида доступа ""%2"".
				           |Для вида доступа ""%3"" его нельзя указать, как тип значений.';
				           |en = 'The ""%1"" type is specified as a value group type for the ""%2"" access kind.
				           |It cannot be specified as a value type for the ""%3"" access kind.'; fa = 'The ""%1"" type is specified as a value group type for the ""%2"" access kind.
				           |It cannot be specified as a value type for the ""%3"" access kind.';
				           |it = 'Il tipo ""%1"" è indicato come tipo del gruppo di valori peri l tipo di accesso ""%2""
				           |Per il tipo di accesso ""%3"" non lo si può indicare come tipo dei valori.';
				           |pl = 'Typ ""%1"" określono, jako rodzaj grup wartości, rodzaju dostępu ""%2"".
