// Generates a full text of errors in access restriction description with an addition
// that can be specified as a text to call an exception.
//
// Parameters:
//  FullName               - String    - a full name of a list table.
//  ErrorsDescription          - Structure - a value returned by the RestrictionStructure function.
//  ForExternalUsers - Boolean    - if True is passed, an error text will contain
//                                        the restriction purpose for external users.
//
// Returns:
//  String - a text to call an exception.
//
Function ErrorsTextToCallException(FullName, ErrorsDescription, ForExternalUsers, InManagerModule)
	
	If Not ErrorsDescription.HasErrors Then
		Return "";
	EndIf;
	
	If ErrorsDescription.Errors.Count() = 1 Then
		Refinement = "";
		If InManagerModule = Undefined Then
			If ForExternalUsers Then
				ErrorTitle = 
					NStr("vi = 'Lỗi trong hạn chế truy cập người sử dụng ngoài đến danh sách ""%1"":';
						|ru = 'Ошибка в ограничении доступа внешних пользователей к списку ""%1"":';
						|en = 'Error in restriction of external user access to the ""%1"" list:'; fa = 'Error in restriction of external user access to the ""%1"" list:';
						|it = 'Errore nel limite di accesso degli utenti esterni all''elenco ""%1"":';
						|pl = 'Błąd w ograniczeniu dostępu użytkowników zewnętrznych do listy ""%1"":';
						|tr = '""%1"" listesine harici kullanıcı erişiminin kısıtlanmasında hata oluştu:'");
			Else
				ErrorTitle = 
					NStr("vi = 'Lỗi trong hạn chế truy cập người sử dụng đến danh sách ""%1"":';
						|ru = 'Ошибка в ограничении доступа пользователей к списку ""%1"":';
						|en = 'Error in restriction of user access to the ""%1"" list:'; fa = 'Error in restriction of user access to the ""%1"" list:';
						|it = 'Errore nel limite di accesso degli utenti all''elenco ""%1"":';
						|pl = 'Błąd w ograniczeniu dostępu użytkowników do listy ""%1"":';
						|tr = '""%1"" listesine kullanıcı erişiminin kısıtlanmasında hata oluştu:'");
			EndIf;
		ElsIf InManagerModule Then
			If ForExternalUsers Then
				ErrorTitle =
					NStr("vi = 'Lỗi khi hạn chế quyền truy cập của người sử dụng ngoài đến danh sách ""%1"",
					           |được chỉ định trong thủ tục %2 của mô-đun quản lý đối tượng metadata:';
					           |ru = 'Ошибка в ограничении доступа внешних пользователей к списку ""%1"",
					           |указанному в процедуре %2 модуля менеджера объекта метаданных:';
					           |en = 'Error in restriction of external user access to the ""%1"" list
					           |specified in procedure ""%2"" of the metadata object manager module:'; fa = 'Error in restriction of external user access to the ""%1"" list
					           |specified in procedure ""%2"" of the metadata object manager module:';
					           |it = 'Errore nel limite di accesso degli utenti esterni all''elenco ""%1"",
					           |indicato nella procedura %2del modulo del manager dell''oggetto di metadati:';
					           |pl = 'Błąd w ograniczeniu dostępu użytkowników zewnętrznych do listy ""%1"",
					           |określonej w procedurze %2 modułu menadżera obiektu metadanych:';
					           |tr = 'Metaveri nesne yönetici modülünün %2 prosedüründe 
					           |belirtilen ""%1"" listesine harici kullanıcıların erişimi kısıtlanırken bir hata oluştu:'");
