#Region Parsing

// For the ParsedRestriction function.
//
// Parameters:
//   InternalData - See NewInternalData
//
// Returns:
//   Structure:
//     * AdditionalTables    - Array of See NewConnectionDetails
//     * MainTableAlias - String
//     * ReadRestriction        - Structure
//     * UpdateRestriction     - Structure
//
Function RestrictionParts(InternalData)
	
	RestrictionParts = New Structure;
	RestrictionParts.Insert("AdditionalTables",    New Array);
	RestrictionParts.Insert("MainTableAlias", "");
	RestrictionParts.Insert("ReadRestriction",        New Structure);
	RestrictionParts.Insert("UpdateRestriction",     New Structure);
	
	CharsetsTable = InternalData.CharsetsTable;
	
	If CharsetsTable.Count() = 0 Then
		Return RestrictionParts;
	EndIf;
	
	CharsetsTable.Columns.Add("Rows", New TypeDescription("Array"));
	CharsetsTable.Columns.Add("EndString");
	
	// Separating a restriction into main parts.
	Rows = CharsetsTable.FindRows(New Structure("Chars, Kind", ";", "Separator"));
	
	SeparatorRowsIndexes = New Array;
	For Each String In Rows Do
		SeparatorRowsIndexes.Add(CharsetsTable.IndexOf(String));
	EndDo;
	SeparatorRowsIndexes.Add(CharsetsTable.Count() - 1);
	
	PartsProperties = New Array; // Array of See NewPartProperties
	RowIndex = 0;
	For Each SeparatorRowIndex In SeparatorRowsIndexes Do
		PartRows = New Array; // Array of ValueTableRow: See CharsetsTable
		While RowIndex < SeparatorRowIndex Do
			PartRow = CharsetsTable[RowIndex];
			If PartRow.Kind <> "InvalidChar" Then
				PartRows.Add(PartRow);
			EndIf;
			RowIndex = RowIndex + 1;
		EndDo;
		SeparatorRow = CharsetsTable[SeparatorRowIndex];
		If PartRows.Count() = 0 Then
			PartRows.Add(SeparatorRow);
		EndIf;
		PartProperties = NewPartProperties();
		PartProperties.Insert("Rows", PartRows);
		PartProperties.Insert("SeparatorRow", SeparatorRow);
		PartsProperties.Add(PartProperties);
		TheFirstLineOfThePart = PartRows[0];
		If TheFirstLineOfThePart.Kind = "Keyword"
		   And TheFirstLineOfThePart.Type = "Begin" Then
			
			PartProperties.Insert("Name",           TheFirstLineOfThePart.Refinement);
			PartProperties.Insert("Presentation", TheFirstLineOfThePart.Chars);
			
			ParseRestrictionPart(PartProperties, InternalData);
		Else
			PartProperties.Insert("Name",           "");
			PartProperties.Insert("Presentation", "");
		EndIf;
		RowIndex = SeparatorRowIndex + 1;
	EndDo;
	
	AddDefaultAliases(InternalData);
	
	// Part 1 analysis.
	PartProperties1 = PartsProperties[0];
	
	If PartProperties1.Name = "" Then
		SetPartBeginningError(PartProperties1, InsertKeywordsIntoString(InternalData,
			NStr("vi = 'Không có từ khóa nào ở đầu phần đầu tiên của nội dung hạn chế
			           |""%1"", ""%2"", ""%3""';
			           |ru = 'В начале первой части текста ограничения нет ни одного из ключевых слов
			           |""%1"", ""%2"", ""%3""';
			           |en = 'None of the following keywords are found at the beginning of the first part of the restriction text:
			           |""%1"", ""%2"", or ""%3"".'; fa = 'None of the following keywords are found at the beginning of the first part of the restriction text:
			           |""%1"", ""%2"", or ""%3"".';
			           |it = 'All''inizio della prima parte del testo di limitazione non vi è nessuna parole chiave 
			           |""%1"", ""%2"", ""%3""';
			           |pl = 'W początku pierwszej części tekstu nie ma ograniczenia żadnego ze słów kluczowych
			           |""%1"", ""%2"", ""%3""';
			           |tr = 'Kısıtlama metnin ilk bölümünde anahtar kelimelerin hiçbiri bulunamadı 
			           |""%1"", ""%2"", ""%3""'"),
			"AllowReadUpdate,AllowRead,AttachAdditionalTables"));
		Return RestrictionParts;
		
	ElsIf PartProperties1.Name = "AllowUpdateIfReadingAllowed" Then
		SetPartBeginningError(PartProperties1,
			NStr("vi = 'Ở đầu phần thứ nhất của nội dụng hạn chế, đã tìm thấy từ khóa không hợp lệ';
				|ru = 'В начале первой части текста ограничения найдено недопустимое ключевое слово';
				|en = 'Invalid keyword at the beginning of the first part of the restriction text.'; fa = 'Invalid keyword at the beginning of the first part of the restriction text.';
				|it = 'Nell''inizio della prima parte del testo di limite è stata trovata una parola chiave non permessa';
				|pl = 'Na początku pierwszej części tekstu ograniczenia znaleziono nieprawidłowe słowo kluczowe';
				|tr = 'Kısıtlama metnin ilk kısmının başında izin verilmeyen anahtar kelime bulundu'"));
		Return RestrictionParts;
		
	ElsIf PartsProperties.Count() = 1
	        And (    PartProperties1.Name = "AttachAdditionalTables"
	           Or PartProperties1.Name = "AllowRead" ) Then
		
		SetPartBeginningError(CharsetsTable,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Nội dung hạn chế không thể chỉ từ một phần
				           |với từ khóa ""%1""';
				           |ru = 'Текст ограничения не может быть только из одной части
				           |с ключевым словом ""%1""';
				           |en = 'A restriction text cannot have a single part
				           |with the ""%1"" keyword.'; fa = 'A restriction text cannot have a single part
				           |with the ""%1"" keyword.';
				           |it = 'Il testo di limite non può essere fatto solo di una parte
				           |con la parola chiave ""%1""';
				           |pl = 'Tekst ograniczenia nie może składać się tylko z jednej części
				           |ze słowem kluczowym ""%1""';
				           |tr = 'Kısıtlama metni, ""
				           |"" anahtar kelime ile tek bölümden %1 oluşmaz'"), PartProperties1.Presentation));
		Return RestrictionParts;
	EndIf;
	
	SetRestrictionPart(RestrictionParts, PartProperties1);
	
	If PartsProperties.Count() < 2 Then
		Return RestrictionParts;
	EndIf;
	
	// Part 2 analysis.
	PartProperties2 = PartsProperties[1];
	
	If PartProperties1.Name = "AllowReadUpdate" Then
		SetPartBeginningError(PartProperties1.SeparatorRow,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Không cần phần thứ hai của nội dung hạn chế, khi
				           |trong phần đầu đã chỉ ra từ khóa ""%1""';
				           |ru = 'Второй части текста ограничения не должно быть, когда
				           |в первой части указано ключевое слово ""%1""';
				           |en = 'A restriction text with the ""%1"" keyword in the first part
				           |cannot contain the second part.'; fa = 'A restriction text with the ""%1"" keyword in the first part
				           |cannot contain the second part.';
				           |it = 'Non deve esserci la seconda parte del testo di limite quando
				           |nella prima parte è indicata la parola chiave ""%1""';
				           |pl = 'Drugiej części tekstu ograniczenia nie powinno być, gdy
				           |w pierwszej części podane słowo kluczowe ""%1""';
				           |tr = '""%1"" anahtar kelimesi ilk bölümde belirtildiğinde
				           |kısıtlama metninin ikinci kısmı olmamalıdır'"), PartProperties1.Presentation));
		Return RestrictionParts;
	EndIf;
	
	If PartProperties2.Name = "" Then
		If PartProperties1.Name = "AllowRead" Then
			SetPartBeginningError(PartProperties2, InsertKeywordsIntoString(InternalData,
				NStr("vi = 'Ở đầu phần thứ hai của nội dung hạn chế không có
				           |từ khóa ""%1""';
				           |ru = 'В начале второй части текста ограничения нет
				           |ключевого слова ""%1""';
				           |en = 'Keyword ""%1"" is not found
				           |at the beginning of the second part of the restriction text.'; fa = 'Keyword ""%1"" is not found
				           |at the beginning of the second part of the restriction text.';
				           |it = 'All''inizio della seconda parte del testo di limitazione non 
				           |vi è la parola chiave ""%1""';
				           |pl = 'W początku drugiej części tekstu ograniczenia nie ma
				           |kluczowego słowa ""%1""';
				           |tr = 'Kısıtlama metninin ikinci bölümünün başında ""%1"" anahtar kelimesi 
				           |yok'"),
				"AllowUpdateIfReadingAllowed"));
		Else // Part1Properties.Name = "AttachAdditionalTables".
			SetPartBeginningError(PartProperties2, InsertKeywordsIntoString(InternalData,
				NStr("vi = 'Ở đầu phần thứ hai của nội dung hạn chế không có một trong các từ khóa sau
				           |""%1"", ""%2""';
				           |ru = 'В начале второй части текста ограничения нет ни одного из ключевых слов
				           |""%1"", ""%2""';
				           |en = 'Neither ""%1"" nor ""%2""
				           |keywords are found at the beginning of the second part of the restriction text.'; fa = 'Neither ""%1"" nor ""%2""
				           |keywords are found at the beginning of the second part of the restriction text.';
				           |it = 'Allinizio della seconda parte del testo di limitazione non vi è alcuna parola chiave 
				           |""%1"", ""%2""';
				           |pl = 'W początku drugiej części tekstu nie ma ograniczenia żadnego ze słów kluczowych
				           |""%1"", ""%2""';
				           |tr = 'Kısıtlama metnin ilk bölümünde anahtar kelimelerin hiçbiri bulunamadı
				           |""%1"", ""%2""'"),
				"AllowReadUpdate,AllowRead"));
		EndIf;
		Return RestrictionParts;
		
	ElsIf PartProperties1.Name = "AllowRead"
	        And PartProperties2.Name <> "AllowUpdateIfReadingAllowed"
	      Or PartProperties1.Name = "AttachAdditionalTables"
	        And PartProperties2.Name <> "AllowReadUpdate"
	        And PartProperties2.Name <> "AllowRead" Then
		
		SetPartBeginningError(PartProperties2,
			NStr("vi = 'Ở đầu phần thứ hai nội dung hạn chế, đã tìm thấy từ khóa không hợp lệ';
				|ru = 'В начале второй части текста ограничения найдено недопустимое ключевое слово';
				|en = 'Invalid keyword at the beginning of the second part of the restriction text.'; fa = 'Invalid keyword at the beginning of the second part of the restriction text.';
				|it = 'Nell''inizio della seconda parte del testo di limite è stata trovata una parola chiave non permessa';
				|pl = 'Na początku drugiej części tekstu ograniczenia znaleziono nieprawidłowe słowo kluczowe';
				|tr = 'Kısıtlama metnin ikinci kısmının başında izin verilmeyen anahtar kelime bulundu'"));
		Return RestrictionParts;
		
	ElsIf PartsProperties.Count() = 2
	        And PartProperties2.Name = "AllowRead" Then
		
		SetPartBeginningError(CharsetsTable,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Nội dung hạn chế không thể chỉ có hai phần khi
				           |trong phần thứ hai đã chỉ ra từ khóa ""%1""';
				           |ru = 'Текст ограничения не может быть только из двух частей, когда
				           |во второй части указано ключевое слово ""%1""';
				           |en = 'The restriction text cannot contain only two parts when
				           |the ""%1"" keyword is present in the second part.'; fa = 'The restriction text cannot contain only two parts when
				           |the ""%1"" keyword is present in the second part.';
				           |it = 'Il testo di limite non può essere solo di due parti quando
				           |nella seconda parte è indicata la parola chiave ""%1""';
				           |pl = 'Tekst ograniczenia nie może być tylko z dwóch części, gdy
				           |w drugiej części wskazano słowo kluczowe ""%1""';
				           |tr = '""%1"" anahtar kelimesi ikinci kısımda belirtildiğinde
				           |kısıtlama metni sadece iki kısımdan oluşamaz'"), PartProperties2.Presentation));
		Return RestrictionParts;
	EndIf;
	
	SetRestrictionPart(RestrictionParts, PartProperties2);
	
	If PartsProperties.Count() < 3 Then
		Return RestrictionParts;
	EndIf;
	
	// Part 3 analysis.
	PartProperties3 = PartsProperties[2];
	
	If PartProperties2.Name = "AllowReadUpdate" Then
		SetPartBeginningError(PartProperties2.SeparatorRow,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Không cần phần thứ ba của nội dung hạn chế khi 
				           |trong phần thứ hai đã chỉ ra từ khóa ""%1""';
				           |ru = 'Третьей части текста ограничения не должно быть, когда
				           |во второй части указано ключевое слово ""%1""';
				           |en = 'A restriction text with the ""%1"" keyword in the second part
				           |cannot contain the third part.'; fa = 'A restriction text with the ""%1"" keyword in the second part
				           |cannot contain the third part.';
				           |it = 'Non deve esserci la terza parte del testo di limite quando
				           |nella seconda parte è indicata la parola chiave ""%1""';
				           |pl = 'Trzeciej części tekstu ograniczenia nie powinno być, gdy
				           |w drugiej części wskazano słowo kluczowe ""%1""';
				           |tr = 'Kısıtlama metninin üçüncü kısmı, %1ikinci bölümde ""
				           |"" bir anahtar kelime belirtildiğinde olmamalıdır'"), PartProperties2.Presentation));
		Return RestrictionParts;
	EndIf;
	
	If PartProperties3.Name = "" Then
		SetPartBeginningError(PartProperties3, InsertKeywordsIntoString(InternalData,
			NStr("vi = 'Ở đầu phần thứ ba của nội dung hạn chế không có
			           |từ khóa ""%1""';
			           |ru = 'В начале третьей части текста ограничения нет
			           |ключевого слово ""%1""';
			           |en = 'Keyword ""%1"" is not found
			           |at the beginning of the third part of the restriction text.'; fa = 'Keyword ""%1"" is not found
			           |at the beginning of the third part of the restriction text.';
			           |it = 'All''inizio della terza parte del testo di limitazione non vi è
			           | la parola chiave ""%1""';
			           |pl = 'W początku trzeciej części tekstu ograniczenia nie ma
			           |kluczowego słowa ""%1""';
			           |tr = 'Kısıtlama metninin üçüncü bölümünün başında ""%1"" anahtar kelimesi 
			           |yok'"),
			"AllowUpdateIfReadingAllowed"));
		Return RestrictionParts;
		
	ElsIf PartProperties2.Name = "AllowRead"
	        And PartProperties3.Name <> "AllowUpdateIfReadingAllowed" Then
		
		SetPartBeginningError(PartProperties3,
			NStr("vi = 'Ở đầu phần thứ ba nội dung hạn chế, đã tìm thấy từ khóa không hợp lệ';
				|ru = 'В начале третьей части текста ограничения найдено недопустимое ключевое слово';
				|en = 'Invalid keyword at the beginning of the third part of the restriction text.'; fa = 'Invalid keyword at the beginning of the third part of the restriction text.';
				|it = 'Nell''inizio della terza parte del testo di limite è stata trovata una parola chiave non permessa';
				|pl = 'Na początku trzeciej części tekstu ograniczenia znaleziono nieprawidłowe słowo kluczowe';
				|tr = 'Kısıtlama metnin üçüncü kısmının başında izin verilmeyen anahtar kelime bulundu'"));
		Return RestrictionParts;
	EndIf;
	
	SetRestrictionPart(RestrictionParts, PartProperties3);
	
	Return RestrictionParts;
	
EndFunction

// Procedure:
//  Parent - ValueTableRow from See CharsetsTable
//           - Structure
//  String - ValueTableRow from See CharsetsTable
//  Context - Structure:
//              * Table - See CharsetsTable
//
Procedure RowAdd(Parent, String, Context)
	
	If TypeOf(String) = Type("ValueTableRow") Then
		Parent.Rows.Add(Context.CharsetsTable.IndexOf(String));
	Else
		Parent.Rows.Add(String);
	EndIf;
	
EndProcedure

// Parameters:
//  RowDescription - Number - Value table index.
//                 - ValueTableRow of See CharsetsTable
//                 - Structure - See AdditionalString1
//  Context - Structure:
//              * Table - See CharsetsTable
//
// Returns:
//   See AdditionalString1
//
Function TableRow(RowDescription, Context)
	
	If TypeOf(RowDescription) = Type("Number") Then
		String = Context.CharsetsTable[RowDescription];
	Else
		String = RowDescription;
	EndIf;
	
	Return String;
	
EndFunction

