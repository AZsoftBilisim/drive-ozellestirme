				           |pl = 'Typ wartości dostępu ""%1"" rodzaju dostępu ""%2""
				           |nie znajduje się w określonym typie %3.';
				           |tr = '%3 tanımlanmış türünde ""%2""
				           | erişim türü erişim değeri ""%1"" türü belirtilmemiş.'");
		EndIf;
	EndIf;
	
	If ValueIsFilled(ErrorDescription) Then
		ErrorText = Parameters.ErrorTitle + StringFunctionsClientServer.SubstituteParametersToString(
			ErrorDescription, Type, AccessKind.Name, "AccessValue");
		Raise ErrorText;
	EndIf;
	
EndProcedure

// Returns:
