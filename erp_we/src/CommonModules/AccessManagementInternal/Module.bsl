	If ParametersContent.Count() > 1 Then
		SetErrorInRow(FirstParameter.EndString, StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Trong hàm ""%1"" chỉ coó thể có một tham số';
