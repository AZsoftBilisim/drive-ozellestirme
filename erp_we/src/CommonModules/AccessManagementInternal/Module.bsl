				           |ru = 'Тип ""%1"" указан, как тип значений, для вида доступа ""%2"".
				           |Однако это не тип ссылки.';
				           |en = 'The ""%1"" type is specified as a value type for the ""%2"" access kind.
				           |However, it is not a reference type.'; fa = 'The ""%1"" type is specified as a value type for the ""%2"" access kind.
				           |However, it is not a reference type.';
				           |it = 'Il tipo ""%1"" è indicato come tipo dei valori per il tipo di accesso ""%2"".
				           |Però non è un tipo di link.';
				           |pl = 'Typ ""%1"" określono jako typ wartości, rodzaju dostępu ""%2"".
