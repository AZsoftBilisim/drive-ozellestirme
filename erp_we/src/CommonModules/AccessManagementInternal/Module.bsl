				           |"" erişim türü için değer türü olarak belirlendi. %1 Erişim türü için ""%3"" değer tipi olarak belirtilemez.'");
		Else
			ErrorDescription =
				NStr("vi = 'Kiểu giá trị ""%1"" đã chỉ định cho dạng truy cập ""%2"".
				           |Đối với dạng truy cập ""%3"" nó không thể chỉ định.';
				           |ru = 'Тип значений ""%1"" уже указан для вида доступа ""%2"".
				           |Для вида доступа ""%3"" его нельзя указать.';
				           |en = 'The ""%1"" value type is already specified for the ""%2"" access kind.
				           |It cannot be specified for the ""%3"" access kind.'; fa = 'The ""%1"" value type is already specified for the ""%2"" access kind.
				           |It cannot be specified for the ""%3"" access kind.';
				           |it = 'Il tipo dei valori ""%1"" è già indicato per la il tipo di accesso ""%2"".
				           |Per il tipo di accesso ""%3"" non lo si può indicare.';
				           |pl = 'Typ wartości ""%1"" już jest określony dla rodzaju dostępu ""%2"".
				           |Dla rodzaju dostępu""%3"" nie można go określić.';
				           |tr = '""%2"" türü, ""
				           |"" erişim türü için değer türü olarak belirlendi. %1 Erişim türü için ""%3"" belirtilemez.'");
		EndIf;
	EndIf;
	
	If AllTypes.Get(Type) <> Undefined Then
		If Not (ForSameAccessKindNoError And AccessKind.Name = AllTypes.Get(Type)) Then
			ErrorText = Parameters.ErrorTitle + StringFunctionsClientServer.SubstituteParametersToString(
				ErrorDescription, Type, AllTypes.Get(Type), AccessKind.Name);
			Raise ErrorText;
		EndIf;
	ElsIf Not IntersectionCheck Then
		AllTypes.Insert(Type, AccessKind.Name);
	EndIf;
	
	// Check the content of type collections.
	ErrorDescription = "";
	If Parameters.DefinedAccessValuesTypes.Get(Type) = Undefined Then
		If CheckGroupsTypes Then
			ErrorDescription =
				NStr("vi = 'Chưa chỉ ra kiểu nhóm giá trị truy cập ""%1"" của dạng truy cập ""%2""
