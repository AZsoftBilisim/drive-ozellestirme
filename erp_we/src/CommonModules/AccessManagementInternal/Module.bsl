// See SSLSubsystemsIntegration.OnCreateAdministrator.
Procedure OnCreateOrAuthorizeAdministrator(Administrator, Refinement) Export
	
	If TypeOf(Administrator) <> Type("CatalogRef.Users") Then
		Return;
	EndIf;
	
	Query = New Query;
	Query.SetParameter("User", Administrator);
	Query.SetParameter("AdministratorsAccessGroup",
		AccessManagement.AdministratorsAccessGroup());
	Query.Text =
	"SELECT
	|	TRUE AS TrueValue
	|FROM
	|	Catalog.AccessGroups.Users AS AccessGroups_Users
	|WHERE
	|	AccessGroups_Users.Ref = &AdministratorsAccessGroup
	|	AND AccessGroups_Users.User = &User
	|
	|UNION ALL
	|
	|SELECT
	|	TRUE
	|FROM
	|	Catalog.Users AS Users
	|WHERE
	|	Users.IsInternal
	|	AND Users.Ref = &User";
	
	If Not Query.Execute().IsEmpty() Then
		Return;
	EndIf;
	
	CommentForLog = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Người sử dụng ""%1"" đã được thêm vào nhóm truy cập Quản trị do:
		           |%2';
		           |ru = 'Пользователь ""%1"" добавлен в группу доступа Администраторы по причине:
		           |%2';
		           |en = 'User ""%1"" was added to the Administrators access group due to:
		           |%2'; fa = 'User ""%1"" was added to the Administrators access group due to:
		           |%2';
		           |it = 'L''utente ""%1"" è stato aggiunto al gruppo di accesso Amministratori a causa di:
		           |%2';
		           |pl = 'Użytkownik ""%1"" dodany do grupy dostępu Administratorzy, z powodu:
		           |%2';
		           |tr = 'Kullanıcı ""%1"" aşağıdaki nedenle Yöneticiler erişim grubuna eklendi: 
		           |%2'"),
		Administrator,
		Refinement);
	
	AdministratorsAccessGroup = AccessManagement.AdministratorsAccessGroup();
	
	Block = New DataLock;
	LockItem = Block.Add("Catalog.AccessGroups");
	LockItem.SetValue("Ref", AdministratorsAccessGroup);
	
	BeginTransaction();
	Try
		Block.Lock();
		Object = AdministratorsAccessGroup.GetObject();
		LockDataForEdit(Object.Ref, Object.DataVersion);
		If Object.Users.Find(Administrator, "User") = Undefined Then
			Object.Users.Add().User = Administrator;
			InfobaseUpdate.WriteData(Object);
			WriteLogEvent(
				NStr("vi = 'Quản lý truy cập.Tự động thay đổi nhóm truy cập Quản trị';
					|ru = 'Управление доступом.Автоматическое изменение группы доступа Администраторы';
					|en = 'Access management.Administrators access group was updated automatically'; fa = 'Access management.Administrators access group was updated automatically';
					|it = 'Gestione degli accessi.Modifica automatica del gruppo di accesso Amministratori';
					|pl = 'Kontrola dostępu.Automatyczna zmiana grupy dostępu Administratorzy';
					|tr = 'Erişim kontrolü. Yöneticiler erişim grubunun otomatik değişmesi'",
				     Common.DefaultLanguageCode()),
				EventLogLevel.Information,
				Metadata.Catalogs.Users,
				Administrator,
				CommentForLog,
				EventLogEntryTransactionMode.Transactional);
		EndIf;
		UnlockDataForEdit(Object.Ref);
		
		CommitTransaction();
	Except
		RollbackTransaction();
		Raise;
	EndTry;
	
EndProcedure

