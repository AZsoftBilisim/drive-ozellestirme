//   Structure:
//     * IsReferenceType - Boolean
//     * HeaderFields       - See LeadingListFieldsDetails
//     * TabularSections  - Array of See LeadingListFieldsDetails
//
Function LeadingListByFieldsValues()
	
	Return New Structure;
	
