	If ValueIsFilled(Rows) Then
		If SimplifiedAccessRightsSetupInterface() Then
			Explanation = NStr("ru = 'Пользователю информационной базы (ИБ) устанавливаются роли профилей, которые назначены пользователю.';
								|vi = 'Profile roles assigned to the user are applied to the infobase user.';
								|en = 'Profile roles assigned to the user are applied to the infobase user.'; fa = 'Profile roles assigned to the user are applied to the infobase user.';
								|it = 'Profile roles assigned to the user are applied to the infobase user.';
								|pl = 'Profile roles assigned to the user are applied to the infobase user.';
								|tr = 'Infobase kullanıcısına, kullanıcıya atanan profillerin rolleri verilir.'");
		Else
			Explanation = NStr("ru = 'Пользователю информационной базы (ИБ) устанавливаются роли профилей тех групп доступа, в которые включен пользователь.';
								|vi = 'The infobase user is assigned profile roles from the access groups the user is a member of.';
								|en = 'The infobase user is assigned profile roles from the access groups the user is a member of.'; fa = 'The infobase user is assigned profile roles from the access groups the user is a member of.';
								|it = 'The infobase user is assigned profile roles from the access groups the user is a member of.';
								|pl = 'The infobase user is assigned profile roles from the access groups the user is a member of.';
								|tr = 'Infobase kullanıcısına, kullanıcının üyesi olduğu erişim gruplarının profillerinin rolleri verilir.'");
		EndIf;
		Supplement =
			NStr("ru = 'Список ролей, полученный из профилей, отличается от ролей у пользователя ИБ.
			           |Обычно это происходит при редактировании ролей пользователя ИБ в списке пользователей в конфигураторе (не рекомендуется).';
			           |vi = 'The roles derived from profiles differ from the infobase user roles.
			           |This typically occurs when infobase user roles are manually modified in the users list in the Configurator (not recommended).';
			           |en = 'The roles derived from profiles differ from the infobase user roles.
			           |This typically occurs when infobase user roles are manually modified in the users list in the Configurator (not recommended).'; fa = 'The roles derived from profiles differ from the infobase user roles.
			           |This typically occurs when infobase user roles are manually modified in the users list in the Configurator (not recommended).';
			           |it = 'The roles derived from profiles differ from the infobase user roles.
			           |This typically occurs when infobase user roles are manually modified in the users list in the Configurator (not recommended).';
			           |pl = 'The roles derived from profiles differ from the infobase user roles.
			           |This typically occurs when infobase user roles are manually modified in the users list in the Configurator (not recommended).';
			           |tr = 'Profillerden elde edilen rol listesi, Infobase kullanıcısının rollerinden farklıdır. 
			           | Bu genellikle yapılandırıcıdaki kullanıcı listesinde Infobase kullanıcısının rollerini düzenlerken ortaya çıkar (önerilmez).'");
		Rows.Insert(0, Explanation + Chars.LF + Supplement);
	EndIf;
	
	Return StrConcat(Rows, Chars.LF + Chars.LF);
	
EndFunction

Function RolesPresentationFromDescription(RolesDetails)
	
	Result = New Array;
	
	For Each KeyAndValue In RolesDetails Do
		RoleMetadata = KeyAndValue.Value;
		If TypeOf(RoleMetadata) <> Type("MetadataObject") Then
			RoleMetadata = Metadata.Roles.Find(KeyAndValue.Key);
		EndIf;
		
		RolePresentation = ?(TypeOf(RoleMetadata) = Type("MetadataObject"),
			RoleMetadata.Presentation(), KeyAndValue.Key);
		
		Result.Add(RolePresentation);
	EndDo;
	
	Return Result;
	
EndFunction

// Parameters:
//  User - CatalogRef.Users
//               - CatalogRef.ExternalUsers
//
// Returns:
//  Map of KeyAndValue:
//    * Key - CatalogRef.Users
//           - CatalogRef.ExternalUsers
//    * Value - See RolesNewChange
// 
Function UserRolesChange(User)
	
	If TypeOf(User) <> Type("CatalogRef.Users")
	   And TypeOf(User) <> Type("CatalogRef.ExternalUsers") Then
		Return Undefined;
	EndIf;
	
	UsersRolesChange = New Map;
	
	Try
		UpdateUserRoles(User,, UsersRolesChange);
		ChangeOfRoles = UsersRolesChange.Get(User);
	Except
		ChangeOfRoles = Undefined;
	EndTry;
	
	Return ChangeOfRoles;
	
EndFunction

