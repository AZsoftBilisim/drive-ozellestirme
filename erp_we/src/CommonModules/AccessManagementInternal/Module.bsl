			NStr("vi = 'Quản lý truy cập.Điền dữ liệu để hạn chế truy cập';
				|ru = 'Управление доступом.Заполнение данных для ограничения доступа';
				|en = 'Access management.Populate data for access restriction'; fa = 'Access management.Populate data for access restriction';
				|it = 'Gestione accessi.Compilazione dei dati per limitare l''accesso';
				|pl = 'Kontrola dostępu.Wypełnienie danych w celu ograniczenia dostępu';
				|tr = 'Erişim yönetimi. Erişim kısıtlaması için veri doldurulması'",
			     Common.DefaultLanguageCode()),
			EventLogLevel.Information,
			,
			,
			NStr("vi = 'Bắt đầu điền dữ liệu để hạn chế truy cập.';
				|ru = 'Начато заполнение данных для ограничения доступа.';
				|en = 'Population of access restriction data started.'; fa = 'Population of access restriction data started.';
				|it = 'È cominciata la compilazione dei dati per limitare l''accesso.';
				|pl = 'Rozpoczęto wypełnianie danych w celu ograniczenia dostępu.';
				|tr = 'Erişim kısıtlaması için veri doldurulma işlemi başladı.'"),
			EventLogEntryTransactionMode.Transactional);
		
		SetDataFillingForAccessRestriction(True);
	EndIf;
	
	If LimitAccessAtRecordLevelUniversally(True) Then
		
		ScheduleAccessRestrictionParametersUpdate(
			"OnChangeAccessRestrictionAtRecordLevel");
		
		PlanningParameters = AccessUpdatePlanningParameters();
		PlanningParameters.IsUpdateContinuation = True;
		PlanningParameters.LongDesc = "RestrictAccessAtRecordsLevelOnWrite";
		ScheduleAccessUpdate(, PlanningParameters);
		
		SetAccessUpdate(True);
	EndIf;
	
	UpdateSessionParameters();
	
EndProcedure

