			           |tr = 'Eksik roller:
			           |%1'"),
			StrConcat(RolesForAdding, Chars.LF)));
	EndIf;
	
	RolesForDeletion = RolesPresentationFromDescription(ChangeOfRoles.RolesForDeletion);
