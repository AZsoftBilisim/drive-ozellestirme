// Parameters:
//  DataDetails - See AccessManagement.EditionAllowed.DataDetails
//  RightUpdate - Boolean
//  RaiseException1 - Boolean
//  CheckOldVersionOnly - Boolean
//  User   - CatalogRef.Users
//                 - CatalogRef.ExternalUsers
//                 - Undefined - — to check for the current user.
//
// Returns:
//  Boolean
//
Function AccessAllowed(DataDetails, RightUpdate, RaiseException1 = False,
			CheckOldVersionOnly = False, Val User = Undefined) Export
	
	ForPrivilegedMode = True;
	IBUser = Undefined;
	
	If User <> Undefined
	   And User = Users.AuthorizedUser() Then
		
		User = Undefined;
		ForPrivilegedMode = False;
		IBUser = InfoBaseUsers.CurrentUser();
	EndIf;
	
	If User = Undefined
	   And Users.IsFullUser(,, ForPrivilegedMode) Then
		Return True;
	EndIf;
	
	MetadataObject = Metadata.FindByType(TypeOf(DataDetails));
	If MetadataObject = Undefined Then
		ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Giá trị tham số không hợp lệ %1 trong %2.
			           |Dự kiến là tham chiếu, đối tượng, khóa bản ghi hoặc tập hợp bản ghi.
			           |Đã chuyển giá trị: %3 (kiểu %4).';
			           |ru = 'Недопустимое значение параметра %1 в %2.
			           |Ожидалась ссылка, объект, ключ записи или набор записей.
			           |Передано значение: %3 (тип %4).';
			           |en = 'Invalid value of the %1 parameter in %2.
			           |A reference, object, record key, or record set expected.
			           |Passed value: %3 (type %4).'; fa = 'Invalid value of the %1 parameter in %2.
			           |A reference, object, record key, or record set expected.
			           |Passed value: %3 (type %4).';
			           |it = 'Valore non disponibile del parametro %1 in %2.
			           | Era prevista la presenza di un link, oggetto, chiave di registrazione o set di valori.
			           | Valore trasmesso: %3 (tipo %4).';
			           |pl = 'Niedopuszczalna wartość parametru %1 в %2.
			           |Oczekiwany był odnośnik, klucz wpisu, lub zestaw wpisów.
			           |Przekazano wartość: %3 (typ %4).';
			           |tr = '%2''da kabul edilemez %1 parametre değeri.
			           |Bağlantı, nesne, kaydetme anahtarı veya kayıt seti bekleniyordu.
			           |Aktarılan değer: %3 (tür%4).'"),
			"DataDetails",
			?(RaiseException1,
				?(RightUpdate, "AccessManagement.CheckChangeAllowed",
					"AccessManagement.CheckReadAllowed"),
				?(RightUpdate, "AccessManagement.EditionAllowed",
					"AccessManagement.ReadingAllowed")),
			String(DataDetails),
			String(TypeOf(DataDetails)));
		Raise ErrorText;
	EndIf;
	
	ProductiveOption = AccessManagement.ProductiveOption();
	
	If User <> Undefined Then
		CommonClientServer.CheckParameter(
			?(RaiseException1,
				?(RightUpdate, "AccessManagement.CheckChangeAllowed",
					"AccessManagement.CheckReadAllowed"),
				?(RightUpdate, "AccessManagement.EditionAllowed",
					"AccessManagement.ReadingAllowed")),
				"User",
				User,
				New TypeDescription("CatalogRef.Users, CatalogRef.ExternalUsers"));
		
		If Not ProductiveOption Then
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Giá trị tham số không hợp lệ %1 trong %2.
				           |Trong phiên bản tiêu chuẩn của hạn chế truy cập chỉ hỗ trợ %3.
				           |Giá trị đã chuyển: %4 (kiểu %5).';
				           |ru = 'Недопустимое значение параметра %1 в %2.
				           |В стандартном варианте ограничения доступа поддерживается только %3.
				           |Передано значение: %4 (тип %5).';
				           |en = 'Invalid value of the %1 parameter in %2.
				           |Only %3 is supported in the standard access restriction option.
				           |Value passed: %4 (the %5 type).'; fa = 'Invalid value of the %1 parameter in %2.
				           |Only %3 is supported in the standard access restriction option.
				           |Value passed: %4 (the %5 type).';
				           |it = 'Valore non valido del parametro %1 in %2.
				           |Nella versione standard di limitazione d''accesso si supporta solo %3.
				           |Trasferito valore: %4 (del tipo %5).';
				           |pl = 'Niedopuszczalna wartość parametru %1 w %2.
				           |W standardowym wariancie ograniczenia dostępu jest obsługiwane tylko %3.
				           |Przekazano wartość: %4 (typ %5).';
				           |tr = '%2''da kabul edilemez %1 parametre değeri.
				           |Standart erşim sınırlama seçeneğinde sadece %3 desteklenir.
				           |Aktarılan değer: %4 (tür %5).'"),
				"User",
				?(RaiseException1,
					?(RightUpdate, "AccessManagement.CheckChangeAllowed",
						"AccessManagement.CheckReadAllowed"),
					?(RightUpdate, "AccessManagement.EditionAllowed",
						"AccessManagement.ReadingAllowed")),
				"Undefined",
				String(User),
				String(TypeOf(User)));
			Raise ErrorText;
		EndIf;
		
		If RaiseException1 Then
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Gọi ra ngoại lệ chỉ được hỗ trợ cho người sử dụng hiện tại.
				           |Trong %1
				           | - giá trị không hợp lệ cho tham số %2
				           | giá trị đã truyền:%3 (kiểu %4),
				           |- hoặc giá trị không hợp lệ cho tham số %5
				           |giá trị được chuyển:%6 (kiểu %7).';
				           |ru = 'Вызов исключения поддерживается только для текущего пользователя.
				           |В %1
				           |- либо недопустимое значение параметра %2
				           |передано значение: %3 (тип %4),
				           |- либо недопустимое значение параметра %5
				           |передано значение: %6 (тип %7).';
				           |en = 'An exception can be thrown for the current user only.
				           |In %1,
				           |- either the %2 parameter value is invalid
				           |value passed: %3 (the %4 type),
				           |- or the %5 parameter value is invalid
				           |value passed: %6 (the %7 type).'; fa = 'An exception can be thrown for the current user only.
				           |In %1,
				           |- either the %2 parameter value is invalid
				           |value passed: %3 (the %4 type),
				           |- or the %5 parameter value is invalid
				           |value passed: %6 (the %7 type).';
				           |it = 'L''eccezione viene generata solo per l''utente corrente.
				           |In %1
				           |- o valore del parametro %2 non valido 
				           |trasferito valore: %3 (del tipo %4),
				           |- o valore del parametro %5 non valido 
				           |trasferito valore: %6 (del tipo %7).';
				           |pl = 'Wywołanie wyjątku jest obsługiwane tylko dla bieżącego użytkownika.
				           |W %1
				           |- lub niedopuszczalna wartość parametru %2
				           |przekazano wartość: %3 (typ %4),
				           |- lub niedopuszczalną wartość parametru %5
				           |przekazano wartość: %6 (typ %7).';
				           |tr = 'İstisna çağrısı sadece mevcut kullanıcı için destekleniyor.
				           |%1
				           |''da- veya %2
				           | parametrenin geçeriz değeri aktarıldı: %3 (tür %4), 
				           |- veya %5
				           | parametrenin geçersiz değeri aktarılan değer: %6 (tür %7)'"),
				"AccessManagement.AccessAllowed",
				"RaiseException1",
				String(RaiseException1),
				String(TypeOf(RaiseException1)),
				"User",
				String(User),
				String(TypeOf(User)));
			Raise ErrorText;
		EndIf;
		
		If Users.IsFullUser(User,, ForPrivilegedMode) Then
			Return True;
		EndIf;
		
		IBUserID = Common.ObjectAttributeValue(User,
			"IBUserID");
		
		If TypeOf(IBUserID) <> Type("UUID") Then
			Return False;
		EndIf;
		
		IBUser = InfoBaseUsers.FindByUUID(
			IBUserID);
		
		If IBUser = Undefined Then
			Return False;
		EndIf;
	EndIf;
	
	AnyObject = DataDetails; // CatalogObject
	
	If Not RightUpdate Then
		AccessRightName = "Read";
		
	ElsIf Common.IsRefTypeObject(MetadataObject)
	        And Not Common.IsReference(TypeOf(AnyObject))
	        And AnyObject.IsNew() Then
		
		AccessRightName = "Create";
	Else
		AccessRightName = "Update";
	EndIf;
	
	FullName = MetadataObject.FullName();
	FieldList = AccessManagementInternalCached.ListOfAllAccessRestrictionFields(FullName);
	
	If RaiseException1 Then
		VerifyAccessRights(AccessRightName, MetadataObject);
		AccessParameters = AccessParameters(AccessRightName, MetadataObject, FieldList);
		
	ElsIf IBUser = Undefined Then
		AccessParameters = AccessParameters(AccessRightName, MetadataObject, FieldList);
		
	ElsIf User = Undefined Then
		SetSafeModeDisabled(True);
		SetPrivilegedMode(True);
		
		AccessParameters = AccessParameters(AccessRightName, MetadataObject, FieldList, IBUser);
		
		SetPrivilegedMode(False);
		SetSafeModeDisabled(False);
	Else
		AccessParameters = AccessParameters(AccessRightName, MetadataObject, FieldList, IBUser);
	EndIf;
	If Not AccessParameters.Accessibility Then
		Return False;
	ElsIf Not AccessParameters.RestrictionByCondition Then
		Return True;
	EndIf;
	
	If IsRecordLevelRestrictionDisabled()
	 Or AccessManagementInternalCached.IsUserWithUnlimitedAccess(User) Then
		Return True;
	EndIf;
	
	If Not ProductiveOption Then
		Return ReadAllowed(FullName, MetadataObject, DataDetails, RaiseException1);
	EndIf;
	
	If ValueIsFilled(User) Then
		ForExternalUsers = TypeOf(User) = Type("CatalogRef.ExternalUsers");
	Else
		ForExternalUsers = Undefined;
	EndIf;
	If TransactionActive() And Common.FileInfobase() Then
		PreliminaryLockBeforeWriteExistingObjectInFileInfobase();
	EndIf;
	
	TransactionID = New UUID;
	RestrictionParameters = RestrictionParameters(FullName, TransactionID, ForExternalUsers);
	
	SetSafeModeDisabled(True);
	SetPrivilegedMode(True);
	
	UpdateAllowedSetsInSessionParameters();
	
	If RestrictionParameters.RestrictionDisabled
	 Or Not RightUpdate
	   And RestrictionParameters.RightToWriteRestrictionDisabled Then
		
		Return True;
	EndIf;
	
	OldVersion = True;
	EditRight = False;
	IsNew = False;
	
	If RestrictionParameters.AccessDenied Then
		AccessAllowed = False;
	Else
		Query = New Query;
		SetAllowedSetsInQueryParameters(Query, User);
		
		Query.Text = ?(RightUpdate, RestrictionParameters.ReadEditRightsCheckQueryText,
			RestrictionParameters.ReadRightsCheckQueryText);
		
		If RestrictionParameters.IsReferenceType Then
			ObjectReference = ?(Common.IsReference(TypeOf(DataDetails)),
				DataDetails, DataDetails.Ref);
			Query.SetParameter("Object", ObjectReference);
			If RestrictionParameters.UsesRestrictionByOwner Then
				Query.SetParameter("RightSettingsTableID",
					RestrictionParameters.RightSettingsTableID);
			EndIf;
			If DataDetails = ObjectReference Or ValueIsFilled(ObjectReference) Then
				AccessAllowed = Not Query.Execute().IsEmpty();
			Else
				AccessAllowed = True;
			EndIf;
			
			If Not AccessAllowed Then
				DataToPresent = ObjectReference;
				
			ElsIf DataDetails <> ObjectReference And Not CheckOldVersionOnly Then
				OldVersion = False;
				If RestrictionParameters.UsesRestrictionByOwner Then
					FieldsSeparatedByAPoint = StrSplit(RestrictionParameters.OwnerField.Name, ".", False);
					ObjectField = FieldsSeparatedByAPoint[0];
					ObjectFieldValue = DataDetails[ObjectField];
					If FieldsSeparatedByAPoint.Count() = 1 Then
						ParameterFromMemory = "&Owner";
					Else
						MetadataObjectByType = Metadata.FindByType(TypeOf(ObjectFieldValue));
						If MetadataObjectByType = Undefined Then
							ParameterFromMemory = "&Owner";
							ObjectFieldValue = Null;
						Else
							FieldsSeparatedByAPoint.Delete(0);
							ParameterFromMemory = "CAST(&Owner AS " + MetadataObjectByType.FullName()
								+ ")." + StrConcat(FieldsSeparatedByAPoint, "."); // @query-part-1
						EndIf;
					EndIf;
					Query.Text = StrReplace(Query.Text,
						RestrictionParameters.OwnerObjectFieldInRightsValidationQuery, ParameterFromMemory);
					Query.SetParameter("Owner", ObjectFieldValue);
				Else
					InMemoryObjectsModel = InMemoryObjectsModel(DataDetails, RestrictionParameters);
					ParametersOfUpdate = New Structure(RestrictionParameters);
					ParametersOfUpdate.Insert("InMemoryObjectsModel", InMemoryObjectsModel);
					ParametersOfUpdate.Insert("TransactionID", TransactionID);
					ParametersOfUpdate.Insert("ListID",
						Common.MetadataObjectID(RestrictionParameters.List));
					UpdateAccessKeysOfListDataItemsBatch(InMemoryObjectsModel.DataItems, ParametersOfUpdate);
					Query.SetParameter("AccessKeysForObjects", InMemoryObjectsModel.AccessKeysForObjects);
					Query.SetParameter("Object", InMemoryObjectsModel.DataItems[0].CurrentRef);
					QueryText =
					"SELECT
					|	AccessKeysForObjects.Object AS Object,
					|	AccessKeysForObjects.UsersAccessKey AS UsersAccessKey,
					|	AccessKeysForObjects.ExternalUsersAccessKey AS ExternalUsersAccessKey
					|INTO InformationRegister_AccessKeysForObjects
					|FROM
					|	&AccessKeysForObjects AS AccessKeysForObjects";
					Query.Text = StrReplace(Query.Text, "InformationRegister.AccessKeysForObjects",
						"InformationRegister_AccessKeysForObjects");
					Query.Text = QueryText + Common.QueryBatchSeparator() + Query.Text;
				EndIf;
				AdditionCheck = False;
				QueryTextChanges = Query.Text;
				IsNew = DataDetails.IsNew();
				ClarifyInsertRight(Query, IsNew, RestrictionParameters, AdditionCheck);
				AccessAllowed = Not Query.Execute().IsEmpty();
				If Not AccessAllowed And AdditionCheck Then
					Query.Text = QueryTextChanges;
					EditRight = Not Query.Execute().IsEmpty();
				EndIf;
				DataToPresent = DataDetails;
			EndIf;
		Else
			RecordSet = Common.ObjectManagerByFullName(FullName).CreateRecordSet();
			RecordsFilter = RecordsFilterFromDataDetails(DataDetails, FullName, RecordSet);
			
			Replacing = Undefined;
			FilterByDimensions = FilterByRecordSetDimensions(RecordsFilter, Query, Replacing);
			QueryText = Query.Text;
			Query.Text = StrReplace(Query.Text, "&FilterByDimensions", FilterByDimensions);
			AccessAllowed = Query.Execute().IsEmpty();
			
			If AccessAllowed
			   And TypeOf(DataDetails) = TypeOf(RecordSet)
			   And Not Common.IsRecordSetDeletion(Replacing)
			   And Not CheckOldVersionOnly Then
				
				OldVersion = False;
				If RestrictionParameters.UsesRestrictionByOwner Then
					OwnerField = RestrictionParameters.OwnerField.Name;
					Combinations = DataDetails.Unload(, OwnerField); // ValueTable
					Combinations.GroupBy(OwnerField);
					Query.SetParameter("BasicFieldsValuesCombinations", Combinations);
					CombinationsPreparationQueryText = "SELECT CurrentTable." + OwnerField + "
					|INTO BasicFieldsValuesCombinations
					|FROM &BasicFieldsValuesCombinations AS CurrentTable"; //  @query-part-1, @query-part-2
				Else
					CombinationsPreparationQueryText = "SELECT CurrentTable." 
						+ StrConcat(RestrictionParameters.BasicFields.UsedItems, ",
					|	CurrentTable.") + "
					|INTO BasicFieldsValuesCombinations
					|FROM &BasicFieldsValuesCombinations AS CurrentTable"; // @query-part-1, @query-part-2, @query-part-3
					DataDetails.AdditionalProperties.Insert("AccessManagementTransactionID",
						TransactionID);
					UpdateRecordSetAccessKeys(DataDetails, False, False,
						TransactionID, RestrictionParameters, "", Query);
					DataDetails.AdditionalProperties.Delete("AccessManagementTransactionID");
				EndIf;
				Query.Text = StrReplace(QueryText, "&FilterByDimensions", "TRUE");
				FullRegisterName = Metadata.FindByType(TypeOf(DataDetails)).FullName();
				Query.Text = CombinationsPreparationQueryText + Common.QueryBatchSeparator()
					+ StrReplace(Query.Text, FullRegisterName + " AS CurrentTable",
						"BasicFieldsValuesCombinations AS CurrentTable"); // @query-part-1 @query-part-2
				
				AccessAllowed = Query.Execute().IsEmpty();
			EndIf;
			DataToPresent = RecordSet;
		EndIf;
	EndIf;
	
	SetPrivilegedMode(False);
	SetSafeModeDisabled(False);
	
	If AccessAllowed Or Not RaiseException1 Then
		Return AccessAllowed;
	EndIf;
	
	If RightUpdate Then
		ReadRight1 = AccessAllowed(DataDetails, False);
	Else
		ReadRight1 = False;
	EndIf;
	
	ReportAccessError(DataToPresent, OldVersion, ReadRight1, EditRight, IsNew);
	
	Return False;
	
EndFunction

// For the AccessAllowed function.
Function ReadAllowed(FullName, MetadataObject, DataDetails, RaiseException1)
	
	Query = New Query;
	
	If IsReferenceTableType(FullName) Then
		ObjectReference = ?(Common.IsReference(TypeOf(DataDetails)),
			DataDetails, DataDetails.Ref);
		
		Query.SetParameter("Ref", ObjectReference);
		QueryText =
		"SELECT ALLOWED TOP 1
		|	TRUE AS TrueValue
		|FROM
		|	&CurrentTable AS CurrentTable
		|WHERE
		|	CurrentTable.Ref = &Ref";
		Query.Text = StrReplace(QueryText, "&CurrentTable", FullName);
		If Not Query.Execute().IsEmpty() Then
			Return True;
		EndIf;
		DataToPresent = ObjectReference;
	Else
		RecordSet = Common.ObjectManagerByFullName(FullName).CreateRecordSet();
		RecordsFilter = RecordsFilterFromDataDetails(DataDetails, FullName, RecordSet);
		
		FilterByDimensions = FilterByRecordSetDimensions(RecordsFilter, Query);
		QueryText =
		"SELECT ALLOWED
		|	COUNT(1) AS DataVolume
		|FROM
		|	&CurrentTable AS CurrentTable
		|WHERE
		|	&FilterByDimensions";
		QueryText = StrReplace(QueryText, "&FilterByDimensions", FilterByDimensions);
		Query.Text = StrReplace(QueryText, "&CurrentTable", FullName);
		
		SetPrivilegedMode(True);
		Selection = Query.Execute().Select();
		SetPrivilegedMode(False);
		TotalData = ?(Selection.Next(), Selection.DataVolume, 0);
		
		Selection = Query.Execute().Select();
		DataAvailable = ?(Selection.Next(), Selection.DataVolume, 0);
		
		If TotalData = DataAvailable Then
			Return True;
		EndIf;
		DataToPresent = RecordSet;
	EndIf;
	
	If Not RaiseException1 Then
		Return False;
	EndIf;
	
	ReportAccessError(DataToPresent, True, False, False, False);
	
	Return False;
	
EndFunction

// See AccessManagement.AccessRightsToData
Function AccessRightsToData(DataDetails, ForExternalUsers, UsersContent) Export
	
	If TypeOf(ForExternalUsers) <> Type("Boolean") Then
		Result1 = AccessRightsToData(DataDetails, False,   UsersContent);
		Result2 = AccessRightsToData(DataDetails, True, UsersContent);
		For Each SpecificationRow In Result2 Do
			FillPropertyValues(Result1.Add(), SpecificationRow);
		EndDo;
		Return Result1;
	EndIf;
	
	If Not Users.IsFullUser() Then
		ErrorText = NStr("vi = 'Không đủ quyền truy cập.';
						|ru = 'Недостаточно прав доступа.';
						|en = 'Insufficient access rights.'; fa = 'حقوق دسترسی ناکافی.';
						|it = 'Diritti di accesso insufficienti.';
						|pl = 'Niewystarczające uprawnienia dostępu.';
						|tr = 'Yetersiz erişim hakı.'");
		ForAdministrator = NStr("vi = 'Cần có quyền đầy đủ hoặc chế độ ưu tiên.';
								|ru = 'Нужны полные права или привилегированный режим.';
								|en = 'Either full access or privileged mode is required.'; fa = 'Either full access or privileged mode is required.';
								|it = 'Either full access or privileged mode is required.';
								|pl = 'Either full access or privileged mode is required.';
								|tr = 'Tam izinlere veya ayrıcalıklı moda ihtiyaç duyulacaktır.'");
		Raise(ErrorText, ErrorCategory.AccessViolation,, ForAdministrator);
	EndIf;
	
	If Not AccessManagement.ProductiveOption() Then
		ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Chức năng %1 không hỗ trợ trong phương án chuẩn hạn chế truy cập.';
				|ru = 'Функция %1 не поддерживается в стандартном варианте ограничения доступа.';
				|en = 'The standard access restriction mode does not support function %1.'; fa = 'The standard access restriction mode does not support function %1.';
				|it = 'The standard access restriction mode does not support function %1.';
				|pl = 'The standard access restriction mode does not support function %1.';
				|tr = '%1 fonksiyonu, standart erişim kısıtlamasında desteklenmemektedir.'"),
			"AccessManagement.AccessRightsToData");
		Raise(ErrorText, ErrorCategory.ConfigurationError);
	EndIf;
	
	If TypeOf(DataDetails) = Type("Array") Then
		DataElement = ?(DataDetails.Count() > 0, DataDetails[0],
			"<" + NStr("vi = 'Mảng trống';
						|ru = 'Пустой массив';
						|en = 'An empty array'; fa = 'An empty array';
						|it = 'An empty array';
						|pl = 'An empty array';
						|tr = 'Boş dizi'") + ">");
	Else
		DataElement = DataDetails;
	EndIf;
	
	MetadataObject = Metadata.FindByType(TypeOf(DataElement));
	If MetadataObject = Undefined Then
		ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Giá trị tham số không hợp lệ %1 trong %2.
			           |Dự kiến là tham chiếu, khóa bản ghi, tập hợp bản ghi hoặc mảng tham chiếu cùng loại đã được điền.
			           |Đã chuyển giá trị: %3 (kiểu %4).';
			           |ru = 'Недопустимое значение параметра %1 в %2.
			           |Ожидалась ссылка, ключ записи, набор записей или непустой массив ссылок одного типа.
			           |Передано значение: %3 (тип %4).';
			           |en = 'Invalid value of the %1 parameter in %2.
			           |A reference, object, record key, record set, or a non-empty array of same-type references are expected.
			           |Passed value: %3 (type %4).'; fa = 'Invalid value of the %1 parameter in %2.
			           |A reference, object, record key, record set, or a non-empty array of same-type references are expected.
			           |Passed value: %3 (type %4).';
			           |it = 'Invalid value of the %1 parameter in %2.
			           |A reference, object, record key, record set, or a non-empty array of same-type references are expected.
			           |Passed value: %3 (type %4).';
			           |pl = 'Invalid value of the %1 parameter in %2.
			           |A reference, object, record key, record set, or a non-empty array of same-type references are expected.
			           |Passed value: %3 (type %4).';
			           |tr = '%2''da kabul edilemez %1 parametre değeri.
			           |Bağlantı, kaydetme anahtarı, kayıt kümesi veya aynı türden referansların boş olmayan bir dizisi bekleniyordu.
			           |Aktarılan değer: %3 (tür%4).'"),
			"DataDetails",
			"AccessManagement.AccessRightsToData",
			String(DataElement),
			String(TypeOf(DataDetails)));
		Raise(ErrorText, ErrorCategory.ConfigurationError);
	EndIf;
	
	IsRecordLevelRestrictionDisabled = IsRecordLevelRestrictionDisabled();
	FullName = MetadataObject.FullName();
	
	If IsRecordLevelRestrictionDisabled Then
		RestrictionParameters = New Structure;
		RestrictionParameters.Insert("List", FullName);
		RestrictionParameters.Insert("ForExternalUsers", ForExternalUsers);
		RestrictionParameters.Insert("AccessDenied", False);
		RestrictionParameters.Insert("IsReferenceType",
			Not Common.IsRegister(MetadataObject))
	Else
		RestrictionParameters = RestrictionParameters(FullName,
			New UUID, ForExternalUsers);
	EndIf;
	
	If ForExternalUsers
	   And Not Constants.UseExternalUsers.Get() Then
		
		Return PreparedResult(RestrictionParameters);
	EndIf;
	
	Query = New Query;
	AddQueryOfUsersToCheck(Query, ForExternalUsers, UsersContent);
	Query.SetParameter("BlankUUID",
		CommonClientServer.BlankUUID());
	Query.SetParameter("MetadataObjectID",
		Common.MetadataObjectID(MetadataObject));
	
	If IsRecordLevelRestrictionDisabled
	 Or RestrictionParameters.AccessDenied
	 Or RestrictionParameters.RestrictionDisabled Then
		
		AddUsersRightsQueryForTable(Query, RestrictionParameters,
			?(RestrictionParameters.AccessDenied, "OnlyRightsWithoutRestriction", "RightsWithRestriction"),
			?(UsersContent = Undefined, "", "UsersToCheck"),
			"UsersWithTableRights");
		
		QueryTextOfRightsWithData = Undefined;
		AddQueryOfObjectsToCheck(Query, DataDetails, RestrictionParameters, QueryTextOfRightsWithData);
		Query.Text = Query.Text + Common.QueryBatchSeparator() + QueryTextOfRightsWithData;
		
		Return PreparedResult(RestrictionParameters, Query);
	EndIf;
	
	AddUsersRightsQueryForTable(Query, RestrictionParameters,
		?(RestrictionParameters.RightToWriteRestrictionDisabled, "RightToWriteRestrictionDisabled", "OnlyRightsWithoutRestriction"),
		?(UsersContent = Undefined, "", "UsersToCheck"),
		"UsersWithUnrestrictedTableRights");
	
	QueryTextOfRightsWithData = "";
	FilterByDimensions = "";
	AddQueryOfObjectsToCheck(Query, DataDetails, RestrictionParameters,
		QueryTextOfRightsWithData, FilterByDimensions);
	
	QueryText = RestrictionParameters.QueryTextOfUsersRights;
	
	If UsersContent <> Undefined Then
		FilterUsers = StrTemplate(
		"CAST(UsersSets.User AS %1) IN
		|	(SELECT
		|		UsersToCheck.UserWithRight
		|	FROM
		|		UsersToCheck AS UsersToCheck)",
		?(ForExternalUsers, "Catalog.ExternalUsers", "Catalog.Users"));
	Else
		FilterUsers = "TRUE";
	EndIf;
	
	QueryText = StrReplace(QueryText, "&FilterUsers1",
		TextWithIndent(FilterUsers, "				"));
	
	QueryText = StrReplace(QueryText, "&FilterUsers2", TextWithIndent(
		StrReplace(FilterUsers, "UsersSets.User", "UserGroupCompositions.User"),
		"				"));
	
	If Not RestrictionParameters.IsReferenceType
	   And Not RestrictionParameters.UsesRestrictionByOwner Then
		
		QueryText = StrReplace(QueryText, "&FilterByDimensions",
			TextWithIndent(FilterByDimensions, "		"));
	EndIf;
	
	Query.Text = Query.Text + Common.QueryBatchSeparator() + QueryText;
	
	Query.SetParameter("AllowedBlankAccessGroupsSet",
		AccessManagementInternalCached.AllowedBlankAccessGroupsSet());
	
	If RestrictionParameters.UsesRestrictionByOwner Then
		Query.SetParameter("RightSettingsTableID",
			RestrictionParameters.RightSettingsTableID);
	EndIf;
	
	AddUsersQueryFromDataItemsRights(Query, RestrictionParameters, UsersContent);
	
	AddUsersRightsQueryForTable(Query, RestrictionParameters,
		"RightsWithRestriction",
		"UsersFromDataItemsRights",
		"UsersWithRestrictedTableRights");
	
	AddFinalUsersRightsQuery(Query, RestrictionParameters, QueryTextOfRightsWithData, FilterByDimensions);
	
	Return PreparedResult(RestrictionParameters, Query);
	
EndFunction

// Intended for functions "AccessAllowed", "ReadingAllowed", and "AccessRightsToData".
Function RecordsFilterFromDataDetails(DataDetails, FullRegisterName, NewEmptyRecordSet,
			AccessRightsToData = False)
	
	If TypeOf(DataDetails) <> TypeOf(NewEmptyRecordSet) Then
		// RecordKey.
		RecordsFilter = New Array;
		RecordKeyDetails = StandardSubsystemsServer.RecordKeyDetails(FullRegisterName);
		For Each FieldDetails In RecordKeyDetails.FieldsDetails Do
			RecordsFilter.Add(New Structure("Name, Value, Use",
				FieldDetails.Name, DataDetails[FieldDetails.Name], True));
		EndDo;
		Return RecordsFilter;
	EndIf;
	
	If Not AccessRightsToData Then
		Return DataDetails;
	EndIf;
	
	HasFilter = False;
	For Each FilterElement In DataDetails.Filter Do
		If FilterElement.Use Then
			HasFilter = True;
		EndIf;
	EndDo;
	
	Return ?(HasFilter, DataDetails.Filter, Undefined);
	
EndFunction

// Intended for function "AccessRightsToData".
Function PreparedResult(RestrictionParameters, Query = Undefined);
	
	FullName = RestrictionParameters.List;
	
	If Query = Undefined Then
		TypeUser = New TypeDescription("CatalogRef.Users, CatalogRef.ExternalUsers");
		Result = New ValueTable;
		Result.Columns.Add("UserWithRight", TypeUser);
		Result.Columns.Add("RightUpdate", New TypeDescription("Boolean"));
		If RestrictionParameters.IsReferenceType Then
			RefType = RefTypeByFullMetadataName(FullName);
			Result.Columns.Add("Ref",
				New TypeDescription(CommonClientServer.ValueInArray(RefType)));
		Else
			RecordKeyDetails = StandardSubsystemsServer.RecordKeyDetails(FullName);
			For Each FieldDetails In RecordKeyDetails.FieldsDetails Do
				Result.Columns.Add(FieldDetails.Name, FieldDetails.Type);
			EndDo;
		EndIf;
	Else
		QueryText =
		"SELECT
		|	VALUE(Catalog.Users.EmptyRef) AS UserWithRight,
		|	FALSE AS RightUpdate,
		|	UNDEFINED AS Ref
		|WHERE
		|	FALSE
		|
		|UNION ALL
		|
		|SELECT
		|	VALUE(Catalog.ExternalUsers.EmptyRef),
		|	FALSE,
		|	UNDEFINED AS Ref
		|WHERE
		|	FALSE";
		If Not RestrictionParameters.IsReferenceType Then
			RecordKeyDetails = StandardSubsystemsServer.RecordKeyDetails(FullName);
			DimensionsForSelection = New Array;
			For Each FieldDetails In RecordKeyDetails.FieldsDetails Do
				DimensionsForSelection.Add("UNDEFINED"); // @query-part-1
			EndDo;
			QueryText = StrReplace(QueryText, "UNDEFINED AS Ref",
				StrConcat(DimensionsForSelection, ",
					|	")); // @query-part-1
		EndIf;
		Query.Text = Query.Text + Common.UnionAllText() + QueryText;
		Result = Query.Execute().Unload();
	EndIf;
	
	Return Result;
	
EndFunction

Procedure AddQueryOfUsersToCheck(Query, ForExternalUsers, UsersContent)
	
	If UsersContent = Undefined Then
		Return;
	EndIf;
	
	QueryText =
	"SELECT DISTINCT
	|	UsersToCheck.User AS UserWithRight
	|INTO UsersToCheck
	|FROM
	|	&UsersToCheck AS UsersToCheck
	|
	|INDEX BY
	|	User";
	
	UsersToCheck = New ValueTable;
	UserType = ?(ForExternalUsers, Type("CatalogRef.ExternalUsers"),
		Type("CatalogRef.Users"));
	UsersToCheck.Columns.Add("User", New TypeDescription(
		CommonClientServer.ValueInArray(UserType)));
	
	For Each User In UsersContent Do
		If TypeOf(User) = UserType And ValueIsFilled(User) Then
			UsersToCheck.Add().User = User;
		EndIf;
	EndDo;
	
	Query.SetParameter("UsersToCheck", UsersToCheck);
	Query.Text = Query.Text + ?(ValueIsFilled(Query.Text),
		Common.QueryBatchSeparator(), "") + QueryText;
	
EndProcedure

Procedure AddUsersRightsQueryForTable(Query, RestrictionParameters, RightsOption,
			TemporaryTableNameOfCheckedUsers = "", NameOfTemporaryResultTable = "")
	
	If TemporaryTableNameOfCheckedUsers = "" Then
		QueryText =
		"SELECT
		|	UsersList.Ref AS UserWithRight,
		|	MAX(AccessGroupsTables.RightUpdate) AS RightUpdate
		|FROM
		|	InformationRegister.AccessGroupsTables AS AccessGroupsTables
		|		INNER JOIN Catalog.AccessGroups.Users AS AccessGroups_Users
		|		ON (AccessGroups_Users.Ref = AccessGroupsTables.AccessGroup)
		|			AND (AccessGroupsTables.Table = &MetadataObjectID)
		|			AND (&FilterRight)
		|		INNER JOIN InformationRegister.UserGroupCompositions AS UserGroupCompositions
		|		ON (UserGroupCompositions.UsersGroup = AccessGroups_Users.User)
		|			AND (UserGroupCompositions.Used)
		|		INNER JOIN Catalog.Users AS UsersList
		|		ON (UsersList.Ref = UserGroupCompositions.User)
		|			AND (UsersList.IBUserID <> &BlankUUID)
		|			AND (NOT UsersList.DeletionMark)
		|			AND (NOT UsersList.Invalid)
		|			AND (NOT UsersList.IsInternal)
		|
		|GROUP BY
		|	UsersList.Ref";
	Else
		QueryText =
		"SELECT
		|	UsersToCheck.UserWithRight AS UserWithRight,
		|	MAX(AccessGroupsTables.RightUpdate) AS RightUpdate
		|FROM
		|	UsersToCheck AS UsersToCheck
		|		INNER JOIN Catalog.Users AS UsersList
		|		ON (UsersList.Ref = UsersToCheck.UserWithRight)
		|			AND (UsersList.IBUserID <> &BlankUUID)
		|			AND (NOT UsersList.DeletionMark)
		|			AND (NOT UsersList.Invalid)
		|			AND (NOT UsersList.IsInternal)
		|		INNER JOIN InformationRegister.UserGroupCompositions AS UserGroupCompositions
		|		ON (UserGroupCompositions.User = UsersList.Ref)
		|			AND (UserGroupCompositions.Used)
		|		INNER JOIN Catalog.AccessGroups.Users AS AccessGroups_Users
		|		ON (AccessGroups_Users.User = UserGroupCompositions.UsersGroup)
		|		INNER JOIN InformationRegister.AccessGroupsTables AS AccessGroupsTables
		|		ON (AccessGroupsTables.AccessGroup = AccessGroups_Users.Ref)
		|			AND (AccessGroupsTables.Table = &MetadataObjectID)
		|			AND (&FilterRight)
		|
		|GROUP BY
		|	UsersToCheck.UserWithRight";
		
		QueryText = StrReplace(QueryText, "UsersToCheck AS",
			TemporaryTableNameOfCheckedUsers + " AS"); // @query-part-1, @query-part-2
	EndIf;
	
	If NameOfTemporaryResultTable <> "" Then
		QueryText = StrReplace(QueryText, "AS RightUpdate",
		"AS RightUpdate
		|INTO " + NameOfTemporaryResultTable); // @query-part-1, @query-part-2
	EndIf;
	
	If RestrictionParameters.ForExternalUsers Then
		QueryText = StrReplace(QueryText, "Catalog.Users", "Catalog.ExternalUsers");
		QueryText = StrReplace(QueryText, "UsersList.Invalid", "FALSE");
		QueryText = StrReplace(QueryText, "UsersList.IsInternal", "FALSE");
	EndIf;
	
	If RightsOption = "RightsWithRestriction" Then
		QueryText = StrReplace(QueryText, "&FilterRight", "TRUE");
	Else
		QueryText = StrReplace(QueryText, "MAX(AccessGroupsTables.RightUpdate)",
			"MAX(AccessGroupsTables.UnrestrictedUpdateRight)"); // @query-part-1, @query-part-2
		
		If RightsOption = "RightToWriteRestrictionDisabled" Then
			QueryText = StrReplace(QueryText, "&FilterRight", "TRUE");
		Else // OnlyRightsWithoutRestriction
			QueryText = StrReplace(QueryText, "&FilterRight",
				"AccessGroupsTables.UnrestrictedReadRight");
		EndIf;
	EndIf;
	
	Query.Text = Query.Text + ?(ValueIsFilled(Query.Text),
		Common.QueryBatchSeparator(), "") + QueryText;
	
EndProcedure

Procedure AddQueryOfObjectsToCheck(Query, DataDetails, RestrictionParameters,
			QueryTextOfRightsWithData = Undefined, FilterByDimensions = Undefined)
	
	CurrentTable = New ValueTable;
	FullName = RestrictionParameters.List;
	
	If RestrictionParameters.IsReferenceType Then
		QueryText =
		"SELECT DISTINCT
		|	CurrentTable.Ref AS Ref
		|INTO CurrentTable
		|FROM
		|	&CurrentTable AS CurrentTable";
	
		RefType = RefTypeByFullMetadataName(FullName);
		CurrentTable.Columns.Add("Ref", New TypeDescription(
			CommonClientServer.ValueInArray(RefType)));
		
		If TypeOf(DataDetails) = Type("Array") Then
			For Counter = 1 To DataDetails.Count() Do
				CurrentTable.Add();
			EndDo;
			CurrentTable.LoadColumn(DataDetails, "Ref");
		Else
			CurrentTable.Add().Ref = DataDetails;
		EndIf;
		Query.SetParameter("CurrentTable", CurrentTable);
		Query.Text = Query.Text + Common.QueryBatchSeparator() + QueryText;
		
		If QueryTextOfRightsWithData = Undefined Then
			QueryTextOfRightsWithData =
			"SELECT
			|	UsersRights.UserWithRight AS UserWithRight,
			|	UsersRights.RightUpdate AS RightUpdate,
			|	CurrentTable.Ref AS Ref
			|FROM
			|	UsersWithTableRights AS UsersRights
			|		INNER JOIN CurrentTable AS CurrentTable
			|		ON TRUE";
		EndIf;
		
		Return;
		
	EndIf;
	
	RecordSet = Common.ObjectManagerByFullName(FullName).CreateRecordSet();
	RecordsFilter = RecordsFilterFromDataDetails(DataDetails, FullName, RecordSet, True);
	
	FilterByDimensions = ?(RecordsFilter = Undefined, "TRUE",
		FilterByRecordSetDimensions(RecordsFilter, Query));
	
	RecordKeyDetails = StandardSubsystemsServer.RecordKeyDetails(FullName);
	
	If ValueIsFilled(DataDetails) And RecordsFilter = Undefined Then
		DimensionsForSelection = New Array;
		For Each FieldDetails In RecordKeyDetails.FieldsDetails Do
			DimensionsForSelection.Add(StrTemplate("CurrentTable.%1 AS %1", FieldDetails.Name)); // @query-part-1
		EndDo;
		QueryTextOfRecordsKeys =
		"SELECT DISTINCT
		|	CurrentTable.Field1 AS Field1
		|INTO RegisterRecordsKeys
		|FROM
		|	&RegisterRecordsKeys AS CurrentTable";
		QueryTextOfRecordsKeys = StrReplace(QueryTextOfRecordsKeys,
			"CurrentTable.Field1 AS Field1", 
			StrConcat(DimensionsForSelection, ",
				|	")); // @query-part-1
		Query.SetParameter("RegisterRecordsKeys",
			DataDetails.Unload(, RecordKeyDetails.FieldList));
		
		FilterByDimensions =
		"TRUE IN
		|			(SELECT TOP 1
		|				TRUE
		|			FROM
		|				RegisterRecordsKeys AS RegisterRecordsKeys
		|			WHERE
		|				RegisterRecordsKeys.Field1 = CurrentTable.Field1)"; // @query-part-1
		FilterConditions = New Array;
		For Each FieldDetails In RecordKeyDetails.FieldsDetails Do
			FilterConditions.Add(StrTemplate("RegisterRecordsKeys.%1 = CurrentTable.%1", FieldDetails.Name));
		EndDo;
		FilterByDimensions = StrReplace(FilterByDimensions,
			"RegisterRecordsKeys.Field1 = CurrentTable.Field1",
			StrConcat(FilterConditions, "
				|				AND ")); // @query-part-1, @query-part-2
	EndIf;
	
	If QueryTextOfRightsWithData = Undefined Then
		QueryTextOfRightsWithData =
		"SELECT
		|	UsersRights.UserWithRight AS UserWithRight,
		|	UsersRights.RightUpdate AS RightUpdate,
		|	CurrentTable.Field1 AS Field1
		|FROM
		|	UsersWithTableRights AS UsersRights
		|		INNER JOIN &RegisterTable AS CurrentTable
		|		ON (&FilterByDimensions)";
		
	ElsIf RestrictionParameters.UsesRestrictionByOwner Then
		OwnerBasicField = StrSplit(RestrictionParameters.OwnerField.Name, ".").Get(0);
		OwnerQueryText =
		"SELECT DISTINCT
		|	CurrentTable.OwnerBasicField AS Ref
		|INTO CurrentTable
		|FROM
		|	&RegisterTable AS CurrentTable
		|WHERE
		|	&FilterByDimensions";
		OwnerQueryText = StrReplace(OwnerQueryText, "OwnerBasicField", OwnerBasicField);
		OwnerQueryText = StrReplace(OwnerQueryText, "&RegisterTable", FullName);
		OwnerQueryText = StrReplace(OwnerQueryText, "&FilterByDimensions", FilterByDimensions);
		
		QueryTextOfRightsWithData =
		"SELECT
		|	UsersRights.UserWithRight AS UserWithRight,
		|	UsersRights.RightUpdate AS RightUpdate,
		|	CurrentTable.Field1 AS Field1
		|FROM
		|	UsersRightsToRegisterRecordsByOwner AS UsersRights
		|		INNER JOIN &RegisterTable AS CurrentTable
		|		ON (CurrentTable.OwnerBasicField = UsersRights.Ref)
		|			AND (&FilterByDimensions)";
		QueryTextOfRightsWithData = StrReplace(QueryTextOfRightsWithData,
			"OwnerBasicField", OwnerBasicField);
	EndIf;
	
	If ValueIsFilled(QueryTextOfRightsWithData) Then
		DimensionsForSelection = New Array;
		For Each FieldDetails In RecordKeyDetails.FieldsDetails Do
			ClarifiedName = ClarifiedNameOfRecordKeyFieldToSelectDataAccessRights(FieldDetails.Name);
			DimensionsForSelection.Add(StrTemplate("CurrentTable.%1 AS %2", FieldDetails.Name, ClarifiedName)); // @query-part-1
		EndDo;
		QueryTextOfRightsWithData = StrReplace(QueryTextOfRightsWithData, "&RegisterTable", FullName);
		QueryTextOfRightsWithData = StrReplace(QueryTextOfRightsWithData, "&FilterByDimensions",
			TextWithIndent(FilterByDimensions, "	"));
		QueryTextOfRightsWithData = StrReplace(QueryTextOfRightsWithData,
			"CurrentTable.Field1 AS Field1",
			StrConcat(DimensionsForSelection, ",
				|	")); // @query-part-1
	EndIf;
	
	If ValueIsFilled(QueryTextOfRecordsKeys) Then
		Query.Text = Query.Text + Common.QueryBatchSeparator() + QueryTextOfRecordsKeys;
	EndIf;
	
	If ValueIsFilled(OwnerQueryText) Then
		Query.Text = Query.Text + Common.QueryBatchSeparator() + OwnerQueryText;
	EndIf;
	
EndProcedure

Procedure AddUsersQueryFromDataItemsRights(Query, RestrictionParameters, UsersContent)
	
	If UsersContent = Undefined Then
		QueryText =
		"SELECT DISTINCT
		|	AllUsersFromRights.UserWithRight AS UserWithRight
		|INTO UsersFromDataItemsRights
		|FROM
		|	(SELECT
		|		CAST(UsersWithRights.UserWithRight AS Catalog.Users) AS UserWithRight
		|	FROM
		|		UsersWithDataItemsRights AS UsersWithRights
		|	WHERE
		|		VALUETYPE(UsersWithRights.UserWithRight) = TYPE(Catalog.Users)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		UsersList.Ref
		|	FROM
		|		UsersWithDataItemsRights AS UsersWithRights
		|			INNER JOIN Catalog.Users AS UsersList
		|			ON (UsersWithRights.UserWithRight = &AllowedBlankAccessGroupsSet)) AS AllUsersFromRights";
	Else
		QueryText =
		"SELECT DISTINCT
		|	AllUsersFromRights.UserWithRight AS UserWithRight
		|INTO UsersFromDataItemsRights
		|FROM
		|	(SELECT
		|		CAST(UsersWithRights.UserWithRight AS Catalog.Users) AS UserWithRight
		|	FROM
		|		UsersWithDataItemsRights AS UsersWithRights
		|	WHERE
		|		VALUETYPE(UsersWithRights.UserWithRight) = TYPE(Catalog.Users)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		UsersToCheck.UserWithRight
		|	FROM
		|		UsersWithDataItemsRights AS UsersWithRights
		|			INNER JOIN UsersToCheck AS UsersToCheck
		|			ON (UsersWithRights.UserWithRight = &AllowedBlankAccessGroupsSet)) AS AllUsersFromRights";
	EndIf;
	
	If RestrictionParameters.ForExternalUsers Then
		QueryText = StrReplace(QueryText, "Catalog.Users", "Catalog.ExternalUsers");
	EndIf;
	
	Query.Text = Query.Text + Common.QueryBatchSeparator() + QueryText;
	
EndProcedure

Procedure AddFinalUsersRightsQuery(Query, RestrictionParameters,
			QueryTextOfRightsWithData, FilterByDimensions)
	
	QueryText =
	"SELECT
	|	UsersRights.UserWithRight AS UserWithRight,
	|	MAX(UsersRights.RightUpdate) AS RightUpdate,
	|	UsersRights.Ref AS Ref
	|FROM
	|	(SELECT
	|		RightsToTable.UserWithRight AS UserWithRight,
	|		RightsToTable.RightUpdate AS RightUpdate,
	|		CurrentTable.Ref AS Ref
	|	FROM
	|		CurrentTable AS CurrentTable
	|			INNER JOIN UsersWithUnrestrictedTableRights AS RightsToTable
	|			ON (&FilterByDimensions)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		RightsToTable.UserWithRight,
	|		RightsToTable.RightUpdate
	|			AND CurrentTable.RightUpdate,
	|		CurrentTable.Ref AS Ref
	|	FROM
	|		UsersWithRestrictedTableRights AS RightsToTable
	|			INNER JOIN UsersWithDataItemsRights AS CurrentTable
	|			ON (CurrentTable.UserWithRight = RightsToTable.UserWithRight)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		RightsToTable.UserWithRight,
	|		RightsToTable.RightUpdate
	|			AND CurrentTable.RightUpdate,
	|		CurrentTable.Ref AS Ref
	|	FROM
	|		UsersWithRestrictedTableRights AS RightsToTable
	|			INNER JOIN UsersWithDataItemsRights AS CurrentTable
	|			ON (CurrentTable.UserWithRight = &AllowedBlankAccessGroupsSet)) AS UsersRights
	|
	|GROUP BY
	|	UsersRights.Ref,
	|	UsersRights.UserWithRight";
	
	If Not RestrictionParameters.IsReferenceType
	   And RestrictionParameters.UsesRestrictionByOwner Then
		
		QueryText = StrReplace(QueryText, "UsersRights.Ref AS Ref",
			"UsersRights.Ref AS Ref
			|INTO UsersRightsToRegisterRecordsByOwner"); // @query-part-1, @query-part-2
		
		QueryText = QueryText + Common.QueryBatchSeparator() + QueryTextOfRightsWithData;
		
	ElsIf Not RestrictionParameters.IsReferenceType Then
		
		SetDimensionsFieldsForSelectionAndGrouping(QueryText, RestrictionParameters.List);
		
		QueryText = StrReplace(QueryText,
			"CurrentTable AS CurrentTable",
			RestrictionParameters.List + " AS CurrentTable"); // @query-part-1, @query-part-2
		
		QueryText = StrReplace(QueryText, "&FilterByDimensions",
			TextWithIndent(FilterByDimensions, "		"));
	EndIf;
	
	If RestrictionParameters.IsReferenceType
	 Or RestrictionParameters.UsesRestrictionByOwner Then
		
		QueryText = StrReplace(QueryText, "&FilterByDimensions", "TRUE");
	EndIf;
	
	Query.Text = Query.Text + Common.QueryBatchSeparator() + QueryText;
	
EndProcedure

