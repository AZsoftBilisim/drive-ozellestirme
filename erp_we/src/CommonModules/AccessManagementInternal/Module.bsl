				           |"" erişim türü için değer türü olarak belirlendi. %1 Erişim türü için ""%3"" değerler grup tipi olarak belirtilemez.'");
		Else
			ForSameAccessKindNoError = True;
			ErrorDescription =
				NStr("vi = 'Kiểu nhóm giá trị ""%1"" đã chỉ định cho dạng truy cập ""%2"".
				           |Đối với dạng truy cập ""%3"" nó không cần chỉ định.';
				           |ru = 'Тип групп значений ""%1"" уже указан для вида доступа ""%2"".
