					Return;
				EndIf;
				ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Đã đặt dấu hiệu tối ưu hóa hạn chế ""%1"",
					           |nhưng hạn chế thay đổi đã chỉ ra không được cung cấp bởi một hàm
					           |""%2"" hoặc ""%3"".';
					           |ru = 'Установлен признак оптимизации ограничения ""%1"",
					           |но указанное ограничение изменения не представлено одной функцией
					           |""%2"" или ""%3"".';
					           |en = 'The optimization option ""%1"" is set
					           |but the specified update restriction is applied outside of the
					           |""%2"" or ""%3"" function.'; fa = 'The optimization option ""%1"" is set
					           |but the specified update restriction is applied outside of the
					           |""%2"" or ""%3"" function.';
