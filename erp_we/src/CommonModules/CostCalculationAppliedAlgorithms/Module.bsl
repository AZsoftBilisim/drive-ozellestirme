// Returns an array of organizations that have balances (adjustments must be made).
//
// Returns:
//	Array -
//
Function OrganizationsWithCostBalances(CalculationPeriod, CompanyArray = Undefined) Export
	
	QueryText = "";
	QueryTemplate = GETRequestHeader(, True) + "
	|		T.Organization
	|	FROM
	|		%1.Balance(&BeginOfPeriod, Organization IN (&FilterCompanies)) AS T";
	
	For Each RegisterName In RegistersWithInitialRemainderAdjustments() Do
		
		If Not Metadata.AccumulationRegisters.Contains(Metadata.FindByFullName(RegisterName)) Then
			Continue;
		EndIf;
		
		CostCalculationUniversalAlgorithms.SupplementString(
			QueryText, 
			StringFunctionsClientServer.SubstituteParametersToString(QueryTemplate, RegisterName),,,,
			Chars.LF + "	UNION ALL" + Chars.LF + "	");
		
	EndDo;
	
	QueryTemplate =
	"SELECT DISTINCT
	|	T.Organization
	|FROM
	|	TableName AS T";
	
	QueryText = StrReplace(QueryTemplate, "TableName", "(" + QueryText + ")");
	
	Query = New Query;
	Query.Text = QueryText;
	
	Query.SetParameter("BeginOfPeriod", 		BegOfMonth(CalculationPeriod));
	Query.SetParameter("FilterCompanies", 
		?(Not ValueIsFilled(CompanyArray),
			Catalogs.Companies.AvailableCompanies(),
			TMCommonUseClientServer.Array(CompanyArray)));
	
	Result = Query.Execute().Unload().UnloadColumn("Organization");
	
	Return Result;
	
EndFunction

