// Procedure-handler for checking the State of the system "Analyticsperfill fields".
//
// Parameters:
// CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure CheckingAnalyticsWithFieldOverflow(CheckParameters) Export
	
	CheckParameters.AdditionalParameters.Insert("TempTablesManager", New TempTablesManager);
	
	Query = New Query;
	Query.TempTablesManager = CheckParameters.AdditionalParameters.TempTablesManager;
	QueryText = "
	|SELECT DISTINCT
	|	T.Organization AS Organization,
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.Lot AS Lot,
	|	T.VATActivityType AS VATActivityType
	|
	|INTO TTAnalyticsWithFieldOverflow
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN(&CompanyArray)
	|	AND T.CalculationOfCost
	|	AND T.CalculationIsNotCompleted
	|	AND NOT T.Recorder REFS Document.RegisterAdjustment
	|	AND T.Active
