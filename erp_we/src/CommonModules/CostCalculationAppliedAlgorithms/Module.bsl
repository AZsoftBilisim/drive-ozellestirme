	EndIf;
	
	QueryTexts = New Array;
	QueryTexts.Add(TextOfOrganizationToCalculateCost());
	QueryTexts.Add(QueryTextRecyclableWaste());
	QueryTexts.Add(
	"SELECT
	|	ProductsSold.CompanyOwner,
	|	ProductsSold.SellerInventoryOwnerAttribute,
	|	ProductsSold.ItemsLocationAttributes,
	|	ProductsSold.CountBalance
	|INTO ToTransferAtBeginningOfPeriod
	|FROM
	|	AccumulationRegister.CompanyGoodsForTransfer.Balance(&BorderEndOfPreviousPeriod,
	|		CompanyOwner IN (&CompanyArray)
	|	) AS ProductsSold
	|INDEX BY
	|	SellerInventoryOwnerAttribute
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	ProductsSold.CompanyOwner,
	|	ProductsSold.SellerInventoryOwnerAttribute,
	|	ProductsSold.ItemsLocationAttributes,
	|	ProductsSold.CountBalance
	|INTO GoodsPreliminary
	|FROM
	|	AccumulationRegister.CompanyGoodsForTransfer.Balance(&BorderEndOfPeriod,
	|		CompanyOwner IN (&CompanyArray)
	|	) AS ProductsSold
	|INDEX BY
	|	SellerInventoryOwnerAttribute
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	ProductsSold.CompanyOwner            	  AS CompanyCustomer,
	|	InventoryKinds.Organization 					   	  AS CompanyRecipient,
	|	ProductsSold.ItemsLocationAttributes     	  AS ItemsLocationAttributes,
	|	SUM(ProductsSold.CountBalance
	|	- ISNULL(AsOfThePeriodStart.CountBalance, 0)) AS Count,
	|	InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner				   	  AS SellerInventoryOwnerAttribute,
	|	InventoryKinds.Ref							   	  AS RecipientInventoryOwnerAttribute
	|INTO Goods
	|FROM
	|	GoodsPreliminary AS ProductsSold
	|	INNER JOIN Catalog.InventoryKinds AS InventoryKinds
	|		ON ProductsSold.SellerInventoryOwnerAttribute = InventoryKinds.Ref
	|	LEFT JOIN ToTransferAtBeginningOfPeriod AS AsOfThePeriodStart
	|		ON AsOfThePeriodStart.CompanyOwner = ProductsSold.CompanyOwner
	|		AND AsOfThePeriodStart.SellerInventoryOwnerAttribute = ProductsSold.SellerInventoryOwnerAttribute
	|		AND AsOfThePeriodStart.ItemsLocationAttributes = ProductsSold.ItemsLocationAttributes
	|		AND AsOfThePeriodStart.ItemsLocationAttributes = ProductsSold.ItemsLocationAttributes
	|WHERE
	|	InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.OwnGoods)
	|	AND (ProductsSold.CountBalance - ISNULL(AsOfThePeriodStart.CountBalance, 0) <> 0)
	|
	|GROUP BY
	|	ProductsSold.CompanyOwner,
	|	InventoryKinds.Organization,
	|	ProductsSold.ItemsLocationAttributes,
	|	InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner,
	|	InventoryKinds.Ref
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP GoodsPreliminary
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Expense) AS RecordType,
	|	Goods.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	Goods.CompanyCustomer AS Organization,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock) AS AccountingSection,
	|	Goods.SellerInventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	Goods.Count AS Count
	|INTO TTNoTransfersOfGoods
	|FROM
	|	Goods AS Goods
	|
	|UNION ALL
	|
	|SELECT
	|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
	|	Goods.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	Goods.CompanyRecipient AS Organization,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock) AS AccountingSection,
	|	Goods.RecipientInventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	Goods.Count AS Count
	|FROM
	|	Goods AS Goods
	|
	|INDEX BY
	|	ItemsLocationAttributes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	WrittenOffGoods.InventoryOwnerAttribute,
	|	WrittenOffGoods.ItemsLocationAttributes,
	|	WrittenOffGoods.QuantityConsumedBalance
	|INTO TTNoReportsOnDebitsPreliminary
	|FROM
	|	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.Balance(&BorderEndOfPeriod) AS WrittenOffGoods
	|INDEX BY
	|	InventoryOwnerAttribute
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	InventoryKinds.Organization 						AS Organization,
	|	InventoryKinds.GoodsOwner 						AS Owner,
	|	WrittenOffGoods.ItemsLocationAttributes 		AS ItemsLocationAttributes,
	|	SUM(WrittenOffGoods.QuantityConsumedBalance) AS Count,
	|	InventoryKinds.Ref								AS InventoryOwnerAttribute
	|INTO TTNoReportsOnDebits
	|FROM
	|	TTNoReportsOnDebitsPreliminary AS WrittenOffGoods
	|	INNER JOIN Catalog.InventoryKinds AS InventoryKinds
	|		ON WrittenOffGoods.InventoryOwnerAttribute = InventoryKinds.Ref
	|WHERE
	|	InventoryKinds.Organization IN (&CompanyArray)
	|
	|GROUP BY
	|	InventoryKinds.Organization,
	|	InventoryKinds.GoodsOwner,
	|	WrittenOffGoods.ItemsLocationAttributes,
	|	InventoryKinds.Ref
	|
	|INDEX BY
	|	ItemsLocationAttributes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTNoReportsOnDebitsPreliminary
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	Balance.Organization 		AS Organization,
	|	Balance.Products 		AS Products,
	|	Balance.Characteristic 		AS Characteristic,
	|	Balance.Series 				AS Series,
	|	Balance.Purpose 			AS Purpose,
	|	Balance.Department 		AS Department,
	|	Balance.CountBalance 	AS Count
	|INTO TTOperationBalance
	|FROM
	|	AccumulationRegister.MaterialsAndWorksInProduction.Balance(&BorderEndOfPeriod,
	|		Organization IN (&CompanyArray)) AS Balance
	|WHERE
	|	NOT &BatchAccountingVersion22
	|	AND Balance.CountBalance < 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	Balance.Organization 	AS Organization,
	|	Dimension.DimensionKey AS ItemsLocationAttributes,
	|	Balance.Count 		AS Count
	|INTO TTOperation
	|FROM
	|	TTOperationBalance AS Balance
	|	INNER JOIN InformationRegister.ItemsLocationAttributes AS Dimension
	|		ON Dimension.Products = Balance.Products
	|		AND Dimension.Characteristic = Balance.Characteristic
	|		AND Dimension.Series = Balance.Series
	|		AND Dimension.Purpose = Balance.Purpose
	|		AND Dimension.StorageLocation = Balance.Department
	|		AND Dimension.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|	INNER JOIN Catalog.Products AS CatProducts
	|		ON Balance.Products = CatProducts.Ref
	|WHERE
	|	CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|
	|INDEX BY
	|	ItemsLocationAttributes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTOperationBalance
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Organization,
	|	T.ItemsLocationAttributes,
	|	T.CountBalance
	|INTO InventoryCostBalance
	|FROM
	|	AccumulationRegister.InventoryCost.Balance(&BorderEndOfPeriod,
	|		Organization IN (&CompanyArray)) AS T
	|WHERE
	|	T.ItemsLocationAttributes.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|
	|INDEX BY
	|	ItemsLocationAttributes,
	|	AccountingSection,
	|	InventoryOwnerAttribute,
	|	Organization
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	Tab.AccountingSection		  			AS AccountingSection,
	|	Tab.InventoryOwnerAttribute		  			AS InventoryOwnerAttribute,
	|	Tab.Organization		  			AS Organization,
	|	Tab.ItemsLocationAttributes 	AS ItemsLocationAttributes,
	|	SUM(Tab.Count) 			AS Count
	|INTO TTNegativeBalances
	|FROM (
	|	SELECT
	|		T.AccountingSection 				 AS AccountingSection,
	|		CASE
	|			WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			 AND T.ItemsLocationAttributes.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|			 AND T.ItemsLocationAttributes.Products.TracedGoods
	|				THEN T.InventoryOwnerAttribute
	|			WHEN Dimension.StorageType IN(
	|					VALUE(Enum.StorageLocationTypes.Department),
	|					VALUE(Enum.StorageLocationTypes.Partner))
	|				THEN VALUE(Catalog.InventoryKinds.EmptyRef)
	|			ELSE T.InventoryOwnerAttribute
	|		END 						 AS InventoryOwnerAttribute,
	|		T.Organization 				 AS Organization,
	|		T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		T.CountBalance 		 AS Count
	|	FROM
	|		InventoryCostBalance AS T
	|		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	|			ON T.ItemsLocationAttributes = Dimension.Ref
	|		INNER JOIN Catalog.Products AS CatProducts
	|			ON CatProducts.Ref = Dimension.Products
	|		LEFT JOIN RecyclableWaste AS Waste
	|			ON T.ItemsLocationAttributes  = Waste.ItemsLocationAttributes
	|			AND T.AccountingSection 				 = Waste.AccountingSection
	|			AND T.InventoryOwnerAttribute 				 	 = Waste.InventoryOwnerAttribute
	|			AND T.Organization 				 = Waste.Organization
	|	WHERE
	|		NOT T.AccountingSection IN (
	|			VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries),
	|			VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors))
	|		AND Waste.ItemsLocationAttributes IS NULL
	|
	|	UNION ALL
	|
	|	SELECT
	|		T.AccountingSection                AS AccountingSection,
	|		T.InventoryOwnerAttribute                 AS InventoryOwnerAttribute,
	|		T.Organization                AS Organization,
	|		T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
	|				T.Count
	|			ELSE
	|				-T.Count
	|		END                        AS Count
	|	FROM
	|		TTNoTransfersOfGoods AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock) AS AccountingSection,
	|		VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
	|		T.Organization                AS Organization,
	|		T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		T.Count                 AS Count
	|	FROM
	|		TTNoReportsOnDebits AS T
	|
	|	UNION ALL
	|
	|	SELECT
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts) AS AccountingSection,
	|		VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
	|		T.Organization                AS Organization,
	|		T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		-T.Count                AS Count
	|	FROM
	|		TTOperation AS T
	|
	|	) AS Tab
	|
	|GROUP BY
	|	Tab.AccountingSection,
	|	Tab.InventoryOwnerAttribute,
	|	Tab.Organization,
	|	Tab.ItemsLocationAttributes
	|
	|HAVING
	|	SUM(Tab.Count) < 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	Tab.Organization AS Organization,
	|	Tab.ItemsLocationAttributes,
	|	SUM(Tab.Count) AS Count
	|INTO TTNotIssuedReceiptOfWorks
	|FROM
	|	TTOperation AS Tab
	|
	|GROUP BY
	|	Tab.Organization,
	|	Tab.ItemsLocationAttributes
	|");
	
