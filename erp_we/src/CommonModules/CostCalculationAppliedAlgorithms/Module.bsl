#Region ReflectionInAccounting_

// Initialize the reflection parameters in accounting.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//  PresentationOfAccountingType - String - Presentation of the accounting type
//  MethodName - String - Method name
//  TempTableName - String - name of the temporary table
//  TableOfValuesIsAcceptable - Boolean - A table of values is allowed as a method parameter
//  KeyFields - String - records with the same values of such fields should fall into one portion
// 
// Returns:
//  Structure - Accounting Reflection Parameters:
// * PresentationOfAccountingType - String -
// * MethodName - String -
// * TempTableName - String -
// * TableOfValuesIsAcceptable - Boolean -
// * KeyFields - String -
// * JobsCount - Number -
Function InitializeReflectionParametersInAccounting(CalculationParameters, PresentationOfAccountingType, MethodName,
			TempTableName, TableOfValuesIsAcceptable = True, KeyFields = "") Export
	
	AccountingReflectionParameters = New Structure;
	AccountingReflectionParameters.Insert("PresentationOfAccountingType", 	PresentationOfAccountingType);
	AccountingReflectionParameters.Insert("MethodName", 		  			MethodName);
	AccountingReflectionParameters.Insert("TempTableName",		TempTableName);
	AccountingReflectionParameters.Insert("TableOfValuesIsAcceptable",	TableOfValuesIsAcceptable); // the transfer of the W manager is allowed for all methods
	AccountingReflectionParameters.Insert("KeyFields",				KeyFields); // records with the same values of these fields should fall into one portion
	AccountingReflectionParameters.Insert("JobsCount", 			MaximumNumberOfTasksReflectedInAccounting(CalculationParameters));
	
	Return AccountingReflectionParameters;
	
EndFunction

// Reflect the documents in the accounting.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//  AccountingReflectionParameters - See CostCalculationAppliedAlgorithms.InitializeReflectionParametersInAccounting
Procedure ReflectDocumentsInAccounting(CalculationParameters, AccountingReflectionParameters) Export
	
	DataVolume_ = TemporaryTableSize(CalculationParameters, AccountingReflectionParameters.TempTableName);
	
	If DataVolume_ = 0 Then
		Return;
	EndIf;
	
	ExistingTT = GetListOfExistingTemporaryTables(CalculationParameters);
	
	TableColumns1 = TemporaryTableColumns(CalculationParameters, AccountingReflectionParameters.TempTableName, True);
	TableColumns1 = StringFunctionsClientServer.SubstituteParametersToString(TableColumns1, "T.");
	
	AccountingReflectionParameters.Insert("TableColumns1", TableColumns1);
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "ReflectDocumentsInAccounting", AccountingReflectionParameters.PresentationOfAccountingType);
	
	If AccountingReflectionParameters.JobsCount < 2 Or DataVolume_ < AccountingReflectionParameters.JobsCount Then
		
		ParametersArray = New Array;
		ParametersArray.Add(Query.TempTablesManager);
		
		Try
			Common.ExecuteConfigurationMethod(AccountingReflectionParameters.MethodName, ParametersArray);
		Except
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("ru = 'При выполнении отражения документов в учете произошла ошибка:
					|%1';
					|vi = 'An error occurred when recording documents in accounting:
					|%1';
					|en = 'An error occurred when recording documents in accounting:
					|%1'; fa = 'An error occurred when recording documents in accounting:
					|%1';
					|it = 'An error occurred when recording documents in accounting:
					|%1';
					|pl = 'An error occurred when recording documents in accounting:
					|%1';
					|tr = 'Belgelerin muhasebeye yansıtılması sırasında hata oluştu:
					|%1'"),
				DetailErrorDescription(ErrorInfo()));
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
				ProtocolText_);
			
			Raise ProtocolText_;
			
		EndTry;
		
	Else
		
		CalculationParameters.TableOfAccountingTasks.Clear();
		
		// Let's divide the temporary table into portions. We will process the first portion in the main stream, the rest in background tasks.
		If ValueIsFilled(AccountingReflectionParameters.KeyFields) Then
			
			Query.Text =
			"SELECT DISTINCT
			|	&KeyFields
			|INTO TableOfReflectionInAccountingIsCollapsed
			|FROM
			|	TableName
			|INDEX BY
			|	&KeyFields";
			
			Query.Text = StrReplace(Query.Text, "&KeyFields", AccountingReflectionParameters.KeyFields);
			Query.Text = StrReplace(Query.Text, "TableName", AccountingReflectionParameters.TempTableName);
			
			Query.Execute();
			
			PortionSize = Int(TemporaryTableSize(CalculationParameters, "TableOfReflectionInAccountingIsCollapsed")/(AccountingReflectionParameters.JobsCount + 1)) + 1;
			
			SeparationParameters = CostCalculationAppliedAlgorithms.GenerateParametersForSplittingTemporaryTableIntoPortions(PortionSize,,,, AccountingReflectionParameters.KeyFields);
			
			BatchesCount = CostCalculationAppliedAlgorithms.DivideTemporaryTableIntoPortions(
				CalculationParameters,
				SeparationParameters,
				"TableOfReflectionInAccountingIsCollapsed");
			
			FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(AccountingReflectionParameters.KeyFields, ",",, True);
			LinkFieldText = "";
			
			For Each CurField In FieldArray Do
				
				LinkFieldText = LinkFieldText + ?(LinkFieldText = "", "", Chars.LF + "	And ")
					+ "T." + CurField + " = " + "Collapsed." + CurField;
				
			EndDo;
			
			Query.Text =
			"SELECT
			|	Collapsed.PortionNumber,
			|	&TableFields
			|INTO TableOfReflectionInAccountingIsTemporary
			|FROM
			|	TableName AS T
			|	INNER JOIN TableOfReflectionInAccountingIsCollapsed AS Collapsed
			|	ON &LinkFields
			|;
			|DROP TableName
			|;
			|SELECT
			|	*
			|INTO TableName
			|FROM
			|	TableOfReflectionInAccountingIsTemporary AS T
			|;
			|DROP TableOfReflectionInAccountingIsTemporary
			|;
			|DROP TableOfReflectionInAccountingIsCollapsed
			|";
			
			Query.Text = StrReplace(Query.Text, "TableName", AccountingReflectionParameters.TempTableName);
			Query.Text = StrReplace(Query.Text, "&TableFields", TableColumns1);
			Query.Text = StrReplace(Query.Text, "&LinkFields", LinkFieldText);
			
			Query.Execute();
			
		Else
			
			PortionSize = Int(DataVolume_/(AccountingReflectionParameters.JobsCount + 1)) + 1;
			
			SeparationParameters = CostCalculationAppliedAlgorithms.GenerateParametersForSplittingTemporaryTableIntoPortions(PortionSize);
			
			BatchesCount = CostCalculationAppliedAlgorithms.DivideTemporaryTableIntoPortions(
				CalculationParameters,
				SeparationParameters,
				AccountingReflectionParameters.TempTableName);
			
		EndIf;
		
		Query.Text =
		"SELECT
		|	&TableFields
		|FROM
		|	TableName AS T
		|WHERE
		|	T.PortionNumber = &PortionNumber";
		
		Query.Text = StrReplace(Query.Text, "TableName", AccountingReflectionParameters.TempTableName);
		Query.Text = StrReplace(Query.Text, "&TableFields", TableColumns1);
		
		// From the second portion, we will reflect the data in the background tasks
		For PortionNumber = 2 To BatchesCount Do
			
			Query.SetParameter("PortionNumber", PortionNumber);

			DataToReflect = Query.Execute().Unload();
			
			StartTaskOfReflectionInAccounting(CalculationParameters, DataToReflect, AccountingReflectionParameters);
			
		EndDo;
		
		// The data of the first portion will be reflected in the main stream
		Query.Text =
		"SELECT
		|	&TableFields
		|INTO TemporaryDataTableForReflection
		|FROM
		|	TableName AS T
		|WHERE
		|	T.PortionNumber = 1
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|DROP TableName
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|SELECT
		|	&TableFields
		|INTO TableName
		|FROM
		|	TemporaryDataTableForReflection AS T
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|DROP TemporaryDataTableForReflection
		|";

		Query.Text = StrReplace(Query.Text, "TableName", AccountingReflectionParameters.TempTableName);
		Query.Text = StrReplace(Query.Text, "&TableFields", TableColumns1);
		
		Query.Execute();
		
		ParametersArray = New Array;
		ParametersArray.Add(Query.TempTablesManager);
		
		Try
			Common.ExecuteConfigurationMethod(AccountingReflectionParameters.MethodName, ParametersArray);
		Except
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("ru = 'При выполнении отражения документов в учете произошла ошибка:
					|%1';
					|vi = 'An error occurred when recording documents in accounting:
					|%1';
					|en = 'An error occurred when recording documents in accounting:
					|%1'; fa = 'An error occurred when recording documents in accounting:
					|%1';
					|it = 'An error occurred when recording documents in accounting:
					|%1';
					|pl = 'An error occurred when recording documents in accounting:
					|%1';
					|tr = 'Belgelerin muhasebeye yansıtılması sırasında hata oluştu:
					|%1'"),
				DetailErrorDescription(ErrorInfo()));
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
				ProtocolText_);
			
			Raise ProtocolText_;
			
		EndTry;
		
		WaitingForCompletionOfTasksReflectedInAccounting(CalculationParameters, AccountingReflectionParameters);
		
	EndIf;
	
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
	NewTT = GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	
	DestroyTemporaryTables(Query.TempTablesManager, NewTT);
	
EndProcedure

// Official. A method to be reflected in the accounting by a background task.
// 
// Parameters:
//  CalculationID - UUID - ID of the running background task
//  DataStorage - ValueStorage - Data storage for reflection
//  AccountingReflectionParameters - See CostCalculationAppliedAlgorithms.InitializeReflectionParametersInAccounting
Procedure ReflectInAccountingAsBackgroundTask(CalculationID, DataStorage, AccountingReflectionParameters) Export
	
	SetPrivilegedMode(True);
	
	DataToReflect = DataStorage.Get();
	ParametersArray   = New Array;
	
	If Not AccountingReflectionParameters.TableOfValuesIsAcceptable Then

		Query = New Query;
		Query.TempTablesManager = New TempTablesManager;
		
		Query.Text =
		"SELECT
		|	&TableFields
		|INTO TableName
		|FROM
		|	&DataToReflect AS T
		|";
		
		Query.Text = StrReplace(Query.Text, "TableName", AccountingReflectionParameters.TempTableName);
		Query.Text = StrReplace(Query.Text, "&TableFields", AccountingReflectionParameters.TableColumns1);
		
		Query.SetParameter("DataToReflect", DataToReflect);
		
		Query.Execute();
		
		ParametersArray.Add(Query.TempTablesManager);
		
	Else
		
		ParametersArray.Add(DataToReflect);
		
	EndIf;
	
	Common.ExecuteConfigurationMethod(AccountingReflectionParameters.MethodName, ParametersArray);
	
	RegisterRecord = InformationRegisters.LotAccountingDataCache.CreateRecordManager();
	RegisterRecord.CalculationID  = CalculationID;
	RegisterRecord.DataType 			 = Enums.DataTypesInLotAccountingCache.CalculationStatistics;
	RegisterRecord.DataPortionNumber 	 = 0;
	RegisterRecord.VersionNumber 			 = TrimAll(Metadata.Version);
	RegisterRecord.RecordDate			 = CurrentSessionDate();
	RegisterRecord.Comment			 = AccountingReflectionParameters.PresentationOfAccountingType;
	
	RegisterRecord.Write(True);
	
EndProcedure


Procedure StartTaskOfReflectionInAccounting(CalculationParameters, DataToReflect, AccountingReflectionParameters)
	
	CalculationID = New UUID;
	
	TaskHandlerParameters = New Array;
	TaskHandlerParameters.Add(CalculationID);
	TaskHandlerParameters.Add(New ValueStorage(DataToReflect, New Deflation(9)));
	TaskHandlerParameters.Add(AccountingReflectionParameters);
	
	JobKey = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Nhiệm vụ nền số %1 - %2 (%3)';
			|ru = 'ФЗ №%1 - %2 (%3)';
			|en = 'FZ No.%1 - %2 (%3)'; fa = 'FZ No.%1 - %2 (%3)';
			|it = 'FS №%1 - %2 (%3)';
			|pl = 'UF nr%1 - %2 (%3)';
			|tr = 'FY №%1 - %2 (%3)'", Common.DefaultLanguageCode()),
		TrimAll(CalculationParameters.TableOfAccountingTasks.Count() + 1),
		AccountingReflectionParameters.PresentationOfAccountingType,
		TrimAll(CalculationID));
	
	// Let's run the task and remember its ID in the general task table.
	NewJob = MonthEndTransactionsServer.StartSubordinateBackgroundTaskOfCalculationStage(
		CalculationParameters.CalculationIDForClosingMonth,
		"CostCalculationAppliedAlgorithms.ReflectInAccountingAsBackgroundTask",
		TaskHandlerParameters,
		JobKey,
		AccountingReflectionParameters.PresentationOfAccountingType);
	
	TaskDescriptionString = CalculationParameters.TableOfAccountingTasks.Add();
	TaskDescriptionString.JobID = NewJob.UUID;
	TaskDescriptionString.JobKey 		   = JobKey;
	TaskDescriptionString.CalculationID = CalculationID;
	
EndProcedure

Function GetBackgroundTaskForReflectionInAccounting(CalculationParameters, JobNumber)
	
	TableOfAccountingTasks = CalculationParameters.TableOfAccountingTasks; // ValueTable
	JobRow = TableOfAccountingTasks.Get(JobNumber - 1);
	Job 	  = BackgroundJobs.FindByUUID(JobRow.JobID);
	
	If Job = Undefined Then
		Job = New Structure("State, Key, ErrorInfo", Undefined, JobRow.JobKey, Undefined);
	EndIf;
	
	Return Job;
	
EndFunction

Procedure WaitForBackgroundTaskToCompleteReflectionInAccounting(CalculationParameters, JobNumber, AccountingReflectionParameters)
	
	Job = GetBackgroundTaskForReflectionInAccounting(CalculationParameters, JobNumber);
	
	While Job.State = BackgroundJobState.Active Do
		
		Try
			Job.WaitForExecutionCompletion();
		Except
			Job = Undefined;
		EndTry;

		Job = GetBackgroundTaskForReflectionInAccounting(CalculationParameters, JobNumber);
		
	EndDo;
	
	TableOfAccountingTasks = CalculationParameters.TableOfAccountingTasks; // ValueTable
	JobRow = TableOfAccountingTasks.Get(JobNumber - 1);
	
	RegisterRecord = InformationRegisters.LotAccountingDataCache.CreateRecordManager();
	RegisterRecord.CalculationID = JobRow.CalculationID;
	RegisterRecord.DataType 			= Enums.DataTypesInLotAccountingCache.CalculationStatistics;
	RegisterRecord.DataPortionNumber 	= 0;
	RegisterRecord.VersionNumber 			= TrimAll(Metadata.Version);
	
	RegisterRecord.Read();
	
	ExecutedSuccessfully = RegisterRecord.Selected();
	
	ClearWriteDataCache(JobRow.CalculationID);
	
	ProtocolText_ = "";
	
	If Not ExecutedSuccessfully Then // the reflection in the accounting was not fulfilled
		
		// The status of the task is "Completed" or "Canceled".
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Nhiệm vụ nền %1 %2:
			|%3';
			|ru = 'Фоновое задание %1 %2:
			|%3';
			|en = 'Background job %1 %2:
			|%3'; fa = 'Background job %1 %2:
			|%3';
			|it = 'Task in background %1 %2:
			|%3';
			|pl = 'Zadanie w tle %1 %2:
			|%3';
			|tr = 'Arka plan işi %1 %2:
			|%3'", Common.DefaultLanguageCode()),
			"""" + TrimAll(Job.Key) + """",
			?(Job.State = BackgroundJobState.Canceled,
				NStr("vi = 'đã hủy';
					|ru = 'отменено';
					|en = 'canceled'; fa = 'canceled';
					|it = 'annullato';
					|pl = 'anulowano';
					|tr = 'iptal edildi'", Common.DefaultLanguageCode()),
				NStr("vi = 'kết thúc bất thường';
					|ru = 'завершено аварийно';
					|en = 'aborted'; fa = 'aborted';
					|it = 'terminato in modo anomalo';
					|pl = 'zakończone awaryjnie';
					|tr = 'arızalı tamamlandı'", Common.DefaultLanguageCode())),
			?(Job.ErrorInfo = Undefined,
				NStr("vi = '<Không có mô tả lỗi>';
					|ru = '<Нет описания ошибки>';
					|en = '<No error description>'; fa = '<No error description>';
					|it = '<Non c''è una descrizione dell''errore>';
					|pl = '<Brak opisu błędu>';
					|tr = '<Hata ayrıntıları mevcut değil>'", Common.DefaultLanguageCode()),
				DetailErrorDescription(Job.ErrorInfo)));
		
	EndIf;
	
	ProtocolText_ = TrimAll(ProtocolText_);
	
	If ValueIsFilled(ProtocolText_)Then
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
			ProtocolText_);
		
		RegisterCalculationExecutionProblem(
			CalculationParameters,
			,
			AccountingReflectionParameters.PresentationOfAccountingType + ": "
				+ NStr("vi = 'đã tìm thấy lỗi';
						|ru = 'обнаружены ошибки';
						|en = 'errors are found'; fa = 'errors are found';
						|it = 'errori trovati';
						|pl = 'wykryto błędy';
						|tr = 'hatalar bulundu'", Common.DefaultLanguageCode()),
			ProtocolText_);
		
	EndIf;
	
EndProcedure

Procedure WaitingForCompletionOfTasksReflectedInAccounting(CalculationParameters, AccountingReflectionParameters)
	
	For JobNumber = 1 To CalculationParameters.TableOfAccountingTasks.Count() Do
		WaitForBackgroundTaskToCompleteReflectionInAccounting(CalculationParameters, JobNumber, AccountingReflectionParameters);
	EndDo;
	
	CalculationParameters.TableOfAccountingTasks.Clear();
	
EndProcedure

Function MaximumNumberOfTasksReflectedInAccounting(CalculationParameters)
	
	JobsCount =
		?(Common.FileInfobase(),
			1,
			CalculationParameters.FederalLawRestrictions.MaximumNumberOfFederalLawsReflectedInAccounting);
	
	Return JobsCount;
	
EndFunction

