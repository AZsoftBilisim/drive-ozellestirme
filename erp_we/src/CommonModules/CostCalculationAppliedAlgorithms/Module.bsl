// Generates a description of the properties and fields of the register served by the calculation engine.
//
// Returns:
//	Structure -
//
Function GenerateCaseDescription(RegisterMetadata) Export
	
	RegisterDescription = New Structure;
	RegisterDescription.Insert("ThisIsRegisterDescription", 		 True);
	RegisterDescription.Insert("ThisIsDescriptionOfTemporaryTable", False);
	
	RegisterDescription.Insert("RegisterName",          	  RegisterMetadata.Name);
	RegisterDescription.Insert("FullRegisterName",    	  RegisterMetadata.FullName());
	RegisterDescription.Insert("Description",    	  	  RegisterMetadata.Presentation());
	RegisterDescription.Insert("IsAccumulationRegister", 	  Metadata.AccumulationRegisters.Contains(RegisterMetadata));
	RegisterDescription.Insert("ThisIsCostRegister",  (RegisterMetadata = Metadata.AccumulationRegisters.InventoryCost));
	
	RegisterDescription.Insert("ThereIsACompany", 		  RegisterMetadata.Dimensions.Find("Organization") <> Undefined);
	RegisterDescription.Insert("OrganizationRequired_",   RegisterDescription.ThereIsACompany And RegisterMetadata.Dimensions.Organization.DenyIncompleteValues);
	RegisterDescription.Insert("ThereAreAnalyticsPartners",   RegisterMetadata.Dimensions.Find("AccountingDimensionByPartners") <> Undefined);
	
	RegisterDescription.Insert("ThereIsRecordType",		  	  RegisterMetadata.Attributes.Find("EntryType") <> Undefined
															Or RegisterMetadata.Dimensions.Find("EntryType") <> Undefined);
	RegisterDescription.Insert("ThereIsCalculationOfParties",		  RegisterMetadata.Attributes.Find("LotCalculation") <> Undefined);
	RegisterDescription.Insert("ThereIsCostCalculation",  RegisterMetadata.Attributes.Find("CalculationOfCost") <> Undefined);
	RegisterDescription.Insert("ThereIsCalculationNotCompleted",	  RegisterMetadata.Attributes.Find("CalculationIsNotCompleted") <> Undefined);
	
	RegisterDescription.Insert("UseTTCache", 		  True); // when calculating the speed cache/use the remaining VTKASH
	RegisterDescription.Insert("ItIsNecessaryToUpdateCalculatedCache", False); // movements have been formed that have not yet been taken into account in the settlement balances/records
	
	RegisterDescription.Insert("NumberOfDataChunks",   0);  // when calculating the stage, each portion of the formed movements is first formed into separate movements, and at the end of the stage they are all combined
	RegisterDescription.Insert("PortionTableNames",  	  ""); // names of all VT portions of the vtkash type<Register Name>_<The number of portions from 1 to the number of portions given>
	
	RegisterDescription.Insert("SubordinateToRegistrar",	  Not CostCalculationUniversalAlgorithms.IsIndependentInformationRegister(RegisterMetadata));
	RegisterDescription.Insert("PeriodicRegister_",	  CostCalculationUniversalAlgorithms.ThisIsPeriodicInformationRegister(RegisterMetadata));
	
	If RegisterDescription.IsAccumulationRegister Then
		RegisterManager = AccumulationRegisters[RegisterDescription.RegisterName];
	Else
		RegisterManager = InformationRegisters[RegisterDescription.RegisterName];
	EndIf;
	
	RegisterDescription.Insert("RegisterMetadata", 	  RegisterMetadata);
	RegisterDescription.Insert("RegisterManager", 		  RegisterManager);
	RegisterDescription.Insert("ThereIsPropertyTypeOfMovement",
		RegisterDescription.IsAccumulationRegister And RegisterMetadata.RegisterType = Metadata.ObjectProperties.AccumulationRegisterType.Balance);
	RegisterDescription.Insert("Periodic3",
		Not RegisterDescription.IsAccumulationRegister And RegisterMetadata.InformationRegisterPeriodicity = Metadata.ObjectProperties.InformationRegisterPeriodicity.Month);
	RegisterDescription.Insert("ThereIsSliceOfLatter",
		Not RegisterDescription.IsAccumulationRegister And RegisterDescription.Periodic3 And RegisterMetadata.EnableTotalsSliceLast);
		
	RegisterDescription.Insert("ThereIsChangedData", False); // have the register data changed after the calculation
	RegisterDescription.Insert("RegisterIsWritten", 	  False); // has the register been recorded
	
	RequiredFields = New Structure;
	UntypedFields = New Structure;
	
#Region RegistrarsWithDifferentPeriodsOrOrganizationsInRegisteredRecords

	// In the configuration there are documents, which can make movements on the register (and/or)
	//	- in different analysis periods (required primary + design)
	//	- according to various organisations (any movement)
	// For such documents in the calculation it is necessary to preserve not only the primary movement in the calculation period,
	// but all (primary + design) movements in other periods and organizations.
	
	RegisterDescription.Insert("RegistrarsWithDifferentPeriodsOrOrganizationsInRegisteredRecords", New Map);
	
	DocumentsWithSavedRegisteredRecords = DocumentsWithDifferentPeriodsOrOrganizationsInRegisteredRecords(True, True, RegisterDescription.RegisterName);
	
	For Each KeyAndValue In DocumentsWithSavedRegisteredRecords Do
		If KeyAndValue.Key.RegisterRecords.Contains(RegisterMetadata) Then
			RegisterDescription.RegistrarsWithDifferentPeriodsOrOrganizationsInRegisteredRecords.Insert(KeyAndValue.Key, KeyAndValue.Value);
		EndIf;
	EndDo;
	
#EndRegion

#Region AllRegisterRegistrars
	
	RegisterDescription.Insert("AllRegistrars", New Map);
	
	For Each MetaDoc In Metadata.Documents Do
		If MetaDoc.RegisterRecords.Contains(RegisterMetadata) Then
			RegisterDescription.AllRegistrars.Insert(MetaDoc.Name);
		EndIf;
	EndDo;
	
#EndRegion

#Region Table

	// Table for accumulation of generated movements
	RegisterSet = RegisterManager.CreateRecordSet(); // AccumulationRegisterRecordSet.InventoryCost - or any other serviced register 
	RegisterDescription.Insert("Table", RegisterSet.UnloadColumns());
	
	// The column "Registrar" will be placed in the first place
	If RegisterDescription.SubordinateToRegistrar Then
		
		ColumnLogger = RegisterDescription.Table.Columns.Find("Recorder");
		RegisterDescription.Table.Columns.Move(
			ColumnLogger,
			-RegisterDescription.Table.Columns.IndexOf(ColumnLogger));
		
	EndIf;
	
	// For the residual accumulation registers, we will create a service column of Service Movement entry.
	// In it we will store a Boolean representation of the type of movement (bypassing Platform error 30025997).
	If RegisterDescription.ThereIsPropertyTypeOfMovement Then
		RegisterDescription.Table.Columns.Insert(0, "OfficialTypeOfMovementParish",	New TypeDescription("Boolean"));
	EndIf;
	
#EndRegion
	
#Region RegisterFields

	// A list of all register fields, with the exception of "technogenic"
	// , Before the name of each field are the characters "%1" - for automatic substitution of table names in queries.
	FieldsOfMainRegisterTable = ""; // here is the "View Movement" field
	RegisterCacheFields  			= ""; // here is the field "Service Movement Entry"
	RegisterCacheFieldsAreTyped = ""; // here the numeric fields are typed
	IgnoredFields  			= New Structure("LineNumber, Active, PointInTime, RecordType");
	
	For Each Column In RegisterDescription.Table.Columns Do
		If Column.Name = "OfficialTypeOfMovementParish" Then
			FieldsOfMainRegisterTable = FieldsOfMainRegisterTable
				+ ?(FieldsOfMainRegisterTable = "", "", ", ") + "%1" + "RecordType";
			RegisterCacheFields = RegisterCacheFields
				+ ?(RegisterCacheFields = "", "", ", ") + "%1" + "OfficialTypeOfMovementParish";
			RegisterCacheFieldsAreTyped = RegisterCacheFieldsAreTyped
				+ ?(RegisterCacheFieldsAreTyped = "", "", ", ") + "%1" + "OfficialTypeOfMovementParish";
		ElsIf Not IgnoredFields.Property(Column.Name) Then
			FieldsOfMainRegisterTable = FieldsOfMainRegisterTable
				+ ?(FieldsOfMainRegisterTable = "", "", ", ") + "%1" + Column.Name;
			RegisterCacheFields = RegisterCacheFields
				+ ?(RegisterCacheFields = "", "", ", ") + "%1" + Column.Name;
			
			If Column.ValueType.NumberQualifiers.Digits > 0 Then
				
				NumberType = New TypeDescription("Number", Column.ValueType.NumberQualifiers);
				MaxValue = NumberType.AdjustValue(Pow(10, 40));
				
				TextMaximumValue = Format(MaxValue, "NDS=.; NZ=0; NG=");
				TextColumn = "CASE WHEN %1" + Column.Name + " > " + TextMaximumValue
					+ " THEN " + TextMaximumValue + " WHEN %1" + Column.Name + " < -" + TextMaximumValue
					+ " THEN -" + TextMaximumValue + " ELSE %1" + Column.Name + " END";
				
				RegisterCacheFieldsAreTyped = RegisterCacheFieldsAreTyped
					+ ?(RegisterCacheFieldsAreTyped = "", "", ", ") + "CAST(" + TextColumn + " AS NUMBER("
					+ TrimAll(Column.ValueType.NumberQualifiers.Digits) + ","
					+ TrimAll(Column.ValueType.NumberQualifiers.FractionDigits) + ")) AS " + Column.Name;
				
			Else
				RegisterCacheFieldsAreTyped = RegisterCacheFieldsAreTyped
					+ ?(RegisterCacheFieldsAreTyped = "", "", ", ") + "%1" + Column.Name;
			EndIf;
			
		EndIf;
	EndDo;
	
	RegisterDescription.Insert("FieldsOfMainRegisterTable",	FieldsOfMainRegisterTable);
	RegisterDescription.Insert("RegisterCacheFields",				RegisterCacheFields);
	RegisterDescription.Insert("RegisterCacheFieldsAreTyped",	RegisterCacheFieldsAreTyped);
	
#EndRegion

