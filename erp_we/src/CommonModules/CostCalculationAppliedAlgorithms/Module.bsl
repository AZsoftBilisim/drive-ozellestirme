// Before starting the calculation, it fills in all the necessary parameters and initializes all data structures used by the calculation algorithm.
// Note: if an entity is used in more than one calculation step, it should be entered in the calculation Parameters.
//
Procedure InitializeBatchCalculationParameters(StartupParameters, CalculationParameters, DebugParameters = Undefined) Export
	
	// Let's create a container of all parameters used by the batch calculation mechanism
	InitializationParameters = New Structure;
	InitializationParameters.Insert("Date", 									 StartupParameters.Date);
	If StartupParameters.Property("BeginOfPeriod") Then
		InitializationParameters.Insert("BeginOfPeriod", 						 StartupParameters.BeginOfPeriod);
		InitializationParameters.Insert("EndOfPeriod", 						 StartupParameters.EndOfPeriod);
	Else
		InitializationParameters.Insert("BeginOfPeriod", 						 BegOfMonth(StartupParameters.Date));
		InitializationParameters.Insert("EndOfPeriod", 						 EndOfMonth(StartupParameters.Date));
	EndIf;
	InitializationParameters.Insert("CompanyArray",   						 StartupParameters.CompanyArray);
	InitializationParameters.Insert("BatchCalculationStarted", 						 True);
	If StartupParameters.Property("OnlyPreliminaryCostCalculation") Then
		InitializationParameters.Insert("OnlyPreliminaryCostCalculation", StartupParameters.OnlyPreliminaryCostCalculation);
	Else
		InitializationParameters.Insert("OnlyPreliminaryCostCalculation", False);
	EndIf;
	If StartupParameters.Property("StartedByRoutineTask") Then
		InitializationParameters.Insert("StartedByRoutineTask", StartupParameters.StartedByRoutineTask);
	Else
		InitializationParameters.Insert("StartedByRoutineTask", False);
	EndIf;
	
	If StartupParameters.Property("DocumentsChanged") Then
		InitializationParameters.Insert("DocumentsChanged",   				 StartupParameters.DocumentsChanged);
	Else
		InitializationParameters.Insert("DocumentsChanged",   				 Undefined);
	EndIf;
	
	If StartupParameters.Property("DecodingDistribution") Then
		InitializationParameters.Insert("DecodingDistribution", 			 StartupParameters.DecodingDistribution);
	EndIf;
	
	If StartupParameters.Property("AutoTesting") And StartupParameters.AutoTesting Then
		InitializationParameters.Insert("AutoTesting", 			 True); // called during testing
	Else
		InitializationParameters.Insert("AutoTesting", 			 False);
	EndIf;
	
	If StartupParameters.Property("PlaceOfCalculationCall") Then
		InitializationParameters.Insert("PlaceOfCalculationCall", 			 		 StartupParameters.PlaceOfCalculationCall);
	EndIf;
	
	If StartupParameters.Property("GettingListOfParameters") Then
		InitializationParameters.Insert("GettingListOfParameters", 			 StartupParameters.GettingListOfParameters);
	EndIf;
	
	If StartupParameters.Property("MonthEndClosingMode") Then
		InitializationParameters.Insert("MonthEndClosingMode", 				StartupParameters.MonthEndClosingMode);
	Else
		InitializationParameters.Insert("MonthEndClosingMode", 				Enums.MonthEndClosingModes.EmptyRef());
	EndIf;
	
	If StartupParameters.Property("TaskNumberBeforeCalculation") Then
		InitializationParameters.Insert("TaskNumberBeforeCalculation", 			 StartupParameters.TaskNumberBeforeCalculation);
	EndIf;
	
	InitializeGeneralCalculationParameters(
		InitializationParameters, CalculationParameters, DebugParameters);
	
EndProcedure


// Before starting the calculation, it fills in all the General parameters used by the calculation algorithm.
//
// Parameters:
// 	InitializationParameters - Structure - LongDesc:
// * AutoTesting - Boolean -
// * DocumentsChanged - Undefined -
// * StartedByRoutineTask - Boolean -
// * OnlyPreliminaryCostCalculation - Boolean -
// * BatchCalculationStarted - Boolean -
// * Date - Date -
// 	CalculationParameters - Structure -
// 	DebugParameters - Undefined - LongDesc
// 	
// Returns:
// 	Structure - LongDesc:
// * IntercampanyGroupsOfOrganizations - Array -
// * OrganizationsWithCostBalances - Array -
