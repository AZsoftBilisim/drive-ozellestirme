// Displays a warning in a tabular document if the month has been pre-closed.
//
// Parameters:
//	ResultDocument   - SpreadsheetDocument - table document of the report that is being checked.
//	SettingsComposer - DataCompositionSettingsComposer - linker for settings for the report that causes validation.
//	CompanyFieldName1  - String - name of the business details field.
//
Procedure AddWarningAboutPreClosingMonth(ResultDocument, SettingsComposer, CompanyFieldName1 = "Organization") Export
	
	ReportPeriodParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "Period");
	ReportPeriod = ReportPeriodParameter.Value; // StandardPeriod
	EndDate		 = ?(ReportPeriodParameter.Use, ReportPeriod.EndDate, CurrentSessionDate());
	
	CompanyArray = OrganizationsToSelectFromReportSettings(SettingsComposer, CompanyFieldName1);
	
	Query = New Query("
	|SELECT ALLOWED TOP 1
	|	TRUE AS PerformedPreliminaryClosing
	|FROM
	|	Document.InventoryCostCalculation AS Calculation
	|WHERE
	|	Calculation.Date BETWEEN &StartDate AND &EndDate
	|	AND Calculation.Posted
	|	AND Calculation.Organization IN (&CompanyArray)
	|	AND Calculation.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|");
	Query.SetParameter("CompanyArray", CompanyArray);
	Query.SetParameter("StartDate",    BegOfMonth(EndDate));
	Query.SetParameter("EndDate", EndOfMonth(EndDate));
	QueryResult = Query.Execute();
	If Not QueryResult.IsEmpty() Then
	
		WarningText = NStr("vi = 'Báo cáo hiển thị kết quả đóng tháng sơ bộ. 
			|Sau khi thực hiện đóng tháng cuối cùng, có thể thay đổi kết quả.';
			|ru = 'В отчет выведены результаты предварительного закрытия месяца. 
			|После выполнения окончательного закрытия месяца результат может измениться.';
