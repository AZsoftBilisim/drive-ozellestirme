#Region BuildingChains

// Building a chain of movements.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//  DataOptimization - Boolean -
//
Procedure BuildChainsOfRegisteredRecords(CalculationParameters, DataOptimization = False) Export
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "Sources", ?(DataOptimization, NStr("vi = 'Sau khi tối ưu hóa';
																													|ru = 'После оптимизации';
																													|en = 'After optimization'; fa = 'After optimization';
																													|it = 'Dopo l''ottimizzazione';
																													|pl = 'Po optymizacji';
																													|tr = 'Optimizasyondan sonra'", Common.DefaultLanguageCode()), ""));
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	If Not DataOptimization Then
		
		// Let's check that the types of records in the description of the chains correspond to the selected data.
		Query.Text =
		"SELECT DISTINCT
		|	T.EntryType 	 AS EntryType,
		|	T.RequestSource AS RequestSource,
		|	T.Organization    AS Organization,
		|	T.Recorder    AS Recorder
		|FROM
		|	Data AS T
		|WHERE
		|	NOT T.EntryType IN (&AcceptableRecordTypes)
		|
		|ORDER BY
		|	EntryType,
		|	RequestSource,
		|	Organization,
		|	Recorder";
		
		AcceptableRecordTypes = TypesOfRecordsUsedInChains(CalculationParameters.DistributionOfParties.DescriptionOfChains,,, False);
		Query.SetParameter("AcceptableRecordTypes", AcceptableRecordTypes);
		
		QueryResult = Query.Execute();
		
		If Not QueryResult.IsEmpty() Then
			
			IssueDetails = NStr("vi = 'Có các loại bản ghi trong dữ liệu đã chọn không có trong mô tả chuỗi.';
								|ru = 'В выбранных данных есть типы записей, отсутствующие в описании цепочек.';
								|en = 'In selected data, there are record types missing in chain description.'; fa = 'In selected data, there are record types missing in chain description.';
								|it = 'Nei dati selezionati ci sono dei tipi di record, mancanti nella descrizione dei percorsi.';
								|pl = 'W wybranych danych są typy zapisów, brakujące w opisie łańcuchów.';
								|tr = 'Seçilen verilerde zincir ayrıntılarında bulunmayan kayıt türleri mevcut'", Common.DefaultLanguageCode());
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
				CostCalculationProtocol.ServiceSymbol_WithoutNumbering() + IssueDetails);
			
			Selection = QueryResult.Select();
			
			While Selection.Next() Do
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Kiểu bản ghi: ""%1"", nguồn: ""%2"", doanh nghiệp ""%3"", nguồn ghi: ""%4""';
						|ru = 'Тип записи: ""%1"", источник: ""%2"", организация ""%3"", регистратор: ""%4""';
						|en = 'Record type:""%1"", source:""%2"", company ""%3"", recorder:""%4""'; fa = 'Record type:""%1"", source:""%2"", company ""%3"", recorder:""%4""';
						|it = 'Tipo del record: ""%1"", fonte: ""%2"", organizzazione ""%3"", registratore: ""%4""';
						|pl = 'Typ zapisu: ""%1"", źródło: ""%2"", firma ""%3"", rejestrator: ""%4""';
						|tr = 'Kayıt tipi: ""%1"", kaynak: ""%2"", iş yeri: ""%3"", kayıt: ""%4""'", Common.DefaultLanguageCode()),
					CostCalculationProtocol.ValuePresentation(Selection.EntryType),
					CostCalculationProtocol.ValuePresentation(Selection.RequestSource),
					CostCalculationProtocol.ValuePresentation(Selection.Organization),
					CostCalculationProtocol.ValuePresentation(Selection.Recorder));
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
					ProtocolText_);
				
				RegisterCalculationExecutionProblem(
					CalculationParameters,
					Selection.Organization,
					NStr("vi = 'Khi tạo các bản ghi kết chuyển theo lô, đã chẩn đoán được lỗi';
						|ru = 'При формировании движений по партиям диагностированы ошибки';
						|en = 'Errors were found when generating lot records'; fa = 'Errors were found when generating lot records';
						|it = 'Durante la creazione dei movimenti sui lotti sono stati diagnosticati degli errori';
						|pl = 'Podczas tworzenia ruchów wg partii wykryto błędy';
						|tr = 'Hareketlerin lotlar halinde oluşturulması sırasında hatalar tespit edildi'", Common.DefaultLanguageCode()),
					IssueDetails + Chars.LF + ProtocolText_,
					Selection.Recorder);
				
			EndDo;
			
		EndIf;
		
		// Let's check that the unreadable record types are not receivers.
		TypesOfReceiverRecords = TypesOfRecordsUsedInChains(CalculationParameters.DistributionOfParties.DescriptionOfChains,, False, False);
		ThereAreNonReadableRecordTypesInReceivers = False;
		
		For Each CurRecordType In TypesOfReceiverRecords Do
			
			If CalculationOfCostCached.ThisIsNonReadableRecordType(CurRecordType) Then
				
				ProtocolText_ = NStr("vi = 'Trong mô tả chuỗi, để làm đích không thể sử dụng kiểu bản ghi chưa tính';
									|ru = 'В описании цепочек в качестве приемников не могут использоваться непересчитываемые типы записей';
									|en = 'Non-recalculated record types cannot be used in the chain description as targets.'; fa = 'Non-recalculated record types cannot be used in the chain description as targets.';
									|it = 'Nella descrizione dei percorsi, i tipi di record non ricalcolabili non possono essere utilizzati come ricevitori';
									|pl = 'W opisie łańcuchów jako odbiorniki nie mogą być wykorzystywane nie przeliczane typy zapisów';
									|tr = 'Zincirlerin ayrıntılarında, kayıt dışı tipler alıcı olarak kullanılamaz'", Common.DefaultLanguageCode());
				
				If Not ThereAreNonReadableRecordTypesInReceivers Then
					CostCalculationProtocol.FixCalculationError(
						CalculationParameters,
						Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
						CostCalculationProtocol.ServiceSymbol_WithoutNumbering() + ProtocolText_);
				EndIf;
				
				ThereAreNonReadableRecordTypesInReceivers = True;
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
					CostCalculationProtocol.ValuePresentation(CurRecordType));
					
				RegisterCalculationExecutionProblem(
					CalculationParameters,
					,
					NStr("vi = 'Khi tạo các bản ghi kết chuyển theo lô, đã chẩn đoán được lỗi';
						|ru = 'При формировании движений по партиям диагностированы ошибки';
						|en = 'Errors were found when generating lot records'; fa = 'Errors were found when generating lot records';
						|it = 'Durante la creazione dei movimenti sui lotti sono stati diagnosticati degli errori';
						|pl = 'Podczas tworzenia ruchów wg partii wykryto błędy';
						|tr = 'Hareketlerin lotlar halinde oluşturulması sırasında hatalar tespit edildi'", Common.DefaultLanguageCode()),
					ProtocolText_ + ": " + CostCalculationProtocol.ValuePresentation(CurRecordType));
				
			EndIf;
			
		EndDo;
		
	Else
		
		DestroyTemporaryTables(CalculationParameters, "Sources, Destinations, NodeLinkStatistics");
		
	EndIf;
	
	HasRecorder = TemporaryTableColumnExists(CalculationParameters, "Data", "Recorder");
	TextForDataProtocol = "";
	TextForCommunicationProtocol = "";
	
	// Let's collect statistics on the types of records in the Data table.
	Query.Text =
	"SELECT
	|	T.EntryType AS EntryType,
	|	&Recorders,
	|	COUNT(*) AS Count
	|FROM
	|	Data AS T
	|
	|GROUP BY
	|	T.EntryType
	|	,&GroupingLoggers
	|
	|ORDER BY
	|	EntryType,
	|	Count DESC";
	
	If HasRecorder Then
		
		Query.Text = StrReplace(Query.Text, "&Recorders,",
			"VALUETYPE(T.Recorder) AS TypeOfRegistrar,");
		
		Query.Text = StrReplace(Query.Text, ",&GroupingLoggers",
			", VALUETYPE(T.Recorder)");
		
	Else
		
		Query.Text = StrReplace(Query.Text, "&Recorders,", "");
		Query.Text = StrReplace(Query.Text, ",&GroupingLoggers", "");
		
	EndIf;
	
	Selection = Query.Execute().Select();

	DataVolume = 0;
	
	While Selection.Next() Do
		
		DataVolume = DataVolume + Selection.Count;
		
		CostCalculationUniversalAlgorithms.SupplementString(
			TextForDataProtocol,
			Chars.LF + "  * "
			+ ?(ValueIsFilled(Selection.EntryType),
				TrimAll(Selection.EntryType),
				"<"	+ NStr("vi = 'Chưa chỉ ra kiểu bản ghi';
								|ru = 'Тип записи не указан';
								|en = 'Entry type is not specified.'; fa = 'Entry type is not specified.';
								|it = 'Tipo di scrittura non è indicata';
								|pl = 'Typ wpisu nie został podany';
								|tr = 'Kayıt tipi belirtilmedi'", Common.DefaultLanguageCode()) + ">")
			+ ?(HasRecorder, " [" + TrimAll(Selection.TypeOfRegistrar) + "]", "")
			+ " - " + Format(Selection.Count, "NG="));
		
	EndDo;

	// Let's form the request text for building chains
	If HasRecorder Then
		MergeQueryTemplate = "
			|SELECT
			|	Destinations.K AS Receiver,
			|	Sources.K AS Source,
			|	VALUETYPE(Sources.Recorder) AS SourceLogger,
			|	VALUETYPE(Destinations.Recorder) AS ReceiverLogger,
			|	&DestinationType AS DestinationType,
			|	&SourceType AS SourceType
			|INTO TTChainJoins
			|FROM
			|	Data AS Destinations
			|	INNER JOIN Data AS Sources
			|		ON &ConnectionConditions
			|WHERE
			|	Destinations.K <> Sources.K
			|	AND Destinations.EntryType = &DestinationType
			|	AND Sources.EntryType = &SourceType
			|	AND NOT Destinations.CalculationIsCompleted
			|";
			
		SampleRequestTemplate = "
			|SELECT
			|	T.SourceLogger AS SourceLogger,
			|	T.ReceiverLogger AS ReceiverLogger,
			|	COUNT(*) AS Count,
			|	T.DestinationType AS DestinationType,
			|	T.SourceType AS SourceType
			|FROM
			|	TTChainJoins AS T
			|
			|GROUP BY
			|	T.SourceLogger,
			|	T.ReceiverLogger,
			|	T.DestinationType,
			|	T.SourceType
			|
			|ORDER BY
			|	Count DESC";
	Else
		MergeQueryTemplate = "
			|SELECT
			|	Destinations.K AS Receiver,
			|	Sources.K AS Source,
			|	&DestinationType AS DestinationType,
			|	&SourceType AS SourceType
			|INTO TTChainJoins
			|FROM
			|	Data AS Destinations
			|	INNER JOIN Data AS Sources
			|		ON &ConnectionConditions
			|WHERE
			|	Destinations.K <> Sources.K
			|	AND Destinations.EntryType = &DestinationType
			|	AND Sources.EntryType = &SourceType
			|	AND NOT Destinations.CalculationIsCompleted
			|";
		
		SampleRequestTemplate = "
			|SELECT
			|	COUNT(*) AS Count,
			|	T.DestinationType AS DestinationType,
			|	T.SourceType AS SourceType
			|FROM
			|	TTChainJoins AS T
			|
			|GROUP BY
			|	T.DestinationType,
			|	T.SourceType
			|
			|ORDER BY
			|	Count DESC";
		
	EndIf;
	
	LinkCount = 0;
	QueryText 	 = "";
	TemporaryTable = New Array;
	TemporaryTable.Add("TTChainJoins"); // @query-part-1
	TableNumber 	 = 0;
	
	ArrayOfQueryTextsForJoin = New Array();

	Query = New Query();
	RequestCounter_ = 0;
	For Each LongDesc In CalculationParameters.DistributionOfParties.DescriptionOfChains Do
		
		DestinationFields = LongDesc.Value.LinkFields;
		If DestinationFields.Count() = 0 Then
			Continue;
		EndIf;
		
		For Each SourceDetails In LongDesc.Value.SourcesTypes Do
			
			SourceFields = SourceDetails.Value;
			If SourceFields.Count() = 0 Then
				Continue;
			EndIf;
			
			FieldNumber = -1;
			For Each DestinationField In DestinationFields Do
				FieldNumber = FieldNumber + 1;
				If FieldNumber = 0 Then
					ConnectionConditions = "Destinations." + DestinationField + " = " + "Sources." + SourceFields[FieldNumber]; // @query-part-1
				Else
					ConnectionConditions = ConnectionConditions + Chars.LF + " AND " + "Destinations." + DestinationField + " = " + "Sources." + SourceFields[FieldNumber]; // @query-part-1
				EndIf;
			EndDo;
			
			TableNumber = TableNumber + 1;
			QueryText = StrReplace(MergeQueryTemplate, "&ConnectionConditions", ConnectionConditions); // @query-part-1
			ConditionReceiverType = "DestinationType_" + RequestCounter_; // @query-part-1
			ConditionSourceType = "SourceType_" + RequestCounter_; // @query-part-1
			QueryText = StrReplace(QueryText, "&DestinationType", "&" + ConditionReceiverType); // @query-part-1
			QueryText = StrReplace(QueryText, "&SourceType", "&" + ConditionSourceType); // @query-part-1
			Query.SetParameter(ConditionReceiverType, LongDesc.Key);
			Query.SetParameter(ConditionSourceType, SourceDetails.Key);
			
			ArrayOfQueryTextsForJoin.Add(QueryText);
			RequestCounter_ = RequestCounter_ + 1;
			If RequestCounter_ = 1 Then
				MergeQueryTemplate = StrReplace(MergeQueryTemplate, "INTO TTChainJoins", ""); // @query-part-1
			EndIf;
	
		EndDo;
		
	EndDo;
	
	QueryText = StrConcat(ArrayOfQueryTextsForJoin, Common.UnionAllText());
	Query.Text = QueryText + ";
		|" + SampleRequestTemplate;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;	
	TextsForCommunicationProtocol = New Array;
	Selection = Query.Execute().Select();
	While Selection.Next() Do
			
		If Selection.Count > 0 Then
			
			If HasRecorder Then
				CurrentTextOfCommunicationProtocol = StrTemplate("  * %1 [%2] -> %3 [%4]: %5",
					Selection.SourceType, Selection.SourceLogger,
					Selection.DestinationType, Selection.ReceiverLogger, Selection.Count);
			Else
				CurrentTextOfCommunicationProtocol = StrTemplate("  * %1 -> %2: %3",
					Selection.SourceType,
					Selection.DestinationType, Selection.Count);
			EndIf;
			
			TextsForCommunicationProtocol.Add(CurrentTextOfCommunicationProtocol);
			LinkCount = LinkCount + Selection.Count;
			
		EndIf;
		
	EndDo;
	
	TextForCommunicationProtocol = StrConcat(TextsForCommunicationProtocol, Chars.LF);

	If DataVolume > 0 Then
		
		DetailsText = NStr("vi = 'Mô tả cấu trúc dữ liệu để thanh toán %1';
							|ru = 'Описание структуры данных для расчета%1';
							|en = 'Details of data structure for calculation%1'; fa = 'Details of data structure for calculation%1';
							|it = 'Descrizione della struttura dati per il calcolo%1';
							|pl = 'Opis struktury danych do obliczenia%1';
							|tr = 'Hesaplama için veri yapısının ayrıntıları%1'", Common.DefaultLanguageCode()) + ":" + Chars.LF
			+ NStr("vi = 'Tổng số dữ liệu: %2%3';
					|ru = 'Всего данных: %2%3';
					|en = 'Total data: %2%3'; fa = 'Total data: %2%3';
					|it = 'Totale dati:%2%3';
					|pl = 'Łącznie danych: %2%3';
					|tr = 'Toplam veriler: %2%3'", Common.DefaultLanguageCode()) + Chars.LF
			+ NStr("vi = 'Tổng số liên kết: %4%5';
					|ru = 'Всего связей: %4%5';
					|en = 'Total links: %4%5'; fa = 'Total links: %4%5';
					|it = 'Totale collegamenti: %4%5';
					|pl = 'Łącznie powiązań: %4%5';
					|tr = 'Toplam bağlantılar: %4%5'", Common.DefaultLanguageCode());
		
		DetailsText = StringFunctionsClientServer.SubstituteParametersToString(
			DetailsText,
			?(DataOptimization, " (" + NStr("vi = 'sau khi tối ưu hóa';
											|ru = 'после оптимизации';
											|en = 'after optimizing'; fa = 'after optimizing';
											|it = 'dopo l''ottimizzazione';
											|pl = 'po optymizacji';
											|tr = 'optimizasyondan sonra'", Common.DefaultLanguageCode()) + ")", ""),
			TrimAll(DataVolume),
			?(DataVolume > 0, ", " + NStr("vi = 'trong đó';
											|ru = 'в том числе';
											|en = 'including'; fa = 'شامل';
											|it = 'inclusi';
											|pl = 'w tym';
											|tr = 'aynı zamanda'", Common.DefaultLanguageCode()) + ":" + Chars.LF + TextForDataProtocol, ""),
			TrimAll(LinkCount),
			?(LinkCount > 0, ", " + NStr("vi = 'trong đó';
										|ru = 'в том числе';
										|en = 'including'; fa = 'شامل';
										|it = 'inclusi';
										|pl = 'w tym';
										|tr = 'aynı zamanda'", Common.DefaultLanguageCode()) + ":" + Chars.LF + TextForCommunicationProtocol, ""));
		
		CostCalculationProtocol.AdditionalInformation(CalculationParameters, DetailsText, DetailsText);
		
	EndIf;
	
	QueryText = "
	|SELECT TOP 0
	|	-1 AS Receiver,
	|	-1 AS Source
	|INTO Chains
	|
	|UNION ALL
	|
	|SELECT
	|	DD.Receiver,
	|	DD.Source
	|FROM
	|	TTChainJoins AS DD
	|";
	
	For Each TableName In TemporaryTable Do
		QueryText = QueryText + "; DROP " + TableName;
	EndDo;
	
	// We will execute the prepared request.
	Query.Text = QueryText;
	Query.Execute();
	
	// Let's split the temporary table of the Chain into tables of sources and receivers for each node.
	// Additional fields. The orderings for the FIFO (Period and Registrar) are not filled in yet - they will be filled in when optimizing the chains.
	Query.Text =
	"SELECT DISTINCT
	|	DD.Receiver AS Key,
	|	DD.Source AS Source,
	|	0 			AS Order
	|INTO Sources
	|FROM
	|	Chains AS DD
	|INDEX BY
	|	Key
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	DD.Source AS Key,
	|	DD.Receiver AS Receiver,
	|	0 			AS Order
	|INTO Destinations
	|FROM
	|	Chains AS DD
	|INDEX BY
	|	Key
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Chains
	|";
	
	Query.Execute();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
	
	If Not DataOptimization Then
		OptimizeDataInChains(CalculationParameters);
		OptimizeNumberingInChains(CalculationParameters);
	EndIf;
	
	DestroyTemporaryTables(CalculationParameters, "NodeLinkStatistics");
	
	Query.Text =
	"SELECT
	|	T.Key AS Key,
	|	SUM(T.NumberOfSources) AS NumberOfSources,
	|	SUM(T.NumberOfReceivers) AS NumberOfReceivers,
	|	SUM(T.NumberOfSources + T.NumberOfReceivers) AS LinkCount
	|INTO NodeLinkStatistics
	|FROM
	|	(SELECT
	|		T.K AS Key,
	|		CAST(0 AS NUMBER(10,0)) AS NumberOfSources,
	|		CAST(0 AS NUMBER(10,0)) AS NumberOfReceivers
	|	FROM
	|		Data AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Key AS Key,
	|		SUM(CAST(1 AS NUMBER(10,0))),
	|		0
	|	FROM
	|		Sources AS T
	|	
	|	GROUP BY
	|		T.Key
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Key,
	|		0,
	|		SUM(CAST(1 AS NUMBER(10,0)))
	|	FROM
	|		Destinations AS T
	|	
	|	GROUP BY
	|		T.Key) AS T
	|
	|GROUP BY
	|	T.Key
	|INDEX BY
	|	T.Key";
	
	Query.Execute();
	
	If Not DataOptimization Then
		CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "BuildChainsOfRegisteredRecords");
	EndIf;
	
EndProcedure

// Optimizes the data in the chains.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//
Procedure OptimizeDataInChains(CalculationParameters)
	
	If CalculationParameters.Debug.DoNotPerformDataOptimization Then
		Return;
	EndIf;
		
	DataTableSize = TemporaryTableSize(CalculationParameters, "Data");
	
	If DataTableSize = 0 Then
		Return;
	EndIf;
	
	RegisterRecordsDetails = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	
	DoNotPerformOptimization =
		Not RegisterRecordsDetails.Property("DeleteLinesWithoutReceivers")
		And Not RegisterRecordsDetails.Property("DeleteRowsWithoutSources");
	
	FormAlreadyKnownSettlementParties(CalculationParameters, DoNotPerformOptimization);
	
	If DoNotPerformOptimization Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartCreatingTemporaryTable(
		CalculationParameters,
		"Data",
		NStr("vi = 'Tối ưu hóa dữ liệu nguồn';
			|ru = 'Оптимизация исходных данных';
			|en = 'Source data optimization'; fa = 'Source data optimization';
			|it = 'Ottimizzazione dei dati di origine';
			|pl = 'Optymizacja danych wyjściowych';
			|tr = 'Giden verilerinin optimizasyonu'", Common.DefaultLanguageCode()));
	
	TableSizeData    = TemporaryTableSize(CalculationParameters, "Data");
	TableSizeSources = TemporaryTableSize(CalculationParameters, "Sources");
	
	ExistingTT = GetListOfExistingTemporaryTables(CalculationParameters);
	
	Query = New Query;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;
	
	Query.Text =
	"SELECT
	|	T.K AS K
	|INTO DeletedSingleNodes
	|FROM
	|(SELECT
	|	T.K,
	|	FALSE AS ThereAreSources,
	|	FALSE AS ThereAreReceivers
	|FROM
	|	Data AS T
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	T.Key AS K,
	|	TRUE AS ThereAreSources,
	|	FALSE AS ThereAreReceivers
	|FROM
	|	Sources AS T
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	T.Key AS K,
	|	FALSE AS ThereAreSources,
	|	TRUE AS ThereAreReceivers
	|FROM
	|	Destinations AS T
	|) AS T
	|GROUP BY
	|	T.K
	|HAVING
	|	MAX(T.ThereAreSources) = FALSE
	|	AND MAX(T.ThereAreReceivers) = FALSE
	|INDEX BY
	|	T.K
	|";
	
	Query.Execute();
	
	// Select nodes with the Calculation completed attribute = Lies that have no sources.
	// It does not make sense to perform the calculation for such nodes. Such nodes must be deleted from the Data table.
	If RegisterRecordsDetails.Property("DeleteRowsWithoutSources") Then
		
		Query.Text =
		"SELECT
		|	T.K AS K
		|INTO DeletedNodes_0
		|FROM
		|(SELECT
		|	T.K,
		|	TRUE AS Delete
		|FROM
		|	Data AS T
		|WHERE
		|	NOT T.CalculationIsCompleted
		|
		|UNION ALL
		|
		|SELECT DISTINCT
		|	T.Key AS K,
		|	FALSE AS Delete
		|FROM
		|	Sources AS T
		|
		|UNION ALL
		|
		|SELECT
		|	T.K AS K,
		|	FALSE AS Delete
		|FROM
		|	DeletedSingleNodes AS T
		|) AS T
		|GROUP BY
		|	T.K
		|HAVING
		|	MIN(T.Delete) = TRUE
		|INDEX BY
		|	T.K
		|";
		
	Else
		
		Query.Text =
		"SELECT TOP 0
		|	0 AS K
		|INTO DeletedNodes_0";
		
	EndIf;
	
	Query.Execute();
	
	IterationNumber = 0;
	CurrentTableName = "DeletedNodes_0";
	NumberOfNodesToRemove = TemporaryTableSize(CalculationParameters, CurrentTableName);
	
	If NumberOfNodesToRemove > 0 Then
		
		ContinueSearching = True;
		
		While ContinueSearching Do
			
			IterationNumber = IterationNumber + 1;
			
			CurrentTableName    = "DeletedNodes_" + Format(IterationNumber, "NZ=0; NG=");
			NameOfPreviousTable = "DeletedNodes_" + Format(IterationNumber - 1, "NZ=0; NG=");
			
			// We supplement the list of deleted nodes with such nodes that (by And)
			// - Payment completed flag = A lie
			// - all node sources are present in the list of nodes to delete
			Query.Text =
			"SELECT
			|	T.Key AS K
			|INTO CurrentTableName
			|FROM
			|	Sources AS T
			|		LEFT JOIN NameOfPreviousTable AS DeletedNodes
			|		ON T.Source = DeletedNodes.K
			|		LEFT JOIN Data AS Data
			|		ON T.Key = Data.K
			|WHERE
			|	NOT Data.CalculationIsCompleted
			|
			|GROUP BY
			|	T.Key
			|
			|HAVING
			|	MIN(CASE
			|			WHEN DeletedNodes.K IS NULL
			|				THEN FALSE
			|			ELSE TRUE
			|		END) = TRUE
			|
			|UNION
			|
			|SELECT
			|	T.K
			|FROM
			|	NameOfPreviousTable AS T
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|DROP NameOfPreviousTable";
			
			Query.Text = StrReplace(Query.Text, "CurrentTableName", CurrentTableName);
			Query.Text = StrReplace(Query.Text, "NameOfPreviousTable", NameOfPreviousTable);
			
			Query.Execute();
			
			// We will finish the iteration of the search for deleted nodes when no new nodes are found for deletion at the next step.
			NewNumberOfNodesToDelete = TemporaryTableSize(CalculationParameters, CurrentTableName);
			
			ContinueSearching = (NewNumberOfNodesToDelete > NumberOfNodesToRemove);
			
			NumberOfNodesToRemove = NewNumberOfNodesToDelete;
			
		EndDo;
		
	EndIf;
	
	Query.Text =
	"SELECT
	|	T.K
	|INTO AllDeletedNodes
	|FROM
	|	DeletedSingleNodes AS T
	|
	|UNION
	|
	|SELECT
	|	T.K AS K
	|FROM
	|	CurrentTableName AS T
	|
	|INDEX BY
	|	T.K
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP DeletedSingleNodes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP CurrentTableName
	|";
	
	Query.Text = StrReplace(Query.Text, "CurrentTableName", CurrentTableName);
	
	Query.Execute();
	
	EndOfDataOptimization(CalculationParameters, Query, False);
	
	// Let's put statistics on data optimization into the calculation protocol.
	NewTableSizeData    = TemporaryTableSize(CalculationParameters, "Data");
	NewSizeOfSourcesTable = TemporaryTableSize(CalculationParameters, "Sources");
	
	StageDescription = NStr("vi = 'Đã thực hiện lặp lại tối ưu hóa dữ liệu - %1,
	|	kích thước bảng Dữ liệu (trước/sau) - %2 / %3; 
	|	kích thước bảng Nguồn và Đích (trước/sau) - %4 / %5';
	|ru = 'Выполнено итераций оптимизации данных - %1,
	|	размер таблицы Данные (до/после) - %2 / %3; 
	|	размер таблиц Источники и Приемники (до/после) - %4 / %5';
	|en = 'Data optimization iterations completed - %1,
	|	Size of Data table (before/after) - %2 / %3;
	|	Size of Sources and Destinations tables (before/after) - %4 / %5'; fa = 'Data optimization iterations completed - %1,
	|	Size of Data table (before/after) - %2 / %3;
	|	Size of Sources and Destinations tables (before/after) - %4 / %5';
	|it = 'Effettuati interazioni di оttimizzazione dei dati - %1,
	|	dimensione della tabella Dati (prima/dopo) - %2 / %3; 
	|	dimensione delle tabelle Fonti e Ricevitori (prima/dopo) - %4 / %5';
	|pl = 'Wykonano iteracji optymizacji danych - %1,
	|	 rozmiar tabeli Dane (do/po) - %2 / %3; 
	|	 rozmiar tabel Źródła i Odbiorniki (do/po) - %4 / %5';
	|tr = 'Gerçekleştirilen veri optimizasyonu tekrarlanma sayısı - %1,
	|	Veri tablosunun boyutu (önce/sonra) - %2 / %3; 
	|	 Kaynak ve Kabül tablolarının boyutu (önce/sonra) - %4 / %5'", Common.DefaultLanguageCode());
	
	StageDescription = StringFunctionsClientServer.SubstituteParametersToString(
		StageDescription,
		CostCalculationProtocol.ValuePresentation(IterationNumber + 1),
		CostCalculationProtocol.ValuePresentation(TableSizeData),
		CostCalculationProtocol.ValuePresentation(NewTableSizeData),
		CostCalculationProtocol.ValuePresentation(TableSizeSources),
		CostCalculationProtocol.ValuePresentation(NewSizeOfSourcesTable));
		
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, StageDescription);
	
	// We will destroy unnecessary temporary tables.
	NewTT = GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	DestroyTemporaryTables(CalculationParameters, NewTT);
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
	
EndProcedure

// Optimizes the numbering in the chains.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//
Procedure OptimizeNumberingInChains(CalculationParameters)
	
	DataTableSize = TemporaryTableSize(CalculationParameters, "Data");
	
	If DataTableSize = 0 Then
		Return;
	EndIf;
	
	LinkTableSize = TemporaryTableSize(CalculationParameters, "Sources");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.SetParameter("DataTableSize", DataTableSize);
	Query.SetParameter("LinkTableSize", LinkTableSize);
	Query.SetParameter("NumberOfVTZLines",  CalculationParameters.SamplingRestrictions.NumberOfVTZLines);
	
	If CalculationParameters.Debug.DoNotPerformChainOptimization Then
		
		Query.Text =
		"SELECT
		|	0 							AS CalculationTaskNumber,
		|	0 							AS SubgraphNumber,
		|	&LinkTableSize 		AS LinkCount,
		|	&DataTableSize 		AS NodeCount,
		|	&DataTableSize
		|	  + &LinkTableSize	AS SubgraphWeight,
		|	0 							AS MinimumNodeNumber,
		|	&DataTableSize - 1 	AS MaximumNodeNumber,
		|	0 							AS MaximumNodeReceivers,
		|	0 							AS MaximumNodeSources
		|INTO DescriptionOfSubgraphs";
		
		Query.Execute(); // creating descriptiondegraphs
		
		CostCalculationProtocol.AdditionalInformation(
			CalculationParameters,
			NStr("vi = 'Việc tối ưu hóa đánh số các nút của đoạn trước khi việc hạch toán lô theo chuỗi đã bị bỏ qua đối với mục đích gỡ lỗi.';
				|ru = 'Оптимизация нумерации узлов графа перед расчетом партий по цепочкам пропущена для целей отладки.';
				|en = 'Optimization of graph node numbering before lot calculation by chains is skipped for debug purposes.'; fa = 'Optimization of graph node numbering before lot calculation by chains is skipped for debug purposes.';
				|it = 'L''ottimizzazione della numerazione dei nodi del grafo prima della contabilizzazione dei lotti per i percorsi, è stata saltata per scopi di debug.';
				|pl = 'Optymizacja numeracji węzłów kolumna przed obliczeniem partii wg łańcuchów została przepuszczona do celów debugowania.';
				|tr = 'Zincirlere göre lotların hesaplanmasından önce sütun ünitelerinin numaralandırılmasının optimizasyonu, hata ayıklama amacıyla boş bırakılmıştır.'", Common.DefaultLanguageCode()));
		
		Return;
		
	EndIf;
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTNewNodeNumbers", NStr("vi = 'Tối ưu hóa đánh số dữ liệu nguồn';
																										|ru = 'Оптимизация нумерации исходных данных';
																										|en = 'Source data numbering optimization'; fa = 'Source data numbering optimization';
																										|it = 'Ottimizzazione di numerazione dei dati di origine';
																										|pl = 'Optymizacja numeracji danych wyjściowych';
																										|tr = 'Kaynak verilerin numaralandırılmasının optimizasyonu'", Common.DefaultLanguageCode()));
	
	ExistingTT = GetListOfExistingTemporaryTables(CalculationParameters);
	
	#Region Initialize
	
	SettlementBatches = CalculationParameters.DistributionOfParties.SettlementBatches; // ValueTable
	ColumnsOfDataTable_ = SettlementBatches.Columns;
	
	ThereIsPeriodOfReceiptInData = (ColumnsOfDataTable_.Find("ReceiptPeriod") <> Undefined);
	ThereIsPeriodInData 	   		 = (ColumnsOfDataTable_.Find("Period") <> Undefined);
	ThereIsLoggerInData	 	 = (ColumnsOfDataTable_.Find("Recorder") <> Undefined);
	
	ColumnNamesOfDataTable = "";
	For Each CurrentColumn In ColumnsOfDataTable_ Do
		
		ColumnName = ?(CurrentColumn.Name = "K", "NewNumbers.NewNodeNumber AS K", "T." + CurrentColumn.Name);
		
		ColumnNamesOfDataTable = ColumnNamesOfDataTable + ?(ColumnNamesOfDataTable = "", "", ",
			|	") + ColumnName;
		
	EndDo;
	
	#EndRegion
	
	#Region Ordering
	
	// Prepare the data for the ordering of records.
	// The ordering is performed by the fields Access period, Period, Registrar
	// The ordering is used to sort nodes of the same wave of the subgraph and to sort the sources and receivers of the node.
	
	Query.Text =
	"SELECT
	|	T.K AS NodeNumber,
	|	&Parameter1 AS ReceiptPeriod,
	|	&Parameter2 AS Period,
	|	&Parameter3 AS Recorder
	|INTO TTDataForOrdering
	|FROM
	|	Data AS T
	|
	|INDEX BY
	|	ReceiptPeriod,
	|	Period,
	|	Recorder";
	
	Query.Text = StrReplace(Query.Text, "&Parameter", "%");
	
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		Query.Text,
		?(ThereIsPeriodOfReceiptInData, "ISNULL(T.ReceiptPeriod, DATETIME(1,1,1))", "DATETIME(1,1,1)"),
		?(ThereIsPeriodInData, "ISNULL(T.Period, DATETIME(1,1,1))", "DATETIME(1,1,1)"),
		?(ThereIsLoggerInData, "ISNULL(T.Recorder, UNDEFINED)", "DATETIME(1,1,1)"));
	
	Query.Execute(); // creating the data for ordering
	
	Query.Text =
	"SELECT DISTINCT
	|	&Parameter1 AS SeparatorValue,
	|	T.ReceiptPeriod AS ReceiptPeriod,
	|	T.Period AS Period,
	|	T.Recorder AS Recorder
	|INTO TTOrderingFields
	|FROM
	|	TTDataForOrdering AS T
	|
	|INDEX BY
	|	ReceiptPeriod,
	|	Period,
	|	Recorder";
	
	Query.Text = StrReplace(Query.Text, "&Parameter", "%");
	
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		Query.Text,
		?(ThereIsPeriodOfReceiptInData,
			"BEGINOFPERIOD(T.ReceiptPeriod, DAY)",
			?(ThereIsPeriodInData,
				"BEGINOFPERIOD(T.Period, DAY)",
				"1")));
	
	Query.Execute(); // creating an in-order field
	
	NumberingParameters = GenerateParametersForNumberingRowsInTemporaryTable(
		"SeparatorValue", // Separator
		"", // Resources
		"ReceiptPeriod, Period, Recorder", // Order
		"Order", // Number
		"ReceiptPeriod, Period, Recorder", // IndexOf
		"", // accumulation
		False); // do not select a separator
	
	FillInTemporaryTableRowNumbers(
		CalculationParameters,
		NumberingParameters,
		"TTOrderingFields");
	
	Query.Text =
	"SELECT
	|	T.NodeNumber 			   AS NodeNumber,
	|	OrderFields.Order AS Order
	|INTO TTOrderOfNodes
	|FROM
	|	TTDataForOrdering AS T
	|   INNER JOIN TTOrderingFields AS OrderFields
	|		ON T.ReceiptPeriod = OrderFields.ReceiptPeriod
	|		 AND T.Period = OrderFields.Period
	|		 AND T.Recorder = OrderFields.Recorder
	|
	|INDEX BY
	|	NodeNumber";
	
	Query.Execute(); // creating an order of nodes
	
	DestroyTemporaryTables(CalculationParameters, "TTDataForOrdering, TTOrderingFields");
		
	#EndRegion
	
	#Region PartitioningGraphIntoSubgraphs
	
	// Let's split the original data graph into unrelated subgraphs.
	// Each found subgraph will be numbered from 0 to (the number of subgraphs is 1) in descending order of the number of arcs in the subgraph.
	// I.e., the subgraph with the number 0 will be the largest, and the last subgraphs will be trivial (contain one node each).
	//
	// The partitioning is performed as follows:
	// - to begin with, we assign each vertex a subgraph number equal to the number of the vertex itself
	// - for each vertex i, we determine the numbers of subgraphs of all its sources and receivers
	// - if the minimum number of subgraphs of connected vertices is less than the number of the subgraph of vertex i itself,
	//	 then we assign to vertex i this minimum subgraph number
	// - we repeat steps 2 and 3 in the cycle until, at the next iteration, the number of its subgraph does not change at any vertex.
	// I.e., the minimum vertex number in each subgraph begins to "spread" along this subgraph - from this vertex
	// first, it "moves" to adjacent vertices, then to their adjacent vertices, etc., until it "occupies" the entire subgraph.
	// As a result, each subgraph will have its own unique number equal to the number of the minimum vertex included in it.
	// Then we will do the end-to-end numbering of these subgraphs (as written above).
	// For example, there is the original graph ((4-2-1-7) (6) (5-3)):
	// - we will find in it three subgraphs with conditional numbers 1, 6 and 3
	// - then assign them the numbers 0, 2 and 1, respectively.
	
	Query.Text =
	"SELECT
	|	T.K AS NodeNumber,
	|	T.K AS SubgraphNumber
	|INTO TTNodesOfSubgraphs
	|FROM
	|	Data AS T
	|
	|INDEX BY
	|	NodeNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Key AS NodeNumber,
	|	T.Source AS RelatedNode,
	|	TRUE AS ThisIsSource
	|INTO TTLinkNodes
	|FROM
	|	Sources AS T
	|
	|UNION ALL
	|
	|SELECT
	|	T.Key,
	|	T.Receiver,
	|	FALSE
	|FROM
	|	Destinations AS T
	|
	|INDEX BY
	|	RelatedNode,
	|	ThisIsSource";
	
	Query.Execute(); // creating nodes, subgraphs, and communication nodes
	
	HasChanges = True;
	NumberOfSubgraphSearchIterations = 0;
	
	While HasChanges Do
		
		NumberOfSubgraphSearchIterations = NumberOfSubgraphSearchIterations + 1;
		
		Query.Text =
		"SELECT
		|	NodeConnections.NodeNumber AS NodeNumber,
		|	MIN(T.SubgraphNumber) AS SubgraphNumber
		|INTO TTSubgraphsOfConnectedNodes
		|FROM
		|	TTNodesOfSubgraphs AS T
		|		INNER JOIN TTLinkNodes AS NodeConnections
		|		ON T.NodeNumber = NodeConnections.RelatedNode
		|
		|GROUP BY
		|	NodeConnections.NodeNumber
		|
		|INDEX BY
		|	NodeNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.NodeNumber AS NodeNumber,
		|	SubgraphsOfConnectedNodes.SubgraphNumber AS SubgraphNumber
		|INTO TTModifiedSubgraphs
		|FROM
		|	TTNodesOfSubgraphs AS T
		|		INNER JOIN TTSubgraphsOfConnectedNodes AS SubgraphsOfConnectedNodes
		|		ON T.NodeNumber = SubgraphsOfConnectedNodes.NodeNumber
		|WHERE
		|	SubgraphsOfConnectedNodes.SubgraphNumber < T.SubgraphNumber
		|
		|INDEX BY
		|	NodeNumber
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TTSubgraphsOfConnectedNodes";
		
		Query.Execute(); // creating in-appended paragraphs
		
		HasChanges = (TemporaryTableSize(CalculationParameters, "TTModifiedSubgraphs") > 0);
		
		If HasChanges Then
			
			Query.Text =
			"SELECT
			|	T.NodeNumber,
			|	CASE WHEN ModifiedSubgraphs.NodeNumber IS NULL 
			|		THEN T.SubgraphNumber
			|		ELSE ModifiedSubgraphs.SubgraphNumber
			|	END AS SubgraphNumber
			|INTO TTNewSubgraphNodes
			|FROM
			|	TTNodesOfSubgraphs AS T
			|		LEFT JOIN TTModifiedSubgraphs AS ModifiedSubgraphs
			|		ON T.NodeNumber = ModifiedSubgraphs.NodeNumber
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|DROP TTNodesOfSubgraphs
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|SELECT
			|	T.NodeNumber,
			|	T.SubgraphNumber
			|INTO TTNodesOfSubgraphs
			|FROM
			|	TTNewSubgraphNodes AS T
			|
			|INDEX BY
			|	NodeNumber
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|DROP TTNewSubgraphNodes";
			
			Query.Execute(); // updating the nodes of the subgraphs
			
		EndIf;
		
		DestroyTemporaryTables(CalculationParameters, "TTModifiedSubgraphs");
		
	EndDo;
	
	Query.Text =
	"SELECT
	|	T.SubgraphNumber AS SubgraphNumber,
	|	COUNT(DISTINCT T.NodeNumber) AS NodeCount,
	|	SUM(CAST(CASE WHEN NodeConnections.RelatedNode IS NULL THEN 0 ELSE 1 END AS NUMBER(15,0))) AS LinkCount,
	|	SUM(CAST(CASE WHEN NodeConnections.RelatedNode IS NULL THEN 0 ELSE 1 END AS NUMBER(15,0))) AS SeparatorValue
	|INTO TTSubgraphs
	|FROM
	|	TTNodesOfSubgraphs AS T
	|		LEFT JOIN TTLinkNodes AS NodeConnections
	|		ON T.NodeNumber = NodeConnections.RelatedNode
	|			AND NodeConnections.ThisIsSource = TRUE
	|
	|GROUP BY
	|	T.SubgraphNumber";
	
	Query.Execute(); // creating vtpodgraphs
	
	NumberingParameters = GenerateParametersForNumberingRowsInTemporaryTable(
		"", // Separator
		"", // Resources
		"LinkCount DESC, NodeCount DESC, SubgraphNumber", // Order
		"NewSubgraphNumber", // Number
		"SubgraphNumber", // IndexOf
		"SeparatorValue"); // accumulation
	
	FillInTemporaryTableRowNumbers(
		CalculationParameters,
		NumberingParameters,
		"TTSubgraphs");
	
	#EndRegion
	
	#Region CalculatingNewNodeNumbers
	
	// Calculate the new vertex numbers of the original graph:
	// - arrange all vertices
	// - let's bypass the resulting result and sequentially number the vertices from 0 to (the number of vertices is 1).
	
	Query.Text =
	"SELECT
	|	T.NodeNumber AS NodeNumber,
	|	SUM(T.NumberOfReceivers) AS NumberOfReceivers,
	|	SUM(T.NumberOfSources) AS NumberOfSources
	|INTO TTDescriptionOfNodes
	|FROM
	|	(SELECT
	|		T.NodeNumber AS NodeNumber,
	|		COUNT(DISTINCT Destinations.Receiver) AS NumberOfReceivers,
	|		0 AS NumberOfSources
	|	FROM
	|		TTNodesOfSubgraphs AS T
	|			LEFT JOIN Destinations AS Destinations
	|			ON T.NodeNumber = Destinations.Key
	|	
	|	GROUP BY
	|		T.NodeNumber
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.NodeNumber,
	|		0,
	|		COUNT(DISTINCT Sources.Source)
	|	FROM
	|		TTNodesOfSubgraphs AS T
	|			LEFT JOIN Sources AS Sources
	|			ON T.NodeNumber = Sources.Key
	|	
	|	GROUP BY
	|		T.NodeNumber) AS T
	|
	|GROUP BY
	|	T.NodeNumber
	|
	|INDEX BY
	|	NodeNumber
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	CAST(Subgraphs.SeparatorValue / &NumberOfVTZLines AS NUMBER(15,0)) AS SeparatorValue,
	|	Subgraphs.SubgraphNumber 			AS SubgraphNumber,
	|	Subgraphs.NewSubgraphNumber 	AS NewSubgraphNumber,
	|	T.NodeNumber 					AS NodeNumber,
	|	T.NodeNumber 					AS NewNodeNumber,
	|	NodeOrder_.Order 			AS Order
	|INTO TTNewNodeNumbers
	|FROM
	|	TTDescriptionOfNodes AS T
	|		INNER JOIN TTNodesOfSubgraphs AS NodesOfSubgraphs
	|			INNER JOIN TTSubgraphs AS Subgraphs
	|			ON NodesOfSubgraphs.SubgraphNumber = Subgraphs.SubgraphNumber
	|		ON T.NodeNumber = NodesOfSubgraphs.NodeNumber
	|		INNER JOIN TTOrderOfNodes AS NodeOrder_
	|		ON T.NodeNumber = NodeOrder_.NodeNumber";
	
	Query.Execute(); // creating a list of nodes, newnomer nodes
	
	NumberingParameters = GenerateParametersForNumberingRowsInTemporaryTable(
		"SeparatorValue", // Separator
		"", // Resources
		"NewSubgraphNumber, Order, NodeNumber", // Order
		"NewNodeNumber", // Number
		"NodeNumber", // IndexOf
		"", // accumulation
		False); // do not select a separator
	
	FillInTemporaryTableRowNumbers(
		CalculationParameters,
		NumberingParameters,
		"TTNewNodeNumbers");
		
	#EndRegion
	
	#Region ChangingNumberingInTables
	
	// Replace the old vertex numbers with new ones in the service temporary tables Data, Sources, Receivers.
	// In the Sources and Receivers tables, fill in the Order field.
	// This field refers to the "Source" and "Receiver" columns and is intended for sorting them by FIFO.
	
	Query.Text =
	"SELECT
	|	T.NodeNumber 			 AS Key,
	|	T.RelatedNode 		 AS Source,
	|	NodeOrder_.Order 	 AS Order
	|INTO Sources_Temporary
	|FROM
	|	TTLinkNodes AS T
	|		INNER JOIN TTOrderOfNodes AS NodeOrder_
	|		ON T.RelatedNode = NodeOrder_.NodeNumber
	|			AND T.ThisIsSource = TRUE
	|
	|INDEX BY
	|	Key
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Sources
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NewKeyNumbers.NewNodeNumber 	 AS Key,
	|	NewSourceNumbers.NewNodeNumber AS Source,
	|	T.Order 				 			 AS Order
	|INTO Sources
	|FROM
	|	Sources_Temporary AS T
	|		INNER JOIN TTNewNodeNumbers AS NewKeyNumbers
	|		ON T.Key = NewKeyNumbers.NodeNumber
	|		INNER JOIN TTNewNodeNumbers AS NewSourceNumbers
	|		ON T.Source = NewSourceNumbers.NodeNumber
	|
	|INDEX BY
	|	Key
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Sources_Temporary";
	
	Query.Execute(); // Updating Sources
	
	Query.Text =
	"SELECT
	|	T.NodeNumber 			 AS Key,
	|	T.RelatedNode 		 AS Receiver,
	|	NodeOrder_.Order 	 AS Order
	|INTO Receivers_Temporary
	|FROM
	|	TTLinkNodes AS T
	|		INNER JOIN TTOrderOfNodes AS NodeOrder_
	|		ON T.RelatedNode = NodeOrder_.NodeNumber
	|			AND (T.ThisIsSource = FALSE)
	|
	|INDEX BY
	|	Key
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Destinations
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	NewKeyNumbers.NewNodeNumber 	 AS Key,
	|	NewReceiverNumbers.NewNodeNumber AS Receiver,
	|	T.Order 				 			 AS Order
	|INTO Destinations
	|FROM
	|	Receivers_Temporary AS T
	|		INNER JOIN TTNewNodeNumbers AS NewKeyNumbers
	|		ON T.Key = NewKeyNumbers.NodeNumber
	|		INNER JOIN TTNewNodeNumbers AS NewReceiverNumbers
	|		ON T.Receiver = NewReceiverNumbers.NodeNumber
	|
	|INDEX BY
	|	Key
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Receivers_Temporary";
	
	Query.Execute(); // Update Receivers
	
	Query.Text =
	"SELECT TOP 1
	|	TRUE AS ThereAreDifferences_
	|FROM
	|	TTNewNodeNumbers AS T
	|WHERE
	|	T.NodeNumber <> T.NewNodeNumber";
	
	HasChanges = Not Query.Execute().IsEmpty();
	
	If HasChanges Then
		
		Query.Text =
		"SELECT
		|	*
		|INTO Data_Temporary
		|FROM
		|	Data AS T
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP Data
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	&Parameter1
		|INTO Data
		|FROM
		|	Data_Temporary AS T
		|		INNER JOIN TTNewNodeNumbers AS NewNumbers
		|		ON T.K = NewNumbers.NodeNumber
		|
		|INDEX BY
		|	K
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP Data_Temporary";
		
		Query.Text = StrReplace(Query.Text, "&Parameter", "%");
		Query.Text = StringFunctionsClientServer.SubstituteParametersToString(Query.Text, ColumnNamesOfDataTable);
		
		Query.Execute(); // Update Data
		
	EndIf;
	
	#EndRegion
	
	#Region GeneratingGraphStatistics
	
	// Let's create new service tables for the description of the subgraphs and the description of the nodes of the subgraphs.
	
	Query.Text =
	"SELECT
	|	T.NewNodeNumber 					AS NodeNumber,
	|	T.NewSubgraphNumber 				AS SubgraphNumber,
	|	T.Order							AS Order,
	|	DescriptionOfNodes.NumberOfReceivers 	AS NumberOfReceivers,
	|	DescriptionOfNodes.NumberOfSources 	AS NumberOfSources
	|INTO DescriptionOfSubgraphNodes
	|FROM
	|	TTNewNodeNumbers AS T
	|	INNER JOIN TTDescriptionOfNodes AS DescriptionOfNodes
	|		ON T.NodeNumber = DescriptionOfNodes.NodeNumber
	|
	|INDEX BY
	|	NodeNumber
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	0 										AS CalculationTaskNumber,
	|	T.SubgraphNumber 						AS SubgraphNumber,
	|	SUM(T.NumberOfSources) 			AS LinkCount,
	|	COUNT(DISTINCT T.NodeNumber) 		AS NodeCount,
	|	SUM(T.NumberOfSources)
	|	  + COUNT(DISTINCT T.NodeNumber)	AS SubgraphWeight,
	|	MIN(T.NodeNumber) 					AS MinimumNodeNumber,
	|	MAX(T.NodeNumber) 					AS MaximumNodeNumber,
	|	MAX(T.NumberOfReceivers) 		AS MaximumNodeReceivers,
	|	MAX(T.NumberOfSources) 		AS MaximumNodeSources
	|INTO DescriptionOfSubgraphs
	|FROM
	|	DescriptionOfSubgraphNodes AS T
	|GROUP BY
	|	T.SubgraphNumber
	|
	|INDEX BY
	|	SubgraphNumber";
	
	Query.Execute(); // creating a description of nodes of subgraphs and a description of subgraphs
	
	// We will output a detailed description of the graph in the protocol.
	
	DescriptionColumn = NStr("vi = 'Mô tả chuỗi (đoạn) để tính toán:
	|	nút - %01; vòng cung - %02; Tối đa vòng cung đi - %03; Tối đa vòng cung đến - %04;
	|	chứa các đoạn con không liên quan - %05, gồm không đáng kể (từ một nút) - %06;
	|	tối đa các nút trong một đoạn con - %07; Tối đa vòng cung trong một đoạn con - %08;
	|	thực hiện lặp đi lặp lại tìm kiếm các đoạn con - %09';
	|ru = 'Описание цепочек (графа) для расчета:
	|	узлов - %01; дуг - %02; макс. исходящих дуг - %03; макс. входящих дуг - %04;
	|	содержит несвязанных подграфов - %05, в т.ч. тривиальных (из одного узла) - %06;
	|	макс. узлов в одном подграфе - %07; макс. дуг в одном подграфе - %08;
	|	выполнено итераций поиска подграфов - %09';
	|en = 'Chain (graph) description for calculation:
	|	nodes - %01; arcs - %02; max. outgoing arcs - %03; max. incoming arcs - %04;
	|   	contains disconnected subgraphs - %05, including trivial ones (out of one node) - %06;
	|	max. nodes in one subgraph - %07; max. arcs in one subgraph - %08;
	|	completed iterations of subgraph search - %09'; fa = 'Chain (graph) description for calculation:
	|	nodes - %01; arcs - %02; max. outgoing arcs - %03; max. incoming arcs - %04;
	|   	contains disconnected subgraphs - %05, including trivial ones (out of one node) - %06;
	|	max. nodes in one subgraph - %07; max. arcs in one subgraph - %08;
	|	completed iterations of subgraph search - %09';
	|it = 'Descrizione dei percorsi (del grafo) per il calcolo:
	|	nodi - %01; collegamenti - %02; collegamenti max. in uscita - %03; collegamenti max. in entrata - %04:
	|	contiene sottografi non connessi - %05 di cui triviali (da un nodo) - %06;
	|	 nodi max. in un sottografo - %07; collegamenti max. in un sottografo - %08:
	|	iterazioni di ricerca dei sottografi eseguite - %09';
	|pl = 'Opis łańcuchów (kolumna) do obliczania:
	|	 węzłów - %01; łuków - %02; maks. wychodzących łuków - %03; maks. wchodzących łuków - %04;
	|	 zawiera niezwiązanych podgrafów - %05, w tym trywialnych (z jednego węzła) - %06;
	|	maks. węzłów w jednym podgrafie - %07; maks. łuków w jednym podgrafie - %08;
	|	 wykonano iteracji wyszukiwania podgrafów - %09';
	|tr = 'Hesaplama için zincirlerin (sütun) tanımı: 
	|	üniteler - %01; yay - %02; maksimum. giden yay - %03; maksimum. gelen yay - %04; 
	|	bağlantısız alt sütunlar içerir - %05, içermek önemsiz (bir üniteden) - %06;
	|	maksimum. bir alt sütundaki üniteler - %07; maksimum. bir sütunda yay - %08;
	|	alt sütun arama tekrarlanmaları gerçekleştirildi - %09'", Common.DefaultLanguageCode());
	
	Query.SetParameter("NumberOfSubgraphSearchIterations", NumberOfSubgraphSearchIterations);
	
	Query.Text =
	"SELECT
	|	1 						 AS ParameterNumber,
	|	SUM(T.NodeCount) AS ParameterValue
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	2,
	|	SUM(T.LinkCount)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	3,
	|	MAX(T.MaximumNodeReceivers)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	4,
	|	MAX(T.MaximumNodeSources)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	5,
	|	COUNT(*)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	6,
	|	COUNT(*)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|WHERE
	|	T.NodeCount = 1
	|
	|UNION ALL
	|
	|SELECT
	|	7,
	|	MAX(T.NodeCount)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	8,
	|	MAX(T.LinkCount)
	|FROM
	|	DescriptionOfSubgraphs AS T
	|
	|UNION ALL
	|
	|SELECT
	|	9,
	|	&NumberOfSubgraphSearchIterations
	|
	|ORDER BY
	|	ParameterNumber";
	
	Selection = Query.Execute().Select();
	
	While Selection.Next() Do
		DescriptionColumn = StrReplace(
			DescriptionColumn,
			"%" + Format(Selection.ParameterNumber, "ND=2; NLZ="),
			CostCalculationProtocol.ValuePresentation(Selection.ParameterValue));
	EndDo;
	
	CalculationParameters.DistributionOfParties.Insert("DescriptionColumn", DescriptionColumn);
	
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, DescriptionColumn, DescriptionColumn);
	
	#EndRegion
	
	// We will destroy unnecessary temporary tables.
	NewTT = GetListOfExistingTemporaryTables(
		CalculationParameters,
		ExistingTT + ?(ValueIsFilled(ExistingTT), ", ", "") + "DescriptionOfSubgraphs");
	
	DestroyTemporaryTables(CalculationParameters, NewTT);
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
	
EndProcedure

Procedure FormAlreadyKnownSettlementParties(CalculationParameters, ThereWillBeNoDataOptimization)
	
	Query = New Query;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;
	
	// Let's select nodes that have no sources.
	// For such nodes, you can immediately form settlement batches, because they will not change.
	// Nodes that do not have receivers can be deleted immediately, because they are not needed for further distribution.
	Query.Text =
	"SELECT
	|	T.K AS K,
	|	CASE WHEN MAX(T.ThereAreReceivers) = FALSE
	|		THEN TRUE
	|		ELSE FALSE
	|	END AS ShouldDelete
	|INTO ProcessedNodes
	|FROM
	|(SELECT
	|	T.K,
	|	T.CalculationIsCompleted,
	|	FALSE AS ThereAreSources,
	|	FALSE AS ThereAreReceivers
	|FROM
	|	Data AS T
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	T.Key AS K,
	|	FALSE AS CalculationIsCompleted,
	|	TRUE AS ThereAreSources,
	|	FALSE AS ThereAreReceivers
	|FROM
	|	Sources AS T
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	T.Key AS K,
	|	FALSE AS CalculationIsCompleted,
	|	FALSE AS ThereAreSources,
	|	TRUE AS ThereAreReceivers
	|FROM
	|	Destinations AS T
	|) AS T
	|GROUP BY
	|	T.K
	|HAVING
	|	MAX(T.ThereAreSources) = FALSE
	|	AND (MAX(T.ThereAreReceivers) = FALSE
	|		OR MAX(T.CalculationIsCompleted) = TRUE)
	|INDEX BY
	|	T.K
	|";
	
	Query.Execute();
	
	NodeCount = TemporaryTableSize(CalculationParameters, "ProcessedNodes");
	
	If NodeCount = 0 Then
		DestroyTemporaryTables(CalculationParameters, "ProcessedNodes");
		Return;
	EndIf;
		
	Query.Text =
	"SELECT
	|	*
	|INTO DataForSettlementBatches
	|FROM
	|	Data AS T
	|	INNER JOIN ProcessedNodes AS Filter
	|	ON T.K = Filter.K";
	
	Query.Execute();
	
	RegisterName = CalculationParameters.DistributionOfParties.RegisterRecordsDetails.RegisterName;
	
	If ValueIsFilled(RegisterName) Then
		
		GenerateRegisteredRecordsByRegisterBasedOnTemporaryTableData(
			CalculationParameters,
			CalculationParameters.DistributionOfParties.RegisterRecordsDetails.RegisterName,
			"DataForSettlementBatches",
			,
			False,
			True);
		
		RegisterDescription = CalculationParameters.RegisterRecords[RegisterName];
		RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = True;
		
	Else
		
		GenerateRegisteredRecordsInTemporaryTableFromAnotherTemporaryTable(CalculationParameters, "DataForSettlementBatches", True);
		
	EndIf;
	
	DestroyTemporaryTables(CalculationParameters, "DataForSettlementBatches");
	
	Query.Text =
	"SELECT
	|	T.K
	|INTO AllDeletedNodes
	|FROM
	|	ProcessedNodes AS T
	|WHERE
	|	T.ShouldDelete";
	
	Query.Execute();
	
	CountOfItemsToDelete = TemporaryTableSize(CalculationParameters, "AllDeletedNodes");
	
	If ThereWillBeNoDataOptimization And CountOfItemsToDelete > 0 Then
		EndOfDataOptimization(CalculationParameters, Query, True);
	EndIf;
	
	// Let's put statistics on data optimization into the calculation protocol.
	StageDescription = NStr("vi = 'Tạo sơ bộ các bản ghi kết chuyển:
	|	tổng số %1, trong đó không tham gia tính toán sau này %2';
	|ru = 'Предварительное формирование движений:
	|	всего %1, в т.ч. не участвующих в дальнейшем расчете %2';
	|en = 'Preliminary generation of records:
	|	total %1, including those not included in further calculation %2'; fa = 'Preliminary generation of records:
	|	total %1, including those not included in further calculation %2';
	|it = 'Creazione preliminare dei movimenti:
	|	totale %1, inclusi non partecipanti nel calcolo successivo %2';
	|pl = 'Wstępne tworzenie przepływów:
	|	łącznie %1, w tym nie uczestniczących w dalszym obliczeniu %2';
	|tr = 'Hareketlerin ön oluşumu:
	|	toplam %1, daha sonraki hesaplamaya dahil olmayanlar dahil %2'", Common.DefaultLanguageCode());
	
	StageDescription = StringFunctionsClientServer.SubstituteParametersToString(
		StageDescription,
		CostCalculationProtocol.ValuePresentation(NodeCount),
		CostCalculationProtocol.ValuePresentation(CountOfItemsToDelete));
		
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, StageDescription);
	
	DestroyTemporaryTables(CalculationParameters, "ProcessedNodes, AllDeletedNodes");
	
EndProcedure

Procedure EndOfDataOptimization(CalculationParameters, Query, OnlyRemovingNodesWithoutLinks)
	
	NumberOfNodesToRemove = TemporaryTableSize(CalculationParameters, "AllDeletedNodes");
	
	If NumberOfNodesToRemove = 0 Then
		Return;
	EndIf;
	
	SettlementBatches = CalculationParameters.DistributionOfParties.SettlementBatches; // ValueTable
	ColumnsOfDataTable_ = SettlementBatches.Columns;
	
	// We will put in the table the new data only those rows of the Data table, the calculation of which will give the result.
	Query.Text =
	"SELECT
	|	*
	|INTO NewData
	|FROM
	|	Data AS T
	|	LEFT JOIN AllDeletedNodes AS Filter
	|	ON T.K = Filter.K
	|WHERE
	|	Filter.K IS NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Data";
	
	ColumnNamesOfDataTable = "";
	
	For Each CurrentColumn In ColumnsOfDataTable_ Do
		ColumnNamesOfDataTable = ColumnNamesOfDataTable + ?(ColumnNamesOfDataTable = "", "", ",
			|	") + "T." + CurrentColumn.Name;
	EndDo;
	
	Query.Text = StrReplace(Query.Text, "*", ColumnNamesOfDataTable);
	
	Query.Execute();
	
	// Let's perform the numbering of the rows of the data table.
	NumberingParameters = CalculationParameters.DistributionOfParties.NumberingParameters;
	
	If ValueIsFilled(NumberingParameters) Then
		
		If OnlyRemovingNodesWithoutLinks Then
			NumberingParameters.NameOfOldNumberingTable = "PreviousLineNumbering";
		EndIf;
		
		FillInTemporaryTableRowNumbers(
			CalculationParameters,
			NumberingParameters,
			"NewData",
			"Data");
		
		If OnlyRemovingNodesWithoutLinks Then
			
			Query.Text =
			"SELECT TOP 1
			|	T.NumberingHasChanged
			|FROM
			|	PreviousLineNumbering AS T
			|WHERE
			|	T.NumberingHasChanged";
			
			Selection = Query.Execute().Select();
			
			If Selection.Next() Then
				
				// Replace the old node numbers with new ones in the Sources and Receivers tables
				Query.Text =
				"SELECT
				|	OldNumbering.K AS Key,
				|	T.Source AS Source,
				|	T.Order AS Order
				|INTO SourcesModified
				|FROM
				|	Sources AS T
				|	INNER JOIN PreviousLineNumbering AS OldNumbering
				|		ON T.Key = OldNumbering.OldNumberingField
				|INDEX BY
				|	Source
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|
				|DROP Sources
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|
				|SELECT
				|	T.Key AS Key,
				|	OldNumbering.K AS Source,
				|	T.Order AS Order
				|INTO Sources
				|FROM
				|	SourcesModified AS T
				|	INNER JOIN PreviousLineNumbering AS OldNumbering
				|		ON T.Source = OldNumbering.OldNumberingField
				|INDEX BY
				|	Key
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|
				|DROP SourcesModified
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|
				|DROP Destinations
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|
				|SELECT
				|	T.Source AS Key,
				|	T.Key AS Receiver,
				|	T.Order AS Order
				|INTO Destinations
				|FROM
				|	Sources AS T
				|INDEX BY
				|	Key
				|";
				
				ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,,
					NStr("vi = '(đánh số lại bảng liên kết)';
						|ru = '(перенумерация таблиц связей)';
						|en = '(renumber link tables)'; fa = '(renumber link tables)';
						|it = '(rinumerazione delle tabelle dei collegamenti)';
						|pl = '(ponowna numeracja tabel połączeń)';
						|tr = '(bağlantı tablolarının yeniden numaralandırılması)'", Common.DefaultLanguageCode()));
				
			EndIf;
			
			DestroyTemporaryTables(CalculationParameters, NumberingParameters.NameOfOldNumberingTable);
			
			NumberingParameters.NameOfOldNumberingTable = "";
			
		EndIf;
		
	EndIf;
	
	If Not OnlyRemovingNodesWithoutLinks Then
		// Let's rebuild the chains for new data.
		BuildChainsOfRegisteredRecords(CalculationParameters, True);
	EndIf;
	
EndProcedure

#EndRegion

#EndRegion

#Region BatchCalculationAlgorithm

// The main calculation procedure is to calculate the parts by chains.
// It divides batches into portions:
//	- one for the main calculation flow,
//	- the rest are for background calculations (if they are used).
// The portions for the background calculation are passed to the Run Batch Calculation procedure, which starts background tasks with
// the Calculate Batch method. The portion for the main calculation flow is transferred to the Calculate partyinephone procedure.
// Next, the procedures Calculate Partyifone and Calculate Partyinfone prepare the data for calculation
// and call the procedure Calculate Partyipogroup of subgraphs, which performs the calculation on unrelated subgraphs,
// from which the procedure Calculate partyrecursively is called to bypass the subgraphs and calculate their nodes.
// At the end of the calculation, the results of the calculation of the main stream and background calculations are collected together in the calculation of the parts of the chains.

#Region StartingCalculation

Procedure CalculateBatchesByChains(CalculationParameters) Export
	
	CalculationParameters.DistributionOfParties.Insert("NumberOfDataRows",
		TemporaryTableSize(CalculationParameters, "Data"));
	
	UnloadHeaderOfIntermediateCalculationDataTable(CalculationParameters, "Data");
	UnloadHeaderOfIntermediateCalculationDataTable(CalculationParameters, "Sources");
	UnloadHeaderOfIntermediateCalculationDataTable(CalculationParameters, "Destinations");
	
	If CalculationParameters.DistributionOfParties.NumberOfDataRows = 0 Then
		CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "CalculateBatchesByChains");
		Return;
	EndIf;
	
	InitializeBatchDistributionMeasurement(CalculationParameters);
	
	NumberOfFederalLaws = CalculationParameters.FederalLawRestrictions.MaximumNumberOfFederalLawsForCalculatingBatches;
	
	TableNameDescriptionOfSubgraphs = "DescriptionOfSubgraphs";
	MultiThreadedCalculation = False;
	
	If Not CalculationParameters.FileInfobase
	 And Not ThisIsBackgroundBatchCalculation(CalculationParameters) And NumberOfFederalLaws > 0
	 And CalculationParameters.DistributionOfParties.NumberOfDataRows > CalculationParameters.SamplingRestrictions.BatchCalculationPortion Then
		
		CalculationParameters.CalculationTaskTable.Clear();
		CalculationParameters.TotalNumberOfFederalLaws = 0;
		MultiThreadedCalculation = True;
		
		CostCalculationProtocol.StartCreatingTemporaryTable(
			CalculationParameters,
			"DescriptionOfSubgraphs",
			NStr("vi = '(phân bổ cho các nhiệm vụ nền)';
				|ru = '(разделение на порции для фоновых заданий)';
				|en = '(division into portions for background jobs)'; fa = '(division into portions for background jobs)';
				|it = '(divisione in porzioni per le attività in background)';
				|pl = '(podział na porcje dla zadań w tle)';
				|tr = '(arka plan işleri için ayrıştırma)'", Common.DefaultLanguageCode()));
		
		// Let's split the data for calculation into (quantities of FZ + 1) portions.
		DataVolume_ = AggregateFunctionOfTemporaryTableField(
			CalculationParameters,
			"DescriptionOfSubgraphs",
			"SubgraphWeight");
		PortionSize = Int(DataVolume_/(NumberOfFederalLaws + 1)) + 1;
		
		SeparationParameters = GenerateParametersForSplittingTemporaryTableIntoPortions(
			PortionSize,
			"SubgraphWeight",
			"MinimumNodeNumber",
			"CalculationTaskNumber");
		
		DivideTemporaryTableIntoPortions(
			CalculationParameters,
			SeparationParameters,
			"DescriptionOfSubgraphs");
			
		CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
		
		// Portions starting from the second will be transferred to the background tasks for calculation.
		Query = New Query;
		Query.TempTablesManager = CalculationParameters.TempTablesManager;
		
		Query.Text =
		"SELECT
		|	MIN(T.CalculationTaskNumber) AS MinimumNumber_,
		|	MAX(T.CalculationTaskNumber) AS MaxNumber
		|FROM
		|	DescriptionOfSubgraphs AS T";
		
		Selection = Query.Execute().Select();
		Selection.Next();
		
		BackgroundCalculationParameters = GenerateBackgroundCalculationParameters(CalculationParameters);
		
		For PortionNumber = Selection.MinimumNumber_ + 1 To Min(NumberOfFederalLaws + 1, Selection.MaxNumber) Do
			
			CalculationParameters.TotalNumberOfFederalLaws = CalculationParameters.TotalNumberOfFederalLaws + 1;
			
			StartBatchCalculationInBackground(
				CalculationParameters,
				BackgroundCalculationParameters,
				PortionNumber,
				?(PortionNumber = NumberOfFederalLaws + 1, Selection.MaxNumber, PortionNumber));
			
		EndDo;
		
		// The rest of the data will be calculated without background tasks.
		Query.Text =
		"SELECT
		|	*
		|INTO DescriptionOfSubgraphsToCalculateNotInBackground
		|FROM
		|	DescriptionOfSubgraphs AS T
		|WHERE
		|	T.CalculationTaskNumber = &MinimumServingNumber
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|DROP DescriptionOfSubgraphs";
		
		Query.SetParameter("MinimumServingNumber", Selection.MinimumNumber_);
		
		Query.Execute();
		
		TableNameDescriptionOfSubgraphs = "DescriptionOfSubgraphsToCalculateNotInBackground";
		
	EndIf;
	
	CalculateBatchesNotInBackground(CalculationParameters, TableNameDescriptionOfSubgraphs);
	
	If MultiThreadedCalculation Then
		
		GetResultsOfBackgroundBatchCalculations(CalculationParameters);
		
		DestroyTemporaryTables(CalculationParameters, "DescriptionOfSubgraphsToCalculateNotInBackground");
		
	EndIf;
	
	CompleteBatchDistributionMeasurement(CalculationParameters);
	
	CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "CalculateBatchesByChains");
	
EndProcedure

Procedure CalculateBatchesNotInBackground(CalculationParameters, TableNameDescriptionOfSubgraphs)
	
	// Let's divide the subgraphs into groups - one group entirely includes one or more subgraphs.
	SeparationParameters = GenerateParametersForSplittingTemporaryTableIntoPortions(
		CalculationParameters.SamplingRestrictions.BatchCalculationPortion,
		"NodeCount",
		"MinimumNodeNumber");
	
	DivideTemporaryTableIntoPortions(
		CalculationParameters,
		SeparationParameters,
		TableNameDescriptionOfSubgraphs);
	
	Query = New Query;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;
	
	Query.Text =
	"SELECT
	|	T.PortionNumber,
	|	COUNT(DISTINCT T.SubgraphNumber) AS NumberOfSubgraphs,
	|	SUM(T.NodeCount) AS NodeCount,
	|	SUM(T.LinkCount) AS LinkCount,
	|	MIN(T.MinimumNodeNumber) AS MinimumNodeNumber,
	|	MAX(T.MaximumNodeNumber) AS MaximumNodeNumber
	|FROM
	|	TableNameDescriptionOfSubgraphs AS T
	|
	|GROUP BY
	|	T.PortionNumber
	|
	|ORDER BY
	|	T.PortionNumber";
	
	Query.Text = StrReplace(Query.Text, "TableNameDescriptionOfSubgraphs", TableNameDescriptionOfSubgraphs);
	
	SamplingGroupOfSubgraphs = Query.Execute().Select();
	
	// Calculate the batches.
	CalculateBatchesBySubgraphGroups(CalculationParameters, SamplingGroupOfSubgraphs);
	
EndProcedure

Procedure CalculateBatchesBySubgraphGroups(CalculationParameters, SamplingGroupOfSubgraphs)
	
	PortionNumber = 0;
	
	RegisterRecordsDetails = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	ThereIsStorno = RegisterRecordsDetails.Property("ThereIsStorno");
	ThereIsCalculationOfBatches = RegisterRecordsDetails.Property("ThereIsCalculationOfBatches");
	
	While NextCollectionItem(SamplingGroupOfSubgraphs) Do
		
		BeginningOfMeasurementOfCalculationOfGroupOfSubgraphs(CalculationParameters, SamplingGroupOfSubgraphs);
		
		Data = New Structure;
		Data.Insert("ChainsOfRegisteredRecords", New Map);
		Data.Insert("ChainStrings",   New ValueTable);
		Data.Insert("Parishes", 		   New Map); // batch copy buffer to cover costs
		Data.Insert("Expenses", 		   New Map); // buffer of uncomputed batches to be calculated on the following iterations
		Data.Insert("ParishLines",  CalculationParameters.DistributionOfParties.SettlementBatches.CopyColumns());
		Data.Insert("ExpenseLines",  Data.ParishLines.CopyColumns());
		Data.Insert("ExpenseIndices", New Array);
		Data.Insert("TraveledPath",  New Map); // used to interrupt cycles
		Data.Insert("NodesWithoutData",   New Map); // it is used to exclude traversal of nodes for which it is obviously clear that there is no data for them yet
			// before each run of the calculation of the next data portion, this list must be cleared, because in the new portion the data for these nodes may already be
		Data.Insert("RowIndex",    Undefined);
		
		ChainStrings = Data.ChainStrings;
		Columns = ChainStrings.Columns;
		Columns.Add("Sources", 	   New TypeDescription("Array"));
		Columns.Add("Destinations", 	   New TypeDescription("Array"));
		Columns.Add("TraveledPath", New TypeDescription("Map"));
		
		Data.Insert("IterationParameters", New Structure); // description of the current position in the data crawl for calculation
		Data.IterationParameters.Insert("RowIndex",     SamplingGroupOfSubgraphs.MinimumNodeNumber - 1);
		Data.IterationParameters.Insert("InitialChain", 0);
		Data.IterationParameters.Insert("FinalChain",  SamplingGroupOfSubgraphs.MinimumNodeNumber - 1);
		Data.IterationParameters.Insert("PortionNumber",      PortionNumber); // needed for background calculation
		
		CalculationStatistics = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
		CalculationStatistics.DataVolume = CalculationStatistics.DataVolume + SamplingGroupOfSubgraphs.MaximumNodeNumber - Data.IterationParameters.RowIndex + 1;
		
		While Data.IterationParameters.RowIndex < SamplingGroupOfSubgraphs.MaximumNodeNumber Do
			
			Data.IterationParameters.RowIndex = Data.IterationParameters.RowIndex + 1;
			
			If Data.IterationParameters.RowIndex > Data.IterationParameters.FinalChain Then
				// Let's read the next batch of data.
				DataSelection = NextBatchPortionToCalculate(CalculationParameters, SamplingGroupOfSubgraphs, Data);
				Data.NodesWithoutData.Clear();
			EndIf;
			
			If Not NextCollectionItem(DataSelection) Or DataSelection.K <> Data.IterationParameters.RowIndex Then
				
				ProtocolText_ = NStr("vi = 'Lỗi đánh số dữ liệu để tính toán lô';
									|ru = 'Ошибка нумерации данных для расчета партий';
									|en = 'An error occurred while numbering data for lot calculation'; fa = 'An error occurred while numbering data for lot calculation';
									|it = 'Errore nella numerazione dei dati per la contabilizzazione dei lotti';
									|pl = 'Błąd numeracji danych do obliczania partii';
									|tr = 'Lot hesaplama için veri numaralandırma hatası'", Common.DefaultLanguageCode());
				
				If Not ThisIsBackgroundBatchCalculation(CalculationParameters) Then
					
					CostCalculationProtocol.FixCalculationError(
						CalculationParameters,
						Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
						ProtocolText_);
					
					RegisterCalculationExecutionProblem(
						CalculationParameters,
						DataSelection.Organization,
						NStr("vi = 'Khi tạo bản ghi kết chuyển theo lô, đã chẩn đoán được lỗi';
							|ru = 'При формировании движений по партиям диагностированы ошибки';
							|en = 'Errors were found when generating lot records'; fa = 'Errors were found when generating lot records';
							|it = 'Durante la creazione dei movimenti sui lotti sono stati diagnosticati degli errori';
							|pl = 'Podczas tworzenia ruchów wg partii wykryto błędy';
							|tr = 'Hareketlerin lotlar halinde oluşturulması sırasında hatalar tespit edildi'", Common.DefaultLanguageCode()),
						ProtocolText_);
						
					ProtocolText_ = TextExceptionToLogProblem(ProtocolText_);
					
				EndIf;
				
				Raise ProtocolText_;
				
			EndIf;
			
			ChainOfRegisteredRecords = Data.ChainsOfRegisteredRecords[Data.IterationParameters.RowIndex];
			
			If ChainOfRegisteredRecords = Undefined Then
				
				// The settlement party has already been formed
				
			ElsIf DataSelection.CalculationIsCompleted Then
				
				If ChainOfRegisteredRecords.Destinations.Count() > 0
				// The document for which the parties were calculated at the preliminary closing of the month cannot be a source
				// for other documents. such movements are taken into account when forming the table of calculated Balances and 
				// the calculated Balances are the sources.
				 And (Not ThereIsCalculationOfBatches
				 	Or CalculationParameters.RestoreChronologicalSequenceOfDebitingBatches
					Or ThereIsCalculationOfBatches
					// exclude movements of the Cur period for which the parties have already been calculated.
					And Not (DataSelection.LotCalculationPerformed
						And DataSelection.Period >= CalculationParameters.PayrollPeriod.BeginOfPeriod)) Then
					
					Receipt = Data.ParishLines.Add();
					FillPropertyValues(Receipt, DataSelection);
					
					InvertMetrics(Receipt, RegisterRecordsDetails.Indicators,
						Receipt.EntryType = Enums.LotRecordTypes.ReversingEntry
						Or Receipt.EntryType = Enums.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction
						Or ThereIsStorno And Receipt.ThisIsReverseTransaction);
						
					ArrayOfParishesByIndex = New Array;
					ArrayOfParishesByIndex.Add(Receipt);
					Data.Parishes.Insert(Data.IterationParameters.RowIndex, ArrayOfParishesByIndex);
					
				EndIf;
				
				Data.ChainsOfRegisteredRecords.Delete(Data.IterationParameters.RowIndex);
				Data.ChainStrings.Delete(ChainOfRegisteredRecords);
				
			Else
				
				Expense = Data.ExpenseLines.Add();
				FillPropertyValues(Expense, DataSelection);
				
				Data.Expenses.Insert(Data.IterationParameters.RowIndex, Expense);
				Data.ExpenseIndices.Add(Data.IterationParameters.RowIndex);
				
			EndIf;
			
			If Data.IterationParameters.RowIndex = SamplingGroupOfSubgraphs.MaximumNodeNumber // the last iteration of the loop
			 Or (Data.IterationParameters.RowIndex - SamplingGroupOfSubgraphs.MinimumNodeNumber > 0 // not the first iteration of the loop
			 	And (Data.IterationParameters.RowIndex + 1 - SamplingGroupOfSubgraphs.MinimumNodeNumber) % CalculationParameters.SamplingRestrictions.BatchCalculationPortion = 0) Then
				
				Data.RowIndex = Data.IterationParameters.RowIndex;
				
				If Data.Parishes.Count() > 0  // there are records for which the calculation is completed
				 Or Data.IterationParameters.RowIndex = SamplingGroupOfSubgraphs.MaximumNodeNumber Then
					
					For Each ExpenseIndex In Data.ExpenseIndices Do
						
						If Data.Expenses[ExpenseIndex] = Undefined Then
							Continue; // the line to the calculation is NOT registered
						EndIf;
						
						BasisOfConsumption = Data.Expenses[ExpenseIndex][RegisterRecordsDetails.BasisOfConsumption];
						Data.TraveledPath.Clear();
						CalculateBatchRecursively(CalculationParameters, Data, ExpenseIndex);
						
						If Data.Expenses[ExpenseIndex] <> Undefined
						 And Data.Expenses[ExpenseIndex][RegisterRecordsDetails.BasisOfConsumption] > 0
						 And Data.Expenses[ExpenseIndex][RegisterRecordsDetails.BasisOfConsumption] <> BasisOfConsumption Then
							Data.ExpenseIndices.Add(ExpenseIndex);
						EndIf;
						
					EndDo;
					
					Data.ExpenseIndices.Clear();
					Data.NodesWithoutData.Clear();
					
				EndIf;
				
				If Data.IterationParameters.RowIndex < SamplingGroupOfSubgraphs.MaximumNodeNumber Then
					
					For Each String In Data.Expenses Do
						Data.ExpenseIndices.Add(String.Key);
					EndDo;
					
					List = New ValueList;
					List.LoadValues(Data.ExpenseIndices);
					List.SortByValue();
					Data.ExpenseIndices = List.UnloadValues();
					
				Else
					
					For Each String In Data.Expenses Do
						AddSettlementBatch(CalculationParameters, String.Value);
					EndDo;
					
				EndIf;
				
			EndIf;
			
		EndDo;
		
		PortionNumber = Data.IterationParameters.PortionNumber;
		
		Data.Parishes.Clear();
		Data.Expenses.Clear();
		Data.ChainsOfRegisteredRecords.Clear();
		Data.ParishLines.Clear();
		Data.ExpenseLines.Clear();
		Data.ChainStrings.Clear();
		Data = Undefined;
		
	EndDo;
	
	EndOfSubgraphGroupCalculationMeasurement(CalculationParameters);
	
EndProcedure

// Calculate the batch recursively.
// 
// Parameters:
//  CalculationParameters - Structure - Calculation parameters
//  Data - Structure - Data:
// * ChainsOfRegisteredRecords - Map -
// * ChainStrings - ValueTable -:
// ** Sources - Array -
// ** Destinations - Array -
// ** TraveledPath - Map -
// * Parishes - Map -
// * Expenses - Map -
// * ParishLines - ValueTable -
// * ExpenseLines - ValueTable - 
// * ExpenseIndices - Array -
// * TraveledPath - Map -
// * NodesWithoutData - Map -
// * RowIndex - Undefined -
// * IterationParameters - Structure -
//  ExpenseIndex - Arbitrary - Expense Index
// 
// Returns:
//  String - Calculate The Batch Recursively
Function CalculateBatchRecursively(CalculationParameters, Data, ExpenseIndex)
	
	CalculationStatistics = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	CalculationStatistics.DataVolume = CalculationStatistics.DataVolume + 1;
	
	If Not BeginningOfMeasurementOfCalculationOfChains(CalculationParameters, Data, ExpenseIndex) Then
		Return EndOfChainCalculationMeasurement(CalculationParameters, "StackOverflow");
	EndIf;
	
	RegisterRecordsDetails = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	
	FlowChain = Data.ChainsOfRegisteredRecords[ExpenseIndex];
	If FlowChain = Undefined Then
		Return EndOfChainCalculationMeasurement(CalculationParameters, "NotRequired");
	EndIf;
	
	Sources = FlowChain.Sources;
	If Sources.Count() = 0 Then
		If RegisterRecordsDetails.Property("DeleteRowsWithoutSources") Then
			Expense = Data.Expenses[ExpenseIndex];
			Data.Expenses.Delete(ExpenseIndex);
			Data.ChainsOfRegisteredRecords.Delete(ExpenseIndex);
			Data.ExpenseLines.Delete(Expense);
			Data.ChainStrings.Delete(FlowChain);
		EndIf;

		Return EndOfChainCalculationMeasurement(CalculationParameters, "NoSources");
	EndIf;
	
	If ExpenseIndex = Data.TraveledPath[ExpenseIndex] Then
		Return EndOfChainCalculationMeasurement(CalculationParameters, "Looping");
	EndIf;
	
	NodesWithoutData = Data.NodesWithoutData; //Map
	If NodesWithoutData[ExpenseIndex] <> Undefined Then
		Return EndOfChainCalculationMeasurement(CalculationParameters, "WaitingForData");
	EndIf;
	
	RowIndex = Data.RowIndex;
	For Each ParishIndex In Sources Do
		If ParishIndex > RowIndex Then
			
			For NodeNumberOnStack = 0 To CalculationStatistics.CurDepth - 1 Do
				NodesWithoutData.Insert(CalculationStatistics.CallsStack[NodeNumberOnStack], True);
			EndDo;
			
			Return EndOfChainCalculationMeasurement(CalculationParameters, "NoData1"); // there are not all the lines for distribution yet
			
		EndIf;
	EndDo;
	
	Data.TraveledPath.Insert(ExpenseIndex, ExpenseIndex);
	
	NewParishes = Undefined;
	
	Expense = Data.Expenses[ExpenseIndex];
	ThereIsStorno = RegisterRecordsDetails.Property("ThereIsStorno");
	ThereAreFixes = RegisterRecordsDetails.Property("ThereAreFixes"); 
	ThisIsReverseTransaction = (Expense.EntryType = Enums.LotRecordTypes.ReversingEntry
		Or Expense.EntryType = Enums.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction
		Or ThereIsStorno And Expense.ThisIsReverseTransaction);
	IsPatch = (ThereAreFixes And Expense.ReversingEntry);
	ThisIsAcquisitionAdjustment = (Expense.EntryType = Enums.LotRecordTypes.PurchaseAdjustment);
	
	ThereIsBusinessOperation = RegisterRecordsDetails.Property("ThereIsBusinessOperation");
	ThisIsReturnOfGoodsToSupplier = ThereIsBusinessOperation
		And Expense.EntryType = Enums.LotRecordTypes.Consumption
		And Expense.BusinessOperation = Enums.BusinessTransactions.ReturnOfGoodsToVendor;
	
	HasGroupFields = RegisterRecordsDetails.Property("GroupFields");
	
	ThereIsFieldAccountingSection = RegisterRecordsDetails.Property("ThereIsAccountingSection");
	AccountingSection = Undefined;
	If ThereIsFieldAccountingSection Then
		AccountingSection = Expense.AccountingSection;
	EndIf;
	
	If HasGroupFields Then
		For Each TheIndexOfTheSource In Sources Do
			If Data.Expenses[TheIndexOfTheSource] = Undefined Then
				Continue;
			EndIf;
			Source = Data.Expenses[TheIndexOfTheSource];
			If Not Source.CalculationIsCompleted Then
				Result = CalculateBatchRecursively(CalculationParameters, Data, TheIndexOfTheSource);
				If Result = "NoData1" Then
					Return EndOfChainCalculationMeasurement(CalculationParameters, "NoData1"); // there are not all the lines for distribution yet
				ElsIf Result = "WaitingForData" Then
					Return EndOfChainCalculationMeasurement(CalculationParameters, "WaitingForData");
				EndIf;
			EndIf;
		EndDo;
	EndIf;

	SortingIsRequired = False;
	If Sources.Count() > 1 And ValueIsFilled(RegisterRecordsDetails.SortFields) Then
		
		FieldValues = New Structure(RegisterRecordsDetails.SortFields);
		FillPropertyValues(FieldValues, Expense);
		
		For Each SortField In FieldValues Do
			If ValueIsFilled(SortField.Value) Then
				SortingIsRequired = True;
				Break;
			EndIf;
		EndDo;
		
	EndIf;
	
	SortingOfGoodsInTransitIsRequired = False;
	If AccountingSection = Enums.SectionsOfInventoryCostAccounting.GoodsInTransit
	 And SortingIsRequired Then
		SortingOfGoodsInTransitIsRequired = True;
	EndIf;
	
	SortByLIFO = (Expense.EntryType = Enums.LotRecordTypes.PreviousPeriodReturn Or ThisIsReverseTransaction) And Not IsPatch And Not ThisIsAcquisitionAdjustment;
	SortSourcesByFIFO_LIFO(Sources, RegisterRecordsDetails.OrderField_, FieldValues, Data.Parishes, Data.Expenses, 
		SortByLIFO, Expense, ThereAreFixes And Not ThisIsReturnOfGoodsToSupplier, ThisIsReverseTransaction, SortingOfGoodsInTransitIsRequired);
	
	If SortingIsRequired Then
		SortSourcesByFieldValues(Sources, FieldValues, Data.Parishes, Data.Expenses, Expense.Recorder,
			ThisIsReverseTransaction And Not IsPatch, ThereAreFixes And Not ThisIsReturnOfGoodsToSupplier, ThisIsReverseTransaction);
	EndIf;
	
	Counter = 0;
	UBound = Sources.UBound();
	
	InvertMetrics(Expense, RegisterRecordsDetails.Indicators, ThisIsReverseTransaction);
	
	ReducingBasisOfConsumption = RegisterRecordsDetails.Property("ReducingBasis");
	BasisOfConsumptionBeforeCalculation = Expense[RegisterRecordsDetails.BasisOfConsumption];
	CurBasisOfExpenditure   = BasisOfConsumptionBeforeCalculation;
	SourcesToDelete = New Array;
	
	While Counter <= UBound Do
		
		TheIndexOfTheSource = Sources[?(ThisIsReverseTransaction And Not IsPatch, UBound - Counter, Counter)];
		Counter = Counter + 1;
		
		ArrayOfParishes = Data.Parishes[TheIndexOfTheSource];
		If ArrayOfParishes = Undefined Then
			
			If Data.Expenses[TheIndexOfTheSource] = Undefined Then
				SourcesToDelete.Add(TheIndexOfTheSource);
				Continue;
			EndIf;
			
			Source = Data.Expenses[TheIndexOfTheSource];
			If Not Source.CalculationIsCompleted 
			 And Expense.EntryType <> Enums.LotRecordTypes.PreviousPeriodReturn Then
				Result = CalculateBatchRecursively(CalculationParameters, Data, TheIndexOfTheSource);
				If Result = "NoData1" Then
					InvertMetrics(Expense, RegisterRecordsDetails.Indicators, ThisIsReverseTransaction);
					Return EndOfChainCalculationMeasurement(CalculationParameters, "NoData1"); // there are not all the lines for distribution yet
				ElsIf Result = "WaitingForData" Then
					InvertMetrics(Expense, RegisterRecordsDetails.Indicators, ThisIsReverseTransaction);
					Return EndOfChainCalculationMeasurement(CalculationParameters, "WaitingForData");
				ElsIf Result = "Looping" And UBound = 0 Then
					InvertMetrics(Expense, RegisterRecordsDetails.Indicators, ThisIsReverseTransaction);
					Return EndOfChainCalculationMeasurement(CalculationParameters, "Looping");
				EndIf;
				UBound = Sources.UBound();
				If Data.Expenses[ExpenseIndex] = Undefined Then
					InvertMetrics(Expense, RegisterRecordsDetails.Indicators, ThisIsReverseTransaction);
					Return EndOfChainCalculationMeasurement(CalculationParameters, "NotRequired");
				EndIf;
				ArrayOfParishes = Data.Parishes[TheIndexOfTheSource];
				If ArrayOfParishes = Undefined Then
					Continue;
				EndIf;
			Else
				ArrayOfParishes = Data.Parishes[TheIndexOfTheSource];
				If ArrayOfParishes = Undefined Then
					Continue;
				EndIf;
			EndIf;
			
		EndIf;
		
		SortByLIFO = ThisIsReverseTransaction And Not IsPatch;
		SortReceiptsByFIFO_LIFO(RegisterRecordsDetails.OrderField_, FieldValues, ArrayOfParishes, SortByLIFO,
			Expense, ThereAreFixes And Not ThisIsReturnOfGoodsToSupplier, ThisIsReverseTransaction, SortingOfGoodsInTransitIsRequired);
		
		ComingsToDeletions = New Array;
		
		NumberOfRegisteredRecords = CalculationParameters.DistributionOfParties.SettlementBatches.Count();
		ReducingBasisOfConsumption_ = 0;
		
		For Each Receipt In ArrayOfParishes Do
			
			If ReducingBasisOfConsumption Then
				
				If Receipt.EntryType = Enums.LotRecordTypes.AddExpensesForGoods
						Or Receipt.EntryType = Enums.LotRecordTypes.AddExpensesLotIsNotSpecified
						Or Receipt.EntryType = Enums.LotRecordTypes.AddExpensesLotIsSpecified
						Or Receipt.EntryType = Enums.LotRecordTypes.AddExpensesLocal
						Or Receipt.EntryType = Enums.LotRecordTypes.AddExpensesMan
						Or Receipt.EntryType = Enums.LotRecordTypes.AdditionalExpensesForAllocationLocal
						Or Receipt.EntryType = Enums.LotRecordTypes.AdditionalExpensesForAllocationMan
				 		Or Receipt.EntryType = Enums.LotRecordTypes.DebitNoteForPreviousPeriod
						Or Receipt.EntryType = Enums.LotRecordTypes.CostVariance
						Or (Receipt.EntryType = Enums.LotRecordTypes.Previous
						And ValueIsFilled(Receipt.Products))
						Or (Receipt.EntryType = Enums.LotRecordTypes.PreviousPeriodReturn
							And ValueIsFilled(Receipt.Products)
							And Not VATCostCalculation.ThisIsPreparationOfDataForAccountingLBSiUSN(RegisterRecordsDetails.Context))
						Or (Receipt.EntryType = Enums.LotRecordTypes.GroupedStock
						And ValueIsFilled(Receipt.Products))
						Or (Receipt.EntryType = Enums.LotRecordTypes.GroupedLot
				 		And ValueIsFilled(Receipt.Products))
						Or Receipt.EntryType = Enums.LotRecordTypes.Balance Then

					If VATCostCalculation.ThisIsPreparationOfDataForAccountingLBSiUSN(RegisterRecordsDetails.Context)
							And (Receipt.EntryType = Enums.LotRecordTypes.GroupedStock
					 		Or Receipt.EntryType = Enums.LotRecordTypes.GroupedLot) Then
						Expense[RegisterRecordsDetails.BasisOfConsumption] = CurBasisOfExpenditure;
						If Receipt.Count <> 0 Then // information about the batch of goods (not additional. expenses)
							ReducingBasisOfConsumption_ = Min(CurBasisOfExpenditure, Receipt[RegisterRecordsDetails.BasisOfConsumption]);
						// There can only be additional costs for goods. There is no quantity of such records.
						ElsIf ReducingBasisOfConsumption_ = 0 Then
							ReducingBasisOfConsumption_ = CurBasisOfExpenditure;
						EndIf;
					Else
						
						If Expense.EntryType = Enums.LotRecordTypes.BaseLocal
						 Or Expense.EntryType = Enums.LotRecordTypes.ManBase
						 Or Expense.EntryType = Enums.LotRecordTypes.BaseAdditionalExpensesLocal
						 Or Expense.EntryType = Enums.LotRecordTypes.BaseAdditionalExpensesMan Then
						 
						 	AdditionalProperties = CalculationParameters.DistributionOfParties.AdditionalProperties;
							If Not AdditionalProperties.Property("DistributionBaseNodes") Then
								AdditionalProperties.Insert("DistributionBaseNodes", New Map);
							EndIf;
							
							SourceNodesDatabases = AdditionalProperties.DistributionBaseNodes.Get(Expense.K);
							
							If SourceNodesDatabases = Undefined Then
								SourceNodesDatabases = New Array;
							EndIf;
							
							If SourceNodesDatabases.Find(Receipt.K) <> Undefined Then
								Continue;
							EndIf;
							
							SourceNodesDatabases.Add(Receipt.K);
							AdditionalProperties.DistributionBaseNodes.Insert(Expense.K, SourceNodesDatabases);
								
						EndIf;
						
						Expense[RegisterRecordsDetails.BasisOfConsumption] = BasisOfConsumptionBeforeCalculation;
						
					EndIf;
					
				ElsIf VATCostCalculation.ThisIsPreparationOfDataForAccountingLBSiUSN(RegisterRecordsDetails.Context)
						And (Receipt.EntryType = Enums.LotRecordTypes.Lot
						Or Receipt.EntryType = Enums.LotRecordTypes.ProductionIssue
						Or Receipt.EntryType = Enums.LotRecordTypes.CostAllocationToProductionLots
						Or Receipt.EntryType = Enums.LotRecordTypes.ItemizedExpencesAllocationToProductionLots
						Or Receipt.EntryType = Enums.LotRecordTypes.PreviousPeriodCorrections
						Or (Receipt.EntryType = Enums.LotRecordTypes.Consumption
						And Expense.EntryType <> Enums.LotRecordTypes.ReversingEntry
						And Expense.EntryType <> Enums.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction)
						Or Receipt.EntryType = Enums.LotRecordTypes.ConsumptionLotCalculation
						Or Receipt.EntryType = Enums.LotRecordTypes.ConsumptionProduction) Then

					Expense[RegisterRecordsDetails.BasisOfConsumption] = BasisOfConsumptionBeforeCalculation;
					
				ElsIf Not VATCostCalculation.ThisIsPreparationOfDataForAccountingLBSiUSN(RegisterRecordsDetails.Context)
				 And (Receipt.EntryType = Enums.LotRecordTypes.CostAllocationToProductionLots
				 	Or Receipt.EntryType = Enums.LotRecordTypes.ItemizedExpencesAllocationToProductionLots) Then
					
					Expense[RegisterRecordsDetails.BasisOfConsumption] = BasisOfConsumptionBeforeCalculation;
					
				Else
					
					ReducingBasisOfConsumption_ = Min(CurBasisOfExpenditure, Receipt[RegisterRecordsDetails.BasisOfConsumption]);
					Expense[RegisterRecordsDetails.BasisOfConsumption] = CurBasisOfExpenditure;
					
				EndIf;
				
				If Expense[RegisterRecordsDetails.BasisOfConsumption] <= 0 Then
					Continue;
				EndIf;
				
			EndIf;
			
			SettlementBatch = AddAndFillInCalculatedBatch(CalculationParameters, Expense, Receipt, ThisIsReverseTransaction);
			
			If Receipt[RegisterRecordsDetails.BasisOfArrival] <= 0 Then
				ComingsToDeletions.Add(Receipt);
			EndIf;
			
			If SettlementBatch.CalculationIsCompleted Then
				If FlowChain.Destinations.Count() > 0 Then
					If HasGroupFields Then
						
						If NewParishes = Undefined Then
							NewParishes = Data.ParishLines.CopyColumns();
						EndIf;
						NewReceipt = NewParishes.Add();
						FillPropertyValues(NewReceipt, SettlementBatch);
						InvertMetrics(NewReceipt, RegisterRecordsDetails.Indicators,
							NewReceipt.EntryType = Enums.LotRecordTypes.ReversingEntry
							Or NewReceipt.EntryType = Enums.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction
							Or ThereIsStorno And NewReceipt.ThisIsReverseTransaction);
						
					Else
						
						NewReceipt = Data.ParishLines.Add();
						FillPropertyValues(NewReceipt, SettlementBatch);
						InvertMetrics(NewReceipt, RegisterRecordsDetails.Indicators,
							NewReceipt.EntryType = Enums.LotRecordTypes.ReversingEntry
							Or NewReceipt.EntryType = Enums.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction
							Or ThereIsStorno And NewReceipt.ThisIsReverseTransaction);
						
						If Data.Parishes[ExpenseIndex] = Undefined Then
							Data.Parishes.Insert(ExpenseIndex, New Array);
						EndIf;
						
						ArrayDataParishes = Data.Parishes[ExpenseIndex]; //Array
						ArrayDataParishes.Add(NewReceipt);
						
					EndIf;
				EndIf;
			Else
				DeleteCalculatedBatch(CalculationParameters, SettlementBatch);
			EndIf;
			
			SettlementBatch = Undefined;
			
			If Not ReducingBasisOfConsumption And Expense.EntryType = Enums.LotRecordTypes.AddExpensesLotIsNotSpecified Then
				If Expense.Denominator <= 0 Then
					Break;
				EndIf;
			ElsIf Expense.EntryType = Enums.LotRecordTypes.CostAdjustment
			 Or Expense.EntryType = Enums.LotRecordTypes.DebitNoteForPreviousPeriod Then
			 	// With a cost adjustment, the denominator may not be filled in. The quantity is always 0.
			ElsIf Not ReducingBasisOfConsumption And Expense[RegisterRecordsDetails.BasisOfConsumption] <= 0 Then
				Break;
			EndIf;
			
		EndDo;
		
		If ReducingBasisOfConsumption
		 And NumberOfRegisteredRecords <> CalculationParameters.DistributionOfParties.SettlementBatches.Count()
		 And ReducingBasisOfConsumption_ <> 0 Then
			CurBasisOfExpenditure = CurBasisOfExpenditure - ReducingBasisOfConsumption_;
		EndIf;

		For Each Receipt In ComingsToDeletions Do
			IndexOf = ArrayOfParishes.Find(Receipt);
			If IndexOf <> Undefined Then
				ArrayOfParishes.Delete(IndexOf);
			EndIf;
			Data.ParishLines.Delete(Receipt);
		EndDo;
		
		If ArrayOfParishes.Count() = 0 Then
			
			Data.Parishes.Delete(TheIndexOfTheSource);
			
			If Data.Expenses[TheIndexOfTheSource] = Undefined Then
				ChainOfArrival = Data.ChainsOfRegisteredRecords[TheIndexOfTheSource];
				If ChainOfArrival <> Undefined Then
					Data.ChainsOfRegisteredRecords.Delete(TheIndexOfTheSource);
					Data.ChainStrings.Delete(ChainOfArrival);
				EndIf;
			EndIf;
			
		ElsIf ComingsToDeletions.Count() > 0 Then
			Data.Parishes.Insert(TheIndexOfTheSource, ArrayOfParishes);
		EndIf;
		
		If Not ReducingBasisOfConsumption 
		 And (Expense.EntryType = Enums.LotRecordTypes.AddExpensesLotIsNotSpecified
		 Or Expense.EntryType = Enums.LotRecordTypes.AddExpensesLotIsSpecified) Then
			If Expense.Denominator <= 0 Then
				Break;
			EndIf;
		 ElsIf Expense.EntryType = Enums.LotRecordTypes.CostAdjustment
		 Or Expense.EntryType = Enums.LotRecordTypes.DebitNoteForPreviousPeriod Then
		 	// With a cost adjustment, the denominator may not be filled in. The number can be equal to 0.
		ElsIf Not ReducingBasisOfConsumption And Expense[RegisterRecordsDetails.BasisOfConsumption] <= 0 Then
			Break;
		EndIf;
		
	EndDo;
	
	If ReducingBasisOfConsumption Then
		Expense[RegisterRecordsDetails.BasisOfConsumption] = CurBasisOfExpenditure;
	EndIf;
	
	If HasGroupFields
	 And NewParishes <> Undefined
	 And NewParishes.Count() > 0 Then
	 	
	 	// We will add the existing rows by the expense index to the new rows for subsequent convolution.
	 	ArrayOfParishes = Data.Parishes[ExpenseIndex];
	 	If ArrayOfParishes <> Undefined Then
	 		ComingsToDeletions.Clear();
	 		For Each Receipt In ArrayOfParishes Do
	 			NewReceipt = NewParishes.Add();
				FillPropertyValues(NewReceipt, Receipt);
				ComingsToDeletions.Add(Receipt);	
	 		EndDo;
	 		For Each Receipt In ComingsToDeletions Do
	 			IndexOf = ArrayOfParishes.Find(Receipt);
				If IndexOf <> Undefined Then
					ArrayOfParishes.Delete(IndexOf);
				EndIf;
	 			Data.ParishLines.Delete(Receipt);
	 		EndDo;
	 	EndIf;
		
		NewParishes.GroupBy(RegisterRecordsDetails.GroupFields, RegisterRecordsDetails.SummationFields);
		
		If Data.Parishes[ExpenseIndex] = Undefined Then
			Data.Parishes.Insert(ExpenseIndex, New Array);
		EndIf;
		
		For Each String In NewParishes Do
			NewReceipt = Data.ParishLines.Add();
			FillPropertyValues(NewReceipt, String);
			// Fill in the consumption basis with the value of the basis on which the batches were selected.
			// - The basis of the account - the full basis for the line
			// - Decrease in the base of consumption - the size of the decrease in the basis of consumption, is equal to = 0 if the calculation basis has not decreased
			// - The current base of expenditure is the basis of expenditure after the selection of batches, but it does not decrease for all types of records
			If NewReceipt[RegisterRecordsDetails.BasisOfConsumption] = 0 Then
				NewReceipt[RegisterRecordsDetails.BasisOfConsumption] = BasisOfConsumptionBeforeCalculation - 
					?(ReducingBasisOfConsumption_ <> 0, CurBasisOfExpenditure, 0);
			EndIf;
			ArrayDataParishes = Data.Parishes[ExpenseIndex]; //Array
			ArrayDataParishes.Add(NewReceipt);
		EndDo;
		
		NewParishes = Undefined;
		
	EndIf;
	
	If SourcesToDelete.Count() > 0 Then
		For Each TheIndexOfTheSource In SourcesToDelete Do
			IndexInArray = Sources.Find(TheIndexOfTheSource);
			If IndexInArray <> Undefined Then
				Sources.Delete(IndexInArray);
			EndIf;
		EndDo;
		Data.ChainsOfRegisteredRecords[ExpenseIndex].Sources = Sources;
	EndIf;
	
	If (Expense[RegisterRecordsDetails.BasisOfConsumption] > 0
	 Or Expense.EntryType = Enums.LotRecordTypes.AddExpensesLotIsNotSpecified And Expense.Denominator > 0
	 Or Expense.EntryType = Enums.LotRecordTypes.AddExpensesLotIsSpecified And Expense.Denominator > 0
	 Or Expense.EntryType = Enums.LotRecordTypes.IncludeVATInCostExpenses And Expense.Denominator > 0)
	 And (Sources.Count() > 0 Or Not RegisterRecordsDetails.Property("DeleteRowsWithoutSources")) Then
		
		InvertMetrics(Expense, RegisterRecordsDetails.Indicators, ThisIsReverseTransaction);
		
		// The Non-Delivery of an Unfactured delivery can be A Source for Write-Off of discrepancies between Receipt and purchase.
		// Therefore, it is necessary to add such records to the array of parishes.
		If RegisterRecordsDetails.Property("ThereIsBusinessOperation")
		 And (Expense.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUInvoicedDelivery
			Or Expense.BusinessOperation = Enums.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit
			Or Expense.BusinessOperation = Enums.BusinessTransactions.PurchaseFromVendorCreatingInvoicesOnGoodsReceipt
			Or Expense.BusinessOperation = Enums.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit
			Or Expense.BusinessOperation = Enums.BusinessTransactions.ImportReceiptFromGoodsInTransit) Then
				
			NewReceipt = Data.ParishLines.Add();
			FillPropertyValues(NewReceipt, Expense);
			InvertMetrics(NewReceipt, RegisterRecordsDetails.Indicators,
				NewReceipt.EntryType = Enums.LotRecordTypes.ReversingEntry
				Or NewReceipt.EntryType = Enums.LotRecordTypes.ReturnToAnotherWarehouseReverseTransaction
				Or ThereIsStorno And NewReceipt.ThisIsReverseTransaction);
			NewReceipt.CalculationIsCompleted = True;
			NewReceipt.Denominator = Expense.Count; 
			If Data.Parishes[ExpenseIndex] = Undefined Then
				Data.Parishes.Insert(ExpenseIndex, New Array);
			EndIf;
			ArrayDataParishes = Data.Parishes[ExpenseIndex]; //Array
			ArrayDataParishes.Add(NewReceipt);
			
		EndIf; 
		
	Else
		
		Data.Expenses.Delete(ExpenseIndex);
		Data.ChainsOfRegisteredRecords.Delete(ExpenseIndex);
		Data.ExpenseLines.Delete(Expense);
		Data.ChainStrings.Delete(FlowChain);
		
	EndIf;
	
	Return EndOfChainCalculationMeasurement(CalculationParameters, "Completed2");
	
EndFunction

#EndRegion

#Region BackgroundBatchCalculation

// The basic procedures of background calculation.

// The basic procedures of background calculation.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
// 	BackgroundCalculationParameters - Structure - LongDesc
// 	MinimumCalculationTaskNumber - Number -
// 	MaximumCalculationTaskNumber - Number -
Procedure StartBatchCalculationInBackground(CalculationParameters, BackgroundCalculationParameters,
			MinimumCalculationTaskNumber, MaximumCalculationTaskNumber)
			
	MeasurementDetails = New Structure;
	MeasurementDetails.Insert("TotalTime", CurrentUniversalDateInMilliseconds());
	MeasurementDetails.Insert("PreparingDescriptionOfCalculationData_Time", 0);
	MeasurementDetails.Insert("PreparingDescriptionOfCalculationData_Quantity", 0);
	MeasurementDetails.Insert("UploadingDescriptionOfCalculationData_Time", 0);
	MeasurementDetails.Insert("UploadingDescriptionOfCalculationData_Quantity", 0);
	MeasurementDetails.Insert("CachingCalculationDataDescription_Time", 0);
	
	MeasurementDetails.Insert("PreparingGraphData_Time", 0);
	MeasurementDetails.Insert("PreparingGraphData_Number", 0);
	
	MeasurementDetails.Insert("PreparationOfThesePortions_Time", 0);
	MeasurementDetails.Insert("PreparationOfThesePortions_Quantity", 0);
	
	MeasurementDetails.Insert("UnloadingNodes_Time", 0);
	MeasurementDetails.Insert("UnloadingNodes_Number", 0);
	MeasurementDetails.Insert("NodeCaching_Time", 0);
	
	MeasurementDetails.Insert("UnloadingLinks_Time", 0);
	MeasurementDetails.Insert("UnloadingLinks_Number", 0);
	MeasurementDetails.Insert("CachingLinks_Time", 0);
	
	MeasurementDetails.Insert("CachingCalculationParameters_Time", 0);
	MeasurementDetails.Insert("RunningBackgroundJob_Time", 0);
	
	CalculationID = New UUID;
	
	// Description of the graph.
	Query = New Query;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;

	Query.Text =
	"SELECT
	|	&TableFields
	|INTO DescriptionOfSubgraphsBackgroundCalculation
	|FROM
	|	DescriptionOfSubgraphs AS T
	|WHERE
	|	T.CalculationTaskNumber >= &MinimumCalculationTaskNumber
	|	AND T.CalculationTaskNumber <= &MaximumCalculationTaskNumber";
	
	Query.SetParameter("MinimumCalculationTaskNumber",  MinimumCalculationTaskNumber);
	Query.SetParameter("MaximumCalculationTaskNumber", MaximumCalculationTaskNumber);
	
	Query.Text = StrReplace(Query.Text, "&TableFields",
		StringFunctionsClientServer.SubstituteParametersToString(
			TemporaryTableColumns(CalculationParameters, "DescriptionOfSubgraphs"),
			"T."));
			
	MeasurementStart = CurrentUniversalDateInMilliseconds();
	Query.Execute();
	EndOfMeasurement = CurrentUniversalDateInMilliseconds();
	MeasurementDetails.PreparingDescriptionOfCalculationData_Time = MeasurementDetails.PreparingDescriptionOfCalculationData_Time + (EndOfMeasurement - MeasurementStart);
	MeasurementDetails.PreparingDescriptionOfCalculationData_Quantity = MeasurementDetails.PreparingDescriptionOfCalculationData_Quantity + TemporaryTableSize(CalculationParameters, "DescriptionOfSubgraphsBackgroundCalculation");
	
	SeparationParameters = GenerateParametersForSplittingTemporaryTableIntoPortions(
		CalculationParameters.SamplingRestrictions.BatchCalculationPortion,
		"NodeCount",
		"MinimumNodeNumber");
	
	DivideTemporaryTableIntoPortions(
		CalculationParameters,
		SeparationParameters,
		"DescriptionOfSubgraphsBackgroundCalculation");
	
	Query.Text =
	"SELECT
	|	T.PortionNumber,
	|	COUNT(DISTINCT T.SubgraphNumber) AS NumberOfSubgraphs,
	|	SUM(T.NodeCount) AS NodeCount,
	|	SUM(T.LinkCount) AS LinkCount,
	|	MIN(T.MinimumNodeNumber) AS MinimumNodeNumber,
	|	MAX(T.MaximumNodeNumber) AS MaximumNodeNumber
	|FROM
	|	DescriptionOfSubgraphsBackgroundCalculation AS T
	|
	|GROUP BY
	|	T.PortionNumber
	|
	|ORDER BY
	|	T.PortionNumber";
	
	MeasurementStart = CurrentUniversalDateInMilliseconds();
	DescriptionOfSubgraphs = Query.Execute().Unload();
	EndOfMeasurement = CurrentUniversalDateInMilliseconds();
	MeasurementDetails.UploadingDescriptionOfCalculationData_Time = MeasurementDetails.UploadingDescriptionOfCalculationData_Time + (EndOfMeasurement - MeasurementStart);
	MeasurementDetails.UploadingDescriptionOfCalculationData_Quantity = MeasurementDetails.UploadingDescriptionOfCalculationData_Quantity + DescriptionOfSubgraphs.Count();
	
	MeasurementDetails.CachingCalculationDataDescription_Time = 
		WriteCacheOfBatchCalculationDataWithTimeMeasurement(
			CalculationParameters,
			MinimumCalculationTaskNumber,
			CalculationID,
			Enums.DataTypesInLotAccountingCache.DescriptionColumn,
			DescriptionOfSubgraphs,
			,
			DescriptionOfSubgraphs[0].MinimumNodeNumber,
			DescriptionOfSubgraphs[DescriptionOfSubgraphs.Count() - 1].MaximumNodeNumber);
	
	Query.SetParameter("NumberOfVTZLines",  CalculationParameters.SamplingRestrictions.NumberOfVTZLines);
	
	// Nodes and connections.
	SamplingGroupOfSubgraphs = DescriptionOfSubgraphs;
	PortionNumber = -1;
	
	While NextCollectionItem(SamplingGroupOfSubgraphs) Do
		
		ContinueUploading = True;
		InitialChain = SamplingGroupOfSubgraphs.MinimumNodeNumber;
		FinalChain = Undefined;
		
		Query.Text =
		"SELECT
		|	T.Key AS Key,
		|	T.LinkCount AS LinkCount
		|INTO TTNodesOfCurSubgraph
		|FROM
		|	NodeLinkStatistics AS T
		|WHERE
		|	T.Key >= &MinimumNodeNumber
		|	AND T.Key <= &MaximumNodeNumber
		|
		|INDEX BY
		|	Key
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	T.Key AS Key,
		|	T.LinkCount AS LinkCount
		|FROM
		|	TTNodesOfCurSubgraph AS T
		|ORDER BY
		|	Key";
		
		Query.SetParameter("MinimumNodeNumber",  SamplingGroupOfSubgraphs.MinimumNodeNumber);
		Query.SetParameter("MaximumNodeNumber", SamplingGroupOfSubgraphs.MaximumNodeNumber);
		
		MeasurementStart = CurrentUniversalDateInMilliseconds();
		
		NodesTables = Query.Execute().Unload();
		LinkCount = 0;
		
		// Let's calculate the number of connections as a cumulative total.
		For Each NodeRow In NodesTables Do
			LinkCount = LinkCount + NodeRow.LinkCount;
			NodeRow.LinkCount = LinkCount;
		EndDo;
		
		PutTableOfValuesInTemporaryTable(CalculationParameters, "TTRemainingNodes", NodesTables, "%1Key, %1LinkCount", "Key");
		
		EndOfMeasurement = CurrentUniversalDateInMilliseconds();
		MeasurementDetails.PreparingGraphData_Time = MeasurementDetails.PreparingGraphData_Time + (EndOfMeasurement - MeasurementStart);
		MeasurementDetails.PreparingGraphData_Number = MeasurementDetails.PreparingGraphData_Number + NodesTables.Count();
		
		DestroyTemporaryTables(CalculationParameters, "TTNodesOfCurSubgraph");
		
		While ContinueUploading Do
			
			PortionNumber = PortionNumber + 1;
			
			If FinalChain <> Undefined Then
				
				Query.Text =
				"SELECT
				|	T.LinkCount AS LinkCount
				|INTO TTUnloadedConnections
				|FROM
				|	TTRemainingNodes AS T
				|WHERE
				|	T.Key = &FinalChain
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	T.Key AS Key,
				|	T.LinkCount - ISNULL(T2.LinkCount, 0) AS LinkCount
				|INTO TTNewRemainingNodes
				|FROM
				|	TTRemainingNodes AS T
				|		LEFT JOIN TTUnloadedConnections AS T2
				|		ON (TRUE)
				|WHERE
				|	T.Key > &FinalChain
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|DROP TTUnloadedConnections
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|DROP TTRemainingNodes
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT
				|	T.Key AS Key,
				|	T.LinkCount AS LinkCount
				|INTO TTRemainingNodes
				|FROM
				|	TTNewRemainingNodes AS T
				|INDEX BY
				|	Key
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|DROP TTNewRemainingNodes";
				
				Query.SetParameter("FinalChain",  FinalChain);
				
				MeasurementStart = CurrentUniversalDateInMilliseconds();
				Query.Execute();
				EndOfMeasurement = CurrentUniversalDateInMilliseconds();
				MeasurementDetails.PreparationOfThesePortions_Time = MeasurementDetails.PreparationOfThesePortions_Time + (EndOfMeasurement - MeasurementStart);
				MeasurementDetails.PreparationOfThesePortions_Quantity = MeasurementDetails.PreparationOfThesePortions_Quantity + TemporaryTableSize(CalculationParameters, "TTRemainingNodes");
				
			EndIf;
			
			Query.Text =
			"SELECT
			|	MAX(T.Key) AS Key
			|FROM
			|	TTRemainingNodes AS T
			|WHERE
			|	T.LinkCount <= &NumberOfVTZLines";
			
			MeasurementStart = CurrentUniversalDateInMilliseconds();
			Selection = Query.Execute().Select();
			
			If Selection.Next() Then 
				FinalChain = Min(
					InitialChain + CalculationParameters.SamplingRestrictions.BatchCalculationPortion - 1,
					?(ValueIsFilled(Selection.Key), Selection.Key, InitialChain));
			Else
				FinalChain = InitialChain;
			EndIf;
			
			EndOfMeasurement = CurrentUniversalDateInMilliseconds();
			MeasurementDetails.PreparationOfThesePortions_Time = MeasurementDetails.PreparationOfThesePortions_Time + (EndOfMeasurement - MeasurementStart);
			
			Query.SetParameter("InitialChain", InitialChain);
			Query.SetParameter("FinalChain",  FinalChain);
			
			Query.Text =
			"SELECT
			|	&TableFields
			|FROM
			|	Data AS T
			|WHERE
			|	T.K >= &InitialChain
			|	AND T.K <= &FinalChain
			|ORDER BY
			|	T.K";
			
			Query.Text = StrReplace(Query.Text, "&TableFields",
				StringFunctionsClientServer.SubstituteParametersToString(
					TemporaryTableColumns(CalculationParameters, "Data"),
					"T."));
			
			MeasurementStart = CurrentUniversalDateInMilliseconds();
			CacheTable = Query.Execute().Unload();
			EndOfMeasurement = CurrentUniversalDateInMilliseconds();
			MeasurementDetails.UnloadingNodes_Time = MeasurementDetails.UnloadingNodes_Time + (EndOfMeasurement - MeasurementStart);
			MeasurementDetails.UnloadingNodes_Number = MeasurementDetails.UnloadingNodes_Number + CacheTable.Count();
			
			UnloadIntermediateCalculationDataTable(CalculationParameters, "Data", CacheTable);
			
			MeasurementDetails.NodeCaching_Time = MeasurementDetails.NodeCaching_Time
				+ WriteCacheOfBatchCalculationDataWithTimeMeasurement(
					CalculationParameters,
					MinimumCalculationTaskNumber,
					CalculationID,
					Enums.DataTypesInLotAccountingCache.Nodes,
					CacheTable,
					PortionNumber,
					InitialChain,
					FinalChain);
			
			Query.Text =
			"SELECT
			|	T.Key,
			|	T.Source,
			|	T.Order
			|INTO PortionOfSources
			|FROM
			|	Sources AS T
			|WHERE
			|	T.Key >= &InitialChain
			|	AND T.Key <= &FinalChain
			|	AND T.Key <> T.Source
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|
			|SELECT
			|	T.Key,
			|	T.Receiver,
			|	T.Order
			|INTO PortionOfReceivers
			|FROM
			|	Destinations AS T
			|WHERE
			|	T.Key >= &InitialChain
			|	AND T.Key <= &FinalChain
			|	AND T.Key <> T.Receiver
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|
			|SELECT
			|	T.Key 			AS Key,
			|	T.RelatedKey AS RelatedKey,
			|	T.ThisIsSource 	AS ThisIsSource
			|FROM
			|	(SELECT
			|		T.Key AS Key,
			|		T.Order AS Order,
			|		T.Source AS RelatedKey,
			|		TRUE AS ThisIsSource
			|	FROM
			|		PortionOfSources AS T
			|	
			|	UNION ALL
			|	
			|	SELECT
			|		T.Key,
			|		T.Order,
			|		T.Receiver,
			|		FALSE
			|	FROM
			|		PortionOfReceivers AS T) AS T
			|
			|ORDER BY
			|	Key,
			|	T.Order,
			|	RelatedKey";
			
			MeasurementStart = CurrentUniversalDateInMilliseconds();
			CacheTable = Query.Execute().Unload();
			EndOfMeasurement = CurrentUniversalDateInMilliseconds();
			MeasurementDetails.UnloadingLinks_Time = MeasurementDetails.UnloadingLinks_Time + (EndOfMeasurement - MeasurementStart);
			MeasurementDetails.UnloadingLinks_Number = MeasurementDetails.UnloadingLinks_Number + CacheTable.Count();
			
			UnloadIntermediateCalculationDataTable(CalculationParameters, "Sources", "PortionOfSources");
			UnloadIntermediateCalculationDataTable(CalculationParameters, "Destinations", "PortionOfReceivers");
			
			DestroyTemporaryTables(CalculationParameters, "PortionOfSources, PortionOfReceivers");
			
			If CacheTable.Count() > 0 Then
				
				MeasurementDetails.CachingLinks_Time = MeasurementDetails.CachingLinks_Time
					+ WriteCacheOfBatchCalculationDataWithTimeMeasurement(
						CalculationParameters,
						MinimumCalculationTaskNumber,
						CalculationID,
						Enums.DataTypesInLotAccountingCache.Links,
						CacheTable,
						PortionNumber,
						InitialChain,
						FinalChain);
				
			EndIf;
			
			ContinueUploading = (FinalChain < SamplingGroupOfSubgraphs.MaximumNodeNumber);
			InitialChain = FinalChain + 1;
			
		EndDo;
		
		DestroyTemporaryTables(CalculationParameters, "TTRemainingNodes");
		
	EndDo;
	
	// Background calculation parameters.
	BackgroundCalculationParameters.Insert("CalculationID",    CalculationID);
	BackgroundCalculationParameters.Insert("MaximumServingNumber", PortionNumber);
	
	MeasurementDetails.CachingCalculationParameters_Time = 
		WriteCacheOfBatchCalculationDataWithTimeMeasurement(
			CalculationParameters,
			MinimumCalculationTaskNumber,
			CalculationID,
			Enums.DataTypesInLotAccountingCache.CalculationParameters,
			BackgroundCalculationParameters);
	
	// Let's start the calculation task.
	MeasurementStart = CurrentUniversalDateInMilliseconds();
	
	TaskHandlerParameters = New Array;
	TaskHandlerParameters.Add(CalculationID);
	
	JobKey = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Nhiệm vụ nền số %1 - %2 %3 (%4)';
			|ru = 'ФЗ №%1 - %2 %3 (%4)';
			|en = 'FZ No.%1 - %2 %3 (%4)'; fa = 'FZ No.%1 - %2 %3 (%4)';
			|it = 'F3 №%1 - %2 %3 (%4)';
			|pl = 'UF nr%1 - %2 %3 (%4)';
			|tr = 'FY №%1 - %2 %3 (%4)'", Common.DefaultLanguageCode()),
		TrimAll(MinimumCalculationTaskNumber - 1),
		NStr("vi = 'Nhiệm vụ nền tính toán lô';
			|ru = 'Фоновый расчет партий';
			|en = 'Background lot calculation'; fa = 'Background lot calculation';
			|it = 'Contabilizzazione in background dei lotti';
			|pl = 'Obliczenie w tle partii';
			|tr = 'Lotların arka plan hesaplaması'", Common.DefaultLanguageCode()),
		BackgroundCalculationParameters.PlaceOfCalculationCall,
		TrimAll(CalculationID));
	
	NewJob = MonthEndTransactionsServer.StartSubordinateBackgroundTaskOfCalculationStage(
		CalculationParameters.CalculationIDForClosingMonth,
		"CostCalculationAppliedAlgorithms.CalculateBatchesInBackground",
		TaskHandlerParameters,
		JobKey,
		NStr("vi = 'Kế toán theo lô, phiên bản 2.2: tính toán một phần dữ liệu.';
			|ru = 'Партионный учет версии 2.2: расчет порции данных.';
			|en = 'Lot accounting 2.2: data portion calculation.'; fa = 'Lot accounting 2.2: data portion calculation.';
			|it = 'Contabilità a lotti versione 2.2: contabilizzazione della porzione di dati.';
			|pl = 'Ewidencja partii wersji 2.2: obliczenie porcji danych.';
			|tr = 'Lot muhasebesi sürüm 2.2: veri bölümünün hesaplanması.'", Common.DefaultLanguageCode()));
		
	TaskDescriptionString = CalculationParameters.CalculationTaskTable.Add();
	TaskDescriptionString.JobID = NewJob.UUID;
	TaskDescriptionString.JobKey 		   = JobKey;
	TaskDescriptionString.CalculationID = CalculationID;
	
	EndOfMeasurement = CurrentUniversalDateInMilliseconds();
	MeasurementDetails.RunningBackgroundJob_Time = MeasurementDetails.RunningBackgroundJob_Time + (EndOfMeasurement - MeasurementStart);

	DestroyTemporaryTables(CalculationParameters, "DescriptionOfSubgraphsBackgroundCalculation");
	
	MeasurementDetails.TotalTime = CurrentUniversalDateInMilliseconds() - MeasurementDetails.TotalTime;
	
	TextSTART = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Khởi động nhiệm vụ nền hạch toán lô hàng số%1: %2, trong đó
			|	* chuẩn bị mô tả dữ liệu: %3 (%4)
