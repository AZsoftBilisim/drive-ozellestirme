		RecordRegisteredRecordsByRegister(
			Selection,
			AdjustmentParameters.RegisterDescription.RegisterManager,
			WriteParameters);
			
		CostCalculationProtocol.AdditionalInformation(
			CalculationParameters,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Đã xóa các bản ghi kết chuyển của việc điều chỉnh lỗi thời theo biểu ghi ""%1"": %2';
					|ru = 'Очищено движений устаревших корректировки по регистру ""%1"": %2';
					|en = 'Outdated adjustment records by the register ""%1"" are cleared: %2'; fa = 'Outdated adjustment records by the register ""%1"" are cleared: %2';
					|it = 'Cancellati movimenti della correzione obsoleta in base del registro""%1"": %2';
					|pl = 'Usunięto nieaktualne korekty rejestru „%1”: %2';
					|tr = '""%1"" kaydı tarafından eski düzeltme hareketleri temizlendi: %2'", Common.DefaultLanguageCode()),
				AdjustmentParameters.RegisterPresentation,
				CostCalculationProtocol.ValuePresentation(Selection.Count())));
		
	EndIf;
	
