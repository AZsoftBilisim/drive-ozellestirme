#Region SortingData

Procedure SortSourcesByFieldValues(Sources, FieldValues, Parishes, Expenses, ReceiverLogger, SortByLIFO, ThereAreFixes, ThisIsReverseTransaction)
	
	List = New ValueList;
	
	IndexOfArrayElement = -1;
	
	For Each TheIndexOfTheSource In Sources Do
		
		IndexOfArrayElement = IndexOfArrayElement + 1;
		
		ArrayOfParishes = Parishes[TheIndexOfTheSource];
		
		If ArrayOfParishes <> Undefined And ArrayOfParishes.Count() = 0 Then
			Move = 0;
		Else
			
			Move = FieldValues.Count();
			
			For Each SortField In FieldValues Do
				If Not ValueIsFilled(SortField.Value) Then
					Continue;
				EndIf;
				
				If ArrayOfParishes <> Undefined Then
					Simple = ArrayOfParishes[0][SortField.Key];
					SourceLogger = ArrayOfParishes[0].Recorder;
					ReversingEntry = ?(ThereAreFixes, ArrayOfParishes[0].ReversingEntry, False);
				ElsIf Expenses[TheIndexOfTheSource] <> Undefined Then
				 	Simple = Expenses[TheIndexOfTheSource][SortField.Key];
					SourceLogger = Expenses[TheIndexOfTheSource].Recorder;
					ReversingEntry = ?(ThereAreFixes, Expenses[TheIndexOfTheSource].ReversingEntry, False);
				Else
					Break;
				EndIf;
				
				If ThereAreFixes And SourceLogger = ReceiverLogger
				 And Not ReversingEntry And Not ThisIsReverseTransaction Then
				 	// We do not sort sources whose Registrar matches the receiver to exclude looping.
				 	// in addition to the source - the correctional record "Storno".
					Continue;
				ElsIf Simple = SortField.Value Then
					Move = Move - 1;
				ElsIf Simple = Enums.VATTaxationTypes.ExportSale
				 And (SortField.Value = Enums.VATTaxationTypes.ExportOfNonResourceGoods
					Or SortField.Value = Enums.VATTaxationTypes.ExportOfCommoditiesServicesWorks) Then
					Move = Move - 1;
				EndIf;
			EndDo;
			
		EndIf;
		
		List.Add(TheIndexOfTheSource, Format(IndexOfArrayElement + Move * Sources.Count(), "ND=15; NFD=; NLZ=; NG="));
		
	EndDo;
	
	If List.Count() > 0 Then
		If SortByLIFO Then
			List.SortByPresentation(SortDirection.Desc);
		Else
			List.SortByPresentation(SortDirection.Asc);
		EndIf;
		Sources = List.UnloadValues();
	EndIf;
	
EndProcedure

Procedure SortReceiptsByFIFO_LIFO(OrderField_, FieldValues, Parishes, SortByLIFO, Expense, ThereAreFixes, ThisIsReverseTransaction, SortingOfGoodsInTransitIsRequired)
	
	If Parishes.Count() <= 1 Then
		Return;
	EndIf;
	
	// For the product accounting section of the way, we additionally sort Receipts by the value of the expense field, and not just by the order field.
	If SortingOfGoodsInTransitIsRequired Then
		
		ReceiverLogger = Expense.Recorder;
		
		Table = New ValueTable;
		Table.Columns.Add("ParishLines");
		Table.Columns.Add("Order");
		Table.Columns.Add("Simple");
		
		For Each Receipt In Parishes Do
			
			Move = FieldValues.Count();
			
			For Each SortField In FieldValues Do
				If Not ValueIsFilled(SortField.Value) Then
					Continue;
				EndIf;
				
				Simple = Receipt[SortField.Key];
				SourceLogger = Receipt.Recorder;
				ReversingEntry = ?(ThereAreFixes, Receipt.ReversingEntry, False);
				
				If ThereAreFixes And SourceLogger = ReceiverLogger
					And Not ReversingEntry And Not ThisIsReverseTransaction Then
					// We do not sort sources whose Registrar matches the receiver to exclude looping.
					// in addition to the source - the correctional record "Storno".
					Continue;
				ElsIf Simple = SortField.Value Then
					Move = Move - 1;
				EndIf;
			EndDo;
			
			NewRow = Table.Add();
			NewRow.ParishLines = Receipt;
			NewRow.Order = Format(Move * Parishes.Count(), "ND=15; NFD=; NLZ=; NG=");
			NewRow.Simple = Receipt[OrderField_];
			
		EndDo;
		
		If SortByLIFO Then
			Table.Sort("Order Asc, Simple Desc");
		Else
			Table.Sort("Order, Simple");
		EndIf;
		Parishes = Table.UnloadColumn("ParishLines");
		
	Else
		
		Table = New ValueTable;
		Table.Columns.Add("ParishLines");
		Table.Columns.Add("Simple");
		
		For Each Receipt In Parishes Do
			NewRow = Table.Add();
			NewRow.ParishLines = Receipt;
			NewRow.Simple = Receipt[OrderField_];
		EndDo;
		
		If SortByLIFO Then
			Table.Sort("Simple Desc");
		Else
			Table.Sort("Simple");
		EndIf;
		Parishes = Table.UnloadColumn("ParishLines");
		
	EndIf;
	
EndProcedure

Procedure SortSourcesByFIFO_LIFO(Sources, OrderField_, FieldValues, Parishes, Expenses, SortByLIFO, Expense, ThereAreFixes, ThisIsReverseTransaction, SortingOfGoodsInTransitIsRequired)
	
	If Sources.Count() <= 1 Then
		Return;
	EndIf;
	
	Table = New ValueTable;
	Table.Columns.Add("TheIndexOfTheSource");
	Table.Columns.Add("Simple");
	
	For Each TheIndexOfTheSource In Sources Do
		ArrayOfParishes = Parishes[TheIndexOfTheSource];
		If ArrayOfParishes <> Undefined And ArrayOfParishes.Count() > 0 Then
			SortReceiptsByFIFO_LIFO(OrderField_, FieldValues, ArrayOfParishes, SortByLIFO, Expense, ThereAreFixes, ThisIsReverseTransaction, SortingOfGoodsInTransitIsRequired);
			Simple = ArrayOfParishes[0][OrderField_];
		ElsIf Expenses[TheIndexOfTheSource] <> Undefined Then
			Simple = Expenses[TheIndexOfTheSource][OrderField_];
		Else
			Continue;
		EndIf;
		NewRow = Table.Add();
		NewRow.TheIndexOfTheSource = TheIndexOfTheSource;
		NewRow.Simple = Simple;
	EndDo;
	If SortByLIFO Then
		Table.Sort("Simple Desc");
	Else
		Table.Sort("Simple");
	EndIf;
	Sources = Table.UnloadColumn("TheIndexOfTheSource");
	
	Table.Clear();
	
EndProcedure

