#Region ActionsWithObjectWithMessageInterception

// Returns the text of error messages that were returned when checking the object's population.
//
// Parameters:
//	ObjectToCheck - DocumentObject - the document for which it is necessary to check the filling.
//	MessagePrefix - String - the characters that you need to withdraw before each error message.
//
// Returns:
//	String - multiline message text.
//
Function CheckIfObjectIsFullWithMessageInterception(ObjectToCheck, MessagePrefix = "") Export
	
	MessageText = "";
	
	PreviousMessages = GetUserMessages(False);
	
	If Not ObjectToCheck.CheckFilling() Then 

		AllMessages = GetUserMessages(True);
		
		// The messages displayed when checking the filling of the object will be saved in the message text.
		For MessageNo = PreviousMessages.Count() To AllMessages.Count() - 1 Do
			
			CurMessage = AllMessages[MessageNo];
			
			MessageText = MessageText + ?(MessageText = "", "", "
				|") + MessagePrefix + CurMessage.Text;
			
		EndDo;
		
		// Let's return the previous messages to the message buffer.
		For MessageNo = 0 To PreviousMessages.Count() - 1 Do
			
			CurMessage = AllMessages[MessageNo];
			
			CurMessage.Message();
			
		EndDo;
		
	EndIf;
	
	Return MessageText;
	
EndFunction

// Returns the text of error messages that were issued during document execution.
//
// Parameters:
//	OngoingDocument - DocumentObject - the document to be drawn up.
//	MessagePrefix - String - the characters that you need to withdraw before each error message.
//
// Returns:
//	String - multiline message text.
//
Function ConductDocumentWithMessageInterception(OngoingDocument, MessagePrefix = "") Export
	
	MessageText = "";
	HadErrors = False;
	
	PreviousMessages = GetUserMessages(False);
	
	Try
		OngoingDocument.Write(DocumentWriteMode.Posting);
	Except
		HadErrors = True;
		ErrorText = DetailErrorDescription(ErrorInfo());
	EndTry;
	
	If Not HadErrors Then
		Return MessageText;
	EndIf;
	
	AllMessages = GetUserMessages(True);
	
	// The messages displayed during the object will be saved in the message text.
	For MessageNo = PreviousMessages.Count() To AllMessages.Count() - 1 Do
		
		CurMessage = AllMessages[MessageNo];
		
		MessageText = MessageText + ?(MessageText = "", "", "
			|") + MessagePrefix + CurMessage.Text;
		
	EndDo;
	
	// Let's return the previous messages to the message buffer.
	For MessageNo = 0 To PreviousMessages.Count() - 1 Do
		
		CurMessage = AllMessages[MessageNo];
		
		CurMessage.Message();
		
	EndDo;
	
	Return MessageText;
	
EndFunction

