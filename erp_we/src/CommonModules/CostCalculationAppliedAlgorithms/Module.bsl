Procedure AdjustBatchAccountingCriteriaForCalculation(CalculationParameters, QueryTextForAnalystSelection) Export
	
	If Not CalculationParameters.DistributionOfParties.AdditionalProperties.Property("PartyAccountingAnalysts") Then
		CalculationParameters.DistributionOfParties.AdditionalProperties.Insert("PartyAccountingAnalysts", New Map);
	EndIf;
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTPartyAnalyticsWithViewToValue");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT DISTINCT
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.LotVendorAttributes AS LotVendorAttributes
	|INTO TTUsedBatchAccountingAnalytics
	|FROM
	|	QueryTextForAnalystSelection AS T
	|WHERE
	|	T.LotVendorAttributes <> VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)
	|	AND T.LotVendorAttributes <> UNDEFINED
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.LotVendorAttributes AS LotVendorAttributes,
	|	MAX(CASE
	|			WHEN ISNULL(NomenclatureAnalysts.Products.ItemsType, VALUE(Enum.ItemsTypes.OwnGoods)) IN
	|				(VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
	|			THEN VALUE(Enum.AssetKinds.Goods)
	|			ELSE VALUE(Enum.AssetKinds.OtherWorksAndServices)
	|		END) AS AssetTaxClass
	|INTO TTOldBatchAccountingAnalysts
	|FROM
	|	TTUsedBatchAccountingAnalytics AS T
	|		INNER JOIN Catalog.KeysForLotVendorAttributes AS PartyAnalysts_
	|		ON T.LotVendorAttributes = PartyAnalysts_.Ref
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS NomenclatureAnalysts
	|		ON T.LotVendorAttributes = NomenclatureAnalysts.Ref
	|WHERE
	|	(PartyAnalysts_.AssetTaxClass = VALUE(Enum.AssetKinds.EmptyRef)
	|			OR PartyAnalysts_.FinancialAccountingGroup <> VALUE(Catalog.InventoryAccountingGroups.EmptyRef)
	|			OR PartyAnalysts_.VATTaxation <> VALUE(Enum.VATTaxationTypes.EmptyRef))
	|
	|GROUP BY
	|	T.LotVendorAttributes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	T.LotVendorAttributes AS LotVendorAttributes
	|FROM
	|	TTOldBatchAccountingAnalysts AS T";
	
	Query.Text = StrReplace(Query.Text, "QueryTextForAnalystSelection", "(" + QueryTextForAnalystSelection + ")");
	
	QueryResult = Query.Execute();
	
	If Not QueryResult.IsEmpty() Then
	
		GeneratePartyAnalystsWithViewOfValue(CalculationParameters, "TTOldBatchAccountingAnalysts");
		
		Query.Text =
		"SELECT
		|	T.LotVendorAttributes AS LotVendorAttributes,
		|	T.PartyAccountingAnalyticsWithValueView AS PartyAccountingAnalyticsWithValueView
		|FROM
		|	TTPartyAnalyticsWithViewToValue AS T";
		
		Selection = Query.Execute().Select();
		
		While Selection.Next() Do
			CalculationParameters.DistributionOfParties.AdditionalProperties.PartyAccountingAnalysts.Insert(
				Selection.LotVendorAttributes,
				Selection.PartyAccountingAnalyticsWithValueView);
		EndDo;
		
	EndIf;
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
	
	DestroyTemporaryTables(CalculationParameters,
		"TTUsedBatchAccountingAnalytics, TTOldBatchAccountingAnalysts, TTPartyAnalyticsWithViewToValue");
	
EndProcedure

// Procedure for debugging the calculation.
//
// Returns:
//	String -
//
Function BatchAllocationCallStack(CalculationParameters, AddFirstNodeToResult = True) Export
	
	StackDescription = "";
	
	If CalculationParameters.DistributionOfParties.CalculationStatistics.Count() = 0 Then
		Return StackDescription;
	EndIf;
	
	Statistics = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	
	If Statistics.CurDepth < 1 Then
		Return StackDescription;
	EndIf;
	
	StackDescription = "";
	
	For PC = 0 To Statistics.CurDepth - 1 + ?(AddFirstNodeToResult, 0, -1) Do
		StackDescription = Format(Statistics.CallsStack[PC], "NZ=0; NG=") + ?(StackDescription = "", "", "; ") + StackDescription;
	EndDo;
	
	Return StackDescription;
	
EndFunction

