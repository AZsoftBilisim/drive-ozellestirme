// Procedure-handler for checking the state of the system "Checking the use of returnable inputs in materials".
//
Procedure VerificationOfUseOfReturnableWasteInMaterials(CheckParameters) Export
	
	QueryText =
	"SELECT DISTINCT
	|	DocumentTable.Organization AS Organization,
	|	DocumentTable.Ref AS ProductionDocument
	|INTO IncorrectDocuments
	|FROM
	|	Document.BackflushProduction AS DocumentTable
	|		INNER JOIN Document.BackflushProduction.MaterialsAndWorks AS TableOfMaterials
	|		ON DocumentTable.Ref = TableOfMaterials.Ref
	|WHERE
	|	DocumentTable.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND DocumentTable.Organization IN(&CompanyArray)
	|	AND DocumentTable.Posted
	|	AND TableOfMaterials.ProductCostElement.ExpenseType = VALUE(Enum.CostTypes.RecyclableWaste)
	|
	
	
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	DocumentTable.Organization AS Organization,
	|	DocumentTable.Ref AS ProductionDocument
	|FROM
	|	Document.ProductionStage2_2 AS DocumentTable
	|		INNER JOIN Document.ProductionStage2_2.MaterialsAndWorksConsumption AS TableOfMaterials
	|		ON DocumentTable.Ref = TableOfMaterials.Ref
	|WHERE
	|	TableOfMaterials.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND DocumentTable.Organization IN(&CompanyArray)
	|	AND DocumentTable.Posted
	|	AND TableOfMaterials.ProductCostElement.ExpenseType = VALUE(Enum.CostTypes.RecyclableWaste)
	|";
	
	FieldList = New ValueList;
	FieldList.Add("Organization");
	FieldList.Add("ProductionDocument",		NStr("vi = 'Chứng từ sản xuất';
													|ru = 'Документ производства';
