EndFunction

// Returns the maximum number based on the transmitted bit depth and bit depth of the fractional part.
//  Parameters:
//   Digits - Number - The bit depth of the required number.
//   FractionDigits - Number - The bit depth of the fractional part of the required number.
//  
// Returns:
//  Number - The maximum number of the received bit depth.
//
Function GetMaximumValueOfNumber(Digits, FractionDigits) Export
	If Digits < FractionDigits Then
		Raise NStr("vi = 'Số chữ số của phần nguyên phải lớn hơn hoặc bằng số chữ số của phần thập phân.';
					|ru = 'Разрядность числа должна быть больше или равна разрядности дробной части.';
					|en = 'The bitness of the number must be greater than or equal to the bitness of the fractional part.'; fa = 'The bitness of the number must be greater than or equal to the bitness of the fractional part.';
					|it = 'The bitness of the number must be greater than or equal to the bitness of the fractional part.';
					|pl = 'The bitness of the number must be greater than or equal to the bitness of the fractional part.';
					|tr = 'Sayının bit genişliği sayısı, kesirli kısmın bit genişliği sayısından büyük veya ona eşit olmalıdır.'");
	EndIf;
		
	IntegerPart = Digits - FractionDigits;
	MaxValue = 0;
		
	If IntegerPart > 0 Then
		MaxValue = Pow(10, IntegerPart) - Pow(10, -FractionDigits);
	Else
		MaxValue = 1 - Pow(10, -FractionDigits);
	EndIf;
		
	Return MaxValue;
EndFunction

// Returns the number of rows in the temporary table.
// Call example: Calculation of the system costsadjustmentalgorithms.Size Of The Time Table(Calculation Parametres, " Vtcashsubstantial Goods")
//
// Returns:
//	Number -
//
Function TemporaryTableSize(ContainerManagerTT, TempTableName) Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	Query.Text =
	"SELECT
	|	COUNT(*) AS RowsCount
	|FROM
	|	TableName AS T";
	
	Query.Text = StrReplace(Query.Text, "TableName", TempTableName);
	
	Selection = Query.Execute().Select();
	Selection.Next();
	
	Return Selection.RowsCount;
	
EndFunction

// Returns the number of rows in all temporary tables.
// Call example: Calculation of the system costsadjustmentalgorithms.Size Of Time Tables(Calculation Parameters, True)
//
// Returns:
//	Structure -
//
Function TemporaryTableSizes(ContainerManagerTT, IgnoreEmptyTables = False) Export
	
	Result = New Structure("TotalSizeOfTables", 0);
	Subqueries = New Array;
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	QueryTextTemplate2 =
	"SELECT
	|	""TempTableName"" AS TableName,
	|	COUNT(*) AS Count
	|FROM
	|	TempTableName AS T
	|";
	
	For Each TempTable In Query.TempTablesManager.Tables Do
		Subqueries.Add(
			StrReplace(QueryTextTemplate2, "TempTableName", TempTable.FullName));
	EndDo;
	
	If Not ValueIsFilled(Subqueries) Then
		Return Result;
	EndIf;
	
	Query.Text = StrConcat(Subqueries, Chars.LF + "UNION ALL" + Chars.LF + Chars.LF);
	
	Selection = Query.Execute().Select();
	
	While Selection.Next() Do
		If Not (IgnoreEmptyTables And Selection.Count = 0) Then
			Result.Insert(Selection.TableName, Selection.Count);
			Result.TotalSizeOfTables = Result.TotalSizeOfTables + Selection.Count;
		EndIf;
	EndDo;
	
	Return Result;
	
EndFunction

// Returns the total for the specified field from the specified temporary table
// Call example: Calculation of the system costsadjustmentalgorithms.Aggregate Functionsof The Time Table(Calculation Parametres, "Vtkashsebestovost Of Goods", " Quantity")
//
// Returns:
//	Arbitrary -
//
Function AggregateFunctionOfTemporaryTableField(ContainerManagerTT, TempTableName, FieldName, FunctionName = "SUM") Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	Query.Text =
	"SELECT
	|	SUM(T.FieldName) AS Result
	|FROM
	|	TempTableName AS T";
	
	Query.Text = StrReplace(Query.Text, "SUM", FunctionName);
	Query.Text = StrReplace(Query.Text, "FieldName", FieldName);
	Query.Text = StrReplace(Query.Text, "TempTableName", TempTableName);
	
	Selection = Query.Execute().Select();
	Selection.Next();
	
	Return Selection.Result;
	
EndFunction

// Returns a string with column names that differ in the specified rows of the temporary table
// Example of a call: Calculation of the highest cost of a particular algorithm.Compare the rows of the time table(Calculation parameters, "VT Cash value of goods", 0, 2)
//
// Returns:
//	String -
//
Function CompareRowsOfTemporaryTables(ContainerManagerTT, TempTableName, LineNumber1, LineNumber2) Export
	
	Result = "";
	Table = UnloadTemporaryTable(ContainerManagerTT, TempTableName, LineNumber2 + 1);
	
	For Each CurrentColumn In Table.Columns Do
		
		If Table[LineNumber1][CurrentColumn.Name] <> Table[LineNumber2][CurrentColumn.Name] Then
			Result = Result + ?(Result = "", "", ", ") + CurrentColumn.Name;
		EndIf;
		
	EndDo;
	
	Return Result;
	
EndFunction

// Returns the required number of rows from the specified temporary table
// Call example: Calculation of the system costsadjustmentalgorithms.Unload The Time Table (Calculation Parameters, " Vtcashsubstantial Goods")
//
// Returns:
//	ValueTable -
//
Function UnloadTemporaryTable(ContainerManagerTT, TempTableName, RowsCount = Undefined, SortingText = "") Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	If RowsCount = Undefined Then
		
		Query.Text = 
		"SELECT
		|	T.*
		|FROM
		|	TempTableName AS T";
		
	Else
		
		Query.Text = 
		"SELECT TOP 0
		|	T.*
		|FROM
		|	TempTableName AS T";
		
		Query.Text = StrReplace(Query.Text, "0", Format(RowsCount, "NZ=0; NG=0"));
		
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "TempTableName", TempTableName);
	
	If ValueIsFilled(SortingText) Then
		Query.Text = Query.Text + "
		|ORDER BY
		|	" + SortingText;
	EndIf;
	
	UnloadedTable = Query.Execute().Unload();
	
	Return UnloadedTable;
	
EndFunction

// Uploads the specified temporary tables to a file
// Call example: Calculation of the system costsadjustmentalgorithms.Unload Time Tables(Calculation Parameters)
//
// Returns:
//	Structure -
//
Function UnloadTemporaryTables(ContainerManagerTT, StartWithTable = "", EndWithTable = "") Export
	
	UploadStarted = Not ValueIsFilled(StartWithTable);
	TempTableManager     = GetTTManagerFromContainer(ContainerManagerTT);
	Result      = New Structure;
	TableNumber   = 0;
	
	For Each TempTable In TempTableManager.Tables Do
		
		UploadStarted = (UploadStarted Or Lower(TempTable.FullName) = Lower(StartWithTable));
		
		If Not UploadStarted Then
			Continue;
		EndIf;
		
		TableNumber = TableNumber + 1;
		TableName   = "T" + Format(TableNumber, "ND=3; NLZ=") + "_" + TempTable.FullName;
		Table 	 = UnloadTemporaryTable(TempTableManager, TempTable.FullName);
		
		Result.Insert(TableName, Table);
		
		If ValueIsFilled(EndWithTable) And Lower(TempTable.FullName) = Lower(EndWithTable) Then
			Break;
		EndIf;
		
	EndDo;
	
	Return Result;
	
EndFunction

// Uploads the required number of rows from the specified temporary table to the file
// Call example: Calculation of the system costsadjustmentalgorithms.Unload A Timestamp Tablefile(Calculation Parameters, "Vtcashsubstantiation Of Goods", "C:\Temp\Table.mxl")
//
// Returns:
//	String -
//
Function UploadTemporaryTableToFile(ContainerManagerTT, TempTableName, FullFileName, RowsCount = Undefined, SortingText = "") Export
	
	UnloadedTable = UnloadTemporaryTable(ContainerManagerTT, TempTableName, RowsCount, SortingText);
	
	ErrorText = TMCommonUse.SaveTableOfValuesToFile(UnloadedTable, FullFileName);
	
	Return ErrorText;
	
EndFunction

// Uploads the specified temporary tables to a file
// Call example: Calculation of the system costsadjustmentalgorithms.Unload The Timestabletablefile(Calculation Parameters, "C:\Temp\Debug")
// 
// Returns:
// 	Boolean - LongDesc
Function UploadTemporaryTablesToFile(ContainerManagerTT, DirectoryName,
		ClearDirectory = True, StartWithTable = "",
		EndWithTable = "", FileType="mxl") Export

	UploadStarted = Not ValueIsFilled(StartWithTable);
	TempTableManager = GetTTManagerFromContainer(ContainerManagerTT);
	FullDirectoryName = CommonClientServer.AddLastPathSeparator(DirectoryName);

	HadErrors = False;
	Try
		If ClearDirectory Then
			DeleteFiles(FullDirectoryName, "*."+FileType);
		EndIf;
	Except
		HadErrors = True;
	EndTry;

	TableNumber = 0;

	For Each TempTable In TempTableManager.Tables Do

		UploadStarted = (UploadStarted
			Or Lower(TempTable.FullName) = Lower(StartWithTable));

		If Not UploadStarted Then
			Continue;
		EndIf;

		TableNumber = TableNumber + 1;

		UploadTemporaryTableToFile(TempTableManager, TempTable.FullName, FullDirectoryName
			+ "T" + Format(TableNumber, "ND=3; NLZ=") + "_"
			+ TempTable.FullName + "."+FileType);

		If ValueIsFilled(EndWithTable)
				And Lower(TempTable.FullName) = Lower(EndWithTable) Then
			Break;
		EndIf;

	EndDo;
	
	Return HadErrors;

EndFunction

// Selects the desired number of rows from the specified temporary table
// Call example: Calculation of the system costsadjustmentalgorithms.Select The Timestamp Table (Calculation Parametres, "Vtkashsebestovost Of Goods", 1)
//
// Returns:
//	QueryResultSelection -
//
Function SelectTemporaryTableRows(ContainerManagerTT, TempTableName, RowsCount = Undefined, SortingText = "") Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	Query.Text = GETRequestHeader(RowsCount) + "
	|	T.*
	|FROM
	|	%1 AS T";
	
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		Query.Text,
		TempTableName);
	
	If ValueIsFilled(SortingText) Then
		Query.Text = Query.Text + "
		|ORDER BY
		|	" + SortingText;
	EndIf;
	
	Selection = Query.Execute().Select();
	
	Return Selection;
	
EndFunction

