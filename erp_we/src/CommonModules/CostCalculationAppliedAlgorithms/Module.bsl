#Region ValuationMethods

// For the passed array of organizations, it determines the cost estimation method.
//
// Parameters:
//	CalculationParameters - See InitializeGeneralCalculationParameters
//	CompanyArray - Array - organizations.
//
// Returns:
//	EnumRef.InventoryValuationMethods - cost estimation method.
//
Function DetermineMethodOfValuationForGroupOfOrganizations(CalculationParameters, CompanyArray) Export
	
	If CalculationParameters.PreliminaryCalculation Then
		Return Enums.InventoryValuationMethods.AveragePerMonth;
	EndIf;
	
	CostEvaluationMethod   	   = Enums.InventoryValuationMethods.EmptyRef();
	SameEvaluationMethod  	   = True;
	ThereIsFIFOWeightedScore   = False;
	ThereAreOtherMethodsOfEvaluation     = False;
	ErrorText			   	   = "";
	
	ThereIsFIFOSlidingWithoutPU    = False;
	SFIFOOrganizationsSliding = New Array;
	
	OrganizationsWithErrors	   = Undefined;
	
	For Each Organization In CompanyArray Do

		EvaluationMethodByOrganization = DetermineMethodOfAssessingValueOfOrganizationSGoods(CalculationParameters, Organization);

		If CalculationParameters.BatchAccountingVersion22 Then // checking for batch accounting version 2.2
			
			// In the Cost Estimation method, either a FIFO-weighted estimate will be recorded, if such a method is used by all organizations
			// , or an empty link, meaning that organizations use both the Mid-month method and the FIFO-sliding estimate.
			If EvaluationMethodByOrganization = Enums.InventoryValuationMethods.FIFOWeightedEstimate Then
				ThereIsFIFOWeightedScore = True;
				CostEvaluationMethod 	 = EvaluationMethodByOrganization;
			Else
				ThereAreOtherMethodsOfEvaluation   = True;
			EndIf;
			
		Else // checking for batch accounting version 2.1 and disabled batch accounting
			
			// Only one assessment method common to all organizations is allowed, which will be recorded in the Cost Assessment Method.
			If CostEvaluationMethod <> EvaluationMethodByOrganization Then
				If Not ValueIsFilled(CostEvaluationMethod) Then 
					CostEvaluationMethod = EvaluationMethodByOrganization; // the first pass of the cycle
				Else
					SameEvaluationMethod = False;
				EndIf;
			EndIf;
			
			If CalculationParameters.BatchAccountingNotUsed
			 And EvaluationMethodByOrganization = Enums.InventoryValuationMethods.FIFORollingValuation Then
				
				ThereIsFIFOSlidingWithoutPU = True;
				SFIFOOrganizationsSliding.Add(Organization);
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
	If ThereIsFIFOWeightedScore And ThereAreOtherMethodsOfEvaluation Then // checking for batch accounting version 2.2
		OrganizationsWithErrors = CompanyArray;
		ErrorText = 
			NStr("vi = 'Kết hợp không hợp lệ các phương thức đánh giá giá trị tồn kho đối với các doanh nghiệp hoạt động theo cơ chế Liên công ty:
						|%Companies%.
						|Không thể sử dụng chung phương thức đánh giá ""FIFO đánh giá bình quân"" với các phương thức đánh giá khác bất kỳ.
						|Thực hiện tùy chỉnh phương thức đánh giá giá trị trong chính sách kế toán của doanh nghiệp.';
						|ru = 'Недопустимое сочетание методов оценки стоимости запасов для организаций, работающих по схеме Интеркампани:
						|%Companies%.
						|Метод оценки ""ФИФО взвешенная оценка"" не может использоваться совместно с любыми другими методами оценки.
						|Настройка метода оценки стоимости выполняется в учетной политике организаций.';
						|en = 'Invalid combination of inventory cost evaluation methods for companies operating under Intercompany:
						|%Companies%. 
						|You cannot use the ""FIFO weighted estimate"" evaluation method with any other evaluation methods.
						|You can configure a cost evaluation method in the company accounting policy.'; fa = 'Invalid combination of inventory cost evaluation methods for companies operating under Intercompany:
						|%Companies%. 
