#Region SupportingProcedures

// Records information about the problem diagnosed during batch and cost calculations in the information security system.
// It is a wrapper to the procedure for closing the month Server.Register the problem of completing the calculation().
//
// Parameters:
//	CalculationParameters  - Structure - calculation parameters, See InitializeGeneralCalculationParameters
//                                 ()
//	CompanyArray - Array - organizations that the issue applies to
//							if not specified, the problem applies to each of the calculated organizations
//	IssueText 	  - String - brief information about the problem; displayed in the form of closing the month
//	ClarificationText 	  - String - detailed description of the problem; problems in the form of closing the month are grouped by Testproblem + Importance, and this text is displayed in the form of a problem transcript
//	Object 			  - Arbitrary - object for decoding the problem
//	Importance 		  - EnumRef.AccountingIssueSeverity - the status of the issue; the default is "Error".
//	
Procedure RegisterCalculationExecutionProblem(CalculationParameters, CompanyArray = Undefined,
			IssueText = "", ClarificationText = "", Object = Undefined, Importance = Undefined) Export
	
	TheseArePoolCalculationParameters = CalculationParameters.Property("TheseArePoolCalculationParameters");
	
	// Let's write down information about the presence of errors in the mechanism of closing the month.
	If ValueIsFilled(CompanyArray) Then
		OrganizationsForProtocol = CompanyArray;
	Else		
		OrganizationsForProtocol = ?(TheseArePoolCalculationParameters, CalculationParameters.CopyArrayOfOrganizations, CalculationParameters.CompanyArray);
	EndIf;
	
	If Not ValueIsFilled(OrganizationsForProtocol) Then
		OrganizationsForProtocol = Catalogs.Companies.AvailableCompanies();
	EndIf;
	
	OrganizationsForProtocol = TMCommonUseClientServer.Array(OrganizationsForProtocol);
	
	If Not ValueIsFilled(IssueText) Then
		IssueText = NStr("vi = 'Khi thực hiện tính toán, đã chẩn đoán được lỗi';
						|ru = 'При выполнении расчета были диагностированы ошибки';
						|en = 'Errors were found when calculating'; fa = 'Errors were found when calculating';
						|it = 'Durante l''esecuzione del conto sono stati diagnosticati degli errori';
						|pl = 'Podczas wykonywania obliczeń zostały zdiagnozowane błędy';
						|tr = 'Mutabakat gerçekleştirilmesi sırasında hatalar teşhis edildi'", Common.DefaultLanguageCode());
	EndIf;
	
	FullTextOfProblem = IssueText
		+ ?(OrganizationsForProtocol.Count() = 1, " " + NStr("vi = 'theo doanh nghiệp ""%1"" trong kỳ ""%2""';
															|ru = 'по организации ""%1"" за период ""%2""';
															|en = 'of the ""%1"" company for the ""%2"" period'; fa = 'of the ""%1"" company for the ""%2"" period';
															|it = 'nell''organizzazione ""%1"" per il periodo ""%2""';
															|pl = 'wg firmy ""%1"" za okres ""%2""';
															|tr = '""%2"" dönem içerisinde ""%1"" iş yeri'", Common.DefaultLanguageCode()), "");
	
	For Each CurrentCompany In OrganizationsForProtocol Do
		
		RegistrationParameters = MonthEndTransactionsServer.InitializeParametersForRegisteringCalculationProblem(
			Catalogs.MonthEndClosingOperations.LotsAndCostCalculation,
			CurrentCompany,
			CalculationParameters.PayrollPeriod.BeginOfPeriod);
		
		MonthEndTransactionsServer.RegisterCalculationExecutionProblem(
			RegistrationParameters,
			FullTextOfProblem,
			Importance,
			StrReplace(ClarificationText, ServiceSymbol_ProblemAlreadyRegistered(), ""),
			Object);
		
	EndDo;
	
EndProcedure

