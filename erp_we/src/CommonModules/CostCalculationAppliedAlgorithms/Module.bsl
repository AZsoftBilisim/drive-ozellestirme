//	CompanyTable - ValueTable
// 		* Company - Directory link.Companies - Company
// 		* Period - Date - Period
//
Procedure ToFormTTTypesOfVATActivities(Query, CompanyTable) Export
	
	TableTypesOfVATActivities = New ValueTable;
