// Defines the organizations that require the specified adjustment in the calculated period.
//
Procedure InitializeDescriptionOfOrganizationsToMakeAdjustments(CalculationParameters, AdjustmentParameters) Export
	
	TableOfTypesOfAdjustments = DescriptionOfInitialBalanceAdjustments();
	DescriptionOfAdjustment 	  = TableOfTypesOfAdjustments.Find(AdjustmentParameters.AdjustmentRecordType);
	
	If DescriptionOfAdjustment = Undefined Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Chưa tìm thấy mô tả điều chỉnh ""%1"" trong %2';
				|ru = 'Не найдено описание корректировки ""%1"" в %2';
				|en = 'Cannot find ""%1"" adjustment description in %2'; fa = 'Cannot find ""%1"" adjustment description in %2';
				|it = 'Descrizione della correzione ""%1"" in %2 non trovata';
				|pl = 'Nie znaleziono opisu korekty ""%1"" w %2';
				|tr = '%2''de ""%1"" düzeltmesi için ayrıntılar bulunamadı'", Common.DefaultLanguageCode()),
			AdjustmentParameters.AdjustmentRecordType,
			"CostCalculationAppliedAlgorithms.DescriptionOfInitialBalanceAdjustments");
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorOfInitializingCalculationParameters,
			ProtocolText_);
		
		Raise TextExceptionToLogProblem(ProtocolText_);
		
	EndIf;
	
	AdjustmentParameters.Insert("SeparateItIntoSeparateDocument", DescriptionOfAdjustment.SeparateItIntoSeparateDocument);
	
	If DescriptionOfAdjustment.MultipleExecutionIsPossible Then
		AdjustmentParameters.Insert("OrganizationsToAdjust", CalculationParameters.CompanyArray);
		AdjustmentParameters.Insert("AdjustmentRequired", ValueIsFilled(AdjustmentParameters.OrganizationsToAdjust));
		Return;
	EndIf;
		
	Query = New Query;
	Query.Text =
	"SELECT
	|	Companies.Ref 						   		   AS Organization,
	|	&AdjustmentRecordType 						   AS AdjustmentRecordType,
	|	&RegisterName 									   AS RegisterName,
	|	ISNULL(T.AdjustmentDate, DATETIME(1, 1, 1))  AS AdjustmentDate,
	|	ISNULL(T.AdjustmentDate, DATETIME(1, 1, 1))  AS CorrectionDatePrevious,
	|	ISNULL(T.ValidityStartDate, DATETIME(1, 1, 1)) AS ValidityStartDate,
	|	ISNULL(T.ValidityStartDate, DATETIME(1, 1, 1)) AS StartDatePrevious
	|FROM
	|	Catalog.Companies AS Companies
	|		LEFT JOIN InformationRegister.CostCalculationStockAdjustmentDates AS T
	|			ON T.Organization = Companies.Ref
	|			 AND T.AdjustmentRecordType = &AdjustmentRecordType
	|			 AND T.RegisterName = &RegisterName
	|WHERE
	|	Companies.Ref IN(&CompanyArray)";
	
	Query.SetParameter("CompanyArray", 		CalculationParameters.CompanyArray);
	Query.SetParameter("BeginOfPeriod", 	   		CalculationParameters.PayrollPeriod.BeginOfPeriod);
	Query.SetParameter("AdjustmentRecordType", AdjustmentParameters.AdjustmentRecordType);
	Query.SetParameter("RegisterName", 			AdjustmentParameters.RegisterName);
	
	MakingAdjustments = Query.Execute().Unload();
	OrganizationsToAdjust = New Array;
	
	For Each CurrentRow In MakingAdjustments Do
		
		If ValueIsFilled(DescriptionOfAdjustment.NameOfStartDateConstant) Then
			
			If Not ValueIsFilled(DescriptionOfAdjustment.NameOfInclusionConstant)
			 Or Constants[DescriptionOfAdjustment.NameOfInclusionConstant].Get() Then
				
				CurrentRow.ValidityStartDate = BegOfMonth(Constants[DescriptionOfAdjustment.NameOfStartDateConstant].Get());
				
				If CurrentRow.ValidityStartDate = CalculationParameters.PayrollPeriod.BeginOfPeriod Then
					
					CurrentRow.AdjustmentDate = CalculationParameters.PayrollPeriod.BeginOfPeriod;
					OrganizationsToAdjust.Add(CurrentRow.Organization);
					
				EndIf;
				
			EndIf;
			
		ElsIf Not ValueIsFilled(DescriptionOfAdjustment.ParentalAdjustment) Then
			
			If Not ValueIsFilled(DescriptionOfAdjustment.NameOfInclusionConstant)
			 Or Constants[DescriptionOfAdjustment.NameOfInclusionConstant].Get() Then
				
				CurrentRow.ValidityStartDate = Date(1, 1, 1);
				
				If Not ValueIsFilled(CurrentRow.AdjustmentDate)
				 Or CurrentRow.AdjustmentDate >= CalculationParameters.PayrollPeriod.BeginOfPeriod Then
					
					CurrentRow.AdjustmentDate = CalculationParameters.PayrollPeriod.BeginOfPeriod;
					OrganizationsToAdjust.Add(CurrentRow.Organization);
					
				EndIf;
				
			EndIf;
			
		Else // there is a parental correction
			
			DescriptionOfParentAdjustment = TableOfTypesOfAdjustments.Find(DescriptionOfAdjustment.ParentalAdjustment);
			
			If DescriptionOfParentAdjustment = Undefined Then
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Chưa tìm thấy mô tả điều chỉnh ""%1"" trong %2';
						|ru = 'Не найдено описание корректировки ""%1"" в %2';
						|en = 'Cannot find ""%1"" adjustment description in %2'; fa = 'Cannot find ""%1"" adjustment description in %2';
						|it = 'Descrizione della correzione ""%1"" in %2 non trovata';
						|pl = 'Nie znaleziono opisu korekty ""%1"" w %2';
						|tr = '%2''de ""%1"" düzeltmesi için ayrıntılar bulunamadı'", Common.DefaultLanguageCode()),
					DescriptionOfAdjustment.ParentalAdjustment,
					"CostCalculationAppliedAlgorithms.DescriptionOfInitialBalanceAdjustments");
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorOfInitializingCalculationParameters,
					ProtocolText_);
				
				Raise TextExceptionToLogProblem(ProtocolText_);
				
			ElsIf DescriptionOfParentAdjustment.MultipleExecutionIsPossible
			 Or Not ValueIsFilled(DescriptionOfParentAdjustment.NameOfStartDateConstant) Then
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Sai mô tả điều chỉnh ""%1"" trong %2';
						|ru = 'Некорректное описание корректировки ""%1"" в %2';
						|en = 'Invalid ""%1"" adjustment description in %2'; fa = 'Invalid ""%1"" adjustment description in %2';
						|it = 'Descrizione errata della correzione ""%1"" in %2';
						|pl = 'Nieprawidłowy opis korekty ""%1"" w %2';
						|tr = '%2''deki ""%1"" düzeltmelerin yanlış ayrıntıları '", Common.DefaultLanguageCode()),
					DescriptionOfAdjustment.ParentalAdjustment,
					"CostCalculationAppliedAlgorithms.DescriptionOfInitialBalanceAdjustments");
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorOfInitializingCalculationParameters,
					ProtocolText_);
				
				Raise TextExceptionToLogProblem(ProtocolText_);
				
			EndIf;
			
			CurrentRow.ValidityStartDate = Date(1, 1, 1);
			
			StartDateOfParentAdjustment =
				BegOfMonth(Constants[DescriptionOfParentAdjustment.NameOfStartDateConstant].Get());
			ParentalAdjustmentIsEnabled =
				Not ValueIsFilled(DescriptionOfParentAdjustment.NameOfInclusionConstant)
			 	Or Constants[DescriptionOfParentAdjustment.NameOfInclusionConstant].Get();
			
		 	If ParentalAdjustmentIsEnabled
			 And StartDateOfParentAdjustment <= CalculationParameters.PayrollPeriod.BeginOfPeriod Then
				// Not required during the validity period of the parent adjustment
			ElsIf Not ValueIsFilled(CurrentRow.AdjustmentDate)
			 Or CurrentRow.AdjustmentDate >= CalculationParameters.PayrollPeriod.BeginOfPeriod Then
				
				// You need to adjust
				CurrentRow.AdjustmentDate = CalculationParameters.PayrollPeriod.BeginOfPeriod;
				OrganizationsToAdjust.Add(CurrentRow.Organization);
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
	AdjustmentParameters.Insert("OrganizationsToAdjust", OrganizationsToAdjust);
	AdjustmentParameters.Insert("AdjustmentRequired", ValueIsFilled(AdjustmentParameters.OrganizationsToAdjust));
	
	If Not AdjustmentParameters.Property("MakingAdjustments") Then
		
		AdjustmentParameters.Insert("MakingAdjustments", MakingAdjustments);
		
	Else
		
		Table = AdjustmentParameters.MakingAdjustments; // ValueTable
		For Each CurrentRow In MakingAdjustments Do
			FillPropertyValues(Table.Add(), CurrentRow);
		EndDo;
		
	EndIf;
		
EndProcedure

// Generates records of the register for calculating the cost of data and correcting the data After the correction is completed.
//
Procedure RecordFactThatAdjustmentWasMade(CalculationParameters, AdjustmentParameters) Export
	
	If Not AdjustmentParameters.Property("MakingAdjustments") Then
		Return;
	EndIf;
	
	For Each CurrentRow In AdjustmentParameters.MakingAdjustments Do
		
		If CurrentRow.AdjustmentDate = CurrentRow.CorrectionDatePrevious
		 And CurrentRow.ValidityStartDate = CurrentRow.StartDatePrevious Then
			Continue;
		EndIf;
		
		RecordSet = InformationRegisters.CostCalculationStockAdjustmentDates.CreateRecordSet();
		RecordSet.Filter.Organization.Set(CurrentRow.Organization);
		RecordSet.Filter.AdjustmentRecordType.Set(CurrentRow.AdjustmentRecordType);
		RecordSet.Filter.RegisterName.Set(CurrentRow.RegisterName);
		
		FillPropertyValues(RecordSet.Add(), CurrentRow);
		
		RecordSet.Write(True);
		
	EndDo;
	
	AdjustmentParameters.Delete("MakingAdjustments");
	
EndProcedure

// Checks whether the calculation period matches at least one of the start constants of the functional related to batch accounting.
//
// Returns:
//	Boolean -
//
Function ThereAreMandatoryAdjustmentsToBalances(Period) Export
	
	For Each DescriptionOfAdjustment In DescriptionOfInitialBalanceAdjustments() Do
	
		If ValueIsFilled(DescriptionOfAdjustment.NameOfStartDateConstant)
		 And BegOfMonth(Period) = BegOfMonth(Constants[DescriptionOfAdjustment.NameOfStartDateConstant].Get()) Then
			Return True;
		EndIf;
		
	EndDo;
	
	Return False;
	
EndFunction

