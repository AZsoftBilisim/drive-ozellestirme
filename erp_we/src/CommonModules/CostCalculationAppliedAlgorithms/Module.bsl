// Returns the actual required start of the calculation period.
//
// Returns:
//	Date -
//
Function StartOfSettlementPeriod(Date, CompanyArray) Export
	Var Result;
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	Companies.Ref AS Organization,
	|	MIN(BEGINOFPERIOD(Jobs.Month, Month)) AS Month
	|INTO TTPeriods
	|FROM
	|	Catalog.Companies AS Companies
	|		LEFT JOIN InformationRegister.JobsForCalculatingCost AS Jobs
	|		ON Companies.Ref = Jobs.Organization
	|WHERE
	|	Companies.Ref IN(&CompanyArray)
	|
	|GROUP BY
	|	Companies.Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	MIN(T.Month) AS StartOfSettlementPeriod
	|FROM
	|	TTPeriods AS T
	|WHERE
	|	T.Month IS NOT NULL 
	|	AND T.Month <= &Date
	|
	|HAVING
	|	MIN(T.Month) IS NOT NULL";
	
	Query.SetParameter("Date", 			   Date);
	Query.SetParameter("CompanyArray", TMCommonUseClientServer.Array(CompanyArray));
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then
		Result = ?(ValueIsFilled(Selection.StartOfSettlementPeriod), BegOfMonth(Selection.StartOfSettlementPeriod), Undefined);
	EndIf;
	
	If Not ValueIsFilled(Result) Then
		Result = EndOfMonth(Date) + 1;
	EndIf;
	
	Return Result;
	
EndFunction

// Returns an empty batch and cost conversion scheme.
//
// Returns:
//	ValueTable - an empty table of values, see the composition of columns in the body of the function.
//
Function EmptyBatchCalculationScheme() Export
	
	BatchCalculationScheme = New ValueTable; // the result of this function
	
	BatchCalculationScheme.Columns.Add("Date", 					  New TypeDescription("Date"));   // required conversion period
	BatchCalculationScheme.Columns.Add("Companies", 			  New TypeDescription("Array")); // array of organizations to recalculate in this period
	BatchCalculationScheme.Columns.Add("CalculatedCompanies", New TypeDescription("String")); // string Presentation of organizations
	BatchCalculationScheme.Columns.Add("DocumentsChanged", 	  New TypeDescription("Number"));  // for information, the number of changed documents in this period for these organizations
	
	BatchCalculationScheme.Indexes.Add("Date");
	
	Return BatchCalculationScheme;
	
EndFunction

// Returns information about which periods and organizations need to recalculate batches and production costs.
// The function parameters are the required selections by date and organization,
// and the result is the actual recalculations (according to is data).
// For example, it may happen that
//	- you want to recalculate only one organization in the current month ,
//  - but to do this, you need to recalculate all organizations starting from last year,
//	  because they have entries in the task register of the current account And the organizations are linked according to the Intercampany scheme.
//
// Parameters:
//	Date - Date - the end of the period (month) in which to perform the conversion
//	FilterCompanies - CatalogRef.Companies, Array - organizations that need to be recalculated
//	TaskNumberToBlock - Number, Undefined - The number of the task to lock the task register is the number of the priority.
//	OnlyOneOrganization - Boolean - A sign of calculating only one organization without adding links according to the intercampany scheme.
//
// Returns:
//	ValueTable - the scheme for the recalculation of batches and cost, see the description. In the Empty Part Count()
// 	chart, the table is sorted by the Date column and contains all periods (without omissions),
// 	starting from the earliest required recalculation date and up to the date from the Date parameter.
// 	There will be no rows in the table if recalculation is not required,
// 	that is, if the Date parameter is greater than the dates in the records of the task register of the accountability.
//
Function BatchCalculationScheme(Val Date = Undefined, FilterCompanies = Undefined,
			TaskNumberToBlock = Undefined, OnlyOneOrganization = False) Export
	
	Date 			  		= EndOfMonth(?(Not ValueIsFilled(Date), CurrentSessionDate(), Date));
	CompanyArray 		= TMCommonUseClientServer.Array(FilterCompanies);
	ByAllCompanies 		= Not ValueIsFilled(FilterCompanies);
	
	Query = New Query;
	
	Query.TempTablesManager = New TempTablesManager();
	
	Query.SetParameter("Date",               Date);
	Query.SetParameter("UseManagementCompany", GetFunctionalOption("UseManagementCompany"));
	Query.SetParameter("Companies",        CompanyArray);
	Query.SetParameter("ByAllCompanies", ByAllCompanies);
	
	Query.Text =
	"SELECT
	|	ENDOFPERIOD(Jobs.Month, Month) AS Month,
	|	Jobs.Organization AS Organization,
	|	0 AS DocumentsChanged
	|INTO TTTasksForCalculatingCostPreliminary
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS Jobs
	|	INNER JOIN Catalog.Companies AS Companies
	|		ON Jobs.Organization = Companies.Ref
	|WHERE
	|	Jobs.Document = UNDEFINED
	|	AND BEGINOFPERIOD(Jobs.Month, Month) <= &Date
	|	AND NOT Companies.DeletionMark
	|	AND CASE
	|			WHEN NOT &UseManagementCompany
	|					AND Companies.Ref = VALUE(Catalog.Companies.ManagementCompany)
	|				THEN FALSE
	|			ELSE TRUE
	|		END
	|
	|GROUP BY
	|	ENDOFPERIOD(Jobs.Month, Month),
	|	Jobs.Organization
	|
	|UNION ALL
	|
	|SELECT
	|	ENDOFPERIOD(Jobs.Month, Month) AS Month,
	|	Jobs.Organization AS Organization,
	|	COUNT(DISTINCT Jobs.Document) AS DocumentsChanged
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS Jobs
	|	INNER JOIN Catalog.Companies AS Companies
	|		ON Jobs.Organization = Companies.Ref
	|WHERE
	|	Jobs.Document <> UNDEFINED
	|	AND BEGINOFPERIOD(Jobs.Month, Month) <= &Date
	|	AND NOT Companies.DeletionMark
	|	AND CASE
	|			WHEN NOT &UseManagementCompany
	|					AND Companies.Ref = VALUE(Catalog.Companies.ManagementCompany)
	|				THEN FALSE
	|			ELSE TRUE
	|		END
	|
	|GROUP BY
	|	ENDOFPERIOD(Jobs.Month, Month),
	|	Jobs.Organization
	|
	|INDEX BY
	|	Organization
	|;
	|
	|SELECT
	|	Jobs.Month AS Month,
	|	Jobs.Organization AS Organization,
	|	SUM(Jobs.DocumentsChanged) AS DocumentsChanged
	|INTO TTTasksForCalculatingCost
	|FROM
	|	TTTasksForCalculatingCostPreliminary AS Jobs
	|WHERE
	|	Jobs.Organization IN (&Companies)
	|		OR &ByAllCompanies
	|
	|GROUP BY
	|	Jobs.Organization,
	|	Jobs.Month
	|;
	|";
	
	Query.Execute();
	
	// We will limit the list of organizations only to those for which there are tasks for calculating the cost.
	Query.Text = "
	|SELECT DISTINCT
	|	Jobs.Organization AS Organization
	|FROM
	|	TTTasksForCalculatingCost AS Jobs
	|";
	
	CompanyArray = Query.Execute().Unload().UnloadColumn("Organization");
	
	If OnlyOneOrganization Then
		FullArrayOfOrganizations = CompanyArray;
	Else
		FullArrayOfOrganizations = LinksOfOrganizationsUnderIntercampanyScheme(Date, CompanyArray);
	EndIf;
	
	CalculationScheme = EmptyBatchCalculationScheme(); // the result of this function
	
	If Not CalculationOfCostCached.CostCalculationIsPossible(BegOfMonth(Date)) Then
		Return CalculationScheme;
	EndIf;
	
	If TaskNumberToBlock <> Undefined Then
		// We will set up locks on organizations for recalculation.
		BlockTaskRegister(TaskNumberToBlock, FullArrayOfOrganizations);
	EndIf;
	
	RecalculationDatesForOrganizations = New Map; // Organization - The date from which it needs to be recalculated
	EarliestRecountDate    = EndOfMonth(EndOfMonth(Date) + 1);
	
	RecalculationBySourceOrganizationsIsRequired = False;
	
	// Let's remember the start dates of the recalculation for each organization.
	Query.Text =
	"SELECT
	|	Jobs.Organization AS Organization,
	|	MIN(Jobs.Month) AS Month
	|FROM
	|	TTTasksForCalculatingCost AS Jobs
	|
	|GROUP BY
	|	Jobs.Organization
	|";
	
	Selection = Query.Execute().Select();
	
	While Selection.Next() Do
		
		If FullArrayOfOrganizations.Find(Selection.Organization) <> Undefined Then
			RecalculationBySourceOrganizationsIsRequired = True;
		EndIf;
		
		RecalculationDatesForOrganizations.Insert(Selection.Organization, Selection.Month);
		EarliestRecountDate = Min(EarliestRecountDate, Selection.Month);
		
	EndDo;
	
	// Let's collect statistics on document changes - to understand the intensity of document changes "retroactively".
	Query.Text =
	"SELECT
	|	Jobs.Month AS Month,
	|	Jobs.Organization AS Organization,
	|	Jobs.DocumentsChanged AS DocumentsChanged
	|FROM
	|	TTTasksForCalculatingCost AS Jobs
	|WHERE
	|	Jobs.DocumentsChanged <> 0
	|
	|ORDER BY
	|	Month,
	|	Organization
	|";
	
	TableOfModifiedDocuments = Query.Execute().Unload();
	TableOfModifiedDocuments.Indexes.Add("Month, Organization");
	
	// Let's add lines to the calculation scheme for each period, starting from the earliest and up to the calculated period.
	Processing_Date = EarliestRecountDate;
	
	While Processing_Date <= Date Do
		
		AddLineOfBatchCalculationScheme(
			CalculationScheme,
			Processing_Date,
			?(Processing_Date = Date, FullArrayOfOrganizations, New Array));
		
		Processing_Date = EndOfMonth(EndOfMonth(Processing_Date) + 1);
		
	EndDo;
	
	// Let's iteratively fill in the organizations for recalculation.
	Processing_Date = Max(EarliestRecountDate, Date);
	
	While Processing_Date <= Date Do
		
		CurrentRow    = CalculationScheme.Find(Processing_Date, "Date");
		PreviousString = CalculationScheme.Find(BegOfMonth(Processing_Date) - 1, "Date");
		
		If PreviousString <> Undefined Then
			
			ThereWereChangesInArrayOfOrganizations = False;
			
			// Organizations that were recalculated in the last period should be recalculated in the current one.
			For Each PreviousOrganization In PreviousString.Companies Do
				If TMCommonUseClientServer.AddNewValueToArray(CurrentRow.Companies, PreviousOrganization) Then
					ThereWereChangesInArrayOfOrganizations = True;
				EndIf;
			EndDo;
			
			// Let's add the array of calculated organizations to the organizations associated with them.
			If ThereWereChangesInArrayOfOrganizations Then
				CurrentRow.Companies = LinksOfOrganizationsUnderIntercampanyScheme(CurrentRow.Date, CurrentRow.Companies);
			EndIf;
			
		EndIf;
		
		ModifiedProcessedDate = Processing_Date;
		
		// Let's check the need to recalculate the organizations of the current period in earlier periods.
		For Each CurrentCompany In CurrentRow.Companies Do
			
			DateOfRecalculationByOrganization = RecalculationDatesForOrganizations[CurrentCompany];
			
			If ValueIsFilled(DateOfRecalculationByOrganization) And DateOfRecalculationByOrganization < Processing_Date Then
				
				StringByOrganizationDate = CalculationScheme.Find(DateOfRecalculationByOrganization, "Date");
				
				If TMCommonUseClientServer.AddNewValueToArray(StringByOrganizationDate.Companies, CurrentCompany) Then
					// Such an organization in that period had not yet been selected for recalculation.
					ModifiedProcessedDate = Min(ModifiedProcessedDate, DateOfRecalculationByOrganization);
				EndIf;
				
			EndIf;
			
		EndDo;
		
		If ModifiedProcessedDate < Processing_Date Then
			
			// Let's start the next cycle with the earliest modified past period.
			Processing_Date = ModifiedProcessedDate;
			
			// Let's add an array of calculated organizations in it with related organizations.
			CurrentRow = CalculationScheme.Find(Processing_Date, "Date");
			CurrentRow.Companies = LinksOfOrganizationsUnderIntercampanyScheme(CurrentRow.Date, CurrentRow.Companies);
			
		Else
			
			// Nothing has changed in the past periods - we are moving on to the next period.
			Processing_Date = EndOfMonth(EndOfMonth(Processing_Date) + 1);
			
		EndIf;
		
	EndDo;
	
	While CalculationScheme.Count() > 0 And CalculationScheme[0].Companies.Count() = 0 Do
		// Deleting rows from earlier periods that don't have organizations to recalculate.
		CalculationScheme.Delete(0);
	EndDo;
	
	If CalculationScheme.Count() > 0 And ValueIsFilled(CompanyArray) Then
		
		// If
		// - no organization that is not included in the initial selection (taking into account the Intercampany) has been included in the compiled calculation scheme (by And)
		// - for the organizations themselves that are included with the initial selection, recalculation is not required,
		// then it is not necessary to perform the calculation.
		IntersectionOfArrays = TMCommonUseClientServer.IntersectionOfArrays(
			FullArrayOfOrganizations,
			CalculationScheme[CalculationScheme.Count() - 1].Companies);
		
		If IntersectionOfArrays.Count() = FullArrayOfOrganizations.Count() // only organizations from the initial selection
		 And Not RecalculationBySourceOrganizationsIsRequired Then // recalculation for these organizations is not required
			
			CalculationScheme.Clear();
			
		EndIf;
		
	EndIf;
	
	CompaniesList = New ValueList;
	
	For Each CurrentRow In CalculationScheme Do
		
		// Let's form string representations of recalculated organizations.
		CompaniesList.LoadValues(CurrentRow.Companies);
		CompaniesList.SortByValue();
		
		CurrentRow.Companies 			   = CompaniesList.UnloadValues();
		CurrentRow.CalculatedCompanies = CalculatedCompanies(CurrentRow.Companies);
		CurrentRow.DocumentsChanged	   = 0;
		
		// Let's fill in the statistics of document changes for the period for an array of organizations.
		For Each CurrentCompany In CurrentRow.Companies Do
			
			DocumentStrings = TableOfModifiedDocuments.FindRows(
				New Structure("Month, Organization", CurrentRow.Date, CurrentCompany));
				
			If DocumentStrings.Count() = 1 Then
				CurrentRow.DocumentsChanged = CurrentRow.DocumentsChanged + DocumentStrings[0].DocumentsChanged;
			EndIf;
			
		EndDo;
		
	EndDo;
	
	// We exclude from the calculation scheme the periods in which cost accounting is not conducted.
	While CalculationScheme.Count() > 0
	 And Not CalculationOfCostCached.CostCalculationIsPossible(BegOfMonth(CalculationScheme[0].Date)) Do
		
		InformationRegisters.JobsForCalculatingCost.ClearRecordsForPeriod(
			BegOfMonth(CalculationScheme[0].Date),
			EndOfMonth(CalculationScheme[0].Date),
			CalculationScheme[0].Companies);
		
		CalculationScheme.Delete(0);
		
	EndDo;
	
	If TaskNumberToBlock <> Undefined And CalculationScheme.Count() > 0 Then
		// We will set up locks on additional organizations for recalculation added when building the calculation scheme.
		BlockTaskRegister(TaskNumberToBlock, CalculationScheme[CalculationScheme.Count() - 1].Companies);
	EndIf;
	
	Return CalculationScheme;
	
EndFunction

Procedure AddLineOfBatchCalculationScheme(CalculationScheme, Date, CompanyArray, FillInPresentation = False) Export
	
	NewRow = CalculationScheme.Add();
	NewRow.Date = EndOfMonth(Date);
	NewRow.Companies = Common.CopyRecursive(CompanyArray);
	
	If FillInPresentation Then
		NewRow.CalculatedCompanies = CalculatedCompanies(NewRow.Companies);
	EndIf;
	
EndProcedure

	
// Returns the number of the task to be calculated that was increased before the calculation started.
//
// Returns:
//	Number -
//
Function IncreaseTaskNumberForCostCalculation() Export
	
	JobNumber = InformationRegisters.JobsForCalculatingCost.IncreaseTaskNumber();
	
	Return JobNumber;
	
EndFunction

// Sets the flag for the end of batch calculation in the specified period.
//
Procedure IncreaseCostCalculationPeriod(CalculatedPeriod, CompanyArray, TemporaryTable, CalculationParameters = Undefined) Export
	
	If ExchangePlans.MasterNode() <> Undefined Then
		Return;
	EndIf;
	
	SetPrivilegedMode(True);
	
	If StartOfSettlementPeriod(CalculatedPeriod, CompanyArray) < BegOfMonth(CalculatedPeriod)
	 And (CalculationParameters = Undefined Or Not CalculationParameters.Debug.DisableCostCalculationInPastPeriods) Then
		Return; // there are earlier uncounted periods
	EndIf;
	
	Query = New Query("
	|SELECT
	|	InitialTasks.Month,
	|	InitialTasks.JobNumber,
	|	InitialTasks.Organization,
	|	InitialTasks.Document
	|INTO CleaningTasks
	|FROM
	|	InitialTasks AS InitialTasks
	|WHERE
	|	InitialTasks.Month BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|;
	|////////////////////////////////////////////
	|SELECT
	|	&NextMonth AS Month,
	|	MAX(CleaningTasks.JobNumber) AS JobNumber,
	|	CleaningTasks.Organization AS Organization,
	|	UNDEFINED AS Document
	|INTO NewFrontiers
	|FROM
	|	CleaningTasks AS CleaningTasks
	|
	|GROUP BY
	|	CleaningTasks.Organization 
	|;
	|////////////////////////////////////////////
	|SELECT
	|	InitialTasks.Month,
	|	InitialTasks.JobNumber,
	|	InitialTasks.Organization,
	|	InitialTasks.Document
	|INTO InitialTimeTasks
	|FROM
	|	InitialTasks AS InitialTasks
	|	
	|WHERE
	|	NOT (InitialTasks.Month BETWEEN &BeginOfPeriod AND &EndOfPeriod)
	|
	|UNION ALL
	|
	|SELECT
	|	NewFrontiers.Month AS Month,
	|	NewFrontiers.JobNumber AS JobNumber,
	|	NewFrontiers.Organization AS Organization,
	|	NewFrontiers.Document AS Document
	|FROM
	|	NewFrontiers AS NewFrontiers
	|;
	|////////////////////////////////////////////
	|DROP InitialTasks
	|;
	|////////////////////////////////////////////
	|SELECT
	|	InitialTasks.Month,
	|	InitialTasks.JobNumber,
	|	InitialTasks.Organization,
	|	InitialTasks.Document
	|INTO InitialTasks
	|FROM
	|	InitialTimeTasks AS InitialTasks
	|;
	|////////////////////////////////////////////
	|SELECT
	|	CleaningTasks.Month,
	|	CleaningTasks.JobNumber,
	|	CleaningTasks.Organization,
	|	CleaningTasks.Document
	|FROM
	|	CleaningTasks AS CleaningTasks
	|;
	|////////////////////////////////////////////
	|SELECT
	|	NewFrontiers.Month AS Month,
	|	NewFrontiers.JobNumber AS JobNumber,
	|	NewFrontiers.Organization AS Organization,
	|	NewFrontiers.Document AS Document
	|FROM
	|	NewFrontiers AS NewFrontiers
	|");
	
	Query.TempTablesManager = TemporaryTable;
	Query.SetParameter("BeginOfPeriod",     BegOfMonth(CalculatedPeriod));
	Query.SetParameter("EndOfPeriod",      EndOfMonth(CalculatedPeriod));
	Query.SetParameter("NextMonth",    EndOfMonth(CalculatedPeriod) + 1);
	Query.SetParameter("CompanyArray", CompanyArray);
	
	Results = Query.ExecuteBatch(); 
	
	BeginTransaction();
	
	Try
		
		// Clear the calculated periods.
		Selection = Results.Get(5).Select();
		While Selection.Next() Do
			Set = InformationRegisters.JobsForCalculatingCost.CreateRecordSet();
			Set.Filter.Month.Set(Selection.Month);
			Set.Filter.JobNumber.Set(Selection.JobNumber);
			Set.Filter.Organization.Set(Selection.Organization);
			Set.Filter.Document.Set(Selection.Document);
			Set.Write(True);
		EndDo;
		
		// Let's shift the calculation period.
		Selection = Results.Get(6).Select();
		While Selection.Next() Do
			Set = InformationRegisters.JobsForCalculatingCost.CreateRecordSet();
			Set.Filter.Month.Set(Selection.Month);
			Set.Filter.JobNumber.Set(Selection.JobNumber);
			Set.Filter.Organization.Set(Selection.Organization);
			Set.Filter.Document.Set(Selection.Document);
			SetRow = Set.Add();
			FillPropertyValues(SetRow, Selection);
			Set.Write(True);
		EndDo;
		
		CommitTransaction();
	
	Except
		
		RollbackTransaction();
		
		MessageText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Không thể đánh dấu kỳ %1 như là đã tính do nguyên nhân:
				|		%2';
				|ru = 'Не удалось отметить период %1 как рассчитанный по причине:
				|		%2';
				|en = 'Cannot mark the %1 period as calculated. Reason:
				|		%2'; fa = 'Cannot mark the %1 period as calculated. Reason:
				|		%2';
				|it = 'Non è stato possibile il periodo %1 come contato a causa di:
				|		%2';
				|pl = 'Nie można oznaczyć okresu %1 jako obliczonego z powodu:
				|		%2';
				|tr = 'Şu nedenle hesaplanan %1 dönemi işaretlenemedi:
				|		%2'", Common.DefaultLanguageCode()),
			CostCalculationProtocol.PresentationOfCalculationPeriod(CalculatedPeriod),	
			DetailErrorDescription(ErrorInfo()));
			
		If CalculationParameters = Undefined Then
			WriteLogEvent(
				NameOfErrorEventForLog(CalculationParameters), 
				EventLogLevel.Error,,,
				MessageText);
		Else
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredWhenPerformingPeriodEndTransactions,
				MessageText,
				MessageText);
		EndIf;
		
	EndTry;
	
	DestroyTemporaryTables(TemporaryTable, "CleaningTasks, NewFrontiers, InitialTimeTasks");
	
EndProcedure

// Generates tasks for calculating the cost of fixed assets and IA, if the amount of expenses that is allocated to fixed assets and IA has been changed.
//
Procedure GenerateTasksForCalculatingCostOfVNA(CalculationParameters)

	If Not NonCurrentAssets.VNAManagementIsUsed_2_4(CalculationParameters.PayrollPeriod.BeginOfPeriod) Then
		Return;
	EndIf;
	
	QueryText = 
	"SELECT DISTINCT
	|	Table.Period AS Period,
	|	Table.Organization AS Organization,
	|	Table.DimensionOfExpenses AS AccountingObject,
	|	Table.Recorder AS Document
	|INTO OtherExpenses_TasksForCalculatingCostOfHPAUpdate
	|FROM
	|	(SELECT
	|		ChangesTable.Period AS Period,
	|		ChangesTable.Recorder AS Recorder,
	|		ChangesTable.Organization AS Organization,
	|		ChangesTable.Department AS Department,
	|		ChangesTable.ExpenseItem AS ExpenseItem,
	|		ChangesTable.DimensionOfExpenses AS DimensionOfExpenses,
	|		ChangesTable.LineOfBusiness AS LineOfBusiness,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN ChangesTable.Sum
	|			ELSE 0
	|		END AS Sum,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN ChangesTable.AmountExcludingVAT
	|			ELSE 0
	|		END AS AmountExcludingVAT,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN ChangesTable.SumCompl
	|			ELSE 0
	|		END AS SumCompl,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN ChangesTable.PermanentDifference
	|			ELSE 0
	|		END AS PermanentDifference,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN ChangesTable.CostTD
	|			ELSE 0
	|		END AS CostTD
	|	FROM
	|		AccumulationRegister.OtherExpenses AS ChangesTable
	|	WHERE
	|		ChangesTable.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND ChangesTable.Organization IN(&CompanyArray)
	|		AND (ChangesTable.LotCalculation
	|				OR ChangesTable.CalculationOfCost)
	|		AND (ChangesTable.DimensionOfExpenses REFS Catalog.Assets
	|				OR ChangesTable.DimensionOfExpenses REFS Catalog.ConstructionObjects
	|				OR ChangesTable.DimensionOfExpenses REFS Catalog.IntangibleAssets)
	|		AND ChangesTable.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
	|		AND (ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				OR ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost))
	|		AND ChangesTable.Recorder IN
	|				(SELECT
	|					TTCache.Recorder
	|				FROM
	|					TTCacheModifiedDocuments AS TTCache)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ChangesTable.Period,
	|		ChangesTable.Recorder,
	|		ChangesTable.Organization,
	|		ChangesTable.Department,
	|		ChangesTable.ExpenseItem,
	|		ChangesTable.DimensionOfExpenses,
	|		ChangesTable.LineOfBusiness,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN -ChangesTable.Sum
	|			ELSE 0
	|		END,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN -ChangesTable.AmountExcludingVAT
	|			ELSE 0
	|		END,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN -ChangesTable.SumCompl
	|			ELSE 0
	|		END,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN -ChangesTable.PermanentDifference
	|			ELSE 0
	|		END,
	|		CASE
	|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				THEN -ChangesTable.CostTD
	|			ELSE 0
	|		END
	|	FROM
	|		TTCashOtherExpenses AS ChangesTable
	|	WHERE
	|		(ChangesTable.DimensionOfExpenses REFS Catalog.Assets
	|				OR ChangesTable.DimensionOfExpenses REFS Catalog.ConstructionObjects
	|				OR ChangesTable.DimensionOfExpenses REFS Catalog.IntangibleAssets)
	|		AND ChangesTable.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
	|		AND (ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
	|				OR ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost))
	|		AND ChangesTable.Recorder IN
	|				(SELECT
	|					TTCache.Recorder
	|				FROM
	|					TTCacheModifiedDocuments AS TTCache)
	|
	|	AND &RequestTextForVATDistribution
	|) AS Table
	|
	|GROUP BY
	|	Table.Period,
	|	Table.Recorder,
	|	Table.Department,
	|	Table.ExpenseItem,
	|	Table.Organization,
	|	Table.DimensionOfExpenses,
	|	Table.LineOfBusiness
	|
	|HAVING
	|	(SUM(Table.Sum) <> 0
	|		OR SUM(Table.AmountExcludingVAT) <> 0
	|		OR SUM(Table.SumCompl) <> 0
	|		OR SUM(Table.PermanentDifference) <> 0
	|		OR SUM(Table.CostTD) <> 0)";
	
	CheckVATDistributionRegisteredRecords =
		TemporaryTableExists(CalculationParameters, "TTMovementOfVATDistributionForOtherExpensesBeforeSettlement")
		And TemporaryTableExists(CalculationParameters, "TTMovementOfVATDistributionToOtherExpensesAfterCalculation");
	
	If CheckVATDistributionRegisteredRecords Then
		
		RequestTextForVATDistribution = "
		|	UNION ALL
		|" + "
		|	SELECT
		|		ChangesTable.Period AS Period,
		|		ChangesTable.Recorder AS Recorder,
		|		ChangesTable.Organization AS Organization,
		|		ChangesTable.Department AS Department,
		|		ChangesTable.ExpenseItem AS ExpenseItem,
		|		ChangesTable.DimensionOfExpenses AS DimensionOfExpenses,
		|		ChangesTable.LineOfBusiness AS LineOfBusiness,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN ChangesTable.Sum
		|			ELSE 0
		|		END AS Sum,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN ChangesTable.AmountExcludingVAT
		|			ELSE 0
		|		END AS AmountExcludingVAT,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN ChangesTable.SumCompl
		|			ELSE 0
		|		END AS SumCompl,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN ChangesTable.PermanentDifference
		|			ELSE 0
		|		END AS PermanentDifference,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN ChangesTable.CostTD
		|			ELSE 0
		|		END AS CostTD
		|	FROM
		|		TTMovementOfVATDistributionForOtherExpensesBeforeSettlement AS ChangesTable
		|	WHERE
		|		(ChangesTable.DimensionOfExpenses REFS Catalog.Assets
		|			OR ChangesTable.DimensionOfExpenses REFS Catalog.ConstructionObjects
		|			OR ChangesTable.DimensionOfExpenses REFS Catalog.IntangibleAssets)
		|		AND ChangesTable.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
		|		AND (ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|			OR ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost))
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		ChangesTable.Period,
		|		ChangesTable.Recorder,
		|		ChangesTable.Organization,
		|		ChangesTable.Department,
		|		ChangesTable.ExpenseItem,
		|		ChangesTable.DimensionOfExpenses,
		|		ChangesTable.LineOfBusiness,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN -ChangesTable.Sum
		|			ELSE 0
		|		END,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN -ChangesTable.AmountExcludingVAT
		|			ELSE 0
		|		END,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN -ChangesTable.SumCompl
		|			ELSE 0
		|		END,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN -ChangesTable.PermanentDifference
		|			ELSE 0
		|		END,
		|		CASE
		|			WHEN ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|				THEN -ChangesTable.CostTD
		|			ELSE 0
		|		END
		|	FROM
		|		TTMovementOfVATDistributionToOtherExpensesAfterCalculation AS ChangesTable
		|	WHERE
		|		(ChangesTable.DimensionOfExpenses REFS Catalog.Assets
		|			OR ChangesTable.DimensionOfExpenses REFS Catalog.ConstructionObjects
		|			OR ChangesTable.DimensionOfExpenses REFS Catalog.IntangibleAssets)
		|		AND ChangesTable.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
		|		AND (ChangesTable.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
		|			OR ChangesTable.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost))
		|";
		
		QueryText = StrReplace(
			QueryText,
			"AND &RequestTextForVATDistribution",
			RequestTextForVATDistribution);
		
	Else
		QueryText = StrReplace(
			QueryText,
			"AND &RequestTextForVATDistribution",
			"");
	EndIf;
	
	ExistingTT = GetListOfExistingTemporaryTables(CalculationParameters);
	
	Query = New Query(QueryText);
	InitializeRequestProperties(Query, CalculationParameters);
	
	Result = Query.ExecuteBatch(); 
	Selection = Result.Get(Result.UBound()).Select();
	Selection.Next();
	
	TablesData = New Structure;
	TablesData.Insert("TempTablesManager", Query.TempTablesManager);
	TablesData.Insert("OtherExpenses_TasksForCalculatingCostOfHPAUpdate", Selection.Count > 0);
	
	FACostCalculation.GenerateJobs(Undefined, TablesData);
	
	NewTT = GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	
	DestroyTemporaryTables(Query.TempTablesManager, NewTT);
	
EndProcedure

