Function BeginningOfMeasurementOfCalculationOfChains(CalculationParameters, Data, ExpenseIndex)
	
	CurrentRow = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	
	CurrentRow.CurDepth = CurrentRow.CurDepth + 1;
	
	CurrentRow.MaximumDepth =
		Max(CurrentRow.MaximumDepth, CurrentRow.CurDepth);
	
	If CurrentRow.CurDepth > 0 Then
		CurrentRow.CallsStack[CurrentRow.CurDepth - 1] = ExpenseIndex;
	EndIf;
	
	ThereIsStackOverflow = (CurrentRow.CurDepth > CalculationParameters.SamplingRestrictions.MaximumChainLength);
	
	If ThereIsStackOverflow Then
		
		If Not CalculationParameters.DistributionOfParties.ThereIsStackOverflow Then
			
			ProtocolText_ =
				NStr("vi = 'Khi tính toán chuỗi biến động các lô hàng có hạn chế về chiều dài tối đa các chuỗi này.
					|Hạn chế này của cơ chế kế toán theo lô hiện tại (lỗi 00-00130143).
					|Đối với một số chứng từ lô hàng có thể không chọn hoặc vi phạm quy tắc chọn lô hàng theo FIFO.';
					|ru = 'При расчете цепочек движения партий сработало ограничение на максимально допустимую длину цепочки.
					|Это ограничение текущего механизма партионного учета (ошибка 00-00130143).
					|Для некоторых документов партии могут быть не подобраны или может быть нарушен принцип подбора партий по ФИФО.';
					|en = 'When calculating lot record chains, the limit on maximum allowable chain length was activated. 
					|This is a limit of the current lot accounting (error 00-00130143).
					|For some documents, lots may not be picked or the principle of lot picking by FIFO may be violated.'; fa = 'When calculating lot record chains, the limit on maximum allowable chain length was activated. 
					|This is a limit of the current lot accounting (error 00-00130143).
					|For some documents, lots may not be picked or the principle of lot picking by FIFO may be violated.';
					|it = 'Durante il calcolo dei percorsi dei movimenti dei lotti è scattato il limite sulla lunghezza massima del percorso consentita.
					|Questo è un limite del meccanismo corrente della contabilità a lotti (errore 00-00130143).
					|Per alcuni documenti i lotti potrebbero non essere selezionati o potrebbe essere stato infranto il principio di selezione dei lotti secondo FIFO.';
					|pl = 'Podczas obliczenia łańcuchów ruchu partii zadziałało ograniczenie maksymalnie dopuszczalnej długości łańcuchu.
					|To ograniczenie bieżącego mechanizmu ewidencji partii (błąd 00-00130143).
					|Dla niektórych dokumentów partii mogą być nie wybrane lub może być naruszona zasada wyboru partii wg FIFO.';
					|tr = 'Lot zincirleri hesaplanırken, izin verilen maksimum zincir uzunluğu sınırlaması uygulandı.
					|Bu, mevcut lot muhasebesi mekanizmasının sınırlamasıdır (hata 00-00130143).
					| Bazı belgeler için lotlar eşleştirilemeyebilir veya FIFO lot eşleştirme ilkesi ihlal edilebilir.'", Common.DefaultLanguageCode());
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
				ProtocolText_,
				ProtocolText_);
			
			RegisterCalculationExecutionProblem(
				CalculationParameters,
				,
				NStr("vi = 'Khi tính toán lô hàng, đã chẩn đoán được vấn đề';
					|ru = 'При расчете партий диагностированы проблемы';
					|en = 'Issues found when calculating lots'; fa = 'Issues found when calculating lots';
					|it = 'Durante il calcolo del lotto sono stati diagnosticati dei problemi';
					|pl = 'Podczas obliczenia partii są wykryte problemy';
					|tr = 'Lotların hesaplanmasında sorunlar tespit edilmiştir'", Common.DefaultLanguageCode()),
				ProtocolText_,
				,
				Enums.AccountingIssueSeverity.Warning);
			
		EndIf;
		
		CalculationParameters.DistributionOfParties.ThereIsStackOverflow = True;
		
	EndIf;
	
	Return Not ThereIsStackOverflow;
	
EndFunction

// It is intended for debugging the calculation-decoding the node traversal stack.
//
// Returns:
//	Structure -
//
Function NodesOfCalculatedChain(CalculationParameters, Data) Export
	
	CurrentRow = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	NodeTable_ = Undefined;
	RepeatingNodes = New Map;
	NodesTraversed = New Map;
	
	For LineNumber = 0 To CurrentRow.CurDepth - 1 Do
		
		NodeNumber = CurrentRow.CallsStack[LineNumber];
		
		If NodeTable_ = Undefined Then
			NodeTable_ = Data.Expenses[NodeNumber].Owner().CopyColumns();
		EndIf;
		
		If TypeOf(NodeTable_) = Type("ValueTable") Then
			FillPropertyValues(NodeTable_.Add(), Data.Expenses[NodeNumber]);
		EndIf;
		
		If NodesTraversed.Get(NodeNumber) = Undefined Then
			NodesTraversed.Insert(NodeNumber, 1);
		Else
			RepeatingNodes.Insert(NodeNumber);
		EndIf;
		
	EndDo;
	
	Result = New Structure;
	Result.Insert("NodeTable_", NodeTable_);
	Result.Insert("RepeatingNodes", RepeatingNodes);
	
	Return Result;
	
EndFunction

