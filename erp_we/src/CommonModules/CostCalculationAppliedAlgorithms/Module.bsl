	|				TYPE(Document.ProductionCostAllocation))
	|		AND T.Products.ItemsType IN (
	|			VALUE(Enum.ItemsTypes.OwnGoods),
	|			VALUE(Enum.ItemsTypes.ReusablePackage))
	|	) AS T
	|
	|GROUP BY
	|	T.Organization,
	|	T.ItemsLocationAttributes
	|
	|HAVING
	|	SUM(T.QuantityCostPrice) >= 0 AND
	|	SUM(T.QuantityCostPrice) <> SUM(T.OperationalQuantity)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization,
	|	T.ItemsLocationAttributes,
	|	T.QuantityCostPrice,
	|	T.OperationalQuantity
	|INTO TTDivergenceOfCostAndGoodsOfOrganizations
	|FROM
	|	TTDiscrepanciesPreliminary AS T
	|WHERE
	|	TRUE
	|";
	
	FieldList = New ValueList;
	FieldList.Add("Organization", 				NStr("vi = 'Doanh nghiệp';
														|ru = 'Организация';
														|en = 'Company'; fa = 'Company';
