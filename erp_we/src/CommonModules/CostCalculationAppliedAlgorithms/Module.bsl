#Region FetchingDataForCalculation

Function NextBatchPortionToCalculate(CalculationParameters, SamplingGroupOfSubgraphs, Data)
	
	Query = New Query;
	
	Data.IterationParameters.InitialChain = Data.IterationParameters.FinalChain + 1;
	
	If Not ThisIsBackgroundBatchCalculation(CalculationParameters) Then
		
		Query.TempTablesManager = CalculationParameters.TempTablesManager;
		
		Query.Text =
		"SELECT
		|	*
		|FROM
		|	Data AS DD
		|WHERE
		|	DD.K >= &InitialChain
		|	AND DD.K <= &FinalChain
		|ORDER BY
		|	DD.K";
		
		Data.IterationParameters.FinalChain  = Min(
			Data.IterationParameters.FinalChain + CalculationParameters.SamplingRestrictions.BatchCalculationPortion,
			SamplingGroupOfSubgraphs.MaximumNodeNumber);
		
		Query.SetParameter("InitialChain", Data.IterationParameters.InitialChain);
		Query.SetParameter("FinalChain",  Data.IterationParameters.FinalChain);
		
		DataSelection = Query.Execute().Select();
		
		UnloadIntermediateCalculationDataTable(CalculationParameters, "Data", DataSelection);
		
	Else
		
		If Data.IterationParameters.PortionNumber > CalculationParameters.MaximumServingNumber Then
			Return Undefined;
		EndIf;
		
		DataSelection = ReadBatchCalculationDataCache(
			CalculationParameters,
			CalculationParameters.CalculationID,
			Enums.DataTypesInLotAccountingCache.Nodes,
			Data.IterationParameters.PortionNumber,
			Data.IterationParameters.InitialChain, // the value of the variable changes
			Data.IterationParameters.FinalChain); // the value of the variable changes
		
	EndIf;
	
	NextPortionOfChainsForCalculation(CalculationParameters, Data, Query);
	
	Data.IterationParameters.PortionNumber = Data.IterationParameters.PortionNumber + 1;
	
	Return DataSelection;
	
EndFunction

Procedure NextPortionOfChainsForCalculation(CalculationParameters, Data, Query)
	
	If Not ThisIsBackgroundBatchCalculation(CalculationParameters) Then
		
		NodeRelationshipTables = New Structure("Sources, Destinations", "Source", "Receiver");
		
		QueryTemplate =
		"SELECT
		|	T.Key AS Key,
		|	T.Order AS Order,
		|	T.Parameter2 AS Parameter2
		|FROM
		|	Parameter1 AS T
		|WHERE
		|	T.Key >= &InitialChain
		|	AND T.Key <= &FinalChain
		|	AND T.Key <> T.Parameter2
		|	
		|ORDER BY
		|	Key,
		|	T.Order,
		|	Parameter2";
		
		QueryTemplate = StrReplace(QueryTemplate, "Parameter", "%");
		
		For Each TableDetails In NodeRelationshipTables Do
			
			Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
				QueryTemplate,
				TableDetails.Key,
				TableDetails.Value);
			
			String 		= Undefined;
			CurrentKey = Undefined;
			
			Selection = Query.Execute().Select();
			
			UnloadIntermediateCalculationDataTable(CalculationParameters, TableDetails.Key, Selection);
			
			While Selection.Next() Do
				
				Var_Key = Selection.Key;
				
				If CurrentKey <> Var_Key Then
					
					If CurrentKey <> Undefined Then
						Data.ChainsOfRegisteredRecords.Insert(CurrentKey, String);
					EndIf;
					
					CurrentKey = Var_Key;
					
					String = Data.ChainsOfRegisteredRecords[CurrentKey];
					If String = Undefined Then
						String = Data.ChainStrings.Add();
					EndIf;
					
				EndIf;
				
				NestedArray = String[TableDetails.Key]; // Array 
				NestedArray.Add(Selection[TableDetails.Value]);
				
			EndDo;
			
			If CurrentKey <> Undefined Then
				Data.ChainsOfRegisteredRecords.Insert(CurrentKey, String);
			EndIf;
			
		EndDo;
		
	Else
		
		CacheTable = ReadBatchCalculationDataCache(
			CalculationParameters,
			CalculationParameters.CalculationID,
			Enums.DataTypesInLotAccountingCache.Links,
			Data.IterationParameters.PortionNumber,
			,
			,
			False);
		
		If Not ValueIsFilled(CacheTable) Then
			Return; // this portion of nodes has no connections (trivial graphs)
		EndIf;
		
		String 		= Undefined;
		CurrentKey = Undefined;
		
		For Each CurCacheLine In CacheTable Do
			
			Var_Key = CurCacheLine.Key;
			
			If CurrentKey <> Var_Key Then
				
				If CurrentKey <> Undefined Then
					Data.ChainsOfRegisteredRecords.Insert(CurrentKey, String);
				EndIf;
				
				CurrentKey = Var_Key;
				
				String = Data.ChainsOfRegisteredRecords[CurrentKey];
				If String = Undefined Then
					String = Data.ChainStrings.Add();
				EndIf;
				
			EndIf;
			
			NestedArray = String[?(CurCacheLine.ThisIsSource, "Sources", "Destinations")]; // Array 
			NestedArray.Add(CurCacheLine.RelatedKey);
			
		EndDo;
		
		If CurrentKey <> Undefined Then
			Data.ChainsOfRegisteredRecords.Insert(CurrentKey, String);
		EndIf;
		
	EndIf;
	
EndProcedure

Function NextCollectionItem(Data)
	
	If TypeOf(Data) = Type("ValueTable") Then
		
		If Data.Count() > 0 Then
			Data = Data[0];
			Return True;
		EndIf;
		
	ElsIf TypeOf(Data) = Type("ValueTableRow") Then
		
		SourceTable = Data.Owner();
		IndexOf = SourceTable.IndexOf(Data);
		
		If IndexOf < SourceTable.Count() - 1 Then
			Data = SourceTable[IndexOf + 1];
			Return True;
		EndIf;
		
	ElsIf TypeOf(Data) = Type("QueryResultSelection") Then
		
		If Data.Next() Then
			Return True;
		EndIf;
		
	EndIf;
	
	Return False;
	
EndFunction

