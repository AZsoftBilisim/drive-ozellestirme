// Resubmit documents for all registers.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	Query - Query - request with text for creating a temporary table
//		In registratorsnecorrected movements with the fields: Link, Organization, error Code
//		The documents specified in this temporary table from the Link field will be rechecked.
//	DecodingErrorCodes - Map - error description
//		Key-Number, String-error code from the error Code field of the temporary table in Registratorsnecorrectmovements
//		Value - the String - a custom description of the error
//	ReasonForReplaying - String - description of the reason for re-checking the documents.
//
Procedure RecheckTheDocuments(CalculationParameters, Query, DecodingErrorCodes, ReasonForReplaying) Export
	
	TheseArePoolCalculationParameters = CalculationParameters.Property("TheseArePoolCalculationParameters");
	
	ParametersOfTheEvent = DocumentsPosting.InitializeMotionRecoveryParameters(
		Query,
		DecodingErrorCodes,
		,
		"TTRecordersForReconnection");
	
	ParametersOfTheEvent.Insert("ReasonForReplaying", 					  	ReasonForReplaying);
	ParametersOfTheEvent.Insert("OnlyLogErrors", 					CalculationParameters.Debug.IgnoreIncorrectPrimaryRegisteredRecords);
	ParametersOfTheEvent.Insert("MonthEndClosingOperations", 					  	Catalogs.MonthEndClosingOperations.LotsAndCostCalculation);
	ParametersOfTheEvent.Insert("CalculationPeriod", 							  	CalculationParameters.PayrollPeriod.BeginOfPeriod);
	ParametersOfTheEvent.Insert("LogErrors", 		  	Not TheseArePoolCalculationParameters);
	ParametersOfTheEvent.Insert("EventLogEventName", 		  	  	NameOfErrorEventForLog(CalculationParameters));
	ParametersOfTheEvent.Insert("RegisterRecordedOnlyInCurrentPeriod", 	  			TheseArePoolCalculationParameters);
	ParametersOfTheEvent.Insert("CalledFromCostCalculation", 	  		True);
	
	// Re-examination.
	ResultOfCarryingOut = DocumentsPosting.RestoreDocumentRegisteredRecords(ParametersOfTheEvent);
	
	// Processing of the results of the re-examination - the time of formation of the TUE.
	For Each DescriptionOfTTFormation In ResultOfCarryingOut.FormationTime Do
		
		CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTRecordersWithIncorrectRegisteredRecords", ReasonForReplaying,, DescriptionOfTTFormation.BeginTime);
		CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True,, DescriptionOfTTFormation.EndTime);
		
	EndDo;
	
	// Processing of the results of the recheck - processed registers.
	For Each RegisterDescription In CalculationParameters.RegisterRecords Do
		RegisterDescription.Value.ItIsNecessaryToUpdateCalculatedCache = True;
	EndDo;
	
	// Processing of the results of the re-examination is the result of the re-examination.
	CostCalculationProtocol.AdditionalInformation(
		CalculationParameters,
		StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã phát hiện bản ghi kết chuyển bị sai của chứng từ.
				|	  Lý do: %1
				|	  Kết chuyển lại chứng từ: %2';
