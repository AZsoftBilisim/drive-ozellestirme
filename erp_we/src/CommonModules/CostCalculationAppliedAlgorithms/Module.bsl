#Region FormationOfRegisteredRecords

Procedure GenerateRegisteredRecordsByCaseBasedOnRequestData(CalculationParameters, RegisterName, Query, Explanation = "") Export

	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	CheckFormationOfRegisterRecordedRegister(ReceiverDescription);
	
	Selection = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,,, Explanation);
	
	CopiedFields = CommonColumnsOfDataSourceAndReceiver(CalculationParameters, Selection, RegisterName);
	
	While Selection.Next() Do
		// Let's add movement in accordance with the logic of the calculation mechanism being performed now.
		CalculationParameters.CalculationMechanismModule.AddEntryToMovementTable(
			CalculationParameters,
			RegisterName,
			Selection,
			CopiedFields);
	EndDo;
	
EndProcedure

Procedure GenerateRegisteredRecordsByRegisterBasedOnTemporaryTableData(CalculationParameters, RegisterName, TempTableName,
			DeleteTemporaryTable = False, UpdateCalculatedCaches = True, TypifyValues = True) Export
	
	MatchingTemporaryMovementTables = New Map;
	ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	CheckFormationOfRegisterRecordedRegister(ReceiverDescription);

	IntermediateTableName = TempTableName + "_ReducedToRegisterStructure";
	FieldDescriptionTable 	= GenerateDescriptionOfRequestFields(ReceiverDescription.Table);
	
	CopiedFields = StringFunctionsClientServer.SubstituteParametersToString(
		TemporaryTableColumns(CalculationParameters, TempTableName),
		"");
	
	CopyRequestFields(FieldDescriptionTable, CopiedFields);
	
	CalculationParameters.CalculationMechanismModule.AddDescriptionOfFieldsForGeneratingRegisteredRecords(
		CalculationParameters,
		FieldDescriptionTable,
		ReceiverDescription,
		CopiedFields);
	
	MakeRequestForFieldDescriptions(
		CalculationParameters,
		FieldDescriptionTable,
		RegisterName,
		TempTableName,
		IntermediateTableName);
	
	MatchingTemporaryMovementTables.Insert(IntermediateTableName, RegisterName);
	
	CacheGeneratedRegisteredRecordsFromTemporaryTables(
		CalculationParameters,
		MatchingTemporaryMovementTables,
		True,
		UpdateCalculatedCaches,
		TypifyValues);
	
	AccumulateSettlementBatches = CalculationParameters.Property("DistributionOfParties")
		And CalculationParameters.DistributionOfParties.Property("AllSettlementBatches");
	
	If AccumulateSettlementBatches Then
		
		MakeRequestForFieldDescriptions(
			CalculationParameters,
			FieldDescriptionTable,
			RegisterName,
			TempTableName,
			IntermediateTableName,,,
			False);
		
		Selection = SelectTemporaryTableRows(CalculationParameters, IntermediateTableName);
		
		While Selection.Next() Do
			FillPropertyValues(
				CalculationParameters.DistributionOfParties.AllSettlementBatches.Add(),
				Selection);
		EndDo;
		
	EndIf;
	
	If DeleteTemporaryTable Then
		DestroyTemporaryTables(CalculationParameters, TempTableName);
	EndIf;
	
EndProcedure

Procedure GenerateRegisteredRecordsInTemporaryTableFromAnotherTemporaryTable(CalculationParameters, DataTableName = "Data", DeleteUnwrittenData = True)
	
	RegisterRecordsDetails 	 = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	TempTableName  = RegisterRecordsDetails.TempTableName;
	IndexingFields   = RegisterRecordsDetails.IndexingFields;
	
	// The calculation batch table is empty, it is only needed to form the structure of the temporary receiver table.
	SettlementBatches = CalculationParameters.DistributionOfParties.SettlementBatches.CopyColumns(); // ValueTable
	
	// Let's make a list of significant columns of the settlement batch table
	NumberColumnNames	 = "";
	NamesOfNonNumericColumns	 = "";
	
	TemporaryTableExists = TemporaryTableExists(CalculationParameters, TempTableName);
	
	If TemporaryTableExists Then 
		SourceOfColumns = UnloadTemporaryTable(CalculationParameters, TempTableName, 0).Columns;
	Else
		SourceOfColumns = SettlementBatches.Columns;
	EndIf;
	
	For Each Column In SourceOfColumns Do
		
		If ThisIsSummableColumnOfTable(Column) Then
			NumberColumnNames = NumberColumnNames + ?(NumberColumnNames = "", "", ", ")
				+ "%1" + Column.Name;
		Else
			NamesOfNonNumericColumns = NamesOfNonNumericColumns + ?(NamesOfNonNumericColumns = "", "", ", ")
				+ "%1" + Column.Name;
		EndIf;
			
	EndDo;
	
	ColumnsNames = NamesOfNonNumericColumns + ?(NumberColumnNames = "", "", ", " + NumberColumnNames);
	
	// Let's put the calculation batch table in the specified temporary table (arbitrary - not a register cache).
	If Not TemporaryTableExists Then
		
		// Create an empty temporary table of the required structure.
		PutTableOfValuesInTemporaryTable(
			CalculationParameters,
			TempTableName,
			SettlementBatches,
			ColumnsNames,
			IndexingFields);
		
	EndIf;
	
	SizeTT = TemporaryTableSize(CalculationParameters, DataTableName);
	
	CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
		CalculationParameters,
		SizeTT);
	
	If SizeTT > 0 Then
		
		SourceTableName = DataTableName;
		
		If DeleteUnwrittenData And CalculationParameters.PartiesAreBeingCalculated And CalculationParameters.Property("DistributionOfParties") Then
			
			Query = New Query;
			Query.TempTablesManager = CalculationParameters.TempTablesManager;
			
			UnwrittenData = CalculationParameters.DistributionOfParties.UnwrittenData;
			ConditionNonWritableData = "";
			
			If TemporaryTableColumnExists(CalculationParameters, DataTableName, "CalculationIsCompleted")
			 And Not UnwrittenData.RecordUnfinishedTasks Then
				ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
					|	AND ") + "CalculationIsCompleted";
			EndIf;
			
			If ValueIsFilled(UnwrittenData.UnrecordedRecordTypes) Then
				
				Query.SetParameter(
					"UnrecordedRecordTypes",
					TMCommonUseClientServer.ConvertMatchOrStructureToArray(UnwrittenData.UnrecordedRecordTypes));
				
				ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
					|	AND ") + "NOT EntryType IN (&UnrecordedRecordTypes)";
				
			EndIf;
			
			If ValueIsFilled(UnwrittenData.UnwrittenPartitions) Then
				
				Query.SetParameter(
					"UnwrittenPartitions",
					TMCommonUseClientServer.ConvertMatchOrStructureToArray(UnwrittenData.UnwrittenPartitions));
				
				ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
					|	AND ") + "NOT AccountingSection IN (&UnwrittenPartitions)";
				
			EndIf;
			
			If ValueIsFilled(UnwrittenData.UnrecordedLoggers) Then
				
				NonWritableTypesOfLoggers = New Array;
				
				For Each KeyAndValue In UnwrittenData.UnrecordedLoggers Do
					NonWritableTypesOfLoggers.Add(Type("DocumentRef." + KeyAndValue.Key));
				EndDo;
				
				Query.SetParameter("NonWritableTypesOfLoggers", NonWritableTypesOfLoggers);
				
				ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
					|	AND ") + "NOT VALUETYPE(Recorder) IN (&NonWritableTypesOfLoggers)";
				
			EndIf;
			
			If ValueIsFilled(ConditionNonWritableData) Then
				
				SourceTableName = "ProcessedDataTable_";
				
				Query.Text =
				"SELECT
				|	*
				|INTO ProcessedDataTable_
				|FROM
				|	DataTableName
				|WHERE
				|	&ConditionNonWritableData";
				
				Query.Text = StrReplace(Query.Text, "DataTableName", DataTableName);
				Query.Text = StrReplace(Query.Text, "&ConditionNonWritableData", ConditionNonWritableData);
				
				Query.Execute();
				
				SizeTT = TemporaryTableSize(CalculationParameters, SourceTableName);
				
			EndIf;
			
		EndIf;
		
		If SizeTT > 0 Then
			
			AddMissingTemporaryTableColumns(
				CalculationParameters,
				SourceTableName,
				TempTableName,
				IndexingFields);
			
			MergeTemporaryTables(
				CalculationParameters,
				SourceTableName,
				TempTableName,
				ColumnsNames,
				NumberColumnNames,
				IndexingFields);
			
		EndIf;
		
		DestroyTemporaryTables(CalculationParameters, "ProcessedDataTable_");
		
	EndIf;
	
	AccumulateSettlementBatches = CalculationParameters.Property("DistributionOfParties")
		And CalculationParameters.DistributionOfParties.Property("AllSettlementBatches");
	
	If AccumulateSettlementBatches Then
		
		Selection = SelectTemporaryTableRows(CalculationParameters, TempTableName);
		
		While Selection.Next() Do
			FillPropertyValues(
				CalculationParameters.DistributionOfParties.AllSettlementBatches.Add(),
				Selection);
		EndDo;
		
	EndIf;
	
EndProcedure

// Adds a new row to the table of movements of the specified register and fills in the service fields.
//
// Returns:
//	ValueTableRow -
//
Function AddEntryToMovementTable(CalculationParameters, ReceiverDescription, MotionData, CopiedFields = Undefined) Export
	
	// If necessary, we cache the generated portion of movements from the table of values into a temporary table.
	If ReceiverDescription.Table.Count() >= CalculationParameters.SamplingRestrictions.NumberOfVTZLines Then
		If ReceiverDescription.ThisIsRegisterDescription Then
			CacheGeneratedRegisteredRecords(CalculationParameters, ReceiverDescription.RegisterName, False);
		Else
			CacheGeneratedRegisteredRecords(CalculationParameters, ReceiverDescription.TempTableName, False);
		EndIf;
	EndIf;
	
	// Add a new row to the table of movements and fill in its fields
	Record = ReceiverDescription.Table.Add();
	
	If ValueIsFilled(CopiedFields) Then
		FillPropertyValues(Record, MotionData, CopiedFields); // only required fields
	Else
		FillPropertyValues(Record, MotionData); // all fields
	EndIf;
	
	Return Record;
	
EndFunction

