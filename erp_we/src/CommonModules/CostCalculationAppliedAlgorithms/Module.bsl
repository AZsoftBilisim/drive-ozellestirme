#Region CalculationMeasurements

// Initializes batch distribution measurement parameters.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
// Returns:
// 	ValueTable - LongDesc:
// * NumberOfSubgraphs - Number -
// * NodeCount - Number -
// * CurDepth - Number -
// * MaximumDepth - Number -
// * GeneratedRecords - Number -
// * DeletedRecords - Number -
// * DataVolume - Number -
// * CrawlResults - Structure -
// * CallsStack - Array -
Function InitializeBatchDistributionMeasurement(CalculationParameters) Export
	
	CalculationStatistics = New ValueTable;
	
	CalculationStatistics.Columns.Add("NumberOfSubgraphs", New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("NodeCount", 	  New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("CurDepth", 	  New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("MaximumDepth", New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("GeneratedRecords", New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("DeletedRecords", 	  New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("DataVolume", 	  New TypeDescription("Number")); // here we will accumulate data for measuring performance
	CalculationStatistics.Columns.Add("CrawlResults", 	  New TypeDescription("Structure"));
	CalculationStatistics.Columns.Add("BeginTime", 	  	  New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("EndTime",  	  New TypeDescription("Number"));
	CalculationStatistics.Columns.Add("StartDate", 	  	  New TypeDescription("Date"));
	CalculationStatistics.Columns.Add("CallsStack");
	
	CalculationParameters.DistributionOfParties.Insert("CalculationStatistics", CalculationStatistics);
	
	Return CalculationStatistics;
	
EndFunction

// Start of measuring the calculation of subgraph groups.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
// 	Selection - QueryResultSelection -
Procedure BeginningOfMeasurementOfCalculationOfGroupOfSubgraphs(CalculationParameters, Selection)
	
	EndOfSubgraphGroupCalculationMeasurement(CalculationParameters); // for the previous group
	
	NewRow = CalculationParameters.DistributionOfParties.CalculationStatistics.Add();
	
	NewRow.BeginTime			= CurrentUniversalDateInMilliseconds();
	NewRow.StartDate			= CurrentSessionDate();
	
	NewRow.NumberOfSubgraphs = Selection.NumberOfSubgraphs;
	NewRow.NodeCount 	= Selection.MaximumNodeNumber - Selection.MinimumNodeNumber + 1;
	NewRow.CallsStack 		= New Array(CalculationParameters.SamplingRestrictions.MaximumChainLength + 1);
	
EndProcedure

Procedure EndOfSubgraphGroupCalculationMeasurement(CalculationParameters)
	
	RowsCount = CalculationParameters.DistributionOfParties.CalculationStatistics.Count();
	
	If RowsCount = 0 Then
		Return;
	EndIf;
	
	CurrentRow = CalculationParameters.DistributionOfParties.CalculationStatistics[RowsCount - 1];
	CurrentRow.EndTime = CurrentUniversalDateInMilliseconds();
	
EndProcedure

Function EndOfChainCalculationMeasurement(CalculationParameters, CalculationResult2)
	Var Count;
	
	CurrentRow = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	
	If Not CurrentRow.CrawlResults.Property(CalculationResult2, Count) Then
		Count = 0;
	EndIf;
	
	CurrentRow.CrawlResults.Insert(CalculationResult2, Count + 1);
	
	CurrentRow.CurDepth = CurrentRow.CurDepth - 1;
	
	If CurrentRow.CurDepth >= 0 Then
		CurrentRow.CallsStack[CurrentRow.CurDepth] = Undefined;
	EndIf;
	
	Return CalculationResult2;
	
EndFunction

Procedure FixAdditionOfCalculatedBatchInMeasurement(CalculationParameters)
	
	CurrentRow = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	
	CurrentRow.GeneratedRecords = CurrentRow.GeneratedRecords + 1;
	
EndProcedure

Procedure FixRemovalOfCalculatedBatchInMeasurement(CalculationParameters)
	
	CurrentRow = CalculationParameters.DistributionOfParties.CalculationStatistics[CalculationParameters.DistributionOfParties.CalculationStatistics.Count() - 1];
	
	CurrentRow.DeletedRecords = CurrentRow.DeletedRecords + 1;
	
EndProcedure

