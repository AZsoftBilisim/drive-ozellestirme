#Region RestorationsOfRegisteredRecords

// It will re-send documents to several accumulation registers.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	Query - Query - request with text for creating a temporary table
//		In registratorsnecorrected movements with the fields: Link, Registername, error Code
//		The documents specified in this temporary table from the Link field
//		will be re-checked for the specified accumulation registers from the register Name field.
//	DecodingErrorCodes - Map:
//		Key-Number, String-error code from the error code field of the temporary table in the registratorsnotable movements
//		Value-String-custom error description
//	ReasonForReplaying - String - description of the reason for re-checking the documents.
//	AdditionalFields - Structure:
//		Key-name of the table field in the registratorsnotable movements
//		View-view of the field to output to the protocol
//	OnlyRecheck - Boolean - perform document rechecking without checking movements and without registering errors
//
Procedure RecheckDocumentsForIndividualAccumulationRegisters(CalculationParameters, Query, DecodingErrorCodes, ReasonForReplaying, 
	AdditionalFields = Undefined, OnlyRecheck = False) Export
	
	TextOfAdditionalFields_ = "";
	
	If AdditionalFields <> Undefined Then
		For Each Field In AdditionalFields Do
			TextOfAdditionalFields_ = TextOfAdditionalFields_ + "T." + Field.Key + ", ";
		EndDo;
	EndIf;
	
	// Let's check the possibility of forming movements by registers in this period
	AdditionalRequestText = "";
	If CalculationOfCostCached.UnusedRegisteredRecordsOnCostRegistersArePossible() Then
		
		CostRegisterNames = New Array;
		ExceptionLoggers 		= New Array;
		
		For Each KeyAndValue In CalculationOfCostCached.RegistersNotUsedWhenCostAccountingIsDisabled() Do
			MetaRegister = KeyAndValue.Key; // MetadataObjectAccumulationRegister 
			CostRegisterNames.Add(MetaRegister.Name);
		EndDo;
		
		For Each KeyAndValue In CalculationOfCostCached.RecordersWithRegisteredRecordsWhenCostAccountingIsTurnedOff() Do
			MetaDocument = KeyAndValue.Key; // MetadataObjectDocument 
			ExceptionLoggers.Add(Type("DocumentRef." + MetaDocument.Name));
		EndDo;
		
		Query.SetParameter("CostRegisterNames", CostRegisterNames);
		Query.SetParameter("ExceptionLoggers", 	 ExceptionLoggers);
		Query.SetParameter("KeepRecords", 		 			 GetFunctionalOption("UseCostAccounting"));
		Query.SetParameter("AccountingStartDate", 			 BegOfMonth(Constants.CostAccountingStartDate.Get()));
		
		AdditionalRequestText =
		"SELECT
		|	&AdditionalFields,
		|	T.RegisterName 				 AS RegisterName,
		|	T.Ref 	  				 AS Ref,
		|	T.Organization  				 AS Organization,
		|	T.ErrorCode  				 AS ErrorCode
		|INTO TTRecordersWithIncorrectRegisteredRecordsInPeriodOfCostAccounting
		|FROM
		|	TTRecordersWithIncorrectRegisteredRecords AS T
		|	LEFT JOIN TTPointsInTime AS PointsInTime
		|		ON T.Ref = PointsInTime.Ref
		|WHERE
		|	NOT T.RegisterName IN (&CostRegisterNames)
		|	OR (&KeepRecords
		|		AND NOT VALUETYPE(T.Ref) IN (&ExceptionLoggers)
		|		AND &AccountingStartDate <= PointsInTime.Date)
		|	OR (&KeepRecords
		|		AND VALUETYPE(T.Ref) IN (&ExceptionLoggers)
		|		AND DATEADD(&AccountingStartDate, MONTH, -1) <= PointsInTime.Date)
		|;
		|
		|/////////////////////////////////////////////////////////
		|DROP TTRecordersWithIncorrectRegisteredRecords
		|;
		|
		|/////////////////////////////////////////////////////////
		|SELECT
		|	&AdditionalFields,
		|	T.RegisterName 				 AS RegisterName,
		|	T.Ref 	  				 AS Ref,
		|	T.Organization  				 AS Organization,
		|	T.ErrorCode  				 AS ErrorCode
		|INTO TTRecordersWithIncorrectRegisteredRecords
		|FROM
		|	TTRecordersWithIncorrectRegisteredRecordsInPeriodOfCostAccounting AS T
		|;
		|
		|/////////////////////////////////////////////////////////
		|DROP TTRecordersWithIncorrectRegisteredRecordsInPeriodOfCostAccounting
		|";
		
		AdditionalRequestText = StrReplace(AdditionalRequestText, "&AdditionalFields,", TextOfAdditionalFields_);
		
	EndIf;
	
	If CalculationOfCostCached.MediumSlipValuationIsUsed() Then
		
		If Not TemporaryTableExists(Query, "TTPossibleRegisteredRecordsOnCostRegisters") Then
			
			TableOfRegisteredRecordsOfDocuments = New ValueTable;
			TableOfRegisteredRecordsOfDocuments.Columns.Add("Ref", Documents.AllRefsType());
			TableOfRegisteredRecordsOfDocuments.Columns.Add("RegisterName", New TypeDescription("String",, New StringQualifiers(128)));
			
			ArrayRegisters = CalculationOfCostCached.RelatedRegistersWhenConductingMediumSlip();
			
			For Each MetaDocument In Metadata.Documents Do
				
				EmptyRef = Documents[MetaDocument.Name].EmptyRef();
				
				For Each MetaRegister In ArrayRegisters Do
					If MetaDocument.RegisterRecords.Contains(MetaRegister) Then
						
						NwRw = TableOfRegisteredRecordsOfDocuments.Add();
						NwRw.Ref = EmptyRef;
						NwRw.RegisterName = MetaRegister.Name;
						
					EndIf;
				EndDo;
				
			EndDo;
			
			RequestTT = New Query;
			RequestTT.TempTablesManager = Query.TempTablesManager;
			RequestTT.SetParameter("TableOfRegisteredRecordsOfDocuments", TableOfRegisteredRecordsOfDocuments);
			
			RequestTT.Text =
			"SELECT
			|	T.Ref,
			|	T.RegisterName
			|INTO TTPossibleRegisteredRecordsOnCostRegisters
			|FROM
			|	&TableOfRegisteredRecordsOfDocuments AS T
			|";
			
			RequestTT.Execute();
			
		EndIf;
		
		Query.SetParameter("NameOfCostRegister", Metadata.AccumulationRegisters.InventoryCost.Name);

		AdditionalRequestText = AdditionalRequestText + ?(AdditionalRequestText = "", "", "
		|;
		|") + "
		|SELECT
		|	&AdditionalFields,
		|	T.RegisterName 				 AS RegisterName,
		|	T.Ref 	  				 AS Ref,
		|	T.Organization  				 AS Organization,
		|	T.ErrorCode  				 AS ErrorCode,
		|	(AccountingPolicy.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.MovingAverage)) AS MovingAverage
		|INTO TTRecordersWithIncorrectRegisterRecordedExtended
		|FROM
		|	TTRecordersWithIncorrectRegisteredRecords AS T
		|	LEFT JOIN InformationRegister.FinancialAccountingPolicy.SliceLast(&BeginOfPeriod) AS AccountingPolicy
		|		ON AccountingPolicy.Organization = T.Organization
		|INDEX BY
		|	MovingAverage
		|;
		|
		|/////////////////////////////////////////////////////////
		|DROP TTRecordersWithIncorrectRegisteredRecords
		|;
		|
		|/////////////////////////////////////////////////////////
		|SELECT
		|	&AdditionalFields,
		|	T.RegisterName 				 AS RegisterName,
		|	T.Ref 	  				 AS Ref,
		|	T.Organization  				 AS Organization,
		|	T.ErrorCode  				 AS ErrorCode
		|INTO TTRecordersWithIncorrectRegisteredRecords
		|FROM
		|	TTRecordersWithIncorrectRegisterRecordedExtended AS T
		|WHERE
		|	NOT T.MovingAverage
		|
		|UNION ALL
		|
		|SELECT
		|	&AdditionalFields,
		|	ISNULL(Registers.RegisterName, T.RegisterName) AS RegisterName,
		|	T.Ref 	  				 AS Ref,
		|	T.Organization  				 AS Organization,
		|	T.ErrorCode  				 AS ErrorCode
		|FROM
		|	TTRecordersWithIncorrectRegisterRecordedExtended AS T
		|	LEFT JOIN TTPossibleRegisteredRecordsOnCostRegisters AS Registers
		|		ON T.RegisterName = &NameOfCostRegister
		|		AND VALUETYPE(T.Ref) = VALUETYPE(Registers.Ref)
		|WHERE
		|	T.MovingAverage
		|;
		|
		|/////////////////////////////////////////////////////////
		|DROP TTRecordersWithIncorrectRegisterRecordedExtended
		|";
		
		AdditionalRequestText = StrReplace(AdditionalRequestText, "&AdditionalFields,", TextOfAdditionalFields_);
		
	EndIf;
	
	// Preparation for the re-examination.
	TheseArePoolCalculationParameters = CalculationParameters.Property("TheseArePoolCalculationParameters");
	
	ParametersOfTheEvent = DocumentsPosting.InitializeMotionRecoveryParameters(
		Query,
		DecodingErrorCodes,
		"TTRecordersWithIncorrectRegisteredRecords");
	
	ParametersOfTheEvent.Insert("TextOfAdditionalDataPreparationRequest", AdditionalRequestText);
	ParametersOfTheEvent.Insert("ReasonForReplaying", 					  	ReasonForReplaying);
	ParametersOfTheEvent.Insert("AdditionalFields", 						  	AdditionalFields);
	ParametersOfTheEvent.Insert("OnlyLogErrors", 					CalculationParameters.Debug.IgnoreIncorrectPrimaryRegisteredRecords);
	ParametersOfTheEvent.Insert("MonthEndClosingOperations", 					  	Catalogs.MonthEndClosingOperations.LotsAndCostCalculation);
	ParametersOfTheEvent.Insert("CalculationPeriod", 							  	CalculationParameters.PayrollPeriod.BeginOfPeriod);
	ParametersOfTheEvent.Insert("LogErrors", 		  	Not TheseArePoolCalculationParameters);
	ParametersOfTheEvent.Insert("EventLogEventName", 		  	  	NameOfErrorEventForLog(CalculationParameters));
	ParametersOfTheEvent.Insert("RegisterRecordedOnlyInCurrentPeriod", 	  			TheseArePoolCalculationParameters);
	ParametersOfTheEvent.Insert("CalledFromCostCalculation", 	  		True);
	ParametersOfTheEvent.Insert("OnlyRecheck",						OnlyRecheck);
	
	// Re-examination.
	ResultOfCarryingOut = DocumentsPosting.RestoreDocumentRegisteredRecords(ParametersOfTheEvent);
	
	// Processing of the results of the re-examination - the time of formation of the TUE.
	For Each DescriptionOfTTFormation In ResultOfCarryingOut.FormationTime Do
		
		CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTRecordersWithIncorrectRegisteredRecords", ReasonForReplaying,, DescriptionOfTTFormation.BeginTime);
		CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True,, DescriptionOfTTFormation.EndTime);
		
	EndDo;
	
	// Processing of the results of the recheck - processed registers.
	For Each ModifiedRegisters In ResultOfCarryingOut.ModifiedRegisters Do
		
		RegisterDescription = CalculationParameters.RegisterRecords[ModifiedRegisters.Key];
		RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = True;
		
		CostCalculationProtocol.AdditionalInformation(
			CalculationParameters,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Đã phát hiện bản ghi kết chuyển sai theo biểu ghi tích lũy ""%1"".
					|	  Lý do: %2
					|	  Kết chuyển lại chứng từ: %3';
					|ru = 'Обнаружены некорректные движения по регистру накопления ""%1"".
					|	  Причина: %2
					|	  Перепроведено документов: %3';
					|en = 'Incorrect records are found in the ""%1"" accumulation register.
					|	  Reason: %2
					|	  Documents reposted: %3'; fa = 'Incorrect records are found in the ""%1"" accumulation register.
					|	  Reason: %2
					|	  Documents reposted: %3';
					|it = 'Sono stati rilevati movimenti scorretti nel registro di accumulo ""%1"".
					|	 Causa: %2
					|	 Documenti ri-registrati: %3';
					|pl = 'Zostały wykryte niepoprawne ruchy według rejestru akumulacji ""%1"".
					|	  Przyczyna: %2
					|	  Ponownie zatwierdzono dokumentów: %3';
					|tr = '""%1"" birikim kaydında yanlış hareketler tespit edildi.
					|	  Neden: %2
					|	  Yeniden kaydedilen belgeler: %3'", Common.DefaultLanguageCode()),
				ModifiedRegisters.Key,
				ReasonForReplaying,
				CostCalculationProtocol.ValuePresentation(ModifiedRegisters.Value)));
		
	EndDo;
	
	// Skips error registration, if only the re-examination of documents is performed.
	If OnlyRecheck Then
		Return;
	EndIf;
	
	// Processing of the results of the re-examination is the result of the re-examination.
	If Not ResultOfCarryingOut.ExecutedSuccessfully Then
		
	 	// There are incorrect entries left, but we will continue performing the calculation anyway.
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenRestoringDocumentRegisterRecords,
			CostCalculationProtocol.ServiceSymbol_WithoutNumbering()
				+ NStr("vi = 'Sau khi kiểm tra lại, có những chứng từ có bản ghi kết chuyển không chính xác:';
						|ru = 'После перепроведения остались документы с некорректными движениями:';
						|en = 'There are documents with incorrect records after reposting:'; fa = 'There are documents with incorrect records after reposting:';
						|it = 'Dopo la ri-registrazione sono rimasti dei documenti con movimenti errati:';
						|pl = 'Po ponownym zatwierdzeniu pojawiły się dokumenty o nieprawidłowych ruchach:';
						|tr = 'Yanlış hareketler içeren belgeler yeniden kayıttan sonra bırakıldı:'", Common.DefaultLanguageCode()));
		
	EndIf;
	
	// Processing of the results of the re-examination - detailed information about errors in the movements of documents.
	For Each DecodingErrors In ResultOfCarryingOut.DecodingErrors Do
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenRestoringDocumentRegisterRecords,
			"#- " + NStr("vi = 'lỗi';
						|ru = 'ошибка';
						|en = 'error'; fa = 'error';
						|it = 'errore';
						|pl = 'error';
						|tr = 'hata'", Common.DefaultLanguageCode())  + " """ + DecodingErrors.ErrorType + """:");
		
		For Each DecodingError In DecodingErrors.MoreDetails Do
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenRestoringDocumentRegisterRecords,
				DecodingError);
			
		EndDo;
		
	EndDo;
	
EndProcedure

// Retransmit documents for one accumulation register.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	SelectionOfDocuments - QueryResultSelection - The request selection must contain the Link and Company fields
//	AccumulationRegisterName - String - name of the accumulation register to re-check the documents for.
//	ParametersOfTheEvent - See DocumentsPosting.InitializeMotionRecoveryParameters 
//
// Returns:
//	Array of String - texts of conduct errors
//
Function RestoreMovementOfDocumentsInAccumulationRegister(CalculationParameters, SelectionOfDocuments, AccumulationRegisterName, ParametersOfTheEvent = Undefined) Export
	
	TheseArePoolCalculationParameters = CalculationParameters.Property("TheseArePoolCalculationParameters");
	
	If Not ValueIsFilled(ParametersOfTheEvent) Then
		
		ParametersOfTheEvent = DocumentsPosting.InitializeMotionRecoveryParameters(Undefined, Undefined);
		
		ParametersOfTheEvent.Insert("MonthEndClosingOperations", 				  Catalogs.MonthEndClosingOperations.LotsAndCostCalculation);
		ParametersOfTheEvent.Insert("CalculationPeriod", 						  CalculationParameters.PayrollPeriod.BeginOfPeriod);
		ParametersOfTheEvent.Insert("LogErrors", 	  Not TheseArePoolCalculationParameters);
		ParametersOfTheEvent.Insert("EventLogEventName", 		  NameOfErrorEventForLog(CalculationParameters));
		ParametersOfTheEvent.Insert("RegisterRecordedOnlyInCurrentPeriod", 		  TheseArePoolCalculationParameters);
		ParametersOfTheEvent.Insert("CalledFromCostCalculation",	  True);
		
	EndIf;
	
	ConductErrors = DocumentsPosting.RecheckDocumentsOnAccumulationRegister(ParametersOfTheEvent, SelectionOfDocuments, AccumulationRegisterName);
	
	For Each ErrorText In ConductErrors Do
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenRestoringDocumentRegisterRecords,
			ErrorText,
			ErrorText);
			
	EndDo;
	
	Return ConductErrors;
	
EndFunction

