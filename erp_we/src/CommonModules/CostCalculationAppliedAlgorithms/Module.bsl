// The procedure is a handler for checking the state of the system "costeddistributed rights".
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure CheckingCostsNotAllocatedAccordingToRules(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	QueryText =
	"SELECT
	|	CompanyGoods.Recorder AS Recorder,
	|	CompanyGoods.Organization AS Organization,
	|	SUM(CompanyGoods.Count) AS Count
	|INTO CompanyGoods
	|FROM
	|	AccumulationRegister.CompanyGoods AS CompanyGoods
	|	LEFT JOIN InformationRegister.DocumentsRegistry AS StornoRegistry
	|	ON StornoRegistry.ReversedDocument = CompanyGoods.Recorder
	|		AND NOT StornoRegistry.AdditionalRecord
	|		AND StornoRegistry.IBDocumentDate BETWEEN &BeginOfPeriod AND &EndOfPeriod 
	|		AND StornoRegistry.Posted
	|WHERE
	|	CompanyGoods.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND CompanyGoods.Organization IN (&CompanyArray)
	|	AND CompanyGoods.BusinessOperation = VALUE(Enum.BusinessTransactions.AllocationOfExpensesForProductionLots)
	|	AND CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
	|	AND CompanyGoods.Recorder REFS Document.ProductionCostAllocation
	// Checking for the presence of a reverse in the Cur period.
	|	AND StornoRegistry.Ref IS NULL
	|
	|GROUP BY
	|	CompanyGoods.Recorder,
	|	CompanyGoods.Organization
	|
	|UNION ALL
	|
	|SELECT
	|	Allocation.Ref AS Recorder,
	|	Allocation.Organization AS Organization,
	|	Allocation.QuantityToAllocateAccordingToRule AS Count
	|FROM
	|	Document.ProductionCostAllocation AS Allocation
	|	LEFT JOIN InformationRegister.DocumentsRegistry AS StornoRegistry
	|	ON StornoRegistry.ReversedDocument = Allocation.Ref
	|		AND NOT StornoRegistry.AdditionalRecord
	|		AND StornoRegistry.IBDocumentDate BETWEEN &BeginOfPeriod AND &EndOfPeriod 
	|		AND StornoRegistry.Posted
	|WHERE
	|	Allocation.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND Allocation.Organization IN (&CompanyArray)
	|	AND Allocation.Posted
	|	AND Allocation.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
	|	AND NOT Allocation.Products.TracedGoods
	|	AND Allocation.QuantityToAllocateAccordingToRule <> 0
	// Checking for the presence of a reverse in the Cur period.
	|	AND StornoRegistry.Ref IS NULL
	|
	|INDEX BY
	|	Recorder,
	|	Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InventoryCost.Recorder AS Recorder,
	|	InventoryCost.Organization AS Organization,
	|	SUM(InventoryCost.Count) AS Count
	|INTO InventoryCost
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|WHERE
	|	InventoryCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCost.Organization IN (&CompanyArray)
	|	AND InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AllocationOfExpensesForProductionLots)
	|	AND InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
	|	AND InventoryCost.LotCalculation
	|	AND InventoryCost.Recorder REFS Document.ProductionCostAllocation
	|
	|GROUP BY
	|	InventoryCost.Recorder,
	|	InventoryCost.Organization
	|
	|INDEX BY
	|	Recorder,
	|	Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	CompanyGoods.Recorder AS Recorder,
	|	CompanyGoods.Organization AS Organization,
	|	&EndOfPeriod AS EndOfPeriod
	|INTO TTDocumentsWithUnallocatedExpensesAccordingToRules
	|FROM
	|	CompanyGoods AS CompanyGoods
	|		LEFT JOIN InventoryCost AS InventoryCost
	|		ON CompanyGoods.Recorder = InventoryCost.Recorder
	|			AND CompanyGoods.Organization = InventoryCost.Organization
	|WHERE
	|	CompanyGoods.Count <> ISNULL(InventoryCost.Count, 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP CompanyGoods
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP InventoryCost";
	
	// Let's register the errors.
	FieldList = New ValueList;
	FieldList.Add("Organization");
	FieldList.Add("Recorder");
	FieldList.Add("EndOfPeriod");
	
	RegistrationParameters = MonthEndTransactionsServer.InitializeRegistrationAndVerificationParameters(
		"TTDocumentsWithUnallocatedExpensesAccordingToRules",
		NStr("vi = 'Đã tìm thấy chứng từ phân bổ nguyên vật liệu và công việc mà chưa thực hiện phân bổ chi phí trong biểu ghi ""Giá vốn hàng hóa"" theo doanh nghiệp ""%1"" vào cuối kỳ %2';
			|ru = 'Обнаружены документы распределения материалов и работ, по которым не выполнено распределение затрат в регистре ""Себестоимость товаров"", по организации ""%1"" на конец периода %2';
			|en = 'Documents of allocation of materials and works, whose costs are not allocated in the ""Inventory cost"" register by %1 company as of the %2 period end are detected'; fa = 'Documents of allocation of materials and works, whose costs are not allocated in the ""Inventory cost"" register by %1 company as of the %2 period end are detected';
			|it = 'Sono stati rilevati documenti di distribuzione materiali e lavori per i quali non è stata effettuata la distribuzione delle spese nel registro ""Prezzo di costo degli articoli"" per l''azienda ""%1"" alla fine del periodo %2';
			|pl = 'Wykryto dokumenty przydzielenia materiałów i prac, według których nie wykonano przydzielenia kosztów w rejestrze ""Koszt własny towarów"", według firmy ""%1"" na koniec okresu %2';
			|tr = '%2 döneminin sonunda ""%1"" iş yerine göre ""Stok maliyeti"" kaydında maliyetlerin dağıtımının yapılmadığı geri dönüştürülebilir atıkların dağıtım belgeleri tespit edilmiştir'"),
		FieldList);
		
	MonthEndTransactionsServer.RegisterValidationIssues(
		CheckParameters,
		RegistrationParameters,
		QueryText);
	
EndProcedure

// Procedure-handler for checking the State of the "Returnable waste to distributed corrections" system.
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure CheckingRecyclableWasteNotDistributedAccordingToRules(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	QueryText =
	"SELECT
	|	Allocation.Ref AS Recorder,
	|	Allocation.Organization AS Organization,
	|	Allocation.QuantityAccordingToRule AS Count
	|
	|INTO DistributionDocuments
	|FROM
	|	Document.RecyclableWasteAllocation AS Allocation
	|	LEFT JOIN InformationRegister.DocumentsRegistry AS StornoRegistry
	|	ON StornoRegistry.ReversedDocument = Allocation.Ref
	|		AND NOT StornoRegistry.AdditionalRecord
	|		AND StornoRegistry.IBDocumentDate BETWEEN &BeginOfPeriod AND &EndOfPeriod 
	|		AND StornoRegistry.Posted
	|WHERE
	|	Allocation.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND Allocation.Organization IN (&CompanyArray)
	|	AND Allocation.Posted
	// Checking for the presence of a reverse in the Cur period.
	|	AND StornoRegistry.Ref IS NULL
	|
	|INDEX BY
	|	Recorder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	InventoryCost.Recorder AS Recorder,
	|	InventoryCost.Organization AS Organization,
	|	SUM(-InventoryCost.Count) AS Count
	|INTO InventoryCost
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|WHERE
	|	InventoryCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCost.Organization IN (&CompanyArray)
	|	AND InventoryCost.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)
	|	AND InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
	|	AND InventoryCost.Recorder REFS Document.RecyclableWasteAllocation
	|	AND InventoryCost.LotCalculation
	|
	|GROUP BY
	|	InventoryCost.Recorder,
	|	InventoryCost.Organization
	|
	|INDEX BY
	|	Recorder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	DistributionDocuments.Recorder AS Recorder,
	|	DistributionDocuments.Organization AS Organization,
	|	&EndOfPeriod AS EndOfPeriod
	|INTO TTDocumentsWithUnallocatedExpensesAccordingToRules
	|FROM
	|	DistributionDocuments AS DistributionDocuments
	|		LEFT JOIN InventoryCost AS InventoryCost
	|		ON InventoryCost.Recorder = DistributionDocuments.Recorder
	|			AND InventoryCost.Organization = DistributionDocuments.Organization
	|WHERE
	|	DistributionDocuments.Count <> ISNULL(InventoryCost.Count, 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP DistributionDocuments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP InventoryCost";
	
	// Let's register the errors.
	FieldList = New ValueList;
	FieldList.Add("Organization");
	FieldList.Add("Recorder");
	FieldList.Add("EndOfPeriod");
	
	RegistrationParameters = MonthEndTransactionsServer.InitializeRegistrationAndVerificationParameters(
		"TTDocumentsWithUnallocatedExpensesAccordingToRules",
		NStr("vi = 'Đã tìm thấy các chứng từ phân bổ phế liệu thu hồi, theo đó chưa thực hiện phân bổ chi phí trong biểu ghi ""Giá vốn hàng hóa"", theo doanh nghiệp ""%1"" vào cuối kỳ %2';
			|ru = 'Обнаружены документы распределения возвратных отходов, по которым не выполнено распределение затрат в регистре ""Себестоимость товаров"", по организации ""%1"" на конец периода %2';
			|en = 'Documents of recyclable waste allocation whose costs are not allocated in the ""Inventory cost"" register by the %1 company as of the %2 period end are detected'; fa = 'Documents of recyclable waste allocation whose costs are not allocated in the ""Inventory cost"" register by the %1 company as of the %2 period end are detected';
			|it = 'Обнаружены документы распределения возвратных отходов, по которым не выполнено распределение затрат в регистре ""Себестоимость товаров"", по организации ""%1"" на конец периода %2';
			|pl = 'Documents of recyclable waste allocation whose costs are not allocated in the ""Inventory cost"" register by the %1 company as of the %2 period end are detected';
			|tr = '%2 döneminin sonunda ""%1"" iş yerine göre ""Stok maliyeti"" kaydında maliyetlerin dağıtımının yapılmadığı geri dönüştürülebilir atıkların dağıtım belgeleri tespit edilmiştir'"),
		FieldList);
		
	MonthEndTransactionsServer.RegisterValidationIssues(
		CheckParameters,
		RegistrationParameters,
		QueryText);
	
EndProcedure

