// the procedure is a handler for checking the State of the system "unallocated items for sale".
//
// Parameters:
// CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure VerificationOfUnallocatedItemByItemSalesExpenses(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	ClosingParameters = CalculationOfCostCached.ValuesOfTechnologicalParameters();
	CheckParameters.AdditionalParameters.Insert("TempTablesManager", New TempTablesManager);
	
	Query = New Query;
	Query.TempTablesManager = CheckParameters.AdditionalParameters.TempTablesManager;
	
	QueryOptions = Documents.AllocationOfOtherCosts.DescriptionOfParametersForRequestingDataForDistribution();
	QueryOptions.Insert("Period", CheckParameters.AdditionalParameters.Period);
	QueryOptions.Insert("Companies", CheckParameters.AdditionalParameters.CompanyArray);
	Documents.AllocationOfOtherCosts.InitializeRequestToGetDataForDistribution(Query, QueryOptions);
	
	QueryText = "SELECT
	|	ExpenseItems.Ref AS Ref
	|INTO ManSExpenditureItems
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|WHERE
	|	ExpenseItems.CostAllocationOptionManag = &CostAllocationOption
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ExpenseItems.Ref AS Ref
	|INTO ExpenseItemsLocal
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|WHERE
	|	ExpenseItems.CostAllocationOptionLocal = &CostAllocationOption
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ExpenseItems.Ref AS Ref
	|INTO ExpenseItemsTA
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|WHERE
	|	ExpenseItems.CostAllocationOptionTax = &CostAllocationOption
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ManSExpenditureItems.Ref AS Ref
	|INTO ExpenseItems
	|FROM
	|	ManSExpenditureItems AS ManSExpenditureItems
	|
	|UNION
	|
	|SELECT
	|	ExpenseItemsLocal.Ref
	|FROM
	|	ExpenseItemsLocal AS ExpenseItemsLocal
	|
	|UNION
	|
	|SELECT
	|	ExpenseItemsTA.Ref
	|FROM
	|	ExpenseItemsTA AS ExpenseItemsTA
	|;
	|
	|SELECT
	|	OtherExpensesBalance.Organization				AS Organization,
	|	OtherExpensesBalance.Department				AS Department,
	|	OtherExpensesBalance.LineOfBusiness	AS LineOfBusiness,
	|	OtherExpensesBalance.ExpenseItem				AS ExpenseItem,
	|	OtherExpensesBalance.DimensionOfExpenses			AS DimensionOfExpenses,
	|	OtherExpensesBalance.SumBalance				AS SumBalance,
	|	OtherExpensesBalance.AmountExcludingVATBalance			AS AmountExcludingVATBalance,
	|	OtherExpensesBalance.SumManBalance			AS SumManBalance,
	|	OtherExpensesBalance.SumComplBalance			AS SumComplBalance,
	|	OtherExpensesBalance.PermanentDifferenceBalance	AS PermanentDifferenceBalance,
	|	OtherExpensesBalance.CostTDBalance	AS CostTDBalance,
	|	VALUETYPE(OtherExpensesBalance.DimensionOfExpenses) = TYPE(Document.SalesOrder) AnalyticsIsSalesOrder
	|INTO OtherExpensesBalance
	|FROM
	|	AccumulationRegister.OtherExpenses.Balance(&BorderEndOfPeriod, Organization IN (&CompanyArray)
	|		AND ExpenseItem IN
	|			(SELECT
	|				ExpenseItems.Ref AS Ref
	|			FROM
	|				ExpenseItems AS ExpenseItems)) AS OtherExpensesBalance
	|INDEX BY
	|	AnalyticsIsSalesOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	DD.ReferenceOrder AS SalesOrder,
	|	DD.Products AS Products,
	|	DD.Characteristic AS Characteristic,
	|	DD.RowCode AS RowCode,
	|	DD.Warehouse AS Warehouse,
	|	DD.Series AS Series,
	|	SUM(CASE
	|		WHEN DD.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
	|		THEN 1 ELSE -1 END * DD.CountTurnover) AS Balance
	|INTO BalancesBySalesOrders
	|FROM
	|	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(,&EndOfPeriod,,
	|			ReferenceOrder IN (SELECT FilterOrderNumber__1.DimensionOfExpenses
	|				FROM OtherExpensesBalance AS FilterOrderNumber__1 WHERE FilterOrderNumber__1.AnalyticsIsSalesOrder)
	|			AND RowCode <> 0
	|			AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped),
	|				VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered))) AS DD
	|GROUP BY
	|	DD.ReferenceOrder,
	|	DD.Products,
	|	DD.Characteristic,
	|	DD.RowCode,
	|	DD.Warehouse,
	|	DD.Series
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	BalancesBySalesOrders.SalesOrder AS SalesOrder
	|INTO OpenOrders
	|FROM
	|	BalancesBySalesOrders AS BalancesBySalesOrders
	|WHERE
	|	BalancesBySalesOrders.Balance <> 0
	|INDEX BY
	|	SalesOrder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherExpensesBalance.Organization AS Organization,
	|	OtherExpensesBalance.Department AS Department,
	|	OtherExpensesBalance.LineOfBusiness AS LineOfBusiness,
	|	OtherExpensesBalance.ExpenseItem AS ExpenseItem,
	|	OtherExpensesBalance.DimensionOfExpenses AS DimensionOfExpenses
	|INTO UnallocatedSellingExpenses
	|FROM
	|	OtherExpensesBalance AS OtherExpensesBalance
	|	LEFT JOIN ManSExpenditureItems AS Man
	|	ON OtherExpensesBalance.ExpenseItem = Man.Ref
	|	LEFT JOIN ExpenseItemsLocal AS Compl
	|	ON OtherExpensesBalance.ExpenseItem = Compl.Ref
	|	LEFT JOIN ExpenseItemsTA AS TA
	|	ON OtherExpensesBalance.ExpenseItem = TA.Ref
	|WHERE
	|	NOT OtherExpensesBalance.AnalyticsIsSalesOrder
	|	AND (Man.Ref IS NOT NULL
	|	AND (OtherExpensesBalance.SumBalance <> 0
	|	OR OtherExpensesBalance.AmountExcludingVATBalance <> 0
	|	OR OtherExpensesBalance.SumManBalance <> 0)
	|	OR Compl.Ref IS NOT NULL
	|	AND OtherExpensesBalance.SumComplBalance <> 0
	|	OR TA.Ref IS NOT NULL
	|	AND OtherExpensesBalance.SumComplBalance - OtherExpensesBalance.PermanentDifferenceBalance -
	|		OtherExpensesBalance.CostTDBalance <> 0)
	|
	|UNION
	|
	|SELECT
	|	OtherExpensesBalance.Organization AS Organization,
	|	OtherExpensesBalance.Department AS Department,
	|	OtherExpensesBalance.LineOfBusiness AS LineOfBusiness,
	|	OtherExpensesBalance.ExpenseItem AS ExpenseItem,
	|	OtherExpensesBalance.DimensionOfExpenses AS DimensionOfExpenses
	|FROM
	|	OtherExpensesBalance AS OtherExpensesBalance
	|	LEFT JOIN ManSExpenditureItems AS Man
	|	ON OtherExpensesBalance.ExpenseItem = Man.Ref
	|	LEFT JOIN ExpenseItemsLocal AS Compl
	|	ON OtherExpensesBalance.ExpenseItem = Compl.Ref
	|	LEFT JOIN ExpenseItemsTA AS TA
	|	ON OtherExpensesBalance.ExpenseItem = TA.Ref
	|	LEFT JOIN OpenOrders AS OpenOrders
	|	ON OtherExpensesBalance.DimensionOfExpenses = OpenOrders.SalesOrder
	|WHERE
	|	OtherExpensesBalance.AnalyticsIsSalesOrder
	|	AND OpenOrders.SalesOrder IS NULL
	|	AND (Man.Ref IS NOT NULL
	|	AND (OtherExpensesBalance.SumBalance <> 0
	|	OR OtherExpensesBalance.AmountExcludingVATBalance <> 0
	|	OR OtherExpensesBalance.SumManBalance <> 0)
	|	OR Compl.Ref IS NOT NULL
	|	AND OtherExpensesBalance.SumComplBalance <> 0
	|	OR TA.Ref IS NOT NULL
	|	AND OtherExpensesBalance.SumComplBalance - OtherExpensesBalance.PermanentDifferenceBalance -
	|		OtherExpensesBalance.CostTDBalance <> 0)
	|";
	
	Documents.AllocationOfOtherCosts.QueryTextDataForDistribution(1, True);
	
	// Additional request parameters.
	AdditionalParameters = New Structure;
	AdditionalParameters.Insert("CostAllocationOption", 
		Enums.CostAllocationOptions.ToCostOfGoodsSold);
	
	FieldList = New ValueList;
	FieldList.Add("Organization", 				NStr("vi = 'Doanh nghiệp';
														|ru = 'Организация';
														|en = 'Company'; fa = 'Company';
														|it = 'Azienda';
														|pl = 'Organizacja';
														|tr = 'İş yeri'", Common.DefaultLanguageCode()));
	FieldList.Add("Department",				NStr("vi = 'Bộ phận';
													|ru = 'Подразделение';
													|en = 'Business unit'; fa = 'Business unit';
													|it = 'Reparto';
													|pl = 'Dział';
													|tr = 'Departman'", Common.DefaultLanguageCode()));
	FieldList.Add("ExpenseItem",				NStr("vi = 'Dạng chi phí';
													|ru = 'Статья расходов';
													|en = 'Expense item'; fa = 'قلم هزینه';
													|it = 'Voce di spese';
													|pl = 'Rodzaj kosztu';
													|tr = 'Gider kalemi'", Common.DefaultLanguageCode()));
	FieldList.Add("DimensionOfExpenses",			NStr("vi = 'Đối tượng phân tích chi phí';
														|ru = 'Аналитика расходов';
														|en = 'Expense dimension'; fa = 'بُعد هزینه';
														|it = 'Analitica delle uscite';
														|pl = 'Analityka kosztów';
														|tr = 'Gider boyutu'", Common.DefaultLanguageCode()));
	FieldList.Add("LineOfBusiness",		NStr("vi = 'Lĩnh vực hoạt động';
												|ru = 'Направление деятельности';
												|en = 'Line of business'; fa = 'خط کسب‌وکار';
												|it = 'Settore di attività';
												|pl = 'Rodzaj działalności';
												|tr = 'İş kolu'", Common.DefaultLanguageCode()));
	
	RegistrationParameters = MonthEndTransactionsServer.InitializeRegistrationAndVerificationParameters(
		"UnallocatedSellingExpenses",
		NStr("vi = 'Đã tìm thấy chi phí bán hàng theo từng giai đoạn chưa được phân bổ theo doanh nghiệp ""%1"" vào cuối kỳ %2';
			|ru = 'Обнаружены нераспределенные постатейные расходы на продажу по организации ""%1"" на конец периода %2';
			|en = 'Unallocated itemized sales expenses by the %1 company were found at the end of the period: %2'; fa = 'Unallocated itemized sales expenses by the %1 company were found at the end of the period: %2';
			|it = 'Sono state rilevate delle uscite dettagliate non distribuite per la vendita per l''azienda ""%1"" alla fine del periodo %2';
			|pl = 'Wykryto nieprzydzielona rozchody według pozycji na sprzedaż dla firmy ""%1"" na koniec okresu %2';
			|tr = 'Dönem sonunda ""%1"" iş yeri için yanlış dağıtılmamış satış gider kalemleri tespit edildi %2'", Common.DefaultLanguageCode()),
		FieldList,
		,
		Metadata.AccumulationRegisters.OtherExpenses.FullName());
		
	MonthEndTransactionsServer.RegisterValidationIssues(
		CheckParameters,
		RegistrationParameters,
		QueryText, AdditionalParameters);
	
EndProcedure

// Procedure-handler for checking the State of the system "Verifieddistributed state spending of the Interkampany".
//
// Parameters:
// CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure VerificationOfUndistributedItemByItemExpensesOfIntercampany(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	CheckParameters.AdditionalParameters.Insert("TempTablesManager", New TempTablesManager);
	
	Query = New Query;
	Query.TempTablesManager = CheckParameters.AdditionalParameters.TempTablesManager;
	
	QueryOptions = Documents.AllocationOfOtherCosts.DescriptionOfParametersForRequestingDataForDistribution();
	QueryOptions.Insert("Period", CheckParameters.AdditionalParameters.Period);
	QueryOptions.Insert("Companies", CheckParameters.AdditionalParameters.CompanyArray);
	Documents.AllocationOfOtherCosts.InitializeRequestToGetDataForDistribution(Query, QueryOptions);
	
	QueryText = "SELECT
	|	ExpenseItems.Ref AS Ref
	|INTO ExpenseItemsLocal
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|WHERE
	|	ExpenseItems.CostAllocationOptionLocal IN (&CostAllocationOption)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ExpenseItems.Ref AS Ref
	|INTO ExpenseItemsTA
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
	|WHERE
	|	ExpenseItems.CostAllocationOptionTax IN (&CostAllocationOption)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ExpenseItemsLocal.Ref
	|INTO ExpenseItems
	|FROM
	|	ExpenseItemsLocal AS ExpenseItemsLocal
	|
	|UNION
	|
	|SELECT
	|	ExpenseItemsTA.Ref
	|FROM
	|	ExpenseItemsTA AS ExpenseItemsTA
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherExpensesBalance.Organization AS Organization,
	|	OtherExpensesBalance.Department AS Department,
	|	OtherExpensesBalance.LineOfBusiness AS LineOfBusiness,
	|	OtherExpensesBalance.ExpenseItem AS ExpenseItem,
	|	OtherExpensesBalance.DimensionOfExpenses AS DimensionOfExpenses,
	|	OtherExpensesBalance.SumComplBalance AS SumComplBalance,
	|	OtherExpensesBalance.SumComplBalance
	|		- OtherExpensesBalance.PermanentDifferenceBalance
	|		- OtherExpensesBalance.CostTDBalance AS AmountFABalance
	|
	|INTO OtherExpensesBalance
	|FROM
	|	AccumulationRegister.OtherExpenses.Balance(&BorderEndOfPeriod,
	|		Organization IN (&CompanyArray)
	|		AND ExpenseItem IN
	|			(SELECT
	|				ExpenseItems.Ref AS Ref
	|			FROM
	|				ExpenseItems AS ExpenseItems)
	|	) AS OtherExpensesBalance
	|
	|INDEX BY
	|	DimensionOfExpenses
	|;
	|////////////////////////////////////////////////////////////////////////////////
	// The request is similar to the function textquestionatablycautprocessing inputs() in the module of the register manager other inputs.
	|SELECT 
	|	OtherExpensesBalance.DimensionOfExpenses AS DimensionOfExpenses,
	|	MAX(DocumentsRegistry.Organization) AS Organization
	|
	|INTO TTRegisterOfDocumentsOtherExpenses
	|FROM 
	|	OtherExpensesBalance AS OtherExpensesBalance
	|		INNER JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	|			ON OtherExpensesBalance.DimensionOfExpenses = DocumentsRegistry.Ref
	|WHERE
	|	NOT DocumentsRegistry.AdditionalRecord
	|
	|GROUP BY
	|	OtherExpensesBalance.DimensionOfExpenses
	|
	|INDEX BY
	|	DimensionOfExpenses
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	OtherExpensesBalance.Organization AS Organization,
	|	OtherExpensesBalance.Department AS Department,
	|	OtherExpensesBalance.LineOfBusiness AS LineOfBusiness,
	|	OtherExpensesBalance.ExpenseItem AS ExpenseItem,
	|	OtherExpensesBalance.DimensionOfExpenses AS DimensionOfExpenses,
	|	TTDocumentRegistry.Organization AS CostAnalyticsCompany
	|INTO UnallocatedExpensesOfIntercampany
	|FROM
	|	OtherExpensesBalance AS OtherExpensesBalance
	|	INNER JOIN TTRegisterOfDocumentsOtherExpenses AS TTDocumentRegistry
	|		ON OtherExpensesBalance.DimensionOfExpenses = TTDocumentRegistry.DimensionOfExpenses
