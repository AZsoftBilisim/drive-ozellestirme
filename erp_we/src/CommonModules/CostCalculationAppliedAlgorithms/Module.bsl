				Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
				ProtocolText_);
			
			RegisterCalculationExecutionProblem(
				CalculationParameters,
				,
				NStr("vi = 'Khi tạo các bản ghi kết chuyển theo lô, đã chẩn đoán được lỗi';
					|ru = 'При формировании движений по партиям диагностированы ошибки';
					|en = 'Errors were found when generating lot records'; fa = 'Errors were found when generating lot records';
					|it = 'Durante la creazione dei movimenti sui lotti sono stati diagnosticati degli errori';
					|pl = 'Podczas tworzenia ruchów wg partii wykryto błędy';
					|tr = 'Hareketlerin lotlar halinde oluşturulması sırasında hatalar tespit edildi'", Common.DefaultLanguageCode()),
				ProtocolText_);
				
			ProtocolText_ = TextExceptionToLogProblem(ProtocolText_);
			
		EndIf;
		
		Raise ProtocolText_;
		
	EndIf;
	
	MinimumNodeNumber  = RecordManager.MinimumNodeNumber;
	MaximumNodeNumber = RecordManager.MaximumNodeNumber;
	
	Return RecordManager.Data.Get();
	
EndFunction

Procedure ClearBatchCalculationDataCache(CalculationID = Undefined) Export
	
	RecordSet = InformationRegisters.LotAccountingDataCache.CreateRecordSet();
	
	If ValueIsFilled(CalculationID) Then
		RecordSet.Filter.CalculationID.Set(CalculationID);
	EndIf;
	
	RecordSet.Write(True);
	
EndProcedure

Procedure ClearOutdatedBatchCalculationDataCaches() Export
	
	CurrentVersion = TrimAll(Metadata.Version);
	
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT
	|	T.VersionNumber AS VersionNumber
	|FROM
	|	InformationRegister.LotAccountingDataCache AS T
	|WHERE
	|	T.VersionNumber <> &CurrentVersion";
	
	Query.SetParameter("CurrentVersion", CurrentVersion);
	
	Selection = Query.Execute().Select();
	
	While Selection.Next() Do
		
		RecordSet = InformationRegisters.LotAccountingDataCache.CreateRecordSet();
		RecordSet.Filter.VersionNumber.Set(Selection.VersionNumber);
	
		RecordSet.Write(True);
		
	EndDo;
	
EndProcedure

Function NumberOfCalculationResultsInBatchCalculationDataCache(CalculationID)
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	ISNULL(MAX(T.DataPortionNumber), -1) AS DataPortionNumber
	|FROM
	|	InformationRegister.LotAccountingDataCache AS T
	|WHERE
	|	T.CalculationID = &CalculationID
	|	AND T.DataType = VALUE(Enum.DataTypesInLotAccountingCache.CalculationResult2)";
	
	Query.SetParameter("CalculationID", CalculationID);
	
	Selection = Query.Execute().Select();
	Selection.Next();
	
	Return Selection.DataPortionNumber;
	
EndFunction

// Auxiliary background calculation procedures.

Function GenerateBackgroundCalculationParameters(CalculationParameters)
	
	AllLinks 			= Common.AllRefsTypeDetails();
	CopyableTypes 		= New TypeDescription("String, Date, Number, Boolean, Array, Map");
	CopiedStructures = New Structure("DistributionOfParties, PayrollPeriod, FEDERALDISTRICT, AccountingPolicies");
	
	BackgroundCalculationParameters = New Structure;
	
	For Each KeyAndValue In CalculationParameters Do
		
		ParameterType = TypeOf(KeyAndValue.Value);
		
		If CopyableTypes.ContainsType(ParameterType)
		 Or AllLinks.ContainsType(ParameterType)
		 Or (ParameterType = Type("Structure") And CopiedStructures.Property(KeyAndValue.Key)) Then
			BackgroundCalculationParameters.Insert(KeyAndValue.Key, KeyAndValue.Value);
		EndIf;
		
	EndDo;
	
	BackgroundCalculationParameters.PlaceOfCalculationCall = CostCalculationProtocol.PresentationOfCurStage(CalculationParameters);
	
	SetTechnologicalParametersOfCalculation(BackgroundCalculationParameters);
	
	Return BackgroundCalculationParameters;
	
EndFunction

Function ThisIsBackgroundBatchCalculation(CalculationParameters)
	Return ValueIsFilled(CalculationParameters.CalculationID);
EndFunction

