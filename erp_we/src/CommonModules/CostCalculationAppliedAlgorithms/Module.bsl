#Region ProceduresCalledFromReports

// When generating the report, it checks whether the batch calculation is up-to-date and, if necessary, runs the batch calculation in the background task.
// The report header also displays information about the current state of batch calculation.
// Parameters for starting batch calculation are placed in the settings Linker.Custom settings.Additional properties.
//
// Parameters:
//	ResultDocument   - SpreadsheetDocument - table document of the report that is being checked.
//	SettingsComposer - DataCompositionSettingsComposer - linker for settings for the report that causes validation.
//	CompanyFieldName1  - String - name of the business details field.
//
Procedure UpdateBatchesForReports(ResultDocument, SettingsComposer, CompanyFieldName1 = "Organization") Export
	
	SetPrivilegedMode(True);
	
	CalculationParameters = SettingsComposer.UserSettings.AdditionalProperties;
	CalculationParameters.Insert("LotsAndCostCalculation", False);
	CalculationParameters.Insert("StartOfSettlementPeriod", 		Undefined);
	CalculationParameters.Insert("EndOfSettlementPeriod", 		Undefined);
	CalculationParameters.Insert("CompanyArray", 			Undefined);
	CalculationParameters.Insert("DocumentsCount", 		0);
	CalculationParameters.Insert("JobNumber", 				InformationRegisters.JobsForCalculatingCost.GetTaskNumber());
	
	ReportPeriodParameter = DataCompositionClientServer.GetParameter(SettingsComposer, "Period");
	ValueOfReportParameter = ReportPeriodParameter.Value; //StandardPeriod
	CalculationBoundary 		 = ?(ReportPeriodParameter.Use, ValueOfReportParameter.EndDate, CurrentSessionDate());
	
	// Let's check the date of the ban on changes.
	DataTable = PeriodClosingDates.DataToCheckTemplate(); // ValueTable
	NewRow = DataTable.Add();
	NewRow.Date   = BegOfMonth(CalculationBoundary);
	NewRow.Section = "RoutineOperations";
	
	ChangesAreDisabled = PeriodClosingDates.PeriodEndClosingFound(DataTable);
	
	If ExchangePlans.MasterNode() = Undefined
	 And Not ChangesAreDisabled
	 And Constants.UpdateDataWhileGeneratingReports.Get()
	 And CalculationOfCostCached.BatchAccountingIsEnabled(BegOfMonth(CalculationBoundary)) Then
		
		CalculationParameters.CompanyArray = OrganizationsToSelectFromReportSettings(SettingsComposer, CompanyFieldName1);
		
		CalculationScheme = BatchCalculationScheme(CalculationBoundary, CalculationParameters.CompanyArray);
		
		If CalculationScheme.Count() > 0 Then
			
			CalculationParameters.StartOfSettlementPeriod 		= BegOfMonth(CalculationScheme[0].Date);
			CalculationParameters.EndOfSettlementPeriod  		= EndOfMonth(CalculationBoundary);
			
			CalculationParameters.CompanyArray 	  		= Common.CopyRecursive(
				CalculationScheme[CalculationScheme.Count()-1].Companies); // the last line contains all the organizations for which the calculation will be performed
			
			CalculationParameters.DocumentsCount 		= NumberOfIrrelevantDocuments(CalculationParameters);
			
			ActiveCalculations = InformationRegisters.PerformMonthEndClosingOperations.CheckForActiveCalculations(CalculationParameters.CompanyArray);
			
			If Not ActiveCalculations.ThereAreActiveCalculations Then
				CalculationParameters.LotsAndCostCalculation = CalculationOfCost.CalculateByBackgroundTask(
					CalculationParameters.EndOfSettlementPeriod,
					CalculationParameters.CompanyArray);
			EndIf;
			
			PrintDescriptionOfRelevanceOfCalculation(ResultDocument, CalculationParameters, ActiveCalculations.ThereAreActiveCalculations);
			
		EndIf;
		
	EndIf;
	
EndProcedure

// Checks that the batch calculation started when generating the report is complete.
//
// Parameters:
//	CalculationParameters - Structure - batch calculation launch parameters;
//		For the structure keys, see Actualize the Reportparty() and reportclientdetermined.Restore Offline accounts().
//
// Returns:
//	Boolean - the sign of the end of the calculation.
//
Function BatchesUpdatedForReports(CalculationParameters) Export
	
	If ExchangePlans.MasterNode() <> Undefined
	 Or Not CalculationParameters.Property("EndOfSettlementPeriod")
	 Or Not ValueIsFilled(CalculationParameters.EndOfSettlementPeriod) Then
		Return True; // the calculation was not performed
	EndIf;
	
	SetPrivilegedMode(True);
	
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	MIN(BEGINOFPERIOD(Queue.Month, Month)) AS StartOfSettlementPeriod
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS Queue
	|WHERE
	|	Queue.JobNumber <= &JobNumber
	|	AND Queue.Organization IN (&CompanyArray)
	|HAVING 
	|	NOT (MIN(Queue.Month) IS NULL)
	|	AND MIN(BEGINOFPERIOD(Queue.Month, Month)) <= &EndOfSettlementPeriod
	|";
	
	Query.SetParameter("EndOfSettlementPeriod", CalculationParameters.EndOfSettlementPeriod);
	Query.SetParameter("CompanyArray", 	 CalculationParameters.CompanyArray);
	Query.SetParameter("JobNumber", 		 CalculationParameters.JobNumber);
	
	Result = Query.Execute();
	
	Return Result.IsEmpty();
	
EndFunction


// Returns the number of documents that were changed after the last close of the month.
//
// Returns:
//	Number - 
//
Function NumberOfIrrelevantDocuments(CalculationParameters)
	
	DocumentsCount = 0;
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	COUNT(DISTINCT Jobs.Document) AS Count
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS Jobs
	|WHERE
	|	Jobs.Document <> UNDEFINED
	|	AND BEGINOFPERIOD(Jobs.Month, Month) <= &Period
	|	AND (&ByAllCompanies OR Jobs.Organization IN (&CompanyArray))";
	
	Query.SetParameter("Period", 	  		CalculationParameters.EndOfSettlementPeriod);
	Query.SetParameter("CompanyArray", 	CalculationParameters.CompanyArray);
	Query.SetParameter("ByAllCompanies", Not ValueIsFilled(CalculationParameters.CompanyArray));
	
	Selection = Query.Execute().Select();
	
	If Selection.Next() Then 
		DocumentsCount = Selection.Count;
	EndIf;
	
	Return DocumentsCount;
	
EndFunction

// Returns an array of organizations that the report will be based on.
// Recognizes in report selections only one selection condition for an organization with the comparison types "equal", "in the list", "not equal", "not in the list".
//
Function OrganizationsToSelectFromReportSettings(SettingsComposer, CompanyFieldName1 = "Organization")
	
	If SettingsComposer = Undefined Then
		Return Catalogs.Companies.AvailableCompanies(True);
	EndIf;
	
	ComparisonOperation = New Array;
	ComparisonOperation.Add(DataCompositionComparisonType.Equal);
	ComparisonOperation.Add(DataCompositionComparisonType.InList);
	
	FilterOrganization = TMReportFunctionsClientServer.GetSelectionValue(SettingsComposer, CompanyFieldName1, ComparisonOperation);
	FilterRecorder = TMReportFunctionsClientServer.GetSelectionValue(SettingsComposer, "Recorder", ComparisonOperation);
	
	If FilterOrganization = Undefined Then
		
		If FilterRecorder = Undefined Then
			
			ByAllCompanies = True;
			CompanyArray = New Array;
			
		Else
			
			// With contextual execution of reports, selection by registrar is set, without selection by organization.
			Query = New Query;
			Query.Text =
			"SELECT DISTINCT
			|	T.Organization AS Organization
			|FROM
			|	InformationRegister.DocumentsRegistry AS T
			|WHERE
			|	T.Ref IN(&Recorders)
			|	AND T.Ref <> UNDEFINED";
			
			Query.SetParameter("Recorders", TMCommonUseClientServer.Array(FilterRecorder));
			
			CompanyArray = Query.Execute().Unload().UnloadColumn("Organization");
			ByAllCompanies = Not ValueIsFilled(CompanyArray);
			
		EndIf;
		
	Else
		
		ByAllCompanies = False;
		CompanyArray = TMCommonUseClientServer.Array(FilterOrganization);
		
	EndIf;
	
	ComparisonOperation = New Array;
	ComparisonOperation.Add(DataCompositionComparisonType.NotEqual);
	ComparisonOperation.Add(DataCompositionComparisonType.NotInList);
	
	FilterOrganization = TMReportFunctionsClientServer.GetSelectionValue(SettingsComposer, CompanyFieldName1, ComparisonOperation);
	
	If FilterOrganization = Undefined Then
		ArrayOfExcludedOrganizations = New Array;
	Else
		ArrayOfExcludedOrganizations = TMCommonUseClientServer.Array(FilterOrganization);
	EndIf;
	
	Query = New Query;
	Query.SetParameter("ByAllCompanies", 		  ByAllCompanies);
	Query.SetParameter("CompanyArray", 			  CompanyArray);
	Query.SetParameter("ArrayOfExcludedOrganizations", ArrayOfExcludedOrganizations);
	Query.SetParameter("UseManagementCompany",
		GetFunctionalOption("UseManagementCompany"));
	
	Query.Text =
	"SELECT ALLOWED
	|	T.Ref AS Ref
	|FROM
	|	Catalog.Companies AS T
	|WHERE
	|	(T.Ref <> VALUE(Catalog.Companies.ManagementCompany)
	|		OR &UseManagementCompany)
	|	AND (T.Ref IN (&CompanyArray)
	|			OR &ByAllCompanies)
	|	AND NOT T.Ref IN (&ArrayOfExcludedOrganizations)";
	
	Companies = Query.Execute().Unload().UnloadColumn("Ref");
	
	Return Companies;
	
EndFunction

