// Procedure-handler for checking the state of the system "initial data for calculating the cost".
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure CheckingCorrectnessOfSourceDataForCalculatingCost(CheckParameters) Export
	
	CalculationPeriod = CheckParameters.AdditionalParameters.BeginOfPeriod;
	
	OrganizationsWithCostRegisteredRecords = CostCalculationAppliedAlgorithms.OrganizationsWithCostRegisteredRecords(
		CalculationPeriod,
		CheckParameters.AdditionalParameters.CompanyArray);
	
	// Checks are not performed before the calculation:
	// - at the preliminary closing of the month
	// - with cost accounting turned off
	// - in The Absence Of Registered Recorded at Cost in The Cur Period.
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing
	 Or Not CalculationOfCostCached.CostCalculationIsPossible(BegOfMonth(CalculationPeriod))
	 Or Not ValueIsFilled(OrganizationsWithCostRegisteredRecords) Then
