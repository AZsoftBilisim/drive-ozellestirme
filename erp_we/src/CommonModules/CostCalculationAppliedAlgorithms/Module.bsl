// Example of a call: Calculation of the highest cost of a particular algorithm.Execute the query with a custom text (Request, "C:TempQuery.txt ").The result.Upload()
//
// Returns:
//	Structure -
//
Function ExecuteQueryWithAnyText(DataSource, PathToRequestTextFile) Export
	
	BeginTime = CurrentUniversalDateInMilliseconds();
	
	File = New TextDocument;
	
	Result = New Structure;
	
	Try
		
		If TypeOf(DataSource) = Type("Query") Then
			Query = DataSource;
			Result.Insert("OldRequestText", Query.Text);
		Else
			Query = New Query;
			If TypeOf(DataSource) = Type("TempTablesManager") Then
				Query.TempTablesManager = DataSource;
			ElsIf TypeOf(DataSource) = Type("Structure") Then
				InitializeRequestProperties(Query, DataSource);
			EndIf;
		EndIf;
		
		File.Read(PathToRequestTextFile, TextEncoding.UTF8);
		
		Result.Insert("NewRequestText", File.GetText());
		Query.Text = Result.NewRequestText;
		
		Result.Insert("Result", Query.Execute());
		
	Except
		
		ErrorDescription = DetailErrorDescription(ErrorInfo());
		Result.Insert("ErrorDescription", ErrorDescription);
		
	EndTry;
	
	If Result.Property("OldRequestText") Then // a request was sent
		DataSource.Text = Result.OldRequestText;
	EndIf;
	
	Result.Insert("Time", (CurrentUniversalDateInMilliseconds() - BeginTime) / 1000);
	
	Return Result;
	
EndFunction


// Adds a column for numbering the lines of the parties.
//
// Parameters:
// 	Table - ValueTable -
// 	NameOfLineNumberField - String -
Procedure AddColumnToNumberBatchLines(Table, NameOfLineNumberField = "") Export
	
	If Not ValueIsFilled(NameOfLineNumberField) Then
		NameOfLineNumberField = DefaultColumnNameForNumbering();
	EndIf;
	
	If Table.Columns.Find(NameOfLineNumberField) = Undefined Then
		Table.Columns.Add(NameOfLineNumberField, New TypeDescription("Number", New NumberQualifiers(15)));
	EndIf;
	
EndProcedure

// Checks for changes in the table parts of the document.
// The tabular part of the object document is collapsed according to the sum / quantity details
// and checked against the tabular part of the document in the IB.
// If the table part of the document contains a date attribute, then its minimum value is determined in the changed rows.
// However, lines where the date is not filled in are not checked for changes.
// 
// Parameters:
//	DocumentObject - DocumentObject - document being checked
//	TabularSectionsDetails - Structure
//		Key-name of the table part
//		Value-Structure with mandatory keys
//			"Resources" - the string value of this key lists the total and quantitative details of the table part
//			" date " separated by commas-the string value of this key specifies the name of the details with the date (if there is no date, the value is not filled in).
//
// Returns:
// 	Structure - dates of changes in the section of tabular parts of the document:
//	Structure:
// * TotalMinimumPeriod - Date, Undefined -
// * TabularSectionName - Date, Undefined - The keys are the keys of the description of the table parts
//
Function PeriodsOfChangeTabularPartsOfDocument(DocumentObject, TabularSectionsDetails) Export
	
	Result					= New Structure;
	TotalMinimumPeriod		= Undefined;
	MetaDocument				= DocumentObject.Metadata();
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	Query.SetParameter("Ref", DocumentObject.Ref);
	
	#Region QueryTexts
	
	TTDownloadRequestTemplate = 
	"SELECT
	|	&TableFields
	|INTO TTTabularPart
	|FROM
	|	&TTTabularPart AS T
	|";
	
	DataSelectionQueryTemplate = 
	"SELECT DISTINCT
	|	""TTTabularPart"" AS TabularSectionName,
	|	&Date AS Date
	|FROM
	|	(SELECT
	|		TRUE AS Posted,
	|		&TableFields
	|	FROM
	|		TTTabularPart AS T
	|	WHERE
	|		&SelectingObjectData
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Ref.Posted AS Posted,
	|		&FieldsWithMinus
	|	FROM
	|		&DocumentTable AS T
	|	WHERE
	|		T.Ref = &Ref
	|		AND &SelectionOfInformationSecurityData
	|	) AS T
	|WHERE &Group
	|AND &FilterCriterion
	|";

	TemplateForDataSampleRequestIsEmptyTS = 
	"SELECT DISTINCT
	|	""TTTabularPart"" AS TabularSectionName,
	|	&Date AS Date
	|FROM
	|	&DocumentTable AS T
	|WHERE
	|	T.Ref = &Ref
	|	AND &SelectionOfInformationSecurityData
	|";

	ResultRequestTemplate = 
	"SELECT
	|	T.TabularSectionName AS TabularSectionName,
	|	MIN(T.Date) AS Date
	|FROM
	|	DataOfTableParts AS T
	|WHERE
	|	T.Date <> DATETIME(1,1,1,0,0,0)
	|GROUP BY
	|	T.TabularSectionName
	|";
	
	#EndRegion
	
	TextsOfRequestToDownloadTT = New Array;
	DataSelectionQueryTexts = New Array;
	
	For Each KeyAndValue In TabularSectionsDetails Do
		
		Result.Insert(KeyAndValue.Key, Undefined);
		
		RowsCount = DocumentObject[KeyAndValue.Key].Count();
		If RowsCount > 0 Then
			Query.SetParameter(KeyAndValue.Key, DocumentObject[KeyAndValue.Key].Unload());
		EndIf;
		
		// Let's prepare the texts of the request fragments.
		MeasurementString_    = "";
		LineResources	   = "";
		LineResourcesAmount = "";
		LineResourcesSelection = "";
		StructureResources = New Structure(?(ValueIsFilled(KeyAndValue.Value.Resources), KeyAndValue.Value.Resources, ""));
		StringDate 		 = ?(ValueIsFilled(KeyAndValue.Value.Date), "T." + KeyAndValue.Value.Date, "Undefined");
		
		For Each MetaAttribute In MetaDocument.TabularSections[KeyAndValue.Key].Attributes Do
			
			MetaTypes = MetaAttribute.Type.Types();
			
			If MetaTypes.Count() = 1
			  And (MetaTypes[0] = Type("UUID")
				 Or MetaTypes[0] = Type("String")) Then
				Continue;
			EndIf;
			
			If StructureResources.Property(MetaAttribute.Name) Then
				LineResources = LineResources + ?(LineResources = "", "", ",
					|	") + "T." + MetaAttribute.Name;
				LineResourcesAmount = LineResourcesAmount + ?(LineResourcesAmount = "", "", ",
					|	") + "SUM(T." + MetaAttribute.Name + ") AS " + MetaAttribute.Name;
				LineResourcesSelection = LineResourcesSelection + ?(LineResourcesSelection = "", "	", "
					|	OR ") + "SUM(T." + MetaAttribute.Name + ") <> 0";
			Else
				MeasurementString_ = MeasurementString_ + ?(MeasurementString_ = "", "", ",
					|") + "	T." + MetaAttribute.Name;
			EndIf;
			
		EndDo;
		
		FieldString = MeasurementString_ + ?(MeasurementString_ = "" Or LineResources = "", "", ",
			|	") + LineResources;
		FieldStringWithMinus = MeasurementString_ + ?(MeasurementString_ = "" Or LineResources = "", "", ",
			|	") + StrReplace(LineResources, "T.", "-T.");
		RowTableOfDocument = "Document." + MetaDocument.Name + "." + KeyAndValue.Key;
		
		StringOfDimensionField = ?(MeasurementString_ = "", "", "GROUP BY" + Chars.LF + "T.Posted," + Chars.LF + MeasurementString_);
		
		TextDataSelection = "";
		If KeyAndValue.Value.Property("Filter") Then
			
			For Each CurrFilter In  KeyAndValue.Value.Filter Do
				
				LeftValue				= CurrFilter.Key;
				TypeOfRequestComparison	= CurrFilter.Value.ComparisonType;
				RightValue 			= CurrFilter.Value.RightValue;
				
				TextDataSelection =
					TextDataSelection
					+ ?(IsBlankString(TextDataSelection), "", " And ")
					+ "(" + LeftValue + ") " + TypeOfRequestComparison + " (" + RightValue + ")";
				
			EndDo;
			
		EndIf;
		
		// Let's form the text of the request and execute the request.
		If RowsCount > 0 Then

			QueryText = TTDownloadRequestTemplate;
			QueryText = StrReplace(QueryText, "&TableFields", 	 FieldString);
			QueryText = StrReplace(QueryText, "TTTabularPart", KeyAndValue.Key);
			
			TextsOfRequestToDownloadTT.Add(QueryText);

			QueryText = DataSelectionQueryTemplate;
			
		Else
			// A temp table is not needed for the empty table part
			QueryText = TemplateForDataSampleRequestIsEmptyTS;
		EndIf;
		
		QueryText = StrReplace(QueryText, "&Date", 			  StringDate);
		QueryText = StrReplace(QueryText, "TTTabularPart",  KeyAndValue.Key);
		QueryText = StrReplace(QueryText, "&TableFields", 	  FieldString);
		QueryText = StrReplace(QueryText, "&FieldsWithMinus", 	  FieldStringWithMinus);
		QueryText = StrReplace(QueryText, "&DocumentTable", RowTableOfDocument);
		QueryText = StrReplace(QueryText, "WHERE &Group",  StringOfDimensionField);
		QueryText = StrReplace(QueryText, "AND &FilterCriterion",  ?(LineResourcesSelection = "", "", "HAVING" + Chars.LF + LineResourcesSelection));
		
		If ValueIsFilled(TextDataSelection) Then
			QueryText = StrReplace(QueryText, "&SelectingObjectData",	TextDataSelection);
			QueryText = StrReplace(QueryText, "&SelectionOfInformationSecurityData",		TextDataSelection);
		Else
			QueryText = StrReplace(QueryText, "&SelectingObjectData",	"TRUE");
			QueryText = StrReplace(QueryText, "&SelectionOfInformationSecurityData",		"TRUE");
		EndIf;
		
		DataSelectionQueryTexts.Add(QueryText);
		
	EndDo;
	
	// We get the final Query Text and execute the query
	If TextsOfRequestToDownloadTT.Count() = 0 Then
		Query.Text = "";
	Else
		Query.Text = StrConcat(TextsOfRequestToDownloadTT, Common.QueryBatchSeparator())
			+ Common.QueryBatchSeparator();
	EndIf;

	Query.Text = Query.Text
		+ StrReplace(
			ResultRequestTemplate,
			"DataOfTableParts",
			"(" + StrConcat(DataSelectionQueryTexts, Chars.LF + "UNION ALL" + Chars.LF) + ")");
	
	SetPrivilegedMode(True);
	Selection = Query.Execute().Select();
	SetPrivilegedMode(False);
	
	While Selection.Next() Do
		
		DateTS = Selection.Date; //Date
		Result.Insert(Selection.TabularSectionName, DateTS);
		
		If ValueIsFilled(TotalMinimumPeriod) Then
			TotalMinimumPeriod = Min(TotalMinimumPeriod, DateTS);
		Else
			TotalMinimumPeriod = DateTS;
		EndIf;
		
	EndDo;
	
	Result.Insert("TotalMinimumPeriod", TotalMinimumPeriod);
	
	Return Result;
	
EndFunction

// This method blocks entries in the task register for the number of tasks in the range of task numbers: 0 ... Nominalinterest.
//
// Parameters:
//	TaskNumberBeforeCalculation - Number - Upper limit of the blocking range.
//	Companies - Array, CatalogRef.Companies, Undefined - organizations to block
//
Procedure BlockTaskRegister(TaskNumberBeforeCalculation, Companies = Undefined) Export
	
	Block = New DataLock;
	
	LockItem = Block.Add("InformationRegister.JobsForCalculatingCost");
	LockItem.SetValue("JobNumber", New Range(Undefined, TaskNumberBeforeCalculation));
	
	LockSource = New ValueTable;
	LockSource.Columns.Add("Organization", New TypeDescription("CatalogRef.Companies"));
	
	For Each CurrRow In TMCommonUseClientServer.Array(Companies) Do
		If ValueIsFilled(CurrRow) Then
			LockString = LockSource.Add();
			LockString.Organization = CurrRow;
		EndIf;
	EndDo;
	
	// If the table is empty, then the lock is placed on all organizations.
	If ValueIsFilled(LockSource) Then
		LockItem.DataSource = LockSource;
		LockItem.UseFromDataSource("Organization", "Organization");
	EndIf;
	
	LockItem.Mode = DataLockMode.Exclusive;
	
	Block.Lock();
	
EndProcedure

// Saves the records of the task register for cost calculation to the temporary table Manager.
//
// Parameters:
//	TaskNumberBeforeCalculation - Number - Records are selected for which the task number <= Account tasknumber.
//	OrganizationsToCalculate_ - Array - List of organizations for which tasks are saved.
//
// Returns:
//	TempTablesManager - It contains the TUE "Initial tasks".
//
Function GenerateTTTasksBeforeCalculation(TaskNumberBeforeCalculation, OrganizationsToCalculate_) Export
	
	Query = New Query("
	|SELECT
	|	Jobs.Month,
	|	Jobs.JobNumber,
	|	Jobs.Organization,
	|	Jobs.Document
	|INTO InitialTasks
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS Jobs
	|WHERE
	|	Jobs.JobNumber <= &JobNumber
	|	AND Jobs.Organization IN (&CompanyArray)
	|");
	
	TemporaryTable = New TempTablesManager;
	
	Query.SetParameter("JobNumber", TaskNumberBeforeCalculation);
	Query.SetParameter("CompanyArray", TMCommonUseClientServer.Array(OrganizationsToCalculate_));
	Query.TempTablesManager = TemporaryTable;
	
	Query.Execute();
	
	Return TemporaryTable;
	
EndFunction

// Returns the number of document movements in the specified case.
//
// Returns:
//	Number -
//
Function NumberOfRegisteredRecordsOfDocumentByCase(Recorders, FullRegisterName) Export
	
	Query = New Query;
	Query.SetParameter("Recorders", TMCommonUseClientServer.Array(Recorders));
	
	Query.Text =
	"SELECT
	|	COUNT(*) AS Count
	|FROM
	|	NameOfMainRegisterTable AS T
	|WHERE
	|	T.Recorder IN (&Recorders)";
	
	Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", FullRegisterName);
	
	Selection = Query.Execute().Select();
	Selection.Next();
	
	Return Selection.Count;
	
EndFunction

Function CombineArrays(Array1, Array2)
	
	CombinedArray = New Array;
	
	For Each ArrayElement In Array1 Do
	
		If CombinedArray.Find(ArrayElement) = Undefined Then
			CombinedArray.Add(ArrayElement);
		EndIf; 
	
	EndDo;
	
	For Each ArrayElement In Array2 Do
	
		If CombinedArray.Find(ArrayElement) = Undefined Then
			CombinedArray.Add(ArrayElement);
		EndIf; 
	
	EndDo;
	
	Return CombinedArray;
	
EndFunction

