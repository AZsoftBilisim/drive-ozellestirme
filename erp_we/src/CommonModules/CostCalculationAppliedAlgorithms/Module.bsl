			|it = 'Non è stata trovata nella cache una registrazione dei dati della contabilità a lotti:
			|Identificatore della contabilità: %1
			|Tipo dei dati: %2
			|Numero della porzione: %3';
			|pl = 'Nie wyszukano zapis w pamięci podręcznej danych ewidencji partii:
			|Identyfikator obliczenia: %1
			|Typ danych: %2
			|Numer porcji: %3';
			|tr = 'Lot muhasebesi verileri için önbellek kaydı bulunamadı:
			|Hesaplama tanımlayıcısı: %1
			|Veri tipi: %2
			|Bölüm numarası: %3'", Common.DefaultLanguageCode()),
			TrimAll(CalculationID),
			TrimAll(DataType),
			TrimAll(DataPortionNumber));
		
		If ValueIsFilled(CalculationParameters) And Not ThisIsBackgroundBatchCalculation(CalculationParameters) Then
			
			CostCalculationProtocol.FixCalculationError(
