// Restricts the use of DCS fields    
//
// Parameters:
//    FieldNamesArray - Array of String - array of fields for which usage should be restricted
//    DataCompositionSchema - DataCompositionSchema - The data layout diagram for which fields you want to enter a usage restriction
//    SettingsComposer - DataCompositionSettingsComposer - The settings Composer that needs to have its settings updated after usage restrictions
//    DataSetName - String - The name of the dataset in the data layout schema
//    AllDataSets - Boolean - If you need to find and restrict fields in all datasets, including calculated fields, then set the parameter to True
//
Procedure RestrictUseOfDCSFields(FieldNamesArray, DataCompositionSchema, SettingsComposer,
	DataSetName = "", AllDataSets = False) Export
	
	If DataSetName = "" And Not AllDataSets Then
		Return;
	EndIf;
	
	If AllDataSets Then
		For Each DataSet In DataCompositionSchema.DataSets Do
			SetUsageLimitForDataSet(DataSet.Fields, FieldNamesArray);
		EndDo;
		SetUsageLimitForDataSet(DataCompositionSchema.CalculatedFields, FieldNamesArray);
	Else
		DataSet = DataCompositionSchema.DataSets.Find(DataSetName);
		If DataSet = Undefined Then
			Return;
		EndIf;		
		DatasetFields = DataSet.Fields;
		SetUsageLimitForDataSet(DatasetFields, FieldNamesArray);
	EndIf;
	
	SettingsComposer.Initialize(New DataCompositionAvailableSettingsSource(DataCompositionSchema));
	
EndProcedure

Procedure SetUsageLimitForDataSet(DatasetFields, FieldNamesArray)
	For Each FieldName In FieldNamesArray Do
		DataSetField = DatasetFields.Find(FieldName);
		If DataSetField = Undefined Then
			Continue;
		EndIf;
		DataSetField.UseRestriction.Group = True;
		DataSetField.UseRestriction.Field = True;
		DataSetField.UseRestriction.Order = True;
		DataSetField.UseRestriction.Condition = True;
	EndDo;
EndProcedure

// Deletes a field from report dimensions.
//
// Parameters:
//  ReportSettings - DataCompositionSettingsComposer, DataCompositionSettings, DataCompositionGroup, DataCompositionTableGroup -
//  SearchValues - Array of String - names of items to be deleted.
Procedure DeleteUnusedReportDimensions(ReportSettings, SearchValues) Export

	If Not ValueIsFilled(SearchValues) Then
		Return;
	EndIf;
	
	ItemArray = New Array; // Array of DataCompositionSelectedField -
	
	For Each ReportStructureElement In ReportSettings.Structure Do
		If TypeOf(ReportStructureElement) = Type("DataCompositionGroup") Then
			FindSelectedFieldRecursively(ReportStructureElement, ItemArray, SearchValues);
		EndIf;
	EndDo;

	For Each ReportStructureElement In ItemArray Do
		ReportStructureElement.Parent.Structure.Delete(ReportStructureElement);
	EndDo;
	
EndProcedure

Procedure FindSelectedFieldRecursively(ReportStructureElement, ItemArray, SearchValues)

	ValueFound2 = False;
	
	For Each Item In ReportStructureElement.GroupFields.Items Do
		
		If TypeOf(Item) = Type("DataCompositionGroupField") Then

			For Each SearchValue In SearchValues Do
				If Lower(Item.Field) = Lower(SearchValue) Then
					ItemArray.Add(ReportStructureElement);
					ValueFound2 = True;
					Break;
				EndIf;
			EndDo;
		
		EndIf;
		
	EndDo;

	If Not ValueFound2 Then

		For Each NestedElementOfReportStructure In ReportStructureElement.Structure Do
			If TypeOf(NestedElementOfReportStructure) = Type("DataCompositionGroup") Then
				FindSelectedFieldRecursively(NestedElementOfReportStructure, ItemArray, SearchValues);
			EndIf;
		EndDo;
			
	EndIf;
	
EndProcedure

