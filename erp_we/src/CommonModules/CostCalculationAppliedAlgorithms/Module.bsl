// Procedure-handler for checking the State of the system "Check the number of hands and the value of sales and the value of goods".
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure ReconciliationOfAmountOfGRPRevenueAndCostOfGoodsSoldAndInventoryCosts(CheckParameters) Export
		
	QueryText = "SELECT
	|	VZ.Organization AS Organization,
	|	VZ.Recorder AS Recorder,
	|	VZ.Products AS Products,
	|	VZ.Characteristic AS Characteristic,
	|	VZ.Series AS Series,
	|	VZ.FinRecordID AS FinRecordID,
	|	VZ.BusinessOperation AS BusinessOperation,
	|	SUM(VZ.Count) AS CountDiscrepancies
	|INTO TTDiscrepanciesInQuantity
	|FROM
	|	(SELECT
	|		T.AccountingDimensionByPartners.Organization AS Organization,
	|		T.Recorder AS Recorder,
	|		CatInventoryLocationAttributeKeys.Products AS Products,
	|		CatInventoryLocationAttributeKeys.Characteristic AS Characteristic,
	|		CatInventoryLocationAttributeKeys.Series AS Series,
	|		T.FinRecordID AS FinRecordID,
	|		T.BusinessOperation AS BusinessOperation,
	// The amount of this type of return, in movements, is negative
	|		T.Count AS Count
	|	FROM
	|		AccumulationRegister.RevenueAndCOGS AS T
	|		INNER JOIN Catalog.DimensionKeysOfAccountingByPartners AS Analysts
	|		ON T.AccountingDimensionByPartners = Analysts.Ref
	|		INNER JOIN Catalog.InventoryLocationAttributeKeys AS CatInventoryLocationAttributeKeys
	|		ON CatInventoryLocationAttributeKeys.Ref = T.ItemsLocationAttributes
	|	WHERE
	|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND Analysts.Organization IN(&CompanyArray)
	|		AND T.Recorder REFS Document.ReturnOfGoodsFromCustomer 
	|		AND T.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods)
	// The service is not displayed in the cost price, so we exclude it from the revenue and cost of sales 
	|		AND T.ItemsLocationAttributes.Products.ItemsType <> VALUE(Enum.ItemsTypes.OperationService)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Organization,
	|		T.Recorder,
	|		CatProducts.Ref AS Products,
	|		ISNULL(CorKeysForItemAccountingAnalytics.Characteristic, CatInventoryLocationAttributeKeys.Characteristic) AS Characteristic,
	|		ISNULL(CorKeysForItemAccountingAnalytics.Series, CatInventoryLocationAttributeKeys.Series) AS Series,
	|		T.FinRecordID,
	|		T.BusinessOperation,
	|		T.Count
	|	FROM
	|		AccumulationRegister.InventoryCost AS T
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS CatInventoryLocationAttributeKeys
	|		ON (CatInventoryLocationAttributeKeys.Ref = T.ItemsLocationAttributes)
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS CorKeysForItemAccountingAnalytics
	|		ON (CorKeysForItemAccountingAnalytics.Ref = T.CorItemsLocationAttributes)
	|		LEFT JOIN Catalog.Products AS CatProducts
	|		ON (ISNULL(CorKeysForItemAccountingAnalytics.Products, CatInventoryLocationAttributeKeys.Products) = CatProducts.Ref)
	|	WHERE
	|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND T.Organization IN(&CompanyArray)
	|		AND T.Recorder REFS Document.ReturnOfGoodsFromCustomer 
	// Multi-turn packaging is not reflected in revenue if the return of multi-turn packaging is reflected, therefore we exclude it from the cost of goods
	// The return of a multi-turn container has an economic operation of "Reversed packaging" or "Return of packaging from a customer of previous periods", therefore the condition below excludes it
	|		AND T.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods)
	|	) AS VZ
	|
	|GROUP BY
	|	VZ.Organization,
	|	VZ.Recorder,
	|	VZ.Products,
	|	VZ.Characteristic,
	|	VZ.Series,
	|	VZ.FinRecordID,
	|	VZ.BusinessOperation
	|	
	|HAVING SUM(VZ.Count) <> 0";

	FieldList = New ValueList;
	FieldList.Add("Organization", 				NStr("vi = 'Doanh nghiệp';
														|ru = 'Организация';
														|en = 'Company'; fa = 'Company';
														|it = 'Организация';
														|pl = 'Organizacja';
														|tr = 'İş yeri'", Common.DefaultLanguageCode()));
	FieldList.Add("Recorder",					NStr("vi = 'Nguồn ghi';
														|ru = 'Регистратор';
														|en = 'Recorder'; fa = 'ثبت‌کننده';
														|it = 'Регистратор';
														|pl = 'Rejestrator';
														|tr = 'Kaydedici'", Common.DefaultLanguageCode()));	
	
	FieldList.Add("Products",				NStr("vi = 'Mặt hàng';
													|ru = 'Номенклатура';
													|en = 'Item'; fa = 'قلم';
													|it = 'Номенклатура';
													|pl = 'Produkt';
													|tr = 'Öğe'", Common.DefaultLanguageCode()));
	FieldList.Add("Characteristic",				NStr("vi = 'Đặc tính';
														|ru = 'Характеристика';
														|en = 'Variant'; fa = 'گونه';
														|it = 'Характеристика';
														|pl = 'Charakterystyka';
														|tr = 'Varyant'", Common.DefaultLanguageCode()));
	FieldList.Add("Series",						NStr("vi = 'Seri';
														|ru = 'Серия';
														|en = 'Batch'; fa = 'بچ';
														|it = 'Серия';
														|pl = 'Seria';
														|tr = 'Parti'", Common.DefaultLanguageCode()));
	
	FieldList.Add("CountDiscrepancies",		NStr("vi = 'Số lượng chênh lệch';
													|ru = 'Количество расхождения';
													|en = 'Discrepancy number'; fa = 'Discrepancy number';
													|it = 'Количество расхождения';
													|pl = 'Discrepancy number';
													|tr = 'Tutarsızlık miktarı'", Common.DefaultLanguageCode()));

	RegistrationParameters = MonthEndTransactionsServer.InitializeRegistrationAndVerificationParameters(
		"TTDiscrepanciesInQuantity",
		NStr("vi = 'Đã tìm thấy chênh lệch theo số lượng, giữa các biểu ghi ""Doanh thu và giá vốn hàng bán"" và ""Giá vốn hàng bán"", theo doanh nghiệp ""%1"" vào cuối kỳ %2';
			|ru = 'Обнаружены расхождения по количеству, между регистрами ""Выручка и себестоимость продаж"" и ""Себестоимость товаров"", по организации ""%1"" на конец периода %2';
			|en = 'Discrepancies in quantity between the ""Revenue and COGS"" and ""Inventory cost"" registers for the ""%1"" company at the end of the %2 period are found'; fa = 'Discrepancies in quantity between the ""Revenue and COGS"" and ""Inventory cost"" registers for the ""%1"" company at the end of the %2 period are found';
			|it = 'Обнаружены расхождения по количеству, между регистрами ""Выручка и себестоимость продаж"" и ""Себестоимость товаров"", по организации ""%1"" на конец периода %2';
			|pl = 'Discrepancies in quantity between the ""Revenue and COGS"" and ""Inventory cost"" registers for the ""%1"" company at the end of the %2 period are found';
			|tr = '%2 döneminin sonunda ""%1"" iş yeri için ""Satış geliri ve maliyeti"" ile ""Stok maliyeti"" kayıtları arasında miktar olarak tutarsızlıklar tespit edildi'",
			Common.DefaultLanguageCode()),
		FieldList,
		,
		Metadata.AccumulationRegisters.RevenueAndCOGS.FullName());

	AdditionalRequestParameters_ = New Structure;
	AdditionalRequestParameters_.Insert("TypesOfDataConversionRecords", TypesOfDataConversionRecords());
	
