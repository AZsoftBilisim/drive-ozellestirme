Function TableForDistributionOfLots(CalculationParameters, TextDescriptionOfData, AddNumberingColumn = True) Export
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text = TextDescriptionOfData;
	
	Table = Query.Execute().Unload().CopyColumns(); // create an empty table
	
	// Let's remove the Null type from the description of column types.
	For Each CurrentColumn In Table.CopyColumns().Columns Do
		
		If CurrentColumn.ValueType.ContainsType(Type("Null")) Then
			
			Table.Columns.Delete(CurrentColumn.Name); // delete the column
			
			Table.Columns.Add(
				CurrentColumn.Name,
				New TypeDescription(CurrentColumn.ValueType,, "Null"),
				CurrentColumn.Title,
				CurrentColumn.Width); // let's add a similar one without the Null value type
			
		EndIf;
		
	EndDo;
	
	If AddNumberingColumn Then
		AddColumnForLineNumbering(Table);
	EndIf;
	
	Return Table;
	
EndFunction

Procedure CompleteBatchDistribution(CalculationParameters, StageEnd = True) Export
	
	TemporaryTableNames = "Data, Sources, Destinations, DescriptionOfSubgraphs, NodeLinkStatistics, "
		+ CalculationParameters.DistributionOfParties.RegisterRecordsDetails.TemporaryTablesOfCurStage;
	
	If StageEnd Then
		CacheGeneratedRegisteredRecords(CalculationParameters);
	Else
		CacheDistributedBatches(CalculationParameters);
	EndIf;
	
	If Not TemporaryTableExists(CalculationParameters, "Sources") Then
		
		// This is the stage of the broadcast of the parties
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			TemporaryTableSize(CalculationParameters, "Data"));
		
	EndIf;
	
	DestroyTemporaryTables(CalculationParameters, TemporaryTableNames);
	
	CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "CompleteBatchDistribution");
	
EndProcedure

// Changes the text of the data description request - the data will be selected not in the temporary table, but in the query result.
// 
// Parameters:
//  QueryText - String - Query text
// 
// Returns:
//  String - modified text of the data description request
//
Function PrepareDataDescriptionRequest(QueryText) Export
	Return ChangeDataDescriptionRequestReceiver(QueryText);
EndFunction

// Modifies the data description request receiver table.
// 
// Parameters:
//  QueryText - String - Query text
//  DestinationName - String - Name of the receiver table
// 
// Returns:
//  String - modified text of the data description request
//
Function ChangeDataDescriptionRequestReceiver(QueryText, DestinationName = "") Export
	
	EmptyReceiverName = NameOfEmptyDataDescriptionRequestReceiver();
	
	If StrFind(QueryText, EmptyReceiverName) > 0 Then
		SourceName = EmptyReceiverName;
	Else
		SourceName = "INTO Data";
	EndIf;
	
	If Not ValueIsFilled(DestinationName) Then
		DestinationName = EmptyReceiverName;
	Else
		DestinationName = "INTO " + DestinationName;
	EndIf;
	
	Return StrReplace(QueryText, SourceName, DestinationName);
	
EndFunction

// Returns a string that is substituted for the table name to contain the query result. 
// 
// Returns:
//  String -
//
Function NameOfEmptyDataDescriptionRequestReceiver() Export
	Return "//" + "ToTemporaryTable";
EndFunction

