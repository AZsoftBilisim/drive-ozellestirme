// Checking whether the "append Distribution" setting is enabled. expenses for retired goods".
// Called in the procedure for determining the status of the batch and cost calculation stage.
// If there are additional expenses in the database that can be allocated to retired items, we recommend enabling this setting.
// Otherwise, as a result of the calculation, errors of the form ""non-zero balances were Found in the amounts with zero quantity in the cost register""may be diagnosed.
//
// Returns:
//	Boolean -
//
Function CheckWhetherYouNeedToEnableDistributionOfAdditionalExpensesForDiscardedItemsSetting(CalculationParameters) Export
	
	If Not CalculationOfCostCached.BatchAccountingVersion22(BegOfMonth(CalculationParameters.RegistrationPeriod))
	 Or Constants.AllocationOfAdditionalExpensesByDisposedGoods.Get() Then
		Return False; // the check is only needed when the setting is EMPTY and disabled
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	
	Query.SetParameter("BeginOfPeriod", 		BegOfMonth(CalculationParameters.RegistrationPeriod));
	Query.SetParameter("EndOfPeriod", 		EndOfMonth(CalculationParameters.RegistrationPeriod));
	Query.SetParameter("CompanyArray",  CalculationParameters.CompanyArray);
	
	Query.Text =
	"SELECT
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.AccountingSection AS AccountingSection,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.Organization AS Organization,
	|	T.Lot AS Lot,
	|	T.LotVendorAttributes AS LotVendorAttributes,
	|	T.FinancialAccountingDimension AS FinancialAccountingDimension,
	|	T.VATActivityType AS VATActivityType
	|INTO ExpensesForWriteOffOnDisposalOfGoods
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN(&CompanyArray)
	|	AND T.RecordType = VALUE(AccumulationRecordType.Receipt)
	|	AND T.AccountingSection IN (VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock), VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors))
	|	AND T.EntryType IN (VALUE(Enum.LotRecordTypes.CostVariance), VALUE(Enum.LotRecordTypes.AllocationByDisposedGoods), VALUE(Enum.LotRecordTypes.DebitNoteForPreviousPeriod))
	|
	|GROUP BY
	|	T.ItemsLocationAttributes,
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Organization,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType
	|
	|HAVING
	|	SUM(T.Count) = 0 AND
	|	(SUM(T.AddExpensesForGoods) <> 0
	|		OR SUM(T.AdditionalExpensesExcludingVAT) <> 0
	|		OR SUM(T.AddExpensesLocal) <> 0
	|		OR SUM(T.AddExpensesMan) <> 0
	|		OR SUM(T.VATLocal) <> 0
	|		OR SUM(T.VATManag) <> 0
	|		OR SUM(T.PermanentDifference) <> 0
	|		OR SUM(T.CostTD) <> 0
	|		OR SUM(T.CostOfPersonalIncomeTax) <> 0
	|		)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	T.AccountingSection AS AccountingSection,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.Organization AS Organization,
	|	T.Lot AS Lot,
	|	T.LotVendorAttributes AS LotVendorAttributes,
	|	T.FinancialAccountingDimension AS FinancialAccountingDimension,
	|	T.VATActivityType AS VATActivityType,
	|	MAX(T.IsBalance) AS IsBalance,
	|	MAX(T.ThereAreRevolutions) AS ThereAreRevolutions
	|FROM
	|	(SELECT
	|		T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|		T.AccountingSection AS AccountingSection,
	|		T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|		T.Organization AS Organization,
	|		T.Lot AS Lot,
	|		T.LotVendorAttributes AS LotVendorAttributes,
	|		T.FinancialAccountingDimension AS FinancialAccountingDimension,
	|		T.VATActivityType AS VATActivityType,
	|		CASE
	|			WHEN T.CountBalance <> 0
	|				THEN TRUE
	|			ELSE FALSE
	|		END AS IsBalance,
	|		FALSE AS ThereAreRevolutions
	|	FROM
	|		AccumulationRegister.InventoryCost.Balance(&BeginOfPeriod, Organization IN (&CompanyArray)) AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.ItemsLocationAttributes,
	|		T.AccountingSection,
	|		T.InventoryOwnerAttribute,
	|		T.Organization,
	|		T.Lot,
	|		T.LotVendorAttributes,
	|		T.FinancialAccountingDimension,
	|		T.VATActivityType,
	|		FALSE,
	|		TRUE
	|	FROM
	|		ExpensesForWriteOffOnDisposalOfGoods AS T) AS T
	|
	|GROUP BY
	|	T.Lot,
	|	T.VATActivityType,
	|	T.InventoryOwnerAttribute,
	|	T.Organization,
	|	T.LotVendorAttributes,
	|	T.AccountingSection,
	|	T.FinancialAccountingDimension,
	|	T.ItemsLocationAttributes
	|
	|HAVING
	|	MAX(T.IsBalance) = FALSE AND
	|	MAX(T.ThereAreRevolutions) = TRUE";
	
	Result = Query.Execute();
	
	Return Not Result.IsEmpty(); // it should be turned on if there are no initial balances in terms of quantity and there are revolutions without a quantity to write off
	
EndFunction

// Procedure-handler for checking the state of the system "initial data for calculating the cost".
//
// Parameters:
// CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure VerificationOfComplianceOfOperationalAccountingAndCost(CheckParameters) Export
	
	ParameterValues = CalculationOfCostCached.ValuesOfTechnologicalParameters();
	If Not ParameterValues.VerifyComplianceOfOperationalAccountingAndCost Then
		Return;
	EndIf;
	
	QueryText =
	"SELECT
	|	T.Organization AS Organization,
	|	T.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	SUM(T.QuantityCostPrice) AS QuantityCostPrice,
	|	SUM(T.OperationalQuantity) AS OperationalQuantity
	|INTO TTDiscrepanciesPreliminary
	|FROM
	|	(
	// Inventory cost
	|	SELECT
	|		T.Organization					AS Organization,
	|		T.ItemsLocationAttributes	AS ItemsLocationAttributes,
	|		T.CountBalance				AS QuantityCostPrice,
	|		0								AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.InventoryCost.Balance(
	|			&BorderEndOfPeriod,
	|			&CostCalculationIsPossible
	|			AND &BatchAccountingVersion22
	|			AND Organization IN (&CompanyArray)
	|			AND NOT AccountingSection IN (
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress),
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit),
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitReceivedByCommissionAgent),
	|				VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransitTransferredToCommissionAgent))
	|			AND ItemsLocationAttributes.Products.ItemsType IN (
	|				VALUE(Enum.ItemsTypes.OwnGoods),
	|				VALUE(Enum.ItemsTypes.ReusablePackage))
				// We exclude goods accepted for commission that have been redeemed.
	|			AND NOT (AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
	|				AND ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner))
	|			AND NOT VALUETYPE(Lot) IN (
	|										TYPE(Catalog.ProductionLots))
	|		) AS T
	|	
	|	UNION ALL
	|	
	// Products of organizations
	|	SELECT
	|		T.Organization		AS Organization,
	|		CASE
	|			WHEN &KeepRecordsOfInventoryCostByAssignments
	|				THEN T.ItemsLocationAttributes
	|			ELSE AnalyticsWithoutAssignment.DimensionKey
	|		END				AS ItemsLocationAttributes,
	|		0					AS QuantityCostPrice,
	|		T.CountBalance	AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.CompanyGoods.Balance(
	|			&BorderEndOfPeriod,
	|			&CostCalculationIsPossible
	|			AND &BatchAccountingVersion22
	|			AND Organization IN (&CompanyArray)
	|		) AS T
	|	
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
	|		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
	|		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
	|		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
	|		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	|	
	|	UNION ALL
	|	
	// Materials in the production
	|	SELECT
	|		T.Organization		AS Organization,
	|		CASE
	|			WHEN &KeepRecordsOfInventoryCostByAssignments
	|				THEN Dimension.DimensionKey
	|			ELSE AnalyticsWithoutAssignment.DimensionKey
	|		END				AS ItemsLocationAttributes,
	|		0					AS QuantityCostPrice,
	|		T.CountBalance	AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.MaterialsAndWorksInProduction.Balance(
	|			&BorderEndOfPeriod,
	|			&CostCalculationIsPossible
	|			AND &BatchAccountingVersion22
	|			AND Products.ItemsType IN (
	|				VALUE(Enum.ItemsTypes.OwnGoods),
	|				VALUE(Enum.ItemsTypes.ReusablePackage))
	|			AND Organization IN (&CompanyArray)
	|		) AS T
	|		
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS Dimension
	|		ON Dimension.Products = T.Products
	|		AND Dimension.Characteristic = T.Characteristic
	|		AND Dimension.StorageLocation = T.Department
	|		AND Dimension.Series = T.Series
	|		AND Dimension.Purpose = T.Purpose
	|		AND Dimension.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|	
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsWithoutAssignment.Products = Dimension.Products
	|		AND AnalyticsWithoutAssignment.Characteristic = Dimension.Characteristic
	|		AND AnalyticsWithoutAssignment.StorageLocation = Dimension.StorageLocation
	|		AND AnalyticsWithoutAssignment.Series = Dimension.Series
	|		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsWithoutAssignment.ProductCostElement = Dimension.ProductCostElement
	|	
	|	UNION ALL
	|	
	// Products of organizations to be transferred
	|	SELECT
	|		T.SellerInventoryOwnerAttribute.Organization	AS Organization,
	|		CASE
	|			WHEN &KeepRecordsOfInventoryCostByAssignments
	|				THEN T.ItemsLocationAttributes
	|			ELSE AnalyticsWithoutAssignment.DimensionKey
	|		END								AS ItemsLocationAttributes,
	|		0									AS QuantityCostPrice,
	|		T.CountBalance					AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.CompanyGoodsForTransfer.Balance(
	|			&BorderEndOfPeriod,
	|			&CostCalculationIsPossible
	|			AND &BatchAccountingVersion22
	|			AND SellerInventoryOwnerAttribute.Organization IN (&CompanyArray)
	|		) AS T
	|	
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
	|		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
	|		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
	|		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
	|		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	|
	|	
	|	UNION ALL
	|	
	// The goods transferred to the Commission
	|	SELECT
	|		T.InventoryOwnerAttribute.Organization	AS Organization,
	|		CASE
	|			WHEN &KeepRecordsOfInventoryCostByAssignments
	|				THEN T.ItemsLocationAttributes
	|			ELSE AnalyticsWithoutAssignment.DimensionKey
	|		END						AS ItemsLocationAttributes,
	|		0							AS QuantityCostPrice,
	|		T.CountBalance			AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.GoodsTransferredToCommissionAgent.Balance(
	|			&BorderEndOfPeriod,
	|			&CostCalculationIsPossible
	|			AND &BatchAccountingVersion22
	|			AND InventoryOwnerAttribute.Organization IN (&CompanyArray)
	|		) AS T
	|	
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
	|		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
	|		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
	|		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
	|		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	|	
	|	UNION ALL
	|	
	// Goods for customs Declaration processing
	|	SELECT
	|		T.Organization		AS Organization,
	|		CASE
	|			WHEN &KeepRecordsOfInventoryCostByAssignments
	|				THEN T.ItemsLocationAttributes
	|			ELSE AnalyticsWithoutAssignment.DimensionKey
	|		END				AS ItemsLocationAttributes,
	|		0					AS QuantityCostPrice,
	|		T.CountBalance	AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.GoodsForRegistrationOfImportDocuments.Balance(
	|			&BorderEndOfPeriod,
	|			&CostCalculationIsPossible
	|			AND &BatchAccountingVersion22
	|			AND Organization IN (&CompanyArray)
	|			AND ImportDocumentType = &ImportDocumentType
	|		) AS T
	|	
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
	|		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
	|		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
	|		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
	|		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	|	
	|	UNION ALL
	|	
	// We exclude movements from the cost price performed offline
	|	SELECT
	|		T.Organization					AS Organization,
	|		T.ItemsLocationAttributes	AS ItemsLocationAttributes,
	|		T.Count					AS QuantityCostPrice,
	|		0								AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.InventoryCost AS T
	|	WHERE
	|	&CostCalculationIsPossible
	|		AND &BatchAccountingVersion22
	|		AND T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND T.RecordType = VALUE(AccumulationRecordType.Expense)
	|		AND NOT T.Count = 0
	|		AND VALUETYPE(T.Recorder) IN (
	|			TYPE(Document.ProductionCostAllocation))
	|		AND T.Organization IN (&CompanyArray)
	|		AND T.ItemsLocationAttributes.Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods),
	|																	VALUE(Enum.ItemsTypes.ReusablePackage))
	|		AND (VALUETYPE(T.CorLot) IN (
	|			TYPE(Catalog.ProductionLots))
	|			)
	|	
	|	UNION ALL
	|	
	// We exclude movements from the goods of organizations performed offline
	|	SELECT
	|		T.Organization					AS Organization,
	|		CASE
	|			WHEN &KeepRecordsOfInventoryCostByAssignments
	|				THEN T.ItemsLocationAttributes
	|			ELSE AnalyticsWithoutAssignment.DimensionKey
	|		END				AS ItemsLocationAttributes,
	|		0								AS QuantityCostPrice,
	|		T.Count					AS OperationalQuantity
	|	FROM
	|		AccumulationRegister.CompanyGoods AS T
	|	
	|		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
	|		ON NOT &KeepRecordsOfInventoryCostByAssignments
	|		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
	|		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
	|		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
	|		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
	|		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	|	
	|	WHERE
	|		&CostCalculationIsPossible
	|		AND &BatchAccountingVersion22
	|		AND T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND VALUETYPE(T.Recorder) = TYPE(Document.ProductionCostAllocation)
	|		AND T.RecordType = VALUE(AccumulationRecordType.Expense)
	|		AND T.Organization IN (&CompanyArray)
	|
	|	UNION ALL
	|	
	// We exclude movements from materials in offline production
	|	SELECT
	|		T.Organization	AS Organization,
