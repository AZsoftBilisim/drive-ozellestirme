#Region ProceduresCalledFromRegisters

// Returns a flag for recording movements in the register by the batch and cost calculation engine.
//
// Parameters:
//	RecordSet - AccumulationRegisterRecordSet - a set of register entries.
//
// Returns:
//	Boolean - True if the movements are recorded by the routine operation of closing the month.
//
Function RegisteredRecordsAreRecordedByCalculatingBatchesAndCosts(RecordSet) Export
	
	// Let's check the presence of a service additional property for a set of records
	Return RecordSet.AdditionalProperties.Property(NameOfObjectSServiceAdditionalProperty());
	
EndFunction

// Checks whether it is necessary to generate movements in the cost accounting registers when conducting documents.
// If you don't need to generate movements, the record set will be cleared.
//
// Parameters:
//	RecordSet - AccumulationRegisterRecordSet - a set of register entries.
//
// Returns:
//	Boolean - True, if the formation of movements is required.
//
Function GenerateRegisteredRecordsOfCostAccountingRegisters(RecordSet) Export
	
	If RecordSet.AdditionalProperties.Property("GenerateRegisteredRecordsOfCostAccountingRegisters") Then
		ShapingRegisteredRecords = RecordSet.AdditionalProperties.GenerateRegisteredRecordsOfCostAccountingRegisters;
		RecordSet.AdditionalProperties.Delete("GenerateRegisteredRecordsOfCostAccountingRegisters");
		Return ShapingRegisteredRecords; // the check has already been performed before recording the set
	ElsIf RegisteredRecordsAreRecordedByCalculatingBatchesAndCosts(RecordSet)
	 And Not RecordSet.AdditionalProperties.Property("AddRegisteredRecordsFromInformationSecurityForPeriod") Then
		Return True; // if there is a cost calculation, then you do not need to check
	ElsIf Not CalculationOfCostCached.UnusedRegisteredRecordsOnCostRegistersArePossible() Then
		Return True; // cost accounting is carried out in all periods
	EndIf;
	
	RecordSet.AdditionalProperties.Insert("GenerateRegisteredRecordsOfCostAccountingRegisters", True);
	
	RegisterMetadata = RecordSet.Metadata();
	
	If RegisterMetadata = Metadata.InformationRegisters.JobsForCalculatingCost Then
		
		RecordsCount = RecordSet.Count();
		
		For RecNo = 0 To RecordsCount - 1 Do
			
			IndexOfRecord  = RecordsCount - 1 - RecNo; // traversing a set of records from the end to the beginning
			CalculationPeriod = BegOfMonth(RecordSet[IndexOfRecord].Month);
			
			If Not CalculationOfCostCached.CostCalculationIsPossible(CalculationPeriod) Then
				
				If RecordSet.AdditionalProperties.Property("GeneratedProgrammatically") Then
					RecordSet.Delete(IndexOfRecord);
				Else
					ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
						NStr("vi = 'trong kỳ %1, hạch toán giá vốn không được duy trì.';
							|ru = 'В периоде %1 учет себестоимости не ведется.';
							|en = 'Cost is not accounted in the period %1.'; fa = 'Cost is not accounted in the period %1.';
							|it = 'Nel periodo %1 il calcolo del costo non viene effettuato.';
							|pl = 'W okresie %1 ewidencja wartości własnej nie jest prowadzona.';
							|tr = 'Dönem %1''de hiçbir maliyet muhasebesi yapılmıyor.'", Common.DefaultLanguageCode()),
						CostCalculationProtocol.PresentationOfCalculationPeriod(CalculationPeriod));
					Raise ErrorText;
				EndIf;
				
			EndIf;
			
		EndDo;
		
		Return True;
		
	EndIf;
	
	RegisterNotUsed = CalculationOfCostCached.RegistersNotUsedWhenCostAccountingIsDisabled().Get(RegisterMetadata) <> Undefined;
	
	If Not RegisterNotUsed Then
		Return True;
	EndIf;
	
	RecordsCount = RecordSet.Count();
	If RecordsCount = 0 Then
		Return True;
	EndIf;
	
	Recorder = RecordSet.Filter.Recorder.Value;
	ThisIsInputOfResiduals = CalculationOfCostCached.RecordersWithRegisteredRecordsWhenCostAccountingIsTurnedOff().Get(Recorder.Metadata()) <> Undefined;
	
	RecordPeriods = RecordSet.Unload(,"Period");
	RecordPeriods.Sort("Period");
	
	If CalculationOfCostCached.GenerateRegisteredRecordsOnCostRegisters(BegOfMonth(RecordPeriods[0].Period), ThisIsInputOfResiduals) Then
		Return True;
	EndIf;
	
	For RecNo = 0 To RecordsCount - 1 Do
		
		IndexOfRecord = RecordsCount - 1 - RecNo; // traversing a set of records from the end to the beginning
		RecordPeriod = BegOfMonth(RecordSet[IndexOfRecord].Period);
		
		If Not CalculationOfCostCached.GenerateRegisteredRecordsOnCostRegisters(RecordPeriod, ThisIsInputOfResiduals) Then
			RecordSet.Delete(IndexOfRecord);
		EndIf;
		
	EndDo;
	
	RecordSet.AdditionalProperties.Insert("GenerateRegisteredRecordsOfCostAccountingRegisters", RecordSet.Count() > 0);
	
	Return RecordSet.Count() > 0;
	
EndFunction

// Called before recording a set of register entries - saves document movements generated by calculating batches and cost.
// Such movements have the Attribute Calculation of Parties = Truth or calculation of Cost = Truth.
// When re-checking the document, these movements are added to the set of movements generated by the document itself.
//
// Parameters:
//	RecordSet - AccumulationRegisterRecordSet - the property is an Object of the recordset module.
//	Replacing - Boolean, ReplacementMode - set recording mode (pre-Recording event parameter).
//	ChangedPeriods - Array of Date, Undefined - modified periods of primary RegisteredRecorded
//
Procedure SaveRegisteredRecordsGeneratedByCalculationOfBatchesAndCosts(RecordSet, Replacing, ChangedPeriods = Undefined) Export
	
	If CalculationOfCostCached.ValuesOfTechnologicalParameters().DoNotSaveCalculatedRegisteredRecords Then
		Return;
	EndIf;
	
	If (TypeOf(Replacing) = Type("Boolean") And Not Replacing)
	 Or (TypeOf(Replacing) <> Type("Boolean") And Not Common.IsRecordSetReplacement(Replacing)) Then
		Return; // the movements formed by the calculation of batches and cost are not erased
	EndIf;
	
	If Not RecordSet.AdditionalProperties.Property("ExactlyNeedToSaveMovement") Then
		If Not RecordSet.AdditionalProperties.Property("DocumentProperties")
		 Or RecordSet.AdditionalProperties.DocumentProperties.WriteMode = DocumentWriteMode.UndoPosting Then
			Return; // the movements formed by the calculation of batches and cost should be deleted
		EndIf;
	EndIf;
	
	If RecordSet.AdditionalProperties.Property("FormationOfManagementBalance") Then
		Return; // the movements formed for the upr.balance contain the movements of the cost calculation - it is not necessary to save
	EndIf;
	
	// Preparing auxiliary data
	RegisterMetadata = RecordSet.Metadata();
	Recorder        = RecordSet.Filter.Recorder.Value;
	
	If (RegisterMetadata = Metadata.AccumulationRegisters.ItemisedExpensesLots
	 	Or RegisterMetadata = Metadata.AccumulationRegisters.OtherIncome
	 	Or RegisterMetadata = Metadata.AccumulationRegisters.OtherExpenses)
	 And Not RecordSet.AdditionalProperties.Property("AddRegisteredRecordsFromInformationSecurityForPeriod") Then
		
		SaveYourRegisteredRecords = CalculationOfCostCached.ThereAreCalculatedRegisteredRecordsOfDocument(Recorder.Metadata().FullName(), RegisterMetadata.FullName());
		If Not SaveYourRegisteredRecords Then
			Return; // this type of document does not have any calculated RegisteredRecords for this register
		EndIf;
		
	EndIf;
	
	RegisterDescription = CalculationOfCostCached.GenerateCaseDescription(RegisterMetadata.FullName());
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	Query.SetParameter("Recorder", Recorder);
	
	If RegisterDescription.ThereIsCostCalculation And RegisterDescription.ThereIsCalculationOfParties Then
		TextSelectionCalculatedRegisteredRecords = "AND (T.CalculationOfCost OR T.LotCalculation)";
	// During the production phase, it is necessary to save all the calculated movements.
	// This is necessary for the immutability of the set of movements during the closed period.
	ElsIf RegisterDescription.RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name
	 And TypeOf(Recorder) = Type("DocumentRef.ProductionStage2_2") Then
		TextSelectionCalculatedRegisteredRecords = "AND T.SourceKind <> VALUE(Enum.MovementSourcesKinds.EmptyRef)"
	ElsIf RegisterDescription.ThereIsCostCalculation Then
		TextSelectionCalculatedRegisteredRecords = "AND T.CalculationOfCost";
	ElsIf RegisterDescription.ThereIsCalculationOfParties Then
		If Not CalculationOfCostCached.BatchAccountingVersion22() Then
			// For batch accounting registers, when using batch accounting below version 2.2
			// , it will not be possible to save offline movements, because they do not fill in the details of the "Calculation of Parties".
			Return;
		EndIf;
		TextSelectionCalculatedRegisteredRecords = "AND T.LotCalculation";
	Else
		// The register is not serviced by the calculation of batches and cost
		Return;
	EndIf;
	
	TextSelectionCalculatedRegisteredRecords = TextSelectionCalculatedRegisteredRecords + "
		|	AND T.Active";
	
	FieldTextOfMainRegisterTable = StringFunctionsClientServer.SubstituteParametersToString(
		RegisterDescription.FieldsOfMainRegisterTable, "
		|	T.");
		
	Query.Text =
	"SELECT
	|	&FieldsOfMainRegisterTable
	|INTO TTRecordset
	|FROM
	|	&RecordSet AS T
	|";
	
	Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
	Query.SetParameter("RecordSet", RecordSet.Unload());
	Query.Execute();
	
	Query.SetParameter("ChangedPeriods", New Array);
	Query.SetParameter("FilterByPeriods",   False);
	
	PeriodicityOfRegisteredRecords = "MONTH"; //@Query-part
	
	If RegisterMetadata = Metadata.AccumulationRegisters.InventoryCost
	 Or RegisterMetadata = Metadata.AccumulationRegisters.RegisterRecordsProductsIncomeExpenses
	 Or RegisterMetadata = Metadata.AccumulationRegisters.RecordsProductsProducts
	 Or RegisterMetadata = Metadata.AccumulationRegisters.Purchases
	 Or RegisterMetadata = Metadata.AccumulationRegisters.RevenueAndCOGS Then
		
		Query.SetParameter("ThisIsProductionStage", False);
		Query.SetParameter("ThisIsProductionStage", TypeOf(Recorder) = Type("DocumentRef.ProductionStage2_2"));
		If ValueIsFilled(ChangedPeriods) And Query.Parameters.ThisIsProductionStage Then
			Query.SetParameter("ChangedPeriods", ChangedPeriods);
			Query.SetParameter("FilterByPeriods",   True);
		EndIf;
		
		// Movements with the sign of settlement parties will be saved if (by OR)
		//	- the document has no primary movements (the need for movements will determine the mechanism of party accounting)
		//	- there are primary movements in the period of movement with the sign of settlement parties
		// We will save the movements with the sign of calculatability if (by OR)
		//	- there are primary movements in the period of movement with the sign of calculatability
		//	- there are movements with the sign of settlement parties in the period of movement with the sign of settlement
		
		Query.Text =
		"SELECT DISTINCT
		|	BEGINOFPERIOD(T.Period, MONTH) AS Month
		|INTO PeriodsOfPrimaryRegisteredRecords
		|FROM
		|	TTRecordset AS T
		|WHERE
		|	&FilterPrimaryRegisteredRecords
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	&BatchCalculationField AS LotCalculation,
		|	&CostCalculationField AS CalculationOfCost,
		|	BEGINOFPERIOD(T.Period, MONTH) AS Month
		|INTO PeriodsOfCalculatedRegisteredRecords
		|FROM
		|	&RegisterName AS T
		|WHERE
		|	T.Recorder = &Recorder
		|	AND T.Active
		|	AND &FilterCalculatedRegisteredRecords
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	T.Month AS Month
		|INTO BatchCalculationPeriods
		|FROM
		|	PeriodsOfCalculatedRegisteredRecords AS T
		|WHERE
		|	T.LotCalculation
		|	AND NOT &ThisIsProductionStage
		|	AND NOT 1 IN
		|				(SELECT TOP 1
		|					1
		|				FROM
		|					PeriodsOfPrimaryRegisteredRecords AS T)
		|
		|UNION ALL
		|
		|SELECT DISTINCT
		|	T.Month
		|FROM
		|	PeriodsOfCalculatedRegisteredRecords AS T
		|		LEFT JOIN PeriodsOfPrimaryRegisteredRecords AS Primary_1
		|		ON T.Month = Primary_1.Month
		|WHERE
		|	T.LotCalculation
		|	AND (Primary_1.Month IS NOT NULL 
		|			OR &ThisIsProductionStage)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT DISTINCT
		|	T.Month AS Month
		|INTO CostCalculationPeriods
		|FROM
		|	PeriodsOfCalculatedRegisteredRecords AS T
		|		LEFT JOIN PeriodsOfPrimaryRegisteredRecords AS PeriodsOfPrimaryRegisteredRecords
		|		ON T.Month = PeriodsOfPrimaryRegisteredRecords.Month
		|		LEFT JOIN BatchCalculationPeriods AS BatchCalculationPeriods
		|		ON (T.Month = PeriodsOfPrimaryRegisteredRecords.Month)
		|WHERE
		|	T.CalculationOfCost
		|	AND (NOT PeriodsOfPrimaryRegisteredRecords.Month IS NULL
		|			OR NOT BatchCalculationPeriods.Month IS NULL)";
		
		Query.Text = StrReplace(Query.Text, "&RegisterName", RegisterMetadata.FullName());
		
		If RegisterDescription.ThereIsCostCalculation And RegisterDescription.ThereIsCalculationOfParties Then
			
			Query.Text = StrReplace(Query.Text, "&FilterPrimaryRegisteredRecords", "(NOT T.LotCalculation AND NOT T.CalculationOfCost)");
			Query.Text = StrReplace(Query.Text, "&FilterCalculatedRegisteredRecords", "(T.LotCalculation OR T.CalculationOfCost)");
			Query.Text = StrReplace(Query.Text, "&BatchCalculationField", "T.LotCalculation");
			Query.Text = StrReplace(Query.Text, "&CostCalculationField", "T.CalculationOfCost");
			
			TextConnectionToPeriodTables = "
			|	LEFT JOIN BatchCalculationPeriods AS BatchCalculationPeriods
			|		ON BEGINOFPERIOD(T.Period, MONTH) = BatchCalculationPeriods.Month
			|		AND T.LotCalculation
			|	LEFT JOIN CostCalculationPeriods AS CostCalculationPeriods
			|		ON BEGINOFPERIOD(T.Period, MONTH) = CostCalculationPeriods.Month
			|		AND T.CalculationOfCost
			|";
			
			TextSelectionByPeriod = "
			|	AND (NOT BatchCalculationPeriods.Month IS NULL
			|			OR NOT CostCalculationPeriods.Month IS NULL)
			|	AND (NOT &FilterByPeriods
			|     		OR NOT (BEGINOFPERIOD(T.Period, MONTH) IN (&ChangedPeriods)))
			|";
			
		ElsIf RegisterDescription.ThereIsCostCalculation Then
			
			PeriodicityOfRegisteredRecords = "DAY"; //@Query-part
			
			Query.Text = StrReplace(Query.Text, "&FilterPrimaryRegisteredRecords", "(NOT T.CalculationOfCost)");
			Query.Text = StrReplace(Query.Text, "&FilterCalculatedRegisteredRecords", "(T.CalculationOfCost)");
			Query.Text = StrReplace(Query.Text, "&BatchCalculationField", "FALSE");
			Query.Text = StrReplace(Query.Text, "&CostCalculationField", "T.CalculationOfCost");
			
			TextConnectionToPeriodTables = "
			|	LEFT JOIN CostCalculationPeriods AS CostCalculationPeriods
			|		ON BEGINOFPERIOD(T.Period, MONTH) = CostCalculationPeriods.Month
			|		AND T.CalculationOfCost
			|";
			
			TextSelectionByPeriod = "
			|	AND (NOT CostCalculationPeriods.Month IS NULL)
			|";
			
		ElsIf RegisterDescription.ThereIsCalculationOfParties Then
			
			Query.Text = StrReplace(Query.Text, "&FilterPrimaryRegisteredRecords", "(NOT T.LotCalculation)");
			Query.Text = StrReplace(Query.Text, "&FilterCalculatedRegisteredRecords", "(T.LotCalculation)");
			Query.Text = StrReplace(Query.Text, "&BatchCalculationField", "T.LotCalculation");
			Query.Text = StrReplace(Query.Text, "&CostCalculationField", "FALSE");
			
			TextConnectionToPeriodTables = "
			|	LEFT JOIN BatchCalculationPeriods AS BatchCalculationPeriods
			|		ON BEGINOFPERIOD(T.Period, MONTH) = BatchCalculationPeriods.Month
			|		AND T.LotCalculation
			|";
			
			TextSelectionByPeriod = "
			|	AND (NOT BatchCalculationPeriods.Month IS NULL)
			|";
			
		Else
			// The register is not serviced by the calculation of batches and cost
			Return;
		EndIf;
		
		Query.Text = StrReplace(Query.Text, "MONTH", PeriodicityOfRegisteredRecords); //@Query-part
		
		Query.Execute();
		
	Else
		
		TextConnectionToPeriodTables = "";
		TextSelectionByPeriod = "";
		
	EndIf;
	
	// We are preparing a request for a sample of movements formed by calculating batches and cost.
	If RecordSet.AdditionalProperties.Property("AddRegisteredRecordsFromInformationSecurityForPeriod") Then
		TextSelectionPeriod = "AND T.Period <= &EndOfPeriod";
		Query.SetParameter("EndOfPeriod", RecordSet.AdditionalProperties.AddRegisteredRecordsFromInformationSecurityForPeriod.EndOfPeriod);
	Else
		TextSelectionPeriod = "";
	EndIf;
	
	RegisterNotUsed = CalculationOfCostCached.RegistersNotUsedWhenCostAccountingIsDisabled().Get(RegisterMetadata) <> Undefined;
	ThisIsInputOfResiduals = CalculationOfCostCached.RecordersWithRegisteredRecordsWhenCostAccountingIsTurnedOff().Get(Recorder.Metadata()) <> Undefined;
	
	If Not RegisterNotUsed Then
		
		TextPossibleRegisteredRecords = "";
		
	ElsIf Not CalculationOfCostCached.CostCalculationIsPossible() Then
		
		TextPossibleRegisteredRecords = "AND FALSE";
		
	Else
		
		AccountingDate = BegOfMonth(Constants.CostAccountingStartDate.Get());
		
		If Not ValueIsFilled(AccountingDate) Then
			
			TextPossibleRegisteredRecords = "";
			
		Else
			
			If ThisIsInputOfResiduals Then
				AccountingDate = BegOfMonth(AccountingDate - 1);
			EndIf;
			
			Query.SetParameter("CostAccountingStartDate", AccountingDate);
			
			TextPossibleRegisteredRecords = "AND T.Period >= &CostAccountingStartDate";
			
		EndIf;
		
	EndIf;
	
	// We will supplement the set of document records with Registered Records generated by the calculation of batches and cost.
	Query.Text = GETRequestHeader() + "
	|%1
	|FROM
	|	%2 AS T
	|%6
	|WHERE
	|	T.Recorder = &Recorder
	|	%3
	|	%4
	|	%5
	|	%7
	|
	|UNION ALL
	|
	|SELECT
	|%1
	|FROM
	|	TTRecordset AS T
	|";
	
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		Query.Text,
		FieldTextOfMainRegisterTable,
		RegisterDescription.FullRegisterName,
		TextSelectionPeriod,
		TextSelectionCalculatedRegisteredRecords,
		TextPossibleRegisteredRecords,
		TextConnectionToPeriodTables,
		TextSelectionByPeriod);
	
	// Let's arrange the set of records in the same way as it is done when calculating batches and cost.
	TextOfSortField = TrimAll(StrReplace(RegisterDescription.RegisterDimensions, "%1", ""));
	TextOfSortField = "Recorder, Period"
		+ ?(TextOfSortField = "", "", ", ") + TextOfSortField
		+ ?(RegisterDescription.ThereIsCostCalculation, ", CalculationOfCost", "")
		+ ?(RegisterDescription.ThereIsCalculationOfParties, 		  ", LotCalculation", "");
	
	Query.Text = Query.Text + "
	|ORDER BY
	|" + TextOfSortField;
	
	Query.Text = StrReplace(Query.Text, "MONTH", PeriodicityOfRegisteredRecords); //@Query-part
	
	RecordSet.Load(Query.Execute().Unload());
	
EndProcedure

#EndRegion

#Region ProceduresCalledFromDocuments

// Sets the parameters of a data sampling request for conducting a document on batch accounting registers.
// For the names of the parameters, see the code of the function Form a Parameter structureproviding().
//
// Parameters:
//	Query - Query - Request for setting parameters
//	Attributes - Arbitrary - the details of the document to determine the parameters of batch accounting
//	Organization - CatalogRef.Companies, Undefined - The organization for which the parameters will be received.
//
Procedure FillInInitializationParameters(Query, Attributes, Organization = Undefined) Export
	
	If Query.Parameters.Property("BatchAndCostParametersAreInitialized") Then
		Return;
	EndIf;
	
	If Query.TempTablesManager = Undefined Then
		Query.TempTablesManager = New TempTablesManager;
	EndIf;
	
	If TMCommonUseClientServer.HasObjectAttribute(Attributes, "Period") Then
		Period = BegOfMonth(Attributes.Period);
	Else
		Period = BegOfMonth(Attributes.Date);
	EndIf;
	
	If Organization <> Undefined Then
		CurrentCompany = Organization;
	ElsIf TMCommonUseClientServer.HasObjectAttribute(Attributes, "Organization")
	 And ValueIsFilled(Attributes.Organization) Then
		CurrentCompany = Attributes.Organization;
	Else
		CurrentCompany = Undefined;
	EndIf;
	
	ParametersStructure = CreateStructureOfRequestParametersForConducting(Attributes, Period, CurrentCompany);
	
	For Each KeyAndValue In ParametersStructure Do
		Query.SetParameter(KeyAndValue.Key, KeyAndValue.Value);
	EndDo;
	
	If Query.Parameters.Property("Ref") Then
		
		MetaDocument = Query.Parameters.Ref.Metadata();
		
		If MetaDocument = Metadata.Documents.ReversingEntry
		 Or MetaDocument.Attributes.Find("Patch") <> Undefined Then
		
			DataTable = New ValueTable;
			DataTable.Columns.Add("Period", 	  New TypeDescription("Date"));
			DataTable.Columns.Add("Organization", New TypeDescription("CatalogRef.Companies"));
			
			If ValueIsFilled(CurrentCompany) Then
				
				NwRw = DataTable.Add();
				NwRw.Organization = CurrentCompany;
				NwRw.Period = Period;
				
			ElsIf CalculationOfCostCached.MediumSlipValuationIsUsed() Then
				
				For Each CurrentCompany In Catalogs.Companies.AvailableCompanies(True) Do
					NwRw = DataTable.Add();
					NwRw.Organization = CurrentCompany;
					NwRw.Period = Period;
				EndDo;
				
			EndIf;
			
			FillInInitializationParametersByPeriod(Query, Attributes,,, DataTable);
			
			If Not Query.Parameters.Property("AdjustmentPeriod_")
			 Or (Not ValueIsFilled(Query.Parameters.AdjustmentPeriod_) 
			   And Query.Parameters.AdjustmentPeriod_ <> Null) Then
				
				AdjustmentPeriod_ = Date(1,1,1);
				
				RequestAdjustmentPeriod = New Query;
			 	RequestAdjustmentPeriod.Text =
				"SELECT
				|	ISNULL(T.CorrectedDocument.DATE, DATETIME(1,1,1)) AS AdjustmentPeriod_
				|FROM
				|	DocumentName AS T
				|WHERE
				|	T.Ref = &Ref";

			 	RequestAdjustmentPeriod.Text = StrReplace(RequestAdjustmentPeriod.Text, "DocumentName", MetaDocument.FullName());
				RequestAdjustmentPeriod.SetParameter("Ref", Query.Parameters.Ref);
				
				If MetaDocument.Attributes.Find("CorrectedDocument") <> Undefined
				 And ValueIsFilled(Query.Parameters.Ref.CorrectedDocument) Then
				 
					Selection = RequestAdjustmentPeriod.Execute().Select();
					If Selection.Next() Then
						AdjustmentPeriod_ = Selection.AdjustmentPeriod_;
					EndIf;
					
				ElsIf MetaDocument.Attributes.Find("ReversedDocument") <> Undefined
				 And ValueIsFilled(Query.Parameters.Ref.ReversedDocument) Then
				 
				 	RequestAdjustmentPeriod.Text = StrReplace(RequestAdjustmentPeriod.Text, "CorrectedDocument", "ReversedDocument");
					Selection = RequestAdjustmentPeriod.Execute().Select();
					If Selection.Next() Then
						AdjustmentPeriod_ = Selection.AdjustmentPeriod_;
					EndIf;
					
			 	EndIf;
				
				Query.SetParameter("AdjustmentPeriod_", AdjustmentPeriod_);
				
			EndIf;
			
		EndIf;
		
	EndIf;
	
	Query.SetParameter("BatchAndCostParametersAreInitialized", True);
	
EndProcedure

// Generates a temporary table of the parameters of the batch accounting for the audit, containing the parameters for the document on the registers of batch accounting.
// The procedure should be used if the document generates Registered Records in several periods
// and in each period it is necessary to take into account the batch accounting parameters valid in it (and not on the date of the document).
// Also, the procedure should be used for batch generation of Registered Records of several documents.
// For the names of the fields in the temporary table, see the description of the function formationparameter structuresquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestionsquestions()
// In addition, columns are added to the temporary table
//	- A period containing the date from the Periods parameter or from the Period column of the transmitted time table, given by the beginning of the month.
//	- An organization containing the data of the Organization column from the transmitted temporary table <Period Tablename> or Attributes.Organization (if the Periods parameter is passed)
// Information about periods is primarily obtained from the Periods parameter, and if the parameter is not passed, then from the time table <Period tablename>
// To connect to the temporary table, use
// the Period (required) and Organization fields (if the temporary table <Period Tablename> with the Organization column is passed).
//
// Parameters:
//	Query - Query - Request for setting parameters
//	Attributes - DocumentRef, Arbitrary - the details of the document to determine the parameters of batch accounting
// 	TimeIntervals - Array of Date - the periods in which the document generates the RegisteredRecords
//	PeriodTableName - String - the name of the temp table with the columns Period (required), Company, Link (optional)
//  DataTable - ValueTable
//	 *Period - Date -
//	 *Company - Directory link.Companies -
//
Procedure FillInInitializationParametersByPeriod(Query, Attributes, TimeIntervals = Undefined, PeriodTableName = "", DataTable = Undefined) Export
	
	RequestForParameters = New Query;
	RequestForParameters.TempTablesManager = Query.TempTablesManager;
	
	ParametersArray  = New Array;
	ParametersTable = New ValueTable;
	ColumnTypes_ 	  = New Structure;
	
	If TMCommonUseClientServer.HasObjectAttribute(Attributes, "Organization")
	 And ValueIsFilled(Attributes.Organization) Then
		CurrentCompany = Attributes.Organization;
	Else
		CurrentCompany = Catalogs.Companies.EmptyRef();
	EndIf;

	If TMCommonUseClientServer.HasObjectAttribute(Attributes, "Ref") Then
		CurrentRef = Attributes.Ref;
	Else
		CurrentRef = Undefined;
	EndIf;
	
	ThereIsDataTable = (DataTable <> Undefined);
	
	If Not ThereIsDataTable Then
		DataTable = New ValueTable;
		DataTable.Columns.Add("Period", 	  New TypeDescription("Date"));
		DataTable.Columns.Add("Organization", New TypeDescription("CatalogRef.Companies"));
	EndIf;
	
	If DataTable.Count() > 0 Then
		// The table with organizations and periods is passed using the parameter
		
	ElsIf TimeIntervals = Undefined And ValueIsFilled(PeriodTableName) Then // the temp table has been passed
		
		If TemporaryTableSize(RequestForParameters, PeriodTableName) = 0 Then
			
			NwRw = DataTable.Add();
			NwRw.Period = BegOfMonth(CurrentSessionDate());
			NwRw.Organization = CurrentCompany;
			
		Else
			
			If TemporaryTableColumnExists(RequestForParameters, PeriodTableName, "Ref") Then
				CurrentRef = UnloadTemporaryTable(RequestForParameters, PeriodTableName, 1)[0].Ref;
			EndIf;
		
			RequestForParameters.Text =
			"SELECT DISTINCT
			|	&Organization AS Organization,
			|	BEGINOFPERIOD(T.Period, MONTH) AS Period
			|FROM
			|	PeriodTableName AS T
			|WHERE
			|	T.Period <> DATETIME(1,1,1)";
			
			If TemporaryTableColumnExists(RequestForParameters, PeriodTableName, "Organization") Then
				RequestForParameters.Text = StrReplace(RequestForParameters.Text, "&Organization", "T.Organization");
			Else
				RequestForParameters.SetParameter("Organization", CurrentCompany);
			EndIf;
			
			RequestForParameters.Text = StrReplace(RequestForParameters.Text, "PeriodTableName", PeriodTableName);
			
			DataTable = RequestForParameters.Execute().Unload();
			
		EndIf;
		
	Else //an array of periods was passed
		
		If Not ValueIsFilled(TimeIntervals) Then
			TimeIntervals = New Array;
			TimeIntervals.Add(CurrentSessionDate());
		EndIf;
		
		For Each CurrentPeriod In TimeIntervals Do
			If ValueIsFilled(CurrentPeriod) Then
				NwRw = DataTable.Add();
				NwRw.Period = BegOfMonth(CurrentPeriod);
				NwRw.Organization = CurrentCompany;
			EndIf;
		EndDo;
		
		DataTable.GroupBy("Period, Organization");
		
	EndIf;
	
	// Let's collect information about the parameters by period.
	For Each CurrentRow In DataTable Do
		
		ParametersStructure = CreateStructureOfRequestParametersForConducting(
			Attributes,
			CurrentRow.Period,
			CurrentRow.Organization,
			CurrentRef);
		
		ParametersStructure.Insert("Period", 		CurrentRow.Period);
		ParametersStructure.Insert("Organization", CurrentRow.Organization);
		
		// Let's remember all possible types of columns in the parameter table.
		For Each KeyAndValue In ParametersStructure Do
			
			If TypeOf(KeyAndValue.Value) = Type("Array") Then
				// Parameters-arrays are passed not to the parameter table, but to the query parameters
				Query.SetParameter(KeyAndValue.Key, KeyAndValue.Value);				
				Continue;
			EndIf;
			
			If Not ColumnTypes_.Property(KeyAndValue.Key) Then
				ArrayOfColumnTypes = New Array;
			Else
				ArrayOfColumnTypes = ColumnTypes_[KeyAndValue.Key]; // Array
			EndIf;
			
			ArrayOfColumnTypes.Add(TypeOf(KeyAndValue.Value));
			ColumnTypes_.Insert(KeyAndValue.Key, ArrayOfColumnTypes);
			
		EndDo;
		
		ParametersArray.Add(ParametersStructure);
		
	EndDo;
	
	// Let's create columns of the parameter table.
	For Each KeyAndValue In ColumnTypes_ Do
		
		ColumnType = New TypeDescription(New TypeDescription(KeyAndValue.Value),, "Null");
		
		If ColumnType.Types().Count() = 0 Then
			ColumnType = New TypeDescription("String"); // if all values of this parameter are Undefined, then we will assign a "dummy" type to the column, which can be selected in the query
		EndIf;
		
		ParametersTable.Columns.Add(KeyAndValue.Key, ColumnType);
		
	EndDo;
	
	// Let's move the parameters from the array to the table of values.
	For Each ParametersStructure In ParametersArray Do
		FillPropertyValues(ParametersTable.Add(), ParametersStructure);
	EndDo;
	
	DestroyTemporaryTables(RequestForParameters, "TTParametersOfBatchAccountingForConducting");
	
	// Put the table of values in the temporary table of the parameters of the batch account for the test.
	RequestForParameters.SetParameter("TableOfBatchAccountingParameters", ParametersTable);
	
	RequestForParameters.Text =
	"SELECT
	|	*
	|INTO TTParametersOfBatchAccountingForConducting
	|FROM
	|	&TableOfBatchAccountingParameters AS T";
	
	RequestForParameters.Execute();
	
	Query.SetParameter("IDOfUnusedFinRecord", DocumentsPosting.IDOfUnusedFinRecord());
	
EndProcedure

// Forms the structure of parameters that affect the logic of the document for batch accounting registers.
//
// Parameters:
// 	Attributes - DocumentRef, QueryResultSelection - Data source
// 	Period - Date - period for receiving data
//  Organization - CatalogRef.Companies, Undefined - period for receiving data
//  Ref - DocumentRef, Undefined - link to the document to get the data
// Returns:
// 	Structure - LongDesc:
// * ThisIsInputOfResidualsInH_2_4 - Boolean -
// * VNAManagementIsUsed_2_4 - Boolean -
// * UseAccountingOfOtherIncomeExpensesInLocalAccounting - Boolean -
// * UseAccountingOfOtherIncomeExpenses - Arbitrary -
// * OptionOfAssignedAccountingOfGoods - Arbitrary - 
// * EnabledGoodsAssignmentInSalesOpportunity - Arbitrary - 
// * SalesOpportunity - Arbitrary - 
// * GenerateInventoryOwnerAttributesByBusinessUnitsAndManagers - Arbitrary -
// * GenerateInventoryOwnerAttributesBySalesOpportunities - Arbitrary -
// * FIFORollingValuation - Boolean -
// * KeepRecordsOfInventoryCostByAssignments - Boolean -
// * CompanyManagementAccounting - Boolean -
// * BatchAccountingVersion22 - Boolean -
// * BatchAccountingVersion21 - Boolean, Undefined -
// * BatchAccountingNotUsed - Boolean -
// * BatchAccountingVersion22IsIncluded- Boolean -
// * DateOfMigrationToBatchAccounting22 - Date -
// 
Function CreateStructureOfRequestParametersForConducting(Attributes, Period, Organization = Undefined, Ref = Undefined)
	
	ParametersStructure = New Structure;
	
	ParametersStructure.Insert("BatchAccountingNotUsed",
		CalculationOfCostCached.BatchAccountingNotUsed(Period));
	ParametersStructure.Insert("BatchAccountingVersion21",
		CalculationOfCostCached.BatchAccountingVersion21(Period));
	ParametersStructure.Insert("BatchAccountingVersion22",
		CalculationOfCostCached.BatchAccountingVersion22(Period));
		
	ParametersStructure.Insert("BatchAccountingVersion22IsIncluded",
		CalculationOfCostCached.BatchAccountingVersion22());
	ParametersStructure.Insert("DateOfMigrationToBatchAccounting22",
		CalculationOfCostCached.DateOfMigrationToBatchAccounting22());
	
	ParametersStructure.Insert("CompanyManagementAccounting",
		CalculationOfCostCached.CompanyManagementAccounting(Period));
	ParametersStructure.Insert("StartDateOfManagementAccountingOfOrganizations",
		CalculationOfCostCached.StartDateOfManagementAccountingOfOrganizations());	

	ParametersStructure.Insert("KeepRecordsOfInventoryCostByAssignments",
		CalculationOfCostCached.CostOfGoodsForPurposes(BegOfMonth(Period)));
	
	ParametersStructure.Insert("SeparateAccountingOfGoodsByVATTaxation", False);
	
	If Organization <> Undefined Then
		CurrentCompany = Organization;
	ElsIf TMCommonUseClientServer.HasObjectAttribute(Attributes, "Organization")
	 And ValueIsFilled(Attributes.Organization) Then
		CurrentCompany = Attributes.Organization;
	Else
		CurrentCompany = Undefined;
	EndIf;
	
	If Ref <> Undefined Then
		CurrentRef = Ref;
	ElsIf TMCommonUseClientServer.HasObjectAttribute(Attributes, "Ref") Then
		CurrentRef = Attributes.Ref;
	Else
		CurrentRef = Undefined;
	EndIf;
	
	If ValueIsFilled(CurrentCompany) Then
		
		ParametersOfTaxSystem = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate("TaxationSystemSettings",
			CurrentCompany,
			Period);
		AccountingPolicyParameters = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate("FinancialAccountingPolicy",
			CurrentCompany,
			Period);
		VATAccountingPolicyParameters = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate("VATAccountingSettings",
			CurrentCompany,
			Period);
		
		ParametersStructure.Insert("SimplifiedTaxationSystem",
			(ParametersOfTaxSystem <> Undefined
				And ParametersOfTaxSystem.TaxationSystem = Enums.TaxationSystems.Simplified));
				
		ParametersStructure.Insert("FIFORollingValuation",
			(AccountingPolicyParameters <> Undefined
				And AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.FIFORollingValuation));
		
		ParametersStructure.Insert("MovingAverage",
			(AccountingPolicyParameters <> Undefined
				And AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.MovingAverage));
				
		ParametersStructure.Insert("ItemizeMaterialAndItemizedExpensesInInventoryCost",
			(AccountingPolicyParameters <> Undefined
				And AccountingPolicyParameters.ItemizeMaterialAndItemizedExpensesInInventoryCost));
				
		ParametersStructure.Insert("SeparateAccountingOfGoodsByVATTaxation",
			(VATAccountingPolicyParameters <> Undefined
				And VATAccountingPolicyParameters.SeparateAccountingOfGoodsByVATTaxation));
		
		// Full-fledged accounting of finished products at the planned cost is maintained when writing off deviations to the cost of sales,
		// except for the "Medium-sliding" valuation method. With an average sliding cost, products are always recorded at the planned cost.
		ParametersStructure.Insert("ProductCostingByPlannedCost",
			(AccountingPolicyParameters <> Undefined
				And AccountingPolicyParameters.ProductCostingByPlannedCost
				And (AccountingPolicyParameters.WriteOffProductCostVariancesToCostOfGoodsSold
					Or AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.MovingAverage)
				)
			);
		
		ParametersStructure.Insert("PlannedCostRatio",
			?(AccountingPolicyParameters <> Undefined
				And AccountingPolicyParameters.ProductCostingByPlannedCost, 1, 0));
		
		GenerateVATChargedWhenIncludingInCost = AccountingPolicyParameters <> Undefined
			And AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.MovingAverage;
		If Not GenerateVATChargedWhenIncludingInCost Then
			GenerateVATChargedWhenIncludingInCost = VATAccountingPolicyParameters <> Undefined
				And VATAccountingPolicyParameters.GenerateVATChargedWhenIncludingInCost;
		EndIf;
		ParametersStructure.Insert("GenerateVATChargedWhenIncludingInCost",
			GenerateVATChargedWhenIncludingInCost);
		
		ParametersStructure.Insert("WriteOffVATByExpensesThatAreNotRecordedInTA",
			(VATAccountingPolicyParameters <> Undefined
				And VATAccountingPolicyParameters.WriteOffVATByExpensesThatAreNotRecordedInTA));
	
	Else
		
		ParametersStructure.Insert("SimplifiedTaxationSystem", False);
		ParametersStructure.Insert("FIFORollingValuation", False);
		ParametersStructure.Insert("MovingAverage", False);
		ParametersStructure.Insert("ItemizeMaterialAndItemizedExpensesInInventoryCost", False);
		ParametersStructure.Insert("ProductCostingByPlannedCost", False);
		ParametersStructure.Insert("PlannedCostRatio", 0);
		ParametersStructure.Insert("GenerateVATChargedWhenIncludingInCost", False);
		ParametersStructure.Insert("WriteOffVATByExpensesThatAreNotRecordedInTA", False);
		
	EndIf;
	
	ParametersStructure.Insert("GenerateInventoryOwnerAttributesBySalesOpportunities",
		GetFunctionalOption("GenerateInventoryOwnerAttributesBySalesOpportunities"));
	ParametersStructure.Insert("GenerateInventoryOwnerAttributesByBusinessUnitsAndManagers",
		GetFunctionalOption("GenerateInventoryOwnerAttributesByBusinessUnitsAndManagers"));
	ParametersStructure.Insert("GenerateInventoryOwnerAttributesByFinancialAccountingGroups",
		GetFunctionalOption("GenerateInventoryOwnerAttributesByFinancialAccountingGroups"));
	
	If TMCommonUseClientServer.HasObjectAttribute(Attributes, "SalesOpportunity") Then
		ParametersStructure.Insert("SalesOpportunity", Attributes.SalesOpportunity);
	EndIf;
	
	If TMCommonUseClientServer.HasObjectAttribute(Attributes, "EnabledGoodsAssignmentInSalesOpportunity") Then
		ParametersStructure.Insert("EnabledGoodsAssignmentInSalesOpportunity", Attributes.EnabledGoodsAssignmentInSalesOpportunity);
	EndIf;
	
	If TMCommonUseClientServer.HasObjectAttribute(Attributes, "OptionOfAssignedAccountingOfGoods") Then
		ParametersStructure.Insert("OptionOfAssignedAccountingOfGoods", Attributes.OptionOfAssignedAccountingOfGoods);
	EndIf;
	
	ParametersStructure.Insert("UseAccountingOfOtherIncomeExpenses", GetFunctionalOption("UseAccountingOfOtherIncomeExpenses"));
	ParametersStructure.Insert("UseAccountingOfOtherIncomeExpensesInLocalAccounting", GetFunctionalOption("UseAccountingOfOtherIncomeExpensesInLocalAccounting"));
	
	ParametersStructure.Insert("IDOfUnusedFinRecord", DocumentsPosting.IDOfUnusedFinRecord());
	
	VNAManagementIsUsed_2_4 = False;
	ThisIsInputOfResidualsInH_2_4 = False;
	If TypeOf(CurrentRef) = Type("DocumentRef.EntryOfCapitalAssetsBalance2_4")
		Or TypeOf(CurrentRef) = Type("DocumentRef.OBEntrySubAssetsAndComponentsOfDepreciation") Then
		// When switching to accounting 2.4, balances are entered a day earlier than the start date of accounting 2.4.
		VNAManagementIsUsed_2_4 = True;
		ThisIsInputOfResidualsInH_2_4 = True;
	Else
		VNAManagementIsUsed_2_4 = NonCurrentAssets.VNAManagementIsUsed_2_4(Period);
	EndIf;
	ParametersStructure.Insert("VNAManagementIsUsed_2_4", VNAManagementIsUsed_2_4);
	ParametersStructure.Insert("ThisIsInputOfResidualsInH_2_4", ThisIsInputOfResidualsInH_2_4);
	
	// Types of VAT taxation
	ParametersStructure.Insert("TypesOfTaxationVATIsNotIncludedInCost",
		VATAccountingERP.TypesOfTaxationVATIsNotIncludedInCost());
	ParametersStructure.Insert("TypesOfTaxationVATIsIncludedInCost",
		VATAccountingERP.ActivitiesVATIsIncludedInCost());
	
	ParametersStructure.Insert("InventoryTypesOwn", Enums.InventoryTypes.InventoryTypesOwn());
	
	CalculationOfCostLocalization.AddRequestParametersForConducting(Attributes, Period, CurrentCompany, ParametersStructure);
	
	Return ParametersStructure;
	
EndFunction


// Checks for changes in the table parts of the document.
// The tabular part of the object document is collapsed according to the sum / quantity details
// and checked against the tabular part of the document in the IB.
// If the table part of the document contains a date attribute, then its minimum value is determined in the changed rows.
// However, lines where the date is not filled in are not checked for modification.
// 
// Parameters:
//	DocumentObject - DocumentObject - document being checked
//	TabularSectionsDetails - Structure
//		Key-name of the table part
//		Value-Structure with mandatory keys
//			"Resources" - the string value of this key lists the total and quantitative details of the table part
//			" date " separated by commas-the string value of this key specifies the name of the details with the date (if there is no date, the value is not filled in).
//
// Returns:
//	Structure:
//	* HasChanges - Boolean - indicates whether there are changes in the table part
//	* Date - Date, Undefined - the minimum value of the date attribute in the modified row of the table part.
//
Function ChangedTabularPartsOfDocument(DocumentObject, TabularSectionsDetails) Export
	
	Result = New Structure("HasChanges, Date", False, Undefined);
	
	SetPrivilegedMode(True);
	
	MetaDocument = DocumentObject.Metadata();
	
	Query = New Query;
	Query.SetParameter("Ref", DocumentObject.Ref);
	
	QueryTemplate =
	"SELECT
	|&TableFields
	|INTO TTTabularPart
	|FROM
	|	&Table AS T
	|;
	|
	|SELECT
	|&CollapsedFields
	|INTO ttChanges
	|FROM
	|(SELECT
	|&TableFields
	|FROM
	|	TTTabularPart AS T
	|
	|UNION ALL
	|
	|SELECT
	|&FieldsWithMinus
	|FROM
	|	&DocumentTable AS T
	|WHERE
	|	T.Ref = &Ref
	|) AS T
	|WHERE &Group
	|AND &FilterCriterion
	|;
	|
	|SELECT
	|	MIN(&Date) AS Result
	|FROM
	|	ttChanges AS T
	|WHERE
	|	&Date <> DATETIME(1,1,1,0,0,0)
	|";
	
	For Each KeyAndValue In TabularSectionsDetails Do
		
		// Let's prepare the texts of the request fragments.
		MeasurementString_    = "";
		LineResources	   = "";
		LineResourcesAmount = "";
		LineResourcesSelection = "";
		StructureResources = New Structure(?(ValueIsFilled(KeyAndValue.Value.Resources), KeyAndValue.Value.Resources, ""));
		StringDate 		 = ?(ValueIsFilled(KeyAndValue.Value.Date), "T." + KeyAndValue.Value.Date, "Undefined");
		
		For Each MetaAttribute In MetaDocument.TabularSections[KeyAndValue.Key].Attributes Do
			
			If MetaAttribute.Type = New TypeDescription("UUID")
			 Or MetaAttribute.Type = New TypeDescription("String") Then
				Continue;
			EndIf;
			
			If StructureResources.Property(MetaAttribute.Name) Then
				LineResources = LineResources + ?(LineResources = "", "", ",
					|	") + "T." + MetaAttribute.Name;
				LineResourcesAmount = LineResourcesAmount + ?(LineResourcesAmount = "", "", ",
					|	") + "SUM(T." + MetaAttribute.Name + ") AS " + MetaAttribute.Name;
				LineResourcesSelection = LineResourcesSelection + ?(LineResourcesSelection = "", "	", "
					|	OR ") + "SUM(T." + MetaAttribute.Name + ") <> 0";
			Else
				MeasurementString_ = MeasurementString_ + ?(MeasurementString_ = "", "", ",
					|") + "	T." + MetaAttribute.Name;
			EndIf;
			
		EndDo;
		
		FieldString = MeasurementString_ + ?(MeasurementString_ = "" Or LineResources = "", "", ",
			|	") + LineResources;
		FieldStringWithMinus = MeasurementString_ + ?(MeasurementString_ = "" Or LineResources = "", "", ",
			|	") + StrReplace(LineResources, "T.", "-T.");
		LineFieldsCollapsed = MeasurementString_ + ?(MeasurementString_ = "" Or LineResourcesAmount = "", "", ",
			|	") + LineResourcesAmount;
		RowTableOfDocument = "Document." + MetaDocument.Name + "." + KeyAndValue.Key;
		
		// Let's form the text of the request and execute the request.
		Query.SetParameter("Table", DocumentObject[KeyAndValue.Key].Unload());
		
		Query.Text = QueryTemplate;
		
		Query.Text = StrReplace(Query.Text, "&TableFields", 	  FieldString);
		Query.Text = StrReplace(Query.Text, "&FieldsWithMinus", 	  FieldStringWithMinus);
		Query.Text = StrReplace(Query.Text, "&DocumentTable", RowTableOfDocument);
		Query.Text = StrReplace(Query.Text, "&CollapsedFields", 	  LineFieldsCollapsed);
		Query.Text = StrReplace(Query.Text, "WHERE &Group",  ?(MeasurementString_ = "", "", "GROUP BY" + Chars.LF + MeasurementString_));
		Query.Text = StrReplace(Query.Text, "AND &FilterCriterion",  ?(LineResourcesSelection = "", "", "HAVING" + Chars.LF + LineResourcesSelection));
		Query.Text = StrReplace(Query.Text, "&Date", 			  StringDate);
		
		Selection = Query.Execute().Select();
		Selection.Next();
		
		If Selection.Result <> Null Then // differences found
			
			Result.HasChanges = True;
			
			If TypeOf(Selection.Result) = Type("Date") Then
				Result.Date = ?(Result.Date = Undefined, Selection.Result, Min(Result.Date, Selection.Result));
			EndIf;
			
		EndIf;
		
	EndDo;
	
	Return Result;
	
EndFunction

