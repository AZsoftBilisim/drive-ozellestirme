// Replaces the path in the selected data layout field
//
// Parameters:
//	ArrayOfCDFieldsUsed - Array of DataCompositionSelectedField - Array to fill in the selected fields in the CD.
//	OriginalPath - String - the name of the source path of the data layout field.
//	PathEnd - String - the name of the final path of the data layout field.
//
Procedure ReplacePathInSelectedDataLayoutField(ArrayOfCDFieldsUsed, OriginalPath, PathEnd) Export
	
	FieldThatNeedsToBeReplaced = New DataCompositionField(OriginalPath);
	FieldToReplaceItWith = New DataCompositionField(PathEnd);
	
	For Each Field In ArrayOfCDFieldsUsed Do
		If Field.Field = FieldThatNeedsToBeReplaced Then
			Field.Field = FieldToReplaceItWith;
		EndIf;
	EndDo;
	
EndProcedure

// Fills the array with the selected fields in the data layout settings
//
// Parameters:
//	StructureItem - DataCompositionSettings - settings that will be used in the Template Composer.
//	FieldArray - Array of DataCompositionSelectedField - Array to fill in the selected fields in the CD.
//	AllFields - Boolean - If True, then all selected fields will be dubbed,
//		if False, then only with the Use check mark (default: False).
//	DataCompositionField - DataCompositionSelectedField - The data layout field that needs to be added to the array.
//
Procedure AddSelectedDataLayoutFieldsToArray(StructureItem, FieldArray, AllFields = False,
		DataCompositionField = Undefined) Export
	
	For Each Item In StructureItem Do
		If TypeOf(Item) = Type("DataCompositionSelectedFieldGroup") Then
			AddSelectedDataLayoutFieldsToArray(Item.Items, FieldArray, AllFields, DataCompositionField);
		ElsIf TypeOf(Item) = Type("DataCompositionSelectedField") Then
			If (DataCompositionField = Undefined Or Item.Field = DataCompositionField)
				And (AllFields Or Item.Use) Then
			
				FieldArray.Add(Item);
			EndIf;
		ElsIf TypeOf(Item) = Type("DataCompositionTable") Then  
			AddSelectedDataLayoutFieldsToArray(Item.Rows, FieldArray, AllFields, DataCompositionField);
		ElsIf TypeOf(Item) = Type("DataCompositionTableGroup") Then
			AddSelectedDataLayoutFieldsToArray(Item.Selection.Items, FieldArray, AllFields, DataCompositionField);
			AddSelectedDataLayoutFieldsToArray(Item.Structure, FieldArray, AllFields, DataCompositionField);
		EndIf;
	EndDo;
	
EndProcedure

// Fills the array with dimension fields, in the data layout settings
//
// Parameters:
//	StructureItem - DataCompositionSettings - settings that will be used in the Template Composer.
//	FieldArray - Array of DataCompositionSelectedField - Array to fill in the selected fields in the CD.
//	AllFields - Boolean - If True, then all selected fields will be dubbed,
//		if False, then only with the Use check mark (default: False).
//
Procedure AddDataGroupingAndLayoutFieldsToArray(StructureItem, FieldArray, AllFields = False) Export
	
	For Each Item In StructureItem Do
		If TypeOf(Item) = Type("DataCompositionGroupField")
			And (AllFields Or Item.Use) Then
			
			FieldArray.Add(Item);
		EndIf;
	EndDo;
	
EndProcedure

// Fills the array with grouping fields and selected fields in the data layout settings
//
// Parameters:
//	DCStructure - DataCompositionSettingStructureItemCollection - settings that will be used in the Template Composer.
//	FieldArray - Array of DataCompositionSelectedField - Array to fill in the selected fields in the CD.
//
Procedure GetUsedFieldsOfAllDimensions(DCStructure, FieldArray) Export

	For Each DCStructureItem In DCStructure Do 
		If TypeOf(DCStructureItem) <> Type("DataCompositionGroup") Then
			Continue;
		EndIf;
		If DCStructureItem.Use Then
			AddSelectedDataLayoutFieldsToArray(DCStructureItem.Selection.Items,
				FieldArray);
			AddDataGroupingAndLayoutFieldsToArray(DCStructureItem.GroupFields.Items,
				FieldArray);
			GetUsedFieldsOfAllDimensions(DCStructureItem.Structure, FieldArray);
		EndIf;
	EndDo; 

EndProcedure

// Returns an array of organizations that have revenue over a specified period,
// but the method of valuation differs from the "first in, first out (sliding)".
//
// Parameters:
//	BeginOfPeriod - Date - start of the period for getting movements
//	EndOfPeriod - Date - the end of the period for the receipt of motions.
//
Function OrganizationsWithoutFIFOSliding(BeginOfPeriod, EndOfPeriod, SettingsComposer, CompanyFieldName1)
	
	CompanyArray = OrganizationsToSelectFromReportSettings(SettingsComposer, CompanyFieldName1);
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	
	AccountingPoliciesTaxSettings.SupplementTemporaryTableManagerWithCurrentParametersForAccountingPolicies(
		Metadata.InformationRegisters.FinancialAccountingPolicy.Name,
		Query.TempTablesManager,
		BeginOfPeriod,
		"TTAccountingPolicyOfFinancialAccounting");
	
	Query.Text =
	"SELECT DISTINCT
	|	Dimension.Organization AS Ref
	|INTO TTCompaniesWithRegisteredRecords
	|FROM
	|	AccumulationRegister.RevenueAndCOGS.Turnovers(&BeginOfPeriod, &EndOfPeriod, ,) AS Revenue
	|	INNER JOIN Catalog.DimensionKeysOfAccountingByPartners AS Dimension
	|		ON Dimension.Ref = Revenue.AccountingDimensionByPartners
	|WHERE
	|	Dimension.Organization IN (&CompanyArray)
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Ref AS Ref
	|FROM
	|	Catalog.Companies AS T
	|	INNER JOIN TTCompaniesWithRegisteredRecords AS OrganizationsWithRegisteredRecords
	|		ON T.Ref = OrganizationsWithRegisteredRecords.Ref
	|	INNER JOIN TTAccountingPolicyOfFinancialAccounting AS AccountingPoliciesOfOrganizations_
	|		ON T.Ref = AccountingPoliciesOfOrganizations_.Organization
	|WHERE
	|	AccountingPoliciesOfOrganizations_.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.FIFORollingValuation)
	|
	|ORDER BY
	|	Ref
	|AUTOORDER";
	
	Query.SetParameter("BeginOfPeriod", BeginOfPeriod);
	Query.SetParameter("EndOfPeriod",  EndOfPeriod);
	Query.SetParameter("CompanyArray", CompanyArray);
	
	SetPrivilegedMode(True);
	
	ArrayOfExcludedOrganizations_ = Query.Execute().Unload().UnloadColumn("Ref");
	
	Return ArrayOfExcludedOrganizations_;
	
EndFunction

