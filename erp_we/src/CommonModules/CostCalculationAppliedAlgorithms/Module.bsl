#Region ActionsWithCalculationBatchTable

Function AddAndFillInCalculatedBatch(CalculationParameters, Expense, Receipt, Invert = False)
	
	Context   = CalculationParameters.DistributionOfParties.RegisterRecordsDetails.Context;
	Indicators = CalculationParameters.DistributionOfParties.RegisterRecordsDetails.Indicators;
	
	SettlementBatch = AddSettlementBatch(CalculationParameters);
	
	FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt);
	
	InvertMetrics(SettlementBatch, Indicators, Invert);
	
	Return SettlementBatch;
	
EndFunction

// Adds a new row to the calculation batch table and fills in the required fields.
//
// Returns:
//	ValueTableRow - 
//
Function AddSettlementBatch(CalculationParameters, FillingData = Undefined, PerformCaching = True) Export
	
	SettlementBatches = CalculationParameters.DistributionOfParties.SettlementBatches;
	
	// If necessary, we cache the generated batch portion into the table of movements by register.
	// Caching does not need to be performed if this procedure is called from a procedure of the form Fill in the calculated party...
	If SettlementBatches.Count() >= CalculationParameters.SamplingRestrictions.NumberOfVTZLines And PerformCaching Then
		
		If Not ThisIsBackgroundBatchCalculation(CalculationParameters) Then
			
			CacheDistributedBatches(CalculationParameters, False);
			
		Else
			
			CacheCalculatedBatchesWhenCalculatingInBackground(CalculationParameters);
			
		EndIf;
		
	EndIf;
	
	// Let's add a row to the table of distributed batches
	SettlementBatch = SettlementBatches.Add();
	
	If FillingData <> Undefined Then
		FillPropertyValues(SettlementBatch, FillingData);
	EndIf;
	
	FixAdditionOfCalculatedBatchInMeasurement(CalculationParameters);
	
	Return SettlementBatch;
	
EndFunction

// Deletes the specified row from the batch table.
//
Procedure DeleteCalculatedBatch(CalculationParameters, SettlementBatch)
	
	SettlementBatches = CalculationParameters.DistributionOfParties.SettlementBatches; // ValueTable
	SettlementBatches.Delete(SettlementBatch);
	
	FixRemovalOfCalculatedBatchInMeasurement(CalculationParameters);
	
EndProcedure

