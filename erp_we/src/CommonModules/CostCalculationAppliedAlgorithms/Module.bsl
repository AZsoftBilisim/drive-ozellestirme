// Records movements in the specified independent data register.
//
// Parameters:
//	RawData - Query, QueryResult, QueryResultSelection, ValueTable -
//		Movements by register, necessarily ordered by register
//		If the source has only the Logger column, then the movements will simply be cleared for these loggers.
//	RegisterManager - InformationRegisterManager -
//	WriteParameters - Structure - recording parameters
//
Procedure RecordPortionOfRegisteredRecordsOfIndependentRegister(RawData, RegisterManager, WriteParameters) Export
	
	WriteParameters.Insert("DescriptionOfRecordingErrors", "");
	
	If Not ValueIsFilled(WriteParameters.NumberOfGnzRecords) Then
		// It can be used for debugging purposes - to perform a full-fledged calculation without changing the information security data
		// You should not use this opportunity if the calculation of the first month is performed on the batch accounting mechanism version 2.2,
		// because the initial balances of the batches will not be recorded and all subsequent calculations will not make sense.
		Return; 
	EndIf;
	
	DataSource = RawData; // selection or table of values
	
	If DataSource.Count() = 0 Then
		Return; // nothing to write down
	EndIf;
	
	SeparatorFieldName = WriteParameters.SeparatorFieldName;
	OnlyClearRecords = False;
	DescriptionOfRecordingErrors = "";
	NumberOfAdditionalWriteAttempts = 0;
	
	NameOfObjectSServiceAdditionalProperty = NameOfObjectSServiceAdditionalProperty();
	
	RecordSet = RegisterManager.CreateRecordSet(); //Register of recordset entries.Detailingthe cost of goods
	RecordSet.AdditionalProperties.Insert(NameOfObjectSServiceAdditionalProperty, True);
	
	SourceDataPortion = Undefined;
	SetNumber 		  = Undefined;
	RecordPortionNumber     = 1;
	
	PeriodicRegister_ = CostCalculationUniversalAlgorithms.ThisIsPeriodicInformationRegister(RecordSet.Metadata());
	
	FieldNamePeriod = ?(PeriodicRegister_, "Period", "RegistrationPeriod");
	
	While GetNextChunkFromDataSource(DataSource, SourceDataPortion) Do
		
		If SetNumber <> SourceDataPortion.SetNumber Then
			
			If WriteParameters.Property("NumberOfSets") Then
				WriteParameters.NumberOfSets = WriteParameters.NumberOfSets + 1;
			EndIf;
			
			// If the dial number in the movements has changed, we will record the movements of the previous set.
			If SetNumber <> Undefined Then
				WriteSetOfIndependentRegisterEntries(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
			EndIf;
			
			SetNumber = SourceDataPortion.SetNumber;
			RecordPeriod = BegOfMonth(SourceDataPortion[FieldNamePeriod]);
			RecordPortionNumber = 1;
			
			RecordSet = RegisterManager.CreateRecordSet(); //Register of recordset entries.Detailingthe cost of goods
			RecordSet.AdditionalProperties.Insert(NameOfObjectSServiceAdditionalProperty, True);
			
			RecordSet.Filter[FieldNamePeriod].Set(RecordPeriod);
			RecordSet.Filter.Organization.Set(SourceDataPortion.Organization);
			RecordSet.Filter[SeparatorFieldName].Set(SourceDataPortion[SeparatorFieldName]);
			RecordSet.Filter.EntryType.Set(SourceDataPortion.EntryType);
			
		ElsIf Not OnlyClearRecords And RecordSet.Count() >= WriteParameters.NumberOfGnzRecords Then
			
			// If there are a lot of entries in the document movements, we will record them in portions
			// The first portion is recorded with the replacement of the old records, the next - with the addition to the previous portions.
			WriteSetOfIndependentRegisterEntries(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
			
			RecordPortionNumber = RecordPortionNumber + 1;
			
		EndIf;
		
		Record = RecordSet.Add();
		FillPropertyValues(Record, SourceDataPortion);
		Record[FieldNamePeriod] = RecordPeriod;
		
	EndDo;
	
	If SetNumber <> Undefined Then
		WriteSetOfIndependentRegisterEntries(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
	EndIf;
	
	If NumberOfAdditionalWriteAttempts > 0 Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã thử bổ sung bản ghi kết chuyển của biểu ghi %1: %2';
				|ru = 'Выполнено дополнительных попыток записи движений регистра %1: %2';
				|en = 'Performed additional attempts of register records writing %1: %2'; fa = 'Performed additional attempts of register records writing %1: %2';
				|it = 'Sono stati eseguiti tentativi aggiuntivi di registrare i movimenti del registro %1: %2';
				|pl = 'Wykonano dodatkowych prób zapisywania ruchów rejestru %1: %2';
				|tr = 'Kayıt hareketlerini kaydetmek için ek denemeler yapıldı %1: %2'"),
			RecordSet.Metadata().FullName(),
			TrimAll(NumberOfAdditionalWriteAttempts));
		
		WriteLogEvent(
			EventLogEventName(Undefined, NStr("vi = 'Bản ghi kết chuyển';
												|ru = 'Запись движений';
												|en = 'Writing register records'; fa = 'Writing register records';
												|it = 'Scrittura dei movimenti';
												|pl = 'Nagrywanie ruchów';
												|tr = 'Hareket kaydı'", Common.DefaultLanguageCode())),
			EventLogLevel.Warning,,,
			ProtocolText_);
		
	EndIf;
	
	If Not IsBlankString(DescriptionOfRecordingErrors) Then
		
		If WriteParameters.Property("NotRaiseExceptionAtError") And WriteParameters.NotRaiseExceptionAtError Then
			WriteParameters.Insert("DescriptionOfRecordingErrors", DescriptionOfRecordingErrors);
		Else
			Raise ServiceSymbol_ProblemAlreadyRegistered() + DescriptionOfRecordingErrors; // all errors in recording the transmitted portion of movements
		EndIf;
		
	EndIf;
	
EndProcedure

// Records of movements of documents at the specified register.
//
// Parameters:
//	RawData - Query, QueryResult, QueryResultSelection, ValueTable -
//		Movements by register, necessarily ordered by register
//		If the source has only the Logger column, then the movements will simply be cleared for these loggers.
//	RegisterManager - AccumulationRegisterManager -
//	WriteParameters - Structure - recording parameters
//
Procedure RecordRegisteredRecordsByRegister(RawData, RegisterManager, WriteParameters) Export
	
	WriteParameters.Insert("DescriptionOfRecordingErrors", "");
	
	If Not ValueIsFilled(WriteParameters.NumberOfGnzRecords) Then
		// It can be used for debugging purposes - to perform a full-fledged calculation without changing the information security data
		// You should not use this opportunity if the calculation of the first month is performed on the batch accounting mechanism version 2.2,
		// because the initial balances of the batches will not be recorded and all subsequent calculations will not make sense.
		Return; 
	EndIf;
	
	If WriteParameters.NumberOfLoggersInWriteTransaction > 0 Then
		RecordRegisteredRecordsOnRegisterInTransaction(RawData, RegisterManager, WriteParameters);
		Return;
	EndIf;
	
	// Let's bring the source data to the type of selection from a query or a table of values
	If TypeOf(RawData) = Type("Query") Then
		DataSource = RawData.Execute().Select(); // Selection
	ElsIf TypeOf(RawData) = Type("QueryResult") Then
		DataSource = RawData.Select(); // Selection
	Else
		DataSource = RawData; // selection or table of values
	EndIf;
	
	If DataSource.Count() = 0 Then
		Return; // nothing to write down
	EndIf;
	
	// If there are no columns required for the register in the source, for example, the Period,
	// then we believe that the registrars have been transferred, which simply need to clear the movements.
	If TypeOf(DataSource) = Type("QueryResultSelection") Then
		SourceOfColumns = DataSource.Owner(); // QueryResult 
		OnlyClearRecords = (SourceOfColumns.Columns.Find("Period") = Undefined);
	Else // the data source is a table of values
		SourceOfColumns = DataSource; // ValueTable
		OnlyClearRecords = (SourceOfColumns.Columns.Find("Period") = Undefined);
	EndIf;
	
	DescriptionOfRecordingErrors = "";
	NumberOfAdditionalWriteAttempts = 0;
	
	RecordSet = RegisterManager.CreateRecordSet(); // AccumulationRegisterRecordSet.InventoryCost - or any other serviced register
	RecordSet.AdditionalProperties.Insert(NameOfObjectSServiceAdditionalProperty(), True);
	
	SourceDataPortion = Undefined;
	CurrentRegistrar    = Undefined;
	RecordPortionNumber     = 1;
	
	While GetNextChunkFromDataSource(DataSource, SourceDataPortion) Do
		
		If CurrentRegistrar <> SourceDataPortion.Recorder Then
			
			If WriteParameters.Property("NumberOfSets") Then
				WriteParameters.NumberOfSets = WriteParameters.NumberOfSets + 1;
			EndIf;
			
			// If the registrar has changed in movements, we will record the movements of the previous registrar.
			If Not WriteParameters.AddRecordSet And ValueIsFilled(CurrentRegistrar) Then
				WriteRecordSet(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
			EndIf;
			
			CurrentRegistrar = SourceDataPortion.Recorder;
			RecordPortionNumber = ?(WriteParameters.AddRecordSet, 2, 1);
			
			RecordSet.Filter.Recorder.Set(CurrentRegistrar);
			
			RecordSet.DataExchange.Recipients.Clear();
			
		ElsIf Not OnlyClearRecords
				And RecordSet.Count() >= WriteParameters.NumberOfGnzRecords Then

			// If there are a lot of entries in the document movements, we will record them in portions
			// The first portion is recorded with the replacement of the old records, the next - with the addition to the previous portions.
			WriteRecordSet(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
			
			RecordPortionNumber = RecordPortionNumber + 1;
			
		EndIf;
		
		If Not OnlyClearRecords Then
			Record = RecordSet.Add();
			FillPropertyValues(Record, SourceDataPortion);
		EndIf;
		
	EndDo;
	
	If ValueIsFilled(CurrentRegistrar) Then
		WriteRecordSet(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
	EndIf;
	
	If NumberOfAdditionalWriteAttempts > 0 Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã thử bổ sung bản ghi kết chuyển của biểu ghi %1: %2';
				|ru = 'Выполнено дополнительных попыток записи движений регистра %1: %2';
				|en = 'Performed additional attempts of register records writing %1: %2'; fa = 'Performed additional attempts of register records writing %1: %2';
				|it = 'Sono stati eseguiti tentativi aggiuntivi di registrare i movimenti del registro %1: %2';
				|pl = 'Wykonano dodatkowych prób zapisywania ruchów rejestru %1: %2';
				|tr = 'Kayıt hareketlerini kaydetmek için ek denemeler yapıldı %1: %2'"),
			RecordSet.Metadata().FullName(),
			TrimAll(NumberOfAdditionalWriteAttempts));
		
		WriteLogEvent(
			EventLogEventName(Undefined, NStr("vi = 'Bản ghi kết chuyển';
												|ru = 'Запись движений';
												|en = 'Writing register records'; fa = 'Writing register records';
												|it = 'Scrittura dei movimenti';
												|pl = 'Nagrywanie ruchów';
												|tr = 'Hareket kaydı'", Common.DefaultLanguageCode())),
			EventLogLevel.Warning,,,
			ProtocolText_);
		
	EndIf;
	
	If Not IsBlankString(DescriptionOfRecordingErrors) Then
		
		If WriteParameters.Property("NotRaiseExceptionAtError") And WriteParameters.NotRaiseExceptionAtError Then
			WriteParameters.Insert("DescriptionOfRecordingErrors", DescriptionOfRecordingErrors);
		Else
			Raise ServiceSymbol_ProblemAlreadyRegistered() + DescriptionOfRecordingErrors; // all errors in recording the transmitted portion of movements
		EndIf;
		
	EndIf;
	
EndProcedure

// Records document movements according to the specified register in the transaction.
//
// Parameters:
//	RawData - Query, QueryResult, QueryResultSelection, ValueTable -
//		Movements by register, necessarily ordered by register
//		If the source has only the Logger column, then the movements will simply be cleared for these loggers.
//	RegisterManager - AccumulationRegisterManager -
//	WriteParameters - Structure - recording parameters
//
Procedure RecordRegisteredRecordsOnRegisterInTransaction(RawData, RegisterManager, WriteParameters) Export
	
	WriteParameters.Insert("DescriptionOfRecordingErrors", "");
	
	If Not ValueIsFilled(WriteParameters.NumberOfGnzRecords) Then
		// It can be used for debugging purposes - to perform a full-fledged calculation without changing the information security data
		// You should not use this opportunity if the calculation of the first month is performed on the batch accounting mechanism version 2.2,
		// because the initial balances of the batches will not be recorded and all subsequent calculations will not make sense.
		Return; 
	EndIf;
	
	// Let's bring the source data to the type of selection from a query or a table of values
	If TypeOf(RawData) = Type("Query") Then
		DataSource = RawData.Execute().Select(); // Selection
	ElsIf TypeOf(RawData) = Type("QueryResult") Then
		DataSource = RawData.Select(); // Selection
	Else
		DataSource = RawData; // selection or table of values
	EndIf;
	
	If DataSource.Count() = 0 Then
		Return; // nothing to write down
	EndIf;
	
	SourceSample = TypeOf(DataSource) = Type("QueryResultSelection");
	
	// If there are no columns required for the register in the source, for example, the Period,
	// then we believe that the registrars have been transferred, which simply need to clear the movements.
	If SourceSample Then 
		SourceOfColumns = DataSource.Owner(); // QueryResult 
		OnlyClearRecords = (SourceOfColumns.Columns.Find("Period") = Undefined);
	Else // the data source is a table of values
		SourceOfColumns = DataSource; // ValueTable
		OnlyClearRecords = (SourceOfColumns.Columns.Find("Period") = Undefined);
	EndIf;
	
	TableLoggers = New ValueTable;
	TableLoggers.Columns.Add("Recorder", 	New TypeDescription(Documents.AllRefsType()));
	TableLoggers.Columns.Add("RowsCount", New TypeDescription("Number"));
	TableLoggers.Columns.Add("PortionNumber", 	New TypeDescription("Number"));
	
	PortionsOfRegistrars = New Array; // index: portion number, value: number of source lines in a portion
	
	SourceDataPortion = Undefined;
	CurrentRegistrar    = Undefined;
	LoggerString	  = Undefined;
	PortionSize 		  = WriteParameters.NumberOfLoggersInWriteTransaction;
	CurPortion		  = Undefined;
	
	While GetNextChunkFromDataSource(DataSource, SourceDataPortion) Do
		
		If CurrentRegistrar <> SourceDataPortion.Recorder Then
			
			CurrentRegistrar = SourceDataPortion.Recorder;
			
			LoggerString = TableLoggers.Add();
			LoggerString.Recorder = CurrentRegistrar;
			LoggerString.PortionNumber = Int((TableLoggers.Count() - 1)/ PortionSize);
			
		EndIf;
		
		If CurPortion <> LoggerString.PortionNumber Then
			CurPortion = LoggerString.PortionNumber;
			PortionsOfRegistrars.Add(0);
		EndIf;
		
		LoggerString.RowsCount = LoggerString.RowsCount + 1;
		PortionsOfRegistrars[PortionsOfRegistrars.Count() - 1] = PortionsOfRegistrars[PortionsOfRegistrars.Count() - 1] + 1;
		
	EndDo;	
	
	TableLoggers.Indexes.Add("PortionNumber");
	
	If SourceSample Then 
		DataSource.Reset();
	EndIf;
	
	RecordSet = RegisterManager.CreateRecordSet(); // AccumulationRegisterRecordSet.InventoryCost - or any other serviced register
	RecordSet.AdditionalProperties.Insert(NameOfObjectSServiceAdditionalProperty(), True);
	
	DescriptionOfRecordingErrors = "";
	NumberOfAdditionalWriteAttempts = 0;
	
	SourceDataPortion = Undefined;
	CurrentRegistrar    = Undefined;
	RecordPortionNumber     = 1;
			
	For PortionNumberOfRegistrars = 0 To PortionsOfRegistrars.Count() - 1 Do
		
		NumberOfRowsPerServing = PortionsOfRegistrars[PortionNumberOfRegistrars];
		
		BeginTransaction();
		
		Try
			
			CurPortionLoggers = TableLoggers.Copy(
				TableLoggers.FindRows(New Structure("PortionNumber", PortionNumberOfRegistrars)),
				"Recorder");
				
			Block = New DataLock;
			LockItem = Block.Add("InformationRegister.JobsForCalculatingCost");

			LockItem.DataSource = CurPortionLoggers;
			LockItem.UseFromDataSource("Document", "Recorder");
			LockItem.Mode = DataLockMode.Exclusive;
			
			Block.Lock();
			
			ModifiedLoggers = LoggersChangedDuringCalculation(
				CurPortionLoggers,
				RecordSet.Metadata(),
				DescriptionOfRecordingErrors,
				WriteParameters);
			
			For CurLineNumberOfPortion = 1 To NumberOfRowsPerServing Do
				
				GetNextChunkFromDataSource(DataSource, SourceDataPortion);
				
				If ModifiedLoggers.Get(SourceDataPortion.Recorder) <> Undefined Then
					Continue;
				EndIf;
				
				If CurPortionLoggers.Find(SourceDataPortion.Recorder) = Undefined Then
					Raise NStr("vi = 'Lỗi giao tác ghi lại bản ghi kết chuyển chứng từ.';
								|ru = 'Ошибка транзакции записи движений документов.';
								|en = 'A transaction error occurred when writing the document register records.'; fa = 'A transaction error occurred when writing the document register records.';
								|it = 'Errore della transazione di registrazione dei movimenti del documento.';
								|pl = 'Błąd transakcji wpisu ruchów dokumentów.';
								|tr = 'Belge kayıtlarının kaydedilmesinde işlem hatası.'")
				EndIf;
				
				If CurrentRegistrar <> SourceDataPortion.Recorder Then
					
					If WriteParameters.Property("NumberOfSets") Then
						WriteParameters.NumberOfSets = WriteParameters.NumberOfSets + 1;
					EndIf;
					
					// If the registrar has changed in movements, we will record the movements of the previous registrar.
					If Not WriteParameters.AddRecordSet And ValueIsFilled(CurrentRegistrar) Then
						WriteRecordSet(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
					EndIf;
					
					CurrentRegistrar = SourceDataPortion.Recorder;
					RecordPortionNumber = ?(WriteParameters.AddRecordSet, 2, 1);
					
					RecordSet.Filter.Recorder.Set(CurrentRegistrar);
					
					RecordSet.DataExchange.Recipients.Clear();
					
				ElsIf Not OnlyClearRecords
						And RecordSet.Count() >= WriteParameters.NumberOfGnzRecords Then

					// If there are a lot of entries in the document movements, we will record them in portions
					// The first portion is recorded with the replacement of the old records, the next - with the addition to the previous portions.
					WriteRecordSet(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
					
					RecordPortionNumber = RecordPortionNumber + 1;
					
				EndIf;
				
				If Not OnlyClearRecords Then
					Record = RecordSet.Add();
					FillPropertyValues(Record, SourceDataPortion);
				EndIf;
				
			EndDo;
			
			If ValueIsFilled(CurrentRegistrar) Then
				WriteRecordSet(RecordSet, (RecordPortionNumber = 1), DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
			EndIf;
			
			CommitTransaction();
			
		Except
			
			RollbackTransaction();
			
			DescriptionOfRecordingErrors = DescriptionOfRecordingErrors + Chars.LF + DetailErrorDescription(ErrorInfo());
			
			Break;
			
		EndTry;
		
	EndDo;
	
	If NumberOfAdditionalWriteAttempts > 0 Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã thử bổ sung ghi lại các bản ghi kết chuyển của biểu ghi %1: %2';
				|ru = 'Выполнено дополнительных попыток записи движений регистра %1: %2';
				|en = 'Performed additional attempts of register records writing %1: %2'; fa = 'Performed additional attempts of register records writing %1: %2';
				|it = 'Sono stati eseguiti tentativi aggiuntivi di registrare i movimenti del registro %1: %2';
				|pl = 'Wykonano dodatkowych prób zapisywania ruchów rejestru %1: %2';
				|tr = 'Kayıt hareketlerini kaydetmek için ek denemeler yapıldı %1: %2'"),
			RecordSet.Metadata().FullName(),
			TrimAll(NumberOfAdditionalWriteAttempts));
		
		WriteLogEvent(
			EventLogEventName(Undefined, NStr("vi = 'Bản ghi kết chuyển';
												|ru = 'Запись движений';
												|en = 'Writing register records'; fa = 'Writing register records';
												|it = 'Scrittura dei movimenti';
												|pl = 'Nagrywanie ruchów';
												|tr = 'Hareket kaydı'")),
			EventLogLevel.Warning,,,
			ProtocolText_);
		
	EndIf;
	
	If Not IsBlankString(DescriptionOfRecordingErrors) Then
		
		If WriteParameters.Property("NotRaiseExceptionAtError") And WriteParameters.NotRaiseExceptionAtError Then
			WriteParameters.Insert("DescriptionOfRecordingErrors", DescriptionOfRecordingErrors);
		Else
			Raise ServiceSymbol_ProblemAlreadyRegistered() + DescriptionOfRecordingErrors; // all errors in recording the transmitted portion of movements
		EndIf;
		
	EndIf;
	
EndProcedure

// Gets the next portion from the selection or the next row from the value table.
//
Function GetNextChunkFromDataSource(DataSource, SourceDataPortion)
	
	If TypeOf(DataSource) = Type("QueryResultSelection") Then 
		
		If DataSource.Next() Then
			SourceDataPortion = DataSource; // the data is stored in the fields of the selection itself
		Else
			Return False; // no more data available
		EndIf;
		
	Else // the data source is a table of values
		
		DataSource = DataSource; //ValueTable
		
		If SourceDataPortion = Undefined Then
			RowIndex = 0;
		Else
			RowIndex = DataSource.IndexOf(SourceDataPortion) + 1;
		EndIf;
		
		If RowIndex < DataSource.Count() Then
			SourceDataPortion = DataSource[RowIndex]; // next line
		Else
			Return False; // no more data available
		EndIf;
		
	EndIf;
	
	Return True; // a new portion of data is placed in the portion of the data source
	
EndFunction

// Writes the transmitted set of records to an independent data register.
//
Procedure WriteSetOfIndependentRegisterEntries(RecordSet, Replace, DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters)
	
	NumberOfWriteAttempts = ?(WriteParameters.Property("NumberOfWriteAttempts"), WriteParameters.NumberOfWriteAttempts, 1);
	
	For AttemptNumber = 1 To NumberOfWriteAttempts Do
		
		NumberOfAdditionalWriteAttempts = NumberOfAdditionalWriteAttempts + ?(AttemptNumber = 1, 0, 1);
		
		Try
			
			PeriodEndClosingDatesTM.DisableVerificationOfDateWhenChangesWereBanned(RecordSet);
			RecordSet.Write(Replace);
			
			Break; // no more recording is required
			
		Except
			
			If AttemptNumber <> NumberOfWriteAttempts Then
				Continue; // the error will be logged on the last failed attempt
			EndIf;
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Lỗi bản ghi kết chuyển theo biểu ghi thông tin ""%1"":
					|%2';
					|ru = 'Ошибка записи движений по регистру сведений ""%1"":
					|%2';
					|en = 'Error writing records in the information register ""%1"":
					|%2'; fa = 'Error writing records in the information register ""%1"":
					|%2';
					|it = 'Errore di registrazione di movimenti nel registro di informazioni ""%1"":
					|%2';
					|pl = 'Błąd zapisywania ruchów wg rejestru danych ""%1"":
					|%2';
					|tr = 'Bilgi kaydı ""%1"" hareketlerin kaydedilmesinde hata:
					|%2'", Common.DefaultLanguageCode()),
				RecordSet.Metadata().Name,
				DetailErrorDescription(ErrorInfo()));
			
			RegisterMotionRecordingError(
				Undefined,
				WriteParameters,
				NStr("vi = 'Khi ghi bản ghi kết chuyển, đã chẩn đoán được lỗi';
					|ru = 'При записи движений диагностированы ошибки';
					|en = 'Errors were found when saving records'; fa = 'Errors were found when saving records';
					|it = 'Durante la scrittura dei movimenti sono stati diagnosticati degli errori';
					|pl = 'Błędy wykryte podczas zapisywania ruchów';
					|tr = 'Hareketleri kaydederken, hatalar teşhis edildi'", Common.DefaultLanguageCode()),
				ProtocolText_,
				DescriptionOfRecordingErrors,
				RecordSet.Filter.Organization.Value);
			
		EndTry;
		
	EndDo;
	
	RecordSet.Clear();
	
EndProcedure

// Writes the passed set of records.
//
// Parameters:
// 	RecordSet - AccumulationRegisterRecordSet, InformationRegisterRecordSet - 
// 	Replace - Boolean -
// 	DescriptionOfRecordingErrors - String -
//	NumberOfAdditionalWriteAttempts - Number -
// 	WriteParameters - Structure -
Procedure WriteRecordSet(RecordSet, Replace, DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters)
	
	Recorder = RecordSet.Filter.Recorder.Value;
	
	NumberOfWriteAttempts = ?(WriteParameters.Property("NumberOfWriteAttempts"), WriteParameters.NumberOfWriteAttempts, 1);
	
	For AttemptNumber = 1 To NumberOfWriteAttempts Do
		
		NumberOfAdditionalWriteAttempts = NumberOfAdditionalWriteAttempts + ?(AttemptNumber = 1, 0, 1);
		
		Try
			
			If WriteParameters.NumberOfLoggersInWriteTransaction > 0 // in this case, the modification of all documents in the record transaction is checked 
			 Or Not LoggerChangedDuringCalculation(Recorder, RecordSet, DescriptionOfRecordingErrors, WriteParameters) Then
				PeriodEndClosingDatesTM.DisableVerificationOfDateWhenChangesWereBanned(RecordSet);
				RecordSet.Write(Replace);
			EndIf;
			
			Break; // no more recording is required
			
		Except
			
			If AttemptNumber <> NumberOfWriteAttempts Then
				Continue; // the error will be logged on the last failed attempt
			EndIf;
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Lỗi bản ghi kết chuyển của chứng từ ""%1"" theo biểu ghi ""%2"":
					|%3';
					|ru = 'Ошибка записи движений документа ""%1"" по регистру ""%2"":
					|%3';
					|en = 'An error occurred while writing the ""%1"" document register records by the ""%2"" register:
					|%3'; fa = 'An error occurred while writing the ""%1"" document register records by the ""%2"" register:
					|%3';
					|it = 'Errore nella scrittura dei movimenti del documento ""%1"" per il registro ""%2"":
					|%3';
					|pl = 'Błąd zapisu ruchów dokumentu ""%1"" wg rejestru ""%2"":
					|%3';
					|tr = '""%1"" belgesinin hareketlerinin ""%2"" kaydı ile kaydedilmesi hatası:
					|%3'", Common.DefaultLanguageCode()),
				TrimAll(Recorder),
				RecordSet.Metadata().Name,
				DetailErrorDescription(ErrorInfo()));
			
			RegisterMotionRecordingError(
				Recorder,
				WriteParameters,
				NStr("vi = 'Khi ghi lại bản ghi kết chuyển, đã chẩn đoán được lỗi';
					|ru = 'При записи движений диагностированы ошибки';
					|en = 'Errors were found when saving records'; fa = 'Errors were found when saving records';
					|it = 'Durante la scrittura dei movimenti sono stati diagnosticati degli errori';
					|pl = 'Błędy wykryte podczas zapisywania ruchów';
					|tr = 'Hareketleri kaydederken, hatalar teşhis edildi'", Common.DefaultLanguageCode()),
				ProtocolText_,
				DescriptionOfRecordingErrors);
			
		EndTry;
	
	EndDo;
	
	RecordSet.Clear();
	
EndProcedure

// Checks that the document was not changed/expanded during the calculation.
//
Function LoggerChangedDuringCalculation(Recorder, RecordSet, DescriptionOfRecordingErrors, WriteParameters)
	
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT
	|	T.Organization
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS T
	|WHERE
	|	T.Document = &Recorder
	|	AND T.JobNumber > &JobNumber";
	
	Query.SetParameter("Recorder",   Recorder);
	Query.SetParameter("JobNumber",  WriteParameters.TaskNumberBeforeCalculation);
	
	QueryResult = Query.Execute();
	
	If QueryResult.IsEmpty() Then
		Return False;
	EndIf;
	
	If RecordSet.Count() > 0
	 And WriteParameters.Property("RegistrarsWithLargeSets")
	 And WriteParameters.RegistrarsWithLargeSets <> Undefined
	 And WriteParameters.RegistrarsWithLargeSets.Find(Recorder) = Undefined Then
	 
		Query.SetParameter("BeginOfPeriod", BegOfMonth(WriteParameters.CalculationPeriod));
		Query.SetParameter("EndOfPeriod",  EndOfMonth(WriteParameters.CalculationPeriod));
		
		Query.Text =
		"SELECT TOP 1
		|	T.Month
		|FROM
		|	InformationRegister.JobsForCalculatingCost AS T
		|WHERE
		|	T.Document = &Recorder
		|	AND T.JobNumber > &JobNumber
		|	AND T.Month = &BeginOfPeriod";
		
		RecordingIsPossible = Query.Execute().IsEmpty();
		
		If RecordingIsPossible Then
			
			// It is necessary to save the movements from the set of records for the Cur period and supplement them with records for other periods from the information security
			Records = RecordSet.Unload();
			RecordSet.Clear();
			
			For Each CurrRow In Records Do
				
				If BegOfMonth(CurrRow.Period) = BegOfMonth(WriteParameters.CalculationPeriod) Then
					FillPropertyValues(RecordSet.Add(), CurrRow);
				EndIf;
				
			EndDo;
			
			Query.Text = 
			"SELECT
			|	*
			|FROM
			|	RegisterName AS T
			|WHERE
			|	T.Recorder = &Recorder
			|	AND NOT (T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod)
			|ORDER BY
			|	T.Period";
			
			Query.Text = StrReplace(Query.Text, "RegisterName", RecordSet.Metadata().FullName());
			
			Selection = Query.Execute().Select();
			
			While Selection.Next() Do
				FillPropertyValues(RecordSet.Add(), Selection);
			EndDo;
			
			Return False;
			
		EndIf;
		
	EndIf;
	
	Selection = QueryResult.Select();
	
	While Selection.Next() Do
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Trong quá trình tính toán, đã thay đổi bản ghi kết chuyển của chứng từ ""%1"" theo biểu ghi tích lũy ""%2""';
				|ru = 'Во время расчета изменены движения документа ""%1"" по регистру накопления ""%2""';
				|en = 'The ""%1"" document register records by the ""%2"" accumulation register were changed during calculation'; fa = 'The ""%1"" document register records by the ""%2"" accumulation register were changed during calculation';
				|it = 'Durante il calcolo, sono stati modificati i movimenti del documento ""%1"" per il registro di accumulo ""%2""';
				|pl = 'Podczas obliczeń zmienione ruchy dokumentu ""%1"" wg rejestru akumulacji ""%2""';
				|tr = 'Hesaplama sırasında ""%1"" belgesinin ""%2"" birikim kaydı üzerindeki hareketleri değiştirildi'", Common.DefaultLanguageCode()),
			TrimAll(Recorder),
			RecordSet.Metadata().Name);
			
		RegisterMotionRecordingError(
			Recorder,
			WriteParameters,
			NStr("vi = 'Trong quá trình tính toán, đã nhập các thay đổi vào chứng từ tính toán';
				|ru = 'Во время расчета были внесены изменения в рассчитываемый документ';
				|en = 'Changes were made to the calculated document during calculation'; fa = 'Changes were made to the calculated document during calculation';
				|it = 'Durante il calcolo, sono state apportate modifiche al documento da calcolare';
				|pl = 'Podczas obliczeń wprowadzono zmiany do obliczanego dokumentu.';
				|tr = 'Hesaplama sırasında, hesaplanmakta olan belgede değişiklikler yapıldı'", Common.DefaultLanguageCode()),
			ProtocolText_,
			DescriptionOfRecordingErrors,
			Selection.Organization);
		
	EndDo;
	
	Return True;
	
EndFunction

// Checks that the documents were not changed/distributed during the calculation.
//
Function LoggersChangedDuringCalculation(Recorders, MetaRegister, DescriptionOfRecordingErrors, WriteParameters)
	
	Query = New Query;
	
	Query.SetParameter("Recorders", Recorders);
	Query.SetParameter("JobNumber", WriteParameters.TaskNumberBeforeCalculation);
	
	Query.Text =
	"SELECT
	|	T.Recorder
	|INTO TTSelection
	|FROM
	|	&Recorders AS T
	|INDEX BY
	|	Recorder
	|;
	|
	|SELECT DISTINCT
	|	T.Organization,
	|	T.Document
	|FROM
	|	InformationRegister.JobsForCalculatingCost AS T
	|	INNER JOIN TTSelection AS Filter
	|		ON T.Document = Filter.Recorder
	|WHERE
	|	T.JobNumber > &JobNumber";
	
	ModifiedLoggers = Query.Execute().Unload();
	Result = New Map;
	
	For Each CurrRow In ModifiedLoggers Do
		
		Result.Insert(CurrRow.Recorder, True);
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Trong quá trình tính toán, đã thay đổi các bản ghi kết chuyển của chứng từ ""%1"" theo biểu ghi tích lũy ""%2""';
				|ru = 'Во время расчета изменены движения документа ""%1"" по регистру накопления ""%2""';
				|en = 'The ""%1"" document register records by the ""%2"" accumulation register were changed during calculation'; fa = 'The ""%1"" document register records by the ""%2"" accumulation register were changed during calculation';
				|it = 'Durante il calcolo, sono stati modificati i movimenti del documento ""%1"" per il registro di accumulo ""%2""';
				|pl = 'Podczas obliczeń zmienione ruchy dokumentu ""%1"" wg rejestru akumulacji ""%2""';
				|tr = 'Hesaplama sırasında ""%1"" belgesinin ""%2"" birikim kaydı üzerindeki hareketleri değiştirildi'", Common.DefaultLanguageCode()),
			TrimAll(CurrRow.Recorder),
			MetaRegister.Name);
			
		RegisterMotionRecordingError(
			CurrRow.Recorder,
			WriteParameters,
			NStr("vi = 'Trong quá trình tính toán, đã nhập các thay đổi vào chứng từ được tính toán';
				|ru = 'Во время расчета были внесены изменения в рассчитываемый документ';
				|en = 'Changes were made to the calculated document during calculation'; fa = 'Changes were made to the calculated document during calculation';
				|it = 'Durante il calcolo, sono state apportate modifiche al documento da calcolare';
				|pl = 'Podczas obliczeń wprowadzono zmiany do obliczanego dokumentu.';
				|tr = 'Hesaplama sırasında, hesaplanmakta olan belgede değişiklikler yapıldı'", Common.DefaultLanguageCode()),
			ProtocolText_,
			DescriptionOfRecordingErrors,
			CurrRow.Organization);
		
	EndDo;
	
	Return Result;
	
EndFunction

// Registers an error that occurred when recording movements..
//
Procedure RegisterMotionRecordingError(Recorder, WriteParameters, IssueText, Refinement, DescriptionOfRecordingErrors, Organization = Undefined)
	
	If WriteParameters.Property("NumberOfRegisteredErrorsOfSameType") Then
		NumberOfRegisteredErrorsOfSameType = WriteParameters.NumberOfRegisteredErrorsOfSameType;
	Else
		NumberOfRegisteredErrorsOfSameType = MonthEndTransactionsServer.NumberOfRegisteredErrorsOfSameType();
	EndIf;
	
	If StrLineCount(DescriptionOfRecordingErrors) < NumberOfRegisteredErrorsOfSameType Then
		DescriptionOfRecordingErrors = DescriptionOfRecordingErrors + ?(IsBlankString(DescriptionOfRecordingErrors), "
			|", "") + CostCalculationProtocol.ServiceSymbol_BulletedList() + Refinement + "
			|";
	Else
		// The error message is too large.
		// Most likely, the entries in it will be of the same type - there is no need to output them all.
		If StrFind(DescriptionOfRecordingErrors, "...") = 0 Then
			DescriptionOfRecordingErrors = DescriptionOfRecordingErrors + "
				|" + CostCalculationProtocol.ServiceSymbol_BulletedList() + " ...";
		EndIf;
	EndIf;
	
	If Not ValueIsFilled(Organization) Then
		DocumentAttributes = Common.ObjectAttributesValues(Recorder, "Organization");
		CalculationParameters   = InitializeBasicCalculationParameters(WriteParameters.CalculationPeriod, WriteParameters.CalculationPeriod, DocumentAttributes.Organization);
	Else
		CalculationParameters   = InitializeBasicCalculationParameters(WriteParameters.CalculationPeriod, WriteParameters.CalculationPeriod, Organization);
	EndIf;
	
	RegisterCalculationExecutionProblem(
		CalculationParameters,
		,
		IssueText,
		Refinement,
		Recorder);
	
EndProcedure

// Checks whether the generated register movements need to be recorded depending on the calculation option being performed.
//
Function NeedToWriteRegister(CalculationParameters, RegisterDescription)
	
	If Not RegisterDescription.ThereIsCostCalculation And Not RegisterDescription.ThereIsCalculationOfParties
	 And Not CalculationOfCostLocalization.ThisIsLocalizableInformationRegister(RegisterDescription.RegisterName)
	 And RegisterDescription.RegisterName <> Metadata.InformationRegisters.GoodsCost.Name Then
		// There may be registers in the serviced registers that do not generate settlement movements,
		// but some service actions for related mechanisms can be performed with these registers.
		// An example of such a register is an undeclared one, according to which the NDSUpr resource is filled in.
		// Also for the registers of cost details - they are recorded separately.
		Return False;
	ElsIf Not CalculationParameters.BatchCalculationStarted And CalculationParameters.PreliminaryCalculation
	 And RegisterDescription.RegisterName <> Metadata.InformationRegisters.GoodsCost.Name Then
		// In the preliminary calculation of the cost price, only the cost of goods is recalculated.
		// Movements in all other registers remain unchanged.
		Return False;
	EndIf;
	
	Return True;
	
EndFunction

// Records registers of VAT lot detail information.
//
Function WriteIndependentInformationRegister(CalculationParameters, RegisterDescription, NamesOfTablesToWrite, RecordingCorrectiveRegisteredRecords)
	
	SeparatorFieldName = "DocumentInflow";
	
	DataForProtocol = New Structure;
	DataForProtocol.Insert("RecordsCount",   0);
	DataForProtocol.Insert("NumberOfSets",   0);
	DataForProtocol.Insert("StartDateOfRecording",    CurrentSessionDate());
	
	NamesArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(NamesOfTablesToWrite);
	
	If NamesArray.Count() = 0 Then
		
		// We only need to clear the register of old records
		NameOfNewMovementTable = "";
		
	ElsIf NamesArray.Count() = 1 Then
		
		NameOfNewMovementTable = NamesOfTablesToWrite;
		
	Else
		
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Bắt đầu tạo bảng';
				|ru = 'Начало формирования таблицы';
				|en = 'Start table generation'; fa = 'Start table generation';
				|it = 'Начало формирования таблицы';
				|pl = 'Start table generation';
				|tr = 'Tablo oluşturma başlangıcı'") + "TTNewRegisterRegisteredRecords" + RegisterDescription.RegisterName);
		
		// Let's combine all the new adjustment movements and "other" movements of the cost calculation document.
		NameOfNewMovementTable = "TTNewRegisterRegisteredRecords" + RegisterDescription.RegisterName;
		
		MergeTemporaryTables(
			CalculationParameters,
			NamesOfTablesToWrite,
			NameOfNewMovementTable,
			RegisterDescription.FieldsOfMainRegisterTable,
			RegisterDescription.RegisterResources,
			"Organization," + SeparatorFieldName,
			True);
		
	EndIf;
	
	CostCalculationProtocol.AddRegisteredRecordedInformation(
		CalculationParameters,
		NStr("vi = 'Bắt đầu tạo bảng';
			|ru = 'Начало формирования таблицы';
			|en = 'Start table generation'; fa = 'Start table generation';
			|it = 'Начало формирования таблицы';
			|pl = 'Start table generation';
			|tr = 'Tablo oluşturma başlangıcı'") + " TTModifiedRecordSets");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	TemplateForSelectingNewRegisteredRecords = "
	|
	|	UNION ALL
	|
	|" + "
	|	 SELECT // new movements, with a plus
	|		TRUE AS ThereAreNewRegisteredRecords,
	|		CAST(1 AS NUMBER (15,0)) AS RecordsCount,
	|		&PlusCaseFields
	|	FROM
	|		TableOfNewRegisteredRecords AS T
	|	WHERE
	|		TRUE
	|		AND &SelectionByRecordTypeAdjustingEntries
	|";
	
	Query.Text =
	"SELECT
	|	&TextRequiredFields,
	|	SUM(T.RecordsCount) AS RecordsCount,
	|	MAX(T.ThereAreNewRegisteredRecords) AS ThereAreNewRegisteredRecords
	|INTO TTModifiedRecordSets
	|FROM
	|(SELECT
	|	&TextRequiredFields,
	|	SUM(T.RecordsCount) AS RecordsCount,
	|	&TextAmountOfResources,
	|	MAX(T.ThereAreNewRegisteredRecords) AS ThereAreNewRegisteredRecords
	|FROM
	|	(SELECT // old movements, with a minus
	|		FALSE AS ThereAreNewRegisteredRecords,
	|		0 AS RecordsCount,
	|		&CaseFieldsWithMinus
	|	FROM
	|		NameOfMainRegisterTable AS T
	|	WHERE
	|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND T.Organization IN (&CompanyArray)
	|		AND &SelectionByRecordTypeAdjustingEntries
	|		AND &TemplateForSelectingNewRegisteredRecords
	|	) AS T
	|
	|WHERE &FieldsGrouping
	|
	|) AS T
	|GROUP BY
	|	&TextRequiredFields
	|,&SelectingNonEmptyResources
	|";
	
	TextOfPlusCaseField   = "";
	CaseFieldTextWithMinus  = "";
	TextSelectionOfNonEmptyResources = "";
	TextAmountOfResources 		   = "";
	TextFieldGrouping 	   = "";
	
	FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(RegisterDescription.FieldsOfMainRegisterTable, "%1", "T."),
		",",
		True,
		True);
	ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(RegisterDescription.SelectionFieldsOfNonemptyMotions, "%1", "T."),
		",",
		True,
		True);
	
	For Each CurrentField In FieldArray Do
		
		ThisIsRegisterResource = (ArrayOfResources.Find(CurrentField) <> Undefined);
		
		If ThisIsRegisterResource Then
			
			If RecordingCorrectiveRegisteredRecords And Lower(CurrentField) = Lower("T.LotQuantity") Then
				Continue;
			EndIf;
			
			// Resource
			TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
				+ ?(TextSelectionOfNonEmptyResources = "", "", "
				|	  OR ") + CurrentField + " <> 0";
			
			TextAmountOfResources = TextAmountOfResources 
				+ ?(TextAmountOfResources = "", "", ",
				|	") + "SUM(" + CurrentField + ") AS " + StrReplace(CurrentField, "T.", "");
				
		Else
			// Measurement or props
			TextFieldGrouping = TextFieldGrouping 
				+ ?(TextFieldGrouping = "", "", ",
				|	") + CurrentField;
		EndIf;
		
		If RecordingCorrectiveRegisteredRecords Then
			
			TextOfPlusCaseField = TextOfPlusCaseField 
				+ ?(TextOfPlusCaseField = "", "", ",
				|		") + ?(ThisIsRegisterResource, "T.LotQuantity * ", "")
						   + ?(Lower(CurrentField) = Lower("T.Period"), "DATEADD(T.Period, SECOND, 1)", CurrentField);
			
			CaseFieldTextWithMinus = CaseFieldTextWithMinus 
				+ ?(CaseFieldTextWithMinus = "", "", ",
				|		") + ?(ThisIsRegisterResource, "-T.LotQuantity * ", "") + CurrentField;
			
		Else
			
			TextOfPlusCaseField = TextOfPlusCaseField 
				+ ?(TextOfPlusCaseField = "", "", ",
				|		") + CurrentField;
			
			CaseFieldTextWithMinus = CaseFieldTextWithMinus 
				+ ?(CaseFieldTextWithMinus = "", "", ",
				|		") + ?(ThisIsRegisterResource, "-", "") + CurrentField;
			
		EndIf;
		
		TextOfPlusCaseField = TextOfPlusCaseField + " AS " + StrReplace(CurrentField, "T.", "");
		CaseFieldTextWithMinus = CaseFieldTextWithMinus + " AS " + StrReplace(CurrentField, "T.", "");
		
	EndDo;
	
	TextFieldGrouping =  
		?(TextFieldGrouping = "", "", "GROUP BY
		|	") + TextFieldGrouping;
	TextSelectionOfNonEmptyResources =  
		?(TextSelectionOfNonEmptyResources = "", "", "HAVING
		|	MAX(CASE WHEN ") + TextSelectionOfNonEmptyResources + "
		|		THEN TRUE
		|		ELSE FALSE
		|	END) = TRUE";
	
	TextRequiredFields =
		"	T.Period,
		|	T.Organization,
		|	T.SeparatorFieldName,
		|	T.EntryType";
	TextRequiredFields = StrReplace(TextRequiredFields, "SeparatorFieldName", SeparatorFieldName);
	
	If Not ValueIsFilled(NameOfNewMovementTable) Then
		Query.Text = StrReplace(Query.Text, "AND &TemplateForSelectingNewRegisteredRecords", "");
	Else
		Query.Text = StrReplace(Query.Text, "AND &TemplateForSelectingNewRegisteredRecords", TemplateForSelectingNewRegisteredRecords);
		Query.Text = StrReplace(Query.Text, "TableOfNewRegisteredRecords", NameOfNewMovementTable);
	EndIf;
	
	If Not RegisterDescription.PeriodicRegister_ Then
		TextFieldGrouping = StrReplace(TextFieldGrouping, "T.RegistrationPeriod",
			"T.Period");
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "&TextRequiredFields", TextRequiredFields);
	Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", RegisterDescription.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "&CaseFieldsWithMinus",
		StringFunctionsClientServer.SubstituteParametersToString(CaseFieldTextWithMinus, "T."));
	Query.Text = StrReplace(Query.Text, "&PlusCaseFields",
		StringFunctionsClientServer.SubstituteParametersToString(TextOfPlusCaseField, "T."));
	Query.Text = StrReplace(Query.Text, "&TextAmountOfResources",
		StringFunctionsClientServer.SubstituteParametersToString(TextAmountOfResources, "T."));
	Query.Text = StrReplace(Query.Text, "WHERE &FieldsGrouping",
		StringFunctionsClientServer.SubstituteParametersToString(TextFieldGrouping, "T."));
	Query.Text = StrReplace(Query.Text, ",&SelectingNonEmptyResources",
		StringFunctionsClientServer.SubstituteParametersToString(TextSelectionOfNonEmptyResources, "T."));
	Query.Text = StrReplace(Query.Text, "AND &SelectionByRecordTypeAdjustingEntries",
		"And " + ?(RecordingCorrectiveRegisteredRecords, "", "NOT ") + "T.EntryType IN (&TypesOfDataConversionRecords)");
	
	If Not RegisterDescription.PeriodicRegister_ Then
		Query.Text = StrReplace(Query.Text, "AS RegistrationPeriod",
			"AS Period");
		Query.Text = StrReplace(Query.Text, "T.Period BETWEEN",
			"T.RegistrationPeriod BETWEEN");
		Query.Text = StrReplace(Query.Text, "T.LotQuantity * ",
			"");
	EndIf;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	
	NumberingParameters = GenerateParametersForNumberingRowsInTemporaryTable(
		"",
		"",
		"Period, Organization, " + SeparatorFieldName + ", EntryType",
		"SetNumber");
	
	FillInTemporaryTableRowNumbers(
		CalculationParameters,
		NumberingParameters,
		"TTModifiedRecordSets");
	
	RegisterDescription.ThereIsChangedData = (TemporaryTableSize(CalculationParameters, "TTModifiedRecordSets") > 0);
	
	WriteParameters = InitializeParametersForRecordingCalculationResults(
		CalculationParameters.PayrollPeriod.BeginOfPeriod,
		RegisterDescription,
		CalculationParameters.TaskNumberBeforeCalculation);
	
	WriteParameters.SeparatorFieldName = SeparatorFieldName;
	
	DescriptionOfRecordingErrors = "";
	NumberOfAdditionalWriteAttempts = 0;
	
	CostCalculationProtocol.AddRegisteredRecordedInformation(
		CalculationParameters,
		NStr("vi = 'Bắt đầu xóa tập hợp cũ';
			|ru = 'Начало очистки устаревших наборов';
			|en = 'Start clearing obsolete sets'; fa = 'Start clearing obsolete sets';
			|it = 'Начало очистки устаревших наборов';
			|pl = 'Start clearing obsolete sets';
			|tr = 'Eski kümelerin temizlenmesinin başlangıcı'"));
	
	// Let's clear the outdated record sets.
	Query.Text =
	"SELECT
	|	T.Period,
	|	T.Organization,
	|	T.SeparatorFieldName,
	|	T.EntryType
	|FROM
	|	TTModifiedRecordSets AS T
	|WHERE
	|	NOT T.ThereAreNewRegisteredRecords
	|
	|ORDER BY
	|	T.Period,
	|	T.Organization,
	|	T.SeparatorFieldName,
	|	T.EntryType";
	
	Query.Text = StrReplace(Query.Text, "SeparatorFieldName", SeparatorFieldName);
	
	Selection = Query.Execute().Select();
	RecordSet = InformationRegisters[RegisterDescription.RegisterName].CreateRecordSet();
	
	FieldNamePeriod = ?(RegisterDescription.PeriodicRegister_, "Period", "RegistrationPeriod");
	
	While Selection.Next() Do
		
		RecordSet.Filter[FieldNamePeriod].Set(Selection.Period);
		RecordSet.Filter.Organization.Set(Selection.Organization);
		RecordSet.Filter[SeparatorFieldName].Set(Selection[SeparatorFieldName]);
		RecordSet.Filter.EntryType.Set(Selection.EntryType);
		
		DataForProtocol.NumberOfSets = DataForProtocol.NumberOfSets + 1;
		
		WriteSetOfIndependentRegisterEntries(RecordSet, True, DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
		
	EndDo;
	
	If Not ValueIsFilled(NameOfNewMovementTable) Then
		Return DataForProtocol;
	EndIf;
	
	NumberOfFederalLaws = MaximumNumberOfRecordingTasks(CalculationParameters);
	
	If Not RecordingCorrectiveRegisteredRecords And NumberOfFederalLaws > 1 Then
		
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Bắt đầu tạo bảng';
				|ru = 'Начало формирования таблицы';
				|en = 'Start table generation'; fa = 'Start table generation';
				|it = 'Начало формирования таблицы';
				|pl = 'Start table generation';
				|tr = 'Tablo oluşturma başlangıcı'") + " TTInformationRegisterSelections");
	
		// Let's record new and modified record sets in the background.
		CostCalculationProtocol.StartCreatingTemporaryTable(
			CalculationParameters,
			"TTInformationRegisterSelections",
			NStr("vi = '(phân bổ cho các nhiệm vụ nền)';
				|ru = '(разделение на порции для фоновых заданий)';
				|en = '(division into portions for background jobs)'; fa = '(division into portions for background jobs)';
				|it = '(divisione in porzioni per le attività in background)';
				|pl = '(podział na porcje dla zadań w tle)';
				|tr = '(arka plan işleri için ayrıştırma)'", Common.DefaultLanguageCode()));
		
		Query.Text =
		"SELECT
		|	T.Period,
		|	T.Organization,
		|	T.SeparatorFieldName,
		|	T.EntryType,
		|	T.SetNumber,
		|	T.RecordsCount
		|INTO TTInformationRegisterSelections
		|FROM
		|	TTModifiedRecordSets AS T
		|WHERE
		|	T.ThereAreNewRegisteredRecords";
		
		Query.Text = StrReplace(Query.Text, "SeparatorFieldName", SeparatorFieldName);
		
		Query.Execute();
		
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Bắt đầu chia tách bảng thành các phần';
				|ru = 'Начало разделения таблицы на порции';
				|en = 'Start dividing tables into batches'; fa = 'Start dividing tables into batches';
				|it = 'Начало разделения таблицы на порции';
				|pl = 'Start dividing tables into batches';
				|tr = 'Tablo bölüştürmesinin başlangıcı'"));
	
		SeparationParameters = GenerateParametersForSplittingTemporaryTableIntoPortions(
			CalculationParameters.SamplingRestrictions.NumberOfVTZLines,
			"RecordsCount",
			"Period, Organization," + SeparatorFieldName + ", EntryType",
			"PortionNumber");
		
		MaxPortionNumber = DivideTemporaryTableIntoPortions(
			CalculationParameters,
			SeparationParameters,
			"TTInformationRegisterSelections",
			RegisterDescription.RegisterName);
			
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Bắt đầu tạo bảng';
				|ru = 'Начало формирования таблицы';
				|en = 'Start table generation'; fa = 'Start table generation';
				|it = 'Начало формирования таблицы';
				|pl = 'Start table generation';
				|tr = 'Tablo oluşturma başlangıcı'") + " TTPreparedDataForRecording");
	
		Query.Text =
		"SELECT
		|	Filter.PortionNumber AS PortionNumber,
		|	Filter.SetNumber,
		|	&RegisterFields
		|INTO TTPreparedDataForRecording
		|FROM
		|	TableOfNewRegisteredRecords AS T
		|	INNER JOIN TTInformationRegisterSelections AS Filter
		|		ON T.Period = Filter.Period
		|		AND T.Organization = Filter.Organization
		|		AND T.SeparatorFieldName = Filter.SeparatorFieldName
		|		AND T.EntryType = Filter.EntryType
		|INDEX BY
		|	PortionNumber
		|";
		
		Query.Text = StrReplace(Query.Text, "SeparatorFieldName", SeparatorFieldName);
		Query.Text = StrReplace(Query.Text, "&RegisterFields",
			StringFunctionsClientServer.SubstituteParametersToString(RegisterDescription.FieldsOfMainRegisterTable, "T."));
		Query.Text = StrReplace(Query.Text, "TableOfNewRegisteredRecords", NameOfNewMovementTable);
		
		If Not RegisterDescription.PeriodicRegister_ Then
			Query.Text = StrReplace(Query.Text, "T.Period = Filter.Period",
				"T.RegistrationPeriod = Filter.Period");
		EndIf;
		
		Query.Execute();
		
		CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
		
		If MaxPortionNumber < 1 Then
			
			DestroyTemporaryTables(CalculationParameters, "TTInformationRegisterSelections, TTPreparedDataForRecording");
			
			Return DataForProtocol;
			
		EndIf;
		
		Query.Text =
		"SELECT
		|	T.SetNumber,
		|	&RegisterFields
		|FROM
		|	TTPreparedDataForRecording AS T
		|WHERE
		|	T.PortionNumber = &PortionNumber
		|ORDER BY
		|	T.SetNumber";
		
		Query.Text = StrReplace(Query.Text, "&RegisterFields",
			StringFunctionsClientServer.SubstituteParametersToString(RegisterDescription.FieldsOfMainRegisterTable, "T."));
		
		NumberOfServingsPerTask = Int(MaxPortionNumber / NumberOfFederalLaws);
		If NumberOfServingsPerTask = 0 Then
			NumberOfServingsPerTask = MaxPortionNumber; // if there are not enough portions, then we write in one Federal Law
		EndIf;
		
		RegisterEntryParameters = InitializeParametersForRecordingCalculationResults(
			CalculationParameters.PayrollPeriod.BeginOfPeriod,
			RegisterDescription,
			CalculationParameters.TaskNumberBeforeCalculation);
		
		For PortionNumber = 1 To MaxPortionNumber Do
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Chuẩn bị phần tiếp theo của bản ghi kết chuyển';
					|ru = 'Подготовка очередной порции движений';
					|en = 'Prepare another batch of records'; fa = 'Prepare another batch of records';
					|it = 'Подготовка очередной порции движений';
					|pl = 'Prepare another batch of records';
					|tr = 'Sonraki hareket grubunun hazırlanması'"));
	
			Query.SetParameter("PortionNumber", PortionNumber);
			
			QueryResult = Query.Execute();
			
			CacheChunkOfDataForWriting(CalculationParameters, RegisterEntryParameters, QueryResult,,, False);
			
		EndDo;
		
		DestroyTemporaryTables(CalculationParameters, "TTInformationRegisterSelections, TTPreparedDataForRecording");
		
		// Let's run all the prepared recording tasks.
		If MaxPortionNumber >= 1 Then
			
			If CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry Then
				PutPieceOfDataOnStack(CalculationParameters, RegisterEntryParameters);
			Else
				RunRegisterEntryJob(CalculationParameters, RegisterEntryParameters);
			EndIf;
			
		EndIf;
		
	Else // single-threaded recording
		
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Bắt đầu ghi tập hợp của biểu ghi';
				|ru = 'Начало записи наборов регистра';
				|en = 'Start saving register sets'; fa = 'Start saving register sets';
				|it = 'Начало записи наборов регистра';
				|pl = 'Start saving register sets';
				|tr = 'Kayıt filtresi kayıtlarının başlangıcı'"));
	
		// Let's record new and modified record sets.
		Query.Text =
		"SELECT
		|	Filter.SetNumber,
		|	&RegisterFields
		|FROM
		|	TableOfNewRegisteredRecords AS T
		|	INNER JOIN TTModifiedRecordSets AS Filter
		|	ON &ConditionPeriod
		|		AND T.Organization = Filter.Organization
		|		AND T.SeparatorFieldName = Filter.SeparatorFieldName
		|		AND T.EntryType = Filter.EntryType
		|WHERE
		|	Filter.ThereAreNewRegisteredRecords
		|
		|ORDER BY
		|	Filter.SetNumber";
		
		Query.Text = StrReplace(Query.Text, "SeparatorFieldName", SeparatorFieldName);
		Query.Text = StrReplace(Query.Text, "&RegisterFields",
			StringFunctionsClientServer.SubstituteParametersToString(RegisterDescription.FieldsOfMainRegisterTable, "T."));
		Query.Text = StrReplace(Query.Text, "TableOfNewRegisteredRecords", NameOfNewMovementTable);
		Query.Text = StrReplace(Query.Text, "&ConditionPeriod",
			? (RecordingCorrectiveRegisteredRecords,
				"DATEADD(T.Period, SECOND, 1) = Filter.Period",
				"T.Period = Filter.Period"));
		
		If Not RegisterDescription.PeriodicRegister_ Then
			Query.Text = StrReplace(Query.Text, "T.Period =",
				"T.RegistrationPeriod =");
			Query.Text = StrReplace(Query.Text, "DATEADD(T.Period, SECOND, 1) = Filter.Period",
				"T.RegistrationPeriod = Filter.Period");
		EndIf;
		
		Selection = Query.Execute().Select();
		
		SetNumber = Undefined;
		FieldNamePeriod = ?(RegisterDescription.PeriodicRegister_, "Period", "RegistrationPeriod");
		
		While Selection.Next() Do
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Bắt đầu ghi tập hợp tiếp theo';
					|ru = 'Начало записи очередного набора';
					|en = 'Start saving another set'; fa = 'Start saving another set';
					|it = 'Начало записи очередного набора';
					|pl = 'Start saving another set';
					|tr = 'Sonraki küme kaydının başlangıcı'"));
		
			If RecordingCorrectiveRegisteredRecords Then
				If Not RegisterDescription.PeriodicRegister_ Then
					RecordPeriod = Selection[FieldNamePeriod];
				Else
					RecordPeriod = BegOfMonth(AddMonth(Selection[FieldNamePeriod], 1));
				EndIf;
			Else
				RecordPeriod = BegOfMonth(Selection[FieldNamePeriod]);
			EndIf;
			
			If Selection.SetNumber <> SetNumber Then
				
				If SetNumber <> Undefined Then
					
					DataForProtocol.RecordsCount = DataForProtocol.RecordsCount + RecordSet.Count();
					DataForProtocol.NumberOfSets = DataForProtocol.NumberOfSets + 1;
					
					WriteSetOfIndependentRegisterEntries(RecordSet, True, DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
					
				EndIf;
				
				SetNumber = Selection.SetNumber;
				
				RecordSet = InformationRegisters[RegisterDescription.RegisterName].CreateRecordSet();
				
				RecordSet.Filter[FieldNamePeriod].Set(RecordPeriod);
				RecordSet.Filter.Organization.Set(Selection.Organization);
				RecordSet.Filter[SeparatorFieldName].Set(Selection[SeparatorFieldName]);
				RecordSet.Filter.EntryType.Set(Selection.EntryType);
			
			EndIf;
			
			NewRecord = RecordSet.Add();
			FillPropertyValues(NewRecord, Selection);
			
			NewRecord[FieldNamePeriod] = RecordPeriod;
			
		EndDo;
		
		If SetNumber <> Undefined Then
			
			DataForProtocol.RecordsCount = DataForProtocol.RecordsCount + RecordSet.Count();
			DataForProtocol.NumberOfSets = DataForProtocol.NumberOfSets + 1;
			
			WriteSetOfIndependentRegisterEntries(RecordSet, True, DescriptionOfRecordingErrors, NumberOfAdditionalWriteAttempts, WriteParameters);
			
		EndIf;
		
	EndIf;
	
	If NumberOfAdditionalWriteAttempts > 0 Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã thử ghi lại các bản ghi kết chuyển của biểu ghi %1: %2';
				|ru = 'Выполнено дополнительных попыток записи движений регистра %1: %2';
				|en = 'Performed additional attempts of register records writing %1: %2'; fa = 'Performed additional attempts of register records writing %1: %2';
				|it = 'Sono stati eseguiti tentativi aggiuntivi di registrare i movimenti del registro %1: %2';
				|pl = 'Wykonano dodatkowych prób zapisywania ruchów rejestru %1: %2';
				|tr = 'Kayıt hareketlerini kaydetmek için ek denemeler yapıldı %1: %2'"),
			RecordSet.Metadata().FullName(),
			TrimAll(NumberOfAdditionalWriteAttempts));
		
		WriteLogEvent(
			EventLogEventName(Undefined, NStr("vi = 'Bản ghi kết chuyển';
												|ru = 'Запись движений';
												|en = 'Writing register records'; fa = 'Writing register records';
												|it = 'Scrittura dei movimenti';
												|pl = 'Nagrywanie ruchów';
												|tr = 'Hareket kaydı'", Common.DefaultLanguageCode())),
			EventLogLevel.Warning,,,
			ProtocolText_);
		
	EndIf;

	If Not IsBlankString(DescriptionOfRecordingErrors) Then
		
		If WriteParameters.Property("NotRaiseExceptionAtError") And WriteParameters.NotRaiseExceptionAtError Then
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
				TrimAll(DescriptionOfRecordingErrors));
		Else
			Raise ServiceSymbol_ProblemAlreadyRegistered() + DescriptionOfRecordingErrors; // all errors in recording the transmitted portion of movements
		EndIf;
		
	EndIf;
	
	Return DataForProtocol;
	
EndFunction

	
// Creates a temporary table wdeclaration the documents that had the "old" design movement.
//
Procedure CreateTableOfOldDocuments(CalculationParameters, RegisterDescription, Query, ForCleaningRegisteredRecords = False)
	
	CostCalculationProtocol.StartCreatingTemporaryTable(
		CalculationParameters,
		"TTCacheOldDocuments",
		NStr("vi = 'Biểu ghi';
			|ru = 'Регистр';
			|en = 'Register'; fa = 'ثبات';
			|it = 'Registro';
			|pl = 'Register';
			|tr = 'Kayıt'", Common.DefaultLanguageCode()) + ": " + RegisterDescription.RegisterName);
		
	SelectionByRegistrarType = "";
	
	If ForCleaningRegisteredRecords Then
		
		For Each KeyAndValue In RegisterDescription.RegistrarsWithDifferentPeriodsOrOrganizationsInRegisteredRecords Do
			If Not KeyAndValue.Value Then
				MetaDocument = KeyAndValue.Key; // MetadataObjectDocument
				SelectionByRegistrarType = SelectionByRegistrarType
					+ ?(SelectionByRegistrarType = "", "", " OR ")
					+ "(VALUETYPE(T.Recorder) = TYPE(Document." + MetaDocument.Name
					+ ") AND NOT (CAST(T.Recorder AS Document." + MetaDocument.Name
					+ ").DATE BETWEEN &BeginOfPeriod AND &EndOfPeriod))";
			EndIf;
		EndDo;
		
	EndIf;
	
	If ValueIsFilled(SelectionByRegistrarType) Then
		SelectionByRegistrarType = " AND NOT (" + SelectionByRegistrarType + ")";
	EndIf;
	
	// Let's select all the old registrars of this register (except doc. Adjustment of registers)
	// The Activity field is not checked.
	Query.Text =
	"SELECT DISTINCT
	|	T.Recorder
	|INTO TTCacheOldDocuments
	|FROM
	|	NameOfMainRegisterTable AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND NOT VALUETYPE(T.Recorder) IN
	|		(TYPE(Document.RegisterAdjustment),
	|		 TYPE(Document.CostCalculationRecorder))
	|	AND &FilterByCompany
	|	AND &SelectionByServiceDetails
	|	AND &SelectionByRegistrarType
	|
	|INDEX BY
	|	Recorder";
	
	Query.Text = StrReplace(Query.Text, "AND &SelectionByRegistrarType", SelectionByRegistrarType);
	
	// Selection - calculated movements
	If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name
	 And CalculationParameters.BatchCalculationStarted Then
		// All movements are calculated
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True);
	Else
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, False, True, True, True);
	EndIf;
	
	Query.Execute();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True);
	
EndProcedure

// Creates a temporary table Vtkashizmennyedocuments-documents that have changed the calculated movements.
//
Procedure CreateTableOfModifiedDocuments(CalculationParameters, RegisterDescription, Query)
	
	// Replacement templates in the request text
	TextSelectionOfNonEmptyResources 		 = "";
	TextFieldGrouping 	   		 = "";
	FieldTextOfMainRegisterTable = ""; // resources with a "minus"
	RegisterCacheFieldText 		     = ""; // resources with a "plus
	
	FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(RegisterDescription.RegisterCacheFields, "%1", "T."),
		",",
		True,
		True);
	ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(RegisterDescription.SelectionFieldsOfNonemptyMotions, "%1", "T."),
		",",
		True,
		True);
	
	TableFieldNumber = 0;
	
	For Each CurrentField In FieldArray Do
		
		ThisIsRegisterResource = (ArrayOfResources.Find(CurrentField) <> Undefined);
		
		If ThisIsRegisterResource Then
			// Resource
			TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
				+ ?(TextSelectionOfNonEmptyResources = "", "", "
				|	OR ") + "SUM(" + CurrentField + ") <> 0";
		Else
			// Measurement or props
			TextFieldGrouping = TextFieldGrouping 
				+ ?(TextFieldGrouping = "", "", ",
				|	") + CurrentField;
		EndIf;
		
		FieldTextOfMainRegisterTable = FieldTextOfMainRegisterTable 
			+ ?(FieldTextOfMainRegisterTable = "", "", ",
			|		") + ?(ThisIsRegisterResource, "-", "") + CurrentField;
	
		TextCurField = StrReplace(CurrentField, "T.", "");
		RegisterTable = RegisterDescription.Table; // ValueTable
		TableColumn2 = RegisterTable.Columns.Find(TextCurField);
		ColumnType 	   = CostCalculationUniversalAlgorithms.NonNullTypeDescriptions(TableColumn2.ValueType);
		TextEmptyValue = CostCalculationUniversalAlgorithms.PresentationOfEmptyTypeValueForQuery(ColumnType);
		
		TableFieldNumber = TableFieldNumber + 1;
		TableFieldNumberByString = Format(TableFieldNumber, "NZ=0; NG=");
		
		ArrayOfSuitableTypes = New Array;
		ArrayOfEmptyValues_ = New Array;
		
		NumberField = Not ThisIsRegisterResource And ColumnType.Types().Count() = 1 And ColumnType.Types()[0] = Type("Number")
			And ColumnType.NumberQualifiers.Digits > 0;
		
		For Each Current_Type In ColumnType.Types() Do
			
			ArrayOfSuitableTypes.Add(Current_Type);
			
			CurTypeDescription = New TypeDescription(TMCommonUseClientServer.Array(Current_Type, False));
			
			If Current_Type <> Type("Boolean") And Current_Type <> Type("Date") And Current_Type <> Type("String")
			 And Current_Type <> Type("Number") And Current_Type <> Type("UUID") Then
				ArrayOfEmptyValues_.Add(CurTypeDescription.AdjustValue(Undefined));
			EndIf;
			
		EndDo;
		
		If ColumnType.ContainsType(Type("AccumulationRecordType")) Then
			// In a request for fields of this type, the VALUE TYPE() method crashes with an error
			TextCurField =
				"	CASE WHEN T." + TextCurField + " <> VALUE(AccumulationRecordType.Receipt)
				|	  AND T." + TextCurField + " <> VALUE(AccumulationRecordType.Expense)
				|		THEN UNDEFINED
				|		ELSE T." + TextCurField + "
				|	END AS " + TextCurField;
		ElsIf NumberField Then
			LimitationOfBitDepth = ColumnType.NumberQualifiers.Digits - ColumnType.NumberQualifiers.FractionDigits - 1;
			MaxValue = Format(Pow(10, LimitationOfBitDepth) - 1, "NZ=0; NG=");
			TextCurField =
				"	CASE WHEN NOT VALUETYPE(T." + TextCurField + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
				|	  OR T." + TextCurField + " IN (&ArrayOfEmptyValues_" + TableFieldNumberByString + ")
				|		THEN " + TextEmptyValue + "
				|		WHEN T." + TextCurField + " > " + MaxValue + "
				|			THEN 0
				|		WHEN T." + TextCurField + " < -" + MaxValue + "
				|			THEN 0
				|		ELSE CAST(T." + TextCurField + " AS NUMBER("
					+ TrimAll(ColumnType.NumberQualifiers.Digits) + "," + TrimAll(ColumnType.NumberQualifiers.FractionDigits) + "))
				|	END AS " + TextCurField;
		ElsIf RegisterDescription.UntypedFields.Property(TextCurField) Then
			TextCurField =
				"	CASE WHEN NOT VALUETYPE(T." + TextCurField + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
				|		THEN " + TextEmptyValue + "
				|		ELSE T." + TextCurField + "
				|	END AS " + TextCurField;
		Else
			TextCurField =
				"	CASE WHEN NOT VALUETYPE(T." + TextCurField + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
				|	  OR T." + TextCurField + " IN (&ArrayOfEmptyValues_" + TableFieldNumberByString + ")
				|		THEN " + TextEmptyValue + "
				|		ELSE T." + TextCurField + "
				|	END AS " + TextCurField;
		EndIf;
		
		Query.SetParameter("ArrayOfSuitableTypes" + TableFieldNumberByString, ArrayOfSuitableTypes);
		Query.SetParameter("ArrayOfEmptyValues_" + TableFieldNumberByString,  ArrayOfEmptyValues_);
		
		RegisterCacheFieldText = RegisterCacheFieldText + ?(RegisterCacheFieldText = "", "", ",
			|		") + TextCurField;
		
	EndDo;
	
	// Replace the value of the field of the movement of the main register table with a Boolean value; resources with a "minus".
	ReplaceTrafficModeWithServiceMode(RegisterDescription, FieldTextOfMainRegisterTable);
	
	TextFieldGrouping =  
		?(TextFieldGrouping = "", "", "GROUP BY
		|	") + TextFieldGrouping;
	TextSelectionOfNonEmptyResources =  
		?(TextSelectionOfNonEmptyResources = "", "", "HAVING
		|	") + TextSelectionOfNonEmptyResources;
		
	// Let's take into account the features of the document of the distribution of the expenses of the upcoming periods:
	// for a document with a date that is in the calculation period, movements in different periods will be formed.
	// If the document date is outside the calculation period, then only movements from the calculation period will be added to the VTKASH from the IB.
	Query.Text =
	"SELECT
	|	T.Recorder AS Recorder
	|INTO TTDocumentsRBP
	|FROM
	|	TTCacheOldDocuments AS T
	|	INNER JOIN Document.DeferredExpensesAllocation AS Filter
	|		ON T.Recorder = Filter.Ref
	|WHERE
	|	Filter.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|INDEX BY
	|	Recorder";
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, NStr("vi = 'Biểu ghi';
																					|ru = 'Регистр';
																					|en = 'Register'; fa = 'ثبات';
																					|it = 'Registro';
																					|pl = 'Register';
																					|tr = 'Kayıt'", Common.DefaultLanguageCode()) + ": " + RegisterDescription.RegisterName);
	
	ThereAreDocumentsRBP = TemporaryTableSize(CalculationParameters, "TTDocumentsRBP") > 0;
	
	// The choice of registrars who have at least some differences in the old and new movements
	// The movements of only these recorders will be overwritten

	// and only these registrars will be registered to generate transactions
	Query.Text = "
	|SELECT // new calculated movements, with a plus
	|	&RegisterCacheFields
	|INTO TTModifiedRegisteredRecordsPreliminary
	|FROM
	|	RegisterCacheTableName AS T
	|
	|UNION ALL
	|
	|SELECT // old calculated movements, with a minus
	|	&FieldsOfMainRegisterTable
	|FROM
	|	NameOfMainRegisterTable AS T
	|	INNER JOIN TTCacheOldDocuments AS OldDocuments
	|		ON T.Recorder = OldDocuments.Recorder
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND &FilterByCompany
	|	AND &SelectionByServiceDetails
	|	AND &RBPSupplement
	|
	|INDEX BY
	|	Recorder
	|;
	|/////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	&OrganizationField,
	|	T.Period AS Period,
	|	T.Recorder AS Recorder
	|INTO TTModifiedRegisteredRecords
	|FROM
	|	TTModifiedRegisteredRecordsPreliminary AS T
	|WHERE &FieldsGrouping
	|
	|AND &SelectingNonEmptyResources
	|
	|INDEX BY
	|	Recorder
	|";
	If RegisterDescription.ThereIsACompany Then
		OrganizationFieldText = "T.Organization AS Organization";
	ElsIf RegisterDescription.ThereAreAnalyticsPartners Then 
		OrganizationFieldText = "T.AccountingDimensionByPartners.Organization AS Organization";	
	Else		
		OrganizationFieldText = "VALUE(Catalog.Companies.EmptyRef) AS Organization";
	EndIf;
	Query.Text = StrReplace(Query.Text, "&OrganizationField", OrganizationFieldText);
	
	TextTTCacheModifiedDocumentsForReflection = "
	|;
	|/////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization 	AS Organization,
	|	T.Period 		AS Period,
	|	T.Recorder 	AS Recorder
	|INTO TTCacheModifiedDocumentsForReflection
	|FROM
	|	TTModifiedRegisteredRecords AS T
	|";
	
	ArrayOfTexts = New Array;
	ArrayOfTexts.Add(Query.Text);
	ArrayOfTexts.Add(TextTTCacheModifiedDocumentsForReflection);
	Query.Text = StrConcat(ArrayOfTexts);
	If ThereAreDocumentsRBP Then
		
		RBPTemplate = "
		|
		|	UNION ALL
		|" + "
		|	SELECT // old calculated movements, with a minus
		|		&FieldsOfMainRegisterTable
		|	FROM
		|		NameOfMainRegisterTable AS T
		|			INNER JOIN TTDocumentsRBP AS OldDocuments
		|			ON T.Recorder = OldDocuments.Recorder
		|	WHERE
		|		NOT (T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod)
		|		AND &FilterByCompany
		|		AND &SelectionByServiceDetails
		|";
		
	Else
		RBPTemplate = "";
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "AND &RBPSupplement", RBPTemplate);
	
	// Replace the templates in the request text
	Query.Text = StrReplace(Query.Text, "&RegisterCacheFields",			 RegisterCacheFieldText);
	Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
	Query.Text = StrReplace(Query.Text, "WHERE &FieldsGrouping",		 TextFieldGrouping);
	Query.Text = StrReplace(Query.Text, "AND &SelectingNonEmptyResources",	 TextSelectionOfNonEmptyResources);
	
	// Selection - calculated movements
	If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name
	 And CalculationParameters.BatchCalculationStarted Then
		// All movements are calculated
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True);
	Else
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, False, True, True, True);
	EndIf;
	
	If RegisterDescription.ThereIsACompany And Not RegisterDescription.OrganizationRequired_ Then
		Query.Text = StrReplace(Query.Text, "(&CompanyArray)", "(&CompanyArray, VALUE(Catalog.Companies.EmptyRef))");
	EndIf;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, NStr("vi = 'Biểu ghi';
																					|ru = 'Регистр';
																					|en = 'Register'; fa = 'ثبات';
																					|it = 'Registro';
																					|pl = 'Register';
																					|tr = 'Kayıt'", Common.DefaultLanguageCode()) + ": " + RegisterDescription.RegisterName);
	
	CostCalculationProtocol.StartCreatingTemporaryTable(
		CalculationParameters,
		"TTCacheModifiedDocuments",
		NStr("vi = 'Biểu ghi';
			|ru = 'Регистр';
			|en = 'Register'; fa = 'ثبات';
			|it = 'Registro';
			|pl = 'Register';
			|tr = 'Kayıt'", Common.DefaultLanguageCode()) + ": " + RegisterDescription.RegisterName);
	
	GenerateTableOfPointsInTime(
		CalculationParameters,
		"TTModifiedRegisteredRecords",
		,
		"TTCacheModifiedDocuments");
		
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True);
	
	DestroyTemporaryTables(CalculationParameters, "TTDocumentsRBP, TTModifiedRegisteredRecordsPreliminary, TTModifiedRegisteredRecords");
	If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name Then
		GenerateTasksForCalculatingCostOfVNA(CalculationParameters);
	EndIf;
EndProcedure

// Creates a temporary table for the movement of other periods or organizations - the movement of modified documents by
// periods or organizations that are not included in the calculation parameters.
//
Procedure CreateTableOfRegisteredRecordsOfOtherPeriodsOrOrganizations(CalculationParameters, RegisterDescription, Query)
	
	SelectionByRegistrarType = "";
	SaveOnlyPrimaryRegisteredRecords = "";
	
	For Each KeyAndValue In RegisterDescription.RegistrarsWithDifferentPeriodsOrOrganizationsInRegisteredRecords Do
		
		MetaDocument = KeyAndValue.Key; // MetadataObjectDocument
		
		SelectionByRegistrarType = SelectionByRegistrarType
			+ ?(SelectionByRegistrarType = "", "", ", ") + "TYPE(Document."
			+ MetaDocument.Name + ")";
		
		If Not KeyAndValue.Value Then
			SaveOnlyPrimaryRegisteredRecords = SaveOnlyPrimaryRegisteredRecords
				+ ?(SaveOnlyPrimaryRegisteredRecords = "", "", ", ") + "TYPE(Document."
				+ MetaDocument.Name + ")";
		EndIf;
		
	EndDo;
	
	ThereMayBeRegisteredRecordsForOtherPeriodsOrOrganizations = ValueIsFilled(SelectionByRegistrarType);
	
	If ThereMayBeRegisteredRecordsForOtherPeriodsOrOrganizations Then
		
		// According to this register, there are registrars with movements for other periods and/or organizations.
		// Let's save such movements in the time table of the movements of other periods or organizations.
		
		If RegisterDescription.ThereIsACompany Then
			FilterByCompany = "OR (NOT (T.Organization IN (&CompanyArray))";
			If Not RegisterDescription.OrganizationRequired_ Then
				FilterByCompany = FilterByCompany + " AND T.Organization <> VALUE(Catalog.Companies.EmptyRef)";
			EndIf;
			FilterByCompany = FilterByCompany + ")";
		ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
			FilterByCompany = "OR NOT (T.AccountingDimensionByPartners IN (SELECT Filter.DimensionKey FROM TTPartnerAnalyticsSelection AS Filter))";
		Else
			FilterByCompany = "";
		EndIf;
		
		If ValueIsFilled(SaveOnlyPrimaryRegisteredRecords) Then
			SelectionByTypeOfRegisteredRecords = "AND NOT (VALUETYPE(T.Recorder) IN (" + SaveOnlyPrimaryRegisteredRecords + ") AND (ModifiedDocuments.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod) AND &SelectionByServiceDetails)";
		Else
			SelectionByTypeOfRegisteredRecords = "";
		EndIf;
		
		Query.Text =
		"SELECT
		|	T.Recorder,
		|	T.Date
		|INTO TTSelectionByRegistrars
		|FROM
		|	TTCacheModifiedDocuments AS T
		|WHERE
		|	VALUETYPE(T.Recorder) IN (&SelectionByRegistrarType)
		|INDEX BY
		|	Recorder
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|SELECT
		|	&FieldsOfMainRegisterTable
		|INTO TTMovementCacheOfOtherPeriodsOrOrganizations
		|FROM
		|	NameOfMainRegisterTable AS T
		|		INNER JOIN TTSelectionByRegistrars AS ModifiedDocuments
		|		ON T.Recorder = ModifiedDocuments.Recorder
		|WHERE
		|	(NOT (T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod)
		|	AND &FilterByCompany)
		|	AND &SelectionByTypeOfRegisteredRecords
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|DROP TTSelectionByRegistrars
		|";
		
		// Replace the templates in the request text
		Query.Text = StrReplace(Query.Text, "&SelectionByRegistrarType", SelectionByRegistrarType);
		Query.Text = StrReplace(Query.Text, "AND &FilterByCompany",      FilterByCompany);
		Query.Text = StrReplace(Query.Text, "AND &SelectionByTypeOfRegisteredRecords",     SelectionByTypeOfRegisteredRecords);
		
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query,, False, True, True); // register name templates
		
	Else
		
		// According to this register, there can be no registrars with movements for other periods and/or organizations.
		// Create an empty temporary table with fields identical to the register fields.
		
		Query.SetParameter("EmptyRegisterTable", RegisterDescription.RegisterManager.CreateRecordSet().Unload());
		
		Query.Text =
		"SELECT
		|	&FieldsOfMainRegisterTable
		|INTO TTMovementCacheOfOtherPeriodsOrOrganizations
		|FROM
		|	&EmptyRegisterTable AS T";
		
	EndIf;
	
	// Replace the templates in the request text
	FieldTextOfMainRegisterTable = TrimAll(StrReplace(RegisterDescription.FieldsOfMainRegisterTable, "%1", "
		|		T."));
	Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
		
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, NStr("vi = 'Biểu ghi';
																					|ru = 'Регистр';
																					|en = 'Register'; fa = 'ثبات';
																					|it = 'Registro';
																					|pl = 'Register';
																					|tr = 'Kayıt'", Common.DefaultLanguageCode()) + ": " + RegisterDescription.RegisterName);
	
EndProcedure

// Creates a temporary table Vtkashochistaemyedocuments-documents that do not have any calculated movements left.
//
Procedure CreateTableOfClearedDocuments(CalculationParameters, RegisterDescription, Query)
	
	// Let's choose registrars who (by And)
	// - have only old cost calculation movements (no "primary movements")
	// - no new cost calculation movements
	// - there are no movements for other periods and/or organizations
	// - they are not exceptions (which have calculated movements not in the document period)
	// For such documents, you just need to clear their movements - write down an empty set.
	
	SelectionByRegistrarType = "";
	For Each KeyAndValue In RegisterDescription.RegistrarsWithDifferentPeriodsOrOrganizationsInRegisteredRecords Do
		If Not KeyAndValue.Value Then
			MetaDocument = KeyAndValue.Key; // MetadataObjectDocument
			SelectionByRegistrarType = SelectionByRegistrarType
				+ ?(SelectionByRegistrarType = "", "", " OR ")
				+ "(VALUETYPE(T.Recorder) = TYPE(Document." + MetaDocument.Name
				+ ") AND NOT (CAST(T.Recorder AS Document." + MetaDocument.Name
				+ ").DATE BETWEEN &BeginOfPeriod AND &EndOfPeriod))";
		EndIf;
	EndDo;
	
	If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name Then
		NonTemporaryBalanceRecords =
			"T.SourceKind <> VALUE(Enum.MovementSourcesKinds.BalanceCalculation)";
	Else
		NonTemporaryBalanceRecords = "TRUE";
	EndIf;
	
	If Not ValueIsFilled(SelectionByRegistrarType) Then
		SelectionByRegistrarType = "FALSE";
	EndIf;
	
	Query.Text =
	"SELECT DISTINCT
	|	T.Recorder AS Recorder
	|INTO TTDocumentsWithNewRegisteredRecords
	|FROM
	|	RegisterCacheTableName AS T
	|
	|UNION
	|
	|SELECT DISTINCT
	|	T.Recorder
	|FROM
	|	TTMovementCacheOfOtherPeriodsOrOrganizations AS T
	|
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.Recorder AS Recorder
	|INTO TTDocumentsWithoutNewRegisteredRecords
	|FROM
	|	TTCacheModifiedDocuments AS T
	|		LEFT JOIN TTDocumentsWithNewRegisteredRecords AS DocumentsWithNewRegisteredRecords
	|		ON T.Recorder = DocumentsWithNewRegisteredRecords.Recorder
	|WHERE
	|	DocumentsWithNewRegisteredRecords.Recorder IS NULL
	|
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	T.Recorder AS Recorder
	|INTO TTDocumentsWithPrimaryOrStoredRegisteredRecords
	|FROM
	|	NameOfMainRegisterTable AS T
	|		INNER JOIN TTDocumentsWithoutNewRegisteredRecords AS DocumentsWithoutNewRegisteredRecords
	|		ON T.Recorder = DocumentsWithoutNewRegisteredRecords.Recorder
	|
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND &NonTemporaryBalanceRecords
	|	AND &SelectionByServiceDetails
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	T.Recorder AS Recorder
	|FROM
	|	NameOfMainRegisterTable AS T
	|		INNER JOIN TTDocumentsWithoutNewRegisteredRecords AS DocumentsWithoutNewRegisteredRecords
	|		ON T.Recorder = DocumentsWithoutNewRegisteredRecords.Recorder
	|
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND (&SelectionByRegistrarType)
	|
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.Recorder AS Recorder
	|INTO TTCacheClearedDocuments
	|FROM
	|	TTDocumentsWithoutNewRegisteredRecords AS T
	|		LEFT JOIN TTDocumentsWithPrimaryOrStoredRegisteredRecords AS DocumentsWithPrimaryOrPersistedRegisteredRecords
	|		ON T.Recorder = DocumentsWithPrimaryOrPersistedRegisteredRecords.Recorder
	|WHERE
	|	DocumentsWithPrimaryOrPersistedRegisteredRecords.Recorder IS NULL
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP TTDocumentsWithNewRegisteredRecords
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP TTDocumentsWithoutNewRegisteredRecords
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP TTDocumentsWithPrimaryOrStoredRegisteredRecords";
	
	// Selection - primary movements
	ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, , True, False, False);
	
	Query.Text = StrReplace(Query.Text, "&NonTemporaryBalanceRecords", NonTemporaryBalanceRecords);
	Query.Text = StrReplace(Query.Text, "&SelectionByRegistrarType", SelectionByRegistrarType);
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, NStr("vi = 'Biểu ghi';
																					|ru = 'Регистр';
																					|en = 'Register'; fa = 'ثبات';
																					|it = 'Registro';
																					|pl = 'Register';
																					|tr = 'Kayıt'", Common.DefaultLanguageCode()) + ": " + RegisterDescription.RegisterName);
	
EndProcedure


// Debugging procedure-clearing all movements generated by the previous calculation.
// It can take quite a long time to run, so it is recommended only for debugging purposes.
//
Procedure ClearOldCostCalculationRegisteredRecords(CalculationParameters)
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "ClearOldCostCalculationRegisteredRecords");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	WriteParameters = InitializeRecordingParameters(
		CalculationParameters.PayrollPeriod.BeginOfPeriod,
		CalculationParameters.TaskNumberBeforeCalculation);
	
	For Each KeyAndValue In CalculationParameters.RegisterRecords Do
		
		RegisterDescription = KeyAndValue.Value;
		
		If Not RegisterDescription.SubordinateToRegistrar Then
			Continue;
		EndIf;
		
		If Not RegisterDescription.ThereIsCostCalculation And Not RegisterDescription.ThereIsCalculationOfParties
		 And Not CalculationOfCostLocalization.ThisIsLocalizableInformationRegister(RegisterDescription.RegisterName)
		 And RegisterDescription.RegisterName <> Metadata.InformationRegisters.GoodsCost.Name Then
			Continue; // see the comment in the need to write down the register()
		EndIf;
		
		// We will form Vtkashstaryedocuments
		CreateTableOfOldDocuments(CalculationParameters, RegisterDescription, Query, True);
		
		// We will form vtkashizmennyedocuments
		CreateTableOfModifiedDocuments(CalculationParameters, RegisterDescription, Query);
		DestroyTemporaryTables(CalculationParameters, "TTCacheModifiedDocumentsForReflection");
		// Let's form a VTCASH movement of other periods or organizations
		CreateTableOfRegisteredRecordsOfOtherPeriodsOrOrganizations(CalculationParameters, RegisterDescription, Query);
		
		// Let's form the cachecashable documents
		CreateTableOfClearedDocuments(CalculationParameters, RegisterDescription, Query);
		
		// We will prepare data for cleaning the movements of documents that do not have primary movements
		Query.Text =
		"SELECT
		|	*
		|FROM
		|	TTCacheClearedDocuments AS T";
		
		RecordRegisteredRecordsByRegister(
			Query,
			RegisterDescription.RegisterManager,
			WriteParameters);
		
		// Replacement templates in the request text
		FieldTextOfMainRegisterTable = TrimAll(StrReplace(RegisterDescription.FieldsOfMainRegisterTable, "%1", "
			|		T."));
		RegisterCacheFieldText 		     = TrimAll(StrReplace(RegisterDescription.RegisterCacheFields, "%1", "
			|		T."));
		ReplaceTrafficViewWithPlatformView(RegisterDescription, RegisterCacheFieldText);
		
		TextOfSortField = TrimAll(StrReplace(RegisterDescription.RegisterDimensions, "%1", "
			|		T."));
		TextOfSortField = "T.Recorder, T.Period"
			+ ?(TextOfSortField = "", "", ", ") + TextOfSortField
			+ ?(RegisterDescription.ThereIsCostCalculation, ", T.CalculationOfCost", "")
			+ ?(RegisterDescription.ThereIsCalculationOfParties, 		  ", T.LotCalculation", "");
		
		// Preparation of movements for those registrars for which there are differences in old/new movements - we combine
		//	- "primary" document movements in the calculation period
		//	- unreadable document movements.
		Query.Text =
		"SELECT
		|	&FieldsOfMainRegisterTable
		|FROM
		|	NameOfMainRegisterTable AS T
		|		INNER JOIN TTCacheModifiedDocuments AS ModifiedDocuments
		|		ON T.Recorder = ModifiedDocuments.Recorder
		|WHERE
		|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
		|	AND &FilterByCompany
		|	AND &SelectionByServiceDetails
		|
		|UNION ALL
		|
		|SELECT
		|	&FieldsOfMainRegisterTable
		|FROM
		|	TTMovementCacheOfOtherPeriodsOrOrganizations AS T
		|
		|ORDER BY
		|	&Order";
		
		// Replace the templates in the request text
		Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
		Query.Text = StrReplace(Query.Text, "&Order", 					 TextOfSortField);
		
		// Selection - primary movements
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False);
		
		RecordRegisteredRecordsByRegister(
			Query,
			RegisterDescription.RegisterManager,
			WriteParameters);
		
		DestroyTemporaryTables(CalculationParameters,
			"TTCacheOldDocuments, TTCacheModifiedDocuments, TTMovementCacheOfOtherPeriodsOrOrganizations, TTCacheClearedDocuments");
		
	EndDo;
	
EndProcedure


#Region RecordingRegisteredRecordsInBackground

// Starts a new task for multithreaded recording of Registered Records from the data stack for recording.
// The call to this procedure should be performed, among other things, during the execution of the calculation,
// in order to try to record the Registered Recorded movements placed on the stack by the Pre-recording procedure of the generated movements().
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//  ExpectToFreeUpStackSpace - Boolean - be sure to run the following task
//
Procedure RunNextWriteJobFromStack(CalculationParameters, ExpectToFreeUpStackSpace = False) Export
	
	If Not CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry
	 Or CalculationParameters.Debug.DisableRecordingGeneratedRegisteredRecords
	 Or CalculationParameters.DataStackForWriting.Count() = 0 Then
		Return;
	EndIf;
	
	StartRecording = True;
	
	While StartRecording And CalculationParameters.DataStackForWriting.Count() > 0 Do
		
		RegisterEntryParameters = CalculationParameters.DataStackForWriting[0];
		RegisterEntryParameters.Insert("ExpectToFreeUpStackSpace", ExpectToFreeUpStackSpace);
		
		StartRecording = RunRegisterEntryJob(CalculationParameters, RegisterEntryParameters);
		
		If StartRecording Then
			CalculationParameters.DataStackForWriting.Delete(0);
		EndIf;
		
	EndDo;
	
EndProcedure

// Starts a new multithreaded motion recording task.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
// 	RegisterEntryParameters - Structure - motion recording parameters
//	RecordingCorrectiveRegisteredRecords - Boolean - indicates whether correction movements are recorded before the calculation starts
//	RecordingRegisteredRecordsOutsideCalculation - Boolean - flag for recording movements after calculation, by external processing
//
// Returns:
//	Boolean - indicates that the task is running
//
Function RunRegisterEntryJob(CalculationParameters, RegisterEntryParameters, RecordingCorrectiveRegisteredRecords = False, RecordingRegisteredRecordsOutsideCalculation = False) Export
	
	If Not RecordingRegisteredRecordsOutsideCalculation Then
		
		If CalculationParameters.Debug.DisableRecordingGeneratedRegisteredRecords
		 And Not RecordingCorrectiveRegisteredRecords Then
			Return False;
		EndIf;
		
		If RegisterEntryParameters.BatchesCount = 0
		 Or RegisterEntryParameters.NumberOfFirstPortion > RegisterEntryParameters.BatchesCount Then
			Return False;
		EndIf;
		
		If RegisterEntryParameters.Property("ExpectToFreeUpStackSpace") Then
			ExpectToFreeUpStackSpace = RegisterEntryParameters.ExpectToFreeUpStackSpace;
		Else
			ExpectToFreeUpStackSpace = True;
		EndIf;
		
		// If there are a lot of unfinished Registered Recorded tasks, then we will wait until at least one is completed (or make sure that they are still active).
		IsJobCompleted = WaitForWriteJobsToComplete(CalculationParameters,, ExpectToFreeUpStackSpace);
		
		If Not ExpectToFreeUpStackSpace And Not IsJobCompleted Then
			Return False; // the job stack is full, all jobs are still active
		EndIf;
		
	EndIf;
	
	// We will prepare and launch a new recording task.
	PreviousTask_ = Undefined;
	CalculationParameters.TotalNumberOfFederalLawEntries = CalculationParameters.TotalNumberOfFederalLawEntries + 1;
	
	TaskHandlerParameters = New Array;
	TaskHandlerParameters.Add(RegisterEntryParameters); // recording parameters
	
	JobKey = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Nhiệm vụ nền số %1 -  %2 (%3)';
			|ru = 'ФЗ №%1 - %2 (%3)';
			|en = 'FZ No.%1 - %2 (%3)'; fa = 'FZ No.%1 - %2 (%3)';
			|it = 'FS №%1 - %2 (%3)';
			|pl = 'UF nr%1 - %2 (%3)';
			|tr = 'FY №%1 - %2 (%3)'", Common.DefaultLanguageCode()),
		TrimAll(CalculationParameters.TotalNumberOfFederalLawEntries),
		RegisterEntryParameters.RegisterName,
		TrimAll(RegisterEntryParameters.CalculationID));
	
	JobDetails = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = '%1, bản ghi của biểu ghi %2.';
			|ru = '%1, запись регистра %2.';
			|en = '%1, register record %2.'; fa = '%1, register record %2.';
			|it = '%1, registrazione %2.';
			|pl = '%1, wpis rejestru %2.';
			|tr = '%1, kayıt kaydı %2.'", Common.DefaultLanguageCode()),
		TrimAll(CalculationParameters.CalculationOption),
		TrimAll(RegisterEntryParameters.RegisterName));

	// Let's run the task and remember its ID in the stack and the general table of record tasks.
	NewJob = MonthEndTransactionsServer.StartSubordinateBackgroundTaskOfCalculationStage(
		CalculationParameters.CalculationIDForClosingMonth,
		"CostCalculationAppliedAlgorithms.RecordRegisteredRecordsByRegisterAsBackgroundTask",
		TaskHandlerParameters,
		JobKey,
		JobDetails);
	
	CalculationParameters.StackOfWriteJobs.Add(NewJob.UUID);
	
	LastRow = CalculationParameters.RecordJobTable.Add();
	LastRow.JobID = NewJob.UUID;
	LastRow.PreviousTask_ 	 = PreviousTask_;
	LastRow.RegisterName 		 = RegisterEntryParameters.RegisterName;
	LastRow.NumberOfRegisteredRecords	 = RegisterEntryParameters.RecordsCount;
	LastRow.CalculationID = RegisterEntryParameters.CalculationID;
	LastRow.BatchesCount 	 = RegisterEntryParameters.BatchesCount;
	LastRow.NumberOfFirstPortion 	 = RegisterEntryParameters.NumberOfFirstPortion;
	LastRow.WriteParameters 	 = New ValueStorage(RegisterEntryParameters, New Deflation(9));
	
	CostCalculationProtocol.AddRegisteredRecordedInformation(
		CalculationParameters,
		NStr("vi = 'Đã khởi động nhiệm vụ ghi';
			|ru = 'Запущено задание записи';
			|en = 'Saving job is started'; fa = 'Saving job is started';
			|it = 'Запущено задание записи';
			|pl = 'Saving job is started';
			|tr = 'Kayıt görevi başlatıldı'") + " " + JobKey + ", "
			+ NStr("vi = 'nhiệm vụ đang hoạt động';
					|ru = 'активных заданий';
					|en = 'active jobs'; fa = 'active jobs';
					|it = 'активных заданий';
					|pl = 'active jobs';
					|tr = 'aktif görevler'") + ": " + TrimAll(CalculationParameters.StackOfWriteJobs.Count()) + ", "
			+ NStr("vi = 'đợi khởi động';
					|ru = 'ожидает запуска';
					|en = 'awaits start'; fa = 'awaits start';
					|it = 'ожидает запуска';
					|pl = 'awaits start';
					|tr = 'başlatma bekleniyor'") + ": " + TrimAll(Max(CalculationParameters.DataStackForWriting.Count() - 1, 0)));
	
	Return True;
	
EndFunction

Procedure CacheChunkOfDataForWriting(CalculationParameters, RegisterEntryParameters, Data,
			ThisIsPortionOfCleaning = False, ThisIsPortionOfSupplement = False, PutItOnStack = True)
	
	BeginTime = CurrentUniversalDateInMilliseconds();
	
	UseDataStackToWrite = CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry
		And Not CalculationParameters.Debug.DisableRecordingGeneratedRegisteredRecords
		And PutItOnStack;
	
	CostCalculationProtocol.AddRegisteredRecordedInformation(
		CalculationParameters,
		NStr("vi = 'Việc lưu trữ tạm thời phần dữ liệu tiếp theo để ghi, đang chờ khởi động';
			|ru = 'Кэширование очередной порции данных для записи, ожидает запуска';
			|en = 'Caching another batch of data for saving, awaits start'; fa = 'Caching another batch of data for saving, awaits start';
			|it = 'Кэширование очередной порции данных для записи, ожидает запуска';
			|pl = 'Caching another batch of data for saving, awaits start';
			|tr = 'Kaydedilecek sonraki veri kümesi önbelleğe alınıyor, başlatma bekleniyor'") + ": "
			+ TrimAll(CalculationParameters.DataStackForWriting.Count() + ?(UseDataStackToWrite, 1, 0)));
		
	If TypeOf(Data) = Type("QueryResult") Then
		DataTable = Data.Unload();
	Else
		DataTable = Data;
	EndIf;
	
	RegisterEntryParameters.BatchesCount = RegisterEntryParameters.BatchesCount + 1;
	
	If ThisIsPortionOfCleaning Then
		RegisterEntryParameters.CleaningPortions.Add(RegisterEntryParameters.BatchesCount);
	ElsIf ThisIsPortionOfSupplement Then
		RegisterEntryParameters.SupplementServings.Add(RegisterEntryParameters.BatchesCount);
	EndIf;
	
	RegisterRecord = InformationRegisters.LotAccountingDataCache.CreateRecordManager();
	RegisterRecord.CalculationID = RegisterEntryParameters.CalculationID;
	RegisterRecord.DataType 			= Enums.DataTypesInLotAccountingCache.CalculationResult2;
	RegisterRecord.DataPortionNumber 	= RegisterEntryParameters.BatchesCount;
	RegisterRecord.VersionNumber 			= TrimAll(Metadata.Version);
	RegisterRecord.RecordDate			= CurrentSessionDate();
	RegisterRecord.Comment			= NStr("vi = 'Bản ghi kết chuyển';
											|ru = 'Запись движений';
											|en = 'Writing register records'; fa = 'Writing register records';
											|it = 'Scrittura dei movimenti';
											|pl = 'Nagrywanie ruchów';
											|tr = 'Hareket kaydı'", Common.DefaultLanguageCode()) + " - " + RegisterEntryParameters.RegisterName;
	RegisterRecord.Data 				= New ValueStorage(DataTable, New Deflation(9));
	
	RegisterRecord.Write(True);
	
	PreparationTime = CurrentUniversalDateInMilliseconds() - BeginTime;
	RegisterEntryParameters.DataPreparationTime = RegisterEntryParameters.DataPreparationTime + PreparationTime;
	
	CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
		CalculationParameters,
		RegisterEntryParameters.RegisterName,,,
		PreparationTime/1000);
	
	If Not ThisIsPortionOfCleaning Then
		
		CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
			CalculationParameters,
			RegisterEntryParameters.RegisterName,
			,
			DataTable.Count());
			
		RegisterEntryParameters.RecordsCount = RegisterEntryParameters.RecordsCount + DataTable.Count();
		
		// Let's check the correctness of the formation of portions of the record.
		If CalculationParameters.Debug.MonitorVfzRegistrars And Not ThisIsPortionOfSupplement
		 And DataTable.Columns.Find("Recorder") <> Undefined Then
		
			TableOfLoggers = DataTable.Copy(, "Recorder");
			TableOfLoggers.GroupBy("Recorder", "");
			
			For Each CurrRow In TableOfLoggers Do
				VfzRegistrars = CalculationParameters.Debug.VfzRegistrars; //ValueTable
				NwRw = VfzRegistrars.Add();
				NwRw.RegisterName = RegisterEntryParameters.RegisterName;
				NwRw.Recorder = CurrRow.Recorder;
				NwRw.Count = 1;
			EndDo;
			
		EndIf;
		
	EndIf;
	
	If UseDataStackToWrite Then
		CalculationParameters.DataStackForWriting.Add(RegisterEntryParameters);
	EndIf;

	RunNextWriteJobFromStack(CalculationParameters);
	
EndProcedure

Procedure PutPieceOfDataOnStack(CalculationParameters, RegisterEntryParameters)
	
	If CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry
	 And Not CalculationParameters.Debug.DisableRecordingGeneratedRegisteredRecords Then
		
		DataStackForWriting = CalculationParameters.DataStackForWriting; //Array
		DataStackForWriting.Add(RegisterEntryParameters);
		
	EndIf;

	RunNextWriteJobFromStack(CalculationParameters);
	
EndProcedure

Procedure ClearWriteDataCache(CalculationID, DataPortionNumber = Undefined)
	
	RecordSet = InformationRegisters.LotAccountingDataCache.CreateRecordSet();
	RecordSet.Filter.CalculationID.Set(CalculationID);
	
	If DataPortionNumber <> Undefined Then
		RecordSet.Filter.DataPortionNumber.Set(DataPortionNumber);
	EndIf;
	
	RecordSet.Write(True);
	
EndProcedure

// Waits for one or all tasks in the motion recording queue to complete.
//
// Returns:
//	Boolean -
//
Function WaitForWriteJobsToComplete(CalculationParameters, CompletingAllTasks = False, ExpectToFreeUpStackSpace = True, RecordingRegisteredRecordsOutsideCalculation = False) Export
	
	MaximumNumberOfBJ = MaximumNumberOfRecordingTasks(CalculationParameters);
	TaskText = ", " + NStr("vi = 'nhiệm vụ đang hoạt động';
							|ru = 'активных заданий';
							|en = 'active jobs'; fa = 'active jobs';
							|it = 'активных заданий';
							|pl = 'active jobs';
							|tr = 'aktif görevler'") + ": " + TrimAll(CalculationParameters.StackOfWriteJobs.Count());
	
	If CompletingAllTasks Or RecordingRegisteredRecordsOutsideCalculation
	 Or CalculationParameters.StackOfWriteJobs.Count() >= MaximumNumberOfBJ Then
	 
	 	If CompletingAllTasks Or RecordingRegisteredRecordsOutsideCalculation Then
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Đợi hoàn thành tất cả các nhiệm vụ ghi';
					|ru = 'Ожидание завершения всех заданий записи';
					|en = 'Wait for all saving jobs to complete'; fa = 'Wait for all saving jobs to complete';
					|it = 'Ожидание завершения всех заданий записи';
					|pl = 'Wait for all saving jobs to complete';
					|tr = 'Tüm kayıt görevlerinin tamamlanması bekleniyor'") + TaskText);
		ElsIf ExpectToFreeUpStackSpace Then
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Ngăn xếp nhiệm vụ ghi đã đầy, đang chờ đợi giải phóng không gian trong ngăn xếp';
					|ru = 'Стек заданий записи заполнен, ожидание освобождения места в стеке';
					|en = 'Saving job stack is full, waiting for stack space to become available'; fa = 'Saving job stack is full, waiting for stack space to become available';
					|it = 'Стек заданий записи заполнен, ожидание освобождения места в стеке';
					|pl = 'Saving job stack is full, waiting for stack space to become available';
					|tr = 'Kayıt görevi kümesi dolu, küme alanının boşa çıkması bekleniyor'") + TaskText);
		Else
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Kiểm tra việc sẵn có các nhiệm vụ ghi được hoàn thành';
					|ru = 'Проверяем наличие завершенных заданий записи';
					|en = 'Checking for completed saving jobs'; fa = 'Checking for completed saving jobs';
					|it = 'Проверяем наличие завершенных заданий записи';
					|pl = 'Checking for completed saving jobs';
					|tr = 'Tamamlanmış kayıt görevlerinin kontrolü'") + TaskText);
		EndIf;
		
		// If the size of the queue of recording tasks has reached the maximum, then we will delete the completed tasks from the queue.
		JobNumber = 0;
		Result = False;
		
		While JobNumber < CalculationParameters.StackOfWriteJobs.Count() Do
			
			If Not CompletingAllTasks And Not RecordingRegisteredRecordsOutsideCalculation Then
					
				IsJobCompleted = WaitForBackgroundRecordingJobToComplete(
					CalculationParameters,
					JobNumber,
					?(ExpectToFreeUpStackSpace, 0.5, 0.01));
				
				If IsJobCompleted Or CalculationParameters.StackOfWriteJobs.Count() = 0 Then
					Result = True; // free up space in the task stack
				EndIf;
				
				JobNumber = JobNumber + 1; // movements are still being recorded
				
				If JobNumber >= CalculationParameters.StackOfWriteJobs.Count() Then
					
					// None of the tasks are completed.
					If Not ExpectToFreeUpStackSpace Then
						Break;
					EndIf;
					
					JobNumber = 0; // We start waiting again until there is free space in the stack
					
				EndIf;
				
			Else
				
				// Alternately waiting for the completion of all tasks.
				WaitForBackgroundRecordingJobToComplete(CalculationParameters, JobNumber,, RecordingRegisteredRecordsOutsideCalculation);
				
			EndIf;
			
		EndDo;
		
		If Not CompletingAllTasks And Not RecordingRegisteredRecordsOutsideCalculation Then
			
			TaskText = ", " + NStr("vi = 'nhiệm vụ đang hoạt động';
									|ru = 'активных заданий';
									|en = 'active jobs'; fa = 'active jobs';
									|it = 'активных заданий';
									|pl = 'active jobs';
									|tr = 'aktif görevler'") + ": " + TrimAll(CalculationParameters.StackOfWriteJobs.Count());
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Đã cập nhật trạng thái ngăn xếp nhiệm vụ ghi';
					|ru = 'Состояние стека заданий записи актуализировано';
					|en = 'The state of the saving job stack is updated'; fa = 'The state of the saving job stack is updated';
					|it = 'Состояние стека заданий записи актуализировано';
					|pl = 'The state of the saving job stack is updated';
					|tr = 'Kayıt görev kümesinin durumu güncellendi'") + TaskText);
			
			Return Result;
			
		EndIf;
		
	Else
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Có không gian trong ngăn xếp nhiệm vụ ghi';
				|ru = 'Есть место в стеке заданий записи';
				|en = 'There is space in the saving job stack'; fa = 'There is space in the saving job stack';
				|it = 'Есть место в стеке заданий записи';
				|pl = 'There is space in the saving job stack';
				|tr = 'Kayıt görevi kümesinde alan mevcut'") + TaskText);
	EndIf;
	
	If CompletingAllTasks And Not RecordingRegisteredRecordsOutsideCalculation Then
		// In the case when the maximum number of record tasks (calculation parameters) > 1
		CostCalculationProtocol.EndOfMotionRecording(CalculationParameters);
	EndIf;
	
	Return True;
	
EndFunction

// Waits for the specified background motion recording task to complete.
//
Function WaitForBackgroundRecordingJobToComplete(CalculationParameters, JobNumber, Timeout = Undefined, RecordingRegisteredRecordsOutsideCalculation = False)
	
	Job = GetBackgroundRecordingJob(CalculationParameters, JobNumber);
	
	While Job.State = BackgroundJobState.Active Do
		
		Try
			
			If ValueIsFilled(Timeout) Then
				Job.WaitForExecutionCompletion(Timeout);
			Else
				Job.WaitForExecutionCompletion();
			EndIf;
			
			Job = GetBackgroundRecordingJob(CalculationParameters, JobNumber);
			
		Except
			Job = GetBackgroundRecordingJob(CalculationParameters, JobNumber);
		EndTry;
		
		If ValueIsFilled(Timeout) And Job.State = BackgroundJobState.Active Then
			Return False;
		EndIf;
		
	EndDo;
	
	Id = CalculationParameters.StackOfWriteJobs[JobNumber];
	JobRow = CalculationParameters.RecordJobTable.Find(Id, "JobID");
	
	If JobRow <> Undefined Then
		
		RegisterRecord = InformationRegisters.LotAccountingDataCache.CreateRecordManager();
		RegisterRecord.CalculationID = JobRow.CalculationID;
		RegisterRecord.DataType 			= Enums.DataTypesInLotAccountingCache.CalculationStatistics;
		RegisterRecord.DataPortionNumber 	= 0;
		RegisterRecord.VersionNumber 			= TrimAll(Metadata.Version);
		
		RegisterRecord.Read();
		
		If Not RegisterRecord.Selected() Then
			
			Result = New Structure;
			Result.Insert("TextStatistics", NStr("vi = 'Nhiệm vụ đã kết thúc bị lỗi (xem dưới)';
												|ru = 'Задание завершилось с ошибками (см. ниже)';
												|en = 'The job completed with errors (see below)'; fa = 'The job completed with errors (see below)';
												|it = 'Compito completato con errori (guarda sotto)';
												|pl = 'Zadanie zostało zakończone z błędami (patrz poniżej)';
												|tr = 'Görev hatalarla tamamlandı (aşağıya bak)'", Common.DefaultLanguageCode()));
			Result.Insert("ErrorText", "");
			
		Else
			
			Result = RegisterRecord.Data.Get();
			
		EndIf;
		
		JobRow.TextStatistics = Result.TextStatistics;
		JobRow.ErrorText 	  = Result.ErrorText;
		
		ClearWriteDataCache(JobRow.CalculationID);
		
	Else
		
		Result = New Structure;
		Result.Insert("TextStatistics", "");
		Result.Insert("ErrorText", NStr("vi = 'Không có thông tin về nhiệm vụ ghi lại';
										|ru = 'Информация о задании записи отсутствует';
										|en = 'Record job information is missing'; fa = 'Record job information is missing';
										|it = 'Informazioni sul compito di registrazione assenti';
										|pl = 'Brak informacji o zadaniu wpisu';
										|tr = 'Görev kaydı bilgisi eksik'", Common.DefaultLanguageCode()));
		
	EndIf;
	
	ProtocolText_ = "";
	
	If Job.State <> BackgroundJobState.Completed Then // movement recording failed
		
		If Job.State <> Undefined Then
			
			// The status of the task is "Completed" or "Canceled".
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Nhiệm vụ nền %1 %2:
				|%3';
				|ru = 'Фоновое задание %1 %2:
				|%3';
				|en = 'Background job %1 %2:
				|%3'; fa = 'Background job %1 %2:
				|%3';
				|it = 'Task in background %1 %2:
				|%3';
				|pl = 'Zadanie w tle %1 %2:
				|%3';
				|tr = 'Arka plan işi %1 %2:
				|%3'", Common.DefaultLanguageCode()),
				"""" + TrimAll(Job.Key) + """",
				?(Job.State = BackgroundJobState.Canceled, NStr("vi = 'hủy bỏ';
																|ru = 'отменено';
																|en = 'canceled'; fa = 'canceled';
																|it = 'annullato';
																|pl = 'anulowano';
																|tr = 'iptal edildi'", Common.DefaultLanguageCode()), NStr("vi = 'hoàn thành bất thường';
																														|ru = 'завершено аварийно';
																														|en = 'aborted'; fa = 'aborted';
																														|it = 'terminato in modo anomalo';
																														|pl = 'zakończone awaryjnie';
																														|tr = 'arızalı tamamlandı'", Common.DefaultLanguageCode())),
				?(Job.ErrorInfo = Undefined,
					NStr("vi = '<Không có mô tả lỗi>';
						|ru = '<Нет описания ошибки>';
						|en = '<No error description>'; fa = '<No error description>';
						|it = '<Non c''è una descrizione dell''errore>';
						|pl = '<Brak opisu błędu>';
						|tr = '<Hata ayrıntıları mevcut değil>'", Common.DefaultLanguageCode()),
					DetailErrorDescription(Job.ErrorInfo)));
			
		EndIf;
		
	ElsIf Not RecordingRegisteredRecordsOutsideCalculation Then
		
		RegisterName   = Job.Key;
		StartPosition = StrFind(RegisterName, "-");
		EndPosition1  = StrFind(RegisterName, "(");
		
		If StartPosition > 0 And EndPosition1 > 0 Then
			
			RegisterName = TrimAll(Mid(RegisterName, StartPosition + 1, EndPosition1 - StartPosition - 1));
			
			CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
				CalculationParameters,
				RegisterName,,,
				Job.End - Job.Begin + 1);
			
		EndIf;
		
	EndIf;
	
	If ValueIsFilled(Result.ErrorText) Then
		
		ProtocolText_ = ProtocolText_ + Chars.LF
			+ StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Nhiệm vụ nền %1 đã thực hiện bị lỗi:
				|%2';
				|ru = 'Фоновое задание %1 выполнено с ошибками:
				|%2';
				|en = 'Background job %1 completed with errors:
				|%2'; fa = 'Background job %1 completed with errors:
				|%2';
				|it = 'Compito in background %1 eseguito con errori:
				|%2';
				|pl = 'Zadanie w tle %1 wykonano z błędami:
				|%2';
				|tr = 'Arka plan işi %1 hatalarla tamamlandı:
				|%2'", Common.DefaultLanguageCode()),
				"""" + TrimAll(Job.Key) + """",
				Result.ErrorText);
			
	EndIf;
	
	ProtocolText_ = TrimAll(ProtocolText_);
	
	If JobRow <> Undefined Then
		JobRow.ErrorText = ProtocolText_;
	EndIf;
	
	If ValueIsFilled(ProtocolText_) And Not RecordingRegisteredRecordsOutsideCalculation Then
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
			StrReplace(ProtocolText_, ServiceSymbol_ProblemAlreadyRegistered(), ""));
		
		If StrFind(ProtocolText_, ServiceSymbol_ProblemAlreadyRegistered()) = 0 Then
			
			RegisterCalculationExecutionProblem(
				CalculationParameters,
				,
				NStr("vi = 'Khi ghi lại bản ghi kết chuyển, đã chẩn đoán được lỗi';
					|ru = 'При записи движений диагностированы ошибки';
					|en = 'Errors were found when saving records'; fa = 'Errors were found when saving records';
					|it = 'Durante la scrittura dei movimenti sono stati diagnosticati degli errori';
					|pl = 'Błędy wykryte podczas zapisywania ruchów';
					|tr = 'Hareketleri kaydederken, hatalar teşhis edildi'", Common.DefaultLanguageCode()),
				ProtocolText_);
			
		EndIf;
		
	EndIf;
	
	CalculationParameters.StackOfWriteJobs.Delete(JobNumber); // finished
	
	Return True;
	
EndFunction

// Receives a background task for recording movements by its number in the queue.
//
Function GetBackgroundRecordingJob(CalculationParameters, JobNumber)
	
	Id = CalculationParameters.StackOfWriteJobs[JobNumber];
	Job 	  = BackgroundJobs.FindByUUID(Id);
	
	If Job = Undefined Then
		
		JobRow = CalculationParameters.RecordJobTable.Find(Id, "JobID");
		
		If JobRow = Undefined Then
			
			JobKey = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Nhiệm vụ nền số? (%1)';
					|ru = 'ФЗ №? (%1)';
					|en = 'FZ No.? (%1)'; fa = 'FZ No.? (%1)';
					|it = 'FS №? (%1)';
					|pl = 'UF nr? (%1)';
					|tr = 'FY №? (%1)'", Common.DefaultLanguageCode()),
				TrimAll(Id));
			
		Else
			
			JobKey = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Nhiệm vụ nền số %1 - %2 (%3)';
					|ru = 'ФЗ №%1 - %2 (%3)';
					|en = 'FZ No.%1 - %2 (%3)'; fa = 'FZ No.%1 - %2 (%3)';
					|it = 'FS №%1 - %2 (%3)';
					|pl = 'UF nr%1 - %2 (%3)';
					|tr = 'FY №%1 - %2 (%3)'", Common.DefaultLanguageCode()),
				TrimAll(CalculationParameters.RecordJobTable.IndexOf(JobRow) + 1),
				JobRow.RegisterName,
				TrimAll(Id));
			
		EndIf;
		
		Job = New Structure("State, Key", Undefined, JobKey);
		
	EndIf;
	
	Return Job;
	
EndFunction

Function MaximumNumberOfRecordingTasks(CalculationParameters)
	
	// If the routine task of calculating the preliminary cost is started,
	// then multithreaded recording is not required, because movements are calculated only according to the register of information about the cost of goods.
	JobsCount =
		?(CalculationParameters.ScheduledJob Or Common.FileInfobase(),
			1,
			CalculationParameters.FederalLawRestrictions.MaximumNumberOfFZEntries);
	
	Return JobsCount;
	
EndFunction

