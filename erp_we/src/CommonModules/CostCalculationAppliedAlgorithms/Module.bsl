// * CalculationOption - EnumRef.LotAndCostCalculationOptions -
// * AutoTesting - Boolean -
// * FilledBatchesInRevenue - Boolean -
// * BatchesInRevenueAreFilledIn - Boolean -
// * FilledBatchesAtCostPrice - Boolean -
// * LotsAreFilledInAtCostPrice - Boolean -
// * BatchCalculationStarted - Boolean -
// * DebugParameters - Undefined -
// * TaskNumberBeforeCalculation - Number -
// * TheseArePoolCalculationParameters - Boolean -
// * ThisIsLocalizedVersion - Boolean -
// * DistributionOfParties - See CostCalculationAppliedAlgorithms.InitializeBatchDistribution
// * Debug - Structure -:
// ** VfzRegistrars - See CostCalculationAppliedAlgorithms.EstablishNonTunableTechnologicalParametersOfCalculation
//
Function InitializeGeneralCalculationParameters(InitializationParameters, CalculationParameters, DebugParameters = Undefined) Export
	
	If CalculationParameters <> Undefined Then
		Return CalculationParameters; // The calculation parameters have already been initialized
	EndIf;
	
	Date 			  = InitializationParameters.Date;
	CompanyArray = AvailableCompanies(InitializationParameters.CompanyArray);
		
	ReducedInitialization = Not InitializationParameters.Property("BatchCalculationStarted");
	
	#Region BasicParameters
	
	If Not ReducedInitialization Then
		BatchCalculationStarted 					 = InitializationParameters.BatchCalculationStarted;
		OnlyPreliminaryCostCalculation = InitializationParameters.OnlyPreliminaryCostCalculation;
		StartedByRoutineTask 			 = InitializationParameters.StartedByRoutineTask;
	Else
		// Calling from outside the calculation mechanism with default parameters.
		BatchCalculationStarted 					 = True;
		OnlyPreliminaryCostCalculation = False;
		StartedByRoutineTask 			 = False;
	EndIf;
	
	// Let's create a container of all common parameters used by batch and cost calculation mechanisms.
	CalculationParameters = New Structure;
	CalculationParameters.Insert("TheseArePoolCalculationParameters",		 True); // service identifier of the structure
	CalculationParameters.Insert("DebugParameters", 			 	 DebugParameters);
	CalculationParameters.Insert("TaskNumberBeforeCalculation",
		?(InitializationParameters.Property("TaskNumberBeforeCalculation"), InitializationParameters.TaskNumberBeforeCalculation, -1));
	
	CalculationParameters.Insert("ThisIsLocalizedVersion", 		 True);
		
	// Parameters of the start and current state of the calculation
	CalculationParameters.Insert("BatchCalculationStarted", 			 BatchCalculationStarted); // has the full calculation (batch+cost price) been started, or is it just the cost calculation?
	CostCalculationMechanismIsPerformed(CalculationParameters, 	 Not BatchCalculationStarted); // fills in the property idecountparties
	
	CalculationParameters.Insert("LotsAreFilledInAtCostPrice", False); // manages the logic of filling in the details of the "Calculation of parties" in the cost register
	CalculationParameters.Insert("FilledBatchesAtCostPrice",   Not BatchCalculationStarted); // manages the logic of obtaining the cache of turns of the cost register
	CalculationParameters.Insert("BatchesInRevenueAreFilledIn", 		 False); // manages the logic of filling in the details of the "Calculation of Parties" and the logic of filling in the turnover cache of the revenue register
	CalculationParameters.Insert("FilledBatchesInRevenue",   		 Not BatchCalculationStarted); // manages the logic of getting the revenue register's turnover cache
	
	CalculationParameters.Insert("PlaceOfCalculationCall",
		?(InitializationParameters.Property("PlaceOfCalculationCall"),
			InitializationParameters.PlaceOfCalculationCall, NStr("vi = 'Chưa chỉ ra';
																	|ru = 'Не указано';
																	|en = 'Not specified'; fa = 'مشخص نشده';
																	|it = 'Non indicato';
																	|pl = 'Nie określono';
																	|tr = 'Belirtilmedi'", Common.DefaultLanguageCode()))); // where the calculation was called from (for the record)
	
	If InitializationParameters.Property("DecodingDistribution") Then
		CalculationParameters.Insert("DecodingDistribution", InitializationParameters.DecodingDistribution); // called when generating a report
	EndIf;
	
	If InitializationParameters.Property("AutoTesting") And InitializationParameters.AutoTesting Then
		CalculationParameters.Insert("AutoTesting", True); // called during testing
	Else
		CalculationParameters.Insert("AutoTesting", False);
	EndIf;
	
	// Variant of calculation
	If StartedByRoutineTask Then
		CalculationParameters.Insert("CalculationOption", 		   Enums.LotAndCostCalculationOptions.PreliminaryCostScheduledJob);
	ElsIf OnlyPreliminaryCostCalculation Then
		CalculationParameters.Insert("CalculationOption", 		   Enums.LotAndCostCalculationOptions.PreliminaryCost);
	ElsIf BatchCalculationStarted Then
		CalculationParameters.Insert("CalculationOption", 		   Enums.LotAndCostCalculationOptions.LotsAndCost);
	Else
		CalculationParameters.Insert("CalculationOption", 		   Enums.LotAndCostCalculationOptions.ActualCostCalculation);
	EndIf;
	
	GeneralParametersForClosingMonth = MonthEndTransactionsServer.GeneralParametersForClosingMonth();
	CalculationParameters.Insert("DistributionOfAdditionalCostsBetweenPartiesAndGoods",
		GeneralParametersForClosingMonth.DistributionOfAdditionalCostsBetweenPartiesAndGoods);
	CalculationParameters.Insert("DistributionOfItemByItemSalesExpenses",
		GeneralParametersForClosingMonth.DistributionOfItemByItemSalesExpenses);
	CalculationParameters.Insert("RestoreChronologicalSequenceOfDebitingBatches",
		GeneralParametersForClosingMonth.RestoreChronologicalSequenceOfDebitingBatches);
	CalculationParameters.Insert("HighlightDeviationsInCostOfFinalCalculation",
		GeneralParametersForClosingMonth.HighlightDeviationsInCostOfFinalCalculation);
	
	If InitializationParameters.Property("MeasurementDetails") Then
		// Regular call from the batch accounting mechanism version 2.1.
		CalculationParameters.Insert("MeasurementDetails", InitializationParameters.MeasurementDetails);
	EndIf;
	
	// Platform version.
	CalculationParameters.Insert("PlatformVersionNotLowerThan8_5_4", PlatformVersionNotLowerThanSpecified("8.5.4.0"));
	
	CalculationParameters.Insert("UsePlatformToSolveSLU",
		CalculationOfCostCached.ValuesOfTechnologicalParameters().UsePlatformToSolveSLU);
		
	CalculationParameters.Insert("DisableGraphReduction",
		CalculationOfCostCached.ValuesOfTechnologicalParameters().DisableGraphReduction);
	CalculationParameters.Insert("DisableReductionOfVATGraph",
		CalculationOfCostCached.ValuesOfTechnologicalParameters().DisableReductionOfVATGraph);
	
	// Organizations to calculate.
	CalculationParameters.Insert("CompanyArray",			 CompanyArray);
	CalculationParameters.Insert("CopyArrayOfOrganizations",		 Common.CopyRecursive(CompanyArray));
	
	#EndRegion
	
	// Creating a description of the data for logging calculation and performance measurement.
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "InitializeGeneralCalculationParameters");
	
	#Region PayrollPeriod
	
	// Calculation period and period boundaries
	PayrollPeriod = New Structure;
	PayrollPeriod.Insert("BeginOfPeriod", 		 		   InitializationParameters.BeginOfPeriod);
	PayrollPeriod.Insert("EndOfPeriod",  		 		   InitializationParameters.EndOfPeriod);
	PayrollPeriod.Insert("BeginningOfPreviousPeriod", 	   BegOfMonth(PayrollPeriod.BeginOfPeriod - 1));
	PayrollPeriod.Insert("EndOfPreviousPeriod", 	   PayrollPeriod.BeginOfPeriod - 1);
	PayrollPeriod.Insert("BeginningOfNextPeriod", 	   EndOfMonth(Date) + 1);
	PayrollPeriod.Insert("BorderStartOfPeriod", 		   New Boundary(PayrollPeriod.BeginOfPeriod, BoundaryType.Excluding));
	PayrollPeriod.Insert("BorderEndOfPeriod",  		   New Boundary(PayrollPeriod.EndOfPeriod, BoundaryType.Including));
	PayrollPeriod.Insert("BorderEndOfPreviousPeriod", New Boundary(PayrollPeriod.EndOfPreviousPeriod, BoundaryType.Including));
	
	CalculationParameters.Insert("PayrollPeriod", 			   PayrollPeriod);
	
	#EndRegion
	
	#Region CommonParameters
	
	// General manager of temporary tables for all calculation stages
	CalculationParameters.Insert("TempTablesManager", New TempTablesManager);
	
	// Service parameters of the calculation stage request. After the stage is completed, they are cleared.
	CalculationParameters.Insert("AdditionalStageRequestParameters", New Structure);

	// Statistics of changes in documents for the billing period (the reason for the recalculation of the period).
	If InitializationParameters.Property("DocumentsChanged") Then
		// Regular call from the batch accounting mechanism version 2.2.
		CalculationParameters.Insert("DocumentsChanged",   	   InitializationParameters.DocumentsChanged);
	Else
		CalculationParameters.Insert("DocumentsChanged",   	   Undefined);
	EndIf;
	
	// Other service properties
	CalculationParameters.Insert("IBConnectionString",	 		   InfoBaseConnectionString());
	CalculationParameters.Insert("FileInfobase",	   Common.FileInfobase());
	
	// cost calculation parameters
	CalculationParameters.Insert("ScheduledJob",		   StartedByRoutineTask);
	CalculationParameters.Insert("PreliminaryCalculation",		   OnlyPreliminaryCostCalculation);
	If InitializationParameters.Property("MonthEndClosingMode") Then
		CalculationParameters.Insert("MonthEndClosingMode",	   InitializationParameters.MonthEndClosingMode);
	Else
		CalculationParameters.Insert("MonthEndClosingMode",	   Enums.MonthEndClosingModes.EmptyRef());
	EndIf;
	
	#EndRegion
	
	#Region BackgroundJobs
	
	// Properties of background tasks for calculating and recording movements.
	RecordJobTable = New ValueTable;
	RecordJobTable.Columns.Add("JobID");
	RecordJobTable.Columns.Add("PreviousTask_");
	RecordJobTable.Columns.Add("RegisterName");
	RecordJobTable.Columns.Add("NumberOfRegisteredRecords");
	RecordJobTable.Columns.Add("CalculationID");
	RecordJobTable.Columns.Add("TextStatistics");
	RecordJobTable.Columns.Add("ErrorText");
	RecordJobTable.Columns.Add("BatchesCount");
	RecordJobTable.Columns.Add("NumberOfFirstPortion");
	RecordJobTable.Columns.Add("WriteParameters");
	
	CalculationTaskTable = New ValueTable;
	CalculationTaskTable.Columns.Add("JobID");
	CalculationTaskTable.Columns.Add("JobKey");
	CalculationTaskTable.Columns.Add("CalculationID");
	
	TableOfAccountingTasks = New ValueTable;
	TableOfAccountingTasks.Columns.Add("JobID");
	TableOfAccountingTasks.Columns.Add("JobKey");
	TableOfAccountingTasks.Columns.Add("CalculationID");
	
	CalculationParameters.Insert("StackOfWriteJobs",    		   New Array); // call stack of background tasks for recording movements
	CalculationParameters.Insert("RecordJobTable", 		   RecordJobTable); // description of each running recording job
	CalculationParameters.Insert("TotalNumberOfFederalLawEntries",	   0); // total number of completed background recording tasks
	CalculationParameters.Insert("DataStackForWriting",    	   New Array); // a stack of Registered Records of registers prepared for recording
	
	CalculationParameters.Insert("TableOfAccountingTasks", TableOfAccountingTasks); // description of each running task is reflected in the accounting
	
	CalculationParameters.Insert("CalculationTaskTable", 		   CalculationTaskTable); // description of each running calculation task
	CalculationParameters.Insert("TotalNumberOfFederalLaws",	   0); // total number of completed background calculation tasks
	
	CalculationParameters.Insert("CalculationID"); // filled in for background batch calculation tasks
		
	#EndRegion
	
	#Region TechnologicalParameters
	
	// Technological parameters of the calculation.
	SetTechnologicalParametersOfCalculation(CalculationParameters);
	
	#EndRegion
	
	#Region FunctionalOptions
	
	// The values of the analyzed functional options and constants (they are also set as query parameters of the same name).
	CalculationParameters.Insert("FEDERALDISTRICT", New Structure);
	FONames = "
		|UseProductionManagement2_2,
		|CurrenciesOfManAndLocalAccountingMatch,
		|AnalyticalAccountingByProductsGroups,
		|PriceKindOfPlannedCostOfMaterialsAndWorks,
		|UseCostAccountingByLinesOfBusiness,
		|UseLocal,
		|UseManagementCompany,
		|UseAccountingOfOtherIncomeExpenses,
		|UseAccountingOfOtherIncomeExpensesInLocalAccounting,
		|AllocationOfAdditionalExpensesByDisposedGoods,
		|AllocationOfAdditionalExpensesOnGoodsInTransitFromVendors,
		|UseFinancialAccounting,
		|UseVATDeclarationSection7Filling,
		|GenerateInventoryOwnerAttributesByFinancialAccountingGroups,
		|GenerateFinancialResult,
		|UseBalanceSheetStatement";
	CalculationOfCostLocalization.CompleteNamesOfFunctionalOptions(FONames);
	
	For Each KeyAndValue In New Structure(FONames) Do
		
		FODetails = DescriptionOfConstantOrFunctionOption(KeyAndValue.Key);
		
		If FODetails.Metadata <> Undefined Then
			CalculationParameters.FEDERALDISTRICT.Insert(KeyAndValue.Key, FODetails.Value);
		Else
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Không tìm thấy tùy chọn chức năng hoặc hằng ""%1""';
					|ru = 'Не найдена функциональная опция или константа ""%1""';
					|en = 'Functional option or the ""%1"" constant is not found'; fa = 'Functional option or the ""%1"" constant is not found';
					|it = 'Non trovata l''opzione funzionale o la costante ""%1""';
					|pl = 'Nie znaleziono opcji funkcjonalnej lub wartości stałej ""%1""';
					|tr = 'İşlevsel seçenek veya ""%1"" sabiti bulunamadı'", Common.DefaultLanguageCode()),
				KeyAndValue.Key);
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.ErrorOfInitializingCalculationParameters,
				ProtocolText_);
			
			RegisterCalculationExecutionProblem(
				CalculationParameters,
				CompanyArray, // because the property of the calculation parameters.The array of organizations has not yet been initialized
				NStr("vi = 'Khi bắt đầu tính toán, đã chẩn đoán được lỗi';
					|ru = 'При запуске расчета диагностированы ошибки';
					|en = 'Errors were found on calculation start'; fa = 'Errors were found on calculation start';
					|it = 'Durante l''avvio del calcolo sono stati diagnosticati degli errori';
					|pl = 'Podczas uruchamiania obliczeń zostały rozpoznane błędy';
					|tr = 'Hesaplama başlangıcı sırasında teşhis edilen hatalar'", Common.DefaultLanguageCode()),
				ProtocolText_);
			
		EndIf;
		
	EndDo;
	
	// A sign of maintaining upr. accounting (extended verification of the management accounting of organizations).
	CalculationParameters.Insert("CompanyManagementAccounting",
		CalculationOfCostCached.CompanyManagementAccounting(CalculationParameters.PayrollPeriod.BeginOfPeriod));
	
	// Indication of use in the calculated period of management of non-current assets of version 2.4.
	VNAManagementIsUsed_2_4 = False;
	VNAManagementIsUsed_2_4 = NonCurrentAssets.VNAManagementIsUsed_2_4(CalculationParameters.PayrollPeriod.BeginOfPeriod);
	CalculationParameters.Insert("VNAManagementIsUsed_2_4", VNAManagementIsUsed_2_4);
	
	// Signs of use in the calculated period of batch accounting
	CalculationParameters.Insert("BatchAccountingNotUsed",
		CalculationOfCostCached.BatchAccountingNotUsed(CalculationParameters.PayrollPeriod.BeginOfPeriod));
	CalculationParameters.Insert("BatchAccountingVersion21",
		CalculationOfCostCached.BatchAccountingVersion21(CalculationParameters.PayrollPeriod.BeginOfPeriod));
	CalculationParameters.Insert("BatchAccountingVersion22",
		CalculationOfCostCached.BatchAccountingVersion22(CalculationParameters.PayrollPeriod.BeginOfPeriod));
	CalculationParameters.Insert("DateOfMigrationToBatchAccounting22",
		CalculationOfCostCached.DateOfMigrationToBatchAccounting22());	
	CalculationParameters.Insert("BatchAccountingWasUsedBeforeSwitchingToVersion22",
		CalculationOfCostCached.BatchAccountingWasUsedBeforeSwitchingToVersion22(Date(1,1,1)));
	
	CalculationParameters.Insert("KeepRecordsOfInventoryCostByAssignments",
		CalculationOfCostCached.CostOfGoodsForPurposes(CalculationParameters.PayrollPeriod.BeginOfPeriod));	
	
	// Indication of the calculation of the first month in the batch accounting version 2.2
	CalculationParameters.Insert("FormInitialBatchBalances22",
		CalculationParameters.BatchAccountingVersion22
	 	And CalculationParameters.PayrollPeriod.BeginOfPeriod = CalculationParameters.DateOfMigrationToBatchAccounting22);
	
	// Signs of the beginning of cost accounting.
	CalculationParameters.Insert("CostAccountingStartDate",
		BegOfMonth(Constants.CostAccountingStartDate.Get()));
	CalculationParameters.Insert("UseCostAccounting",
		CalculationOfCostCached.GenerateRegisteredRecordsOnCostRegisters(PayrollPeriod.BeginOfPeriod));
	CalculationParameters.Insert("FormOnlyRegisteredRecordsOfEnteringResidues",
		CalculationParameters.PayrollPeriod.BeginningOfNextPeriod = CalculationParameters.CostAccountingStartDate);
	
	#EndRegion
	
	#Region RecordTypes
	
	// Types of "Cost of goods" register entries
	CalculationParameters.Insert("TypesOfPrimaryBatchRecords",   			  TypesOfPrimaryBatchRecords());
	CalculationParameters.Insert("UnreadableRecordTypes", 			  UnreadableRecordTypes());
	CalculationParameters.Insert("TypesOfDataConversionRecords", 			  TypesOfDataConversionRecords());
	CalculationParameters.Insert("TypesOfMultipleDataConversionRecords", TypesOfMultipleDataConversionRecords());
	CalculationParameters.Insert("TypesOfPrimaryMotionRecordings", 			  TypesOfPrimaryMotionRecordings());
	
	// Rules for filling in the field of the type record of the register "Cost of goods"
	CalculationParameters.Insert("RulesForFillingInRecordTypeField",
		CalculationOfCostCached.RulesForFillingInRecordTypeField());
		
	CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
		CalculationParameters,
		CalculationParameters.RulesForFillingInRecordTypeField.Count());
	
	#EndRegion
	
	#Region DocumentTypes
	
	TypesArray = New Array;
	TypesArray.Add(Type("DocumentRef.AssemblyFromComponents"));
	TypesArray.Add(Type("DocumentRef.SubcontractorReport2_5"));
	TypesArray.Add(Type("DocumentRef.BackflushProduction"));
	TypesArray.Add(Type("DocumentRef.ConsumptionReportSubcontractingServicesDeliveredIntercompany"));
	TypesArray.Add(Type("DocumentRef.ProductionStage2_2"));
	CalculationParameters.Insert("TypesOfProductionDocuments", TypesArray);
	
	TypesArray = New Array;
	For Each Current_Type In Metadata.DefinedTypes.DocumentLots.Type.Types() Do
		TypesArray.Add(Current_Type);
	EndDo;
	
	CalculationParameters.Insert("TypesOfBatchDocuments", TypesArray);
	
	TypesArray = New Array;
	For Each MetaDocument In Metadata.Documents Do
		If MetaDocument.RegisterRecords.Contains(Metadata.AccumulationRegisters.RevenueAndCOGS) Then
			TypesArray.Add(Type("DocumentRef." + MetaDocument.Name));
		EndIf;
	EndDo;

	CalculationParameters.Insert("TypesOfRevenueRecorders", TypesArray);
	
	
	// For these types of documents, there are two entries in the Document information register:
	// for the sending organization without the Additional Record attribute, and for the receiving organization with the Additional Record attribute.
	// In connection requests with the registry, if a connection is made using the Organization field, you must take into account such additional entries.
	DocumentsWithTwoOrganizations = New Array;
	DocumentsWithTwoOrganizations.Add(Common.MetadataObjectID(Metadata.Documents.CustomerInvoiceIntercompany.FullName()));
	DocumentsWithTwoOrganizations.Add(Common.MetadataObjectID(Metadata.Documents.IntercompanyGoodsReturn.FullName()));
	DocumentsWithTwoOrganizations.Add(Common.MetadataObjectID(Metadata.Documents.BackflushProduction.FullName()));
	DocumentsWithTwoOrganizations.Add(Common.MetadataObjectID(Metadata.Documents.ProductionStage2_2.FullName()));
	DocumentsWithTwoOrganizations.Add(Common.MetadataObjectID(Metadata.Documents.ConsumptionReportSubcontractingServicesDeliveredIntercompany.FullName()));
	DocumentsWithTwoOrganizations.Add(Common.MetadataObjectID(Metadata.Documents.MovementOfProductsAndMaterials.FullName()));
	CalculationParameters.Insert("DocumentsWithTwoOrganizations", DocumentsWithTwoOrganizations);
	
	#EndRegion
	
	#Region OrganizationsAndPolicies
	
	// Organizations and their accounting policies.
	CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
		CalculationParameters,
		CompanyArray.Count());
	
	CalculationParameters.Insert("OrganizationsWithCostRegisteredRecords",     OrganizationsWithCostRegisteredRecords(Date, CompanyArray));
	CalculationParameters.Insert("OrganizationsWithCostBalances",      OrganizationsWithCostBalances(Date, CompanyArray));
	CalculationParameters.Insert("OrganizationsWithDetailedMaterialAndItemByItemCosts", New Array);
	CalculationParameters.Insert("OrganizationsWithoutDetailsBeforeReceiptDocuments", New Array);
	CalculationParameters.Insert("CompaniesWithRestorationOfReservesWhenInventoryWriteOffForExpenses", New Array);
	CalculationParameters.Insert("OrganizationsUseWriteOffOfDeviationsForSales", New Array);
	CalculationParameters.Insert("CompaniesWithDistributionOfDeviationsInPastPeriods", New Array);
	
	CalculationParameters.Insert("AccountingPolicies",					   	   New Structure);
	
	CalculationParameters.AccountingPolicies.Insert("ValuationMethods", 	   New Map); // Organization - Evaluation Method
	CalculationParameters.AccountingPolicies.Insert("FIFOSliding", 	   	   New Structure);
	CalculationParameters.AccountingPolicies.Insert("OnAverage", 	   	   		   New Structure);
	CalculationParameters.AccountingPolicies.Insert("FifoWeighted", 	   	   New Structure);
	CalculationParameters.AccountingPolicies.Insert("MovingAverage", 	   	   New Structure);
	CalculationParameters.AccountingPolicies.Insert("AveragePerMonth",	   		   New Structure);
	
	UseFIFOVCurPeriod   		 	= New Array;
	UsedFIFOVLastPeriod 		 	= New Array;
	UseAverageInCurrentPeriod   		= New Array;
	UsedAccordingToAverageInLastPeriod 		= New Array;
	FIFOWeightedInCurPeriodIsUsed  	= New Array;
	FIFOWeightedInLastPeriodWasUsed 	= New Array;
	AverageMovingAverageInCurrentPeriodIsUsed 	= New Array;
	UsedAverageSlidingInLastPeriod = New Array;
	UsingAverageInCurrentPeriod 			= New Array;
	UsedAverageInLastPeriod 			= New Array;
	
	Query = New Query;
	Query.Text = "
	|SELECT ALLOWED
	|	CatCompanies.ParentCompany AS ParentCompany,
	|	CatCompanies.Ref AS Organization
	|INTO TTParentOrganizations
	|FROM
	|	Catalog.Companies AS CatCompanies
	|WHERE
	|	CatCompanies.Ref IN (&Companies)
	|
	|INDEX BY
	|	ParentCompany
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	FinancialAccountingPolicySliceLast.Organization AS Organization,
	|	FinancialAccountingPolicySliceLast.InventoryValuationMethod,
	|	FinancialAccountingPolicySliceLast.ItemizeMaterialAndItemizedExpensesInInventoryCost,
	|	FinancialAccountingPolicySliceLast.DoNotBreakDownToReceiptDocuments,
	|	FinancialAccountingPolicySliceLast.ReverseProvisionWhenWritingOffInventoryToExpenses,
	|	FinancialAccountingPolicySliceLast.ProductCostingByPlannedCost,
	|	FinancialAccountingPolicySliceLast.WriteOffProductCostVariancesToCostOfGoodsSold,
	|	FinancialAccountingPolicySliceLast.AllocateVariancesInPreviousPeriods
	|INTO TTFinAccounting
	|FROM
	|	InformationRegister.FinancialAccountingPolicy.SliceLast(&Period, Organization IN
	|		(SELECT
	|			ParentCompany
	|		FROM
	|			TTParentOrganizations)) AS FinancialAccountingPolicySliceLast
	|
	|INDEX BY
	|	Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	FinancialAccountingPolicySliceLast.Organization AS Organization,
	|	FinancialAccountingPolicySliceLast.InventoryValuationMethod
	|INTO TTFinAccountingForPreviousPeriod
	|FROM
	|	InformationRegister.FinancialAccountingPolicy.SliceLast(&PreviousPeriod, Organization IN
	|		(SELECT
	|			ParentCompany
	|		FROM
	|			TTParentOrganizations)) AS FinancialAccountingPolicySliceLast
	|
	|INDEX BY
	|	Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TTParentOrganizations.Organization AS Organization,
	|	ISNULL(TTFinAccounting.InventoryValuationMethod,
	|		VALUE(Enum.InventoryValuationMethods.AveragePerMonth)) AS InventoryValuationMethod,
	|	ISNULL(TTFinAccounting.ItemizeMaterialAndItemizedExpensesInInventoryCost,
	|		FALSE) AS ItemizeMaterialAndItemizedExpensesInInventoryCost,
	|	ISNULL(TTFinAccounting.DoNotBreakDownToReceiptDocuments,
	|		FALSE) AS DoNotBreakDownToReceiptDocuments,
	|	ISNULL(TTFinAccounting.ReverseProvisionWhenWritingOffInventoryToExpenses,
	|		FALSE) AS ReverseProvisionWhenWritingOffInventoryToExpenses,
	|	ISNULL(TTFinAccounting.ProductCostingByPlannedCost,
	|		FALSE) AS ProductCostingByPlannedCost,
	|	ISNULL(TTFinAccounting.WriteOffProductCostVariancesToCostOfGoodsSold,
	|		FALSE) AS WriteOffProductCostVariancesToCostOfGoodsSold,
	|	ISNULL(TTFinAccounting.AllocateVariancesInPreviousPeriods,
	|		FALSE) AS AllocateVariancesInPreviousPeriods
	|FROM
	|	TTParentOrganizations AS TTParentOrganizations
	|		LEFT JOIN TTFinAccounting AS TTFinAccounting
	|		ON TTParentOrganizations.ParentCompany = TTFinAccounting.Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TTParentOrganizations.Organization AS Organization,
	|	ISNULL(TTFinAccountingForPreviousPeriod.InventoryValuationMethod,
	|		VALUE(Enum.InventoryValuationMethods.AveragePerMonth)) AS InventoryValuationMethod
	|FROM
	|	TTParentOrganizations AS TTParentOrganizations
	|		LEFT JOIN TTFinAccountingForPreviousPeriod AS TTFinAccountingForPreviousPeriod
	|		ON TTParentOrganizations.ParentCompany = TTFinAccountingForPreviousPeriod.Organization
	|";
	
	Query.SetParameter("Companies", CompanyArray);
	Query.SetParameter("Period", CalculationParameters.PayrollPeriod.BeginOfPeriod);
	Query.SetParameter("PreviousPeriod", CalculationParameters.PayrollPeriod.BeginningOfPreviousPeriod);
	
	Result						= Query.ExecuteBatch();
	AccountingPolicies					= Result[3].Unload();
	PastAccountingPolicies	= Result[4].Unload();
	
	For Each AccountingPolicyParameters In AccountingPolicies Do
		
		AccountingPolicyParameterOfPreviousPeriod = PastAccountingPolicies.Find(AccountingPolicyParameters.Organization, "Organization");
		
		CalculationParameters.AccountingPolicies.ValuationMethods.Insert(AccountingPolicyParameters.Organization, AccountingPolicyParameters.InventoryValuationMethod);
		
		// FIFOSliding
		If AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.FIFORollingValuation Then
			UseFIFOVCurPeriod.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		If AccountingPolicyParameterOfPreviousPeriod.InventoryValuationMethod = Enums.InventoryValuationMethods.FIFORollingValuation Then
			UsedFIFOVLastPeriod.Add(AccountingPolicyParameterOfPreviousPeriod.Organization);
		EndIf;
		
		// FIFO weighted
		If AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.FIFOWeightedEstimate Then
			FIFOWeightedInCurPeriodIsUsed.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		If AccountingPolicyParameterOfPreviousPeriod.InventoryValuationMethod = Enums.InventoryValuationMethods.FIFOWeightedEstimate Then
			FIFOWeightedInLastPeriodWasUsed.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		// MovingAverage
		If AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.MovingAverage Then
			AverageMovingAverageInCurrentPeriodIsUsed.Add(AccountingPolicyParameters.Organization);
		EndIf;

		If AccountingPolicyParameterOfPreviousPeriod.InventoryValuationMethod = Enums.InventoryValuationMethods.MovingAverage Then
			UsedAverageSlidingInLastPeriod.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		// AveragePerMonth
		If AccountingPolicyParameters.InventoryValuationMethod = Enums.InventoryValuationMethods.AveragePerMonth Then
			UsingAverageInCurrentPeriod.Add(AccountingPolicyParameters.Organization);
		EndIf;

		If AccountingPolicyParameterOfPreviousPeriod.InventoryValuationMethod = Enums.InventoryValuationMethods.AveragePerMonth Then
			UsedAverageInLastPeriod.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		// Other
		If AccountingPolicyParameters.ItemizeMaterialAndItemizedExpensesInInventoryCost Then
			CalculationParameters.OrganizationsWithDetailedMaterialAndItemByItemCosts.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		If AccountingPolicyParameters.ItemizeMaterialAndItemizedExpensesInInventoryCost
		 And AccountingPolicyParameters.DoNotBreakDownToReceiptDocuments Then
			CalculationParameters.OrganizationsWithoutDetailsBeforeReceiptDocuments.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		If AccountingPolicyParameters.ReverseProvisionWhenWritingOffInventoryToExpenses Then
			CalculationParameters.CompaniesWithRestorationOfReservesWhenInventoryWriteOffForExpenses.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		If AccountingPolicyParameters.ProductCostingByPlannedCost
		 And AccountingPolicyParameters.WriteOffProductCostVariancesToCostOfGoodsSold Then
			CalculationParameters.OrganizationsUseWriteOffOfDeviationsForSales.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
		If AccountingPolicyParameters.AllocateVariancesInPreviousPeriods Then
			CalculationParameters.CompaniesWithDistributionOfDeviationsInPastPeriods.Add(AccountingPolicyParameters.Organization);
		EndIf;
		
	EndDo;
	
	CalculationParameters.AccountingPolicies.FIFOSliding.Insert("UsedInCurPeriod",   	UseFIFOVCurPeriod);
	CalculationParameters.AccountingPolicies.FIFOSliding.Insert("UsedInLastPeriod", 	UsedFIFOVLastPeriod);
	CalculationParameters.AccountingPolicies.OnAverage.Insert("UsedInCurPeriod",   			UseAverageInCurrentPeriod);
	CalculationParameters.AccountingPolicies.OnAverage.Insert("UsedInLastPeriod", 			UsedAccordingToAverageInLastPeriod);
	CalculationParameters.AccountingPolicies.FifoWeighted.Insert("UsedInCurPeriod",   	FIFOWeightedInCurPeriodIsUsed);
	CalculationParameters.AccountingPolicies.FifoWeighted.Insert("UsedInLastPeriod",   	FIFOWeightedInLastPeriodWasUsed);
	CalculationParameters.AccountingPolicies.MovingAverage.Insert("UsedInCurPeriod",		AverageMovingAverageInCurrentPeriodIsUsed);
	CalculationParameters.AccountingPolicies.MovingAverage.Insert("UsedInLastPeriod",   UsedAverageSlidingInLastPeriod);
	CalculationParameters.AccountingPolicies.AveragePerMonth.Insert("UsedInCurPeriod",		UsingAverageInCurrentPeriod);
	CalculationParameters.AccountingPolicies.AveragePerMonth.Insert("UsedInLastPeriod",  	UsedAverageInLastPeriod);
	
	#Region VATTaxationTypes
	
	CalculationParameters.Insert("TypesOfTaxationVATIsNotIncludedInCost",
		TMCommonUseClientServer.ConvertArrayToStructureOrMatch(
			VATAccountingERP.TypesOfTaxationVATIsNotIncludedInCost(), False));
	CalculationParameters.Insert("TypesOfTaxationVATIsIncludedInCost",
		TMCommonUseClientServer.ConvertArrayToStructureOrMatch(
			VATAccountingERP.ActivitiesVATIsIncludedInCost(), False));
	
	#EndRegion
	
	#Region TypesOfValue
	
	CalculationParameters.Insert("TypesOfValueOfServices",
		Enums.AssetKinds.ArrayOfTypesOfValueOfServicesForCostAccounting());
	
	#EndRegion
	
	#Region TypesOfPrices
	
	CalculationParameters.Insert("TypeOfPlannedPrices", Catalogs.TypesOfPrices.EmptyRef());
	CalculationParameters.Insert("TypeOfPlannedPrices",
		Catalogs.TypesOfPrices.DefaultPriceType(Constants.PriceKindOfPlannedCostOfMaterialsAndWorks.Get()));
	#EndRegion
	
	CalculationOfCostLocalization.AddCalculationParameters(CalculationParameters);
	
	If Not ReducedInitialization Then
		
		// We get groups of organizations connected by Intercampany (for calculating the cost).
		If CalculationParameters.PayrollPeriod.BeginOfPeriod = CalculationParameters.DateOfMigrationToBatchAccounting22 Then
			OrganizationsForIntercampany = CalculationParameters.CompanyArray;
		Else
			OrganizationsForIntercampany = CombineArrays(
				CalculationParameters.OrganizationsWithCostRegisteredRecords,
				CalculationParameters.OrganizationsWithCostBalances);
		EndIf;
		
		If Not ValueIsFilled(OrganizationsForIntercampany) Then
			CalculationParameters.Insert("IntercampanyGroupsOfOrganizations", New Array);
		Else
			CalculationParameters.Insert("IntercampanyGroupsOfOrganizations",
				LinksOfOrganizationsUnderIntercampanyScheme(Date, OrganizationsForIntercampany, True));
		EndIf;
		
		// Cost estimation methods for each of these groups; compared with the group of organizations of the Inter-camp by the index of the element.
		CalculationParameters.Insert("MethodsOfEvaluationByGroupOfOrganizations", New Array);
		
		For Each GroupOfOrganizations In CalculationParameters.IntercampanyGroupsOfOrganizations Do
			CalculationParameters.MethodsOfEvaluationByGroupOfOrganizations.Add(
				DetermineMethodOfValuationForGroupOfOrganizations(CalculationParameters, GroupOfOrganizations));
		EndDo;
		
	EndIf;
	
	#EndRegion
	
	#Region Currencies
	
	CalculationParameters.Insert("Currencies", New Structure);
	CalculationParameters.Currencies.Insert("ManagementAccountingCurrency", Constants.ManagementAccountingCurrency.Get());
	
	#EndRegion
	
	CalculationParameters.Insert("DummyRegistrar", Undefined);
	CalculationParameters.Insert("CalculationIDForClosingMonth", Undefined);
	
	If InitializationParameters.Property("GettingListOfParameters") Then
		Return CalculationParameters; // to call a procedure from outside the mechanism in order to obtain a list of redefined calculation and debugging parameters
	EndIf;
		
	// Creates shared temporary tables for selecting data in queries.
	InitializeTemporaryTablesForSelections(CalculationParameters);
	
	// Description of registers
	InitializeMaintainedRegisters(CalculationParameters);
	
	// Creates an auxiliary temporary tables.
	InitializeAuxiliaryTemporaryTables(CalculationParameters);
	
	If ReducedInitialization Then
		Return CalculationParameters; // to call a procedure from outside the mechanism in order to initialize temporary tables
	EndIf;
	
	// Generates cost calculation documents for the calculated organizations in the IB.
	// It also generates a temporary table of the documents of the calculation of the cost and the property of the documents of the calculation of organizations.
	InitializeCostCalculationDocuments(CalculationParameters, OnlyPreliminaryCostCalculation, StartedByRoutineTask);
	
	If CalculationParameters.CalculationOption = Enums.LotAndCostCalculationOptions.LotsAndCost Then
		// Generates a temporary table for the calculation of the value of the past period, used in the mechanism of adjustments of the initial balances.
		InitializeDocumentsForCalculatingCostOfPreviousPeriod(CalculationParameters);
	EndIf;
	
	ClearOutdatedBatchCalculationDataCaches();
	
	Return CalculationParameters;
	
EndFunction

Function InitializeBasicCalculationParameters(BeginOfPeriod, EndOfPeriod, CompanyArray, BatchCalculationStarted = False, PartiesAreBeingCalculated = False) Export
	
	PayrollPeriod = New Structure;
	PayrollPeriod.Insert("BeginOfPeriod",	   	 BegOfMonth(BeginOfPeriod));
	PayrollPeriod.Insert("EndOfPeriod",  	   	 EndOfDay(EndOfPeriod));
	
	CalculationParameters = New Structure;
	CalculationParameters.Insert("PayrollPeriod",   	 PayrollPeriod);
	CalculationParameters.Insert("CompanyArray", 	 CompanyArray);
	
	CalculationParameters.Insert("BatchCalculationStarted", BatchCalculationStarted);
	CalculationParameters.Insert("PartiesAreBeingCalculated", 	 PartiesAreBeingCalculated);
	
	Return CalculationParameters;
	
EndFunction


Procedure CostCalculationMechanismIsPerformed(CalculationParameters, CostCalculationIsUnderway) Export
	
	CalculationParameters.Insert("PartiesAreBeingCalculated", Not CostCalculationIsUnderway); // is batch calculation or cost calculation being performed at the moment?
	
	If CostCalculationIsUnderway Then
		CalculationParameters.Insert("NameOfCalculationEngineModule", Metadata.CommonModules.CostCalculationCostAdjustment.Name);
	Else
		CalculationParameters.Insert("NameOfCalculationEngineModule", Metadata.CommonModules.CalculationOfCost.Name);
	EndIf;
	
	CalculationParameters.Insert("CalculationMechanismModule", Common.CommonModule(CalculationParameters.NameOfCalculationEngineModule));
	
EndProcedure

Procedure BatchesAreFilledInRegisterCostOfGoods(CalculationParameters, FillingIsUnderway) Export
	
	If FillingIsUnderway Then
		CalculationParameters.LotsAreFilledInAtCostPrice = True; // stage started
	Else
		CalculationParameters.LotsAreFilledInAtCostPrice = False;   // the stage is completed
		CalculationParameters.FilledBatchesAtCostPrice   = True; // lots in the cost price are filled
	EndIf;
	
EndProcedure

Procedure BatchesAreFilledInRegisterRevenueAndCostOfSales(CalculationParameters, FillingIsUnderway) Export
	
	If FillingIsUnderway Then
		CalculationParameters.BatchesInRevenueAreFilledIn = True; // stage started
	Else
		CalculationParameters.BatchesInRevenueAreFilledIn = False; // the stage is completed
		CalculationParameters.FilledBatchesInRevenue   = True; // the lots in the revenue are filled
	EndIf;
	
EndProcedure
	
	
// Initializes General calculation parameters that describe registers served by the calculation engine.
//
Procedure InitializeMaintainedRegisters(CalculationParameters)
	
	// The values of the register structures with the calculated turns and the register with the calculated steps determine
	// whether the calculation records (turns) will be auto-updated/balances when caching generated movements.
	// If you need to disable auto-update, then before accessing the calculation tables, you need to add a call
	// Update the accounting turnover of the Register() or update the accounting statistics of the Register()
	// First you need to update the settlement records, because these data are used when calculating balances.
	
	// The main tables of these registers cannot be accessed, because they contain the results of the previous calculation.
	CalculationParameters.Insert("RegistersWithCalculatedRevolutions", New Structure); // Vtkashcountable turnovers...
	
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.InventoryCost.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.RevenueAndCOGS.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name, True);
	
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.OtherIncome.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.OtherExpenses.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.GoodsCostVariances.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.WIPLaborCosts.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.CompanyGoods.Name, True);
	CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.FutureExpenseCommitments.Name, True);
	
	If CalculationParameters.BatchCalculationStarted Then
		// These registers are not used when calculating the cost
		CalculationParameters.RegistersWithCalculatedRevolutions.Insert(Metadata.AccumulationRegisters.MaterialsAndWorksInProduction.Name, True);
	EndIf;
	// The "real" final remnants of these registers cannot be accessed,
	// because they are incorrect - they contain the results of the previous calculation.
	CalculationParameters.Insert("RegistersWithCalculatedBalances", New Structure); // vtkashraschetnyeostatki...
	
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.InventoryCost.Name, True);
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.OtherExpenses.Name, True);
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.ItemisedExpensesLots.Name, True);
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.GoodsCostVariances.Name, True);
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name, True);
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.WIPLaborCosts.Name, True);
	CalculationParameters.RegistersWithCalculatedBalances.Insert(Metadata.AccumulationRegisters.FutureExpenseCommitments.Name, True);
	CalculationOfCostLocalization.InitializeMaintainedRegisters(CalculationParameters);
	
	// Initialize registers used by batch and cost calculation mechanisms
	MaintainedRegisters = New Map;
	CostCalculationCostAdjustment.OutgoingMechanismData(MaintainedRegisters);
	If CalculationParameters.BatchCalculationStarted Then
		CalculationOfCost.OutgoingMechanismData(MaintainedRegisters); // let's complete the list of registers
	EndIf;
	
	CalculationParameters.Insert("RegisterRecords", New Structure);
	For Each KeyAndValue In MaintainedRegisters Do
		InitializeRegisterData(CalculationParameters, KeyAndValue.Key);
	EndDo;
	
	// If necessary, a complete cleaning of all movements formed by the previous calculation is performed.
	If Not CalculationParameters.Property("DecodingDistribution")
	 And CalculationParameters.Debug.CleanUpOldRegisteredRecords Then
		ClearOldCostCalculationRegisteredRecords(CalculationParameters);
		UpdateCalculatedRegisterCaches_(CalculationParameters);
	EndIf;
	
EndProcedure

// Creates shared temporary tables for selecting data in queries.
//
Procedure InitializeTemporaryTablesForSelections(CalculationParameters) Export
	
	// To re-initialize, it is necessary to destroy all temporary tables created in this procedure.
	DestroyTemporaryTables(CalculationParameters, "TTPartnerAnalyticsSelection");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	DimensionByPartners.Ref		 				AS DimensionKey,
	|	DimensionByPartners.Organization 				AS Organization,
	|	DimensionByPartners.Counterparty					AS Counterparty,
	|	DimensionByPartners.Partner 					AS Partner,
	|	DimensionByPartners.LineOfBusiness 	AS LineOfBusiness
	|INTO TTPartnerAnalyticsSelection
	|FROM
	|	Catalog.DimensionKeysOfAccountingByPartners AS DimensionByPartners
	|WHERE
	|	DimensionByPartners.Organization IN (&CompanyArray)
	|
	|INDEX BY
	|	DimensionKey
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.DimensionKey,
	|	T.Organization
	|FROM
	|	TTPartnerAnalyticsSelection AS T
	|";
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTPartnerAnalyticsSelection");
	
	PartnerAnalyticsOrganization = New Map;
	
	Selection = Query.Execute().Select();
	
	While Selection.Next() Do
		PartnerAnalyticsOrganization.Insert(Selection.DimensionKey, Selection.Organization);
	EndDo;

	CalculationParameters.Insert("PartnerAnalyticsOrganization", PartnerAnalyticsOrganization);
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True);
	
	CalculationOfCostLocalization.InitializeTemporaryTablesForSelections(CalculationParameters);
	
EndProcedure

// Creates an auxiliary temporary tables.
//
Procedure InitializeAuxiliaryTemporaryTables(CalculationParameters) Export
	
	CalculationParameters.Insert("AuxiliaryTemporaryTables", New Structure);
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	CreateTableOfRulesForFillingInRecordTypeField(
		Query.TempTablesManager,
		CalculationParameters.RulesForFillingInRecordTypeField);
	
	InitializeAuxiliaryTemporaryTable(
		CalculationParameters,
		"TTIntermediateCostOfGoods",
		Metadata.AccumulationRegisters.InventoryCost.Name);
	
	Query.Text = 
	"SELECT TOP 0
	|	0								AS NodeNumber,
