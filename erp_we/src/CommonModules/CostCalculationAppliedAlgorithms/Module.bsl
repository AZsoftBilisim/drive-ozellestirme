#Region CurRegistersTotals

Function StateOfRegisterTotals() Export
	
	StateOfRegisterTotals = New Structure;
	
	OutgoingData = New Map;
	CalculationOfCost.OutgoingMechanismData(OutgoingData);
	CostCalculationCostAdjustment.OutgoingMechanismData(OutgoingData);
	
	For Each KeyAndValue In OutgoingData Do
		
		RegisterMetadata = KeyAndValue.Key;
		
		If Metadata.AccumulationRegisters.Contains(RegisterMetadata)
		 And RegisterMetadata.RegisterType = Metadata.ObjectProperties.AccumulationRegisterType.Balance Then
			
			RegisterManager  = AccumulationRegisters[RegisterMetadata.Name];
			RegisterState = New Structure;
			
			RegisterState.Insert("Use", 	 RegisterManager.GetPresentTotalsUsing());
			RegisterState.Insert("MinimumPeriod",  RegisterManager.GetMinTotalsPeriod());
			RegisterState.Insert("MaximumPeriod", RegisterManager.GetMaxTotalsPeriod());
			
			StateOfRegisterTotals.Insert(RegisterMetadata.Name, RegisterState);
			
		EndIf;
		
	EndDo;
	
	Return StateOfRegisterTotals;
	
EndFunction

Procedure ReturnStateOfRegisterTotalsByBackgroundJob(StateOfTotalsBeforeCalculation) Export
	
	TaskHandlerParameters = New Array;
	TaskHandlerParameters.Add(StateOfTotalsBeforeCalculation);

	BackgroundJobs.Execute(
		"CostCalculationAppliedAlgorithms.ReturnStateOfRegisterTotals",
		TaskHandlerParameters,
		,
		NStr("vi = 'Tính toán lô hàng và giá vốn, bật sử dụng tổng kết.';
			|ru = 'Расчет партий и себестоимости, включение итогов.';
			|en = 'Lot and cost calculation, enable totals.'; fa = 'Lot and cost calculation, enable totals.';
			|it = 'Calcolo dei lotti e del costo di produzione, inclusione dei totali.';
			|pl = 'Obliczanie partii i kosztu własnego, włączenie sum.';
			|tr = 'Lot ve maliyet hesaplamaları, toplamların dahil edilmesi.'", Common.DefaultLanguageCode()));
	
EndProcedure

Procedure ReturnStateOfRegisterTotals(StateOfTotalsBeforeCalculation, MaximumPeriod = Undefined) Export

	SetPrivilegedMode(True);
	
	For Each KeyAndValue In StateOfTotalsBeforeCalculation Do
		
		RegisterManager   = AccumulationRegisters[KeyAndValue.Key];
		RegisterState  = KeyAndValue.Value;
		
		If Not ValueIsFilled(MaximumPeriod) Then
			MaximumPeriod = BegOfMonth(CurrentSessionDate()) - 1; // how does the standard routine task of managing the results
		EndIf;
		
	 	ProtocolText_ = RegisterResultsManagement(
			RegisterManager,
			RegisterState.MinimumPeriod, 
			EndOfMonth(Max(RegisterState.MinimumPeriod, MaximumPeriod)),
			RegisterState.Use);
		
		If ValueIsFilled(ProtocolText_) Then
			WriteLogEvent(
				NameOfErrorEventForLog(),
				EventLogLevel.Error,
				,,
				ProtocolText_);
		EndIf;
		
	EndDo;
	
EndProcedure

// Disables the totals of the accumulation register.
// 
// Parameters:
// 	CalculationParameters - Structure -
// 	RegisterManager - AccumulationRegisterManager.InventoryCost - or any other serviced register
// 
Procedure TurnOffRegisterResults(CalculationParameters, RegisterManager)
	
	CalculationPeriod      = CalculationParameters.PayrollPeriod.BeginOfPeriod;
	MinimumPeriod  = RegisterManager.GetMinTotalsPeriod();
	MaximumPeriod = RegisterManager.GetMaxTotalsPeriod();
	
	If CalculationPeriod <= BegOfMonth(MaximumPeriod) Then
		
		ProtocolText_ = RegisterResultsManagement(
			RegisterManager,
			Min(MinimumPeriod, BegOfMonth(CalculationPeriod - 1)),
			Min(MaximumPeriod, CalculationPeriod - 1),
			False);
		
		If ValueIsFilled(ProtocolText_) Then
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
				ProtocolText_);
		EndIf;
		
	EndIf;
	
EndProcedure

Function RegisterResultsManagement(RegisterManager, MinPeriod, MaxPeriod, UsingCurTotals)
	
	AttemptsNumber = CalculationOfCostCached.ValuesOfTechnologicalParameters().NumberOfWriteAttempts;
	ErrorText = "";
	
	For AttemptNumber = 1 To AttemptsNumber Do
		
		Try
			
			If RegisterManager.GetPresentTotalsUsing() <> UsingCurTotals Then
				RegisterManager.SetPresentTotalsUsing(UsingCurTotals);
			EndIf;
			
			RegisterManager.SetMinAndMaxTotalsPeriods(
				MinPeriod,
				MaxPeriod);
				
			Break;
			
		Except
			
			If AttemptNumber <> AttemptsNumber Then
				Continue; // the error will be diagnosed on the last failed attempt
			EndIf;
			
			ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Lỗi đặt kỳ tổng kết biểu ghi ""%1"":
					|%2';
					|ru = 'Ошибка установка периода итогов регистра ""%1"":
					|%2';
					|en = 'Error when setting the register ""%1"" period totals:
					|%2'; fa = 'Error when setting the register ""%1"" period totals:
					|%2';
					|it = 'Ошибка установка периода итогов регистра ""%1"":
					|%2';
					|pl = 'Błąd ustawienie okresu wyników rejestru ""%1"":
					|%2';
					|tr = '""%1"":
					|%2 kayıt toplamlarının dönemi ayarlanırken hata'", Common.DefaultLanguageCode()),
				RegisterManager.CreateRecordSet().Metadata().Name,
				DetailErrorDescription(ErrorInfo()));
			
		EndTry;
		
	EndDo;
	
	Return ErrorText;
	
EndFunction

