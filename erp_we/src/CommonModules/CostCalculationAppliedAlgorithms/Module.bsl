#Region DataValidation

#Region CheckingInitialAndFinalData

// Checks the correctness of the cost balances, as well as performing routine operations that precede the calculation.
//
Procedure CheckCorrectnessOfSourceDataBeforeCalculation(CalculationParameters) Export
	
	If Not (CalculationParameters.PartiesAreBeingCalculated
	  Or Not CalculationParameters.BatchCalculationStarted) Then
		Return; // it is necessary either at the beginning of the calculation of batches, or at the beginning of a separate cost calculation
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "CheckCorrectnessOfSourceDataBeforeCalculation");
	
	// We will get the results of the check and put them in the protocol.
	TableOfChecks = AuditOfSystemState.TableOfChecksByContext(
		Catalogs.MonthEndClosingOperations.LotsAndCostCalculation,
		Enums.TimeOfStartingMonthEndClosingOperationCheck.BeforeCalculation);
		
	ObjectsTable = AuditOfSystemState.TableOfSystemStateProblemObjects(
		TableOfChecks.UnloadColumn("Validation"),
		CalculationParameters.CompanyArray,
		CalculationParameters.PayrollPeriod.BeginOfPeriod,
		CalculationParameters.PayrollPeriod.EndOfPeriod);
	
	For Each ErrorDescription In ObjectsTable Do
			
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorInSourceDataForCalculation,
			ErrorDescription.ObjectPresentation);
		
	EndDo;
	
	CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
		CalculationParameters,
		ObjectsTable.Count());
	
EndProcedure

// Checks for incorrect cost balances resulting from the calculation.
//
Procedure CheckCorrectnessOfBalancesInRegisterCostOfGoodsAfterCalculation(CalculationParameters)
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "CheckCorrectnessOfBalancesInRegisterCostOfGoodsAfterCalculation");
	
	TableOfChecks = AuditOfSystemState.TableOfChecksByContext(Catalogs.MonthEndClosingOperations.LotsAndCostCalculation);
	
	For Each CurrRow In TableOfChecks Do
		
		If CurrRow.AccountingCheckContextClarification <> Enums.TimeOfStartingMonthEndClosingOperationCheck.BeforeAndAfterCalculation
		 And CurrRow.AccountingCheckContextClarification <> Enums.TimeOfStartingMonthEndClosingOperationCheck.AfterCalculation Then
			Continue; // we perform checks after calculation
		EndIf;
		
		CostCalculationProtocol.StartOfCodeSnippetExecution(
			CalculationParameters,
			CurrRow.Id,
			NStr("vi = 'Kiểm tra thực hiện';
				|ru = 'Выполнение проверки';
				|en = 'Check'; fa = 'چک';
				|it = 'Verifiche effettuate';
				|pl = 'Wykonanie weryfikacji';
				|tr = 'Kontrol gerçekleştirme'", Common.DefaultLanguageCode()) + " " + CurrRow.Id);
			
		// Let's perform a check.
		ValidationCalculationParameters = DataProcessors.MonthEndClosingOperations.InitializeCalculationParametersStructure(
			CalculationParameters.PayrollPeriod.BeginOfPeriod,
			CalculationParameters.PayrollPeriod.EndOfPeriod,
			CalculationParameters.CompanyArray,
			CalculationParameters.MonthEndClosingMode);
		
		ValidationCalculationParameters.Insert("AutoTesting", CalculationParameters.AutoTesting);
		ValidationCalculationParameters.Insert("CheckingBeforeCalculation",    	    False);
		ValidationCalculationParameters.Insert("CheckingAfterCalculation", 	    True);
		ValidationCalculationParameters.Insert("ResultIsInRegistrationLog",False);
		
		CheckResult = AuditOfSystemState.CheckSystemState(
			CurrRow.Validation,
			ValidationCalculationParameters);
			
		// We will get the results of the check and put them in the protocol.
		IssuesCount = 0;
		
		For Each IdentifiedProblem In CheckResult.IdentifiedProblems Do
			
			If IdentifiedProblem.Importance <> Enums.AccountingIssueSeverity.Error Then
				Continue;
			EndIf;
				
			IssuesCount = IssuesCount + IdentifiedProblem.Objects.Count();
			
			For Each ErrorDescription In IdentifiedProblem.Objects Do
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorInBalanceAfterCalculation,
					ErrorDescription.Presentation);
				
			EndDo;
			
		EndDo;
		
		CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
		
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			IssuesCount);
		
	EndDo;
	
EndProcedure

