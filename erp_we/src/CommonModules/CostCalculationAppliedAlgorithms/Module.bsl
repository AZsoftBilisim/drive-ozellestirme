// * DateOfMigrationToBatchAccounting22 - Date -
// * BatchAccountingVersion22 - Boolean -
// * BatchAccountingVersion21 - Boolean, Undefined -
// * BatchAccountingNotUsed - Boolean -
// * VNAManagementIsUsed_2_4 - Boolean -
// * CompanyManagementAccounting - Boolean -
// * FEDERALDISTRICT - Structure -
// * CalculationID - UUID -  
// * TotalNumberOfFederalLaws - Number -
// * CalculationTaskTable - ValueTable -:
// ** JobID - UUID - 
// ** JobKey - String -
// ** CalculationID - UUID - 
// * TotalNumberOfFederalLawEntries - Number -
// * RecordJobTable - ValueTable -:
// ** JobID - UUID - 
// ** PreviousTask_ - UUID - 
// ** RegisterName - String - 
// ** NumberOfRegisteredRecords - Number - 
// * StackOfWriteJobs - Array of UUID -
// * DataStackForWriting - Array of Structure -
// * PreliminaryCalculation - Boolean -
// * ScheduledJob - Boolean -
// * FileInfobase - Boolean -
