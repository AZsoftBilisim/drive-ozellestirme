// Procedure-handler for checking the state of the system "costdistributed cost".
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure VerificationOfCostsNotAllocatedToCost(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	QueryText =
	"SELECT
	|	T.Ref AS Ref
	|INTO TTExpenditureItemsOfMan
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS T
	|WHERE
	|	T.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Ref AS Ref
	|INTO TTLocalExpenditureItems
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS T
	|WHERE
	|	T.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|	AND T.CostAllocationOptionTax = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.LineOfBusiness,
	|	SUM(T.Sum) AS Sum,
	|	SUM(T.AmountExcludingVAT) AS AmountExcludingVAT,
	|	SUM(T.PermanentDifference) AS PermanentDifference,
	|	SUM(T.CostTD) AS CostTD,
	|	SUM(T.AITAmount) AS AITAmount,
	|	SUM(T.SumCompl) AS SumCompl
	|INTO TTAllBalancesOfUnallocatedExpenses
	|FROM
	|	(SELECT
	|		T.Organization AS Organization,
	|		T.Department AS Department,
	|		T.ExpenseItem AS ExpenseItem,
	|		T.DimensionOfExpenses AS DimensionOfExpenses,
	|		T.LineOfBusiness AS LineOfBusiness,
	|		T.SumBalance AS Sum,
	|		T.AmountExcludingVATBalance AS AmountExcludingVAT,
	|		0 AS PermanentDifference,
	|		0 AS CostTD,
	|		0 AS AITAmount,
	|		0 AS SumCompl
	|	FROM
	|		AccumulationRegister.OtherExpenses.Balance(
	|			&BorderEndOfPeriod,
	|			Organization IN (&CompanyArray)
	|			AND ExpenseItem IN
	|				(SELECT
	|					T.Ref
	|				FROM
	|					TTExpenditureItemsOfMan AS T)) AS T
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		T.Organization AS Organization,
	|		T.Department AS Department,
	|		T.ExpenseItem AS ExpenseItem,
	|		T.DimensionOfExpenses AS DimensionOfExpenses,
	|		T.LineOfBusiness AS LineOfBusiness,
	|		0 AS Sum,
	|		0 AS AmountExcludingVAT,
	|		T.PermanentDifferenceBalance AS PermanentDifference,
	|		T.CostTDBalance AS CostTD,
	|		T.AITAmountBalance AS AITAmount,
	|		T.SumComplBalance AS SumCompl
	|	FROM
	|		AccumulationRegister.OtherExpenses.Balance(
	|			&BorderEndOfPeriod,
	|			Organization IN (&CompanyArray)
	|			AND ExpenseItem IN
	|				(SELECT
	|					T.Ref
	|				FROM
	|					TTLocalExpenditureItems AS T)) AS T) AS T
	|GROUP BY
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.LineOfBusiness
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.LineOfBusiness,
	|	T.Sum AS Sum,
	|	T.AmountExcludingVAT AS AmountExcludingVAT,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	|	T.AITAmount AS AITAmount,
	|	T.SumCompl AS SumCompl
	|INTO TTBalancesOfUnallocatedExpenses
	|FROM
	|	TTAllBalancesOfUnallocatedExpenses AS T
	|WHERE
	|	&CriteriaForSelectionByDateOfAnalyticsDocument
	|	AND &ConditionOfSelectionAccordingToConductedDocumentsOfAnalytics
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization,
	|	T.Department,
	|	T.ExpenseItem,
	|	T.DimensionOfExpenses,
	|	T.LineOfBusiness,
	|	T.Sum AS Sum,
	|	T.AmountExcludingVAT AS AmountExcludingVAT,
	|	T.PermanentDifference AS PermanentDifference,
	|	T.CostTD AS CostTD,
	|	T.AITAmount AS AITAmount,
	|	T.SumCompl AS SumCompl
	|INTO TTBalancesOfUnallocatedExpensesForIncorrectAnalysts
	|FROM
	|	TTAllBalancesOfUnallocatedExpenses AS T
	|WHERE
	|	&CriteriaForSelectionByDateOfAnalyticsDocument
	|	AND &SelectionCriteriaForUnverifiedAnalyticsDocuments";
	
	// Let's add a selection by the Expense Analyticsfield:
	// if a document is specified in the analytics and its date is in the following periods, then we do not register an error for such expenses.
	TextAndDate = "";
	// We will also divide the remaining expenses by conducted and unverified analytics documents.
	TextSelectionConducted = "";
	TextOfSelectionWasNotCarriedOut = "";
	
	DescriptionOfDocumentTypes = CostCalculationUniversalAlgorithms.DescriptionOfDocumentTypes();
	
	For Each Current_Type In Metadata.ChartsOfCharacteristicTypes.ExpenseItems.Type.Types() Do
		
		If Not DescriptionOfDocumentTypes.ContainsType(Current_Type) Then
			Continue;
		EndIf;
		
		DocumentName = Metadata.FindByType(Current_Type).Name;
		
		TextAndDate = TextAndDate + "
		|		WHEN T.DimensionOfExpenses REFS Document." + DocumentName + "
		|			THEN CAST(T.DimensionOfExpenses AS Document." + DocumentName + ").Date";
		
		TextSelectionConducted = TextSelectionConducted + "
		|		WHEN T.DimensionOfExpenses REFS Document." + DocumentName + "
		|			THEN CAST(T.DimensionOfExpenses AS Document." + DocumentName + ").Posted";
		
	EndDo;
	
	If IsBlankString(TextAndDate) Then
		
		TextAndDate = "TRUE";
		TextSelectionConducted = "TRUE";
		TextOfSelectionWasNotCarriedOut = "FALSE";
		
	Else
		
		TextAndDate =
			"	ISNULL(
			|		CASE" + TextAndDate + //@Query-part
			"		ELSE NULL
			|		END, DATETIME(1,1,1)) <= &EndOfPeriod";
		
		TextOfSelectionWasNotCarriedOut =
			"	ISNULL(
			|		CASE" + TextSelectionConducted + //@Query-part
			"		ELSE NULL
