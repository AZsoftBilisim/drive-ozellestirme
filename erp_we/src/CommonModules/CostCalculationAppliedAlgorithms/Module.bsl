#Region TableColumns

// Returns a template string containing the names of all columns of the passed object.
// 
// Parameters:
//  SourceOfColumns - ValueTable, QueryResult, QueryResultSelection, ValueTableColumnCollection - Source Of Columns
//  ColumnsToExclude - String - Excluded columns
//  WithoutPrefix - Boolean - Don't add the %1 prefix
// 
// Returns:
//  String - comma-separated list of columns
Function GetColumnNamesAsString(SourceOfColumns, ColumnsToExclude = "", WithoutPrefix = False) Export
	
	If TypeOf(SourceOfColumns) = Type("ValueTable")
	 Or TypeOf(SourceOfColumns) = Type("QueryResult") Then
		Columns = SourceOfColumns.Columns;
	ElsIf TypeOf(SourceOfColumns) = Type("QueryResultSelection") Then
		Columns = SourceOfColumns.Owner().Columns;
	Else
		Columns = SourceOfColumns;
	EndIf;
	
	ColumnsNames = "";
	StructureExcludedColumns = New Structure(ColumnsToExclude);
	
	For Each Column In Columns Do
		
		If Not StructureExcludedColumns.Property(Column.Name) Then
			ColumnsNames = ColumnsNames + ?(ColumnsNames = "", "", ", ") + ?(WithoutPrefix, "", "%1") + Column.Name;
		EndIf;
		
	EndDo;
	
	Return ColumnsNames;
	
EndFunction

// Common columns of the data source and receiver.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//  SourceData - ValueTable, QueryResult, QueryResultSelection - Data source
//  DestinationName - String - the name of the temporary table or register of the data receiver
// 
// Returns:
//  String - Comma-separated common columns of the data source and receiver
Function CommonColumnsOfDataSourceAndReceiver(CalculationParameters, SourceData, DestinationName) Export
	
	If CalculationParameters.RegisterRecords.Property(DestinationName) Then
		ReceiverDescription = CalculationParameters.RegisterRecords[DestinationName];
	Else
		ReceiverDescription = CalculationParameters.AuxiliaryTemporaryTables[DestinationName];
	EndIf;
	
	Result = SharedDataContainerColumns(SourceData, ReceiverDescription.Table);
	
	Return Result;
	
EndFunction

// Common columns of the data source and receiver.
// 
// Parameters:
//  Source - ValueTable, QueryResult, QueryResultSelection - Data source
//  Receiver - ValueTable - Data Receiver
// 
// Returns:
//  String - Comma-separated common columns of the data source and receiver
Function SharedDataContainerColumns(Source, Receiver) Export

	DestinationColumns = New Structure(GetColumnNamesAsString(Receiver,, True));
	SourceColumns = New Structure(GetColumnNamesAsString(Source,, True));
	
	Result = "";
	
	For Each KeyAndValue In DestinationColumns Do
		If SourceColumns.Property(KeyAndValue.Key) Then
			Result = Result + ?(Result = "", "", ",") + KeyAndValue.Key;
		EndIf;
	EndDo;
	
	Return Result;
	
EndFunction

// Fills in the type of columns whose value type contains an empty array of types.
// 
// Parameters:
//  Table - ValueTable - Data source
//  AddedType - Type, Array of Type, Undefined - new type for a column with an empty type
// 
Procedure CorrectTypingOfColumnsInTableOfValues(Table, AddedType = Undefined) Export
	
	FixedColumns = New Array;
	
	If AddedType = Undefined Then 
		
		NewColumnType = Documents.AllRefsType().Types();
		CommonClientServer.SupplementArray(NewColumnType, Catalogs.AllRefsType().Types());
		CommonClientServer.SupplementArray(NewColumnType, ChartsOfCharacteristicTypes.AllRefsType().Types());
		NewColumnType.Add(Type("String"));
		NewColumnType.Add(Type("Number"));
		NewColumnType.Add(Type("Date"));
		NewColumnType.Add(Type("Boolean"));
		
	Else
		NewColumnType = TMCommonUseClientServer.Array(AddedType);
	EndIf;
	
	For Each CurrentColumn In Table.Columns Do
		If CurrentColumn.ValueType.Types().Count() = 0 Then
			FixedColumns.Add(CurrentColumn.Name);
		EndIf;
	EndDo;
	
	For Each ColumnName In FixedColumns Do
		
		TemporaryColumnName = ColumnName + "Corrected_";
		
		Table.Columns.Add(TemporaryColumnName, New TypeDescription(NewColumnType));
		Table.LoadColumn(Table.UnloadColumn(ColumnName), TemporaryColumnName);
		Table.Columns.Delete(ColumnName);
		Table.Columns[TemporaryColumnName].Name = ColumnName;
		
	EndDo;
	
EndProcedure

// Adds synonyms of the same name to the line with column names.
// 
// Parameters:
//		ColumnsNames - String - a string with column names separated by a comma.
//		TableName - String - synonym for the table from which the data is selected.
//
// Returns:
//		String - a string with column names and synonyms of the same name, separated by a comma.
//
Function AddSynonymsToColumns(ColumnsNames, TableName) Export
	
	ArrayOfColumnNames = StrSplit(StrReplace(StrReplace(ColumnsNames, Chars.LF, ""), " ", ""), ",", False);
	ArrayOfColumnNamesWithSynonyms = New Array;
	For Each ColumnName In ArrayOfColumnNames Do
		ArrayOfColumnNamesWithSynonyms.Add(StrTemplate("%1.%2 AS %2", TableName, ColumnName)); //@Query-part
	EndDo;
	
	Return StrConcat(ArrayOfColumnNamesWithSynonyms, ",");
	
EndFunction

