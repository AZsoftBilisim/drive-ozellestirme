#Region Testing

Function ServiceSymbol_CalculationInterruptedForDebugging() Export
	Return "#CalculationInterruptedForDebugging";
EndFunction

Function CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, CurCalculationStep, CancelCalculation = True)
	
	DebugParameters = CalculationParameters.DebugParameters;
	
	If Not DebugParameters.Property("StageForDebugging") Then
		Return False; // the calculation is not started for debugging the calculation stage
	ElsIf CalculationParameters.PayrollPeriod.BeginOfPeriod <> BegOfMonth(DebugParameters.Period) Then
		Return False; // another period is being debugged
	ElsIf Lower(CalculationParameters.PresentationStage) <> Lower(DebugParameters.StageForDebugging) Then
		Return False; // another stage is being debugged
	ElsIf CancelCalculation And Lower(CurCalculationStep) <> Lower(DebugParameters.CalculationStepForDebugging) Then
		Return False; // another calculation step is being debugged
	EndIf;
	
	If CancelCalculation Then
		
		InformationRegisters.PerformMonthEndClosingOperations.SetEndOfCalculationFlag(CalculationParameters.CalculationIDForClosingMonth);
		
		Raise ServiceSymbol_CalculationInterruptedForDebugging();
	EndIf;
	
	Return True;
	
EndFunction

Procedure CheckConditionForSearchingForRegisteredRecordsWhenCalculating(CalculationParameters) Export
	
	NameOfMotionSearchRegister = CalculationParameters.DebugParameters.NameOfMotionSearchRegister;
	MotionSearchCondition = CalculationParameters.DebugParameters.MotionSearchCondition;
	
	If Not CalculationParameters.RegisterRecords.Property(NameOfMotionSearchRegister) Then
		Return;
	EndIf;
	
	RegisterDescription = CalculationParameters.RegisterRecords[NameOfMotionSearchRegister];
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT TOP 1
	|	TRUE AS IsRecord
	|FROM
	|	CacheTableName
	|WHERE
	|	&SearchCondition";
	
	Query.Text = StrReplace(Query.Text, "CacheTableName", RegisterDescription.RegisterCacheTableName);
	Query.Text = StrReplace(Query.Text, "&SearchCondition", MotionSearchCondition);
	
	QueryResult = Query.Execute();
	
	If Not QueryResult.IsEmpty() Then
		
		CurStageDescription = CalculationParameters.CalculationProtocol.Stages.Get(CalculationParameters.CalculationProtocol.Stages.Count()-1);
		
		Common.MessageToUser(
			NStr("vi = 'Đã tìm thấy bản ghi kết chuyển mà đáp ứng các điều kiện tìm kiếm';
				|ru = 'Найдено движение, удовлетворяющее условиям поиска';
				|en = 'Found a register record matching your search'; fa = 'Found a register record matching your search';
				|it = 'Trovato movimento che soddisfa le condizioni di ricerca';
				|pl = 'Wykryto przepływ, spełniający warunki wyszukiwania';
				|tr = 'Arama koşullarını karşılayan bir hareket bulundu'") + ": "
			+ CurStageDescription.PresentationStage + Chars.LF
			+ NStr("vi = 'Ngắt tính toán.';
					|ru = 'Расчет прерван.';
					|en = 'Calculation is canceled.'; fa = 'Calculation is canceled.';
					|it = 'Calcolo interrotto.';
					|pl = 'Obliczenie zostało przerwane.';
					|tr = 'Hesaplama iptal edildi.'"));
		
		Raise ServiceSymbol_CalculationInterruptedForDebugging() + " " + CurStageDescription.PresentationStage;
		
	EndIf;
	
EndProcedure

