// Registers documents with changed movements to be reflected in international accounting.
//
Procedure RequirementsForReflectionInInternationalAccounting(CalculationParameters)
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "RequirementsForReflectionInInternationalAccounting");
	
	If Not ValueIsFilled(CalculationParameters.SamplingRestrictions.NumberOfGnzRecords) Then
		// For debugging - calculation without changing the IB data
		Return;
	EndIf;
	
	// Let's supplement the general table with the documents of non-current assets
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text = "
	|SELECT DISTINCT
	|	ModifiedDocuments.Organization AS Organization,
	|	ModifiedDocuments.Period AS Period,
	|	ModifiedDocuments.Recorder
	|INTO TTDocumentsForReflection
	|FROM
	|	TTModifiedDocuments AS ModifiedDocuments
	|WHERE
	|	ModifiedDocuments.AffectsTransactions
	|	AND &TTDocumentsForReflectionLocalization
	|
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	SourceTable.Period AS Period,
	|	SourceTable.Document AS Document,
	|	SourceTable.Organization AS Organization,
	|	SourceTable.DateRecord AS DateRecord
	|INTO DocumentsToBeReflected
	|FROM
	|	(SELECT
	|		ISNULL(RegisterData.Period, TTDocumentsForReflection.Period) AS Period,
	|		TTDocumentsForReflection.Recorder AS Document,
	|		TTDocumentsForReflection.Organization AS Organization,
	|		BEGINOFPERIOD(TTDocumentsForReflection.Period, DAY) AS DateRecord
	|	FROM
	|		TTDocumentsForReflection AS TTDocumentsForReflection
	|			LEFT JOIN InformationRegister.DocumentPostingInFinancialAccounting AS RegisterData
	|			ON TTDocumentsForReflection.Recorder = RegisterData.Recorder
	|				AND TTDocumentsForReflection.Organization = RegisterData.Organization
	|				AND (RegisterData.Active)
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		RegisterRecordsProductsIncomeExpenses.Period AS Period,
	|		RegisterRecordsProductsIncomeExpenses.Recorder,
	|		RegisterRecordsProductsIncomeExpenses.Organization,
	|		BEGINOFPERIOD(RegisterRecordsProductsIncomeExpenses.Period,DAY)
	|	FROM
	|		TTCashFlowProductsIncomeExpenses AS RegisterRecordsProductsIncomeExpenses
	|			INNER JOIN TTModifiedDocuments AS ModifiedDocuments
	|			ON RegisterRecordsProductsIncomeExpenses.Recorder = ModifiedDocuments.Recorder
	|				AND RegisterRecordsProductsIncomeExpenses.Organization = ModifiedDocuments.Organization
	|				AND RegisterRecordsProductsIncomeExpenses.Period = ModifiedDocuments.Period
	|				AND ModifiedDocuments.RegisterName = ""RegisterRecordsProductsIncomeExpenses""
	|				AND (RegisterRecordsProductsIncomeExpenses.BusinessOperation IN (
	|					VALUE(Enum.BusinessTransactions.ExpensesFromGoodsRevaluation),
	|					VALUE(Enum.BusinessTransactions.IncomeFromGoodsRevaluation)))
	|
	|	) AS SourceTable
	|
	|GROUP BY
	|	SourceTable.Period,
	|	SourceTable.Document,
	|	SourceTable.Organization,
	|	SourceTable.DateRecord
	|
	|INDEX BY
	|	Period,
	|	Document,
	|	Organization,
	|	DateRecord
	|";
	QueryTextTTDocumentsToBeReflectedLocalization = CalculationOfCostLocalization.QueryTextTTDocumentsToBeReflectedLocalization();
	If Not IsBlankString(QueryTextTTDocumentsToBeReflectedLocalization) Then
		Query.Text = StrReplace(Query.Text, "AND &TTDocumentsForReflectionLocalization", QueryTextTTDocumentsToBeReflectedLocalization);
	Else
		Query.Text = StrReplace(Query.Text, "AND &TTDocumentsForReflectionLocalization", "");
	EndIf;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "DocumentsToBeReflected", True);
	
	AccountingReflectionParameters = CostCalculationAppliedAlgorithms.InitializeReflectionParametersInAccounting(
		CalculationParameters,
		NStr("vi = 'Phản ánh vào kế toán quốc tế';
			|ru = 'Отражение в международном учете';
			|en = 'General ledger posting'; fa = 'ثبت در دفتر کل';
			|it = 'Visualizzazione in contabilità internazionale';
			|pl = 'Odzwierciedlenie w ewidencji międzynarodowej';
			|tr = 'Uluslararası muhasebede geçerlilik'", Common.DefaultLanguageCode()),
		"FinancialAccountingPostingServer.ReturnDocumentsToReflection",
		"DocumentsToBeReflected",
		True);
	
	CostCalculationAppliedAlgorithms.ReflectDocumentsInAccounting(CalculationParameters, AccountingReflectionParameters);
	
	DestroyTemporaryTables(CalculationParameters, "TTDocumentsForReflection, DocumentsToBeReflected");
	
EndProcedure

Procedure CreateTasksForCalculatingReservesForImpairmentOfInventories(CalculationParameters)
	
	If CalculationParameters.CalculationOption <> Enums.LotAndCostCalculationOptions.LotsAndCost Then
		Return;
	EndIf;
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text = "
	|SELECT DISTINCT
	|	&BeginOfPeriod 		AS Month,
	|	Rules.Owner	AS Organization,
	|	VALUE(Catalog.MonthEndClosingOperations.AccualOfInventoryImpairmentProvision) AS Operation
	|FROM
	|	Catalog.RulesForCalculationOfInventoryImpairmentProvision AS Rules
	|WHERE
	|	Rules.Owner IN (&CompanyArray)
	|	AND &BatchAccountingVersion22
	|	AND BEGINOFPERIOD(Rules.ValidOnDate, MONTH) <= &BeginOfPeriod
	|	AND (ENDOFPERIOD(Rules.ValidToDate, MONTH) >= &EndOfPeriod
	|		OR Rules.ValidToDate = DATETIME(1,1,1))
	|	AND (Rules.LocalAccounting
	|		OR Rules.ManagementAccounting)
	|";
	
	InformationRegisters.JobsForMonthEndClosing.CreateRegisterEntriesBasedOnSampleData(Query.Execute().Select());
	
EndProcedure

Procedure CreateTasksForRecognizingResearchAndDevelopmentExpenses(CalculationParameters)
	
	If CalculationParameters.CalculationOption <> Enums.LotAndCostCalculationOptions.LotsAndCost Then
		Return;
	EndIf;
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text = "
	|SELECT DISTINCT
	|	&BeginOfPeriod 		AS Month,
	|	T.Organization		AS Organization,
	|	VALUE(Catalog.MonthEndClosingOperations.RDExpenseRecognition) AS Operation
	|FROM
	|	AccumulationRegister.OtherExpenses AS T
	|	INNER JOIN TTModifiedDocuments AS ModifiedDocuments
	|		ON T.Recorder = ModifiedDocuments.Recorder
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN (&CompanyArray)
	|	AND T.DimensionOfExpenses REFS Catalog.RDTopicsStages
	|	AND T.Active
	|";
	
	InformationRegisters.JobsForMonthEndClosing.CreateRegisterEntriesBasedOnSampleData(Query.Execute().Select());
	
EndProcedure


