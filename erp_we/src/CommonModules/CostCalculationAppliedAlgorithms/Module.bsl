// Procedure-handler for checking the state of the system "Conformancesummicolicity".
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure CheckingCorrespondenceOfAmountsAndQuantities(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	QueryText =
	"SELECT
	|	T.AccountingSection 									AS AccountingSection,
	|	T.InventoryOwnerAttribute 									AS InventoryOwnerAttribute,
	|	T.Organization 									AS Organization,
	|	T.ItemsLocationAttributes 					AS ItemsLocationAttributes,
	|	T.Lot 										AS Lot,
	|	T.LotVendorAttributes 							AS LotVendorAttributes,
	|	T.FinancialAccountingDimension 					AS FinancialAccountingDimension,
	|	T.VATActivityType 							AS VATActivityType,
	|
	|	SUM(T.Character * T.Count) 					AS Count,
	|
	|	SUM(T.Character * T.Cost) 					AS Cost,
	|	SUM(T.Character * T.CostExcludingVAT) 				AS CostExcludingVAT,
	|	SUM(T.Character * T.AddExpensesForGoods) 					AS AddExpensesForGoods,
	|	SUM(T.Character * T.AdditionalExpensesExcludingVAT) 				AS AdditionalExpensesExcludingVAT,
	|	SUM(T.Character * T.PermanentDifference) 			AS PermanentDifference,
	|	SUM(T.Character * T.CostTD) 				AS CostTD,
	|	SUM(T.Character * T.CostOfPersonalIncomeTax) 					AS CostOfPersonalIncomeTax,
	|	SUM(T.Character * T.LocalCost) 				AS LocalCost,
	|	SUM(T.Character * T.OffBalanceCost) 		AS OffBalanceCost,
	|	SUM(T.Character * T.LaborCosts) 					AS LaborCosts,
	|	SUM(T.Character * T.ItemizedFixedCostsIncludingVAT) 	AS ItemizedFixedCostsIncludingVAT,
	|	SUM(T.Character * T.ItemizedFixedCostsExcludingVAT) 	AS ItemizedFixedCostsExcludingVAT,
	|	SUM(T.Character * T.ItemizedVariableCostsIncludingVAT) 	AS ItemizedVariableCostsIncludingVAT,
	|	SUM(T.Character * T.ItemizedVariableCostsExcludingVAT) 	AS ItemizedVariableCostsExcludingVAT,
	|	SUM(T.Character * T.OffBalanceCostLocal)		AS OffBalanceCostLocal,
	|	SUM(T.Character * T.AddExpensesLocal) 				AS AddExpensesLocal,
	|	SUM(T.Character * T.LaborCostsLocal) 				AS LaborCostsLocal,
	|	SUM(T.Character * T.ItemizedFixedCostsCompl) 	AS ItemizedFixedCostsCompl,
	|	SUM(T.Character * T.ItemizedVariableCostsCompl) 	AS ItemizedVariableCostsCompl,
	|	SUM(T.Character * T.CostMan) 					AS CostMan,
	|	SUM(T.Character * T.AddExpensesMan) 				AS AddExpensesMan,
	|	SUM(T.Character * T.LaborCostsMan) 				AS LaborCostsMan,
	|	SUM(T.Character * T.ItemizedFixedCostsManag)		AS ItemizedFixedCostsManag,
	|	SUM(T.Character * T.ItemizedVariableCostsManag)		AS ItemizedVariableCostsManag,
	|	SUM(T.Character * T.ProvisionForImpairmentMan)		AS ProvisionForImpairmentMan,
	|	SUM(T.Character * T.ProvisionForImpairmentLocal)		AS ProvisionForImpairmentLocal
	|INTO TTBalance
	|FROM
	|	(SELECT
	|		T.AccountingSection 							AS AccountingSection,
	|		T.InventoryOwnerAttribute 							AS InventoryOwnerAttribute,
	|		T.Organization 							AS Organization,
	|		T.ItemsLocationAttributes 			AS ItemsLocationAttributes,
	|		T.Lot 								AS Lot,
	|		T.LotVendorAttributes 					AS LotVendorAttributes,
	|		T.FinancialAccountingDimension 			AS FinancialAccountingDimension,
	|		T.VATActivityType 					AS VATActivityType,
	|		
	|		1										AS Character,
	|		T.CountBalance 					AS Count,
	|		
	|		T.CostBalance 						AS Cost,
	|		T.CostExcludingVATBalance 				AS CostExcludingVAT,
	|		T.AddExpensesForGoodsBalance 					AS AddExpensesForGoods,
	|		T.AdditionalExpensesExcludingVATBalance 				AS AdditionalExpensesExcludingVAT,
	|		T.PermanentDifferenceBalance 				AS PermanentDifference,
	|		T.CostTDBalance 				AS CostTD,
	|		T.CostOfPersonalIncomeTaxBalance 					AS CostOfPersonalIncomeTax,
	|		T.LocalCostBalance 					AS LocalCost,
	|		T.OffBalanceCostBalance 			AS OffBalanceCost,
	|		T.LaborCostsBalance 					AS LaborCosts,
	|		T.ItemizedFixedCostsIncludingVATBalance 		AS ItemizedFixedCostsIncludingVAT,
	|		T.ItemizedFixedCostsExcludingVATBalance 	AS ItemizedFixedCostsExcludingVAT,
	|		T.ItemizedVariableCostsIncludingVATBalance 		AS ItemizedVariableCostsIncludingVAT,
	|		T.ItemizedVariableCostsExcludingVATBalance 	AS ItemizedVariableCostsExcludingVAT,
	|		T.OffBalanceCostLocalBalance 		AS OffBalanceCostLocal,
	|		T.AddExpensesLocalBalance 				AS AddExpensesLocal,
	|		T.LaborCostsLocalBalance 				AS LaborCostsLocal,
	|		T.ItemizedFixedCostsComplBalance 		AS ItemizedFixedCostsCompl,
	|		T.ItemizedVariableCostsComplBalance 		AS ItemizedVariableCostsCompl,
	|		T.CostManBalance 					AS CostMan,
	|		T.AddExpensesManBalance 					AS AddExpensesMan,
	|		T.LaborCostsManBalance 				AS LaborCostsMan,
	|		T.ItemizedFixedCostsManagBalance 		AS ItemizedFixedCostsManag,
	|		T.ItemizedVariableCostsManagBalance 		AS ItemizedVariableCostsManag,
	|		T.ProvisionForImpairmentManBalance 		AS ProvisionForImpairmentMan,
	|		T.ProvisionForImpairmentLocalBalance 		AS ProvisionForImpairmentLocal
	|	FROM
	|		AccumulationRegister.InventoryCost.Balance(
	|			&BorderEndOfPeriod, Organization IN (&CompanyArray)) AS T
	|
	|	UNION ALL
	|
	// We exclude from the balances at the end of the period the movements that form the initial balances for batch accounting version 2.2.
	|	SELECT
	|		T.AccountingSection 						AS AccountingSection,
	|		T.InventoryOwnerAttribute 						AS InventoryOwnerAttribute,
	|		T.Organization 						AS Organization,
	|		T.ItemsLocationAttributes 		AS ItemsLocationAttributes,
	|		T.Lot 							AS Lot,
	|		T.LotVendorAttributes 				AS LotVendorAttributes,
	|		T.FinancialAccountingDimension 		AS FinancialAccountingDimension,
	|		T.VATActivityType 				AS VATActivityType,
	|		
	|		CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
	|			THEN -1
	|			ELSE 1
	|		END								AS Character,
	|		T.Count 						AS Count,
	|		
	|		T.Cost 						AS Cost,
	|		T.CostExcludingVAT 					AS CostExcludingVAT,
	|		T.AddExpensesForGoods 						AS AddExpensesForGoods,
	|		T.AdditionalExpensesExcludingVAT 					AS AdditionalExpensesExcludingVAT,
	|		T.PermanentDifference 				AS PermanentDifference,
	|		T.CostTD 					AS CostTD,
	|		T.CostOfPersonalIncomeTax 						AS CostOfPersonalIncomeTax,
	|		T.LocalCost 					AS LocalCost,
	|		T.OffBalanceCost 			AS OffBalanceCost,
	|		T.LaborCosts 						AS LaborCosts,
	|		T.ItemizedFixedCostsIncludingVAT 		AS ItemizedFixedCostsIncludingVAT,
	|		T.ItemizedFixedCostsExcludingVAT 		AS ItemizedFixedCostsExcludingVAT,
	|		T.ItemizedVariableCostsIncludingVAT 		AS ItemizedVariableCostsIncludingVAT,
	|		T.ItemizedVariableCostsExcludingVAT 		AS ItemizedVariableCostsExcludingVAT,
	|		T.OffBalanceCostLocal 		AS OffBalanceCostLocal,
	|		T.AddExpensesLocal 					AS AddExpensesLocal,
	|		T.LaborCostsLocal 					AS LaborCostsLocal,
	|		T.ItemizedFixedCostsCompl 		AS ItemizedFixedCostsCompl,
	|		T.ItemizedVariableCostsCompl 		AS ItemizedVariableCostsCompl,
	|		T.CostMan 						AS CostMan,
	|		T.AddExpensesMan 					AS AddExpensesMan,
	|		T.LaborCostsMan 					AS LaborCostsMan,
	|		T.ItemizedFixedCostsManag 			AS ItemizedFixedCostsManag,
	|		T.ItemizedVariableCostsManag 			AS ItemizedVariableCostsManag,
	|		T.ProvisionForImpairmentMan 			AS ProvisionForImpairmentMan,
	|		T.ProvisionForImpairmentLocal 			AS ProvisionForImpairmentLocal
	|	FROM
	|		AccumulationRegister.InventoryCost AS T
	|	WHERE
	|		NOT &BatchAccountingVersion22
	|		AND &DateOfMigrationToBatchAccounting22 = &BeginningOfNextPeriod
	|		AND T.Period = &EndOfPeriod
	|		AND T.Organization IN (&CompanyArray)
	|		AND T.Active
	|		AND T.EntryType IN (&TypesOfDataConversionRecords)
	|	) AS T
	|
	|GROUP BY
	|	T.AccountingSection,
	|	T.InventoryOwnerAttribute,
	|	T.Organization,
	|	T.ItemsLocationAttributes,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension,
	|	T.VATActivityType
	|
	|INDEX BY
	|	ItemsLocationAttributes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	T.Organization AS Organization,
	|	T.ItemsLocationAttributes.Products AS Products,
	|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByLinesOfBusiness
	|			THEN ISNULL(T.ItemsLocationAttributes.Purpose.LineOfBusiness,
	|				VALUE(Catalog.LinesOfBusiness.EmptyRef))
	|		ELSE VALUE(Catalog.LinesOfBusiness.EmptyRef)
	|	END AS LineOfBusiness,
	|	CASE
	|		WHEN NOT TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByBusinessUnits
	|			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
	|			THEN T.ItemsLocationAttributes.StorageLocation
	|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
	|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.Warehouses).Department
	|		WHEN T.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	|			THEN CAST(T.ItemsLocationAttributes.StorageLocation AS Catalog.CounterpartyContracts).Department
	|		ELSE VALUE(Catalog.BusinessStructure.EmptyRef)
	|	END AS Department,
	|	CASE
	|		WHEN TTAccountingPoliciesOfFinancialAccounting.ItemizeVariancesByWarehousesStorageLocations
	|			THEN T.ItemsLocationAttributes.StorageLocation
	|		ELSE UNDEFINED
	|	END AS StorageLocation
	|INTO TTResiduesForDeviations
	|FROM
	|	TTBalance AS T
	|	INNER JOIN InformationRegister.FinancialAccountingPolicy.SliceLast(&EndOfPeriod, ) AS TTAccountingPoliciesOfFinancialAccounting
	|		ON T.Organization = TTAccountingPoliciesOfFinancialAccounting.Organization AND NOT T.Organization.BranchOffice
	|		OR T.Organization.ParentCompany = TTAccountingPoliciesOfFinancialAccounting.Organization
	|			AND T.Organization.BranchOffice
	|WHERE
	|	T.Count <> 0
	|INDEX BY
	|	Organization,
	|	Products
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.Organization AS Organization,
	|	T.Products AS Products,
	|	T.Characteristic AS Characteristic,
	|	T.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.Department AS Department,
	|	T.StorageLocation AS StorageLocation,
	|	T.VariancePeriod AS VariancePeriod,
	|	T.CostVariancesIncludingVATBalance AS CostVariancesIncludingVAT,
	|	T.CostVariancesExcludingVATBalance AS CostVariancesExcludingVAT,
	|	T.CostVariancesLocalBalance AS CostVariancesLocal,
	|	T.CostVariancesMgmtBalance AS CostVariancesMgmt,
	|	T.AdditionalExpensesIncludingVATBalance AS AdditionalExpensesIncludingVAT,
	|	T.AdditionalExpensesExcludingVATBalance AS AdditionalExpensesExcludingVAT,
	|	T.AddExpensesLocalBalance AS AddExpensesLocal,
	|	T.AddExpensesManBalance AS AddExpensesMan,
	|	T.VATLocalBalance AS VATLocal,
	|	T.VATManagBalance AS VATManag,
	|	T.PermanentDifferenceBalance AS PermanentDifference,
	|	T.CostTDBalance AS CostTD,
	|	T.AITBalance AS AIT
	|
	|INTO TTRemainingDeviationsWithoutCost
	|FROM
	|	AccumulationRegister.GoodsCostVariances.Balance(
	|		&BorderEndOfPeriod, Organization IN (&CompanyArray)) AS T
	|	LEFT JOIN TTResiduesForDeviations AS Balance
	|		ON T.Organization = Balance.Organization
	|		AND T.Products = Balance.Products
	|		AND T.Characteristic = Balance.Characteristic
	|		AND T.InventoryOwnerAttribute = Balance.InventoryOwnerAttribute
	|		AND T.LineOfBusiness = Balance.LineOfBusiness
	|		AND T.Department = Balance.Department
	|		AND T.StorageLocation = Balance.StorageLocation
    |WHERE
    |	Balance.Organization IS NULL
	|	AND (T.CostVariancesIncludingVATBalance <> 0
	|		OR T.CostVariancesExcludingVATBalance <> 0
	|		OR T.CostVariancesLocalBalance <> 0
	|		OR T.CostVariancesMgmtBalance <> 0
	|		OR T.AdditionalExpensesIncludingVATBalance <> 0
	|		OR T.AdditionalExpensesExcludingVATBalance <> 0
	|		OR T.AddExpensesLocalBalance <> 0
	|		OR T.AddExpensesManBalance <> 0
	|		OR T.VATLocalBalance <> 0
	|		OR T.VATManagBalance <> 0
	|		OR T.PermanentDifferenceBalance <> 0
	|		OR T.CostTDBalance <> 0
	|		OR T.AITBalance <> 0)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.AccountingSection 							AS AccountingSection,
	|	T.InventoryOwnerAttribute 							AS InventoryOwnerAttribute,
	|	T.Organization 						 	AS Organization,
	|	T.ItemsLocationAttributes   			AS ItemsLocationAttributes,
	|	T.Lot 								AS Lot,
	|	T.LotVendorAttributes 					AS LotVendorAttributes,
	|	T.FinancialAccountingDimension 			AS FinancialAccountingDimension,
	|	T.VATActivityType 					AS VATActivityType,
	|
	|	T.Count 							AS Count,
	|	T.PermanentDifference 					AS PermanentDifference,
	|	T.CostTD 						AS CostTD,
	|	T.CostOfPersonalIncomeTax							AS CostOfPersonalIncomeTax,
	|	T.Cost
	|		+ T.OffBalanceCost
	|		+ T.AddExpensesForGoods
	|		+ T.LaborCosts
	|		+ T.ItemizedFixedCostsIncludingVAT
	|		+ T.ItemizedVariableCostsIncludingVAT 		AS FullValue,
	|	T.CostExcludingVAT
	|		+ T.AdditionalExpensesExcludingVAT
	|		+ T.LaborCosts
	|		+ T.ItemizedFixedCostsExcludingVAT
	|		+ T.ItemizedVariableCostsExcludingVAT		AS FullValueExcludingVAT,
	|	T.LocalCost
	|		+ T.OffBalanceCostLocal
	|		+ T.AddExpensesLocal
	|		+ T.LaborCostsLocal
	|		+ T.ItemizedFixedCostsCompl
	|		+ T.ItemizedVariableCostsCompl		AS FullLocalCost,
	|	T.CostMan
	|		+ T.AddExpensesMan
	|		+ T.LaborCostsMan
	|		+ T.ItemizedFixedCostsManag
	|		+ T.ItemizedVariableCostsManag		AS FullCostOfMan,
	|	T.ProvisionForImpairmentMan				AS ProvisionForImpairmentMan,
	|	T.ProvisionForImpairmentLocal				AS ProvisionForImpairmentLocal
	|INTO TTResiduesWithoutQuantity
	|FROM
	|	TTBalance AS T
	|WHERE
	|	T.Count = 0
	|	AND NOT (T.Cost = 0
	|		AND T.CostExcludingVAT = 0
	|		AND T.AddExpensesForGoods = 0
	|		AND T.AdditionalExpensesExcludingVAT = 0
	|		AND T.PermanentDifference = 0
	|		AND T.CostTD = 0
	|		AND T.CostOfPersonalIncomeTax = 0
	|		AND T.LocalCost = 0
	|		AND T.OffBalanceCost = 0
	|		AND T.LaborCosts = 0
	|		AND T.ItemizedFixedCostsIncludingVAT = 0
	|		AND T.ItemizedFixedCostsExcludingVAT = 0
	|		AND T.ItemizedFixedCostsExcludingVAT = 0
	|		AND T.ItemizedVariableCostsExcludingVAT = 0
	|		AND T.OffBalanceCostLocal = 0
	|		AND T.AddExpensesLocal = 0
	|		AND T.LaborCostsLocal = 0
	|		AND T.ItemizedFixedCostsCompl = 0
	|		AND T.ItemizedVariableCostsCompl = 0
	|		AND T.CostMan = 0
	|		AND T.AddExpensesMan = 0
	|		AND T.LaborCostsMan = 0
	|		AND T.ItemizedFixedCostsManag = 0
	|		AND T.ItemizedVariableCostsManag = 0
	|		AND T.ProvisionForImpairmentMan = 0
	|		AND T.ProvisionForImpairmentLocal = 0)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.AccountingSection 							AS AccountingSection,
	|	T.InventoryOwnerAttribute 							AS InventoryOwnerAttribute,
	|	T.Organization 						 	AS Organization,
	|	T.ItemsLocationAttributes   			AS ItemsLocationAttributes,
	|	T.Lot 								AS Lot,
	|	T.LotVendorAttributes 					AS LotVendorAttributes,
	|	T.FinancialAccountingDimension 			AS FinancialAccountingDimension,
	|	T.VATActivityType 					AS VATActivityType,
	|
	|	T.Count 							AS Count,
	|	T.PermanentDifference 					AS PermanentDifference,
	|	T.CostTD 						AS CostTD,
	|	T.CostOfPersonalIncomeTax							AS CostOfPersonalIncomeTax,
	|	T.Cost
	|		+ T.OffBalanceCost
	|		+ T.AddExpensesForGoods
	|		+ T.LaborCosts
	|		+ T.ItemizedFixedCostsIncludingVAT
	|		+ T.ItemizedVariableCostsIncludingVAT 		AS FullValue,
	|	T.CostExcludingVAT
	|		+ T.AdditionalExpensesExcludingVAT
	|		+ T.LaborCosts
	|		+ T.ItemizedFixedCostsExcludingVAT
	|		+ T.ItemizedVariableCostsExcludingVAT		AS FullValueExcludingVAT,
	|	T.LocalCost
	|		+ T.OffBalanceCostLocal
	|		+ T.AddExpensesLocal
	|		+ T.LaborCostsLocal
	|		+ T.ItemizedFixedCostsCompl
	|		+ T.ItemizedVariableCostsCompl		AS FullLocalCost,
	|	T.CostMan
	|		+ T.AddExpensesMan
	|		+ T.LaborCostsMan
	|		+ T.ItemizedFixedCostsManag
	|		+ T.ItemizedVariableCostsManag		AS FullCostOfMan,
	|	T.ProvisionForImpairmentMan				AS ProvisionForImpairmentMan,
	|	T.ProvisionForImpairmentLocal				AS ProvisionForImpairmentLocal
	|INTO TTBalancesWithDifferentSign
	|FROM
	|	TTBalance AS T
	|WHERE
	|	T.Count <> 0
	|	AND NOT (T.Count
	|			* (T.Cost + T.OffBalanceCost
	|				+ T.AddExpensesForGoods + T.LaborCosts
	|				+ T.ItemizedFixedCostsIncludingVAT + T.ItemizedVariableCostsIncludingVAT) >= 0
	|		AND T.Count
	|			* (T.CostExcludingVAT + T.AdditionalExpensesExcludingVAT + T.LaborCosts
	|				+ T.ItemizedFixedCostsExcludingVAT + T.ItemizedVariableCostsExcludingVAT) >= 0
	|		AND T.Count
	|			* (T.LocalCost + T.OffBalanceCostLocal
	|				+ T.AddExpensesLocal + T.LaborCostsLocal
	|				+ T.ItemizedFixedCostsCompl + T.ItemizedVariableCostsCompl) >= 0
	|		AND T.Count
	|			* (T.CostMan + T.AddExpensesMan + T.LaborCostsMan
	|				+ T.ItemizedFixedCostsManag + T.ItemizedVariableCostsManag) >= 0
	|		AND T.Count
	|			* (T.CostOfPersonalIncomeTax) >= 0
	|		)
	|	AND T.AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping)
	|	AND NOT T.Lot REFS Document.PurchaseAdjustment
	|";
	
