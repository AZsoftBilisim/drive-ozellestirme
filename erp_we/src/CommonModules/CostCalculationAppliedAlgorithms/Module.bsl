#Region StateOfMonthClosingOperation

// Checks whether there are movements in the specified register in the billing period for the organizations being calculated.
//
// Returns:
//	Boolean -
//
Function ThereAreRegisteredRecordsOnAccumulationRegister(RegisterName, CalculationPeriod, CompanyArray, OrganizationFieldName = "") Export
	
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	TRUE AS ThereAreRecords
	|FROM
	|	Parameter1 AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Parameter2 IN(&CompanyArray)
	|	AND T.Active
	|";
	
	Query.SetParameter("BeginOfPeriod", 	   BegOfMonth(CalculationPeriod));
	Query.SetParameter("EndOfPeriod",  	   EndOfMonth(CalculationPeriod));
	Query.SetParameter("CompanyArray", CompanyArray);
	
	Query.Text = StrReplace(Query.Text, "Parameter", "%");
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		Query.Text,
		"AccumulationRegister." + RegisterName,
		?(ValueIsFilled(OrganizationFieldName), OrganizationFieldName, "Organization"));
	
	Result = Query.Execute();
	
	Return Not Result.IsEmpty();
	
EndFunction

// Checks whether there are obvious problems in movements at the cost of goods.
//
// Returns:
//	Boolean -
//
Function ThereAreIncorrectCostRegisteredRecords(CalculationPeriod, CompanyArray) Export
	
	If Not CalculationOfCostCached.BatchAccountingVersion22(BegOfMonth(CalculationPeriod)) Then
		Return False; // we check only the movements of the batch accounting version 2.2
	EndIf;
	
	// In the primary document movements and in the movements generated by the batch calculation mechanism, the record type must be filled in.
	Query = New Query;
	Query.Text =
	"SELECT TOP 1
	|	TRUE AS ThereAreRecords
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN(&CompanyArray)
	|	AND T.Active
	|	AND NOT T.LotCalculation
	|	AND NOT T.CalculationOfCost
	|	AND VALUETYPE(T.Recorder) <> TYPE(Document.RegisterAdjustment)
	|	AND T.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)";
	
	Query.SetParameter("BeginOfPeriod", 	   BegOfMonth(CalculationPeriod));
	Query.SetParameter("EndOfPeriod",  	   EndOfMonth(CalculationPeriod));
	Query.SetParameter("CompanyArray", CompanyArray);
	
	Result = Query.Execute();
	
	Return Not Result.IsEmpty();
	
EndFunction
	
// Checks the end of updating incoming and outgoing data of the running calculation engine.
//
Procedure CheckDataLockWhenUpdatingInformationSecurity(CostCalculationIsRunning, BatchAccountingVersion22 = Undefined, DebugParameters = Undefined) Export
	
	DataToCheck1 = New Map;
	DataToCheck1.Insert(Metadata.InformationRegisters.JobsForCalculatingCost, True);
	
	CostCalculationCostAdjustment.IncomingMechanismData(DataToCheck1);
	CostCalculationCostAdjustment.OutgoingMechanismData(DataToCheck1);
	
	If CostCalculationIsRunning Then // the cost calculation mechanism is being implemented
		PresentationOperation = CostCalculationCostAdjustment.CurVersionOfMechanism();
	Else
		CalculationOfCost.IncomingMechanismData(DataToCheck1);
		CalculationOfCost.OutgoingMechanismData(DataToCheck1);
		PresentationOperation = CalculationOfCost.CurVersionOfMechanism();
	EndIf;
	
	MonthEndTransactionsServer.CheckBlockingIncomingDataWhenUpdatingInformationSecurity(DataToCheck1, PresentationOperation);
	
EndProcedure

// Checks whether data is blocked during a delayed update of the information system.
// 
// Parameters:
//	IncomingData 		  - Map
//							  Key - String, Configuration objectmetadannyconfigurations - incoming data used by the operation
//							  Value - Any Link, Structure, Undefined, Array
// Returns:
//  Boolean - There is a data lock when updating the IB
Function ThereIsDataLockWhenUpdatingInformationSecurity(IncomingData) Export
	
	If GetFunctionalOption("DeferredUpdateCompletedSuccessfully") Then
		Return False;
	EndIf;
	
	LinkSelectedData = New Array;
	FilterByRefs 			= New Array;
	
	DataBlocked = False;
	
	SetPrivilegedMode(True); // the current user may not have rights to all incoming data, but it is necessary to check everything
	
	For Each DataDetails In IncomingData Do
		
		MetadataObject = DataDetails.Key;
		If TypeOf(MetadataObject) = Type("String") Then
			MetadataObject = Metadata.FindByFullName(MetadataObject);
		EndIf;
		
		Filter = ?(TypeOf(DataDetails.Value) = Type("Boolean"), Undefined, DataDetails.Value);
		
		If (Metadata.InformationRegisters.Contains(MetadataObject)
		 And MetadataObject.WriteMode = Metadata.ObjectProperties.RegisterWriteMode.Independent)
		 Or TypeOf(Filter) = Type("Structure") Then
			// We check independent registers of information one by one,
			// because there are no uniform selections for them (according to the registrar).
			// Similarly, for other types of metadata, if they are given a "complex" selection in the form of a structure.
			If InfobaseUpdate.HasDataToProcess(Undefined, MetadataObject, Filter) Then
				Return True;
			EndIf;
		Else
			LinkSelectedData.Add(MetadataObject.FullName());
			If TypeOf(Filter) = Type("Array") Then
				// Let's add the selection array of this metadata object to the general selection array
				CommonClientServer.SupplementArray(FilterByRefs, Filter, True);
			ElsIf Filter <> Undefined Then
				// Let's add the selection-link of this metadata object to the general array of selections
				If FilterByRefs.Find(Filter) = Undefined Then
					FilterByRefs.Add(Filter);
				EndIf;
			EndIf;
		EndIf;
		
	EndDo;
	
	If LinkSelectedData.Count() > 0 Then
		
		If FilterByRefs.Count() = 0 Then
			FilterByRefs = Undefined; // without selection
		EndIf;
		
		// We will check all objects for which selection by reference /registrar is possible in one call.
		If InfobaseUpdate.HasDataToProcess(Undefined, LinkSelectedData, FilterByRefs) Then
			Return True;
		EndIf;
	EndIf;
	
	Return False;
	
EndFunction

// Returns the current state of the cost calculation.
//
// Parameters:
//	CalculationPeriod - Date - month of calculation
//	FilterCompanies - Array - the organization, which is necessary to obtain the state of the calculation.
//	UpdateOnlyOneStage			  - CatalogRef.MonthEndClosingOperations - Express check of the state of the specified stage only
//										 . it does not check the determination of the state of previous stages that affect the specified stage
//
// Returns:
//	EnumRef.StatesOfMonthEndClosingOperations - the current state of the calculation.
//
Function CurStateOfCalculation(CalculationPeriod, FilterCompanies, UpdateOnlyOneStage = Undefined) Export
	
	State = MonthEndTransactionsServer.DetermineStateOfCalculationSteps(
		Catalogs.MonthEndClosingOperations.LotsAndCostCalculation,
		CalculationPeriod,
		FilterCompanies,
		Not ValueIsFilled(UpdateOnlyOneStage),
		,
		UpdateOnlyOneStage);
	
	Return State;
	
EndFunction

