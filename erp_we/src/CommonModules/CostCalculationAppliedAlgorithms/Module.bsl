#Region ProceduresCalledFromExchanges

// When receiving data from a peripheral node that requires cost recalculation, it adds an entry to the cost accounting Task register.
//
// Parameters:
//	ReceivedData - Arbitrary - this is the data Element parameter for the exchange plan event of the same name.
//
// Returns:
//	Boolean - a sign that the received data is data related to the cost calculation mechanism.
//
Function CreateTaskForCalculatingCostOfDataExchange(ReceivedData) Export
	
	Try
		MetadataOfReceivedData = ReceivedData.Metadata();
	Except
		Return False; // this object does not have a method to get its metadata - the object does not need to be processed
	EndTry;
	
	If Not Metadata.AccumulationRegisters.Contains(MetadataOfReceivedData) Then
		Return False;
	EndIf;
	
	// We get a description of the incoming data of the calculation mechanisms
	IncomingData = New Map;
	CostCalculationCostAdjustment.IncomingMechanismData(IncomingData, True);
	CalculationOfCost.IncomingMechanismData(IncomingData, True);
	
	If IncomingData.Get(MetadataOfReceivedData) = Undefined Then
		Return False;
	EndIf;
	
	// Only a change in the accumulation register, which is the initial data for the calculation,
	// leads to the need to recalculate batches and cost.
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	
	If MetadataOfReceivedData.Dimensions.Find("Organization") <> Undefined Then
		OrganizationFieldName = "Organization";
		NameOfOrganizationContainer = ""; // The company is stored in the Attributes of the set
	ElsIf MetadataOfReceivedData.Dimensions.Find("CompanyOwner") <> Undefined Then
		OrganizationFieldName = "CompanyOwner";
		NameOfOrganizationContainer = ""; // The company is stored in the Attributes of the set
	ElsIf MetadataOfReceivedData.Dimensions.Find("InventoryOwnerAttribute") <> Undefined Then
		OrganizationFieldName = "InventoryOwnerAttribute";
		NameOfOrganizationContainer = "Catalog.InventoryKinds"; // the organization is stored "out of the set"
		NameOfLinkFieldInContainer = "Ref";
		NameOfOrganizationFieldInContainer = "Organization";
	ElsIf MetadataOfReceivedData.Dimensions.Find("AccountingDimensionByPartners") <> Undefined Then
		OrganizationFieldName = "AccountingDimensionByPartners";
		NameOfOrganizationContainer = "InformationRegister.AccountingDimensionByPartners";  // the organization is stored "out of the set"
		NameOfLinkFieldInContainer = "DimensionKey";
		NameOfOrganizationFieldInContainer = "Organization";
	Else
		Return False; // it is not possible to determine the organization from the register data
	EndIf;
	
	SetTable = ReceivedData.Unload(, "Period," + OrganizationFieldName); // ValueTable
	SetTable.GroupBy("Period," + OrganizationFieldName);
	
	Query.SetParameter("T",	    SetTable);
	Query.SetParameter("Ref", ReceivedData.Filter.Recorder.Value);
	
	Query.Text =
	"SELECT DISTINCT
	|	BEGINOFPERIOD(T.Period, MONTH) AS Period,
	|	T.OrganizationFieldName          AS Organization
	|INTO TTReceivedData
	|FROM
	|	&T AS T
	|";
	
	Query.Text = StrReplace(Query.Text, "OrganizationFieldName", OrganizationFieldName);
	Query.Execute();
	
	Query.Text =
	"SELECT DISTINCT
	|	T.Period,
	|	T.Organization
	|INTO TTPeriods
	|FROM
	|	(SELECT DISTINCT
	|		T.Period 	  AS Period,
	|		T.Organization AS Organization
	|	FROM
	|		TTReceivedData AS T
	|
	|	UNION ALL
	|	
	|	SELECT DISTINCT
	|		BEGINOFPERIOD(T.Period, MONTH) AS Period,
	|		T.OrganizationFieldName          AS Organization
	|	FROM
	|		NameOfReceivedData AS T
	|	WHERE
	|		T.Recorder = &Ref
	|	) AS T
	|";
	
	If ValueIsFilled(NameOfOrganizationContainer) Then
		
		// The organization is stored not in the field of the object, but in some other place - you need to make a connection with it.
		QueryTextTemplate2 = "(" + StrReplace(Query.Text, "INTO TTPeriods", "") + ")";
		
		Query.Text =
		"SELECT DISTINCT
		|	T.Period AS Period,
		|	Container.NameOfOrganizationFieldInContainer AS Organization
		|INTO TTPeriods
		|FROM
		|	QueryTextTemplate2 AS T
		|INNER JOIN NameOfOrganizationContainer AS Container
		|ON T.Organization = Container.NameOfLinkFieldInContainer
		|";
		
		Query.Text = StrReplace(Query.Text, "QueryTextTemplate2", QueryTextTemplate2);
		
	EndIf;
	
	Query.Text = Query.Text + "
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|" + "
	|SELECT DISTINCT
	|	T.Period 	  AS Month,
	|	T.Organization AS Organization,
	|	&Ref 	  AS Document
	|FROM
	|	TTPeriods AS T
	|		LEFT JOIN InformationRegister.JobsForCalculatingCost AS JobsForCalculatingCost
	|			ON T.Period = BEGINOFPERIOD(JobsForCalculatingCost.Month, Month)
	|			 AND T.Organization = JobsForCalculatingCost.Organization
	|			 AND JobsForCalculatingCost.Document = &Ref
	|WHERE
	|	JobsForCalculatingCost.JobNumber IS NULL
	|   AND T.Organization <> VALUE(Catalog.Companies.EmptyRef)
	|";
	
	Query.Text = StrReplace(Query.Text, "NameOfReceivedData", 			"AccumulationRegister." + MetadataOfReceivedData.Name);
	Query.Text = StrReplace(Query.Text, "NameOfOrganizationContainer",  		NameOfOrganizationContainer);
	Query.Text = StrReplace(Query.Text, "NameOfLinkFieldInContainer",  		NameOfLinkFieldInContainer);
	Query.Text = StrReplace(Query.Text, "NameOfOrganizationFieldInContainer",  NameOfOrganizationFieldInContainer);
	Query.Text = StrReplace(Query.Text, "OrganizationFieldName",  			OrganizationFieldName);
	
	InformationRegisters.JobsForCalculatingCost.CreateRegisterEntriesBasedOnSampleData(Query.Execute().Select());
	
	Return True; // data processed successfully
	
EndFunction

