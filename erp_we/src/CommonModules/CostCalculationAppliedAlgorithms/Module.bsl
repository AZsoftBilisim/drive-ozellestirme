// Initializes data for the General calculation parameter that describes the specified register.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//	RegisterMetadata - MetadataObjectAccumulationRegister - 
//
Procedure InitializeRegisterData(CalculationParameters, RegisterMetadata) Export
	
	MetaRegister = RegisterMetadata; //MetadataObjectAccumulationRegister
	If CalculationParameters.RegisterRecords.Property(MetaRegister.Name) Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Lỗi khởi tạo tính toán: đã khởi tạo biểu ghi %1';
				|ru = 'Ошибка инициализации расчета: регистр %1 уже инициализирован';
				|en = 'An error occurred while initializing the calculation: the %1 register is already initiated'; fa = 'An error occurred while initializing the calculation: the %1 register is already initiated';
				|it = 'Errore nell''inizializzazione del conto: il registro %1 è già inizializzato';
				|pl = 'Błąd inicjalizacji obliczeń: rejestr %1 jest już zainicjowany';
				|tr = 'Hesaplama başlatma hatası: %1 kaydı artık başlatıldı'", Common.DefaultLanguageCode()),
			MetaRegister.Name);
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorOfInitializingCalculationParameters,
			ProtocolText_);
		
		Raise TextExceptionToLogProblem(ProtocolText_);
		
	EndIf;
	
	RegisterDescription = GenerateCaseDescription(RegisterMetadata);
	
	// Let's create a temporary table for caching all new register movements
	PutTableOfValuesInTemporaryTable(
		CalculationParameters,
		RegisterDescription.RegisterCacheTableName,
		RegisterDescription.Table,
		RegisterDescription.RegisterCacheFields,
		RegisterDescription.RegisterIndexes);
		
	CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
		CalculationParameters,
		1);
		
	// Let's add a description of the register to the calculation parameters
	CalculationParameters.RegisterRecords.Insert(RegisterDescription.RegisterName, RegisterDescription);
	
	// Let's create a temporary table for caching records of the main register table
	If CalculationParameters.RegistersWithCalculatedRevolutions.Property(RegisterDescription.RegisterName) Then
		UpdateEstimatedRegisterRevolutions(CalculationParameters, RegisterDescription, True);
	EndIf;
	
	// Let's create a temporary table for caching the calculated balances
	If CalculationParameters.RegistersWithCalculatedBalances.Property(RegisterDescription.RegisterName) Then
		UpdateEstimatedRegisterBalances(CalculationParameters, RegisterDescription, True);
	EndIf;
	
EndProcedure

