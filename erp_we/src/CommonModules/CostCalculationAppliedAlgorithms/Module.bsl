#Region BroadcastParties

// A special case of batch distribution, when the distribution is not required to be performed directly,
// because all the selected data have the sign Calculation of parties = True.
// You just need to move the contents of the temporary data table to the receiver table.

Procedure InitializeBatchTranslation(CalculationParameters, TableForBroadcastingParties = Undefined, RegisterName = "",
			TempTableName = "", IndexingFields = "", TemporaryTablesForFollowingSteps = "") Export
	
	// Let's prepare the structure of the description of the movements.
	RegisterRecordsDetails = RegisterRecordsDetails();
	RegisterRecordsDetails.Insert("Context", "BroadcastParties");
	RegisterRecordsDetails.Insert("RegisterName", ?(ValueIsFilled(RegisterName), RegisterName, ""));
	
	If Not ValueIsFilled(RegisterName) Then
		RegisterRecordsDetails.Insert("TempTableName", TempTableName);
		RegisterRecordsDetails.Insert("IndexingFields",  IndexingFields);
	EndIf;
	
	RegisterRecordsDetails.Insert("TemporaryTablesForFollowingSteps", TemporaryTablesForFollowingSteps);
	RegisterRecordsDetails.Insert("DistributionIsNotRequired", True);
	
	// Let's prepare the structure of the distribution of parties.
	InitializeBatchDistribution(
		CalculationParameters,
		TableForBroadcastingParties,
		New Map,
		RegisterRecordsDetails,
		DescriptionOfNonWritableData(False));
	
	CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "InitializeBatchTranslation");
	
EndProcedure

#EndRegion

#Region PreparingDataForNextSteps

// Creating temporary tables for use in the following steps.
// Tables are formed directly by the query, the number and structure of tables are arbitrary.
//
Procedure InitializeDataPreparationForFollowingSteps(CalculationParameters, TemporaryTablesForFollowingSteps) Export

	// Let's prepare the structure of the description of the movements.
	RegisterRecordsDetails = RegisterRecordsDetails();
	RegisterRecordsDetails.Insert("Context", "PreparingDataForNextSteps");
	RegisterRecordsDetails.Insert("TemporaryTablesForFollowingSteps", TrimAll(TemporaryTablesForFollowingSteps));
	RegisterRecordsDetails.Insert("DistributionIsNotRequired", True);

	DataPreparation = New Structure;

	DataPreparation.Insert("RegisterRecordsDetails", RegisterRecordsDetails);
	DataPreparation.Insert("AdditionalProperties", New Structure);
	DataPreparation.Insert("ExistingTT", "");

	CalculationParameters.Insert("DataPreparation", DataPreparation);

EndProcedure

// Executes a request to generate temporary tables for the next calculation steps.
//  
Procedure PrepareDataForFollowingSteps(CalculationParameters, QueryText) Export
	
	GeneratedTT = CalculationParameters.DataPreparation.RegisterRecordsDetails.TemporaryTablesForFollowingSteps;
	
	// Delete the generated temporary stage tables if they already exist.
	DestroyTemporaryTables(CalculationParameters, GeneratedTT);
	
	// Let's remember the existing temporary tables.
	CalculationParameters.DataPreparation.ExistingTT = GetListOfExistingTemporaryTables(CalculationParameters);
	
	// Let's execute a request for the formation of temporary tables.
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	If CalculationParameters.DebugParameters.Property("QueryTextForDebugging")
	 And CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "", False) Then
		Query.Text = CalculationParameters.DebugParameters.QueryTextForDebugging;
	Else
		Query.Text = QueryText;
	EndIf;
	
	For Each KeyAndValue In CalculationParameters.AdditionalStageRequestParameters Do
		Query.SetParameter(KeyAndValue.Key, KeyAndValue.Value);
	EndDo;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, GeneratedTT);
	
	CalculationParameters.AdditionalStageRequestParameters.Clear();
	
EndProcedure

// Complete the preparation of data for the next steps.
// 
// Parameters:
//  CalculationParameters - Structure - Calculation parameters
Procedure CompleteDataPreparationForNextSteps(CalculationParameters) Export
	
	CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "GetDataFromCalculationStage");

	GeneratedTT  = CalculationParameters.DataPreparation.RegisterRecordsDetails.TemporaryTablesForFollowingSteps;
	ExistingTT = CalculationParameters.DataPreparation.ExistingTT;
	
	// We will destroy the auxiliary temporary tables created at this stage of the calculation.
	ExistingTT = ExistingTT + ", " + GeneratedTT;
	NewTT = GetListOfExistingTemporaryTables(CalculationParameters, ExistingTT);
	
	DestroyTemporaryTables(CalculationParameters, NewTT);
	
	CalculationParameters.Delete("DataPreparation");
	
EndProcedure

#EndRegion

#Region UnloadingIntermediateData

// Unloads the header row of the intermediate stage data table.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
// 	TableName - String -
// 	DataSource - ValueTable, String -
//
Procedure UnloadHeaderOfIntermediateCalculationDataTable(CalculationParameters, TableName, DataSource = Undefined)
	
	If Not CalculationParameters.DistributionOfParties.ExportingData Then
		Return;
	EndIf;
	
	// Get the data from the source.
	If DataSource = Undefined Then
		DataSource = TableName; // data in the temporary table of the same name
	EndIf;
	
	If TypeOf(DataSource) = Type("String") Then
		// We get an empty table with the same structure as the temporary table.
		DataTable = UnloadTemporaryTable(CalculationParameters, DataSource, 0); // ValueTable
	Else
		// Let's take the data from the specified temporary table.
		DataTable = DataSource; // ValueTable
	EndIf;
	
	// Let's form the title of the tabular document.
	UploadFileDescription = CalculationParameters.DistributionOfParties.UploadingCalculationData[TableName]; // See CostCalculationAppliedAlgorithms.InitializeUploadFileDescription 
	UploadFileDescription.FileLineNumber = 1;
	ColumnNumber = 0;
	
	UploadFileDescription.SpreadsheetDocument.FixedTop = 1;
	
	For Each CurrentColumn In DataTable.Columns Do
		
		UploadFileDescription.Columns.Add(CurrentColumn.Name);
		
		ColumnNumber = ColumnNumber + 1;
		
		Area = UploadFileDescription.SpreadsheetDocument.Area(
			UploadFileDescription.FileLineNumber, ColumnNumber,
			UploadFileDescription.FileLineNumber, ColumnNumber);
		
		Area.Text = CurrentColumn.Name;
		Area.Font = New Font(Area.Font,,, True); 
		
	EndDo;
	
EndProcedure

// Unloads the header row of the intermediate stage data table.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//	TableName - String -
//	DataSource - String, ValueTable, QueryResultSelection -	
Procedure UnloadIntermediateCalculationDataTable(CalculationParameters, TableName, DataSource = Undefined) Export
	
	If Not CalculationParameters.DistributionOfParties.ExportingData Then
		Return;
	EndIf;
	
	// Get the data from the source.
	If DataSource = Undefined Then
		DataSource = TableName; // data in the temporary table of the same name
	EndIf;
	
	If TypeOf(DataSource) = Type("String") Then
		// Get the table from the temporary table.
		DataTable = UnloadTemporaryTable(CalculationParameters, DataSource);
	ElsIf TypeOf(DataSource) = Type("QueryResultSelection") Then
		// Get the table from the selection.
		DataTable = DataSource.Owner().Unload();
	Else
		// Let's take the data from the specified temporary table.
		DataTable = DataSource;
	EndIf;
	
	// Let's form the title of the tabular document.
	UploadFileDescription = CalculationParameters.DistributionOfParties.UploadingCalculationData[TableName]; // See CostCalculationAppliedAlgorithms.InitializeUploadFileDescription
	
	For Each CurrentRow In DataTable Do
		
		UploadFileDescription.FileLineNumber = UploadFileDescription.FileLineNumber + 1;
		ColumnNumber = 0;
		
		For Each CurrentColumn In UploadFileDescription.Columns Do
			
			ColumnNumber = ColumnNumber + 1;
			
			Area = UploadFileDescription.SpreadsheetDocument.Area(
				UploadFileDescription.FileLineNumber, ColumnNumber,
				UploadFileDescription.FileLineNumber, ColumnNumber);
			
			Area.Text = CurrentRow[CurrentColumn];
			
		EndDo;
		
	EndDo;
	
EndProcedure

// Writes files for uploading intermediate stage data.
//
Procedure CompleteUnloadingOfIntermediateCalculationData(CalculationParameters) Export
	
	If Not CalculationParameters.DistributionOfParties.ExportingData Then
		Return;
	EndIf;
	
	For Each KeyAndValue In CalculationParameters.DistributionOfParties.UploadingCalculationData Do
		
		If TypeOf(KeyAndValue.Value) <> Type("Structure") Then
			Continue;
		EndIf;
		
		UploadFileDescription = KeyAndValue.Value;
		
		// Save the table to a file.
		Try
			TabDoc = UploadFileDescription.SpreadsheetDocument; // SpreadsheetDocument
			TabDoc.Write(UploadFileDescription.FileName);
		Except
			
			UploadFileDescription.HadErrors = True;
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Không thể ghi lại tệp ""%1""
					|%2';
					|ru = 'Не удалось записать файл ""%1""
					|%2';
					|en = 'Cannot save the ""%1"" file
					|%2'; fa = 'Cannot save the ""%1"" file
					|%2';
					|it = 'Non è stato possibile scrivere il file ""%1""
					|%2';
					|pl = 'Nie udało się zapisać plik ""%1""
					|%2';
					|tr = 'Dosya kaydedilmedi ""%1""
					|%2'", Common.DefaultLanguageCode()),
				UploadFileDescription.FileName,
				DetailErrorDescription(ErrorInfo()));
			
			CostCalculationProtocol.FixCalculationError(
				CalculationParameters,
				Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
				ProtocolText_);
			
		EndTry;
		
	EndDo;
	
	CalculationParameters.DistributionOfParties.Delete("UploadingCalculationData");
	
EndProcedure

