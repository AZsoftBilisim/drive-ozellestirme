			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.CompanyAccountingPolicyError,
			ErrorText,
			,
			OrganizationsWithErrors);
		
		Raise TextExceptionToLogProblem(ErrorText);
			
	EndIf;
	
	Return CostEvaluationMethod;

EndFunction

// Defines the method for estimating the value of the specified organization.
//
// Parameters:
//	CalculationParameters - See InitializeGeneralCalculationParameters
//	Organization - CatalogRef.Companies - Organization.
//
// Returns:
//	EnumRef.InventoryValuationMethods - cost estimation method.
//
Function DetermineMethodOfAssessingValueOfOrganizationSGoods(CalculationParameters, Organization)
	
	// An array of organizations can be transferred to the calculation, which does not contain all organizations connected according to the Intercampany scheme.
	// In this case, it is necessary to supplement the cost estimation methods with methods for evaluating organizations that are missing in the array.
	
	EvaluationMethodByOrganization = CalculationParameters.AccountingPolicies.ValuationMethods.Get(Organization);
	
	If Not ValueIsFilled(EvaluationMethodByOrganization) Then
		
		AccountingPolicyParameters = AccountingPoliciesTaxSettings.CurrentParametersOfTaxesAndAccountingPoliciesAsOfDate(
			"FinancialAccountingPolicy",
			Organization,
			CalculationParameters.PayrollPeriod.BeginOfPeriod);
		
		If AccountingPolicyParameters <> Undefined Then
			EvaluationMethodByOrganization = AccountingPolicyParameters.InventoryValuationMethod;
		Else
			EvaluationMethodByOrganization = Enums.InventoryValuationMethods.AveragePerMonth;
		EndIf;
			
		CalculationParameters.AccountingPolicies.ValuationMethods.Insert(Organization, EvaluationMethodByOrganization);
		
	EndIf;
	
	Return EvaluationMethodByOrganization;
	
EndFunction

Procedure AddTTMethodsForEstimatingValueOfOrganizationsByPeriod(CalculationParameters)
	
	// Let's create a temporary table of accounting policies of organizations.
	DestroyTemporaryTables(CalculationParameters, "TTMethodsOfEstimatingValueOfOrganizationsByPeriod");
	Query = New Query;
	AccountingPoliciesTaxSettings.AddParentOrganizationsToTemporaryTableManager(CalculationParameters.TempTablesManager, CalculationParameters.CompanyArray);
	Query.TempTablesManager = CalculationParameters.TempTablesManager;
	Query.Text =
	"SELECT
	|	InventoryValuationMethods.Organization AS Organization,
	|	InventoryValuationMethods.InventoryValuationMethod AS InventoryValuationMethod,
	|	MIN(InventoryValuationMethods.BeginOfPeriod) AS BeginOfPeriod,
	|	InventoryValuationMethods.EndOfPeriod AS EndOfPeriod
	|INTO TTMethodsOfEstimatingValueOfOrganizationsByPeriod
	|FROM
	|	(SELECT DISTINCT
	|		ParentOrganizations.BranchOffice AS Organization,
	|		FinancialAccountingPolicy.Period AS BeginOfPeriod,
	|		FinancialAccountingPolicy.InventoryValuationMethod AS InventoryValuationMethod,
	|		MIN(ISNULL(SubsequentAccountingPoliciesOfFinancialAccounting.Period, DATETIME(2120, 1, 1))) AS EndOfPeriod
	|	FROM
	|		TTParentOrganizations AS ParentOrganizations
	|			INNER JOIN InformationRegister.FinancialAccountingPolicy AS FinancialAccountingPolicy
	|			ON ParentOrganizations.Organization = FinancialAccountingPolicy.Organization
	|			LEFT JOIN InformationRegister.FinancialAccountingPolicy AS SubsequentAccountingPoliciesOfFinancialAccounting
	|			ON FinancialAccountingPolicy.Organization = SubsequentAccountingPoliciesOfFinancialAccounting.Organization
	|				AND FinancialAccountingPolicy.Period < SubsequentAccountingPoliciesOfFinancialAccounting.Period
	|				AND FinancialAccountingPolicy.InventoryValuationMethod <> SubsequentAccountingPoliciesOfFinancialAccounting.InventoryValuationMethod
	|	
	|	GROUP BY
	|		ParentOrganizations.BranchOffice,
	|		FinancialAccountingPolicy.InventoryValuationMethod,
	|		FinancialAccountingPolicy.Period) AS InventoryValuationMethods
	|
	|GROUP BY
	|	InventoryValuationMethods.Organization,
	|	InventoryValuationMethods.InventoryValuationMethod,
	|	InventoryValuationMethods.EndOfPeriod
	|
	|INDEX BY
	|	Organization";
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	DestroyTemporaryTables(CalculationParameters, "TTParentOrganizations");
	
EndProcedure

Function GenerateItemKeysForVATMediumSlip(CalculationParameters, TableName, AnalyticsFieldNames,
			NamesOfNumericFields, NamesOfIndexingFields = "") Export
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	#Region MutableKeys
		
	QueryTemplate =
	"SELECT DISTINCT
	|	T.FieldName AS DimensionOfProductItem,
	|	Keys.Products AS Products,
	|	Keys.Characteristic AS Characteristic,
	|	Keys.StorageLocation AS StorageLocation
	|INTO VariableAnalyticsKeysTTNomenclature
	|FROM
	|	TableName AS T
	|	INNER JOIN Catalog.InventoryLocationAttributeKeys AS Keys
	|		ON T.FieldName = Keys.Ref
	|WHERE
	|	T.Organization IN (&MediumSlipOrganizations)
	|	AND (Keys.Purpose <> VALUE(Catalog.Assignments.EmptyRef)
	|		OR Keys.Series <> VALUE(Catalog.ItemsBatches.EmptyRef))
	|";
	
	For Each KeyAndValue In New Structure(AnalyticsFieldNames) Do
		
		CurrentQuery = StrReplace(QueryTemplate, "FieldName", KeyAndValue.Key);
		CurrentQuery = StrReplace(CurrentQuery, "TableName", TableName);
		
		If ValueIsFilled(Query.Text) Then
			CurrentQuery = StrReplace(CurrentQuery, "INTO VariableAnalyticsKeysTTNomenclature", "");
		EndIf;
		
		Query.Text = Query.Text + ?(Query.Text = "", "", "
		|
		|UNION
		|
		|") + CurrentQuery;
		
		
	EndDo;

	Query.Text = Query.Text + "
	|INDEX BY
	|	Products,
	|	Characteristic,
	|	StorageLocation
	|;" + "
	|SELECT TOP 1
	|	TRUE
	|FROM
	|	VariableAnalyticsKeysTTNomenclature AS T
	|";
	
	#EndRegion
	
	QueryResult = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	
	If QueryResult.IsEmpty() Then
		DestroyTemporaryTables(CalculationParameters, "VariableAnalyticsKeysTTNomenclature");
		Return False; // there are no keys that need to be replaced
	EndIf;
	
	#Region KeySelection
	
	Query.Text =
	"SELECT
	|	T.DimensionOfProductItem AS DimensionOfProductItem,
	|	T.Products AS Products,
	|	T.Characteristic AS Characteristic,
	|	T.StorageLocation AS StorageLocation,
	|	KeysAreNew.DimensionKey AS NewAnalyticsOfNomenclature
	|INTO TTReplacementOfAnalyticsNomenclatureKeys
	|FROM
	|	VariableAnalyticsKeysTTNomenclature AS T
	|	LEFT JOIN InformationRegister.ItemsLocationAttributes AS KeysAreNew
	|		ON T.Products = KeysAreNew.Products
	|		AND T.Characteristic = KeysAreNew.Characteristic
	|		AND KeysAreNew.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
	|		AND T.StorageLocation = KeysAreNew.StorageLocation
	|		AND KeysAreNew.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	|		AND KeysAreNew.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	|INDEX BY
	|	DimensionOfProductItem
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Products AS Products,
	|	T.Characteristic AS Characteristic,
	|	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	|	T.StorageLocation AS StorageLocation,
	|	VALUE(Catalog.ProductCostElements.EmptyRef) AS ProductCostElement,
	|	VALUE(Catalog.Assignments.EmptyRef) AS Purpose
	|FROM
	|	TTReplacementOfAnalyticsNomenclatureKeys AS T
	|WHERE
	|	T.NewAnalyticsOfNomenclature IS NULL
	|";

	#EndRegion
	
	#Region GeneratingKeys
	
	QueryResult = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	
	If Not QueryResult.IsEmpty() Then
		
		// There are nomenclature analytics keys that need to be created.
		// After that, it is necessary to reformulate the table in place of keyanalytic nomenclature.
		Selection = QueryResult.Select();
		
		While Selection.Next() Do
			InformationRegisters.ItemsLocationAttributes.CreateAnalyticsKey(Selection)
		EndDo;
		
		DestroyTemporaryTables(CalculationParameters, "TTReplacementOfAnalyticsNomenclatureKeys");
		
		Query.Text =
		"SELECT
		|	T.DimensionOfProductItem AS DimensionOfProductItem,
		|	KeysAreNew.DimensionKey AS NewAnalyticsOfNomenclature
		|INTO TTReplacementOfAnalyticsNomenclatureKeys
		|FROM
		|	VariableAnalyticsKeysTTNomenclature AS T
		|	INNER JOIN InformationRegister.ItemsLocationAttributes AS KeysAreNew
		|		ON T.Products = KeysAreNew.Products
		|		AND T.Characteristic = KeysAreNew.Characteristic
		|		AND KeysAreNew.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
		|		AND T.StorageLocation = KeysAreNew.StorageLocation
		|		AND KeysAreNew.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		|		AND KeysAreNew.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
		|INDEX BY
		|	DimensionOfProductItem
		|";
		
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	EndIf;
	
	#EndRegion
	
	#Region ReplacingKeysInOriginalTable

	TableColumns1 = TemporaryTableColumns(CalculationParameters, TableName, False);
	StructureOfKeyField = New Structure(AnalyticsFieldNames);
	StructureNumericFields = New Structure(NamesOfNumericFields);
	
	// Templates for the first request
	TextOfTableFieldWithoutAnalyticsOfNomenclature = "";
	TextOfKeyField = "";
	JoinText = "";
	KeysCount = 0;
	// Templates for the second request
	TextOfTableFieldWithoutNumeric = "";
	TextOfSummationTableField = "";
	TextZeroSumSelectionCondition = "";
	
	For Each CurColumn In TableColumns1 Do
		
		FieldName = CurColumn.Name;
		
		If StructureOfKeyField.Property(FieldName) Then
			
			KeysCount = KeysCount + 1;
			TextTemplate1 =
				"CASE WHEN T.Organization IN (&MediumSlipOrganizations)
				|		THEN ISNULL(KeyTable_.NewAnalyticsOfNomenclature, T.FieldName)
				|		ELSE T.FieldName
				|	END AS FieldName";
			TextTemplate1 = StrReplace(TextTemplate1, "KeyTable_", "Keys" + TrimAll(KeysCount));
			TextTemplate1 = StrReplace(TextTemplate1, "FieldName", FieldName);
			
			TextOfKeyField = TextOfKeyField + ?(TextOfKeyField = "", "", ",
				|	") + TextTemplate1;
			
			TextTemplate1 =
				"	LEFT JOIN TTReplacementOfAnalyticsNomenclatureKeys AS KeyTable_
				|		ON T.FieldName = KeyTable_.DimensionOfProductItem";
			TextTemplate1 = StrReplace(TextTemplate1, "KeyTable_", "Keys" + TrimAll(KeysCount));
			TextTemplate1 = StrReplace(TextTemplate1, "FieldName", FieldName);
			
			JoinText = JoinText + ?(JoinText = "", "", "
				|") + TextTemplate1;
			
		Else
			TextOfTableFieldWithoutAnalyticsOfNomenclature = TextOfTableFieldWithoutAnalyticsOfNomenclature + ?(TextOfTableFieldWithoutAnalyticsOfNomenclature = "", "", ",
				|	") + "T." + FieldName;
		EndIf;
		
		If StructureNumericFields.Property(FieldName) Then
			
			TextOfSummationTableField = TextOfSummationTableField + ?(TextOfSummationTableField = "", "", ",
				|	") + "SUM(T." + FieldName + ") AS " + FieldName;
			TextZeroSumSelectionCondition = TextZeroSumSelectionCondition + ?(TextZeroSumSelectionCondition = "", "", "
				|	OR ") + "SUM(T." + FieldName + ") <> 0";
			
		Else
			
			TextOfTableFieldWithoutNumeric = TextOfTableFieldWithoutNumeric + ?(TextOfTableFieldWithoutNumeric = "", "", ",
				|	") + "T." + FieldName;
			
		EndIf;
		
	EndDo;
	
	JoinText = JoinText + "
		|INDEX BY
		|" + AnalyticsFieldNames;
	
	QueryTemplate =
	"DROP VariableAnalyticsKeysTTNomenclature
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	&TableFieldsWithoutAnalyticsOfNomenclature,
	|	&KeyFields
	|INTO TTIntermediateResult
	|FROM
	|	TableName AS T
	|WHERE &ConnectionKeys
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TableName
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	&TableFieldsWithoutNumeric,
	|	&FieldsOfSummationTable
	|INTO TableName
	|FROM
	|	TTIntermediateResult AS T
	|GROUP BY
	|	&TableFieldsWithoutNumeric
	|" + "
	|HAVING
	|	&ZeroSumSelectionCondition
	|
	|INDEX BY
	|	&IndexingFields
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTIntermediateResult
	|";
	
	QueryTemplate = StrReplace(QueryTemplate, "TableName", TableName);
	QueryTemplate = StrReplace(QueryTemplate, "&TableFieldsWithoutAnalyticsOfNomenclature", TextOfTableFieldWithoutAnalyticsOfNomenclature);
	QueryTemplate = StrReplace(QueryTemplate, "&KeyFields", TextOfKeyField);
	QueryTemplate = StrReplace(QueryTemplate, "WHERE &ConnectionKeys", JoinText);
	QueryTemplate = StrReplace(QueryTemplate, "&TableFieldsWithoutNumeric", TextOfTableFieldWithoutNumeric);
	QueryTemplate = StrReplace(QueryTemplate, "&FieldsOfSummationTable", TextOfSummationTableField);
	QueryTemplate = StrReplace(QueryTemplate, "&ZeroSumSelectionCondition", TextZeroSumSelectionCondition);
	QueryTemplate = StrReplace(QueryTemplate, "&IndexingFields", ?(ValueIsFilled(NamesOfIndexingFields), NamesOfIndexingFields, AnalyticsFieldNames));
	
	Query.Text = QueryTemplate;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	#EndRegion
	
	Return True;
	
EndFunction

#EndRegion


#Region LotRecordTypes

Function TypesOfPrimaryBatchRecords() Export
	
	Result = New Array;
	
	Result.Add(Enums.LotRecordTypes.Lot);
	Result.Add(Enums.LotRecordTypes.AllocationByRules);
	
	Return Result;
	
EndFunction

Function TypesOfDataConversionRecords() Export
	
	Result = DescriptionOfInitialBalanceAdjustments().UnloadColumn("Adjusting");
	
	Return Result;
	
EndFunction

Function TypesOfMultipleDataConversionRecords() Export
	
	Result = New Array;
	
	For Each CurrRow In DescriptionOfInitialBalanceAdjustments() Do
		
		If CurrRow.MultipleExecutionIsPossible Then
			Result.Add(CurrRow.Adjusting);
		EndIf;
		
	EndDo;
	
	Return Result;
	
EndFunction

Function UnreadableRecordTypes() Export
	
	Result = New Array;
	
	// Types of records of primary batches of the current period.
	For Each Item In TypesOfPrimaryBatchRecords() Do
		Result.Add(Item);
	EndDo;
	
	// Types of data conversion records when changing the accounting mode.
	For Each Item In TypesOfDataConversionRecords() Do
		Result.Add(Item);
	EndDo;
	
	// Types of batch records of previous periods.
	Result.Add(Enums.LotRecordTypes.WIPStock);
	Result.Add(Enums.LotRecordTypes.Balance);
	
	// The types of records are "not batches" (with zero quantity).
	Result.Add(Enums.LotRecordTypes.EmptyRef());
	
	Return Result;
	
EndFunction

// Returns an array of record types used in primary document movements.
//
// Returns:
//	Array - record types
//
Function TypesOfPrimaryMotionRecordings() Export
	
	Result = New Array;
	
	Rules = CalculationOfCostCached.RulesForFillingInRecordTypeField();
	
	For Each CurrentRow In Rules Do
		
		If ValueIsFilled(CurrentRow.EntryTypeReceipt) And Result.Find(CurrentRow.EntryTypeReceipt) = Undefined Then
			Result.Add(CurrentRow.EntryTypeReceipt);
		EndIf;
		
		If ValueIsFilled(CurrentRow.EntryTypeExpense) And Result.Find(CurrentRow.EntryTypeExpense) = Undefined Then
			Result.Add(CurrentRow.EntryTypeExpense);
		EndIf;
		
	EndDo;
	
	Return Result;
	
EndFunction

