Function DescriptionOfConstantOrFunctionOption(ObjectName) Export
	
	LongDesc = New Structure("Value, Metadata");
	
	If Metadata.FunctionalOptions.Find(ObjectName) <> Undefined Then
		LongDesc.Metadata = Metadata.FunctionalOptions[ObjectName];
		LongDesc.Value   = GetFunctionalOption(ObjectName);
	ElsIf Metadata.Constants.Find(ObjectName) <> Undefined Then
		LongDesc.Metadata = Metadata.Constants[ObjectName];
