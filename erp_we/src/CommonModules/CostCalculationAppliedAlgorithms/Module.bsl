// Performs preparatory actions for the calculation if the calculation is not called from the month closing mechanism.
//
// Returns:
//	Boolean -
//
Function PerformMonthClosingOperationsToPrepareForStageCalculation(CalculationSchemeLine, CalculationID, CheckActiveCalculations = True) Export
	
	If CheckActiveCalculations Then

		// Let's check the possibility of starting the calculation.
		ActiveCalculations = InformationRegisters.PerformMonthEndClosingOperations.SetFlagForStartingCalculation(
			CalculationSchemeLine.Companies,
			CalculationID,
			NStr("vi = 'Đang thực hiện cập nhật dữ liệu kế toán lô hàng khi lập báo cáo';
				|ru = 'Выполняется актуализация данных партионного учета при формировании отчета';
				|en = 'Performance of the actualization of data of lot accounting when forming the report'; fa = 'Performance of the actualization of data of lot accounting when forming the report';
				|it = 'L''aggiornamento dei dati della contabilità per lotti alla generazione del report è in corso';
				|pl = 'Trwa aktualizacja danych partyjnej ewidencji przy tworzeniu raportu';
				|tr = 'Rapor oluşturulurken lot muhasebesi verileri güncellenir'", Common.DefaultLanguageCode()),
			BegOfMonth(CalculationSchemeLine.Date),
			Catalogs.MonthEndClosingOperations.LotsAndCostCalculation);
		
		If ActiveCalculations.ThereAreActiveCalculations Then
			
			Common.MessageToUser(ActiveCalculations.ErrorText);
			Return False;
			
		EndIf;
		
	EndIf;
	
	DataProcessors.MonthEndClosingOperations.PerformOperationsToPrepareForStageCalculation(
		Catalogs.MonthEndClosingOperations.LotsAndCostCalculation,
		BegOfMonth(CalculationSchemeLine.Date),
		CalculationSchemeLine.Companies);
	
	Return True;
	
EndFunction

// Performs final actions for the calculation if the calculation is not called from the month closing mechanism.
//
Procedure PerformMonthClosingOperationsToCompleteStageCalculation(CalculationSchemeLine, CalculationID) Export
	
	DataProcessors.MonthEndClosingOperations.PerformOperationsToCompleteStageCalculation(
		Catalogs.MonthEndClosingOperations.LotsAndCostCalculation,
		BegOfMonth(CalculationSchemeLine.Date),
		CalculationSchemeLine.Companies);
	
	InformationRegisters.PerformMonthEndClosingOperations.SetEndOfCalculationFlag(CalculationID);
	
EndProcedure


// Gets a list of columns in the value table.
// 
// Parameters:
// 	ColumnCollection_ - ValueTableColumnCollection - 
// 	Exceptions - String - LongDesc
// Returns:
// 	String - LongDesc
Function ListOfFields(ColumnCollection_, Exceptions = "") Export
	
	ExcludedFields = New Structure(Exceptions);
	ListOfFields = "";
	
	For Each Column In ColumnCollection_ Do
		If Not ExcludedFields.Property(Column.Name) Then
			ListOfFields = ListOfFields + ?(ValueIsFilled(ListOfFields), ", ", "") + Column.Name;
		EndIf;
	EndDo;
	
	Return ListOfFields;
	
EndFunction

Procedure SelectDataToBeCalculatedInTemporaryTable(Query, SelectionConditionForDebugging = "")
	
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "Data");
	
	If ValueIsFilled(SelectionConditionForDebugging) Then
		
		// Sometimes, to simplify debugging, it is enough to select only part of the data.
		// For example, only data for one Product item.
		// In this case, in the second parameter it is necessary to pass the string of selection conditions "WHERE", for example
		//   , Because the analyticaccountingcountenclature.Products.Code = ""12345678""
		// It should be remembered that incomplete data calculated in this way should not be recorded in the IB,
		// because this will cause all other data not included in the selection to be cleared.
		
		Query.Text = Query.Text + "
		|
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	*
		|INTO Data_Temporary
		|FROM
		|	Data AS T
		|WHERE
		|	&SelectionConditionForDebugging
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|DROP Data
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT
		|	*
		|INTO Data
		|FROM
		|	Data_Temporary AS T
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|DROP Data_Temporary";
		
		Query.Text = StrReplace(Query.Text, "&SelectionConditionForDebugging", SelectionConditionForDebugging);
		
	EndIf;
	
EndProcedure

Function InsertWeightAndVolumeTemplatesIntoQueryText(QueryText, TableAlias = "CatProducts") Export
	
	QueryText = StrReplace(QueryText, "&Weight", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageWeight(TableAlias + ".UnitOfMeasure", TableAlias, False));
	QueryText = StrReplace(QueryText, "&VolumeM3", 
		Catalogs.PackagesAndUnitsOfMeasure.QueryTextPackageVolume(TableAlias + ".UnitOfMeasure", TableAlias, False));
		
	Return QueryText;
	
EndFunction

