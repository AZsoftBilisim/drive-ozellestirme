#Region InitializationAndCompletion

// Initializes data for the batch distribution mechanism.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
// 	TableForDistributionOfLots - ValueTable -
// 	DescriptionOfChains - Map -
// 	RegisterRecordsDetails - Structure -
// 	UnwrittenData - Structure -
// Returns:
// 	Structure - LongDesc:
// * ThereIsStackOverflow - Boolean -
// * NumberingParameters - Structure -
// * UnwrittenData - Structure -
// * RegisterRecordsDetails - Structure -
// * DescriptionOfChains - Map -
// * SettlementBatches - ValueTable -
// * AllSettlementBatches - ValueTable -
// * AdditionalProperties - Structure -
// * NumberOfDataChunks - Number -
// * PortionTableNames - String -
// * ExportingData - Boolean -
// * UploadingCalculationData - Structure -
// * CalculationStatistics - See CostCalculationAppliedAlgorithms.InitializeBatchDistributionMeasurement
//
Function InitializeBatchDistribution(CalculationParameters,
		TableForDistributionOfLots, DescriptionOfChains, RegisterRecordsDetails,
		UnwrittenData) Export

	DistributionOfParties = New Structure;

	DistributionOfParties.Insert("SettlementBatches", TableForDistributionOfLots);
	DistributionOfParties.Insert("DescriptionOfChains", DescriptionOfChains);
	DistributionOfParties.Insert("RegisterRecordsDetails", RegisterRecordsDetails);
	DistributionOfParties.Insert("NumberingParameters", Undefined);
	DistributionOfParties.Insert("UnwrittenData", UnwrittenData);
	DistributionOfParties.Insert("ThereIsStackOverflow", False);
	DistributionOfParties.Insert("AdditionalProperties", New Structure);
	DistributionOfParties.Insert("NumberOfDataChunks", 0); // when calculating the stage, each portion of the generated data is first added into separate W, and at the end of the stage all of them are combined
	DistributionOfParties.Insert("PortionTableNames", ""); // names of all VT portions of the form <Table name>_<The number of portions from 1 to the number of portions given>

	#Region CheckingNumericFields
	
	HasGroupFields = RegisterRecordsDetails.Property("GroupFields");
	
	If HasGroupFields Then
		
		StructureOfSummationField = New Structure(RegisterRecordsDetails.SummationFields);
		StructureOfMetricsField = New Structure(RegisterRecordsDetails.Indicators);
		
		If RegisterRecordsDetails.Property("SummationFieldExceptions") Then
			StructureOfSummationFieldException = New Structure(RegisterRecordsDetails.SummationFieldExceptions);
		Else
			StructureOfSummationFieldException = New Structure;
		EndIf;
			
		If RegisterRecordsDetails.Property("ExceptionsIndicators") Then
			ExclusionStructureIndicators = New Structure(RegisterRecordsDetails.ExceptionsIndicators);
		Else
			ExclusionStructureIndicators = New Structure;
		EndIf;
			
		For Each CurrentColumn In TableForDistributionOfLots.Columns Do
			
			If ThisIsSummableColumnOfTable(CurrentColumn) Then
				
				If Not StructureOfSummationField.Property(CurrentColumn.Name)
				 And Not StructureOfSummationFieldException.Property(CurrentColumn.Name) Then
				 
					IssueDetails = NStr("vi = 'Chưa chỉ ra cột số trong các trường tổng kết:';
										|ru = 'Числовая колонка не указана в полях суммирования:';
										|en = 'Numeric column is not specified in summarization fields:'; fa = 'Numeric column is not specified in summarization fields:';
										|it = 'La colonna numerica non è indicata nei campi della sommatoria:';
										|pl = 'Liczbowa kolumna nie jest podana w polach sumowania:';
										|tr = 'Özet alanlarında sayısal sütun belirtilmedi:'", Common.DefaultLanguageCode()) + " " + CurrentColumn.Name;
					
					RegisterCalculationExecutionProblem(CalculationParameters,, IssueDetails);
					CostCalculationProtocol.FixCalculationError(CalculationParameters, Enums.TypesOfLotAccountingAndCostErrors.RunTimeError, IssueDetails, IssueDetails);
				 
			 	EndIf;
				
				If Not StructureOfMetricsField.Property(CurrentColumn.Name)
				 And Not ExclusionStructureIndicators.Property(CurrentColumn.Name) Then
				 
					IssueDetails = NStr("vi = 'Chưa chỉ ra cột số trong các trường chỉ tiêu:';
										|ru = 'Числовая колонка не указана в полях показателей:';
										|en = 'Numeric column is not specified in indicator fields:'; fa = 'Numeric column is not specified in indicator fields:';
										|it = 'La colonna numerica non è indicata nei campi degli indicatori:';
										|pl = 'Liczbowa kolumna nie jest podana w polach wskaźników:';
										|tr = 'Gösterge alanlarında sayısal sütun belirtilmedi:'", Common.DefaultLanguageCode()) + " " + CurrentColumn.Name;
					
					RegisterCalculationExecutionProblem(CalculationParameters,, IssueDetails);
					CostCalculationProtocol.FixCalculationError(CalculationParameters, Enums.TypesOfLotAccountingAndCostErrors.RunTimeError, IssueDetails, IssueDetails);
				 
			 	EndIf;
				
			EndIf;
			
		EndDo;
		
		
	EndIf;
	
	#EndRegion
	
	#Region UnloadingIntermediateData

	DistributionOfParties.Insert("ExportingData", False);

	If Lower(CalculationParameters.PresentationStage) = Lower(CalculationParameters.UploadingCalculationData.BatchAccountingStep22ForUploadingToFiles)
	 And (Not RegisterRecordsDetails.Property("DistributionIsNotRequired")
	 Or Not RegisterRecordsDetails.DistributionIsNotRequired) Then

		DirectoryName = TrimAll(CalculationParameters.UploadingCalculationData.DirectoryForSavingBatchCalculationData);

		If ValueIsFilled(DirectoryName) Then

			Try
				ErrorText = "";
				CreateDirectory(DirectoryName);
			Except
				ErrorText = BriefErrorDescription(ErrorInfo());
			EndTry;

			DirectoryName = CommonClientServer.AddLastPathSeparator(DirectoryName);
			Directory = New File(DirectoryName);

			If Not Directory.Exists() Or Not Directory.IsDirectory() Then

				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(NStr("vi = 'Không tìm thấy thư mục để lưu dữ liệu hạch toán lô hàng: ""%1""
					|%2';
					|ru = 'Не найден каталог для сохранения данных расчета партий: ""%1""
					|%2';
					|en = 'Directory for saving lot calculation data was not found: ""%1""
					|%2'; fa = 'Directory for saving lot calculation data was not found: ""%1""
					|%2';
					|it = 'Non è stato trovata una directory per il salvataggio dei dati di calcolo dei lotti: ""%1""
					|%2';
					|pl = 'Nie jest znaleziony katalog do zachowania danych obliczenia partii: ""%1""
					|%2';
					|tr = 'Lot hesaplama verilerini kaydetmek için katalog bulunamadı: ""%1""
					|%2'", Common.DefaultLanguageCode()), CostCalculationProtocol.ValuePresentation(DirectoryName), ErrorText);

				CostCalculationProtocol.FixCalculationError(CalculationParameters, Enums.TypesOfLotAccountingAndCostErrors.RunTimeError, ProtocolText_);
			Else

				Try
					DeleteFiles(DirectoryName, "*.mxl");
				Except
					ErrorText = DetailErrorDescription(ErrorInfo());
				EndTry;

				DistributionOfParties.Insert("ExportingData", True);
				DistributionOfParties.Insert("UploadingCalculationData", New Structure);

				DistributionOfParties.UploadingCalculationData.Insert("DirectoryName", DirectoryName);

				// Description of the table upload files.
				For Each KeyAndValue In New Structure("Data, Sources, Destinations, SettlementBatches") Do

					UploadFileDescription = InitializeUploadFileDescription();
					UploadFileDescription.FileName = DirectoryName + KeyAndValue.Key
						+ ".mxl";

					DistributionOfParties.UploadingCalculationData.Insert(KeyAndValue.Key, UploadFileDescription);

				EndDo;

				CalculationParameters.Insert("DistributionOfParties", DistributionOfParties);
				UnloadHeaderOfIntermediateCalculationDataTable(CalculationParameters, "SettlementBatches", DistributionOfParties.SettlementBatches);

			EndIf;

		EndIf;

	EndIf;

	#EndRegion

	CalculationParameters.Insert("DistributionOfParties", DistributionOfParties);

	CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "InitializeBatchDistribution");

	Return DistributionOfParties;

EndFunction

