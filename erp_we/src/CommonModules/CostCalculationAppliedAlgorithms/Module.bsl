#Region Companies

// Returns a string representation of an array of organizations.
//
// Parameters:
//	CompanyArray - Array - organizations to get an idea for.
//	Separator - String -
//	TextToRecordVIB - Boolean -
//
// Returns:
//	String - string representation of an array of organizations.
//
Function CalculatedCompanies(CompanyArray, Separator = Undefined, TextToRecordVIB = False) Export
	
	SetPrivilegedMode(True);
	
	If CompanyArray = Undefined Then
		If TextToRecordVIB Then
			Return NStr("vi = '<Tất cả các doanh nghiệp>';
						|ru = '<Все организации>';
						|en = '<All companies>'; fa = '<All companies>';
						|it = '<Tutte le organizzazioni>';
						|pl = '<Wszystkie firmy>';
						|tr = '<Tüm iş yerleri>'", Common.DefaultLanguageCode());
		Else
			Return NStr("vi = '<Tất cả các doanh nghiệp>';
						|ru = '<Все организации>';
						|en = '<All companies>'; fa = '<All companies>';
						|it = '<Tutte le organizzazioni>';
						|pl = '<Wszystkie firmy>';
						|tr = '<Tüm iş yerleri>'");
		EndIf;
	EndIf;
	
	CalculatedCompanies = "";
	
	If Separator = Undefined Then
		Separator = Chars.CR;
	EndIf;
	
	Query = New Query;
	Query.Text =
	"SELECT
	|	CatalogData.Description AS OrganizationPresentation
	|FROM
	|	Catalog.Companies AS CatalogData
	|WHERE
	|	CatalogData.Ref IN(&CompanyArray)
	|
	|ORDER BY
	|	OrganizationPresentation";
	
	Query.SetParameter("CompanyArray", TMCommonUseClientServer.Array(CompanyArray));
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		CalculatedCompanies = CalculatedCompanies
			+ ?(IsBlankString(CalculatedCompanies), "", Separator)
			+ Selection.OrganizationPresentation;
	EndDo;

	Return CalculatedCompanies;
	
EndFunction

// Returns an array of organizations that have movements (the calculation must be performed).
//
// Returns:
//	Array -
//
Function OrganizationsWithCostRegisteredRecords(CalculationPeriod, CompanyArray = Undefined) Export
	
	QueryTextFilterExpenseItems = "
	|SELECT
	|	T.Ref
	|INTO FilterExpenseItems
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS T
	|WHERE
	|	T.CostAllocationOptionManag IN (
	|		VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|		VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|	  AND T.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|	OR T.CostAllocationOptionLocal IN (
	|		VALUE(Enum.CostAllocationOptions.ToProductionCosts),
	|		VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|	  AND T.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|";
	
	QueryTextFilterCompanies = "
	|SELECT
	|	Companies.Ref
	|INTO FilterCompanies
	|FROM
	|	Catalog.Companies AS Companies
	|WHERE
	|	Companies.Ref IN(&FilterCompanies)
	|INDEX BY
	|	Ref
	|";
	
	QueryTextCompaniesList = "
	|SELECT
	|	Companies.Ref AS Organization
	|INTO CompaniesList
	|FROM
	|	FilterCompanies AS Companies
	|WHERE
	|	TRUE IN
	|		(SELECT TOP 1
	|			TRUE
	|		FROM
	|			AccumulationRegister.InventoryCost AS Data
	|		WHERE
	|			Data.Organization = Companies.Ref
	|			AND Data.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|			AND Data.Active)
	|
	|UNION ALL
	|
