// Distributed takes the party to a table of movements of the register.
//
Procedure CacheDistributedBatches(CalculationParameters, EndOfDistribution = True) Export
	
	If Not CalculationParameters.Property("DistributionOfParties") Then
		// At this stage of the calculation, the distribution of batches is not performed
		Return;
	EndIf;
	
	RegisterRecordsDetails = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	
	If RegisterRecordsDetails.DistributionIsNotRequired Then // the parties are being broadcast
		CacheBroadcastBatches(CalculationParameters, EndOfDistribution);
		Return;
	EndIf;
	
	RegisterName 		 = RegisterRecordsDetails.RegisterName;
	TempTableName  = RegisterRecordsDetails.TempTableName;
	IndexingFields   = RegisterRecordsDetails.IndexingFields;
	
	SettlementBatches 	 = CalculationParameters.DistributionOfParties.SettlementBatches;
	UnwrittenData = CalculationParameters.DistributionOfParties.UnwrittenData;
	
	// For testing purposes, a table of all accounting parties is used, in which all data from the calculated party is accumulated.
	AccumulateSettlementBatches = CalculationParameters.DistributionOfParties.Property("AllSettlementBatches");
	
	UnloadIntermediateCalculationDataTable(CalculationParameters, "SettlementBatches", SettlementBatches);
	
	If ValueIsFilled(RegisterName) Then
		
		CopiedFields = CommonColumnsOfDataSourceAndReceiver(CalculationParameters, SettlementBatches, RegisterName);
		
		For Each SettlementBatch In SettlementBatches Do
			
			If AccumulateSettlementBatches Then
				FillPropertyValues(
					CalculationParameters.DistributionOfParties.AllSettlementBatches.Add(),
					SettlementBatch);
			EndIf;
			
			If CalculatedBatchIsNotRecorded(SettlementBatch, UnwrittenData) Then
				Continue;
			EndIf;
			
			// Let's add a party to the movement and fill in its properties
			CalculationParameters.CalculationMechanismModule.AddEntryToMovementTable(
				CalculationParameters,
				RegisterName,
				SettlementBatch,
				CopiedFields,
				New Structure("CalculationIsNotCompleted", Not SettlementBatch.CalculationIsCompleted));
			
		EndDo;
		
		SettlementBatches.Clear(); // cached in motion
		
	ElsIf ValueIsFilled(TempTableName) Then
		
		// Delete the unwritten lines
		RowIndex = 0;
		
		While RowIndex <= SettlementBatches.Count() - 1 Do
			
			SettlementBatch = SettlementBatches[RowIndex];
			
			If AccumulateSettlementBatches Then
				FillPropertyValues(
					CalculationParameters.DistributionOfParties.AllSettlementBatches.Add(),
					SettlementBatch);
			EndIf;
			
			If CalculatedBatchIsNotRecorded(SettlementBatch, UnwrittenData) Then
				SettlementBatches.Delete(SettlementBatch);
			Else
				RowIndex = RowIndex + 1;
			EndIf;
			
		EndDo;
		
		// Let's make a list of significant columns of the settlement batch table
		NumberColumnNames	 = "";
		NamesOfNonNumericColumns	 = "";
		
		TemporaryTableExists = TemporaryTableExists(CalculationParameters, TempTableName);
		
		If TemporaryTableExists Then 
			SourceOfColumns = UnloadTemporaryTable(CalculationParameters, TempTableName, 0).Columns;
		Else
			SourceOfColumns = SettlementBatches.Columns;
		EndIf;
		
		For Each Column In SourceOfColumns Do
			
			If Not TemporaryTableExists
			 And (Column.Name = DefaultColumnNameForNumbering()
			 	Or Column.Name = "Priority"
			 	Or ((Column.Name = RegisterRecordsDetails.BasisOfArrival
			 	  Or Column.Name = RegisterRecordsDetails.BasisOfConsumption)
				    And Column.Name <> "Count")) Then
				// We do not take service fields from the settlement batches, we take all fields from the temporary table.
				Continue;
			ElsIf ThisIsSummableColumnOfTable(Column) Then
				NumberColumnNames = NumberColumnNames + ?(NumberColumnNames = "", "", ", ")
					+ "%1" + Column.Name;
			Else
				NamesOfNonNumericColumns = NamesOfNonNumericColumns + ?(NamesOfNonNumericColumns = "", "", ", ")
					+ "%1" + Column.Name;
			EndIf;
			
			If TemporaryTableExists And SettlementBatches.Columns.Find(Column.Name) = Undefined Then
				SettlementBatches.Columns.Add(
					Column.Name,
					CostCalculationUniversalAlgorithms.NonNullTypeDescriptions(Column.ValueType));
			EndIf;
			
		EndDo;
		
		ColumnsNames = NamesOfNonNumericColumns + ?(NumberColumnNames = "", "", ", " + NumberColumnNames);
		
		// Let's put the calculation batch table in a temporary table (arbitrary - not a register cache).
		PortionTableName = TableNameOfNextChunkOfData("DistributionOfParties", CalculationParameters.DistributionOfParties);
	
		PutTableOfValuesInTemporaryTable(
			CalculationParameters,
			PortionTableName,
			SettlementBatches,
			ColumnsNames);
		
		SettlementBatches.Clear(); // cached in a temporary table
		
		If EndOfDistribution Then
			
			MergeTemporaryTables(
				CalculationParameters,
				CalculationParameters.DistributionOfParties.PortionTableNames,
				TempTableName,
				ColumnsNames,
				NumberColumnNames,
				IndexingFields,
				True);
			
			CalculationParameters.DistributionOfParties.NumberOfDataChunks = 0;
			CalculationParameters.DistributionOfParties.PortionTableNames = "";
			
		EndIf;
			
	Else
		// We don't do anything with the Settlement Party table - it will accumulate records in itself until the end of the distribution.
		// At the same time, it does not have a limit on exceeding the maximum size of the table of values (the number of points).
	EndIf;
	
	If EndOfDistribution Then
		
		CompleteUnloadingOfIntermediateCalculationData(CalculationParameters);
		
		CalculationParameters.Delete("DistributionOfParties");
		
	EndIf;
	
EndProcedure

// Determines whether the specified calculation batch should be saved.
//
// Returns:
//	Boolean -
//
Function CalculatedBatchIsNotRecorded(SettlementBatch, UnwrittenData) Export
	
	Recorder = SettlementBatch.Recorder; // DocumentRef
	
	Result = (Not UnwrittenData.RecordUnfinishedTasks
		And Not SettlementBatch.CalculationIsCompleted)
		Or UnwrittenData.UnrecordedRecordTypes[SettlementBatch.EntryType] <> Undefined
		Or (UnwrittenData.UnwrittenPartitions.Count() > 0
		And UnwrittenData.UnwrittenPartitions[SettlementBatch.AccountingSection] <> Undefined)
		Or (ValueIsFilled(Recorder) // if the registrar is not filled in, then this situation will be handled when adding traffic
		And UnwrittenData.UnrecordedLoggers[Recorder.Metadata().Name] <> Undefined);
	
	Return Result;
	
EndFunction

// Determines whether the specified column in the value table is a column for summation or grouping.
//
Function ThisIsSummableColumnOfTable(Column)
	
	ExceptionStructure_ = New Structure("Priority, RowCode, RowCodeProducts"); // numeric Attributes that do not need to be summarized
	ExceptionStructure_.Insert(DefaultColumnNameForNumbering());
	
	Return Column.ValueType.ContainsType(Type("Number")) And Not ExceptionStructure_.Property(Column.Name);
	
EndFunction

// Determines whether the specified register detail is suitable for summation or grouping.
//
Function ThisIsSummedRegisterProps(MetaAttribute)
	
	If StrFind(MetaAttribute.Name, "VAT") = 0 Then
		Return False; // we summarize only the details with VAT
	EndIf;
	
	FieldDetails = New Structure("Name, ValueType", MetaAttribute.Name, MetaAttribute.Type);
	
	Return ThisIsSummableColumnOfTable(FieldDetails);
	
EndFunction

// Distributed takes the party to a table of movements of the register.
//
Procedure CacheBroadcastBatches(CalculationParameters, EndOfDistribution = True) Export
	
	If Not CalculationParameters.Property("DistributionOfParties") Then
		// At this stage of the calculation, the distribution of batches is not performed
		Return;
	EndIf;
	
	RegisterRecordsDetails 	 = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	RegisterName 		 = RegisterRecordsDetails.RegisterName;
	TempTableName  = RegisterRecordsDetails.TempTableName;
	DataTableName  	 = "Data";
	
	If ValueIsFilled(RegisterName) Then
		
		GenerateRegisteredRecordsByRegisterBasedOnTemporaryTableData(CalculationParameters, RegisterName, DataTableName,,, True);
		
	ElsIf ValueIsFilled(TempTableName) Then
		
		GenerateRegisteredRecordsInTemporaryTableFromAnotherTemporaryTable(CalculationParameters,, False);
		
	Else
		// The receiver table is not specified, we are not doing anything.
	EndIf;
	
	If EndOfDistribution Then
		CalculationParameters.Delete("DistributionOfParties");
	EndIf;
	
EndProcedure

// Transfers new register movements from the value table to the temporary table.
// The procedure must be called at the end of each stage where some movements are formed,
// otherwise the next stage may not take into account the movements of the previous one.
//
Procedure CacheGeneratedRegisteredRecords(CalculationParameters, DestinationTable = Undefined, StageEnd = True) Export
	
	If StageEnd Then
		// At the end of the stage, the batch distribution table must be moved to the register movement table
		// or to a temporary table, depending on the distribution settings.
		CacheDistributedBatches(CalculationParameters, StageEnd);
	EndIf;
	
	For Each KeyAndValue In CalculationParameters.RegisterRecords Do
		
		If DestinationTable <> Undefined And Lower(KeyAndValue.Key) <> Lower(DestinationTable) Then
			Continue; // if the register name is explicitly specified, then only it needs to be processed
		EndIf;
		
		RegisterDescription = KeyAndValue.Value;
		
		If RegisterDescription.Table.Count() > 0 Then
			
			CheckFormationOfRegisterRecordedRegister(RegisterDescription);
		
			// Let's move the generated movements from the description of the register.Table to the temporary VTKASH table.
			
			ThisIsCostRegister = (RegisterDescription.RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name);
			ThisIsRevenueRegister = (RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name);
			
			// Fill in the service field of the calculation of the cost
			If RegisterDescription.ThereIsCostCalculation Then
				RegisterDescription.Table.FillValues(Not CalculationParameters.PartiesAreBeingCalculated, "CalculationOfCost");
			EndIf;
			
			// Fill in the service field Calculation
			// of parties (for the stage of filling in parties in the cost price, this attribute is set in the Add Record function of the Table of Movements).
			If RegisterDescription.ThereIsCalculationOfParties
			 And Not (ThisIsCostRegister And CalculationParameters.LotsAreFilledInAtCostPrice)
			 And Not (ThisIsRevenueRegister And CalculationParameters.BatchesInRevenueAreFilledIn) Then
				RegisterDescription.Table.FillValues(CalculationParameters.PartiesAreBeingCalculated, "LotCalculation");
			EndIf;
			
			If RegisterDescription.ThereIsPropertyTypeOfMovement Then
				For Each Record In RegisterDescription.Table Do
					Record.OfficialTypeOfMovementParish = (Record.RecordType = AccumulationRecordType.Receipt);
				EndDo;
			EndIf;
			
			// Let's check whether the required fields are full.
			InvalidLoggers = New Map; 
			
			For Each FieldDetails In RegisterDescription.RequiredFields Do
				
				TheStructureOfTheSearch    = New Structure(FieldDetails.Key, FieldDetails.Value);
				InvalidLines = RegisterDescription.Table.FindRows(TheStructureOfTheSearch);
					
				For Each MotionData In InvalidLines Do
					
					// We will output information about the error in the generated movements.
					// Information about the problem with the registrar is displayed in the Add Record Table Movements procedures.
					If InvalidLoggers.Get(MotionData.Recorder) = Undefined
					 And FieldDetails.Key <> "Recorder" Then
						
						InvalidLoggers.Insert(MotionData.Recorder, True);
						
						If RegisterDescription.ThereIsACompany Then
							OrganizationWithProblem = MotionData.Organization;
						ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
							PartnerAnalyticsOrganization = CalculationParameters.PartnerAnalyticsOrganization; // Map
							OrganizationWithProblem = PartnerAnalyticsOrganization.Get(MotionData.AccountingDimensionByPartners);
						Else
							OrganizationWithProblem = Undefined;
						EndIf;
						
						ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
							NStr("vi = 'Theo chứng từ ""%1"" đã tạo các bản ghi kết chuyển theo biểu ghi ""%2"" mà chưa điền các trường bắt buộc';
								|ru = 'По документу ""%1"" сформированы движения по регистру ""%2"" с незаполненными обязательными полями';
								|en = 'Records in the ""%2"" register with empty required fields are generated for the ""%1"" document'; fa = 'Records in the ""%2"" register with empty required fields are generated for the ""%1"" document';
								|it = 'Sul documento ""%1"" sono stati creati dei movimenti secondo il registro ""%2"" con dei campi obbligatori non compilati';
								|pl = 'Zgodnie z dokumentem ""%1"" są utworzone ruchy w rejestrze ""%2"" z pustymi wymaganymi polami';
								|tr = '""%1"" belgesi için, ""%2"" kaydı üzerindeki hareketler doldurulmamış zorunlu alanlarla oluşturuldu'", Common.DefaultLanguageCode()),
							TrimAll(MotionData.Recorder),
							RegisterDescription.RegisterName);
						
						CostCalculationProtocol.FixCalculationError(
							CalculationParameters,
							Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenGeneratingRecordsInRegisters,
							ProtocolText_);
						
						RegisterCalculationExecutionProblem(
							CalculationParameters,
							OrganizationWithProblem,
							NStr("vi = 'Khi tạo các bản ghi kết chuyển, đã chẩn đoán lỗi';
								|ru = 'При формировании движений диагностированы ошибки';
								|en = 'Errors were found when generating the movements'; fa = 'Errors were found when generating the movements';
								|it = 'Durante la creazione dei movimenti sono stati diagnosticati degli errori';
								|pl = 'Podczas tworzenia ruchów zdiagnozowano błędy';
								|tr = 'Hareketlerin oluşumunda hatalar tespit edilmiştir'", Common.DefaultLanguageCode()),
							ProtocolText_,
							MotionData.Recorder);
							
					EndIf;
					
					RegisterDescription.Table.Delete(MotionData);
					
				EndDo;
					
			EndDo;
			
			If RegisterDescription.Table.Count() > 0 Then
				
				PortionTableName = TableNameOfNextChunkOfData(RegisterDescription.RegisterCacheTableName, RegisterDescription);
				
				PutTableOfValuesInTemporaryTable(
					CalculationParameters,
					PortionTableName,
					RegisterDescription.Table,
					RegisterDescription.RegisterCacheFields,
					RegisterDescription.RegisterIndexes);
				
				// Let's clear the records accumulated in the table of values - they have been moved to a temporary table.
				RegisterDescription.Table.Clear();
				
				// There have been changes in VTKASH that have not yet been taken into account in Vtkashcountable statistics and VTKASHCOUNTABLE turnovers.
				RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = True;
				
			EndIf;
			
		EndIf;
		
		If StageEnd Then
			
			IntermediateTableName = "TTTableOfRegisteredRecordsUntyped";
			
			MergeTemporaryTables(
				CalculationParameters,
				RegisterDescription.PortionTableNames,
				IntermediateTableName,
				RegisterDescription.RegisterCacheFields,
				RegisterDescription.SelectionFieldsOfNonemptyMotions,
				,
				True);
			
			RegisterDescription.NumberOfDataChunks = 0;
			RegisterDescription.PortionTableNames = "";
			
			If TemporaryTableExists(CalculationParameters, IntermediateTableName) Then
				
				MatchingTemporaryMovementTables = New Map;
				MatchingTemporaryMovementTables.Insert(IntermediateTableName, RegisterDescription.RegisterName);
				
				CacheGeneratedRegisteredRecordsFromTemporaryTables(
					CalculationParameters,
					MatchingTemporaryMovementTables,
					True,
					False,
					// At the stages of filling batches in the cost of goods and revenue and cost of sales, typing of values is not performed.
					Not CalculationParameters.LotsAreFilledInAtCostPrice And Not CalculationParameters.BatchesInRevenueAreFilledIn); // TypifyValues
				
			EndIf;
			
		EndIf;
		
		If StageEnd And RegisterDescription.ItIsNecessaryToUpdateCalculatedCache Then
			
			// "Inside" the calculation stage, multiple "batch" caching of generated records can be performed,
			// but the current Vtkashraschetnyeostatki and Vtkashraschetnye turns are needed not "inside" the stage,
			// but by its completion (by the beginning of the next stage).
			
			// Let's reformulate the table of register entries
			If CalculationParameters.RegistersWithCalculatedRevolutions.Property(KeyAndValue.Key)  // need a table of records 
			 And CalculationParameters.RegistersWithCalculatedRevolutions[KeyAndValue.Key] Then       // need to auto-update the record table
				UpdateEstimatedRegisterRevolutions(CalculationParameters, RegisterDescription);
			EndIf;
			
			// Recalculate the remaining register at the end of the period
			If CalculationParameters.RegistersWithCalculatedBalances.Property(KeyAndValue.Key) // we need calculated balances
			 And CalculationParameters.RegistersWithCalculatedBalances[KeyAndValue.Key] Then      // you need to auto-update the balances
				UpdateEstimatedRegisterBalances(CalculationParameters, RegisterDescription);
			EndIf;
			
			RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = False; // we took into account all movements in the cache of balances/revolutions
			
		EndIf;
		
	EndDo;
	
	For Each KeyAndValue In CalculationParameters.AuxiliaryTemporaryTables Do
		
		If DestinationTable <> Undefined And Lower(KeyAndValue.Key) <> Lower(DestinationTable) Then
			Continue; // if the register name is explicitly specified, then only it needs to be processed
		EndIf;
		
		TableDetails = KeyAndValue.Value;
		
		If TableDetails.Table.Count() > 0 Then
			
			// Let's move the generated movements from the description of the table.Table to the desired temporary table.
			
			If TableDetails.ThereIsPropertyTypeOfMovement Then
				
				For Each Record In TableDetails.Table Do
					
					// Let's fill in the field of service movementreferences
					If TableDetails.ThereIsPropertyTypeOfMovement Then
						Record.OfficialTypeOfMovementParish = (Record.RecordType = AccumulationRecordType.Receipt);
					EndIf;
					
				EndDo;
				
			EndIf;
			
			// Adding information to the protocol 
			CostCalculationProtocol.TTCachingOfGeneratedRecords(
				CalculationParameters,
				KeyAndValue.Key,
				TableDetails.Table.Count());
			
			PortionTableName = TableNameOfNextChunkOfData(KeyAndValue.Key, TableDetails);
			
			PutTableOfValuesInTemporaryTable(
				CalculationParameters,
				PortionTableName,
				TableDetails.Table,
				TableDetails.TableFields);
				
			// Let's clear the records accumulated in the table of values - they have been moved to a temporary table.
			TableDetails.Table.Clear();
			
			If StageEnd Then
				
				MergeTemporaryTables(
					CalculationParameters,
					TableDetails.PortionTableNames,
					KeyAndValue.Key,
					TableDetails.TableFields,
					TableDetails.SummableFields,
					,
					True);
				
				TableDetails.NumberOfDataChunks = 0;
				TableDetails.PortionTableNames = "";
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
EndProcedure

// Transfers new register movements from temporary tables to the cache (temporary table).
// the Procedure must be called at the end of each stage where some movements are generated,
// if these movements were saved in the temporary table.
// Otherwise, the next stage may not take into account the movements of the previous one.
//
Procedure CacheGeneratedRegisteredRecordsFromTemporaryTables(CalculationParameters, MatchingTemporaryMovementTables,
			DeleteTemporaryTables_ = False, UpdateCalculatedCaches = True, TypifyValues = True) Export
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(
		CalculationParameters,
		"CacheGeneratedRegisteredRecordsFromTemporaryTables",
		NStr("vi = 'Bộ nhớ đệm của bản ghi kết chuyển từ bảng tạm';
			|ru = 'Кэширование движений из временных таблиц';
			|en = 'Cache temporary table register records'; fa = 'Cache temporary table register records';
			|it = 'Memorizzazione della cache dei movimenti dalle tabelle temporanee';
			|pl = 'Buforowanie przepływów z tabel tymczasowych';
			|tr = 'Geçici tablolardan hareketleri önbelleğe alma'", Common.DefaultLanguageCode()));
			
	RegisterMatching = New Map;
	
	For Each KeyAndValueTt In MatchingTemporaryMovementTables Do
		
		RegisterDescription = CalculationParameters.RegisterRecords[KeyAndValueTt.Value];
		
		CheckFormationOfRegisterRecordedRegister(RegisterDescription);
		
		TableRowsCount = TemporaryTableSize(CalculationParameters, KeyAndValueTt.Key);
		
		If TableRowsCount > 0 Then
			
			// the empty logger is checked here
			If RegisterDescription.ThisIsRegisterDescription And RegisterDescription.SubordinateToRegistrar Then
				
				DestinationTable = RegisterDescription.RegisterName;
				
				Query = New Query;
				InitializeRequestProperties(Query, CalculationParameters);
				
				Query.Text = GETRequestHeader();
				
				If RegisterDescription.ThereIsACompany Then
					Query.Text = Query.Text + "
					|	Organization AS Organization,";
				ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
					Query.Text = Query.Text + "
						|	AccountingDimensionByPartners AS AccountingDimensionByPartners,";
				EndIf;
				
				Query.Text = Query.Text + "
				|	Recorder AS Recorder,
				|	Recorder AS DocumentRegisterRecords
				|FROM
				|	" + KeyAndValueTt.Key + "
				|WHERE
				|	Recorder IS NULL
				|	OR Recorder = UNDEFINED
				|	OR (NOT VALUETYPE(Recorder) IN(" + AvailableLoggerTypes(DestinationTable) + "))
				|";
				
				MotionData = Query.Execute().Select();
				While MotionData.Next() Do

					If RegisterDescription.ThereIsACompany Then
						OrganizationWithProblem = MotionData.Organization;
					ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
						PartnerAnalyticsOrganization = CalculationParameters.PartnerAnalyticsOrganization; // Map
						OrganizationWithProblem = PartnerAnalyticsOrganization.Get(MotionData.AccountingDimensionByPartners);
					Else
						OrganizationWithProblem = Undefined;
					EndIf;
						
					If RegisterDescription.SubordinateToRegistrar And Not ValueIsFilled(MotionData.Recorder) Then
						// Error in requests - the required field of the document movement is not filled in.
						ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
							NStr("vi = 'Chưa điền thuộc tính %1 đối với bản ghi kết chuyển theo biểu ghi ""%2"" (kỳ %3, doanh nghiệp ""%4"")';
								|ru = 'Не заполнено свойство %1 для движения по регистру ""%2"" (период %3, организация ""%4"")';
								|en = 'The %1 property for the ""%2"" register record is not filled in (period %3, company ""%4"")'; fa = 'The %1 property for the ""%2"" register record is not filled in (period %3, company ""%4"")';
								|it = 'Non è compilata la proprietà %1 per il movimento per registro ""%2"" (periodo %3, azienda ""%4"")';
								|pl = 'Nie wypełniono właściwości%1 dla przepływu według rejestru ""%2"" (okres %3, firma ""%4"")';
								|tr = '""%2"" kaydı için hareket %1 özelliği doldurulmadı (%3 dönemi, ""%4"" iş yeri)'", Common.DefaultLanguageCode()),
							"DocumentRegisterRecords",
							DestinationTable,
							CostCalculationProtocol.PresentationOfCalculationPeriod(CalculationParameters),
							OrganizationWithProblem);
					ElsIf RegisterDescription.SubordinateToRegistrar Then
						// Error in metadata - the document is not a registrar for this register.
						ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
							NStr("vi = 'Chứng từ ""%1"" không thể có bản ghi kết chuyển theo biểu ghi ""%2"" (kỳ %3, doanh nghiệp ""%4"")';
								|ru = 'Документ ""%1"" не может иметь движений по регистру ""%2"" (период %3, организация ""%4"")';
								|en = 'The ""%1"" document cannot have the ""%2"" register records (period %3, company ""%4"")'; fa = 'The ""%1"" document cannot have the ""%2"" register records (period %3, company ""%4"")';
								|it = 'Il documento ""%1"" non può avere movimenti in base al registro ""%2"" (periodo %3, azienda ""%4"")';
								|pl = 'Dokument ""%1"" nie może mieć przepływu według rejestru ""%2"" (okres %3, firma ""%4"")';
								|tr = 'Belge ""%1"", kayıt ""%2"" üzerinde hareketlere sahip olamaz (dönem %3, iş yeri ""%4"")'", Common.DefaultLanguageCode()),
							TrimAll(MotionData.Recorder),
							DestinationTable,
							CostCalculationProtocol.PresentationOfCalculationPeriod(CalculationParameters),
							OrganizationWithProblem);
					EndIf;
					
					CostCalculationProtocol.FixCalculationError(
						CalculationParameters,
						Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenGeneratingRecordsInRegisters,
						ProtocolText_);
					
					RegisterCalculationExecutionProblem(
						CalculationParameters,
						OrganizationWithProblem,
						NStr("vi = 'Khi tạo các bản ghi kết chuyển, đã chẩn đoán được lỗi';
							|ru = 'При формировании движений диагностированы ошибки';
							|en = 'Errors were found when generating the movements'; fa = 'Errors were found when generating the movements';
							|it = 'Durante la creazione dei movimenti sono stati diagnosticati degli errori';
							|pl = 'Podczas tworzenia ruchów zdiagnozowano błędy';
							|tr = 'Hareketlerin oluşumunda hatalar tespit edilmiştir'", Common.DefaultLanguageCode()),
						ProtocolText_,
						MotionData.DocumentRegisterRecords);
						
				EndDo;
				
			EndIf;
			
			// Let's check whether the required fields are full.
			InvalidLoggers = New Map; 
			
			Query = New Query;
			InitializeRequestProperties(Query, CalculationParameters);
			
			Query.Text = GETRequestHeader();
			
			If Not RegisterDescription.SubordinateToRegistrar Then
				Query.Text = Query.Text + "
				|	T.Organization AS Organization";
			ElsIf RegisterDescription.ThereIsACompany Then
				Query.Text = Query.Text + "
				|	T.Organization AS Organization,";
			ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
				Query.Text = Query.Text + "
					|	T.AccountingDimensionByPartners AS AccountingDimensionByPartners,";
			EndIf;
			
			If RegisterDescription.SubordinateToRegistrar Then
				
				Query.Text = Query.Text + "
				|	T.Recorder AS Recorder,
				|	T.Recorder AS DocumentRegisterRecords
				|FROM
				|	" + KeyAndValueTt.Key + " AS T
				|WHERE
				|	NOT Recorder IS NULL
				|	AND Recorder <> UNDEFINED
				|	AND (VALUETYPE(Recorder) IN(" + AvailableLoggerTypes(DestinationTable) + "))
				|	AND (" + RegisterDescription.TextForCheckingRequiredFields + ")";
				
			Else 
				
				Query.Text = Query.Text + "
				|	,UNDEFINED AS Recorder
				|FROM
				|	" + KeyAndValueTt.Key + " AS T";
				
				If ValueIsFilled(RegisterDescription.TextForCheckingRequiredFields) Then
					Query.Text = Query.Text + "
					|WHERE
					|	(" + RegisterDescription.TextForCheckingRequiredFields + ")";
				Else
					Query.Text = Query.Text + "
					|WHERE
					|	FALSE";
				EndIf;
				
			EndIf;
			
			CheckResult = Query.Execute();
			Selection = CheckResult.Select();
			While Selection.Next() Do
				
				InvalidLoggers.Insert(Selection.Recorder, True);
				
				If RegisterDescription.ThereIsACompany Then
					OrganizationWithProblem = Selection.Organization;
				ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
					PartnerAnalyticsOrganization = CalculationParameters.PartnerAnalyticsOrganization; // Map
					OrganizationWithProblem = PartnerAnalyticsOrganization.Get(Selection.AccountingDimensionByPartners);
				Else
					OrganizationWithProblem = Undefined;
				EndIf;
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Theo chứng từ ""%1"" đã tạo các bản ghi kết chuyển theo biểu ghi ""%2"" với các trường bắt buộc trống';
						|ru = 'По документу ""%1"" сформированы движения  по регистру ""%2"" с незаполненными обязательными полями';
						|en = 'Records in the ""%2"" register with empty required fields are generated for the ""%1""  document'; fa = 'Records in the ""%2"" register with empty required fields are generated for the ""%1""  document';
						|it = 'Sul documento ""%1"" sono stati creati dei movimenti secondo il registro ""%2"" con dei campi obbligatori non compilati';
						|pl = 'Zgodnie z dokumentem ""%1"" są formowane ruchy w rejestrze ""%2"" z pustymi wymaganymi polami';
						|tr = '""%1"" belgesi için, ""%2"" kaydı üzerindeki hareketler doldurulmamış zorunlu alanlarla oluşturuldu'", Common.DefaultLanguageCode()),
					TrimAll(Selection.Recorder),
					RegisterDescription.RegisterName);
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenGeneratingRecordsInRegisters,
					ProtocolText_);
				
				RegisterCalculationExecutionProblem(
					CalculationParameters,
					OrganizationWithProblem,
					NStr("vi = 'Khi tạo các bản ghi kết chuyển, đã chẩn đoán được lỗi';
						|ru = 'При формировании движений диагностированы ошибки';
						|en = 'Errors were found when generating the movements'; fa = 'Errors were found when generating the movements';
						|it = 'Durante la creazione dei movimenti sono stati diagnosticati degli errori';
						|pl = 'Podczas tworzenia ruchów zdiagnozowano błędy';
						|tr = 'Hareketlerin oluşumunda hatalar tespit edilmiştir'", Common.DefaultLanguageCode()),
					ProtocolText_,
					Selection.Recorder);
				
			EndDo;
			
			SourceColumns = TemporaryTableColumns(CalculationParameters, KeyAndValueTt.Key, False);
			SourceOfColumns = CalculationParameters.RegisterRecords[KeyAndValueTt.Value].Table; // ValueTable
			DestinationColumns = SourceOfColumns.Columns;
			
			TableFieldText = "";
			TableFieldNumber = 0;
			
			For Each CurrentColumn In SourceColumns Do
				
				DestinationColumn = DestinationColumns.Find(CurrentColumn.Name);
				
				If DestinationColumn = Undefined Then
					ColumnType = New TypeDescription;
				Else
					ColumnType = CostCalculationUniversalAlgorithms.NonNullTypeDescriptions(DestinationColumn.ValueType);
				EndIf;
				
				If DestinationColumn = Undefined
				 Or Not TypifyValues // you need to type the fields only in the stages of calculation/translation of batches
				 Or ColumnType.Types().Count() = 0
				 Or ColumnType.ContainsType(Type("PointInTime")) Then
					
					TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",") + "
						|	T." + CurrentColumn.Name + " AS " + CurrentColumn.Name;
					Continue;
					
				EndIf;
				
				TableFieldNumber = TableFieldNumber + 1;
				TableFieldNumberByString = Format(TableFieldNumber, "NZ=0; NG=");
				
				EmptyTypeValue = ColumnType.AdjustValue(Undefined);
				ArrayOfSuitableTypes = New Array;
				ArrayOfEmptyValues_ = New Array;
				
				NumberField = ColumnType.Types().Count() = 1 And ColumnType.Types()[0] = Type("Number")
					And ColumnType.NumberQualifiers.Digits > 0;
				
				For Each Current_Type In ColumnType.Types() Do
					
					ArrayOfSuitableTypes.Add(Current_Type);
					
					CurTypeDescription = New TypeDescription(TMCommonUseClientServer.Array(Current_Type, False));
					
					If Current_Type <> Type("Boolean") And Current_Type <> Type("Date") And Current_Type <> Type("String")
					 And Current_Type <> Type("Number") And Current_Type <> Type("UUID") Then
						ArrayOfEmptyValues_.Add(CurTypeDescription.AdjustValue(Undefined));
					EndIf;
					
				EndDo;
				
				If ColumnType.ContainsType(Type("AccumulationRecordType")) Then
					// In a request for fields of this type, the VALUE TYPE() method crashes with an error
					TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",") + "
						|	CASE WHEN T." + CurrentColumn.Name + " <> VALUE(AccumulationRecordType.Receipt)
						|	  AND T." + CurrentColumn.Name + " <> VALUE(AccumulationRecordType.Expense)
						|		THEN UNDEFINED
						|		ELSE T." + CurrentColumn.Name + "
						|	END AS " + CurrentColumn.Name;
				ElsIf ColumnType.ContainsType(Type("Date")) And ArrayOfSuitableTypes.Count() = 1 Then
					// In further requests to a field of this type, the START PERIOD() method crashes with an error if you use &Empty Type value
					TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",") + "
						|	CAST(CASE WHEN NOT VALUETYPE(T." + CurrentColumn.Name + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
						|	  OR T." + CurrentColumn.Name + " IN (&ArrayOfEmptyValues_" + TableFieldNumberByString + ")
						|		THEN DATETIME(1,1,1,0,0,0)
						|		ELSE T." + CurrentColumn.Name + "
						|	END AS DATE) AS " + CurrentColumn.Name;
				ElsIf NumberField Then
					MaxValue = GetMaximumValueOfNumber(ColumnType.NumberQualifiers.Digits,
						ColumnType.NumberQualifiers.FractionDigits);
					MaximumValueString = Format(MaxValue, "NZ=0; NG=; NDS=.");
			
					TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",") + "
						|	CASE WHEN NOT VALUETYPE(T." + CurrentColumn.Name + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
						|	  OR T." + CurrentColumn.Name + " IN (&ArrayOfEmptyValues_" + TableFieldNumberByString + ")
						|		THEN &EmptyTypeValue" + TableFieldNumberByString + "
						|		WHEN T." + CurrentColumn.Name + " > " + MaximumValueString + "
						|			THEN " + MaximumValueString + "
						|		WHEN T." + CurrentColumn.Name + " < -" + MaximumValueString + "
						|			THEN -" + MaximumValueString + "
						|		ELSE CAST(T." + CurrentColumn.Name + " AS NUMBER("
							+ TrimAll(ColumnType.NumberQualifiers.Digits) + "," + TrimAll(ColumnType.NumberQualifiers.FractionDigits) + "))
						|	END AS " + CurrentColumn.Name;
				ElsIf RegisterDescription.ThisIsRegisterDescription And RegisterDescription.UntypedFields.Property(CurrentColumn.Name) Then
					TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",") + "
						|	CASE WHEN NOT VALUETYPE(T." + CurrentColumn.Name + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
						|		THEN &EmptyTypeValue" + TableFieldNumberByString + "
						|		ELSE T." + CurrentColumn.Name + "
						|	END AS " + CurrentColumn.Name;
				Else
					TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",") + "
						|	CASE WHEN NOT VALUETYPE(T." + CurrentColumn.Name + ") IN (&ArrayOfSuitableTypes" + TableFieldNumberByString + ")
						|	  OR T." + CurrentColumn.Name + " IN (&ArrayOfEmptyValues_" + TableFieldNumberByString + ")
						|		THEN &EmptyTypeValue" + TableFieldNumberByString + "
						|		ELSE T." + CurrentColumn.Name + "
						|	END AS " + CurrentColumn.Name;
				EndIf;
				
				Query.SetParameter("ArrayOfSuitableTypes" + TableFieldNumberByString, ArrayOfSuitableTypes);
				Query.SetParameter("ArrayOfEmptyValues_" + TableFieldNumberByString,  ArrayOfEmptyValues_);
				Query.SetParameter("EmptyTypeValue" + TableFieldNumberByString,    EmptyTypeValue);
				
			EndDo;
			
			Query.Text =
			"SELECT
			|	&TableFieldText
			|INTO TTBuffer
			|FROM
			|	TempTableName AS T
			|WHERE
			|	TRUE
			|	AND NOT (&CheckingRequiredFields)
			|;
			|
			|/////////////////////////////////////////////////////////
			|DROP TempTableName
			|;
			|
			|/////////////////////////////////////////////////////////
			|SELECT
			|	*
			|INTO TempTableName
			|FROM
			|	TTBuffer
			|;
			|
			|/////////////////////////////////////////////////////////
			|DROP TTBuffer
			|";
			
			Query.Text = StrReplace(Query.Text, "TempTableName", KeyAndValueTt.Key);
			Query.Text = StrReplace(Query.Text, "&CheckingRequiredFields", RegisterDescription.TextForCheckingRequiredFields);
			Query.Text = StrReplace(Query.Text, "&TableFieldText", TrimAll(TableFieldText));
			
			Query.Execute();
			
			TableRowsCount = TemporaryTableSize(CalculationParameters, KeyAndValueTt.Key);
			
			If TableRowsCount > 0 Then
				
				// There have been changes in VTKASH that have not yet been taken into account in Vtkashcountable statistics and VTKASHCOUNTABLE turnovers.
				RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = True;
				
				If RegisterMatching[RegisterDescription.RegisterName] = Undefined Then
					RegisterMatching.Insert(RegisterDescription.RegisterName, KeyAndValueTt.Key);
				Else
					RegisterMatching[RegisterDescription.RegisterName] = RegisterMatching[RegisterDescription.RegisterName] + "," + KeyAndValueTt.Key;
				EndIf;
				
				RegisterDescription.NumberOfDataChunks = RegisterDescription.NumberOfDataChunks + 1;
				RegisterDescription.PortionTableNames = RegisterMatching[RegisterDescription.RegisterName];
				
			EndIf;
	
		EndIf;
		
	EndDo;
	
	For Each KeyAndValue In RegisterMatching Do
		
		RegisterDescription = CalculationParameters.RegisterRecords[KeyAndValue.Key];
		
		// Adding information to the protocol 
		ArrayOfTables = StringFunctionsClientServer.SplitStringIntoSubstringsArray(RegisterDescription.PortionTableNames, ",");
		SizeOfTables = 0;
		
		For Each TableName In ArrayOfTables Do
			SizeOfTables = SizeOfTables + TemporaryTableSize(CalculationParameters, TableName);
		EndDo;
		
		CostCalculationProtocol.CachingGeneratedRegisteredRecords(
			CalculationParameters,
			KeyAndValue.Key,
			SizeOfTables);
		
		MergeTemporaryTables(
			CalculationParameters,
			RegisterDescription.PortionTableNames,
			RegisterDescription.RegisterCacheTableName,
			RegisterDescription.RegisterCacheFields,
			RegisterDescription.SelectionFieldsOfNonemptyMotions,
			RegisterDescription.RegisterIndexes,
			True);
			
		If UpdateCalculatedCaches And RegisterDescription.ItIsNecessaryToUpdateCalculatedCache Then
			
			// "Inside" the calculation stage, multiple "batch" caching of generated records can be performed,
			// but the current Vtkashraschetnyeostatki and Vtkashraschetnye turns are needed not "inside" the stage,
			// but by its completion (by the beginning of the next stage).
			
			// Let's reformulate the table of register entries
			If CalculationParameters.RegistersWithCalculatedRevolutions.Property(KeyAndValue.Key)  // need a table of records 
			 And CalculationParameters.RegistersWithCalculatedRevolutions[KeyAndValue.Key] Then       // need to auto-update the record table
				UpdateEstimatedRegisterRevolutions(CalculationParameters, RegisterDescription);
			EndIf;
			
			// Recalculate the remaining register at the end of the period
			If CalculationParameters.RegistersWithCalculatedBalances.Property(KeyAndValue.Key) // we need calculated balances
			 And CalculationParameters.RegistersWithCalculatedBalances[KeyAndValue.Key] Then      // you need to auto-update the balances
				UpdateEstimatedRegisterBalances(CalculationParameters, RegisterDescription);
			EndIf;
			
			RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = False; // we took into account all movements in the cache of balances/revolutions
			
		EndIf;
		
		RegisterDescription.NumberOfDataChunks = 0;
		RegisterDescription.PortionTableNames = "";
		
	EndDo;
	
	If DeleteTemporaryTables_ Then
		
		For Each KeyAndValueTt In MatchingTemporaryMovementTables Do
			DestroyTemporaryTables(CalculationParameters, KeyAndValueTt.Key); 
		EndDo;
		
	EndIf;
	
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
EndProcedure

// For registers whose main tables are accessed in queries, we will create the following temporary tables:
// - Vtkashrashchetnyeoborotations<Register name> - it will contain the estimated register turnover
// , So at any stage of calculation there will be a ready-made table of register entries for the period,
// which should be used instead of the main table of accumulation Register.<Register name>
// and instead of the virtual table, the accumulation Register.<Register name>.Turnover (<calculation period>).
Procedure UpdateEstimatedRegisterRevolutions(CalculationParameters, RegisterDescription, Initialize = False) Export
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters,
		RegisterDescription.NameOfCalculatedRegisterRevolutionsTable, NStr("vi = 'Phụ trợ';
																			|ru = 'Вспомогательная';
																			|en = 'Auxiliary'; fa = 'کمکی';
																			|it = 'Ausiliaria';
																			|pl = 'Auxiliary';
																			|tr = 'Yardımcı'", Common.DefaultLanguageCode()));
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	// If you do not need to use a temporary VTKASH table, then all data will be taken from the IB.
	// Otherwise, only the primary movements will be taken from the IB and summed up with the calculated movements from VTKESH.
	Query.SetParameter("UseCache", RegisterDescription.UseTTCache And Not CalculationParameters.Debug.CalculationOfOneStage);
	
	If Not Initialize Then
		Query.Text =
		"DROP NameOfCalculatedRegisterRevolutionsTable
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
	EndIf;
	
	Query.Text = Query.Text +
	"SELECT
	|	&FieldsOfMainRegisterTable
	|INTO NameOfCalculatedRegisterRevolutionsTable
	|FROM
	|	NameOfMainRegisterTable AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Active
	|	AND &FilterByCompany
	|	AND (&SelectingServiceDataConversionRecords
	|	   AND &SelectionByServiceDetails
	|		  OR NOT &UseCache)
	|
	|UNION ALL
	|
	|SELECT
	|	&RegisterCacheFields
	|FROM
	|	RegisterCacheTableName AS T
	|WHERE
	|	&UseCache
	|	AND &FilterByCompany
	|	AND &RegisterIndexes
	|";
	
	RegisterCacheFields 			= StrReplace(RegisterDescription.RegisterCacheFieldsAreTyped, "%1", "T.");
	FieldsOfMainRegisterTable = StrReplace(RegisterDescription.FieldsOfMainRegisterTable, "%1", "T.");
	
	// To calculate the average cost (excluding batches), we will clear the batch fields of the calculation cache.
	If ItIsNecessaryToClearFieldsFromCalculatedCache(CalculationParameters, RegisterDescription) Then
		
		ReplaceableFragments = New Structure;
		ReplaceableFragments.Insert("Lot",					  "UNDEFINED");
		ReplaceableFragments.Insert("LotVendorAttributes",	  "VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)");
		ReplaceableFragments.Insert("FinancialAccountingDimension", "UNDEFINED");
		ReplaceableFragments.Insert("VATActivityType",		  "VALUE(Enum.VATTaxationTypes.EmptyRef)");
		
		RegisterCacheFields 			= RegisterCacheFields + ",";
		FieldsOfMainRegisterTable = FieldsOfMainRegisterTable + ",";
		
		For Each KeyAndValue In ReplaceableFragments Do
			
			RegisterCacheFields = StrReplace(RegisterCacheFields,
				"T." + KeyAndValue.Key + ",",
				"CASE WHEN &ScheduledJob THEN " + KeyAndValue.Value 
					+ " ELSE T." + KeyAndValue.Key + " END AS " + KeyAndValue.Key + ",");
			
			RegisterCacheFields = StrReplace(RegisterCacheFields,
				"T.Balanced" + KeyAndValue.Key + ",",
				"CASE WHEN &ScheduledJob THEN " + KeyAndValue.Value 
					+ " ELSE T.Balanced" + KeyAndValue.Key + " END AS Balanced" + KeyAndValue.Key + ",");
			
			FieldsOfMainRegisterTable = StrReplace(FieldsOfMainRegisterTable,
				"T." + KeyAndValue.Key + ",",
				"CASE WHEN &ScheduledJob THEN " + KeyAndValue.Value 
					+ " ELSE T." + KeyAndValue.Key + " END AS " + KeyAndValue.Key + ",");
			
			FieldsOfMainRegisterTable = StrReplace(FieldsOfMainRegisterTable,
				"T.Balanced" + KeyAndValue.Key + ",",
				"CASE WHEN &ScheduledJob THEN " + KeyAndValue.Value 
					+ " ELSE T.Balanced" + KeyAndValue.Key + " END AS Balanced" + KeyAndValue.Key + ",");
			
		EndDo;
		
		RegisterCacheFields 			= Left(RegisterCacheFields, StrLen(RegisterCacheFields) - 1);
		FieldsOfMainRegisterTable	= Left(FieldsOfMainRegisterTable, StrLen(FieldsOfMainRegisterTable) - 1);
		
	EndIf;
	
	ReplaceTrafficModeWithServiceMode(RegisterDescription, FieldsOfMainRegisterTable, "RecordType");
	
	Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldsOfMainRegisterTable);
	Query.Text = StrReplace(Query.Text, "&RegisterCacheFields", 			 RegisterCacheFields);
	Query.Text = StrReplace(Query.Text, "AND &RegisterIndexes",
		?(ValueIsFilled(RegisterDescription.RegisterIndexes), Chars.LF + "INDEX BY " + RegisterDescription.RegisterIndexes, ""));
	
	// We will set the selection by types of data conversion records.
	RegistersWithDataConversionRecords = New Structure;
	RegistersWithDataConversionRecords.Insert(Metadata.AccumulationRegisters.InventoryCost.Name);
	CalculationOfCostLocalization.AddRegistersWithDataConversionRecords(RegistersWithDataConversionRecords);
	If RegistersWithDataConversionRecords.Property(RegisterDescription.RegisterName) Then 
		Query.Text = StrReplace(Query.Text, "&SelectingServiceDataConversionRecords", "(NOT T.EntryType IN (&TypesOfDataConversionRecords))");
	Else
		Query.Text = StrReplace(Query.Text, "&SelectingServiceDataConversionRecords", "TRUE");
	EndIf;
	
	If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name Then
		If CalculationParameters.BatchCalculationStarted
		 And (CalculationParameters.BatchesInRevenueAreFilledIn Or CalculationParameters.FilledBatchesInRevenue) Then
			// Data from the IB is not selected - they are all in the cache
			Query.Text = StrReplace(Query.Text, "AND &SelectionByServiceDetails", "AND FALSE");
		EndIf;
		// Selection - primary movements
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False);
	ElsIf CalculationParameters.LotsAreFilledInAtCostPrice Or CalculationParameters.FilledBatchesAtCostPrice
	 Or RegisterDescription.RegisterName <> Metadata.AccumulationRegisters.InventoryCost.Name Then
		// Selection - primary movements (with unreadable recording types)
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False, False);
	Else
		// Selection - primary movements (all, including those with recalculated record types)
		ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False);
	EndIf;
	
	Query.Execute();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(
		CalculationParameters,
		True,
		TemporaryTableSize(CalculationParameters, RegisterDescription.NameOfCalculatedRegisterRevolutionsTable));
	
EndProcedure

// For registers whose balances are accessed in queries at the end of the period, we will create the following temporary tables:
// - Vtkashraschetnyeostatki<Register name> - it will contain the calculated sum of the final register balances
// , So at any stage of calculation there will be a ready-made table of calculated balances,
// which should be used instead of the virtual table of accumulation Register.<Register name>.Balances(<end of period>).
Procedure UpdateEstimatedRegisterBalances(CalculationParameters, RegisterDescription, Initialize = False) Export
	
	If Not CalculationParameters.RegistersWithCalculatedRevolutions.Property(RegisterDescription.RegisterName) Then
		// On a permanent basis, the cash settlement turnover is not needed, but to calculate the balances it is necessary to form it, and then destroy it.
		UpdateEstimatedRegisterRevolutions(CalculationParameters, RegisterDescription, True);
	EndIf;
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters,
		RegisterDescription.NameOfCalculatedRegisterBalancesTable, NStr("vi = 'Phụ trợ';
																		|ru = 'Вспомогательная';
																		|en = 'Auxiliary'; fa = 'کمکی';
																		|it = 'Ausiliaria';
																		|pl = 'Auxiliary';
																		|tr = 'Yardımcı'", Common.DefaultLanguageCode()));
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	// Let's form a template for the request text.
	If Not Initialize Then
		Query.Text =
		"DROP NameOfCalculatedRegisterBalancesTable
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
	EndIf;
	
	Query.Text = Query.Text +
	"SELECT
	|	&RegisterMeasurementsSubquery,
	|	&RegisterResourcesBalance
	|INTO TTIntermediateBalanceTable
	|FROM
	|	NameOfRemainderTable AS T
	|
	|UNION ALL
	|
	|SELECT
	|	&RegisterMeasurementsSubquery,
	|	&ResourcesAndTurnover
	|FROM
	|	NameOfCalculatedRegisterRevolutionsTable AS T
	|GROUP BY
	|	&RegisterDimensionsSubquery
	|INDEX BY
	|	&SubqueryIndexes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	&RegisterDimensions,
	|	&RegisterResourcesAmount
	|INTO NameOfCalculatedRegisterBalancesTable
	|FROM
	|	TTIntermediateBalanceTable AS T
	|GROUP BY
	|	&RegisterDimensions
	|
	|HAVING
	|	&SelectingNonEmptyResources
	|	AND &RegisterIndexes
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTIntermediateBalanceTable
	|";
	
	If Not CalculationParameters.RegistersWithCalculatedRevolutions.Property(RegisterDescription.RegisterName) Then
		Query.Text = Query.Text + "
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|DROP NameOfCalculatedRegisterRevolutionsTable
		|";
	EndIf;
	
	// Let's form the text for substitution into the template.
	RegisterDimensions = StrReplace(RegisterDescription.RegisterDimensions, "%1", "T.");
	RegisterMeasurementsSubquery = RegisterDimensions;
	RegisterDimensionsSubquery = RegisterMeasurementsSubquery;
	SubqueryIndexes = StrReplace(RegisterDescription.RegisterDimensions, "%1", "");
	
	RegisterResourcesAmount = StringFunctionsClientServer.SubstituteParametersToString(
		RegisterDescription.RegisterResourcesWithSuffix,
		"SUM(T.",
		")");
	RegisterResourcesBalance = StringFunctionsClientServer.SubstituteParametersToString(
		RegisterDescription.RegisterResourcesWithSuffix,
		"T.",
		"Balance");
	ResourcesAndTurnover = StringFunctionsClientServer.SubstituteParametersToString(
		RegisterDescription.RegisterResourcesWithSuffix,
		"SUM(CASE WHEN T.OfficialTypeOfMovementParish THEN 1 ELSE -1 END * T.",
		")");
	
	// We will form a selection based on non-empty register resources.
	TextSelectionOfNonEmptyResources = "";
	ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(RegisterDescription.RegisterResources, "%1", "T."),
		",",
		True,
		True);
	
	For Each CurrentField In ArrayOfResources Do
		
		TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
			+ ?(TextSelectionOfNonEmptyResources = "", "", "
			|	OR ") + "SUM(" + CurrentField + ") <> 0";
		
	EndDo;
	
	// To calculate the average cost (excluding batches), we will clear the batch fields of the calculation cache.
	If ItIsNecessaryToClearFieldsFromCalculatedCache(CalculationParameters, RegisterDescription) Then
		
		ReplaceableFragments = New Structure;
		ReplaceableFragments.Insert("Lot",					  "UNDEFINED");
		ReplaceableFragments.Insert("LotVendorAttributes",	  "VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)");
		ReplaceableFragments.Insert("FinancialAccountingDimension", "UNDEFINED");
		ReplaceableFragments.Insert("VATActivityType",		  "VALUE(Enum.VATTaxationTypes.EmptyRef)");
		
		RegisterMeasurementsSubquery = RegisterMeasurementsSubquery + ",";
		RegisterDimensionsSubquery = RegisterDimensionsSubquery + ",";
		
		For Each KeyAndValue In ReplaceableFragments Do
			
			RegisterMeasurementsSubquery = StrReplace(RegisterMeasurementsSubquery,
				"T." + KeyAndValue.Key + ",",
				"CASE WHEN &ScheduledJob THEN " + KeyAndValue.Value 
					+ " ELSE T." + KeyAndValue.Key + " END AS " + KeyAndValue.Key + ",");
			
			RegisterDimensionsSubquery = StrReplace(RegisterDimensionsSubquery,
				"T." + KeyAndValue.Key + ",",
				"CASE WHEN &ScheduledJob THEN " + KeyAndValue.Value 
					+ " ELSE T." + KeyAndValue.Key + " END,");
			
		EndDo;
		
		RegisterMeasurementsSubquery = Left(RegisterMeasurementsSubquery, StrLen(RegisterMeasurementsSubquery) - 1);
		RegisterDimensionsSubquery = Left(RegisterDimensionsSubquery, StrLen(RegisterDimensionsSubquery) - 1);
		
	EndIf;
	
	// We will form a selection by organization.
	If RegisterDescription.ThereIsACompany Then
		FilterByCompanyBalance = "Organization IN (&CompanyArray)";
	ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
		FilterByCompanyBalance = "AccountingDimensionByPartners IN (SELECT Filter.DimensionKey FROM TTPartnerAnalyticsSelection AS Filter)";
	Else
		FilterByCompanyBalance = "";
	EndIf;
	
	// Substitute the texts in the request template.
	Query.Text = StrReplace(Query.Text, "NameOfRemainderTable",
		"NameOfMainRegisterTable.Balance(&BorderStartOfPeriod, &FilterByCompanyBalance)");
	
	Query.Text = StrReplace(Query.Text, "&RegisterMeasurementsSubquery", RegisterMeasurementsSubquery);
	Query.Text = StrReplace(Query.Text, "&RegisterDimensionsSubquery", RegisterDimensionsSubquery);
	Query.Text = StrReplace(Query.Text, "&SubqueryIndexes", 			SubqueryIndexes);
	Query.Text = StrReplace(Query.Text, "&RegisterDimensions", 			RegisterDimensions);
	Query.Text = StrReplace(Query.Text, "&RegisterResourcesAmount", 		RegisterResourcesAmount);
	Query.Text = StrReplace(Query.Text, "&RegisterResourcesBalance", 	RegisterResourcesBalance);
	Query.Text = StrReplace(Query.Text, "&ResourcesAndTurnover", 	ResourcesAndTurnover);
	Query.Text = StrReplace(Query.Text, "&FilterByCompanyBalance", 	FilterByCompanyBalance);
	Query.Text = StrReplace(Query.Text, "&SelectingNonEmptyResources", 		TextSelectionOfNonEmptyResources);
	Query.Text = StrReplace(Query.Text, "AND &RegisterIndexes",
		?(ValueIsFilled(RegisterDescription.RegisterIndexes), Chars.LF + "INDEX BY " + RegisterDescription.RegisterIndexes, ""));
	
	ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query);
	
	// Let's form a table of the remainder cache.
	Query.Execute();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(
		CalculationParameters,
		True,
		TemporaryTableSize(CalculationParameters, RegisterDescription.NameOfCalculatedRegisterBalancesTable));
	
	
EndProcedure

// Performs (if necessary) updating of calculated turns and balances for all registers.
//
Procedure UpdateCalculatedRegisterCaches_(CalculationParameters, OnlyRequiringUpdates = False) Export
	
	For Each KeyAndValue In CalculationParameters.RegisterRecords Do
		
		RegisterDescription = KeyAndValue.Value;
		
		If Not RegisterDescription.ItIsNecessaryToUpdateCalculatedCache And OnlyRequiringUpdates Then
			Continue;
		EndIf;
		
		UpdateCalculatedRegisterCaches(CalculationParameters, RegisterDescription.RegisterName);
		
	EndDo;
	
EndProcedure

// Performs (of course) updating of calculated revolutions and balances of the specified register.
//
Procedure UpdateCalculatedRegisterCaches(CalculationParameters, RegisterName) Export
	
	RegisterDescription = CalculationParameters.RegisterRecords[RegisterName];
	
	If CalculationParameters.RegistersWithCalculatedRevolutions.Property(RegisterDescription.RegisterName) Then
		UpdateEstimatedRegisterRevolutions(CalculationParameters, RegisterDescription);
	EndIf;
	
	If CalculationParameters.RegistersWithCalculatedBalances.Property(RegisterDescription.RegisterName) Then
		UpdateEstimatedRegisterBalances(CalculationParameters, RegisterDescription);
	EndIf;
	
	RegisterDescription.ItIsNecessaryToUpdateCalculatedCache = False;
	
EndProcedure

// Determines whether to generate calculation caches with empty batch fields (for calculating the average cost price).
//
Function ItIsNecessaryToClearFieldsFromCalculatedCache(CalculationParameters, RegisterDescription)
	
	Return CalculationParameters.BatchAccountingVersion22 And Not CalculationParameters.PartiesAreBeingCalculated And CalculationParameters.ScheduledJob
			And (RegisterDescription.RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name
				Or RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name);
	
EndFunction

#EndRegion

#Region CachingRegisterData

// Adds the FIN IDs to the temporary table. records based on the identifiers already available in the Registered Records.
//
Procedure AddIDsToTemporaryTable(CalculationParameters, RegisterDescription, TempTableName,
			IndexingFields = "", MatchingRegisterColumns = Undefined) Export
	
	TTSpeakers = TemporaryTableColumns(CalculationParameters, TempTableName, False);
	IDColumnName = "FinRecordID";
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	If Not ValueIsFilled(MatchingRegisterColumns) Then
		MatchingRegisterColumns = New Structure;
	EndIf;
	
	MatchingTTColumns = New Structure; // swap the Key and the value from the collation of the Column register
	For Each KeyAndValue In MatchingRegisterColumns Do
		MatchingTTColumns.Insert(KeyAndValue.Value, KeyAndValue.Key);
	EndDo;
	
	Query.Text =
	"SELECT DISTINCT
	|	T.Recorder AS Recorder
	|INTO TemporaryTableName_Registrars
	|FROM
	|	TempTableName AS T
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.Recorder AS Recorder,
	|	&SelectionFields1,
	|	MAX(T.FinRecordID) AS FinRecordID
	|INTO TTOldRegisterIdentifiers
	|FROM
	|	NameOfMainRegisterTable AS T
	|	INNER JOIN TemporaryTableName_Registrars AS Filter
	|		ON T.Recorder = Filter.Recorder
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND &FilterByCompany
	|	AND T.Active
	|GROUP BY
	|	T.Recorder,
	|	&GroupFields
	|INDEX BY
	|	Recorder
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TemporaryTableName_Registrars
	|";
	
	FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(RegisterDescription.FieldsOfMainRegisterTable, "%1", ""),
		",",
		True,
		True);
	ArrayOfSumFields = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		Lower(StrReplace(RegisterDescription.SelectionFieldsOfNonemptyMotions, "%1", "")),
		",",
		True,
		True);
	
	SelectionFieldText = "";
	TextOfDimensionField = "";
	
	If RegisterDescription.ThereIsACompany Then
		FilterByCompany = "T.Organization IN (&CompanyArray)";
	ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
		FilterByCompany = "T.AccountingDimensionByPartners IN (SELECT Filter.DimensionKey FROM TTPartnerAnalyticsSelection AS Filter)";
	Else
		FilterByCompany = "TRUE";
	EndIf;
	
	DestinationTable1 = RegisterDescription.Table; //ValueTable
	
	For Each CurrentField In FieldArray Do
		
		If Lower(CurrentField) = Lower(IDColumnName)
		 Or ArrayOfSumFields.Find(Lower(CurrentField)) <> Undefined
		 Or (TTSpeakers.Find(CurrentField) = Undefined
		 	 And Not MatchingRegisterColumns.Property(CurrentField)) Then
			Continue;
		EndIf;
		
		If Lower(CurrentField) <> Lower("Recorder") Then
			SelectionFieldText = SelectionFieldText + ?(SelectionFieldText = "", "", ",
				|	") + "T." + CurrentField + " AS " + CurrentField;
			TextOfDimensionField = TextOfDimensionField + ?(TextOfDimensionField = "", "", ",
				|	") + "T." + CurrentField;
		EndIf;
		
	EndDo;
	
	Query.Text = StrReplace(Query.Text, "&SelectionFields1", SelectionFieldText);
	Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", RegisterDescription.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "TempTableName", TempTableName);
	Query.Text = StrReplace(Query.Text, "&FilterByCompany", FilterByCompany);
	Query.Text = StrReplace(Query.Text, "&GroupFields", TextOfDimensionField);
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
	
	Query.Text =
	"SELECT
	|	RECORDAUTONUMBER() AS RecNo,
	|	&SelectionFields1,
	|	&SummaryFields,
	|	MAX(T.FinRecordID) AS FinRecordID
	|INTO TemporaryTableName_Numbered
	|FROM
	|(SELECT
	|	TRUE AS NewRecord,
	|	&SelectionFieldsW,
	|	&CostFields,
	|   """" AS FinRecordID
	|FROM
	|	TempTableName AS T
	|	
	|UNION ALL
	|
	|SELECT
	|	FALSE AS NewRecord,
	|	&RegisterSelectionFields,
	|	&ZeroCostFields,
	|   T.FinRecordID
	|FROM
	|	TTOldRegisterIdentifiers AS T) AS T
	|
	|GROUP BY
	|	&GroupFields
	|HAVING
	|	MAX(T.NewRecord) = TRUE
	|INDEX BY
	|	RecNo
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.RecNo
	|FROM
	|	TemporaryTableName_Numbered AS T
	|WHERE
	|	T.FinRecordID = """"
	|";
	
	SelectionFieldText = "";
	TextOfSelectionFieldW = "";
	TextOfRegisterSelectionField = "";
	TextOfDimensionField = "";
	TextOfCostField = "";
	TextZeroCostFields = "";
	TextOfTotalsField = "";
	TextAllSelectionFields = "";
	
	RegisterColumns = TemporaryTableColumns(CalculationParameters, "TTOldRegisterIdentifiers", False);
	
	For Each CurrentColumn In TTSpeakers Do
		
		If Lower(CurrentColumn.Name) = Lower(IDColumnName) Then
			Continue;
		EndIf;
		
		TextAllSelectionFields = TextAllSelectionFields + ?(TextAllSelectionFields = "", "", ",
			|	") + "T." + CurrentColumn.Name + " AS " + CurrentColumn.Name;
		
		FieldType = CostCalculationUniversalAlgorithms.NonNullTypeDescriptions(CurrentColumn.ValueType);
		
		ThisIsNumericField = ArrayOfSumFields.Find(Lower(CurrentColumn.Name)) <> Undefined
		 Or (FieldType.Types().Count() = 1 And FieldType.ContainsType(Type("Number")));
		 
		If RegisterColumns.Find(CurrentColumn.Name) = Undefined
		 And Not MatchingTTColumns.Property(CurrentColumn.Name)
		 And Not ThisIsNumericField Then
			
			TextOfSelectionFieldW = TextOfSelectionFieldW + ?(TextOfSelectionFieldW = "", "", ",
				|	") + "T." + CurrentColumn.Name;
			TextOfRegisterSelectionField = TextOfRegisterSelectionField + ?(TextOfRegisterSelectionField = "", "", ",
				|	") + CostCalculationUniversalAlgorithms.PresentationOfEmptyTypeValueForQuery(CurrentColumn.ValueType);
			TextOfTotalsField = TextOfTotalsField + ?(TextOfTotalsField = "", "", ",
				|	") + "MAX(T." + CurrentColumn.Name + ") AS " + CurrentColumn.Name;
			
		ElsIf ThisIsNumericField Then
			
			TextOfCostField = TextOfCostField + ?(TextOfCostField = "", "", ",
				|	") + "T." + CurrentColumn.Name + " AS " + CurrentColumn.Name;
			TextZeroCostFields = TextZeroCostFields + ?(TextZeroCostFields = "", "", ",
				|	") + "0 AS " + CurrentColumn.Name;
			TextOfTotalsField = TextOfTotalsField + ?(TextOfTotalsField = "", "", ",
				|	") + "SUM(T." + CurrentColumn.Name + ") AS " + CurrentColumn.Name;
			
		Else
			
			SelectionFieldText = SelectionFieldText + ?(SelectionFieldText = "", "", ",
				|	") + "T." + CurrentColumn.Name;
			TextOfDimensionField = TextOfDimensionField + ?(TextOfDimensionField = "", "", ",
				|	") + "T." + CurrentColumn.Name;
			TextOfSelectionFieldW = TextOfSelectionFieldW + ?(TextOfSelectionFieldW = "", "", ",
				|	") + "T." + CurrentColumn.Name;
			
			If MatchingTTColumns.Property(CurrentColumn.Name) Then
				TextOfRegisterSelectionField = TextOfRegisterSelectionField + ?(TextOfRegisterSelectionField = "", "", ",
					|	") + "T." + MatchingTTColumns[CurrentColumn.Name];
			Else
				TextOfRegisterSelectionField = TextOfRegisterSelectionField + ?(TextOfRegisterSelectionField = "", "", ",
					|	") + "T." + CurrentColumn.Name;
			EndIf;
			
		EndIf;
		
	EndDo;
	
	Query.Text = StrReplace(Query.Text, "&SelectionFieldsW", 			TextOfSelectionFieldW);
	Query.Text = StrReplace(Query.Text, "&RegisterSelectionFields",	TextOfRegisterSelectionField);
	Query.Text = StrReplace(Query.Text, "&SelectionFields1", 			SelectionFieldText);
	Query.Text = StrReplace(Query.Text, "&CostFields", 			TextOfCostField);
	Query.Text = StrReplace(Query.Text, "&ZeroCostFields", 	TextZeroCostFields);
	Query.Text = StrReplace(Query.Text, "&SummaryFields", 			TextOfTotalsField);
	Query.Text = StrReplace(Query.Text, "&GroupFields", 		TextOfDimensionField);
	Query.Text = StrReplace(Query.Text, "TempTableName", 	TempTableName);
	
	IDsTable = New ValueTable;
	IDsTable.Columns.Add("Id", Common.StringTypeDetails(36));
	IDsTable.Columns.Add("RecNo", Common.TypeDescriptionNumber(31));
	
	Selection = CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True);
	
	While Selection.Next() Do
		NewRow = IDsTable.Add();
		NewRow.Id = New UUID;
		NewRow.RecNo = Selection.RecNo;
	EndDo;
	
	Query.SetParameter("IDsTable", IDsTable);
	
	DestroyTemporaryTables(CalculationParameters, "TTOldRegisterIdentifiers, " + TempTableName);
	
	Query.Text =
	"SELECT
	|	IDsTable.Id AS Id,
	|	IDsTable.RecNo AS RecNo
	|INTO IDsTable
	|FROM
	|	&IDsTable AS IDsTable
	|INDEX BY
	|	RecNo
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	&SelectionFields1,
	|	ISNULL(IDsTable.Id, T.FinRecordID) AS FinRecordID
	|INTO TempTableName
	|FROM
	|	TemporaryTableName_Numbered AS T
	|	LEFT JOIN IDsTable AS IDsTable
	|		ON IDsTable.RecNo = T.RecNo
	|";
	
	Query.Text = StrReplace(Query.Text, "&SelectionFields1", TextAllSelectionFields);
	Query.Text = StrReplace(Query.Text, "TempTableName", TempTableName);
	
	If ValueIsFilled(IndexingFields) Then
		Query.Text = Query.Text + "
			|INDEX BY
			|	" + IndexingFields;
	EndIf;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
	
	DestroyTemporaryTables(CalculationParameters, "IDsTable, " + TempTableName + "_Numbered");
	
EndProcedure

// Fills in the temporary table with the FIN IDs. records with new values.
//
Procedure FillInIdsInTemporaryTable(CalculationParameters, TempTableName, NewTemporaryTableName, NameOfRowNumberColumn) Export
	
	TTSpeakers = TemporaryTableColumns(CalculationParameters, TempTableName);
	TTSpeakers = StrReplace(TTSpeakers, "%1", "T.");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	T.NameOfRowNumberColumn AS RecNo
	|FROM
	|	TempTableName AS T";
	
	Query.Text = StrReplace(Query.Text, "NameOfRowNumberColumn", NameOfRowNumberColumn);
	Query.Text = StrReplace(Query.Text, "TempTableName",    TempTableName);
	
	Selection = Query.Execute().Select();
	
	IDsTable = New ValueTable;
	IDsTable.Columns.Add("Id", Common.StringTypeDetails(36));
	IDsTable.Columns.Add("RecNo", Common.TypeDescriptionNumber(31));
	
	While Selection.Next() Do
		NewRow = IDsTable.Add();
		NewRow.Id = New UUID;
		NewRow.RecNo = Selection.RecNo;
	EndDo;
	
	PutTableOfValuesInTemporaryTable(
		CalculationParameters,
		"TableOfNewIdentifiers",
		IDsTable,
		"%1Id, %1RecNo",
		"RecNo");
		
	Query.Text =
	"SELECT
	|	&TableFields,
	|	IDs.Id AS FinRecordID
	|INTO NewTemporaryTableName
	|FROM
	|	TempTableName AS T
	|	INNER JOIN TableOfNewIdentifiers AS IDs
	|		ON T.NameOfRowNumberColumn = IDs.RecNo
	|";
	
	Query.Text = StrReplace(Query.Text, "&TableFields", 	 		 TTSpeakers);
	Query.Text = StrReplace(Query.Text, "NameOfRowNumberColumn", 	 NameOfRowNumberColumn);
	Query.Text = StrReplace(Query.Text, "NewTemporaryTableName", NewTemporaryTableName);
	Query.Text = StrReplace(Query.Text, "TempTableName", 	 TempTableName);
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	DestroyTemporaryTables(CalculationParameters, "TableOfNewIdentifiers");
	
EndProcedure

