// Processes run-time calculation errors-writes the calculation Protocol and completes the calculation.
//
// Returns:
//	Boolean -
//
Function HandleCallExceptionCalculateAll(CalculationParameters, ErrorInfo, Cancel) Export
	
	ErrorText = DetailErrorDescription(ErrorInfo);
	
	If StrFind(ErrorText, ServiceSymbol_CalculationInterruptedForDebugging()) > 0 Then
		Return True;
	EndIf;
	
	Cancel = True;
	
	// We will restore the selection for all organizations, because when calculating the cost price, it was replaced when calculating for groups of organizations.
	If Not CalculationParameters.PartiesAreBeingCalculated And CalculationParameters.Property("CopyArrayOfOrganizations") Then
		CalculationParameters.Insert("CompanyArray",
			Common.CopyRecursive(CalculationParameters.CopyArrayOfOrganizations));
	EndIf;
	
	// Let's write the information in the registration log.
	ProtocolText_ = StrReplace(ErrorText, 	   TrimAll(ServiceSymbol_TextToLogProblem()), "");
	ProtocolText_ = StrReplace(ProtocolText_, TrimAll(ServiceSymbol_ProblemAlreadyRegistered()), "");
	
	ProtocolText_ = CostCalculationProtocol.ErrorTextPresentation(ProtocolText_);
	
	WriteLogEvent(
		NameOfErrorEventForLog(CalculationParameters),
		EventLogLevel.Error,,,
		ProtocolText_);
	
	// We will record the information in the calculation protocol.
	ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Khi thực hiện tính toán đã xảy ra lỗi:
			|%1';
			|ru = 'При выполнении расчета возникла ошибка:
			|%1';
			|en = 'An error occurred while calculating:
			|%1'; fa = 'An error occurred while calculating:
			|%1';
			|it = 'Si è verificato un errore durante l''esecuzione del calcolo:
			|%1';
			|pl = 'Podczas wykonywania obliczeń wystąpił błąd:
			|%1';
			|tr = 'Hesaplama sırasında hata oluştu:
			|%1'", Common.DefaultLanguageCode()),
		ErrorText);
	
	ProtocolText_ = StrReplace(ProtocolText_, TrimAll(ServiceSymbol_TextToLogProblem()), "");
	ProtocolText_ = StrReplace(ProtocolText_, TrimAll(ServiceSymbol_ProblemAlreadyRegistered()), "");
	
	If CostCalculationProtocol.CalculationProtocolIsMaintained(CalculationParameters)
	 And Not ExceptionIsCausedProgrammatically(ErrorText) Then
	 
		// If the exception is caused programmatically, then information about the error at the place of its occurrence should already be added to the protocol.
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
			ProtocolText_);
		
	EndIf;
	
	// We will record the information in the month closing mechanism.
	StartOfProtocolText 	= StrFind(ErrorText, ServiceSymbol_TextToLogProblem(),,, 1);
	EndOfProtocolText  	= StrFind(ErrorText, ServiceSymbol_TextToLogProblem(),,, 2);
	ProblemIsAlreadyRegistered = (StrFind(ErrorText, TrimAll(ServiceSymbol_ProblemAlreadyRegistered())) > 0);
	
	If Not ProblemIsAlreadyRegistered And StartOfProtocolText > 0 And EndOfProtocolText > 0 Then // the description contains the text for registering the problem
		
		CharacterLength = StrLen(ServiceSymbol_TextToLogProblem());
		ProtocolText_ = TrimAll(Mid(ErrorText, StartOfProtocolText + CharacterLength, EndOfProtocolText - StartOfProtocolText - CharacterLength));
		
	ElsIf Not ExceptionIsCausedProgrammatically(ErrorText) // an "honest" fall
	 Or Not ProblemIsAlreadyRegistered Then // transmitting an "honest" fall from nested attempts is an exception
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Khi thực hiện tính toán, đã chẩn đoán được lỗi:
				|%1';
				|ru = 'При выполнении расчета диагностирована ошибка:
				|%1';
				|en = 'An error was found while calculating:
				|%1'; fa = 'An error was found while calculating:
				|%1';
				|it = 'Durante l''esecuzione del calcolo è stato diagnosticato un errore:
				|%1';
				|pl = 'Podczas wykonywania obliczeń wykryto błąd:
				|%1';
				|tr = 'Hesaplama sırasında hata tespit edildi:
				|%1'", Common.DefaultLanguageCode()),
			ErrorText);
	Else
		// The problem is already registered at the place of the exception call
		ProtocolText_ = "";
	EndIf;
	
	If ValueIsFilled(ProtocolText_) Then
		RegisterCalculationExecutionProblem(
			CalculationParameters,
			,
			,
			ProtocolText_);
	EndIf;
	
	CalculationEnd(CalculationParameters); // let's write down the protocol
	
	ErrorText = ErrorText + ServiceSymbol_ProblemAlreadyRegistered();
	
	Raise ErrorText;
	
EndFunction

Function ExceptionIsCausedProgrammatically(ErrorText) Export
	
	Return StrFind(Lower(ErrorText), Lower("Raise")) > 0
	   Or StrFind(Lower(ErrorText), Lower("Raise")) > 0;
	
EndFunction

Function TextExceptionToLogProblem(ErrorText) Export
	Return ServiceSymbol_TextToLogProblem() + ErrorText + ServiceSymbol_TextToLogProblem();
EndFunction

Function ServiceSymbol_TextToLogProblem() Export
	Return Chars.LF + "#LongDesc" + Chars.LF;
EndFunction

Function ServiceSymbol_ProblemAlreadyRegistered() Export
	Return MonthEndTransactionsServer.ServiceSymbol_ExceptionHasAlreadyBeenWorkedOutInCalculationStage()
EndFunction

Function ErrorTextForIncorrectCompletionOfCostCalculation() Export
	Return ServiceSymbol_ProblemAlreadyRegistered()
		+ NStr("vi = 'Khi tính toán giá vốn, đã xảy ra lỗi. Xem chi tiết trong Nhật ký sự kiện.';
				|ru = 'При расчете себестоимости возникла ошибка. Подробности см. в Журнале регистрации.';
				|en = 'An error occurred while calculating the cost. See details in the event log.'; fa = 'An error occurred while calculating the cost. See details in the event log.';
				|it = 'Si è verificato un errore durante il calcolo del costo di produzione. Vedasi il registro per i dettagli.';
				|pl = 'Wystąpił błąd podczas obliczania kosztu własnego. Szczegóły patrz w Katalogu rejestracji.';
				|tr = 'Maliyet hesaplanmasında hata oluştu. Ayrıntılar için Kayıt defterine bak.'", Common.DefaultLanguageCode());
EndFunction

