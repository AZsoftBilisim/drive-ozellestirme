Procedure CheckingBalancesInWorkInProgress(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	QueryTexts = New Array;
	QueryTexts.Add(QueryTextCompletedBatches());
	QueryTexts.Add(
	"SELECT
	|	T.Organization									AS Organization,
	|	T.AccountingSection									AS AccountingSection,
	|	T.ItemsLocationAttributes					AS ItemsLocationAttributes,
	|	T.Lot										AS Lot,
	|	T.FinancialAccountingDimension						AS FinancialAccountingDimension,
	|	T.CountBalance								AS Count,
	|	T.CostBalance
	|			+ T.AddExpensesForGoodsBalance
	|			+ T.LaborCostsBalance
	|			+ T.ItemizedFixedCostsIncludingVATBalance
	|			+ T.ItemizedVariableCostsIncludingVATBalance	AS FullValue,
	|	T.CostExcludingVATBalance
	|			+ T.AdditionalExpensesExcludingVATBalance
	|			+ T.LaborCostsBalance
	|			+ T.ItemizedFixedCostsExcludingVATBalance
	|			+ T.ItemizedVariableCostsExcludingVATBalance	AS FullValueExcludingVAT,
	|	T.LocalCostBalance
	|			+ T.AddExpensesLocalBalance
	|			+ T.LaborCostsLocalBalance
	|			+ T.ItemizedFixedCostsComplBalance
	|			+ T.ItemizedVariableCostsComplBalance	AS FullLocalCost,
	|	T.PermanentDifferenceBalance						AS PermanentDifference,
	|	T.CostTDBalance						AS CostTD,
	|	T.CostOfPersonalIncomeTaxBalance							AS CostOfPersonalIncomeTax,
	|	T.CostManBalance
	|			+ T.AddExpensesManBalance
	|			+ T.LaborCostsManBalance
	|			+ T.ItemizedFixedCostsManagBalance
	|			+ T.ItemizedVariableCostsManagBalance		AS FullCostOfMan
	|INTO MaterialCostBalances
	|FROM
	|	AccumulationRegister.InventoryCost.Balance(
	|			&BorderEndOfPeriod,
	|			Organization IN (&CompanyArray)
	|			AND Lot IN (SELECT T.Lot FROM CompletedBatches AS T)
	|			) AS T
	|;
