#Region WorkingWithGraphs

// The result of the function is a temporary table with the columns "Source node number", 
// "Receiver node number", and "Key of the initial data", which stores all 
// the graph traversal paths from the temporary table of the datastable_name for the values whose initial 
// state is set in the temporary table of the datastable_name
// 
// Parameters:
// 	TempTablesManager						- TempTablesManager - temporary table Manager
// 	GraphParameters - Structure
// 		Data table-Structure with keys-description of a table with a set of matching data to be routed, and the initial nodes of the graph 
// 			Table Name-Row-name of the temporary table
// 			Column_name of a node-A string is the name of a column in the table of general data containing the ID of the starting node of the routing graph
// 			Data column_name-Row-name of a column in the datatheet containing the ID of the data row in the datatheet tablesource
// 		datatheetsreferences - Structure with keys - Description of the table with information about the arcs of the routing graph 
// 			Table Name-Row-name of the temporary table 
// 			Source node columnName-String - the name of the column in the Source data table containing the source node ID
// 			Receiver node columnName-String - the name of the column in the data table containing the ID of the receiver node
// 		Tablesresultname					- Row - name of the resulting temporary table
// 	
// Returns:
// 		Number -	number of completed iterations
// 	)
// 
Function RoutingDataByGraph(TempTablesManager, GraphParameters = Undefined) Export
	
	If GraphParameters = Undefined Then
		GraphParameters = New Structure();
	EndIf;

	Query = New Query;

	Query.TempTablesManager = TempTablesManager;
	
	RedefineTND = GraphParameters.Property("InitialDataTable");
	RedefineIDS = GraphParameters.Property("RelationshipDataSourceTable");
	RedefineTR = GraphParameters.Property("NameOfResultTable");
	
	IterationNumber = 0;
	ResultTableIterator = "TT_" + Format(IterationNumber, "NZ=0; NG=");
	
	
	QueryText = 
	"SELECT DISTINCT
	|	0								AS IterationNumber,
	|	-1								AS SourceNodeNumber_,
	|	T.NodeNumber						AS ReceiverNodeNumber_,
	|	T.DataKey					AS DataKey
	|INTO TT_0
	|FROM
	|	InitialDataTable AS T;
	|";
	
	If (RedefineTND) Then
		QueryText = StrReplace(QueryText, "InitialDataTable", GraphParameters.InitialDataTable.TableName);
		QueryText = StrReplace(QueryText, "T.NodeNumber", StrTemplate("T.%1",GraphParameters.InitialDataTable.NameOfNodeNumberColumn));
		QueryText = StrReplace(QueryText, "T.DataKey", StrTemplate("T.%1",GraphParameters.InitialDataTable.NameOfDataKeyColumn));
	EndIf;
	
	Query.Text = QueryText;
	Query.Execute();
	
	ReceivedDataOnPreviousIteration = 0;
	ReceivedDataOnCurIteration = TemporaryTableSize(Query, ResultTableIterator);
	
	ContinueTraversingGraph = (ReceivedDataOnCurIteration > ReceivedDataOnPreviousIteration);

	QueryText = 
	"////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	T.IterationNumber					AS IterationNumber,
	|	T.SourceNodeNumber_			AS SourceNodeNumber_,
	|	T.ReceiverNodeNumber_			AS ReceiverNodeNumber_,
	|	T.DataKey					AS DataKey
	|INTO TT_1
	|FROM
	|	TT_0 AS T
	|
	|UNION
	|
	|SELECT DISTINCT
	|	&IterationNumber,
	|	D.SourceNodeNumber_,
	|	D.ReceiverNodeNumber_,
	|	T.DataKey
	|FROM
	|	TT_0 AS T
	|		INNER JOIN RelationDataSource AS D
	|		ON T.ReceiverNodeNumber_ = D.SourceNodeNumber_
	|		LEFT JOIN TT_0 AS TT__
	|			ON D.SourceNodeNumber_ = TT__.SourceNodeNumber_
	|			AND D.ReceiverNodeNumber_ = TT__.ReceiverNodeNumber_
	|			AND T.DataKey = TT__.DataKey
	|WHERE
	|	T.IterationNumber = &IterationNumber-1
	|	AND TT__.IterationNumber IS NULL
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TT_0;
	|";
	
	If (RedefineIDS) Then
		QueryText = StrReplace(QueryText, "RelationDataSource", GraphParameters.RelationshipDataSourceTable.TableName);
		QueryText = StrReplace(QueryText, "D.SourceNodeNumber_", StrTemplate("D.%1",GraphParameters.RelationshipDataSourceTable.ColumnNameOfSourceNodeNumber));
		QueryText = StrReplace(QueryText, "D.ReceiverNodeNumber_", StrTemplate("D.%1",GraphParameters.RelationshipDataSourceTable.ColumnNameOfReceiverNodeNumber));
	EndIf;
	
	While ContinueTraversingGraph Do
		
		IteratorOfResultTablePrevious = ResultTableIterator;
		IterationNumber = IterationNumber + 1;
		ResultTableIterator = "TT_" + Format(IterationNumber, "NZ=0; NG=");
		
		Query.SetParameter("IterationNumber", IterationNumber);
		Query.Text = StrReplace(QueryText, "TT_1", ResultTableIterator);
		Query.Text = StrReplace(Query.Text, "TT_0", IteratorOfResultTablePrevious);
		
		Query.Execute();
		
		ReceivedDataOnPreviousIteration = ReceivedDataOnCurIteration;
		ReceivedDataOnCurIteration = TemporaryTableSize(Query, ResultTableIterator);
		
		ContinueTraversingGraph = (ReceivedDataOnCurIteration > ReceivedDataOnPreviousIteration);
		
	EndDo;
	
	Query.Text = 
	"////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	T.IterationNumber					AS IterationNumber,
	|	T.SourceNodeNumber_			AS SourceNodeNumber_,
	|	T.ReceiverNodeNumber_			AS ReceiverNodeNumber_,
	|	T.DataKey					AS DataKey
	|INTO ResultTable2
	|FROM
	|	TT_1 AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TT_1";
	
	Query.Text = StrReplace(Query.Text, "TT_1", ResultTableIterator);
	If (RedefineTR) Then
		Query.Text = StrReplace(Query.Text, "ResultTable2", GraphParameters.NameOfResultTable);
	EndIf;
	Query.Execute();
	 
	Return IterationNumber-1;

EndFunction

