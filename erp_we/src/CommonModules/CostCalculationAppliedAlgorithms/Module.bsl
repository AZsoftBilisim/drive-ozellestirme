// Returns an array of organizations on which there is a release for a specified period,
// but the method of valuation differs from the "first in, first out (sliding)".
//
// Parameters:
//	BeginOfPeriod - Date - the beginning of the period for Registering Recorded.
//	EndOfPeriod - Date - the end of the period for the receipt of motions.
//	SettingsComposer - DataCompositionSettingsComposer - The DCS settings Composer
//		that is expected to have an organization selection element in its selection.
//	CompanyFieldName1 - String - Optional parameter, specifies the name of the organization selection element
//	CompanyArray - Array of CatalogRef.Companies - if the array is transferred and filled in by organizations,
//		the analysis of the presence of GP/PF extracts is performed only for them.
//
Function OrganizationsWithProductsWithoutFIFOSliding(BeginOfPeriod, EndOfPeriod, 
	SettingsComposer, CompanyFieldName1, Val CompanyArray)
	
	If CompanyArray = Undefined Then
		// In this condition, there is no need to check the array for an empty amount! If the report returns an empty result,
		// then the array will be empty. If the report does not have a selection by organizations,
		// then all organizations in the database will be checked and the user may receive a message about accounting by average, in any organization,
		// the user may get the false impression that the report is empty because of this error.
		CompanyArray = OrganizationsToSelectFromReportSettings(SettingsComposer, CompanyFieldName1);
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager;
	
	AccountingPoliciesTaxSettings.SupplementTemporaryTableManagerWithCurrentParametersForAccountingPolicies(
		Metadata.InformationRegisters.FinancialAccountingPolicy.Name,
		Query.TempTablesManager,
		BeginOfPeriod,
		"TTAccountingPolicyOfFinancialAccounting");
	
	Query.Text =
	"SELECT DISTINCT
	|	ProductsRelease.Organization AS Ref
	|INTO TTCompaniesWithRegisteredRecords
	|FROM
	|	AccumulationRegister.ProductsRelease.Turnovers(&BeginOfPeriod, &EndOfPeriod, , Organization IN (&CompanyArray)) AS ProductsRelease
	|
	|INDEX BY
	|	Ref
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Ref AS Ref
	|FROM
	|	Catalog.Companies AS T
	|	INNER JOIN TTCompaniesWithRegisteredRecords AS OrganizationsWithRegisteredRecords
	|		ON T.Ref = OrganizationsWithRegisteredRecords.Ref
	|	INNER JOIN TTAccountingPolicyOfFinancialAccounting AS AccountingPoliciesOfOrganizations_
	|		ON T.Ref = AccountingPoliciesOfOrganizations_.Organization
	|WHERE
	|	AccountingPoliciesOfOrganizations_.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.FIFORollingValuation)
	|	AND AccountingPoliciesOfOrganizations_.InventoryValuationMethod <> VALUE(Enum.InventoryValuationMethods.EmptyRef)
	|
	|ORDER BY
	|	Ref
	|AUTOORDER";

	Query.SetParameter("BeginOfPeriod", BeginOfPeriod);
	Query.SetParameter("EndOfPeriod",  EndOfPeriod);
	Query.SetParameter("CompanyArray", CompanyArray);
	
	SetPrivilegedMode(True);
	ArrayOfExcludedOrganizations_ = Query.Execute().Unload().UnloadColumn("Ref");
	
	Return ArrayOfExcludedOrganizations_;
	
EndFunction

