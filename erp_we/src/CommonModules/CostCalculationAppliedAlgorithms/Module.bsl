Procedure CalculateBatchesInBackground(CalculationID) Export
	
	SetPrivilegedMode(True);
	
	// We will get the calculation parameters.
	CalculationParameters = ReadBatchCalculationDataCache(
		Undefined,
		CalculationID,
		Enums.DataTypesInLotAccountingCache.CalculationParameters);
	
	CalculationParameters.Insert("TempTablesManager", New TempTablesManager);
	CalculationParameters.Insert("NumberOfServingsOfResult", 0);
	
	CostCalculationMechanismIsPerformed(CalculationParameters, False);
	InitializeBatchDistributionMeasurement(CalculationParameters);
	
	// We get a description of the subgraphs.
	DescriptionOfSubgraphs = ReadBatchCalculationDataCache(
		CalculationParameters,
		CalculationID,
		Enums.DataTypesInLotAccountingCache.DescriptionColumn);
		
	SamplingGroupOfSubgraphs = DescriptionOfSubgraphs;
	
	// Calculate the batches.
	CalculateBatchesBySubgraphGroups(CalculationParameters, SamplingGroupOfSubgraphs);
	
	// Let's finish the calculation.
	CacheCalculatedBatchesWhenCalculatingInBackground(CalculationParameters);
	
	WriteBatchCalculationDataCache(
		CalculationParameters.CalculationID,
		Enums.DataTypesInLotAccountingCache.CalculationStatistics,
		CalculationParameters.DistributionOfParties.CalculationStatistics);
	
EndProcedure

Procedure CacheCalculatedBatchesWhenCalculatingInBackground(CalculationParameters)
	
	SettlementBatches = CalculationParameters.DistributionOfParties.SettlementBatches;
	
	If SettlementBatches.Count() > 0 Then
		
		WriteBatchCalculationDataCache(
			CalculationParameters.CalculationID,
			Enums.DataTypesInLotAccountingCache.CalculationResult2,
			SettlementBatches,
			CalculationParameters.NumberOfServingsOfResult);
		
		CalculationParameters.NumberOfServingsOfResult = CalculationParameters.NumberOfServingsOfResult + 1;
		
		SettlementBatches.Clear();
		
	EndIf;
	
EndProcedure

// Gets the results of background batch calculations.
// 
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
Procedure GetResultsOfBackgroundBatchCalculations(CalculationParameters)
	
	CacheDistributedBatches(CalculationParameters, False);
	
	CancelCalculation = False;
	
	While CalculationParameters.CalculationTaskTable.Count() > 0 Do
		
		LinesToDelete = New Array;
		ActiveTasks = New Array;
		
		For Each TaskDescriptionString In CalculationParameters.CalculationTaskTable Do
			
			Job = BackgroundJobs.FindByUUID(TaskDescriptionString.JobID);
			
			If Job = Undefined Then
				
				// There may be a situation when the information about the completion of the background batch calculation
				// task has been deleted by the Platform, because there is a platform limit on the size of the stored list of completed tasks (1000 records).
				CacheTable = ReadBatchCalculationDataCache(
					CalculationParameters,
					TaskDescriptionString.CalculationID,
					Enums.DataTypesInLotAccountingCache.CalculationStatistics,
					,
					,
					,
					False);
				
				If CacheTable <> Undefined Then
					
					// If the task recorded information about the calculation statistics, then it was completed without errors.
					// Let's create a structure containing information about a successfully completed task.
					Job = New Structure;
					Job.Insert("State", 			BackgroundJobState.Completed);
					Job.Insert("Key", 	  			TaskDescriptionString.JobKey);
					Job.Insert("ErrorInfo", 	Undefined);
					
				EndIf;
				
			EndIf;
			
			ProtocolText_ = "";
			
			If Job = Undefined Then
				
				// The task was not found in the list of background tasks.
				LinesToDelete.Add(TaskDescriptionString);
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Chưa tìm thấy nhiệm vụ nền %1. Có lẽ, đã hoàn tất nhiệm vụ bất thường, xem Nhật ký sự kiện.';
						|ru = 'Фоновое задание %1 не найдено. Вероятно задание завершено аварийно, см. Журнал регистрации.';
						|en = 'The %1 background job is not found. Maybe, the job is aborted, see the event log.'; fa = 'The %1 background job is not found. Maybe, the job is aborted, see the event log.';
						|it = 'Task in background %1 non trovato. È possibile che il task sia stato terminato in modo anomalo, vedasi il registro di log.';
						|pl = 'Zadanie w tle %1 nie znaleziono. Prawdopodobnie zadanie jest zakończone awaryjnie, zob. Dziennik rejestracji.';
						|tr = 'Arka plan işi %1 bulunamadı. Görev kaza şekilde sonlandırılmış olabilir, Kayıt defterine bak.'", Common.DefaultLanguageCode()),
					"""" + TrimAll(TaskDescriptionString.JobKey) + """");
				
				CancelCalculation = True;
				
			ElsIf Job.State = BackgroundJobState.Failed
			 Or Job.State = BackgroundJobState.Canceled Then
				
				// The status of the task is "Completed" or "Canceled".
				LinesToDelete.Add(TaskDescriptionString);
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Nhiệm vụ nền %1 %2:
					|%3';
					|ru = 'Фоновое задание %1 %2:
					|%3';
					|en = 'Background job %1 %2:
					|%3'; fa = 'Background job %1 %2:
					|%3';
					|it = 'Task in background %1 %2:
					|%3';
					|pl = 'Zadanie w tle %1 %2:
					|%3';
					|tr = 'Arka plan işi %1 %2:
					|%3'", Common.DefaultLanguageCode()),
					"""" + TrimAll(Job.Key) + """",
					?(Job.State = BackgroundJobState.Canceled, NStr("vi = 'hủy bỏ';
																	|ru = 'отменено';
																	|en = 'canceled'; fa = 'canceled';
																	|it = 'annullato';
																	|pl = 'anulowano';
																	|tr = 'iptal edildi'", Common.DefaultLanguageCode()), NStr("vi = 'hoàn thành bất thường';
																															|ru = 'завершено аварийно';
																															|en = 'aborted'; fa = 'aborted';
																															|it = 'terminato in modo anomalo';
																															|pl = 'zakończone awaryjnie';
																															|tr = 'arızalı tamamlandı'", Common.DefaultLanguageCode())),
					?(Job.ErrorInfo = Undefined,
						NStr("vi = '<Không có mô tả lỗi>';
							|ru = '<Нет описания ошибки>';
							|en = '<No error description>'; fa = '<No error description>';
							|it = '<Non c''è una descrizione dell''errore>';
							|pl = '<Brak opisu błędu>';
							|tr = '<Hata ayrıntıları mevcut değil>'", Common.DefaultLanguageCode()),
						DetailErrorDescription(Job.ErrorInfo)));
				
				CancelCalculation = True;
				
			ElsIf Job.State = BackgroundJobState.Completed Then
				
				LinesToDelete.Add(TaskDescriptionString);
				
				// We will get the calculation results.
				DataVolume = NumberOfCalculationResultsInBatchCalculationDataCache(TaskDescriptionString.CalculationID);
				
				For PortionNumber = 0 To DataVolume Do
					
					CacheTable = ReadBatchCalculationDataCache(
						CalculationParameters,
						TaskDescriptionString.CalculationID,
						Enums.DataTypesInLotAccountingCache.CalculationResult2,
						PortionNumber);
						
					CalculationParameters.DistributionOfParties.Insert("SettlementBatches", CacheTable);
					
					CacheDistributedBatches(CalculationParameters, False);
					
				EndDo;
				
				// We will get the calculation statistics.
				CacheTable = ReadBatchCalculationDataCache(
					CalculationParameters,
					TaskDescriptionString.CalculationID,
					Enums.DataTypesInLotAccountingCache.CalculationStatistics,
					,
					,
					,
					False);
				
				If ValueIsFilled(CacheTable) Then
					
					For Each TableRow In CacheTable Do
						
						NewRow = CalculationParameters.DistributionOfParties.CalculationStatistics.Add();
						FillPropertyValues(NewRow, TableRow);
						
					EndDo;
					
				EndIf;
				
			Else
				
				// The task is still active, nothing needs to be done with it.
				ActiveTasks.Add(Job);
				
			EndIf;
			
			If ValueIsFilled(ProtocolText_) Then
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
					ProtocolText_);
				
				RegisterCalculationExecutionProblem(
					CalculationParameters,
					,
					NStr("vi = 'Khi tạo các bản ghi kết chuyển theo lô, đã chẩn đoán được lỗi';
						|ru = 'При формировании движений по партиям диагностированы ошибки';
						|en = 'Errors were found when generating lot records'; fa = 'Errors were found when generating lot records';
						|it = 'Durante la creazione dei movimenti sui lotti sono stati diagnosticati degli errori';
						|pl = 'Podczas tworzenia ruchów wg partii wykryto błędy';
						|tr = 'Hareketlerin lotlar halinde oluşturulması sırasında hatalar tespit edildi'", Common.DefaultLanguageCode()),
					ProtocolText_);
				
			EndIf;
			
		EndDo;
		
		For Each TaskDescriptionString In LinesToDelete Do
			
			ClearBatchCalculationDataCache(TaskDescriptionString.CalculationID); // clear the register entries for this task
			
			CalculationParameters.CalculationTaskTable.Delete(TaskDescriptionString);
			
		EndDo;
		
		If LinesToDelete.Count() = 0 Then 
			
			// If all the tasks are still active, then we will pause before the next cycle of checking tasks.
			Try
				BackgroundJobs.WaitForExecutionCompletion(ActiveTasks, 1);
			Except
				LinesToDelete = Undefined; // to exclude the triggering of the 499 standard check 
			EndTry;
			
		EndIf;
		
	EndDo;
	
	If CancelCalculation Then
		
		ProtocolText_ = TextExceptionToLogProblem(
			NStr("vi = 'Khi tạo bản ghi kết chuyển theo lô hàng, đã tìm thấy lỗi';
				|ru = 'При формировании движений по партиям диагностированы ошибки';
				|en = 'Errors were found when generating lot records'; fa = 'Errors were found when generating lot records';
				|it = 'Durante la creazione dei movimenti sui lotti sono stati diagnosticati degli errori';
				|pl = 'Podczas tworzenia ruchów wg partii wykryto błędy';
				|tr = 'Hareketlerin lotlar halinde oluşturulması sırasında hatalar tespit edildi'", Common.DefaultLanguageCode()));
		
		Raise ProtocolText_;
		
	EndIf;
	
EndProcedure

// Procedures for working with the cache register during background calculation.

Function WriteCacheOfBatchCalculationDataWithTimeMeasurement(CalculationParameters, CountNumber_,
			CalculationID, DataType, Data,
			DataPortionNumber = 0, MinimumNodeNumber = 0, MaximumNodeNumber = 0)
	
	BeginTime = CurrentUniversalDateInMilliseconds();
	
	WriteBatchCalculationDataCache(
		CalculationID,
		DataType,
		Data,
		DataPortionNumber,
		MinimumNodeNumber,
		MaximumNodeNumber);
	
	Return CurrentUniversalDateInMilliseconds() - BeginTime;
	
EndFunction

Procedure WriteBatchCalculationDataCache(CalculationID, DataType, Data,
			DataPortionNumber = 0, MinimumNodeNumber = 0, MaximumNodeNumber = 0)
	
	RecordManager = InformationRegisters.LotAccountingDataCache.CreateRecordManager();
	
	RecordManager.CalculationID  = CalculationID;
	RecordManager.DataType 			 = DataType;
	RecordManager.DataPortionNumber 	 = DataPortionNumber;
	RecordManager.Data 				 = New ValueStorage(Data, New Deflation(9));
	RecordManager.MinimumNodeNumber  = MinimumNodeNumber;
	RecordManager.MaximumNodeNumber = MaximumNodeNumber;
	RecordManager.VersionNumber			 = TrimAll(Metadata.Version);
	RecordManager.RecordDate			 = CurrentSessionDate();
	RecordManager.Comment			 = NStr("vi = 'Tính toán lô';
											|ru = 'Расчет партий';
											|en = 'Lot calculation'; fa = 'محاسبه بچ';
											|it = 'Calcolo dei lotti';
											|pl = 'Kalkulacja partii';
											|tr = 'Lot hesaplama'", Common.DefaultLanguageCode());
	
	RecordManager.Write(False);
	
EndProcedure

