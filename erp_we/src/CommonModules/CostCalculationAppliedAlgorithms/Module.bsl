// Fills in the value view in the party accounting analysis keys and creates a temporary table in the party analysis view of the Value.
//
Procedure GeneratePartyAnalystsWithViewOfValue(CalculationParameters, SourceTableName_ = "TTBatchBalances") Export
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT DISTINCT
	|	T.LotVendorAttributes,
	|	VALUE(Catalog.InventoryAccountingGroups.EmptyRef) AS FinancialAccountingGroup,
	|	Keys.Vendor,
	|	Keys.Counterparty,
	|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATTaxation,
	|	Keys.VATRate,
	|	T.AssetTaxClass,
	|	0 AS RowCode
	|INTO TTDetailsOfNewBatchTrackingAnalyticsKeys
	|FROM
	|	TTBatchBalances AS T
	|		INNER JOIN Catalog.KeysForLotVendorAttributes AS Keys
	|		ON T.LotVendorAttributes = Keys.Ref
	|WHERE
	|	Keys.AssetTaxClass <> T.AssetTaxClass
	|	OR Keys.FinancialAccountingGroup <> VALUE(Catalog.InventoryAccountingGroups.EmptyRef)
	|	OR Keys.VATTaxation <> VALUE(Enum.VATTaxationTypes.EmptyRef)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	&BeginOfPeriod AS Date,
	|	T.FinancialAccountingGroup,
	|	T.Vendor,
	|	T.Counterparty,
	|	T.VATTaxation,
	|	T.VATRate,
	|	T.AssetTaxClass,
	|	T.RowCode
	|FROM
	|	TTDetailsOfNewBatchTrackingAnalyticsKeys AS T
	|	LEFT JOIN InformationRegister.LotVendorAttributes AS DimensionOfLots
	|		ON T.FinancialAccountingGroup = DimensionOfLots.FinancialAccountingGroup
	|		 AND T.Vendor 				= DimensionOfLots.Vendor
	|		 AND T.Counterparty 			= DimensionOfLots.Counterparty
	|		 AND T.VATTaxation 	= DimensionOfLots.VATTaxation
	|		 AND T.VATRate 				= DimensionOfLots.VATRate
	|		 AND T.AssetTaxClass 			= DimensionOfLots.AssetTaxClass
	|		 AND T.RowCode 				= DimensionOfLots.RowCode
	|WHERE
	|	ISNULL(DimensionOfLots.DimensionKey, VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef))
	|		= VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)
	|";
	
	Query.Text = StrReplace(Query.Text, "TTBatchBalances", SourceTableName_);
	
	Selection = Query.Execute().Select(); // we will get party accounting analysts with an incorrect type of value
	While Selection.Next() Do
		
		// The type of value in the key of analytics, according to which there are remnants of "old" batches (from batch registers),
		// most likely will not be filled in.
		// At the same time, when forming the remnants of "new" batches (in the cost register),
		// we know what kind of value these remnants belong to.
		// Therefore, if the type of value in the key of the analysis of the "old" balances does not coincide with the type of value of the "new" balances,
		// then the key of the analysis of the "new" balances cannot be taken from the "old" balances - it must be replaced.
		// The situation is similar with the details of the "Group of Financial Accounting" and "Taxation" - they should be empty,
		// but in the "old" keys they are likely to be filled in.
		// At the same time, a suitable key for "new" balances may already exist in the IB:
		// - before executing this code (at the close of the month), documents were added/changed to the IB
		// - when carrying out these documents, analytics keys were formed with a filled-in type of value
		// - these keys may be suitable for "new" balances
		// We will create only the keys that are currently missing in the IB.
		Catalogs.KeysForLotVendorAttributes.GetAnalyticsKey(Selection, False);
		
	EndDo;
	
	// Now the register (and the directory) of keys have all the necessary keys for the "new" balances.
	Query.Text =
	"SELECT DISTINCT
	|	T.LotVendorAttributes,
	|	T.AssetTaxClass,
	|	DimensionOfLots.DimensionKey AS PartyAccountingAnalyticsWithValueView
	|INTO TTPartyAnalyticsWithViewToValue
	|FROM
	|	TTDetailsOfNewBatchTrackingAnalyticsKeys AS T
	|	INNER JOIN InformationRegister.LotVendorAttributes AS DimensionOfLots
	|		ON T.FinancialAccountingGroup = DimensionOfLots.FinancialAccountingGroup
	|		 AND T.Vendor 				= DimensionOfLots.Vendor
	|		 AND T.Counterparty 			= DimensionOfLots.Counterparty
	|		 AND T.VATTaxation 	= DimensionOfLots.VATTaxation
	|		 AND T.VATRate 				= DimensionOfLots.VATRate
	|		 AND T.AssetTaxClass 			= DimensionOfLots.AssetTaxClass
	|		 AND T.RowCode 				= DimensionOfLots.RowCode
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTDetailsOfNewBatchTrackingAnalyticsKeys
	|";
	
	Query.Execute(); // We form the analysis of the party of the same value
	
EndProcedure

